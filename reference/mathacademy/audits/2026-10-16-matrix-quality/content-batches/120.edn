6514495}} {:db/id #edb/ref 17592186514513 :step/content {:db/id #edb/ref 17592186407244 :question/id #uuid "66ca173a-d952-58d1-b484-502590c17693"} :step/id #uuid "78d36b97-fb9f-562b-a664-3f90af4e59df" :step/next {:db/id #edb/ref 17592186514528}} {:db/id #edb/ref 17592186514528 :step/content {:db/id #edb/ref 17592186514400 :question/id #uuid "5241b6a1-96aa-5720-ba1b-4d884df832da"} :step/id #uuid "bc095201-9245-5703-95d0-69f9cc120dd7"}] :activity/title "The Four Fundamental Subspaces of a Matrix" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186513523} {:activity/first-step {:db/id #edb/ref 17592186543650} :activity/id #uuid "dcac007b-4160-5c57-b3fa-73790e770eac" :activity/steps [{:db/id #edb/ref 17592186543596 :step/content {:db/id #edb/ref 17592186134077 :question/id #uuid "1f81e62d-c183-546b-b986-59beb21560d1"} :step/id #uuid "03787068-e65a-5894-ac0f-70677b84b503" :step/next {:db/id #edb/ref 17592186543659}} {:db/id #edb/ref 17592186543605 :step/content {:db/id #edb/ref 17592186362743 :question/id #uuid "462ca0a9-fbe9-5641-92d4-faed2ef0803e"} :step/id #uuid "12ea7b05-1139-5991-9ab8-d66b18daabf2" :step/next {:db/id #edb/ref 17592186543616}} {:db/id #edb/ref 17592186543616 :step/content {:db/id #edb/ref 17592186362750 :question/id #uuid "63c0c3aa-6cd0-5913-9f45-9198721d3066"} :step/id #uuid "32720668-2e01-58f0-9e8c-cb68020bcffd" :step/next {:db/id #edb/ref 17592186543596}} {:db/id #edb/ref 17592186543650 :step/content {:db/id #edb/ref 17592186134071 :question/id #uuid "304499af-cb5d-5e3b-8108-be3a9fa9519f"} :step/id #uuid "a47247ac-314d-5bb2-ba6f-fdd8d1f684d7" :step/next {:db/id #edb/ref 17592186543605}} {:db/id #edb/ref 17592186543659 :step/content {:db/id #edb/ref 17592186362777 :question/id #uuid "debbebbb-8895-508b-8192-3a839f7cbe92"} :step/id #uuid "b86b6c6f-57d1-5201-a6cd-714b57d1a7ce"}] :activity/title "The Four Fundamental Subspaces of a Matrix" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186542628}] :db/id #edb/ref 17592186049881 :topic/knowledge-points [{:db/id #edb/ref 17592186133885 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133701 :question/id #uuid "47945f1d-ab72-5fe8-bc2c-43a69480b323" :question/math-academy-id "e-9090" :question/problem "Which of the following subspaces must be orthogonal to $\\text{Col}(A^T)$ for every matrix $A?$\n\nI. $\\text{Null}(A)$\n\nII. $\\text{Col}(A)$\n\nIII. $\\text{Null}(A^T)$" :question/worked-solution "Recall that $\\text{Col}(A^T)$ is the row space of $A,$ and consists of all linear combinations of the rows of $A.$\n\nIf a vector is orthogonal to every linear combination of the rows of $A,$ it must be orthogonal to each row of $A.$\nBut notice that when pre-multiplying a vector by $A,$ we multiply each row of $A$ by that vector.\nSo, $\\text{Col}(A^T)$ must be orthogonal to the null space of $A,$ which is $\\text{Null}(A).$\n\nTherefore, the correct answer is \"I only.\"\n\n**Note:** In general, the four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/de/de22dd5b352e1d5be48f4b6ed3b2a4657ae623c1bd288d3464559758ea334af7.png)"} :knowledge-point/id #uuid "5ada5d20-89d8-5bc9-9b10-172356be0eb4" :knowledge-point/questions [{:db/id #edb/ref 17592186134071 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f20cbbab-e838-5cc3-9bc0-309fc77b0b95" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477097} {:answer/id #uuid "56ed48d0-e778-5305-b095-810cb0318a7c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477098}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477097} :answer-field/id #uuid "ecbb62c7-2dda-5a03-840d-d5922c38c749" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477518} {:answer-field/choices [{:answer/id #uuid "080c9074-8477-5142-a998-302831331617" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477099} {:answer/id #uuid "2adbcb29-ae60-5a02-a7a4-ad81cc23bd1d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477100}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477100} :answer-field/id #uuid "d6babc65-b40a-5bbb-a637-5cba3fe592bd" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477519} {:answer-field/choices [{:answer/id #uuid "9c831444-2313-518a-a561-b0194ffe8ba6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477101} {:answer/id #uuid "ea4d407d-7ce7-52d8-af97-f359e9fd20bc" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477102}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477101} :answer-field/id #uuid "1800ad63-0f0b-509e-9e17-fed976eb45e8" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477520}] :question/id #uuid "304499af-cb5d-5e3b-8108-be3a9fa9519f" :question/math-academy-id "q-108907" :question/problem "Which of the following subspaces must be orthogonal to $\\text{Null}(A)$ for every matrix $A?$\n- **I.** $\\text{Null}({A}^{T})$\n- **II.** $\\text{Col}({A}^{T})$\n- **III.** $\\text{Col}(A)$\n\nSelect all that apply." :question/worked-solution "Recall that $\\text{Null}(A)$ contains all vectors that, when pre-multiplied by $A,$ result in the zero-vector $0.$ \n\nWhen pre-multiplying a vector by $A,$ we actually multiply each row of $A$ by that vector. So, $\\text{Null}(A)$ must be orthogonal to the row space of $A,$ which is $\\text{Col}({A}^{T}).$\n\nTherefore, the correct answer is \"II only.\"\n\n**Note:** In general, the four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/de/de22dd5b352e1d5be48f4b6ed3b2a4657ae623c1bd288d3464559758ea334af7.png)"} {:db/id #edb/ref 17592186134077 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fac33087-90a9-5374-bb9b-89306309caf6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477109} {:answer/id #uuid "1cb234b8-e70d-5436-816b-c72569cefcc6" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477110}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477109} :answer-field/id #uuid "f5195686-7398-592f-a034-c46b06f34fab" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477524} {:answer-field/choices [{:answer/id #uuid "b51fbdcf-5bea-512d-8ea2-0767a22863a5" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477111} {:answer/id #uuid "4e912cb8-5633-51bd-a892-7203a2451c74" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477112}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477111} :answer-field/id #uuid "5c026345-d4f5-55cd-a8b5-b6a688019eae" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477525} {:answer-field/choices [{:answer/id #uuid "aa16ff18-2df7-5ce8-a4c4-8312d682551a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477113} {:answer/id #uuid "70d44836-3172-59de-bfac-3e6678ca53bc" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477114}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477114} :answer-field/id #uuid "a69cc77a-87f4-5f19-9bae-02259b9be70b" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477526}] :question/id #uuid "1f81e62d-c183-546b-b986-59beb21560d1" :question/math-academy-id "q-109854" :question/problem "Which of the following subspaces must be orthogonal to $\\text{Null}(XY)$ for all compatible matrices $X$ and $Y?$\n- **I.** $\\text{Null}({Y}^{T}\\,{X}^{T})$\n- **II.** $\\text{Col}(XY)$\n- **III.** $\\text{Col}({Y}^{T}\\,{X}^{T})$\n\nSelect all that apply." :question/worked-solution "Recall that $\\text{Null}(XY)$ contains all vectors that, when pre-multiplied by $XY,$ result in the zero-vector $0.$ \n\nWhen pre-multiplying a vector by $XY,$ we actually multiply each row of $XY$ by that vector. So, $\\text{Null}(XY)$ must be orthogonal to the row space of $XY,$ which is $\\text{Col}((XY)^{T})=\\text{Col}({Y}^{T}\\,{X}^{T}).$\n\nTherefore, the correct answer is \"III only.\"\n\n**Note:** In general, the four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/de/de22dd5b352e1d5be48f4b6ed3b2a4657ae623c1bd288d3464559758ea334af7.png)"} {:db/id #edb/ref 17592186362710 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a7d2435-e6d8-50bc-9006-6cd7c923b1be" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468888} {:answer/id #uuid "350a6cf1-0f8b-5dac-8762-1b097f5c4719" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468889}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468889} :answer-field/id #uuid "24fe84bd-8474-5fcd-a77c-7a3c567193e5" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470056} {:answer-field/choices [{:answer/id #uuid "9f93c3f6-6f23-5141-af32-ead12f4b0584" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468890} {:answer/id #uuid "cae9d183-09d0-59e5-81fc-1eacd146d5ba" :answer/type {:db/iden