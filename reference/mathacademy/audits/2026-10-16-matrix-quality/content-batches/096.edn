x}\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\nr=p+tv\\,⟹\\,r=\\begin{bmatrix}5 \\\\ 0 \\\\ 4\\end{bmatrix}+t\\begin{bmatrix}-8 \\\\ 1 \\\\ 1\\end{bmatrix}\n$$\n\nand the vector equation of the  line segment $\\overset{―}{PQ}$ is\n\n$$\nr(t)=\\begin{bmatrix}5 \\\\ 0 \\\\ 4\\end{bmatrix}+t\\begin{bmatrix}-8 \\\\ 1 \\\\ 1\\end{bmatrix},\\,t\\in [0,1].\n$$\n\nTherefore, we have\n\n$$\na+b+c=0+1+1=2.\n$$"} {:db/id #edb/ref 17592186281394 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0be0f959-791b-5a0b-be45-d0ebbdad7835" :answer/type {:db/ident :answer.type/math} :answer/value "2t-1" :db/id #edb/ref 17592186278705} {:answer/id #uuid "49a82da6-6864-51a5-a12b-2bc3d0e85235" :answer/type {:db/ident :answer.type/math} :answer/value "t+5" :db/id #edb/ref 17592186279251} {:answer/id #uuid "7ae77be6-77a2-5e73-84d9-978456fcf6b7" :answer/type {:db/ident :answer.type/math} :answer/value "3t" :db/id #edb/ref 17592186279686} {:answer/id #uuid "fa14c989-e7a4-5b86-84d8-d33cc45dcf3a" :answer/type {:db/ident :answer.type/math} :answer/value "6-4t" :db/id #edb/ref 17592186280787} {:answer/id #uuid "fb1461d1-1470-5fc6-b7b7-c34f41c5dbb9" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186280791}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "6-4t" :db/id #edb/ref 17592186280787} :answer-field/id #uuid "3a275a06-8426-5cba-80ad-87d6541a21d3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280936}] :question/id #uuid "794b4250-4016-55a7-bcf5-736496c2ab46" :question/math-academy-id "q-162173" :question/problem "The equation below gives a parametrization of the line segment $\\overset{―}{PQ},$ where $P(3,2,-1)$ and $Q(0,1,-3).$\n\n$$\nr(t)=a\\,i+b\\,j-(2t+1)\\,k,\\,t\\in [0,c]\n$$\n\nWhat is $a+b+c?$" :question/worked-solution "We need to find a direction vector that is parallel to the given line. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =(j-3\\,k)-(3\\,i+2\\,j-k) \\\\  & =-3\\,i-j-2\\,k\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\nr=p+tv\\,⟹\\,r=(3\\,i+2\\,j-k)+t(-3\\,i-j-2\\,k)\n$$\n\nand the parametrization of the line segment $\\overset{―}{PQ}$ is\n\n$$\n\\begin{aligned}r(t) & =(3\\,i+2\\,j-k)+t(-3\\,i-j-2\\,k) \\\\  & =(3-3t)\\,i+(2-t)\\,j-(2t+1)\\,k,\\,t\\in [0,1].\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=(3-3t)+(2-t)+1=6-4t.\n$$"} {:db/id #edb/ref 17592186281395 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25e236ab-22b3-591f-8fd7-3eb7f8e7db7e" :answer/type {:db/ident :answer.type/math} :answer/value "6t" :db/id #edb/ref 17592186278928} {:answer/id #uuid "4d021665-f5d0-513b-abf4-245646e4ca89" :answer/type {:db/ident :answer.type/math} :answer/value "6t-1" :db/id #edb/ref 17592186279283} {:answer/id #uuid "86f6c05a-4e8d-5bf4-8b1d-2ebe0533451f" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186279797} {:answer/id #uuid "9a3983c5-7f0c-5e2b-9126-99cdbd019563" :answer/type {:db/ident :answer.type/math} :answer/value "2-3t" :db/id #edb/ref 17592186279955} {:answer/id #uuid "eb8f4ee4-794f-556a-b700-c3b3b1e0af7e" :answer/type {:db/ident :answer.type/math} :answer/value "5t+6" :db/id #edb/ref 17592186280662}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2-3t" :db/id #edb/ref 17592186279955} :answer-field/id #uuid "260eb079-e98f-56dc-9ff0-48f90a5b5996" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280899}] :question/id #uuid "910d640d-077f-59e7-bef4-a838dd071664" :question/math-academy-id "q-162177" :question/problem "The equation below gives a parametrization of the line segment $\\overset{―}{PQ},$ where $P(-1,1,3)$ and $Q(0,6,-1).$\n\n$$\nr(t)=a\\,i+(5t+1)\\,j+b\\,k,\\,t\\in [c,1]\n$$\n\nWhat is $a+b+c?$" :question/worked-solution "We need to find a direction vector that is parallel to the given line. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =(6\\,j-k)-(-i+j+3\\,k) \\\\  & =i+5\\,j-4\\,k\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\nr=p+tv\\,⟹\\,r=(-i+j+3\\,k)+t(i+5\\,j-4\\,k)\n$$\n\nand the parametrization of the line segment $\\overset{―}{PQ}$ is\n\n$$\n\\begin{aligned}r(t) & =(-i+j+3\\,k)+t(i+5\\,j-4\\,k) \\\\  & =(t-1)\\,i+(5t+1)\\,j+(3-4t)\\,k,\\,t\\in [0,1].\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=(t-1)+(3-4t)+0=2-3t.\n$$"} {:db/id #edb/ref 17592186281398 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cc12d9f-c6c3-5d40-9aa3-f91dfbc8c11d" :answer/type {:db/ident :answer.type/math} :answer/value "-5t" :db/id #edb/ref 17592186278711} {:answer/id #uuid "374c9e65-ea25-50b8-8433-5b470ab50b1a" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186279075} {:answer/id #uuid "91946960-0d14-5aba-8173-5d6f889efe52" :answer/type {:db/ident :answer.type/math} :answer/value "4t+8" :db/id #edb/ref 17592186279889} {:answer/id #uuid "a2b984f4-1cfc-5e85-81b4-adad4b232d71" :answer/type {:db/ident :answer.type/math} :answer/value "1-5t" :db/id #edb/ref 17592186280037} {:answer/id #uuid "af8885d7-37bb-512f-b1f0-22d78f8c386e" :answer/type {:db/ident :answer.type/math} :answer/value "4t-7" :db/id #edb/ref 17592186280145}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4t+8" :db/id #edb/ref 17592186279889} :answer-field/id #uuid "3d1457dc-8e36-5bed-8275-81f950e48393" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280939}] :question/id #uuid "1fd0bbbd-dfcf-55de-83d3-53fd95d405bf" :question/math-academy-id "q-162184" :question/problem "The equation below gives a parametrization of the line segment $\\overset{―}{PQ},$ where $P(-4,0,-3)$ and $Q(-6,2,-5).$\n\n$$\nr(t)=-a\\,i+2t\\,j-b\\,k,\\,t\\in [0,c]\n$$\n\nWhat is $a+b+c?$" :question/worked-solution "We need to find a direction vector that is parallel to the given line. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =(-6\\,i+2\\,j-5\\,k)-(-4\\,i-3\\,k) \\\\  & =-2\\,i+2\\,j-2\\,k\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\nr=p+tv\\,⟹\\,r=(-4\\,i-3\\,k)+t(-2\\,i+2\\,j-2\\,k)\n$$\n\nand the parametrization of the line segment $\\overset{―}{PQ}$ is\n\n$$\n\\begin{aligned}r(t) & =(-4\\,i-3\\,k)+t(-2\\,i+2\\,j-2\\,k) \\\\  & =-(2t+4)\\,i+2t\\,j-(2t+3)\\,k,\\,t\\in [0,1].\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=(2t+4)+(2t+3)+1=4t+8.\n$$"} {:db/id #edb/ref 17592186281400 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "050ebd91-3d8f-5ddf-a517-2e9073c6e602" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186278635} {:answer/id #uuid "3470f1db-c3f5-55a7-9aa4-8f81a405ab49" :answer/type {:db/ident :answer.type/math} :answer/value "1-4t" :db/id #edb/ref 17592186279044} {:answer/id #uuid "4d4c7e33-6855-5907-9481-1e99833c1d1f" :answer/type {:db/ident :answer.type/math} :answer/value "-4t" :db/id #edb/ref 17592186279284} {:answer/id #uuid "8a565591-568d-52b3-80f3-bc587cce22e3" :answer/type {:db/ident :answer.type/math} :answer/value "3t+2" :db/id #edb/ref 17592186279828} {:answer/id #uuid "97eace13-314e-5afa-8fc2-2cef90869927" :answer/type {:db/ident :answer.type/math} :answer/value "t+1" :db/id #edb/ref 17592186279935}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186278635} :answer-field/id #uuid "33256d45-d20c-5812-90fb-6f0cd0110ebb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280925}] :question/id #uuid "4c5f20af-533a-5761-9687-aadcbb2c7fbc" :question/math-academy-id "q-162189" :question/problem "The equation below gives a parametrization of the line segment $\\overset{―}{PQ},$ where $P(1,-1,1)$ and $Q(2,-3,0).$\n\n$$\nr(t)=a\\,i-(2t+1)\\,j+b\\,k,\\,t\\in [c,1]\n$$\n\nWhat is $a+b+c?$" :question/worked-solution "We need to find a direction vector that is parallel to the given line. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =(2\\,i-3\\,j)-(i-j+k) \\\\  & =i-2\\,j-k\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\nr=p+tv\\,⟹\\,r=(i-j+k)+t(i-2\\,j-k)\n$$\n\nand the parametrization of the line segment $\\overset{―}{PQ}$ is\n\n$$\n\\begin{aligned}r(t) & =(i-j+k)+t(i-2\\,j-k) \\\\  & =(t+1)\\,i-(2t+1)\\,j+(1-t)\\,k,\\,t\\in [0,1].\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=(t+1)+(1-t)+0=2.\n$$"} {:db/id #edb/ref 17592186281402 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58a38772-16b9-593b-9af1-b23ada93e170" :answer/type {:db/ident :answer.type/math} :answer/value "9-4t" :db/id #edb/ref 17592186279407} {:answer/id #uuid "5be2fba4-953e-5ab7-9da7-a07953e1ccce" :answer/type {:db/ident :answer.type/math} :answer/value "2t+8" :db/id #edb/ref 17592186279439} {:answer/id #uuid "86a69aae-7088-59bf-bae6-ce1308f280ad" :answer/type {:db/ident :answer.type/math} :answer/value "4t" :db/id #edb/ref 17592186279795} {:answer/id #uuid "902c4911-c955-55c3-83f3-e7b060f01c8f" :answer/type {:db/ident :answer.type/math} :answer/value "10-2t" :db/id #edb/ref 17592186279876} {:answer/id #uuid "e7eefa6a-84c8-53a4-a058-9765f229ece9" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186280632}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "9-4t" :db/id #edb/ref 17592186279407} :answer-field/id #uuid "885078cf-1514-5291-a546-fa7d26157ac7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281082}] :question/id #uuid "3bc3398e-446c-5c75-b6ec-3e2bf640f0db" :question/math-academy-id "q-162191" :question/problem "The equation below gives a parametrization of the line segment $\\overset{―}{PQ},$ where $P(4,3,5)$ and $Q(6,3,1).$\n\n$$\nr(t)=(2t+4)\\,i+a\\,j+b\\,k,\\,t\\in [0,c]\n$$\n\nWhat is $a+b+c?$" :question/worked-solution "We need to find a direction vector that is parallel to the given line. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =(6\\,i+3\\,j+k)-(4\\,i+3\\,j+5\\,k) \\\\  & =2\\,i-4\\,k\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\nr=p+tv\\,⟹\\,r=(4\\,i+3\\,j+5\\,k)+t(2\\,i-4\\,k)\n$$\n\nand the parametrization of the line segment $\\overset{―}{PQ}$ is\n\n$$\n\\begin{aligned}r(t) & =(4\\,i+3\\,j+5\\,k)+t(2\\,i-4\\,k) \\\\  & =(2t+4)\\,i+3\\,j+(5-4t)\\,k,\\,t\\in [0,1].\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=3+(5-4t)+1=9-4t.\n$$"} {:db/id #edb/ref 17592186431705 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ac29229-afea-5c3b-9d80-98e4c4817571" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186431678} {:answer/id #uuid "9cebf039-4878-51b4-a3a9-d495dbdcdfb1" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186431686} {:answer/id #uuid "c99bd56d-b16e-5836-93b7-59a7d5bea293" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186431692} {:answer/id #uuid "d760676b-c91b-55f6-95ef-1e2c1a8316a0" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186431694} {:answer/id #uuid "fbd0ca81-588c-520c-9d6e-ae9aea95547e" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186431699}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186431694} :answer-field/id #uuid "83f5ad19-8ad8-5ef4-8b4d-3a3b41390749" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186431701}] :question/id #uuid "09c49afc-6085-50e6-863a-8dee0d62b478" :question/math-academy-id "q-162163" :question/problem "The equation below describes all the points on the line segment $\\overset{―}{PQ},$ where $P(-1,2,-3)$ and $Q(-2,0,4).$\n\n$$\nr(t)=\\begin{bmatrix}-1 \\\\ a \\\\ -3\\end{bmatrix}+t\\begin{bmatrix}-1 \\\\ -2 \\\\ b\\end{bmatrix},\\,t\\in [c,1]\n$$\n\nWhat is the value of $a+b+c?$" :question/worked-solution "We need to find a direction vector that is parallel to the given line. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =\\begin{bmatrix}-2 \\\\ 0 \\\\ 4\\end{bmatrix}-\\begin{bmatrix}-1 \\\\ 2 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ -2 \\\\ 7\\end{bmatrix}\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\nr=p+tv\\,⟹\\,r=\\begin{bmatrix}-1 \\\\ 2 \\\\ -3\\end{bmatrix}+t\\begin{bmatrix}-1 \\\\ -2 \\\\ 7\\end{bmatrix}\n$$\n\nand the vector equation of the  line segment $\\overset{―}{PQ}$ is\n\n$$\nr(t)=\\begin{bmatrix}-1 \\\\ 2 \\\\ -3\\end{bmatrix}+t\\begin{bmatrix}-1 \\\\ -2 \\\\ 7\\end{bmatrix},\\,t\\in [0,1].\n$$\n\nTherefore, we have\n\n$$\na+b+c=2+7+0=9.\n$$"}] :knowledge-point/title "Finding the Vector Equation of a Line Segment"}] :topic/math-academy-id 1376 :topic/title "The Vector Equation of a Line"}]}
