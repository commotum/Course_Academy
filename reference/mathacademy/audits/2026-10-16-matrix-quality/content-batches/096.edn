2619927743" :step/next {:db/id #edb/ref 17592186442995}} {:db/id #edb/ref 17592186442992 :step/content {:db/id #edb/ref 17592186387852 :question/id #uuid "78e0dc1f-5e12-54f0-b00c-492a979933d2"} :step/id #uuid "735f1d1f-3dd1-50b8-8d7c-9fcb22c5b1c7"} {:db/id #edb/ref 17592186442993 :step/content {:db/id #edb/ref 17592186338827 :question/id #uuid "22393ec9-8250-54f3-ad30-3ecff187a9da"} :step/id #uuid "9462b507-c0a1-5898-9afa-bb4186df83ec" :step/next {:db/id #edb/ref 17592186442991}} {:db/id #edb/ref 17592186442994 :step/content {:db/id #edb/ref 17592186120222 :question/id #uuid "3aea6384-95f5-5566-a595-7a25ca576605"} :step/id #uuid "ad4d6328-8534-5210-8c4a-365882fe2824" :step/next {:db/id #edb/ref 17592186442993}} {:db/id #edb/ref 17592186442995 :step/content {:db/id #edb/ref 17592186262853 :question/id #uuid "9164c795-7f61-5d54-9538-2653e37cb486"} :step/id #uuid "fb8f9fe8-2ed4-5d86-8099-75a35919ccad" :step/next {:db/id #edb/ref 17592186442992}}] :activity/title "The Vector Equation of a Plane" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186442985}] :db/id #edb/ref 17592186049436 :topic/knowledge-points [{:db/id #edb/ref 17592186119829 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119640 :question/id #uuid "ba897e22-8104-5772-a0d3-9b062f3592f1" :question/math-academy-id "e-4932" :question/problem "Find an equation of the plane that contains the point $P(-3,2,1)$ and is perpendicular to the vector $\\mathbf{n}= \\langle 0, 2, 0 \\rangle.$" :question/worked-solution "First, we note that the position vector of $P$ is $\\mathbf{p}=\\langle -3,2,1 \\rangle$ and $\\mathbf{n}=\\langle 0,2,0 \\rangle$ is normal to the plane.\n\nThe equation of the plane that passes through the point $P(x_0,y_0,z_0)$ and is perpendicular to the vector $\\mathbf{n}$ can be given as\n\n$$\n(\\mathbf{r} - \\mathbf{p}) \\cdot \\mathbf{n} = 0,\n$$\n\nwhere $\\mathbf{r}$ is the position vector of any point on the plane, and $\\mathbf p$ is the position vector of $P.$\n\nSo, we have\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨0,2,0⟩ & =⟨-3,2,1⟩\\cdot ⟨0,2,0⟩ \\\\ r\\cdot ⟨0,2,0⟩ & =4.\\end{aligned}\n$$"} :knowledge-point/id #uuid "3f5c9c30-1745-5986-b116-e9e70a7c6161" :knowledge-point/questions [{:db/id #edb/ref 17592186120217 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dd3ca665-8e71-5e54-9b16-e70f093f728c" :answer/type {:db/ident :answer.type/math} :answer/value "r \\cdot ⟨2,-5, 3⟩ = ⟨ - 1, 2,-3⟩" :db/id #edb/ref 17592186117464} {:answer/id #uuid "fb91c921-4313-5a71-89d6-40d058571b0c" :answer/type {:db/ident :answer.type/math} :answer/value "r \\cdot ⟨ - 1, 2,-3⟩ = ⟨ - 2, 5,-3⟩" :db/id #edb/ref 17592186117465} {:answer/id #uuid "1481757a-84a9-529c-9199-edf6ab25fabd" :answer/type {:db/ident :answer.type/math} :answer/value "r \\cdot ⟨ - 1, 2,-3⟩ =-3" :db/id #edb/ref 17592186117466} {:answer/id #uuid "1e422098-0791-5c2d-bf3b-caa10d3e2a60" :answer/type {:db/ident :answer.type/math} :answer/value "r \\cdot ⟨2,-5, 3⟩ = 21" :db/id #edb/ref 17592186117467} {:answer/id #uuid "7503109f-7701-5a9e-a969-13e4d39ac6ab" :answer/type {:db/ident :answer.type/math} :answer/value "r \\cdot ⟨ - 1, 2,-3⟩ =-21" :db/id #edb/ref 17592186117468}] :answer-field/id #uuid "abbeddc4-b3d9-5bc5-9a20-fe79cc8de6b3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117463} {:answer-field/choices [{:answer/id #uuid "0e448815-b2bb-5846-915b-7d9c23884bb9" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-1,2,-3⟩=-21" :db/id #edb/ref 17592186390830} {:answer/id #uuid "de65980c-0a80-5e6f-bf87-e8afefe3f527" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-1,2,-3⟩=⟨-2,5,-3⟩" :db/id #edb/ref 17592186390831} {:answer/id #uuid "2f57365b-0f99-52f4-983d-60b6ccab865c" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨2,-5,3⟩=⟨-1,2,-3⟩" :db/id #edb/ref 17592186390832} {:answer/id #uuid "687ca452-cc51-531c-b86f-23343784df77" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-1,2,-3⟩=-3" :db/id #edb/ref 17592186390833} {:answer/id #uuid "3cdfb2c3-82ee-5d77-b2ad-4381c658ae0e" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨2,-5,3⟩=21" :db/id #edb/ref 17592186390834}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-1,2,-3⟩=-21" :db/id #edb/ref 17592186390830} :answer-field/id #uuid "178ed90e-697e-5682-a979-46b601de175d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390829}] :question/id #uuid "965706e8-86b7-56ea-92d3-d6b5a93e54f6" :question/math-academy-id "q-32971" :question/problem "Find an equation of the plane that contains the point $P(2,-5,3)$ and is perpendicular to the vector $n=⟨-1,2,-3⟩.$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨2,-5,3⟩,$ and $n=⟨-1,2,-3⟩$ is normal to the plane.\n\nThe equation of the plane that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is perpendicular to the vector $n$ can be given as\n\n$$\n(r-p)\\cdot n=0,\n$$\n\nwhere $r$ is the position vector of any point on the plane, and $p$ is the position vector of $P.$\n\nSo, we have\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-1,2,-3⟩ & =⟨2,-5,3⟩\\cdot ⟨-1,2,-3⟩ \\\\ r\\cdot ⟨-1,2,-3⟩ & =-21.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186120222 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1490998e-fd96-558a-92bf-90c3e1b1d823" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot (\\sqrt{2}i+3j+4k)=2\\sqrt{2}i+7j-6k" :db/id #edb/ref 17592186442986} {:answer/id #uuid "24bd5c51-ea5f-55c2-b7cc-0a1c6fdaf3e9" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot (2\\sqrt{2}i+7j-6k)=\\sqrt{2}i+3j+4k" :db/id #edb/ref 17592186442987} {:answer/id #uuid "26e81e0f-00be-5150-9e74-fec4066ead13" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot (2\\sqrt{2}i+7j-6k)=1" :db/id #edb/ref 17592186442988} {:answer/id #uuid "d8a2f39f-065a-5b9a-9af2-2369637cc071" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot (2\\sqrt{2}i+7j-6k)=5" :db/id #edb/ref 17592186442989} {:answer/id #uuid "eead13a6-edac-5ccb-bd23-f3ae56dce20e" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot (2\\sqrt{2}i+7j-6k)=-5" :db/id #edb/ref 17592186442990}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot (2\\sqrt{2}i+7j-6k)=1" :db/id #edb/ref 17592186442988} :answer-field/id #uuid "1ea9a67f-f999-5059-be26-16de635db5bd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117493}] :question/id #uuid "3aea6384-95f5-5566-a595-7a25ca576605" :question/math-academy-id "q-33029" :question/problem "Find an equation of the plane that contains the point $P(\\sqrt{2},3,4)$ and is perpendicular to the vector $n=2\\sqrt{2}i+7j-6k.$" :question/worked-solution "First, we note that the position vector of $P$ is $p=\\sqrt{2}i+3j+4k,$ and $n=2\\sqrt{2}i+7j-6k$ is normal to the plane.\n\nThe equation of the plane that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is perpendicular to the vector $n$ can be given as\n\n$$\n(r-p)\\cdot n=0,\n$$\n\nwhere $r$ is the position vector of any point on the plane, and $p$ is the position vector of $P.$\n\nSo, we have\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot (2\\sqrt{2}i+7j-6k) & =(\\sqrt{2}i+3j+4k)\\cdot (2\\sqrt{2}i+7j-6k) \\\\ r\\cdot (2\\sqrt{2}i+7j-6k) & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262809 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06d9730b-5dfb-533b-84b4-820508c681c5" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot (\\sqrt{5}i-j-2k)=12" :db/id #edb/ref 17592186259940} {:answer/id #uuid "0b43e2e4-7d7c-5a06-9a4e-e5d5bd6fd688" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot (\\sqrt{5}i-3j+2k)=12" :db/id #edb/ref 17592186259978} {:answer/id #uuid "1cb6f84d-39e2-5454-9223-e2660394500e" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot (\\sqrt{5}i-3j+2k)=6" :db/id #edb/ref 17592186260120} {:answer/id #uuid "7625d753-d05c-5241-a7d8-009db644319a" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot (5i-3j+2k)=1" :db/id #edb/ref 17592186260906} {:answer/id #uuid "d5cf573a-806c-58e0-a8bf-e4a86fe1818d" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot (\\sqrt{5}i+2j-3k)=6" :db/id #edb/ref 17592186261755}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot (\\sqrt{5}i-3j+2k)=12" :db/id #edb/ref 17592186259978} :answer-field/id #uuid "149da6bf-b3f7-50a5-a4bd-3e9aa558c141" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262160}] :question/id #uuid "c5600d5c-cd95-56af-a0e8-ae34bd21b34c" :question/math-academy-id "q-127632" :question/problem "Find an equation of the plane that contains the point $P(\\sqrt{5},-1,2)$ and is perpendicular to the vector $n=\\sqrt{5}i-3j+2k.$" :question/worked-solution "First, we note that the position vector of $P$ is $p=\\sqrt{5}i-j+2k,$ and $n=\\sqrt{5}i-3j+2k$ is normal to the plane.\n\nThe equation of the plane that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is perpendicular to the vector $n$ can be given as\n\n$$\n(r-p)\\cdot n=0,\n$$\n\nwhere $r$ is the position vector of any point on the plane, and $p$ is the position vector of $P.$\n\nSo, we have\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot (\\sqrt{5}i-3j+2k) & =(\\sqrt{5}i-j+2k)\\cdot (\\sqrt{5}i-3j+2k) \\\\ r\\cdot (\\sqrt{5}i-3j+2k) & =12.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186304808 :qu