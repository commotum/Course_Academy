.type/radio} :db/id #edb/ref 17592186491103}] :question/id #uuid "64ee7b8f-3e22-5cf5-9caf-3d5b7abcf58b" :question/math-academy-id "q-94071" :question/problem "Consider the quadratic form \n$Q(x)={x}_{1}^{2}+2{x}_{1}{x}_{2}-2{x}_{1}{x}_{3}+2{x}_{3}^{2}.$ \nEvaluate $Q(x)$ when $x=\\begin{bmatrix}1 \\\\ 1 \\\\ -3\\end{bmatrix}.$" :question/worked-solution "We are given that \n\n$$\nx=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 1 \\\\ -3\\end{bmatrix}.\n$$\n\nSubstituting this into the expression for $Q(x)$, we obtain\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}+2{x}_{1}{x}_{2}-2{x}_{1}{x}_{3}+2{x}_{3}^{2} \\\\  & ={1}^{2}+2\\cdot 1\\cdot 1-2\\cdot 1\\cdot (-3)+2\\cdot (-3)^{2} \\\\  & =1+2+6+18 \\\\  & =27.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186491171 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61668a4d-a9aa-528d-b42b-fd1b72e2077b" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186490691} {:answer/id #uuid "7d18a3f9-2fca-582b-aa0a-8054fbaae593" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186490759} {:answer/id #uuid "93089472-c827-5a81-9873-0f6756288ef5" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186490810} {:answer/id #uuid "cf2388f2-6372-5def-9569-eccffa2b439d" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186490901} {:answer/id #uuid "f20ac334-93ac-5271-98aa-6f85b9667d44" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186490972}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186490972} :answer-field/id #uuid "f799ac64-6ac4-5678-be0b-90e21732933a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491105}] :question/id #uuid "80dc5c66-c7d3-5e30-acc4-5e4e63237441" :question/math-academy-id "q-140930" :question/problem "$$\nA=\\begin{bmatrix}3 & -2 \\\\ -2 & 5\\end{bmatrix}\n$$\n\nGiven the matrix $A$ above, evaluate the quadratic form $Q(x)={x}^{T}\\,Ax$ when $x=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}.$" :question/worked-solution "Substituting $x=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}$ into the expression for $Q(x),$ we obtain\n\n$$\n\\begin{aligned}Q(x) & ={x}^{T}\\,Ax \\\\  & =\\begin{bmatrix}1 & -1\\end{bmatrix}\\begin{bmatrix}3 & -2 \\\\ -2 & 5\\end{bmatrix}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & -7\\end{bmatrix}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix} \\\\  & =12.\\end{aligned}\n$$"}] :knowledge-point/title "Evaluating a Quadratic Form"} {:db/id #edb/ref 17592186161986 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161778 :question/id #uuid "f3be44df-f059-5e92-b279-644fe1eb0985" :question/math-academy-id "e-8170" :question/problem "![](images/0a/0aa2d0bbe2e39ba23901b5157466b4099c1f2552d9a34de9af6387975c59e1cb.svg)\nConsider the matrix $A$ above. Which expression represents the corresponding quadratic form $\\mathbf{x}^T \\! A \\mathbf{x}$ in terms of the components of ![](images/37/37cee7d28f0085ee70cefd5cb9ded630e38ffb3ca26523c320df13d09cde09e8.svg)" :question/worked-solution "**Method 1**\n\nEach entry $a_{ij}$ of $A$ corresponds to the term $a_{ij}x_i x_j$ in the expression of the quadratic form:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =-1{x}_{1}{x}_{1}+(1){x}_{1}{x}_{2}+(1){x}_{2}{x}_{1}+-1{x}_{2}{x}_{2} \\\\  & =-{x}_{1}^{2}+{x}_{1}{x}_{2}+{x}_{2}{x}_{1}-{x}_{2}^{2} \\\\  & =-{x}_{1}^{2}+2{x}_{1}{x}_{2}-{x}_{2}^{2}\\end{aligned}\n$$\n\n**Method 2**\n\nTo write down a quadratic form in terms of vector components, we compute the following expression:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =\\begin{bmatrix}{x}_{1} & {x}_{2}\\end{bmatrix}\\begin{bmatrix}-1 & 1 \\\\ 1 & -1\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}{x}_{1} & {x}_{2}\\end{bmatrix}\\begin{bmatrix}-{x}_{1}+{x}_{2} \\\\ {x}_{1}-{x}_{2}\\end{bmatrix} \\\\  & ={x}_{1}(-{x}_{1}+{x}_{2})+{x}_{2}({x}_{1}-{x}_{2}) \\\\  & =-{x}_{1}^{2}+{x}_{1}{x}_{2}+{x}_{2}{x}_{1}-{x}_{2}^{2} \\\\  & =-{x}_{1}^{2}+2{x}_{1}{x}_{2}-{x}_{2}^{2}\\end{aligned}\n$$"} :knowledge-point/id #uuid "328b0b77-f789-581e-a119-9823297666ae" :knowledge-point/questions [{:db/id #edb/ref 17592186162595 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37bed92b-f672-507f-908f-4180d60967a0" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}^{2}-4{x}_{1}{x}_{2}+{x}_{2}^{2}" :db/id #edb/ref 17592186355166} {:answer/id #uuid "7a4e148e-4cda-58e5-a8f8-33882e3c14d2" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}^{2}-2{x}_{1}{x}_{2}+{x}_{2}^{2}" :db/id #edb/ref 17592186355735} {:answer/id #uuid "bdd54d13-8fee-5d25-aa21-73e2fe837e31" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}^{2}+2{x}_{1}{x}_{2}+{x}_{2}^{2}" :db/id #edb/ref 17592186356326} {:answer/id #uuid "ce4a3363-52f8-53e5-b467-965e5d801060" :answer/type {:db/ident :answer.type/math} :answer/value "-{x}_{1}^{2}+2{x}_{1}{x}_{2}-{x}_{2}^{2}" :db/id #edb/ref 17592186356471} {:answer/id #uuid "de2c0735-3990-56ef-921f-e2e38cf38440" :answer/type {:db/ident :answer.type/math} :answer/value "-{x}_{1}^{2}-{x}_{2}^{2}" :db/id #edb/ref 17592186356611}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}^{2}-4{x}_{1}{x}_{2}+{x}_{2}^{2}" :db/id #edb/ref 17592186355166} :answer-field/id #uuid "24c65efe-f0dc-5833-85bd-c0e38f31a3b2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356981}] :question/id #uuid "ef8e1919-faae-510c-bb46-8c3989805365" :question/math-academy-id "q-93705" :question/problem "$$\nA=\\begin{bmatrix}1 & -2 \\\\ -2 & 1\\end{bmatrix}\n$$\n\nConsider the matrix $A$ above. Which of the following represents the corresponding quadratic form ${x}^{T}\\,Ax$ in terms of the components of $x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}?$" :question/worked-solution "**Method 1**\n\nEach entry ${a}_{ij}$ of $A$ corresponds to the term ${a}_{ij}{x}_{i}{x}_{j}$ in the expression of the quadratic form:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =1{x}_{1}{x}_{1}+(-2){x}_{1}{x}_{2}+(-2){x}_{2}{x}_{1}+1{x}_{2}{x}_{2} \\\\  & ={x}_{1}^{2}-2{x}_{1}{x}_{2}-2{x}_{2}{x}_{1}+{x}_{2}^{2} \\\\  & ={x}_{1}^{2}-4{x}_{1}{x}_{2}+{x}_{2}^{2}\\end{aligned}\n$$\n\n**Method 2**\n\nTo write down a quadratic form in terms of vector components, we compute the following expression:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =\\begin{bmatrix}{x}_{1} & {x}_{2}\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}{x}_{1} & {x}_{2}\\end{bmatrix}\\begin{bmatrix}{x}_{1}-2{x}_{2} \\\\ -2{x}_{1}+{x}_{2}\\end{bmatrix} \\\\  & ={x}_{1}({x}_{1}-2{x}_{2})+{x}_{2}(-2{x}_{1}+{x}_{2}) \\\\  & ={x}_{1}^{2}-2{x}_{1}{x}_{2}-2{x}_{2}{x}_{1}+{x}_{2}^{2} \\\\  & ={x}_{1}^{2}-4{x}_{1}{x}_{2}+{x}_{2}^{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186162618 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a616c768-d77c-5766-a8fd-858cff581853" :answer/type {:db/ident :answer.type/math} :answer/value "2x_{1}^{2} - 2x_{1}x_{3} + 2x_{2}^{2} - 3x_{3}^{2}" :db/id #edb/ref 17592186161001} {:answer/id #uuid "e81a943e-c211-5dba-b2fb-b7fdb23b102e" :answer/type {:db/ident :answer.type/math} :answer/value "x_{2}^{2} - 2x_{2}x_{3} + 3x_{3}^{2}" :db/id #edb/ref 17592186161002} {:answer/id #uuid "fa53e0db-cafe-51b6-943d-e8f045fe5e27" :answer/type {:db/ident :answer.type/math} :answer/value "2x_{1}^{2} - 4x_{1}x_{3} + 3x_{3}^{2}" :db/id #edb/ref 17592186161003} {:answer/id #uuid "497c683f-8b42-5d7f-898e-da8870532db9" :answer/type {:db/ident :answer.type/math} :answer/value "x_{1}^{2} - 4x_{1}x_{2} + x_{2}^{2}" :db/id #edb/ref 17592186161004} {:answer/id #uuid "4b1a02a3-c8f8-53b6-baf2-4a748b03400e" :answer/type {:db/ident :answer.type/math} :answer/value "2x_{1}^{2} - 4x_{1}x_{3} + x_{2}^{2} + 3x_{3}^{2}" :db/id #edb/ref 17592186161005}] :answer-field/id #uuid "68f30f56-2f72-56cf-aac8-4c593c1f84b4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186161000}] :question/id #uuid "4eca1287-e03c-52d0-98fb-12c1902ee1e6" :question/math-academy-id "q-94107" :question/problem "$A = \\begin{bmatrix}2 & 0 & -2 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & 3\\end{bmatrix}$\nConsider the matrix $A$ above. Which of the following represents the corresponding quadratic form $x^{T}Ax$ in terms of the components of $x = \\begin{bmatrix}x_{1} \\\\ x_{2} \\\\ x_{3}\\end{bmatrix}$?"} {:db/id #edb/ref 17592186272171 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a0f2148-7ade-5ec8-ab86-c7e431d919fe" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}^{2}-{x}_{1}{x}_{3}-{x}_{2}{x}_{3}+6{x}_{2}{x}_{3}" :db/id #edb/ref 17592186269940} {:answer/id #uuid "5ffb9214-474e-5372-a1eb-174b26aa7439" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}^{2}-2{x}_{1}{x}_{3}+3{x}_{2}^{2}+3{x}_{3}{x}_{2}" :db/id #edb/ref 17592186270117} {:answer/id #uuid "9f4c2346-7df9-5410-9d87-366e1e19b329" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}^{2}-2{x}_{1}{x}_{3}+6{x}_{2}{x}_{3}" :db/id #edb/ref 17592186270681} {:answer/id #uuid "dd9b028c-108b-526f-a4e8-1e7cb18ddf10" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}^{2}-{x}_{1}{x}_{3}+3{x}_{2}{x}_{3}" :db/id #edb/ref 17592186271214} {:answer/id #uuid "e0ae9565-9694-58a6-aab9-151038d2b131" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}^{2}-2{x}_{1}{x}_{3}+3{x}_{2}{x}_{3}+3{x}_{3}^{2}" :db/id #edb/ref 17592186271244}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}^{2}-2{x}_{1}{x}_{3}+6{x}_{2}{x}_{3}" :db/id #edb/ref 17592186270681} :answer-field/id #uuid "065e2a25-744f-55d4-9b51-be1e062d5b85" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271514}] :question/id #uuid "d5a533cc-6fd5-51dd-a1d8-7511844d6151" :question/math-academy-id "q-140928" :question/problem "$$\nA=\\begin{bmatrix}1 & 0 & -1 \\\\ 0 & 0 & 3 \\\\ -1 & 3 & 0\\end{bmatrix}\n$$\n\nConsider the matrix $A$ above. Which of the following represents the corresponding quadratic form ${x}^{T}\\,Ax$ in terms of the components of $x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}?$" :question/worked-solution "**Method 1**\n\nEach entry ${a}_{ij}$ of $A$ corresponds to the term ${a}_{ij}{x}_{i}{x}_{j}$ in the expression of the quadratic form:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =1{x}_{1}{x}_{1}+0{x}_{1}{x}_{2}+(-1){x}_{1}{x}_{3}+0{x}_{2}{x}_{1}+0{x}_{2}{x}_{2}+3{x}_{2}{x}_{3}+(-1){x}_{3}{x}_{1}+3{x}_{3}{x}_{2}+0{x}_{3}{x}_{3} \\\\  & ={x}_{1}^{2}-{x}_{1}{x}_{3}+3{x}_{2}{x}_{3}-{x}_{3}{x}_{1}+3{x}_{3}{x}_{2} \\\\  & ={x}_{1}^{2}-2{x}_{1}{x}_{3}+6{x}_{2}{x}_{3}\\end{aligned}\n$$\n\n**Method 2**\n\nTo write down a quadratic form in terms of vector components, we compute the following expression:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =\\begin{bmatrix}{x}_{1} & {x}_{2} & {x}_{3}\\end{bmatrix}\\begin{bmatrix}1 & 0 & -1 \\\\ 0 & 0 & 3 \\\\ -1 & 3 & 0\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} \\\\  & =\\begin{bmatrix}{x}_{1} & {x}_{2} & {x}_{3}\\end{bmatrix}\\begin{bmatrix}{x}_{1}-{x}_{3} \\\\ 3{x}_{3} \\\\ -{x}_{1}+3{x}_{2}\\end{bmatrix} \\\\  & ={x}_{1}({x}_{1}-{x}_{3})+{x}_{2}(3{x}_{3})+{x}_{3}(-{x}_{1}+3{x}_{2}) \\\\  & ={x}_{1}^{2}-{x}_{1}{x}_{3}+3{x}_{2}{x}_{3}-{x}_{3}{x}_{1}+3{x}_{3}{x}_{2} \\\\  & ={x}_{1}^{2}-2{x}_{1}{x}_{3}+6{x}_{2}{x}_{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186357650 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0609d3a7-be7d-55f2-ae68-f6bdfb962a17" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}_{1}^{2}-8{x}_{1}{x}_{2}+3{x}_{2}^{2}" :db/id #edb/ref 17592186354706} {:answer/id #uuid "63e8faa4-6d8b-5aee-89be-3cc5707e6fa4" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}^{2}-8{x}_{1}{x}_{2}+{x}_{2}^{2}" :db/id #edb/ref 17592186355554} {:answer/id #uuid "79c1f408-d7ca-53db-aed3-e6b5a79aa8ef" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}_{1}^{2}+4{x}_{1}{x}_{2}+2{x}_{2}^{2}" :db/id #edb/ref 17592186355732} {:answer/id #uuid "8009a211-0c11-5190-b553-f8009e69bcdc" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}^{2}+8{x}_{1}{x}_{2}-{x}_{2}^{2}" :db/id #edb/ref 17592186355788} {:answer/id #uuid "e4047760-b3bc-5520-8175-f0bf3ea7b22f" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}^{2}-4{x}_{1}{x}_{2}+{x}_{2}^{2}" :db/id #edb/ref 17592186356658}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2{x}_{1}^{2}-8{x}_{1}{x}_{2}+3{x}_{2}^{2}" :db/id #edb/ref 17592186354706} :answer-field/id #uuid "bcb97f78-10f9-5eea-ac9a-9e02a024b93f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357259}] :question/id #uuid "df4dbe7a-8735-5f48-8e9c-c676ad3b4dc5" :question/math-academy-id "q-94091" :question/problem "$$\nA=\\begin{bmatrix}2 & -4 \\\\ -4 & 3\\end{bmatrix}\n$$\n\nConsider the matrix $A$ above. Which of the following represents the corresponding quadratic form ${x}^{T}\\,Ax$ in terms of the components of $x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}?$" :question/worked-solution "**Method 1**\n\nEach entry ${a}_{ij}$ of $A$ corresponds to the term ${a}_{ij}{x}_{i}{x}_{j}$ in the expression of the quadratic form:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =2{x}_{1}{x}_{1}+(-4){x}_{1}{x}_{2}+(-4){x}_{2}{x}_{1}+3{x}_{2}{x}_{2} \\\\  & =2{x}_{1}^{2}-4{x}_{1}{x}_{2}-4{x}_{2}{x}_{1}+3{x}_{2}^{2} \\\\  & =2{x}_{1}^{2}-8{x}_{1}{x}_{2}+3{x}_{2}^{2}\\end{aligned}\n$$\n\n**Method 2**\n\nTo write down a quadratic form in terms of vector components, we compute the following expression:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =\\begin{bmatrix}{x}_{1} & {x}_{2}\\end{bmatrix}\\begin{bmatrix}2 & -4 \\\\ -4 & 3\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}{x}_{1} & {x}_{2}\\end{bmatrix}\\begin{bmatrix}2{x}_{1}-4{x}_{2} \\\\ -4{x}_{1}+3{x}_{2}\\end{bmatrix} \\\\  & ={x}_{1}(2{x}_{1}-4{x}_{2})+{x}_{2}(-4{x}_{1}+3{x}_{2}) \\\\  & =2{x}_{1}^{2}-4{x}_{1}{x}_{2}-4{x}_{2}{x}_{1}+3{x}_{2}^{2} \\\\  & =2{x}_{1}^{2}-8{x}_{1}{x}_{2}+3{x}_{2}^{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186357651 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c31beb4-ab42-57a8-b98e-c38bcfae5c58" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}_{1}^{2}-3{x}_{1}{x}_{2}+2{x}_{2}^{2}" :db/id #edb/ref 17592186354908} {:answer/id #uuid "8ee2a904-7722-5877-8823-f368265253f8" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}_{1}^{2}+4{x}_{1}{x}_{2}+3{x}_{2}^{2}" :db/id #edb/ref 17592186355924} {:answer/id #uuid "97920ae7-f871-5bcc-b433-ad7f958e4ab8" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}_{1}^{2}+3{x}_{1}{x}_{2}+2{x}_{2}^{2}" :db/id #edb/ref 17592186355999} {:answer/id #uuid "c4d006dd-514e-5f24-b8ea-65691b567901" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}_{1}^{2}-6{x}_{1}{x}_{2}+3{x}_{2}^{2}" :db/id #edb/ref 17592186356383} {:answer/id #uuid "fd92fbd4-d7d1-557a-8864-0868b5fc986c" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}_{1}^{2}+6{x}_{1}{x}_{2}+2{x}_{2}^{2}" :db/id #edb/ref 17592186356890}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2{x}_{1}^{2}+6{x}_{1}{x}_{2}+2{x}_{2}^{2}" :db/id #edb/ref 17592186356890} :answer-field/id #uuid "c702bda3-b33d-5d6a-b438-e9d3a5575649" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357276}] :question/id #uuid "8b6c5226-6a4c-5905-b982-20f40f90cbd5" :question/math-academy-id "q-94093" :question/problem "$$\nA=\\begin{bmatrix}2 & 3 \\\\ 3 & 2\\end{bmatrix}\n$$\n\nConsider the matrix $A$ above. Which of the following represents the corresponding quadratic form ${x}^{T}\\,Ax$ in terms of the components of $x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}?$" :question/worked-solution "**Method 1**\n\nEach entry ${a}_{ij}$ of $A$ corresponds to the term ${a}_{ij}{x}_{i}{x}_{j}$ in the expression of the quadratic form:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =2{x}_{1}{x}_{1}+(3){x}_{1}{x}_{2}+(3){x}_{2}{x}_{1}+2{x}_{2}{x}_{2} \\\\  & =2{x}_{1}^{2}+3{x}_{1}{x}_{2}+3{x}_{2}{x}_{1}+2{x}_{2}^{2} \\\\  & =2{x}_{1}^{2}+6{x}_{1}{x}_{2}+2{x}_{2}^{2}\\end{aligned}\n$$\n\n**Method 2**\n\nTo write down a quadratic form in terms of vector components, we compute the following expression:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =\\begin{bmatrix}{x}_{1} & {x}_{2}\\end{bmatrix}\\begin{bmatrix}2 & 3 \\\\ 3 & 2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}{x}_{1} & {x}_{2}\\end{bmatrix}\\begin{bmatrix}2{x}_{1}+3{x}_{2} \\\\ 3{x}_{1}+2{x}_{2}\\end{bmatrix} \\\\  & ={x}_{1}(2{x}_{1}+3{x}_{2})+{x}_{2}(3{x}_{1}+2{x}_{2}) \\\\  & =2{x}_{1}^{2}+3{x}_{1}{x}_{2}+3{x}_{2}{x}_{1}+2{x}_{2}^{2} \\\\  & =2{x}_{1}^{2}+6{x}_{1}{x}_{2}+2{x}_{2}^{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186357652 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "371f2353-37f8-536a-9217-cc2142631b3e" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}^{2}+2{x}_{1}{x}_{3}+{x}_{2}^{2}" :db/id #edb/ref 17592186355159} {:answer/id #uuid "60d86da9-5d7f-5490-b8c1-99785a0d0a72" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}^{2}+2{x}_{1}{x}_{3}+{x}_{2}^{2}+{x}_{3}^{2}" :db/id #edb/ref 17592186355521} {:answer/id #uuid "7647ff63-d70b-577e-8675-f86d5d78e222" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}^{2}-2{x}_{1}{x}_{2}+{x}_{2}^{2}+{x}_{3}^{2}" :db/id #edb/ref 17592186355702} {:answer/id #uuid "98a61db6-3a66-5600-9c21-3d935e2e04c2" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}^{2}+2{x}_{2}{x}_{3}+{x}_{2}^{2}+{x}_{3}^{2}" :db/id #edb/ref 17592186356016} {:answer/id #uuid "bb9a1e90-b95d-5aa8-a619-77899956259d" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{2}^{2}+2{x}_{2}{x}_{3}+{x}_{3}^{2}" :db/id #edb/ref 17592186356306}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}^{2}+2{x}_{1}{x}_{3}+{x}_{2}^{2}+{x}_{3}^{2}" :db/id #edb/ref 17592186355521} :answer-field/id #uuid "aca860c9-bace-503d-aefa-1ddc171f9865" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357232}] :question/id #uuid "01e9ac28-5380-515a-ab76-b5729a075c68" :question/math-academy-id "q-94097" :question/problem "$$\nA=\\begin{bmatrix}1 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 1\\end{bmatrix}\n$$\n\nConsider the matrix $A$ above. Which of the following represents the corresponding quadratic form ${x}^{T}\\,Ax$ in terms of the components of $x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}?$" :question/worked-solution "**Method 1**\n\nEach entry ${a}_{ij}$ of $A$ corresponds to the term ${a}_{ij}{x}_{i}{x}_{j}$ in the expression of the quadratic form:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =1{x}_{1}{x}_{1}+0{x}_{1}{x}_{2}+1{x}_{1}{x}_{3}+0{x}_{2}{x}_{1}+1{x}_{2}{x}_{2}+0{x}_{2}{x}_{3}+1{x}_{3}{x}_{1}+0{x}_{3}{x}_{2}+1{x}_{3}{x}_{3} \\\\  & ={x}_{1}^{2}+{x}_{1}{x}_{3}+{x}_{2}^{2}+{x}_{3}{x}_{1}+{x}_{3}^{2} \\\\  & ={x}_{1}^{2}+2{x}_{1}{x}_{3}+{x}_{2}^{2}+{x}_{3}^{2}\\end{aligned}\n$$\n\n**Method 2**\n\nTo write down a quadratic form in terms of vector components, we compute the following expression:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =\\begin{bmatrix}{x}_{1} & {x}_{2} & {x}_{3}\\end{bmatrix}\\begin{bmatrix}1 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 1\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} \\\\  & =\\begin{bmatrix}{x}_{1} & {x}_{2} & {x}_{3}\\end{bmatrix}\\begin{bmatrix}{x}_{1}+{x}_{3} \\\\ {x}_{2} \\\\ {x}_{1}+{x}_{3}\\end{bmatrix} \\\\  & ={x}_{1}({x}_{1}+{x}_{3})+{x}_{2}({x}_{2})+{x}_{3}({x}_{1}+{x}_{3}) \\\\  & ={x}_{1}^{2}+{x}_{1}{x}_{3}+{x}_{2}^{2}+{x}_{3}{x}_{1}+{x}_{3}^{2} \\\\  & ={x}_{1}^{2}+2{x}_{1}{x}_{3}+{x}_{2}^{2}+{x}_{3}^{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186357654 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "021bd2b7-706e-57b3-a8af-b3a83db7afce" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}_{2}^{2}+2{x}_{1}{x}_{2}-2{x}_{3}^{2}" :db/id #edb/ref 17592186354673} {:answer/id #uuid "5cd22498-12fa-59db-81fd-6c2ce36f48b1" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}_{1}^{2}+2{x}_{1}{x}_{2}-2{x}_{2}^{2}" :db/id #edb/ref 17592186355485} {:answer/id #uuid "b63d5c18-a2a2-5302-9ff5-868dfe95946a" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}_{1}^{2}+2{x}_{1}{x}_{2}-2{x}_{2}^{2}+2{x}_{3}^{2}" :db/id #edb/ref 17592186356266} {:answer/id #uuid "f65a1d83-e90e-527d-9df8-022f7c05907b" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}^{2}+2{x}_{1}{x}_{3}+2{x}_{2}^{2}-2{x}_{3}^{2}" :db/id #edb/ref 17592186356809} {:answer/id #uuid "fd26311c-2f18-574d-9496-266fed0c1d74" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}_{1}^{2}+2{x}_{1}{x}_{2}+2{x}_{3}^{2}" :db/id #edb/ref 17592186356885}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2{x}_{1}^{2}+2{x}_{1}{x}_{2}-2{x}_{2}^{2}+2{x}_{3}^{2}" :db/id #edb/ref 17592186356266} :answer-field/id #uuid "09e70103-bd6b-5347-8799-710e68326fdd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356935}] :question/id #uuid "96f2319e-e633-542e-b1fa-62302f0afd32" :question/math-academy-id "q-94099" :question/problem "$$\nA=\\begin{bmatrix}2 & 1 & 0 \\\\ 1 & -2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}\n$$\n\nConsider the matrix $A$ above. Which of the following represents the corresponding quadratic form ${x}^{T}\\,Ax$ in terms of the components of $x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}?$" :question/worked-solution "**Method 1**\n\nEach entry ${a}_{ij}$ of $A$ corresponds to the term ${a}_{ij}{x}_{i}{x}_{j}$ in the expression of the quadratic form:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =2{x}_{1}{x}_{1}+1{x}_{1}{x}_{2}+0{x}_{1}{x}_{3}+1{x}_{2}{x}_{1}+(-2){x}_{2}{x}_{2}+0{x}_{2}{x}_{3}+0{x}_{3}{x}_{1}+0{x}_{3}{x}_{2}+2{x}_{3}{x}_{3} \\\\  & =2{x}_{1}^{2}+{x}_{1}{x}_{2}+{x}_{2}{x}_{1}-2{x}_{2}^{2}+2{x}_{3}^{2} \\\\  & =2{x}_{1}^{2}+2{x}_{1}{x}_{2}-2{x}_{2}^{2}+2{x}_{3}^{2}\\end{aligned}\n$$\n\n**Method 2**\n\nTo write down a quadratic form in terms of vector components, we compute the following expression:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =\\begin{bmatrix}{x}_{1} & {x}_{2} & {x}_{3}\\end{bmatrix}\\begin{bmatrix}2 & 1 & 0 \\\\ 1 & -2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} \\\\  & =\\begin{bmatrix}{x}_{1} & {x}_{2} & {x}_{3}\\end{bmatrix}\\begin{bmatrix}2{x}_{1}+{x}_{2} \\\\ {x}_{1}-2{x}_{2} \\\\ 2{x}_{3}\\end{bmatrix} \\\\  & ={x}_{1}(2{x}_{1}+{x}_{2})+{x}_{2}({x}_{1}-2{x}_{2})+{x}_{3}(2{x}_{3}) \\\\  & =2{x}_{1}^{2}+{x}_{1}{x}_{2}+{x}_{2}{x}_{1}-2{x}_{x}^{2}+2{x}_{3}^{2} \\\\  & =2{x}_{1}^{2}+2{x}_{1}{x}_{2}-2{x}_{2}^{2}+2{x}_{3}^{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186357656 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "074bc0a8-4ace-5935-8132-e8516c14bc11" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}^{2}+2{x}_{2}^{2}-2{x}_{2}{x}_{3}+3{x}_{3}^{2}" :db/id #edb/ref 17592186354727} {:answer/id #uuid "0c35860c-44ad-5b5c-89ff-8920a976c568" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}^{2}+2{x}_{2}^{2}-2{x}_{2}{x}_{3}" :db/id #edb/ref 17592186354776} {:answer/id #uuid "29a555f5-45bd-56ad-b133-4ea913d8ef19" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}_{2}^{2}-2{x}_{2}{x}_{3}+3{x}_{3}^{2}" :db/id #edb/ref 17592186355011} {:answer/id #uuid "6211823f-d038-5a7f-841f-e14f57f1ed54" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}^{2}+{x}_{2}^{2}-2{x}_{1}{x}_{3}-3{x}_{3}^{2}" :db/id #edb/ref 17592186355538} {:answer/id #uuid "aa727819-380a-594d-a4bd-a5f02c1e6dbc" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}^{2}-2{x}_{2}{x}_{3}+3{x}_{3}^{2}" :db/id #edb/ref 17592186356172}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}^{2}+2{x}_{2}^{2}-2{x}_{2}{x}_{3}+3{x}_{3}^{2}" :db/id #edb/ref 17592186354727} :answer-field/id #uuid "135db05c-789b-5517-a595-77d2c4b006a8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356952}] :question/id #uuid "fee716f7-a185-58ac-8ee8-36859424ee03" :question/math-academy-id "q-94105" :question/problem "$$\nA=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 2 & -1 \\\\ 0 & -1 & 3\\end{bmatrix}\n$$\n\nConsider the matrix $A$ above. Which of the following represents the corresponding quadratic form ${x}^{T}\\,Ax$ in terms of the components of $x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}?$" :question/worked-solution "**Method 1**\n\nEach entry ${a}_{ij}$ of $A$ corresponds to the term ${a}_{ij}{x}_{i}{x}_{j}$ in the expression of the quadratic form:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =1{x}_{1}{x}_{1}+0{x}_{1}{x}_{2}+0{x}_{1}{x}_{3}+0{x}_{2}{x}_{1}+2{x}_{2}{x}_{2}+(-1){x}_{2}{x}_{3}+0{x}_{3}{x}_{1}+(-1){x}_{3}{x}_{2}+3{x}_{3}{x}_{3} \\\\  & ={x}_{1}^{2}+2{x}_{2}^{2}-{x}_{2}{x}_{3}-{x}_{3}{x}_{2}+3{x}_{3}^{2} \\\\  & ={x}_{1}^{2}+2{x}_{2}^{2}-2{x}_{2}{x}_{3}+3{x}_{3}^{2}\\end{aligned}\n$$\n\n**Method 2**\n\nTo write down a quadratic form in terms of vector components, we compute the following expression:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =\\begin{bmatrix}{x}_{1} & {x}_{2} & {x}_{3}\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 2 & -1 \\\\ 0 & -1 & 3\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} \\\\  & =\\begin{bmatrix}{x}_{1} & {x}_{2} & {x}_{3}\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ 2{x}_{2}-{x}_{3} \\\\ -{x}_{2}+3{x}_{3}\\end{bmatrix} \\\\  & ={x}_{1}({x}_{1})+{x}_{2}(2{x}_{2}-{x}_{3})+{x}_{3}(-{x}_{2}+3{x}_{3}) \\\\  & ={x}_{1}^{2}+2{x}_{2}^{2}-{x}_{2}{x}_{3}-{x}_{3}{x}_{2}+3{x}_{3}^{2} \\\\  & ={x}_{1}^{2}+2{x}_{2}^{2}-2{x}_{2}{x}_{3}+3{x}_{3}^{2}\\end{aligned}\n$$"}] :knowledge-point/title "Writing Down a Quadratic Form Given Its Matrix"} {:db/id #edb/ref 17592186161987 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161779 :question/id #uuid "9ed75397-5920-5326-a5b9-7537e30f0a85" :question/math-academy-id "e-8171" :question/problem "![](images/36/36f35d430db979991c566198b6126c940d2b5e35682edbabffb458a77b991488.svg)\nThe matrix of the quadratic form ![](images/16/16124e0080293b4221a1fbe668c41d2c293ebe6780025a433530a48ef7047063.svg) is given above. What is the value of ![](images/43/43b267893b1bca2af9d56014fddd4b93a381f8e2c827cb88e6ba2269f1425432.svg)" :question/worked-solution "Since the matrix of the quadratic form must be symmetric, we rewrite our expression as follows:\n\n![](images/38/38d71b4d0e2e6e4e271e04889292fc77209655fd96accd7ab94358839527c381.svg)\n\nNotice that to get a symmetric matrix, we must do the following splits:\n\n- we split the coefficient of ![](images/3c/3cd51b9ca52bf7654f66792b03bd448a08b1122b07fb9028abf3cf9eb317691e.svg) between the entries ![](images/04/041786e547d7190e7dc272dcce677ae110c98a1c27601d701527c08a27ce069f.svg) and\n\n- we split the coefficient of ![](images/82/824c1904e6a2dbe749c4a8c6dba76e5f1f3470e44c549f9fe472f11b871b1fe5.svg) between the entries ![](images/e2/e2035cd0dc43c754085c2be1daf4394ebe91d59706bc609c2398323dc160edee.svg)\n\nSo, the matrix corresponding to our quadratic form is\n\n![](images/ff/ffc81faf6d2f06bbe8d74cd6b8fc69e9cd1d38a330f492bf925441633ca283e5.svg)\n\nTherefore, ![](images/5d/5db60b1276b1838de62d9a1fa07bdb79930a293720bc5e88ab3113863282afeb.svg) ![](images/af/af43e412255aa69feb8f127bcba2b8aa43eb5d5efb12d692f4f4e2d49c035a98.svg) and ![](images/18/187bf10c65391a58d6b69f746f7f2c4cf2939b3beacfc02c15cef309875c3b57.svg) Finally, \n![](images/af/af56151e2bfb52d48f7b45d954f8c91cbaa1831fe024245667f4f4d721c87e6f.svg)"} :knowledge-point/id #uuid "eb93c0ea-26d9-5190-9677-b8c7eb6f7ef1" :knowledge-point/questions [{:db/id #edb/ref 17592186162596 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9718c9ee-cd30-5cd0-87c5-cd04918c3b71" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186160869} {:answer/id #uuid "c2031d70-3a44-5211-bbc4-abe3865ccd7c" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186160870} {:answer/id #uuid "e07ab923-b588-5da1-bccd-7912e30498e1" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186160871} {:answer/id #uuid "060ea53f-3762-5df0-a2de-551a3e0fa364" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186160872} {:answer/id #uuid "326d4c18-9955-5149-bd77-6e03a650b440" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186160873}] :answer-field/id #uuid "27ba6a1a-118d-5a10-879e-8e78e88cfa8e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186160868}] :question/id #uuid "af66c00c-5d56-53c0-8fd1-794d4dc1b21e" :question/math-academy-id "q-93711" :question/problem "$\\begin{bmatrix}a & 0 & -3 \\\\ 0 & 0 & b \\\\ -3 & b & c\\end{bmatrix}$\nThe matrix of the quadratic form $Q(x) = x_{1}^{2} - 6x_{1}x_{3} + 2x_{2}x_{3} + x_{3}^{2}$ is given above. What is the value of $a + b + c$?"} {:db/id #edb/ref 17592186162597 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2d8b0e0-abf7-5804-b4fc-1492f981e973" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186160875} {:answer/id #uuid "25c5dc3c-74b1-560e-8928-9a38e10da2d3" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186160876} {:answer/id #uuid "625c16aa-5f30-5dd2-90ef-fdf2417a41f8" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186160877} {:answer/id #uuid "62f64a99-2dff-56c3-9292-977af8cfde01" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186160878} {:answer/id #uuid "709af0a8-7e72-5eca-b673-1a1761d01bc0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186160879}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186160878} :answer-field/id #uuid "da8601d7-22c5-5de4-8cfd-e028ad48d9e1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186160874}] :question/id #uuid "cedbc16a-539c-525b-a8a8-cb2cc644cfec" :question/math-academy-id "q-93712" :question/problem "$$\n\\begin{bmatrix}a & b \\\\ b & 1\\end{bmatrix}\n$$\n\nThe matrix of the quadratic form $Q(x)={x}_{1}^{2}+8{x}_{1}{x}_{2}+{x}_{2}^{2}\\,$ is given above. What is the value of $a+b?$" :question/worked-solution "Since the matrix of the quadratic form must be symmetric, we rewrite our expression as follows:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}+8{x}_{1}{x}_{2}+{x}_{2}^{2} \\\\  & =1{x}_{1}^{2}+4{x}_{1}{x}_{2} \\\\  & +\\,4{x}_{2}{x}_{1}+1{x}_{2}^{2}\\end{aligned}\n$$\n\nNotice that to get a symmetric matrix, we must split the coefficient of $8{x}_{1}{x}_{2}$ between the entries \n\n$$\n{a}_{12}={a}_{21}=\\frac{8}{2}=4\n$$\n\nof our matrix. So, the matrix corresponding to our quadratic form is\n\n$$\n\\begin{bmatrix}1 & 4 \\\\ 4 & 1\\end{bmatrix}.\n$$\n\nTherefore, $a=1$ and $b=4.$ Finally, \n\n$$\na+b=1+4=5.\n$$"} {:db/id #edb/ref 17592186272173 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09186c66-3df7-5958-bab9-d6eceedcf24b" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186269352} {:answer/id #uuid "1bc9401d-5750-5d84-973f-2999e18b0e40" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186269498} {:answer/id #uuid "43ef2164-f9ee-520c-ad40-88d74fa2b378" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186269883} {:answer/id #uuid "4d695520-7dd1-5bf7-a0f0-916f7513d13d" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186269969} {:answer/id #uuid "5dddb6f7-c5c2-5d95-b52f-aa67277d9998" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186270103}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186270103} :answer-field/id #uuid "4fa92d2a-c490-5653-aff1-56f027732c5f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271655}] :question/id #uuid "bcdcd1b6-5a07-5e6a-b243-0a76c6534f4f" :question/math-academy-id "q-140932" :question/problem "$$\n\\begin{bmatrix}a & b \\\\ b & 3\\end{bmatrix}\n$$\n\nThe matrix of the quadratic form $Q(x)=2{x}_{1}^{2}-4{x}_{1}{x}_{2}+3{x}_{2}^{2}\\,$ is given above. What is the value of $a+b?$" :question/worked-solution "Since the matrix of the quadratic form must be symmetric, we rewrite our expression as follows:\n\n$$\n\\begin{aligned}Q(x) & =2{x}_{1}^{2}-4{x}_{1}{x}_{2}+3{x}_{2}^{2} \\\\  & =2{x}_{1}^{2}+(-2){x}_{1}{x}_{2} \\\\  & +\\,(-2){x}_{2}{x}_{1}+3{x}_{2}^{2}\\end{aligned}\n$$\n\nNotice that to get a symmetric matrix, we must split the coefficient of $-4{x}_{1}{x}_{2}$ between the entries \n\n$$\n{a}_{12}={a}_{21}=\\frac{(-4)}{2}=-2\n$$\n\nof our matrix. So, the matrix corresponding to our quadratic form is\n\n$$\n\\begin{bmatrix}2 & -2 \\\\ -2 & 3\\end{bmatrix}.\n$$\n\nTherefore, $a=2$ and $b=-2.$ Finally, \n\n$$\na+b=2+(-2)=0.\n$$"} {:db/id #edb/ref 17592186357659 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0501701a-190d-5a45-8507-2cf0af93f7e3" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186354695} {:answer/id #uuid "31ff17e1-d2d2-5ecc-8ab0-d2d9691832ff" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186355102} {:answer/id #uuid "5d57364c-9dc5-5463-ae97-37cb53a5cd4a" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186355489} {:answer/id #uuid "8989d59e-4154-5042-91cd-3e0795b366b2" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186355883} {:answer/id #uuid "aac2fee7-0da6-5dbd-b750-f41f78c29050" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186356176}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186355883} :answer-field/id #uuid "b99f6db4-8e2a-5eb1-905c-4c9003732708" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357254}] :question/id #uuid "5a9d7088-7e39-5869-b0a9-78e9adad33f9" :question/math-academy-id "q-94113" :question/problem "$$\n\\begin{bmatrix}1 & b \\\\ b & c\\end{bmatrix}\n$$\n\nThe matrix of the quadratic form $Q(x)={x}_{1}^{2}-6{x}_{1}{x}_{2}+{x}_{2}^{2}\\,$ is given above. What is the value of $b+c?$" :question/worked-solution "Since the matrix of the quadratic form must be symmetric, we rewrite our expression as follows:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}-6{x}_{1}{x}_{2}+{x}_{2}^{2} \\\\  & =1{x}_{1}^{2}+(-3){x}_{1}{x}_{2} \\\\  & +\\,(-3){x}_{2}{x}_{1}+1{x}_{2}^{2}\\end{aligned}\n$$\n\nNotice that to get a symmetric matrix, we must split the coefficient of $-6{x}_{1}{x}_{2}$ between the entries \n\n$$\n{a}_{12}={a}_{21}=\\frac{-6}{2}=-3\n$$\n\nof our matrix. So, the matrix corresponding to our quadratic form is\n\n$$\n\\begin{bmatrix}1 & -3 \\\\ -3 & 1\\end{bmatrix}.\n$$\n\nTherefore, $b=-3$ and $c=1.$ Finally, \n\n$$\nb+c=-3+1=-2.\n$$"} {:db/id #edb/ref 17592186357660 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02a9e9a8-3c46-5c6f-a0b9-c715263b46fd" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186354679} {:answer/id #uuid "70d8b306-7d64-5a53-bf09-1fcafe21fe9c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186355662} {:answer/id #uuid "cacc7a23-abd5-5d11-b9dd-14002a05348f" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186356433} {:answer/id #uuid "cc6a54ea-970f-5bca-8ce6-3a18756c0f41" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186356448} {:answer/id #uuid "d57fe9de-2cd2-5256-980e-2266baf495ed" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186356534}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186356433} :answer-field/id #uuid "8a785e93-2dfe-5d3a-8afd-c6a0e1ac5840" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357165}] :question/id #uuid "6a58c19a-d8e2-5b8b-a8c1-6d0a7f511f7e" :question/math-academy-id "q-94115" :question/problem "$$\n\\begin{bmatrix}3 & b \\\\ b & c\\end{bmatrix}\n$$\n\nThe matrix of the quadratic form $Q(x)=3{x}_{1}^{2}+2{x}_{1}{x}_{2}-2{x}_{2}^{2}\\,$ is given above. What is the value of $b+c?$" :question/worked-solution "Since the matrix of the quadratic form must be symmetric, we rewrite our expression as follows:\n\n$$\n\\begin{aligned}Q(x) & =3{x}_{1}^{2}+2{x}_{1}{x}_{2}-2{x}_{2}^{2} \\\\  & =3{x}_{1}^{2}+1{x}_{1}{x}_{2} \\\\  & +\\,1{x}_{2}{x}_{1}+(-2){x}_{2}^{2}\\end{aligned}\n$$\n\nNotice that to get a symmetric matrix, we must split the coefficient of $2{x}_{1}{x}_{2}$ between the entries \n\n$$\n{a}_{12}={a}_{21}=\\frac{2}{2}=1\n$$\n\nof our matrix. So, the matrix corresponding to our quadratic form is\n\n$$\n\\begin{bmatrix}3 & 1 \\\\ 1 & -2\\end{bmatrix}.\n$$\n\nTherefore, $b=1$ and $c=-2.$ Finally, \n\n$$\nb+c=1-2=-1.\n$$"} {:db/id #edb/ref 17592186357661 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14aa2eb6-a90e-5fa1-95b6-f566e9355ba2" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186354843} {:answer/id #uuid "2c4dc9fe-2bb6-5f0d-b6a2-62078c10d950" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186355041} {:answer/id #uuid "52ed6140-855d-55e3-8195-d5fae85ccffc" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186355402} {:answer/id #uuid "54fadb67-e550-56ee-b455-08f1179b7848" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186355417} {:answer/id #uuid "a153d998-d9f5-5bc1-a886-d64b15359364" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186356097}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186356097} :answer-field/id #uuid "f4c4e966-ffc9-5fe9-beec-18291365695c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357343}] :question/id #uuid "9072a42a-e341-5217-87b1-4c9dd2071c09" :question/math-academy-id "q-94116" :question/problem "$$\n\\begin{bmatrix}a & b \\\\ b & -3\\end{bmatrix}\n$$\n\nThe matrix of the quadratic form $Q(x)=-2{x}_{1}^{2}-10{x}_{1}{x}_{2}-3{x}_{2}^{2}\\,$ is given above. What is the value of $a+b?$" :question/worked-solution "Since the matrix of the quadratic form must be symmetric, we rewrite our expression as follows:\n\n$$\n\\begin{aligned}Q(x) & =-2{x}_{1}^{2}-10{x}_{1}{x}_{2}-3{x}_{2}^{2} \\\\  & =(-2){x}_{1}^{2}+(-5){x}_{1}{x}_{2} \\\\  & +\\,(-5){x}_{2}{x}_{1}+(-3){x}_{2}^{2}\\end{aligned}\n$$\n\nNotice that to get a symmetric matrix, we must split the coefficient of $-10{x}_{1}{x}_{2}$ between the entries \n\n$$\n{a}_{12}={a}_{21}=\\frac{-10}{2}=-5\n$$\n\nof our matrix. So, the matrix corresponding to our quadratic form is\n\n$$\n\\begin{bmatrix}-2 & -5 \\\\ -5 & -3\\end{bmatrix}.\n$$\n\nTherefore, $a=-2$ and $b=-5.$ Finally, \n\n$$\na+b=-2+(-5)=-7.\n$$"} {:db/id #edb/ref 17592186357662 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05c165b2-19d9-5b56-842e-91d52f290fc3" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186354703} {:answer/id #uuid "96bf3f24-efc2-5a6d-8758-b21872485bac" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186355988} {:answer/id #uuid "af4e1543-ff14-55af-b610-0f2718965ae3" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186356208} {:answer/id #uuid "ba3ca29b-3205-5c6e-aced-a026f1b51486" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186356296} {:answer/id #uuid "d4c02ba2-0e38-50cb-ac5f-abb92419d330" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186356521}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186356521} :answer-field/id #uuid "dd4a0733-31b8-5c9d-a9d1-e36d03123639" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357312}] :question/id #uuid "975a9fdb-6284-526d-91e7-201bd08f5d18" :question/math-academy-id "q-94117" :question/problem "$$\n\\begin{bmatrix}a & 1 & b \\\\ 1 & 0 & 0 \\\\ b & 0 & c\\end{bmatrix}\n$$\n\nThe matrix of the quadratic form $Q(x)=3{x}_{1}^{2}+2{x}_{1}{x}_{2}-10{x}_{1}{x}_{3}+3{x}_{3}^{2}$ is given above. What is the value of $a+b+c?$" :question/worked-solution "Since the matrix of the quadratic form must be symmetric, we rewrite our expression as follows:\n\n$$\n\\begin{aligned}Q(x) & =3{x}_{1}^{2}+2{x}_{1}{x}_{2}-10{x}_{1}{x}_{3}+3{x}_{3}^{2} \\\\  & =3{x}_{1}^{2}+1{x}_{1}{x}_{2}+(-5){x}_{1}{x}_{3} \\\\  & +\\,1{x}_{2}{x}_{1}+0{x}_{2}^{2}+0{x}_{2}{x}_{3} \\\\  & +\\,(-5){x}_{3}{x}_{1}+0{x}_{3}{x}_{2}+3{x}_{3}^{2}\\end{aligned}\n$$\n\nNotice that to get a symmetric matrix, we must do the following splits:\n\n- we split the coefficient of $2{x}_{1}{x}_{2}$ between the entries ${a}_{12}={a}_{21}=\\frac{2}{2}=1,$ and\n\n- we split the coefficient of $-10{x}_{1}{x}_{3}$ between the entries ${a}_{13}={a}_{31}=\\frac{-10}{2}=-5.$\n\nSo, the matrix corresponding to our quadratic form is\n\n$$\n\\begin{bmatrix}3 & 1 & -5 \\\\ 1 & 0 & 0 \\\\ -5 & 0 & 3\\end{bmatrix}.\n$$\n\nTherefore, $a=3,$ $b=-5,$ and $c=3.$ Finally, \n\n$$\na+b+c=3+(-5)+3=1.\n$$"} {:db/id #edb/ref 17592186357663 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26e98748-b388-5506-aac1-9e30f72043d1" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186354991} {:answer/id #uuid "3dd9af0b-3c0e-55a4-a669-bcadc34c08b9" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186355216} {:answer/id #uuid "4978df42-b859-52a6-ba63-1a347384a158" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186355314} {:answer/id #uuid "e34d7105-1d3f-5ec1-968a-d5410c870152" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186356653} {:answer/id #uuid "e64af5fe-d6ac-5ec1-be75-b923dae80e06" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186356678}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186356653} :answer-field/id #uuid "57a91600-a00a-59db-b63e-edcd7437f52e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357067}] :question/id #uuid "b751a90c-cbe5-589a-aef5-36f0a41388ac" :question/math-academy-id "q-94120" :question/problem "$$\n\\begin{bmatrix}1 & 6 & b \\\\ 6 & a & 0 \\\\ b & 0 & c\\end{bmatrix}\n$$\n\nThe matrix of the quadratic form $Q(x)={x}_{1}^{2}+12{x}_{1}{x}_{2}-4{x}_{1}{x}_{3}+{x}_{2}^{2}$ is given above. What is the value of $a+b+c?$" :question/worked-solution "Since the matrix of the quadratic form must be symmetric, we rewrite our expression as follows:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}+12{x}_{1}{x}_{2}-4{x}_{1}{x}_{3}+{x}_{2}^{2} \\\\  & =1{x}_{1}^{2}+6{x}_{1}{x}_{2}+(-2){x}_{1}{x}_{3} \\\\  & +\\,6{x}_{2}{x}_{1}+1{x}_{2}^{2}+0{x}_{2}{x}_{3} \\\\  & +\\,(-2){x}_{3}{x}_{1}+0{x}_{3}{x}_{2}+0{x}_{3}^{2}\\end{aligned}\n$$\n\nNotice that to get a symmetric matrix, we must do the following splits:\n\n- we split the coefficient of $12{x}_{1}{x}_{2}$ between the entries ${a}_{12}={a}_{21}=\\frac{12}{2}=6,$ and\n\n- we split the coefficient of $-4{x}_{1}{x}_{3}$ between the entries ${a}_{13}={a}_{31}=\\frac{-4}{2}=-2.$\n\nSo, the matrix corresponding to our quadratic form is\n\n$$\n\\begin{bmatrix}1 & 6 & -2 \\\\ 6 & 1 & 0 \\\\ -2 & 0 & 0\\end{bmatrix}.\n$$\n\nTherefore, $a=1,$ $b=-2,$ and $c=0.$ Finally, \n\n$$\na+b+c=1+(-2)+0=-1.\n$$"} {:db/id #edb/ref 17592186491163 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c4b303a-da20-585c-9039-a200f7b368d7" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186490659} {:answer/id #uuid "87a1133a-4a67-519e-80d8-5e89f39e7463" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186490782} {:answer/id #uuid "8d4ddb5f-1beb-5278-b235-e2351d1aa9fb" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186490793} {:answer/id #uuid "96b12f22-924f-5fb6-9f0b-8395ca5aa73b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186490818} {:answer/id #uuid "eaafedd0-2b42-5f65-9544-d14ab90678c8" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186490956}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186490793} :answer-field/id #uuid "0a88c7b8-264d-5d69-ba62-b1d185359ee8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491005}] :question/id #uuid "73743ec2-4a1f-56a6-9413-8c931a00dbaa" :question/math-academy-id "q-94121" :question/problem "$$\n\\begin{bmatrix}a & 0 & 1 \\\\ 0 & b & c \\\\ 1 & c & -2\\end{bmatrix}\n$$\n\nThe matrix of the quadratic form $Q(x)=3{x}_{1}^{2}+2{x}_{1}{x}_{3}+4{x}_{2}^{2}-8{x}_{2}{x}_{3}-2{x}_{3}^{2}$ is given above. What is the value of $a+b+c?$" :question/worked-solution "Since the matrix of the quadratic form must be symmetric, we rewrite our expression as follows:\n\n$$\n\\begin{aligned}Q(x) & =3{x}_{1}^{2}+2{x}_{1}{x}_{3}+4{x}_{2}^{2}-8{x}_{2}{x}_{3}-2{x}_{3}^{2} \\\\  & =3{x}_{1}^{2}+0{x}_{1}{x}_{2}+1{x}_{1}{x}_{3} \\\\  & +\\,0{x}_{2}{x}_{1}+4{x}_{2}^{2}+(-4){x}_{2}{x}_{3} \\\\  & +\\,1{x}_{3}{x}_{1}+(-4){x}_{3}{x}_{2}+(-2){x}_{3}^{2}\\end{aligned}\n$$\n\nNotice that to get a symmetric matrix, we must do the following splits:\n\n- we split the coefficient of $2{x}_{1}{x}_{3}$ between the entries ${a}_{13}={a}_{31}=\\frac{2}{2}=1,$ and\n\n- we split the coefficient of $-8{x}_{2}{x}_{3}$ between the entries ${a}_{23}={a}_{32}=\\frac{-8}{2}=-4.$\n\nSo, the matrix corresponding to our quadratic form is\n\n$$\n\\begin{bmatrix}3 & 0 & 1 \\\\ 0 & 4 & -4 \\\\ 1 & -4 & -2\\end{bmatrix}.\n$$\n\nTherefore, $a=3,$ $b=4,$ and $c=-4.$ Finally, \n\n$$\na+b+c=3+4+(-4)=3.\n$$"}] :knowledge-point/title "Finding the Matrix of a Quadratic Form"}] :topic/math-academy-id 3123 :topic/title "Quadratic Forms"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186184968} :activity/id #uuid "d3825ee6-b390-5321-ae3c-5fb0645c7b7b" :activity/steps [{:db/id #edb/ref 17592186184968 :step/content {:db/id #edb/ref 17592186185322 :tutorial/content "Recall that the singular values of a real matrix $A$ are the square roots of the eigenvalues of the matrix $A^T \\! A.$\n\nAlso, since $A^T \\! A$ is a positive semi-definite matrix, the eigenvalues of $A^T \\! A$ must be always non-negative real numbers.\n\nLet's compute the singular values of the matrix $A,$ given by \n\n![](images/a9/a9edbe1fee59758c9557d95ea8f62468f9f3cb98449c437a274bdbf5c30f7dc6.svg)\n\nNow, since\n\n- $A$ is a $3 \\times 2$ matrix, and\n\n- $A^T$ is a $2 \\times 3$ matrix,\n\nthen $A^T \\! A$  must be a $2 \\times 2$ matrix:\n\n$$\n\\underset{\\bbox[Gainsboro, 2pt]{\\large 2} \\times {\\large 3}}{A^T} \\times \\underset{{\\large 3} \\times \\bbox[Gainsboro, 2pt]{\\large 2}}{A} = \n\\underset{\\bbox[Gainsboro, 2pt]{\\large 2} \\times \\bbox[Gainsboro, 2pt]{\\large 2}}{A^T \\! A}\n$$\n\nLet's now compute our singular values. First, we calculate $A^T \\! A\\mathbin{:}$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={[\\begin{aligned}\\,0 & \\,2 \\\\ \\,\\,-2 & \\,0 \\\\ 2 & 1\\end{aligned}]}^{T}[\\begin{aligned}\\,0 & \\,2 \\\\ \\,\\,-2 & \\,0 \\\\ 2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}0 & -2 & 2 \\\\ 2 & 0 & 1\\end{aligned}][\\begin{aligned}\\,0 & \\,2 \\\\ \\,\\,-2 & \\,0 \\\\ 2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}8 & 2 \\\\ 2 & 5\\end{aligned}]\\end{aligned}\n$$\n\nNext, we compute the eigenvalues of $A^T \\! A\\mathbin{:}$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ |\\begin{aligned}8-\\lambda  & 2 \\\\ 2 & 5-\\lambda \\end{aligned}| & =0 \\\\ (8-\\lambda )(5-\\lambda )-4 & =0 \\\\ {\\lambda }^{2}-13\\lambda +36 & =0 \\\\ (\\lambda -9)(\\lambda -4) & =0 \\\\ \\lambda  & =9,\\,4\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{9}=3 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{4}=2\\end{aligned}\n$$\n\nNote the following:\n\n- When listing the singular values of a matrix, we usually write them in descending order.\n\n- If $A$ is a $m\\times n$ matrix, then $A^T A$ is a $n\\times n$ positive semi-definite matrix. This means that $A$ has *at most* $n$ distinct singular values." :tutorial/id #uuid "6230f35e-b526-5e84-be30-86c8cdcbd301" :tutorial/math-academy-id 4891 :tutorial/title "Introduction"} :step/id #uuid "f6870e18-6c9b-57a7-81ca-e24f2af2e69d" :step/next {:db/id #edb/ref 17592186184970}} {:db/id #edb/ref 17592186184970 :step/content {:db/id #edb/ref 17592186184197 :knowledge-point/id #uuid "8063bc9c-a10d-562b-93b1-508b4b26a674"} :step/id #uuid "92a4b43a-dde9-5e42-8877-3e32ba9082f1" :step/next {:db/id #edb/ref 17592186184971}} {:db/id #edb/ref 17592186184971 :step/content {:db/id #edb/ref 17592186184198 :knowledge-point/id #uuid "e2bf7196-b681-5ff6-bf16-24acefa04e6c"} :step/id #uuid "551770c2-906e-5338-b743-2d2902903e74" :step/next {:db/id #edb/ref 17592186184972}} {:db/id #edb/ref 17592186184972 :step/content {:db/id #edb/ref 17592186184199 :knowledge-point/id #uuid "e70dec8f-9828-5fe7-bdb7-47e6557fc889"} :step/id #uuid "749703b1-407a-5adb-8fda-1176ec5284b3"}] :activity/title "Computing the Singular Values of a Matrix" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186184404} {:activity/first-step {:db/id #edb/ref 17592186415583} :activity/id #uuid "53b5db0f-521e-5c61-9c0c-fdff9e2691c7" :activity/steps [{:db/id #edb/ref 17592186415579 :step/content {:db/id #edb/ref 17592186415575 :question/id #uuid "35756e17-7ddb-5db3-9246-f082e3b776e5"} :step/id #uuid "12c4c78d-1201-5f3b-8360-4897312bf437" :step/next {:db/id #edb/ref 17592186415582}} {:db/id #edb/ref 17592186415580 :step/content {:db/id #edb/ref 17592186415578 :question/id #uuid "9d417d43-c45e-500b-a5bf-a441848f66ea"} :step/id #uuid "5d5c433e-0023-555a-a2d0-920150952da3"} {:db/id #edb/ref 17592186415581 :step/content {:db/id #edb/ref 17592186415577 :question/id #uuid "9ba2e577-1f2d-586f-a5db-7d03c7c71c22"} :step/id #uuid "70681b4b-0f8d-5f23-9042-59cb06bbe55f" :step/next {:db/id #edb/ref 17592186415580}} {:db/id #edb/ref 17592186415582 :step/content {:db/id #edb/ref 17592186415574 :question/id #uuid "2512d16d-c375-5bf3-9c3b-0ab4d79702bf"} :step/id #uuid "944a1de7-f0ef-562b-9fc3-c518a5f