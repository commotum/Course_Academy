d #edb/ref 17592186558711}} {:db/id #edb/ref 17592186558711 :step/content {:db/id #edb/ref 17592186543511 :question/id #uuid "66207faf-3d6b-5406-8c58-c05d9d84a48f"} :step/id #uuid "f44a7619-d9b3-5f27-ae19-cd25ea476dc4" :step/next {:db/id #edb/ref 17592186558699}}] :activity/title "Computing the Singular Values of a Matrix" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186557854} {:activity/first-step {:db/id #edb/ref 17592186559962} :activity/id #uuid "456c2843-f8fd-5ae4-a5f7-4b0d67446bb6" :activity/steps [{:db/id #edb/ref 17592186559952 :step/content {:db/id #edb/ref 17592186404794 :question/id #uuid "de321704-9fad-5ba9-910c-dac492b8f0a2"} :step/id #uuid "92011cee-25ec-5645-8649-3c5082cdb2df" :step/next {:db/id #edb/ref 17592186559969}} {:db/id #edb/ref 17592186559962 :step/content {:db/id #edb/ref 17592186543482 :question/id #uuid "1e0723ce-a987-5c3e-a185-24b9f3aa7c5c"} :step/id #uuid "b2c6bcad-aab2-51b4-8844-1a9ba59e06d8" :step/next {:db/id #edb/ref 17592186559973}} {:db/id #edb/ref 17592186559969 :step/content {:db/id #edb/ref 17592186415578 :question/id #uuid "9d417d43-c45e-500b-a5bf-a441848f66ea"} :step/id #uuid "c7261c21-321e-5abd-8187-70f19af061de" :step/next {:db/id #edb/ref 17592186559972}} {:db/id #edb/ref 17592186559972 :step/content {:db/id #edb/ref 17592186559855 :question/id #uuid "c14fd620-27ea-593f-816e-9c2134638c65"} :step/id #uuid "d141f860-642e-5d1b-b75f-8196aeaa74cc"} {:db/id #edb/ref 17592186559973 :step/content {:db/id #edb/ref 17592186559891 :question/id #uuid "ffe00adb-b1a9-53a2-98b2-87735ab0e412"} :step/id #uuid "d45aa491-e815-5760-826e-8fe2c46d302f" :step/next {:db/id #edb/ref 17592186559952}}] :activity/title "Computing the Singular Values of a Matrix" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186559003}] :db/id #edb/ref 17592186049462 :topic/knowledge-points [{:db/id #edb/ref 17592186184197 :knowledge-point/canonical-example {:db/id #edb/ref 17592186184095 :question/id #uuid "fcd3c46b-a87f-5ca8-9cf5-d9444a9c8218" :question/math-academy-id "e-8298" :question/problem "Which of the following statements are true?\n\nI. Any $1\\times4$ matrix $A$ has at most $1$ singular value.\n\nII. Any $4\\times2$ matrix $A$ has at most $2$ distinct singular values.\n\nIII. The matrix ![](images/b8/b8601b1e66ef1d302e7194f262f6a513063bba2114fb063c2fc16542d4684392.svg) has one negative singular value." :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix $A^T \\! A.$ \n\nWith that in mind, let's examine our statements.\n\n- Statement I is false. Since $A$ is a $1 \\times 4$ matrix and $A^T$ is a $4\\times 1$ matrix, $A^T \\! A$ must be a $4 \\times 4$ matrix: \n\n$$\n\\underset{\\bbox[Gainsboro, 2pt]{\\large 4} \\times {\\large 1}}{A^T} \\times \\underset{{\\large 1} \\times \\bbox[Gainsboro, 2pt]{\\large 4}}{A} =  \n\\underset{\\bbox[Gainsboro, 2pt]{\\large 4} \\times \\bbox[Gainsboro, 2pt]{\\large 4}}{A^T \\! A}\n$$\n\nHence, $A$ has at most $4$ distinct singular values.\n\n- Statement II is true. Since $A$ is a $4 \\times 2$ matrix and $A^T$ is a $2\\times 4$ matrix, $A^T \\! A$ must be a $2 \\times 2$ matrix: \n\n$$\n\\underset{\\bbox[Gainsboro, 2pt]{\\large 2} \\times {\\large 4}}{A^T} \\times \\underset{{\\large 4} \\times \\bbox[Gainsboro, 2pt]{\\large 2}}{A} = \n\\underset{\\bbox[Gainsboro, 2pt]{\\large 2} \\times \\bbox[Gainsboro, 2pt]{\\large 2}}{A^T \\! A}\n$$\n\nHence, $A$ has at most $2$ distinct singular values.\n\n- Statement III is false. All singular values of any matrix are non-negative. So, $A$ cannot have a negative singular value.\n\nTherefore, the correct answer is \"II only.\""} :knowledge-point/id #uuid "8063bc9c-a10d-562b-93b1-508b4b26a674" :knowledge-point/questions [{:db/id #edb/ref 17592186184875 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a89b920-2812-5e9a-b4ef-b55725fa54c7" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477485} {:answer/id #uuid "6ad7705e-e7ec-5600-a568-52b823d8bf79" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477486}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477485} :answer-field/id #uuid "2f0ff7a5-9d78-5132-81a7-073af4ec9870" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477712} {:answer-field/choices [{:answer/id #uuid "65778103-abb1-5a51-ba9a-c549e5e3ad81" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477487} {:answer/id #uuid "7d190e4c-24a2-525e-9cd4-0c565240aa00" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477488}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477487} :answer-field/id #uuid "c241f598-5ae6-546e-8c3c-ce84c20b1525" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477713} {:answer-field/choices [{:answer/id #uuid "d2c301e8-3042-5b83-9d6f-a3cd3c672e2f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477489} {:answer/id #uuid "648690a7-b25d-5331-97c9-37c91ce063f4" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477490}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477490} :answer-field/id #uuid "fad352fd-d9d6-51a8-ba50-39d9fde26b2e" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477714}] :question/id #uuid "7b18f54c-8c0b-56f3-8034-8d24cc9bdc28" :question/math-academy-id "q-94772" :question/problem "Which of the following statements are true?\n- **I.** Any $3\\times 2$ matrix $A$ has at most $3$ distinct singular values.\n- **II.** The matrix $A=\\begin{bmatrix}-1 & -2 \\\\ -1 & -5\\end{bmatrix}$ has one negative singular value.\n- **III.** Any $2\\times 3$ matrix $A$ has at most $3$ distinct singular values.\n\nSelect all that apply." :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nWith that in mind, let's examine our statements.\n\n- Statement I is false. Since $A$ is a $3\\times 2$ matrix and ${A}^{T}$ is a $2\\times 3$ matrix, ${A}^{T}\\,A$ must be a $2\\times 2$ matrix: \n\n$$\n{{A}^{T}}_{2\\times 3}\\times {A}_{3\\times 2}={{A}^{T}\\,A}_{2\\times 2}\n$$\n\nHence, $A$ has at most $2$ distinct singular values.\n\n- Statement II is false. All singular values of any matrix are non-negative. So, $A$ can't have a negative singular value.\n\n- Statement III is true. Since $A$ is a $2\\times 3$ matrix and ${A}^{T}$ is a $3\\times 2$ matrix, ${A}^{T}\\,A$ must be a $3\\times 3$ matrix: \n\n$$\n{{A}^{T}}_{3\\times 2}\\times {A}_{2\\times 3}={{A}^{T}\\,A}_{3\\times 3}\n$$\n\nHence, $A$ has at most $3$ distinct singular values.\n\nTherefore, the correct answer is \"III only.\""} {:db/id #edb/ref 17592186184880 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8efaa7d5-f9c1-56d1-b041-870f83717eff" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448816} {:answer/id #uuid "d28105b0-23f3-5732-9a82-7db8b4e10ae9" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448817}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448817} :answer-field/id #uuid "9bc10bda-7ab1-5fd3-896c-4bee40367151" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449448} {:answer-field/choices [{:answer/id #uuid "2ecbf0cb-7482-525b-af23-0f6eedf07bf6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448818} {:answer/id #uuid "75f995d4-8d71-5835-90af-2cf0d9e4393d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448819}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448818} :answer-field/id #uuid "39e6f456-10c0-5895-9297-e441c42c23b7" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449449} {:answer-field/choices [{:answer/id #uuid "fde610d7-4aa6-5762-bc9a-8f3a82dec1ef" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448820} {:answer/id #uuid "3cfbd6db-1b8f-5c35-858d-8ef464e8ed9a" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448821}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448821} :answer-field/id #uuid "f0ff5f73-3abd-58c8-a261-ec9d90c47add" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449450}] :question/id #uuid "ca5e4c86-b607-523c-a857-24250b844373" :question/math-academy-id "q-95299" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** Any $6\\times 8$ matrix $A$ has at most $8$ distinct singular values\n- **II.** Any $10\\times 8$ matrix $A$ has at most $10$ distinct singular values.\n- **III.** The matrix $A=\\begin{bmatrix}0 & -1 \\\\ -1 & 0\\end{bmatrix}$ has two non-negative singular values." :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed, since $A$ is a $6\\times 8$ matrix and ${A}^{T}$ is a $8\\times 6$ matrix, ${A}^{T}\\,A$ must be a $8\\times 8$ matrix: \n\n$$\n{{A}^{T}}_{8\\times 6}\\times {A}_{6\\times 8}={{A}^{T}\\,A}_{8\\times 8}\n$$\n\nHence, $A$ has at most $8$ distinct singular values.\n\n- Statement II is false. Since $A$ is a $10\\times 8$ matrix and ${A}^{T}$ is a $8\\times 10$ matrix, ${A}^{T}\\,A$ must be a $8\\times 8$ matrix: \n\n$$\n{{A}^{T}}_{8\\times 10}\\times {A}_{10\\times 8}={{A}^{T}\\,A}_{8\\times 8}\n$$\n\nHence, $A$ has at most $8$ distinct singular values.\n\n- Statement III is true.  Indeed, all singular values of any matrix are non-negative.\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186368899 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dd7d102-aedc-5e91-a047-f8cad7922fa4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452179} {:answer/id #uuid "92081811-29e7-5671-8299-e57c420e3eed" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452180}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452179} :answer-field/id #uuid "c8ec87bb-4b3c-5297-b2b5-774e119551e7" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452937} {:answer-field/choices [{:answer/id #uuid "2f401cf9-efdd-54a5-8b7a-61de53c5e100" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452181} {:answer/id #uuid "d311e63e-ec0f-59e7-bd16-ff6db836531a" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452182}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452181} :answer-field/id #uuid "968b4eb6-8e02-5cf8-a607-4efe45260c79" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452938} {:answer-field/choices [{:answer/id #uuid "097bc3b9-dca8-57a1-8757-cc94a3779994" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452183} {:answer/id #uuid "862c2197-4e1a-56eb-9ab6-61a342ae1dbd" 