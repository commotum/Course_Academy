 :answer.type/math} :answer/value "r\\cdot ⟨1,-2,5⟩=-1" :db/id #edb/ref 17592186390852} :answer-field/id #uuid "d0db56fe-4519-5626-a551-2a57e0daa778" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390849}] :question/id #uuid "a8d650e6-dfa8-594c-8c20-f63e265d1d5b" :question/math-academy-id "q-33026" :question/problem "Find an equation of the plane that contains the point  $Q(3,2,0)$ and is  perpendicular to the vector $n=⟨1,-2,5⟩.$" :question/worked-solution "First, we note that the position vector of $Q$ is $q=⟨3,2,0⟩,$ and $n=⟨1,-2,5⟩$ is normal to the plane.\n\nThe equation of the plane that passes though the point $Q({x}_{0},{y}_{0},{z}_{0})$ and is perpendicular to the vector $n$ can be given as\n\n$$\n(r-q)\\cdot n=0,\n$$\n\nwhere $r$ is the position vector of any point on the plane, and $q$ is the position vector of $Q.$\n\nSo, we have\n\n$$\n\\begin{aligned}(r-q)\\cdot n & =0 \\\\ r\\cdot n-q\\cdot n & =0 \\\\ r\\cdot n & =q\\cdot n \\\\ r\\cdot ⟨1,-2,5⟩ & =⟨3,2,0⟩\\cdot ⟨1,-2,5⟩ \\\\ r\\cdot ⟨1,-2,5⟩ & =-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186392994 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "679c7dcb-5145-5780-81d8-87024bb1bd27" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot \\begin{bmatrix}3 \\\\ 6 \\\\ 2\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -4 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186392996} {:answer/id #uuid "b5515e80-84a8-5eb8-a2be-ba588012a168" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot \\begin{bmatrix}1 \\\\ -4 \\\\ 5\\end{bmatrix}=\\begin{bmatrix}3 \\\\ 6 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186392997} {:answer/id #uuid "f3d8dd1b-1865-5a25-92a3-6c3b04aadb53" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot \\begin{bmatrix}1 \\\\ -4 \\\\ 5\\end{bmatrix}=9" :db/id #edb/ref 17592186392998} {:answer/id #uuid "88367f38-9b3d-5d8d-9f17-294ee6119dfb" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot \\begin{bmatrix}3 \\\\ 6 \\\\ 2\\end{bmatrix}=-20" :db/id #edb/ref 17592186392999} {:answer/id #uuid "e1992dff-615f-5a0d-8cc8-9fbb461f55a5" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot \\begin{bmatrix}3 \\\\ 6 \\\\ 2\\end{bmatrix}=-11" :db/id #edb/ref 17592186393000}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot \\begin{bmatrix}3 \\\\ 6 \\\\ 2\\end{bmatrix}=-11" :db/id #edb/ref 17592186393000} :answer-field/id #uuid "9228779e-fa16-5c42-9940-9025c4863d96" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392995}] :question/id #uuid "559832c2-15b2-5b81-bb2b-4adab3a391f2" :question/math-academy-id "q-70647" :question/problem "Find an equation of the plane that passes through the point $P(1,-4,5)$ and is perpendicular to the vector $n=\\begin{bmatrix}3 \\\\ 6 \\\\ 2\\end{bmatrix}.$" :question/worked-solution "First, notice that the position vector of $P$ is $p=\\begin{bmatrix}1 \\\\ -4 \\\\ 5\\end{bmatrix}$ and $n=\\begin{bmatrix}3 \\\\ 6 \\\\ 2\\end{bmatrix}$ is normal to the plane. \n\nThe equation of the plane that passes though the point $P({x}_{0},{y}_{0},{z}_{0})$ and is perpendicular to the vector $n$ can be given as\n\n$$\n(r-p)\\cdot n=0,\n$$\n\nwhere $r$ is the position vector of any point on the plane, and $p$ is the position vector of $P.$\n\nSo, we have\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot \\begin{bmatrix}3 \\\\ 6 \\\\ 2\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ -4 \\\\ 5\\end{bmatrix}\\cdot \\begin{bmatrix}3 \\\\ 6 \\\\ 2\\end{bmatrix} \\\\ r\\cdot \\begin{bmatrix}3 \\\\ 6 \\\\ 2\\end{bmatrix} & =-11.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186413463 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32743a37-ea98-5030-bc97-5c9249817938" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-1,-2,3⟩=0" :db/id #edb/ref 17592186413446} {:answer/id #uuid "3bf9d08c-d107-5f44-9c81-8ad84d2c8cae" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨5,-1,1⟩=⟨1,2,-3⟩" :db/id #edb/ref 17592186413447} {:answer/id #uuid "6906bd4d-81fa-56e9-9975-333718bd9981" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨5,-1,1⟩=-4" :db/id #edb/ref 17592186413450} {:answer/id #uuid "a556e4c0-7956-5861-be5e-2d8ead0ef5eb" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-1,-2,3⟩=⟨-5,1,-1⟩" :db/id #edb/ref 17592186413452} {:answer/id #uuid "c3bbba03-77ef-54a0-90c6-08b40f6f1852" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-1,-2,3⟩=10" :db/id #edb/ref 17592186413456}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-1,-2,3⟩=0" :db/id #edb/ref 17592186413446} :answer-field/id #uuid "c10fc8bb-0d7f-5bee-84f8-1fa8a92dd2ab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413461}] :question/id #uuid "bced3755-fd06-539b-819f-10c4ab686823" :question/math-academy-id "q-32972" :question/problem "Find an equation of the plane that contains the point $Q(5,-1,1)$ and is perpendicular to the vector $n=⟨-1,-2,3⟩.$" :question/worked-solution "First, we note that the position vector of $Q$ is $q=⟨5,-1,1⟩$ and $n=⟨-1,-2,3⟩$ is normal to the plane.\n\nThe equation of the plane that passes though the point $Q({x}_{0},{y}_{0},{z}_{0})$ and is perpendicular to the vector $n$ can be given as\n\n$$\n(r-q)\\cdot n=0,\n$$\n\nwhere $r$ is the position vector of any point on the plane, and $q$ is the position vector of $Q.$\n\nSo, we have\n\n$$\n\\begin{aligned}(r-q)\\cdot n & =0 \\\\ r\\cdot n-q\\cdot n & =0 \\\\ r\\cdot n & =q\\cdot n \\\\ r\\cdot ⟨-1,-2,3⟩ & =⟨5,-1,1⟩\\cdot ⟨-1,-2,3⟩ \\\\ r\\cdot ⟨-1,-2,3⟩ & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186413464 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "061185a3-b68f-5683-8fef-601edcc7e95a" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-1,2,-1⟩=3" :db/id #edb/ref 17592186413444} {:answer/id #uuid "25d0e859-47cf-5e2e-9ce5-c53b1448f6f2" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-1,-2,1⟩=-3" :db/id #edb/ref 17592186413445} {:answer/id #uuid "afd07518-3061-5b76-96ee-db6a415e76db" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨1,-2,-1⟩=3" :db/id #edb/ref 17592186413453} {:answer/id #uuid "b94406b8-9d2b-52e2-8a01-3a285d79c857" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨1,-2,-1⟩=-3" :db/id #edb/ref 17592186413455} {:answer/id #uuid "e2856d01-e48b-5c22-b7b4-3fdd89bdafd8" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨1,-2,-1⟩=-1" :db/id #edb/ref 17592186413458}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨1,-2,-1⟩=3" :db/id #edb/ref 17592186413453} :answer-field/id #uuid "5979170b-e938-5576-b257-2c5e77488161" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413460}] :question/id #uuid "fae89980-f6bf-5229-9ea3-54197530dd8b" :question/math-academy-id "q-127645" :question/problem "Find an equation of the plane that contains the point $P(3,-2,4)$ and is perpendicular to the vector $n=⟨1,-2,-1⟩.$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨3,-2,4⟩,$ and $n=⟨1,-2,-1⟩$ is normal to the plane.\n\nThe equation of the plane that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is perpendicular to the vector $n$ can be given as\n\n$$\n(r-p)\\cdot n=0,\n$$\n\nwhere $r$ is the position vector of any point on the plane, and $p$ is the position vector of $P.$\n\nSo, we have\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨1,-2,-1⟩ & =⟨3,-2,4⟩\\cdot ⟨1,-2,-1⟩ \\\\ r\\cdot ⟨1,-2,-1⟩ & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186423177 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54c2e93d-88d9-55e5-8da7-a7c8857c95a2" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot \\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix}=1" :db/id #edb/ref 17592186423171} {:answer/id #uuid "865e5880-5d6c-5eb8-b605-32023bca731a" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot \\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}=0" :db/id #edb/ref 17592186423172} {:answer/id #uuid "88b7b35b-b8a9-55fa-b177-e46dd3a1176a" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot \\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix}=-1" :db/id #edb/ref 17592186423173} {:answer/id #uuid "c899f30d-448a-55d6-a220-50efc27da551" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot \\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}=1" :db/id #edb/ref 17592186423174} {:answer/id #uuid "f42a4087-cff6-5d2b-9264-832562c287ce" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot \\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186423175}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot \\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}=1" :db/id #edb/ref 17592186423174} :answer-field/id #uuid "ed6bca43-1900-5519-94be-29cc1bb55d43" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423176}] :question/id #uuid "9509d4b2-8f43-5f25-8917-81a3d5d9b04d" :question/math-academy-id "q-33195" :question/problem "Find an equation of the plane that contains the point $P(0,1,1)$ and is perpendicular to the vector $n=\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}.$" :question/worked-solution "First, notice that the position vector of $P$ is $p=\\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix}$ and $n=\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}$ is normal to the plane.\n\nThe equation of the plane that passes though the point $P({x}_{0},{y}_{0},{z}_{0})$ and is perpendicular to the vector $n$ can be given as\n\n$$\n(r-p)\\cdot n=0,\n$$\n\nwhere $r$ is the position vector of any point on the plane, and $p$ is the position vector of $P.$\n\nSo, we have\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot \\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix} \\\\ r\\cdot \\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix} & =1.\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Vector Equation of the Plane Perpendicular to a Given Vector"} {:db/id #edb/ref 17592186119830 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119641 :question/id #uuid "a33f6c43-4e25-5d67-9f73-ca99a18fb434" :question/math-academy-id "e-4933" :question/problem "A nonzero vector $\\langle 0,\\, \\bbox[2pt,Gainsboro]{b}, \\: \\bbox[2pt,Gainsboro]{c} \\rangle$ is parallel to the plane $\\mathbf{r} \\cdot \\langle 2, -1, 4 \\rangle  = 3.$ What is the value of $\\dfrac{b}{c}?$" :question/worked-solution "We need a vector $\\mathbf{v} = \\langle t_1,t_2,t_3 \\rangle$ that is parallel to the given plane. \n\nFrom the equation $\\mathbf{r} \\cdot \\langle 2, -1, 4 \\rangle  = 3$ of the plane, we get the normal vector $\\mathbf{n}=\\langle 2, -1, 4 \\rangle.$ So, $\\mathbf{v} \\perp \\mathbf{n}$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨2,-1,4⟩ & =0 \\\\ 2{t}_{1}-{t}_{2}+4{t}_{3} & =0 \\\\ {t}_{2} & =2{t}_{1}+4{t}_{3}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\n\\mathbf{v}=\\langle t_1, 2t_1 + 4t_3, t_3 \\rangle,\n$$\n\nwhere $t_1,t_3 \\in (-\\infty,\\infty).$ \n\nWe are told that the first component of $\\mathbf{v}$ equals $0.$ So, we must set $t_1=0.$ \n\nSince $\\mathbf{v}$ is nonzero, we can pick any $t_3 \\neq 0.$ For example, setting $t_3=1$, we get\n\n$$\n\\mathbf{v} = \\langle 0,\\, \\bbox[2pt,Gainsboro]{4}, \\, \\bbox[2pt,Gainsboro]{1} \\rangle.\n$$\n\nTherefore, $\\dfrac{b}{c} = 4.$"} :knowledge-point/id #uuid "b0d93156-f9be-5e6e-976a-bef30dc892ee" :knowledge-point/questions [{:db/id #edb/ref 17592186120248 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c4846e6-07fa-5199-92fa-c23138fb6c7f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186305727} {:answer/id #uuid "5a1bb14c-5955-581a-b7ba-96cdefb1c303" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186306012} {:answer/id #uuid "74c26a6c-96c5-502a-b012-f87b7a57e25f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186306261} {:answer/id #uuid "7914febd-cdaa-5378-9536-eea1bae6ff8a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186306305} {:answer/id #uuid "8c64b39c-1d55-5de4-bd2e-bb1289db7f07" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186306485}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186306261} :answer-field/id #uuid "b1987b64-0643-52df-ab2f-a1e652a8c54a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186308086}] :question/id #uuid "d32af589-36a2-5da2-a4fd-d2edd8386949" :question/math-academy-id "q-33319" :question/problem "A nonzero vector $⟨a,\\,b,\\,0⟩$ is parallel to the plane $r\\cdot ⟨6,-2,0⟩=-14.$ What is the value of $\\frac{a}{b}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨6,-2,0⟩=-14$ of the plane, we get the normal vector $n=⟨6,-2,0⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨6,-2,0⟩ & =0 \\\\ 6{t}_{1}-2{t}_{2} & =0 \\\\ {t}_{2} & =3{t}_{1}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},3{t}_{1},{t}_{3}⟩,\n$$\n\nwhere ${t}_{1},{t}_{3}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the third component of $v$ eqauls $0.$ So, we must set ${t}_{3}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{1}\\ne 0.$ For example, setting ${t}_{1}=1$, we get\n\n$$\nv=⟨1,\\,3,\\,0⟩.\n$$\n\nTherefore, $\\frac{a}{b}=\\frac{1}{3}.$"} {:db/id #edb/ref 17592186120508 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30f92df8-451b-5c89-afe4-2baa87ea99f7" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186336501} {:answer/id #uuid "6e834384-8f29-5ff4-9222-0f7a9f6994fb" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186337012} {:answer/id #uuid "8b1f431b-0e82-51f2-ba39-70abbb308701" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186337291} {:answer/id #uuid "dd802b6b-b301-5612-8ca6-ffbbd614fa35" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186337959} {:answer/id #uuid "f8454c79-6668-58ba-8cdc-97692e6243bb" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186338208}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186337012} :answer-field/id #uuid "a1d6e4be-5b5b-5868-8505-0ae308184b08" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338577}] :question/id #uuid "f1725487-2c6d-5d22-95bb-183dbe4038eb" :question/math-academy-id "q-70821" :question/problem "A nonzero vector $⟨a,\\,0,\\,c⟩$ is parallel to the plane $r\\cdot ⟨3,-3,1⟩=-12.$ What is the value of $\\frac{a}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation of the plane, $r\\cdot ⟨3,-3,1⟩=-12,$  we get the normal vector $n=⟨3,-3,1⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨3,-3,1⟩ & =0 \\\\ 3{t}_{1}-3{t}_{2}+{t}_{3} & =0 \\\\ {t}_{3} & =3{t}_{2}-3{t}_{1}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},{t}_{2},3{t}_{2}-3{t}_{1}⟩,\n$$\n\nwhere ${t}_{1},{t}_{2}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the second component of $v$ eqauls $0.$ So, we must set ${t}_{2}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{1}\\ne 0.$ For example, setting ${t}_{1}=1$, we get\n\n$$\nv=⟨1,\\,0,-3⟩.\n$$\n\nTherefore, $\\frac{a}{c}=\\frac{1}{-3}=-\\frac{1}{3}.$"} {:db/id #edb/ref 17592186262837 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1db4c2af-2e78-5ec5-8ede-f1aff92a3bae" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186260130} {:answer/id #uuid "4e4df1a9-277d-5ebc-8864-b31c9ef3bafa" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186260540} {:answer/id #uuid "86ae6e82-65b8-5c01-9bd6-0496eaf7bc36" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186261049} {:answer/id #uuid "b8ab9526-555f-538e-8473-1cc8d4c5b366" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186261494} {:answer/id #uuid "f9ced82e-1eb9-51cb-8708-d7eb16c14606" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186262056}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186260130} :answer-field/id #uuid "40642ce9-2755-5ebb-8afd-84006382c910" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262238}] :question/id #uuid "1e0d1c80-eb5c-5bda-b21b-a06adaec16d2" :question/math-academy-id "q-127873" :question/problem "A nonzero vector $⟨0,\\,b,\\,c⟩$ is parallel to the plane $r\\cdot ⟨-3,1,-2⟩=7.$ What is the value of $\\frac{b}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨-3,1,-2⟩=7$ of the plane, we get the normal vector $n=⟨-3,1,-2⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨-3,1,-2⟩ & =0 \\\\ -3{t}_{1}+{t}_{2}-2{t}_{3} & =0 \\\\ {t}_{2} & =3{t}_{1}+2{t}_{3}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},\\,3{t}_{1}+2{t}_{3},\\,{t}_{3}⟩,\n$$\n\nwhere ${t}_{1},{t}_{3}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the first component of $v$ equals $0.$ So, we must set ${t}_{1}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{3}\\ne 0.$ For example, setting ${t}_{3}=1$, we get\n\n$$\nv=⟨0,\\,2,\\,1⟩.\n$$\n\nTherefore, $\\frac{b}{c}=2.$"} {:db/id #edb/ref 17592186262838 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28523b60-9c94-5e08-8811-eeb6c2c8385b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186260229} {:answer/id #uuid "4f6f925d-2385-5203-beed-2ae656f27e99" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186260554} {:answer/id #uuid "71ffe7bc-2035-50b5-afb6-f098f001c957" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186260872} {:answer/id #uuid "c1024317-bb4d-5e9d-b670-c092e80227c9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186261578} {:answer/id #uuid "fbc3f903-0607-5523-bb23-e9a27fc580dd" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186262077}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186260229} :answer-field/id #uuid "9e71e846-7ac8-5f2e-bf8c-340173700a84" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262406}] :question/id #uuid "1298261d-fd1d-57fd-8c0d-689d1739fab9" :question/math-academy-id "q-127888" :question/problem "A nonzero vector $⟨0,\\,b,\\,c⟩$ is parallel to the plane $r\\cdot ⟨3,2,-1⟩=\\sqrt{2}.$ What is the value of $\\frac{b}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨3,2,-1⟩=\\sqrt{2}$ of the plane, we get the normal vector $n=⟨3,2,-1⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨3,2,-1⟩ & =0 \\\\ 3{t}_{1}+2{t}_{2}-{t}_{3} & =0 \\\\ {t}_{3} & =3{t}_{1}+2{t}_{2}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},\\,{t}_{2},\\,3{t}_{1}+2{t}_{2}⟩,\n$$\n\nwhere ${t}_{1},{t}_{2}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the first component of $v$ equals $0.$ So, we must set ${t}_{1}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{2}\\ne 0.$ For example, setting ${t}_{2}=1$, we get\n\n$$\nv=⟨0,\\,1,\\,2⟩.\n$$\n\nTherefore, $\\frac{b}{c}=\\frac{1}{2}.$"} {:db/id #edb/ref 17592186262846 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1066db60-12af-5e82-a7c0-d24afa450e35" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186260024} {:answer/id #uuid "336d23d9-d848-54ca-86e6-782c1b13a369" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186260339} {:answer/id #uuid "6bfd83ea-5bb5-57e7-b814-e0e365ce1b44" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186260820} {:answer/id #uuid "d4093fa7-7b24-5445-bf63-718de7a82e0c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186261744} {:answer/id #uuid "f03309e1-ca15-5335-aab5-a2535a4337a6" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186261981}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186260339} :answer-field/id #uuid "f46674a6-7e2b-5656-b018-7f5bf5e7afa0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262547}] :question/id #uuid "aa3bed00-1af4-5c46-8c12-264209634c51" :question/math-academy-id "q-127910" :question/problem "A nonzero vector $⟨a,\\,0,\\,c⟩$ is parallel to the plane $r\\cdot ⟨-1,1,3⟩=\\sqrt{7}.$ What is the value of $\\frac{a}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨-1,1,3⟩=\\sqrt{7}$ of the plane, we get the normal vector $n=⟨-1,1,3⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨-1,1,3⟩ & =0 \\\\ -{t}_{1}+{t}_{2}+3{t}_{3} & =0 \\\\ {t}_{1} & ={t}_{2}+3{t}_{3}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{2}+3{t}_{3},\\,{t}_{2},{t}_{3}⟩,\n$$\n\nwhere ${t}_{2},{t}_{3}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the second component of $v$ equals $0.$ So, we must set ${t}_{2}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{3}\\ne 0.$ For example, setting ${t}_{3}=1$, we get\n\n$$\nv=⟨3,\\,0,\\,1⟩.\n$$\n\nTherefore, $\\frac{a}{c}=3.$"} {:db/id #edb/ref 17592186262847 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2beba37f-86cf-5232-87f0-3a72cad6aa1b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186260265} {:answer/id #uuid "3388728b-fa84-5463-ad08-b7f075149767" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{11}" :db/id #edb/ref 17592186260342} {:answer/id #uuid "69593a3f-9b3e-5e03-9feb-98b4870ba2e3" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186260795} {:answer/id #uuid "7850ba65-684f-536f-99f4-bd2f68dda967" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186260926} {:answer/id #uuid "c555ef85-87ee-5b9d-892c-6ac228026dc4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186261616}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186260265} :answer-field/id #uuid "9a41bb79-1d8e-5e75-a39b-9f8ce0aeeb7d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262400}] :question/id #uuid "c1c9c582-8595-5cfb-925f-05282f9b76e5" :question/math-academy-id "q-127911" :question/problem "A nonzero vector $⟨a,\\,0,\\,c⟩$ is parallel to the plane $r\\cdot ⟨-1,2,2⟩=\\sqrt{11}.$ What is the value of $\\frac{a}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨-1,2,2⟩=\\sqrt{11}$ of the plane, we get the normal vector $n=⟨-1,2,2⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨-1,2,2⟩ & =0 \\\\ -{t}_{1}+2{t}_{2}+2{t}_{3} & =0 \\\\ {t}_{1} & =2{t}_{2}+2{t}_{3}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨2{t}_{2}+2{t}_{3},\\,{t}_{2},\\,{t}_{3}⟩,\n$$\n\nwhere ${t}_{2},{t}_{3}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the second component of $v$ equals $0.$ So, we must set ${t}_{2}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{3}\\ne 0.$ For example, setting ${t}_{3}=1$, we get\n\n$$\nv=⟨2,\\,0,\\,1⟩.\n$$\n\nTherefore, $\\frac{a}{c}=2.$"} {:db/id #edb/ref 17592186308389 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2be2860e-76f3-5d9d-bf88-ce7854d1a186" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186305571} {:answer/id #uuid "6c6f1eb0-ee64-514d-98de-d34d9b44314a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186306190} {:answer/id #uuid "7b28870c-c686-56de-8301-a1d3a6669a64" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186306326} {:answer/id #uuid "7b563320-dadf-52e8-ae03-48cf4482b401" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186306330} {:answer/id #uuid "e06638bf-2fdd-5ef3-8ff6-f99f8daca96b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186307227}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186305571} :answer-field/id #uuid "f682525d-3133-53f0-ba43-839c46ba42eb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186308303}] :question/id #uuid "a973cbbd-df7e-5f41-a87c-5c205b31db4a" :question/math-academy-id "q-33313" :question/problem "A nonzero vector $⟨a,\\,0,\\,c⟩$ is parallel to the plane $r\\cdot ⟨4,0,2⟩=16.$ What is the value of $\\frac{a}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨4,0,2⟩=16$ of the plane, we get the normal vector $n=⟨4,0,2⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨4,0,2⟩ & =0 \\\\ 4{t}_{1}+2{t}_{3} & =0 \\\\ 2{t}_{3} & =-4{t}_{1} \\\\ {t}_{3} & =-2{t}_{1}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},\\,{t}_{2},\\,-2{t}_{1}⟩,\n$$\n\nwhere ${t}_{1},{t}_{2}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the second component of $v$ equals $0.$ So, we must set ${t}_{2}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{1}\\ne 0.$ For example, setting ${t}_{1}=1$, we get\n\n$$\nv=⟨1,\\,0,\\,-2⟩.\n$$\n\nTherefore, $\\frac{a}{c}=-\\frac{1}{2}.$"} {:db/id #edb/ref 17592186338827 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b4cf333-fb31-53e5-a3b2-4d1da8c129ea" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186337143} {:answer/id #uuid "8699f13d-227d-54e9-8db2-f586a65cc4a8" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186337250} {:answer/id #uuid "8ed87010-5adf-5b37-aeca-2e7df330c813" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186337317} {:answer/id #uuid "92eae00f-5f08-53b6-b534-72b9e6866cbc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186337371} {:answer/id #uuid "a20a8aa3-4bd5-5bea-8e7e-61c74a32567a" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186337501}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186337317} :answer-field/id #uuid "557fd6f3-4749-5c34-935d-a0b820019a0f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338422}] :question/id #uuid "22393ec9-8250-54f3-ad30-3ecff187a9da" :question/math-academy-id "q-70814" :question/problem "A nonzero vector $⟨0,\\,b,\\,c⟩$ is parallel to the plane $r\\cdot ⟨1,-2,1⟩=10.$ What is the value of $\\frac{b}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨1,-2,1⟩=10$ of the plane, we get the normal vector $n=⟨1,-2,1⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨1,-2,1⟩ & =0 \\\\ {t}_{1}-2{t}_{2}+{t}_{3} & =0 \\\\ {t}_{3} & =2{t}_{2}-{t}_{1}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=\\begin{bmatrix}{t}_{1} \\\\ {t}_{2} \\\\ 2{t}_{2}-{t}_{1}\\end{bmatrix},\n$$\n\nwhere ${t}_{1},{t}_{2}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the first component of $v$ equals $0.$ So, we must set ${t}_{1}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{2}\\ne 0.$ For example, setting ${t}_{2}=1$, we get\n\n$$\nv=⟨0,\\,1,\\,2⟩.\n$$\n\nTherefore, $\\frac{b}{c}=\\frac{1}{2}.$"} {:db/id #edb/ref 17592186338828 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "021e4e67-7010-5485-9b89-cfeeb7d10451" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186336050} {:answer/id #uuid "05f44b25-e549-5024-872e-4c4912f94181" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186336080} {:answer/id #uuid "39aee5e7-07d0-54c2-87e3-baadc590c41e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186336574} {:answer/id #uuid "68913fec-0010-53ce-97fd-f1effeb01d79" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186336964} {:answer/id #uuid "f4ebba20-fcb1-5c49-9ea4-d8297f4c6a97" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186338173}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186336574} :answer-field/id #uuid "c81f1744-1b47-5344-b32f-ae5d1db03724" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338636}] :question/id #uuid "e7945519-2cef-57b7-a592-36730597689e" :question/math-academy-id "q-70817" :question/problem "A nonzero vector $⟨a,\\,0,\\,c⟩$ is parallel to the plane $r\\cdot ⟨3,0,1⟩=5.$ What is the value of $\\frac{a}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨3,0,1⟩=5$ of the plane, we get the normal vector $n=⟨3,0,1⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨3,0,1⟩ & =0 \\\\ 3{t}_{1}+{t}_{3} & =0 \\\\ {t}_{3} & =-3{t}_{1}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},{t}_{2},-3{t}_{1}⟩\n$$\n\nwhere ${t}_{1},{t}_{2}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the second component of $v$ equals $0.$ So, we must set ${t}_{2}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{1}\\ne 0.$ For example, setting ${t}_{1}=1$, we get\n\n$$\nv=⟨1,\\,0,\\,-3⟩.\n$$\n\nTherefore, $\\frac{a}{c}=-\\frac{1}{3}.$"} {:db/id #edb/ref 17592186338829 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46a8c73e-1b6f-5ead-8b4e-04fd47ae71ea" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186336688} {:answer/id #uuid "566ad7e4-2332-5818-b1ab-63f151123755" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186336827} {:answer/id #uuid "6955aab1-e2a7-5bda-a291-b54a99b1d9fb" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id #edb/ref 17592186336968} {:answer/id #uuid "806b2ca4-42eb-53b0-90bb-44522d3b01e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186337195} {:answer/id #uuid "d93906ff-8ee7-57c5-a797-f2d48eaf72f3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186337922}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186336688} :answer-field/id #uuid "ac53d05e-4ae9-5aad-8699-2cdc5ab0d589" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338592}] :question/id #uuid "3c12dba6-0a5e-5abe-ba85-6c6b625059ee" :question/math-academy-id "q-70822" :question/problem "A nonzero vector $⟨a,\\,b,\\,0⟩$ is parallel to the plane $r\\cdot ⟨-5,-1,4⟩=6.$ What is the value of $\\frac{a}{b}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨-5,-1,4⟩=6$ of the plane, we get the normal vector $n=⟨-5,-1,4⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨-5,-1,4⟩ & =0 \\\\ -5{t}_{1}-{t}_{2}+4{t}_{3} & =0 \\\\ {t}_{2} & =-5{t}_{1}+4{t}_{3}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},-5{t}_{1}+4{t}_{3},{t}_{3}⟩,\n$$\n\nwhere ${t}_{1},{t}_{3}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the third component of $v$ equals $0.$ So, we must set ${t}_{3}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{1}\\ne 0.$ For example, setting ${t}_{1}=1$, we get\n\n$$\nv=⟨1,\\,-5,\\,0⟩.\n$$\n\nTherefore, $\\frac{a}{b}=-\\frac{1}{5}.$"} {:db/id #edb/ref 17592186338830 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e4dafb7-c1e3-52bb-9be6-8c920a5e0c22" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186336620} {:answer/id #uuid "8adc6dd8-06c3-54d2-9922-36b4707070b7" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186337284} {:answer/id #uuid "9a72c942-01f6-5ae4-80c1-9074296dcd5a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186337434} {:answer/id #uuid "bac2e877-851a-58b5-bda5-b1f53f68e73a" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186337687} {:answer/id #uuid "f5b3af4d-d5d3-54b2-80fd-fb6b4c38bce6" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186338180}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186337284} :answer-field/id #uuid "f28575a2-8621-51a3-b18b-ae5aadfa4d66" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338700}] :question/id #uuid "31208d04-81a2-5a09-afcd-1cbba801d10f" :question/math-academy-id "q-70828" :question/problem "A nonzero vector $⟨0,\\,b,c⟩$ is parallel to the plane $r\\cdot ⟨-2,2,-4⟩=15.$ What is the value of $\\frac{b}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨-2,2,-4⟩=15$ of the plane, we get the normal vector $n=⟨-2,2,-4⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨-2,2,-4⟩ & =0 \\\\ -2{t}_{1}+2{t}_{2}-4{t}_{3} & =0 \\\\ 2{t}_{2} & =2{t}_{1}+4{t}_{3} \\\\ {t}_{2} & ={t}_{1}+2{t}_{3}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},\\,{t}_{1}+2{t}_{3},\\,{t}_{3}⟩,\n$$\n\nwhere ${t}_{1},{t}_{3}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the first component of $v$ equals $0.$ So, we must set ${t}_{1}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{3}\\ne 0.$ For example, setting ${t}_{3}=1$, we get\n\n$$\nv=⟨0,\\,2,\\,1⟩.\n$$\n\nTherefore, $\\frac{b}{c}=2.$"} {:db/id #edb/ref 17592186338831 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ad3af79-fcd3-5749-b0e5-9411379a50d2" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186336721} {:answer/id #uuid "886c099c-bd36-506a-9021-b550fe0b57c5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186337264} {:answer/id #uuid "926d8af8-a19c-5443-bbf7-6f269886e17b" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186337364} {:answer/id #uuid "d60f66f3-48fa-5ebf-837a-e090ca7d3d6a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186337896} {:answer/id #uuid "d99cfee8-de55-5ea6-8c2e-3385468433bb" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186337925}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186337896} :answer-field/id #uuid "7727c896-6f1b-5615-b00c-42ad7fd27f9f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338483}] :question/id #uuid "e0327785-b28b-5842-b652-0805899123b3" :question/math-academy-id "q-70830" :question/problem "A nonzero vector $⟨a,\\,b,\\,0⟩$ is parallel to the plane $r\\cdot ⟨-1,1,-3⟩=8.$ What is the value of $\\frac{a}{b}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨-1,1,-3⟩=8$ of the plane, we get the normal vector $n=⟨-1,1,-3⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨-1,1,-3⟩ & =0 \\\\ -{t}_{1}+{t}_{2}-3{t}_{3} & =0 \\\\ {t}_{2} & ={t}_{1}+3{t}_{3}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},{t}_{1}+3{t}_{3},{t}_{3}⟩,\n$$\n\nwhere ${t}_{1},{t}_{3}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the third component of $v$ equals $0.$ So, we must set ${t}_{3}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{1}\\ne 0.$ For example, setting ${t}_{1}=1$, we get\n\n$$\nv=⟨1,\\,1,\\,0⟩.\n$$\n\nTherefore, $\\frac{a}{b}=1.$"} {:db/id #edb/ref 17592186393029 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4fb71df-948c-5126-86b0-9d79cb4c0fee" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186393031} {:answer/id #uuid "75ed4713-5dc0-5929-8f1a-ae29368dccf9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186393032} {:answer/id #uuid "14d6c7a2-54c1-5ce2-9906-4d55cf87f498" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186393033} {:answer/id #uuid "32938842-cdd7-5118-b60e-0c5d24a27836" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186393034} {:answer/id #uuid "ea4da8ff-198b-50e0-8319-7a9af39b8918" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186393035}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186393032} :answer-field/id #uuid "b14d7746-5f36-5ef0-9936-be22c8877f39" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393030}] :question/id #uuid "ee04e6aa-94ba-5e6d-a904-4a34aac7a757" :question/math-academy-id "q-70827" :question/problem "A nonzero vector $⟨0,\\,b,\\,c⟩$ is parallel to the plane $r\\cdot ⟨1,2,-1⟩=7.$ What is the value of $\\frac{b}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨1,2,-1⟩=7$ of the plane, we get the normal vector $n=⟨1,2,-1⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨1,2,-1⟩ & =0 \\\\ {t}_{1}+2{t}_{2}-{t}_{3} & =0 \\\\ {t}_{3} & ={t}_{1}+2{t}_{2}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},\\,{t}_{2},\\,{t}_{1}+2{t}_{2}⟩,\n$$\n\nwhere ${t}_{1},{t}_{2}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the first component of $v$ equals $0.$ So, we must set ${t}_{1}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{2}\\ne 0.$ For example, setting ${t}_{2}=1$, we get\n\n$$\nv=⟨0,\\,1,\\,2⟩.\n$$\n\nTherefore, $\\frac{b}{c}=\\frac{1}{2}.$"} {:db/id #edb/ref 17592186420153 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b182a09-cc9d-51c4-95fe-e78790ecf72a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186420142} {:answer/id #uuid "36cb63bc-ae79-51e4-b5ab-3039c42340e0" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186420143} {:answer/id #uuid "4173b538-e381-5dd5-b0c5-10dc2eaa96c4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186420144} {:answer/id #uuid "502b671f-b1be-5d29-8f96-08571a87d173" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186420145} {:answer/id #uuid "72001519-6957-56f0-b511-f27a9ed3c85f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186420146}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186420143} :answer-field/id #uuid "f9a0d8dd-871f-5fc8-9699-7a78c5f80aac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420152}] :question/id #uuid "3fa29ff6-5ae4-5642-82fd-03b1645e810c" :question/math-academy-id "q-127921" :question/problem "A nonzero vector $⟨0,\\,b,\\,c⟩$ is parallel to the plane $r\\cdot ⟨5,-1,3⟩=27.$ What is the value of $\\frac{b}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨5,-1,3⟩=27$ of the plane, we get the normal vector $n=⟨5,-1,3⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨5,-1,3⟩ & =0 \\\\ 5{t}_{1}-{t}_{2}+3{t}_{3} & =0 \\\\ {t}_{2} & =5{t}_{1}+3{t}_{3}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},\\,5{t}_{1}+3{t}_{3},\\,{t}_{3}⟩,\n$$\n\nwhere ${t}_{1},{t}_{3}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the first component of $v$ equals $0.$ So, we must set ${t}_{1}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{3}\\ne 0.$ For example, setting ${t}_{3}=1$, we get\n\n$$\nv=⟨0,\\,3,\\,1⟩.\n$$\n\nTherefore, $\\frac{b}{c}=3.$"} {:db/id #edb/ref 17592186445224 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37d331a3-d216-56b1-b1e8-c1c659788885" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186445208} {:answer/id #uuid "b1bdd0cd-8af9-54f9-913d-1f9c797b10c9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186445213} {:answer/id #uuid "c7324eda-c77e-5439-bf52-4a39226f0238" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186445215} {:answer/id #uuid "c9e7ce1b-ea58-5c77-a5f2-354c10202f64" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186445216} {:answer/id #uuid "e17bf533-f3b3-5889-bc5d-63042f883173" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186445218}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186445215} :answer-field/id #uuid "df160bc6-de12-5b0e-ab4a-f86e448d27ab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186445222}] :question/id #uuid "685229d2-34f8-5173-a67b-785ec23ea6ca" :question/math-academy-id "q-127876" :question/problem "A nonzero vector $⟨a,\\,b,\\,0⟩$ is parallel to the plane $r\\cdot ⟨2,-1,3⟩=17.$ What is the value of $\\frac{a}{b}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨2,-1,3⟩=17$ of the plane, we get the normal vector $n=⟨2,-1,3⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨2,-1,3⟩ & =0 \\\\ 2{t}_{1}-{t}_{2}+3{t}_{3} & =0 \\\\ {t}_{2} & =2{t}_{1}+3{t}_{3}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},\\,2{t}_{1}+3{t}_{3},\\,{t}_{3}⟩,\n$$\n\nwhere ${t}_{1},{t}_{3}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the third component of $v$ equals $0.$ So, we must set ${t}_{3}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{1}\\ne 0.$ For example, setting ${t}_{1}=1$, we get\n\n$$\nv=⟨1,\\,2,\\,0⟩.\n$$\n\nTherefore, $\\frac{a}{b}=\\frac{1}{2}.$"}] :knowledge-point/title "Finding a Vector That Is Parallel To a Plane"} {:db/id #edb/ref 17592186119831 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119642 :question/id #uuid "43586a83-879c-5caf-9063-a8f4afbb8b4c" :question/math-academy-id "e-4935" :question/problem "Find an equation of the plane that passes through the point $Q(\\sqrt{2},0,-5)$ and is perpendicular to the line\n\n$$\n\\left\\{\\begin{aligned}x &=3 \\\\ y &=-1+\\sqrt{3}t \\\\ z &=5-t.\\end{aligned}\\right.\n$$" :question/worked-solution "Note that the position vector of $Q$ is $\\mathbf{q}=\\langle \\sqrt{2},0,-5 \\rangle.$ Converting the parametric equations of the line to vector form, we get\n![](images/89/89e1a065666c566dcd8a7648a0087045eadc0132c1933357f4b60a06103ffa0f.svg)\n\nThe direction vector of the line is $\\mathbf{v}=\\langle  0 , \\sqrt{3} , -1\\rangle,$ so a normal vector to the plane is \n\n$$\n\\mathbf{n}=\\mathbf{v}=\\langle  0 , \\sqrt{3} , -1 \\rangle.\n$$\n\nTherefore, the equation of the plane is given by\n\n$$\n\\begin{aligned}(r-q)\\cdot n & =0 \\\\ r\\cdot n-q\\cdot n & =0 \\\\ r\\cdot n & =q\\cdot n \\\\ r\\cdot ⟨0,\\sqrt{3},-1⟩ & =⟨\\sqrt{2},0,-5⟩\\cdot ⟨0,\\sqrt{3},-1⟩ \\\\ r\\cdot ⟨0,\\sqrt{3},-1⟩ & =5.\\end{aligned}\n$$"} :knowledge-point/id #uuid "45cdbb0d-2986-5c05-8d23-dce29363051b" :knowledge-point/questions [{:db/id #edb/ref 17592186120224 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a8f836e-b1bd-5929-a0d4-cc62e2406547" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨2,-3,5⟩=-11" :db/id #edb/ref 17592186420147} {:answer/id #uuid "8f5b6228-4151-5fb7-a8b8-4defb3112da4" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-2,0,3⟩=11" :db/id #edb/ref 17592186420148} {:answer/id #uuid "ab54b251-064b-57d4-8fc1-3a45c6f498e7" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨2,-3,5⟩=⟨-2,0,3⟩" :db/id #edb/ref 17592186420149} {:answer/id #uuid "b05ca4a9-4343-56a3-86ae-980793c8602f" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-2,0,3⟩=⟨2,-3,5⟩" :db/id #edb/ref 17592186420150} {:answer/id #uuid "f59eba3d-6e2f-504f-905a-a227d63c2c42" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨2,-3,5⟩=11" :db/id #edb/ref 17592186420151}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-2,0,3⟩=11" :db/id #edb/ref 17592186420148} :answer-field/id #uuid "b2947f04-3e78-507e-b09a-00ccebdf73ba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117505}] :question/id #uuid "ee828cf7-8b80-575c-a644-51d699464b23" :question/math-academy-id "q-33037" :question/problem "Find an equation of the plane that passes through the point $Q(2,-3,5)$ and is perpendicular to the line that goes through the points \n$A(3,2,-8)$ and $B(1,2,-5).$" :question/worked-solution "First, we note that the position vector of $Q$ is $q=⟨2,-3,5⟩.$\n\nSince the line  passes through the points $A(3,2,-8)$ and $B(1,2,-5)$, we can find a vector that is parallel to the line:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨1,2,-5⟩-⟨3,2,-8⟩ \\\\  & =⟨-2,0,3⟩\\end{aligned}\n$$\n\n \n\nSo, a normal vector to the plane is $n=⟨-2,0,3⟩.$\n\nTherefore, the equation of the plane is given by \n\n$$\n\\begin{aligned}(r-q)\\cdot n & =0 \\\\ r\\cdot n-q\\cdot n & =0 \\\\ r\\cdot n & =q\\cdot n \\\\ r\\cdot ⟨-2,0,3⟩ & =⟨2,-3,5⟩\\cdot ⟨-2,0,3⟩ \\\\ r\\cdot ⟨-2,0,3⟩ & =11.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186120247 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72c2e5ca-f263-54ef-924a-e167ca91f89b" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-2,2,0⟩=⟨-4,6,2⟩" :db/id #edb/ref 17592186363753} {:answer/id #uuid "32d8e4c3-ddfe-54ee-ae03-e8de00c5efb9" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-2,2,0⟩=20" :db/id #edb/ref 17592186363754} {:answer/id #uuid "730f759e-812a-532c-8ba9-65f2916ee485" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-4,6,2⟩=20" :db/id #edb/ref 17592186363755} {:answer/id #uuid "9471d411-f775-5f03-a79f-1eb639079ffa" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-4,6,2⟩=0" :db/id #edb/ref 17592186363756} {:answer/id #uuid "1f6058f7-7b71-5d3e-a88e-644aa57521b7" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-4,6,2⟩=⟨-2,2,0⟩" :db/id #edb/ref 17592186363757}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-4,6,2⟩=20" :db/id #edb/ref 17592186363755} :answer-field/id #uuid "12ab60fb-0ccd-54c4-b8b9-1cf65f373926" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186363752}] :question/id #uuid "8a0ae68a-8650-5549-af6c-052d2786d395" :question/math-academy-id "q-33316" :question/problem "Find an equation of the plane that passes through the point $Q(-2,2,0)$ and is perpendicular to the line \n\n$$\n\\left\\{\\begin{aligned}x &=3-4t \\\\ y &=1+6t \\\\ z &=-1+2t.\\end{aligned}\\right.\n$$" :question/worked-solution "Note that the position vector of $Q$ is $q=⟨-2,2,0⟩.$ Converting the parametric equations of the line to vector form, we get\n\n$$\n\\left\\{\\begin{aligned}x &=3-4t \\\\ y &=1+6t \\\\ z &=-1+2t\\end{aligned}\\right.\\,⟹\\,⟨x,y,z⟩=⟨3,1,-1⟩+t\\text{ }{{⟨-4,6,2⟩}_{⏟}}_{v}.\n$$\n\n \n\nThe direction vector of the line is $v=⟨-4,6,2⟩,$ so a normal vector to the plane is \n\n$$\nn=v=⟨-4,6,2⟩.\n$$\n\nTherefore, the equation of the plane is given by\n\n$$\n\\begin{aligned}(r-q)\\cdot n & =0 \\\\ r\\cdot n-q\\cdot n & =0 \\\\ r\\cdot n & =q\\cdot n \\\\ r\\cdot ⟨-4,6,2⟩ & =⟨-2,2,0⟩\\cdot ⟨-4,6,2⟩ \\\\ r\\cdot ⟨-4,6,2⟩ & =20.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262853 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aa825cb-f5f2-5941-b18f-a35a9e8ffaab" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-4,-4,3⟩=11" :db/id #edb/ref 17592186260107} {:answer/id #uuid "394ffd1f-3104-5495-902a-37954445a0c9" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-4,3,4⟩=12" :db/id #edb/ref 17592186260385} {:answer/id #uuid "56cda873-6a65-51e4-b130-2eb9c208d8a6" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨3,4,4⟩=23" :db/id #edb/ref 17592186260617} {:answer/id #uuid "ce2cec22-6b83-56cf-81ae-8596b434a0ff" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨4,-3,4⟩=11" :db/id #edb/ref 17592186261696} {:answer/id #uuid "e6b3d4ad-159b-554b-a0a1-ef2fb9a85ed2" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨3,-4,4⟩=23" :db/id #edb/ref 17592186261900}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨3,-4,4⟩=23" :db/id #edb/ref 17592186261900} :answer-field/id #uuid "7f4a93d8-207b-5307-acbb-b861f6a8320e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262337}] :question/id #uuid "9164c795-7f61-5d54-9538-2653e37cb486" :question/math-academy-id "q-127927" :question/problem "Find an equation of the plane that passes through the point $Q(1,-2,3)$ and is perpendicular to the line that goes through the points \n$A(4,1,-3)$ and $B(7,-3,1).$" :question/worked-solution "First, we note that the position vector of $Q$ is $q=⟨1,-2,3⟩.$\n\nSince the line  passes through the points $A(4,1,-3)$ and $B(7,-3,1)$, we can find a vector that is parallel to the line:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨7,-3,1⟩-⟨4,1,-3⟩ \\\\  & =⟨3,-4,4⟩\\end{aligned}\n$$\n\n \n\nSo, a normal vector to the plane is $n=⟨3,-4,4⟩.$\n\nTherefore, the equation of the plane is given by \n\n$$\n\\begin{aligned}(r-q)\\cdot n & =0 \\\\ r\\cdot n-q\\cdot n & =0 \\\\ r\\cdot n & =q\\cdot n \\\\ r\\cdot ⟨3,-4,4⟩ & =⟨1,-2,3⟩\\cdot ⟨3,-4,4⟩ \\\\ r\\cdot ⟨3,-4,4⟩ & =23.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0387b95b-ea4c-5624-9fdd-7d44aae31856" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨3,1,1⟩=12" :db/id #edb/ref 17592186259907} {:answer/id #uuid "ad85ebfc-775c-5bdb-a5e6-836a5963e43c" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨1,1,5⟩=9" :db/id #edb/ref 17592186261395} {:answer/id #uuid "b2a79415-12c6-5171-8ecf-e701971bbaad" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨1,3,1⟩=12" :db/id #edb/ref 17592186261452} {:answer/id #uuid "d9ba12b0-dcfe-5c43-b282-17a43fb1d275" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨5,1,1⟩=18" :db/id #edb/ref 17592186261796} {:answer/id #uuid "eb666347-2e39-5891-a53f-4830ffc6eb6f" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨1,5,1⟩=9" :db/id #edb/ref 17592186261942}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨5,1,1⟩=18" :db/id #edb/ref 17592186261796} :answer-field/id #uuid "207a2b37-6c4f-5b41-aa59-d8127027f268" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262177}] :question/id #uuid "57b46f7d-b75a-5f5c-87e6-c8948d671ea4" :question/math-academy-id "q-127936" :question/problem "Find an equation of the plane that passes through the point $P(3,-2,5)$ and is perpendicular to the line that goes through the points \n$A(-3,0,2)$ and $B(2,1,3).$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨3,-2,5⟩.$\n\nSince the line  passes through the points $A(-3,0,2)$ and $B(2,1,3)$ we can find a vector parallel to the line:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨2,1,3⟩-⟨-3,0,2⟩ \\\\  & =⟨5,1,1⟩.\\end{aligned}\n$$\n\n \n\nSo, a normal vector to the plane is $n=⟨5,1,1⟩.$\n\nTherefore, the equation of the plane is given by\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨5,1,1⟩ & =⟨3,-2,5⟩\\cdot ⟨5,1,1⟩ \\\\ r\\cdot ⟨5,1,1⟩ & =18.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a6d49af-f4b3-58b7-98b0-926d7d2ec1bb" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨1,-4,3⟩=15" :db/id #edb/ref 17592186259966} {:answer/id #uuid "bfef5be5-9f0c-5938-9df5-2b2093f08bac" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-3,4,1⟩=9" :db/id #edb/ref 17592186261571} {:answer/id #uuid "c1b1b7f5-3316-5749-a268-d9545bd6066b" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-4,3,1⟩=7" :db/id #edb/ref 17592186261585} {:answer/id #uuid "cbe23397-9a20-5f8a-922d-81c869029405" :answer/type {:db/ident :answer.typ