b/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186291640}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186291640} :answer-field/id #uuid "e469f8ff-a383-5164-893f-961b9fa40f93" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292448}] :question/id #uuid "9fed3a53-838e-5362-83b9-fbd6582bdbcb" :question/math-academy-id "q-275548" :question/problem "Find $AB,$ if $A=\\begin{bmatrix}1 \\\\ 2 \\\\ -2\\end{bmatrix}$\nand \n$B=\\begin{bmatrix}1 & -2\\end{bmatrix}.$\n\n|  |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n| $AB=\\,\\,$ |  | {{field-3}} | {{field-4}} |  |\n|  |  | {{field-5}} | {{field-6}} |  |" :question/worked-solution "Here, $A$ is $3\\times 1$ matrix and $B$ is a $1\\times 2$ matrix.  \n\nThere is $1$ column in matrix $A$ and $1$ row in matrix $B$, so the product is well defined:\n\n$$\n{A}_{3\\times \\boxed{\\text{1}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{1}}\\times 2}={AB}_{3\\times 2}\n$$\n\nComputing the product, we have\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}1 \\\\ 2 \\\\ -2\\end{bmatrix}\\begin{bmatrix}1 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1\\cdot 1 & 1\\cdot (-2) \\\\ 2\\cdot 1 & 2\\cdot (-2) \\\\ (-2)\\cdot 1 & (-2)\\cdot (-2)\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -2 \\\\ 2 & -4 \\\\ -2 & 4\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299688 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90d5156d-1d4d-58d0-b3db-f06dc3110af2" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186298182}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186298182} :answer-field/id #uuid "60ee3141-5ab6-5a49-864a-59e094c19044" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298967} {:answer-field/choices [{:answer/id #uuid "cdcbaa46-9cac-5426-ab3d-927a136593d5" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186298450}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186298450} :answer-field/id #uuid "777110cd-e150-534d-a2cc-8ff44e91e456" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299040} {:answer-field/choices [{:answer/id #uuid "11781e0e-cbc8-5673-b303-fddb5dd204cb" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186297630}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186297630} :answer-field/id #uuid "eb00e7e1-8810-52ee-a695-867da382934b" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299431} {:answer-field/choices [{:answer/id #uuid "6bcc1e4f-a4bf-5a59-8f24-9a6a1ab50a16" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186298016}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186298016} :answer-field/id #uuid "eb0feda7-eeae-5b52-8b25-7199991e023a" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299432}] :question/id #uuid "1050bc77-12b5-5216-85bc-cb476e852617" :question/math-academy-id "q-318484" :question/problem "If\n$A=\\begin{bmatrix}5 \\\\ -2\\end{bmatrix}$\nand\n$B=\\begin{bmatrix}1 & -3\\end{bmatrix},$\nfind $AB.$\n\n| $AB=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "Here, $A$ is a $2\\times 1$ matrix and $B$ is a $1\\times 2$ matrix. \n\nThere is $1$ column in $A$ and $1$ row in $B,$ so $A$ and $B$ are conformable for multiplication: \n\n$$\n{A}_{2\\times \\boxed{\\text{1}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{1}}\\times 2}={AB}_{2\\times 2}\n$$\n\nLet's compute $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}5 \\\\ -2\\end{bmatrix}\\begin{bmatrix}1 & -3\\end{bmatrix}=\\begin{bmatrix}5 & ∗ \\\\ ∗ & ∗\\end{bmatrix}, &  & \\,5=5\\cdot 1 \\\\  & \\begin{bmatrix}5 \\\\ -2\\end{bmatrix}\\begin{bmatrix}1 & -3\\end{bmatrix}=\\begin{bmatrix}5 & -15 \\\\ ∗ & ∗\\end{bmatrix}, &  & \\,-15=5\\cdot (-3) \\\\  & \\begin{bmatrix}5 \\\\ -2\\end{bmatrix}\\begin{bmatrix}1 & -3\\end{bmatrix}=\\begin{bmatrix}5 & -15 \\\\ -2 & ∗\\end{bmatrix}, &  & \\,-2=-2\\cdot 1 \\\\  & \\begin{bmatrix}5 \\\\ -2\\end{bmatrix}\\begin{bmatrix}1 & -3\\end{bmatrix}=\\begin{bmatrix}5 & -15 \\\\ -2 & 6\\end{bmatrix}, &  & \\,6=-2\\cdot (-3)\\end{aligned}\n$$\n\nTherefore, \n$AB=\\begin{bmatrix}5 & -15 \\\\ -2 & 6\\end{bmatrix}.$"} {:db/id #edb/ref 17592186299689 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fcdd0ac-c4d8-5dd7-8ce4-29a07e65c610" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186298029}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186298029} :answer-field/id #uuid "3d3ccc6b-89ba-5ba8-8a64-d1dd15121053" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298846} {:answer-field/choices [{:answer/id #uuid "874c93ff-44ad-5c2e-8a4f-77019c4f2b86" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186298140}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186298140} :answer-field/id #uuid "4de9dcd3-c548-55ae-96de-6e52cab045c0" :answer-field/key "field-6" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298897} {:answer-field/choices [{:answer/id #uuid "2ae40015-4fcb-586e-8a84-7d4f6a259e22" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186297731}] :answer-fiel