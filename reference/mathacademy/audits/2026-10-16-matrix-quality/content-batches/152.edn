x}7 & -3 \\\\ 6 & -2\\end{bmatrix}+\\begin{bmatrix}9 & -3 \\\\ 6 & 0\\end{bmatrix}+\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}7+9+2 & -3+(-3)+0 \\\\ 6+6+0 & -2+0+2\\end{bmatrix} \\\\  & =\\begin{bmatrix}18 & -6 \\\\ 12 & 0\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295082 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1edaad23-38fa-5ade-914e-a5609242b3e6" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186293058}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186293058} :answer-field/id #uuid "37055139-282b-539d-b483-a56f37aed491" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294119} {:answer-field/choices [{:answer/id #uuid "803d37e6-0041-5d63-9b2b-b08db1050ece" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186293448}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186293448} :answer-field/id #uuid "4e87e3ce-d69f-57ca-803b-5cbeb952b948" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294206} {:answer-field/choices [{:answer/id #uuid "12f694cf-ddd8-57ae-b9bc-3be3ea05e42e" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186293010}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186293010} :answer-field/id #uuid "55dfb9b6-9924-5718-a9a4-adbd178e8398" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294235} {:answer-field/choices [{:answer/id #uuid "9cd3289b-a0e9-545c-a1e9-66bcc0d54ec1" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186293551}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answ