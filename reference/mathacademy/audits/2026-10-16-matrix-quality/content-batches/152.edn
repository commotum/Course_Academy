ype {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298718} {:answer-field/choices [{:answer/id #uuid "3fa46adc-8027-5641-a584-e1425ce04dd6" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186297804}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186297804} :answer-field/id #uuid "8e119f09-47a5-5dec-ac9c-c82dedbeca32" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299110} {:answer-field/choices [{:answer/id #uuid "88726dca-a737-55cf-95d1-988140183f17" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186298144}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186298144} :answer-field/id #uuid "a1fce966-93a7-54f8-95d2-3d3409a72b26" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299177} {:answer-field/choices [{:answer/id #uuid "b0321b13-a295-53cb-a371-3e8e5bcf85c0" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186298321}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186298321} :answer-field/id #uuid "a70b6697-328c-5680-9885-0831c3f71d33" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299202} {:answer-field/choices [{:answer/id #uuid "6d65f162-8e57-5988-ae37-7fc0a3a81a62" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298023}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298023} :answer-field/id #uuid "e077f806-8c76-58d7-8656-a1a6651077bf" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299399}] :question/id #uuid "9fa531ce-0734-5931-947d-bd011cbc557d" :question/math-academy-id "q-317844" :question/problem "Determine $AB$ given that \n$A=\\begin{bmatrix}2 & 1 \\\\ 0 & 3 \\\\ -1 & 4 \\\\ 5 & 2\\end{bmatrix}$\nand\n$B=\\begin{bmatrix}1 & -2 \\\\ 0 & 3\\end{bmatrix}.$\n\n| $AB=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | $9$ |  |  |\n|  | {{field-4}} | $14$ |  |  |\n|  | $5$ | {{field-5}} |  |  |" :question/worked-solution "Here, $A$ is a $4\\times 2$ matrix and $B$ is a $2\\times 2$ matrix. \n\nThere are $2$ columns in $A$ and $2$ rows in $B,$ so $A$ and $B$ are conformable for multiplication:\n\n$$\n{A}_{4\\times \\boxed{\\text{2}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{2}}\\times 2}={AB}_{4\\times 2}\n$$\n\nLet's compute the unknown elements of $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}2 & 1 \\\\ 0 & 3 \\\\ -1 & 4 \\\\ 5 & 2\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ 0 & 3\\end{bmatrix}=\\begin{bmatrix}2 & ∗ \\\\ ∗ & 9 \\\\ ∗ & 14 \\\\ 5 & ∗\\end{bmatrix}, &  & \\,2=2\\cdot 1+1\\cdot 0 \\\\  & \\begin{bmatrix}2 & 1 \\\\ 0 & 3 \\\\ -1 & 4 \\\\ 5 & 2\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ 0 & 3\\end{bmatrix}=\\begin{bmatrix}2 & -1 \\\\ ∗ & 9 \\\\ ∗ & 14 \\\\ 5 & ∗\\end{bmatrix}, &  & \\,-1=2\\cdot (-2)+1\\cdot 3 \\\\  & \\begin{bmatrix}2 & 1 \\\\ 0 & 3 \\\\ -1 & 4 \\\\ 5 & 2\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ 0 & 3\\end{bmatrix}=\\begin{bmatrix}2 & -1 \\\\ 0 & 9 \\\\ ∗ & 14 \\\\ 5 & ∗\\end{bmatrix}, &  & \\,0=0\\cdot 1+3\\cdot 0 \\\\  & \\begin{bmatrix}2 & 1 \\\\ 0 & 3 \\\\ -1 & 4 \\\\ 5 & 2\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ 0 & 3\\end{bmatrix}=\\begin{bmatrix}2 & -1 \\\\ 0 & 9 \\\\ -1 & 14 \\\\ 5 & ∗\\end{bmatrix}, &  & \\,-1=(-1)\\cdot 1+4\\cdot 0 \\\\  & \\begin{bmatrix}2 & 1 \\\\ 0 & 3 \\\\ -1 & 4 \\\\ 5 & 2\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ 0 & 3\\end{bmatrix}=\\begin{bmatrix}2 & -1 \\\\ 0 & 9 \\\\ -1 & 14 \\\\ 5 & -4\\end{bmatrix}, &  & \\,-4=5\\cdot (-2)+2\\cdot 3\\end{aligned}\n$$\n\nTherefore, \n$AB=\\begin{bmatrix}2 & -1 \\\\ 0 & 9 \\\\ -1 & 14 \\\\ 5 & -4\\end{bmatrix}.$"} {:db/id #edb/ref 17592186299651 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06632315-20e1-5a40-b99b-5b1bbb8afa31" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186297582}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186297582} :answer-field/id #uuid "7f84dc72-92a1-5353-b591-bdf85d6a4d27" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299069} {:answer-field/choices [{:answer/id #uuid "70c0bb1a-a11d-5b2a-bcd8-9f28cebb7e6f" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186298036}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186298036} :answer-field/id #uuid "c6007ff8-9e9f-5fb3-89f5-bb5c4da4bf33" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299300}] :question/id #uuid "d6b8e49d-bc16-5e49-870a-d27907495843" :question/math-academy-id "q-317846" :question/problem "Determine $AB$ given that \n$A=\\begin{bmatrix}1 & 2 & -1 \\\\ 0 & 3 & 4\\end{bmatrix}$\nand\n$B=\\begin{bmatrix}2 & 1 \\\\ -1 & 0 \\\\ 3 & -2\\end{bmatrix}.$\n\n| $AB=\\,\\,$ |  | {{field-1}} | $3$ |  |\n| --- | --- | --- | --- | --- |\n|  | $9$ | {{field-2}} |  |  |" :question/worked-solution "Here, $A$ is a $2\\times 3$ matrix and $B$ is a $3\\times 2$ matrix. \n\nThere are $3$ columns in $A$ and $3$ rows in $B,$ so $A$ and $B$ are conformable for multiplication:\n\n$$\n{A}_{2\\times \\boxed{\\text{3}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{3}}\\times 2}={AB}_{2\\times 2}\n$$\n\nLet's compute the unknown elements of $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}1 & 2 & -1 \\\\ 0 & 3 & 4\\end{bmatrix}\\begin{bmatrix}2 & 1 \\\\ -1 & 0 \\\\ 3 & -2\\end{bmatrix}=\\begin{bmatrix}-3 & ∗ \\\\ ∗ & -8\\end{bmatrix}, &  & \\,-3=1\\cdot 2+2\\cdot (-1)+(-1)\\cdot 3 \\\\  & \\begin{bmatrix}1 & 2 & -1 \\\\ 0 & 3 & 4\\end{bmatrix}\\begin{bmatrix}2 & 1 \\\\ -1 & 0 \\\\ 3 & -2\\end{bmatrix}=\\begin{bmatrix}-3 & 3 \\\\ 9 & -8\\end{bmatrix}, &  & \\,-8=0\\cdot 1+3\\cdot 0+4\\cdot (-2)\\end{aligned}\n$$\n\nTherefore,\n\n$$\nAB=\\begin{bmatrix}-3 & 3 \\\\ 9 & -8\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186299652 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "280013db-e870-5183-9372-d816ad98f224" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186297723}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186297723} :answer-field/id #uuid "33eaef6a-e5d9-5210-b63a-9e30983de20d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298815} {:answer-field/choices [{:answer/id #uuid "75360412-a790-5f78-ba8d-9d3583d9e3ec" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186298060}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186298060} :answer-field/id #uuid "4497312c-b639-5838-b4a9-f27d6e46fda8" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298871}] :question/id #uuid "4dabe113-4cf7-5192-92c8-d6891215d7d9" :question/math-academy-id "q-317847" :question/problem "Determine $AB$ given that \n$A=\\begin{bmatrix}2 & -1 & 0 \\\\ 4 & 3 & 1\\end{bmatrix}$\nand\n$B=\\begin{bmatrix}1 & 2 \\\\ -3 & 0 \\\\ 5 & -1\\end{bmatrix}.$\n\n| $AB=\\,\\,$ |  | {{field-1}} | $4$ |  |\n| --- | --- | --- | --- | --- |\n|  | $0$ | {{field-2}} |  |  |" :question/worked-solution "Here, $A$ is a $2\\times 3$ matrix and $B$ is a $3\\times 2$ matrix. \n\nThere are $3$ columns in $A$ and $3$ rows in $B,$ so $A$ and $B$ are conformable for multiplication:\n\n$$\n{A}_{2\\times \\boxed{\\text{3}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{3}}\\times 2}={AB}_{2\\times 2}\n$$\n\nLet's compute the unknown elements of $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}2 & -1 & 0 \\\\ 4 & 3 & 1\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ -3 & 0 \\\\ 5 & -1\\end{bmatrix}=\\begin{bmatrix}5 & 4 \\\\ 0 & ∗\\end{bmatrix}, &  & \\,5=2\\cdot 1+(-1)\\cdot (-3)+0\\cdot 5 \\\\  & \\begin{bmatrix}2 & -1 & 0 \\\\ 4 & 3 & 1\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ -3 & 0 \\\\ 5 & -1\\end{bmatrix}=\\begin{bmatrix}5 & 4 \\\\ 0 & 7\\end{bmatrix}, &  & \\,7=4\\cdot 2+3\\cdot 0+1\\cdot (-1)\\end{aligned}\n$$\n\nTherefore,\n\n$$\nAB=\\begin{bmatrix}5 & 4 \\\\ 0 & 7\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186299653 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40db654b-b0b0-5e57-99bb-9ec1e8b2cc13" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186297813}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186297813} :answer-field/id #uuid "4541560b-538b-5f05-b59c-8a9bf0f5a2d9" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298874} {:answer-field/choices [{:answer/id #uuid "475c78d9-adc8-54df-a099-d10b7fda3096" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186297844}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186297844} :answer-field/id #uuid "50d12860-4dc8-5d98-b731-8fe82a2cacc7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298910}] :question/id #uuid "630b6f29-5fc9-5ea7-9ec7-b34bacfad40e" :question/math-academy-id "q-317848" :question/problem "Determine $AB$ given that \n$A=\\begin{bmatrix}1 & 0 & -2 & 3 \\\\ 4 & 1 & 0 & -1\\end{bmatrix}$\nand\n$B=\\begin{bmatrix}2 & -1 \\\\ 1 & 3 \\\\ 0 & 4 \\\\ -2 & 1\\end{bmatrix}.$\n\n| $AB=\\,\\,$ |  | {{field-1}} | $-6$ |  |\n| --- | --- | --- | --- | --- |\n|  | $11$ | {{field-2}} |  |  |" :question/worked-solution "Here, $A$ is a $2\\times 4$ matrix and $B$ is a $4\\times 2$ matrix. \n\nThere are $4$ columns in $A$ and $4$ rows in $B,$ so $A$ and $B$ are conformable for multiplication:\n\n$$\n{A}_{2\\times \\boxed{\\text{4}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{4}}\\times 2}={AB}_{2\\times 2}\n$$\n\nLet's compute the unknown elements of $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}1 & 0 & -2 & 3 \\\\ 4 & 1 & 0 & -1\\end{bmatrix}\\begin{bmatrix}2 & -1 \\\\ 1 & 3 \\\\ 0 & 4 \\\\ -2 & 1\\end{bmatrix}=\\begin{bmatrix}-4 & -6 \\\\ 11 & ∗\\end{bmatrix}, &  & \\,-4=1\\cdot 2+0\\cdot 1+(-2)\\cdot 0+3\\cdot (-2) \\\\  & \\begin{bmatrix}1 & 0 & -2 & 3 \\\\ 4 & 1 & 0 & -1\\end{bmatrix}\\begin{bmatrix}2 & -1 \\\\ 1 & 3 \\\\ 0 & 4 \\\\ -2 & 1\\end{bmatrix}=\\begin{bmatrix}-4 & -6 \\\\ 11 & -2\\end{bmatrix}, &  & \\,-2=4\\cdot (-1)+1\\cdot 3+0\\cdot 4+(-1)\\cdot 1\\end{aligned}\n$$\n\nTherefore,\n\n$$\nAB=\\begin{bmatrix}-4 & -6 \\\\ 11 & -2\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186338850 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a636472-3eda-542f-b7c3-23ae232bc2c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 14\\end{bmatrix}" :db/id #edb/ref 17592186336582} {:answer/id #uuid "b4de6dcb-4fe1-5185-b370-367b3c5e23aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}10 & -1\\end{bmatrix}" :db/id #edb/ref 17592186337637} {:answer/id #uuid "de21dbdb-0d9a-5740-aec5-151cfe330af1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & -7\\end{bmatrix}" :db/id #edb/ref 17592186337964} {:answer/id #uuid "e685a16c-8e3b-5c1a-b2cb-d9f49b5dd990" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & -14\\end{bmatrix}" :db/id #edb/ref 17592186338044} {:answer/id #uuid "f3f6c67a-5a58-56b5-8c25-9be2881adeb5" :answer/type