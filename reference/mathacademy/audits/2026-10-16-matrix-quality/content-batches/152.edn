\\end{bmatrix} & =\\begin{bmatrix}4\\cdot 1 & 4\\cdot 0 & 4\\cdot 4 \\\\ 2\\cdot 1 & 2\\cdot 0 & 2\\cdot 4 \\\\ 1\\cdot 1 & 1\\cdot 0 & 1\\cdot 4 \\\\ 1\\cdot 1 & 1\\cdot 0 & 1\\cdot 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 0 & 16 \\\\ 2 & 0 & 8 \\\\ 1 & 0 & 4 \\\\ 1 & 0 & 4\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1297b425-ab85-5bba-90d9-0aa321868ad7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}24\\end{bmatrix}" :db/id #edb/ref 17592186263175} {:answer/id #uuid "3c0c371e-e1b3-52d8-84c6-a9a17f03d267" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}12 & -15 \\\\ -16 & 20 \\\\ 8 & -10\\end{bmatrix}" :db/id #edb/ref 17592186263534} {:answer/id #uuid "b6e8ab17-e45c-523a-a19c-a71e31ef33d7" :answer/type {:db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186264584} {:answer/id #uuid "c36d4eae-a73f-53be-a310-030402b0ab31" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1\\end{bmatrix}" :db/id #edb/ref 17592186264705} {:answer/id #uuid "d6eeee6e-2309-557d-bba3-b9d1577e7b86" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}12 & -15 \\\\ 8 & -10\\end{bmatrix}" :db/id #edb/ref 17592186264871}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186264584} :answer-field/id #uuid "cc268ea8-08d4-59b5-9560-41a3fd652f6f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265607}] :question/id #uuid "60c63572-fb04-5890-b3cf-3b16c8ce9cd7" :question/math-academy-id "q-130230" :question/problem "Find $ST$, if \n$S=\\begin{bmatrix}3 \\\\ -4 \\\\ 2\\end{bmatrix}$\nand \n$T=\\begin{bmatrix}4 \\\\ -3\\end{bmatrix}.$" :question/worked-solution "Here, $S$ is $3\\times 1$ matrix and $T$ is a $2\\times 1$ matrix. \n\nThere is $1$ column in $S$ and $2$ rows in $T$, so the product is undefined:\n\n$$\n{S}_{3\\times 1}{\\times }_{\\ne }{T}_{2\\times 1}=\\text{undefined}\n$$"} {:db/id #edb/ref 17592186292865 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cd20551-e511-5385-ad3b-9f36caad9c32" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186291027}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186291027} :answer-field/id #uuid "14870852-5dba-5438-b80f-0294962b94c4" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291808} {:answer-field/choices [{:answer/id #uuid "99eb7f75-7610-5e51-a8a8-ea2f0aa74805" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186291299}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186291299} :answer-field/id #uuid "1e8457af-c14e-5585-bda0-1873665d0316" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291849} {:answer-field/choices [{:answer/id #uuid "a08af78f-1333-5b89-bfe0-706c792d2caa" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186291330}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186291330} :answer-field/id #uuid "875d3970-b055-5c12-a79c-0f111817cb83" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292153} {:answer-field/choices [{:answer/id #uuid "36adad61-e1c4-5d23-8fcb-8c6eb215c8d1" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186290856}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186290856} :answer-field/id #uuid "c1f3e50b-9242-52ef-956e-9a4abeae199b" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292333}] :question/id #uuid "f1f60738-9f75-548f-8757-47743135ac46" :question/math-academy-id "q-275545" :question/problem "If\n$A=\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}$\nand\n$B=\\begin{bmatrix}-2 & 3\\end{bmatrix},$\nfind $AB.$\n\n| $AB=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "Here, $A$ is a $2\\times 1$ matrix and $B$ is a $1\\times 2$ matrix. \n\nThere is $1$ column in $A$ and $1$ row in $B,$ so $A$ and $B$ are conformable for multiplication: \n\n$$\n{A}_{2\\times \\boxed{\\text{1}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{1}}\\times 2}={AB}_{2\\times 2}\n$$\n\nLet's compute $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}2 \\\\ -1\\end{bmatrix}\\begin{bmatrix}-2 & 3\\end{bmatrix}=\\begin{bmatrix}-4 & ∗ \\\\ ∗ & ∗\\end{bmatrix}, &  & \\,-4=2\\cdot -2 \\\\  & \\begin{bmatrix}2 \\\\ -1\\end{bmatrix}\\begin{bmatrix}-2 & 3\\end{bmatrix}=\\begin{bmatrix}-4 & 6 \\\\ ∗ & ∗\\end{bmatrix}, &  & \\,6=2\\cdot 3 \\\\  & \\begin{bmatrix}2 \\\\ -1\\end{bmatrix}\\begin{bmatrix}-2 & 3\\end{bmatrix}=\\begin{bmatrix}-4 & 6 \\\\ 2 & ∗\\end{bmatrix}, &  & \\,2=-1\\cdot -2 \\\\  & \\begin{bmatrix}2 \\\\ -1\\end{bmatrix}\\begin{bmatrix}-2 & 3\\end{bmatrix}=\\begin{bmatrix}-4 & 6 \\\\ 2 & -3\\end{bmatrix}, &  & \\,-3=-1\\cdot 3\\end{aligned}\n$$\n\nTherefore, \n$AB=\\begin{bmatrix}-4 & 6 \\\\ 2 & -3\\end{bmatrix}.$"} {:db/id #edb/ref 17592186292867 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ca215ee-0623-587b-9023-3636cc2853da" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186290882}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186290882} :answer-field/id #uuid "5bc062b7-2d6b-5f91-84df-fab4dc97bf7f" :answer-field/key "field-6" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb