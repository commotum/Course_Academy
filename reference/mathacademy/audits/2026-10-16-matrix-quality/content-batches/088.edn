/text} :answer/value "true" :db/id #edb/ref 17592186450601} :answer-field/id #uuid "4edeacdc-e033-5790-be2d-7d85e4729f99" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451254} {:answer-field/choices [{:answer/id #uuid "58668fbd-bb78-5c00-9a1d-8a7d75b7e60d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450602} {:answer/id #uuid "e3d6d4d0-1f79-5205-af00-ebe990fad527" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450603}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450603} :answer-field/id #uuid "dc9782cf-b2f2-54f3-8f50-7e6a03793938" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451255} {:answer-field/choices [{:answer/id #uuid "40bfaa4a-5a0a-58da-a864-f7887eb901d7" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450604} {:answer/id #uuid "834cbe2c-64aa-52c2-adae-2d8273e27d83" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450605}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450605} :answer-field/id #uuid "ec37b2c3-76d5-5c6f-b7f5-1d6ee3b324e5" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451256}] :question/id #uuid "8e6f3463-c123-5a14-aa68-90e5211244ca" :question/math-academy-id "q-38905" :question/problem "Which of the following statements are true given that $T:{R}^{6}\\to {R}^{6}$ is a linear transformation whose standard matrix is $T,$ and $T$ is a bijection?\n\nSelect all that apply.\n\n- **I.** $\\text{Ker}(T)={0}$\n- **II.** $\\text{Im}(T)={R}^{6}$\n- **III.** $\\text{rank}(T)=6$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{6}$ into ${R}^{6},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{6} \\\\  & \\text{rank}(T)=6 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since $T$ is a bijection, the invertible matrix theorem implies that $\\text{Ker}(T)={0}.$\n\n- Statement II is true. Since $T$ is a bijection, the invertible matrix theorem implies that $\\text{Im}(T)={R}^{6}.$\n\n- Statement III is true. Since $T$ is a bijection, the invertible matrix theorem implies that $\\text{rank}(T)=6.$\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186326728 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f3b6b69e-fdda-5b48-8cbe-b6154cd7c5d0" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450606} {:answer/id #uuid "97c3efcd-f3c2-540f-afcf-4d2de2e5f841" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450607}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450607} :answer-field/id #uuid "53da20ae-ae94-56fd-81c5-8688aef36c20" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451257} {:answer-field/choices [{:answer/id #uuid "bfca9365-98df-5eb7-95b1-2fb60431dc72" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450608} {:answer/id #uuid "6fac619f-5615-571c-9063-072979a2d254" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450609}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450608} :answer-field/id #uuid "993a94ac-7b36-59ae-a4b9-f0f0c7e4df6e" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451258} {:answer-field/choices [{:answer/id #uuid "f0e4ee71-9c86-5467-baba-02fbccd28493" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450610} {:answer/id #uuid "d04c4a7d-4c1f-51ad-98ba-4f0eef654db3" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450611}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450611} :answer-field/id #uuid "747ffb98-bf8f-5e74-a1a2-d5a8752eab30" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451259}] :question/id #uuid "d76ba203-8385-5ab0-a588-ad7d93b64899" :question/math-academy-id "q-38907" :question/problem "Which of the following statements are true given that $T:{R}^{5}\\to {R}^{5}$ is a linear transformation whose standard matrix is $T,$ and ${{v}_{1},{v}_{2},{v}_{3}}$ is a basis of $\\text{Col}(T)?$\n\nSelect all that apply.\n\n- **I.** $\\text{rank}(T)=3$\n- **II.** $T$ is invertible\n- **III.** $\\text{nullity}(T)>0$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{5}$ into ${R}^{5},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{5} \\\\  & \\text{rank}(T)=5 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since ${{v}_{1},{v}_{2},{v}_{3}}$ is a basis of $\\text{Col}(T)$ we must have that $\\text{rank}(T)=3.$\n\n- Statement II is false. According to the invertible matrix theorem, since $\\text{rank}(T)\\ne 5,$ the transformation $T$ and the matrix $T$ are not invertible.\n\n- Statement III is true. Since $T$ is not invertible, the invertible matrix theorem implies that $\\text{nullity}(T)\\ne 0.$ In turn, this means that $\\text{nullity}(T)>0.$\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186363238 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3443de64-0676-5770-92c8-866233b3cf8a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451329} {:answer/id #uuid "901fe7d0-00db-5d2b-bbbe-46afcbf47bf0" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451330}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451329} :answer-field/id #uuid "92a67864-fc33-5ecf-8c84-7b60097bcbae" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452512} {:answer-field/choices [{:answer/id #uuid "86a924bc-04c3-5242-9b40-d555e76f1a43" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451331} {:answer/id #uuid "7007492f-f2e7-51ca-a49a-711d1d61f5c6" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451332}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451331} :answer-field/id #uuid "6a1eb8ec-220b-56c6-9fb0-7009727726eb" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452513} {:answer-field/choices [{:answer/id #uuid "c634fe05-9622-5bb0-8a7a-383e16e613d5" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451333} {:answer/id #uuid "298354bf-6e73-5d58-bebe-1e6824b6781d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451334}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451334} :answer-field/id #uuid "51cb5c24-3e00-5e7d-af9c-2caa5063b2cd" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452514}] :question/id #uuid "c7c2a831-facf-5fcc-90d0-c92cd81e88a5" :question/math-academy-id "q-141483" :question/problem "Which of the following statements are true given that $T:{R}^{6}\\to {R}^{6}$ is a linear transformation whose standard matrix is $T,$ and ${{v}_{1}}$ is a basis of $\\text{Ker}(T)?$\n\nSelect all that apply.\n\n- **I.** $\\text{rank}(T)=6$\n- **II.** $T$ is a bijection\n- **III.** $\\text{nullity}(T)=1$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{6}$ into ${R}^{6},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{6} \\\\  & \\text{rank}(T)=6 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since ${{v}_{1}}$ is a basis of $\\text{Ker}(T),$ we must have that $\\text{nullity}(T)=1$ and by the invertible matrix theorem, $T$ is not invertible. According to the invertible matrix theorem, since $T$ is not invertible, $\\text{rank}(T)\\ne 6.$\n\n- Statement II is false. According to the invertible matrix theorem, since $\\text{rank}(T)\\ne 6,$ the transformation $T$ is not a bijection.\n\n- Statement III is true. Since ${{v}_{1}}$ is a basis of $\\text{Ker}(T),$ we must have that $\\text{nullity}(T)=\\text{dim(Ker}(T))=1.$\n\nTherefore, the correct answer is \"III only.\""} {:db/id #edb/ref 17592186417703 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5a8fd7b-d587-5f84-abef-00aeb093eb8f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453892} {:answer/id #uuid "a3c74f36-a3a0-589c-a45b-af2f83dc7942" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453893}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453892} :answer-field/id #uuid "88425be4-23e4-530d-894d-7ba2ee67cacc" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454696} {:answer-field/choices [{:answer/id #uuid "42b1c9af-14b9-5566-a390-e0cfcfb93713" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453894} {:answer/id #uuid "56beb87c-fb76-5782-843d-1bb2ef34ea37" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453895}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453895} :answer-field/id #uuid "6eccd02e-cd48-5da5-a4d4-40a643e437ff" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454697} {:answer-field/choices [{:answer/id #uuid "62cc4c4f-6b01-5029-937b-d1096d770d25" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453896} {:answer/id #uuid "998a225c-9aad-55b1-9522-e1b176e1886c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453897}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453896} :answer-field/id #uuid "7b61e149-64e1-57db-98c8-d0a11bc647eb" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454698}] :question/id #uuid "0464e7a7-ce22-55cd-90ec-4b6a71a12079" :question/math-academy-id "q-38893" :question/problem "Which of the following statements are true given that $T:{R}^{5}\\to {R}^{5}$ is a linear transformation whose standard matrix is $T,$ and $T(x)=v$ has no solution?\n\nSelect all that apply.\n\n- **I.** $T$ is invertible\n- **II.** $\\text{Ker}(T)\\ne {0}$\n- **III.** $\\text{nullity}(T)=0$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{5}$ into ${R}^{5},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{5} \\\\  & \\text{rank}(T)=5 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since $T(x)=v$ has no solution, we have that $v\\notin \\text{Im}(T),$ hence $\\text{Im}(T)\\ne {R}^{5}.$ According to the invertible matrix theorem, since $\\text{Im}(T)\\ne {R}^{5},$ the transformation $T$ and the matrix $T$ are not invertible.\n\n- Statement II is true. Since $T$ is not invertible, the invertible matrix theorem implies that  $\\text{Ker}(T)\\ne {0}.$\n\n- Statement III is false. Since $T$ is not invertible, the invertible matrix theorem implies that $\\text{nullity}(T)\\ne 0.$\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186459245 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3200c704-914e-5a7c-a389-b3b6182e8ac4" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186458724} {:answer/id #uuid "37e3e013-4933-5b45-8470-5d76dafc6885" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186458736} {:answer/id #uuid "923f09df-dc7e-5a40-ae18-a729158db7a1" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186458884} {:answer/id #uuid "d8489c3f-9e56-5d17-962f-9c79515a686c" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186459006} {:answer/id #uuid "f3ac2196-f618-5a19-8037-4a5f973800f1" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186459059}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186459006} :answer-field/id #uuid "00203bb5-c9e3-5903-82ca-f2bb945cbf8b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186459087}] :question/id #uuid "6afa206b-a720-5d99-9269-3c50ce4125f7" :question/math-academy-id "q-141458" :question/problem "Which of the following statements are true given that $T:{R}^{5}\\to {R}^{5}$ is a linear transformation whose standard matrix is $T,$ and $T({v}_{1})=T({v}_{2})$ for some distinct vectors  ${v}_{1}$ and ${v}_{2}?$ \n\nI. $\\text{nullity}(T)=0$\n\nII. $T$ is a bijection\n\nIII. $\\text{Im}(T)\\ne {R}^{5}$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{5}$ into ${R}^{5},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,\\{\\,\\begin{aligned} & \\text{Im}(T)={R}^{5} \\\\  & \\text{rank}(T)=5 \\\\  & \\text{Ker}(T)=\\{0\\} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nSince $T$ is a linear transformation, we have that\n\n$$\nT({v}_{1})=T({v}_{2})\\,⟹\\,T({v}_{1}-{v}_{2})=0.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since ${v}_{1}-{v}_{2}\\in \\text{Ker}(T)$ and ${v}_{1}\\ne {v}_{2},$ we must have that $\\text{Ker}(T)\\ne \\{0\\},$ which means  $\\text{nullity}(T)\\ne 0.$\n\n- Statement II is false. According to the invertible matrix theorem, since $\\text{nullity}(T)\\ne 0,$ the transformation $T$ is not a bijection.\n\n- Statement III is true. Since $T$ is not a bijection, the invertible matrix theorem implies that $\\text{Im}(T)\\ne {R}^{5}.$\n\nTherefore, the correct answer is \"III only.\""} {:db/id #edb/ref 17592186491133 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10cc0094-bac1-5f58-90e7-0542270cfe41" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186490545} {:answer/id #uuid "26362897-13ad-56e5-b914-73711e4101e5" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186490579} {:answer/id #uuid "3a373190-4d45-5034-8914-6d455e9c0585" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186490618} {:answer/id #uuid "6c259be5-acf0-54dd-8223-55148358afdf" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186490721} {:answer/id #uuid "ab8bcf39-4575-5bf9-89c4-0e0c13cd32a6" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186490852}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186490721} :answer-field/id #uuid "440926a7-d150-590e-8da5-b5a15d06d323" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491032}] :question/id #uuid "360fdc6a-8e68-5e59-be91-60b011ed6613" :question/math-academy-id "q-141459" :question/problem "Which of the following statements are true given that $T:{R}^{3}\\to {R}^{3}$ is a linear transformation whose standard matrix is $T,$ and $T(v)=0$ for some vector $v\\ne 0?$ \n\nI. $\\text{Ker}(T)\\ne \\{0\\}$\n\nII. $T$ is invertible\n\nIII. $\\text{Im}(T)={R}^{3}$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,\\{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)=\\{0\\} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since $v\\in \\text{Ker}(T)$ and $v\\ne 0,$ we must have that $\\text{Ker}(T)\\ne \\{0\\}.$\n\n- Statement II is false. According to the invertible matrix theorem, since $\\text{Ker}(T)\\ne \\{0\\},$ the transformation $T$ is not a bijection and the matrix $T$ is not invertible.\n\n- Statement III is false. Since $T$ is not invertible, the invertible matrix theorem implies that $\\text{Im}(T)\\ne {R}^{3}.$\n\nTherefore, the correct answer is \"I only.\""}] :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem"} {:db/id #edb/ref 17592186124631 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124435 :question/id #uuid "2086adfe-9a09-5b60-8f5e-9edb0c700b98" :question/math-academy-id "e-9985" :question/problem "Let $\\mathbf{T}:\\mathbb{R}^3\\rightarrow \\mathbb{R}^3$ be a linear transformation whose standard matrix is $T.$ Consider the following statement:\n\n*If $[1, 2, 1]^T \\not\\in  \\textrm{Im}(\\mathbf{T}),$ then $\\textrm{__________}.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\nI. $\\textrm{Im}(\\mathbf{T})=\\mathbb{R}^3$\n\nII. $\\textrm{Ker}(\\mathbf{T})\\ne\\{\\mathbf{0}\\}$\n\nIII. $\\mathbf{T}$ is invertible" :question/worked-solution "Since $\\mathbf{T}$ is a linear transformation from $\\mathbb{R}^3$ into $\\mathbb{R}^3,$ the invertible matrix theorem states the following:\n\n $\\mathbf{T}$ is a bijection (an invertible transformation) ![](images/d5/d54f9467c22c22ade32bbb49f611c545140b9ce5d11610c04dd7f946d83ac789.svg) \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since $[1, 2, 1]^T \\not\\in  \\textrm{Im}(\\mathbf{T}),$ we must have that $\\textrm{Im}(\\mathbf{T}) \\neq \\mathbb{R}^3.$\n\n- Statement II is true. Since the vector $[1, 2, 1]^T$ does not lie in $\\textrm{Im}(\\mathbf{T})$, then $\\textrm{Im}(\\mathbf{T}) \\neq \\mathbb{R}^3.$ Therefore, according to the invertible matrix theorem, we must have $\\textrm{Ker}(\\mathbf{T}) \\neq \\{\\mathbf{0}\\}.$\n\n- Statement III is false. According to the invertible matrix theorem, since $\\textrm{Im}(\\mathbf{T}) \\neq \\mathbb{R}^3,$ the transformation $\\mathbf T$ can't be invertible.\n\nTherefore, the correct answer is \"II only.\""} :knowledge-point/id #uuid "113a601e-220a-54a3-a64b-1e554bc3d79f" :knowledge-point/questions [{:db/id #edb/ref 17592186125144 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bdf8c018-cb99-5053-b4e3-6368b7af2654" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459933} {:answer/id #uuid "9d7a9fa2-a49a-52e6-a830-661568ed43fe" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459934}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459934} :answer-field/id #uuid "f7a0c060-bfe2-5f11-bc8e-da7a5a85d869" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460833} {:answer-field/choices [{:answer/id #uuid "698591bc-2b07-574b-8dbc-ef38df909a6a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459935} {:answer/id #uuid "d1026046-c71f-597e-8a30-ff09f0697b54" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459936}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459935} :answer-field/id #uuid "db25fff1-1445-57ac-bff6-b3e390e53851" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460834} {:answer-field/choices [{:answer/id #uuid "c0abbc15-e57c-54d7-8b6d-7db47e6feee5" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459937} {:answer/id #uuid "0f3dd321-b9d6-5e3c-b0b2-866e1fee6671" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459938}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459937} :answer-field/id #uuid "38079a01-0d02-58da-86f9-5ca20a764db9" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460835}] :question/id #uuid "3350b458-d932-58ce-9841-3d6f73360368" :question/math-academy-id "q-38977" :question/problem "Let $T:{R}^{4}\\to {R}^{4}$ be a linear transformation whose standard matrix is $T.$ Consider the following statement:\n\n*If $T$ is invertible, then $\\text{__________}.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n- **I.** $\\text{Ker}(T)={0}$\n- **II.** $\\text{rank}(T)\\ne 4$\n- **III.** $\\text{nullity}(T)\\ne 0$\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{4}$ into ${R}^{4},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{4} \\\\  & \\text{rank}(T)=4 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since $T$ is invertible, the invertible matrix theorem implies that $\\text{Ker}(T)={0}.$\n\n- Statement II is false. Since $T$ is invertible, the invertible matrix theorem implies that $\\text{rank}(T)=4.$\n\n- Statement III is false. Since $T$ is invertible, the invertible matrix theorem implies that $\\text{nullity}(T)=0.$\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186125164 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da97a065-c9ea-545d-9832-58ba5595c282" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460017} {:answer/id #uuid "44b485c0-4b9e-522d-95c5-7ceba53f1f39" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460018}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460017} :answer-field/id #uuid "efff0b18-702b-56a0-8bdf-765f60a773b3" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460875} {:answer-field/choices [{:answer/id #uuid "74ec198b-aef3-59b6-b091-30d662e9f4cd" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460019} {:answer/id #uuid "a7f8d74d-cce4-5aab-b18a-c61877075bdb" :answer/type {:db/ident :answer.