x}2 \\\\ -3 \\\\ 7\\end{bmatrix}+t\\begin{bmatrix}4 \\\\ 5 \\\\ -6\\end{bmatrix},\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nThis implies that the given line passes through the point $P(2,-3,7)$ and is parallel to the vector $v=⟨4,5,-6⟩.$ So, its Cartesian (canonical) equation is given by\n\n$$\n\\frac{x-2}{4}=\\frac{y-(-3)}{5}=\\frac{z-7}{-6}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nSimplifying, we reach\n\n$$\n\\frac{x-2}{4}=\\frac{y+3}{5}=\\frac{z-7}{-6}.\n$$"} {:db/id #edb/ref 17592186338873 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae8d31a2-4108-5b70-a2b9-6028137f90c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-1}{4}=\\frac{y+2}{3}=\\frac{z-3}{-1}" :db/id #edb/ref 17592186337599} {:answer/id #uuid "dad457e9-36f4-5373-a8ae-5a83cf89ab16" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+4}{1}=\\frac{y+3}{-2}=\\frac{z-1}{3}" :db/id #edb/ref 17592186337938} {:answer/id #uuid "ddae60a3-e7b6-53d8-a685-22bbeca55eef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{4}=\\frac{y}{3}=\\frac{z}{-1}" :db/id #edb/ref 17592186337961} {:answer/id #uuid "e46e11d0-55a6-5a43-a56a-a1ae738aa692" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+1}{4}=\\frac{y-2}{3}=\\frac{z+3}{-1}" :db/id #edb/ref 17592186338024} {:answer/id #uuid "e6ed3113-4eff-5953-808b-fbc5001c263c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-4}{1}=\\frac{y-3}{-2}=\\frac{z+1}{3}" :db/id #edb/ref 17592186338050}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-1}{4}=\\frac{y+2}{3}=\\frac{z-3}{-1}" :db/id #edb/ref 17592186337599} :answer-field/id #uuid "9a611fa6-284f-50f1-8fc1-c57d199ac0a5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338560}] :question/id #uuid "e95c1868-5bfc-59ba-944f-8512f3686ef7" :question/math-academy-id "q-71023" :question/problem "Consider the straight line with the vector equation\n\n$$\nr=\\begin{bmatrix}1 \\\\ -2 \\\\ 3\\end{bmatrix}+t\\begin{bmatrix}4 \\\\ 3 \\\\ -1\\end{bmatrix}\n$$\n\nfor $t\\in (-\\infty ,\\infty ).$ Find the Cartesian equation of this line." :question/worked-solution "We have the vector equation \n\n$$\nr=\\begin{bmatrix}1 \\\\ -2 \\\\ 3\\end{bmatrix}+t\\begin{bmatrix}4 \\\\ 3 \\\\ -1\\end{bmatrix},\\,t\\in (-\\infty ,\\infty ).\n$$\n\nThis implies that the straight line passes through the point $P(1,-2,3)$ and is parallel to the vector $v=⟨4,3,-1⟩.$ So, its Cartesian (canonical) equation is given by\n\n$$\n\\frac{x-1}{4}=\\frac{y-(-2)}{3}=\\frac{z-3}{-1}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nSimplifying, we reach\n\n$$\n\\frac{x-1}{4}=\\frac{y+2}{3}=\\frac{z-3}{-1}.\n$$"} {:db/id #edb/ref 17592186338876 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4687a476-743c-5663-8059-be516a1b00d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-10}{3}=\\frac{y}{-7}=\\frac{z+6}{-5}" :db/id #edb/ref 17592186336687} {:answer/id #uuid "4ee0f395-cc46-5d7d-8c23-3711b1bbc7db" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{3}=\\frac{y}{-7}=\\frac{z}{-5}" :db/id #edb/ref 17592186336761} {:answer/id #uuid "5eb4e60c-fc92-5e6a-873c-9adb63a08f65" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-3}{10}=\\frac{z+5}{-6},\\,y=-7" :db/id #edb/ref 17592186336892} {:answer/id #uuid "ae824b75-7b04-55e9-9b91-a0db68311c7f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+10}{3}=\\frac{y}{-7}=\\frac{z-6}{-5}" :db/id #edb/ref 17592186337598} {:answer/id #uuid "aeb80ffc-9a94-5fa5-b322-54fc8ccc30cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+3}{10}=\\frac{z-5}{-6},\\,y=7" :db/id #edb/ref 17592186337600}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-10}{3}=\\frac{y}{-7}=\\frac{z+6}{-5}" :db/id #edb/ref 17592186336687} :answer-field/id #uuid "e26532ed-39ca-568b-b8c1-04064e77541d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338676}] :question/id #uuid "5a15416a-0d95-55a8-b911-87d641acee2e" :question/math-academy-id "q-71028" :question/problem "Consider the straight line with the vector equation\n\n$$\nr=\\begin{bmatrix}10 \\\\ 0 \\\\ -6\\end{bmatrix}+t\\begin{bmatrix}3 \\\\ -7 \\\\ -5\\end{bmatrix}\n$$\n\nfor $t\\in (-\\infty ,\\infty ).$ Find the Cartesian equation of this line." :question/worked-solution "We have the vector equation \n\n$$\nr=\\begin{bmatrix}10 \\\\ 0 \\\\ -6\\end{bmatrix}+t\\begin{bmatrix}3 \\\\ -7 \\\\ -5\\end{bmatrix},\\,t\\in (-\\infty ,\\infty ).\n$$\n\nThis implies that the straight line passes through the point $P(10,0,-6)$ and is parallel to the vector $v=⟨3,-7,-5⟩.$ So, its Cartesian (canonical) equation is given by\n\n$$\n\\frac{x-10}{3}=\\frac{y-0}{-7}=\\frac{z-(-6)}{-5}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nSimplifying, we reach\n\n$$\n\\frac{x-10}{3}=\\frac{y}{-7}=\\frac{z+6}{-5}.\n$$"} {:db/id #edb/ref 17592186338877 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19e64b37-3c7a-5132-a82c-36330fe10f58" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+3}{4}=\\frac{y+4}{6}=\\frac{z-5}{9}" :db/id #edb/ref 17592186336271} {:answer/id #uuid "8a752ea7-fe86-5478-aae7-722d6e7a29af" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+4}{3}=\\frac{y+6}{4}=\\frac{z+9}{-5}" :db/id #edb/ref 17592186337279} {:answer/id #uuid "a048d6c7-d4d3-50d9-b51c-8fa355607987" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-3}{4}=\\frac{y-4}{6}=\\frac{z+5}{9}" :db/id #edb/ref 17592186337480} {:answer/id #uuid "bf30416c-dc68-5dc0-91dd-21e3d89ecdd7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-4}{3}=\\frac{y-6}{4}=\\frac{z-9}{-5}" :db/id #edb/ref 17592186337731} {:answer/id #uuid "df728bc5-3bdf-5b55-bb17-24b6ef4f6f21" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{4}=\\frac{y}{6}=\\frac{z}{9}" :db/id #edb/ref 17592186337982}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-3}{4}=\\frac{y-4}{6}=\\frac{z+5}{9}" :db/id #edb/ref 17592186337480} :answer-field/id #uuid "32bcf106-ea5d-53fa-a139-89e099b59c67" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338373}] :question/id #uuid "db08ec21-5e10-5fa9-a587-34ff723a0e65" :question/math-academy-id "q-71029" :question/problem "Consider the straight line with the vector equation\n\n$$\nr=\\begin{bmatrix}3 \\\\ 4 \\\\ -5\\end{bmatrix}+t\\begin{bmatrix}4 \\\\ 6 \\\\ 9\\end{bmatrix}\n$$\n\nfor $t\\in (-\\infty ,\\infty ).$ Find the Cartesian equation of this line." :question/worked-solution "We have the vector equation \n\n$$\nr=\\begin{bmatrix}3 \\\\ 4 \\\\ -5\\end{bmatrix}+t\\begin{bmatrix}4 \\\\ 6 \\\\ 9\\end{bmatrix},\\,t\\in (-\\infty ,\\infty ).\n$$\n\nThis implies that the straight line passes through the point $P(3,4,-5)$ and is parallel to the vector $v=⟨4,6,9⟩.$ So, its Cartesian (canonical) equation is given by\n\n$$\n\\frac{x-3}{4}=\\frac{y-4}{6}=\\frac{z-(-5)}{9}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nSimplifying, we reach\n\n$$\n\\frac{x-3}{4}=\\frac{y-4}{6}=\\frac{z+5}{9}.\n$$"} {:db/id #edb/ref 17592186367226 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9e78327-b43d-5969-8d3b-bed4609b49e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{-5}=\\frac{y+3}{2}=\\frac{z-7}{-1}" :db/id #edb/ref 17592186367228} {:answer/id #uuid "415707ec-16c3-52eb-ae48-60f27d55babf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{-1}=\\frac{y+3}{2}=\\frac{z-7}{-5}" :db/id #edb/ref 17592186367229} {:answer/id #uuid "ace39f4a-2512-5b36-8884-7fa037704cfc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+5}{2}=\\frac{y-2}{-3}=\\frac{z+1}{7}" :db/id #edb/ref 17592186367230} {:answer/id #uuid "e8680259-b972-51c1-a413-a39306c9e5d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+2}{-5}=\\frac{y+3}{2}=\\frac{z+7}{1}" :db/id #edb/ref 17592186367231} {:answer/id #uuid "e0439e86-3ea3-5b81-8a8b-d0a949ba059f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+5}{3}=\\frac{y-2}{-2}=\\frac{z+1}{7}" :db/id #edb/ref 17592186367232}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{-5}=\\frac{y+3}{2}=\\frac{z-7}{-1}" :db/id #edb/ref 17592186367228} :answer-field/id #uuid "4010e133-bb74-590a-aaad-0744ebb64de5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367227}] :question/id #uuid "841b2c54-bf92-5c9a-835e-03e5b492bd88" :question/math-academy-id "q-127408" :question/problem "Consider the straight line with the vector equation\n\n$$\nr=\\begin{bmatrix}2 \\\\ -3 \\\\ 7\\end{bmatrix}+t\\begin{bmatrix}-5 \\\\ 2 \\\\ -1\\end{bmatrix}\n$$\n\nfor $t\\in (-\\infty ,\\infty ).$ Find the Cartesian equation of this line." :question/worked-solution "We have the vector equation \n\n$$\nr=\\begin{bmatrix}2 \\\\ -3 \\\\ 7\\end{bmatrix}+t\\begin{bmatrix}-5 \\\\ 2 \\\\ -1\\end{bmatrix},\\,t\\in (-\\infty ,\\infty ).\n$$\n\nThis implies that the straight line passes through the point $P(2,-3,7)$ and is parallel to the vector $v=⟨-5,2,-1⟩.$ So, its Cartesian (canonical) equation is given by\n\n$$\n\\frac{x-2}{-5}=\\frac{y-(-3)}{2}=\\frac{z-7}{-1}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nSimplifying, we reach\n\n$$\n\\frac{x-2}{-5}=\\frac{y+3}{2}=\\frac{z-7}{-1}.\n$$"} {:db/id #edb/ref 17592186413270 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c2d99a9-ddfb-5a97-abd4-e05bcb1d544a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-3}{-4}=\\frac{y-5}{2}=\\frac{z+3}{6}" :db/id #edb/ref 17592186413209} {:answer/id #uuid "6e085e60-92ea-59c0-9469-2c2512ee9670" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{-4}=\\frac{y}{2}=\\frac{z}{6}" :db/id #edb/ref 17592186413223} {:answer/id #uuid "781dc19c-aaeb-55b8-b85e-398e8c40ddf0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-4}{3}=\\frac{y+2}{5}=\\frac{z+6}{-3}" :db/id #edb/ref 17592186413225} {:answer/id #uuid "c2000bfc-3f8b-500c-ac25-9de30657d477" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+3}{-4}=\\frac{y+5}{2}=\\frac{z+3}{6}" :db/id #edb/ref 17592186413243} {:answer/id #uuid "d9ee8d2d-95e8-52c8-884c-18433cf351d2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+4}{3}=\\frac{y-2}{5}=\\frac{z-6}{-3}" :db/id #edb/ref 17592186413247}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-3}{-4}=\\frac{y-5}{2}=\\frac{z+3}{6}" :db/id #edb/ref 17592186413209} :answer-field/id #uuid "6b270efb-9c32-5f2a-a9f0-0cab10121392" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413259}] :question/id #uuid "cf27c214-ec1e-55e8-948b-06e561f6f7e7" :question/math-academy-id "q-33246" :question/problem "Consider the straight line with the parametric equations\n\n$$\n\\left\\{\\begin{aligned}x &=3-4t \\\\ y &=5+2t \\\\ z &=-3+6t\\end{aligned}\\right.\n$$\n\n \nfor $t\\in (-\\infty ,\\infty ).$ Find the Cartesian equation of this line." :question/worked-solution "First, let's find the corresponding vector equation as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}3-4t \\\\ 5+2t \\\\ -3+6t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ 5 \\\\ -3\\end{bmatrix}+\\begin{bmatrix}-4t \\\\ 2t \\\\ 6t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ 5 \\\\ -3\\end{bmatrix}+t\\begin{bmatrix}-4 \\\\ 2 \\\\ 6\\end{bmatrix} \\\\ r & =\\begin{bmatrix}3 \\\\ 5 \\\\ -3\\end{bmatrix}+t\\begin{bmatrix}-4 \\\\ 2 \\\\ 6\\end{bmatrix},\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nThis implies that the straight line passes through the point $P(3,5,-3)$ and is parallel to the vector $v=⟨-4,2,6⟩.$ So, its Cartesian (canonical) equation is given by\n\n$$\n\\frac{x-3}{-4}=\\frac{y-5}{2}=\\frac{z-(-3)}{6}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nSimplifying, we reach\n\n$$\n\\frac{x-3}{-4}=\\frac{y-5}{2}=\\frac{z+3}{6}.\n$$"}] :knowledge-point/title "Finding the Cartesian Equation of a Line Given in Parametric or Vector Form"} {:db/id #edb/ref 17592186119828 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119639 :question/id #uuid "df314d1d-56c8-5503-b632-8a425b47070f" :question/math-academy-id "e-4912" :question/problem "Find a Cartesian equation of the line shown in the figure below.\n\n![](images/79/792bf09ff2546903b863a879a2518c42bbd30fdfce652bd4e22b1ad19aefc7c9.png)" :question/worked-solution "We know that the line passes through the points ![](images/aa/aa4328c3ce96a1b9871e71f5cc27e255e47d186fe5848ea0f7d43b324d41a2d6.svg) and ![](images/9a/9a6a4549ad0127d861d9a5c0a1ceff0b41b7c06b648a327779f31b325ea5800e.svg) Now, we need to find a vector parallel to the given line. Let's consider the vector ![](images/e6/e6db167bc32b19da05d87b24e9b910b80d32a1ef9e5965ab4cb5217a1fac4730.svg) which is given by\n![](images/e1/e17614c58be91b6165e40be1c489685e14898756db2d6a41bf80b638e666fc51.svg)\n\nUsing the point ![](images/1a/1aaddf0d4be4d873ff6c0600b0b239e0565a05ca8daaff7ca92bd5c70bebcf03.svg) and the vector ![](images/e6/e6db167bc32b19da05d87b24e9b910b80d32a1ef9e5965ab4cb5217a1fac4730.svg), we have that the Cartesian (canonical) equation of the given line is given by\n![](images/8d/8df9f1471a16c7b99e55290a41fe97641d62cef3bf5ba0e57e7fe6c029e98807.svg)\nor equivalently\n![](images/9e/9e688c295265c270ba7e1f66fc13ceebe9f6385ea45000c6f42c204d3fb6ba50.svg)\n\nBut the above equation is problematic because ![](images/74/7435bec0e47e7cfafdcbdbf0763b77d55a16344504663512cbbcf8b75a50381f.svg) involves division by zero.\n\nHowever, in our line, the ![](images/90/9032cb23a878659e74b670d3779a8cd4793b28af921eab1a6b3f2041a815e03b.svg) component always maintains the constant value ![](images/ef/efcfb7a56c85727ded8a9d5c9bd75fd79ac0bc20ba202c2da6aaca3c4e3ba503.svg) For example, our two points ![](images/aa/aa4328c3ce96a1b9871e71f5cc27e255e47d186fe5848ea0f7d43b324d41a2d6.svg) and ![](images/de/dee63698dc962e270612a470eb5e1eb23ffcbd72c8f9d787bc7eb927ff05f1c6.svg) both have ![](images/90/9032cb23a878659e74b670d3779a8cd4793b28af921eab1a6b3f2041a815e03b.svg)-coordinates of ![](images/ef/efcfb7a56c85727ded8a9d5c9bd75fd79ac0bc20ba202c2da6aaca3c4e3ba503.svg)\n\nSo, in the Cartesian equation, we remove the ![](images/74/7435bec0e47e7cfafdcbdbf0763b77d55a16344504663512cbbcf8b75a50381f.svg) part and instead write ![](images/6b/6be447d259b9b63c2cdd7adc4107d7c96ed4df1730890fc1bb5ce7cd585b8ea6.svg) as follows:\n\n![](images/92/92f849bc9c2fc37e54e4ecf4901b06624536d835db97d31f94ab77573d6e401b.svg)"} :knowledge-point/id #uuid "cbc74baa-313b-51e7-8ae1-5e9fe0761256" :knowledge-point/questions [{:db/id #edb/ref 17592186120243 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0458b289-ce6f-53e9-9190-50822f0b8ea9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+7}{2}=\\frac{y+4}{3},\\,z=3" :db/id #edb/ref 17592186302482} {:answer/id #uuid "469011d3-9dbd-516d-9a6b-23bf10fe8d8f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+2}{7}=\\frac{y-3}{-4}=\\frac{z-1}{3}" :db/id #edb/ref 17592186302904} {:answer/id #uuid "5df0f6c3-4d3f-5166-a228-df9184328d09" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+7}{2}=\\frac{y+4}{3}=\\frac{z-3}{1}" :db/id #edb/ref 17592186303029} {:answer/id #uuid "7c80630d-4868-5757-9cc0-ceebffaf7e87" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+2}{2}=\\frac{y-3}{3}=\\frac{z-1}{1}" :db/id #edb/ref 17592186303228} {:answer/id #uuid "c8f04deb-868d-57ec-99de-d67f676cd65f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{7}=\\frac{y}{-4}=\\frac{z}{3}" :db/id #edb/ref 17592186303689}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+2}{7}=\\frac{y-3}{-4}=\\frac{z-1}{3}" :db/id #edb/ref 17592186302904} :answer-field/id #uuid "afdffc35-a050-5be2-9abe-237a21d184e4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304554}] :question/id #uuid "deb4cbaf-5918-5a60-ba36-d2bbb72dfbda" :question/math-academy-id "q-33234" :question/problem "![](images/1f/1f9599192c1979f40fc519458019ed3296d9a5ef9048aaed41aab973c62e0be8.png)\n\nFind a Cartesian equation of the line shown in the figure above." :question/worked-solution "We know that the line passes through the points $P(-2,3,1)$ and $Q(5,-1,4).$ Now, we need to find a vector parallel to the given line. Let's consider the vector $\\overset{\\to }{PQ}$ which is given by\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨5,-1,4⟩-⟨-2,3,1⟩ \\\\  & =⟨7,-4,3⟩.\\end{aligned}\n$$\n\nUsing the point $P$ and the vector $\\overset{\\to }{PQ}$, we have that the Cartesian (canonical) equation of the given line is given by\n\n$$\n\\frac{x-(-2)}{7}=\\frac{y-3}{-4}=\\frac{z-1}{3}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x+2}{7}=\\frac{y-3}{-4}=\\frac{z-1}{3}.\n$$"} {:db/id #edb/ref 17592186120246 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d01c29b4-dcb4-5de6-ac18-3be5026b61d8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x + 3}{5} = \\frac{y - 5}{-11} = \\frac{z - 8}{1}" :db/id #edb/ref 17592186117636} {:answer/id #uuid "de7b6a79-fe8a-5e43-bf7e-a9eaa0488e68" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x + 5}{-3} = \\frac{y + 11}{5} = \\frac{z - 1}{8}" :db/id #edb/ref 17592186117637} {:answer/id #uuid "5780b0bc-086a-5bab-9baa-7535436b5815" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x + 5}{2} = \\frac{y + 11}{-6}, z = 1" :db/id #edb/ref 17592186117638} {:answer/id #uuid "6d2c095c-7e26-5c56-bdad-48682a2b4c5a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x + 5}{2} = \\frac{y + 11}{-6} = \\frac{z - 1}{9}" :db/id #edb/ref 17592186117639} {:answer/id #uuid "7661ec1c-965e-5992-b685-bf5a99c4c75a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{3} = \\frac{y + 11}{5}, z = 0" :db/id #edb/ref 17592186117640}] :answer-field/id #uuid "c52b5efe-a0d1-5498-976f-fca1db5d0ff5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117635}] :question/id #uuid "88497230-35e1-5be6-9a7b-969eb2f8e01f" :question/math-academy-id "q-33252" :question/problem "![](images/c9/c98485de8f94d4f00c0a1dd6eae30db51ee65cd8997d6dcb13aa590abafb816a.png)\n\nFind a Cartesian equation of the line shown in the figure above."} {:db/id #edb/ref 17592186262776 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fafacb4-7245-53f8-8b71-32255ae24867" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+1}{8}=\\frac{y-4}{-5}=\\frac{z-5}{-3}" :db/id #edb/ref 17592186260306} {:answer/id #uuid "74476a0a-0598-5512-a162-969f54033e22" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+1}{8}=\\frac{y+4}{-5}=\\frac{z+5}{-3}" :db/id #edb/ref 17592186260892} {:answer/id #uuid "8042af39-00a6-5489-835e-601f12f14e78" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-1}{8}=\\frac{y-4}{5}=\\frac{z+5}{-3}" :db/id #edb/ref 17592186260988} {:answer/id #uuid "9e9f4224-4caa-5d08-9e45-15356341a13c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+1}{-8}=\\frac{y-4}{-5}=\\frac{z-5}{3}" :db/id #edb/ref 17592186261251} {:answer/id #uuid "ccaf8b10-1c90-5d3a-99e6-66bd850a2c44" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+1}{-8}=\\frac{y-4}{-3}=\\frac{z-5}{-5}" :db/id #edb/ref 17592186261677}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+1}{8}=\\frac{y-4}{-5}=\\frac{z-5}{-3}" :db/id #edb/ref 17592186260306} :answer-field/id #uuid "f6b091ac-faa9-5b51-87d6-4183663a28fd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262552}] :question/id #uuid "137b0f7e-9478-507b-9673-19fabe3f3d94" :question/math-academy-id "q-127466" :question/problem "![](images/16/1647eb5cca32c6fdc99e23507db151a8299b29bfa70ebfbaa941e17fe4638586.png)\n\nFind a Cartesian equation of the line shown in the figure above." :question/worked-solution "We know that the line passes through the points $P(-1,4,5)$ and $Q(7,-1,2).$ Now, we need to find a vector parallel to the given line. Let's consider the vector $\\overset{\\to }{PQ}$ which is given by\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨7,-1,2⟩-⟨-1,4,5⟩ \\\\  & =⟨8,-5,-3⟩.\\end{aligned}\n$$\n\nUsing the point $P$ and the vector $\\overset{\\to }{PQ}$, we have that the Cartesian (canonical) equation of the given line is given by\n\n$$\n\\frac{x-(-1)}{8}=\\frac{y-4}{-5}=\\frac{z-5}{-3}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x+1}{8}=\\frac{y-4}{-5}=\\frac{z-5}{-3}.\n$$"} {:db/id #edb/ref 17592186262792 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "628ba019-e287-5e6c-9c20-0bd08a8d96f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{-2}=\\frac{y+1}{-4},\\,z=-3" :db/id #edb/ref 17592186260725} {:answer/id #uuid "b5e6a649-3a81-512d-94bb-f14eb562c95d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{2}=\\frac{y+1}{-2},\\,z=3" :db/id #edb/ref 17592186261472} {:answer/id #uuid "c7117f4f-8b9b-5207-8fcb-870aceb867f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+2}{2}=\\frac{y+1}{4},\\,z=3" :db/id #edb/ref 17592186261635} {:answer/id #uuid "e335a903-50df-50af-bbcb-1934b2874ec6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{-2}=\\frac{y+1}{4},\\,z=3" :db/id #edb/ref 17592186261871} {:answer/id #uuid "f563cde3-4746-533c-bf25-d120ecc2da8d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{2}=\\frac{y-1}{-4},\\,z=-3" :db/id #edb/ref 17592186262020}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{2}=\\frac{y+1}{-2},\\,z=3" :db/id #edb/ref 17592186261472} :answer-field/id #uuid "1c9a7cd2-cbdc-54f5-8320-283acf5adf7b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262169}] :question/id #uuid "b6f2a4e2-bb20-56c7-957d-47666291e84e" :question/math-academy-id "q-127527" :question/problem "![](images/87/8722b93655e069e2f35147b572c16ed7af408a86f8a88597c79aea8fe59e9c4d.png)\n\nFind a Cartesian equation of the line shown in the figure above." :question/worked-solution "We know that the line passes through the points $P(2,-1,3)$ and $Q(4,-3,3).$ Now, we need to find a vector parallel to the given line. Let's consider the vector $\\overset{\\to }{PQ}$ which is given by\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨4,-3,3⟩-⟨2,-1,3⟩ \\\\  & =⟨2,-2,0⟩.\\end{aligned}\n$$\n\nUsing the point $P$ and the vector $\\overset{\\to }{PQ}$, we have that the Cartesian (canonical) equation of the given line is given by\n\n$$\n\\frac{x-2}{2}=\\frac{y-(-1)}{-2}=\\frac{z-3}{0}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x-2}{2}=\\frac{y+1}{-2}=\\frac{z-3}{0}.\n$$\n\nBut the above equation is problematic because $\\frac{z-3}{0}$ involves division by zero.\n\nHowever, in our line, the $z$ component always maintains the constant value of $z=3.$ For example, our two points $P(2,-1,3)$ and $Q(4,-3,3)$ both have $z$-coordinates of $z=3.$\n\nSo, in the Cartesian equation, we remove the $\\frac{z-3}{0}$ part and instead write $z=3,$ as follows:\n\n$$\n\\frac{x-2}{2}=\\frac{y+1}{-2},\\,z=3.\n$$"} {:db/id #edb/ref 17592186262793 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03632aeb-4b90-5c99-9b4d-54ac007822a8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-7}{6}=\\frac{y-2}{3},\\,z=-4" :db/id #edb/ref 17592186259905} {:answer/id #uuid "22ded5e3-34aa-5914-8657-9ed44f392f5e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+7}{-6}=\\frac{y+2}{-3},\\,z=4" :db/id #edb/ref 17592186260182} {:answer/id #uuid "30f21975-5d34-558d-a71d-4718ac5bdce3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-7}{6}=\\frac{y-2}{3},\\,z=4" :db/id #edb/ref 17592186260315} {:answer/id #uuid "3ef37e59-a875-5466-9104-13be41424907" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-7}{-6}=\\frac{y+2}{3},\\,z=4" :db/id #edb/ref 17592186260428} {:answer/id #uuid "bda46962-ad98-5ba5-89ed-a01cbaff0906" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+7}{-6}=\\frac{y-2}{-3},\\,z=-4" :db/id #edb/ref 17592186261549}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-7}{-6}=\\frac{y+2}{3},\\,z=4" :db/id #edb/ref 17592186260428} :answer-field/id #uuid "0504d52f-08ef-5bda-b931-115705914b5c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262131}] :question/id #uuid "b51977f5-581a-5b22-a0d4-d5e01eee808b" :question/math-academy-id "q-127535" :question/problem "![](images/44/44b0b683358bb448229380402717f396d13f82d2904bbf1ece1fcf9fd4567f14.png)\n\nFind a Cartesian equation of the line shown in the figure above." :question/worked-solution "We know that the line passes through the points $P(7,-2,4)$ and $Q(1,1,4).$ Now, we need to find a vector parallel to the given line. Let's consider the vector $\\overset{\\to }{PQ}$ which is given by\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,1,4⟩-⟨7,-2,4⟩ \\\\  & =⟨-6,3,0⟩.\\end{aligned}\n$$\n\nUsing the point $P$ and the vector $\\overset{\\to }{PQ}$, we have that the Cartesian (canonical) equation of the given line is given by\n\n$$\n\\frac{x-7}{-6}=\\frac{y-(-2)}{3}=\\frac{z-4}{0}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x-7}{-6}=\\frac{y+2}{3}=\\frac{z-4}{0}.\n$$\n\nBut the above equation is problematic because $\\frac{z-4}{0}$ involves division by zero.\n\nHowever, in our line, the $z$ component always maintains the constant value of $z=4.$ For example, our two points $P(7,-2,4)$ and $Q(1,1,4)$ both have $z$-coordinates of $z=4.$\n\nSo, in the Cartesian equation, we remove the $\\frac{z-4}{0}$ part and instead write $z=4,$ as follows:\n\n$$\n\\frac{x-7}{-6}=\\frac{y+2}{3},\\,z=4\n$$"} {:db/id #edb/ref 17592186302413 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "479462e3-99fd-57c1-b5de-1ad72b7bafb9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y-3}{-1}=\\frac{z+1}{3},\\,x=0" :db/id #edb/ref 17592186300324} {:answer/id #uuid "76a0f74a-1c6e-585c-90c9-874714aa4f3d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{2}=\\frac{y}{3}=\\frac{z}{-1}" :db/id #edb/ref 17592186300548} {:answer/id #uuid "a94a8134-d53b-5805-bc2d-2f8370fa55b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{2}=\\frac{y+1}{3}=\\frac{z-3}{-1}" :db/id #edb/ref 17592186300811} {:answer/id #uuid "ae67b951-3c4b-5739-8958-e989c4fb4ebd" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186300834} {:answer/id #uuid "bdda7067-6196-5b5b-ae34-eebb2a051bbc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y-3}{-1}=\\frac{z+1}{3},\\,x=2" :db/id #edb/ref 17592186300909}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{2}=\\frac{y+1}{3}=\\frac{z-3}{-1}" :db/id #edb/ref 17592186300811} :answer-field/id #uuid "969e06ee-65c5-5f68-8704-5c76eedbaf9e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301711}] :question/id #uuid "3f334edf-1682-5eef-8043-6ee3979dea32" :question/math-academy-id "q-32827" :question/problem "Find a Cartesian equation of the straight line that passes through $P(0,-1,3)$ and is parallel to $v=⟨2,3,-1⟩.$" :question/worked-solution "Remember that the Cartesian (canonical) equation of the straight line that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is parallel to the vector $v=⟨{v}_{x},{v}_{y},{v}_{z}⟩$, is given by\n\n$$\n\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nSo, we have\n\n$$\n\\frac{x-0}{2}=\\frac{y-(-1)}{3}=\\frac{z-3}{-1}=t,\\,t\\in (-\\infty ,\\infty )\n$$\n\nor equivalently\n\n$$\n\\frac{x}{2}=\\frac{y+1}{3}=\\frac{z-3}{-1}.\n$$"} {:db/id #edb/ref 17592186302415 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ae03aa1-408b-5548-a624-6152adae5980" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{4}=\\frac{y}{-3}=\\frac{z}{-2}" :db/id #edb/ref 17592186300085} {:answer/id #uuid "4906a853-7d88-56e7-b8bd-53d276e6826a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+4}{-1}=\\frac{y-3}{1}=\\frac{z-2}{4}" :db/id #edb/ref 17592186300333} {:answer/id #uuid "8d335767-409a-536d-b540-907f8e291fa4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+1}{4}=\\frac{y-1}{-3}=\\frac{z-4}{-2}" :db/id #edb/ref 17592186300676} {:answer/id #uuid "bffb27fb-b54b-539d-93bb-e073e9539a54" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-4}{-1}=\\frac{y+3}{1}=\\frac{z+2}{4}" :db/id #edb/ref 17592186300924} {:answer/id #uuid "d51a31cb-125b-53e4-97cb-d4cb19db3894" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-1}{4}=\\frac{y+1}{-3}=\\frac{z+4}{-2}" :db/id #edb/ref 17592186301019}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+1}{4}=\\frac{y-1}{-3}=\\frac{z-4}{-2}" :db/id #edb/ref 17592186300676} :answer-field/id #uuid "b4ed0515-d165-570b-8ae3-31ffa65820ff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301815}] :question/id #uuid "7a883673-7d08-54f5-83e2-ff286d2a402e" :question/math-academy-id "q-32829" :question/problem "![](images/58/58076d96d149ff4521103fd15c7187bc1a58595ab20f28be92be0f79385aee61.png)\n\nFind a Cartesian equation of the line shown in the figure above." :question/worked-solution "We know that the line passes through the points $P(-1,1,4)$ and $Q(3,-2,2).$ Now, we need to find a vector parallel to the given line. Let's consider the vector $\\overset{\\to }{PQ}$ which is given by\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨3,-2,2⟩-⟨-1,1,4⟩ \\\\  & =⟨4,-3,-2⟩.\\end{aligned}\n$$\n\nUsing the point $P$ and the vector $\\overset{\\to }{PQ}$, we have that the Cartesian (canonical) equation of the given line is given by\n\n$$\n\\frac{x-(-1)}{4}=\\frac{y-1}{-3}=\\frac{z-4}{-2}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x+1}{4}=\\frac{y-1}{-3}=\\frac{z-4}{-2}.\n$$"} {:db/id #edb/ref 17592186305038 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "192a2e26-aa29-5dbd-9ae9-4d0f4aef62b5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-3}{3}=\\frac{y+5}{6}=\\frac{z-7}{9}" :db/id #edb/ref 17592186302624} {:answer/id #uuid "1a49d18c-40bc-5e1e-ad7e-30cf50c532b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+3}{3}=\\frac{y-5}{6}=\\frac{z+7}{9}" :db/id #edb/ref 17592186302630} {:answer/id #uuid "bdc1f171-018e-5198-8b73-18a77d4826c9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{3}=\\frac{y}{6}=\\frac{z}{9}" :db/id #edb/ref 17592186303619} {:answer/id #uuid "d645aa96-6f7d-508e-8334-2e2c1e64ce7f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-3}{3}=\\frac{y-6}{-5}=\\frac{z-9}{7}" :db/id #edb/ref 17592186303788} {:answer/id #uuid "fa8e4ad7-1d56-56b4-b26a-db446c7c27aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+3}{3}=\\frac{y+6}{-5}=\\frac{z+9}{7}" :db/id #edb/ref 17592186304029}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-3}{3}=\\frac{y+5}{6}=\\frac{z-7}{9}" :db/id #edb/ref 17592186302624} :answer-field/id #uuid "70f6b24a-8f12-538c-bf7f-c0bb248adffd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304384}] :question/id #uuid "f41292b0-6019-55a6-adaa-1776104a9250" :question/math-academy-id "q-33249" :question/problem "Find a Cartesian equation of the straight line that passes through $P(3,-5,7)$ and is parallel to $v=⟨3,6,9⟩.$" :question/worked-solution "Remember that the Cartesian (canonical) equation of the straight line that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is parallel to the vector $v=⟨{v}_{x},{v}_{y},{v}_{z}⟩$, is given by\n\n$$\n\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nSo, we have\n\n$$\n\\frac{x-3}{3}=\\frac{y-(-5)}{6}=\\frac{z-7}{9}=t,\\,t\\in (-\\infty ,\\infty )\n$$\n\nor, equivalently,\n\n$$\n\\frac{x-3}{3}=\\frac{y+5}{6}=\\frac{z-7}{9}.\n$$"} {:db/id #edb/ref 17592186338878 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68dc5f00-83c7-53e1-a431-3f9ecb95097f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+9}{4}=\\frac{y+3}{-5}=\\frac{z-7}{3}" :db/id #edb/ref 17592186336965} {:answer/id #uuid "99e37d85-5446-5b2d-8f13-39450e565e90" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-4}{9}=\\frac{y+5}{3}=\\frac{z-3}{-7}" :db/id #edb/ref 17592186337431} {:answer/id #uuid "a40025cc-d4e3-56de-865a-c669abbecae2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+4}{9}=\\frac{y-5}{3}=\\frac{z+3}{-7}" :db/id #edb/ref 17592186337521} {:answer/id #uuid "da18075b-505b-551d-a5e1-c55e43718c88" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-9}{4}=\\frac{y-3}{-5}=\\frac{z+7}{3}" :db/id #edb/ref 17592186337932} {:answer/id #uuid "deeb58c9-e2b4-5a3a-942e-1cd0a54981a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{4}=\\frac{y}{-5}=\\frac{z}{3}" :db/id #edb/ref 17592186337977}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-9}{4}=\\frac{y-3}{-5}=\\frac{z+7}{3}" :db/id #edb/ref 17592186337932} :answer-field/id #uuid "b0db96f4-8315-5937-8bf9-ee8849260120" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338601}] :question/id #uuid "489a2b97-718c-5e30-886b-642db6f4e1ba" :question/math-academy-id "q-71030" :question/problem "Find a Cartesian equation of the straight line that passes through $P(9,3,-7)$ and is parallel to $v=⟨4,-5,3⟩.$" :question/worked-solution "Remember that the Cartesian (canonical) equation of the straight line that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is parallel to the vector $v=⟨{v}_{x},{v}_{y},{v}_{z}⟩$, is given by\n\n$$\n\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nSo, we have\n\n$$\n\\frac{x-9}{4}=\\frac{y-3}{-5}=\\frac{z-(-7)}{3}=t,\\,t\\in (-\\infty ,\\infty )\n$$\n\nor equivalently\n\n$$\n\\frac{x-9}{4}=\\frac{y-3}{-5}=\\frac{z+7}{3}.\n$$"} {:db/id #edb/ref 17592186367233 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3f253a6-ff8d-5e56-a2f2-cd3c4e867eef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{-3}=\\frac{z+4}{-3},\\,y=-3" :db/id #edb/ref 17592186367235} {:answer/id #uuid "dfa05efa-b7a8-59b6-9508-b33ce30cc6c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{-3}=\\frac{z-4}{3},\\,y=-3" :db/id #edb/ref 17592186367236} {:answer/id #uuid "6ae283b2-2ffa-5bf6-a7de-7b19f7542443" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+2}{3}=\\frac{z-4}{3},\\,y=-3" :db/id #edb/ref 17592186367237} {:answer/id #uuid "128f4a32-29ef-5e82-9388-b6326aa02b21" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{3}=\\frac{z-4}{-3},\\,y=3" :db/id #edb/ref 17592186367238} {:answer/id #uuid "436226e4-ccc7-5549-a37e-619085c7d8b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+2}{-3}=\\frac{z+4}{3},\\,y=3" :db/id #edb/ref 17592186367239}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{-3}=\\frac{z-4}{3},\\,y=-3" :db/id #edb/ref 17592186367236} :answer-field/id #uuid "9a274fbe-2021-5a82-a09f-93758010d602" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367234}] :question/id #uuid "43666961-35f3-5a27-98ac-9fa52e313883" :question/math-academy-id "q-127519" :question/problem "![](images/30/30299b98c822a5b06b332860bafbed4f465a4567a7135dc3257c4c9e40e490fa.png)\n\nFind a Cartesian equation of the line shown in the figure above." :question/worked-solution "We know that the line passes through the points $P(2,-3,4)$ and $Q(-1,-3,7).$ Now, we need to find a vector parallel to the given line. Let's consider the vector $\\overset{\\to }{PQ}$ which is given by\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨-1,-3,7⟩-⟨2,-3,4⟩ \\\\  & =⟨-3,0,3⟩.\\end{aligned}\n$$\n\nUsing the point $P$ and the vector $\\overset{\\to }{PQ}$, we have that the Cartesian (canonical) equation of the given line is given by\n\n$$\n\\frac{x-2}{-3}=\\frac{y-(-3)}{0}=\\frac{z-4}{3}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x-2}{-3}=\\frac{y+3}{0}=\\frac{z-4}{3}.\n$$\n\nBut the above equation is problematic because $\\frac{y+3}{0}$ involves division by zero.\n\nHowever, in our line, the $y$ component always maintains the constant value of $y=-3.$ For example, our two points $P(2,-3,4)$ and $Q(-1,-3,7)$ both have $y$-coordinates of $y=-3.$\n\nSo, in the Cartesian equation, we remove the $\\frac{y+3}{0}$ part and instead write $y=-3,$ as follows:\n\n$$\n\\frac{x-2}{-3}=\\frac{z-4}{3},\\,y=-3.\n$$"} {:db/id #edb/ref 17592186367240 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3103b7b1-e08e-5891-bfbe-c1ec2af0dff4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-1}{3}=\\frac{z+5}{4},\\,y=2" :db/id #edb/ref 17592186367242} {:answer/id #uuid "baaea110-f65c-5409-b3a2-13194827514b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+1}{3}=\\frac{z+5}{4},\\,y=-2" :db/id #edb/ref 17592186367243} {:answer/id #uuid "6d279abb-4007-52c2-895b-d690c7f724e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+1}{3}=\\frac{z-5}{4},\\,y=2" :db/id #edb/ref 17592186367244} {:answer/id #uuid "cbd346df-59be-5375-8f4c-15f188fbded5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-1}{3}=\\frac{z-5}{4},\\,y=-2" :db/id #edb/ref 17592186367245} {:answer/id #uuid "ffcdbe32-6592-5f2a-9fd5-bb2a8ba04aa1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-1}{3}=\\frac{z-5}{-4},\\,y=2" :db/id #edb/ref 17592186367246}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+1}{3}=\\frac{z-5}{4},\\,y=2" :db/id #edb/ref 17592186367244} :answer-field/id #uuid "b609bda9-e776-5fe4-a812-e5bedc6b3f93" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367241}] :question/id #uuid "26ccf3a9-18a6-5810-b58b-63343e2dbccc" :question/math-academy-id "q-127534" :question/problem "![](images/f6/f65a9806a2d6736a9eed283253225f6e5405d3e272f25e9c6a763651a19d0a31.png)\n\nFind a Cartesian equation of the line shown in the figure above." :question/worked-solution "We know that the line passes through the points $P(-1,2,5)$ and $Q(2,2,9).$ Now, we need to find a vector parallel to the given line. Let's consider the vector $\\overset{\\to }{PQ}$ which is given by\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨2,2,9⟩-⟨-1,2,5⟩ \\\\  & =⟨3,0,4⟩.\\end{aligned}\n$$\n\nUsing the point $P$ and the vector $\\overset{\\to }{PQ}$, we have that the Cartesian (canonical) equation of the given line is given by\n\n$$\n\\frac{x-(-1)}{3}=\\frac{y-2}{0}=\\frac{z-5}{4}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x+1}{3}=\\frac{y-2}{0}=\\frac{z-5}{4}.\n$$\n\nBut the above equation is problematic because $\\frac{y-2}{0}$ involves division by zero.\n\nHowever, in our line, the $y$ component always maintains the constant value of $y=2.$ For example, our two points $P(-1,2,5)$ and $Q(2,2,9)$ both have $y$-coordinates of $y=2.$\n\nSo, in the Cartesian equation, we remove the $\\frac{y-2}{0}$ part and instead write $y=2,$ as follows:\n\n$$\n\\frac{x+1}{3}=\\frac{z-5}{4},\\,y=2\n$$"} {:db/id #edb/ref 17592186367999 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b15c716-cbde-595b-8c59-a7d8e081e6c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{1}=\\frac{y+3}{1}=\\frac{z+1}{5}" :db/id #edb/ref 17592186368001} {:answer/id #uuid "6eb2b763-ef71-5c21-9c12-57eddaceaf97" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y-1}{-3}=\\frac{z-5}{-1},\\,x=1" :db/id #edb/ref 17592186368002} {:answer/id #uuid "b35a57ff-527b-515c-bca5-64aa7892ac0d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{1}=\\frac{y-3}{1}=\\frac{z-1}{5}" :db/id #edb/ref 17592186368003} {:answer/id #uuid "a42814c3-df86-50ab-aff0-06ba2330c62c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y}{-3}=\\frac{z}{-1},\\,x=0" :db/id #edb/ref 17592186368004} {:answer/id #uuid "9339064f-4403-5c08-9da4-3fbc56bdcfbc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y+1}{-3}=\\frac{z+5}{-1},\\,x=1" :db/id #edb/ref 17592186368005}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y-1}{-3}=\\frac{z-5}{-1},\\,x=1" :db/id #edb/ref 17592186368002} :answer-field/id #uuid "dca1df92-980b-52a2-ad45-60bbaa3a9574" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368000}] :question/id #uuid "be6815bf-65fc-565e-82b6-e6a1519243b7" :question/math-academy-id "q-32937" :question/problem "![](images/ea/eaef9d105cfaa71f84a47f12dac8375945be74dcf271e1451a8729cae9e2eb13.png)\n\nFind a Cartesian equation of the line shown in the figure above." :question/worked-solution "We know that the line passes through the points $P(1,1,5)$ and $Q(1,-2,4).$ Now, we need to find a vector parallel to the given line. Let's consider the vector $\\overset{\\to }{PQ}$ which is given by\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,-2,4⟩-⟨1,1,5⟩ \\\\  & =⟨0,-3,-1⟩.\\end{aligned}\n$$\n\nUsing the point $P$ and the vector $\\overset{\\to }{PQ}$, we have that the Cartesian (canonical) equation of the given line is given by\n\n$$\n\\frac{x-1}{0}=\\frac{y-1}{-3}=\\frac{z-5}{-1}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x-1}{0}=\\frac{y-1}{-3}=\\frac{z-5}{-1}.\n$$\n\nBut the above equation is problematic because $\\frac{x-1}{0}$ involves division by zero.\n\nHowever, in our line, the $x$ component always maintains the constant value of $x=1.$ For example, our two points $P(1,1,5)$ and $Q(1,-2,4)$ both have $x$-coordinates of $x=1.$\n\nSo, in the Cartesian equation, we remove the $\\frac{x-1}{0}$ part and instead write $x=1,$ as follows:\n\n$$\n\\frac{y-1}{-3}=\\frac{z-5}{-1},\\,x=1.\n$$"} {:db/id #edb/ref 17592186413267 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f85a2de-8936-53e9-b4c3-0d80c357fcab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+7}{-3}=\\frac{y-1}{1}=\\frac{z}{-4}" :db/id #edb/ref 17592186413224} {:answer/id #uuid "83bd26ba-9b94-5213-87dd-4f816b559e83" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+7}{-3}=\\frac{y+1}{1}=\\frac{z}{4}" :db/id #edb/ref 17592186413228} {:answer/id #uuid "b23463d1-7983-5832-a155-38676beb3e86" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-7}{-3}=\\frac{y+1}{1}=\\frac{z}{-4}" :db/id #edb/ref 17592186413239} {:answer/id #uuid "e3b20a42-f8fc-5421-82ef-f6666475bd47" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-7}{3}=\\frac{y+1}{4}=\\frac{z}{4}" :db/id #edb/ref 17592186413248} {:answer/id #uuid "e7220639-4d6c-573b-b6b7-5fc1ded2cead" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-7}{3}=\\frac{y+1}{1}=\\frac{z}{4}" :db/id #edb/ref 17592186413249}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-7}{-3}=\\frac{y+1}{1}=\\frac{z}{-4}" :db/id #edb/ref 17592186413239} :answer-field/id #uuid "8c9478fb-99b4-566d-b0ee-d81368042926" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413261}] :question/id #uuid "999b5494-410f-5564-a5e2-d9dbe0ae34c9" :question/math-academy-id "q-127464" :question/problem "Find a Cartesian equation of the straight line that passes through $P(7,-1,0)$ and is parallel to $v=⟨-3,1,-4⟩.$" :question/worked-solution "Remember that the Cartesian (canonical) equation of the straight line that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is parallel to the vector $v=⟨{v}_{x},{v}_{y},{v}_{z}⟩$, is given by\n\n$$\n\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nSo, we have\n\n$$\n\\frac{x-7}{-3}=\\frac{y-(-1)}{1}=\\frac{z-0}{-4}=t,\\,t\\in (-\\infty ,\\infty )\n$$\n\nor, equivalently,\n\n$$\n\\frac{x-7}{-3}=\\frac{y+1}{1}=\\frac{z}{-4}.\n$$"} {:db/id #edb/ref 17592186447025 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34899314-00b5-5497-adbb-b71a1ac21237" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-1}{4}=\\frac{y-3}{-4}=\\frac{z-7}{6}" :db/id #edb/ref 17592186447013} {:answer/id #uuid "3aff6a90-29cb-5fbb-a280-7d4c79fc7881" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+1}{4}=\\frac{y+3}{4}=\\frac{z-7}{6}" :db/id #edb/ref 17592186447014} {:answer/id #uuid "6083d104-e8d5-54a9-91d4-825774ce35f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-1}{-4}=\\frac{y-3}{-4}=\\frac{z+7}{-6}" :db/id #edb/ref 17592186447016} {:answer/id #uuid "a3f8e739-90fc-54a0-8ff2-caa9d9c9da58" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-1}{-6}=\\frac{y+3}{4}=\\frac{z-7}{-4}" :db/id #edb/ref 17592186447019} {:answer/id #uuid "e6c04908-246a-5ae0-92f2-f471b0d7a518" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+1}{4}=\\frac{y-3}{-4}=\\frac{z-7}{-6}" :db/id #edb/ref 17592186447021}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+1}{4}=\\frac{y-3}{-4}=\\frac{z-7}{-6}" :db/id #edb/ref 17592186447021} :answer-field/id #uuid "58349fdc-d11c-5b54-9386-0a54b8d936ea" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186447023}] :question/id #uuid "61ab7a4c-ae26-516b-9967-3f8072e6be8b" :question/math-academy-id "q-127468" :question/problem "![](images/01/01943e80947c833ef37241fb836db96afd61731b9873cd061277a7453b34f3d8.png)\n\nFind a Cartesian equation of the line shown in the figure above." :question/worked-solution "We know that the line passes through the points $P(-1,3,7)$ and $Q(3,-1,1).$ Now, we need to find a vector parallel to the given line. Let's consider the vector $\\overset{\\to }{PQ}$ which is given by\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨3,-1,1⟩-⟨-1,3,7⟩ \\\\  & =⟨4,-4,-6⟩.\\end{aligned}\n$$\n\nUsing the point $P$ and the vector $\\overset{\\to }{PQ}$, we have that the Cartesian (canonical) equation of the given line is given by\n\n$$\n\\frac{x-(-1)}{4}=\\frac{y-3}{-4}=\\frac{z-7}{-6}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x+1}{4}=\\frac{y-3}{-4}=\\frac{z-7}{-6}.\n$$"}] :knowledge-point/title "Finding the Cartesian Equation of a Line Given Two Points on the Line"} {:db/id #edb/ref 17592186119842 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119656 :question/id #uuid "74fb2af1-d791-5687-98cc-0b2db5bd8464" :question/math-academy-id "e-5021" :question/problem "Find the Cartesian equation for the line with the following vector equation:\n\n![](images/5c/5cb83f5140e0f687997fea631f78bb9d5cf7d6cbeef52fe746f4abcba9230a1a.svg)" :question/worked-solution "Using the usual formula, we get\n\n$$\n\\dfrac{x-1}{4}=\\dfrac{y-2}{0}=\\dfrac{z-3}{5} = t,\t\\qquad t \\in (-\\infty,\\infty),\n$$\n\nor equivalently\n\n$$\n\\dfrac{x-1}{4}=\\dfrac{y-2}{0}=\\dfrac{z-3}{5},\n$$\n\nwhich is problematic because $\\dfrac{y-2}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $y$ component always maintains the constant value of $y=2\\mathbin{:}$\n\n![](images/19/1998dafc905e62617ac4c8f57285a0d75cf0ef8bddf1e59be7eeea9149485017.svg)\n\nSo, in the Cartesian equation, we remove the $\\dfrac{y-2}{0}$ part and instead write $y=2,$ as follows:\n\n$$\n\\dfrac{x-1}{4}=\\dfrac{z-3}{5}, \\; y=2\n$$"} :knowledge-point/id #uuid "07c209a4-5c69-561e-9015-28b0f6e436e5" :knowledge-point/questions [{:db/id #edb/ref 17592186120506 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a901e00-4252-5cf9-b50c-8893fcb829e9" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186119151} {:answer/id #uuid "abbd4785-c8dc-50a2-be07-f1eb6893222e" :answer/type {:db/ident :answer.type/math} :answer/value "-x = \\frac{y - 2}{1}, z =-1" :db/id #edb/ref 17592186119152} {:answer/id #uuid "e119e113-a4c0-584f-9f11-17fe5d0b1a7b" :answer/type {:db/ident :answer.type/math} :answer/value "x = \\frac{y - 1}{2} =-z" :db/id #edb/ref 17592186119153} {:answer/id #uuid "71528ca6-7a70-59a0-9b5d-8a8f4816dab0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y - 1}{2} =-z, x =-1" :db/id #edb/ref 17592186119154} {:answer/id #uuid "7a38b494-2053-5910-85da-23542283aa10" :answer/type {:db/ident :answer.type/math} :answer/value "x + 1 = \\frac{y - 1}{2} =-z" :db/id #edb/ref 17592186119155}] :answer-field/id #uuid "2f354396-1623-5d78-92fe-a7def331ac1f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186119150} {:answer-field/choices [{:answer/id #uuid "f348ab2b-70ba-5d55-a038-1c2b971bae5b" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186368670} {:answer/id #uuid "4b489027-ff1d-5463-ab8c-dd167ba0d700" :answer/type {:db/ident :answer.type/math} :answer/value "-x=\\frac{y-2}{1},\\,z=-1" :db/id #edb/ref 17592186368671} {:answer/id #uuid "610d18c7-3941-5814-b7ec-e0be41696393" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y-1}{2}=-z,\\,x=-1" :db/id #edb/ref 17592186368672} {:answer/id #uuid "7c80d818-a51e-5a06-9a27-142460430c64" :answer/type {:db/ident :answer.type/math} :answer/value "x+1=\\frac{y-1}{2}=-z" :db/id #edb/ref 17592186368673} {:answer/id #uuid "4405ea39-6ccf-5364-9088-7dbb9d9a5f38" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{y-1}{2}=-z" :db/id #edb/ref 17592186368674}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y-1}{2}=-z,\\,x=-1" :db/id #edb/ref 17592186368672} :answer-field/id #uuid "adf6930c-774a-5b1f-b8be-4a33d604e6b6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368669}] :question/id #uuid "9ba33a02-c52b-5c65-80c6-40fc93de31d0" :question/math-academy-id "q-70641" :question/problem "Find the Cartesian equation for the line with the following vector equation:\n\n$$\nr=\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}+t\\begin{bmatrix}0 \\\\ 2 \\\\ -1\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$" :question/worked-solution "Using the usual formula, we get\n\n$$\n\\frac{x-(-1)}{0}=\\frac{y-1}{2}=\\frac{z-0}{-1}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x+1}{0}=\\frac{y-1}{2}=-z,\n$$\n\nwhich is problematic because $\\frac{x+1}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $x$ component always maintains the constant value of $x=-1:$\n\n$$\nr=\\begin{bmatrix}-1 \\\\ 1+2t \\\\ -t\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$\n\nSo, in the Cartesian equation, we remove the $\\frac{x+1}{0}$ part and instead write $x=-1,$ as follows:\n\n$$\n\\frac{y-1}{2}=-z,\\,x=-1\n$$"} {:db/id #edb/ref 17592186120507 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b4e7205-f67a-57f1-9421-8709172590cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x - 2}{5} = 1 - z, y = 7" :db/id #edb/ref 17592186119157} {:answer/id #uuid "dc0a7526-9653-567c-b508-b0d06d365ae9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{2} = \\frac{y}{7} = z" :db/id #edb/ref 17592186119158} {:answer/id #uuid "f2c2b876-4001-5dc0-909f-c8ad44972eb4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x - 5}{2} = z + 1, y = 7" :db/id #edb/ref 17592186119159} {:answer/id #uuid "fc7fed59-9756-5f46-b1db-d636211125fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x - 5}{2} = \\frac{y}{7} = z + 1" :db/id #edb/ref 17592186119160} {:answer/id #uuid "7b28fa96-6cde-5f01-b15a-91fa1745fa1c" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186119161}] :answer-field/id #uuid "32a92497-54d1-5d47-a714-b01cb8ae2dc7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186119156} {:answer-field/choices [{:answer/id #uuid "a304ad73-cab0-59ef-94dc-5f4aac383a0f" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186368676} {:answer/id #uuid "6704f947-0562-5389-88dd-43ed0ffbbc22" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-5}{2}=z+1,\\,y=7" :db/id #edb/ref 17592186368677} {:answer/id #uuid "2463237a-fbfa-5a70-89a2-92cefb3b0e5b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{5}=1-z,\\,y=7" :db/id #edb/ref 17592186368678} {:answer/id #uuid "60a57791-18a7-556f-b735-9f83aaeb2f70" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{2}=\\frac{y}{7}=z" :db/id #edb/ref 17592186368679} {:answer/id #uuid "865c2b8d-ac82-533c-a1e4-6bfe142583f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-5}{2}=\\frac{y}{7}=z+1" :db/id #edb/ref 17592186368680}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{5}=1-z,\\,y=7" :db/id #edb/ref 17592186368678} :answer-field/id #uuid "ae28f01d-b549-50bc-9079-5fda0fd0cc3a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368675}] :question/id #uuid "d88a4b51-1e9a-5af3-83ea-5b80605aa534" :question/math-academy-id "q-70643" :question/problem "Find the Cartesian equation for the line with the following vector equation:\n\n$$\nr=\\begin{bmatrix}2 \\\\ 7 \\\\ 1\\end{bmatrix}+t\\begin{bmatrix}5 \\\\ 0 \\\\ -1\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$" :question/worked-solution "Using the usual formula, we get\n\n$$\n\\frac{x-2}{5}=\\frac{y-7}{0}=\\frac{z-1}{-1}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x-2}{5}=\\frac{y-7}{0}=1-z,\n$$\n\nwhich is problematic because $\\frac{y-7}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $y$ component always maintains the constant value of $y=7:$\n\n$$\nr=\\begin{bmatrix}2+5t \\\\ 7 \\\\ 1-t\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$\n\nSo, in the Cartesian equation, we remove the $\\frac{y-7}{0}$ part and instead write $y=7$, as follows:\n\n$$\n\\frac{x-2}{5}=1-z,\\,y=7\n$$"} {:db/id #edb/ref 17592186262771 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2418fd2f-cf94-51c5-870f-9e69b0cc59ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-3}{3}=\\frac{z-1}{-2},\\,y=-2" :db/id #edb/ref 17592186260189} {:answer/id #uuid "472da51d-3ad2-5f02-87f9-097b58c4174a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+3}{-3}=\\frac{z-1}{2},\\,y=2" :db/id #edb/ref 17592186260492} {:answer/id #uuid "750de7cc-bebe-57c3-8f4d-8894d05ae184" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+3}{3}=\\frac{z+1}{-2},\\,y=-2" :db/id #edb/ref 17592186260898} {:answer/id #uuid "a1d33418-0680-559c-ba7f-3012dda070c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+3}{3}=\\frac{z-1}{-2},\\,y=2" :db/id #edb/ref 17592186261284} {:answer/id #uuid "b692c332-2daf-54c3-8a62-83f3c0264314" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-3}{3}=\\frac{z+1}{-2},\\,y=2" :db/id #edb/ref 17592186261479}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+3}{3}=\\frac{z-1}{-2},\\,y=2" :db/id #edb/ref 17592186261284} :answer-field/id #uuid "70e56adf-2801-51c2-8381-f319258c00a6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262310}] :question/id #uuid "e6785113-167d-5ac5-98f2-6f3b20077026" :question/math-academy-id "q-127412" :question/problem "Find the Cartesian equation for the line with the following vector equation:\n\n$$\nr=\\begin{bmatrix}-3 \\\\ 2 \\\\ 1\\end{bmatrix}+t\\begin{bmatrix}3 \\\\ 0 \\\\ -2\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$" :question/worked-solution "Using the usual formula, we get\n\n$$\n\\frac{x-(-3)}{3}=\\frac{y-2}{0}=\\frac{z-1}{-2}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x+3}{3}=\\frac{y-2}{0}=\\frac{z-1}{-2},\n$$\n\nwhich is problematic because $\\frac{y-2}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $y$ component always maintains the constant value of $y=2:$\n\n$$\nr=\\begin{bmatrix}-3+3t \\\\ 2 \\\\ 1-2t\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$\n\nSo, in the Cartesian equation, we remove the $\\frac{y-2}{0}$ part and instead write $y=2,$ as follows:\n\n$$\n\\frac{x+3}{3}=\\frac{z-1}{-2},\\,y=2\n$$"} {:db/id #edb/ref 17592186262774 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e3012f4-0f16-5e89-a57e-3fda5fefd0d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-3}{7}=\\frac{z}{2},\\,y=5" :db/id #edb/ref 17592186260007} {:answer/id #uuid "59250e7e-0cc1-59aa-badb-e267dbd5b96d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-3}{7}=\\frac{z-2}{1},\\,y=5" :db/id #edb/ref 17592186260636} {:answer/id #uuid "5ff911b7-cf81-5f4e-bd66-a8f69e551b29" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+3}{7}=\\frac{z}{2},\\,y=5" :db/id #edb/ref 17592186260705} {:answer/id #uuid "69aca3d6-1ef4-5e05-b053-4667d30d8d92" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-3}{7}=\\frac{z-2}{2},\\,y=5" :db/id #edb/ref 17592186260799} {:answer/id #uuid "8d6132d8-eb35-5131-823e-2cee5de2316b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+3}{2}=\\frac{z}{7},\\,y=5" :db/id #edb/ref 17592186261111}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+3}{7}=\\frac{z}{2},\\,y=5" :db/id #edb/ref 17592186260705} :answer-field/id #uuid "393f9b0c-bf5c-5bb2-93a1-37868fcb5583" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262226}] :question/id #uuid "5ca9c758-73dc-58e9-9495-123d55df1262" :question/math-academy-id "q-127454" :question/problem "Find the Cartesian equation for the line with the following vector equation:\n\n$$\nr=\\begin{bmatrix}-3 \\\\ 5 \\\\ 0\\end{bmatrix}+t\\begin{bmatrix}7 \\\\ 0 \\\\ 2\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$" :question/worked-solution "Using the usual formula, we get\n\n$$\n\\frac{x-(-3)}{7}=\\frac{y-5}{0}=\\frac{z}{2}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x+3}{7}=\\frac{y-5}{0}=\\frac{z}{2},\n$$\n\nwhich is problematic because $\\frac{y-5}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $y$ component always maintains the constant value of $y=5:$\n\n$$\nr=\\begin{bmatrix}-3+7t \\\\ 5 \\\\ 2t\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$\n\nSo, in the Cartesian equation, we remove the $\\frac{y-5}{0}$ part and instead write $y=5$, as follows:\n\n$$\n\\frac{x+3}{7}=\\frac{z}{2},\\,y=5\n$$"} {:db/id #edb/ref 17592186262775 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5be670e7-2ab2-527d-909a-8e2f7fc00424" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-3}{5}=\\frac{y}{2},\\,z=2" :db/id #edb/ref 17592186260658} {:answer/id #uuid "652eaaf1-fd04-5d1b-b0a6-fdc60b637ae8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+3}{-5}=\\frac{y}{1},\\,z=2" :db/id #edb/ref 17592186260749} {:answer/id #uuid "b484127c-930f-591f-9d20-97a0dd558b1c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-3}{-5}=\\frac{y}{1},\\,z=-2" :db/id #edb/ref 17592186261463} {:answer/id #uuid "b72e778f-692e-5bff-a68d-0fa253eb4011" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-5}{-3}=\\frac{y}{1},\\,z=-2" :db/id #edb/ref 17592186261484} {:answer/id #uuid "fc104857-9e6a-5caf-804c-015a8eff2e3b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-3}{5}=\\frac{y}{-1},\\,z=-2" :db/id #edb/ref 17592186262080}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-3}{-5}=\\frac{y}{1},\\,z=-2" :db/id #edb/ref 17592186261463} :answer-field/id #uuid "83cecc4e-aa94-547e-b5b4-701d63eb0673" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262348}] :question/id #uuid "bc58b647-06b9-513c-a89e-a6d58119d8ec" :question/math-academy-id "q-127461" :question/problem "Find the Cartesian equation for the line with the following vector equation:\n\n$$\nr=\\begin{bmatrix}3 \\\\ 0 \\\\ -2\\end{bmatrix}+t\\begin{bmatrix}-5 \\\\ 1 \\\\ 0\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$" :question/worked-solution "Using the usual formula, we get\n\n$$\n\\frac{x-3}{-5}=\\frac{y-0}{1}=\\frac{z-(-2)}{0}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x-3}{-5}=\\frac{y}{1}=\\frac{z+2}{0},\n$$\n\nwhich is problematic because $\\frac{z+2}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $z$ component always maintains the constant value of $z=-2:$\n\n$$\nr=\\begin{bmatrix}3-5t \\\\ t \\\\ -2\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$\n\nSo, in the Cartesian equation, we remove the $\\frac{z+2}{0}$ part and instead write $z=-2,$ as follows:\n\n$$\n\\frac{x-3}{-5}=\\frac{y}{1},\\,z=-2\n$$"} {:db/id #edb/ref 17592186338880 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e0b4186-9928-58b4-8819-35423e1e0068" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y-6}{10}=\\frac{z+2}{3},\\,x=-3" :db/id #edb/ref 17592186336310} {:answer/id #uuid "50820664-a7f6-5b55-9476-029673b80c78" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{-3}=\\frac{y-10}{6}=\\frac{z-3}{-2}" :db/id #edb/ref 17592186336771} {:answer/id #uuid "933a9135-02ba-5925-965d-ddb23e164c75" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y+6}{10}=\\frac{z-2}{3},\\,x=3" :db/id #edb/ref 17592186337373} {:answer/id #uuid "de1fd4dc-f550-5479-9beb-f535161eede1" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186337963} {:answer/id #uuid "fa860762-e327-5c0a-92c1-afb3900761b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{-3}=\\frac{y+10}{6}=\\frac{z+3}{-2}" :db/id #edb/ref 17592186338228}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y-6}{10}=\\frac{z+2}{3},\\,x=-3" :db/id #edb/ref 17592186336310} :answer-field/id #uuid "1a12a0a6-eca3-5324-87ae-e350ea1c6ee0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338324}] :question/id #uuid "d55a1be6-a075-557b-b7ae-a0512fb81218" :question/math-academy-id "q-71035" :question/problem "Find the Cartesian equation for the line with the following vector equation:\n\n$$\nr=\\begin{bmatrix}-3 \\\\ 6 \\\\ -2\\end{bmatrix}+t\\begin{bmatrix}0 \\\\ 10 \\\\ 3\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$" :question/worked-solution "Using the usual formula, we get\n\n$$\n\\frac{x-(-3)}{0}=\\frac{y-6}{10}=\\frac{z-(-2)}{3}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x+3}{0}=\\frac{y-6}{10}=\\frac{z+2}{3},\n$$\n\nwhich is problematic because $\\frac{x+3}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $x$ component always maintains the constant value of $x=-3:$\n\n$$\nr=\\begin{bmatrix}-3 \\\\ 6+10t \\\\ -2+3t\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$\n\nSo, in the Cartesian equation, we remove the $\\frac{x+3}{0}$ part and instead write $x=-3$, as follows:\n\n$$\n\\frac{y-6}{10}=\\frac{z+2}{3},\\,x=-3\n$$"} {:db/id #edb/ref 17592186338882 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c0fb049-79eb-55e2-a0ca-4fdfc5e2665f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-7}{-3}=\\frac{y+9}{2},\\,z=11" :db/id #edb/ref 17592186336144} {:answer/id #uuid "aaeb2205-47f3-5952-a1db-f53aaf324af1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+3}{7}=\\frac{y-2}{-9},\\,z=0" :db/id #edb/ref 17592186337572} {:answer/id #uuid "bf5d36b6-450f-5f52-a838-c89ca6718db3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-7}{-3}=z-11,\\,y=-9" :db/id #edb/ref 17592186337732} {:answer/id #uuid "c8b304a4-4128-55d7-9b97-804366ca23bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+7}{-3}=\\frac{y-9}{2},\\,z=-11" :db/id #edb/ref 17592186337806} {:answer/id #uuid "d10667a1-fec6-59c1-a83d-dc77b0c42b34" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-7}{-3}=\\frac{y+9}{2}=z-11" :db/id #edb/ref 17592186337862}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-7}{-3}=\\frac{y+9}{2},\\,z=11" :db/id #edb/ref 17592186336144} :answer-field/id #uuid "1f571153-e1e5-51d4-9174-5e999fd92b23" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338335}] :question/id #uuid "4f24fb14-8cf2-586c-8b58-d1952f0a20ca" :question/math-academy-id "q-71039" :question/problem "Find the Cartesian equation for the line with the following vector equation:\n\n$$\nr=\\begin{bmatrix}7 \\\\ -9 \\\\ 11\\end{bmatrix}+t\\begin{bmatrix}-3 \\\\ 2 \\\\ 0\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$" :question/worked-solution "Using the usual formula, we get\n\n$$\n\\frac{x-7}{-3}=\\frac{y-(-9)}{2}=\\frac{z-11}{0}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x-7}{-3}=\\frac{y+9}{2}=\\frac{z-11}{0},\n$$\n\nwhich is problematic because $\\frac{z-11}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $z$ component always maintains the constant value of $z=11:$\n\n$$\nr=\\begin{bmatrix}7-3t \\\\ -9+2t \\\\ 11\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$\n\nSo, in the Cartesian equation, we remove the $\\frac{z-11}{0}$ part and instead write $z=11$, as follows:\n\n$$\n\\frac{x-7}{-3}=\\frac{y+9}{2},\\,z=11\n$$"} {:db/id #edb/ref 17592186338884 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2567963f-2cc6-52cf-b845-e0d51f4246ef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y-5}{-2}=z,\\,x=-3" :db/id #edb/ref 17592186336383} {:answer/id #uuid "3f907a6d-9b42-5214-a279-86d8fe1de371" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y+5}{-2}=z,\\,x=3" :db/id #edb/ref 17592186336632} {:answer/id #uuid "c6a12f01-4a5c-5a25-ae45-fc1c3b9d66fc" :answer/type {:db/ident :answer.type/math} :answer/value "x+3=\\frac{y-5}{-2}=z" :db/id #edb/ref 17592186337792} {:answer/id #uuid "d78683f9-425a-5529-9f03-f2cb98be88ba" :answer/type {:db/ident :answer.type/math} :answer/value "x+3=z,\\,y=5" :db/id #edb/ref 17592186337902} {:answer/id #uuid "f64f0c09-f1c4-5e93-b607-0a22fd47497c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{-3}=\\frac{y+2}{5},\\,z=1" :db/id #edb/ref 17592186338191}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y-5}{-2}=z,\\,x=-3" :db/id #edb/ref 17592186336383} :answer-field/id #uuid "4875ced2-2052-58ba-b648-2c73d105e218" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338405}] :question/id #uuid "d233ae73-bff2-5bf6-9358-0d6b2127bfa5" :question/math-academy-id "q-71045" :question/problem "Find the Cartesian equation for the line with the following vector equation:\n\n$$\nr=\\begin{bmatrix}-3 \\\\ 5 \\\\ 0\\end{bmatrix}+t\\begin{bmatrix}0 \\\\ -2 \\\\ 1\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$" :question/worked-solution "Using the usual formula, we get\n\n$$\n\\frac{x-(-3)}{0}=\\frac{y-5}{-2}=\\frac{z-0}{1}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x+3}{0}=\\frac{y-5}{-2}=z,\n$$\n\nwhich is problematic because $\\frac{x+3}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $x$ component always maintains the constant value of $x=-3:$\n\n$$\nr=\\begin{bmatrix}-3 \\\\ 5-2t \\\\ t\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$\n\nSo, in the Cartesian equation, we remove the $\\frac{x+3}{0}$ part and instead write $x=-3,$ as follows:\n\n$$\n\\frac{y-5}{-2}=z,\\,x=-3\n$$"} {:db/id #edb/ref 17592186338885 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d62ea8b-6e9e-5022-91fe-53a644c300c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+3}{7}=\\frac{y-1}{-3},\\,z=-6" :db/id #edb/ref 17592186336878} {:answer/id #uuid "66acea60-d3a4-5ac0-8ea0-7c9fbe25b6b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+7}{3}=\\frac{y-3}{-1},\\,z=0" :db/id #edb/ref 17592186336948} {:answer/id #uuid "723fd5ed-33ed-5428-814e-1d3978a8c781" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-3}{7}=\\frac{y+1}{-3}=z-6" :db/id #edb/ref 17592186337055} {:answer/id #uuid "76f3443d-ef8a-5477-b57b-73c45cafa5bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-7}{3}=\\frac{y+3}{-1},\\,z=0" :db/id #edb/ref 17592186337102} {:answer/id #uuid "d5f9d917-fd3b-5507-b0e2-5b54f65a6141" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-3}{7}=\\frac{y+1}{-3},\\,z=6" :db/id #edb/ref 17592186337895}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-3}{7}=\\frac{y+1}{-3},\\,z=6" :db/id #edb/ref 17592186337895} :answer-field/id #uuid "6457376e-bcd6-51d2-af91-27301347c726" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338455}] :question/id #uuid "2a6a8e27-9a19-5fb3-94f8-af73e4c67f56" :question/math-academy-id "q-71048" :question/problem "Find the Cartesian equation for the line with the following vector equation:\n\n$$\nr=\\begin{bmatrix}3 \\\\ -1 \\\\ 6\\end{bmatrix}+t\\begin{bmatrix}7 \\\\ -3 \\\\ 0\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$" :question/worked-solution "Using the usual formula, we get\n\n$$\n\\frac{x-3}{7}=\\frac{y-(-1)}{-3}=\\frac{z-6}{0}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x-3}{7}=\\frac{y+1}{-3}=\\frac{z-6}{0},\n$$\n\nwhich is problematic because $\\frac{z-6}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $z$ component always maintains the constant value of $z=6:$\n\n$$\nr=\\begin{bmatrix}3+7t \\\\ -1-3t \\\\ 6\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$\n\nSo, in the Cartesian equation, we remove the $\\frac{z-6}{0}$ part and instead write $z=6$, as follows:\n\n$$\n\\frac{x-3}{7}=\\frac{y+1}{-3},\\,z=6\n$$"} {:db/id #edb/ref 17592186368681 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9ac49e3-5aee-598a-87f7-b5836f8d60b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{3}=\\frac{y}{4},\\,z=1" :db/id #edb/ref 17592186368683} {:answer/id #uuid "bb05d174-588a-5700-a83d-5e449d76fc60" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186368684} {:answer/id #uuid "29c0b402-d863-5bbf-a62f-a424e72ac2d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+2}{3}=\\frac{y}{4},\\,z=-1" :db/id #edb/ref 17592186368685} {:answer/id #uuid "b58a06e5-6b00-50ce-8d26-0c23fb04832b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y}{4}=\\frac{z-2}{3},\\,x=1" :db/id #edb/ref 17592186368686} {:answer/id #uuid "92634e32-6601-549e-96d9-d7542dbf3b94" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{3}=\\frac{y}{4}=z-1" :db/id #edb/ref 17592186368687}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{3}=\\frac{y}{4},\\,z=1" :db/id #edb/ref 17592186368683} :answer-field/id #uuid "3ec73e88-eb46-554e-b469-aaad76c763e1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368682}] :question/id #uuid "9c2631fa-2b0b-5756-91ea-ab3dc5ef565c" :question/math-academy-id "q-71032" :question/problem "Find the Cartesian equation for the line with the following vector equation:\n\n$$\nr=\\begin{bmatrix}2 \\\\ 0 \\\\ 1\\end{bmatrix}+t\\begin{bmatrix}3 \\\\ 4 \\\\ 0\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$" :question/worked-solution "Using the usual formula, we get\n\n$$\n\\frac{x-2}{3}=\\frac{y-0}{4}=\\frac{z-1}{0}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x-2}{3}=\\frac{y}{4}=\\frac{z-1}{0},\n$$\n\nwhich is problematic because $\\frac{z-1}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $z$ component always maintains the constant value of $z=1:$\n\n$$\nr=\\begin{bmatrix}2+3t \\\\ 4t \\\\ 1\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$\n\nSo, in the Cartesian equation, we remove the $\\frac{z-1}{0}$ part and instead write $z=1,$ as follows:\n\n$$\n\\frac{x-2}{3}=\\frac{y}{4},\\,z=1\n$$"} {:db/id #edb/ref 17592186413266 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ac0ca21-0772-5ea6-97f1-1ae436ee1c38" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{4}=z-4,\\,y=-3" :db/id #edb/ref 17592186413207} {:answer/id #uuid "44b3c7a8-f3fd-53ad-a5d7-8900d29452ba" :answer/type {:db/ident :answer.type/math} :answer/value "y+3=z-4,\\,x=4" :db/id #edb/ref 17592186413215} {:answer/id #uuid "a2bbe4bc-2ddb-59a9-9664-3eeab65c327b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{4}=y+3,\\,z=4" :db/id #edb/ref 17592186413234} {:answer/id #uuid "f7eac140-f9de-54fe-86ec-955c3fb09f92" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{4}=z+4,\\,y=3" :db/id #edb/ref 17592186413252} {:answer/id #uuid "fa24ccde-ab5e-541d-abe5-1fc41302c9db" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{4}=y+3=z-4" :db/id #edb/ref 17592186413254}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{4}=z-4,\\,y=-3" :db/id #edb/ref 17592186413207} :answer-field/id #uuid "02ce321d-f42c-5876-8f33-0ad24f21e148" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413255}] :question/id #uuid "2f4d4cbd-f2d7-5e35-a92b-2f2fb49fe824" :question/math-academy-id "q-71037" :question/problem "Find the Cartesian equation for the line with the following vector equation:\n\n$$\nr=\\begin{bmatrix}0 \\\\ -3 \\\\ 4\\end{bmatrix}+t\\begin{bmatrix}4 \\\\ 0 \\\\ 1\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$" :question/worked-solution "Using the usual formula, we get\n\n$$\n\\frac{x-0}{4}=\\frac{y-(-3)}{0}=\\frac{z-4}{1}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x}{4}=\\frac{y+3}{0}=z-4,\n$$\n\nwhich is problematic because $\\frac{y+3}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $y$ component always maintains the constant value of $y=-3:$\n\n$$\nr=\\begin{bmatrix}4t \\\\ -3 \\\\ 4+t\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$\n\nSo, in the Cartesian equation, we remove the $\\frac{y+3}{0}$ part and instead write $y=-3,$ as follows:\n\n$$\n\\frac{x}{4}=z-4,\\,y=-3\n$$"} {:db/id #edb/ref 17592186413271 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91610606-a3e0-593c-bcc2-39d39446b5f2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y+2}{-5}=\\frac{z}{1},\\,x=7" :db/id #edb/ref 17592186413231} {:answer/id #uuid "a040e97c-8a79-5509-87c0-8255b799a192" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y+2}{1}=\\frac{z}{-5},\\,x=7" :db/id #edb/ref 17592186413233} {:answer/id #uuid "af79ec3c-58c8-52c7-bd5a-209a42167d84" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y-2}{1}=\\frac{z}{5},\\,x=7" :db/id #edb/ref 17592186413237} {:answer/id #uuid "b014a37f-26e2-5e8b-b252-a864ef58a225" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y+1}{2}=\\frac{z}{5},\\,x=7" :db/id #edb/ref 17592186413238} {:answer/id #uuid "c3db7411-e481-5335-9ae6-c020ef03327f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y-2}{1}=\\frac{z}{-5},\\,x=-7" :db/id #edb/ref 17592186413244}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y+2}{1}=\\frac{z}{-5},\\,x=7" :db/id #edb/ref 17592186413233} :answer-field/id #uuid "8b5ed977-dd6d-5306-bb26-25955c268564" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413260}] :question/id #uuid "dbddc051-609a-50f8-b7fd-7c6e4c6d692b" :question/math-academy-id "q-127459" :question/problem "Find the Cartesian equation for the line with the following vector equation:\n\n$$\nr=\\begin{bmatrix}7 \\\\ -2 \\\\ 0\\end{bmatrix}+t\\begin{bmatrix}0 \\\\ 1 \\\\ -5\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$" :question/worked-solution "Using the usual formula, we get\n\n$$\n\\frac{x-7}{0}=\\frac{y-(-2)}{1}=\\frac{z-0}{-5}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x-7}{0}=\\frac{y+2}{1}=\\frac{z}{-5},\n$$\n\nwhich is problematic because $\\frac{x-7}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $x$ component always maintains the constant value of $x=7:$\n\n$$\nr=\\begin{bmatrix}7 \\\\ -2+t \\\\ -5t\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$\n\nSo, in the Cartesian equation, we remove the $\\frac{x-7}{0}$ part and instead write $x=7,$ as follows:\n\n$$\n\\frac{y+2}{1}=\\frac{z}{-5},\\,x=7\n$$"} {:db/id #edb/ref 17592186413272 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03a0481f-9850-51a2-93a8-9cb1375be70e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-1}{-5}=\\frac{y+6}{2},\\,z=13" :db/id #edb/ref 17592186413205} {:answer/id #uuid "13aa6270-4f47-57d9-96d5-e04d9559c1dd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+1}{2}=\\frac{y+6}{5},\\,z=-13" :db/id #edb/ref 17592186413208} {:answer/id #uuid "5147f586-12cc-5846-9c2a-91a6e6aae45a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{-1}=\\frac{y+6}{5},\\,z=13" :db/id #edb/ref 17592186413219} {:answer/id #uuid "b5633467-6d30-59cb-a103-1df0f479fc35" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-1}{-2}=\\frac{y+6}{5},\\,z=13" :db/id #edb/ref 17592186413240} {:answer/id #uuid "ebf8ec86-3cc9-58ca-b77d-738394e52afc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-1}{-2}=\\frac{y+5}{6},\\,z=-13" :db/id #edb/ref 17592186413251}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-1}{-2}=\\frac{y+6}{5},\\,z=13" :db/id #edb/ref 17592186413240} :answer-field/id #uuid "8dace27d-7465-57cd-b6cc-1a69b60f0f81" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413262}] :question/id #uuid "e1761a52-f68d-5dfd-83a7-02fd5760a09e" :question/math-academy-id "q-127460" :question/problem "Find the Cartesian equation for the line with the following vector equation:\n\n$$\nr=\\begin{bmatrix}1 \\\\ -6 \\\\ 13\\end{bmatrix}+t\\begin{bmatrix}-2 \\\\ 5 \\\\ 0\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$" :question/worked-solution "Using the usual formula, we get\n\n$$\n\\frac{x-1}{-2}=\\frac{y-(-6)}{5}=\\frac{z-13}{0}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x-1}{-2}=\\frac{y+6}{5}=\\frac{z-13}{0},\n$$\n\nwhich is problematic because $\\frac{z-13}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $z$ component always maintains the constant value of $z=13:$\n\n$$\nr=\\begin{bmatrix}1-2t \\\\ -6+5t \\\\ 13\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$\n\nSo, in the Cartesian equation, we remove the $\\frac{z-13}{0}$ part and instead write $z=13$, as follows:\n\n$$\n\\frac{x-1}{-2}=\\frac{y+6}{5},\\,z=13\n$$"} {:db/id #edb/ref 17592186447024 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bbe3ab9-a7ef-5513-96b0-4bb81eecfdf5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y-3}{5}=z-2,\\,x=0" :db/id #edb/ref 17592186447012} {:answer/id #uuid "58eab78c-4412-5b45-b6ad-1d2c084a66a9" :answer/type {:db/ident :answer.type/math} :answer/value "x+4=\\frac{z-1}{2},\\,y=5" :db/id #edb/ref 17592186447015} {:answer/id #uuid "7287e364-e5ae-5892-9f4f-1be7926ae48e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y-5}{3}=\\frac{z-1}{2},=x+4" :db/id #edb/ref 17592186447017} {:answer/id #uuid "77cf8edb-f11a-593d-b22b-70517358473d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y+5}{3}=\\frac{z+1}{2},\\,x=4" :db/id #edb/ref 17592186447018} {:answer/id #uuid "bd35653f-734b-565e-9879-e2cd580e5dfd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y-5}{3}=\\frac{z-1}{2},\\,x=-4" :db/id #edb/ref 17592186447020}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y-5}{3}=\\frac{z-1}{2},\\,x=-4" :db/id #edb/ref 17592186447020} :answer-field/id #uuid "1aa198ef-bba1-5d57-9850-a75e16ce7498" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186447022}] :question/id #uuid "47833d2d-e4b4-5480-a72b-ba5cccc746dd" :question/math-academy-id "q-71043" :question/problem "Find the Cartesian equation for the line with the following vector equation:\n\n$$\nr=\\begin{bmatrix}-4 \\\\ 5 \\\\ 1\\end{bmatrix}+t\\begin{bmatrix}0 \\\\ 3 \\\\ 2\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$" :question/worked-solution "Using the usual formula, we get\n\n$$\n\\frac{x-(-4)}{0}=\\frac{y-5}{3}=\\frac{z-1}{2}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x+4}{0}=\\frac{y-5}{3}=\\frac{z-1}{2},\n$$\n\nwhich is problematic because $\\frac{x+4}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $x$ component always maintains the constant value of $x=-4:$\n\n$$\nr=\\begin{bmatrix}-4 \\\\ 5+3t \\\\ 1+2t\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$\n\nSo, in the Cartesian equation, we remove the $\\frac{x+4}{0}$ part and instead write $x=-4$, as follows:\n\n$$\n\\frac{y-5}{3}=\\frac{z-1}{2},\\,x=-4\n$$"} {:db/id #edb/ref 17592186495153 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21da8be1-01fa-5395-a6d1-693fba89579e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{-1}=\\frac{z+1}{9},\\,y=-5" :db/id #edb/ref 17592186494385} {:answer/id #uuid "553addc8-18e6-53d9-9334-7c785c7ad81b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{1}=\\frac{z-1}{9},\\,y=-5" :db/id #edb/ref 17592186494492} {:answer/id #uuid "6a750839-2164-533a-a44a-d12f1239ee58" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-1}{1}=\\frac{z+1}{9},\\,y=5" :db/id #edb/ref 17592186494534} {:answer/id #uuid "85c6789f-ffce-5244-91d7-4630e5c1a765" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{2}=\\frac{z-1}{-9},\\,y=-5" :db/id #edb/ref 17592186494612} {:answer/id #uuid "a18e13dc-ae24-5ed7-8084-0bc94766af44" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{1}=\\frac{z+1}{9},\\,y=5" :db/id #edb/ref 17592186494686}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{1}=\\frac{z-1}{9},\\,y=-5" :db/id #edb/ref 17592186494492} :answer-field/id #uuid "4525723d-b5cd-5648-a3e1-1f8bec32accd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186494947}] :question/id #uuid "dd432b0a-1c26-5d37-8911-e5b811490135" :question/math-academy-id "q-127462" :question/problem "Find the Cartesian equation for the line with the following vector equation:\n\n$$\nr=\\begin{bmatrix}0 \\\\ -5 \\\\ 1\\end{bmatrix}+t\\begin{bmatrix}1 \\\\ 0 \\\\ 9\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$" :question/worked-solution "Using the usual formula, we get\n\n$$\n\\frac{x-0}{1}=\\frac{y-(-5)}{0}=\\frac{z-1}{9}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x}{1}=\\frac{y+5}{0}=\\frac{z-1}{9},\n$$\n\nwhich is problematic because $\\frac{y+5}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $y$ component always maintains the constant value of $y=-5:$\n\n$$\nr=\\begin{bmatrix}t \\\\ -5 \\\\ 1+9t\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )\n$$\n\nSo, in the Cartesian equation, we remove the $\\frac{y+5}{0}$ part and instead write $y=-5,$ as follows:\n\n$$\n\\frac{x}{1}=\\frac{z-1}{9},\\,y=-5\n$$"}] :knowledge-point/title "Finding the Cartesian Equation of a Line When a Component of the Direction Vector is Zero"}] :topic/math-academy-id 1799 :topic/title "The Cartesian Equation of a Line"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186106635} :activity/id #uuid "0211c399-b12f-5dd5-8ac4-97409f9a60bc" :activity/steps [{:db/id #edb/ref 17592186106635 :step/content {:db/id #edb/ref 17592186107080 :tutorial/content "Let's consider a system of linear equations where the corresponding coefficient matrix is singular. For example, consider the following system and its associated augmented matrix:\n![](images/6a/6a69daf7712312876b0ec97c540bbc472e46a7938beb8a59e694a04ad0b1d8c6.svg)\n\nTo solve the system, we can reduce $M$ to row echelon form using Gaussian elimination, as usual. We have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & -2 & -5 \\\\ -3 & 6 & 15\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & -5 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nThe corresponding system is now\n![](images/a8/a8bfe3f6b27247ee9b27db8346fd94fb9068c85dec6f4a71517a821dee48dbf3.svg)\n\nSince any pair of numbers $x,y$ is a solution of the final equation $0x+0y = 0,$ we can remove this equation from the system. So, our system now consists of a single equation\n\n$$\nx - 2y = -5.\n$$\n\nFinally, we describe the **general solution** of our system.\n\n- The first variable in our equation, $x,$ is called a **basic variable**.\n\n- The second variable in our equation, $y,$ is called a **free variable**.\n\nSolving for the basic variable $(x)$ in terms of the free variable $(y),$ we get $x = -5+2y.$ So the general solution of the system is\n![](images/0b/0ba4a232f29dd6fce2a8f6d7cda39b4f5b192c20fc91fe4403dfe648231382c5.svg)\nwhere the free variable $y$ is any number.\n\nIn vector form, this solution is written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-5+2y \\\\ y\\end{aligned}]=[\\begin{aligned}-5 \\\\ 0\\end{aligned}]+y[\\begin{aligned}2 \\\\ 1\\end{aligned}],\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$\n\nNotice that this is the equation of a straight line on a plane. Any point on this line satisfies our system of equations.\n\nIf we want to find some **particular solution** of the system, we simply choose some particular value of $y$ and find the corresponding value of $x$ on the line. For example, if we choose $y=0,$ then the corresponding value is $x=-5$ and the particular solution is $x=-5,$ $y=0.$" :tutorial/id #uuid "0c91df0b-40c7-5a65-9fda-5d2d6438dfa3" :tutorial/math-academy-id 3153 :tutorial/title "Introduction"} :step/id #uuid "2b66da6f-e7b3-547c-b47a-3bfe17bbc205" :step/next {:db/id #edb/ref 17592186106636}} {:db/id #edb/ref 17592186106636 :step/content {:db/id #edb/ref 17592186105745 :knowledge-point/id #uuid "97cd9132-458b-5234-a3d2-22b633acb74c"} :step/id #uuid "414f018d-78f3-5c78-86b8-6363d86d3a9e" :step/next {:db/id #edb/ref 17592186106744}} {:db/id #edb/ref 17592186106637 :step/content {:db/id #edb/ref 17592186105746 :knowledge-point/id #uuid "07f2ae4c-ff07-5b99-a7b0-90f460081eef"} :step/id #uuid "00d5123d-64a7-5878-9b67-ac7b7a2bf0a0" :step/next {:db/id #edb/ref 17592186106638}} {:db/id #edb/ref 17592186106638 :step/content {:db/id #edb/ref 17592186107081 :tutorial/content "Given a $2 \\times 2$ system of linear equations, we have the following possibilities for the number of solutions:\n\n- The system has exactly *one solution* if and only if the respective coefficient matrix is non-singular (meaning that the determinant is not zero). Such systems are called **consistent independent**.\n\n- The system has *infinitely many solutions* if the second row in the standard echelon form contains only $0$'s. These systems are called **consistent dependent**.\n\n- The system has *no solution* if the second row in the standard echelon form contains only $0$'s on the left-hand side and a non-zero element on the right-hand side. These are called **inconsistent** systems.\n\n![](images/16/1692fbea298339ff839cf2f14986d51af45d1ec72b2b7d0de179336bdef40c0e.png)\n\n**Note:** A system of linear equations of the form \n![](images/cb/cb397dd01794f28ff11c01079e287d63175e439c8bbaa85cd02dc61689780fa8.svg)\nwhere we have only $0$'s on the right-hand side, is called **homogeneous**. A homogeneous system always has at least one solution, namely, the solution $x=0$ and $y=0.$ Or, in vector form, $\\langle 0,0 \\rangle.$" :tutorial/id #uuid "b885f832-9e76-5008-a764-7375b1c25e35" :tutorial/math-academy-id 3154 :tutorial/title "The Number of Solutions of a 2x2 System"} :step/id #uuid "dc00947a-2ca5-59a7-a7a8-349b27d59bf2"} {:db/id #edb/ref 17592186106744 :step/content {:db/id #edb/ref 17592186107097 :tutorial/content "Sometimes, a system of equations might not have any solutions. For example, consider the following augmented matrix:\n\n$$\n\\begin{aligned}M=[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 0 & 10\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding system is\n![](images/e8/e8c64d8be247afd3e8ab02abc69e33635ef0234dbcbbc60f42379021a39a58a2.svg)\n\nThe final equation, $0x+0y=10,$ has no solution. It simplifies to $0=10,$ which is a false statement.\n\nSo, there is no pair $x,y$ that satisfies both equations in the system. Consequently, the overall system has no solution." :tutorial/id #uuid "20c281f5-a455-581a-a7f7-fec6cfaa114e" :tutorial/math-academy-id 3901 :tutorial/title "Singular Systems with No Solution"} :step/id #uuid "e6eff47b-880f-55d6-94ac-af8b9767c4fd" :step/next {:db/id #edb/ref 17592186106637}}] :activity/title "Solving 2x2 Singular Systems of Equations Using Gaussian Elimination" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186106000}] :db/id #edb/ref 17592186048853 :topic/knowledge-points [{:db/id #edb/ref 17592186105745 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105602 :question/id #uuid "7bfabbd2-9988-5c0e-9c17-3d430b3e7a0f" :question/math-academy-id "e-4699" :question/problem "Consider the augmented matrix $M$ given by \n![](images/97/9773630254747a4bbd072bd44a6263bdd078fa09005b1bb5f51c48b894d67daf.svg)\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then find the general solution of the linear system represented by the matrix." :question/worked-solution "Reducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\begin{bmatrix}1 & -3 & 1 \\\\ 4 & -12 & 4\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-4){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 1 \\\\ 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThe corresponding system is now\n\n![](images/43/43b9b089e0f93e63acf386bb605a0e3751cc8660899ce19d23835f9f79918bcc.svg)\n\nSince any pair of numbers $x,y$ is a solution of the final equation $0x+0y = 0,$ we can remove this equation from the system. So, our system now consists of a single equation\n\n$$\nx - 3y = 1.\n$$\n\nThe first variable $(x)$ is the basic variable, and the second variable $(y)$ is the free variable. Solving for the basic variable $(x)$ in terms of the free variable $(y),$ we get $x=1+3y,$ and the general solution is\n\n![](images/4a/4a598a80f2f14715d1f10d182b3f80887c7586beabecc2a329119b624c19a4fa.svg)\n\nwhere $y$ is an arbitrary number. \n\nIn vector form, the general solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1+3y \\\\ y\\end{bmatrix}=⟨1+3y,\\,y⟩,\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} :knowledge-point/id #uuid "97cd9132-458b-5234-a3d2-22b633acb74c" :knowledge-point/question-generator {:db/id #edb/ref 17592186551473 :question-generator/id #uuid "e0f0d1a1-c3b4-5f13-83aa-ac207126bbb9" :question-generator/script "generate/scratch/17592186105745.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186106312 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00f46691-e757-5abf-9bd0-72673d154024" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-3-y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186326944} {:answer/id #uuid "1f03cf88-a33c-5f4d-ad02-3f006b794c4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}3-y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186327202} {:answer/id #uuid "6ab00714-7708-5dae-8ab3-51d79a90b326" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-3+y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186327854} {:answer/id #uuid "83e07d41-124b-5fc8-8112-a63a06c47867" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1+y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186328074} {:answer/id #uuid "e8ac4687-189d-52a1-91e7-5e515f849261" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}3+y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186328970}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}3+y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186328970} :answer-field/id #uuid "5b2a178f-52c0-5a56-a7a5-d0eb67f8a442" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329348}] :question/id #uuid "d6118a9d-772a-5b19-befb-3156e01fd7c2" :question/math-academy-id "q-42155" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=\\begin{bmatrix}1 & -1 & 3 \\\\ -3 & 3 & -9\\end{bmatrix}.\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then find the general solution of the linear system represented by the matrix." :question/worked-solution "Reducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -1 & 3 \\\\ -3 & 3 & -9\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 3 \\\\ 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-y &=3 \\\\ 0x+0y &=0.\\end{aligned}\\right.\n$$\n\nSince any pair of numbers $x,y$ is a solution of the final equation $0x+0y=0,$ we can remove this equation from the system. So, our system now consists of a single equation\n\n$$\nx-y=3.\n$$\n\nThe first variable $(x)$ is the basic variable, and the second variable $(y)$ is the free variable. Solving for the basic variable $(x)$ in terms of the free variable $(y),$ we get $x=3+y,$ and the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=3+y \\\\ y &=y\\end{aligned}\\right.\n$$\n\nwhere $y$ is an arbitrary number. \n\nIn vector form, the general solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}3+y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186106313 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9f1382a-870c-5f7c-b007-6684dc65136e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1 - 2y, y⟩, y ∈ (- ∞, ∞)" :db/id #edb/ref 17592186104027} {:answer/id #uuid "e68d6a57-2fff-5fe1-97e2-53e0d4e0fb15" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1 + 2y, y⟩, y ∈ (- ∞, ∞)" :db/id #edb/ref 17592186104028} {:answer/id #uuid "ee0db42e-1100-5418-8315-c630442bb8ae" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,-2⟩" :db/id #edb/ref 17592186104029} {:answer/id #uuid "56c35cf2-8374-5cfd-8ca3-d7861125849e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨ - 1 + 2y, y⟩, y ∈ (- ∞, ∞)" :db/id #edb/ref 17592186104030} {:answer/id #uuid "7ec12860-5f4a-5e06-8d80-fe18641609f4" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1, 0⟩" :db/id #edb/ref 17592186104031}] :answer-field/id #uuid "a117e6ad-ea85-5ffa-be6d-c20de27fa2cf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186104026} {:answer-field/choices [{:answer/id #uuid "d7b917a4-149a-5335-87b0-b5af432e1dd3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,-2⟩" :db/id #edb/ref 17592186379836} {:answer/id #uuid "d5fcad4a-a362-5ebf-bbea-e056e83246a2" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,\\,0⟩" :db/id #edb/ref 17592186379837} {:answer/id #uuid "63ca10a3-6abf-594c-bc38-1b37ffcbdc38" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1-2y,\\,y⟩,\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186379838} {:answer/id #uuid "1730136e-f78b-5eda-af0d-81956b5fce34" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1+2y,\\,y⟩,\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186379839} {:answer/id #uuid "72d559c6-a1d1-5e3e-be26-d5a5b1c9e977" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1+2y,\\,y⟩,\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186379840}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "⟨1+2y,\\,y⟩,\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186379839} :answer-field/id #uuid "1b446b32-d3dd-5edb-b643-a1c5a81e8d04" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379835}] :question/id #uuid "0407db63-d38b-50cb-b37f-dfd7ce1a8b10" :question/math-academy-id "q-42156" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=\\begin{bmatrix}1 & -2 & 1 \\\\ 0 & 0 & 0\\end{bmatrix}.\n$$\n\nFind the general solution of the linear system represented by the matrix." :question/worked-solution "The system corresponding to $M$ is \n\n$$\n\\left\\{\\begin{aligned}x-2y &=1 \\\\ 0x+0y &=0.\\end{aligned}\\right.\n$$\n\nSince any pair of numbers $x,y$ is a solution of the final equation $0x+0y=0,$ we can remove this equation from the system. So, our system now consists of a single equation\n\n$$\nx-2y=1.\n$$\n\nThe first variable $(x)$ is the basic variable, and the second variable $(y)$ is the free variable. Solving for the basic variable $(x)$ in terms of the free variable $(y),$ we get $x=1+2y,$ and the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=1+2y \\\\ y &=y\\end{aligned}\\right.\n$$\n\nwhere $y$ is an arbitrary number. \n\nIn vector form, the general solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1+2y \\\\ y\\end{bmatrix}=⟨1+2y,\\,y⟩,\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186266011 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17febf8e-1aa5-5cbf-bf1d-e9987976f9a7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1-3y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )\\end{aligned}" :db/id #edb/ref 17592186263229} {:answer/id #uuid "3cdfe373-1c05-5f22-9ed5-ccf0f4dd9b73" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}3y-1 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )\\end{aligned}" :db/id #edb/ref 17592186263544} {:answer/id #uuid "9b6d9d6a-1705-5b61-8129-44a0f7d4d0f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-3y-1 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )\\end{aligned}" :db/id #edb/ref 17592186264328} {:answer/id #uuid "ad82aa2b-ee84-5336-bc4d-46cbfde0facc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}y-3 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )\\end{aligned}" :db/id #edb/ref 17592186264491} {:answer/id #uuid "df7ef948-6ddd-520b-b34c-48ba7514f083" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-y-3 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )\\end{aligned}" :db/id #edb/ref 17592186264939}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-3y-1 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )\\end{aligned}" :db/id #edb/ref 17592186264328} :answer-field/id #uuid "0a1e99c9-d9c5-5879-a3eb-f47e2e0715ed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265263}] :question/id #uuid "527da09a-4044-5c93-b906-dff9203cb12d" :question/math-academy-id "q-130922" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=\\begin{bmatrix}3 & 9 & -3 \\\\ 2 & 6 & -2\\end{bmatrix}.\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then find the general solution of the linear system represented by the matrix." :question/worked-solution "Reducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}3 & 9 & -3 \\\\ 2 & 6 & -2\\end{bmatrix} & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & -1 \\\\ 2 & 6 & -2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & -1 \\\\ 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+3y &=-1 \\\\ 0x+0y &=0.\\end{aligned}\\right.\n$$\n\nSince any pair of numbers $x,y$ is a solution of the final equation $0x+0y=0,$ we can remove this equation from the system. So, our system now consists of a single equation\n\n$$\nx+3y=-1.\n$$\n\nThe first variable $(x)$ is the basic variable, and the second variable $(y)$ is the free variable. Solving for the basic variable $(x)$ in terms of the free variable $(y),$ we get $x=-3y-1,$ and the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-3y-1 \\\\ y &=y\\end{aligned}\\right.\n$$\n\nwhere $y$ is an arbitrary number. \n\nIn vector form, the general solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-3y-1 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186288008 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c247114-0265-5d19-950c-d6ddadbc52e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}3-2y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186284888} {:answer/id #uuid "290d4310-b38e-58a7-b7f8-229614a89956" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}3+2y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186285148} {:answer/id #uuid "2bad0c5b-8898-5e4a-8e57-39537797a08c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-3+2y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186285168} {:answer/id #uuid "606e281f-cd18-58f3-89f3-488a6defa97e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-2+3y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186285672} {:answer/id #uuid "e873edde-7317-52df-9cf0-cc4cec745284" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-3-2y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186286914}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-3+2y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186285168} :answer-field/id #uuid "e9e4910b-9053-5d68-9d88-04077e065b78" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287630}] :question/id #uuid "64e30738-40d0-5a54-8cdd-1cc83ec4b628" :question/math-academy-id "q-20782" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=\\begin{bmatrix}1 & -2 & -3 \\\\ -7 & 14 & 21\\end{bmatrix}.\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then find the general solution of the linear system represented by the matrix." :question/worked-solution "Reducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\begin{bmatrix}1 & -2 & -3 \\\\ -7 & 14 & 21\\end{bmatrix} & {R}_{2} & :={R}_{2}+7{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & -3 \\\\ 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-2y &=-3 \\\\ 0x+0y &=0.\\end{aligned}\\right.\n$$\n\nSince any pair of numbers $x,y$ is a solution of the final equation $0x+0y=0,$ we can remove this equation from the system. So, our system now consists of a single equation\n\n$$\nx-2y=-3.\n$$\n\nThe first variable $(x)$ is the basic variable, and the second variable $(y)$ is the free variable. Solving for the basic variable $(x)$ in terms of the free variable $(y),$ we get $x=-3+2y,$ and the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-3+2y \\\\ y &=y\\end{aligned}\\right.\n$$\n\nwhere $y$ is an arbitrary number. \n\nIn vector form, the general solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-3+2y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186288020 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15f1cb44-5b06-5d4d-9607-9ad3cbf2af14" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1-3y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186284985} {:answer/id #uuid "6d6fcd9a-23a6-5453-9d08-4d210d1b7d8a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}7+3y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186285795} {:answer/id #uuid "7c25a4a3-f7cb-549a-ae3e-01af8eacb8bc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}5+3y \\\\ y\\en