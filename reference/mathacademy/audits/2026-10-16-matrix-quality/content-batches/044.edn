b/id #edb/ref 17592186337386} {:answer/id #uuid "2670e300-5558-54cf-aa24-1fbeb9d684b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=-4+11t \\\\ y &=5-3t \\\\ z &=3-t\\end{aligned}\\right." :db/id #edb/ref 17592186422763} {:answer/id #uuid "2aad0314-cdde-56d6-9fc9-f1e44fdcf531" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=-11-4t \\\\ y &=3+5t \\\\ z &=1+3t\\end{aligned}\\right." :db/id #edb/ref 17592186422767} {:answer/id #uuid "4b7409a3-17df-5f35-9a98-53b2b56e27b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=11-4t \\\\ y &=-3+5t \\\\ z &=-1+3t\\end{aligned}\\right." :db/id #edb/ref 17592186422796} {:answer/id #uuid "b720935d-3a6b-53b7-8467-e0328c75249f" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=-4t \\\\ y &=5t \\\\ z &=3t\\end{aligned}\\right." :db/id #edb/ref 17592186422883}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=11-4t \\\\ y &=-3+5t \\\\ z &=-1+3t\\end{aligned}\\right." :db/id #edb/ref 17592186422796} :answer-field/id #uuid "ec3ec4fe-dbef-57ff-9f77-95dfde96d695" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338687}] :question/id #uuid "cadd3ac4-4f87-567b-a331-c8cf0c3150d6" :question/math-academy-id "q-70866" :question/problem "Find the parametric equations of the line $\\frac{x-11}{-4}=\\frac{y+3}{5}=\\frac{z+1}{3}.$" :question/worked-solution "Remember that the Cartesian (canonical) equation of the straight line that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is parallel to the vector $v=⟨{v}_{x},{v}_{y},{v}_{z}⟩$, is given by\n\n$$\n\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nComparing the above to our given equation\n\n$$\n\\frac{x-11}{-4}=\\frac{y-(-3)}{5}=\\frac{z-(-1)}{3},\n$$\n\nwe find that our line passes through the point $P(11,-3,-1)$ and is parallel to $v=⟨-4,5,3⟩.$ Therefore, its vector equation is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =\\begin{bmatrix}11 \\\\ -3 \\\\ -1\\end{bmatrix}+t\\begin{bmatrix}-4 \\\\ 5 \\\\ 3\\end{bmatrix},\\,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$\n\nTherefore, the parametric equations are the following:\n\n$$\n\\left\\{\\begin{aligned}x &=11-4t \\\\ y &=-3+5t \\\\ z &=-1+3t\\end{aligned}\\right.\n$$"} {:db/id #edb/ref 17592186387782 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2ae9599-1892-5be6-b1c8-b8ef620c7738" :answer/type {:db/ident :answer.type/math} :answer/value "r=\\begin{bmatrix}2 \\\\ 1 \\\\ -3\\end{bmatrix}+t\\begin{bmatrix}3 \\\\ 2 \\\\ -7\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186387784} {:answer/id #uuid "fca84d02-ccb4-52a9-a93c-7cd98c22b79f" :answer/type {:db/ident :answer.type/math} :answer/value "r=\\begin{bmatrix}-2 \\\\ -1 \\\\ 3\\end{bmatrix}+t\\begin{bmatrix}3 \\\\ -2 \\\\ 7\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186387785} {:answer/id #uuid "dcddf5ad-bad0-5c48-9c2f-45b33927cb52" :answer/type {:db/ident :answer.type/math} :answer/value "r=\\begin{bmatrix}2 \\\\ 1 \\\\ -3\\end{bmatrix}+t\\begin{bmatrix}3 \\\\ -2 \\\\ 7\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186387786} {:answer/id #uuid "ac4fe1c6-8d45-519c-a36f-32e791441ac8" :answer/type {:db/ident :answer.type/math} :answer/value "r=\\begin{bmatrix}2 \\\\ 1 \\\\ 3\\end{bmatrix}+t\\begin{bmatrix}3 \\\\ -2 \\\\ 7\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186387787} {:answer/id #uuid "4bc8ff65-683e-5598-9183-38c4f3865f52" :answer/type {:db/ident :answer.type/math} :answer/value "r=\\begin{bmatrix}2 \\\\ 1 \\\\ -3\\end{bmatrix}+t\\begin{bmatrix}-3 \\\\ 2 \\\\ 7\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186387788}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "r=\\begin{bmatrix}2 \\\\ 1 \\\\ -3\\end{bmatrix}+t\\begin{bmatrix}3 \\\\ -2 \\\\ 7\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186387786} :answer-field/id #uuid "116b2669-f1fc-59d5-a844-fbb50e3ebbec" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387783}] :question/id #uuid "ef077b10-897a-59ae-a756-7a254900bdb1" :question/math-academy-id "q-127068" :question/problem "Find the vector equation of the line $\\frac{x-2}{3}=\\frac{y-1}{-2}=\\frac{z+3}{7}.$" :question/worked-solution "Remember that the Cartesian (canonical) equation of the straight line that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is parallel to the vector $v=⟨{v}_{x},{v}_{y},{v}_{z}⟩$, is given by\n\n$$\n\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nComparing the above to our given equation\n\n$$\n\\frac{x-2}{3}=\\frac{y-1}{-2}=\\frac{z-(-3)}{7}\n$$\n\nwe find that our line passes through the point $P(2,1,-3)$ and is parallel to $v=⟨3,-2,7⟩.$ Therefore, its vector equation is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =\\begin{bmatrix}2 \\\\ 1 \\\\ -3\\end{bmatrix}+t\\begin{bmatrix}3 \\\\ -2 \\\\ 7\\end{bmatrix},\\,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186413265 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "299601c1-c189-56c9-a263-8a4e23810703" :answer/type {:db/ident :answer.type/math} :answer/value "r=\\begin{bmatrix}7 \\\\ 2 \\\\ -3\\end{bmatrix}+t\\begin{bmatrix}3 \\\\ 4 \\\\ -7\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186413210} {:answer/id #uuid "38f146eb-7159-527b-9b0e-80360837fbdb" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186413213} {:answer/id #uuid "4aeef7c0-439a-5ccb-8d85-ceb73b3ed2da" :answer/type {:db/ident :answer.type/math} :answer/value "r=\\begin{bmatrix}7 \\\\ 2 \\\\ 3\\end{bmatrix}+t\\begin{bmatrix}3 \\\\ 4 \\\\ 7\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186413216} {:answer/id #uuid "7acfe4e3-373d-5d11-a879-57c9a43b56c0" :answer/type {:db/ident :answer.type/math} :answer/value "r=\\begin{bmatrix}7 \\\\ -2 \\\\ 3\\end{bmatrix}+t\\begin{bmatrix}4 \\\\ 3 \\\\ -7\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186413226} {:answer/id #uuid "8393d971-684a-53d4-b181-6839d28c8304" :answer/type {:db/ident :answer.type/math} :answer/value "r=\\begin{bmatrix}7 \\\\ -2 \\\\ -3\\end{bmatrix}+t\\begin{bmatrix}3 \\\\ -4 \\\\ -7\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186413227}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "r=\\begin{bmatrix}7 \\\\ 2 \\\\ -3\\end{bmatrix}+t\\begin{bmatrix}3 \\\\ 4 \\\\ -7\\end{bmatrix},\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186413210} :answer-field/id #uuid "a00f7c00-cf28-532d-ba2d-23cd87582c37" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413263}] :question/id #uuid "1146c0df-94bc-5e1e-b7ad-b9815bc6197e" :question/math-academy-id "q-127071" :question/problem "Consider the straight line with the canonical equation $\\frac{x-7}{3}=\\frac{y-2}{4}=\\frac{z+3}{-7}.$ Find the vector equation of the line." :question/worked-solution "Remember that the Cartesian (canonical) equation of the straight line that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is parallel to the vector $v=⟨{v}_{x},{v}_{y},{v}_{z}⟩$, is given by\n\n$$\n\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nComparing the above to our given equation\n\n$$\n\\frac{x-7}{3}=\\frac{y-2}{4}=\\frac{z-(-3)}{-7},\n$$\n\nwe find that our line passes through the point $P(7,2,-3)$ and is parallel to $v=⟨3,4,-7⟩.$ Therefore, its vector equation is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =\\begin{bmatrix}7 \\\\ 2 \\\\ -3\\end{bmatrix}+t\\begin{bmatrix}3 \\\\ 4 \\\\ -7\\end{bmatrix},\\,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186413268 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2aa0077e-181b-5c87-b397-bf90c7b66f48" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=10-6t \\\\ y &=-5+3t \\\\ z &=-7+2t\\end{aligned}\\right." :db/id #edb/ref 17592186413211} {:answer/id #uuid "2ff9e3e1-5e91-5965-a734-3ac520d19c3e" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186413212} {:answer/id #uuid "3a1b04c5-6fb6-5d48-9648-cb591bb11169" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=10-6t \\\\ y &=-3+5t \\\\ z &=-7+2t\\end{aligned}\\right." :db/id #edb/ref 17592186413214} {:answer/id #uuid "55d1767d-6142-57fd-84ac-0823297abb7b" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=10+6t \\\\ y &=5+3t \\\\ z &=7+2t\\end{aligned}\\right." :db/id #edb/ref 17592186413220} {:answer/id #uuid "cbce69e5-b398-5143-8fee-8b1fc3bf565b" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=10+6t \\\\ y &=-5+3t \\\\ z &=7-2t\\end{aligned}\\right." :db/id #edb/ref 17592186413245}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=10-6t \\\\ y &=-5+3t \\\\ z &=-7+2t\\end{aligned}\\right." :db/id #edb/ref 17592186413211} :answer-field/id #uuid "0cb77e23-9c21-5d3c-a6f6-d6c088c776f2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413256}] :question/id #uuid "bc81db7e-a314-5809-b5c5-608d6bc1d824" :question/math-academy-id "q-127076" :question/problem "Find the parametric equations of the line $\\frac{x-10}{-6}=\\frac{y+5}{3}=\\frac{z+7}{2}.$" :question/worked-solution "Remember that the Cartesian (canonical) equation of the straight line that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is parallel to the vector $v=⟨{v}_{x},{v}_{y},{v}_{z}⟩$, is given by\n\n$$\n\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nComparing the above to our given equation\n\n$$\n\\frac{x-10}{-6}=\\frac{y-(-5)}{3}=\\frac{z-(-7)}{2},\n$$\n\nwe find that our line passes through the point $P(10,-5,-7)$ and is parallel to $v=⟨-6,3,2⟩.$ Therefore, its vector equation is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =\\begin{bmatrix}10 \\\\ -5 \\\\ -7\\end{bmatrix}+t\\begin{bmatrix}-6 \\\\ 3 \\\\ 2\\end{bmatrix},\\,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$\n\nTherefore, the parametric equations are the following:\n\n$$\n\\left\\{\\begin{aligned}x &=10-6t \\\\ y &=-5+3t \\\\ z &=-7+2t\\end{aligned}\\right.\n$$"} {:db/id #edb/ref 17592186413269 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c21e0bb-ee8c-5fa2-ad4c-8c70768e7b7f" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=7t \\\\ y &=3-2t \\\\ z &=-6-8t\\end{aligned}\\right." :db/id #edb/ref 17592186413218} {:answer/id #uuid "898d0828-6322-5cc9-9782-a0f2a96d4581" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=7t \\\\ y &=3+2t \\\\ z &=-8-6t\\end{aligned}\\right." :db/id #edb/ref 17592186413229} {:answer/id #uuid "9024db90-ca7f-5e93-98cf-00227482d43b" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=7 \\\\ y &=2+3t \\\\ z &=-8-6t\\end{aligned}\\right." :db/id #edb/ref 17592186413230} {:answer/id #uuid "9177928a-2741-51e3-86bf-5cb26316adc9" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186413232} {:answer/id #uuid "b5885116-09bb-5d3d-8d90-739f213a2b36" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=5t \\\\ y &=3-2t \\\\ z &=-8+6t\\end{aligned}\\right." :db/id #edb/ref 17592186413241}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=7t \\\\ y &=3+2t \\\\ z &=-8-6t\\end{aligned}\\right." :db/id #edb/ref 17592186413229} :answer-field/id #uuid "acbe6b35-1062-5ba5-b134-eaeb97e4203f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413264}] :question/id #uuid "ca426087-2ced-544a-8fc8-80a74f2884ad" :question/math-academy-id "q-127074" :question/problem "Find the parametric equations of the line $\\frac{x}{7}=\\frac{y-3}{2}=\\frac{z+8}{-6}.$" :question/worked-solution "Remember that the Cartesian (canonical) equation of the straight line that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is parallel to the vector $v=⟨{v}_{x},{v}_{y},{v}_{z}⟩$, is given by\n\n$$\n\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nComparing the above to our given equation\n\n$$\n\\frac{x}{7}=\\frac{y-3}{2}=\\frac{z-(-8)}{-6},\n$$\n\nwe find that our line passes through the point $P(0,3,-8)$ and is parallel to $v=⟨7,2,-6⟩.$ Therefore, its vector equation is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =\\begin{bmatrix}0 \\\\ 3 \\\\ -8\\end{bmatrix}+t\\begin{bmatrix}7 \\\\ 2 \\\\ -6\\end{bmatrix},\\,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$\n\nTherefore, the parametric equations are the following:\n\n$$\n\\left\\{\\begin{aligned}x &=7t \\\\ y &=3+2t \\\\ z &=-8-6t\\end{aligned}\\right.\n$$"} {:db/id #edb/ref 17592186413273 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "089f0314-d541-57da-8474-803ac5e9d9f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=13+7t \\\\ y &=-3+2t \\\\ z &=1-5t\\end{aligned}\\right." :db/id #edb/ref 17592186413206} {:answer/id #uuid "4c141cec-318c-5fa6-984e-d5d96ba7c25e" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186413217} {:answer/id #uuid "a5e9eb55-76d8-5834-b077-9d8e4ba666d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=13-7t \\\\ y &=-2+3t \\\\ z &=1+5t\\end{aligned}\\right." :db/id #edb/ref 17592186413235} {:answer/id #uuid "a8d95702-203e-5dd9-8f89-b3e9ad2f7948" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=11+7t \\\\ y &=2-3t \\\\ z &=1+t\\end{aligned}\\right." :db/id #edb/ref 17592186413236} {:answer/id #uuid "d117c2e1-a8ab-51ed-866a-b2f0126b6bb6" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=13+7t \\\\ y &=2+3t \\\\ z &=1-5t\\end{aligned}\\right." :db/id #edb/ref 17592186413246}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=13-7t \\\\ y &=-2+3t \\\\ z &=1+5t\\end{aligned}\\right." :db/id #edb/ref 17592186413235} :answer-field/id #uuid "10bab257-9e49-5588-bdbd-e51321b62eff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413257}] :question/id #uuid "e2f7b0c6-34b9-5cdd-a2c3-dccbfbacb488" :question/math-academy-id "q-127073" :question/problem "Find the parametric equations of the line $\\frac{x-13}{-7}=\\frac{y+2}{3}=\\frac{z-1}{5}.$" :question/worked-solution "Remember that the Cartesian (canonical) equation of the straight line that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is parallel to the vector $v=⟨{v}_{x},{v}_{y},{v}_{z}⟩$, is given by\n\n$$\n\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nComparing the above to our given equation\n\n$$\n\\frac{x-13}{-7}=\\frac{y-(-2)}{3}=\\frac{z-1}{5},\n$$\n\nwe find that our line passes through the point $P(13,-2,1)$ and is parallel to $v=⟨-7,3,5⟩.$ Therefore, its vector equation is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =\\begin{bmatrix}13 \\\\ -2 \\\\ 1\\end{bmatrix}+t\\begin{bmatrix}-7 \\\\ 3 \\\\ 5\\end{bmatrix},\\,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$\n\nTherefore, the parametric equations are the following:\n\n$$\n\\left\\{\\begin{aligned}x &=13-7t \\\\ y &=-2+3t \\\\ z &=1+5t\\end{aligned}\\right.\n$$"}] :knowledge-point/title "Finding the Vector Equation of a Line Given in Canonical Form"} {:db/id #edb/ref 17592186119827 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119638 :question/id #uuid "897aa930-02ca-5f79-95d0-5ee11420da97" :question/math-academy-id "e-4911" :question/problem "Consider the straight line with the parametric equations\n\n$$\n\\left\\{\\begin{aligned}x &=1-2t \\\\ y &=4t \\\\ z &=-2+3t\\end{aligned}\\right.\n$$\n\nfor $t \\in (-\\infty,\\infty).$ Find the Cartesian equation of this line." :question/worked-solution "First, let's find the corresponding vector equation as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}1-2t \\\\ 4t \\\\ -2+3t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ 0 \\\\ -2\\end{bmatrix}+\\begin{bmatrix}-2t \\\\ 4t \\\\ 3t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ 0 \\\\ -2\\end{bmatrix}+t\\begin{bmatrix}-2 \\\\ 4 \\\\ 3\\end{bmatrix} \\\\ r & =\\begin{bmatrix}1 \\\\ 0 \\\\ -2\\end{bmatrix}+t\\begin{bmatrix}-2 \\\\ 4 \\\\ 3\\end{bmatrix},\\end{aligned}\n$$\n\nwhere $t \\in (-\\infty,\\infty).$\n\nThis implies that the given line passes through the point $P(1,0,-2)$ and is parallel to the vector $\\mathbf{v}=\\langle -2, 4, 3 \\rangle.$ So, its Cartesian (canonical) equation is given by\n\n$$\n\\dfrac{x-1}{-2}=\\dfrac{y}{4}=\\dfrac{z-(-2)}{3} = t, \t\\qquad t \\in (-\\infty,\\infty).\n$$\n\nSimplifying, we reach\n\n$$\n\\dfrac{x-1}{-2}=\\dfrac{y}{4}=\\dfrac{z+2}{3}.\n$$"} :knowledge-point/id #uuid "d44cf726-a4a6-5ac9-a63c-7464fe5566c5" :knowledge-point/questions [{:db/id #edb/ref 17592186120221 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59f75482-4344-5455-9326-2b02a2664200" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y+1}{-5}=\\frac{z-6}{5},\\,x=-6" :db/id #edb/ref 17592186413221} {:answer/id #uuid "6c5f12f8-0cc6-5f24-912e-0e0046f905d1" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186413222} {:answer/id #uuid "bab03ceb-16b2-5883-b741-7e3fa8ad18e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y-1}{-5}=\\frac{z+6}{5},\\,x=6" :db/id #edb/ref 17592186413242} {:answer/id #uuid "e90875fe-b897-5ee2-a9d0-62239b411734" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{6}=\\frac{y}{1}=\\frac{z}{-6}" :db/id #edb/ref 17592186413250} {:answer/id #uuid "f81bd765-d473-5593-847e-f0fd78d42b13" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{6}=\\frac{y+5}{1}=\\frac{z-5}{-6}" :db/id #edb/ref 17592186413253}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{6}=\\frac{y+5}{1}=\\frac{z-5}{-6}" :db/id #edb/ref 17592186413253} :answer-field/id #uuid "13a206c5-c050-5343-8992-9fa4de1720b0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413258}] :question/id #uuid "8f5992b1-761e-5564-8420-76d555a44826" :question/math-academy-id "q-33005" :question/problem "Consider the straight line with the vector equation\n\n$$\nr=\\begin{bmatrix}0 \\\\ -5 \\\\ 5\\end{bmatrix}+t\\begin{bmatrix}6 \\\\ 1 \\\\ -6\\end{bmatrix}\n$$\n\nfor $t\\in (-\\infty ,\\infty ).$ Find the Cartesian equation of this line." :question/worked-solution "We have the vector equation \n\n$$\nr=\\begin{bmatrix}0 \\\\ -5 \\\\ 5\\end{bmatrix}+t\\begin{bmatrix}6 \\\\ 1 \\\\ -6\\end{bmatrix},\\,t\\in (-\\infty ,\\infty ).\n$$\n\n \n\nThis implies that the straight line passes through the point $P(0,-5,5)$ and is parallel to the vector $v=⟨6,1,-6⟩.$ So, its Cartesian (canonical) equation is given by\n\n$$\n\\frac{x-0}{6}=\\frac{y-(-5)}{1}=\\frac{z-5}{-6}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nSimplifying, we reach\n\n$$\n\\frac{x}{6}=\\frac{y+5}{1}=\\frac{z-5}{-6}.\n$$"} {:db/id #edb/ref 17592186120244 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d52a8c68-e04a-5273-93cf-da0acbde2dc7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{2} = \\frac{y}{4} = \\frac{z}{3}" :db/id #edb/ref 17592186117624} {:answer/id #uuid "e3d04ba4-17b3-5940-988a-05a54117415e" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186117625} {:answer/id #uuid "20e49129-99cb-5332-9cbf-c0b84febc511" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{-1} = \\frac{y}{2} = \\frac{z}{-5}" :db/id #edb/ref 17592186117626} {:answer/id #uuid "538f4d42-3930-57a2-ae10-8c4cb1a4b9d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x + 1}{2} = \\frac{y - 2}{4} = \\frac{z + 5}{3}" :db/id #edb/ref 17592186117627} {:answer/id #uuid "6385abb9-8887-5fb6-9f6f-4fbe2bb1948a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x - 2}{-1} = \\frac{y - 4}{2} = \\frac{z - 3}{-5}" :db/id #edb/ref 17592186117628}] :answer-field/id #uuid "f06da543-8a87-550d-b9a7-21074ddc6714" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117623} {:answer-field/choices [{:answer/id #uuid "60ba444c-08df-597d-95a5-05bc3adc0f41" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{-1}=\\frac{y}{2}=\\frac{z}{-5}" :db/id #edb/ref 17592186368103} {:answer/id #uuid "7e9d0049-c193-5021-b238-4594a5d37f53" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186368104} {:answer/id #uuid "f5e2dcc1-3070-570b-830d-cbe39e3c483d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+1}{2}=\\frac{y-2}{4}=\\frac{z+5}{3}" :db/id #edb/ref 17592186368105} {:answer/id #uuid "e7294cd7-f2f7-5cd9-8ca5-10b8cc37815c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{-1}=\\frac{y-4}{2}=\\frac{z-3}{-5}" :db/id #edb/ref 17592186368106} {:answer/id #uuid "733c8af8-47a2-5f44-b623-e9ea757f785c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{2}=\\frac{y}{4}=\\frac{z}{3}" :db/id #edb/ref 17592186368107}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+1}{2}=\\frac{y-2}{4}=\\frac{z+5}{3}" :db/id #edb/ref 17592186368105} :answer-field/id #uuid "2ec927fd-80b6-5539-a3f7-d8ac067bd493" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368102}] :question/id #uuid "fac680fb-5324-5dce-9fd1-8fb9ea1b303b" :question/math-academy-id "q-33237" :question/problem "Consider the straight line with the parametric equations\n\n$$\n\\left\\{\\begin{aligned}x &=-1+2t \\\\ y &=2+4t \\\\ z &=-5+3t\\end{aligned}\\right.\n$$\n\nfor $t\\in (-\\infty ,\\infty ).$ Find the Cartesian equation of this line." :question/worked-solution "First, let's find the corresponding vector equation as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}-1+2t \\\\ 2+4t \\\\ -5+3t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}-1 \\\\ 2 \\\\ -5\\end{bmatrix}+\\begin{bmatrix}2t \\\\ 4t \\\\ 3t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}-1 \\\\ 2 \\\\ -5\\end{bmatrix}+t\\begin{bmatrix}2 \\\\ 4 \\\\ 3\\end{bmatrix} \\\\ r & =\\begin{bmatrix}-1 \\\\ 2 \\\\ -5\\end{bmatrix}+t\\begin{bmatrix}2 \\\\ 4 \\\\ 3\\end{bmatrix},\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nThis implies that the given line passes through the point $P(-1,2,-5)$ and is parallel to the vector $v=⟨2,4,3⟩.$ So, its Cartesian (canonical) equation is given by\n\n$$\n\\frac{x-(-1)}{2}=\\frac{y-2}{4}=\\frac{z-(-5)}{3}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nSimplifying, we reach\n\n$$\n\\frac{x+1}{2}=\\frac{y-2}{4}=\\frac{z+5}{3}.\n$$"} {:db/id #edb/ref 17592186262766 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04bee1c7-49b3-580d-8d7f-7d511c31c86f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{2}=\\frac{y+3}{-5}=\\frac{z-3}{3}" :db/id #edb/ref 17592186259916} {:answer/id #uuid "26835429-9c7b-5c42-9171-9ca8f1f6cda3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{-2}=\\frac{y+5}{3}=\\frac{z-3}{3}" :db/id #edb/ref 17592186260212} {:answer/id #uuid "2940d4c7-723b-5b1d-bc81-a44c8863324a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+2}{2}=\\frac{y-3}{-5}=\\frac{z-3}{3}" :db/id #edb/ref 17592186260236} {:answer/id #uuid "5d2270ae-4862-5c80-bd7d-a6d9c6894fc6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+2}{-2}=\\frac{y-3}{5}=\\frac{z+3}{3}" :db/id #edb/ref 17592186260673} {:answer/id #uuid "e9d571df-a83f-5c14-a594-4b58218d1320" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{2}=\\frac{y+5}{-3}=\\frac{z-3}{3}" :db/id #edb/ref 17592186261924}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+2}{2}=\\frac{y-3}{-5}=\\frac{z-3}{3}" :db/id #edb/ref 17592186260236} :answer-field/id #uuid "f84e469f-48b7-5e02-a735-0c6c8e241d96" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262553}] :question/id #uuid "66b97232-7bdd-5d53-a53e-721b60f0a132" :question/math-academy-id "q-127397" :question/problem "Consider the straight line with the vector equation\n\n$$\nr=\\begin{bmatrix}-2 \\\\ 3 \\\\ 3\\end{bmatrix}+t\\begin{bmatrix}2 \\\\ -5 \\\\ 3\\end{bmatrix}\n$$\n\nfor $t\\in (-\\infty ,\\infty ).$ Find the Cartesian equation of this line." :question/worked-solution "We have the vector equation \n\n$$\nr=\\begin{bmatrix}-2 \\\\ 3 \\\\ 3\\end{bmatrix}+t\\begin{bmatrix}2 \\\\ -5 \\\\ 3\\end{bmatrix},\\,t\\in (-\\infty ,\\infty ).\n$$\n\n \n\nThis implies that the straight line passes through the point $P(-2,3,3)$ and is parallel to the vector $v=⟨2,-5,3⟩.$ So, its Cartesian (canonical) equation is given by\n\n$$\n\\frac{x-(-2)}{2}=\\frac{y-3}{-5}=\\frac{z-3}{3}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nSimplifying, we reach\n\n$$\n\\frac{x+2}{2}=\\frac{y-3}{-5}=\\frac{z-3}{3}.\n$$"} {:db/id #edb/ref 17592186262767 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22045b16-d166-53e9-a860-057d8df291c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+1}{-2}=\\frac{y-5}{-1}=\\frac{z-7}{1}" :db/id #edb/ref 17592186260169} {:answer/id #uuid "8a88b0e9-8149-5353-aec9-2d87d5dc3d1c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+2}{-1}=\\frac{y-5}{-1}=\\frac{z+7}{1}" :db/id #edb/ref 17592186261083} {:answer/id #uuid "c457b05b-947b-53b9-8b81-9439d4269d9d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-1}{-2}=\\frac{y-5}{-1}=\\frac{z+7}{1}" :db/id #edb/ref 17592186261609} {:answer/id #uuid "d13e62fc-794e-5c6c-85fc-8a02848df06b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{1}=\\frac{y+1}{-5}=\\frac{z-1}{-7}" :db/id #edb/ref 17592186261721} {:answer/id #uuid "df19c412-9a35-5b2b-8bcf-df577752cae9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+2}{1}=\\frac{y+1}{5}=\\frac{z-1}{-7}" :db/id #edb/ref 17592186261847}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-1}{-2}=\\frac{y-5}{-1}=\\frac{z+7}{1}" :db/id #edb/ref 17592186261609} :answer-field/id #uuid "1f9de2d2-96e1-5828-8e77-3d0b2dfc03ca" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262174}] :question/id #uuid "0d2a6473-caac-59fb-8a5c-a6c5ea0abc7f" :question/math-academy-id "q-127401" :question/problem "Consider the straight line with the parametric equations\n\n$$\n\\left\\{\\begin{aligned}x &=1-2t \\\\ y &=5-t \\\\ z &=-7+t\\end{aligned}\\right.\n$$\n\nfor $t\\in (-\\infty ,\\infty ).$ Find the Cartesian equation of this line." :question/worked-solution "First, let's find the corresponding vector equation as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}1-2t \\\\ 5-t \\\\ -7+t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ 5 \\\\ -7\\end{bmatrix}+\\begin{bmatrix}-2t \\\\ -t \\\\ t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ 5 \\\\ -7\\end{bmatrix}+t\\begin{bmatrix}-2 \\\\ -1 \\\\ 1\\end{bmatrix} \\\\ r & =\\begin{bmatrix}1 \\\\ 5 \\\\ -7\\end{bmatrix}+t\\begin{bmatrix}-2 \\\\ -1 \\\\ 1\\end{bmatrix},\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nThis implies that the given line passes through the point $P(1,5,-7)$ and is parallel to the vector $v=⟨-2,-1,1⟩.$ So, its Cartesian (canonical) equation is given by\n\n$$\n\\frac{x-1}{-2}=\\frac{y-5}{-1}=\\frac{z-(-7)}{1}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nSimplifying, we reach\n\n$$\n\\frac{x-1}{-2}=\\frac{y-5}{-1}=\\frac{z+7}{1}.\n$$"} {:db/id #edb/ref 17592186262768 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a9b99cd-f399-5e4d-9bd2-9839e3637b10" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{-2}=\\frac{y-1}{3}=\\frac{z+5}{6}" :db/id #edb/ref 17592186259968} {:answer/id #uuid "489d6ec2-a19b-5aba-815b-bb8b8a144d15" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+2}{-6}=\\frac{y-1}{3}=\\frac{z-5}{2}" :db/id #edb/ref 17592186260503} {:answer/id #uuid "4d27e598-259a-56ce-a8ec-c92a89874c80" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{-6}=\\frac{y-1}{3}=\\frac{z+5}{2}" :db/id #edb/ref 17592186260532} {:answer/id #uuid "4df09a79-4644-51bd-b2de-3371f82e6c7e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+6}{2}=\\frac{y-3}{1}=\\frac{z-2}{5}" :db/id #edb/ref 17592186260537} {:answer/id #uuid "61d897cd-0395-5fe5-8602-cb21a2dfe7cf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+6}{-2}=\\frac{y-3}{1}=\\frac{z+2}{5}" :db/id #edb/ref 17592186260717}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2}{-6}=\\frac{y-1}{3}=\\frac{z+5}{2}" :db/id #edb/ref 17592186260532} :answer-field/id #uuid "20766bfc-a1a0-5c78-b271-36c212b5031e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262176}] :question/id #uuid "0277a440-31eb-5c11-98db-343c5921b893" :question/math-academy-id "q-127405" :question/problem "Consider the straight line with the parametric equations\n\n$$\n\\left\\{\\begin{aligned}x &=2-6t \\\\ y &=1+3t \\\\ z &=-5+2t\\end{aligned}\\right.\n$$\n\n \nfor $t\\in (-\\infty ,\\infty ).$ Find the Cartesian equation of this line." :question/worked-solution "First, let's find the corresponding vector equation as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}2-6t \\\\ 1+3t \\\\ -5+2t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ 1 \\\\ -5\\end{bmatrix}+\\begin{bmatrix}-6t \\\\ 3t \\\\ 2t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ 1 \\\\ -5\\end{bmatrix}+t\\begin{bmatrix}-6 \\\\ 3 \\\\ 2\\end{bmatrix} \\\\ r & =\\begin{bmatrix}2 \\\\ 1 \\\\ -5\\end{bmatrix}+t\\begin{bmatrix}-6 \\\\ 3 \\\\ 2\\end{bmatrix},\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nThis implies that the straight line passes through the point $P(2,1,-5)$ and is parallel to the vector $v=⟨-6,3,2⟩.$ So, its Cartesian (canonical) equation is given by\n\n$$\n\\frac{x-2}{-6}=\\frac{y-1}{3}=\\frac{z-(-5)}{2}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nSimplifying, we reach\n\n$$\n\\frac{x-2}{-6}=\\frac{y-1}{3}=\\frac{z+5}{2}.\n$$"} {:db/id #edb/ref 17592186262769 :question/answer-fields [{:answer-field/choice