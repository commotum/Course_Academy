 "6209fbad-4e21-5f35-b7ac-4219c566d4cd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323365}] :question/id #uuid "eeb68cad-07fc-5413-b03d-d7dfee7f1aee" :question/math-academy-id "q-37091" :question/problem "![](images/19/190af2ef92a8c23efb6fc15c6effebf5db929d8d133da6809bd27f77a6e9292b.png)\n\nThe vector $v$ is an eigenvector of a $2\\times 2$ matrix $A$ corresponding to the eigenvalue $-1.$ Find the vector $Av.$" :question/worked-solution "The eigenvector $v=\\begin{bmatrix}0 \\\\ 2\\end{bmatrix}$ corresponds to the eigenvalue $\\lambda =-1.$ So, \n\n$$\n\\begin{aligned}Av & =-1v.\\end{aligned}\n$$\n\nTherefore, we have the following picture:\n\n![](images/1f/1f778e38d2dd4d2e33675bfa45bbe13c9596b1818092ef6129e8f35b1741157e.png)"} {:db/id #edb/ref 17592186243973 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04e0e7cf-6af5-5715-86c1-15ade33ef49b" :answer/type {:db/ident :answer.type/image} :answer/value "images/eb/eb014dbb24f2f087c558d40d2ddb198f225c1ad50a66e6cf5daaaef7eec33021.png" :db/id #edb/ref 17592186241218} {:answer/id #uuid "20042cce-9c2a-5f63-8ecf-f8432304b58c" :answer/type {:db/ident :answer.type/image} :answer/value "images/44/441a9f0ee158ae2ebdddb223463887ca9f2d5e84a6fc925c80b0aa9ccf4bc65c.png" :db/id #edb/ref 17592186241461} {:answer/id #uuid "2f88b219-b0fe-5c1a-ae8f-36ec98b760e8" :answer/type {:db/ident :answer.type/image} :answer/value "images/b5/b595dff95f29976442a7a8fd0acf3baf2f518d364fa55b8e4ffb06e72745260f.png" :db/id #edb/ref 17592186241605} {:answer/id #uuid "60c5b9e6-103e-52e2-8714-ecc039182034" :answer/type {:db/ident :answer.type/image} :answer/value "images/ad/addd53cc78d53e0bb3ee5f5d51128afef8723186516db3aa092dcb97086d616f.png" :db/id #edb/ref 17592186242050} {:answer/id #uuid "a973148b-344b-55f6-81e2-a1c13ec0914b" :answer/type {:db/ident :answer.type/image} :answer/value "images/99/99e3776bfa4048703042970a2479a86c749e3e2a547dce966fceb23b671d66f2.png" :db/id #edb/ref 17592186242666}] :answer-field/correct {:answer/type {:db/ident :answer.type/image} :answer/value "images/99/99e3776bfa4048703042970a2479a86c749e3e2a547dce966fceb23b671d66f2.png" :db/id #edb/ref 17592186242666} :answer-field/id #uuid "e5ed46d1-368f-5b24-ba20-9cc1d85f091a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243837}] :question/id #uuid "bfe870e1-0d53-5aea-b526-5bbc780f92f2" :question/math-academy-id "q-106890" :question/problem "![](images/4a/4adc01d460f42f134f2e6c8da1e2fe516c8e6cfb64bcfeb7a5db89cf93f1fc11.png)\n\nThe vector $v$ is an eigenvector of a $2\\times 2$ matrix $C$ corresponding to the eigenvalue $-4.$ Find the vector $Cv.$" :question/worked-solution "The eigenvector $v=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}$ corresponds to the eigenvalue $\\lambda =-4.$ So, \n\n$$\n\\begin{aligned}Cv & =-4v.\\end{aligned}\n$$\n\nTherefore, we have the following picture:\n\n![](images/99/99e3776bfa4048703042970a2479a86c749e3e2a547dce966fceb23b671d66f2.png)"} {:db/id #edb/ref 17592186243974 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "144e1418-1f61-5afc-ae2e-1a2bd28b521b" :answer/type {:db/ident :answer.type/image} :answer/value "images/0b/0b7e76c47db52dff6dd985ef03fe1233f533249fb200fb63e4a0390cf98b7e34.png" :db/id #edb/ref 17592186241354} {:answer/id #uuid "46e6008e-cfb4-5732-ac47-58f970d1462b" :answer/type {:db/ident :answer.type/image} :answer/value "images/74/74419ef803ba73230d983d96fa36ff323a0a0a95f9f400f2409a4b29cbd40ac6.png" :db/id #edb/ref 17592186241821} {:answer/id #uuid "4b0560d0-a773-525c-b001-3ee242fae479" :answer/type {:db/ident :answer.type/image} :answer/value "images/9a/9ad126d502b24d3195cbe56948819119fde18adc217efd95d6b74c623958f8be.png" :db/id #edb/ref 17592186241855} {:answer/id #uuid "5ac82a69-f3c3-5ad3-bcac-29a46dafb36b" :answer/type {:db/ident :answer.type/image} :answer/value "images/23/234cbbc4a4179a09e4bf56f1c428b2d0135961d381f800bb0c87787c444