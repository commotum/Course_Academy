11fd9c4d20ac1db51687a7d4f3f77146eb53728de5.png)"} {:db/id #edb/ref 17592186386229 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cd35dae-4b0c-5adc-8bc4-a22cb37c512c" :answer/type {:db/ident :answer.type/image} :answer/value "images/a3/a3abd0ff1603a63a670252580ba7edb900b61e669aa12691ca912183c28899ea.png" :db/id #edb/ref 17592186386231} {:answer/id #uuid "8e249e6a-38e6-53b3-a3c0-63a0fa0ffcee" :answer/type {:db/ident :answer.type/image} :answer/value "images/0e/0e38721ff6fe7b75bef46079d0c877333a0113cbc782a12f61e09b832200943a.png" :db/id #edb/ref 17592186386232} {:answer/id #uuid "e5496c89-7d79-50b2-a456-45ec2257e5ff" :answer/type {:db/ident :answer.type/image} :answer/value "images/e4/e4ec74d60e6fdec5dec663ec4fe8f80ad9408817aa34afad916672a5221cdfad.png" :db/id #edb/ref 17592186386233} {:answer/id #uuid "a69b8d1f-f466-5e97-aedb-fe58ec99359b" :answer/type {:db/ident :answer.type/image} :answer/value "images/c5/c59aa1f83fb6808cb6ea5ea2905c120b4b6c2af3a4e3850dc20d7f550f0259eb.png" :db/id #edb/ref 17592186386234} {:answer/id #uuid "0f0fd56c-77d4-5a5e-81bc-85e9e915b29a" :answer/type {:db/ident :answer.type/image} :answer/value "images/ae/aeb84eb023dcc22cc0a7b7713c5a78f76ba5469cd147471c99af6197d7806c30.png" :db/id #edb/ref 17592186386235}] :answer-field/correct {:answer/type {:db/ident :answer.type/image} :answer/value "images/0e/0e38721ff6fe7b75bef46079d0c877333a0113cbc782a12f61e09b832200943a.png" :db/id #edb/ref 17592186386232} :answer-field/id #uuid "a20634f9-ffc3-50e6-810c-2409763e9ea9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386230}] :question/id #uuid "1f38fa3e-b402-5304-8378-88160f430aba" :question/math-academy-id "q-106886" :question/problem "![](images/59/59bb15a433f4f9299a240fd0c4d03797425994a0aa17d69fa81cf92e6f99cabc.png)\n\nThe vector $u$ is an eigenvector of a $2\\times 2$ matrix $B$ corresponding to the eigenvalue $\\frac{1}{2}.$ Find the vector $Bu.$" :question/worked-solution "The eigenvector $u=\\begin{bmatrix}4 \\\\ 4\\end{bmatrix}$ corresponds to the eigenvalue $\\lambda =\\frac{1}{2}.$ So, \n\n$$\n\\begin{aligned}Bu & =\\frac{1}{2}u.\\end{aligned}\n$$\n\nTherefore, we have the following picture:\n\n![](images/0e/0e38721ff6fe7b75bef46079d0c877333a0113cbc782a12f61e09b832200943a.png)"} {:db/id #edb/ref 17592186392017 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d7025706-5edb-5416-92d4-c3864a411c44" :answer/type {:db/ident :answer.type/image} :answer/value "images/8e/8e53fd4d2bcde7cbe59d4be00f8e6a14a9f3bc979388791c46e0faef3d51d158.png" :db/id #edb/ref 17592186392019} {:answer/id #uuid "8a226b1b-b31e-54f7-a43c-b81bf1cb7eda" :answer/type {:db/ident :answer.type/image} :answer/value "images/3c/3c202b0f2c679121f4c51a57514aea8a8d6bf5706e67e4d8986b9ec624a74574.png" :db/id #edb/ref 17592186392020} {:answer/id #uuid "1b3e8424-aba1-53e6-9522-8116ce095fef" :answer/type {:db/ident :answer.type/image} :answer/value "images/7e/7e74dbc626472e00e42db273ef7d005ec9b3103f8708214871912382fed66663.png" :db/id #edb/ref 17592186392021} {:answer/id #uuid "f1fea4dc-19dc-589a-973a-ef51baa4ef02" :answer/type {:db/ident :answer.type/image} :answer/value "images/22/221b02b2df0cd292a41593f52b96be20c0ed20c1b1ccad080157f4729d871f0c.png" :db/id #edb/ref 17592186392022} {:answer/id #uuid "cbaeacd0-a3d9-57e0-9905-3d6d4fd3a10e" :answer/type {:db/ident :answer.type/image} :answer/value "images/e5/e56f6feb61896097941f2df3ff6b38dff9972820180f571383635d29b95ba8bc.png" :db/id #edb/ref 17592186392023}] :answer-field/correct {:answer/type {:db/ident :answer.type/image} :answer/value "images/22/221b02b2df0cd292a41593f52b96be20c0ed20c1b1ccad080157f4729d871f0c.png" :db/id #edb/ref 17592186392022} :answer-field/id #uuid "b37c1798-9174-5ff1-b8c2-f0de21f94988" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392018}] :question/id #uuid "885a86b4-4c0a-595d-852f-a00f02fd8acf" :question/math-academ