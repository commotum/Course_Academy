\text{i}.$\n\nFinally, $\\text{Im}(k)=-3.$"} {:db/id #edb/ref 17592186351388 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08de7cad-4f07-5f29-802a-a2853256d6a3" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186348520} {:answer/id #uuid "3965ff4e-aca1-582e-bdb4-674e940237c4" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186348964} {:answer/id #uuid "80918e12-42e4-5785-8172-b32188ddb369" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186349627} {:answer/id #uuid "b622a8bb-849c-5455-b2ca-a6db026d3f90" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186350059} {:answer/id #uuid "de447b60-4196-5fec-a97d-be0498a5fff6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186350391}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186348964} :answer-field/id #uuid "195a5ad8-36ad-5400-9129-29bccfedcf67" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350752}] :question/id #uuid "0aa00a7d-3087-5697-a956-d960345470c5" :question/math-academy-id "q-82034" :question/problem "Find $\\text{Re}(k)$ given that\n$v=\\begin{bmatrix}-4+8\\text{i} \\\\ 4\\end{bmatrix}$\nand\n$\\overset{―}{kv}=\\begin{bmatrix}20 \\\\ -4+8\\text{i}\\end{bmatrix}.$" :question/worked-solution "Since $\\overset{―}{kv}=\\overset{―}{k}\\,\\overset{―}{v},$ we get the following equation:\n\n$$\n\\begin{aligned}\\overset{―}{kv} & =\\overset{―}{k}\\,\\overset{―}{v} \\\\ \\begin{bmatrix}20 \\\\ -4+8\\text{i}\\end{bmatrix} & =\\overset{―}{k}\\,\\overset{―}{\\begin{bmatrix}-4+8\\text{i} \\\\ 4\\end{bmatrix}} \\\\ \\begin{bmatrix}20 \\\\ -4+8\\text{i}\\end{bmatrix} & =\\overset{―}{k}\\,\\begin{bmatrix}\\overset{―}{-4+8\\text{i}} \\\\ \\overset{―}{4}\\end{bmatrix} \\\\ \\begin{bmatrix}20 \\\\ -4+8\\text{i}\\end{bmatrix} & =\\overset{―}{k}\\,\\begin{bmatrix}-4-8\\text{i} \\\\ 4\\end{bmatrix} \\\\ \\begin{bmatrix}20 \\\\ -4+8\\text{i}\\end{bmatrix} & =\\begin{bmatrix}(-4-8\\text{i})\\overset{―}{k} \\\\ 4\\overset{―}{k}\\end{bmatrix}\\end{aligned}\n$$\n\nSo, we obtain the system\n\n$$\n\\left\\{\\begin{aligned}(-4-8\\text{i})\\overset{―}{k} &=20 \\\\ 4\\overset{―}{k} &=-4+8\\text{i}.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get \n\n$$\n\\overset{―}{k}=-1+2\\text{i}.\n$$\n\nSubstituting this into the first equation, we obtain the true statement\n\n$$\n(-4-8\\text{i})(-1+2\\text{i})=20.\n$$\n\nTherefore, $k=\\overset{―}{-1+2\\text{i}}=-1-2\\text{i}.$\n\nFinally, $\\text{Re}(k)=-1.$"} {:db/id #edb/ref 17592186351392 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9cf3d78e-78a5-5275-b369-20bfdfc8daa1" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186349846} {:answer/id #uuid "b53572e6-1593-5cd1-8757-3f7d6a2385d8" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186350050} {:answer/id #uuid "c0ed25a0-e16e-5a28-9385-2b27f5eb22c5" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186350158} {:answer/id #uuid "e0a774e9-6c9e-5178-8220-82333071e2f1" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186350421} {:answer/id #uuid "eb806b0e-992e-5a23-9b9a-1bd20d563516" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186350503}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186349846} :answer-field/id #uuid "e237b058-9ff6-55e3-a1c5-adc06edb94c6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351103}] :question/id #uuid "bb226ea9-6300-5c4c-821f-9fcad56396d4" :question/math-academy-id "q-82077" :question/problem "Find $\\text{Im}(k)$ given that \n$v=\\begin{bmatrix}-2\\text{i} \\\\ 0\\end{bmatrix}$\nand\n$\\overset{―}{kv}=\\begin{bmatrix}4\\text{i}-12 \\\\ 0\\end{bmatrix}.$" :question/worked-solution "Since $\\overset{―}{kv}=\\overset{―}{k}\\,\\overset{―}{v},$ we get the following equation:\n\n$$\n\\begin{aligned}\\overset{―}{kv} & =\\overset{―}{k}\\,\\overset{―}{v} \\\\ \\begin{bmatrix}4\\text{i}-12 \\\\ 0\\end{bmatrix} & =\\overset{―}{k}\\,\\overset{―}{\\begin{bmatrix}-2\\text{i} \\\\ 0\\end{bmatrix}} \\\\ \\begin{bmatrix}4\\text{i}-12 \\\\ 0\\end{bmatrix} & =\\overset{―}{k}\\,\\begin{bmatrix}\\overset{―}{-2\\text{i}} \\\\ \\overset{―}{0}\\end{bmatrix} \\\\ \\begin{bmatrix}4\\text{i}-12 \\\\ 0\\end{bmatrix} & =\\overset{―}{k}\\,\\begin{bmatrix}2\\text{i} \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}4\\text{i}-12 \\\\ 0\\end{bmatrix} & =\\begin{bmatrix}2\\text{i}\\,\\overset{―}{k} \\\\ 0\\end{bmatrix}\\end{aligned}\n$$\n\nSo, we obtain that \n\n$$\n2\\text{i}\\,\\overset{―}{k}=4\\text{i}-12\\,⟹\\,\\overset{―}{k}=\\frac{4\\text{i}-12}{2\\text{i}}=2+6\\text{i}.\n$$\n\n \n\nTherefore, $k=\\overset{―}{2+6\\text{i}}=2-6\\text{i}.$\n\nFinally, $\\text{Im}(k)=-6.$"}] :knowledge-point/title "Finding the Real or Imaginary Part of a Scalar Given the Conjugate of a Scaled Vector"}] :topic/math-academy-id 2703 :topic/title "Vectors Over the Complex Numbers"}]}
