 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}-3 & 1 & 0 \\\\ 1 & -3 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-2I)x=0$ gives the eigenvector ${v}_{1}=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}.$ Dividing ${v}_{1}$ by its norm $‖{v}_{1}‖=1,$ we get \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{1}\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}.\n$$\n\n- For ${\\lambda }_{2}=0,$ we have\n\n$$\n\\begin{aligned}A-0I & =\\begin{bmatrix}-1 & 1 & 0 \\\\ 1 & -1 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}-0\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}-1 & 1 & 0 \\\\ 1 & -1 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-0I)x=0$ gives the eigenvector ${v}_{2}=\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}.$ Dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=\\sqrt{2},$ we get \n\n$$\n\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}.\n$$\n\n- For ${\\lambda }_{3}=-2,$ we have\n\n$$\n\\begin{aligned}A-(-2)I & =\\begin{bmatrix}-1 & 1 & 0 \\\\ 1 & -1 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}-(-2)\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}1 & 1 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 4\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-(-2)I)x=0$ gives the eigenvector ${v}_{3}=\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}.$ Dividing ${v}_{3}$ by its norm $‖{v}_{3}‖=\\sqrt{2},$ we get \n\n$$\n\\frac{{v}_{3}}{‖{v}_{3}‖}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}.\n$$\n\nFinally, we construct the orthogonal matrix $P$ in the usual way, and this gives us the following:\n\n$$\nP=\\begin{bmatrix}0 & \\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ 0 & \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ 1 & 0 & 0\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186551306 :question/answer-fields [{:answer-field/choices [{:answer/id 