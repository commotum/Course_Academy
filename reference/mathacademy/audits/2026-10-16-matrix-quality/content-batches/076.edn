ype/math} :answer/value "0" :db/id #edb/ref 17592186264773}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186264561} :answer-field/id #uuid "9f1eab7e-85f0-5e7d-8e0d-1cbda311994b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265527}] :question/id #uuid "e75516db-3e29-5932-a713-34d3ae018418" :question/math-academy-id "q-130898" :question/problem "Find $\\text{Im}(k)$ given that \n$v=\\begin{bmatrix}-2\\text{i} \\\\ 0\\end{bmatrix}$\nand\n$\\overset{―}{kv}=\\begin{bmatrix}-6+8\\text{i} \\\\ 0\\end{bmatrix}.$" :question/worked-solution "Since $\\overset{―}{kv}=\\overset{―}{k}\\,\\overset{―}{v},$ we get the following equation:\n\n$$\n\\begin{aligned}\\overset{―}{kv} & =\\overset{―}{k}\\,\\overset{―}{v} \\\\ \\begin{bmatrix}-6+8\\text{i} \\\\ 0\\end{bmatrix} & =\\overset{―}{k}\\,\\overset{―}{\\begin{bmatrix}-2\\text{i} \\\\ 0\\end{bmatrix}} \\\\ \\begin{bmatrix}-6+8\\text{i} \\\\ 0\\end{bmatrix} & =\\overset{―}{k}\\,\\begin{bmatrix}\\overset{―}{-2\\text{i}} \\\\ \\overset{―}{0}\\end{bmatrix} \\\\ \\begin{bmatrix}-6+8\\text{i} \\\\ 0\\end{bmatrix} & =\\overset{―}{k}\\,\\begin{bmatrix}2\\text{i} \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}-6+8\\text{i} \\\\ 0\\end{bmatrix} & =\\begin{bmatrix}2\\text{i}\\,\\overset{―}{k} \\\\ 0\\end{bmatrix}\\end{aligned}\n$$\n\nSo, we obtain that \n\n$$\n2\\text{i}\\,\\overset{―}{k}=-6+8\\text{i}\\,⟹\\,\\overset{―}{k}=\\frac{-6+8\\text{i}}{2\\text{i}}=4+3\\text{i}.\n$$\n\n \n\nTherefore, $k=\\overset{―}{4+3\\text{i}}=4-3\\text{i}.$\n\nFinally, $\\text{Im}(k)=-3.$"} {:db/id #edb/ref 17592186351384 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35d588af-a799-55c5-8a2a-d1ddb3fb48df" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186348932} {:answer/id #uuid "65bb9ed7-b30d-5a0c-9e23-71a02e317b61" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #ed