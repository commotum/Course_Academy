\\\\  & ∼\\begin{bmatrix}3 & 4 & 5 \\\\ -3 & 6 & 9 \\\\ -1 & \\,\\frac{1}{3}\\, & 0\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\nL=\\begin{bmatrix}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ -1 & \\frac{1}{3} & 1\\end{bmatrix},\\,U=\\begin{bmatrix}3 & 4 & 5 \\\\ 0 & 6 & 9 \\\\ 0 & 0 & 0\\end{bmatrix}.\n$$\n\nFinally, since ${l}_{32}=\\frac{1}{3}$ and ${u}_{23}=9,$ we get\n\n$$\n{l}_{32}\\cdot {u}_{23}=\\frac{1}{3}\\cdot 9=3.\n$$"} {:db/id #edb/ref 17592186411901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "494cbf01-713c-5663-a2da-33e813495f03" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186411880} {:answer/id #uuid "705238d7-555f-54c0-a30e-c2e7dcbb7c44" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186411882} {:answer/id #uuid "734861a3-6f53-5e0d-8af9-5e44fd9f5b90" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186411883} {:answer/id #uuid "9e390c2d-0fc5-5677-a64c-60e16c7edeec" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186411884} {:answer/id #uuid "b786fa8e-203f-54ed-8e4c-a222935189f0" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186411887}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186411887} :answer-field/id #uuid "4c93526b-1cb0-5535-b88c-d934ea49afbe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411897}] :question/id #uuid "52fdcc1a-681c-55e5-b7a8-d8d2c501b47c" :question/math-academy-id "q-106972" :question/problem "$$\nD=\\begin{bmatrix}-3 & 0 & 5 \\\\ -3 & -1 & 8 \\\\ 6 & -2 & -6\\end{bmatrix}\n$$\n\nIf $D=LU$ is the LU decomposition of the matrix $D$ given above, what is the value of ${l}_{32}\\cdot {u}_{23}?$" :question/worked-solution "Let's apply our standard LU factorization algorithm.\n\nWe reduce the matrix $D$ to row echelon form to obtain the matrix $U,$ as usual. However, instead of writing zeros below the main diagonal, we will instead write down the entries of the matrix $L.$\n\n$$\n\\begin{aligned}D & =\\begin{bmatrix}-3 & 0 & 5 \\\\ -3 & -1 & 8 \\\\ 6 & -2 & -6\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}-3 & 0 & 5 \\\\ 1 & -1 & 3 \\\\ 6 & -2 & -6\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}-3 & 0 & 5 \\\\ 1 & -1 & 3 \\\\ -2 & -2 & 4\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-2){R}_{2} \\\\  & ∼\\begin{bmatrix}-3 & 0 & 5 \\\\ 1 & -1 & 3 \\\\ -2 & \\,2\\, & -2\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\nL=\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ -2 & 2 & 1\\end{bmatrix},\\,U=\\begin{bmatrix}-3 & 0 & 5 \\\\ 0 & -1 & 3 \\\\ 0 & 0 & -2\\end{bmatrix}.\n$$\n\nFinally, since ${l}_{32}=2$ and ${u}_{23}=3,$ we get\n\n$$\n{l}_{32}\\cdot {u}_{23}=2\\cdot 3=6.\n$$"} {:db/id #edb/ref 17592186479080 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1de3f421-617e-54e9-a200-ecf2110d62e5" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186478605} {:answer/id #uuid "27585485-8e39-503b-b3bf-d9de1edbdf12" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186478619} {:answer/id #uuid "83ef1985-99d1-526e-b7ac-ac0f6518769c" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186478760} {:answer/id #uuid "85e3d2c2-81de-58ac-86f8-648fa07236a2" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186478766} {:answer/id #uuid "a37e20f8-0369-5e9d-be6b-155da86490a6" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186478828}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186478766} :answer-field/id #uuid "82057165-c988-5794-a93b-18b0b7a01084" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479008}] :question/id #uuid "36bc9725-a4bc-5564-8597-48a62e0034c6" :question/math-academy-id "q-106971" :question/problem "$$\nD=\\begin{bmatrix}-2 & 2 & 3 \\\\ -4 & 6 & 7 \\\\ 8 & -8 & -11\\end{bmatrix}\n$$\n\nIf $D=LU$ is the LU decomposition of the matrix $D$ given above, what is the value of ${l}_{31}\\cdot {u}_{22}?$" :question/worked-solution "Let's apply our standard LU factorization algorithm.\n\nWe reduce the matrix $D$ to row echelon form to obtain the matrix $U,$ as usual. However, instead of writing zeros below the main diagonal, we will instead write down the entries of the matrix $L.$\n\n$$\n\\begin{aligned}D & =\\begin{bmatrix}-2 & 2 & 3 \\\\ -4 & 6 & 7 \\\\ 8 & -8 & -11\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & 2 & 3 \\\\ 2 & 2 & 1 \\\\ 8 & -8 & -11\\end{bmatrix} & {R}_{3} & :={R}_{3}+4{R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & 2 & 3 \\\\ 2 & 2 & 1 \\\\ -4 & 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\nL=\\begin{bmatrix}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix},\\,U=\\begin{bmatrix}-2 & 2 & 3 \\\\ 0 & 2 & 1 \\\\ 0 & 0 & 1\\end{bmatrix}.\n$$\n\nFinally, since ${l}_{31}=-4$ and ${u}_{22}=2,$ we get\n\n$$\n{l}_{31}\\cdot {u}_{22}=(-4)\\cdot 2=-8.\n$$"} {:db/id #edb/ref 17592186489232 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "136c449c-f017-52df-a684-4a77861293e7" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186488512} {:answer/id #uuid "311bb2cb-1c16-509e-a16f-ac3c2eabb459" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186488575} {:answer/id #uuid "a68ca580-41ea-57ec-8b83-0d07b5a4a775" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186488802} {:answer/id #uuid "def3a16e-877c-5ac0-ad20-f7c4ea03de40" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186488934} {:answe