{k+1} & {5}^{k+1}-1 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186417979}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{5}^{k} & {5}^{k}-1 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186417949} :answer-field/id #uuid "c63baf61-973f-5c74-8a0b-848888371d8d" :answer-field/key "field-9" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186418032} {:answer-field/choices [{:answer/id #uuid "1b90bff6-346f-5d40-862c-a32f0d2b13c5" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186417890} {:answer/id #uuid "37d24cd6-e48c-5744-bc2e-c6ffcc6309c2" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186417899}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186417899} :answer-field/id #uuid "cef68933-0d26-56ef-9914-b23570df9634" :answer-field/key "field-6" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186418033} {:answer-field/choices [{:answer/id #uuid "4b3886e2-9559-5ae8-b683-01da6dea3a03" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{5}^{k+1} & {5}^{k+1} \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186417915} {:answer/id #uuid "549f1de1-92e0-5d4b-a6c6-2b9472560535" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{5}^{k+1} & {5}^{k+1}-1 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186417920} {:answer/id #uuid "7f25af9c-d0e6-581c-a6b4-0064920b5a39" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{5}^{k+1}-1 & {5}^{k+1} \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186417947} {:answer/id #uuid "baef69d3-0ff8-5b39-b9dd-f341b1ea1347" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{5}^{k} & {5}^{k}-1 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186417971} {:answer/id #uuid "c26638ab-01b8-5ad5-bbff-fbe208c4e346" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{5}^{k}-1 & {5}^{k} \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186417976} {:answer/id #uuid "e7b8dc44-9922-5eab-a193-e5941eaffc7b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{5}^{k} & {5}^{k} \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186417989}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{5}^{k+1} & {5}^{k+1}-1 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186417920} :answer-field/id #uuid "ddde9c74-8ce3-5393-98df-21bcc8a76326" :answer-field/key "field-14" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186418035} {:answer-field/choices [{:answer/id #uuid "30eb0aa7-a2bd-5ddd-bd7a-6506e5460aaa" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{5}^{k+1} & {5}^{k+1} \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186417896} {:answer/id #uuid "42355f85-ec1c-5bdc-b2c0-d0fbd78382e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{5}^{k+1} & {5}^{k+1}-1 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186417911} {:answer/id #uuid "6d8eb9b2-c4ee-52c0-9a15-0c08478fb598" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{5}^{k} & {5}^{k}-1 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186417932} {:answer/id #uuid "8eb7be41-b26b-5ad7-91ce-c77f512e7246" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{5}^{k} & {5}^{k} \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186417954} {:answer/id #uuid "afcdb90d-6aac-5e25-a0ef-50dd465e34d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{5}^{k+1}-1 & {5}^{k+1} \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186417966} {:answer/id #uuid "ef225a55-d283-53b6-9b17-ad170d471e7e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1-{5}^{k} & {5}^{k} \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186417992}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{5}^{k} & {5}^{k}-1 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186417932} :answer-field/id #uuid "ea38e294-3965-5505-9e35-91a41d781483" :answer-field/key "field-12" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186418036}] :question/id #uuid "d15324a3-fbaa-5825-b749-4eff694b4d05" :question/math-academy-id "q-183878" :question/problem "Use mathematical induction to prove that\n${\\begin{bmatrix}5 & 4 \\\\ 0 & 1\\end{bmatrix}}^{n}=\\begin{bmatrix}{5}^{n} & {5}^{n}-1 \\\\ 0 & 1\\end{bmatrix}$\nfor all $n\\in N.$\n\nWe proceed using induction on $n.$\n\n**Base Case**: We first prove that our statement is true for the base case $n=$ {{field-1}}.\n\nFor the left-hand side, we have\n\n$$\n{{field-2}}={{field-3}}\n$$\n\nand for the right-hand side, we have\n\n$$\n{{field-4}}={{field-5}}.\n$$\n\nThus, our statement is {{field-6}} for $n=1.$\n\n**Inductive Hypothesis**: We assume that for some $n=$ {{field-7}}, we have\n\n$$\n{{field-8}}={{field-9}}.\n$$\n\n**Inductive Step**: To prove $P(k+1),$ we write\n\n$$\n\\begin{aligned}{{field-10}} & ={{field-11}}\\cdot \\begin{bmatrix}5 & 4 \\\\ 0 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nBy the inductive hypothesis, we have\n\n$$\n\\begin{aligned}{\\begin{bmatrix}5 & 4 \\\\ 0 & 1\\end{bmatrix}}^{k}\\cdot \\begin{bmatrix}5 & 4 \\\\ 0 & 1\\end{bmatrix} & ={{field-12}}\\cdot \\begin{bmatrix}5 & 4 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={{field-13}} \\\\  & ={{field-14}},\\end{aligned}\n$$\n\nas required. \n\nTherefore, by the principle of induction,\n${\\begin{bmatrix}5 & 4 \\\\ 0 & 1\\end{bmatrix}}^{n}=\\begin{bmatrix}5 & {5}^{n}-1 \\\\ 0 & {5}^{n}\\end{bmatrix}$\nis true for all {{field-15}}." :question/worked-solution "The principle of induction states the following: Suppose we have a sequence of mathematical statements $P(1),P(2),P(3),…,$ where\n\n- $P(1)$ is true, and\n\n- $P(k)⇒P(k+1)$ for every $k\\in N.$\n\nThen, $P(n)$ is true for every $n\\in N.$\n\nIn this case, the general statement $P(n)$ we're required to prove is the following:\n\n$$\n{\\begin{bmatrix}5 & 4 \\\\ 0 & 1\\end{bmatrix}}^{n}=\\begin{bmatrix}{5}^{n} & {5}^{n}-1 \\\\ 0 & 1\\end{bmatrix}.\n$$\n\nWe start by proving the base case, $P(1).$ To do this, we substitute $n=1$ into both the left-hand side and right-hand side and show that they're equal:\n\nWe proceed using induction on $n.$\n\n**Base Case**: We first prove our statement is true for the base case $n=1.$\nFor the left-hand side, we have\n\n$$\n\\begin{aligned}{\\begin{bmatrix}5 & 4 \\\\ 0 & 1\\end{bmatrix}}^{1}=\\begin{bmatrix}5 & 4 \\\\ 0 & 1\\end{bmatrix},\\end{aligned}\n$$\n\nand for the right-hand side, we have\n\n$$\n\\begin{aligned}\\begin{bmatrix}{5}^{1} & {5}^{1}-1 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}5 & 4 \\\\ 0 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nThus, our statement is true for $n=1.$ \n\nNext, we state our inductive hypothesis. Here, we assume that the given statement is true for some $n=k\\ge 1.$\n\n**Inductive Hypothesis**: We assume that for some $n=k\\ge 1,$ we have\n\n$$\n{\\begin{bmatrix}5 & 4 \\\\ 0 & 1\\end{bmatrix}}^{k}=\\begin{bmatrix}{5}^{k} & {5}^{k}-1 \\\\ 0 & 1\\end{bmatrix}.\n$$\n\nWe must show that $P(k)⇒P(k+1).$ Let's start by writing down $P(k+1).$ This is the first part of the **inductive step**.\n\n**Inductive Step**: We're required to prove that\n\n$$\n{\\begin{bmatrix}5 & 4 \\\\ 0 & 1\\end{bmatrix}}^{k+1}=\\begin{bmatrix}{5}^{k+1} & {5}^{k+1}-1 \\\\ 0 & 1\\end{bmatrix}.\\,\\,(∗)\n$$\n\nThe idea is to rewrite the left-hand side of $(∗)$ *using the inductive hypothesis* and apply algebraic techniques to show that this equals the right-hand side.\n\nWhen proving matrix identities using induction, the key to unlocking the proof is to factor out one instance of the matrix, as follows: \n\n$$\n{\\begin{bmatrix}5 & 4 \\\\ 0 & 1\\end{bmatrix}}^{k+1}={\\begin{bmatrix}5 & 4 \\\\ 0 & 1\\end{bmatrix}}^{k}\\cdot \\begin{bmatrix}5 & 4 \\\\ 0 & 1\\end{bmatrix}\n$$\n\nLet's apply this technique in this case:\n\nWe write\n\n$$\n\\begin{aligned}{\\begin{bmatrix}5 & 4 \\\\ 0 & 1\\end{bmatrix}}^{k+1} & ={\\begin{bmatrix}5 & 4 \\\\ 0 & 1\\end{bmatrix}}^{k}\\cdot \\begin{bmatrix}5 & 4 \\\\ 0 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nBy the inductive hypothesis, we have\n\n$$\n\\begin{aligned}{\\begin{bmatrix}5 & 4 \\\\ 0 & 1\\end{bmatrix}}^{k}\\cdot \\begin{bmatrix}5 & 4 \\\\ 0 & 1\\end{bmatrix} & =\\begin{bmatrix}{5}^{k} & {5}^{k}-1 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}5 & 4 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}5({5}^{k}) & 4({5}^{k})+({5}^{k}-1) \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}{5}^{k}\\cdot {5}^{1} & {5}^{k}\\cdot {5}^{1}-1 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}{5}^{k+1} & {5}^{k+1}-1 \\\\ 0 & 1\\end{bmatrix},\\end{aligned}\n$$\n\nas required.\n\nSince we've shown that the left-hand side of $(∗)$ equals the right-hand side, our proof is complete. So let's write down our conclusion.\n\nTherefore, by the principle of induction,\n${\\begin{bmatrix}5 & 4 \\\\ 0 & 1\\end{bmatrix}}^{n}=\\begin{bmatrix}{5}^{n} & {5}^{n}-1 \\\\ 0 & 1\\end{bmatrix}$\nis true for all $n\\ge 1.$"}] :knowledge-point/title "Proving Matrix Identities"}] :topic/math-academy-id 781 :topic/title "Proving Matrix Identities Using Induction"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186088514} :activity/id #uuid "0c5859d1-4ff1-5efe-90ef-d19961e8bcc4" :activity/steps [{:db/id #edb/ref 17592186088514 :step/content {:db/id #edb/ref 17592186088889 :tutorial/content "In mathematics, rectangular arrays containing numbers are called **matrices**. \n\nAs an example, consider the matrix $A$ below:\n\n$$\nA = \\begin{bmatrix}2 & 1 & 3 \\\\ 4 & -1 & 2 \\\\ 1 & -4 & 6\\end{bmatrix}\n$$\n\nThis particular matrix has $3$ rows and $3$ columns. The numbers in the matrix are called **entries** or **elements.**\n\nThe number of rows and columns in a matrix does not need to be the same. For example, consider another matrix that has $3$ rows and $4$ columns:\n\n$$\nM = \\begin{bmatrix}-1 & 13 & 4 & 2 \\\\ 0 & -1 & 3 & 0 \\\\ 3 & 1 & 2 & -5\\end{bmatrix}\n$$\n\nThe **dimensions** of the matrix are the number of rows and the number of columns. For example, the matrix $M$ shown above has $3$ rows and $4$ columns. So, we write the dimensions of $M$ as $3 \\times 4$ (read as \"three by four\")." :tutorial/id #uuid "d68f01b8-8bc6-59a1-8d80-d284abbcdf6e" :tutorial/math-academy-id 2968 :tutorial/title "Introduction"} :step/id #uuid "22697b73-625d-545a-ba00-223291b29933" :step/next {:db/id #edb/ref 17592186088534}} {:db/id #edb/ref 17592186088515 :step/content {:db/id #edb/ref 17592186087693 :knowledge-point/id #uuid "f6ae25fc-16eb-598b-a288-742e4b46cb12"} :step/id #uuid "b1b7d3eb-f611-589c-99d3-92b8c28fd2c4" :step/next {:db/id #edb/ref 17592186088522}} {:db/id #edb/ref 17592186088516 :step/content {:db/id #edb/ref 17592186087694 :knowledge-point/id #uuid "34fd903a-fa34-57b0-a098-08fa1cbd4f95"} :step/id #uuid "17d76850-618a-5b25-88fc-fc5296c2deb2" :step/next {:db/id #edb/ref 17592186088549}} {:db/id #edb/ref 17592186088522 :step/content {:db/id #edb/ref 17592186088891 :tutorial/content "Some matrices have only one column, for instance\n\n$$\nA = \\begin{bmatrix}-1 \\\\ 13\\end{bmatrix}\n$$\n\n$$\nB = \\begin{bmatrix}0 \\\\ -1 \\\\ 3 \\\\ 0\\end{bmatrix}\n$$\n\n$$\nC = \\begin{bmatrix}3 \\\\ 1 \\\\ 2\\end{bmatrix}\n$$\n\nHere, $A$ is a $2\\times 1$ matrix, $B$ is a $4\\times 1$ matrix, and $C$ is a $3\\times 1$ matrix. These types of matrices are often called **column vectors**.\n\nOther matrices have only one row, for instance\n\n$$\nD = \\begin{bmatrix}-1 & 0\\end{bmatrix}\n$$\n\n$$\nE = \\begin{bmatrix}13 & -1 & 1\\end{bmatrix}\n$$\n\n$$\nF = \\begin{bmatrix}-1 & 0 & 3 & 1\\end{bmatrix}\n$$\n\nHere, $D$ is a $1\\times 2$ matrix, $E$ is a $1\\times 3$ matrix, and $F$ is a $1\\times 4$ matrix. These types of matrices are often called **row vectors**.\n\n**Note:** Every number can be thought of as a $1\\times 1$ matrix. For instance, we can consider the number $5$ as the matrix\n\n$$\n\\begin{bmatrix}5\\end{bmatrix}\n$$" :tutorial/id #uuid "1628e679-983a-5be7-9af6-81f0f45fa29a" :tutorial/math-academy-id 2984 :tutorial/title "Matrices With One Row or Column"} :step/id #uuid "1f0e819b-30a9-5921-8910-450a2910edb7" :step/next {:db/id #edb/ref 17592186088516}} {:db/id #edb/ref 17592186088534 :step/content {:db/id #edb/ref 17592186088898 :tutorial/content "A **square matrix** is a matrix where the number of rows is equal to the number of columns.\n\nFor example, the matrix\n\n$$\n\\begin{bmatrix}3 & -1 \\\\ 2 & 5\\end{bmatrix}\n$$\n\nis a square matrix because it has $2$ rows and $2$ columns. Its dimensions are $2 \\times 2.$\n\nIn general, the dimensions of a square matrix are $n \\times n.$" :tutorial/id #uuid "06286713-0de9-5c18-959f-04de81bee510" :tutorial/math-academy-id 3115 :tutorial/title "Square Matrices"} :step/id #uuid "15b361ac-babf-50db-b55f-4a4ad993eb69" :step/next {:db/id #edb/ref 17592186088515}} {:db/id #edb/ref 17592186088549 :step/content {:db/id #edb/ref 17592186087713 :knowledge-point/id #uuid "ed7286fe-b6e2-5544-8bc6-86afc6cdb813"} :step/id #uuid "b0393a9e-8102-5d2d-8b20-ac2709992291" :step/next {:db/id #edb/ref 17592186088725}} {:db/id #edb/ref 17592186088725 :step/content {:db/id #edb/ref 17592186088984 :tutorial/content "Matrices arise naturally in *many* real-world problems. Weather forecasting, image processing and computer graphics, video games, and online customization algorithms are just a few of the many applications of matrices. \n\nLet's consider an example where we can use a matrix to model bus routes in a city. \n\nThe diagram below shows the bus routes between three stations (Station A, Station B, and Station C) in a particular city, where $A, B,$ and $C$ represent the stations and the arrows represent the directed routes between them. \n\n![](images/cb/cbdf5c2470229ae3ba10ee18bccd2dc764407897397466b157474bf2b819f5d9.png)\n\nNote that the circles $A,B,$ and $C$ in our diagram are called **nodes**.\n\nWe wish to represent this same diagram using a matrix. Let's start by putting this information into a table like the one below:\n\n<div class=\"route-matrix\">\n  <span class=\"matrix-to\">To</span>\n  <span class=\"matrix-from\">From</span>\n  <table aria-label=\"Route matrix: rows are From stations; columns are To stations\">\n    <thead>\n      <tr><td class=\"matrix-corner\"></td><th scope=\"col\">A</th><th scope=\"col\">B</th><th scope=\"col\">C</th></tr>\n    </thead>\n    <tbody>\n      <tr><th scope=\"row\">A</th><td></td><td></td><td></td></tr>\n      <tr><th scope=\"row\">B</th><td></td><td></td><td></td></tr>\n      <tr><th scope=\"row\">C</th><td></td><td></td><td></td></tr>\n    </tbody>\n  </table>\n</div>\n\nLet's now fill in the rows of our table. We begin by considering all of the bus routes from Station A to the other stations:\n\n- There are $\\color{blue}0$ bus routes from $A$ to itself.\n\n- There is $\\color{blue}1$ bus route from $A$ to $B.$\n\n- There is $\\color{blue}1$ bus route from $A$ to $C.$\n\nFilling in the first row of the table, we get the following:\n\n<div class=\"route-matrix\">\n  <span class=\"matrix-to\">To</span>\n  <span class=\"matrix-from\">From</span>\n  <table aria-label=\"Route matrix: rows are From stations; columns are To stations\">\n    <thead>\n      <tr><td class=\"matrix-corner\"></td><th scope=\"col\">A</th><th scope=\"col\">B</th><th scope=\"col\">C</th></tr>\n    </thead>\n    <tbody>\n      <tr><th scope=\"row\">A</th><td>$\\color{blue} 0$</td><td>$\\color{blue} 1$</td><td>$\\color{blue} 1$</td></tr>\n      <tr><th scope=\"row\">B</th><td></td><td></td><td></td></tr>\n      <tr><th scope=\"row\">C</th><td></td><td></td><td></td></tr>\n    </tbody>\n  </table>\n</div>\n\nFilling in the remaining rows in the same way, we get:\n\n<div class=\"route-matrix\">\n  <span class=\"matrix-to\">To</span>\n  <span class=\"matrix-from\">From</span>\n  <table aria-label=\"Route matrix: rows are From stations; columns are To stations\">\n    <thead>\n      <tr><td class=\"matrix-corner\"></td><th scope=\"col\">A</th><th scope=\"col\">B</th><th scope=\"col\">C</th></tr>\n    </thead>\n    <tbody>\n      <tr><th scope=\"row\">A</th><td>$0$</td><td>$1$</td><td>$1$</td></tr>\n      <tr><th scope=\"row\">B</th><td>$0$</td><td>$1$</td><td>$2$</td></tr>\n      <tr><th scope=\"row\">C</th><td>$1$</td><td>$0$</td><td>$0$</td></tr>\n    </tbody>\n  </table>\n</div>\n\nFinally, keeping only the essential information, we obtain the following matrix:\n\n$$\n\\begin{bmatrix}0 & 1 & 1 \\\\ 0 & 1 & 2 \\\\ 1 & 0 & 0\\end{bmatrix}\n$$" :tutorial/id #uuid "523d25fd-6b49-5cd7-ac05-80ac6fa0f3d8" :tutorial/math-academy-id 6114 :tutorial/title "Using Matrices for Modeling"} :step/id #uuid "f1c6aa85-8a73-5586-afeb-0d6c77ff0b9a" :step/next {:db/id #edb/ref 17592186088726}} {:db/id #edb/ref 17592186088726 :step/content {:db/id #edb/ref 17592186087819 :knowledge-point/id #uuid "10ca3efc-7d23-5bc1-ab41-f785bed69986"} :step/id #uuid "e1afb939-c40e-55de-8823-355f35294017"}] :activity/title "Introduction to Matrices" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186087928} {:activity/first-step {:db/id #edb/ref 17592186565584} :activity/id #uuid "890c858e-36d1-46f6-90b9-7f588fcbc1d1" :activity/steps [{:db/id #edb/ref 17592186565584 :step/content {:db/id #edb/ref 17592186335982 :question/id #uuid "0dae081d-1261-53c2-a70c-664b771975ed"} :step/id #uuid "ba44f723-4c23-4ab7-ae24-b1e2b50ad936" :step/next {:db/id #edb/ref 17592186565585}} {:db/id #edb/ref 17592186565585 :step/content {:db/id #edb/ref 17592186403328 :question/id #uuid "69d9ccdc-d7b6-5ce9-82c3-15199547a51a"} :step/id #uuid "05be139a-04a3-428f-ab3d-b95a5996afdd" :step/next {:db/id #edb/ref 17592186565586}} {:db/id #edb/ref 17592186565586 :step/content {:db/id #edb/ref 17592186271964 :question/id #uuid "cf86f867-a1a5-56dc-89e8-e2255e71399b"} :step/id #uuid "c0c87acc-b024-410c-9c28-35552a82e60b" :step/next {:db/id #edb/ref 17592186565587}} {:db/id #edb/ref 17592186565587 :step/content {:db/id #edb/ref 17592186299755 :question/id #uuid "face06b0-e4cd-5e41-a4e9-d0f1cb43a379"} :step/id #uuid "b4f59960-c56f-4510-b27d-54573efe3587" :step/next {:db/id #edb/ref 17592186565588}} {:db/id #edb/ref 17592186565588 :step/content {:db/id #edb/ref 17592186259826 :question/id #uuid "85229588-ff49-5ee6-8e12-af80849ca1af"} :step/id #uuid "217ef9e8-9527-4c36-8fee-1053efc7de7c"}] :activity/title "Review: Introduction to Matrices" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186565583}] :db/id #edb/ref 17592186048896 :topic/knowledge-points [{:db/id #edb/ref 17592186087693 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087500 :question/id #uuid "6587b5f1-8a44-556a-a95e-20c54dfebc04" :question/math-academy-id "e-4367" :question/problem "What are the dimensions of the matrix ${A},$ where \n\n$$\n\\begin{bmatrix}4 & 5 & 1 \\\\ -2 & 0 & 6 \\\\ 3 & 2 & -5 \\\\ 5 & 1 & 7\\end{bmatrix}\n$$" :question/worked-solution "The matrix ${A}$ has $4$ rows and $3$ columns. Therefore, its dimensions are $4\\times 3.$"} :knowledge-point/id #uuid "f6ae25fc-16eb-598b-a288-742e4b46cb12" :knowledge-point/question-generator {:db/id #edb/ref 17592186476176 :question-generator/id #uuid "5ce766ed-134d-55db-a9c4-b43efc8dfd3b" :question-generator/script "generate/scratch/17592186087693.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186087982 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2920f12-2ec4-5b28-9554-5e61dd2128da" :answer/type {:db/ident :answer.type/math} :answer/value "4 \\times 2" :db/id #edb/ref 17592186084627} {:answer/id #uuid "fca8ae2e-b122-5d5b-b86f-0660a8d466a1" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\times 4" :db/id #edb/ref 17592186084628} {:answer/id #uuid "0fac330d-727e-5fd3-bbfe-2a4a4119535d" :answer/typ