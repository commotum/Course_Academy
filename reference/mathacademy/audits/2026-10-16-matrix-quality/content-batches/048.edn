\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =\\begin{vmatrix}3 & \\frac{\\sqrt{5}}{3} \\\\ 0 & 0\\end{vmatrix} \\\\  & =3\\cdot 0-\\frac{\\sqrt{5}}{3}\\cdot 0 \\\\  & =0\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,0\\,|=0\n$$"} {:db/id #edb/ref 17592186336023 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14b2d06b-3284-5a66-b19f-0ef1487efd55" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186333169} {:answer/id #uuid "59481f19-f93f-54e7-a387-8489d37d3666" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186333807} {:answer/id #uuid "721fbb4a-b7a4-57c9-85d5-fcb362a99666" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186334022} {:answer/id #uuid "bea8278f-ff07-5579-807d-e7f81a1533c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186334640} {:answer/id #uuid "cc1fb416-02c1-53e8-b9db-4fbb6440bf06" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186334769}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186334769} :answer-field/id #uuid "fe804b3c-eb9b-5f42-827e-0f83f2544867" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335685}] :question/id #uuid "a101db17-b08e-5c17-8786-6539ae6cbc0e" :question/math-academy-id "q-69943" :question/problem "Calculate the area of the parallelogram spanned by $\\text{u}=\\begin{bmatrix}4 \\\\ \\frac{1}{3}\\end{bmatrix}$ and $\\text{v}=\\begin{bmatrix}6 \\\\ \\frac{1}{2}\\end{bmatrix}.$" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=\\begin{bmatrix}4 & 6 \\\\ \\frac{1}{3} & \\frac{1}{2}\\end{bmatrix}\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =\\begin{vmatrix}4 & 6 \\\\ \\frac{1}{3} & \\frac{1}{2}\\end{vmatrix} \\\\  & =4\\cdot \\frac{1}{2}-6\\cdot \\frac{1}{3} \\\\  & =2-2 \\\\  & =0\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,0\\,|=0\n$$"} {:db/id #edb/ref 17592186336024 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07d0c55c-300e-541b-9c31-0795f27c6911" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186333065} {:answer/id #uuid "723312a8-cb00-5166-9da5-9ccb03edca58" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186334023} {:answer/id #uuid "791da30c-20af-5d83-b23a-e51fad1056b1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186334077} {:answer/id #uuid "acfdc006-65c8-5dc9-a413-a8865a1fa6ae" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186334511} {:answer/id #uuid "ff177131-3521-57ad-889d-79da13e8ee08" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186335233}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186334077} :answer-field/id #uuid "58998a66-3732-5515-a658-7040cd93b92f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335415}] :question/id #uuid "92767c82-7016-540a-a963-df010d8da1b2" :question/math-academy-id "q-69945" :question/problem "Calculate the area of the parallelogram spanned by $\\text{u}=⟨-1,-2⟩$ and $\\text{v}=⟨3,6⟩.$" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=\\begin{bmatrix}-1 & 3 \\\\ -2 & 6\\end{bmatrix}\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =\\begin{vmatrix}-1 & 3 \\\\ -2 & 6\\end{vmatrix} \\\\  & =(-1)\\cdot 6-3\\cdot (-2) \\\\  & =-6+6 \\\\  & =0\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,0\\,|=0\n$$"} {:db/id #edb/ref 17592186336025 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1949a4de-c812-5072-95ba-5ca1acc38a34" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186333220} {:answer/id #uuid "5072c3c1-6a38-59b1-ab30-b0e796a30b24" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186333722} {:answer/id #uuid "7c20c4e2-d46e-53a3-a715-970b210bf453" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186334098} {:answer/id #uuid "d3988da9-7004-5644-aa59-103a31972103" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186334844} {:answer/id #uuid "f2ad36fa-50d8-5246-9fe7-83f484f60cda" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186335114}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186335114} :answer-field/id #uuid "57d6563e-a550-56cd-86eb-ddc3caa46b33" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335413}] :question/id #uuid "16ddeea5-cbc1-599e-ac3c-ae0bcf472762" :question/math-academy-id "q-69946" :question/problem "Calculate the area of the parallelogram spanned by $\\text{u}=\\begin{bmatrix}-2 \\\\ 4\\end{bmatrix}$ and $\\text{v}=\\begin{bmatrix}\\frac{1}{4} \\\\ -\\frac{1}{2}\\end{bmatrix}.$" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=\\begin{bmatrix}-2 & \\frac{1}{4} \\\\ 4 & -\\frac{1}{2}\\end{bmatrix}\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =\\begin{vmatrix}-2 & \\frac{1}{4} \\\\ 4 & -\\frac{1}{2}\\end{vmatrix} \\\\  & =(-2)\\cdot (-\\frac{1}{2})-\\frac{1}{4}\\cdot 4 \\\\  & =1-1 \\\\  & =0\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,0\\,|=0\n$$"} {:db/id #edb/ref 17592186385167 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1056e378-d24a-52e1-8f1c-c7347c129259" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186385169}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186385169} :answer-field/id #uuid "c51475f4-4479-5e0c-82f3-531ab72e5ece" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186385168}] :question/id #uuid "cbab4261-a7b7-5038-82e3-1c16585246bf" :question/math-academy-id "q-316316" :question/problem "Given that the area spanned between the vectors $\\text{u}=⟨2,4⟩$ and $\\text{v}=⟨1,a⟩$ equals zero, what is the value of $a?$\n\n$a=$\n{{field-1}}" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=\\begin{bmatrix}2 & 1 \\\\ 4 & a\\end{bmatrix}\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =\\begin{vmatrix}2 & 1 \\\\ 4 & a\\end{vmatrix} \\\\  & =2\\cdot a-1\\cdot 4 \\\\  & =2a-4\\end{aligned}\n$$\n\nFinally, setting the expression for the determinant equal to $0$ and solving for $a,$ we get\n\n$$\n\\begin{aligned}2a-4 & =0 \\\\ 2a & =4 \\\\ a & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186385170 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4c6ca74-2caa-55ff-9444-6529e60d11c7" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186385172}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186385172} :answer-field/id #uuid "e5ad92f1-0bf0-5997-8d7b-80739f643b06" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186385171}] :question/id #uuid "429fe8f8-3824-533b-9d1a-5e0e8340c4c0" :question/math-academy-id "q-320549" :question/problem "Given that the area spanned between the vectors $\\text{u}=\\begin{bmatrix}7 \\\\ \\frac{5}{2}\\end{bmatrix}$ and $\\text{v}=\\begin{bmatrix}a \\\\ 5\\end{bmatrix}$ equals zero, what is the value of $a?$\n\n$a=$\n{{field-1}}" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=\\begin{bmatrix}7 & a \\\\ \\frac{5}{2} & 5\\end{bmatrix}\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =\\begin{vmatrix}7 & a \\\\ \\frac{5}{2} & 5\\end{vmatrix} \\\\  & =7\\cdot 5-a\\cdot \\frac{5}{2} \\\\  & =35-\\frac{5a}{2}\\end{aligned}\n$$\n\nFinally, setting the expression for the determinant equal to $0$ and solving for $a,$ we get\n\n$$\n\\begin{aligned}35-\\frac{5a}{2} & =0 \\\\ \\frac{5a}{2} & =35 \\\\ 5a & =70 \\\\ a & =14.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186385480 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c0b9fbaf-f64d-5ad3-abb4-a017cae7c08a" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186385482} {:answer/id #uuid "f66cfb9d-8d11-52f7-9251-406ca3edbde5" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186385483} {:answer/id #uuid "a4881b3c-27ee-53a8-9aee-4fdff5041ea2" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186385484} {:answer/id #uuid "0a151ece-41ef-559c-ac72-9ef593d818b8" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186385485} {:answer/id #uuid "b0cdfb72-e738-5857-8baa-b369b5157864" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186385486}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186385485} :answer-field/id #uuid "50856e24-66d6-5b25-8a35-6874e33d50cc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385481}] :question/id #uuid "76732d75-a5e9-599d-a9e7-e86abdbbc8a0" :question/math-academy-id "q-69939" :question/problem "Calculate the area of the parallelogram spanned by $\\text{u}=⟨4,1⟩$ and $\\text{v}=⟨-6,-\\frac{3}{2}⟩.$" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=\\begin{bmatrix}4 & -6 \\\\ 1 & -\\frac{3}{2}\\end{bmatrix}\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =\\begin{vmatrix}4 & -6 \\\\ 1 & -\\frac{3}{2}\\end{vmatrix} \\\\  & =4\\cdot (-\\frac{3}{2})-(-6)\\cdot 1 \\\\  & =-6+6 \\\\  & =0\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,0\\,|=0\n$$"}] :knowledge-point/title "Calculating the Area of the Parallelogram Spanned by Two Parallel Vectors"}] :topic/math-academy-id 1169 :topic/title "The Geometric Interpretation of the 2x2 Determinant"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186101859} :activity/id #uuid "d0d06916-b04a-5057-b794-744d1e7a0e9f" :activity/steps [{:db/id #edb/ref 17592186101859 :step/content {:db/id #edb/ref 17592186101954 :tutorial/content "If we want to add (or subtract) three or more matrices, all operations should be done elementwise. For example, suppose\n\n$$\n\\begin{bmatrix}1 \\\\ 1 \\\\ -1\\end{bmatrix}\n$$\n\nThen we can calculate ${A}+{B}-{C}$ by performing the operations on each corresponding entry, as follows:\n\n$$\n\\begin{aligned}A+B-C & =\\begin{bmatrix}1 \\\\ 1 \\\\ -1\\end{bmatrix}+\\begin{bmatrix}-1 \\\\ 2 \\\\ 0\\end{bmatrix}-\\begin{bmatrix}0 \\\\ 5 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1+(-1)-0 \\\\ 1+2-5 \\\\ -1+0-(-2)\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ -2 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$" :tutorial/id #uuid "f6d0bdee-d80b-596a-bef2-41b2d6429eeb" :tutorial/math-academy-id 2973 :tutorial/title "Introduction"} :step/id #uuid "843ddc26-4ece-5c0c-b76f-eb3b2ae356b8" :step/next {:db/id #edb/ref 17592186101860}} {:db/id #edb/ref 17592186101860 :step/content {:db/id #edb/ref 17592186100991 :knowledge-point/id #uuid "667ac53c-36b8-56a0-9699-fe27c8373c6b"} :step/id #uuid "407278d3-c813-5ac8-8cf6-2aa214dd6409" :step/next {:db/id #edb/ref 17592186101861}} {:db/id #edb/ref 17592186101861 :step/content {:db/id #edb/ref 17592186101955 :tutorial/content "Since addition and subtraction of matrices are performed elementwise, they have the same properties as addition and subtraction of real numbers.\n\nFor example, if $A,$ $B,$ and $C$ are three $m \\times n$ matrices then we can add them in any order:\n\n$$\n(A+B)+C = A+(B+C) = A+B+C\n$$\n\nMoreover, we can distribute a subtraction over matrices in parentheses:\n\n$$\nA - (B + C) = A - B - C\n$$" :tutorial/id #uuid "fe03e3b3-f2de-50f5-b0cc-b62f7b295f8d" :tutorial/math-academy-id 2974 :tutorial/title "Properties of Matrix Addition and Subtraction"} :step/id #uuid "683ace4f-5219-5026-a420-485f13383a10" :step/next {:db/id #edb/ref 17592186101862}} {:db/id #edb/ref 17592186101862 :step/content {:db/id #edb/ref 17592186100992 :knowledge-point/id #uuid "16e62b0e-adda-5d35-aeb9-961057dce8f0"} :step/id #uuid "fe37dd78-b6d7-5cd1-8c23-51e67c1d3bbe"}] :activity/title "Properties of Matrix Addition" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186101035}] :db/id #edb/ref 17592186048863 :topic/knowledge-points [{:db/id #edb/ref 17592186100991 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100686 :question/id #uuid "0928c2fa-a772-5d39-a638-1b1d0e71be2f" :question/math-academy-id "e-4378" :question/problem "Calculate $A-(B-C),$ where\n\n$$\n\\begin{bmatrix}-1 & 0 \\\\ 2 & -2\\end{bmatrix}\n$$" :question/worked-solution "Performing the operations on each corresponding entry, we get:\n\n$$\n\\begin{aligned}A-(B-C) & =\\begin{bmatrix}-1 & 0 \\\\ 2 & -2\\end{bmatrix}-(\\begin{bmatrix}-1 & -1 \\\\ 2 & 0\\end{bmatrix}-\\begin{bmatrix}0 & -5 \\\\ 1 & 1\\end{bmatrix}) \\\\  & =\\begin{bmatrix}-1 & 0 \\\\ 2 & -2\\end{bmatrix}-\\begin{bmatrix}-1-0 & -1-(-5) \\\\ 2-1 & 0-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & 0 \\\\ 2 & -2\\end{bmatrix}-\\begin{bmatrix}-1 & 4 \\\\ 1 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1-(-1) & 0-4 \\\\ 2-1 & -2-(-1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & -4 \\\\ 1 & -1\\end{bmatrix}\\end{aligned}\n$$"} :knowledge-point/id #uuid "667ac53c-36b8-56a0-9699-fe27c8373c6b" :knowledge-point/question-generator {:db/id #edb/ref 17592186549194 :question-generator/id #uuid "dc71b24c-40dc-53be-9574-40a00b2b2f9c" :question-generator/script "generate/scratch/17592186100991.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186101106 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "850af764-4ddb-53d3-a63a-0f8b3db18d54" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 5 \\\\ 5 & 4\\end{bmatrix}" :db/id #edb/ref 17592186097972} {:answer/id #uuid "8e99ffbb-c95b-55f0-9ddd-98f9bebe3612" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 4 \\\\ 5 & 4\\end{bmatrix}" :db/id #edb/ref 17592186097973} {:answer/id #uuid "d0f41abb-2f98-5827-a0ee-deaf9afa93b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 5 \\\\ 4 & 4\\end{bmatrix}" :db/id #edb/ref 17592186097974} {:answer/id #uuid "fc7a4b9b-a1dc-5efe-9b1f-ac9b6d14126e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 4 \\\\ 4 & 5\\end{bmatrix}" :db/id #edb/ref 17592186097975} {:answer/id #uuid "0f17d20b-3eff-5ffe-8fdd-b191346f0b57" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 5 \\\\ 5 & 4\\end{bmatrix}" :db/id #edb/ref 17592186097976}] :answer-field/id #uuid "ff42f7b2-7a3c-5bd9-987f-0cceebfd97a6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186097971}] :question/id #uuid "b3117c0