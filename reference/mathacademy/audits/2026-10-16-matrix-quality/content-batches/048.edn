k}) \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186417982} {:answer/id #uuid "f2a56c4c-65fc-59ea-aac0-ed37edafc72a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5({5}^{k}) & 5({5}^{k}-1) \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186417995}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5({5}^{k}) & 4({5}^{k})+({5}^{k}-1) \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186417957} :answer-field/id #uuid "9a784818-345d-5012-92c2-a583bb77a257" :answer-field/key "field-13" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186418026} {:answer-field/choices [{:answer/id #uuid "2ff57f72-9109-52c2-af58-0976e6c56260" :answer/type {:db/ident :answer.type/math} :answer/value "n\\ge 2" :db/id #edb/ref 17592186417895} {:answer/id #uuid "405219a6-c1b9-5072-aa32-4d3266572bb0" :answer/type {:db/ident :answer.type/math} :answer/value "n=1" :db/id #edb/ref 17592186417909} {:answer/id #uuid "9ef7d8d1-2d59-5197-b7b0-7ca1b81552c5" :answer/type {:db/ident :answer.type/math} :answer/value "n\\ge 1" :db/id #edb/ref 17592186417959} {:answer/id #uuid "c9545cce-048e-59e2-bb07-ff644f774764" :answer/type {:db/ident :answer.type/math} :answer/value "n>1" :db/id #edb/ref 17592186417978}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "n\\ge 1" :db/id #edb/ref 17592186417959} :answer-field/id #uuid "a4bec58a-1a60-53d0-9376-ff6b59e33d35" :answer-field/key "field-15" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186418028} {:answer-field/choices [{:answer/id #uuid "02905748-e2b4-561e-a566-ae0b9b15da1a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}5 & 4 \\\\ 0 & 1\\end{bmatrix}}^{k}" :db/id #edb/ref 17592186417878} {:answer/id #uuid "5c0a8837-0666-5c3c-b8db-b9b30dc1016b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{5}^{k+1} & {5}^{k+1}-1 \\\\ 0 & 1\\end{bmatrix}" :d