igned}\n$$"} {:db/id #edb/ref 17592186549167 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c9bfb14f-f494-5924-bd06-a6bc1a52bfd9" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186549185}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186549185} :answer-field/id #uuid "5bbcc3e3-b8b8-5c72-801d-093caed6cc06" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549169} {:answer-field/choices [{:answer/id #uuid "8b046fb2-8753-58af-a25f-029cd0acd6a8" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186549176}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186549176} :answer-field/id #uuid "5edf44f0-bd0e-58db-9eec-f31fad510118" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549170} {:answer-field/choices [{:answer/id #uuid "3ca39553-5a17-5ac5-80c3-168a0bb4dbff" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186549165}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186549165} :answer-field/id #uuid "8d01543f-8eb3-5a3f-845b-85a43f60857c" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549177} {:answer-field/choices [{:answer/id #uuid "fa7a0347-e8c8-563f-be62-2f28e429feb4" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186549193}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186549193} :answer-field/id #uuid "b8e7dd4d-c79c-59f5-92cf-c8e81d89b5ac" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549183}] :question/id #uuid "485105cc-ea89-524d-9beb-4565587