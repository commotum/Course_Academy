g entry, we get\n\n$$\n\\begin{aligned}A-(B-C) & =\\begin{bmatrix}-9 & -9 \\\\ -1 & -7\\end{bmatrix}-(\\begin{bmatrix}9 & -1 \\\\ 0 & 7\\end{bmatrix}-\\begin{bmatrix}0 & 0 \\\\ 0 & -9\\end{bmatrix}) \\\\  & =\\begin{bmatrix}-9 & -9 \\\\ -1 & -7\\end{bmatrix}-\\begin{bmatrix}9-0 & -1-0 \\\\ 0-0 & 7-(-9)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-9 & -9 \\\\ -1 & -7\\end{bmatrix}-\\begin{bmatrix}9 & -1 \\\\ 0 & 16\\end{bmatrix} \\\\  & =\\begin{bmatrix}-9-9 & -9-(-1) \\\\ -1-0 & -7-16\\end{bmatrix} \\\\  & =\\begin{bmatrix}-18 & -8 \\\\ -1 & -23\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186549181 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f6067054-7fd7-5494-afbc-63d2f1559965" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186549192}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186549192} :answer-field/id #uuid "3b02cda3-58fa-5c92-bb86-7f7f1f78a064" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549164} {:answer-field/choices [{:answer/id #uuid "999ac731-f8fe-5bbb-ae2e-9746750317db" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186549180}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186549180} :answer-field/id #uuid "7c8db2d3-ed99-542c-a1d7-a2a23d3ad80f" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549174} {:answer-field/choices [{:answer/id #uuid "c1f35416-70b6-5829-b9cd-2cd827d01541" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186549184}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186549184} :answer-field/id #uuid "ead897d3-b824-5616-bcee-21308edbe47a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549189} {:answer-field/choices [{:answer/id #uuid "a251c7a8-7766-5b09-be0f-9d9cdd3ec615" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186549182}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186549182} :answer-field/id #uuid "ee94a05b-d8df-5eec-bd5a-b787df804ab2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549191}] :question/id #uuid "9c991876-ebda-5ae9-97e2-83fe985af8de" :question/problem "Calculate $A+(B-C)$, where\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}1 & 8 \\\\ 1 & -4\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}-9 & -1 \\\\ 8 & 6\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}3 & 6 \\\\ -7 & -4\\end{bmatrix}$</div>\n</div>\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$A+(B-C)=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td><td>{{field-4}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Performing the operations on each corresponding entry, we get\n\n$$\n\\begin{aligned}A+(B-C) & =\\begin{bmatrix}1 & 8 \\\\ 1 & -4\\end{bmatrix}+(\\begin{bmatrix}-9 & -1 \\\\ 8 & 6\\end{bmatrix}-\\begin{bmatrix}3 & 6 \\\\ -7 & -4\\end{bmatrix}) \\\\  & =\\begin{bmatrix}1 & 8 \\\\ 1 & -4\\end{bmatrix}+\\begin{bmatrix}-9-3 & -1-6 \\\\ 8-(-7) & 6-(-4)\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 8 \\\\ 1 & -4\\end{bmatrix}+\\begin{bmatrix}-12 & -7 \\\\ 15 & 10\\end{bmatrix} \\\\  & =\\begin{bmatrix}1+(-12) & 8+(-7) \\\\ 1+15 & -4+10\\end{bmatrix} \\\\  & =\\begin{bmatrix}-11 & 1 \\\\ 16 & 6\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186549186 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d78a2e84-a85a-5426-839b-d919d6d4b21d" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186549187}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186549187} :answer-field/id #uuid "3962cc30-d68b-50e2-9773-d6aedf315071" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549163} {:answer-field/choices [{:answer/id #uuid "3791a3cb-3358-5c4f-9a27-646be33d615b" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186549162}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186549162} :answer-field/id #uuid "3d46fe0e-797a-5fd0-bf21-fd0f6cbd02ee" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549166} {:answer-field/choices [{:answer/id #uuid "7f9923ef-6fcf-5a18-8db6-2620b208228a" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186549175}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186549175} :answer-field/id #uuid "7a9c1505-e38c-556b-8560-5c2cc406c445" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549173} {:answer-field/choices [{:answer/id #uuid "6d2eef1e-ff06-5df1-8eb1-4ea4bf0598df" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186549171} {:answer/id #uuid "a11b4970-75f7-48a8-b344-592b1d637ccd" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186567254}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186549171} :answer-field/id #uuid "95636e19-16b7-5501-af4d-c1cea649ce07" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549179}] :question/id #uuid "d25c4306-6441-5c4f-87fe-15896c66e824" :question/problem "Calculate $C-(D-E)$, where\n\n<div class=\"matrix-operands\">\n<div>$C=\\begin{bmatrix}-2 & -4 \\\\ 8 & -1\\end{bmatrix}$</div>\n<div>$D=\\begin{bmatrix}4 & 6 \\\\ 7 & 5\\end{bmatrix}$</div>\n<div>$E=\\begin{bmatrix}-2 & 0 \\\\ -9 & -2\\end{bmatrix}$</div>\n</div>\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$C-(D-E)=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td><td>{{field-4}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Performing the operations on each corresponding entry, we get\n\n$$\n\\begin{aligned}C-(D-E) & =\\begin{bmatrix}-2 & -4 \\\\ 8 & -1\\end{bmatrix}-(\\begin{bmatrix}4 & 6 \\\\ 7 & 5\\end{bmatrix}-\\begin{bmatrix}-2 & 0 \\\\ -9 & -2\\end{bmatrix}) \\\\  & =\\begin{bmatrix}-2 & -4 \\\\ 8 & -1\\end{bmatrix}-\\begin{bmatrix}4-(-2) & 6-0 \\\\ 7-(-9) & 5-(-2)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & -4 \\\\ 8 & -1\\end{bmatrix}-\\begin{bmatrix}6 & 6 \\\\ 16 & 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2-6 & -4-6 \\\\ 8-16 & -1-7\\end{bmatrix} \\\\  & =\\begin{bmatrix}-8 & -10 \\\\ -8 & -8\\end{bmatrix}.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Sum or Difference of Three or More Matrices"} {:db/id #edb/ref 17592186100992 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100687 :question/id #uuid "1b15db42-aba2-575c-a01e-b715450329fd" :question/math-academy-id "e-4379" :question/problem "Find $A+C-(B+A)$, if\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}1 & -2 \\\\ \\sqrt{2} & 0 \\\\ 0 & -2\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}3 & -1 \\\\ 2 & 0 \\\\ -4 & 1\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}3 & -1 \\\\ 1 & 2 \\\\ -6 & 1\\end{bmatrix}$</div>\n</div>" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses: \n\n$$\n\\begin{aligned}A+C-(B+A) & =A+C-B-A \\\\  & =\\cancel{A}+C-B-\\cancel{A} \\\\  & =C-B\\end{aligned}\n$$\n\nWe are left with a single subtraction. So, we subtract the corresponding entries of the two matrices:\n\n$$\n\\begin{aligned}C-B & =\\begin{bmatrix}3 & -1 \\\\ 1 & 2 \\\\ -6 & 1\\end{bmatrix}-\\begin{bmatrix}3 & -1 \\\\ 2 & 0 \\\\ -4 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3-3 & -1-(-1) \\\\ 1-2 & 2-0 \\\\ -6-(-4) & 1-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ -1 & 2 \\\\ -2 & 0\\end{bmatrix}\\end{aligned}\n$$"} :knowledge-point/id #uuid "16e62b0e-adda-5d35-aeb9-961057dce8f0" :knowledge-point/question-generator {:db/id #edb/ref 17592186567312 :question-generator/id #uuid "0539d767-59b8-5447-b53e-9109db523fd8" :question-generator/script "generators/4d/4d32d7d7f73ddbb3a2428c7789d5384962633d6ce27d25c10c42c5b77ece2afc/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186101130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d7de1032-850c-5ea9-a1ae-e083486ff706" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 2 \\\\ 3 & 6\\end{bmatrix}" :db/id #edb/ref 17592186098116} {:answer/id #uuid "ee11b057-083a-50d4-a16e-71b940dfbd15" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 2 \\\\ 4 & 6\\end{bmatrix}" :db/id #edb/ref 17592186098117} {:answer/id #uuid "ee16e495-0276-53ba-a14b-1b616dfd5ae4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 \\\\ 4 & 6\\end{bmatrix}" :db/id #edb/ref 17592186098118} {:answer/id #uuid "f6f5f24e-1c43-5e7d-b296-3a57df79f5fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 2 \\\\ 4 & 5\\end{bmatrix}" :db/id #edb/ref 17592186098119} {:answer/id #uuid "1629458d-cb60-534c-8cfa-eae2c7fb4823" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 1 \\\\ 4 & 6\\end{bmatrix}" :db/id #edb/ref 17592186098120}] :answer-field/id #uuid "dbfe9c16-ae55-5741-bcb1-0c2f8628bb30" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186098115}] :question/id #uuid "899c9618-f379-5a50-97a1-fd2442d407ae" :question/math-academy-id "q-13535" :question/problem "Find $Q + R - (Q + P)$, if\n\n<div class=\"matrix-operands\">\n<div>$P=\\begin{bmatrix}3 & 4 \\\\ 2 & 1\\end{bmatrix}$</div>\n<div>$Q=\\begin{bmatrix}6 & 7 \\\\ 2 & 3\\end{bmatrix}$</div>\n<div>$R=\\begin{bmatrix}5 & 6 \\\\ 6 & 7\\end{bmatrix}$</div>\n</div>\n\n."} {:db/id #edb/ref 17592186101131 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d0d5b8b-4428-5073-8c81-ebd4d03f5e11" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 2 \\\\ 2 & 3\\end{bmatrix}" :db/id #edb/ref 17592186098122} {:answer/id #uuid "04d70404-4b26-53f0-9c5c-5e44fe5b9647" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 7 \\\\ 4 & 5\\end{bmatrix}" :db/id #edb/ref 17592186098123} {:answer/id #uuid "39e8426c-e203-5fdf-a93f-111238c8159f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186098124} {:answer/id #uuid "71f20d62-7872-5e37-97e9-a23e08aef59f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 7 \\\\ 7 & 5\\end{bmatrix}" :db/id #edb/ref 17592186098125} {:answer/id #uuid "75cc67b5-2545-59dc-9edf-f9e64c9bb09e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 1 \\\\ 6 & 8\\end{bmatrix}" :db/id #edb/ref 17592186098126}] :answer-field/id #uuid "11b67b69-785c-5ae0-bd01-ea693dbbfc6c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186098121} {:answer-field/choices [{:answer/id #uuid "8f88e9a5-8759-5e71-b262-00b079bef50f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388343} {:answer/id #uuid "f2609425-f61f-5689-a1b2-ad1766ba4f2d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 1 \\\\ 6 & 8\\end{bmatrix}" :db/id #edb/ref 17592186388344} {:answer/id #uuid "065fbb44-49f9-5677-ae45-0db8eae4e9ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 7 \\\\ 7 & 5\\end{bmatrix}" :db/id #edb/ref 17592186388345} {:answer/id #uuid "6d7d6d9c-e6a7-5790-92dd-e8b2bca71761" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 7 \\\\ 4 & 5\\end{bmatrix}" :db/id #edb/ref 17592186388346} {:answer/id #uuid "b7fb0aa4-9a2d-5c94-a1be-3f68d1da0be1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 2 \\\\ 2 & 3\\end{bmatrix}" :db/id #edb/ref 17592186388347}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 7 \\\\ 4 & 5\\end{bmatrix}" :db/id #edb/ref 17592186388346} :answer-field/id #uuid "aefbe9b4-2591-5f99-bd99-dce5ef9f6719" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388342}] :question/id #uuid "60ff0898-484c-5468-ab70-2a2b8951960b" :question/math-academy-id "q-13536" :question/problem "Find $(A+B)-C-(B-C)$, if\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}6 & 7 \\\\ 4 & 5\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}3 & 2 \\\\ 2 & 3\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}5 & 1 \\\\ 6 & 8\\end{bmatrix}$</div>\n</div>" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}(A+B)-C-(B-C) & =A+B-C-B+C \\\\  & =A+\\cancel{B}-\\cancel{C}-\\cancel{B}+\\cancel{C} \\\\  & =A\\end{aligned}\n$$\n\nWe are left with a single matrix. So, the result is \n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}6 & 7 \\\\ 4 & 5\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233433 :question/id #uuid "d2422983-d4c6-5d6a-a655-61aaf19ac8a1" :question/math-academy-id "q-13550" :question/problem "Find $K+L-(K+J)$, if\n\n<div class=\"matrix-operands\">\n<div>$J=\\begin{bmatrix}5 & 2 \\\\ 2 & 1\\end{bmatrix}$</div>\n<div>$K=\\begin{bmatrix}9 & 8 \\\\ 2 & 3\\end{bmatrix}$</div>\n<div>$L=\\begin{bmatrix}6 & 6 \\\\ 6 & 6\\end{bmatrix}$</div>\n</div>" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}K+L-(K+J) & =K+L-K-J \\\\  & =\\cancel{K}+L-\\cancel{K}-J \\\\  & =L-J\\end{aligned}\n$$\n\nWe are left with a single subtraction. So, we subtract the corresponding entries of the two matrices:\n\n$$\n\\begin{aligned}L-J & =\\begin{bmatrix}6 & 6 \\\\ 6 & 6\\end{bmatrix}-\\begin{bmatrix}5 & 2 \\\\ 2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}6-5 & 6-2 \\\\ 6-2 & 6-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 4 \\\\ 4 & 5\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269058 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "048f24d1-178b-5552-bac6-6a3442ea9fbc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 1 \\\\ 3 & 4\\end{bmatrix}" :db/id #edb/ref 17592186266184} {:answer/id #uuid "07274542-72df-51ae-9747-e72e289132fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 2 \\\\ 3 & 4\\end{bmatrix}" :db/id #edb/ref 17592186266206} {:answer/id #uuid "0d154ee7-4761-51d0-9501-6a2171925a8b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 2 \\\\ 3 & 3\\end{bmatrix}" :db/id #edb/ref 17592186266262} {:answer/id #uuid "5166f1bd-1a23-5981-a02f-80311fc50264" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 2 \\\\ 2 & 4\\end{bmatrix}" :db/id #edb/ref 17592186266871} {:answer/id #uuid "7a8998f2-311c-5243-b155-02fb3a72a11c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 2 \\\\ 3 & 4\\end{bmatrix}" :db/id #edb/ref 17592186267225}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 2 \\\\ 3 & 4\\end{bmatrix}" :db/id #edb/ref 17592186267225} :answer-field/id #uuid "c35cca58-1d0a-5976-b167-1406a1720c99" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268755}] :question/id #uuid "52150036-21b2-593f-96c3-821ddd81a9cf" :question/math-academy-id "q-13543" :question/problem "Find $M+O-(N+M)$, if\n\n<div class=\"matrix-operands\">\n<div>$M=\\begin{bmatrix}5 & 5 \\\\ 0 & 1\\end{bmatrix}$</div>\n<div>$N=\\begin{bmatrix}1 & 4 \\\\ 2 & -1\\end{bmatrix}$</div>\n<div>$O=\\begin{bmatrix}8 & 6 \\\\ 5 & 3\\end{bmatrix}$</div>\n</div>" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}M+O-(N+M) & =M+O-N-M \\\\  & =\\cancel{M}+O-N-\\cancel{M} \\\\  & =O-N\\end{aligned}\n$$\n\nWe are left with a single subtraction. So, we subtract the corresponding entries of the two matrices:\n\n$$\n\\begin{aligned}O-N & =\\begin{bmatrix}8 & 6 \\\\ 5 & 3\\end{bmatrix}-\\begin{bmatrix}1 & 4 \\\\ 2 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}8-1 & 6-4 \\\\ 5-2 & 3-(-1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 & 2 \\\\ 3 & 4\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295093 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec88c80f-a8ed-502a-bf82-d3f72f783c3f" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186293854}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186293854} :answer-field/id #uuid "1ada07d1-b262-5536-98f4-ad7591dc1467" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294012} {:answer-field/choices [{:answer/id #uuid "db546ef4-33b1-5d16-a9a1-4f701c9e3518" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186293783}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186293783} :answer-field/id #uuid "49cf1090-dc76-5f9b-9ed9-62afb95195b2" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294191} {:answer-field/choices [{:answer/id #uuid "de58a3a4-d500-5910-a328-0b296db3af22" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186293797}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186293797} :answer-field/id #uuid "bc0d2cb5-6e08-5ec8-898e-38988817e2eb" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294594} {:answer-field/choices [{:answer/id #uuid "fa27f727-da39-5d99-a587-4ab6fcad711a" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186293916}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186293916} :answer-field/id #uuid "fe73ae99-752d-5979-8360-0edba6d46d65" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294821}] :question/id #uuid "2ce69f40-2704-5d26-9959-08c4817035a7" :question/math-academy-id "q-279581" :question/problem "Find $A+B-(C+B)$, if\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}2 & -5 \\\\ 7 & 0\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}-1 & 4 \\\\ 3 & 6\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}8 & -2 \\\\ -4 & 1\\end{bmatrix}$</div>\n</div>\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$A+B-(C+B)=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td><td>{{field-4}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}A+B-(C+B) & =A+B-C-B \\\\  & =A+\\cancel{B}-C-\\cancel{B} \\\\  & =A-C\\end{aligned}\n$$\n\nWe are left with a single subtraction. So, we subtract the corresponding entries of the two matrices:\n\n$$\n\\begin{aligned}A-C & =\\begin{bmatrix}2 & -5 \\\\ 7 & 0\\end{bmatrix}-\\begin{bmatrix}8 & -2 \\\\ -4 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2-8 & -5-(-2) \\\\ 7-(-4) & 0-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 & -3 \\\\ 11 & -1\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335986 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b68de3c-cb94-530f-b0dd-c01abe1f9020" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & -6 & 1 \\\\ 3 & 5 & -7\\end{bmatrix}" :db/id #edb/ref 17592186333551} {:answer/id #uuid "87de7fb7-03f9-5478-8fbe-a7f74728952b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 3 & -7 \\\\ -6 & -2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186334191} {:answer/id #uuid "a4270518-0222-5ac9-9763-f005bf1361fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 3 & 7 \\\\ 4 & -2 & 3\\end{bmatrix}" :db/id #edb/ref 17592186334429} {:answer/id #uuid "cb8229c4-0fa6-507d-92ed-e13af72729d8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 5 & -7 \\\\ -2 & -6 & 1\\end{bmatrix}" :db/id #edb/ref 17592186334761} {:answer/id #uuid "d3bb880b-fa90-5238-ad68-e045badea49d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 5 & -7 \\\\ -4 & 6 & 3\\end{bmatrix}" :db/id #edb/ref 17592186334847}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 5 & -7 \\\\ -2 & -6 & 1\\end{bmatrix}" :db/id #edb/ref 17592186334761} :answer-field/id #uuid "5e678cc5-6058-5486-829b-8adc462aca74" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335424}] :question/id #uuid "1938e380-4886-59d0-baa4-d58100804a76" :question/math-academy-id "q-69623" :question/problem "Find $G+H-(H+F)$, if\n\n<div class=\"matrix-operands\">\n<div>$F=\\begin{bmatrix}2 & -1 & 2 \\\\ 3 & 4 & 1\\end{bmatrix}$</div>\n<div>$G=\\begin{bmatrix}5 & 4 & -5 \\\\ 1 & -2 & 2\\end{bmatrix}$</div>\n<div>$H=\\begin{bmatrix}1 & 3 & -2 \\\\ 5 & -1 & 4\\end{bmatrix}$</div>\n</div>" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}G+H-(H+F) & =G+H-H-F \\\\  & =G+\\cancel{H}-\\cancel{H}-F \\\\  & =G-F\\end{aligned}\n$$\n\nWe are left with a single subtraction. So, we subtract the corresponding entries of the two matrices:\n\n$$\n\\begin{aligned}G-F & =\\begin{bmatrix}5 & 4 & -5 \\\\ 1 & -2 & 2\\end{bmatrix}-\\begin{bmatrix}2 & -1 & 2 \\\\ 3 & 4 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}5-2 & 4-(-1) & -5-2 \\\\ 1-3 & -2-4 & 2-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & 5 & -7 \\\\ -2 & -6 & 1\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335987 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51d28e19-c3ca-50e4-a6f4-60336111654b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}10 & -1 \\\\ 3 & 25 \\\\ -57 & -23\\end{bmatrix}" :db/id #edb/ref 17592186333738} {:answer/id #uuid "63ffbc9d-739f-5fe5-ac0a-1011970f027f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 10 \\\\ 2 & 4 \\\\ -4 & -13\\end{bmatrix}" :db/id #edb/ref 17592186333896} {:answer/id #uuid "9e5cd556-2d8d-5f84-8385-0d6bafc0bc0a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 10 \\\\ -4 & -13 \\\\ 4 & 2\\end{bmatrix}" :db/id #edb/ref 17592186334385} {:answer/id #uuid "a42f6c68-8de5-5fe4-82c0-ff575f2981a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & -4 \\\\ 8 & -10 \\\\ -4 & -3\\end{bmatrix}" :db/id #edb/ref 17592186334430} {:answer/id #uuid "cede7fbe-684a-5527-ae59-96c57e3600d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 10 \\\\ 4 & 2 \\\\ -4 & -13\\end{bmatrix}" :db/id #edb/ref 17592186334796}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 10 \\\\ 4 & 2 \\\\ -4 & -13\\end{bmatrix}" :db/id #edb/ref 17592186334796} :answer-field/id #uuid "a852f62a-ae69-55a6-9d50-5d36100a30ec" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335547}] :question/id #uuid "04eb824d-a063-5a72-b972-ff13e73919ce" :question/math-academy-id "q-69627" :question/problem "Find $C+V-(N+C)$, if\n\n<div class=\"matrix-operands\">\n<div>$C=\\begin{bmatrix}10 & -1 \\\\ 3 & 25 \\\\ -57 & -23\\end{bmatrix}$</div>\n<div>$V=\\begin{bmatrix}5 & 3 \\\\ 6 & -4 \\\\ -1 & -8\\end{bmatrix}$</div>\n<div>$N=\\begin{bmatrix}1 & -7 \\\\ 2 & -6 \\\\ 3 & 5\\end{bmatrix}$</div>\n</div>" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}C+V-(N+C) & =C+V-N-C \\\\  & =\\cancel{C}+V-N-\\cancel{C} \\\\  & =V-N\\end{aligned}\n$$\n\nWe are left with a single subtraction. So, we subtract the corresponding entries of the two matrices:\n\n$$\n\\begin{aligned}V-N & =\\begin{bmatrix}5 & 3 \\\\ 6 & -4 \\\\ -1 & -8\\end{bmatrix}-\\begin{bmatrix}1 & -7 \\\\ 2 & -6 \\\\ 3 & 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}5-1 & 3-(-7) \\\\ 6-2 & -4-(-6) \\\\ -1-3 & -8-5\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 10 \\\\ 4 & 2 \\\\ -4 & -13\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186520625 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a40fb8d-6c72-5258-aabc-78cc1f3dcd78" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 5 \\\\ 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186520622} {:answer/id #uuid "6732a133-8c40-5bf0-ae4c-d04e6e0aaace" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 & 9 \\\\ 3 & 4\\end{bmatrix}" :db/id #edb/ref 17592186520635} {:answer/id #uuid "b8f4e417-c4d0-55f3-b73b-c9bed6882456" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 9 \\\\ 9 & 4\\end{bmatrix}" :db/id #edb/ref 17592186520645} {:answer/id #uuid "c23459f1-c68b-5841-bd00-47417073c2c9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 7 \\\\ 2 & 9\\end{bmatrix}" :db/id #edb/ref 17592186520649} {:answer/id #uuid "f069083c-81f7-5c78-8426-2cf9bc1aec75" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186520655}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 & 9 \\\\ 3 & 4\\end{bmatrix}" :db/id #edb/ref 17592186520635} :answer-field/id #uuid "671be61c-9f43-5c12-8c22-f5e84c0d5ea8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186520634}] :question/id #uuid "1ca92a57-d7b9-5768-811f-c7f9f0312ee3" :question/problem "Find $(A+B)-C-(B-C)$, if\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}8 & 9 \\\\ 3 & 4\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}5 & 5 \\\\ 1 & 1\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}0 & 7 \\\\ 2 & 9\\end{bmatrix}$</div>\n</div>" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}(A+B)-C-(B-C) & =A+B-C-B+C \\\\  & =A+\\cancel{B}-\\cancel{C}-\\cancel{B}+\\cancel{C} \\\\  & =A\\end{aligned}\n$$\n\nWe are left with a single matrix. So, the result is \n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}8 & 9 \\\\ 3 & 4\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186520628 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a576a47-a882-5c1f-ac83-9ea1ba78cefe" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 7 \\\\ 5 & 8\\end{bmatrix}" :db/id #edb/ref 175