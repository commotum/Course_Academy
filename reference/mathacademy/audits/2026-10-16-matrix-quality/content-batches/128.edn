ked-solution "To find the rank of $H,$ we first reduce it to row echelon form, as follows:\n\n$$\n\\begin{aligned}W & =\\begin{bmatrix}1 & 6 & -4 & 6 \\\\ 0 & -1 & -4 & 6 \\\\ -1 & -6 & 4 & -7\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{1} \\\\  & ∼\\begin{bmatrix}-1 & 6 & -4 & 6 \\\\ 0 & -1 & -4 & 6 \\\\ 0 & 0 & 0 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix has $3$ pivot columns (or alternatively, it has exactly $3$ non-zero rows).\n\nTherefore, $\\text{rank}(W)=3.$"} {:db/id #edb/ref 17592186444270 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "080f7b68-1446-53cb-a768-ddfed5710a59" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186444257} {:answer/id #uuid "58ea38e8-5330-5713-ac69-29ba41df0ffb" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186444260} {:answer/id #uuid "be020027-00e4-5988-94b8-3d6ef8dffe52" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186444261} {:answer/id #uuid "d4a9245b-945c-5b2f-a3f2-23d524e7d6ca" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186444262} {:answer/id #uuid "f29b74c5-893c-5a44-8e76-6c39f0301bb2" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186444266}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186444266} :answer-field/id #uuid "2af22924-1cce-522c-aadc-abcfbbca5566" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186444267}] :question/id #uuid "71b4ed44-551f-59fd-a0cd-dc5bcd55b071" :question/math-academy-id "q-35271" :question/problem "If \n$B=\\begin{bmatrix}6 & 9 & 3 \\\\ -2 & -2 & -1 \\\\ 12 & 18 & 6\\end{bmatrix}$, then $\\text{rank}(B)=$" :question/worked-solution "To find the rank of $B,$ we first reduce it to row echelon form, as follows:\n\n$$\n\\begin{aligned}B & =\\begin{bmatrix}6 & 9 & 3 \\\\ -2 & -2 & -1 \\\\ 12 & 18 & 6\\end{bmatrix} & {R}_{2} & :={R}_{2}+\\frac{1}{3}{R}_{1} \\\\  & ∼\\begin{bmatrix}6 & 9 & 3 \\\\ 0 & 1 & 0 \\\\ 12 & 18 & 6\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}6 & 9 & 3 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix has $2$ pivot columns (or alternatively, it has exactly $2$ non-zero rows).\n\nTherefore, $\\text{rank}(B)=2.$"} {:db/id #edb/ref 17592186455460 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f635389-edc5-5dc3-8b76-ade3a6532e3e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186454953} {:answer/id #uuid "33d20bdd-920e-5017-9ff8-f223643bc0e4" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186454984} {:answer/id #uuid "6e341854-6e46-5393-acbf-d555137a5f61" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186455107} {:answer/id #uuid "b3348cc7-e699-5af8-bc08-746cd7a662ec" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186455214} {:answer/id #uuid "dffb9715-18d6-51d1-8e5a-8408e61f22c4" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186455289}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186454984} :answer-field/id #uuid "ad46ea88-b115-5458-b648-47a63580c1e7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186455399}] :question/id #uuid "5f02772c-72fa-5f47-bb75-202fca199929" :question/math-academy-id "q-35273" :question/problem "If \n$F=\\begin{bmatrix}-2 & 4 & 3 & 1 \\\\ 0 & -2 & -2 & -1 \\\\ 6 & 2 & 4 & 1 \\\\ 0 & -1 & -1 & -\\frac{1}{2}\\end{bmatrix}$, find $\\text{rank}(F).$" :question/worked-solution "To find the rank of $F,$ we first reduce it to row echelon form, as follows:\n\n$$\n\\begin{aligned}F & =\\begin{bmatrix}-2 & 4 & 3 & 1 \\\\ 0 & -2 & -2 & -1 \\\\ 6 & 2 & 4 & 1 \\\\ 0 & -1 & -1 & -\\frac{1}{2}\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & 4 & 3 & 1 \\\\ 0 & -2 & -2 & -1 \\\\ 0 & 14 & 13 & 4 \\\\ 0 & -1 & -1 & -\\frac{1}{2}\\end{bmatrix} & {R}_{3} & :={R}_{3}+7{R}_{2} \\\\  & ∼\\begin{bmatrix}-2 & 4 & 3 & 1 \\\\ 0 & -2 & -2 & -1 \\\\ 0 & 0 & -1 & -3 \\\\ 0 & -1 & -1 & -\\frac{1}{2}\\end{bmatrix} & {R}_{4} & :={R}_{4}+(-\\frac{1}{2}){R}_{2} \\\\  & ∼\\begin{bmatrix}-2 & 4 & 3 & 1 \\\\ 0 & -2 & -2 & -1 \\\\ 0 & 0 & -1 & -3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix has $3$ pivot columns (or alternatively, it has exactly $3$ non-zero rows).\n\nTherefore, $\\text{rank}(F)=3.$"} {:db/id #edb/ref 17592186455491 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11b79355-4888-598e-841c-ba082e6d64ed" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186454938} {:answer/id #uuid "254d92b0-82e1-5787-acba-023cab6318a1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186454961} {:answer/id #uuid "8a974be9-6c67-5eb6-9aec-a1c2a1fea1c1" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186455156} {:answer/id #uuid "910e3be6-42e1-536c-83e4-c75ca6eaf4a3" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186455167} {:answer/id #uuid "ac88dd90-5d4c-51e6-9e72-d41cda0c8d33" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186455205}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186455167} :answer-field/id #uuid "abe49f7c-654c-5082-9ec8-abe568a36534" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186455397}] :question/id #uuid "c31f85f2-2569-54fb-b7c6-be8a312b2b29" :question/math-academy-id "q-35288" :question/problem "If \n$B=\\begin{bmatrix}-6 & 9 & -12 \\\\ 2 & -3 & 6\\end{bmatrix}$, then $\\text{rank}(B)=$" :question/worked-solution "To find the rank of $B,$ we first reduce it to row echelon form, as follows:\n\n$$\n\\begin{aligned}B & =\\begin{bmatrix}-6 & 9 & -12 \\\\ 2 & -3 & 6\\end{bmatrix} & {R}_{2} & :={R}_{2}+\\frac{1}{3}{R}_{1} \\\\  & ∼\\begin{bmatrix}-6 & 9 & -12 \\\\ 0 & 0 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix has $2$ pivot columns (or alternatively, it has exactly $2$ non-zero rows).\n\nTherefore, $\\text{rank}(B)=2.$"}] :knowledge-point/title "Finding the Rank of a Matrix Using Row Reduction"}] :topic/math-academy-id 1867 :topic/title "The Rank of a Matrix"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186222306} :activity/id #uuid "4bdf9815-fa54-50ce-b3f5-ad6d001dd7d2" :activity/steps [{:db/id #edb/ref 17592186222306 :step/content {:db/id #edb/ref 17592186222473 :tutorial/content "In this topic, we'll learn how to compute the **matrix exponential**.\n\nRecall that the scalar exponential function $e^t$ can be written as the power series \n\n$$\ne^t = \\sum_{k=0}^{\\infty}\\dfrac{t^k}{k!} = 1 + t + \\dfrac{t^2}{2} + \\cdots + \\dfrac{t^k}{k!} + \\cdots.\n$$\n\nNow, let $A$ be an $n\\times n$ matrix. By definition, the matrix exponential $e^{At}$ is given by the analogous series\n\n$$\ne^{At} = \\sum_{k=0}^{\\infty}\\frac{A^k t^k}{k!} = I + tA + \\dfrac{t^2}{2}A^2 + \\cdots + \\dfrac{t^k}{k!}A^k + \\cdots.\n$$\n\nThere are several approaches for computing matrix exponentials:\n\n- The most direct approach is to use the definition above, but this is typically impractical.\n\n- Another method, often covered in linear algebra courses, is to use the Jordan canonical form of $A$. This works, but it can also be tedious, especially for larger matrices.\n\nHere, we will introduce a different method.\n\nBy the Cayley–Hamilton theorem, every power $A^n, A^{n+1}, \\ldots$ can be rewritten as a linear combination of \n\n$$\nI, \\: A, \\: A^2, \\: \\ldots, \\: A^{n-1}.\n$$\n\nAs a result, $e^{At}$ can be written in the form\n\n$$\ne^{At}=\\alpha_{n-1}A^{n-1} t^{n-1}+\\alpha_{n-2} A^{n-2}t^{n-2}+\\cdots+\\alpha_1 At+\\alpha_0 I,\n$$\n\nwhere $\\alpha_0, \\alpha_1, \\ldots, \\alpha_{n-1}$ are functions of $t$ and $I$ is the $n \\times n$ identity matrix. \n\nNow, we define the polynomial \n\n$$\nr(\\lambda)=\\alpha_{n-1}\\lambda^{n-1}+\\alpha_{n-2}\\lambda^{n-2}+\\cdots+\\alpha_1\\lambda+\\alpha_0.\n$$\n\nThen we have the following key fact:\n\n> For any eigenvalue $\\lambda$ of $At$, we have $r(\\lambda) = e^{\\lambda}.$\n\nLet’s now see how this method works in practice." :tutorial/id #uuid "d78b3664-4117-56fc-bf30-5ca3acb28377" :tutorial/math-academy-id 14270 :tutorial/title "Introduction"} :step/id #uuid "f932ab79-9fa6-5a87-aa94-755b1685c4e3" :step/next {:db/id #edb/ref 17592186222307}} {:db/id #edb/ref 17592186222307 :step/content {:db/id #edb/ref 17592186222482 :tutorial/content "Let's find $e^{At}$ for $\\begin{bmatrix}2 & 0 \\\\ -7 & 7\\end{bmatrix}$ \n\nBy solving the characteristic polynomial $|A-\\lambda I|=0,$ we can find that the eigenvalues of $A$ are \n\n$$\n\\lambda_1=2, \\qquad\n\\lambda_2=7.\n$$\n\nWe have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}2 & 0 \\\\ -7 & 7\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2{\\alpha }_{1}t+{\\alpha }_{0} & 0 \\\\ -7{\\alpha }_{1}t & 7{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix},\\end{aligned}\n$$\n\nwhere $\\alpha_1$ and $\\alpha_0$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda) = \\alpha_1 \\lambda + \\alpha_0.$ The eigenvalues of $At$ are \n\n$$\n\\lambda_1=2t, \\qquad\n\\lambda_2=7t,\n$$\n\nboth of multiplicity one. Thus, we have the following:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}r(2t) &={e}^{2t} \\\\ r(7t) &={e}^{7t}\\end{aligned}\\right.\\,\\Rightarrow \\,\\left\\{\\begin{aligned}2t{\\alpha }_{1}+{\\alpha }_{0} &={e}^{2t} \\\\ 7t{\\alpha }_{1}+{\\alpha }_{0} &={e}^{7t}\\end{aligned}\\right.\\end{aligned}\n$$\n\nNow, we solve the system for $\\alpha_1$ and $\\alpha_0{:}$\n\n- Subtracting the first equation from the second one, we get\n\n$$\n5t\\alpha_1 = e^{7t} - e^{2t}\n\\qquad\\Rightarrow\\qquad\n\\alpha_1 = \\dfrac{1}{5t}\\bigl(e^{7t}-e^{2t}\\bigr).\n$$\n\n- Multiplying the first equation by $7$ and subtracting twice the second one, we get\n\n$$\n5\\alpha_0 = 7e^{2t} - 2e^{7t}\n\\qquad\\Rightarrow\\qquad\n\\alpha_0 = \\dfrac{1}{5}\\bigl(7e^{2t}-2e^{7t}\\bigr).\n$$\n\nSubstituting $\\alpha_1$ and $\\alpha_0$ into the expressions for the entries of $e^{At},$ we get the following:\n\n$$\n\\begin{aligned}2{\\alpha }_{1}t+{\\alpha }_{0} & =2(\\frac{1}{5t}({e}^{7t}-{e}^{2t}))t+\\frac{1}{5}(7{e}^{2t}-2{e}^{7t}) \\\\  & =\\frac{1}{5}((2{e}^{7t}-2{e}^{2t})+(7{e}^{2t}-2{e}^{7t})) \\\\  & ={e}^{2t} \\\\ -7{\\alpha }_{1}t & =-7(\\frac{1}{5t}({e}^{7t}-{e}^{2t}))t \\\\  & =-\\frac{7}{5}({e}^{7t}-{e}^{2t}) \\\\  & =\\frac{7}{5}({e}^{2t}-{e}^{7t}) \\\\ 7{\\alpha }_{1}t+{\\alpha }_{0} & =7(\\frac{1}{5t}({e}^{7t}-{e}^{2t}))t+\\frac{1}{5}(7{e}^{2t}-2{e}^{7t}) \\\\  & =\\frac{1}{5}((7{e}^{7t}-7{e}^{2t})+(7{e}^{2t}-2{e}^{7t})) \\\\  & ={e}^{7t}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{bmatrix}5{e}^{2t} & 0 \\\\ 7({e}^{2t}-{e}^{7t}) & 5{e}^{7t}\\end{bmatrix}\n$$" :tutorial/id #uuid "6e5aa695-b237-54d4-9836-20514d70dc9e" :tutorial/math-academy-id 14389 :tutorial/title "2x2 Matrices With Distinct Real Eigenvalues"} :step/id #uuid "3c91134a-154b-5692-a2cc-fdc45c81af7e" :step/next {:db/id #edb/ref 17592186222308}} {:db/id #edb/ref 17592186222308 :step/content {:db/id #edb/ref 17592186221408 :knowledge-point/id #uuid "fee186e0-579f-5104-b0e1-50540abc0bdc"} :step/id #uuid "ebe4cfdc-9e1a-577d-ad38-9d117b4cf820" :step/next {:db/id #edb/ref 17592186222309}} {:db/id #edb/ref 17592186222309 :step/content {:db/id #edb/ref 17592186221409 :knowledge-point/id #uuid "a118fe4a-cd1f-52f7-aa33-59f5494e4905"} :step/id #uuid "ea0b2d60-3227-5e25-b6a9-171c0dc66319" :step/next {:db/id #edb/ref 17592186222310}} {:db/id #edb/ref 17592186222310 :step/content {:db/id #edb/ref 17592186222481 :tutorial/content "Recall that the matrix exponential $e^{At}$ can be written as\n\n$$\ne^{At}=\\alpha_{n-1} A^{n-1}t^{n-1}+\\alpha_{n-2} A^{n-2}t^{n-2}+\\cdots+\\alpha_1 At+\\alpha_0 I.\n$$\n\nIf we define the polynomial\n\n$$\nr(\\lambda)=\\alpha_{n-1}\\lambda^{n-1}+\\alpha_{n-2}\\lambda^{n-2}+\\cdots+\\alpha_1\\lambda+\\alpha_0,\n$$\n\nthen for any eigenvalue $\\lambda_i$ of $At,$ we have\n\n$$\nr(\\lambda_i) = e^{\\lambda_i}.\n$$\n\nHowever, for *repeated eigenvalues*, we have the following additional fact:\n\n> If $\\lambda_i$ is an eigenvalue of multiplicity $k$ with $k>1,$ then \n> \n> \n> $$\n> \\begin{aligned}\\frac{\\text{d}}{\\text{d}\\lambda }r(\\lambda ){|}_{\\lambda ={\\lambda }_{i}}={e}^{{\\lambda }_{i}},\\,\\frac{{\\text{d}}^{2}}{\\text{d}{\\lambda }^{2}}r(\\lambda ){|}_{\\lambda ={\\lambda }_{i}}={e}^{{\\lambda }_{i}},\\,…,\\,\\frac{{\\text{d}}^{k-1}}{\\text{d}{\\lambda }^{k-1}}r(\\lambda ){|}_{\\lambda ={\\lambda }_{i}}={e}^{{\\lambda }_{i}}\\end{aligned}\n> $$\n\nLet's apply these facts to a concrete example." :tutorial/id #uuid "d7b15b25-b73f-5d5f-aa02-e4c1a5e9804e" :tutorial/math-academy-id 14388 :tutorial/title "2x2 Matrices With Repeated Eigenvalues"} :step/id #uuid "855a741b-2bbe-5e04-b892-8d1d9c7d0e65" :step/next {:db/id #edb/ref 17592186222311}} {:db/id #edb/ref 17592186222311 :step/content {:db/id #edb/ref 17592186221410 :knowledge-point/id #uuid "0fd1d280-c768-5504-892e-a9a1948e1f1a"} :step/id #uuid "de5a7d5c-0c01-5247-8ba6-a69a863c9cbb" :step/next {:db/id #edb/ref 17592186222312}} {:db/id #edb/ref 17592186222312 :step/content {:db/id #edb/ref 17592186222505 :tutorial/content "Again, let $A$ be a constant $n\\times n$ matrix. The matrix exponential satisfies\n\n$$\n\\dfrac{\\text{d}}{\\text{d}t}\\bigl(e^{At}\\bigr)=A\\,e^{At}.\n$$\n\nIndeed, recall that\n\n$$\ne^{At}=\\sum_{k=0}^{\\infty}\\frac{(At)^k}{k!}\n=\\sum_{k=0}^{\\infty}\\frac{A^k t^k}{k!}.\n$$\n\nTo prove the formula, we differentiate the series above term-by-term:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}({e}^{At}) & ={\\sum }_{k=1}^{\\infty }\\frac{{A}^{k}\\cdot k{t}^{k-1}}{k!} \\\\  & ={\\sum }_{k=1}^{\\infty }\\frac{{A}^{k}{t}^{k-1}}{(k-1)!} \\\\  & =A{\\sum }_{k=1}^{\\infty }\\frac{{A}^{k-1}{t}^{k-1}}{(k-1)!} \\\\  & =A{\\sum }_{j=0}^{\\infty }\\frac{{A}^{j}{t}^{j}}{j!} \\\\  & =A\\,{e}^{At}\\end{aligned}\n$$" :tutorial/id #uuid "739548ab-310c-5de3-a426-1fcaa3282478" :tutorial/math-academy-id 14526 :tutorial/title "Derivatives of Matrix Exponentials"} :step/id #uuid "fc10fbf4-2be0-5b3f-ad2e-0505b175d5a6" :step/next {:db/id #edb/ref 17592186222313}} {:db/id #edb/ref 17592186222313 :step/content {:db/id #edb/ref 17592186221411 :knowledge-point/id #uuid "d4fc3ba4-d488-5156-88dc-837369269cef"} :step/id #uuid "df4956ab-0323-513e-ab21-66734987f4d0" :step/next {:db/id #edb/ref 17592186222314}} {:db/id #edb/ref 17592186222314 :step/content {:db/id #edb/ref 17592186222506 :tutorial/content "Matrix exponentials have other properties. We list a few of them:\n\n- *Law of Exponents:* If $A$ is a constant square matrix, then\n\n$$\ne^{A(t+s)} = e^{At}\\,e^{As}.\n$$\n\n- *Inverse:* For any $t,$ the matrix $e^{At}$ is invertible and \n\n$$\n(e^{At})^{-1} = e^{-At}.\n$$\n\n- *Identity:* For any square matrix $A,$\n\n$$\ne^{A\\cdot 0} = I.\n$$\n\n- *Product of exponentials:* If $A$ and $B$ commute (i.e., $AB = BA$), then\n\n$$\ne^{A}e^{B} = e^{A+B}.\n$$\n\n**Watch out!** In general, this identity is *not true* unless $A$ and $B$ commute." :tutorial/id #uuid "2fcc3801-5d58-5c8e-b8c8-7be65b34f71a" :tutorial/math-academy-id 14527 :tutorial/title "Properties of the Matrix Exponential"} :step/id #uuid "24b8ab46-a4b1-5358-abbd-db086f102dbf"}] :activity/title "Matrix Exponentials" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186221467} {:activity/first-step {:db/id #edb/ref 17592186532736} :activity/id #uuid "e67bdbbc-b2ac-5dc2-96db-49866bc692da" :activity/steps [{:db/id #edb/ref 17592186532728 :step/content {:db/id #edb/ref 17592186308670 :question/id #uuid "79079e07-e6bc-5f6a-8ed1-2ff769b8b920"} :step/id #uuid "03d5d0e2-58f6-580f-b08d-c488e5333a32" :step/next {:db/id #edb/ref 17592186532761}} {:db/id #edb/ref 17592186532736 :step/content {:db/id #edb/ref 17592186532679 :question/id #uuid "900adaef-859d-5d14-9981-202d2269e069"} :step/id #uuid "447659a5-783c-55e2-b7bc-7044e79e9190" :step/next {:db/id #edb/ref 17592186532744}} {:db/id #edb/ref 17592186532744 :step/content {:db/id #edb/ref 17592186308657 :question/id #uuid "f29b7109-5c33-5046-8236-7d693dea5b92"} :step/id #uuid "783d8e6f-d461-5f0b-8f11-aa192fbe52a4" :step/next {:db/id #edb/ref 17592186532728}} {:db/id #edb/ref 17592186532761 :step/content {:db/id #edb/ref 17592186308672 :question/id #uuid "4bf1a0f0-bb87-5dac-ad3b-1ce93c87e2a8"} :step/id #uuid "dc3bbe46-b9a2-5b99-9ca0-73318c047651" :step/next {:db/id #edb/ref 17592186532762}} {:db/id #edb/ref 17592186532762 :step/content {:db/id #edb/ref 17592186308729 :question/id #uuid "14f4f5f9-2f59-5657-8bee-d1931d1011cc"} :step/id #uuid "eabd75d2-306c-5778-a5d4-6908c275c489"}] :activity/title "Matrix Exponentials" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186531935} {:activity/first-step {:db/id #edb/ref 17592186553677} :activity/id #uuid "02ab6ed4-47f1-525b-9777-cf24c2343051" :activity/steps [{:db/id #edb/ref 17592186553597 :step/content {:db/id #edb/ref 17592186308730 :question/id #uuid "d14a11c3-0a49-5696-a62c-af65df34be1e"} :step/id #uuid "0b4cefa4-af80-5c7c-83a1-ff4d5ac31dcb"} {:db/id #edb/ref 17592186553601 :step/content {:db/id #edb/ref 17592186370129 :question/id #uuid "eace89bb-5f6d-586f-b6ba-d2d1f4b38da0"} :step/id #uuid "16872273-54fb-5073-a5e6-85ee3dbf9ea6" :step/next {:db/id #edb/ref 17592186553611}} {:db/id #edb/ref 17592186553611 :step/content {:db/id #edb/ref 17592186308674 :question/id #uuid "d74b37d0-1ddd-5304-877c-4617a1e8ae03"} :step/id #uuid "30faf73f-f8c2-56a2-805f-6ce1667a314c" :step/next {:db/id #edb/ref 17592186553678}} {:db/id #edb/ref 17592186553677 :step/content {:db/id #edb/ref 17592186221995 :question/id #uuid "e415201f-e8d7-5cac-99e4-ae2f79b7e01e"} :step/id #uuid "e0e6cc77-900e-5194-bf84-c2fa20bd1df9" :step/next {:db/id #edb/ref 17592186553601}} {:db/id #edb/ref 17592186553678 :step/content {:db/id #edb/ref 17592186553504 :question/id #uuid "23c462cc-da9f-5356-aacb-68452f1af0c8"} :step/id #uuid "eb5fe771-6cf7-59f9-a5b4-123061340a58" :step/next {:db/id #edb/ref 17592186553597}}] :activity/title "Matrix Exponentials" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186552851} {:activity/first-step {:db/id #edb/ref 17592186561082} :activity/id #uuid "73992d71-b996-5316-ad0f-63db7204241f" :activity/steps [{:db/id #edb/ref 17592186561068 :step/content {:db/id #edb/ref 17592186308660 :question/id #uuid "94b786d3-6c88-5e7c-b171-415f525959f6"} :step/id #uuid "26287e9f-9343-5c17-9537-313ae614bd54" :step/next {:db/id #edb/ref 17592186561079}} {:db/id #edb/ref 17592186561075 :step/content {:db/id #edb/ref 17592186308727 :question/id #uuid "bf8f7576-f6c0-5d24-9d4e-d8cc050c1036"} :step/id #uuid "5d0f07d8-733c-51e7-9a95-c40bbfc9ff95" :step/next {:db/id #edb/ref 17592186561086}} {:db/id #edb/ref 17592186561079 :step/content {:db/id #edb/ref 17592186561040 :question/id #uuid "b34e24d7-8981-5c82-b39b-e245e3ef59b8"} :step/id #uuid "7c26bff4-82ce-5d40-8919-b6dec6caf103" :step/next {:db/id #edb/ref 17592186561075}} {:db/id #edb/ref 17592186561082 :step/content {:db/id #edb/ref 17592186308655 :question/id #uuid "f28e1404-987d-53df-a0ad-e0b6d8de5b42"} :step/id #uuid "86739e1b-e113-54ad-aa60-4fc9b6a5b447" :step/next {:db/id #edb/ref 17592186561068}} {:db/id #edb/ref 17592186561086 :step/content {:db/id #edb/ref 17592186222006 :question/id #uuid "ec4ec1fa-f063-5a3c-ba78-66239dbbdec2"} :step/id #uuid "a9c4980a-13cb-5d93-a06d-edb7046c0908"}] :activity/title "Matrix Exponentials" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186560355}] :db/id #edb/ref 17592186050054 :topic/knowledge-points [{:db/id #edb/ref 17592186221408 :knowledge-point/canonical-example {:db/id #edb/ref 17592186221150 :question/id #uuid "35a158c3-37b6-5123-ba90-1fd05218ce43" :question/math-academy-id "e-21271" :question/problem "Find $e^{At}$ for ![](images/bf/bf972d6172dc5282be366a87138ac9088216484082251482383de605c720b568.png) \n\n*Hint: The eigenvalues of $A$ are $1$ and $4.$*" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}1 & 0 \\\\ -3 & 4\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}{\\alpha }_{1}t+{\\alpha }_{0} & 0 \\\\ -3{\\alpha }_{1}t & 4{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix},\\end{aligned}\n$$\n\nwhere $\\alpha_1$ and $\\alpha_0$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda) = \\alpha_1 \\lambda + \\alpha_0.$ The eigenvalues of $At$ are \n\n$$\n\\lambda_1=t, \\qquad\n\\lambda_2=4t,\n$$\n\nboth of multiplicity one. Thus, we have the following:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}r(t) &={e}^{t} \\\\ r(4t) &={e}^{4t}\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}t{\\alpha }_{1}+{\\alpha }_{0} &={e}^{t} \\\\ 4t{\\alpha }_{1}+{\\alpha }_{0} &={e}^{4t}\\end{aligned}\\right.\\end{aligned}\n$$\n\nNow, we solve the system for $\\alpha_1$ and $\\alpha_0{:}$\n\n- Subtracting the first equation from the second one, we get\n\n$$\n3t\\alpha_1 = e^{4t} - e^{t}\n\\qquad\\Rightarrow\\qquad\n\\alpha_1 = \\dfrac{1}{3t}\\bigl(e^{4t}-e^{t}\\bigr).\n$$\n\n- Multiplying the first equation by $4$ and subtracting the second one, we get\n\n$$\n3\\alpha_0 = 4e^{t} - e^{4t}\n\\qquad\\Rightarrow\\qquad\n\\alpha_0 = \\dfrac{1}{3}\\bigl(4e^{t}-e^{4t}\\bigr).\n$$\n\nSubstituting $\\alpha_1$ and $\\alpha_0$ into the expressions for the entries of $e^{At},$ we get the following:\n\n$$\n\\begin{aligned}{\\alpha }_{1}t+{\\alpha }_{0} & =(\\frac{1}{3t}({e}^{4t}-{e}^{t}))t+\\frac{1}{3}(4{e}^{t}-{e}^{4t}) \\\\  & =\\frac{1}{3}({e}^{4t}-{e}^{t}+4{e}^{t}-{e}^{4t}) \\\\  & ={e}^{t} \\\\ -3{\\alpha }_{1}t & =-3(\\frac{1}{3t}({e}^{4t}-{e}^{t}))t \\\\  & ={e}^{t}-{e}^{4t} \\\\ 4{\\alpha }_{1}t+{\\alpha }_{0} & =4(\\frac{1}{3t}({e}^{4t}-{e}^{t}))t+\\frac{1}{3}(4{e}^{t}-{e}^{4t}) \\\\  & =\\frac{1}{3}((4{e}^{4t}-4{e}^{t})+(4{e}^{t}-{e}^{4t})) \\\\  & ={e}^{4t}\\end{aligned}\n$$\n\nTherefore,\n![](images/10/104a4830d44821dbc65ad9c832da0323b7dd9e90c934fdfc7a21c175845231d2.png)"} :knowledge-point/id #uuid "fee186e0-579f-5104-b0e1-50540abc0bdc" :knowledge-point/questions [{:db/id #edb/ref 17592186221925 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "844a767d-4892-5a32-9efb-55b76e04fa97" :answer/type {:db/ident :answer.type/math} :answer/value "7{e}^{-4t}-2{e}^{t}" :db/id #edb/ref 17592186300620}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "7{e}^{-4t}-2{e}^{t}" :db/id #edb/ref 17592186300620} :answer-field/id #uuid "408f310d-32bd-5680-92a5-4d19c5534375" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301442} {:answer-field/choices [{:answer/id #uuid "bfe67ab4-cf1f-50b2-9eb0-5b632616d2ec" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{-4t}-2{e}^{t}" :db/id #edb/ref 17592186300923}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{-4t}-2{e}^{t}" :db/id #edb/ref 17592186300923} :answer-field/id #uuid "4fe39a1c-829e-581e-a4e4-170426417bd8" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301486}] :question/id #uuid "cdf86a0b-ce7f-5a36-9106-b67d70a6ba24" :question/math-academy-id "q-323878" :question/problem "Find ${e}^{At}$ for $A=\\begin{bmatrix}-6 & 7 \\\\ -2 & 3\\end{bmatrix}.$ \n\n*Hint: The eigenvalues of $A$ are $-4$ and $1.$*\n\n| ${e}^{At}=\\,\\,\\frac{1}{5}$ |  | {{field-1}} | $-7{e}^{-4t}+7{e}^{t}$ |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-2}} | $-2{e}^{-4t}+7{e}^{t}$ |  |  |" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}-6 & 7 \\\\ -2 & 3\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6{\\alpha }_{1}t+{\\alpha }_{0} & 7{\\alpha }_{1}t \\\\ -2{\\alpha }_{1}t & 3{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix}.\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The eigenvalues of $At$ are \n\n$$\n{\\lambda }_{1}=-4t,\\,{\\lambda }_{2}=t,\n$$\n\nboth of multiplicity one. Thus, we have the following:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}r(-4t) &={e}^{-4t} \\\\ r(t) &={e}^{t}\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}-4t{\\alpha }_{1}+{\\alpha }_{0} &={e}^{-4t} \\\\ t{\\alpha }_{1}+{\\alpha }_{0} &={e}^{t}\\end{aligned}\\right.\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- Subtraction the second equation from the first one, we get\n\n$$\n-5t{\\alpha }_{1}={e}^{-4t}-{e}^{t}\\,⇒\\,{\\alpha }_{1}=-\\frac{1}{5t}({e}^{-4t}-{e}^{t}).\n$$\n\n- Multiplying the second equation by $4$ and adding to the first one, we get\n\n$$\n5{\\alpha }_{0}={e}^{-4t}+4{e}^{t}\\,⇒\\,{\\alpha }_{0}=\\frac{1}{5}({e}^{-4t}+4{e}^{t}).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}6{\\alpha }_{1}t+{\\alpha }_{0} & =6(-\\frac{1}{5t}({e}^{-4t}-{e}^{t}))t+\\frac{1}{5}({e}^{-4t}+4{e}^{t}) \\\\  & =\\frac{1}{5}((-6{e}^{-4t}+6{e}^{t}))+({e}^{-4t}+4{e}^{t})) \\\\  & =\\frac{1}{5}(7{e}^{-4t}-2{e}^{t}) \\\\ -2{\\alpha }_{1}t & =-2(-\\frac{1}{5t}({e}^{-4t}-{e}^{t}))t \\\\  & =\\frac{1}{5}(2{e}^{-4t}-2{e}^{t})\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}=\\frac{1}{5}\\begin{bmatrix}7{e}^{-4t}-2{e}^{t} & -7{e}^{-4t}+7{e}^{t} \\\\ 2{e}^{-4t}-2{e}^{t} & -2{e}^{-4t}+7{e}^{t}\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186221994 :question/answer-fields [{:answer-field/id #uuid "cd28b60c-f119-50b3-9777-e1274a92cd56" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186220635} {:answer-field/id #uuid "7655b25c-ccf4-5004-83e4-0720ea436aa6" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186220636}] :question/id #uuid "f2a4021f-dafd-5fa8-b7f8-0e3ef2de6133" :question/math-academy-id "q-333852" :question/problem "Find $e^{At}$ for $A = \\begin{bmatrix}0 & 6 \\\\ 1 & -1\\end{bmatrix}$.\n\n*Hint: The eigenvalues of $A$ are $-3$ and $2$.*\n\n| $e^{At} = \\frac{1}{5}$ |  | {{field-1}} | $6e^{2t} - 6e^{-3t}$ |  |\n| --- | ---: | ---: | ---: | ---: |\n|  | {{field-2}} | $2e^{2t} + 3e^{-3t}$ |  |  |"} {:db/id #edb/ref 17592186308532 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3a89e14-c8e0-5e44-a9b8-f3ac0f0360aa" :answer/type {:db/ident :answer.type/math} :answer/value "-1+3{e}^{-4t}" :db/id #edb/ref 17592186306972}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-1+3{e}^{-4t}" :db/id #edb/ref 17592186306972} :answer-field/id #uuid "01037f4c-7c37-5634-8e6c-20ee29f65e71" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307519} {:answer-field/choices [{:answer/id #uuid "d1ba9ac3-1f20-5468-95ac-d8ea55e98b49" :answer/type {:db/ident :answer.type/math} :answer/value "1-{e}^{-4t}" :db/id #edb/ref 17592186307098}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1-{e}^{-4t}" :db/id #edb/ref 17592186307098} :answer-field/id #uuid "5b79de22-fe0a-53c0-a42e-6c9aaddfcd83" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307806}] :question/id #uuid "257aed5d-b769-55be-9201-2e8d67dfb051" :question/math-academy-id "q-333918" :question/problem "Find ${e}^{At}$ for $A=\\begin{bmatrix}-6 & -6 \\\\ 2 & 2\\end{bmatrix}.$ \n\n*Hint: The eigenvalues of $A$ are $-4$ and $0.$*\n\n| ${e}^{At}=\\,\\,\\frac{1}{2}$ |  | {{field-1}} | $-3+3{e}^{-4t}$ |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-2}} | $3-{e}^{-4t}$ |  |  |" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}-6 & -6 \\\\ 2 & 2\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6{\\alpha }_{1}t+{\\alpha }_{0} & -6{\\alpha }_{1}t \\\\ 2{\\alpha }_{1}t & 2{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix}.\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The eigenvalues of $At$ are \n\n$$\n{\\lambda }_{1}=-4t,\\,{\\lambda }_{2}=0,\n$$\n\nboth of multiplicity one. Thus, we have the following:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}r(-4t) &={e}^{-4t} \\\\ r(0) &=1\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}-4t{\\alpha }_{1}+{\\alpha }_{0} &={e}^{-4t} \\\\ {\\alpha }_{0} &=1\\end{aligned}\\right.\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- From the second equation, we get\n\n$$\n{\\alpha }_{0}=1.\n$$\n\n- Substituting ${\\alpha }_{0}=1$ into the first equation, we get\n\n$$\n-4t{\\alpha }_{1}+1={e}^{-4t}\\,⇒\\,{\\alpha }_{1}=-\\frac{1}{4t}({e}^{-4t}-1).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}-6{\\alpha }_{1}t+{\\alpha }_{0} & =-6(-\\frac{1}{4t}({e}^{-4t}-1))t+1 \\\\  & =\\frac{6}{4}({e}^{-4t}-1)+1 \\\\  & =\\frac{3}{2}({e}^{-4t}-1)+1 \\\\  & =\\frac{-3+3{e}^{-4t}+2}{2} \\\\  & =\\frac{-1+3{e}^{-4t}}{2} \\\\ 2{\\alpha }_{1}t & =2(-\\frac{1}{4t}({e}^{-4t}-1))t \\\\  & =-\\frac{2}{4}({e}^{-4t}-1) \\\\  & =-\\frac{1}{2}({e}^{-4t}-1) \\\\  & =\\frac{1-{e}^{-4t}}{2}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}=\\frac{1}{2}\\begin{bmatrix}-1+3{e}^{-4t} & -3+3{e}^{-4t} \\\\ 1-{e}^{-4t} & 3-{e}^{-4t}\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186308533 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a909763-5b8e-57e9-a134-f7912c30f6bb" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{t}-{e}^{-2t}" :db/id #edb/ref 17592186305708}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{e}^{t}-{e}^{-2t}" :db/id #edb/ref 17592186305708} :answer-field/id #uuid "0c56ea57-664a-585c-98e2-b7233665a4b0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307566} {:answer-field/choices [{:answer/id #uuid "75d313cd-25b3-53fe-95e7-3a8ddb996348" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{t}-{e}^{-2t}" :db/id #edb/ref 17592186306272}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{t}-{e}^{-2t}" :db/id #edb/ref 17592186306272} :answer-field/id #uuid "125f8328-549c-5b9a-9290-4156fb68434e" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307579}] :question/id #uuid "d259e94f-fd62-514f-881a-1710eb3fba54" :question/math-academy-id "q-333921" :question/problem "Find ${e}^{At}$ for $A=\\begin{bmatrix}-5 & -6 \\\\ 3 & 4\\end{bmatrix}.$ \n\n*Hint: The eigenvalues of $A$ are $-2$ and $1.$*\n\n| ${e}^{At}=\\,\\,$ |  | $-{e}^{t}+2{e}^{-2t}$ | $-2{e}^{t}+2{e}^{-2t}$ |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-1}} | {{field-2}} |  |  |" :question/worked-solution "Explanation:\n\nWe have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}-5 & -6 \\\\ 3 & 4\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-5{\\alpha }_{1}t+{\\alpha }_{0} & -6{\\alpha }_{1}t \\\\ 3{\\alpha }_{1}t & 4{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix}.\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The eigenvalues of $At$ are \n\n$$\n{\\lambda }_{1}=-2t,\\,{\\lambda }_{2}=t,\n$$\n\nboth of multiplicity one. Thus, we have the following:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}r(-2t) &={e}^{-2t} \\\\ r(t) &={e}^{t}\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}-2t{\\alpha }_{1}+{\\alpha }_{0} &={e}^{-2t} \\\\ t{\\alpha }_{1}+{\\alpha }_{0} &={e}^{t}\\end{aligned}\\right.\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- Subtracting the second equation from the first one, we get\n\n$$\n-3t{\\alpha }_{1}={e}^{-2t}-{e}^{t}\\,⇒\\,{\\alpha }_{1}=-\\frac{1}{3t}({e}^{-2t}-{e}^{t}).\n$$\n\n- Multiplying the second equation by $2$ and adding to the first one, we get\n\n$$\n3{\\alpha }_{0}={e}^{-2t}+2{e}^{t}\\,⇒\\,{\\alpha }_{0}=\\frac{1}{3}({e}^{-2t}+2{e}^{t}).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}3{\\alpha }_{1}t & =3(-\\frac{1}{3t}({e}^{-2t}-{e}^{t}))t \\\\  & =-({e}^{-2t}-{e}^{t}) \\\\  & ={e}^{t}-{e}^{-2t} \\\\ 4{\\alpha }_{1}t+{\\alpha }_{0} & =4(-\\frac{1}{3t}({e}^{-2t}-{e}^{t}))t+\\frac{1}{3}({e}^{-2t}+2{e}^{t}) \\\\  & =\\frac{1}{3}((-4{e}^{-2t}+4{e}^{t})+({e}^{-2t}+2{e}^{t})) \\\\  & =2{e}^{t}-{e}^{-2t}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}=\\begin{bmatrix}-{e}^{t}+2{e}^{-2t} & -2{e}^{t}+2{e}^{-2t} \\\\ {e}^{t}-{e}^{-2t} & 2{e}^{t}-{e}^{-2t}\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186308644 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35cf3b2d-a8c1-5bd9-aca6-f502028c4513" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{4t}+{e}^{t}" :db/id #edb/ref 17592186305667}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{4t}+{e}^{t}" :db/id #edb/ref 17592186305667} :answer-field/id #uuid "8b5930ae-4735-5e73-94f1-709356f8b161" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307957} {:answer-field/choices [{:answer/id #uuid "9d995775-d4b8-5be5-ae8b-0051f8760741" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{4t}-{e}^{t}" :db/id #edb/ref 17592186306623}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{e}^{4t}-{e}^{t}" :db/id #edb/ref 17592186306623} :answer-field/id #uuid "ccb53663-7d9c-5de6-86b9-c1a530a30928" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308158}] :question/id #uuid "51cffc2a-3512-573b-9f6a-f449e54b28ee" :question/math-academy-id "q-334581" :question/problem "Find ${e}^{At}$ for $A=\\begin{bmatrix}2 & 2 \\\\ 1 & 3\\end{bmatrix}.$ \n\n*Hint: The eigenvalues of $A$ are $1$ and $4.$*\n\n| ${e}^{At}=\\,\\,\\frac{1}{3}$ |  | ${e}^{4t}+2{e}^{t}$ | $2{e}^{4t}-2{e}^{t}$ |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-1}} | {{field-2}} |  |  |" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}2 & 2 \\\\ 1 & 3\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2{\\alpha }_{1}t+{\\alpha }_{0} & 2{\\alpha }_{1}t \\\\ {\\alpha }_{1}t & 3{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix},\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The eigenvalues of $At$ are \n\n$$\n{\\lambda }_{1}=t,\\,{\\lambda }_{2}=4t,\n$$\n\nboth of multiplicity one. Thus, we have the following:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}r(t) &={e}^{t} \\\\ r(4t) &={e}^{4t}\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}t{\\alpha }_{1}+{\\alpha }_{0} &={e}^{t} \\\\ 4t{\\alpha }_{1}+{\\alpha }_{0} &={e}^{4t}\\end{aligned}\\right.\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- Subtracting the first equation from the second one, we get\n\n$$\n3t{\\alpha }_{1}={e}^{4t}-{e}^{t}\\,⇒\\,{\\alpha }_{1}=\\frac{1}{3t}({e}^{4t}-{e}^{t}).\n$$\n\n- Multiplying the first equation by $4$ and subtracting the second one, we get\n\n$$\n3{\\alpha }_{0}=4{e}^{t}-{e}^{4t}\\,⇒\\,{\\alpha }_{0}=\\frac{1}{3}(4{e}^{t}-{e}^{4t}).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}{\\alpha }_{1}t & =(\\frac{1}{3t}({e}^{4t}-{e}^{t}))t \\\\  & =\\frac{1}{3}({e}^{4t}-{e}^{t}), \\\\ 3{\\alpha }_{1}t+{\\alpha }_{0} & =3(\\frac{1}{3t}({e}^{4t}-{e}^{t}))t+\\frac{1}{3}(4{e}^{t}-{e}^{4t}) \\\\  & =\\frac{1}{3}((3{e}^{4t}-3{e}^{t})+(4{e}^{t}-{e}^{4t})) \\\\  & =\\frac{1}{3}(2{e}^{4t}+{e}^{t}),\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}=\\frac{1}{3}\\begin{bmatrix}{e}^{4t}+2{e}^{t} & 2{e}^{4t}-2{e}^{t} \\\\ {e}^{4t}-{e}^{t} & 2{e}^{4t}+{e}^{t}\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186308645 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "402bbdda-b251-5d94-875d-59e0a91fef09" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{t}-1" :db/id #edb/ref 17592186305776}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{e}^{t}-1" :db/id #edb/ref 17592186305776} :answer-field/id #uuid "642c0d75-aba1-5dcc-9534-d6efe883c2ce" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307840} {:answer-field/choices [{:answer/id #uuid "28bdc05e-dd6d-5717-a1c9-5f11ff701e4b" :answer/type {:db/ident :answer.type/math} :answer/value "-{e}^{t}+2" :db/id #edb/ref 17592186305531}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-{e}^{t}+2" :db/id #edb/ref 17592186305531} :answer-field/id #uuid "76c000d2-5a8b-5d66-b457-fa31db823b9b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307895}] :question/id #uuid "ce10f4df-94a1-54d0-b0b8-734df6cd8ed5" :question/math-academy-id "q-334586" :question/problem "Find ${e}^{At}$ for $A=\\begin{bmatrix}-1 & 1 \\\\ -2 & 2\\end{bmatrix}.$ \n\n*Hint: The eigenvalues of $A$ are $0$ and $1.$*\n\n| ${e}^{At}=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | $2-2{e}^{t}$ | $2{e}^{t}-1$ |  |  |" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}-1 & 1 \\\\ -2 & 2\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-{\\alpha }_{1}t+{\\alpha }_{0} & {\\alpha }_{1}t \\\\ -2{\\alpha }_{1}t & 2{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix},\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The eigenvalues of $At$ are \n\n$$\n{\\lambda }_{1}=0,\\,{\\lambda }_{2}=t,\n$$\n\nboth of multiplicity one. Thus, we have the following:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}r(0) &={e}^{0} \\\\ r(t) &={e}^{t}\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}{\\alpha }_{0} &=1 \\\\ t{\\alpha }_{1}+{\\alpha }_{0} &={e}^{t}\\end{aligned}\\right.\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- From the first equation, we immediately get\n\n$$\n{\\alpha }_{0}=1.\n$$\n\n- Substituting ${\\alpha }_{0}=1$ into the second equation, we get\n\n$$\nt{\\alpha }_{1}+1={e}^{t}\\,⇒\\,{\\alpha }_{1}=\\frac{1}{t}({e}^{t}-1).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}-{\\alpha }_{1}t+{\\alpha }_{0} & =-(\\frac{1}{t}({e}^{t}-1))t+1 \\\\  & =-({e}^{t}-1)+1 \\\\  & =-{e}^{t}+2 \\\\ {\\alpha }_{1}t & =(\\frac{1}{t}({e}^{t}-1))t \\\\  & ={e}^{t}-1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}=\\begin{bmatrix}-{e}^{t}+2 & {e}^{t}-1 \\\\ 2-2{e}^{t} & 2{e}^{t}-1\\end{bmatrix}.\n$$"}] :knowledge-point/title "Finding the Matrix Exponent for a Matrix With Distinct Real Eigenvalues"} {:db/id #edb/ref 17592186221409 :knowledge-point/canonical-example {:db/id #edb/ref 17592186221151 :question/id #uuid "18064c11-63d3-599a-b504-7b589f46c3dc" :question/math-academy-id "e-21272" :question/problem "Find $e^{At}$ for ![](images/3f/3f97cbbd4715d8191dc5b0c410a784b556b068ed5e3e57fe0dc16ee8f52655cc.png) \n\n*Hint: The eigenvalues of $A$ are $3 \\pm 2\\textrm{i}.$*" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}7 & 4 \\\\ -5 & -1\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}7{\\alpha }_{1}t+{\\alpha }_{0} & 4{\\alpha }_{1}t \\\\ -5{\\alpha }_{1}t & -{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix}.\\end{aligned}\n$$\n\nwhere $\\alpha_1$ and $\\alpha_0$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda) = \\alpha_1 \\lambda + \\alpha_0.$ The eigenvalues or $At$ are \n\n$$\n\\lambda_1= (3+2\\textrm{i}) t, \\qquad\n\\lambda_2= (3-2\\textrm{i}) t,\n$$\n\nwhich are complex conjugates. Thus, we have the following:\n\n$$\n\\begin{aligned}r((3+2\\text{i})t) & ={e}^{(3+2\\text{i})t} \\\\ {\\alpha }_{1}(3+2\\text{i})t+{\\alpha }_{0} & ={e}^{3t}(\\operatorname{cos}⁡(2t)+\\text{i}\\operatorname{sin}⁡(2t)) \\\\ (3{\\alpha }_{1}t+{\\alpha }_{0})+2{\\alpha }_{1}\\text{i}t & ={e}^{3t}\\operatorname{cos}⁡(2t)+\\text{i}\\,{e}^{3t}\\operatorname{sin}⁡(2t)\\end{aligned}\n$$\n\nNow, we equate the real and imaginary parts, and solve for $\\alpha_1$ and $\\alpha_0{:}$\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}3{\\alpha }_{1}t+{\\alpha }_{0} &={e}^{3t}\\operatorname{cos}⁡(2t) \\\\ 2t{\\alpha }_{1} &={e}^{3t}\\operatorname{sin}⁡(2t)\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}{\\alpha }_{1} &=\\frac{1}{2t}{e}^{3t}\\operatorname{sin}⁡(2t) \\\\ {\\alpha }_{0} &={e}^{3t}(\\operatorname{cos}⁡(2t)-\\frac{3}{2}\\operatorname{sin}⁡(2t))\\end{aligned}\\right.\\end{aligned}\n$$\n\nSubstituting $\\alpha_1$ and $\\alpha_0$ into the expressions for the entries of $e^{At},$ we get the following:\n\n$$\n\\begin{aligned}7{\\alpha }_{1}t+{\\alpha }_{0} & =7\\cdot \\frac{1}{2t}{e}^{3t}\\operatorname{sin}⁡(2t)\\cdot t+{e}^{3t}(\\operatorname{cos}⁡(2t)-\\frac{3}{2}\\operatorname{sin}⁡(2t)) \\\\  & =\\frac{7}{2}{e}^{3t}\\operatorname{sin}⁡(2t)+{e}^{3t}\\operatorname{cos}⁡(2t)-\\frac{3}{2}{e}^{3t}\\operatorname{sin}⁡(2t) \\\\  & ={e}^{3t}(\\operatorname{cos}⁡(2t)+2\\operatorname{sin}⁡(2t)), \\\\ 4{\\alpha }_{1}t & =4\\cdot \\frac{1}{2t}{e}^{3t}\\operatorname{sin}⁡(2t)\\cdot t \\\\  & =2{e}^{3t}\\operatorname{sin}⁡(2t), \\\\ -5{\\alpha }_{1}t & =-5\\cdot \\frac{1}{2t}{e}^{3t}\\operatorname{sin}⁡(2t)\\cdot t \\\\  & =-\\frac{5}{2}{e}^{3t}\\operatorname{sin}⁡(2t), \\\\ -{\\alpha }_{1}t+{\\alpha }_{0} & =-\\frac{1}{2t}{e}^{3t}\\operatorname{sin}⁡(2t)\\cdot t+{e}^{3t}(\\operatorname{cos}⁡(2t)-\\frac{3}{2}\\operatorname{sin}⁡(2t)) \\\\  & =-\\frac{1}{2}{e}^{3t}\\operatorname{sin}⁡(2t)+{e}^{3t}\\operatorname{cos}⁡(2t)-\\frac{3}{2}{e}^{3t}\\operatorname{sin}⁡(2t) \\\\  & ={e}^{3t}(\\operatorname{cos}⁡(2t)-2\\operatorname{sin}⁡(2t))\\end{aligned}\n$$\n\nTherefore,\n![](images/de/dec5e32e503bf178832f6cf08b51767d2f76fb308e9a9d07c4e805389507bbfd.png)"} :knowledge-point/id #uuid "a118fe4a-cd1f-52f7-aa33-59f5494e4905" :knowledge-point/questions [{:db/id #edb/ref 17592186221932 :question/answer-fields [{:answer-field/id #uuid "827c559b-db29-5794-b207-dfa9e7c2c628" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186220206} {:answer-field/id #uuid "33b967d5-1320-5a8b-a8ae-7c0a7f77b1c5" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186220207}] :question/id #uuid "ca6653d5-d9e9-543d-bbdc-082d63f240d6" :question/math-academy-id "q-328966" :question/problem "Find $e^{At}$ for $A = \\begin{bmatrix}3 & -4 \\\\ 2 & -1\\end{bmatrix}$.\n\n*Hint: The eigenvalues of $A$ are $1 ± 2\\textrm{i}$.*\n\n| $e^{At} = e^{t}$ |  | $\\cos (2t) + \\sin (2t)$ | {{field-1}} |  |\n| --- | ---: | ---: | ---: | ---: |\n|  | $\\sin (2t)$ | {{field-2}} |  |  |"} {:db/id #edb/ref 17592186222002 :question/answer-fields [{:answer-field/id #uuid "f9442c5d-278f-5ccc-aa2c-1144a132ac76" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186220687} {:answer-field/id #uuid "25918028-a170-523b-9cee-33d9dd6c7b4c" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186220688}] :question/id #uuid "092bcce6-22aa-54b4-8fc0-6de76116f21e" :question/math-academy-id "q-334632" :question/problem "Find $e^{At}$ for $A = \\begin{bmatrix}1 & 1 \\\\ -2 & -1\\end{bmatrix}$.\n\n*Hint: The eigenvalues of $A$ are $± \\textrm{i}$.*\n\n| $e^{At} =$ |  | {{field-1}} | $\\sin (t)$ |  |\n| --- | ---: | ---: | ---: | ---: |\n|  | {{field-2}} | $\\cos (t) - \\sin (t)$ |  |  |"} {:db/id #edb/ref 17592186308654 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21964d84-a4b3-57c4-baef-7dc90590c3c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}(4t)-\\operatorname{sin}(4t)" :db/id #edb/ref 17592186305473}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}(4t)-\\operatorname{sin}(4t)" :db/id #edb/ref 17592186305473} :answer-field/id #uuid "45384094-ffc6-5100-9d4a-f5e78cf975a6" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307739} {:answer-field/choices [{:answer/id #uuid "cf913454-7ec3-55da-a766-ff44688e8cd3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}(4t)" :db/id #edb/ref 17592186307067}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}(4t)" :db/id #edb/ref 17592186307067} :answer-field/id #uuid "e2565be3-a2ee-5353-bc1b-991800facd5c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308234}] :question/id #uuid "29635f2f-538b-5717-bb55-2555552241c6" :question/math-academy-id "q-334629" :question/problem "Find ${e}^{At}$ for $A=\\begin{bmatrix}5 & 8 \\\\ -4 & -3\\end{bmatrix}.$ \n\n*Hint: The eigenvalues of $A$ are $1\\pm 4\\text{i}.$*\n\n| ${e}^{At}={e}^{t}\\,\\,$ |  | $\\operatorname{cos}⁡(4t)+\\operatorname{sin}⁡(4t)$ | $2\\operatorname{sin}⁡(4t)$ |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-1}} | {{field-2}} |  |  |" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}5 & 8 \\\\ -4 & -3\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}5{\\alpha }_{1}t+{\\alpha }_{0} & 8{\\alpha }_{1}t \\\\ -4{\\alpha }_{1}t & -3{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix}.\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The eigenvalues or $At$ are \n\n$$\n{\\lambda }_{1}=(1+4\\text{i})t,\\,{\\lambda }_{2}=(1-4\\text{i})t,\n$$\n\nwhich are complex conjugates. Thus, we have the following:\n\n$$\n\\begin{aligned}r((1+4\\text{i})t) & ={e}^{(1+4\\text{i})t} \\\\ {\\alpha }_{1}(1+4\\text{i})t+{\\alpha }_{0} & ={e}^{t}(\\operatorname{cos}⁡(4t)+\\text{i}\\operatorname{sin}⁡(4t)) \\\\ ({\\alpha }_{1}t+{\\alpha }_{0})+4{\\alpha }_{1}\\text{i}t & ={e}^{t}\\operatorname{cos}⁡(4t)+\\text{i}\\,{e}^{t}\\operatorname{sin}⁡(4t)\\end{aligned}\n$$\n\nNow, we equate the real and imaginary parts, and solve for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}{\\alpha }_{1}t+{\\alpha }_{0} &={e}^{t}\\operatorname{cos}⁡(4t) \\\\ 4t{\\alpha }_{1} &={e}^{t}\\operatorname{sin}⁡(4t)\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}{\\alpha }_{1} &=\\frac{1}{4t}{e}^{t}\\operatorname{sin}⁡(4t) \\\\ {\\alpha }_{0} &={e}^{t}(\\operatorname{cos}⁡(4t)-\\frac{1}{4}\\operatorname{sin}⁡(4t))\\end{aligned}\\right.\\end{aligned}\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}5{\\alpha }_{1}t+{\\alpha }_{0} & =5\\cdot \\frac{1}{4t}{e}^{t}\\operatorname{sin}⁡(4t)\\cdot t+{e}^{t}(\\operatorname{cos}⁡(4t)-\\frac{1}{4}\\operatorname{sin}⁡(4t)) \\\\  & =\\frac{5}{4}{e}^{t}\\operatorname{sin}⁡(4t)+{e}^{t}\\operatorname{cos}⁡(4t)-\\frac{1}{4}{e}^{t}\\operatorname{sin}⁡(4t) \\\\  & ={e}^{t}(\\operatorname{cos}⁡(4t)+\\operatorname{sin}⁡(4t)) \\\\ -4{\\alpha }_{1}t & =-4\\cdot \\frac{1}{4t}{e}^{t}\\operatorname{sin}⁡(4t)\\cdot t \\\\  & =-{e}^{t}\\operatorname{sin}⁡(4t)\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{t}\\begin{bmatrix}\\operatorname{cos}⁡(4t)+\\operatorname{sin}⁡(4t) & 2\\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t) & \\operatorname{cos}⁡(4t)-\\operatorname{sin}⁡(4t)\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186308655 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36c1c3f8-e34c-5913-9027-40cbf9b38b67" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}(2t)+\\operatorname{sin}(2t)" :db/id #edb/ref 17592186305677}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}(2t)+\\operatorname{sin}(2t)" :db/id #edb/ref 17592186305677} :answer-field/id #uuid "a6401040-97c5-5632-9c58-3544640ae047" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308054} {:answer-field/choices [{:answer/id #uuid "40844993-f65c-5c72-af9c-ffdf6d82f4c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}(2t)-\\operatorname{sin}(2t)" :db/id #edb/ref 17592186305783}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}(2t)-\\operatorname{sin}(2t)" :db/id #edb/ref 17592186305783} :answer-field/id #uuid "cb369d00-0a03-526e-b8a8-28162f18b93d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308152}] :question/id #uuid "f28e1404-987d-53df-a0ad-e0b6d8de5b42" :question/math-academy-id "q-334630" :question/problem "Find ${e}^{At}$ for $A=\\begin{bmatrix}-3 & 4 \\\\ -2 & 1\\end{bmatrix}.$ \n\n*Hint: The eigenvalues of $A$ are $-1\\pm 2\\text{i}.$*\n\n| ${e}^{At}={e}^{-t}\\,\\,$ |  | {{field-1}} | $2\\operatorname{sin}⁡(2t)$ |  |\n| --- | --- | --- | --- | --- |\n|  | $-\\operatorname{sin}⁡(2t)$ | {{field-2}} |  |  |" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}-3 & 4 \\\\ -2 & 1\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3{\\alpha }_{1}t+{\\alpha }_{0} & 4{\\alpha }_{1}t \\\\ -2{\\alpha }_{1}t & {\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix}.\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The eigenvalues or $At$ are \n\n$$\n{\\lambda }_{1}=(-1+2\\text{i})t,\\,{\\lambda }_{2}=(-1-2\\text{i})t,\n$$\n\nwhich are complex conjugates. Thus, we have the following:\n\n$$\n\\begin{aligned}r((-1+2\\text{i})t) & ={e}^{(-1+2\\text{i})t} \\\\ {\\alpha }_{1}(-1+2\\text{i})t+{\\alpha }_{0} & ={e}^{-t}(\\operatorname{cos}⁡(2t)+\\text{i}\\operatorname{sin}⁡(2t)) \\\\ (-{\\alpha }_{1}t+{\\alpha }_{0})+2{\\alpha }_{1}\\text{i}t & ={e}^{-t}\\operatorname{cos}⁡(2t)+\\text{i}\\,{e}^{-t}\\operatorname{sin}⁡(2t)\\end{aligned}\n$$\n\nNow, we equate the real and imaginary parts, and solve for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}-{\\alpha }_{1}t+{\\alpha }_{0} &={e}^{-t}\\operatorname{cos}⁡(2t) \\\\ 2t{\\alpha }_{1} &={e}^{-t}\\operatorname{sin}⁡(2t)\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}{\\alpha }_{1} &=\\frac{1}{2t}{e}^{-t}\\operatorname{sin}⁡(2t) \\\\ {\\alpha }_{0} &={e}^{-t}(\\operatorname{cos}⁡(2t)+\\frac{1}{2}\\operatorname{sin}⁡(2t))\\end{aligned}\\right.\\end{aligned}\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}-3{\\alpha }_{1}t+{\\alpha }_{0} & =-3\\cdot \\frac{1}{2t}{e}^{-t}\\operatorname{sin}⁡(2t)\\cdot t+{e}^{-t}(\\operatorname{cos}⁡(2t)+\\frac{1}{2}\\operatorname{sin}⁡(2t)) \\\\  & =-\\frac{3}{2}{e}^{-t}\\operatorname{sin}⁡(2t)+{e}^{-t}\\operatorname{cos}⁡(2t)+\\frac{1}{2}{e}^{-t}\\operatorname{sin}⁡(2t) \\\\  & ={e}^{-t}(\\operatorname{cos}⁡(2t)-\\operatorname{sin}⁡(2t)) \\\\ {\\alpha }_{1}t+{\\alpha }_{0} & =\\frac{1}{2t}{e}^{-t}\\operatorname{sin}⁡(2t)\\cdot t+{e}^{-t}(\\operatorname{cos}⁡(2t)+\\frac{1}{2}\\operatorname{sin}⁡(2t)) \\\\  & =\\frac{1}{2}{e}^{-t}\\operatorname{sin}⁡(2t)+{e}^{-t}\\operatorname{cos}⁡(2t)+\\frac{1}{2}{e}^{-t}\\operatorname{sin}⁡(2t) \\\\  & ={e}^{-t}(\\operatorname{cos}⁡(2t)+\\operatorname{sin}⁡(2t))\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{-t}\\begin{bmatrix}\\operatorname{cos}⁡(2t)-\\operatorname{sin}⁡(2t) & 2\\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t) & \\operatorname{cos}⁡(2t)+\\operatorname{sin}⁡(2t)\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186308656 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7694b518-7142-5675-a89b-c808f56e6519" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}(5t)" :db/id #edb/ref 17592186306281}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}(5t)" :db/id #edb/ref 17592186306281} :answer-field/id #uuid "5d6fa421-5689-5aa3-8796-026376a17eaf" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307816} {:answer-field/choices [{:answer/id #uuid "6300be7f-13fc-51f9-a766-c305037c844a" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}(5t)-\\operatorname{sin}(5t)" :db/id #edb/ref 17592186306109}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}(5t)-\\operatorname{sin}(5t)" :db/id #edb/ref 17592186306109} :answer-field/id #uuid "a8a68fda-03fb-510b-ad4a-29ed331aec09" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308059}] :question/id #uuid "b84514fc-4c30-5d7a-9804-4a0f60502965" :question/math-academy-id "q-334631" :question/problem "Find ${e}^{At}$ for $A=\\begin{bmatrix}-3 & -10 \\\\ 5 & 7\\end{bmatrix}.$ \n\n*Hint: The eigenvalues of $A$ are $2\\pm 5\\text{i}.$*\n\n| ${e}^{At}={e}^{2t}\\,\\,$ |  | {{field-1}} | $-2\\operatorname{sin}⁡(5t)$ |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-2}} | $\\operatorname{sin}⁡(5t)+\\operatorname{cos}⁡(5t)$ |  |  |" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}-3 & -10 \\\\ 5 & 7\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3{\\alpha }_{1}t+{\\alpha }_{0} & -10{\\alpha }_{1}t \\\\ 5{\\alpha }_{1}t & 7{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix}.\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The eigenvalues or $At$ are \n\n$$\n{\\lambda }_{1}=(2+5\\text{i})t,\\,{\\lambda }_{2}=(2-5\\text{i})t,\n$$\n\nwhich are complex conjugates. Thus, we have the following:\n\n$$\n\\begin{aligned}r((2+5\\text{i})t) & ={e}^{(2+5\\text{i})t} \\\\ {\\alpha }_{1}(2+5\\text{i})t+{\\alpha }_{0} & ={e}^{2t}(\\operatorname{cos}⁡(5t)+\\text{i}\\operatorname{sin}⁡(5t)) \\\\ (2{\\alpha }_{1}t+{\\alpha }_{0})+5{\\alpha }_{1}\\text{i}t & ={e}^{2t}\\operatorname{cos}⁡(5t)+\\text{i}\\,{e}^{2t}\\operatorname{sin}⁡(5t)\\end{aligned}\n$$\n\nNow, we equate the real and imaginary parts, and solve for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}2{\\alpha }_{1}t+{\\alpha }_{0} &={e}^{2t}\\operatorname{cos}⁡(5t) \\\\ 5t{\\alpha }_{1} &={e}^{2t}\\operatorname{sin}⁡(5t)\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}{\\alpha }_{1} &=\\frac{1}{5t}{e}^{2t}\\operatorname{sin}⁡(5t) \\\\ {\\alpha }_{0} &={e}^{2t}(\\operatorname{cos}⁡(5t)-\\frac{2}{5}\\operatorname{sin}⁡(5t))\\end{aligned}\\right.\\end{aligned}\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}-3{\\alpha }_{1}t+{\\alpha }_{0} & =-3\\cdot \\frac{1}{5t}{e}^{2t}\\operatorname{sin}⁡(5t)\\cdot t+{e}^{2t}(\\operatorname{cos}⁡(5t)-\\frac{2}{5}\\operatorname{sin}⁡(5t)) \\\\  & =-\\frac{3}{5}{e}^{2t}\\operatorname{sin}⁡(5t)+{e}^{2t}\\operatorname{cos}⁡(5t)-\\frac{2}{5}{e}^{2t}\\operatorname{sin}⁡(5t) \\\\  & ={e}^{2t}(\\operatorname{cos}⁡(5t)-\\operatorname{sin}⁡(5t)) \\\\ 5{\\alpha }_{1}t & =5\\cdot \\frac{1}{5t}{e}^{2t}\\operatorname{sin}⁡(5t)\\cdot t \\\\  & ={e}^{2t}\\operatorname{sin}⁡(5t)\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{2t}\\begin{bmatrix}\\operatorname{cos}⁡(5t)-\\operatorname{sin}⁡(5t) & -2\\operatorname{sin}⁡(5t) \\\\ \\operatorname{sin}⁡(5t) & \\operatorname{sin}⁡(5t)+\\operatorname{cos}⁡(5t)\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186308657 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7805cc61-032d-5340-b315-43d00f9ec949" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{cos}(3t)-\\operatorname{sin}(3t)" :db/id #edb/ref 17592186306291}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{cos}(3t)-\\operatorname{sin}(3t)" :db/id #edb/ref 17592186306291} :answer-field/id #uuid "5694d036-6e3a-56ea-beeb-680490a87b8c" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307787} {:answer-field/choices [{:answer/id #uuid "aacf013a-2689-512b-8794-bcbacddaf843" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\operatorname{sin}(3t)" :db/id #edb/ref 17592186306764}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-5\\operatorname{sin}(3t)" :db/id #edb/ref 17592186306764} :answer-field/id #uuid "674d0fa8-85cf-5f7e-bdaa-2d7ca81bb93d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307849}] :question/id #uuid "f29b7109-5c33-5046-8236-7d693dea5b92" :question/math-academy-id "q-334634" :question/problem "Find ${e}^{At}$ for $A=\\begin{bmatrix}1 & 2 \\\\ -5 & -1\\end{bmatrix}.$ \n\n*Hint: The eigenvalues of $A$ are $\\pm 3\\text{i}.$*\n\n| ${e}^{At}=\\frac{1}{3}\\,\\,$ |  | $3\\operatorname{cos}⁡(3t)+\\operatorname{sin}⁡(3t)$ | $2\\operatorname{sin}⁡(3t)$ |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-1}} | {{field-2}} |  |  |" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}1 & 2 \\\\ -5 & -1\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}{\\alpha }_{1}t+{\\alpha }_{0} & 2{\\alpha }_{1}t \\\\ -5{\\alpha }_{1}t & -{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix},\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The eigenvalues or $At$ are \n\n$$\n{\\lambda }_{1}=3\\text{i}t,\\,{\\lambda }_{2}=-3\\text{i}t,\n$$\n\nwhich are complex conjugates. Thus, we have the following:\n\n$$\n\\begin{aligned}r(3\\text{i}t) & ={e}^{3\\text{i}t} \\\\ {\\alpha }_{1}\\cdot 3\\text{i}t+{\\alpha }_{0} & =\\operatorname{cos}⁡(3t)+\\text{i}\\operatorname{sin}⁡(3t) \\\\ {\\alpha }_{0}+3{\\alpha }_{1}\\text{i}t & =\\operatorname{cos}⁡(3t)+\\text{i}\\operatorname{sin}⁡(3t).\\end{aligned}\n$$\n\nNow, we equate the real and imaginary parts, and solve for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}{\\alpha }_{0} &=\\operatorname{cos}⁡(3t) \\\\ 3{\\alpha }_{1}t &=\\operatorname{sin}⁡(3t)\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}{\\alpha }_{1} &=\\frac{1}{3t}\\operatorname{sin}⁡(3t) \\\\ {\\alpha }_{0} &=\\operatorname{cos}⁡(3t)\\end{aligned}\\right.\\end{aligned}\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}-5{\\alpha }_{1}t & =-5\\cdot \\frac{1}{3t}\\operatorname{sin}⁡(3t)\\cdot t \\\\  & =-\\frac{5}{3}\\operatorname{sin}⁡(3t) \\\\ -{\\alpha }_{1}t+{\\alpha }_{0} & =-\\frac{1}{3t}\\operatorname{sin}⁡(3t)\\cdot t+\\operatorname{cos}⁡(3t) \\\\  & =-\\frac{1}{3}\\operatorname{sin}⁡(3t)+\\operatorname{cos}⁡(3t) \\\\  & =\\frac{1}{3}(3\\operatorname{cos}⁡(3t)-\\operatorname{sin}⁡(3t))\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}=\\frac{1}{3}\\begin{bmatrix}3\\operatorname{cos}⁡(3t)+\\operatorname{sin}⁡(3t) & 2\\operatorname{sin}⁡(3t) \\\\ -5\\operatorname{sin}⁡(3t) & 3\\operatorname{cos}⁡(3t)-\\operatorname{sin}⁡(3t)\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186308658 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f557fc11-6e33-5c97-9b5a-ccf282e3eb1a" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{cos}(4t)-2\\operatorname{sin}(4t)" :db/id #edb/ref 17592186307423}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{cos}(4t)-2\\operatorname{sin}(4t)" :db/id #edb/ref 17592186307423} :answer-field/id #uuid "3f42e1bb-c4ab-537a-86cc-4a0fe8f5ac9d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307717} {:answer-field/choices [{:answer/id #uuid "faed697c-042f-5ce8-90ab-5ad8592b127a" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{cos}(4t)+2\\operatorname{sin}(4t)" :db/id #edb/ref 17592186307476}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{cos}(4t)+2\\operatorname{sin}(4t)" :db/id #edb/ref 17592186307476} :answer-field/id #uuid "82a3a719-7051-513f-a3b3-a1290063f843" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307931}] :question/id #uuid "b1c86e08-63ee-5a97-b95f-27068e31ae61" :question/math-academy-id "q-334635" :question/problem "Find ${e}^{At}$ for $A=\\begin{bmatrix}2 & 5 \\\\ -4 & -2\\end{bmatrix}.$ \n\n*Hint: The eigenvalues of $A$ are $\\pm 4\\text{i}.$*\n\n| ${e}^{At}=\\frac{1}{4}\\,\\,$ |  | {{field-1}} | $5\\operatorname{sin}⁡(4t)$ |  |\n| --- | --- | --- | --- | --- |\n|  | $-4\\operatorname{sin}⁡(4t)$ | {{field-2}} |  |  |" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}2 & 5 \\\\ -4 & -2\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2{\\alpha }_{1}t+{\\alpha }_{0} & 5{\\alpha }_{1}t \\\\ -4{\\alpha }_{1}t & -{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix},\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The eigenvalues or $At$ are \n\n$$\n{\\lambda }_{1}=4\\text{i}t,\\,{\\lambda }_{2}=-4\\text{i}t,\n$$\n\nwhich are complex conjugates. Thus, we have the following:\n\n$$\n\\begin{aligned}r(4\\text{i}t) & ={e}^{4\\text{i}t} \\\\ {\\alpha }_{1}\\cdot 4\\text{i}t+{\\alpha }_{0} & =\\operatorname{cos}⁡(4t)+\\text{i}\\operatorname{sin}⁡(4t) \\\\ {\\alpha }_{0}+4{\\alpha }_{1}\\text{i}t & =\\operatorname{cos}⁡(4t)+\\text{i}\\operatorname{sin}⁡(4t).\\end{aligned}\n$$\n\nNow, we equate the real and imaginary parts, and solve for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}{\\alpha }_{0} &=\\operatorname{cos}⁡(4t) \\\\ 4{\\alpha }_{1}t &=\\operatorname{sin}⁡(4t)\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}{\\alpha }_{1} &=\\frac{1}{4t}\\operatorname{sin}⁡(4t) \\\\ {\\alpha }_{0} &=\\operatorname{cos}⁡(4t)\\end{aligned}\\right.\\end{aligned}\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}2{\\alpha }_{1}t+{\\alpha }_{0} & =2\\cdot \\frac{1}{4t}\\operatorname{sin}⁡(4t)\\cdot t+\\operatorname{cos}⁡(4t) \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡(4t)+\\operatorname{cos}⁡(4t) \\\\  & =\\frac{1}{4}(4\\operatorname{cos}⁡(4t)+2\\operatorname{sin}⁡(4t)) \\\\ -{\\alpha }_{1}t+{\\alpha }_{0} & =-\\frac{1}{4t}\\operatorname{sin}⁡(4t)\\cdot t+\\operatorname{cos}⁡(4t) \\\\  & =-\\frac{1}{4}\\operatorname{sin}⁡(4t)+\\operatorname{cos}⁡(4t) \\\\  & =\\frac{1}{4}(4\\operatorname{cos}⁡(4t)-2\\operatorname{sin}⁡(4t))\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}=\\frac{1}{4}\\begin{bmatrix}4\\operatorname{cos}⁡(4t)+2\\operatorname{sin}⁡(4t) & 5\\operatorname{sin}⁡(4t) \\\\ -4\\operatorname{sin}⁡(4t) & 4\\operatorname{cos}⁡(4t)-2\\operatorname{sin}⁡(4t)\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186308659 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "927993f7-35ee-5a7b-b678-8138ec798808" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\operatorname{sin}(t)" :db/id #edb/ref 17592186306538}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-5\\operatorname{sin}(t)" :db/id #edb/ref 17592186306538} :answer-field/id #uuid "74bafa21-d41e-5f7b-b42e-81c48e2d289f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307888} {:answer-field/choices [{:answer/id #uuid "28f285b2-a912-5f77-a986-1cfddd610e74" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}(t)" :db/id #edb/ref 17592186305534}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}(t)" :db/id #edb/ref 17592186305534} :answer-field/id #uuid "deed9659-a934-5824-aa48-2de4236e6fa9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308225}] :question/id #uuid "0448b3a1-752c-5dfe-8b80-002c75e77e8a" :question/math-academy-id "q-334636" :question/problem "Find ${e}^{At}$ for $A=\\begin{bmatrix}2 & 1 \\\\ -5 & -2\\end{bmatrix}.$ \n\n*Hint: The eigenvalues of $A$ are $\\pm \\text{i}.$*\n\n| ${e}^{At}=\\,\\,$ |  | $\\operatorname{cos}⁡(t)+2\\operatorname{sin}⁡(t)$ | {{field-1}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-2}} | $\\operatorname{cos}⁡(t)-2\\operatorname{sin}⁡(t)$ |  |  |" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}2 & 1 \\\\ -5 & -2\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2{\\alpha }_{1}t+{\\alpha }_{0} & {\\alpha }_{1}t \\\\ -5{\\alpha }_{1}t & -2{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix},\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The eigenvalues or $At$ are \n\n$$\n{\\lambda }_{1}=\\text{i}t,\\,{\\lambda }_{2}=-\\text{i}t,\n$$\n\nwhich are complex conjugates. Thus, we have the following:\n\n$$\n\\begin{aligned}r(\\text{i}t) & ={e}^{\\text{i}t} \\\\ {\\alpha }_{1}\\cdot \\text{i}t+{\\alpha }_{0} & =\\operatorname{cos}⁡(t)+\\text{i}\\operatorname{sin}⁡(t) \\\\ {\\alpha }_{0}+{\\alpha }_{1}\\text{i}t & =\\operatorname{cos}⁡(t)+\\text{i}\\operatorname{sin}⁡(t).\\end{aligned}\n$$\n\nNow, we equate the real and imaginary parts, and solve for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}{\\alpha }_{0} &=\\operatorname{cos}⁡(t) \\\\ {\\alpha }_{1}t &=\\operatorname{sin}⁡(t)\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}{\\alpha }_{1} &=\\frac{1}{t}\\operatorname{sin}⁡(t) \\\\ {\\alpha }_{0} &=\\operatorname{cos}⁡(t)\\end{aligned}\\right.\\end{aligned}\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}{\\alpha }_{1}t & =\\frac{1}{t}\\operatorname{sin}⁡(t)\\cdot t \\\\  & =\\operatorname{sin}⁡(t) \\\\ -5{\\alpha }_{1}t & =-5\\cdot \\frac{1}{t}\\operatorname{sin}⁡(t)\\cdot t \\\\  & =-5\\operatorname{sin}⁡(t)\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(t)+2\\operatorname{sin}⁡(t) & \\operatorname{sin}⁡(t) \\\\ -5\\operatorname{sin}⁡(t) & \\operatorname{cos}⁡(t)-2\\operatorname{sin}⁡(t)\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186308660 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cded054f-fd7d-5541-b119-acd319ea1369" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{cos}(5t)-\\operatorname{sin}(5t)" :db/id #edb/ref 17592186307055}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{cos}(5t)-\\operatorname{sin}(5t)" :db/id #edb/ref 17592186307055} :answer-field/id #uuid "ebe30a28-0d85-5a80-a24a-88caf298d3fa" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308262} {:answer-field/choices [{:answer/id #uuid "173c0281-09d3-5067-b83f-37506d1cb0c3" :answer/type {:db/ident :answer.type/math} :answer/value "-13\\operatorname{sin}(5t)" :db/id #edb/ref 17592186305365}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-13\\operatorname{sin}(5t)" :db/id #edb/ref 17592186305365} :answer-field/id #uuid "fdf013e3-bfec-56fb-abcf-075b57f8eb70" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308330}] :question/id #uuid "94b786d3-6c88-5e7c-b171-415f525959f6" :question/math-academy-id "q-334637" :question/problem "Find ${e}^{At}$ for $A=\\begin{bmatrix}1 & 2 \\\\ -13 & -1\\end{bmatrix}.$ \n\n*Hint: The eigenvalues of $A$ are $\\pm 5\\text{i}.$*\n\n| ${e}^{At}=\\frac{1}{5}\\,\\,$ |  | $5\\operatorname{cos}⁡(5t)+\\operatorname{sin}⁡(5t)$ | $2\\operatorname{sin}⁡(5t)$ |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-1}} | {{field-2}} |  |  |" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}1 & 2 \\\\ -13 & -1\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}{\\alpha }_{1}t+{\\alpha }_{0} & 2{\\alpha }_{1}t \\\\ -13{\\alpha }_{1}t & -{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix},\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The eigenvalues or $At$ are \n\n$$\n{\\lambda }_{1}=5\\text{i}t,\\,{\\lambda }_{2}=-5\\text{i}t,\n$$\n\nwhich are complex conjugates. Thus, we have the following:\n\n$$\n\\begin{aligned}r(5\\text{i}t) & ={e}^{5\\text{i}t} \\\\ {\\alpha }_{1}\\cdot 5\\text{i}t+{\\alpha }_{0} & =\\operatorname{cos}⁡(5t)+\\text{i}\\operatorname{sin}⁡(5t) \\\\ {\\alpha }_{0}+5{\\alpha }_{1}\\text{i}t & =\\operatorname{cos}⁡(5t)+\\text{i}\\operatorname{sin}⁡(5t).\\end{aligned}\n$$\n\nNow, we equate the real and imaginary parts, and solve for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}{\\alpha }_{0} &=\\operatorname{cos}⁡(5t) \\\\ 5{\\alpha }_{1}t &=\\operatorname{sin}⁡(5t)\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}{\\alpha }_{1} &=\\frac{1}{5t}\\operatorname{sin}⁡(5t) \\\\ {\\alpha }_{0} &=\\operatorname{cos}⁡(5t)\\end{aligned}\\right.\\end{aligned}\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}-13{\\alpha }_{1}t & =-13\\cdot \\frac{1}{5t}\\operatorname{sin}⁡(5t)\\cdot t \\\\  & =-\\frac{13}{5}\\operatorname{sin}⁡(5t) \\\\ -{\\alpha }_{1}t+{\\alpha }_{0} & =-\\frac{1}{5t}\\operatorname{sin}⁡(5t)\\cdot t+\\operatorname{cos}⁡(5t) \\\\  & =-\\frac{1}{5}\\operatorname{sin}⁡(5t)+\\operatorname{cos}⁡(5t) \\\\  & =\\frac{1}{5}(5\\operatorname{cos}⁡(5t)-\\operatorname{sin}⁡(5t))\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}=\\frac{1}{5}\\begin{bmatrix}5\\operatorname{cos}⁡(5t)+\\operatorname{sin}⁡(5t) & 2\\operatorname{sin}⁡(5t) \\\\ -13\\operatorname{sin}⁡(5t) & 5\\operatorname{cos}⁡(5t)-\\operatorname{sin}⁡(5t)\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186370129 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7afe076b-ab10-5a6d-92ee-d9bda36095eb" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}(t)" :db/id #edb/ref 17592186370131}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}(t)" :db/id #edb/ref 17592186370131} :answer-field/id #uuid "8717736e-bf1d-56b9-8978-2ee27ddc1c10" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186370130} {:answer-field/choices [{:answer/id #uuid "116b716d-7743-526a-8367-67bb770fa2aa" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}(t)" :db/id #edb/ref 17592186370133}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}(t)" :db/id #edb/ref 17592186370133} :answer-field/id #uuid "6684d3cf-4512-5e44-a922-9538752b4a1d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186370132}] :question/id #uuid "eace89bb-5f6d-586f-b6ba-d2d1f4b38da0" :question/math-academy-id "q-334633" :question/problem "Find ${e}^{At}$ for $A=\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}.$ \n\n*Hint: The eigenvalues of $A$ are $\\pm \\text{i}.$*\n\n| ${e}^{At}=\\,\\,$ |  | $\\operatorname{cos}⁡(t)$ | {{field-1}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-2}} | $\\operatorname{cos}⁡(t)$ |  |  |" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}{\\alpha }_{0} & -{\\alpha }_{1}t \\\\ {\\alpha }_{1}t & {\\alpha }_{0}\\end{bmatrix},\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The eigenvalues or $At$ are \n\n$$\n{\\lambda }_{1}=\\text{i}t,\\,{\\lambda }_{2}=-\\text{i}t,\n$$\n\nwhich are complex conjugates. Thus, we have the following:\n\n$$\n\\begin{aligned}r(\\text{i}t) & ={e}^{\\text{i}t} \\\\ {\\alpha }_{1}\\cdot \\text{i}t+{\\alpha }_{0} & =\\operatorname{cos}⁡(t)+\\text{i}\\operatorname{sin}⁡(t) \\\\ {\\alpha }_{0}+{\\alpha }_{1}\\text{i}t & =\\operatorname{cos}⁡(t)+\\text{i}\\operatorname{sin}⁡(t).\\end{aligned}\n$$\n\nNow, we equate the real and imaginary parts, and solve for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}{\\alpha }_{0} &=\\operatorname{cos}⁡(t) \\\\ {\\alpha }_{1}t &=\\operatorname{sin}⁡(t)\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}{\\alpha }_{1} &=\\frac{1}{t}\\operatorname{sin}⁡(t) \\\\ {\\alpha }_{0} &=\\operatorname{cos}⁡(t)\\end{aligned}\\right.\\end{aligned}\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}-{\\alpha }_{1}t & =-\\frac{1}{t}\\operatorname{sin}⁡(t)\\cdot t \\\\  & =-\\operatorname{sin}⁡(t) \\\\ {\\alpha }_{1}t & =\\frac{1}{t}\\operatorname{sin}⁡(t)\\cdot t \\\\  & =\\operatorname{sin}⁡(t)\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(t) & -\\operatorname{sin}⁡(t) \\\\ \\operatorname{sin}⁡(t) & \\operatorname{cos}⁡(t)\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186532679 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a8db4e8-f732-5d22-9704-09e0ccf298b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos(3t)+\\sin(3t)" :db/id #edb/ref 17592186532285}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\cos(3t)+\\sin(3t)" :db/id #edb/ref 17592186532285} :answer-field/id #uuid "3247c73e-d754-5617-80f3-a0beacefea90" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186532515} {:answer-field/choices [{:answer/id #uuid "f84eb7c6-9806-5d01-aade-ce5ce09883c7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sin(3t)" :db/id #edb/ref 17592186532472}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-\\sin(3t)" :db/id #edb/ref 17592186532472} :answer-field/id #uuid "4788b925-6ee1-5536-8ffa-a6478b71d51d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186532525}] :question/id #uuid "900adaef-859d-5d14-9981-202d2269e069" :question/math-academy-id "q-334626" :question/problem "Find ${e}^{At}$ for $A=[\\begin{aligned}5 & 6 \\\\ -3 & -1\\end{aligned}].$ \n\n*Hint: The eigenvalues of $A$ are $2\\pm 3\\text{i}.$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">${e}^{At}={e}^{2t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"140px\">{{field-1}}</td>\n<td align=\"center\" width=\"140px\">$2\\operatorname{sin}⁡(3t)$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\" width=\"30px\">$\\operatorname{cos}⁡(3t)-\\operatorname{sin}⁡(3t)$</td>\n<td align=\"center\"></td>\n</tr></tbody></table>" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}[\\begin{aligned}5 & 6 \\\\ -3 & -1\\end{aligned}]t+{\\alpha }_{0}[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}5{\\alpha }_{1}t+{\\alpha }_{0} & 6{\\alpha }_{1}t \\\\ -3{\\alpha }_{1}t & -{\\alpha }_{1}t+{\\alpha }_{0}\\end{aligned}].\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The eigenvalues or $At$ are \n\n$$\n{\\lambda }_{1}=(2+3\\text{i})t,\\,{\\lambda }_{2}=(2-3\\text{i})t,\n$$\n\nwhich are complex conjugates. Thus, we have the following:\n\n$$\n\\begin{aligned}r((2+3\\text{i})t) & ={e}^{(2+3\\text{i})t} \\\\ {\\alpha }_{1}(2+3\\text{i})t+{\\alpha }_{0} & ={e}^{2t}(\\operatorname{cos}⁡(3t)+\\text{i}\\operatorname{sin}⁡(3t)) \\\\ (2{\\alpha }_{1}t+{\\alpha }_{0})+3{\\alpha }_{1}\\text{i}t & ={e}^{2t}\\operatorname{cos}⁡(3t)+\\text{i}\\,{e}^{2t}\\operatorname{sin}⁡(3t)\\end{aligned}\n$$\n\nNow, we equate the real and imaginary parts, and solve for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n$$\n\\begin{aligned}\\{\\begin{aligned}2{\\alpha }_{1}t+{\\alpha }_{0}={e}^{2t}\\operatorname{cos}⁡(3t) \\\\ 3t{\\alpha }_{1}={e}^{2t}\\operatorname{sin}⁡(3t)\\end{aligned}\\,⇒\\,\\{\\begin{aligned}{\\alpha }_{1}=\\frac{1}{3t}{e}^{2t}\\operatorname{sin}⁡(3t) \\\\ {\\alpha }_{0}={e}^{2t}(\\operatorname{cos}⁡(3t)-\\frac{2}{3}\\operatorname{sin}⁡(3t))\\end{aligned}\\end{aligned}\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}5{\\alpha }_{1}t+{\\alpha }_{0} & =5\\cdot \\frac{1}{3t}{e}^{2t}\\operatorname{sin}⁡(3t)\\cdot t+{e}^{2t}(\\operatorname{cos}⁡(3t)-\\frac{2}{3}\\operatorname{sin}⁡(3t)) \\\\  & =\\frac{5}{3}{e}^{2t}\\operatorname{sin}⁡(3t)+{e}^{2t}\\operatorname{cos}⁡(3t)-\\frac{2}{3}{e}^{2t}\\operatorname{sin}⁡(3t) \\\\  & ={e}^{2t}(\\operatorname{cos}⁡(3t)+\\operatorname{sin}⁡(3t)) \\\\ -3{\\alpha }_{1}t & =-3\\cdot \\frac{1}{3t}{e}^{2t}\\operatorname{sin}⁡(3t)\\cdot t \\\\  & =-{e}^{2t}\\operatorname{sin}⁡(3t)\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{2t}[\\begin{aligned}\\operatorname{cos}⁡(3t)+\\operatorname{sin}⁡(3t) & 2\\operatorname{sin}⁡(3t) \\\\ -\\operatorname{sin}⁡(3t) & \\operatorname{cos}⁡(3t)-\\operatorname{sin}⁡(3t)\\end{aligned}].\n$$"}] :knowledge-point/title "Finding the Matrix Exponent for a Matrix With Distinct Complex Eigenvalues"} {:db/id #edb/ref 17592186221410 :knowledge-point/canonical-example {:db/id #edb/ref 17592186221152 :question/id #uuid "40a6318a-a1c9-55f3-afdb-02b43891d7b5" :question/math-academy-id "e-21273" :question/problem "Find $e^{At}$ for ![](images/96/9657b1346f9aa79eaa2d05d0a94b5e13745fedc83b035cbd59f1efdb10ce19bf.png) \n\n*Hint: The only eigenvalue of $A$ is $6,$ and it has multiplicity two.*" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}8 & -2 \\\\ 2 & 4\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}8{\\alpha }_{1}t+{\\alpha }_{0} & -2{\\alpha }_{1}t \\\\ 2{\\alpha }_{1}t & 4{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix},\\end{aligned}\n$$\n\nwhere $\\alpha_1$ and $\\alpha_0$ are constants to be determined.\n\nConsider the polynomial $r(\\lambda) = \\alpha_1 \\lambda + \\alpha_0.$ The only eigenvalue of $At$ is \n\n$$\n\\lambda_1 = 6t\n$$\n\nof multiplicity two. Thus, we have the following:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}r(6t) &={e}^{6t} \\\\ \\frac{\\text{d}}{\\text{d}\\lambda }r(6t) &={e}^{6t}\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}6t{\\alpha }_{1}+{\\alpha }_{0} &={e}^{6t} \\\\ {\\alpha }_{1} &={e}^{6t}\\end{aligned}\\right.\\end{aligned}\n$$\n\nNow, we solve the system for $\\alpha_1$ and $\\alpha_0{:}$\n\n- From the second equation, we get\n\n$$\n\\alpha_1 = e^{6t}.\n$$\n\n- Substituting this into the first one, we get\n\n$$\n6t e^{6t} + \\alpha_0 = e^{6t}\n\\qquad\\Rightarrow\\qquad\n\\alpha_0 = e^{6t}(1-6t).\n$$\n\nSubstituting $\\alpha_1$ and $\\alpha_0$ into the expressions for the required entries of $e^{At},$ we get the following:\n\n$$\n\\begin{aligned}8{\\alpha }_{1}t+{\\alpha }_{0} & =8{e}^{6t}t+{e}^{6t}(1-6t) \\\\  & ={e}^{6t}(1+2t), \\\\ -2{\\alpha }_{1}t & =-2{e}^{6t}t \\\\  & ={e}^{6t}(-2t), \\\\ 2{\\alpha }_{1}t & =2{e}^{6t}t \\\\  & ={e}^{6t}(2t), \\\\ 4{\\alpha }_{1}t+{\\alpha }_{0} & =4{e}^{6t}t+{e}^{6t}(1-6t) \\\\  & ={e}^{6t}(1-2t).\\end{aligned}\n$$\n\nTherefore,\n![](images/70/70c4e625ac52b04e9a1fb258470138050a51cdacaced8714cd2a313782055c3f.png)"} :knowledge-point/id #uuid "0fd1d280-c768-5504-892e-a9a1948e1f1a" :knowledge-point/questions [{:db/id #edb/ref 17592186221933 :question/answer-fields [{:answer-field/id #uuid "f2b34d4c-905e-56b4-94eb-04d177c1c9d4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186220208} {:answer-field/id #uuid "2d759da5-300e-5cf3-941a-a273a1c633d3" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186220209}] :question/id #uuid "b10f5340-8ef5-5fb3-b26f-d1f92aac8ec8" :question/math-academy-id "q-329001" :question/problem "Find $e^{At}$ for $A = \\begin{bmatrix}1 & 2 \\\\ -2 & 5\\end{bmatrix}$.\n\n*Hint: The only eigenvalue of $A$ is $3$, and it has multiplicity two.*\n\n| $e^{At} = e^{3t}$ |  | {{field-1}} | $2t$ |  |\n| --- | ---: | ---: | ---: | ---: |\n|  | {{field-2}} | $2t + 1$ |  |  |"} {:db/id #edb/ref 17592186222003 :question/answer-fields [{:answer-field/id #uuid "a428e1ce-3198-56ee-8631-27ff79bd731e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186220689} {:answer-field/id #uuid "b713afed-e73c-5846-8476-bb70e7fde380" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186220690} {:answer-field/choices [{:answer/id #uuid "ce8f981b-71da-59bb-b809-35a5f6eec166" :answer/type {:db/ident :answer.type/math} :answer/value "1+t" :db/id #edb/ref 17592186370135}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1+t" :db/id #edb/ref 17592186370135} :answer-field/id #uuid "ae92c59e-bcfd-5ca8-aae6-08bac1ebdb24" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186370134} {:answer-field/choices [{:answer/id #uuid "1f520118-5444-5b50-9789-1db81dcf5c4c" :answer/type {:db/ident :answer.type/math} :answer/value "t" :db/id #edb/ref 17592186370137}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "t" :db/id #edb/ref 17592186370137} :answer-field/id #uuid "cd559317-58ff-57af-a185-6fc110028370" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186370136}] :question/id #uuid "f6b87582-0905-5c05-a6c7-6cb8579c20ef" :question/math-academy-id "q-334721" :question/problem "Find ${e}^{At}$ for $A=\\begin{bmatrix}3 & 1 \\\\ -1 & 1\\end{bmatrix}.$ \n\n*Hint: The only eigenvalue of $A$ is $2,$ and it has multiplicity two.*\n\n| ${e}^{At}={e}^{2t}\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | $-t$ | $1-t$ |  |  |" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}3 & 1 \\\\ -1 & 1\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3{\\alpha }_{1}t+{\\alpha }_{0} & {\\alpha }_{1}t \\\\ -{\\alpha }_{1}t & {\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix},\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The only eigenvalue of $At$ is \n\n$$\n{\\lambda }_{1}=2t\n$$\n\nof multiplicity two. Thus, we have the following:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}r(2t) &={e}^{2t} \\\\ \\frac{\\text{d}}{\\text{d}\\lambda }r(2t) &={e}^{2t}\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}2t{\\alpha }_{1}+{\\alpha }_{0} &={e}^{2t} \\\\ {\\alpha }_{1} &={e}^{2t}\\end{aligned}\\right.\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- From the second equation, we get\n\n$$\n{\\alpha }_{1}={e}^{2t}.\n$$\n\n- Substituting this into the first one, we get\n\n$$\n2t{e}^{2t}+{\\alpha }_{0}={e}^{2t}\\,⇒\\,{\\alpha }_{0}={e}^{2t}(1-2t).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}3{\\alpha }_{1}t+{\\alpha }_{0} & =3{e}^{2t}t+{e}^{2t}(1-2t) \\\\  & ={e}^{2t}(1+t), \\\\ {\\alpha }_{1}t & ={e}^{2t}t\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{2t}\\begin{bmatrix}1+t & t \\\\ -t & 1-t\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186308670 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5a54273-3450-5c26-84d7-383486f21cec" :answer/type {:db/ident :answer.type/math} :answer/value "-3t" :db/id #edb/ref 17592186307277}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-3t" :db/id #edb/ref 17592186307277} :answer-field/id #uuid "3db64a2d-0768-5ffd-ba7e-05c9f4485c48" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307712} {:answer-field/choices [{:answer/id #uuid "ec22e530-554e-5020-8783-f257d54f500f" :answer/type {:db/ident :answer.type/math} :answer/value "1+3t" :db/id #edb/ref 17592186307324}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1+3t" :db/id #edb/ref 17592186307324} :answer-field/id #uuid "f5cf4951-3613-5027-8a9a-0372890bd5d1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308300}] :question/id #uuid "79079e07-e6bc-5f6a-8ed1-2ff769b8b920" :question/math-academy-id "q-334729" :question/problem "Find ${e}^{At}$ for $A=\\begin{bmatrix}6 & -3 \\\\ 3 & 0\\end{bmatrix}.$ \n\n*Hint: The only eigenvalue of $A$ is $3,$ and it has multiplicity two.*\n\n| ${e}^{At}={e}^{3t}\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | $3t$ | $1-3t$ |  |  |" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}6 & -3 \\\\ 3 & 0\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}6{\\alpha }_{1}t+{\\alpha }_{0} & -3{\\alpha }_{1}t \\\\ 3{\\alpha }_{1}t & {\\alpha }_{0}\\end{bmatrix},\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The only eigenvalue of $At$ is \n\n$$\n{\\lambda }_{1}=3t\n$$\n\nof multiplicity two. Thus, we have the following:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}r(3t) &={e}^{3t} \\\\ \\frac{\\text{d}}{\\text{d}\\lambda }r(3t) &={e}^{3t}\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}3t{\\alpha }_{1}+{\\alpha }_{0} &={e}^{3t} \\\\ {\\alpha }_{1} &={e}^{3t}\\end{aligned}\\right.\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- From the second equation, we get\n\n$$\n{\\alpha }_{1}={e}^{3t}.\n$$\n\n- Substituting this into the first one, we get\n\n$$\n3t{e}^{3t}+{\\alpha }_{0}={e}^{3t}\\,⇒\\,{\\alpha }_{0}={e}^{3t}(1-3t).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}6{\\alpha }_{1}t+{\\alpha }_{0} & =6{e}^{3t}t+{e}^{3t}(1-3t) \\\\  & ={e}^{3t}(1+3t), \\\\ -3{\\alpha }_{1}t & =-3{e}^{3t}t\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{3t}\\begin{bmatrix}1+3t & -3t \\\\ 3t & 1-3t\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186308671 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dc77b25-10f0-5fcc-b121-8035c5c47b67" :answer/type {:db/ident :answer.type/math} :answer/value "1+3t" :db/id #edb/ref 17592186305748}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1+3t" :db/id #edb/ref 17592186305748} :answer-field/id #uuid "0b003260-9011-5122-bb54-0ae8efa204ae" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307561} {:answer-field/choices [{:answer/id #uuid "f903f38a-a03e-501d-a6a2-b2b3a6c9cf64" :answer/type {:db/ident :answer.type/math} :answer/value "-9t" :db/id #edb/ref 17592186307455}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-9t" :db/id #edb/ref 17592186307455} :answer-field/id #uuid "6d284c1f-1a9f-54a1-9a76-8cd08a3b0efc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307874}] :question/id #uuid "3361c13c-b482-5551-8d22-7ff3a0ff8596" :question/math-academy-id "q-334732" :question/problem "Find ${e}^{At}$ for $A=\\begin{bmatrix}-2 & 1 \\\\ -9 & 4\\end{bmatrix}.$ \n\n*Hint: The only eigenvalue of $A$ is $1,$ and it has multiplicity two.*\n\n| ${e}^{At}={e}^{t}\\,\\,$ |  | $1-3t$ | $t$ |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-1}} | {{field-2}} |  |  |" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}-2 & 1 \\\\ -9 & 4\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2{\\alpha }_{1}t+{\\alpha }_{0} & {\\alpha }_{1}t \\\\ -9{\\alpha }_{1}t & 4{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix}.\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The only eigenvalue of $At$ is \n\n$$\n{\\lambda }_{1}=t\n$$\n\nof multiplicity two. Thus, we have the following:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}r(t) &={e}^{t} \\\\ \\frac{\\text{d}}{\\text{d}\\lambda }r(t) &={e}^{t}\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}t{\\alpha }_{1}+{\\alpha }_{0} &={e}^{t} \\\\ {\\alpha }_{1} &={e}^{t}\\end{aligned}\\right.\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- From the second equation, we get\n\n$$\n{\\alpha }_{1}={e}^{t}.\n$$\n\n- Substituting this into the first one, we get\n\n$$\nt{e}^{t}+{\\alpha }_{0}={e}^{t}\\,⇒\\,{\\alpha }_{0}={e}^{t}(1-t).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}-9{\\alpha }_{1}t & =-9{e}^{t}t \\\\ 4{\\alpha }_{1}t+{\\alpha }_{0} & =4{e}^{t}t+{e}^{t}(1-t) \\\\  & ={e}^{t}(1+3t)\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{t}\\begin{bmatrix}1-3t & t \\\\ -9t & 1+3t\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186308672 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52b1d7ae-e4dd-5799-9115-e6e7b1fd12ae" :answer/type {:db/ident :answer.type/math} :answer/value "12t" :db/id #edb/ref 17592186305951}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "12t" :db/id #edb/ref 17592186305951} :answer-field/id #uuid "5dde19ef-9af0-5255-a3d4-655b000140c4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307818} {:answer-field/choices [{:answer/id #uuid "0fc7ea02-06bd-5e6c-aed2-4751d80186b1" :answer/type {:db/ident :answer.type/math} :answer/value "1+6t" :db/id #edb/ref 17592186305289}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1+6t" :db/id #edb/ref 17592186305289} :answer-field/id #uuid "893c4189-3f31-573e-94ae-26b874312a53" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307952}] :question/id #uuid "4bf1a0f0-bb87-5dac-ad3b-1ce93c87e2a8" :question/math-academy-id "q-334733" :question/problem "Find ${e}^{At}$ for $A=\\begin{bmatrix}8 & -3 \\\\ 12 & -4\\end{bmatrix}.$ \n\n*Hint: The only eigenvalue of $A$ is $2,$ and it has multiplicity two.*\n\n| ${e}^{At}={e}^{2t}\\,\\,$ |  | {{field-1}} | $-3t$ |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-2}} | $1-6t$ |  |  |" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}8 & -3 \\\\ 12 & -4\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}8{\\alpha }_{1}t+{\\alpha }_{0} & -3{\\alpha }_{1}t \\\\ 12{\\alpha }_{1}t & -4{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix}.\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The only eigenvalue of $At$ is \n\n$$\n{\\lambda }_{1}=2t\n$$\n\nof multiplicity two. Thus, we have the following:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}r(2t) &={e}^{2t} \\\\ \\frac{\\text{d}}{\\text{d}\\lambda }r(2t) &={e}^{2t}\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}2t{\\alpha }_{1}+{\\alpha }_{0} &={e}^{2t} \\\\ {\\alpha }_{1} &={e}^{2t}\\end{aligned}\\right.\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- From the second equation, we get\n\n$$\n{\\alpha }_{1}={e}^{2t}.\n$$\n\n- Substituting this into the first one, we get\n\n$$\n2t{e}^{2t}+{\\alpha }_{0}={e}^{2t}\\,⇒\\,{\\alpha }_{0}={e}^{2t}(1-2t).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}8{\\alpha }_{1}t+{\\alpha }_{0} & =8{e}^{2t}t+{e}^{2t}(1-2t) \\\\  & ={e}^{2t}(1+6t) \\\\ 12{\\alpha }_{1}t & =12{e}^{2t}t\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{2t}\\begin{bmatrix}1+6t & -3t \\\\ 12t & 1-6t\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186308673 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19077b39-5510-509d-9a89-ee45f6b5d61e" :answer/type {:db/ident :answer.type/math} :answer/value "-t" :db/id #edb/ref 17592186305379}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-t" :db/id #edb/ref 17592186305379} :answer-field/id #uuid "3638313c-e8b7-5c36-8156-7411f434b4d9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307693} {:answer-field/choices [{:answer/id #uuid "a9392ac7-2fb2-5f27-871a-3472eaf12ee7" :answer/type {:db/ident :answer.type/math} :answer/value "1-t" :db/id #edb/ref 17592186306745}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1-t" :db/id #edb/ref 17592186306745} :answer-field/id #uuid "e3239541-2877-5189-9f0d-345779dbab9f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308240}] :question/id #uuid "05e36fef-5d87-510d-a2e4-12cce4dfd1e8" :question/math-academy-id "q-334734" :question/problem "Find ${e}^{At}$ for $A=\\begin{bmatrix}7 & 1 \\\\ -1 & 5\\end{bmatrix}.$ \n\n*Hint: The only eigenvalue of $A$ is $6,$ and it has multiplicity two.*\n\n| ${e}^{At}={e}^{6t}\\,\\,$ |  | $1+t$ | $t$ |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-1}} | {{field-2}} |  |  |" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}7 & 1 \\\\ -1 & 5\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}7{\\alpha }_{1}t+{\\alpha }_{0} & {\\alpha }_{1}t \\\\ -{\\alpha }_{1}t & 5{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix},\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The only eigenvalue of $At$ is \n\n$$\n{\\lambda }_{1}=6t\n$$\n\nof multiplicity two. Thus, we have the following:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}r(6t) &={e}^{6t} \\\\ \\frac{\\text{d}}{\\text{d}\\lambda }r(6t) &={e}^{6t}\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}6t{\\alpha }_{1}+{\\alpha }_{0} &={e}^{6t} \\\\ {\\alpha }_{1} &={e}^{6t}\\end{aligned}\\right.\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- From the second equation, we get\n\n$$\n{\\alpha }_{1}={e}^{6t}.\n$$\n\n- Substituting this into the first one, we get\n\n$$\n6t{e}^{6t}+{\\alpha }_{0}={e}^{6t}\\,⇒\\,{\\alpha }_{0}={e}^{6t}(1-6t).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}-{\\alpha }_{1}t & =-{e}^{6t}t \\\\  & ={e}^{6t}(-t), \\\\ 5{\\alpha }_{1}t+{\\alpha }_{0} & =5{e}^{6t}t+{e}^{6t}(1-6t) \\\\  & ={e}^{6t}(1-t)\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{6t}\\begin{bmatrix}1+t & t \\\\ -t & 1-t\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186308674 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cddbd6d-ffb7-5530-be33-109a25cb590f" :answer/type {:db/ident :answer.type/math} :answer/value "1-4t" :db/id #edb/ref 17592186305736}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1-4t" :db/id #edb/ref 17592186305736} :answer-field/id #uuid "28239443-16fd-5045-bb7b-a3e946af529a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307647} {:answer-field/choices [{:answer/id #uuid "6fff644e-a154-526d-b37a-e4f82a475e0e" :answer/type {:db/ident :answer.type/math} :answer/value "-2t" :db/id #edb/ref 17592186306218}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-2t" :db/id #edb/ref 17592186306218} :answer-field/id #uuid "6cec750e-1b50-5e87-b62d-239edf61a752" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307873}] :question/id #uuid "d74b37d0-1ddd-5304-877c-4617a1e8ae03" :question/math-academy-id "q-334735" :question/problem "Find ${e}^{At}$ for $A=\\begin{bmatrix}7 & -2 \\\\ 8 & -1\\end{bmatrix}.$ \n\n*Hint: The only eigenvalue of $A$ is $3,$ and it has multiplicity two.*\n\n| ${e}^{At}={e}^{3t}\\,\\,$ |  | $1+4t$ | {{field-1}} |  |\n| --- | --- | --- | --- | --- |\n|  | $8t$ | {{field-2}} |  |  |" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}7 & -2 \\\\ 8 & -1\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}7{\\alpha }_{1}t+{\\alpha }_{0} & -2{\\alpha }_{1}t \\\\ 8{\\alpha }_{1}t & -{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix}.\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The only eigenvalue of $At$ is \n\n$$\n{\\lambda }_{1}=3t\n$$\n\nof multiplicity two. Thus, we have the following:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}r(3t) &={e}^{3t} \\\\ \\frac{\\text{d}}{\\text{d}\\lambda }r(3t) &={e}^{3t}\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}3t{\\alpha }_{1}+{\\alpha }_{0} &={e}^{3t} \\\\ {\\alpha }_{1} &={e}^{3t}\\end{aligned}\\right.\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- From the second equation, we get\n\n$$\n{\\alpha }_{1}={e}^{3t}.\n$$\n\n- Substituting this into the first one, we get\n\n$$\n3t{e}^{3t}+{\\alpha }_{0}={e}^{3t}\\,⇒\\,{\\alpha }_{0}={e}^{3t}(1-3t).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}-2{\\alpha }_{1}t & =-2{e}^{3t}t \\\\  & ={e}^{3t}(-2t) \\\\ -{\\alpha }_{1}t+{\\alpha }_{0} & =-{e}^{3t}t+{e}^{3t}(1-3t) \\\\  & ={e}^{3t}(1-4t)\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{3t}\\begin{bmatrix}1+4t & -2t \\\\ 8t & 1-4t\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186308675 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "982a88aa-eedd-592c-9315-02cababc05d3" :answer/type {:db/ident :answer.type/math} :answer/value "1+5t" :db/id #edb/ref 17592186306579}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1+5t" :db/id #edb/ref 17592186306579} :answer-field/id #uuid "0b476598-406d-5a73-aecd-f3d0fdb4c49a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307563} {:answer-field/choices [{:answer/id #uuid "f25ce31a-dcd6-531d-b8be-f3355cb63578" :answer/type {:db/ident :answer.type/math} :answer/value "5t" :db/id #edb/ref 17592186307385}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5t" :db/id #edb/ref 17592186307385} :answer-field/id #uuid "215afa42-abd1-5aca-b760-e89ef498a732" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307630}] :question/id #uuid "f4735ae9-8565-5d9f-a6c0-722d2b8017a1" :question/math-academy-id "q-334737" :question/problem "Find ${e}^{At}$ for $A=\\begin{bmatrix}6 & -5 \\\\ 5 & -4\\end{bmatrix}.$ \n\n*Hint: The only eigenvalue of $A$ is $1,$ and it has multiplicity two.*\n\n| ${e}^{At}={e}^{t}\\,\\,$ |  | {{field-1}} | $-5t$ |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-2}} | $1-5t$ |  |  |" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}6 & -5 \\\\ 5 & -4\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}6{\\alpha }_{1}t+{\\alpha }_{0} & -5{\\alpha }_{1}t \\\\ 5{\\alpha }_{1}t & -4{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix}.\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The only eigenvalue of $At$ is \n\n$$\n{\\lambda }_{1}=t\n$$\n\nof multiplicity two. Thus, we have the following:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}r(t) &={e}^{t} \\\\ \\frac{\\text{d}}{\\text{d}\\lambda }r(t) &={e}^{t}\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}t{\\alpha }_{1}+{\\alpha }_{0} &={e}^{t} \\\\ {\\alpha }_{1} &={e}^{t}\\end{aligned}\\right.\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- From the second equation, we get\n\n$$\n{\\alpha }_{1}={e}^{t}.\n$$\n\n- Substituting this into the first one, we get\n\n$$\nt{e}^{t}+{\\alpha }_{0}={e}^{t}\\,⇒\\,{\\alpha }_{0}={e}^{t}(1-t).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}6{\\alpha }_{1}t+{\\alpha }_{0} & =6{e}^{t}t+{e}^{t}(1-t) \\\\  & ={e}^{t}(1+5t) \\\\ 5{\\alpha }_{1}t & =5{e}^{t}t \\\\  & ={e}^{t}(5t)\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{t}\\begin{bmatrix}1+5t & -5t \\\\ 5t & 1-5t\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186370138 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f057e8ea-3098-5fb2-88fe-06006c1f2599" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186370140}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186370140} :answer-field/id #uuid "718319d9-e269-518d-868f-3a8606ef1c84" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186370139} {:answer-field/choices [{:answer/id #uuid "67ab9677-3173-5947-a9ea-c6da46658cb1" :answer/type {:db/ident :answer.type/math} :answer/value "3t" :db/id #edb/ref 17592186370142}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3t" :db/id #edb/ref 17592186370142} :answer-field/id #uuid "23788725-3830-5994-b510-c8a4e159a6a2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186370141}] :question/id #uuid "82844d09-60ab-554e-a1dc-5c9f8fec5040" :question/math-academy-id "q-334731" :question/problem "Find ${e}^{At}$ for $A=\\begin{bmatrix}1 & 3 \\\\ 0 & 1\\end{bmatrix}.$ \n\n*Hint: The only eigenvalue of $A$ is $1,$ and it has multiplicity two.*\n\n| ${e}^{At}={e}^{t}\\,\\,$ |  | $1$ | {{field-1}} |  |\n| --- | --- | --- | --- | --- |\n|  | $0$ | {{field-2}} |  |  |" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}1 & 3 \\\\ 0 & 1\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}{\\alpha }_{1}t+{\\alpha }_{0} & 3{\\alpha }_{1}t \\\\ 0 & {\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix},\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The only eigenvalue of $At$ is \n\n$$\n{\\lambda }_{1}=t\n$$\n\nof multiplicity two. Thus, we have the following:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}r(t) &={e}^{t} \\\\ \\frac{\\text{d}}{\\text{d}\\lambda }r(t) &={e}^{t}\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}t{\\alpha }_{1}+{\\alpha }_{0} &={e}^{t} \\\\ {\\alpha }_{1} &={e}^{t}\\end{aligned}\\right.\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- From the second equation, we get\n\n$$\n{\\alpha }_{1}={e}^{t}.\n$$\n\n- Substituting this into the first one, we get\n\n$$\nt{e}^{t}+{\\alpha }_{0}={e}^{t}\\,⇒\\,{\\alpha }_{0}={e}^{t}(1-t).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}3{\\alpha }_{1}t & =3{e}^{t}t, \\\\ {\\alpha }_{1}t+{\\alpha }_{0} & ={e}^{t}t+{e}^{t}(1-t) \\\\  & ={e}^{t}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{t}\\begin{bmatrix}1 & 3t \\\\ 0 & 1\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186553504 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8abba599-d405-5b28-8292-a43ed4750a5c" :answer/type {:db/ident :answer.type/math} :answer/value "2t" :db/id #edb/ref 17592186553149}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2t" :db/id #edb/ref 17592186553149} :answer-field/id #uuid "03ccd2db-1552-543e-9102-8cfc8d2f158f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186553378} {:answer-field/choices [{:answer/id #uuid "f9e4d7af-e293-52fb-87b2-17e379489288" :answer/type {:db/ident :answer.type/math} :answer/value "-8t" :db/id #edb/ref 17592186553364}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-8t" :db/id #edb/ref 17592186553364} :answer-field/id #uuid "416cdcae-3262-544e-a6bf-81a343fec464" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186553403}] :question/id #uuid "23c462cc-da9f-5356-aacb-68452f1af0c8" :question/math-academy-id "q-334736" :question/problem "Find ${e}^{At}$ for $A=[\\begin{aligned}-6 & 2 \\\\ -8 & 2\\end{aligned}].$ \n\n*Hint: The only eigenvalue of $A$ is $-2,$ and it has multiplicity two.*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">${e}^{At}={e}^{-2t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">$1-4t$</td>\n<td align=\"center\" width=\"80px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\" width=\"30px\">$1+4t$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}[\\begin{aligned}-6 & 2 \\\\ -8 & 2\\end{aligned}]t+{\\alpha }_{0}[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-6{\\alpha }_{1}t+{\\alpha }_{0} & 2{\\alpha }_{1}t \\\\ -8{\\alpha }_{1}t & 2{\\alpha }_{1}t+{\\alpha }_{0}\\end{aligned}].\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The only eigenvalue of $At$ is \n\n$$\n{\\lambda }_{1}=-2t\n$$\n\nof multiplicity two. Thus, we have the following:\n\n$$\n\\begin{aligned}\\{\\begin{aligned}r(-2t)={e}^{-2t} \\\\ \\frac{\\text{d}}{\\text{d}\\lambda }r(-2t)={e}^{-2t}\\end{aligned}\\,⇒\\,\\{\\begin{aligned}(-2t){\\alpha }_{1}+{\\alpha }_{0}={e}^{-2t} \\\\ {\\alpha }_{1}={e}^{-2t}\\end{aligned}\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- From the second equation, we get\n\n$$\n{\\alpha }_{1}={e}^{-2t}.\n$$\n\n- Substituting this into the first one, we get\n\n$$\n-2t{e}^{-2t}+{\\alpha }_{0}={e}^{-2t}\\,⇒\\,{\\alpha }_{0}={e}^{-2t}(1+2t).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}2{\\alpha }_{1}t & =2{e}^{-2t}t \\\\  & ={e}^{-2t}(2t) \\\\ -8{\\alpha }_{1}t & =-8{e}^{-2t}t \\\\  & ={e}^{-2t}(-8t)\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{-2t}[\\begin{aligned}1-4t & 2t \\\\ -8t & 1+4t\\end{aligned}].\n$$"} {:db/id #edb/ref 17592186561040 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "939d48ec-1c25-5c44-bc01-35fa86ce8bd6" :answer/type {:db/ident :answer.type/math} :answer/value "1-4t" :db/id #edb/ref 17592186560667}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1-4t" :db/id #edb/ref 17592186560667} :answer-field/id #uuid "5822d66e-2f18-53dd-b4cd-fb651a40362c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186560899} {:answer-field/choices [{:answer/id #uuid "bf58d67f-30ed-5d74-8536-0d89dad1de9f" :answer/type {:db/ident :answer.type/math} :answer/value "1+4t" :db/id #edb/ref 17592186560743}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1+4t" :db/id #edb/ref 17592186560743} :answer-field/id #uuid "7c222316-6984-59bf-8c22-0c5cad67de0d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186560917}] :question/id #uuid "b34e24d7-8981-5c82-b39b-e245e3ef59b8" :question/math-academy-id "q-334730" :question/problem "Find ${e}^{At}$ for $A=[\\begin{aligned}-2 & 4 \\\\ -4 & 6\\end{aligned}].$ \n\n*Hint: The only eigenvalue of $A$ is $2,$ and it has multiplicity two.*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">${e}^{At}={e}^{2t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">{{field-1}}</td>\n<td align=\"center\" width=\"80px\">$4t$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$-4t$</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}[\\begin{aligned}-2 & 4 \\\\ -4 & 6\\end{aligned}]t+{\\alpha }_{0}[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-2{\\alpha }_{1}t+{\\alpha }_{0} & 4{\\alpha }_{1}t \\\\ -4{\\alpha }_{1}t & 6{\\alpha }_{1}t+{\\alpha }_{0}\\end{aligned}],\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The only eigenvalue of $At$ is \n\n$$\n{\\lambda }_{1}=2t\n$$\n\nof multiplicity two. Thus, we have the following:\n\n$$\n\\begin{aligned}\\{\\begin{aligned}r(2t)={e}^{2t} \\\\ \\frac{\\text{d}}{\\text{d}\\lambda }r(2t)={e}^{2t}\\end{aligned}\\,⇒\\,\\{\\begin{aligned}2t{\\alpha }_{1}+{\\alpha }_{0}={e}^{2t} \\\\ {\\alpha }_{1}={e}^{2t}\\end{aligned}\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- From the second equation, we get\n\n$$\n{\\alpha }_{1}={e}^{2t}.\n$$\n\n- Substituting this into the first one, we get\n\n$$\n2t{e}^{2t}+{\\alpha }_{0}={e}^{2t}\\,⇒\\,{\\alpha }_{0}={e}^{2t}(1-2t).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}-2{\\alpha }_{1}t+{\\alpha }_{0} & =-2{e}^{2t}t+{e}^{2t}(1-2t) \\\\  & ={e}^{2t}(1-4t), \\\\ 6{\\alpha }_{1}t+{\\alpha }_{0} & =6{e}^{2t}t+{e}^{2t}(1-2t) \\\\  & ={e}^{2t}(1+4t)\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{2t}[\\begin{aligned}1-4t & 4t \\\\ -4t & 1+4t\\end{aligned}].\n$$"}] :knowledge-point/title "Finding the Matrix Exponent for a Matrix With Repeated Eigenvalues"} {:db/id #edb/ref 17592186221411 :knowledge-point/canonical-example {:db/id #edb/ref 17592186221194 :question/id #uuid "c0213c76-94e8-5ab3-a260-8a78a205589a" :question/math-academy-id "e-21724" :question/problem "![](images/f9/f97a3d1392b000bb1f02f0f8cd567b72d1a6792e4bc9da41ea24cc4ebbc7208f.png)\nGiven the matrices $A$ and $e^{At}$ above, compute $\\dfrac{\\text{d}}{\\text{d}t} \\big(e^{At}\\big).$" :question/worked-solution "Recall that \n\n$$\n\\dfrac{\\text{d}}{\\text{d}t} \\big(e^{At}\\big) = A \\, e^{At}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}({e}^{At}) & =A\\,{e}^{At} \\\\  & =\\begin{bmatrix}1 & 1 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}{e}^{t} & t{e}^{t} \\\\ 0 & {e}^{t}\\end{bmatrix} \\\\  & =\\begin{bmatrix}{e}^{t} & (t+1){e}^{t} \\\\ 0 & {e}^{t}\\end{bmatrix}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "d4fc3ba4-d488-5156-88dc-837369269cef" :knowledge-point/questions [{:db/id #edb/ref 17592186221995 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f71d01b6-ee5b-5054-8b30-0826abc684a1" :answer/type {:db/ident :answer.type/math} :answer/value "(1+2t)e^{2t}" :db/id #edb/ref 17592186553358}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "(1+2t)e^{2t}" :db/id #edb/ref 17592186553358} :answer-field/id #uuid "9199806a-56d9-516c-b5c9-c3a184f8a0be" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186220637} {:answer-field/choices [{:answer/id #uuid "8adba1a9-ea42-59fb-9093-1e1960d724e0" :answer/type {:db/ident :answer.type/math} :answer/value "2e^{2t}" :db/id #edb/ref 17592186553150}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2e^{2t}" :db/id #edb/ref 17592186553150} :answer-field/id #uuid "bfd89e18-df1a-52e5-b1a9-13b9a350e74e" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186220638} {:answer-field/choices [{:answer/id #uuid "79588b6e-67a9-51cd-86b3-3db3fa8e6c66" :answer/type {:db/ident :answer.type/math} :answer/value "2e^{2t}" :db/id #edb/ref 17592186553116}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2e^{2t}" :db/id #edb/ref 17592186553116} :answer-field/id #uuid "1d46c25a-b0e5-5cb8-b4d9-bcfcbeae85f3" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186220639} {:answer-field/choices [{:answer/id #uuid "d4f1d256-cbeb-55b4-a0df-384c213379d1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186553295}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186553295} :answer-field/id #uuid "5c309815-d4c5-5708-9d45-6e7c0e1436e3" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186220640}] :question/id #uuid "e415201f-e8d7-5cac-99e4-ae2f79b7e01e" :question/math-academy-id "q-333858" :question/problem "$$\nA=[\\begin{aligned}2 & 1 \\\\ 0 & 2\\end{aligned}],\\,{e}^{At}=[\\begin{aligned}{e}^{2t} & t{e}^{2t} \\\\ 0 & {e}^{2t}\\end{aligned}]\n$$\n\nGiven the matrices $A$ and ${e}^{At}$ above, compute $\\frac{\\text{d}}{\\text{d}t}({e}^{At}).$\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\frac{\\text{d}}{\\text{d}t}({e}^{At})=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"40px\">{{field-1}}</td>\n<td align=\"center\" width=\"40px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr></tbody></table>" :question/worked-solution "Recall that \n\n$$\n\\frac{\\text{d}}{\\text{d}t}({e}^{At})=A\\,{e}^{At}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}({e}^{At}) & =A\\,{e}^{At} \\\\  & =[\\begin{aligned}2 & 1 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}{e}^{2t} & t{e}^{2t} \\\\ 0 & {e}^{2t}\\end{aligned}] \\\\  & =[\\begin{aligned}2{e}^{2t} & (2t+1){e}^{2t} \\\\ 0 & 2{e}^{2t}\\end{aligned}].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186222006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c3e688a-d00f-5c7d-bfff-2deb95e138bb" :answer/type {:db/ident :answer.type/math} :answer/value "10\\operatorname{cos}(10t)" :db/id #edb/ref 17592186306038}] :an