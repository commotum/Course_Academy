ces [{:answer/id #uuid "9295980c-7c10-56c7-9256-1029bff3fede" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469644} {:answer/id #uuid "2f281361-566f-564e-90f3-dc8456c7c329" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469645}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469645} :answer-field/id #uuid "24260372-e2e3-556d-a806-f1f44e080cec" :answer-field/key "P" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470434} {:answer-field/choices [{:answer/id #uuid "579254ab-eaa2-510b-8f52-1e585f11c777" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469646} {:answer/id #uuid "15fc8fd0-d708-5fc9-8945-923588741ef7" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469647}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469647} :answer-field/id #uuid "b2923d22-92c3-5826-8e93-69df978fa286" :answer-field/key "Q" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470435} {:answer-field/choices [{:answer/id #uuid "0273c12c-e70d-5a16-93e2-dabca0aa2e62" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469648} {:answer/id #uuid "3790c260-bda0-5fd6-a07c-35ad33e66535" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469649}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469648} :answer-field/id #uuid "b418d0be-8006-5748-bc6f-012ee528be28" :answer-field/key "R" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470436}] :question/id #uuid "1c1ef725-7db0-58fe-a7db-0097c019b6b6" :question/math-academy-id "q-93987" :question/problem "Which of the following matrices are symmetric?\n\n$$\nP=\\begin{bmatrix}1 & 5 \\\\ 5 & -1\\end{bmatrix},\\,Q=\\begin{bmatrix}1 & -2 & 0.5 \\\\ -2 & 0 & 3 \\\\ 0.5 & 3 & -1\\end{bmatrix},\\,R=\\begin{bmatrix}1 & 2 \\\\ -2 & 1\\end{bmatrix}\n$$\n\nSelect all that apply." :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal. \n\nWith that in mind, let's examine each matrix in turn.\n\n- $P$ is a symmetric matrix. Indeed, $P={P}^{T}.$\n\n- $Q$ is a symmetric matrix. Indeed, $Q={Q}^{T}.$\n\n- $R$ is *not* a symmetric matrix. Since ${r}_{12}\\ne {r}_{21},$ we obtain $R\\ne {R}^{T}.$\n\n$$\nR=\\begin{bmatrix}1 & 2 \\\\ -2 & 1\\end{bmatrix}\n$$\n\nTherefore, the correct answer is \"$P$ and $Q$ only.\""} {:db/id #edb/ref 17592186366560 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0860eddb-8872-5a14-90cd-ea80f80450d2" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469656} {:answer/id #uuid "a9503884-f719-56eb-b3d2-1bbf12f445b8" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469657}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469657} :answer-field/id #uuid "2ceb7b39-d9d7-59a0-905c-bc078aea9c08" :answer-field/key "P" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470440} {:answer-field/choices [{:answer/id #uuid "0316227b-bc46-5340-873c-fb4bdb297900" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469658} {:answer/id #uuid "73b30d62-76b6-5783-bbcb-a165c097c0d1" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469659}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469658} :answer-field/id #uuid "e0a912f5-f285-5920-8fe7-d7356920694f" :answer-field/key "Q" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470441} {:answer-field/choices [{:answer/id #uuid "36ff6b0b-7b61-5a1d-b03e-95adb11dc3a4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469660} {:answer/id #uuid "8c62d2d7-9891-554e-bbb7-c20ffae1d6d9" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469661}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469660} :answer-field/id #uuid "ab17f333-c773-595b-b978-1a56da303bcf" :answer-field/key "R" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470442}] :question/id #uuid "a97d726e-d379-5097-84d8-abb6b0a769af" :question/math-academy-id "q-93992" :question/problem "Which of the following matrices are symmetric?\n\n$$\nP=\\begin{bmatrix}-1 & \\frac{1}{2} \\\\ \\frac{1}{2} & 1\\end{bmatrix},\\,Q=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 1 \\\\ 0 & 0 & 1\\end{bmatrix},\\,R=\\begin{bmatrix}1 & 2 & 1 \\\\ -1 & 2 & 3 \\\\ 1 & 3 & 3\\end{bmatrix}\n$$\n\nSelect all that apply." :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal. \n\nWith that in mind, let's examine each matrix in turn.\n\n- $P$ is a symmetric matrix. Indeed, $P={P}^{T}.$\n\n- $Q$ is *not* a symmetric matrix. Since ${q}_{23}\\ne {q}_{32},$ we obtain $Q\\ne {Q}^{T}.$\n\n$$\nQ=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 1 \\\\ 0 & 0 & 1\\end{bmatrix}\n$$\n\n- $R$ is *not* a symmetric matrix. Since ${r}_{12}\\ne {r}_{21},$ we obtain $R\\ne {R}^{T}.$\n\n$$\nR=\\begin{bmatrix}1 & 2 & 1 \\\\ -1 & 2 & 3 \\\\ 1 & 3 & 3\\end{bmatrix}\n$$\n\nTherefore, the correct answer is \"$P$ only.\""} {:db/id #edb/ref 17592186425154 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aa99686-720d-5c83-8792-909de2767703" :answer/type {:db/ident :answer.type/text} :answer/value "None of the matrices are symmetric" :db/id #edb/ref 17592186425148} {:answer/id #uuid "13edd389-e8cd-52c8-8f6e-2c34ed7ad05c" :answer/type {:db/ident :answer.type/text} :answer/value "$P$ and $R$ only" :db/id #edb/ref 17592186425149} {:answer/id #uuid "33ef6a26-6c4e-56d3-8e19-d9dc460624f7" :answer/type {:db/ident :answer.type/text} :answer/value "$Q$ and $R$ only" :db/id #edb/ref 17592186425150} {:answer/id #uuid "655424c1-b811-5aaf-8538-b1da76023605" :answer/type {:db/ident :answer.type/text} :answer/value "$P$ only" :db/id #edb/ref 17592186425151} {:answer/id #uuid "65dc2a15-12f3-5c0d-999e-1bc8c09548b8" :answer/type {:db/ident :answer.type/text} :answer/value "$Q$ only" :db/id #edb/ref 17592186425152}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$Q$ and $R$ only" :db/id #edb/ref 17592186425150} :answer-field/id #uuid "2dcd0455-6677-5df3-b08a-01a2a95723e9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186425153}] :question/id #uuid "ea940e2f-7cf1-5b69-9241-9cde37e5f341" :question/math-academy-id "q-140503" :question/problem "Which of the following matrices are symmetric?\n\n$$\nP=\\begin{bmatrix}3 & 3 \\\\ 0 & 0\\end{bmatrix},\\,Q=\\begin{bmatrix}2 & \\sqrt{2} & -2 \\\\ \\sqrt{2} & -1 & 0 \\\\ -2 & 0 & 3\\end{bmatrix},\\,R=\\begin{bmatrix}0 & -1 \\\\ -1 & 0\\end{bmatrix}\n$$" :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal. \n\nWith that in mind, let's examine each matrix in turn.\n\n- $P$ is *not* a symmetric matrix. Since ${p}_{12}\\ne {p}_{21},$ we obtain $P\\ne {P}^{T}.$\n\n$$\nP=\\begin{bmatrix}3 & 3 \\\\ 0 & 0\\end{bmatrix}\n$$\n\n- $Q$ is a symmetric matrix. Indeed, $Q={Q}^{T}.$\n\n- $R$ is a symmetric matrix. Indeed, $R={R}^{T}.$\n\nTherefore, the correct answer is \"$Q$ and $R$ only.\""} {:db/id #edb/ref 17592186490264 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c461c57-99a8-539a-b47d-fbbf020a7142" :answer/type {:db/ident :answer.type/text} :answer/value "$Q$ only" :db/id #edb/ref 17592186489582} {:answer/id #uuid "774b5e57-0730-5cba-97ab-47239dd7c8ff" :answer/type {:db/ident :answer.type/text} :answer/value "$P$ and $R$ only" :db/id #edb/ref 17592186489790} {:answer/id #uuid "9f141855-904b-5f36-b907-0adae53edccc" :answer/type {:db/ident :answer.type/text} :answer/value "None of the matrices are symmetric" :db/id #edb/ref 17592186489868} {:answer/id #uuid "b860347c-0d9d-588a-96b1-6792b23d38ee" :answer/type {:db/ident :answer.type/text} :answer/value "$P$ and $Q$ only" :db/id #edb/ref 17592186489921} {:answer/id #uuid "f5b378b5-639b-5712-8c19-40d90b345778" :answer/type {:db/ident :answer.type/text} :answer/value "$P$ only" :db/id #edb/ref 17592186490047}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$Q$ only" :db/id #edb/ref 17592186489582} :answer-field/id #uuid "0a31ec00-00a0-53b4-8edd-192981b182da" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490075}] :question/id #uuid "7243696d-a88c-5019-9844-41fc2be79db7" :question/math-academy-id "q-143682" :question/problem "Which of the following matrices are symmetric?\n\n$$\nP=\\begin{bmatrix}3 & \\frac{3}{2} \\\\ \\frac{2}{3} & 2\\end{bmatrix},\\,Q=\\begin{bmatrix}1 & 0 & -1 \\\\ 0 & 1 & -1 \\\\ -1 & -1 & 0\\end{bmatrix},\\,R=\\begin{bmatrix}4 & \\sqrt{2} & \\sqrt{3} \\\\ \\sqrt{3} & 0 & 1 \\\\ \\sqrt{2} & 1 & -1\\end{bmatrix}\n$$" :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal. \n\nWith that in mind, let's examine each matrix in turn.\n\n- $P$ is *not* a symmetric matrix. Since ${p}_{12}\\ne {p}_{21},$ we obtain $P\\ne {P}^{T}.$\n\n$$\nQ=\\begin{bmatrix}3 & \\frac{3}{2} \\\\ \\frac{2}{3} & 2\\end{bmatrix}\n$$\n\n- $Q$ is a symmetric matrix. Indeed, $Q={Q}^{T}.$\n\n- $R$ is *not* a symmetric matrix. Since ${r}_{12}\\ne {r}_{21},$ we obtain $R\\ne {R}^{T}.$\n\n$$\nR=\\begin{bmatrix}4 & \\sqrt{2} & \\sqrt{3} \\\\ \\sqrt{3} & 0 & 1 \\\\ \\sqrt{2} & 1 & -1\\end{bmatrix}\n$$\n\nTherefore, the correct answer is \"$Q$ only.\""} {:db/id #edb/ref 17592186490309 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39a0ec05-964e-5b57-9f36-6db5a9356ec3" :answer/type {:db/ident :answer.type/text} :answer/value "$R$ only" :db/id #edb/ref 17592186489644} {:answer/id #uuid "673540be-83fd-5376-9753-b24c76d14c65" :answer/type {:db/ident :answer.type/text} :answer/value "$P,$ $Q,$ and $R$" :db/id #edb/ref 17592186489759} {:answer/id #uuid "6770c0a5-8a16-5c3d-9ae5-5a9d1ac80546" :answer/type {:db/ident :answer.type/text} :answer/value "$Q$ and $R$ only" :db/id #edb/ref 17592186489760} {:answer/id #uuid "8dc4770d-34e5-5dc6-9c74-249ca7cf0eb6" :answer/type {:db/ident :answer.type/text} :answer/value "$P$ and $R$ only" :db/id #edb/ref 17592186489835} {:answer/id #uuid "d66b82c9-eba0-5b3e-a4b2-e6a29389bdaf" :answer/type {:db/ident :answer.type/text} :answer/value "$P$ and $Q$ only" :db/id #edb/ref 17592186489991}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$P,$ $Q,$ and $R$" :db/id #edb/ref 17592186489759} :answer-field/id #uuid "6bfed8e4-2eb5-53f3-a595-09aab6d29d72" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490135}] :question/id #uuid "d897469f-7656-5297-824e-0adce50d0f86" :question/math-academy-id "q-93990" :question/problem "Which of the following matrices are symmetric?\n\n$$\nP=\\begin{bmatrix}0 & 1 & 2 \\\\ 1 & 3 & 0 \\\\ 2 & 0 & 7\\end{bmatrix},\\,Q=\\begin{bmatrix}-1 & 0 \\\\ 0 & 2\\end{bmatrix},\\,R=\\begin{bmatrix}-2 & -1 & 3 \\\\ -1 & 1 & 0 \\\\ 3 & 0 & -1\\end{bmatrix}\n$$" :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal. \n\nWith that in mind, let's examine each matrix in turn.\n\n- $P$ is a symmetric matrix. Indeed, $P={P}^{T}.$\n\n- $Q$ is a symmetric matrix. Indeed, $Q={Q}^{T}.$\n\n- $R$ is a symmetric matrix. Indeed, $R={R}^{T}.$\n\nTherefore, the correct answer is \"$P,$ $Q,$ and $R.$\""} {:db/id #edb/ref 17592186490315 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "183f703b-ab9e-5113-9a1a-de75fd12da1f" :answer/type {:db/ident :answer.type/text} :answer/value "$P$ and $R$ only" :db/id #edb/ref 17592186489568} {:answer/id #uuid "28596fa1-1975-520d-9ce3-c9a1b5b59843" :answer/type {:db/ident :answer.type/text} :answer/value "$Q$ only" :db/id #edb/ref 17592186489606} {:answer/id #uuid "47dfbbe1-a2fb-5732-a5c5-a6f9537280bb" :answer/type {:db/ident :answer.type/text} :answer/value "$R$ only" :db/id #edb/ref 17592186489680} {:answer/id #uuid "bd0b36ec-7dc3-5014-a653-3ed4fb7e64e3" :answer/type {:db/ident :answer.type/text} :answer/value "$Q$ and $R$ only" :db/id #edb/ref 17592186489928} {:answer/id #uuid "cb2e292a-4001-5d14-8fc0-0a481cb39830" :answer/type {:db/ident :answer.type/text} :answer/value "$P$ only" :db/id #edb/ref 17592186489960}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$R$ only" :db/id #edb/ref 17592186489680} :answer-field/id #uuid "81a5601c-846e-50b6-b119-42985d6b94c3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490149}] :question/id #uuid "e09bb1cf-2314-567d-8f07-99c777c75c71" :question/math-academy-id "q-93986" :question/problem "Which of the following matrices are symmetric?\n\n$$\nP=\\begin{bmatrix}2 & 3 \\\\ 5 & 2\\end{bmatrix},\\,Q=\\begin{bmatrix}1 & -2 \\\\ 2 & 3\\end{bmatrix},\\,R=\\begin{bmatrix}0 & 1 & 5 \\\\ 1 & -1 & \\sqrt{2} \\\\ 5 & \\sqrt{2} & 2\\end{bmatrix}\n$$" :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal. \n\nWith that in mind, let's examine each matrix in turn.\n\n- $P$ is *not* a symmetric matrix. Since ${p}_{12}\\ne {p}_{21},$ we obtain $P\\ne {P}^{T}.$\n\n$$\nP=\\begin{bmatrix}2 & 3 \\\\ 5 & 2\\end{bmatrix}\n$$\n\n- $Q$ is *not* a symmetric matrix. Since ${q}_{12}\\ne {q}_{21},$ we obtain $Q\\ne {Q}^{T}.$\n\n$$\nQ=\\begin{bmatrix}1 & -2 \\\\ 2 & 3\\end{bmatrix}\n$$\n\n- $R$ is a symmetric matrix. Indeed, $R={R}^{T}.$\n\nTherefore, the correct answer is \"$R$ only.\""}] :knowledge-point/title "Identifying Symmetric Matrices"} {:db/id #edb/ref 17592186162024 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161816 :question/id #uuid "b159d52a-a436-5743-9151-2e147364a41d" :question/math-academy-id "e-8478" :question/problem "Which of the following statements are true?\n\nI. If $A$ is *any* $n\\times n$ matrix, then $A+A^T$ is always symmetric.\n\nII. The difference between two $n\\times n$ symmetric matrices is symmetric.\n\nIII. The product of two $n\\times n$ symmetric matrices is symmetric." :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA = A^T\n$$\n\nEquivalently, $a_{ij} = a_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, for any matrix $A,$ we have \n\n$$\n\\begin{aligned}(A+{A}^{T})^{T} & ={A}^{T}+({A}^{T})^{T} \\\\  & ={A}^{T}+A \\\\  & =A+{A}^{T}.\\end{aligned}\n$$\n\n- Statement II is true. Indeed, the sum or difference between two symmetric matrices is symmetric.\n\n- Statement III is false. As a counterexample, consider the symmetric matrices \n![](images/81/812e9888b920e0338fd72116464b8b96c8c272f95f180cd46aa3f1db9afac8d2.svg)\nTheir product is not symmetric:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}1 & 1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ 1 & 1\\end{bmatrix}=\\begin{bmatrix}1 & 2 \\\\ 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and II only.\""} :knowledge-point/id #uuid "bcd0ca26-3f22-533f-9d08-1533eeddbc79" :knowledge-point/questions [{:db/id #edb/ref 17592186162676 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dc0be98-e287-58d8-8b2c-e57d0709ae44" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448822} {:answer/id #uuid "d4948f79-c7c8-5639-819a-cd61729a3714" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448823}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448823} :answer-field/id #uuid "5550f4ed-86c5-5c97-864d-aa737d189eeb" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449451} {:answer-field/choices [{:answer/id #uuid "733dd422-332d-5ac1-bd98-df4c965e888d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448824} {:answer/id #uuid "7af5d31f-43de-53e3-b3f8-80b2d1a9c9f4" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448825}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448825} :answer-field/id #uuid "b59b6c28-d8c2-5120-bb8c-d706a0e786fd" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449452} {:answer-field/choices [{:answer/id #uuid "89550eca-a604-5392-90ab-129c47480727" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448826} {:answer/id #uuid "7ed9e463-582b-5949-bc8c-6e012d4e7b05" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448827}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448826} :answer-field/id #uuid "9a624701-1d1e-5fa7-ad82-6549f6ebba57" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449453}] :question/id #uuid "8be226ee-498f-567c-82d1-206ed205336b" :question/math-academy-id "q-96046" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If $A$ is *any* matrix, then $A{A}^{T}$ is always symmetric.\n- **II.** The sum of two $n\\times n$ symmetric matrices is always symmetric.\n- **III.** The product of two $n\\times n$ symmetric matrices is always symmetric." :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, for any $m\\times n$ matrix $A,$ we have \n\n$$\n\\begin{aligned}(A{A}^{T})^{T} & =({A}^{T})^{T}{A}^{T} \\\\  & =A{A}^{T}.\\end{aligned}\n$$\n\n- Statement II is true. Indeed, for any two symmetric matrices $A$ and $B,$ we have \n\n$$\n\\begin{aligned}(A+B)^{T} & ={A}^{T}+{B}^{T} \\\\  & =A+B.\\end{aligned}\n$$\n\n- Statement III is false. As a counterexample, consider the symmetric matrices \n\n$\\,$ $A=\\begin{bmatrix}1 & 1 \\\\ 1 & 0\\end{bmatrix}\\,$ and $\\,B=\\begin{bmatrix}0 & 1 \\\\ 1 & 1\\end{bmatrix}.$ \n\nHowever, their product is not symmetric:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}1 & 1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ 1 & 1\\end{bmatrix}=\\begin{bmatrix}1 & 2 \\\\ 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186162694 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb469e2b-45b7-5c77-8add-fd24d81f76d6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477503} {:answer/id #uuid "66140b4b-4324-5e27-a1dd-7c616d17027a" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477504}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477503} :answer-field/id #uuid "dbadfff9-d053-5773-a9d3-3a35eae8db62" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477721} {:answer-field/choices [{:answer/id #uuid "eb71d94b-854a-5f6f-ab43-827916efb668" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477505} {:answer/id #uuid "14acc8e7-2f06-5015-818b-6576056fa2f3" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477506}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477506} :answer-field/id #uuid "18c0a27b-9b21-5183-a539-76f7d460db30" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477722} {:answer-field/choices [{:answer/id #uuid "d1040037-a9ef-55ea-854b-01e535caaedd" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477507} {:answer/id #uuid "f7b8f46f-b9ea-5dc8-9bb6-bb0919a4a4d2" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477508}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477508} :answer-field/id #uuid "2734b571-73f6-5d0e-a051-dd621c984e1d" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477723}] :question/id #uuid "2943df26-2edc-5f92-bec7-1493042a2419" :question/math-academy-id "q-96595" :question/problem "Which of the following statements are true?\n- **I.** If $A$ is *any*  $n\\times n$  matrix, then $A-{A}^{T}$ is always symmetric.\n- **II.** The sum of two $n\\times n$ symmetric matrices is always symmetric.\n- **III.** If $A$ is symmetric, then ${A}^{-1}$ is always symmetric (if it exists).\n\nSelect all that apply." :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. As a counterexample, consider the matrix \n\n$\\,$ $A=\\begin{bmatrix}1 & 2 \\\\ 3 & 0\\end{bmatrix}.$\n\nHowever, $A-{A}^{T}$ is not symmetric:\n\n$$\n\\begin{aligned}A-{A}^{T} & =\\begin{bmatrix}1 & 2 \\\\ 3 & 0\\end{bmatrix}-\\begin{bmatrix}1 & 3 \\\\ 2 & 0\\end{bmatrix}=\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n- Statement II is true. Indeed, for any two symmetric matrices $A$ and $B,$ we have \n\n$$\n\\begin{aligned}(A+B)^{T} & ={A}^{T}+{B}^{T} \\\\  & =A+B.\\end{aligned}\n$$\n\n- Statement III is true. Indeed, for any non-singular symmetric matrix $A,$ we have \n\n$$\n\\begin{aligned}({A}^{-1})^{T} & =({A}^{T})^{-1} \\\\  & ={A}^{-1}.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186275135 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77834ff3-1b22-5a38-b89b-f82d5ab71856" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449670} {:answer/id #uuid "9b29bb6e-dcf9-528a-a29e-2d6d71349d86" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449671}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449671} :answer-field/id #uuid "a9da5bec-12d7-5de8-b874-3910e58e4788" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450789} {:answer-field/choices [{:answer/id #uuid "7e310a01-b5b6-5b95-8ec3-f1d8a5a533b3" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449672} {:answer/id #uuid "fa0b9210-7a27-56eb-aa08-e1bd408b372d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449673}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449673} :answer-field/id #uuid "56acf37f-34e4-5d10-a6c2-3e5a5d140e65" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450790} {:answer-field/choices [{:answer/id #uuid "0c5b9fcc-8b52-530c-9210-d313e83c7a0e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449674} {:answer/id #uuid "df70da07-5141-53a7-a1ee-97990272f70b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449675}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449674} :answer-field/id #uuid "5b6dbf8d-010e-5415-bfc1-dbb221779069" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450791}] :question/id #uuid "df88ef9d-a81d-55a1-b088-252f805046b3" :question/math-academy-id "q-143685" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If $A$ is a square matrix, then $A+{A}^{T}$ is always symmetric.\n- **II.** If $A$ is a symmetric matrix, then ${A}^{-1}$ is always symmetric (if it exists).\n- **III.** The sum of two $n\\times n$ matrices is always symmetric." :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, for any square matrix $A,$ we have \n\n$$\n\\begin{aligned}(A+{A}^{T})^{T} & ={A}^{T}+({A}^{T})^{T} \\\\  & ={A}^{T}+A \\\\  & =A+{A}^{T}.\\end{aligned}\n$$\n\n- Statement II is true. Indeed, for any non-singular symmetric matrix $A,$ we have \n\n$$\n\\begin{aligned}({A}^{-1})^{T} & =({A}^{T})^{-1} \\\\  & ={A}^{-1}.\\end{aligned}\n$$\n\n- Statement III is false. As a counterexample, consider the matrices \n\n$\\,$ $A=\\begin{bmatrix}1 & -1 \\\\ 1 & 0\\end{bmatrix}\\,$ and $\\,B=\\begin{bmatrix}0 & 1 \\\\ 1 & 1\\end{bmatrix}.$ \n\nHowever, their sum is not symmetric:\n\n$$\n\\begin{aligned}A+B & =\\begin{bmatrix}1 & -1 \\\\ 1 & 0\\end{bmatrix}+\\begin{bmatrix}0 & 1 \\\\ 1 & 1\\end{bmatrix}=\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186275136 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d290cf67-6df4-50a4-a125-89a4d83e9229" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449676} {:answer/id #uuid "7a88fac1-3096-5661-afa0-47f72ffc8f65" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449677}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449677} :answer-field/id #uuid "3d1092b5-ba66-50b4-8bee-d42517f8ecdf" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450792} {:answer-field/choices [{:answer/id #uuid "01dc726f-0a06-5fe8-a402-62bb327452b3" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449678} {:answer/id #uuid "9b7f8d67-7b14-52c5-b5e2-ee93081a984b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449679}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449678} :answer-field/id #uuid "3b21dbc2-c542-5c91-8cc5-fb3798ea6bc5" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450793} {:answer-field/choices [{:answer/id #uuid "7b0c6601-486b-5c49-ae54-f084a8b9d18c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449680} {:answer/id #uuid "491b7869-9458-5892-a187-1e25f2d50b5d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449681}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449681} :answer-field/id #uuid "3f0701ff-8dbe-5272-b976-e1595f15b3ee" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450794}] :question/id #uuid "416a1d82-1004-5007-b882-19d5aaa3af4e" :question/math-academy-id "q-143686" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The product of two $n\\times n$ diagonal matrices is always symmetric.\n- **II.** If $A$ is *any* $n\\times n$ matrix, then $A+{A}^{2}$ is always symmetric.\n- **III.** If $A$ is *any*  $n\\times n$ matrix, then $A{A}^{T}-{A}^{T}A$ is always symmetric." :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, for any diagonal matrices $A$ and $B,$ their product $AB$ is also diagonal, and any diagonal matrix is symmetric.\n\n- Statement II is false. As a counterexample, consider the matrix \n\n$\\,$ $A=\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}.$\n\nHowever, $A+{A}^{2}$ is not symmetric:\n\n$$\n\\begin{aligned}A+{A}^{2} & =\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}+\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}+\\begin{bmatrix}-1 & 0 \\\\ 0 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & -1 \\\\ 1 & -1\\end{bmatrix}\\end{aligned}\n$$\n\n- Statement III is true. Indeed, for any square matrix $A,$ we have \n\n$$\n\\begin{aligned}(A{A}^{T}-{A}^{T}A)^{T} & =(A{A}^{T})^{T}-({A}^{T}A)^{T} \\\\  & =({A}^{T})^{T}{A}^{T}-{A}^{T}({A}^{T})^{T} \\\\  & =A{A}^{T}-{A}^{T}A.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186275137 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb77d39b-75ff-5747-b99c-9cd47f41c51c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449682} {:answer/id #uuid "94345635-817a-5aa4-a7a2-498d963121ef" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449683}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449683} :answer-field/id #uuid "eaedc8bd-f59e-5871-bfc5-e7553143409e" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450795} {:answer-field/choices [{:answer/id #uuid "f0f84e81-499d-55d4-ac5e-99eb38720728" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449684} {:answer/id #uuid "79aeba54-2cd8-5240-8cb3-d19dcfbe4680" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449685}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449684} :answer-field/id #uuid "a09ef516-6c8d-5da1-b76b-438fb19a83e7" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450796} {:answer-field/choices [{:answer/id #uuid "1bcbb1cb-2004-5967-bedb-dae9a7275c83" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449686} {:answer/id #uuid "2bda30dd-367b-5982-ba71-617e5ac2752d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449687}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449686} :answer-field/id #uuid "06250cb3-b876-5df2-a845-d13c4b38939b" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450797}] :question/id #uuid "62cdcd34-c338-59e0-b65d-2d882ff231e6" :question/math-academy-id "q-143687" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The sum of two $n\\times n$ diagonal matrices is always symmetric.\n- **II.** If $A$ is *any*  $n\\times n$  matrix, then $A-{A}^{T}$ is always symmetric.\n- **III.** The product of two $n\\times n$ symmetric matrices is always symmetric." :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, for any diagonal matrices $A$ and $B,$ we have\n\n$$\n\\begin{aligned}(A+B)^{T} & ={A}^{T}+{B}^{T} \\\\  & =A+B.\\end{aligned}\n$$\n\n- Statement II is false. As a counterexample, consider the matrix \n\n$\\,$ $A=\\begin{bmatrix}1 & 2 \\\\ 3 & 0\\end{bmatrix}.$\n\nHowever, $A-{A}^{T}$ is not symmetric:\n\n$$\n\\begin{aligned}A-{A}^{T} & =\\begin{bmatrix}1 & 2 \\\\ 3 & 0\\end{bmatrix}-\\begin{bmatrix}1 & 3 \\\\ 2 & 0\\end{bmatrix}=\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n- Statement III is false. As a counterexample, consider the symmetric matrices \n\n$\\,$ $A=\\begin{bmatrix}1 & 1 \\\\ 1 & -1\\end{bmatrix}\\,$ and $\\,B=\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}.$ \n\nHowever, their product is not symmetric:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}1 & 1 \\\\ 1 & -1\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}=\\begin{bmatrix}1 & 1 \\\\ -1 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186275138 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c7b2a77-1693-52b5-938e-64e6e1f2ceab" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449688} {:answer/id #uuid "d01fdf31-92a5-57b3-8671-eed1b16afb81" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449689}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449689} :answer-field/id #uuid "e94131fa-ce78-5678-be60-13aa8ed6ef76" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450798} {:answer-field/choices [{:answer/id #uuid "f8381806-836c-50a9-93cd-2a9d74f5530d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449690} {:answer/id #uuid "0d643587-3414-5f09-b4a1-16711a9473e7" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449691}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449691} :answer-field/id #uuid "3e188018-640d-552b-b4ec-5b8295f202cc" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450799} {:answer-field/choices [{:answer/id #uuid "07f537b5-ef33-531d-bfd8-f1876dac11f0" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449692} {:answer/id #uuid "8087e2ff-5cd7-5646-a803-00c97f657498" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449693}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449693} :answer-field/id #uuid "a0930087-8fb8-5b80-8794-d9766c9702be" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450800}] :question/id #uuid "812925c4-9b82-5457-b638-58a29d609de3" :question/math-academy-id "q-143688" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If $A$ is symmetric, then ${A}^{-1}$ is always symmetric (if it exists).\n- **II.** The sum of *any* two $n\\times n$ symmetric matrices is always symmetric.\n- **III.** If $A$ is *any*  $n\\times n$ matrix, then ${A}^{T}A$ is always symmetric." :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, for any non-singular symmetric matrix $A,$ we have \n\n$$\n\\begin{aligned}({A}^{-1})^{T} & =({A}^{T})^{-1} \\\\  & ={A}^{-1}.\\end{aligned}\n$$\n\n- Statement II is true. Indeed, for any two symmetric matrices $A$ and $B,$ we have \n\n$$\n\\begin{aligned}(A+B)^{T} & ={A}^{T}+{B}^{T} \\\\  & =A+B.\\end{aligned}\n$$\n\n- Statement III is true. Indeed, for any $m\\times n$ matrix $A,$ we have \n\n$$\n\\begin{aligned}({A}^{T}A)^{T} & ={A}^{T}({A}^{T})^{T} \\\\  & ={A}^{T}A.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186360684 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61f9b779-a82b-5fca-ac7c-8326f052042f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452263} {:answer/id #uuid "e7a19fce-bfec-59e9-b174-01dd728ea53b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452264}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452263} :answer-field/id #uuid "027ffc36-9391-569a-9d2f-da2a80b366dc" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452979} {:answer-field/choices [{:answer/id #uuid "c0b1bee2-eead-5899-9436-3a5e41c5d534" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452265} {:answer/id #uuid "5c95db47-f37c-5361-aca9-caa8ca8ccc7f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452266}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452265} :answer-field/id #uuid "3698aa5e-23d2-5ab3-84e9-157fdeec0f61" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452980} {:answer-field/choices [{:answer/id #uuid "b91e26b4-0173-5667-9919-d76bd3bc5172" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452267} {:answer/id #uuid "9d9e1009-c7de-59b4-8f5d-83345258f1a6" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452268}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452268} :answer-field/id #uuid "6cfe9278-620c-5f30-9b43-3e38a539af4d" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452981}] :question/id #uuid "a6c182c5-819c-5206-a031-9309a3557f8d" :question/math-academy-id "q-96589" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If $A$ is *any*  $n\\times n$ matrix, then ${A}^{2}$ is always symmetric.\n\n- **II.** The product of two $n\\times n$ symmetric matrices is always symmetric.\n\n- **III.** If $A$ is a symmetric matrix, then ${A}^{-1}$ is always symmetric (if it exists)." :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. As a counterexample, consider the matrix \n\n$\\,$ $A=\\begin{bmatrix}1 & -1 \\\\ 1 & 0\\end{bmatrix}.$\n\nHowever, ${A}^{2}$ is not symmetric:\n\n$$\n\\begin{aligned}{A}^{2} & =\\begin{bmatrix}1 & -1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}1 & -1 \\\\ 1 & 0\\end{bmatrix}=\\begin{bmatrix}0 & -1 \\\\ 1 & -1\\end{bmatrix}\\end{aligned}\n$$\n\n- Statement II is false. As a counterexample, consider the symmetric matrices \n\n$\\,$ $A=\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\,$ and $\\,B=\\begin{bmatrix}0 & 1 \\\\ 1 & 1\\end{bmatrix}.$ \n\nHowever, their product is not symmetric:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ 1 & 1\\end{bmatrix}=\\begin{bmatrix}1 & 1 \\\\ 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\n- Statement III is true. Indeed, for any non-singular symmetric matrix $A,$ we have \n\n$$\n\\begin{aligned}({A}^{-1})^{T} & =({A}^{T})^{-1} \\\\  & ={A}^{-1}.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"III only.\""} {:db/id #edb/ref 17592186360685 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f12fac1-b0d6-532b-be36-7ca114813335" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452269} {:answer/id #uuid "6b9df603-5cc7-56a3-8458-480fec1933de" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452270}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452270} :answer-field/id #uuid "cf8b0515-2015-50da-af0f-2f20ef8ea319" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452982} 