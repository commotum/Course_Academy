bmatrix}1 \\\\ 2 \\\\ 3 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186248881} {:answer/id #uuid "b05c6984-23ce-5ac2-a4c6-bb3985a5c24b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 3 \\\\ 2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186249009} {:answer/id #uuid "d9bf1a5a-9053-5bf4-aba8-5103b2f37298" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 & 3 & 3\\end{bmatrix}" :db/id #edb/ref 17592186249347}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 3 & 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186247424} :answer-field/id #uuid "61ddb562-c520-5835-a835-167d8fe62f58" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249844}] :question/id #uuid "ba9cac91-a5f4-5f2e-ae2a-31b596a9dde6" :question/math-academy-id "q-11468" :question/problem "Find ${F}^{T}$ given that \n    \n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$F=\\begin{bmatrix}3 \\\\ 3 \\\\ 2 \\\\ 1\\end{bmatrix}$</div>\n</div>" :question/worked-solution "To find the transpose, we interchange the rows and columns. \n\nHere, there is just a single column, so it becomes a single row:\n\n$$\n{F}^{T}=\\begin{bmatrix}3 & 3 & 2 & 1\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186250392 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01083aba-7159-5668-975e-80fd900b5e13" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & 9 \\\\ -4 & 9\\end{bmatrix}" :db/id #edb/ref 17592186247420} {:answer/id #uuid "25a32a75-2be4-5aa0-b7ac-0758260d6b2d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & -9 \\\\ -4 & 9\\end{bmatrix}" :db/id #edb/ref 17592186247757} {:answer/id #uuid "67ac8976-5d43-5318-81df-5210173a511d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 9 \\\\ 9 & -4\\end{bmatrix}" :db/id #edb/ref 17592186248354} {:answer/id #uuid "d50f4c89-9a1c-5ecd-b1ad-84d3afaca026" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 9 \\\\ -4 & -9\\end{bmatrix}" :db/id #edb/ref 17592186249310} {:answer/id #uuid "f3fb4e17-2411-5b2c-9459-b5e5cb8fcd2e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 9 \\\\ -4 & 9\\end{bmatrix}" :db/id #edb/ref 17592186249560}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 9 \\\\ -4 & 9\\end{bmatrix}" :db/id #edb/ref 17592186249560} :answer-field/id #uuid "23d63a3b-d0b6-52cd-ba9b-48dd82439260" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249732}] :question/id #uuid "e51b6e2d-bb1c-588d-8de2-5ed3d6ef6bca" :question/math-academy-id "q-11531" :question/problem "Calculate $3F+\\frac{1}{2}G$, where\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$F=\\begin{bmatrix}1 & 3 \\\\ -2 & 2\\end{bmatrix}$</div>\n</div>\n\nand\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$G=\\begin{bmatrix}2 & 0 \\\\ 4 & 6\\end{bmatrix}$</div>\n</div>" :question/worked-solution "We multiply each entry of $F$ by $3$ and each entry of $G$ by $\\frac{1}{2},$ and then add the resulting matrices, as follows:\n\n$$\n\\begin{aligned}3F+\\frac{1}{2}G & =3\\begin{bmatrix}1 & 3 \\\\ -2 & 2\\end{bmatrix}+\\frac{1}{2}\\begin{bmatrix}2 & 0 \\\\ 4 & 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}3\\cdot 1 & 3\\cdot 3 \\\\ 3\\cdot (-2) & 3\\cdot 2\\end{bmatrix}+\\begin{bmatrix}\\frac{1}{2}\\cdot 2 & \\frac{1}{2}\\cdot 0 \\\\ \\frac{1}{2}\\cdot 4 & \\frac{1}{2}\\cdot 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & 9 \\\\ -6 & 6\\end{bmatrix}+\\begin{bmatrix}1 & 0 \\\\ 2 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}3+1 & 9+0 \\\\ -6+2 & 6+3\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 9 \\\\ -4 & 9\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250432 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66d0ae76-bc3f-5fc2-ab45-3c327cc7dc45" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461737} {:answer/id #uuid "cf878234-afe8-5395-85e8-d9b0f6944666" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461738}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461737} :answer-field/id #uuid "5db57aa6-14c2-54c7-b692-04ab1d30d57d" :answer-field/key "P" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462622} {:answer-field/choices [{:answer/id #uuid "f5768034-5162-5525-968a-d216e70073e7" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461739} {:answer/id #uuid "d62d551d-96da-517f-8340-2d16b1ab916d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461740}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461740} :answer-field/id #uuid "15477831-2eef-57fc-a8a7-8d7564cd6fcf" :answer-field/key "S" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462623} {:answer-field/choices [{:answer/id #uuid "7a0b5c9f-f227-5d04-9202-326caee8424f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461741} {:answer/id #uuid "a3404bbe-548f-5c40-9fdc-310af0e7676b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461742}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461742} :answer-field/id #uuid "4fc2c1ee-5fd8-59cf-97ff-a46de525b2f3" :answer-field/key "T" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462624}] :question/id #uuid "b4dac05e-84dd-5a26-905f-fb4d126dc4c6" :question/math-academy-id "q-11556" :question/problem "Which of the following are square matrices?\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$P=\\begin{bmatrix}0 & 0 \\\\ -10 & 0.5 \\\\ -2 & 0\\end{bmatrix}$</div>\n<div>$S=\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}$</div>\n<div>$T=\\begin{bmatrix}1.5 & -3 & 0 & 1 & 9 \\\\ 0 & 0.2 & 1 & 0 & 0 \\\\ 0 & \\sqrt{3} & 0 & 0 & 1 \\\\ -2 & 0 & 0 & 6 & 0 \\\\ 2 & 1 & 0 & 5 & 8\\end{bmatrix}$</div>\n</div>\n\nSelect all that apply." :question/worked-solution "- $P$ is *not* a square matrix since the numbers of rows and columns are not the same. It has $3$ rows and $2$ columns, so it's a $3\\times 2$ matrix.\n\n- $S$ is a square matrix since it has the same number of rows and columns. It has $2$ rows and $2$ columns, so it is a $2\\times 2$ matrix.\n\n- $T$ is a square matrix since it has the same number of rows and columns. It has $5$ rows and $5$ columns, so it is a $5\\times 5$ matrix.\n\nTherefore, only $S$ and $T$ are square matrices."}] [{:db/id #edb/ref 17592186250441 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "237b1d59-dbe4-56ef-8b5b-435a691b2a3e" :answer/type {:db/ident :answer.type/text} :answer/value "A row vector" :db/id #edb/ref 17592186247735} {:answer/id #uuid "449b6d1e-0529-5949-8e25-22dc1f82beb7" :answer/type {:db/ident :answer.type/text} :answer/value "A zero matrix" :db/id #edb/ref 17592186248037} {:answer/id #uuid "561bb150-e452-5f0a-a04f-d528c8081a33" :answer/type {:db/ident :answer.type/text} :answer/value "An identity matrix" :db/id #edb/ref 17592186248205} {:answer/id #uuid "77e9a861-4b6e-53e3-8fa9-1c7218f4b6f5" :answer/type {:db/ident :answer.type/text} :answer/value "A square matrix" :db/id #edb/ref 17592186248478} {:answer/id #uuid "eadb5f23-05c2-56ab-8593-63450490b5cd" :answer/type {:db/ident :answer.type/text} :answer/value "A column vector" :db/id #edb/ref 17592186249492}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "A row vector" :db/id #edb/ref 17592186247735} :answer-field/id #uuid "9bcdd4fa-74ae-50b7-93b8-dd764a756443" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249944}] :question/id #uuid "e9b78ccd-daa3-54ce-bf4c-d8fd41b5fce0" :question/math-academy-id "q-11563" :question/problem "Which of the following best describes the following matrix $A?$\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}1 & 2 & 3\\end{bmatrix}$</div>\n</div>" :question/worked-solution "The matrix has only one row. Hence, it is a row vector."}] [{:db/id #edb/ref 17592186259867 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "304d0dad-cee4-5592-a545-af1e7d7bef3b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -1 & -3 \\\\ 0 & 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186257209} {:answer/id #uuid "53e4e5d7-dcfe-576c-ba10-e578dc3c989a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186257499} {:answer/id #uuid "d074eca6-9fff-5742-a5c5-8037fbf27a34" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -1 & -3 \\\\ -5 & 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186258593} {:answer/id #uuid "d0b2cb75-5591-54c5-8fd7-7f3af3ed92d2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & 0 \\\\ -5 & 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186258598} {:answer/id #uuid "fe0049e8-0eb4-56b2-b2a5-049e647a1c6a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -1 & -3 \\\\ -5 & 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186259006}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186257499} :answer-field/id #uuid "dca795c0-9f7b-5ef5-be5f-c92079283866" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259421}] :question/id #uuid "da83cda3-2b15-5f3e-83e7-fb7c87dafa93" :question/math-academy-id "q-125885" :question/problem "Calculate $0W$, if \n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$W=\\begin{bmatrix}1 & -1 & -3 \\\\ -5 & 0 & 2\\end{bmatrix}$</div>\n</div>" :question/worked-solution "We multiply each entry of $W$ by $0,$ as follows:\n\n$$\n\\begin{aligned}0W & =0\\begin{bmatrix}1 & -1 & -3 \\\\ -5 & 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0\\cdot 1 & 0\\cdot (-1) & 0\\cdot (-3) \\\\ 0\\cdot (-5) & 0\\cdot 0 & 0\\cdot 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262575 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16d01278-cb84-5f5d-a32b-b98ca83a321c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & -1 \\\\ -5 & 2\\end{bmatrix}" :db/id #edb/ref 17592186260074} {:answer/id #uuid "a75df9e5-ef98-5f15-a399-833d4c5f611f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 3 \\\\ 3 & -4\\end{bmatrix}" :db/id #edb/ref 17592186261335} {:answer/id #uuid "b146748e-e256-5c6d-9fa5-662f3fd71470" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & -5 \\\\ -4 & 4\\end{bmatrix}" :db/id #edb/ref 17592186261440} {:answer/id #uuid "b80aadfb-906c-533d-99bd-4de8a4b77396" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & -5 \\\\ -5 & 4\\end{bmatrix}" :db/id #edb/ref 17592186261489} {:answer/id #uuid "ee25100e-908f-5ac7-adb9-fa6c14c5c100" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 3 \\\\ 3 & -4\\end{bmatrix}" :db/id #edb/ref 17592186261971}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & -5 \\\\ -5 & 4\\end{bmatrix}" :db/id #edb/ref 17592186261489} :answer-field/id #uuid "31cbb2e5-a601-51eb-b475-516bf69291e4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262215}] :question/id #uuid "1a15a17b-1180-5608-8f0b-187c74fe5518" :question/math-academy-id "q-126009" :question/problem "Calculate $-A+2B$, where\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}3 & 1 \\\\ 1 & 0\\end{bmatrix}$</div>\n</div>\n\nand\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$B=\\begin{bmatrix}0 & -2 \\\\ -2 & 2\\end{bmatrix}$</div>\n</div>" :question/worked-solution "We multiply each entry of $A$ by $-1$ and each entry of $B$ by $2,$ and then add the resulting matrices, as follows:\n\n$$\n\\begin{aligned}-A+2B & =(-1)\\begin{bmatrix}3 & 1 \\\\ 1 & 0\\end{bmatrix}+2\\begin{bmatrix}0 & -2 \\\\ -2 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}(-1)\\cdot 3 & (-1)\\cdot 1 \\\\ (-1)\\cdot 1 & (-1)\\cdot 0\\end{bmatrix}+\\begin{bmatrix}2\\cdot 0 & 2\\cdot (-2) \\\\ 2\\cdot (-2) & 2\\cdot 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & -1 \\\\ -1 & 0\\end{bmatrix}+\\begin{bmatrix}0 & -4 \\\\ -4 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3+0 & -1+(-4) \\\\ -1+(-4) & 0+4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & -5 \\\\ -5 & 4\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262587 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a84bd7b-b342-545e-840e-5ba356e9bf8b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 1 & 2 \\\\ -2 & 3 & 0\\end{bmatrix}" :db/id #edb/ref 17592186259967} {:answer/id #uuid "214f9895-1ee0-5785-8016-4b98066e54cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & -2 \\\\ 1 & 3 \\\\ 2 & 0\\end{bmatrix}" :db/id #edb/ref 17592186260160} {:answer/id #uuid "29ff0110-afb8-5528-970a-7b7829a506f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & -1 \\\\ 3 & 1 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186260243} {:answer/id #uuid "52a63d37-0792-5c79-9b9b-61b14ce1fc52" :answer/type {:db/ident :answer.type/math} :answer/value "\\begi