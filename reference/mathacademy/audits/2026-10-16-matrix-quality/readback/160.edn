{u}_{2} & {u}_{3}\\end{aligned}]}^{T}\\cdot {X}_{\\text{std}}" :db/id #edb/ref 17592186528709} {:answer/id #uuid "a87fef72-5fcd-5390-8b58-6bde4d2f79ec" :answer/type {:db/ident :answer.type/math} :answer/value "{[\\begin{aligned}{u}_{1} & {u}_{2}\\end{aligned}]}^{T}\\cdot {X}_{\\text{std}}" :db/id #edb/ref 17592186528710}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{X}_{\\text{std}}\\cdot [\\begin{aligned}{v}_{1} & {v}_{2}\\end{aligned}]" :db/id #edb/ref 17592186528611} :answer-field/id #uuid "b50874a2-e3a7-5329-bf0c-106fdd139ec0" :answer-field/key "field-9" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186529035} {:answer-field/choices [{:answer/id #uuid "0102d8e7-433f-5351-b489-2fead45bed7a" :answer/type {:db/ident :answer.type/text} :answer/value "parallel" :db/id #edb/ref 17592186528300} {:answer/id #uuid "3f56b3d9-6ad5-536b-8240-59c144472859" :answer/type {:db/ident :answer.type/text} :answer/value "orthogonal" :db/id #edb/ref 17592186528463}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "orthogonal" :db/id #edb/ref 17592186528463} :answer-field/id #uuid "c23ad7bc-38a5-5932-a9d8-1009a5f433b3" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186529045} {:answer-field/choices [{:answer/id #uuid "13f2168f-2ad5-5e25-a965-6a3863512cac" :answer/type {:db/ident :answer.type/text} :answer/value "principal component" :db/id #edb/ref 17592186528349} {:answer/id #uuid "1759994a-0b1e-53ed-98a1-8e083022b61b" :answer/type {:db/ident :answer.type/text} :answer/value "datapoint" :db/id #edb/ref 17592186528359}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "principal component" :db/id #edb/ref 17592186528349} :answer-field/id #uuid "defd6918-4c92-5ef4-b938-cc21b112d088" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186529065} {:answer-field/choices [{:answer/id #uuid "0525da39-150e-5118-9e21-b2ea99940dd4" :answer/type {:db/ident :answer.type/text} :answer/value "standardize the data" :db/id #edb/ref 17592186528314} {:answer/id #uuid "1a7924a0-dcd4-544b-9d73-493bc5af3b5c" :answer/type {:db/ident :answer.type/text} :answer/value "center the data" :db/id #edb/ref 17592186528371} {:answer/id #uuid "4b50408f-37b1-5abe-80f2-c1c3fc72602a" :answer/type {:db/ident :answer.type/text} :answer/value "find the SVD of the data matrix" :db/id #edb/ref 17592186528487}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "standardize the data" :db/id #edb/ref 17592186528314} :answer-field/id #uuid "e3127644-8b0b-57d9-bdea-6ebb18e85e3a" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186529070}] :question/id #uuid "d455f69c-b6d0-5a22-baea-4655fa27f3c7" :question/math-academy-id "q-355960" :question/problem "Suppose we have a dataset consisting of $5$ datapoints with $3$ features in the form of the $5\\times 3$ matrix\n\n$$\nX=[\\begin{aligned}-2.506 & 4.309 & 6.738 \\\\ 0.552 & 4.174 & 1.558 \\\\ 0.175 & 3.635 & 2.487 \\\\ 1.127 & 4.541 & 5.878 \\\\ 4.088 & 4.508 & 5.688\\end{aligned}]\n$$\n\nWe wish to reduce the dimensionality of the dataset while still preserving as much variance as possible.\n\nSelect the correct options in the following reasoning that walks through the process of reducing the dimensionality of the dataset.\n\nWe will use principal component analysis to reduce the dimensionality of the dataset. The first principal component is \n{{field-1}} \nwith the \n{{field-2}} \nvariance.\n\nThe second principal component is the direction in feature space \n{{field-3}} \nto the first\n{{field-4}}. \n\nIn order to reduce the dimensionality of the dataset, we will project the data onto the first few principal components, picking the number of components based on the amount of cumulative variance preserved.\n\nThe first step is to {{field-5}}.\n\nThe standardized data matrix is\n\n$$\n{X}_{\\text{std}}=[\\begin{aligned}-1.35 & 0.21 & 0.99 \\\\ -0.06 & -0.16 & -1.27 \\\\ -0.22 & -1.63 & -0.86 \\\\ 0.19 & 0.84 & 0.61 \\\\ 1.44 & 0.75 & 0.53\\end{aligned}].\n$$\n\nThe SVD of the standardized data matrix is\n\n$$\n\\begin{aligned}{X}_{\\text{std}} & =UΣ{V}^{T},\\,\\text{where} \\\\ U & =[\\begin{aligned}0.155 & -0.805 & -0.027 & 0.027 & 0.572 \\\\ -0.358 & 0.242 & 0.758 & 0.142 & 0.467 \\\\ -0.675 & 0.055 & -0.551 & 0.438 & 0.214 \\\\ 0.396 & -0.030 & 0.144 & 0.887 & -0.184 \\\\ 0.485 & 0.538 & -0.317 & -0.019 & 0.612\\end{aligned}], \\\\ Σ & =[\\begin{aligned}2.635 & 0 & 0 \\\\ 0 & 2.034 & 0 \\\\ 0 & 0 & 0.940 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}], \\\\ V & =[\\begin{aligned}0.279 & 0.899 & -0.337 \\\\ 0.716 & 0.039 & 0.697 \\\\ 0.640 & -0.435 & -0.633\\end{aligned}].\\end{aligned}\n$$\n\nWe compute the cumulative variance preserved for different numbers of components.\n\nThe fraction of variance preserved by projecting the data onto the first principal component is \n{{field-6}}.\n\nThe fraction of variance preserved by projecting the data onto the first two principal components is \n{{field-7}}.\n\nIf we wish to preserve $90\\%$ of the variance, we should reduce the dataset to \n{{field-8}}.\n\nWriting ${v}_{1},{v}_{2},{v}_{3}$ for the columns of $V$ and ${u}_{1},{u}_{2},{u}_{3},{u}_{4},{u}_{5}$ for the columns of $U$, the reduced dataset is\n\n$$\n{X}_{\\text{red}}={{field-9}}.\n$$" :question/worked-solution "We will use principal component analysis to reduce the dimensionality of the dataset. The first principal component is $\\text{the direction in feature space}$ with the $\\text{most}$ variance.\n\nThe second principal component is the direction $\\text{orthogonal}$ to the first $\\text{principal component}.$\n\nIn order to reduce the dimensionality of the dataset, we will project the data onto the first few principal components, picking the number of components based on the amount of cumulative variance preserved.\n\nThe first step is to $\\text{standardize the data}.$\n\nThe standardized data matrix is\n\n$$\n{X}_{\\text{std}}=[\\begin{aligned}-1.35 & 0.21 & 0.99 \\\\ -0.06 & -0.16 & -1.27 \\\\ -0.22 & -1.63 & -0.86 \\\\ 0.19 & 0.84 & 0.61 \\\\ 1.44 & 0.75 & 0.53\\end{aligned}].\n$$\n\nThe SVD of the standardized data matrix is\n\n$$\n\\begin{aligned}{X}_{\\text{std}} & =UΣ{V}^{T},\\,\\text{where} \\\\ U & =[\\begin{aligned}0.155 & -0.805 & -0.027 & 0.027 & 0.572 \\\\ -0.358 & 0.242 & 0.758 & 0.142 & 0.467 \\\\ -0.675 & 0.055 & -0.551 & 0.438 & 0.214 \\\\ 0.396 & -0.030 & 0.144 & 0.887 & -0.184 \\\\ 0.485 & 0.538 & -0.317 & -0.019 & 0.612\\end{aligned}], \\\\ Σ & =[\\begin{aligned}2.635 & 0 & 0 \\\\ 0 & 2.034 & 0 \\\\ 0 & 0 & 0.940 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}], \\\\ V & =[\\begin{aligned}0.279 & 0.899 & -0.337 \\\\ 0.716 & 0.039 & 0.697 \\\\ 0.640 & -0.435 & -0.633\\end{aligned}].\\end{aligned}\n$$\n\nWe compute the cumulative variance preserved for different numbers of components.\n\nThe variance along a principal component is equal to the corresponding eigenvalue of the covariance matrix, which is proportional to the square of the corresponding singular value of the data matrix.\n\n- The fraction of variance preserved by projecting the data onto the first principal component is \n\n$$\n\\frac{{2.635}^{2}}{{2.635}^{2}+{2.034}^{2}+{0.940}^{2}}≈58.0\\%.\n$$\n\n- The fraction of variance preserved by projecting the data onto the first two principal components is \n\n$$\n\\frac{{2.635}^{2}+{2.034}^{2}}{{2.635}^{2}+{2.034}^{2}+{0.940}^{2}}≈92.6\\%.\n$$\n\nThus, we have that \n\n- reducing the dataset to $1$ dimension would preserve $58.0\\%$ of the variance, while\n\n- reducing the dataset to $2$ dimensions would preserve $92.6\\%$ of the variance.\n\nIf we wish to preserve $90\\%$ of the variance, we should reduce the dataset to $2\\text{ dimensions}$ , since this is the minimum number of components that preserves at least $90\\%$ of the variance.\n\nWriting ${v}_{1},{v}_{2},{v}_{3}$ for the columns of $V$ and ${u}_{1},{u}_{2},{u}_{3},{u}_{4},{u}_{5}$ for the columns of $U$, the reduced dataset is\n\n$$\n{X}_{\\text{red}}={X}_{\\text{std}}\\cdot [\\begin{aligned}{v}_{1} & {v}_{2}\\end{aligned}],\n$$\n\nsince we need to project the data onto the first two principal components, which are the first two columns of $V.$\n\n**Note:** In order to invert the projection and interpret any further analysis in terms of the original features, we need to know the means and standard deviations of the original dataset $X.$ Additionally, in case we have more data, we can use the means and standard deviations of the original dataset to map the new data into the original feature space."}] [{:db/id #edb/ref 17592186529191 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d885553-3afc-5696-a382-4c860965f60c" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186528520} {:answer/id #uuid "7bf00a72-f79f-582d-9aaa-38874ff20b92" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186528592} {:answer/id #uuid "7df12baa-7b1b-58dc-8f63-3871724e61dd" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186528598} {:answer/id #uuid "c974d506-c2bc-5e7b-97a4-c51ae5371031" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186528794} {:answer/id #uuid "e94c076f-c6c7-517d-8c55-d74158a4a6fe" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186528875}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186528520} :answer-field/id #uuid "20580d7d-28aa-5c7c-a048-784d0bfa2d4b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186528956}] :question/id #uuid "f1d7f6a4-6114-5671-a52c-7df48bee5e24" :question/math-academy-id "q-141342" :question/problem "Consider the following sentence:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)\\ne 0,$ then  $\\underline{\\phantom{xxxxxx}}\\,.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\nI. $\\text{Null}(A)$ has no basis\n\nII. $A$ is **not** invertible\n\nIII. All columns of $A$ are pivot columns" :question/worked-solution "The invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{n} \\\\  & \\text{dim(Col}(A))=n=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each of the options separately. \n\n- The following statement is false:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then $\\text{Null}(A)$ has no basis.* $\\,\\times $ \n\nSince $\\text{nullity}(A)\\ne 0,$ we have $\\text{Null}(A)\\ne \\{0\\}$ which, in turn, means that $\\text{Null}(A)$ must have a basis.\n\n- The following statement is true:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then $A$ is **not** invertible.* $\\,✓$\n\nIndeed, by the invertible matrix theorem, since $\\text{nullity}(A)\\ne 0,$ we must have that $A$ is **not** invertible.\n\n- The following statement is false:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then all columns of $A$ are pivot columns.* $\\,\\times $\n\nSince $A$ is not invertible, then according to the invertible matrix theorem, we have $\\text{Col}(A)\\ne {R}^{n},$ which means that not all columns of $A$ are pivot columns.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186537922 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a343a9c-47b7-5434-8cc2-55123caf0ea0" :answer/type {:db/ident :answer.type/math} :answer/value "70.7%" :db/id #edb/ref 17592186537314} {:answer/id #uuid "3c0ed494-ccbd-5fee-87bf-c4772b8cd862" :answer/type {:db/ident :answer.type/math} :answer/value "71.6%" :db/id #edb/ref 17592186537352} {:answer/id #uuid "8458816f-8b48-5cde-9d4a-33d4e2eff2af" :answer/type {:db/ident :answer.type/math} :answer/value "70.9%" :db/id #edb/ref 17592186537484} {:answer/id #uuid "f0ab9777-fef9-5b5d-be92-67582e5fc5cc" :answer/type {:db/ident :answer.type/math} :answer/value "69.7%" :db/id #edb/ref 17592186537725} {:answer/id #uuid "fa0758bb-92c5-56b2-82ce-f22f66450474" :answer/type {:db/ident :answer.type/math} :answer/value "72.7%" :db/id #edb/ref 17592186537745}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "70.9%" :db/id #edb/ref 17592186537484} :answer-field/id #uuid "332d328e-144d-5da5-910d-9c9b357e23b6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186537775}] :question/id #uuid "6923f3da-7346-5c88-a6fe-bd6d1873e88f" :question/math-academy-id "q-345609" :question/problem "An economist measured $4$ particular features, ${x}_{1},{x}_{2},{x}_{3},{x}_{4},$ for each currency in a collection under devaluation. The collected data was stored in the standardized observation matrix $X,$ where each row contains measurements for a particular currency.\nThe singular values of $X$ are \n\n$$\n{\\sigma }_{1}=12,\\,{\\sigma }_{2}=7,\\,{\\sigma }_{3}=3,\\,{\\sigma }_{4}=1.\n$$\n\nThe economist then converted the original observation matrix $X$ into a new matrix $Y$ using the equation $Y=X{V}_{1},$ where ${V}_{1}$ is the $4\\times 1$ matrix consisting of the first principal component of the data. What percentage of the original variance is preserved in the new transformed matrix $Y$ compared to the initial observation matrix $X?$" :question/worked-solution "Let $V$ be the matrix of principal components. Then, applying the change of variables\n\n$$\nY=XV\n$$\n\nwe can convert our observation matrix $X$ into a new matrix $Y$ of (linearly) transformed observations such that\n\n- the covariance matrix of $Y$ is diagonal (meaning that the new features ${y}_{1},{y}_{2},…,{y}_{4}$ are uncorrelated),\n\n- the features ${y}_{1},{y}_{2},{y}_{3},{y}_{4}$ are arranged in order of decreasing variance, and\n\n- the squares of the singular values ${\\sigma }_{1}^{2},{\\sigma }_{2}^{2},{\\sigma }_{3}^{2},{\\sigma }_{4}^{2}$ represent the variances in the respective features ${y}_{1},{y}_{2},{y}_{3},{y}_{4}.$\n\nNow, the total variance over all features is proportional to the sum of the squared singular values:\n\n$$\n\\begin{aligned}\\text{Total} & ∝{\\sum }_{i=1}^{4}{\\sigma }_{i}^{2} \\\\  & =(12)^{2}+(7)^{2}+(3)^{2}+(1)^{2} \\\\  & =203\\end{aligned}\n$$\n\nSince the economist used only the first principal component, the remaining variance is\n\n$$\n\\begin{aligned}\\text{Remaining} & ∝{\\sum }_{i=1}^{1}{\\sigma }_{i}^{2} \\\\  & =(12)^{2} \\\\  & =144.\\end{aligned}\n$$\n\nTherefore, our required percentage can be computed as\n\n$$\n\\begin{aligned}\\frac{\\text{Remaining}}{\\text{Total}} & =\\frac{144}{203} \\\\  & ≈0.709 \\\\  & =70.9\\%.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186537951 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49c18a90-d0ab-5db3-907e-9d6d19ce5251" :answer/type {:db/ident :answer.type/math} :answer/value "58.3%" :db/id #edb/ref 17592186537385} {:answer/id #uuid "534fc293-1b38-5991-9c40-35df9573a0ef" :answer/type {:db/ident :answer.type/math} :answer/value "63.1%" :db/id #edb/ref 17592186537402} {:answer/id #uuid "a003e2d0-0b5a-564f-bbea-c1c7cd17d282" :answer/type {:db/ident :answer.type/math} :answer/value "57.1%" :db/id #edb/ref 17592186537528} {:answer/id #uuid "dccecae2-fe53-5ef0-8dd7-5f7144995552" :answer/type {:db/ident :answer.type/math} :answer/value "60.8%" :db/id #edb/ref 17592186537671} {:answer/id #uuid "f21bf8a8-668c-531d-a786-a924eb2ffa9b" :answer/type {:db/ident :answer.type/math} :answer/value "71.2%" :db/id #edb/ref 17592186537728}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "60.8%" :db/id #edb/ref 17592186537671} :answer-field/id #uuid "f239ec3f-54ad-5f78-85ed-e887372ab958" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186537872}] :question/id #uuid "a62d30b2-87c9-5394-8f0b-7a8e71495548" :question/math-academy-id "q-345594" :question/problem "An epidemiologist measured $4$ particular features, ${x}_{1},{x}_{2},{x}_{3},{x}_{4},$ for each disease affecting a specific population. The collected data was stored in the standardized observation matrix $X,$ where each row contains measurements for a particular individual.\nThe singular values of $X$ are \n\n$$\n{\\sigma }_{1}=11,\\,{\\sigma }_{2}=7,\\,{\\sigma }_{3}=5,\\,{\\sigma }_{4}=2.\n$$\n\nThe epidemiologist then converted the original observation matrix $X$ into a new matrix $Y$ using the equation $Y=X{V}_{1},$ where ${V}_{1}$ is the $4\\times 1$ matrix consisting of the first principal component of the data. What percentage of the original variance is preserved in the new transformed matrix $Y$ compared to the initial observation matrix $X?$" :question/worked-solution "Let $V$ be the matrix of principal components. Then, applying the change of variables\n\n$$\nY=XV\n$$\n\nwe can convert our observation matrix $X$ into a new matrix $Y$ of (linearly) transformed observations such that\n\n- the covariance matrix of $Y$ is diagonal (meaning that the new features ${y}_{1},{y}_{2},…,{y}_{4}$ are uncorrelated),\n\n- the features ${y}_{1},{y}_{2},{y}_{3},{y}_{4}$ are arranged in order of decreasing variance, and\n\n- the squares of the singular values ${\\sigma }_{1}^{2},{\\sigma }_{2}^{2},{\\sigma }_{3}^{2},{\\sigma }_{4}^{2}$ represent the variances in the respective features ${y}_{1},{y}_{2},{y}_{3},{y}_{4}.$\n\nNow, the total variance over all features is proportional to the sum of the squared singular values:\n\n$$\n\\begin{aligned}\\text{Total} & ∝{\\sum }_{i=1}^{4}{\\sigma }_{i}^{2} \\\\  & =(11)^{2}+(7)^{2}+(5)^{2}+(2)^{2} \\\\  & =199\\end{aligned}\n$$\n\nSince the epidemiologist used only the first principal component, the remaining variance is\n\n$$\n\\begin{aligned}\\text{Remaining} & ∝{\\sum }_{i=1}^{1}{\\sigma }_{i}^{2} \\\\  & =(11)^{2} \\\\  & =121.\\end{aligned}\n$$\n\nTherefore, our required percentage can be computed as\n\n$$\n\\begin{aligned}\\frac{\\text{Remaining}}{\\text{Total}} & =\\frac{121}{199} \\\\  & ≈0.608 \\\\  & =60.8\\%.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186543481 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3e3a4e0-3072-52d5-8dd2-90ed5a353f4a" :answer/type {:db/ident :answer.type/text} :answer/value "$3$ dimensions" :db/id #edb/ref 17592186543155} {:answer/id #uuid "c6ba0e8a-c0bf-547e-adcc-0ed6d87df774" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ dimensions" :db/id #edb/ref 17592186543158} {:answer/id #uuid "d15669cf-2800-56d9-84de-8bb935560c1c" :answer/type {:db/ident :answer.type/text} :answer/value "$1$ dimension" :db/id #edb/ref 17592186543180}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$2$ dimensions" :db/id #edb/ref 17592186543158} :answer-field/id #uuid "20bb4000-6ffb-5bec-a89b-04e5bbaff99a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186543312} {:answer-field/choices [{:answer/id #uuid "1427796d-eb86-552f-957a-f1407ab65cae" :answer/type {:db/ident :answer.type/text} :answer/value "the original number of features" :db/id #edb/ref 17592186542691} {:answer/id #uuid "18b29fe7-3f3b-5d6d-8700-561ac31c65f4" :answer/type {:db/ident :answer.type/text} :answer/value "if the eigenvalue is smaller than average" :db/id #edb/ref 17592186542702} {:answer/id #uuid "5c35ddf2-7858-53f4-9880-73848035b2d4" :answer/type {:db/ident :answer.type/text} :answer/value "if the singular value is greater than $1$" :db/id #edb/ref 17592186542888} {:answer/id #uuid "7b6593be-698b-54b5-93a1-296d85cbd08f" :answer/type {:db/ident :answer.type/text} :answer/value "the amount of cumulative variance preserved" :db/id #edb/ref 17592186542968}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "the amount of cumulative variance preserved" :db/id #edb/ref 17592186542968} :answer-field/id #uuid "22a03984-b019-540f-8de4-513dc1ddbb0f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186543314}] :question/id #uuid "1c7b66a2-e4ef-5d7b-9466-353945dad93a" :question/math-academy-id "q-355845" :question/problem "Suppose we have a dataset consisting of $5$ datapoints with $3$ features in the form of the $5\\times 3$ matrix\n\n$$\nX=[\\begin{aligned}-0.6 & -0.95 & -1.02 \\\\ 0.79 & 0.33 & 1.56 \\\\ -1.48 & -1.17 & -0.66 \\\\ 0.67 & 0.8 & -0.15 \\\\ 0.63 & 0.99 & 0.27\\end{aligned}]\n$$\n\nwhere the data has been standardized (the mean of each feature is $0$ and the standard deviation is $1$).\nWe are also given the SVD decomposition $X=UΣ{V}^{T}$ where:\n\n$$\n\\begin{aligned}U & =[\\begin{aligned}-0.462 & 0.174 & -0.685 & 0.1 & 0.527 \\\\ 0.473 & -0.718 & -0.24 & 0.358 & 0.272 \\\\ -0.613 & -0.29 & 0.546 & 0.457 & 0.181 \\\\ 0.253 & 0.517 & -0.053 & 0.798 & -0.17 \\\\ 0.35 & 0.319 & 0.416 & -0.127 & 0.766\\end{aligned}] \\\\ Σ & =[\\begin{aligned}3.171 & 0 & 0 \\\\ 0 & 1.32 & 0 \\\\ 0 & 0 & 0.477 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}] \\\\ V & =[\\begin{aligned}0.615 & 0.231 & -0.754 \\\\ 0.587 & 0.505 & 0.633 \\\\ 0.527 & -0.832 & 0.175\\end{aligned}]\\end{aligned}\n$$\n\nWe will use principal component analysis to reduce the dimensionality of the dataset. \n\nIn order to reduce the dimensionality of the dataset, we will project the data onto the first few principal components.\n\nWe should pick components based on \n{{field-1}}.\n\nIf we wish to preserve $95\\%$ of the variance, we should reduce the dataset to \n{{field-2}}." :question/worked-solution "In reducing the dimensionality of the dataset, we aim to preserve as much of the original variance as possible. \n\nWe should pick components based on $\\text{the amount of cumulative variance preserved}.$\n\nThe variance along a principal component is equal to the corresponding eigenvalue of the covariance matrix, which is proportional to the square of the corresponding singular value of the data matrix.\n\nIn our example, the singular values are\n\n$$\n{\\sigma }_{1}=3.171,\\,{\\sigma }_{2}=1.32,\\,{\\sigma }_{3}=0.477.\n$$\n\nLet us now compute the cumulative variance preserved for different numbers of components.\n\n- The fraction of variance preserved by projecting the data onto the first principal component is \n\n$$\n\\frac{{\\sigma }_{1}^{2}}{{\\sum }_{i=1}^{3}{\\sigma }_{i}^{2}}=\\frac{{3.171}^{2}}{{3.171}^{2}+{1.32}^{2}+{0.477}^{2}}≈83.6\\%.\n$$\n\n- The fraction of variance preserved by projecting the data onto the first two principal components is \n\n$$\n\\frac{{\\sum }_{i=1}^{2}{\\sigma }_{i}^{2}}{{\\sum }_{i=1}^{3}{\\sigma }_{i}^{2}}=\\frac{{3.171}^{2}+{1.32}^{2}}{{3.171}^{2}+{1.32}^{2}+{0.477}^{2}}≈98.1\\%.\n$$\n\nThus, we obtain that\n\n- reducing the dataset to $1$ dimension would preserve $83.6\\%$ of the variance, while\n\n- reducing the dataset to $2$ dimensions would preserve $98.1\\%$ of the variance.\n\n![](images/1d/1d967881aaa7c2a7cd7f537d70d3637edae36b3edf62e15ac67949925d5ee2ef.png)\n\nTherefore, we should reduce the dataset to $2\\text{ dimensions},$ since this is the minimum number of components that preserves at least $95\\%$ of the variance."}] [{:db/id #edb/ref 17592186543515 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ec937d1-e5b9-5630-8e26-295f9d71c684" :answer/type {:db/ident :answer.type/text} :answer/value "$4$ dimensions" :db/id #edb/ref 17592186542894} {:answer/id #uuid "739620ba-aa1b-5b3d-8863-a2e8f0022963" :answer/type {:db/ident :answer.type/text} :answer/value "$3$ dimensions" :db/id #edb/ref 17592186542943} {:answer/id #uuid "88e62841-c860-50af-be14-c96305a4714d" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ dimensions" :db/id #edb/ref 17592186543000} {:answer/id #uuid "c408f96e-ccbc-5cb8-8e08-9511939a15b2" :answer/type {:db/ident :answer.type/text} :answer/value "$1$ dimension" :db/id #edb/ref 17592186543156}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$3$ dimensions" :db/id #edb/ref 17592186542943} :answer-field/id #uuid "5faada09-26d3-54a9-9980-7006e9efb72b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186543350} {:answer-field/choices [{:answer/id #uuid "1da702c8-fb50-57a2-aba8-86d7f2e992e7" :answer/type {:db/ident :answer.type/text} :answer/value "the original number of features" :db/id #edb/ref 17592186542716} {:answer/id #uuid "25191f9d-4f63-51c7-86f9-6e2eba8f5813" :answer/type {:db/ident :answer.type/text} :answer/value "the amount of cumulative variance preserved" :db/id #edb/ref 17592186542735} {:answer/id #uuid "54161fc7-2907-5cdd-98f5-833fcf9a93ee" :answer/type {:db/ident :answer.type/text} :answer/value "if the eigenvalue is smaller than average" :db/id #edb/ref 17592186542865} {:answer/id #uuid "7cb19297-4a76-5a65-8e56-43999bd8dc66" :answer/type {:db/ident :answer.type/text} :answer/value "if the singular value is greater than $1$" :db/id #edb/ref 17592186542974}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "the amount of cumulative variance preserved" :db/id #edb/ref 17592186542735} :answer-field/id #uuid "68067e86-ba42-567b-bdcd-ca00107fc431" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186543353}] :question/id #uuid "6d89bf53-876c-5233-a22b-c8fa7b16fa9b" :question/math-academy-id "q-355902" :question/problem "Suppose we have a dataset consisting of $5$ datapoints with $4$ features in the form of the $5\\times 4$ matrix\n\n$$\nX=[\\begin{aligned}0.93 & 0.98 & -1.44 & -1.13 \\\\ -0.14 & -0.96 & 0.96 & 1.58 \\\\ -1.06 & -1.09 & -0.61 & -0.05 \\\\ -0.86 & 0.96 & 0.42 & 0.08 \\\\ 1.12 & 0.1 & 0.68 & -0.48\\end{aligned}]\n$$\n\nwhere the data has been standardized (the mean of each feature is $0$ and the standard deviation is $1$).\nWe are also given the SVD decomposition $X=UΣ{V}^{T}$ where:\n\n$$\n\\begin{aligned}U & =[\\begin{aligned}-0.725 & 0.1 & -0.166 & -0.483 & 0.452 \\\\ 0.64 & -0.269 & -0.185 & -0.532 & 0.449 \\\\ 0.207 & 0.729 & -0.311 & 0.363 & 0.444 \\\\ 0.032 & 0.06 & 0.889 & 0.076 & 0.446 \\\\ -0.149 & -0.619 & -0.227 & 0.588 & 0.444\\end{aligned}] \\\\ Σ & =[\\begin{aligned}3.067 & 0 & 0 & 0 \\\\ 0 & 1.933 & 0 & 0 \\\\ 0 & 0 & 1.517 & 0 \\\\ 0 & 0 & 0 & 0.763 \\\\ 0 & 0 & 0 & 0\\end{aligned}] \\\\ V & =[\\begin{aligned}-0.384 & -0.717 & -0.539 & -0.218 \\\\ -0.5 & -0.229 & 0.78 & -0.297 \\\\ 0.471 & -0.643 & 0.31 & 0.518 \\\\ 0.617 & -0.141 & 0.06 & -0.772\\end{aligned}]\\end{aligned}\n$$\n\nWe will use principal component analysis to reduce the dimensionality of the dataset. \n\nIn order to reduce the dimensionality of the dataset, we will project the data onto the first few principal components.\n\nWe should pick components based on \n{{field-1}}.\n\nIf we wish to preserve $90\\%$ of the variance, we should reduce the dataset to \n{{field-2}}." :question/worked-solution "In reducing the dimensionality of the dataset, we aim to preserve as much of the original variance as possible. \n\nWe should pick components based on $\\text{the amount of cumulative variance preserved}.$\n\nThe variance along a principal component is equal to the corresponding eigenvalue of the covariance matrix, which is proportional to the square of the corresponding singular value of the data matrix.\n\nIn our example, the singular values are\n\n$$\n{\\sigma }_{1}=3.067,\\,{\\sigma }_{2}=1.933,\\,{\\sigma }_{3}=1.517,\\,{\\sigma }_{4}=0.763.\n$$\n\nLet us now compute the cumulative variance preserved for different numbers of components.\n\n- The fraction of variance preserved by projecting the data onto the first principal component is \n\n$$\n\\frac{{\\sigma }_{1}^{2}}{{\\sum }_{i=1}^{4}{\\sigma }_{i}^{2}}=\\frac{{3.067}^{2}}{{3.067}^{2}+{1.933}^{2}+{1.517}^{2}+{0.763}^{2}}≈58.7\\%.\n$$\n\n- The fraction of variance preserved by projecting the data onto the first two principal components is \n\n$$\n\\frac{{\\sum }_{i=1}^{2}{\\sigma }_{i}^{2}}{{\\sum }_{i=1}^{4}{\\sigma }_{i}^{2}}=\\frac{{3.067}^{2}+{1.933}^{2}}{{3.067}^{2}+{1.933}^{2}+{1.517}^{2}+{0.763}^{2}}≈82.0\\%.\n$$\n\n- The fraction of variance preserved by projecting the data onto the first three principal components is \n\n$$\n\\frac{{\\sum }_{i=1}^{3}{\\sigma }_{i}^{2}}{{\\sum }_{i=1}^{4}{\\sigma }_{i}^{2}}=\\frac{{3.067}^{2}+{1.933}^{2}+{1.517}^{2}}{{3.067}^{2}+{1.933}^{2}+{1.517}^{2}+{0.763}^{2}}≈96.4\\%.\n$$\n\nThus, we obtain that\n\n- reducing the dataset to $1$ dimension would preserve $58.7\\%$ of the variance,\n\n- reducing the dataset to $2$ dimensions would preserve $82.0\\%$ of the variance, while\n\n- reducing the dataset to $3$ dimensions would preserve $96.4\\%$ of the variance.\n\n![](images/ff/ff1aa60e989377c3767643d2538755d932bc40669f550b57040581192a104f8c.png)\n\nTherefore, we should reduce the dataset to $3\\text{ dimensions},$ since this is the minimum number of components that preserves at least $90\\%$ of the variance."}] [{:db/id #edb/ref 17592186543563 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e54602f-aedc-5bf0-ba05-5146a3c0e58c" :answer/type {:db/ident :answer.type/text} :answer/value "most" :db/id #edb/ref 17592186542762} {:answer/id #uuid "4418bc01-1a7d-5cc7-93ac-edd6f1e0d709" :answer/type {:db/ident :answer.type/text} :answer/value "least" :db/id #edb/ref 17592186542826}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "most" :db/id #edb/ref 17592186542762} :answer-field/id #uuid "16850f55-af43-55e3-ad92-a64b04f5cd87" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186543303} {:answer-field/choices [{:answer/id #uuid "1d42b6fe-6080-526f-b8ff-8902f825dcbe" :answer/type {:db/ident :answer.type/math} :answer/value "{[\\begin{aligned}{u}_{1} & {u}_{2} & {u}_{3}\\end{aligned}]}^{T}\\cdot {X}_{\\text{std}}" :db/id #edb/ref 17592186542714} {:answer/id #uuid "63b8f682-bf7c-5856-bb62-08dd2d51224f" :answer/type {:db/ident :answer.type/math} :answer/value "{[\\begin{aligned}{u}_{1} & {u}_{2}\\end{aligned}]}^{T}\\cdot {X}_{\\text{std}}" :db/id #edb/ref 17592186542911} {:answer/id #uuid "e10f43d2-863a-5cc1-b8da-5855b7ed35b4" :answer/type {:db/ident :answer.type/math} :answer/value "{X}_{\\text{std}}\\cdot [\\begin{aligned}{v}_{1} & {v}_{2}\\end{aligned}]" :db/id #edb/ref 17592186543214} {:answer/id #uuid "ee724c12-aaa7-5096-bd0e-8bac841a312d" :answer/type {:db/ident :answer.type/math} :answer/value "{X}_{\\text{std}}\\cdot V" :db/id #edb/ref 17592186543248}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{X}_{\\text{std}}\\cdot [\\begin{aligned}{v}_{1} & {v}_{2}\\end{aligned}]" :db/id #edb/ref 17592186543214} :answer-field/id #uuid "27d2d9e8-3a92-5999-9d31-fed4d7581f6a" :answer-field/key "field-9" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186543315} {:answer-field/choices [{:answer/id #uuid "273e0c1d-b87b-5ff3-baa3-fadd69ca7d41" :answer/type {:db/ident :answer.type/math} :answer/value "81.2%" :db/id #edb/ref 17592186542741} {:answer/id #uuid "b0ea3bfc-2d66-5402-8fe8-5d08e93ae3b2" :answer/type {:db/ident :answer.type/math} :answer/value "89.8%" :db/id #edb/ref 17592186543101} {:answer/id #uuid "de9c26c7-ca69-53f2-b784-e825ea875dab" :answer/type {:db/ident :answer.type/math} :answer/value "95.5%" :db/id #edb/ref 17592186543207} {:answer/id #uuid "f06b33f1-df10-5b8a-954a-74772139f2c9" :answer/type {:db/ident :answer.type/math} :answer/value "72.3%" :db/id #edb/ref 17592186543254}] :answer-field/correct {: