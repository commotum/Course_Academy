}{3}⟩" :db/id #edb/ref 17592186236922} {:answer/id #uuid "d095b16d-d82d-5f43-b45a-419f5d3af373" :answer/type {:db/ident :answer.type/math} :answer/value "⟨11,3,3⟩" :db/id #edb/ref 17592186237139}] :answer-field/correct {:db/id #edb/ref 17592186236494} :answer-field/id #uuid "be1426b6-aff3-5cb0-a4a0-23caf436597b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237682}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bcc22116-bc14-5a39-b8c2-56ca9a77cd3e" :question/math-academy-id "q-10198" :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2}+3{x}_{3} &=9 \\\\ {x}_{2}-3{x}_{3} &=2 \\\\ {x}_{3} &=\\frac{1}{3}\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that  ${x}_{3}=\\frac{1}{3}.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}-3(\\frac{1}{3})=2\\,⟹\\,{x}_{2}=2+1=3.\n$$\n\nNow, we substitute ${x}_{3}=\\frac{1}{3}$ and ${x}_{2}=3$ into the first equation to get\n\n$$\n{x}_{1}-(3)+3(\\frac{1}{3})=9\\,⟹\\,{x}_{1}=9+3-1=11.\n$$\n\nTherefore, the solution is ${x}_{1}=11$, ${x}_{2}=3$, and ${x}_{3}=\\frac{1}{3}.$ In vector form, the solution can be written as $⟨11,3,\\frac{1}{3}⟩.$"} {:db/id #edb/ref 17592186237863 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21a79906-5cb4-5bef-b514-16249233d145" :answer/type {:db/ident :answer.type/math} :answer/value "⟨6,2,1⟩" :db/id #edb/ref 17592186236034} {:answer/id #uuid "41297e90-8727-58fb-b8d8-b13a27897e7e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨5,3,-1⟩" :db/id #edb/ref 17592186236234} {:answer/id #uuid "94381ccc-fa56-5aa0-ae60-fbb397e8306f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨7,3,1⟩" :db/id #edb/ref 17592186236757} {:answer/id #uuid "a806f01f-bf60-51b5-8cbb-3a06ecf8e20a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨5,2,0⟩" :db/id #edb/ref 17592186236868} {:answer/id #uuid "b7b6597e-1433-50b9-96f9-108bb74b9d04" :answer/type {:db/ident :answer.type/math} :answer/value "⟨7,-2,-1⟩" :db/id #edb/ref 17592186236985}] :answer-field/correct {:db/id #edb/ref 17592186236757} :answer-field/id #uuid "2c171bbc-c203-5bbd-9cf1-043a83a74293" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237499}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d50aa8dd-507e-51de-8c65-c56ceae864d0" :question/math-academy-id "q-10199" :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}x-y-z &=3 \\\\ y-z &=2 \\\\ z &=1\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that $z=1.$ Substituting this into the second equation, we get\n\n$$\ny-(1)=2\\,⟹\\,y=2+1=3.\n$$\n\nNow, we substitute $z=1$ and $y=3$ into the first equation to get\n\n$$\nx-(3)-(1)=3\\,⟹\\,x=3+4=7.\n$$\n\nThus, the solution is $x=7$,  $y=3$,  and $z=1.$ In vector form, the solution can be written as $⟨7,3,1⟩.$"} {:db/id #edb/ref 17592186265729 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c11278a-a1e9-521c-8e8b-63cb64cbc9b1" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4,\\frac{1}{2},-1⟩" :db/id #edb/ref 17592186263657} {:answer/id #uuid "53dcbf06-1cbe-5c03-8acd-dfd116927d2a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,\\frac{1}{2},-1⟩" :db/id #edb/ref 17592186263724} {:answer/id #uuid "67ee26c7-aa79-54e7-bb6c-da2cbb6aa207" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,-\\frac{1}{2},-1⟩" :db/id #edb/ref 17592186263896} {:answer/id #uuid "b3ccb4f9-e91b-5c5f-8631-fab1ffd18bc1" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4,-\\frac{1}{2},-1⟩" :db/id #edb/ref 17592186264544} {:answer/id #uuid "f84f6f46-07f3-5a35-aae2-92b02c84f290" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,-\\frac{3}{2},-1⟩" :db/id #edb/ref 17592186265173}] :answer-field/correct {:db/id #edb/ref 17592186263657} :answer-field/id #uuid "62d7fc5b-0d95-51be-9907-cd6c773cab26" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265417}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b7e933dd-83fd-54e7-932e-d388f7f7060c" :question/math-academy-id "q-129447" :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-2{x}_{2}+{x}_{3} &=2 \\\\ {x}_{2}+{x}_{3} &=-\\frac{1}{2} \\\\ {x}_{3} &=-1\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that ${x}_{3}=-1.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}+(-1)=-\\frac{1}{2}\\,⟹\\,{x}_{2}=-\\frac{1}{2}+1=\\frac{1}{2}.\n$$\n\nNow, we substitute ${x}_{2}=\\frac{1}{2}$ and ${x}_{3}=-1$ into the first equation to get\n\n$$\n{x}_{1}-2(\\frac{1}{2})+(-1)=2\\,⟹\\,{x}_{1}=2+1+1=4.\n$$\n\nTherefore, the solution is ${x}_{1}=4$, ${x}_{2}=\\frac{1}{2}$, and ${x}_{3}=-1.$ In vector form, the solution can be written as $⟨4,\\frac{1}{2},-1⟩.$"} {:db/id #edb/ref 17592186265730 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12383fa6-1be7-5faa-98b0-50c492b27020" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{15}{2} \\\\ \\frac{5}{2} \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186263173} {:answer/id #uuid "1482ccf9-247e-547f-978e-1785125b302f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{5}{2} \\\\ \\frac{5}{2} \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186263191} {:answer/id #uuid "36c944a4-efa5-527c-b4b4-15c498f39d84" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{3}{2} \\\\ \\frac{7}{2} \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186263486} {:answer/id #uuid "5e9ae90d-a61d-502f-a079-6171d561d548" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{3}{2} \\\\ -\\frac{5}{2} \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186263818} {:answer/id #uuid "e5272ebd-57ab-5c9a-943c-aa4636f76330" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{15}{2} \\\\ -\\frac{5}{2} \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186264993}] :answer-field/correct {:db/id #edb/ref 17592186263486} :answer-field/id #uuid "7f470e8a-d3f0-56a1-9405-dc8785df05d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265468}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ffbc1914-8f55-58fc-9939-7cf601faf78b" :question/math-academy-id "q-129452" :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}x+y-z &=2 \\\\ y-z &=\\frac{1}{2} \\\\ z &=3\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that $z=3.$ Substituting this into the second equation, we get\n\n$$\ny-3=\\frac{1}{2}\\,⟹\\,y=\\frac{1}{2}+3=\\frac{7}{2}.\n$$\n\nNow, we substitute $y=\\frac{7}{2}$ and $z=3$ into the first equation to get\n\n$$\nx+\\frac{7}{2}-3=2\\,⟹\\,x=2-\\frac{7}{2}+3=\\frac{3}{2}.\n$$\n\nTherefore, the solution is $x=\\frac{3}{2}$, $y=\\frac{7}{2}$, and $z=3.$ In vector form, the solution can be written as\n$$\n\\begin{bmatrix}\\frac{3}{2} \\\\ \\frac{7}{2} \\\\ 3\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186265731 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a172890-3f87-5a80-964d-e89a1fb78934" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,-4,-2⟩" :db/id #edb/ref 17592186263777} {:answer/id #uuid "d768f9e7-ff33-529d-9697-e0257e01235f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨6,-4,-2⟩" :db/id #edb/ref 17592186264879} {:answer/id #uuid "e4666737-b082-581c-a226-b9480b7e82c3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨6,4,-2⟩" :db/id #edb/ref 17592186264985} {:answer/id #uuid "eac5eddd-1434-5977-8e97-e4df1980cf72" :answer/type {:db/ident :answer.type/math} :answer/value "⟨6,0,-2⟩" :db/id #edb/ref 17592186265045} {:answer/id #uuid "ffdbfc12-7648-502a-bc1c-5a7448cf96b9" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,0,-2⟩" :db/id #edb/ref 17592186265251}] :answer-field/correct {:db/id #edb/ref 17592186264985} :answer-field/id #uuid "5bdc74f4-4bcc-59f6-8302-2fdbc15d6835" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265408}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3719eef8-ec9e-5d13-b3ad-dc6ee7926695" :question/math-academy-id "q-129453" :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2}-{x}_{3} &=4 \\\\ {x}_{2}+{x}_{3} &=2 \\\\ {x}_{3} &=-2\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that ${x}_{3}=-2.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}+(-2)=2\\,⟹\\,{x}_{2}=2+2=4.\n$$\n\nNow, we substitute ${x}_{2}=4$ and ${x}_{3}=-2$ into the first equation to get\n\n$$\n{x}_{1}-4-(-2)=4\\,⟹\\,{x}_{1}=4+4-2=6.\n$$\n\nTherefore, the solution is ${x}_{1}=6$, ${x}_{2}=4$, and ${x}_{3}=-2.$ In vector form, the solution can be written as $⟨6,4,-2⟩.$"} {:db/id #edb/ref 17592186265732 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bb7eb03-f9e4-5c84-825e-4af3dc459a1c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{3} \\\\ 1 \\\\ -\\frac{1}{3}\\end{bmatrix}" :db/id #edb/ref 17592186263370} {:answer/id #uuid "3267cac5-e192-561d-abb2-9c349b094047" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{8}{3} \\\\ -1 \\\\ -\\frac{1}{3}\\end{bmatrix}" :db/id #edb/ref 17592186263433} {:answer/id #uuid "379c045a-17f7-55f6-b610-cc58a5bf28a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{8}{3} \\\\ 1 \\\\ -\\frac{1}{3}\\end{bmatrix}" :db/id #edb/ref 17592186263502} {:answer/id #uuid "39fe00c8-2263-5a88-8044-ac8d9246b900" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{3} \\\\ 0 \\\\ -\\frac{1}{3}\\end{bmatrix}" :db/id #edb/ref 17592186263517} {:answer/id #uuid "421302c0-ff7e-5cd9-98df-d7ad54cd1916" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{5}{3} \\\\ 0 \\\\ -\\frac{1}{3}\\end{bmatrix}" :db/id #edb/ref 17592186263585}] :answer-field/correct {:db/id #edb/ref 17592186263370} :answer-field/id #uuid "abadbea5-ec63-5456-93e5-7d951e9c42cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265553}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bdb97edb-fdd8-52f8-9de8-da5dc252cf96" :question/math-academy-id "q-129455" :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2}-{x}_{3} &=2 \\\\ {x}_{2}-6{x}_{3} &=3 \\\\ {x}_{3} &=-\\frac{1}{3}\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that ${x}_{3}=-\\frac{1}{3}.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}-6(-\\frac{1}{3})=3\\,⟹\\,{x}_{2}=3-2=1.\n$$\n\nNow, we substitute ${x}_{3}=-\\frac{1}{3}$ and ${x}_{2}=1$ into the first equation to get\n\n$$\n{x}_{1}+1-(-\\frac{1}{3})=2\\,⟹\\,{x}_{1}=2-1-\\frac{1}{3}=\\frac{2}{3}.\n$$\n\nTherefore, the solution is ${x}_{1}=\\frac{2}{3}$, ${x}_{2}=1$, and ${x}_{3}=-\\frac{1}{3}.$ In vector form, the solution can be written as\n$$\n\\begin{bmatrix}\\frac{2}{3} \\\\ 1 \\\\ -\\frac{1}{3}\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186413953 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e1ba396-d863-536b-b63f-89da9c93622a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 \\\\ -2 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186413947} {:answer/id #uuid "91fdb22c-ce3c-5047-b232-a746c92c76b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ -1 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186413948} {:answer/id #uuid "f25b4ba1-98cc-5dc7-9732-a2c78c54931c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 \\\\ 0 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186413949} {:answer/id #uuid "f69db92d-7316-5f7d-b669-23f831b82506" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 \\\\ 1 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186413950} {:answer/id #uuid "f9dee24f-b474-52fc-80d0-88800792c747" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ -1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186413951}] :answer-field/correct {:db/id #edb/ref 17592186413948} :answer-field/id #uuid "35113197-e3aa-5c52-abd1-3a40104e5631" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186413952}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5e70385a-e12c-5845-86a7-e3cc76809c15" :question/math-academy-id "q-20421" :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}x-y-z &=4 \\\\ y+z &=2 \\\\ z &=3\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that $z=3.$ Substituting this into the second equation, we get  \n\n$$\ny+(3)=2\\,⟹\\,y=2-3=-1.\n$$\n\n \n\nNow, we substitute $z=3$ and $y=-1$ into the first equation to get\n\n$$\nx-(-1)-(3)=4\\,⟹\\,x=4-1+3=6.\n$$\n\n \n\nTherefore, the solution is $x=6$, $y=-1$, and $z=3.$ In vector form, the solution can be written as\n$$\n\\begin{bmatrix}6 \\\\ -1 \\\\ 3\\end{bmatrix}.\n$$"}] :knowledge-point/title "Solving a System of Equations Using Back Substitution"} {:db/id #edb/ref 17592186096670 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096457 :question/id #uuid "cc8ce97a-3bda-506f-b9d2-98ac7524583a" :question/math-academy-id "e-4691" :question/problem "Solve the system of equations that is represented by the augmented matrix\n\n$$\n\\left[\n\t\\begin{array}{ccc|c}1 & 1 & -1 & 1 \\\\ 0 & 1 & 1 & -2 \\\\ 0 & 0 & 1 & 5\\end{array} \n\t\\right].\n$$\n\n" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say, $x_1,$ $x_2,$ and $x_3.$ We obtain the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2}-{x}_{3} &=1 \\\\ {x}_{2}+{x}_{3} &=-2 \\\\ {x}_{3} &=5\\end{aligned}\\right.\n$$\n\nThe third equation states that $x_3=5.$ Substituting this into the second equation, we get\n\n$$\nx_2+(5)=-2\n\t\\qquad\\Longrightarrow\\qquad\n\tx_2=-2-5=-7.\n$$\n\nNow, we substitute both $x_3 = 5$ and $x_2 = -7$ into the first equation to get\n\n$$\nx_1+(-7)-(5) = 1\n\t\\qquad\\Longrightarrow\\qquad\n\tx_1 = 1 + 7 + 5 = 13.\n$$\n\nTherefore, the solution is $x_1 = 13,$ $x_2=-7,$ and $x_3 = 5.$ Or, in vector form, the solution is $\\langle 13,-7,5 \\rangle.$"} :knowledge-point/id #uuid "de05090a-2461-514a-971d-b83c7cea124e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050765}] :knowledge-point/questions [{:db/id #edb/ref 17592186096925 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "182dccc5-8d2b-538a-83cd-6b89a3bfbad1" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,1,1⟩" :db/id #edb/ref 17592186235965} {:answer/id #uuid "3307379c-e700-51d9-9e99-3e3bd5ec477f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,1,0⟩" :db/id #edb/ref 17592186236139} {:answer/id #uuid "b0b17a9a-90d7-5870-b6b3-1af698f37d2a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,1,1⟩" :db/id #edb/ref 17592186236938} {:answer/id #uuid "c0484c72-d9c5-5f37-a8a6-65ce5f234ea3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,0,1⟩" :db/id #edb/ref 17592186237040} {:answer/id #uuid "cfaecad6-9a62-5f87-a4c9-cc1014ce4d6f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,0,1⟩" :db/id #edb/ref 17592186237135}] :answer-field/correct {:db/id #edb/ref 17592186237135} :answer-field/id #uuid "8a8b1db1-b5f2-508a-bbfc-19cbd8de4aba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237622}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "aaed5b7a-0eac-529c-ad7e-d0cc31abe7a0" :question/math-academy-id "q-10205" :question/problem "Solve the system of equations represented by the augmented matrix \n\n$$\n\\begin{bmatrix}1 & 1 & 1 & 1 \\\\ 0 & 1 & 1 & 1 \\\\ 0 & 0 & 1 & 1\\end{bmatrix}.\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say, $x$, $y$, and $z.$ We obtain the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}x+y+z &=1 \\\\ y+z &=1 \\\\ z &=1\\end{aligned}\\right.\n$$\n\nThe third equation states that $z=1.$ Substituting this into the second equation, we get\n\n$$\ny+(1)=1\\,⟹\\,y=1-1=0.\n$$\n\nNow, we substitute $z=1$ and $y=0$ into the first equation to get\n\n$$\nx+(0)+(1)=1\\,⟹\\,x=1-1=0.\n$$\n\nTherefore, the solution is $x=0$, $y=0$, and $z=1.$ In vector form, the solution can be written as $⟨0,0,1⟩.$"} {:db/id #edb/ref 17592186097179 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54cc7f45-5abb-56ee-a124-a4273a8ba81e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,-8,-2⟩" :db/id #edb/ref 17592186285566} {:answer/id #uuid "66b63a69-62b2-5bb0-becc-38130e10667c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-9,-2,2⟩" :db/id #edb/ref 17592186285718} {:answer/id #uuid "8cf971fc-d346-594c-be07-07d202b7d2fe" :answer/type {:db/ident :answer.type/math} :answer/value "⟨8,1,2⟩" :db/id #edb/ref 17592186286079} {:answer/id #uuid "dc61e934-2465-5214-a6e9-e0b8efc8327b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-3,-1,2⟩" :db/id #edb/ref 17592186286792} {:answer/id #uuid "f763395f-719c-53e5-989c-1980a86247e3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,0,2⟩" :db/id #edb/ref 17592186287056}] :answer-field/correct {:db/id #edb/ref 17592186285718} :answer-field/id #uuid "c39d0897-5c62-530f-90fb-390aadc625c5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287546}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7e5ad324-0319-5669-8d91-ed457e56d970" :question/math-academy-id "q-20422" :question/problem "Solve the system of equations represented by the augmented matrix\n\n$$\n\\begin{bmatrix}1 & -3 & 4 & 5 \\\\ 0 & 1 & 1 & 0 \\\\ 0 & 0 & 1 & 2\\end{bmatrix}.\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say,  ${x}_{1}$, ${x}_{2}$, and ${x}_{3}.$ We obtain the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-3{x}_{2}+4{x}_{3} &=5 \\\\ {x}_{2}+{x}_{3} &=0 \\\\ {x}_{3} &=2\\end{aligned}\\right.\n$$\n\nThe third equation states that ${x}_{3}=2.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}+(2)=0\\,⟹\\,{x}_{2}=-2.\n$$\n\nNow, we substitute ${x}_{3}=2$ and ${x}_{2}=-2$ into the first equation to get\n\n$$\n{x}_{1}-3(-2)+4(2)=5\\,⟹\\,{x}_{1}=5-6-8=-9.\n$$\n\nTherefore, the solution is ${x}_{1}=-9$, ${x}_{2}=-2$, and ${x}_{3}=2.$ In vector form, the solution can be written as $⟨-9,-2,2⟩.$"} {:db/id #edb/ref 17592186265733 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cbb9cc1-730a-501c-b1b3-c8376f37a85a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,-\\frac{1}{3},2⟩" :db/id #edb/ref 17592186263120} {:answer/id #uuid "2602e3b2-edab-573b-a449-a4f5aecb1626" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,\\frac{1}{3},2⟩" :db/id #edb/ref 17592186263329} {:answer/id #uuid "34f438c4-c90d-5a92-becf-cefe7392550e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,-\\frac{5}{3},2⟩" :db/id #edb/ref 17592186263466} {:answer/id #uuid "7426326d-daba-574f-9a1a-548082479ed1" :answer/type {:db/ident :answer.type/math} :answer/value "⟨5,-\\frac{5}{3},2⟩" :db/id #edb/ref 17592186264010} {:answer/id #uuid "fc0ebd5c-349a-51ba-8f45-fd0adeb225fd" :answer/type {:db/ident :answer.type/math} :answer/value "⟨5,-\\frac{1}{3},2⟩" :db/id #edb/ref 17592186265207}] :answer-field/correct {:db/id #edb/ref 17592186264010} :answer-field/id #uuid "203509e2-e511-5016-840a-b4990c3fdc69" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265297}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8c3fa01d-ccbd-5a15-bdb2-2085c84ec955" :question/math-academy-id "q-129457" :question/problem "Solve the system of equations represented by the augmented matrix\n\n$$\n\\begin{bmatrix}1 & 3 & 1 & 2 \\\\ 0 & 1 & \\frac{1}{3} & -1 \\\\ 0 & 0 & 1 & 2\\end{bmatrix}.\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say,  ${x}_{1}$, ${x}_{2}$, and ${x}_{3}.$ We obtain the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+3{x}_{2}+{x}_{3} &=2 \\\\ {x}_{2}+\\frac{{x}_{3}}{3} &=-1 \\\\ {x}_{3} &=2\\end{aligned}\\right.\n$$\n\nThe third equation states that ${x}_{3}=2.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}+\\frac{2}{3}=-1\\,⟹\\,{x}_{2}=-1-\\frac{2}{3}=-\\frac{5}{3}.\n$$\n\nNow, we substitute ${x}_{3}=2$ and ${x}_{2}=-\\frac{5}{3}$ into the first equation to get\n\n$$\n{x}_{1}+3(-\\frac{5}{3})+(2)=2\\,⟹\\,{x}_{1}=2+5-2=5.\n$$\n\nTherefore, the solution is ${x}_{1}=5$, ${x}_{2}=-\\frac{5}{3}$, and ${x}_{3}=2.$ In vector form, the solution can be written as $⟨5,-\\frac{5}{3},2⟩.$"} {:db/id #edb/ref 17592186265734 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "222da673-56b4-5d4c-aa69-0c90b32edc5e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,-12,3⟩" :db/id #edb/ref 17592186263303} {:answer/id #uuid "5688932e-6362-57e4-a963-6a026a06a31c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-22,-12,3⟩" :db/id #edb/ref 17592186263748} {:answer/id #uuid "67d930bc-c3eb-5f32-bcf8-7587f6c3e5d8" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-22,12,3⟩" :db/id #edb/ref 17592186263895} {:answer/id #uuid "c03458c2-4b76-5f04-9a4e-631b5ee8fcea" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,-12,3⟩" :db/id #edb/ref 17592186264671} {:answer/id #uuid "eb69bd69-af7f-5841-996d-2bb2cde06ce0" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,12,3⟩" :db/id #edb/ref 17592186265057}] :answer-field/correct {:db/id #edb/ref 17592186264671} :answer-field/id #uuid "b9916827-dc8b-5237-b0ed-09676d3fd47c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265571}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b219ecfb-921e-5b50-978c-98cd2c9acabd" :question/math-academy-id "q-129459" :question/problem "Solve the system of equations represented by the augmented matrix \n\n$$\n\\begin{bmatrix}1 & 1 & 3 & -2 \\\\ 0 & 1 & 4 & 0 \\\\ 0 & 0 & 1 & 3\\end{bmatrix}.\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say, $x$, $y$, and $z.$ We obtain the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}x+y+3z &=-2 \\\\ y+4z &=0 \\\\ z &=3\\end{aligned}\\right.\n$$\n\nThe third equation states that $z=3.$ Substituting this into the second equation, we get\n\n$$\ny+4(3)=0\\,⟹\\,y=-12.\n$$\n\nNow, we substitute $z=3$ and $y=-12$ into the first equation to get\n\n$$\nx+(-12)+3(3)=-2\\,⟹\\,x=-2+12-9=1.\n$$\n\nTherefore, the solution is $x=1$, $y=-12$, and $z=3.$ In vector form, the solution can be written as $⟨1,-12,3⟩.$"} {:db/id #edb/ref 17592186265749 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7eea9308-d352-5d29-8148-f6d013a8a142" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-5,-4,-1⟩" :db/id #edb/ref 17592186264096} {:answer/id #uuid "a4c1effa-942a-57d3-931b-c635aee1be5a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨11,2,-1⟩" :db/id #edb/ref 17592186264405} {:answer/id #uuid "a8f37a02-8183-502c-bcc0-ccd0db208e80" :answer/type {:db/ident :answer.type/math} :answer/value "⟨11,4,-1⟩" :db/id #edb/ref 17592186264444} {:answer/id #uuid "b1b7f006-4c95-5e2f-b780-b26a35d57862" :answer/type {:db/ident :answer.type/math} :answer/value "⟨7,2,-1⟩" :db/id #edb/ref 17592186264528} {:answer/id #uuid "dbb98e53-5e0c-594b-b291-68bdaf9b61c4" :answer/type {:db/ident :answer.type/math} :answer/value "⟨7,-4,-1⟩" :db/id #edb/ref 17592186264910}] :answer-field/correct {:db/id #edb/ref 17592186264444} :answer-field/id #uuid "82b8651b-2015-5a8d-a0be-a62fd5f39429" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265476}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a301e776-bc09-550c-bf21-25438dba0f53" :question/math-academy-id "q-129569" :question/problem "Solve the system of equations represented by the augmented matrix\n\n$$\n\\begin{bmatrix}1 & -2 & 3 & 0 \\\\ 0 & 1 & 1 & 3 \\\\ 0 & 0 & 1 & -1\\end{bmatrix}.\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say,  ${x}_{1}$, ${x}_{2}$, and ${x}_{3}.$ We obtain the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-2{x}_{2}+3{x}_{3} &=0 \\\\ {x}_{2}+{x}_{3} &=3 \\\\ {x}_{3} &=-1\\end{aligned}\\right.\n$$\n\nThe third equation states that ${x}_{3}=-1.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}+(-1)=3\\,⟹\\,{x}_{2}=3+1=4.\n$$\n\nNow, we substitute ${x}_{3}=-1$ and ${x}_{2}=4$ into the first equation to get\n\n$$\n{x}_{1}-2(4)+3(-1)=0\\,⟹\\,{x}_{1}=8+3=11.\n$$\n\nTherefore, the solution is ${x}_{1}=11$, ${x}_{2}=4$, and ${x}_{3}=-1.$ In vector form, the solution can be written as $⟨11,4,-1⟩.$"} {:db/id #edb/ref 17592186265750 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56c0707e-0631-5e99-ba02-7389b388e45b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-14,7,3⟩" :db/id #edb/ref 17592186263750} {:answer/id #uuid "82adc88c-6f01-5181-9b3e-6079f1c14df3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,7,3⟩" :db/id #edb/ref 17592186264124} {:answer/id #uuid "8f112d6e-e159-5a64-9f51-5168e778a6c1" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4,-11,3⟩" :db/id #edb/ref 17592186264225} {:answer/id #uuid "a0bc6c5e-c56c-5847-ad25-ed2e38054f02" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-14,-7,3⟩" :db/id #edb/ref 17592186264365} {:answer/id #uuid "e977e059-2220-541b-a75d-ec8440736b8a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,-7,3⟩" :db/id #edb/ref 17592186265030}] :answer-field/correct {:db/id #edb/ref 17592186265030} :answer-field/id #uuid "f834e889-235e-5ed6-b433-9cd676419b25" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265687}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f98c00cd-fa7a-5960-9ffe-f0175b73e871" :question/math-academy-id "q-129599" :question/problem "Solve the system of equations represented by the augmented matrix \n\n$$\n\\begin{bmatrix}1 & 1 & 2 & -1 \\\\ 0 & 1 & 3 & 2 \\\\ 0 & 0 & 1 & 3\\end{bmatrix}.\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say, $x$, $y$, and $z.$ We obtain the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}x+y+2z &=-1 \\\\ y+3z &=2 \\\\ z &=3\\end{aligned}\\right.\n$$\n\nThe third equation states that $z=3.$ Substituting this into the second equation, we get\n\n$$\ny+3(3)=2\\,⟹\\,y=2-9=-7.\n$$\n\nNow, we substitute $z=3$ and $y=-7$ into the first equation to get\n\n$$\nx+(-7)+2(3)=-1\\,⟹\\,x=-1+7-6=0.\n$$\n\nTherefore, the solution is $x=0$, $y=-7$, and $z=3.$ In vector form, the solution can be written as $⟨0,-7,3⟩.$"} {:db/id #edb/ref 17592186287990 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ae30bba-5530-5871-9ea8-4343da788a3c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 4 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186285617} {:answer/id #uuid "84ac8a3e-9db1-5899-a94c-f1d8a6b9f8d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -4 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186286009} {:answer/id #uuid "9dcb2df3-855d-5d8c-a44e-0d9a80e2da45" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 5 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186286231} {:answer/id #uuid "b551c659-6a03-59d6-a275-55b8eeb6c65e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 5 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186286438} {:answer/id #uuid "ea0025fc-ffa4-5c23-9ca1-fc484cd0db28" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 4 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186286929}] :answer-field/correct {:db/id #edb/ref 17592186286929} :answer-field/id #uuid "99080949-e49d-5bbc-ac7f-90d7689382a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287462}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1a5ebda6-bb81-57c5-aa1e-8e3aa3418e26" :question/math-academy-id "q-20452" :question/problem "Solve the system of equations represented by the augmented matrix\n\n$$\n\\begin{bmatrix}1 & 2 & 3 & -1 \\\\ 0 & 1 & 2 & -2 \\\\ 0 & 0 & 1 & -3\\end{bmatrix}.\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say,  ${x}_{1}$, ${x}_{2}$, and ${x}_{3}.$ We obtain the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2}+3{x}_{3} &=-1 \\\\ {x}_{2}+2{x}_{3} &=-2 \\\\ {x}_{3} &=-3\\end{aligned}\\right.\n$$\n\nThe third equation states that  ${x}_{3}=-3.$ Substituting this into the second equation,  we get\n\n$$\n{x}_{2}+2(-3)=-2\\,⟹\\,{x}_{2}=-2-2(-3)=-2+6=4.\n$$\n\nNow, we substitute ${x}_{3}=-3$ and ${x}_{2}=4$ into the first equation to get\n\n$$\n{x}_{1}+2(4)+3(-3)=-1\\,⟹\\,{x}_{1}=-1-8+9=0.\n$$\n\nTherefore, the solution is ${x}_{1}=0$, ${x}_{2}=4$, and ${x}_{3}=-3.$ In vector form, the solution can be written as\n$$\n\\begin{bmatrix}0 \\\\ 4 \\\\ -3\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186341889 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17c36b72-750e-5c7f-ad91-bdad5109f7d1" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-2,-4,2⟩" :db/id #edb/ref 17592186339340} {:answer/id #uuid "8b24a218-6be8-58af-bfe7-63d34cf55049" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,-5,2⟩" :db/id #edb/ref 17592186340374} {:answer/id #uuid "ba6a5985-c4e4-501c-bd9c-df10e65310f3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,-8,0⟩" :db/id #edb/ref 17592186340800} {:answer/id #uuid "d0616bd6-bb4a-5cdb-bd3c-870367740518" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,-3,-3⟩" :db/id #edb/ref 17592186340981} {:answer/id #uuid "de3f3be1-e22e-5bdb-b8b2-9307c1ead0c8" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-2,-1,-4⟩" :db/id #edb/ref 17592186341101}] :answer-field/correct {:db/id #edb/ref 17592186340374} :answer-field/id #uuid "ba68da74-f480-59c9-921c-8c2924f68134" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341705}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e6fb7638-5059-526d-b459-d78ea32e04f3" :question/math-academy-id "q-72972" :question/problem "Solve the system of equations represented by the augmented matrix \n\n$$\n\\begin{bmatrix}1 & 2 & 1 & -8 \\\\ 0 & 1 & 2 & -1 \\\\ 0 & 0 & 1 & 2\\end{bmatrix}.\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say, $x$, $y$, and $z.$ We obtain the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}x+2y+z &=-8 \\\\ y+2z &=-1 \\\\ z &=2\\end{aligned}\\right.\n$$\n\nThe third equation states that $z=2.$ Substituting this into the second equation, we get\n\n$$\ny+2(2)=-1\\,⟹\\,y=-1-4=-5.\n$$\n\nNow, we substitute $z=2$ and $y=-5$ into the first equation to get\n\n$$\nx+2(-5)+(2)=-8\\,⟹\\,x=-8+10-2=0.\n$$\n\nTherefore, the solution is $x=0$, $y=-5$, and $z=2.$ In vector form, the solution can be written as $⟨0,-5,2⟩.$"} {:db/id #edb/ref 17592186341890 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "444d5bf9-1a29-573b-a36c-8bb7ee2fc090" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 1 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186339730} {:answer/id #uuid "5f01a39b-f716-52fb-89c8-3b5d55542bbe" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186339973} {:answer/id #uuid "5f0fe301-86bb-5362-b978-ca470e7be8b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ -1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186339974} {:answer/id #uuid "9a70b1d5-6842-55c7-abe6-8f9f790a91c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186340520} {:answer/id #uuid "a8f72c1e-ac67-5647-b752-8c6b5f95519c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ -2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186340665}] :answer-field/correct {:db/id #edb/ref 17592186339974} :answer-field/id #uuid "68288679-f562-5113-9739-3e86bcb57900" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341561}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "56c99816-35f0-58d4-84c1-8bf6a92e3e72" :question/math-academy-id "q-72978" :question/problem "Solve the system of equations represented by the augmented matrix\n\n$$\n\\begin{bmatrix}1 & 1 & 4 & -3 \\\\ 0 & 1 & 3 & -4 \\\\ 0 & 0 & 1 & -1\\end{bmatrix}.\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say,  ${x}_{1}$, ${x}_{2}$, and ${x}_{3}.$ We obtain the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2}+4{x}_{3} &=-3 \\\\ {x}_{2}+3{x}_{3} &=-4 \\\\ {x}_{3} &=-1\\end{aligned}\\right.\n$$\n\nThe third equation states that  ${x}_{3}=-1.$ Substituting this into the second equation,  we get\n\n$$\n{x}_{2}+3(-1)=-4\\,⟹\\,{x}_{2}=-4+3=-1.\n$$\n\nNow, we substitute ${x}_{3}=-1$ and ${x}_{2}=-1$ into the first equation to get\n\n$$\n{x}_{1}+(-1)+4(-1)=-3\\,⟹\\,{x}_{1}=-3+1+4=2.\n$$\n\nTherefore, the solution is ${x}_{1}=2$, ${x}_{2}=-1$, and ${x}_{3}=-1.$ In vector form, the solution can be written as\n$$\n\\begin{bmatrix}2 \\\\ -1 \\\\ -1\\end{bmatrix}.\n$$"}] :knowledge-point/title "Solving a System of Equations Using Back Substitution Given an Augmented Matrix"} {:db/id #edb/ref 17592186096671 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096458 :question/id #uuid "7b44089c-8ca7-57e5-b390-7900647e3884" :question/math-academy-id "e-4692" :question/problem "Solve the system of equations that is represented by the augmented matrix\n\n$$\n\\left[\n\t\\begin{array}{ccc|c}2 & 1 & -1 & 0 \\\\ 0 & 1 & 1 & -2 \\\\ 0 & 0 & 3 & 3\\end{array} \n\t\\right].\n$$\n\n" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say, $x_1,$ $x_2,$ and $x_3.$ We obtain the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}2{x}_{1}+{x}_{2}-{x}_{3} &=0 \\\\ {x}_{2}+{x}_{3} &=-2 \\\\ 3{x}_{3} &=3\\end{aligned}\\right.\n$$\n\nThe third equation states that\n\n$$\n3x_3=3 \n\t\\qquad\\Longrightarrow\\qquad \n\tx_3=1.\n$$\n\nSubstituting this into the second equation, we get\n\n$$\nx_2+(1)=-2\n\t\\qquad\\Longrightarrow\\qquad\n\tx_2=-2-1=-3.\n$$\n\nNow, we substitute both $x_3 = 1$ and $x_2 = -3$ into the first equation to get\n\n$$\n2x_1+(-3)-(1) = 0\n\t\\qquad\\Longrightarrow\\qquad\n\tx_1 = \\dfrac{1}{2} (3 + 1) = 2.\n$$\n\nTherefore, the solution is $x_1 = 2,$ $x_2=-3,$ and $x_3 = 1.$ Or, in vector form, the solution is $\\langle 2,-3,1 \\rangle.$"} :knowledge-point/id #uuid "52e51c9a-6bce-5ea6-a9fe-febb09f8754d" :knowledge-point/questions [{:db/id #edb/ref 17592186096923 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8197a43-64ec-57b8-b1f6-ff9620a7d86f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 0 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186093513} {:answer/id #uuid "f66e0549-fa79-57be-a090-7daa7e6426b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 0 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186093514} {:answer/id #uuid "01f74554-aef4-5806-966f-8726c1c1e688" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -1 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186093515} {:answer/id #uuid "0b30b3a1-b02a-5349-8604-74c9b16742f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 2 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186093516} {:answer/id #uuid "767afba2-b10f-512c-89d3-c8fe22f7eb97" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 0 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186093517}] :answer-field/id #uuid "d0ce4428-7b3b-5989-b5e8-8d57a4360b63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186093512}] :question/id #uuid "404549b9-30ad-5005-8ba2-0b875f83cd7f" :question/math-academy-id "q-10202" :question/problem "Solve the system of equations represented by the augmented matrix:\n$$\n\\begin{bmatrix}1 & -1 & 1 & -1 \\\\ 0 & 2 & 1 & -3 \\\\ 0 & 0 & -1 & 3\\end{bmatrix}\n$$."} {:db/id #edb/ref 17592186096924 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "517c2b95-3278-5288-97a8-8f4ad7d12b85" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-15,40,-5⟩" :db/id #edb/ref 17592186236335} {:answer/id #uuid "58b90198-a181-5ca7-820a-0cb2ae4ad41b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-85,40,-5⟩" :db/id #edb/ref 17592186236375} {:answer/id #uuid "782c23fb-f476-55a3-962b-c00da83d7887" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-75,40,-5⟩" :db/id #edb/ref 17592186236570} {:answer/id #uuid "9af36a41-8158-5002-b336-bc334832f54b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-5,-10,5⟩" :db/id #edb/ref 17592186236790} {:answer/id #uuid "b734756b-8742-55f6-b6ab-d04424db9104" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-75,-10,-5⟩" :db/id #edb/ref 17592186236981}] :answer-field/correct {:db/id #edb/ref 17592186236570} :answer-field/id #uuid "746029b9-082c-5f33-9a0e-5b120cac1acc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237594}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5592cf72-9e61-50b5-9aec-b1921100f3dc" :question/math-academy-id "q-10204" :question/problem "Solve the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}x+2y-z &=10 \\\\ y+5z &=15 \\\\ -z &=5\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that \n\n$$\n-z=5\\,⟹\\,z=-5.\n$$\n\nSubstituting this into the second equation, we get\n\n$$\ny+5(-5)=15\\,⟹\\,y=15+25=40.\n$$\n\nNow, we substitute $z=-5$ and $y=40$ into the first equation to get\n\n$$\nx+2(40)-(-5)=10\\,⟹\\,x=10-80-5=-75.\n$$\n\nTherefore, the solution is $x=-75,y=40$ and $z=-5.$ In vector form, the solution can be written as $⟨-75,40,-5⟩.$"} {:db/id #edb/ref 17592186237870 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "603897b1-4a1d-5913-acb7-bb727537e7ed" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,-1,0⟩" :db/id #edb/ref 17592186236428} {:answer/id #uuid "86e751a8-5c2f-5932-a2ea-81d73e1e0410" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,-1,8⟩" :db/id #edb/ref 17592186236657} {:answer/id #uuid "9b68172b-23b4-5c0a-86bd-f06f58db0794" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,-2,0⟩" :db/id #edb/ref 17592186236791} {:answer/id #uuid "a453a509-aab6-55b5-ae2e-d64aef0bb03c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,1,-8⟩" :db/id #edb/ref 17592186236847} {:answer/id #uuid "c403432a-3ea4-55eb-ab6d-792922568851" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,-1,0⟩" :db/id #edb/ref 17592186237056}] :answer-field/correct {:db/id #edb/ref 17592186237056} :answer-field/id #uuid "52d1bc13-92cb-59a3-8ae0-f4728f10c30b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237547}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f51fa541-69ba-512e-9b86-f9dbb4dce8b1" :question/math-academy-id "q-10203" :question/problem "Solve the system of equations represented by the augmented matrix\n\n$$\n\\begin{bmatrix}2 & -2 & 1 & 8 \\\\ 0 & 1 & -1 & -1 \\\\ 0 & 0 & 1 & 0\\end{bmatrix}.\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say, $x$, $y$, and $z.$ We obtain the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}2x-2y+z &=8 \\\\ y-z &=-1 \\\\ z &=0\\end{aligned}\\right.\n$$\n\nThe third equation states that $z=0.$ Substituting this into the second equation, we get\n\n$$\ny-0=-1\\,⟹\\,y=-1.\n$$\n\nNow, we substitute $z=0$ and $y=-1$ into the first equation to get\n\n$$\n2x-2(-1)+(0)=8\\,⟹\\,x=\\frac{8-2}{2}=3.\n$$\n\nTherefore, the solution is $x=3$, $y=-1$, and $z=0.$ In vector form, the solution can be written as $⟨3,-1,0⟩.$"} {:db/id #edb/ref 17592186265751 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3055d150-0d1a-52cc-ae5b-19cf8e6d29d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{2} \\\\ -3 \\\\ -1\\end{bmatrix}." :db/id #edb/ref 17592186263410} {:answer/id #uuid "691201ef-c6c5-5f63-bd11-a328b8a1fab3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 3 \\\\ 1\\end{bmatrix}." :db/id #edb/ref 17592186263903} {:answer/id #uuid "6ce178d8-2d62-5394-bb04-c7bad40fb652" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 3 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186263938} {:answer/id #uuid "efd4d4ff-2c77-5667-9e4b-111960f6c85c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 3 \\\\ 1\\end{bmatrix}." :db/id #edb/ref 17592186265105} {:answer/id #uuid "f0e5cbd1-137f-5f8b-adf9-2abb641d4ba1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ -3 \\\\ -1\\end{bmatrix}." :db/id #edb/ref 17592186265115}] :answer-field/correct {:db/id #edb/ref 17592186263938} :answer-field/id #uuid "8abbe911-bfc0-50db-9d21-a97d6d7ecc16" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265492}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "767893ce-f15e-5dc3-ac2a-90c7bba1c030" :question/math-academy-id "q-129604" :question/problem "Solve the system of equations represented by the augmented matrix: \n\n$$\n\\begin{bmatrix}4 & 1 & 2 & -3 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & 0 & -1 & 1\\end{bmatrix}.\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say, $x$, $y$, and $z.$ We obtain the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}4x+y+2z &=-3 \\\\ y+3z &=0 \\\\ -z &=1\\end{aligned}\\right.\n$$\n\nThe third equation states that \n\n$$\n-z=1\\,⟹\\,z=-1.\n$$\n\nSubstituting this into the second equation, we get\n\n$$\ny+3(-1)=0\\,⟹\\,y=3.\n$$\n\nNow, we substitute $z=-1$ and $y=3$ into the first equation to get\n\n$$\n4x+(3)+2(-1)=-3\\,⟹\\,x=\\frac{-3-3+2}{4}=-1.\n$$\n\nTherefore, the solution is $x=-1$, $y=3$, and $z=-1.$ In vector form, the solution can be written as \n$$\n\\begin{bmatrix}-1 \\\\ 3 \\\\ -1\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186265752 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "104bd80b-99be-5b60-b3c6-c1da8374be84" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ -1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186263151} {:answer/id #uuid "28b6438e-8a75-5a80-979c-65c88c4b6ed0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 \\\\ -5 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186263351} {:answer/id #uuid "62bd08d1-d4b0-5b68-ab0e-8ee63de49e4c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 \\\\ -5 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186263853} {:answer/id #uuid "9839face-b425-5c66-9922-80db2823f455" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ -1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186264309} {:answer/id #uuid "bbfdb6ec-d675-5431-8123-9f6401f69b3e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186264632}] :answer-field/correct {:db/id #edb/ref 17592186263853} :answer-field/id #uuid "46e711a8-d744-599d-a5cc-41ec4a239291" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265378}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a5bd3a7f-0603-5a94-9bbf-0a46b897e249" :question/math-academy-id "q-129613" :question/problem "Solve the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}2{x}_{1}-{x}_{2}+4{x}_{3} &=-1 \\\\ {x}_{2}+2{x}_{3} &=-3 \\\\ -{x}_{3} &=-1\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that \n\n$$\n-{x}_{3}=-1\\,⟹\\,{x}_{3}=1.\n$$\n\n Substituting this into the second equation, we get\n\n$$\n{x}_{2}+2(1)=-3\\,⟹\\,{x}_{2}=-3-2=-5.\n$$\n\nNow, we substitute ${x}_{3}=1$ and ${x}_{2}=-5$ into the first equation to get\n\n$$\n2{x}_{1}-(-5)+4(1)=-1\\,⟹\\,{x}_{1}=\\frac{-1-5-4}{2}=-5.\n$$\n\nTherefore, the solution is \n${x}_{1}=-5$, ${x}_{2}=-5$, and ${x}_{3}=1.$  In vector form, the solution can be written as $$\n\\begin{bmatrix}-5 \\\\ -5 \\\\ 1\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186265753 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51c98f24-c563-528a-a6fd-00fbf4db6789" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-8 \\\\ -1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186263706} {:answer/id #uuid "74eb0c20-e6b1-5f0e-b5b5-bf0a4af84a4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 5 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186264015} {:answer/id #uuid "75bb0fd9-7bb4-5f84-a347-a78a5992eff7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ -1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186264025} {:answer/id #uuid "9a053451-5add-5650-bcf7-5efdda715c4a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-30 \\\\ 5 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186264319} {:answer/id #uuid "c7cccac8-3863-5bec-bd18-3c0f78b98198" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-8 \\\\ 1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186264748}] :answer-field/correct {:db/id #edb/ref 17592186264025} :answer-field/id #uuid "e73fb32c-a004-5fbe-9c18-83ea40a2c949" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265655}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "86f65392-52cb-532d-9e01-57782fdc15f5" :question/math-academy-id "q-129615" :question/problem "Solve the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+5{x}_{2}+{x}_{3} &=-1 \\\\ -{x}_{2}+3{x}_{3} &=7 \\\\ 2{x}_{3} &=4\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that \n\n$$\n2{x}_{3}=4\\,⟹\\,{x}_{3}=2.\n$$\n\n Substituting this into the second equation, we get\n\n$$\n-{x}_{2}+3(2)=7\\,⟹\\,{x}_{2}=6-7=-1.\n$$\n\nNow, we substitute ${x}_{3}=2$ and ${x}_{2}=-1$ into the first equation to get\n\n$$\n{x}_{1}+5(-1)+(2)=-1\\,⟹\\,{x}_{1}=-1+5-2=2.\n$$\n\nTherefore, the solution is \n${x}_{1}=2$, ${x}_{2}=-1$, and ${x}_{3}=2.$  In vector form, the solution can be written as $$\n\\begin{bmatrix}2 \\\\ -1 \\\\ 2\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186341891 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0193877c-1ccd-5276-b9e5-09b65801f01c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,3,-3⟩" :db/id #edb/ref 17592186339143} {:answer/id #uuid "4c1c9297-8467-595b-bdc0-d8097ac98404" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,-4,3⟩" :db/id #edb/ref 17592186339815} {:answer/id #uuid "a0330b8a-eef6-5686-a1a9-18be65748b1f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,4,-3⟩" :db/id #edb/ref 17592186340578} {:answer/id #uuid "dea8c28b-a5fd-5511-887e-2f25e7e67248" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,-3,3⟩" :db/id #edb/ref 17592186341106} {:answer/id #uuid "e0231c26-9b6f-5e2a-ac8e-51ddb757e3ba" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4,-3,3⟩" :db/id #edb/ref 17592186341119}] :answer-field/correct {:db/id #edb/ref 17592186341119} :answer-field/id #uuid "fc9b1b47-0c17-5478-b1a9-c7e848073796" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341829}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d6ce04cb-fc7f-5c70-94bf-242e6df7387a" :question/math-academy-id "q-72980" :question/problem "Solve the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}2x+y-z &=2 \\\\ y+3z &=6 \\\\ -z &=-3\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that\n\n$$\n-z=-3\\,⟹\\,z=3.\n$$\n\nSubstituting this into the second equation, we get\n\n$$\ny+3(3)=6\\,⟹\\,y=6-9=-3.\n$$\n\nNow, we substitute $z=3$ and $y=-3$ into the first equation to get \n\n$$\n2x+(-3)-(3)=2\\,⟹\\,x=\\frac{1}{2}(2+3+3)=4.\n$$\n\nTherefore, the solution is $x=4$, $y=-3$ and $z=3.$ In vector form, the solution can be written as $⟨4,-3,3⟩.$"} {:db/id #edb/ref 17592186341892 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "165ea2fd-41c0-5400-b24b-77486a19a825" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 4 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186339326} {:answer/id #uuid "67ae6eb0-f860-56b5-a08f-2f5623a97b3e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 1 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186340049} {:answer/id #uuid "bf55a7f8-3683-5adc-8cf6-442d5d29a568" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 2 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186340833} {:answer/id #uuid "ddecb468-7ba6-5116-8ff8-2b5e7fe02d0c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ 1 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186341099} {:answer/id #uuid "ecf0aed3-bba1-520d-802b-6e0413c2d5b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 1 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186341217}] :answer-field/correct {:db/id #edb/ref 17592186341099} :answer-field/id #uuid "d7e5e5a9-3bd5-5992-93ff-7ad964a75306" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341761}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "41fa8809-57ef-578c-b39f-9d0b73e06f90" :question/math-academy-id "q-72981" :question/problem "Solve the system of equations represented by the augmented matrix: \n\n$$\n\\begin{bmatrix}1 & 0 & 1 & 2 \\\\ 0 & 3 & 2 & -1 \\\\ 0 & 0 & -1 & 2\\end{bmatrix}.\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say, $x$, $y$, and $z.$ We obtain the following system of linear equations: \n\n$$\n\\left\\{\\begin{aligned}x+z &=2 \\\\ 3y+2z &=-1 \\\\ -z &=2\\end{aligned}\\right.\n$$\n\nThe third equation states that\n\n$$\n-z=2\\,⟹\\,z=-2.\n$$\n\nSubstituting this into the second equation, we get\n\n$$\n3y+2(-2)=-1\\,⟹\\,y=\\frac{1}{3}(-1+4)=1.\n$$\n\nNow, we substitute $z=-2$ and $y=1$ into the first equation to get\n\n$$\nx+(-2)=2\\,⟹\\,x=2+2=4.\n$$\n\nTherefore, the solution is $x=4$, $y=1$, and $z=-2.$ In vector form, the solution can be written as \n$$\n\\begin{bmatrix}4 \\\\ 1 \\\\ -2\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186341893 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "368d6f09-f86f-5a1f-934f-edb2ada2ecdb" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,\\frac{1}{2},1⟩" :db/id #edb/ref 17592186339616} {:answer/id #uuid "4016e3b4-303c-5e7d-bc9c-f626ddc0e67a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,-1,\\frac{1}{2}⟩" :db/id #edb/ref 17592186339702} {:answer/id #uuid "5a087a29-e907-5bbd-8024-d1c0e3d6066a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,\\frac{1}{2},\\frac{1}{2}⟩" :db/id #edb/ref 17592186339946} {:answer/id #uuid "7f49b16e-bca9-5992-802b-f9800e9b025a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,\\frac{1}{2},-1⟩" :db/id #edb/ref 17592186340272} {:answer/id #uuid "b28c83dc-7bea-5c71-a4cc-8b4d73503adb" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{1}{2},\\frac{1}{2},-1⟩" :db/id #edb/ref 17592186340752}] :answer-field/correct {:db/id #edb/ref 17592186339946} :answer-field/id #uuid "7d72ac37-7d4a-57f8-a026-426aa0ba98f8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341600}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6577a967-44f3-50e6-9603-cd6d17cab94e" :question/math-academy-id "q-72983" :question/problem "Solve the system of equations represented by the augmented matrix\n\n$$\n\\begin{bmatrix}2 & 1 & 1 & -1 \\\\ 0 & 1 & 1 & 1 \\\\ 0 & 0 & 2 & 1\\end{bmatrix}.\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say, $x$, $y$, and $z.$ We obtain the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}2x+y+z &=-1 \\\\ y+z &=1 \\\\ 2z &=1\\end{aligned}\\right.\n$$\n\nThe third equation states that\n \n\n$$\n2z=1\\,⟹\\,z=\\frac{1}{2}.\n$$\n\nSubstituting this into the second equation, we get\n\n$$\ny+(\\frac{1}{2})=1\\,⟹\\,y=1-\\frac{1}{2}=\\frac{1}{2}.\n$$\n\nNow, we substitute $z=y=\\frac{1}{2}$  into the first equation to get\n\n$$\n2x+(\\frac{1}{2})+(\\frac{1}{2})=-1\\,⟹\\,x=\\frac{1}{2}(-1-\\frac{1}{2}-\\frac{1}{2})=-1.\n$$\n\nTherefore, the solution is $x=-1$, $y=\\frac{1}{2}$, and $z=\\frac{1}{2}.$ In vector form, the solution can be written as $⟨-1,\\frac{1}{2},\\frac{1}{2}⟩.$"}] :knowledge-point/title "Solving a System of Equations Given an Augmented Matrix Containing Non-Unit Leading Entries"}] :topic/math-academy-id 1047 :topic/next [{:db/id #edb/ref 17592186049088} {:db/id #edb/ref 17592186049370} {:db/id #edb/ref 17592186049422} {:db/id #edb/ref 17592186049445}] :topic/title "Solving Systems of Equations Using Back Substitution"}
