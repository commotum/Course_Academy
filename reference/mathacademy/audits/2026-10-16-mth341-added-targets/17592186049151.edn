0c208a50961" :answer/type {:db/ident :answer.type/math} :answer/value "a=-1,\\,b=2,\\,c=1" :db/id #edb/ref 17592186237055} {:answer/id #uuid "ef6c207b-ce5d-57b0-82bc-7b3988df6723" :answer/type {:db/ident :answer.type/math} :answer/value "a=1,\\,b=1,\\,c=-3" :db/id #edb/ref 17592186237330} {:answer/id #uuid "f669d9e4-9bbe-5b98-a671-93ce001f7f05" :answer/type {:db/ident :answer.type/math} :answer/value "a=1,\\,b=1,\\,c=1" :db/id #edb/ref 17592186237372}] :answer-field/correct {:db/id #edb/ref 17592186237372} :answer-field/id #uuid "16abb40e-e765-53e3-90ea-7a181a9af49c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237465}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9047fc55-30cd-5bc7-96fe-e8f5b01aa182" :question/math-academy-id "q-10004" :question/problem "The system of equations\n\n$$\n\\left\\{\\begin{aligned}y+2z &=0 \\\\ x+2y+3z &=2 \\\\ 3x+y+z &=-3\\end{aligned}\\right.\n$$\n\ncan be represented using matrix notation as\n\n$$\n\\begin{bmatrix}0 & a & 2 \\\\ b & 2 & 3 \\\\ 3 & 1 & c\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 2 \\\\ -3\\end{bmatrix}.\n$$\n\nWhat are the values of $a,b$ and $c?$" :question/worked-solution "First, let's write the system so that $x$, $y$, and $z$ appear in each equation:\n\n$$\n\\left\\{\\begin{aligned}0x+y+2z &=0 \\\\ x+2y+3z &=2 \\\\ 3x+y+z &=-3\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}0 & 1 & 2 \\\\ 1 & 2 & 3 \\\\ 3 & 1 & 1\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}0 \\\\ 2 \\\\ -3\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}0 & 1 & 2 \\\\ 1 & 2 & 3 \\\\ 3 & 1 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 2 \\\\ -3\\end{bmatrix}.\n$$\n\nTherefore, $a=1,\\,b=1,\\,c=1.$"} {:db/id #edb/ref 17592186265929 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "261340b2-1a0d-59dd-8b7b-76c4f7bfb121" :answer/type {:db/ident :answer.type/math} :answer/value "a=4,\\,b=-3,\\,c=1" :db/id #edb/ref 17592186263331} {:answer/id #uuid "3823e286-9476-5d05-a64b-0bd2a3d821f5" :answer/type {:db/ident :answer.type/math} :answer/value "a=4,\\,b=-1,\\,c=1" :db/id #edb/ref 17592186263509} {:answer/id #uuid "6457994c-cd91-5a4c-915f-080f701162d6" :answer/type {:db/ident :answer.type/math} :answer/value "a=-1,\\,b=-5,\\,c=9" :db/id #edb/ref 17592186263869} {:answer/id #uuid "aa7ea0e9-94d6-53d4-928a-c09488c89e60" :answer/type {:db/ident :answer.type/math} :answer/value "a=2,\\,b=-3,\\,c=1" :db/id #edb/ref 17592186264456} {:answer/id #uuid "fa260fff-d100-5b94-a5b3-239f605d176d" :answer/type {:db/ident :answer.type/math} :answer/value "a=2,\\,b=-7,\\,c=-1" :db/id #edb/ref 17592186265190}] :answer-field/correct {:db/id #edb/ref 17592186263331} :answer-field/id #uuid "a814f1c0-7e30-52d3-b5a0-1628f163bffe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265547}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "585d1fdd-e4b6-5cfa-bfaf-54e4bf0c7de2" :question/math-academy-id "q-130535" :question/problem "The system of equations\n\n$$\n\\left\\{\\begin{aligned}2x-5y+z &=1 \\\\ -x-3y+9z &=-2 \\\\ 4x-7y-z &=5\\end{aligned}\\right.\n$$\n\ncan be represented using matrix notation as\n\n$$\n\\begin{bmatrix}2 & -5 & c \\\\ -1 & b & 9 \\\\ a & -7 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -2 \\\\ 5\\end{bmatrix}.\n$$\n\nWhat are the values of $a,b$ and $c?$" :question/worked-solution "We can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}2 & -5 & 1 \\\\ -1 & -3 & 9 \\\\ 4 & -7 & -1\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}1 \\\\ -2 \\\\ 5\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}2 & -5 & 1 \\\\ 1 & -3 & 9 \\\\ 4 & -7 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -2 \\\\ 5\\end{bmatrix}.\n$$\n\nTherefore, $a=4,\\,b=-3,\\,c=1.$"} {:db/id #edb/ref 17592186265930 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61b6213e-6630-5cbc-a2be-bba26537e9d3" :answer/type {:db/ident :answer.type/math} :answer/value "a=-3,\\,b=1,\\,c=2" :db/id #edb/ref 17592186263842} {:answer/id #uuid "98683e89-44c4-5b63-a6a0-5143070e1a4e" :answer/type {:db/ident :answer.type/math} :answer/value "a=-4,\\,b=8,\\,c=-3" :db/id #edb/ref 17592186264311} {:answer/id #uuid "a16f2ca2-4f2e-5acc-9b55-06d4bbfa6420" :answer/type {:db/ident :answer.type/math} :answer/value "a=0,\\,b=8,\\,c=1" :db/id #edb/ref 17592186264374} {:answer/id #uuid "dc08dfd2-1ae1-53cb-adad-40873d7ac878" :answer/type {:db/ident :answer.type/math} :answer/value "a=1,\\,b=7,\\,c=8" :db/id #edb/ref 17592186264916} {:answer/id #uuid "f9db3e03-47ba-53e0-8851-1e7f8c0aa7b5" :answer/type {:db/ident :answer.type/math} :answer/value "a=-6,\\,b=8,\\,c=5" :db/id #edb/ref 17592186265185}] :answer-field/correct {:db/id #edb/ref 17592186265185} :answer-field/id #uuid "21ecd5d5-730f-53a8-b7fd-5892a28e6ac7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265304}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "718180b1-bf73-575f-add7-0f6c8d9bba0d" :question/math-academy-id "q-130536" :question/problem "The system of equations\n\n$$\n\\left\\{\\begin{aligned}-3x+y+7z &=5 \\\\ x-4y+8z &=1 \\\\ -6y+9z &=2\\end{aligned}\\right.\n$$\n\ncan be represented using matrix notation as\n\n$$\n\\begin{bmatrix}-3 & 1 & 7 \\\\ 1 & -4 & b \\\\ 0 & a & 9\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}c \\\\ 1 \\\\ 2\\end{bmatrix}.\n$$\n\nWhat are the values of $a,b,$ and $c?$" :question/worked-solution "First, let's write the system so that $x$, $y$, and $z$ appear in each equation:\n\n$$\n\\left\\{\\begin{aligned}-3x+y+7z &=5 \\\\ x-4y+8z &=1 \\\\ 0x-6y+9z &=2\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}-3 & 1 & 7 \\\\ 1 & -4 & 8 \\\\ 0 & -6 & 9\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}5 \\\\ 1 \\\\ 2\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}-3 & 1 & 7 \\\\ 1 & -4 & 8 \\\\ 0 & -6 & 9\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}5 \\\\ 1 \\\\ 2\\end{bmatrix}.\n$$\n\nTherefore, $a=-6,\\,b=8,\\,c=5.$"} {:db/id #edb/ref 17592186292857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "505018d9-5f40-5fe6-a2bd-8371d403497f" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186290974}] :answer-field/correct {:db/id #edb/ref 17592186290974} :answer-field/id #uuid "31adadd0-5d60-5f06-b25f-16789378a818" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186291902} {:answer-field/choices [{:answer/id #uuid "d591b4c2-08ff-5aaa-b44a-f770b77524f0" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186291529}] :answer-field/correct {:db/id #edb/ref 17592186291529} :answer-field/id #uuid "4fcd008a-d164-500a-b986-f81a0ace138f" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186291982} {:answer-field/choices [{:answer/id #uuid "50e80a16-e3c8-55c9-9435-066d6712c90c" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/re