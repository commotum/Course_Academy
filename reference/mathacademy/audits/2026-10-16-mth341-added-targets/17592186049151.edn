,\n\n$$\nb=\\begin{bmatrix}11 \\\\ 0 \\\\ -9\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}1 & -1 & 1 \\\\ -1 & -3 & -1 \\\\ 8 & 6 & 3\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}11 \\\\ 0 \\\\ -9\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186299541 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15606937-2001-5eda-8fd8-0aec577c3cd4" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186297641}] :answer-field/correct {:db/id #edb/ref 17592186297641} :answer-field/id #uuid "0f345d07-59ac-55b2-9277-71d076aff9fa" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298690} {:answer-field/choices [{:answer/id #uuid "11c5941e-9b07-5ec9-b841-45fd102d4cf6" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186297634}] :answer-field/correct {:db/id #edb/ref 17592186297634} :answer-field/id #uuid "200acfe2-cd90-55c7-b151-c282996efe43" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298745} {:answer-field/choices [{:answer/id #uuid "53e52476-8892-5f50-a61a-28a39743fb00" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186297907}] :answer-field/correct {:db/id #edb/ref 17592186297907} :answer-field/id #uuid "5794374e-f27f-58cf-93a8-b3344b4eb40e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298934} {:answer-field/choices [{:answer/id #uuid "4994cdbd-3ed5-5244-9cc2-71505a994d0f" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186297851}] :answer-field/correct {:db/id #edb/ref 17592186297851} :answer-field/id #uuid "7059c13b-19a6-5d07-bf6d-c5fbf0b582c8" :answer-field/key "