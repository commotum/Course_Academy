\\\\ 2 & -2 & 0\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}2 \\\\ 5 \\\\ -1\\end{bmatrix}.\n$$\n\nTherefore, $a=1,\\,b=-2,\\,c=0.$"} {:db/id #edb/ref 17592186345096 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "899af756-e049-505b-aca8-fcddbcc599a6" :answer/type {:db/ident :answer.type/math} :answer/value "a=-1,\\,b=1,\\,c=-1" :db/id #edb/ref 17592186343433} {:answer/id #uuid "9934f80a-4330-52c3-b892-b8e6146150ba" :answer/type {:db/ident :answer.type/math} :answer/value "a=-1,\\,b=2,\\,c=3" :db/id #edb/ref 17592186343586} {:answer/id #uuid "a628bb7b-ab3e-5568-a237-263714a782db" :answer/type {:db/ident :answer.type/math} :answer/value "a=0,\\,b=2,\\,c=3" :db/id #edb/ref 17592186343701} {:answer/id #uuid "c77edf43-1b15-5283-9e68-19790d9e948c" :answer/type {:db/ident :answer.type/math} :answer/value "a=1,\\,b=2,\\,c=3" :db/id #edb/ref 17592186343990} {:answer/id #uuid "d9de4d48-ae2a-5b5a-848b-ea2b298a17cc" :answer/type {:db/ident :answer.type/math} :answer/value "a=0,\\,b=1,\\,c=-1" :db/id #edb/ref 17592186344150}] :answer-field/correct {:db/id #edb/ref 17592186343701} :answer-field/id #uuid "063b5447-f723-563a-b519-b068df6762ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344505}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c8162803-a4d6-5f94-9721-2c47db8e7ec4" :question/math-academy-id "q-75506" :question/problem "The system of equations\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}-y+z &=1 \\\\ 2z+y+x &=-1 \\\\ 3y-z+x &=1\\end{aligned}\\right.\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n$$\n\\begin{bmatrix}a & -1 & 1 \\\\ 1 & 1 & b \\\\ 1 & c & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}.\n$$\n\nWhat are the values of $a,b$ and $c?$" :question/worked-solution "First, let's write the system so that $x$, $y$, and $z$ appear in each equation in the correct order and all constants are on the right-hand side of the system:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}0x-y+z &=1 \\\\ x+y+2z &=-1 \\\\ x+3y-z &=1\\end{aligned}\\right.\\end{aligned}\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}0 & -1 & 1 \\\\ 1 & 1 & 2 \\\\ 1 & 3 & -1\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}0 & -1 & 1 \\\\ 1 & 1 & 2 \\\\ 1 & 3 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}.\n$$\n\nTherefore, $a=0,\\,b=2,\\,c=3.$"} {:db/id #edb/ref 17592186345098 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "000413bf-9748-547e-b2b7-f51e9ca2b6c3" :answer/type {:db/ident :answer.type/math} :answer/value "a=-5,\\,b=0,\\,c=-3" :db/id #edb/ref 17592186342244} {:answer/id #uuid "1b0fade5-5567-5f2b-8bd1-bcd19798e317" :answer/type {:db/ident :answer.type/math} :answer/value "a=-5,\\,b=-3,\\,c=-3" :db/id #edb/ref 17592186342470} {:answer/id #uuid "81a6d8ab-d7b4-5a09-98ef-6f85479e660e" :answer/type {:db/ident :answer.type/math} :answer/value "a=2,\\,b=-3,\\,c=-1" :db/id #edb/ref 17592186343351} {:answer/id #uuid "d5456c1d-bb91-5f95-a7d8-c3fa889f1ce0" :answer/type {:db/ident :answer.type/math} :answer/value "a=2,\\,b=1,\\,c=-1" :db/id #edb/ref 17592186344107} {:answer/id #uuid "fa0eedd2-0524-51f1-b9ed-36101f5e4872" :answer/type {:db/ident :answer.type/math} :answer/value "a=2,\\,b=0,\\,c=-1" :db/id #edb/ref 17592186344437}] :answer-field/correct {:db/id #edb/ref 17592186344437} :answer-field/id #uuid "11e38925-0839-58ca-8bc3-5e74d9c6effa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344526}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "48c6e4a4-32de-5c7d-8a20-ab1e8b1328a5" :question/math-academy-id "q-75509" :question/problem "The system of equations\n\n$$\n\\left\\{\\begin{aligned}2y-5x+3z &=-1 \\\\ x-3y &=3 \\\\ -3y+2z-x &=-5\\end{aligned}\\right.\n$$\n\ncan be represented using matrix notation as\n\n$$\n\\begin{bmatrix}-5 & a & 3 \\\\ 1 & -3 & b \\\\ c & -3 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 3 \\\\ -5\\end{bmatrix}.\n$$\n\nWhat are the values of $a,b$ and $c?$" :question/worked-solution "First, let's write the system so that $x$, $y$, and $z$ appear in each equation in the correct order and all constants are on the right-hand side of the system:\n\n$$\n\\left\\{\\begin{aligned}-5x+2y+3z &=-1 \\\\ x-3y+0z &=3 \\\\ -x-3y+2z &=-5\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}-5 & 2 & 3 \\\\ 1 & -3 & 0 \\\\ -1 & -3 & 2\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}-1 \\\\ 3 \\\\ -5\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}-5 & 2 & 3 \\\\ 1 & -3 & 0 \\\\ -1 & -3 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 3 \\\\ -5\\end{bmatrix}.\n$$\n\nTherefore, $a=2,\\,b=0,\\,c=-1.$"} {:db/id #edb/ref 17592186345099 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "242eed25-2904-5ca4-80ef-4f7060273677" :answer/type {:db/ident :answer.type/math} :answer/value "a=-1,\\,b=2,\\,c=2" :db/id #edb/ref 17592186342543} {:answer/id #uuid "5cecd9df-aff2-5ccb-b7b3-35d0773eb201" :answer/type {:db/ident :answer.type/math} :answer/value "a=-1,\\,b=-2,\\,c=2" :db/id #edb/ref 17592186343017} {:answer/id #uuid "645b3f6e-ed98-55a3-a132-5ba341025383" :answer/type {:db/ident :answer.type/math} :answer/value "a=-1,\\,b=3,\\,c=-1" :db/id #edb/ref 17592186343090} {:answer/id #uuid "dabcf268-dd48-510a-89a0-e4618a799b85" :answer/type {:db/ident :answer.type/math} :answer/value "a=-1,\\,b=3,\\,c=2" :db/id #edb/ref 17592186344160} {:answer/id #uuid "df043853-12bc-536f-96e6-2000062b5852" :answer/type {:db/ident :answer.type/math} :answer/value "a=-1,\\,b=-2,\\,c=-1" :db/id #edb/ref 17592186344194}] :answer-field/correct {:db/id #edb/ref 17592186343017} :answer-field/id #uuid "a9f714bc-45c8-50c4-a185-a679cad7c796" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344789}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "44c191cc-5551-5e7a-ae21-977f62761f09" :question/math-academy-id "q-75511" :question/problem "The system of equations\n\n$$\n\\left\\{\\begin{aligned}-2x+y+z &=-1 \\\\ z+3x-2y &=3 \\\\ -y+2z-x &=-4\\end{aligned}\\right.\n$$\n\ncan be represented using matrix notation as\n\n$$\n\\begin{bmatrix}-2 & 1 & 1 \\\\ 3 & b & 1 \\\\ -1 & -1 & c\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}a \\\\ 3 \\\\ -4\\end{bmatrix}.\n$$\n\nWhat are the values of $a,b$ and $c?$" :question/worked-solution "First, let's write the system so that $x$, $y$, and $z$ appear in each equation in the correct order and all constants are on the right-hand side of the system:\n\n$$\n\\left\\{\\begin{aligned}-2x+y+z &=-1 \\\\ 3x-2y+z &=3 \\\\ -x-y+2z &=-4\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}-2 & 1 & 1 \\\\ 3 & -2 & 1 \\\\ -1 & -1 & 2\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}-1 \\\\ 3 \\\\ -4\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}-2 & 1 & 1 \\\\ 3 & -2 & 1 \\\\ -1 & -1 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 3 \\\\ -4\\end{bmatrix}.\n$$\n\nTherefore, $a=-1,\\,b=-2,\\,c=2.$"} {:db/id #edb/ref 17592186345100 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "005e6ee0-d7cb-5738-ae39-b5d2d1580ad4" :answer/type {:db/ident :answer.type/math} :answer/value "a=-2,\\,b=-4,\\,c=-6" :db/id #edb/ref 17592186342246} {:answer/id #uuid "2e17c4b2-6d1b-54c4-a89d-8a759ebb2422" :answer/type {:db/ident :answer.type/math} :answer/value "a=-5,\\,b=-4,\\,c=-6" :db/id #edb/ref 17592186342626} {:answer/id #uuid "4f2c527d-e0f0-5896-96f2-0cd5e491c789" :answer/type {:db/ident :answer.type/math} :answer/value "a=-5,\\,b=-1,\\,c=-6" :db/id #edb/ref 17592186342892} {:answer/id #uuid "f13926d9-9e95-5b3a-99b6-69e32a8e1dfc" :answer/type {:db/ident :answer.type/math} :answer/value "a=5,\\,b=4,\\,c=-6" :db/id #edb/ref 17592186344360} {:answer/id #uuid "f70635bc-4651-5822-b75c-f7dabbddcddf" :answer/type {:db/ident :answer.type/math} :answer/value "a=-2,\\,b=-1,\\,c=-6" :db/id #edb/ref 17592186344413}] :answer-field/correct {:db/id #edb/ref 17592186342246} :answer-field/id #uuid "040f2a1e-75fd-54e4-b831-d71e33d152c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344501}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a3ed22e6-6cd3-5798-bf97-54dcbca1e0d4" :question/math-academy-id "q-75512" :question/problem "The system of equations\n\n$$\n\\left\\{\\begin{aligned}-2z+x-5y &=1 \\\\ -y+5z-4x &=-2 \\\\ 2x-6y-z &=2\\end{aligned}\\right.\n$$\n\ncan be represented using matrix notation as\n\n$$\n\\begin{bmatrix}1 & -5 & a \\\\ b & -1 & 5 \\\\ 2 & c & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -2 \\\\ 2\\end{bmatrix}.\n$$\n\nWhat are the values of $a,b$ and $c?$" :question/worked-solution "First, let's write the system so that $x$, $y$, and $z$ appear in each equation in the correct order and all constants are on the right-hand side of the system:\n\n$$\n\\left\\{\\begin{aligned}x-5y-2z &=1 \\\\ -4x-y+5z &=-2 \\\\ 2x-6y-z &=2\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}1 & -5 & -2 \\\\ -4 & -1 & 5 \\\\ 2 & -6 & -1\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}1 \\\\ -2 \\\\ 2\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}1 & -5 & -2 \\\\ -4 & -1 & 5 \\\\ 2 & -6 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -2 \\\\ 2\\end{bmatrix}.\n$$\n\nTherefore, $a=-2,\\,b=-4,\\,c=-6.$"} {:db/id #edb/ref 17592186345101 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "166cdc43-cd77-526d-85cf-309ac949eb8a" :answer/type {:db/ident :answer.type/math} :answer/value "a=2,\\,b=1,\\,c=-2" :db/id #edb/ref 17592186342439} {:answer/id #uuid "42054b53-71b8-5ec2-9974-a15fb828e13b" :answer/type {:db/ident :answer.type/math} :answer/value "a=2,\\,b=0,\\,c=-2" :db/id #edb/ref 17592186342785} {:answer/id #uuid "89f56e7d-8662-5139-ab28-b50563bffbeb" :answer/type {:db/ident :answer.type/math} :answer/value "a=2,\\,b=2,\\,c=-2" :db/id #edb/ref 17592186343437} {:answer/id #uuid "9ab6f792-65fa-5dc6-9eb8-333815a87982" :answer/type {:db/ident :answer.type/math} :answer/value "a=-5,\\,b=-1,\\,c=-2" :db/id #edb/ref 17592186343602} {:answer/id #uuid "b9f3f277-df12-5890-bc9f-b7ba1b913a2e" :answer/type {:db/ident :answer.type/math} :answer/value "a=-5,\\,b=0,\\,c=-2" :db/id #edb/ref 17592186343870}] :answer-field/correct {:db/id #edb/ref 17592186342439} :answer-field/id #uuid "d65c1599-d6ec-51b9-ac08-a4498aa7999b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344863}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0508a871-572c-5538-b5f6-f882422cda62" :question/math-academy-id "q-75513" :question/problem "The system of equations\n\n$$\n\\left\\{\\begin{aligned}z-5x+2y &=0 \\\\ z &=1-2x \\\\ 7y-3x-2z &=0\\end{aligned}\\right.\n$$\n\ncan be represented using matrix notation as\n\n$$\n\\begin{bmatrix}-5 & a & 1 \\\\ 2 & 0 & 1 \\\\ -3 & 7 & c\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}0 \\\\ b \\\\ 0\\end{bmatrix}.\n$$\n\nWhat are the values of $a,b$ and $c?$" :question/worked-solution "First, let's write the system so that $x$, $y$, and $z$ appear in each equation in the correct order and all constants are on the right-hand side of the system:\n\n$$\n\\left\\{\\begin{aligned}-5x+2y+z &=0 \\\\ 2x+0y+z &=1 \\\\ -3x+7y-2z &=0\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}-5 & 2 & 1 \\\\ 2 & 0 & 1 \\\\ -3 & 7 & -2\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}-5 & 2 & 1 \\\\ 2 & 0 & 1 \\\\ -3 & 7 & -2\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}.\n$$\n\nTherefore, $a=2,\\,b=1,\\,c=-2.$"} {:db/id #edb/ref 17592186360768 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dc7bfb2-2de4-5825-9ad1-7d1cca5c1673" :answer/type {:db/ident :answer.type/math} :answer/value "a=1,\\,b=2,\\,c=-3" :db/id #edb/ref 17592186357864} {:answer/id #uuid "2e119460-b615-5584-b834-96ed6a634d45" :answer/type {:db/ident :answer.type/math} :answer/value "a=1,\\,b=6,\\,c=2" :db/id #edb/ref 17592186358166} {:answer/id #uuid "40f48421-b4d5-510e-a696-56a31fba8676" :answer/type {:db/ident :answer.type/math} :answer/value "a=3,\\,b=-1,\\,c=-2" :db/id #edb/ref 17592186358302} {:answer/id #uuid "4b96e53e-09ae-5fec-8b1d-15b0b47f2745" :answer/type {:db/ident :answer.type/math} :answer/value "a=-1,\\,b=6,\\,c=-3" :db/id #edb/ref 17592186358403} {:answer/id #uuid "601832e1-0bd0-529a-9f76-558c73116ef6" :answer/type {:db/ident :answer.type/math} :answer/value "a=-1,\\,b=6,\\,c=3" :db/id #edb/ref 17592186358592}] :answer-field/correct {:db/id #edb/ref 17592186358403} :answer-field/id #uuid "3ee2810a-7014-5a58-9251-1f7a6f92a507" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360084}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b4913b2d-3ba5-5e48-86c0-076ebc0464a0" :question/math-academy-id "q-9720" :question/problem "The system of equations\n\n$$\n\\left\\{\\begin{aligned}y+2z-x &=1 \\\\ 6y+3x-2z &=2 \\\\ x+3z-y &=-3\\end{aligned}\\right.\n$$\n\ncan be represented using matrix notation as\n\n$$\n\\begin{bmatrix}a & 1 & 2 \\\\ 3 & b & -2 \\\\ 1 & -1 & 3\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 2 \\\\ c\\end{bmatrix}.\n$$\n\nWhat are the values of $a,b$ and $c?$" :question/worked-solution "First, let's write the system so that $x$, $y$, and $z$ appear in each equation in the correct order and all constants are on the right-hand side of the system:\n\n$$\n\\left\\{\\begin{aligned}-x+y+2z &=1 \\\\ 3x+6y-2z &=2 \\\\ x-y+3z &=-3\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}-1 & 1 & 2 \\\\ 3 & 6 & -2 \\\\ 1 & -1 & 3\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}1 \\\\ 2 \\\\ -3\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}-1 & 1 & 2 \\\\ 3 & 6 & -2 \\\\ 1 & -1 & 3\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 2 \\\\ -3\\end{bmatrix}.\n$$\n\nTherefore, $a=-1,\\,b=6,\\,c=-3.$"} {:db/id #edb/ref 17592186426756 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f600605e-c432-5a49-8937-87085525ad30" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186426743}] :answer-field/correct {:db/id #edb/ref 17592186426743} :answer-field/id #uuid "28353e39-acc8-5471-9aa6-69d0698d44c5" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186426745} {:answer-field/choices [{:answer/id #uuid "e1bb35e7-e173-5077-9b70-1eca4b1960a8" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186426740}] :answer-field/correct {:db/id #edb/ref 17592186426740} :answer-field/id #uuid "858e4e65-7369-5bb6-9760-59c91beb24f5" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186426752} {:answer-field/choices [{:answer/id #uuid "0e1d1b7d-645c-539e-8352-b3dfb9ffcd03" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186426728}] :answer-field/correct {:db/id #edb/ref 17592186426728} :answer-field/id #uuid "a0491ce2-8d7c-51ed-99a4-858a23cff123" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186426753} {:answer-field/choices [{:answer/id #uuid "1b7db70e-4c06-5847-ae4c-8d2d12c80e8b" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186426730}] :answer-field/correct {:db/id #edb/ref 17592186426730} :answer-field/id #uuid "d7de047a-a7eb-5fa7-82bc-f250f9e7cda3" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186426754}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5bfaecd0-980e-55a7-befc-289a7a9c5c34" :question/math-academy-id "q-317636" :question/problem "The system of equations\n\n$$\n\\left\\{\\begin{aligned}2z+3x-5 &=4 \\\\ 6z-4y+3 &=15 \\\\ 7y+2x-2 &=11\\end{aligned}\\right.\n$$\n\n \n\ncan be represented using matrix notation as\n\n|  |  | $3$ | $0$ | {{field-1}} |  |  |  | $x$ |  |  |  | {{field-2}} |  |  |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  |  | {{field-3}} | $-4$ | $6$ |  |  |  | $y$ |  | $=$ |  | $12$ |  | . |\n|  |  | $2$ | {{field-4}} | $0$ |  |  |  | $z$ |  |  |  | $13$ |  |  |" :question/worked-solution "First, let's write the system so that $x$, $y$, and $z$ appear in each equation in the correct order and all constants are on the right-hand side of the system:\n\n$$\n\\left\\{\\begin{aligned}3x+0y+2z &=9 \\\\ 0x-4y+6z &=12 \\\\ 2x+7y+0z &=13\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}3 & 0 & 2 \\\\ 0 & -4 & 6 \\\\ 2 & 7 & 0\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}9 \\\\ 12 \\\\ 13\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}3 & 0 & 2 \\\\ 0 & -4 & 6 \\\\ 2 & 7 & 0\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}9 \\\\ 12 \\\\ 13\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186426757 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8600538f-009c-502c-8f93-c0f999bc2b02" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186426734}] :answer-field/correct {:db/id #edb/ref 17592186426734} :answer-field/id #uuid "3858435e-6d82-5994-86f0-620119922670" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186426746} {:answer-field/choices [{:answer/id #uuid "11aba24b-9268-590e-8810-5c57e7e3c410" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186426729}] :answer-field/correct {:db/id #edb/ref 17592186426729} :answer-field/id #uuid "3dca1250-a568-5b14-aa99-ede3c01994fe" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186426747} {:answer-field/choices [{:answer/id #uuid "d3575d9f-b5c1-5e4f-8e61-3fb7541222f0" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186426738}] :answer-field/correct {:db/id #edb/ref 17592186426738} :answer-field/id #uuid "58b5d536-1639-5442-8db5-05c5714eee02" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186426749} {:answer-field/choices [{:answer/id #uuid "eefcde1b-d3b8-55ec-9bff-1b6b1e19f657" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186426741}] :answer-field/correct {:db/id #edb/ref 17592186426741} :answer-field/id #uuid "75499a87-c853-5d3b-8493-31cc1387404a" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186426750}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "87b42522-bb27-5dd3-ac3e-bd3279e82fdf" :question/math-academy-id "q-317519" :question/problem "The system of equations\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}8y+6x-3z+4 &=0 \\\\ 5z-3y+x-6 &=0 \\\\ 7x-4z-y-9 &=0\\end{aligned}\\right.\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n|  |  | {{field-1}} | $8$ | $-3$ |  |  |  | $x$ |  |  |  | $-4$ |  |  |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  |  | $1$ | $-3$ | {{field-2}} |  |  |  | $y$ |  | $=$ |  | {{field-3}} |  | . |\n|  |  | {{field-4}} | $-1$ | $-4$ |  |  |  | $z$ |  |  |  | $9$ |  |  |" :question/worked-solution "First, let's write the system so that $x$, $y$, and $z$ appear in each equation in the correct order and all constants are on the right-hand side of the system:\n\n$$\n\\left\\{\\begin{aligned}6x+8y-3z &=-4 \\\\ x-3y+5z &=6 \\\\ 7x-y-4z &=9\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}6 & 8 & -3 \\\\ 1 & -3 & 5 \\\\ 7 & -1 & -4\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}-4 \\\\ 6 \\\\ 9\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}6 & 8 & -3 \\\\ 1 & -3 & 5 \\\\ 7 & -1 & -4\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-4 \\\\ 6 \\\\ 9\\end{bmatrix}.\n$$"}] :knowledge-point/title "Identifying Entries of a Matrix Product Representing a 3x3 System of Equations by Reorganizing"} :step/id #uuid "02ca150a-020c-573f-96d1-90c2f5331c52" :step/math-academy-id 16483}] :activity/title "Representing 3x3 Systems of Equations Using a Matrix Product" :activity/type {:db/id #edb/ref 17592186045463} :db/id #edb/ref 17592186059888}] :db/id #edb/ref 17592186049151 :topic/difficulty 0.5023527221721511 :topic/encompasses [{:db/id #edb/ref 17592186428285 :encompassing/rationale "Initial Codex estimate from captured target-band crossing frequency. Selected account foundations: 1 rises / 1 eligible passed source activities = 1.000000; nearest selected fraction = 1. Crossing activity numbers [1]; waits [1]. Separate account estimates: foundations=1 (1/1). Selection: most observations, then lower weight, then account name; no averaging. Single-activity estimates included. Intervening target updates: False. Crossing frequency is the chosen practical estimate of encompassing coverage; a multi-band rise counts once. This does not interpret color steps as physical repetition units. Method: encompassing-report.md. Evidence: reference/mathacademy/encompassing-analysis-2026-10-11/frequency-fractions/foundations-frequency-estimates.json, pair 155->1729. All account evidence retained in the prepared import's selected-relationships.json." :encompassing/topic {:db/id #edb/ref 17592186050463} :encompassing/weight 1.0}] :topic/id #uuid "deb0c389-354c-501a-95ee-3e33842eb21f" :topic/knowledge-points [{:db/id #edb/ref 17592186059757 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059566 :question/id #uuid "7bfcfcbb-6212-5f9b-90aa-c79fbf7221e9" :question/math-academy-id "e-4518" :question/problem "The system of equations\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}6x+4y &=1 \\\\ x-8y-z &=-2 \\\\ 3x+2y-2z &=1\\end{aligned}\\right.\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n![](images/21/212a3beac5ede3786bad835a693b0a725f331de41d6969dce7f17925dde012d7.svg)\n\nWhat are the values of $a,$ $b$ and $c?$" :question/worked-solution "First, let's write the system so that $x$, $y$, and $z$ appear in each equation:\n\n$$\n\\left\\{\\begin{aligned}6x+4y+0z &=1 \\\\ x-8y-z &=-2 \\\\ 3x+2y-2z &=1\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $A\\mathbf{x} = \\mathbf{b},$ where\n\n![](images/22/22034036ec7859b56e9e19124e33fa616eddfc3784e15f8074583e28253a4bae.svg)\n\nis the coefficient matrix,\n\n![](images/b5/b5e0f47e7c4bb15e8923bceb665dcc87944090e3a39f9a335b17ab0b85025cc8.svg)\n\nis the column vector of constants, and\n\n![](images/b6/b643463daef16c2179d6f6320d31353a23b042f3774295eb55e48af0242ec655.svg)\n\nis the column vector of variables.\n\nSo, the equation $A\\mathbf{x} = \\mathbf{b}$ becomes\n\n![](images/bf/bf8fb79fd8998c5c867fc371535e26f2e92bea5fa7262789bd44aea07e24f93c.svg)\n\nTherefore, $a=6,$ $b=2,$ and $c=-2.$"} :knowledge-point/id #uuid "1938c5da-d01a-53b7-a811-9afe1e43d152" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050463} {:db/id #edb/ref 17592186050825}] :knowledge-point/questions [{:db/id #edb/ref 17592186060276 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "099fa1e0-d872-5eb5-81ed-b3b1edaada04" :answer/type {:db/ident :answer.type/math} :answer/value "a=1,\\,b=-6,\\,c=11" :db/id #edb/ref 17592186321222} {:answer/id #uuid "138e861a-0cc2-58a9-9676-1ec3e92f91ad" :answer/type {:db/ident :answer.type/math} :answer/value "a=1,\\,b=-6,\\,c=1" :db/id #edb/ref 17592186321303} {:answer/id #uuid "7024eba8-43e2-5236-ad74-99d0c32d9f47" :answer/type {:db/ident :answer.type/math} :answer/value "a=-4,\\,b=-4,\\,c=11" :db/id #edb/ref 17592186322019} {:answer/id #uuid "806f8895-3e66-5150-bdff-c12b2f1ea7b1" :answer/type {:db/ident :answer.type/math} :answer/value "a=1,\\,b=11,\\,c=-4" :db/id #edb/ref 17592186322157} {:answer/id #uuid "ce2f6adf-c8fe-58ac-9550-1c74ef4b3ac8" :answer/type {:db/ident :answer.type/math} :answer/value "a=11,\\,b=-4,\\,c=1" :db/id #edb/ref 17592186322755}] :answer-field/correct {:db/id #edb/ref 17592186321222} :answer-field/id #uuid "dbe13b71-8293-5712-8025-31df3dbc7ef9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323607}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5006a5f1-0a5e-50bb-a47b-7da41b1e709f" :question/math-academy-id "q-36181" :question/problem "The system of equations\n\n$$\n\\left\\{\\begin{aligned}3x-4y+z &=2 \\\\ x-6y+11z &=3 \\\\ 3x-4y-z &=4\\end{aligned}\\right.\n$$\n\ncan be represented using matrix notation as\n\n$$\n\\begin{bmatrix}3 & -4 & a \\\\ 1 & b & c \\\\ 3 & -4 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}2 \\\\ 3 \\\\ 4\\end{bmatrix}.\n$$\n\nWhat are the values of $a,b$ and $c?$" :question/worked-solution "We can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}3 & -4 & 1 \\\\ 1 & -6 & 11 \\\\ 3 & -4 & -1\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}2 \\\\ 3 \\\\ 4\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}3 & -4 & 1 \\\\ 1 & -6 & 11 \\\\ 3 & -4 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}2 \\\\ 3 \\\\ 4\\end{bmatrix}.\n$$\n\nTherefore, $a=1,\\,b=-6,\\,c=11.$"} {:db/i