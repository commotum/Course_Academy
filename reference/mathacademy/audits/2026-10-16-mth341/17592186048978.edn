stion/problem "Consider a $8\\times 8$ matrix $A.$ If $\\text{rank}(A)=5$ then $\\text{nullity}(A)=$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=8.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 5+\\text{nullity}(A) & =8 \\\\ \\text{nullity}(A) & =8-5 \\\\  & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490327 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3065f796-1624-588c-ad6c-8dc59c6f240e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186489622} {:answer/id #uuid "4da61d62-968c-5325-878b-c10d9e629b68" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186489698} {:answer/id #uuid "50c964b1-c602-5d5d-919e-df6c10f9af08" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186489708} {:answer/id #uuid "a98b8437-83a6-540a-b465-549d1e82c697" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186489887} {:answer/id #uuid "d659b67d-8b6a-563d-897b-d4779a52e317" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186489990}] :answer-field/correct {:db/id #edb/ref 17592186489708} :answer-field/id #uuid "7e63c75a-0e87-5ea0-8fd9-4a7908e3c449" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490146}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fb06ba3d-1b9f-5681-af01-0922516167aa" :question/math-academy-id "q-142484" :question/problem "Consider a $8\\times 10$ matrix $A.$ If $\\text{rank}(A)=7$ then $\\text{nullity}(A)=$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=10.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 7+\\text{nullity}(A) & =10 \\\\ \\text{nullity}(A) & =10-7 \\\\  & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186522771 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0489d7c0-9892-5b4f-a265-35a855cae665" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186522025} {:answer/id #uuid "19d7b093-ccfa-5074-9a83-a27b17ba1454" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186522078} {:answer/id #uuid "40c69629-2803-5ad7-aa97-c2b10a5bb2b3" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186522158} {:answer/id #uuid "9b640a26-d27a-5063-8ab1-f9eddbf076e8" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186522337} {:answer/id #uuid "f26141c5-5ae9-5b4b-80af-055e70b6a825" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186522536}] :answer-field/correct {:db/id #edb/ref 17592186522078} :answer-field/id #uuid "70719b4e-2718-5ba2-8435-476dae5ff60e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186522612}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b1b6e064-faca-5061-955a-61c19c8be97d" :question/math-academy-id "q-142481" :question/problem "Consider a $4\\times 4$ matrix $A.$ If $\\text{rank}(A)=3$ then $\\text{nullity}(A)=$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=4.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 3+\\text{nullity}(A) & =4 \\\\ \\text{nullity}(A) & =4-3 \\\\  & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186522797 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "515cb0ad-3bf4-5d0b-b7db-ba6abbf4f45e" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186522193} {:answer/id #uuid "87510f02-5814-56e6-9a0a-3bbbf7e6baba" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186522288} {:answer/id #uuid "b3fe8edc-cf8c-59b3-845a-0f711614663c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186522389} {:answer/id #uuid "e0746fb2-e7e9-54d9-93d0-235af2e3310d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186522494} {:answer/id #uuid "e37b3463-8c25-56aa-885e-ca8b85bf4b8a" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186522504}] :answer-field/correct {:db/id #edb/ref 17592186522389} :answer-field/id #uuid "b0ade6f1-cb8a-5617-b68c-23062a0a94c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186522646}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e3fc6c03-9e92-5752-b628-3af41a4a428b" :question/math-academy-id "q-139981" :question/problem "Consider a $9\\times 6$ matrix $A.$ If $\\text{rank}(A)=4$ then $\\text{nullity}(A)=$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=6.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 4+\\text{nullity}(A) & =6 \\\\ \\text{nullity}(A) & =6-4 \\\\  & =2.\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Rank or Nullity of a Matrix Using the Rank-Nullity Theorem"} :step/id #uuid "3c8115af-900b-592a-a3df-6c126d87446c" :step/math-academy-id 37511 :step/next {:db/id #edb/ref 17592186184938}}] :activity/title "The Rank-Nullity Theorem" :activity/type {:db/id #edb/ref 17592186045463} :db/id #edb/ref 17592186184421} {:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186545897} :activity/id #uuid "4c0943ba-1699-5e8c-8670-aee7d34650f4" :activity/scope {:db/id #edb/ref 17592186048978} :activity/steps [{:db/id #edb/ref 17592186545897 :step/content {:db/id #edb/ref 17592186184755 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a17adadd-02fe-5b13-a556-c4b68557dec7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186183140} {:answer/id #uuid "f44f8717-6bc7-5c29-a85d-01286768fa78" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186183141} {:answer/id #uuid "3493b4eb-bc91-59c3-abe3-1362d436c2d5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186183142} {:answer/id #uuid "3d5d43af-17a2-5f2e-916b-b2453eace3cd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186183143} {:answer/id #uuid "62186aa1-6d7f-5a56-8e00-28c657c126cc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186183144}] :answer-field/correct {:db/id #edb/ref 17592186183141} :answer-field/id #uuid "405282dd-7ce6-56bf-8492-d4b7cbb14f8d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186183139}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4d185801-460b-5883-a896-8f1107477aa5" :question/math-academy-id "q-34930" :question/problem "Which of the following statements are true, given that $A$ is a $4\\times 4$ matrix and \n\n$$\n\\text{Null}(A)=\\text{Span}\\{[\\begin{aligned}5 \\\\ -2 \\\\ 0 \\\\ 0\\end{aligned}],\\,[\\begin{aligned}3 \\\\ 0 \\\\ 0 \\\\ -1\\end{aligned}]\\}?\n$$\n\nI. The number of non-pivot columns in $A$ is equal to $3$\n\nII. $\\text{Col}(A)={R}^{4}$\n\nIII. $\\text{rank}(A)=2$" :question/worked-solution "Since $A$ is a $4\\times 4$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{4} \\\\  & \\text{dim(Col}(A))=4=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nAlso, according to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since the generating vectors in \n\n$$\n\\text{Null}(A)=\\text{Span}\\{[\\begin{aligned}5 \\\\ -2 \\\\ 0 \\\\ 0\\end{aligned}],\\,[\\begin{aligned}3 \\\\ 0 \\\\ 0 \\\\ -1\\end{aligned}]\\}\n$$\n\nare linearly independent, we conclude that the number of non-pivot columns in $A$ is equal to $2.$\n\n- Statement II is false. Since $\\text{nullity}(A)=2\\ne 0,$ then by the invertible matrix theorem, we have $\\text{Col}(A)\\ne {R}^{4}.$\n\n- Statement III is true. Indeed, for the matrix $A,$ the number of columns is $n=4.$ Now, according to the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+2 & =4 \\\\ \\text{rank}(A) & =4-2 \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"III only.\""} :step/id #uuid "1eba418a-0a45-5af7-91fd-642512667c9b" :step/next {:db/id #edb/ref 17592186545994}} {:db/id #edb/ref 17592186545936 :step/content {:db/id #edb/ref 17592186545837 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1666c48c-616a-5584-b4b9-47f389d5edd6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186545240} {:answer/id #uuid "269226e3-2066-5e11-9e53-68cf25388793" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186545283} {:answer/id #uuid "9ab4711a-55c0-5e5e-90df-e23264046ee4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186545478} {:answer/id #uuid "daf3c561-12b4-504e-a0d4-870b426bed38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186545606} {:answer/id #uuid "dec293c4-9e4a-569e-b668-6abc7a7c73a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186545610}] :answer-field/correct {:db/id #edb/ref 17592186545610} :answer-field/id #uuid "4635540b-1236-5d34-8d5b-e01f27623485" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545699}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "94febb74-e81c-5137-a80c-9d7fa83538e0" :question/math-academy-id "q-141229" :question/problem "Let $A$ be a $4\\times 5$ matrix. If $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ is a basis of $\\text{Col}(A)$, find $\\text{dim(Null}(A)).$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=5,$ and since $B$ is formed by $3$ vectors, $\\text{rank}(A)=3.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 3+\\text{nullity}(A) & =5 \\\\ \\text{nullity}(A) & =5-3 \\\\ \\text{dim(Null}(A)) & =2.\\end{aligned}\n$$"} :step/id #uuid "648619fe-b878-526f-9493-71c3a98c37c8" :step/next {:db/id #edb/ref 17592186545960}} {:db/id #edb/ref 17592186545960 :step/content {:db/id #edb/ref 17592186545820 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2237675a-cbb8-55f4-ac1e-48c201dc4645" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186545270} {:answer/id #uuid "b366e033-8b4f-533d-86e0-d5b107bc8270" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186545525} {:answer/id #uuid "d71b0cc6-29c4-5b34-b310-64ab60f5b724" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186545592} {:answer/id #uuid "d90fb75f-16a5-5779-817f-22c451b4191b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186545597} {:answer/id #uuid "fe29b5e6-ad57-590e-8812-0f23650c5a45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186545668}] :answer-field/correct {:db/id #edb/ref 17592186545592} :answer-field/id #uuid "a810a855-c6d2-5045-a468-45c2987823ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545752}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5e7c8be1-d271-506d-bfc9-fbf1881a88d8" :question/math-academy-id "q-142489" :question/problem "Find $\\text{rank}(A)$ given that $\\text{Null}(A)=\\{[\\begin{aligned}{x}_{1} \\\\ 0 \\\\ {x}_{1}+{x}_{2} \\\\ 0 \\\\ 0\\end{aligned}]\\,|\\,\\,{x}_{1},{x}_{2}\\in R\\}.$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=5,$ since this is the number of components in each of the vectors of the null space. \n\nAlso, since \n\n$$\n\\text{Null}(A)=\\{{x}_{1}[\\begin{aligned}1 \\\\ 0 \\\\ 1 \\\\ 0 \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}0 \\\\ 0 \\\\ 1 \\\\ 0 \\\\ 0\\end{aligned}]\\,|\\,\\,{x}_{1},{x}_{2}\\in R\\}\n$$\n\nwe conclude that $\\text{nullity}(A)=2.$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+2 & =5 \\\\ \\text{rank}(A) & =5-2 \\\\  & =3.\\end{aligned}\n$$"} :step/id #uuid "a4b43338-82e4-5410-9f98-512abc7e92cc"} {:db/id #edb/ref 17592186545994 :step/content {:db/id #edb/ref 17592186377763 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee3ba979-73eb-55d9-98be-53eb63f15310" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186454018} {:answer/id #uuid "42f7e70e-a33c-5389-83b8-4b66c4b40413" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186454019}] :answer-field/correct {:db/id #edb/ref 17592186454019} :answer-field/id #uuid "51beb1c0-c434-5ffe-be4f-d1af3a966f94" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454759} {:answer-field/choices [{:answer/id #uuid "b27c5d69-4610-55e4-befd-bab1f9f21b77" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186454020} {:answer/id #uuid "7f38039b-9493-5449-afe0-51512728ff71" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186454021}] :answer-field/correct {:db/id #edb/ref 17592186454021} :answer-field/id #uuid "8bd2f4dc-0220-560a-b969-e0fb63f01a28" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454760} {:answer-field/choices [{:answer/id #uuid "22168706-fdd0-5ec9-8357-a478a254b0de" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186454022} {:answer/id #uuid "b3eaef39-5ed2-5d0e-8448-e5d92a445686" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186454023}] :answer-field/correct {:db/id #edb/ref 17592186454022} :answer-field/id #uuid "447c453c-9c02-53db-ad8b-23d0593303f4" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454761}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2c7ff497-8845-5d34-a5a1-e0b10d7a1e25" :question/math-academy-id "q-79367" :question/problem "Which of the following statements are true given that $A$ is a $5\\times 5$ matrix with $3$ pivot columns?\n\nSelect all that apply.\n\n- **I.** $\\text{rank}(A)=3$\n- **II.** $A$ is not  invertible\n- **III.** $\\text{nullity}(A)=3$" :question/worked-solution "Since $A$ is a $5\\times 5$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(A)={R}^{5} \\\\  & \\text{dim(Col}(A))=5=\\text{rank}(A) \\\\  & \\text{Null}(A)={0} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nAlso, according to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Indeed, since $A$ has $3$ pivot columns, we have $\\text{rank}(A)=3.$\n\n- Statement II is true. Indeed, for the matrix $A,$ the number of the columns is $n=5.$ Now, since $\\text{rank}(A)\\ne 5,$ then by the invertible matrix theorem,  $A$ can't be an invertible matrix.\n\n- Statement III is false. According to  the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 3+\\text{nullity}(A) & =5 \\\\ \\text{nullity}(A) & =5-3 \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and II only.\""} :step/id #uuid "d4a34369-680e-54a1-9729-80a4a7934062" :step/next {:db/id #edb/ref 17592186546003}} {:db/id #edb/ref 17592186546003 :step/content {:db/id #edb/ref 17592186545857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f1b4ae3-0a40-5756-bb35-332f91366150" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186545226} {:answer/id #uuid "341ea572-fea0-5ab5-8e97-94b9de3afc39" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186545303} {:answer/id #uuid "3dc8c0b7-7f8f-5ba1-a69b-9e3d9da97a75" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186545318} {:answer/id #uuid "73232096-0842-59cd-811b-a3783597953d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186545416} {:answer/id #uuid "855804bf-27d3-5391-ba94-a4c1ff073b30" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186545452}] :answer-field/correct {:db/id #edb/ref 17592186545226} :answer-field/id #uuid "c143e0e6-92b8-5ab3-a31a-0f6f3f8892c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545765}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c10d4c77-93c5-52a9-900d-275fa9299d3e" :question/math-academy-id "q-79410" :question/problem "Which of the following statements are true, given that $A$ is a $4\\times 4$ matrix and \n\n$$\n\\text{Null}(A)=\\text{Span}\\{[\\begin{aligned}1 \\\\ 0 \\\\ -1 \\\\ 0\\end{aligned}]\\}?\n$$\n\nI. $\\text{rank}(A)=2$\n\nII. $\\text{Col}(A)$ is a $3$-dimensional subspace of ${R}^{4}$\n\nIII. $A$ has $2$ pivot colums" :question/worked-solution "Since $A$ is a $4\\times 4$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{4} \\\\  & \\text{dim(Col}(A))=4=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nAlso, according to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since the non-zero vector\n\n$$\n[\\begin{aligned}1 \\\\ 0 \\\\ -1 \\\\ 0\\end{aligned}]\n$$\n\nspans $\\text{Null}(A),$ we conclude that $\\text{nullity}(A)=1.$ So, by the rank-nullity theorem, with $n=4$,  we obtain\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+1 & =4 \\\\ \\text{rank}(A) & =4-1 \\\\  & =3.\\end{aligned}\n$$\n\n- Statement II is true. Indeed, since $\\text{dim(Col}(A))=\\text{rank}(A)=3,$ we must have  that $\\text{Col}(A)$ is a $3$-dimensional subspace of ${R}^{4}.$\n\n- Statement III is false. The fact that $\\text{dim(Col}(A))=3$ implies that the number of pivot columns in $A$ is also equal to $3.$\n\nTherefore, the correct answer is \"II only.\""} :step/id #uuid "e48dd2d3-2546-5691-ad94-982797f6f0e4" :step/next {:db/id #edb/ref 17592186545936}}] :activity/title "The Rank-Nullity Theorem" :activity/type {:db/id #edb/ref 17592186045464} :db/id #edb/ref 17592186545189}] :db/id #edb/ref 17592186048978 :topic/id #uuid "d0b65e3a-175c-5881-9e6b-528af522aa34" :topic/knowledge-points [{:db/id #edb/ref 17592186184171 :knowledge-point/canonical-example {:db/id #edb/ref 17592186184070 :question/id #uuid "10cc01a6-af19-5340-9743-ade4d5e252dc" :question/math-academy-id "e-5425" :question/problem "Let $A$ be a $3\\times 5$ matrix. If $\\mathcal{B}= \\{\\mathbf{b_1}, \\mathbf{b_2}, \\mathbf{b_3}\\}$ is a basis of $\\textrm{Col}(A)$, find $\\textrm{dim(Null}(A)).$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\textrm{rank}(A) + \\textrm{nullity}(A) = n.\n$$\n\nFor the given matrix, we have $n=5,$ and since $\\mathcal{B}$ is formed by $3$ vectors, $\\textrm{rank}(A) = 3.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 3+\\text{nullity}(A) & =5 \\\\ \\text{nullity}(A) & =5-3 \\\\ \\text{dim(Null}(A)) & =2.\\end{aligned}\n$$"} :knowledge-point/id #uuid "d562ea0c-94f3-5fe6-ba82-c651a51d0bbe" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048823} {:db/id #edb/ref 17592186049009}] :knowledge-point/question-generator {:db/id #edb/ref 17592186530852 :question-generator/id #uuid "1744d06d-756c-5d2a-bb4f-65b0cc325ee8" :question-generator/script "generate/scratch/17592186184171.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186184759 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c2c253b-eb4a-53cb-b0ca-7c84c3094ed1" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186183164} {:answer/id #uuid "a1905378-ce91-51d4-9b0f-bc5b3501e65e" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186183165} {:answer/id #uuid "3829fa6b-44cd-591e-a98f-f251876ca514" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186183166} {:answer/id #uuid "44fd0839-e352-55e5-a108-928603beaa61" :answer/type {:db/ident :answer.type/m