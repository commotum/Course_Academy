-b4a7-0e3f12c0401c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186271002}] :answer-field/correct {:db/id #edb/ref 17592186270041} :answer-field/id #uuid "c5e20045-d23c-5279-aabf-98a4858337d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186271871}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a8591660-5b8e-5e5d-b7c5-293cb529794e" :question/math-academy-id "q-141230" :question/problem "Let $A$ be a $5\\times 7$ matrix. If $B=\\{{b}_{1},{b}_{2},{b}_{3},{b}_{4}\\}$ is a basis of $\\text{Col}(A)$, find $\\text{dim(Null}(A)).$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=7,$ and since $B$ is formed by $4$ vectors, $\\text{rank}(A)=4.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 4+\\text{nullity}(A) & =7 \\\\ \\text{nullity}(A) & =7-4 \\\\ \\text{dim(Null}(A)) & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186272351 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "295aaa3d-02f9-502b-856c-5b79aa304483" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186269642} {:answer/id #uuid "5bf9e0d1-e59a-5902-b41c-61bc06c16323" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186270088} {:answer/id #uuid "a2102907-c48c-583f-b07b-cfefcb31941d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186270710} {:answer/id #uuid "b85d4793-7c22-5269-b369-5e14e06b8c46" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270898} {:answer/id #uuid "be8ca00f-5f9e-5c25-9e3a-981fad762995" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186270953}] :answer-field/correct {:db/id #edb/ref 17592186270710} :answer-fie