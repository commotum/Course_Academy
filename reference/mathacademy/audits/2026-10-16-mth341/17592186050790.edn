eae24cd4a40320b23f882b.png" :db/id #edb/ref 17592186490024} {:answer/id #uuid "fba812d1-3f67-596b-b851-fa0314c2cb48" :answer/type {:db/ident :answer.type/image} :answer/value "images/e6/e6aa0661b20e4d114abb475dfc3cba6180bed5155c6051262a68c31110408a18.png" :db/id #edb/ref 17592186490062}] :answer-field/correct {:db/id #edb/ref 17592186490024} :answer-field/id #uuid "d17d82c6-1a23-5c4e-bb97-55ab46a58407" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490184}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3f93db21-c74e-5e95-a404-6814f4df05d9" :question/math-academy-id "q-102054" :question/problem "Which of the following graphs shows the line $y=-2x?$" :question/worked-solution "We need to find two distinct points that lie on our line. Any two points will do!\n\n- For the first point, we will let the $x$-coordinate be $x=0.$ Then the $y$-coordinate is \n\n$$\n\\begin{aligned}y & =-2x \\\\  & =-2(0) \\\\  & =0.\\end{aligned}\n$$\n\nSo, the first point is $(0,0).$\n\n- For the second point, we will let the $x$-coordinate be $x=1.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =-2x \\\\  & =-2(1) \\\\  & =-2.\\end{aligned}\n$$\n\nSo, the second point is $(1,-2).$\n\nFinally, we plot those two points on the $xy$-plane and draw a line through them. This is the graph of $y=-2x.$ \n\n![](images/c6/c632cc2770958b5d73f6e143de0b72d19b2099f9f656ff34f273d88acc4f9cb4.png)"} {:db/id #edb/ref 17592186490285 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1395c3db-95d9-5639-b9d4-30e6fc772906" :answer/type {:db/ident :answer.type/image} :answer/value "images/0c/0cfc4bba4867b40c4c38b0886c37bb5c4cd64d293530ece7c67cdb6349134013.png" :db/id #edb/ref 17592186489558} {:answer/id #uuid "3b2e4dbc-417e-567d-87f0-6c258efaf698" :answer/type {:db/ident :answer.type/image} :answer/value "images/9e/9e2977ee1faa5dde2d1bf3a427037aac75b2692486bdcb724356452765c8b661.png" :db/id #edb/ref 17592186489648} {:answer/id #uuid "73631664-2efe-5676-8831-b04bad13e778" :answer/type {:db/ident :answer.type/image} :answer/value "images/06/0678cd88949fac3a9ce58d255eee9d8a07ba8c3b91a86f90fa24d70d1510568f.png" :db/id #edb/ref 17592186489784} {:answer/id #uuid "7a5037ef-50db-500f-ac5f-db15fcc0b6b8" :answer/type {:db/ident :answer.type/image} :answer/value "images/24/24d776784e54d7e38452f9b548051d0a2015e119f7c701ac74be87ef3dbb42f9.png" :db/id #edb/ref 17592186489794} {:answer/id #uuid "c346fa15-1ab9-5397-875e-59d3c4e305eb" :answer/type {:db/ident :answer.type/image} :answer/value "images/af/afb86fd4a7ffd591dfbbc6e8ee837b33b943972212b04b15f9040b310b0abdba.png" :db/id #edb/ref 17592186489936}] :answer-field/correct {:db/id #edb/ref 17592186489784} :answer-field/id #uuid "4ceda208-3258-5df9-a5ee-0311a1f10448" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490120}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a5b958d4-e62e-522f-9fd3-554270dc7fdb" :question/math-academy-id "q-109055" :question/problem "Which of the following graphs shows the line $y=2-\\frac{1}{2}x?$" :question/worked-solution "We need to find two distinct points that lie on our line. Any two points will do!\n\n- For the first point, we will let the $x$-coordinate be $x=0.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =2-\\frac{1}{2}x \\\\  & =2-\\frac{1}{2}(0) \\\\  & =2-0 \\\\  & =2.\\end{aligned}\n$$\n\nSo, the first point is $(0,2).$\n\n- For the second point, we will let the $x$-coordinate be $x=8.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =2-\\frac{1}{2}x \\\\  & =2-\\frac{1}{2}(8) \\\\  & =2-4 \\\\  & =-2.\\end{aligned}\n$$\n\nSo, the second point is $(8,-2).$\n\nFinally, we plot those two points on the $xy$-plane and draw a line through them. This is the graph of $y=2-\\frac{1}{2}x.$\n\n![](images/a8/a8c562212687c848e2de25b757f59acd70467a085ae2e0713fbeafa355ad5bb5.png)"} {:db/id #edb/ref 17592186497745 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e6c1d0d-4c00-5981-9219-0c8e265c4f69" :answer/type {:db/ident :answer.type/image} :answer/value "images/d7/d7603626fb60eb9cae8ed8155a1eb81d2a66a3c239468c93ccf7c0f0530a5193.png" :db/id #edb/ref 17592186497747} {:answer/id #uuid "468e40cd-9cf9-5a6b-96e2-0dee3bac3ebb" :answer/type {:db/ident :answer.type/image} :answer/value "images/ac/ac2fb8cd0a1e808bc599067860a3bf1af50a167e4ae71c8ad4d8a9329ebe6cb0.png" :db/id #edb/ref 17592186497750} {:answer/id #uuid "6f98bc0a-745d-5fe8-9adb-75bc94c5e580" :answer/type {:db/ident :answer.type/image} :answer/value "images/53/53c3f8c77c96b0925ce788a07b102555a1fca916d8ea20fd47fe6894c2eb46b5.png" :db/id #edb/ref 17592186497754} {:answer/id #uuid "8f0741d7-a6b1-5299-943c-c9df2fd77321" :answer/type {:db/ident :answer.type/image} :answer/value "images/b2/b2bb0b6f019af476eae3e76adb7ac2ef4745a6c4bdeae24cd4a40320b23f882b.png" :db/id #edb/ref 17592186497757} {:answer/id #uuid "fa366fab-7ce5-5d4f-8d88-5e08fc12f31f" :answer/type {:db/ident :answer.type/image} :answer/value "images/5f/5fcdd5b3c95340859bbb6f30dd3e80aa7396762e91187541bf68f64e2b21c1b3.png" :db/id #edb/ref 17592186497763}] :answer-field/correct {:db/id #edb/ref 17592186497747} :answer-field/id #uuid "714f5f25-99f5-58fb-9ddf-b6fc9c8a48c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186497755}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1b239726-9ec0-5ecb-8b93-7c8edf0b2f3f" :question/problem "Which of the following graphs shows the line $y=-4x?$" :question/worked-solution "We need to find two distinct points that lie on our line. Any two points will do!\n\n- For the first point, we will let the $x$-coordinate be $x=0.$ Then the $y$-coordinate is \n\n$$\n\\begin{aligned}y & =-4x \\\\  & =-4(0) \\\\  & =0.\\end{aligned}\n$$\n\nSo, the first point is $(0,0).$\n\n- For the second point, we will let the $x$-coordinate be $x=1.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =-4x \\\\  & =-4(1) \\\\  & =-4.\\end{aligned}\n$$\n\nSo, the second point is $(1,-4).$\n\nFinally, we plot those two points on the $xy$-plane and draw a line through them. This is the graph of $y=-4x.$ \n\n![](images/8b/8b008b94eebbd24ae51670447848ce2d644c067d43dd92d72de85b048358cc54.png)"} {:db/id #edb/ref 17592186497762 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "197e6448-d4b8-50c4-8753-532544dcd499" :answer/type {:db/ident :answer.type/image} :answer/value "images/99/992d82dfeac6b0a73453363ca57efaa9fe70b2b5ccd7cd1712b5772f09c224d2.png" :db/id #edb/ref 17592186497744} {:answer/id #uuid "42221fb0-f700-5e55-a7e6-33f0cb67bcb9" :answer/type {:db/ident :answer.type/image} :answer/value "images/8a/8a82731b726d091769fdf10ca7f5d7ee87816cd490f933aaf1fc2c19c0701603.png" :db/id #edb/ref 17592186497749} {:answer/id #uuid "4ac7786b-a678-552f-b339-f52f193863ee" :answer/type {:db/ident :answer.type/image} :answer/value "images/8e/8ef5652a5d1a90b6874dc19a87b7109fc2144507a587fb1daab19c0c3442d4df.png" :db/id #edb/ref 17592186497751} {:answer/id #uuid "ad159fd3-feff-5d67-88af-d4e81768184a" :answer/type {:db/ident :answer.type/image} :answer/value "images/b3/b3be73566253173f2ca88649fd585cced2cab7cddc27be7c40eeae9d8db2cc09.png" :db/id #edb/ref 17592186497759} {:answer/id #uuid "d3f0b6a4-03c2-5777-8ad1-670384f66a6c" :answer/type {:db/ident :answer.type/image} :answer/value "images/0d/0d517f4c1af2fbd48ec41131ce7dec1aeb4d2c50514e53360ab043a4daa93552.png" :db/id #edb/ref 17592186497761}] :answer-field/correct {:db/id #edb/ref 17592186497744} :answer-field/id #uuid "24d238d3-c42b-5a24-b6da-36a8047d399e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186497748}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e9992e41-e63d-5336-a605-48b1d684791a" :question/problem "Which of the following graphs shows the line $y=-3x?$" :question/worked-solution "We need to find two distinct points that lie on our line. Any two points will do!\n\n- For the first point, we will let the $x$-coordinate be $x=0.$ Then the $y$-coordinate is \n\n$$\n\\begin{aligned}y & =-3x \\\\  & =-3(0) \\\\  & =0.\\end{aligned}\n$$\n\nSo, the first point is $(0,0).$\n\n- For the second point, we will let the $x$-coordinate be $x=1.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =-3x \\\\  & =-3(1) \\\\  & =-3.\\end{aligned}\n$$\n\nSo, the second point is $(1,-3).$\n\nFinally, we plot those two points on the $xy$-plane and draw a line through them. This is the graph of $y=-3x.$ \n\n![](images/08/08e854b04d47ff670b197a2a0c7b51c13eb135626e0ed6cdfd24368d4032f259.png)"} {:db/id #edb/ref 17592186497764 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dc17c22-f348-5c67-921e-bb49f7e4bc08" :answer/type {:db/ident :answer.type/image} :answer/value "images/af/afb86fd4a7ffd591dfbbc6e8ee837b33b943972212b04b15f9040b310b0abdba.png" :db/id #edb/ref 17592186497746} {:answer/id #uuid "5656dea6-87b8-5765-a05d-162629ac3306" :answer/type {:db/ident :answer.type/image} :answer/value "images/39/39ae505504b452e87f70c4b555914b597ff0d3859f54f1f4d2ed5516c73131da.png" :db/id #edb/ref 17592186497752} {:answer/id #uuid "59705c30-8f9f-56b2-8c1d-4816e1357d09" :answer/type {:db/ident :answer.type/image} :answer/value "images/9c/9c4d21e0fdbdb082c1efdd50936da2cd8c131be9b5ac3fa0fa85a73f8c11cf48.png" :db/id #edb/ref 17592186497753} {:answer/id #uuid "a43ac8a2-cf32-55c4-b2d4-693e23dc22b3" :answer/type {:db/ident :answer.type/image} :answer/value "images/d1/d17e0a44ef03d6110f031a8ab6f0bf63b478a263754bbab63124e880546aef28.png" :db/id #edb/ref 17592186497758} {:answer/id #uuid "cd48e67e-3c17-53e8-a38a-e16bd3b4647f" :answer/type {:db/ident :answer.type/image} :answer/value "images/9c/9c7577f7033f36315d50748424d7a8db635e9aecd4c88c9ed4626f3294bc6c2b.png" :db/id #edb/ref 17592186497760}] :answer-field/correct {:db/id #edb/ref 17592186497753} :answer-field/id #uuid "77551351-5d0a-512a-acd9-8abceb71136c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186497756}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ffd546da-09fc-5649-b60d-749bd09256a6" :question/problem "Which of the following graphs shows the line $y=-1x?$" :question/worked-solution "We need to find two distinct points that lie on our line. Any two points will do!\n\n- For the first point, we will let the $x$-coordinate be $x=0.$ Then the $y$-coordinate is \n\n$$\n\\begin{aligned}y & =-1x \\\\  & =-1(0) \\\\  & =0.\\end{aligned}\n$$\n\nSo, the first point is $(0,0).$\n\n- For the second point, we will let the $x$-coordinate be $x=1.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =-1x \\\\  & =-1(1) \\\\  & =-1.\\end{aligned}\n$$\n\nSo, the second point is $(1,-1).$\n\nFinally, we plot those two points on the $xy$-plane and draw a line through them. This is the graph of $y=-1x.$ \n\n![](images/73/7322801cf231391f58d39f2fad42b779e04fc1b81b686bcb3291ebfee5651226.png)"}] :knowledge-point/title "Sketching a Line Using Two Points"} {:db/id #edb/ref 17592186054802 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054499 :question/id #uuid "2efe9f75-18c0-5a86-b56b-3f338b7e5c2d" :question/math-academy-id "e-1702" :question/problem "Which of the following gives the graph of the straight line below?\n\nI. $y=2x-1$\n\nII. $y=\\dfrac{1}{2}x-1$\n\nIII. $2x-y=1$\n\n![](images/93/93dc9d447c15e4597549996b1f0b533cf86783b5cc5df032a4c46d4ca8934abc.png)" :question/worked-solution "Let's pick two distinct points on the line. For example, we can choose $A$ and $B$ with coordinates $(0,-1)$ and $(2,3)$, respectively.\n\n![](images/a9/a9f18453dedb1763908825301f80ef86307d3a3aceaf678bbe8579a42a0996f5.png)\n\nNow, we substitute the coordinates of both points in our equations. If both points satisfy an equation, then we can conclude that the equation represents the line in the graph. Otherwise, if any point does *not* satisfy the equation, then we can conclude that the equation does *not* represent the line in the graph.\n\n- Equation I: $y=2x-1.$\nSubstituting the coordinates of $A(0,-1)$ and $B(2,3),$ we obtain\n\n$$\n\\begin{aligned}(-1) & =2(0)-1 \\\\ -1 & =-1\\,✓ \\\\ (3) & =2(2)-1 \\\\ 3 & =3\\,✓\\end{aligned}\n$$\n\nTherefore, $y=2x-1$ is an equation of the line in the graph.\n\n- Equation II: $y=\\dfrac{1}{2}x-1.$\nSubstituting the coordinates of $A(0,-1)$ and $B(2,3),$ we obtain\n\n$$\n\\begin{aligned}(-1) & =\\frac{1}{2}(0)-1 \\\\ -1 & =-1\\,✓ \\\\ (3) & =\\frac{1}{2}(2)-1 \\\\ 3 & =0\\,\\times \\end{aligned}\n$$\n\nTherefore, $y=\\dfrac{1}{2}x-1$ is *not* an equation of the line in the graph.\n\n- Equation III: $2x-y=1.$\nSubstituting the coordinates of $A(0,-1)$ and $B(2,3),$ we obtain\n\n$$\n\\begin{aligned}2(0)-(-1) & =1 \\\\ 1 & =1\\,✓ \\\\ 2(2)-(3) & =1 \\\\ 1 & =1\\,✓\\end{aligned}\n$$\n\nTherefore, $2x-y=1$ is an equation of the line in the graph.\n\nOf the given equations, the only equations that represented the line in the graph were $y=2x-1$ and $2x-y=1,$ corresponding to answer choices I and III. Therefore, the correct answer is \"I and III only.\""} :knowledge-point/id #uuid "3986a3cd-c543-54e9-8d55-f744d9436313" :knowledge-point/question-generator {:db/id #edb/ref 17592186501336 :question-generator/id #uuid "b429cfa3-b141-58ec-8aa2-78825cd36898" :question-generator/script "generate/scratch/17592186054802.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186055368 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "edec9d12-0bd4-51b1-857c-39b0d3a639e1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439845} {:answer/id #uuid "ba4130b8-9669-55b8-8101-3fcb6c6ada16" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439846}] :answer-field/correct {:db/id #edb/ref 17592186439845} :answer-field/id #uuid "69a5e73f-3177-5c10-a5a9-440d3c78400f" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440280} {:answer-field/choices [{:answer/id #uuid "9cb663d8-de5a-51e3-bb4d-8e4f975e7db1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439847} {:answer/id #uuid "1f0202b1-3256-56a6-9f81-b5d0622b9978" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439848}] :answer-field/correct {:db/id #edb/ref 17592186439848} :answer-field/id #uuid "49e99a0a-f180-5be2-8fc7-1134f81777c9" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440281} {:answer-field/choices [{:answer/id #uuid "27364161-b9ad-5a6e-b527-4b3e2d5b8883" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439849} {:answer/id #uuid "d9e1b9e7-60c6-56f9-aca1-3d50f7fe497b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439850}] :answer-field/correct {:db/id #edb/ref 17592186439849} :answer-field/id #uuid "d8ff5166-67c3-5684-8f52-2c346e801f1d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440282}] :question/id #uuid "56e71e28-d3a5-545f-bf8d-30361fbf20ae" :question/math-academy-id "q-54285" :question/problem "![](images/4c/4ce176ba6bb73da8d6af410bedad4733cf3e705c70e28f133d771b89f78130c5.png)\n\nWhich of the following gives the graph of the straight line above?\n\nSelect all that apply.\n\n- **I.** $y = x + \\frac{1}{2}$\n- **II.** $y = \\frac{1}{2}x + 2$\n- **III.** $y = \\frac{1}{2}x + \\frac{1}{2}$" :question/worked-solution "The line crosses the y-axis at 2 and passes through (4,4); its slope is 1/2. Therefore y=x/2+2, statement II."} {:db/id #edb/ref 17592186055431 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "acf10a5d-ded4-5b84-b33b-6fd30a508b8e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439851} {:answer/id #uuid "136aebe2-1e23-5e43-bca6-1706231d0c1c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439852}] :answer-field/correct {:db/id #edb/ref 17592186439851} :answer-field/id #uuid "1bfae510-b96d-5e86-9727-d50c4fd631a3" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440283} {:answer-field/choices [{:answer/id #uuid "0c172c4a-e1a8-56f7-9795-82510cd46049" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439853} {:answer/id #uuid "aa1a8025-4883-5f71-a62a-efae12144e11" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439854}] :answer-field/correct {:db/id #edb/ref 17592186439853} :answer-field/id #uuid "aeab6991-adc5-5ace-ba4f-ecc5f05657e8" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440284} {:answer-field/choices [{:answer/id #uuid "6aba6425-8dab-5304-9842-8e92e1722604" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439855} {:answer/id #uuid "48a91d43-b10e-5fa5-ac58-14ddb60ffc8f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439856}] :answer-field/correct {:db/id #edb/ref 17592186439856} :answer-field/id #uuid "415c96ce-c78f-50f0-9f80-e3fc5b279dba" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440285}] :question/id #uuid "2fe51fc5-fce7-5fb6-911c-f561e72ff3fa" :question/math-academy-id "q-59732" :question/problem "![](images/4d/4d78eaaedd26a27d9163fdcddfce5c5ed429e441a75d361f0840935fce9235c6.png)\n\nWhich of the following gives the graph of the straight line above?\n\nSelect all that apply.\n\n- **I.** $x + 2y = 4$\n- **II.** $y = 2 - x$\n- **III.** $y = 4 - x$" :question/worked-solution "The line has intercepts (0,4) and (4,0), so its equation is y=4-x, statement III."} {:db/id #edb/ref 17592186490279 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ce4d23e-eb28-56bb-bb93-3733846a6e64" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186489585} {:answer/id #uuid "59fbb6ed-802e-5fc7-981b-ad071fe8f05d" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186489735} {:answer/id #uuid "ad32efea-57f2-50ab-8978-d4988074759d" :answer/type {:db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186489894} {:answer/id #uuid "c0d8e2ce-cf6e-51e6-a3d1-b415eae5cfb5" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186489933} {:answer/id #uuid "e108ba0b-b8a5-543a-a12b-2f22efb52a6f" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186490005}] :answer-field/correct {:db/id #edb/ref 17592186489894} :answer-field/id #uuid "8571c77b-dc56-5521-b8ff-cf319f34e7c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490152}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9d3bda62-1eef-5cb9-886b-004877c9a204" :question/math-academy-id "q-71837" :question/problem "![](images/f8/f886e9f5dfef693d1ea5d5a0a907a886be368549c1b9a4d43dce257d070e2fa2.png)\n\nWhich of the following gives the graph of the straight line above?\n\nI. $y+3x=6$\n\nII. $\\frac{1}{3}y+x=2$\n\nIII. $y=-3x+6$" :question/worked-solution "Let's pick two distinct points on the line. For example, $A$ and $B$ with coordinates $(0,6)$ and $(2,0)$, respectively.\n\n![](images/d6/d6cb6d026c181d79bda5c809729eb070c554c2025a287577df0330d1dd8a03e7.png)\n\nNow, we substitute the coordinates of both points in our equations. If both points satisfy an equation, then we can conclude that the equation represents the line in the graph. Otherwise, if any point does *not* satisfy the equation, then we can conclude that the equation does *not* represent the line in the graph.\n\n- Equation I: $y+3x=6.$\nSubstituting the coordinates of $A(0,6)$ and $B(2,0)$, we obtain\n\n$$\n\\begin{aligned}(6)+3(0) & =6 \\\\ 6 & =6\\,✓ \\\\ (0)+3(2) & =6 \\\\ 6 & =6\\,✓\\end{aligned}\n$$\n\nTherefore, $y+3x=6$ is an equation of the line in the graph.\n\n- Equation II: $\\frac{1}{3}y+x=2.$\nSubstituting the coordinates of $A(0,6)$ and $B(2,0)$, we obtain\n\n$$\n\\begin{aligned}\\frac{1}{3}(6)+(0) & =2 \\\\ 2+0 & =2 \\\\ 2 & =2\\,✓ \\\\ \\frac{1}{3}(0)+(2) & =2 \\\\ 0+2 & =2 \\\\ 2 & =2\\,✓\\end{aligned}\n$$\n\nTherefore,$\\frac{1}{3}y+x=2$ is an equation of the line in the graph.\n\n- Equation III: $y=-3x+6.$\nSubstituting the coordinates of $A(0,6)$ and $B(2,0)$, we obtain\n\n$$\n\\begin{aligned}(6) & =-3(0)+6 \\\\ 6 & =6\\,✓ \\\\ (0) & =-3(2)+6 \\\\ 0 & =-6+6 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nTherefore, $y=-3x+6$ is  an equation of the line in the graph.\n\nAll the given equations represented the line in the graph. Therefore, the correct answer is \"I, II and III.\""} {:db/id #edb/ref 17592186490287 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "026cf452-bbce-5666-b06e-eea33f9d7832" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186489517} {:answer/id #uuid "9acb1b55-d961-5760-970a-55e90ab17c7c" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186489858} {:answer/id #uuid "c834e69d-11f0-589f-aef2-acdc449ab184" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186489948} {:answer/id #uuid "c9f1f968-d792-57b5-9f02-cbac084ac726" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186489956} {:answer/id #uuid "e524c8b2-8988-581d-b06e-10a171578329" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186490013}] :answer-field/correct {:db/id #edb/ref 17592186489517} :answer-field/id #uuid "44f33cfa-5885-5a2f-90fc-d69e3d361204" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490113}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a635937b-674b-54dd-a770-48fe7b870be8" :question/math-academy-id "q-54293" :question/problem "![](images/71/716836dd3dfc93ac26bf9a960d5edcd04da96907b98c39e926a917b7b8feeeee.png)\n\nWhich of the following gives the graph of the straight line above?\n\nI. $y=-2x+\\frac{1}{2}$\n\nII. $y=-\\frac{1}{2}x+2$\n\nIII. $y=\\frac{1}{2}x+2$" :question/worked-solution "Let's pick two distinct points on the line. For example, $A$ and $B$ with coordinates $(0,2)$ and $(4,0)$, respectively.\n\n![](images/2b/2b9174d86d123228ae24fffeda4d2e4741e4a776f6671f7eff38340a59ba4d40.png)\n\nNow, we substitute the coordinates of both points in our equations. If both points satisfy an equation, then we can conclude that the equation represents the line in the graph. Otherwise, if any point does *not* satisfy the equation, then we can conclude that the equation does *not* represent the line in the graph.\n\n- Equation I: $y=-2x+\\frac{1}{2}.$\nSubstituting the coordinates of $A(0,2)$, we obtain\n\n$$\n\\begin{aligned}(2) & =-1(0)+\\frac{1}{2} \\\\ 2 & =\\frac{1}{2}\\,\\times \\end{aligned}\n$$\n\nTherefore, $y=-2x+\\frac{1}{2}$ is *not* equation of the line in the graph.\n\n- Equation II: $y=-\\frac{1}{2}x+2.$\nSubstituting the coordinates of $A(0,2)$ and $B(4,0)$, we obtain\n\n$$\n\\begin{aligned}(2) & =-\\frac{1}{2}(0)+2 \\\\ 2 & =2\\,✓ \\\\ (0) & =-\\frac{1}{2}(4)+2 \\\\ 0 & =-2+2 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nTherefore,$y=-\\frac{1}{2}x+2$ is an equation of the line in the graph.\n\n- Equation III: $y=\\frac{1}{2}x+2.$\nSubstituting the coordinates of $A(0,2)$ and $B(4,0)$, we obtain\n\n$$\n\\begin{aligned}(2) & =\\frac{1}{2}(0)+2 \\\\ 2 & =2\\,✓ \\\\ (0) & =\\frac{1}{2}(4)+2 \\\\ 0 & =2+2 \\\\ 0 & =4\\,\\times \\end{aligned}\n$$\n\nTherefore, $y=\\frac{1}{2}x+2$ is *not* equation of the line in the graph.\n\nOf the given equations, the only equation that represented the line in the graph was $y=-\\frac{1}{2}x+2,$ corresponding to answer choice II. Therefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186501323 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c3da477-2f8c-5b2b-8534-55a21ba63377" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186501316} {:answer/id #uuid "25f25fe2-2d7e-54ee-967f-6bb9248a110b" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186501319} {:answer/id #uuid "277c7b29-7430-521f-9d76-62c8fd5674b4" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186501320} {:answer/id #uuid "92cee00b-fc75-54a9-b753-d48fe2943e17" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186501325} {:answer/id #uuid "bae18ee6-b3b9-5327-ad96-6d55d7e27bdc" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186501330}] :answer-field/correct {:db/id #edb/ref 17592186501316} :answer-field/id #uuid "e1108d84-a4e2-5397-a2f7-9adbc9f6a9b9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186501332}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "61c31858-4aad-578b-a21e-e968c5ca8b40" :question/problem "![](images/76/7688f7536a66b7a737d58031b9b8752aabaa84a914ff5deb799e7060d7a90aeb.png)\n\nWhich of the following gives the graph of the straight line above?\n\nI. $y=-4x+\\frac{2}{3}$\n\nII. $y=-\\frac{2}{3}x+4$\n\nIII. $y=\\frac{2}{3}x+4$" :question/worked-solution "Let's pick two distinct points on the line. For example, $A$ and $B$ with coordinates $(0,4)$ and $(6,0)$, respectively.\n\n![](images/cb/cbec3e69d5f8a5bbcfc7d97d95c9f3d3ec93be63b1c8de2ceba3e3a24a9dba13.png)\n\nNow, we substitute the coordinates of both points in our equations. If both points satisfy an equation, then we can conclude that the equation represents the line in the graph. Otherwise, if any point does *not* satisfy the equation, then we can conclude that the equation does *not* represent the line in the graph.\n\n- Equation I: $y=-4x+\\frac{2}{3}.$\nSubstituting the coordinates of $A(0,4)$, we obtain\n\n$$\n\\begin{aligned}(4) & =-4(0)+\\frac{2}{3} \\\\ 4 & =\\frac{2}{3}\\,\\times \\end{aligned}\n$$\n\nTherefore, $y=-4x+\\frac{2}{3}$ is *not* equation of the line in the graph.\n\n- Equation II: $y=-\\frac{2}{3}x+4.$\nSubstituting the coordinates of $A(0,4)$ and $B(6,0)$, we obtain\n\n$$\n\\begin{aligned}(4) & =-\\frac{2}{3}(0)+4 \\\\ 4 & =4\\,✓ \\\\ (0) & =-\\frac{2}{3}(6)+4 \\\\ 0 & =-4+4 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nTherefore,$y=-\\frac{2}{3}x+4$ is an equation of the line in the graph.\n\n- Equation III: $y=\\frac{2}{3}x+4.$\nSubstituting the coordinates of $A(0,4)$ and $B(6,0)$, we obtain\n\n$$\n\\begin{aligned}(4) & =\\frac{2}{3}(0)+4 \\\\ 4 & =4\\,✓ \\\\ (0) & =\\frac{2}{3}(6)+4 \\\\ 0 & =4+4 \\\\ 0 & =8\\,\\times \\end{aligned}\n$$\n\nTherefore, $y=\\frac{2}{3}x+4$ is *not* equation of the line in the graph.\n\nOf the given equations, the only equation that represented the line in the graph was $y=-\\frac{2}{3}x+4,$ corresponding to answer choice II. Therefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186501329 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "015abcb0-80a5-5dc1-b79f-79d7198d8b47" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186501315} {:answer/id #uuid "1d75fe37-e4ce-5bc4-98f8-d2fb16b56012" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186501318} {:answer/id #uuid "7d397adc-2e01-5cd8-a945-f4855a2fd4b8" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186501324} {:answer/id #uuid "9b3194ba-e75e-59ea-b78e-7f3fe9b442f5" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186501327} {:answer/id #uuid "e6c58012-7269-5610-aef9-dbc7d838d8f5" :answer/type {:db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186501333}] :answer-field/correct {:db/id #edb/ref 17592186501333} :answer-field/id #uuid "f1a010cc-cba0-5af2-91cb-dae10509e3db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186501334}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b3d6f732-ed9f-51fe-87bd-f9f387742c79" :question/problem "![](images/87/87cbbd5a53079bb2cd744e1af18e901f6e54239a0fc6330984659c75cbdd3509.png)\n\nWhich of the following gives the graph of the straight line above?\n\nI. $y+3x=9$\n\nII. $\\frac{1}{3}y+x=3$\n\nIII. $y=-3x+9$" :question/worked-solution "Let's pick two distinct points on the line. For example, $A$ and $B$ with coordinates $(0,9)$ and $(3,0)$, respectively.\n\n![](images/c3/c3a0113d32377bd9bac1569081dce1caad04e1cd385805fbb225c3964e7f85d7.png)\n\nNow, we substitute the coordinates of both points in our equations. If both points satisfy an equation, then we can conclude that the equation represents the line in the graph. Otherwise, if any point does *not* satisfy the equation, then we can conclude that the equation does *not* represent the line in the graph.\n\n- Equation I: $y+3x=9.$\nSubstituting the coordinates of $A(0,9)$ and $B(3,0)$, we obtain\n\n$$\n\\begin{aligned}(9)+3(0) & =9 \\\\ 9 & =9\\,✓ \\\\ (0)+3(3) & =9 \\\\ 9 & =9\\,✓\\end{aligned}\n$$\n\nTherefore, $y+3x=9$ is an equation of the line in the graph.\n\n- Equation II: $\\frac{1}{3}y+x=3.$\nSubstituting the coordinates of $A(0,9)$ and $B(3,0)$, we obtain\n\n$$\n\\begin{aligned}\\frac{1}{3}(9)+(0) & =3 \\\\ 3+0 & =3 \\\\ 3 & =3\\,✓ \\\\ \\frac{1}{3}(0)+(3) & =3 \\\\ 0+3 & =3 \\\\ 3 & =3\\,✓\\end{aligned}\n$$\n\nTherefore,$\\frac{1}{3}y+x=3$ is an equation of the line in the graph.\n\n- Equation III: $y=-3x+9.$\nSubstituting the coordinates of $A(0,9)$ and $B(3,0)$, we obtain\n\n$$\n\\begin{aligned}(9) & =-3(0)+9 \\\\ 9 & =9\\,✓ \\\\ (0) & =-3(3)+9 \\\\ 0 & =-9+9 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nTherefore, $y=-3x+9$ is  an equation of the line in the graph.\n\nAll the given equations represented the line in the graph. Therefore, the correct answer is \"I, II and III.\""} {:db/id #edb/ref 17592186501335 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "116550ec-7c28-5e18-9fdd-f2d1f181ab88" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186501317} {:answer/id #uuid "4566a58e-dd27-57f2-8c17-67e13d84f401" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186501321} {:answer/id #uuid "9a9607e4-f2bb-5686-8bd2-b386551546bd" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186501326} {:answer/id #uuid "a8e72227-20c4-5321-a16a-1705dfdcf169" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186501328} {:answer/id #uuid "cf447eac-1836-54a3-8082-5758760bcbed" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186501331}] :answer-field/correct {:db/id #edb/ref 17592186501331} :answer-field/id #uuid "5912bad9-fd12-5d7e-8bfc-20dae374c49f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186501322}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ff7154d8-1178-59c1-89cf-d6727039f41b" :question/problem "![](images/f0/f0218ba02ef7305b1f22582379d15e8da24c859a239b45130c053aa5c3f8cde1.png)\n\nWhich of the following gives the graph of the straight line above?\n\nI. $y=-3x+\\frac{3}{8}$\n\nII. $y=-\\frac{3}{8}x+3$\n\nIII. $y=\\frac{3}{8}x+3$" :question/worked-solution "Let's pick two distinct points on the line. For example, $A$ and $B$ with coordinates $(0,3)$ and $(8,0)$, respectively.\n\n![](images/f1/f193f5ea70aa459427c5c4abecfdb74c3e12c6de4e22522d71f5ca1f6b1b9cc1.png)\n\nNow, we substitute the coordinates of both points in our equations. If both points satisfy an equation, then we can conclude that the equation represents the line in the graph. Otherwise, if any point does *not* satisfy the equation, then we can conclude that the equation does *not* represent the line in the graph.\n\n- Equation I: $y=-3x+\\frac{3}{8}.$\nSubstituting the coordinates of $A(0,3)$, we obtain\n\n$$\n\\begin{aligned}(3) & =-3(0)+\\frac{3}{8} \\\\ 3 & =\\frac{3}{8}\\,\\times \\end{aligned}\n$$\n\nTherefore, $y=-3x+\\frac{3}{8}$ is *not* equation of the line in the graph.\n\n- Equation II: $y=-\\frac{3}{8}x+3.$\nSubstituting the coordinates of $A(0,3)$ and $B(8,0)$, we obtain\n\n$$\n\\begin{aligned}(3) & =-\\frac{3}{8}(0)+3 \\\\ 3 & =3\\,✓ \\\\ (0) & =-\\frac{3}{8}(8)+3 \\\\ 0 & =-3+3 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nTherefore,$y=-\\frac{3}{8}x+3$ is an equation of the line in the graph.\n\n- Equation III: $y=\\frac{3}{8}x+3.$\nSubstituting the coordinates of $A(0,3)$ and $B(8,0)$, we obtain\n\n$$\n\\begin{aligned}(3) & =\\frac{3}{8}(0)+3 \\\\ 3 & =3\\,✓ \\\\ (0) & =\\frac{3}{8}(8)+3 \\\\ 0 & =3+3 \\\\ 0 & =6\\,\\times \\end{aligned}\n$$\n\nTherefore, $y=\\frac{3}{8}x+3$ is *not* equation of the line in the graph.\n\nOf the given equations, the only equation that represented the line in the graph was $y=-\\frac{3}{8}x+3,$ corresponding to answer choice II. Therefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186555859 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "347c2f0c-5a52-5eed-a5f6-845a1b198245" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186555111} {:answer/id #uuid "48db9c66-7f10-5f23-8a17-8771c3a07517" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186555157} {:answer/id #uuid "95cbbbb8-182c-54d0-b493-2f62f281a0dc" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186555357} {:answer/id #uuid "db217f00-30c9-50d9-a7c1-29d4b1d834be" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186555531} {:answer/id #uuid "dbc989c2-ca66-5d8e-9dc2-695894977ce3" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186555533}] :answer-field/correct {:db/id #edb/ref 17592186555157} :answer-field/id #uuid "6cfeab61-6e76-5a26-9da7-d3d287d0e865" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186555692}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d96a4476-f395-552e-94ef-9cd8de4e9f95" :question/math-academy-id "q-54292" :question/problem "![](images/ac/ac28d44b12c5804a36cc9ae7a3655237449bfe5f1933df81d70ece5ee18ed981.png)\n\nWhich of the following gives the graph of the straight line above?\n\nI. $y=-4x+2$\n\nII. $y=x+4$\n\nIII. $y=-2x+4$" :question/worked-solution "Let's pick two distinct points on the line. For example, $A$ and $B$ with coordinates $(0,4)$ and $(2,0)$, respectively.\n\n![](images/47/4719dc10bbf4078e6b266a36b50a82e117b3e775395a8a3e44c0dff4ae56f15b.png)\n\nNow, we substitute the coordinates of both points in our equations. If both points satisfy an equation, then we can conclude that the equation represents the line in the graph. Otherwise, if any point does *not* satisfy the equation, then we can conclude that the equation does *not* represent the line in the graph.\n\n- Equation I: $y=-4x+2.$\nSubstituting the coordinates of $A(0,4)$, we obtain\n\n$$\n\\begin{aligned}(4) & =-4(0)+2 \\\\ 4 & =2\\,\\times \\end{aligned}\n$$\n\nTherefore, $y=-4x+2$ is *not* equation of the line in the graph.\n\n- Equation II: $y=x+4.$\nSubstituting the coordinates of $A(0,4)$ and $B(2,0)$, we obtain\n\n$$\n\\begin{aligned}(4) & =(0)+4 \\\\ 4 & =4\\,✓ \\\\ (0) & =(2)+4 \\\\ 0 & =6\\,\\times \\end{aligned}\n$$\n\nTherefore, $y=x+4$ is *not* equation of the line in the graph.\n\n- Equation III: $y=-2x+4.$\nSubstituting the coordinates of $A(0,4)$ and $B(2,0)$, we obtain\n\n$$\n\\begin{aligned}(4) & =-2(0)+4 \\\\ 4 & =4\\,✓ \\\\ (0) & =-2(2)+4 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nTherefore, $y=-2x+4$ is an equation of the line in the graph.\n\nOf the given equations, the only equation that represented the line in the graph was $y=-2x+4,$ corresponding to answer choice III. Therefore, the correct answer is \"III only.\""}] :knowledge-point/title "Identifying a Line Given a Graph"}] :topic/math-academy-id 95 :topic/next [{:db/id #edb/ref 17592186048678} {:db/id #edb/ref 17592186050103} {:db/id #edb/ref 17592186050763}] :topic/title "Graphing Linear Equations"}
