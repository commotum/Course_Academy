e2c35e" :step/math-academy-id 37509 :step/next {:db/id #edb/ref 17592186125391}}] :activity/title "The Invertible Matrix Theorem in Terms of Dimension, Rank and Nullity" :activity/type {:db/id #edb/ref 17592186045463} :db/id #edb/ref 17592186124685} {:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186435679} :activity/id #uuid "26e5acff-8db9-5e5d-9122-36baf139baac" :activity/scope {:db/id #edb/ref 17592186049340} :activity/steps [{:db/id #edb/ref 17592186435677 :step/content {:db/id #edb/ref 17592186435676 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2b28520-430a-5247-a200-fd5f414e5ada" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186454012} {:answer/id #uuid "f8033251-ab93-5bb9-a145-e5e99be3d388" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186454013}] :answer-field/correct {:db/id #edb/ref 17592186454012} :answer-field/id #uuid "da3c91e0-c158-561e-ab32-6e72b9ba78b5" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454756} {:answer-field/choices [{:answer/id #uuid "647ee441-bfd6-5c35-84c4-0fc1e7479328" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186454014} {:answer/id #uuid "f0e66778-9876-5718-a6e2-1e95fc527bdb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186454015}] :answer-field/correct {:db/id #edb/ref 17592186454014} :answer-field/id #uuid "030534f1-c9cc-5372-9ff2-bdc749c441e3" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454757} {:answer-field/choices [{:answer/id #uuid "31d47ce5-4beb-5f68-bae7-0d361ea95c62" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186454016} {:answer/id #uuid "f6dcdf0f-841a-5b0d-aff9-db735d828b23" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186454017}] :answer-field/correct {:db/id #edb/ref 17592186454017} :answer-field/id #uuid "eced16f4-9e93-50d2-bf88-cdda3960f7ec" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454758}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ea4581af-a083-51da-803f-0f83b3ed2ea6" :question/math-academy-id "q-79349" :question/problem "Which of the following statements are true, given that $A$ is a $5\\times 5$ matrix and  $det(A)=1?$\n\nSelect all that apply.\n\n- **I.** $A$ is not invertible\n\n- **II.** $\\text{rank}(A)=4$\n\n- **III.** $A$ has $5$ pivot columns" :question/worked-solution "Since $A$ is a $5\\times 5$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{5} \\\\  & \\text{dim(Col}(A))=5=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each statement in turn. \n\n- Statement I is false. Indeed,   a matrix $A$ is invertible if and only if $det(A)\\ne 0.$ Since here we have $det(A)=1\\ne 0,$ our matrix $A$ must be  invertible.\n\n- Statement II is false. Indeed, by the invertible matrix theorem\n$A$ is invertible $\\,⇔\\,\\text{rank}(A)=5.$\n\n- Statement III is true. Since $\\text{rank}(A)=5$,  it must be $\\text{dim(Col}(A))=5$ which, in turn, means that  $A$ has $5$ pivot columns.\n\nTherefore, the correct answer is \"III only.\""} :step/id #uuid "42d8e8b3-7048-5f94-884b-ae373fb59042" :step/next {:db/id #edb/ref 17592186435678}} {:db/id #edb/ref 17592186435678 :step/content {:db/id #edb/ref 17592186272239 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f87f060-5b8c-5b4a-806f-8cf93ee4d70d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449634} {:answer/id #uuid "4360a160-1403-523e-8e62-4fbb2ec722d7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449635}] :answer-field/correct {:db/id #edb/ref 17592186449635} :answer-field/id #uuid "359ebe96-94aa-58ea-b60b-be863ac84a52" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450771} {:answer-field/choices [{:answer/id #uuid "bb552ac2-1033-5cf0-95e3-c64844f7abfd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449636} {:answer/id #uuid "e0cf0040-9b44-519e-ab54-532b2b101a3a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449637}] :answer-field/correct {:db/id #edb/ref 17592186449637} :answer-field/id #uuid "65159a93-fba0-5a45-abcc-86fe85e1adb6" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450772} {:answer-field/choices [{:answer/id #uuid "39e5820e-dedb-509b-bef8-5b24f4aea7b2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449638} {:answer/id #uuid "319a4d81-4806-58b2-9a6b-94494e8c5b9e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449639}] :answer-field/correct {:db/id #edb/ref 17592186449638} :answer-field/id #uuid "d8aa8650-12f8-56c0-ac84-85ed73892db0" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450773}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8dad0d98-37c5-5af9-9c0a-4f0fabec2bcc" :question/math-academy-id "q-141200" :question/problem "Which of the following statements are true, given that $A$ is a $6\\times 6$ matrix and  $det(A)=-1?$\n\nSelect all that apply.\n\n- **I.** $A$ is invertible\n\n- **II.** $\\text{Null}(A)=\\{0\\}$\n\n- **III.** $\\text{nullity}(A)=6$" :question/worked-solution "Since $A$ is a $6\\times 6$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{6} \\\\  & \\text{dim(Col}(A))=6=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each statement in turn. \n\n- Statement I is true. Indeed,   a matrix $A$ is invertible if and only if $det(A)\\ne 0.$ Since here we have $det(A)=-1\\ne 0,$ our matrix $A$ must be  invertible.\n\n- Statement II is true. Indeed, by the invertible matrix theorem\n$A$ is invertible $\\,⇔\\,\\text{Null}(A)=\\{0\\}.$\n\n- Statement III is false. Since $A$ is invertible,  it must be $\\text{nullity}(A)=0.$\n\nTherefore, the correct answer is \"I and II only.\""} :step/id #uuid "9a467517-2fb7-54c3-b455-e47e7392ef56"} {:db/id #edb/ref 17592186435679 :step/content {:db/id #edb/ref 17592186124863 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "235a52da-656a-5cf2-a401-0f42a3642391" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186459823} {:answer/id #uuid "04790f9e-17da-5ed1-82d4-a7391bccbd0c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186459824}] :answer-field/correct {:db/id #edb/ref 17592186459823} :answer-field/id #uuid "419ff1b3-8e47-5988-b4a7-49adadda7718" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460778} {:answer-field/choices [{:answer/id #uuid "e39055a2-7be3-5968-8135-398e60211c8e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186459825} {:answer/id #uuid "f28e5027-719a-5804-a84a-81f68d441b43" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186459826}] :answer-field/correct {:db/id #edb/ref 17592186459826} :answer-field/id #uuid "c6ef0960-7c5f-543c-a81b-bf7733be9b0f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460779} {:answer-field/choices [{:answer/id #uuid "3932a553-bb8b-5851-b93b-ecabd828b7b6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186459827} {:answer/id #uuid "909e13f6-b658-585b-af87-0fb072eb5e4f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186459828}] :answer-field/correct {:db/id #edb/ref 17592186459827} :answer-field/id #uuid "2c740ae4-9a04-5de5-a467-c4e121394796" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460780}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a5b63a26-4713-5ecd-9d64-befaccc0bd77" :question/math-academy-id "q-34834" :question/problem "Which of the following statements are true, given that $A$ is a $5\\times 5$ matrix and \n\n$$\n\\text{Null}(A)=\\{\\begin{bmatrix}{x}_{1} \\\\ 3{x}_{1} \\\\ 0 \\\\ {x}_{1} \\\\ -2{x}_{1}\\end{bmatrix}\\,|\\,{x}_{1}\\in R\\}?\n$$\n\nI. $\\text{dim(Null}(A))=0$\n\nII. $A$ is not invertible\n\nIII. $\\text{rank}(A)=5$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Since $A$ is a $5\\times 5$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{5} \\\\  & \\text{dim(Col}(A))=5=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since \n\n$$\n\\text{Null}(A)=\\{{x}_{1}\\begin{bmatrix}1 \\\\ 3 \\\\ 0 \\\\ 1 \\\\ -2\\end{bmatrix}\\,|\\,{x}_{1}\\in R\\}\n$$\n\nwe conclude that \n\n$$\n\\text{dim(Null}(A))=1\\ne 0.\n$$\n\n- Statement II is true. Since $\\text{dim(Null}(A))\\ne 0,$ then according to the invertible matrix theorem, the matrix $A$ can't be invertible.\n\n- Statement III is false. Since $A$ is not invertible, then by the invertible matrix theorem, we must have $\\text{rank}(A)\\ne 5.$\n\nTherefore, the correct answer is \"II only.\""} :step/id #uuid "d2193342-5bc1-5a6f-99d1-42bf1fad6047" :step/next {:db/id #edb/ref 17592186435677}}] :activity/title "The Invertible Matrix Theorem in Terms of Dimension, Rank and Nullity" :activity/type {:db/id #edb/ref 17592186045464} :db/id #edb/ref 17592186435669} {:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186485604} :activity/id #uuid "7e6f49d0-b97d-5a05-9f9c-64559727441e" :activity/scope {:db/id #edb/ref 17592186049340} :activity/steps [{:db/id #edb/ref 17592186485601 :step/content {:db/id #edb/ref 17592186426072 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40d5ed8d-7e60-5db5-b7d1-d96bb65185a3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186474362} {:answer/id #uuid "10b14067-3f7f-5868-8791-43396e0607b9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186474363}] :answer-field/correct {:db/id #edb/ref 17592186474363} :answer-field/id #uuid "bb207fd4-1ade-5c72-8528-ba143a738870" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186475107} {:answer-field/choices [{:answer/id #uuid "0948d764-f192-5b49-80f0-17ce4b9bcefb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186474364} {:answer/id #uuid "f2aade65-5d3a-520b-86ea-745a85070e15" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186474365}] :answer-field/correct {:db/id #edb/ref 17592186474364} :answer-field/id #uuid "e4b6ddd3-8ce7-5c7f-874e-23d5563021dc" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186475108} {:answer-field/choices [{:answer/id #uuid "23dc218b-818c-594c-978b-8b69736909ff" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186474366} {:answer/id #uuid "4999264b-817a-578e-85f5-209e47509eee" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186474367}] :answer-field/correct {:db/id #edb/ref 17592186474367} :answer-field/id #uuid "25ecf0bb-4395-5d51-99bd-1c0a67d30176" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186475109}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "251cfe7e-474d-59b2-8ccf-101401daf068" :question/math-academy-id "q-139978" :question/problem "Consider the following sentence:\n\n*If $A$ is a $5\\times 5$ matrix and $det(A)=0,$ then $\\underline{\\phantom{xxxxxx}}\\,.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\nI. $A$ has no inverse\n\nII. $\\text{Null}(A)$ has dimension zero\n\nIII. $A$ has less than $5$ pivot columns\n\nSelect all that apply." :question/worked-solution "The invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{5} \\\\  & \\text{dim(Col}(A))=5=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each of the options separately.\n\n- The following statement is true:\n\n*If $A$ is a $5\\times 5$ matrix and $det(A)=0,$ then $A$ has no inverse.* $\\,✓$ \n\nIndeed, since $det(A)=0,$ the matrix $A$ can't be invertible.\n\n- The following statement is false:\n\n*If $A$ is a $5\\times 5$ matrix and $det(A)=0,$ then $\\text{Null}(A)$ has dimension zero.* $\\,\\times $\n\nSince $A$ is not invertible, then according to the invertible matrix theorem, we have $\\text{Null}(A)\\ne \\{0\\}$ which, in turn,  means that $\\text{Null}(A)$ must have a basis so the dimension must be greater than zero.\n\n- The following statement is true:\n\n*If $A$ is a $5\\times 5$ matrix and $det(A)=0,$ then $A$ has less than $5$ pivot columns.* $\\,✓$\n\nIndeed, since $A$ is not invertible, then according to the invertible matrix theorem, we have $\\text{dim(Col}(A))\\ne 5,$ which means that $A$ has less than $5$ pivot columns.\n\nTherefore, the correct answer is \"I and III only.\""} :step/id #uuid "1140fa5b-f47a-5b21-a507-87491673347d" :step/next {:db/id #edb/ref 17592186485610}} {:db/id #edb/ref 17592186485604 :step/content {:db/id #edb/ref 17592186125168 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06680c4f-a621-5dc3-875e-3896db2af04b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460023} {:answer/id #uuid "5c1cf54f-05d3-5550-8f3d-cdfa3137d5bf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460024}] :answer-field/correct {:db/id #edb/ref 17592186460023} :answer-field/id #uuid "e3156979-45c5-5d24-80c1-f665fce48ba8" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460878} {:answer-field/choices [{:answer/id #uuid "88c8b9c9-048e-580b-90b5-0615fcacbfe9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460025} {:answer/id #uuid "5cd76941-0308-57d6-9b7b-3ba6c48171e1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460026}] :answer-field/correct {:db/id #edb/ref 17592186460026} :answer-field/id #uuid "44325e4a-3b71-5949-9822-a4ed24085c3a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460879} {:answer-field/choices [{:answer/id #uuid "3989b63d-47f8-5757-bb11-6a685f029eeb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460027} {:answer/id #uuid "16bc9a89-2517-5c10-b196-866970cad27b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460028}] :answer-field/correct {:db/id #edb/ref 17592186460027} :answer-field/id #uuid "a9665add-7abd-5377-b1f0-9d3eafc436be" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460880}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7f4e1182-d195-5cca-bb1a-601ea1f9c921" :question/math-academy-id "q-47599" :question/problem "Consider the following sentence:\n\n*If $A$ is a $7\\times 7$ matrix and $A$ is invertible,  then $\\underline{\\phantom{xxxxxx}}$ .*\n\nWhich of the following can be placed into the blank space to make a true statement?\n- **I.** $det(A)=0$\n- **II.** $\\text{Col}(A)={R}^{7}$\n- **III.** $A$ has $5$ pivot columns\n\nSelect all that apply." :question/worked-solution "If $A$ is an $7\\times 7$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(A)={R}^{7} \\\\  & \\text{dim(Col}(A))=7=\\text{rank}(A) \\\\  & \\text{Null}(A)={0} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each of the options separately.\n\n- The following statement is false:\n\n*If $A$ is a $7\\times 7$ matrix and $A$ is invertible,  then $det(A)=0$* $\\,\\times $ \n\nSince the matrix $A$ is invertible, it must be  $det(A)\\ne 0.$\n\n- The following statement is true:\n\n*If $A$ is a $7\\times 7$ matrix and $A$ is invertible,  then  $\\text{Col}(A)={R}^{7}.$* $\\,✓$\n\nIndeed, since $A$ is invertible, then according to the invertible matrix theorem,  we have $\\text{Col}(A)={R}^{7}.$\n\n- The following statement is false:\n\n*If $A$ is a $7\\times 7$ matrix and $A$ is invertible,  then $A$ has $5$ pivot columns.* $\\,\\times $ \n\nSince $A$ is invertible, then according to the invertible matrix theorem, we have $\\text{dim(Col}(A))=7,$ which means that $A$ has exactly $7$ pivot columns.\n\nTherefore, the correct answer is \"II only.\""} :step/id #uuid "1b87589b-dcb5-58d7-a287-28c231b8ee26" :step/next {:db/id #edb/ref 17592186485629}} {:db/id #edb/ref 17592186485610 :step/content {:db/id #edb/ref 17592186272338 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07f8d9af-560e-5e04-801f-49c3569ea09a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186464240} {:answer/id #uuid "3683cdbb-cea0-5d3a-88ae-46bbf35523a6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186464241}] :answer-field/correct {:db/id #edb/ref 17592186464240} :answer-field/id #uuid "7d8b8cb5-e75e-518a-91a0-160dae2c2bc4" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186465054} {:answer-field/choices [{:answer/id #uuid "7bba33a3-e841-5573-8abf-90651ed20a6d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186464242} {:answer/id #uuid "0c34db9f-4df3-5319-9c26-896a5b27e435" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186464243}] :answer-field/correct {:db/id #edb/ref 17592186464242} :answer-field/id #uuid "05d917c1-327f-5ee0-8aed-ef99e81a107b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186465055} {:answer-field/choices [{:answer/id #uuid "de2f17c6-86e7-560e-b3af-0ab0f7aab9fa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186464244} {:answer/id #uuid "06de2a3a-d315-52ff-898b-03d434ea28ab" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186464245}] :answer-field/correct {:db/id #edb/ref 17592186464245} :answer-field/id #uuid "4bcd47e5-e550-5069-9017-2362f6f7a623" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186465056}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0c320bbb-0961-56b0-99e4-beaa75aa8f10" :question/math-academy-id "q-142358" :question/problem "Which of the following statements are true, given that $A$ is a $5\\times 5$ matrix and \n\n$$\n\\text{Null}(A)={\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ 0 \\\\ 2{x}_{2} \\\\ {x}_{1}\\end{bmatrix}\\,|\\,{x}_{1},{x}_{2}\\in R}?\n$$\n- **I.** $\\text{dim(Null}(A))=0$\n- **II.** $A$ is  invertible\n- **III.** $\\text{Col}(A)\\ne {R}^{5}$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Since $A$ is a $5\\times 5$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(A)={R}^{5} \\\\  & \\text{dim(Col}(A))=5=\\text{rank}(A) \\\\  & \\text{Null}(A)={0} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since \n\n$$\n\\text{Null}(A)={{x}_{1}\\begin{bmatrix}1 \\\\ 0 \\\\ 0 \\\\ 0 \\\\ 1\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ 1 \\\\ 0 \\\\ 2 \\\\ 0\\end{bmatrix}\\,|\\,{x}_{1},{x}_{2}\\in R}\n$$\n\nwe conclude that \n\n$$\n\\text{dim(Null}(A))=2\\ne 0.\n$$\n\n- Statement II is false. Since $\\text{dim(Null}(A))\\ne 0,$ then according to the invertible matrix theorem, the matrix $A$ can't be invertible.\n\n- Statement III is true. Since $A$ is not invertible, then by the invertible matrix theorem, we must have $\\text{Col}(A)\\ne {R}^{5}.$\n\nTherefore, the correct answer is \"III only.\""} :step/id #uuid "2fdad5e3-18b8-51dd-aadf-07ba0badc4d5" :step/next {:db/id #edb/ref 17592186485630}} {:db/id #edb/ref 17592186485629 :step/content {:db/id #edb/ref 17592186435676 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2b28520-430a-5247-a200-fd5f414e5ada" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186454012} {:answer/id #uuid "f8033251-ab93-5bb9-a145-e5e99be3d388" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186454013}] :answer-field/correct {:db/id #edb/ref 17592186454012} :answer-field/id #uuid "da3c91e0-c158-561e-ab32-6e72b9ba78b5" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454756} {:answer-field/choices [{:answer/id #uuid "647ee441-bfd6-5c35-84c4-0fc1e7479328" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186454014} {:answer/id #uuid "f0e66778-9876-5718-a6e2-1e95fc527bdb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186454015}] :answer-field/correct {:db/id #edb/ref 17592186454014} :answer-field/id #uuid "030534f1-c9cc-5372-9ff2-bdc749c441e3" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454757} {:answer-field/choices [{:answer/id #uuid "31d47ce5-4beb-5f68-bae7-0d361ea95c62" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186454016} {:answer/id #uuid "f6dcdf0f-841a-5b0d-aff9-db735d828b23" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186454017}] :answer-field/correct {:db/id #edb/ref 17592186454017} :answer-field/id #uuid "eced16f4-9e93-50d2-bf88-cdda3960f7ec" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454758}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ea4581af-a083-51da-803f-0f83b3ed2ea6" :question/math-academy-id "q-79349" :question/problem "Which of the following statements are true, given that $A$ is a $5\\times 5$ matrix and  $det(A)=1?$\n\nSelect all that apply.\n\n- **I.** $A$ is not invertible\n\n- **II.** $\\text{rank}(A)=4$\n\n- **III.** $A$ has $5$ pivot columns" :question/worked-solution "Since $A$ is a $5\\times 5$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{5} \\\\  & \\text{dim(Col}(A))=5=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each statement in turn. \n\n- Statement I is false. Indeed,   a matrix $A$ is invertible if and only if $det(A)\\ne 0.$ Since here we have $det(A)=1\\ne 0,$ our matrix $A$ must be  invertible.\n\n- Statement II is false. Indeed, by the invertible matrix theorem\n$A$ is invertible $\\,⇔\\,\\text{rank}(A)=5.$\n\n- Statement III is true. Since $\\text{rank}(A)=5$,  it must be $\\text{dim(Col}(A))=5$ which, in turn, means that  $A$ has $5$ pivot columns.\n\nTherefore, the correct answer is \"III only.\""} :step/id #uuid "a6dcb993-e91b-5b36-8076-9c0539317c39" :step/next {:db/id #edb/ref 17592186485601}} {:db/id #edb/ref 17592186485630 :step/content {:db/id #edb/ref 17592186426076 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13e3d0a6-c269-5dde-bafd-a91861927c14" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186426036} {:answer/id #uuid "1848f756-51a0-5639-8084-5aa59abdaebf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186426037} {:answer/id #uuid "562361ed-d031-5fb2-9175-4571a3994648" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186426047} {:answer/id #uuid "8a7285e7-4a5d-5073-aa0f-ffd3853ddc65" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "lI only" :db/id #edb/ref 17592186426054} {:answer/id #uuid "f1d58843-37c3-5988-8dac-72db97dcd1cf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186426064}] :answer-field/correct {:db/id #edb/ref 17592186426064} :answer-field/id #uuid "fec9750c-eaeb-571d-b465-6fa1ab05e88d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186426071}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9fbccd10-1c43-51a4-ad8b-36063e11427d" :question/math-academy-id "q-142367" :question/problem "Which of the following statements are true, given that $A$ is a $4\\times 4$ matrix and $v=\\begin{bmatrix}1 \\\\ 0 \\\\ 1 \\\\ -1\\end{bmatrix}$ is a solution of the equation $Ax=0?$\n\nI. $\\text{dim(Null}(A))\\ne 0$\n\nII. $A$  is  invertible\n\nIII. $\\text{Col}(A)={R}^{4}$" :question/worked-solution "Since $A$ is a $4\\times 4$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{4} \\\\  & \\text{dim(Col}(A))=4=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn. \n\n- Statement I is true. Since $v\\ne 0$ and $Av=0,$ \nthen $v\\in \\text{Null}(A)$ and, therefore, $\\text{dim(Null}(A))\\ne 0.$\n\n- Statement II is false. Since $\\text{dim(Null}(A))\\ne 0,$ then according to the invertible matrix theorem, the matrix $A$ can't be invertible.\n\n- Statement III is false. Since $A$ is not invertible, then by the invertible matrix theorem, we must have $\\text{Col}(A)\\ne {R}^{4}.$\n\nTherefore, the correct answer is \"I only.\""} :step/id #uuid "b314981c-1803-59e7-b442-57ac10b70607"}] :activity/title "The Invertible Matrix Theorem in Terms of Dimension, Rank and Nullity" :activity/type {:db/id #edb/ref 17592186045464} :db/id #edb/ref 17592186484809} {:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186529204} :activity/id #uuid "266f8ba6-aa38-58ed-8d33-3aec933a1e12" :activity/scope {:db/id #edb/ref 17592186049340} :activity/steps [{:db/id #edb/ref 17592186529197 :step/content {:db/id #edb/ref 17592186272348 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d248bbb6-50b4-5d61-a95e-58f318131503" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186464246} {:answer/id #uuid "7e5d0dfe-318f-5100-ac82-83455377b98c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186464247}] :answer-field/correct {:db/id #edb/ref 17592186464247} :answer-field/id #uuid "2d37791a-a285-5a2f-af41-bcd2d8afc075" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186465057} {:answer-field/choices [{:answer/id #uuid "3957e353-c39b-5011-af11-d2c9b6787af4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186464248} {:answer/id #uuid "8a540690-cbd6-5a7b-8e6a-735ce1ef7a6a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186464249}] :answer-field/correct {:db/id #edb/ref 17592186464248} :answer-field/id #uuid "8cfe4de2-b1c4-55bb-a60d-27c7be7257dc" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186465058} {:answer-field/choices [{:answer/id #uuid "4f6788d6-5506-57b7-9972-0d793d0b67f8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186464250} {:answer/id #uuid "67197e1a-6b46-5a73-9b9e-21d0f7711026" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186464251}] :answer-field/correct {:db/id #edb/ref 17592186464251} :answer-field/id #uuid "41d8c4a3-f095-50cd-bcf7-92ff6b429b75" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186465059}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "795129ab-7204-5692-a97c-e32525213e2a" :question/math-academy-id "q-142475" :question/problem "Consider the following sentence:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then  $\\underline{\\phantom{xxxxxx}}\\,.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n- **I.** $A$ is invertible\n- **II.** $\\text{rank}(A)<n$\n- **III.** $\\text{Col}(A)={R}^{n}$\n\nSelect all that apply." :question/worked-solution "The invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(A)={R}^{n} \\\\  & \\text{dim(Col}(A))=n=\\text{rank}(A) \\\\  & \\text{Null}(A)={0} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each of the options separately.\n\n- The following statement is true:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then $A$ is invertible.* $\\,✓$ \n\nIndeed, according to the invertible matrix theorem, \n\n$A$ is invertible $\\,⇔\\,\\text{dim(Null}(A))=0=\\text{nullity}(A).$\n\n- The following statement is false:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then $\\text{rank}(A)<n.$* $\\,\\times $ \n\nIndeed, since $A$ is invertible, then according to the invertible matrix theorem, we have $\\text{rank}(A)=n.$\n\n- The following statement is true:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then $\\text{Col}(A)={R}^{n}.$*  $\\,✓$ \n\nIndeed, since $A$ is invertible, then according to the invertible matrix theorem, we have $\\text{Col}(A)={R}^{n}.$\n\nTherefore, the correct answer is \"I and III only.\""} :step/id #uuid "0a7d2e71-2df5-5616-a66c-1039ae6b7480"} {:db/id #edb/ref 17592186529199 :step/content {:db/id #edb/ref 17592186529139 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c0bd5dd-c5f7-5e5d-b21c-bcdb4e2b830b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186528560} {:answer/id #uuid "7385e402-bf26-5641-9a0b-660e87ee9d07" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186528567} {:answer/id #uuid "e0746457-062b-51a1-b39b-1801dcc9dd24" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186528849} {:answer/id #uuid "e15f2509-6136-5ef5-b754-59b129df8ee9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186528852} {:answer/id #uuid "f4fb30e2-e856-5197-b6a2-1b2e5bd62f64" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186528903}] :answer-field/correct {:db/id #edb/ref 17592186528849} :answer-field/id #uuid "255a02e5-2e2c-5989-905e-69f5223274a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186528960}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "74f4be02-4fe9-5741-a4d1-7268f77a2f5f" :question/math-academy-id "q-142472" :question/problem "Which of the following statements are true, given that $A$ is a $3\\times 3$ matrix and  $det(A)=-1?$ \n\nI. $A$ is **not** invertible\n\nII. $\\text{rank}(A)=3$\n\nIII. $A$ has $4$ pivot columns" :question/worked-solution "Since $A$ is a $3\\times 3$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{3} \\\\  & \\text{dim(Col}(A))=3=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each statement in turn. \n\n- Statement I is false. Indeed,   a matrix $A$ is invertible if and only if $det(A)\\ne 0.$ Since here we have $det(A)=-1\\ne 0,$ our matrix $A$ must be invertible.\n\n- Statement II is true. Indeed, by the invertible matrix theorem\n$A$ is invertible $\\,⇔\\,\\text{rank}(A)=3.$\n\n- Statement III is false. Since $\\text{rank}(A)=3$,  it must be $\\text{dim(Col}(A))=3$ which, in turn, means that  $A$ has $3$ pivot columns, not $4.$\n\nTherefore, the correct answer is \"II only.\""} :step/id #uuid "2a21ddf3-d51f-5117-8439-7fd92a4b2b2d" :step/next {:db/id #edb/ref 17592186529197}} {:db/id #edb/ref 17592186529200 :step/content {:db/id #edb/ref 17592186529191 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d885553-3afc-5696-a382-4c860965f60c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186528520} {:answer/id #uuid "7bf00a72-f79f-582d-9aaa-38874ff20b92" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186528592} {:answer/id #uuid "7df12baa-7b1b-58dc-8f63-3871724e61dd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186528598} {:answer/id #uuid "c974d506-c2bc-5e7b-97a4-c51ae5371031" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186528794} {:answer/id #uuid "e94c076f-c6c7-517d-8c55-d74158a4a6fe" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186528875}] :answer-field/correct {:db/id #edb/ref 17592186528520} :answer-field/id #uuid "20580d7d-28aa-5c7c-a048-784d0bfa2d4b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186528956}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f1d7f6a4-6114-5671-a52c-7df48bee5e24" :question/math-academy-id "q-141342" :question/problem "Consider the following sentence:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)\\ne 0,$ then  $\\underline{\\phantom{xxxxxx}}\\,.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\nI. $\\text{Null}(A)$ has no basis\n\nII. $A$ is **not** invertible\n\nIII. All columns of $A$ are pivot columns" :question/worked-solution "The invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{n} \\\\  & \\text{dim(Col}(A))=n=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each of the options separately. \n\n- The following statement is false:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then $\\text{Null}(A)$ has no basis.* $\\,\\times $ \n\nSince $\\text{nullity}(A)\\ne 0,$ we have $\\text{Null}(A)\\ne \\{0\\}$ which, in turn, means that $\\text{Null}(A)$ must have a basis.\n\n- The following statement is true:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then $A$ is **not** invertible.* $\\,✓$\n\nIndeed, by the invertible matrix theorem, since $\\text{nullity}(A)\\ne 0,$ we must have that $A$ is **not** invertible.\n\n- The following statement is false:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then all columns of $A$ are pivot columns.* $\\,\\times $\n\nSince $A$ is not invertible, then according to the invertible matrix theorem, we have $\\text{Col}(A)\\ne {R}^{n},$ which means that not all columns of $A$ are pivot columns.\n\nTherefore, the correct answer is \"II only.\""} :step/id #uuid "94778ac8-3dd7-5564-88c5-443046b2e6fe" :step/next {:db/id #edb/ref 17592186529199}} {:db/id #edb/ref 17592186529203 :step/content {:db/id #edb/ref 17592186272238 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c0a6001-3780-5910-af1b-80f1dc86bb46" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449628} {:answer/id #uuid "711f6d61-9af9-514f-ab7b-3f6b87059a2c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449629}] :answer-field/correct {:db/id #edb/ref 17592186449628} :answer-field/id #uuid "577301d3-bda4-5711-b8ea-c8d7c59e3764" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450768} {:answer-field/choices [{:answer/id #uuid "0fd05ec0-7412-5317-bd1f-6fdd48ffae9e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449630} {:answer/id #uuid "7e775f74-22c8-5e41-92ca-9b7679c5d763" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449631}] :answer-field/correct {:db/id #edb/ref 17592186449631} :answer-field/id #uuid "11747fa2-61fa-56a5-ab66-ef191899dff3" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450769} {:answer-field/choices [{:answer/id #uuid "17f12245-1e0f-5cf0-8c20-1a321c65854b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449632} {:answer/id #uuid "2e93e8a1-abd3-5bae-8c25-a6156dc77f12" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449633}] :answer-field/correct {:db/id #edb/ref 17592186449633} :answer-field/id #uuid "71691d56-9200-5496-becc-0f211d28a39b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450770}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f63719f4-7a1e-5b43-8302-7786de4d0619" :question/math-academy-id "q-141199" :question/problem "Which of the following statements are true, given that $A$ is a $4\\times 4$ matrix and $v=\\begin{bmatrix}1 \\\\ 0 \\\\ -1 \\\\ 0\\end{bmatrix}$ is a solution of the equation $Ax=0?$\n\nSelect all that apply.\n\n- **I.** $\\text{Null}(A)={0}$\n- **II.** $A$ is not invertible\n- **III.** $\\text{Col}(A)\\ne {R}^{4}$" :question/worked-solution "Since $A$ is a $4\\times 4$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(A)={R}^{4} \\\\  & \\text{dim(Col}(A))=4=\\text{rank}(A) \\\\  & \\text{Null}(A)={0} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn. \n\n- Statement I is false. Since $v\\ne 0$ and $Av=0,$ \nthen $v\\in \\text{Null}(A)$ and, therefore, $\\text{Null}(A)\\ne {0}.$\n\n- Statement II is true. Since $\\text{Null}(A)\\ne {0},$ then according to the invertible matrix theorem, the matrix $A$ can't be invertible.\n\n- Statement III is true. Since $A$ is not invertible, then by the invertible matrix theorem, we must have $\\text{Col}(A)\\ne {R}^{4}.$\n\nTherefore, the correct answer is \"II and III only.\""} :step/id #uuid "cb8b82a3-c3e9-567b-8dbd-19ce7dce93de" :step/next {:db/id #edb/ref 17592186529200}} {:db/id #edb/ref 17592186529204 :step/content {:db/id #edb/ref 17592186329820 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86d1fafe-67a4-5304-b42b-0fa34a95eaff" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467578} {:answer/id #uuid "c76c9ea4-d5d0-5c09-adc5-db52b1568fa5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467579}] :answer-field/correct {:db/id #edb/ref 17592186467579} :answer-field/id #uuid "3df948ff-c1ab-538f-b99e-ed07682677fc" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468510} {:answer-field/choices [{:answer/id #uuid "6428bf6c-1cd8-523e-89a2-bbd6aefca97b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467580} {:answer/id #uuid "49e7f113-867c-5ee0-a738-ba5b88651827" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467581}] :answer-field/correct {:db/id #edb/ref 17592186467580} :answer-field/id #uuid "2e8c77e6-a0b4-526b-bf8e-a435b7b66ac1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468511} {:answer-field/choices [{:answer/id #uuid "7b22f319-2182-5f2f-984d-2c69a38c95bc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467582} {:answer/id #uuid "f8184f79-583b-5721-92be-e461d3dc1a14" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467583}] :answer-field/correct {:db/id #edb/ref 17592186467582} :answer-field/id #uuid "d58f3fca-628f-5dd4-9837-348f91ad595e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468512}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2c600e13-fdff-5526-82d0-6659ac10dfc3" :question/math-academy-id "q-47587" :question/problem "Consider the following sentence:\n\n*If $A$ is a $n\\times n$ matrix and $det(A)=0,$ then $\\underline{\\phantom{xxxxxx}}\\,.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\nI. $A$ has no inverse\n\nII. $\\text{rank}(A)=n$\n\nIII. All columns of $A$ are pivot columns\n\nSelect all that apply." :question/worked-solution "The invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{n} \\\\  & \\text{dim(Col}(A))=n=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each of the options separately.\n\n- The following statement is true:\n\n*If $A$ is a $n\\times n$ matrix and $det(A)=0,$ then $A$ has no inverse.* $\\,✓$  \n\nIndeed,  a matrix $A$ is invertible if and only if $det(A)\\ne 0.$\n\n- The following statement is false:\n\n*If $A$ is a $n\\times n$ matrix and $det(A)=0,$ then $\\text{rank}(A)=n.$*$\\,\\times $\n\nSince our matrix is not invertible, according to the invertible matrix theorem, it must be $\\text{rank}(A)\\ne n.$\n\n- The following statement is false:\n\n*If $A$ is a $n\\times n$ matrix and $det(A)=0,$ then all columns of $A$ are pivot columns.*  $\\,\\times $\n\nSince $\\text{rank}(A)\\ne n$, it must be $\\text{dim(Col}(A))<n,$ which means that not all columns of $A$ are pivot columns.\n\nTherefore, the correct answer is \"I only.\""} :step/id #uuid "e46ea0a8-4991-5f8c-a308-9bc68c5b0d80" :step/next {:db/id #edb/ref 17592186529203}}] :activity/title "The Invertible Matrix Theorem in Terms of Dimension, Rank and Nullity" :activity/type {:db/id #edb/ref 17592186045464} :db/id #edb/ref 17592186528296}] :db/id #edb/ref 17592186049340 :topic/difficulty 0.5118524148844472 :topic/id #uuid "ecf075bf-6d18-5a77-93a9-57ef73f45115" :topic/knowledge-points [{:db/id #edb/ref 17592186124511 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124320 :question/id #uuid "266a9a4e-cb11-5e4a-a2ac-c2e734966372" :question/math-academy-id "e-5424" :question/problem "Which of the following statements are true, given that $A$ is a $4 \\times 4$ matrix, and \n![](images/6a/6a294de4a5f2ff5755d8ceb5b91bb8920685a1cf2b5e727c5b5fdcfaaf0b89b0.svg)\n\nI. $A$ is not invertible\n\nII. $\\textrm{Col}(A)=\\mathbb{R}^4$\n\nIII. $\\textrm{rank}(A)=4$" :question/worked-solution "Since $A$ is a $4 \\times 4$ matrix, the invertible matrix theorem states the following: \n\n![](images/4b/4b42fd4ec8ccf491a1244a648af6fe40ce846fad388685e36d499783a095f8f7.svg)\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since \n![](images/32/327a582d15b82ebccda48358062310e6ad5c3bb2689f2024d76a8f8e7e1401a0.svg)\nwe conclude that \n\n$$\n\\textrm{dim(Null}(A))=1 \\neq 0.\n$$\n\nSo,  according to the invertible matrix theorem, the matrix $A$ is not invertible.\n\n- Statement II is false. Since the matrix $A$ is not invertible, then by the invertible matrix theorem, we must have $\\textrm{Col}(A) \\neq \\mathbb{R}^4.$\n\n- Statement III is false. Since $A$ is not invertible, then by the invertible matrix theorem, we must have $\\textrm{rank}(A) \\neq 4.$\n\nTherefore, the correct answer is \"I only.\""} :knowledge-point/id #uuid "084a0a83-5ce6-5184-beb7-8ae7b4f1a799" :knowledge-point/question-generator {:db/id #edb/ref 17592186519985 :question-generator/id #uuid "2c8a204b-6657-54da-84cb-6832f441443e" :question-generator/script "generate/scratch/17592186124511.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186124863 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "235a52da-656a-5cf2-a401-0f42a3642391" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459823} {:answer/id #uuid "04790f9e-17da-5ed1-82d4-a7391bccbd0c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459824}] :answer-field/correct {:db/id #edb/ref 17592186459823} :answer-field/id #uuid "419ff1b3-8e47-5988-b4a7-49adadda7718" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460778} {:answer-field/choices [{:answer/id #uuid "e39055a2-7be3-5968-8135-398e60211c8e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459825} {:answer/id #uuid "f28e5027-719a-5804-a84a-81f68d441b43" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459826}] :answer-field/correct {:db/id #edb/ref 17592186459826} :answer-field/id #uuid "c6ef0960-7c5f-543c-a81b-bf7733be9b0f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460779} {:answer-field/choices [{:answer/id #uuid "3932a553-bb8b-5851-b93b-ecabd828b7b6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459827} {:answer/id #uuid "909e13f6-b658-585b-af87-0fb072eb5e4f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459828}] :answer-field/correct {:db/id #edb/ref 17592186459827} :answer-field/id #uuid "2c740ae4-9a04-5de5-a467-c4e121394796" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460780}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a5b63a26-4713-5ecd-9d64-befaccc0bd77" :question/math-academy-id "q-34834" :question/problem "Which of the following statements are true, given that $A$ is a $5\\times 5$ matrix and \n\n$$\n\\text{Null}(A)=\\{\\begin{bmatrix}{x}_{1} \\\\ 3{x}_{1} \\\\ 0 \\\\ {x}_{1} \\\\ -2{x}_{1}\\end{bmatrix}\\,|\\,{x}_{1}\\in R\\}?\n$$\n\nI. $\\text{dim(Null}(A))=0$\n\nII. $A$ is not invertible\n\nIII. $\\text{rank}(A)=5$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Since $A$ is a $5\\times 5$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{5} \\\\  & \\text{dim(Col}(A))=5=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since \n\n$$\n\\text{Null}(A)=\\{{x}_{1}\\begin{bmatrix}1 \\\\ 3 \\\\ 0 \\\\ 1 \\\\ -2\\end{bmatrix}\\,|\\,{x}_{1}\\in R\\}\n$$\n\nwe conclude that \n\n$$\n\\text{dim(Null}(A))=1\\ne 0.\n$$\n\n- Statement II is true. Since $\\text{dim(Null}(A))\\ne 0,$ then according to the invertible matrix theorem, the matrix $A$ can't be invertible.\n\n- Statement III is false. Since $A$ is not invertible, then by the invertible matrix theorem, we must have $\\text{rank}(A)\\ne 5.$\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186124870 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9128cbd6-bc0c-595b-a248-301d01f8b7d2" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186121821} {:answer/id #uuid "efc1e85a-3284-5066-834c-a323d5c71513" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186121822} {:answer/id #uuid "f5bd34c7-b021-5e08-821f-eda58f26af49" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186121823} {:answer/id #uuid "f62e59b1-d023-55b4-8ab1-2cd64802f471" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186121824} {:answer/id #uuid "3284bcfa-ffff-5fae-8659-11357928e9c9" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186121825}] :answer-field/id #uuid "828bb6eb-1fea-579c-aa5b-35f52ffd61b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186121820}] :question/id #uuid "c1c9e6d5-730c-5efc-93c4-7ddaee4eba06" :question/math-academy-id "q-34936" :question/problem "Which of the following statements are true, given that $A$ is a $6 \\cdot 6$ matrix and $Col(A) = R^{6}$?\n\n1. $A$ is not invertible\n2. $rank(A) = 6$\n3. $dim(Null(A)) = 6$"} {:db/id #edb/ref 17592186272238 :question/answer-fie