{:activity/_scope [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186055590} :activity/id #uuid "6a57c066-8362-5ded-8fc6-fe55df2e5373" :activity/scope {:db/id #edb/ref 17592186049304} :activity/steps [{:db/id #edb/ref 17592186055590 :step/content {:db/id #edb/ref 17592186055974 :tutorial/content "We add two matrices by adding the corresponding entries. We can only do this if they have the same number of rows and columns, that is, they have the same dimensions.\n\nFor example, consider the matrices\n\n$$\nA = \\begin{bmatrix}1 & 3 \\\\ 2 & 4\\end{bmatrix},\\qquad B = \\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}.\n$$\n\nWe see that both $A$ and $B$ are $2\\times 2$ matrices, so we can add them. The sum ${A} + {B}\\,$ is given by\n\n$$\n\\begin{aligned}A+B & =\\begin{bmatrix}1 & 3 \\\\ 2 & 4\\end{bmatrix}+\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1+1 & 3+0 \\\\ 2+0 & 4+(-1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 3 \\\\ 2 & 3\\end{bmatrix}.\\end{aligned}\n$$\n\nIn general, the sum of two matrices is another matrix with the same dimensions." :tutorial/id #uuid "b6060e4b-f36b-5930-b8ee-1e41648bf0a8" :tutorial/math-academy-id 2971 :tutorial/title "Introduction"} :step/id #uuid "480a4714-b432-5cb5-9cea-2cd6cdd92ec1" :step/math-academy-id 16079 :step/next {:db/id #edb/ref 17592186055591}} {:db/id #edb/ref 17592186055591 :step/content {:db/id #edb/ref 17592186054648 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054545 :question/id #uuid "45832301-e578-578d-8866-147b998a1c22" :question/math-academy-id "e-4374" :question/problem "Calculate $A+B,$ where\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}1 & -5 \\\\ -2 & 3\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}-10 & 2 \\\\ 2 & -4\\end{bmatrix}$</div>\n</div>" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}A+B & =\\begin{bmatrix}1 & -5 \\\\ -2 & 3\\end{bmatrix}+\\begin{bmatrix}-10 & 2 \\\\ 2 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}1-10 & -5+2 \\\\ -2+2 & 3-4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-9 & -3 \\\\ 0 & -1\\end{bmatrix}\\end{aligned}\n$$"} :knowledge-point/id #uuid "9a248b79-7e8b-5ad8-b2e8-847ac2030783" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048896} {:db/id #edb/ref 17592186049626} {:db/id #edb/ref 17592186050421}] :knowledge-point/question-generator {:db/id #edb/ref 17592186510634 :question-generator/id #uuid "db708372-4eb8-56cd-a9c8-f30218ce088f" :question-generator/script "generate/scratch/17592186054648.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186054939 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91384223-2967-54f3-9cfd-4b94d7155b91" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-13 & 10 \\\\ 18 & -14\\end{bmatrix}" :db/id #edb/ref 17592186051165} {:answer/id #uuid "a5444269-0142-5b9e-b0ae-00cf4e9ee057" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-13 & -10 \\\\ 12 & -8\\end{bmatrix}" :db/id #edb/ref 17592186051166} {:answer/id #uuid "1625b3f0-ace3-5e0d-b28b-f10c8bb8fe1b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 & 10 \\\\ 18 & -8\\end{bmatrix}" :db/id #edb/ref 17592186051167} {:answer/id #uuid "38efa8db-8427-5a36-a324-5f166cd0b27f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-13 & 0 \\\\ 18 & -8\\end{bmatrix}" :db/id #edb/ref 17592186051168} {:answer/id #uuid "41a9e1fe-6cdb-5968-8455-0da270867d4e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-13 & 0 \\\\ 18 & -14\\end{bmatrix}" :db/id #edb/ref 17592186051169}] :answer-field/id #uuid "274c6ed5-a890-5c94-8c97-693d7305ae26" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186051164}] :question/id #uuid "2b49d98c-f8df-516b-96b1-8c04bb4fe558" :question/math-academy-id "q-101" :question/problem "What is $\\begin