e {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186425052}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6e4ed9e5-eccc-52bc-8945-b31db9b251e2" :question/math-academy-id "q-35285" :question/problem "If \n$A=\\begin{bmatrix}2 & 3 & 1 \\\\ -6 & -9 & -4 \\\\ 4 & 6 & 2\\end{bmatrix}$, then $\\text{rank}(A)=$" :question/worked-solution "To find the rank of $A,$ we first reduce it to row echelon form, as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}2 & 3 & 1 \\\\ -6 & -9 & -4 \\\\ 4 & 6 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 3 & 1 \\\\ 0 & 0 & -1 \\\\ 4 & 6 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 3 & 1 \\\\ 0 & 0 & -1 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix has $2$ pivot columns (or alternatively, it has exactly $2$ non-zero rows).\n\nTherefore, $\\text{rank}(A)=2.$"} {:db/id #edb/ref 17592186425059 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14c4ed15-45f5-58b1-8360-553b48f39d3a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186425010} {:answer/id #uuid "3f6df2aa-3a3c-5b79-95be-3aa1251322e5" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186425017} {:answer/id #uuid "50ede2f9-25a2-5752-be09-6a03468fd702" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186425021} {:answer/id #uuid "b3662759-0a3a-5444-ae02-4e604c768bf6" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186425035} {:answer/id #uuid "d0c17d6f-b6f3-5934-a787-839b47f6354b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186425041}] :answer-field/correct {:db/id #edb/ref 17592186425017} :answer-field/id #uuid "53d401b7-f4a5-53bf-90cd-e38c287d2cd7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186425047}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a35aea07-c94b-5a19-9d28-82b8ec3131d0" :question/math-academy-id "q-139966" :question/problem "If \n$W=\\begin{bmatrix}1 & 6 & -4 & 6 \\\\ 0 & -1 & -4 & 6 \\\\ -1 & -6 & 4 & -7\\end{bmatrix}$, then $\\text{rank}(W)=$" :question/worked-solution "To find the rank of $H,$ we first reduce it to row echelon form, as follows:\n\n$$\n\\begin{aligned}W & =\\begin{bmatrix}1 & 6 & -4 & 6 \\\\ 0 & -1 & -4 & 6 \\\\ -1 & -6 & 4 & -7\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{1} \\\\  & ∼\\begin{bmatrix}-1 & 6 & -4 & 6 \\\\ 0 & -1 & -4 & 6 \\\\ 0 & 0 & 0 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix has $3$ pivot columns (or alternatively, it has exactly $3$ non-zero rows).\n\nTherefore, $\\text{rank}(W)=3.$"} {:db/id #edb/ref 17592186444270 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "080f7b68-1446-53cb-a768-ddfed5710a59" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186444257} {:answer/id #uuid "58ea38e8-5330-5713-ac69-29ba41df0ffb" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186444260} {:answer/id #uuid "be020027-00e4-5988-94b8-3d6ef8dffe52" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186444261} {:answer/id #uuid "d4a9245b-945c-5b2f-a3f2-23d524e7d6ca" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186444262} {:answer/id #uuid "f29b74c5-893c-5a44-8e76-6c39f0301bb2" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186444266}] :answer-field/correct {:db/id #edb/ref 17592186444266} :answer-field/id #uuid "2af22924-1cce-522c-aadc-abcfbbca5566" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186444267}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "71b4ed44-551f-59fd-a0cd-dc5bcd55b071" :question/math-academy-id "q-35271" :question/problem "If \n$B=\\begin{bmatrix}6 & 9 & 3 \\\\ -2 & -2 & -1 \\\\ 12 & 18 & 6\\end{bmatrix}$, then $\\text{rank}(B)=$" :question/worked-solution "To find the rank of $B,$ we first reduce it to row echelon form, as follows:\n\n$$\n\\begin{aligned}B & =\\begin{bmatrix}6 & 9 & 3 \\\\ -2 & -2 & -1 \\\\ 12 & 18 & 6\\end{bmatrix} & {R}_{2} & :={R}_{2}+\\frac{1}{3}{R}_{1} \\\\  & ∼\\begin{bmatrix}6 & 9 & 3 \\\\ 0 & 1 & 0 \\\\ 12 & 18 & 6\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}6 & 9 & 3 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix has $2$ pivot columns (or alternatively, it has exactly $2$ non-zero rows).\n\nTherefore, $\\text{rank}(B)=2.$"} {:db/id #edb/ref 17592186455460 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f635389-edc5-5dc3-8b76-ade3a6532e3e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186454953} {:answer/id #uuid "33d20bdd-920e-5017-9ff8-f223643bc0e4" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186454984} {:answer/id #uuid "6e341854-6e46-5393-acbf-d555137a5f61" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186455107} {:answer/id #uuid "b3348cc7-e699-5af8-bc08-746cd7a662ec" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186455214} {:answer/id #uuid "dffb9715-18d6-51d1-8e5a-8408e61f22c4" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186455289}] :answer-field/correct {:db/id #edb/ref 17592186454984} :answer-field/id #uuid "ad46ea88-b115-5458-b648-47a63580c1e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186455399}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "5f02772c-72fa-5f47-bb75-202fca199929" :question/math-academy-id "q-35273" :question/problem "If \n$F=\\begin{bmatrix}-2 & 4 & 3 & 1 \\\\ 0 & -2 & -2 & -1 \\\\ 6 & 2 & 4 & 1 \\\\ 0 & -1 & -1 & -\\frac{1}{2}\\end{bmatrix}$, find $\\text{rank}(F).$" :question/worked-solution "To find the rank of $F,$ we first reduce it to row echelon form, as follows:\n\n$$\n\\begin{aligned}F & =\\begin{bmatrix}-2 & 4 & 3 & 1 \\\\ 0 & -2 & -2 & -1 \\\\ 6 & 2 & 4 & 1 \\\\ 0 & -1 & -1 & -\\frac{1}{2}\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & 4 & 3 & 1 \\\\ 0 & -2 & -2 & -1 \\\\ 0 & 14 & 13 & 4 \\\\ 0 & -1 & -1 & -\\frac{1}{2}\\end{bmatrix} & {R}_{3} & :={R}_{3}+7{R}_{2} \\\\  & ∼\\begin{bmatrix}-2 & 4 & 3 & 1 \\\\ 0 & -2 & -2 & -1 \\\\ 0 & 0 & -1 & -3 \\\\ 0 & -1 & -1 & -\\frac{1}{2}\\end{bmatrix} & {R}_{4} & :={R}_{4}+(-\\frac{1}{2}){R}_{2} \\\\  & ∼\\begin{bmatrix}-2 & 4 & 3 & 1 \\\\ 0 & -2 & -2 & -1 \\\\ 0 & 0 & -1 & -3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix has $3$ pivot columns (or alternatively, it has exactly $3$ non-zero rows).\n\nTherefore, $\\text{rank}(F)=3.$"} {:db/id #edb/ref 17592186455491 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11b79355-4888-598e-841c-ba082e6d64ed" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186454938} {:answer/id #uuid "254d92b0-82e1-5787-acba-023cab6318a1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186454961} {:answer/id #uuid "8a974be9-6c67-5eb6-9aec-a1c2a1fea1c1" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186455156} {:answer/id #uuid "910e3be6-42e1-536c-83e4-c75ca6eaf4a3" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186455167} {:answer/id #uuid "ac88dd90-5d4c-51e6-9e72-d41cda0c8d33" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186455205}] :answer-field/correct {:db/id #edb/ref 17592186455167} :answer-field/id #uuid "abe49f7c-654c-5082-9ec8-abe568a36534" :answer-field/key "selection" :answer-field/type {:db/id #edb/