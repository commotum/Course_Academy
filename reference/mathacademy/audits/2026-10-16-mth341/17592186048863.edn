begin{bmatrix}1 & 0 \\\\ -2 & 3\\end{bmatrix}+\\begin{bmatrix}3 & 9 \\\\ 1 & -1\\end{bmatrix}-\\begin{bmatrix}-7 & 8 \\\\ -7 & -7\\end{bmatrix} \\\\  & =\\begin{bmatrix}1+3-(-7) & 0+9-8 \\\\ -2+1-(-7) & 3+(-1)-(-7)\\end{bmatrix} \\\\  & =\\begin{bmatrix}11 & 1 \\\\ 6 & 9\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186549172 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed71b383-87bf-5f68-ada3-9d1bf1621ac7" :answer/type {:db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186549190}] :answer-field/correct {:db/id #edb/ref 17592186549190} :answer-field/id #uuid "0d08e6d2-9a18-5194-a4b5-165cf4314c1d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186549159} {:answer-field/choices [{:answer/id #uuid "0ad1cffd-57ce-5a4f-a1cd-b9fbff93cc2e" :answer/type {:db/ident :answer.type/math} :answer/value "-23" :db/id #edb/ref 17592186549158} {:answer/id #uuid "e2b5ea60-f49d-4454-b3ca-33a25b151406" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186567256}] :answer-field/correct {:db/id #edb/ref 17592186549158} :answer-field/id #uuid "116f97d9-f00b-5591-922a-1ef0fdecd620" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186549161} {:answer-field/choices [{:answer/id #uuid "ea7088cb-ea64-581e-9d0c-06c86aa2806f" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186549188}] :answer-field/correct {:db/id #edb/ref 17592186549188} :answer-field/id #uuid "59444d8a-71d5-5b63-ac16-5bf6f0124a5a" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186549168} {:answer-field/choices [{:answer/id #uuid "0d6314a6-7119-5799-b95a-c3c20df968e1" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186549160} {:answer/id #uuid "f8147fbe-e7a7-440f-b51d-f9cb82bb85a3" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186567257}] :answer-field/correct {:db/id #edb/ref 17592186549160} :answer-field/id #uuid "8fe0afe9-1d61-57c1-ad29-7092d170f3d8" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186549178}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6d7739fd-3f62-54a0-8f08-2be277540be7" :question/problem "Calculate $A-(B-C)$, where\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}-9 & -9 \\\\ -1 & -7\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}9 & -1 \\\\ 0 & 7\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}0 & 0 \\\\ 0 & -9\\end{bmatrix}$</div>\n</div>\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$A-(B-C)=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td><td>{{field-4}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Performing the operations on each corresponding entry, we get\n\n$$\n\\begin{aligned}A-(B-C) & =\\begin{bmatrix}-9 & -9 \\\\ -1 & -7\\end{bmatrix}-(\\begin{bmatrix}9 & -1 \\\\ 0 & 7\\end{bmatrix}-\\begin{bmatrix}0 & 0 \\\\ 0 & -9\\end{bmatrix}) \\\\  & =\\begin{bmatrix}-9 & -9 \\\\ -1 & -7\\end{bmatrix}-\\begin{bmatrix}9-0 & -1-0 \\\\ 0-0 & 7-(-9)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-9 & -9 \\\\ -1 & -7\\end{bmatrix}-\\begin{bmatrix}9 & -1 \\\\ 0 & 16\\end{bmatrix} \\\\  & =\\begin{bmatrix}-9-9 & -9-(-1) \\\\ -1-0 & -7-16\\end{bmatrix} \\\\  & =\\begin{bmatrix}-18 & -8 \\\\ -1 & -23\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186549181 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f6067054-7fd7-5494-afbc-63d2f1559965" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186549192}] :answer-field/correct {:db/id #edb/ref 17592186549192} :answer-field/id #uuid "3b02cda3-58fa-5c92-bb86-7f7f1f78a064" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186549164} {:answer-field/choices [{:answer/id #uuid "999ac731-f8fe-5bbb-ae2e-9746750317db" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186549180}] :answer-field/correct {:db/id #edb/ref 17592186549180} :answer-field/id #uuid "7c8db2d3-ed99-542c-a1d7-a2a23d3ad80f" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186549174} {:answer-field/choices [{:answer/id #uuid "c1f35416-70b6-5829-b9cd-2cd827d01541" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186549184}] :answer-field/correct {:db/id #edb/ref 17592186549184} :answer-field/id #uuid "ead897d3-b824-5616-bcee-21308edbe47a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186549189} {:answer-field/choices [{:answer/id #uuid "a251c7a8-7766-5b09-be0f-9d9cdd3ec615" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186549182}] :answer-field/correct {:db/id #edb/ref 17592186549182} :answer-field/id #uuid "ee94a05b-d8df-5eec-bd5a-b787df804ab2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186549191}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9c991876-ebda-5ae9-97e2-83fe985af8de" :question/problem "Calculate $A+(B-C)$, where\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}1 & 8 \\\\ 1 & -4\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}-9 & -1 \\\\ 8 & 6\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}3 & 6 \\\\ -7 & -4\\end{bmatrix}$</div>\n</div>\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$A+(B-C)=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td><td>{{field-4}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Performing the operations on each corresponding entry, we get\n\n$$\n\\begin{aligned}A+(B-C) & =\\begin{bmatrix}1 & 8 \\\\ 1 & -4\\end{bmatrix}+(\\begin{bmatrix}-9 & -1 \\\\ 8 & 6\\end{bmatrix}-\\begin{bmatrix}3 & 6 \\\\ -7 & -4\\end{bmatrix}) \\\\  & =\\begin{bmatrix}1 & 8 \\\\ 1 & -4\\end{bmatrix}+\\begin{bmatrix}-9-3 & -1-6 \\\\ 8-(-7) & 6-(-4)\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 8 \\\\ 1 & -4\\end{bmatrix}+\\begin{bmatrix}-12 & -7 \\\\ 15 & 10\\end{bmatrix} \\\\  & =\\begin{bmatrix}1+(-12) & 8+(-7) \\\\ 1+15 & -4+10\\end{bmatrix} \\\\  & =\\begin{bmatrix}-11 & 1 \\\\ 16 & 6\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186549186 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d78a2e84-a85a-5426-839b-d919d6d4b21d" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186549187}] :answer-field/correct {:db/id #edb/ref 17592186549187} :answer-field/id #uuid "3962cc30-d68b-50e2-9773-d6aedf315071" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186549163} {:answer-field/choices [{:answer/id #uuid "3791a3cb-3358-5c4f-9a27-646be33d615b" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186549162}] :answer-field/correct {:db/id #edb/ref 17592186549162} :answer-field/id #uuid "3d46fe0e-797a-5fd0-bf21-fd0f6cbd02ee" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186549166} {:answer-field/choices [{:answer/id #uuid "7f9923ef-6fcf-5a18-8db6-2620b208228a" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186549175}] :answer-field/correct {:db/id #edb/ref 17592186549175} :answer-field/id #uuid "7a9c1505-e38c-556b-8560-5c2cc406c445" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186549173} {:answer-field/choices [{:answer/id #uuid "6d2eef1e-ff06-5df1-8eb1-4ea4bf0598df" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186549171} {:answer/id #uuid "a11b4970-75f7-48a8-b344-592b1d637ccd" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186567254}] :answer-field/correct {:db/id #edb/ref 17592186549171} :answer-field/id #uuid "95636e19-16b7-5501-af4d-c1cea649ce07" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186549179}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d25c4306-6441-5c4f-87fe-15896c66e824" :question/problem "Calculate $C-(D-E)$, where\n\n<div class=\"matrix-operands\">\n<div>$C=\\begin{bmatrix}-2 & -4 \\\\ 8 & -1\\end{bmatrix}$</div>\n<div>$D=\\begin{bmatrix}4 & 6 \\\\ 7 & 5\\end{bmatrix}$</div>\n<div>$E=\\begin{bmatrix}-2 & 0 \\\\ -9 & -2\\end{bmatrix}$</div>\n</div>\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$C-(D-E)=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td><td>{{field-4}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Performing the operations on each corresponding entry, we get\n\n$$\n\\begin{aligned}C-(D-E) & =\\begin{bmatrix}-2 & -4 \\\\ 8 & -1\\end{bmatrix}-(\\begin{bmatrix}4 & 6 \\\\ 7 & 5\\end{bmatrix}-\\begin{bmatrix}-2 & 0 \\\\ -9 & -2\\end{bmatrix}) \\\\  & =\\begin{bmatrix}-2 & -4 \\\\ 8 & -1\\end{bmatrix}-\\begin{bmatrix}4-(-2) & 6-0 \\\\ 7-(-9) & 5-(-2)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & -4 \\\\ 8 & -1\\end{bmatrix}-\\begin{bmatrix}6 & 6 \\\\ 16 & 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2-6 & -4-6 \\\\ 8-16 & -1-7\\end{bmatrix} \\\\  & =\\begin{bmatrix}-8 & -10 \\\\ -8 & -8\\end{bmatrix}.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Sum or Difference of Three or More Matrices"} {:db/id #edb/ref 17592186100992 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100687 :question/id #uuid "1b15db42-aba2-575c-a01e-b715450329fd" :question/math-academy-id "e-4379" :question/problem "Find $A+C-(B+A)$, if\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}1 & -2 \\\\ \\sqrt{2} & 0 \\\\ 0 & -2\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}3 & -1 \\\\ 2 & 0 \\\\ -4 & 1\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}3 & -1 \\\\ 1 & 2 \\\\ -6 & 1\\end{bmatrix}$</div>\n</div>" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses: \n\n$$\n\\begin{aligned}A+C-(B+A) & =A+C-B-A \\\\  & =\\cancel{A}+C-B-\\cancel{A} \\\\  & =C-B\\end{aligned}\n$$\n\nWe are left with a single subtraction. So, we subtract the corresponding entries of the two matrices:\n\n$$\n\\begin{aligned}C-B & =\\begin{bmatrix}3 & -1 \\\\ 1 & 2 \\\\ -6 & 1\\end{bmatrix}-\\begin{bmatrix}3 & -1 \\\\ 2 & 0 \\\\ -4 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3-3 & -1-(-1) \\\\ 1-2 & 2-0 \\\\ -6-(-4) & 1-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ -1 & 2 \\\\ -2 & 0\\end{bmatrix}\\end{aligned}\n$$"} :knowledge-point/id #uuid "16e62b0e-adda-5d35-aeb9-961057dce8f0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049939}] :knowledge-point/question-generator {:db/id #edb/ref 17592186567312 :question-generator/id #uuid "0539d767-59b8-5447-b53e-9109db523fd8" :question-generator/script "generators/4d/4d32d7d7f73ddbb3a2428c7789d5384962633d6ce27d25c10c42c5b77ece2afc/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186101130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d7de1032-850c-5ea9-a1ae-e083486ff706" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 2 \\\\ 3 & 6\\end{bmatrix}" :db/id #edb/ref 17592186098116} {:answer/id #uuid "ee11b057-083a-50d4-a16e-71b940dfbd15" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 2 \\\\ 4 & 6\\end{b