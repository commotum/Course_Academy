}7 & 8 \\\\ 4 & 4\\end{bmatrix}" :db/id #edb/ref 17592186567287} {:answer/id #uuid "d381b82d-0da0-5fb1-9ced-71db6fa75315" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 5 \\\\ 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186567305} {:answer/id #uuid "e41bd865-32e8-5435-ba1b-78a0af3b1ff4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 8 \\\\ 8 & 4\\end{bmatrix}" :db/id #edb/ref 17592186567307}] :answer-field/correct {:db/id #edb/ref 17592186567287} :answer-field/id #uuid "4341a1bc-187a-5b45-a0a4-790be36bbd49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186567278}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "94dff20e-185a-57ca-bb97-908a1c4e39c9" :question/problem "Find $A-(C+A)+(C+B)$, if\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}9 & 5 \\\\ 1 & 3\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}7 & 8 \\\\ 4 & 4\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}0 & 5 \\\\ 2 & 0\\end{bmatrix}$</div>\n</div>" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}A-(C+A)+(C+B) & =A-C-A+C+B \\\\  & =\\cancel{A}-\\cancel{C}-\\cancel{A}+\\cancel{C}+B \\\\  & =B\\end{aligned}\n$$\n\nWe are left with a single matrix. So, the result is \n\n$$\n\\begin{aligned}B & =\\begin{bmatrix}7 & 8 \\\\ 4 & 4\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186567300 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53479d87-1b6b-5f9b-a5e1-e4e4b4dfd780" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 & 8 \\\\ 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186567280} {:answer/id #uuid "62cdc045-df33-5983-9a59-f6eab2cc0ad3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 9 \\\\ 4 & 4\\end{bmatrix}" :db/id #edb/ref 17592186567284} {:answer/id #uuid "8c987bf8-3e9b-52b2-a475-f56191bc58f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 5 \\\\ 5 & 7\\end{bmatrix}" :db/id #edb/ref 17592186567290} {:answer/id #uuid "9db5edfc-1d4a-5dec-ab30-b34fc393e43c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 5 \\\\ 1 & 7\\end{bmatrix}" :db/id #edb/ref 17592186567295} {:answer/id #uuid "ad5f5a26-6d9c-537f-bee8-976a327b96d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186567297}] :answer-field/correct {:db/id #edb/ref 17592186567295} :answer-field/id #uuid "8464e939-249e-5366-b15a-dfebfc20f655" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186567289}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b6e4ccf4-6e29-5d0e-abca-2b9461a5e403" :question/problem "Find $(B+A)-(C+B)+C$, if\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}3 & 5 \\\\ 1 & 7\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}8 & 8 \\\\ 1 & 3\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}0 & 9 \\\\ 4 & 4\\end{bmatrix}$</div>\n</div>" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}(B+A)-(C+B)+C & =B+A-C-B+C \\\\  & =\\cancel{B}+A-\\cancel{C}-\\cancel{B}+\\cancel{C} \\\\  & =A\\end{aligned}\n$$\n\nWe are left with a single matrix. So, the result is \n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}3 & 5 \\\\ 1 & 7\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186567306 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "146ba6fd-65d9-5eac-b8c6-753054ca734e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 & 8 \\\\ 8 & 5\\end{bmatrix}" :db/id #edb/ref 17592186567272} {:answer/id #uuid "7eb870e3-d126-56da-900f-58c9c4848f19" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 8 \\\\ 8 & 5\\end{bmatrix}" :db/id #edb/ref 17592186567288} {:answer/id #uuid "9da2ef4f-06e3-59ac-b555-66a1c6ce062d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186567294} {:answer/id #uuid "acb4f8a3-c7cf-5ba0-8238-0eaa18cd8b57" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 7 \\\\ 8 & 8\\end{bmatrix}" :db/id #edb/ref 17592186567296} {:answer/id #uuid "fcf76bdd-b7e9-5fd2-bea9-c77260928a82" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 0 \\\\ 7 & 2\\end{bmatrix}" :db/id #edb/ref 17592186567311}] :answer-field/correct {:db/id #edb/ref 17592186567272} :answer-field/id #uuid "9900aac4-ff32-5fdc-b53a-b18af36448de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186567292}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d8eb829a-4bbf-5052-a5c5-a62f628308c4" :question/problem "Find $A-(B-C)-(A-B)$, if\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}4 & 0 \\\\ 7 & 2\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}1 & 7 \\\\ 8 & 8\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}8 & 8 \\\\ 8 & 5\\end{bmatrix}$</div>\n</div>" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}A-(B-C)-(A-B) & =A-B+C-A+B \\\\  & =\\cancel{A}-\\cancel{B}+C-\\cancel{A}+\\cancel{B} \\\\  & =C\\end{aligned}\n$$\n\nWe are left with a single matrix. So, the result is \n\n$$\n\\begin{aligned}C & =\\begin{bmatrix}8 & 8 \\\\ 8 & 5\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186567308 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f5b833b-df7c-5eef-bca2-28f5c24a267c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 5 \\\\ 5 & 3\\end{bmatrix}" :db/id #edb/ref 17592186567274} {:answer/id #uuid "2c1e9f5d-3b48-58f5-a254-2137eba84337" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186567276} {:answer/id #uuid "5699b8d4-7df2-5bf6-b12b-187487650011" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 5 \\\\ 8 & 3\\end{bmatrix}" :db/id #edb/ref 17592186567282} {:answer/id #uuid "74349aad-386e-52d2-bc29-66434f664eb7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 7 \\\\ 1 & 2\\end{bmatrix}" :db/id #edb/ref 17592186567286} {:answer/id #uuid "992a3789-8aa2-519a-824a-5d7283c1a729" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 5 \\\\ 3 & 7\\end{bmatrix}" :db/id #edb/ref 17592186567293}] :answer-field/correct {:db/id #edb/ref 17592186567282} :answer-field/id #uuid "01d232a7-1a9f-57a0-865a-b4694b2441d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186567270}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e5acf887-8d5b-5d86-8b2d-418ab46a7a7a" :question/problem "Find $(B+A)-(B-C)-A$, if\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}7 & 5 \\\\ 3 & 7\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}0 & 7 \\\\ 1 & 2\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}0 & 5 \\\\ 8 & 3\\end{bmatrix}$</div>\n</div>" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}(B+A)-(B-C)-A & =B+A-B+C-A \\\\  & =\\cancel{B}+\\cancel{A}-\\cancel{B}+C-\\cancel{A} \\\\  & =C\\end{aligned}\n$$\n\nWe are left with a single matrix. So, the result is \n\n$$\n\\begin{aligned}C & =\\begin{bmatrix}0 & 5 \\\\ 8 & 3\\end{bmatrix}\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Sum or Difference of Three or More Matrices Using Distributivity"}] :topic/math-academy-id 1168 :topic/title "Properties of Matrix Addition"}
