id #edb/ref 17592186510651} {:answer/id #uuid "9d6eb01a-f481-58fc-99c6-f23a2013fb0f" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}1 & 19 & 21 \\\\ 21 & -17 & -1\\end{array}\\right]" :db/id #edb/ref 17592186510666} {:answer/id #uuid "bfb3528f-502a-5fd8-b637-7f5b163e9007" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}-1 & 19 & 21 \\\\ 21 & -17 & 1\\end{array}\\right]" :db/id #edb/ref 17592186510673}] :answer-field/correct {:db/id #edb/ref 17592186510666} :answer-field/id #uuid "e9210944-45d1-5838-bd35-48c7f95a0817" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186510681}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "631a7a62-9de6-52a1-905e-f326e1c35604" :question/problem "What is the augmented matrix for the following system of linear equations?\n\n$$\n\\left\\{\\begin{aligned}19y &=21-x \\\\ 21x-17y+1 &=0\\end{aligned}\\right.\n$$" :question/worked-solution "First, we organize the system so that the variables are ordered $x,y$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\n\\left\\{\\begin{aligned}x+19y &=21 \\\\ 21x-17y &=-1\\end{aligned}\\right.\n$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n\\begin{bmatrix}1 & 19 \\\\ 21 & -17\\end{bmatrix}\n$$\n\nThe augmented matrix  is the coefficient matrix augmented with the column that represents the right-hand sides of the equations: \n\n$$\n\\left[\\begin{array}{cc|c}1 & 19 & 21 \\\\ 21 & -17 & -1\\end{array}\\right]\n$$"} {:db/id #edb/ref 17592186510653 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "765cf772-decc-5aa4-a0b1-42435afa7dfb" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}21 & 1 & 1 \\\\ 1 & 1 & 0\\end{array}\\right]" :db/id #edb/ref 17592186510658} {:answer/id #uuid "9c6e2cb9-0fd3-5745-bec7-f49da26dcb9c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}21 & 1 & 1 \\\\ 1 & 1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186510665} {:answer/id #uuid "a7243ecd-5230-5f45-b618-877d609865fc" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}21 & 1 & 1 & 17 \\\\ 1 & 0 & 1 & 3\\end{array}\\right]" :db/id #edb/ref 17592186510667} {:answer/id #uuid "ad7b22a9-ea4b-5ce0-9f47-2e3a5681f385" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}21 & 1 & 1 & 17 \\\\ 1 & 1 & 0 & 3\\end{array}\\right]" :db/id #edb/ref 17592186510668} {:answer/id #uuid "cc0eef09-ad33-5079-a291-f9e85ada1855" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}21 & 1 & 1 & 17 \\\\ 1 & 1 & 1 & 3\\end{array}\\right]" :db/id #edb/ref 17592186510676}] :answer-field/correct {:db/id #edb/ref 17592186510667} :answer-field/id #uuid "754aaa94-9a37-597c-81b8-44cce2ef932d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186510657}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "64e51d71-516a-501d-91f6-e43b2ae825b6" :question/problem "What is the augmented matrix for the following system of linear equations?\n\n$$\\left\\{\\begin{aligned}21x+y+z &=17 \\\\ x+z &=3\\end{aligned}\\right.$$" :question/worked-solution "First, we organize the system so that the variables are ordered $x,y,z$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\\left\\{\\begin{aligned}21x+y+z &=17 \\\\ x+0y+z &=3\\end{aligned}\\right.$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n\\begin{bmatrix}21 & 1 & 1 \\\\ 1 & 0 & 1\\end{bmatrix}\n$$\n\nThe augmented matrix  is the coefficient matrix augmented with the column that represents the right-hand sides of the equations:\n\n$$\n\\left[\\begin{array}{ccc|c}21 & 1 & 1 & 17 \\\\ 1 & 0 & 1 & 3\\end{array}\\right]\n$$"} {:db/id #edb/ref 17592186510656 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a65aca2-38dd-59e3-b1c7-039905c04317" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}8 & 19 & -1 & 6 \\\\ -17 & 21 & 0 & -23 \\\\ 15 & -1 & -19 & 0\\end{array}\\right]" :db/id #edb/ref 17592186510648} {:answer/id #uuid "6566fc61-7a5a-592d-9dc2-c0350737660c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}8 & -19 & -1 & 6 \\\\ -17 & 21 & 0 & -23 \\\\ 15 & -1 & 0 & 19\\end{array}\\right]" :db/id #edb/ref 17592186510654} {:answer/id #uuid "886a6286-37e4-5c0a-93ea-fa942c212225" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}8 & -19 & -1 & 6 \\\\ -17 & 21 & 23 & 0 \\\\ 15 & -1 & -19 & 0\\end{array}\\right]" :db/id #edb/ref 17592186510662} {:answer/id #uuid "9482753c-57a4-53a9-b52c-c5c772f0bdc8" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}8 & -19 & 1 & 6 \\\\ -17 & 21 & 0 & -23 \\\\ 15 & -1 & -19 & 0\\end{array}\\right]" :db/id #edb/ref 17592186510664} {:answer/id #uuid "fc1133df-98bb-5e9c-92c1-0a2d359167ea" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}8 & -19 & -1 & 6 \\\\ -17 & 21 & 0 & -23 \\\\ 15 & -1 & 19 & 0\\end{array}\\right]" :db/id #edb/ref 17592186510683}] :answer-field/correct {:db/id #edb/ref 17592186510648} :answer-field/id #uuid "3ac74c0e-650c-5c0d-aae4-91abf12af746" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186510644}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "714ef0d8-896f-59ee-b57c-671f5e95cb44" :question/problem "What is the augmented matrix for the following system of linear equations?\n\n$$\n\\left\\{\\begin{aligned}8x+19y-z &=6 \\\\ 23-17x &=-21y \\\\ -y+15x &=19z\\end{aligned}\\right.\n$$" :question/worked-solution "First, we organize the system so that the variables are ordered $x,y,z$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\n\\left\\{\\begin{aligned}8x+19y-z &=6 \\\\ -17x+21y+0z &=-23 \\\\ 15x-y-19z &=0\\end{aligned}\\right.\n$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n\\begin{bmatrix}8 & 19 & -1 \\\\ -17 & 21 & 0 \\\\ 15 & -1 & -19\\end{bmatrix}\n$$\n\nThe augmented matrix  is the coefficient matrix augmented with the column that represents the right-hand sides of the equations:\n\n$$\n\\left[\\begin{array}{ccc|c}8 & 19 & -1 & 6 \\\\ -17 & 21 & 0 & -23 \\\\ 15 & -1 & -19 & 0\\end{array}\\right]\n$$"} {:db/id #edb/ref 17592186510670 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1badd14a-eaf0-58c4-a328-dd88ca238646" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}23 & 1 & 1 \\\\ 1 & 1 & 0\\end{array}\\right]" :db/id #edb/ref 17592186510637} {:answer/id #uuid "2c8050c5-a8f1-55cb-bf44-7edb50ce94da" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}23 & 1 & 1 & 8 \\\\ 1 & 0 & 1 & 19\\end{array}\\right]" :db/id #edb/ref 17592186510640} {:answer/id #uuid "33d9bf36-b2d4-51a8-a05d-6abb84fcba7c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}23 & 1 & 1 & 8 \\\\ 1 & 1 & 1 & 19\\end{array}\\right]" :db/id #edb/ref 17592186510641} {:answer/id #uuid "399526f0-89f9-54ab-b396-6661e41e2a9d" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}23 & 1 & 1 \\\\ 1 & 1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186510643} {:answer/id #uuid "d3d5b67b-3067-53e7-8bf6-98af6b8a2267" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}23 & 1 & 1 & 8 \\\\ 1 & 1 & 0 & 19\\end{array}\\right]" :db/id #edb/ref 17592186510677}] :answer-field/correct {:db/id #edb/ref 17592186510640} :answer-field/id #uuid "185ed767-72df-58ef-a1c6-1ef13cfa3cbf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186510636}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "afea0964-cf32-5182-a423-aaa886aaa39e" :question/problem "What is the augmented matrix for the following system of linear equations?\n\n$$\\left\\{\\begin{aligned}23x+y+z &=8 \\\\ x+z &=19\\end{aligned}\\right.$$" :question/worked-solution "First, we organize the system so that the variables are ordered $x,y,z$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\\left\\{\\begin{aligned}23x+y+z &=8 \\\\ x+0y+z &=19\\end{aligned}\\right.$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n\\begin{bmatrix}23 & 1 & 1 \\\\ 1 & 0 & 1\\end{bmatrix}\n$$\n\nThe augmented matrix  is the coefficient matrix augmented with the column that represents the right-hand sides of the equations:\n\n$$\n\\left[\\begin{array}{ccc|c}23 & 1 & 1 & 8 \\\\ 1 & 0 & 1 & 19\\end{array}\\right]\n$$"} {:db/id #edb/ref 17592186510675 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f98d3f2-bc3d-52e1-8dcc-fa5a0219067b" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}8 & -16 & 23 \\\\ 10 & 1 & 19\\end{array}\\right]" :db/id #edb/ref 17592186510635} {:answer/id #uuid "4a3a67cc-ef37-5732-873b-6fd492481549" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}8 & -23 & 16 \\\\ -19 & 1 & -10\\end{array}\\right]" :db/id #edb/ref 17592186510646} {:answer/id #uuid "5bf0aa0f-6704-529c-a699-c9547357a20a" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}8 & -19 & 0 \\\\ -23 & 1 & 0\\end{array}\\right]" :db/id #edb/ref 17592186510650} {:answer/id #uuid "767d9066-c236-5dc7-bb56-8ca4a0ea4197" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}8 & 23 & 16 \\\\ 10 & 1 & 19\\end{array}\\right]" :db/id #edb/ref 17592186510659} {:answer/id #uuid "dc2f7c86-2c5f-5db7-876e-f04d95786fd9" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}8 & -23 & 16 \\\\ 10 & 1 & 19\\end{array}\\right]" :db/id #edb/ref 17592186510678}] :answer-field/correct {:db/id #edb/ref 17592186510646} :answer-field/id #uuid "5a9ae83c-4e44-5ec5-ab7c-3d0bd8eafbfb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186510649}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c623f24b-cc19-5f11-8d33-9360241906f8" :question/problem "What is the augmented matrix for the following system of linear equations?\n\n$$\\left\\{\\begin{aligned}8x-16 &=23y \\\\ 10+y &=19x\\end{aligned}\\right.$$" :question/worked-solution "First, we organize the system so that the variables are ordered $x,y$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\\left\\{\\begin{aligned}8x-23y &=16 \\\\ -19x+y &=-10\\end{aligned}\\right.$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n\\begin{bmatrix}8 & -23 \\\\ -19 & 1\\end{bmatrix}\n$$\n\nThe augmented matrix  is the coefficient matrix augmented with the column that represents the right-hand sides of the equations: \n\n$$\n\\left[\\begin{array}{cc|c}8 & -23 & 16 \\\\ -19 & 1 & -10\\end{array}\\right]\n$$"}] :knowledge-point/title "Finding the Augmented Matrix of a System of Linear Equations"} :step/id #uuid "e6584e81-18d3-5c82-b510-c6d84d369be3" :step/math-academy-id 17171 :step/next {:db/id #edb/ref 17592186060679}} {:db/id #edb/ref 17592186060678 :step/content {:db/id #edb/ref 17592186060939 :tutorial/content "We will use mostly systems with the following variables:\n\n- $x,y,z,$ or\n\n- $x_1,x_2,x_3,$ or\n\n- $a,b,c.$\n\nThese sets of variables will always have a *natural* order:\n\n- alphabetical order in the case of $x,y,z$ or $a,b,c,$ and\n\n- numerical order in the case of $x_1, x_2, x_3.$" :tutorial/id #uuid "f6081e68-9014-5a0d-a6bf-084abe5fd28e" :tutorial/math-academy-id 3147 :tutorial/title "The Order of the Variables in a Linear System"} :step/id #uuid "17bd5ecf-ddf0-5755-a7bc-19c589337468" :step/math-academy-id 17172 :step/next {:db/id #edb/ref 17592186060676}} {:db/id #edb/ref 17592186060679 :step/content {:db/id #edb/ref 17592186059769 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059578 :question/id #uuid "05942b5f-c165-59c6-8b67-24bc8dd40cca" :question/math-academy-id "e-4685" :question/problem "What would be the system of equations for the following augmented matrix?\n\n$$\n\\left[\\begin{array}{cc|c}5 & -4 & -12 \\\\ 3 & 1 & 1\\end{array}\\right]\n$$" :question/worked-solution "The augmented matrix consists of two parts: the coefficient matrix and the column of constants.\n\nThe coefficient matrix represents the coefficients in the linear system, while the column of constants represents the constants on the right-hand sides of the equations.\n\nUsing the variables $x$ and $y,$ then, the corresponding system of equations is\n\n$$\n\\left\\{\\begin{aligned}5x-4y &=-12 \\\\ 3x+y &=1.\\end{aligned}\\right.\n$$"} :knowledge-point/id #uuid "d7c8f4da-c782-51e0-ac51-87a89f31860d" :knowledge-point/questions [{:db/id #edb/ref 17592186060198 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b53768c-9e88-55a9-b61b-39576efc1a5a" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}-\\frac{1}{2}x + y &=0 \\\\ \\frac{1}{2}x - y &=0 \\\\ x + \\frac{1}{2}z &=0\\end{aligned}\\right." :db/id #edb/ref 17592186057649} {:answer/id #uuid "ff03a4b3-5c91-50d2-8368-6a90c835c859" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}-\\frac{1}{2}y + z &=0 \\\\ \\frac{1}{2}x - y &=0 \\\\ y - \\frac{1}{2}z &=0\\end{aligned}\\right." :db/id #edb/ref 17592186057650} {:answer/id #uuid "3f133cc7-3f01-5987-9720-878ec58482f2" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}-\\frac{1}{2}y + z &=0 \\\\ \\frac{1}{2}y - z &=0 \\\\ x + \\frac{1}{2}z &=0\\end{aligned}\\right." :db/id #edb/ref 17592186057651} {:answer/id #uuid "4529cc37-932a-510a-ab51-4dea47e7e6c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}\\frac{1}{2}y + z &=0 \\\\ \\frac{1}{2}x - y &=0 \\\\ x - \\frac{1}{2}z &=0\\end{aligned}\\right." :db/id #edb/ref 17592186057652} {:answer/id #uuid "75329838-8009-5563-a4b9-1ae3ae0303ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}-\\frac{1}{2}y + z &=0 \\\\ \\frac{1}{2}x - y &=0 \\\\ x + \\frac{1}{2}z &=0\\end{aligned}\\right." :db/id #edb/ref 17592186057653}] :answer-field/id #uuid "4c5e36a6-331f-5bc3-8658-14c997854cb6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186057648}] :question/id #uuid "4514de1d-440c-55f2-8b33-90bb5f4dd54d" :question/math-academy-id "q-20223" :question/problem "What would be the system of equations for the following augmented matrix?\n\n$\\left[\\begin{array}{ccc|c}0 & -\\frac{1}{2} & 1 & 0 \\\\ \\frac{1}{2} & -1 & 0 & 0 \\\\ 1 & 0 & \\frac{1}{2} & 0\\end{array}\\right]$"} {:db/id #edb/ref 17592186060395 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64df3633-b59c-5a2c-a47b-ac990893af30" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x-2y &=0 \\\\ -x+y &=2\\end{aligned}\\right." :db/id #edb/ref 17592186403490} {:answer/id #uuid "bd635cf4-1b1c-55e3-b846-cf1074404d1f" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x-2y &=10 \\\\ x+y &=2\\end{aligned}\\right." :db/id #edb/ref 17592186403491} {:answer/id #uuid "f08977b3-da5b-5a3f-9b5f-51a1b0b73af2" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x-2y &=10 \\\\ -x+y &=-2\\end{aligned}\\right." :db/id #edb/ref 17592186403492} {:answer/id #uuid "d79b540e-61c1-524a-aada-7bc8f0c88fc5" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x+2y &=10 \\\\ x+y &=-2\\end{aligned}\\right." :db/id #edb/ref 17592186403493} {:answer/id #uuid "a1094fb0-5cb4-5005-a45b-91f8fd20411a" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x+2y &=1 \\\\ -x+y &=-2\\end{aligned}\\right." :db/id #edb/ref 17592186403494}] :answer-field/correct {:db/id #edb/ref 17592186403492} :answer-field/id #uuid "dc9e5b69-52ca-5647-a69d-a0b8ed7e52f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186403489}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "611f1d4a-3c30-50c6-9215-73810a99de02" :question/math-academy-id "q-71724" :question/problem "What would be the system of equations for the following augmented matrix?\n\n$$\n\\left[\\begin{array}{cc|c}1 & -2 & 10 \\\\ -1 & 1 & -2\\end{array}\\right]\n$$" :question/worked-solution "The augmented matrix consists of two parts: the coefficient matrix and the column of constants.\n\nThe coefficient matrix represents the coefficients in the linear system, while the column of constants represents the constants on the right-hand sides of the equations.\n\nUsing the variables $x$ and  $y$,  the corresponding system of equations is\n\n$$\\left\\{\\begin{aligned}x-2y &=10 \\\\ -x+y &=-2.\\end{aligned}\\right.$$"} {:db/id #edb/ref 17592186262949 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "983eae80-935c-5bec-83d4-bb70472b649c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}7x-4y &=9 \\\\ -3x+y+5z &=0 \\\\ 3x-4y+8z &=3\\end{aligned}\\right." :db/id #edb/ref 17592186261196} {:answer/id #uuid "9d5d1998-f70a-5eae-ac2d-6b2c8cf4550c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}7x-4y+z &=9 \\\\ -3x+y+5z &=0 \\\\ 3x-4y+8z &=3\\end{aligned}\\right." :db/id #edb/ref 17592186261237} {:answer/id #uuid "9d9e1b79-301c-56e0-bec8-3ddd45a92a4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}7x-4y+9z &=0 \\\\ -3x+y+5z &=0 \\\\ 3x-4y+8z &=3\\end{aligned}\\right." :db/id #edb/ref 17592186261241} {:answer/id #uuid "b184a01d-d736-54db-869c-f41ebd52dbb5" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}7x-4y-9z &=1 \\\\ 3x+y+5z &=1 \\\\ 3x-4y+8z &=3\\end{aligned}\\right." :db/id #edb/ref 17592186261444} {:answer/id #uuid "bf8ba9dd-0385-584b-87ab-7f38dee02799" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}7x+4y &=9 \\\\ 3x+y+5z &=0 \\\\ 3x+4y+8z &=3\\end{aligned}\\right." :db/id #edb/ref 17592186261567}] :answer-field/correct {:db/id #edb/ref 17592186261196} :answer-field/id #uuid "01ca573b-9f89-5340-8019-f697b0475e49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262127}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6f17144b-ab57-54e9-ad05-2f94341c0d36" :question/math-academy-id "q-129132" :question/problem "What would be the system of equations for the following augmented matrix?\n\n$$\n\\left[\\begin{array}{ccc|c}7 & -4 & 0 & 9 \\\\ -3 & 1 & 5 & 0 \\\\ 3 & -4 & 8 & 3\\end{array}\\right]\n$$" :question/worked-solution "The augmented matrix consists of two parts: the coefficient matrix and the column of constants.\n\nThe coefficient matrix represents the coefficients in the linear system, while the column of constants represents the constants on the right-hand sides of the equations.\n\nUsing the variables $x$, $y$, and $z,$ then, the corresponding system of equations is\n\n$$\\left\\{\\begin{aligned}7x-4y+0z &=9 \\\\ -3x+y+5z &=0 \\\\ 3x-4y+8z &=3.\\end{aligned}\\right.$$\n\nBy simplifying, we obtain\n\n$$\\left\\{\\begin{aligned}7x-4y &=9 \\\\ -3x+y+5z &=0 \\\\ 3x-4y+8z &=3.\\end{aligned}\\right.$$"} {:db/id #edb/ref 17592186287985 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1908e8ba-85bd-5cb6-bc00-81f1184ac3c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}2y+3z &=0 \\\\ 2x+3z &=2 \\\\ 2x+3y &=3\\end{aligned}\\right." :db/id #edb/ref 17592186285010} {:answer/id #uuid "a19af00f-030d-5887-8f4c-c3a01aca7679" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}y+3z &=0 \\\\ 2x-3z &=2 \\\\ 2x+3y &=3\\end{aligned}\\right." :db/id #edb/ref 17592186286265} {:answer/id #uuid "bd5ae993-6af4-51b4-be7a-507fdb87d03e" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}2y+3z &=0 \\\\ x+3z &=2 \\\\ 2x+3y &=3\\end{aligned}\\right." :db/id #edb/ref 17592186286518} {:answer/id #uuid "d2616c6a-96c4-56a1-bd78-ebcd5a28b775" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}2y-3z &=0 \\\\ 2x+3z &=2 \\\\ 2x+y &=3\\end{aligned}\\right." :db/id #edb/ref 17592186286700} {:answer/id #uuid "d2eda896-e492-511a-8500-fe07f9d246bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}2y+3z &=0 \\\\ 2x+3z &=2 \\\\ x-3y &=3\\end{aligned}\\right." :db/id #edb/ref 17592186286704}] :answer-field/correct {:db/id #edb/ref 17592186285010} :answer-field/id #uuid "751f884c-24a8-5042-b733-50c635a40ab5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287395}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4001e867-1b39-597f-be35-d38068603d60" :question/math-academy-id "q-20363" :question/problem "What would be the system of equations for the following augmented matrix?\n\n$$\n\\left[\\begin{array}{ccc|c}0 & 2 & 3 & 0 \\\\ 2 & 0 & 3 & 2 \\\\ 2 & 3 & 0 & 3\\end{array}\\right]\n$$" :question/worked-solution "The augmented matrix consists of two parts: the coefficient matrix and the column of constants.\n\nThe coefficient matrix represents the coefficients in the linear system, while the column of constants represents the constants on the right-hand sides of the equations.\n\nUsing the variables $x$, $y$, and $z,$ then, the corresponding system of equations is \n\n$$\\left\\{\\begin{aligned}0x+2y+3z &=0 \\\\ 2x+0y+3z &=2 \\\\ 2x+3y+0z &=3.\\end{aligned}\\right.$$\n\nBy simplifying, we obtain: \n\n$$\\left\\{\\begin{aligned}2y+3z &=0 \\\\ 2x+3z &=2 \\\\ 2x+3y &=3\\end{aligned}\\right.$$"} {:db/id #edb/ref 17592186287986 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52942026-0708-50da-8155-f5d6d14abc9e" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}4x+y+z &=\\frac{1}{2} \\\\ \\frac{1}{4}x+z &=-6 \\\\ 3x+\\frac{1}{2}y+6z &=\\frac{1}{3}\\end{aligned}\\right." :db/id #edb/ref 17592186285547} {:answer/id #uuid "713fc4b6-a412-5dde-a136-b5f3208fa57b" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}4x-y+z &=\\frac{1}{2} \\\\ \\frac{1}{4}x+2z &=6 \\\\ 3x+\\frac{1}{2}y+6z &=\\frac{1}{3}\\end{aligned}\\right." :db/id #edb/ref 17592186285827} {:answer/id #uuid "75e324df-b042-54f3-8d45-cb36f6c6665a" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}4x+y+z &=\\frac{1}{2} \\\\ \\frac{1}{4}x+2z &=6 \\\\ 3x+\\frac{1}{2}y+6z &=\\frac{1}{3}\\end{aligned}\\right." :db/id #edb/ref 17592186285885} {:answer/id #uuid "9d155d00-a9e3-584b-9988-6f1b0b0823bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}4x+y+z &=\\frac{1}{2} \\\\ \\frac{1}{4}x-2z &=6 \\\\ 3x+\\frac{1}{2}y+6z &=\\frac{1}{3}\\end{aligned}\\right." :db/id #edb/ref 17592186286225} {:answer/id #uuid "f885db08-8273-5caa-af3e-f21329ad7d3b" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}4x+y+z &=\\frac{1}{2} \\\\ \\frac{1}{4}x+2z &=6 \\\\ 3x-\\frac{1}{2}y+6z &=\\frac{1}{3}\\end{aligned}\\right." :db/id #edb/ref 17592186287058}] :answer-field/correct {:db/id #edb/ref 17592186285885} :answer-field/id #uuid "36f986fd-ddb5-517b-acb1-8c548d9719c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287261}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9027f370-8a34-5149-a818-35d99113c4e6" :question/math-academy-id "q-20367" :question/problem "What would be the system of equations for the following augmented matrix?\n\n$$\n\\left[\\begin{array}{ccc|c}4 & 1 & 1 & \\frac{1}{2} \\\\ \\frac{1}{4} & 0 & 2 & 6 \\\\ 3 & \\frac{1}{2} & 6 & \\frac{1}{3}\\end{array}\\right]\n$$" :question/worked-solution "The augmented matrix consists of two parts: the coefficient matrix and the column of constants.\n\nThe coefficient matrix represents the coefficients in the linear system, while the column of constants represents the constants on the right-hand sides of the equations.\n\nUsing the variables $x$, $y$, and $z,$ then, the corresponding system of equations is\n\n$$\\left\\{\\begin{aligned}4x+y+z &=\\frac{1}{2} \\\\ \\frac{1}{4}x-0y+2z &=6 \\\\ 3x+\\frac{1}{2}y+6z &=\\frac{1}{3}.\\end{aligned}\\right.$$\n\nBy simplifying, we obtain \n\n$$\\left\\{\\begin{aligned}4x+y+z &=\\frac{1}{2} \\\\ \\frac{1}{4}x+2z &=6 \\\\ 3x+\\frac{1}{2}y+6z &=\\frac{1}{3}.\\end{aligned}\\right.$$"} {:db/id #edb/ref 17592186338977 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d35e2f4-19f1-5cb1-8a8f-39da694de163" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x+2y-4z &=3 \\\\ -x+y-z &=2 \\\\ 2x+2y+z &=1\\end{aligned}\\right." :db/id #edb/ref 17592186336876} {:answer/id #uuid "6725ec81-9c9f-56f8-8ae4-0686d795ec53" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x+4y-2z &=3 \\\\ -x+y-z &=2 \\\\ 2x+y+2z &=1\\end{aligned}\\right." :db/id #edb/ref 17592186336952} {:answer/id #uuid "67ee1e90-2905-517b-bff8-b395951e0b81" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x+4y-2z &=3 \\\\ x+y+z &=2 \\\\ 2x+2y+z &=1\\end{aligned}\\right." :db/id #edb/ref 17592186336959} {:answer/id #uuid "7d1a8629-faf0-5628-a647-b59ed9c8c03c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x+4y-2z &=3 \\\\ -x+y-z &=2 \\\\ 2x+2y+z &=1\\end{aligned}\\right." :db/id #edb/ref 17592186337159} {:answer/id #uuid "d7fb5d8d-4408-525e-828f-a0deb29a682b" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x+4y-2z &=3 \\\\ -x+y-z &=1 \\\\ 2x+2y+z &=2\\end{aligned}\\right." :db/id #edb/ref 17592186337908}] :answer-field/correct {:db/id #edb/ref 17592186337159} :answer-field/id #uuid "86808fb5-ecf5-5601-90da-b1ad500e2611" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338522}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4253a0fa-e80c-5958-8134-9debe2aef552" :question/math-academy-id "q-71723" :question/problem "What would be the system of equations for the following augmented matrix?\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 4 & -2 & 3 \\\\ -1 & 1 & -1 & 2 \\\\ 2 & 2 & 1 & 1\\end{array}\\right]\n$$" :question/worked-solution "The augmented matrix consists of two parts: the coefficient matrix and the column of constants.\n\nThe coefficient matrix represents the coefficients in the linear system, while the column of constants represents the constants on the right-hand sides of the equations.\n\nUsing the variables $x$, $y$, and $z,$ then, the corresponding system of equations is\n\n$$\\left\\{\\begin{aligned}x+4y-2z &=3 \\\\ -x+y-z &=2 \\\\ 2x+2y+z &=1.\\end{aligned}\\right.$$"} {:db/id #edb/ref 17592186338978 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b613c19-2fb9-5d8b-9c95-ab12eafec89d" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x-5y &=1 \\\\ -2x-3y &=-5\\end{aligned}\\right." :db/id #edb/ref 17592186336441} {:answer/id #uuid "89ef116b-9ed1-50f1-9654-b0ef20da7751" :answer/type {:db/ident :answer