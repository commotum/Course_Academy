wer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{c|c}2 & -1 \\\\ 1 & 2 \\\\ -1 & 3\\end{array}\\right]" :db/id #edb/ref 17592186059003}] :answer-field/id #uuid "c669cc8a-9bdd-5cab-b673-2143115cac04" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186058998}] :question/id #uuid "8cbb6f41-79c3-50eb-b078-355f257a5fa8" :question/math-academy-id "q-71730" :question/problem "What is the augmented matrix for the following system of linear equations?\n\n$\\left\\{\\begin{aligned}2a - b &=-1 \\\\ a + 2b &=3\\end{aligned}\\right.$"} {:db/id #edb/ref 17592186243994 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20e78783-03ff-5f2b-b2e8-3d1d4091c16a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 2 & -3 \\\\ 0 & 0 & -11\\end{bmatrix}" :db/id #edb/ref 17592186241465} {:answer/id #uuid "23e1b20d-bd3a-531e-b525-17fbd6217e62" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 2 & -3 & 0 \\\\ 0 & 0 & -11 & 12\\end{bmatrix}" :db/id #edb/ref 17592186241493} {:answer/id #uuid "39cdaace-b472-5e56-ac17-bfc5c1070f71" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 4 & 3 & 0 \\\\ 0 & 0 & -11 & 12\\end{bmatrix}" :db/id #edb/ref 17592186241697} {:answer/id #uuid "666828da-a5a3-5486-acc1-2549b11b5eb6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 2 & 3 \\\\ 0 & 0 & -11\\end{bmatrix}" :db/id #edb/ref 17592186242105} {:answer/id #uuid "9e76a46f-3e02-5988-ab21-1b1411291324" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 4 & 3 \\\\ 0 & 0 & -11\\end{bmatrix}" :db/id #edb/ref 17592186242568}] :answer-field/correct {:db/id #edb/ref 17592186241465} :answer-field/id #uuid "e5a49b94-10a9-5c7d-9f40-0bcb4a707642" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243836}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "760765ec-b7b6-54ac-b028-0603c846223a" :question/math-academy-id "q-1070" :question/problem "What is the coefficient matrix for the following system of linear equations?\n\n$$\n\\left\\{\\begin{aligned}2{x}_{2}+4{x}_{1} &=3{x}_{3} \\\\ -11{x}_{3} &=12\\end{aligned}\\right.\n$$" :question/worked-solution "First, we organize the system so that the variables are ordered ${x}_{1},{x}_{2},{x}_{3}$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient: \n\n$$\n\\left\\{\\begin{aligned}4{x}_{1}+2{x}_{2}-3{x}_{3} &=0 \\\\ 0{x}_{1}+0{x}_{2}-11{x}_{3} &=12\\end{aligned}\\right.\n$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n\\begin{bmatrix}4 & 2 & -3 \\\\ 0 & 0 & -11\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186244042 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1863edce-f2ec-5a50-a21f-05e421f1ea0f" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & -1 & 4 \\\\ -11 & 0 & 3 & -1\\end{array}\\right]" :db/id #edb/ref 17592186241392} {:answer/id #uuid "7072cee5-2648-59ca-97b2-078189a3001c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -4 & -1 & 0 \\\\ -11 & 0 & 3 & -1\\end{array}\\right]" :db/id #edb/ref 17592186242182} {:answer/id #uuid "7be93f80-7c8c-5b43-983a-793f919a89d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}1 & -1 & 4 \\\\ 3 & -11 & -1\\end{array}\\right]" :db/id #edb/ref 17592186242267} {:answer/id #uuid "b0f0d9d4-4e81-5ba0-91aa-2178ad3b6deb" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -4 & -1 & 0 \\\\ -11 & 0 & 3 & 1\\end{array}\\right]" :db/id #edb/ref 17592186242720} {:answer/id #uuid "b6d1250e-1895-5e34-abe2-28333a02d8a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -1 & 0 & 4 \\\\ -3 & -11 & 0 & -1\