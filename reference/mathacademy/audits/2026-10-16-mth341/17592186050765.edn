1 & 0 & -1 & 6 \\\\ -13 & 0 & 14 & -1\\end{array}\\right]" :db/id #edb/ref 17592186524355}] :answer-field/correct {:db/id #edb/ref 17592186524335} :answer-field/id #uuid "cbc9b198-9031-5557-a635-483f8ef88236" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186524353}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dcfb9046-7853-50cf-9df9-12ba9e3679bb" :question/problem "What is the augmented matrix for the following system of linear equations?\n\n$$\n\\left\\{\\begin{aligned}a-c &=6b \\\\ 14c-13a &=-1\\end{aligned}\\right.\n$$" :question/worked-solution "First, we organize the system so that the variables are ordered $a,b,c$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\n\\left\\{\\begin{aligned}1a-6b-1c &=0 \\\\ -13a+0b+14c &=-1\\end{aligned}\\right.\n$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n\\begin{bmatrix}1 & -6 & -1 \\\\ -13 & 0 & 14\\end{bmatrix}\n$$\n\nThe augmented matrix is the coefficient matrix augmented with the column that represents the right-hand sides of the equations:\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -6 & -1 & 0 \\\\ -13 & 0 & 14 & -1\\end{array}\\right]\n$$"} {:db/id #edb/ref 17592186524359 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27c09833-2403-5ffc-b739-1f7ef3f70509" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}15 & 11 & -6 \\\\ 0 & 0 & -10\\end{bmatrix}" :db/id #edb/ref 17592186524328} {:answer/id #uuid "296aca9c-498e-5619-af5b-1bcfdeac6c9f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}15 & 11 & -6 & 0 \\\\ 0 & 0 & -10 & 1\\end{bmatrix}" :db/id #edb/ref 17592186524329} {:answer/id #uuid "44da178b-b353-59cb-86ac-5acfa946a32a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}15 & 11 & 6 \\\\ 0 & 0 & -10\\end{bmatrix}" :db/id #edb/ref 17592186524332} {:answer/id #uuid "9a11e128-77bd-5f78-99f6-8a944b6bc1e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}11 & 15 & 6 & 0 \\\\ 0 & 0 & -10 & 1\\end{bmatrix}" :db/id #edb/ref 17592186524347} {:answer/id #uuid "b36a9d4a-3d2c-55f4-bedc-7179b69a07c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}11 & 15 & 6 \\\\ 0 & 0 & -10\\end{bmatrix}" :db/id #edb/ref 17592186524350}] :answer-field/correct {:db/id #edb/ref 17592186524328} :answer-field/id #uuid "cdee999d-919a-557e-99e3-81b83833a2fe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186524354}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f13c080e-707a-527d-993c-2b6cabc482fa" :question/problem "What is the coefficient matrix for the following system of linear equations?\n\n$$\n\\left\\{\\begin{aligned}11{x}_{2}+15{x}_{1} &=6{x}_{3} \\\\ -10{x}_{3} &=1\\end{aligned}\\right.\n$$" :question/worked-solution "First, we organize the system so that the variables are ordered ${x}_{1},{x}_{2},{x}_{3}$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\n\\left\\{\\begin{aligned}15{x}_{1}+11{x}_{2}-6{x}_{3} &=0 \\\\ 0{x}_{1}+0{x}_{2}-10{x}_{3} &=1\\end{aligned}\\right.\n$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n\\begin{bmatrix}15 & 11 & -6 \\\\ 0 & 0 & -10\\end{bmatrix}\n$$"}] :knowledge-point/title "Finding the Augmented Matrix of a Linear System With Variables Other Than x, y, z"}] :topic/math-academy-id 148 :topic/next [{:db/id #edb/ref 17592186048980} {:db/id #edb/ref 17592186049120}] :topic/title "Systems of Equations as Augmented Matrices"}
