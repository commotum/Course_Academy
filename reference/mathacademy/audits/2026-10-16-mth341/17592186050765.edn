& 0\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186338975 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3870cf21-5534-5def-99e4-eeae42e4b0ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 & 0 & 3 \\\\ 0 & \\,\\,\\,-4 & 5 & 6 \\\\ 7 & 0 & 8 & 9\\end{bmatrix}" :db/id #edb/ref 17592186336558} {:answer/id #uuid "5c02282f-290f-5859-9377-ec1c833fc58a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 7 \\\\ 2 & \\,\\,\\,-4 & 0 \\\\ 0 & 5 & 8\\end{bmatrix}" :db/id #edb/ref 17592186336868} {:answer/id #uuid "ad844e1b-c977-50c3-aaa2-5437612f26fa" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 & -3 \\\\ \\,\\,\\,-4 & 5 & -6 \\\\ 7 & 8 & -9\\end{bmatrix}" :db/id #edb/ref 17592186337588} {:answer/id #uuid "d87232e7-9ac0-5e74-9288-126f3843a691" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 & 0 \\\\ 0 & \\,\\,\\,-4 & 5 \\\\ 7 & 0 & 8\\end{bmatrix}" :db/id #edb/ref 17592186337912} {:answer/id #uuid "e979800a-d684-515d-a581-6ee7d81f7d42" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 & 3 \\\\ \\,\\,\\,-4 & 5 & 6 \\\\ 7 & 8 & 9\\end{bmatrix}" :db/id #edb/ref 17592186338070}] :answer-field/correct {:db/id #edb/ref 17592186337912} :answer-field/id #uuid "2d485f3e-94a3-58e5-82d8-2b9ca2129796" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338360}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "05b351f4-ec25-5f54-8775-4cda53fe0446" :question/math-academy-id "q-71714" :question/problem "What is the coefficient matrix for the following system of linear equations?\n\n$$\n\\left\\{\\begin{aligned}x+2y &=3 \\\\ -4y+5z &=6 \\\\ 7x+8z &=9\\end{aligned}\\right.\n$$" :question/worked-solution "First, we organize the system so that the variables are ordered $x,y,z$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\n\\left\\{\\begin{aligned}x+2y+0z &=3 \\\\ 0x-4y+5z &=6 \\\\ 7x+0y+8z &=9\\end{aligned}\\right.\n$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n\\begin{bmatrix}1 & 2 & 0 \\\\ 0 & \\,\\,\\,-4 & 5 \\\\ 7 & 0 & 8\\end{bmatrix}\n$$"}] :knowledge-point/title "Finding the Coefficient Matrix of a System of Linear Equations"} {:db/id #edb/ref 17592186059768 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059577 :question/id #uuid "b5967dd6-bdf9-5cd0-9639-ec2816d04256" :question/math-academy-id "e-4684" :question/problem "What is the augmented matrix for the following system of linear equations?\n\n$$\n\\left\\{\\begin{aligned}y+x-5-3z &=0 \\\\ z &=y+7x \\\\ y+3-2z &=1-2x\\end{aligned}\\right.\n$$" :question/worked-solution "First, we organize the system so that the variables are ordered $x,y,z$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\n\\left\\{\\begin{aligned}x+y-3z &=5 \\\\ -7x-y+z &=0 \\\\ 2x+y-2z &=-2\\end{aligned}\\right.\n$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n\\left\\lbrack\n\t\\begin{matrix}\n\t\t1 & 1 & -3  \\\\\n\t\t-7 & -1 & 1  \\\\\n                2 & 1 & -2 \n\t\\end{matrix}\n\t\\right\\rbrack\n$$\n\nThe augmented matrix  is the coefficient matrix augmented with the column that represents the right-hand sides of the equations:\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & -3 & 5 \\\\ -7 & -1 & 1 & 0 \\\\ 2 & 1 & -2 & -2\\end{array}\\right]\n$$"} :knowledge-point/id #uuid "3f9ccaa5-d69c-584d-946e-0c57b3050160" :knowledge-point/question-generator {:db/id #edb/ref 17592186510684 :question-generator/id #uuid "f77d5acf-b3a6-5d1b-aedd-6070174f934d" :question-generator/script "generate/scratch/17592186059768.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186059969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f36c6d0-d4a6-5f4b-8a3b-e70b9d746666" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}6 & 1 & 1 & 4 \\\\ 1 & 1 & 0 & 9\\end{array}\\right]" :db/id #edb/ref 17592186238184} {:answer/id #uuid "5b0b792e-91b6-5398-8f05-b6eca06d89b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}6 & 1 & 1 & 4 \\\\ 1 & 1 & 1 & 9\\end{array}\\right]" :db/id #edb/ref 17592186238843} {:answer/id #uuid "bd5e7734-a55a-5ab8-87e5-1607c023de19" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}6 & 1 & 1 & 4 \\\\ 1 & 0 & 1 & 9\\end{array}\\right]" :db/id #edb/ref 17592186239705} {:answer/id #uuid "c17de7bc-051c-5d71-a1b6-48a31e14f49d" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}6 & 1 & 1 \\\\ 1 & 1 & 0\\end{array}\\right]" :db/id #edb/ref 17592186239747} {:answer/id #uuid "f9869cab-b95d-563e-a32f-123c0f5c7137" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}6 & 1 & 1 \\\\ 1 & 1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186240263}] :answer-field/correct {:db/id #edb/ref 17592186239705} :answer-field/id #uuid "ccab6e40-0d12-5a86-a565-87bd8af797a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240688}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fc7baee7-708d-5083-9b3d-6efab5143302" :question/math-academy-id "q-1051" :question/problem "What is the augmented matrix for the following system of linear equations?\n\n$$\\left\\{\\begin{aligned}6x+y+z &=4 \\\\ x+z &=9\\end{aligned}\\right.$$" :question/worked-solution "First, we organize the system so that the variables are ordered $x,y,z$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\\left\\{\\begin{aligned}6x+y+z &=4 \\\\ x+0y+z &=9\\end{aligned}\\right.$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n\\begin{bmatrix}6 & 1 & 1 \\\\ 1 & 0 & 1\\end{bmatrix}\n$$\n\nThe augmented matrix  is the coefficient matrix augmented with the column that represents the right-hand sides of the equations:\n\n$$\n\\left[\\begin{array}{ccc|c}6 & 1 & 1 & 4 \\\\ 1 & 0 & 1 & 9\\end{array}\\right]\n$$"} {:db/id #edb/ref 17592186060201 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5302557b-a7b1-5e1f-8977-b9ce4ab14929" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}-1 & 1 & 5 \\\\ 1 & 1 & 6\\end{array}\\right]" :db/id #edb/ref 17592186285551} {:answer/id #uuid "62179514-e299-574b-b29f-c97353645dfd" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}-1 & 1 & -5 \\\\ 1 & 1 & -6\\end{array}\\right]" :db/id #edb/ref 17592186285687} {:answer/id #uuid "8f646843-00c0-516f-9a4a-7ea7b249f28f" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}5 & -1 & 1 \\\\ 6 & 1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186286096} {:answer/id #uuid "9de3dfcf-07f3-5105-8e01-ae7c75049467" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{c|c}-1 & 1 \\\\ 1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186286233} {:answer/id #uuid "b1642fe1-20b8-580b-9887-e4dcec9eb577" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}1 & -1 & 5 \\\\ -1 & -1 & 6\\end{array}\\right]" :db/id #edb/ref 17592186286409}] :answer-field/correct {:db/id #edb/ref 17592186285551} :answer-field/id #uuid "a999a92c-2ac3-5db1-8d94-88d8501fbce9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287493}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "608e444e-fb7d-584c-a616-ea55f4a46535" :question/math-academy-id "q-20361" :question/problem "What is the augmented matrix for the following system of  linear equations?\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}-x+y &=5 \\\\ x+y &=6\\end{aligned}\\right.\\end{aligned}\n$$" :question/worked-solution "Notice that the system is already organized so that the variables are in the order $x,y$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient. \n\nThe coefficient matrix consists of the coefficients of the variables: \n\n$$\n\\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix}\n$$\n\n \n\nThe augmented matrix  is the coefficient matrix augmented with the column that represents the right-hand sides of the equations:\n\n$$\n\\left[\\begin{array}{cc|c}-1 & 1 & 5 \\\\ 1 & 1 & 6\\end{array}\\right]\n$$"} {:db/id #edb/ref 17592186241007 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ac0eba6-63cf-51a7-bd8d-7c6c4966ac54" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}2 & -5 & 3 \\\\ 6 & 1 & 4\\end{array}\\right]" :db/id #edb/ref 17592186238432} {:answer/id #uuid "39a212d1-af7d-5c19-abae-50bcab624e33" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}2 & -4 & 0 \\\\ -3 & 1 & 0\\end{array}\\right]" :db/id #edb/ref 17592186238552} {:answer/id #uuid "cb7ce99a-cfc4-5233-9022-cc905af6f444" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}2 & -3 & 5 \\\\ -4 & 1 & -6\\end{array}\\right]" :db/id #edb/ref 17592186239838} {:answer/id #uuid "f64d2597-0209-5cbb-aff6-059615bc1116" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}2 & -3 & 5 \\\\ 6 & 1 & 4\\end{array}\\right]" :db/id #edb/ref 17592186240226} {:answer/id #uuid "fe4e9051-5ef8-5ac9-9a08-88030f7c035c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}2 & 3 & 5 \\\\ 6 & 1 & 4\\end{array}\\right]" :db/id #edb/ref 17592186240305}] :answer-field/correct {:db/id #edb/ref 17592186239838} :answer-field/id #uuid "550550c8-9dd4-595d-b065-7a3b3268d8df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240487}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "51bc932c-31ca-5427-ac34-1e2bfeba299b" :question/math-academy-id "q-1052" :question/problem "What is the augmented matrix for the following system of linear equations?\n\n$$\\left\\{\\begin{aligned}2x-5 &=3y \\\\ 6+y &=4x\\end{aligned}\\right.$$" :question/worked-solution "First, we organize the system so that the variables are ordered $x,y$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\\left\\{\\begin{aligned}2x-3y &=5 \\\\ -4x+y &=-6\\end{aligned}\\right.$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n\\begin{bmatrix}2 & -3 \\\\ -4 & 1\\end{bmatrix}\n$$\n\nThe augmented matrix  is the coefficient matrix augmented with the column that represents the right-hand sides of the equations: \n\n$$\n\\left[\\begin{array}{cc|c}2 & -3 & 5 \\\\ -4 & 1 & -6\\end{array}\\right]\n$$"} {:db/id #edb/ref 17592186243890 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b5b12a4-e03e-5d35-9c0a-eccebba6a186" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}9 & -3 & 1 & 16 \\\\ -8 & 4 & 0 & -15 \\\\ 20 & -1 & -3 & 0\\end{array}\\right]" :db/id #edb/ref 17592186241708} {:answer/id #uuid "5330cf07-7fc4-544a-8143-f0b3bde25349" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}9 & -3 & -1 & 16 \\\\ -8 & 4 & 0 & -15 \\\\ 20 & -1 & 0 & 3\\end{array}\\right]" :db/id #edb/ref 17592186241923} {:answer/id #uuid "a456c675-d548-59a4-9405-d50f8b659ee6" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}9 & 3 & -1 & 16 \\\\ -8 & 4 & 0 & -15 \\\\ 20 & -1 & -3 & 0\\end{array}\\right]" :db/id #edb/ref 17592186242621} {:answer/id #uuid "aadd80f5-a5e7-5301-8218-ba22b2476289" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}9 & -3 & -1