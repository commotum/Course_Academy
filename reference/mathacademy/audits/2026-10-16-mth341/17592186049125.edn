0 & 0 & 1\\end{bmatrix} \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $CA$, we get\n\n$$\n\\begin{aligned}CA & =\\frac{1}{7}\\begin{bmatrix}1 & 0 & -4 \\\\ 1 & 0 & 3 \\\\ -1 & 7 & -17\\end{bmatrix}\\begin{bmatrix}3 & 4 & 0 \\\\ -2 & 3 & 1 \\\\ -1 & 1 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nSo, statement I is true.\n\n- Now, we check whether $AD=DA={I}_{3}.$ Computing $AD$, we get\n\n$$\n\\begin{aligned}AD & =\\begin{bmatrix}3 & 4 & 0 \\\\ -2 & 3 & 1 \\\\ -1 & 1 & 0\\end{bmatrix}\\begin{bmatrix}1 & 0 & -4 \\\\ 1 & 0 & 3 \\\\ -1 & 7 & -17\\end{bmatrix} \\\\  & =\\begin{bmatrix}∗ & ∗ & ∗ \\\\ ∗ & 7 & ∗ \\\\ ∗ & ∗ & ∗\\end{bmatrix} \\\\  & \\ne {I}_{3}.\\,\\times \\end{aligned}\n$$\n\nSo, statement II is false. As a result, $D\\ne {A}^{-1}$ and statement III is false too.\n\nTherefore, the correct answer is \"I only\"."} {:db/id #edb/ref 17592186275250 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b5963fe-823f-5433-b587-0ff85bf05ae9" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464378} {:answer/id #uuid "e5805653-1c99-5ce4-a1b2-2f3abbf31dda" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464379}] :answer-field/correct {:db/id #edb/ref 17592186464379} :answer-field/id #uuid "6992528f-7f94-56b5-8ebf-72131f3f9f66" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186465123} {:answer-field/choices [{:answer/id #uuid "3a4016d2-ef9b-5b17-bc6f-e996406a58f2" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464380} {:answer/id #uuid "bb019d79-c597-5df8-9386-954d563bbaf3" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464381}] :answer-field/correct {:db/id #edb/ref 17592186464380} :answer-field/id #uuid "a5cca488-3df7-53cc-b3af-7c72d52