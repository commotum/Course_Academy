 row, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & -4 \\\\ 2 & -7\\end{bmatrix}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix} & =\\begin{bmatrix}1\\cdot 1+(-4)\\cdot (-1) \\\\ ∗\\end{bmatrix}=\\begin{bmatrix}5 \\\\ ∗\\end{bmatrix}.\\end{aligned}\n$$\n\nMultiplying the second row, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & -4 \\\\ 2 & -7\\end{bmatrix}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ 2\\cdot 1+(-7)\\cdot (-1)\\end{bmatrix}=\\begin{bmatrix}5 \\\\ 9\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, \n$Zx=\\begin{bmatrix}5 \\\\ 9\\end{bmatrix}.$"} {:db/id #edb/ref 17592186262622 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "216bf086-a8fe-5b50-b1d6-5b2cdf5cbe82" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186260162} {:answer/id #uuid "24a36935-a58c-5eae-b06d-39c6bd7b44db" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}10 \\\\ -12\\end{bmatrix}" :db/id #edb/ref 17592186260193} {:answer/id #uuid "473e7382-de11-5d6f-acf6-9e411c2a85a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-8 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186260493} {:answer/id #uuid "a028971c-5a7b-54d9-829f-d9cb6beb5d0e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186261264} {:answer/id #uuid "b97be882-2322-5825-8c55-20dbd7de744e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-44 \\\\ 14\\end{bmatrix}" :db/id #edb/ref 17592186261500}] :answer-field/correct {:db/id #edb/ref 17592186260493} :answer-field/id #uuid "c83ffa3d-8569-5551-b21f-d700c313c8d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262478}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "59b87c9e-56e8-524b-8259-ae33549b1ef8" :question/math-academy-id "q-126512" :question/problem "Find $Xy$ if \n$X=\\begin{bmatrix}5 & -2 \\\\ -6 & 2\\end{bmatrix}$\nand\n$y=\\begin{bmatrix}2 \\\\ 9\\end{bmatrix}.$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product. Multiplying the first row, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}5 & -2 \\\\ -6 & 2\\end{bmatrix}\\begin{bmatrix}2 \\\\ 9\\end{bmatrix} & =\\begin{bmatrix}5\\cdot 2+(-2)\\cdot 9 \\\\ ∗\\end{bmatrix}=\\begin{bmatrix}-8 \\\\ ∗\\end{bmatrix}.\\end{aligned}\n$$\n\nMultiplying the second row, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}5 & -2 \\\\ -6 & 2\\end{bmatrix}\\begin{bmatrix}2 \\\\ 9\\end{bmatrix} & =\\begin{bmatrix}-8 \\\\ (-6)\\cdot 2+2\\cdot 9\\end{bmatrix}=\\begin{bmatrix}-8 \\\\ 6\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, \n$Xy=\\begin{bmatrix}-8 \\\\ 6\\end{bmatrix}.$"} {:db/id #edb/ref 17592186269081 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48a6a1b3-74a2-52fd-a3a2-5ba748bc119f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}17 \\\\ 17\\end{bmatrix}" :db/id #edb/ref 17592186266793} {:answer/id #uuid "87aebcd2-1f0c-5bf2-a590-49a753a4ece3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}17 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186267344} {:answer/id #uuid "89a65c1f-8537-59ed-9848-de16037c0200" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-17 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186267368} {:answer/id #uuid "bd6316bd-abec-5b38-9a39-8f0e7b0a5b94" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-17 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186267840} {:answer/id #uuid "de7ec95d-82e2-55d1-9499-d35e9294d744" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}17 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186268110}] :answer-field/correct {:db/id #edb/ref 17592186268110} :answer-field/id #uuid "e28c83e5-8b6e-5dcb-a17c-1769fc9c7fb3" :answer-field/key "s