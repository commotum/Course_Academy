 17592186345939} :answer-field/id #uuid "05010135-b840-5a6d-b59b-80021acb313f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347618}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "12dbb97a-a553-543b-a68a-7b1edc9cc29f" :question/math-academy-id "q-78348" :question/problem "Consider the matrix $C=\\begin{bmatrix}1 & 2 \\\\ 3 & 1\\end{bmatrix}.$ Find $f(C)$ if $f(X)={X}^{2}-2X-5.$" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}-2X-5 \\\\  & ={X}^{2}-2X-5I\\end{aligned}\n$$\n\nSo, we want to find $f(C)={C}^{2}-2C-5I.$\n\nLet's calculate ${C}^{2}$ as follows:\n\n$$\n\\begin{aligned}{C}^{2} & =C\\cdot C \\\\  & =\\begin{bmatrix}1 & 2 \\\\ 3 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 2 \\\\ 3 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 & 4 \\\\ 6 & 7\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(C):$\n\n$$\n\\begin{aligned}f(C) & ={C}^{2}-2C-5I \\\\  & =\\begin{bmatrix}7 & 4 \\\\ 6 & 7\\end{bmatrix}-2\\begin{bmatrix}1 & 2 \\\\ 3 & 1\\end{bmatrix}-5\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 & 4 \\\\ 6 & 7\\end{bmatrix}-\\begin{bmatrix}2 & 4 \\\\ 6 & 2\\end{bmatrix}-\\begin{bmatrix}5 & 0 \\\\ 0 & 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}7-2-5 & 4-4-0 \\\\ 6-6-0 & 7-2-5\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265959 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49d028a5-8a03-5e08-89ba-3b07852c6d28" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 2 \\\\ -6 & -4\\end{bmatrix}" :db/id #edb/ref 17592186263635} {:answer/id #uuid "75945a9e-0d69-50c3-8c7f-b9b72b1fa4d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186264023} {:answer/id #uuid "7b752631-fd13-5ecd-969d-73a4cd84b715" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & -3 \\\\ 1 & -2\\end{bmatrix}" :db/id #edb/ref 17592186264067} {:answer/id #uuid "dad407e2-b4ee-5429-9878-21378d589357" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 1 \\\\ -3 & -2\\end{bmatrix}" :db/id #edb/ref 17592186264906} {:answer/id #uuid "f3d9fb09-369c-5b0a-89f2-45fa8bcd079b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186265141}] :answer-field/correct {:db/id #edb/ref 17592186265141} :answer-field/id #uuid "c4a421a3-2e9d-5427-887a-cb0e710dec85" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265590}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "90299e14-75b6-5c47-ba13-96fd48a42f9c" :question/math-academy-id "q-130684" :question/problem "Consider the matrix $D=\\begin{bmatrix}4 & 2 \\\\ -6 & -4\\end{bmatrix}.$  Find $f(D)$ if $f(X)={X}^{2}-4.$" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}-4 \\\\  & ={X}^{2}-4I\\end{aligned}\n$$\n\nSo, we want to find $f(D)={D}^{2}-4I.$ \n\nLet's calculate ${D}^{2}$ as follows:\n\n$$\n\\begin{aligned}{D}^{2} & =D\\cdot D \\\\  & =\\begin{bmatrix}4 & 2 \\\\ -6 & -4\\end{bmatrix}\\cdot \\begin{bmatrix}4 & 2 \\\\ -6 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 0 \\\\ 0 & 4\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(D):$\n\n$$\n\\begin{aligned}f(D) & ={D}^{2}-4I \\\\  & =\\begin{bmatrix}4 & 0 \\\\ 0 & 4\\end{bmatrix}-4\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 0 \\\\ 0 & 4\\end{bmatrix}+\\begin{bmatrix}-4 & 0 \\\\ 0 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}4-4 & 0+0 \\\\ 0+0 & 4-4\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295078 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3d5317a-31f3-54aa-a6b5-786a8ff7f811" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186293635}] :answer-field/correct {:db/id #edb/ref 17592186293635} :answer-field/id #uuid "6eb78f3a-36e5-5305-b6cb-2c5f0c33edd8" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294318} {:answer-field/choices [{:answer/id #uuid "5c3ea9f9-60ad-5fe7-85fe-6d4d7a58ffd0" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293302}] :answer-field/correct {:db/id #edb/ref 17592186293302} :answer-field/id #uuid "878b519a-9848-5864-b294-4a97244a614d" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294412} {:answer-field/choices [{:answer/id #uuid "80a53002-fac7-5fa3-b9bb-fc880c2ae565" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186293450}] :answer-field/correct {:db/id #edb/ref 17592186293450} :answer-field/id #uuid "e87a6e92-ea2b-5d15-8aeb-33ed594d4c37" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294749} {:answer-field/choices [{:answer/id #uuid "8e70978d-817b-58a4-9e22-a0e67916282a" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186293483}] :answer-field/correct {:db/id #edb/ref 17592186293483} :answer-field/id #uuid "f63c9854-5a31-5e11-a464-989d7cde4a32" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294794}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fa44b764-43be-5630-bb00-0e547cc2b254" :question/math-academy-id "q-279481" :question/problem "Consider the matrix $A=\\begin{bmatrix}2 & -1 \\\\ 0 & 3\\end{bmatrix}.$ If $f(X)={X}^{2}+2X+2$, find $f(A).$\n\n| $f(A)=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}+2X+2 \\\\  & ={X}^{2}+2X+2I\\end{aligned}\n$$\n\nSo, we want to find $f(A)={A}^{2}+2A+2I.$\n\nLet's calculate ${A}^{2}$ as follows:\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =\\begin{bmatrix}2 & -1 \\\\ 0 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}2 & -1 \\\\ 0 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & -5 \\\\ 0 & 9\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(A):$\n\n$$\n\\begin{aligned}f(A) & ={A}^{2}+2A+2I \\\\  & =\\begin{bmatrix}4 & -5 \\\\ 0 & 9\\end{bmatrix}+2\\begin{bmatrix}2 & -1 \\\\ 0 & 3\\end{bmatrix}+2\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & -5 \\\\ 0 & 9\\end{bmatrix}+\\begin{bmatrix}4 & -2 \\\\ 0 & 6\\end{bmatrix}+\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}4+4+2 & -5+(-2)+0 \\\\ 0+0+0 & 9+6+2\\end{bmatrix} \\\\  & =\\begin{bmatrix}10 & -7 \\\\ 0 & 17\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295079 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1edb7101-b917-5e90-889e-728140e2f236" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186293059}] :answer-field/correct {:db/id #edb/ref 17592186293059} :answer-field/id #uuid "47953371-e2a3-5b62-a292-fc745ed5c6eb" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294183} {:answer-field/choices [{:answer/id #uuid "31ae1d39-21b9-5f62-9ebc-cf3d93e071d8" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186293141}] :answer-field/correct {:db/id #edb/ref 17592186293141} :answer-field/id #uuid "4d706eca-c550-5c7c-9ec1-b9ef5a6fd7fc" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref