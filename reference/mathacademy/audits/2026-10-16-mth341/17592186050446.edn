X}^{2}+X-4I\\end{aligned}\n$$\n\nSo, we want to find $f(B)={B}^{2}+B-4I.$\n\nLet's calculate ${B}^{2}$ as follows:\n\n$$\n\\begin{aligned}{B}^{2} & =B\\cdot B \\\\  & =\\begin{bmatrix}0 & 2 \\\\ -1 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 2 \\\\ -1 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & 6 \\\\ -3 & 7\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(B):$\n\n$$\n\\begin{aligned}f(B) & ={B}^{2}+B-4I \\\\  & =\\begin{bmatrix}-2 & 6 \\\\ -3 & 7\\end{bmatrix}+\\begin{bmatrix}0 & 2 \\\\ -1 & 3\\end{bmatrix}-4\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & 6 \\\\ -3 & 7\\end{bmatrix}+\\begin{bmatrix}0 & 2 \\\\ -1 & 3\\end{bmatrix}-\\begin{bmatrix}4 & 0 \\\\ 0 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2+0-4 & 6+2-0 \\\\ -3+(-1)-0 & 7+3-4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 & 8 \\\\ -4 & 6\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186365538 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b2de13f-7428-5cf4-a15d-bb759547b2ed" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186365540}] :answer-field/correct {:db/id #edb/ref 17592186365540} :answer-field/id #uuid "11f8211f-fddf-5d62-b133-32198e03aa6f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186365539} {:answer-field/choices [{:answer/id #uuid "9ea4d763-c8fb-5f15-8550-82d38c91fb41" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186365542}] :answer-field/correct {:db/id #edb/ref 17592186365542} :answer-field/id #uuid "442f54fb-8ea0-51fb-bfe8-bce6dace459a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186365541} {:answer-field/choices [{:answer/id #uuid "831af219-b629-59f3-aa0d-961a442fa561" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186365544}] :answer-field/correct {:db/id #edb/ref 17592186365544} :answer-field/id #uuid "ee738f6e-6149-5378-bb24-e7a5a743621a" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186365543} {:answer-field/choices [{:answer/id #uuid "38720bc1-0b3f-5911-b14c-3283ea1fba26" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186365546}] :answer-field/correct {:db/id #edb/ref 17592186365546} :answer-field/id #uuid "ab40a567-7f9c-536f-8745-37c134a38b77" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186365545}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d4bdadfb-e233-53cf-93ab-2b717c37253a" :question/math-academy-id "q-279506" :question/problem "Consider the matrix $E=\\begin{bmatrix}2 & 0 \\\\ 1 & 1\\end{bmatrix}.$ If $f(X)={X}^{2}+4X-5$, find $f(E).$\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$f(E)=\\,\\,$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">\n{{field-1}}\n</td>\n<td align=\"center\">\n{{field-2}}\n</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n{{field-3}}\n</td>\n<td align=\"center\" width=\"30px\">\n{{field-4}}\n</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}+4X-5 \\\\  & ={X}^{2}+4X-5I\\end{aligned}\n$$\n\nSo, we want to find $f(E)={E}^{2}+4E-5I.$\n\nLet's calculate ${E}^{2}$ as follows:\n\n$$\n\\begin{aligned}{E}^{2} & =E\\cdot E \\\\  & =\\begin{bmatrix}2 & 0 \\\\ 1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}2 & 0 \\\\ 1 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 0 \\\\ 3 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(E):$\n\n$$\n\\begin{aligned}f(E) & ={E}^{2}+4E-5I \\\\  & =\\begin{bmatrix}4 & 0 \\\\ 3 & 1\\end{bmatrix}+4\\begin{bmatrix}2 & 0 \\\\ 1 & 1\\end{bmatrix}-5\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 0 \\\\ 3 & 1\\end{bmatrix}+\\begin{bmatrix}8 & 0 \\\\ 4 & 4\\end{bmatrix}-\\begin{bmatrix}5 & 0 \\\\ 0 & 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}4+8-5 & 0+0-0 \\\\ 3+4-0 & 1+4-5\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 & 0 \\\\ 7 & 0\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186366302 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22d7958c-94ba-5de3-9243-e30601f76543" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 1 \\\\ -5 & 1\\end{bmatrix}" :db/id #edb/ref 17592186366304} {:answer/id #uuid "b10801ca-f13a-57ad-8038-3828133145ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1 \\\\ 4 & 1\\end{bmatrix}" :db/id #edb/ref 17592186366305} {:answer/id #uuid "e55ee6b6-6cbe-5ecc-a66b-628ac43bc811" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 1 \\\\ 4 & 5\\end{bmatrix}" :db/id #edb/ref 17592186366306} {:answer/id #uuid "1a296f4e-0f9b-50c7-9b4e-bd01d0b60375" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1 \\\\ -4 & -1\\end{bmatrix}" :db/id #edb/ref 17592186366307} {:answer/id #uuid "eba229a2-1a77-552c-9266-524a1d9a221b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 1 \\\\ -4 & 1\\end{bmatrix}" :db/id #edb/ref 17592186366308}] :answer-field/correct {:db/id #edb/ref 17592186366308} :answer-field/id #uuid "de3f2328-fa8d-5da1-9c29-ab9566101429" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186366303}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2869021c-9120-59a9-9952-6f0d251d0602" :question/math-academy-id "q-78347" :question/problem "Consider the matrix $B=\\begin{bmatrix}2 & 1 \\\\ -4 & -2\\end{bmatrix}.$  Find $f(B)$ if $f(X)={X}^{2}+X+3.$" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}+X+3 \\\\  & ={X}^{2}+X+3I\\end{aligned}\n$$\n\nSo, we want to find $f(B)={B}^{2}+B+3I.$\n\nLet's calculate ${B}^{2}$ as follows:\n\n$$\n\\begin{aligned}{B}^{2} & =B\\cdot B \\\\  & =\\begin{bmatrix}2 & 1 \\\\ -4 & -2\\end{bmatrix}\\cdot \\begin{bmatrix}2 & 1 \\\\ -4 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(B):$\n\n$$\n\\begin{aligned}f(B) & ={B}^{2}+B+3I \\\\  & =\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}+\\begin{bmatrix}2 & 1 \\\\ -4 & -2\\end{bmatrix}+3\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}+\\begin{bmatrix}2 & 1 \\\\ -4 & -2\\end{bmatrix}+\\begin{bmatrix}3 & 0 \\\\ 0 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}0+2+3 & 0+1+0 \\\\ 0+(-4)+0 & 0+(-2)+3\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & 1 \\\\ -4 & 1\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186366309 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "afe8d6d8-0a6d-5efd-a9c0-c468f00d3f21" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 5 \\\\ -15 & -1\\end{bmatrix}" :db/id #edb/ref 17592186366311} {:answer/id #uuid "d25a56e7-16c2-5f88-992b-3343761aa97c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}29 & 5 \\\\ -5 & -1\\end{bmatrix}" :db/id #edb/ref 17592186366312} {:answer/id #uuid "e3f3e7d5-a5eb-5b88-94d1-ab28c0dfcffd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}29 & 5 \\\\ -15 & -1\\end{bmatrix}" :db/id #edb/ref 17592186366313} {:answer/id #uuid "8d63f40b-f2ea-5001-ae5e-ff191217dc44" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}29 & -5 \\\\ 5 & 1\\end{bmatrix}" :db/id #edb/ref 17592186366314} {:answer/id #uuid "eb627ab1-f604-5f7b-aa59-eecf1c4e4f64" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 9 \\\\ -15 & -1\\end{bmatrix}" :db/id #edb/ref 17592186366315}] :answer-field/correct {:db/id #edb/ref 17592186366313} :answer-field/id #uuid "176f723a-0a36-5ca0-a32a-8d6d6c5acf73" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186366310}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2a14c0ed-8414-58e1-8b26-a5335ab66e8a" :question/math-academy-id "q-78584" :question/problem "Consider the matrix $H=\\begin{bmatrix}5 & 1 \\\\ -3 & -1\\end{bmatrix}.$  Find $f(H)$ if $f(X)={X}^{2}+X+2.$" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}+X+2 \\\\  & ={X}^{2}+X+2I\\end{aligned}\n$$\n\nSo, we want to find $f(H)={H}^{2}+H+2I.$\n\nLet's calculate ${H}^{2}$ as follows:\n\n$$\n\\begin{aligned}{H}^{2} & =H\\cdot H \\\\  & =\\begin{bmatrix}5 & 1 \\\\ -3 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}5 & 1 \\\\ -3 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}22 & 4 \\\\ -12 & -2\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(H):$\n\n$$\n\\begin{aligned}f(H) & ={H}^{2}+H+2I \\\\  & =\\begin{bmatrix}22 & 4 \\\\ -12 & -2\\end{bmatrix}+\\begin{bmatrix}5 & 1 \\\\ -3 & -1\\end{bmatrix}+2\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}22 & 4 \\\\ -12 & -2\\end{bmatrix}+\\begin{bmatrix}5 & 1 \\\\ -3 & -1\\end{bmatrix}+\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}22+5+2 & 4+1+0 \\\\ -12-3+0 & -2-1+2\\end{bmatrix} \\\\  & =\\begin{bmatrix}29 & 5 \\\\ -15 & -1\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186388132 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67b616c2-ce6e-5c95-8648-dd89dbfaa3f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 6 \\\\ 6 & 9\\end{bmatrix}" :db/id #edb/ref 17592186388134} {:answer/id #uuid "ca63b17e-8661-5864-bf17-dbc1f35dc340" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 6 \\\\ 9 & 6\\end{bmatrix}" :db/id #edb/ref 17592186388135} {:answer/id #uuid "5cae900f-3b80-52ed-97df-eae2af51f956" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & -6 \\\\ 9 & -6\\end{bmatrix}" :db/id #edb/ref 17592186388136} {:answer/id #uuid "8a887fa4-9ae0-5c2c-ac17-c0d680bda859" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & -3 \\\\ 9 & 6\\end{bmatrix}" :db/id #edb/ref 17592186388137} {:answer/id #uuid "de5ea921-ae36-5369-bf56-d02193f5bc68" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 6 \\\\ -6 & 9\\end{bmatrix}" :db/id #edb/ref 17592186388138}] :answer-field/correct {:db/id #edb/ref 17592186388135} :answer-field/id #uuid "889964a6-0e86-53e7-a015-8ff79199c498" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186388133}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "01490c7d-4c84-5d6b-914b-a1fab67bc26a" :question/math-academy-id "q-130681" :question/problem "Consider the matrix $A=\\begin{bmatrix}1 & 2 \\\\ 3 & 4\\end{bmatrix}.$  Find $f(A)$ if $f(X)={X}^{2}-2X-8.$" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}-2X-8 \\\\  & ={X}^{2}-2X-8I\\end{aligned}\n$$\n\nSo, we want to find $f(A)={A}^{2}-2A-8I.$\n\nLet's calculate ${A}^{2}$ as follows:\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =\\begin{bmatrix}1 & 2 \\\\ 3 & 4\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 2 \\\\ 3 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 & 10 \\\\ 15 & 22\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(A):$\n\n$$\n\\begin{aligned}f(A) & ={A}^{2}-2A-8I \\\\  & =\\begin{bmatrix}7 & 10 \\\\ 15 & 22\\end{bmatrix}-2\\begin{bmatrix}1 & 2 \\\\ 3 & 4\\end{bmatrix}-8\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 & 10 \\\\ 15 & 22\\end{bmatrix}+\\begin{bmatrix}-2 & -4 \\\\ -6 & -8\\end{bmatrix}+\\begin{bmatrix}-8 & 0 \\\\ 0 & -8\\end{bmatrix} \\\\  & =\\begin{bmatrix}7-2-8 & 10-4+0 \\\\ 15-6+0 & 22-8-8\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & 6 \\\\ 9 & 6\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186388139 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c29b720-4600-5452-856a-0de6c5b2cbbc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 2 \\\\ -1 & -7\\end{bmatrix}" :db/id #edb/ref 17592186388141} {:answer/id #uuid "d78e56c2-19a5-58bf-aac5-d59f602172e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 2 \\\\ -1 & -1\\end{bmatrix}" :db/id #edb/ref 17592186388142} {:answer/id #uuid "b2514912-db4d-511d-a89d-093ae0777083" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 2 \\\\ -1 & 4\\end{bmatrix}" :db/id #edb/ref 17592186388143} {:answer/id #uuid "d3f1a29c-c2ff-5901-b277-ceaff0eb220f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 2 \\\\ -1 & -6\\end{bmatrix}" :db/id #edb/ref 17592186388144} {:answer/id #uuid "adc7ac7b-e40f-5c06-9fee-5b824b5729d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 0 \\\\ 0 & 5\\end{bmatrix}" :db/id #edb/ref 17592186388145}] :answer-field/correct {:db/id #edb/ref 17592186388145} :answer-field/id #uuid "5decefa1-878b-5a33-98d2-b1ec4d4f6078" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186388140}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6097bb1d-9d7a-56b4-9d4d-09d460a9e165" :question/math-academy-id "q-130687" :question/problem "Consider the matrix $C=\\begin{bmatrix}2 & 2 \\\\ -1 & -1\\end{bmatrix}.$ Find $f(C)$ if $f(X)={X}^{2}-X+5.$" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}-X+5 \\\\  & ={X}^{2}-X+5I\\end{aligned}\n$$\n\nSo, we want to find $f(C)={C}^{2}-C+5I.$\n\nLet's calculate ${C}^{2}$ as follows:\n\n$$\n\\begin{aligned}{C}^{2} & =C\\cdot C \\\\  & =\\begin{bmatrix}2 & 2 \\\\ -1 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}2 & 2 \\\\ -1 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 2 \\\\ -1 & -1\\end{bmatrix} \\\\  & =C\\end{aligned}\n$$\n\nNow, we can evaluate $f(C):$\n\n$$\n\\begin{aligned}f(C) & ={C}^{2}-C+5I \\\\  & =C-C+5I \\\\  & =5I \\\\  & =5\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & 0 \\\\ 0 & 5\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186388146 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98d46de3-1964-521e-987f-3f87e63d14f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 0 \\\\ 0 & 7\\end{bmatrix}" :db/id #edb/ref 17592186388148} {:answer/id #uuid "290eb367-b69e-51e9-b010-dd7d2e86e6ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388149} {:answer/id #uuid "8ec94462-c5a9-5b19-af43-e4fb15a1b17d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 4 \\\\ 12 & 7\\end{bmatrix}" :db/id #edb/ref 17592186388150} {:answer/id #uuid "def69761-fa9a-5675-91a9-81ca5a36b65a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 1 \\\\ 3 & 2\\end{bmatrix}" :db/id #edb/ref 17592186388151} {:answer/id #uuid "cdeec92a-fd20-575e-a12b-6d715aa8a4a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 4 \\\\ 12 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388152}] :answer-field/correct {:db/id #edb/ref 17592186388149} :answer-field/id #uuid "56b6390d-ed7e-571e-81e8-62f931b08ef6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186388147}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "22954632-a7ef-5551-8cda-37dd0def8e71" :question/math-academy-id "q-130688" :question/problem "Consider the matrix $K=\\begin{bmatrix}2 & 1 \\\\ 3 & 2\\end{bmatrix}.$ Find $f(K)$ if $f(X)={X}^{2}-4X+1.$" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}-4X+1 \\\\  & ={X}^{2}-4X+I\\end{aligned}\n$$\n\nSo, we want to find $f(K)={K}^{2}-4K+I.$\n\nLet's calculate ${K}^{2}$ as follows:\n\n$$\n\\begin{aligned}{K}^{2} & =K\\cdot K \\\\  & =\\begin{bmatrix}2 & 1 \\\\ 3 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}2 & 1 \\\\ 3 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 & 4 \\\\ 12 & 7\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(K):$\n\n$$\n\\begin{aligned}f(K) & ={K}^{2}-4K+I \\\\  & =\\begin{bmatrix}7 & 4 \\\\ 12 & 7\\end{bmatrix}-4\\begin{bmatrix}2 & 1 \\\\ 3 & 2\\end{bmatrix}+\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 & 4 \\\\ 12 & 7\\end{bmatrix}-\\begin{bmatrix}8 & 4 \\\\ 12 & 8\\end{bmatrix}+\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}7-8+1 & 4-4-0 \\\\ 12-12+0 & 7-8+1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186486363 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22af9faf-479c-5211-b924-d2a2ed0ab1ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 6 \\\\ 6 & 8\\end{bmatrix}" :db/id #edb/ref 17592186485823} {:answer/id #uuid "4a573fe0-ecf3-566c-990e-bc2091d59ff5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 6 \\\\ 8 & 2\\end{bmatrix}" :db/id #edb/ref 17592186485900} {:answer/id #uuid "c787cd72-628c-5183-a122-bb1328cc72f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 6 \\\\ 2 & 8\\end{bmatrix}" :db/id #edb/ref 17592186486126} {:answer/id #uuid "dd037009-e2