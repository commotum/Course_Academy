value "3" :db/id #edb/ref 17592186485806}] :answer-field/correct {:db/id #edb/ref 17592186485806} :answer-field/id #uuid "04fc8c65-5979-5818-b2df-b511ed097117" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186486234} {:answer-field/choices [{:answer/id #uuid "4b68f449-7bbb-55d4-a609-2b652f3186ed" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186485901}] :answer-field/correct {:db/id #edb/ref 17592186485901} :answer-field/id #uuid "076ad971-056c-5b6d-b1e5-ec23e7e52bbf" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186486237} {:answer-field/choices [{:answer/id #uuid "b4c94783-97ab-5518-a553-3f4a6b7f2dd1" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186486087}] :answer-field/correct {:db/id #edb/ref 17592186486087} :answer-field/id #uuid "39d457ca-d914-502e-ad23-85724a0daabc" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186486260} {:answer-field/choices [{:answer/id #uuid "67d10dd3-0c20-55f4-80c5-c44e7f2d8ec1" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186485941}] :answer-field/correct {:db/id #edb/ref 17592186485941} :answer-field/id #uuid "459b0486-2cc5-556f-b20a-9563f4ecc1a7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186486267} {:answer-field/choices [{:answer/id #uuid "d1622841-527f-5082-af64-a955b4e702b3" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186486147}] :answer-field/correct {:db/id #edb/ref 17592186486147} :answer-field/id #uuid "e3382c5a-5ae4-5f97-b1d5-55746ea662a4" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186486333}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ccd2400f-e477-5772-b36d-b9c99ce24efe" :question/math-academy-id "q-279444" :question/problem "Consider the matrix $B=\\begin{bmatrix}2 & 0 & 1 \\\\ 1 & 1 & 0 \\\\ 3 & -1 & 2\\end{bmatrix}.$ Find ${B}^{2}.$\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"3\">${B}^{2}=\\,\\,$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">\n{{field-1}}\n</td>\n<td align=\"center\">$-1$</td>\n<td align=\"center\">\n{{field-2}}\n</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n{{field-3}}\n</td>\n<td align=\"center\">\n{{field-4}}\n</td>\n<td align=\"center\">$1$</td>\n<td align=\"center\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$11$</td>\n<td align=\"center\">$-3$</td>\n<td align=\"center\">\n{{field-5}}\n</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To find ${B}^{2},$ we multiply $B$ by itself:\n\n$$\n\\begin{aligned}{B}^{2} & =B\\cdot B \\\\  & =\\begin{bmatrix}2 & 0 & 1 \\\\ 1 & 1 & 0 \\\\ 3 & -1 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}2 & 0 & 1 \\\\ 1 & 1 & 0 \\\\ 3 & -1 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 & -1 & 4 \\\\ 3 & 1 & 1 \\\\ 11 & -3 & 7\\end{bmatrix}\\end{aligned}\n$$"}] :knowledge-point/title "Finding a Power of a Matrix"} :step/id #uuid "b7e64a68-2c78-5e75-aff4-57e7b0a1d18e" :step/math-academy-id 16201 :step/next {:db/id #edb/ref 17592186116104}} {:db/id #edb/ref 17592186116104 :step/content {:db/id #edb/ref 17592186116489 :tutorial/content "Now that we know how to compute powers of matrices, we can evaluate polynomials where the input is a square matrix. \n\nFor example, consider the polynomial\n\n$$\nf(X) = X^2 + 4X + 3.\n$$\n\nNote that, in order to evaluate this polynomial for an input matrix $X,$ we need to interpret any constants as multiples of the identity matrix. So, we interpret the polynomial as\n\n$$\nf(X) = X^2 + 4X + 3I.\n$$\n\nFor example, if ![](images/6a/6abb7cbdef9c5d7b23d8519468b174de369cfe4af4b9f8c4578ce7dc74812f63.svg) then\n\n$$\n\\begin{aligned}{A}^{2} & =\\begin{bmatrix}1 & 1 \\\\ 0 & 2\\end{bmatrix}\\begin{bmatrix}1 & 1 \\\\ 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 3 \\\\ 0 & 4\\end{bmatrix},\\end{aligned}\n$$\n\nand we can evaluate $f(A)$ as follows:\n\n$$\n\\begin{aligned}f(A) & ={A}^{2}+4A+3I \\\\  & =\\begin{bmatrix}1 & 3 \\\\ 0 & 4\\end{bmatrix}+4\\begin{bmatrix}1 & 1 \\\\ 0 & 2\\end{bmatrix}+3\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 3 \\\\ 0 & 4\\end{bmatrix}+\\begin{bmatrix}4 & 4 \\\\ 0 & 8\\end{bmatrix}+\\begin{bmatrix}3 & 0 \\\\ 0 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}1+4+3 & 3+4+0 \\\\ 0+0+0 & 4+8+3\\end{bmatrix} \\\\  & =\\begin{bmatrix}8 & 7 \\\\ 0 & 15\\end{bmatrix}\\end{aligned}\n$$" :tutorial/id #uuid "ac80f32c-3973-5ae6-b2de-3dcfd8494ec9" :tutorial/math-academy-id 3000 :tutorial/title "Matrix Polynomials"} :step/id #uuid "f5d78f09-ffdb-5e92-a5f6-53a783fa07ca" :step/math-academy-id 16204 :step/next {:db/id #edb/ref 17592186116105}} {:db/id #edb/ref 17592186116105 :step/content {:db/id #edb/ref 17592186115230 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115060 :question/id #uuid "bea8819f-6feb-5de6-a585-4379378ccdbd" :question/math-academy-id "e-4417" :question/problem "Consider the matrix\n![](images/f5/f5b9dd39e03e7a8c984d6a38db8dc32326669d134ff0b5aa012c421308b48351.svg)\nFind $f(D)$ if $f(X)=-X^2+3X+2.$" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & =-{X}^{2}+3X+2 \\\\  & =-{X}^{2}+3X+2I\\end{aligned}\n$$\n\nSo, we want to find $f(D)=-D^2+3D+2I.$\n\nLet's calculate $D^2$ as follows:\n\n$$\n\\begin{aligned}{D}^{2} & =D\\cdot D \\\\  & =\\begin{bmatrix}1 & 5 \\\\ 0 & -3\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 5 \\\\ 0 & -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -10 \\\\ 0 & 9\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(D)\\mathbin{:}$\n\n$$\n\\begin{aligned}f(D) & =-{D}^{2}+3D+2I \\\\  & =-\\begin{bmatrix}1 & -10 \\\\ 0 & 9\\end{bmatrix}+3\\begin{bmatrix}1 & 5 \\\\ 0 & -3\\end{bmatrix}+2\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & 10 \\\\ 0 & -9\\end{bmatrix}+\\begin{bmatrix}3 & 15 \\\\ 0 & -9\\end{bmatrix}+\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1+3+2 & 10+15+0 \\\\ 0 & -9-9+2\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 25 \\\\ 0 & -16\\end{bmatrix}\\end{aligned}\n$$"} :knowledge-point/id #uuid "61443225-bc08-5d36-a603-3a1d7e392a98" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049304} {:db/id #edb/ref 17592186050396} {:db/id #edb/ref 17592186050979}] :knowledge-point/questions [{:db/id #edb/ref 17592186115815 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab5cc2ba-0dd3-53ee-85de-59fa0989f944" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-15 & 12 \\\\ 12 & -15\\end{bmatrix}" :db/id #edb/ref 17592186113828} {:answer/id #uuid "ae301954-19e9-53b7-a9ef-b3628052b8c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & -5 \\\\ 12 & -3\\end{bmatrix}" :db/id #edb/ref 17592186113829} {:answer/id #uuid "b49126b5-7e77-5bb4-adfb-28921cbc67b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-12 & -9 \\\\ 12 & -15\\end{bmatrix}" :db/id #edb/ref 17592186113830} {:answer/id #uuid "012175e5-4dfe-53d3-b905-35f9ed1efa19" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}12 & 6 \\\\ -9 & -5\\end{bmatrix}" :db/id #edb/ref 17592186113831} {:answer/id #uuid "16da4201-228f-527e-a7cd-47f7dc065c3f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-12 & -7 \\\\ 12 & 5\\end{bmatrix}" :db/id #edb/ref 17592186113832}] :answer-field/id #uuid "d82536e3-a711-5a49-9809-0751f65e5601" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186113827}] :question/id #uuid "e5aa1a13-f959-58e6-a78a-1421fdfc84c4" :question/math-academy-id "q-36317" :question/problem "Consider the matrix $A = \\begin{bmatrix}1 & -3 \\\\ 4 & 0\\end{bmatrix}$. Find $f(A)$ if $f(X) = X^{2} + 2X - 3$."} {:db/id #edb/ref 17592186115954 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "001dc7ef-771a-5f18-a040-35f54dd30558" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & -2 \\\\ -3 & -1\\end{bmatrix}" :db/id #edb/ref 17592186345355} {:answer/id #uuid "3997efef-ffd5-574a-873e-4289ac66a0ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 4 \\\\ 6 & -1\\end{bmatrix}" :db/id #edb/ref 17592186345841} {:answer/id #uuid "441a64a8-1aba-5be9-8f3b-34682b8a82e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186345939} {:answer/id #uuid "5de5ceb0-1684-53d3-aa73-30371934b5cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & -2 \\\\ -3 & 7\\end{bmatrix}" :db/id #edb/ref 17592186346155} {:answer/id #uuid "88eb89bb-33d5-5560-9017-318c7157e5d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 4 \\\\ 6 & 7\\end{bmatrix}" :db/id #edb/ref 17592186346539}] :answer-field/correct {:db/id #edb/ref 17592186345939} :answer-field/id #uuid "05010135-b840-5a6d-b59b-80021acb313f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347618}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "12dbb97a-a553-543b-a68a-7b1edc9cc29f" :question/math-academy-id "q-78348" :question/problem "Consider the matrix $C=\\begin{bmatrix}1 & 2 \\\\ 3 & 1\\end{bmatrix}.$ Find $f(C)$ if $f(X)={X}^{2}-2X-5.$" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}-2X-5 \\\\  & ={X}^{2}-2X-5I\\end{aligned}\n$$\n\nSo, we want to find $f(C)={C}^{2}-2C-5I.$\n\nLet's calculate ${C}^{2}$ as follows:\n\n$$\n\\begin{aligned}{C}^{2} & =C\\cdot C \\\\  & =\\begin{bmatrix}1 & 2 \\\\ 3 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 2 \\\\ 3 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 & 4 \\\\ 6 & 7\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(C):$\n\n$$\n\\begin{aligned}f(C) & ={C}^{2}-2C-5I \\\\  & =\\begin{bmatrix}7 & 4 \\\\ 6 & 7\\end{bmatrix}-2\\begin{bmatrix}1 & 2 \\\\ 3 & 1\\end{bmatrix}-5\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 & 4 \\\\ 6 & 7\\end{bmatrix}-\\begin{bmatrix}2 & 4 \\\\ 6 & 2\\end{bmatrix}-\\begin{bmatrix}5 & 0 \\\\ 0 & 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}7-2-5 & 4-4-0 \\\\ 6-6-0 & 7-2-5\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265959 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49d028a5-8a03-5e08-89ba-3b07852c6d28" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 2 \\\\ -6 & -4\\end{bmatrix}" :db/id #edb/ref 17592186263635} {:answer/id #uuid "75945a9e-0d69-50c3-8c7f-b9b72b1fa4d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186264023} {:answer/id #uuid "7b752631-fd13-5ecd-969d-73a4cd84b715" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & -3 \\\\ 1 & -2\\end{bmatrix}" :db/id #edb/ref 17592186264067} {:answer/id #uuid "dad407e2-b4ee-5429-9878-21378d589357" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 1 \\\\ -3 & -2\\end{bmatrix}" :db/id #edb/ref 17592186264906} {:answer/id #uuid "f3d9fb09-369c-5b0a-89f2-45fa8bcd079b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186265141}] :answer-field/correct {:db/id #edb/ref 17592186265141} :answer-field/id #uuid "c4a421a3-2e9d-5427-887a-cb0e710dec85" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265590}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "90299e14-75b6-5c47-ba13-96fd48a42f9c" :question/math-academy-id "q-130684" :question/problem "Consider the matrix $D=\\begin{bmatrix}4 & 2 \\\\ -6 & -4\\end{bmatrix}.$  Find $f(D)$ if $f(X)={X}^{2}-4.$" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}-4 \\\\  & ={X}^{2}-4I\\end{aligned}\n$$\n\nSo, we want to find $f(D)={D}^{2}-4I.$ \n\nLet's calculate ${D}^{2}$ as follows:\n\n$$\n\\begin{aligned}{D}^{2} & =D\\cdot D \\\\  & =\\begin{bmatrix}4 & 2 \\\\ -6 & -4\\end{bmatrix}\\cdot \\begin{bmatrix}4 & 2 \\\\ -6 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 0 \\\\ 0 & 4\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(D):$\n\n$$\n\\begin{aligned}f(D) & ={D}^{2}-4I \\\\  & =\\begin{bmatrix}4 & 0 \\\\ 0 & 4\\end{bmatrix}-4\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 0 \\\\ 0 & 4\\end{bmatrix}+\\begin{bmatrix}-4 & 0 \\\\ 0 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}4-4 & 0+0 \\\\ 0+0 & 4-4\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295078 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3d5317a-31f3-54aa-a6b5-786a8ff7f811" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186293635}] :answer-field/correct {:db/id #edb/ref 17592186293635} :answer-field/id #uuid "6eb78f3a-36e5-5305-b6cb-2c5f0c33edd8" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186294318} {:answer-field/choices [{:answer/id #uuid "5c3ea9f9-60ad-5fe7-85fe-6d4d7a58ffd0" :answer/type {:db/ident :answer.type/math} :answer/value 