 :db/id #edb/ref 17592186568902} {:answer/id #uuid "cac55895-5084-5d25-aa5a-af919b6b7400" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186569030}] :answer-field/correct {:db/id #edb/ref 17592186569030} :answer-field/id #uuid "1630bab9-0849-50f8-b5ac-d394dc1848ec" :answer-field/key "M" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186568916} {:answer-field/choices [{:answer/id #uuid "8ba8e3d1-a08a-5c1b-9932-f7da58b04e8c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186568991} {:answer/id #uuid "ac43b27c-0d60-5044-b412-59893721d870" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186569012}] :answer-field/correct {:db/id #edb/ref 17592186568991} :answer-field/id #uuid "9cfaa159-c4cc-50fb-90cb-33f51c757767" :answer-field/key "H" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186569002} {:answer-field/choices [{:answer/id #uuid "6ec6e538-5559-5503-be15-77f01d3a3fc6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186568971} {:answer/id #uuid "f607b139-5dcc-5cd3-bfef-9e0291f54f01" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186569056}] :answer-field/correct {:db/id #edb/ref 17592186569056} :answer-field/id #uuid "b6e601d7-5d66-53da-9134-9ff90ecbe165" :answer-field/key "F" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186569016}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "24965ee9-6cd7-5689-8809-fc92026353b9" :question/problem "Which of the following are diagonal matrices?\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$F=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}$</div>\n<div>$H=\\begin{bmatrix}2 & 0 & 0 & 0 \\\\ 0 & 2 & 0 & 0 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 2\\end{bmatrix}$</div>\n<div>$M=\\begin{bmatrix}0 & -1 \\\\ 7 & -2\\end{bmatrix}$</div>\n</div>\n\nSelect all that apply." :question/worked-solution "- $F$ is a diagonal matrix. It is square and every off-diagonal entry is zero. It is also an identity matrix; identity matrices are diagonal matrices.\n\n- $H$ is a diagonal matrix. It is square and every off-diagonal entry is zero.\n\n- $M$ is *not* a diagonal matrix. It is square, but an entry off the main diagonal is nonzero: ${m}_{21}=7\\ne 0$.\n\nTherefore, only $F$ and $H$ are diagonal matrices."} {:db/id #edb/ref 17592186568926 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5b0e5c4-10d4-5856-a372-7614c553613c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186569008} {:answer/id #uuid "e0bf393f-b6fb-57d8-8aa6-abe976598bf0" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186569047}] :answer-field/correct {:db/id #edb/ref 17592186569008} :answer-field/id #uuid "5384f247-e5be-51b2-be3e-25f34d82aece" :answer-field/key "P" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186568949} {:answer-field/choices [{:answer/id #uuid "63779494-c79d-58f6-a010-823bab8347a2" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186568961} {:answer/id #uuid "748fd0b6-1d5a-5b27-92f6-8ee6665a10e3" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186568975}] :answer-field/correct {:db/id #edb/ref 17592186568961} :answer-field/id #uuid "5c2c1f45-1ed4-50ba-84c7-2190f3700c05" :answer-field/key "M" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186568955} {:answer-field/choices [{:answer/id #uuid "00efd316-4058-58f9-9e76-40f651e1957d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186568899} {:answer/id #uuid "c1405561-e678-5dce-bcf6-ea21e4cb9778" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186569024}] :answe