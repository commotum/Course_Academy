ces."}] :knowledge-point/title "Identifying a Special Square Matrix"} {:db/id #edb/ref 17592186087698 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087505 :question/id #uuid "0e3ad3cd-f7c4-55f4-8a0b-b850283bc6b0" :question/math-academy-id "e-4393" :question/problem "How can we best describe the following matrix?\n \n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$F=\\begin{bmatrix}5 \\\\ -9 \\\\ 2\\end{bmatrix}$</div>\n</div>" :question/worked-solution "Notice that $F$ is a matrix that has a single column. Therefore, it is a column vector."} :knowledge-point/id #uuid "7b6ddadb-471a-5195-a0f5-fd44bdc8f780" :knowledge-point/question-generator {:db/id #edb/ref 17592186510568 :question-generator/id #uuid "59ccd5bd-2e7f-5a1b-9d4e-06ec327ee7f6" :question-generator/script "generate/scratch/17592186087698.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186088360 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b80d0d6d-a385-5a9f-a38c-76c3157d90c8" :answer/type {:db/ident :answer.type/text} :answer/value "$E$ and $F$ only" :db/id #edb/ref 17592186086814} {:answer/id #uuid "c4407053-838c-5cfe-b16e-a6a789ddf292" :answer/type {:db/ident :answer.type/text} :answer/value "$E$ and $G$ only" :db/id #edb/ref 17592186086815} {:answer/id #uuid "f47d24db-e250-5d75-885d-049a07d12b0a" :answer/type {:db/ident :answer.type/text} :answer/value "$E$ only" :db/id #edb/ref 17592186086816} {:answer/id #uuid "43dd22ea-83f6-59bd-adb4-b3ed5b96f1ac" :answer/type {:db/ident :answer.type/text} :answer/value "$G$ only" :db/id #edb/ref 17592186086817} {:answer/id #uuid "5d4ef85d-5fa3-5b5f-9103-89c996c8b16d" :answer/type {:db/ident :answer.type/text} :answer/value "$F$ only" :db/id #edb/ref 17592186086818}] :answer-field/correct {:db/id #edb/ref 17592186086818} :answer-field/id #uuid "260570ad-e4aa-5ff7-9764-b4084d968c7d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186086813}] :question/id