& -2 & -5 & 10\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 2 & -8 \\\\ 0 & 1 & 3 & -2 \\\\ -1 & -2 & -5 & 10\\end{array}\\right] & {R}_{3}:={R}_{3}+(1){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 2 & -8 \\\\ 0 & 1 & 3 & -2 \\\\ 0 & -1 & -3 & 2\\end{array}\\right] & {R}_{3}:={R}_{3}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 2 & -8 \\\\ 0 & 1 & 3 & -2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] & {R}_{1}:={R}_{1}+(-1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & -1 & -6 \\\\ 0 & 1 & 3 & -2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-z &=-6 \\\\ y+3z &=-2.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=z-6 \\\\ y &=-3z-2 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}z-6 \\\\ -3z-2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"} {:db/id #edb/ref 17592186557551 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fa00707-ca62-5e26-8cd5-1f7625b9c10c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4z+2 \\\\ -3z-5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557528} {:answer/id #uuid "995676a6-2cf6-5858-b738-aba60a8aeefa" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4z+2 \\\\ -5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557541} {:answer/id #uuid "9cedd0e2-f0fe-57de-8bf9-74b0d6aeefe1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4z-2 \\\\ -3z-5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557542} {:answer/id #uuid "d32535a8-e248-5a18-9233-6d41ff79b84a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3z-5 \\\\ -4z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557560} {:answer/id #uuid "d7b08673-f5a7-5468-88d2-82fface9dd69" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4z+2 \\\\ -3z-5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557561}] :answer-field/correct {:db/id #edb/ref 17592186557528} :answer-field/id #uuid "32299d3b-6034-5ff8-afd5-342220d2ad49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557513}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "adb0568a-cc33-548d-9e70-7aec30b5b6bd" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+2y+14z &=-6 \\\\ x+4y+16z &=-18 \\\\ -2x-4y-20z &=16.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & 2 & 14 & -6 \\\\ 1 & 4 & 16 & -18 \\\\ -2 & -4 & -20 & 16\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}2 & 2 & 14 & -6 \\\\ 1 & 4 & 16 & -18 \\\\ -2 & -4 & -20 & 16\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 7 & -3 \\\\ 1 & 4 & 16 & -18 \\\\ -2 & -4 & -20 & 16\\end{array}\\right] & {R}_{2}:={R}_{2}+(-1){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 7 & -3 \\\\ 0 & 3 & 9 & -15 \\\\ -2 & -4 & -20 & 16\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 7 & -3 \\\\ 0 & 1 & 3 & -5 \\\\ -2 & -4 & -20 & 16\\end{array}\\right] & {R}_{3}:={R}_{3}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 7 & -3 \\\\ 0 & 1 & 3 & -5 \\\\ 0 & -2 & -6 & 10\\end{array}\\right] & {R}_{3}:={R}_{3}+(2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 7 & -3 \\\\ 0 & 1 & 3 & -5 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] & {R}_{1}:={R}_{1}+(-1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 4 & 2 \\\\ 0 & 1 & 3 & -5 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+4z &=2 \\\\ y+3z &=-5.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-4z+2 \\\\ y &=-3z-5 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-4z+2 \\\\ -3z-5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"} {:db/id #edb/ref 17592186557557 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11f75aad-535e-5349-ac30-0817cbc6131e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2w-2 \\\\ -w-6 \\\\ 3w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557507} {:answer/id #uuid "67b5aba3-9287-5655-a310-8b430569b715" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2w-2 \\\\ -w-6 \\\\ 3w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557531} {:answer/id #uuid "85f5e298-78dd-5de5-b5f3-f4c5ec30a051" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2w-2 \\\\ -6 \\\\ 3w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557535} {:answer/id #uuid "a0cb117c-63e0-5b48-8734-1e48dee2c005" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-w-6 \\\\ 2w-2 \\\\ 3w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557545} {:answer/id #uuid "f8bddcd4-51ea-5bca-9efc-633ffe6faec6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2w+2 \\\\ -w-6 \\\\ 3w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557571}] :answer-field/correct {:db/id #edb/ref 17592186557531} :answer-field/id #uuid "43ca07dd-c5bb-5c16-9ac1-3f7c98019646" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557521}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c7e5dc6c-e550-5c9b-8c75-fe188ef23a8b" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+2y+2z-8w &=-22 \\\\ -x+2y+2z-2w &=-16 \\\\ x+2y+4z-12w &=-26.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cccc|c}2 & 2 & 2 & -8 & -22 \\\\ -1 & 2 & 2 & -2 & -16 \\\\ 1 & 2 & 4 & -12 & -26\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cccc|c}2 & 2 & 2 & -8 & -22 \\\\ -1 & 2 & 2 & -2 & -16 \\\\ 1 & 2 & 4 & -12 & -26\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ -1 & 2 & 2 & -2 & -16 \\\\ 1 & 2 & 4 & -12 & -26\\end{array}\\right] & {R}_{2}:={R}_{2}+(1){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ 0 & 3 & 3 & -6 & -27 \\\\ 1 & 2 & 4 & -12 & -26\\end{array}\\right] & {R}_{3}:={R}_{3}+(-1){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ 0 & 3 & 3 & -6 & -27 \\\\ 0 & 1 & 3 & -8 & -15\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ 0 & 1 & 1 & -2 & -9 \\\\ 0 & 1 & 3 & -8 & -15\\end{array}\\right] & {R}_{3}:={R}_{3}+(-1){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ 0 & 1 & 1 & -2 & -9 \\\\ 0 & 0 & 2 & -6 & -6\\end{array}\\right] & {R}_{3}:=\\frac{1}{2}{R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ 0 & 1 & 1 & -2 & -9 \\\\ 0 & 0 & 1 & -3 & -3\\end{array}\\right] & {R}_{2}:={R}_{2}+(-1){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ 0 & 1 & 0 & 1 & -6 \\\\ 0 & 0 & 1 & -3 & -3\\end{array}\\right] & {R}_{1}:={R}_{1}+(-1){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 0 & -1 & -8 \\\\ 0 & 1 & 0 & 1 & -6 \\\\ 0 & 0 & 1 & -3 & -3\\end{array}\\right] & {R}_{1}:={R}_{1}+(-1){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 0 & 0 & -2 & -2 \\\\ 0 & 1 & 0 & 1 & -6 \\\\ 0 & 0 & 1 & -3 & -3\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-2w &=-2 \\\\ y+w &=-6 \\\\ z-3w &=-3.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$ and $z$, and we have one free variable, $w$. That means we need to find $x$ and $y$ and $z$ in terms of $w$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=2w-2 \\\\ y &=-w-6 \\\\ z &=3w-3 \\\\ w &=w,\\end{aligned}\\right.\n$$\n\nwhere $w$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z \\\\ w\\end{bmatrix}=\\begin{bmatrix}2w-2 \\\\ -w-6 \\\\ 3w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty ).\n$$"} {:db/id #edb/ref 17592186557558 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "111ff2e8-5074-588e-a4a9-3d3cfb18d3bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4z-4 \\\\ 2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557506} {:answer/id #uuid "3076215c-304a-5d01-86d1-3ff9741ff4dd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4z-4 \\\\ -4z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557512} {:answer/id #uuid "3fb3301d-33c0-5158-a03e-64250a27b511" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4z+2 \\\\ -4z-4 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557518} {:answer/id #uuid "3febba3a-efe2-57ba-8af5-de2985e82134" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4z+4 \\\\ -4z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557519} {:answer/id #uuid "48c2af1b-9196-5808-96db-88b7f04e41cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4z-4 \\\\ -4z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557524}] :answer-field/correct {:db/id #edb/ref 17592186557524} :answer-field/id #uuid "149fd90e-5691-5c54-8ab7-8d87034698b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557508}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d05ea200-995d-55b2-a1b7-0a4ae934dd54" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-4y-8z &=-16 \\\\ 2x-y+4z &=-10 \\\\ 2x-5y-12z &=-18.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & -4 & -8 & -16 \\\\ 2 & -1 & 4 & -10 \\\\ 2 & -5 & -12 & -18\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}2 & -4 & -8 & -16 \\\\ 2 & -1 & 4 & -10 \\\\ 2 & -5 & -12 & -18\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -4 & -8 \\\\ 2 & -1 & 4 & -10 \\\\ 2 & -5 & -12 & -18\\end{array}\\right] & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -4 & -8 \\\\ 0 & 3 & 12 & 6 \\\\ 2 & -5 & -12 & -18\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -4 & -8 \\\\ 0 & 1 & 4 & 2 \\\\ 2 & -5 & -12 & -18\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -4 & -8 \\\\ 0 & 1 & 4 & 2 \\\\ 0 & -1 & -4 & -2\\end{array}\\right] & {R}_{3}:={R}_{3}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -4 & -8 \\\\ 0 & 1 & 4 & 2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] & {R}_{1}:={R}_{1}+(2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 4 & -4 \\\\ 0 & 1 & 4 & 2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+4z &=-4 \\\\ y+4z &=2.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-4z-4 \\\\ y &=-4z+2 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-4z-4 \\\\ -4z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"} {:db/id #edb/ref 17592186557567 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c0da7ae-0be2-5a15-bb78-e9aa6a4e73bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2z-3 \\\\ -3z+5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557526} {:answer/id #uuid "7271e45f-8553-5ce0-acb1-6c300273e818" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2z+3 \\\\ -3z+5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557533} {:answer/id #uuid "8ccb0a70-9168-5376-aab3-e2bf68061d3a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2z-3 \\\\ -3z+5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557538} {:answer/id #uuid "b8bdf101-8a17-59f6-92cc-0d92a551d21e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2z-3 \\\\ 5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557555} {:answer/id #uuid "f5a634f4-002a-58cb-96bc-17a4efd0a7ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3z+5 \\\\ -2z-3 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557568}] :answer-field/correct {:db/id #edb/ref 17592186557538} :answer-field/id #uuid "a2993581-de40-5699-b32f-c45f7304d89a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557546}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f34874f6-66c0-58d0-a503-ac8424ffc0ef" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-2y-2z &=-16 \\\\ 2x+y+7z &=-1 \\\\ 2x+4z &=-6.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & -2 & -2 & -16 \\\\ 2 & 1 & 7 & -1 \\\\ 2 & 0 & 4 & -6\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}2 & -2 & -2 & -16 \\\\ 2 & 1 & 7 & -1 \\\\ 2 & 0 & 4 & -6\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 2 & 1 & 7 & -1 \\\\ 2 & 0 & 4 & -6\\end{array}\\right] & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 0 & 3 & 9 & 15 \\\\ 2 & 0 & 4 & -6\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 0 & 1 & 3 & 5 \\\\ 2 & 0 & 4 & -6\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 0 & 1 & 3 & 5 \\\\ 0 & 2 & 6 & 10\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 0 & 1 & 3 & 5 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] & {R}_{1}:={R}_{1}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -3 \\\\ 0 & 1 & 3 & 5 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+2z &=-3 \\\\ y+3z &=5.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-2z-3 \\\\ y &=-3z+5 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-2z-3 \\\\ -3z+5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"} {:db/id #edb/ref 17592186557569 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ce1dc0c-75ef-52c2-bd4b-bf75d5f2e8dd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4z+6 \\\\ 3z+4 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557510} {:answer/id #uuid "3bf6b08b-6231-5a56-a8e3-c43b285af62d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3z-4 \\\\ 4z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557516} {:answer/id #uuid "86cd4be6-2d2c-56d7-b46a-2c157bb80402" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3z+4 \\\\ 4z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557537} {:answer/id #uuid "d2124629-8825-54e6-8828-d3638950e6b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3z+4 \\\\ 6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557559} {:answer/id #uuid "ea30a4a7-e209-5d31-bfc9-6aaf3dccb98b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3z+4 \\\\ 4z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557564}] :answer-field/correct {:db/id #edb/ref 17592186557564} :answer-field/id #uuid "33817d11-0d35-5223-ad95-222c9e4cd34e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557514}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f6291f54-74fa-5018-8da1-0d69f2fed16a" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-2y+2z &=-4 \\\\ -2x+5y-14z &=22 \\\\ 2x-4y+10z &=-16.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & -2 & 2 & -4 \\\\ -2 & 5 & -14 & 22 \\\\ 2 & -4 & 10 & -16\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}2 & -2 & 2 & -4 \\\\ -2 & 5 & -14 & 22 \\\\ 2 & -4 & 10 & -16\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ -2 & 5 & -14 & 22 \\\\ 2 & -4 & 10 & -16\\end{array}\\right] & {R}_{2}:={R}_{2}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ 0 & 3 & -12 & 18 \\\\ 2 & -4 & 10 & -16\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ 0 & 1 & -4 & 6 \\\\ 2 & -4 & 10 & -16\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ 0 & 1 & -4 & 6 \\\\ 0 & -2 & 8 & -12\\end{array}\\right] & {R}_{3}:={R}_{3}+(2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ 0 & 1 & -4 & 6 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] & {R}_{1}:={R}_{1}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & -3 & 4 \\\\ 0 & 1 & -4 & 6 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-3z &=4 \\\\ y-4z &=6.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=3z+4 \\\\ y &=4z+6 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}3z+4 \\\\ 4z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"}] :knowledge-point/title "Solving a Consistent System of Equations Using Gauss-Jordan Elimination"} :step/id #uuid "79bb6bd1-8c36-5f56-9575-8a1b8388eb57" :step/math-academy-id 17214 :step/next {:db/id #edb/ref 17592186116122}} {:db/id #edb/ref 17592186116122 :step/content {:db/id #edb/ref 17592186116494 :tutorial/content "Recall that a system of linear equations is called **consistent** if it has at least one solution. Otherwise, if there are no solutions, the system is called **inconsistent**. \n\nFor a consistent system, \n\n- the system is called **consistent independent** if the solution is unique, while\n\n- the system is called **consistent dependent** if there are infinitely many solutions.\n\n![](images/f5/f5b808eac6e1d865b13b68ce2a4f7d317560ae3965928e478531fcd2148c2c6b.png)" :tutorial/id #uuid "e0c85152-daea-5a87-a3ba-81870558c7a2" :tutorial/math-academy-id 3163 :tutorial/title "Consistent and Inconsistent Systems of Linear Equations"} :step/id #uuid "2fa6eba1-6298-51b5-bbc9-bd8c46a79468" :step/math-academy-id 17215 :step/next {:db/id #edb/ref 17592186116209}} {:db/id #edb/ref 17592186116123 :step/content {:db/id #edb/ref 17592186115242 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115071 :question/id #uuid "f2c7cfd3-da43-5208-bd0e-21692357fabe" :question/math-academy-id "e-4712" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}2x-2y &=1, \\\\ 4x+ky &=-3\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n![](images/6f/6fa4508463b059ce8ef9a5cfa720de9463e41ecdbfb16f4460870bb6fce444bc.svg)\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & -2 & 1 \\\\ 4 & k & -3\\end{bmatrix} & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -2 & 1 \\\\ 0 & k+4 & -5\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n![](images/21/215ff061dc7584055bf607f48d0048cb6bde4dcb1ed028fbf4c3a4bd47d89c25.svg)\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-4,$ then the second equation is $0=-5,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-4.$"} :knowledge-point/id #uuid "22733f71-de4a-5058-a41c-039e66e333c5" :knowledge-point/question-generator {:db/id #edb/ref 17592186557445 :question-generator/id #uuid "8ae9e325-9ab6-53e2-9f58-322c0a6527aa" :question-generator/script "generate/scratch/17592186115242.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186115753 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3248af5c-24d6-51a0-a62b-8d5ab0e0e782" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186300213} {:answer/id #uuid "5ed5f31b-5757-56ca-ac90-622019b8d7e7" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{4}{3}" :db/id #edb/ref 17592186300447} {:answer/id #uuid "6b3ca3f5-57b3-5b3c-b6b4-0772e9be135c" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{3}{4}" :db/id #edb/ref 17592186300503} {:answer/id #uuid "6f2681ec-b8ae-51dc-9094-2e2bcadf6d8a" :answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186300522} {:answer/id #uuid "fad186f0-c1c8-5bcc-8cc3-09b1f4f1ed49" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{4}{3}" :db/id #edb/ref 17592186301203}] :answer-field/correct {:db/id #edb/ref 17592186300447} :answer-field/id #uuid "9bc72922-bebc-50a1-a8ff-483d8fbfcfc6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186301729}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2a9a3feb-6c16-50e8-885d-ee5cd242ab95" :question/math-academy-id "q-32246" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n\\left\\{\\begin{aligned}3x+4y &=12 \\\\ x+ky &=4\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}3 & 4 & 12 \\\\ 1 & k & 4\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}3 & 4 & 12 \\\\ 1 & k & 4\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & k & 4 \\\\ 3 & 4 & 12\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & k & 4 \\\\ 0 & 4-3k & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+ky &=4 \\\\ (4-3k)y &=0.\\end{aligned}\\right.\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=\\frac{4}{3},$ then the second equation is $0=0,$ which is true for any value of $y$, and we can remove this equation from the system. As a result, the system will contain only one equation, $x+ky=4.$ \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=\\frac{4}{3}.$"} {:db/id #edb/ref 17592186115831 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "359439f2-81e1-5ced-8482-b2cf08a71409" :answer/type {:db/ident :answer.type/math} :answer/value "k=9" :db/id #edb/ref 17592186425939} {:answer/id #uuid "478b28da-a8a3-51e4-963d-8ac53adc010e" :answer/type {:db/ident :answer.type/math} :answer/value "k=6" :db/id #edb/ref 17592186425941} {:answer/id #uuid "545c0eb7-c35a-5d44-b8e2-b045ff203715" :answer/type {:db/ident :answer.type/math} :answer/value "k=4" :db/id #edb/ref 17592186425942} {:answer/id #uuid "684ddf9d-dd44-5397-b1a8-e6e3ca6a2f95" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186425943} {:answer/id #uuid "9720657d-4e06-51f7-8e91-da074201b940" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186425945}] :answer-field/correct {:db/id #edb/ref 17592186425941} :answer-field/id #uuid "e3a07998-8f4c-5e30-bdee-b2acbf389fbd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186113923}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "84cf8820-fa64-5d50-9d9c-d3a9404788a4" :question/math-academy-id "q-42059" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}2x+3y &=1 \\\\ 6x+(k+3)y &=-5\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}2 & 3 & 1 \\\\ 6 & k+3 & -5\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & 3 & 1 \\\\ 6 & k+3 & -5\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 3 & 1 \\\\ 0 & k-6 & -8\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}2x+3y &=1 \\\\ (k-6)y &=-8.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=6,$ then the second equation is $0=-8,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=6.$"} {:db/id #edb/ref 17592186266116 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "188d8234-d927-5fa4-9649-52a3600a14ed" :answer/type {:db/ident :answer.type/math} :answer/value "k=-13" :db/id #edb/ref 17592186263232} {:answer/id #uuid "59917889-7526-5cea-90f8-6ed9b5d31888" :answer/type {:db/ident :answer.type/math} :answer/value "k=8" :db/id #edb/ref 17592186263771} {:answer/id #uuid "84ec393a-992f-55d2-9044-1e362627ed1c" :answer/type {:db/ident :answer.type/math} :answer/value "k=-12" :db/id #edb/ref 17592186264142} {:answer/id #uuid "9556b060-0b9f-5486-b05c-79753916db1d" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186264279} {:answer/id #uuid "c483c739-bc7d-5f47-8dbf-09da12b3a0b2" :answer/type {:db/ident :answer.type/math} :answer/value "k=-14" :db/id #edb/ref 17592186264722}] :answer-field/correct {:db/id #edb/ref 17592186263232} :answer-field/id #uuid "4c23e17f-c925-52e8-86bd-0f648e063de0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265388}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7d3ed27b-d876-58c6-8a51-55f4b36743e6" :question/math-academy-id "q-131726" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}-3x+2y &=1 \\\\ 6x+(k+9)y &=5\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}-3 & 2 & 1 \\\\ 6 & k+9 & 5\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-3 & 2 & 1 \\\\ 6 & k+9 & 5\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}-3 & 2 & 1 \\\\ 0 & k+13 & 7\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}-3x+2y &=1 \\\\ (k+13)y &=7.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-13,$ then the second equation is $0=7,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-13.$"} {:db/id #edb/ref 17592186266117 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a4e76fd-e1c6-5cbe-93b0-49387b6d03cd" :answer/type {:db/ident :answer.type/math} :answer/value "k=-13" :db/id #edb/ref 17592186263361} {:answer/id #uuid "c2f1c78c-35e7-5dc3-a4ea-917746946f9c" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186264698} {:answer/id #uuid "cad2e0cc-59d8-5847-8c17-7f7022f7428b" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186264775} {:answer/id #uuid "ddd34857-39b4-5a84-88c6-46284b56c129" :answer/type {:db/ident :answer.type/math} :answer/value "k=-12" :db/id #edb/ref 17592186264929} {:answer/id #uuid "f74d0318-2803-55b8-bb5b-49c8150dea17" :answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186265163}] :answer-field/correct {:db/id #edb/ref 17592186265163} :answer-field/id #uuid "80ce296a-26b4-5d5b-bab5-71101c246341" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265471}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0e7e4e8f-70c3-5d1c-92c5-d1d6f120ba7c" :question/math-academy-id "q-131727" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x-3y &=-1 \\\\ 4x+3ky &=3\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & -3 & -1 \\\\ 4 & 3k & 3\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -3 & -1 \\\\ 4 & 3k & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}-4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & -1 \\\\ 0 & 3k+12 & 7\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x-3y &=-1 \\\\ (3k+12)y &=7.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-4,$ then the second equation is $0=7,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-4.$"} {:db/id #edb/ref 17592186266118 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e3a6e2e-1b7a-5ad1-b366-2deecae63253" :answer/type {:db/ident :answer.type/math} :answer/value "k=1" :db/id #edb/ref 17592186264216} {:answer/id #uuid "96b3aa58-5c89-5f3c-896e-547bdfeef87c" :answer/type {:db/ident :answer.type/math} :answer/value "k=-1" :db/id #edb/ref 17592186264291} {:answer/id #uuid "9c0fed83-26f2-58cf-9e61-edca1345442b" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186264336} {:answer/id #uuid "bedfa238-a1cb-50f4-b26d-08ac9994d923" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186264662} {:answer/id #uuid "cffb3874-d3c5-58d9-9efc-875fe9730f23" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186264822}] :answer-field/correct {:db/id #edb/ref 17592186264291} :answer-field/id #uuid "567ae966-e7d1-5296-a3f6-661d2e59d117" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265397}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5288d9bb-0110-5357-979f-882b0ee060b3" :question/math-academy-id "q-131728" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}-x+4y &=-2 \\\\ -3x+(3k+15)y &=-4\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}-1 & 4 & -2 \\\\ -3 & 3k+15 & -4\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-1 & 4 & -2 \\\\ -3 & 3k+15 & -4\\end{bmatrix} & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\begin{bmatrix}-1 & 4 & -2 \\\\ 0 & 3k+3 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}-x+4y &=-2 \\\\ (3k+3)y &=2.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-1,$ then the second equation is $0=2,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-1.$"} {:db/id #edb/ref 17592186266119 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "427da7e5-15ac-51bd-a759-d90b6c65d454" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{2}{7}" :db/id #edb/ref 17592186263588} {:answer/id #uuid "538a47b2-6a0b-5a53-99e0-b4e09df09626" :answer/type {:db/ident :answer.type/math} :answer/value "k=-7" :db/id #edb/ref 17592186263720} {:answer/id #uuid "7f383d71-c4b1-501b-823d-dfdddaac22d3" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{7}{2}" :db/id #edb/ref 17592186264099} {:answer/id #uuid "b60949ed-65e4-5904-90e9-755392f2794a" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{7}{2}" :db/id #edb/ref 17592186264578} {:answer/id #uuid "d7266032-5cfb-59d1-b694-4b3ac335232b" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186264875}] :answer-field/correct {:db/id #edb/ref 17592186264578} :answer-field/id #uuid "446ceb46-6d4a-51ab-82b3-1f055fd41555" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265373}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "49ba50cf-14b7-5be4-8660-2e096dc4c172" :question/math-academy-id "q-131729" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n\\left\\{\\begin{aligned}-2x+7y &=6 \\\\ x+ky &=-3\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}-2 & 7 & 6 \\\\ 1 & k & -3\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-2 & 7 & 6 \\\\ 1 & k & -3\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & k & -3 \\\\ -2 & 7 & 6\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & k & -3 \\\\ 0 & 2k+7 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+ky &=-3 \\\\ (2k+7)y &=0.\\end{aligned}\\right.\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=-\\frac{7}{2},$ then the second equation is $0=0,$ which is true for any value of $y$, and we can remove this equation from the system. As a result, the system will contain only one equation, $x+ky=-3.$ \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=-\\frac{7}{2}.$"} {:db/id #edb/ref 17592186266120 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5280ce29-a009-5d89-b11c-32a91956f88d" :answer/type {:db/ident :answer.type/math} :answer/value "k=-9" :db/id #edb/ref 17592186263711} {:answer/id #uuid "a8cf5fce-3112-5b03-8cf3-0d4a08494133" :answer/type {:db/ident :answer.type/math} :answer/value "k=-6" :db/id #edb/ref 17592186264442} {:answer/id #uuid "bac8e055-43dd-52ec-b2ee-c1af2bc589d4" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186264621} {:answer/id #uuid "bf50ed27-034a-525d-8d4e-b76acf4ead2d" :answer/type {:db/ident :answer.type/math} :answer/value "k=9" :db/id #edb/ref 17592186264666} {:answer/id #uuid "d2c3e1a0-f525-5859-8a97-2dbc90d7ad24" :answer/type {:db/ident :answer.type/math} :answer/value "k=-12" :db/id #edb/ref 17592186264838}] :answer-field/correct {:db/id #edb/ref 17592186263711} :answer-field/id #uuid "fe108dd5-5b35-596c-94e7-349c53f9ba7a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265698}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "87026642-3a4d-5af1-8cd6-01d366fc76fa" :question/math-academy-id "q-131731" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n\\left\\{\\begin{aligned}-2x+6y &=-4 \\\\ 5x+(k-6)y &=10\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}-2 & 6 & -4 \\\\ 5 & k-6 & 10\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-2 & 6 & -4 \\\\ 5 & k-6 & 10\\end{bmatrix} & {R}_{2} & :={R}_{2}+\\frac{5}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & 6 & -4 \\\\ 0 & k+9 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}-2x+6y &=-4 \\\\ (k+9)y &=0.\\end{aligned}\\right.\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=-9,$ then the second equation is $0=0,$ which is true for any value of $y.$ So, we can remove this equation from the system. As a result, the system will contain only one equation, $-2x+6y=-4.$  \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=-9.$"} {:db/id #edb/ref 17592186302109 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9eefeb35-a93a-5693-8a54-a335560cde62" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186300764} {:answer/id #uuid "a14a43e5-9b21-562f-aaa1-5f805da32173" :answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186300773} {:answer/id #uuid "a2621a0b-e192-593d-b62d-8165fb69e7a9" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186300778} {:answer/id #uuid "b3d7fb16-c926-51ed-a5b0-cbfd28c2fab5" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186300857} {:answer/id #uuid "f15a5a0a-88a7-5b7b-9e41-9d091c25e2a8" :answer/type {:db/ident :answer.type/math} :answer/value "k=4" :db/id #edb/ref 17592186301152}] :answer-field/correct {:db/id #edb/ref 17592186300857} :answer-field/id #uuid "0c0fdc5a-0dcc-576e-afcb-e159db8dd3fe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186301262}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "534e2a93-e71a-5475-894e-dfd5ca99a3a6" :question/math-academy-id "q-32245" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}2x-y &=3 \\\\ 4x+ky &=4\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}2 & -1 & 3 \\\\ 4 & k & 4\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & -1 & 3 \\\\ 4 & k & 4\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -1 & 3 \\\\ 0 & k+2 & -2\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}2x-y &=3 \\\\ (k+2)y &=-2.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nNow if $k=-2$, then the second equation is $0=-2,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when  $k=-2.$"} {:db/id #edb/ref 17592186302143 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39edf270-ef24-52e6-8a06-10a72874478d" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186300241} {:answer/id #uuid "441122b0-3b95-5e4c-ad49-ebd17ab5fd1b" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186300297} {:answer/id #uuid "7951ba97-6d77-594c-84f6-7b1ce6a00426" :answer/type {:db/ident :answer.type/math} :answer/value "k=-5" :db/id #edb/ref 17592186300560} {:answer/id #uuid "8713309c-6e3b-5cbf-9236-a21b2e8d5efd" :answer/type {:db/ident :answer.type/math} :answer/value "k=-8" :db/id #edb/ref 17592186300642} {:answer/id #uuid "99ccc30d-db87-5ff3-b366-54bc530fc04c" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186300734}] :answer-field/correct {:db/id #edb/ref 17592186300241} :answer-field/id #uuid "7a94e5ac-1c4c-5f66-9534-54809e136ec5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186301608}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f5f8dda9-f72e-566e-91bc-44ecdce08b8e" :question/math-academy-id "q-32331" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}-4x-y &=2 \\\\ 8x+ky &=5\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}-4 & -1 & 2 \\\\ 8 & k & 5\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-4 & -1 & 2 \\\\ 8 & k & 5\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}-4 & -1 & 2 \\\\ 0 & k-2 & 9\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}-4x-y &=2 \\\\ (k-2)y &=9.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=2,$ then the second equation is $0=9,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=2.$"} {:db/id #edb/ref 17592186344961 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b9a3770-af37-58af-91e7-3430fd2463b3" :answer/type {:db/ident :answer.type/math} :answer/value "k=5" :db/id #edb/ref 17592186343154} {:answer/id #uuid "71cae964-c567-5585-ab23-7241fb114732" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186343221} {:answer/id #uuid "a8f3da90-4b17-5b45-af78-2746f79a0b95" :answer/type {:db/ident :answer.type/math} :answer/value "k=1" :db/id #edb/ref 17592186343724} {:answer/id #uuid "ad97781e-f202-56a0-803a-f17ee1a49ca9" :answer/type {:db/ident :answer.type/math} :answer/value "k=9" :db/id #edb/ref 17592186343764} {:answer/id #uuid "f0d5b11f-4138-5c57-8bc8-f9f3a404cfaa" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186344356}] :answer-field/correct {:db/id #edb/ref 17592186344356} :answer-field/id #uuid "6517af05-6089-578f-972a-9310f8010c94" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344664}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a0c28bd7-70de-59aa-93c9-933cbaca4593" :question/math-academy-id "q-74646" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x+4y &=2 \\\\ 2x+(k+1)y &=3\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 4 & 2 \\\\ 2 & k+1 & 3\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 4 & 2 \\\\ 2 & k+1 & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 4 & 2 \\\\ 0 & k-7 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+4y &=2 \\\\ (k-7)y &=-1.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=7,$ then the second equation is $0=-1,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=7.$"} {:db/id #edb/ref 17592186344969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30949865-bcb4-5324-b20a-5013ed16ed8b" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186342643} {:answer/id #uuid "b02857e6-f7e6-504c-84a4-ca08044eec2c" :answer/type {:db/ident :answer.type/math} :answer/value "k=-1" :db/id #edb/ref 17592186343786} {:answer/id #uuid "bd377e49-f3f5-59d7-82a4-fcccc36aefd5" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186343902} {:answer/id #uuid "cffbe52d-faab-5e8d-a8c2-edecdb561a49" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186344066} {:answer/id #uuid "d763087a-bc9a-5f66-ac0e-8fa93b6ecd3b" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186344130}] :answer-field/correct {:db/id #edb/ref 17592186344066} :answer-field/id #uuid "78098d80-b356-5405-a056-ca928a0838fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344710}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bdfa86e8-f2dc-5d19-9144-98ae43ab2ede" :question/math-academy-id "q-74688" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-4 \\\\ 3x+2ky &=-2\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}1 & 2 & -4 \\\\ 3 & 2k & -2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & -4 \\\\ 3 & 2k & -2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & -4 \\\\ 0 & 2k-6 & 10\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+2y &=-4 \\\\ (2k-6)y &=10.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=3,$ then the second equation is $0=10,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=3.$"} {:db/id #edb/ref 17592186344971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ba1e46b-dcb4-5f9e-b60f-f807d3ae1d2d" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{1}{4}" :db/id #edb/ref 17592186342339} {:answer/id #uuid "47f4259f-5c12-50a0-8a37-001fbf58b6db" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{1}{4}" :db/id #edb/ref 17592186342833} {:answer/id #uuid "761008e6-93b4-567d-8e13-46b3d3b90948" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{1}{2}" :db/id #edb/ref 17592186343257} {:answer/id #uuid "ec9c9c6a-7091-5c96-a5e5-dd27877f775b" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186344317} {:answer/id #uuid "fa6d777f-a907-5d3e-9303-b5a3d04a19d9" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{1}{8}" :db/id #edb/ref 17592186344440}] :answer-field/correct {:db/id #edb/ref 17592186343257} :answer-field/id #uuid "4c8919c1-08e4-5d2b-8a8d-6b97ba594aea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344620}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "db41cb50-724f-5af7-85df-697ff3307e10" :question/math-academy-id "q-74695" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n\\left\\{\\begin{aligned}4x+2y &=-8 \\\\ x+ky &=-2\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}4 & 2 & -8 \\\\ 1 & k & -2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}4 & 2 & -8 \\\\ 1 & k & -2\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & k & -2 \\\\ 4 & 2 & -8\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-4){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & k & -2 \\\\ 0 & 2-4k & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+ky &=2 \\\\ (2-4k)y &=0.\\end{aligned}\\right.\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=\\frac{1}{2},$ then the second equation is $0=0,$ which is true for any value of $y$, and we can remove this equation from the system. As a result, the system will contain only one equation, $x+ky=2.$ \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=\\frac{1}{2}.$"} {:db/id #edb/ref 17592186398982 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e3df6cd2-68c7-5027-b94c-cebc3edbefd0" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{1}{2}" :db/id #edb/ref 17592186398984} {:answer/id #uuid "3d7403d1-9523-59ef-892c-8762070fc770" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{1}{2}" :db/id #edb/ref 17592186398985} {:answer/id #uuid "43b3ca27-4022-5e94-91a9-05d77b4b0c3b" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186398986} {:answer/id #uuid "321a43c8-209e-53e7-bddf-716f4dd735c7" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186398987} {:answer/id #uuid "a9f1972b-cdc9-5bbd-bf68-8c034ebe8712" :answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186398988}] :answer-field/correct {:db/id #edb/ref 17592186398987} :answer-field/id #uuid "ce520123-e722-5fc8-b4b5-0ce963a1fe4b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186398983}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2b1df7fe-03a7-50e4-93e7-ab9ba910308e" :question/math-academy-id "q-74650" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n\\left\\{\\begin{aligned}2x+6y &=4 \\\\ x+(k+1)y &=2\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}2 & 6 & 4 \\\\ 1 & k+1 & 2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & 6 & 4 \\\\ 1 & k+1 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-\\frac{1}{2}){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 6 & 4 \\\\ 0 & k-2 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}2x+6y &=4 \\\\ (k-2)y &=0.\\end{aligned}\\right.\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=2,$ then the second equation is $0=0,$ which is true for any value of $y.$ So, we can remove this equation from the system. As a result, the system will contain only one equation, $2x+6y=4.$  \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=2.$"} {:db/id #edb/ref 17592186417082 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0250b550-0b7c-5c05-b8f5-33da7345f93c" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186417069} {:answer/id #uuid "0e30254f-fef5-5030-ad74-62323657f390" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186417070} {:answer/id #uuid "32810e7f-ad8d-5b1e-a7d2-839ff11f12a9" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{2}{3}" :db/id #edb/ref 17592186417071} {:answer/id #uuid "5b0d5bd9-5c97-5445-afdc-58640864c07d" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{2}{3}" :db/id #edb/ref 17592186417074} {:answer/id #uuid "e23cbcca-7092-5855-aeeb-dd2de6061a27" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{3}{2}" :db/id #edb/ref 17592186417078}] :answer-field/correct {:db/id #edb/ref 17592186417071} :answer-field/id #uuid "26b28742-5ee2-597a-8428-7062724625e9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186417079}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6deb5ca1-ae5b-5721-895d-6efa8ac5fdfb" :question/math-academy-id "q-131730" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n\\left\\{\\begin{aligned}3x+2y &=12 \\\\ x+ky &=4\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}3 & 2 & 12 \\\\ 1 & k & 4\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}3 & 2 & 12 \\\\ 1 & k & 4\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & k & 4 \\\\ 3 & 2 & 12\\end{bmatrix} & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & k & 4 \\\\ 0 & 2-3k & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+ky &=4 \\\\ (2-3k)y &=0.\\end{aligned}\\right.\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=\\frac{2}{3},$ then the second equation is $0=0,$ which is true for any value of $y$, and we can remove this equation from the system. As a result, the system will contain only one equation, $x+ky=4.$ \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=\\frac{2}{3}.$"} {:db/id #edb/ref 17592186425949 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17602323-8777-51fe-9a70-fac173438e8d" :answer/type {:db/ident :answer.type/math} :answer/value "k=1" :db/id #edb/ref 17592186425938} {:answer/id #uuid "3745dd5b-bc8f-5c5f-bfbb-0a70d0ee8eee" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186425940} {:answer/id #uuid "8c1862b9-030a-5755-b668-e59ca4c9e456" :answer/type {:db/ident :answer.type/math} :answer/value "k=-5" :db/id #edb/ref 17592186425944} {:answer/id #uuid "a1294db0-0da9-5a02-b9e5-791ef34dcf11" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186425946} {:answer/id #uuid "cf6dc1f0-4ead-53bf-8e9f-9b57805aa51d" :answer/type {:db/ident :answer.type/math} :answer/value "k=5" :db/id #edb/ref 17592186425947}] :answer-field/correct {:db/id #edb/ref 17592186425947} :answer-field/id #uuid "80130b9b-78a0-54cc-bf84-e036ce6c2ff0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186425948}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "db005b4e-86cd-5194-b2fd-10ca4ee59c03" :question/math-academy-id "q-42021" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n\\left\\{\\begin{aligned}x+2y &=3 \\\\ -3x-(k+1)y &=-9\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 2 & -3 \\\\ -3 & -(k+1) & -9\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & 3 \\\\ -3 & -(k+1) & -9\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 3 \\\\ 0 & -k+5 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}1-2y &=3 \\\\ -(k-5)y &=0.\\end{aligned}\\right.\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=5,$ then the second equation is $0=0,$ which is true for any value of $y$, and we can remove this equation from the system. As a result, the system will contain only one equation, $x+2y=3.$ \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=5.$"} {:db/id #edb/ref 17592186492874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a7b0d87-9712-510c-adb7-5bde077204da" :answer/type {:db/ident :answer.type/math} :answer/value "k=10" :db/id #edb/ref 17592186492235} {:answer/id #uuid "58ea3fc2-519f-5eea-8c33-6dce5b9c6e3d" :answer/type {:db/ident :answer.type/math} :answer/value "k=8" :db/id #edb/ref 17592186492389} {:answer/id #uuid "8133480e-57da-5ca9-9bce-a1b99fc82856" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186492477} {:answer/id #uuid "a85d27da-01e0-5767-a1e4-b5479a5241b4" :answer/type {:db/ident :answer.type/math} :answer/value "k=5" :db/id #edb/ref 17592186492558} {:answer/id #uuid "da15d75f-b174-5630-b7ee-c26933c1301a" :answer/type {:db/ident :answer.type/math} :answer/value "k=6" :db/id #edb/ref 17592186492646}] :answer-field/correct {:db/id #edb/ref 17592186492477} :answer-field/id #uuid "df2effb2-e366-52f0-a14b-bc202d0cbc2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492799}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7409a043-b196-5341-8318-5b111a0c527e" :question/math-academy-id "q-131725" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}2x-y &=3 \\\\ -4x+(k-5)y &=-1\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}2 & -1 & 3 \\\\ -4 & k-5 & -1\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & -1 & 3 \\\\ -4 & k-5 & -1\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -1 & 3 \\\\ 0 & k-7 & 5\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}2x-y &=3 \\\\ (k-7)y &=5.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=7,$ then the second equation is $0=5,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=7.$"} {:db/id #edb/ref 17592186557414 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "124ff963-b72f-5e65-b019-142dc4093408" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186557411} {:answer/id #uuid "495a45f0-bf5a-5f2b-853f-98a9a40f50da" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186557417} {:answer/id #uuid "be3cc917-c1ca-51f1-b1a3-22d23039ef3b" :answer/type {:db/ident :answer.type/math} :answer/value "k=6" :db/id #edb/ref 17592186557437} {:answer/id #uuid "cf92e2a8-ab48-5340-bcba-2883848e6c01" :answer/type {:db/ident :answer.type/math} :answer/value "k=-6" :db/id #edb/ref 17592186557439} {:answer/id #uuid "d1ed5e36-0fb0-57ce-baac-38fe4ee2f4d2" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186557440}] :answer-field/correct {:db/id #edb/ref 17592186557437} :answer-field/id #uuid "ba282d53-b116-5cfa-b41a-8b04b5bb86c6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557436}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2d5b5966-d0b2-51ba-a7a1-c76ebe8e6658" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x+3y &=-5 \\\\ 2x+ky &=-8\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & 3 & -5 \\\\ 2 & k & -8\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}1 & 3 & -5 \\\\ 2 & k & -8\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 3 & -5 \\\\ 0 & k-6 & 2\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+3y &=-5 \\\\ (k-6)y &=2.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=6,$ then the second equation is $0=2,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=6.$"} {:db/id #edb/ref 17592186557415 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c268bc9-b98d-5227-b731-95e04d9c3527" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186557418} {:answer/id #uuid "ad10948b-c229-52b4-8bd9-550ddae2c192" :answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186557432} {:answer/id #uuid "b131d745-d31e-5a08-8285-4bc65717285c" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186557433} {:answer/id #uuid "b28ffa47-7c40-5583-883d-0cf4b033e17f" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186557434} {:answer/id #uuid "db4baf4b-c62c-5894-9637-6b82ba9cf1c0" :answer/type {:db/ident :answer.type/math} :answer/value "k=4" :db/id #edb/ref 17592186557443}] :answer-field/correct {:db/id #edb/ref 17592186557432} :answer-field/id #uuid "5b3e1241-c1a0-5544-9eae-6f9a638414ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557422}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "364e838c-b667-5333-9687-aeee90961e0c" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-4 \\\\ -2x+ky &=5\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & 2 & -4 \\\\ -2 & k & 5\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}1 & 2 & -4 \\\\ -2 & k & 5\\end{array}\\right] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 2 & -4 \\\\ 0 & k+4 & -3\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+2y &=-4 \\\\ (k+4)y &=-3.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-4,$ then the second equation is $0=-3,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-4.$"} {:db/id #edb/ref 17592186557416 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27dd0a80-4647-5fb3-bf6e-d022bfd8b7be" :answer/type {:db/ident :answer.type/math} :answer/value "k=-6" :db/id #edb/ref 17592186557412} {:answer/id #uuid "7876e850-f579-5b07-8b9c-174d601fcc57" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186557425} {:answer/id #uuid "86b4dd02-2b53-599b-a39f-7cdb9621c84d" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186557426} {:answer/id #uuid "8d82f745-e687-53bf-a943-5f5c160a27c8" :answer/type {:db/ident :answer.type/math} :answer/value "k=6" :db/id #edb/ref 17592186557429} {:answer/id #uuid "90469b9f-cd36-5eb9-a240-2e5bd047b529" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186557430}] :answer-field/correct {:db/id #edb/ref 17592186557412} :answer-field/id #uuid "b669bb3f-c7dc-5f8f-b577-73556f01d6a7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557435}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4508cab0-6e88-59d6-a9c3-7b9fc61a9c9d" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x-2y &=5 \\\\ 3x+ky &=3\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & -2 & 5 \\\\ 3 & k & 3\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}1 & -2 & 5 \\\\ 3 & k & 3\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 5 \\\\ 0 & k+6 & -12\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x-2y &=5 \\\\ (k+6)y &=-12.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-6,$ then the second equation is $0=-12,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-6.$"} {:db/id #edb/ref 17592186557419 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58b63595-07c3-5725-80e1-8d68eb1d1eac" :answer/type {:db/ident :answer.type/math} :answer/value "k=-6" :db/id #edb/ref 17592186557420} {:answer/id #uuid "58f14b39-9200-54eb-8f1e-3dda0f24757d" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186557421} {:answer/id #uuid "60a6d9bd-3eb0-5fbb-8b4c-3b367438cadc" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186557424} {:answer/id #uuid "87e3b172-ceb3-5955-b7d5-9979995635ca" :answer/type {:db/ident :answer.type/math} :answer/value "k=6" :db/id #edb/ref 17592186557427} {:answer/id #uuid "bea126fd-72a5-56d7-8f24-ee9beadcdf63" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186557438}] :answer-field/correct {:db/id #edb/ref 17592186557420} :answer-field/id #uuid "d43ac781-bcce-57c0-9a91-14ff48ccf057" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557441}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "550c7cdf-5810-56e4-b192-4674132b8147" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x-3y &=-4 \\\\ 2x+ky &=-3\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & -3 & -4 \\\\ 2 & k & -3\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}1 & -3 & -4 \\\\ 2 & k & -3\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -3 & -4 \\\\ 0 & k+6 & 5\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x-3y &=-4 \\\\ (k+6)y &=5.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-6,$ then the second equation is $0=5,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-6.$"} {:db/id #edb/ref 17592186557444 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "040900c0-cbe2-5a3b-bf63-00c6502b1713" :answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186557410} {:answer/id #uuid "2ce26fa4-9b16-5f35-94ea-df9965919477" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186557413} {:answer/id #uuid "895f3ba6-7e73-5ee1-88ee-96b78cf55a9c" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186557428} {:answer/id #uuid "9d8a51e6-cd68-5ca8-bf4b-3b66c24eddc6" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186557431} {:answer/id #uuid "d7b4341b-24d7-5601-bee0-2b97f2a49be1" :answer/type {:db/ident :answer.type/math} :answer/value "k=4" :db/id #edb/ref 17592186557442}] :answer-field/correct {:db/id #edb/ref 17592186557410} :answer-field/id #uuid "5bbf5c12-3409-5553-9dd1-d59b687d99b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557423}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f4f00ddd-faa4-5195-9569-dbec2d0e2e6c" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-5 \\\\ -2x+ky &=0\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & 2 & -5 \\\\ -2 & k & 0\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}1 & 2 & -5 \\\\ -2 & k & 0\\end{array}\\right] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 2 & -5 \\\\ 0 & k+4 & -10\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+2y &=-5 \\\\ (k+4)y &=-10.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-4,$ then the second equation is $0=-10,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-4.$"}] :knowledge-point/title "Determining the Value of a Constant for Which a Given Linear System Is Consistent or Inconsistent"} :step/id #uuid "1d1a97f8-c872-5285-b963-d1938948df37" :step/math-academy-id 17216} {:db/id #edb/ref 17592186116209 :step/content {:db/id #edb/ref 17592186115299 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115124 :question/id #uuid "cd56314d-f45a-55be-9762-983fe507a1a0" :question/math-academy-id "e-6173" :question/problem "Given the system\n![](images/0e/0e89fc57b6af2ddf2a71246dbadc7feb8425d1e1e0ab8f988e7e8ad97d22cff7.svg)\nwhich of the following statements are true?\n\n- The system is consistent dependent\n\n- The system has no solution\n\n- The system is consistent independent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n![](images/3e/3e3e8adb0d6e13f7d3b4c3e450b25a789480ac53189ab92385174688e460b2cc.svg)\n\nUsing Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & -3 & 4 \\\\ -4 & 6 & -8\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -3 & 4 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe system is now\n![](images/41/4122fb4ef56aa99161b15bc25001ca728a6cf7dae36d5dac0aac9b03dc411685.svg)\n\nSince any numbers $x$ and $y$ form a solution of the final equation $0x+0y=0,$ we can remove this equation from the system. So, our system now consists of just a single equation:\n\n$$\n2x -3y= 4\n$$\n\nThe basic variable is $x,$ and we have a free variable $y.$ That means we need to find $x$ in terms of $y.$ \n\nTherefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*.\n\nAs a result, only statement I is true."} :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050240}] :knowledge-point/question-generator {:db/id #edb/ref 17592186523192 :question-generator/id #uuid "ef6ae15d-64a0-50e2-9946-0e7f859493c2" :question-generator/script "generate/scratch/17592186115299.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186115752 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4bdc967-dd67-5770-b3ba-57acb8064685" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438106} {:answer/id #uuid "16d63261-26fa-564b-9a02-813ef69df1ff" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438107}] :answer-field/correct {:db/id #edb/ref 17592186438106} :answer-field/id #uuid "48e752bf-5559-502a-9c5a-30d89ae8707e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439082} {:answer-field/choices [{:answer/id #uuid "bd14eb1a-54cf-5d73-9b08-8904377c5fc5" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438108} {:answer/id #uuid "05ef1b8f-126b-56bb-bda0-423f87e55922" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438109}] :answer-field/correct {:db/id #edb/ref 17592186438109} :answer-field/id #uuid "343b74aa-4317-53b2-a41d-750a92184a1b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439083} {:answer-field/choices [{:answer/id #uuid "6e68484e-ebe2-513a-9922-2e5462de62b6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438110} {:answer/id #uuid "7fe5eb6d-0b84-5bb3-929e-e95859bb6bf1" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438111}] :answer-field/correct {:db/id #edb/ref 17592186438110} :answer-field/id #uuid "9d0bc1ed-439f-55dd-983f-394748aacbef" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439084}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "402ab26a-a0df-5fc5-a264-b91a4c6d7d02" :question/math-academy-id "q-32242" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}-x+2y &=6 \\\\ 2x-3y &=13 \\\\ 5x-y &=45\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n- **II.** The system is inconsistent\n- **III.** The system has a unique solution" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}-1 & 2 & 6 \\\\ 2 & -3 & 13 \\\\ 5 & -1 & 45\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-1 & 2 & 6 \\\\ 2 & -3 & 13 \\\\ 5 & -1 & 45\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}-1 & 2 & 6 \\\\ 0 & 1 & 25 \\\\ 5 & -1 & 45\\end{bmatrix} & {R}_{3} & :={R}_{3}+5{R}_{1} \\\\  & ∼\\begin{bmatrix}-1 & 2 & 6 \\\\ 0 & 1 & 25 \\\\ 0 & 9 & 75\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-9){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -2 & -6 \\\\ 0 & 1 & 25 \\\\ 0 & 0 & -150\\end{bmatrix}\\end{aligned}\n$$\n\nThe final row corresponds to the equation $0x+0y=-150,$ and this has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, only statement II is true."} {:db/id #edb/ref 17592186115832 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1eee681-520d-5d0a-802e-8d5b29c52974" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438296} {:answer/id #uuid "b2ace7b5-89a9-5ece-ad6b-0ce43e80a049" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438297}] :answer-field/correct {:db/id #edb/ref 17592186438297} :answer-field/id #uuid "07e35039-20ea-5f8c-9889-aaf209c08f8c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439177} {:answer-field/choices [{:answer/id #uuid "1c3d1f45-fc1a-5e10-a017-8a9199b3e295" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438298} {:answer/id #uuid "039beb6d-4028-5582-9983-702125a74145" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438299}] :answer-field/correct {:db/id #edb/ref 17592186438298} :answer-field/id #uuid "168dcfad-47ff-5ee1-9214-61e870c730b0" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439178} {:answer-field/choices [{:answer/id #uuid "ae82757c-5e4b-593d-84dd-aca1302ca366" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438300} {:answer/id #uuid "8f20a360-4b99-5b18-808c-9bab5fd09713" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438301}] :answer-field/correct {:db/id #edb/ref 17592186438300} :answer-field/id #uuid "8b7ded78-a4d6-5805-8398-330746f91418" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439179}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e80c83a9-9107-528b-af57-73287d15e8e2" :question/math-academy-id "q-42061" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x-3y+z &=0 \\\\ -4x+6y &=2\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n\n- **II.** The system has no solution\n\n- **III.** The system is consistent independent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & -3 & 1 & 0 \\\\ -4 & 6 & 0 & 2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -3 & 1 & 0 \\\\ -4 & 6 & 0 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 1 & 0 \\\\ 0 & -6 & 4 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y,$ and we have one free variable, $z.$ That means we can to find $x$ and $y$ in terms of $z.$ \n\nTherefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*. \n\nAs a result, only statement I is true."} {:db/id #edb/ref 17592186266113 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b502811a-4c5f-5724-8251-868a9480b1c0" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437878} {:answer/id #uuid "186cb15a-6c0f-5792-ab70-d713ad9b8faf" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437879}] :answer-field/correct {:db/id #edb/ref 17592186437878} :answer-field/id #uuid "6923725d-7900-549a-b06a-031593c2ab18" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438968} {:answer-field/choices [{:answer/id #uuid "c85fcf8a-4336-5666-8410-cf5fbbf94767" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437880} {:answer/id #uuid "df5f6c33-1e84-5f01-826a-31cd583e3cc7" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437881}] :answer-field/correct {:db/id #edb/ref 17592186437881} :answer-field/id #uuid "b513b48d-527b-559e-ab81-1586620cce1c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438969} {:answer-field/choices [{:answer/id #uuid "b5dc7bbd-657b-572d-b363-90d7302303fc" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437882} {:answer/id #uuid "50ff0389-893c-5201-a509-7c08e6f042f3" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437883}] :answer-field/correct {:db/id #edb/ref 17592186437882} :answer-field/id #uuid "3cdaf77b-d135-55af-862e-3a96aaf3f51e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438970}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e7e2bc11-b1bf-5938-9267-7923a80ec463" :question/math-academy-id "q-131719" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+4y &=-1 \\\\ 2x+8y &=-2 \\\\ -3x-12y &=3\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is inconsistent\n\n- **II.** The system is consistent dependent\n\n- **III.** The system has a unique solution" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 4 & -1 \\\\ 2 & 8 & -2 \\\\ -3 & -12 & 3\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 4 & -1 \\\\ 2 & 8 & -2 \\\\ -3 & -12 & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 4 & -1 \\\\ 0 & 0 & 0 \\\\ -3 & -12 & 3\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 4 & -1 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x,$ and we have one free variable, $y.$ That means we can find $x$ in terms of $y.$ \n\nTherefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*. \n\nAs a result, only statement II is true."} {:db/id #edb/ref 17592186266114 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ee5d0a5-5b6e-5e3a-bb66-236cc33d9fb6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437902} {:answer/id #uuid "cf7df624-9f74-5695-9b6d-fb27e4a094f5" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437903}] :answer-field/correct {:db/id #edb/ref 17592186437903} :answer-field/id #uuid "db4757d3-9a84-5289-8aea-f7dd1a0eb7d1" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438980} {:answer-field/choices [{:answer/id #uuid "3e0c899b-5aaf-5d75-b95e-4d89e3c89c6c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437904} {:answer/id #uuid "c3bf7724-4756-5a58-8783-ffddc955e5ab" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437905}] :answer-field/correct {:db/id #edb/ref 17592186437904} :answer-field/id #uuid "cecffd33-a545-559e-827c-1ba60cf5059c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438981} {:answer-field/choices [{:answer/id #uuid "c37efec2-77d1-5d31-9f9f-b29a46d81229" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437906} {:answer/id #uuid "606ba1d3-bcb9-5739-b0cd-4e6ddfbaf77d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437907}] :answer-field/correct {:db/id #edb/ref 17592186437906} :answer-field/id #uuid "0f404ad7-7486-5271-8eb0-8c1a59d275b4" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438982}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a61d7528-3ce2-5d0a-af23-11395074997a" :question/math-academy-id "q-131723" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x-y+z &=3 \\\\ -3x+3y-3z &=10\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is inconsistent\n- **II.** The system has a unique solution\n- **III.** The system is consistent dependent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & -1 & 1 & 3 \\\\ -3 & 3 & -3 & 10\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -1 & 1 & 3 \\\\ -3 & 3 & -3 & 10\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 1 & 3 \\\\ 0 & 0 & 0 & 19\\end{bmatrix}\\end{aligned}\n$$\n\nThe final row corresponds to the equation $0x+0y+0z=19,$ and this has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, only statement I is true."} {:db/id #edb/ref 17592186266115 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2950aad8-79f5-5899-8a58-73ef75011ac0" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437908} {:answer/id #uuid "e5392af0-e88c-54d2-80ee-57cd98c53027" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437909}] :answer-field/correct {:db/id #edb/ref 17592186437908} :answer-field/id #uuid "6c277d28-497a-56d5-a22a-96f890c9bcb2" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438983} {:answer-field/choices [{:answer/id #uuid "f6df39b7-5e62-56b8-9a40-278abbcd76e5" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437910} {:answer/id #uuid "bca4b43d-938c-5727-96c4-77957ed09741" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437911}] :answer-field/correct {:db/id #edb/ref 17592186437910} :answer-field/id #uuid "08f93447-1292-5c0a-bb93-f3816eee426f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438984} {:answer-field/choices [{:answer/id #uuid "6f2755c5-437d-57df-9454-eef1a48617ea" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437912} {:answer/id #uuid "c54df87b-4111-522f-b91f-f1d60f8ca696" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437913}] :answer-field/correct {:db/id #edb/ref 17592186437913} :answer-field/id #uuid "89e1b2ad-cfef-519b-be03-81a8b9fde67c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438985}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "09e95d08-30a6-5777-a8a8-348db8bfab42" :question/math-academy-id "q-131724" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x-2y &=2 \\\\ -3x-4y &=3 \\\\ 2x-4y &=-1\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n- **II.** The system has a unique solution\n- **III.** The system is inconsistent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & -2 & 2 \\\\ -3 & -4 & 3 \\\\ 2 & -4 & -1\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -2 & 2 \\\\ -3 & -4 & 3 \\\\ 2 & -4 & -1\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 2 \\\\ 0 & -10 & 9 \\\\ 2 & -4 & -1\\end{bmatrix} & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 2 \\\\ 0 & -10 & 9 \\\\ 0 & 0 & -5\\end{bmatrix}\\end{aligned}\n$$\n\nThe final row corresponds to the equation $0x+0y=-5,$ and this has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, only statement III is true."} {:db/id #edb/ref 17592186344956 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08768d96-6543-5057-b351-a7b1e161594f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438520} {:answer/id #uuid "e55197f9-beea-5d56-b568-4686a6fafa27" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438521}] :answer-field/correct {:db/id #edb/ref 17592186438520} :answer-field/id #uuid "c2c63157-7a5a-5373-8ad8-5fe787c42154" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439289} {:answer-field/choices [{:answer/id #uuid "7e975cf8-6ced-5fcc-a167-0751d7c6d489" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438522} {:answer/id #uuid "6a5469f6-81d5-5ff6-93db-790de506e3a8" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438523}] :answer-field/correct {:db/id #edb/ref 17592186438522} :answer-field/id #uuid "bc9e9ab2-76ef-5705-8ab7-acb52a0677b5" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439290} {:answer-field/choices [{:answer/id #uuid "2583daa7-3471-5757-b97e-74aae9210e3b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438524} {:answer/id #uuid "56894365-ac99-5761-9fdc-76740ad849bd" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438525}] :answer-field/correct {:db/id #edb/ref 17592186438525} :answer-field/id #uuid "fd6825c7-6c00-5310-b8fa-2fe4fbc48f05" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439291}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "edc80b1b-d469-5071-b24d-3c90bb47fce6" :question/math-academy-id "q-74635" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}-2x+4y+3z &=0 \\\\ x+3y &=2\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system has no solution\n- **II.** The system is consistent independent\n- **III.** The system is consistent dependent" :question/worked-solution "To classify the system, we first try to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}-2 & 4 & 3 & 0 \\\\ 1 & 3 & 0 & 2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-2 & 4 & 3 & 0 \\\\ 1 & 3 & 0 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & 4 & 3 & 0 \\\\ 0 & 5 & \\frac{3}{2} & 2\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y,$ and we have one free variable, $z.$ That means that  we can find $x$ and $y$ in terms of $z.$ \n\nTherefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*. \n\nAs a result, only statement III is true."} {:db/id #edb/ref 17592186344957 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d964555-6f83-5191-89db-fd72ffdf14c4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438526} {:answer/id #uuid "ad751ae7-e25b-5406-b9e3-27ea4cbed2f2" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438527}] :answer-field/correct {:db/id #edb/ref 17592186438526} :answer-field/id #uuid "ae1a0230-4005-55bc-8174-e0944a31dd3e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439292} {:answer-field/choices [{:answer/id #uuid "3be3c581-4293-5cdb-b090-f3c480d1c024" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438528} {:answer/id #uuid "89e07487-bb39-5368-bf53-e4b20abb5d72" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438529}] :answer-field/correct {:db/id #edb/ref 17592186438529} :answer-field/id #uuid "d62a54fe-bb91-5a39-8c45-d4f5ab79b9a1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439293} {:answer-field/choices [{:answer/id #uuid "4d848cbc-71b2-5e07-ad3c-93e27231b7c0" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438530} {:answer/id #uuid "82fdc104-5ebd-5054-99d2-64d287c3ea35" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438531}] :answer-field/correct {:db/id #edb/ref 17592186438530} :answer-field/id #uuid "a883d2db-1de6-5620-afb1-bd3d06ab629d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439294}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b0089d19-a4b5-5ec4-beaa-917a294458ba" :question/math-academy-id "q-74637" :question/problem "Consider the following system of equations\n\n$$\n\\left\\{\\begin{aligned}2x+3y &=-1 \\\\ x-2y &=1 \\\\ -x-5y &=2.\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system has no solution\n- **II.** The system is consistent independent\n- **III.** The system is consistent dependent" :question/worked-solution "To classify the system, we first try to find its solution. The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}2 & 3 & -1 \\\\ 1 & -2 & 1 \\\\ -1 & -5 & 2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & 3 & -1 \\\\ 1 & -2 & 1 \\\\ -1 & -5 & 2\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ 2 & 3 & -1 \\\\ -1 & -5 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ 0 & 7 & -3 \\\\ -1 & -5 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ 0 & 7 & -3 \\\\ 0 & -7 & 3\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ 0 & 7 & -3 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nSince any numbers $x$ and $y$ are solutions to the third equation $0x+0y=0$, we can remove this equation from the system. So, the corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-2y &=1 \\\\ 7y &=-3.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get $y=-\\frac{3}{7}.$ Substituting this into the first equation, we get\n\n$$\nx-2(-\\frac{3}{7})=1\\,⟹\\,x=\\frac{1}{7}.\n$$\n\n \nSo, we conclude that the system is consistent independent. \n\nAs a result, only statement II is true."} {:db/id #edb/ref 17592186363108 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4b2e2b5-5692-5b4a-804f-7518ab214d08" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437872} {:answer/id #uuid "3acb46da-0035-5f87-8672-6682f18cf559" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437873}] :answer-field/correct {:db/id #edb/ref 17592186437873} :answer-field/id #uuid "477f40a4-66af-5870-95c1-78ba941c5598" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438965} {:answer-field/choices [{:answer/id #uuid "8c7886ec-2b7c-5184-ba5d-a9cfd3f447ec" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437874} {:answer/id #uuid "1b86766c-211b-5526-8849-1753bc7e2812" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437875}] :answer-field/correct {:db/id #edb/ref 17592186437874} :answer-field/id #uuid "76f4b7f4-de99-5ebc-a3fb-5f5fcbe4139b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438966} {:answer-field/choices [{:answer/id #uuid "2d52184b-23ff-5d3d-be0f-8e48b9e54a9b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437876} {:answer/id #uuid "545708f8-29e7-5393-a590-6497da645a2c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437877}] :answer-field/correct {:db/id #edb/ref 17592186437876} :answer-field/id #uuid "6b08613c-08bd-5a65-b4c6-d5cae5341709" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438967}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e8de2435-5f56-5017-bf79-0b535c719854" :question/math-academy-id "q-131718" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x-3y+z &=2 \\\\ -2x+7y+2z &=-1\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n- **II.** The system has no solution\n- **III.** The system is consistent independent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & -3 & 1 & 2 \\\\ -2 & 7 & 2 & -1\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -3 & 1 & 2 \\\\ -2 & 7 & 2 & -1\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 1 & 2 \\\\ 0 & 1 & 4 & 3\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y,$ and we have one free variable, $z.$ That means we can find $x$ and $y$ in terms of $z.$ \n\nTherefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*. \n\nAs a result, only statement I is true."} {:db/id #edb/ref 17592186364365 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e2d5a83-8718-5bdf-8eb3-db892e2ab5e0" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438532} {:answer/id #uuid "8eaaea36-3739-5e8a-a1ed-efc15f9bc00b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438533}] :answer-field/correct {:db/id #edb/ref 17592186438532} :answer-field/id #uuid "8efd7542-c77b-5d4d-8f60-5468e0925423" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439295} {:answer-field/choices [{:answer/id #uuid "763f0363-fe65-5380-acc8-6965de771643" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438534} {:answer/id #uuid "be014b12-0b58-51d7-a7a3-d343e4554293" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438535}] :answer-field/correct {:db/id #edb/ref 17592186438535} :answer-field/id #uuid "1338d41d-dfae-54bb-ada6-b58b1d8cc303" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439296} {:answer-field/choices [{:answer/id #uuid "f48fb77e-36ef-5915-aaab-7df2660d984a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438536} {:answer/id #uuid "84b40478-f69c-539e-aac5-dd183a05b951" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438537}] :answer-field/correct {:db/id #edb/ref 17592186438536} :answer-field/id #uuid "7051a40c-c2de-5375-95a6-8801b39f67c5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439297}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "35b0295d-1e16-59cc-a201-696e791e0b7d" :question/math-academy-id "q-74643" :question/problem "Consider the following system of equations\n\n$$\n\\left\\{\\begin{aligned}3x+2y &=8 \\\\ x+y &=-2 \\\\ x+\\frac{1}{2}y &=5.\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system has no solution\n- **II.** The system is consistent independent\n- **III.** The system is consistent dependent" :question/worked-solution "To classify the system, we first try to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}3 & 2 & 8 \\\\ 1 & 1 & -2 \\\\ 1 & \\frac{1}{2} & 5\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}3 & 2 & 8 \\\\ 1 & 1 & -2 \\\\ 1 & \\frac{1}{2} & 5\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 1 & -2 \\\\ 3 & 2 & 8 \\\\ 1 & \\frac{1}{2} & 5\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & -2 \\\\ 0 & -1 & 14 \\\\ 1 & \\frac{1}{2} & 5\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & -2 \\\\ 0 & -1 & 14 \\\\ 0 & -\\frac{1}{2} & 7\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-\\frac{1}{2}){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 1 & -2 \\\\ 0 & -1 & 14 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nSince any numbers $x$ and $y$ are solutions to the third equation $0x+0y=0$, we can remove this equation from the system. So, the corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+y &=-2 \\\\ -y &=14.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get $y=-14.$ Substituting this into the first equation, we get\n\n$$\nx+(-14)=-2\\,⟹\\,x=12.\n$$\n\n \nSo,  we conclude that the system is consistent independent.   \n\nAs a result, only statement II is true."} {:db/id #edb/ref 17592186400632 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "042c39af-05d4-5916-90ed-b2140841c0e8" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437884} {:answer/id #uuid "d6aa4878-727c-5081-a2f3-b05cc3779d8d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437885}] :answer-field/correct {:db/id #edb/ref 17592186437884} :answer-field/id #uuid "819cb8bf-d475-5f1d-b674-12ded903565c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438971} {:answer-field/choices [{:answer/id #uuid "2b9fab9a-732e-557e-89af-5c725e033f13" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437886} {:answer/id #uuid "97937812-2266-5255-828e-cf5b3f4f3d5f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437887}] :answer-field/correct {:db/id #edb/ref 17592186437886} :answer-field/id #uuid "0eda7076-17f5-56be-93f9-786bf1b9618f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438972} {:answer-field/choices [{:answer/id #uuid "87384631-af80-5ad6-9a5c-bcc246f5f41d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437888} {:answer/id #uuid "46fcba46-2ddb-5e23-8878-f4e28acdd62f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437889}] :answer-field/correct {:db/id #edb/ref 17592186437889} :answer-field/id #uuid "fa55c229-a084-546e-87ad-83ef1343ba34" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438973}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cd791ebf-f827-5528-ae25-d3ac1f74c5cc" :question/math-academy-id "q-131720" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}2x-6y-2z &=4 \\\\ 3x-9y-3z &=6\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent independent\n- **II.** The system has no solution\n- **III.** The system is consistent dependent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}2 & -6 & -2 & 4 \\\\ 3 & -9 & -3 & 6\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & -6 & -2 & 4 \\\\ 3 & -9 & -3 & 6\\end{bmatrix} & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & -1 & 2 \\\\ 3 & -9 & -3 & 6\\end{bmatrix} & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & -1 & 2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x,$ and we have two free variables, $y$ and $z.$ That means we can find $x$ in terms of $y$ and $z.$ \n\nTherefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*. \n\nAs a result, only statement III is true."} {:db/id #edb/ref 17592186400639 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf929f6a-e145-57f9-9489-b8af5e174866" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437890} {:answer/id #uuid "7f26eb37-aeba-52b6-8b95-caafc52f3431" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437891}] :answer-field/correct {:db/id #edb/ref 17592186437891} :answer-field/id #uuid "2fbdbbd8-b352-5675-a10c-aa7c8880cb1e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438974} {:answer-field/choices [{:answer/id #uuid "70be4c05-8842-5d93-9933-6a01768e4c37" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437892} {:answer/id #uuid "6cec419e-f6b4-51c0-ae9e-deed2e858fc8" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437893}] :answer-field/correct {:db/id #edb/ref 17592186437892} :answer-field/id #uuid "51c120d2-aebb-5e91-8e2f-ef0869ec4dd4" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438975} {:answer-field/choices [{:answer/id #uuid "43f8ee53-d356-528d-9a82-f385997b6c3b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437894} {:answer/id #uuid "262383e4-8fe8-5d1c-ad11-c487ac71bc1f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437895}] :answer-field/correct {:db/id #edb/ref 17592186437894} :answer-field/id #uuid "07a2a3d4-474a-5d37-b1a5-05837e60f654" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438976}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b9b47374-5548-52b6-9b51-17d923fcd37b" :question/math-academy-id "q-131721" :question/problem "Consider the following system of equations\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-1 \\\\ 3x+7y &=1 \\\\ -2x-4y &=2.\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent independent\n- **II.** The system has no solution\n- **III.** The system is consistent dependent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}1 & 2 & -1 \\\\ 3 & 7 & 1 \\\\ -2 & -4 & 2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & -1 \\\\ 3 & 7 & 1 \\\\ -2 & -4 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & -1 \\\\ 0 & 1 & 4 \\\\ -2 & -4 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & -1 \\\\ 0 & 1 & 4 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nSince any numbers $x$ and $y$ are solutions to the third equation $0x+0y=0$, we can remove this equation from the system. So, the corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-1 \\\\ y &=4.\\end{aligned}\\right.\n$$\n\nFrom the second equation we have $y=4$ and substituting this into the first equation yields $x=-9.$ So,  we conclude that the system is consistent independent. \n\nAs a result, only statement I is true."} {:db/id #edb/ref 17592186400646 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b14622e0-0a8b-52f6-8bf8-44a04ea90e2e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437896} {:answer/id #uuid "422e0298-fb2d-5c6d-a4af-8cba072754ea" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437897}] :answer-field/correct {:db/id #edb/ref 17592186437896} :answer-field/id #uuid "2ddef766-7f45-5b44-b48d-737353d4be25" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438977} {:answer-field/choices [{:answer/id #uuid "522be474-9268-5719-9b67-fa3c52635318" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437898} {:answer/id #uuid "37b81bb5-685b-583b-8db4-0245d173fc7d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437899}] :answer-field/correct {:db/id #edb/ref 17592186437899} :answer-field/id #uuid "a0b79b55-bd9c-5274-8736-1fa18bb4e7d7" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438978} {:answer-field/choices [{:answer/id #uuid "63da7652-c50c-579a-9313-44ed8eac188b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437900} {:answer/id #uuid "715c6b27-3b25-5248-a7ad-aceb0fe78ca6" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437901}] :answer-field/correct {:db/id #edb/ref 17592186437900} :answer-field/id #uuid "a893b756-f994-5e2f-ab56-a98d5a543109" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438979}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4890e1ff-ed9a-5558-acd1-bcef01439e04" :question/math-academy-id "q-131722" :question/problem "Consider the following system of equations\n\n$$\n\\left\\{\\begin{aligned}3x-3y &=6 \\\\ -2x+y &=-3 \\\\ 4x-4y &=8.\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n- **II.** The system is consistent independent\n- **III.** The system has no solution" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}3 & -3 & 6 \\\\ -2 & 1 & -3 \\\\ 4 & -4 & 8\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}3 & -3 & 6 \\\\ -2 & 1 & -3 \\\\ 4 & -4 & 8\\end{bmatrix} & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 \\\\ -2 & 1 & -3 \\\\ 4 & -4 & 8\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 \\\\ 0 & -1 & 1 \\\\ 4 & -4 & 8\\end{bmatrix} & {R}_{3} & :={R}_{3}-4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 \\\\ 0 & -1 & 1 \\\\ 0 & 0 & 0\\end{bmatrix} & {R}_{2} & :=-{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nSince any numbers $x$ and $y$ are solutions to the third equation $0x+0y=0$, we can remove this equation from the system. So, the corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-y &=2 \\\\ y &=-1.\\end{aligned}\\right.\n$$\n\nFrom the second equation we have $y=-1$ and substituting this into the first equation yields $x=1.$ So,  we conclude that the system is consistent independent. \n\nAs a result, only statement II is true."} {:db/id #edb/ref 17592186402763 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e6873b1-0d04-54c4-a516-3393f091ca8b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438290} {:answer/id #uuid "cf136178-b995-530b-bb4f-ee1711feaab9" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438291}] :answer-field/correct {:db/id #edb/ref 17592186438290} :answer-field/id #uuid "0f126748-e572-518c-b374-65fb20a3785e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439174} {:answer-field/choices [{:answer/id #uuid "58ee750b-7fc4-5d76-a8fd-41226a7f5ad1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438292} {:answer/id #uuid "23ff6b9a-302b-5629-8e07-bc20b267963c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438293}] :answer-field/correct {:db/id #edb/ref 17592186438292} :answer-field/id #uuid "db15201f-7938-57e0-8d64-2e3e68d9b2f2" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439175} {:answer-field/choices [{:answer/id #uuid "db32e8d6-cfbf-5975-ae7e-91c6447ca478" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438294} {:answer/id #uuid "a53b68f3-fc73-544a-93b7-5353580edb77" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438295}] :answer-field/correct {:db/id #edb/ref 17592186438295} :answer-field/id #uuid "9847730a-03c8-54a9-b1d7-d557810eefed" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439176}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1a930b2a-2578-5145-8e40-06b6cab16ba9" :question/math-academy-id "q-42020" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-1 \\\\ 3x+y &=3 \\\\ -2x+y &=-2.\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n- **II.** The system has a unique solution\n- **III.** The system is inconsistent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 2 & -1 \\\\ 3 & 1 & 3 \\\\ -2 & 1 & -2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:  \n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & -1 \\\\ 3 & 1 & 3 \\\\ -2 & 1 & -2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & -1 \\\\ 0 & -5 & 6 \\\\ -2 & 1 & -2\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & -1 \\\\ 0 & -5 & 6 \\\\ 0 & 5 & -4\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 2 & -1 \\\\ 0 & -5 & 6 \\\\ 0 & 0 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nThe final row corresponds to the equation $0x+0y=2,$ and this has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, only statement III is true."} {:db/id #edb/ref 17592186403787 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ed3c728-986a-5b3f-ab57-0020cb435ca9" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438514} {:answer/id #uuid "72c05b38-661e-55ef-b895-991dd965f68d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438515}] :answer-field/correct {:db/id #edb/ref 17592186438514} :answer-field/id #uuid "d5f63264-b18f-5fb9-8709-61b443e3ce15" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439286} {:answer-field/choices [{:answer/id #uuid "1a9ad7d4-df0d-5491-9263-1cfec2f1523b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438516} {:answer/id #uuid "0cfc1f4e-c211-54e2-8df0-f80bdf080bed" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438517}] :answer-field/correct {:db/id #edb/ref 17592186438516} :answer-field/id #uuid "a0678042-ac90-54b5-926f-6259f946ee55" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439287} {:answer-field/choices [{:answer/id #uuid "c32dbf70-7f15-517a-9383-074f32bf4f01" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438518} {:answer/id #uuid "b90a004e-1b26-5348-ab56-1dd54d767fcc" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438519}] :answer-field/correct {:db/id #edb/ref 17592186438519} :answer-field/id #uuid "98fa2d2a-8e07-54bb-bb31-70f2215b776f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439288}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a8971116-e24d-5808-9b29-a50e168511e5" :question/math-academy-id "q-74634" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}2x-y &=-1 \\\\ 2x-4y &=3 \\\\ x+y &=2\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n\n- **II.** The system has a unique solution\n\n- **III.** The system is inconsistent" :question/worked-solution "To classify the system, we will first try to find its solution. The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}2 & -1 & -1 \\\\ 2 & -4 & 3 \\\\ 1 & 1 & 2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & -1 & -1 \\\\ 2 & -4 & 3 \\\\ 1 & 1 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -1 & -1 \\\\ 0 & -3 & 4 \\\\ 1 & 1 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-\\frac{1}{2}){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -1 & -1 \\\\ 0 & -3 & 4 \\\\ 0 & \\frac{3}{2} & \\frac{5}{2}\\end{bmatrix} & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{2} \\\\  & ∼\\begin{bmatrix}2 & -1 & -1 \\\\ 0 & -3 & 4 \\\\ 0 & 0 & \\frac{9}{2}\\end{bmatrix}\\end{aligned}\n$$\n\nThe final row corresponds to the equation $0x+0y=\\frac{9}{2},$ and it has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, only statement III is true."} {:db/id #edb/ref 17592186492840 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c122c68-ba85-506a-9b5d-b7e8d41f11b9" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186492400} {:answer/id #uuid "90746f9d-5a52-5223-86f2-eebad7cce602" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186492502} {:answer/id #uuid "a00e12c1-efd1-5bb1-8807-973d94c98793" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186492536} {:answer/id #uuid "af7e5af6-3e33-5368-823c-3062f7002694" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186492568} {:answer/id #uuid "fcccf2b5-4696-5f4a-92c9-3b29f694860e" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186492701}] :answer-field/correct {:db/id #edb/ref 17592186492568} :answer-field/id #uuid "83ab4b9b-dc34-5dc7-8a1e-ba7fb0076d92" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492760}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "22d64530-5ce7-515c-aafe-c528e2fc812f" :question/math-academy-id "q-74834" :question/problem "Consider the following system of equations\n\n$$\n\\left\\{\\begin{aligned}x-4y &=-1 \\\\ 2x-7y &=0 \\\\ -4x+15y &=2.\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nI. The system is consistent independent\n\nII. The system has no solution\n\nIII. The system is consistent dependent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}1 & -4 & -1 \\\\ 2 & -7 & 0 \\\\ -4 & 15 & 2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -4 & -1 \\\\ 2 & -7 & 0 \\\\ -4 & 15 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -4 & -1 \\\\ 0 & 1 & 2 \\\\ -4 & 15 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -4 & -1 \\\\ 0 & 1 & 2 \\\\ 0 & -1 & -2\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -4 & -1 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nSince any numbers $x$ and $y$ are solutions to the third equation $0x+0y=0$, we can remove this equation from the system. So, the corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-4y &=-1 \\\\ y &=2.\\end{aligned}\\right.\n$$\n\nFrom the second equation we have $y=2$ and substituting this into the first equation yields $x=7.$ So,  we conclude that the system is consistent independent. \n\nAs a result, only statement I is true."} {:db/id #edb/ref 17592186523101 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46fe9d86-8a7b-5b31-9f33-352086d9b0be" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523118} {:answer/id #uuid "58a2e68c-7ee5-5893-a320-e4d59782d97a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523127}] :answer-field/correct {:db/id #edb/ref 17592186523118} :answer-field/id #uuid "072bdae2-59da-58c7-af80-28f3f2f9aae7" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523094} {:answer-field/choices [{:answer/id #uuid "02336600-7104-5fb9-9b31-cae1a52518dc" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523092} {:answer/id #uuid "547d116e-af59-5ba8-b479-146d79b8a167" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523124}] :answer-field/correct {:db/id #edb/ref 17592186523124} :answer-field/id #uuid "2c4297dc-f995-5396-8e9e-d024c65ce177" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523113} {:answer-field/choices [{:answer/id #uuid "141e0203-23b8-5619-a962-5626778a971c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523103} {:answer/id #uuid "6fb4a988-bcd2-5b80-a37e-65bc083843a0" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523137}] :answer-field/correct {:db/id #edb/ref 17592186523103} :answer-field/id #uuid "60631e67-ec0e-5269-b67b-3fd99562c886" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523131}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1080e551-06cd-5714-8bdc-170d1f4b1992" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+2y &=0 \\\\ x+4y &=4\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n- **II.** The system is consistent independent\n- **III.** The system is inconsistent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 2 & 0 \\\\ 1 & 4 & 4\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & 0 \\\\ 1 & 4 & 4\\end{bmatrix} & {R}_{2}:={R}_{2}+(-1){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 2 & 0 \\\\ 0 & 2 & 4\\end{bmatrix}\\end{aligned}\n$$\n\nThere is a pivot for each variable and no contradictory row. The system has a unique solution, so we conclude that the system is consistent independent.\n\nAs a result, only statement II is true."} {:db/id #edb/ref 17592186523112 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e065480-c3c7-5a97-80dd-f851baccc4cd" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523108} {:answer/id #uuid "63fa15da-a612-551e-bc84-28195f146d91" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523135}] :answer-field/correct {:db/id #edb/ref 17592186523135} :answer-field/id #uuid "95720269-0a64-5442-8ea6-fada3caa3f3d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523154} {:answer-field/choices [{:answer/id #uuid "a075d6f9-6a6b-521c-9a45-cefd6406a87f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523157} {:answer/id #uuid "a3d89df8-a864-501a-978f-d1b4c908a594" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523159}] :answer-field/correct {:db/id #edb/ref 17592186523157} :answer-field/id #uuid "d4f4634b-41cc-5f87-b51b-46f0fed4e546" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523175} {:answer-field/choices [{:answer/id #uuid "c51d359e-c96e-568d-a08a-cc6a5975c003" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523169} {:answer/id #uuid "d80969b7-edb9-54aa-9415-47b2ca6fa4d6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523176}] :answer-field/correct {:db/id #edb/ref 17592186523176} :answer-field/id #uuid "da426b62-5fc6-56a5-92f1-825ae424ef78" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523179}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2c37a8ce-9961-58b3-83eb-74946c8f3663" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+2y-2z &=-4 \\\\ x+3y &=-8 \\\\ x+y-4z &=-3\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent independent\n- **II.** The system is consistent dependent\n- **III.** The system is inconsistent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 2 & -2 & -4 \\\\ 1 & 3 & 0 & -8 \\\\ 1 & 1 & -4 & -3\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & -2 & -4 \\\\ 1 & 3 & 0 & -8 \\\\ 1 & 1 & -4 & -3\\end{bmatrix} & {R}_{2}:={R}_{2}+(-1){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 2 & -2 & -4 \\\\ 0 & 1 & 2 & -4 \\\\ 1 & 1 & -4 & -3\\end{bmatrix} & {R}_{3}:={R}_{3}+(-1){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 2 & -2 & -4 \\\\ 0 & 1 & 2 & -4 \\\\ 0 & -1 & -2 & 1\\end{bmatrix} & {R}_{3}:={R}_{3}+(1){R}_{2} \\\\ & ∼\\begin{bmatrix}1 & 2 & -2 & -4 \\\\ 0 & 1 & 2 & -4 \\\\ 0 & 0 & 0 & -3\\end{bmatrix}\\end{aligned}\n$$\n\nThe final row corresponds to the equation $0x+0y+0z=-3,$ and this has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, only statement III is true."} {:db/id #edb/ref 17592186523119 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92f5b3ce-9f77-555e-a32f-418bc4e4ae3e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523151} {:answer/id #uuid "9552d211-6758-511e-9dd2-695af0b42a16" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523153}] :answer-field/correct {:db/id #edb/ref 17592186523151} :answer-field/id #uuid "178e2ad7-57e9-5728-a5d6-b6e9f1ddc32e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523106} {:answer-field/choices [{:answer/id #uuid "1127203c-eb67-5f24-9963-9f6c74e2e286" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523102} {:answer/id #uuid "7b3c86e8-fe67-5803-979e-32951465e4ec" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523140}] :answer-field/correct {:db/id #edb/ref 17592186523102} :answer-field/id #uuid "8925e95f-c16a-5da9-bc62-4ffcfe2c9609" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523144} {:answer-field/choices [{:answer/id #uuid "b6f9e16b-ee78-5f24-a114-9509d560608d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523162} {:answer/id #uuid "ffb07647-4604-59aa-a0cf-ee179bfdcceb" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523191}] :answer-field/correct {:db/id #edb/ref 17592186523191} :answer-field/id #uuid "d98057d3-cab1-5021-9e07-c30835639d6d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523177}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "482e6d01-f9bf-525e-86f9-c527dca5de7f" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x-3y &=-5 \\\\ -2x+6y &=10\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n- **II.** The system is consistent independent\n- **III.** The system is inconsistent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & -3 & -5 \\\\ -2 & 6 & 10\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -3 & -5 \\\\ -2 & 6 & 10\\end{bmatrix} & {R}_{2}:={R}_{2}+(2){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & -3 & -5 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. Here there is one free variable, $y$. Therefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*.\n\nAs a result, only statement I is true."} {:db/id #edb/ref 17592186523120 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4094b2ed-2795-574f-9bb3-fb2c83ecb51c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523117} {:answer/id #uuid "5f0b8de0-9754-5abb-bbaa-1a2488a781e3" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523129}] :answer-field/correct {:db/id #edb/ref 17592186523117} :answer-field/id #uuid "25d63ecc-0162-52f1-8496-c91465d5168f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523109} {:answer-field/choices [{:answer/id #uuid "4b4a9eea-9608-50ab-9333-020c18e9ce1c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523121} {:answer/id #uuid "f60437e2-7dd6-546f-9828-b80e9f59a8e9" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523188}] :answer-field/correct {:db/id #edb/ref 17592186523121} :answer-field/id #uuid "2ddd758a-c236-567f-9e01-d88d008f82a6" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523114} {:answer-field/choices [{:answer/id #uuid "87d21643-01b3-5b36-833a-4904b0c0d2ef" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523143} {:answer/id #uuid "f4fe98d8-0f7b-5c9d-87ac-6ff411f4142c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523187}] :answer-field/correct {:db/id #edb/ref 17592186523187} :answer-field/id #uuid "8dc94f57-6ef6-5b16-95f9-1ae9415ced68" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523148}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "48bd3d4c-5e94-556e-bb2a-82b8de48db17" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+y+2z &=0 \\\\ -2x-y-7z &=-2 \\\\ 2x+11z &=4\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent independent\n- **II.** The system is inconsistent\n- **III.** The system is consistent dependent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 1 & 2 & 0 \\\\ -2 & -1 & -7 & -2 \\\\ 2 & 0 & 11 & 4\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 1 & 2 & 0 \\\\ -2 & -1 & -7 & -2 \\\\ 2 & 0 & 11 & 4\\end{bmatrix} & {R}_{2}:={R}_{2}+(2){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 1 & 2 & 0 \\\\ 0 & 1 & -3 & -2 \\\\ 2 & 0 & 11 & 4\\end{bmatrix} & {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 1 & 2 & 0 \\\\ 0 & 1 & -3 & -2 \\\\ 0 & -2 & 7 & 4\\end{bmatrix} & {R}_{3}:={R}_{3}+(2){R}_{2} \\\\ & ∼\\begin{bmatrix}1 & 1 & 2 & 0 \\\\ 0 & 1 & -3 & -2 \\\\ 0 & 0 & 1 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThere is a pivot for each variable and no contradictory row. The system has a unique solution, so we conclude that the system is consistent independent.\n\nAs a result, only statement I is true."} {:db/id #edb/ref 17592186523134 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1df67eee-8e7e-5eb7-ba3b-02df7c2b88d3" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523107} {:answer/id #uuid "edeeea6a-d422-56c3-b686-ec4bc3cfaaf5" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523182}] :answer-field/correct {:db/id #edb/ref 17592186523182} :answer-field/id #uuid "7506832c-a1c4-534a-b2e6-d51bb3a21471" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523138} {:answer-field/choices [{:answer/id #uuid "5f63a9e5-2946-52bc-8fdc-8b775647cf8b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523130} {:answer/id #uuid "613155d7-d7de-5a5a-91c3-ac538369b356" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523133}] :answer-field/correct {:db/id #edb/ref 17592186523130} :answer-field/id #uuid "ac0ae869-8ade-5317-96c1-5e22aec5b834" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523160} {:answer-field/choices [{:answer/id #uuid "53e8ac69-39e1-5dfb-b044-65b188ea3777" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523123} {:answer/id #uuid "912e1233-1f11-5ad2-85d3-0096b74affbb" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523150}] :answer-field/correct {:db/id #edb/ref 17592186523123} :answer-field/id #uuid "f44f1c65-b30b-551b-a69a-7f4cd3ad8965" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523184}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "636c60f0-5dc2-592a-9ada-f299790fa243" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+y+z &=5 \\\\ x+2y+2z &=7 \\\\ x+3y+5z &=8\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n- **II.** The system is consistent independent\n- **III.** The system is inconsistent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 1 & 1 & 5 \\\\ 1 & 2 & 2 & 7 \\\\ 1 & 3 & 5 & 8\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 1 & 1 & 5 \\\\ 1 & 2 & 2 & 7 \\\\ 1 & 3 & 5 & 8\\end{bmatrix} & {R}_{2}:={R}_{2}+(-1){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 1 & 1 & 5 \\\\ 0 & 1 & 1 & 2 \\\\ 1 & 3 & 5 & 8\\end{bmatrix} & {R}_{3}:={R}_{3}+(-1){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 1 & 1 & 5 \\\\ 0 & 1 & 1 & 2 \\\\ 0 & 2 & 4 & 3\\end{bmatrix} & {R}_{3}:={R}_{3}+(-2){R}_{2} \\\\ & ∼\\begin{bmatrix}1 & 1 & 1 & 5 \\\\ 0 & 1 & 1 & 2 \\\\ 0 & 0 & 2 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nThere is a pivot for each variable and no contradictory row. The system has a unique solution, so we conclude that the system is consistent independent.\n\nAs a result, only statement II is true."} {:db/id #edb/ref 17592186523146 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51be9dbd-7ee6-56c1-a547-5903d2a1b3e7" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523122} {:answer/id #uuid "f4d7767c-aca7-50f4-90dc-f407ea0d7a3f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523186}] :answer-field/correct {:db/id #edb/ref 17592186523186} :answer-field/id #uuid "996ab691-0a7b-56e9-804a-a2787a923077" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523156} {:answer-field/choices [{:answer/id #uuid "a23b4315-1a65-506a-8c02-738beed7aaa6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523158} {:answer/id #uuid "bb33e391-198c-5529-9d5b-397721de092c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523164}] :answer-field/correct {:db/id #edb/ref 17592186523158} :answer-field/id #uuid "d28f612b-3349-546c-9210-2a56396e5c6f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523173} {:answer-field/choices [{:answer/id #uuid "08e08fdf-8af3-5a6d-a236-96fcf159b0f9" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523095} {:answer/id #uuid "60e8b807-93c5-5642-bfc7-4739a9cf92c7" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523132}] :answer-field/correct {:db/id #edb/ref 17592186523095} :answer-field/id #uuid "f478684b-108b-505b-8b25-f8e1f9defb6d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523185}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8a8ea6cd-37c6-57a9-b6bb-655208ae0dae" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+2y-z &=1 \\\\ 2x+5y &=7 \\\\ -2x-3y+5z &=6\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is inconsistent\n- **II.** The system is consistent independent\n- **III.** The system is consistent dependent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 2 & -1 & 1 \\\\ 2 & 5 & 0 & 7 \\\\ -2 & -3 & 5 & 6\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & -1 & 1 \\\\ 2 & 5 & 0 & 7 \\\\ -2 & -3 & 5 & 6\\end{bmatrix} & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 2 & -1 & 1 \\\\ 0 & 1 & 2 & 5 \\\\ -2 & -3 & 5 & 6\\end{bmatrix} & {R}_{3}:={R}_{3}+(2){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 2 & -1 & 1 \\\\ 0 & 1 & 2 & 5 \\\\ 0 & 1 & 3 & 8\\end{bmatrix} & {R}_{3}:={R}_{3}+(-1){R}_{2} \\\\ & ∼\\begin{bmatrix}1 & 2 & -1 & 1 \\\\ 0 & 1 & 2 & 5 \\\\ 0 & 0 & 1 & 3\\end{bmatrix}\\end{aligned}\n$$\n\nThere is a pivot for each variable and no contradictory row. The system has a unique solution, so we conclude that the system is consistent independent.\n\nAs a result, only statement II is true."} {:db/id #edb/ref 17592186523149 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b71e9efd-4041-5353-b773-e73d4943b58e" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523163} {:answer/id #uuid "c040c9e9-b2b2-5290-9279-e6d8a22bf949" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523167}] :answer-field/correct {:db/id #edb/ref 17592186523167} :answer-field/id #uuid "0c161978-1b18-5f69-ab37-c6a064914aa4" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523097} {:answer-field/choices [{:answer/id #uuid "1070f3b9-edc1-598f-9822-27e3abfa3c58" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523100} {:answer/id #uuid "86e55745-a3ef-551c-a3b4-ce4d34f0d892" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523142}] :answer-field/correct {:db/id #edb/ref 17592186523100} :answer-field/id #uuid "8a48fbc9-4e49-5abc-8cad-5f489b22b567" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523145} {:answer-field/choices [{:answer/id #uuid "0ca331de-6d7a-5bec-913c-999c56c3d275" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523098} {:answer/id #uuid "768483dd-8204-52e1-a40b-ab97ef2fad60" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523139}] :answer-field/correct {:db/id #edb/ref 17592186523139} :answer-field/id #uuid "96339ae7-9e2a-597d-b5f3-d761fa172570" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523155}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8e31a150-29e9-5dea-94ac-a18aad26fe11" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+y &=1 \\\\ 2x+4y &=4\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n- **II.** The system is inconsistent\n- **III.** The system is consistent independent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 1 & 1 \\\\ 2 & 4 & 4\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 1 & 1 \\\\ 2 & 4 & 4\\end{bmatrix} & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 1 & 1 \\\\ 0 & 2 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nThere is a pivot for each variable and no contradictory row. The system has a unique solution, so we conclude that the system is consistent independent.\n\nAs a result, only statement III is true."} {:db/id #edb/ref 17592186523165 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56e13df2-cbbc-5122-a312-3d4718cfd2d5" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523126} {:answer/id #uuid "8ce05a37-3f4d-53ca-9976-cf02a4b3a3bb" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523147}] :answer-field/correct {:db/id #edb/ref 17592186523126} :answer-field/id #uuid "2629fa4f-103c-5153-9f74-91ca5c93439c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523110} {:answer-field/choices [{:answer/id #uuid "554b6c18-e491-5f95-965d-fa5a2bd9d88d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523125} {:answer/id #uuid "f97645eb-31df-5037-9f30-9be5b18f44ce" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523189}] :answer-field/correct {:db/id #edb/ref 17592186523189} :answer-field/id #uuid "5bacc81c-a202-5de7-91a7-ef4e2100ffe9" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523128} {:answer-field/choices [{:answer/id #uuid "1682be06-115f-54ff-a73b-9b589617e8f7" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523105} {:answer/id #uuid "27fd6cae-d564-59e2-aa3f-8a705ed55e02" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523111}] :answer-field/correct {:db/id #edb/ref 17592186523105} :answer-field/id #uuid "b680bc94-e35d-5672-8a29-61a6ce96c60b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523161}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bb7d6994-e998-58f7-aa63-248113b6349d" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+y &=4 \\\\ -x &=-8\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n- **II.** The system is consistent independent\n- **III.** The system is inconsistent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 1 & 4 \\\\ -1 & 0 & -8\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 1 & 4 \\\\ -1 & 0 & -8\\end{bmatrix} & {R}_{2}:={R}_{2}+(1){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 1 & 4 \\\\ 0 & 1 & -4\\end{bmatrix}\\end{aligned}\n$$\n\nThere is a pivot for each variable and no contradictory row. The system has a unique solution, so we conclude that the system is consistent independent.\n\nAs a result, only statement II is true."} {:db/id #edb/ref 17592186523181 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9392a4b7-e0c1-50c1-a200-9aea19b85ad8" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523152} {:answer/id #uuid "c54d1d3c-4700-5389-9521-819eca5efa3a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523170}] :answer-field/correct {:db/id #edb/ref 17592186523170} :answer-field/id #uuid "14a0dd8b-1651-52fe-a379-fa629f0b62ac" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523104} {:answer-field/choices [{:answer/id #uuid "bc35ea2c-b5fa-5a21-af8c-52f26ca8f62f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523166} {:answer/id #uuid "d9a8d720-eb68-5c11-a4f9-701068036d21" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523178}] :answer-field/correct {:db/id #edb/ref 17592186523166} :answer-field/id #uuid "2f23ed57-d37c-5347-b6fc-2f6d63d7a37b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523115} {:answer-field/choices [{:answer/id #uuid "7fa07bf6-b3cb-5d2d-8a9f-a191e0b6e0f5" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523141} {:answer/id #uuid "c5a5ef39-054c-5b8e-b9af-e036a4693bb2" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523171}] :answer-field/correct {:db/id #edb/ref 17592186523141} :answer-field/id #uuid "c354c352-0b95-52ed-8029-4f2c45821f10" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523168}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ec9855f3-8df8-5de8-aa96-4a294a867b64" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x-3y-3z &=5 \\\\ 2x-5y-9z &=10 \\\\ 2x-5y-9z &=10\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n- **II.** The system is inconsistent\n- **III.** The system is consistent independent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & -3 & -3 & 5 \\\\ 2 & -5 & -9 & 10 \\\\ 2 & -5 & -9 & 10\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -3 & -3 & 5 \\\\ 2 & -5 & -9 & 10 \\\\ 2 & -5 & -9 & 10\\end{bmatrix} & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & -3 & -3 & 5 \\\\ 0 & 1 & -3 & 0 \\\\ 2 & -5 & -9 & 10\\end{bmatrix} & {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & -3 & -3 & 5 \\\\ 0 & 1 & -3 & 0 \\\\ 0 & 1 & -3 & 0\\end{bmatrix} & {R}_{3}:={R}_{3}+(-1){R}_{2} \\\\ & ∼\\begin{bmatrix}1 & -3 & -3 & 5 \\\\ 0 & 1 & -3 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. Here there is one free variable, $z$. Therefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*.\n\nAs a result, only statement I is true."} {:db/id #edb/ref 17592186523190 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "652676ed-c325-50b3-9370-c0907c671f47" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523136} {:answer/id #uuid "f3e7efd8-3b15-55b0-a40f-7c34b7c76512" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523183}] :answer-field/correct {:db/id #edb/ref 17592186523183} :answer-field/id #uuid "04645717-bac8-5e0f-80de-5dc8a6e34e04" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523093} {:answer-field/choices [{:answer/id #uuid "0a148d48-fb64-5d16-b8f9-19a6596fe811" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523096} {:answer/id #uuid "3abd678a-230b-520d-a0dd-63dc44fa005b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523116}] :answer-field/correct {:db/id #edb/ref 17592186523096} :answer-field/id #uuid "cfcb9672-726a-595a-b7dd-19a4952a0aab" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523172} {:answer-field/choices [{:answer/id #uuid "0fcc01c5-0bb3-5828-940a-30086cb2d945" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523099} {:answer/id #uuid "d3e45317-561e-5c27-9374-58cfdb78546e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523174}] :answer-field/correct {:db/id #edb/ref 17592186523174} :answer-field/id #uuid "dc3eaf4f-09ba-503b-a672-da707e643826" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523180}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fe67b029-391e-51be-a295-1e535d93c516" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-3 \\\\ -2x-4y &=3\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent independent\n- **II.** The system is consistent dependent\n- **III.** The system is inconsistent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 2 & -3 \\\\ -2 & -4 & 3\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & -3 \\\\ -2 & -4 & 3\\end{bmatrix} & {R}_{2}:={R}_{2}+(2){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 2 & -3 \\\\ 0 & 0 & -3\\end{bmatrix}\\end{aligned}\n$$\n\nThe final row corresponds to the equation $0x+0y=-3,$ and this has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, only statement III is true."}] :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent"} :step/id #uuid "e80cfcd9-1219-52d8-96c7-0ee06cdf52fc" :step/math-academy-id 23072 :step/next {:db/id #edb/ref 17592186116123}}] :activity/title "Gaussian Elimination For NxM Systems of Equations" :activity/type {:db/id #edb/ref 17592186045463} :db/id #edb/ref 17592186115479} {:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186425950} :activity/id #uuid "080f971c-621c-5ccf-b883-b98c49745b79" :activity/scope {:db/id #edb/ref 17592186048445} :activity/steps [{:db/id #edb/ref 17592186425950 :step/content {:db/id #edb/ref 17592186425949 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17602323-8777-51fe-9a70-fac173438e8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=1" :db/id #edb/ref 17592186425938} {:answer/id #uuid "3745dd5b-bc8f-5c5f-bfbb-0a70d0ee8eee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=-3" :db/id #edb/ref 17592186425940} {:answer/id #uuid "8c1862b9-030a-5755-b668-e59ca4c9e456" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=-5" :db/id #edb/ref 17592186425944} {:answer/id #uuid "a1294db0-0da9-5a02-b9e5-791ef34dcf11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=2" :db/id #edb/ref 17592186425946} {:answer/id #uuid "cf6dc1f0-4ead-53bf-8e9f-9b57805aa51d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=5" :db/id #edb/ref 17592186425947}] :answer-field/correct {:db/id #edb/ref 17592186425947} :answer-field/id #uuid "80130b9b-78a0-54cc-bf84-e036ce6c2ff0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186425948}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "db005b4e-86cd-5194-b2fd-10ca4ee59c03" :question/math-academy-id "q-42021" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n\\left\\{\\begin{aligned}x+2y &=3 \\\\ -3x-(k+1)y &=-9\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 2 & -3 \\\\ -3 & -(k+1) & -9\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & 3 \\\\ -3 & -(k+1) & -9\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 3 \\\\ 0 & -k+5 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}1-2y &=3 \\\\ -(k-5)y &=0.\\end{aligned}\\right.\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=5,$ then the second equation is $0=0,$ which is true for any value of $y$, and we can remove this equation from the system. As a result, the system will contain only one equation, $x+2y=3.$ \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=5.$"} :step/id #uuid "2c3254d8-7342-5cba-aa85-c696386c710a" :step/next {:db/id #edb/ref 17592186425952}} {:db/id #edb/ref 17592186425951 :step/content {:db/id #edb/ref 17592186115832 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1eee681-520d-5d0a-802e-8d5b29c52974" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438296} {:answer/id #uuid "b2ace7b5-89a9-5ece-ad6b-0ce43e80a049" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438297}] :answer-field/correct {:db/id #edb/ref 17592186438297} :answer-field/id #uuid "07e35039-20ea-5f8c-9889-aaf209c08f8c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439177} {:answer-field/choices [{:answer/id #uuid "1c3d1f45-fc1a-5e10-a017-8a9199b3e295" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438298} {:answer/id #uuid "039beb6d-4028-5582-9983-702125a74145" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438299}] :answer-field/correct {:db/id #edb/ref 17592186438298} :answer-field/id #uuid "168dcfad-47ff-5ee1-9214-61e870c730b0" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439178} {:answer-field/choices [{:answer/id #uuid "ae82757c-5e4b-593d-84dd-aca1302ca366" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438300} {:answer/id #uuid "8f20a360-4b99-5b18-808c-9bab5fd09713" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438301}] :answer-field/correct {:db/id #edb/ref 17592186438300} :answer-field/id #uuid "8b7ded78-a4d6-5805-8398-330746f91418" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439179}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e80c83a9-9107-528b-af57-73287d15e8e2" :question/math-academy-id "q-42061" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x-3y+z &=0 \\\\ -4x+6y &=2\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n\n- **II.** The system has no solution\n\n- **III.** The system is consistent independent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & -3 & 1 & 0 \\\\ -4 & 6 & 0 & 2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -3 & 1 & 0 \\\\ -4 & 6 & 0 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 1 & 0 \\\\ 0 & -6 & 4 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y,$ and we have one free variable, $z.$ That means we can to find $x$ and $y$ in terms of $z.$ \n\nTherefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*. \n\nAs a result, only statement I is true."} :step/id #uuid "3b9e4957-843e-5d56-8704-c60e6e8f032c"} {:db/id #edb/ref 17592186425952 :step/content {:db/id #edb/ref 17592186115831 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "359439f2-81e1-5ced-8482-b2cf08a71409" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=9" :db/id #edb/ref 17592186425939} {:answer/id #uuid "478b28da-a8a3-51e4-963d-8ac53adc010e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=6" :db/id #edb/ref 17592186425941} {:answer/id #uuid "545c0eb7-c35a-5d44-b8e2-b045ff203715" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=4" :db/id #edb/ref 17592186425942} {:answer/id #uuid "684ddf9d-dd44-5397-b1a8-e6e3ca6a2f95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=-2" :db/id #edb/ref 17592186425943} {:answer/id #uuid "9720657d-4e06-51f7-8e91-da074201b940" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=7" :db/id #edb/ref 17592186425945}] :answer-field/correct {:db/id #edb/ref 17592186425941} :answer-field/id #uuid "e3a07998-8f4c-5e30-bdee-b2acbf389fbd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186113923}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "84cf8820-fa64-5d50-9d9c-d3a9404788a4" :question/math-academy-id "q-42059" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}2x+3y &=1 \\\\ 6x+(k+3)y &=-5\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}2 & 3 & 1 \\\\ 6 & k+3 & -5\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & 3 & 1 \\\\ 6 & k+3 & -5\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 3 & 1 \\\\ 0 & k-6 & -8\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}2x+3y &=1 \\\\ (k-6)y &=-8.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=6,$ then the second equation is $0=-8,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=6.$"} :step/id #uuid "e9dff08f-68e1-5fe8-9586-d7f8edd2598c" :step/next {:db/id #edb/ref 17592186425951}}] :activity/title "Gaussian Elimination For NxM Systems of Equations" :activity/type {:db/id #edb/ref 17592186045464} :db/id #edb/ref 17592186425937} {:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186492937} :activity/id #uuid "6e7bba4e-e339-5059-bc4b-363cbe14a29f" :activity/scope {:db/id #edb/ref 17592186048445} :activity/steps [{:db/id #edb/ref 17592186492937 :step/content {:db/id #edb/ref 17592186115830 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90d6f3fc-4b07-573d-909e-71ad76038bc7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No solution" :db/id #edb/ref 17592186113918} {:answer/id #uuid "66d8f448-8728-5a93-9a65-75b7c8a60923" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-2+3z \\\\ 2+3z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186492423} {:answer/id #uuid "8de04b4a-cc0c-503c-b014-8f1ba934eb81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-2-3z \\\\ 2+3z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186492497} {:answer/id #uuid "977e4b58-8b63-5c8e-b09e-907ea3fc4715" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-2-3z \\\\ 3z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186492510} {:answer/id #uuid "b58da9b9-82d8-54d2-94d7-4d4f9a370f16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2-3z \\\\ 2-3z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186492582}] :answer-field/correct {:db/id #edb/ref 17592186492497} :answer-field/id #uuid "6c202514-58b0-57fd-9d4a-d9d9f27c390e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186113917}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8cd9c6c5-780e-5f01-93cc-d5e9b9533129" :question/math-academy-id "q-42040" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x+3z &=-2 \\\\ x+y &=0.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 0 & 3 & -2 \\\\ 1 & 1 & 0 & 0\\end{bmatrix}.\n$$\n\nUsing the standard method of Gaussian elimination, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 0 & 3 & -2 \\\\ 1 & 1 & 0 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 3 & -2 \\\\ 0 & 1 & -3 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now  \n\n$$\n\\left\\{\\begin{aligned}x+3z &=-2 \\\\ y-3z &=2.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y,$ and we have one free variable, $z.$ That means we need to find $x$ and $y$ in terms of $z.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-2-3z \\\\ y &=2+3z \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the latter can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-2-3z \\\\ 2+3z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} :step/id #uuid "2361ed3b-bfae-5a29-916a-e207bd92ed86" :step/next {:db/id #edb/ref 17592186492989}} {:db/id #edb/ref 17592186492948 :step/content {:db/id #edb/ref 17592186492840 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c122c68-ba85-506a-9b5d-b7e8d41f11b9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186492400} {:answer/id #uuid "90746f9d-5a52-5223-86f2-eebad7cce602" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186492502} {:answer/id #uuid "a00e12c1-efd1-5bb1-8807-973d94c98793" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186492536} {:answer/id #uuid "af7e5af6-3e33-5368-823c-3062f7002694" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186492568} {:answer/id #uuid "fcccf2b5-4696-5f4a-92c9-3b29f694860e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186492701}] :answer-field/correct {:db/id #edb/ref 17592186492568} :answer-field/id #uuid "83ab4b9b-dc34-5dc7-8a1e-ba7fb0076d92" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492760}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "22d64530-5ce7-515c-aafe-c528e2fc812f" :question/math-academy-id "q-74834" :question/problem "Consider the following system of equations\n\n$$\n\\left\\{\\begin{aligned}x-4y &=-1 \\\\ 2x-7y &=0 \\\\ -4x+15y &=2.\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nI. The system is consistent independent\n\nII. The system has no solution\n\nIII. The system is consistent dependent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}1 & -4 & -1 \\\\ 2 & -7 & 0 \\\\ -4 & 15 & 2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -4 & -1 \\\\ 2 & -7 & 0 \\\\ -4 & 15 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -4 & -1 \\\\ 0 & 1 & 2 \\\\ -4 & 15 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -4 & -1 \\\\ 0 & 1 & 2 \\\\ 0 & -1 & -2\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -4 & -1 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nSince any numbers $x$ and $y$ are solutions to the third equation $0x+0y=0$, we can remove this equation from the system. So, the corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-4y &=-1 \\\\ y &=2.\\end{aligned}\\right.\n$$\n\nFrom the second equation we have $y=2$ and substituting this into the first equation yields $x=7.$ So,  we conclude that the system is consistent independent. \n\nAs a result, only statement I is true."} :step/id #uuid "49cc5d2d-b51f-5454-b5d2-2fecc8135eb1" :step/next {:db/id #edb/ref 17592186492950}} {:db/id #edb/ref 17592186492950 :step/content {:db/id #edb/ref 17592186400646 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b14622e0-0a8b-52f6-8bf8-44a04ea90e2e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437896} {:answer/id #uuid "422e0298-fb2d-5c6d-a4af-8cba072754ea" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437897}] :answer-field/correct {:db/id #edb/ref 17592186437896} :answer-field/id #uuid "2ddef766-7f45-5b44-b48d-737353d4be25" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438977} {:answer-field/choices [{:answer/id #uuid "522be474-9268-5719-9b67-fa3c52635318" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437898} {:answer/id #uuid "37b81bb5-685b-583b-8db4-0245d173fc7d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437899}] :answer-field/correct {:db/id #edb/ref 17592186437899} :answer-field/id #uuid "a0b79b55-bd9c-5274-8736-1fa18bb4e7d7" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438978} {:answer-field/choices [{:answer/id #uuid "63da7652-c50c-579a-9313-44ed8eac188b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437900} {:answer/id #uuid "715c6b27-3b25-5248-a7ad-aceb0fe78ca6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437901}] :answer-field/correct {:db/id #edb/ref 17592186437900} :answer-field/id #uuid "a893b756-f994-5e2f-ab56-a98d5a543109" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438979}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4890e1ff-ed9a-5558-acd1-bcef01439e04" :question/math-academy-id "q-131722" :question/problem "Consider the following system of equations\n\n$$\n\\left\\{\\begin{aligned}3x-3y &=6 \\\\ -2x+y &=-3 \\\\ 4x-4y &=8.\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n- **II.** The system is consistent independent\n- **III.** The system has no solution" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}3 & -3 & 6 \\\\ -2 & 1 & -3 \\\\ 4 & -4 & 8\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}3 & -3 & 6 \\\\ -2 & 1 & -3 \\\\ 4 & -4 & 8\\end{bmatrix} & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 \\\\ -2 & 1 & -3 \\\\ 4 & -4 & 8\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 \\\\ 0 & -1 & 1 \\\\ 4 & -4 & 8\\end{bmatrix} & {R}_{3} & :={R}_{3}-4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 \\\\ 0 & -1 & 1 \\\\ 0 & 0 & 0\\end{bmatrix} & {R}_{2} & :=-{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nSince any numbers $x$ and $y$ are solutions to the third equation $0x+0y=0$, we can remove this equation from the system. So, the corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-y &=2 \\\\ y &=-1.\\end{aligned}\\right.\n$$\n\nFrom the second equation we have $y=-1$ and substituting this into the first equation yields $x=1.$ So,  we conclude that the system is consistent independent. \n\nAs a result, only statement II is true."} :step/id #uuid "4f6ca757-aec4-527a-86a3-ce82de0d867c" :step/next {:db/id #edb/ref 17592186492984}} {:db/id #edb/ref 17592186492984 :step/content {:db/id #edb/ref 17592186492874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a7b0d87-9712-510c-adb7-5bde077204da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=10" :db/id #edb/ref 17592186492235} {:answer/id #uuid "58ea3fc2-519f-5eea-8c33-6dce5b9c6e3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=8" :db/id #edb/ref 17592186492389} {:answer/id #uuid "8133480e-57da-5ca9-9bce-a1b99fc82856" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=7" :db/id #edb/ref 17592186492477} {:answer/id #uuid "a85d27da-01e0-5767-a1e4-b5479a5241b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=5" :db/id #edb/ref 17592186492558} {:answer/id #uuid "da15d75f-b174-5630-b7ee-c26933c1301a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=6" :db/id #edb/ref 17592186492646}] :answer-field/correct {:db/id #edb/ref 17592186492477} :answer-field/id #uuid "df2effb2-e366-52f0-a14b-bc202d0cbc2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492799}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7409a043-b196-5341-8318-5b111a0c527e" :question/math-academy-id "q-131725" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}2x-y &=3 \\\\ -4x+(k-5)y &=-1\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}2 & -1 & 3 \\\\ -4 & k-5 & -1\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & -1 & 3 \\\\ -4 & k-5 & -1\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -1 & 3 \\\\ 0 & k-7 & 5\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}2x-y &=3 \\\\ (k-7)y &=5.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=7,$ then the second equation is $0=5,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=7.$"} :step/id #uuid "a93f2400-74e9-5bc9-a239-9a89e32c8532"} {:db/id #edb/ref 17592186492989 :step/content {:db/id #edb/ref 17592186344961 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b9a3770-af37-58af-91e7-3430fd2463b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=5" :db/id #edb/ref 17592186343154} {:answer/id #uuid "71cae964-c567-5585-ab23-7241fb114732" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=3" :db/id #edb/ref 17592186343221} {:answer/id #uuid "a8f3da90-4b17-5b45-af78-2746f79a0b95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=1" :db/id #edb/ref 17592186343724} {:answer/id #uuid "ad97781e-f202-56a0-803a-f17ee1a49ca9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=9" :db/id #edb/ref 17592186343764} {:answer/id #uuid "f0d5b11f-4138-5c57-8bc8-f9f3a404cfaa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=7" :db/id #edb/ref 17592186344356}] :answer-field/correct {:db/id #edb/ref 17592186344356} :answer-field/id #uuid "6517af05-6089-578f-972a-9310f8010c94" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344664}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a0c28bd7-70de-59aa-93c9-933cbaca4593" :question/math-academy-id "q-74646" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x+4y &=2 \\\\ 2x+(k+1)y &=3\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 4 & 2 \\\\ 2 & k+1 & 3\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 4 & 2 \\\\ 2 & k+1 & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 4 & 2 \\\\ 0 & k-7 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+4y &=2 \\\\ (k-7)y &=-1.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=7,$ then the second equation is $0=-1,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=7.$"} :step/id #uuid "b7e356b4-fa42-567c-864c-79ee57dd45e6" :step/next {:db/id #edb/ref 17592186492948}}] :activity/title "Gaussian Elimination For NxM Systems of Equations" :activity/type {:db/id #edb/ref 17592186045464} :db/id #edb/ref 17592186492210}] :db/id #edb/ref 17592186048445 :topic/difficulty 0.796474225322724 :topic/encompasses [{:db/id #edb/ref 17592186428325 :encompassing/rationale "Initial Codex estimate from captured target-band crossing frequency. Selected account differential: 1 rises / 1 eligible passed source activities = 1.000000; nearest selected fraction = 1. Crossing activity numbers [1]; waits [1]. Separate account estimates: differential=1 (1/1). Selection: most observations, then lower weight, then account name; no averaging. Single-activity estimates included. Intervening target updates: False. Crossing frequency is the chosen practical estimate of encompassing coverage; a multi-band rise counts once. This does not interpret color steps as physical repetition units. Method: encompassing-report.md. Evidence: reference/mathacademy/encompassing-analysis-2026-10-11/frequency-fractions/differential-frequency-estimates.json, pair 1733->1049. All account evidence retained in the prepared import's selected-relationships.json." :encompassing/topic {:db/id #edb/ref 17592186048742} :encompassing/weight 1.0} {:db/id #edb/ref 17592186428326 :encompassing/rationale "Initial Codex estimate from captured target-band crossing frequency. Selected account differential: 1 rises / 1 eligible passed source activities = 1.000000; nearest selected fraction = 1. Crossing activity numbers [1]; waits [1]. Separate account estimates: differential=1 (1/1). Selection: most observations, then lower weight, then account name; no averaging. Single-activity estimates included. Intervening target updates: False. Crossing frequency is the chosen practical estimate of encompassing coverage; a multi-band rise counts once. This does not interpret color steps as physical repetition units. Method: encompassing-report.md. Evidence: reference/mathacademy/encompassing-analysis-2026-10-11/frequency-fractions/differential-frequency-estimates.json, pair 1733->1374. All account evidence retained in the prepared import's selected-relationships.json." :encompassing/topic {:db/id #edb/ref 17592186050178} :encompassing/weight 1.0}] :topic/id #uuid "a01c36d3-5643-5685-845e-29c37e89238f" :topic/knowledge-points [{:db/id #edb/ref 17592186115241 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115070 :question/id #uuid "dc6dd9b4-de7f-52d0-8ff9-a7a7f7a9abd7" :question/math-academy-id "e-4711" :question/problem "Consider the system of linear equations\n![](images/40/406033f059dc4438ea55d43d2bd00b3b79bb99365a2e4846c995f4a447acfd82.svg)\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n![](images/be/bed2784d17ee63b805917b492052daa7ef079c1682bbc78468eb10f314a92b1f.svg)\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & ∼\\begin{bmatrix}1 & 5 & 1 & 2 \\\\ 1 & 5 & 2 & 5\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 5 & 1 & 2 \\\\ 0 & 0 & 1 & 3\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 5 & 0 & -1 \\\\ 0 & 0 & 1 & 3\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now\n![](images/91/91175ab97472067cd14ffff740bb3a98718436f1e94de7a4a6d7fdfb1b35b81f.svg)\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $z,$ and we have one free variable, $y.$ That means we need to find $x$ and $z$ in terms of $y.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-1-5y \\\\ y &=y \\\\ z &=3,\\end{aligned}\\right.\n$$\n\nwhere $y$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-1-5y \\\\ y \\\\ 3\\end{bmatrix},\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} :knowledge-point/id #uuid "2d81e3f1-d930-59ee-b439-2a3645aebb6c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048742}] :knowledge-point/question-generator {:db/id #edb/ref 17592186557573 :question-generator/id #uuid "d3ac02e4-4a1b-5e90-b15c-bf75d125145d" :question-generator/script "generate/scratch/17592186115241.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186115751 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a25a6cc1-d88b-5f9f-aae1-cd3eb5867629" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186113473} {:answer/id #uuid "b77df5f9-58e2-575f-bfdb-d097b57fc68f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}z \\\\ 13 - 2z \\\\ z\\end{bmatrix}, z ∈ (- ∞, ∞)" :db/id #edb/ref 17592186113474} {:answer/id #uuid "cee3daed-dbf4-59da-87b6-fc369d2242f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}z \\\\ 13 - 2z \\\\ 6\\end{bmatrix}, z ∈ (- ∞, ∞)" :db/id #edb/ref 17592186113475} {:answer/id #uuid "fc60f84e-4b0e-50e1-8012-0e75aaf5aef9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ 13 - 2z \\\\ z\\end{bmatrix}, z ∈ (- ∞, ∞)" :db/id #edb/ref 17592186113476} {:answer/id #uuid "fe885f5c-7b1a-558b-a68d-cf982e4ed839" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 - z \\\\ 13 - 2z \\\\ z\\end{bmatrix}, z ∈ (- ∞, ∞)" :db/id #edb/ref 17592186113477}] :answer-field/id #uuid "83a4d783-f324-5167-b920-c6eb60540d44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186113472}] :question/id #uuid "d3d66d49-8ab9-5eb7-8d2f-d0c60a5c4d4a" :question/math-academy-id "q-32234" :question/problem "Consider the system of linear equations\n$\\left\\{\\begin{aligned}x + y + 2z &=19 \\\\ 3x + y + 2z &=31\\end{aligned}\\right.$.\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system."} {:db/id #edb/ref 17592186115830 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90d6f3fc-4b07-573d-909e-71ad76038bc7" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186113918} {:answer/id #uuid "66d8f448-8728-5a93-9a65-75b7c8a60923" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2+3z \\\\ 2+3z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186492423} {:answer/id #uuid "8de04b4a-cc0c-503c-b014-8f1ba934eb81" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2-3z \\\\ 2+3z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186492497} {:answer/id #uuid "977e4b58-8b63-5c8e-b09e-907ea3fc4715" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2-3z \\\\ 3z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186492510} {:answer/id #uuid "b58da9b9-82d8-54d2-94d7-4d4f9a370f16" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2-3z \\\\ 2-3z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186492582}] :answer-field/correct {:db/id #edb/ref 17592186492497} :answer-field/id #uuid "6c202514-58b0-57fd-9d4a-d9d9f27c390e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186113917}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8cd9c6c5-780e-5f01-93cc-d5e9b9533129" :question/math-academy-id "q-42040" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x+3z &=-2 \\\\ x+y &=0.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 0 & 3 & -2 \\\\ 1 & 1 & 0 & 0\\end{bmatrix}.\n$$\n\nUsing the standard method of Gaussian elimination, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 0 & 3 & -2 \\\\ 1 & 1 & 0 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 3 & -2 \\\\ 0 & 1 & -3 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now  \n\n$$\n\\left\\{\\begin{aligned}x+3z &=-2 \\\\ y-3z &=2.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y,$ and we have one free variable, $z.$ That means we need to find $x$ and $y$ in terms of $z.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-2-3z \\\\ y &=2+3z \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the latter can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-2-3z \\\\ 2+3z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186266111 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d6a91da-fd38-559c-b128-19dbc7c776d0" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186263546} {:answer/id #uuid "a2aede61-88b5-5a76-9ec8-106c89064823" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3{x}_{3}+1 \\\\ 5{x}_{3}-1 \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186264378} {:answer/id #uuid "c1490779-e503-5831-b724-e9dbf247059f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1-3{x}_{3} \\\\ 1-5{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186264677} {:answer/id #uuid "ed2aed37-0c4b-5f9c-8951-b59ecdbcba2c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3{x}_{3}+1 \\\\ 1-5{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186265070} {:answer/id #uuid "ff176417-b95c-5350-be8a-fc42f217620b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3{x}_{3}-1 \\\\ 5{x}_{3}+1 \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186265244}] :answer-field/correct {:db/id #edb/ref 17592186264378} :answer-field/id #uuid "1999c267-61b7-5858-983a-df3e642d00c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265286}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9e0a0a65-dec2-598f-90c5-c70695152a49" :question/math-academy-id "q-131715" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2}+2{x}_{3} &=2 \\\\ {x}_{1}-3{x}_{3} &=1.\\end{aligned}\\right.\n$$\n\n \nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & -1 & 2 & 2 \\\\ 1 & 0 & -3 & 1\\end{bmatrix}.\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -1 & 2 & 2 \\\\ 1 & 0 & -3 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}-{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 & 2 \\\\ 0 & 1 & -5 & -1\\end{bmatrix} & {R}_{1} & :={R}_{1}+{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & -3 & 1 \\\\ 0 & 1 & -5 & -1\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nThe corresponding system is now  \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-3{x}_{3} &=1 \\\\ {x}_{2}-5{x}_{3} &=-1.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are ${x}_{1}$ and ${x}_{2},$ and we have one free variable, ${x}_{3}.$ That means we need to find ${x}_{1}$ and ${x}_{2}$ in terms of ${x}_{3}.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}{x}_{1} &=3{x}_{3}+1 \\\\ {x}_{2} &=5{x}_{3}-1 \\\\ {x}_{3} &={x}_{3},\\end{aligned}\\right.\n$$\n\nwhere ${x}_{3}$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}=\\begin{bmatrix}3{x}_{3}+1 \\\\ 5{x}_{3}-1 \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186266112 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "150b8c63-cad2-507c-af99-2caf46c53ce7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5{x}_{3}-4 \\\\ 1-2{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186263196} {:answer/id #uuid "65da6370-1e54-53a6-8151-ac1ec3ef9e6f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5{x}_{3}+4 \\\\ 2{x}_{3}+1 \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186263881} {:answer/id #uuid "b5b758ce-eb9d-5dc8-85ff-c1262d0ecfc8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4-5{x}_{3} \\\\ 1-2{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186264574} {:answer/id #uuid "cc2515f8-96f9-59a1-9947-de1efbe1d2e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5{x}_{3}-4 \\\\ 2{x}_{3}-1 \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186264787} {:answer/id #uuid "e6d4c49a-347d-549e-930b-1bad5d6bd1a9" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186265011}] :answer-field/correct {:db/id #edb/ref 17592186263196} :answer-field/id #uuid "3c1fad65-c66c-5abb-b566-f399e550fab9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265356}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "175b6895-5ce4-52f4-b20c-0c4033601e3d" :question/math-academy-id "q-131717" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+3{x}_{2}+{x}_{3} &=-1 \\\\ -2{x}_{1}-5{x}_{2} &=3.\\end{aligned}\\right.\n$$\n\n \nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 3 & 1 & -1 \\\\ -2 & -5 & 0 & 3\\end{bmatrix}.\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 3 & 1 & -1 \\\\ -2 & -5 & 0 & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & 1 & -1 \\\\ 0 & 1 & 2 & 1\\end{bmatrix} & {R}_{1} & :={R}_{1}-3{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & -5 & -4 \\\\ 0 & 1 & 2 & 1\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nThe corresponding system is now  \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-5{x}_{3} &=-4 \\\\ {x}_{2}+2{x}_{3} &=1.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are ${x}_{1}$ and ${x}_{2},$ and we have one free variable, ${x}_{3}.$ That means we need to find ${x}_{1}$ and ${x}_{2}$ in terms of ${x}_{3}.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}{x}_{1} &=5{x}_{3}-4 \\\\ {x}_{2} &=1-2{x}_{3} \\\\ {x}_{3} &={x}_{3},\\end{aligned}\\right.\n$$\n\nwhere ${x}_{3}$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}=\\begin{bmatrix}5{x}_{3}-4 \\\\ 1-2{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186302108 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16c59c60-7047-52d5-87e2-939004f4e5df" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{y}{5}-2 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186300051} {:answer/id #uuid "2f11b4f8-857a-5c20-acad-ec6bae4a9637" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186300189} {:answer/id #uuid "7456e911-694c-5708-b6ea-4413295c3756" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{5}{2}-y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186300539} {:answer/id #uuid "a14ecff4-c49b-5d5d-a419-1378eddbc09c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5-y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186300774} {:answer/id #uuid "aa051ba2-8988-5b2b-a5fb-1ce37c227a56" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{5}{2}+x \\\\ x\\end{bmatrix},\\,x\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186300815}] :answer-field/correct {:db/id #edb/ref 17592186300539} :answer-field/id #uuid "ead03c74-07ea-57d9-9500-45e44f75354b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186301973}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cbdb5209-5ae6-5fea-a525-87f604e2410b" :question/math-academy-id "q-32244" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+2y &=5 \\\\ -10x-10y &=-25 \\\\ 8x+8y &=20.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}2 & 2 & 5 \\\\ -10 & -10 & -25 \\\\ 8 & 8 & 20\\end{bmatrix}.\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & 2 & 5 \\\\ -10 & -10 & -25 \\\\ 8 & 8 & 20\\end{bmatrix} & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & \\frac{5}{2} \\\\ -10 & -10 & -25 \\\\ 8 & 8 & 20\\end{bmatrix} & {R}_{2} & :={R}_{2}+10{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & \\frac{5}{2} \\\\ 0 & 0 & 0 \\\\ 8 & 8 & 20\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-8){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & \\frac{5}{2} \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now  \n\n$$\n\\left\\{\\begin{aligned}x+y &=\\frac{5}{2}\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$ and we have one free variable, $y.$ That means we need to find $x$  in terms of $y.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=\\frac{5}{2}-y \\\\ y &=y,\\end{aligned}\\right.\n$$\n\nwhere $y$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}\\frac{5}{2}-y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186302193 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01e2124c-250c-5553-90ac-ad036367a54c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ -4-2{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186299936} {:answer/id #uuid "1428c74d-a417-5a13-a349-88d508754aa1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ {x}_{2} \\\\ 6+{x}_{2}\\end{bmatrix},\\,{x}_{2}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186300041} {:answer/id #uuid "16ebfa7c-e065-59dc-ac56-9ad2d722ea9b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ -6-2{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186300054} {:answer/id #uuid "46144e61-deb2-5eb2-93d9-1c9a051af1e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 \\\\ -6+{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186300311} {:answer/id #uuid "ceb22f69-ba3e-510b-bac2-26a4175bcd5e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ {x}_{2} \\\\ 6-2{x}_{2}\\end{bmatrix},\\,{x}_{2}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186300994}] :answer-field/correct {:db/id #edb/ref 17592186300054} :answer-field/id #uuid "fcaee800-c02a-5f44-8ba8-6b7bcc06692e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186302033}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a1b8b6ae-30af-5f18-a21d-8dba558350b5" :question/math-academy-id "q-32517" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2{x}_{1}+2{x}_{2}+4{x}_{3} &=-4 \\\\ {x}_{2}+2{x}_{3} &=-6.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}2 & 2 & 4 & -4 \\\\ 0 & 1 & 2 & -6\\end{bmatrix}.\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & 2 & 4 & -4 \\\\ 0 & 1 & 2 & -6\\end{bmatrix} & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & 2 & -2 \\\\ 0 & 1 & 2 & -6\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & 4 \\\\ 0 & 1 & 2 & -6\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now   \n\n$$\n\\left\\{\\begin{aligned}{x}_{1} &=4 \\\\ {x}_{2}+2{x}_{3} &=-6.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are ${x}_{1}$ and ${x}_{2},$ and we have one free variable, ${x}_{3}.$ Since we have that ${x}_{1}=4$,  we only need to find ${x}_{2}$ in terms of ${x}_{3}.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}{x}_{1} &=4 \\\\ {x}_{2} &=-6-2{x}_{3},\\end{aligned}\\right.\n$$\n\nwhere ${x}_{3}$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}=\\begin{bmatrix}4 \\\\ -6-2{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186326924 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50f9b50f-35ed-5015-90a2-abcb73e7da04" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2z \\\\ 4z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186324637} {:answer/id #uuid "5aacb359-a752-57ee-91e8-49aab1c366a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1+2z \\\\ -3z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186324720} {:answer/id #uuid "7904e155-741c-55db-ada4-37737e9bba13" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2+4z \\\\ -3z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186324977} {:answer/id #uuid "9a333b0e-0c9f-57ef-9a78-652e513b4226" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2+4z \\\\ 1-3z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186325282} {:answer/id #uuid "e2e79639-3620-552d-af88-21e978591b1b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1+4z \\\\ 3z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186325961}] :answer-field/correct {:db/id #edb/ref 17592186324720} :answer-field/id #uuid "4ff1beeb-90d1-5401-997f-ae3e61dc47dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186326353}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a7ff9f1a-cb7f-5669-aa2d-6b7ae8d5b3bd" :question/math-academy-id "q-42041" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-4z &=2 \\\\ 4x+y-5z &=4.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}2 & 0 & -4 & 2 \\\\ 4 & 1 & -5 & 4\\end{bmatrix}.\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & 0 & -4 & 2 \\\\ 4 & 1 & -5 & 4\\end{bmatrix} & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & -2 & 1 \\\\ 4 & 1 & -5 & 4\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-4){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & -2 & 1 \\\\ 0 & 1 & 3 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-2z &=1 \\\\ y+3z &=0.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y,$ and we have one free variable, $z.$ That means we need to find $x$ and $y$ in terms of $z.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=1+2z \\\\ y &=-3z \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}1+2z \\\\ -3z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186400625 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d174f1e-8230-59a5-b790-dfbaab4e9521" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186400627} {:answer/id #uuid "244aab6d-90be-578a-8092-166a36c8c9ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4y-3 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186400628} {:answer/id #uuid "83dd970a-9032-5161-9210-85e901723065" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4y+3 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186400629} {:answer/id #uuid "8e7e3b2b-d1a1-5446-8ee4-32636f7b1b2e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4y-3 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186400630} {:answer/id #uuid "0e38c584-fc56-5df5-a079-f3072bdddfc4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3-4y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186400631}] :answer-field/correct {:db/id #edb/ref 17592186400628} :answer-field/id #uuid "0a4567f4-6572-5d9e-8018-4068c6812f07" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186400626}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b0feb9ee-8e97-5292-aff6-05655689f05b" :question/math-academy-id "q-131712" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+8y &=-6 \\\\ -4x-16y &=12 \\\\ 6x+24y &=-18.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}2 & 8 & -6 \\\\ -4 & -16 & 12 \\\\ 6 & 24 & -18\\end{bmatrix}.\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & 8 & -6 \\\\ -4 & -16 & 12 \\\\ 6 & 24 & -18\\end{bmatrix} & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 4 & -3 \\\\ -4 & -16 & 12 \\\\ 6 & 24 & -18\\end{bmatrix} & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 4 & -3 \\\\ 0 & 0 & 0 \\\\ 6 & 24 & -18\\end{bmatrix} & {R}_{3} & :={R}_{3}-6{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 4 & -3 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now  \n\n$$\n\\left\\{\\begin{aligned}x+4y &=-3\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$ and we have one free variable, $y.$ That means we need to find $x$  in terms of $y.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-4y-3 \\\\ y &=y,\\end{aligned}\\right.\n$$\n\nwhere $y$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-4y-3 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186402009 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3ccae38-2121-52d3-adbe-774101358f5f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-8-10{x}_{3} \\\\ 6+6{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402011} {:answer/id #uuid "bd1763ae-5fcd-5d4b-b18a-af3a643749d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8-{x}_{3} \\\\ 3+3{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402012} {:answer/id #uuid "300bc792-b634-5ba3-8561-858fdf7d8d69" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-8-8{x}_{3} \\\\ 6-6{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402013} {:answer/id #uuid "55911223-4948-5180-95bf-96b38f95603a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-8-6{x}_{3} \\\\ 10+6{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402014} {:answer/id #uuid "e5a39045-c764-56cd-a094-6caa0b024ef0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-8-{x}_{3} \\\\ 6+{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402015}] :answer-field/correct {:db/id #edb/ref 17592186402011} :answer-field/id #uuid "94d6271a-24bd-58c0-9553-83b2dc10742e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186402010}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f65d67ed-b94b-50cc-87d4-9aa7130f7547" :question/math-academy-id "q-32247" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2}-2{x}_{3} &=4 \\\\ -2{x}_{1}-3{x}_{2}-2{x}_{3} &=-2.\\end{aligned}\\right.\n$$\n\n \nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 2 & -2 & 4 \\\\ -2 & -3 & -2 & -2\\end{bmatrix}.\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & -2 & 4 \\\\ -2 & -3 & -2 & -2\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & -2 & 4 \\\\ 0 & 1 & -6 & 6\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 10 & -8 \\\\ 0 & 1 & -6 & 6\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nThe corresponding system is now  \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+10{x}_{3} &=-8 \\\\ {x}_{2}-6{x}_{3} &=6.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are ${x}_{1}$ and ${x}_{2},$ and we have one free variable, ${x}_{3}.$ That means we need to find ${x}_{1}$ and ${x}_{2}$ in terms of ${x}_{3}.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}{x}_{1} &=-8-10{x}_{3} \\\\ {x}_{2} &=6+6{x}_{3} \\\\ {x}_{3} &={x}_{3},\\end{aligned}\\right.\n$$\n\nwhere ${x}_{3}$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}=\\begin{bmatrix}-8-10{x}_{3} \\\\ 6+6{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186402756 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e80e6ba-d53c-56a1-8f14-814656e252d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2-z \\\\ 0 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402758} {:answer/id #uuid "240d49db-221f-5c96-a2c7-752016dd8d06" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1-z \\\\ 0 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402759} {:answer/id #uuid "c205ae90-dae6-5981-8476-c566174adf7a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-z \\\\ z-1 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402760} {:answer/id #uuid "a7eb10d8-4da4-5dab-bc8c-4a003f7cebfb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ z-1 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402761} {:answer/id #uuid "c70e171e-d942-5f58-90b7-b6fb6a232836" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ -z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402762}] :answer-field/correct {:db/id #edb/ref 17592186402761} :answer-field/id #uuid "0fa49e40-cb09-52a9-be51-216ec3f67938" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186402757}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "013e11bb-39c0-595b-a244-03847638286f" :question/math-academy-id "q-42019" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x-2y+2z &=2 \\\\ y-z &=-1.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & -2 & 2 & 2 \\\\ 0 & 1 & -1 & -1\\end{bmatrix}.\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -2 & 2 & 2 \\\\ 0 & 1 & -1 & -1\\end{bmatrix} & {R}_{1} & :={R}_{1}+2{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & 0 \\\\ 0 & 1 & -1 & -1\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x &=0 \\\\ y-z &=-1.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y,$ and we have one free variable, $z.$ That means we need to find $x$ and $y$ in terms of $z.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=0 \\\\ y &=z-1 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}0 \\\\ z-1 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186417081 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46e61892-168f-50bc-9184-3087f0aa19c4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2+z \\\\ -z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186417072} {:answer/id #uuid "59f7a4dc-26a3-51be-9f66-57bb37e63b92" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}z \\\\ 2z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186417073} {:answer/id #uuid "5e341f4d-4527-53f0-a549-17a212c07c94" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2+z \\\\ z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186417075} {:answer/id #uuid "86d4df82-dbcb-5384-b53a-8ca94675a39a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2+z \\\\ 0 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186417076} {:answer/id #uuid "b3937866-2599-550e-8d7d-230111af4c2c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2+z \\\\ -2z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186417077}] :answer-field/correct {:db/id #edb/ref 17592186417077} :answer-field/id #uuid "40f01e87-54e2-5dd2-9850-20313302577b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186417080}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "32425960-ceab-536a-8061-1f2469974e99" :question/math-academy-id "q-32220" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x+y+z &=2 \\\\ y+2z &=0.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 1 & 1 & 2 \\\\ 0 & 1 & 2 & 0\\end{bmatrix}.\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 1 & 1 & 2 \\\\ 0 & 1 & 2 & 0\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & -1 & 2 \\\\ 0 & 1 & 2 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-z &=2 \\\\ y+2z &=0.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y,$ and we have one free variable, $z.$ That means we need to find $x$ and $y$ in terms of $z.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=2+z \\\\ y &=-2z \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the latter can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}2+z \\\\ -2z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186557520 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16ccdedd-6990-5c9d-a5e7-669cb20766cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2w+6 \\\\ -3w+1 \\\\ w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557509} {:answer/id #uuid "1eaab110-0c1d-58e2-a36a-75f81be4b961" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3w+1 \\\\ -2w+6 \\\\ w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557511} {:answer/id #uuid "4d74f315-88b3-5c8a-b82e-0c35a568b22d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2w-6 \\\\ -3w+1 \\\\ w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557527} {:answer/id #uuid "a82b5c6a-3d85-527b-907c-39a847d234d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2w+6 \\\\ -3w+1 \\\\ w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557550} {:answer/id #uuid "f0b3d465-f8aa-56d0-aac9-e318dba0f152" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2w+6 \\\\ 1 \\\\ w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557565}] :answer-field/correct {:db/id #edb/ref 17592186557550} :answer-field/id #uuid "3df2332a-884a-5e30-9bff-9af78c8973ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557517}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4149b33c-f03c-5dc8-a587-d4628af75acd" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-2y-4z+2w &=22 \\\\ 2x+y-z+8w &=16 \\\\ 2x+4w &=12.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cccc|c}2 & -2 & -4 & 2 & 22 \\\\ 2 & 1 & -1 & 8 & 16 \\\\ 2 & 0 & 0 & 4 & 12\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cccc|c}2 & -2 & -4 & 2 & 22 \\\\ 2 & 1 & -1 & 8 & 16 \\\\ 2 & 0 & 0 & 4 & 12\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & -2 & 1 & 11 \\\\ 2 & 1 & -1 & 8 & 16 \\\\ 2 & 0 & 0 & 4 & 12\\end{array}\\right] & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & -2 & 1 & 11 \\\\ 0 & 3 & 3 & 6 & -6 \\\\ 2 & 0 & 0 & 4 & 12\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & -2 & 1 & 11 \\\\ 0 & 3 & 3 & 6 & -6 \\\\ 0 & 2 & 4 & 2 & -10\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & -2 & 1 & 11 \\\\ 0 & 1 & 1 & 2 & -2 \\\\ 0 & 2 & 4 & 2 & -10\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & -2 & 1 & 11 \\\\ 0 & 1 & 1 & 2 & -2 \\\\ 0 & 0 & 2 & -2 & -6\\end{array}\\right] & {R}_{3}:=\\frac{1}{2}{R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & -2 & 1 & 11 \\\\ 0 & 1 & 1 & 2 & -2 \\\\ 0 & 0 & 1 & -1 & -3\\end{array}\\right] & {R}_{2}:={R}_{2}+(-1){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & -2 & 1 & 11 \\\\ 0 & 1 & 0 & 3 & 1 \\\\ 0 & 0 & 1 & -1 & -3\\end{array}\\right] & {R}_{1}:={R}_{1}+(2){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & 0 & -1 & 5 \\\\ 0 & 1 & 0 & 3 & 1 \\\\ 0 & 0 & 1 & -1 & -3\\end{array}\\right] & {R}_{1}:={R}_{1}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 0 & 0 & 2 & 6 \\\\ 0 & 1 & 0 & 3 & 1 \\\\ 0 & 0 & 1 & -1 & -3\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+2w &=6 \\\\ y+3w &=1 \\\\ z-w &=-3.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$ and $z$, and we have one free variable, $w$. That means we need to find $x$ and $y$ and $z$ in terms of $w$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-2w+6 \\\\ y &=-3w+1 \\\\ z &=w-3 \\\\ w &=w,\\end{aligned}\\right.\n$$\n\nwhere $w$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z \\\\ w\\end{bmatrix}=\\begin{bmatrix}-2w+6 \\\\ -3w+1 \\\\ w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty ).\n$$"} {:db/id #edb/ref 17592186557532 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bf4863e-3812-5163-be18-589b2a9762b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2w-2 \\\\ -w-5 \\\\ -w+6 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557515} {:answer/id #uuid "4438ccf8-0cf2-5b16-8b50-a324fa882d86" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2w+2 \\\\ -5 \\\\ -w+6 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557522} {:answer/id #uuid "85ef319c-cf8c-51bd-b6a9-a076f2220193" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-w-5 \\\\ -2w+2 \\\\ -w+6 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557534} {:answer/id #uuid "92a3c94b-a6d0-5d86-a0b4-141b13c2745e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2w+2 \\\\ -w-5 \\\\ -w+6 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557539} {:answer/id #uuid "f2471b96-19e0-554d-9c47-9690ecd4e85f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2w+2 \\\\ -w-5 \\\\ -w+6 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557566}] :answer-field/correct {:db/id #edb/ref 17592186557566} :answer-field/id #uuid "10d4ff0b-a1ed-57e4-bbde-79ee3d0faaa8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557505}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6907b90d-7d23-51a7-95a1-476aee7d4fa3" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+2y-4z+2w &=-30 \\\\ x+4y+z+7w &=-12 \\\\ -2x-4y+4z-4w &=40.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cccc|c}2 & 2 & -4 & 2 & -30 \\\\ 1 & 4 & 1 & 7 & -12 \\\\ -2 & -4 & 4 & -4 & 40\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cccc|c}2 & 2 & -4 & 2 & -30 \\\\ 1 & 4 & 1 & 7 & -12 \\\\ -2 & -4 & 4 & -4 & 40\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & -2 & 1 & -15 \\\\ 1 & 4 & 1 & 7 & -12 \\\\ -2 & -4 & 4 & -4 & 40\\end{array}\\right] & {R}_{2}:={R}_{2}+(-1){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & -2 & 1 & -15 \\\\ 0 & 3 & 3 & 6 & 3 \\\\ -2 & -4 & 4 & -4 & 40\\end{array}\\right] & {R}_{3}:={R}_{3}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & -2 & 1 & -15 \\\\ 0 & 3 & 3 & 6 & 3 \\\\ 0 & -2 & 0 & -2 & 10\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & -2 & 1 & -15 \\\\ 0 & 1 & 1 & 2 & 1 \\\\ 0 & -2 & 0 & -2 & 10\\end{array}\\right] & {R}_{3}:={R}_{3}+(2){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & -2 & 1 & -15 \\\\ 0 & 1 & 1 & 2 & 1 \\\\ 0 & 0 & 2 & 2 & 12\\end{array}\\right] & {R}_{3}:=\\frac{1}{2}{R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & -2 & 1 & -15 \\\\ 0 & 1 & 1 & 2 & 1 \\\\ 0 & 0 & 1 & 1 & 6\\end{array}\\right] & {R}_{2}:={R}_{2}+(-1){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & -2 & 1 & -15 \\\\ 0 & 1 & 0 & 1 & -5 \\\\ 0 & 0 & 1 & 1 & 6\\end{array}\\right] & {R}_{1}:={R}_{1}+(2){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 0 & 3 & -3 \\\\ 0 & 1 & 0 & 1 & -5 \\\\ 0 & 0 & 1 & 1 & 6\\end{array}\\right] & {R}_{1}:={R}_{1}+(-1){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 0 & 0 & 2 & 2 \\\\ 0 & 1 & 0 & 1 & -5 \\\\ 0 & 0 & 1 & 1 & 6\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+2w &=2 \\\\ y+w &=-5 \\\\ z+w &=6.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$ and $z$, and we have one free variable, $w$. That means we need to find $x$ and $y$ and $z$ in terms of $w$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-2w+2 \\\\ y &=-w-5 \\\\ z &=-w+6 \\\\ w &=w,\\end{aligned}\\right.\n$$\n\nwhere $w$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z \\\\ w\\end{bmatrix}=\\begin{bmatrix}-2w+2 \\\\ -w-5 \\\\ -w+6 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty ).\n$$"} {:db/id #edb/ref 17592186557536 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00b7798b-205b-596b-8d7c-8a81288dcdd5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}w+4 \\\\ w-6 \\\\ -3w-4 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557503} {:answer/id #uuid "534f2668-be2c-5b89-b0db-c3749e56ab47" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}w+6 \\\\ w+4 \\\\ -3w-4 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557529} {:answer/id #uuid "5b7594ba-6971-5249-a06b-bf279f15485e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}w-6 \\\\ w+4 \\\\ -3w-4 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557530} {:answer/id #uuid "9dd6c7f2-5d3a-53ff-989d-fef9383d10e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-w-6 \\\\ w+4 \\\\ -3w-4 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557544} {:answer/id #uuid "f93d439d-997c-57fe-aa09-19cb6cb34ccf" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}w-6 \\\\ 4 \\\\ -3w-4 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557572}] :answer-field/correct {:db/id #edb/ref 17592186557530} :answer-field/id #uuid "b84f9e3f-cfe4-5d0d-9469-7d9855628d70" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557554}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "867f3ffb-700b-5ac6-8627-7d43c2d36663" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+4y-4z-18w &=20 \\\\ -2x-y+7z+24w &=-20 \\\\ x+y-z-5w &=2.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cccc|c}2 & 4 & -4 & -18 & 20 \\\\ -2 & -1 & 7 & 24 & -20 \\\\ 1 & 1 & -1 & -5 & 2\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cccc|c}2 & 4 & -4 & -18 & 20 \\\\ -2 & -1 & 7 & 24 & -20 \\\\ 1 & 1 & -1 & -5 & 2\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -9 & 10 \\\\ -2 & -1 & 7 & 24 & -20 \\\\ 1 & 1 & -1 & -5 & 2\\end{array}\\right] & {R}_{2}:={R}_{2}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -9 & 10 \\\\ 0 & 3 & 3 & 6 & 0 \\\\ 1 & 1 & -1 & -5 & 2\\end{array}\\right] & {R}_{3}:={R}_{3}+(-1){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -9 & 10 \\\\ 0 & 3 & 3 & 6 & 0 \\\\ 0 & -1 & 1 & 4 & -8\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -9 & 10 \\\\ 0 & 1 & 1 & 2 & 0 \\\\ 0 & -1 & 1 & 4 & -8\\end{array}\\right] & {R}_{3}:={R}_{3}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -9 & 10 \\\\ 0 & 1 & 1 & 2 & 0 \\\\ 0 & 0 & 2 & 6 & -8\\end{array}\\right] & {R}_{3}:=\\frac{1}{2}{R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -9 & 10 \\\\ 0 & 1 & 1 & 2 & 0 \\\\ 0 & 0 & 1 & 3 & -4\\end{array}\\right] & {R}_{2}:={R}_{2}+(-1){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -9 & 10 \\\\ 0 & 1 & 0 & -1 & 4 \\\\ 0 & 0 & 1 & 3 & -4\\end{array}\\right] & {R}_{1}:={R}_{1}+(2){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & 0 & -3 & 2 \\\\ 0 & 1 & 0 & -1 & 4 \\\\ 0 & 0 & 1 & 3 & -4\\end{array}\\right] & {R}_{1}:={R}_{1}+(-2){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 0 & 0 & -1 & -6 \\\\ 0 & 1 & 0 & -1 & 4 \\\\ 0 & 0 & 1 & 3 & -4\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-w &=-6 \\\\ y-w &=4 \\\\ z+3w &=-4.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$ and $z$, and we have one free variable, $w$. That means we need to find $x$ and $y$ and $z$ in terms of $w$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=w-6 \\\\ y &=w+4 \\\\ z &=-3w-4 \\\\ w &=w,\\end{aligned}\\right.\n$$\n\nwhere $w$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z \\\\ w\\end{bmatrix}=\\begin{bmatrix}w-6 \\\\ w+4 \\\\ -3w-4 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty ).\n$$"} {:db/id #edb/ref 17592186557548 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02892691-5a2f-5f61-9177-938daabef939" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3w+6 \\\\ -5 \\\\ -2w+3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557504} {:answer/id #uuid "98857d11-cf0f-559c-a624-f643e00223ea" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3w+6 \\\\ 3w-5 \\\\ -2w+3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557540} {:answer/id #uuid "9db1195b-832e-5816-88cf-39d7489101c4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3w-5 \\\\ 3w+6 \\\\ -2w+3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557543} {:answer/id #uuid "a3ec9f26-beca-531e-a168-718b6fa8b969" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3w-6 \\\\ 3w-5 \\\\ -2w+3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557547} {:answer/id #uuid "b2f20b2d-3574-56db-9346-d8ef62225348" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3w+6 \\\\ 3w-5 \\\\ -2w+3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557553}] :answer-field/correct {:db/id #edb/ref 17592186557540} :answer-field/id #uuid "488246de-7953-56e5-9ac6-5b947af6556f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557523}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a510fef8-28cf-5858-9f70-47fb3be2fcfd" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+4y-4z-26w &=-20 \\\\ 2x+7y+2z-23w &=-17 \\\\ -2x-5y+4z+29w &=25.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cccc|c}2 & 4 & -4 & -26 & -20 \\\\ 2 & 7 & 2 & -23 & -17 \\\\ -2 & -5 & 4 & 29 & 25\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cccc|c}2 & 4 & -4 & -26 & -20 \\\\ 2 & 7 & 2 & -23 & -17 \\\\ -2 & -5 & 4 & 29 & 25\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -13 & -10 \\\\ 2 & 7 & 2 & -23 & -17 \\\\ -2 & -5 & 4 & 29 & 25\\end{array}\\right] & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -13 & -10 \\\\ 0 & 3 & 6 & 3 & 3 \\\\ -2 & -5 & 4 & 29 & 25\\end{array}\\right] & {R}_{3}:={R}_{3}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -13 & -10 \\\\ 0 & 3 & 6 & 3 & 3 \\\\ 0 & -1 & 0 & 3 & 5\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -13 & -10 \\\\ 0 & 1 & 2 & 1 & 1 \\\\ 0 & -1 & 0 & 3 & 5\\end{array}\\right] & {R}_{3}:={R}_{3}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -13 & -10 \\\\ 0 & 1 & 2 & 1 & 1 \\\\ 0 & 0 & 2 & 4 & 6\\end{array}\\right] & {R}_{3}:=\\frac{1}{2}{R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -13 & -10 \\\\ 0 & 1 & 2 & 1 & 1 \\\\ 0 & 0 & 1 & 2 & 3\\end{array}\\right] & {R}_{2}:={R}_{2}+(-2){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -13 & -10 \\\\ 0 & 1 & 0 & -3 & -5 \\\\ 0 & 0 & 1 & 2 & 3\\end{array}\\right] & {R}_{1}:={R}_{1}+(2){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & 0 & -9 & -4 \\\\ 0 & 1 & 0 & -3 & -5 \\\\ 0 & 0 & 1 & 2 & 3\\end{array}\\right] & {R}_{1}:={R}_{1}+(-2){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 0 & 0 & -3 & 6 \\\\ 0 & 1 & 0 & -3 & -5 \\\\ 0 & 0 & 1 & 2 & 3\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-3w &=6 \\\\ y-3w &=-5 \\\\ z+2w &=3.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$ and $z$, and we have one free variable, $w$. That means we need to find $x$ and $y$ and $z$ in terms of $w$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=3w+6 \\\\ y &=3w-5 \\\\ z &=-2w+3 \\\\ w &=w,\\end{aligned}\\right.\n$$\n\nwhere $w$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z \\\\ w\\end{bmatrix}=\\begin{bmatrix}3w+6 \\\\ 3w-5 \\\\ -2w+3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty ).\n$$"} {:db/id #edb/ref 17592186557549 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a654292-8518-53cd-98bb-71caefcd0a07" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}z+6 \\\\ -3z-2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557525} {:answer/id #uuid "b0ca90a2-0b9b-5a30-90dc-f0b37b92a3da" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3z-2 \\\\ z-6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557552} {:answer/id #uuid "bb5b33de-0074-5e2b-829b-eccf84bde51a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}z-6 \\\\ -2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557556} {:answer/id #uuid "df6a7199-5556-5eff-bdc9-33f2fe72ec36" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-z-6 \\\\ -3z-2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557563} {:answer/id #uuid "f7ab48c0-6851-5db5-a9dc-659cf7d80014" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}z-6 \\\\ -3z-2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557570}] :answer-field/correct {:db/id #edb/ref 17592186557570} :answer-field/id #uuid "da4edae9-050e-575b-96c1-28496dd612d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557562}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a6f0b47a-f445-55ab-8fc9-cbed8ed9f994" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+2y+4z &=-16 \\\\ -2x+y+5z &=10 \\\\ -x-2y-5z &=10.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & 2 & 4 & -16 \\\\ -2 & 1 & 5 & 10 \\\\ -1 & -2 & -5 & 10\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}2 & 2 & 4 & -16 \\\\ -2 & 1 & 5 & 10 \\\\ -1 & -2 & -5 & 10\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 2 & -8 \\\\ -2 & 1 & 5 & 10 \\\\ -1 & -2 & -5 & 10\\end{array}\\right] & {R}_{2}:={R}_{2}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 2 & -8 \\\\ 0 & 3 & 9 & -6 \\\\ -1 & -2 & -5 & 10\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 2 & -8 \\\\ 0 & 1 & 3 & -2 \\\\ -1 & -2 & -5 & 10\\end{array}\\right] & {R}_{3}:={R}_{3}+(1){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 2 & -8 \\\\ 0 & 1 & 3 & -2 \\\\ 0 & -1 & -3 & 2\\end{array}\\right] & {R}_{3}:={R}_{3}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 2 & -8 \\\\ 0 & 1 & 3 & -2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] & {R}_{1}:={R}_{1}+(-1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & -1 & -6 \\\\ 0 & 1 & 3 & -2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-z &=-6 \\\\ y+3z &=-2.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=z-6 \\\\ y &=-3z-2 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}z-6 \\\\ -3z-2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"} {:db/id #edb/ref 17592186557551 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fa00707-ca62-5e26-8cd5-1f7625b9c10c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4z+2 \\\\ -3z-5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557528} {:answer/id #uuid "995676a6-2cf6-5858-b738-aba60a8aeefa" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4z+2 \\\\ -5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557541} {:answer/id #uuid "9cedd0e2-f0fe-57de-8bf9-74b0d6aeefe1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4z-2 \\\\ -3z-5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557542} {:answer/id #uuid "d32535a8-e248-5a18-9233-6d41ff79b84a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3z-5 \\\\ -4z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557560} {:answer/id #uuid "d7b08673-f5a7-5468-88d2-82fface9dd69" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4z+2 \\\\ -3z-5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557561}] :answer-field/correct {:db/id #edb/ref 17592186557528} :answer-field/id #uuid "32299d3b-6034-5ff8-afd5-342220d2ad49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557513}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "adb0568a-cc33-548d-9e70-7aec30b5b6bd" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+2y+14z &=-6 \\\\ x+4y+16z &=-18 \\\\ -2x-4y-20z &=16.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & 2 & 14 & -6 \\\\ 1 & 4 & 16 & -18 \\\\ -2 & -4 & -20 & 16\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}2 & 2 & 14 & -6 \\\\ 1 & 4 & 16 & -18 \\\\ -2 & -4 & -20 & 16\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 7 & -3 \\\\ 1 & 4 & 16 & -18 \\\\ -2 & -4 & -20 & 16\\end{array}\\right] & {R}_{2}:={R}_{2}+(-1){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 7 & -3 \\\\ 0 & 3 & 9 & -15 \\\\ -2 & -4 & -20 & 16\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 7 & -3 \\\\ 0 & 1 & 3 & -5 \\\\ -2 & -4 & -20 & 16\\end{array}\\right] & {R}_{3}:={R}_{3}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 7 & -3 \\\\ 0 & 1 & 3 & -5 \\\\ 0 & -2 & -6 & 10\\end{array}\\right] & {R}_{3}:={R}_{3}+(2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 7 & -3 \\\\ 0 & 1 & 3 & -5 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] & {R}_{1}:={R}_{1}+(-1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 4 & 2 \\\\ 0 & 1 & 3 & -5 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+4z &=2 \\\\ y+3z &=-5.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-4z+2 \\\\ y &=-3z-5 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-4z+2 \\\\ -3z-5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"} {:db/id #edb/ref 17592186557557 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11f75aad-535e-5349-ac30-0817cbc6131e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2w-2 \\\\ -w-6 \\\\ 3w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557507} {:answer/id #uuid "67b5aba3-9287-5655-a310-8b430569b715" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2w-2 \\\\ -w-6 \\\\ 3w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557531} {:answer/id #uuid "85f5e298-78dd-5de5-b5f3-f4c5ec30a051" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2w-2 \\\\ -6 \\\\ 3w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557535} {:answer/id #uuid "a0cb117c-63e0-5b48-8734-1e48dee2c005" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-w-6 \\\\ 2w-2 \\\\ 3w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557545} {:answer/id #uuid "f8bddcd4-51ea-5bca-9efc-633ffe6faec6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2w+2 \\\\ -w-6 \\\\ 3w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557571}] :answer-field/correct {:db/id #edb/ref 17592186557531} :answer-field/id #uuid "43ca07dd-c5bb-5c16-9ac1-3f7c98019646" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557521}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c7e5dc6c-e550-5c9b-8c75-fe188ef23a8b" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+2y+2z-8w &=-22 \\\\ -x+2y+2z-2w &=-16 \\\\ x+2y+4z-12w &=-26.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cccc|c}2 & 2 & 2 & -8 & -22 \\\\ -1 & 2 & 2 & -2 & -16 \\\\ 1 & 2 & 4 & -12 & -26\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cccc|c}2 & 2 & 2 & -8 & -22 \\\\ -1 & 2 & 2 & -2 & -16 \\\\ 1 & 2 & 4 & -12 & -26\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ -1 & 2 & 2 & -2 & -16 \\\\ 1 & 2 & 4 & -12 & -26\\end{array}\\right] & {R}_{2}:={R}_{2}+(1){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ 0 & 3 & 3 & -6 & -27 \\\\ 1 & 2 & 4 & -12 & -26\\end{array}\\right] & {R}_{3}:={R}_{3}+(-1){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ 0 & 3 & 3 & -6 & -27 \\\\ 0 & 1 & 3 & -8 & -15\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ 0 & 1 & 1 & -2 & -9 \\\\ 0 & 1 & 3 & -8 & -15\\end{array}\\right] & {R}_{3}:={R}_{3}+(-1){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ 0 & 1 & 1 & -2 & -9 \\\\ 0 & 0 & 2 & -6 & -6\\end{array}\\right] & {R}_{3}:=\\frac{1}{2}{R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ 0 & 1 & 1 & -2 & -9 \\\\ 0 & 0 & 1 & -3 & -3\\end{array}\\right] & {R}_{2}:={R}_{2}+(-1){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ 0 & 1 & 0 & 1 & -6 \\\\ 0 & 0 & 1 & -3 & -3\\end{array}\\right] & {R}_{1}:={R}_{1}+(-1){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 0 & -1 & -8 \\\\ 0 & 1 & 0 & 1 & -6 \\\\ 0 & 0 & 1 & -3 & -3\\end{array}\\right] & {R}_{1}:={R}_{1}+(-1){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 0 & 0 & -2 & -2 \\\\ 0 & 1 & 0 & 1 & -6 \\\\ 0 & 0 & 1 & -3 & -3\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-2w &=-2 \\\\ y+w &=-6 \\\\ z-3w &=-3.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$ and $z$, and we have one free variable, $w$. That means we need to find $x$ and $y$ and $z$ in terms of $w$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=2w-2 \\\\ y &=-w-6 \\\\ z &=3w-3 \\\\ w &=w,\\end{aligned}\\right.\n$$\n\nwhere $w$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z \\\\ w\\end{bmatrix}=\\begin{bmatrix}2w-2 \\\\ -w-6 \\\\ 3w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty ).\n$$"} {:db/id #edb/ref 17592186557558 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "111ff2e8-5074-588e-a4a9-3d3cfb18d3bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4z-4 \\\\ 2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557506} {:answer/id #uuid "3076215c-304a-5d01-86d1-3ff9741ff4dd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4z-4 \\\\ -4z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557512} {:answer/id #uuid "3fb3301d-33c0-5158-a03e-64250a27b511" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4z+2 \\\\ -4z-4 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557518} {:answer/id #uuid "3febba3a-efe2-57ba-8af5-de2985e82134" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4z+4 \\\\ -4z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557519} {:answer/id #uuid "48c2af1b-9196-5808-96db-88b7f04e41cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4z-4 \\\\ -4z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557524}] :answer-field/correct {:db/id #edb/ref 17592186557524} :answer-field/id #uuid "149fd90e-5691-5c54-8ab7-8d87034698b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557508}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d05ea200-995d-55b2-a1b7-0a4ae934dd54" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-4y-8z &=-16 \\\\ 2x-y+4z &=-10 \\\\ 2x-5y-12z &=-18.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & -4 & -8 & -16 \\\\ 2 & -1 & 4 & -10 \\\\ 2 & -5 & -12 & -18\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}2 & -4 & -8 & -16 \\\\ 2 & -1 & 4 & -10 \\\\ 2 & -5 & -12 & -18\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -4 & -8 \\\\ 2 & -1 & 4 & -10 \\\\ 2 & -5 & -12 & -18\\end{array}\\right] & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -4 & -8 \\\\ 0 & 3 & 12 & 6 \\\\ 2 & -5 & -12 & -18\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -4 & -8 \\\\ 0 & 1 & 4 & 2 \\\\ 2 & -5 & -12 & -18\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -4 & -8 \\\\ 0 & 1 & 4 & 2 \\\\ 0 & -1 & -4 & -2\\end{array}\\right] & {R}_{3}:={R}_{3}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -4 & -8 \\\\ 0 & 1 & 4 & 2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] & {R}_{1}:={R}_{1}+(2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 4 & -4 \\\\ 0 & 1 & 4 & 2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+4z &=-4 \\\\ y+4z &=2.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-4z-4 \\\\ y &=-4z+2 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-4z-4 \\\\ -4z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"} {:db/id #edb/ref 17592186557567 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c0da7ae-0be2-5a15-bb78-e9aa6a4e73bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2z-3 \\\\ -3z+5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557526} {:answer/id #uuid "7271e45f-8553-5ce0-acb1-6c300273e818" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2z+3 \\\\ -3z+5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557533} {:answer/id #uuid "8ccb0a70-9168-5376-aab3-e2bf68061d3a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2z-3 \\\\ -3z+5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557538} {:answer/id #uuid "b8bdf101-8a17-59f6-92cc-0d92a551d21e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2z-3 \\\\ 5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557555} {:answer/id #uuid "f5a634f4-002a-58cb-96bc-17a4efd0a7ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3z+5 \\\\ -2z-3 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557568}] :answer-field/correct {:db/id #edb/ref 17592186557538} :answer-field/id #uuid "a2993581-de40-5699-b32f-c45f7304d89a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557546}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f34874f6-66c0-58d0-a503-ac8424ffc0ef" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-2y-2z &=-16 \\\\ 2x+y+7z &=-1 \\\\ 2x+4z &=-6.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & -2 & -2 & -16 \\\\ 2 & 1 & 7 & -1 \\\\ 2 & 0 & 4 & -6\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}2 & -2 & -2 & -16 \\\\ 2 & 1 & 7 & -1 \\\\ 2 & 0 & 4 & -6\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 2 & 1 & 7 & -1 \\\\ 2 & 0 & 4 & -6\\end{array}\\right] & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 0 & 3 & 9 & 15 \\\\ 2 & 0 & 4 & -6\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 0 & 1 & 3 & 5 \\\\ 2 & 0 & 4 & -6\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 0 & 1 & 3 & 5 \\\\ 0 & 2 & 6 & 10\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 0 & 1 & 3 & 5 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] & {R}_{1}:={R}_{1}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -3 \\\\ 0 & 1 & 3 & 5 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+2z &=-3 \\\\ y+3z &=5.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-2z-3 \\\\ y &=-3z+5 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-2z-3 \\\\ -3z+5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"} {:db/id #edb/ref 17592186557569 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ce1dc0c-75ef-52c2-bd4b-bf75d5f2e8dd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4z+6 \\\\ 3z+4 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557510} {:answer/id #uuid "3bf6b08b-6231-5a56-a8e3-c43b285af62d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3z-4 \\\\ 4z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557516} {:answer/id #uuid "86cd4be6-2d2c-56d7-b46a-2c157bb80402" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3z+4 \\\\ 4z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557537} {:answer/id #uuid "d2124629-8825-54e6-8828-d3638950e6b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3z+4 \\\\ 6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557559} {:answer/id #uuid "ea30a4a7-e209-5d31-bfc9-6aaf3dccb98b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3z+4 \\\\ 4z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557564}] :answer-field/correct {:db/id #edb/ref 17592186557564} :answer-field/id #uuid "33817d11-0d35-5223-ad95-222c9e4cd34e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557514}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f6291f54-74fa-5018-8da1-0d69f2fed16a" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-2y+2z &=-4 \\\\ -2x+5y-14z &=22 \\\\ 2x-4y+10z &=-16.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & -2 & 2 & -4 \\\\ -2 & 5 & -14 & 22 \\\\ 2 & -4 & 10 & -16\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}2 & -2 & 2 & -4 \\\\ -2 & 5 & -14 & 22 \\\\ 2 & -4 & 10 & -16\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ -2 & 5 & -14 & 22 \\\\ 2 & -4 & 10 & -16\\end{array}\\right] & {R}_{2}:={R}_{2}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ 0 & 3 & -12 & 18 \\\\ 2 & -4 & 10 & -16\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ 0 & 1 & -4 & 6 \\\\ 2 & -4 & 10 & -16\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ 0 & 1 & -4 & 6 \\\\ 0 & -2 & 8 & -12\\end{array}\\right] & {R}_{3}:={R}_{3}+(2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ 0 & 1 & -4 & 6 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] & {R}_{1}:={R}_{1}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & -3 & 4 \\\\ 0 & 1 & -4 & 6 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-3z &=4 \\\\ y-4z &=6.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=3z+4 \\\\ y &=4z+6 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}3z+4 \\\\ 4z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"}] :knowledge-point/title "Solving a Consistent System of Equations Using Gauss-Jordan Elimination"} {:db/id #edb/ref 17592186115242 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115071 :question/id #uuid "f2c7cfd3-da43-5208-bd0e-21692357fabe" :question/math-academy-id "e-4712" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}2x-2y &=1, \\\\ 4x+ky &=-3\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n![](images/6f/6fa4508463b059ce8ef9a5cfa720de9463e41ecdbfb16f4460870bb6fce444bc.svg)\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & -2 & 1 \\\\ 4 & k & -3\\end{bmatrix} & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -2 & 1 \\\\ 0 & k+4 & -5\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n![](images/21/215ff061dc7584055bf607f48d0048cb6bde4dcb1ed028fbf4c3a4bd47d89c25.svg)\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-4,$ then the second equation is $0=-5,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-4.$"} :knowledge-point/id #uuid "22733f71-de4a-5058-a41c-039e66e333c5" :knowledge-point/question-generator {:db/id #edb/ref 17592186557445 :question-generator/id #uuid "8ae9e325-9ab6-53e2-9f58-322c0a6527aa" :question-generator/script "generate/scratch/17592186115242.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186115753 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3248af5c-24d6-51a0-a62b-8d5ab0e0e782" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186300213} {:answer/id #uuid "5ed5f31b-5757-56ca-ac90-622019b8d7e7" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{4}{3}" :db/id #edb/ref 17592186300447} {:answer/id #uuid "6b3ca3f5-57b3-5b3c-b6b4-0772e9be135c" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{3}{4}" :db/id #edb/ref 17592186300503} {:answer/id #uuid "6f2681ec-b8ae-51dc-9094-2e2bcadf6d8a" :answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186300522} {:answer/id #uuid "fad186f0-c1c8-5bcc-8cc3-09b1f4f1ed49" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{4}{3}" :db/id #edb/ref 17592186301203}] :answer-field/correct {:db/id #edb/ref 17592186300447} :answer-field/id #uuid "9bc72922-bebc-50a1-a8ff-483d8fbfcfc6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186301729}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2a9a3feb-6c16-50e8-885d-ee5cd242ab95" :question/math-academy-id "q-32246" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n\\left\\{\\begin{aligned}3x+4y &=12 \\\\ x+ky &=4\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}3 & 4 & 12 \\\\ 1 & k & 4\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}3 & 4 & 12 \\\\ 1 & k & 4\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & k & 4 \\\\ 3 & 4 & 12\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & k & 4 \\\\ 0 & 4-3k & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+ky &=4 \\\\ (4-3k)y &=0.\\end{aligned}\\right.\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=\\frac{4}{3},$ then the second equation is $0=0,$ which is true for any value of $y$, and we can remove this equation from the system. As a result, the system will contain only one equation, $x+ky=4.$ \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=\\frac{4}{3}.$"} {:db/id #edb/ref 17592186115831 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "359439f2-81e1-5ced-8482-b2cf08a71409" :answer/type {:db/ident :answer.type/math} :answer/value "k=9" :db/id #edb/ref 17592186425939} {:answer/id #uuid "478b28da-a8a3-51e4-963d-8ac53adc010e" :answer/type {:db/ident :answer.type/math} :answer/value "k=6" :db/id #edb/ref 17592186425941} {:answer/id #uuid "545c0eb7-c35a-5d44-b8e2-b045ff203715" :answer/type {:db/ident :answer.type/math} :answer/value "k=4" :db/id #edb/ref 17592186425942} {:answer/id #uuid "684ddf9d-dd44-5397-b1a8-e6e3ca6a2f95" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186425943} {:answer/id #uuid "9720657d-4e06-51f7-8e91-da074201b940" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186425945}] :answer-field/correct {:db/id #edb/ref 17592186425941} :answer-field/id #uuid "e3a07998-8f4c-5e30-bdee-b2acbf389fbd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186113923}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "84cf8820-fa64-5d50-9d9c-d3a9404788a4" :question/math-academy-id "q-42059" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}2x+3y &=1 \\\\ 6x+(k+3)y &=-5\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}2 & 3 & 1 \\\\ 6 & k+3 & -5\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & 3 & 1 \\\\ 6 & k+3 & -5\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 3 & 1 \\\\ 0 & k-6 & -8\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}2x+3y &=1 \\\\ (k-6)y &=-8.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=6,$ then the second equation is $0=-8,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=6.$"} {:db/id #edb/ref 17592186266116 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "188d8234-d927-5fa4-9649-52a3600a14ed" :answer/type {:db/ident :answer.type/math} :answer/value "k=-13" :db/id #edb/ref 17592186263232} {:answer/id #uuid "59917889-7526-5cea-90f8-6ed9b5d31888" :answer/type {:db/ident :answer.type/math} :answer/value "k=8" :db/id #edb/ref 17592186263771} {:answer/id #uuid "84ec393a-992f-55d2-9044-1e362627ed1c" :answer/type {:db/ident :answer.type/math} :answer/value "k=-12" :db/id #edb/ref 17592186264142} {:answer/id #uuid "9556b060-0b9f-5486-b05c-79753916db1d" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186264279} {:answer/id #uuid "c483c739-bc7d-5f47-8dbf-09da12b3a0b2" :answer/type {:db/ident :answer.type/math} :answer/value "k=-14" :db/id #edb/ref 17592186264722}] :answer-field/correct {:db/id #edb/ref 17592186263232} :answer-field/id #uuid "4c23e17f-c925-52e8-86bd-0f648e063de0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265388}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7d3ed27b-d876-58c6-8a51-55f4b36743e6" :question/math-academy-id "q-131726" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}-3x+2y &=1 \\\\ 6x+(k+9)y &=5\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}-3 & 2 & 1 \\\\ 6 & k+9 & 5\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-3 & 2 & 1 \\\\ 6 & k+9 & 5\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}-3 & 2 & 1 \\\\ 0 & k+13 & 7\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}-3x+2y &=1 \\\\ (k+13)y &=7.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-13,$ then the second equation is $0=7,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-13.$"} {:db/id #edb/ref 17592186266117 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a4e76fd-e1c6-5cbe-93b0-49387b6d03cd" :answer/type {:db/ident :answer.type/math} :answer/value "k=-13" :db/id #edb/ref 17592186263361} {:answer/id #uuid "c2f1c78c-35e7-5dc3-a4ea-917746946f9c" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186264698} {:answer/id #uuid "cad2e0cc-59d8-5847-8c17-7f7022f7428b" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186264775} {:answer/id #uuid "ddd34857-39b4-5a84-88c6-46284b56c129" :answer/type {:db/ident :answer.type/math} :answer/value "k=-12" :db/id #edb/ref 17592186264929} {:answer/id #uuid "f74d0318-2803-55b8-bb5b-49c8150dea17" :answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186265163}] :answer-field/correct {:db/id #edb/ref 17592186265163} :answer-field/id #uuid "80ce296a-26b4-5d5b-bab5-71101c246341" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265471}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0e7e4e8f-70c3-5d1c-92c5-d1d6f120ba7c" :question/math-academy-id "q-131727" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x-3y &=-1 \\\\ 4x+3ky &=3\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & -3 & -1 \\\\ 4 & 3k & 3\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -3 & -1 \\\\ 4 & 3k & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}-4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & -1 \\\\ 0 & 3k+12 & 7\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x-3y &=-1 \\\\ (3k+12)y &=7.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-4,$ then the second equation is $0=7,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-4.$"} {:db/id #edb/ref 17592186266118 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e3a6e2e-1b7a-5ad1-b366-2deecae63253" :answer/type {:db/ident :answer.type/math} :answer/value "k=1" :db/id #edb/ref 17592186264216} {:answer/id #uuid "96b3aa58-5c89-5f3c-896e-547bdfeef87c" :answer/type {:db/ident :answer.type/math} :answer/value "k=-1" :db/id #edb/ref 17592186264291} {:answer/id #uuid "9c0fed83-26f2-58cf-9e61-edca1345442b" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186264336} {:answer/id #uuid "bedfa238-a1cb-50f4-b26d-08ac9994d923" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186264662} {:answer/id #uuid "cffb3874-d3c5-58d9-9efc-875fe9730f23" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186264822}] :answer-field/correct {:db/id #edb/ref 17592186264291} :answer-field/id #uuid "567ae966-e7d1-5296-a3f6-661d2e59d117" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265397}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5288d9bb-0110-5357-979f-882b0ee060b3" :question/math-academy-id "q-131728" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}-x+4y &=-2 \\\\ -3x+(3k+15)y &=-4\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}-1 & 4 & -2 \\\\ -3 & 3k+15 & -4\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-1 & 4 & -2 \\\\ -3 & 3k+15 & -4\\end{bmatrix} & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\begin{bmatrix}-1 & 4 & -2 \\\\ 0 & 3k+3 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}-x+4y &=-2 \\\\ (3k+3)y &=2.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-1,$ then the second equation is $0=2,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-1.$"} {:db/id #edb/ref 17592186266119 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "427da7e5-15ac-51bd-a759-d90b6c65d454" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{2}{7}" :db/id #edb/ref 17592186263588} {:answer/id #uuid "538a47b2-6a0b-5a53-99e0-b4e09df09626" :answer/type {:db/ident :answer.type/math} :answer/value "k=-7" :db/id #edb/ref 17592186263720} {:answer/id #uuid "7f383d71-c4b1-501b-823d-dfdddaac22d3" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{7}{2}" :db/id #edb/ref 17592186264099} {:answer/id #uuid "b60949ed-65e4-5904-90e9-755392f2794a" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{7}{2}" :db/id #edb/ref 17592186264578} {:answer/id #uuid "d7266032-5cfb-59d1-b694-4b3ac335232b" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186264875}] :answer-field/correct {:db/id #edb/ref 17592186264578} :answer-field/id #uuid "446ceb46-6d4a-51ab-82b3-1f055fd41555" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265373}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "49ba50cf-14b7-5be4-8660-2e096dc4c172" :question/math-academy-id "q-131729" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n\\left\\{\\begin{aligned}-2x+7y &=6 \\\\ x+ky &=-3\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}-2 & 7 & 6 \\\\ 1 & k & -3\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-2 & 7 & 6 \\\\ 1 & k & -3\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & k & -3 \\\\ -2 & 7 & 6\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & k & -3 \\\\ 0 & 2k+7 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+ky &=-3 \\\\ (2k+7)y &=0.\\end{aligned}\\right.\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=-\\frac{7}{2},$ then the second equation is $0=0,$ which is true for any value of $y$, and we can remove this equation from the system. As a result, the system will contain only one equation, $x+ky=-3.$ \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=-\\frac{7}{2}.$"} {:db/id #edb/ref 17592186266120 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5280ce29-a009-5d89-b11c-32a91956f88d" :answer/type {:db/ident :answer.type/math} :answer/value "k=-9" :db/id #edb/ref 17592186263711} {:answer/id #uuid "a8cf5fce-3112-5b03-8cf3-0d4a08494133" :answer/type {:db/ident :answer.type/math} :answer/value "k=-6" :db/id #edb/ref 17592186264442} {:answer/id #uuid "bac8e055-43dd-52ec-b2ee-c1af2bc589d4" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186264621} {:answer/id #uuid "bf50ed27-034a-525d-8d4e-b76acf4ead2d" :answer/type {:db/ident :answer.type/math} :answer/value "k=9" :db/id #edb/ref 17592186264666} {:answer/id #uuid "d2c3e1a0-f525-5859-8a97-2dbc90d7ad24" :answer/type {:db/ident :answer.type/math} :answer/value "k=-12" :db/id #edb/ref 17592186264838}] :answer-field/correct {:db/id #edb/ref 17592186263711} :answer-field/id #uuid "fe108dd5-5b35-596c-94e7-349c53f9ba7a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265698}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "87026642-3a4d-5af1-8cd6-01d366fc76fa" :question/math-academy-id "q-131731" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n\\left\\{\\begin{aligned}-2x+6y &=-4 \\\\ 5x+(k-6)y &=10\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}-2 & 6 & -4 \\\\ 5 & k-6 & 10\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-2 & 6 & -4 \\\\ 5 & k-6 & 10\\end{bmatrix} & {R}_{2} & :={R}_{2}+\\frac{5}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & 6 & -4 \\\\ 0 & k+9 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}-2x+6y &=-4 \\\\ (k+9)y &=0.\\end{aligned}\\right.\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=-9,$ then the second equation is $0=0,$ which is true for any value of $y.$ So, we can remove this equation from the system. As a result, the system will contain only one equation, $-2x+6y=-4.$  \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=-9.$"} {:db/id #edb/ref 17592186302109 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9eefeb35-a93a-5693-8a54-a335560cde62" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186300764} {:answer/id #uuid "a14a43e5-9b21-562f-aaa1-5f805da32173" :answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186300773} {:answer/id #uuid "a2621a0b-e192-593d-b62d-8165fb69e7a9" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186300778} {:answer/id #uuid "b3d7fb16-c926-51ed-a5b0-cbfd28c2fab5" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186300857} {:answer/id #uuid "f15a5a0a-88a7-5b7b-9e41-9d091c25e2a8" :answer/type {:db/ident :answer.type/math} :answer/value "k=4" :db/id #edb/ref 17592186301152}] :answer-field/correct {:db/id #edb/ref 17592186300857} :answer-field/id #uuid "0c0fdc5a-0dcc-576e-afcb-e159db8dd3fe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186301262}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "534e2a93-e71a-5475-894e-dfd5ca99a3a6" :question/math-academy-id "q-32245" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}2x-y &=3 \\\\ 4x+ky &=4\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}2 & -1 & 3 \\\\ 4 & k & 4\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & -1 & 3 \\\\ 4 & k & 4\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -1 & 3 \\\\ 0 & k+2 & -2\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}2x-y &=3 \\\\ (k+2)y &=-2.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nNow if $k=-2$, then the second equation is $0=-2,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when  $k=-2.$"} {:db/id #edb/ref 17592186302143 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39edf270-ef24-52e6-8a06-10a72874478d" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186300241} {:answer/id #uuid "441122b0-3b95-5e4c-ad49-ebd17ab5fd1b" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186300297} {:answer/id #uuid "7951ba97-6d77-594c-84f6-7b1ce6a00426" :answer/type {:db/ident :answer.type/math} :answer/value "k=-5" :db/id #edb/ref 17592186300560} {:answer/id #uuid "8713309c-6e3b-5cbf-9236-a21b2e8d5efd" :answer/type {:db/ident :answer.type/math} :answer/value "k=-8" :db/id #edb/ref 17592186300642} {:answer/id #uuid "99ccc30d-db87-5ff3-b366-54bc530fc04c" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186300734}] :answer-field/correct {:db/id #edb/ref 17592186300241} :answer-field/id #uuid "7a94e5ac-1c4c-5f66-9534-54809e136ec5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186301608}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f5f8dda9-f72e-566e-91bc-44ecdce08b8e" :question/math-academy-id "q-32331" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}-4x-y &=2 \\\\ 8x+ky &=5\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}-4 & -1 & 2 \\\\ 8 & k & 5\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-4 & -1 & 2 \\\\ 8 & k & 5\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}-4 & -1 & 2 \\\\ 0 & k-2 & 9\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}-4x-y &=2 \\\\ (k-2)y &=9.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=2,$ then the second equation is $0=9,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=2.$"} {:db/id #edb/ref 17592186344961 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b9a3770-af37-58af-91e7-3430fd2463b3" :answer/type {:db/ident :answer.type/math} :answer/value "k=5" :db/id #edb/ref 17592186343154} {:answer/id #uuid "71cae964-c567-5585-ab23-7241fb114732" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186343221} {:answer/id #uuid "a8f3da90-4b17-5b45-af78-2746f79a0b95" :answer/type {:db/ident :answer.type/math} :answer/value "k=1" :db/id #edb/ref 17592186343724} {:answer/id #uuid "ad97781e-f202-56a0-803a-f17ee1a49ca9" :answer/type {:db/ident :answer.type/math} :answer/value "k=9" :db/id #edb/ref 17592186343764} {:answer/id #uuid "f0d5b11f-4138-5c57-8bc8-f9f3a404cfaa" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186344356}] :answer-field/correct {:db/id #edb/ref 17592186344356} :answer-field/id #uuid "6517af05-6089-578f-972a-9310f8010c94" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344664}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a0c28bd7-70de-59aa-93c9-933cbaca4593" :question/math-academy-id "q-74646" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x+4y &=2 \\\\ 2x+(k+1)y &=3\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 4 & 2 \\\\ 2 & k+1 & 3\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 4 & 2 \\\\ 2 & k+1 & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 4 & 2 \\\\ 0 & k-7 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+4y &=2 \\\\ (k-7)y &=-1.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=7,$ then the second equation is $0=-1,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=7.$"} {:db/id #edb/ref 17592186344969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30949865-bcb4-5324-b20a-5013ed16ed8b" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186342643} {:answer/id #uuid "b02857e6-f7e6-504c-84a4-ca08044eec2c" :answer/type {:db/ident :answer.type/math} :answer/value "k=-1" :db/id #edb/ref 17592186343786} {:answer/id #uuid "bd377e49-f3f5-59d7-82a4-fcccc36aefd5" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186343902} {:answer/id #uuid "cffbe52d-faab-5e8d-a8c2-edecdb561a49" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186344066} {:answer/id #uuid "d763087a-bc9a-5f66-ac0e-8fa93b6ecd3b" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186344130}] :answer-field/correct {:db/id #edb/ref 17592186344066} :answer-field/id #uuid "78098d80-b356-5405-a056-ca928a0838fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344710}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bdfa86e8-f2dc-5d19-9144-98ae43ab2ede" :question/math-academy-id "q-74688" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-4 \\\\ 3x+2ky &=-2\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}1 & 2 & -4 \\\\ 3 & 2k & -2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & -4 \\\\ 3 & 2k & -2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & -4 \\\\ 0 & 2k-6 & 10\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+2y &=-4 \\\\ (2k-6)y &=10.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=3,$ then the second equation is $0=10,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=3.$"} {:db/id #edb/ref 17592186344971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ba1e46b-dcb4-5f9e-b60f-f807d3ae1d2d" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{1}{4}" :db/id #edb/ref 17592186342339} {:answer/id #uuid "47f4259f-5c12-50a0-8a37-001fbf58b6db" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{1}{4}" :db/id #edb/ref 17592186342833} {:answer/id #uuid "761008e6-93b4-567d-8e13-46b3d3b90948" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{1}{2}" :db/id #edb/ref 17592186343257} {:answer/id #uuid "ec9c9c6a-7091-5c96-a5e5-dd27877f775b" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186344317} {:answer/id #uuid "fa6d777f-a907-5d3e-9303-b5a3d04a19d9" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{1}{8}" :db/id #edb/ref 17592186344440}] :answer-field/correct {:db/id #edb/ref 17592186343257} :answer-field/id #uuid "4c8919c1-08e4-5d2b-8a8d-6b97ba594aea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344620}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "db41cb50-724f-5af7-85df-697ff3307e10" :question/math-academy-id "q-74695" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n\\left\\{\\begin{aligned}4x+2y &=-8 \\\\ x+ky &=-2\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}4 & 2 & -8 \\\\ 1 & k & -2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}4 & 2 & -8 \\\\ 1 & k & -2\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & k & -2 \\\\ 4 & 2 & -8\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-4){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & k & -2 \\\\ 0 & 2-4k & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+ky &=2 \\\\ (2-4k)y &=0.\\end{aligned}\\right.\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=\\frac{1}{2},$ then the second equation is $0=0,$ which is true for any value of $y$, and we can remove this equation from the system. As a result, the system will contain only one equation, $x+ky=2.$ \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=\\frac{1}{2}.$"} {:db/id #edb/ref 17592186398982 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e3df6cd2-68c7-5027-b94c-cebc3edbefd0" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{1}{2}" :db/id #edb/ref 17592186398984} {:answer/id #uuid "3d7403d1-9523-59ef-892c-8762070fc770" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{1}{2}" :db/id #edb/ref 17592186398985} {:answer/id #uuid "43b3ca27-4022-5e94-91a9-05d77b4b0c3b" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186398986} {:answer/id #uuid "321a43c8-209e-53e7-bddf-716f4dd735c7" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186398987} {:answer/id #uuid "a9f1972b-cdc9-5bbd-bf68-8c034ebe8712" :answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186398988}] :answer-field/correct {:db/id #edb/ref 17592186398987} :answer-field/id #uuid "ce520123-e722-5fc8-b4b5-0ce963a1fe4b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186398983}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2b1df7fe-03a7-50e4-93e7-ab9ba910308e" :question/math-academy-id "q-74650" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n\\left\\{\\begin{aligned}2x+6y &=4 \\\\ x+(k+1)y &=2\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}2 & 6 & 4 \\\\ 1 & k+1 & 2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & 6 & 4 \\\\ 1 & k+1 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-\\frac{1}{2}){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 6 & 4 \\\\ 0 & k-2 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}2x+6y &=4 \\\\ (k-2)y &=0.\\end{aligned}\\right.\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=2,$ then the second equation is $0=0,$ which is true for any value of $y.$ So, we can remove this equation from the system. As a result, the system will contain only one equation, $2x+6y=4.$  \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=2.$"} {:db/id #edb/ref 17592186417082 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0250b550-0b7c-5c05-b8f5-33da7345f93c" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186417069} {:answer/id #uuid "0e30254f-fef5-5030-ad74-62323657f390" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186417070} {:answer/id #uuid "32810e7f-ad8d-5b1e-a7d2-839ff11f12a9" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{2}{3}" :db/id #edb/ref 17592186417071} {:answer/id #uuid "5b0d5bd9-5c97-5445-afdc-58640864c07d" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{2}{3}" :db/id #edb/ref 17592186417074} {:answer/id #uuid "e23cbcca-7092-5855-aeeb-dd2de6061a27" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{3}{2}" :db/id #edb/ref 17592186417078}] :answer-field/correct {:db/id #edb/ref 17592186417071} :answer-field/id #uuid "26b28742-5ee2-597a-8428-7062724625e9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186417079}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6deb5ca1-ae5b-5721-895d-6efa8ac5fdfb" :question/math-academy-id "q-131730" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n\\left\\{\\begin{aligned}3x+2y &=12 \\\\ x+ky &=4\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}3 & 2 & 12 \\\\ 1 & k & 4\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}3 & 2 & 12 \\\\ 1 & k & 4\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & k & 4 \\\\ 3 & 2 & 12\\end{bmatrix} & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & k & 4 \\\\ 0 & 2-3k & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+ky &=4 \\\\ (2-3k)y &=0.\\end{aligned}\\right.\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=\\frac{2}{3},$ then the second equation is $0=0,$ which is true for any value of $y$, and we can remove this equation from the system. As a result, the system will contain only one equation, $x+ky=4.$ \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=\\frac{2}{3}.$"} {:db/id #edb/ref 17592186425949 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17602323-8777-51fe-9a70-fac173438e8d" :answer/type {:db/ident :answer.type/math} :answer/value "k=1" :db/id #edb/ref 17592186425938} {:answer/id #uuid "3745dd5b-bc8f-5c5f-bfbb-0a70d0ee8eee" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186425940} {:answer/id #uuid "8c1862b9-030a-5755-b668-e59ca4c9e456" :answer/type {:db/ident :answer.type/math} :answer/value "k=-5" :db/id #edb/ref 17592186425944} {:answer/id #uuid "a1294db0-0da9-5a02-b9e5-791ef34dcf11" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186425946} {:answer/id #uuid "cf6dc1f0-4ead-53bf-8e9f-9b57805aa51d" :answer/type {:db/ident :answer.type/math} :answer/value "k=5" :db/id #edb/ref 17592186425947}] :answer-field/correct {:db/id #edb/ref 17592186425947} :answer-field/id #uuid "80130b9b-78a0-54cc-bf84-e036ce6c2ff0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186425948}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "db005b4e-86cd-5194-b2fd-10ca4ee59c03" :question/math-academy-id "q-42021" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n\\left\\{\\begin{aligned}x+2y &=3 \\\\ -3x-(k+1)y &=-9\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 2 & -3 \\\\ -3 & -(k+1) & -9\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & 3 \\\\ -3 & -(k+1) & -9\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 3 \\\\ 0 & -k+5 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}1-2y &=3 \\\\ -(k-5)y &=0.\\end{aligned}\\right.\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=5,$ then the second equation is $0=0,$ which is true for any value of $y$, and we can remove this equation from the system. As a result, the system will contain only one equation, $x+2y=3.$ \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=5.$"} {:db/id #edb/ref 17592186492874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a7b0d87-9712-510c-adb7-5bde077204da" :answer/type {:db/ident :answer.type/math} :answer/value "k=10" :db/id #edb/ref 17592186492235} {:answer/id #uuid "58ea3fc2-519f-5eea-8c33-6dce5b9c6e3d" :answer/type {:db/ident :answer.type/math} :answer/value "k=8" :db/id #edb/ref 17592186492389} {:answer/id #uuid "8133480e-57da-5ca9-9bce-a1b99fc82856" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186492477} {:answer/id #uuid "a85d27da-01e0-5767-a1e4-b5479a5241b4" :answer/type {:db/ident :answer.type/math} :answer/value "k=5" :db/id #edb/ref 17592186492558} {:answer/id #uuid "da15d75f-b174-5630-b7ee-c26933c1301a" :answer/type {:db/ident :answer.type/math} :answer/value "k=6" :db/id #edb/ref 17592186492646}] :answer-field/correct {:db/id #edb/ref 17592186492477} :answer-field/id #uuid "df2effb2-e366-52f0-a14b-bc202d0cbc2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492799}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7409a043-b196-5341-8318-5b111a0c527e" :question/math-academy-id "q-131725" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}2x-y &=3 \\\\ -4x+(k-5)y &=-1\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}2 & -1 & 3 \\\\ -4 & k-5 & -1\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & -1 & 3 \\\\ -4 & k-5 & -1\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -1 & 3 \\\\ 0 & k-7 & 5\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}2x-y &=3 \\\\ (k-7)y &=5.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=7,$ then the second equation is $0=5,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=7.$"} {:db/id #edb/ref 17592186557414 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "124ff963-b72f-5e65-b019-142dc4093408" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186557411} {:answer/id #uuid "495a45f0-bf5a-5f2b-853f-98a9a40f50da" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186557417} {:answer/id #uuid "be3cc917-c1ca-51f1-b1a3-22d23039ef3b" :answer/type {:db/ident :answer.type/math} :answer/value "k=6" :db/id #edb/ref 17592186557437} {:answer/id #uuid "cf92e2a8-ab48-5340-bcba-2883848e6c01" :answer/type {:db/ident :answer.type/math} :answer/value "k=-6" :db/id #edb/ref 17592186557439} {:answer/id #uuid "d1ed5e36-0fb0-57ce-baac-38fe4ee2f4d2" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186557440}] :answer-field/correct {:db/id #edb/ref 17592186557437} :answer-field/id #uuid "ba282d53-b116-5cfa-b41a-8b04b5bb86c6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557436}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2d5b5966-d0b2-51ba-a7a1-c76ebe8e6658" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x+3y &=-5 \\\\ 2x+ky &=-8\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & 3 & -5 \\\\ 2 & k & -8\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}1 & 3 & -5 \\\\ 2 & k & -8\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 3 & -5 \\\\ 0 & k-6 & 2\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+3y &=-5 \\\\ (k-6)y &=2.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=6,$ then the second equation is $0=2,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=6.$"} {:db/id #edb/ref 17592186557415 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c268bc9-b98d-5227-b731-95e04d9c3527" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186557418} {:answer/id #uuid "ad10948b-c229-52b4-8bd9-550ddae2c192" :answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186557432} {:answer/id #uuid "b131d745-d31e-5a08-8285-4bc65717285c" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186557433} {:answer/id #uuid "b28ffa47-7c40-5583-883d-0cf4b033e17f" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186557434} {:answer/id #uuid "db4baf4b-c62c-5894-9637-6b82ba9cf1c0" :answer/type {:db/ident :answer.type/math} :answer/value "k=4" :db/id #edb/ref 17592186557443}] :answer-field/correct {:db/id #edb/ref 17592186557432} :answer-field/id #uuid "5b3e1241-c1a0-5544-9eae-6f9a638414ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557422}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "364e838c-b667-5333-9687-aeee90961e0c" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-4 \\\\ -2x+ky &=5\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & 2 & -4 \\\\ -2 & k & 5\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}1 & 2 & -4 \\\\ -2 & k & 5\\end{array}\\right] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 2 & -4 \\\\ 0 & k+4 & -3\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+2y &=-4 \\\\ (k+4)y &=-3.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-4,$ then the second equation is $0=-3,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-4.$"} {:db/id #edb/ref 17592186557416 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27dd0a80-4647-5fb3-bf6e-d022bfd8b7be" :answer/type {:db/ident :answer.type/math} :answer/value "k=-6" :db/id #edb/ref 17592186557412} {:answer/id #uuid "7876e850-f579-5b07-8b9c-174d601fcc57" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186557425} {:answer/id #uuid "86b4dd02-2b53-599b-a39f-7cdb9621c84d" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186557426} {:answer/id #uuid "8d82f745-e687-53bf-a943-5f5c160a27c8" :answer/type {:db/ident :answer.type/math} :answer/value "k=6" :db/id #edb/ref 17592186557429} {:answer/id #uuid "90469b9f-cd36-5eb9-a240-2e5bd047b529" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186557430}] :answer-field/correct {:db/id #edb/ref 17592186557412} :answer-field/id #uuid "b669bb3f-c7dc-5f8f-b577-73556f01d6a7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557435}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4508cab0-6e88-59d6-a9c3-7b9fc61a9c9d" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x-2y &=5 \\\\ 3x+ky &=3\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & -2 & 5 \\\\ 3 & k & 3\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}1 & -2 & 5 \\\\ 3 & k & 3\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 5 \\\\ 0 & k+6 & -12\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x-2y &=5 \\\\ (k+6)y &=-12.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-6,$ then the second equation is $0=-12,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-6.$"} {:db/id #edb/ref 17592186557419 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58b63595-07c3-5725-80e1-8d68eb1d1eac" :answer/type {:db/ident :answer.type/math} :answer/value "k=-6" :db/id #edb/ref 17592186557420} {:answer/id #uuid "58f14b39-9200-54eb-8f1e-3dda0f24757d" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186557421} {:answer/id #uuid "60a6d9bd-3eb0-5fbb-8b4c-3b367438cadc" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186557424} {:answer/id #uuid "87e3b172-ceb3-5955-b7d5-9979995635ca" :answer/type {:db/ident :answer.type/math} :answer/value "k=6" :db/id #edb/ref 17592186557427} {:answer/id #uuid "bea126fd-72a5-56d7-8f24-ee9beadcdf63" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186557438}] :answer-field/correct {:db/id #edb/ref 17592186557420} :answer-field/id #uuid "d43ac781-bcce-57c0-9a91-14ff48ccf057" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557441}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "550c7cdf-5810-56e4-b192-4674132b8147" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x-3y &=-4 \\\\ 2x+ky &=-3\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & -3 & -4 \\\\ 2 & k & -3\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}1 & -3 & -4 \\\\ 2 & k & -3\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -3 & -4 \\\\ 0 & k+6 & 5\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x-3y &=-4 \\\\ (k+6)y &=5.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-6,$ then the second equation is $0=5,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-6.$"} {:db/id #edb/ref 17592186557444 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "040900c0-cbe2-5a3b-bf63-00c6502b1713" :answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186557410} {:answer/id #uuid "2ce26fa4-9b16-5f35-94ea-df9965919477" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186557413} {:answer/id #uuid "895f3ba6-7e73-5ee1-88ee-96b78cf55a9c" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186557428} {:answer/id #uuid "9d8a51e6-cd68-5ca8-bf4b-3b66c24eddc6" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186557431} {:answer/id #uuid "d7b4341b-24d7-5601-bee0-2b97f2a49be1" :answer/type {:db/ident :answer.type/math} :answer/value "k=4" :db/id #edb/ref 17592186557442}] :answer-field/correct {:db/id #edb/ref 17592186557410} :answer-field/id #uuid "5bbf5c12-3409-5553-9dd1-d59b687d99b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557423}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f4f00ddd-faa4-5195-9569-dbec2d0e2e6c" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-5 \\\\ -2x+ky &=0\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & 2 & -5 \\\\ -2 & k & 0\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}1 & 2 & -5 \\\\ -2 & k & 0\\end{array}\\right] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 2 & -5 \\\\ 0 & k+4 & -10\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+2y &=-5 \\\\ (k+4)y &=-10.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-4,$ then the second equation is $0=-10,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-4.$"}] :knowledge-point/title "Determining the Value of a Constant for Which a Given Linear System Is Consistent or Inconsistent"} {:db/id #edb/ref 17592186115299 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115124 :question/id #uuid "cd56314d-f45a-55be-9762-983fe507a1a0" :question/math-academy-id "e-6173" :question/problem "Given the system\n![](images/0e/0e89fc57b6af2ddf2a71246dbadc7feb8425d1e1e0ab8f988e7e8ad97d22cff7.svg)\nwhich of the following statements are true?\n\n- The system is consistent dependent\n\n- The system has no solution\n\n- The system is consistent independent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n![](images/3e/3e3e8adb0d6e13f7d3b4c3e450b25a789480ac53189ab92385174688e460b2cc.svg)\n\nUsing Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & -3 & 4 \\\\ -4 & 6 & -8\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -3 & 4 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe system is now\n![](images/41/4122fb4ef56aa99161b15bc25001ca728a6cf7dae36d5dac0aac9b03dc411685.svg)\n\nSince any numbers $x$ and $y$ form a solution of the final equation $0x+0y=0,$ we can remove this equation from the system. So, our system now consists of just a single equation:\n\n$$\n2x -3y= 4\n$$\n\nThe basic variable is $x,$ and we have a free variable $y.$ That means we need to find $x$ in terms of $y.$ \n\nTherefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*.\n\nAs a result, only statement I is true."} :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050240}] :knowledge-point/question-generator {:db/id #edb/ref 17592186523192 :question-generator/id #uuid "ef6ae15d-64a0-50e2-9946-0e7f859493c2" :question-generator/script "generate/scratch/17592186115299.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186115752 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4bdc967-dd67-5770-b3ba-57acb8064685" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438106} {:answer/id #uuid "16d63261-26fa-564b-9a02-813ef69df1ff" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438107}] :answer-field/correct {:db/id #edb/ref 17592186438106} :answer-field/id #uuid "48e752bf-5559-502a-9c5a-30d89ae8707e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439082} {:answer-field/choices [{:answer/id #uuid "bd14eb1a-54cf-5d73-9b08-8904377c5fc5" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438108} {:answer/id #uuid "05ef1b8f-126b-56bb-bda0-423f87e55922" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438109}] :answer-field/correct {:db/id #edb/ref 17592186438109} :answer-field/id #uuid "343b74aa-4317-53b2-a41d-750a92184a1b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439083} {:answer-field/choices [{:answer/id #uuid "6e68484e-ebe2-513a-9922-2e5462de62b6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438110} {:answer/id #uuid "7fe5eb6d-0b84-5bb3-929e-e95859bb6bf1" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438111}] :answer-field/correct {:db/id #edb/ref 17592186438110} :answer-field/id #uuid "9d0bc1ed-439f-55dd-983f-394748aacbef" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439084}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "402ab26a-a0df-5fc5-a264-b91a4c6d7d02" :question/math-academy-id "q-32242" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}-x+2y &=6 \\\\ 2x-3y &=13 \\\\ 5x-y &=45\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n- **II.** The system is inconsistent\n- **III.** The system has a unique solution" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}-1 & 2 & 6 \\\\ 2 & -3 & 13 \\\\ 5 & -1 & 45\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-1 & 2 & 6 \\\\ 2 & -3 & 13 \\\\ 5 & -1 & 45\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}-1 & 2 & 6 \\\\ 0 & 1 & 25 \\\\ 5 & -1 & 45\\end{bmatrix} & {R}_{3} & :={R}_{3}+5{R}_{1} \\\\  & ∼\\begin{bmatrix}-1 & 2 & 6 \\\\ 0 & 1 & 25 \\\\ 0 & 9 & 75\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-9){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -2 & -6 \\\\ 0 & 1 & 25 \\\\ 0 & 0 & -150\\end{bmatrix}\\end{aligned}\n$$\n\nThe final row corresponds to the equation $0x+0y=-150,$ and this has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, only statement II is true."} {:db/id #edb/ref 17592186115832 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1eee681-520d-5d0a-802e-8d5b29c52974" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438296} {:answer/id #uuid "b2ace7b5-89a9-5ece-ad6b-0ce43e80a049" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438297}] :answer-field/correct {:db/id #edb/ref 17592186438297} :answer-field/id #uuid "07e35039-20ea-5f8c-9889-aaf209c08f8c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439177} {:answer-field/choices [{:answer/id #uuid "1c3d1f45-fc1a-5e10-a017-8a9199b3e295" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438298} {:answer/id #uuid "039beb6d-4028-5582-9983-702125a74145" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438299}] :answer-field/correct {:db/id #edb/ref 17592186438298} :answer-field/id #uuid "168dcfad-47ff-5ee1-9214-61e870c730b0" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439178} {:answer-field/choices [{:answer/id #uuid "ae82757c-5e4b-593d-84dd-aca1302ca366" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438300} {:answer/id #uuid "8f20a360-4b99-5b18-808c-9bab5fd09713" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438301}] :answer-field/correct {:db/id #edb/ref 17592186438300} :answer-field/id #uuid "8b7ded78-a4d6-5805-8398-330746f91418" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439179}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e80c83a9-9107-528b-af57-73287d15e8e2" :question/math-academy-id "q-42061" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x-3y+z &=0 \\\\ -4x+6y &=2\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n\n- **II.** The system has no solution\n\n- **III.** The system is consistent independent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & -3 & 1 & 0 \\\\ -4 & 6 & 0 & 2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -3 & 1 & 0 \\\\ -4 & 6 & 0 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 1 & 0 \\\\ 0 & -6 & 4 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y,$ and we have one free variable, $z.$ That means we can to find $x$ and $y$ in terms of $z.$ \n\nTherefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*. \n\nAs a result, only statement I is true."} {:db/id #edb/ref 17592186266113 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b502811a-4c5f-5724-8251-868a9480b1c0" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437878} {:answer/id #uuid "186cb15a-6c0f-5792-ab70-d713ad9b8faf" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437879}] :answer-field/correct {:db/id #edb/ref 17592186437878} :answer-field/id #uuid "6923725d-7900-549a-b06a-031593c2ab18" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438968} {:answer-field/choices [{:answer/id #uuid "c85fcf8a-4336-5666-8410-cf5fbbf94767" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437880} {:answer/id #uuid "df5f6c33-1e84-5f01-826a-31cd583e3cc7" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437881}] :answer-field/correct {:db/id #edb/ref 17592186437881} :answer-field/id #uuid "b513b48d-527b-559e-ab81-1586620cce1c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438969} {:answer-field/choices [{:answer/id #uuid "b5dc7bbd-657b-572d-b363-90d7302303fc" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437882} {:answer/id #uuid "50ff0389-893c-5201-a509-7c08e6f042f3" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437883}] :answer-field/correct {:db/id #edb/ref 17592186437882} :answer-field/id #uuid "3cdaf77b-d135-55af-862e-3a96aaf3f51e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438970}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e7e2bc11-b1bf-5938-9267-7923a80ec463" :question/math-academy-id "q-131719" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+4y &=-1 \\\\ 2x+8y &=-2 \\\\ -3x-12y &=3\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is inconsistent\n\n- **II.** The system is consistent dependent\n\n- **III.** The system has a unique solution" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 4 & -1 \\\\ 2 & 8 & -2 \\\\ -3 & -12 & 3\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 4 & -1 \\\\ 2 & 8 & -2 \\\\ -3 & -12 & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 4 & -1 \\\\ 0 & 0 & 0 \\\\ -3 & -12 & 3\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 4 & -1 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x,$ and we have one free variable, $y.$ That means we can find $x$ in terms of $y.$ \n\nTherefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*. \n\nAs a result, only statement II is true."} {:db/id #edb/ref 17592186266114 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ee5d0a5-5b6e-5e3a-bb66-236cc33d9fb6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437902} {:answer/id #uuid "cf7df624-9f74-5695-9b6d-fb27e4a094f5" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437903}] :answer-field/correct {:db/id #edb/ref 17592186437903} :answer-field/id #uuid "db4757d3-9a84-5289-8aea-f7dd1a0eb7d1" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438980} {:answer-field/choices [{:answer/id #uuid "3e0c899b-5aaf-5d75-b95e-4d89e3c89c6c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437904} {:answer/id #uuid "c3bf7724-4756-5a58-8783-ffddc955e5ab" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437905}] :answer-field/correct {:db/id #edb/ref 17592186437904} :answer-field/id #uuid "cecffd33-a545-559e-827c-1ba60cf5059c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438981} {:answer-field/choices [{:answer/id #uuid "c37efec2-77d1-5d31-9f9f-b29a46d81229" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437906} {:answer/id #uuid "606ba1d3-bcb9-5739-b0cd-4e6ddfbaf77d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437907}] :answer-field/correct {:db/id #edb/ref 17592186437906} :answer-field/id #uuid "0f404ad7-7486-5271-8eb0-8c1a59d275b4" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438982}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a61d7528-3ce2-5d0a-af23-11395074997a" :question/math-academy-id "q-131723" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x-y+z &=3 \\\\ -3x+3y-3z &=10\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is inconsistent\n- **II.** The system has a unique solution\n- **III.** The system is consistent dependent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & -1 & 1 & 3 \\\\ -3 & 3 & -3 & 10\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -1 & 1 & 3 \\\\ -3 & 3 & -3 & 10\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 1 & 3 \\\\ 0 & 0 & 0 & 19\\end{bmatrix}\\end{aligned}\n$$\n\nThe final row corresponds to the equation $0x+0y+0z=19,$ and this has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, only statement I is true."} {:db/id #edb/ref 17592186266115 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2950aad8-79f5-5899-8a58-73ef75011ac0" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437908} {:answer/id #uuid "e5392af0-e88c-54d2-80ee-57cd98c53027" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437909}] :answer-field/correct {:db/id #edb/ref 17592186437908} :answer-field/id #uuid "6c277d28-497a-56d5-a22a-96f890c9bcb2" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438983} {:answer-field/choices [{:answer/id #uuid "f6df39b7-5e62-56b8-9a40-278abbcd76e5" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437910} {:answer/id #uuid "bca4b43d-938c-5727-96c4-77957ed09741" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437911}] :answer-field/correct {:db/id #edb/ref 17592186437910} :answer-field/id #uuid "08f93447-1292-5c0a-bb93-f3816eee426f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438984} {:answer-field/choices [{:answer/id #uuid "6f2755c5-437d-57df-9454-eef1a48617ea" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437912} {:answer/id #uuid "c54df87b-4111-522f-b91f-f1d60f8ca696" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437913}] :answer-field/correct {:db/id #edb/ref 17592186437913} :answer-field/id #uuid "89e1b2ad-cfef-519b-be03-81a8b9fde67c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438985}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "09e95d08-30a6-5777-a8a8-348db8bfab42" :question/math-academy-id "q-131724" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x-2y &=2 \\\\ -3x-4y &=3 \\\\ 2x-4y &=-1\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n- **II.** The system has a unique solution\n- **III.** The system is inconsistent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & -2 & 2 \\\\ -3 & -4 & 3 \\\\ 2 & -4 & -1\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -2 & 2 \\\\ -3 & -4 & 3 \\\\ 2 & -4 & -1\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 2 \\\\ 0 & -10 & 9 \\\\ 2 & -4 & -1\\end{bmatrix} & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 2 \\\\ 0 & -10 & 9 \\\\ 0 & 0 & -5\\end{bmatrix}\\end{aligned}\n$$\n\nThe final row corresponds to the equation $0x+0y=-5,$ and this has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, only statement III is true."} {:db/id #edb/ref 17592186344956 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08768d96-6543-5057-b351-a7b1e161594f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438520} {:answer/id #uuid "e55197f9-beea-5d56-b568-4686a6fafa27" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438521}] :answer-field/correct {:db/id #edb/ref 17592186438520} :answer-field/id #uuid "c2c63157-7a5a-5373-8ad8-5fe787c42154" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439289} {:answer-field/choices [{:answer/id #uuid "7e975cf8-6ced-5fcc-a167-0751d7c6d489" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438522} {:answer/id #uuid "6a5469f6-81d5-5ff6-93db-790de506e3a8" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438523}] :answer-field/correct {:db/id #edb/ref 17592186438522} :answer-field/id #uuid "bc9e9ab2-76ef-5705-8ab7-acb52a0677b5" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439290} {:answer-field/choices [{:answer/id #uuid "2583daa7-3471-5757-b97e-74aae9210e3b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438524} {:answer/id #uuid "56894365-ac99-5761-9fdc-76740ad849bd" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438525}] :answer-field/correct {:db/id #edb/ref 17592186438525} :answer-field/id #uuid "fd6825c7-6c00-5310-b8fa-2fe4fbc48f05" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439291}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "edc80b1b-d469-5071-b24d-3c90bb47fce6" :question/math-academy-id "q-74635" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}-2x+4y+3z &=0 \\\\ x+3y &=2\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system has no solution\n- **II.** The system is consistent independent\n- **III.** The system is consistent dependent" :question/worked-solution "To classify the system, we first try to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}-2 & 4 & 3 & 0 \\\\ 1 & 3 & 0 & 2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-2 & 4 & 3 & 0 \\\\ 1 & 3 & 0 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & 4 & 3 & 0 \\\\ 0 & 5 & \\frac{3}{2} & 2\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y,$ and we have one free variable, $z.$ That means that  we can find $x$ and $y$ in terms of $z.$ \n\nTherefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*. \n\nAs a result, only statement III is true."} {:db/id #edb/ref 17592186344957 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d964555-6f83-5191-89db-fd72ffdf14c4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438526} {:answer/id #uuid "ad751ae7-e25b-5406-b9e3-27ea4cbed2f2" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438527}] :answer-field/correct {:db/id #edb/ref 17592186438526} :answer-field/id #uuid "ae1a0230-4005-55bc-8174-e0944a31dd3e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439292} {:answer-field/choices [{:answer/id #uuid "3be3c581-4293-5cdb-b090-f3c480d1c024" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438528} {:answer/id #uuid "89e07487-bb39-5368-bf53-e4b20abb5d72" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438529}] :answer-field/correct {:db/id #edb/ref 17592186438529} :answer-field/id #uuid "d62a54fe-bb91-5a39-8c45-d4f5ab79b9a1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439293} {:answer-field/choices [{:answer/id #uuid "4d848cbc-71b2-5e07-ad3c-93e27231b7c0" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438530} {:answer/id #uuid "82fdc104-5ebd-5054-99d2-64d287c3ea35" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438531}] :answer-field/correct {:db/id #edb/ref 17592186438530} :answer-field/id #uuid "a883d2db-1de6-5620-afb1-bd3d06ab629d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439294}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b0089d19-a4b5-5ec4-beaa-917a294458ba" :question/math-academy-id "q-74637" :question/problem "Consider the following system of equations\n\n$$\n\\left\\{\\begin{aligned}2x+3y &=-1 \\\\ x-2y &=1 \\\\ -x-5y &=2.\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system has no solution\n- **II.** The system is consistent independent\n- **III.** The system is consistent dependent" :question/worked-solution "To classify the system, we first try to find its solution. The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}2 & 3 & -1 \\\\ 1 & -2 & 1 \\\\ -1 & -5 & 2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & 3 & -1 \\\\ 1 & -2 & 1 \\\\ -1 & -5 & 2\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ 2 & 3 & -1 \\\\ -1 & -5 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ 0 & 7 & -3 \\\\ -1 & -5 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ 0 & 7 & -3 \\\\ 0 & -7 & 3\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ 0 & 7 & -3 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nSince any numbers $x$ and $y$ are solutions to the third equation $0x+0y=0$, we can remove this equation from the system. So, the corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-2y &=1 \\\\ 7y &=-3.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get $y=-\\frac{3}{7}.$ Substituting this into the first equation, we get\n\n$$\nx-2(-\\frac{3}{7})=1\\,⟹\\,x=\\frac{1}{7}.\n$$\n\n \nSo, we conclude that the system is consistent independent. \n\nAs a result, only statement II is true."} {:db/id #edb/ref 17592186363108 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4b2e2b5-5692-5b4a-804f-7518ab214d08" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437872} {:answer/id #uuid "3acb46da-0035-5f87-8672-6682f18cf559" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437873}] :answer-field/correct {:db/id #edb/ref 17592186437873} :answer-field/id #uuid "477f40a4-66af-5870-95c1-78ba941c5598" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438965} {:answer-field/choices [{:answer/id #uuid "8c7886ec-2b7c-5184-ba5d-a9cfd3f447ec" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437874} {:answer/id #uuid "1b86766c-211b-5526-8849-1753bc7e2812" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437875}] :answer-field/correct {:db/id #edb/ref 17592186437874} :answer-field/id #uuid "76f4b7f4-de99-5ebc-a3fb-5f5fcbe4139b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438966} {:answer-field/choices [{:answer/id #uuid "2d52184b-23ff-5d3d-be0f-8e48b9e54a9b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437876} {:answer/id #uuid "545708f8-29e7-5393-a590-6497da645a2c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437877}] :answer-field/correct {:db/id #edb/ref 17592186437876} :answer-field/id #uuid "6b08613c-08bd-5a65-b4c6-d5cae5341709" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438967}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e8de2435-5f56-5017-bf79-0b535c719854" :question/math-academy-id "q-131718" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x-3y+z &=2 \\\\ -2x+7y+2z &=-1\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n- **II.** The system has no solution\n- **III.** The system is consistent independent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & -3 & 1 & 2 \\\\ -2 & 7 & 2 & -1\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -3 & 1 & 2 \\\\ -2 & 7 & 2 & -1\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 1 & 2 \\\\ 0 & 1 & 4 & 3\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y,$ and we have one free variable, $z.$ That means we can find $x$ and $y$ in terms of $z.$ \n\nTherefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*. \n\nAs a result, only statement I is true."} {:db/id #edb/ref 17592186364365 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e2d5a83-8718-5bdf-8eb3-db892e2ab5e0" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438532} {:answer/id #uuid "8eaaea36-3739-5e8a-a1ed-efc15f9bc00b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438533}] :answer-field/correct {:db/id #edb/ref 17592186438532} :answer-field/id #uuid "8efd7542-c77b-5d4d-8f60-5468e0925423" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439295} {:answer-field/choices [{:answer/id #uuid "763f0363-fe65-5380-acc8-6965de771643" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438534} {:answer/id #uuid "be014b12-0b58-51d7-a7a3-d343e4554293" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438535}] :answer-field/correct {:db/id #edb/ref 17592186438535} :answer-field/id #uuid "1338d41d-dfae-54bb-ada6-b58b1d8cc303" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439296} {:answer-field/choices [{:answer/id #uuid "f48fb77e-36ef-5915-aaab-7df2660d984a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438536} {:answer/id #uuid "84b40478-f69c-539e-aac5-dd183a05b951" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438537}] :answer-field/correct {:db/id #edb/ref 17592186438536} :answer-field/id #uuid "7051a40c-c2de-5375-95a6-8801b39f67c5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439297}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "35b0295d-1e16-59cc-a201-696e791e0b7d" :question/math-academy-id "q-74643" :question/problem "Consider the following system of equations\n\n$$\n\\left\\{\\begin{aligned}3x+2y &=8 \\\\ x+y &=-2 \\\\ x+\\frac{1}{2}y &=5.\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system has no solution\n- **II.** The system is consistent independent\n- **III.** The system is consistent dependent" :question/worked-solution "To classify the system, we first try to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}3 & 2 & 8 \\\\ 1 & 1 & -2 \\\\ 1 & \\frac{1}{2} & 5\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}3 & 2 & 8 \\\\ 1 & 1 & -2 \\\\ 1 & \\frac{1}{2} & 5\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 1 & -2 \\\\ 3 & 2 & 8 \\\\ 1 & \\frac{1}{2} & 5\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & -2 \\\\ 0 & -1 & 14 \\\\ 1 & \\frac{1}{2} & 5\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & -2 \\\\ 0 & -1 & 14 \\\\ 0 & -\\frac{1}{2} & 7\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-\\frac{1}{2}){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 1 & -2 \\\\ 0 & -1 & 14 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nSince any numbers $x$ and $y$ are solutions to the third equation $0x+0y=0$, we can remove this equation from the system. So, the corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+y &=-2 \\\\ -y &=14.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get $y=-14.$ Substituting this into the first equation, we get\n\n$$\nx+(-14)=-2\\,⟹\\,x=12.\n$$\n\n \nSo,  we conclude that the system is consistent independent.   \n\nAs a result, only statement II is true."} {:db/id #edb/ref 17592186400632 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "042c39af-05d4-5916-90ed-b2140841c0e8" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437884} {:answer/id #uuid "d6aa4878-727c-5081-a2f3-b05cc3779d8d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437885}] :answer-field/correct {:db/id #edb/ref 17592186437884} :answer-field/id #uuid "819cb8bf-d475-5f1d-b674-12ded903565c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438971} {:answer-field/choices [{:answer/id #uuid "2b9fab9a-732e-557e-89af-5c725e033f13" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437886} {:answer/id #uuid "97937812-2266-5255-828e-cf5b3f4f3d5f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437887}] :answer-field/correct {:db/id #edb/ref 17592186437886} :answer-field/id #uuid "0eda7076-17f5-56be-93f9-786bf1b9618f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438972} {:answer-field/choices [{:answer/id #uuid "87384631-af80-5ad6-9a5c-bcc246f5f41d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437888} {:answer/id #uuid "46fcba46-2ddb-5e23-8878-f4e28acdd62f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437889}] :answer-field/correct {:db/id #edb/ref 17592186437889} :answer-field/id #uuid "fa55c229-a084-546e-87ad-83ef1343ba34" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438973}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cd791ebf-f827-5528-ae25-d3ac1f74c5cc" :question/math-academy-id "q-131720" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}2x-6y-2z &=4 \\\\ 3x-9y-3z &=6\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent independent\n- **II.** The system has no solution\n- **III.** The system is consistent dependent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}2 & -6 & -2 & 4 \\\\ 3 & -9 & -3 & 6\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & -6 & -2 & 4 \\\\ 3 & -9 & -3 & 6\\end{bmatrix} & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & -1 & 2 \\\\ 3 & -9 & -3 & 6\\end{bmatrix} & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & -1 & 2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x,$ and we have two free variables, $y$ and $z.$ That means we can find $x$ in terms of $y$ and $z.$ \n\nTherefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*. \n\nAs a result, only statement III is true."} {:db/id #edb/ref 17592186400639 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf929f6a-e145-57f9-9489-b8af5e174866" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437890} {:answer/id #uuid "7f26eb37-aeba-52b6-8b95-caafc52f3431" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437891}] :answer-field/correct {:db/id #edb/ref 17592186437891} :answer-field/id #uuid "2fbdbbd8-b352-5675-a10c-aa7c8880cb1e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438974} {:answer-field/choices [{:answer/id #uuid "70be4c05-8842-5d93-9933-6a01768e4c37" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437892} {:answer/id #uuid "6cec419e-f6b4-51c0-ae9e-deed2e858fc8" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437893}] :answer-field/correct {:db/id #edb/ref 17592186437892} :answer-field/id #uuid "51c120d2-aebb-5e91-8e2f-ef0869ec4dd4" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438975} {:answer-field/choices [{:answer/id #uuid "43f8ee53-d356-528d-9a82-f385997b6c3b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437894} {:answer/id #uuid "262383e4-8fe8-5d1c-ad11-c487ac71bc1f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437895}] :answer-field/correct {:db/id #edb/ref 17592186437894} :answer-field/id #uuid "07a2a3d4-474a-5d37-b1a5-05837e60f654" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438976}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b9b47374-5548-52b6-9b51-17d923fcd37b" :question/math-academy-id "q-131721" :question/problem "Consider the following system of equations\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-1 \\\\ 3x+7y &=1 \\\\ -2x-4y &=2.\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent independent\n- **II.** The system has no solution\n- **III.** The system is consistent dependent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}1 & 2 & -1 \\\\ 3 & 7 & 1 \\\\ -2 & -4 & 2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & -1 \\\\ 3 & 7 & 1 \\\\ -2 & -4 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & -1 \\\\ 0 & 1 & 4 \\\\ -2 & -4 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & -1 \\\\ 0 & 1 & 4 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nSince any numbers $x$ and $y$ are solutions to the third equation $0x+0y=0$, we can remove this equation from the system. So, the corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-1 \\\\ y &=4.\\end{aligned}\\right.\n$$\n\nFrom the second equation we have $y=4$ and substituting this into the first equation yields $x=-9.$ So,  we conclude that the system is consistent independent. \n\nAs a result, only statement I is true."} {:db/id #edb/ref 17592186400646 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b14622e0-0a8b-52f6-8bf8-44a04ea90e2e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437896} {:answer/id #uuid "422e0298-fb2d-5c6d-a4af-8cba072754ea" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437897}] :answer-field/correct {:db/id #edb/ref 17592186437896} :answer-field/id #uuid "2ddef766-7f45-5b44-b48d-737353d4be25" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438977} {:answer-field/choices [{:answer/id #uuid "522be474-9268-5719-9b67-fa3c52635318" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437898} {:answer/id #uuid "37b81bb5-685b-583b-8db4-0245d173fc7d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437899}] :answer-field/correct {:db/id #edb/ref 17592186437899} :answer-field/id #uuid "a0b79b55-bd9c-5274-8736-1fa18bb4e7d7" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438978} {:answer-field/choices [{:answer/id #uuid "63da7652-c50c-579a-9313-44ed8eac188b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437900} {:answer/id #uuid "715c6b27-3b25-5248-a7ad-aceb0fe78ca6" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437901}] :answer-field/correct {:db/id #edb/ref 17592186437900} :answer-field/id #uuid "a893b756-f994-5e2f-ab56-a98d5a543109" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438979}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4890e1ff-ed9a-5558-acd1-bcef01439e04" :question/math-academy-id "q-131722" :question/problem "Consider the following system of equations\n\n$$\n\\left\\{\\begin{aligned}3x-3y &=6 \\\\ -2x+y &=-3 \\\\ 4x-4y &=8.\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n- **II.** The system is consistent independent\n- **III.** The system has no solution" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}3 & -3 & 6 \\\\ -2 & 1 & -3 \\\\ 4 & -4 & 8\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}3 & -3 & 6 \\\\ -2 & 1 & -3 \\\\ 4 & -4 & 8\\end{bmatrix} & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 \\\\ -2 & 1 & -3 \\\\ 4 & -4 & 8\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 \\\\ 0 & -1 & 1 \\\\ 4 & -4 & 8\\end{bmatrix} & {R}_{3} & :={R}_{3}-4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 \\\\ 0 & -1 & 1 \\\\ 0 & 0 & 0\\end{bmatrix} & {R}_{2} & :=-{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nSince any numbers $x$ and $y$ are solutions to the third equation $0x+0y=0$, we can remove this equation from the system. So, the corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-y &=2 \\\\ y &=-1.\\end{aligned}\\right.\n$$\n\nFrom the second equation we have $y=-1$ and substituting this into the first equation yields $x=1.$ So,  we conclude that the system is consistent independent. \n\nAs a result, only statement II is true."} {:db/id #edb/ref 17592186402763 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e6873b1-0d04-54c4-a516-3393f091ca8b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438290} {:answer/id #uuid "cf136178-b995-530b-bb4f-ee1711feaab9" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438291}] :answer-field/correct {:db/id #edb/ref 17592186438290} :answer-field/id #uuid "0f126748-e572-518c-b374-65fb20a3785e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439174} {:answer-field/choices [{:answer/id #uuid "58ee750b-7fc4-5d76-a8fd-41226a7f5ad1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438292} {:answer/id #uuid "23ff6b9a-302b-5629-8e07-bc20b267963c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438293}] :answer-field/correct {:db/id #edb/ref 17592186438292} :answer-field/id #uuid "db15201f-7938-57e0-8d64-2e3e68d9b2f2" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439175} {:answer-field/choices [{:answer/id #uuid "db32e8d6-cfbf-5975-ae7e-91c6447ca478" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438294} {:answer/id #uuid "a53b68f3-fc73-544a-93b7-5353580edb77" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438295}] :answer-field/correct {:db/id #edb/ref 17592186438295} :answer-field/id #uuid "9847730a-03c8-54a9-b1d7-d557810eefed" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439176}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1a930b2a-2578-5145-8e40-06b6cab16ba9" :question/math-academy-id "q-42020" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-1 \\\\ 3x+y &=3 \\\\ -2x+y &=-2.\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n- **II.** The system has a unique solution\n- **III.** The system is inconsistent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 2 & -1 \\\\ 3 & 1 & 3 \\\\ -2 & 1 & -2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:  \n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & -1 \\\\ 3 & 1 & 3 \\\\ -2 & 1 & -2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & -1 \\\\ 0 & -5 & 6 \\\\ -2 & 1 & -2\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & -1 \\\\ 0 & -5 & 6 \\\\ 0 & 5 & -4\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 2 & -1 \\\\ 0 & -5 & 6 \\\\ 0 & 0 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nThe final row corresponds to the equation $0x+0y=2,$ and this has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, only statement III is true."} {:db/id #edb/ref 17592186403787 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ed3c728-986a-5b3f-ab57-0020cb435ca9" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438514} {:answer/id #uuid "72c05b38-661e-55ef-b895-991dd965f68d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438515}] :answer-field/correct {:db/id #edb/ref 17592186438514} :answer-field/id #uuid "d5f63264-b18f-5fb9-8709-61b443e3ce15" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439286} {:answer-field/choices [{:answer/id #uuid "1a9ad7d4-df0d-5491-9263-1cfec2f1523b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438516} {:answer/id #uuid "0cfc1f4e-c211-54e2-8df0-f80bdf080bed" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438517}] :answer-field/correct {:db/id #edb/ref 17592186438516} :answer-field/id #uuid "a0678042-ac90-54b5-926f-6259f946ee55" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439287} {:answer-field/choices [{:answer/id #uuid "c32dbf70-7f15-517a-9383-074f32bf4f01" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438518} {:answer/id #uuid "b90a004e-1b26-5348-ab56-1dd54d767fcc" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438519}] :answer-field/correct {:db/id #edb/ref 17592186438519} :answer-field/id #uuid "98fa2d2a-8e07-54bb-bb31-70f2215b776f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439288}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a8971116-e24d-5808-9b29-a50e168511e5" :question/math-academy-id "q-74634" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}2x-y &=-1 \\\\ 2x-4y &=3 \\\\ x+y &=2\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n\n- **II.** The system has a unique solution\n\n- **III.** The system is inconsistent" :question/worked-solution "To classify the system, we will first try to find its solution. The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}2 & -1 & -1 \\\\ 2 & -4 & 3 \\\\ 1 & 1 & 2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & -1 & -1 \\\\ 2 & -4 & 3 \\\\ 1 & 1 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -1 & -1 \\\\ 0 & -3 & 4 \\\\ 1 & 1 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-\\frac{1}{2}){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -1 & -1 \\\\ 0 & -3 & 4 \\\\ 0 & \\frac{3}{2} & \\frac{5}{2}\\end{bmatrix} & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{2} \\\\  & ∼\\begin{bmatrix}2 & -1 & -1 \\\\ 0 & -3 & 4 \\\\ 0 & 0 & \\frac{9}{2}\\end{bmatrix}\\end{aligned}\n$$\n\nThe final row corresponds to the equation $0x+0y=\\frac{9}{2},$ and it has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, only statement III is true."} {:db/id #edb/ref 17592186492840 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c122c68-ba85-506a-9b5d-b7e8d41f11b9" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186492400} {:answer/id #uuid "90746f9d-5a52-5223-86f2-eebad7cce602" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186492502} {:answer/id #uuid "a00e12c1-efd1-5bb1-8807-973d94c98793" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186492536} {:answer/id #uuid "af7e5af6-3e33-5368-823c-3062f7002694" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186492568} {:answer/id #uuid "fcccf2b5-4696-5f4a-92c9-3b29f694860e" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186492701}] :answer-field/correct {:db/id #edb/ref 17592186492568} :answer-field/id #uuid "83ab4b9b-dc34-5dc7-8a1e-ba7fb0076d92" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492760}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "22d64530-5ce7-515c-aafe-c528e2fc812f" :question/math-academy-id "q-74834" :question/problem "Consider the following system of equations\n\n$$\n\\left\\{\\begin{aligned}x-4y &=-1 \\\\ 2x-7y &=0 \\\\ -4x+15y &=2.\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nI. The system is consistent independent\n\nII. The system has no solution\n\nIII. The system is consistent dependent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}1 & -4 & -1 \\\\ 2 & -7 & 0 \\\\ -4 & 15 & 2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -4 & -1 \\\\ 2 & -7 & 0 \\\\ -4 & 15 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -4 & -1 \\\\ 0 & 1 & 2 \\\\ -4 & 15 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -4 & -1 \\\\ 0 & 1 & 2 \\\\ 0 & -1 & -2\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -4 & -1 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nSince any numbers $x$ and $y$ are solutions to the third equation $0x+0y=0$, we can remove this equation from the system. So, the corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-4y &=-1 \\\\ y &=2.\\end{aligned}\\right.\n$$\n\nFrom the second equation we have $y=2$ and substituting this into the first equation yields $x=7.$ So,  we conclude that the system is consistent independent. \n\nAs a result, only statement I is true."} {:db/id #edb/ref 17592186523101 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46fe9d86-8a7b-5b31-9f33-352086d9b0be" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523118} {:answer/id #uuid "58a2e68c-7ee5-5893-a320-e4d59782d97a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523127}] :answer-field/correct {:db/id #edb/ref 17592186523118} :answer-field/id #uuid "072bdae2-59da-58c7-af80-28f3f2f9aae7" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523094} {:answer-field/choices [{:answer/id #uuid "02336600-7104-5fb9-9b31-cae1a52518dc" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523092} {:answer/id #uuid "547d116e-af59-5ba8-b479-146d79b8a167" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523124}] :answer-field/correct {:db/id #edb/ref 17592186523124} :answer-field/id #uuid "2c4297dc-f995-5396-8e9e-d024c65ce177" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523113} {:answer-field/choices [{:answer/id #uuid "141e0203-23b8-5619-a962-5626778a971c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523103} {:answer/id #uuid "6fb4a988-bcd2-5b80-a37e-65bc083843a0" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523137}] :answer-field/correct {:db/id #edb/ref 17592186523103} :answer-field/id #uuid "60631e67-ec0e-5269-b67b-3fd99562c886" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523131}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1080e551-06cd-5714-8bdc-170d1f4b1992" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+2y &=0 \\\\ x+4y &=4\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n- **II.** The system is consistent independent\n- **III.** The system is inconsistent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 2 & 0 \\\\ 1 & 4 & 4\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & 0 \\\\ 1 & 4 & 4\\end{bmatrix} & {R}_{2}:={R}_{2}+(-1){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 2 & 0 \\\\ 0 & 2 & 4\\end{bmatrix}\\end{aligned}\n$$\n\nThere is a pivot for each variable and no contradictory row. The system has a unique solution, so we conclude that the system is consistent independent.\n\nAs a result, only statement II is true."} {:db/id #edb/ref 17592186523112 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e065480-c3c7-5a97-80dd-f851baccc4cd" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523108} {:answer/id #uuid "63fa15da-a612-551e-bc84-28195f146d91" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523135}] :answer-field/correct {:db/id #edb/ref 17592186523135} :answer-field/id #uuid "95720269-0a64-5442-8ea6-fada3caa3f3d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523154} {:answer-field/choices [{:answer/id #uuid "a075d6f9-6a6b-521c-9a45-cefd6406a87f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523157} {:answer/id #uuid "a3d89df8-a864-501a-978f-d1b4c908a594" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523159}] :answer-field/correct {:db/id #edb/ref 17592186523157} :answer-field/id #uuid "d4f4634b-41cc-5f87-b51b-46f0fed4e546" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523175} {:answer-field/choices [{:answer/id #uuid "c51d359e-c96e-568d-a08a-cc6a5975c003" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523169} {:answer/id #uuid "d80969b7-edb9-54aa-9415-47b2ca6fa4d6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523176}] :answer-field/correct {:db/id #edb/ref 17592186523176} :answer-field/id #uuid "da426b62-5fc6-56a5-92f1-825ae424ef78" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523179}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2c37a8ce-9961-58b3-83eb-74946c8f3663" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+2y-2z &=-4 \\\\ x+3y &=-8 \\\\ x+y-4z &=-3\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent independent\n- **II.** The system is consistent dependent\n- **III.** The system is inconsistent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 2 & -2 & -4 \\\\ 1 & 3 & 0 & -8 \\\\ 1 & 1 & -4 & -3\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & -2 & -4 \\\\ 1 & 3 & 0 & -8 \\\\ 1 & 1 & -4 & -3\\end{bmatrix} & {R}_{2}:={R}_{2}+(-1){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 2 & -2 & -4 \\\\ 0 & 1 & 2 & -4 \\\\ 1 & 1 & -4 & -3\\end{bmatrix} & {R}_{3}:={R}_{3}+(-1){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 2 & -2 & -4 \\\\ 0 & 1 & 2 & -4 \\\\ 0 & -1 & -2 & 1\\end{bmatrix} & {R}_{3}:={R}_{3}+(1){R}_{2} \\\\ & ∼\\begin{bmatrix}1 & 2 & -2 & -4 \\\\ 0 & 1 & 2 & -4 \\\\ 0 & 0 & 0 & -3\\end{bmatrix}\\end{aligned}\n$$\n\nThe final row corresponds to the equation $0x+0y+0z=-3,$ and this has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, only statement III is true."} {:db/id #edb/ref 17592186523119 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92f5b3ce-9f77-555e-a32f-418bc4e4ae3e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523151} {:answer/id #uuid "9552d211-6758-511e-9dd2-695af0b42a16" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523153}] :answer-field/correct {:db/id #edb/ref 17592186523151} :answer-field/id #uuid "178e2ad7-57e9-5728-a5d6-b6e9f1ddc32e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523106} {:answer-field/choices [{:answer/id #uuid "1127203c-eb67-5f24-9963-9f6c74e2e286" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523102} {:answer/id #uuid "7b3c86e8-fe67-5803-979e-32951465e4ec" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523140}] :answer-field/correct {:db/id #edb/ref 17592186523102} :answer-field/id #uuid "8925e95f-c16a-5da9-bc62-4ffcfe2c9609" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523144} {:answer-field/choices [{:answer/id #uuid "b6f9e16b-ee78-5f24-a114-9509d560608d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523162} {:answer/id #uuid "ffb07647-4604-59aa-a0cf-ee179bfdcceb" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523191}] :answer-field/correct {:db/id #edb/ref 17592186523191} :answer-field/id #uuid "d98057d3-cab1-5021-9e07-c30835639d6d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523177}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "482e6d01-f9bf-525e-86f9-c527dca5de7f" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x-3y &=-5 \\\\ -2x+6y &=10\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n- **II.** The system is consistent independent\n- **III.** The system is inconsistent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & -3 & -5 \\\\ -2 & 6 & 10\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -3 & -5 \\\\ -2 & 6 & 10\\end{bmatrix} & {R}_{2}:={R}_{2}+(2){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & -3 & -5 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. Here there is one free variable, $y$. Therefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*.\n\nAs a result, only statement I is true."} {:db/id #edb/ref 17592186523120 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4094b2ed-2795-574f-9bb3-fb2c83ecb51c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523117} {:answer/id #uuid "5f0b8de0-9754-5abb-bbaa-1a2488a781e3" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523129}] :answer-field/correct {:db/id #edb/ref 17592186523117} :answer-field/id #uuid "25d63ecc-0162-52f1-8496-c91465d5168f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523109} {:answer-field/choices [{:answer/id #uuid "4b4a9eea-9608-50ab-9333-020c18e9ce1c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523121} {:answer/id #uuid "f60437e2-7dd6-546f-9828-b80e9f59a8e9" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523188}] :answer-field/correct {:db/id #edb/ref 17592186523121} :answer-field/id #uuid "2ddd758a-c236-567f-9e01-d88d008f82a6" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523114} {:answer-field/choices [{:answer/id #uuid "87d21643-01b3-5b36-833a-4904b0c0d2ef" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523143} {:answer/id #uuid "f4fe98d8-0f7b-5c9d-87ac-6ff411f4142c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523187}] :answer-field/correct {:db/id #edb/ref 17592186523187} :answer-field/id #uuid "8dc94f57-6ef6-5b16-95f9-1ae9415ced68" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523148}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "48bd3d4c-5e94-556e-bb2a-82b8de48db17" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+y+2z &=0 \\\\ -2x-y-7z &=-2 \\\\ 2x+11z &=4\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent independent\n- **II.** The system is inconsistent\n- **III.** The system is consistent dependent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 1 & 2 & 0 \\\\ -2 & -1 & -7 & -2 \\\\ 2 & 0 & 11 & 4\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 1 & 2 & 0 \\\\ -2 & -1 & -7 & -2 \\\\ 2 & 0 & 11 & 4\\end{bmatrix} & {R}_{2}:={R}_{2}+(2){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 1 & 2 & 0 \\\\ 0 & 1 & -3 & -2 \\\\ 2 & 0 & 11 & 4\\end{bmatrix} & {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 1 & 2 & 0 \\\\ 0 & 1 & -3 & -2 \\\\ 0 & -2 & 7 & 4\\end{bmatrix} & {R}_{3}:={R}_{3}+(2){R}_{2} \\\\ & ∼\\begin{bmatrix}1 & 1 & 2 & 0 \\\\ 0 & 1 & -3 & -2 \\\\ 0 & 0 & 1 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThere is a pivot for each variable and no contradictory row. The system has a unique solution, so we conclude that the system is consistent independent.\n\nAs a result, only statement I is true."} {:db/id #edb/ref 17592186523134 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1df67eee-8e7e-5eb7-ba3b-02df7c2b88d3" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523107} {:answer/id #uuid "edeeea6a-d422-56c3-b686-ec4bc3cfaaf5" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523182}] :answer-field/correct {:db/id #edb/ref 17592186523182} :answer-field/id #uuid "7506832c-a1c4-534a-b2e6-d51bb3a21471" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523138} {:answer-field/choices [{:answer/id #uuid "5f63a9e5-2946-52bc-8fdc-8b775647cf8b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523130} {:answer/id #uuid "613155d7-d7de-5a5a-91c3-ac538369b356" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523133}] :answer-field/correct {:db/id #edb/ref 17592186523130} :answer-field/id #uuid "ac0ae869-8ade-5317-96c1-5e22aec5b834" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523160} {:answer-field/choices [{:answer/id #uuid "53e8ac69-39e1-5dfb-b044-65b188ea3777" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523123} {:answer/id #uuid "912e1233-1f11-5ad2-85d3-0096b74affbb" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523150}] :answer-field/correct {:db/id #edb/ref 17592186523123} :answer-field/id #uuid "f44f1c65-b30b-551b-a69a-7f4cd3ad8965" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523184}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "636c60f0-5dc2-592a-9ada-f299790fa243" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+y+z &=5 \\\\ x+2y+2z &=7 \\\\ x+3y+5z &=8\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n- **II.** The system is consistent independent\n- **III.** The system is inconsistent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 1 & 1 & 5 \\\\ 1 & 2 & 2 & 7 \\\\ 1 & 3 & 5 & 8\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 1 & 1 & 5 \\\\ 1 & 2 & 2 & 7 \\\\ 1 & 3 & 5 & 8\\end{bmatrix} & {R}_{2}:={R}_{2}+(-1){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 1 & 1 & 5 \\\\ 0 & 1 & 1 & 2 \\\\ 1 & 3 & 5 & 8\\end{bmatrix} & {R}_{3}:={R}_{3}+(-1){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 1 & 1 & 5 \\\\ 0 & 1 & 1 & 2 \\\\ 0 & 2 & 4 & 3\\end{bmatrix} & {R}_{3}:={R}_{3}+(-2){R}_{2} \\\\ & ∼\\begin{bmatrix}1 & 1 & 1 & 5 \\\\ 0 & 1 & 1 & 2 \\\\ 0 & 0 & 2 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nThere is a pivot for each variable and no contradictory row. The system has a unique solution, so we conclude that the system is consistent independent.\n\nAs a result, only statement II is true."} {:db/id #edb/ref 17592186523146 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51be9dbd-7ee6-56c1-a547-5903d2a1b3e7" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523122} {:answer/id #uuid "f4d7767c-aca7-50f4-90dc-f407ea0d7a3f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523186}] :answer-field/correct {:db/id #edb/ref 17592186523186} :answer-field/id #uuid "996ab691-0a7b-56e9-804a-a2787a923077" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523156} {:answer-field/choices [{:answer/id #uuid "a23b4315-1a65-506a-8c02-738beed7aaa6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523158} {:answer/id #uuid "bb33e391-198c-5529-9d5b-397721de092c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523164}] :answer-field/correct {:db/id #edb/ref 17592186523158} :answer-field/id #uuid "d28f612b-3349-546c-9210-2a56396e5c6f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523173} {:answer-field/choices [{:answer/id #uuid "08e08fdf-8af3-5a6d-a236-96fcf159b0f9" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523095} {:answer/id #uuid "60e8b807-93c5-5642-bfc7-4739a9cf92c7" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523132}] :answer-field/correct {:db/id #edb/ref 17592186523095} :answer-field/id #uuid "f478684b-108b-505b-8b25-f8e1f9defb6d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523185}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8a8ea6cd-37c6-57a9-b6bb-655208ae0dae" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+2y-z &=1 \\\\ 2x+5y &=7 \\\\ -2x-3y+5z &=6\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is inconsistent\n- **II.** The system is consistent independent\n- **III.** The system is consistent dependent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 2 & -1 & 1 \\\\ 2 & 5 & 0 & 7 \\\\ -2 & -3 & 5 & 6\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & -1 & 1 \\\\ 2 & 5 & 0 & 7 \\\\ -2 & -3 & 5 & 6\\end{bmatrix} & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 2 & -1 & 1 \\\\ 0 & 1 & 2 & 5 \\\\ -2 & -3 & 5 & 6\\end{bmatrix} & {R}_{3}:={R}_{3}+(2){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 2 & -1 & 1 \\\\ 0 & 1 & 2 & 5 \\\\ 0 & 1 & 3 & 8\\end{bmatrix} & {R}_{3}:={R}_{3}+(-1){R}_{2} \\\\ & ∼\\begin{bmatrix}1 & 2 & -1 & 1 \\\\ 0 & 1 & 2 & 5 \\\\ 0 & 0 & 1 & 3\\end{bmatrix}\\end{aligned}\n$$\n\nThere is a pivot for each variable and no contradictory row. The system has a unique solution, so we conclude that the system is consistent independent.\n\nAs a result, only statement II is true."} {:db/id #edb/ref 17592186523149 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b71e9efd-4041-5353-b773-e73d4943b58e" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523163} {:answer/id #uuid "c040c9e9-b2b2-5290-9279-e6d8a22bf949" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523167}] :answer-field/correct {:db/id #edb/ref 17592186523167} :answer-field/id #uuid "0c161978-1b18-5f69-ab37-c6a064914aa4" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523097} {:answer-field/choices [{:answer/id #uuid "1070f3b9-edc1-598f-9822-27e3abfa3c58" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523100} {:answer/id #uuid "86e55745-a3ef-551c-a3b4-ce4d34f0d892" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523142}] :answer-field/correct {:db/id #edb/ref 17592186523100} :answer-field/id #uuid "8a48fbc9-4e49-5abc-8cad-5f489b22b567" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523145} {:answer-field/choices [{:answer/id #uuid "0ca331de-6d7a-5bec-913c-999c56c3d275" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523098} {:answer/id #uuid "768483dd-8204-52e1-a40b-ab97ef2fad60" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523139}] :answer-field/correct {:db/id #edb/ref 17592186523139} :answer-field/id #uuid "96339ae7-9e2a-597d-b5f3-d761fa172570" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523155}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8e31a150-29e9-5dea-94ac-a18aad26fe11" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+y &=1 \\\\ 2x+4y &=4\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n- **II.** The system is inconsistent\n- **III.** The system is consistent independent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 1 & 1 \\\\ 2 & 4 & 4\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 1 & 1 \\\\ 2 & 4 & 4\\end{bmatrix} & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 1 & 1 \\\\ 0 & 2 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nThere is a pivot for each variable and no contradictory row. The system has a unique solution, so we conclude that the system is consistent independent.\n\nAs a result, only statement III is true."} {:db/id #edb/ref 17592186523165 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56e13df2-cbbc-5122-a312-3d4718cfd2d5" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523126} {:answer/id #uuid "8ce05a37-3f4d-53ca-9976-cf02a4b3a3bb" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523147}] :answer-field/correct {:db/id #edb/ref 17592186523126} :answer-field/id #uuid "2629fa4f-103c-5153-9f74-91ca5c93439c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523110} {:answer-field/choices [{:answer/id #uuid "554b6c18-e491-5f95-965d-fa5a2bd9d88d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523125} {:answer/id #uuid "f97645eb-31df-5037-9f30-9be5b18f44ce" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523189}] :answer-field/correct {:db/id #edb/ref 17592186523189} :answer-field/id #uuid "5bacc81c-a202-5de7-91a7-ef4e2100ffe9" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523128} {:answer-field/choices [{:answer/id #uuid "1682be06-115f-54ff-a73b-9b589617e8f7" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523105} {:answer/id #uuid "27fd6cae-d564-59e2-aa3f-8a705ed55e02" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523111}] :answer-field/correct {:db/id #edb/ref 17592186523105} :answer-field/id #uuid "b680bc94-e35d-5672-8a29-61a6ce96c60b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523161}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bb7d6994-e998-58f7-aa63-248113b6349d" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+y &=4 \\\\ -x &=-8\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n- **II.** The system is consistent independent\n- **III.** The system is inconsistent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 1 & 4 \\\\ -1 & 0 & -8\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 1 & 4 \\\\ -1 & 0 & -8\\end{bmatrix} & {R}_{2}:={R}_{2}+(1){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 1 & 4 \\\\ 0 & 1 & -4\\end{bmatrix}\\end{aligned}\n$$\n\nThere is a pivot for each variable and no contradictory row. The system has a unique solution, so we conclude that the system is consistent independent.\n\nAs a result, only statement II is true."} {:db/id #edb/ref 17592186523181 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9392a4b7-e0c1-50c1-a200-9aea19b85ad8" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523152} {:answer/id #uuid "c54d1d3c-4700-5389-9521-819eca5efa3a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523170}] :answer-field/correct {:db/id #edb/ref 17592186523170} :answer-field/id #uuid "14a0dd8b-1651-52fe-a379-fa629f0b62ac" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523104} {:answer-field/choices [{:answer/id #uuid "bc35ea2c-b5fa-5a21-af8c-52f26ca8f62f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523166} {:answer/id #uuid "d9a8d720-eb68-5c11-a4f9-701068036d21" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523178}] :answer-field/correct {:db/id #edb/ref 17592186523166} :answer-field/id #uuid "2f23ed57-d37c-5347-b6fc-2f6d63d7a37b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523115} {:answer-field/choices [{:answer/id #uuid "7fa07bf6-b3cb-5d2d-8a9f-a191e0b6e0f5" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523141} {:answer/id #uuid "c5a5ef39-054c-5b8e-b9af-e036a4693bb2" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523171}] :answer-field/correct {:db/id #edb/ref 17592186523141} :answer-field/id #uuid "c354c352-0b95-52ed-8029-4f2c45821f10" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523168}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ec9855f3-8df8-5de8-aa96-4a294a867b64" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x-3y-3z &=5 \\\\ 2x-5y-9z &=10 \\\\ 2x-5y-9z &=10\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n- **II.** The system is inconsistent\n- **III.** The system is consistent independent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & -3 & -3 & 5 \\\\ 2 & -5 & -9 & 10 \\\\ 2 & -5 & -9 & 10\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -3 & -3 & 5 \\\\ 2 & -5 & -9 & 10 \\\\ 2 & -5 & -9 & 10\\end{bmatrix} & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & -3 & -3 & 5 \\\\ 0 & 1 & -3 & 0 \\\\ 2 & -5 & -9 & 10\\end{bmatrix} & {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & -3 & -3 & 5 \\\\ 0 & 1 & -3 & 0 \\\\ 0 & 1 & -3 & 0\\end{bmatrix} & {R}_{3}:={R}_{3}+(-1){R}_{2} \\\\ & ∼\\begin{bmatrix}1 & -3 & -3 & 5 \\\\ 0 & 1 & -3 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. Here there is one free variable, $z$. Therefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*.\n\nAs a result, only statement I is true."} {:db/id #edb/ref 17592186523190 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "652676ed-c325-50b3-9370-c0907c671f47" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523136} {:answer/id #uuid "f3e7efd8-3b15-55b0-a40f-7c34b7c76512" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523183}] :answer-field/correct {:db/id #edb/ref 17592186523183} :answer-field/id #uuid "04645717-bac8-5e0f-80de-5dc8a6e34e04" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523093} {:answer-field/choices [{:answer/id #uuid "0a148d48-fb64-5d16-b8f9-19a6596fe811" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523096} {:answer/id #uuid "3abd678a-230b-520d-a0dd-63dc44fa005b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523116}] :answer-field/correct {:db/id #edb/ref 17592186523096} :answer-field/id #uuid "cfcb9672-726a-595a-b7dd-19a4952a0aab" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523172} {:answer-field/choices [{:answer/id #uuid "0fcc01c5-0bb3-5828-940a-30086cb2d945" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523099} {:answer/id #uuid "d3e45317-561e-5c27-9374-58cfdb78546e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523174}] :answer-field/correct {:db/id #edb/ref 17592186523174} :answer-field/id #uuid "dc3eaf4f-09ba-503b-a672-da707e643826" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186523180}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fe67b029-391e-51be-a295-1e535d93c516" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-3 \\\\ -2x-4y &=3\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent independent\n- **II.** The system is consistent dependent\n- **III.** The system is inconsistent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 2 & -3 \\\\ -2 & -4 & 3\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & -3 \\\\ -2 & -4 & 3\\end{bmatrix} & {R}_{2}:={R}_{2}+(2){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 2 & -3 \\\\ 0 & 0 & -3\\end{bmatrix}\\end{aligned}\n$$\n\nThe final row corresponds to the equation $0x+0y=-3,$ and this has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, only statement III is true."}] :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent"}] :topic/math-academy-id 1733 :topic/next [{:db/id #edb/ref 17592186048181} {:db/id #edb/ref 17592186048315}] :topic/title "Gaussian Elimination For NxM Systems of Equations"}
