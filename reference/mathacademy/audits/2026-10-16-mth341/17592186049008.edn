 1 & 0\\end{bmatrix}$\nand \n$B=\\begin{bmatrix}4\\sqrt{2} & 1.5 & 2 \\\\ -3.5 & -2\\sqrt{3} & -3 \\\\ 1 & 4 & -\\sqrt{5}\\end{bmatrix}.$" :question/worked-solution "Notice that $A$ is the $2$nd *row* of the identity matrix ${I}_{3}.$\n\nSince we're multiplying the $3\\times 3$ matrix $B$ by the $2$nd *row* of the identity matrix ${I}_{3}$ on the *left*, the result must be the $2$nd *row* of $B.$ Therefore,\n\n$$\nAB=\\begin{bmatrix}-3.5 & -2\\sqrt{3} & -3\\end{bmatrix}.\n$$\n\nLet's check the long way:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}0 & 1 & 0\\end{bmatrix}\\begin{bmatrix}4\\sqrt{2} & 1.5 & 2 \\\\ -3.5 & -2\\sqrt{3} & -3 \\\\ 1 & 4 & -\\sqrt{5}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3.5 & -2\\sqrt{3} & -3\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186392435 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cd465a5-2228-506e-85ae-bca8f7b15782" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 \\\\ -3.5 \\\\ -4\\sqrt{5}\\end{bmatrix}" :db/id #edb/ref 17592186392437} {:answer/id #uuid "89c7f214-2178-5237-aa70-418be548a79a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 \\\\ 3\\sqrt{2} \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186392438} {:answer/id #uuid "b9584a78-324d-5402-b9dd-9340417fbdbe" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 & 3\\sqrt{2} & 2\\end{bmatrix}" :db/id #edb/ref 17592186392439} {:answer/id #uuid "9dfc011c-f3fc-50b6-918e-d5e364adfbb2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\sqrt{3} \\\\ -5 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186392440} {:answer/id #uuid "f8d7fd08-e9dc-5175-be41-5413c7de1648" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\sqrt{3} & -5 & 1\\end{bmatrix}" :db/id #edb/ref 17592186392441}] :answer-field/correct {:db/id #edb/ref 17592186392437} :answer-field/id #uuid "04d1601d-b94a-56ad-af90-0c952d160d14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186392436}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7d52bfbe-0cf7-5e74-a083-e7db8c4ef851" :question/math-academy-id "q-41943" :question/problem "Find the product $AB$, if\n$A=\\begin{bmatrix}\\sqrt{3} & -5 & 5 \\\\ -5 & 3\\sqrt{2} & -3.5 \\\\ 1 & 2 & -4\\sqrt{5}\\end{bmatrix}$\nand \n$B=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}.$" :question/worked-solution "Notice that $B$ is the $3$rd *column* of the identity matrix ${I}_{3}.$\n\nSince we're multiplying the $3\\times 3$ matrix $A$ by the $3$rd *column* of the identity matrix ${I}_{3}$, the result must be the $3$rd column of $A.$ Therefore,\n\n$$\nAB=\\begin{bmatrix}5 \\\\ -3.5 \\\\ -4\\sqrt{5}\\end{bmatrix}.\n$$\n\n \n\nLet's check the long way:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}\\sqrt{3} & -5 & 5 \\\\ -5 & 3\\sqrt{2} & -3.5 \\\\ 1 & 2 & -4\\sqrt{5}\\end{bmatrix}\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\sqrt{3}\\cdot 0+(-5)\\cdot 0+5\\cdot 1 \\\\ (-5)\\cdot 0+3\\sqrt{2}\\cdot 0+(-3.5)\\cdot 1 \\\\ 1\\cdot 0+2\\cdot 0+(-4\\sqrt{5})\\cdot 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 \\\\ -3.5 \\\\ -4\\sqrt{5}\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186546081 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec7d074d-2270-524e-b0e7-6a77e20c0f41" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186546093}] :answer-field/correct {:db/id #edb/ref 17592186546093} :answer-field/id #uuid "21f1ed21-666d-5f0c-b799-c6a14887256f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186546082} {:answer-field/choices [{:answer/id #uuid "69bdaeef-02b5-5b7a-a5a0-687c66364d69" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186546087}] :answer-field/correct {:db/id #edb/ref 17592186546087} :answer-field/id #uuid "5e2d02d6-09ee-5014-aac8-8438944d2467" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186546086} {:answer-field/choices [{:answer/id #uuid "a9124733-c34c-585c-bb51-b04bcc7ca5a2" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186546090}] :answer-field/correct {:db/id #edb/ref 17592186546090} :answer-field/id #uuid "e5b84dd4-e476-5bc8-9f61-955e858415b2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186546092}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "03f9a283-ab45-59cd-b539-75cdc65061b6" :question/problem "Find the product $AB,$ if\n$A=\\begin{bmatrix}2\\sqrt{13} & -3 & 6 \\\\ 3 & \\sqrt{3} & -1 \\\\ 7 & -1 & 0\\end{bmatrix}$\nand \n$B=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}.$\n\n|  |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n| $AB=\\,\\,$ |  | {{field-2}} |  |\n|  |  | {{field-3}} |  |" :question/worked-solution "Notice that $B$ is the $2$nd *column* of the identity matrix ${I}_{3}.$\n\nSince we're multiplying the $3\\times 3$ matrix $A$ by the $2$nd *column* of the identity matrix ${I}_{3},$ the result must be the $2$nd *column* of $A.$ Therefore,\n\n$$\nAB=\\begin{bmatrix}-3 \\\\ \\sqrt{3} \\\\ -1\\end{bmatrix}.\n$$\n\nLet's check the long way:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}2\\sqrt{13} & -3 & 6 \\\\ 3 & \\sqrt{3} & -1 \\\\ 7 & -1 & 0\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\sqrt{13}\\cdot 0+(-3)\\cdot 1+6\\cdot 0 \\\\ 3\\cdot 0+\\sqrt{3}\\cdot 1+(-1)\\cdot 0 \\\\ 7\\cdot 0+(-1)\\cdot 1+0\\cdot 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 \\\\ \\sqrt{3} \\\\ -1\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186546083 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "346a9c36-9c70-5a26-a683-b26b85be243e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 2\\sqrt{11} \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186546084} {:answer/id #uuid "59c9f45b-de24-5684-9e28-4baa92ba5926" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3\\sqrt{6} & 6 & 9\\end{bmatrix}" :db/id #edb/ref 17592186546085} {:answer/id #uuid "8a367c8b-e09a-5e10-8f5d-0a988ff5dc84" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3\\sqrt{10} & -1 & 4.6\\end{bmatrix}" :db/id #edb/ref 17592186546088} {:answer/id #uuid "8e5b5143-6112-5bdb-a30c-e60d12cefc73" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4.6 \\\\ -1.7 \\\\ 9\\end{bmatrix}" :db/id #edb/ref 17592186546089} {:answer/id #uuid "c22141b6-ad0a-5d40-b9aa-254caa95396e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3\\sqrt{10} \\\\ -4 \\\\ 3\\sqrt{6}\\end{bmatrix}" :db/id #edb/ref 17592186546091}] :answer-field/correct {:db/id #edb/ref 17592186546089} :answer-field/id #uuid "fa2cb576-db76-5f72-8574-1fafaae20058" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186546094}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2d472ae0-7d53-527e-b3ef-7cd75481083e" :question/problem "Find the product $AB$, if\n$A=\\begin{bmatrix}3\\sqrt{10} & -1 & 4.6 \\\\ -4 & 2\\sqrt{11} & -1.7 \\\\ 3\\sqrt{6} & 6 & 9\\end{bmatrix}$\nand \n$B=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}.$" :question/worked-solution "Notice that $B$ is the $3$rd *column* of the identity matrix ${I}_{3}.$\n\nSince we're multiplying the $3\\times 3$ matrix $A$ by the $3$rd *column* of the identity matrix ${I}_{3},$ the result must be the $3$rd *column* of $A.$ Therefore,\n\n$$\nAB=\\begin{bmatrix}4.6 \\\\ -1.7 \\\\ 9\\end{bmatrix}.\n$$\n\nLet's check the long way:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}3\\sqrt{10} & -1 & 4.6 \\\\ -4 & 2\\sqrt{11} & -1.7 \\\\ 3\\sqrt{6} & 6 & 9\\end{bmatrix}\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3\\sqrt{10}\\cdot 0+(-1)\\cdot 0+4.6\\cdot 1 \\\\ (-4)\\cdot 0+2\\sqrt{11}\\cdot 0+(-1.7)\\cdot 1 \\\\ 3\\sqrt{6}\\cdot 0+6\\cdot 0+9\\cdot 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4.6 \\\\ -1.7 \\\\ 9\\end{bmatrix}\\end{aligned}\n$$"}] :knowledge-point/title "Multiplying a Matrix by a Column or Row of the Identity Matrix"} :step/id #uuid "2a8c2469-c4d7-571d-a243-2cf1fe09ed32" :step/math-academy-id 16194 :step/next {:db/id #edb/ref 17592186101699}} {:db/id #edb/ref 17592186101699 :step/content {:db/id #edb/ref 17592186101965 :tutorial/content "We've been using the fact that $AI_n = I_n A = A$ for any $n \\times n$ matrix $A.$ But how do we know for sure?\n\nLet's prove the case of $n=2.$ That is, let's prove that $AI_2=I_2A = A,$ where $A$ is any $2\\times2$ matrix.\n\nAny general $2 \\times 2$ matrix can be written as\n$\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$ \n\nThen, multiplying by $I_2,$ we have\n\n$$\n\\begin{aligned}A{I}_{2} & =\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}{a}_{11}\\cdot 1+{a}_{12}\\cdot 0 & {a}_{11}\\cdot 0+{a}_{12}\\cdot 1 \\\\ {a}_{21}\\cdot 1+{a}_{22}\\cdot 0 & {a}_{21}\\cdot 0+{a}_{22}\\cdot 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix} \\\\  & =A.\\end{aligned}\n$$\n\nSimilarly,\n\n$$\n\\begin{aligned}{I}_{2}A & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix} \\\\  & =\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix} \\\\  & =A.\\end{aligned}\n$$\n\nThe above proof shows that the property $A I_2 = I_2 A = A$ holds for all $2\\times2$ matrices $A.$\n\nIn general, to prove that the property $AI_n = I_n A = A$ holds for all $n \\times n$ matrices $A,$ we can use the same method." :tutorial/id #uuid "4c2408f2-4c4d-5bc6-bd0c-e649f5e542f1" :tutorial/math-academy-id 3132 :tutorial/title "Proving Properties Related to the Identity Matrix"} :step/id #uuid "acbf3f49-a158-5e75-b433-69f7dd172d90" :step/math-academy-id 17078}] :activity/title "Multiplying a Matrix by the Identity Matrix" :activity/type {:db/id #edb/ref 17592186045463} :db/id #edb/ref 17592186101038}] :db/id #edb/ref 17592186049008 :topic/difficulty 0.8673597118242108 :topic/id #uuid "d30fd98e-7cc3-5d03-98e7-14f311f99f96" :topic/knowledge-points [{:db/id #edb/ref 17592186100875 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100696 :question/id #uuid "f7868f7f-b296-5a38-9af6-61dc4d1198a7" :question/math-academy-id "e-4408" :question/problem "Calculate the product $I_3 B$ given that $I_3$ is the $3 \\times 3$ identity matrix and\n![](images/9b/9b8d8f439845a4949789fe313997d2245249e1a4df58c750d7cda0af36f1ce18.png)" :question/worked-solution "Any matrix, when multiplied by an identity matrix, remains unchanged (assuming that the multiplication is well defined).\n\nThe matrix $I_3$ is a $3 \\times 3$ matrix and $B$ is a $3 \\times 3$ matrix too. \n\nTherefore, the multiplication is well defined and \n![](images/ac/ac591cf90fae6e8275fed52c26c8487bff9d654733d414974631948fe30b8150.png)"} :knowledge-point/id #uuid "1f2f5234-df9c-5269-8702-30b4dde9a2ca" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048297}] :knowledge-point/question-generator {:db/id #edb/ref 17592186539285 :question-generator/id #uuid "744d4524-65a7-5e50-bc2e-dccc85dd98bd" :question-generator/script "generate/scratch/17592186100875.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186101141 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3819a4e-2124-51a9-966d-a232f795727b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & -3 \\\\ -1 & -2\\end{bmatrix}" :db/id #edb/ref 17592186388506} {:answer/id #uuid "e5497e19-b13b-5352-a486-89ae75f2fe36" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 3 \\\\ 1 & 2\\end{bmatrix}" :db/id #edb/ref 17592186388507} {:answer/id #uuid "1524532d-303c-57e8-baaa-e00f625a908a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388508} {:answer/id #uuid "f505e5ac-8344-5745-ab05-6ca6bf802e47" :answer/type {:db/ident :answer.type/text} :answer/value "The product is undefined" :db/id #edb/ref 17592186388509} {:answer/id #uuid "5e6230bd-503c-59b4-8461-692f556f4ea7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186388510}] :answer-field/correct {:db/id #edb/ref 17592186388507} :answer-field/id #uuid "4bf67a40-3ab5-50a6-9561-e2ee6d875a8b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186388505}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "612ed9a2-f644-5c99-b797-cab8e5ee69a6" :question/math-academy-id "q-13762" :question/problem "Calculate the product ${I}_{2}B$ given that ${I}_{2}$ is the $2\\times 2$ identity matrix and\n$B=\\begin{bmatrix}2 & 3 \\\\ 1 & 2\\end{bmatrix}.$" :question/worked-solution "Any matrix, when multiplied by an identity matrix, remains unchanged (assuming that the multiplication is well defined).\n\nThe matrix ${I}_{2}$ is a $2\\times 2$ matrix and $B$ is a $2\\times 2$ matrix too. \n\nTherefore, the multiplication is well defined and \n\n$$\n{I}_{2}\\cdot B=B=\\begin{bmatrix}2 & 3 \\\\ 1 & 2\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186101142 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90412f20-4e0b-5b47-9010-888ec3e2cb1e" :answer/type {:db/ident :answer.type/text} :answer/value "The product is undefined" :db/id #edb/ref 17592186098188} {:answer/id #uuid "edf67f8b-9d4a-5747-aaa1-0833598f0c2e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186098189} {:answer/id #uu