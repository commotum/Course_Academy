592186045485} :question/id #uuid "5e98fc7f-ef14-5532-a9c9-d1ad1e092ab6" :question/math-academy-id "q-337655" :question/problem "Calculate the product ${I}_{3}B$ given that ${I}_{3}$ is the $3\\times 3$ identity matrix and\n$B=\\begin{bmatrix}4 & -1 & 3 \\\\ 2 & 0 & -6 \\\\ -5 & 7 & 1\\end{bmatrix}.$\n\n|  |  | {{field-1}} | {{field-2}} | {{field-3}} |  |\n| --- | --- | --- | --- | --- | --- |\n| ${I}_{3}\\cdot B=\\,\\,$ |  | {{field-4}} | {{field-5}} | {{field-6}} |  |\n|  |  | {{field-7}} | {{field-8}} | {{field-9}} |  |" :question/worked-solution "Any matrix, when multiplied by an identity matrix, remains unchanged (assuming that the multiplication is well defined).\n\nThe matrix $B$ is a $3\\times 3$ matrix and ${I}_{3}$ is a $3\\times 3$ matrix too. \n\nTherefore, the multiplication is well defined and \n\n$$\n{I}_{3}\\cdot B=B=\\begin{bmatrix}4 & -1 & 3 \\\\ 2 & 0 & -6 \\\\ -5 & 7 & 1\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186345087 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "005d0dc0-c679-52c6-abbc-b50e1a9c606d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 2 \\\\ 5 & 2\\end{bmatrix}" :db/id #edb/ref 17592186342245} {:answer/id #uuid "1bade1d0-68d0-5f74-9071-e51229d51e1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 & 2 \\\\ 2 & -5\\end{bmatrix}" :db/id #edb/ref 17592186342473} {:answer/id #uuid "23ad34dd-4dce-5431-b238-8e2f933f2ad9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & -2 \\\\ -2 & 5\\end{bmatrix}" :db/id #edb/ref 17592186342535} {:answer/id #uuid "24307cfa-00ed-5caf-8cf9-ec8ae54f022f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 2 \\\\ 2 & 5\\end{bmatrix}" :db/id #edb/ref 17592186342544} {:answer/id #uuid "d8d586e1-9945-5f53-ab4a-d3dcc0dca9aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & -5 \\\\ 2 & -5\\end{bmatrix}" :db/id #edb/ref 17592186344142}] :answer-field/correct {:db/id #edb/ref 17592186342473} :answer-field/id #uuid "f8c0cc2e-b502-5e16-85dd-960d484ba8bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344929}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "062bb064-038f-55e1-92f0-0d30d2ec231e" :question/math-academy-id "q-75472" :question/problem "Calculate the product ${I}_{2}G$ given that ${I}_{2}$ is the $2\\times 2$ identity matrix and\n$G=\\begin{bmatrix}-5 & 2 \\\\ 2 & -5\\end{bmatrix}.$" :question/worked-solution "Any matrix, when multiplied by an identity matrix, remains unchanged (assuming that the multiplication is well defined).\n\nThe matrix ${I}_{2}$ is a $2\\times 2$ matrix and $G$ is a $2\\times 2$ matrix too. \n\nTherefore, the multiplication is well defined and \n\n$$\n{I}_{2}\\cdot G=G=\\begin{bmatrix}-5 & 2 \\\\ 2 & -5\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186345088 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "100dd380-18b7-591d-be6c-89c73e6809d6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 0 \\\\ -2 & -3\\end{bmatrix}" :db/id #edb/ref 17592186342377} {:answer/id #uuid "515f51d6-c508-5850-8fe3-dab670b624f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ -2 & 3\\end{bmatrix}" :db/id #edb/ref 17592186342911} {:answer/id #uuid "858cdfc9-2899-58cb-913d-c588d6653820" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 0 \\\\ 2 & -1\\end{bmatrix}" :db/id #edb/ref 17592186343383} {:answer/id #uuid "d3c49d8f-10f4-5a31-b6c4-c1e8fc3eb675" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -1 \\\\ -2 & -3\\end{bmatrix}" :db/id #edb/ref 17592186344098} {:answer/id #uuid "f8a18937-b3a8-5fc5-ab9f-9c054f7cba2a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 0 \\\\ 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186344426}] :answer-field/correct {:db/id #edb/ref 17592186342377} :answer-field/id #uuid "15858fcb-aa80-596c-a531-08e6c8a9a97c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344528}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ae364f6e-5a7d-5d28-b89b-7967cff2127c" :question/math-academy-id "q-75473" :question/problem "Calculate the product $J{I}_{2}$ given that ${I}_{2}$ is the $2\\times 2$ identity matrix and\n$J=\\begin{bmatrix}-1 & 0 \\\\ -2 & -3\\end{bmatrix}.$" :question/worked-solution "Any matrix, when multiplied by an identity matrix, remains unchanged (assuming that the multiplication is well defined).\n\nThe matrix $J$ is a $2\\times 2$ matrix and ${I}_{2}$ is a $2\\times 2$ matrix too. \n\nTherefore, the multiplication is well defined and \n\n$$\nJ\\cdot {I}_{2}=J=\\begin{bmatrix}-1 & 0 \\\\ -2 & -3\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186345089 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1af7b4f8-081c-5e0b-ae6a-b65d12501a79" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-7 & 7 \\\\ 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186342469} {:answer/id #uuid "715a5bd0-851f-5031-99d4-7869655ed741" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 \\\\ -7 & 7\\end{bmatrix}" :db/id #edb/ref 17592186343212} {:answer/id #uuid "80390ed8-36f0-5743-838c-4f9bd95e7801" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & -7 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186343342} {:answer/id #uuid "96d67d0a-cc2b-5247-804f-abeb71ea487e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-7 & 7 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186343557} {:answer/id #uuid "aeb40ec1-447b-57f4-999a-a671b6825db9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-7 & 7 \\\\ 1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186343774}] :answer-field/correct {:db/id #edb/ref 17592186343342} :answer-field/id #uuid "14205708-8ff3-5fa8-9eb8-23be718d348d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344527}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e7cd9fb4-2876-5e19-b299-1938e7390f38" :question/math-academy-id "q-75479" :question/problem "Calculate the product $Q{I}_{2}$ given that ${I}_{2}$ is the $2\\times 2$ identity matrix and\n$Q=\\begin{bmatrix}7 & -7 \\\\ 0 & 1\\end{bmatrix}.$" :question/worked-solution "Any matrix, when multiplied by an identity matrix, remains unchanged (assuming that the multiplication is well defined).\n\nThe matrix $Q$ is a $2\\times 2$ matrix and ${I}_{2}$ is a $2\\times 2$ matrix too. \n\nTherefore, the multiplication is well defined and \n\n$$\nQ\\cdot {I}_{2}=Q=\\begin{bmatrix}7 & -7 \\\\ 0 & 1\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186393535 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dd4048bd-c9fc-58bc-85a9-fa6ee2d8ec2b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 5 & 6 \\\\ 3 & 2 & 1 \\\\ -1 & 2 & -3\\end{bmatrix}" :db/id #edb/ref 17592186393537} {:answer/id #uuid "f10797c4-7b7c-554a-bc06-d36b649490ac" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 & 6 \\\\ 3 & 2 & 1 \\\\ 4 & 5 & -3\\end{bmatrix}" :db/id #edb/ref 17592186393538} {:answer/id #uuid "c82d547a-10f8-58eb-92f2-1b5b12006cb2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 5 & 6 \\\\ 4 & 5 & 6 \\\\ 4 & 5 & 6\\end{bmatrix}" :db/id #edb/ref 17592186393539} {:answer/id #uuid "dbf9276b-4afd-5283-aee0-85c974e49bba" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 4 & 6 \\\\ 2 & 3 & 1 \\\\ 2 & -1 & -3\\end{bmatrix}" :db/id #edb/ref 17592186393540} {:answer/id #uuid "b723c812-ba14-5f39-9709-b2ac9879e329" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 2 & -3 \\\\ 3 & 2 & 1 \\\\ 4 & 5 & 6\\end{bmatrix}" :db/id #edb/ref 17592186393541}] :answer-field/correct {:db/id #edb/ref 17592186393537} :answer-field/id #uuid "953bbaf6-0705-557f-84cb-45da3a319c9c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393536}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "64bbd1d6-4392-5158-946b-c984a6aea3c7" :question/math-academy-id "q-75474" :question/problem "Calculate the product ${I}_{3}K$ given that ${I}_{3}$ is the $3\\times 3$ identity matrix and\n$K=\\begin{bmatrix}4 & 5 & 6 \\\\ 3 & 2 & 1 \\\\ -1 & 2 & -3\\end{bmatrix}.$" :question/worked-solution "Any matrix, when multiplied by an identity matrix, remains unchanged (assuming that the multiplication is well defined).\n\nThe matrix ${I}_{3}$ is a $3\\times 3$ matrix and $K$ is a $3\\times 3$ matrix too. \n\nTherefore, the multiplication is well defined and \n\n$$\n{I}_{3}\\cdot K=K=\\begin{bmatrix}4 & 5 & 6 \\\\ 3 & 2 & 1 \\\\ -1 & 2 & -3\\end{bmatrix}.\n$$"}] :knowledge-point/title "Multiplying a Matrix by the Identity Matrix"} :step/id #uuid "c7473014-2f99-59a1-b6cb-a5a8ad7926aa" :step/math-academy-id 16191 :step/next {:db/id #edb/ref 17592186101685}} {:db/id #edb/ref 17592186101685 :step/content {:db/id #edb/ref 17592186101962 :tutorial/content "Whenever we multiply a matrix $A$ by the $n$th column of the identity matrix, the result is the $n$th column of $A.$\n\nFor example, consider the matrix\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}3 & -1 \\\\ 1 & 2\\end{bmatrix}$</div>\n</div>\n\nThe first column of the identity matrix $I_2$ is given by\n\n$$\n\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\n$$\n\nIf we multiply $A$ by the column on the *right*, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}3 & -1 \\\\ 1 & 2\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix} & =\\begin{bmatrix}3\\cdot 1+(-1)\\cdot 0 \\\\ 1\\cdot 1+2\\cdot 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nThe product is just the first column of the matrix $A.$\n\nUsing the same method, you can check for yourself that when we multiply $A$ by the second column of $I_2,$ the result is the second column of $A.$\n\nOn the other hand, if we multiply $A$ by the first *row* of the identity matrix $I_2$ on the *left*, we will obtain the first row of $A$. Indeed,\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & 0\\end{bmatrix}\\begin{bmatrix}3 & -1 \\\\ 1 & 2\\end{bmatrix} & =\\begin{bmatrix}3\\cdot 1+1\\cdot 0 & (-1)\\cdot 1+2\\cdot 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & -1\\end{bmatrix}.\\end{aligned}\n$$" :tutorial/id #uuid "2c46b879-fe8a-5f8e-8579-71b1bc92ac07" :tutorial/math-academy-id 2996 :tutorial/title "Multiplying a Matrix by a Column of the Identity Matrix"} :step/id #uuid "3cad7c8a-e8e1-5ac0-bdff-f4886c348fb7" :step/math-academy-id 16193 :step/next {:db/id #edb/ref 17592186101686}} {:db/id #edb/ref 17592186101686 :step/content {:db/id #edb/ref 17592186100876 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100697 :question/id #uuid "9832238f-baff-5527-a11a-c65b6529cb0b" :question/math-academy-id "e-4410" :question/problem "Calculate the product $C D,$ if\n![](images/94/945664c408577aac1d1a745120b3c17c46fd9db93e6d26cc53a4e501390936e2.png)\nand \n![](images/90/907ffa0b29d96249fe03a7fce3fe682c08982b14c7b7f72840540e6269196425.png)" :question/worked-solution "Notice that $D$ is the $2$nd *column* of the identity matrix $I_3.$\n\nSince we're multiplying the $3\\times 3$ matrix $C$ by the $2$nd *column* of the identity matrix $I_3,$ the result must be the $2$nd *column* of $C.$ Therefore,\n\n![](images/98/980ae75452824b4a8aa701b4e11be8c31448557933357458329f0a2b73a1cca6.png)\n\nDon't believe it? Let's check the long way:\n\n$$\n\\begin{aligned}CD & =\\begin{bmatrix}2 & 1 & 0 \\\\ -1 & 1 & -4 \\\\ 5 & 4 & -2\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\cdot 0+1\\cdot 1+0\\cdot 0 \\\\ -1\\cdot 0+1\\cdot 1+(-4)\\cdot 0 \\\\ 5\\cdot 0+4\\cdot 1+(-2)\\cdot 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 1 \\\\ 4\\end{bmatrix}\\end{aligned}\n$$"} :knowledge-point/id #uuid "89362140-1a17-56fd-a9ab-4da336112bee" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050825}] :knowledge-point/question-generator {:db/id #edb/ref 17592186546095 :question-generator/id #uuid "f90de4b9-eae0-5d75-89ef-ff61bc2ec28a" :question-generator/script "generate/scratch/17592186100876.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186101407 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e77b0e35-b8ea-5618-ab6c-8503315df0e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3.5 \\\\ -2.5 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186392443} {:answer/id #uuid "b90bbe8b-d8e5-5080-9aa2-4142743a4b96" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2\\sqrt{7} \\\\ -2 \\\\ \\sqrt{3}\\end{bmatrix}" :db/id #edb/ref 17592186392444} {:answer/id #uuid "6b52aa96-4f70-58ea-b2cf-28f779b7b43b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & 2\\sqrt{5} & -2.5\\end{bmatrix}" :db/id #edb/ref 17592186392445} {:answer/id #uuid "d06d67b6-8acb-58a8-957c-d55d012736a4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ 2\\sqrt{5} \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186392446} {:answer/id #uuid "e47cb90f-8189-59b3-96b0-469513eb54fc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2\\sqrt{7} & -3 & 3.5\\end{bmatrix}" :db/id #edb/ref 17592186392447}] :answer-field/correct {:db/id #edb/ref 17592186392444} :answer-field/id #uuid "3cb1f592-094a-5b91-bac8-80971fe96ac3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186392442}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bde0cdd0-7dbe-5ba4-9b36-e66cfe099501" :question/math-academy-id "q-41949" :question/problem "Find the product $AB$, if\n$A=\\begin{bmatrix}2\\sqrt{7} & -3 & 3.5 \\\\ -2 & 2\\sqrt{5} & -2.5 \\\\ \\sqrt{3} & 4 & 5\\end{bmatrix}$\nand \n$B=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}.$" :question/worked-solution "Notice that $B$ is the $1$st *column* of the identity matrix ${I}_{3}.$\n\nSince we're multiplying the $3\\times 3$ matrix $A$ by the $1$st *column* of the identity matrix ${I}_{3},$ the result must be the $1$st *column* of $A.$ Therefore,\n\n$$\nAB=\\begin{bmatrix}2\\sqrt{7} \\\\ -2 \\\\ \\sqrt{3}\\end{bmatrix}.\n$$\n\nLet's check the long way:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}2\\sqrt{7} & -3 & 3.5 \\\\ -2 & 2\\sqrt{5} & -2.5 \\\\ \\sqrt{3} & 4 & 5\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\sqrt{7}\\cdot 1+(-3)\\cdot 0+3.5\\cdot 0 \\\\ (-2)\\cdot 1+2\\sqrt{5}\\cdot 0+(-2.5)\\cdot 0 \\\\ \\sqrt{3}\\cdot 1+4\\cdot 0+5\\cdot 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\sqrt{7} \\\\ -2 \\\\ \\sqrt{3}\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186101408 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be5f5e04-2f01-53f2-8591-c58133cd71f3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ -3 \\\\ \\sqrt{5}\\end{bmatrix}" :db/id #edb/ref 17592186099610} {:answer/id #uuid "cea56a00-7b9a-582e-bb36-014f084a08d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 & -\\sqrt{3}\\end{bmatrix}" :db/id #edb/ref 17592186099611} {:answer/id #uuid "19e549cb-f70f-5feb-a295-b0871f09f0a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\sqrt{3} \\\\ -3.2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186099612} {:answer/id #uuid "481625fa-4152-5af0-8d28-f2e247bb3b2b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\sqrt{5} & 4 & 1\\end{bmatrix}" :db/id #edb/ref 17592186099613} {:answer/id #uuid "7c7fffdb-3c6f-5a99-b9d5-1823e4a8b907" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 2\\sqrt{2} & -3.2\\end{bmatrix}" :db/id #edb/ref 17592186099614}] :answer-field/id #uuid "58019043-5b9b-509d-bec2-1f0d3fe2ba2b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186099609}] :question/id #uuid "05da9b48-a1ff-5fcf-a365-aa02a133b9d8" :question/math-academy-id "q-41950" :question/problem "Find the product $AB$, if\n$A = \\begin{bmatrix}0 & 0 & 1\\end{bmatrix}$\nand\n$B = \\begin{bmatrix}0 & 1 & -\\sqrt{3} \\\\ -3 & 2\\sqrt{2} & -3.2 \\\\ \\sqrt{5} & 4 & 1\\end{bmatrix}$."} {:db/id #edb/ref 17592186265864 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13fee5aa-433b-519c-a879-d278aa8a48f3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{\\sqrt{2}}{2} \\\\ \\frac{\\sqrt{2}}{2} \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186263188} {:answer/id #uuid "41aaa268-3659-536e-98cb-3962c98cba4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186263581} {:answer/id #uuid "4b7ae9d8-1791-5400-b198-890be82afcf7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{\\sqrt{2}}{2} \\\\ \\frac{1}{2} \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186263650} {:answer/id #uuid "51369c57-0490-5682-9521-7d30dfd3b175" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{\\sqrt{2}}{2} & \\frac{\\sqrt{2}}{2} & 0\\end{bmatrix}" :db/id #edb/ref 17592186263705} {:answer/id #uuid "b8683bd6-23f6-5798-b795-d12c220d0f7f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{2} \\\\ \\frac{1}{2} \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186264594}] :answer-field/correct {:db/id #edb/ref 17592186263188} :answer-field/id #uuid "44b24809-0a0e-5c7b-9ffd-2ce793b20dcd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265375}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2038a353-9df5-5f59-a4d0-04cb2cfa4cea" :question/math-academy-id "q-130247" :question/problem "Find the product $AB$, if\n$A=\\begin{bmatrix}\\frac{\\sqrt{2}}{2} & -\\frac{\\sqrt{2}}{2} & 0 \\\\ \\frac{\\sqrt{2}}{2} & \\frac{\\sqrt{2}}{2} & 0 \\\\ 0 & 0 & 1\\end{bmatrix}$\nand \n$B=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}.$" :question/worked-solution "Notice that $B$ is the $2$nd *column* of the identity matrix ${I}_{3}.$\n\nSince we're multiplying the $3\\times 3$ matrix $A$ by the $2$nd *column* of the identity matrix ${I}_{3},$ the result must be the $2$nd *column* of $A.$ Therefore,\n\n$$\nAB=\\begin{bmatrix}-\\frac{\\sqrt{2}}{2} \\\\ -\\frac{\\sqrt{2}}{2} \\\\ 0\\end{bmatrix}.\n$$\n\nLet's check the long way:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}\\frac{\\sqrt{2}}{2} & -\\frac{\\sqrt{2}}{2} & 0 \\\\ \\frac{\\sqrt{2}}{2} & \\frac{\\sqrt{2}}{2} & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{\\sqrt{2}}{2}\\cdot 0+(\\frac{-\\sqrt{2}}{2})\\cdot 1+0\\cdot 0 \\\\ \\frac{\\sqrt{2}}{2}\\cdot 0+\\frac{\\sqrt{2}}{2}\\cdot 1+0\\cdot 0 \\\\ 0\\cdot 0+0\\cdot 1+1\\cdot 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{\\sqrt{2}}{2} \\\\ \\frac{\\sqrt{2}}{2} \\\\ 0\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292862 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ba8f9b9-ebe4-5a92-ad85-2a5904c716b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186291226}] :answer-field/correct {:db/id #edb/ref 17592186291226} :answer-field/id #uuid "9c71c1d5-29c4-5775-add9-5e009062a4d6" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292231} {:answer-field/choices [{:answer/id #uuid "3e10b6b5-317f-5bfd-9061-ca77b2bc0961" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186290889}] :answer-field/correct {:db/id #edb/ref 17592186290889} :answer-field/id #uuid "bc3870f6-6b6d-59e8-8173-92df64daaeb3" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292314} {:answer-field/choices [{:answer/id #uuid "4898d33f-f280-50da-be31-36b295222808" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186290931}] :answer-field/correct {:db/id #edb/ref 17592186290931} :answer-field/id #uuid "d71ef47c-19b6-5afb-8eb0-dcde40324c55" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292389}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "18c8e800-9586-55d4-91d2-1e71b341e0e7" :question/math-academy-id "q-275527" :question/problem "Find the product $AB,$ if\n$A=\\begin{bmatrix}\\sqrt{5} & -5 & 2 \\\\ 3 & \\sqrt{5} & -6 \\\\ 7 & -8 & 0\\end{bmatrix}$\nand \n$B=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}.$\n\n|  |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n| $AB=\\,\\,$ |  | {{field-2}} |  |\n|  |  | {{field-3}} |  |" :question/worked-solution "Notice that $B$ is the $2$nd *column* of the identity matrix ${I}_{3}.$\n\nSince we're multiplying the $3\\times 3$ matrix $A$ by the $2$nd *column* of the identity matrix ${I}_{3},$ the result must be the $2$nd *column* of $A.$ Therefore,\n\n$$\nAB=\\begin{bmatrix}-5 \\\\ \\sqrt{5} \\\\ -8\\end{bmatrix}.\n$$\n\nLet's check the long way:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}\\sqrt{5} & -5 & 2 \\\\ 3 & \\sqrt{5} & -6 \\\\ 7 & -8 & 0\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\sqrt{5}\\cdot 0+(-5)\\cdot 1+2\\cdot 0 \\\\ 3\\cdot 0+\\sqrt{5}\\cdot 1+(-6)\\cdot 0 \\\\ 7\\cdot 0+(-8)\\cdot 1+0\\cdot 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-5 \\\\ \\sqrt{5} \\\\ -8\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311868 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56ac8b17-7e11-562c-