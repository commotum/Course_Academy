answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 2\\sqrt{11} \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186546084} {:answer/id #uuid "59c9f45b-de24-5684-9e28-4baa92ba5926" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3\\sqrt{6} & 6 & 9\\end{bmatrix}" :db/id #edb/ref 17592186546085} {:answer/id #uuid "8a367c8b-e09a-5e10-8f5d-0a988ff5dc84" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3\\sqrt{10} & -1 & 4.6\\end{bmatrix}" :db/id #edb/ref 17592186546088} {:answer/id #uuid "8e5b5143-6112-5bdb-a30c-e60d12cefc73" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4.6 \\\\ -1.7 \\\\ 9\\end{bmatrix}" :db/id #edb/ref 17592186546089} {:answer/id #uuid "c22141b6-ad0a-5d40-b9aa-254caa95396e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3\\sqrt{10} \\\\ -4 \\\\ 3\\sqrt{6}\\end{bmatrix}" :db/id #edb/ref 17592186546091}] :answer-field/correct {:db/id #edb/ref 17592186546089} :answer-field/id #uuid "fa2cb576-db76-5f72-8574-1fafaae20058" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186546094}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2d472ae0-7d53-527e-b3ef-7cd75481083e" :question/problem "Find the product $AB$, if\n$A=\\begin{bmatrix}3\\sqrt{10} & -1 & 4.6 \\\\ -4 & 2\\sqrt{11} & -1.7 \\\\ 3\\sqrt{6} & 6 & 9\\end{bmatrix}$\nand \n$B=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}.$" :question/worked-solution "Notice that $B$ is the $3$rd *column* of the identity matrix ${I}_{3}.$\n\nSince we're multiplying the $3\\times 3$ matrix $A$ by the $3$rd *column* of the identity matrix ${I}_{3},$ the result must be the $3$rd *column* of $A.$ Therefore,\n\n$$\nAB=\\begin{bmatrix}4.6 \\\\ -1.7 \\\\ 9\\end{bmatrix}.\n$$\n\nLet's check the long way:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}3\\sqrt{10} & -1 & 4.6 \\\\ -4 & 2\\sqrt{11} & -1.7 \\\\ 3\\sqrt{6} & 6 & 9\\end{bmatrix}\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3\\sqrt{10}\\cdot 0+(-1)\\cdot 0+4.6\\cdot 1 \\\\ (-4)\\cdot 0+2\\sqrt{11}\\cdot 0+(-1.7)\\cdot 1 \\\\ 3\\sqrt{6}\\cdot 0+6\\cdot 0+9\\cdot 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4.6 \\\\ -1.7 \\\\ 9\\end{bmatrix}\\end{aligned}\n$$"}] :knowledge-point/title "Multiplying a Matrix by a Column or Row of the Identity Matrix"}] :topic/math-academy-id 1171 :topic/next [{:db/id #edb/ref 17592186048452} {:db/id #edb/ref 17592186050122}] :topic/title "Multiplying a Matrix by the Identity Matrix"}
