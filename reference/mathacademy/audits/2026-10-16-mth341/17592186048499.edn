bmatrix}1 \\\\ 0 \\\\ -1 \\\\ 2\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3} \\\\ {x}_{4}\\end{bmatrix},\\,b=\\begin{bmatrix}-1 \\\\ 4 \\\\ -3 \\\\ -6\\end{bmatrix}.\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $x,$ we get\n\n$$\n\\begin{aligned}7a+4x & =b \\\\ 4x & =b-7a \\\\ x & =\\frac{1}{4}(b-7a) \\\\ x & =\\frac{1}{4}(\\begin{bmatrix}-1 \\\\ 4 \\\\ -3 \\\\ -6\\end{bmatrix}-7\\begin{bmatrix}1 \\\\ 0 \\\\ -1 \\\\ 2\\end{bmatrix}) \\\\ x & =\\frac{1}{4}\\begin{bmatrix}-8 \\\\ 4 \\\\ 4 \\\\ -20\\end{bmatrix} \\\\ x & =\\begin{bmatrix}-2 \\\\ 1 \\\\ 1 \\\\ -5\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, ${x}_{1}-{x}_{2}=-2-1=-3.$"} {:db/id #edb/ref 17592186314969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d4842ff-27f9-5992-9863-d07fd39b2d9d" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186312330} {:answer/id #uuid "36d9c331-1296-56e1-867e-1c1f15f8f9a1" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186312417} {:answer/id #uuid "4c387986-defc-56bc-8a0b-b8a9ac845695" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186312591} {:answer/id #uuid "7aa0ebec-880a-5969-86bd-143812e540c2" :answer/type {:db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186312955} {:answer/id #uuid "a53d677f-0b4d-534d-a14a-e041a7519e7f" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186313275}] :answer-field/correct {:db/id #edb/ref 17592186312330} :answer-field/id #uuid "ea08bcfb-fe15-5af4-8217-ba4d412e8115" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186314653}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a30a8dd5-ba00-5881-9097-ff69e821d30a" :question/math-academy-id "q-34052" :question/problem "Find the value of 