-d8e1132260ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 \\\\ 4 \\\\ 9\\end{bmatrix}" :db/id #edb/ref 17592186393381} {:answer/id #uuid "dd936bbe-f994-551d-92c8-7ca23c711e28" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ 9 \\\\ -6\\end{bmatrix}" :db/id #edb/ref 17592186393382}] :answer-field/correct {:db/id #edb/ref 17592186393379} :answer-field/id #uuid "ec878615-25a3-5f8c-b92d-39a683197675" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393377}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "348f7a1d-d1ce-5a20-a4c3-2efbac29746f" :question/math-academy-id "q-73936" :question/problem "Find $x$, if $4a-2x=b$ and\n\n$$\na=\\begin{bmatrix}2 \\\\ 6 \\\\ -4\\end{bmatrix},\\,b=\\begin{bmatrix}12 \\\\ -6 \\\\ -10\\end{bmatrix}.\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $x,$ we get  \n\n$$\n\\begin{aligned}4a-2x & =b \\\\ 2x & =4a-b \\\\ x & =\\frac{1}{2}(4a-b) \\\\ x & =\\frac{1}{2}(4\\begin{bmatrix}2 \\\\ 6 \\\\ -4\\end{bmatrix}-\\begin{bmatrix}12 \\\\ -6 \\\\ -10\\end{bmatrix}) \\\\ x & =\\frac{1}{2}\\begin{bmatrix}-4 \\\\ 30 \\\\ -6\\end{bmatrix} \\\\ x & =\\begin{bmatrix}-2 \\\\ 15 \\\\ -3\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393383 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "78f8fc0c-783c-58e6-ad4c-cbc95902e73e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 4 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186393385} {:answer/id #uuid "3ac7e760-a9db-503a-8c03-c99d6be4fb99" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -4 \\\\ 8\\end{bmatrix}" :db/id #edb/ref 17592186393386} {:answer/id #uuid "d1a65265-55b9-5dc9-b2b5-1df67d797575" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ 4 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186393387} {:answer/id #uuid "14827b16-8c6a-52cf-b4e1-fb506542b666" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ -5 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186393388} {:answer/id #uuid "6020b7ac-6b6e-5d6e-a8a5-73d59de80558" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 \\\\ 10 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186393389}] :answer-field/correct {:db/id #edb/ref 17592186393386} :answer-field/id #uuid "f22a77b1-54b3-5415-b968-606e2c4d0cd7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393384}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2567000b-57ae-5d7c-b37b-917f1f640392" :question/math-academy-id "q-73937" :question/problem "Find $x$, if $2a+5x=b$ and\n\n$$\na=\\begin{bmatrix}5 \\\\ -5 \\\\ -10\\end{bmatrix},\\,b=\\begin{bmatrix}15 \\\\ -30 \\\\ 20\\end{bmatrix}.\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $x,$ we get\n\n$$\n\\begin{aligned}2a+5x & =b \\\\ 5x & =b-2a \\\\ x & =\\frac{1}{5}(b-2a) \\\\ x & =\\frac{1}{5}(\\begin{bmatrix}15 \\\\ -30 \\\\ 20\\end{bmatrix}-2\\begin{bmatrix}5 \\\\ -5 \\\\ -10\\end{bmatrix}) \\\\ x & =\\frac{1}{5}\\begin{bmatrix}5 \\\\ -20 \\\\ 40\\end{bmatrix} \\\\ x & =\\begin{bmatrix}1 \\\\ -4 \\\\ 8\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186435824 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b3b3e4e-ca03-5bf0-b918-e879378cf4f9" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186435813} {:answer/id #uuid "3e56b548-f823-5efc-89ba-5bfa7fe486df" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186435814} {:answer/id #uuid "62cff3cd-01fc-5c8d-bb73-00c6490598f8" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186435815} {:answer/id #uuid "7f4f8e1e-a357-552c-aea0-48de6f4f316a" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186435817} {:answer/id #uuid "a0c118c7-81b9-5bfc-90ce-dd9634f5f92e" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186435820}] :answer-field/correct {:db/id #edb/ref 17592186435814} :answer-field/id #uuid "a66e7a5d-9617-5080-a5e0-b50e86007465" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186435823}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e8bdc664-5423-57fc-a753-871b318d24e0" :question/math-academy-id "q-34598" :question/problem "Find the value of ${x}_{1}-{x}_{2}$ given that  $4a+3x=b$ and\n\n$$\na=\\begin{bmatrix}3 \\\\ 3 \\\\ 3\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix},\\,b=\\begin{bmatrix}18 \\\\ -15 \\\\ -9\\end{bmatrix}.\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $x,$ we get\n\n$$\n\\begin{aligned}4a+3x & =b \\\\ 3x & =b-4a \\\\ x & =\\frac{1}{3}(b-4a) \\\\ x & =\\frac{1}{3}(\\begin{bmatrix}18 \\\\ -15 \\\\ -9\\end{bmatrix}-4\\begin{bmatrix}3 \\\\ 3 \\\\ 3\\end{bmatrix}) \\\\ x & =\\frac{1}{3}\\begin{bmatrix}6 \\\\ -27 \\\\ -21\\end{bmatrix} \\\\ x & =\\begin{bmatrix}2 \\\\ -9 \\\\ -7\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, ${x}_{1}-{x}_{2}=2-(-9)=11.$"} {:db/id #edb/ref 17592186562449 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02aca304-7b48-53d3-b89a-9ec1254a925a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ -3 \\\\ -3 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186561589} {:answer/id #uuid "77982fef-cbd9-5b64-9beb-aef93c81e8b7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 3 \\\\ 3 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186561878} {:answer/id #uuid "bb24ab63-f2c2-5312-9f4a-1f89c660eb2b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 3 \\\\ -3 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186562063} {:answer/id #uuid "c9cf2b8d-50b4-5dea-8cdb-f6d96e285ac9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 3 \\\\ -3 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186562085} {:answer/id #uuid "e9436cfd-df38-58b3-bdb8-5acac9079d34" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 \\\\ 4 \\\\ 3 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186562161}] :answer-field/correct {:db/id #edb/ref 17592186561878} :answer-field/id #uuid "167770ed-e7de-54b6-9bfa-73c5e3df3786" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186562233}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7b8162a3-2a18-5498-a3a6-ab4fdf90d980" :question/math-academy-id "q-105158" :question/problem "Find $x$, if $5a-2x=b$ and\n\n$$\na=[\\begin{aligned}2 \\\\ 1 \\\\ 0 \\\\ -2\\end{aligned}],\\,b=[\\begin{aligned}2 \\\\ -1 \\\\ -6 \\\\ -6\\end{aligned}].\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $x,$ we get\n\n$$\n\\begin{aligned}5a-2x & =b \\\\ -2x & =b-5a \\\\ x & =-\\frac{1}{2}(b-5a) \\\\ x & =-\\frac{1}{2}([\\begin{aligned}2 \\\\ -1 \\\\ -6 \\\\ -6\\end{aligned}]-5[\\begin{aligned}2 \\\\ 1 \\\\ 0 \\\\ -2\\end{aligned}]) \\\\ x & =-\\frac{1}{2}[\\begin{aligned}-8 \\\\ -6 \\\\ -6 \\\\ 4\\end{aligned}] \\\\ x & =[\\begin{aligned}4 \\\\ 3 \\\\ 3 \\\\ -2\\end{aligned}].\\end{aligned}\n$$"}] :knowledge-point/title "Solving for a Vector in a Linear Combination"} :step/id #uuid "fd939fe8-9699-5d8a-9dce-0e749d48075e" :step/math-academy-id 17460 :step/next {:db/id #edb/ref 17592186120675}} {:db/id #edb/ref 17592186120675 :step/content {:db/id #edb/ref 17592186119807 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119618 :question/id #uuid "13ebde04-8518-5837-9420-c9487debc562" :question/math-academy-id "e-4791" :question/problem "Consider the vectors\n\n![](images/0b/0b7919416954fe536a93f681fb3c56cac8dddff67e389ef233fdb242390dfb91.svg)\n\nIf $x_1 \\mathbf{c}_1 + x_2\\mathbf{c}_2  = \\mathbf d,$ then what is $x_1+x_2?$" :question/worked-solution "If $x_1 \\mathbf{c}_1 + x_2\\mathbf{c}_2  = \\mathbf d,$ then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}4 \\\\ -1 \\\\ 3\\end{bmatrix}+{x}_{2}\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ -5 \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}4{x}_{1}+{x}_{2} \\\\ -{x}_{1} \\\\ 3{x}_{1}+{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ -5 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}4{x}_{1}+{x}_{2} &=5 \\\\ -{x}_{1} &=-5 \\\\ 3{x}_{1}+{x}_{2} &=0\\end{aligned}\\right.\n$$\n\nFrom the second equation, we obtain $x_1=5,$ which we substitute into the first equation to get \n\n$$\n\\begin{aligned}4{x}_{1}+{x}_{2} & =5 \\\\ 4(5)+{x}_{2} & =5 \\\\ {x}_{2} & =-15.\\end{aligned}\n$$\n\nFinally, we substitute $x_1=5$ and $x_2=-15$ into the third equation to get\n\n$$\n\\begin{aligned}3{x}_{1}+{x}_{2} & =0 \\\\ 3(5)+(-15) & =0 \\\\ 0 & =0,\\end{aligned}\n$$\n\nwhich gives a true statement. \n\nSo the solution of the system is $x_1=5$ and $x_2=-15,$ which means\n\n$$\n5 \\mathbf{c_1}-15 \\mathbf{c_2} = \\mathbf{d}.\n$$\n\nConsequently,\n\n$$\nx_1+x_2=5-15=-10.\n$$"} :knowledge-point/id #uuid "92e5e826-3121-500a-9103-e618cb16c5b2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048826}] :knowledge-point/question-generator {:db/id #edb/ref 17592186535346 :question-generator/id #uuid "8cb93cf7-9a6b-5802-acd4-8c7039cccd06" :question-generator/script "generate/scratch/17592186119807.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186120293 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6d66bec-4f70-53d2-9ff4-2520b4c8cdf2" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186117898} {:answer/id #uuid "f4d4957d-eb5a-5c29-b427-cd7789e9a7a3" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186117899} {:answer/id #uuid "2eb48522-7684-5c49-9b22-80599f5f6575" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186117900} {:answer/id #uuid "55c5a60b-30f3-5dd0-8c86-12e610e70a02" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186117901} {:answer/id #uuid "5f15135e-67c9-596b-bf5d-2210d31c2fb6" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186117902}] :answer-field/correct {:db/id #edb/ref 17592186117898} :answer-field/id #uuid "eb5fae5b-0364-5098-baba-4caac87e9d00" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186117897}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b9323edd-e697-569c-8dd2-3fe5f9eed059" :question/math-academy-id "q-34054" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}-1 \\\\ -1 \\\\ 0\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}2 \\\\ 1 \\\\ 1\\end{bmatrix},\\,b=\\begin{bmatrix}5 \\\\ 3 \\\\ 2\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b,$ then what is ${x}_{1}+{x}_{2}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}-1 \\\\ -1 \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ 1 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ 3 \\\\ 2\\end{bmatrix} \\\\ \\begin{bmatrix}-{x}_{1} \\\\ -{x}_{1} \\\\ 0\\end{bmatrix}+\\begin{bmatrix}2{x}_{2} \\\\ {x}_{2} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ 3 \\\\ 2\\end{bmatrix} \\\\ \\begin{bmatrix}-{x}_{1}+2{x}_{2} \\\\ -{x}_{1}+{x}_{2} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ 3 \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}-{x}_{1}+2{x}_{2} &=5 \\\\ -{x}_{1}+{x}_{2} &=3 \\\\ {x}_{2} &=2\\end{aligned}\\right.\n$$\n\nFrom the third equation we get ${x}_{2}=2$, which we substitute into the second equation to get \n\n$$\n\\begin{aligned}-{x}_{1}+{x}_{2} & =3 \\\\ -{x}_{1}+2 & =3 \\\\ {x}_{1} & =-1.\\end{aligned}\n$$\n\nFinally, we substitute ${x}_{1}=-1$ and ${x}_{2}=2$ into the first equation to get\n\n$$\n\\begin{aligned}-{x}_{1}+2{x}_{2} & =5 \\\\ -(-1)+2(2) & =5 \\\\ 5 & =5,\\end{aligned}\n$$\n\nwhich gives a true statement. \n\nSo the solution of the system is ${x}_{1}=-1$ and ${x}_{2}=2,$ which means\n\n$$\n-{a}_{1}+2{a}_{2}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}=-1+2=1.\n$$"} {:db/id #edb/ref 17592186120350 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e17edfa-489a-532b-8331-c10b33d49743" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186317615} {:answer/id #uuid "5371c3dc-73f8-545d-9df1-de385114de69" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186317844} {:answer/id #uuid "670bbcb4-135b-58eb-8e13-6d202b4e1780" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186317918} {:answer/id #uuid "7c5fdb3b-3dae-5b2c-9ba8-0af1f1050a3d" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186317982} {:answer/id #uuid "91940bba-4486-5ef4-aa49-13aaef5d02e5" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186318061}] :answer-field/correct {:db/id #edb/ref 17592186317982} :answer-field/id #uuid "30d08b0e-d290-5821-816b-53681a92740c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186318524}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "14248ec5-b54c-565b-8b43-275a9e097f62" :question/math-academy-id "q-34568" :question/problem "Consider the vectors\n\n$$\n{c}_{1}=\\begin{bmatrix}-1 \\\\ 3 \\\\ 5\\end{bmatrix},\\,{c}_{2}=\\begin{bmatrix}4 \\\\ 1 \\\\ 2\\end{bmatrix},\\,d=\\begin{bmatrix}3 \\\\ 4 \\\\ 5\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{c}_{1}+{x}_{2}{c}_{2}=d,$ then what is ${x}_{1}+{x}_{2}?$" :question/worked-solution "If ${x}_{1}{c}_{1}+{x}_{2}{c}_{2}=d,$ then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}-1 \\\\ 3 \\\\ 5\\end{bmatrix}+{x}_{2}\\begin{bmatrix}4 \\\\ 1 \\\\ 2\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ 4 \\\\ 5\\end{bmatrix} \\\\ \\begin{bmatrix}-{x}_{1} \\\\ 3{x}_{1} \\\\ 5{x}_{1}\\end{bmatrix}+\\begin{bmatrix}4{x}_{2} \\\\ {x}_{2} \\\\ 2{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ 4 \\\\ 5\\end{bmatrix} \\\\ \\begin{bmatrix}-{x}_{1}+4{x}_{2} \\\\ 3{x}_{1}+{x}_{2} \\\\ 5{x}_{1}+2{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ 4 \\\\ 5\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}-{x}_{1}+4{x}_{2} &=3 \\\\ 3{x}_{1}+{x}_{2} &=4 \\\\ 5{x}_{1}+2{x}_{2} &=5\\end{aligned}\\right.\n$$\n\nMultiplying the first equation by $3$ and adding the result to the second equation, we get\n\n$$\n\\begin{aligned}13{x}_{2} & =13\\,⟹\\,{x}_{2}=1.\\end{aligned}\n$$\n\nSubstituting ${x}_{2}=1$ into the first equation, we get\n\n$$\n\\begin{aligned}-{x}_{1}+4(1) & =3\\,⟹\\,{x}_{1}=1.\\end{aligned}\n$$\n\nFinally, substituting ${x}_{1}=1$ and ${x}_{2}=1$ into the third equation, we obtain\n\n$$\n\\begin{aligned}5{x}_{1}+2{x}_{2} & =5 \\\\ 5(1)+2(1) & =5 \\\\ 7 & =5,\\end{aligned}\n$$\n\nwhich gives a false statement. \n\nSo, the system has no solution."} {:db/id #edb/ref 17592186240990 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "222862ae-7c2b-5d66-9d9a-f59640c9801e" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186238354} {:answer/id #uuid "346bdb71-8966-5ed4-ab2e-83d1ea69e239" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186238507} {:answer/id #uuid "4072326e-9528-5390-aaaa-546988c57563" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186238613} {:answer/id #uuid "4f101a20-f607-5e7e-b164-71aebdad2935" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186238733} {:answer/id #uuid "61153d6d-bad7-5e46-a284-cae191fc9a25" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186238908}] :answer-field/correct {:db/id #edb/ref 17592186238507} :answer-field/id #uuid "47a0ee5a-75fc-5e2b-8002-cf62c42bfe1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240456}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a4963b43-3177-544a-ab68-1ea699a13395" :question/math-academy-id "q-105166" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ -2 \\\\ 3\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}2 \\\\ -3 \\\\ 5\\end{bmatrix},\\,b=\\begin{bmatrix}-3 \\\\ 1 \\\\ -4\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b,$ then what is ${x}_{1}+{x}_{2}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ -2 \\\\ 3\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ -3 \\\\ 5\\end{bmatrix} & =\\begin{bmatrix}-3 \\\\ 1 \\\\ -4\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ -2{x}_{1} \\\\ 3{x}_{1}\\end{bmatrix}+\\begin{bmatrix}2{x}_{2} \\\\ -3{x}_{2} \\\\ 5{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-3 \\\\ 1 \\\\ -4\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}+2{x}_{2} \\\\ -2{x}_{1}-3{x}_{2} \\\\ 3{x}_{1}+5{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-3 \\\\ 1 \\\\ -4\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2} &=-3 \\\\ -2{x}_{1}-3{x}_{2} &=1 \\\\ 3{x}_{1}+5{x}_{2} &=-4\\end{aligned}\\right.\n$$\n\nMultiplying the first equation by $2$ and adding the resulting equations, we obtain \n\n$$\n\\begin{aligned}{x}_{2} & =-5,\\end{aligned}\n$$\n\nwhich we substitute into the second equation to get \n\n$$\n\\begin{aligned}-2{x}_{1}-3{x}_{2}=1 \\\\ -2{x}_{1}-3(-5) & =1 \\\\ -2{x}_{1} & =-14 \\\\ {x}_{1} & =7.\\end{aligned}\n$$\n\nFinally, we substitute ${x}_{1}=7$ and ${x}_{2}=-5$ into the third equation and obtain\n\n$$\n\\begin{aligned}3{x}_{1}+5{x}_{2}=-4 \\\\ 3(7)+5(-5) & =-4 \\\\ -4 & =-4,\\end{aligned}\n$$\n\nwhich gives a true statement. \n\nSo the solution of the system is ${x}_{1}=7$ and ${x}_{2}=-5,$ which means\n\n$$\n7{a}_{1}-5{a}_{2}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}=7+(-5)=2.\n$$"} {:db/id #edb/ref 17592186240991 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05c3a1ce-60e5-59ff-a50a-13acd330b03f" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186238128} {:answer/id #uuid "16ccfa6d-4cbd-58be-a3d1-40e500abddf3" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186238250} {:answer/id #uuid "489d3697-4f9a-5294-985c-5ec2c27fe312" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186238688} {:answer/id #uuid "51497961-e6a7-5e4d-9d38-e1cc46624ffe" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186238757} {:answer/id #uuid "bb3b3d4a-ea4e-52ba-aaca-a3a81abdfca7" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186239685}] :answer-field/correct {:db/id #edb/ref 17592186239685} :answer-field/id #uuid "418087c6-543a-58e8-a946-98e11e2f5b50" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240444}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d5149dd7-ead1-5d7c-a754-e514e2e6e606" :question/math-academy-id "q-105167" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}3 \\\\ -3 \\\\ 1\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-7 \\\\ 5 \\\\ -1\\end{bmatrix},\\,b=\\begin{bmatrix}-9 \\\\ 3 \\\\ 1\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b,$ then what is ${x}_{1}+{x}_{2}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}3 \\\\ -3 \\\\ 1\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-7 \\\\ 5 \\\\ -1\\end{bmatrix} & =\\begin{bmatrix}-9 \\\\ 3 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}3{x}_{1} \\\\ -3{x}_{1} \\\\ {x}_{1}\\end{bmatrix}+\\begin{bmatrix}-7{x}_{2} \\\\ 5{x}_{2} \\\\ -{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-9 \\\\ 3 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}3{x}_{1}-7{x}_{2} \\\\ -3{x}_{1}+5{x}_{2} \\\\ {x}_{1}-{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-9 \\\\ 3 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}3{x}_{1}-7{x}_{2} &=-9 \\\\ -3{x}_{1}+5{x}_{2} &=3 \\\\ {x}_{1}-{x}_{2} &=1\\end{aligned}\\right.\n$$\n\nAdding the first and the second equations we get \n\n$$\n\\begin{aligned}-2{x}_{2} & =-6 \\\\ {x}_{2} & =3,\\end{aligned}\n$$\n\nwhich we substitute into the second equation to get \n\n$$\n\\begin{aligned}-3{x}_{1}+5{x}_{2}=3 \\\\ -3{x}_{1}+5(3) & =3 \\\\ -3{x}_{1} & =-12 \\\\ {x}_{1} & =4.\\end{aligned}\n$$\n\nFinally, we substitute ${x}_{1}=4$ and ${x}_{2}=3$ into the third equation and obtain\n\n$$\n\\begin{aligned}{x}_{1}-{x}_{2}=1 \\\\ (4)-(3) & =1 \\\\ 1 & =1,\\end{aligned}\n$$\n\nwhich gives a true statement. \n\nSo the solution of the system is ${x}_{1}=4$ and ${x}_{2}=3,$ which means\n\n$$\n4{a}_{1}+3{a}_{2}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}=4+3=7.\n$$"} {:db/id #edb/ref 17592186317259 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12b2fa0c-2460-5194-a41e-65210aaf675c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186315229} {:answer/id #uuid "2d891e0d-7387-5fcc-8ea8-042f1f7dd10c" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186315384} {:answer/id #uuid "2f2e1fe7-1207-5eb3-84b2-aaed65147761" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186315386} {:answer/id #uuid "70266867-8c0a-5fdb-8194-68cd47f75152" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186315749} {:answer/id #uuid "92550deb-3f5e-5d93-8785-214a7b0242bc" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186315936}] :answer-field/correct {:db/id #edb/ref 17592186315384} :answer-field/id #uuid "fda88ab2-6a42-5e3d-a747-d9d379dda047" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186317151}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8179ffc2-2381-5ec9-a386-111d6e4cae85" :question/math-academy-id "q-34242" :question/problem "Consider the vectors\n\n$$\n{c}_{1}=\\begin{bmatrix}0 \\\\ 2 \\\\ 1\\end{bmatrix},\\,{c}_{2}=\\begin{bmatrix}0 \\\\ -1 \\\\ -1\\end{bmatrix},\\,d=\\begin{bmatrix}4 \\\\ 5 \\\\ 1\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{c}_{1}+{x}_{2}{c}_{2}=d,$ then what is ${x}_{1}+{x}_{2}?$" :question/worked-solution "If ${x}_{1}{c}_{1}+{x}_{2}{c}_{2}=d,$ then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}0 \\\\ 2 \\\\ 1\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ -1 \\\\ -1\\end{bmatrix} & =\\begin{bmatrix}4 \\\\ 5 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}0 \\\\ 2{x}_{1} \\\\ {x}_{1}\\end{bmatrix}+\\begin{bmatrix}0 \\\\ -{x}_{2} \\\\ -{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}4 \\\\ 5 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}0 \\\\ 2{x}_{1}-{x}_{2} \\\\ {x}_{1}-{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}4 \\\\ 5 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}0 &=4 \\\\ 2{x}_{1}-{x}_{2} &=5 \\\\ {x}_{1}-{x}_{2} &=1\\end{aligned}\\right.\n$$\n\nThe first equation is a false statement. Hence,the system has no solution."} {:db/id #edb/ref 17592186342116 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19d8ca8c-8922-5497-b29f-07f42b1c0328" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186339356} {:answer/id #uuid "225a0463-cbb8-5790-893a-13e777295f9f" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186339423} {:answer/id #uuid "5a2860ef-3991-5816-8783-30dbaa549960" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186339948} {:answer/id #uuid "88e4363d-a9d9-5e7c-8f3b-9118648894cf" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186340350} {:answer/id #uuid "a3b0b254-d5ee-58ae-b3cb-ddf74a08a8e5" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186340612}] :answer-field/correct {:db/id #edb/ref 17592186339948} :answer-field/id #uuid "80a50f39-711b-58a4-835e-c4efbd2ce316" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341606}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0008ebd1-cf28-5d38-a9cd-5c6dde0f95a6" :question/math-academy-id "q-73951" :question/problem "Consider the vectors\n\n$$\n{c}_{1}=\\begin{bmatrix}1 \\\\ 4 \\\\ 4\\end{bmatrix},\\,{c}_{2}=\\begin{bmatrix}2 \\\\ -1 \\\\ 1\\end{bmatrix},\\,d=\\begin{bmatrix}3 \\\\ -11 \\\\ -5\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{c}_{1}+{x}_{2}{c}_{2}=d,$ then what is ${x}_{1}+{x}_{2}?$\n." :question/worked-solution "If ${x}_{1}{c}_{1}+{x}_{2}{c}_{2}=d,$ then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ 4 \\\\ 4\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ -1 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ -11 \\\\ -5\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ 4{x}_{1} \\\\ 4{x}_{1}\\end{bmatrix}+\\begin{bmatrix}2{x}_{2} \\\\ -{x}_{2} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ -11 \\\\ -5\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}+2{x}_{2} \\\\ 4{x}_{1}-{x}_{2} \\\\ 4{x}_{1}+{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ -11 \\\\ -5\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2} &=3 \\\\ 4{x}_{1}-{x}_{2} &=-11 \\\\ 4{x}_{1}+{x}_{2} &=-5\\end{aligned}\\right.\n$$\n\nAdding the second and the third  equations we get\n\n$$\n\\begin{aligned}8{x}_{1} & =-16\\,⟹\\,{x}_{1}=-2.\\end{aligned}\n$$\n\nSubstituting ${x}_{1}=-2$ into the third equation, we get\n\n$$\n\\begin{aligned}4(-2)+{x}_{2}=-5\\,⟹\\,{x}_{2}=3.\\end{aligned}\n$$\n\nFinally, substituting ${x}_{1}=-2$ and ${x}_{2}=3$ into the first equation, we obtain\n\n$$\n\\begin{aligned}{x}_{1}+2{x}_{2} & =3 \\\\ (-2)+2(3) & =3 \\\\ 4 & =3,\\end{aligned}\n$$\n\nwhich gives a false statement. \n\nSo, the system has no solution."} {:db/id #edb/ref 17592186342117 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32d443f5-4a4c-51aa-af01-414ca3fa7326" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186339577} {:answer/id #uuid "7176331f-77ce-5fd1-a3ac-5da0c1e2a04b" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186340136} {:answer/id #uuid "8b60455d-0f91-5c1b-b1a2-179e00d5ba83" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186340376} {:answer/id #uuid "c1c850a2-343b-5521-9ce1-8a561961b355" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186340853} {:answer/id #uuid "f64a326f-5394-5da4-88ca-9fe93d38d48b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186341305}] :answer-field/correct {:db/id #edb/ref 17592186339577} :answer-field/id #uuid "d05bc05c-9d23-5ddd-9cf1-1346736f76da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341745}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "eec4fe83-c254-5d51-9484-b88391578898" :question/math-academy-id "q-73952" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ -1 \\\\ 2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-1 \\\\ -1 \\\\ 3\\end{bmatrix},\\,b=\\begin{bmatrix}-7 \\\\ -1 \\\\ 6\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b,$ then what is ${x}_{1}+{x}_{2}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ -1 \\\\ 2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-1 \\\\ -1 \\\\ 3\\end{bmatrix} & =\\begin{bmatrix}-7 \\\\ -1 \\\\ 6\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ -{x}_{1} \\\\ 2{x}_{1}\\end{bmatrix}+\\begin{bmatrix}-{x}_{2} \\\\ -{x}_{2} \\\\ 3{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-7 \\\\ -1 \\\\ 6\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}-{x}_{2} \\\\ -{x}_{1}-{x}_{2} \\\\ 2{x}_{1}+3{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-7 \\\\ -1 \\\\ 6\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2} &=-7 \\\\ -{x}_{1}-{x}_{2} &=-1 \\\\ 2{x}_{1}+3{x}_{2} &=6\\end{aligned}\\right.\n$$\n\nAdding the first and the second equation we get\n\n$$\n-2{x}_{2}=-8\\,⟹\\,{x}_{2}=4.\n$$\n\nSubstituting ${x}_{2}=4$ into the first equation yields\n\n$$\n\\begin{aligned}{x}_{1}-{x}_{2} & =-7 \\\\ {x}_{1}-(4) & =-7 \\\\ {x}_{1} & =-7+4 \\\\ {x}_{1} & =-3.\\end{aligned}\n$$\n\nFinally, we substitute ${x}_{1}=-3$ and ${x}_{2}=4$ into the third equation to get\n\n$$\n\\begin{aligned}2{x}_{1}+3{x}_{2} & =6 \\\\ 2(-3)+3(4) & =6 \\\\ 6 & =6,\\end{aligned}\n$$\n\nwhich gives a true statement. \n\nSo, the solution of the system is ${x}_{1}=-3$ and ${x}_{2}=4,$ which means\n\n$$\n-3{a}_{1}+4{a}_{2}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}=-3+4=1.\n$$"} {:db/id #edb/ref 17592186342118 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fc79319-1174-5e30-8921-c2ddee82bff8" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186339273} {:answer/id #uuid "9fc2f746-79cb-5fe6-bb3f-959e15f530f9" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186340573} {:answer/id #uuid "a4526df4-3faf-51d1-bf8d-80803e953d0f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186340621} {:answer/id #uuid "a8889610-4b78-5044-ae29-aded8c4e08c7" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186340661} {:answer/id #uuid "d2e743ee-717a-5ee8-8be6-6df96ac57d49" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186340995}] :answer-field/correct {:db/id #edb/ref 17592186340573} :answer-field/id #uuid "c7acad01-3471-5823-b302-ef28c20fd009" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341731}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "abf235b3-2d59-5bfb-aea0-aa237461f6b8" :question/math-academy-id "q-73954" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}-2 \\\\ 3 \\\\ 4\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}5 \\\\ 4 \\\\ -3\\end{bmatrix},\\,b=\\begin{bmatrix}16 \\\\ -1 \\\\ -18\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b,$ then what is ${x}_{1}+{x}_{2}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}-2 \\\\ 3 \\\\ 4\\end{bmatrix}+{x}_{2}\\begin{bmatrix}5 \\\\ 4 \\\\ -3\\end{bmatrix} & =\\begin{bmatrix}16 \\\\ -1 \\\\ -18\\end{bmatrix} \\\\ \\begin{bmatrix}-2{x}_{1} \\\\ 3{x}_{1} \\\\ 4{x}_{1}\\end{bmatrix}+\\begin{bmatrix}5{x}_{2} \\\\ 4{x}_{2} \\\\ -3{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}16 \\\\ -1 \\\\ -18\\end{bmatrix} \\\\ \\begin{bmatrix}-2{x}_{1}+5{x}_{2} \\\\ 3{x}_{1}+4{x}_{2} \\\\ 4{x}_{1}-3{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}16 \\\\ -1 \\\\ -18\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}-2{x}_{1}+5{x}_{2} &=16 \\\\ 3{x}_{1}+4{x}_{2} &=-1 \\\\ 4{x}_{1}-3{x}_{2} &=-18\\end{aligned}\\right.\n$$\n\nMultiplying the first equation by $3$, the second equation by $2$, and adding the resulting equations, we obtain \n\n$$\n\\begin{aligned}15{x}_{2}+8{x}_{2} & =48-2 \\\\ 23{x}_{2} & =46 \\\\ {x}_{2} & =2.\\end{aligned}\n$$\n\nNow, we substitute ${x}_{2}=2$  into the second equation to get \n\n$$\n\\begin{aligned}3{x}_{1}+4{x}_{2} & =-1\\text{ } \\\\ 3{x}_{1}+4(2) & =-1 \\\\ 3{x}_{1} & =-9 \\\\ {x}_{1} & =-3.\\end{aligned}\n$$\n\nFinally, we substitute ${x}_{1}=-3$ and ${x}_{2}=2$ into our third equation to get\n\n$$\n\\begin{aligned}4{x}_{1}-3{x}_{2} & =-18 \\\\ 4(-3)-3(2) & =-18 \\\\ -18 & =-18,\\end{aligned}\n$$\n\nwhich gives a true statement. \n\nSo, the solution of the system is ${x}_{1}=-3$ and ${x}_{2}=2,$ which means\n\n$$\n-3{a}_{1}+2{a}_{2}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}=(-3)+2=-1.\n$$"} {:db/id #edb/ref 17592186342123 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "048486de-b3f4-54ba-a863-5232060fd28e" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186339161} {:answer/id #uuid "406e545a-e1be-5e50-b001-b5d9d22a4ae7" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186339703} {:answer/id #uuid "539b7b89-22e9-5a4e-a30d-834d8a0b99b4" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186339901} {:answer/id #uuid "a655e234-7164-552b-bfae-a666a8e2d4fa" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186340636} {:answer/id #uuid "f849fe1b-7f5b-56c4-97c6-1197c183e254" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186341324}] :answer-field/correct {:db/id #edb/ref 17592186339703} :answer-field/id #uuid "8bab3e91-55b1-56d2-8600-44d3dfd27b96" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341626}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3c67076c-502b-504a-869c-d6e3549e0a05" :question/math-academy-id "q-73981" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}4 \\\\ -2 \\\\ 3\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-1 \\\\ 3 \\\\ -1\\end{bmatrix},\\,b=\\begin{bmatrix}7 \\\\ 9 \\\\ 4\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b,$ then what is ${x}_{1}+{x}_{2}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}4 \\\\ -2 \\\\ 3\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-1 \\\\ 3 \\\\ -1\\end{bmatrix} & =\\begin{bmatrix}7 \\\\ 9 \\\\ 4\\end{bmatrix} \\\\ \\begin{bmatrix}4{x}_{1} \\\\ -2{x}_{1} \\\\ 3{x}_{1}\\end{bmatrix}+\\begin{bmatrix}-{x}_{2} \\\\ 3{x}_{2} \\\\ -{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}7 \\\\ 9 \\\\ 4\\end{bmatrix} \\\\ \\begin{bmatrix}4{x}_{1}-{x}_{2} \\\\ -2{x}_{1}+3{x}_{2} \\\\ 3{x}_{1}-{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}7 \\\\ 9 \\\\ 4\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}4{x}_{1}-{x}_{2} &=7 \\\\ -2{x}_{1}+3{x}_{2} &=9 \\\\ 3{x}_{1}-{x}_{2} &=4\\end{aligned}\\right.\n$$\n\nMultiplying the third equation by $-1$ and adding the result to the first equation we get \n\n$$\n\\begin{aligned}4{x}_{1}-3{x}_{1} & =7-4 \\\\ {x}_{1} & =3.\\end{aligned}\n$$\n\nNow,  we substitute ${x}_{1}=3$ into the third equation to get \n\n$$\n\\begin{aligned}3{x}_{1}-{x}_{2} & =4 \\\\ 3(3)-{x}_{2} & =4 \\\\ -{x}_{2} & =4-9 \\\\ {x}_{2} & =5.\\end{aligned}\n$$\n\nFinally, we substitute ${x}_{1}=3$ and ${x}_{2}=5$ into the second equation to get\n\n$$\n\\begin{aligned}-2{x}_{1}+3{x}_{2} & =9 \\\\ -2(3)+3(5) & =9 \\\\ -6+15 & =9,\\end{aligned}\n$$\n\nwhich gives a true statement. \n\nSo the solution of the system is ${x}_{1}=3$ and ${x}_{2}=5,$ which means\n\n$$\n3{a}_{1}+5{a}_{2}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}=3+5=8.\n$$"} {:db/id #edb/ref 17592186435825 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fdd8247-3e99-5680-9837-f81ce2e4daa8" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186435812} {:answer/id #uuid "6588aecf-5be8-5075-92ab-05e2c0bd205f" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186435816} {:answer/id #uuid "877b327c-7099-5b51-a1a0-e54f12c801d5" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186435818} {:answer/id #uuid "9a314fbe-bce0-5c72-becd-d86fdd89cb4c" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186435819} {:answer/id #uuid "b6573507-37c6-5328-ab6e-7644606e55a7" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186435821}] :answer-field/correct {:db/id #edb/ref 17592186435819} :answer-field/id #uuid "50ab6af3-7838-5baf-b926-7d20ec2e1151" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186435822}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e9e20ff9-23b3-5457-a430-304f98c0d839" :question/math-academy-id "q-73950" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}3 \\\\ 4 \\\\ 2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-2 \\\\ 3 \\\\ -3\\end{bmatrix},\\,b=\\begin{bmatrix}-11 \\\\ 8 \\\\ -14\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b,$ then what is ${x}_{1}+{x}_{2}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}3 \\\\ 4 \\\\ 2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-2 \\\\ 3 \\\\ -3\\end{bmatrix} & =\\begin{bmatrix}-11 \\\\ 8 \\\\ -14\\end{bmatrix} \\\\ \\begin{bmatrix}3{x}_{1} \\\\ 4{x}_{1} \\\\ 2{x}_{1}\\end{bmatrix}+\\begin{bmatrix}-2{x}_{2} \\\\ 3{x}_{2} \\\\ -3{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-11 \\\\ 8 \\\\ -14\\end{bmatrix} \\\\ \\begin{bmatrix}3{x}_{1}-2{x}_{2} \\\\ 4{x}_{1}+3{x}_{2} \\\\ 2{x}_{1}-3{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-11 \\\\ 8 \\\\ -14\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}3{x}_{1}-2{x}_{2} &=-11 \\\\ 4{x}_{1}+3{x}_{2} &=8 \\\\ 2{x}_{1}-3{x}_{2} &=-14\\end{aligned}\\right.\n$$\n\nAdding the second and the third equations we get \n\n$$\n\\begin{aligned}6{x}_{1} & =-6 \\\\ {x}_{1} & =-1,\\end{aligned}\n$$\n\nwhich we substitute into the second equation to get \n\n$$\n\\begin{aligned}4{x}_{1}+3{x}_{2} & =8 \\\\ 4(-1)+3{x}_{2} & =8 \\\\ 3{x}_{2} & =12 \\\\ {x}_{2} & =4.\\end{aligned}\n$$\n\nFinally, we substitute ${x}_{1}=-1$ and ${x}_{2}=4$ into the first equation to get\n\n$$\n\\begin{aligned}3{x}_{1}-2{x}_{2} & =-11 \\\\ 3(-1)-2(4) & =-11 \\\\ -11 & =-11,\\end{aligned}\n$$\n\nwhich gives a true statement. \n\nSo the solution of the system is ${x}_{1}=-1$ and ${x}_{2}=4,$ which means\n\n$$\n-{a}_{1}+4{a}_{2}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}=-1+4=3.\n$$"} {:db/id #edb/ref 17592186562514 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9dfb10a9-8436-5e35-b531-240827bbf3d9" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186561972} {:answer/id #uuid "a534e8f3-d655-5502-bc89-53c81026a425" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186561994} {:answer/id #uuid "bd9c2754-dc15-56f5-8e26-d514db78cd49" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186562067} {:answer/id #uuid "d28d263f-fd3b-5140-9893-862b22fa936d" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186562111} {:answer/id #uuid "eb547a3b-90e6-5909-88af-1af5468ae682" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186562172}] :answer-field/correct {:db/id #edb/ref 17592186561994} :answer-field/id #uuid "036cd528-ad80-51a8-8b57-1c098a2a1799" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186562218}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f9fda870-d2c0-5b67-a720-dd733f4059b5" :question/math-academy-id "q-105163" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=[\\begin{aligned}5 \\\\ 7 \\\\ -1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}2 \\\\ 4 \\\\ 3\\end{aligned}],\\,b=[\\begin{aligned}4 \\\\ -1 \\\\ -11\\end{aligned}].\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b,$ then what is ${x}_{1}+{x}_{2}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b,$ then we have\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}5 \\\\ 7 \\\\ -1\\end{aligned}]+{x}_{2}[\\begin{aligned}2 \\\\ 4 \\\\ 3\\end{aligned}] & =[\\begin{aligned}4 \\\\ -1 \\\\ -11\\end{aligned}] \\\\ [\\begin{aligned}5{x}_{1} \\\\ 7{x}_{1} \\\\ -{x}_{1}\\end{aligned}]+[\\begin{aligned}2{x}_{2} \\\\ 4{x}_{2} \\\\ 3{x}_{2}\\end{aligned}] & =[\\begin{aligned}4 \\\\ -1 \\\\ -11\\end{aligned}] \\\\ [\\begin{aligned}5{x}_{1}+2{x}_{2} \\\\ 7{x}_{1}+4{x}_{2} \\\\ -{x}_{1}+3{x}_{2}\\end{aligned}] & =[\\begin{aligned}4 \\\\ -1 \\\\ -11\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\{\\begin{aligned}5{x}_{1}+2{x}_{2}=4 \\\\ 7{x}_{1}+4{x}_{2}=-1 \\\\ -{x}_{1}+3{x}_{2}=-11\\end{aligned}\n$$\n\nMultiplying the first equation by $(-2)$ and adding the result to the second equation, we get\n\n$$\n\\begin{aligned}-3{x}_{1} & =-9\\,⟹\\,{x}_{1}=3.\\end{aligned}\n$$\n\nSubstituting ${x}_{1}=3$ into the first equation, we get\n\n$$\n\\begin{aligned}5(3)+2{x}_{2} & =4\\,⟹\\,{x}_{2}=-\\frac{11}{2}.\\end{aligned}\n$$\n\nFinally, substituting ${x}_{1}=3$ and ${x}_{2}=-\\frac{11}{2}$ into the third equation, we obtain\n\n$$\n\\begin{aligned}-{x}_{1}+3{x}_{2} & =-11 \\\\ -(3)+3(-\\frac{11}{2}) & =-11 \\\\ -\\frac{33}{2} & =-8,\\end{aligned}\n$$\n\nwhich gives a false statement. \n\nSo, the system has no solution."}] :knowledge-point/title "Solving for Two Coefficients in a Linear Combination"} :step/id #uuid "fd740ffd-227c-5f9c-9418-4c54bf1616ff" :step/math-academy-id 17464 :step/next {:db/id #edb/ref 17592186120748}} {:db/id #edb/ref 17592186120748 :step/content {:db/id #edb/ref 17592186119854 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119669 :question/id #uuid "d9beff9d-db58-540f-811e-a07fb77d3d92" :question/math-academy-id "e-6191" :question/problem "Consider the vectors\n\n![](images/16/1687c0a08fedfd90a26481007bb9bf56263edf67574fd690662064ef0341c86c.svg)\n\nIf $x_1 \\mathbf{a}_1 + x_2\\mathbf{a}_2 + x_3\\mathbf{a}_3 = \\mathbf b,$ then what is $x_1+x_2+x_3?$" :question/worked-solution "Since $\\mathbf{b}$ is a linear combination of vectors $\\mathbf{a_1}, \\,\\mathbf{a_2}$ and $\\mathbf{a_3}$ with coefficients $x_1,\\, x_2$ and $x_3,$ respectively, we have\n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3} & =b \\\\ {x}_{1}\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}1 \\\\ 0 \\\\ -1\\end{bmatrix}+{x}_{3}\\begin{bmatrix}1 \\\\ 2 \\\\ 3\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ 1 \\\\ 7\\end{bmatrix} \\\\ \\begin{bmatrix}0 \\\\ {x}_{1} \\\\ 0\\end{bmatrix}+\\begin{bmatrix}{x}_{2} \\\\ 0 \\\\ -{x}_{2}\\end{bmatrix}+\\begin{bmatrix}{x}_{3} \\\\ 2{x}_{3} \\\\ 3{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ 1 \\\\ 7\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{2}+{x}_{3} \\\\ {x}_{1}+2{x}_{3} \\\\ -{x}_{2}+3{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ 1 \\\\ 7\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{2}+{x}_{3} &=1 \\\\ {x}_{1}+2{x}_{3} &=1 \\\\ -{x}_{2}+3{x}_{3} &=7\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n![](images/9b/9bf913744317fab321cf9f2e01da732853a52a4fd7948c65da596ae4706f6dce.svg)\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}0 & 1 & 1 & 1 \\\\ 1 & 0 & 2 & 1 \\\\ 0 & -1 & 3 & 7\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 2 & 1 \\\\ 0 & 1 & 1 & 1 \\\\ 0 & -1 & 3 & 7\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 2 & 1 \\\\ 0 & 1 & 1 & 1 \\\\ 0 & 0 & 4 & 8\\end{bmatrix} & {R}_{3} & :=\\frac{1}{4}{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 0 & 2 & 1 \\\\ 0 & 1 & 1 & 1 \\\\ 0 & 0 & 1 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{3} &=1 \\\\ {x}_{2}+{x}_{3} &=1 \\\\ {x}_{3} &=2.\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get $x_3 = 2.$ Substituting this into the second equation, we get\n\n$$\nx_2+(2) = 1 \\quad\\Rightarrow\\quad x_2 = -1,\n$$\n\nand substituting $x_3=2$ into the first equation, we get\n\n$$\nx_1+2(2) = 1 \\quad\\Rightarrow\\quad x_1 = -3.\n$$\n\nSo the solution of the system is $x_1=-3, x_2=-1, x_3=2,$ which means\n\n$$\n-3 \\mathbf{a_1}- \\mathbf{a_2} +2 \\mathbf{a_3}= \\mathbf{b}.\n$$\n\nConsequently,\n\n$$\nx_1+x_2+x_3=-3-1+2=-2.\n$$"} :knowledge-point/id #uuid "13a44dc8-4699-519f-8cb1-87ad77471ebe" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049058} {:db/id #edb/ref 17592186050178}] :knowledge-point/question-generator {:db/id #edb/ref 17592186538215 :question-generator/id #uuid "12b9727c-8650-5b8b-a2a5-255818e1f719" :question-generator/script "generate/scratch/17592186119854.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186120309 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8747e1ec-5bdc-5604-985b-58468728da61" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186117994} {:answer/id #uuid "bf310542-d18d-58a7-8e58-a22420156a7f" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186117995} {:answer/id #uuid "cc90ae26-d46f-5f50-bd00-0e92bd416881" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186117996} {:answer/id #uuid "5599f481-dd85-552e-af10-eea6867254c4" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186117997} {:answer/id #uuid "71e2eba5-06c7-50b6-88b0-7ea8c256dfb9" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186117998}] :answer-field/correct {:db/id #edb/ref 17592186117998} :answer-field/id #uuid "c343bbfd-7cc0-5884-946e-aa6090814a96" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186117993}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6f395246-75c5-52ab-b275-6f768034cd27" :question/math-academy-id "q-34243" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}2 \\\\ 0 \\\\ 5\\end{aligned}],\\,b=[\\begin{aligned}2 \\\\ 3 \\\\ -1\\end{aligned}].\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have  \n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]+{x}_{2}[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]+{x}_{3}[\\begin{aligned}2 \\\\ 0 \\\\ 5\\end{aligned}] & =[\\begin{aligned}2 \\\\ 3 \\\\ -1\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1} \\\\ 0 \\\\ {x}_{1}\\end{aligned}]+[\\begin{aligned}-{x}_{2} \\\\ {x}_{2} \\\\ {x}_{2}\\end{aligned}]+[\\begin{aligned}2{x}_{3} \\\\ 0 \\\\ 5{x}_{3}\\end{aligned}] & =[\\begin{aligned}2 \\\\ 3 \\\\ -1\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1}-{x}_{2}+2{x}_{3} \\\\ {x}_{2} \\\\ {x}_{1}+{x}_{2}+5{x}_{3}\\end{aligned}] & =[\\begin{aligned}2 \\\\ 3 \\\\ -1\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\{\\begin{aligned}{x}_{1}-{x}_{2}+2{x}_{3}=2 \\\\ {x}_{2}=3 \\\\ {x}_{1}+{x}_{2}+5{x}_{3}=-1\\end{aligned}\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=[\\begin{aligned}1 & -1 & 2 & 2 \\\\ 0 & 1 & 0 & 3 \\\\ 1 & 1 & 5 & -1\\end{aligned}]\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -1 & 2 & 2 \\\\ 0 & 1 & 0 & 3 \\\\ 1 & 1 & 5 & -1\\end{aligned}] & {R}_{3} & :={R}_{3}-{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & 2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 2 & 3 & -3\\end{aligned}] & {R}_{3} & :={R}_{3}-2{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & 2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & 3 & -9\\end{aligned}] & {R}_{3} & :=\\frac{1}{3}{R}_{3} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & 2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & 1 & -3\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}{x}_{1}-{x}_{2}+2{x}_{3}=2 \\\\ {x}_{2}=3 \\\\ {x}_{3}=-3.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=-3$ and from the second equation we get ${x}_{2}=3.$ Substituting these into the first equation, we obtain\n\n$$\n{x}_{1}-3+2(-3)=2\\,⟹\\,{x}_{1}=11.\n$$\n\nSo, the solution of the system is ${x}_{1}=11$, ${x}_{2}=3$, and ${x}_{3}=-3,$ which means \n\n$$\n11{a}_{1}+3{a}_{2}-3{a}_{3}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=11+3-3=11.\n$$"} {:db/id #edb/ref 17592186120349 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "295ae2fa-32ce-5257-98e5-da2905531d81" :answer/type {:db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186317694} {:answer/id #uuid "2c0453ac-1c05-54e9-8a24-6d3978752a5f" :answer/type {:db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186317702} {:answer/id #uuid "32214845-d636-54a9-9639-3d6949098428" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186317722} {:answer/id #uuid "7f41ea8e-b9d2-5a9b-86d7-d046fada3b82" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186318000} {:answer/id #uuid "9e84c226-cfae-5746-8d8d-79afcdb473ad" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186318104}] :answer-field/correct {:db/id #edb/ref 17592186318104} :answer-field/id #uuid "0300422c-154e-538a-8d8e-cf91e3cbdbed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186318431}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "04e10334-4152-5cfe-aad7-249b23effb61" :question/math-academy-id "q-34566" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 2 \\\\ 3\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}2 \\\\ 5 \\\\ 6\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}3 \\\\ 2 \\\\ 9\\end{bmatrix},\\,b=\\begin{bmatrix}-2 \\\\ -6 \\\\ 7\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ 2 \\\\ 3\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ 5 \\\\ 6\\end{bmatrix}+{x}_{3}\\begin{bmatrix}3 \\\\ 2 \\\\ 9\\end{bmatrix} & =\\begin{bmatrix}-2 \\\\ -6 \\\\ 7\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ 2{x}_{1} \\\\ 3{x}_{1}\\end{bmatrix}+\\begin{bmatrix}2{x}_{2} \\\\ 5{x}_{2} \\\\ 6{x}_{2}\\end{bmatrix}+\\begin{bmatrix}3{x}_{3} \\\\ 2{x}_{3} \\\\ 9{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}-2 \\\\ -6 \\\\ 7\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}+2{x}_{2}+3{x}_{3} \\\\ 2{x}_{1}+5{x}_{2}+2{x}_{3} \\\\ 3{x}_{1}+6{x}_{2}+9{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}-2 \\\\ -6 \\\\ 7\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2}+3{x}_{3} &=-2 \\\\ 2{x}_{1}+5{x}_{2}+2{x}_{3} &=-6 \\\\ 3{x}_{1}+6{x}_{2}+9{x}_{3} &=7\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\begin{bmatrix}1 & 2 & 3 & -2 \\\\ 2 & 5 & 2 & -6 \\\\ 3 & 6 & 9 & 7\\end{bmatrix}.\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & 3 & -2 \\\\ 2 & 5 & 2 & -6 \\\\ 3 & 6 & 9 & 7\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 3 & -2 \\\\ 0 & 1 & -4 & -2 \\\\ 3 & 6 & 9 & 7\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 3 & -2 \\\\ 0 & 1 & -4 & -2 \\\\ 0 & 0 & 0 & 13\\end{bmatrix}.\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2}+3{x}_{3} &=-2 \\\\ {x}_{2}-4{x}_{3} &=-2 \\\\ 0 &=13.\\end{aligned}\\right.\n$$\n\nHowever, the final equation $0=13$  gives a false statement. So the system has no solution."} {:db/id #edb/ref 17592186240992 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24228b89-72c1-53f9-96a3-762f6e876413" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186238375} {:answer/id #uuid "41f9a912-3fc6-5aa1-be4b-82da70d8f8d1" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186238629} {:answer/id #uuid "48788366-6d42-5df1-818a-252fcb9e825d" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186238685} {:answer/id #uuid "67eb2257-68d5-593f-891b-6945f576e00f" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186238957} {:answer/id #uuid "d9f9576f-46f8-5778-888b-cb310e6c107d" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186239958}] :answer-field/correct {:db/id #edb/ref 17592186238375} :answer-field/id #uuid "69b9e7b4-1521-54c5-b7f4-d54ad2ab9039" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240526}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0d52be40-210e-5024-9a79-b6ca4323223c" :question/math-academy-id "q-105168" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 3 \\\\ -2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-3 \\\\ -8 \\\\ 6\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}2 \\\\ 5 \\\\ -3\\end{bmatrix},\\,b=\\begin{bmatrix}2 \\\\ 1 \\\\ 2\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have  \n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ 3 \\\\ -2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-3 \\\\ -8 \\\\ 6\\end{bmatrix}+{x}_{3}\\begin{bmatrix}2 \\\\ 5 \\\\ -3\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ 1 \\\\ 2\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ 3{x}_{1} \\\\ -2{x}_{1}\\end{bmatrix}+\\begin{bmatrix}-3{x}_{2} \\\\ -8{x}_{2} \\\\ 6{x}_{2}\\end{bmatrix}+\\begin{bmatrix}2{x}_{3} \\\\ 5{x}_{3} \\\\ -3{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ 1 \\\\ 2\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}-3{x}_{2}+2{x}_{3} \\\\ 3{x}_{1}-8{x}_{2}+5{x}_{3} \\\\ -2{x}_{1}+6{x}_{2}-3{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ 1 \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-3{x}_{2}+2{x}_{3} &=2 \\\\ 3{x}_{1}-8{x}_{2}+5{x}_{3} &=1 \\\\ -2{x}_{1}+6{x}_{2}-3{x}_{3} &=2\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\begin{bmatrix}1 & -3 & 2 & 2 \\\\ 3 & -8 & 5 & 1 \\\\ -2 & 6 & -3 & 2\\end{bmatrix}\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -3 & 2 & 2 \\\\ 3 & -8 & 5 & 1 \\\\ -2 & 6 & -3 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 2 & 2 \\\\ 0 & 1 & -1 & -5 \\\\ -2 & 6 & -3 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 2 & 2 \\\\ 0 & 1 & -1 & -5 \\\\ 0 & 0 & 1 & 6\\end{bmatrix}.\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-3{x}_{2}+2{x}_{3} &=2 \\\\ {x}_{2}-{x}_{3} &=-5 \\\\ {x}_{3} &=6.\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get ${x}_{3}=6.$ Substituting ${x}_{3}=6$ into the second equation, we obtain\n\n$$\n{x}_{2}-6=-5\\,⟹\\,{x}_{2}=1.\n$$\n\nNow, substituting ${x}_{2}=1$ and ${x}_{3}=6$ into the first equation, we obtain\n\n$$\n{x}_{1}-3(1)+2(6)=2\\,⟹\\,{x}_{1}=-7.\n$$\n\nSo, the solution of the system is ${x}_{1}=-7$, ${x}_{2}=1$, and ${x}_{3}=6,$ which means \n\n$$\n-7{a}_{1}+{a}_{2}+6{a}_{3}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=-7+1+6=0.\n$$"} {:db/id #edb/ref 17592186240993 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "023fcb6e-19a9-5e78-8982-04f818ca611a" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186238099} {:answer/id #uuid "04fb8f1e-74de-53e7-811e-89afaef85a39" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186238122} {:answer/id #uuid "60fcd9a2-4983-563f-a7a0-4d01c2393643" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186238907} {:answer/id #uuid "b211c6b0-fbe0-52d2-9297-1454f53b6452" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186239610} {:answer/id #uuid "f512eece-de08-5c13-ae53-369aa60ff55b" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186240219}] :answer-field/correct {:db/id #edb/ref 17592186238099} :answer-field/id #uuid "257c3c3e-fb71-526d-8119-cd61bd75c90e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240396}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2b7aaa73-fdec-536a-866a-953c6856f39f" :question/math-academy-id "q-105169" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 5 \\\\ -2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}1 \\\\ 6 \\\\ -2\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}-1 \\\\ -8 \\\\ 2\\end{bmatrix},\\,b=\\begin{bmatrix}2 \\\\ -3 \\\\ 4\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ 5 \\\\ -2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}1 \\\\ 6 \\\\ -2\\end{bmatrix}+{x}_{3}\\begin{bmatrix}-1 \\\\ -8 \\\\ 2\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ -3 \\\\ 4\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ 5{x}_{1} \\\\ -2{x}_{1}\\end{bmatrix}+\\begin{bmatrix}{x}_{2} \\\\ 6{x}_{2} \\\\ -2{x}_{2}\\end{bmatrix}+\\begin{bmatrix}-{x}_{3} \\\\ -8{x}_{3} \\\\ 2{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ -3 \\\\ 4\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}+{x}_{2}-{x}_{3} \\\\ 5{x}_{1}+6{x}_{2}-8{x}_{3} \\\\ -2{x}_{1}-2{x}_{2}+2{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ -3 \\\\ 4\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2}-{x}_{3} &=2 \\\\ 5{x}_{1}+6{x}_{2}-8{x}_{3} &=-3 \\\\ -2{x}_{1}-2{x}_{2}+2{x}_{3} &=4\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\begin{bmatrix}1 & 1 & -1 & 2 \\\\ 5 & 6 & -8 & -3 \\\\ -2 & -2 & 2 & 4\\end{bmatrix}.\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 1 & -1 & 2 \\\\ 5 & 6 & -8 & -3 \\\\ -2 & -2 & 2 & 4\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-5){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & -1 & 2 \\\\ 0 & 1 & -3 & -13 \\\\ -2 & -2 & 2 & 4\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & -1 & 2 \\\\ 0 & 1 & -3 & -13 \\\\ 0 & 0 & 0 & 8\\end{bmatrix}.\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2}-{x}_{3} &=2 \\\\ {x}_{2}-3{x}_{3} &=-13 \\\\ 0 &=8.\\end{aligned}\\right.\n$$\n\nHowever, the final equation $0=8$  gives a false statement. So the system has no solution."} {:db/id #edb/ref 17592186240994 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "200cb18f-f334-5cc1-92fe-59276f6e627e" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186238331} {:answer/id #uuid "355fb48b-9360-5e64-a49e-28f3e7ce5c33" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186238517} {:answer/id #uuid "43ccb6b1-1509-50bb-81b1-0c4a73a41e16" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186238644} {:answer/id #uuid "5d4f778a-7cda-5396-b040-7a95240b101b" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186238869} {:answer/id #uuid "ac46ea11-5d88-5152-b8a7-428c01fce429" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186239552}] :answer-field/correct {:db/id #edb/ref 17592186238644} :answer-field/id #uuid "8483c7ae-14b3-59f6-a280-e2621e06ed0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240565}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e2bdebea-6388-5baf-ba9f-1fbe0535b5cc" :question/math-academy-id "q-105170" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ -1 \\\\ 2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}4 \\\\ -3 \\\\ 8\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}7 \\\\ -7 \\\\ 14\\end{bmatrix},\\,b=\\begin{bmatrix}5 \\\\ -3 \\\\ 7\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ -1 \\\\ 2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}4 \\\\ -3 \\\\ 8\\end{bmatrix}+{x}_{3}\\begin{bmatrix}7 \\\\ -7 \\\\ 14\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ -3 \\\\ 7\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ -{x}_{1} \\\\ 2{x}_{1}\\end{bmatrix}+\\begin{bmatrix}4{x}_{2} \\\\ -3{x}_{2} \\\\ 8{x}_{2}\\end{bmatrix}+\\begin{bmatrix}7{x}_{3} \\\\ -7{x}_{3} \\\\ 14{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ -3 \\\\ 7\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}+4{x}_{2}+7{x}_{3} \\\\ -{x}_{1}-3{x}_{2}-7{x}_{3} \\\\ 2{x}_{1}+8{x}_{2}+14{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ -3 \\\\ 7\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+4{x}_{2}+7{x}_{3} &=5 \\\\ -{x}_{1}-3{x}_{2}-7{x}_{3} &=-3 \\\\ 2{x}_{1}+8{x}_{2}+14{x}_{3} &=7\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\begin{bmatrix}1 & 4 & 7 & 5 \\\\ -1 & -3 & -7 & -3 \\\\ 2 & 8 & 14 & 7\\end{bmatrix}.\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 4 & 7 & 5 \\\\ -1 & -3 & -7 & -3 \\\\ 2 & 8 & 14 & 7\\end{bmatrix} & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 4 & 7 & 5 \\\\ 0 & 1 & 0 & 2 \\\\ 2 & 8 & 14 & 7\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 4 & 7 & 5 \\\\ 0 & 1 & 0 & 2 \\\\ 0 & 0 & 0 & -3\\end{bmatrix}.\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+4{x}_{2}+7{x}_{3} &=5 \\\\ {x}_{2} &=2 \\\\ 0 &=-3.\\end{aligned}\\right.\n$$\n\nHowever, the final equation $0=-3$  gives a false statement. So the system has no solution."} {:db/id #edb/ref 17592186240995 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43158102-a49d-59d4-a923-5df48591288f" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186238639} {:answer/id #uuid "7f08fc6f-64b7-5004-936e-7a6c7b50f76f" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186239160} {:answer/id #uuid "c032bb3d-2af4-5439-b0a3-83a63b9db908" :answer/type {:db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186239727} {:answer/id #uuid "c25ef7e8-5b9c-591c-b034-15f9595ed22c" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186239760} {:answer/id #uuid "c7d1ebe2-d9a0-588f-835e-881ce34c1378" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186239813}] :answer-field/correct {:db/id #edb/ref 17592186238639} :answer-field/id #uuid "83fca8c2-1efe-5ca1-813a-6af2b882ac08" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240564}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e25147c5-4650-58c3-bac2-7139801cca6b" :question/math-academy-id "q-105172" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ -5 \\\\ -3\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}4 \\\\ -21 \\\\ -12\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}-3 \\\\ 14 \\\\ 9\\end{bmatrix},\\,b=\\begin{bmatrix}2 \\\\ 8 \\\\ -7\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ -5 \\\\ -3\\end{bmatrix}+{x}_{2}\\begin{bmatrix}4 \\\\ -21 \\\\ -12\\end{bmatrix}+{x}_{3}\\begin{bmatrix}-3 \\\\ 14 \\\\ 9\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ 8 \\\\ -7\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ -5{x}_{1} \\\\ -3{x}_{1}\\end{bmatrix}+\\begin{bmatrix}4{x}_{2} \\\\ -21{x}_{2} \\\\ -12{x}_{2}\\end{bmatrix}+\\begin{bmatrix}-3{x}_{3} \\\\ 14{x}_{3} \\\\ 9{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ 8 \\\\ -7\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}+4{x}_{2}-3{x}_{3} \\\\ -5{x}_{1}-21{x}_{2}+14{x}_{3} \\\\ -3{x}_{1}-12{x}_{2}+9{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ 8 \\\\ -7\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+4{x}_{2}-3{x}_{3} &=2 \\\\ -5{x}_{1}-21{x}_{2}+14{x}_{3} &=8 \\\\ -3{x}_{1}-12{x}_{2}+9{x}_{3} &=-7\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\begin{bmatrix}1 & 4 & -3 & 2 \\\\ -5 & -21 & 14 & 8 \\\\ -3 & -12 & 9 & -7\\end{bmatrix}.\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 4 & -3 & 2 \\\\ -5 & -21 & 14 & 8 \\\\ -3 & -12 & 9 & -7\\end{bmatrix} & {R}_{2} & :={R}_{2}+5{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 4 & -3 & 2 \\\\ 0 & -1 & -1 & 18 \\\\ -3 & -12 & 9 & -7\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 4 & -3 & 2 \\\\ 0 & -1 & -1 & 18 \\\\ 0 & 0 & 0 & -1\\end{bmatrix}.\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+4{x}_{2}-3{x}_{3} &=2 \\\\ -{x}_{2}-{x}_{3} &=18 \\\\ 0 &=-1.\\end{aligned}\\right.\n$$\n\nHowever, the final equation $0=-1$  gives a false statement. So the system has no solution."} {:db/id #edb/ref 17592186342126 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3430db20-ef90-5054-8d8b-b6f798f4c553" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186339592} {:answer/id #uuid "351054d6-ba57-5e06-82bb-d7c3e717e126" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186339598} {:answer/id #uuid "bf850701-8c93-5374-9a42-dca7c25ca858" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186340836} {:answer/id #uuid "cf811142-93c6-5d20-b217-29c2c57c680b" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186340975} {:answer/id #uuid "dbf87647-1ef7-5b76-85e7-37be4269b0ee" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186341081}] :answer-field/correct {:db/id #edb/ref 17592186339598} :answer-field/id #uuid "85f23f2c-e934-5f48-ab5a-edc1193c2c22" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341615}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "33debd45-f90c-578d-9c6b-11c54937ac6b" :question/math-academy-id "q-73992" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 0 \\\\ 3\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-1 \\\\ 0 \\\\ -1\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}2 \\\\ 5 \\\\ 1\\end{bmatrix},\\,b=\\begin{bmatrix}-5 \\\\ -10 \\\\ 1\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ 0 \\\\ 3\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-1 \\\\ 0 \\\\ -1\\end{bmatrix}+{x}_{3}\\begin{bmatrix}2 \\\\ 5 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}-5 \\\\ -10 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ 0 \\\\ 3{x}_{1}\\end{bmatrix}+\\begin{bmatrix}-{x}_{2} \\\\ 0 \\\\ -{x}_{2}\\end{bmatrix}+\\begin{bmatrix}2{x}_{3} \\\\ 5{x}_{3} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}-5 \\\\ -10 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}-{x}_{2}+2{x}_{3} \\\\ 5{x}_{3} \\\\ 3{x}_{1}-{x}_{2}+{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}-5 \\\\ -10 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2}+2{x}_{3} &=-5 \\\\ 5{x}_{3} &=-10 \\\\ 3{x}_{1}-{x}_{2}+{x}_{3} &=1\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\begin{bmatrix}1 & -1 & 2 & -5 \\\\ 0 & 0 & 5 & -10 \\\\ 3 & -1 & 1 & 1\\end{bmatrix}\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -1 & 2 & -5 \\\\ 0 & 0 & 5 & -10 \\\\ 3 & -1 & 1 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}-3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 & -5 \\\\ 0 & 0 & 5 & -10 \\\\ 0 & 2 & -5 & 16\\end{bmatrix} & {R}_{2} & ↔{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 & -5 \\\\ 0 & 2 & -5 & 16 \\\\ 0 & 0 & 5 & -10\\end{bmatrix} & {R}_{2} & :=\\frac{1}{2}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 & -5 \\\\ 0 & 1 & -2.5 & 8 \\\\ 0 & 0 & 5 & -10\\end{bmatrix} & {R}_{3} & :=\\frac{1}{5}{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 & -5 \\\\ 0 & 1 & -2.5 & 8 \\\\ 0 & 0 & 1 & -2\\end{bmatrix}.\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2}+2{x}_{3} &=-5 \\\\ {x}_{2}-2.5\\,{x}_{3} &=8 \\\\ {x}_{3} &=-2.\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get ${x}_{3}=-2.$ Substituting this value into the second equation, we get \n\n$$\n{x}_{2}-2.5(-2)=8\\,⟹\\,{x}_{2}=8-5=3.\n$$\n\nFinally,  substituting ${x}_{2}=3$ and ${x}_{3}=-2$  into the first equation, we obtain\n\n$$\n{x}_{1}-(3)+2(-2)=-5\\,⟹\\,{x}_{1}=2.\n$$\n\nSo, the solution of the system is ${x}_{1}=2$, ${x}_{2}=3$, and ${x}_{3}=-2,$ which means \n\n$$\n2{a}_{1}+3{a}_{2}-2{a}_{3}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=2+3-2=3.\n$$"} {:db/id #edb/ref 17592186342130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ca1e367-7e59-5b69-861b-8c5df685d98a" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186339240} {:answer/id #uuid "70e98200-2ef8-5fee-9135-1a64cdf08565" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186340130} {:answer/id #uuid "a0f91210-c308-5ac5-8b5f-ecea8232309c" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186340589} {:answer/id #uuid "cd78319b-964c-5a76-83e0-5cc4ba5b698b" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186340951} {:answer/id #uuid "d5c0ee9d-d678-5d90-ac70-ae36c44cd666" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186341020}] :answer-field/correct {:db/id #edb/ref 17592186340951} :answer-field/id #uuid "d6466acd-a8cc-51d2-bb7d-d48bfacf96c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341757}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ff5142a4-ab7b-5300-baa5-14f6253ed7fa" :question/math-academy-id "q-74006" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}2 \\\\ -1 \\\\ -1\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}0 \\\\ -1 \\\\ -3\\end{bmatrix},\\,b=\\begin{bmatrix}-2 \\\\ 5 \\\\ 1\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then   we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ -1 \\\\ -1\\end{bmatrix}+{x}_{3}\\begin{bmatrix}0 \\\\ -1 \\\\ -3\\end{bmatrix} & =\\begin{bmatrix}-2 \\\\ 5 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ 0 \\\\ {x}_{1}\\end{bmatrix}+\\begin{bmatrix}2{x}_{2} \\\\ -{x}_{2} \\\\ -{x}_{2}\\end{bmatrix}+\\begin{bmatrix}0 \\\\ -{x}_{3} \\\\ -3{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}-2 \\\\ 5 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}+2{x}_{2} \\\\ -{x}_{2}-{x}_{3} \\\\ {x}_{1}-{x}_{2}-3{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}-2 \\\\ 5 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2} &=-2 \\\\ -{x}_{2}-{x}_{3} &=5 \\\\ {x}_{1}-{x}_{2}-3{x}_{3} &=1\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\begin{bmatrix}1 & 2 & 0 & -2 \\\\ 0 & -1 & -1 & 5 \\\\ 1 & -1 & -3 & 1\\end{bmatrix}.\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & 0 & -2 \\\\ 0 & -1 & -1 & 5 \\\\ 1 & -1 & -3 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 0 & -2 \\\\ 0 & -1 & -1 & 5 \\\\ 0 & -3 & -3 & 3\\end{bmatrix} & {R}_{2} & :=(-1){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 2 & 0 & -2 \\\\ 0 & 1 & 1 & -5 \\\\ 0 & -3 & -3 & 3\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 2 & 0 & -2 \\\\ 0 & 1 & 1 & -5 \\\\ 0 & 0 & 0 & -12\\end{bmatrix}.\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2} &=-2 \\\\ {x}_{2}+{x}_{3} &=-5 \\\\ 0 &=-12.\\end{aligned}\\right.\n$$\n\nHowever, the final equation $0=-12$  gives a false statement. So the system has no solution."} {:db/id #edb/ref 17592186342132 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cd5d137-daee-5d6d-98d8-3497a80c61ea" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186339245} {:answer/id #uuid "1d07c66f-c54f-5a22-89c4-35d7095387f8" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186339379} {:answer/id #uuid "87f4b2e6-5682-5dda-9d57-6cd28ab535f2" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186340346} {:answer/id #uuid "90e508ef-9eec-5c7a-8be0-834a65ad1d3d" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186340427} {:answer/id #uuid "9316673f-9aac-5adc-b91d-046d54518f3f" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186340450}] :answer-field/correct {:db/id #edb/ref 17592186340346} :answer-field/id #uuid "2eff5ea8-b869-5727-bf8d-1f462e27220d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341460}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6ca28715-77ca-55f5-9aad-4851b6f70f79" :question/math-academy-id "q-74028" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}1 \\\\ 3 \\\\ 1\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}3 \\\\ 3 \\\\ 1\\end{bmatrix},\\,b=\\begin{bmatrix}-1 \\\\ -9 \\\\ 1\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}-{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}+{x}_{2}\\begin{bmatrix}1 \\\\ 3 \\\\ 1\\end{bmatrix}+{x}_{3}\\begin{bmatrix}3 \\\\ 3 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}-1 \\\\ -9 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ 0 \\\\ {x}_{1}\\end{bmatrix}+\\begin{bmatrix}{x}_{2} \\\\ 3{x}_{2} \\\\ {x}_{2}\\end{bmatrix}+\\begin{bmatrix}3{x}_{3} \\\\ 3{x}_{3} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}-1 \\\\ -9 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}+{x}_{2}+3{x}_{3} \\\\ 3{x}_{2}+3{x}_{3} \\\\ {x}_{1}+{x}_{2}+{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}-1 \\\\ -9 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2}+3{x}_{3} &=-1 \\\\ 3{x}_{2}+3{x}_{3} &=-9 \\\\ {x}_{1}+{x}_{2}+{x}_{3} &=1\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\begin{bmatrix}1 & 1 & 3 & -1 \\\\ 0 & 3 & 3 & -9 \\\\ 1 & 1 & 1 & 1\\end{bmatrix}.\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 1 & 3 & -1 \\\\ 0 & 3 & 3 & -9 \\\\ 1 & 1 & 1 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & 3 & -1 \\\\ 0 & 3 & 3 & -9 \\\\ 0 & 0 & -2 & 2\\end{bmatrix} & {R}_{2} & :=\\frac{1}{3}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 1 & 3 & -1 \\\\ 0 & 1 & 1 & -3 \\\\ 0 & 0 & -2 & 2\\end{bmatrix} & {R}_{3} & :=-\\frac{1}{2}{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 1 & 3 & -1 \\\\ 0 & 1 & 1 & -3 \\\\ 0 & 0 & 1 & -1\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2}+3{x}_{3} &=-1 \\\\ {x}_{2}+{x}_{3} &=-3 \\\\ {x}_{3} &=-1.\\end{aligned}\\right.\n$$\n\n \n\nFrom the third equation, we get ${x}_{3}=-1.$ Substituting this value into the second equation, we get\n\n$$\n{x}_{2}+(-1)=-3\\,⟹\\,{x}_{2}=-2.\n$$\n\nFinally, by substituting ${x}_{2}=-2,{x}_{3}=-1$ into the first equation, we obtain\n\n$$\n\\begin{aligned}{x}_{1}+{x}_{2}+3{x}_{3} & =-1 \\\\ {x}_{1}+(-2)+3(-1) & =-1 \\\\ {x}_{1}-5 & =-1 \\\\ {x}_{1} & =4.\\end{aligned}\n$$\n\nSo, the solution of the system is ${x}_{1}=4$, ${x}_{2}=-2$, and ${x}_{3}=-1,$ which means \n\n$$\n4{a}_{1}-2{a}_{2}-{a}_{3}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}-{x}_{3}=4+(-2)-(-1)=3.\n$$"} {:db/id #edb/ref 17592186342133 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dd1e2d3-3d25-597c-a847-faa140432c9c" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186339255} {:answer/id #uuid "28a2b981-6db8-5f16-b21b-6ae088a23e3d" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186339484} {:answer/id #uuid "309c51a6-6646-55e5-a9ef-db0cd36bd5b0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186339553} {:answer/id #uuid "732f8930-5de1-53c0-8f9f-0564fc2ea176" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186340149} {:answer/id #uuid "d7a94670-179b-5241-8088-b40d00d22100" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186341041}] :answer-field/correct {:db/id #edb/ref 17592186339553} :answer-field/id #uuid "95f0dc3f-6280-5dbc-ad92-0375cafd9b79" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341644}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "237520c7-3369-5c34-87a7-ba4be3c9b705" :question/math-academy-id "q-74032" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}1 \\\\ -2 \\\\ 2\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}3 \\\\ -11 \\\\ 1\\end{bmatrix},\\,b=\\begin{bmatrix}5 \\\\ -18 \\\\ -1\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}+{x}_{2}\\begin{bmatrix}1 \\\\ -2 \\\\ 2\\end{bmatrix}+{x}_{3}\\begin{bmatrix}3 \\\\ -11 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ -18 \\\\ -1\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ 0 \\\\ {x}_{1}\\end{bmatrix}+\\begin{bmatrix}{x}_{2} \\\\ -2{x}_{2} \\\\ 2{x}_{2}\\end{bmatrix}+\\begin{bmatrix}3{x}_{3} \\\\ -11{x}_{3} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ -18 \\\\ -1\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}+{x}_{2}+3{x}_{3} \\\\ -2{x}_{2}-11{x}_{3} \\\\ {x}_{1}+2{x}_{2}+{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ -18 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2}+3{x}_{3} &=5 \\\\ -2{x}_{2}-11{x}_{3} &=-18 \\\\ {x}_{1}+2{x}_{2}+{x}_{3} &=-1\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\begin{bmatrix}1 & 1 & 3 & 5 \\\\ 0 & -2 & -11 & -18 \\\\ 1 & 2 & 1 & -1\\end{bmatrix}.\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 1 & 3 & 5 \\\\ 0 & -2 & -11 & -18 \\\\ 1 & 2 & 1 & -1\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & 3 & 5 \\\\ 0 & -2 & -11 & -18 \\\\ 0 & 1 & -2 & -6\\end{bmatrix} & {R}_{2} & ↔{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 1 & 3 & -1 \\\\ 0 & 1 & -2 & -6 \\\\ 0 & -2 & -11 & -18\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 1 & 3 & 5 \\\\ 0 & 1 & -2 & -6 \\\\ 0 & 0 & -15 & -30\\end{bmatrix} & {R}_{3} & :=-\\frac{1}{15}{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 1 & 3 & 5 \\\\ 0 & 1 & -2 & -6 \\\\ 0 & 0 & 1 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2}+3{x}_{3} &=5 \\\\ {x}_{2}-2{x}_{3} &=-6 \\\\ {x}_{3} &=2.\\end{aligned}\\right.\n$$\n\n \n\nFrom the third equation, we get ${x}_{3}=2.$ Substituting this value into  the second equation, we get\n\n$$\n{x}_{2}-2(2)=-6\\,⟹\\,{x}_{2}=-2.\n$$\n\n \n\nFinally, by substituting ${x}_{2}=-2$ and ${x}_{3}=2$ into the first equation, we obtain \n\n$$\n\\begin{aligned}{x}_{1}+{x}_{2}+3{x}_{3} & =5 \\\\ {x}_{1}+(-2)+3(2) & =5 \\\\ {x}_{1}+4 & =5 \\\\ {x}_{1} & =1.\\end{aligned}\n$$\n\nSo, the solution of the system is ${x}_{1}=1$, ${x}_{2}=-2$, and ${x}_{3}=2,$ which means \n\n$$\n{a}_{1}-2{a}_{2}+2{a}_{3}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=1+(-2)+2=1.\n$$"} {:db/id #edb/ref 17592186342134 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c3b744a-01a9-54ce-8529-5a08f78940d9" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186339816} {:answer/id #uuid "60e09ff1-d3cc-58ef-8987-5a5f148e2536" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186339992} {:answer/id #uuid "8a3631e7-ceb5-57d9-884a-4e22407dcb9d" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186340363} {:answer/id #uuid "9ad3c54b-5811-537d-84b5-61c05d4666df" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186340526} {:answer/id #uuid "a932259c-57be-54ad-a6fe-9cb2e6f3f068" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186340667}] :answer-field/correct {:db/id #edb/ref 17592186340667} :answer-field/id #uuid "84898483-2191-5459-b5c9-62b59dd71df8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341612}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "118e9ea0-84b3-5e8f-866f-104da032b6d7" :question/math-academy-id "q-74035" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 0 \\\\ 3\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-1 \\\\ 5 \\\\ 2\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix},\\,b=\\begin{bmatrix}-3 \\\\ 4 \\\\ -4\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ 0 \\\\ 3\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-1 \\\\ 5 \\\\ 2\\end{bmatrix}+{x}_{3}\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix} & =\\begin{bmatrix}-3 \\\\ 4 \\\\ -4\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ 0 \\\\ 3{x}_{1}\\end{bmatrix}+\\begin{bmatrix}-{x}_{2} \\\\ 5{x}_{2} \\\\ 2{x}_{2}\\end{bmatrix}+\\begin{bmatrix}0 \\\\ {x}_{3} \\\\ 0\\end{bmatrix} & =\\begin{bmatrix}-3 \\\\ 4 \\\\ -4\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}-{x}_{2} \\\\ 5{x}_{2}+{x}_{3} \\\\ 3{x}_{1}+2{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-3 \\\\ 4 \\\\ -4\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2} &=-3 \\\\ 5{x}_{2}+{x}_{3} &=4 \\\\ 3{x}_{1}+2{x}_{2} &=-4\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\begin{bmatrix}1 & -1 & 0 & -3 \\\\ 0 & 5 & 1 & 4 \\\\ 3 & 2 & 0 & -4\\end{bmatrix}\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -1 & 0 & -3 \\\\ 0 & 5 & 1 & 4 \\\\ 3 & 2 & 0 & -4\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 0 & -3 \\\\ 0 & 5 & 1 & 4 \\\\ 0 & 5 & 0 & 5\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-1){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -1 & 0 & -3 \\\\ 0 & 5 & 1 & 4 \\\\ 0 & 0 & -1 & 1\\end{bmatrix} & {R}_{2} & :=\\frac{1}{5}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -1 & 0 & -3 \\\\ 0 & 1 & 0.2 & 0.8 \\\\ 0 & 0 & -1 & 1\\end{bmatrix} & {R}_{3} & :=-{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & -1 & 0 & -3 \\\\ 0 & 1 & 0.2 & 0.8 \\\\ 0 & 0 & 1 & -1\\end{bmatrix}.\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2} &=-3 \\\\ {x}_{2}+\\,0.2{x}_{3} &=0.8 \\\\ {x}_{3} &=-1.\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get ${x}_{3}=-1.$ Substituting this value into the second equation, we get \n\n$$\n{x}_{2}+0.2(-1)=0.8\\,⟹\\,{x}_{2}=1.\n$$\n\n   \n\nFinally,  substituting ${x}_{2}=1$ into the first equation, we obtain\n\n$$\n{x}_{1}-(1)=-3\\,⟹\\,{x}_{1}=-2.\n$$\n\nSo, the solution of the system is ${x}_{1}=-2$, ${x}_{2}=1$, and ${x}_{3}=-1,$ which means  \n\n$$\n-2{a}_{1}+{a}_{2}-{a}_{3}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=-2+1-1=-2.\n$$"} {:db/id #edb/ref 17592186342138 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11e315df-67b1-5a51-8722-8b611d6b4f04" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186339284} {:answer/id #uuid "63215e56-f763-5d47-ad93-5bf665123767" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186340010} {:answer/id #uuid "cb20f6ae-be9d-53d3-9a62-422bcfb9533a" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186340927} {:answer/id #uuid "e2f1ab45-f348-545f-bf2c-ba9c88f197d8" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186341136} {:answer/id #uuid "f0ac09fc-fbae-5dfd-bb2b-94215e0d375c" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186341248}] :answer-field/correct {:db/id #edb/ref 17592186341248} :answer-field/id #uuid "f04b6cf2-abe9-50ed-8eee-447e512fcc60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341811}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a8d414ab-92e5-5218-83d9-6fd3ed558d87" :question/math-academy-id "q-74046" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 0 \\\\ 2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}0 \\\\ 1 \\\\ -1\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}1 \\\\ -2 \\\\ 0\\end{bmatrix},\\,b=\\begin{bmatrix}8 \\\\ -6 \\\\ 2\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ 0 \\\\ 2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ 1 \\\\ -1\\end{bmatrix}+{x}_{3}\\begin{bmatrix}1 \\\\ -2 \\\\ 0\\end{bmatrix} & =\\begin{bmatrix}8 \\\\ -6 \\\\ 2\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ 0 \\\\ 2{x}_{1}\\end{bmatrix}+\\begin{bmatrix}0 \\\\ {x}_{2} \\\\ -{x}_{2}\\end{bmatrix}+\\begin{bmatrix}{x}_{3} \\\\ -2{x}_{3} \\\\ 0\\end{bmatrix} & =\\begin{bmatrix}8 \\\\ -6 \\\\ 2\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}+{x}_{3} \\\\ {x}_{2}-2{x}_{3} \\\\ 2{x}_{1}-{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}8 \\\\ -6 \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{3} &=8 \\\\ {x}_{2}-2{x}_{3} &=-6 \\\\ 2{x}_{1}-{x}_{2} &=2\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\begin{bmatrix}1 & 0 & 1 & 8 \\\\ 0 & 1 & -2 & -6 \\\\ 2 & -1 & 0 & 2\\end{bmatrix}\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 0 & 1 & 8 \\\\ 0 & 1 & -2 & -6 \\\\ 2 & -1 & 0 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 1 & 8 \\\\ 0 & 1 & -2 & -6 \\\\ 0 & -1 & -2 & -14\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 1 & 8 \\\\ 0 & 1 & -2 & -6 \\\\ 0 & 0 & -4 & -20\\end{bmatrix} & {R}_{3} & :=-\\frac{1}{4}{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 0 & 1 & 8 \\\\ 0 & 1 & -2 & -6 \\\\ 0 & 0 & 1 & 5\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, the system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{3} &=8 \\\\ {x}_{2}-2{x}_{3} &=-6 \\\\ {x}_{3} &=5.\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get ${x}_{3}=5.$ Substituting this value in the second and first equations, we obtain\n\n$$\n\\begin{aligned} & {x}_{2}-2(5)=-6\\,⟹\\,{x}_{2}=4 \\\\  & {x}_{1}+5=8\\,⟹\\,{x}_{1}=3.\\end{aligned}\n$$\n\nSo, the solution of the system is ${x}_{1}=3$, ${x}_{2}=4$, and ${x}_{3}=5,$ which means \n\n$$\n3{a}_{1}+4{a}_{2}+5{a}_{3}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=3+4+5=12.\n$$"} {:db/id #edb/ref 17592186371499 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf8efcb6-f1b1-576a-a750-35914835105a" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186371501} {:answer/id #uuid "f03805a7-390e-5218-9aba-0d3067bb4713" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186371502} {:answer/id #uuid "9fc31602-b9d2-56f8-a57a-90749cf42c78" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186371503} {:answer/id #uuid "ea94efc8-3987-5798-8f16-29bc2348a033" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186371504} {:answer/id #uuid "c15415b1-26d3-51b7-9cfa-09a0452f811d" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186371505}] :answer-field/correct {:db/id #edb/ref 17592186371503} :answer-field/id #uuid "22d80b2a-30bb-5d27-bb13-817743c9301f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186371500}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1eebc51b-6af1-57eb-9255-9e266158abc7" :question/math-academy-id "q-105171" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-5 \\\\ -8 \\\\ 5\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}-1 \\\\ 2 \\\\ 1\\end{bmatrix},\\,b=\\begin{bmatrix}1 \\\\ 9 \\\\ 1\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-5 \\\\ -8 \\\\ 5\\end{bmatrix}+{x}_{3}\\begin{bmatrix}-1 \\\\ 2 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ 9 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ 2{x}_{1} \\\\ -{x}_{1}\\end{bmatrix}+\\begin{bmatrix}-5{x}_{2} \\\\ -8{x}_{2} \\\\ 5{x}_{2}\\end{bmatrix}+\\begin{bmatrix}-{x}_{3} \\\\ 2{x}_{3} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ 9 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}-5{x}_{2}-{x}_{3} \\\\ 2{x}_{1}-8{x}_{2}+2{x}_{3} \\\\ -{x}_{1}+5{x}_{2}+{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ 9 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-5{x}_{2}-{x}_{3} &=1 \\\\ 2{x}_{1}-8{x}_{2}+2{x}_{3} &=9 \\\\ -{x}_{1}+5{x}_{2}+{x}_{3} &=1\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\begin{bmatrix}1 & -5 & -1 & 1 \\\\ 2 & -8 & 2 & 9 \\\\ -1 & 5 & 1 & 1\\end{bmatrix}.\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -5 & -1 & 1 \\\\ 2 & -8 & 2 & 9 \\\\ -1 & 5 & 1 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -5 & -1 & 1 \\\\ 0 & 2 & 4 & 7 \\\\ -1 & 5 & 1 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -5 & -1 & 1 \\\\ 0 & 2 & 4 & 7 \\\\ 0 & 0 & 0 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-5{x}_{2}-{x}_{3} &=1 \\\\ 2{x}_{2}+4{x}_{3} &=7 \\\\ 0 &=2.\\end{aligned}\\right.\n$$\n\nHowever, the final equation $0=2$  gives a false statement. So the system has no solution."}] :knowledge-point/title "Solving for Three Coefficients in a Linear Combination"} :step/id #uuid "d59e4b4d-f7e2-5722-8cf4-a309ea8ac925" :step/math-academy-id 23175}] :activity/title "Linear Combinations of Vectors in N-Dimensional Euclidean Space" :activity/type {:db/id #edb/ref 17592186045463} :db/id #edb/ref 17592186120045} {:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186435827} :activity/id #uuid "6df862cd-4cbb-5ff7-8a8e-426d6f6d3fd6" :activity/scope {:db/id #edb/ref 17592186048499} :activity/steps [{:db/id #edb/ref 17592186435826 :step/content {:db/id #edb/ref 17592186240990 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "222862ae-7c2b-5d66-9d9a-f59640c9801e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186238354} {:answer/id #uuid "346bdb71-8966-5ed4-ab2e-83d1ea69e239" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186238507} {:answer/id #uuid "4072326e-9528-5390-aaaa-546988c57563" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186238613} {:answer/id #uuid "4f101a20-f607-5e7e-b164-71aebdad2935" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No solution" :db/id #edb/ref 17592186238733} {:answer/id #uuid "61153d6d-bad7-5e46-a284-cae191fc9a25" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186238908}] :answer-field/correct {:db/id #edb/ref 17592186238507} :answer-field/id #uuid "47a0ee5a-75fc-5e2b-8002-cf62c42bfe1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240456}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a4963b43-3177-544a-ab68-1ea699a13395" :question/math-academy-id "q-105166" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ -2 \\\\ 3\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}2 \\\\ -3 \\\\ 5\\end{bmatrix},\\,b=\\begin{bmatrix}-3 \\\\ 1 \\\\ -4\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b,$ then what is ${x}_{1}+{x}_{2}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ -2 \\\\ 3\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ -3 \\\\ 5\\end{bmatrix} & =\\begin{bmatrix}-3 \\\\ 1 \\\\ -4\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ -2{x}_{1} \\\\ 3{x}_{1}\\end{bmatrix}+\\begin{bmatrix}2{x}_{2} \\\\ -3{x}_{2} \\\\ 5{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-3 \\\\ 1 \\\\ -4\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}+2{x}_{2} \\\\ -2{x}_{1}-3{x}_{2} \\\\ 3{x}_{1}+5{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-3 \\\\ 1 \\\\ -4\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2} &=-3 \\\\ -2{x}_{1}-3{x}_{2} &=1 \\\\ 3{x}_{1}+5{x}_{2} &=-4\\end{aligned}\\right.\n$$\n\nMultiplying the first equation by $2$ and adding the resulting equations, we obtain \n\n$$\n\\begin{aligned}{x}_{2} & =-5,\\end{aligned}\n$$\n\nwhich we substitute into the second equation to get \n\n$$\n\\begin{aligned}-2{x}_{1}-3{x}_{2}=1 \\\\ -2{x}_{1}-3(-5) & =1 \\\\ -2{x}_{1} & =-14 \\\\ {x}_{1} & =7.\\end{aligned}\n$$\n\nFinally, we substitute ${x}_{1}=7$ and ${x}_{2}=-5$ into the third equation and obtain\n\n$$\n\\begin{aligned}3{x}_{1}+5{x}_{2}=-4 \\\\ 3(7)+5(-5) & =-4 \\\\ -4 & =-4,\\end{aligned}\n$$\n\nwhich gives a true statement. \n\nSo the solution of the system is ${x}_{1}=7$ and ${x}_{2}=-5,$ which means\n\n$$\n7{a}_{1}-5{a}_{2}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}=7+(-5)=2.\n$$"} :step/id #uuid "130d098a-c26b-57ed-9a17-40b7cc7b707e"} {:db/id #edb/ref 17592186435827 :step/content {:db/id #edb/ref 17592186435824 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b3b3e4e-ca03-5bf0-b918-e879378cf4f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186435813} {:answer/id #uuid "3e56b548-f823-5efc-89ba-5bfa7fe486df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186435814} {:answer/id #uuid "62cff3cd-01fc-5c8d-bb73-00c6490598f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-11" :db/id #edb/ref 17592186435815} {:answer/id #uuid "7f4f8e1e-a357-552c-aea0-48de6f4f316a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186435817} {:answer/id #uuid "a0c118c7-81b9-5bfc-90ce-dd9634f5f92e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186435820}] :answer-field/correct {:db/id #edb/ref 17592186435814} :answer-field/id #uuid "a66e7a5d-9617-5080-a5e0-b50e86007465" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186435823}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e8bdc664-5423-57fc-a753-871b318d24e0" :question/math-academy-id "q-34598" :question/problem "Find the value of ${x}_{1}-{x}_{2}$ given that  $4a+3x=b$ and\n\n$$\na=\\begin{bmatrix}3 \\\\ 3 \\\\ 3\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix},\\,b=\\begin{bmatrix}18 \\\\ -15 \\\\ -9\\end{bmatrix}.\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $x,$ we get\n\n$$\n\\begin{aligned}4a+3x & =b \\\\ 3x & =b-4a \\\\ x & =\\frac{1}{3}(b-4a) \\\\ x & =\\frac{1}{3}(\\begin{bmatrix}18 \\\\ -15 \\\\ -9\\end{bmatrix}-4\\begin{bmatrix}3 \\\\ 3 \\\\ 3\\end{bmatrix}) \\\\ x & =\\frac{1}{3}\\begin{bmatrix}6 \\\\ -27 \\\\ -21\\end{bmatrix} \\\\ x & =\\begin{bmatrix}2 \\\\ -9 \\\\ -7\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, ${x}_{1}-{x}_{2}=2-(-9)=11.$"} :step/id #uuid "1ba155e6-7a63-58b8-ae54-fd477a157b3e" :step/next {:db/id #edb/ref 17592186435830}} {:db/id #edb/ref 17592186435828 :step/content {:db/id #edb/ref 17592186342133 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dd1e2d3-3d25-597c-a847-faa140432c9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186339255} {:answer/id #uuid "28a2b981-6db8-5f16-b21b-6ae088a23e3d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No solution" :db/id #edb/ref 17592186339484} {:answer/id #uuid "309c51a6-6646-55e5-a9ef-db0cd36bd5b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186339553} {:answer/id #uuid "732f8930-5de1-53c0-8f9f-0564fc2ea176" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186340149} {:answer/id #uuid "d7a94670-179b-5241-8088-b40d00d22100" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186341041}] :answer-field/correct {:db/id #edb/ref 17592186339553} :answer-field/id #uuid "95f0dc3f-6280-5dbc-ad92-0375cafd9b79" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341644}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "237520c7-3369-5c34-87a7-ba4be3c9b705" :question/math-academy-id "q-74032" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}1 \\\\ -2 \\\\ 2\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}3 \\\\ -11 \\\\ 1\\end{bmatrix},\\,b=\\begin{bmatrix}5 \\\\ -18 \\\\ -1\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}+{x}_{2}\\begin{bmatrix}1 \\\\ -2 \\\\ 2\\end{bmatrix}+{x}_{3}\\begin{bmatrix}3 \\\\ -11 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ -18 \\\\ -1\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ 0 \\\\ {x}_{1}\\end{bmatrix}+\\begin{bmatrix}{x}_{2} \\\\ -2{x}_{2} \\\\ 2{x}_{2}\\end{bmatrix}+\\begin{bmatrix}3{x}_{3} \\\\ -11{x}_{3} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ -18 \\\\ -1\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}+{x}_{2}+3{x}_{3} \\\\ -2{x}_{2}-11{x}_{3} \\\\ {x}_{1}+2{x}_{2}+{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ -18 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2}+3{x}_{3} &=5 \\\\ -2{x}_{2}-11{x}_{3} &=-18 \\\\ {x}_{1}+2{x}_{2}+{x}_{3} &=-1\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\begin{bmatrix}1 & 1 & 3 & 5 \\\\ 0 & -2 & -11 & -18 \\\\ 1 & 2 & 1 & -1\\end{bmatrix}.\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 1 & 3 & 5 \\\\ 0 & -2 & -11 & -18 \\\\ 1 & 2 & 1 & -1\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & 3 & 5 \\\\ 0 & -2 & -11 & -18 \\\\ 0 & 1 & -2 & -6\\end{bmatrix} & {R}_{2} & ↔{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 1 & 3 & -1 \\\\ 0 & 1 & -2 & -6 \\\\ 0 & -2 & -11 & -18\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 1 & 3 & 5 \\\\ 0 & 1 & -2 & -6 \\\\ 0 & 0 & -15 & -30\\end{bmatrix} & {R}_{3} & :=-\\frac{1}{15}{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 1 & 3 & 5 \\\\ 0 & 1 & -2 & -6 \\\\ 0 & 0 & 1 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2}+3{x}_{3} &=5 \\\\ {x}_{2}-2{x}_{3} &=-6 \\\\ {x}_{3} &=2.\\end{aligned}\\right.\n$$\n\n \n\nFrom the third equation, we get ${x}_{3}=2.$ Substituting this value into  the second equation, we get\n\n$$\n{x}_{2}-2(2)=-6\\,⟹\\,{x}_{2}=-2.\n$$\n\n \n\nFinally, by substituting ${x}_{2}=-2$ and ${x}_{3}=2$ into the first equation, we obtain \n\n$$\n\\begin{aligned}{x}_{1}+{x}_{2}+3{x}_{3} & =5 \\\\ {x}_{1}+(-2)+3(2) & =5 \\\\ {x}_{1}+4 & =5 \\\\ {x}_{1} & =1.\\end{aligned}\n$$\n\nSo, the solution of the system is ${x}_{1}=1$, ${x}_{2}=-2$, and ${x}_{3}=2,$ which means \n\n$$\n{a}_{1}-2{a}_{2}+2{a}_{3}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=1+(-2)+2=1.\n$$"} :step/id #uuid "35ab3d0c-3feb-5eb0-8af0-2d726c5cb861" :step/next {:db/id #edb/ref 17592186435826}} {:db/id #edb/ref 17592186435829 :step/content {:db/id #edb/ref 17592186342130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ca1e367-7e59-5b69-861b-8c5df685d98a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186339240} {:answer/id #uuid "70e98200-2ef8-5fee-9135-1a64cdf08565" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186340130} {:answer/id #uuid "a0f91210-c308-5ac5-8b5f-ecea8232309c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186340589} {:answer/id #uuid "cd78319b-964c-5a76-83e0-5cc4ba5b698b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No solution" :db/id #edb/ref 17592186340951} {:answer/id #uuid "d5c0ee9d-d678-5d90-ac70-ae36c44cd666" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186341020}] :answer-field/correct {:db/id #edb/ref 17592186340951} :answer-field/id #uuid "d6466acd-a8cc-51d2-bb7d-d48bfacf96c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341757}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ff5142a4-ab7b-5300-baa5-14f6253ed7fa" :question/math-academy-id "q-74006" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}2 \\\\ -1 \\\\ -1\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}0 \\\\ -1 \\\\ -3\\end{bmatrix},\\,b=\\begin{bmatrix}-2 \\\\ 5 \\\\ 1\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then   we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ -1 \\\\ -1\\end{bmatrix}+{x}_{3}\\begin{bmatrix}0 \\\\ -1 \\\\ -3\\end{bmatrix} & =\\begin{bmatrix}-2 \\\\ 5 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ 0 \\\\ {x}_{1}\\end{bmatrix}+\\begin{bmatrix}2{x}_{2} \\\\ -{x}_{2} \\\\ -{x}_{2}\\end{bmatrix}+\\begin{bmatrix}0 \\\\ -{x}_{3} \\\\ -3{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}-2 \\\\ 5 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}+2{x}_{2} \\\\ -{x}_{2}-{x}_{3} \\\\ {x}_{1}-{x}_{2}-3{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}-2 \\\\ 5 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2} &=-2 \\\\ -{x}_{2}-{x}_{3} &=5 \\\\ {x}_{1}-{x}_{2}-3{x}_{3} &=1\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\begin{bmatrix}1 & 2 & 0 & -2 \\\\ 0 & -1 & -1 & 5 \\\\ 1 & -1 & -3 & 1\\end{bmatrix}.\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & 0 & -2 \\\\ 0 & -1 & -1 & 5 \\\\ 1 & -1 & -3 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 0 & -2 \\\\ 0 & -1 & -1 & 5 \\\\ 0 & -3 & -3 & 3\\end{bmatrix} & {R}_{2} & :=(-1){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 2 & 0 & -2 \\\\ 0 & 1 & 1 & -5 \\\\ 0 & -3 & -3 & 3\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 2 & 0 & -2 \\\\ 0 & 1 & 1 & -5 \\\\ 0 & 0 & 0 & -12\\end{bmatrix}.\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2} &=-2 \\\\ {x}_{2}+{x}_{3} &=-5 \\\\ 0 &=-12.\\end{aligned}\\right.\n$$\n\nHowever, the final equation $0=-12$  gives a false statement. So the system has no solution."} :step/id #uuid "65c83c6b-907c-5488-b33a-fa5563a73ab2" :step/next {:db/id #edb/ref 17592186435828}} {:db/id #edb/ref 17592186435830 :step/content {:db/id #edb/ref 17592186435825 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fdd8247-3e99-5680-9837-f81ce2e4daa8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186435812} {:answer/id #uuid "6588aecf-5be8-5075-92ab-05e2c0bd205f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No solution" :db/id #edb/ref 17592186435816} {:answer/id #uuid "877b327c-7099-5b51-a1a0-e54f12c801d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186435818} {:answer/id #uuid "9a314fbe-bce0-5c72-becd-d86fdd89cb4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186435819} {:answer/id #uuid "b6573507-37c6-5328-ab6e-7644606e55a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186435821}] :answer-field/correct {:db/id #edb/ref 17592186435819} :answer-field/id #uuid "50ab6af3-7838-5baf-b926-7d20ec2e1151" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186435822}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e9e20ff9-23b3-5457-a430-304f98c0d839" :question/math-academy-id "q-73950" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=\\begin{bmatrix}3 \\\\ 4 \\\\ 2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-2 \\\\ 3 \\\\ -3\\end{bmatrix},\\,b=\\begin{bmatrix}-11 \\\\ 8 \\\\ -14\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b,$ then what is ${x}_{1}+{x}_{2}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}3 \\\\ 4 \\\\ 2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-2 \\\\ 3 \\\\ -3\\end{bmatrix} & =\\begin{bmatrix}-11 \\\\ 8 \\\\ -14\\end{bmatrix} \\\\ \\begin{bmatrix}3{x}_{1} \\\\ 4{x}_{1} \\\\ 2{x}_{1}\\end{bmatrix}+\\begin{bmatrix}-2{x}_{2} \\\\ 3{x}_{2} \\\\ -3{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-11 \\\\ 8 \\\\ -14\\end{bmatrix} \\\\ \\begin{bmatrix}3{x}_{1}-2{x}_{2} \\\\ 4{x}_{1}+3{x}_{2} \\\\ 2{x}_{1}-3{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-11 \\\\ 8 \\\\ -14\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}3{x}_{1}-2{x}_{2} &=-11 \\\\ 4{x}_{1}+3{x}_{2} &=8 \\\\ 2{x}_{1}-3{x}_{2} &=-14\\end{aligned}\\right.\n$$\n\nAdding the second and the third equations we get \n\n$$\n\\begin{aligned}6{x}_{1} & =-6 \\\\ {x}_{1} & =-1,\\end{aligned}\n$$\n\nwhich we substitute into the second equation to get \n\n$$\n\\begin{aligned}4{x}_{1}+3{x}_{2} & =8 \\\\ 4(-1)+3{x}_{2} & =8 \\\\ 3{x}_{2} & =12 \\\\ {x}_{2} & =4.\\end{aligned}\n$$\n\nFinally, we substitute ${x}_{1}=-1$ and ${x}_{2}=4$ into the first equation to get\n\n$$\n\\begin{aligned}3{x}_{1}-2{x}_{2} & =-11 \\\\ 3(-1)-2(4) & =-11 \\\\ -11 & =-11,\\end{aligned}\n$$\n\nwhich gives a true statement. \n\nSo the solution of the system is ${x}_{1}=-1$ and ${x}_{2}=4,$ which means\n\n$$\n-{a}_{1}+4{a}_{2}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}=-1+4=3.\n$$"} :step/id #uuid "b586b47f-7e9b-5e1b-a1bb-ec0e1f2e8048" :step/next {:db/id #edb/ref 17592186435829}}] :activity/title "Linear Combinations of Vectors in N-Dimensional Euclidean Space" :activity/type {:db/id #edb/ref 17592186045464} :db/id #edb/ref 17592186435811}] :db/id #edb/ref 17592186048499 :topic/difficulty 0.4417760528545274 :topic/encompasses [{:db/id #edb/ref 17592186428389 :encompassing/rationale "Initial Codex estimate from captured target-band crossing frequency. Selected account linear: 1 rises / 2 eligible passed source activities = 0.500000; nearest selected fraction = 1/2. Crossing activity numbers [1]; waits [1]. Separate account estimates: foundations=1 (2/2); linear=1/2 (1/2). Selection: most observations, then lower weight, then account name; no averaging. Single-activity estimates included. Intervening target updates: True. Crossing frequency is the chosen practical estimate of encompassing coverage; a multi-band rise counts once. This does not interpret color steps as physical repetition units. Method: encompassing-report.md. Evidence: reference/mathacademy/encompassing-analysis-2026-10-11/frequency-fractions/linear-frequency-estimates.json, pair 1851->1047. All account evidence retained in the prepared import's selected-relationships.json." :encompassing/topic {:db/id #edb/ref 17592186050267} :encompassing/weight 0.5} {:db/id #edb/ref 17592186428390 :encompassing/rationale "Initial Codex estimate from captured target-band crossing frequency. Selected account foundations: 1 rises / 2 eligible passed source activities = 0.500000; nearest selected fraction = 1/2. Crossing activity numbers [1]; waits [1]. Separate account estimates: foundations=1/2 (1/2); linear=1/2 (1/2). Selection: most observations, then lower weight, then account name; no averaging. Single-activity estimates included. Intervening target updates: True. Crossing frequency is the c