{:db/id #edb/ref 17592186049304 :topic/knowledge-points [{:db/id #edb/ref 17592186054648 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054545 :question/math-academy-id "e-4374" :question/problem "Calculate $A+B,$ where\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}1 & -5 \\\\ -2 & 3\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}-10 & 2 \\\\ 2 & -4\\end{bmatrix}$</div>\n</div>" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}A+B & =\\begin{bmatrix}1 & -5 \\\\ -2 & 3\\end{bmatrix}+\\begin{bmatrix}-10 & 2 \\\\ 2 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}1-10 & -5+2 \\\\ -2+2 & 3-4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-9 & -3 \\\\ 0 & -1\\end{bmatrix}\\end{aligned}\n$$"} :knowledge-point/questions [{:db/id #edb/ref 17592186054939 :question/math-academy-id "q-101" :question/problem "What is $\\begin{bmatrix}-4 & -5 \\\\ 12 & 3\\end{bmatrix} + \\begin{bmatrix}-9 & 5 \\\\ 6 & -11\\end{bmatrix}$?"} {:db/id #edb/ref 17592186054967 :question/math-academy-id "q-11440" :question/problem "Calculate $A+B$, where\n\n$$\nA=\\begin{bmatrix}2 & 5 \\\\ 3 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}4 & 1 \\\\ -2 & 2\\end{bmatrix}.\n$$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}A+B & =\\begin{bmatrix}2 & 5 \\\\ 3 & 1\\end{bmatrix}+\\begin{bmatrix}4 & 1 \\\\ -2 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2+4 & 5+1 \\\\ 3+(-2) & 1+2\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 & 6 \\\\ 1 & 3\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237775 :question/math-academy-id "q-100" :question/problem "$\\begin{bmatrix}6 & -1 \\\\ 7 & 0\\end{bmatrix}+\\begin{bmatrix}-2 & 9 \\\\ 1 & 8\\end{bmatrix}=$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}\\begin{bmatrix}6 & -1 \\\\ 7 & 0\\end{bmatrix}+\\begin{bmatrix}-2 & 9 \\\\ 1 & 8\\end{bmatrix} & =\\begin{bmatrix}6+(-2) & (-1)+9 \\\\ 7+1 & 0+8\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 8 \\\\ 8 & 8\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186259832 :question/math-academy-id "q-125630" :question/problem "Calculate $P+Q$, where\n\n$$\nP=\\begin{bmatrix}1 & -2 \\\\ 0 & -3\\end{bmatrix},\\,Q=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}.\n$$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}P+Q & =\\begin{bmatrix}1 & -2 \\\\ 0 & -3\\end{bmatrix}+\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1+1 & (-2)+0 \\\\ 0+0 & (-3)+1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & -2 \\\\ 0 & -2\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186259833 :question/math-academy-id "q-125631" :question/problem "Calculate $X+Y$, where\n\n$$\nX=\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix},\\,Y=\\begin{bmatrix}0 & -1 \\\\ -2 & 0\\end{bmatrix}.\n$$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}X+Y & =\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix}+\\begin{bmatrix}0 & -1 \\\\ -2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}2+0 & 0+(-1) \\\\ 0+(-2) & 1+0\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & -1 \\\\ -2 & 1\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299781 :question/math-academy-id "q-319591" :question/problem "Calculate $F+G,$ where $F=\\begin{bmatrix}3 & -4 \\\\ -2 & 7\\end{bmatrix}$ and \n$G=\\begin{bmatrix}-9 & 10 \\\\ 5 & -1\\end{bmatrix}.$\n\n| $F+G=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}\\begin{aligned}F+G & =\\begin{bmatrix}3 & -4 \\\\ -2 & 7\\end{bmatrix}+\\begin{bmatrix}-9 & 10 \\\\ 5 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3+(-9) & -4+10 \\\\ -2+5 & 7+(-1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 & 6 \\\\ 3 & 6\\end{bmatrix}\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186510633 :question/problem "Calculate $F+G,$ where $F=\\begin{bmatrix}-6 & 6 \\\\ 4 & 8\\end{bmatrix}$ and \n$G=\\begin{bmatrix}-11 & -12 \\\\ -10 & -6\\end{bmatrix}.$\n\n| $F+G=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}\\begin{aligned}F+G & =\\begin{bmatrix}-6 & 6 \\\\ 4 & 8\\end{bmatrix}+\\begin{bmatrix}-11 & -12 \\\\ -10 & -6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6+(-11) & 6+(-12) \\\\ 4+(-10) & 8+(-6)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-17 & -6 \\\\ -6 & 2\\end{bmatrix}\\end{aligned}\\end{aligned}\n$$"}] :knowledge-point/title "Adding Square Matrices"} {:db/id #edb/ref 17592186054649 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054546 :question/math-academy-id "e-4375" :question/problem "Calculate $A-B,$ where\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}2 & -1 \\\\ -1 & 0 \\\\ 3 & 2\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}0 & -1 \\\\ 2 & -1 \\\\ -1 & 3\\end{bmatrix}$</div>\n</div>" :question/worked-solution "We subtract the corresponding entries:\n\n$$\n\\begin{aligned}A-B & =\\begin{bmatrix}2 & -1 \\\\ -1 & 0 \\\\ 3 & 2\\end{bmatrix}-\\begin{bmatrix}0 & -1 \\\\ 2 & -1 \\\\ -1 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}2-0 & -1-(-1) \\\\ -1-2 & 0-(-1) \\\\ 3-(-1) & 2-3\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 0 \\\\ -3 & 1 \\\\ 4 & -1\\end{bmatrix}\\end{aligned}\n$$"} :knowledge-point/questions [{:db/id #edb/ref 17592186054953 :question/math-academy-id "q-108" :question/problem "What is $\\begin{bmatrix}7 & -4 & 9 \\\\ 1 & 10 & -7\\end{bmatrix} - \\begin{bmatrix}-8 & 6 & -2 \\\\ -4 & 3 & -6\\end{bmatrix}$?"} {:db/id #edb/ref 17592186054969 :question/math-academy-id "q-11478" :question/problem "Calculate $P - Q$, where\n$P = \\begin{bmatrix}4 & 3 \\\\ 1 & 2\\end{bmatrix}, Q = \\begin{bmatrix}1 & 2 \\\\ 3 & 4\\end{bmatrix}$."} {:db/id #edb/ref 17592186250258 :question/math-academy-id "q-11441" :question/problem "Calculate $A-B$, where\n\n$$\nA=\\begin{bmatrix}5 & 5 \\\\ 5 & 4\\end{bmatrix},\\,B=\\begin{bmatrix}3 & 2 \\\\ 1 & 0\\end{bmatrix}.\n$$" :question/worked-solution "We subtract the corresponding entries:\n\n$$\n\\begin{aligned}A-B & =\\begin{bmatrix}5 & 5 \\\\ 5 & 4\\end{bmatrix}-\\begin{bmatrix}3 & 2 \\\\ 1 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}5-3 & 5-2 \\\\ 5-1 & 4-0\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 3 \\\\ 4 & 4\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299783 :question/math-academy-id "q-319618" :question/problem "Calculate $C-D$, where\n$C=\\begin{bmatrix}-4 & 12 & -1 \\\\ 6 & -7 & 3\\end{bmatrix}$ and $D=\\begin{bmatrix}-9 & 5 & 2 \\\\ -8 & -1 & 10\\end{bmatrix}.$\n\n| $C-D=\\,\\,$ |  | {{field-1}} | {{field-2}} | {{field-3}} |  |\n| --- | --- | --- | --- | --- | --- |\n|  | {{field-4}} | {{field-5}} | {{field-6}} |  |  |" :question/worked-solution "We subtract the corresponding entries:\n\n$$\n\\begin{aligned}C-D & =\\begin{bmatrix}-4 & 12 & -1 \\\\ 6 & -7 & 3\\end{bmatrix}-\\begin{bmatrix}-9 & 5 & 2 \\\\ -8 & -1 & 10\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4-(-9) & 12-5 & -1-2 \\\\ 6-(-8) & -7-(-1) & 3-10\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & 7 & -3 \\\\ 14 & -6 & -7\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299784 :question/math-academy-id "q-319622" :question/problem "Calculate $G-H$, where\n$G=\\begin{bmatrix}7 & 7 \\\\ -6 & 2 \\\\ 5 & -8\\end{bmatrix}$ and $H=\\begin{bmatrix}10 & -5 \\\\ -6 & -9 \\\\ 3 & -1\\end{bmatrix}.$\n\n| $G-H=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |\n|  | {{field-5}} | {{field-6}} |  |  |" :question/worked-solution "We subtract the corresponding entries:\n\n$$\n\\begin{aligned}G-H & =\\begin{bmatrix}7 & 7 \\\\ -6 & 2 \\\\ 5 & -8\\end{bmatrix}-\\begin{bmatrix}10 & -5 \\\\ -6 & -9 \\\\ 3 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}7-10 & 7-(-5) \\\\ -6-(-6) & 2-(-9) \\\\ 5-3 & -8-(-1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & 12 \\\\ 0 & 11 \\\\ 2 & -7\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299785 :question/math-academy-id "q-319625" :question/problem "Calculate $P-Q$, where\n\n<div class=\"matrix-operands\">\n<div>$P=\\begin{bmatrix}-6 & 4 & 9 \\\\ 7 & -2 & 5 \\\\ 10 & 0 & -3\\end{bmatrix}$</div>\n<div>$Q=\\begin{bmatrix}1 & -8 & 6 \\\\ -4 & 3 & -7 \\\\ 12 & -5 & 9\\end{bmatrix}$</div>\n</div>\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$P-Q=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Entries of P minus Q\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td><td>$3$</td></tr>\n<tr><td>$11$</td><td>{{field-3}}</td><td>{{field-4}}</td></tr>\n<tr><td>{{field-5}}</td><td>$5$</td><td>{{field-6}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "We subtract the corresponding entries:\n\n$$\n\\begin{aligned}P-Q & =\\begin{bmatrix}-6 & 4 & 9 \\\\ 7 & -2 & 5 \\\\ 10 & 0 & -3\\end{bmatrix}-\\begin{bmatrix}1 & -8 & 6 \\\\ -4 & 3 & -7 \\\\ 12 & -5 & 9\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6-1 & 4-(-8) & 9-6 \\\\ 7-(-4) & -2-3 & 5-(-7) \\\\ 10-12 & 0-(-5) & -3-9\\end{bmatrix} \\\\  & =\\begin{bmatrix}-7 & \\,\\,12 & 3 \\\\ \\,\\,\\,11 & -5 & 12 \\\\ -2 & 5 & -12\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335984 :question/math-academy-id "q-69603" :question/problem "$\\begin{bmatrix}4 & -8 & 1 \\\\ -2 & 6 & -9\\end{bmatrix}-\\begin{bmatrix}-2 & 1 & -10 \\\\ -1 & 8 & -4\\end{bmatrix}=$" :question/worked-solution "We subtract the corresponding entries:\n\n$$\n\\begin{aligned}\\begin{bmatrix}4 & -8 & 1 \\\\ -2 & 6 & -9\\end{bmatrix}-\\begin{bmatrix}-2 & 1 & -10 \\\\ -1 & 8 & -4\\end{bmatrix} & =\\begin{bmatrix}4-(-2) & -8-1 & 1-(-10) \\\\ -2-(-1) & 6-8 & -9-(-4)\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 & -9 & 11 \\\\ -1 & -2 & -5\\end{bmatrix}\\end{aligned}\n$$"}] :knowledge-point/title "Subtracting Matrices"} {:db/id #edb/ref 17592186054650 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054547 :question/math-academy-id "e-4396" :question/problem "Calculate ${A}+ {B},$ where\n\n$$\n{A}=\n    \\begin{bmatrix}1 & 3 & 1 & 0 \\\\ 2 & 4 & -1 & 2\\end{bmatrix},\n\\quad\n{B}=\n    \\begin{bmatrix}-2 & -3 & 1 & 1 \\\\ 1 & -2 & 3 & 1\\end{bmatrix}.\n$$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}A+B & =\\begin{bmatrix}1 & 3 & 1 & 0 \\\\ 2 & 4 & -1 & 2\\end{bmatrix}+\\begin{bmatrix}-2 & -3 & 1 & 1 \\\\ 1 & -2 & 3 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1+(-2) & 3+(-3) & 1+1 & 0+1 \\\\ 2+1 & 4+(-2) & -1+3 & 2+1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & 0 & 2 & 1 \\\\ 3 & 2 & 2 & 3\\end{bmatrix}\\end{aligned}\n$$"} :knowledge-point/questions [{:db/id #edb/ref 17592186054942 :question/math-academy-id "q-103" :question/problem "What is $\\begin{bmatrix}2 & -12 \\\\ 7 & -4 \\\\ -8 & 7\\end{bmatrix} + \\begin{bmatrix}3 & 0 \\\\ -1 & 5 \\\\ 9 & 13\\end{bmatrix}$?"} {:db/id #edb/ref 17592186054946 :question/math-academy-id "q-105" :question/problem "Calculate $X + Y$, where\n\n$X = \\begin{bmatrix}2 & -1 & 8 \\\\ -14 & 0 & -6\\end{bmatrix}, Y = \\begin{bmatrix}-12 & 3 & 5 \\\\ 13 & 1 & 0\\end{bmatrix}$."} {:db/id #edb/ref 17592186259846 :question/math-academy-id "q-125722" :question/problem "Calculate $P+Q,$ where\n\n$$\nP=\\begin{bmatrix}1 & -1 \\\\ -4 & 0 \\\\ -1 & 2\\end{bmatrix},\\,Q=\\begin{bmatrix}2 & -3 \\\\ 1 & 1 \\\\ 2 & -4\\end{bmatrix}.\n$$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}P+Q & =\\begin{bmatrix}1 & -1 \\\\ -4 & 0 \\\\ -1 & 2\\end{bmatrix}+\\begin{bmatrix}2 & -3 \\\\ 1 & 1 \\\\ 2 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}1+2 & (-1)+(-3) \\\\ (-4)+1 & 0+1 \\\\ (-1)+2 & 2+(-4)\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & -4 \\\\ -3 & 1 \\\\ 1 & -2\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299782 :question/math-academy-id "q-319601" :question/problem "Calculate $P+Q,$ where\n$P=\\begin{bmatrix}-4 & 9 & 3 \\\\ 7 & -2 & 11\\end{bmatrix}$ and $Q=\\begin{bmatrix}10 & -5 & -8 \\\\ -1 & 4 & -6\\end{bmatrix}.$\n\n| $P+Q=\\,\\,$ |  | {{field-1}} | {{field-2}} | {{field-3}} |  |\n| --- | --- | --- | --- | --- | --- |\n|  | {{field-4}} | {{field-5}} | {{field-6}} |  |  |" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}P+Q & =\\begin{bmatrix}-4 & 9 & 3 \\\\ 7 & -2 & 11\\end{bmatrix}+\\begin{bmatrix}10 & -5 & -8 \\\\ -1 & 4 & -6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4+10 & 9+(-5) & 3+(-8) \\\\ 7+(-1) & -2+4 & 11+(-6)\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 & 4 & -5 \\\\ 6 & 2 & 5\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335985 :question/math-academy-id "q-69622" :question/problem "$\\begin{bmatrix}1 & -1 & 4 \\\\ 3 & -2 & 2\\end{bmatrix}+\\begin{bmatrix}-2 & 0 & -1 \\\\ 1 & 2 & 10\\end{bmatrix}=$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & -1 & 4 \\\\ 3 & -2 & 2\\end{bmatrix}+\\begin{bmatrix}-2 & 0 & -1 \\\\ 1 & 2 & 10\\end{bmatrix} & =\\begin{bmatrix}1+(-2) & -1+0 & 4+(-1) \\\\ 3+1 & -2+2 & 2+10\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & -1 & 3 \\\\ 4 & 0 & 12\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335988 :question/math-academy-id "q-69635" :question/problem "$\\begin{bmatrix}-1 & -3 \\\\ -6 & -3 \\\\ -2 & 10\\end{bmatrix}+\\begin{bmatrix}1 & -11 \\\\ 0 & -14 \\\\ 11 & -16\\end{bmatrix}=$" :question/worked-solution "We add the corresponding entries: \n\n$$\n\\begin{aligned}\\begin{bmatrix}-1 & -3 \\\\ -6 & -3 \\\\ -2 & 10\\end{bmatrix}+\\begin{bmatrix}1 & -11 \\\\ 0 & -14 \\\\ 11 & -16\\end{bmatrix} & =\\begin{bmatrix}-1+1 & -3+(-11) \\\\ -6+0 & -3+(-14) \\\\ -2+11 & 10+(-16)\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & -14 \\\\ -6 & -17 \\\\ 9 & -6\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186386182 :question/math-academy-id "q-106" :question/problem "Calculate $M+N,$ where\n\n$$\nM=\\begin{bmatrix}3 & -6 & 14 \\\\ 2 & 9 & -13\\end{bmatrix},\\,N=\\begin{bmatrix}-15 & -6 & -13 \\\\ -1 & -8 & 14\\end{bmatrix}.\n$$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}M+N & =\\begin{bmatrix}3 & -6 & 14 \\\\ 2 & 9 & -13\\end{bmatrix}+\\begin{bmatrix}-15 & -6 & -13 \\\\ -1 & -8 & 14\\end{bmatrix} \\\\  & =\\begin{bmatrix}3+(-15) & -6+(-6) & 14+(-13) \\\\ 2+(-1) & 9+(-8) & -13+14\\end{bmatrix} \\\\  & =\\begin{bmatrix}-12 & -12 & 1 \\\\ 1 & 1 & 1\\end{bmatrix}\\end{aligned}\n$$"}] :knowledge-point/title "Adding Non-Square Matrices"}] :topic/title "Adding and Subtracting Matrices"}
