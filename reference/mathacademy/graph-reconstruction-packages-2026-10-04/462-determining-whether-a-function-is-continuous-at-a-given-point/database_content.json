    "e-3567": {
      ":db/id": 17592186068467,
      ":knowledge-point/_canonical-example": [
        {
          ":knowledge-point/id": "6cd6c125-ecaf-5847-a802-ec1b3594a15c",
          ":knowledge-point/title": "Determining Whether a Function Is Continuous at a Given Point"
        }
      ],
      ":question/id": "f12b3891-021d-5ae3-a767-f9d423408ce6",
      ":question/math-academy-id": "e-3567",
      ":question/problem": "Is the function $y=f(x)$, plotted below, continuous at $x=0$?\n\n![](image_assets/5a83932fdde3fa50945ddea33311a58d-e395863ca6.png)",
      ":question/worked-solution": "Because there is an asymptote at $x=0$, it is impossible to draw the function in the neighborhood of $x=0$ without taking our pencil off of the paper.\n\nTherefore, the function $y=f(x)$ is not continuous at $x=0$."
    },
