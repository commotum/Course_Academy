ut taking the pencil off of the paper."}] [{:db/id #edb/ref 17592186069290 :knowledge-point/_questions [{:knowledge-point/id #uuid "6cd6c125-ecaf-5847-a802-ec1b3594a15c" :knowledge-point/title "Determining Whether a Function Is Continuous at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9344a77-a09e-5ea3-a235-97ed9a3e8b4e" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/462/Source/Images/q-48081-a-3.png" :db/id #edb/ref 17592186067272} {:answer/id #uuid "c58c6c4b-96db-5732-86ef-c523dc80b43d" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/462/Source/Images/q-48081-a-5.png" :db/id #edb/ref 17592186067273} {:answer/id #uuid "c59109c0-aaf7-56bc-aca1-4414be1c07e1" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/462/Source/Images/q-48081-a-1.png" :db/id #edb/ref 17592186067274} {:answer/id #uuid "d5acd7b9-a039-5007-bdac-2e7762331223" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/462/Source/Images/q-48081-a-2.png" :db/id #edb/ref 17592186067275} {:answer/id #uuid "50b2847a-5749-52b1-aa3f-9b5a761159e5" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/462/Source/Images/q-48081-a-4.png" :db/id #edb/ref 17592186067276}] :answer-field/correct {:answer/id #uuid "c59109c0-aaf7-56bc-aca1-4414be1c07e1" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/462/Source/Images/q-48081-a-1.png" :db/id #edb/ref 17592186067274} :answer-field/id #uuid "0ef32967-a397-5a87-b722-ecdc4ce1e26a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067271}] :question/id #uuid "c05827a9-fdcf-58d8-bfea-b9a09196b4ea" :question/math-academy-id "q-48081" :question/problem "Select the function that is continuous at $x = 2$."}] [