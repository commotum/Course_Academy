#{[{:activity/id #uuid "09c8fe50-cab2-5dfd-a90a-5053ffffc1bf" :activity/steps [{:db/id #edb/ref 17592186069494 :step/content {:db/id #edb/ref 17592186069884 :tutorial/content "A function $f(x)$ is **continuous** over its entire domain if the graph of $y=f(x)$ can be drawn using a pencil and a piece of paper without taking the pencil off of the paper.\n\nTo illustrate, let's consider the function $y=x^2$ whose graph is shown below.\n\n![](/home/jake/Developer/MA/DATA/Lessons/462/Source/Images/d255ab82ce6f008296c3c7fe6a7c3b16.png)\n\nWe can draw as much of the function $y=x^2$ as we want without taking our pencil off of the paper. Therefore, we say that $y=x^2$ is **continuous** at every point in its domain.\n\nLet's compare this to the function $y=g(x)$ below:\n\n![](/home/jake/Developer/MA/DATA/Lessons/462/Source/Images/2e142a1ee145a3b329ede3e834b34111.png)\n\nNotice that this function has a jump in its value at $x=0$.\n\nIt is *impossible* to draw $y=g(x)$ without taking the pencil off the paper to fill in the jump at $x=0$. Therefore, we say that $y=g(x)$ has a **discontinuity** at $x=0$." :tutorial/id #uuid "1fb32bea-3d77-5134-936c-bfa9f0381fdb" :tutorial/math-academy-id 2583 :tutorial/title "Introduction"} :step/id #uuid "3561bec4-880a-5815-bc18-84c3d62a3191" :step/math-academy-id 12020 :step/next {:db/id #edb/ref 17592186069503}} {:db/id #edb/ref 17592186069495 :step/content {:db/id #edb/ref 17592186068619 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068467} :knowledge-point/id #uuid "6cd6c125-ecaf-5847-a802-ec1b3594a15c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049518}] :knowledge-point/questions [{:db/id #edb/ref 17592186069286} {:db/id #edb/ref 17592186069290} {:db/id #edb/ref 17592186242122} {:db/id #edb/ref 17592186242178} {:db/id #edb/ref 17592186242196} {:db/id #edb/ref 17592186242203}] :knowledge-point/title "Determining Whether a Function Is Continuous at a Given Point"} :step/id #uuid "1c9dde49-f9f9-5036-8e84-b7e1ced3796b" :step/math-academy-id 12021 :step/next {:db/id #edb/ref 17592186069496}} {:db/id #edb/ref 17592186069496 :step/content {:db/id #edb/ref 17592186068620 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068468} :knowledge-point/id #uuid "31eacf5a-75a5-5b38-8c24-4b1598ecf3a7" :knowledge-point/questions [{:db/id #edb/ref 17592186069289} {:db/id #edb/ref 17592186069291} {:db/id #edb/ref 17592186242129} {:db/id #edb/ref 17592186242136} {:db/id #edb/ref 17592186242171} {:db/id #edb/ref 17592186242185} {:db/id #edb/ref 17592186245048} {:db/id #edb/ref 17592186245051}] :knowledge-point/title "Identifying Points of Discontinuity"} :step/id #uuid "74cd2bd0-c1c2-5429-adda-d13aa18601d2" :step/math-academy-id 12022 :step/next {:db/id #edb/ref 17592186069497}} {:db/id #edb/ref 17592186069497 :step/content {:db/id #edb/ref 17592186068621 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068469} :knowledge-point/id #uuid "3f92e521-e7ab-56ba-8eac-0484b140b1a2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048927} {:db/id #edb/ref 17592186051033}] :knowledge-point/questions [{:db/id #edb/ref 17592186069287} {:db/id #edb/ref 17592186069288} {:db/id #edb/ref 17592186242143} {:db/id #edb/ref 17592186242150} {:db/id #edb/ref 17592186242157} {:db/id #edb/ref 17592186242164}] :knowledge-point/title "Determining the Behavior of a Function in the Neighborhood of a Point"} :step/id #uuid "64c70852-38a7-5f5e-ade8-36856f8eef67" :step/math-academy-id 12023} {:db/id #edb/ref 17592186069503 :step/content {:db/id #edb/ref 17592186069887 :tutorial/content "Now consider the function $y=h(x)$ below. This function has a discontinuity at $x=0$, so it is not continuous over its entire domain.\n\n![](/home/jake/Developer/MA/DATA/Lessons/462/Source/Images/3ea09156af8b143260f3c32e921edb31.png)\n\nHowever, the function $h(x)$ may be continuous at other points, such as $x=1$.\n\nTo determine whether $h(x)$ is continuous at $x=1$, we have to consider points in the **neighborhood** of $x=1$. Roughly speaking, the *neighborhood of $x=1$* means the points on the curve that have an $x$-coordinate that's close to $1$.\n\nIndeed, in the *neighborhood* of $x=1$, we can draw the function $h(x)$ without taking the pencil off the paper. So, $h(x)$ is indeed continuous at $x=1$." :tutorial/id #uuid "54ca4bef-1b8e-5315-85d4-0667910b332c" :tutorial/math-academy-id 2640 :tutorial/title "Continuity at a Point"} :step/id #uuid "c5269250-b2f9-525d-bfaa-9f0e6033687b" :step/math-academy-id 12404 :step/next {:db/id #edb/ref 17592186069495}}] :activity/title "Determining Continuity from Graphs"}]}
