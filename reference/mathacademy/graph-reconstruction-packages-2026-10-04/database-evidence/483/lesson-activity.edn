#{[{:activity/id #uuid "8c1c7900-f03a-561c-8ea1-4c36f0a4a28b" :activity/steps [{:db/id #edb/ref 17592186074658 :step/content {:db/id #edb/ref 17592186073720 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073589} :knowledge-point/id #uuid "9322724c-215a-5a91-a478-e91abe4038da" :knowledge-point/questions [{:db/id #edb/ref 17592186074126} {:db/id #edb/ref 17592186074129}] :knowledge-point/title "Determining the Image of a Polygon Under the Action of Multiple Transformations"} :step/id #uuid "383137fb-a667-5ee2-9f6a-b48d1e2491f3" :step/math-academy-id 28860 :step/next {:db/id #edb/ref 17592186074855}} {:db/id #edb/ref 17592186074660 :step/content {:db/id #edb/ref 17592186073722 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073591} :knowledge-point/id #uuid "1614303a-a067-5879-9ba6-2e7505109136" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050077} {:db/id #edb/ref 17592186050087} {:db/id #edb/ref 17592186050573}] :knowledge-point/questions [{:db/id #edb/ref 17592186074125} {:db/id #edb/ref 17592186074460}] :knowledge-point/title "Determining the Image of a Point Given a Sequence of Transformations"} :step/id #uuid "f68143db-5755-5d7a-98c2-1bc3df7dd0bc" :step/math-academy-id 29004 :step/next {:db/id #edb/ref 17592186074854}} {:db/id #edb/ref 17592186074853 :step/content {:db/id #edb/ref 17592186074927 :tutorial/content "We can combine transformations by applying them in turn.\n\nFor example, suppose that the segment $\\overline{AB}$ below is dilated with center $O$ and a scale factor $2$, and then shifted $3$ units down. What is the resulting segment?\n\n![](/home/jake/Developer/MA/DATA/Lessons/483/Source/Images/f51816fae3a5dce9b86c0b51a8989988.png)\n\nLet's apply the transformations in turn.\n\n- Dilating with center $O$ and scale factor $2$ gives the segment $\\overline{A'B'}$, shown below:\n\n![](/home/jake/Developer/MA/DATA/Lessons/483/Source/Images/b48bdc1c72251a54075d3c9677a1c77e.png)\n\n- Next, we take $\\overline{A'B'}$ and shift it by $3$ units down. This gives the segment $\\overline{A''B''}$:\n\n![](/home/jake/Developer/MA/DATA/Lessons/483/Source/Images/cb47e4c7d41e04f35864927587fd0de1.png)" :tutorial/id #uuid "db9037b0-2293-5cfb-82a7-3ceb49e7f1c2" :tutorial/math-academy-id 2286 :tutorial/title "Introduction"} :step/id #uuid "54890655-2246-5ea0-b6c5-dd777056aa9e" :step/math-academy-id 9530 :step/next {:db/id #edb/ref 17592186074660}} {:db/id #edb/ref 17592186074854 :step/content {:db/id #edb/ref 17592186073846 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073531} :knowledge-point/id #uuid "1b09eb59-3ad5-5cde-8503-3c28c9e5c546" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048192} {:db/id #edb/ref 17592186049018}] :knowledge-point/questions [{:db/id #edb/ref 17592186074118} {:db/id #edb/ref 17592186074127}] :knowledge-point/title "Applying Multiple Transformations to a Point Using Functions"} :step/id #uuid "36d25884-66b5-5b7e-a637-4f934d7082a6" :step/math-academy-id 9531 :step/next {:db/id #edb/ref 17592186074658}} {:db/id #edb/ref 17592186074855 :step/content {:db/id #edb/ref 17592186073847 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073532} :knowledge-point/id #uuid "d4308331-fea0-51e1-b1c9-a3e8e122e09e" :knowledge-point/questions [{:db/id #edb/ref 17592186074128} {:db/id #edb/ref 17592186074130}] :knowledge-point/title "Determining Parameters Given a Point and Its Image Under Multiple Transformations"} :step/id #uuid "ec82e476-e6de-5ac3-be7f-d6c4d73e8d5b" :step/math-academy-id 9539}] :activity/title "Combining Geometric Transformations"}]}
