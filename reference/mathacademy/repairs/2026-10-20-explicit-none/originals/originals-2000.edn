[{:db/id #edb/ref 17592186360720 :knowledge-point/_questions [{:db/id #edb/ref 17592186105893 :knowledge-point/id #uuid "ca93cd65-65e3-521e-a1e3-2721f45fb6a6" :knowledge-point/title "Calculating the Coordinates of an Image Formed by a Singular Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cfe9812-86f1-5c5b-9fd2-5a6147ed8a40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186357859} {:answer/id #uuid "4a8fdc73-f630-52c5-90b5-cff027f2bf0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186358389} {:answer/id #uuid "9669aab1-ba94-53d4-b9e7-518f8d8bb0eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186359067} {:answer/id #uuid "c49835a5-6cb5-5405-a466-b16bbb77b948" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186359479} {:answer/id #uuid "eeb47e53-1a29-5602-9773-81346d526d56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186359880}] :answer-field/correct {:answer/id #uuid "c49835a5-6cb5-5405-a466-b16bbb77b948" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186359479} :answer-field/id #uuid "d2840d95-e615-5d9f-a975-078cc51f7264" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360355}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e1d4a0e7-8ceb-5003-89cd-d540839fd74d" :question/math-academy-id "q-96855" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}-4 & 2 \\\\ -8 & 4\\end{aligned}].\n$$\n\nA triangle $S$ has vertices at $(1,-1)$, $(1,0)$ and $(-2,1).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the action of $T?$ \n\n- $(10,20)$\n- $(4,-8)$\n- $(-6,6)$" :question/worked-solution "To find the image of $S$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\nX=[\\begin{aligned}1 & 1 & -2 \\\\ -1 & 0 & 1\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}-4 & 2 \\\\ -8 & 4\\end{aligned}][\\begin{aligned}1 & 1 & -2 \\\\ -1 & 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-6 & -4 & 10 \\\\ -12 & -8 & 20\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-6,-12)$, $(-4,-8)$ and $(10,20).$ \n\nSo, the correct answer is \"I  only.\""} {:db/id #edb/ref 17592186360721 :knowledge-point/_questions [{:db/id #edb/ref 17592186105893 :knowledge-point/id #uuid "ca93cd65-65e3-521e-a1e3-2721f45fb6a6" :knowledge-point/title "Calculating the Coordinates of an Image Formed by a Singular Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3495151c-6f9c-5673-88de-f1c56e1af0e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186358221} {:answer/id #uuid "5751455e-b08a-59b1-989d-3eba444bfcf9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186358509} {:answer/id #uuid "ad0bf57c-af5a-58c7-aa89-1d4cb5090cdc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186359247} {:answer/id #uuid "b7d45304-6eb4-5c6d-b2cb-2ed7cead1fe1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186359343} {:answer/id #uuid "d49d906c-2287-5d38-a378-e7c13932bd96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186359609}] :answer-field/correct {:answer/id #uuid "b7d45304-6eb4-5c6d-b2cb-2ed7cead1fe1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186359343} :answer-field/id #uuid "80db2f55-379d-536b-89f3-0c339f244b93" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360210}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0b46e610-7522-5441-8d91-b874b0e467ac" :question/math-academy-id "q-96856" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}-1 & 2 \\\\ 2 & -4\\end{aligned}].\n$$\n\nA triangle $S$ has vertices at $(0,-1),(1,1),$ and $(3,2).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the action of $T?$\n\n- $(-1,4)$\n- $(-2,4)$\n- $(1,-3)$" :question/worked-solution "To find the image of $S$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\nX=[\\begin{aligned}0 & 1 & 3 \\\\ -1 & 1 & 2\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}-1 & 2 \\\\ 2 & -4\\end{aligned}][\\begin{aligned}0 & 1 & 3 \\\\ -1 & 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 1 & 1 \\\\ 4 & -2 & -2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are  $(-2,4)$, and $(1,-2).$ \n\nSo, the correct answer is \" II only.\""} {:db/id #edb/ref 17592186360722 :knowledge-point/_questions [{:db/id #edb/ref 17592186105893 :knowledge-point/id #uuid "ca93cd65-65e3-521e-a1e3-2721f45fb6a6" :knowledge-point/title "Calculating the Coordinates of an Image Formed by a Singular Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b22130e-d538-51cd-afa7-dd10f5401224" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186358688} {:answer/id #uuid "a973aeee-5466-598f-b41a-c22c9961762a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186359210} {:answer/id #uuid "abdf9aea-6545-5bd0-9dec-4d467e2cb7cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186359229} {:answer/id #uuid "c7316c85-95b4-51ee-bfe4-c004c5b0d590" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186359505} {:answer/id #uuid "e5d46810-2201-51e7-ade6-257ff2e94041" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186359786}] :answer-field/correct {:answer/id #uuid "c7316c85-95b4-51ee-bfe4-c004c5b0d590" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186359505} :answer-field/id #uuid "43f8b74e-fb61-58b8-a354-602b2da35b35" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360097}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ae6d946d-9a9f-5816-82c2-7048c4392f45" :question/math-academy-id "q-96857" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}1 & 3 \\\\ 3 & 9\\end{aligned}].\n$$\n\nA triangle $S$ has vertices at $(0,-1),(-2,1),$ and $(3,0).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the action of $T?$ \n\n- $(1,3)$\n- $(0,-3)$\n- $(2,3)$" :question/worked-solution "To find the image of $S$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\nX=[\\begin{aligned}0 & -2 & 3 \\\\ -1 & 1 & 0\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}1 & 3 \\\\ 3 & 9\\end{aligned}][\\begin{aligned}0 & -2 & 3 \\\\ -1 & 1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 1 & 3 \\\\ -9 & 3 & 9\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-3,-9),$  $(1,3)$, and $(3,9).$ \n\nSo, the correct answer is \" I only.\""} {:db/id #edb/ref 17592186360737 :knowledge-point/_questions [{:db/id #edb/ref 17592186166815 :knowledge-point/id #uuid "13e08fd0-4f41-56eb-8650-b72aa739b7a1" :knowledge-point/title "Initial Value Problems and Initial Conditions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f43340e-14ba-55ef-be8c-ef1cd787a6eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186358023} {:answer/id #uuid "718accdf-d9a3-5253-98aa-ae4903fcac71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186358742} {:answer/id #uuid "899e4d94-377f-5a14-922b-59f810bd8af2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186358953} {:answer/id #uuid "caa166e3-8953-5fbc-9ae6-7bea61dc8ba0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186359528} {:answer/id #uuid "ff922e84-d0b6-57f4-ab37-48e970cb34ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186360000}] :answer-field/correct {:answer/id #uuid "1f43340e-14ba-55ef-be8c-ef1cd787a6eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186358023} :answer-field/id #uuid "845a686c-6a12-5b80-92f3-19ed1c6b30c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360216}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "765ad5be-eea7-5159-b982-461fb59d4587" :question/math-academy-id "q-96988" :question/problem "Which of the following systems is a first-order initial value problem?\n\n- $2x-{y}^{′}=\\frac{1}{y}$\n- $3{y}^{′}-2{e}^{x}y={y}^{2},\\,y(\\operatorname{ln}⁡2)=1$\n- $2x{y}^{″}-\\frac{1}{x}={y}^{′},\\,y(2)=1,\\,{y}^{′}(2)=1$" :question/worked-solution "A first-order initial value problem (or IVP) is a first-order ordinary differential equation together with an initial condition that specifies a value of the unknown function at a point in its domain. A first-order initial value problem typically takes the form\n\n$$\n{y}^{′}=f(x,y),\\,y({x}_{0})={y}_{0},\n$$\n\nwhere ${x}_{0}$ and ${y}_{0}$ are constants.\n\nWith that in mind, let's check each option.\n\n- System I  is not a first-order initial value problem. We have a first-order ordinary differential equation, but there is no initial condition.\n\n- System II is a first-order initial value problem. It consists of a first-order differential equation $3{y}^{′}-2{e}^{x}y={y}^{2}$ together with the initial condition $y(\\operatorname{ln}⁡2)=1.$\n\n- System III is not a first-order initial value problem. It consists of a *second*-order differential equation $2x{y}^{″}-\\frac{1}{x}={y}^{′}$ together with *two* initial conditions $y(2)=1,\\,{y}^{′}(2)=1.$ This is a second-order initial value problem.\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186360738 :knowledge-point/_questions [{:db/id #edb/ref 17592186166815 :knowledge-point/id #uuid "13e08fd0-4f41-56eb-8650-b72aa739b7a1" :knowledge-point/title "Initial Value Problems and Initial Conditions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23264a8b-8df6-5874-a144-ca68b4cbe298" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186358060} {:answer/id #uuid "7784ce64-03ae-5ec8-876c-629fc45c3fda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186358782} {:answer/id #uuid "96bee514-2c6a-5789-9365-eecb29e4f851" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186359071} {:answer/id #uuid "d7df7b82-4423-51d2-9b32-202d87afdaa1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186359642} {:answer/id #uuid "e388476a-3c99-5aab-ac42-0c26b86cc367" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186359767}] :answer-field/correct {:answer/id #uuid "7784ce64-03ae-5ec8-876c-629fc45c3fda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186358782} :answer-field/id #uuid "8fb9ff27-ec8c-5a4e-bba3-09983f1442df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360238}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6a63b835-35e3-55e6-8b41-bbb1ab5d0792" :question/math-academy-id "q-96990" :question/problem "Which of the following systems is a first-order initial value problem?\n\n- ${x}^{3}{y}^{′}-\\sqrt{x}=\\operatorname{ln}⁡y,\\,y(1)=1$\n- $\\sqrt{x}{y}^{‴}-x{y}^{′}=\\frac{y}{4},\\,y(0)=2,\\,{y}^{′}(0)=2,\\,{y}^{″}(0)=1$\n- $\\sqrt{3}{y}^{′}-3x=2y,\\,y(\\operatorname{cos}⁡2)=1$" :question/worked-solution "A first-order initial value problem (or IVP) is a first-order ordinary differential equation together with an initial condition that specifies a value of the unknown function at a point in its domain. A first-order initial value problem typically takes the form\n\n$$\n{y}^{′}=f(x,y),\\,y({x}_{0})={y}_{0},\n$$\n\nwhere ${x}_{0}$ and ${y}_{0}$ are constants.\n\nWith that in mind, let's check each option.\n\n- System I is a first-order initial value problem. It consists of a first-order differential equation ${x}^{3}{y}^{′}-\\sqrt{x}=\\operatorname{ln}⁡y$ together with the initial condition $y(1)=1.$\n\n- System II is not a first-order initial value problem. It consists of a *third*-order differential equation $\\sqrt{x}{y}^{‴}-x{y}^{′}=\\frac{y}{4}$ together with *three* initial conditions $y(0)=2,\\,{y}^{′}(0)=2,$ and ${y}^{″}(0)=1.$ This is a third-order initial value problem.\n\n- System III is a first-order initial value problem. It consists of a first-order differential equation $\\sqrt{3}{y}^{′}-3x=2y$ together with the initial condition $y(\\operatorname{cos}⁡2)=1.$\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186360747 :knowledge-point/_questions [{:db/id #edb/ref 17592186129213 :knowledge-point/id #uuid "434a82c2-7964-525a-85b9-eb17fa7b5b26" :knowledge-point/title "Identifying Connections Between Matrices of a Linear Transformation Relative to Different Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e65afa7-46d1-5afb-b5d2-b2f0412cba6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186358427} {:answer/id #uuid "8c089f5c-e903-58e6-a784-6e21c3cac44f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186358967} {:answer/id #uuid "8c6a5dd4-4724-595b-ba19-d29c788800ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186358973} {:answer/id #uuid "af233d2f-156d-5c8e-8398-766737916c19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186359274} {:answer/id #uuid "dc55d258-5977-59dc-8e0c-7ebe80d74489" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186359685}] :answer-field/correct {:answer/id #uuid "dc55d258-5977-59dc-8e0c-7ebe80d74489" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186359685} :answer-field/id #uuid "e1acc681-9363-541e-8dbd-1288a1ce06b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360396}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "63a8e650-529a-5d09-8a67-87993316a8b5" :question/math-academy-id "q-97061" :question/problem "Let $[T]_{B}$ and $[T]_{C}$ be the matrices of a linear transformation $T$ relative to the bases $B$ and $C,$ respectively. If ${P}_{B\\to C}$ is the change-of-coordinates matrix from basis $B$ to basis $C,$ which of the following statements are true?\n\n- $[T]_{C}={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1}$\n- $[T]_{B}={P}_{B\\to C}\\cdot [T]_{C}\\cdot {P}_{B\\to C}$\n- $[T]_{B}={P}_{B\\to C}^{-1}\\cdot [T]_{C}\\cdot {P}_{B\\to C}^{-1}$" :question/worked-solution "The connection between the matrices of our linear transformation $T$ relative to the bases $B$ and $C$ is given by the following diagram:\n\n![](images/1b/1b81504d6fdcabee0e1f586fef3dd2af5a57a8411ba4d22429e00e09b171a4d1.png)\n\n \n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{C}={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1},\n$$\n\nwhere ${P}_{B\\to C}$ is the change-of-coordinates matrix from $B$ to $C.$\n\nSolving this equation for $[T]_{B},$ we obtain the alternative formulation\n\n$$\n[T]_{B}={P}_{B\\to C}^{-1}\\cdot [T]_{C}\\cdot {P}_{B\\to C}.\n$$\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186360748 :knowledge-point/_questions [{:db/id #edb/ref 17592186129213 :knowledge-point/id #uuid "434a82c2-7964-525a-85b9-eb17fa7b5b26" :knowledge-point/title "Identifying Connections Between Matrices of a Linear Transformation Relative to Different Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0126d291-57e8-5a47-95e7-f17b87c67adc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186357767} {:answer/id #uuid "2faa1a62-e50d-5711-87c2-d747a024b1a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186358176} {:answer/id #uuid "df2ab9be-1730-5d49-b1bb-fdadff0e5e7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186359710} {:answer/id #uuid "e07b5852-5cbe-56bb-bddf-565b73c4919a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186359723} {:answer/id #uuid "ea1189d0-0658-5c45-b87e-28377c194d27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186359834}] :answer-field/correct {:answer/id #uuid "2faa1a62-e50d-5711-87c2-d747a024b1a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186358176} :answer-field/id #uuid "786c5b92-fd13-5406-99b4-9438b7ec2b4f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360191}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "47f484a7-fae0-59b3-b230-0181ae09e78c" :question/math-academy-id "q-97064" :question/problem "Let $[T]_{B}$ and $[T]_{C}$ be the matrices of a linear transformation $T$ relative to the bases $B$ and $C,$ respectively. If ${P}_{C\\to B}$ is the change-of-coordinates matrix from basis $C$ to basis $B,$ which of the following statements are true?\n\n- $[T]_{C}={P}_{C\\to B}^{-1}\\cdot [T]_{B}\\cdot {P}_{C\\to B}$\n- $[T]_{B}={P}_{B\\to C}\\cdot [T]_{C}\\cdot {P}_{B\\to C}^{-1}$\n- $[T]_{B}={P}_{C\\to B}\\cdot [T]_{C}\\cdot {P}_{C\\to B}^{-1}$" :question/worked-solution "The connection between the matrices of our linear transformation $T$ relative to the bases $B$ and $C$ is given by the following diagram:\n\n![](images/9b/9ba3d1f0eebdfc82c40f36bdbe16896ca15516b623c695b72c331861955329bc.png)\n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{C}={P}_{C\\to B}^{-1}\\cdot [T]_{B}\\cdot {P}_{C\\to B},\n$$\n\nwhere ${P}_{C\\to B}$ is the change-of-coordinates matrix from $C$ to $B.$\n\nSolving this equation for $[T]_{B},$ we obtain the alternative formulation\n\n$$\n[T]_{B}={P}_{C\\to B}\\cdot [T]_{C}\\cdot {P}_{C\\to B}^{-1}.\n$$\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186360749 :knowledge-point/_questions [{:db/id #edb/ref 17592186129213 :knowledge-point/id #uuid "434a82c2-7964-525a-85b9-eb17fa7b5b26" :knowledge-point/title "Identifying Connections Between Matrices of a Linear Transformation Relative to Different Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e08cb24-8d8f-5cc1-add1-be31101b4023" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186358574} {:answer/id #uuid "6505bc72-fe41-5033-