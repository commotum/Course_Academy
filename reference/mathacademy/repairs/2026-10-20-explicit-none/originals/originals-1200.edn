b3-56f6-ba30-b494a7e4e09f" :knowledge-point/title "Identifying Orthogonal Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "461a316f-8095-5736-a73f-14c89cacc5a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186282280} {:answer/id #uuid "60dad401-055a-535d-9243-9223840fe1a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186282513} {:answer/id #uuid "625e4385-042e-59ce-9595-8b37d9481c18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements" :db/id #edb/ref 17592186282530} {:answer/id #uuid "df573c7c-da56-514d-981d-9b61682ec296" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186283638} {:answer/id #uuid "e47fc87c-53d2-5dec-afc7-2330ca8585f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186283680}] :answer-field/correct {:answer/id #uuid "e47fc87c-53d2-5dec-afc7-2330ca8585f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186283680} :answer-field/id #uuid "85eebd06-4496-587a-9e01-4fe697a9b331" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284163}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "71c46d34-a9b9-54b7-8de2-8c7deffeb5f5" :question/math-academy-id "q-177667" :question/problem "$$\nA=[\\begin{aligned}1 & 0 \\\\ 0 & 1 \\\\ 0 & 0\\end{aligned}]\n$$\n\nConsider the matrix $A$ above. Which of the following statements are true?\n\n- $A$ is a square matrix\n- ${A}^{T}\\cdot A=I$\n- $A$ is an orthogonal matrix" :question/worked-solution "Recall that a square matrix $A$ is **orthogonal** if and only if\n\n$$\nA\\cdot {A}^{T}={A}^{T}\\cdot A=I\n$$\n\nwhere $I$ is the identity matrix.\n\nWith that in mind, let's examine the given statements. \n\n- Statement I is false. The number of rows in $A$ is not the same as the number of columns. So, it's not a square matrix.\n\n- Statement II is true. Note that\n\n$$\n{A}^{T}\\cdot A=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & 1 \\\\ 0 & 0\\end{aligned}]=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}].\n$$\n\n- Statement III is false. Since $A$ is not a square matrix, our matrix is **not** orthogonal.\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186284761 :knowledge-point/_questions [{:db/id #edb/ref 17592186198449 :knowledge-point/id #uuid "b4a5d6b1-e76a-5b33-8973-04d1d9062dc6" :knowledge-point/title "Identifying the Orthogonality of a Two-Vector Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "112ffdc2-a1bc-5e4f-a55e-3a3c199d4142" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186281850} {:answer/id #uuid "2cbcca28-caa9-5452-900e-afa2fcabbb83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id #edb/ref 17592186282085} {:answer/id #uuid "b1c77468-c43e-5f90-958c-881c1124c048" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186283228} {:answer/id #uuid "bd3faa70-e43f-5d34-b985-b24b5369ef6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186283332} {:answer/id #uuid "f769c33e-f251-51ba-853e-fdc6f85daede" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186283854}] :answer-field/correct {:answer/id #uuid "f769c33e-f251-51ba-853e-fdc6f85daede" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186283854} :answer-field/id #uuid "09eb1e7f-4a4b-57de-a6db-ec536584eab6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283951}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e9ed15ab-e314-5efe-ab81-8f51e9de96ca" :question/math-academy-id "q-178026" :question/problem "$$\n{u}_{1}=[\\begin{aligned}\\frac{4}{5} \\\\ \\frac{3}{5}\\end{aligned}],\\,{u}_{2}=[\\begin{aligned}-\\frac{3}{5} \\\\ \\frac{4}{5}\\end{aligned}]\n$$\n\nConsider the vectors above, and let $Q$ be an orthogonal linear transformation. Which of the following statements are true?\n\n- ${u}_{1}\\cdot {u}_{2}=0$\n- ${Q({u}_{1}),Q({u}_{2})}$ is orthogonal\n- ${Q({u}_{1}),Q({u}_{2})}$ is orthonormal" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed,\n\n$$\n{u}_{1}\\cdot {u}_{2}=[\\begin{aligned}\\frac{4}{5} \\\\ \\frac{3}{5}\\end{aligned}]\\cdot [\\begin{aligned}-\\frac{3}{5} \\\\ \\frac{4}{5}\\end{aligned}]=-\\frac{12}{25}+\\frac{12}{25}=0.\n$$\n\n- Statement II is true. Indeed, $Q({u}_{1})⊥Q({u}_{2})$ since\n\n$$\nQ({u}_{1})\\cdot Q({u}_{2})={u}_{1}\\cdot {u}_{2}=0.\n$$\n\n- Statement III is true. Indeed, both $Q({u}_{1})$ and $Q({u}_{2})$ are unit vectors:\n\n$$\n\\begin{aligned}‖Q({u}_{1})‖ & =‖{u}_{1}‖=\\sqrt{(\\frac{4}{5})^{2}+(\\frac{3}{5})^{2}}=1 \\\\ ‖Q({u}_{2})‖ & =‖{u}_{2}‖=\\sqrt{(-\\frac{3}{5})^{2}+(\\frac{4}{5})^{2}}=1\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186284764 :knowledge-point/_questions [{:db/id #edb/ref 17592186198449 :knowledge-point/id #uuid "b4a5d6b1-e76a-5b33-8973-04d1d9062dc6" :knowledge-point/title "Identifying the Orthogonality of a Two-Vector Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "109b4732-b4ed-5dc2-93e5-fc6df0a79524" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186281840} {:answer/id #uuid "6bf7ac07-9b77-5d6c-81f0-2fec01a30a87" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186282615} {:answer/id #uuid "763f9ce9-b22a-5b37-9a0d-3ba1d6d6b05a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186282700} {:answer/id #uuid "8b60eee0-9316-537c-a9cb-8496a8579979" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186282892} {:answer/id #uuid "fbcfed0c-7946-5790-89c2-4a9efeb3a303" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id #edb/ref 17592186283894}] :answer-field/correct {:answer/id #uuid "fbcfed0c-7946-5790-89c2-4a9efeb3a303" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id #edb/ref 17592186283894} :answer-field/id #uuid "2c273430-736d-52ef-99e7-8d6ba618f911" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284014}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e16f6fa7-ae80-51bb-bdf3-1add916dcb13" :question/math-academy-id "q-178269" :question/problem "$$\n{u}_{1}=[\\begin{aligned}1 \\\\ 3\\end{aligned}],\\,{u}_{2}=[\\begin{aligned}6 \\\\ 1\\end{aligned}]\n$$\n\nConsider the vectors above, and let $Q$ be an orthogonal linear transformation. Which of the following statements are true?\n\n- ${u}_{1}\\cdot {u}_{2}=0$\n- ${Q({u}_{1}),Q({u}_{2})}$ is orthogonal\n- ${Q({u}_{1}),Q({u}_{2})}$ is orthonormal" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is false. Indeed,\n\n$$\n{u}_{1}\\cdot {u}_{2}=[\\begin{aligned}1 \\\\ 3\\end{aligned}]\\cdot [\\begin{aligned}6 \\\\ 1\\end{aligned}]=6+3\\ne 0.\n$$\n\n- Statement II is false. Notice that, $Q({u}_{1})⊥̸Q({u}_{2})$ since\n\n$$\nQ({u}_{1})\\cdot Q({u}_{2})={u}_{1}\\cdot {u}_{2}\\ne 0.\n$$\n\n- Statement III is false since the set is not even orthogonal.\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186287679 :knowledge-point/_questions [{:db/id #edb/ref 17592186054633 :knowledge-point/id #uuid "b304527c-5cdc-57df-b118-e555f6f8fa5c" :knowledge-point/title "Creating a Schematic for a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c32748d-53f6-5219-89bf-1987877f591c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186284889} {:answer/id #uuid "2fb4fab8-bfa7-5791-960b-b5311170930d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186285221} {:answer/id #uuid "33b8f7d4-18ee-584b-92d5-7808bb34733b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186285264} {:answer/id #uuid "a45d8439-8e2a-50c8-9941-f89c6232644e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186286294} {:answer/id #uuid "ae2217f2-fb07-5826-ae20-a1d1452f2af0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186286378}] :answer-field/correct {:answer/id #uuid "a45d8439-8e2a-50c8-9941-f89c6232644e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186286294} :answer-field/id #uuid "4f04a716-8f4c-5681-944d-09ddbe53e434" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287323}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b608e6a0-7a3f-5af5-a662-35948e07de5a" :question/math-academy-id "q-181279" :question/problem "![](images/08/08754e159a2b204fce6795292c56fb35dd497dc08611ffcbe9d379e1355ab4af.png)\n\nBy finding the missing entries in the schematic shown above for $A\\times B,$ where $A={x,y}$ and $B={0,1,2},$ determine which of the following statements are true.\n\n- $(x,y)\\in A\\times B$\n- $(x,2)\\in A\\times B$\n- $(1,y)\\in A\\times B$" :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nTo complete our schematic of $A\\times B,$ we write an ordered pair whose first coordinate is the corresponding element of $A$ and the second coordinate is the corresponding element of $B$ at each intersection.\n\n![](images/c3/c33000e8aa6c217b5607e43e961aaea10586b615d633dc1b59cc598e2f7af56c.png)\n\nAccording to our diagram:\n\n- $(x,y)\\notin A\\times B\\,\\times $\n\n- $(x,2)\\in A\\times B\\,✓$\n\n- $(1,y)\\notin A\\times B\\,\\times $\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186287684 :knowledge-point/_questions [{:db/id #edb/ref 17592186054814 :knowledge-point/id #uuid "3de9e532-559c-5fc1-a6ad-5fcd1ed77824" :knowledge-point/title "Identifying Special Sets Containing a Given Element"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2229f041-75b6-5428-b04d-fd84c93cb5e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186285093} {:answer/id #uuid "2aa079d8-f342-59fb-874e-748917b910c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$Q$ and $R$ only" :db/id #edb/ref 17592186285160} {:answer/id #uuid "2cbd27c8-d452-5178-8397-fa2634b6a18a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$N,Z,Q$ and $R$ only" :db/id #edb/ref 17592186285180} {:answer/id #uuid "644bb48c-c27b-5ce2-a851-38f1b9ca47e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ only" :db/id #edb/ref 17592186285700} {:answer/id #uuid "d8e53b22-5207-5841-bbbc-6c0acb34d78c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ and $C$ only" :db/id #edb/ref 17592186286763}] :answer-field/correct {:answer/id #uuid "2229f041-75b6-5428-b04d-fd84c93cb5e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186285093} :answer-field/id #uuid "134c758b-4957-51be-95f8-4fc378eea4fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287181}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fcd97869-92b9-51fc-a566-7b09c1bf865d" :question/math-academy-id "q-181522" :question/problem "Consider the following sets:\n\n$$\nN,\\,Z,\\,Q,\\,R,\\,C\n$$\n\nTo which of these sets does the number $\\sqrt{-4}$ belong?" :question/worked-solution "![](images/67/67ef97be4b21a74feaae15f3ff30d5077fc1316874df8de79155316a621e4487.png)\n\nRecall the following:\n\n- $N$ represents the set of **natural numbers**.\n\n- $Z$ represents the set of **integers**.\n\n- $Q$ represents the set of **rational numbers**.\n\n- $R$ represents the set of **real numbers**.\n\n- $C$ represents the set of **complex numbers**\n\nWith that in mind, we note the following:\n\n- First, we note that $\\sqrt{-4}=2\\text{i}$ is a complex number. Therefore, we can write\n\n$$\n\\sqrt{-4}\\in C.\n$$\n\n- Since the imaginary part of $\\sqrt{-4}$ is nonzero, it does *not* belong to $N,Z,Q,$ or $R.$ We can write\n\n$$\n\\sqrt{-4}\\notin N,\\,\\sqrt{-4}\\notin Z,\\,\\sqrt{-4}\\notin Q,\\,\\sqrt{-4}\\notin R.\n$$\n\nTherefore, the correct answer is \"$C$ only.\""} {:db/id #edb/ref 17592186287685 :knowledge-point/_questions [{:db/id #edb/ref 17592186054816 :knowledge-point/id #uuid "1d132801-b9cc-5c0c-a8fa-0c8b840c05bd" :knowledge-point/title "Identifying Sets Containing a Given Element"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "663ed259-6683-5942-9113-3212b3b9965c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186285713} {:answer/id #uuid "937971bd-e796-5103-bbcf-2a5981185613" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186286130} {:answer/id #uuid "967f2de7-fc18-579d-8e31-31e89c1e8a76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186286155} {:answer/id #uuid "e0509c1f-9a2e-5ec7-bc1e-a4e57005dbc4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186286830} {:answer/id #uuid "f6fb0ac1-b46b-5f85-a67a-12bbdc222ef7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186287050}] :answer-field/correct {:answer/id #uuid "f6fb0ac1-b46b-5f85-a67a-12bbdc222ef7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186287050} :answer-field/id #uuid "309eca38-c8d0-544b-8ab8-dabc935a86c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287250}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e51e86f2-eaf4-5f67-aebb-f55a23118243" :question/math-academy-id "q-181544" :question/problem "To which of the following sets does the number $-\\pi $ belong?\n\n- ${Q}^{-}$\n- $R$\n- $Q$\n- $C$" :question/worked-solution "The number $-\\pi $ is not a rational number. Consequently, $-\\pi $ does not belong to any of the sets  ${Q}^{-}$ nor $Q.$\n\nHowever, $-\\pi $ is a real number, so it belongs to $R.$\n\nFinally, since every real number is also a complex number, $-\\pi $ also belongs to $C.$\n\nTherefore, the correct answer is \"II and IV only.\""} {:db/id #edb/ref 17592186287686 :knowledge-point/_questions [{:db/id #edb/ref 17592186054816 :knowledge-point/id #uuid "1d132801-b9cc-5c0c-a8fa-0c8b840c05bd" :knowledge-point/title "Identifying Sets Containing a Given Element"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d305da1-10d6-5355-9cb5-30cb01bd3454" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186284896} {:answer/id #uuid "4a9b260b-9d22-5a49-84aa-81da5ff954e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186285480} {:answer/id #uuid "5cf800de-d960-55be-8e26-b8ab08e882bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186285641} {:answer/id #uuid "c53a58bf-a01a-5b0a-966d-3fa8b70d62cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "IV only" :db/id #edb/ref 17592186286595} {:answer/id #uuid "c5553184-f1f9-5273-ac8e-210c2376e7f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186286597}] :answer-field/correct {:answer/id #uuid "c53a58bf-a01a-5b0a-966d-3fa8b70d62cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "IV only" :db/id #edb/ref 17592186286595} :answer-field/id #uuid "aaca06d1-7c53-5668-966d-e6c98a240158" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287495}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7e2347db-9785-54d2-a2a4-893dc1f56ec9" :question/math-academy-id "q-181545" :question/problem "To which of the following sets does the number $\\frac{1}{\\pi }$ belong?\n\n- $Z$\n- ${Q}^{+}$\n- $Q$\n- $R$" :question/worked-solution "The number $\\frac{1}{\\pi }$ is not an integer nor a rational number. Consequently, $\\frac{1}{\\pi }$ does not belong to any of the sets $Z,$ ${Q}^{+},$ nor $Q.$\n\nHowever, $\\frac{1}{\\pi }$ is a real number, so it belongs to $R.$\n\nTherefore, the correct answer is \"IV only.\""} {:db/id #edb/ref 17592186287711 :knowledge-point/_questions [{:db/id #edb/ref 17592186198271 :knowledge-point/id #uuid "26758016-ed47-562a-9338-85c71ffbeaa9" :knowledge-point/title "Sets Defined Using Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15eae42a-84d3-5af4-9723-ca2e6821bd94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186284984} {:answer/id #uuid "1fc5b7e6-5ceb-5502-967e-b2e4311ce926" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186285072} {:answer/id #uuid "51d3a5cb-ab59-516d-82c8-bb3f3b8fa2b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186285541} {:answer/id #uuid "c67d60a5-4f36-5417-b8c0-6c359323b2d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186286610} {:answer/id #uuid "d1a52de5-ebd4-528c-a391-a6e41b264435" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186286695}] :answer-field/correct {:answer/id #uuid "51d3a5cb-ab59-516d-82c8-bb3f3b8fa2b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186285541} :answer-field/id #uuid "b4557020-2974-5580-8d39-25a92c52ddd9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287520}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b09e4d7d-54df-5b2a-b13d-108c786b3198" :question/math-academy-id "q-181643" :question/problem "Which of the following sets are infinite?\n\nI. $A={{f}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}({e}^{x-1})\\,:\\,n\\in {N}_{0}}$\n\nII. $B={{g}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}({e}^{-2x})\\,:\\,n\\in {N}_{0}}$\n\nIII. $C={{h}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}({e}^{x/2})\\,:\\,n\\in {N}_{0}}$" :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements.\n\n- The set $A$ is finite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{f}^{(0)}(x) & ={e}^{x-1} \\\\ {f}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{x-1})={e}^{x-1} \\\\ {f}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{x-1})={e}^{x-1} \\\\ {f}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{x-1})={e}^{x-1} \\\\ ⋮\\end{aligned}\n$$\n\nThus, $A$ contains only one element:\n\n$$\nA={{e}^{x-1}}.\n$$\n\nConsequently, $|A|=1,$ which is finite.\n\n- The set $B$ is infinite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{g}^{(0)}(x) & ={e}^{-2x} \\\\ {g}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{-2x})=-2{e}^{-2x} \\\\ {g}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-2{e}^{-2x})=4{e}^{-2x} \\\\ {g}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{-2x})=-8{e}^{-2x} \\\\ ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nB={{e}^{-2x},-2{e}^{-2x},4{e}^{-2x},-8{e}^{-2x},…}\n$$\n\nConsequently, $B$ is infinite.\n\n- The set $C$ is infinite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{h}^{(0)}(x) & ={e}^{x/2} \\\\ {h}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{x/2})=\\frac{1}{2}{e}^{x/2} \\\\ {h}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{e}^{x/2})=\\frac{1}{4}{e}^{x/2} \\\\ {h}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{4}{e}^{x/2})=\\frac{1}{8}{e}^{x/2} \\\\ ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nC={{e}^{x/2},\\frac{1}{2}{e}^{x/2},\\frac{1}{4}{e}^{x/2},\\frac{1}{8}{e}^{x/2},…}\n$$\n\nConsequently, $C$ is infinite.\n\nTherefore, the correct answer is \"$B$ and $C$ only.\""} {:db/id #edb/ref 17592186287712 :knowledge-point/_questions [{:db/id #edb/ref 17592186198271 :knowledge-point/id #uuid "26758016-ed47-562a-9338-85c71ffbeaa9" :knowledge-point/title "Sets Defined Using Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36a60e37-2471-5aa2-b57a-1481a0f6284d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186285298} {:answer/id #uuid "94ce2f0a-5b1b-5d86-8907-3894fa6c197b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186286141} {:answer/id #uuid "a6a848df-7548-5571-afb1-68281340115c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186286309} {:answer/id #uuid "bafe69e6-c6fa-50d5-8f8e-35701bfd258b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186286489} {:answer/id #uuid "e369fe1e-2605-5bb4-9f07-207e66002d01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186286866}] :answer-field/correct {:answer/id #uuid "a6a848df-7548-5571-afb1-68281340115c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186286309} :answer-field/id #uuid "e5c53cb0-8edb-512b-93f2-6deb1470cc08" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287619}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "614d2565-08b2-5cdc-9df9-02ccb7032ebd" :question/math-academy-id "q-181650" :question/problem "Which of the following sets are infinite?\n\nI. $A={{f}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(\\operatorname{cos}⁡2x)\\,:\\,n\\in {N}_{0}}$\n\nII. $B={{g}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(-\\operatorname{sin}⁡x)\\,:\\,n\\in {N}_{0}}$\n\nIII. $C={{h}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(\\operatorname{sec}⁡x)\\,:\\,n\\in {N}_{0}}$" :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements.\n\n- The set $A$ is infinite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{f}^{(0)}(x) & =\\operatorname{cos}⁡2x \\\\ {f}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡2x)=-2\\operatorname{sin}⁡2x \\\\ {f}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-2\\operatorname{sin}⁡2x)=-4\\operatorname{cos}⁡2x \\\\ {f}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-4\\operatorname{cos}⁡2x)=8\\operatorname{sin}⁡2x \\\\ ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nA={\\operatorname{cos}⁡2x,-2\\operatorname{sin}⁡2x,-4\\operatorname{cos}⁡2x,8\\operatorname{sin}⁡2x,…}\n$$\n\nConsequently, $A$ is infinite.\n\n- The set $B$ is finite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{g}^{(0)}(x) & =-\\operatorname{sin}⁡x \\\\ {g}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-\\operatorname{sin}⁡x)=-\\operatorname{cos}⁡x \\\\ {g}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-\\operatorname{cos}⁡x)=\\operatorname{sin}⁡x \\\\ {g}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡x)=\\operatorname{cos}⁡x \\\\ {g}^{(4)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡x)=-\\operatorname{sin}⁡x \\\\ ⋮\\end{aligned}\n$$\n\nThus, $B$ contains four elements:\n\n$$\nB={-\\operatorname{sin}⁡x,-\\operatorname{cos}⁡x,\\operatorname{sin}⁡x,\\operatorname{cos}⁡x}\n$$\n\nConsequently, $|B|=4,$ which is finite.\n\n- The set $C$ is infinite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{h}^{(0)}(x) & =\\operatorname{sec}⁡x \\\\ {h}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sec}⁡x)=\\operatorname{sec}⁡x\\operatorname{tan}⁡x \\\\ {h}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sec}⁡x\\operatorname{tan}⁡x)=2{sec}^{3}⁡x-\\operatorname{sec}⁡x \\\\ ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nC={\\operatorname{sec}⁡x,\\operatorname{sec}⁡x\\operatorname{tan}⁡x,2{sec}^{3}⁡x-\\operatorname{sec}⁡x,…}\n$$\n\nConsequently, $C$ is infinite.\n\nTherefore, the correct answer is \"$A$ and $C$ only.\""} {:db/id #edb/ref 17592186287713 :knowledge-point/_questions [{:db/id #edb/ref 17592186198271 :knowledge-point/id #uuid "26758016-ed47-562a-9338-85c71ffbeaa9" :knowledge-point/title "Sets Defined Using Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45239c87-b18f-5242-9853-f41f8f4874b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186285418} {:answer/id #uuid "573454a9-84bc-5580-a25d-f506a568c8ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186285589} {:answer/id #uuid "780e8763-99bf-5416-800d-163ae64ab60f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186285907} {:answer/id #uuid "afaf5c4e-80d0-56aa-acae-ea3fd789d969" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186286388} {:answer/id #uuid "f372104c-f20b-5b83-84aa-93dd31a6cd3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186287017}] :answer-field/correct {:answer/id #uuid "45239c87-b18f-5242-9853-f41f8f4874b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186285418} :answer-field/id #uuid "d6a71da9-8273-58bf-8716-79867df875a4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287585}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "135e3cdb-fb83-5539-93de-65d28076eb80" :question/math-academy-id "q-181652" :question/problem "Which of the following sets are infinite?\n\nI. $A={{f}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(\\operatorname{tan}⁡x)\\,:\\,n\\in {N}_{0}}$\n\nII. $B={{g}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(\\operatorname{sin}⁡3x)\\,:\\,n\\in {N}_{0}}$\n\nIII. $C={{h}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(3\\operatorname{sin}⁡x)\\,:\\,n\\in {N}_{0}}$" :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements.\n\n- The set $A$ is infinite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{f}^{(0)}(x) & =\\operatorname{tan}⁡x \\\\ {f}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡x)={sec}^{2}⁡x \\\\ {f}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}({sec}^{2}⁡x)=2{sec}^{2}⁡x\\operatorname{tan}⁡x \\\\ ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nA={\\operatorname{tan}⁡x,{sec}^{2}⁡x,2{sec}^{2}⁡x\\operatorname{tan}⁡x,…}\n$$\n\nConsequently, $A$ is infinite.\n\n- The set $B$ is also infinite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{g}^{(0)}(x) & =\\operatorname{sin}⁡3x \\\\ {g}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡3x)=3\\operatorname{cos}⁡3x \\\\ {g}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(3\\operatorname{cos}⁡3x)=-9\\operatorname{sin}⁡3x \\\\ {g}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-9\\operatorname{sin}⁡3x)=-27\\operatorname{cos}⁡3x \\\\ ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nB={\\operatorname{sin}⁡3x,3\\operatorname{cos}⁡3x,-9\\operatorname{sin}⁡3x,-27\\operatorname{cos}⁡3x,…}\n$$\n\nConsequently, $B$ is infinite.\n\n- The set $C$ is finite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{h}^{(0)}(x) & =3\\operatorname{sin}⁡x \\\\ {h}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(3\\operatorname{sin}⁡x)=3\\operatorname{cos}⁡x \\\\ {h}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(3\\operatorname{cos}⁡x)=-3\\operatorname{sin}⁡x \\\\ {h}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-3\\operatorname{sin}⁡x)=-3\\operatorname{cos}⁡x \\\\ {h}^{(4)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-3\\operatorname{cos}⁡x)=3\\operatorname{sin}⁡x \\\\ ⋮\\end{aligned}\n$$\n\nThus, $C$ contains four elements:\n\n$$\nC={3\\operatorname{sin}⁡x,3\\operatorname{cos}⁡x,-3\\operatorname{sin}⁡x,-3\\operatorname{cos}⁡x}\n$$\n\nConsequently, $|C|=4,$ which is finite.\n\nTherefore, the correct answer is \"$A$ and $B$ only.\""} {:db/id #edb/ref 17592186287717 :knowledge-point/_questions [{:db/id #edb/ref 17592186198270 :knowledge-point/id #uuid "f98332fd-e902-5390-a4d3-4e181ce97219" :knowledge-point/title "Sets Defined Using Trigonometric Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55b08ff5-bfcc-5989-8c71-5e69e9422989" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186285575} {:answer/id #uuid "67de69fa-1e6f-5a32-b489-7c59b5e3dfce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186285738} {:answer/id #uuid "a903f83b-b5c3-56a7-a880-f26f71d8db64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A,$ $B,$ and $C$" :db/id #edb/ref 17592186286328} {:answer/id #uuid "b88702cb-8ca5-51bc-b377-a6219664838b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186286471} {:answer/id #uuid "eb784300-190f-5a99-8906-929fd5a165b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186286944}] :answer-field/correct {:answer/id #uuid "a903f83b-b5c3-56a7-a880-f26f71d8db64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A,$ $B,$ and $C$" :db/id #edb/ref 17592186286328} :answer-field/id #uuid "3a75d6dc-29d8-58ed-bb9f-8a06bf5ab301" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287268}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7f218f2c-c350-5f75-a74b-659b486077d2" :question/math-academy-id "q-181674" :question/problem "Which of the following sets are infinite?\n\nI. $A={n\\in Z\\,:\\,\\operatorname{tan}⁡(\\frac{n\\pi }{2})=0}$\n\nII. $B={q\\in Q\\,:\\,\\operatorname{tan}⁡(\\frac{q\\pi }{2})=0}$\n\nIII. $C={x\\in R\\,:\\,\\operatorname{tan}⁡(\\frac{x\\pi }{2})=0}$" :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements.\n\nWe start by finding the solutions to the equation $\\operatorname{tan}⁡(\\frac{x\\pi }{2})=0$ for $x\\in R:$\n\n$$\n\\begin{aligned}\\frac{x\\pi }{2} & =m\\pi  \\\\ x & =2m,\\,m\\in Z\\end{aligned}\n$$\n\nWith that in mind, let's examine our sets:\n\n- The set $A$ is infinite. Listing the elements of $B$ for different values of $m,$ we have\n\n$$\nA={…,-2,0,2,4,…}.\n$$\n\n- The set $B$ is infinite. Since $A$ is infinite, and $A⊆B,$ it follows that $B$ is infinite.\n\n- The set $C$ is infinite. Since $B$ is infinite, and $B⊆C,$ it follows that $C$ is infinite.\n\nTherefore, the correct answer is \"$A,$ $B,$ and $C.$\""} {:db/id #edb/ref 17592186287731 :knowledge-point/_questions [{:db/id #edb/ref 17592186198271 :knowledge-point/id #uuid "26758016-ed47-562a-9338-85c71ffbeaa9" :knowledge-point/title "Sets Defined Using Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d553d05-8487-5735-9096-0b6509c082fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186285191} {:answer/id #uuid "6d1f19f1-6d18-5d75-8a3c-2c19eccd34ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186285789} {:answer/id #uuid "6efc152b-1c43-5917-9679-2a6ab86d48bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186285818} {:answer/id #uuid "81df8ddf-8888-573b-a9c5-60409500a208" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186285979} {:answer/id #uuid "9b3cf821-82da-57d3-899f-c54449ad805e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186286209}] :answer-field/correct {:answer/id #uuid "9b3cf821-82da-57d3-899f-c54449ad805e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186286209} :answer-field/id #uuid "5f0db27d-f520-566e-a6c7-2819cea98411" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287352}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c54f5b27-abdd-5f0e-891e-7fb28f946241" :question/math-academy-id "q-181702" :question/problem "Which of the following sets are infinite?\n\n- $A={{f}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(\\frac{1}{x})\\,:\\,n\\in {N}_{0}}$\n- $B={{g}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}({x}^{3})\\,:\\,n\\in {N}_{0}}$\n- $C={{h}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(4x)\\,:\\,n\\in {N}_{0}}$" :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements.\n\n- The set $A$ is infinite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{f}^{(0)}(x) & =\\frac{1}{x} \\\\ {f}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{x})=-\\frac{1}{{x}^{2}} \\\\ {f}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-\\frac{1}{{x}^{2}})=\\frac{2}{{x}^{3}} \\\\ {f}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{{x}^{3}})=-\\frac{6}{{x}^{4}} \\\\ ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nA={\\frac{1}{x},-\\frac{1}{{x}^{2}},\\frac{2}{{x}^{3}},-\\frac{6}{{x}^{4}},…}\n$$\n\nConsequently, $A$ is infinite.\n\n- The set $B$ is finite. Listing a few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{g}^{(0)}(x) & ={x}^{3} \\\\ {g}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{3})=3{x}^{2} \\\\ {g}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{2})=6x \\\\ {g}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(6x)=6 \\\\ {g}^{(4)}(x) & =\\frac{\\text{d}}{\\text{d}x}(6)=0 \\\\ {g}^{(5)}(x) & =\\frac{\\text{d}}{\\text{d}x}(0)=0 \\\\  & ⋮\\end{aligned}\n$$\n\nThus, for $n>4,$ we have ${g}^{(n)}(x)=0.$ Listing a few elements of our set, we have the following:\n\n$$\nB={{x}^{3},3{x}^{2},6x,6,0}.\n$$\n\nConsequently, $|B|=5,$ which is finite.\n\n- The set $C$ is also finite. Listing a few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{h}^{(0)}(x) & =4x \\\\ {h}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(4x)=4 \\\\ {h}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(4)=0 \\\\ {h}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(0)=0 \\\\  & ⋮\\end{aligned}\n$$\n\nThus, for $n>2,$ we have ${h}^{(n)}(x)=0.$ Listing a few elements of our set, we have the following:\n\n$$\nC={4x,4,0}.\n$$\n\nConsequently, $|C|=3,$ which is finite.\n\nTherefore, the correct answer is \"$A$ only.\""} {:db/id #edb/ref 17592186287739 :knowledge-point/_questions [{:db/id #edb/ref 17592186198269 :knowledge-point/id #uuid "efdb77bf-dd8b-5ccc-8265-79bd319afaa3" :knowledge-point/title "Sets Defined Using Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41163f20-8d3b-5907-919d-8c3fec49e7dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186285395} {:answer/id #uuid "42130499-89c8-5104-8223-7de68cee5145" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186285399} {:answer/id #uuid "42ebf907-7a90-531d-a713-8f5c139388fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186285406} {:answer/id #uuid "c2b1f4bc-f277-5418-8dcf-40610dec054b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186286572} {:answer/id #uuid "e4111ad3-8b6a-5b31-9da2-f9f49e4804c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A,B,$ and $C$" :db/id #edb/ref 17592186286874}] :answer-field/correct {:answer/id #uuid "42130499-89c8-5104-8223-7de68cee5145" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186285399} :answer-field/id #uuid "4bfe782d-f2ff-59de-85c4-a6c163678612" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287314}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4302dd15-6000-5073-b484-7b81fc84a4c7" :question/math-academy-id "q-181719" :question/problem "Which of the following sets are infinite?\n\n- $A={n\\in Z\\,:\\,|3n|<10}$\n- $B={q\\in Q\\,:\\,|3q|<10}$\n- $C={x\\in R\\,:\\,|3x|<10}$" :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements. \n\nWe start by solving the following inequality for $x\\in R:$\n\n$$\n\\begin{aligned}|3x|<10 \\\\ 3|x|<10 \\\\ |x|<\\frac{10}{3}\\end{aligned}\n$$\n\nwhich gives\n\n$$\n-\\frac{10}{3}<x<\\frac{10}{3}\n$$\n\nand can be expressed as $x\\in I=(-\\frac{10}{3},\\frac{10}{3}).$ \n\nWith that in mind, let's examine our sets:\n\n- The set $A$ is finite. If $n\\in Z,$ the solutions to the inequality $|3n|<10$ are all the integers that lie in the interval $I.$ Therefore, \n\n$$\nA={-3,-2,-1,0,1,2,3}.\n$$\n\nConsequently, $|A|=7,$ which is finite.\n\n- The set $B$ is infinite. If $q\\in Q,$ the solutions to $|3q|<10$ are all the rational numbers that lie in the interval $I.$ Since any real interval of nonzero length contains infinitely many rational numbers, it follows that $B$ is infinite.\n\n- The set $C$ is infinite. Since $B$ is infinite, and $B⊂C,$ it follows that $C$ is infinite.\n\nTherefore, the correct answer is \"$B$ and $C$ only.\""} {:db/id #edb/ref 17592186287740 :knowledge-point/_questions [{:db/id #edb/ref 17592186198269 :knowledge-point/id #uuid "efdb77bf-dd8b-5ccc-8265-79bd319afaa3" :knowledge-point/title "Sets Defined Using Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26ec0925-d738-54c9-871f-b146cc459e2b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186285129} {:answer/id #uuid "6045a956-a4ad-53c8-9ac0-2a66591b3a5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A,B,$ and $C$ only" :db/id #edb/ref 17592186285669} {:answer/id #uuid "8930c028-8bb5-5316-83c0-68ead489285e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186286044} {:answer/id #uuid "b398f3e2-ff4b-5483-9fb4-646de4e8068d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186286424} {:answer/id #uuid "c5db0d3a-6d24-5293-a1b9-40ed028d7434" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186286605}] :answer-field/correct {:answer/id #uuid "c5db0d3a-6d24-5293-a1b9-40ed028d7434" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186286605} :answer-field/id #uuid "f8c5764a-7759-5100-a215-d81300911fce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287652}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b4290422-629b-5741-89bd-a435f41aa909" :question/math-academy-id "q-181721" :question/problem "Which of the following sets are infinite?\n\nI. $A={n\\in Z\\,:\\,|5n|\\le 4}$\n\nII. $B={q\\in Q\\,:\\,|5q|\\le 4}$\n\nIII. $C={x\\in R\\,:\\,|5x|\\le 4}$" :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements.\n\nWe start by solving the following inequality for $x\\in R:$\n\n$$\n\\begin{aligned}|5x|\\le 4 \\\\ 5|x|\\le 4 \\\\ |x|\\le \\frac{4}{5}\\end{aligned}\n$$\n\nwhich gives\n\n$$\n-\\frac{4}{5}\\le x\\le \\frac{4}{5}\n$$\n\nand can be expressed as $x\\in I=[-\\frac{4}{5},\\frac{4}{5}].$ \n\nWith that in mind, let's examine our sets:\n\n- The set $A$ is finite. If $n\\in Z,$ the solutions to the inequality $|5n|\\le 4$ are all the integers that lie in the interval $I.$ Therefore, \n\n$$\nA={0}.\n$$\n\nConsequently, $|A|=1,$ which is finite.\n\n- The set $B$ is infinite. If $q\\in Q,$ the solutions to $|5q|\\le 4$ are all the rational numbers that lie in the interval $I.$ Since any real interval of nonzero length contains infinitely many rational numbers, it follows that $B$ is infinite.\n\n- The set $C$ is infinite. Since $B$ is infinite, and $B⊂C,$ it follows that $C$ is infinite.\n\nTherefore, the correct answer is \"$B$ and $C$ only.\""} {:db/id #edb/ref 17592186287742 :knowledge-point/_questions [{:db/id #edb/ref 17592186198269 :knowledge-point/id #uuid "efdb77bf-dd8b-5ccc-8265-79bd319afaa3" :knowledge-point/title "Sets Defined Using Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "075d19a0-1bb0-50f9-977b-9376861a5179" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186284844} {:answer/id #uuid "67922a4d-f26a-5b62-a3b3-d988ff760bfc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186285733} {:answer/id #uuid "b512c37e-87bd-5777-abc9-9995106197e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A,B,$ and $C$" :db/id #edb/ref 17592186286434} {:answer/id #uuid "c0562573-1117-511e-b0ed-e25b14777bc2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186286546} {:answer/id #uuid "ea7acf61-c9a6-545a-966f-300ce8561bc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186286935}] :answer-field/correct {:answer/id #uuid "ea7acf61-c9a6-545a-966f-300ce8561bc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186286935} :answer-field/id #uuid "ad43de07-8e87-5a5a-ab30-1f5eff9c3777" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287506}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c6d13915-d6fa-5b7a-8103-f1358e92b8fa" :question/math-academy-id "q-181740" :question/problem "Which of the following sets are infinite?\n\n- $A={n\\in Z\\,:\\,-{n}^{2}+1>0}$\n- $B={m\\in Z\\,:\\,-{m}^{2}+1<0}$\n- $C={q\\in Q\\,:\\,-{q}^{2}+1<0}$" :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements. \n\nLet's start by analyzing the parabola $y=-{x}^{2}+1$ for $x\\in R.$\n\nFirst, we find the roots of the parabola:\n\n$$\n\\begin{aligned}-{x}^{2}+1 & =0 \\\\ -({x}^{2}-1) & =0 \\\\ -(x-1)(x+1) & =0\\end{aligned}\n$$\n\nSo, the roots are $x=-1$ and $x=1,$ and we can graph the parabola as follows:\n\n![](images/06/0699524ff20f871c9eeca93faa9934832b8e5816fd23b46862e8b01d48e7d86b.png)\n\nTherefore:\n\n- The solution to the inequality $-{x}^{2}+1>0$ for $x\\in R$ is \n\n$$\n-1<x<1\n$$\n\nand can be expressed as $x\\in {I}_{1}=(-1,1).$\n\n- Similarly, the solution to the inequality $-{x}^{2}+1<0$ for $x\\in R$ is \n\n$$\nx<-1\\,\\text{or}\\,x>1\n$$\n\nand can be expressed as $x\\in {I}_{2}=(-\\infty ,-1)\\cup (1,\\infty ).$\n\nWith these in mind, let's examine our sets:\n\n- The set $A$ is finite. If $n\\in Z,$ the solutions to the inequality $-{n}^{2}+1>0$ are all the integers that lie in the interval ${I}_{1}.$ Therefore,\n\n$$\nA={0}.\n$$\n\nConsequently, $|A|=1,$ which is finite.\n\n- The set $B$ is infinite. If $m\\in Z,$ the solutions to the inequality $-{m}^{2}+1<0$ are all the integers that lie in the interval ${I}_{2}.$ Therefore,\n\n$$\nB={…,-3,-2}\\cup {2,3,…}.\n$$\n\n- The set $C$ is infinite. If $q\\in Q,$ the solutions to $-{q}^{2}+1<0$ are all the rational numbers that lie in the interval ${I}_{2}.$ Since any real interval of nonzero length contains infinitely many rational numbers, it follows that $C$ is infinite.\n\nTherefore, the correct answer is \"$B$ and $C$ only.\""} {:db/id #edb/ref 17592186287748 :knowledge-point/_questions [{:db/id #edb/ref 17592186198269 :knowledge-point/id #uuid "efdb77bf-dd8b-5ccc-8265-79bd319afaa3" :knowledge-point/title "Sets Defined Using Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0df8f70d-37d2-51d1-8769-6dc393d0b548" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186284909} {:answer/id #uuid "57b16d2e-7ea7-5301-831d-37dfced8af24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186285590} {:answer/id #uuid "74353ef9-c5ec-53a1-a641-ddfe8410543d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186285862} {:answer/id #uuid "8ac65b06-4d00-5534-b585-245486127bdb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186286062} {:answer/id #uuid "f0bae2f9-40d0-512b-b04b-46878dc3ed51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186286996}] :answer-field/correct {:answer/id #uuid "57b16d2e-7ea7-5301-831d-37dfced8af24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186285590} :answer-field/id #uuid "3782d53b-9ab4-51be-b256-47d16c8f4594" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287262}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "29b1f7f7-72db-5315-ae82-b2adaab04321" :question/math-academy-id "q-181768" :question/problem "Which of the following sets are infinite?\n\n- $A={n\\in Z\\,:\\,{n}^{2}-2n\\le 0}$\n- $B={m\\in Z\\,:\\,{m}^{2}-2m\\ge 0}$\n- $C={q\\in Q\\,:\\,{q}^{2}-2q\\le 0}$" :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements. \n\nLet's start by analyzing the parabola $y={x}^{2}-2x$ for $x\\in R.$\n\nFirst, we find the roots of the parabola:\n\n$$\n\\begin{aligned}{x}^{2}-2x & =0 \\\\ x(x-2) & =0\\end{aligned}\n$$\n\nSo, the roots are $x=0$ and $x=2,$ and we can graph the parabola as follows:\n\n![](images/49/496c6d53993ca6cae499f617bca42dbc42e4c57bffa278da6312a5b1723bdcbc.png)\n\nTherefore:\n\n- The solution to the inequality ${x}^{2}-2x\\le 0$ for $x\\in R$ is \n\n$$\n0\\le x\\le 2\n$$\n\nand can be expressed as $x\\in {I}_{1}=[0,2].$\n\n- Similarly, the solution to the inequality ${x}^{2}-2x\\ge 0$ for $x\\in R$ is \n\n$$\nx\\le 0\\,\\text{or}\\,x\\ge 2\n$$\n\nand can be expressed as $x\\in {I}_{2}=(-\\infty ,0]\\cup [2,\\infty ).$\n\nWith these in mind, let's examine our sets:\n\n- The set $A$ is finite. If $n\\in Z,$ the solutions to the inequality ${n}^{2}-2n\\le 0$ are all the integers that lie in the interval ${I}_{1}.$ Therefore,\n\n$$\nA={0,1,2}.\n$$\n\nConsequently, $|A|=3,$ which is finite.\n\n- The set $B$ is infinite. If $m\\in Z,$ the solutions to the inequality ${m}^{2}-2m\\ge 0$ are all the integers that lie in the interval ${I}_{2}.$ Therefore,\n\n$$\nB={…,-1,0}\\cup {2,3,…}.\n$$\n\n- The set $C$ is infinite. If $q\\in Q,$ the solutions to ${q}^{2}-2q\\le 0$ are all the rational numbers that lie in the interval ${I}_{1}.$ Since any real interval of nonzero length contains infinitely many rational numbers, it follows that $C$ is infinite.\n\nTherefore, the correct answer is \"$B$ and $C$ only.\""} {:db/id #edb/ref 17592186287770 :knowledge-point/_questions [{:db/id #edb/ref 17592186054636 :knowledge-point/id #uuid "3fca5176-1359-5ad8-b012-592ffa9b20b5" :knowledge-point/title "Cartesian Products With Three Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22a28924-3c6d-54ea-9a3f-6a79a2680c20" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186285100} {:answer/id #uuid "24e268d9-4aab-5d16-a062-359f1a99535e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186285110} {:answer/id #uuid "2e244dec-e2f1-530c-87ad-44b58106f2cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186285197} {:answer/id #uuid "c117a24a-f0e7-5a98-9f93-b5be28219407" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186286554} {:answer/id #uuid "f891c455-3db3-51a1-bece-aab74e45482e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186287059}] :answer-field/correct {:answer/id #uuid "c117a24a-f0e7-5a98-9f93-b5be28219407" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186286554} :answer-field/id #uuid "63a8454a-367b-5fe5-b2d9-ca149e1e0897" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287357}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e5ba42f9-2582-56fd-9cc1-974b79efc1dd" :question/math-academy-id "q-181941" :question/problem "If $A={a,b}$ and $B={1,2},$ which of the following elements belong to $A\\times A\\times B?$\n\n- $(a,a,1)$\n- $(b,a,2)$\n- $((a,b),2)$" :question/worked-solution "The Cartesian product $A\\times B\\times C$ consists of all ordered triples whose first coordinate belongs to $A,$ second coordinate belongs to $B,$ and the third coordinate belongs to $C.$\n\nIn this case, $A\\times A\\times B$ consists of every combination of ${a,b}$ with ${a,b}$ and ${1,2},$ which results in\n\n$$\n\\begin{aligned}A\\times A\\times B={ & (a,a,1),(a,a,2),(a,b,1),(a,b,2), \\\\  & (b,a,1),(b,a,2),(b,b,1),(b,b,2)}.\\end{aligned}\n$$\n\nNote that\n\n$$\n|A\\times A\\times B|=|A|\\cdot |A|\\cdot |B|=2\\cdot 2\\cdot 2=8.\n$$\n\nFrom the given options, we see that both $(a,a,1)$ and $(b,a,2)$ are in $A\\times A\\times B.$\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186287771 :knowledge-point/_questions [{:db/id #edb/ref 17592186054636 :knowledge-point/id #uuid "3fca5176-1359-5ad8-b012-592ffa9b20b5" :knowledge-point/title "Cartesian Products With Three Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67e32f28-ba6c-58f8-9cde-0935c48a2104" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186285740} {:answer/id #uuid "6a7b550d-e11b-5ef6-84ad-ddc1cf3a3ff0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186285762} {:answer/id #uuid "a154c139-7cdd-5836-911f-28e304514e94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186286261} {:answer/id #uuid "d541c411-a51e-53f1-88e9-bf18012d7b3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186286728} {:answer/id #uuid "e83fbed6-e2ea-590b-a18d-ce8440dc2c42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186286913}] :answer-field/correct {:answer/id #uuid "e83fbed6-e2ea-590b-a18d-ce8440dc2c42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186286913} :answer-field/id #uuid "e0803712-7ce7-585b-8ac2-64340064603f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287605}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5d67a16e-2bb4-53de-83ef-8253a6e9b7e6" :question/math-academy-id "q-181942" :question/problem "If $A={8,9}$ and $B={x,y},$ which of the following elements belong to $A\\times B\\times A?$\n\n- $(9,9,y)$\n- $(8,x,y)$\n- $(9,y,8)$" :question/worked-solution "The Cartesian product $A\\times B\\times C$ consists of all ordered triples whose first coordinate belongs to $A,$ second coordinate belongs to $B,$ and the third coordinate belongs to $C.$\n\nIn this case, $A\\times B\\times A$ consists of every combination of ${8,9}$ with ${x,y}$ and ${8,9},$ which results in\n\n$$\n\\begin{aligned}A\\times B\\times A={ & (8,x,8),(8,x,9),(8,y,8),(8,y,9), \\\\  & (9,x,8),(9,x,9),(9,y,8),(9,y,9)}.\\end{aligned}\n$$\n\nNote that\n\n$$\n|A\\times B\\times A|=|A|\\cdot |B|\\cdot |A|=2\\cdot 2\\cdot 2=8.\n$$\n\nFrom the given options, we see that only $(9,y,8)\\in A\\times B\\times A.$\n\nTherefore, the correct answer is \"III only.\""} {:db/id #edb/ref 17592186287772 :knowledge-point/_questions [{:db/id #edb/ref 17592186054636 :knowledge-point/id #uuid "3fca5176-1359-5ad8-b012-592ffa9b20b5" :knowledge-point/title "Cartesian Products With Three Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "128cb112-83b8-53c9-b147-b9b4cf21ad0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186284953} {:answer/id #uuid "55a3c3fa-ef53-5a7b-8def-08dc24aa27e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186285572} {:answer/id #uuid "b35fefde-5785-511a-bb0d-c2e8e287b076" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186286422} {:answer/id #uuid "d5c89a29-29e4-5f63-a3e5-c7b69ae260d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186286732} {:answer/id #uuid "ed15f3df-877d-541a-9541-9e0febc1fa9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186286961}] :answer-field/correct {:answer/id #uuid "55a3c3fa-ef53-5a7b-8def-08dc24aa27e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186285572} :answer-field/id #uuid "9749546f-abc1-5769-b983-8820f39b6d3a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287458}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3dced42a-f072-5a03-9e98-5ecc099c95d0" :question/math-academy-id "q-181945" :question/problem "If $A={v,w}$ and $B={3,4,5},$ which of the following elements belong to $A\\times B\\times A?$\n\n- $(v,4,5)$\n- $(v,3,w)$\n- $(w,5,w)$" :question/worked-solution "The Cartesian product $A\\times B\\times C$ consists of all ordered triples whose first coordinate belongs to $A,$ second coordinate belongs to $B,$ and the third coordinate belongs to $C.$\n\nIn this case, $A\\times B\\times A$ consists of every combination of ${v,w}$ with ${3,4,5}$ and ${v,w},$ which results in\n\n$$\n\\begin{aligned}A\\times B\\times A={ & (v,3,v),(v,3,w),(v,4,v),(v,4,w),(v,5,v),(v,5,w), \\\\  & (w,3,v),(w,3,w),(w,4,v),(w,4,w),(w,5,v),(w,5,w)}.\\end{aligned}\n$$\n\nNote that\n\n$$\n|A\\times B\\times A|=|A|\\cdot |B|\\cdot |A|=2\\cdot 3\\cdot 2=12.\n$$\n\nFrom the given options, we see that both $(v,3,w)$ and $(w,5,w)$ are in $A\\times B\\times A.$\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186287773 :knowledge-point/_questions [{:db/id #edb/ref 17592186054636 :knowledge-point/id #uuid "3fca5176-1359-5ad8-b012-592ffa9b20b5" :knowledge-point/title "Cartesian Products With Three Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "023726aa-bdb5-58b6-823e-174eeff1834e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186284807} {:answer/id #uuid "0bc0f0f7-8a28-509f-8f87-0882f5aea05e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186284883} {:answer/id #uuid "39e6c400-e101-5954-86c4-f61b53957456" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186285332} {:answer/id #uuid "c1a53757-c931-58a7-accb-93552c487d59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186286561} {:answer/id #uuid "e1d1fab5-2ca9-5e50-8d02-d40e1e6f8e74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186286844}] :answer-field/correct {:answer/id #uuid "023726aa-bdb5-58b6-823e-174eeff1834e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186284807} :answer-field/id #uuid "b1532e6c-7c4e-56f2-a88f-452ccd1b60c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287515}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "68270c3d-bf20-5dbc-8e60-99dca2522513" :question/math-academy-id "q-181947" :question/problem "If $A={p,q}$ and $B={2,4,6},$ which of the following elements belong to $A\\times A\\times B?$\n\n- $(p,q,2)$\n- $((p,p),4)$\n- $(q,q,6)$" :question/worked-solution "The Cartesian product $A\\times B\\times C$ consists of all ordered triples whose first coordinate belongs to $A,$ second coordinate belongs to $B,$ and the third coordinate belongs to $C.$\n\nIn this case, $A\\times A\\times B$ consists of every combination of ${p,q}$ with ${p,q}$ and ${2,4,6},$ which results in\n\n$$\n\\begin{aligned}A\\times A\\times B={ & (p,p,2),(p,p,4),(p,p,6),(p,q,2),(p,q,4),(p,q,6), \\\\  & (q,p,2),(q,p,4),(q,p,6),(q,q,2),(q,q,4),(q,q,6)}.\\end{aligned}\n$$\n\nNote that\n\n$$\n|A\\times A\\times B|=|A|\\cdot |A|\\cdot |B|=2\\cdot 2\\cdot 3=12.\n$$\n\nFrom the given options, we see that both $(p,q,2)$ and $(q,q,6)$ are in $A\\times A\\times B.$\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186287776 :knowledge-point/_questions [{:db/id #edb/ref 17592186054633 :knowledge-point/id #uuid "b304527c-5cdc-57df-b118-e555f6f8fa5c" :knowledge-point/title "Creating a Schematic for a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0293f2e6-924e-58e9-9d13-9d0d315f9002" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186284809} {:answer/id #uuid "52800430-7da9-5750-957a-fe138372d0bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186285546} {:answer/id #uuid "75d8e253-748f-5343-9c97-cbab141df228" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186285884} {:answer/id #uuid "91d4bc78-d9ae-5a68-921b-13c1a93531d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186286114} {:answer/id #uuid "a29a73b4-ea9e-577c-b53b-8adc8ec0d729" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186286280}] :answer-field/correct {:answer/id #uuid "0293f2e6-924e-58e9-9d13-9d0d315f9002" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186284809} :answer-field/id #uuid "894309b4-f9cd-553e-9900-2f55b6828938" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287437}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "acf6f0a0-0064-5b71-8b07-5e0f0eb96bda" :question/math-academy-id "q-181963" :question/problem "![](images/cb/cb3e6ef6a832f2adbbc5e096bddf2c4f6a0445fbd77a71df5617298f8dad2e51.png)\n\nBy finding the missing entries in the schematic shown above for $A\\times B,$ where $A={a,b,c}$ and $B={2,4,6},$ determine which of the following statements are true.\n\n- $(4,b)\\in A\\times B$\n- $(c,6)\\in A\\times B$\n- $(a,2)\\in A\\times B$" :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nTo complete our schematic of $A\\times B,$ we write an ordered pair whose first coordinate is the corresponding element of $A$ and the second coordinate is the corresponding element of $B$ at each intersection.\n\n![](images/57/57d053cca53046f02201540e655030a37ba8f7a2811e7dc724cf30ca9fd3c072.png)\n\nAccording to our diagram:\n\n- $(4,b)\\notin A\\times B\\,\\times $\n\n- $(c,6)\\in A\\times B\\,✓$\n\n- $(a,2)\\in A\\times B\\,✓$\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186287778 :knowledge-point/_questions [{:db/id #edb/ref 17592186054636 :knowledge-point/id #uuid "3fca5176-1359-5ad8-b012-592ffa9b20b5" :knowledge-point/title "Cartesian Products With Three Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09004638-b23b-5d7c-bf05-024a92db458c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186284860} {:answer/id #uuid "0ea9a8a6-d04d-5edb-bb85-9aaf504db77a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186284914} {:answer/id #uuid "30140e94-31a6-5e00-8d4d-cdfa8e87a563" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186285225} {:answer/id #uuid "8becfc26-2b75-59e1-b3ad-e02c5059b304" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186286069} {:answer/id #uuid "a01533fc-1265-5dae-9827-96be14f562b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186286246}] :answer-field/correct {:answer/id #uuid "a01533fc-1265-5dae-9827-96be14f562b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186286246} :answer-field/id #uuid "b99f6978-6f4a-52c1-a0cb-1ece2ed27467" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287532}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1ec96a4e-9e05-5335-919b-b747e9d81df8" :question/math-academy-id "q-181969" :question/problem "If $A={p,q,r}$ and $B={3,5},$ which of the following elements belong to $B\\times (A\\times A)?$\n\n- $(5,(r,p))$\n- $(q,(5,3))$\n- $(3,q,p)$" :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nIn this case, $A\\times A$ consists of every combination of ${p,q,r}$ with ${p,q,r},$ as shown in the schematic below.\n\n![](images/aa/aad91ef7655fa8a5bf0c9852ee4e5e2166289087a56ac18e932ee3cce17164a0.png)\n\nHence, the set $A\\times A$ is given by\n\n$$\nA\\times A={(p,p),(p,q),(p,r),(q,p),(q,q),(q,r),(r,p),(r,q),(r,r)}.\n$$\n\nNote that \n\n$$\n|A\\times A|=|A|\\cdot |A|=3\\cdot 3=9.\n$$\n\nNow, the Cartesian product\n\n$$\nB\\times (A\\times A)\n$$\n\nconsists of every combination of $B$ and $A\\times A,$ as shown in the schematic below.\n\n![](images/e5/e573cecaa9333e071d980b1b03d65dafadd027506d2c2b9b6e8acfbe15d3be52.png)\n\nNote that \n\n$$\n|B\\times (A\\times A)|=|B|\\cdot |A\\times A|=2\\cdot 9=18.\n$$\n\nFrom the given options, we see that only $(5,(r,p))\\in B\\times (A\\times A).$\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186287780 :knowledge-point/_questions [{:db/id #edb/ref 17592186054633 :knowledge-point/id #uuid "b304527c-5cdc-57df-b118-e555f6f8fa5c" :knowledge-point/title "Creating a Schematic for a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1232328f-69e8-55d3-887e-e4138da6c521" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186284950} {:answer/id #uuid "496e7024-3947-543e-8e38-682d25598921" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186285464} {:answer/id #uuid "562ec188-58f4-50a5-ad1e-066ac3b9f5bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186285580} {:answer/id #uuid "6b5945f9-f26c-5140-b84c-e6bf46e3d5b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186285774} {:answer/id #uuid "f0cc8d74-1e90-5911-8697-bf71e6de36f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186286997}] :answer-field/correct {:answer/id #uuid "f0cc8d74-1e90-5911-8697-bf71e6de36f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186286997} :answer-field/id #uuid "510cd5a8-cfaa-5222-a99d-94d5d42ccfe4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287327}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ffb21c72-0872-5ee1-9c14-274c6c7f743e" :question/math-academy-id "q-181975" :question/problem "![](images/bf/bf1c37a92b184cb3e6c81bbd2d653008f5eff0e3b2131f2f297a336881661c22.png)\n\nUsing the visual schematic above for the Cartesian product ${A}^{2}$ for $A={p,q,r},$ determine which of the following statements are true.\n\n- $(q,q)\\in {A}^{2}$\n- $(p,r)\\in {A}^{2}$\n- ${q}^{2}\\in {A}^{2}$" :question/worked-solution "The set ${A}^{2}$ is equivalent to the Cartesian product $A\\times A.$\n\nThe Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nTo complete our schematic of $A\\times A,$ we write an ordered pair whose first coordinate is the corresponding element of the first set $(A)$ and the second coordinate is the corresponding element of the second set $(A)$ at each intersection.\n\n![](images/91/919ad6e16dcd1d8f02e8c15c7bd1dfa15f67232c99706dfbc1239e1f9a0f99e5.png)\n\nAccording to our diagram:\n\n- $(q,q)\\in {A}^{2}\\,✓$\n\n- $(p,r)\\in {A}^{2}\\,✓$\n\n- ${q}^{2}\\in {A}^{2}\\,\\times $\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186287782 :knowledge-point/_questions [{:db/id #edb/ref 17592186054636 :knowledge-point/id #uuid "3fca5176-1359-5ad8-b012-592ffa9b20b5" :knowledge-point/title "Cartesian Products With Three Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19f7aafa-48da-5a9a-8c4e-2db357b4d84d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186285018} {:answer/id #uuid "80d7f3e3-c855-5354-90bd-482a3a29e8fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186285972} {:answer/id #uuid "ac89eae1-7a02-5a20-8e6e-78af9e33af11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186286365} {:answer/id #uuid "dd658f81-0ef3-5121-9761-f8e1ea69f717" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186286802} {:answer/id #uuid "eb312ff4-8754-5481-8f71-6c35c1ce24a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186286941}] :answer-field/correct {:answer/id #uuid "19f7aafa-48da-5a9a-8c4e-2db357b4d84d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186285018} :answer-field/id #uuid "a96dd43b-afeb-5167-94cd-5072d0236b88" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287492}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6e14f595-c123-5de8-8c3d-4afeb7095ae5" :question/math-academy-id "q-181977" :question/problem "If $A={4,8}$ and $B={x,y,z},$ which of the following elements belong to $A\\times (A\\times B)?$\n\n- $(4,(8,z))$\n- $(8,(8,x))$\n- $(8,4,y)$" :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nIn this case, $A\\times B$ consists of every combination of ${4,8}$ with ${x,y,z},$ as shown in the schematic below.\n\n![](images/72/72feee192b949dcce7b0f10f4e1d772c809bcf73de6c66f15c7de75a4a1ff672.png)\n\nHence, the set $A\\times B$ is given by\n\n$$\nA\\times B={(4,x),(4,y),(4,z),(8,x),(8,y),(8,z)}.\n$$\n\nNote that \n\n$$\n|A\\times B|=|A|\\cdot |B|=2\\cdot 3=6.\n$$\n\nNow, the Cartesian product\n\n$$\nA\\times (A\\times B)\n$$\n\nconsists of every combination of $A$ and $A\\times B,$ as shown in the schematic below.\n\n![](images/1a/1ae41857d4aee82a2a4ad838c20bbe72b05a1505a5f4df3aa4a86fda0fff0612.png)\n\nNote that \n\n$$\n|A\\times (A\\times B)|=|A|\\cdot |A\\times B|=2\\cdot 6=12.\n$$\n\nFrom the given options, we see that both $(4,(8,z))$ and $(8,(8,x))$ are in $A\\times \\text{\\(}A\\times B).$\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186287783 :knowledge-point/_questions [{:db/id #edb/ref 17592186054633 :knowledge-point/id #uuid "b304527c-5cdc-57df-b118-e555f6f8fa5c" :knowledge-point/title "Creating a Schematic for a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e49d978-c74c-5053-916f-da9e91cd465a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186285652} {:answer/id #uuid "66e4ba73-987f-567f-b03a-1a4788dc8fb6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186285726} {:answer/id #uuid "755e41be-466c-54bc-814e-78ded8856969" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186285872} {:answer/id #uuid "85fff24e-7ebb-59f7-a8eb-f0c5e73cb140" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186286020} {:answer/id #uuid "df7f61d1-2b33-51b8-ac5f-36611eacb313" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186286827}] :answer-field/correct {:answer/id #uuid "66e4ba73-987f-567f-b03a-1a4788dc8fb6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186285726} :answer-field/id #uuid "f7cd1dc3-fc29-53e9-9ccf-cd951624e0eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287650}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "16f7d99c-b5b7-5532-9552-dac57833067d" :question/math-academy-id "q-181978" :question/problem "![](images/d6/d6ee87bd861491394c6643679f62cb4b94436bf2777bd2436b3169e779736e2c.png)\n\nUsing the visual schematic above for the Cartesian product ${A}^{2}$ for $A={h,k},$ determine which of the following statements are true.\n\n- ${h}^{2}\\in {A}^{2}$\n- $(h,k)\\in {A}^{2}$\n- $(k,k)\\in {A}^{2}$" :question/worked-solution "The set ${A}^{2}$ is equivalent to the Cartesian product $A\\times A.$\n\nThe Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nTo complete our schematic of $A\\times A,$ we write an ordered pair whose first coordinate is the corresponding element of the first set $(A)$ and the second coordinate is the corresponding element of the second set $(A)$ at each intersection.\n\n![](images/50/507f8f6306c309d5e894cfb1dabfc2019f371911f7878b196e1f329f1b37dfa6.png)\n\nAccording to our diagram:\n\n- ${h}^{2}\\in {A}^{2}\\,\\times $\n\n- $(h,k)\\in {A}^{2}\\,✓$\n\n- $(k,k)\\in {A}^{2}\\,✓$\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186287788 :knowledge-point/_questions [{:db/id #edb/ref 17592186054634 :knowledge-point/id #uuid "a6128eca-7f76-5386-9d67-d81db2943eeb" :knowledge-point/title "Computing a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3145a3cc-a8fa-5e22-9409-4c06adc4e92d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186285233} {:answer/id #uuid "5171921f-5b71-50ae-8b05-c9689f2a44a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186285536} {:answer/id #uuid "8477874d-308e-51fd-aac0-c1299491c71e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186286006} {:answer/id #uuid "abace7ca-ea67-5b94-8452-b153ad1c9de2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186286357} {:answer/id #uuid "e2e0bac0-87ad-598f-a0f8-584b58cdd803" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186286855}] :answer-field/correct {:answer/id #uuid "e2e0bac0-87ad-598f-a0f8-584b58cdd803" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186286855} :answer-field/id #uuid "75ac9360-e05a-56fb-93b2-7d5feaa1faad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287397}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "110cd0b0-c05f-5fa3-a734-2910b10ec096" :question/math-academy-id "q-182009" :question/problem "For the sets $A={k,m},$ $B={-1,3,5},$ and $C=A\\times B,$ determine which of the following statements are true.\n\n- $(-1,k)\\in C$\n- $(k,m)\\in C$\n- $(m,3)\\in C$" :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nIn this case, the schematic for $A\\times B$ is shown below.\n\n![](images/c6/c660ff6d042bdf228387e5ad55651f02b136f738a2e4fa99c3ef3b3faef3e3c5.png)\n\nHence, the set $C=A\\times B$ is given by\n\n$$\nC={(k,-1),(k,3),(k,5),(m,-1),(m,3),(m,5)}.\n$$\n\nTherefore, the correct answer is \"III only.\""} {:db/id #edb/ref 17592186287789 :knowledge-point/_questions [{:db/id #edb/ref 17592186054634 :knowledge-point/id #uuid "a6128eca-7f76-5386-9d67-d81db2943eeb" :knowledge-point/title "Computing a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b32442c-08ba-5d50-8370-b4f7bb2844ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186285346} {:answer/id #uuid "45feb55c-e7bb-5ec4-bd19-6ccbce9dd40d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186285428} {:answer/id #uuid "5938940a-29bf-5630-bd36-aefb018067d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186285604} {:answer/id #uuid "701d78ff-0afb-5095-8913-1e2f45fedc33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186285824} {:answer/id #uuid "f258fef0-e676-5a91-90bd-704c2797ac3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186287010}] :answer-field/correct {:answer/id #uuid "45feb55c-e7bb-5ec4-bd19-6ccbce9dd40d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186285428} :answer-field/id #uuid "26fdac77-4c39-59a1-bd83-eb6b67c2475f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287230}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4b374349-dba8-556c-833d-28419c5d38a1" :question/math-academy-id "q-182011" :question/problem "For the sets $X={x,z},$ $Y={a,b},$ and $Z=X\\times Y,$ determine which of the following statements are true.\n\n- $(a,x)\\in Z$\n- $(z,a)\\in Z$\n- $(z,z)\\in Z$" :question/worked-solution "The Cartesian product $X\\times Y$ consists of all ordered pairs whose first coordinate belongs to $X$ and whose second coordinate belongs to $Y.$\n\nIn this case, the schematic for $X\\times Y$ is shown below.\n\n![](images/b7/b73e7aeb017bd9f7c50f7d110c7933763834eb391ac4a3e97d25f4e587a8a3d4.png)\n\nHence, the set $Z=X\\times Y$ is given by\n\n$$\nZ={(x,a),(x,b),(z,a),(z,b)}.\n$$\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186287791 :knowledge-point/_questions [{:db/id #edb/ref 17592186054634 :knowledge-point/id #uuid "a6128eca-7f76-5386-9d67-d81db2943eeb" :knowledge-point/title "Computing a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15b36e5f-e8a8-5ea9-946e-c4816a26e689" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186284982} {:answer/id #uuid "2d977033-ec3f-53cc-a677-5319105de312" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186285193} {:answer/id #uuid "3418f9d4-3146-507c-b45f-2efcc9ed4974" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186285266} {:answer/id #uuid "65a4153e-cfe4-5447-acfc-d029e30792b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186285710} {:answer/id #uuid "88dd20ce-84ae-5cec-b98c-0addd3860395" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186286041}] :answer-field/correct {:answer/id #uuid "2d977033-ec3f-53cc-a677-5319105de312" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186285193} :answer-field/id #uuid "80e9eb6a-880b-5e87-86c2-04da9fdfec7d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287419}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a2efc8f2-dfe5-5b29-94dc-09dde2c27a4f" :question/math-academy-id "q-182015" :question/problem "For the sets $X={5,10},$ $Y={r,s,t},$ and $Z=X\\times Y,$ determine which of the following statements are true.\n\n- $(5,r)\\in Z$\n- $(r,t)\\in Z$\n- $(10,s)\\in Z$" :question/worked-solution "The Cartesian product $X\\times Y$ consists of all ordered pairs whose first coordinate belongs to $X$ and whose second coordinate belongs to $Y.$\n\nIn this case, the schematic for $X\\times Y$ is shown below.\n\n![](images/1e/1eb13d93fbefc4c7285edef537a9fb3e21339f7a3b37a179eeb150db8d726c1b.png)\n\nHence, the set $Z=X\\times Y$ is given by\n\n$$\nZ={(5,r),(5,s),(5,t),(10,r),(10,s),(10,t)}.\n$$\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186287793 :knowledge-point/_questions [{:db/id #edb/ref 17592186054634 :knowledge-point/id #uuid "a6128eca-7f76-5386-9d67-d81db2943eeb" :knowledge-point/title "Computing a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ba40535-7a9b-5dd6-81a0-8660440ecd3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186284880} {:answer/id #uuid "39a54562-da76-5262-94d8-dae03a4de002" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186285330} {:answer/id #uuid "aedcddb9-24f3-5bcd-9e4e-186ed907f4a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186286381} {:answer/id #uuid "b70faa1d-b0bd-5a05-be76-576658ffc59d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186286458} {:answer/id #uuid "c95ea54e-b8a5-5e00-8424-a086b6273b63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186286624}] :answer-field/correct {:answer/id #uuid "c95ea54e-b8a5-5e00-8424-a086b6273b63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186286624} :answer-field/id #uuid "5203f15a-1200-56ea-98bd-cfd61c7ca2ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287331}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "55b1acd6-5df7-5bc0-a3b3-0f00f1d5d19b" :question/math-academy-id "q-182018" :question/problem "For the sets $X={f,g,h}$ and $Z=X\\times X,$ determine which of the following statements are true.\n\n- $(f,g)\\in Z$\n- $(f,g,h)\\in Z$\n- $(h,h)\\in Z$" :question/worked-solution "The Cartesian product $X\\times X$ consists of all ordered pairs whose first coordinate belongs to $X$ and whose second coordinate belongs to $X.$\n\nIn this case, the schematic for ${X}^{2}=X\\times X$ is shown below.\n\n![](images/17/1718bd6f3f2eaa8dd8fe581b0d938b3b5f1928d5e56a11a324f145e7a481fabe.png)\n\nHence, the set $Z=X\\times X$ is given by\n\n$$\nZ={(f,f),(f,g),(f,h),(g,f),(g,g),(g,h),(h,f),(h,g),(h,h)}.\n$$\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186287794 :knowledge-point/_questions [{:db/id #edb/ref 17592186054634 :knowledge-point/id #uuid "a6128eca-7f76-5386-9d67-d81db2943eeb" :knowledge-point/title "Computing a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "185bd08d-601b-5996-aa46-119809fc0e9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186285004} {:answer/id #uuid "6b25454a-379d-514d-9495-201f4fb2f25e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186285772} {:answer