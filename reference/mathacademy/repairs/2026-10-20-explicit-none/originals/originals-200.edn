r.type/text} :answer/value "III only" :db/id #edb/ref 17592186149560} {:answer/id #uuid "370eafa0-4bc5-59db-869d-c3a8e48711d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186149561}] :answer-field/id #uuid "1b3d5c8a-9c69-53c4-bf41-d1986e372cfa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186149556}] :question/id #uuid "a2a24748-f2b1-5dae-9e25-ddb47fe6a36a" :question/math-academy-id "q-214134" :question/problem "Consider the following relation defined on the set $A$ containing all possible triangles in $R^{2}$.\n\n$xRy⇔x≅y$\n\nRecall that $x≅y$ means that $x$ and $y$ are congruent.\n\nWhich of the following are true?\n\n1. $R$ is reflexive\n2. $R$ is symmetric\n3. $R$ is transitive\n4. $R$ is an equivalence relation"} {:db/id #edb/ref 17592186152502 :knowledge-point/_questions [{:db/id #edb/ref 17592186152067 :knowledge-point/id #uuid "968df6ec-e87e-5770-9c11-e7c8d8a27e6c" :knowledge-point/title "Identifying Equivalence Relations on Finite Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d66d2717-83d7-51b0-a227-fa1fc6809409" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186149569} {:answer/id #uuid "30eef23f-1a55-5ac4-8a57-9c63c6f949e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186149570} {:answer/id #uuid "5b128d60-e594-5aa5-bff5-a1e2fa17357d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186149571} {:answer/id #uuid "66c8be3b-ec27-54c3-a77d-bf9d20dd0b93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, III, and IV" :db/id #edb/ref 17592186149572} {:answer/id #uuid "7410e289-bd9b-5799-8292-33605aba5faf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186149573}] :answer-field/id #uuid "692a1b0c-9534-5975-bd7a-3a92a99093ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186149568}] :question/id #uuid "14a51040-e179-5b66-9e0b-fca0e478f23c" :question/math-academy-id "q-214171" :question/problem "Consider the relation $R$ on the set $A = {0, 1, 2}$ defined as\n$R = {(1, 1), (0, 2), (2, 0)}$.\n\nWhich of the following statements are true?\n\n1. $R$ is reflexive\n2. $R$ is symmetric\n3. $R$ is transitive\n4. $R$ is an equivalence relation"} {:db/id #edb/ref 17592186152569 :knowledge-point/_questions [{:db/id #edb/ref 17592186152280 :knowledge-point/id #uuid "e66005fe-df33-590a-9d9c-91947cd4a608" :knowledge-point/title "Identifying Fundamental Sets of Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "172aeb1b-7420-5210-b2d6-171da5624c7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186305364} {:answer/id #uuid "44b17683-12ce-5c7e-9292-331e29b8200f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186305824} {:answer/id #uuid "780af782-aca2-5419-bedd-701e24dfc47d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186306292} {:answer/id #uuid "7d4a608d-489b-577f-9fea-2f902ca89bd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186306346} {:answer/id #uuid "95afdd7b-a302-5774-ab0c-02f71ebde6c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186306560}] :answer-field/correct {:answer/id #uuid "172aeb1b-7420-5210-b2d6-171da5624c7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186305364} :answer-field/id #uuid "3b0d5619-f3b5-53f6-92cf-ca0537f157fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307707}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f5244118-e12b-5ac2-ae1e-3e2ab9060947" :question/math-academy-id "q-333520" :question/problem "$$\n{y}^{″}+y=0\n$$\n\nConsider the differential equation above. Which of the following statements are true?\n\n- ${y}_{1}(x)=\\operatorname{sin}⁡(x)$ is a solution to the equation.\n- ${y}_{2}(x)=3\\operatorname{sin}⁡(x)$ is a solution to the equation.\n- The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation." :question/worked-solution "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation. \n\nLet's check each statement in turn.\n\n- Statement I is true. First, we find the first and second derivatives of ${y}_{1}(x):$\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & =\\operatorname{cos}⁡(x) \\\\ {y}_{1}^{″}(x) & =-\\operatorname{sin}⁡(x)\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}-\\operatorname{sin}⁡(x)+\\operatorname{sin}⁡(x) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{1}(x)$ is a solution to the equation.\n\n- Statement II is true. First, we find the first and second derivatives of ${y}_{2}(x):$\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & =3\\operatorname{cos}⁡(x) \\\\ {y}_{2}^{″}(x) & =-3\\operatorname{sin}⁡(x)\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}-3\\operatorname{sin}⁡(x)+3\\operatorname{sin}⁡(x) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{2}(x)$ is a solution to the equation.\n\n- Statement III is false. Both ${y}_{1}$ and ${y}_{2}$ are solutions of the equation. To check if these functions are linearly independent, we compute the Wronskian:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}\\operatorname{sin}⁡(x) & 3\\operatorname{sin}⁡(x) \\\\ \\operatorname{cos}⁡(x) & 3\\operatorname{cos}⁡(x)\\end{aligned}| \\\\  & =\\operatorname{sin}⁡(x)\\cdot 3\\operatorname{cos}⁡(x)-3\\operatorname{sin}⁡(x)\\cdot \\operatorname{cos}⁡(x) \\\\  & =3\\operatorname{sin}⁡(x)\\operatorname{cos}⁡(x)-3\\operatorname{sin}⁡(x)\\operatorname{cos}⁡(x) \\\\  & =0\\end{aligned}\n$$\n\nSince the  Wronskian equals $0$ for all $x\\in R,$ the functions are not linearly independent. Hence, ${y}_{1}(x)$ and ${y}_{2}(x)$ don't form a set of fundamental solutions to the equation.\n\nTherefore, the correct answer is \"I and II only\"."} {:db/id #edb/ref 17592186152570 :knowledge-point/_questions [{:db/id #edb/ref 17592186152280 :knowledge-point/id #uuid "e66005fe-df33-590a-9d9c-91947cd4a608" :knowledge-point/title "Identifying Fundamental Sets of Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "029fe9fd-de67-59f8-b2c3-40533894d6d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186305177} {:answer/id #uuid "a64cee93-cf6d-55db-9aa2-8bf847262948" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186306716} {:answer/id #uuid "e071c0d3-4510-581a-a69f-cf800820dcd2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186307228} {:answer/id #uuid "ec881d24-0b2d-5335-ad28-4a09e60170da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186307327} {:answer/id #uuid "f6fa4909-989b-5bc4-8df0-319e4d2b76e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186307443}] :answer-field/correct {:answer/id #uuid "f6fa4909-989b-5bc4-8df0-319e4d2b76e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186307443} :answer-field/id #uuid "6a22e9f2-f5ef-5bff-aabd-ea3eb11d889b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307863}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7e7ec306-a94e-573b-92ac-0141248c8937" :question/math-academy-id "q-333522" :question/problem "$$\n{y}^{″}+7{y}^{′}+6y=0\n$$\n\nConsider the differential equation above. Which of the following statements are true?\n\n- ${y}_{1}(x)={e}^{-x}$ is a solution to the equation.\n- ${y}_{2}(x)=1+{e}^{-x}$ is a solution to the equation.\n- The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation." :question/worked-solution "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation. \n\nLet's check each statement in turn.\n\n- Statement I is true. We find the first and second derivatives of ${y}_{1}(x):$\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & =-{e}^{-x} \\\\ {y}_{1}^{″}(x) & ={e}^{-x}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{e}^{-x}+7(-{e}^{-x})+6{e}^{-x} & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{1}(x)$ is a solution to the equation.\n\n- Statement II is false. We find the first and second derivatives of ${y}_{2}(x):$\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & =-{e}^{-x} \\\\ {y}_{2}^{″}(x) & ={e}^{-x}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{e}^{-x}+7(-{e}^{-x})+6(1+{e}^{-x}) & =0 \\\\ 6 & =0\\,\\times \\end{aligned}\n$$\n\nSo, ${y}_{2}(x)$ is not a solution to the equation.\n\n- Statement III is false. Since ${y}_{2}(x)$ is not a solution of the given differential equation, ${y}_{1}(x)$ and ${y}_{2}(x)$ don't form a set of fundamental solutions to the equation.\n\nTherefore, the correct answer is \"I only\"."} {:db/id #edb/ref 17592186152586 :knowledge-point/_questions [{:db/id #edb/ref 17592186152220 :knowledge-point/id #uuid "aee17e3a-031d-5c0e-9488-17410b3a2372" :knowledge-point/title "Identifying True Statements About Dimensions of Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "916a5a30-3e67-5958-a4dc-8827bee4d0f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186150024} {:answer/id #uuid "c7b998f9-8d81-57f7-93c2-5b6f3b230ea9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and II only" :db/id #edb/ref 17592186150025} {:answer/id #uuid "378b1c2c-a470-5e9b-9b2c-467f563e5a8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186150026} {:answer/id #uuid "551cbb3d-e22f-54eb-9969-2b2c3426009a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186150027} {:answer/id #uuid "628a91d4-daa5-5705-acb2-371c0a38968a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186150028}] :answer-field/id #uuid "d9c062b4-4b43-5787-a12d-90db4190b518" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186150023} {:answer-field/choices [{:answer/id #uuid "7cdb3388-d076-5c8c-b1d2-7ccebfaf628b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and II only" :db/id #edb/ref 17592186366001} {:answer/id #uuid "9e426d6c-ab0a-5e22-95a7-baccb7755f96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186366002} {:answer/id #uuid "6ac831b8-ff36-5e83-9f0e-d446ce03570b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186366003} {:answer/id #uuid "b8cfe4d4-efd2-5bc7-b16c-cceb08a4447d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186366004} {:answer/id #uuid "d2d729ce-f2bb-5c89-9bf3-b8f1d546010e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186366005}] :answer-field/correct {:answer/id #uuid "6ac831b8-ff36-5e83-9f0e-d446ce03570b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186366003} :answer-field/id #uuid "d8650ac1-6024-5d1c-9c58-f50299b6ed36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366000}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c3e2a498-b435-555d-acbe-67f3af373b5a" :question/math-academy-id "q-36477" :question/problem "Which of the following vector spaces has a dimension of $6?$\n\n- ${R}_{5}[t]$, the vector space of all polynomials in the variable $t$ of degree at most $5$\n- ${R}^{5}$\n- ${\\text{M}}_{6}(R),$ the vector space of all $6\\times 6$ matrices over $R$" :question/worked-solution "Let's examine each of the vector spaces in turn.\n\n- Recall that $\\text{dim}({R}_{n}[t])=n+1.$ Therefore, \n\n$$\n\\text{dim}({R}_{5}[t])=5+1=6.\\,✓\n$$\n- Recall that $\\text{dim}({R}^{n})=n.$ Therefore, \n\n$$\n\\text{dim}({R}^{5})=5\\ne 6.\\,\\times \n$$\n- Recall that $\\text{dim}({\\text{M}}_{n}(R))={n}^{2}.$ Therefore, \n\n$$\n\\text{dim}({\\text{M}}_{6}(R))={6}^{2}=36\\ne 6.\\,\\times \n$$\n\nHence, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186152632 :knowledge-point/_questions [{:db/id #edb/ref 17592186152276 :knowledge-point/id #uuid "2d0a7ede-b896-56c6-9b60-a6aec8eff9e8" :knowledge-point/title "Identifying Second-Order Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3521255b-407b-54eb-a57c-164260a8f206" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186333478} {:answer/id #uuid "6e5b34fe-9243-59a3-9611-0dbe9322444f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186333993} {:answer/id #uuid "89f65217-5f9a-5939-b0d4-117a48f1f377" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186334217} {:answer/id #uuid "c1a35414-4bd9-522a-ab31-2000a6548e35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186334668} {:answer/id #uuid "c4c5f375-c3d7-5d58-832f-bc79933f5066" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186334697}] :answer-field/correct {:answer/id #uuid "3521255b-407b-54eb-a57c-164260a8f206" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186333478} :answer-field/id #uuid "c5ab2d6f-d4ab-5a2e-9d24-d049fb773557" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335599}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2c0602e3-c50d-5991-b1fc-f704c082ddef" :question/math-academy-id "q-65014" :question/problem "Which of the following systems is an initial value problem?\n\n- $x{y}^{″}-2{y}^{′}+y={x}^{2}+\\operatorname{sin}⁡x,\\,y(1)=0,\\,{y}^{′}(1)=1$\n- ${x}^{2}{y}^{″}-x{y}^{′}+y=10$\n- ${x}^{2}{y}^{″}-4x{y}^{′}+16y=0,\\,y(0)=0,\\,{y}^{′}(2)=0$" :question/worked-solution "If a second-order differential equation for the function $y(x)$ is given with two conditions specified at the *same* location in the domain of $y,$ then this is an **initial value problem**.\n\nLet's go through each equation in turn.\n\n- The first system is an initial value problem. The differential equation is together with two conditions at the same location in the domain of $y(x)$ (i.e., at $x=1$).\n\n- The second system is not an initial value problem. It contains an equation only. No conditions are specified.\n\n- The third system is not an initial value problem. It consists of a differential equation together with two conditions at different points in the domain of $y(x)$ (i.e., at $x=0$ and $x=2$). This is a **boundary value problem.**"} {:db/id #edb/ref 17592186152634 :knowledge-point/_questions [{:db/id #edb/ref 17592186152192 :knowledge-point/id #uuid "42bc95a3-4e0c-5487-8427-31cee0ecf80b" :knowledge-point/title "Identifying Solutions of Linear ODEs Using the Sum Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1942582f-585d-52b0-9fce-e71f8174e3f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186333218} {:answer/id #uuid "393f2380-86b3-5549-92a0-b992c10194f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186333525} {:answer/id #uuid "83833eb9-69c8-5dc8-a1f3-e61577122c55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186334160} {:answer/id #uuid "ccab78c9-8514-586c-bf10-784d7f1b83d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186334773} {:answer/id #uuid "d8347606-9ee1-5fd2-ac51-ce35d133508b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186334882}] :answer-field/correct {:answer/id #uuid "ccab78c9-8514-586c-bf10-784d7f1b83d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186334773} :answer-field/id #uuid "2fe0414c-39f4-5e17-802b-bf3fa3a0152b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335334}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "03be4c64-335b-58c9-94d2-aea65ff76ae9" :question/math-academy-id "q-65077" :question/problem "Given that ${y}_{1}(x)={e}^{x}$ and ${y}_{2}(x)={e}^{2x}$ are solutions to the equation ${y}^{″}-3{y}^{′}+2y=0,$ then according to the superposition principle which of the following must also be a solution to the equation?\n\n- $y(x)={e}^{x}+{e}^{2x}$\n- $y(x)={e}^{x}\\cdot {e}^{2x}$\n- $y(x)=\\frac{{e}^{x}}{{e}^{2x}}$" :question/worked-solution "According to the superposition principle, if the functions ${y}_{1}(x)$ and ${y}_{2}(x)$ are solutions to a homogeneous, linear differential equation, then $y(x)={y}_{1}(x)+{y}_{2}(x)$ is also a solution to the equation.\n\nLet's consider each option:\n\n- The function $y(x)={e}^{x}+{e}^{2x}$ is a solution of the equation by the superposition principle.\n\n- The function $y(x)={e}^{x}\\cdot {e}^{2x}$ is **not** guaranteed to be a solution of the equation by the superposition principle. The superposition principle does not extend to the products of the known solutions.\n\n- The function $y(x)=\\frac{{e}^{x}}{{e}^{2x}}$ is **not** guaranteed to be a solution of the equation by the superposition principle. The superposition principle does not extend to the quotients of the known solutions.\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186152731 :knowledge-point/_questions [{:db/id #edb/ref 17592186152263 :knowledge-point/id #uuid "bfbebc20-1b48-5718-a057-b743c8af8de1" :knowledge-point/title "Identifying Bijections For Functions Defined on the Set of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f6639db-9aa8-5654-87ea-0b4daab2d03a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186150894} {:answer/id #uuid "d3735d8b-3cb3-5c5f-8307-02c69490fb08" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186150895} {:answer/id #uuid "dd79b7a8-6a0b-5758-8b53-73799de02c3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186150896} {:answer/id #uuid "4750df67-addb-5e69-a29e-bb1fb207c68b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186150897} {:answer/id #uuid "62ef3205-f783-59aa-bc6d-b1470d8394c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186150898}] :answer-field/id #uuid "57d3468b-e472-5b85-ac71-770a8d6c085a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186150893} {:answer-field/choices [{:answer/id #uuid "371046e5-f2a2-5985-ac73-f38e1329fb26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186385607} {:answer/id #uuid "3a8ca1df-e9dd-5912-984f-f96dfa29f7cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186385608} {:answer/id #uuid "36fa22c5-e4ae-5e77-ad57-5a479df9a8f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186385609} {:answer/id #uuid "5e7101e4-3e47-56a4-ad46-6658bbcbc631" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186385610} {:answer/id #uuid "4b68e157-9fd4-507e-97f4-f5d8ef17c6cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186385611}] :answer-field/correct {:answer/id #uuid "371046e5-f2a2-5985-ac73-f38e1329fb26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186385607} :answer-field/id #uuid "5a141b43-f8ca-5309-8224-ef9b7a357608" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385606}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ed18a3e4-6415-576f-b0e6-2282d7b910ac" :question/math-academy-id "q-76219" :question/problem "For the function $f:R\\to R$ defined by $f(x)={x}^{2},$ which of the following  statements are true? \n\n- The function is an injection\n- The function is a surjection\n- The function is a bijection" :question/worked-solution "Recall that a function $f:X\\to Y$ is \n\n- an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ whenever $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2},$\n\n- a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y,$\n\n- a bijection if it is both a surjection and an injection.\n\nWith this in mind, let's check each statement.\n\n- Statement I is false. For instance, $f(2)=4=f(-2)$, but $2\\ne -2.$ So, $f(x)$ is not an injection.\n\n- Statement II is false. For example, there is no $x\\in R$ such that $f(x)=-1.$ So, $f(x)$ is not a surjection.\n\n- Statement III is false because the function is not both an injection and a surjection.\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186152732 :knowledge-point/_questions [{:db/id #edb/ref 17592186152135 :knowledge-point/id #uuid "6fa67074-d3c8-5000-95a3-7f935936ab7d" :knowledge-point/title "Identifying Surjections For Functions Defined Algebraically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c460f347-b0f7-5612-a266-c07345184918" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186150900} {:answer/id #uuid "c83487fd-58af-56a9-bb80-4cc1d814156c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186150901} {:answer/id #uuid "4a710021-50fe-558b-8fb0-543a45c224ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186150902} {:answer/id #uuid "4fb8ef6c-b18e-594c-8a47-ddb36d92f11f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186150903} {:answer/id #uuid "7885c6b0-a91b-5558-85b8-b5d378eb7900" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186150904}] :answer-field/id #uuid "59d080c3-d125-541e-ade1-7b315cb4989e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186150899} {:answer-field/choices [{:answer/id #uuid "1b49a529-fc7a-5677-96ed-90f368302a7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I  and III only" :db/id #edb/ref 17592186382292} {:answer/id #uuid "f029e7d8-b519-5c54-b275-27694419d06c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I  and II only" :db/id #edb/ref 17592186382293} {:answer/id #uuid "6d45bd62-7dcd-5027-b021-8f44ede29800" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186382294} {:answer/id #uuid "a87bd1bf-54bb-5463-8068-2b7c39b6c9cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II  and III only" :db/id #edb/ref 17592186382295} {:answer/id #uuid "ece94773-6750-5f14-b0fb-5f1424d8bd4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186382296}] :answer-field/correct {:answer/id #uuid "6d45bd62-7dcd-5027-b021-8f44ede29800" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186382294} :answer-field/id #uuid "26255840-acbe-55db-b6c4-2bc5feb6b2a7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382291}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e0a2fe09-79e7-541d-8328-5d8abf9635ec" :question/math-academy-id "q-76236" :question/problem "Which of the following functions are surjections?\n\n- $f:R\\to (0,\\infty )$ defined by $f(x)={3}^{x}$\n- $g:Q\\to Q$ defined by $g(x)={x}^{2}$\n- $h:R\\to R$ defined by $h(x)={x}^{2}$" :question/worked-solution "A function $f:X\\to Y$ is a **surjection** (also known as **onto**) if, for *every* element $y$ in $Y,$ there is at least one element in $X$ that maps to $y.$ \n\nSymbolically, we can write:\n\n$f:X\\to Y$ is a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y.$\n\nWith this in mind, let's check each function.\n\n- I is a surjection. Given $y\\in (0,\\infty ),$ choose $x={log}_{3}⁡y\\in R.$ Then $f(x)=f({log}_{3}⁡y)={3}^{{log}_{3}⁡y}=y.$\n\n- II is *not* a surjection. As a counterexample, choose $2\\in Q.$ There is no number $x\\in Q$ such that $g(x)=2.$ The only number $x$ that satisfies $g(x)={x}^{2}=2$ is $x=\\sqrt{2}\\notin Q.$\n\n- III is *not* a surjection. As a counterexample, choose $-1\\in R.$ There is no number $x\\in R$ such that $h(x)={x}^{2}=-1.$  In fact, ${x}^{2}>0$ for all $x\\in R.$\n\nTherefore, the correct answer is \"I only\"."} {:db/id #edb/ref 17592186152736 :knowledge-point/_questions [{:db/id #edb/ref 17592186152265 :knowledge-point/id #uuid "f237343d-2f8a-5a9f-9e5f-c9f22784547a" :knowledge-point/title "Identifying Bijections For Functions Functions Defined Algebraically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2ef0d7d-db81-5041-8d66-b5d28863efca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186150924} {:answer/id #uuid "07efc968-f66f-5f76-993e-4399d7bc0df7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186150925} {:answer/id #uuid "2bdcac7f-aa69-5f37-a05e-aa1a387f809e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186150926} {:answer/id #uuid "6283bcce-18b8-56ff-b134-c7b9ee67ebc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186150927} {:answer/id #uuid "70941ed3-a770-5ac3-bebb-51b0f6d1efa3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186150928}] :answer-field/id #uuid "8bdc3c27-34bc-5762-b483-7a9c7613ad09" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186150923} {:answer-field/choices [{:answer/id #uuid "cf27b9b5-6f76-5f6f-9c9b-5a9cc802a78f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186385620} {:answer/id #uuid "e441a379-d79b-55dc-aced-c064ece2c4b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186385621} {:answer/id #uuid "d0cb090c-b834-52e8-8b20-be52ed47518a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186385622} {:answer/id #uuid "c62ebeda-0907-50be-a525-02d30793a0a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186385623} {:answer/id #uuid "47b1eae5-06e5-5fcf-99f0-8f6ca3dc9f49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186385624}] :answer-field/correct {:answer/id #uuid "d0cb090c-b834-52e8-8b20-be52ed47518a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186385622} :answer-field/id #uuid "36e3da7b-87ec-5072-846e-3d386080bae5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385619}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6f83b131-cba7-5925-800d-f4bed8f0ae07" :question/math-academy-id "q-76250" :question/problem "Which of the following functions are bijections?\n\n- $f:R\\to R$ defined by $f(x)=\\operatorname{cos}⁡x$\n- $g:Q\\to Q$ defined by $g(x)={x}^{2}-2$\n- $h:Q\\to Q$ defined by $h(x)=8x-3$" :question/worked-solution "Recall that a function $f:X\\to Y$ is a bijection if it is both a surjection and an injection.\n\n- I is *not* a bijection because it is not surjective. Remember that the range of $\\operatorname{cos}⁡x$ is $[-1,1].$ This means that \n\n$$\n-1\\le \\operatorname{cos}⁡x\\le 1.\n$$\n\nSo,  for example, there is no value $x\\in R$ such that $f(x)=2.$\n\n- II is *not* a bijection because it is not injective. Notice that $g$ has two roots, $x=\\pm \\sqrt{2}.$ So, we have $g(-\\sqrt{2})=0=g(\\sqrt{2}),$ while $-\\sqrt{2}\\ne \\sqrt{2}.$\n\n- III is a bijection. First of all, it is a surjection because $∀\\,y\\in Q,$ we can choose an $x\\in Q$ such that $h(x)=y:$\n\n$$\n\\begin{aligned}h(x) & =y \\\\ 8x-3 & =y \\\\ x & =\\frac{y+3}{8}\\in Q\\end{aligned}\n$$\n\nWe verify that, \n\n$$\nh(x)=h(\\frac{y+3}{8})=8(\\frac{y+3}{8})-3=y.\n$$\n\nSecond, it is an injection: \n\n$$\n\\begin{aligned}h({x}_{1}) & =h({x}_{2}) \\\\ 8{x}_{1}-3 & =8{x}_{2}-3 \\\\ {x}_{1} & ={x}_{2}\\end{aligned}\n$$\n\nBecause $h$ is both surjective and injective, $h$ is bijective.\n\nTherefore, the correct answer is \"III only\"."} {:db/id #edb/ref 17592186152737 :knowledge-point/_questions [{:db/id #edb/ref 17592186152264 :knowledge-point/id #uuid "f12e21e5-0a96-5f87-9642-d63d23e0038a" :knowledge-point/title "Identifying Bijections For Functions Whose Domains or Codomains Are Real Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c55b73a7-434a-561a-a9bf-2852a6f64c3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186150930} {:answer/id #uuid "d72387c9-c0a0-5572-b093-ffd4df7bb342" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186150931} {:answer/id #uuid "f5673a2b-d0a9-52b4-8cf0-cd33e664afa9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186150932} {:answer/id #uuid "480d13fe-31f3-5cbb-95b5-3605b031bce0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186150933} {:answer/id #uuid "72ff5ee8-efd3-5904-a501-dd267ed11e61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186150934}] :answer-field/id #uuid "54c70e09-90ae-57bb-8081-66a65b014026" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186150929} {:answer-field/choices [{:answer/id #uuid "7b1079b0-a2ee-5a33-a08f-89019a6bcfae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186385626} {:answer/id #uuid "9fc382e1-9e7a-50a9-94e4-01e5b3b63a7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186385627} {:answer/id #uuid "6bc7a3d0-690d-5e37-af1b-ae3e5cf7d308" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186385628} {:answer/id #uuid "44cc08ab-41ee-57de-93b2-67b55fc39e52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186385629} {:answer/id #uuid "b2d68728-4499-5621-af3f-f25e97ffcf34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186385630}] :answer-field/correct {:answer/id #uuid "b2d68728-4499-5621-af3f-f25e97ffcf34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186385630} :answer-field/id #uuid "3a2c4415-e3a1-5a78-a0c2-bf7cdc29ce71" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385625}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "16a1e15e-b250-589e-b4bc-6048810dc9dd" :question/math-academy-id "q-76259" :question/problem "![](images/06/06e3c48955dc8f907c87a93aeaa7c2a7240ea194fe1ca6a96b2a0bf566882264.png)\n\nFor the function $f:R\\to [0,\\infty )$ defined by $f(x)=0.25{x}^{2}$, which of the following statements are true? \n\n- The function is an injection\n- The function is a surjection\n- The function is a bijection" :question/worked-solution "Recall that a function $f:X\\to Y$ is \n\n- an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ whenever $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2},$\n\n- a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y,$\n\n- a bijection if it is both a surjection and an injection.\n\nWith this in mind, let's check each statement.\n\n- Statement I is false. There are horizontal lines (like the one depicted below) that cross the graph of $f(x)$ more than once. So, $∃\\,{x}_{1},{x}_{2}\\in R$ such that ${x}_{1}\\ne {x}_{2}$ but $f({x}_{1})=f({x}_{2}).$\n\n![](images/fc/fce55ada0375bff9bd3ea5852e80f707d70f145211b60e80b5a16b3049020000.png)\n\n          \n\n- Statement II is true. According to the graph, the range of $f(x)$ indeed covers the interval $[0,\\infty ).$\n\n- Statement III is false because the function is not an injection.\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186152747 :knowledge-point/_questions [{:db/id #edb/ref 17592186152074 :knowledge-point/id #uuid "2eebe007-8a95-578d-b553-e37a7bd8a327" :knowledge-point/title "Identifying Congruent Negative Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e6491d9-1d90-5386-995a-284889bdd49e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186409351} {:answer/id #uuid "2b860813-d4b1-5fef-b506-6ffcc8c555af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186409357} {:answer/id #uuid "2e4173a3-d315-5fb7-9f00-3bd771b4750f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186409359} {:answer/id #uuid "956c7dd0-6d81-5565-ae83-7839bf085246" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186409387} {:answer/id #uuid "b68067c2-b8d7-5f62-b933-7366f89a68bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186409400}] :answer-field/correct {:answer/id #uuid "956c7dd0-6d81-5565-ae83-7839bf085246" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186409387} :answer-field/id #uuid "5b7ce273-1469-5ebe-853b-6ac76cc6e24b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186409421}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bc725849-ec72-5565-a2a3-c18e7bade536" :question/math-academy-id "q-76784" :question/problem "Which of the following statements are true?\n\n- $11≡1\\,(\\text{mod}\\,5)$\n- $27≡15\\,(\\text{mod}\\,7)$\n- $30≡-18\\,(\\text{mod}\\,4)$" :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWith that in mind, let's analyze each statement in turn.\n\n- Statement I is true because $5∣(11-1).$ There is no remainder:\n\n$$\n(11-1)÷5=10÷5=2\n$$\n\n- Statement II is false because $7∤(27-15).$ Notice that $27-15=12,$ which is not divisible by $7.$\n\n- Statement III is true because $4\\,|\\,(30-(-18)).$ There is no remainder:\n\n$$\n(30-(-18))÷4=48÷4=12\n$$\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186152754 :knowledge-point/_questions [{:db/id #edb/ref 17592186152257 :knowledge-point/id #uuid "dacfbca6-6135-5d51-a07e-627fce79dfd1" :knowledge-point/title "Identifying Equivalence Classes Containing a Given Element"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ceda99fe-9a89-538b-92fe-b9c3561af0c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186151032} {:answer/id #uuid "d631c338-a791-53b2-91c3-3159ad3deab9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186151033} {:answer/id #uuid "2c2719e4-e6df-5dc9-8684-b89dfbd92824" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186151034} {:answer/id #uuid "47f6ca37-dd85-59da-bfe2-4f7a859f36ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186151035} {:answer/id #uuid "6979a5a8-b5a8-55b8-9ed4-6ea49cd616c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186151036}] :answer-field/id #uuid "28538709-e3ec-5163-8146-0112145cee55" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186151031}] :question/id #uuid "57bb64c1-83a8-5ad6-a9bc-3ab2aa9fabbd" :question/math-academy-id "q-76893" :question/problem "Consider the equivalence relation $∼$ on $C$, defined by $x∼y$ if $x^{4} = y^{4}$. Which of the following equivalence classes contain the element $\\textrm{i}$?\n\n1. $[- 1]$\n2. $[- \\textrm{i}]$\n3. $[2\\textrm{i}]$"} {:db/id #edb/ref 17592186152758 :knowledge-point/_questions [{:db/id #edb/ref 17592186152073 :knowledge-point/id #uuid "398716c2-d0e6-5106-a702-2f71d957726f" :knowledge-point/title "Identifying Congruent Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02e87fd7-263e-5c85-ae11-ab373b3633a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186409342} {:answer/id #uuid "05752e2f-49d8-5029-8640-38d4fb2c4302" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186409344} {:answer/id #uuid "79a9d6c6-5a61-5865-93e5-90b3c4aec498" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186409379} {:answer/id #uuid "d45d7b30-c602-5bbb-b327-69ce48a4fb37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186409408} {:answer/id #uuid "e8143651-dbed-5f90-b38d-d9e1c91175c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186409414}] :answer-field/correct {:answer/id #uuid "02e87fd7-263e-5c85-ae11-ab373b3633a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186409342} :answer-field/id #uuid "d27defb4-bb86-5b12-8d1d-2f258f68bd34" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186409431}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "665aa776-ec33-596f-ae58-1e8a076473e5" :question/math-academy-id "q-76952" :question/problem "Which of the following statements are true?\n\n- $19≡5\\,(\\text{mod}\\,4)$\n- $22≡7\\,(\\text{mod}\\,3)$\n- $20≡9\\,(\\text{mod}\\,8)$" :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWith that in mind, let's analyze each statement in turn.\n\n- Statement I is false because $4∤(19-5).$ Notice that $19-5=14,$ which is not divisible by $4.$\n\n- Statement II is true because $3∣(22-7).$ There is no remainder:\n\n$$\n(22-7)÷3=15÷3=5\n$$\n\n- Statement III is false because $8∤(20-9).$ Notice that $20-5=15,$ which is not divisible by $4.$\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186152767 :knowledge-point/_questions [{:db/id #edb/ref 17592186152135 :knowledge-point/id #uuid "6fa67074-d3c8-5000-95a3-7f935936ab7d" :knowledge-point/title "Identifying Surjections For Functions Defined Algebraically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ced8d90-d801-5036-8898-0877827d2cde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186151110} {:answer/id #uuid "a1ed6f47-af35-5204-a5f1-b54a8e127b6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186151111} {:answer/id #uuid "a3f74c7d-fe6a-52c6-b58d-b8b50d557668" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186151112} {:answer/id #uuid "ccd81a82-8eff-52a0-8205-c5b8f70f0e65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186151113} {:answer/id #uuid "6a58dc65-f646-5652-8a23-2dbe3e457932" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186151114}] :answer-field/id #uuid "111a9bf8-1981-5af8-bae9-2a21fc482ad7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186151109} {:answer-field/choices [{:answer/id #uuid "4a881f7f-2aac-56cf-b1e8-aaedca1189bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186382298} {:answer/id #uuid "4f982ebf-cff3-5505-8a98-581cac40b008" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186382299} {:answer/id #uuid "778461b2-98fd-56db-b0f8-ab5dca8c4723" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186382300} {:answer/id #uuid "f91c2f6b-86bf-5f7d-8dff-c8efc483f589" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186382301} {:answer/id #uuid "f38fb309-7eb7-55d6-a920-f933e6d3abfe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186382302}] :answer-field/correct {:answer/id #uuid "f91c2f6b-86bf-5f7d-8dff-c8efc483f589" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186382301} :answer-field/id #uuid "9b4fcb32-650f-532a-93a9-8335d685209a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382297}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b4cd6be0-845e-5684-aa03-e5a2472b9ab4" :question/math-academy-id "q-77378" :question/problem "Which of the following functions are surjections?\n\n- $f:{0,1,2}\\to {1,3,9,27}$ defined by $f(x)={3}^{x}$\n- $g:[0,\\infty )\\to R$ defined by $g(x)={x}^{3}$\n- $h:{0,1,2}\\to {-1,1,3}$ defined by $h(x)=2x-1$" :question/worked-solution "A function $f:X\\to Y$ is a **surjection** (also known as **onto**) if, for *every* element $y$ in $Y,$ there is at least one element in $X$ that maps to $y.$ \n\nSymbolically, we can write:\n\n$f:X\\to Y$ is a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y.$\n\nWith this in mind, let's check each function.\n\n- I is *not* a surjection. As a counterexample, choose $27$ from the range. The only number $x$ that satisfies $f(x)={3}^{x}=27$ is $x=3,$ but $3\\notin {0,1,2}.$\n\n- II is *not* a surjection. As a counterexample, choose $-1\\in R.$ There is no number $x\\in [0,\\infty )$ such that $g(x)=-1.$ The only number $x$ that satisfies $g(x)={x}^{3}=-1$ is $x=-1,$ but $-1\\notin [0,\\infty ).$\n\n- III is a surjection. Indeed, $h(0)=-1,$ $h(1)=1$ and $h(2)=3.$ So, for every $y\\in {-1,1,3},$ there exists an element $x\\in {0,1,2}$ such that $h(x)=y.$\n\nTherefore, the correct answer is \"III only\"."} {:db/id #edb/ref 17592186152792 :knowledge-point/_questions [{:db/id #edb/ref 17592186152097 :knowledge-point/id #uuid "3d2f207a-8e99-5520-ab9f-266c8f54465b" :knowledge-point/title "Identifying Elements Belonging to a Residue Class"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1033dd79-9600-51c4-a8ca-3a31c3dde48f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186412816} {:answer/id #uuid "6ef83927-2628-5d68-bf65-a48c1fe20d5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186412856} {:answer/id #uuid "8508cb49-93b9-537a-b130-be5b95ed2386" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186412870} {:answer/id #uuid "88959a9d-340f-5ee1-b746-8a0de81e8b1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186412873} {:answer/id #uuid "c35aa81f-3a6b-57fc-9666-5deb89ff8dcc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186412900}] :answer-field/correct {:answer/id #uuid "8508cb49-93b9-537a-b130-be5b95ed2386" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186412870} :answer-field/id #uuid "cce84edd-038c-58d1-9051-41a39c1a5bad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186412948}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ba3bb1ff-f2f2-5531-a68f-b27801ed7066" :question/math-academy-id "q-78598" :question/problem "Which of the following integers belong to the residue class $[6]_{9}?$\n\nI. $-12$\n\nII. $3$\n\nIII. $24$" :question/worked-solution "The residue class $[6]_{9}$ consists of the elements that are congruent to $6$ modulo $9.$ So, we have\n\n$$\n\\begin{aligned}[6]_{9} & ={x\\in Z\\,|\\,x≡6\\,(\\text{mod}\\,9)} \\\\  & ={x\\in Z\\,|\\,x=6+9k,\\,k\\in Z} \\\\  & ={6+9k\\,|\\,k\\in Z} \\\\  & ={…,\\,6-2\\cdot 9,\\,6-9,\\,6,\\,6+9,\\,6+2\\cdot 9,\\,…} \\\\  & ={…,-12,-3,6,15,24,…}.\\end{aligned}\n$$\n\nWe see that $-12$ and $24$ belong to $[6]_{9},$ while $3$ does not.\n\nTherefore, the correct answer is \"I and III only\"."} {:db/id #edb/ref 17592186152809 :knowledge-point/_questions [{:db/id #edb/ref 17592186152192 :knowledge-point/id #uuid "42bc95a3-4e0c-5487-8427-31cee0ecf80b" :knowledge-point/title "Identifying Solutions of Linear ODEs Using the Sum Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08a5020b-2483-54b3-9875-fbe76e877be2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186345420} {:answer/id #uuid "61e73b76-0d50-5bd9-8914-289d4d5ec07f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186346204} {:answer/id #uuid "76ec8bce-63fa-5a40-8e4b-8062ee9e6abe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186346393} {:answer/id #uuid "b0413cd6-d395-5514-979c-19081089b382" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186346891} {:answer/id #uuid "ea1ae063-9d09-51b7-856c-b2ccf0a32908" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186347418}] :answer-field/correct {:answer/id #uuid "61e73b76-0d50-5bd9-8914-289d4d5ec07f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186346204} :answer-field/id #uuid "6cd824af-742b-56bf-bd8a-78bab537a35e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347799}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "46b25723-729d-510e-b94e-77440edfe286" :question/math-academy-id "q-79724" :question/problem "Given that ${y}_{1}(x)=\\operatorname{sin}⁡x$ and ${y}_{2}(x)=\\operatorname{cos}⁡x$ are solutions to a homogeneous, linear, second-order ODE, then according to the superposition principle which of the following must also be a solution to the equation?\n\n- $y(x)=(\\operatorname{sin}⁡x\\operatorname{cos}⁡x)^{2}$\n- $y(x)=x\\operatorname{sin}⁡x\\operatorname{cos}⁡x$\n- $y(x)=\\operatorname{sin}⁡x+\\operatorname{cos}⁡x$" :question/worked-solution "According to the superposition principle, if the functions ${y}_{1}(x)$ and ${y}_{2}(x)$ are solutions to a homogeneous, linear differential equation, then $y(x)={y}_{1}(x)+{y}_{2}(x)$ is also a solution to the equation.\n\nLet's consider each option:\n\n- The function $y(x)=(\\operatorname{sin}⁡x\\operatorname{cos}⁡x)^{2}$ is **not** guaranteed to be a solution of the equation by the superposition principle. The superposition principle does not extend to the product of the known solutions.\n\n- The function $y(x)=x\\operatorname{sin}⁡x\\operatorname{cos}⁡x$ is **not** guaranteed to be a solution of the equation by the superposition principle. The superposition principle does not extend to the product of a function and the known solutions.\n\n- The function $y(x)=\\operatorname{sin}⁡x+\\operatorname{cos}⁡x$ is a solution of the equation by the superposition principle.\n\nTherefore, the correct answer is \"III only.\""} {:db/id #edb/ref 17592186152811 :knowledge-point/_questions [{:db/id #edb/ref 17592186152193 :knowledge-point/id #uuid "b0829d4a-239a-5a8e-9c8e-3cdc76a993bc" :knowledge-point/title "Identifying Solutions of Linear ODEs Using the Constant Multiple Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a101e65-363a-5400-96fd-b6c08eb72ac1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186345984} {:answer/id #uuid "4ec36277-46b7-58fd-bc02-eeb91549d07a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186346025} {:answer/id #uuid "744cd21b-ce7e-5e10-9aa7-0ed91150d834" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186346377} {:answer/id #uuid "77182ecb-d0c1-5983-a4fc-9fe4011a02d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186346395} {:answer/id #uuid "d033a425-a12c-5dbb-911e-13d72342883e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186347175}] :answer-field/correct {:answer/id #uuid "d033a425-a12c-5dbb-911e-13d72342883e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186347175} :answer-field/id #uuid "81d52045-9bcf-5001-b543-b72ff11ab58e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347835}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f6e0c318-7db3-5a86-afe7-c1d5265937a0" :question/math-academy-id "q-79730" :question/problem "Given that ${y}_{1}(x)=\\operatorname{sin}⁡(2x)$ is a solution to a homogeneous, linear, second-order ODE, then according to the superposition principle which of the following must also be a solution to the equation?\n\n- $y(x)={sin}^{2}⁡(2x)$\n- $y(x)=-\\operatorname{sin}⁡(2x)$\n- $y(x)={x}^{2}\\operatorname{sin}⁡(2x)$" :question/worked-solution "According to the superposition principle, if the function ${y}_{1}(x)$ is a solution to a homogeneous, linear differential equation, and $c$ is a constant, then $y(x)=c{y}_{1}(x)$ is also a solution to the equation.\n\nLet's consider each option:\n\n- The function $y(x)={sin}^{2}⁡(2x)$ is **not** guaranteed to be a solution of the equation by the superposition principle. The superposition principle does not extend to the product of known solutions.\n\n- The function $y(x)=-\\operatorname{sin}⁡(2x)$ is a solution of the equation by the superposition principle. In this case, $c=-1.$\n\n- The function $y(x)={x}^{2}\\operatorname{sin}⁡(2x)$ is **not** guaranteed to be a solution of the equation by the superposition principle. The superposition principle does not extend to the product of a non-constant function and a known solution.\n\nTherefore, the correct answer is \"II only.\""}]
