ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186239366} {:answer/id #uuid "adf67485-98f6-5532-b74e-ad997abb4115" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186239564} {:answer/id #uuid "b8f0ae0b-0e27-5e62-ba20-05fe58021513" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186239664} {:answer/id #uuid "ce1ddd11-773f-5bba-9c4f-50345066fd1f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186239859} {:answer/id #uuid "edb1bc67-aa4a-5b31-9afb-59791c7d655e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186240149}] :answer-field/correct {:answer/id #uuid "edb1bc67-aa4a-5b31-9afb-59791c7d655e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186240149} :answer-field/id #uuid "2b0cf691-b10b-512c-8716-cad8675c07cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240407}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "340a8e11-ca0d-5e08-ab08-b9647c00e4dc" :question/math-academy-id "q-104049" :question/problem "![](images/51/5143df65d0f99c6511dc8ab13262831669c88535e19c986dacdb364e04847f58.png)\n\nWhich of the following statements are true with respect to the function $y=f(x)$ whose graph is plotted above. \n\n- $f(x)$ is defined at $x=2$\n- ${lim}_{x\\to \\,2}f(x)\\ne f(2)$\n- $f(x)$ has a discontinuity at $x=2$" :question/worked-solution "By inspecting the graph, we can conclude the following:\n\n- Statement I is true. We have $f(2)=2.$\n\n- Statement II is false. Indeed, from the graph we see that\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,{2}^{-}}f(x) & =2, \\\\ {lim}_{x\\to \\,{2}^{+}}f(x) & =2.\\end{aligned}\n$$\n\nHence, ${lim}_{x\\to \\,2}f(x)=2=f(2).$\n\n- Statement III is false. The graph of the function doesn't have a break at $x=2$ and we can draw the graph of $f(x)$ around $x=2$ without taking our pencil off of the paper."} {:db/id #edb/ref 17592186240787 :knowledge-point/_questions [{:db/id #edb/ref 17592186068697 :knowledge-point/id #uuid "3f92e521-e7ab-56ba-8eac-0484b140b1a2" :knowledge-point/title "Determining the Behavior of a Function in the Neighborhood of a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e8bd6dd-1931-5df3-803b-dc0e5167142e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186238463} {:answer/id #uuid "4d8ed7c5-b2af-580b-8113-c798acb35065" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186238721} {:answer/id #uuid "92b58f29-e9d2-52ea-80a1-a85417e0693d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186239321} {:answer/id #uuid "d6b9cbc0-4187-50a5-81fd-c6539f6fe9ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186239932} {:answer/id #uuid "f9aeed86-3876-53b5-b2e9-7b048f60598b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186240264}] :answer-field/correct {:answer/id #uuid "f9aeed86-3876-53b5-b2e9-7b048f60598b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186240264} :answer-field/id #uuid "42c90896-bfe8-504a-9692-0915b93a4eb6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240445}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fc9393f2-809c-5769-b329-186102da51c9" :question/math-academy-id "q-104051" :question/problem "![](images/65/65b9b32e8fac6a71141ce820855058367e9235129de7334db35a200905474cc0.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following statements are true? \n\nI. $f(x)$ is defined at $x=5$\n\nII. ${lim}_{x\\to \\,5}f(x)$ exists\n\nIII. $f(x)$ has a discontinuity at $x=5$" :question/worked-solution "By inspecting the graph, we can conclude the following:\n\n- Statement I is true. Indeed, $f(5)=2.$\n\n- Statement II is false. Indeed, from the graph we see that\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,{5}^{-}}f(x) & =2, \\\\ {lim}_{x\\to \\,{5}^{+}}f(x) & =4.\\end{aligned}\n$$\n\nHence,  ${lim}_{x\\to \\,5}f(x)$ doesn't exist\n\n- Statement III is true. The graph of the function has a jump exactly at $x=5$\nand it's impossible to draw the graph without taking our pencil off of the paper."} {:db/id #edb/ref 17592186240788 :knowledge-point/_questions [{:db/id #edb/ref 17592186068697 :knowledge-point/id #uuid "3f92e521-e7ab-56ba-8eac-0484b140b1a2" :knowledge-point/title "Determining the Behavior of a Function in the Neighborhood of a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "013b8848-3885-5ddc-abba-c6d98f5249e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186238091} {:answer/id #uuid "60b0fbff-7602-5867-b0a7-49ff7cf237ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186238904} {:answer/id #uuid "ac75e25e-87f7-560b-989e-a0db688ca52b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186239554} {:answer/id #uuid "c1fdba29-79ec-5716-8a2d-1c3ed48f88b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186239755} {:answer/id #uuid "ebb22f50-3d68-5e9a-9196-af09faba8f5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186240130}] :answer-field/correct {:answer/id #uuid "60b0fbff-7602-5867-b0a7-49ff7cf237ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186238904} :answer-field/id #uuid "b9e6d376-017a-5f97-89b1-398a2e796dd0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240658}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3312f9fe-c2a1-5d75-b752-6c981a0a3f4b" :question/math-academy-id "q-104052" :question/problem "![](images/80/8086893e4587e68f8257b75f2070cf622fa141199d6bd8960f7c4fd8e7bcb349.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following statements are true? \n\n- $f(x)$ is **not** defined at $x=0$\n- ${lim}_{x\\to \\,0}f(x)$ exists\n- $f(x)$ is continuous at $x=0$" :question/worked-solution "By inspecting the graph, we can conclude the following:\n\n- Statement I is true. From the graph we can see that no value has been assigned to $f(x)$ at $x=0.$\n\n- Statement II is true. Indeed, \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,{0}^{-}}f(x) & =3, \\\\ {lim}_{x\\to \\,{0}^{+}}f(x) & =3.\\end{aligned}\n$$\n\nHence, \n${lim}_{x\\to \\,0}f(x)=3.$\n\n- Statement III is false. The function is not even defined at $x=0.$ The graph contains a break at $x=0.$ It's impossible to draw the graph of $f(x)$ without taking our pencil off of the paper."} {:db/id #edb/ref 17592186240800 :knowledge-point/_questions [{:db/id #edb/ref 17592186068697 :knowledge-point/id #uuid "3f92e521-e7ab-56ba-8eac-0484b140b1a2" :knowledge-point/title "Determining the Behavior of a Function in the Neighborhood of a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d0261a4-d877-5906-ad0b-830747a5cc4f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186239135} {:answer/id #uuid "8ad4d9e3-4681-5c2a-91a3-0ffe435a5b1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186239261} {:answer/id #uuid "b164497e-772a-5260-941e-feac495b0767" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186239604} {:answer/id #uuid "bb707977-2299-58a7-be64-009156d71aed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186239688} {:answer/id #uuid "e7c3ed1b-b297-5c48-93a5-4e4568f8c09c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186240094}] :answer-field/correct {:answer/id #uuid "bb707977-2299-58a7-be64-009156d71aed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186239688} :answer-field/id #uuid "b0db112b-2842-5c5e-b64c-f115b941ce9f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240639}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ad98348d-cbe6-535a-9828-f9008c2ec2e3" :question/math-academy-id "q-104124" :question/problem "![](images/bd/bdcfa35fb04028cbff32992b41214c878443d3815b676a0cf046f5a99bd771bd.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following statements are true? \n\n- $f(x)$ is **not** defined at $x=-2$\n- ${lim}_{x\\to \\,-2}f(x)=f(-2)$\n- $f(x)$ is continuous at $x=-2$" :question/worked-solution "By inspecting the graph, we can conclude the following:\n\n- Statement I is false. Indeed, $f(x)$ is defined at $x=-2$ and $f(-2)=5.$\n\n- Statement II is true. Indeed, from the graph we see that\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,-{2}^{-}}f(x) & =5, \\\\ {lim}_{x\\to \\,-{2}^{+}}f(x) & =5.\\end{aligned}\n$$\n\nHence, ${lim}_{x\\to \\,-2}f(x)=5=f(-2).$\n\n- Statement III is true. The graph of $f(x)$ can be drawn without taking our pencil off of the paper in the neighborhood of $x=-2.$"} {:db/id #edb/ref 17592186240855 :knowledge-point/_questions [{:db/id #edb/ref 17592186068700 :knowledge-point/id #uuid "81247553-750f-5bf7-a1c4-698ad63b5ae4" :knowledge-point/title "Identifying True Statements Regarding Left- and Right-Continuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17d03821-e8cc-52f3-93ab-ad3c305cc8a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186238258} {:answer/id #uuid "75f31ce3-8a84-5578-bc64-4329a88af693" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186239074} {:answer/id #uuid "781e360e-d1b8-5389-ae6e-0343b5376d80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186239095} {:answer/id #uuid "edac4ef1-a0ae-5e43-a915-14ff95b9c4af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186240147} {:answer/id #uuid "f5651e57-e1d9-5d3f-845c-4c24a55d8e53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186240221}] :answer-field/correct {:answer/id #uuid "75f31ce3-8a84-5578-bc64-4329a88af693" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186239074} :answer-field/id #uuid "c66e2d1e-413e-5c63-b78c-4afc8c4f0b4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240678}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d00cc33e-d21d-57ae-828a-16fa83891b51" :question/math-academy-id "q-104357" :question/problem "![](images/30/30df82b4c47905fd8277067f9207a5e970a96d8ec386879d2872b5f5c3d8dd3c.png)\n\nWhich of the following statements are true regarding the function $y=f(x)$ plotted above?\n\n- The function is left-continuous at $x=-1$\n- The function is right-continuous at $x=-1$\n- The function is continuous at $x=-1$" :question/worked-solution "Let's look at each statement in turn:\n\n- Statement I is false. The function is not left-continuous at $x=-1,$ since the left-sided limit is not equal to the function value:\n\n$$\n{lim}_{x\\to (-1)^{-}}f(x)=1\\ne 0=f(-1)\n$$\n\n- Statement II is false. The function is not right-continuous at $x=-1,$ since the right-sided limit is not equal to the function value:\n\n$$\n{lim}_{x\\to (-1)^{+}}f(x)=-1\\ne 0=f(-1)\n$$\n\n- Statement III is false. In order for the function to be continuous at $x=-1,$ it must be both left-continuous and right-continuous. However, we have already determined that the function is neither left-continuous nor right-continuous at this point.\n\nIn conclusion, none of the statements are true."} {:db/id #edb/ref 17592186240856 :knowledge-point/_questions [{:db/id #edb/ref 17592186068700 :knowledge-point/id #uuid "81247553-750f-5bf7-a1c4-698ad63b5ae4" :knowledge-point/title "Identifying True Statements Regarding Left- and Right-Continuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0231ad89-5342-57ca-9d53-32d772e1889f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186238098} {:answer/id #uuid "467d4ffe-4683-59b2-977b-d353f6b4bb5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186238669} {:answer/id #uuid "60607ebd-2ad4-55af-a90b-4623005e6e6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186238899} {:answer/id #uuid "a402837d-0060-5017-9153-e0d361735054" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186239479} {:answer/id #uuid "fa979380-dfc8-5f1d-b3eb-5f41cc72f76e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186240270}] :answer-field/correct {:answer/id #uuid "60607ebd-2ad4-55af-a90b-4623005e6e6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186238899} :answer-field/id #uuid "66ae6d06-50b2-5267-8241-314cfb5773ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240519}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fc756662-eff5-518b-9ac2-39ac467a0419" :question/math-academy-id "q-104358" :question/problem "![](images/7c/7c95fb061d6b860655e934f2691d03e53f7bb77a617200f523f1695ee49083fe.png)\n\nWhich of the following statements are true regarding the function $y=f(x)$ plotted above?\n\n- The function is left-continuous at $x=1$\n- The function is right-continuous at $x=1$\n- The function is continuous at $x=1$" :question/worked-solution "Let's look at each statement in turn:\n\n- Statement I is true. The function is left-continuous at $x=1,$ since the left-sided limit is equal to the function value:\n\n$$\n{lim}_{x\\to {1}^{-}}f(x)=4=f(1)\n$$\n\n- Statement II is false.  The function is not right-continuous at $x=1,$ since the right-sided limit is not equal to the function value:\n\n$$\n{lim}_{x\\to {1}^{+}}f(x)=2\\ne 4=f(1)\n$$\n\n- Statement III is false. In order for the function to be continuous at $x=1,$ it must be both left-continuous and right-continuous. However, we have already determined that the function is not right-continuous at this point.\n\nIn conclusion, only statement  I is true."} {:db/id #edb/ref 17592186240863 :knowledge-point/_questions [{:db/id #edb/ref 17592186184224 :knowledge-point/id #uuid "25229703-4cfb-5010-ae5c-f6a54503ced3" :knowledge-point/title "Verifying Continuity of Three-Piece Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18317632-9a46-5b18-bafd-820209526524" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186238261} {:answer/id #uuid "2b206fef-99a4-534a-b2b0-b6ae959fef99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186238436} {:answer/id #uuid "6e34f467-9d96-5d96-adbd-58a85537abb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186239005} {:answer/id #uuid "74c42b8b-18d3-5fba-a1e7-4a175cd7070f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186239062} {:answer/id #uuid "75d8569c-8b78-5fc7-977e-d7799bd0a0bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186239073}] :answer-field/correct {:answer/id #uuid "75d8569c-8b78-5fc7-977e-d7799bd0a0bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186239073} :answer-field/id #uuid "21361fe3-3c71-57a8-ba47-cf7a876c9edd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240388}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "23c6c497-7b53-5892-b312-12905adbf824" :question/math-academy-id "q-104384" :question/problem "Which of the following statements are true regarding the function $f(x),$ defined below?\n\n$$\nf(x)={\\begin{aligned}{x}^{3},\\,\\, & x<2 \\\\ 8,\\,\\, & x=2 \\\\ 2{x}^{2},\\, & x>2\\end{aligned}\n$$\n\n- $f(x)$ is left-continuous at $x=2$\n- $f(x)$ is right-continuous at $x=2$\n- $f(x)$ is continuous at $x=2$" :question/worked-solution "We're required to determine the left and right continuity properties of $f(x)$ at $x=2.$\n\nFirst, we note that \n\n$$\n\\begin{aligned}f(2) & =8.\\end{aligned}\n$$\n\nNow, let's look at each statement in turn:\n\n- Statement I is true. The function is left-continuous at $x=2$ since the left-sided limit is equal to the function value:\n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{-}}f(x) & ={2}^{3} \\\\  & =8 \\\\  & =f(2)\\end{aligned}\n$$\n\n- Statement II is true. The function is right-continuous at $x=2$ since the right-sided limit is equal to the function value:\n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{+}}f(x) & =2(2)^{2} \\\\  & =8 \\\\  & =f(2)\\end{aligned}\n$$\n\n- Statement III is true. The function is both left and right-continuous at $x=2,$ which implies that the function is continuous at $x=2.$\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186240897 :knowledge-point/_questions [{:db/id #edb/ref 17592186129086 :knowledge-point/id #uuid "9110c50a-62db-5447-b4d0-60819c80eb31" :knowledge-point/title "Identifying Properties Related to Point Discontinuities Given a Function Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c362354-b121-53da-b1d0-32db9976b524" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186238164} {:answer/id #uuid "8d031b0b-6f60-5c10-a903-198316653435" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186239280} {:answer/id #uuid "a1745f6f-463b-5bbd-8815-814b9176348f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186239460} {:answer/id #uuid "c6da6cc7-debd-54ae-a437-073b08d05ea7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186239806} {:answer/id #uuid "e002f9b5-f859-53ed-bd2b-7e968ac2c54e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186240014}] :answer-field/correct {:answer/id #uuid "0c362354-b121-53da-b1d0-32db9976b524" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186238164} :answer-field/id #uuid "2228e72c-dac2-5e7f-aab5-a7eee153aa98" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240390}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8b8ec7f0-866e-5db4-b2de-0c9d1fe0bd7c" :question/math-academy-id "q-104572" :question/problem "Given that \n\n$$\n\\begin{aligned}f(x) & ={\\begin{aligned}\\sqrt{x+11}, & x<5 \\\\ 12, & x=5 \\\\ {e}^{5/x}, & x>5\\end{aligned}\\end{aligned}\n$$\n\nwhich of the following statements is true?\n\n- $f(5)$ exists\n- ${lim}_{x\\to {5}^{+}}f(x)={lim}_{x\\to {5}^{-}}f(x)$\n- $f(x)$ has a removable discontinuity at $x=5$" :question/worked-solution "Let's check our continuity conditions:\n\n- $f(5)=12$ exists $\\,\\,✓$\n\nTherefore, statement I is true.\n\n- The left and right-sided limits are\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,{5}^{-}}f(x) & ={lim}_{x\\to \\,{5}^{-}}\\sqrt{x+11}=4, \\\\ {lim}_{x\\to \\,{5}^{+}}f(x) & ={lim}_{x\\to \\,{5}^{+}}{e}^{5/x}=e\\end{aligned}\n$$\n\nWe conclude that statement II is false and\n\n$$\n{lim}_{x\\to {5}^{+}}f(x)\\ne {lim}_{x\\to {5}^{-}}f(x).\\,\\,\\times \n$$\n\nSince the second condition failed, $x=5$ is not a removable discontinuity. So, statement III is false.\n\nIn conclusion, only statement I is true."} {:db/id #edb/ref 17592186240898 :knowledge-point/_questions [{:db/id #edb/ref 17592186166863 :knowledge-point/id #uuid "65adbd80-9647-59d8-bd4a-42f431587c85" :knowledge-point/title "Identifying Conservative Vector Fields"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58f11833-470e-5bef-bed8-6e5dd7f35fe9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186238821} {:answer/id #uuid "73bfaf49-d235-5587-b751-402d142ac763" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186239046} {:answer/id #uuid "a836c130-129a-569d-9e28-b1933339a9c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186239516} {:answer/id #uuid "b09885ad-d9c7-552d-b4c7-930d5c59c1e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186239589} {:answer/id #uuid "fb3240e0-b339-53b6-a701-9e9f4809ca9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186240276}] :answer-field/correct {:answer/id #uuid "b09885ad-d9c7-552d-b4c7-930d5c59c1e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186239589} :answer-field/id #uuid "4fa88a49-b814-5ee5-80f8-03e880fa2400" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240472}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7ff94cca-f0c0-5b4f-9e96-5ccdc57e1837" :question/math-academy-id "q-104573" :question/problem "Which of the following vector fields are conservative on ${R}^{2}?$\n\n- $F=(2x-y)\\,i-x\\,j$\n- $G=y\\operatorname{cos}⁡(xy)\\,i+x\\operatorname{cos}⁡(xy)\\,j$\n- $H={e}^{x-y}\\,i-{e}^{x-y}\\,j$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D={R}^{2}.$ With this in mind, let's check each of the vector fields. \n\n- For the vector field $F,$ we have $P=2x-y$ and $Q=-x.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=-1,\\,\\frac{∂Q}{∂x}=-1.\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $F$ is conservative on ${R}^{2}.$\n\n- For the vector field $G,$ we have $P=y\\operatorname{cos}⁡(xy)$ and $Q=x\\operatorname{cos}⁡(xy).$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy),\\,\\frac{∂Q}{∂x}=\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy).\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $G$ is conservative on ${R}^{2}.$\n\n- For the vector field $H,$ we have $P={e}^{x-y}$ and $Q=-{e}^{x-y}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=-{e}^{x-y},\\,\\frac{∂Q}{∂x}=-{e}^{x-y}.\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $H$ is conservative on ${R}^{2}.$\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186240899 :knowledge-point/_questions [{:db/id #edb/ref 17592186129086 :knowledge-point/id #uuid "9110c50a-62db-5447-b4d0-60819c80eb31" :knowledge-point/title "Identifying Properties Related to Point Discontinuities Given a Function Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fb24d2b-8efd-586e-a253-a50fc2629cfa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186239019} {:answer/id #uuid "80307242-8b68-591c-9255-4570a325b2c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186239171} {:answer/id #uuid "8baf082b-20a6-5070-a666-31e515517c98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186239267} {:answer/id #uuid "c13d07a3-eb6f-5324-82a9-e4ec44e5194f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186239745} {:answer/id #uuid "c18ace05-44b9-5c33-bcd4-98266f99d2a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186239751}] :answer-field/correct {:answer/id #uuid "8baf082b-20a6-5070-a666-31e515517c98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186239267} :answer-field/id #uuid "a5fab5aa-bc0a-5388-893b-7f8a16910152" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240626}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7bdde4d8-daa6-55ef-bcc6-21f99b29d77c" :question/math-academy-id "q-104575" :question/problem "Given that \n\n$$\n\\begin{aligned}g(x) & ={\\begin{aligned}{x}^{2}-34, & x<-3 \\\\ -25, & x=-3 \\\\ {x}^{3}+2, & x>-3\\end{aligned}\\end{aligned}\n$$\n\nwhich of the following statements are true?\n\n- ${lim}_{x\\to (-3)^{+}}g(x)={lim}_{x\\to (-3)^{-}}g(x)$\n- ${lim}_{x\\to (-3)}g(x)=g(-3)$\n- $g(x)$ has a removable discontinuity at $x=-3$" :question/worked-solution "Let's check our continuity conditions:\n\n- $g(-3)=-25$ exists $\\,✓$\n\n- The left and right-sided limits are\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,(-3)^{-}}g(x) & ={lim}_{x\\to \\,(-3)^{-}}({x}^{2}-34)=(-3)^{2}-34=-25, \\\\ {lim}_{x\\to \\,(-3)^{+}}g(x) & ={lim}_{x\\to \\,(-3)^{+}}({x}^{3}+2)=(-3)^{3}+2=-25.\\end{aligned}\n$$\n\nSince the left and right-sided limits are equal, we conclude that statement I is true and\n\n$$\n{lim}_{x\\to (-3)}g(x)=-25.\\,\\,✓\n$$\n\n- The value of the limit is ${lim}_{x\\to (-3)}g(x)=-25,$ and the value of the function is $g(-3)=-25.$ So, statement II is true and\n\n$$\n{lim}_{x\\to (-3)}g(x)=g(-3)\\,\\,✓\n$$\n\nSo, the function is continuous at $x=-3,$ and statement III is false.\n\nIn conclusion, only statements I and II are true."} {:db/id #edb/ref 17592186240901 :knowledge-point/_questions [{:db/id #edb/ref 17592186166863 :knowledge-point/id #uuid "65adbd80-9647-59d8-bd4a-42f431587c85" :knowledge-point/title "Identifying Conservative Vector Fields"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c39dccc-d152-5823-8cfe-96d61199aa56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186238165} {:answer/id #uuid "21e993fb-7e01-5a59-b005-ac176de2681e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186238349} {:answer/id #uuid "2643658b-7491-52bd-8be9-74fb74f6311b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186238387} {:answer/id #uuid "9a0c18d7-5599-5d7e-8192-2ab68f7c76f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186239392} {:answer/id #uuid "9ba2a58b-9f8a-5330-9034-f99d18182f35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186239411}] :answer-field/correct {:answer/id #uuid "21e993fb-7e01-5a59-b005-ac176de2681e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186238349} :answer-field/id #uuid "97fa4ed2-4752-5f83-95ae-700c3f3d2fe0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240597}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aac0da30-e1e4-5293-838c-ddb161ffe326" :question/math-academy-id "q-104582" :question/problem "Which of the following vector fields are conservative in their respective domains?\n\n- $F=(2x-4y)\\,i+(4x-8y)\\,j$\n- $G={2}^{2x+y+1}\\,i+{2}^{2x+y}\\,j$\n- $H=2x\\operatorname{ln}⁡({y}^{2}+1)\\,i+\\frac{2{x}^{2}y}{{y}^{2}+1}\\,j$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D={R}^{2}.$ With this in mind, let's check each of the vector fields.\n\n- For the vector field $F,$ we have $P=2x-4y$ and $Q=4x-8y.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=-4,\\,\\frac{∂Q}{∂x}=4.\n$$\n\nSince the partial derivatives are not equal, we conclude that $F$ is not conservative on ${R}^{2}.$\n\n- For the vector field $G,$ we have $P={2}^{2x+y+1}$ and $Q={2}^{2x+y}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}={2}^{2x+y+1}\\operatorname{ln}⁡2,\\,\\frac{∂Q}{∂x}={2}^{2x+y+1}\\operatorname{ln}⁡2.\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $G$ is conservative on ${R}^{2}.$\n\n- For the vector field $H,$ we have $P=2x\\operatorname{ln}⁡({y}^{2}+1)$ and $Q=\\frac{2{x}^{2}y}{{y}^{2}+1}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=\\frac{4xy}{{y}^{2}+1},\\,\\frac{∂Q}{∂x}=\\frac{4xy}{{y}^{2}+1}.\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $H$ is conservative on ${R}^{2}.$\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186240912 :knowledge-point/_questions [{:db/id #edb/ref 17592186054815 :knowledge-point/id #uuid "abc6b3ee-0251-5c9c-9358-bd192c434dd1" :knowledge-point/title "Identifying Elements Belonging to Scripted Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4be1bc93-8493-5e66-a47d-621415d1ec39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186238710} {:answer/id #uuid "7da10354-414b-50b2-b592-50e606d3f904" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186239145} {:answer/id #uuid "96baa967-179a-51a6-83c6-74754869b43c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III and IV only" :db/id #edb/ref 17592186239358} {:answer/id #uuid "f03e1a9a-feb4-56fb-be3f-1df092c37e42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186240173} {:answer/id #uuid "f23a0055-8221-5ffa-a1cf-fc4a5d521d86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and IV only" :db/id #edb/ref 17592186240193}] :answer-field/correct {:answer/id #uuid "4be1bc93-8493-5e66-a47d-621415d1ec39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186238710} :answer-field/id #uuid "f4546f66-8f1e-512d-a2f5-ed2460098882" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240758}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "016b340f-7aa5-5001-aeb3-927982c5cf50" :question/math-academy-id "q-104694" :question/problem "Which of the numbers below belong to ${Q}^{-}?$\n\n- $47$\n- $-\\sqrt{12}$\n- $\\sqrt{10}$\n- $0$" :question/worked-solution "Remember that ${Q}^{-}$ is the set of all negative rational numbers.\n\n- $47$ is positive, not negative, so it does *not* belong to ${Q}^{-}.\\,\\times $\n\n- $-\\sqrt{12}=-2\\sqrt{3}$ is not a rational number, so it does *not* belong to ${Q}^{-}.\\,\\times $\n\n- $\\sqrt{10}$ is positive, not negative, so it does *not* belong to ${Q}^{-}.\\,\\times $\n\n- $0$ is not negative, so it does *not* belong to ${Q}^{-}.\\,\\times $\n\nIn conclusion, the correct answer is \"None of those listed\"."} {:db/id #edb/ref 17592186240914 :knowledge-point/_questions [{:db/id #edb/ref 17592186054815 :knowledge-point/id #uuid "abc6b3ee-0251-5c9c-9358-bd192c434dd1" :knowledge-point/title "Identifying Elements Belonging to Scripted Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b20d257-4a95-5abf-b2e5-2514c08ed019" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186238567} {:answer/id #uuid "76f14fbf-0cd2-58d6-af80-e3ca89528cbc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186239080} {:answer/id #uuid "b4808275-bb4d-5d9e-813a-bca4fd59aaf1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186239634} {:answer/id #uuid "cd98c5f5-3abc-54bd-beca-f2b3b5b8d3a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186239853} {:answer/id #uuid "d003736f-66bb-5503-8242-6a9fbd78c4d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, III, and IV only" :db/id #edb/ref 17592186239874}] :answer-field/correct {:answer/id #uuid "d003736f-66bb-5503-8242-6a9fbd78c4d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, III, and IV only" :db/id #edb/ref 17592186239874} :answer-field/id #uuid "a0ab0db5-b1d9-58c1-a116-377a898c022e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240614}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c84fa181-6eb1-5e84-b542-36ff40a06a4c" :question/math-academy-id "q-104700" :question/problem "Which of the numbers below belong to  ${R}_{0}^{-}?$\n\n- $-14$\n- $\\sqrt{19}$\n- $-\\frac{2}{7}$\n- $0$" :question/worked-solution "Remember that ${R}_{0}^{-}$ is the set of all negative real numbers and $0.$\n\n- $-14$ belongs to ${R}_{0}^{-}.\\,✓$\n\n- $\\sqrt{19}$ is a positive number, so it does *not* belong to ${R}_{0}^{-}.\\,\\times $\n\n- $-\\frac{2}{7}$ belongs to ${R}_{0}^{-}.\\,✓$\n\n- $0$ belongs to ${R}_{0}^{-}.\\,✓$\n\nIn conclusion, the correct answer is \"I, III, and IV only\"."} {:db/id #edb/ref 17592186240915 :knowledge-point/_questions [{:db/id #edb/ref 17592186054815 :knowledge-point/id #uuid "abc6b3ee-0251-5c9c-9358-bd192c434dd1" :knowledge-point/title "Identifying Elements Belonging to Scripted Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "290ee5b8-cbf7-5232-b509-85b70d336edc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and IV only" :db/id #edb/ref 17592186238419} {:answer/id #uuid "5d98a1c9-ea74-5d5a-9235-9cb7b2ccd0f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186238871} {:answer/id #uuid "939ad9f4-b5dd-56c0-9292-76f77d15c465" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186239330} {:answer/id #uuid "c0e613a5-28c7-5ab0-88dd-d53e6c4d9408" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III and IV only" :db/id #edb/ref 17592186239739} {:answer/id #uuid "c2c8f4ee-acc5-5ce3-8962-6b1e968a9d3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186239766}] :answer-field/correct {:answer/id #uuid "290ee5b8-cbf7-5232-b509-85b70d336edc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and IV only" :db/id #edb/ref 17592186238419} :answer-field/id #uuid "7fe985a1-5ce0-54a3-83a9-d5b67f4adb67" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240559}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0e62d29f-2834-5b4e-b720-bc361e2a5dc0" :question/math-academy-id "q-104702" :question/problem "Which of the numbers below belong to  ${Z}_{0}^{-}?$\n\n- $-62$\n- $0$\n- $-\\frac{\\pi }{2}$\n- $-\\frac{56}{4}$" :question/worked-solution "Remember that ${Z}_{0}^{-}$ is the set of all negative integer numbers and $0.$\n\n- $-62$ belongs to ${Z}_{0}^{-}.\\,✓$\n\n- $0$ belongs to ${Z}_{0}^{-}.\\,✓$\n\n- $-\\frac{\\pi }{2}$ is not an integer, so it does *not* belong to ${Z}_{0}^{-}.\\,\\times $\n\n- $-\\frac{56}{4}=-14$ belongs to ${Z}_{0}^{-}.\\,✓$\n\nIn conclusion, the correct answer is \"I, II, and IV only\"."} {:db/id #edb/ref 17592186240916 :knowledge-point/_questions [{:db/id #edb/ref 17592186054816 :knowledge-point/id #uuid "1d132801-b9cc-5c0c-a8fa-0c8b840c05bd" :knowledge-point/title "Identifying Sets Containing a Given Element"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f508bc1-5c8c-5dac-b648-e683e6948a72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186238320} {:answer/id #uuid "97344af5-4d0b-50ac-8b3e-e8c06cd07b1f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186239364} {:answer/id #uuid "aca5e5b6-04b0-5494-8936-3a1199e5007a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III and IV only" :db/id #edb/ref 17592186239555} {:answer/id #uuid "b65deb58-d812-5ef0-9eed-c2321a16ab5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186239648} {:answer/id #uuid "fe32c1df-bb7d-58a9-84d1-726cffbc66e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "IV only" :db/id #edb/ref 17592186240301}] :answer-field/correct {:answer/id #uuid "97344af5-4d0b-50ac-8b3e-e8c06cd07b1f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186239364} :answer-field/id #uuid "b72163d1-46c0-5c21-9c83-5ecf0b5030da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240650}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1da25f7d-182b-5d2d-b5c8-9d3f66bb445c" :question/math-academy-id "q-104703" :question/problem "To which of the following sets does the number $\\sqrt{121}$ belong?\n\n- $N$\n- ${Q}^{-}$\n- ${Z}^{-}$\n- $Z$" :question/worked-solution "First, we note that $\\sqrt{121}=11$ is a natural number, so it belongs to $N.$\n\nSince every natural number is also an integer number, $\\sqrt{121}$ also belongs to $Z.$ \n\nOn the other hand, the sets ${Z}^{-}$ and ${Q}^{-}$ only contain negative numbers. Therefore, $\\sqrt{121}$ does not belong to either of these sets. \n\nTherefore, the correct answer is \"I and IV only.\""} {:db/id #edb/ref 17592186240922 :knowledge-point/_questions [{:db/id #edb/ref 17592186133870 :knowledge-point/id #uuid "c2bcfcb6-8f8b-5aa9-8346-05db880fa5bb" :knowledge-point/title "Determining Whether a Set of Polynomials is Orthogonal With Respect to a Given Inner Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dfa0d1d-6451-5387-be02-629f948a0f1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186238176} {:answer/id #uuid "11413563-1bf2-5444-8474-5e5cf301d8b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186238195} {:answer/id #uuid "19f29985-57b5-5076-80ec-5cd7f22a238f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186238269} {:answer/id #uuid "97d4f97f-b63c-51b3-ad86-5cecad9eefc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186239370} {:answer/id #uuid "ebab29aa-9a93-58e7-aefd-391feb8f233c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186240129}] :answer-field/correct {:answer/id #uuid "ebab29aa-9a93-58e7-aefd-391feb8f233c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186240129} :answer-field/id #uuid "ac216de7-0aa2-506b-ba09-2a8b5ef341b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240630}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "95a9cd65-803f-5d19-875e-716631b2f8a2" :question/math-academy-id "q-104734" :question/problem "Consider the following set of polynomials:\n\n$$\n{p}_{1}(t)={t}^{2}+t,\\,{p}_{2}(t)={t}^{2}-t,\\,{p}_{3}(t)={t}^{2}-1.\n$$\n\nGiven that the inner product in the vector space ${R}_{2}[t]$ of polynomials of degree at most $2$ in the variable $t$ is defined as \n\n$$\n⟨p(t),q(t)⟩=p(-1)q(-1)+p(0)q(0)+p(1)q(1),\n$$\n\nwhich of the following statements are true?\n\n- ${p}_{1}(t)⊥{p}_{2}(t)$ with respect to the given inner product\n- ${p}_{1}(t)⊥{p}_{3}(t)$ with respect to the given inner product\n- $S={{p}_{1}(t),{p}_{2}(t),{p}_{3}(t)}$ is an orthogonal set with respect to the given inner product" :question/worked-solution "Recall that a set of vectors in an inner product space is orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, we have\n\n$$\n\\begin{aligned}⟨{p}_{1}(t),{p}_{2}(t)⟩ & =⟨{t}^{2}+t,{t}^{2}-t⟩ \\\\  & =({t}^{2}\\,+\\,t){|}_{-1}\\,\\cdot \\,({t}^{2}\\,-\\,t){|}_{-1}+({t}^{2}\\,+\\,t){|}_{0}\\,\\cdot \\,({t}^{2}\\,-\\,t){|}_{0}+({t}^{2}\\,+\\,t){|}_{1}\\,\\cdot \\,({t}^{2}\\,-\\,t){|}_{1} \\\\  & =((-1)^{2}\\,+\\,(-1))\\,\\cdot \\,((-1)^{2}\\,-\\,(-1))\\,+\\,({0}^{2}\\,+\\,0)\\,\\cdot \\,({0}^{2}\\,-\\,0)\\,+\\,({1}^{2}\\,+\\,1)\\,\\cdot \\,({1}^{2}\\,-\\,1) \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${p}_{1}(t)⊥{p}_{2}(t)$ with respect to the given inner product.\n\n- Statement II is true. Indeed, we have\n\n$$\n\\begin{aligned}⟨{p}_{1}(t),{p}_{3}(t)⟩ & =⟨{t}^{2}+t,{t}^{2}-1⟩ \\\\  & =({t}^{2}\\,+\\,t){|}_{-1}\\,\\cdot \\,({t}^{2}\\,-\\,1){|}_{-1}\\,+\\,({t}^{2}\\,+\\,t){|}_{0}\\,\\cdot \\,({t}^{2}\\,-\\,1){|}_{0}+({t}^{2}\\,+\\,t){|}_{1}\\,\\cdot \\,({t}^{2}\\,-\\,t){|}_{1} \\\\  & =((-1)^{2}\\,+\\,(-1))\\,\\cdot \\,((-1)^{2}\\,-\\,1)\\,+\\,({0}^{2}\\,+\\,0)\\,\\cdot \\,({0}^{2}\\,-\\,1)\\,+\\,({1}^{2}\\,+\\,1)\\,\\cdot \\,({1}^{2}\\,-\\,1) \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${p}_{1}(t)⊥{p}_{3}(t)$ with respect to the given inner product.\n\n- Statement III is true. Let's check if ${p}_{2}(t)⊥{p}_{3}(t).$ Computing the inner product, we have\n\n$$\n\\begin{aligned}⟨{p}_{2}(t),{p}_{3}(t)⟩ & =⟨{t}^{2}-t,{t}^{2}-1⟩ \\\\  & =({t}^{2}\\,-\\,t){|}_{-1}\\,\\cdot \\,({t}^{2}\\,-\\,1){|}_{-1}+({t}^{2}\\,-\\,t){|}_{0}\\,\\cdot \\,({t}^{2}\\,-\\,1){|}_{0}+({t}^{2}\\,-\\,t){|}_{1}\\,\\cdot \\,({t}^{2}\\,-\\,1){|}_{1} \\\\  & =((-1)^{2}\\,-\\,(-1))\\,\\cdot \\,((-1)^{2}\\,-\\,1)\\,+\\,({0}^{2}\\,-\\,0)\\,\\cdot \\,({0}^{2}\\,-\\,1)\\,+\\,({1}^{2}\\,-\\,1)\\,\\cdot \\,({1}^{2}\\,-\\,1) \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${p}_{2}(t)⊥{p}_{3}(t)$ with respect to the given inner product. So, $S$ is an orthogonal set.\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186240923 :knowledge-point/_questions [{:db/id #edb/ref 17592186133870 :knowledge-point/id #uuid "c2bcfcb6-8f8b-5aa9-8346-05db880fa5bb" :knowledge-point/title "Determining Whether a Set of Polynomials is Orthogonal With Respect to a Given Inner Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d3d4890-6f13-5dde-8095-3e3fced3ec6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186238867} {:answer/id #uuid "6e7da710-4947-5407-a417-4e130b1e610b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186239007} {:answer/id #uuid "771614d9-5d43-5f3d-ad3a-5323c7edc76b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186239081} {:answer/id #uuid "aa902358-41c8-51c0-b7ed-68bafa845a0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186239547} {:answer/id #uuid "d3a18bf8-4f0e-5c76-ac9a-9b37b5796acf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186239913}] :answer-field/correct {:answer/id #uuid "d3a18bf8-4f0e-5c76-ac9a-9b37b5796acf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186239913} :answer-field/id #uuid "873915d1-3cba-59f7-b3bd-b2e37c5ee6c5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240570}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5d2cd958-2383-51a8-8ef7-f3c1ff9a5b43" :question/math-academy-id "q-104736" :question/problem "Consider the following set of polynomials:\n\n$$\n{p}_{1}(t)={t}^{2}-4,\\,{p}_{2}(t)={t}^{2}-t,\\,{p}_{3}(t)={t}^{2}-2t.\n$$\n\nGiven that the inner product in the vector space ${R}_{2}[t]$ of polynomials of degree at most $2$ in the variable $t$ is defined as \n\n$$\n⟨p(t),q(t)⟩=p(0)q(0)+p(1)q(1)+p(2)q(2),\n$$\n\nwhich of the following statements are true?\n\n- ${p}_{1}(t)⊥{p}_{2}(t)$ with respect to the given inner product\n- ${p}_{2}(t)⊥{p}_{3}(t)$ with respect to the given inner product\n- $S={{p}_{1}(t),{p}_{2}(t),{p}_{3}(t)}$ is an orthogonal set with respect to the given inner product" :question/worked-solution "Recall that a set of vectors in an inner product space is orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, we have\n\n$$\n\\begin{aligned}⟨{p}_{1}(t),{p}_{2}(t)⟩ & =⟨{t}^{2}-4,{t}^{2}-t⟩ \\\\  & =({t}^{2}\\,-\\,4){|}_{0}\\,\\cdot \\,({t}^{2}\\,-\\,t){|}_{0}+({t}^{2}\\,-\\,4){|}_{1}\\,\\cdot \\,({t}^{2}\\,-\\,t){|}_{1}+({t}^{2}\\,-\\,4){|}_{2}\\,\\cdot \\,({t}^{2}\\,-\\,2t){|}_{2} \\\\  & =({0}^{2}\\,-\\,4)\\,\\cdot \\,({0}^{2}\\,-\\,0)\\,+\\,({1}^{2}\\,-\\,4)\\,\\cdot \\,({1}^{2}\\,-\\,1)\\,+\\,({2}^{2}\\,-\\,4)\\,\\cdot \\,({2}^{2}\\,-\\,2(2)) \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${p}_{1}(t)⊥{p}_{2}(t)$ with respect to the given inner product.\n\n- Statement II is true. Indeed, we have\n\n$$\n\\begin{aligned}⟨{p}_{2}(t),{p}_{3}(t)⟩ & =⟨{t}^{2}-t,{t}^{2}-2t⟩ \\\\  & =({t}^{2}\\,-\\,t){|}_{0}\\,\\cdot \\,({t}^{2}\\,-\\,2t){|}_{0}+({t}^{2}\\,-\\,t){|}_{1}\\,\\cdot \\,({t}^{2}\\,-\\,2t){|}_{1}+({t}^{2}\\,-\\,t){|}_{2}\\,\\cdot \\,({t}^{2}\\,-\\,2t){|}_{2} \\\\  & =({0}^{2}\\,-\\,0)\\,\\cdot \\,({0}^{2}\\,-\\,2(0))\\,+\\,({1}^{2}\\,-\\,1)\\,\\cdot \\,({1}^{2}\\,-\\,2(1))\\,+\\,({2}^{2}\\,-\\,2)\\,\\cdot \\,({2}^{2}-2(2)) \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${p}_{2}(t)⊥{p}_{3}(t)$ with respect to the given inner product.\n\n- Statement III is false. Let's check if ${p}_{1}(t)⊥{p}_{3}(t).$ Computing the inner product, we have\n\n$$\n\\begin{aligned}⟨{p}_{1}(t),{p}_{3}(t)⟩ & =⟨{t}^{2}-4,{t}^{2}-2t⟩ \\\\  & =({t}^{2}\\,-\\,4){|}_{0}\\,\\cdot \\,({t}^{2}\\,-\\,2t){|}_{0}+({t}^{2}\\,-\\,4){|}_{1}\\,\\cdot \\,({t}^{2}\\,-\\,2t){|}_{1}+({t}^{2}\\,-\\,4){|}_{2}\\,\\cdot \\,({t}^{2}\\,-\\,2t){|}_{2} \\\\  & =({0}^{2}\\,-\\,4)\\,\\cdot \\,({0}^{2}\\,-\\,2(0))\\,+\\,({1}^{2}\\,-\\,4)\\,\\cdot \\,({1}^{2}\\,-\\,2(1))\\,+\\,({2}^{2}\\,-\\,4)\\,\\cdot \\,({2}^{2}\\,-\\,2(2)) \\\\  & =3\\ne 0,\\end{aligned}\n$$\n\nwhich means that ${p}_{2}(t)⊥̸{p}_{3}(t)$ with respect to the given inner product. So, the set $S$ is *not* an orthogonal set.\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186240931 :knowledge-point/_questions [{:db/id #edb/ref 17592186172031 :knowledge-point/id #uuid "bbac348b-629f-52a1-9bb3-0d3f8483ff44" :knowledge-point/title "Interpreting the Arrow Function Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e6ab324-e5d5-54bc-81f0-75fea5bb330d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186238311} {:answer/id #uuid "3a08ac4a-4091-58c6-92af-1125cbea741c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186238559} {:answer/id #uuid "3acac4f5-4282-5572-8280-d6cef3c271a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186238565} {:answer/id #uuid "a162af6d-c1e0-55bb-8110-b150da1039b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186239459} {:answer/id #uuid "c80ddecd-e80b-5833-b146-c2c88d4a543a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186239817}] :answer-field/correct {:answer/id #uuid "a162af6d-c1e0-55bb-8110-b150da1039b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186239459} :answer-field/id #uuid "c284c296-c6a6-52f7-9741-e3dc22502ff5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240669}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1f571336-e197-53b2-942f-7691710c5fd2" :question/math-academy-id "q-104778" :question/problem "Which of the following functions has the codomain ${0,1}?$\n\n- $p:{0,1}\\to Z$\n- $q:[0,1]\\to {0,1}$\n- $r:{0,1}\\to (0,1)$" :question/worked-solution "The notation $f:X\\to Y$ means that the function $f$ maps the set $X$ to the set $Y.$ In this case,\n\n- the domain of $f$ is $X,$\n\n- the codomain of $f$ is $Y.$\n\nWith that in mind, let's examine our functions.\n\n- The codomain of $p$ is $Z,$ the set of integers.\n\n- The codomain of $q$ is ${0,1},$ the set containing the two numbers $0$ and $1$ only.\n\n- The codomain of $r$ is $(0,1),$ the interval from $0$ to $1$ (excluding both $0$ and $1$).\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186240932 :knowledge-point/_questions [{:db/id #edb/ref 17592186172031 :knowledge-point/id #uuid "bbac348b-629f-52a1-9bb3-0d3f8483ff44" :knowledge-point/title "Interpreting the Arrow Function Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "444c9197-bf9a-595e-9928-a00d60bf51ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186238646} {:answer/id #uuid "48ab53f8-8b1f-598c-b301-1fb5d97fd076" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186238690} {:answer/id #uuid "98c80c08-b713-5407-b264-97db66af82b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186239381} {:answer/id #uuid "d7f96900-f753-561b-97e8-5b406d478b53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186239939} {:answer/id #uuid "daa8044c-f7da-5f1d-b8f2-e0a8751f5b15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186239962}] :answer-field/correct {:answer/id #uuid "d7f96900-f753-561b-97e8-5b406d478b53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186239939} :answer-field/id #uuid "1ae58ed1-7247-5583-af27-e33f0f49a422" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240374}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "00f5a8c6-457a-5b26-87c0-0c588245cf9d" :question/math-academy-id "q-104780" :question/problem "Which of the following functions has the domain $Z?$\n\n- $p:Z\\to [0,3]$\n- $q:(0,7)\\to Z$\n- $r:{Z}^{+}\\to Z$" :question/worked-solution "The notation $f:X\\to Y$ means that the function $f$ maps the set $X$ to the set $Y.$ In this case,\n\n- the domain of $f$ is $X,$\n\n- the codomain of $f$ is $Y.$\n\nWith that in mind, let's examine our functions.\n\n- The domain of $p$ is $Z,$ the set of integers.\n\n- The domain of $q$ is $(0,7),$ the interval from $0$ to $7$ (excluding $0$ and $7$).\n\n- The domain of $r$ is ${Z}^{+},$ the set of positive integers.\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186240933 :knowledge-point/_questions [{:db/id #edb/ref 17592186172031 :knowledge-point/id #uuid "bbac348b-629f-52a1-9bb3-0d3f8483ff44" :knowledge-point/title "Interpreting the Arrow Function Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16e11ce7-772d-5167-aacc-c50653d1da8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186238252} {:answer/id #uuid "669e1527-0fe0-5c06-b32f-423993073528" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186238950} {:answer/id #uuid "8f15fd0f-7424-5e92-b313-a15ec5b93ffa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186239301} {:answer/id #uuid "af228750-6768-51c1-8675-12a42677d2e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186239578} {:answer/id #uuid "c593d50f-219d-5028-9ad4-960392042586" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186239792}] :answer-field/correct {:answer/id #uuid "8f15fd0f-7424-5e92-b313-a15ec5b93ffa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186239301} :answer-field/id #uuid "3f1c8172-8f3d-5164-b238-a3a89a22c624" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240439}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f3958191-a06f-54c9-9b69-6e7038fa786f" :question/math-academy-id "q-104781" :question/problem "Which of the following functions has the domain $[-2,2]?$\n\n- $p:[-2,2]\\to (-2,2)$\n- $r:[-2,2]\\to {-2,2}$\n- $q:Z\\to [-2,2]$" :question/worked-solution "The notation $f:X\\to Y$ means that the function $f$ maps the set $X$ to the set $Y.$ In this case,\n\n- the domain of $f$ is $X,$\n\n- the codomain of $f$ is $Y.$\n\nWith that in mind, let's examine our functions.\n\n- The domain of $p$ is $[-2,2],$ the interval from $-2$ to $2$ (including $-2$ and $2$).\n\n- The domain of $q$ is $[-2,2],$ the interval from $-2$ to $2$ (including $-2$ and $2$).\n\n- The domain of $r$ is $Z,$ the set of integers.\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186240957 :knowledge-point/_questions [{:db/id #edb/ref 17592186054629 :knowledge-point/id #uuid "b0e5efaa-e624-5045-abdb-cdf8d32ad6cb" :knowledge-point/title "Identifying Subsets of a Given Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6320076d-f184-5505-9afa-066450dc7e0c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186238925} {:answer/id #uuid "6f8f13b3-1fbe-5065-bdb6-0ac9afedb7c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186239018} {:answer/id #uuid "748dd741-9dc6-51eb-b44f-5d4106157729" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186239058} {:answer/id #uuid "7c25f0ee-4977-5144-9f98-99d8e7619ec3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186239126} {:answer/id #uuid "ed6ef1b9-ca5d-5247-86e0-65ac9418fa5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186240144}] :answer-field/correct {:answer/id #uuid "7c25f0ee-4977-5144-9f98-99d8e7619ec3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186239126} :answer-field/id #uuid "ad5dfd15-d15e-51e0-842d-fdbae1516db2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240636}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4740436b-fb84-571a-aea1-e76558938555" :question/math-academy-id "q-104916" :question/problem "Which of the following sets is a subset of $A={{12},{20,22},{6,9,15}}?$\n\n- ${-1,{12}}$\n- ${{20,22}}$\n- ${{0},{6,9,15}}$" :question/worked-solution "A set is a subset of $A$ if all its elements are elements of $A.$ \n\nWith that in mind, let's inspect each option.\n\n- ${-1,{12}}$ is *not* a subset of $A$ because it contains the element $-1\\notin A.\\,\\times $\n\n- ${{20,22}}$ is a subset of $A.\\,✓$\n\n- ${{0},{6,9,15}}$ is *not* a subset of $A$ because it contains the element ${0}\\notin A.\\,\\times $\n\nTherefore, the correct answer is \"II only\"."} {:db/id #edb/ref 17592186240965 :knowledge-point/_questions [{:db/id #edb/ref 17592186172034 :knowledge-point/id #uuid "1240e42a-92a5-51cc-a80e-3fe1ef0b16f7" :knowledge-point/title "Identifying Codomains and Ranges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c942801-4233-56d7-9fb8-ceb97d123362" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186238294} {:answer/id #uuid "68461084-a8de-521f-b799-1dd5709cfda9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186238961} {:answer/id #uuid "c9e5a170-5b45-500a-8676-391714d56859" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186239829} {:answer/id #uuid "ce8ed2f5-5559-580e-8304-67e8460a2ed9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186239865} {:answer/id #uuid "d1a916a1-8aee-5f26-8f14-99f490d68e01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186239894}] :answer-field/correct {:answer/id #uuid "c9e5a170-5b45-500a-8676-391714d56859" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186239829} :answer-field/id #uuid "4680294b-b316-53ae-9fc5-7faee29b649b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240453}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "caad9560-3559-5568-b085-de268d2408da" :question/math-academy-id "q-104945" :question/problem "Which of the following is the correct interpretation of $g:{0,1}\\to Z?$\n\n- The domain of $g$ is ${0,1}$\n- The codomain of $g$ is $Z$\n- The range of $g$ is ${0,1}$" :question/worked-solution "The notation \n\n$$\ng:{0,1}\\to Z\n$$\n\nmeans that the function $g$ maps the set ${0,1}$ to the set $Z.$ In this case,\n\n- the domain of $g$ is ${0,1},$ and\n\n- the codomain of $g$ is $Z.$ Note that ${0,1}⊆Z$ is *not* necessarily the range.\n\nAs a result, statements I and II are true, while statement III is false.\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186240966 :knowledge-point/_questions [{:db/id #edb/ref 17592186172034 :knowledge-point/id #uuid "1240e42a-92a5-51cc-a80e-3fe1ef0b16f7" :knowledge-point/title "Identifying Codomains and Ranges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "170f27a7-adab-5fb3-a43b-22015f9de6f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186238254} {:answer/id #uuid "2e6b9b0b-0581-587e-a19e-5c61236e4e9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186238460} {:answer/id #uuid "47044167-e5aa-5119-a140-0e4d7ee5f0b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186238672} {:answer/id #uuid "bca9a8b0-a6cc-57c6-aeb9-b630a482addb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186239700} {:answer/id #uuid "ec7bda4d-9283-5415-a3d1-907a039a7cf0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186240134}] :answer-field/correct {:answer/id #uuid "bca9a8b0-a6cc-57c6-aeb9-b630a482addb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186239700} :answer-field/id #uuid "200710a7-fe7f-5bb1-bea5-13c8f8caa4aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240382}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ece458da-55a3-56bf-9d0d-49bed0ba9d3c" :question/math-academy-id "q-104946" :question/problem "Which of the following is the correct interpretation of $g:Q\\to R?$\n\n- The domain of $g$ is $R$\n- The codomain of $g$ is $R$\n- The range of $g$ is $Q$" :question/worked-solution "The notation \n\n$$\ng:Q\\to R\n$$\n\nmeans that the function $g$ maps the set $Q$ to the set $R.$ In this case,\n\n- the domain of $g$ is $Q,$ and\n\n- the codomain of $g$ is $R.$ Note that $Q⊂R$ is *not* necessarily the range.\n\nAs a result, statements I and III are false, while statement II is true.\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186240968 :knowledge-point/_questions [{:db/id #edb/ref 17592186172034 :knowledge-point/id #uuid "1240e42a-92a5-51cc-a80e-3fe1ef0b16f7" :knowledge-point/title "Identifying Codomains and Ranges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23902f14-27f2-5101-84f0-7c1806396a84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186238368} {:answer/id #uuid "2b359311-6c75-5aba-a57a-fe93b771abf7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186238437} {:answer/id #uuid "406d00a9-cdd8-5229-81cd-eff712bd62dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186238612} {:answer/id #uuid "b23afc17-039f-5aee-944b-9492730d88c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186239611} {:answer/id #uuid "b3cbd10d-9ab8-56b1-b1c4-feec697ddb07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186239624}] :answer-field/correct {:answer/id #uuid "2b359311-6c75-5aba-a57a-fe93b771abf7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186238437} :answer-field/id #uuid "ddd9cde6-7000-5e6b-b8ab-9e58d2ac529a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240718}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "86293bdd-1445-5c75-b0fe-3a52f74f9647" :question/math-academy-id "q-104954" :question/problem "![](images/8f/8ff01afa1993f8e301edb69e3e7a13ee71ab01b1a3da416aa53ee94d021184e1.png)\n\nConsider the function $g:X\\to Y$ given by the mapping diagram shown above. Which of the following statements are true?\n\n- The domain of $g$ is ${0,1,2}$\n- The codomain of $g$ is ${-1,0,1,2}$\n- The range of $g$ is ${0,1,2}$" :question/worked-solution "The notation $g:X\\to Y$ means that the function $g$ maps the set $X$ to the set $Y.$ In this case,\n\n- the domain of $g$ is $X,$\n\n- the codomain of $g$ is $Y.$\n\nThe range of $g$ is the subset of the codomain that contains all values $y\\in Y$ that are mapped to by at least one element $x\\in X.$\n\nWith that in mind, let's inspect our diagram:\n\n- the domain of $g$ is $X={-1,0,1,2},$\n\n- the codomain of $g$ is $Y={0,1,2},$\n\n- the range of $g$ is ${0,1,2},$ the subset of elements of $Y$ that have at least one incoming arrow.\n\nAs a result, statements I and II are false, while statement III is true.\n\nTherefore, the correct answer \"III only.\""} {:db/id #edb/ref 17592186240969 :knowledge-point/_questions [{:db/id #edb/ref 17592186124654 :knowledge-point/id #uuid "4ca319c5-9f62-51e3-b670-611fc8a8daaa" :knowledge-point/title "Classifying a Critical Point Using the Second Partial Derivatives Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28bee080-f834-5a65-875e-64ff7347b686" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186238415} {:answer/id #uuid "5996a243-56ab-51f3-ad76-62c2e3bde6cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186238824} {:answer/id #uuid "7e0ffc73-d2c1-5009-b10d-4151c9d3cd50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186239152} {:answer/id #uuid "9a7e7d63-45c4-50a5-aaa2-0d3597c02017" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186239400} {:answer/id #uuid "9b6fe7c0-652f-5c4b-aba5-09bac5d9f309" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186239410}] :answer-field/correct {:answer/id #uuid "9b6fe7c0-652f-5c4b-aba5-09bac5d9f309" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186239410} :answer-field/id #uuid "ac3ebdbc-2590-5082-b160-ffed9036c31a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240631}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bcc06ba1-1065-5981-a107-14dc46cea80e" :question/math-academy-id "q-104984" :question/problem "The function \n$f(x,y)$ \nhas the second derivative\n\n$$\n{f}^{″}(x,y)=[\\begin{aligned}{e}^{-({x}^{2}+{y}^{2})}(2{x}^{2}-1) & 2xy{e}^{-({x}^{2}+{y}^{2})} \\\\ 2xy{e}^{-({x}^{2}+{y}^{2})} & {e}^{-({x}^{2}+{y}^{2})}(2{y}^{2}-1)\\end{aligned}]\n$$\n\nand has a stationary point at $(0,0).$ If $H$ denotes the Hessian determinant of $f,$ which of the following statements are true?\n\n- $H(0,0)>0$\n- $\\frac{{∂}^{2}f}{∂{x}^{2}}(0,0)>0$\n- The point $(0,0)$ is a local maximum of $f$" :question/worked-solution "The second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ we have the following:\n\n- If $H(a)>0,$ then:\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a$\n\n- If $H(a)<0,$ then $f$ has a saddle point at $a$\n\n- If $H(a)=0,$ then the second partial derivatives test is inconclusive.\n\nEvaluating the second derivative at $(0,0),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(0,0)=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}].\\end{aligned}\n$$\n\nNow, let's examine our statements in turn.\n\n- Statement I is true. Indeed, computing the determinant of ${f}^{″}(0,0),$ we get\n\n$$\nH(0,0)=det({f}^{″}(0,0))=(-1)^{2}-{0}^{2}=1>0.\n$$\n\n- Statement II is false. We have $\\frac{{∂}^{2}f}{∂{x}^{2}}(0,0)=({f}^{″}(0,0))_{11}=-1<0.$\n\n- Statement III is true. Indeed, since $H(0,0)>0$ and $\\frac{{∂}^{2}f}{∂{x}^{2}}(0,0)<0,$ the point $(0,0)$ is a local maximum by the second partial derivative test.\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186240970 :knowledge-point/_questions [{:db/id #edb/ref 17592186124654 :knowledge-point/id #uuid "4ca319c5-9f62-51e3-b670-611fc8a8daaa" :knowledge-point/title "Classifying a Critical Point Using the Second Partial Derivatives Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2384084c-0ad8-5474-a426-2c2d4b61f394" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186238367} {:answer/id #uuid "63e0a616-9b9c-5f18-b88e-79e60e3cf07f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186238930} {:answer/id #uuid "9cd744ae-5143-52bc-be05-7bd8710afef4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186239417} {:answer/id #uuid "c346f462-1b1e-504d-9e90-c52eccd0c1c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186239777} {:answer/id #uuid "f0e2cde0-867a-5cd6-807e-b33239302266" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186240182}] :answer-field/correct {:answer/id #uuid "63e0a616-9b9c-5f18-b88e-79e60e3cf07f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186238930} :answer-field/id #uuid "0e6c05c4-cb31-5b46-a21a-67880b6b5964" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240351}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e273e9fd-fb16-5b0e-b15b-fcbb70918d78" :question/math-academy-id "q-104995" :question/problem "The function \n$f(x,y)$\nhas the first derivative\n\n$$\n{f}^{′}(x,y)=[\\begin{aligned}3{x}^{2}-3y & 3{y}^{2}-3x\\end{aligned}],\n$$\n\nand has a stationary point at $(1,1).$ If $H$ denotes the Hessian determinant of $f,$ which of the following statements are true?\n\n- $H(1,1)>0$\n- $\\frac{{∂}^{2}f}{∂{x}^{2}}(1,1)<0$\n- The point $(1,1)$ is a local maximum of $f$" :question/worked-solution "The second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ we have the following:\n\n- If $H(a)>0,$ then:\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a$\n\n- If $H(a)<0,$ then $f$ has a saddle point at $a$\n\n- If $H(a)=0,$ then the second partial derivatives test is inconclusive.\n\nFirst, we notice that since ${f}^{′}(x,y)=[\\begin{aligned}3{x}^{2}-3y & 3{y}^{2}-3x\\end{aligned}],$ we must have\n\n$$\n\\frac{∂f}{∂x}=3{x}^{2}-3y,\\,\\frac{∂f}{∂y}=3{y}^{2}-3x.\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(3{x}^{2}-3y)=6x \\\\ \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(3{y}^{2}-3x)=6y \\\\ \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{{∂}^{2}f}{∂y∂x}=\\frac{∂}{∂x}(3{y}^{2}-3x)=-3\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}]=[\\begin{aligned}6x & -3 \\\\ -3 & 6y\\end{aligned}].\\end{aligned}\n$$\n\nEvaluating the second derivative at $(1,1),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(1,1)=[\\begin{aligned}6 & -3 \\\\ -3 & 6\\end{aligned}].\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, computing the determinant of ${f}^{″}(1,1),$ we get\n\n$$\nH(1,1)=det({f}^{″}(1,1))={6}^{2}-(-3)^{2}=27>0.\n$$\n\n- Statement II is false. We have $\\frac{{∂}^{2}f}{∂{x}^{2}}(1,1)=({f}^{″}(1,1))_{11}=6>0.$\n\n- Statement III is false. Since $H(1,1)>0$ and $\\frac{{∂}^{2}f}{∂{x}^{2}}(1,1)>0,$ the point $(1,1)$ is a local minimum by the second partial derivative test.\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186240972 :knowledge-point/_questions [{:db/id #edb/ref 17592186054631 :knowledge-point/id #uuid "9b7f1d12-3335-5dd7-bf36-e07077d0c45d" :knowledge-point/title "Identifying Subsets of Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0484eaf7-9412-5914-9529-5a91fc451c8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186238119} {:answer/id #uuid "24e2ea54-d24f-52e0-90d0-2e855dfc1a88" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186238378} {:answer/id #uuid "d52ad722-7dd6-5480-aef6-d03d8ba2f94f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186239925} {:answer/id #uuid "dbedb9fd-99da-55fb-ad10-e905d50c863f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186239974} {:answer/id #uuid "f7bebc67-3e94-59dd-997c-7ad86745d333" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186240246}] :answer-field/correct {:answer/id #uuid "f7bebc67-3e94-59dd-997c-7ad86745d333" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186240246} :answer-field/id #uuid "f3801784-8479-5814-8073-11bcaba8056c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240756}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "63db395b-88f4-58c0-8886-5830de0a85c3" :question/math-academy-id "q-105033" :question/problem "Which of the following are subsets of ${Q}_{0}^{-}$ (the set of non-positive rational numbers)?\n\n- $Z$\n- ${Z}^{-}$ (the set of negative integers)\n- $N$" :question/worked-solution "$A$ is a subset of $B$ if every element of $A$ is an element of $B.$\n\nWith that in mind, let's inspect the given choices.\n\n- $Z$ is *not* a subset of ${Q}_{0}^{-}.$ For example, $1\\in Z$ but $1\\notin {Q}_{0}^{-}.$\n\n- ${Z}^{-}$ is  a subset of ${Q}_{0}^{-}.$ Every negative integer is a non-positive rational number.\n\n- $N$ is *not* a subset of ${Q}_{0}^{-}.$ For example, $1\\in N$ but $1\\notin {Q}_{0}^{-}.$\n\nTherefore, the correct answer is \"II only\"."} {:db/id #edb/ref 17592186240973 :knowledge-point/_questions [{:db/id #edb/ref 17592186054631 :knowledge-point/id #uuid "9b7f1d12-3335-5dd7-bf36-e07077d0c45d" :knowledge-point/title "Identifying Subsets of Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20da86c9-b413-5fd3-b966-bced38d2961e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186238341} {:answer/id #uuid "57e08709-9551-574f-8693-ace404a47411" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186238811} {:answer/id #uuid "b0fe6aaa-8ca3-51c2-a5a2-bbfdb146ee36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186239596} {:answer/id #uuid "bd808711-0908-53fc-aae9-25e26770bdbc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186239708} {:answer/id #uuid "e1104fa6-ef2f-5563-a8e6-2114658991b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186240029}] :answer-field/correct {:answer/id #uuid "57e08709-9551-574f-8693-ace404a47411" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186238811} :answer-field/id #uuid "d5dcdb8f-b293-5d92-a703-bf52db6e296e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240709}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eb139d93-059f-53af-a8f9-6a747e8ff56b" :question/math-academy-id "q-105034" :question/problem "Which of the following are subsets of $R?$\n\n- ${Q}^{-}$ (the set of negative rationals)\n- ${Z}^{+}$ (the set of positive integers)\n- $N$" :question/worked-solution "$A$ is a subset of $B$ if every element of $A$ is an element of $B.$\n\nWith that in mind, let's inspect the given choices.\n\n- ${Q}^{-}$ is  a subset of $R.$ Every negative rational number is a real number.\n\n- ${Z}^{+}$ is a subset of $R.$ Every positive integer number is a real number.\n\n- $N$ a subset of $R.$ Every natural number is a real number.\n\nTherefore, the correct answer is \"I, II and III\"."} {:db/id #edb/ref 17592186240974 :knowledge-point/_questions [{:db/id #edb/ref 17592186133880 :knowledge-point/id #uuid "4f47e201-105a-579a-8cde-fcb6bf8cfa2a" :knowledge-point/title "Interpreting Divergence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "005c8e0e-15a2-595a-8bf4-9ff48deefe1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186238082} {:answer/id #uuid "5a77fe81-e649-5e06-8e48-0a04dd7aa841" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186238835} {:answer/id #uuid "b9ee5d37-f557-5170-896e-a0186821d84e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186239673} {:answer/id #uuid "ed516192-424f-5a7a-a664-5896e5376a49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186240142} {:answer/id #uuid "f6e231ae-d734-5b35-81c3-81ff9183634d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186240232}] :answer-field/correct {:answer/id #uuid "ed516192-424f-5a7a-a664-5896e5376a49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186240142} :answer-field/id #uuid "86eda225-7e4d-5e5f-9ce8-78deff9e5db6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240568}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3b5e7ba9-0b08-5996-9edf-60b5549da2af" :question/math-academy-id "q-105046" :question/problem "![](images/0b/0bc0e75bb577ca37b89568e14a4e0d03da7ce4f4853c4e8c57d9b2df79897b13.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\n- $∇\\cdot F=0$\n- $∇\\cdot F>0$\n- $∇\\cdot F<0$\n- $F$ is solenoidal" :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $F$ acts like a source at $P,$ then $∇\\cdot F>0$ at $P.$\n\n- If $F$ acts like a sink at $P,$ then $∇\\cdot F<0$ at $P.$\n\n- If $F$ acts like neither a source nor a sink at $P,$ then $∇\\cdot F=0$ at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement I is true, whereas statements II and III are false. For any point $P,$ the sum of the inward-pointing vectors equals the sum of the outward-pointing vectors. Therefore, $F$ acts neither like a source nor a sink.\n\n- Statement IV is true. Since $∇\\cdot F=0$ everywhere, the vector field $F$ is solenoidal.\n\nTherefore, the correct answer is \"I and IV only.\""} {:db/id #edb/ref 17592186240975 :knowledge-point/_questions [{:db/id #edb/ref 17592186054632 :knowledge-point/id #uuid "495f3da0-849a-589d-ac88-26d6825445e4" :knowledge-point/title "Identifying True Statements About Subsets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21f26a3f-f8aa-51d7-83bc-84d4d1f3e29c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, III, and IV only" :db/id #edb/ref 17592186238350} {:answer/id #uuid "9aec57c3-1ff8-5ede-b25f-4126b769414d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186239404} {:answer/id #uuid "c1b955c8-064e-5c1a-9233-310b065bfe30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III and IV only" :db/id #edb/ref 17592186239754} {:answer/id #uuid "ce693687-08cd-5026-93b5-f84a347f03c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186239863} {:answer/id #uuid "e60eec68-d021-5965-822a-8deec198de79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and IV only" :db/id #edb/ref 17592186240076}] :answer-field/correct {:answer/id #uuid "21f26a3f-f8aa-51d7-83bc-84d4d1f3e29c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, III, and IV only" :db/id #edb/ref 17592186238350} :answer-field/id #uuid "0d236ad3-8465-5855-af2b-83ac755c82b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240349}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c0ffa6ad-f9fd-59d8-a6a4-bd61246d63d4" :question/math-academy-id "q-105064" :question/problem "Which of the following statements are true for the sets $A={n\\in N∣n-2\\ge 4}$ and $B={n\\in Z∣n+2\\ge 5}?$\n\n- $A⊆B$\n- $B⊆A$\n- $∅⊆A$\n- $B⊇A$" :question/worked-solution "First, we must find the elements of the sets $A$ and $B.$\n\n- The elements of the set $A$ are all the natural numbers that satisfy the inequality $n-2\\ge 4,$ that is to say, $n\\ge 6.$ So, we have\n\n$$\nA={6,7,8,9,10,11,…}.\n$$\n\n- On the other hand, the elements of the set $B$ are all integers that satisfy the inequality $n+2\\ge 5,$ That is to say, $n\\ge 3.$ So, we have\n\n$$\nB={3,4,5,6,7,8,…}.\n$$\n\nNow, let's inspect the given statements.\n\n- $A⊆B$ is true. Every element in the set $A$ is an element of the set $B.$\n\n- $B⊆A$ is false. For example, $3\\in B$ but $3\\notin A.$\n\n- $∅⊆A$ is true. The null set $∅={}$ is a subset of *every* set.\n\n- $B⊇A$ is equivalent to $A⊆B,$ which is true.\n\nTherefore, the correct answer is \"I, III, and IV only.\""} {:db/id #edb/ref 17592186240976 :knowledge-point/_questions [{:db/id #edb/ref 17592186054632 :knowledge-point/id #uuid "495f3da0-849a-589d-ac88-26d6825445e4" :knowledge-point/title "Identifying True Statements About Subsets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4050aada-7658-541f-be9b-3f3781195813" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186238610} {:answer/id #uuid "645d28d3-fe8f-52fc-842b-4f5ec36cb5fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186238935} {:answer/id #uuid "79bab5cd-3fc0-5a56-a4aa-07edf3fa9de1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186239104} {:answer/id #uuid "c4b76ccb-502a-51ef-89b3-83e8999e2f40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III and IV only" :db/id #edb/ref 17592186239787} {:answer/id #uuid "cc9bae77-3654-5d37-a473-0b619ae82373" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186239845}] :answer-field/correct {:answer/id #uuid "4050aada-7658-541f-be9b-3f3781195813" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186238610} :answer-field/id #uuid "52ecb4b5-78e4-53b4-9866-6cccc44f6d8a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240484}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e6954872-228a-577f-9a57-37ed3b0eaeb9" :question/math-academy-id "q-105065" :question/problem "Which of the following statements are true for the sets $A={x\\in Z∣x\\le 5}$ and $B={x\\in Z∣-7\\le x<3}?$\n\n- $A⊆B$\n- $B⊆A$\n- $B⊈A$\n- $A⊇B$" :question/worked-solution "First, we must find the elements of the sets $A$ and $B.$\n\n- The elements of the set $A$ are all the integer numbers that satisfy the inequality $x\\le 5.$ So, we have\n\n$$\nA={…,-2,-1,0,1,2,3,4,5}.\n$$\n\n- On the other hand, the elements of the set $B$ are all integers that satisfy the inequality $-7\\le x<3.$ So, we have\n\n$$\nB={-7,-6,-5,-4,-3,-2,-1,0,1,2}.\n$$\n\nNow, let's inspect the given statements.\n\n- $A⊆B$ is false.  For example, $5\\in A$ but $5\\notin B.$\n\n- $B⊆A$ is true, while $B⊈A$ is false. Every element in the set $B$ is an element of the set $A.$\n\n- $A⊇B$ is equivalent to $B⊆A,$ which is true.\n\nTherefore, the correct answer is \"II and IV only\"."} {:db/id #edb/ref 17592186241002 :knowledge-point/_questions [{:db/id #edb/ref 17592186192764 :knowledge-point/id #uuid "f3149834-ef92-5016-a84a-40b207fee519" :knowledge-point/title "Identifying Open and Closed Sets of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45cf46ae-7ac3-5317-bbdc-59a8d2c3134f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186238660} {:answer/id #uuid "4be480e9-1033-5f15-93fd-97dabf788f9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186238711} {:answer/id #uuid "74f2ae8b-d239-56ad-8aee-0e5b12bd1a4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186239064} {:answer/id #uuid "e7eb7a8f-1eab-5fac-999b-e4bd835abe06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186240096} {:answer/id #uuid "fc2c9a5e-c49a-55d1-8d3e-466d43bfc387" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186240285}] :answer-field/correct {:answer/id #uuid "74f2ae8b-d239-56ad-8aee-0e5b12bd1a4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186239064} :answer-field/id #uuid "675d0284-04b8-5632-9324-32b7de5611a7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240521}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1b64d31c-86a0-5b85-a7b4-c7e3f17987a9" :question/math-academy-id "q-105185" :question/problem "Which of the following sets are closed?\n\n- $[4,8]\\cup [10,12]$\n- $[0,5)$\n- $[1,3)\\cup (3,7]$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nAmong the given sets, only $[4,8]\\cup [10,12]$ is closed. It consists of two parts, where the boundary points are $4,8,10,$ and $12.$ All of them lie in the set.\n\nThe other sets are not closed because:\n\n- $[0,5)$ has a boundary point $5$, which does not lie in the set.\n\n- $[1,3)\\cup (3,7]$ has a boundary point $3$, which does not lie in the set.\n\nTherefore, the correct answer is \"I only\"."} {:db/id #edb/ref 17592186241009 :knowledge-point/_questions [{:db/id #edb/ref 17592186192764 :knowledge-point/id #uuid "f3149834-ef92-5016-a84a-40b207fee519" :knowledge-point/title "Identifying Open and Closed Sets of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cc58857-3fe7-5b1e-aca2-862dbb9049f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186238296} {:answer/id #uuid "3846be6a-cbb8-5191-973d-4c321c668e22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186238542} {:answer/id #uuid "a29c4d18-5979-5cb1-80e5-60da0a4c9c73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186239469} {:answer/id #uuid "bba965c7-3ef7-5aae-8c12-6eeea8c3566d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186239689} {:answer/id #uuid "ee9120a6-6030-568f-8c33-86d99ef0e79f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186240157}] :answer-field/correct {:answer/id #uuid "bba965c7-3ef7-5aae-8c12-6eeea8c3566d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186239689} :answer-field/id #uuid "7b499b89-6e24-5bf1-9216-b345c089c753" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240552}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "381adff8-b5e3-59f1-b958-b7182ed98215" :question/math-academy-id "q-105201" :question/problem "Which of the following sets are open?\n\n- $(2,5)$\n- $(-3,0)\\cup (2,7)$\n- $(-2,2)\\cup (4,10]$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nAmong the given sets, only $(2,5)$ and $(-3,0)\\cup (2,7)$ are open because:\n\n- The boundary points of the set $(2,5)$ are $2$, and $5.$ None of them lie in the set.\n\n- The boundary points of the set  $(-3,0)\\cup (2,7)$ are $-3$, $0$, $2$, and $7.$ None of them lie in the set.\n\nThe other set is not open because $(-2,2)\\cup (4,10]$ has four boundary points $-2$, $2$, $4$, and $10$, and the point $10$ lies in the set.\n\nTherefore, the correct answer is \"I and II only\"."} {:db/id #edb/ref 17592186241031 :knowledge-point/_questions [{:db/id #edb/ref 17592186119925 :knowledge-point/id #uuid "52a45814-d1e2-5948-b7bd-69dcaf6cd0eb" :knowledge-point/title "Identifying Linearly Independent and Dependent Sets Using Row Reduction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f6b3754-c8d5-5b37-8d18-ef83f5e9749c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186238185} {:answer/id #uuid "27e14937-1c82-559e-a37e-1b482fa437f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186238401} {:answer/id #uuid "366bc6b5-4bab-5ba8-8018-c4bc7223b115" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186238525} {:answer/id #uuid "69582467-05df-57a2-b597-530abbc3877d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186238970} {:answer/id #uuid "93d981b6-c7f1-52e4-a22e-60dd625357db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186239333}] :answer-field/correct {:answer/id #uuid "27e14937-1c82-559e-a37e-1b482fa437f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186238401} :answer-field/id #uuid "b17fe9cc-10a6-5ca0-8dc9-5ed726aaaab2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240642}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c05cb83d-c779-50b1-a772-7d4551eea239" :question/math-academy-id "q-105308" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 3 \\\\ -4\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}3 \\\\ 10 \\\\ -12\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}4 \\\\ 8 \\\\ -16\\end{aligned}].\n$$\n\n \n\nAssume that ${x}_{1},{x}_{2},$ and ${x}_{3}$ are real numbers. Which of the following statements are true?\n\n- The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has only the trivial solution ${x}_{1}={x}_{2}={x}_{3}=0.$\n- The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent.\n- The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent." :question/worked-solution "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system\n\n$$\n{\\begin{aligned}{x}_{1}+3{x}_{2}+4{x}_{3}=0 \\\\ 3{x}_{1}+10{x}_{2}+8{x}_{3}=0 \\\\ -4{x}_{1}-12{x}_{2}-16{x}_{3}=0.\\end{aligned}\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 3 & 4 & 0 \\\\ 3 & 10 & 8 & 0 \\\\ -4 & -12 & -16 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 4 & 0 \\\\ 0 & 1 & -4 & 0 \\\\ -4 & -12 & -16 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 4 & 0 \\\\ 0 & 1 & -4 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nFrom the matrix above, we conclude that the basic variables are ${x}_{1}$ and ${x}_{2}$, while ${x}_{3}$ is the free variable. \n\nSince there is one free variable, the equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has an infinite number of nonzero solutions, which means that the vectors are linearly dependent. \n\nTherefore, statements I and III are false, while statement II is true."} {:db/id #edb/ref 17592186241033 :knowledge-point/_questions [{:db/id #edb/ref 17592186119925 :knowledge-point/id #uuid "52a45814-d1e2-5948-b7bd-69dcaf6cd0eb" :knowledge-point/title "Identifying Linearly Independent and Dependent Sets Using Row Reduction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "430d277a-8ae9-5f5c-b444-1e030f7d4b85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186238638} {:answer/id #uuid "b3ee60d9-cc92-5ae5-8f48-faec6aa345f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186239628} {:answer/id #uuid "b53ef7a2-cefd-53e6-9d85-717e63e61041" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186239638} {:answer/id #uuid "d9d27227-465c-53c2-ba01-b2b6e324387d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186239956} {:answer/id #uuid "f2066ce9-514d-5cb7-945c-0ead2cf3ec28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186240190}] :answer-field/correct {:answer/id #uuid "430d277a-8ae9-5f5c-b444-1e030f7d4b85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186238638} :answer-field/id #uuid "a4ca901c-c56f-5777-a1c4-6a7cf44555ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240625}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "af32236d-520e-5b71-b7ec-9663a181498c" :question/math-academy-id "q-105310" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=[\\begin{aligned}2 \\\\ 4 \\\\ -2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}7 \\\\ 15 \\\\ -7\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}-1 \\\\ -4 \\\\ 1\\end{aligned}].\n$$\n\n \n\nAssume that ${x}_{1},{x}_{2},$ and ${x}_{3}$ are real numbers. Which of the following statements are true?\n\n- The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$  has an infinite number of nonzero solutions.\n- The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent.\n- The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent." :question/worked-solution "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system \n\n$$\n{\\begin{aligned}2{x}_{1}+7{x}_{2}-{x}_{3}=0 \\\\ 4{x}_{1}+15{x}_{2}-4{x}_{3}=0 \\\\ -2{x}_{1}-7{x}_{2}+{x}_{3}=0.\\end{aligned}\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & 7 & -1 & 0 \\\\ 4 & 15 & -4 & 0 \\\\ -2 & -7 & 1 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}2 & 7 & -1 & 0 \\\\ 0 & 1 & -2 & 0 \\\\ -2 & -7 & 1 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+{R}_{1} \\\\  & ∼[\\begin{aligned}2 & 7 & -1 & 0 \\\\ 0 & 1 & -2 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nFrom the matrix above, we conclude that the basic variables are ${x}_{1}$ and ${x}_{2}$, while ${x}_{3}$ is the free variable. \n\nSince there is one free variable, the equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has an infinite number of nonzero solutions, which means that the vectors are linearly dependent. \n\nTherefore, statement III is false, while statements I and II are true."} {:db/id #edb/ref 17592186241034 :knowledge-point/_questions [{:db/id #edb/ref 17592186124634 :knowledge-point/id #uuid "69b456ea-44de-59f0-b2c8-bc5b9495974f" :knowledge-point/title "Identifying True Statements From a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b48d910-1be1-5d23-a2ba-8175b3f69b3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186238570} {:answer/id #uuid "4f96938b-2f45-5e8e-913e-e02b5150f720" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186238739} {:answer/id #uuid "9d293d5c-cf23-5ad0-89e5-76d21b5e6bba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186239423} {:answer/id #uuid "c59cda50-97a1-5b37-b995-799473fe2d03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186239794} {:answer/id #uuid "d386a6dc-198b-540b-8225-c439558f12d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186239912}] :answer-field/correct {:answer/id #uuid "3b48d910-1be1-5d23-a2ba-8175b3f69b3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186238570} :answer-field/id #uuid "cac869e6-3c0c-539b-bb0d-0f4f123c54b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240685}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f59eef5f-b761-5dcb-b049-d0c57f2862dd" :question/math-academy-id "q-105313" :question/problem "![](images/da/da3040b284606927a6653bfe18697bff0032dea2647d8d36d857c97472bbc540.png)\n\nConsider the set $M,$ depicted by the shaded region above. Which of the following statements are true?\n\n- $A$ is an interior point of the set $M$\n- $B$ is an interior point of the set $M$\n- $C$ is a boundary point of the set $M$" :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nWith that in mind, let's examine the statements in turn.\n\n$$\n\n$$\n\n![](images/c1/c1491f04d1e3d4692dc362008b13ff3909e7ae6f554a5032a9a93036ee2452b5.png)\n\n$$\n\n$$\n\n- Statement I is true. Indeed, $A$ is an interior point since there exists an open neighborhood of $A$ that is fully contained inside the set $M.$\n\n- Statement II is false. Every open neighborhood of $B$ contains points that belong to $M$ and points that do not belong to $M.$ The point $B$ is a boundary point for the given set.\n\n- Statement III is true. The point $C$ is a boundary point because every open neighborhood of $C$ contains points that belong to $M$ and points that do not belong to $M.$\n\nTherefore, the correct answer is 'I and III only'."} {:db/id #edb/ref 17592186241036 :knowledge-point/_questions [{:db/id #edb/ref 17592186119925 :knowledge-point/id #uuid "52a45814-d1e2-5948-b7bd-69dcaf6cd0eb" :knowledge-point/title "Identifying Linearly Independent and Dependent Sets Using Row Reduction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d87b39f-38fd-5072-8df9-199dc3e0354b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186239142} {:answer/id #uuid "9363b93b-17ff-5622-aad6-e074a8b8cff9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186239327} {:answer/id #uuid "9a31168b-c0d9-57f7-abbb-5a6d79071e4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186239395} {:answer/id #uuid "de1e8102-fb34-585a-b310-16891b8d4acb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186239996} {:answer/id #uuid "e66fc050-4e7a-5846-932f-1446097346fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186240079}] :answer-field/correct {:answer/id #uuid "de1e8102-fb34-585a-b310-16891b8d4acb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186239996} :answer-field/id #uuid "2020bb5b-ccfc-53a2-812c-aa951625fd94" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240383}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e39d7a95-6796-5061-a2aa-706f3f881251" :question/math-academy-id "q-105315" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=[\\begin{aligned}-3 \\\\ 9 \\\\ 0\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}2 \\\\ -5 \\\\ -2\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}5 \\\\ -12 \\\\ -4\\end{aligned}].\n$$\n\n \n\nAssume that ${x}_{1},{x}_{2},$ and ${x}_{3}$ are real numbers. Which of the following statements are true?\n\n- The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent.\n- The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent.\n- The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has only the trivial solution ${x}_{1}={x}_{2}={x}_{3}=0.$" :question/worked-solution "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system \n\n$$\n{\\begin{aligned}-3{x}_{1}+2{x}_{2}+5{x}_{3}=0 \\\\ 9{x}_{1}-5{x}_{2}-12{x}_{3}=0 \\\\ -2{x}_{2}-4{x}_{3}=0.\\end{aligned}\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-3 & 2 & 5 & 0 \\\\ 9 & -5 & -12 & 0 \\\\ 0 & -2 & -4 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}-3 & 2 & 5 & 0 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & -2 & -4 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼[\\begin{aligned}-3 & 2 & 5 & 0 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & 0 & 2 & 0\\end{aligned}]\\end{aligned}\n$$\n\nSo, the system is now\n\n$$\n{\\begin{aligned}-3{x}_{1}+2{x}_{2}+5{x}_{3}=0 \\\\ {x}_{2}+3{x}_{3}=0 \\\\ 2{x}_{3}=0.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=0.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}+3(0)=0\\,⟹\\,{x}_{2}=0\n$$\n\nand, substituting this into the first equation, we obtain\n\n$$\n-3{x}_{1}+2(0)+5(0)=0\\,⟹\\,{x}_{1}=0.\n$$\n\nSince ${x}_{1}={x}_{2}={x}_{3}=0$, we get that the set ${{a}_{1},{a}_{2},{a}_{3}}$ is linearly independent.\n\nTherefore, statements II and III are true, while statement I is false."} {:db/id #edb/ref 17592186241038 :knowledge-point/_questions [{:db/id #edb/ref 17592186119925 :knowledge-point/id #uuid "52a45814-d1e2-5948-b7bd-69dcaf6cd0eb" :knowledge-point/title "Identifying Linearly Independent and Dependent Sets Using Row Reduction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49f4c6f1-939a-5b88-9bf3-a8adf2ea2c3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186238698} {:answer/id #uuid "572c908c-7588-5745-b1fb-06f0deaa26f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186238807} {:answer/id #uuid "9ef98273-4408-5085-9187-33c5ddd46ea3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186239443} {:answer/id #uuid "c13e9a64-4df3-5744-803e-cb874d004f59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186239746} {:answer/id #uuid "fa77997b-23f4-5dcb-b0af-e29180f4d714" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186240269}] :answer-field/correct {:answer/id #uuid "9ef98273-4408-5085-9187-33c5ddd46ea3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186239443} :answer-field/id #uuid "b6f9d469-87fe-56b1-97f4-7fe1b4596a1c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240649}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "81d16fc8-2819-579f-80e6-748f22f14098" :question/math-academy-id "q-105319" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=[\\begin{aligned}-2 \\\\ 8 \\\\ -6\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}4 \\\\ -15 \\\\ 12\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}-4 \\\\ 20 \\\\ -7\\end{aligned}].\n$$\n\n \n\nAssume that ${x}_{1},{x}_{2},$ and ${x}_{3}$ are real numbers. Which of the following statements are true?\n\n- The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent.\n- The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has only the trivial solution ${x}_{1}={x}_{2}={x}_{3}=0.$\n- The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent." :question/worked-solution "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system \n\n$$\n{\\begin{aligned}-2{x}_{1}+4{x}_{2}-4{x}_{3}=0 \\\\ 8{x}_{1}-15{x}_{2}+20{x}_{3}=0 \\\\ -6{x}_{1}+12{x}_{2}-7{x}_{3}=0.\\end{aligned}\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-2 & 4 & -4 & 0 \\\\ 8 & -15 & 20 & 0 \\\\ -6 & 12 & -7 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼[\\begin{aligned}-2 & 4 & -4 & 0 \\\\ 0 & 1 & 4 & 0 \\\\ -6 & 12 & -7 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}-2 & 4 & -4 & 0 \\\\ 0 & 1 & 4 & 0 \\\\ 0 & 0 & 5 & 0\\end{aligned}]\\end{aligned}\n$$\n\nSo, the system is now\n\n$$\n{\\begin{aligned}-2{x}_{1}+4{x}_{2}-4{x}_{3}=0 \\\\ {x}_{2}+4{x}_{3}=0 \\\\ 5{x}_{3}=0.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=0.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}+4(0)=0\\,⟹\\,{x}_{2}=0\n$$\n\nand, substituting this into the first equation, we obtain\n\n$$\n-2{x}_{1}+4(0)-4(0)=0\\,⟹\\,{x}_{1}=0.\n$$\n\nSince ${x}_{1}={x}_{2}={x}_{3}=0$, we get that the set ${{a}_{1},{a}_{2},{a}_{3}}$ is linearly independent.\n\nTherefore, statements I and II are true, while statement III is false."} {:db/id #edb/ref 17592186241040 :knowledge-point/_questions [{:db/id #edb/ref 17592186124642 :knowledge-point/id #uuid "24b9af85-3717-59e0-aa72-d701f3c6b6a8" :knowledge-point/title "Identifying Interior and Boundary Points From Nonlinear Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48ea8503-592e-5da9-bf94-dbf1c1894619" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186238691} {:answer/id #uuid "4d3cb585-f127-5930-9e3b-7bcca744902f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186238718} {:answer/id #uuid "a7b5c69f-96d8-52e0-a849-ceb99bf9c83b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186239510} {:answer/id #uuid "d8eef8cf-fdfa-56b9-be1c-3b3a679c443b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186239949} {:answer/id #uuid "e723e2bb-2b91-51b6-b191-0ff5b0c1e575" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186240089}] :answer-field/correct {:answer/id #uuid "a7b5c69f-96d8-52e0-a849-ceb99bf9c83b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186239510} :answer-field/id #uuid "01b2343f-c078-5f49-8bf2-efe62f09b44b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240330}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2c2c7d13-747e-5ac0-bf88-b6f7f16d61aa" :question/math-academy-id "q-105334" :question/problem "The set $A$ and its boundary $∂A$ are given by\n\n$$\nA={(x,y)\\in {R}^{2}:{x}^{2}+{y}^{2}>4},\\,∂A={(x,y)\\in {R}^{2}:{x}^{2}+{y}^{2}=4}.\n$$\n\nWhich of the following statements are true?\n\n- The point $P(-\\sqrt{2},\\sqrt{2})$ belongs to $A$\n- The point $P(-\\sqrt{2},\\sqrt{2})$ is a boundary point of $A$\n- The point $Q(2,2)$ is an interior point of $A$" :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nNow, the set $A$ consists of all points that lie outside the circle ${x}^{2}+{y}^{2}=4.$ A sketch of this region is shown below:\n\n![](images/a1/a1371f9abdeae5083171f5ddfa5d3e237b7e223ba2ba5cf8a822322c34a4676c.png)\n\n \n\nLet's add the points $P(-\\sqrt{2},\\sqrt{2})$ and $Q(2,2)$ and some neighborhoods of these points to our diagram.\n\n![](images/02/021ebd260ca399ee47bf8268d02a1a05019d63eef8ab2f5facc56f8576195a80.png)\n\nLet's examine the statements in turn.\n\n- Statement I is false. The coordinates of $P(-\\sqrt{2},\\sqrt{2})$ do not satisfy the inequality ${x}^{2}+{y}^{2}>4.$ Hence, $P$ does not lie in the set $A.$\n\n- Statement II is true. The coordinates of $P(-\\sqrt{2},\\sqrt{2})$ satisfy the equation ${x}^{2}+{y}^{2}=4.$ Hence, $P$ lies in the set $∂A,$ the boundary of $A.$\n\n- Statement III is true. Indeed, $Q$ is an interior point since there exists an open neighborhood of $Q$ that is fully contained inside the set $A.$\n\nTherefore, the correct answer is 'II and III only'."} {:db/id #edb/ref 17592186241042 :knowledge-point/_questions [{:db/id #edb/ref 17592186124642 :knowledge-point/id #uuid "24b9af85-3717-59e0-aa72-d701f3c6b6a8" :knowledge-point/title "Identifying Interior and Boundary Points From Nonlinear Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "438dc9b9-4b4c-5c7c-8f1f-ef06b777ccee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186238640} {:answer/id #uuid "863a21f0-1bc2-56d2-9c36-a6fabc7dd44a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186239223} {:answer/id #uuid "990a09cd-f697-5ab6-845b-769bca59df37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186239385} {:answer/id #uuid "ccf99d1d-2ca4-5a96-93f3-6bba5cba0073" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186239849} {:answer/id #uuid "dafd1bdc-8b8a-5ac7-a122-fcacd9a19c9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186239965}] :answer-field/correct {:answer/id #uuid "dafd1bdc-8b8a-5ac7-a122-fcacd9a19c9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186239965} :answer-field/id #uuid "954844d7-9a40-5243-995c-752e01be8ec1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240590}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "26f835f8-28cf-54e5-acfe-863ecc606ff1" :question/math-academy-id "q-105357" :question/problem "The set $A$ and its boundary $∂A$ are given by\n\n$$\nA={(x,y)\\in {R}^{2}:{x}^{2}+{y}^{2}\\ge 9},\\,∂A={(x,y)\\in {R}^{2}:{x}^{2}+{y}^{2}=9}.\n$$\n\nWhich of the following statements are true?\n\n- The point $P(3,0)$ lies on the boundary of $A$\n- The point $P(3,0)$ belongs to $A$\n- The point $Q(0,2)$ is an interior point of $A$" :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nNow, the set $A$ consists of all points that lie on or outside the circle ${x}^{2}+{y}^{2}=9.$ A sketch of this region is shown below:\n\n![](images/b9/b9b92085d112ab87592aa8c4d6a56aa4a61ea859d560bac316ce8c97a0af20e5.png)\n\nLet's add the points $P(3,0)$ and $Q(0,2)$ and some neighborhoods of these points to our diagram.\n\n![](images/27/27806c9bb67b60d52cfbae8e881d307d71a3a5fb9465f36d978035f74d78f4bc.png)\n\nLet's examine the statements in turn.\n\n- Statement I is true. The coordinates of $P(3,0)$ satisfy the equation ${x}^{2}+{y}^{2}=9.$ Hence, $P$ lies in the set $∂A,$ the boundary of $A.$\n\n- Statement II is true. The coordinates of $P(3,0)$ satisfy the inequality ${x}^{2}+{y}^{2}\\ge 9.$ Hence, $P$ lies in the set $A.$\n\n- Statement III is false. The point $Q$ is *not* an interior point of $A$ since any neighborhood of $Q$ contains at least one point *outside* the set.\n\nTherefore, the correct answer is 'I and II only'."} {:db/id #edb/ref 17592186241043 :knowledge-point/_questions [{:db/id #edb/ref 17592186124642 :knowledge-point/id #uuid "24b9af85-3717-59e0-aa72-d701f3c6b6a8" :knowledge-point/title "Identifying Interior and Boundary Points From Nonlinear Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "220d3b6e-16be-5d03-8218-f5badf84607c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186238352} {:answer/id #uuid "38f9139a-fc27-571a-b253-0ced64754412" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186238547} {:answer/id #uuid "8ea25008-a389-52eb-b71d-5d28d07da799" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186239294} {:answer/id #uuid "953f2088-4959-5da7-870c-162bf4221448" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186239347} {:answer/id #uuid "fb9414f6-0aee-551b-8d5f-6308c06b3b35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186240279}] :answer-field/correct {:answer/id #uuid "38f9139a-fc27-571a-b253-0ced64754412" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186238547} :answer-field/id #uuid "e850dda3-900d-5f07-872b-367021ae60ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240737}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f57db6a6-9edb-5f0f-98dd-62f31492deff" :question/math-academy-id "q-105365" :question/problem "The set $B$ and its boundary $∂B$ are given by\n\n$$\nB={(x,y)\\in {R}^{2}\\,:\\,\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{4}<12},\\,∂B={(x,y)\\in {R}^{2}:\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{4}=12}.\n$$\n\nWhich of the following statements are true?\n\n- The point $P(3,4)$ lies on the boundary of $B$\n- The point $P(3,4)$ belongs to $B$\n- The point $Q(-3,6)$ is an interior point of $B$" :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nNow, the set $B$ consists of all points that lie inside the ellipse $\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{4}=12.$ A sketch of this region is shown below:\n\n![](images/ad/adee860d39b4d9c4511db2b2f1ad6e7f46342cc474da47303af742be1cc911b3.png)\n\nLet's add the points $P(3,4)$ and $Q(-3,6)$ and some neighborhoods of these points to our diagram.\n\n![](images/21/2185e7129cd799eb1cbb888789566a406b1594dd5a649b9129bec491a1dce1c7.png)\n\nLet's examine the statements in turn.\n\n- Statement I is false. The coordinates of $P(3,4)$ does not satisfy the equation $\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{4}=12.$ Hence, $P$ does not lie on the boundary of $B.$\n\n- Statement II is true. The coordinates of $P(3,4)$ satisfy the inequality $\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{4}<12.$ Hence, $P$ lies in the set $B.$\n\n- Statement III is false. Every open neighborhood of $Q$ contains points that belong to $B$ and points that do not belong to $B.$ The point $Q$ is a boundary point for the given set.\n\nTherefore, the correct answer is 'II only'."} {:db/id #edb/ref 17592186241050 :knowledge-point/_questions [{:db/id #edb/ref 17592186078487 :knowledge-point/id #uuid "f00fd821-a5d4-5844-9db5-795b9e321b94" :knowledge-point/title "Identifying the Largest Intervals of Continuity of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "747c8fc6-6e9a-5b60-b604-7281dce8c56e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186239056} {:answer/id #uuid "8c90093b-19b8-5417-aeb2-bbc789498a15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function is not continuous on any of the given intervals" :db/id #edb/ref 17592186239275} {:answer/id #uuid "9d6bd9a8-47bc-5edb-a6ae-7e3f9bc43d74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186239426} {:answer/id #uuid "c58e8a76-476d-5dce-b766-bb62881acce7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186239791} {:answer/id #uuid "fe04c3e9-305c-597e-ba50-6c48b51ed202" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186240300}] :answer-field/correct {:answer/id #uuid "fe04c3e9-305c-597e-ba50-6c48b51ed202" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186240300} :answer-field/id #uuid "ab373270-0834-54ff-abd6-41fd79b9c46e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240628}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bef182d0-f2c3-5147-8c82-4dead855f78c" :question/math-academy-id "q-105418" :question/problem "![](images/b8/b875f560c133e528e4d934ae2722d14c116fac4352f6cca5089f8ec726fe3660.png)\n\nConsider the function $y=f(x)$ above. On which of the following intervals is the function continuous? \n\n- $x\\in (-\\infty ,-2]$\n- $x\\in [-2,4]$\n- $x\\in [4,\\infty )$\n\nYou may assume that all points of discontinuity of $f(x)$ are shown in the diagram." :question/worked-solution "Let's examine each statement.\n\n- The function is *not* continuous on $(-\\infty ,-2].$ Although the function is continuous on $(-\\infty ,-2),$ it is not left-continuous at $x=-2.$\n\n- The function is continuous on $[-2,4].$ It is continuous on $(-2,4),$ and also right-continuous at $x=-2$ and left-continuous at $x=4.$\n\n- The function is *not* continuous on $[4,\\infty ).$ Although the function is continuous on $(4,\\infty ),$ it is not right-continuous at $x=4.$\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186241051 :knowledge-point/_questions [{:db/id #edb/ref 17592186078487 :knowledge-point/id #uuid "f00fd821-a5d4-5844-9db5-795b9e321b94" :knowledge-point/title "Identifying the Largest Intervals of Continuity of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ee875e9-69d4-5f74-a732-e4092d2c4c17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function is not continuous on any of the given intervals" :db/id #edb/ref 17592186238183} {:answer/id #uuid "1678d7e3-df64-50e4-b5a4-53baf2e801e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186238246} {:answer/id #uuid "1ef618cf-a652-592c-973c-2dbc91a46064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186238316} {:answer/id #uuid "53f65ae1-9a0f-55c6-b974-fcca16e65043" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186238776} {:answer/id #uuid "de4aeb51-8235-5a8d-8784-60a43d579469" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186239999}] :answer-field/correct {:answer/id #uuid "1ef618cf-a652-592c-973c-2dbc91a46064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186238316} :answer-field/id #uuid "2b47eef7-4f83-58c2-bd15-d3e9a5deaf72" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240408}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fe40ba69-5c80-5288-8a8c-e5c1e0d1d354" :question/math-academy-id "q-105419" :question/problem "![](images/c7/c75313fbb97784b27ea0c57068e7221e0f9416ac4857b70723fd7ca949d9aba7.png)\n\nConsider the function $y=f(x)$ above. On which of the following intervals is the function continuous? \n\n- $x\\in (-\\infty ,-3]$\n- $x\\in (-\\infty ,0)$\n- $x\\in [-3,\\infty )$\n\nYou may assume that all points of discontinuity of $f(x)$ are shown in the diagram." :question/worked-solution "Let's examine each statement.\n\n- The function is continuous on $(-\\infty ,-3].$ It is continuous on $(-\\infty ,-3)$ and also left-continuous at $x=-3.$\n\n- The function is *not* continuous on $(-\\infty ,0)$ because it contains a discontinuity at $x=-3.$\n\n- The function is *not* continuous on $[-3,\\infty ).$ Although the function is continuous on $(-3,\\infty ),$ it is not right-continuous at $x=-3.$\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186241052 :knowledge-point/_questions [{:db/id #edb/ref 17592186192765 :knowledge-point/id #uuid "5c6044dc-d4a7-5662-a825-3c13e49d198a" :knowledge-point/title "Identifying Sets That are Neither Open Nor Closed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c35cf7d-189d-5e46-a00b-db99a9bde594" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186238451} {:answer/id #uuid "5aad6ba5-21ad-5320-9631-ff6114bb778b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186238839} {:answer/id #uuid "8cc8c422-e61a-5a53-8bb3-f3b05c4635db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186239278} {:answer/id #uuid "9e4d8042-5e0a-532c-ac2a-02fc106eca4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186239439} {:answer/id #uuid "c32596e5-97d7-59a6-bffa-b50a5021b1b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186239774}] :answer-field/correct {:answer/id #uuid "5aad6ba5-21ad-5320-9631-ff6114bb778b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186238839} :answer-field/id #uuid "9b552fa6-d519-554f-9bab-7c52ee9b3142" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240603}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d9f390fe-da40-537a-ae87-c6dfb93153a6" :question/math-academy-id "q-105423" :question/problem "Which of the following sets are neither open nor closed?\n\n- ${(x,y)\\in {R}^{2}\\,:\\,-1\\le x\\le 1,\\,0<y\\le {x}^{3}}$\n- ${(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-y<0}$\n- ${(x,y)\\in {R}^{2}\\,:\\,0\\le x\\le 2,\\,-{x}^{4}<y<{x}^{4}}$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(1,1).$ On the other hand, it does not contain some boundary points, for example, the point $(1,0).$\n\n- The second set is *open* since it doesn't contain any point of its boundary (the corresponding inequality is strict).\n\n- The third set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(2,0).$ On the other hand, it does not contain some other boundary points, for example, the point $(2,16).$\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186241054 :knowledge-point/_questions [{:db/id #edb/ref 17592186192765 :knowledge-point/id #uuid "5c6044dc-d4a7-5662-a825-3c13e49d198a" :knowledge-point/title "Identifying Sets That are Neither Open Nor Closed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41e37c6d-8931-5cb2-bc23-b2c99d1188ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186238627} {:answer/id #uuid "53ed240f-0f1d-542b-905b-5b6dfb8ecc38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186238774} {:answer/id #uuid "7f76bc95-401b-5344-ab0d-79b936598539" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186239164} {:answer/id #uuid "920cba7d-d121-5259-97f6-66478e2d1c82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186239319} {:answer/id #uuid "f02ff010-f321-58d4-ac41-82a40f8328cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186240171}] :answer-field/correct {:answer/id #uuid "f02ff010-f321-58d4-ac41-82a40f8328cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186240171} :answer-field/id #uuid "68b90f24-4567-517f-8de2-11b101a1752a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240523}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2d4a59fe-0871-5826-aa72-1fb9c0a2dad6" :question/math-academy-id "q-105431" :question/problem "Which of the following sets are neither open nor closed?\n\n- ${(x,y)\\in {R}^{2}\\,:\\,2\\le x\\le 6,\\,0<{y}^{2}\\le 3}$\n- ${(x,y)\\in {R}^{2}\\,:\\,0<{x}^{2}<9,\\,1<{y}^{2}<16}$\n- ${(x,y)\\in {R}^{2}\\,:\\,0\\le y\\le {x}^{2},\\,-2\\le x\\le 2}$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(2,\\sqrt{3}).$ On the other hand, it does not contain some other boundary points, for example, the point $(2,0).$\n\n- The second set is *open* since it doesn't contain any point of its boundary (all the corresponding inequalities are strict).\n\n- The third set is *closed* since it contains all its boundary points (all the corresponding inequalities are not strict).\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186241058 :knowledge-point/_questions [{:db/id #edb/ref 17592186192765 :knowledge-point/id #uuid "5c6044dc-d4a7-5662-a825-3c13e49d198a" :knowledge-point/title "Identifying Sets That are Neither Open Nor Closed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29822481-181c-5a94-8164-e73214b8adb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186238421} {:answer/id #uuid "8e64fa90-86a1-597b-8501-b89ab9076aca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186239291} {:answer/id #uuid "f21ab020-7d9f-5130-ba9b-ff1b51564901" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186240192} {:answer/id #uuid "f335ecc9-a0a8-57c0-8624-ced2cd07e0e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186240200} {:answer/id #uuid "fd01fd55-3391-5cc1-9a3e-609139a0b3d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186240290}] :answer-field/correct {:answer/id #uuid "f335ecc9-a0a8-57c0-8624-ced2cd07e0e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186240200} :answer-field/id #uuid "b9771e60-5dd2-5d0b-aecd-c604e84eb180" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240656}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9d461bff-0ae1-55fc-a03d-01dfa63c39ec" :question/math-academy-id "q-105437" :question/problem "Which of the following sets are neither open nor closed?\n\n- ${(x,y)\\in {R}^{2}:\\text{ }x+y<4,\\,-1<x<4}$\n- ${(x,y)\\in {R}^{2}:\\text{ }0\\le x<4,\\,2<y\\le 4}$\n- ${(x,y)\\in {R}^{2}:\\text{ }-1\\le x\\le 3,\\,2<y<4}$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *open* since it doesn't contain any point of its boundary (all the corresponding inequalities are strict).\n\n- The second set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(0,3).$ On the other hand, it does not contain some other boundary points, for example, the point $(3,2).$\n\n- The third set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(-1,3).$ On the other hand, it does not contain some other boundary points, for example, the point $(0,2).$\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186241079 :knowledge-point/_questions [{:db/id #edb/ref 17592186133880 :knowledge-point/id #uuid "4f47e201-105a-579a-8cde-fcb6bf8cfa2a" :knowledge-point/title "Interpreting Divergence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07a92cc1-113b-5b68-8eee-53888758e96c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186238139} {:answer/id #uuid "45f98056-476a-56c3-a387-1679af854fe6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186238663} {:answer/id #uuid "e226facb-7893-5854-8a55-7e51661183d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186240043} {:answer/id #uuid "ef23eeaa-e349-5747-9c7d-4d499cf8c5dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186240164} {:answer/id #uuid "fac16b79-d230-552c-b2c9-9227e7ed3b69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186240274}] :answer-field/correct {:answer/id #uuid "ef23eeaa-e349-5747-9c7d-4d499cf8c5dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186240164} :answer-field/id #uuid "cb9b362c-341e-588a-98f7-56e59732034e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240687}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c30bad2f-8979-5b57-acae-23ae1c82d606" :question/math-academy-id "q-105573" :question/problem "![](images/30/3088d088689bbd0dfd33abe8240c6f02cceb257937fc1fccb8ba3df151dbfaab.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\n- $\\text{div}\\,F=0$\n- $\\text{div}\\,F>0$\n- $\\text{div}\\,F<0$\n- $F$ is solenoidal" :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $F$ acts like a source at $P,$ then $∇\\cdot F>0$ at $P.$\n\n- If $F$ acts like a sink at $P,$ then $∇\\cdot F<0$ at $P.$\n\n- If $F$ acts like neither a source nor a sink at $P,$ then $∇\\cdot F=0$ at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement II is true, whereas statements I and III are false. Notice that the lengths of the vector's $y$-components increase as we move vertically away from the $x$-axis. Therefore, the vector field $F$ acts like a source at every point.\n\n- Statement IV is false. Since $∇\\cdot F\\ne 0,$ the vector field $F$ is not solenoidal.\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186241080 :knowledge-point/_questions [{:db/id #edb/ref 17592186133880 :knowledge-point/id #uuid "4f47e201-105a-579a-8cde-fcb6bf8cfa2a" :knowledge-point/title "Interpreting Divergence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "627918cc-4b21-5f54-b208-cb86d8a90fcf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186238922} {:answer/id #uuid "9f41d10b-f851-5d45-9827-61f7b022fc29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186239445} {:answer/id #uuid "d1e51c7e-db29-5f2f-8366-bcfa0cafd1d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186239898} {:answer/id #uuid "dcb49dbb-7200-53b3-81d0-14d6d6fcc22b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186239981} {:answer/id #uuid "e21e0841-2d32-541f-bd4e-00d6bca599f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186240041}] :answer-field/correct {:answer/id #uuid "9f41d10b-f851-5d45-9827-61f7b022fc29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186239445} :answer-field/id #uuid "116238d5-19f2-50cb-9748-dd30cea9d39a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240357}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d2172851-a396-51c3-bd4e-4e1278b37143" :question/math-academy-id "q-105575" :question/problem "![](images/11/11d38951b884f17616a61403d793322d0e2ea28910e806fe8f018251508352a1.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\n- $∇\\cdot F=0$\n- $∇\\cdot F>0$\n- $∇\\cdot F<0$\n- $F$ is solenoidal" :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $F$ acts like a source at $P,$ then $∇\\cdot F>0$ at $P.$\n\n- If $F$ acts like a sink at $P,$ then $∇\\cdot F<0$ at $P.$\n\n- If $F$ acts like neither a source nor a sink at $P,$ then $∇\\cdot F=0$ at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement I is true, whereas statements II and III are false. For any point $P,$ the sum of the inward-pointing vectors equals the sum of the outward-pointing vectors. Therefore, $F$ acts neither like a source nor a sink.\n\n- Statement IV is true. Since $∇\\cdot F=0$ everywhere, the vector field $F$ is solenoidal.\n\nTherefore, the correct answer is \"I and IV only.\""} {:db/id #edb/ref 17592186241081 :knowledge-point/_questions [{:db/id #edb/ref 17592186133880 :knowledge-point/id #uuid "4f47e201-105a-579a-8cde-fcb6bf8cfa2a" :knowledge-point/title "