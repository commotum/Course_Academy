ions [{:db/id #edb/ref 17592186162063 :knowledge-point/id #uuid "38398622-ca45-5eb6-a589-96aec162960a" :knowledge-point/title "Finding the Joint Distribution of Two Discrete Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26f7eb31-6717-55c0-b42b-2e49c8af7ba3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186272730} {:answer/id #uuid "62b903b2-02b4-50f3-b1a1-0aab1f492fae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186273235} {:answer/id #uuid "b3a0bb71-197f-5176-bfed-2c99da1a9204" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186273939} {:answer/id #uuid "b4fdf346-b652-5601-919c-ae184be3a5c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186273958} {:answer/id #uuid "ec18b530-7dbe-5d5a-bf3a-20ae46cbbc74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186274473}] :answer-field/correct {:answer/id #uuid "26f7eb31-6717-55c0-b42b-2e49c8af7ba3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186272730} :answer-field/id #uuid "59d6bbdd-82e4-5cb9-987f-bb953d93ed75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274785}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b48a6d92-bb8d-5520-9846-8b67d6784e46" :question/math-academy-id "q-143869" :question/problem "| $f$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- |\n| $X=1$ | $0.2$ | $0.15$ |\n| $X=2$ | $0.16$ | $-0.1$ |\n| $X=3$ | $0.24$ | $0.35$ |\n\nConsider the function $f(x,y)$ shown in the table above. Which of the following conditions is true?\n\n- $0\\le f(x,y)\\le 1$ for all $(x,y)$ in $S$\n- ${\\sum }_{(x,y)\\in S}f(x,y)=1$\n- $f(x,y)$ is a valid joint probability mass function" :question/worked-solution "Let's check the given conditions:\n\n- Condition I is false. The value of $f(2,2)$ in the table does not satisfy $0\\le f(x,y)\\le 1.$\n\n- Condition II is true. Adding up all the values of $f(x,y)$ shown in the table, we get\n\n$$\n\\begin{aligned}{\\sum }_{(x,y)\\in S}f(x,y) & =0.2+0.15+0.16-0.1+0.24+0.35=1\\,✓\\end{aligned}\n$$\n\n- Condition III is false. Because $f(x,y)$ does not satisfy condition I, it is *not* a valid probability mass function.\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186275179 :knowledge-point/_questions [{:db/id #edb/ref 17592186105893 :knowledge-point/id #uuid "ca93cd65-65e3-521e-a1e3-2721f45fb6a6" :knowledge-point/title "Calculating the Coordinates of an Image Formed by a Singular Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fbf9a16-b41d-5e0d-982a-9b4116d7b25e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186272666} {:answer/id #uuid "7779a031-f0cf-50e0-beae-d512a603da2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186273405} {:answer/id #uuid "785c15f9-6b2f-588e-be26-6edcbac1c3ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186273412} {:answer/id #uuid "882d6e01-b6f1-53ca-8fa3-80e4758780fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186273556} {:answer/id #uuid "de796833-caf3-5dc1-9cf6-b2448a158825" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186274346}] :answer-field/correct {:answer/id #uuid "de796833-caf3-5dc1-9cf6-b2448a158825" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186274346} :answer-field/id #uuid "d5947aea-674a-54d3-b514-a907a48356ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275012}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1d122f7d-248a-5adb-b7f8-d6731998c545" :question/math-academy-id "q-147666" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}3 & -2 \\\\ -6 & 4\\end{aligned}].\n$$\n\nA triangle $S$ has vertices at $(1,3)$, $(-2,0)$ and $(2,-1).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the action of $T?$\n\n- $(8,-16)$\n- $(-6,12)$\n- $(8,16)$" :question/worked-solution "To find the image of $S$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\nX=[\\begin{aligned}1 & -2 & 2 \\\\ 3 & 0 & -1\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}3 & -2 \\\\ -6 & 4\\end{aligned}][\\begin{aligned}1 & -2 & 2 \\\\ 3 & 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & -6 & 8 \\\\ 6 & 12 & -16\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-3,6)$, $(-6,12)$ and $(8,-16).$ \n\nSo, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186275180 :knowledge-point/_questions [{:db/id #edb/ref 17592186105893 :knowledge-point/id #uuid "ca93cd65-65e3-521e-a1e3-2721f45fb6a6" :knowledge-point/title "Calculating the Coordinates of an Image Formed by a Singular Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34cb736e-820b-5e02-a62e-902679d92d0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186272856} {:answer/id #uuid "4da26ecd-6765-5807-9b28-42a06ba51d9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186273037} {:answer/id #uuid "8a5d207f-b418-5c11-b6a0-6885305c462d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186273579} {:answer/id #uuid "902e01d1-3857-5bca-8910-96c51cb33de7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186273640} {:answer/id #uuid "f66a5755-7ccd-5ea9-b832-c0de6bea6857" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186274553}] :answer-field/correct {:answer/id #uuid "902e01d1-3857-5bca-8910-96c51cb33de7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186273640} :answer-field/id #uuid "fd32ee0b-f7f2-5fcc-879b-ac176d9d8123" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275081}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1bd0a07c-db54-5589-8d88-4cb094a8efc3" :question/math-academy-id "q-147667" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}-1 & 5 \\\\ 2 & -10\\end{aligned}].\n$$\n\nA triangle $S$ has vertices at $(1,-1)$, $(1,0)$ and $(-2,1).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the action of $T?$ \n\n- $(-1,2)$\n- $(-3,12)$\n- $(7,-12)$" :question/worked-solution "To find the image of $S$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\nX=[\\begin{aligned}1 & 1 & -2 \\\\ -1 & 0 & 1\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}-1 & 5 \\\\ 2 & -10\\end{aligned}][\\begin{aligned}1 & 1 & -2 \\\\ -1 & 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-6 & -1 & 7 \\\\ 12 & 2 & -14\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-6,12)$, $(-1,2)$ and $(7,-14).$ \n\nSo, the correct answer is \"I  only.\""} {:db/id #edb/ref 17592186275181 :knowledge-point/_questions [{:db/id #edb/ref 17592186105893 :knowledge-point/id #uuid "ca93cd65-65e3-521e-a1e3-2721f45fb6a6" :knowledge-point/title "Calculating the Coordinates of an Image Formed by a Singular Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85a7aee6-c66f-51b4-b82b-65c0708d3229" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186273536} {:answer/id #uuid "8d3f1a32-56a1-5b37-b12f-885c47e7cd18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186273605} {:answer/id #uuid "a94a88f0-4d47-54fd-a8d2-e301e230c06b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186273850} {:answer/id #uuid "ac7dc3a6-ad03-52d2-93e7-71e93aac7b48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186273875} {:answer/id #uuid "f231160e-6f52-5371-9382-e98b5e6d3453" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186274527}] :answer-field/correct {:answer/id #uuid "85a7aee6-c66f-51b4-b82b-65c0708d3229" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186273536} :answer-field/id #uuid "80bb5a32-9078-536d-bd91-fcf6fb2c2f41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274853}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "84cfa7aa-4b60-5511-b592-0b61d5c3575c" :question/math-academy-id "q-147668" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}2 & -4 \\\\ -4 & 8\\end{aligned}].\n$$\n\nA triangle $S$ has vertices at $(1,0)$, $(0,-3)$ and $(-2,1).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the action of $T?$\n\n- $(12,-24)$\n- $(8,16)$\n- $(2,-4)$" :question/worked-solution "To find the image of $S$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\nX=[\\begin{aligned}1 & 0 & -2 \\\\ 0 & -3 & 1\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & -4 \\\\ -4 & 8\\end{aligned}][\\begin{aligned}1 & 0 & -2 \\\\ 0 & -3 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 12 & -8 \\\\ -4 & -24 & 16\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(2,-4)$, $(12,-24)$ and $(-8,16).$ \n\nSo, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186275182 :knowledge-point/_questions [{:db/id #edb/ref 17592186105893 :knowledge-point/id #uuid "ca93cd65-65e3-521e-a1e3-2721f45fb6a6" :knowledge-point/title "Calculating the Coordinates of an Image Formed by a Singular Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f321f61-74c6-5dff-b09d-2abe37e72619" :answer/type {:db/id #edb/ref 1759218604549