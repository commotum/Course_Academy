[{:db/id #edb/ref 17592186265954 :knowledge-point/_questions [{:db/id #edb/ref 17592186152273 :knowledge-point/id #uuid "9a926134-0870-5528-985d-2c92e71158f4" :knowledge-point/title "Identifying Second-Order Linear ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12282991-5937-510a-bdff-d7ac30128549" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186263171} {:answer/id #uuid "2c0b7305-0b03-55d9-991e-9cfb5713d20f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186263372} {:answer/id #uuid "8adeebb0-5776-506d-9b68-6d8789e3d696" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186264189} {:answer/id #uuid "93043e6d-2ca1-5a86-84cc-182840f36d10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186264259} {:answer/id #uuid "e27a4fd6-d94b-508a-9d8f-4bb9ea87b4c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186264966}] :answer-field/correct {:answer/id #uuid "8adeebb0-5776-506d-9b68-6d8789e3d696" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186264189} :answer-field/id #uuid "bf3b59bb-2d4a-5ac7-a84e-d4a1444aae7f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265579}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d7e46e30-10b0-546e-b7af-e3d72616cbd7" :question/math-academy-id "q-130671" :question/problem "Which of the following second-order differential equations are linear?\n\n- $(\\operatorname{ln}⁡x){y}^{″}-x{y}^{′}+y=2$\n- ${y}^{3}{y}^{″}+x{y}^{′}-xy=0$\n- $\\frac{1}{x}{y}^{″}+xy{y}^{′}+{x}^{2}y={e}^{x}$" :question/worked-solution "А second-order linear differential equation has the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nLet's look at each equation in turn.\n\n- The equation\n\n$$\n(\\operatorname{ln}⁡x){y}^{″}-x{y}^{′}+y=2\n$$\n\nis a second-order linear ODE with $a(x)=\\operatorname{ln}⁡x,b(x)=-x,c(x)=1,$ and $f(x)=2.$\n\n- The equation\n\n$$\n{y}^{3}{y}^{″}+x{y}^{′}-xy=0\n$$\n\nis **NOT** linear because it contains the nonlinear term ${y}^{3}{y}^{″}.$\n\n- The equation\n\n$$\n\\frac{1}{x}{y}^{″}+xy{y}^{′}+{x}^{2}y={e}^{x}\n$$\n\nis **NOT** linear because it contains the nonlinear term $xy{y}^{′}.$\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186265955 :knowledge-point/_questions [{:db/id #edb/ref 17592186152273 :knowledge-point/id #uuid "9a926134-0870-5528-985d-2c92e71158f4" :knowledge-point/title "Identifying Second-Order Linear ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72a41b4d-d78b-5859-b216-08e76cdc9e5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186263993} {:answer/id #uuid "8dcea926-a8b9-513b-906e-8d02930cfdb9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186264212} {:answer/id #uuid "9100e9b9-5db5-51d7-aec7-c3e6d66f1b1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186264245} {:answer/id #uuid "dcc056f3-9c03-55f1-8037-6a0aa15d75d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186264924} {:answer/id #uuid "ff09c2f9-a455-50f3-9f76-c7798dac150a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186265242}] :answer-field/correct {:answer/id #uuid "ff09c2f9-a455-50f3-9f76-c7798dac150a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186265242} :answer-field/id #uuid "5b7d4941-b9ea-5f9d-8d62-cdf635c06c45" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265407}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7e471b0b-273f-5999-b584-35af7a25a9a4" :question/math-academy-id "q-130675" :question/problem "Which of the following second-order differential equations are linear?\n\n- ${e}^{2y}{y}^{″}-{x}^{2}{y}^{′}+3=0$\n- ${e}^{x}{y}^{″}+4{y}^{′}-x\\operatorname{sin}⁡x=2$\n- ${y}^{″}-2x{y}^{′}+5y=x$" :question/worked-solution "А second-order linear differential equation has the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nLet's look at each equation in turn.\n\n- The equation\n\n$$\n{e}^{2y}{y}^{″}-{x}^{2}{y}^{′}+3=0\n$$\n\nis **NOT** linear because it contains the nonlinear term ${e}^{2y}{y}^{″}.$\n\n- The equation\n\n$$\n{e}^{x}{y}^{″}+4{y}^{′}-x\\operatorname{sin}⁡x=2\n$$\n\nis a second-order linear ODE with $a(x)={e}^{x},b(x)=4,c(x)=0,$ and $f(x)=2+x\\operatorname{sin}⁡x.$\n\n- The equation\n\n$$\n{y}^{″}-2x{y}^{′}+5y=x\n$$\n\nis a second-order linear ODE with $a(x)=1,b(x)=-2x,c(x)=5,$ and $f(x)=x.$\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186265956 :knowledge-point/_questions [{:db/id #edb/ref 17592186152273 :knowledge-point/id #uuid "9a926134-0870-5528-985d-2c92e71158f4" :knowledge-point/title "Identifying Second-Order Linear ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54dd7239-8155-550f-b323-3bc657f00d81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186263730} {:answer/id #uuid "b5edd95b-6555-529a-9906-5c7341743b02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186264577} {:answer/id #uuid "bcaf4159-003f-5da3-92a9-ac16b66e20c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186264635} {:answer/id #uuid "be92b258-502c-5535-b3e6-22f15c3799c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186264655} {:answer/id #uuid "c8984020-b182-5104-bb63-ecaf05b62a48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186264757}] :answer-field/correct {:answer/id #uuid "be92b258-502c-5535-b3e6-22f15c3799c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186264655} :answer-field/id #uuid "c97171ab-7660-54fa-a8fd-2c48ead3823d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265602}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "66d63369-22c5-5a2f-adb6-cc0d49c2dc04" :question/math-academy-id "q-130677" :question/problem "Which of the following second-order differential equations are linear?\n\n- $2{x}^{2}{y}^{″}-\\operatorname{ln}⁡x\\,{y}^{′}+{y}^{2}=0$\n- $2{y}^{″}+{x}^{3}{y}^{′}+2xy=0$\n- ${y}^{″}+x{y}^{′}=x{e}^{x}$" :question/worked-solution "А second-order linear differential equation has the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nLet's look at each equation in turn.\n\n- The equation\n\n$$\n2{x}^{2}{y}^{″}-\\operatorname{ln}⁡x\\,{y}^{′}+{y}^{2}=0\n$$\n\nis **NOT** linear because it contains the nonlinear term ${y}^{2}.$\n\n- The equation\n\n$$\n2{y}^{″}+{x}^{3}{y}^{′}+2xy=0\n$$\n\nis a second-order linear ODE with $a(x)=2,b(x)={x}^{3},c(x)=2x,$ and $f(x)=0.$\n\n- The equation\n\n$$\n{y}^{″}+x{y}^{′}=x{e}^{x}\n$$\n\nis a second-order linear ODE with $a(x)=1,b(x)=x,c(x)=0,$ and $f(x)=x{e}^{x}.$\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186265973 :knowledge-point/_questions [{:db/id #edb/ref 17592186115243 :knowledge-point/id #uuid "853a04b2-591a-51c2-b80f-73f559355d9f" :knowledge-point/title "Identifying an Elementary 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "777afc62-08b0-5aa7-b0ac-c7b9d427d228" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186264038} {:answer/id #uuid "9be2e810-8183-552f-8417-2844d48d9d79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186264333} {:answer/id #uuid "adf43be7-864c-5837-875b-a182e7de738e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186264495} {:answer/id #uuid "b263a001-df89-53c0-9fa5-978e3c21d771" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186264534} {:answer/id #uuid "d3c7ce0d-eb3c-5340-8250-9dfc0b9bb40c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186264844}] :answer-field/correct {:answer/id #uuid "d3c7ce0d-eb3c-5340-8250-9dfc0b9bb40c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186264844} :answer-field/id #uuid "c91dd783-8508-53eb-87a5-410eec6ed547" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265601}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6ec5e472-dc1d-5891-bb93-866a6d9b3914" :question/math-academy-id "q-130774" :question/problem "Which of the following are elementary matrices?\n\n$$\nA=[\\begin{aligned}1 & 0 \\\\ 1 & 1\\end{aligned}],\\,B=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}],\\,C=[\\begin{aligned}1 & -1 \\\\ 4 & 1\\end{aligned}]\n$$" :question/worked-solution "An elementary matrix is a matrix obtained from the identity matrix by applying exactly one elementary row operation. \n\nWith that in mind, let's examine our matrices.\n\n- The matrix $A$ is an elementary matrix because it can be obtained from ${I}_{2}$ by applying the elementary row operation ${R}_{2}:={R}_{1}+{R}_{2},$ as follows:\n\n$$\n\\begin{aligned}{I}_{2} & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] &  & {R}_{1}:={R}_{1}+{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 1 & 1\\end{aligned}] \\\\  & =A\\end{aligned}\n$$\n\n- The matrix $B$ is an elementary matrix because it can be obtained from ${I}_{2}$ by applying the elementary row operation ${R}_{1}↔{R}_{2},$ as follows:\n\n$$\n\\begin{aligned}{I}_{2} & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] &  & {R}_{1}↔{R}_{2} \\\\  & ∼[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}] \\\\  & =B\\end{aligned}\n$$\n\n- The matrix $C$ is not an elementary matrix because it can't be obtained from ${I}_{2}$ by applying only one elementary row operation.\n\nTherefore, only $A$ and $B$ are elementary matrices."} {:db/id #edb/ref 17592186265998 :knowledge-point/_questions [{:db/id #edb/ref 17592186115251 :knowledge-point/id #uuid "77d78574-a17c-5fc3-8c14-3aaec7753b3c" :knowledge-point/title "Transforming a 2x2 Matrix Into the Identity Matrix Using Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27f42791-6076-59d7-9616-c1c6e6600e9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186263347} {:answer/id #uuid "6b0171e5-e789-542f-a5f7-eba1924afa10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186263921} {:answer/id #uuid "83c09255-43ef-5f68-9b54-ce7b76d1d6f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186264131} {:answer/id #uuid "f1261446-d7b5-56d0-983f-d6cc1794f353" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186265118} {:answer/id #uuid "f7a9befa-627b-5dd7-9453-949d4370abbf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186265168}] :answer-field/correct {:answer/id #uuid "6b0171e5-e789-542f-a5f7-eba1924afa10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186263921} :answer-field/id #uuid "0743c94a-34a3-5797-8003-0db16035e4b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265257}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c4fc937e-2b7d-5514-a470-2dba13ab48f1" :question/math-academy-id "q-130868" :question/problem "Which of the following matrices are transformed into the $2\\times 2$ identity matrix after applying the row operations ${R}_{1}↔{R}_{2}\\,$ and $\\,{R}_{2}:={R}_{2}+(-2){R}_{1}?$\n\n$$\nA=[\\begin{aligned}2 & 2 \\\\ 1 & 0\\end{aligned}],\\,B=[\\begin{aligned}2 & 1 \\\\ 1 & 0\\end{aligned}],\\,C=[\\begin{aligned}2 & 1 \\\\ -1 & 0\\end{aligned}]\n$$" :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2 & 2 \\\\ 1 & 0\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 2 & 2\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}] \\\\  & \\ne I,\\,\\times  \\\\ B & =[\\begin{aligned}2 & 1 \\\\ 1 & 0\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =I\\,✓ \\\\ C & =[\\begin{aligned}2 & 1 \\\\ -1 & 0\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}-1 & 0 \\\\ 2 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}-1 & 0 \\\\ 4 & 1\\end{aligned}] \\\\  & \\ne I,\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"."} {:db/id #edb/ref 17592186266016 :knowledge-point/_questions [{:db/id #edb/ref 17592186124477 :knowledge-point/id #uuid "488c9762-554b-5ea6-b414-ce6cbde9bbd1" :knowledge-point/title "Finding the Pivot Columns of a Matrix in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6cff1919-15df-54e6-bba8-9841fbe2ac27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd and $4$th only" :db/id #edb/ref 17592186263941} {:answer/id #uuid "bafa4199-3896-533f-9d37-ed03727c501b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $3$rd only" :db/id #edb/ref 17592186264625} {:answer/id #uuid "c6e2d6f7-c911-53e8-9de8-189f76632186" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "All the columns are pivot" :db/id #edb/ref 17592186264740} {:answer/id #uuid "fbfc9b26-9813-57d5-9dd6-c7876b91e4b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd and $4$th only" :db/id #edb/ref 17592186265206} {:answer/id #uuid "feb72bb5-666e-52a2-a47b-80cc5ea689e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd, $3$rd, and $4$th only" :db/id #edb/ref 17592186265241}] :answer-field/correct {:answer/id #uuid "feb72bb5-666e-52a2-a47b-80cc5ea689e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd, $3$rd, and $4$th only" :db/id #edb/ref 17592186265241} :answer-field/id #uuid "89be5c58-9a7a-51e6-ac4b-f2d7f66ce093" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265488}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1f6871c4-be28-5e5d-8206-8a897c2b233e" :question/math-academy-id "q-130932" :question/problem "The row echelon form matrix $M$ is given below. What are the pivot columns of $M?$\n\n$$\nM=[\\begin{aligned}0 & -3 & 6 & 0 \\\\ 0 & 0 & -2 & 8 \\\\ 0 & 0 & 0 & 1\\end{aligned}]\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $M$ has $3$ pivots in the $2$nd, $3$rd, and $4$th columns:\n\n$$\nM=[\\begin{aligned}0 & -3 & 6 & 0 \\\\ 0 & 0 & -2 & 8 \\\\ 0 & 0 & 0 & 1\\end{aligned}]\n$$"} {:db/id #edb/ref 17592186266017 :knowledge-point/_questions [{:db/id #edb/ref 17592186124477 :knowledge-point/id #uuid "488c9762-554b-5ea6-b414-ce6cbde9bbd1" :knowledge-point/title "Finding the Pivot Columns of a Matrix in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c21634a-9540-5e95-9156-0ffb362dfd3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd and $4$th only" :db/id #edb/ref 17592186263373} {:answer/id #uuid "5d4f9c44-9e89-54be-bee6-c802eb51f782" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $3$rd and $4$th only" :db/id #edb/ref 17592186263809} {:answer/id #uuid "7f53d2fc-0a30-5d97-9817-a001f0b2982e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186264100} {:answer/id #uuid "a550728b-da46-57dc-9506-deaffd3cd7ac" :answer/type {:db/id #ed