-field.type/checkbox} :db/id #edb/ref 17592186440234} {:answer-field/choices [{:answer/id #uuid "6220c4f5-a3b9-52ae-802e-963dbfc98c7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669189} {:answer/id #uuid "789debb3-bc8b-534e-9c89-bcfb746ecac2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669190}] :answer-field/correct {:answer/id #uuid "789debb3-bc8b-534e-9c89-bcfb746ecac2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669190} :answer-field/id #uuid "cfda61cb-21ef-531d-a2cf-b30be7f199f6" :answer-field/key "The function has no vertical asymptotes" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669394}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "10e486fb-a153-567a-b122-83eab72817c1" :question/math-academy-id "q-39936" :question/problem "Determine the vertical asymptotes of $f(x)=\\frac{{x}^{2}-1}{{x}^{4}-1}.$\n\nSelect all that apply." :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}-1}{{x}^{4}-1} \\\\  & =\\frac{{x}^{2}-1}{({x}^{2}-1)({x}^{2}+1)} \\\\  & =\\frac{(x-1)(x+1)}{(x-1)(x+1)({x}^{2}+1)} \\\\  & =\\frac{\\cancel{(x-1)(x+1)}}{\\cancel{(x-1)(x+1)}({x}^{2}+1)} \\\\  & =\\frac{1}{{x}^{2}+1}\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero:\n\n$$\n{x}^{2}+1=0\n$$\n\nThis equation does not have any real solutions. Therefore, $f(x)$ has no vertical asymptotes."} {:db/id #edb/ref 17592186407337 :knowledge-point/_questions [{:db/id #edb/ref 17592186192780 :knowledge-point/id #uuid "e3fe3596-340e-5155-bed3-cf25f5843d70" :knowledge-point/title "Identifying Whether Sets Represented Graphically Are Subspaces in Two-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86eb0777-d080-53e8-b004-79a014639bb9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473088} {:answer/id #uuid "7872a4e4-6631-5d82-b92a-e36225c1be50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473089}] :answer-field/correct {:answer/id #uuid "86eb0777-d080-53e8-b004-79a014639bb9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473088} :answer-field/id #uuid "e7455588-72d5-550c-9183-e46e0782f4aa" :answer-field/key "![Diagram I](images/53/5303e5de04148fbd414db26930d50d5c0cd4ef19af5a46afaf4b312966cdfded.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473939} {:answer-field/choices [{:answer/id #uuid "79c0d29f-bfc2-506c-909d-d2ee04efe33c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473090} {:answer/id #uuid "0b1c9619-2805-5f10-9fdb-01a2befb4460" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473091}] :answer-field/correct {:answer/id #uuid "79c0d29f-bfc2-506c-909d-d2ee04efe33c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473090} :answer-field/id #uuid "11293092-de1e-51d5-b24b-3326cc42091a" :answer-field/key "![Diagram II](images/cc/ccdca51aef8ee61c23d3f3a81b1e4673598ffdde88cb4f58b4b35bb76886f524.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473940} {:answer-field/choices [{:answer/id #uuid "ee9299db-52e0-589b-b002-e37948bbdadf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473092} {:answer/id #uuid "474e300d-b0ad-520c-b70a-93c1e5e2e177" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473093}] :answer-field/correct {:answer/id #uuid "ee9299db-52e0-589b-b002-e37948bbdadf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473092} :answer-field/id #uuid "19219c0d-23df-589d-82c4-a37e066f5d0f" :answer-field/key "![Diagram III](images/e4/e495be81f41917740b46b1bfd43fd5cde69041981463c3dbbd96e55d206a8806.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473941} {:answer-field/choices [{:answer/id #uuid "6257fe4e-839a-565a-8b2c-f714a654f8e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669177} {:answer/id #uuid "6345f7b4-6ad0-50c1-bece-b8d368359b6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669178}] :answer-field/correct {:answer/id #uuid "6345f7b4-6ad0-50c1-bece-b8d368359b6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669178} :answer-field/id #uuid "57d88627-fcc0-5ab9-8ab9-960f9a4986ee" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669388}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "befb255b-f1bd-5c00-bc58-981c00e76ebb" :question/math-academy-id "q-35574" :question/problem "Which of the diagrams shown below represent subspaces of ${R}^{2}?$\n\nSelect all that apply." :question/worked-solution "Let's analyze each diagram in turn.\n\n- Diagram I does not represent a subspace. The vector $a=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}$ lies inside the given subset. But \n\n$$\n(-1)\\cdot a=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}\n$$\n\nlies outside the subset.\n\n- Diagram II represents the whole plane ${R}^{2}$ without the origin. But every subspace must contain the origin, so Diagram II is not a subspace of ${R}^{2}.$\n\n- Diagram III does not represent a subspace.  In this case we also have that the vector $a=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}$ lies inside the given subset. But \n\n$$\n(-1)\\cdot a=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}\n$$\n\nlies outside the subset.\n\nSo, the correct answer is \"None\"."} {:db/id #edb/ref 17592186411865 :knowledge-point/_questions [{:db/id #edb/ref 17592186198449 :knowledge-point/id #uuid "b4a5d6b1-e76a-5b33-8973-04d1d9062dc6" :knowledge-point/title "Identifying the Orthogonality of a Two-Vector Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f8e2907-6f9f-5945-87a4-4b320b3c5c7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472784} {:answer/id #uuid "363acb19-a7c4-58f9-889f-e407b2331d8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472785}] :answer-field/correct {:answer/id #uuid "1f8e2907-6f9f-5945-87a4-4b320b3c5c7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472784} :answer-field/id #uuid "51607494-5a75-5d4c-92f2-cb8a34490a90" :answer-field/key "${u}_{1}\\cdot {u}_{3}=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473787} {:answer-field/choices [{:answer/id #uuid "30463986-efbd-51fd-a6e9-b681bf1c31ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472786} {:answer/id #uuid "7e0850f2-9a46-5214-af3b-d2ee5b9d05f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472787}] :answer-field/correct {:answer/id #uuid "30463986-efbd-51fd-a6e9-b681bf1c31ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472786} :answer-field/id #uuid "576b8513-a337-57bb-a0b8-42a8d11e9c97" :answer-field/key "$\\{Q({u}_{1}),Q({u}_{2}),Q({u}_{3})\\}$ is orthogonal" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473788} {:answer-field/choices [{:answer/id #uuid "2da457c8-29f9-53a4-9a7b-82bd8117f5ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472788} {:answer/id #uuid "9252ae02-4d55-5e0b-ab06-d7222907f63c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472789}] :answer-field/correct {:answer/id #uuid "2da457c8-29f9-53a4-9a7b-82bd8117f5ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472788} :answer-field/id #uuid "b8436333-b398-5406-b728-7406ac2b71f3" :answer-field/key "$\\{Q({u}_{1}),Q({u}_{2}),Q({u}_{3})\\}$ is orthonormal" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473789} {:answer-field/choices [{:answer/id #uuid "12aa7dee-6930-51a9-9005-531050cbac3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669103} {:answer/id #uuid "8e625597-4c6d-54c4-8c47-5e959e233f94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669104}] :answer-field/correct {:answer/id #uuid "8e625597-4c6d-54c4-8c47-5e959e233f94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669104} :answer-field/id #uuid "4e6867e9-cec3-5d9e-8877-806350a4cff1" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669351}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8d807e12-6960-57f6-b74d-aa3fe66f0f76" :question/math-academy-id "q-178271" :question/problem "$$\n{u}_{1}=\\begin{bmatrix}3 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{u}_{2}=\\begin{bmatrix}1 \\\\ 1 \\\\ -3\\end{bmatrix},\\,{u}_{3}=\\begin{bmatrix}1 \\\\ -3 \\\\ 0\\end{bmatrix}\n$$\n\nConsider the vectors above, and let $Q$ be an orthogonal linear transformation. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nWith that in mind, let's examine our statements.\n\n- Statement ${u}_{1}\\cdot {u}_{3}=0$ is false since\n\n$$\n{u}_{1}\\cdot {u}_{3}=\\begin{bmatrix}3 \\\\ 0 \\\\ 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ -3 \\\\ 0\\end{bmatrix}=3\\ne 0.\n$$\n\n- Statement “$\\{Q({u}_{1}),Q({u}_{2}),Q({u}_{3})\\}$ is orthogonal” is false. Notice that, for example, $Q({u}_{1})⊥̸Q({u}_{3})$ since\n\n$$\nQ({u}_{1})\\cdot Q({u}_{3})={u}_{1}\\cdot {u}_{3}\\ne 0.\n$$\n\n- Statement “$\\{Q({u}_{1}),Q({u}_{2}),Q({u}_{3})\\}$ is orthonormal” is false since the set is not even orthogonal.\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186421404 :knowledge-point/_questions [{:db/id #edb/ref 17592186152068 :knowledge-point/id #uuid "e7f9502e-19c3-58bb-98da-1562e0b0dfd0" :knowledge-point/title "Identifying Equivalence Relations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d074dea2-9b08-51ae-a12c-baf0473ca84e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474626} {:answer/id #uuid "0745ed52-86ba-5e86-a9f5-e70229ac22d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474627}] :answer-field/correct {:answer/id #uuid "d074dea2-9b08-51ae-a12c-baf0473ca84e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474626} :answer-field/id #uuid "be2ebc52-7384-5d75-816e-60c49a6a2fe5" :answer-field/key "$A⊄B$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475239} {:answer-field/choices [{:answer/id #uuid "cf4b3440-fc76-5da9-8a1a-101b60935d33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474628} {:answer/id #uuid "6b07da64-c759-539c-8822-0100ac81394d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474629}] :answer-field/correct {:answer/id #uuid "cf4b3440-fc76-5da9-8a1a-101b60935d33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474628} :answer-field/id #uuid "d0c4e0ec-4e6b-5624-b84a-752ef7179b7c" :answer-field/key "$|A|\\ne |B|$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475240} {:answer-field/choices [{:answer/id #uuid "f7dd4394-62d9-59bb-a2a5-c6d2cefe8b93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474630} {:answer/id #uuid "4763b50f-c918-5bd1-93e4-4aa362986b27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474631}] :answer-field/correct {:answer/id #uuid "f7dd4394-62d9-59bb-a2a5-c6d2cefe8b93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474630} :answer-field/id #uuid "5844b7a0-ee09-5afb-98cc-df9699b3870d" :answer-field/key "$A⊇B$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475241} {:answer-field/choices [{:answer/id #uuid "bb8ad267-fb53-561e-ae81-39c39f17a2af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669139} {:answer/id #uuid "ee8117c9-3e2c-5e1e-9dee-edbd5ce87e6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669140}] :answer-field/correct {:answer/id #uuid "ee8117c9-3e2c-5e1e-9dee-edbd5ce87e6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669140} :answer-field/id #uuid "779aeabc-aea6-5d6d-992b-ed213cf28693" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669369}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0c07a7ee-9fb6-5236-b864-38ec61e9b0cc" :question/math-academy-id "q-214241" :question/problem "Which of the following are equivalence relations on $P(N)?$\n\nSelect all that apply." :question/worked-solution "Given a relation $R$ on a set $A$:\n\n- $R$ is reflexive if and only if for all $x\\in A,$ $x\\,R\\,x.$\n\n- $R$ is symmetric if and only if for all $x,y\\in A,$ if $x\\,R\\,y,$ then $y\\,R\\,x.$\n\n- $R$ is transitive if and only if for all $x,y,z\\in A,$ if $x\\,R\\,y$ and $y\\,R\\,z,$ then $x\\,R\\,z.$\n\nIf $R$ is reflexive, symmetric, and transitive, then $R$ is an equivalence relation.\n\nWith this in mind, let's consider each of the given relations.\n\n- The relation \"$⊄$\" is not an equivalence relation. For example, it is not symmetric since ${2,3}⊄{2}$ but ${2}⊂{2,3}.$\n\n- The relation \"$\\ne $\" for the cardinalities of sets is not an equivalence relation. For example, it is not reflexive since $|{2}|=|{2}|.$\n\n- The relation \"$⊇$\" is not an equivalence relation. For example, it is not symmetric since $N⊇{1}$ but ${1}⊉N.$\n\nTherefore, the correct answer is \"None.\""} {:db/id #edb/ref 17592186421411 :knowledge-point/_questions [{:db/id #edb/ref 17592186152066 :knowledge-point/id #uuid "b70dd396-b01a-51e6-a52c-8ff729f48c45" :knowledge-point/title "Determining Whether a Standard Relation Is an Equivalence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a9c693d2-46aa-5f80-92e0-a0d25e335e28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474650} {:answer/id #uuid "9eb32df2-8320-5fa4-96f0-b0f567cf3c41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474651}] :answer-field/correct {:answer/id #uuid "a9c693d2-46aa-5f80-92e0-a0d25e335e28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474650} :answer-field/id #uuid "34b06428-f421-54c5-a47d-9e8885796d5c" :answer-field/key "$R$ is reflexive" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475251} {:answer-field/choices [{:answer/id #uuid "3c857482-138f-5ec5-be1a-956fd271c304" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474652} {:answer/id #uuid "58491a53-f092-55cf-b93f-4cbc0d9a6a53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474653}] :answer-field/cor