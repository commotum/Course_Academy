592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468446} {:answer-field/choices [{:answer/id #uuid "a6bebb11-171b-5d6c-b089-eb4f4ea33409" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668653} {:answer/id #uuid "cbde429b-d127-56e4-aee5-cd522a595ea8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668654}] :answer-field/correct {:answer/id #uuid "cbde429b-d127-56e4-aee5-cd522a595ea8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668654} :answer-field/id #uuid "ac111455-9043-5ea5-bf1e-5d6362689a04" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668904}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "472e5539-e34f-5423-877f-1927b4b9d486" :question/math-academy-id "q-39246" :question/problem "Which of the following are rotation-scaling matrices?\n\nSelect all that apply." :question/worked-solution "A rotation-scaling matrix has the form \n\n$$\n\\begin{bmatrix}a & -b \\\\ b & a\\end{bmatrix},\n$$\n\n where $a$ and $b$ are real numbers that are not equal to zero simultaneously. Notice that the entries on the main diagonal are the same, while the antidiagonal entries have opposite signs.\n\nWith that in mind let's check each of the given matrices:\n\n- $A=\\begin{bmatrix}1 & -5 \\\\ 5 & 3\\end{bmatrix}$  is *not* a rotation-scaling matrix since the entries on the main diagonal are not the same.\n\n- $B=\\begin{bmatrix}-4 & -7 \\\\ -7 & -4\\end{bmatrix}$ is *not* a rotation-scaling matrix since the entries on the antidiagonal do not have opposite signs.\n\n- $C=\\begin{bmatrix}3 & 1 \\\\ -1 & -3\\end{bmatrix}$ is *not* a rotation-scaling matrix since the entries on the main diagonal are not the same.\n\nIn conclusion, the correct answer is \"None.\""} {:db/id #edb/ref 17592186326792 :knowledge-point/_questions [{:db/id #edb/ref 17592186087845 :knowledge-point/id #uuid "4b0b57da-f9af-5fab-a337-51ee4cb28f9e" :knowledge-point/title "Calculating Vertical Asymptotes With Common Factors When the Denominator Has Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f3c3348-eb0c-5468-aa98-ecdb90d6b160" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439737} {:answer/id #uuid "1521cff8-c574-52e1-bc38-0a4fe0cf4ca2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439738}] :answer-field/correct {:answer/id #uuid "4f3c3348-eb0c-5468-aa98-ecdb90d6b160" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439737} :answer-field/id #uuid "d9c4828b-4e33-518a-aef4-a7d2e4cd25e4" :answer-field/key "$x=-7$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440226} {:answer-field/choices [{:answer/id #uuid "68b1ea8d-6026-5feb-87a2-96eecb19a3a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439739} {:answer/id #uuid "c904bf85-72a5-5708-b2aa-de41ef06bf9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439740}] :answer-field/correct {:answer/id #uuid "68b1ea8d-6026-5feb-87a2-96eecb19a3a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439739} :answer-field/id #uuid "8973e8a4-77f9-52ab-9d3a-66756a483070" :answer-field/key "$x=-2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 175921