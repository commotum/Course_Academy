/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464530} :answer-field/id #uuid "70cbf976-fe8d-5ca6-b921-4a95b4f265e8" :answer-field/key "$Π$ is closed under scalar multiplication" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465199} {:answer-field/choices [{:answer/id #uuid "3f902f17-2143-5f18-a934-cec9caf9ce4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464532} {:answer/id #uuid "c348bb49-51ad-5388-bcca-dcb41c8a20bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464533}] :answer-field/correct {:answer/id #uuid "3f902f17-2143-5f18-a934-cec9caf9ce4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464532} :answer-field/id #uuid "0e36ef1a-6a50-5ba0-b80b-aa2e41f943fa" :answer-field/key "$Π$ is a subspace of ${R}^{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465200} {:answer-field/choices [{:answer/id #uuid "014c6073-40e1-5bfe-a7e1-93bf1a5af798" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668433} {:answer/id #uuid "db2c8158-26cd-5e2b-af37-0a841c7ed9d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668434}] :answer-field/correct {:answer/id #uuid "db2c8158-26cd-5e2b-af37-0a841c7ed9d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668434} :answer-field/id #uuid "df3fa663-bb34-5c1a-b76b-24eac8329bbf" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668794}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "99eda82b-48bc-5827-9c44-f2725d46a5d4" :question/math-academy-id "q-157476" :question/problem "Let $Π$ be the plane with equation $x-2y+2z=3$ in ${R}^{3}.$ Which of the following statements are true? \n\nSelect all that apply." :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $Π$ contains vectors of the form \n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}3+2y-2z \\\\ y \\\\ z\\end{bmatrix},\\,y,z\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement “$Π$ contains the zero-vector” is false. The line does not pass through the origin since\n\n$$\n\\begin{aligned}x-2y+2z & =3 \\\\ (0)-2(0)+2(0) & =3 \\\\ 0 & =3\\,\\times \\end{aligned}\n$$\n\n- Statement “$Π$ is closed under vector addition” is false. Let's consider $a=\\begin{bmatrix}3 \\\\ 0 \\\\ 0\\end{bmatrix}\\in Π$ and $b=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}\\in Π.$ Then \n\n$$\n\\begin{aligned}a+b & =\\begin{bmatrix}3 \\\\ 0 \\\\ 0\\end{bmatrix}+\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}3+1 \\\\ 0+0 \\\\ 0+1\\end{bmatrix}=\\begin{bmatrix}4 \\\\ 0 \\\\ 1\\end{bmatrix},\\end{aligned}\n$$\n\nHowever, $\\begin{bmatrix}4 \\\\ 0 \\\\ 1\\end{bmatrix}$ does not belong to $Π$ since \n\n$$\n\\begin{aligned}x-2y+2z & =3 \\\\ (4)-2(0)+2(1) & =3 \\\\ 6 & =3\\,\\times \\end{aligned}\n$$\n\n- Statement “$Π$ is closed under scalar multiplication” is false. Since $0\\notin Π,$ this set is not closed under scalar multiplication.\n\n- Statement “$Π$ is a subspace of ${R}^{3}$” is false. Since statements “$Π$ is closed under vector addition” and “$Π$ is closed under scalar multiplication” are false, $L$ is *not* a subspace of ${R}^{3}.$\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186275420 :knowledge-point/_questions [{:db/id #edb/ref 17592186192780 :knowledge-point/id #uuid "e3fe3596-340e-5155-bed3-cf25f5843d70" :knowledge-point/title "Identifying Whether Sets Represented Graphically Are Subspaces in Two-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "352101e0-3c5b-502b-a334-6b1b8070e311" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464534} {:answer/id #uuid "b81938d9-ae2d-5288-8081-529643148694" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464535}] :answer-field/correct {:answer/id #uuid "352101e0-3c5b-502b-a334-6b1b8070e311" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464534} :answer-field/id #uuid "468f4c36-ed35-5785-949b-ff79fcb9eb6f" :answer-field/key "![Diagram I](images/71/717cf6b60f2bfda12aa87673c1d7531c73e65f73585121e44fe7d7d530c4a103.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465201} {:answer-field/choices [{:answer/id #uuid "f0a1dc91-c6a3-54bc-b477-5c7f11f05916" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464536} {:answer/id #uuid "33615139-f00b-5e76-9a32-8e9d69940975" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464537}] :answer-field/correct {:answer/id #uuid "f0a1dc91-c6a3-54bc-b477-5c7f11f05916" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464536} :answer-field/id #uuid "7770bc41-73c7-55e4-b7bd-776454e3312b" :answer-field/key "![Diagram II](images/57/5767b45fc4637dc6ec0d6e83fae189d4dcfdb0704472d582d835164307148de9.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465202} {:answer-field/choices [{:answer/id #uuid "f22b964c-9152-568c-ba2a-cebc8c366bd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464538} {:answer/id #uuid "1bd8574e-8fd8-5a4e-ad0b-95ed7b7d233d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464539}] :answer-field/correct {:answer/id #uuid "f22b964c-9152-568c-ba2a-cebc8c366bd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464538} :answer-field/id #uuid "0a73248c-d4f7-5606-8dd7-59415c7496e2" :answer-field/key "![Diagram III](images/a8/a8a0a38e0c05da243e5b8fcdbb22c58517fb98e6dcea4f985756a427183b8c87.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465203} {:answer-field/choices [{:answer/id #uuid "2cd7cef6-e7d4-51f3-a751-f9fae4db1718" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668435} {:answer/id #uuid "8c9338c2-4752-525d-89cd-5fae1da90974" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668436}] :answer-field/correct {:answer/id #uuid "8c9338c2-4752-525d-89cd-5fae1da90974" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668436} :answer-field/id #uuid "9944e26c-3a1b-5878-baac-a4471022f29c" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668795}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4ecd1a30-d61f-5d31-96d2-62fa52545c5c" :question/math-academy-id "q-158029" :question/problem "Which of the diagrams shown below represent subspaces of ${R}^{2}?$\n\nSelect all that apply." :question/worked-solution "Let's analyze each diagram in turn.\n\n- Diagram I represents a set that does not contain the origin. But every subspace must contain the origin, so Diagram I is not a subspace of ${R}^{2}.$\n\n- Diagram II represents a set that does not contain the origin. But every subspace must contain the origin, so Diagram II is not a subspace of ${R}^{2}.$\n\n- Diagram III does not represent a subspace.  In this case, we have that the vector $a=\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}$ lies inside the given subset. But \n\n$$\n(-1)\\cdot a=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}\n$$\n\nlies outside the subset.\n\nSo, the correct answer is \"None\"."} {:db/id #edb/ref 17592186281553 :knowledge-point/_questions [{:db/id #edb/ref 17592186162155 :knowledge-point/id #uuid "35de7257-8d35-5f81-89be-c7faa73d6bc3" :knowledge-point/title "Determining Whether Two Random Variables are Independent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06b6d959-ee25-5492-981c-35d8db8e5d29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465483} {:answer/id #uuid "ff9adef5-225c-5e47-85de-42b3cd7836b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465484}] :answer-field/correct {:answer/id #uuid "06b6d959-ee25-5492-981c-35d8db8e5d29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465483} :answer-field/id #uuid "14307e24-b8d0-5de1-9104-6c06ac0c93ca" :answer-field/key "$P(X=1,Y=0)$ $=P(X=1)\\cdot P(Y=0)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466585} {:answer-field/choices [{:answer/id #uuid "655fd2b1-caba-581e-9f02-5af690a77b1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465485} {:answer/id #uuid "68af336e-64bf-56bf-84dd-85cd858cec6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465486}] :answer-field/correct {:answer/id #uuid "655fd2b1-caba-581e-9f02-5af690a77b1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465485} :answer-field/id #uuid "d37345fc-3288-5bfa-8a83-9ad74cabae6f" :answer-field/key "$P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466586} {:answer-field/choices [{:answer/id #uuid "a7f3db53-a644-5ca7-a50d-da78184c6ba9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465487} {:answer/id #uuid "10595161-cfd2-59f2-802a-94f7478661b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465488}] :answer-field/correct {:answer/id #uuid "a7f3db53-a644-5ca7-a50d-da78184c6ba9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465487} :answer-field/id #uuid "4bf4bd53-b362-55cb-86c6-31f5ad34dba8" :answer-field/key "$X$ and $Y$ are independent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466587} {:answer-field/choices [{:answer/id #uuid "aee2f724-48e5-5863-a7b3-37b8497007e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668461} {:answer/id #uuid "d84752b5-d7ed-5ec2-823a-b4d62556be3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668462}] :answer-field/correct {:answer/id #uuid "d84752b5-d7ed-5ec2-823a-b4d62556be3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668462} :answer-field/id #uuid "533c65e1-d90d-512a-ad71-0dd369d7bad9" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668808}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "745e2846-c808-51fa-a431-23f636897e08" :question/math-academy-id "q-162824" :question/problem "| $f$ | $Y=0$ | $Y=1$ |\n| --- | --- | --- |\n| $X=0$ | $0.35$ | $0.15$ |\n| $X=1$ | $0.25$ | $0.25$ |\n\nThe joint probability distribution $f(x,y)$ of the discrete random variables $X$ and $Y$ is given above, while the marginal mass functions for these variables are shown below.\n\n| | $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| ${f}_{X}(x)$ | $0.5$ | $0.5$ | |  | | $y$ | $0$ | $1$ |\n| --- | --- | --- |\n| ${f}_{Y}(y)$ | $0.6$ | $0.4$ | |\n| --- | --- | --- |\n| $x$ | $0$ | $1$ |\n| ${f}_{X}(x)$ | $0.5$ | $0.5$ |\n| $y$ | $0$ | $1$ |\n| ${f}_{Y}(y)$ | $0.6$ | $0.4$ |\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Two discrete random variables $X$ and $Y$ with a joint probability mass function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability mass functions for $X$ and $Y,$ respectively.\n\nWith that in mind, let's examine our statements.\n\n- Statements $P(X=1,Y=0)$ $=P(X=1)\\cdot P(Y=0)$ and “$P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$” are false. From the table, we obtain that $P(X=1,Y=0)=f(1,0)=0.25.$ However, \n\n$$\nP(X=1)\\cdot P(Y=0)={f}_{X}(1)\\cdot {f}_{Y}(0)=0.5\\cdot 0.6=0.3.\\,\\times \n$$\n\nTherefore, \n\n$$\nP(X=1,Y=0)\\ne P(X=1)\\cdot P(Y=0),\n$$\n\nand $P(X=x,Y=y)\\ne P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y.$\n\n- Statement “$X$ and $Y$ are independent” is false. Since statement “$P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$” is false, our random variables $X$ and $Y$ are *not* independent.\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186284442 :knowledge-point/_questions [{:db/id #edb/ref 17592186157368 :knowledge-point/id #uuid "f901a3ab-3b58-51a1-b653-f88ac4b09060" :knowledge-point/title "Using the Second Derivative Test To Classify a Point on a Solution Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b05e796-e00c-5de2-9ed1-30703c297087" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465531} {:answer/id #uuid "e130c91d-7b17-52a3-bbbe-7767095f3a35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465532}] :answer-field/correct {:answer/id #uuid "8b05e796-e00c-5de2-9ed1-30703c297087" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465531} :answer-field/id #uuid "1391c79c-130f-5328-917d-79dbf6fe63ec" :answer-field/key "$(-\\frac{1}{2},1)$ is a stationary point of the function $f$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466609} {:answer-field/choices [{:answer/id #uuid "ea44c227-3043-5844-9d11-64a4526e8f15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465533} {:answer/id #uuid "cb1d78a3-f02f-531f-84d8-088e936f9199" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465534}] :answer-field/correct {:answer/id #uuid "ea44c227-3043-5844-9d11-64a4526e8f15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465533} :answer-field/id #uuid "5a5c2786-4ef5-5ec0-8f4d-c449aa97de49" :answer-field/key "$(-\\frac{1}{2},1)$ is a local maximum point of the function $f$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466610} {:answer-field/choices [{:answer/id #uuid "604a2af8-96eb-5f23-87ff-0df87135405b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465535} {:answer/id #uuid "2598aec1-6d6c-5cb8-a449-91508e4cf00e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465536}] :answer-field/correct {:answer/id #uuid "604a2af8-96eb-5f23-87ff-0df87135405b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465535} :answer-field/id #uuid "dcee9c7c-2aa1-5f34-a629-c4b67e147f65" :answer-field/key "$(-\\frac{1}{2},1)$ is an inflection point of the function $f$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466611} {:answer-field/choices [{:answer/id #uuid "a2f3e27a-71c0-597e-9a69-695c6dbcdcf1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668475} {:answer/id #uuid "7e5107e0-36a0-5417-ace1-11e4ff6dba4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668476}] :answer-field/correct {:answer/id #uuid "7e5107e0-36a0-5417-ace1-11e4ff6dba4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668476} :answer-field/id #uuid "822458c8-d973-5f7e-a82c-914d2bb11548" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668815}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8eeb45f2-bc46-5681-a60d-c808242e288d" :question/math-academy-id "q-164138" :question/problem "The function $y=f(x)$ satisfies the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{y}{1+{x}^{2}}.\n$$\n\nGiven that the point $(-\\frac{1}{2},1)$ lies on the graph of $y=f(x),$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, we find the value of the first and second derivatives of the function at the given point.\n\nTo find the first derivative of $f$ at $(-\\frac{1}{2},1),$ we substitute the coordinates of our point into the differential equation:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{(-1/2,1)} & ={\\left(\\frac{y}{1+{x}^{2}}\\right)|}_{(-1/2,1)} \\\\  & =\\frac{1}{1+{\\left(-\\frac{1}{2}\\right)}^{2}} \\\\  & =\\frac{4}{5}\\end{aligned}\n$$\n\nTo find the second derivative, we first need to differentiate the equation and then substitute the coordinates of the point:\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{\\text{d}y}{\\text{d}x}\\right) \\\\  & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{y}{1+{x}^{2}}\\right) \\\\  & =\\frac{1}{1+{x}^{2}}\\cdot \\frac{\\text{d}y}{\\text{d}x}-\\frac{2xy}{(1+{x}^{2})^{2}} \\\\  & =\\frac{1}{1+{x}^{2}}\\cdot \\frac{y}{1+{x}^{2}}-\\frac{2xy}{(1+{x}^{2})^{2}} \\\\  & =\\frac{y(1-2x)}{(1+{x}^{2})^{2}} \\\\ {\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(-1/2,1)} & ={\\left(\\frac{y(1-2x)}{(1+{x}^{2})^{2}}\\right)|}_{(-1/2,1)} \\\\  & =\\frac{1(1-2\\left(-\\frac{1}{2}\\right))}{{(1+{\\left(-\\frac{1}{2}\\right)}^{2})}^{2}} \\\\  & =\\frac{32}{25}.\\end{aligned}\n$$\n\nWith that in mind, let's examine the statements in turn.\n\n- Statement “$(-\\frac{1}{2},1)$ is a stationary point of the function $f$” is false. Indeed, since\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(-1/2,1)}=\\frac{4}{5}\\ne 0,\n$$\n\nwe obtain that $(-\\frac{1}{2},1)$ is not a stationary point of the function $f.$\n\n- Statement “$(-\\frac{1}{2},1)$ is a local maximum point of the function $f$” is false. There is no critical point at $(-\\frac{1}{2},1).$ Therefore we cannot have a local minimum at that point.\n\n- Statement “$(-\\frac{1}{2},1)$ is an inflection point of the function $f$” is false. Since the second derivative is not zero, there is no inflection point at $(-\\frac{1}{2},1).$\n\nTherefore, the correct answer is \"None of those listed.\""} {:db/id #edb/ref 17592186284737 :knowledge-point/_questions [{:db/id #edb/ref 17592186054820 :knowledge-point/id #uuid "35eba041-5109-5855-b132-174c0271c168" :knowledge-point/title "Identifying Predicates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "deab7354-8d59-5651-963c-4faf3b669082" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465645} {:answer/id #uuid "73d28717-f191-5e1e-95bf-5af3698729dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465646}] :answer-field/correct {:answer/id #uuid "deab7354-8d59-5651-963c-4faf3b669082" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465645} :answer-field/id #uuid "decf0e43-3877-5a21-8037-cee318134af1" :answer-field/key "$P(z):$ Subtract $8$ from $z.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466666} {:answer-field/choices [{:answer/id #uuid "a8d510c8-83d1-57f0-a77a-f71e8770f23d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465647} {:answer/id #uuid "edc1cedb-d499-5519-aca9-b2bcfa1986e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465648}] :answer-field/correct {:answer/id #uuid "a8d510c8-83d1-57f0-a77a-f71e8770f23d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465647} :answer-field/id #uuid "a70ef2cf-bda2-5211-b003-aaf9d169b70e" :answer-field/key "$Q(x):$ $x÷2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466667} {:answer-field/choices [{:answer/id #uuid "41027071-b467-56de-b8ac-1199ad53c826" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465649} {:answer/id #uuid "c0df3aa7-4255-5a37-9fd4-accb8b711300" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465650}] :answer-field/correct {:answer/id #uuid "41027071-b467-56de-b8ac-1199ad53c826" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465649} :answer-field/id #uuid "4c201b7e-51e2-56f3-8cb0-77fd8337e314" :answer-field/key "$R(n):$ $\\sqrt{n}-\\sqrt{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466668} {:answer-field/choices [{:answer/id #uuid "d766dc16-7498-5c6c-b930-1e2e54305305" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668481} {:answer/id #uuid "91d9ed10-3947-5568-b6fa-43ca92a92e43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668482}] :answer-field/correct {:answer/id #uuid "91d9ed10-3947-5568-b6fa-43ca92a92e43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668482} :answer-field/id #uuid "43e27fe1-4253-5fd7-8b8c-161b7f41d2f1" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668818}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "388254b7-705e-581e-9708-313da2ad5c8e" :question/math-academy-id "q-175342" :question/problem "Which of the following are mathematical predicates of one variable?\n\nSelect all that apply." :question/worked-solution "A *predicate* of one variable is a sentence that contains the variable defined on some *universal set* and has the property that when we substitute any concrete value of the variable into the predicate, the result becomes a statement that is either true or false.\n\nWith that in mind, let's examine our options. \n\n- Option “$P(z):$ Subtract $8$ from $z.$” is *not* a predicate. Substituting a concrete value for $z$ into the sentence, we do not get a statement that is either true or false. Rather, it will give an instruction.\n\n- Option “$Q(x):$ $x÷2$” is *not* a predicate. Substituting a concrete value for $x$ into the sentence, we do not get a statement that is either true or false.\n\n- Option “$R(n):$ $\\sqrt{n}-\\sqrt{3}$” is *not* a predicate. Substituting a concrete value for $n$ into the sentence, we do not get a statement that is either true or false.\n\nTherefore, the correct answer is \"None of the given statements.\""} {:db/id #edb/ref 17592186284748 :knowledge-point/_questions [{:db/id #edb/ref 17592186198449 :knowledge-point/id #uuid "b4a5d6b1-e76a-5b33-8973-04d1d9062dc6" :knowledge-point/title "Identifying the Orthogonality of a Two-Vector Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a4ade3a-303a-5eec-9df3-e43d050e7127" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465651} {:answer/id #uuid "bfb5336b-989f-5a31-b653-6429b31a077f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465652}] :answer-field/correct {:answer/id #uuid "5a4ade3a-303a-5eec-9df3-e43d050e7127" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465651} :answer-field/id #uuid "50d64a07-1676-5fda-bef0-6a4849be81d2" :answer-field/key "${u}_{1}\\cdot {u}_{2}=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466669} {:answer-field/choices [{:answer/id #uuid "6722f30e-e2af-5a70-879f-cfff27425f84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465653} {:answer/id #uuid "dc3d0a9a-fffb-56ce-a7bd-59c663e5f87e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465654}] :answer-field/correct {:answer/id #uuid "6722f30e-e2af-5a70-879f-cfff27425f84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465653} :answer-field/id #uuid "c9cb2af9-89d8-5f3d-8d83-90156885a877" :answer-field/key "${Q({u}_{1}),Q({u}_{2}),Q({u}_{3})}$ is orthogonal" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466670} {:answer-field/choices [{:answer/id #uuid "9ff5d22d-d9d1-5f3d-acef-b6be4a77c7ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465655} {:answer/id #uuid "bb044ed9-c0d7-5063-b76d-362678932554" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465656}] :answer-field/correct {:answer/id #uuid "9ff5d22d-d9d1-5f3d-acef-b6be4a77c7ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465655} :answer-field/id #uuid "3cba7c41-2ad1-5047-8e7d-0cc187a92400" :answer-field/key "${Q({u}_{1}),Q({u}_{2}),Q({u}_{3})}$ is orthonormal" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466671} {:answer-field/choices [{:answer/id #uuid "7677d252-a3d8-50c2-b717-527086af9f76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668483} {:answer/id #uuid "42e1dc4d-5228-5970-9bfa-84b6cd71a295" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668484}] :answer-field/correct {:answer/id #uuid "42e1dc4d-5228-5970-9bfa-84b6cd71a295" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668484} :answer-field/id #uuid "9c1b0a57-3577-5516-9893-11064e9f55ae" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668819}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1e67e934-1049-5a47-aaca-94c1d2a3bfc1" :question/math-academy-id "q-177118" :question/problem "$$\n{u}_{1}=\\begin{bmatrix}2 \\\\ 3 \\\\ 5\\end{bmatrix},\\,{u}_{2}=\\begin{bmatrix}1 \\\\ 4 \\\\ -1\\end{bmatrix},\\,{u}_{3}=\\begin{bmatrix}3 \\\\ 3 \\\\ -3\\end{bmatrix}\n$$\n\nConsider the vectors above, and let $Q$ be an orthogonal linear transformation. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nWith that in mind, let's examine our statements.\n\n- Statement ${u}_{1}\\cdot {u}_{2}=0$ is false since\n\n$$\n{u}_{1}\\cdot {u}_{2}=\\begin{bmatrix}2 \\\\ 3 \\\\ 5\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 4 \\\\ -1\\end{bmatrix}=2+12-5=9\\ne 0.\n$$\n\n- Statement “${Q({u}_{1}),Q({u}_{2}),Q({u}_{3})}$ is orthogonal” is false. Notice that, for example, $Q({u}_{1})⊥̸Q({u}_{2})$ since\n\n$$\nQ({u}_{1})\\cdot Q({u}_{2})={u}_{1}\\cdot {u}_{2}\\ne 0.\n$$\n\n- Statement “${Q({u}_{1}),Q({u}_{2}),Q({u}_{3})}$ is orthonormal” is false since the set is not even orthogonal.\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186284764 :knowledge-point/_questions [{:db/id #edb/ref 17592186198449 :knowledge-point/id #uuid "b4a5d6b1-e76a-5b33-8973-04d1d9062dc6" :knowledge-point/title "Identifying the Orthogonality of a Two-Vector Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1f6862c-27fd-5c39-8eb2-3cbbffed6df8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465669} {:answer/id #uuid "786a7ab2-a3ec-5b80-8a00-e9e1753b87d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465670}] :answer-field/correct {:answer/id #uuid "e1f6862c-27fd-5c39-8eb2-3cbbffed6df8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465669} :answer-field/id #uuid "55fa8074-b199-52f0-b9ec-a64e6d2e74dd" :answer-field/key "${u}_{1}\\cdot {u}_{2}=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466678} {:answer-field/choices [{:answer/id #uuid "14cbd69a-f982-5d8b-a7b5-faa1d54ef043" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465671} {:answer/id #uuid "a3dbd501-b3c0-564f-92ea-a9a572fb9e89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465672}] :answer-field/correct {:answer/id #uuid "14cbd69a-f982-5d8b-a7b5-faa1d54ef043" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465671} :answer-field/id #uuid "77082866-697e-5473-bb08-593811756def" :answer-field/key "$\\{Q({u}_{1}),Q({u}_{2})\\}$ is orthogonal" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466679} {:answer-field/choices [{:answer/id #uuid "270b69ea-ae43-51a2-bc71-ac5760e7b855" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465673} {:answer/id #uuid "f89e42f6-9f2a-5d60-9603-c8642f276749" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465674}] :answer-field/correct {:answer/id #uuid "270b69ea-ae43-51a2-bc71-ac5760e7b855" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465673} :answer-field/id #uuid "07d18537-0a6d-59ae-9629-b8bdfac0f081" :answer-field/key "$\\{Q({u}_{1}),Q({u}_{2})\\}$ is orthonormal" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466680} {:answer-field/choices [{:answer/id #uuid "a7e97f9b-fe7f-52a8-beba-445b1a491036" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668489} {:answer/id #uuid "a5c64cfd-fe46-5318-8729-f48bed48fc3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668490}] :answer-field/correct {:answer/id #uuid "a5c64cfd-fe46-5318-8729-f48bed48fc3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668490} :answer-field/id #uuid "0ab468c6-4c77-52a0-871b-2e05cd810382" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668822}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e16f6fa7-ae80-51bb-bdf3-1add916dcb13" :question/math-academy-id "q-178269" :question/problem "$$\n{u}_{1}=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix},\\,{u}_{2}=\\begin{bmatrix}6 \\\\ 1\\end{bmatrix}\n$$\n\nConsider the vectors above, and let $Q$ be an orthogonal linear transformation. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nWith that in mind, let's examine our statements.\n\n- Statement ${u}_{1}\\cdot {u}_{2}=0$ is false. Indeed,\n\n$$\n{u}_{1}\\cdot {u}_{2}=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}\\cdot \\begin{bmatrix}6 \\\\ 1\\end{bmatrix}=6+3\\ne 0.\n$$\n\n- Statement “$\\{Q({u}_{1}),Q({u}_{2})\\}$ is orthogonal” is false. Notice that, $Q({u}_{1})⊥̸Q({u}_{2})$ since\n\n$$\nQ({u}_{1})\\cdot Q({u}_{2})={u}_{1}\\cdot {u}_{2}\\ne 0.\n$$\n\n- Statement “$\\{Q({u}_{1}),Q({u}_{2})\\}$ is orthonormal” is false since the set is not even orthogonal.\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186290365 :knowledge-point/_questions [{:db/id #edb/ref 17592186064166 :knowledge-point/id #uuid "fbee870b-4a67-5ccb-b274-45fac627be6e" :knowledge-point/title "Classifying a Given Critical Point Using the Second Derivative Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52b64840-cdbe-51af-ae5f-3a1ebf8b1eb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465869} {:answer/id #uuid "539318a7-8cb6-5daa-ac08-572b27b2eefd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465870}] :answer-field/correct {:answer/id #uuid "52b64840-cdbe-51af-ae5f-3a1ebf8b1eb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465869} :answer-field/id #uuid "b6979f09-27c3-5d99-9841-fa7bd5afc99f" :answer-field/key "${f}^{″}(1)<0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466778} {:answer-field/choices [{:answer/id #uuid "a094ef95-0842-544f-84d8-c97acfe7948f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465871} {:answer/id #uuid "0c337dc8-1ff2-57f1-8269-8ae05c9eabc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465872}] :answer-field/correct {:answer/id #uuid "a094ef95-0842-544f-84d8-c97acfe7948f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465871} :answer-field/id #uuid "97cb6da3-66a0-5d6d-bb97-d9e8dc4ae9a3" :answer-field/key "$f(x)$ has a relative minimum at $x=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466779} {:answer-field/choices [{:answer/id #uuid "9b9cf2d5-1469-5f57-84ae-a729db035dda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465873} {:answer/id #uuid "6e07279a-94d0-531f-b4bb-b71ad949ca26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465874}] :answer-field/correct {:answer/id #uuid "9b9cf2d5-1469-5f57-84ae-a729db035dda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465873} :answer-field/id #uuid "b3e397c8-64d1-536f-bccc-4b61bf84365f" :answer-field/key "$f(x)$ has a relative maximum at $x=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466780} {:answer-field/choices [{:answer/id #uuid "dd8810f1-a19c-56fa-86a9-7300fc426c6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668507} {:answer/id #uuid "6803a661-2cbe-5063-b45b-04a53ed5275e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668508}] :answer-field/correct {:answer/id #uuid "6803a661-2cbe-5063-b45b-04a53ed5275e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668508} :answer-field/id #uuid "64e95d25-9ea6-5d82-ab72-a5923005c097" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668831}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cfe05852-ce59-5bf2-a32a-e36a882c576e" :question/math-academy-id "q-22016" :question/problem "Consider the function $f(x)=3{x}^{4}+4{x}^{3}-30{x}^{2}+36x+12.$ Given that ${f}^{′}(1)=0,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "We're given that $x=1$ is a stationary point of $f(x).$ We will use the second derivative test to classify this stationary point.\n\nCalculating the first derivative for the function $f(x)=3{x}^{4}+4{x}^{3}-30{x}^{2}+36x+12,$ we get\n\n$$\n{f}^{′}(x)=12{x}^{3}+12{x}^{2}-60x+36.\n$$\n\nCalculating the second derivative, we get \n\n$$\n{f}^{″}(x)=36{x}^{2}+24x-60.\n$$\n\nSubstituting $x=1,$ we get\n\n$$\n\\begin{aligned}{f}^{″}(1) & =36(1)^{2}+24(1)-60=0\\end{aligned}\n$$\n\nSince the second derivative is zero, we conclude that the test is inconclusive, we need to use the first derivative test.\n\nLet's  find other stationary points. Solving ${f}^{′}(x)=0$ gives\n\n$$\n\\begin{aligned}12{x}^{3}+12{x}^{2}-60x+36 & =0 \\\\ 12({x}^{3}+{x}^{2}-5x+3) & =0 \\\\ 12(x-1)({x}^{2}+2x-3) & =0 \\\\ 12(x-1)(x-1)(x+3) & =0 \\\\ x & =-3,1.\\end{aligned}\n$$\n\n \n\nSo we have two stationary points, $x=-3$ and $x=1.$ Next, to determine whether these points are local maxima or minima, we use the first derivative test.\n\nLet's choose the test points $x=-4,0,2$ and evaluate the first derivative at these points.\n\n$$\n\\begin{aligned}{f}^{′}(-4) & =12(-4-1)^{2}(-4+3)=-300<0 \\\\ {f}^{′}(0) & =12(0-1)^{2}(0+3)=36>0 \\\\ {f}^{′}(2) & =12(2-1)^{2}(2+3)=60>0\\end{aligned}\n$$\n\nWe summarize the information in a table, shown below.\n\n| $x$ | $(-\\infty ,-3)$ | $-3$ | $(-3,1)$ | $1$ | $(1,\\infty )$ |\n| --- | --- | --- | --- | --- | --- |\n| Test Point | $-4$ |  | $0$ |  | $2$ |\n| ${f}^{′}$ | $-$ | $0$ | $+$ | $0$ | $+$ |\n| $f$ | $↘$ | min | $↗$ |  | $↗$ |\n\nAt $x=1,$  the first derivative does not change the sign. Therefore, $x=1$ is neither a local minimum nor a local maximum.\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186297181 :knowledge-point/_questions [{:db/id #edb/ref 17592186110719 :knowledge-point/id #uuid "ff4e9141-5743-55f1-a8be-3e28cb047eca" :knowledge-point/title "Identifying Equations With Infinitely Many Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51b73290-8884-52b0-bea9-586ed1106191" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438082} {:answer/id #uuid "84594a5c-0472-579f-8c56-3c27f2aa0b2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438083}] :answer-field/correct {:answer/id #uuid "51b73290-8884-52b0-bea9-586ed1106191" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438082} :answer-field/id #uuid "d237ec26-3cf6-575e-bb01-acccb260545f" :answer-field/key "$-3x+2=-3x+7$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439070} {:answer-field/choices [{:answer/id #uuid "6aa4deae-76c0-5bf7-a4af-1158715b25d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438084} {:answer/id #uuid "e6ba602a-8c17-5e28-b8db-32b4e57396a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438085}] :answer-field/correct {:answer/id #uuid "6aa4deae-76c0-5bf7-a4af-1158715b25d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438084} :answer-field/id #uuid "e0236bbe-ed0c-5681-b717-8d06a5afcad6" :answer-field/key "$6x+1=6x+5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439071} {:answer-field/choices [{:answer/id #uuid "18b5cb76-d351-5058-a991-9afc4efc993e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438086} {:answer/id #uuid "b1790360-3d45-5107-959e-c1c762336309" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438087}] :answer-field/correct {:answer/id #uuid "18b5cb76-d351-5058-a991-9afc4efc993e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438086} :answer-field/id #uuid "ae99ebca-b507-5034-9f94-d990616ca1d6" :answer-field/key "$7x-4=6x-6$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439072} {:answer-field/choices [{:answer/id #uuid "7547f23c-0aa4-5463-8651-ed75091dbaf7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668515} {:answer/id #uuid "fee774d7-7c07-5356-b26d-44a89bbbf8cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668516}] :answer-field/correct {:answer/id #uuid "fee774d7-7c07-5356-b26d-44a89bbbf8cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668516} :answer-field/id #uuid "7e2b1594-e3d1-5c48-acb9-3b114a1a3981" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668835}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d5426119-4ea0-5c84-bb6c-cf460c622db0" :question/math-academy-id "q-288425" :question/problem "Which of the following equations has infinitely many solutions?\n\nSelect all that apply." :question/worked-solution "Let's attempt to solve each equation in turn:\n\n- For the first equation, we have\n\n$$\n\\begin{aligned}-3x+2 & =-3x+7 \\\\ -3x+2+3x & =-3x+7+3x \\\\ 2 & =7.\\end{aligned}\n$$\n\nThis equation is false for all values of $x.$\n\n- For the second equation, we have\n\n$$\n\\begin{aligned}6x+1 & =6x+5 \\\\ 6x+1-6x & =6x+5-6x \\\\ 1 & =5.\\end{aligned}\n$$\n\nThis equation is false for all values of $x.$\n\n- For the third equation, we have\n\n$$\n\\begin{aligned}7x-4 & =6x-6 \\\\ 7x-4-6x & =6x-6-6x \\\\ x-4 & =-6 \\\\ x-4+4 & =-6+4 \\\\ x & =-2.\\end{aligned}\n$$\n\nTherefore, the equation $7x-4=6x-6$ has the unique solution $x=-2.$\n\nTherefore, the correct answer is \"None.\""} {:db/id #edb/ref 17592186304811 :knowledge-point/_questions [{:db/id #edb/ref 17592186166901 :knowledge-point/id #uuid "3f6920b1-2a94-5a47-840f-c823c9f70e36" :knowledge-point/title "Constructing General Solutions of First-Order Linear Systems of ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f74d291-c3ec-5bc4-87f6-5aa006c9ebc1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465993} {:answer/id #uuid "fb5499f4-34ea-5f2a-8be2-ae18558867c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465994}] :answer-field/correct {:answer/id #uuid "3f74d291-c3ec-5bc4-87f6-5aa006c9ebc1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465993} :answer-field/id #uuid "9e1421a3-ab24-57bf-8727-a502d021307f" :answer-field/key "${x}_{1}(t)-{x}_{2}(t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466840} {:answer-field/choices [{:answer/id #uuid "a65cdf03-fec5-5994-9963-81c7e656095a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465995} {:answer/id #uuid "bb95971f-6b94-559b-95a9-14b003051ba2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465996}] :answer-field/correct {:answer/id #uuid "a65cdf03-fec5-5994-9963-81c7e656095a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465995} :answer-field/id #uuid "3cc1b2df-65bd-5c58-86b3-00c41699004f" :answer-field/key "$5\\cdot {x}_{p}(t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466841} {:answer-field/choices [{:answer/id #uuid "05b9d2e8-1e9b-52a2-bb4e-dc4e64fb5349" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465997} {:answer/id #uuid "d5caddf1-dcd5-5bf4-a544-db4b20d03736" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465998}] :answer-field/correct {:answer/id #uuid "05b9d2e8-1e9b-52a2-bb4e-dc4e64fb5349" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465997} :answer-field/id #uuid "45c65cce-ff8e-5b99-a907-83dea3f371bc" :answer-field/key "$-3\\cdot {x}_{2}(t)-{x}_{p}(t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466842} {:answer-field/choices [{:answer/id #uuid "b01d8b7b-312d-5010-b083-17b4c9d59a7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668521} {:answer/id #uuid "9314d3d2-0388-5540-8e9f-3ee096c87fa2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668522}] :answer-field/correct {:answer/id #uuid "9314d3d2-0388-5540-8e9f-3ee096c87fa2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668522} :answer-field/id #uuid "1d34d898-cf98-5ebb-84d9-b92ebd4ae6fa" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668838}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d50adfd6-221a-580f-9d34-b5717546927f" :question/math-academy-id "q-330300" :question/problem "Let ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfy the homogeneous system ${x}^{′}(t)=A\\text{ }x(t)$ and ${x}_{p}(t)$ satisfy the inhomogeneous system\n${x}^{′}(t)=A\\text{ }x(t)+f(t).$\nWhich of the following is **always** a solution of the same inhomogeneous system?\n\nSelect all that apply." :question/worked-solution "Recall that if ${x}_{h}(t)$ satisfies a homogeneous linear system ${x}^{′}(t)=Ax(t)$ and ${x}_{p}(t)$ is a particular solution to an inhomogeneous linear system ${x}^{′}(t)=Ax(t)+f(t),$ then ${x}_{h}(t)+{x}_{p}(t)$ is also a solution to the same inhomogeneous system.\n\nAdditonally, the *linearity principle* for systems of linear ordinary differential equations (ODEs) states that if ${x}_{1}(t),$ ${x}_{2}(t),…,{x}_{k}(t)$ are solutions to a homogeneous linear system ${x}^{′}(t)=Ax(t),$ then any linear combination \n\n$$\n{c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t)+⋯+{c}_{k}{x}_{k}(t)\n$$\n\nwith ${c}_{1},{c}_{2},…,{c}_{k}\\in R$ is also a solution of the same homogeneous system. \n\nWith that in mind, let's examine the given expression.\n\n- Option ${x}_{1}(t)-{x}_{2}(t)$ might be *not* a solution to the inhomogeneous system. Notice that ${x}_{1}(t)-{x}_{2}(t)$ can't be written as \n\n$$\n{x}_{h}(t)+{x}_{p}(t),\n$$\n\nwhere ${x}_{h}(t)$ is a solution of the homogeneous system, because it lacks the particular solution term ${x}_{p}(t).$\n\n- Option $5\\cdot {x}_{p}(t)$ might be *not* a solution to the inhomogeneous system. Notice that $5\\cdot {x}_{p}(t)$ can't be written as \n\n$$\n{x}_{h}(t)+{x}_{p}(t),\n$$\n\nwhere ${x}_{h}(t)$ is a solution of the homogeneous system, because of the multiplier $5$ next to the particular solution ${x}_{p}(t).$\n\n- Option $-3\\cdot {x}_{2}(t)-{x}_{p}(t)$ might be *not* a solution to the inhomogeneous system. Notice that $-3\\cdot {x}_{2}(t)-{x}_{p}(t)$ can't be written as \n\n$$\n{x}_{h}(t)+{x}_{p}(t),\n$$\n\nwhere ${x}_{h}(t)$ is a solution of the homogeneous system, because of the multiplier $-1$ next to the particular solution ${x}_{p}(t).$\n\nTherefore, the correct answer is \"None\"."} {:db/id #edb/ref 17592186319199 :knowledge-point/_questions [{:db/id #edb/ref 17592186124490 :knowledge-point/id #uuid "ca956d3e-37a8-5f0f-a062-97d0567d54e6" :knowledge-point/title "Identifying True Statements About Bases of Abstract Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26f0f70b-01ad-54d8-8ebf-898c5fe4a5ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467298} {:answer/id #uuid "fb802504-b985-574f-8a9d-3bec9d243fe1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467299}] :answer-field/correct {:answer/id #uuid "26f0f70b-01ad-54d8-8ebf-898c5fe4a5ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467298} :answer-field/id #uuid "1e9feac7-9064-55a0-bfec-cd6e08f02bc2" :answer-field/key "${{c}_{1},{c}_{2},x}$ is a basis of ${R}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468370} {:answer-field/choices [{:answer/id #uuid "899ffc4b-f3bc-5a5a-b2b2-a4baa23129c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467300} {:answer/id #uuid "49992a1c-d3d1-51dc-acc4-0664a7fe647f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467301}] :answer-field/correct {:answer/id #uuid "899ffc4b-f3bc-5a5a-b2b2-a4baa23129c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467300} :answer-field/id #uuid "e01f4bda-c99b-5a8d-abab-2d7127981cca" :answer-field/key "${{b}_{3},{b}_{1},{b}_{1}+{b}_{3}}$ is a basis of ${R}^{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468371} {:answer-field/choices [{:answer/id #uuid "288f07a5-4416-53ed-8a09-84f609c31a09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467302} {:answer/id #uuid "3e5dced2-a28c-53a7-be07-84415c967344" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467303}] :answer-field/correct {:answer/id #uuid "288f07a5-4416-53ed-8a09-84f609c31a09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467302} :answer-field/id #uuid "353db63d-6718-5fd5-b88a-f76be029806b" :answer-field/key "${x,{b}_{2},{c}_{1}}$ is a basis of ${R}^{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468372} {:answer-field/choices [{:answer/id #uuid "e32a22e2-e828-54d1-bce9-e2e4de9dfa84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668623} {:answer/id #uuid "7699dec6-1dc0-5575-b676-aeae9a87451d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668624}] :answer-field/correct {:answer/id #uuid "7699dec6-1dc0-5575-b676-aeae9a87451d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668624} :answer-field/id #uuid "93dcc7aa-6c96-5347-8048-a8b2f6387c0d" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668889}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4fa1c1b6-aa0b-5eb1-b0a4-3972a58dc98e" :question/math-academy-id "q-34768" :question/problem "Let $B={{b}_{1},{b}_{2},{b}_{3}}$ and $C={{c}_{1},{c}_{2}}$ be bases of ${R}^{3}$ and ${R}^{2}$, respectively. \n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Since $B$ and $C$ are bases, the following properties must hold:\n\n- $B$ and $C$ are maximally linearly independent sets in ${R}^{2}$ and ${R}^{3},$ respectively, and\n\n- $B$ spans ${R}^{3},$ while $C$ spans ${R}^{2}.$\n\nWith that in mind, let's examine our statements.\n\n- Statement “${{c}_{1},{c}_{2},x}$ is a basis of ${R}^{2}$” is false. Since $C={{c}_{1},{c}_{2}}$ is a basis of ${R}^{2}$, any vector of ${R}^{2},$ including the given vector $x,$ can be written as a linear combination of ${c}_{1}$ and ${c}_{2}.$ This means that ${{c}_{1},{c}_{2},x}$ is linearly dependent and therefore, cannot be a basis.\n\n- Statement “${{b}_{3},{b}_{1},{b}_{1}+{b}_{3}}$ is a basis of ${R}^{3}$” is false. The set ${{b}_{3},{b}_{1},{b}_{1}+{b}_{3}}$ is not a basis of ${R}^{3}$ because the third vector is a linear combination of ${b}_{3}$ and ${b}_{1}.$ This means that the set is linearly dependent and therefore, cannot be a basis.\n\n- Statement “${x,{b}_{2},{c}_{1}}$ is a basis of ${R}^{3}$” is false. The set ${x,{b}_{2},{c}_{1}}$ is not a basis of ${R}^{3}$ because the set contains vectors from another vector space.\n\nTherefore, the correct answer is \"None of the statements are true\"."} {:db/id #edb/ref 17592186323707 :knowledge-point/_questions [{:db/id #edb/ref 17592186124628 :knowledge-point/id #uuid "cb02b67c-90d9-5baf-b00e-590e9271d89e" :knowledge-point/title "Identifying Sets Closed Under Addition and Scalar Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b16ecbe9-c123-5857-9769-f9dac3faf9b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467328} {:answer/id #uuid "f26b27de-130c-507d-93c7-a96ecd84d877" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467329}] :answer-field/correct {:answer/id #uuid "b16ecbe9-c123-5857-9769-f9dac3faf9b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467328} :answer-field/id #uuid "71d59c2d-9307-5d0c-ae75-e6fa043a32b8" :answer-field/key "$f(x)\\in S,$ where $f(x)=2x.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468385} {:answer-field/choices [{:answer/id #uuid "105b805f-626c-510e-9607-294f6d3052af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467330} {:answer/id #uuid "c645ff3c-1f3e-52e7-a675-1735a28d5139" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467331}] :answer-field/correct {:answer/id #uuid "105b805f-626c-510e-9607-294f6d3052af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467330} :answer-field/id #uuid "15c9c1d7-7c6f-570e-bd49-f923b5d980c6" :answer-field/key "For every $p(x),q(x)\\in S,$ we have $p(x)+q(x)\\in S.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468386} {:answer-field/choices [{:answer/id #uuid "48a80cf6-9c47-5285-b19c-99279bdd2a43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467332} {:answer/id #uuid "cf7cf8b3-7bac-53b6-8c28-aef339f0ac97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467333}] :answer-field/correct {:answer/id #uuid "48a80cf6-9c47-5285-b19c-99279bdd2a43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467332} :answer-field/id #uuid "ed7fca77-deb6-591f-ae0c-b458de0a03bc" :answer-field/key "The set is closed under addition." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468387} {:answer-field/choices [{:answer/id #uuid "2ada543a-eb46-5e54-ab26-9d8b056ea184" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668631} {:answer/id #uuid "6b7242b7-2722-51ea-96ea-384590bb7104" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668632}] :answer-field/correct {:answer/id #uuid "6b7242b7-2722-51ea-96ea-384590bb7104" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668632} :answer-field/id #uuid "284f1863-edf3-5fde-b218-7f46e8dce87b" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668893}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "18aef812-0fac-5da2-8d8b-c2702b3daa12" :question/math-academy-id "q-35663" :question/problem "Let $S$ be the set of all polynomials with real coefficients and whose degree is greater than or equal to $2.$  Which of the following statements are true? \n\nSelect all that apply." :question/worked-solution "Let's verify the statements one at a time.\n\n- Statement “$f(x)\\in S,$ where $f(x)=2x.$” is false. The set $S$ contains only polynomials whose degree is greater than or equal to $2.$ However, \n\n$$\n\\operatorname{deg}⁡(2x)=1\\ne 2.\n$$\n\nTherefore, $f(x)=2x\\notin S.$\n\n- Statement “For every $p(x),q(x)\\in S,$ we have $p(x)+q(x)\\in S.$” is false. There exist functions in $S$ such that their sum is *not* in $S.$ For example, let $p(x)=x+{x}^{2}$ and $q(x)=x-{x}^{2}.$ Notice that both these functions belong to $S$ since $\\operatorname{deg}⁡(p(x))=\\operatorname{deg}⁡(q(x))=2\\ge 2.$ However,\n\n$$\n\\operatorname{deg}⁡(p(x)+q(x))=\\operatorname{deg}⁡((x+{x}^{2})+(x-{x}^{2}))=\\operatorname{deg}⁡(2x)=1≱2.\n$$\n\nHence, $p(x)+q(x)\\notin S.$\n\n- Statement “The set is closed under addition” is false. Since statement “For every $p(x),q(x)\\in S,$ we have $p(x)+q(x)\\in S.$” is false, the set is *not* closed under addition.\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186323771 :knowledge-point/_questions [{:db/id #edb/ref 17592186054816 :knowledge-point/id #uuid "1d132801-b9cc-5c0c-a8fa-0c8b840c05bd" :knowledge-point/title "Identifying Sets Containing a Given Element"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b95a8c9-ef0a-5052-a30e-f82b7c845cdc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467334} {:answer/id #uuid "3273b5a4-d168-5995-b944-97e01461a450" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467335}] :answer-field/correct {:answer/id #uuid "1b95a8c9-ef0a-5052-a30e-f82b7c845cdc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467334} :answer-field/id #uuid "66f6fb2a-591a-5d66-9453-5da4821d956f" :answer-field/key "${Z}^{-}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468388} {:answer-field/choices [{:answer/id #uuid "8be760ab-0a6d-5fd5-b5f7-486e24062b50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467336} {:answer/id #uuid "dc1f8050-3523-515b-aa66-37c702a2cfce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467337}] :answer-field/correct {:answer/id #uuid "8be760ab-0a6d-5fd5-b5f7-486e24062b50" :answer/type {: