92186440083} {:answer-field/choices [{:answer/id #uuid "10aff1c8-e1d0-5ca9-bda0-4832a0236dd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668991} {:answer/id #uuid "9c04ae05-c791-5691-b658-cbb94cb78896" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668992}] :answer-field/correct {:answer/id #uuid "9c04ae05-c791-5691-b658-cbb94cb78896" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668992} :answer-field/id #uuid "3eb153b7-dbca-50a3-9af7-531d33ba20e0" :answer-field/key "The function has no vertical asymptotes" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669295}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e0085fda-c140-5022-a903-4aa2d0060987" :question/math-academy-id "q-113554" :question/problem "Determine the vertical asymptotes of $f(x)=\\frac{2{x}^{2}-6}{{x}^{4}-9}.$\n\nSelect all that apply." :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{2{x}^{2}-6}{{x}^{4}-9} \\\\  & =\\frac{2({x}^{2}-3)}{({x}^{2}-3)({x}^{2}+3)} \\\\  & =\\frac{2\\cancel{({x}^{2}-3)}}{\\cancel{({x}^{2}-3)}({x}^{2}+3)} \\\\  & =\\frac{2}{{x}^{2}+3}\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero:\n\n$$\n{x}^{2}+3=0\n$$\n\nThis equation does not have any real solutions. Therefore, $f(x)$ has no vertical asymptotes."} {:db/id #edb/ref 17592186400205 :knowledge-point/_questions [{:db/id #edb/ref 17592186087697 :knowledge-point/id #uuid "09fa0899-a