nt :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461242}] :answer-field/correct {:answer/id #uuid "6d5145db-c8f3-5a11-bcac-ba051dfd7c68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461241} :answer-field/id #uuid "f30ac93d-bc21-5c63-abea-26c7dd4ea0fd" :answer-field/key "The series converges at $x=8$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462374} {:answer-field/choices [{:answer/id #uuid "5bcd3d23-2063-5668-8168-06e0d0261884" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667786} {:answer/id #uuid "f781cc61-aa59-558e-86cb-b30625f9a164" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667787}] :answer-field/correct {:answer/id #uuid "f781cc61-aa59-558e-86cb-b30625f9a164" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667787} :answer-field/id #uuid "7b271cae-052f-501a-8146-56e94422011d" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668170}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "21ccde81-8669-5255-b2ed-8bdddd923bd6" :question/math-academy-id "q-103152" :question/problem "Given that the power series ${\\sum }_{n=1}^{\\infty }{a}_{n}(x-5)^{n}$ converges at  $x=2,$ which of the following **must** be true?\n\nSelect all that apply." :question/worked-solution "The center of the expansion is $x=5,$ and since the series is convergent for $x=2,$ this means that the radius of convergence $R$ is *at least* $3,$ i.e., $R\\ge 3.$ So, the series is convergent for every point in the interval $[2,8).$ However, we know nothing about the convergence of the series at any point outside the interval $[2,8).$\n\n![](images/df/dfd59d22892764c4da387d48b07a6a1069ea59e13be75cd099d21ce53975d64c.png)\n\n \n\nWith this in mind, let's check each of our statements.\n\n- Statement “The series diverges at $x=6$” is false. Since $6\\in [2,8),$ the series is convergent at $x=6.$\n\n- Statement “The series converges at $x=0$” is false. Since $0\\notin [2,8),$ we cannot guarantee that the series is convergent at $x=0.$\n\n- Statement “The series converges at $x=8$” is false. Since $8\\notin [2,8),$ we cannot guarantee that the series is convergent at $x=8.$\n\nTherefore, the correct answer is \"None of the listed.\""} {:db/id #edb/ref 17592186240855 :knowledge-point/_questions [{:db/id #edb/ref 17592186068700 :knowledge-point/id #uuid "81247553-750f-5bf7-a1c4-698ad63b5ae4" :knowledge-point/title "Identifying True Statements Regarding Left- and Right-Continuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48f0646c-449a-55f7-a43e-10aed917f0d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461285} {:answer/id #uuid "6f47c9f4-cfdf-51cc-a8ee-2e312b6e2ec6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461286}] :answer-field/correct {:answer/id #uuid "48f0646c-449a-55f7-a43e-10aed917f0d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461285} :answer-field/id #uuid "e42517c5-86d0-573b-9c42-a43146a898c4" :answer-field/key "The function is left-continuous at $x=-1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462396} {:answer-field/choices [{:answer/id #uuid "be579ceb-8f73-508e-8274-146cdc8bb7b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461287} {:answer/id #uuid "19f14dea-5bfb-587c-9cb9-670c75f65f19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461288}] :answer-field/correct {:answer/id #uuid "be579ceb-8f73-508e-8274-146cdc8bb7b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461287} :answer-field/id #uuid "4ac105e7-89d8-52b0-b5e6-9803aa72f310" :answer-field/key "The function is right-continuous at $x=-1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462397} {:answer-field/choices [{:answer/id #uuid "fbd3708f-69c6-5fb0-a0c2-d6332aefe29b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461289} {:answer/id #uuid "5df81d82-6062-53b0-8ac4-34d404968f13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461290}] :answer-field/correct {:answer/id #uuid "fbd3708f-69c6-5fb0-a0c2-d6332aefe29b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461289} :answer-field/id #uuid "4deab2df-6f34-5f4c-8d22-c93a07225cea" :answer-field/key "The function is continuous at $x=-1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462398} {:answer-field/choices [{:answer/id #uuid "b8b22fff-40cd-5e6f-8cec-9c60503af7a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667792} {:answer/id #uuid "da289da4-af8c-5bd5-9aad-e1b5447b6ecd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667793}] :answer-field/correct {:answer/id #uuid "da289da4-af8c-5bd5-9aad-e1b5447b6ecd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667793} :answer-field/id #uuid "893c6e42-4b90-5359-a0bf-17543e2d6e79" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668173}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d00cc33e-d21d-57ae-828a-16fa83891b51" :question/math-academy-id "q-104357" :question/problem "![](images/30/30df82b4c47905fd8277067f9207a5e970a96d8ec386879d2872b5f5c3d8dd3c.png)\n\nWhich of the following statements are true regarding the function $y=f(x)$ plotted above?\n\nSelect all that apply." :question/worked-solution "Let's look at each statement in turn:\n\n- Statement “The function is left-continuous at $x=-1$” is false. The function is not left-continuous at $x=-1,$ since the left-sided limit is not equal to the function value:\n\n$$\n{lim}_{x\\to (-1)^{-}}f(x)=1\\ne 0=f(-1)\n$$\n\n- Statement “The function is right-continuous at $x=-1$” is false. The function is not right-continuous at $x=-1,$ since the right-sided limit is not equal to the function value:\n\n$$\n{lim}_{x\\to (-1)^{+}}f(x)=-1\\ne 0=f(-1)\n$$\n\n- Statement “The function is continuous at $x=-1$” is false. In order for the function to be continuous at $x=-1,$ it must be both left-continuous and right-continuous. However, we have already determined that the function is neither left-continuous nor right-continuous at this point.\n\nIn conclusion, none of the statements are true."} {:db/id #edb/ref 17592186240912 :knowledge-point/_questions [{:db/id #edb/ref 17592186054815 :knowledge-point/id #uuid "abc6b3ee-0251-5c9c-9358-bd192c434dd1" :knowledge-point/title "Identifying Elements Belonging to Scripted Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ed6e077-80c9-5fa7-9d60-8d55f195c7aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :ans