d #uuid "c92efe53-6bfe-508b-9086-9f2999f18050" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668997} {:answer/id #uuid "2633f99f-633a-5f22-af06-0674b6dff122" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668998}] :answer-field/correct {:answer/id #uuid "2633f99f-633a-5f22-af06-0674b6dff122" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668998} :answer-field/id #uuid "dcb39d82-ca04-57be-ae9b-3e068b768beb" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669298}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d62099c6-5c34-55aa-ad1f-5500db9aeb0d" :question/math-academy-id "q-122932" :question/problem "Which of the following are partitions of the real interval $[-4,6]?$\n\nSelect all that apply." :question/worked-solution "A partition $P$ of a closed interval $[a,b]$ is a finite sequence of real numbers taken from $[a,b]$ such that\n\n$$\na={x}_{0}<{x}_{1}<{x}_{2}<…<{x}_{n}=b\\,.\n$$\n\nWe can express $P$ using set notation as\n\n$$\nP={{x}_{0},{x}_{1},…,{x}_{n}}.\n$$\n\n \n\nWith that in mind, let's consider each statement:\n\n- Statement $-5<-4<-2<0<4<6$ is not a partition of $[-4,6]$ since $-5$ does not belong to $[-4,6].$\n\n- Statement ${-3,3,5,6}$ is not a partition of $[-4,6]$ since it does not include the left endpoint $a=-4.$\n\n- Statement ${-4,4,5}$ is not a partition of  $[-4,6]$ since it does not include the right endpoint $b=6.$\n\nTherefore, the correct answer is \"None of the statements give a partition of  $[-4,6].$\""} {:db/id #edb/ref 17592186399398 :knowledge-point/_questions [{:db/id #edb/ref 17592186176053 :knowledge-point/id #uuid "92d6129b-a5c5-597a-86ee-3f19af20f326" :knowledge-point/title "Describing the General Properties of the Cosecant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59486814-0d8e-599a-bf0f-57dc550e7b15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437330} {:answer/id #uuid "a1dce793-5565-5d7f-905d-7cd04e4d56ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437331}] :answer-field/correct {:answer/id #uuid "59486814-0d8e-599a-bf0f-57dc550e7b15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437330} :answer-field/id #uuid "a341d84b-92d9-5335-b0b9-fd13587dacad" :answer-field/key "The range of the function is $(-\\infty ,-1].$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438694} {:answer-field/choices [{:answer/id #uuid "74c41ab1-5221-54d6-bfb2-b2d2b1a66a85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437332} {:answer/id #uuid "79a66b2d-395b-5d7a-972b-1551475dda80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437333}] :answer-field/correct {:answer/id #uuid "74c41ab1-5221-54d6-bfb2-b2d2b1a66a85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437332} :answer-field/id #uuid "1d83191a-11eb-57de-8d9a-63c9eb52fa02" :answer-field/key "$y=-1$ is the maximum value of the function." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438695} {:answer-field/choices [{:answer/id #uuid "6e7478e7-5c82-57c4-9e23-eb0f7d938047" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #