er/id #uuid "ef4f5c5f-3398-5540-9361-58d558e57438" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668028} {:answer/id #uuid "184312d5-c485-5c3b-9c21-9aefbffac05e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668029}] :answer-field/correct {:answer/id #uuid "184312d5-c485-5c3b-9c21-9aefbffac05e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668029} :answer-field/id #uuid "9c4c7d69-bad2-55ff-b22f-784b6f1a7741" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668291}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "028630ef-e1bc-5d42-ac61-af7d94939f1a" :question/math-academy-id "q-34318" :question/problem "Which of the diagrams shown below represent subspaces of ${R}^{2}?$\n\nSelect all that apply." :question/worked-solution "Let's analyze each diagram in turn.\n\n- Diagram I does not represent a subspace. The vector $a=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}$ lies inside given subset. But\n\n$$\n(-1)\\cdot a=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}\n$$\n\nlies outside the subset.\n\n- Diagram II does not represent a subspace. The vector $a=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}$ lies inside given subset. But\n\n$$\n(-1)\\cdot a=\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}\n$$\n\nlies outside the subset.\n\n- Diagram III does not represent a subspace since in does not contain the zero-vector.\n\nSo, the correct answer is \"None\"."} {:db/id #edb/ref 17592186237975 :knowledge-point/_questions [{:db/id #edb/ref 17592186175956 :knowledge-point/id #uuid "60f61c26-ff2d-5343-becd-d8f44f623cd3" :knowledge-point/title "Identifying True Statements Regarding the Convergence of a Power Series"}] :question/an