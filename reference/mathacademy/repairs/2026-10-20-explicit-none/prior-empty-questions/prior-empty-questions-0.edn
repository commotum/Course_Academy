er/id #uuid "f3e4a19a-3b1e-52c2-a9b9-12b81d32f9b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474331}] :answer-field/correct {:answer/id #uuid "7f0d690b-a2af-51f1-908f-dcffce79cd11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474330} :answer-field/id #uuid "619d29e9-1652-56eb-a3ec-9f5d3d435236" :answer-field/key "$733\\,123$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475091} {:answer-field/choices [{:answer/id #uuid "ceedd337-fbde-579b-802e-f95f96ad25d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669045} {:answer/id #uuid "0b6cfaf6-3a2a-50d9-b7b9-f8fd34f824f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669046}] :answer-field/correct {:answer/id #uuid "0b6cfaf6-3a2a-50d9-b7b9-f8fd34f824f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669046} :answer-field/id #uuid "f7c525d3-55f2-5cd3-a7f9-b1269c6001ed" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669322}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e2757e05-6aab-58ae-aed8-77516507381e" :question/math-academy-id "q-132392" :question/problem "Which of the following numbers are divisible by $9?$\n\nSelect all that apply." :question/worked-solution "A number is divisible by $9$ if the sum of its digits is divisible by $9.$\n\n- The sum of the digits of $34\\,154\\,119$ is\n\n$$\n3+4+1+5+4+1+1+9=28,\n$$\n\nwhich is *not* divisible by $9.$ So, $34\\,154\\,119$ is *not* divisible by $9.$\n\n- The sum of the digits of $9\\,173\\,589$ is\n\n$$\n9+1+7+3+5+8+9=42,\n$$\n\nwhich is *not* divisible by $9.$ So, $9\\,173\\,589$ is *not* divisible by $9.$\n\n- The sum of the digits of $733\\,123$ is\n\n$$\n7+3+3+1+2+3=19,\n$$\n\nwhich is *not* divisible by $9.$ So, $733\\,123$ is *not* divisible by $9.$\n\nTherefore, the correct answer is \"None.\""}]
