db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475254} {:answer-field/choices [{:answer/id #uuid "686058aa-da96-595d-9b50-2b2372185695" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669143} {:answer/id #uuid "58b347d7-9af0-512f-98ba-2c93692916de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669144}] :answer-field/correct {:answer/id #uuid "58b347d7-9af0-512f-98ba-2c93692916de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669144} :answer-field/id #uuid "2682511f-acf0-5786-add9-9497b25749a2" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669371}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "72fa77bc-6d37-516a-bc08-8cef3db1618e" :question/math-academy-id "q-214252" :question/problem "Consider the following relation defined on the set $N.$\n\n$$\nx\\,R\\,y\\,⇔\\,y∤x\n$$\n\n Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Given a relation $R$ on a set $A$:\n\n- $R$ is reflexive if and only if for all $x\\in A,$ $x\\,R\\,x.$\n\n- $R$ is symmetric if and only if for all $x,y\\in A,$ if $x\\,R\\,y,$ then $y\\,R\\,x.$\n\n- $R$ is transitive if and only if for all $x,y,z\\in A,$ if $x\\,R\\,y$ and $y\\,R\\,z,$ then $x\\,R\\,z.$\n\nIf $R$ is reflexive, symmetric, and transitive, then $R$ is an equivalence relation.\n\nLet's consider each of the properties in turn.\n\n- The relation $R$ is not reflexive. For example, $3∣3.$\n\n- The relation $R$ is not symmetric. For example, $9∤3$ but $3∣9.$\n\n- The relation $R$ is not transitive. For example, $3∤2$ and $2∤9,$ but $3∣9.$\n\n- The relation $R$ is not an equivalence relation since it's neither reflexive nor symmetric nor transitive.\n\nTherefore, the correct answer is \"None.\""} {:db/id #edb/ref 17592186424375 :knowledge-point/_questions [{:db/id #edb/ref 17592186166841 :knowledge-point/id #uuid "00b14560-29f9-58fc-ac65-5505987579fb" :knowledge-point/title "Determining Situations That Can Be Modeled as a Discrete Uniform Distribution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b14ecc36-432b-56ec-87ab-282eea355b8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186475002} {:answer/id #uuid "d834568e-ce97-583c-8040-fc4e266d52c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186475003}] :answer-field/correct {:answer/id #uuid "b14ecc36-432b-56ec-87ab-282eea355b8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186475002} :answer-field/id #uuid "cdad22ae-e385-521b-b788-7347685ca5ee" :answer-field/key "The temperature of a town on a certain day." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475427} {:answer-field/choices [{:answer/id #uuid "12cca481-ff11-55c7-91de-86d18673b2bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186475004} {:answer/id #uuid "e8dfccef-97df-539d-8b11-97c54d234ef3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186475005}] :answer-field/correct {:answer/id #uuid "12cca481-ff11-55c7-91de-86d18673b2bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186475004} :answer-field/id #uuid "00c49dca-0d5f-5b4f-bddf-bbbd54a75e97" :answer-field/key "The number of letters of a word randomly selected from an English dictionary."