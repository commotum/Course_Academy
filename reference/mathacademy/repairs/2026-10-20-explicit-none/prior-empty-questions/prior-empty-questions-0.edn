 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470707} :answer-field/id #uuid "44ab2c15-20df-54dd-b6fd-3f24203d3699" :answer-field/key "$f$ is a surjection" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471859} {:answer-field/choices [{:answer/id #uuid "c0ef4a3b-c0b0-5cee-b5ae-94a5bd059a63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668963} {:answer/id #uuid "78bdcce5-f2b0-5cb3-bb1d-c572808123d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668964}] :answer-field/correct {:answer/id #uuid "78bdcce5-f2b0-5cb3-bb1d-c572808123d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668964} :answer-field/id #uuid "1e7816d8-e5a4-549e-a0e4-a6749607dccf" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669281}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e7e09caa-cacf-54dd-ae93-0599cdfc3d85" :question/math-academy-id "q-104957" :question/problem "![](images/80/801bb98497bc275acda854447fffee30721bc54b2711ac632c2269f0c1eb64ed.png)\n\nWhich of the following statements are true regarding the function $f:X\\to Y$ represented by the mapping diagram above?\n\nSelect all that apply." :question/worked-solution "A function $f:X\\to Y$ is a surjection (also known as *onto*) if, for *every* element $y$ in $Y,$ there is *at least one* element in $X$ that maps to $y:$ \n\n$f:X\\to Y$ is a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement “There exists some $x$ contained within $X$ such that $f(x)=-1$” is false. As we can see from the diagram, there are no elements contained within $X$ that have an arrow to $-1\\in Y.$ Hence, $f(x)\\ne -1$ for all $x\\in X.$\n\n- Statement “$∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y$” is false. Since statement “There exists some $x$ contained within $X$ such that $f(x)=-1$” is false,  it's *not true* that for all $y$ contained within $Y,$ there exists some $x$ contained within $X$ such that $f(x)=y.$\n\n- Statement “$f$ is a surjection” is false. Indeed, since statement “$∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y$” is false, $f$ is not a surjection.\n\nTherefore, the correct answer is \"None.\""} {:db/id #edb/ref 17592186381791 :knowledge-point/_questions [{:db/id #edb/ref 17592186152089 :knowledge-point/id #uuid "6927f03c-aa7a-56ac-8cd0-c036a11aadc9" :knowledge-point/title "Finding the Truth Value of a Statement Involving Nested Quantifiers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9d0b4f3-89cc-5718-9b99-3608b198a961" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471281} {:answer/id #uuid "37313c70-39b7-5dc9-b3c4-a19acf370901" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471282}] :answer-field/correct {:answer/id #uuid "e9d0b4f3-89cc-5718-9b99-3608b198a961" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471281} :answer-field/id #uuid "c43f4f46-1ff7-5a5f-b67a-a7033ebb99e9" :answer-field/key "$∀\\,y\\in R,\\,\\sqrt{2y}\\in R.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472146} {:answer-field/choices [{:answer/id #uuid "03e7b892-0684-5b9b-b9b2-a3f62c816e38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471283} {:answer/id #uuid "d1ca0b4c-5971-598e-b066-6bedf819e07d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471284}] :answer-field/correct {:answer/id #uuid "03e7b892-0684-5b9b-b9b2-a3f62c816e38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471283} :answer-field/id #uuid "abe01474-e943-5480-b617-9630e94ff1a0" :answer-field/key "The truth set of the predicate $(\\,∀\\,y\\in R,\\,\\sqrt{xy}\\in R\\,)$ is $R.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472147} {:answer-field/choices [{:answer/id #uuid "a9a3cdfb-8bb9-54ae-8804-4c4f876ac849" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471285} {:answer/id #uuid "e8fce173-02a3-518a-95ef-ae472714bf66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471286}] :answer-field/correct {:answer/id #uuid "a9a3cdfb-8bb9-54ae-8804-4c4f876ac849" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471285} :answer-field/id #uuid "24f5bbf3-595e-55dd-8c22-bb49db12000e" :answer-field/key "$∀\\,x,y\\in R,\\,\\sqrt{xy}\\in R.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472148} {:answer-field/choices [{:answer/id #uuid "836bdb29-61aa-5188-8618-f1f866afbcf9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669131} {:answer/id #uuid "70c19309-b0a6-5fd9-b7bc-05bb97356a51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669132}] :answer-field/correct {:answer/id #uuid "70c19309-b0a6-5fd9-b7bc-05bb97356a51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669132} :answer-field/id #uuid "77fe6259-4cd1-5ba9-8d3c-37f31764b518" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669365}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "44159662-1bf3-5bee-9ce6-75e394e9c1e7" :question/math-academy-id "q-183586" :question/problem "Let $x\\in R$ and $y\\in R.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, notice that the statement \n\n$$\n∀\\,x,y\\in R,\\,\\sqrt{xy}\\in R\n$$\n\nfrom option $∀\\,x,y\\in R,\\,\\sqrt{xy}\\in R.$ reads as follows:\n\n$\\,$ For all reals $x$ and $y,$ we have $\\sqrt{xy}\\in R.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement $∀\\,y\\in R,\\,\\sqrt{2y}\\in R.$ is false since $\\sqrt{2y}\\in R$ is not true for some real $y.$ Say, for $y=-1.$\n\n- Statement “The truth set of the predicate $(\\,∀\\,y\\in R,\\,\\sqrt{xy}\\in R\\,)$ is $R.$” is false. For the predicate\n\n$$\nP(x):\\,∀\\,y\\in R,\\,\\sqrt{xy}\\in R\n$$\n\nwe note that $P(x)$ is false for all values $x\\in R.$ For example, \n\n$$\nP(1):\\,∀\\,y\\in R,\\,\\sqrt{y}\\in R\n$$\n\nis false, since we can take $y=-1.$ Similarly,\n\n$$\nP(2):\\,∀\\,y\\in R,\\,\\sqrt{2y}\\in R\n$$\n\nis false, since we can take $y=-2.$ In general, it's sufficient to take $y=-x$ for any value of $x.$\n\n- Statement $∀\\,x,y\\in R,\\,\\sqrt{xy}\\in R.$ is false. The sentence \n\n$$\n(\\,∀\\,x,y\\in R,\\,\\sqrt{xy}\\in R\\,)\n$$\n\n \ncan be written as\n\n$$\n∀x\\in R\\,(\\,\\underbrace{∀y\\in R,\\,\\sqrt{xy}\\in R}_{P(x)}\\,)\n$$\n\nwhich is true whenever the inner predicate $P(x)$ is true over the universal set $R.$ But, according to statement “The truth set of the predicate $(\\,∀\\,y\\in R,\\,\\sqrt{xy}\\in R\\,)$ is $R.$”, this is not the case.\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186382813 :knowledge-point/_questions [{:db/id #edb/ref 17592186152263 :knowledge-point/id #uuid "bfbebc20-1b48-5718-a057-b743c8af8de1" :knowledge-point/title "Identifying Bijections For Functions Defined on the Set of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fbd78fe-5ede-5795-9622-962461ceaffd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470823} {:answer/id #uuid "9de6e2bf-f8e9-549b-9aed-e689c26328e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470824}] :answer-field/correct {:answer/id #uuid "4fbd78fe-5ede-5795-9622-962461ceaffd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470823} :answer-field/id #uuid "3837b8ab-5872-5992-97f4-40787670506a" :answer-field/key "The function is an injection" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471917} {:answer-field/choices [{:answer/id #uuid "ca534b3e-7b8d-50f0-8361-4fe1356e93d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470825} {:answer/id #uuid "d603d976-e8c8-5eb2-8c88-cea3ab366fdd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470826}] :answer-field/correct {:answer/id #uuid "ca534b3e-7b8d-50f0-8361-4fe1356e93d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470825} :answer-field/id #uuid "e4e0316e-a490-5722-a171-17b4936ef2c1" :answer-field/key "The function is a surjection" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471918} {:answer-field/choices [{:answer/id #uuid "4c5d5dc3-30a6-556f-a142-ba2a5ab13561" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470827} {:answer/id #uuid "551313b9-9c31-565f-bd3f-853edba26752" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470828}] :answer-field/correct {:answer/id #uuid "4c5d5dc3-30a6-556f-a142-ba2a5ab13561" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470827} :answer-field/id #uuid "7f1b659c-be5a-5301-b7ea-21955cb2e5fa" :answer-field/key "The function is a bijection" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471919} {:answer-field/choices [{:answer/id #uuid "e48f4bed-239c-5504-bcad-7b554015841f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668971} {:answer/id #uuid "c58a53fb-8ddc-53ea-8947-5b9a1fdc5317" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668972}] :answer-field/correct {:answer/id #uuid "c58a53fb-8ddc-53ea-8947-5b9a1fdc5317" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668972} :answer-field/id #uuid "6782b334-995b-5353-8da2-c7d154db51cf" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669285}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ea34001e-7666-5760-9335-3a797f196771" :question/math-academy-id "q-105330" :question/problem "![](images/88/8845d8cc2664c92637e06961f1d5c17b98afcb72470d1463fbd58aaf5691ca4c.png)\n\nFor the function $f:R\\to R$ defined by $f(x)=(x+1)^{2}-2$, which of the following statements are true?  \n\nSelect all that apply." :question/worked-solution "Recall that a function $f:X\\to Y$ is \n\n- an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ whenever $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2},$\n\n- a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y,$\n\n- a bijection if it is both a surjection and an injection.\n\nWith this in mind, let's check each statement.\n\n- Statement “The function is an injection” is false. There are horizontal lines (such as the one depicted below) that cross the graph of $f(x)$ more than once.\n\n![](images/d6/d6b2a99811341aa07bc3e91df973504fad57ac4a71a38406707b5d311247d61d.png)\n\n        \n\n- Statement “The function is a surjection” is false. For example, there is not $x\\in R$ such that $f(x)=-4.$ So, $f$ is not a surjection.\n\n- Statement “The function is a bijection” is false, because the function is not both an injection and a surjection.\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186385706 :knowledge-point/_questions [{:db/id #edb/ref 17592186152196 :knowledge-point/id #uuid "a347133c-5e5a-5dd2-89ef-bdd14245ee6b" :knowledge-point/title "Identifying Injections For Functions Defined on the Set of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6cec6272-e3c1-5d79-8e5f-cb77ba066b60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471615} {:answer/id #uuid "59363834-1ac9-5e0d-9623-b9bdf850fa57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471616}] :answer-field/correct {:answer/id #uuid "6cec6272-e3c1-5d79-8e5f-cb77ba066b60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471615} :answer-field/id #uuid "9c8166f1-6fe1-57a1-9c84-1d90e80859df" :answer-field/key "$f(-2)\\ne f(1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472313} {:answer-field/choices [{:answer/id #uuid "f98ee01d-c506-56f5-b241-ee8d6979bf62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471617} {:answer/id #uuid "c8f29d7b-ddc2-512a-884a-f31bc704d36f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471618}] :answer-field/correct {:answer/id #uuid "f98ee01d-c506-56f5-b241-ee8d6979bf62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471617} :answer-field/id #uuid "e7e346a9-d793-5487-abe6-bdec0eca1c88" :answer-field/key "$∀\\,{x}_{1},{x}_{2}\\in R,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472314} {:answer-field/choices [{:answer/id #uuid "8ed9cbc2-9dea-5d6b-9553-cdf98fc3d93d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471619} {:answer/id #uuid "691c6242-9f3b-57a5-9a92-094e02607d79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471620}] :answer-field/correct {:answer/id #uuid "8ed9cbc2-9dea-5d6b-9553-cdf98fc3d93d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471619} :answer-field/id #uuid "8dd29552-cf51-56f9-888e-09e014b8609f" :answer-field/key "$f$ is **one-to-one**" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472315} {:answer-field/choices [{:answer/id #uuid "65bbf047-cbe1-5c94-b13f-fce260a7d8d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669205} {:answer/id #uuid "eff23ee2-f8bc-5589-9bf1-c70d2cfe563f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669206}] :answer-field/correct {:answer/id #uuid "eff23ee2-f8bc-5589-9bf1-c70d2cfe563f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669206} :answer-field/id #uuid "dbff7caa-8171-54b0-bf2b-26679818795e" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669402}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "eb0a5436-5069-574d-ac30-ea6987db593d" :question/math-academy-id "q-80376" :question/problem "![](images/2d/2d81a4317d789968de29f34b42358d44e74c8bbe4717467a4c780beb633dc0d5.png)\n\nWhich of the following statements are true regarding the function $f:R\\to R$ whose graph is shown above?\n\nSelect all that apply." :question/worked-solution "A function $f:X\\to Y$ is an injection (also known as *one-to-one*) if *every* element in $X$ is mapped to a *distinct* element in $Y:$ \n\n$f:X\\to Y$ is an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement $f(-2)\\ne f(1)$ is false. According to the graph, we have $f(-2)=f(1)=-1.$\n\n- Statement “$∀\\,{x}_{1},{x}_{2}\\in R,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}$” is false. Again, we have $f(-2)=f(1)$ but $-2\\ne 1.$ So, it's *not true* that for all ${x}_{1}$ and ${x}_{2}$ contained within the domain $R,$ if $f({x}_{1})$ and $f({x}_{2})$ are equal, then we must have ${x}_{1}={x}_{2}.$\n\n- Statement “$f$ is **one-to-one**” is false. Indeed, since statement “$∀\\,{x}_{1},{x}_{2}\\in R,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}$” is false, $f$ is not an injection (also known as *one-to-one*).\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186385782 :knowledge-point/_questions [{:db/id #edb/ref 17592186152262 :knowledge-point/id #uuid "22bcdfb2-485a-5242-a5b5-dd9ef8cee027" :knowledge-point/title "Identifying Bijections For Functions Defined as Mapping Diagrams"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f5a15ef-9aac-5edc-8478-bfff007cdfd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471717} {:answer/id #uuid "8322b784-b416-5f2c-bfb8-2580815fc7c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471718}] :answer-field/correct {:answer/id #uuid "5f5a15ef-9aac-5edc-8478-bfff007cdfd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471717} :answer-field/id #uuid "ca609a76-06c8-52db-8581-bd5c3848e1f6" :answer-field/key "$f$ is a surjection" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472364} {:answer-field/choices [{:answer/id #uuid "aee82d31-5b7a-5582-a21b-2fa920919744" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471719} {:answer/id #uuid "3b0099d8-c719-5963-a690-03e8e902693a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471720}] :answer-field/correct {:answer/id #uuid "aee82d31-5b7a-5582-a21b-2fa920919744" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471719} :answer-field/id #uuid "7c020536-4c05-52fe-a219-595565574cf0" :answer-field/key "$f$ is an injection" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472365} {:answer-field/choices [{:answer/id #uuid "5caacba0-5907-578d-8806-41c31bfd65ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471721} {:answer/id #uuid "aa6c6ef8-4b43-5a6a-ad55-0aa584b65ca5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471722}] :answer-field/correct {:answer/id #uuid "5caacba0-5907-578d-8806-41c31bfd65ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471721} :answer-field/id #uuid "d7d9db8e-6447-574c-a155-456b3f1f55a7" :answer-field/key "$f$ is a bijection" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472366} {:answer-field/choices [{:answer/id #uuid "b2b16c5f-89f1-5a6b-a223-56e8d516be52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669227} {:answer/id #uuid "7d287e60-5ff8-50b9-8152-a2c3322ae5da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669228}] :answer-field/correct {:answer/id #uuid "7d287e60-5ff8-50b9-8152-a2c3322ae5da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669228} :answer-field/id #uuid "df5fa19e-5c26-5c89-9440-74b5ad60115a" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669413}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "da5d5f20-c614-5648-b2cd-38bf72010ec2" :question/math-academy-id "q-82314" :question/problem "![](images/12/126abe41ac185c082d8cc28628e2db4b2708dd84ba351718184d949ddf582d3c.png)\n\nWhich of the following statements are true regarding the function $f:X\\to Y$ represented by the mapping diagram above?\n\nSelect all that apply." :question/worked-solution "Recall that a function $f:X\\to Y$ is \n\n- a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y,$\n\n- an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ whenever $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2},$\n\n- a bijection if it is both a surjection and an injection.\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement “$f$ is a surjection” is false. Consider $y=2.$ As we can see from the diagram, there are no elements contained within $X$ that have an arrow to $2\\in Y.$ So, it's *not true* that for all $y$ contained within $Y,$ there exists some $x$ contained within $X$ such that $f(x)=y.$ As a result, $f$ is *not* a surjection.\n\n- Statement “$f$ is an injection” is false. We have $f(1)=f(4)$ but $1\\ne 4.$ So, it's *not true* that for all ${x}_{1}$ and ${x}_{2}$ contained within the domain $X,$ if $f({x}_{1})$ and $f({x}_{2})$ are equal, then we must have ${x}_{1}={x}_{2}.$ As a result, $f$ is *not* an injection.\n\n- Statement “$f$ is a bijection” is false. Indeed, since statement “$f$ is a surjection” is false (as well as statement “$f$ is an injection”), $f$ is not a bijection.\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186385789 :knowledge-point/_questions [{:db/id #edb/ref 17592186152263 :knowledge-point/id #uuid "bfbebc20-1b48-5718-a057-b743c8af8de1" :knowledge-point/title "Identifying Bijections For Functions Defined on the Set of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c8921441-1dc4-5449-aacb-e1ab5bc13f5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471723} {:answer/id #uuid "623e141a-1cbf-55c1-8dbd-d594b76a28d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471724}] :answer-field/correct {:answer/id #uuid "c8921441-1dc4-5449-aacb-e1ab5bc13f5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471723} :answer-field/id #uuid "577e30c4-9496-58ff-bd73-fb5da086efb0" :answer-field/key "The function is an injection" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472367} {:answer-field/choices [{:answer/id #uuid "3da7e484-02af-5597-b1fd-da3b8176ebd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471725} {:answer/id #uuid "27e78f90-3fd0-5f93-8b4a-141561c450e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471726}] :answer-field/correct {:answer/id #uuid "3da7e484-02af-5597-b1fd-da3b8176ebd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471725} :answer-field/id #uuid "ffdb055f-fba7-53d5-b7b3-3316bc59ab59" :answer-field/key "The function is a surjection" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472368} {:answer-field/choices [{:answer/id #uuid "c3102ac0-d1e5-5474-bfac-ad06557b03a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471727} {:answer/id #uuid "195ad897-7a48-5a52-a5b1-f9353b04ade4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471728}] :answer-field/correct {:answer/id #uuid "c3102ac0-d1e5-5474-bfac-ad06557b03a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471727} :answer-field/id #uuid "cfaefc0f-ab90-5d24-983f-2d76b9e850dd" :answer-field/key "The function is a bijection" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472369} {:answer-field/choices [{:answer/id #uuid "86737f31-dfad-5a7b-937a-a3a1e32685aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669229} {:answer/id #uuid "4c748b8f-1f19-5a77-8ce1-848bde76f715" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669230}] :answer-field/correct {:answer/id #uuid "4c748b8f-1f19-5a77-8ce1-848bde76f715" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669230} :answer-field/id #uuid "bb97f406-8f0d-5deb-9507-c824c3e2d933" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669414}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "24770296-d90b-538e-85f2-59d06d26123a" :question/math-academy-id "q-82317" :question/problem "For the function $f:R\\to R$ defined by $f(x)=\\operatorname{sin}⁡x,$ which of the following  statements are true? \n\nSelect all that apply." :question/worked-solution "Recall that a function $f:X\\to Y$ is \n\n- an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ whenever $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2},$\n\n- a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y,$\n\n- a bijection if it is both a surjection and an injection.\n\nWith this in mind, let's check each statement.\n\n- Statement “The function is an injection” is false. For instance, $f(0)=\\operatorname{sin}⁡(0)=0=\\operatorname{sin}⁡(2\\pi )=f(2\\pi )$, but $0\\ne 2\\pi .$ So, $f(x)$ is not an injection.\n\n- Statement “The function is a surjection” is false. For example, there is no $x\\in R$ such that $f(x)=2.$ So, $f(x)$ is not a surjection.\n\n- Statement “The function is a bijection” is false because the function is not both an injection and a surjection.\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186385796 :knowledge-point/_questions [{:db/id #edb/ref 17592186152263 :knowledge-point/id #uuid "bfbebc20-1b48-5718-a057-b743c8af8de1" :knowledge-point/title "Identifying Bijections For Functions Defined on the Set of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9bfbaec4-002f-56da-b603-ecb64b489280" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471729} {:answer/id #uuid "ad13d9ab-3383-5fe3-ad9c-1c106572bb65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471730}] :answer-field/correct {:answer/id #uuid "9bfbaec4-002f-56da-b603-ecb64b489280" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471729} :answer-field/id #uuid "fc29d875-c71c-520b-b763-2a953d8a8bac" :answer-field/key "The function is an injection" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472370} {:answer-field/choices [{:answer/id #uuid "9720022a-1f68-56cc-99ed-1f884d93030f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471731} {:answer/id #uuid "4c7bbe52-574b-5d7b-b291-b264d3610735" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471732}] :answer-field/correct {:answer/id #uuid "9720022a-1f68-56cc-99ed-1f884d93030f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471731}