ices [{:answer/id #uuid "a8c8dacf-d3fa-5621-a2fb-3c9e2f2a9d34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668633} {:answer/id #uuid "3b56d96d-cb20-55ba-a428-0285e15cbb39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668634}] :answer-field/correct {:answer/id #uuid "3b56d96d-cb20-55ba-a428-0285e15cbb39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668634} :answer-field/id #uuid "a33e8114-f0c1-575b-a1b8-6d10f2763b3c" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668894}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f51862bd-578b-533f-86e5-e297bb989e9a" :question/math-academy-id "q-36244" :question/problem "To which of the following sets do all the real numbers belong?\n\nSelect all that apply." :question/worked-solution "- The set ${Z}^{-}$ contains all the negative integer numbers. However, real numbers as, for instance, $\\sqrt{2}$ don't belong to ${Z}^{-},$ so ${Z}^{-}$ does *not* contain the real numbers. $\\,\\times $\n\n- The set $N$ contains all the natural numbers. However, real numbers as, for instance, $\\sqrt{2}$ don't belong to $N,$ so $N$ does *not* contain the real numbers. $\\,\\times $\n\n- The set $Q$ contains all the rational numbers. However, real numbers as, for instance, $\\sqrt{2}$ don't belong to $Q,$ so $Q$ does *not* contain the real numbers. $\\,\\times $\n\n- The set ${Q}^{-}$ contains all the negative rational numbers. However, real numbers as, for instance, $\\sqrt{2}$ don't belong to ${Q}^{-},$ so ${Q}^{-}$ does *not* contain the real numbers. $\\,\\times $\n\nTherefore, the correct answer is \"None.\""} {:db/id #edb/ref 17592186326691 :knowledge-poi