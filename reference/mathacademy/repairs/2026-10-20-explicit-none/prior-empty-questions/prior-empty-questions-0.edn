ct {:answer/id #uuid "7c9537f9-51e9-55d0-b94f-649bdda35d6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668650} :answer-field/id #uuid "8c3015de-69d8-52d1-abe7-3b65625a68a8" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668902}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "994b0436-bb09-5be1-b2e9-9e0b690f2b7e" :question/math-academy-id "q-39203" :question/problem "Suppose $(a+b)\\cdot a=0$, where $a\\ne 0.$ Which of the following statements are true? \n\nSelect all that apply." :question/worked-solution "Let's analyze each statement in turn.\n\n- Statements $b\\cdot a>0$ and $b\\cdot a=0$ are false. Simplifying the expression $(a+b)\\cdot a=0$, we have\n\n$$\n\\begin{aligned}(a+b)\\cdot a & =0 \\\\ a\\cdot a+b\\cdot a & =0 \\\\ b\\cdot a & =-a\\cdot a\\end{aligned}\n$$\n\n \nSince $a\\ne 0$ implies that $a\\cdot a>0$, we obtain that $-a\\cdot a<0.$\n\n- Statement $a\\cdot a=0$ is false. Since $a\\ne 0,$ we must have $a\\cdot a>0.$\n\nTherefore, we conclude that none of the statements are true."} {:db/id #edb/ref 17592186326753 :knowledge-point/_questions [{:db/id #edb/ref 17592186129321 :knowledge-point/id #uuid "359bc41e-1b6d-5177-9642-4f8697bc5ba0" :knowledge-point/title "Identifying Rotation-Scaling Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "730a249f-9909-593e-987f-dcb1e3654985" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467446} {:answer/id #uuid "7f562f29-d90e-52f9-a7c0-0ade3faa4c2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467447}] :answer-field/correct {:answer/id #uuid "730a249f-9909-593e-987f-dcb1e3654985" :answer/type {:db/