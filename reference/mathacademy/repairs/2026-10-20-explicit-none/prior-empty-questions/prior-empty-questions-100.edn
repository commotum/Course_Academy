186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475335} {:answer-field/choices [{:answer/id #uuid "04fb905e-e74d-5d79-b882-03aceed66713" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474820} {:answer/id #uuid "dcf0a431-8efe-5df5-ab12-1ca33c633645" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474821}] :answer-field/correct {:answer/id #uuid "04fb905e-e74d-5d79-b882-03aceed66713" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474820} :answer-field/id #uuid "ad31b141-6411-5cf5-a477-5373690eb045" :answer-field/key "$W=\\{\\begin{bmatrix}6 \\\\ 1 \\\\ -1\\end{bmatrix},\\begin{bmatrix}2 \\\\ 3 \\\\ 1\\end{bmatrix},\\begin{bmatrix}0 \\\\ -1 \\\\ 0\\end{bmatrix}\\}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475336} {:answer-field/choices [{:answer/id #uuid "ebc3de7c-b579-5bbf-aeea-55db25e493c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669191} {:answer/id #uuid "d065d1f0-99f9-53a3-9e72-0faf6c920ff1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669192}] :answer-field/correct {:answer/id #uuid "d065d1f0-99f9-53a3-9e72-0faf6c920ff1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669192} :answer-field/id #uuid "4983c225-f2a8-5e12-8e2c-5094b85a894b" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669395}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9cc85c8f-2fc1-51b5-90b3-b4c40aaa9ac5" :question/math-academy-id "q-40288" :question/problem "Which of the following sets are orthogonal?\n\nSelect all that apply." :question/worked-solution "Let's denote the vectors of the given sets as \n$\\{{u}_{1},{u}_{2},{u}_{3}\\},$ \n$\\{{v}_{1},{v}_{2}\\},$ and \n$\\{{w}_{1},{w}_{2},{w}_{3}\\},$ respectively. \n\nThe sets $U,V,$ and $W$ are orthogonal if the following conditions on each set hold:\n\n- ${u}_{1}\\cdot {u}_{2}=0,\\,{u}_{1}\\cdot {u}_{3}=0,\\,{u}_{2}\\cdot {u}_{3}=0.$\n\n- ${v}_{1}\\cdot {v}_{2}=0.$\n\n- ${w}_{1}\\cdot {w}_{2}=0,\\,{w}_{1}\\cdot {w}_{3}=0,\\,{w}_{2}\\cdot {w}_{3}=0.$\n\nWith that in mind, let's examine our sets in turn.\n\n- The set $U$ cannot be orthogonal since it contains  $3$ vectors from ${R}^{2}$ (in which we can have an orthogonal set with at most 2 non-zero vectors). Therefore, $U$ is not an orthogonal set.\n\n- For the set $V,$ notice that\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {v}_{2} & =\\begin{bmatrix}0 \\\\ 5\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 2\\end{bmatrix}=0+10=10\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthogonal set.\n\n- For the set $W,$ notice that \n\n$$\n\\begin{aligned}{w}_{1}\\cdot {w}_{2} & =\\begin{bmatrix}6 \\\\ 1 \\\\ -1\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ 3 \\\\ 1\\end{bmatrix}=12+3-1=14\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $W$ is not an orthogonal set.\n\nTherefore, we conclude that the correct answer is \"None of the listed\"."} {:db/id #edb/ref 17592186434764 :knowledge-point/_questions [{:db/id #edb/ref 17592186124570 :knowledge-point/id #uuid "40d58ee6-1121-5ddc-a96f-1a7fa7a193dd" :knowledge-point/title "Classifying Local Extrema Using Sylvester's Criterion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cde007a9-b0f6-57f6-b8c8-569dc617a887" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474472} {:answer/id #uuid "14c4e553-7773-5d04-9993-af7dbd1b9557" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474473}] :answer-field/correct {:answer/id #uuid "cde007a9-b0f6-57f6-b8c8-569dc617a887" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474472} :answer-field/id #uuid "e1bb8b62-465b-5b82-ba1a-9d8aa323116d" :answer-field/key "${a}_{11}=-1$ and $det(A)=-15$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475162} {:answer-field/choices [{:answer/id #uuid "9de572aa-0428-548c-97f5-19930fcda97b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474474} {:answer/id #uuid "ce46449c-5f4c-5219-ada2-0e7076d87668" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474475}] :answer-field/correct {:answer/id #uuid "9de572aa-0428-548c-97f5-19930fcda97b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474474} :answer-field/id #uuid "a6b0b738-bbb1-59b2-9af2-7625e85552c1" :answer-field/key "$A$ is negative-definite" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475163} {:answer-field/choices [{:answer/id #uuid "5c962c53-221d-56e5-a7ba-4a50b74f26e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474476} {:answer/id #uuid "10fdc2c8-4482-572b-a145-9384b2579ab1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474477}] :answer-field/correct {:answer/id #uuid "5c962c53-221d-56e5-a7ba-4a50b74f26e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474476} :answer-field/id #uuid "28245267-c604-5f8b-af0e-e69a56ca6fbc" :answer-field/key "$a$ is a local minimum of $f$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475164} {:answer-field/choices [{:answer/id #uuid "0469c806-bf58-512f-b5a9-49fdbcaf70ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669087} {:answer/id #uuid "77b9ba77-8595-5f92-a5c3-359e0fa1fe38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669088}] :answer-field/correct {:answer/id #uuid "77b9ba77-8595-5f92-a5c3-359e0fa1fe38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669088} :answer-field/id #uuid "02514380-2789-5254-aca9-8c6ca8f0be3d" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669343}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e5518b1c-8ee2-55b4-900e-3e5d5d3b8c0e" :question/math-academy-id "q-163788" :question/problem "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{3}$ is given by\n\n$$\nf(x)≈1+\\frac{1}{2}(x-a)^{T}A(x-a),\n$$\n\nwhere \n\n$$\nA=\\begin{bmatrix}-1 & 4 & 2 \\\\ 4 & 3 & 0 \\\\ 2 & 0 & 1\\end{bmatrix}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "The point $a\\in {R}^{n}$ is a critical point of the function $f:{R}^{n}\\to R$ if ${f}^{′}(a)={0}^{T}.$ In such cases, we can classify $a$ as follows:\n\n- if ${f}^{″}(a)$ is positive definite, then $a$ is a local minimum\n\n- if ${f}^{″}(a)$ is negative definite, then $a$ is a local maximum\n\n- if ${f}^{″}(a)$ is neither positive-definite nor negative-definite, then $a$ is a saddle point\n\nIn this case, we have $A={f}^{″}(a).$ Now, before we examine the statements, we recall how to categorize quadratic forms.\n\nLet ${Δ}_{i}$ for $i=1,2,…,n$  denote the leading principal minors of an $n\\times n$ matrix $A.$ Then, according to Sylvester's criterion, the quadratic form ${x}^{T}\\,A\\,x$ (as well as the matrix $A$) is \n\n- positive-definite if and only if ${Δ}_{i}>0$ for all $i=1,2,…,n,$\n\n- negative-definite if and only if, for all $i=1,2,…,n,$ we have ${Δ}_{i}<0$ when $i$ is odd, and ${Δ}_{i}>0$ when $i$ is even.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement “${a}_{11}=-1$ and $det(A)=-15$” is false. Indeed, ${a}_{11}=-1,$ but\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}-1 & 4 & 2 \\\\ 4 & 3 & 0 \\\\ 2 & 0 & 1\\end{aligned}| \\\\  & =-1\\cdot |\\begin{aligned}3 & 0 \\\\ 0 & 1\\end{aligned}|-4\\cdot |\\begin{aligned}4 & 0 \\\\ 2 & 1\\end{aligned}|+2\\cdot |\\begin{aligned}4 & 3 \\\\ 2 & 0\\end{aligned}| \\\\  & =-1(3)-4(4)+2(-6) \\\\  & =-31.\\end{aligned}\n$$\n\n- Statement “$A$ is negative-definite” is false. Notice the following:\n\n$$\n\\begin{aligned}{Δ}_{1} & ={a}_{11}=-1<0 \\\\ {Δ}_{2} & =|\\begin{aligned}-1 & 4 \\\\ 4 & 3\\end{aligned}|=-19<0 \\\\ {Δ}_{3} & =|A|=-31<0\\end{aligned}\n$$\n\nSo, by Sylvester's criterion, the matrix $A$ is neither positive-definite nor negative-definite.\n\n- Statement “$a$ is a local minimum of $f$” is false. Since the matrix $A$ is neither positive-definite nor negative-definite, the critical point $a$ is a saddle point of $f.$\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186436529 :knowledge-point/_questions [{:db/id #edb/ref 17592186115243 :knowledge-point/id #uuid "853a04b2-591a-51c2-b80f-73f559355d9f" :knowledge-point/title "Identifying an Elementary 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f564662a-a586-5cf0-983d-a463cece18c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474828} {:answer/id #uuid "cd9ec697-d62c-5cd9-a7e3-d0be9a26170b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474829}] :answer-field/correct {:answer/id #uuid "f564662a-a586-5cf0-983d-a463cece18c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474828} :answer-field/id #uuid "9c3c4731-0b36-5964-b452-fbb2af92efe4" :answer-field/key "$M=\\begin{bmatrix}1 & 1 \\\\ 0 & -1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475340} {:answer-field/choices [{:answer/id #uuid "58c9ad47-9cc2-5588-b29e-efbaec72d300" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474830} {:answer/id #uuid "6d6dd6fc-300a-5536-a4f8-6bf0bd3b7419" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474831}] :answer-field/correct {:answer/id #uuid "58c9ad47-9cc2-5588-b29e-efbaec72d300" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474830} :answer-field/id #uuid "1f81fd52-e05c-55c9-8525-5b6cb62e9802" :answer-field/key "$N=\\begin{bmatrix}0 & 5 \\\\ 1 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475341} {:answer-field/choices [{:answer/id #uuid "c47f6210-eb6e-572b-8727-62ace0a342a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474832} {:answer/id #uuid "82ef391b-48b6-5a1e-b086-4012d85bb009" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474833}] :answer-field/correct {:answer/id #uuid "c47f6210-eb6e-572b-8727-62ace0a342a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474832} :answer-field/id #uuid "1c0c485d-839f-59be-8e63-a184b74dc721" :answer-field/key "$P=\\begin{bmatrix}0 & -2 \\\\ 4 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475342} {:answer-field/choices [{:answer/id #uuid "460a0501-2830-5599-8007-8e55600f7924" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669193} {:answer/id #uuid "17e03438-19bf-5050-a6a3-7500a4061aa2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669194}] :answer-field/correct {:answer/id #uuid "17e03438-19bf-5050-a6a3-7500a4061aa2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669194} :answer-field/id #uuid "7e747f4b-57ce-5037-8240-bcd592944f9d" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669396}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bb398bcb-fa77-5232-9d5f-318cb8cb3320" :question/math-academy-id "q-42704" :question/problem "Which of the following are elementary matrices?\n\nSelect all that apply." :question/worked-solution "An elementary matrix is a matrix obtained from the identity matrix by applying exactly one elementary row operation. \n\nWith that in mind, let's examine our matrices.\n\n- The matrices $M$, $N$ and $P$ are not elementary matrices because they can't be obtained from ${I}_{2}$ by applying only one elementary row operation."} {:db/id #edb/ref 17592186440655 :knowledge-point/_questions [{:db/id #edb/ref 17592186124628 :knowledge-point/id #uuid "cb02b67c-90d9-5baf-b00e-590e9271d89e" :knowledge-point/title "Identifying Sets Closed Under Addition and Scalar Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d05376f6-1b0d-5d33-a541-3aa219c70c49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474380} {:answer/id #uuid "5c163f09-54be-5558-9c1e-fe94a54a1e20" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474381}] :answer-field/correct {:answer/id #uuid "d05376f6-1b0d-5d33-a541-3aa219c70c49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474380} :answer-field/id #uuid "40688437-da51-5c09-8938-382c42b205b5" :answer-field/key "The identity matrix ${I}_{2}$ belongs to $T.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475116} {:answer-field/choices [{:answer/id #uuid "d7e8cc97-462c-55aa-b04b-6dbb38612ce0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474382} {:answer/id #uuid "15dd7df2-59de-5b51-b076-5c48eeebe741" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474383}] :answer-field/correct {:answer/id #uuid "d7e8cc97-462c-55aa-b04b-6dbb38612ce0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474382} :answer-field/id #uuid "0701114c-aa2e-546e-96ef-4e5405aa562a" :answer-field/key "For every $A\\in T$ and $\\alpha \\in R,$ we have $\\alpha \\cdot A\\in T.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475117} {:answer-field/choices [{:answer/id #uuid "6fc0710a-c653-55e4-9d40-d1e8b67499c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474384} {:answer/id #uuid "e9124b17-545a-583b-9b07-99ee100d310e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474385}] :answer-field/correct {:answer/id #uuid "6fc0710a-c653-55e4-9d40-d1e8b67499c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474384} :answer-field/id #uuid "ce028ac2-d2da-562a-87c9-ae46090732e5" :answer-field/key "The set is closed under scalar multiplication." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475118} {:answer-field/choices [{:answer/id #uuid "7033a83c-e0ec-5727-889c-cd5887606c61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669055} {:answer/id #uuid "3cffcdb6-73ae-5950-ba93-afe479f977c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669056}] :answer-field/correct {:answer/id #uuid "3cffcdb6-73ae-5950-ba93-afe479f977c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669056} :answer-field/id #uuid "0f5b820a-924c-5417-aaf1-a1eb80482a3c" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669327}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c3d7a176-49a0-5f40-a976-fffa17513013" :question/math-academy-id "q-141158" :question/problem "Let $T$ be the set of all $2\\times 2$ real matrices $A=({a}_{ij})$ such that ${a}_{11}{a}_{21}+{a}_{12}{a}_{22}>0.$ Which of the following statements are true? \n\nSelect all that apply." :question/worked-solution "Let's verify the statements one at a time.\n\n- Statement “The identity matrix ${I}_{2}$ belongs to $T.$” is false. The set $T$ contains only matrices $A=({a}_{ij})$ such that ${a}_{11}{a}_{21}+{a}_{12}{a}_{22}>0.$ However, for the identity matrix ${I}_{2}=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix},$ we have ${a}_{11}{a}_{21}+{a}_{12}{a}_{22}=1\\cdot 0+0\\cdot 1=0≯0.$ So, ${I}_{2}\\notin T.$\n\n- Statement “For every $A\\in T$ and $\\alpha \\in R,$ we have $\\alpha \\cdot A\\in T.$” is false. For example, let $\\alpha =0\\in R$ and $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}\\in T.$ Then, \n\n$$\n\\alpha \\cdot A=0\\cdot A=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix},\n$$\n\nwhere the sum of the products of columns' entries is $0\\cdot 0+0\\cdot 0=0≯0.$ Hence, $0\\cdot A\\notin T.$\n\n- Statement “The set is closed under scalar multiplication” is false. Since statement “For every $A\\in T$ and $\\alpha \\in R,$ we have $\\alpha \\cdot A\\in T.$” is false, the set is not closed under scalar multiplication.\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186494136 :knowledge-point/_questions [{:db/id #edb/ref 17592186100959 :knowledge-point/id #uuid "80ed79a9-8e39-5c84-9c87-dec266060afc" :knowledge-point/title "Identifying Solutions to First-Order Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "043bd6b5-f398-59fb-9664-c843c3927785" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186494128} {:answer/id #uuid "fed93e13-4643-5fa5-adb6-1d03e9aecd03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186494224}] :answer-field/correct {:answer/id #uuid "fed93e13-4643-5fa5-adb6-1d03e9aecd03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186494224} :answer-field/id #uuid "185aa277-ec0b-5b7f-9dfd-7fd410156dfc" :answer-field/key "$y=2 x^{4} - x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186494135} {:answer-field/choices [{:answer/id #uuid "119b6234-2b31-5432-915d-1e7dc0ef6b47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186494133} {:answer/id #uuid "1cf34b6d-fb8d-5cff-9900-0f2e7b496e9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186494138}] :answer-field/correct {:answer/id #uuid "1cf34b6d-fb8d-5cff-9900-0f2e7b496e9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186494138} :answer-field/id #uuid "1dff065e-2b3b-5c1e-a226-f81d326f6baf" :answer-field/key "$y=- x^{4} - 2 x - 1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186494140} {:answer-field/choices [{:answer/id #uuid "63afce1e-e0ab-5d34-81d4-696e5637c1d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186494168} {:answer/id #uuid "bf8f849b-f988-5a2f-8dc4-21d836414a4f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186494201}] :answer-field/correct {:answer/id #uuid "63afce1e-e0ab-5d34-81d4-696e5637c1d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186494168} :answer-field/id #uuid "7f318fe0-a53e-51ad-b079-e7ecb29bbd16" :answer-field/key "$y=- 3 x^{4} - 2 x + 1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186494176}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "186f19a6-4a5f-585e-b13e-b8bce737384f" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=6 + \\frac{4 y}{x},\\,x\\ne 0.\n$$\n\n Which of the following is a solution to this equation?\n\nSelect all that apply." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the stated domain.\n\nWe check each proposed solution by differentiating and substituting it into the original equation. \n\n- Differentiating $y=- x^{4} - 2 x - 1,$ we get $\\frac{\\text{d}y}{\\text{d}x}=- 4 x^{3} - 2.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =6 + \\frac{4 y}{x} \\\\ - 4 x^{3} - 2 & \\overset{?}{=}\\frac{4\\cdot \\left(- x^{4} - 2 x - 1\\right)}{x}+6 \\\\ - 4 x^{3} - 2 & \\overset{?}{=}- 4 x^{3} - 2 - \\frac{4}{x} \\\\ \\frac{4}{x} & \\not\\equiv 0\\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y=- x^{4} - 2 x - 1$ is *not* a solution to our differential equation.\n\n- Differentiating $y=- 3 x^{4} - 2 x + 1,$ we get $\\frac{\\text{d}y}{\\text{d}x}=- 12 x^{3} - 2.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =6 + \\frac{4 y}{x} \\\\ - 12 x^{3} - 2 & \\overset{?}{=}\\frac{4\\cdot \\left(- 3 x^{4} - 2 x + 1\\right)}{x}+6 \\\\ - 12 x^{3} - 2 & \\overset{?}{=}- 12 x^{3} - 2 + \\frac{4}{x} \\\\ - \\frac{4}{x} & \\not\\equiv 0\\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y=- 3 x^{4} - 2 x + 1$ is *not* a solution to our differential equation.\n\n- Differentiating $y=2 x^{4} - x,$ we get $\\frac{\\text{d}y}{\\text{d}x}=8 x^{3} - 1.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =6 + \\frac{4 y}{x} \\\\ 8 x^{3} - 1 & \\overset{?}{=}\\frac{4\\cdot \\left(2 x^{4} - x\\right)}{x}+6 \\\\ 8 x^{3} - 1 & \\overset{?}{=}8 x^{3} + 2 \\\\ -3 & \\not\\equiv 0\\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y=2 x^{4} - x$ is *not* a solution to our differential equation.\n\nTherefore, the correct answer is \"None.\""} {:db/id #edb/ref 17592186494158 :knowledge-point/_questions [{:db/id #edb/ref 17592186100959 :knowledge-point/id #uuid "80ed79a9-8e39-5c84-9c87-dec266060afc" :knowledge-point/title "Identifying Solutions to First-Order Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "054d7925-1847-562b-ae23-d79faab9f29c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186494129} {:answer/id #uuid "f09cf4be-e51e-5251-bd38-9ee9d165772c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186494219}] :answer-field/correct {:answer/id #uuid "054d7925-1847-562b-ae23-d79faab9f29c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186494129} :answer-field/id #uuid "02340bc0-0e35-511b-8bdf-634b3b1617f2" :answer-field/key "$y=3 e^{x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186494125} {:answer-field/choices [{:answer/id #uuid "8541587a-6f0d-5e4c-8ba8-dffa29013166" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186494178} {:answer/id #uuid "a4ed4684-cdcb-588c-a840-886c4cff8762" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186494189}] :answer-field/correct {:answer/id #uuid "a4ed4684-cdcb-588c-a840-886c4cff8762" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186494189} :answer-field/id #uuid "4066b5b3-5f66-5bb3-98fb-812b6147d21a" :answer-field/key "$y=-2 + 3 e^{- x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186494153} {:answer-field/choices [{:answer/id #uuid "49e7daa0-d022-513e-8651-4ce1f2aae5a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186494159} {:answer/id #uuid "60ac3f8d-bd55-5484-966f-7ce2dde8f33c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186494166}] :answer-field/correct {:answer/id #uuid "60ac3f8d-bd55-5484-966f-7ce2dde8f33c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186494166} :answer-field/id #uuid "42fde4a2-8a28-5a07-8c04-aafb5c22896f" :answer-field/key "$y=3 e^{x} - 2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186494154}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "482041dd-1ea5-59f6-ae3d-2788e211524d" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=- y.\n$$\n\n Which of the following is a solution to this equation?\n\nSelect all that apply." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the stated domain.\n\nWe check each proposed solution by differentiating and substituting it into the original equation. \n\n- Differentiating $y=3 e^{x} - 2,$ we get $\\frac{\\text{d}y}{\\text{d}x}=3 e^{x}.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =- y \\\\ 3 e^{x} & \\overset{?}{=}-1\\cdot \\left(3 e^{x} - 2\\right) \\\\ 3 e^{x} & \\overset{?}{=}2 - 3 e^{x} \\\\ 6 e^{x} - 2 & \\not\\equiv 0\\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y=3 e^{x} - 2$ is *not* a solution to our differential equation.\n\n- Differentiating $y=-2 + 3 e^{- x},$ we get $\\frac{\\text{d}y}{\\text{d}x}=- 3 e^{- x}.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =- y \\\\ - 3 e^{- x} & \\overset{?}{=}-1\\cdot \\left(-2 + 3 e^{- x}\\right) \\\\ - 3 e^{- x} & \\overset{?}{=}2 - 3 e^{- x} \\\\ -2 & \\not\\equiv 0\\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y=-2 + 3 e^{- x}$ is *not* a solution to our differential equation.\n\n- Differentiating $y=3 e^{x},$ we get $\\frac{\\text{d}y}{\\text{d}x}=3 e^{x}.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =- y \\\\ 3 e^{x} & \\overset{?}{=}-1\\cdot \\left(3 e^{x}\\right) \\\\ 3 e^{x} & \\overset{?}{=}- 3 e^{x} \\\\ 6 e^{x} & \\not\\equiv 0\\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y=3 e^{x}$ is *not* a solution to our differential equation.\n\nTherefore, the correct answer is \"None.\""} {:db/id #edb/ref 17592186494220 :knowledge-point/_questions [{:db/id #edb/ref 17592186100959 :knowledge-point/id #uuid "80ed79a9-8e39-5c84-9c87-dec266060afc" :knowledge-point/title "Identifying Solutions to First-Order Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3db4e6c-ec76-5c68-b9ea-8a870249452d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186494208} {:answer/id #uuid "eedafe67-a61c-5e88-8cb0-53e032a87451" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186494218}] :answer-field/correct {:answer/id #uuid "d3db4e6c-ec76-5c68-b9ea-8a870249452d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186494208} :answer-field/id #uuid "3621bd74-a8f3-532e-93ba-8265ce22c897" :answer-field/key "$y=- 3 e^{x} - 2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186494148} {:answer-field/choices [{:answer/id #uuid "807d73f1-95c3-5598-b78d-c5c37b01ff37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186494177} {:answer/id #uuid "f380cb57-bb9a-55b5-8bb7-5942f0098316" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186494221}] :answer-field/correct {:answer/id #uuid "f380cb57-bb9a-55b5-8bb7-5942f0098316" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186494221} :answer-field/id #uuid "c64eae15-0d0b-5d44-aa93-8afc1cfa5199" :answer-field/key "$y=- 2 e^{- x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186494204} {:answer-field/choices [{:answer/id #uuid "52571d72-0344-521b-acf7-3b8804ca0284" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186494162} {:answer/id #uuid "67f09018-86bc-53cd-a196-213802abc706" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186494170}] :answer-field/correct {:answer/id #uuid "52571d72-0344-521b-acf7-3b8804ca0284" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186494162} :answer-field/id #uuid "fcf53b2e-9588-5276-aeec-2aee943daafe" :answer-field/key "$y=3 e^{x} + 1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186494223}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f13e106a-779d-594b-9ac2-fa322d45064e" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=y.\n$$\n\n Which of the following is a solution to this equation?\n\nSelect all that apply." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the stated domain.\n\nWe check each proposed solution by differentiating and substituting it into the original equation. \n\n- Differentiating $y=3 e^{x} + 1,$ we get $\\frac{\\text{d}y}{\\text{d}x}=3 e^{x}.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =y \\\\ 3 e^{x} & \\overset{?}{=}1\\cdot \\left(3 e^{x} + 1\\right) \\\\ 3 e^{x} & \\overset{?}{=}3 e^{x} + 1 \\\\ -1 & \\not\\equiv 0\\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y=3 e^{x} + 1$ is *not* a solution to our differential equation.\n\n- Differentiating $y=- 2 e^{- x},$ we get $\\frac{\\text{d}y}{\\text{d}x}=2 e^{- x}.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =y \\\\ 2 e^{- x} & \\overset{?}{=}1\\cdot \\left(- 2 e^{- x}\\right) \\\\ 2 e^{- x} & \\overset{?}{=}- 2 e^{- x} \\\\ 4 e^{- x} & \\not\\equiv 0\\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y=- 2 e^{- x}$ is *not* a solution to our differential equation.\n\n- Differentiating $y=- 3 e^{x} - 2,$ we get $\\frac{\\text{d}y}{\\text{d}x}=- 3 e^{x}.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =y \\\\ - 3 e^{x} & \\overset{?}{=}1\\cdot \\left(- 3 e^{x} - 2\\right) \\\\ - 3 e^{x} & \\overset{?}{=}- 3 e^{x} - 2 \\\\ 2 & \\not\\equiv 0\\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y=- 3 e^{x} - 2$ is *not* a solution to our differential equation.\n\nTherefore, the correct answer is \"None.\""} {:db/id #edb/ref 17592186511988 :knowledge-point/_questions [{:db/id #edb/ref 17592186176047 :knowledge-point/id #uuid "542df339-5020-5680-a39c-a1ae161083e7" :knowledge-point/title "Describing Properties of the Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61e3a7d8-7256-58da-815e-b8f0dda9e6b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186512020} {:answer/id #uuid "84529515-48e3-520e-bfd1-3868a9402a05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186512040}] :answer-field/correct {:answer/id #uuid "84529515-48e3-520e-bfd1-3868a9402a05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186512040} :answer-field/id #uuid "4355f151-f54d-57b7-8dcd-e52174dbc60e" :answer-field/key "The complete set of inputs at which the function has maximum values is $x=n\\pi.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186512010} {:answer-field/choices [{:answer/id #uuid "31b822ea-d79a-561e-bbe1-96f2aa290bba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186511999} {:answer/id #uuid "560b4ac7-4028-5d7f-9dee-814213d524b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186512018}] :answer-field/correct {:answer/id #uuid "560b4ac7-4028-5d7f-9dee-814213d524b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186512018} :answer-field/id #uuid "7553d696-d4bd-5fce-8cb1-3075bcb22340" :answer-field/key "The complete set of inputs at which the function has minimum values is $x=\\frac{\\pi}{2}+n\\pi.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186512031} {:answer-field/choices [{:answer/id #