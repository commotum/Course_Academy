field/correct {:answer/id #uuid "47165ac7-d928-5dd9-8d65-1c6c9cc8e8b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186546155} :answer-field/id #uuid "fde9526a-397c-5e29-aae0-9be2e0a6f991" :answer-field/key "$A(x,y,z)=2x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186546231}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4ae04fea-db17-55d4-b9de-0119ff546f92" :question/problem "Which of the following are vector fields on $\\mathbb R^3?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of $\\mathbb R^3.$ A vector field on $\\mathbb R^3$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in\\mathbb R^3.$\n\nWith that in mind, let's examine each function.\n\n- The function $A(x,y,z)$ is *not* a vector field on $\\mathbb R^3.$ It assigns points in $\\mathbb R^3$ to values in $\\mathbb R$ (not $\\mathbb R^3$).\n\n- The function $B(x,y,z)$ is *not* a vector field on $\\mathbb R^3.$ It assigns points in $\\mathbb R^3$ to values in $\\mathbb R$ (not $\\mathbb R^3$).\n\n- The function $C(x,y,z)$ is *not* a vector field on $\\mathbb R^3.$ It assigns points in $\\mathbb R^3$ to vectors in $\\mathbb R^2$ (not $\\mathbb R^3$).\n\nTherefore, the correct answer is \"None of the listed.\""} {:db/id #edb/ref 17592186546177 :knowledge-point/_questions [{:db/id #edb/ref 17592186172087 :knowledge-point/id #uuid "fb34fdb0-198e-507d-a944-9be782b4cfeb" :knowledge-point/title "Identifying Vector Fields on Three-Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e3a49d8a-294f-5dd1-9626-348b1bf42c18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186546221} {:answer/id #uuid "f06f0484-6dee-5e43-b642-af823ed776ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186546225}] :answer-field/correct {:answer/id #uuid "e3a49d8a-294f-5dd1-9626-348b1bf42c18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186546221} :answer-field/id #uuid "05c31c22-cd49-5165-be07-fa25ecdec975" :answer-field/key "$A(x,y,z)=\\langle 2x, y^2\\rangle$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186546135} {:answer-field/choices [{:answer/id #uuid "03a02f74-13d6-5cda-9612-3c57b0f49c86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186546133} {:answer/id #uuid "8bd740ab-f3c3-58e0-967c-0bcc2d1f7b90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186546181}] :answer-field/correct {:answer/id #uuid "8bd740ab-f3c3-58e0-967c-0bcc2d1f7b90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186546181} :answer-field/id #uuid "8e872608-bac0-5f7e-a2f2-d2746d095572" :answer-field/key "$B(x,y,z)=2x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186546185} {:answer-field/choices [{:answer/id #uuid "72ee6e77-e570-56ab-9c6b-fbdc3fb2d747" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186546170} {:answer/id #uuid "caf711ce-a415-56ac-b301-585682144f5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186546216}] :answer-field/correct {:answer/id #uuid "72ee6e77-e570-56ab-9c6b-fbdc3fb2d747" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186546170} :answer-field/id #uuid "b14461e8-4abf-576f-9500-52cc8d108560" :answer-field/key "$C(x,y,z)=\\langle 2x, y^2\\rangle$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186546199}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "82f64596-1e9a-59d4-b427-5b1e347c31fa" :question/problem "Which of the following are vector fields on $\\mathbb R^3?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of $\\mathbb R^3.$ A vector field on $\\mathbb R^3$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in\\mathbb R^3.$\n\nWith that in mind, let's examine each function.\n\n- The function $A(x,y,z)$ is *not* a vector field on $\\mathbb R^3.$ It assigns points in $\\mathbb R^3$ to vectors in $\\mathbb R^2$ (not $\\mathbb R^3$).\n\n- The function $B(x,y,z)$ is *not* a vector field on $\\mathbb R^3.$ It assigns points in $\\mathbb R^3$ to values in $\\mathbb R$ (not $\\mathbb R^3$).\n\n- The function $C(x,y,z)$ is *not* a vector field on $\\mathbb R^3.$ It assigns points in $\\mathbb R^3$ to vectors in $\\mathbb R^2$ (not $\\mathbb R^3$).\n\nTherefore, the correct answer is \"None of the listed.\""} {:db/id #edb/ref 17592186564849 :knowledge-point/_questions [{:db/id #edb/ref 17592186172039 :knowledge-point/id #uuid "fd092f29-08bf-5425-88a4-8cba4f0a31c8" :knowledge-point/title "Identifying Quadrants Where a Slope Field Is Positive or Negative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7cab2d62-587d-52bf-b070-18c833aa66fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186564882} {:answer/id #uuid "97de6a64-6253-5e1a-9626-15e1bdaac965" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186564889}] :answer-field/correct {:answer/id #uuid "97de6a64-6253-5e1a-9626-15e1bdaac965" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186564889} :answer-field/id #uuid "13ba05b4-64f9-574f-9775-51875c8dfc16" :answer-field/key "At every point in the first quadrant, the slope of the slope field is positive" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186564854} {:answer-field/choices [{:answer/id #uuid "328b011b-8c8f-52ab-8d81-8cc811b010dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186564864} {:answer/id #uuid "74584873-7102-5114-a4bd-1bf7395de72e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186564880}] :answer-field/correct {:answer/id #uuid "328b011b-8c8f-52ab-8d81-8cc811b010dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186564864} :answer-field/id #uuid "365356dc-7639-54e0-bf9f-22ebb468cf01" :answer-field/key "At every point in the third quadrant, the slope of the slope field is negative" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186564865} {:answer-field/choices [{:answer/id #uuid "2448cbd6-bf53-52f2-a380-582ea77a287a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186564856} {:answer/id #uuid "559fb292-b359-58ae-9f5f-5fe52fb4e4c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186564872}] :answer-field/correct {:answer/id #uuid "2448cbd6-bf53-52f2-a380-582ea77a287a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186564856} :answer-field/id #uuid "de45b795-9423-53be-8e3f-4a4023b24aa0" :answer-field/key "At every point in the second quadrant, the slope of the slope field is negative" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186564914}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0dbda9ea-eb5b-5de0-b271-e71696078d9a" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=-6x$ and its slope field. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, we define $f(x,y)=-6x.$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=0.$ In each open quadrant, $x$ has a fixed nonzero sign. The lines $x=0$ and $y=0$ divide the plane into the usual four quadrants.\n\nIf we compute the sign of $f(x,y)$ in each quadrant (by considering some test points, for example), we get the following:\n\n![](images/83/8306880f3f6b3d936d1e690cf75eb9e1a999f5b1c914d10c1886296317664fbe.png)\n\nWith that in mind, let's check each statement:\n\n- Statement “At every point in the first quadrant, the slope of the slope field is positive” is false. If $(x,y)$ is in the first quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in the first quadrant.\n\n- Statement “At every point in the third quadrant, the slope of the slope field is negative” is false. If $(x,y)$ is in the third quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the third quadrant.\n\n- Statement “At every point in the second quadrant, the slope of the slope field is negative” is false. If $(x,y)$ is in the second quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the second quadrant."} {:db/id #edb/ref 17592186568926 :knowledge-point/_questions [{:db/id #edb/ref 17592186087697 :knowledge-point/id #uuid "09fa0899-a3d2-584f-8cdd-a471f8cfd16b" :knowledge-point/title "Identifying a Special Square Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5b0e5c4-10d4-5856-a372-7614c553613c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186569008} {:answer/id #uuid "e0bf393f-b6fb-57d8-8aa6-abe976598bf0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186569047}] :answer-field/correct {:answer/id #uuid "a5b0e5c4-10d4-5856-a372-7614c553613c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186569008} :answer-field/id #uuid "5384f247-e5be-51b2-be3e-25f34d82aece" :answer-field/key "$P=\\begin{bmatrix}2 & 0 \\\\ 0 & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186568949} {:answer-field/choices [{:answer/id #uuid "63779494-c79d-58f6-a010-823bab8347a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186568961} {:answer/id #uuid "748fd0b6-1d5a-5b27-92f6-8ee6665a10e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186568975}] :answer-field/correct {:answer/id #uuid "63779494-c79d-58f6-a010-823bab8347a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186568961} :answer-field/id #uuid "5c2c1f45-1ed4-50ba-84c7-2190f3700c05" :answer-field/key "$M=\\begin{bmatrix}3 & 0 & 0 & 0 \\\\ 0 & -2 & 0 & 0 \\\\ 0 & 0 & 2 & 0 \\\\ 0 & 0 & 0 & 3\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186568955} {:answer-field/choices [{:answer/id #uuid "00efd316-4058-58f9-9e76-40f651e1957d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186568899} {:answer/id #uuid "c1405561-e678-5dce-bcf6-ea21e4cb9778" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186569024}] :answer-field/correct {:answer/id #uuid "00efd316-4058-58f9-9e76-40f651e1957d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186568899} :answer-field/id #uuid "831ee5fb-7cc8-556d-8fc2-d9c2017c8741" :answer-field/key "$N=\\begin{bmatrix}-2 & 0 & 0 \\\\ 0 & -2 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186568985}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "28896c08-42c6-5e3b-970e-0e1390a285e6" :question/problem "Which of the following are identity matrices?\n\nSelect all that apply." :question/worked-solution "- $M$ is *not* an identity matrix. It is diagonal, but its diagonal entries are not all ones: ${m}_{11}=3\\ne 1$.\n\n- $N$ is *not* an identity matrix. It is not a square matrix: it has 2 rows and 3 columns.\n\n- $P$ is *not* an identity matrix. It is not a square matrix: it has 4 rows and 2 columns.\n\nTherefore, none of the given matrices are identity matrices."} {:db/id #edb/ref 17592186568960 :knowledge-point/_questions [{:db/id #edb/ref 17592186087697 :knowledge-point/id #uuid "09fa0899-a3d2-584f-8cdd-a471f8cfd16b" :knowledge-point/title "Identifying a Special Square Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9557f504-828b-5db3-8d32-ce0c025e5fd2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186568997} {:answer/id #uuid "c4818e4b-a7d7-5631-8820-4ef1631ce283" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186569026}] :answer-field/correct {:answer/id #uuid "9557f504-828b-5db3-8d32-ce0c025e5fd2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186568997} :answer-field/id #uuid "67d6b16c-fb26-5e65-a790-7d5ff21e79ac" :answer-field/key "$H=\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & -2 \\\\ 0 & 0 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186568967} {:answer-field/choices [{:answer/id #uuid "3cb7174e-35a5-5c82-824c-3a1be8513230" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186568936} {:answer/id #uuid "7b8d592a-633c-5691-a29b-e21da28af3f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186568980}] :answer-field/correct {:answer/id #uuid "3cb7174e-35a5-5c82-824c-3a1be8513230" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186568936} :answer-field/id #uuid "80212442-540e-59ae-9718-ae2c2c5fac1f" :answer-field/key "$M=\\begin{bmatrix}-2 & 0 \\\\ 0 & 3 \\\\ 0 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186568984} {:answer-field/choices [{:answer/id #uuid "2a527dc5-8b4e-5856-a4fc-79d088e69e6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186568929} {:answer/id #uuid "ca9965b3-640d-50d8-8f09-495b4b88fc72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186569029}] :answer-field/correct {:answer/id #uuid "2a527dc5-8b4e-5856-a4fc-79d088e69e6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186568929} :answer-field/id #uuid "df82fbf3-2164-530e-9dae-5051a9e274c4" :answer-field/key "$F=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ -1 & 0 & -2\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186569044}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6337a2fc-031a-539c-af7b-6662b214cb26" :question/problem "Which of the following are diagonal matrices?\n\nSelect all that apply." :question/worked-solution "- $F$ is *not* a diagonal matrix. It is square, but an entry off the main diagonal is nonzero: ${f}_{31}=-1\\ne 0$.\n\n- $H$ is *not* a diagonal matrix. It is not a square matrix: it has 4 rows and 3 columns.\n\n- $M$ is *not* a diagonal matrix. It is not a square matrix: it has 3 rows and 2 columns.\n\nTherefore, none of the given matrices are diagonal matrices."} {:db/id #edb/ref 17592186577218 :knowledge-point/_questions [{:db/id #edb/ref 17592186100888 :knowledge-point/id #uuid "201edc93-37b4-556a-aaea-4fcf9a01077a" :knowledge-point/title "Identifying a Solution to a First-Order Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cc87408-521e-5ff3-81ad-d12b8336cba2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577198} {:answer/id #uuid "ee5cc371-1e31-5af0-b590-b0e123a69dca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577226}] :answer-field/correct {:answer/id #uuid "5cc87408-521e-5ff3-81ad-d12b8336cba2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577198} :answer-field/id #uuid "121ca29b-ff12-50d2-a3bf-d408737a7afb" :answer-field/key "The function $y=f(x)$ is a solution of the differential equation." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577183} {:answer-field/choices [{:answer/id #uuid "11a41b91-a3e8-52ba-ba25-b21d70c222a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577182} {:answer/id #uuid "83796f1a-f177-5bfb-9026-ee69e4168ca1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577210}] :answer-field/correct {:answer/id #uuid "83796f1a-f177-5bfb-9026-ee69e4168ca1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577210} :answer-field/id #uuid "2a41cff6-b393-54f3-8621-68b284e47ac3" :answer-field/key "$f\\prime(x)=- 2 \\sin{\\left(4 x \\right)}.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577189} {:answer-field/choices [{:answer/id #uuid "34812337-a6dc-5027-b32a-f77570a6742e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577191} {:answer/id #uuid "45dea541-accf-5351-87dd-ce5e1122aee6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577196}] :answer-field/correct {:answer/id #uuid "34812337-a6dc-5027-b32a-f77570a6742e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577191} :answer-field/id #uuid "f98785b4-f724-5466-bb66-b99672465add" :answer-field/key "Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577228}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d568f072-4f2d-5062-9df6-070b49ac30ab" :question/problem "Consider the following differential equation.\n\n$$\ny\\prime=- 5 \\sin{\\left(4 x \\right)}\n$$\n\nLet $f(x)=\\cos{\\left(4 x \\right)}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in an interval where the function is defined and the equation is valid.\n\nWith that in mind, let's check each statement in turn.\n\n- Statement $f\\prime(x)=- 2 \\sin{\\left(4 x \\right)}.$ is false. Differentiating $f(x)=\\cos{\\left(4 x \\right)},$ we get\n\n$$\n\\begin{aligned}f\\prime(x)&=\\left(\\cos{\\left(4 x \\right)}\\right)\\prime \\\\ &=-\\sin(4x)\\cdot 4 \\\\ &=- 4 \\sin{\\left(4 x \\right)} \\\\ &\\not\\equiv - 2 \\sin{\\left(4 x \\right)}\\end{aligned}\n$$\n\n- Statement “Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement” is false. Substituting $y=\\cos{\\left(4 x \\right)}$ and $y\\prime=- 4 \\sin{\\left(4 x \\right)}$ into the original equation gives expressions that are not identical:\n\n$$\n\\begin{aligned}y\\prime &\\overset{?}{=}- 5 \\sin{\\left(4 x \\right)} \\\\ - 4 \\sin{\\left(4 x \\right)} &\\not\\equiv - 5 \\sin{\\left(4 x \\right)}\\end{aligned}\n$$\n\n- Statement “The function $y=f(x)$ is a solution of the differential equation” is false. Since statement “Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement” is false, the function $y=\\cos{\\left(4 x \\right)}$ is not a solution to our differential equation.\n\nTherefore, the correct answer is \"None.\""} {:db/id #edb/ref 17592186577247 :knowledge-point/_questions [{:db/id #edb/ref 17592186100888 :knowledge-point/id #uuid "201edc93-37b4-556a-aaea-4fcf9a01077a" :knowledge-point/title "Identifying a Solution to a First-Order Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c669eed-d1b3-5024-8bdb-7d4214af06fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577243} {:answer/id #uuid "646a3baf-7c68-5935-a198-a09a52711555" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577252}] :answer-field/correct {:answer/id #uuid "646a3baf-7c68-5935-a198-a09a52711555" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577252} :answer-field/id #uuid "194c9336-9913-5379-9825-4dba3d9209d2" :answer-field/key "The function $y=f(x)$ is a solution of the differential equation." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577236} {:answer-field/choices [{:answer/id #uuid "51c96df9-a022-5711-b0b4-862aa2e02436" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577246} {:answer/id #uuid "57dd76c7-1580-54a7-8702-832f92b56a36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577249}] :answer-field/correct {:answer/id #uuid "57dd76c7-1580-54a7-8702-832f92b56a36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577249} :answer-field/id #uuid "7a0c4a37-dc9b-5b7b-98ce-2b41b1443ec4" :answer-field/key "$f\\prime(x)=- 24 x.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577257} {:answer-field/choices [{:answer/id #uuid "a1537077-2732-5997-8cda-6940defc768a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577265} {:answer/id #uuid "cdfe72b8-fa2e-56cf-b8f3-590b7c422024" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577273}] :answer-field/correct {:answer/id #uuid "a1537077-2732-5997-8cda-6940defc768a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577265} :answer-field/id #uuid "aa93174e-a1e8-55a5-9b08-c1c23b7d6e47" :answer-field/key "Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577268}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "53a41d24-47c9-59a3-bb8f-2ba3ae6870d8" :question/problem "Consider the following differential equation.\n\n$$\ny\\prime=\\frac{3 y}{x},\\qquad x\\ne 0\n$$\n\nLet $f(x)=- 6 x^{2}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in an interval where the function is defined and the equation is valid.\n\nWith that in mind, let's check each statement in turn.\n\n- Statement $f\\prime(x)=- 24 x.$ is false. Differentiating $f(x)=- 6 x^{2},$ we get\n\n$$\n\\begin{aligned}f\\prime(x)&=\\left(- 6 x^{2}\\right)\\prime \\\\ &=-6\\cdot 2 x \\\\ &=- 12 x \\\\ &\\not\\equiv - 24 x\\end{aligned}\n$$\n\n- Statement “Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement” is false. Substituting $y=- 6 x^{2}$ and $y\\prime=- 12 x$ into the original equation gives expressions that are not identical:\n\n$$\n\\begin{aligned}y\\prime &\\overset{?}{=}\\frac{3 y}{x} \\\\ - 12 x &\\overset{?}{=}\\frac{3\\left(- 6 x^{2}\\right)}{x} \\\\ - 12 x &\\not\\equiv - 18 x\\end{aligned}\n$$\n\n- Statement “The function $y=f(x)$ is a solution of the differential equation” is false. Since statement “Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement” is false, the function $y=- 6 x^{2}$ is not a solution to our differential equation.\n\nTherefore, the correct answer is \"None.\""} {:db/id #edb/ref 17592186577294 :knowledge-point/_questions [{:db/id #edb/ref 17592186100888 :knowledge-point/id #uuid "201edc93-37b4-556a-aaea-4fcf9a01077a" :knowledge-point/title "Identifying a Solution to a First-Order Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fc0976d-8848-5bc7-a8ba-c6fb66573dfe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577288} {:answer/id #uuid "91cca939-abfa-579c-ba0f-76aed088ff08" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577306}] :answer-field/correct {:answer/id #uuid "91cca939-abfa-579c-ba0f-76aed088ff08" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577306} :answer-field/id #uuid "9baa3746-90cb-500b-8251-3017a1530a1d" :answer-field/key "$f\\prime(x)=- \\frac{4}{3 x + 2}.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577312} {:answer-field/choices [{:answer/id #uuid "acbb8d0f-0fc7-5f97-8c4c-958d8e7cec21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577317} {:answer/id #uuid "ba7030f3-f3be-5e06-ba36-6216c88dadef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577318}] :answer-field/correct {:answer/id #uuid "acbb8d0f-0fc7-5f97-8c4c-958d8e7cec21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577317} :answer-field/id #uuid "e4198222-2cf0-53fa-a803-9c2fa7bab7c3" :answer-field/key "The function $y=f(x)$ is a solution of the differential equation." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577323} {:answer-field/choices [{:answer/id #uuid "112c328d-2c2a-5fc0-b7ee-7c0fdc2ad74c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577283} {:answer/id #uuid "aa4cc2d0-e201-5801-b07a-6b913c46b3ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577316}] :answer-field/correct {:answer/id #uuid "aa4cc2d0-e201-5801-b07a-6b913c46b3ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577316} :answer-field/id #uuid "e49426b3-4b2b-5454-8130-574f46902c18" :answer-field/key "Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577324}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "57edc055-3dc9-5acb-8736-c0c617f4d5fc" :question/problem "Consider the following differential equation.\n\n$$\ny\\prime=- 4 e^{\\frac{y}{2}},\\qquad 3 x + 2>0\n$$\n\nLet $f(x)=- 2 \\ln{\\left(3 x + 2 \\right)}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in an interval where the function is defined and the equation is valid.\n\nWith that in mind, let's check each statement in turn.\n\n- Statement $f\\prime(x)=- \\frac{4}{3 x + 2}.$ is false. Differentiating $f(x)=- 2 \\ln{\\left(3 x + 2 \\right)},$ we get\n\n$$\n\\begin{aligned}f\\prime(x)&=\\left(- 2 \\ln{\\left(3 x + 2 \\right)}\\right)\\prime \\\\ &=-2\\cdot\\frac{3}{3 x + 2} \\\\ &=- \\frac{6}{3 x + 2} \\\\ &\\not\\equiv - \\frac{4}{3 x + 2}\\end{aligned}\n$$\n\n- Statement “Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement” is false. Substituting $y=- 2 \\ln{\\left(3 x + 2 \\right)}$ and $y\\prime=- \\frac{6}{3 x + 2}$ into the original equation gives expressions that are not identical:\n\n$$\n\\begin{aligned}y\\prime &\\overset{?}{=}- 4 e^{\\frac{y}{2}} \\\\ - \\frac{6}{3 x + 2} &\\overset{?}{=}-4e^{-(- 2 \\ln{\\left(3 x + 2 \\right)})/(-2)} \\\\ - \\frac{6}{3 x + 2} &\\overset{?}{=}-4e^{-\\ln(3 x + 2)} \\\\ - \\frac{6}{3 x + 2} &\\not\\equiv - \\frac{4}{3 x + 2}\\end{aligned}\n$$\n\n- Statement “The function $y=f(x)$ is a solution of the differential equation” is false. Since statement “Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement” is false, the function $y=- 2 \\ln{\\left(3 x + 2 \\right)}$ is not a solution to our differential equation.\n\nTherefore, the correct answer is \"None.\""} {:db/id #edb/ref 17592186618959 :knowledge-point/_questions [{:db/id #edb/ref 17592186129113 :knowledge-point/id #uuid "f5d1d859-0b86-5507-a7bf-3d805a85adf3" :knowledge-point/title "Identifying Augmented Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b511d614-a32a-5f2e-8982-862f2f8bc969" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186618960} {:answer/id #uuid "f87434c1-2715-5dbb-aef1-28b0ae4e63f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186618980}] :answer-field/correct {:answer/id #uuid "b511d614-a32a-5f2e-8982-862f2f8bc969" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186618960} :answer-field/id #uuid "086f4a75-a01f-5011-87f5-e49f49b9a1a7" :answer-field/key "$B=\\left[\\begin{array}{ccc|c}0 & 0 & 5 & 4 \\\\ 0 & 0 & 0 & 4 \\\\ 0 & 0 & 2 & 7 \\\\ 0 & 0 & 0 & -1 \\\\ 0 & 0 & 0 & -5\\end{array}\\right]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186618935} {:answer-field/choices [{:answer/id #uuid "9530c90b-619f-583f-a521-7686913b18b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186618956} {:answer/id #uuid "eaf4aad3-aced-55b5-82b2-4065bf09bcdc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186618975}] :answer-field/correct {:answer/id #uuid "9530c90b-619f-583f-a521-7686913b18b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186618956} :answer-field/id #uuid "3130e52f-ccc4-558c-9568-90fd403b7fb2" :answer-field/key "$A=\\left[\\begin{array}{cccc|c}0 & 4 & 10 & 3 & 1 \\\\ -1 & 9 & 11 & 11 & -5 \\\\ 0 & 0 & 0 & 9 & 4\\end{array}\\right]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186618940} {:answer-field/choices [{:answer/id #uuid "e8734e28-ad5f-5a91-ae22-2028f420ee18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186618974} {:answer/id #uuid "f36ed341-06b7-58e0-a9b8-7bac32141be3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186618977}] :answer-field/correct {:answer/id #uuid "e8734e28-ad5f-5a91-ae22-2028f420ee18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186618974} :answer-field/id #uuid "dbdc51bc-b472-5961-a516-54460948c303" :answer-field/key "$C=\\left[\\begin{array}{ccc|c}0 & 0 & -4 & 6 \\\\ 0 & 0 & 0 & 7 \\\\ 11 & 9 & 5 & 10\\end{array}\\right]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186618970}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b32d6bad-7619-5a20-9b5f-d26342503b3d" :question/problem "Which of the following augmented matrices have coefficient matrices in row echelon form? Treat the final column of each augmented matrix as its constants column.\n\nSelect all that apply." :question/worked-solution "A coefficient matrix, obtained by omitting the final column of its augmented matrix, is in row echelon form if it satisfies the following conditions:\n\nI. All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n\nII. Each leading entry of a nonzero row is in a column *to the right* of the leading entry of the preceding nonzero row.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The coefficient matrix of $A$ is not in row echelon form since the leading entry in row $2$, column $1$ is to the left of the leading entry in row $1$, column $2$ (condition II is violated).\n\n$$\nA=\\left[\\begin{array}{cccc|c}0 & 4 & 10 & 3 & 1 \\\\ -1 & 9 & 11 & 11 & -5 \\\\ 0 & 0 & 0 & 9 & 4\\end{array}\\right]\n$$\n\n- The coefficient matrix of $B$ is not in row echelon form since coefficient row $2$ contains only zeros, but row $3$ is nonzero (condition I is violated).\n\n$$\nB=\\left[\\begin{array}{ccc|c}0 & 0 & 5 & 4 \\\\ 0 & 0 & 0 & 4 \\\\ 0 & 0 & 2 & 7 \\\\ 0 & 0 & 0 & -1 \\\\ 0 & 0 & 0 & -5\\end{array}\\right]\n$$\n\n- The coefficient matrix of $C$ is not in row echelon form since coefficient row $2$ contains only zeros, but row $3$ is nonzero (condition I is violated).\n\n$$\nC=\\left[\\begin{array}{ccc|c}0 & 0 & -4 & 6 \\\\ 0 & 0 & 0 & 7 \\\\ 11 & 9 & 5 & 10\\end{array}\\right]\n$$\n\nTherefore, none of the matrices should be selected."} {:db/id #edb/ref 17592186623024 :knowledge-point/_questions [{:db/id #edb/ref 17592186054815 :knowledge-point/id #uuid "abc6b3ee-0251-5c9c-9358-bd192c434dd1" :knowledge-point/title "Identifying Elements Belonging to Scripted Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1be9efe-ce65-5efc-bb23-f403d34b95f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623063} {:answer/id #uuid "c4aa668c-e2f8-5e24-a47b-fb284b9a7a76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623065}] :answer-field/correct {:answer/id #uuid "c4aa668c-e2f8-5e24-a47b-fb284b9a7a76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623065} :answer-field/id #uuid "2c2e2c17-4b0d-58a4-9050-8c6d2896e644" :answer-field/key "$-\\frac{7}{8}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186623028} {:answer-field/choices [{:answer/id #uuid "a4d86397-555a-5787-bb4d-e1e3a592b1bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623057} {:answer/id #uuid "e3f30574-fe8f-508b-958a-f520747c3e8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623076}] :answer-field/correct {:answer/id #uuid "e3f30574-fe8f-508b-958a-f520747c3e8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623076} :answer-field/id #uuid "3d808df7-a9b5-5f84-b499-841ac593c6d4" :answer-field/key "$3\\sqrt{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :