b/ref 17592186376117 :knowledge-point/_questions [{:db/id #edb/ref 17592186124634 :knowledge-point/id #uuid "69b456ea-44de-59f0-b2c8-bc5b9495974f" :knowledge-point/title "Identifying True Statements From a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8be07d40-14cd-501c-9625-428f6314b23c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471107} {:answer/id #uuid "5e1fbc33-9b75-5356-8f29-faff630373da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471108}] :answer-field/correct {:answer/id #uuid "5e1fbc33-9b75-5356-8f29-faff630373da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471108} :answer-field/id #uuid "033e6ffd-d462-5ef2-ba4e-5234f64cd0b2" :answer-field/key "$A$ is a boundary point of the set $M$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472059} {:answer-field/choices [{:answer/id #uuid "7991d906-5c86-57ce-99ee-53104165937d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471109} {:answer/id #uuid "f9f7795a-8703-51de-b074-73ea8c520f55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471110}] :answer-field/correct {:answer/id #uuid "7991d906-5c86-57ce-99ee-53104165937d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471109} :answer-field/id #uuid "a0637097-c982-516b-929d-09a861e65f3a" :answer-field/key "$B$ is an interior point of the set $M$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472060} {:answer-field/choices [{:answer/id #uuid "9355ff92-d114-5d87-a666-02b