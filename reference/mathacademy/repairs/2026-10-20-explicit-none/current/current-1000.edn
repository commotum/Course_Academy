166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465151} {:answer-field/choices [{:answer/id #uuid "5d54fd92-3963-580f-8ce6-e267e8c2283e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464436} {:answer/id #uuid "5085f31b-5c7c-5afe-9ea5-2b9dff9780a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464437}] :answer-field/correct {:answer/id #uuid "5d54fd92-3963-580f-8ce6-e267e8c2283e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464436} :answer-field/id #uuid "4909e442-e10e-5268-96f3-76d3ff27ca3e" :answer-field/key "$f(x)$ has a discontinuity at $x=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465152}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "22700976-ee21-5930-ae8c-a7e530babcbb" :question/math-academy-id "q-152930" :question/problem "Consider the following function:\n\n$$\nf(x)={\\begin{aligned}-4-x, & x\\le 2 \\\\ -3x, & x>2\\end{aligned}\n$$\n\nWhich of the following statements are true regarding $f(x)?$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "To test for continuity of $f(x)$ at a point $x=c$, we need to check three conditions:\n\n- Does $f(c)$ exist?\n\n- Does ${lim}_{x\\to c}f(x)$ exist?\n\n- Does ${lim}_{x\\to c}f(x)=f(c)?$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement “$f(x)$ is defined at $x=2$” is true. Using the expression for the first branch of the function, we obtain that \n\n$$\nf(2)=-4-2=-6.\n$$\n\nSo, $f(x)$ is defined at $x=2.$ $\\,\\,✓$\n\n- Statement ${lim}_{x\\to {2}^{-}}f(x)={lim}_{x\\to {2}^{+}}f(x)$ is true. By calculating the one-sided limits, we get the following:\n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{-}}f(x) & ={lim}_{x\\to {2}^{-}}(-4-x) \\\\  & =-4-2 \\\\  & =-6 \\\\ {lim}_{x\\to {2}^{+}}f(x) & ={lim}_{x\\to {2}^{+}}(-3x) \\\\  & =-3(2) \\\\  & =-6\\end{aligned}\n$$\n\nAs a result:\n\n$$\n{lim}_{x\\to {2}^{-}}f(x)={lim}_{x\\to {2}^{+}}f(x)\n$$\n\n \nTherefore, the limit of $f(x)$ at $x=2$ exists:\n\n$$\n{lim}_{x\\to 2}f(x)=-6\\,\\,✓\n$$\n\n- Statement ${lim}_{x\\to 2}f(x)=f(2)$ is true. Indeed, we have that ${lim}_{x\\to 2}f(x)=-6=f(2).$  $\\,\\,✓$\n\n- Statement “$f(x)$ has a discontinuity at $x=2$” is false. Since all statements “$f(x)$ is defined at $x=2$”; ${lim}_{x\\to {2}^{-}}f(x)={lim}_{x\\to {2}^{+}}f(x)$; ${lim}_{x\\to 2}f(x)=f(2)$ are true, according to the continuity test, the function $f(x)$ is continuous at $x=2.$\n\nTherefore, the correct answer is “$f(x)$ is defined at $x=2$”; ${lim}_{x\\to {2}^{-}}f(x)={lim}_{x\\to {2}^{+}}f(x)$; ${lim}_{x\\to 2}f(x)=f(2)$ only."} {:db/id #edb/ref 17592186275357 :knowledge-point/_questions [{:db/id #edb/ref 17592186119926 :knowledge-point/id #uuid "19c33c51-bf11-5a81-a0fd-8381d8e0b9d7" :knowledge-point/title "Determining Whether a Line Is a Subspace of Two-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "398c8456-89a1-5b2a-b177-7c042901d158" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464438} {:answer/id #uuid "0ff8260e-6af0-52e3-bb10-d965f0c5153e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464439}] :answer-field/correct {:answer/id #uuid "0ff8260e-6af0-52e3-bb10-d965f0c5153e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464439} :answer-field/id #uuid "a8f499f9-88c4-51cf-b7cc-fce0e2052fbd" :answer-field/key "$L$ contains the zero-vector" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465153} {:answer-field/choices [{:answer/id #uuid "c0b69d56-1ac2-5658-9220-6daa7ad09e35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464440} {:answer/id #uuid "3902b043-29bf-5320-92e3-81580b55d422" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464441}] :answer-field/correct {:answer/id #uuid "3902b043-29bf-5320-92e3-81580b55d422" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464441} :answer-field/id #uuid "3373aec6-7201-50eb-aefe-ad0080fb7754" :answer-field/key "$L$ is closed under vector addition" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465154} {:answer-field/choices [{:answer/id #uuid "1f78f89e-a16f-5632-97f4-b5609621130b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464442} {:answer/id #uuid "7947bcec-220d-561f-a8dd-3f1053459776" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464443}] :answer-field/correct {:answer/id #uuid "7947bcec-220d-561f-a8dd-3f1053459776" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464443} :answer-field/id #uuid "a2bf7047-04e8-5d42-b4cd-8c904a7e2b18" :answer-field/key "$L$ is closed under scalar multiplication" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465155} {:answer-field/choices [{:answer/id #uuid "84c6930c-489d-5bd2-8a89-92301e886857" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464444} {:answer/id #uuid "bbd70689-73bb-5018-9cb5-e10d2dd592c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464445}] :answer-field/correct {:answer/id #uuid "bbd70689-73bb-5018-9cb5-e10d2dd592c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464445} :answer-field/id #uuid "f7476c97-72af-5a74-aead-e576226375b1" :answer-field/key "$L$ is a subspace of ${R}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465156}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "41028c0a-ba2e-5172-bd8b-8e9a6506adda" :question/math-academy-id "q-156596" :question/problem "Let $L$ be the line with equation $y=-x$ in ${R}^{2}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $L$ contains vectors of the form \n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}x \\\\ -x\\end{bmatrix},\\,x\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement “$L$ contains the zero-vector” is true. The coordinates of the zero-vector satisfy the equation $y=-x:$\n\n$$\n\\begin{aligned}y & =-x \\\\ (0) & =-(0) \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\n- Statement “$L$ is closed under vector addition” is true. Let, for example, $a=\\begin{bmatrix}a \\\\ -a\\end{bmatrix}\\in L$ and $b=\\begin{bmatrix}b \\\\ -b\\end{bmatrix}\\in L.$ Then,\n\n$$\n\\begin{aligned}a+b & =\\begin{bmatrix}a \\\\ -a\\end{bmatrix}+\\begin{bmatrix}b \\\\ -b\\end{bmatrix}=\\begin{bmatrix}a+b \\\\ (-a)+(-b)\\end{bmatrix}=\\begin{bmatrix}a+b \\\\ -(a+b)\\end{bmatrix},\\end{aligned}\n$$\n\nwhich satisfies the condition $y=-x.$ Therefore, $a+b\\in L.$\n\n- Statement “$L$ is closed under scalar multiplication” is true. Let, for example, $a=\\begin{bmatrix}a \\\\ -a\\end{bmatrix}\\in L$ and $k\\in R.$ Then,\n\n$$\n\\begin{aligned}k\\cdot a & =k\\cdot \\begin{bmatrix}a \\\\ -a\\end{bmatrix}=\\begin{bmatrix}ka \\\\ k(-a)\\end{bmatrix}=\\begin{bmatrix}ka \\\\ -(ka)\\end{bmatrix},\\end{aligned}\n$$\n\nwhich satisfies the condition $y=-x.$ Therefore, $k\\cdot a\\in L.$\n\n- Statement “$L$ is a subspace of ${R}^{2}$” is true. Since statements “$L$ is closed under vector addition” and “$L$ is closed under scalar multiplication” are true, $L$ must be a subspace of ${R}^{2}.$\n\nTherefore, the correct answer is \"All the statements are true.\""} {:db/id #edb/ref 17592186275358 :knowledge-point/_questions [{:db/id #edb/ref 17592186119926 :knowledge-point/id #uuid "19c33c51-bf11-5a81-a0fd-8381d8e0b9d7" :knowledge-point/title "Determining Whether a Line Is a Subspace of Two-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34a088cc-b42a-52bc-92eb-bd25ac5895d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449708} {:answer/id #uuid "1ae9d0d2-5225-533c-916d-258badd95105" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449709}] :answer-field/correct {:answer/id #uuid "34a088cc-b42a-52bc-92eb-bd25ac5895d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449708} :answer-field/id #uuid "937dcbfa-8dc3-50f6-a185-ae4dc328b41b" :answer-field/key "$L$ contains the zero-vector" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450808} {:answer-field/choices [{:answer/id #uuid "326c98a9-ff77-5b6e-aecb-8e7f1dddecc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449710} {:answer/id #uuid "ac781d5c-11d4-539a-a6a0-03e56d803d8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449711}] :answer-field/correct {:answer/id #uuid "326c98a9-ff77-5b6e-aecb-8e7f1dddecc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449710} :answer-field/id #uuid "c513012e-f0c7-59bd-93e1-bc2abf1598e4" :answer-field/key "$L$ is closed under vector addition" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450809} {:answer-field/choices [{:answer/id #uuid "31a8c64f-0c9c-5370-8df5-0f3072768ab3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449712} {:answer/id #uuid "aced70ec-42bb-5c36-a298-f7b0a764a07e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449713}] :answer-field/correct {:answer/id #uuid "31a8c64f-0c9c-5370-8df5-0f3072768ab3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449712} :answer-field/id #uuid "9c508d60-bfd9-5766-b225-3dfedd6417f5" :answer-field/key "$L$ is closed under scalar multiplication" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450810} {:answer-field/choices [{:answer/id #uuid "66001218-3dc4-59d1-a926-442ef428f82c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449714} {:answer/id #uuid "67502b01-affc-5927-8b15-bd8da2993526" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449715}] :answer-field/correct {:answer/id #uuid "67502b01-affc-5927-8b15-bd8da2993526" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449715} :answer-field/id #uuid "ce7a4fe0-4bec-5040-8666-8761d884ec88" :answer-field/key "$L$ is **not** a subspace of ${R}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450811}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "238a8f80-b240-55d1-a1f3-be7bf8e77e18" :question/math-academy-id "q-156624" :question/problem "Let $L$ be the line with equation $x=2y-1$ in ${R}^{2}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $L$ contains vectors of the form \n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}2y-1 \\\\ y\\end{bmatrix},\\,y\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement “$L$ contains the zero-vector” is false. The coordinates of the zero-vector do not satisfy the equation $x=2y-1:$\n\n$$\n\\begin{aligned}x & =2y-1 \\\\ (0) & =2(0)-1 \\\\ 0 & =-1\\,\\times \\end{aligned}\n$$\n\n- Statement “$L$ is closed under vector addition” is false. Let, for example, $a=\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}$ and $b=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$ from $L.$ Then,\n\n$$\n\\begin{aligned}a+b & =\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}+\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}-1+1 \\\\ 0+1\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\n \nHowever, $\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}\\notin L$ since substituting the coordinates into the equation, we obtain the following: \n\n$$\n\\begin{aligned}x & =2y-1 \\\\ (0) & =2(1)-1 \\\\ 0 & =1\\,\\times \\end{aligned}\n$$\n\n- Statement “$L$ is closed under scalar multiplication” is false. Since $0\\notin L,$ this set is not closed under scalar multiplication.\n\n- Statement “$L$ is **not** a subspace of ${R}^{2}$” is true. Since statements “$L$ is closed under vector addition” and “$L$ is closed under scalar multiplication” are false, $L$ is *not* a subspace of ${R}^{2}.$\n\nTherefore, the correct answer is “$L$ is **not** a subspace of ${R}^{2}$” only."} {:db/id #edb/ref 17592186275359 :knowledge-point/_questions [{:db/id #edb/ref 17592186119926 :knowledge-point/id #uuid "19c33c51-bf11-5a81-a0fd-8381d8e0b9d7" :knowledge-point/title "Determining Whether a Line Is a Subspace of Two-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f11d9c02-3fcb-5de5-9310-548ef0ea1976" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464446} {:answer/id #uuid "af5ca6bf-57c5-54f8-8c3d-74a6501b1c92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464447}] :answer-field/correct {:answer/id #uuid "af5ca6bf-57c5-54f8-8c3d-74a6501b1c92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464447} :answer-field/id #uuid "d5c0c456-50b3-5b9e-b75c-057a51b3cb94" :answer-field/key "$L$ contains the zero-vector" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465157} {:answer-field/choices [{:answer/id #uuid "31d0dc76-0c99-5824-8dd2-2bb7cd735f25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464448} {:answer/id #uuid "2a785ac7-7123-5e81-8212-f960187ffcc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464449}] :answer-field/correct {:answer/id #uuid "2a785ac7-7123-5e81-8212-f960187ffcc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464449} :answer-field/id #uuid "3033df77-bf3c-59b5-9b8c-4f1e33a15732" :answer-field/key "$L$ is closed under vector addition" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465158} {:answer-field/choices [{:answer/id #uuid "abd1831a-3f45-5615-bfb4-1f61ee6504d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464450} {:answer/id #uuid "7e166bca-aae1-51a7-aef5-1c539b2e96c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464451}] :answer-field/correct {:answer/id #uuid "7e166bca-aae1-51a7-aef5-1c539b2e96c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464451} :answer-field/id #uuid "c4bad57b-de5d-5929-9ce2-6ee9a38a2741" :answer-field/key "$L$ is closed under scalar multiplication" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465159} {:answer-field/choices [{:answer/id #uuid "6ec7d5d4-d2c7-5341-b462-a61b953ba95c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464452} {:answer/id #uuid "b7e32e69-5a2f-5d72-9e79-4f67730c1317" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464453}] :answer-field/correct {:answer/id #uuid "b7e32e69-5a2f-5d72-9e79-4f67730c1317" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464453} :answer-field/id #uuid "d911c6c4-5349-5bc9-bfa9-b8374c8015e9" :answer-field/key "$L$ is a subspace of ${R}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465160}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f3a8da8b-2b40-54c1-8d4a-0bb7a1d10698" :question/math-academy-id "q-156628" :question/problem "Let $L$ be the line with equation $x=5y$ in ${R}^{2}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $L$ contains vectors of the form \n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}5y \\\\ y\\end{bmatrix},\\,y\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement “$L$ contains the zero-vector” is true. The coordinates of the zero-vector satisfy the equation $x=5y:$\n\n$$\n\\begin{aligned}x & =5y \\\\ (0) & =5(0) \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\n- Statement “$L$ is closed under vector addition” is true. Let, for example, $a=\\begin{bmatrix}5a \\\\ a\\end{bmatrix}\\in L$ and $b=\\begin{bmatrix}5b \\\\ b\\end{bmatrix}\\in L.$ Then,\n\n$$\n\\begin{aligned}a+b & =\\begin{bmatrix}5a \\\\ a\\end{bmatrix}+\\begin{bmatrix}5b \\\\ b\\end{bmatrix}=\\begin{bmatrix}5a+5b \\\\ a+b\\end{bmatrix}=\\begin{bmatrix}5(a+b) \\\\ a+b\\end{bmatrix},\\end{aligned}\n$$\n\nwhich satisfies the condition $x=5y.$ Therefore, $a+b\\in L.$\n\n- Statement “$L$ is closed under scalar multiplication” is true. Let, for example, $a=\\begin{bmatrix}5a \\\\ a\\end{bmatrix}\\in L$ and $k\\in R.$ Then,\n\n$$\n\\begin{aligned}k\\cdot a & =k\\cdot \\begin{bmatrix}5a \\\\ a\\end{bmatrix}=\\begin{bmatrix}5ka \\\\ ka\\end{bmatrix},\\end{aligned}\n$$\n\nwhich satisfies the condition $x=5y.$ Therefore, $k\\cdot a\\in L.$\n\n- Statement “$L$ is a subspace of ${R}^{2}$” is true. Since statements “$L$ is closed under vector addition” and “$L$ is closed under scalar multiplication” are true, $L$ must be a subspace of ${R}^{2}.$\n\nTherefore, the correct answer is \"All the statements are true.\""} {:db/id #edb/ref 17592186275361 :knowledge-point/_questions [{:db/id #edb/ref 17592186119926 :knowledge-point/id #uuid "19c33c51-bf11-5a81-a0fd-8381d8e0b9d7" :knowledge-point/title "Determining Whether a Line Is a Subspace of Two-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fca54e64-8da5-5300-81d5-621319139a0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464454} {:answer/id #uuid "8d01f75a-025b-59d0-8a7f-ae3f3534536e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464455}] :answer-field/correct {:answer/id #uuid "8d01f75a-025b-59d0-8a7f-ae3f3534536e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464455} :answer-field/id #uuid "607a663d-f3a1-56c7-8bbc-ea1357b57595" :answer-field/key "$L$ contains the zero-vector" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465161} {:answer-field/choices [{:answer/id #uuid "83d40c4c-b287-5318-abca-849a3b48a9f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464456} {:answer/id #uuid "71d9cbed-ec30-5149-8915-81dbc623da0c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464457}] :answer-field/correct {:answer/id #uuid "71d9cbed-ec30-5149-8915-81dbc623da0c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464457} :answer-field/id #uuid "c3d24685-af98-5d36-b88b-edd828939c6d" :answer-field/key "$L$ is closed under vector addition" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465162} {:answer-field/choices [{:answer/id #uuid "e78f9e97-3dd4-5189-9309-14423df893d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464458} {:answer/id #uuid "21db992d-750b-5f63-b8be-eb9f118bb7fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464459}] :answer-field/correct {:answer/id #uuid "21db992d-750b-5f63-b8be-eb9f118bb7fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464459} :answer-field/id #uuid "c505563e-02f1-5d4d-b33c-cc4b08f19956" :answer-field/key "$L$ is closed under scalar multiplication" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465163} {:answer-field/choices [{:answer/id #uuid "4f159163-fe13-514b-9d7e-7661613440a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464460} {:answer/id #uuid "6a18a431-084a-513a-9d8a-fb9bebf0735e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464461}] :answer-field/correct {:answer/id #uuid "6a18a431-084a-513a-9d8a-fb9bebf0735e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464461} :answer-field/id #uuid "e378c5aa-d7e5-580c-913c-5f05c0170396" :answer-field/key "$L$ is a subspace of ${R}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465164}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5f2f3e53-cc1d-51df-ab0f-2a9380a01406" :question/math-academy-id "q-156653" :question/problem "Let $L$ be the line with equation $y=-3x$ in ${R}^{2}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $L$ contains vectors of the form \n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}x \\\\ -3x\\end{bmatrix},\\,x\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement “$L$ contains the zero-vector” is true. The coordinates of the zero-vector satisfy the equation $y=-3x:$\n\n$$\n\\begin{aligned}y & =-3x \\\\ (0) & =-3(0) \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\n- Statement “$L$ is closed under vector addition” is true. Let, for example, $a=\\begin{bmatrix}a \\\\ -3a\\end{bmatrix}\\in L$ and $b=\\begin{bmatrix}b \\\\ -3b\\end{bmatrix}\\in L.$ Then,\n\n$$\n\\begin{aligned}a+b & =\\begin{bmatrix}a \\\\ -3a\\end{bmatrix}+\\begin{bmatrix}b \\\\ -3b\\end{bmatrix}=\\begin{bmatrix}a+b \\\\ (-3a)+(-3b)\\end{bmatrix}=\\begin{bmatrix}a+b \\\\ -3(a+b)\\end{bmatrix},\\end{aligned}\n$$\n\nwhich satisfies the condition $y=-3x.$ Therefore, $a+b\\in L.$\n\n- Statement “$L$ is closed under scalar multiplication” is true. Let, for example, $a=\\begin{bmatrix}a \\\\ -3a\\end{bmatrix}\\in L$ and $k\\in R.$ Then,\n\n$$\n\\begin{aligned}k\\cdot a & =k\\cdot \\begin{bmatrix}a \\\\ -3a\\end{bmatrix}=\\begin{bmatrix}ka \\\\ k(-3a)\\end{bmatrix}=\\begin{bmatrix}ka \\\\ -3(ka)\\end{bmatrix}\\end{aligned}\n$$\n\nwhich satisfies the condition $y=-3x.$ Therefore, $k\\cdot a\\in L.$\n\n- Statement “$L$ is a subspace of ${R}^{2}$” is true. Since statements “$L$ is closed under vector addition” and “$L$ is closed under scalar multiplication” are true, $L$ must be a subspace of ${R}^{2}.$\n\nTherefore, the correct answer is \"All the statements are true.\""} {:db/id #edb/ref 17592186275363 :knowledge-point/_questions [{:db/id #edb/ref 17592186119927 :knowledge-point/id #uuid "83796fe8-f045-5dbc-94d1-6d6e031f3ed8" :knowledge-point/title "Determining Whether a Line Is a Subspace of Three-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aaade65c-fd86-5a9b-8729-a4c2c4ccca8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449716} {:answer/id #uuid "bb833c56-c66e-5718-b471-3e56c85a86c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449717}] :answer-field/correct {:answer/id #uuid "aaade65c-fd86-5a9b-8729-a4c2c4ccca8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449716} :answer-field/id #uuid "0011bc07-f81e-5e05-bcdc-0342a9c6c596" :answer-field/key "$L$ contains the zero-vector" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450812} {:answer-field/choices [{:answer/id #uuid "5a882b8f-e425-5991-861f-e7c1ca194fce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449718} {:answer/id #uuid "e0f9d115-1d82-547b-8423-7b8f79166139" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449719}] :answer-field/correct {:answer/id #uuid "5a882b8f-e425-5991-861f-e7c1ca194fce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449718} :answer-field/id #uuid "38c51f83-7f86-5f22-a252-185add215172" :answer-field/key "$L$ is closed under vector addition" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450813} {:answer-field/choices [{:answer/id #uuid "31c32c72-3b8d-5eb8-b63b-525c4b6f5be3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449720} {:answer/id #uuid "082ec2d9-95d9-56a3-9e45-c48c7dfe1465" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449721}] :answer-field/correct {:answer/id #uuid "31c32c72-3b8d-5eb8-b63b-525c4b6f5be3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449720} :answer-field/id #uuid "579d8368-3de0-5e84-9641-f66bc5dcc737" :answer-field/key "$L$ is closed under scalar multiplication" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450814} {:answer-field/choices [{:answer/id #uuid "fcc9c302-3722-57e5-8729-a3c5ced64e28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449722} {:answer/id #uuid "9d1945d1-4e98-5897-b692-84f26ca03545" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449723}] :answer-field/correct {:answer/id #uuid "9d1945d1-4e98-5897-b692-84f26ca03545" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449723} :answer-field/id #uuid "78f7c353-1833-5e2f-a1a0-90570b00960c" :answer-field/key "$L$ is **not** a subspace of ${R}^{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450815}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "951ef63e-740e-55a7-b946-00aea8b9f2dd" :question/math-academy-id "q-156727" :question/problem "Let $L$ be the line in ${R}^{3}$ that passes through the points $(1,2,3)$ and $(3,2,1).$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nWith that in mind, let's examine our statements. \n\n- Statement “$L$ contains the zero-vector” is false.The direction vector of the line $L$ is \n\n$$\nd=\\begin{bmatrix}3 \\\\ 2 \\\\ 1\\end{bmatrix}-\\begin{bmatrix}1 \\\\ 2 \\\\ 3\\end{bmatrix}=\\begin{bmatrix}2 \\\\ 0 \\\\ -2\\end{bmatrix}.\n$$\n\nThis means that the vector equation of the line is\n\n$$\n\\begin{aligned}r & =\\begin{bmatrix}1 \\\\ 2 \\\\ 3\\end{bmatrix}+t\\begin{bmatrix}2 \\\\ 0 \\\\ -2\\end{bmatrix}\\end{aligned}\n$$\n\nfor $t\\in R,$ and the corresponding Cartesian equation is \n\n$$\n\\frac{x-1}{2}=\\frac{z-3}{-2},\\,y=2\n$$\n\nBut this line does not pass through the origin since the second coordinate of any point on this line satisfies\n\n$$\ny=2\\ne 0.\\,\\times \n$$\n\n- Statement “$L$ is closed under vector addition” is false. Let's consider the vectors $\\begin{bmatrix}1 \\\\ 2 \\\\ 3\\end{bmatrix}$ and $\\begin{bmatrix}3 \\\\ 2 \\\\ 1\\end{bmatrix}$ from $L$ (the position vectors of the given points). Then,\n\n$$\n\\begin{bmatrix}1 \\\\ 2 \\\\ 3\\end{bmatrix}+\\begin{bmatrix}3 \\\\ 2 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}4 \\\\ 4 \\\\ 4\\end{bmatrix}.\n$$\n\nHowever, point $(4,4,4)$ does not belong to $L$ since it does not satisfy the equation of the line. Indeed, we have\n\n$$\ny=4\\ne 2.\\,\\times \n$$\n\n- Statement “$L$ is closed under scalar multiplication” is false. Since $0\\notin L,$ this set is not closed under scalar multiplication.\n\n- Statement “$L$ is **not** a subspace of ${R}^{3}$” is true. Since statements “$L$ is closed under vector addition” and “$L$ is closed under scalar multiplication” are false, $L$ is *not* a subspace of ${R}^{3}.$\n\nTherefore, the correct answer is “$L$ is **not** a subspace of ${R}^{3}$” only."} {:db/id #edb/ref 17592186275364 :knowledge-point/_questions [{:db/id #edb/ref 17592186119928 :knowledge-point/id #uuid "4f3018fd-9d16-578f-b050-966890844c9b" :knowledge-point/title "Determining Whether a Plane Is a Subspace of Three-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f9cc33e-c0c5-5b8b-9b7b-43449e48f5c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449724} {:answer/id #uuid "1ab14dcf-d31d-59b5-8499-1d27c4e784e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449725}] :answer-field/correct {:answer/id #uuid "1ab14dcf-d31d-59b5-8499-1d27c4e784e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449725} :answer-field/id #uuid "0651069d-7707-5fad-8a54-669911bd9d80" :answer-field/key "$Π$ contains the zero-vector" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450816} {:answer-field/choices [{:answer/id #uuid "14724386-89dd-54a5-ab82-72539dd3007f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449726} {:answer/id #uuid "9671fed1-1431-512a-aa76-99f0de1a0d1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449727}] :answer-field/correct {:answer/id #uuid "9671fed1-1431-512a-aa76-99f0de1a0d1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449727} :answer-field/id #uuid "25f0248b-b483-56f2-af25-7de8977c4281" :answer-field/key "$Π$ is closed under vector addition" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450817} {:answer-field/choices [{:answer/id #uuid "71b5ce27-d0dd-5afe-aa3a-11d51af83877" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449728} {:answer/id #uuid "87326de9-3ade-5902-87b1-b7d5f32e5699" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449729}] :answer-field/correct {:answer/id #uuid "87326de9-3ade-5902-87b1-b7d5f32e5699" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449729} :answer-field/id #uuid "f3a7804f-54ea-5a31-bab1-80ae62f7f878" :answer-field/key "$Π$ is closed under scalar multiplication" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450818} {:answer-field/choices [{:answer/id #uuid "0f36e98d-5226-5d6a-9092-d396e8b0bd32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449730} {:answer/id #uuid "812e04eb-ae5d-5f1c-86cc-e53391996a85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449731}] :answer-field/correct {:answer/id #uuid "0f36e98d-5226-5d6a-9092-d396e8b0bd32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449730} :answer-field/id #uuid "ca03455e-a692-57a1-b149-1867333e9c39" :answer-field/key "$Π$ is **not** a subspace of ${R}^{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450819}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "36959921-7ebb-5f39-a723-592fbf72eec8" :question/math-academy-id "q-156728" :question/problem "Let $Π$ be the plane with equation $z=2x-5y$ in ${R}^{3}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $Π$ contains vectors of the form \n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}x \\\\ y \\\\ 2x-5y\\end{bmatrix},\\,x,y\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement “$Π$ contains the zero-vector” is true. The coordinates of the zero-vector satisfy the equation $z=2x-5y:$\n\n$$\n\\begin{aligned}z & =2x-5y \\\\ (0) & =2(0)-5(0) \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\n- Statement “$Π$ is closed under vector addition” is true. Let, for example, $a=\\begin{bmatrix}{a}_{1} \\\\ {a}_{2} \\\\ 2{a}_{1}-5{a}_{2}\\end{bmatrix}\\in Π$ and $b=\\begin{bmatrix}{b}_{1} \\\\ {b}_{2} \\\\ 2{b}_{1}-5{b}_{2}\\end{bmatrix}\\in Π.$ Then,\n\n$$\n\\begin{aligned}a+b & =\\begin{bmatrix}{a}_{1} \\\\ {a}_{2} \\\\ 2{a}_{1}-5{a}_{2}\\end{bmatrix}+\\begin{bmatrix}{b}_{1} \\\\ {b}_{2} \\\\ 2{b}_{1}-5{b}_{2}\\end{bmatrix}=\\begin{bmatrix}{a}_{1}+{b}_{1} \\\\ {a}_{2}+{b}_{2} \\\\ (2{a}_{1}-5{a}_{2})+(2{b}_{1}-5{b}_{2})\\end{bmatrix}=\\begin{bmatrix}{a}_{1}+{b}_{1} \\\\ {a}_{2}+{b}_{2} \\\\ 2({a}_{1}+{b}_{1})-5({a}_{2}+{b}_{2})\\end{bmatrix},\\end{aligned}\n$$\n\nwhich satisfies the condition $z=2x-5y.$ Therefore, $a+b\\in Π.$\n\n- Statement “$Π$ is closed under scalar multiplication” is true. Let, for example, $a=\\begin{bmatrix}{a}_{1} \\\\ {a}_{2} \\\\ 2{a}_{1}-5{a}_{2}\\end{bmatrix}\\in Π$ and $k\\in R.$ Then,\n\n$$\n\\begin{aligned}k\\cdot a & =k\\cdot \\begin{bmatrix}{a}_{1} \\\\ {a}_{2} \\\\ 2{a}_{1}-5{a}_{2}\\end{bmatrix}=\\begin{bmatrix}k{a}_{1} \\\\ k{a}_{2} \\\\ k(2{a}_{1}-5{a}_{2})\\end{bmatrix}=\\begin{bmatrix}k{a}_{1} \\\\ k{a}_{2} \\\\ 2k{a}_{1}-5k{a}_{2}\\end{bmatrix},\\end{aligned}\n$$\n\nwhich satisfies the condition $z=2x-5y.$ Therefore, $k\\cdot a\\in Π.$\n\n- Statement “$Π$ is **not** a subspace of ${R}^{3}$” is false. Since statements “$Π$ is closed under vector addition” and “$Π$ is closed under scalar multiplication” are true, the plane $Π$ must be a subspace of ${R}^{3}.$\n\nTherefore, the correct answer is “$Π$ contains the zero-vector”; “$Π$ is closed under vector addition”; “$Π$ is closed under scalar multiplication” only."} {:db/id #edb/ref 17592186275376 :knowledge-point/_questions [{:db/id #edb/ref 17592186119924 :knowledge-point/id #uuid "7eb5ca50-e9f3-5513-aff1-1ada8c225a42" :knowledge-point/title "Identifying Linearly Independent Sets by Inspection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1950ae6-0473-5fe6-8e7a-228cd3690e6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449732} {:answer/id #uuid "bd56d1c9-b738-5348-a8a1-732e246f1ee0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449733}] :answer-field/correct {:answer/id #uuid "e1950ae6-0473-5fe6-8e7a-228cd3690e6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449732} :answer-field/id #uuid "b8f7bc3c-eb1f-599b-8029-2012a610c8f5" :answer-field/key "$-2{a}_{1}+{a}_{2}=0.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450820} {:answer-field/choices [{:answer/id #uuid "3864cbe3-89b6-5159-97a9-37efb82c2a2b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449734} {:answer/id #uuid "1fabce41-348a-50ae-8ad9-61713e395e31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449735}] :answer-field/correct {:answer/id #uuid "1fabce41-348a-50ae-8ad9-61713e395e31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449735} :answer-field/id #uuid "75419a8e-9154-5aff-96c8-21ca3990f7be" :answer-field/key "${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=0$ only if ${x}_{1}={x}_{2}=0.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450821} {:answer-field/choices [{:answer/id #uuid "d16d616a-43e7-5149-b235-d90ebb093d73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449736} {:answer/id #uuid "aca33250-948f-5f9f-9edd-8103499ab8a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449737}] :answer-field/correct {:answer/id #uuid "d16d616a-43e7-5149-b235-d90ebb093d73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449736} :answer-field/id #uuid "44699a4d-8bdd-5ddc-ac60-498b82a1f309" :answer-field/key "The set ${{a}_{1},{a}_{2}}$ is linearly dependent." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450822}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8e786624-3795-5bd2-9044-40e13fec09b2" :question/math-academy-id "q-157162" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=\\begin{bmatrix}4 \\\\ 0 \\\\ -2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}0 \\\\ 1 \\\\ -1\\end{bmatrix}\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "We say that two vectors ${v}_{1}$ and ${v}_{2}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}=0\n$$\n\nis ${x}_{1}={x}_{2}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's look at each statement in turn.\n\n- Statement $-2{a}_{1}+{a}_{2}=0.$ is false. Indeed:\n\n$$\n\\begin{aligned}-2{a}_{1}+{a}_{2} & =-2\\begin{bmatrix}4 \\\\ 0 \\\\ -2\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 1 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-8 \\\\ 0 \\\\ 4\\end{bmatrix}-\\begin{bmatrix}0 \\\\ 1 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-8 \\\\ 1 \\\\ 3\\end{bmatrix} \\\\  & \\ne 0\\end{aligned}\n$$\n\n- Statement “${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=0$ only if ${x}_{1}={x}_{2}=0.$” is true. The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=0$ corresponds to the system\n\n$$\n\\left\\{\\begin{aligned}4{x}_{1} &=0 \\\\ {x}_{2} &=0 \\\\ -2{x}_{1}-{x}_{2} &=0.\\end{aligned}\\right.\n$$\n\nSolving this system, we find that the solution is ${x}_{1}={x}_{2}=0.$\n\n- Statement “The set ${{a}_{1},{a}_{2}}$ is linearly dependent” is false. Since statement “${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=0$ only if ${x}_{1}={x}_{2}=0.$” is true, the set ${{a}_{1},{a}_{2}}$ is linearly independent.\n\nTherefore, the correct answer is “${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=0$ only if ${x}_{1}={x}_{2}=0.$” only."} {:db/id #edb/ref 17592186275381 :knowledge-point/_questions [{:db/id #edb/ref 17592186119924 :knowledge-point/id #uuid "7eb5ca50-e9f3-5513-aff1-1ada8c225a42" :knowledge-point/title "Identifying Linearly Independent Sets by Inspection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b32cae0a-cfa4-5a48-bec0-bec8d7dc3e30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449738} {:answer/id #uuid "6d898115-c0eb-5d34-a917-b7dcf7a96360" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449739}] :answer-field/correct {:answer/id #uuid "b32cae0a-cfa4-5a48-bec0-bec8d7dc3e30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449738} :answer-field/id #uuid "8e4a2d88-db64-5b31-a70f-9ea4ef7e3add" :answer-field/key "$-2{a}_{1}-{a}_{2}+3{a}_{3}=0.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450823} {:answer-field/choices [{:answer/id #uuid "c6344cc8-bb74-5e6c-9860-774ada96f354" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449740} {:answer/id #uuid "050a05d6-6400-526a-a36f-ba1b9194ee43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449741}] :answer-field/correct {:answer/id #uuid "050a05d6-6400-526a-a36f-ba1b9194ee43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449741} :answer-field/id #uuid "5467665c-f7b2-59ad-ab79-2399fd1df6d3" :answer-field/key "${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ only if ${x}_{1}={x}_{2}={x}_{3}=0.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450824} {:answer-field/choices [{:answer/id #uuid "7cd399a4-4400-5571-ba68-3479c6931057" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449742} {:answer/id #uuid "5d77d526-ac50-5cf3-9c88-9acb57c981b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449743}] :answer-field/correct {:answer/id #uuid "5d77d526-ac50-5cf3-9c88-9acb57c981b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449743} :answer-field/id #uuid "b615c788-1967-500e-ab0a-355ff0e497b9" :answer-field/key "The set $\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is linearly independent." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450825}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "97d72a17-2281-52f3-a3f9-d658f3c735d4" :question/math-academy-id "q-157224" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=\\begin{bmatrix}-3 \\\\ 0 \\\\ -1\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}2 \\\\ -4 \\\\ 2\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}0 \\\\ 0 \\\\ 5\\end{bmatrix}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "We say that three vectors ${v}_{1},{v}_{2}$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's look at each statement in turn.\n\n- Statement $-2{a}_{1}-{a}_{2}+3{a}_{3}=0.$ is false. Indeed:\n\n$$\n\\begin{aligned}-2{a}_{1}-{a}_{2}+3{a}_{3} & =-2\\begin{bmatrix}-3 \\\\ 0 \\\\ -1\\end{bmatrix}-\\begin{bmatrix}2 \\\\ -4 \\\\ 2\\end{bmatrix}+3\\begin{bmatrix}0 \\\\ 0 \\\\ 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 \\\\ 0 \\\\ 2\\end{bmatrix}-\\begin{bmatrix}2 \\\\ -4 \\\\ 2\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 0 \\\\ 15\\end{bmatrix} \\\\  & =\\begin{bmatrix}6-2+0 \\\\ 0+4+0 \\\\ 2-2+15\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 \\\\ 4 \\\\ 15\\end{bmatrix} \\\\  & \\ne 0\\end{aligned}\n$$\n\n- Statement “${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ only if ${x}_{1}={x}_{2}={x}_{3}=0.$” is true. The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system\n\n$$\n\\left\\{\\begin{aligned}-3{x}_{1}+2{x}_{2} &=0 \\\\ -4{x}_{2} &=0 \\\\ -{x}_{1}+2{x}_{2}+5{x}_{3} &=0.\\end{aligned}\\right.\n$$\n\nNotice that we can reorder the equations in this system as follows:\n\n$$\n\\left\\{\\begin{aligned}-{x}_{1}+2{x}_{2}+5{x}_{3} &=0 \\\\ -3{x}_{1}+2{x}_{2} &=0 \\\\ -4{x}_{2} &=0\\end{aligned}\\right.\n$$\n\nSolving this system using back substitution, we find that the solution is ${x}_{1}={x}_{2}={x}_{3}=0.$\n\n- Statement “The set $\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is linearly independent” is true. Since statement “${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ only if ${x}_{1}={x}_{2}={x}_{3}=0.$” is true, the set $\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is linearly independent.\n\nTherefore, the correct answer is “${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ only if ${x}_{1}={x}_{2}={x}_{3}=0.$”; “The set $\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is linearly independent” only."} {:db/id #edb/ref 17592186275382 :knowledge-point/_questions [{:db/id #edb/ref 17592186119924 :knowledge-point/id #uuid "7eb5ca50-e9f3-5513-aff1-1ada8c225a42" :knowledge-point/title "Identifying Linearly Independent Sets by Inspection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "450fa0a5-918f-5572-9d4e-0b23223efc3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.