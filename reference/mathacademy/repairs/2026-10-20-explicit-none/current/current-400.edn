f 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461152}] :answer-field/correct {:answer/id #uuid "25190ea0-0685-5890-9db9-5739c5ce0367" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461151} :answer-field/id #uuid "b39d0b32-f6c2-5323-b864-79a3f3959abb" :answer-field/key "$S=\\{{p}_{1}(t),{p}_{2}(t),{p}_{3}(t)\\}$ is an orthogonal set with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462329}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e68e3d26-aa65-5eb7-b898-7c00e9b7271e" :question/math-academy-id "q-100091" :question/problem "Consider the following set of polynomials:\n\n$$\n{p}_{1}(t)=t-1,\\,{p}_{2}(t)=2,\\,{p}_{3}(t)=t+1.\n$$\n\nGiven that the inner product in the vector space ${R}_{1}[t]$ of polynomials of degree at most $1$ in the variable $t$ is defined as \n\n$$\n⟨p(t),q(t)⟩=p(-1)q(-1)+p(1)q(1),\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Recall that a set of vectors in an inner product space is orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement “${p}_{1}(t)⊥{p}_{3}(t)$ with respect to the given inner product” is true. Indeed, we have\n\n$$\n\\begin{aligned}⟨{p}_{1}(t),{p}_{3}(t)⟩ & =⟨t-1,t+1⟩ \\\\  & =(t-1){|}_{-1}\\cdot (t+1){|}_{-1}+(t-1){|}_{1}\\cdot (t+1){|}_{1} \\\\  & =(-1-1)\\cdot ((-1)+1)+(1-1)\\cdot (1+1) \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${p}_{1}(t)⊥{p}_{3}(t)$ with respect to the given inner product.\n\n- Statement “${p}_{2}(t)⊥{p}_{3}(t)$ with respect to the given inner product” is false since\n\n$$\n\\begin{aligned}⟨{p}_{2}(t),{p}_{3}(t)⟩ & =⟨2,t+1⟩ \\\\  & =(2){|}_{-1}\\cdot (t+1){|}_{-1}+(2){|}_{1}\\cdot (t+1){|}_{1} \\\\  & =(2)\\cdot ((-1)+1)+(2)\\cdot (1+1) \\\\  & =4\\ne 0,\\end{aligned}\n$$\n\nwhich means that ${p}_{2}(t)⊥̸{p}_{3}(t)$ with respect to the given inner product.\n\n- Statement “$S=\\{{p}_{1}(t),{p}_{2}(t),{p}_{3}(t)\\}$ is an orthogonal set with respect to the given inner product” is false. Since ${p}_{2}(t)⊥̸{p}_{3}(t),$ the set $S$ is *not* orthogonal.\n\nTherefore, the correct answer is “${p}_{1}(t)⊥{p}_{3}(t)$ with respect to the given inner product” only."} {:db/id #edb/ref 17592186237781 :knowledge-point/_questions [{:db/id #edb/ref 17592186133870 :knowledge-point/id #uuid "c2bcfcb6-8f8b-5aa9-8346-05db880fa5bb" :knowledge-point/title "Determining Whether a Set of Polynomials is Orthogonal With Respect to a Given Inner Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "db20fdb5-b211-5717-8065-e53a2737e52f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461153} {:answer/id #uuid "6656a7b8-c8ea-5900-b91f-827cf9160375" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461154}] :answer-field/correct {:answer/id #uuid "6656a7b8-c8ea-5900-b91f-827cf9160375" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461154} :answer-field/id #uuid "3e43ba6a-40ab-5c1a-b8c8-a8858483f612" :answer-field/key "${p}_{1}(t)⊥̸{p}_{2}(t)$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462330} {:answer-field/choices [{:answer/id #uuid "20ed73bc-5b6f-5ab3-960f-9b7f15c8d785" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461155} {:answer/id #uuid "9793f44e-45c4-5a51-9746-6