 :db/id #edb/ref 17592186440285}] :question/id #uuid "2fe51fc5-fce7-5fb6-911c-f561e72ff3fa" :question/math-academy-id "q-59732" :question/problem "![](images/4d/4d78eaaedd26a27d9163fdcddfce5c5ed429e441a75d361f0840935fce9235c6.png)\n\nWhich of the following gives the graph of the straight line above?\n\nSelect all that apply." :question/worked-solution "The line has intercepts (0,4) and (4,0), so its equation is y=4-x, statement $y = 4 - x$."} {:db/id #edb/ref 17592186055498 :knowledge-point/_questions [{:db/id #edb/ref 17592186054814 :knowledge-point/id #uuid "3de9e532-559c-5fc1-a6ad-5fcd1ed77824" :knowledge-point/title "Identifying Special Sets Containing a Given Element"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8033c9e3-c167-5119-a217-ce9eec57c783" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460245} {:answer/id #uuid "f0870cf1-e547-5b1d-817f-0b15545b8bcc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460246}] :answer-field/correct {:answer/id #uuid "f0870cf1-e547-5b1d-817f-0b15545b8bcc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460246} :answer-field/id #uuid "91596938-2de0-53f3-b399-4d048fffca5c" :answer-field/key "Complex numbers ($C$)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460989} {:answer-field/choices [{:answer/id #uuid "6bcfc6c9-1d2c-5958-b70b-a2b0f362879d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460247} {:answer/id #uuid "75ea4269-161a-59d3-bde9-3ebf268c93bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460248}] :answer-field/correct {:answer/id #uuid "6bcfc6c9-1d2c-5958-b70b-a2b0f3