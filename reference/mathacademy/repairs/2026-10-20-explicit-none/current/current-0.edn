99 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439685} {:answer/id #uuid "fe5d0e4b-4760-5425-a923-43352650bfe9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439686}] :answer-field/correct {:answer/id #uuid "270a5b71-3915-5850-8788-bc548f41d954" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439685} :answer-field/id #uuid "5a19d75c-3eed-54b2-a2f9-10eed15585db" :answer-field/key "$x=\\frac{1}{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440200} {:answer-field/choices [{:answer/id #uuid "fa22bcde-c54b-5542-b3bd-0a8bf7a65dc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439687} {:answer/id #uuid "d9b0d5f8-4df1-5a6b-a1be-5feea26e4047" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439688}] :answer-field/correct {:answer/id #uuid "fa22bcde-c54b-5542-b3bd-0a8bf7a65dc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439687} :answer-field/id #uuid "c1e53830-f968-55eb-a3e6-f975bcb3f1ce" :answer-field/key "$x=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440201}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bac7c54b-040c-5d96-8fcc-40e2d221cff2" :question/math-academy-id "q-39795" :question/problem "Calculate the vertical asymptotes of $f(x)=\\frac{5}{{x}^{3}+{x}^{2}+x}.$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{5}{{x}^{3}+{x}^{2}+x} \\\\  & =\\frac{5}{x({x}^{2}+x+1)}.\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we set the denominator equal to zero. This gives\n\n$$\nx({x}^{2}+x+1)=0.\n$$\n\nWe now solve the above equation using the zero product property:\n\n- Solving $2x=0$ gives the solution $x=0.$\n\n- The equation ${x}^{2}+x+1=0$ has no real solutions because the discriminant $D$ is negative:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & ={1}^{2}-4(1)(1) \\\\  & =1-4 \\\\  & =-3.\\end{aligned}\n$$\n\nTherefore, the only vertical asymptote is $x=0.$"} {:db/id #edb/ref 17592186088164 :knowledge-point/_questions [{:db/id #edb/ref 17592186087842 :knowledge-point/id #uuid "60c99086-75e7-5d91-b425-4e1b6f582bcc" :knowledge-point/title "Calculating the Vertical Asymptotes of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d7b6d67e-403e-5532-986e-300f36aad2ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439689} {:answer/id #uuid "91942f1d-606f-5b63-a425-9df4530badcf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439690}] :answer-field/correct {:answer/id #uuid "91942f1d-606f-5b63-a425-9df4530badcf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439690} :answer-field/id #uuid "c3b788bf-cfb8-5ba6-8cc4-ef42c59162fc" :answer-field/key "$x=-2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440202} {:answer-field/choices [{:answer/id #uuid "cda3a068-cf24-5df6-b220-85d36c88acff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :a