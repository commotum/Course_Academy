us there."} {:db/id #edb/ref 17592186069368 :knowledge-point/_questions [{:db/id #edb/ref 17592186068696 :knowledge-point/id #uuid "31eacf5a-75a5-5b38-8c24-4b1598ecf3a7" :knowledge-point/title "Identifying Points of Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a51a1f2c-f375-52fb-9067-97eff6cd09d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439813} {:answer/id #uuid "6cf611cc-ea4f-5090-824b-3c170d6e9e62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439814}] :answer-field/correct {:answer/id #uuid "6cf611cc-ea4f-5090-824b-3c170d6e9e62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439814} :answer-field/id #uuid "24e3ea35-9d6c-5109-a5a9-af9c55c383cd" :answer-field/key "$x=-2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440264} {:answer-field/choices [{:answer/id #uuid "067641c7-a48b-5a16-ba51-bc4a904dbfa6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439815} {:answer/id #uuid "cc0abf2b-381e-5c74-81ac-4267e255b77e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439816}] :answer-field/correct {:answer/id #uuid "cc0abf2b-381e-5c74-81ac-4267e255b77e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439816} :answer-field/id #uuid "d8e444cf-e767-5286-80c4-71c3488d8204" :answer-field/key "$x=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440265} {:answer-field/choices [{:answer/id #uuid "cecbce5c-cd4c-5b71-a471-39c3a6e5fd84" :answer/type {:db/id #edb/ref 1759218604