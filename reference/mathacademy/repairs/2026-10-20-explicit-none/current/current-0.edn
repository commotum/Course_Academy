eckbox} :db/id #edb/ref 17592186440367} {:answer-field/choices [{:answer/id #uuid "1dba7438-ff22-567a-950d-78a7202b6d12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440021} {:answer/id #uuid "b5f5fbbb-0e31-5721-bcc3-006f734ec307" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440022}] :answer-field/correct {:answer/id #uuid "1dba7438-ff22-567a-950d-78a7202b6d12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440021} :answer-field/id #uuid "abb35f96-8e34-5ec5-8483-299f03e8484c" :answer-field/key "$x=8$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440368}] :question/id #uuid "f04c86de-5ed5-52ee-bc8b-1a0c07c06519" :question/math-academy-id "q-9657" :question/problem "Given that the determinant of\n$\\begin{bmatrix}2 & -1 & 3 \\\\ x & 2 & 4 \\\\ -2 & 1 & x + 3\\end{bmatrix}$\nis $8$, find all the possible values of $x$.\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The determinant is $x^{2} + 10 x + 24$. Setting it equal to $8$ gives $\\left\\{-8, -2\\right\\}$."} {:db/id #edb/ref 17592186060454 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "141d3bda-708e-5cd1-a9c3-33813075f0e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438670} {:answer/id #uuid "c97bfd73-22d0-514a-b96a-af8b07567307" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438671}] :answer-field/correct {:answer/id #uuid "c97bfd73-22d0-514a-b96a-af8b07567307" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438671} :answer-field/id #uuid "e441ef7a-f7d8-556c-897f-7d0c7a6b2bc1" :answer-field/key "$det(F)=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439364} {:answer-field/choices [{:answer/id #uuid "aa853019-8cb7-57bb-8d89-07bb087c8654" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438672} {:answer/id #uuid "5e56b566-9992-53f1-aacf-331d0f084061" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438673}] :answer-field/correct {:answer/id #uuid "5e56b566-9992-53f1-aacf-331d0f084061" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438673} :answer-field/id #uuid "e6cc4081-efb3-5cbd-91d9-77bb4d9690f4" :answer-field/key "$F$ is a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439365} {:answer-field/choices [{:answer/id #uuid "1db0c840-997f-55b7-bab1-3572f80549a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438674} {:answer/id #uuid "9da77c68-30c2-574d-8a12-c8183bf926de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438675}] :answer-field/correct {:answer/id #uuid "1db0c840-997f-55b7-bab1-3572f80549a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438674} :answer-field/id #uuid "3e1cd461-5747-5d77-9466-83683a668421" :answer-field/key "$det(F)=-2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439366}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c4279505-241a-54e3-b9b3-ff9b46d09cfd" :question/math-academy-id "q-9838" :question/problem "Which of the following statements are true regarding the matrix $F$ given below?\n\nSelect all that apply.\n\n$$\nF=\\begin{bmatrix}0 & 1 & 2 \\\\ 3 & 4 & 5 \\\\ 6 & 7 & 8\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(F) & =|\\begin{aligned}0 & 1 & 2 \\\\ 3 & 4 & 5 \\\\ 6 & 7 & 8\\end{aligned}| \\\\  & =0|\\begin{aligned}4 & 5 \\\\ 7 & 8\\end{aligned}|-1|\\begin{aligned}3 & 5 \\\\ 6 & 8\\end{aligned}|+2|\\begin{aligned}3 & 4 \\\\ 6 & 7\\end{aligned}| \\\\  & =0-1(24-30)+2(21-24) \\\\  & =0-1\\cdot (-6)+2\\cdot (-3) \\\\  & =6-6 \\\\  & =0\\end{aligned}\n$$\n\nSince $det(F)=0$, the matrix is singular. \n\nTherefore, only statements $det(F)=0$ and “$F$ is a singular matrix” are true."} {:db/id #edb/ref 17592186064503 :knowledge-point/_questions [{:db/id #edb/ref 17592186064312 :knowledge-point/id #uuid "3bd5c660-b216-59b4-b2bb-df83ef864b2a" :knowledge-point/title "Determining Concave Up and Concave Down Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b93bee7b-9d95-5423-8e1c-399dda55a57f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459547} {:answer/id #uuid "3e56b729-6fa4-570f-8237-64e14a77c120" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459548}] :answer-field/correct {:answer/id #uuid "b93bee7b-9d95-5423-8e1c-399dda55a57f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #ed