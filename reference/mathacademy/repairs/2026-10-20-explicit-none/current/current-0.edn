2186460992} {:answer-field/choices [{:answer/id #uuid "6550feb8-f1c5-5b68-9f30-b37be2b5b1ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460253} {:answer/id #uuid "20d9338f-cf53-5a37-be7e-527fce11e249" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460254}] :answer-field/correct {:answer/id #uuid "20d9338f-cf53-5a37-be7e-527fce11e249" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460254} :answer-field/id #uuid "0acab227-c554-5371-86d8-2548c636c47d" :answer-field/key "Integers ($Z$)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460993}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cb3a08e1-046c-5655-8701-2c4bac14eb96" :question/math-academy-id "q-80234" :question/problem "To which of the following sets does the number $-5$ belong?\n\nSelect all that apply." :question/worked-solution "![](images/67/67ef97be4b21a74feaae15f3ff30d5077fc1316874df8de79155316a621e4487.png)\n\nRecall the following:\n\n- $N$ represents the set of **natural numbers**.\n\n- $Z$ represents the set of **integers**.\n\n- $Q$ represents the set of **rational numbers**.\n\n- $R$ represents the set of **real numbers**.\n\n- $C$ represents the set of **complex numbers**\n\nWith that in mind, we note the following:\n\n- The number $-5$ is negative, so it does *not* belong to $N,$ and we can write\n\n$$\n-5\\notin N.\n$$\n\n- However, $-5$ is an integer, so it does belong to $Z,$ and we can write\n\n$$\n-5\\in Z.\n$$\n\n- Every integer is a rational, real, and complex number. Consequently, $-5$ belongs to $Q,R,$ and $C,$ and we can write\n\n$$\n-5\\in Q,\\,-5\\in R,\\,-5\\in C.\n$$\n\nTherefore, the correct answer is \"$Z,Q,R,$ and $C.$\""} {:db/id #edb/ref 17592186055501 :knowledge-point/_questions [{:db/id #edb/ref 17592186054815 :knowledge-point/id #uuid "abc6b3ee-0251-5c9c-9358-bd192c434dd1" :knowledge-point/title "Identifying Elements Belonging to Scripted Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dc5f3c3-7591-5a4e-8d81-f9b0e2824217" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460267} {:answer/id #uuid "1b7e2084-86b5-5fb5-9e29-fd55ea042026" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460268}] :answer-field/correct {:answer/id #uuid "1b7e2084-86b5-5fb5-9e29-fd55ea042026" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460268} :answer-field/id #uuid "281ab689-402c-5507-9083-e00f9082cad2" :answer-field/key "$-\\pi $" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461000} {:answer-field/choices [{:answer/id #uuid "20992914-a534-5852-ae72-84ae2ab91250" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460269} {:answer/id #uuid "22c13841-ddf6-5741-a5b0-b9ca9bc97503" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460270}] :answer-field/correct {:answer/id #uuid "20992914-a534-5852-ae72-84ae2ab91250" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460269} :answer-field/id #uuid "492b5d8a-70f6-56e4-95d0-0b6e4555a596" :answer-field/key "$\\sqrt{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461001} {:answer-field/choices [{:answer/id #uuid "4cc243a8-874d-5137-a76d-4dad798738e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460271} {:answer/id #uuid "504b1bce-e543-5d55-9995-0c3edd1117d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460272}] :answer-field/correct {:answer/id #uuid "504b1bce-e543-5d55-9995-0c3edd1117d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460272} :answer-field/id #uuid "19369fd8-2753-5b39-baef-5050dc7ea8c6" :answer-field/key "$-\\frac{4}{5}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461002} {:answer-field/choices [{:answer/id #uuid "6e770476-f2db-5916-aa43-3b79d277b342" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460273} {:answer/id #uuid "f3415ccd-bcd7-576e-9e22-7076b1cb7814" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460274}] :answer-field/correct {:answer/id #uuid "f3415ccd-bcd7-576e-9e22-7076b1cb7814" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460274} :answer-field/id #uuid "37c4a1b2-25b2-522d-9152-8a556721c75d" :answer-field/key "The number $0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461003}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c2a941ac-46f5-56a9-b5ba-03889446453a" :question/math-academy-id "q-80336" :question/problem "Which of the numbers below belong to  ${R}_{0}^{-}?$\n\nSelect all that apply." :question/worked-solution "Remember that ${R}_{0}^{-}$ is the set of all negative real numbers and $0.$\n\n- $-\\pi $ belongs to ${R}_{0}^{-}.\\,✓$\n\n- $\\sqrt{3}$ is a positive number, so it does *not* belong to ${R}_{0}^{-}.\\,\\times $\n\n- $-\\frac{4}{5}$ belongs to ${R}_{0}^{-}.\\,✓$\n\n- $0$ belongs to ${R}_{0}^{-}.\\,✓$\n\nIn conclusion, the correct answer is $-\\pi $; $-\\frac{4}{5}$; “The number $0$” only."} {:db/id #edb/ref 17592186060020 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc68d302-4e05-53f4-a13b-62357c5a7653" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439477} {:answer/id #uuid "3bd87d1e-fd23-5dab-bc43-900e69f9433c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439478}] :answer-field/correct {:answer/id #uuid "bc68d302-4e05-53f4-a13b-62357c5a7653" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439477} :answer-field/id #uuid "91107b81-23d7-5b15-b57e-bf4ab1565fe8" :answer-field/key "$det(M)=10$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440096} {:answer-field/choices [{:answer/id #uuid "70ca64ce-81b4-5636-ba58-791451017b65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439479} {:answer/id #uuid "e05c2887-d7f6-57d2-a4c2-2f2da18a616f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439480}] :answer-field/correct {:answer/id #uuid "70ca64ce-81b4-5636-ba58-791451017b65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439479} :answer-field/id #uuid "c2548bbb-9529-57ff-80c9-7eb2135baee7" :answer-field/key "$det(M)=-5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440097} {:answer-field/choices [{:answer/id #uuid "b319f9de-b31e-5b7f-b008-19047e4bc681" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439481} {:answer/id #uuid "7743ec0d-8e7c-52c8-b5bf-a2c3ff1639ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439482}] :answer-field/correct {:answer/id #uuid "7743ec0d-8e7c-52c8-b5bf-a2c3ff1639ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439482} :answer-field/id #uuid "d3fd9d3c-6b34-5cd5-b3aa-e7329f24b386" :answer-field/key "$M$ is a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440098}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d0d9bc49-c94e-5174-9068-2abf75c42684" :question/math-academy-id "q-128490" :question/problem "Which of the following statements are true regarding the matrix $M$ given below?\n\nSelect all that apply.\n\n$$\nM=\\begin{bmatrix}\\sqrt{5} & 0 & \\frac{1}{3} \\\\ 0 & 3 & 5 \\\\ -3\\sqrt{5} & 3 & 4\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}\\sqrt{5} & 0 & \\frac{1}{3} \\\\ 0 & 3 & 5 \\\\ -3\\sqrt{5} & 3 & 4\\end{aligned}| \\\\  & =\\sqrt{5}|\\begin{aligned}3 & 5 \\\\ 3 & 4\\end{aligned}|-0|\\begin{aligned}0 & 5 \\\\ -3\\sqrt{5} & 4\\end{aligned}|+\\frac{1}{3}|\\begin{aligned}0 & 3 \\\\ -3\\sqrt{5} & 3\\end{aligned}| \\\\  & =\\sqrt{5}(12-15)-0+\\frac{1}{3}(0+9\\sqrt{5}) \\\\  & =\\sqrt{5}\\cdot (-3)+\\frac{1}{3}\\cdot 9\\sqrt{5} \\\\  & =-3\\sqrt{5}+3\\sqrt{5} \\\\  & =0\\end{aligned}\n$$\n\n \n\nSince $det(M)=0$, the matrix is singular. \n\nTherefore, only statement “$M$ is a singular matrix” is true."} {:db/id #edb/ref 17592186060113 :knowledge-point/_questions [{:db/id #edb/ref 17592186059694 :knowledge-point/id #uuid "93d3501b-96ef-5fbd-9d93-788021156ddb" :knowledge-point/title "Identifying Logically Equivalent Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a475e43-ad2a-52bb-9cb1-206fb318ad0d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477179} {:answer/id #uuid "f2d74735-644d-594f-8464-174d06a3e44b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477180}] :answer-field/correct {:answer/id #uuid "7a475e43-ad2a-52bb-9cb1-206fb318ad0d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477179} :answer-field/id #uuid "f5d89db6-f184-5558-a9c5-3c19881ea373" :answer-field/key "If $10<1,$ then $3\\notin R.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477559} {:answer-field/choices [{:answer/id #uuid "688d8a6f-9d3d-50d3-b045-b63e514e353d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477181} {:answer/id #uuid "894212aa-a160-546a-9f45-4e7ff1c222c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477182}] :answer-field/correct {:answer/id #uuid "894212aa-a160-546a-9f45-4e7ff1c222c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477182} :answer-field/id #uuid "64b277b4-5ed1-52b2-acfa-b00fef0f4068" :answer-field/key "If $3\\notin R,$ then $10<1.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477560} {:answer-field/choices [{:answer/id #uuid "9af1a8b8-d9e6-5807-9fc8-c761158a383a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477183} {:answer/id #uuid "03a88033-d0c2-5192-ac1b-264d0b7c2da6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477184}] :answer-field/correct {:answer/id #uuid "9af1a8b8-d9e6-5807-9fc8-c761158a383a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477183} :answer-field/id #uuid "b8c3534b-c88f-5cd8-a830-dd021584e964" :answer-field/key "If $3\\in R,$ then $10\\ge 1.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477561}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "37ad276a-88ce-596c-9a24-406a32aa6e25" :question/math-academy-id "q-171334" :question/problem "$\\,$ **If** $10\\ge 1,$ **then** $3\\in R.$ \n\nWhich of the following statements are equivalent to the conditional statement above?\n\nCompare the logical forms for arbitrary truth values of the antecedent and consequent.\n\nSelect all that apply." :question/worked-solution "Let's recall the following facts:\n\n- The contrapositive is logically equivalent to the original statement.\n\n- The inverse and the converse are logically equivalent to each other, but not to the original statement.\n\n![](images/d9/d946d2a81d46cbde934ebbab54f9b69b514092e02da4f8a3b79768f218929449.png)\n\nSo, we are looking for the contrapositive of the given statement.\n\n- Statement “If $10<1,$ then $3\\notin R.$” is the inverse, not the contrapositive. $\\,\\times $\n\n- Statement “If $3\\notin R,$ then $10<1.$” is the contrapositive. $\\,✓$\n\n- Statement “If $3\\in R,$ then $10\\ge 1.$” is the converse, not the contrapositive. $\\,\\times $\n\nTherefore, the correct answer is “If $3\\notin R,$ then $10<1.$” only."} {:db/id #edb/ref 17592186060143 :knowledge-point/_questions [{:db/id #edb/ref 17592186059689 :knowledge-point/id #uuid "0d56b033-a2c8-57c7-adde-e574d726ec78" :knowledge-point/title "Rewriting Symbolic Conditional Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b2bb64d-c43d-5ec6-934e-e53eedd3cbdc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459705} {:answer/id #uuid "07fdfcee-63eb-5dc7-a357-64cb51c29abd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459706}] :answer-field/correct {:answer/id #uuid "07fdfcee-63eb-5dc7-a357-64cb51c29abd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459706} :answer-field/id #uuid "d9f911be-0b6c-5c4f-89de-532889e92395" :answer-field/key "$P⇒Q≡¬P∨Q$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460719} {:answer-field/choices [{:answer/id #uuid "872a53b7-39d7-542b-83fc-7a7d9f2d3d82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459707} {:answer/id #uuid "586967bd-21bb-5beb-9fc4-854b7d8831c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459708}] :answer-field/correct {:answer/id #uuid "586967bd-21bb-5beb-9fc4-854b7d8831c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459708} :answer-field/id #uuid "0ef6c49d-d45b-5a59-a2ea-1ea63ddfe9c2" :answer-field/key "$¬(P⇒Q)≡P∧¬Q$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460720} {:answer-field/choices [{:answer/id #uuid "37ba7205-2106-5ef0-9ed6-ab1f3f726736" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459709} {:answer/id #uuid "6aa92fc9-03e6-57dc-9911-40ad3d1d7c33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459710}] :answer-field/correct {:answer/id #uuid "37ba7205-2106-5ef0-9ed6-ab1f3f726736" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459709} :answer-field/id #uuid "222d5208-0c8d-53a7-9d1a-051fc3b939a2" :answer-field/key "$¬(P⇒Q)≡P∨¬Q$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460721}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "866aa1bc-982d-58ab-8e07-dd5148fa5235" :question/math-academy-id "q-182470" :question/problem "Which of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Let's examine each of our statements:\n\n- Statement $P⇒Q≡¬P∨Q$ is true. Indeed, $P⇒Q$ is logically equivalent to the disjunction $¬P∨Q.$\n\n- Statement $¬(P⇒Q)≡P∧¬Q$ is true, while statement $¬(P⇒Q)≡P∨¬Q$ is false. From part $P⇒Q≡¬P∨Q$, we have the following equivalence:\n\n$$\nP⇒Q≡¬P∨Q\n$$\n\nBy negating this statement, we get\n\n$$\n¬(P⇒Q)≡¬(¬P∨Q).\n$$\n\nDistributing the negation over the disjunction using De Morgan's law, we have\n\n$$\n¬(¬P∨Q)≡¬(¬P)∧¬Q.\n$$\n\nCanceling out double negation, we reach\n\n$$\nP∧¬Q.\n$$\n\nSo, $¬(P⇒Q)$ is equivalent to $P∧¬Q.$\n\nTherefore, the correct answer is $P⇒Q≡¬P∨Q$; $¬(P⇒Q)≡P∧¬Q$ only."} {:db/id #edb/ref 17592186060220 :knowledge-point/_questions [{:db/id #edb/ref 17592186059684 :knowledge-point/id #uuid "2d65819f-0528-527e-8d1a-20421e221ca5" :knowledge-point/title "Finding Coterminal Angles in Radians"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d12f60a-1b4b-5ad9-8170-fad04c575573" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459743} {:answer/id #uuid "97f66db8-2896-5bf4-9c6a-c7155f7aac88" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459744}] :answer-field/correct {:answer/id #uuid "97f66db8-2896-5bf4-9c6a-c7155f7aac88" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459744} :answer-field/id #uuid "964ed19f-e4e4-56df-85c8-9a070f5bba74" :answer-field/key "$\\frac{4\\pi }{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460738} {:answer-field/choices [{:answer/id #uuid "b2047179-53d8-50a5-845b-dfed41f6bdb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459745} {:answer/id #uuid "bd7b3e3f-7bd9-5a09-b737-93ecdd282f7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459746}] :answer-field/correct {:answer/id #uuid "bd7b3e3f-7bd9-5a09-b737-93ecdd282f7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459746} :answer-field/id #uuid "7aca4bf5-1448-51b9-959a-aea79faa2142" :answer-field/key "$\\frac{10\\pi }{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460739} {:answer-field/choices [{:answer/id #uuid "a7a74c92-738c-5c1d-b1e6-ec2b894aaa51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459747} {:answer/id #uuid "26827bfb-0b07-5aca-b80e-e8fa2dbc4d4f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459748}] :answer-field/correct {:answer/id #uuid "26827bfb-0b07-5aca-b80e-e8fa2dbc4d4f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459748} :answer-field/id #uuid "073e06f8-9a08-555f-888d-a160ccd25418" :answer-field/key "$-\\frac{8\\pi }{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460740}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f7636651-ac27-54dd-bac3-a58cbd0f8a37" :question/math-academy-id "q-23191" :question/problem "Which of the following angles are coterminal with $\\theta =-\\frac{2\\pi }{3}?$\n\nSelect all that apply." :question/worked-solution "To find the coterminal angles of a given angle $\\theta $, we add and subtract integer multiples of $2\\pi :$\n\nLet's start by adding multiples of $2\\pi $ to $-\\frac{2\\pi }{3}$:\n\n- $-\\frac{2\\pi }{3}+2\\pi =\\frac{4\\pi }{3}\\,✓$\n\n- $-\\frac{2\\pi }{3}+2\\cdot (2\\pi )=\\frac{10\\pi }{3}\\,✓$\n\nOf the given values, there is no angle greater than $\\frac{10\\pi }{3}.$ So, we can stop there.\n\nNow, let's subtract multiples of $2\\pi $ from $-\\frac{2\\pi }{3}$:\n\n- $-\\frac{2\\pi }{3}-2\\pi =-\\frac{8\\pi }{3}\\,✓$\n\n- $-\\frac{2\\pi }{3}-2\\cdot (2\\pi )=-\\frac{14\\pi }{3}$\n\nOf the given angles, all three are coterminal with $-\\frac{2\\pi }{3}.$\n\nSo the correct answer is $\\frac{4\\pi }{3}$, $\\frac{10\\pi }{3}$, and $-\\frac{8\\pi }{3}$."} {:db/id #edb/ref 17592186060446 :knowledge-point/_questions [{:db/id #edb/ref 17592186059849 :knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb" :knowledge-point/title "Solving for an Unknown Given the Determinant"}] :question/answer-fields [{:answer-field/