ef 17592186459893} {:answer/id #uuid "90dba915-8387-53ae-a5e9-ad052992e0b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459894}] :answer-field/correct {:answer/id #uuid "2d9e21d8-4ce8-5051-87c0-59cbcaa4b780" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459893} :answer-field/id #uuid "0f014c32-c82b-5d46-995e-3b33708a4ea4" :answer-field/key "${{-1},{1,3,6}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460813}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8e8eb5c8-f406-5cdf-99fb-6d6cbbcd6c06" :question/math-academy-id "q-37255" :question/problem "Which of the following sets is a subset of $A={{1},{2,3},{1,3,6}}?$\n\nSelect all that apply." :question/worked-solution "A set is a subset of $A$ if all its elements are elements of $A.$ \n\nWith that in mind, let's inspect each option.\n\n- ${2,{1}}$ is *not* a subset of $A$ because it contains the element $2\\notin A.\\,\\times $\n\n- ${{2,3}}$ is a subset of $A.\\,✓$\n\n- ${{-1},{1,3,6}}$ is *not* a subset of $A$ because it contains the element ${-1}\\notin A.\\,\\times $\n\nTherefore, the correct answer is ${{2,3}}$ only."} {:db/id #edb/ref 17592186055244 :knowledge-point/_questions [{:db/id #edb/ref 17592186054815 :knowledge-point/id #uuid "abc6b3ee-0251-5c9c-9358-bd192c434dd1" :knowledge-point/title "Identifying Elements Belonging to Scripted Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c487d8dd-b6ce-5e09-b3b2-fdb6045020b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459895} {:answer/id #uuid "41bfc202-c20a-5741-88a6-acc871e2ee1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :d