/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460707} {:answer-field/choices [{:answer/id #uuid "8e64b691-f599-5ad1-8f86-36f0d56190ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459683} {:answer/id #uuid "f97968ed-96ae-5c5b-81f3-7c37c47bc453" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459684}] :answer-field/correct {:answer/id #uuid "8e64b691-f599-5ad1-8f86-36f0d56190ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459683} :answer-field/id #uuid "def1656c-545d-5cfa-a67e-9b8e056e29f2" :answer-field/key "Real numbers ($R$)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460708} {:answer-field/choices [{:answer/id #uuid "2722381f-88ef-56ef-a90e-bfc76e1d1ba4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459685} {:answer/id #uuid "07815c18-f8cd-571f-9d19-35dea685dd79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459686}] :answer-field/correct {:answer/id #uuid "2722381f-88ef-56ef-a90e-bfc76e1d1ba4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459685} :answer-field/id #uuid "8af4482e-9012-5e8b-8245-fe732b4fca3e" :answer-field/key "Integers ($Z$)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460709}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d88d3c9d-ec93-5bf2-a49b-0b326607c0ea" :question/math-academy-id "q-181441" :question/problem "To which of the following sets does the number $\\sqrt{-1}$ belong?\n\nSelect all that apply." :question/worked-solution "![](images/67/67ef97be4b21a74feaae15f3ff30d5077fc1316874df8de79155316a621e4487.png)\n\nRecall the following:\n\n- $N$ represents the set of **natural numbers**.\n\n- $Z$ represents the set of **integers**.\n\n- $Q$ represents the set of **rational numbers**.\n\n- $R$ represents the set of **real numbers**.\n\n- $C$ represents the set of **complex numbers**\n\nWith that in mind, we note the following:\n\n- First, we note that $\\sqrt{-1}=\\text{i}$ is a complex number. Therefore, we can write\n\n$$\n\\sqrt{-1}\\in C.\n$$\n\n- Since the imaginary part of $\\sqrt{-1}$ is nonzero, it does not belong to $N,Z,Q,$ or $R.$ We can write\n\n$$\n\\sqrt{-1}\\notin N,\\,\\sqrt{-1}\\notin Z,\\,\\sqrt{-1}\\notin Q,\\,\\sqrt{-1}\\notin R.\n$$\n\nTherefore, the correct answer is \"$C$ only.\""} {:db/id #edb/ref 17592186055125 :knowledge-point/_questions [{:db/id #edb/ref 17592186054676 :knowledge-point/id #uuid "3123f8ed-a1ca-52b7-8427-2f3b60d9e68a" :knowledge-point/title "Identifying Points That Lie on a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fed705f-0c5e-5dca-accb-bae607a4fc2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439597} {:answer/id #uuid "cb421742-e5de-572c-971a-9eb2c061f005" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439598}] :answer-field/correct {:answer/id #uuid "6fed705f-0c5e-5dca-accb-bae607a4fc2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439597} :answer-field/id #uuid "fbd232fa-3537-5420-94e8-e9051a01e549" :answer-field/key "Point $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440156} {:answer-field/choices [{:answer/id #uuid "e3573bc9-ee80-5f0a-9aae-2aaa34b57dad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439599} {:answer/id #uuid "6e511485-221a-58b3-bdab-2e385d1b8a79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439600}] :answer-field/correct {:answer/id #uuid "6e511485-221a-58b3-bdab-2e385d1b8a79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439600} :answer-field/id #uuid "d2f3d462-8064-56af-8c8f-38267e2f50f9" :answer-field/key "Point $B$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440157} {:answer-field/choices [{:answer/id #uuid "0a6c0980-d69d-5ad0-a62a-b3c07b27657d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439601} {:answer/id #uuid "20e7210d-dcfb-5af3-b90e-81838dff307b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439602}] :answer-field/correct {:answer/id #uuid "0a6c0980-d69d-5ad0-a62a-b3c07b27657d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439601} :answer-field/id #uuid "ea9cb7b2-31c2-5b00-8722-10352ebddb97" :answer-field/key "Point $C$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440158}] :question/id #uuid "591488e6-be15-5117-89a8-9b785af2738a" :question/math-academy-id "q-22405" :question/problem "![](images/c6/c63af2b4cd9209077baee74e5f4f4059bc1c8c7e4b2cdc620c872d025fe5a4e9.png)\n\nIdentify the points that lie on the line $y = x + 1$.\n\nSelect all that apply." :question/worked-solution "The plotted points are A=(2,7), B=(4,5), C=(7,2). Only B satisfies y=x+1."} {:db/id #edb/ref 17592186055242 :knowledge-point/_questions [{:d