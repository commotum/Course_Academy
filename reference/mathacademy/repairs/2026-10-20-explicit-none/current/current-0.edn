[{:db/id #edb/ref 17592186054945 :knowledge-point/_questions [{:db/id #edb/ref 17592186054640 :knowledge-point/id #uuid "d4954fe5-f1fe-590a-9540-280a14606a49" :knowledge-point/title "Identifying True Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f8dc0ba-5afa-54c5-aa13-783f54aabfec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477091} {:answer/id #uuid "d04047e6-1fa2-5625-851f-440e4810fe1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477092}] :answer-field/correct {:answer/id #uuid "4f8dc0ba-5afa-54c5-aa13-783f54aabfec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477091} :answer-field/id #uuid "afa1cd23-1393-557d-a62f-09a7a334d161" :answer-field/key "$P(N)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477515} {:answer-field/choices [{:answer/id #uuid "4835b9e7-659b-5e3f-a2a1-7313a8d91150" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477093} {:answer/id #uuid "bcb0234f-45fc-52a6-9e8c-03ec29f5e7d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477094}] :answer-field/correct {:answer/id #uuid "bcb0234f-45fc-52a6-9e8c-03ec29f5e7d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477094} :answer-field/id #uuid "e7643079-086d-5caf-afac-7c9933490b12" :answer-field/key "$P({Z,\\pi })$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477516} {:answer-field/choices [{:answer/id #uuid "2bc70e62-83ca-519e-a20a-002ad9b918fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477095} {:answer/id #uuid "eea57345-5cbd-5b3d-9f42-3b502e293b45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477096}] :answer-field/correct {:answer/id #uuid "eea57345-5cbd-5b3d-9f42-3b502e293b45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477096} :answer-field/id #uuid "b988546f-0744-5c59-bd81-19d25bc1359a" :answer-field/key "$P({x\\in Z∣\\operatorname{sin}⁡x=0})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477517}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "097f179d-8b94-55d4-8f36-ac53f5125474" :question/math-academy-id "q-104930" :question/problem "Which of the following sets are finite?\n\nSelect all that apply." :question/worked-solution "The power set of a finite set is finite, while the power set of an infinite set is infinite.\n\nWith that in mind, let's examine our sets.\n\n- Set $P(N)$ is infinite since the underlying set $N$ is infinite.\n\n- Set $P({Z,\\pi })$ is finite since the underlying set is finite. Notice that \n\n$$\nP({Z,\\pi })={∅,\\,{Z},\\,{\\pi },\\,{Z,\\pi }}\n$$\n\nhas cardinality $4.$\n\n- Set $P({x\\in Z∣\\operatorname{sin}⁡x=0})$ is finite since the underlying set is finite. Notice that \n\n$$\n{x\\in Z∣\\operatorname{sin}⁡x=0}={0},\n$$\n\nand, as a result, \n\n$$\nP({x\\in Z∣\\operatorname{sin}⁡x=0})=P({0})={∅,\\,{0}}\n$$\n\nhas cardinality $2.$\n\nTherefore, the correct answer is $P({Z,\\pi })$; $P({x\\in Z∣\\operatorname{sin}⁡x=0})$ only."} {:db/id #edb/ref 17592186054987 :knowledge-point/_questions [{:db/id #edb/ref 17592186054632 :knowledge-point/id #uuid "495f3da0-849a-589d-ac88-26d6825445e4" :knowledge-point/title "Identifying True Statements About Subsets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c0b34f4-8c03-5cdf-8c7e-007fbb385b77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448096} {:answer/id #uuid "3583bc47-c330-5d2a-88c2-288145045690" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448097}] :answer-field/correct {:answer/id #uuid "3583bc47-c330-5d2a-88c2-288145045690" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448097} :answer-field/id #uuid "2ee42177-5562-5556-b594-c6ef46dac0b8" :answer-field/key "$∅⊆B$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449088} {:answer-field/choices [{:answer/id #uuid "29e187e8-0177-5316-bdbd-f7a3377f7a97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448098} {:answer/id #uuid "2f05486d-894e-50ba-a91f-6ff8048bd396" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448099}] :answer-field/correct {:answer/id #uuid "2f05486d-894e-50ba-a91f-6ff8048bd396" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448099} :answer-field/id #uuid "70875ce1-999f-5c7d-8f4e-e8661676eefe" :answer-field/key "$B⊆A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449089} {:answer-field/choices [{:answer/id #uuid "1a5c12ab-d43e-5d89-8cb8-c5c64bb9cdae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448100} {:answer/id #uuid "5c5d4715-ec3b-572f-b0c2-8ac38dcf1cb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448101}] :answer-field/correct {:answer/id #uuid "5c5d4715-ec3b-572f-b0c2-8ac38dcf1cb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448101} :answer-field/id #uuid "dbb13885-54bd-53f5-8a35-8787aff08127" :answer-field/key "$A⊈B$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449090}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0906e8f1-346b-507f-9289-d9fb6006311a" :question/math-academy-id "q-1210" :question/problem "Which of the following statements are true for the sets $A={x\\in Z:-2\\le x<6}$ and $B={x\\in N:x+1<6}?$\n\nSelect all that apply." :question/worked-solution "First, we must find the elements of the sets $A$ and $B.$\n\n- The elements of the set $A$ are all integer numbers greater than or equal to $-2$ but less than $6.$ So,\n\n$$\nA={-2,-1,0,1,2,3,4,5}.\n$$\n\n- On the other hand, the elements of the set $B$ are natural numbers that satisfy the inequality $x+1<6.$ So,\n\n$$\nB={1,2,3,4}.\n$$\n\nNow, let's inspect the given statements.\n\n- $∅⊆B$ is true. The null set $∅={}$ is a subset of *every* set.\n\n- $B⊆A$ is true. Every element in the set $B$ is an element of the set $A.$\n\n- $A⊈B$ is true. For example, $-1\\in A$ but $-1\\notin B.$\n\nTherefore, the correct answer is $∅⊆B$; $B⊆A$; $A⊈B$."} {:db/id #edb/ref 17592186054993 :knowledge-point/_questions [{:db/id #edb/ref 17592186054634 :knowledge-point/id #uuid "a6128eca-7f76-5386-9d67-d81db2943eeb" :knowledge-point/title "Computing a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ffc0d5c-6287-5294-a4d6-0735f9210ac9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448206} {:answer/id #uuid "a589446e-850d-5437-b238-7a046c4a5151" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448207}] :answer-field/correct {:answer/id #uuid "4ffc0d5c-6287-5294-a4d6-0735f9210ac9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448206} :answer-field/id #uuid "2c1982fd-3baa-56b9-9b2d-379fc5708da9" :answer-field/key "$(2,4)\\in C$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449143} {:answer-field/choices [{:answer/id #uuid "2537c196-8517-5cd1-96f1-cd7a7cc8f947" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448208} {:answer/id #uuid "5f6e6b4f-5b12-5494-b05a-99b9236da75c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448209}] :answer-field/correct {:answer/id #uuid "5f6e6b4f-5b12-5494-b05a-99b9236da75c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448209} :answer-field/id #uuid "90c93af5-045e-5c06-b4ca-b39cf9948c5b" :answer-field/key "$(2,x)\\in C$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449144} {:answer-field/choices [{:answer/id #uuid "23a9a9a3-d42f-5973-999a-fc6c9d2d6a5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448210} {:answer/id #uuid "3c20d445-4e75-5000-88ca-08a1b3e07ec6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448211}] :answer-field/correct {:answer/id #uuid "23a9a9a3-d42f-5973-999a-fc6c9d2d6a5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448210} :answer-field/id #uuid "5363bed8-79db-502d-b778-4a35dd55e7af" :answer-field/key "$(3,y)\\in C$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449145}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c012134a-99e0-5f06-b534-c2d2ae072768" :question/math-academy-id "q-1257" :question/problem "For the sets $A={2,4,6},$ $B={x,y},$ and $C=A\\times B,$ determine which of the following statements are true.\n\nSelect all that apply." :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nIn this case, the schematic for $A\\times B$ is shown below.\n\n![](images/df/df4277feac4c4e838538f941aa0a07d087beb9005d8f7a8347dadc1da7fe975e.png)\n\nHence, the set $C=A\\times B$ is given by\n\n$$\nC={(2,x),(2,y),(4,x),(4,y),(6,x),(6,y)}.\n$$\n\nTherefore, the correct answer is $(2,x)\\in C$ only."} {:db/id #edb/ref 17592186054995 :knowledge-point/_questions [{:db/id #edb/ref 17592186054634 :knowledge-point/id #uuid "a6128eca-7f76-5386-9d67-d81db2943eeb" :knowledge-point/title "Computing a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6334aa02-bea5-50f7-9bb5-f53cbc987c3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448254} {:answer/id #uuid "ff232262-b5ef-57dc-9df5-a7ae100b4c49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448255}] :answer-field/correct {:answer/id #uuid "6334aa02-bea5-50f7-9bb5-f53cbc987c3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448254} :answer-field/id #uuid "d1d35377-385a-58a7-8010-74941a9ec6a8" :answer-field/key "$(-1,0,1)\\in Y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449167} {:answer-field/choices [{:answer/id #uuid "56da5777-abc5-5ae3-96c3-73a1fd1b8435" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448256} {:answer/id #uuid "64628f24-e2a2-52ad-b0f7-291433735b9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448257}] :answer-field/correct {:answer/id #uuid "64628f24-e2a2-52ad-b0f7-291433735b9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448257} :answer-field/id #uuid "8779c310-b0fc-53b3-aaf3-941717ca6e85" :answer-field/key "$(-1,1)\\in Y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449168} {:answer-field/choices [{:answer/id #uuid "68355653-6e31-55b6-b54a-a5f978d2a02f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448258} {:answer/id #uuid "d908a7c6-9c36-5692-950c-4148de454d58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448259}] :answer-field/correct {:answer/id #uuid "d908a7c6-9c36-5692-950c-4148de454d58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448259} :answer-field/id #uuid "f02f5eb4-eec0-5ca2-bad3-a4f310f6ba8f" :answer-field/key "$(0,0)\\in Y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449169}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1ff208f5-5023-5db1-8017-ca1f7ce1c080" :question/math-academy-id "q-1262" :question/problem "For the sets $Z=\\{-1,0,1\\}$ and $Y=Z\\times Z,$ determine which of the following statements are true.\n\nSelect all that apply." :question/worked-solution "The Cartesian product $Z\\times Z$ consists of all ordered pairs whose first coordinate belongs to $Z$ and whose second coordinate belongs to $Z.$\n\nIn this case, the schematic for ${Z}^{2}=Z\\times Z$ is shown below.\n\n![](images/6c/6cb962e74701db361807c237a521f13a1c753e4acc6d68a1cfb1694bdfbd45bc.png)\n\nHence, the set $Y=Z\\times Z$ is given by\n\n$$\nY={(-1,-1),(-1,0),(-1,1),(0,-1),(0,0),(0,1),(1,-1),(1,0),(1,1)}.\n$$\n\nTherefore, the correct answer is $(-1,1)\\in Y$; $(0,0)\\in Y$ only."} {:db/id #edb/ref 17592186055034 :knowledge-point/_questions [{:db/id #edb/ref 17592186054819 :knowledge-point/id #uuid "4eda1965-d655-5550-9bb5-13e7a9c1b406" :knowledge-point/title "Identifying Statements Expressed Using Symbols"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ea52b5b-53d4-55c2-89b1-9d54b1ec21e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459605} {:answer/id #uuid "15f9454f-19a7-5e3c-990f-fb5fededeb09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459606}] :answer-field/correct {:answer/id #uuid "15f9454f-19a7-5e3c-990f-fb5fededeb09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459606} :answer-field/id #uuid "75d39554-3208-59d5-ace8-93db5f100923" :answer-field/key "$P:2\\,|\\,4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460669} {:answer-field/choices [{:answer/id #uuid "ce7f2c05-9626-5bff-aefd-bd7d639ca64b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459607} {:answer/id #uuid "a10db421-76d1-5d7f-bc5d-199a045ead40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459608}] :answer-field/correct {:answer/id #uuid "a10db421-76d1-5d7f-bc5d-199a045ead40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459608} :answer-field/id #uuid "deb0f312-aea4-56b0-ab30-d37994523624" :answer-field/key "$Q:\\sqrt{2}\\in N$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460670} {:answer-field/choices [{:answer/id #uuid "2b121cc6-4064-5e54-b4b5-a5fb73fe51da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459609} {:answer/id #uuid "ea7d092a-ccde-5488-a59f-1d6fae10c09f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459610}] :answer-field/correct {:answer/id #uuid "2b121cc6-4064-5e54-b4b5-a5fb73fe51da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459609} :answer-field/id #uuid "7ce85bf2-82e5-5def-a35f-745b71d2cb59" :answer-field/key "$R:2+2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460671}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8a13c06f-6317-5f54-a60c-2244cd05e4c4" :question/math-academy-id "q-170843" :question/problem "Which of the following are mathematical statements?\n\nSelect all that apply." :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false.\n\nWith that in mind, let's examine the given options:\n\n- $P$ is a statement. This statement is *true* because $2$ divides $4.$\n\n- $Q$ is a statement. This statement is *false* because $\\sqrt{2}$ is not a natural number.\n\n- $R$ is *not* a statement because it is neither true nor false.\n\nTherefore, the correct answer is \"$P$ and $Q$ only.\""} {:db/id #edb/ref 17592186055035 :knowledge-point/_questions [{:db/id #edb/ref 17592186054819 :knowledge-point/id #uuid "4eda1965-d655-5550-9bb5-13e7a9c1b406" :knowledge-point/title "Identifying Statements Expressed Using Symbols"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "552218e3-b220-58c3-8c75-5b10d4776417" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459611} {:answer/id #uuid "4d32738d-a847-5c0a-850c-c2e3237e0d00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459612}] :answer-field/correct {:answer/id #uuid "4d32738d-a847-5c0a-850c-c2e3237e0d00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459612} :answer-field/id #uuid "4d2462b7-7be9-5abc-a127-8af98e06b645" :answer-field/key "$P:{1,2,3}\\cap {4,5,6}=∅$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460672} {:answer-field/choices [{:answer/id #uuid "fae08b24-3812-566d-a245-f6474c9a3322" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459613} {:answer/id #uuid "482bfa69-3833-5877-bdef-dafffe6afc91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459614}] :answer-field/correct {:answer/id #uuid "fae08b24-3812-566d-a245-f6474c9a3322" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459613} :answer-field/id #uuid "c69e7140-e437-5755-afc5-5352fa630839" :answer-field/key "$Q:\\sqrt{{3}^{2}-{4}^{2}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460673} {:answer-field/choices [{:answer/id #uuid "7f08c0a3-4f80-5f1e-b303-085ac5323d54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459615} {:answer/id #uuid "9389cb89-27b3-5801-910f-21c17f7e7b45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459616}] :answer-field/correct {:answer/id #uuid "9389cb89-27b3-5801-910f-21c17f7e7b45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459616} :answer-field/id #uuid "9724f003-06ea-5591-8da2-04eeaa531ee3" :answer-field/key "$R:4$ is a prime number." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460674}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d26247f5-ea0b-58f7-ab8c-9e2873f56e29" :question/math-academy-id "q-170844" :question/problem "Which of the following are mathematical statements?\n\nSelect all that apply." :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false.\n\nWith that in mind, let's examine the given options:\n\n- $P$ is a statement. This statement is *true* because the intersection of the given sets is empty.\n\n- $Q$ is *not* a statement because it is neither true nor false.\n\n- $R$ is a statement. This statement is *false* since $4$ is not prime.\n\nTherefore, the correct answer is \"$P$ and $R$ only.\""} {:db/id #edb/ref 17592186055044 :knowledge-point/_questions [{:db/id #edb/ref 17592186054820 :knowledge-point/id #uuid "35eba041-5109-5855-b132-174c0271c168" :knowledge-point/title "Identifying Predicates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88ca2b5c-6791-591f-abda-f27884967edc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459617} {:answer/id #uuid "c56bf6b0-66f4-518a-a6ce-ba874d1a9c55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459618}] :answer-field/correct {:answer/id #uuid "c56bf6b0-66f4-518a-a6ce-ba874d1a9c55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459618} :answer-field/id #uuid "24a6ed8a-17b7-51a7-bb49-dcf74e7ade9b" :answer-field/key "$P(n):$ $n$ is even." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460675} {:answer-field/choices [{:answer/id #uuid "04cb5f8b-73b3-5617-abfc-6b43148614ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459619} {:answer/id #uuid "6f8f35e0-edab-543a-a110-589cb05bd8d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459620}] :answer-field/correct {:answer/id #uuid "6f8f35e0-edab-543a-a110-589cb05bd8d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459620} :answer-field/id #uuid "96184caa-a44f-51b9-bafe-5eddcc9cb49b" :answer-field/key "$Q(x):$ ${x}^{2}-x\\ge 1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460676} {:answer-field/choices [{:answer/id #uuid "acb09f9b-41e0-580c-a041-095bbce4770b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459621} {:answer/id #uuid "868a0a7e-8c6e-5345-b4ea-51218d4e274a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459622}] :answer-field/correct {:answer/id #uuid "acb09f9b-41e0-580c-a041-095bbce4770b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459621} :answer-field/id #uuid "42968c23-3a57-5e5b-b613-c57e6362a57d" :answer-field/key "$R(y):$ Draw a line of width $y\\,\\text{cm}.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460677}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c5327827-bdd3-59f2-8ac3-6f2fcb1af21e" :question/math-academy-id "q-171486" :question/problem "Which of the following are mathematical predicates of one variable?\n\nSelect all that apply." :question/worked-solution "A *predicate* of one variable is a sentence that contains the variable defined on some *universal set* and has the property that when we substitute any concrete value of the variable into the predicate, the result becomes a statement that is either true or false.\n\nWith that in mind, let's examine our options. \n\n- Option “$P(n):$ $n$ is even” is a predicate. Substituting a concrete value for $n$ into the sentence, we get a statement that is either true or false.\n\n- Option “$Q(x):$ ${x}^{2}-x\\ge 1$” is a predicate. Substituting a concrete value for $x$ into the sentence, we get a statement that is either true or false.\n\n- Option “$R(y):$ Draw a line of width $y\\,\\text{cm}.$” is *not* a predicate. Substituting a concrete value for $y$ into the sentence, we do not get a statement that is either true or false. Rather, it will give an instruction.\n\nTherefore, the correct answer is “$P(n):$ $n$ is even”; “$Q(x):$ ${x}^{2}-x\\ge 1$” only."} {:db/id #edb/ref 17592186055071 :knowledge-point/_questions [{:db/id #edb/ref 17592186054636 :knowledge-point/id #uuid "3fca5176-1359-5ad8-b012-592ffa9b20b5" :knowledge-point/title "Cartesian Products With Three Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f1de0a5-72af-5067-ac6a-f1db1793d9bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459665} {:answer/id #uuid "4042b04c-c83e-506d-aaee-db575f15ae1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459666}] :answer-field/correct {:answer/id #uuid "4f1de0a5-72af-5067-ac6a-f1db1793d9bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459665} :answer-field/id #uuid "7edf7cbb-6689-5715-877d-fe1220e7c9c8" :answer-field/key "$(1,y,2)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460699} {:answer-field/choices [{:answer/id #uuid "dc25a2ca-8725-573a-8fb6-a0f677d677a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459667} {:answer/id #uuid "80e2bd40-7cd5-5b6d-ae6c-0db9109c48e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459668}] :answer-field/correct {:answer/id #uuid "80e2bd40-7cd5-5b6d-ae6c-0db9109c48e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459668} :answer-field/id #uuid "84bf1ea9-21f9-5b78-83e6-32eeb73acd61" :answer-field/key "$((1,y),2)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460700} {:answer-field/choices [{:answer/id #uuid "8a11266d-86a1-5fe9-ab8b-9e576674a081" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459669} {:answer/id #uuid "2b9c94fc-bb95-591e-8055-4c0c344d9261" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459670}] :answer-field/correct {:answer/id #uuid "8a11266d-86a1-5fe9-ab8b-9e576674a081" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459669} :answer-field/id #uuid "3eac2805-d927-5131-a557-7a329c3675c8" :answer-field/key "$((y,1),y)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460701}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "59457bab-d41c-5c4d-af91-59c9dc67dad9" :question/math-academy-id "q-181294" :question/problem "If $A=\\{0,1,2\\}$ and $B=\\{x,y\\},$ which of the following elements belong to $(A\\times B)\\times A?$\n\nSelect all that apply." :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nIn this case, $A\\times B$ consists of every combination of ${0,1,2}$ with ${x,y},$ as shown in the schematic below.\n\n![](images/07/077da578323a686ecf0e07cf0a56030fa4ce128a74d408af95b8a3027ad13f28.png)\n\nHence, the set $A\\times B$ is given by\n\n$$\nA\\times B={(0,x),(0,y),(1,x),(1,y),(2,x),(2,y)}.\n$$\n\nNote that \n\n$$\n|A\\times B|=|A|\\cdot |B|=3\\cdot 2=6.\n$$\n\nNow, the Cartesian product\n\n$$\n(A\\times B)\\times A\n$$\n\nconsists of every combination of $A\\times B$ and $A,$ as shown in the schematic below.\n\n![](images/3a/3a14abffc755dcfccce2d410ea18fbcae42d4afe2fbeffd81e1a291bc9d4968e.png)\n\nNote that \n\n$$\n|(A\\times B)\\times A|=|A\\times B|\\cdot |A|=6\\cdot 3=18.\n$$\n\nFrom the given options, we see that only $((1,y),2)\\in (A\\times B)\\times A.$\n\nTherefore, the correct answer is $((1,y),2)$ only."} {:db/id #edb/ref 17592186055072 :knowledge-point/_questions [{:db/id #edb/ref 17592186054636 :knowledge-point/id #uuid "3fca5176-1359-5ad8-b012-592ffa9b20b5" :knowledge-point/title "Cartesian Products With Three Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62c177a9-2328-5eaf-88c0-9a311b033aee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459671} {:answer/id #uuid "1b79aa1f-fa03-518a-a250-98c638dfe2ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459672}] :answer-field/correct {:answer/id #uuid "1b79aa1f-fa03-518a-a250-98c638dfe2ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459672} :answer-field/id #uuid "e1493459-b197-58a9-b9fb-9a679fa4453c" :answer-field/key "$(v,v,1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460702} {:answer-field/choices [{:answer/id #uuid "27cf742d-cde0-5bca-89d3-88e6f5cd9328" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459673} {:answer/id #uuid "e07584d5-9a5a-5e63-b26d-174104869ec8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459674}] :answer-field/correct {:answer/id #uuid "27cf742d-cde0-5bca-89d3-88e6f5cd9328" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459673} :answer-field/id #uuid "1acc7557-6a66-542a-ad13-95fe4f067922" :answer-field/key "$((v,v),1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460703} {:answer-field/choices [{:answer/id #uuid "3cb4fe9f-9825-5c8c-a713-7c58fb562d70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459675} {:answer/id #uuid "da66c298-9229-5dbd-804e-12b9f7dae222" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459676}] :answer-field/correct {:answer/id #uuid "3cb4fe9f-9825-5c8c-a713-7c58fb562d70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459675} :answer-field/id #uuid "d645d1a2-23c6-572e-800f-b7e8161fca66" :answer-field/key "$(1,v,u)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460704}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9eac2d72-9d93-50cd-8b4e-008064a9d365" :question/math-academy-id "q-181295" :question/problem "If $A=\\{-1,1\\}$ and $B=\\{u,v\\},$ which of the following elements belong to $B\\times B\\times A?$\n\nSelect all that apply." :question/worked-solution "The Cartesian product $A\\times B\\times C$ consists of all ordered triples whose first coordinate belongs to $A,$ second coordinate belongs to $B,$ and third coordinate belongs to $C.$\n\nIn this case, $B\\times B\\times A$ consists of every combination of $\\{u,v\\}$ with $\\{u,v\\}$ and $\\{-1,1\\},$ which results in\n\n$$\n\\begin{aligned}B\\times B\\times A=\\{ & (u,u,-1),(u,u,1),(u,v,-1),(u,v,1), \\\\  & (v,u,-1),(v,u,1),(v,v,-1),(v,v,1)\\}.\\end{aligned}\n$$\n\nNote that\n\n$$\n|B\\times B\\times A|=|B|\\cdot |B|\\cdot |A|=2\\cdot 2\\cdot 2=8.\n$$\n\nFrom the given options, we see that only $(v,v,1)\\in B\\times B\\times A.$\n\nTherefore, the correct answer is $(v,v,1)$ only."} {:db/id #edb/ref 17592186055073 :knowledge-point/_questions [{:db/id #edb/ref 17592186054814 :knowledge-point/id #uuid "3de9e532-559c-5fc1-a6ad-5fcd1ed77824" :knowledge-point/title "Identifying Special Sets Containing a Given Element"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c0811f1-7a05-584b-adae-e07648c006db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459677} {:answer/id #uuid "0705c7db-541c-5bfd-bea3-ef3bac77b23a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592