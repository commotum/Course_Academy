/id #edb/ref 17592186439785} :answer-field/id #uuid "1c92a063-ce2a-5294-b663-e6a6a68899b6" :answer-field/key "$x=4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440250}] :question/id #uuid "8fc376c7-6855-5bb9-8474-018bf5ce2776" :question/math-academy-id "q-4629" :question/problem "Calculate the vertical asymptotes of $f(x) = \\frac{3x^{2} - 12x}{x^{2} - 2x - 3}$.\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "After cancellation, $f(x)=\\frac{3 x^{2} - 12 x}{x^{2} - 2 x - 3}$. Its real denominator zeros are $\\left\\{-1, 3\\right\\}$; canceled factors produce holes, not vertical asymptotes."} {:db/id #edb/ref 17592186088186 :knowledge-point/_questions [{:db/id #edb/ref 17592186087844 :knowledge-point/id #uuid "b18ace11-d31c-5d5a-bd2e-32e1c28af2b9" :knowledge-point/title "Calculating Vertical Asymptotes When the Denominator Has Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a027328e-083e-5474-8cd1-5f971f4efea3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439787} {:answer/id #uuid "ca48285e-d7da-592e-9562-c0c81bd41bfa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439788}] :answer-field/correct {:answer/id #uuid "a027328e-083e-5474-8cd1-5f971f4efea3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439787} :answer-field/id #uuid "068b4f51-0a87-5567-8856-ae2e21681976" :answer-field/key "$x=-3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440251} {:answer-field/choices [{:answer/id #uuid "874efd90-f999-5b68-9eb9-9afc018f6bec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/