y),\\operatorname{ln}⁡(x+y+1)⟩$ only."} {:db/id #edb/ref 17592186567231 :knowledge-point/_questions [{:db/id #edb/ref 17592186172085 :knowledge-point/id #uuid "019e5a17-1aab-565b-8881-447c86a9a7ec" :knowledge-point/title "Identifying Vector Fields on Two-Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e216b54-3105-5bba-8558-960e7437f115" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186567190} {:answer/id #uuid "79c44a8f-9149-58c3-bc99-49bc40412f79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186567206}] :answer-field/correct {:answer/id #uuid "79c44a8f-9149-58c3-bc99-49bc40412f79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186567206} :answer-field/id #uuid "03913288-f4c8-5caa-b009-cf8b543f4718" :answer-field/key "$C(t)=⟨2-{t}^{2},{e}^{t-1}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186567188} {:answer-field/choices [{:answer/id #uuid "d70cf5a4-bb36-520b-8a7c-e89b04e60e3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186567226} {:answer/id #uuid "d7a02875-02cc-550f-9d11-9ae466df6873" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186567227}] :answer-field/correct {:answer/id #uuid "d70cf5a4-bb36-520b-8a7c-e89b04e60e3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186567226} :answer-field/id #uuid "cf0499ee-048f-5d24-8ef1-b8b998c793c5" :answer-field/key "$B(x,y,z)=⟨-2x,3{y}^{3},{z}^{5}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186567224} {:answer-field/choices [{:answer/