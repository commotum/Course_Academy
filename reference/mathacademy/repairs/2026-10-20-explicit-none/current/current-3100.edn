ct answer is: $-\\frac{2}{8}$; $-62$."} {:db/id #edb/ref 17592186623061 :knowledge-point/_questions [{:db/id #edb/ref 17592186054815 :knowledge-point/id #uuid "abc6b3ee-0251-5c9c-9358-bd192c434dd1" :knowledge-point/title "Identifying Elements Belonging to Scripted Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "361c251c-a435-5ff7-90e2-0026e23cd368" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623029} {:answer/id #uuid "c1151524-2470-5417-92c5-df50c326dc6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623062}] :answer-field/correct {:answer/id #uuid "c1151524-2470-5417-92c5-df50c326dc6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623062} :answer-field/id #uuid "02fce664-0fbb-5cfe-aa75-1dc2cc6af289" :answer-field/key "$\\frac{21}{5}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186623020} {:answer-field/choices [{:answer/id #uuid "481cdc3d-d953-5d02-83f9-a2915b7a8f39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623032} {:answer/id #uuid "dac6b0aa-3c72-5126-8dd3-eb67a64548f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623073}] :answer-field/correct {:answer/id #uuid "dac6b0aa-3c72-5126-8dd3-eb67a64548f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623073} :answer-field/id #uuid "41ee75f1-55b0-5163-83c5-028ac6e7baec" :answer-field/key "$-\\sqrt{34}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186623031} {:answer-field/choices [{:answer/id #uuid "51cc99fa-3c