 :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "14cfa8c3-ee82-5e23-ab77-7cb39b75a31e" :question/problem "To which of the following sets does the number $\\frac{108}{12}$ belong?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "First, we note that $\\frac{108}{12}=9$ is a positive integer.\n\n- The set $\\mathbb{Z}$ contains all integers. Therefore, $\\frac{108}{12}$ belongs to $\\mathbb{Z}$.\n\n- The set $\\mathbb{Q}^{-}$ contains the negative rational numbers. Therefore, $\\frac{108}{12}$ does not belong to $\\mathbb{Q}^{-}$.\n\n- The set $\\mathbb{Z}^{-}$ contains the negative integers. Therefore, $\\frac{108}{12}$ does not belong to $\\mathbb{Z}^{-}$.\n\n- The set $\\mathbb{N}$ contains the positive integers (natural numbers). Therefore, $\\frac{108}{12}$ belongs to $\\mathbb{N}$.\n\nTherefore, select $\\mathbb{Z}$, $\\mathbb{N}$ only."} {:db/id #edb/ref 17592186624694 :knowledge-point/_questions [{:db/id #edb/ref 17592186054816 :knowledge-point/id #uuid "1d132801-b9cc-5c0c-a8fa-0c8b840c05bd" :knowledge-point/title "Identifying Sets Containing a Given Element"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16701814-3c87-5d33-96b7-c66f7a3a326f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186624675} {:answer/id #uuid "f407a203-d8a5-5abc-9ebe-e2f5ee0f67e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186624724}] :answer-field/correct {:answer/id #uuid "16701814-3c87-5d33-96b7-c66f7a3a326f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186624675} :answer-field/id #uuid "1f05b840-9767-5de2-b02a-a6ce1d0871d1" :answer-field/key "$\\mathbb{Z}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbo