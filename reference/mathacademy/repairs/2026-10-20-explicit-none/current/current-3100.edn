414-10cf0c513eb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186619040}] :answer-field/correct {:answer/id #uuid "fe83b20d-dad7-580f-8414-10cf0c513eb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186619040} :answer-field/id #uuid "beee4351-40b3-56f7-95be-e9699ba027e2" :answer-field/key "$A=\\begin{bmatrix}-2 & 0 & 8 & 1 & 5 \\\\ 0 & 0 & 0 & -5 & 4 \\\\ 0 & 0 & 0 & 0 & 5 \\\\ 0 & 0 & 0 & 0 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186619023}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "25e8be0d-86c0-5867-8f40-ff95371b25a6" :question/problem "Which of the following matrices are in row echelon form?\n\nSelect all that apply." :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\nI. All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n\nII. Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is in row echelon form (both conditions are satisfied).\n\n$$\nA=\\begin{bmatrix}-2 & 0 & 8 & 1 & 5 \\\\ 0 & 0 & 0 & -5 & 4 \\\\ 0 & 0 & 0 & 0 & 5 \\\\ 0 & 0 & 0 & 0 & 0\\end{bmatrix}\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\begin{bmatrix}-6 & 4 & 3 \\\\ 0 & -4 & 2 \\\\ 0 & 0 & 7\\end{bmatrix}\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=\\begin{bmatrix}0 & 4 & 9 & -5 \\\\ 0 & 0 & 0 & 6 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\n$$\n\nTherefore, $A,$ $B,$ and $C$ are in row echelon form."} {:db/id #edb/ref 17592186619004 :knowledge-point/_questions [{:db/id #edb/ref 17592186129114 :knowledge-point/id #uuid "2d390841-351e-54f5-ad19-90b6ebae5799" :knowledge-point/title "Identifying Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16e2b952-641c-55a2-9bb5-8002faf8e7b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186618994} {:answer/id #uuid "efe15542-78f1-5f7b-bb9c-492f1e331705" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186619038}] :answer-field/correct {:answer/id #uuid "16e2b952-641c-55a2-9bb5-8002faf8e7b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186618994} :answer-field/id #uuid "6831d026-1ea1-5ceb-92d7-6065f9212c90" :answer-field/key "$C=\\begin{bmatrix}0 & 0 & 1 \\\\ 3 & -4 & 9 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186619005} {:answer-field/choices [{:answer/id #uuid "1cfb0a95-b56f-5652-87e4-c2fd8a814370" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186618995} {:answer/id #uuid "969e8d00-39fc-5fb5-86be-4fd915e6b94c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186619016}] :answer-field/correct {:answer/id #uuid "1cfb0a95-b56f-5652-87e4-c2fd8a814370" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186618995} :answer-field/id #uuid "8a00f017-9bf8-5a30-a570-169a4b58b94c" :answer-field/key "$B=\\begin{bmatrix}-2 & 8 & 5 & 0 & -2 \\\\ 0 & 0 & 0 & -5 & 4 \\\\ 0 & 0 & 0 & 0 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186619011} {:answe