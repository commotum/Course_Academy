86408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186574733}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "75f69126-c110-5545-9efd-4ceeba235a0c" :question/math-academy-id "q-73615" :question/problem "The row echelon form matrix $A$ is given below. What are its **non**-pivot columns?\n\n$$\nA=\\begin{bmatrix}1 & 3 & 5 & 0 \\\\ 0 & 2 & 1 & -2 \\\\ 0 & 0 & 0 & -1\\end{bmatrix}\n$$\n\nSelect all that apply." :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $A$ has $3$ pivots in the $1$st, $2$nd and $4$th columns:\n\n$$\nA=\\begin{bmatrix}1 & 3 & 5 & 0 \\\\ 0 & 2 & 1 & -2 \\\\ 0 & 0 & 0 & -1\\end{bmatrix}\n$$\n\nTherefore, the only non-pivot column is the $3$rd column."} {:db/id #edb/ref 17592186567195 :knowledge-point/_questions [{:db/id #edb/ref 17592186172085 :knowledge-point/id #uuid "019e5a17-1aab-565b-8881-447c86a9a7ec" :knowledge-point/title "Identifying Vector Fields on Two-Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45fd9da9-66ec-5c9f-bf50-20f83d472ce7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186567202} {:answer/id #uuid "8e009c6c-4257-5383-b322-e55e1697a067" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186567212}] :answer-field/correct {:answer/id #uuid "45fd9da9-66ec-5c9f-bf50-20f83d472ce7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186567202} :answer-field/id #uuid "82cce605-16a1-56f8-9a8f-829b891ff8c1" :answer-field/key "$K(x,y,z)=x\\,i-y\\,j+z\\,k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186567208} {:answer-field/choices [{:answer/id #uuid "821058df-1a80-5a00-a961-5996fe240ce8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186567207} {:answer/id #uuid "887f0013-1fcf-5688-879f-588428890bab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186567211}] :answer-field/correct {:answer/id #uuid "821058df-1a80-5a00-a961-5996fe240ce8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186567207} :answer-field/id #uuid "87d3ae4d-127a-57de-812e-17647fbfe164" :answer-field/key "$G(x,y)={x}^{2}\\,i-{y}^{2}\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186567210} {:answer-field/choices [{:answer/id #uuid "9f746bdf-80c7-53e9-958f-322bcb9a61a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186567217} {:answer/id #uuid "c90c1939-4375-5af7-bd4d-c8b99fda5bcb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186567222}] :answer-field/correct {:answer/id #uuid "c90c1939-4375-5af7-bd4d-c8b99fda5bcb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186567222} :answer-field/id #uuid "e0ec2b10-de4d-5b62-bfc2-36a4e5c13d13" :answer-field/key "$H(x,y)=\\operatorname{ln}⁡(y-2)\\,i-{e}^{xy}\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186567230}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e2a1d7f-e53f-5a9c-a708-98dd5132af11" :question/problem "Which of the following are vector fields on ${R}^{2}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{2}.$ A vector field on ${R}^{2}$ is a function $F$ that maps every point $(x,y)$ in $S$ to a vector $F(x,y)\\in {R}^{2}.$\n\nWith that in mind, let's examine each function.\n\n- The function $H(x,y)$ is a vector field on ${R}^{2}.$ It maps every point in the set $S,$ given by\n\n$$\nS=\\{(x,y)\\in {R}^{2}\\,|\\,y>2\\}\n$$\n\nto a vector in ${R}^{2}.$\n\n- The function $K(x,y,z)$ is *not* a vector field on ${R}^{2}.$ It is a vector field on ${R}^{3}.$\n\n- The function $G(x,y)$ is a vector field on ${R}^{2}.$ It maps every point $(x,y)\\in {R}^{2}$ to a vector in ${R}^{2}.$\n\nTherefore, the correct answer is $H(x,y)=\\operatorname{ln}⁡(y-2)\\,i-{e}^{xy}\\,j$; $G(x,y)={x}^{2}\\,i-{y}^{2}\\,j$ only."} {:db/id #edb/ref 17592186567197 :knowledge-point/_questions [{:db/id #edb/ref 17592186172085 :knowledge-point/id #uuid "019e5a17-1aab-565b-8881-447c86a9a7ec" :knowledge-point/title "Identifying Vector Fields on Two-Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aab6b82-5473-54b2-8342-d5b12a067309" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186567189} {:answer/id #uuid "1a0e194e-4e46-543a-b453-b158f7199720" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186567193}] :answer-field/correct {:answer/id #uuid "0aab6b82-5473-54b2-8342-d5b12a067309" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186567189} :answer-field/id #uuid "140553c9-c715-584b-af3a-6b6e155f93da" :answer-field/key "$Q(x,y,z)$ $=y\\,i$ $-xy\\,j$ $+(z+1)\\,k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186567191} {:answer-field/choices [{:answer/id #uuid "5fb25ee9-04ae-575a-9259-57c85282e565" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186567204} {:answer/id #uu