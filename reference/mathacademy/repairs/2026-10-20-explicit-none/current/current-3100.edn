ebee6b8bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623080}] :answer-field/correct {:answer/id #uuid "0b4bc734-7885-570b-aae2-80719f9770e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623022} :answer-field/id #uuid "ef624d5d-b105-532f-998c-8b5f576b4ec1" :answer-field/key "$\\sqrt{49}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186623079}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e1b54ea3-4e56-5a1d-9c6d-39f851a1214f" :question/problem "Which of the numbers below belong to $\\mathbb{Q}_0^{+}$?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Remember that $\\mathbb{Q}_0^{+}$ is the set of all positive rational numbers and zero.\n\n- $-\\sqrt{14}$: It is negative, and it is an irrational real number. Therefore, it does *not* belong to $\\mathbb{Q}_0^{+}$.\n\n- $46$: It is positive, and it is an integer. Therefore, it belongs to $\\mathbb{Q}_0^{+}$.\n\n- $\\frac{\\pi}{2}$: It is positive, and it is an irrational real number. Therefore, it does *not* belong to $\\mathbb{Q}_0^{+}$.\n\n- $\\sqrt{49}=7$: It is positive, and it is an integer. Therefore, it belongs to $\\mathbb{Q}_0^{+}$.\n\nIn conclusion, the correct answer is: $46$; $\\sqrt{49}$."} {:db/id #edb/ref 17592186623787 :knowledge-point/_questions [{:db/id #edb/ref 17592186054802 :knowledge-point/id #uuid "3986a3cd-c543-54e9-8d55-f744d9436313" :knowledge-point/title "Identifying a Line Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9206eb63-fde8-559e-a36f-1d196016d8c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623817} {:answer/id #uuid "d67cdfc2-1e96-5a43-8025-237af0303985" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623826}] :answer-field/correct {:answer/id #uuid "9206eb63-fde8-559e-a36f-1d196016d8c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623817} :answer-field/id #uuid "77002078-fe3e-53ed-b8f2-d8e6466e55f0" :answer-field/key "$y=-x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186623807} {:answer-field/choices [{:answer/id #uuid "f421039f-3b7c-5c05-a031-86a24684b08c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623833} {:answer/id #uuid "ffeba78d-5697-504c-9b68-bc89c0637215" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623836}] :answer-field/correct {:answer/id #uuid "f421039f-3b7c-5c05-a031-86a24684b08c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623833} :answer-field/id #uuid "9c6c3b57-d51a-5e96-8ca1-4f1751ae62bc" :answer-field/key "$y=1-x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186623818} {:answer-field/choices [{:answer/id #uuid "4f11cf38-3a4d-5f8a-98bf-79b2ed9d12f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623798} {:answer/id #uuid "edc63731-f6aa-513c-bbb2-366ffd919559" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623831}] :answer-field/correct {:answer/id #uuid "edc63731-f6aa-513c-bbb2-366ffd919559" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623831} :answer-field/id #uuid "ccf4f046-a5bb-5371-9878-4c006772db05" :answer-field/key "$y+x=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186623823}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0a86401e-af33-5da3-93e7-d46575de5c6a" :question/problem "![](images/dc/dc355ab2667e4f215b6c7b27d00029c1c164cc054829fbc72dba82786c173810.png)\n\nWhich of the following gives the graph of the straight line above?\n\nSelect all that apply." :question/worked-solution "Let's pick two distinct points on the line. For example, $A$ and $B$ with coordinates $(0,1)$ and $(1,0)$, respectively.\n\n![](images/de/def3b4d24e1db68fbd7e872f786fa8e20e4ff4dc193ed3060c08d1b12dfd5c5e.png)\n\nNow, we substitute the coordinates of both points in our equations. If both points satisfy an equation, then we can conclude that the equation represents the line in the graph. Otherwise, if any point does *not* satisfy the equation, then we can conclude that the equation does *not* represent the line in the graph.\n\n- Equation: $y=-x.$\nSubstituting the coordinates of $A(0,1)$, we obtain\n\n$$\n\\begin{aligned}(1) &=-(0) \\\\ 1 &=0\\,\\times\\end{aligned}\n$$\n\nTherefore, $y=-x$ is *not* an equation of the line in the graph.\n\n- Equation: $y=1-x.$\nSubstituting the coordinates of $A(0,1)$ and $B(1,0)$, we obtain\n\n$$\n\\begin{aligned}(1) &=1-(0) \\\\ 1 &=1\\,\\checkmark \\\\ (0) &=1-(1) \\\\ 0 &=0\\,\\checkmark\\end{aligned}\n$$\n\nTherefore, $y=1-x$ is an equation of the line in the graph.\n\n- Equation: $y+x=1.$\nSubstituting the coordinates of $A(0,1)$ and $B(1,0)$, we obtain\n\n$$\n\\begin{aligned}(1)+(0) &=1 \\\\ 1 &=1\\,\\checkmark \\\\ (0)+(1) &=1 \\\\ 1 &=1\\,\\checkmark\\end{aligned}\n$$\n\nTherefore, $y+x=1$ is an equation of the line in the graph.\n\nSelect $y=1-x$, $y+x=1$."} {:db/id #edb/ref 17592186623792 :knowledge-point/_questions [{:db/id #edb/ref 17592186054802 :knowledge-point/id #uuid "3986a3cd-c543-54e9-8d55-f744d9436313" :knowledge-point/title "Identifying a Line Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75612bb9-1bca-50b0-a75b-03f056b68331" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623806} {:answer/id #uuid "d8d5c8d1-01e7-5907-8d81-db4decf4b373" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623827}] :answer-field/correct {:answer/id #uuid "d8d5c8d1-01e7-5907-8d81-db4decf4b373" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623827} :answer-field/id #uuid "57324080-95ee-5c60-8bef-60f7125be4a5" :answer-field/key "$2y+2x=-6$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186623801} {:answer-field/choices [{:answer/id #uuid "44a81758-ffd0-5df8-8690-e86a98d1cfe6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623794} {:answer/id #uuid "83d0d3ec-2eb5-5653-b9da-d17b2f812ee0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623811}] :answer-field/correct {:answer/id #uuid "44a81758-ffd0-5df8-8690-e86a98d1cfe6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623794} :answer-field/id #uuid "83f38735-96ff-5b55-bb55-ba270582ef09" :answer-field/key "$y=-x-3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186623812} {:answer-field/choices [{:answer/id #uuid "14b164f9-63c2-500f-910f-8740566cae96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623788} {:answer/id #uuid "47d861f8-4d5d-553c-b423-8c34ddd07d12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623796}] :answer-field/correct {:answer/id #uuid "14b164f9-63c2-500f-910f-8740566cae96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623788} :answer-field/id #uuid "ac378981-c0ed-50a5-80f9-7b72d832acf2" :answer-field/key "$y=-3+x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186623820}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4083eb48-a65c-58eb-a4fb-0130fe178787" :question/problem "![](images/3d/3dcd48f167c1abd8135af4802bfe3c6abd980eba1ef2bbf0adb87156d7c2faa3.png)\n\nWhich of the following gives the graph of the straight line above?\n\nSelect all that apply." :question/worked-solution "Let's pick two distinct points on the line. For example, $A$ and $B$ with coordinates $(0,-3)$ and $(1,-4)$, respectively.\n\n![](images/93/930d1bbba272eb5b747ebc4ece3a2b93e7509cbd1e0b58903096149854319288.png)\n\nNow, we substitute the coordinates of both points in our equations. If both points satisfy an equation, then we can conclude that the equation represents the line in the graph. Otherwise, if any point does *not* satisfy the equation, then we can conclude that the equation does *not* represent the line in the graph.\n\n- Equation: $y=-x-3.$\nSubstituting the coordinates of $A(0,-3)$ and $B(1,-4)$, we obtain\n\n$$\n\\begin{aligned}(-3) &=-(0)-3 \\\\ -3 &=-3\\,\\checkmark \\\\ (-4) &=-(1)-3 \\\\ -4 &=-4\\,\\checkmark\\end{aligned}\n$$\n\nTherefore, $y=-x-3$ is an equation of the line in the graph.\n\n- Equation: $2y+2x=-6.$\nSubstituting the coordinates of $A(0,-3)$ and $B(1,-4)$, we obtain\n\n$$\n\\begin{aligned}2(-3)+2(0) &=-6 \\\\ -6 &=-6\\,\\checkmark \\\\ 2(-4)+2(1) &=-6 \\\\ -6 &=-6\\,\\checkmark\\end{aligned}\n$$\n\nTherefore, $2y+2x=-6$ is an equation of the line in the graph.\n\n- Equation: $y=-3+x.$\nSubstituting the coordinates of $A(0,-3)$ and $B(1,-4)$, we obtain\n\n$$\n\\begin{aligned}(-3) &=-3+(0) \\\\ -3 &=-3\\,\\checkmark \\\\ (-4) &=-3+(1) \\\\ -4 &=-2\\,\\times\\end{aligned}\n$$\n\nTherefore, $y=-3+x$ is *not* an equation of the line in the graph.\n\nSelect $y=-x-3$, $2y+2x=-6$."} {:db/id #edb/ref 17592186623805 :knowledge-point/_questions [{:db/id #edb/ref 17592186054802 :knowledge-point/id #uuid "3986a3cd-c543-54e9-8d55-f744d9436313" :knowledge-point/title "Identifying a Line Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e192d527-f46e-5e91-923a-ee5995705db7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623829} {:answer/id #uuid "f5f7b5ed-b7fd-5ea0-a40d-02475912a1f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623834}] :answer-field/correct {:answer/id #uuid "e192d527-f46e-5e91-923a-ee5995705db7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623829} :answer-field/id #uuid "1e840367-5b0e-5795-89f3-2c5f0d1ab2df" :answer-field/key "$y-2x=4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186623790} {:answer-field/choices [{:answer/id #uuid "5d47021d-b7d1-59ab-b682-8deb43ed122f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623802} {:answer/id #uuid "72ae16fd-ed3e-56bb-8d06-6d7374de984e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623804}] :answer-field/correct {:answer/id #uuid "72ae16fd-ed3e-56bb-8d06-6d7374de984e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623804} :answer-field/id #uuid "8426c3b1-f90f-5a8f-b311-217c22e9bf88" :answer-field/key "$y=2x+5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186623813} {:answer-field/choices [{:answer/id #uuid "18d90508-2aec-59a1-ac0b-3e16ba2d6462" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623789} {:answer/id #uuid "2ebad458-376f-5207-b7f8-6ede95c2d647" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623791}] :answer-field/correct {:answer/id #uuid "2ebad458-376f-5207-b7f8-6ede95c2d647" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623791} :answer-field/id #uuid "dce2a1cc-61a4-502b-9aff-3bb5f2a12c74" :answer-field/key "$y=4+2x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186623828}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "73cf73d7-aed7-5537-98d4-76c7214530c3" :question/problem "![](images/76/765f4148294d78ace114858bfcd459d1eef17dd7cfcd54764b7b848b5e6acbf2.png)\n\nWhich of the following gives the graph of the straight line above?\n\nSelect all that apply." :question/worked-solution "Let's pick two distinct points on the line. For example, $A$ and $B$ with coordinates $(0,4)$ and $(1,6)$, respectively.\n\n![](images/16/162d47dcc98dfa30f90d511692061b524b96cac0fefa87e5db478d5cbd859b78.png)\n\nNow, we substitute the coordinates of both points in our equations. If both points satisfy an equation, then we can conclude that the equation represents the line in the graph. Otherwise, if any point does *not* satisfy the equation, then we can conclude that the equation does *not* represent the line in the graph.\n\n- Equation: $y=2x+5.$\nSubstituting the coordinates of $A(0,4)$, we obtain\n\n$$\n\\begin{aligned}(4) &=2(0)+5 \\\\ 4 &=5\\,\\times\\end{aligned}\n$$\n\nTherefore, $y=2x+5$ is *not* an equation of the line in the graph.\n\n- Equation: $y=4+2x.$\nSubstituting the coordinates of $A(0,4)$ and $B(1,6)$, we obtain\n\n$$\n\\begin{aligned}(4) &=4+2(0) \\\\ 4 &=4\\,\\checkmark \\\\ (6) &=4+2(1) \\\\ 6 &=6\\,\\checkmark\\end{aligned}\n$$\n\nTherefore, $y=4+2x$ is an equation of the line in the graph.\n\n- Equation: $y-2x=4.$\nSubstituting the coordinates of $A(0,4)$ and $B(1,6)$, we obtain\n\n$$\n\\begin{aligned}(4)-2(0) &=4 \\\\ 4 &=4\\,\\checkmark \\\\ (6)-2(1) &=4 \\\\ 4 &=4\\,\\checkmark\\end{aligned}\n$$\n\nTherefore, $y-2x=4$ is an equation of the line in the graph.\n\nSelect $y=4+2x$, $y-2x=4$."} {:db/id #edb/ref 17592186623822 :knowledge-point/_questions [{:db/id #edb/ref 17592186054802 :knowledge-point/id #uuid "3986a3cd-c543-54e9-8d55-f744d9436313" :knowledge-point/title "Identifying a Line Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9027d197-9423-57d9-860d-4e3579b058ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623816} {:answer/id #uuid "a599de1b-4ed4-5427-ae1a-9300af4f958d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623819}] :answer-field/correct {:answer/id #uuid "9027d197-9423-57d9-860d-4e3579b058ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623816} :answer-field/id #uuid "4a7a8189-23a7-5476-9ebf-790140dfb390" :answer-field/key "$2y-2x=-2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186623797} {:answer-field/choices [{:answer/id #uuid "414d8fd7-d5c1-5871-a1ec-1045a574cb7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623793} {:answer/id #uuid "7a2aeef2-3358-53c8-9fa0-b6e3631ac134" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623809}] :answer-field/correct {:answer/id #uuid "414d8fd7-d5c1-5871-a1ec-1045a574cb7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623793} :answer-field/id #uuid "53a996a0-e4bb-5298-94e2-9b31110624a2" :answer-field/key "$y=-1-x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186623799} {:answer-field/choices [{:answer/id #uuid "54750bae-badc-5895-80e1-30f74505032c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623800} {:answer/id #uuid "79a8bd17-9833-59d0-81f5-18aec6f4a437" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623808}] :answer-field/correct {:answer/id #uuid "79a8bd17-9833-59d0-81f5-18aec6f4a437" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623808} :answer-field/id #uuid "fbd009c5-b347-507a-ae3b-8a308ed7a802" :answer-field/key "$y=-x-1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186623835}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cb618abc-fffb-5581-9bde-9c9323e2240e" :question/problem "![](images/da/da52fbd751e778bc191d6a7067d8bf0de81b46a1eb7db10a8af0de965c735c0e.png)\n\nWhich of the following gives the graph of the straight line above?\n\nSelect all that apply." :question/worked-solution "Let's pick two distinct points on the line. For example, $A$ and $B$ with coordinates $(0,-1)$ and $(1,0)$, respectively.\n\n![](images/6c/6c23998a9dfa5ca9c3a2cfe12eafd08f2382f6006b284b04181d56c902f6c6eb.png)\n\nNow, we substitute the coordinates of both points in our equations. If both points satisfy an equation, then we can conclude that the equation represents the line in the graph. Otherwise, if any point does *not* satisfy the equation, then we can conclude that the equation does *not* represent the line in the graph.\n\n- Equation: $y=-x-1.$\nSubstituting the coordinates of $A(0,-1)$ and $B(1,0)$, we obtain\n\n$$\n\\begin{aligned}(-1) &=-(0)-1 \\\\ -1 &=-1\\,\\checkmark \\\\ (0) &=-(1)-1 \\\\ 0 &=-2\\,\\times\\end{aligned}\n$$\n\nTherefore, $y=-x-1$ is *not* an equation of the line in the graph.\n\n- Equation: $2y-2x=-2.$\nSubstituting the coordinates of $A(0,-1)$ and $B(1,0)$, we obtain\n\n$$\n\\begin{aligned}2(-1)-2(0) &=-2 \\\\ -2 &=-2\\,\\checkmark \\\\ 2(0)-2(1) &=-2 \\\\ -2 &=-2\\,\\checkmark\\end{aligned}\n$$\n\nTherefore, $2y-2x=-2$ is an equation of the line in the graph.\n\n- Equation: $y=-1-x.$\nSubstituting the coordinates of $A(0,-1)$ and $B(1,0)$, we obtain\n\n$$\n\\begin{aligned}(-1) &=-1-(0) \\\\ -1 &=-1\\,\\checkmark \\\\ (0) &=-1-(1) \\\\ 0 &=-2\\,\\times\\end{aligned}\n$$\n\nTherefore, $y=-1-x$ is *not* an equation of the line in the graph.\n\nSelect $2y-2x=-2$."} {:db/id #edb/ref 17592186623832 :knowledge-point/_questions [{:db/id #edb/ref 17592186054802 :knowledge-point/id #uuid "3986a3cd-c543-54e9-8d55-f744d9436313" :knowledge-point/title "Identifying a Line Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ccc8a83-7eca-5aee-8335-b8a82ecf2914" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623815} {:answer/id #uuid "ce024f1b-5129-5f5c-ba79-e26802f71a74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623824}] :answer-field/correct {:answer/id #uuid "8ccc8a83-7eca-5aee-8335-b8a82ecf2914" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623815} :answer-field/id #uuid "6a97edaf-c97c-5c2c-81d8-9d17dce941c7" :answer-field/key "$y-x=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186623803} {:answer-field/choices [{:answer/id #uuid "46ccedc3-ac5f-5fc4-84d1-6e8012b2dbd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623795} {:answer/id #uuid "d55b641b-f139-534f-8b88-93bbe97803f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623825}] :answer-field/correct {:answer/id #uuid "46ccedc3-ac5f-5fc4-84d1-6e8012b2dbd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623795} :answer-field/id #uuid "8bdcaaed-df40-58aa-aaac-68e2e173e087" :answer-field/key "$y=x+2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186623814} {:answer-field/choices [{:answer/id #uuid "7c555e52-3d9b-59ac-aa7d-d63b3de4eb91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623810} {:answer/id #uuid "c60ff82d-d82d-5aea-87a3-88a2c42c905b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623821}] :answer-field/correct {:answer/id #uuid "7c555e52-3d9b-59ac-aa7d-d63b3de4eb91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623810} :answer-field/id #uuid "e44a2c28-cbcb-5fb9-ba4c-3b2dfdfee9b9" :answer-field/key "$y=2+x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186623830}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f3ae89b4-e017-5481-a893-5525a2c4dd2d" :question/problem "![](images/80/8088eeb04d86e5719ce7b3d9f62a17a97c012107d1bff7acd9fa37c6b473ca3e.png)\n\nWhich of the following gives the graph of the straight line above?\n\nSelect all that apply." :question/worked-solution "Let's pick two distinct points on the line. For example, $A$ and $B$ with coordinates $(0,2)$ and $(1,3)$, respectively.\n\n![](images/d8/d8cbae503bf244e18d3ac62bc4ef87cc775e71b68e5bdab888a3c776d5080090.png)\n\nNow, we substitute the coordinates of both points in our equations. If both points satisfy an equation, then we can conclude that the equation represents the line in the graph. Otherwise, if any point does *not* satisfy the equation, then we can conclude that the equation does *not* represent the line in the graph.\n\n- Equation: $y=x+2.$\nSubstituting the coordinates of $A(0,2)$ and $B(1,3)$, we obtain\n\n$$\n\\begin{aligned}(2) &=(0)+2 \\\\ 2 &=2\\,\\checkmark \\\\ (3) &=(1)+2 \\\\ 3 &=3\\,\\checkmark\\end{aligned}\n$$\n\nTherefore, $y=x+2$ is an equation of the line in the graph.\n\n- Equation: $y=2+x.$\nSubstituting the coordinates of $A(0,2)$ and $B(1,3)$, we obtain\n\n$$\n\\begin{aligned}(2) &=2+(0) \\\\ 2 &=2\\,\\checkmark \\\\ (3) &=2+(1) \\\\ 3 &=3\\,\\checkmark\\end{aligned}\n$$\n\nTherefore, $y=2+x$ is an equation of the line in the graph.\n\n- Equation: $y-x=2.$\nSubstituting the coordinates of $A(0,2)$ and $B(1,3)$, we obtain\n\n$$\n\\begin{aligned}(2)-(0) &=2 \\\\ 2 &=2\\,\\checkmark \\\\ (3)-(1) &=2 \\\\ 2 &=2\\,\\checkmark\\end{aligned}\n$$\n\nTherefore, $y-x=2$ is an equation of the line in the graph.\n\nSelect $y=x+2$, $y=2+x$, $y-x=2$."} {:db/id #edb/ref 17592186624668 :knowledge-point/_questions [{:db/id #edb/ref 17592186054816 :knowledge-point/id #uuid "1d132801-b9cc-5c0c-a8fa-0c8b840c05bd" :knowledge-point/title "Identifying Sets Containing a Given Element"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0f0b76d-923c-5635-b743-874c6bb47335" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186624709} {:answer/id #uuid "eaa2118e-15e5-556f-9a98-465bfd798200" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186624722}] :answer-field/correct {:answer/id #uuid "eaa2118e-15e5-556f-9a98-465bfd798200" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186624722} :answer-field/id #uuid "136fc7a9-7ed2-567e-b576-3de507e49f1b" :answer-field/key "$\\mathbb{R}^{+}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186624673} {:answer-field/choices [{:answer/id #uuid "640702b5-3be2-50a4-92d4-b39d3a3bb8b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186624693} {:answer/id #uuid "8f61e68d-3baa-5f24-a52f-822cb4c0cb9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186624707}] :answer-field/correct {:answer/id #uuid "640702b5-3be2-50a4-92d4-b39d3a3bb8b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186624693} :answer-field/id #uuid "4b3ea1f2-240b-50c6-825e-e8787a3d9850" :answer-field/key "$\\mathbb{Q}^{+}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186624689} {:answer-field/choices [{:answer/id #uuid "40d732ed-b2cf-531c-a205-f49b31dfae31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186624686} {:answer/id #uuid "7e69335e-6008-5b7f-9600-3dde433a1161" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186624703}] :answer-field/correct {:answer/id #uuid "7e69335e-6008-5b7f-9600-3dde433a1161" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186624703} :answer-field/id #uuid "6c3f675f-bf6e-5134-bd4b-e180f3bf6929" :answer-field/key "$\\mathbb{R}_0^{-}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186624695} {:answer-field/choices [{:answer/id #uuid "757947ac-9933-53a3-9c9d-2fcaea91c9f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186624700} {:answer/id #uuid "f6a3a4a4-9f54-578f-a657-29d14b589a98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186624725}] :answer-field/correct {:answer/id #uuid "757947ac-9933-53a3-9c9d-2fcaea91c9f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186624700} :answer-field/id #uuid "bb06c69f-9c84-5cff-97f1-855600e236ee" :answer-field/key "$\\mathbb{N}_0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186624713}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "05128974-4082-5f79-84f1-a525d461411d" :question/problem "To which of the following sets do all the negative integers belong?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "We must check whether each set contains all the negative integers.\n\n- The set $\\mathbb{Q}^{+}$ contains the positive rational numbers. For instance, $-1$ is in the given class but not in $\\mathbb{Q}^{+}$. Therefore, this set does not contain all the negative integers.\n\n- The set $\\mathbb{R}_0^{-}$ contains the nonpositive real numbers. By the number-set hierarchy and the sign restrictions, every member of the given class belongs to $\\mathbb{R}_0^{-}$.\n\n- The set $\\mathbb{R}^{+}$ contains the positive real numbers. For instance, $-1$ is in the given class but not in $\\mathbb{R}^{+}$. Therefore, this set does not contain all the negative integers.\n\n- The set $\\mathbb{N}_0$ contains the nonnegative integers. For instance, $-1$ is in the given class but not in $\\mathbb{N}_0$. Therefore, this set does not contain all the negative integers.\n\nTherefore, select $\\mathbb{R}_0^{-}$ only."} {:db/id #edb/ref 17592186624674 :knowledge-point/_questions [{:db/id #edb/ref 17592186054816 :knowledge-point/id #uuid "1d132801-b9cc-5c0c-a8fa-0c8b840c05bd" :knowledge-point/title "Identifying Sets Containing a Given Element"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "046c4ea1-b4f1-55f0-8566-85776362a1b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186624667} {:answer/id #uuid "da90a2a4-472e-51f0-af6d-146a05e6f5af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186624718}] :answer-field/correct {:answer/id #uuid "046c4ea1-b4f1-55f0-8566-85776362a1b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186624667} :answer-field/id #uuid "12073a69-2860-5e80-81a7-a1e64a078884" :answer-field/key "$\\mathbb{Q}^{-}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186624671} {:answer-field/choices [{:answer/id #uuid "fbdb537f-c3ce-5af4-a4aa-fc6cf9135e2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186624728} {:answer/id #uuid "fd7c41ab-5faf-534a-872c-c2f33073633b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186624730}] :answer-field/correct {:answer/id #uuid "fbdb537f-c3ce-5af4-a4aa-