rix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186576354} {:answer-field/choices [{:answer/id #uuid "0b716553-bd06-550e-ae84-aa8371426ecc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186576323} {:answer/id #uuid "2303720f-e337-5b64-9abd-98372e41e6f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186576333}] :answer-field/correct {:answer/id #uuid "0b716553-bd06-550e-ae84-aa8371426ecc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186576323} :answer-field/id #uuid "ff2a5850-18d8-5627-b26f-be20156aeea9" :answer-field/key "$A=\\begin{bmatrix}1 & -4 \\\\ 0 & 2\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186576357}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "40b938cb-f23c-5d0f-a251-58ee4d72d0a4" :question/math-academy-id "q-126346" :question/problem "Which of the following matrices are upper triangular matrices?\n\nSelect all that apply." :question/worked-solution "The matrix $A$ is an upper triangular matrix since all the entries below the main diagonal are zeros.\n\nThe matrices $B$ and $C$ are *not* upper triangular matrices since they each have a non-zero element below the main diagonal: \n\n$$\n\\begin{aligned}{b}_{21} & =2\\ne 0 \\\\ {c}_{32} & =-2\\ne 0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186571405 :knowledge-point/_questions [{:db/id #edb/ref 17592186119784 :knowledge-point/id #uuid "e69a4aee-6e92-598b-99b5-1d830b6dea54" :knowledge-point/title "Identifying Correct Statements About a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41c8674e-08d3-5072-8aea-faf5c91f3c48" :answer/type {:db/id #edb/ref 1