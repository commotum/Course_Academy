lect all that apply." :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $B$ has $3$ pivots in the $1$st, $3$rd, and $5$th columns:\n\n$$\nB=\\begin{bmatrix}1 & -7 & 4 & 8 & 5 \\\\ 0 & 0 & -5 & 0 & -4 \\\\ 0 & 0 & 0 & 0 & -7\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186566245 :knowledge-point/_questions [{:db/id #edb/ref 17592186124478 :knowledge-point/id #uuid "a5f0d2e9-1cf6-5fe4-85cc-f401382f39b2" :knowledge-point/title "Finding the Non-Pivot Columns of a Matrix in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "550422ad-c23c-5b7e-a490-22b91a643f17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186574495} {:answer/id #uuid "da0ea095-5e3c-5408-a66b-f3f677e99e9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574496}] :answer-field/correct {:answer/id #uuid "550422ad-c23c-5b7e-a490-22b91a643f17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186574495} :answer-field/id #uuid "1407862a-8e5d-5e7f-a64c-f87d942cb233" :answer-field/key "Column 1: $\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186574730} {:answer-field/choices [{:answer/id #uuid "10359013-8fde-5571-ac4d-f1fd53b7d80b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186574497} {:answer/id #uuid "346850c4-5a40-52ad-97a4-7cfa02edc82e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574498}] :answer-field/correct {:answer/id #uuid "10359013-8fde-5571-ac4d-f1fd53b7d80b" :answer/type {:db/id #edb/ref 1759218