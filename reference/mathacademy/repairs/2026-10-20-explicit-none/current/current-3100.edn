f-5f66-a319-20316ab04834" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186576353} :answer-field/id #uuid "cb1bdca5-4ce0-599f-a4ef-e86e1507d8a7" :answer-field/key "$D$ is lower triangular." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186576352}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5fc95051-8b70-5447-aece-290d3854c40e" :question/math-academy-id "q-126481" :question/problem "Consider the matrix\n\n$$\nD=\\begin{bmatrix}1 & 0 & 0 & 0 \\\\ 0 & 2 & 0 & 0 \\\\ 1 & 1 & 3 & 0 \\\\ 1 & 1 & 0 & 4\\end{bmatrix}\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's analyze each statement in turn.\n\n- $D$ is upper triangular: **False.** This fails because $D$ has non-zero entries below the main diagonal:\n\n$$\nD=\\begin{bmatrix}1 & 0 & 0 & 0 \\\\ 0 & 2 & 0 & 0 \\\\ 1 & 1 & 3 & 0 \\\\ 1 & 1 & 0 & 4\\end{bmatrix}\n$$\n\n- $D$ is lower triangular: **True.** All the entries above the main diagonal of $D$ are zeros:\n\n$$\nD=\\begin{bmatrix}1 & 0 & 0 & 0 \\\\ 0 & 2 & 0 & 0 \\\\ 1 & 1 & 3 & 0 \\\\ 1 & 1 & 0 & 4\\end{bmatrix}\n$$\n\n- ${D}^{T}$ is upper triangular: **True.** All the entries below the main diagonal of ${D}^{T}$ are zeros:\n\n$$\n{D}^{T}=\\begin{bmatrix}1 & 0 & 1 & 1 \\\\ 0 & 2 & 1 & 1 \\\\ 0 & 0 & 3 & 0 \\\\ 0 & 0 & 0 & 4\\end{bmatrix}\n$$\n\nThe true statements are:\n\n- $D$ is lower triangular.\n- ${D}^{T}$ is upper triangular."} {:db/id #edb/ref 17592186571420 :knowledge-point/_questions [{:db/id #edb/ref 17592186119784 :knowledge-point/id #uuid "e69a4aee-6e92-598b-99b5-1d830b6dea54" :knowledge-point/title "Identifying Correct Statements About a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f5e3104-7cbb-553b-a0d4-b02d61cb8874" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186576327} {:answer/id #uuid "30050467-b3b0-540a-aefb-ac26951b0a68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186576336}] :answer-field/correct {:answer/id #uuid "0f5e3104-7cbb-553b-a0d4-b02d61cb8874" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186576327} :answer-field/id #uuid "1377adec-7f6e-5304-8b00-f728efc3c5b7" :answer-field/key "$B$ is lower triangular." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186576328} {:answer-field/choices [{:answer/id #uuid "2b6b8b0d-7ff0-59a0-9419-9bcc6dde0346" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186576335} {:answer/id #uuid "b32eb6e4-ad48-52e9-8cec-78071c9a9b97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186576348}] :answer-field/correct {:answer/id #uuid "b32eb6e4-ad48-52e9-8cec-78071c9a9b97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186576348} :answer-field/id #uuid "199cbca1-cc20-522f-bcdb-3c7f1d2f207d" :answer-field/key "$B$ is upper triangular." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186576330} {:answer-field/choices [{:answer/id #uuid "3530c492-20bd-55d7-af2c-4ba57d489b39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186576338} {:answer/id #uuid "b6d98655-7e16-56d0-8782-f3ca1fe9e518" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186576350}] :answer-field/correct {:answer/id #uuid "b6d98655-7e16-56d0-8782-f3ca1fe9e518" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186576350} :answer-field/id #uuid "1a663974-2c8d-590b-b36f-53f0131be177" :answer-field/key "${B}^{T}+B$ is upper triangular." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186576331}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "814b1f0e-0432-56a4-8a3b-10efb7462756" :question/math-academy-id "q-126474" :question/problem "Consider the matrix\n\n$$\nB=\\begin{bmatrix}-1 & 0 & -5 \\\\ 0 & 2 & 2 \\\\ 5 & -2 & -4\\end{bmatrix}\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's analyze each statement in turn.\n\n- $B$ is upper triangular: **False.** This fails because $B$ has non-zero entries below the main diagonal:\n\n$$\nB=\\begin{bmatrix}-1 & 0 & -5 \\\\ 0 & 2 & 2 \\\\ 5 & -2 & -4\\end{bmatrix}\n$$\n\n- $B$ is lower triangular: **False.** This fails because $B$ has non-zero entries above the main diagonal:\n\n$$\nB=\\begin{bmatrix}-1 & 0 & -5 \\\\ 0 & 2 & 2 \\\\ 5 & -2 & -4\\end{bmatrix}\n$$\n\n- ${B}^{T}+B$ is upper triangular: **True.** This holds because the result of ${B}^{T}+B$ has all the entries below the main diagonal equal to zero:\n\n$$\n{B}^{T}+B=\\begin{bmatrix}-2 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & -8\\end{bmatrix}\n$$\n\nThe true statements are:\n\n- ${B}^{T}+B$ is upper triangular."} {:db/id #edb/ref 17592186573261 :knowledge-point/_questions [{:db/id #edb/ref 17592186124480 :knowledge-point/id #uuid "b1a557d6-52f3-5df3-8088-5b875296e72e" :knowledge-point/title "Finding the Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34bb3242-3134-5442-90a9-922e1da270d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186574545} {:answer/id #uuid "027be393-a224-54aa-993c-abd257ce1785" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574546}] :answer-field/correct {:answer/id #uuid "027be393-a224-54aa-993c-abd257ce1785" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574546} :answer-field/id #uuid "619906b8-06e8-5c77-94de-1a450ee9ea09" :answer-field/key "Column 1: $\\begin{bmatrix}2 \\\\ 0 \\\\ 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186574755} {:answer-field/choices [{:answer/id #uuid "f03978fb-b072-5e66-9a7e-1791cd3a249d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186574547} {:answer/id #uuid "252d5e26-68d3-5151-9f12-274c01dbf914" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574548}] :answer-field/correct {:answer/id #uuid "f03978fb-b072-5e66-9a7e-1791cd3a249d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186574547} :answer-field/id #uuid "888815d7-d550-5bb0-b433-15d830e61c75" :answer-field/key "Column 2: $\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186574756} {:answer-field/choices [{:answer/id #uuid "b3a19b4e-b094-5857-9dd9-62b9208b070f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186574549} {:answer/id #uuid "034dfbdd-135c-551c-a42c-8ff41387d10f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574550}] :answer-field/correct {:answer/id #uuid "034dfbdd-135c-551c-a42c-8ff41387d10f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574550} :answer-field/id #uuid "b1b0345a-0726-5c3c-be00-c63b1e13ac46" :answer-field/key "Column 3: $\\begin{bmatrix}-1 \\\\ 0 \\\\ 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186574757} {:answer-field/choices [{:answer/id #uuid "92ab9cdf-5d9d-5c76-986e-c2fa4c6179e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186574551} {:answer/id #uuid "f3854d29-f6c0-5f38-92ce-58e740817991" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574552}] :answer-field/correct {:answer/id #uuid "f3854d29-f6c0-5f38-92ce-58e740817991" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574552} :answer-field/id #uuid "153fc202-de5e-501a-8466-13be4cac24dc" :answer-field/key "Column 4: $\\begin{bmatrix}0 \\\\ 5 \\\\ -2\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186574758}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0dd8f23a-a284-5af7-a370-b6877f8aea89" :question/math-academy-id "q-73637" :question/problem "What are the pivot columns of the matrix $P,$ given by\n\n$$\nP=\\begin{bmatrix}2 & 0 & -1 & 0 \\\\ 0 & 0 & 0 & 5 \\\\ 0 & 0 & 1 & -2\\end{bmatrix}?\n$$\n\nSelect all that apply." :question/worked-solution "First, we need to convert $P$ to row echelon form:\n\n$$\n\\begin{aligned}P & =\\begin{bmatrix}2 & 0 & -1 & 0 \\\\ 0 & 0 & 0 & 5 \\\\ 0 & 0 & 1 & -2\\end{bmatrix} & {R}_{2} & ↔{R}_{3} \\\\  & ∼\\begin{bmatrix}2 & 0 & -1 & 0 \\\\ 0 & 0 & 1 & -2 \\\\ 0 & 0 & 0 & 5\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $P$ has $3$ pivots. In particular, the pivot columns are the $1$st, $3$rd, and $4$th columns."} {:db/id #edb/ref 17592186577195 :knowledge-point/_questions [{:db/id #edb/ref 17592186100888 :knowledge-point/id #uuid "201edc93-37b4-556a-aaea-4fcf9a01077a" :knowledge-point/title "Identifying a Solution to a First-Order Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b697512-d6ce-5d58-bc2f-44300a470396" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577184} {:answer/id #uuid "4421f52c-8db7-510c-a3d0-e08d93874bb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577194}] :answer-field/correct {:answer/id #uuid "1b697512-d6ce-5d58-bc2f-44300a470396" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577184} :answer-field/id #uuid "3495b22a-5a40-5f4c-a29c-2521e744ca38" :answer-field/key "Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577192} {:answer-field/choices [{:answer/id #uuid "1eb60bde-94b4-5458-b7f4-9d69e214bb5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577185} {:answer/id #uuid "a93e1b70-b465-590a-b650-b80a76b041e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577213}] :answer-field/correct {:answer/id #uuid "a93e1b70-b465-590a-b650-b80a76b041e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577213} :answer-field/id #uuid "70375abd-6d28-58de-b77f-ce69697a327a" :answer-field/key "The function $y=f(x)$ is a solution of the differential equation." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577206} {:answer-field/choices [{:answer/id #uuid "07f2b71f-67b4-5220-b1f2-f9c9f3e2990b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577179} {:answer/id #uuid "66b843bb-147d-5696-b9c6-20fb6aa9e3df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577203}] :answer-field/correct {:answer/id #uuid "66b843bb-147d-5696-b9c6-20fb6aa9e3df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577203} :answer-field/id #uuid "ce88c0d7-692b-5115-9ff0-7a3fad5b60fe" :answer-field/key "$f\\prime(x)=\\frac{5}{3 x}.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577216}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "45c5715f-9b0f-5612-a118-607bd8abc3ff" :question/problem "Consider the following differential equation.\n\n$$\ny\\prime=3 e^{- y},\\qquad 3 x>0\n$$\n\nLet $f(x)=\\ln{\\left(3 x \\right)}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in an interval where the function is defined and the equation is valid.\n\nWith that in mind, let's check each statement in turn.\n\n- Statement $f\\prime(x)=\\frac{5}{3 x}.$ is false. Differentiating $f(x)=\\ln{\\left(3 x \\right)},$ we get\n\n$$\n\\begin{aligned}f\\prime(x)&=\\left(\\ln{\\left(3 x \\right)}\\right)\\prime \\\\ &=\\frac{1}{3 x}\\cdot 3 \\\\ &=\\frac{1}{x} \\\\ &\\not\\equiv \\frac{5}{3 x}\\end{aligned}\n$$\n\n- Statement “Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement” is true. Substituting $y=\\ln{\\left(3 x \\right)}$ and $y\\prime=\\frac{1}{x}$ into the original equation gives an identity:\n\n$$\n\\begin{aligned}y\\prime &\\overset{?}{=}3 e^{- y} \\\\ \\frac{1}{x} &\\overset{?}{=}\\frac{3}{e^{\\ln{\\left(3 x \\right)}}} \\\\ \\frac{1}{x} &=\\frac{1}{x}\\end{aligned}\n$$\n\n- Statement “The function $y=f(x)$ is a solution of the differential equation” is true. Since statement “Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement” is true, the function $y=\\ln{\\left(3 x \\right)}$ is a solution to our differential equation.\n\nTherefore, the correct answer is “Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement”; “The function $y=f(x)$ is a solution of the differential equation” only."} {:db/id #edb/ref 17592186577202 :knowledge-point/_questions [{:db/id #edb/ref 17592186100888 :knowledge-point/id #uuid "201edc93-37b4-556a-aaea-4fcf9a01077a" :knowledge-point/title "Identifying a Solution to a First-Order Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e396c4fd-71c1-59bc-9209-55e931510240" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577222} {:answer/id #uuid "e6df26ad-bd81-5aaa-81e2-ef34d75cdbe7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577224}] :answer-field/correct {:answer/id #uuid "e6df26ad-bd81-5aaa-81e2-ef34d75cdbe7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577224} :answer-field/id #uuid "6808e726-3826-52a1-816d-23e80ef6d446" :answer-field/key "The function $y=f(x)$ is a solution of the differential equation." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577204} {:answer-field/choices [{:answer/id #uuid "4c7a9207-df6c-50b8-9322-193b412462e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577197} {:answer/id #uuid "e7e176ae-2161-5a2f-98fa-6518aaefb7bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577225}] :answer-field/correct {:answer/id #uuid "4c7a9207-df6c-50b8-9322-193b412462e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577197} :answer-field/id #uuid "7b09d08b-9296-54a5-9074-0d5f596c8957" :answer-field/key "Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577208} {:answer-field/choices [{:answer/id #uuid "5f89bbee-f608-509b-809c-754a660a177f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186577200} {:answer/id #uuid "93c10b1d-09b9-596a-91ee-b34e3f0aeb22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577212}] :answer-field/correct {:answer/id #uuid "93c10b1d-09b9-596a-91ee-b34e3f0aeb22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186577212} :answer-field/id #uuid "b30d6233-d2d5-5248-b659-81906ac6d588" :answer-field/key "$f\\prime(x)=\\frac{2}{2 x - 3}.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186577214}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "628c5962-9540-54e0-a743-71b039507ef9" :question/problem "Consider the following differential equation.\n\n$$\ny\\prime=2 e^{- y},\\qquad 2 x - 3>0\n$$\n\nLet $f(x)=\\ln{\\left(2 x - 3 \\right)}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in an interval where the function is defined and the equation is valid.\n\nWith that in mind, let's check each statement in turn.\n\n- Statement $f\\prime(x)=\\frac{2}{2 x - 3}.$ is true. Differentiating $f(x)=\\ln{\\left(2 x - 3 \\right)},$ we get\n\n$$\n\\begin{aligned}f\\prime(x)&=\\left(\\ln{\\left(2 x - 3 \\right)}\\right)\\prime \\\\ &=\\frac{1}{2 x - 3}\\cdot 2 \\\\ &=\\frac{2}{2 x - 3}\\end{aligned}\n$$\n\n- Statement “Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement” is true. Substituting $y=\\ln{\\left(2 x - 3 \\right)}$ and $y\\prime=\\frac{2}{2 x - 3}$ into the original equation gives an identity:\n\n$$\n\\begin{aligned}y\\prime &\\overset{?}{=}2 e^{- y} \\\\ \\frac{2}{2 x - 3} &\\overset{?}{=}\\frac{2}{e^{\\ln{\\left(2 x - 3 \\right)}}} \\\\ \\frac{2}{2 x - 3} &=\\frac{2}{2 x - 3}\\end{aligned}\n$$\n\n- Statement “The function $y=f(x)$ is a solution of the differential equation” is true. Since statement “Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement” is true, the function $y=\\ln{\\left(2 x - 3 \\right)}$ is a solution to our differential equation.\n\nTherefore, the correct answer is $f\\prime(x)=\\frac{2}{2 x - 3}.$; “Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement”; “The function $y=f(x)$ is a solution of the differential equation”."} {:db/id #edb/ref 17592186577207 :knowledge-point/_questions [{:db/id #edb/ref 17592186100888 :knowledge-point/id #uuid "201edc93-37b4-556a-aaea-4fcf9a01077a" :knowledge-point/title "Identifying a Solution to a First-Order Differential Equation"}] :question/answer-fields [{:answer-f