72d5-584e-8462-cce0f8985df7" :answer-field/key "Real numbers ($R$)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186623008}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c11859c0-209d-51d0-8520-9580e3214e65" :question/problem "To which of the following sets does the number $\\pi$ belong?\n\nSelect all that apply." :question/worked-solution "![](images/67/67ef97be4b21a74feaae15f3ff30d5077fc1316874df8de79155316a621e4487.png)\n\nRecall the following:\n\n- $N$ represents the set of **natural numbers**.\n\n- $Z$ represents the set of **integers**.\n\n- $Q$ represents the set of **rational numbers**.\n\n- $R$ represents the set of **real numbers**.\n\n- $C$ represents the set of **complex numbers**.\n\nWith that in mind, we note the following:\n\n- The number $\\pi$ is not an integer, so it does *not* belong to $Z$ nor to $N.$ We can write\n\n$$\n\\pi\\notin N\\qquad \\pi\\notin Z\n$$\n\n- Also, $\\pi$ is a known irrational number. It cannot be written as the ratio of two integers, so it does *not* belong to $Q$ either:\n\n$$\n\\pi\\notin Q\n$$\n\n- Every irrational number is both a real number and a complex number. Consequently, $\\pi$ belongs to both $R$ and $C,$ and we can write\n\n$$\n\\pi\\in R\\qquad \\pi\\in C\n$$\n\nTherefore, the correct answer is $R, C$ only."} {:db/id #edb/ref 17592186622994 :knowledge-point/_questions [{:db/id #edb/ref 17592186054814 :knowledge-point/id #uuid "3de9e532-559c-5fc1-a6ad-5fcd1ed77824" :knowledge-point/title "Identifying Special Sets Containing a Given Element"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "918b749d-210f-57b6-9c31-7d547bb1015b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186622979} {:answer/id #uuid "ca7c3401-3f0d-5266-b9a5-40ed1e0cd1cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :