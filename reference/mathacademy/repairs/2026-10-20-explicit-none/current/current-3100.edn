 17592186574432} :answer-field/id #uuid "2ec92bf1-77fb-554e-9f7d-dc475eef94ca" :answer-field/key "Column 4: $\\begin{bmatrix}-2 \\\\ 1 \\\\ 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186574698}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "29b4d870-1dc8-5b15-b7e0-9a157e214c86" :question/math-academy-id "q-73605" :question/problem "The row echelon form matrix $B$ is given below. What are the pivot columns of $B?$\n\n$$\nB=\\begin{bmatrix}-1 & 1 & 5 & -2 \\\\ 0 & 0 & -3 & 1 \\\\ 0 & 0 & 0 & 1\\end{bmatrix}\n$$\n\nSelect all that apply." :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $B$ has $3$ pivots in the $1$st, $3$rd, and $4$th columns:\n\n$$\nB=\\begin{bmatrix}-1 & 1 & 5 & -2 \\\\ 0 & 0 & -3 & 1 \\\\ 0 & 0 & 0 & 1\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186566219 :knowledge-point/_questions [{:db/id #edb/ref 17592186124477 :knowledge-point/id #uuid "488c9762-554b-5ea6-b414-ce6cbde9bbd1" :knowledge-point/title "Finding the Pivot Columns of a Matrix in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a730bbb-a27a-5f98-99f2-72c6a731084d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186574199} {:answer/id #uuid "d944c90a-fa74-5239-9b5b-baa7a454eaa2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574200}] :answer-field/correct {:answer/id #uuid "d944c90a-fa74-5239-9b5b-baa7a454eaa2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574200} :answer-field/id #uuid "b4da853f-25b0-529e-bce7-1df6650d5d10" :answer-field/key "Column 1: $\\begin{bmatrix}1 \\\\ 0 \\\