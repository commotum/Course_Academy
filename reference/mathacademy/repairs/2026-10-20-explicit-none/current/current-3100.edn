 #edb/ref 17592186623081}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d67627c6-061c-5824-bc56-a5fd176b7707" :question/problem "Which of the numbers below belong to $\\mathbb{R}_0^{+}$?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Remember that $\\mathbb{R}_0^{+}$ is the set of all positive real numbers and zero.\n\n- $-\\pi$: It is negative, and it is an irrational real number. Therefore, it does *not* belong to $\\mathbb{R}_0^{+}$.\n\n- $-8.5=-\\frac{17}{2}$: It is negative, and it is a rational number but not an integer, since it can be written as $-\\frac{17}{2}$. Therefore, it does *not* belong to $\\mathbb{R}_0^{+}$.\n\n- $\\sqrt{13}$: It is positive, and it is an irrational real number. Therefore, it belongs to $\\mathbb{R}_0^{+}$.\n\n- $-66$: It is negative, and it is an integer. Therefore, it does *not* belong to $\\mathbb{R}_0^{+}$.\n\nIn conclusion, the correct answer is: $\\sqrt{13}$."} {:db/id #edb/ref 17592186623074 :knowledge-point/_questions [{:db/id #edb/ref 17592186054815 :knowledge-point/id #uuid "abc6b3ee-0251-5c9c-9358-bd192c434dd1" :knowledge-point/title "Identifying Elements Belonging to Scripted Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4febec72-a977-579b-bdcf-b3580706ee53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623033} {:answer/id #uuid "9f743183-bbbd-570a-b1e5-98929873c748" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623055}] :answer-field/correct {:answer/id #uuid "4febec72-a977-579b-bdcf-b3580706ee53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623033} :answer-field/id #uuid "781a8d64-88d9-5734-b2da-bbf0b2963692" :answer-field/key "$-\\sqrt{14}$" :answer-