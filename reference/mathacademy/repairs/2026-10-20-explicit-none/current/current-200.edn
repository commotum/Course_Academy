eld.type/checkbox} :db/id #edb/ref 17592186440288} {:answer-field/choices [{:answer/id #uuid "5278cce0-690a-57d3-9f99-59786668dd25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439863} {:answer/id #uuid "c194ddff-249d-568f-bbed-b5a98a9cbf2b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439864}] :answer-field/correct {:answer/id #uuid "c194ddff-249d-568f-bbed-b5a98a9cbf2b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439864} :answer-field/id #uuid "4f6cf21c-f929-519d-97e8-9c947398a3c9" :answer-field/key "$(1,-1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440289} {:answer-field/choices [{:answer/id #uuid "fd09c21d-1862-5911-bc93-7b66b39ffdd2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439865} {:answer/id #uuid "800ae177-fe54-5efa-bdce-f8e4327de277" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439866}] :answer-field/correct {:answer/id #uuid "fd09c21d-1862-5911-bc93-7b66b39ffdd2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439865} :answer-field/id #uuid "50868321-e216-553a-b3ca-72efe4f524e3" :answer-field/key "$(1,1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440290}] :question/id #uuid "142e660e-5b1f-5e61-a343-ee1945f69615" :question/math-academy-id "q-65208" :question/problem "At which points on the curve $9x^{2}y = 3y^{3} - 6x$ is the tangent vector to the curve perpendicular to the vector $i$?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Write the curve as F(x,y)=0. A tangent is (F_y,-F_x); its dot product with the given vector is $9 x^{2} - 9 y^{2}$. Solving this with the curve equation gives $(-1,1), (0,0), (1,-1)$, and the tangent is nonzero at each point."} {:db/id #edb/ref 17592186125195 :knowledge-point/_questions [{:db/id #edb/ref 17592186124474 :knowledge-point/id #uuid "149fa184-850f-52d8-a309-4b79a371a74d" :knowledge-point/title "Identifying the Intervals on Which a Function is Invertible Given a Description"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a40ae285-433a-5246-af0a-c88929a17e44" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438362} {:answer/id #uuid "e15901cc-60b2-5acb-8bde-29e449df57e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438363}] :answer-field/correct {:answer/id #uuid "a40ae285-433a-5246-af0a-c88929a17e44" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438362} :answer-field/id #uuid "31c00eba-5f85-593e-a961-4f82d5b230c4" :answer-field/key "$x\\in (-2,2)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439210} {:answer-field/choices [{:answer/id #uuid "0e9d17c6-21e1-5f62-96ed-ad5565cf2dd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438364} {:answer/id #uuid "dffc387b-695d-57a9-8327-5b7f95278dec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438365}] :answer-field/correct {:answer/id #uuid "dffc387b-695d-57a9-8327-5b7f95278dec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438365} :answer-field/id #uuid "d8399770-7bd0-5bd4-871d-487953742e13" :answer-field/key "$x\\in [0,\\infty )$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439211} {:answer-field/choices [{:answer/id #uuid "1e0e5c91-0cdc-57c0-b0a0-e40824bbc4e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438366} {:answer/id #uuid "0fd86b3d-4e5d-5a86-912e-c80f82634797" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438367}] :answer-field/correct {:answer/id #uuid "0fd86b3d-4e5d-5a86-912e-c80f82634797" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438367} :answer-field/id #uuid "4fca4c40-e85f-5c68-8f26-936d0e0fe80e" :answer-field/key "$x\\in (-\\infty ,0]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439212}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9ea11e93-5fca-5cd0-afe6-c972b9a2cce3" :question/math-academy-id "q-66482" :question/problem "Given that $f(x)={x}^{2}+2,$ on which of the following intervals is $f(x)$ invertible?\n\nSelect all that apply." :question/worked-solution "The graph of the function $f(x)={x}^{2}+2$ can be obtained in the following way:\n\n- Take the curve $y={x}^{2}.$\n\n- Translate it by $2$ units up to get $f(x)={x}^{2}+2.$\n\n![](images/ff/ff3d1ac7500d83574b8671b23e99d4a0f1dbd6ab9cebc906aa06ff2c21f95345.png)\n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.\n\n- The function $f(x)$ is not invertible on the interval $x\\in (-2,2).$ On this interval, some horizontal lines will intersect the curve more than once.\n\n![](images/a7/a71ce036adc5dc0b15fce9e367a0c8512699dc6a7814f4e9a1886696d2abad6e.png)\n\n- The function $f(x)$ is invertible on the intervals $x\\in [0,\\infty )$ and  $x\\in (-\\infty ,0].$ On these intervals, any horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](images/68/6858bd1fab8d9659c84fa941cd63ee9f509c8364dce0e753706c640ecfe6e9ec.png)\n\nTherefore, the correct answer is $x\\in [0,\\infty )$; $x\\in (-\\infty ,0]$ only."} {:db/id #edb/ref 17592186125196 :knowledge-point/_questions [{:db/id #edb/ref 17592186124474 :knowledge-point/id #uuid "149fa184-850f-52d8-a309-4b79a371a74d" :knowledge-point/title "Identifying the Intervals on Which a Function is Invertible Given a Description"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09a0484c-3bf3-547a-ac9e-662c11c6407f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438424} {:answer/id #uuid "6ab65fa6-d3bc-5f7c-91bd-73caca0fcd95" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438425}] :answer-field/correct {:answer/id #uuid "6ab65fa6-d3bc-5f7c-91bd-73caca0fcd95" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438425} :answer-field/id #uuid "30028ca6-c29b-51ed-af09-6b88025b44c3" :answer-field/key "$x\\in (-\\infty ,\\infty )$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439241} {:answer-field/choices [{:answer/id #uuid "a9b93f81-81c6-593b-a3d8-7d442e66fafb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438426} {:answer/id #uuid "2c402c3a-58a6-59c8-a229-20d0ef1effb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438427}] :answer-field/correct {:answer/id #uuid "2c402c3a-58a6-59c8-a229-20d0ef1effb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438427} :answer-field/id #uuid "0f6bf338-1e4e-5783-b25f-385d42279cae" :answer-field/key "$x\\in (-1,\\infty )$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439242} {:answer-field/choices [{:answer/id #uuid "fd1cef17-f883-5968-9f40-6254da05ef78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438428} {:answer/id #uuid "019d68a4-3d69-5257-8671-f80deae89182" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438429}] :answer-field/correct {:answer/id #uuid "019d68a4-3d69-5257-8671-f80deae89182" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438429} :answer-field/id #uuid "637c2a4f-d4ef-5b97-ae47-4358c0bec58d" :answer-field/key "$x\\in (-10,5)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439243}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c08528cd-5efd-5572-9af4-e4dc31c682da" :question/math-academy-id "q-66723" :question/problem "Given that $f(x)=x+1,$ on which of the following intervals is $f(x)$ invertible?\n\nSelect all that apply." :question/worked-solution "The function $f(x)$ is a linear function with slope $1$ and $y$-intercept $1,$ as shown below.\n\n![](images/00/00d6394343d441ee10fa20ee029b8f89b52ff1e6ded8e7fdbe0756118212f1a8.png)\n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.\n\n- The given function is invertible on the interval $x\\in (-\\infty ,\\infty ).$ On this interval, a horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n- Since the function is invertible on $x\\in (-\\infty ,\\infty ),$ it is also invertible on  $x\\in (-1,\\infty )$ and $x\\in (-10,5).$\n\nTherefore, the correct answer is $x\\in (-\\infty ,\\infty )$; $x\\in (-1,\\infty )$; $x\\in (-10,5)$."} {:db/id #edb/ref 17592186125215 :knowledge-point/_questions [{:db/id #edb/ref 17592186124634 :knowledge-point/id #uuid "69b456ea-44de-59f0-b2c8-bc5b9495974f" :knowledge-point/title "Identifying True Statements From a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8edf4398-806c-5b7c-8cca-451c1c85e2f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477395} {:answer/id #uuid "848c568e-ad22-5e10-bfab-6bc1193645b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477396}] :answer-field/correct {:answer/id #uuid "848c568e-ad22-5e10-bfab-6bc1193645b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477396} :answer-field/id #uuid "fdd4190d-d31a-5d8d-8d65-eb1058748103" :answer-field/key "$A$ is a boundary point of the set $M$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477667} {:answer-field/choices [{:answer/id #uuid "2ed8f22c-13e1-5da8-9a5d-47f257bc93d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477397} {:answer/id #uuid "ba03f66a-7846-546f-9a3b-a45c8353d1f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477398}] :answer-field/correct {:answer/id #uuid "2ed8f22c-13e1-5da8-9a5d-47f257bc93d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477397} :answer-field/id #uuid "e8285640-90a8-5d6a-8986-03e13675ddfe" :answer-field/key "$B$ is a boundary point of the set $M$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477668} {:answer-field/choices [{:answer/id #uuid "f2db774f-57ec-5bf9-85fb-fc0b16a6f005" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477399} {:answer/id #uuid "8a77e4e9-8637-58b0-9118-180e885d83ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477400}] :answer-field/correct {:answer/id #uuid "8a77e4e9-8637-58b0-9118-180e885d83ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477400} :answer-field/id #uuid "1e5c59fd-a6e3-5509-8c7c-036709638fa6" :answer-field/key "$C$ is an interior point of the set $M$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477669}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9e699ccb-274c-55bb-b36e-2ab5da35b953" :question/math-academy-id "q-71882" :question/problem "![](images/33/33d777f400b53d2272636fc9c465cf83c22932d8172c5d8a35bcdd2bdaae09a1.png)\n\nConsider the set $M,$ depicted by the shaded region above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nWith that in mind, let's examine the statements in turn.\n\n$$\n\n$$\n\n![](images/46/46670ef62c2afa2e5aa5c0eb4d1684493f35ab4f9a82aa5375994bf1cb2cb154.png)\n\n$$\n\n$$\n\n- Statement “$A$ is a boundary point of the set $M$” is true. Indeed, $A$ is a boundary point because every open neighborhood of $A$ contains points that belong to $M$ and points that do not belong to $M.$\n\n- Statement “$B$ is a boundary point of the set $M$” is false. The point $B$ is an interior point since there exists an open neighborhood of $B$ that is fully contained inside the set $M.$\n\n- Statement “$C$ is an interior point of the set $M$” is true. Indeed, $C$ is an interior point since there exists an open neighborhood of $C$ that is fully contained inside the set $M.$\n\nTherefore, the correct answer is '“$A$ is a boundary point of the set $M$” and “$C$ is an interior point of the set $M$” only'."} {:db/id #edb/ref 17592186125219 :knowledge-point/_questions [{:db/id #edb/ref 17592186124484 :knowledge-point/id #uuid "7eb09138-45df-5e6c-87af-772980ff7546" :knowledge-point/title "Verifying Properties Involving Vector Addition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0df63851-c8fb-51b9-8279-b9ce973db4c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448744} {:answer/id #uuid "72568caa-ec38-5729-8b60-8a6b3e4875c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448745}] :answer-field/correct {:answer/id #uuid "72568caa-ec38-5729-8b60-8a6b3e4875c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448745} :answer-field/id #uuid "cba615a8-a05c-5fd5-8da2-27773d6897c5" :answer-field/key "The zero-polynomial belongs to $U.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449412} {:answer-field/choices [{:answer/id #uuid "e82c59a4-3c39-5944-a925-1d794ff8047e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448746} {:answer/id #uuid "23723619-4476-5f35-911d-82bb0f2654bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448747}] :answer-field/correct {:answer/id #uuid "23723619-4476-5f35-911d-82bb0f2654bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448747} :answer-field/id #uuid "7e86d69e-421e-53ad-a7af-4aaf40021f6a" :answer-field/key "For any $p(x),q(x)\\in U,$ we have $p(x)+q(x)=q(x)+p(x).$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449413} {:answer-field/choices [{:answer/id #uuid "9158fa52-52e9-51bf-ab30-0f42a60a2390" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448748} {:answer/id #uuid "a4485828-ece1-56e1-a680-c31afec40344" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448749}] :answer-field/correct {:answer/id #uuid "9158fa52-52e9-51bf-ab30-0f42a60a2390" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448748} :answer-field/id #uuid "3115521c-39e0-515f-a130-cb432836d5b8" :answer-field/key "For any $p(x),q(x),r(x)\\in U,$ we have $[p(x)-q(x)]-r(x)=p(x)-[q(x)-r(x)].$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449414}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "73f62269-52b9-5341-87d2-165ee03b0821" :question/math-academy-id "q-74700" :question/problem "Let $U$ be the set of polynomials of the form $a{x}^{3},$ where $a\\in R.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's examine each statement in turn.\n\n- Statement “The zero-polynomial belongs to $U.$” is true. Indeed, the zero-polynomial can be represented as \n\n$$\n0=0\\cdot {x}^{3}.\n$$\n\n \nHence, $0\\in U.$\n\n- Statement “For any $p(x),q(x)\\in U,$ we have $p(x)+q(x)=q(x)+p(x).$” is true. Indeed, for any polynomials $p(x),q(x)\\in U,$ we obtain that \n\n$$\np(x)+q(x)=q(x)+p(x)\n$$\n\nsince polynomial addition is commutative.\n\n- Statement “For any $p(x),q(x),r(x)\\in U,$ we have $[p(x)-q(x)]-r(x)=p(x)-[q(x)-r(x)].$” is false. For example, consider polynomials $p(x)={x}^{3},$ $q(x)=2{x}^{3},$ and $r(x)=3{x}^{3}$ from $U.$ Then: \n\n$$\n\\begin{aligned}[p(x)-q(x)]-r(x) & =[{x}^{3}-2{x}^{3}]-3{x}^{3} \\\\  & =-{x}^{3}-3{x}^{3} \\\\  & =-4{x}^{3} \\\\ p(x)-[q(x)-r(x)] & ={x}^{3}-[2{x}^{3}-3{x}^{3}] \\\\  & ={x}^{3}-[-{x}^{3}] \\\\  & =2{x}^{3}\\end{aligned}\n$$\n\nHence, $[p(x)-q(x)]-r(x)\\ne p(x)-[q(x)-r(x)].$\n\nTherefore, the correct answer is “The zero-polynomial belongs to $U.$”; “For any $p(x),q(x)\\in U,$ we have $p(x)+q(x)=q(x)+p(x).$” only."} {:db/id #edb/ref 17592186125241 :knowledge-point/_questions [{:db/id #edb/ref 17592186124628 :knowledge-point/id #uuid "cb02b67c-90d9-5baf-b00e-590e9271d89e" :knowledge-point/title "Identifying Sets Closed Under Addition and Scalar Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25b2a47b-9608-5a9c-81d8-572c8ddc2c3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448798} {:answer/id #uuid "507b50d7-acfd-57b9-85f3-6bc67461578f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448799}] :answer-field/correct {:answer/id #uuid "25b2a47b-9608-5a9c-81d8-572c8ddc2c3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448798} :answer-field/id #uuid "4768fee6-061f-554b-a98c-8621dad645c8" :answer-field/key "$h(x)\\in U,$ where $h(x)=3x.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449439} {:answer-field/choices [{:answer/id #uuid "3d2621fa-431c-5b22-9de1-5f4cdfd376e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448800} {:answer/id #uuid "f8465186-49da-5e43-9f5b-1646effe487c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448801}] :answer-field/correct {:answer/id #uuid "f8465186-49da-5e43-9f5b-1646effe487c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448801} :answer-field/id #uuid "76f9486a-53df-5bd4-a5e4-9e31debd2b57" :answer-field/key "For any $p(x)\\in U$ and $k\\in R,$ we have $k\\cdot p(x)\\in U.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449440} {:answer-field/choices [{:answer/id #uuid "55fe2a27-3c8b-5f35-89d8-bf2fa57f292f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448802} {:answer/id #uuid "ceabca15-00e6-59a9-81a6-3801d410f03c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448803}] :answer-field/correct {:answer/id #uuid "ceabca15-00e6-59a9-81a6-3801d410f03c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448803} :answer-field/id #uuid "3915fcdf-ce82-5218-9d67-9bf94e282f77" :answer-field/key "The set is closed under scalar multiplication." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449441}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1d4d76d9-0c38-5edc-a8b9-c85d1bae32b3" :question/math-academy-id "q-94694" :question/problem "Let $U$ be the set of polynomials of the form $a{x}^{3},$ where $a\\in R.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's examine each of our statements in turn.\n\n- Statement “$h(x)\\in U,$ where $h(x)=3x.$” is false. The set $U$ contains only polynomials of the form $a{x}^{3},$ where $a$ is a real coefficient. However, $h(x)=3x$ is *not* a polynomial of this form. So, $h(x)\\notin U.$\n\n- Statement “For any $p(x)\\in U$ and $k\\in R,$ we have $k\\cdot p(x)\\in U.$” is true. Indeed, suppose $p(x)=a{x}^{3}\\in U,$ where $a$ is a real coefficient, and $k\\in R.$ Then,\n\n$$\nk\\cdot p(x)=k(a{x}^{3})=(ka){x}^{3}.\n$$\n\nSince $(ka)$ is a real coefficient, we conclude that $(ka){x}^{3}\\in U,$ i.e., $k\\cdot p(x)\\in U.$\n\n- Statement “The set is closed under scalar multiplication” is true. Since statement “For any $p(x)\\in U$ and $k\\in R,$ we have $k\\cdot p(x)\\in U.$” is true, the set is closed scalar multiplication.\n\nTherefore, the correct answer is “For any $p(x)\\in U$ and $k\\in R,$ we have $k\\cdot p(x)\\in U.$”; “The set is closed under scalar multiplication” only."} {:db/id #edb/ref 17592186125242 :knowledge-point/_questions [{:db/id #edb/ref 17592186124589 :knowledge-point/id #uuid "099e7caf-085a-5fd5-ad3d-1ebf189527b7" :knowledge-point/title "Verifying Properties Involving Scalar Multiplication and the Distributive Laws"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0f6fb82-50a8-5852-bf40-a37479778409" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448804} {:answer/id #uuid "9267a6f1-3504-5a32-96b0-ac1372955011" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448805}] :answer-field/correct {:answer/id #uuid "9267a6f1-3504-5a32-96b0-ac1372955011" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448805} :answer-field/id #uuid "84410673-cc05-5a6f-b9ee-75274828699f" :answer-field/key "The scalar multiplication of functions in $L$ is associative." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449442} {:answer-field/choices [{:answer/id #uuid "abad889d-1c90-5258-9739-fee99698474e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448806} {:answer/id #uuid "25dda0f1-64d9-5c8b-b93e-f7f8e89336b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448807}] :answer-field/correct {:answer/id #uuid "25dda0f1-64d9-5c8b-b93e-f7f8e89336b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448807} :answer-field/id #uuid "32ac74a8-70ee-5e3d-b945-366ffa92576a" :answer-field/key "For any $\\alpha ,\\beta \\in R$ and $f(x)\\in L,$ we have $(\\alpha +\\beta )f(x)=\\alpha f(x)+\\beta f(x).$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449443} {:answer-field/choices [{:answer/id #uuid "a729165e-39d5-598d-8061-7d0c6882ab7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448808} {:answer/id #uuid "84f6c2b7-2f40-5d2c-9188-36685b487210" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448809}] :answer-field/correct {:answer/id #uuid "84f6c2b7-2f40-5d2c-9188-36685b487210" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448809} :answer-field/id #uuid "2ed18b92-c4e7-57b6-b603-49203e853cfd" :answer-field/key "For any $\\alpha \\in R$ and any $f(x),g(x)\\in L,$ we have $\\alpha (f(x)+g(x))$ $=\\alpha f(x)+\\alpha g(x).$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449444}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bd415fe2-3ead-5cbb-88ba-59d9d1273317" :question/math-academy-id "q-94740" :question/problem "Let $L$ be the set of all functions from $(0,\\infty )$ to $R$ of the form $f(x)=a{log}_{2}⁡(x),$ where $a\\in R.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's examine each of our statements in turn.\n\n- Statement “The scalar multiplication of functions in $L$ is associative” is true. Indeed, for any $f(x)\\in L$ and for any fixed $x\\in (0,\\infty ),$ the result of $f(x)$ is just a real number. Thus, for any $\\alpha ,\\beta \\in R,$ we obtain that\n\n$$\n\\alpha (\\beta f(x))=(\\alpha \\beta )f(x).\n$$\n\n- Statement “For any $\\alpha ,\\beta \\in R$ and $f(x)\\in L,$ we have $(\\alpha +\\beta )f(x)=\\alpha f(x)+\\beta f(x).$” is true. Indeed, for any $f(x)\\in L$ and for any fixed $x\\in (0,\\infty ),$ the result of $f(x)$ is just a real number. Thus, for any $\\alpha ,\\beta \\in R,$ we obtain that\n\n$$\n(\\alpha +\\beta )f(x)=\\alpha f(x)+\\beta f(x).\n$$\n\n- Statement “For any $\\alpha \\in R$ and any $f(x),g(x)\\in L,$ we have $\\alpha (f(x)+g(x))=\\alpha f(x)+\\alpha g(x).$” is true. Indeed, for any $f(x)\\in L$ and for any fixed $x\\in (0,\\infty ),$ the result of $f(x)$ is just a real number. Thus, for any $\\alpha \\in R,$ we obtain that \n\n$$\n\\alpha (f(x)+g(x))=\\alpha f(x)+\\alpha g(x).\n$$\n\nTherefore, the correct answer is “The scalar multiplication of functions in $L$ is associative”; “For any $\\alpha ,\\beta \\in R$ and $f(x)\\in L,$ we have $(\\alpha +\\beta )f(x)=\\alpha f(x)+\\beta f(x).$”; “For any $\\alpha \\in R$ and any $f(x),g(x)\\in L,$ we have $\\alpha (f(x)+g(x))=\\alpha f(x)+\\alpha g(x).$”."} {:db/id #edb/ref 17592186125245 :knowledge-point/_questions [{:db/id #edb/ref 17592186124489 :knowledge-point/id #uuid "073042ee-d96d-5872-9681-ddcea43a2d37" :knowledge-point/title "Identifying True Statements About Sets of Vectors in a Matrix Vector Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed2276f6-5d75-5a69-b0bc-f4a1e24fe9c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448810} {:answer/id #uuid "93cb9988-66a4-50d6-9726-0a5d7e998d57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448811}] :answer-field/correct {:answer/id #uuid "ed2276f6-5d75-5a69-b0bc-f4a1e24fe9c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448810} :answer-field/id #uuid "c0c684a7-22c0-595c-9b32-c01b8d6684dd" :answer-field/key "$\\{\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}1 & 4 \\\\ 0 & -1\\end{bmatrix}\\}$ is a linearly independent set in ${\\text{M}}_{2}(R)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449445} {:answer-field/choices [{:answer/id #uuid "bac3a57e-ef20-5135-9b3b-d194a0f56262" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448812} {:answer/id #uuid "bd3dd845-da13-5283-b01f-cbfbd172fad0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448813}] :answer-field/correct {:answer/id #uuid "bd3dd845-da13-5283-b01f-cbfbd172fad0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448813} :answer-field/id #uuid "5b48f034-81a0-549e-8418-55ac1b638daa" :answer-field/key "$\\begin{bmatrix}3 & 12 \\\\ 0 & -3\\end{bmatrix}$ can be expressed as a linear combination of $\\{\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}1 & 4 \\\\ 0 & -1\\end{bmatrix}\\}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449446} {:answer-field/choices [{:answer/id #uuid "7892784a-7ee1-535f-9193-9224e0e39b99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448814} {:answer/id #uuid "90574907-f216-53b8-a272-7f11740a4c6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448815}] :answer-field/correct {:answer/id #uuid "7892784a-7ee1-535f-9193-9224e0e39b99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448814} :answer-field/id #uuid "669fcae5-5ea3-5f9d-8324-4f2e26028b7f" :answer-field/key "$\\{\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}1 & 4 \\\\ 0 & -1\\end{bmatrix}\\}$ is a basis of ${\\text{M}}_{2}(R)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449447}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cceedad6-c377-5d6a-a68c-beab3237c2c0" :question/math-academy-id "q-94866" :question/problem "Consider the vector space ${\\text{M}}_{2}(R)$ of all $2\\times 2$ matrices over $R.$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's examine each of the statements in turn.\n\n- Statement “$\\{\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}1 & 4 \\\\ 0 & -1\\end{bmatrix}\\}$ is a linearly independent set in ${\\text{M}}_{2}(R)$” is false. Notice that\n\n$$\n1\\cdot \\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}+0\\cdot \\begin{bmatrix}1 & 4 \\\\ 0 & -1\\end{bmatrix}=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}\n$$\n\nwhere the first coefficient is nonzero, so the set is linearly dependent. In general, any set that contains a zero-matrix is linearly dependent.\n\n- Statement “$\\begin{bmatrix}3 & 12 \\\\ 0 & -3\\end{bmatrix}$ can be expressed as a linear combination of $\\{\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}1 & 4 \\\\ 0 & -1\\end{bmatrix}\\}$” is true. Indeed,\n\n$$\n\\begin{bmatrix}3 & 12 \\\\ 0 & -3\\end{bmatrix}=0\\cdot \\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}+3\\cdot \\begin{bmatrix}1 & 4 \\\\ 0 & -1\\end{bmatrix}.\n$$\n\n- Statement “$\\{\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}1 & 4 \\\\ 0 & -1\\end{bmatrix}\\}$ is a basis of ${\\text{M}}_{2}(R)$” is false. Since the set is not linearly independent, it can't form a basis.\n\nTherefore, the correct answer is “$\\begin{bmatrix}3 & 12 \\\\ 0 & -3\\end{bmatrix}$ can be expressed as a linear combination of $\\{\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix},\\begin{bmatrix}1 & 4 \\\\ 0 & -1\\end{bmatrix}\\}$” only."} {:db/id #edb/ref 17592186125252 :knowledge-point/_questions [{:db/id #edb/ref 17592186124529 :knowledge-point/id #uuid "30d1a3a3-a6f0-522c-9161-6dc0fefb2e0d" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix and Rank-Nullity Theorems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cc28d24-2966-5404-9657-12db361e583f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448834} {:answer/id #uuid "8eb9ebe2-2b9f-520b-ae5c-3a3b086533b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448835}] :answer-field/correct {:answer/id #uuid "8cc28d24-2966-5404-9657-12db361e583f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448834} :answer-field/id #uuid "da7a49a0-682e-5485-8704-c21a8df81e3a" :answer-field/key "$\\text{rank}(A+2I)=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449457} {:answer-field/choices [{:answer/id #uuid "b8f791e7-bb86-5a9f-b7a4-d3cc7968a9bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448836} {:answer/id #uuid "d1d857bb-3ddc-59a7-a9e1-b62a1bf5bbc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448837}] :answer-field/correct {:answer/id #uuid "d1d857bb-3ddc-59a7-a9e1-b62a1bf5bbc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448837} :answer-field/id #uuid "979415cb-cf88-5d43-b613-b0e7364d110e" :answer-field/key "$A+2I$ is singular" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449458} {:answer-field/choices [{:answer/id #uuid "c4cb6286-7e1d-5d71-95bf-438c63766041" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448838} {:answer/id #uuid "c7255ac2-2e51-5f09-8fcc-64d6f0d0e25e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448839}] :answer-field/correct {:answer/id #uuid "c7255ac2-2e51-5f09-8fcc-64d6f0d0e25e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448839} :answer-field/id #uuid "4da59e2a-2004-5754-a752-61aa8752b4c9" :answer-field/key "$\\lambda =-2$ is an eigenvalue of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449459}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bef513f1-2d4e-54ff-9389-039c04a6d703" :question/math-academy-id "q-97051" :question/problem "If $A$ is a $3\\times 3$ matrix and $\\text{nullity}(A+2I)=2,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Given a $3\\times 3$ matrix $M,$ we have the following by the invertible matrix theorem:\n\n$M$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(M)={R}^{3} \\\\  & \\text{dim(Col}(M))=3=\\text{rank}(M) \\\\  & \\text{Null}(M)={0} \\\\  & \\text{dim(Null}(M))=0=\\text{nullity}(M)\\end{aligned}$\n\nAlso, according to the rank-nullity theorem, if $M$ has $3$ columns, then \n\n$$\n\\text{rank}(M)+\\text{nullity}(M)=3.\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement $\\text{rank}(A+2I)=2$ is false. According to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{rank}(A+2I) & =3-\\text{nullity}(A+2I) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$\n\n- Statements “$A+2I$ is singular” is true. By the invertible matrix theorem, since $\\text{nullity}(A+2I)\\ne 0,$ we obtain that $A+2I$ must be singular.\n\n- Statement “$\\lambda =-2$ is an eigenvalue of $A$” is true. Notice that if $M=A+2I$ is singular, then $(A+2I)x=0$ has nonzero solutions which will be eigenvectors of $A.$ As a result, $\\lambda =-2$ is an eigenvalue of $A.$\n\nTherefore, the correct answer is “$A+2I$ is singular”; “$\\lambda =-2$ is an eigenvalue of $A$” only."} {:db/id #edb/ref 17592186125258 :knowledge-point/_questions [{:db/id #edb/ref 17592186124605 :knowledge-point/id #uuid "c34e7d59-6bb4-5c2f-808f-212503d55338" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "beea7466-c41d-589d-865f-48504bd7909f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448852} {:answer/id #uuid "155e2c10-fe31-5b66-8f91-aef1c4a7653e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448853}] :answer-field/correct {:answer/id #uuid "beea7466-c41d-589d-865f-48504bd7909f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448852} :answer-field/id #uuid "14c928b0-156c-536e-bed2-6f5b5e4401fc" :answer-field/key "$A+I$ is a non-singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449466} {:answer-field/choices [{:answer/id #uuid "46813a85-d060-55df-bb6c-d675e5cbd606" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448854} {:answer/id #uuid "cd88e49f-fa58-5c5b-9e14-f03a5d794525" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448855}] :answer-field/correct {:answer/id #uuid "46813a85-d060-55df-bb6c-d675e5cbd606" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448854} :answer-field/id #uuid "b2f9766b-60ff-519d-951a-b93e45549f26" :answer-field/key "$\\text{Col}(A+I)={R}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449467} {:answer-field/choices [{:answer/id #uuid "92227e0d-7a0b-5d15-9e0d-3258bf7187f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448856} {:answer/id #uuid "069779b3-0176-5660-81d6-ff6ef90ecab8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448857}] :answer-field/correct {:answer/id #uuid "069779b3-0176-5660-81d6-ff6ef90ecab8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448857} :answer-field/id #uuid "46bf0043-aa6e-51a8-975c-6599d0da478c" :answer-field/key "$\\text{Null}(A+I)\\ne 0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449468}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b68a0678-9348-57e6-b4b3-d9e83bab09ed" :question/math-academy-id "q-97961" :question/problem "If $A$ is a $2\\times 2$ matrix and $\\lambda =-1$ is an eigenvalue of $A,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Given a $2\\times 2$ matrix $M,$ we have the following by the invertible matrix theorem:\n\n$M$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(M)={R}^{2} \\\\  & \\text{dim(Col}(M))=2=\\text{rank}(M) \\\\  & \\text{Null}(M)={0} \\\\  & \\text{dim(Null}(M))=0=\\text{nullity}(M)\\end{aligned}$\n\nLet's now apply the theorem to the matrix $M=A+I.$\n\n- Statement “$A+I$ is a non-singular matrix” is false. Notice that if $\\lambda =-1$ is an eigenvalue of $A,$ then the nonzero solutions of $(A+I)x=0$ are eigenvectors of $A.$ As a result, the matrix $M=A+I$ must be singular.\n\n- Statements $\\text{Col}(A+I)={R}^{2}$ is false. Since $M=A+I$ is singular, by the invertible matrix theorem, we obtain that\n\n$$\n\\text{Col}(A+I)\\ne {R}^{2}.\n$$\n\n- Statements $\\text{Null}(A+I)\\ne 0$ is true. Since $M=A+I$ is singular, by the invertible matrix theorem, we obtain that\n\n$$\n\\text{Null}(A+I)\\ne 0.\n$$\n\nTherefore, the correct answer is $\\text{Null}(A+I)\\ne 0$ only."} {:db/id #edb/ref 17592186125259 :knowledge-point/_questions [{:db/id #edb/ref 17592186124529 :knowledge-point/id #uuid "30d1a3a3-a6f0-522c-9161-6dc0fefb2e0d" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix and Rank-Nullity Theorems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27c0e1ab-fdc2-5768-b1ef-fb121a44d8c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477509} {:answer/id #uuid "de380f74-3fca-519b-867a-f0e67008d2e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477510}] :answer-field/correct {:answer/id #uuid "de380f74-3fca-519b-867a-f0e67008d2e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477510} :answer-field/id #uuid "d3258524-fdc6-53c6-bbcc-76e01ddb6edc" :answer-field/key "$\\text{Null}(C-5I)={0}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477724} {:answer-field/choices [{:answer/id #uuid "ef0ecbe8-cc59-5492-90d0-3d962ab63e98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477511} {:answer/id #uuid "679f3b09-0a22-58de-9792-601c8d391ab2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477512}] :answer-field/correct {:answer/id #uuid "ef0ecbe8-cc59-5492-90d0-3d962ab63e98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477511} :answer-field/id #uuid "9ee16b1d-ffdb-5b63-b376-cf42223f4b30" :answer-field/key "$C-5I$ is singular" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477725} {:answer-field/choices [{:answer/id #uuid "8170e32c-1075-5f7b-b9bc-b57335a6d09d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477513} {:answer/id #uuid "ae8d7101-86f6-5fbb-8883-6d5c4b920ead" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477514}] :answer-field/correct {:answer/id #uuid "8170e32c-1075-5f7b-b9bc-b57335a6d09d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477513} :answer-field/id #uuid "52e06b12-0373-5de0-95a6-c2db0f62e210" :answer-field/key "$\\lambda =5$ is an eigenvalue of $C$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477726}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "72b961d6-3f11-54e6-b3ea-21ca6cd541b5" :question/math-academy-id "q-97974" :question/problem "If $C$ is a $3\\times 3$ matrix and $\\text{rank}(C-5I)=3,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Given a $3\\times 3$ matrix $M,$ we have the following by the invertible matrix theorem:\n\n$M$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(M)={R}^{3} \\\\  & \\text{dim(Col}(M))=3=\\text{rank}(M) \\\\  & \\text{Null}(M)={0} \\\\  & \\text{dim(Null}(M))=0=\\text{nullity}(M)\\end{aligned}$\n\nAlso, according to the rank-nullity theorem, if $M$ has $3$ columns, then \n\n$$\n\\text{rank}(M)+\\text{nullity}(M)=3.\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement $\\text{Null}(C-5I)={0}$ is true. According to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(C-5I) & =3-\\text{rank}(C-5I) \\\\  & =3-3 \\\\  & =0.\\end{aligned}\n$$\n\nAs a result, $\\text{Null}(C-5I)={0}.$\n\n- Statements “$C-5I$ is singular” is false. By the invertible matrix theorem, since $\\text{nullity}(C-5I)=0,$ we obtain that $C-5I$ must be non-singular.\n\n- Statement “$\\lambda =5$ is an eigenvalue of $C$” is false. Notice that if $M=C-5I$ is non-singular, then $(C-5I)x=0$ has only zero solution.  As a result, $\\lambda =5$ can not be an eigenvalue of $C.$\n\nTherefore, the correct answer is $\\text{Null}(C-5I)={0}$ only."} {:db/id #edb/ref 17592186129567 :knowledge-point/_questions [{:db/id #edb/ref 17592186129287 :knowledge-point/id #uuid "b4ade459-9aba-5520-95d3-69ef3fd62d9d" :knowledge-point/title "Classifying Recurrence Relations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "626de4c7-07ee-5308-9a23-934777925783" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459757} {:answer/id #uuid "4ec59719-d576-5c4b-9f37-7da5426c5edd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459758}] :answer-field/correct {:answer/id #uuid "626de4c7-07ee-5308-9a23-934777925783" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459757} :answer-field/id #uuid "48acc387-a54c-50dd-aad6-585cf72b6a89" :answer-field/key "${a}_{n}=2{a}_{n-2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460745} {:answer-field/choices [{:answer/id #uuid "59438dcb-5098-5a37-8a8a-0559a266526d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459759} {:answer/id #uuid "c7ea72a8-0138-57f7-8d42-142ef14c07ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459760}] :answer-field/correct {:answer/id #uuid "59438dcb-5098-5a37-8a8a-0559a266526d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459759} :answer-field/id #uuid "340a7483-0648-538f-9e0e-c1dca3ac2efa" :answer-field/key "${b}_{n}={b}_{n-1}^{2}+2{b}_{n-2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460746} {:answer-field/choices [{:answer/id #uuid "d03f0076-7577-5d1b-bc3c-65d3e9f63200" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459761} {:answer/id #uuid "9b564c41-c975-557e-aaba-25711bc033d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459762}] :answer-field/correct {:answer/id #uuid "9b564c41-c975-557e-aaba-25711bc033d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459762} :answer-field/id #uuid "6d8ad94a-27a7-5b22-9374-cccd6a4e4e54" :answer-field/key "${c}_{n}=2{c}_{n-1}+n$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460747}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "13864329-1fa0-567c-b5b4-57dd540d6c9f" :question/math-academy-id "q-253143" :question/problem "Which of the following recurrence relations are first-order?\n\nSelect all that apply." :question/worked-solution "The order of a recurrence relation is the largest index difference between ${a}_{n}$ and the preceding terms in the relation.\n\nLet's examine each recurrence relation in turn.\n\n- The largest index difference between ${a}_{n}$ and the preceding term ${a}_{n-2}$ in the relation is $2.$ So, this recurrence relation has order $2.$\n\n- The largest index difference between ${b}_{n}$ and the preceding terms ${b}_{n-1}$ and ${b}_{n-2}$ in the relation is $2.$ So, this recurrence relation has order $2.$\n\n- The largest index difference between ${c}_{n}$ and the preceding term ${c}_{n-1}$ in the relation is $1.$ So, this recurrence relation has order $1.$\n\nTherefore, the correct answer is ${c}_{n}=2{c}_{n-1}+n$ only."} {:db/id #edb/ref 17592186129640 :knowledge-point/_questions [{:db/id #edb/ref 17592186129213 :knowledge-point/id #uuid "434a82c2-7964-525a-85b9-eb17fa7b5b26" :knowledge-point/title "Identifying Connections Between Matrices of a Linear Transformation Relative to Different Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03a7c2b7-b4a3-5168-84dc-aab27f106193" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448614} {:answer/id #uuid "2902f1ff-cac7-5d97-a5a9-24543413f25f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448615}] :answer-field/correct {:answer/id #uuid "2902f1ff-cac7-5d97-a5a9-24543413f25f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448615} :answer-field/id #uuid "918a8f88-e411-59fb-b196-0dadf7f4fcbc" :answer-field/key "$[T]_{C}={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449347} {:answer-field/choices [{:answer/id #uuid "533a5b8f-639e-5a45-8484-cb33ae7d5e46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448616} {:answer/id #uuid "e69f24f0-07c6-5983-ac28-bd000fd09e27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448617}] :answer-field/correct {:answer/id #uuid "533a5b8f-639e-5a45-8484-cb33ae7d5e46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448616} :answer-field/id #uuid "54d6a6ae-1fa2-556d-9175-9c73166225ee" :answer-field/key "$[T]_{C}={P}_{B\\to C}^{-1}\\cdot [T]_{B}\\cdot {P}_{B\\to C}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449348} {:answer-field/choices [{:answer/id #uuid "c2c7db1c-97d8-53db-84ae-5422607ceccf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448618} {:answer/id #uuid "3c254231-3e39-568b-8359-80c766da4887" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448619}] :answer-field/correct {:answer/id #uuid "3c254231-3e39-568b-8359-80c766da4887" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448619} :answer-field/id #uuid "db2048e9-209c-59b8-a528-935ef72da977" :answer-field/key "$[T]_{B}={P}_{B\\to C}^{-1}\\cdot [T]_{C}\\cdot {P}_{B\\to C}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449349}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4a7452af-fe2e-5944-8a03-a396c12645a4" :question/math-academy-id "q-38360" :question/problem "Let $[T]_{B}$ and $[T]_{C}$ be the matrices of a linear transformation $T$ relative to the bases $B$ and $C,$ respectively. If ${P}_{B\\to C}$ is the change-of-coordinates matrix from basis $B$ to basis $C,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "The connection between the matrices of our linear transformation $T$ relative to the bases $B$ and $C$ is given by the following diagram:\n\n![](images/1b/1b81504d6fdcabee0e1f586fef3dd2af5a57a8411ba4d22429e00e09b171a4d1.png)\n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{C}={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1},\n$$\n\nwhere ${P}_{B\\to C}$ is the change-of-coordinates matrix from $B$ to $C.$\n\nSolving this equation for $[T]_{B},$ we obtain the alternative formulation\n\n$$\n[T]_{B}={P}_{B\\to C}^{-1}\\cdot [T]_{C}\\cdot {P}_{B\\to C}.\n$$\n\nTherefore, the correct answer is $[T]_{C}={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1}$; $[T]_{B}={P}_{B\\to C}^{-1}\\cdot [T]_{C}\\cdot {P}_{B\\to C}$ only."} {:db/id #edb/ref 17592186129659 :knowledge-point/_questions [{:db/id #edb/ref 17592186129321 :knowledge-point/id #uuid "359bc41e-1b6d-5177-9642-4f8697bc5ba0" :knowledge-point/title "Identifying Rotation-Scaling Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "562f2805-9f09-5e89-b09c-94c4809435a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459909} {:answer/id #uuid "feaa5d1c-ea0d-51b8-a656-0e78ecb7f2db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459910}] :answer-field/correct {:answer/id #uuid "feaa5d1c-ea0d-51b8-a656-0e78ecb7f2db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459910} :answer-field/id #uuid "743ed65d-70d0-5027-9c43-b6b316cce648" :answer-field/key "$A=\\begin{bmatrix}2 & -5 \\\\ 5 & 2\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460821} {:answer-field/choices [{:answer/id #uuid "b08d56f9-5c6e-5427-8ac8-973f2cb2c0d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459911} {:answer/id #uuid "f842c9c8-bda5-5681-b9c2-ac48835e9445" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459912}] :answer-field/correct {:answer/id #uuid "b08d56f9-5c6e-5427-8ac8-973f2cb2c0d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459911} :answer-field/id #uuid "21401d46-cadc-5ebc-9505-4a1961e95c21" :answer-field/key "$B=\\begin{bmatrix}2 & -1 \\\\ -1 & 2\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460822} {:answer-field/choices [{:answer/id #uuid "535db015-38fb-51e0-b841-97ef9b67c6f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459913} {:answer/id #uuid "bac13582-2752-58d1-a164-33571b4f5329" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459914}] :answer-field/correct {:answer/id #uuid "bac13582-2752-58d1-a164-33571b4f5329" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459914} :answer-field/id #uuid "681d3363-4bb9-5097-bd6c-7727036faa45" :answer-field/key "$C=\\begin{bmatrix}-3 & 2 \\\\ -2 & -3\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460823}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d3837446-5faf-5668-beb3-7a2ca40df6bb" :question/math-academy-id "q-38517" :question/problem "Which of the following are rotation-scaling matrices?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A rotation-scaling matrix has the form \n\n$$\n\\begin{bmatrix}a & -b \\\\ b & a\\end{bmatrix},\n$$\n\n where $a$ and $b$ are real numbers that are not equal to zero simultaneously. Notice that the entries on the main diagonal are the same, while the antidiagonal entries have opposite signs.\n\nWith that in mind let's check each of the given matrices:\n\n- $A=\\begin{bmatrix}2 & -5 \\\\ 5 & 2\\end{bmatrix}$ is a rotation-scaling matrix.\n\n- $B=\\begin{bmatrix}2 & -1 \\\\ -1 & 2\\end{bmatrix}$ is *not* a rotation-scaling matrix since the entries on the antidiagonal do not have opposite signs.\n\n- $C=\\begin{bmatrix}-3 & 2 \\\\ -2 & -3\\end{bmatrix}$ is a rotation-scaling matrix.\n\nIn conclusion, the correct answer is $A=\\begin{bmatrix}2 & -5 \\\\ 5 & 2\\end{bmatrix}$; $C=\\begin{bmatrix}-3 & 2 \\\\ -2 & -3\\end{bmatrix}$ only."} {:db/id #edb/ref 17592186129679 :knowledge-point/_questions [{:db/id #edb/ref 17592186129148 :knowledge-point/id #uuid "34aa8f4e-20f1-5dda-ac53-6eb411543897" :knowledge-point/title "Identifying True Statements Regarding the Graph of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ebe3aa89-50b5-5440-b422-36d3f9494ea5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459927} {:answer/id #uuid "77bdf90f-936c-580b-899e-22e46c0d53e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459928}] :answer-field/correct {:answer/id #uuid "ebe3aa89-50b5-5440-b422-36d3f9494ea5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459927} :answer-field/id #uuid "3046a163-3bcd-5cb9-a94b-08ebd4453395" :answer-field/key "$P(x)\\to \\infty $ as $x\\to -\\infty .$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460830} {:answer-field/choices [{:answer/id #uuid "508e53ae-e134-512f-b27b-b96ca4e480a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459929} {:answer/id #uuid "741e2816-ff2d-5883-bb18-3878c76ebfbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459930}] :answer-field/correct {:answer/id #uuid "508e53ae-e134-512f-b27b-b96ca4e480a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459929} :answer-field/id #uuid "ad65cebe-cec5-5397-8222-8afa8191fa31" :answer-field/key "The degree of $P(x)$ is odd." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460831} {:answer-field/choices [{:answer/id #uuid "8dc3bca8-7a14-57a9-af87-1a8aaf0f5a4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459931} {:answer/id #uuid "49aea637-2b1d-526e-9450-5878abfa1b32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459932}] :answer-field/correct {:answer/id #uuid "49aea637-2b1d-526e-9450-5878abfa1b32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459932} :answer-field/id #uuid "74ad5248-f9d9-5ba0-b7d5-e77a1fcce3af" :answer-field/key "The coefficient of the leading term is negative." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460832}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7f40578d-2e88-5fde-bb73-48381fd621fe" :question/math-academy-id "q-38617" :question/problem "![](images/fb/fb4959f437e11b767be136a2a024260d45ed29805cd57b1832d74d7cc2da11c1.png)\n\nThe graph of a polynomial $y=P(x)$ is shown above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "The end behavior of $P(x)$ is\n\n- $P(x)\\to -\\infty $ as $x\\to -\\infty ,$ and\n\n- $P(x)\\to -\\infty $ as $x\\to \\infty .$\n\nConsequently, \n\n- the degree of $P(x)$ is even, and\n\n- the leading coefficient of $P(x)$ is negative.\n\nTherefore, statements “$P(x)\\to \\infty $ as $x\\to -\\infty .$” and “The degree of $P(x)$ is odd” are false, while statement “The coefficient of the leading term is negative” is true."} {:db/id #edb/ref 17592186129698 :knowledge-point/_questions [{:db/id #edb/ref 17592186129154 :knowledge-point/id #uuid "a66188f6-3228-59e9-9766-0f9bacbe8443" :knowledge-point/title "Identifying True Statements Regarding the Graph of a Given Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e76d3042-f7ae-57ef-b396-eb6626b7976b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439667} {:answer/id #uuid "2a530406-e55f-5a02-bcae-6dda607cc6d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439668}] :answer-field/correct {:answer/id #uuid "2a530406-e55f-5a02-bcae-6dda607cc6d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439668} :answer-field/id #uuid "6d4c09b8-af08-5b44-aa99-0093f513761c" :answer-field/key "$x = 2$ is a root of even multiplicity." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440191} {:answer-field/choices [{:answer/id #uuid "0c2050e7-dbe2-5d05-86f9-06cb01ed3583" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439669} {:answer/id #uuid "39f80e33-1da7-5439-9b91-357f2d0f3496" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439670}] :answer-field/correct {:answer/id #uuid "39f80e33-1da7-5439-9b91-357f2d0f3496" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439670} :answer-field/id #uuid "8b11cd7d-37b5-5212-9ef6-22f0c845c9c6" :answer-field/key "$x = ± 1$ are roots of odd multiplicity." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440192} {:answer-field/choices [{:answer/id #uuid "abb18603-78f7-50e8-be5d-ea5aa74811ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439671} {:answer/id #uuid "bdfff5d6-10ab-57f7-a5b3-5fa3c88e84c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439672}] :answer-field/correct {:answer/id #uuid "abb18603-78f7-50e8-be5d-ea5aa74811ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439671} :answer-field/id #uuid "299234ca-1b77-5fea-b8e4-a49cfd0e7ccb" :answer-field/key "$p(0) = 2$." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440193}] :question/id #uuid "01c0cb00-762a-57c6-9d3d-dec1ec64cc03" :question/math-academy-id "q-38762" :question/problem "![](images/dc/dc2079e479351c8d0193961138aeb4dabd4689426c3e621668f314eb8445258f.png)\n\nThe graph of a polynomial $p(x)$ is shown above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "At x=2 the curve touches and turns at the x-axis (even multiplicity). At x=-1 and x=1 it crosses (odd multiplicity). The y-intercept is below zero, so p(0)=2 is false."} {:db/id #edb/ref 17592186129699 :knowledge-point/_questions [{:db/id #edb/ref 17592186129154 :knowledge-point/id #uuid "a66188f6-3228-59e9-9766-0f9bacbe8443" :knowledge-point/title "Identifying True Statements Regarding the Graph of a Given Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a81dde9d-7e4f-5cbc-8930-a85852a7afde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439673} {:answer/id #uuid "0c6f74a9-acf9-5646-99cd-d