5cb-b186-c1d21190ea48" :question/math-academy-id "q-98369" :question/problem "Which of the following numbers are integers?\n\nSelect all that apply." :question/worked-solution "The integers consist of all positive and negative whole numbers and zero.\n\n$$\n…,-3,\\,-2,\\,-1,\\,0,\\,1,\\,2,\\,3,…\n$$\n\n \n\nOf the given numbers, $-3$ and $5$ are integers, but $\\frac{3}{2}$ is not.\n\nTherefore, the correct answer is “The number $-3$”; “The number $5$” only."} {:db/id #edb/ref 17592186433610 :knowledge-point/_questions [{:db/id #edb/ref 17592186152125 :knowledge-point/id #uuid "ebf3f930-2768-5399-8470-48ac430065a3" :knowledge-point/title "Classifying Numbers as Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf08aba8-f0da-51fd-ad95-8655627dd121" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186475014} {:answer/id #uuid "7d0aa0db-a2a7-5129-a388-9c57ac3f39d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186475015}] :answer-field/correct {:answer/id #uuid "7d0aa0db-a2a7-5129-a388-9c57ac3f39d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186475015} :answer-field/id #uuid "227c914e-b720-542d-b308-cc175cdab060" :answer-field/key "The number $100$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475433} {:answer-field/choices [{:answer/id #uuid "99c304dc-b34a-561c-b8ce-39248e0e4792" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186475016} {:answer/id #uuid "6c28208b-ec2d-5048-a2a3-e8269f75cacc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186475017}] :answer-field/correct {:answer/id #uuid "6c28208b-ec2d-5048-a2a3-e8269f75cacc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186475017} :answer-field/id #uuid "b16204db-52e8-540f-a01c-bb228b5f48f6" :answer-field/key "The number $-5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475434} {:answer-field/choices [{:answer/id #uuid "dbd0222f-711f-5ac3-96b9-d66574a77070" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186475018} {:answer/id #uuid "63cd09e1-6bb0-5cf1-8595-a1e09adda1ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186475019}] :answer-field/correct {:answer/id #uuid "dbd0222f-711f-5ac3-96b9-d66574a77070" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186475018} :answer-field/id #uuid "0073c129-f377-5688-a949-462c8471b3d9" :answer-field/key "$-\\frac{9}{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475435}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eb2e9e07-c134-569e-a208-041621377fa3" :question/math-academy-id "q-99311" :question/problem "Which of the following numbers are integers?\n\nSelect all that apply." :question/worked-solution "The integers consist of all positive and negative whole numbers and zero.\n\n$$\n…,-3,\\,-2,\\,-1,\\,0,\\,1,\\,2,\\,3,…\n$$\n\n \n\nOf the given numbers, $100$ and $-5$ are integers, but $-\\frac{9}{2}$ is not.\n\nTherefore, the correct answer is “The number $100$”; “The number $-5$” only."} {:db/id #edb/ref 17592186433715 :knowledge-point/_questions [{:db/id #edb/ref 17592186152226 :knowledge-point/id #uuid "76e60bc4-ae61-5c39-ad80-14e0cdab14da" :knowledge-point/title "Identifying Generalized Eigenvectors of a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3776bd7-7901-5119-8781-5fa760852de9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474248} {:answer/id #uuid "34be4cdd-980d-5cf7-afb5-69444aae9cf2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474249}] :answer-field/correct {:answer/id #uuid "b3776bd7-7901-5119-8781-5fa760852de9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474248} :answer-field/id #uuid "6957b9f5-0c7f-5370-ba38-a21eb5e797aa" :answer-field/key "$v$ is an eigenvector corresponding to the eigenvalue $\\lambda =2$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475050} {:answer-field/choices [{:answer/id #uuid "3467e4a5-c790-515b-90e9-e9524b6b5643" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474250} {:answer/id #uuid "b70cee36-191b-582b-b0d3-c85411adf943" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474251}] :answer-field/correct {:answer/id #uuid "3467e4a5-c790-515b-90e9-e9524b6b5643" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474250} :answer-field/id #uuid "d6d9e9f8-9da1-55b6-8112-a9793448ac85" :answer-field/key "$v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =2$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475051} {:answer-field/choices [{:answer/id #uuid "95bccbcb-3a47-5abe-9fa0-82e49506d42a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474252} {:answer/id #uuid "270c3557-fa11-5a21-934d-4213ed1483bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474253}] :answer-field/correct {:answer/id #uuid "270c3557-fa11-5a21-934d-4213ed1483bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474253} :answer-field/id #uuid "0801da56-074b-503c-9458-9eeace399eb8" :answer-field/key "$v$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =2$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475052}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "72a34fdf-b3e5-500c-96f3-76e3e66d1191" :question/math-academy-id "q-109572" :question/problem "$$\nA=\\begin{bmatrix}1 & 1 & -1 \\\\ 2 & 4 & -2 \\\\ 3 & 1 & 1\\end{bmatrix},\\,v=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A *generalized eigenvector* ${v}_{n}$ of rank $n$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{n}\\overset{A-\\lambda I\\,}{\\to }{v}_{n-1}\\overset{A-\\lambda I\\,}{\\to }…\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{n-1},{v}_{n-2},…,{v}_{1}\\ne 0.$ An *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nFirst, we compute $A-2I:$\n\n$$\nA-2I=\\begin{bmatrix}1 & 1 & -1 \\\\ 2 & 4 & -2 \\\\ 3 & 1 & 1\\end{bmatrix}-2\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}-1 & 1 & -1 \\\\ 2 & 2 & -2 \\\\ 3 & 1 & -1\\end{bmatrix}\n$$\n\n- Next, we find the image of $v$ under the action of $A-2I:$\n\n$$\n(A-2I)v=\\begin{bmatrix}-1 & 1 & -1 \\\\ 2 & 2 & -2 \\\\ 3 & 1 & -1\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}=\\underbrace{\\begin{bmatrix}-2 \\\\ 0 \\\\ 2\\end{bmatrix}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector, we now compute the image of $w$ under the action of $A-2I:$\n\n$$\n(A-2I)w=\\begin{bmatrix}-1 & 1 & -1 \\\\ 2 & 2 & -2 \\\\ 3 & 1 & -1\\end{bmatrix}\\begin{bmatrix}-2 \\\\ 0 \\\\ 2\\end{bmatrix}=\\underbrace{\\begin{bmatrix}0 \\\\ -8 \\\\ -8\\end{bmatrix}}_{x}\\ne 0\n$$\n\n- Again, since we got a nonzero vector in the last step, we now compute the image of $x$ under the action of $A-2I:$\n\n$$\n(A-2I)x=\\begin{bmatrix}-1 & 1 & -1 \\\\ 2 & 2 & -2 \\\\ 3 & 1 & -1\\end{bmatrix}\\begin{bmatrix}0 \\\\ -8 \\\\ -8\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n\\underbrace{\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}}_{v}\\overset{A-2I\\,}{\\to }\\underbrace{\\begin{bmatrix}-2 \\\\ 0 \\\\ 2\\end{bmatrix}}_{w}\\overset{A-2I\\,}{\\to }\\underbrace{\\begin{bmatrix}0 \\\\ -8 \\\\ -8\\end{bmatrix}}_{x}\\overset{A-2I\\,}{\\to }\\underbrace{\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}}_{0}\n$$\n\nHere, we see that $A-2I$ maps $v$ to $0$ in $3$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =2$ of $A.$*\n\nSo, the correct answer is “$v$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =2$ of $A$” only."} {:db/id #edb/ref 17592186433716 :knowledge-point/_questions [{:db/id #edb/ref 17592186152224 :knowledge-point/id #uuid "a0abad78-e492-5d09-a04d-bce54605c78c" :knowledge-point/title "Identifying Generalized Eigenvectors of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5a59325-3ce6-5d72-900a-a6549e6f35ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453270} {:answer/id #uuid "63399f97-f600-5b4d-9277-9004f25d5b6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453271}] :answer-field/correct {:answer/id #uuid "63399f97-f600-5b4d-9277-9004f25d5b6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453271} :answer-field/id #uuid "fb03ed9d-b3dd-5132-bfbe-ccb2df04fee2" :answer-field/key "$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =1$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454385} {:answer-field/choices [{:answer/id #uuid "e287c0dd-d035-550b-872f-c7e895e3bec9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453272} {:answer/id #uuid "1b26befe-fc8e-5235-b353-9ac88f6dbda5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453273}] :answer-field/correct {:answer/id #uuid "e287c0dd-d035-550b-872f-c7e895e3bec9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453272} :answer-field/id #uuid "fa43db2a-05ff-5509-a48a-142c9a76be13" :answer-field/key "$v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =1$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454386} {:answer-field/choices [{:answer/id #uuid "8d868348-18f3-58da-a6ed-45e73067cd1f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453274} {:answer/id #uuid "3e88ff03-d431-5fab-aefd-9a60f1450262" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453275}] :answer-field/correct {:answer/id #uuid "8d868348-18f3-58da-a6ed-45e73067cd1f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453274} :answer-field/id #uuid "78734bd9-b0b4-5000-8278-6ecd43210da2" :answer-field/key "$v$ is an eigenvector corresponding to the eigenvalue $\\lambda =1$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454387}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "93f4dbff-c62f-571f-9c49-e5503854925a" :question/math-academy-id "q-109518" :question/problem "$$\nA=\\begin{bmatrix}3 & -1 \\\\ 4 & -1\\end{bmatrix},\\,v=\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A-I:$\n\n$$\nA-I=\\begin{bmatrix}3 & -1 \\\\ 4 & -1\\end{bmatrix}-\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}2 & -1 \\\\ 4 & -2\\end{bmatrix}\n$$\n\n- Next, we find the image of $v$ under the action of $A-I:$\n\n$$\n(A-I)v=\\begin{bmatrix}2 & -1 \\\\ 4 & -2\\end{bmatrix}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}=\\underbrace{\\begin{bmatrix}3 \\\\ 6\\end{bmatrix}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A-I:$\n\n$$\n(A-I)w=\\begin{bmatrix}2 & -1 \\\\ 4 & -2\\end{bmatrix}\\begin{bmatrix}3 \\\\ 6\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n\\underbrace{\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}}_{v}\\overset{A-I\\,}{\\to }\\underbrace{\\begin{bmatrix}3 \\\\ 6\\end{bmatrix}}_{w}\\overset{A-I\\,}{\\to }\\underbrace{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{0}\n$$\n\nHere, we see that $A-I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =1$ of $A.$*\n\nSo, the correct answer is “$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =1$ of $A$” only."} {:db/id #edb/ref 17592186433717 :knowledge-point/_questions [{:db/id #edb/ref 17592186152224 :knowledge-point/id #uuid "a0abad78-e492-5d09-a04d-bce54605c78c" :knowledge-point/title "Identifying Generalized Eigenvectors of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18f449b2-97f3-5186-9bd0-39c537f7db13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453258} {:answer/id #uuid "54696726-fb68-57c0-87f4-c1694ab455cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453259}] :answer-field/correct {:answer/id #uuid "18f449b2-97f3-5186-9bd0-39c537f7db13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453258} :answer-field/id #uuid "bd1d85c6-553b-53a4-ae23-7dde028774d2" :answer-field/key "$v$ is an eigenvector corresponding to the eigenvalue $\\lambda =-1$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454379} {:answer-field/choices [{:answer/id #uuid "7e95d9b3-3929-5758-b2da-baceb16ae7ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453260} {:answer/id #uuid "17170d1b-c8fc-5d71-914c-a2fc83b964c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453261}] :answer-field/correct {:answer/id #uuid "17170d1b-c8fc-5d71-914c-a2fc83b964c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453261} :answer-field/id #uuid "383e95fb-9e75-52f9-b9dc-633a9fc9d7e7" :answer-field/key "$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-1$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454380} {:answer-field/choices [{:answer/id #uuid "1da26d3c-84b5-5484-b149-e445d8e96bd6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453262} {:answer/id #uuid "7d6fbae8-8f80-5d45-a5a9-59b416b697f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453263}] :answer-field/correct {:answer/id #uuid "1da26d3c-84b5-5484-b149-e445d8e96bd6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453262} :answer-field/id #uuid "f5175e83-6e25-5458-92b9-9cb792d53159" :answer-field/key "$v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =-1$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454381}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a3d67809-78b0-59dc-9828-ea082eca69bb" :question/math-academy-id "q-109476" :question/problem "$$\nA=\\begin{bmatrix}-2 & 1 \\\\ -1 & 0\\end{bmatrix},\\,v=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A+I:$\n\n$$\nA+I=\\begin{bmatrix}-2 & 1 \\\\ -1 & 0\\end{bmatrix}+\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-1 & 1 \\\\ -1 & 1\\end{bmatrix}\n$$\n\n- Next, we find the image of $v$ under the action of $A+I:$\n\n$$\n(A+I)v=\\begin{bmatrix}-1 & 1 \\\\ -1 & 1\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}=\\underbrace{\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A+I:$\n\n$$\n(A+I)w=\\begin{bmatrix}-1 & 1 \\\\ -1 & 1\\end{bmatrix}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n\\underbrace{\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}}_{v}\\overset{A+I\\,}{\\to }\\underbrace{\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}}_{w}\\overset{A+I\\,}{\\to }\\underbrace{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{0}\n$$\n\nHere, we see that $A+I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-1$ of $A.$*\n\nSo, the correct answer is “$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-1$ of $A$” only."} {:db/id #edb/ref 17592186433718 :knowledge-point/_questions [{:db/id #edb/ref 17592186152224 :knowledge-point/id #uuid "a0abad78-e492-5d09-a04d-bce54605c78c" :knowledge-point/title "Identifying Generalized Eigenvectors of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41150d82-d7e7-5d1b-9511-2a172cd9b18f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453264} {:answer/id #uuid "b718a973-f38a-5035-869e-48e4b419ff1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453265}] :answer-field/correct {:answer/id #uuid "b718a973-f38a-5035-869e-48e4b419ff1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453265} :answer-field/id #uuid "ae0413b7-8327-5a24-870c-2079b9d12010" :answer-field/key "$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-1$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454382} {:answer-field/choices [{:answer/id #uuid "4f23e036-9539-557b-a5b3-9d3a82621232" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453266} {:answer/id #uuid "41f4de42-fb54-53fa-9a8d-2338942ae501" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453267}] :answer-field/correct {:answer/id #uuid "4f23e036-9539-557b-a5b3-9d3a82621232" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453266} :answer-field/id #uuid "f297c7e5-5df0-59e8-9f0a-749e59ee56d6" :answer-field/key "$v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =-1$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454383} {:answer-field/choices [{:answer/id #uuid "0bb3db82-5aae-5e9e-9a87-27b9cef5d582" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453268} {:answer/id #uuid "7ae4e359-d368-5e98-b9be-49032667862f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453269}] :answer-field/correct {:answer/id #uuid "0bb3db82-5aae-5e9e-9a87-27b9cef5d582" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453268} :answer-field/id #uuid "ddde4964-61ba-58e1-b946-d0bdaa59754b" :answer-field/key "$v$ is an eigenvector corresponding to the eigenvalue $\\lambda =-1$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454384}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ab77c5c3-a1c5-5710-a08d-82e66f9fdecd" :question/math-academy-id "q-109488" :question/problem "$$\nA=\\begin{bmatrix}3 & -8 \\\\ 2 & -5\\end{bmatrix},\\,v=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A+I:$\n\n$$\nA+I=\\begin{bmatrix}3 & -8 \\\\ 2 & -5\\end{bmatrix}+\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}4 & -8 \\\\ 2 & -4\\end{bmatrix}\n$$\n\n- Next, we find the image of $v$ under the action of $A+I:$\n\n$$\n(A+I)v=\\begin{bmatrix}4 & -8 \\\\ 2 & -4\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}=\\underbrace{\\begin{bmatrix}4 \\\\ 2\\end{bmatrix}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A+I:$\n\n$$\n(A+I)w=\\begin{bmatrix}4 & -8 \\\\ 2 & -4\\end{bmatrix}\\begin{bmatrix}4 \\\\ 2\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n\\underbrace{\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}}_{v}\\overset{A+I\\,}{\\to }\\underbrace{\\begin{bmatrix}4 \\\\ 2\\end{bmatrix}}_{w}\\overset{A+I\\,}{\\to }\\underbrace{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{0}\n$$\n\nHere, we see that $A+I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-1$ of $A.$*\n\nSo, the correct answer is “$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-1$ of $A$” only."} {:db/id #edb/ref 17592186433719 :knowledge-point/_questions [{:db/id #edb/ref 17592186152225 :knowledge-point/id #uuid "04926916-8e08-5401-a57b-3fd333741913" :knowledge-point/title "Identifying Generalized Eigenvectors Using Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fed10178-ef4b-59fa-b96b-8889cbd8b37d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453240} {:answer/id #uuid "24f32365-5e6f-5ad2-bcf2-42010d1c1251" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453241}] :answer-field/correct {:answer/id #uuid "fed10178-ef4b-59fa-b96b-8889cbd8b37d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453240} :answer-field/id #uuid "b30cc055-118f-56a3-8691-fe26bb97101d" :answer-field/key "$v$ is an eigenvector corresponding to the eigenvalue $\\lambda =-2$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454370} {:answer-field/choices [{:answer/id #uuid "c57d558e-22a4-52d4-baa1-e5568009d2ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453242} {:answer/id #uuid "42c38ee5-6978-557c-8b50-7d9aacae1ed5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453243}] :answer-field/correct {:answer/id #uuid "c57d558e-22a4-52d4-baa1-e5568009d2ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453242} :answer-field/id #uuid "7254584c-027f-596c-800b-7c741d8a1fb6" :answer-field/key "$x$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =2$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454371} {:answer-field/choices [{:answer/id #uuid "616ab2e3-1f4e-5ad6-94c8-c9779b3e83cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453244} {:answer/id #uuid "962d94f6-82e6-5823-a373-7d154666009f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453245}] :answer-field/correct {:answer/id #uuid "962d94f6-82e6-5823-a373-7d154666009f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453245} :answer-field/id #uuid "07651977-3bff-5ed3-86ec-820cd2110222" :answer-field/key "$y$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =2$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454372}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c32d62b6-73f0-5c6b-b445-e1066fb0b96f" :question/math-academy-id "q-109242" :question/problem "$$\n\\begin{aligned}u\\overset{A+2I\\,}{\\to }v\\overset{A+2I\\,}{\\to }w\\overset{A+2I\\,}{\\to }0 \\\\ x\\overset{A-2I\\,}{\\to }y\\overset{A-2I\\,}{\\to }0\\end{aligned}\n$$\n\nGiven the action of the matrices $A+2I$ and $A-2I$ on the nonzero vectors $u,v,w,x$ and $y$ as depicted above, which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A *generalized eigenvector* ${v}_{n}$ of rank $n$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{n}\\overset{A-\\lambda I\\,}{\\to }{v}_{n-1}\\overset{A-\\lambda I\\,}{\\to }…\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{n-1},{v}_{n-2},…,{v}_{1}\\ne 0.$ An *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement “$v$ is an eigenvector corresponding to the eigenvalue $\\lambda =-2$ of $A$” is false. Since \n\n$$\nv\\overset{A+2I\\,}{\\to }w,\n$$\n\nand $w\\ne 0,$  the vector $v$ is  **not** a eigenvector of $A$ corresponding  to the eigenvalue $\\lambda =-2.$\n\n- Statement “$x$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =2$ of $A$” is false. Since\n\n$$\nx\\overset{A-2I\\,}{\\to }y\\overset{A-2I\\,}{\\to }0,\n$$\n\n \ni.e. $A-2I$ maps $x$ to $0$ in $2$ steps, \nthe vector $x$ is a generalized eigenvector of rank $2,$ not $3.$\n\n- Statement “$y$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =2$ of $A$” is true. Indeed, since\n\n$$\ny\\overset{A-2I\\,}{\\to }0,\n$$\n\ni.e. $A-2I$ maps $y$ to $0$ in $1$ step, \nthe vector $y$ is a generalized eigenvector of rank $1$ (a.k.a. an eigenvector) corresponding to the eigenvalue $\\lambda =2$ of $A.$\n\nTherefore, the correct answer is “$y$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =2$ of $A$” only."} {:db/id #edb/ref 17592186434367 :knowledge-point/_questions [{:db/id #edb/ref 17592186147450 :knowledge-point/id #uuid "813ec1d4-93ec-5a9e-996f-b2e672714927" :knowledge-point/title "Identifying Solutions to Forced Harmonic Motion Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f59cca8-143e-50c3-9107-5164e30e88b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474978} {:answer/id #uuid "d916f23d-bc74-569d-b289-7a75b444cca7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474979}] :answer-field/correct {:answer/id #uuid "5f59cca8-143e-50c3-9107-5164e30e88b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474978} :answer-field/id #uuid "82507c52-06c9-5e1b-a7fc-0bb3f4dafd71" :answer-field/key "$y=R{e}^{-3t}\\operatorname{sin}⁡(3t+ϕ)+4\\operatorname{sin}⁡3t$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475415} {:answer-field/choices [{:answer/id #uuid "a361cb0e-75c2-5310-a358-7c715da47d76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474980} {:answer/id #uuid "ca5aae8b-aaeb-5053-90a6-d6ea6f166f03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474981}] :answer-field/correct {:answer/id #uuid "a361cb0e-75c2-5310-a358-7c715da47d76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474980} :answer-field/id #uuid "7ec1c685-8fbc-5afd-82fb-d7fa98da1213" :answer-field/key "$y$ $=A{e}^{-3t}$ $+B{e}^{3t}$ $+\\operatorname{cos}⁡3t$ $+2\\operatorname{sin}⁡3t$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475416} {:answer-field/choices [{:answer/id #uuid "ee996a45-bd61-501c-b8c5-a9af76da2c73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474982} {:answer/id #uuid "53f460bd-5f74-5f0a-b7bc-e24a342db1e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474983}] :answer-field/correct {:answer/id #uuid "53f460bd-5f74-5f0a-b7bc-e24a342db1e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474983} :answer-field/id #uuid "3eab5dfe-8d5c-5061-bf8b-bc549bd4e1ee" :answer-field/key "$y$ $={e}^{-3t}(A\\operatorname{cos}⁡3t+B\\operatorname{sin}⁡3t)$ $+\\operatorname{cos}⁡3t$ $+2\\operatorname{sin}⁡3t$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475417}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "44316634-3540-5552-a378-8f950333c8f6" :question/math-academy-id "q-94384" :question/problem "A particle is moving with forced harmonic motion with damping. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+6{y}^{′}+18y=45\\operatorname{cos}⁡3t.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\nNote that $A,$ $B,$ $R$ and $ϕ$ are constants.\n\nSelect all that apply." :question/worked-solution "The general solution is the sum of the complementary solution and the particular solution:\n\n$$\ny(t)={y}_{c}(t)+{y}_{p}(t)\n$$\n\nFirst, we find the complementary solution ${y}_{c}(t),$ which is the solution to the homogeneous equation ${y}^{″}+6{y}^{′}+18y=0.$ Writing down and solving the characteristic equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}+6\\lambda +18 & =0 \\\\ ({\\lambda }^{2}+6\\lambda +9)-9+18 & =0 \\\\ (\\lambda +3)^{2}+9 & =0 \\\\ (\\lambda +3)^{2} & =-9 \\\\ \\lambda +3 & =\\pm 3\\text{i} \\\\ \\lambda  & =-3\\pm 3\\text{i}.\\end{aligned}\n$$\n\nTherefore the complementary function ${y}_{c}(t)$ can be expressed in any of the following forms:\n\n$$\n\\begin{aligned}{y}_{c}(t) & =R{e}^{-3t}\\operatorname{sin}⁡(3t+ϕ), \\\\ {y}_{c}(t) & =R{e}^{-3t}\\operatorname{cos}⁡(3t+ϕ), \\\\ {y}_{c}(t) & ={e}^{-3t}(A\\operatorname{cos}⁡3t+B\\operatorname{sin}⁡3t).\\end{aligned}\n$$\n\nNext, we find the particular solution ${y}_{p}(t).$ The particular solution is of the form\n\n$$\n{y}_{p}(t)=\\alpha \\operatorname{cos}⁡3t+\\beta \\operatorname{sin}⁡3t.\n$$\n\nBy substituting the particular solution into the differential equation and equating coefficients, we find that $\\alpha =1$ and $\\beta =2.$ So, the particular solution is\n\n$$\n{y}_{p}(t)=\\operatorname{cos}⁡3t+2\\operatorname{sin}⁡3t.\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n$$\n\\begin{aligned}y(t) & =R{e}^{-3t}\\operatorname{sin}⁡(3t+ϕ)+\\operatorname{cos}⁡3t+2\\operatorname{sin}⁡3t, \\\\ y(t) & =R{e}^{-3t}\\operatorname{cos}⁡(3t+ϕ)+\\operatorname{cos}⁡3t+2\\operatorname{sin}⁡3t, \\\\ y(t) & ={e}^{-3t}(A\\operatorname{cos}⁡3t+B\\operatorname{sin}⁡3t)+\\operatorname{cos}⁡3t+2\\operatorname{sin}⁡3t.\\end{aligned}\n$$\n\nOnly $y$ $={e}^{-3t}(A\\operatorname{cos}⁡3t+B\\operatorname{sin}⁡3t)$ $+\\operatorname{cos}⁡3t$ $+2\\operatorname{sin}⁡3t$ matches the forms above. Therefore, the correct answer is $y$ $={e}^{-3t}(A\\operatorname{cos}⁡3t+B\\operatorname{sin}⁡3t)$ $+\\operatorname{cos}⁡3t$ $+2\\operatorname{sin}⁡3t$ only."} {:db/id #edb/ref 17592186434368 :knowledge-point/_questions [{:db/id #edb/ref 17592186147450 :knowledge-point/id #uuid "813ec1d4-93ec-5a9e-996f-b2e672714927" :knowledge-point/title "Identifying Solutions to Forced Harmonic Motion Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bc4b0f4-319d-5b82-a6b6-8a9a2ca8573b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474894} {:answer/id #uuid "1e021694-6cbc-586c-9af5-6032ecb5376f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474895}] :answer-field/correct {:answer/id #uuid "1e021694-6cbc-586c-9af5-6032ecb5376f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474895} :answer-field/id #uuid "8f0d3c1f-0626-50ad-96ff-dff84e27f685" :answer-field/key "$y=R{e}^{-t}\\operatorname{cos}⁡(2t+ϕ)+5t-2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475373} {:answer-field/choices [{:answer/id #uuid "97f8b113-0642-5c5b-9738-b86720e2673a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474896} {:answer/id #uuid "0bc87909-bfd5-57b0-bd3c-48f0272a658c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474897}] :answer-field/correct {:answer/id #uuid "97f8b113-0642-5c5b-9738-b86720e2673a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474896} :answer-field/id #uuid "f027bf25-fb1d-54be-a97f-98a1627996e6" :answer-field/key "$y=R{e}^{-2t}\\operatorname{sin}⁡(t+ϕ)+5t-2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475374} {:answer-field/choices [{:answer/id #uuid "c9dfad26-9a8d-5709-9bf9-3c9d0dc3ee22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474898} {:answer/id #uuid "9ffef0d1-665e-5de1-8b8a-cf200a7712a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474899}] :answer-field/correct {:answer/id #uuid "c9dfad26-9a8d-5709-9bf9-3c9d0dc3ee22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474898} :answer-field/id #uuid "33da045b-9147-535c-8cf0-691b41b4ea3a" :answer-field/key "$y$ $={e}^{-t}(A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t)$ $+t$ $-5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475375}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4f73fcd2-bb5e-5500-9c9a-4e8cac71bdbd" :question/math-academy-id "q-79579" :question/problem "A particle is moving with forced harmonic motion with damping. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+2{y}^{′}+5y=25t.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\nNote that $A,$ $B,$ $R$ and $ϕ$ are constants.\n\nSelect all that apply." :question/worked-solution "The general solution is the sum of the complementary solution and the particular solution:\n\n$$\ny(t)={y}_{c}(t)+{y}_{p}(t)\n$$\n\nFirst, we find the complementary solution ${y}_{c}(t),$ which is the solution to the homogeneous equation ${y}^{″}+2{y}^{′}+5y=0.$ Writing down and solving the characteristic equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}+2\\lambda +5 & =0 \\\\ ({\\lambda }^{2}+2\\lambda +1)-1+5 & =0 \\\\ (\\lambda +1)^{2}+4 & =0 \\\\ (\\lambda +1)^{2} & =-4 \\\\ \\lambda +1 & =\\pm 2\\text{i} \\\\ \\lambda  & =-1\\pm 2\\text{i}.\\end{aligned}\n$$\n\nTherefore the complimentary function ${y}_{c}(t)$ can be expressed in any of the following forms:\n\n$$\n\\begin{aligned}{y}_{c}(t) & ={e}^{-t}(A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t), \\\\ {y}_{c}(t) & =R{e}^{-t}\\operatorname{cos}⁡(2t+ϕ), \\\\ {y}_{c}(t) & =R{e}^{-t}\\operatorname{sin}⁡(2t+ϕ).\\end{aligned}\n$$\n\nNext, we find the particular solution ${y}_{p}(t).$ Since the external force is a linear function, we assume that the particular solution is also a linear function,\n\n$$\n{y}_{p}(t)=\\alpha t+\\beta .\n$$\n\nBy substituting the particular solution into the differential equation and equating coefficients, we find that $\\alpha =5$ and $\\beta =-2.$ So, the particular solution is\n\n$$\n{y}_{p}(t)=5t-2.\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n$$\n\\begin{aligned}y(t) & ={e}^{-t}(A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t)+5t-2, \\\\ y(t) & =R{e}^{-t}\\operatorname{cos}⁡(2t+ϕ)+5t-2, \\\\ y(t) & =R{e}^{-t}\\operatorname{sin}⁡(2t+ϕ)+5t-2.\\end{aligned}\n$$\n\nOnly $y=R{e}^{-t}\\operatorname{cos}⁡(2t+ϕ)+5t-2$ matches the forms above. Therefore, the correct answer is $y=R{e}^{-t}\\operatorname{cos}⁡(2t+ϕ)+5t-2$ only."} {:db/id #edb/ref 17592186434388 :knowledge-point/_questions [{:db/id #edb/ref 17592186147544 :knowledge-point/id #uuid "638e604b-5416-5d3c-a61f-5be645aa255b" :knowledge-point/title "Identifying True Statements in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "825bb7d0-2dd7-5898-b09d-fa36c3af945c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453868} {:answer/id #uuid "b7ee75e3-c277-58e5-8016-0f292274075f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453869}] :answer-field/correct {:answer/id #uuid "b7ee75e3-c277-58e5-8016-0f292274075f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453869} :answer-field/id #uuid "27377df2-4049-5654-9b05-2bd96fc9143a" :answer-field/key "Less than half of Sana's homework assignments were turned in early." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454684} {:answer-field/choices [{:answer/id #uuid "ffa5102c-c608-5436-b9c9-a71c559e2def" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453870} {:answer/id #uuid "c3c895d9-44a3-52c0-ab7d-3d644c95fa8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453871}] :answer-field/correct {:answer/id #uuid "ffa5102c-c608-5436-b9c9-a71c559e2def" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453870} :answer-field/id #uuid "90d78070-dbec-5fd0-85ce-332d66270d76" :answer-field/key "More than half of Talia's homework assignments were turned in early." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454685} {:answer-field/choices [{:answer/id #uuid "cac6f298-f93a-5381-8ee2-f655b4a4bb52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453872} {:answer/id #uuid "91b100af-367e-5f51-bd41-32339c196cd4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453873}] :answer-field/correct {:answer/id #uuid "cac6f298-f93a-5381-8ee2-f655b4a4bb52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453872} :answer-field/id #uuid "08559b28-05c3-5429-8dcc-9459d6dd6efb" :answer-field/key "Sana had a greater percentage of homework assignments turned in early compared to Talia." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454686}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "16a4ed86-6ba4-5b08-b5bc-00c64da3da49" :question/math-academy-id "q-350266" :question/problem "Sana and Talia are students. In the previous semester, the decimal proportion of Sana’s homework assignments that were turned in early was $0.4,$ while $45%$ of Talia’s homework assignments were turned in early. \n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's examine our statements in turn.\n\n- Statement “Less than half of Sana's homework assignments were turned in early” is true. Indeed, since \n\n$$\n0.4<0.5,\n$$\n\nless than half of Sana's homework assignments were turned in early.\n\n- Statement “More than half of Talia's homework assignments were turned in early” is false. Notice that \n\n$$\n45%<50%.\n$$\n\nSo, less than half of Talia's homework assignments were turned in early.\n\n- Statement “Sana had a greater percentage of homework assignments turned in early compared to Talia” is false. We can compare $0.4$ and $45%$ by converting the decimal into a percent. \n\nTo do this, we multiply it by $100:$\n\n$$\n0.4\\times 100=40%\n$$\n\nSince  $40%<45%,$ Sana did not have a greater percentage of homework assignments turned in early compared to Talia.\n\nTherefore, the correct answer is “Less than half of Sana's homework assignments were turned in early” only."} {:db/id #edb/ref 17592186434466 :knowledge-point/_questions [{:db/id #edb/ref 17592186172005 :knowledge-point/id #uuid "747b25be-ff4e-5b1e-abcc-5edd1edd9790" :knowledge-point/title "Identifying Situations That Can Be Modeled Using an Exponential Distribution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5db4df4b-7f16-5bf3-97ef-12154e024d53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474344} {:answer/id #uuid "a810abc8-9133-52e0-b38a-7cd98d485d48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474345}] :answer-field/correct {:answer/id #uuid "a810abc8-9133-52e0-b38a-7cd98d485d48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474345} :answer-field/id #uuid "00d91e8a-45b6-5892-bc2a-a67179b8e70e" :answer-field/key "The time until a laser fails, in hours, in a specific type of machine" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475098} {:answer-field/choices [{:answer/id #uuid "bfd1b4d3-ada7-5034-be47-4a2c6faead74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474346} {:answer/id #uuid "bff721a3-2da9-5289-a2cc-ef93df66a49f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474347}] :answer-field/correct {:answer/id #uuid "bfd1b4d3-ada7-5034-be47-4a2c6faead74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474346} :answer-field/id #uuid "fc81e4ee-db86-5159-990a-694c8671c85b" :answer-field/key "The number obtained when launching a fair roulette wheel" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475099} {:answer-field/choices [{:answer/id #uuid "e70de085-b4c6-51cb-a8d4-dedc837167ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474348} {:answer/id #uuid "84c0aa2f-082c-5e13-9936-93339186e9a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474349}] :answer-field/correct {:answer/id #uuid "e70de085-b4c6-51cb-a8d4-dedc837167ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474348} :answer-field/id #uuid "c7a8464a-7e39-5edc-8ff3-7087cf3b0eb4" :answer-field/key "The number of children in a daycare center" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475100}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3deca36d-f2e0-579a-9131-b3cacf95a814" :question/math-academy-id "q-132448" :question/problem "Which of the following random variables could be modeled by an exponential distribution?\n\nSelect all that apply." :question/worked-solution "The exponential distribution can be thought of as the continuous analog of the geometric distribution. It models the amount of continuous time or space until a particular event occurs, where the events should occur independently and at a constant average rate.\n\nWith that in mind, let's consider each of the given random variables.\n\n- Random variable “The time until a laser fails, in hours, in a specific type of machine” could be modeled using an exponential distribution. Laser failure in a particular machine can be modeled as independent events with a constant average rate, and we wish to know the time it takes for the laser to fail.\n\n- Random variable “The number obtained when launching a fair roulette wheel” does *not* follow an exponential distribution. There are no events that occur at a constant average rate, and there is no interval of continuous time or space. Moreover, the number obtained when launching a roulette wheel is discrete, not continuous.\n\n- Random variable “The number of children in a daycare center” does *not* follow an exponential distribution. There is no interval of continuous time or space. The number of children is discrete, not continuous.\n\nTherefore, the correct answer is “The time until a laser fails, in hours, in a specific type of machine” only."} {:db/id #edb/ref 17592186434467 :knowledge-point/_questions [{:db/id #edb/ref 17592186172005 :knowledge-point/id #uuid "747b25be-ff4e-5b1e-abcc-5edd1edd9790" :knowledge-point/title "Identifying Situations That Can Be Modeled Using an Exponential Distribution"}] :question/answer-fields [{:answer-fi