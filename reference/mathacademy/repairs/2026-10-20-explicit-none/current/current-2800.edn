eld/key "$\\frac{0}{-1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475345}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3913baef-cd96-5f27-bb8b-fbabac946e82" :question/math-academy-id "q-43156" :question/problem "Which of the following is undefined?\n\nSelect all that apply." :question/worked-solution "We consider each point individually:\n\n- Multiplying any number by zero always gives zero. Therefore, $0\\cdot 0=0.$\n\n- We cannot divide any number by zero. Therefore, $\\frac{2}{0}=2÷0$ is undefined.\n\n- Zero divided by any number (other than zero) equals zero. Therefore, $\\frac{0}{-1}=0÷(-1)=0.$\n\nTherefore, the correct answer is $\\frac{2}{0}$ only."} {:db/id #edb/ref 17592186424829 :knowledge-point/_questions [{:db/id #edb/ref 17592186152126 :knowledge-point/id #uuid "f7063140-eebe-598c-b530-3c13509d359b" :knowledge-point/title "Classifying Numbers as Rational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae455b06-57a8-5d93-9157-cd35b17547dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454292} {:answer/id #uuid "f154f091-b3d8-5882-a5de-29825c165b53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454293}] :answer-field/correct {:answer/id #uuid "ae455b06-57a8-5d93-9157-cd35b17547dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454292} :answer-field/id #uuid "1b8d8d86-8d3d-50ef-b445-569abc9469df" :answer-field/key "$-\\frac{1}{9}$ is a natural number" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454896} {:answer-field/choices [{:answer/id #uuid "247c27cf-56eb-5de2-9f83-71462a72ddb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454294} {:answer/id #uuid "5f1df5b5-703d-5c5b-93e7-b19508897ec2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454295}] :answer-field/correct {:answer/id #uuid "247c27cf-56eb-5de2-9f83-71462a72ddb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454294} :answer-field/id #uuid "c723106c-c2dc-5b3a-9479-21fa566dacb1" :answer-field/key "$-\\frac{1}{9}$ is an integer" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454897} {:answer-field/choices [{:answer/id #uuid "f6cf069d-05a9-5977-b07e-cabf8b6745a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454296} {:answer/id #uuid "a5a6a7d4-5300-5741-b7b3-4d1de0c6dba0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454297}] :answer-field/correct {:answer/id #uuid "a5a6a7d4-5300-5741-b7b3-4d1de0c6dba0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454297} :answer-field/id #uuid "b6a66b23-a5a9-5bd3-a362-76c36456a6fe" :answer-field/key "$-\\frac{1}{9}$ is a rational number" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454898}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d38c8439-616e-58d4-9fa5-c5876ae08e79" :question/math-academy-id "q-99327" :question/problem "Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's recall our definitions.\n\n- The natural numbers consist of all positive whole numbers: $1,\\,2,\\,3,\\,4,\\,5,…$\n\n- The integers consist of all of the positive and negative whole numbers, and zero: $…,-3,\\,-2,\\,-1,\\,0,\\,1,\\,2,\\,3,…$\n\n- The rationals consist of all numbers that can be written as the ratio of two integers.\n\nNow, let's go through each number in turn.\n\n- $-\\frac{1}{9}$ is not a natural number.\n\n- $-\\frac{1}{9}$ is not an integer.\n\n- $-\\frac{1}{9}$ is a rational number because it can be written as $\\frac{(-1)}{9}.$\n\nTherefore, the correct answer is “$-\\frac{1}{9}$ is a rational number” only."} {:db/id #edb/ref 17592186424834 :knowledge-point/_questions [{:db/id #edb/ref 17592186157307 :knowledge-point/id #uuid "a25bce44-98ca-54c6-a59f-b7508880d5ba" :knowledge-point/title "Determining Whether a Number is Divisible by 4"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dca59057-55b3-5c7c-ba82-222cb932dc6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474314} {:answer/id #uuid "342f9c82-98c2-5afb-b7a9-9344138494ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474315}] :answer-field/correct {:answer/id #uuid "342f9c82-98c2-5afb-b7a9-9344138494ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474315} :answer-field/id #uuid "05842590-b751-527d-8067-eab1f70de64f" :answer-field/key "The digit $2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475083} {:answer-field/choices [{:answer/id #uuid "1f310f8e-7033-5033-b9d9-74deb0062dda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474316} {:answer/id #uuid "24a3dcba-c4be-52f2-90b2-c17076b17071" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474317}] :answer-field/correct {:answer/id #uuid "1f310f8e-7033-5033-b9d9-74deb0062dda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474316} :answer-field/id #uuid "f1bc1d48-f507-5a60-be9b-0a75bcfd5e98" :answer-field/key "The digit $4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475084} {:answer-field/choices [{:answer/id #uuid "e9415377-7ec5-59cd-9991-c2e930e3248f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474318} {:answer/id #uuid "cc6bb4b7-c675-5ffc-b1be-2557bc730c82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474319}] :answer-field/correct {:answer/id #uuid "e9415377-7ec5-59cd-9991-c2e930e3248f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474318} :answer-field/id #uuid "383cae21-cf51-5ade-8876-457d8c7e788a" :answer-field/key "The digit $8$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475085}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ef2c41de-4b26-57f5-bd27-cd0dbe211bfd" :question/math-academy-id "q-131860" :question/problem "Which digits, when inserted into the blank, make the number $123\\,321\\,87◻$ divisible by $4?$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A number is divisible by $4$ if the last two digits form a number that is divisible by $4.$\n\nThe last two digits of the number $123\\,321\\,87◻$ are $7◻.$\n\n- If $2$ is substituted into the blank, then the last two digits are $72,$ which is indeed divisible by $4.$\n\n- If $4$ is substituted into the blank, then the last two digits are $74,$ which is *not* divisible by $4.$\n\n- If $8$ is substituted into the blank, then the last two digits are $78,$ which is *not* divisible by $4.$\n\nTherefore, the correct answer is “The digit $2$” only."} {:db/id #edb/ref 17592186424970 :knowledge-point/_questions [{:db/id #edb/ref 17592186054799 :knowledge-point/id #uuid "ef650886-8d46-583e-bad0-1429ba496479" :knowledge-point/title "Identifying Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8af86952-f1a2-50de-951a-8a9e9a9f8d0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474242} {:answer/id #uuid "b8102cba-bae6-5b32-9d41-533a10dd33f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474243}] :answer-field/correct {:answer/id #uuid "8af86952-f1a2-50de-951a-8a9e9a9f8d0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474242} :answer-field/id #uuid "25dac5ff-cf3e-5fd0-8d33-d5d62176534f" :answer-field/key "The expression $\\sqrt{z}-1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475047} {:answer-field/choices [{:answer/id #uuid "fc272a68-46b4-5709-95bb-fdc3cb96a630" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474244} {:answer/id #uuid "92d29498-a656-5583-859d-37b78713ad41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474245}] :answer-field/correct {:answer/id #uuid "92d29498-a656-5583-859d-37b78713ad41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474245} :answer-field/id #uuid "7a64f76f-38c6-5914-bfb8-41dbd542e9b1" :answer-field/key "The expression $z$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/i