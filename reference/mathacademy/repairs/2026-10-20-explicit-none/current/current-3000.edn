c37932de-0cce-59c6-b24c-876d74561656" :answer-field/key "$(1,1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186521848} {:answer-field/choices [{:answer/id #uuid "1b0fcc2f-e79a-53cd-94ba-19c374993156" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186521767} {:answer/id #uuid "5bb26662-eec4-5532-b2af-772b585f772c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186521804}] :answer-field/correct {:answer/id #uuid "5bb26662-eec4-5532-b2af-772b585f772c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186521804} :answer-field/id #uuid "dee6063a-ddce-52a8-86a7-f5e0d850c4d5" :answer-field/key "$(1,2)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186521859}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "138b2fa1-5696-5cfb-b4c1-4b8eecec9f34" :question/problem "At which points on the curve $4 x y + y^{2}=4 x^{2} + 8$ is the tangent vector to the curve perpendicular to the vector $j$?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "First, we bring all variables to one side:\n\n$$\\begin{aligned}4 x y + y^{2}&=4 x^{2} + 8\\\\- 4 x^{2} + 4 x y + y^{2} - 8&=0\\end{aligned}$$\n\nIf we set $f(x,y)=- 4 x^{2} + 4 x y + y^{2} - 8$, our curve can be viewed as the level curve $f(x,y)=0.$\n\nA tangent vector to the level curve can be computed as follows:\n\n$$t(x,y)=f_y(x,y)\\,i-f_x(x,y)\\,j$$\n\nSo, we calculate $t(x,y):$\n\n$$\\begin{aligned}t(x,y)&=\\frac{∂}{∂y}(- 4 x^{2} + 4 x y + y^{2} - 8)\\,i-\\frac{∂}{∂x}(- 4 x^{2} + 4 x y + y^{2} - 8)\\,j\\\\&=(4 x + 2 y)\\,i-(- 8 x + 4 y)\\,j\\end{aligned}$$\n\nSince our tangent vector needs to be perpendicular to $j$, we must have $t\\cdot j=0.$\n\n$$\\begin{aligned}t(x,y)\\cdot j&=0\\\\8 x - 4 y&=0\\\\y&=2x\\end{aligned}$$\n\nSubstituting $y=2x$ into the equation of our curve gives:\n\n$$\\begin{aligned}1(2x)^{2}+4x(2x)-4x^{2}-8&=0\\\\8x^{2}-8&=0\\\\x^{2}&=1\\\\x&=\\pm 1\\end{aligned}$$\n\nFinally, the corresponding points are $(1,2)$ and $(-1,-2)$."} {:db/id #edb/ref 17592186521800 :knowledge-point/_questions [{:db/id #edb/ref 17592186124456 :knowledge-point/id #uuid "84245283-3cf9-5889-8c42-896a0c8af291" :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "306ad61b-7cf2-5e46-b92a-99bb59b27116" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186521779} {:answer/id #uuid "a5d14569-99f9-5f0a-b34b-fcf4aef8d5b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186521833}] :answer-field/correct {:answer/id #uuid "306ad61b-7cf2-5e46-b92a-99bb59b27116" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186521779} :answer-field/id #uuid "2bf8aaf8-fe3e-5ed9-9824-d9ba6d421a9e" :answer-field/key "$(0,16)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186521776} {:answer-field/choices [{:answer/id #uuid "04f0e009-6fcf-56c0-ab31-f7119fd2b704" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186521748} {:answer/id #uuid "bc7dfc78-e18a-5790-b5c3-ca2284d7c7cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186521845}] :answer-field/correct {:answer/id #uuid "04f0e009-6fcf-56c0-ab31-f7119fd2b704" :answer/type {:db/id #edb/ref 17592186045499