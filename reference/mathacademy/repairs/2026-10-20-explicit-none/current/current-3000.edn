wer is $B(x,y,z)=\\langle 2x, y^2, z\\rangle$; $C(x,y,z)=\\langle 2x, y^2, z\\rangle$ only."} {:db/id #edb/ref 17592186546196 :knowledge-point/_questions [{:db/id #edb/ref 17592186172087 :knowledge-point/id #uuid "fb34fdb0-198e-507d-a944-9be782b4cfeb" :knowledge-point/title "Identifying Vector Fields on Three-Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e296e7e-76c7-5b98-bf37-1a4f7ba519d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186546183} {:answer/id #uuid "9e9f3418-8a1f-5161-9666-2aa17f5da133" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186546192}] :answer-field/correct {:answer/id #uuid "9e9f3418-8a1f-5161-9666-2aa17f5da133" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186546192} :answer-field/id #uuid "2db229fa-b5b6-536d-bdfc-f685e022f131" :answer-field/key "$A(x,y,z)=\\langle 2x, x^2, 1\\rangle$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186546148} {:answer-field/choices [{:answer/id #uuid "1c4ccc6c-8cf6-5337-b0e1-234f1e7eea82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186546142} {:answer/id #uuid "c21242e4-8385-5223-acd3-5cb2f6200545" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186546211}] :answer-field/correct {:answer/id #uuid "c21242e4-8385-5223-acd3-5cb2f6200545" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186546211} :answer-field/id #uuid "7350d7b8-997f-53b1-b9e6-b25d46b638d9" :answer-field/key "$C(x,y)=\\langle 2x, x^2, 1\\rangle$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbo