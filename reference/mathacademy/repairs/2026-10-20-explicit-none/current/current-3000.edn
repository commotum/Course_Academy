er.type/text} :answer/value "true" :db/id #edb/ref 17592186523150}] :answer-field/correct {:answer/id #uuid "53e8ac69-39e1-5dfb-b044-65b188ea3777" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523123} :answer-field/id #uuid "f44f1c65-b30b-551b-a69a-7f4cd3ad8965" :answer-field/key "The system is inconsistent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186523184}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "636c60f0-5dc2-592a-9ada-f299790fa243" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+y+z &=5 \\\\ x+2y+2z &=7 \\\\ x+3y+5z &=8\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 1 & 1 & 5 \\\\ 1 & 2 & 2 & 7 \\\\ 1 & 3 & 5 & 8\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 1 & 1 & 5 \\\\ 1 & 2 & 2 & 7 \\\\ 1 & 3 & 5 & 8\\end{bmatrix} & {R}_{2}:={R}_{2}+(-1){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 1 & 1 & 5 \\\\ 0 & 1 & 1 & 2 \\\\ 1 & 3 & 5 & 8\\end{bmatrix} & {R}_{3}:={R}_{3}+(-1){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 1 & 1 & 5 \\\\ 0 & 1 & 1 & 2 \\\\ 0 & 2 & 4 & 3\\end{bmatrix} & {R}_{3}:={R}_{3}+(-2){R}_{2} \\\\ & ∼\\begin{bmatrix}1 & 1 & 1 & 5 \\\\ 0 & 1 & 1 & 2 \\\\ 0 & 0 & 2 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nThere is a pivot for each variable and no contradictory row. The system has a unique solution, so we conclude that the system is consistent independent.\n\nAs a result, only statement “The system is consistent independent” is true."} {:db/id #edb/ref 17592186523146 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51be9dbd-7ee6-56c1-a547-5903d2a1b3e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523122} {:answer/id #uuid "f4d7767c-aca7-50f4-90dc-f407ea0d7a3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523186}] :answer-field/correct {:answer/id #uuid "f4d7767c-aca7-50f4-90dc-f407ea0d7a3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523186} :answer-field/id #uuid "996ab691-0a7b-56e9-804a-a2787a923077" :answer-field/key "The system is inconsistent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186523156} {:answer-field/choices [{:answer/id #uuid "a23b4315-1a65-506a-8c02-738beed7aaa6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523158} {:answer/id #uuid "bb33e391-198c-5529-9d5b-397721de092c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523164}] :answer-field/correct {:answer/id #uuid "a23b4315-1a65-506a-8c02-738beed7aaa6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523158} :answer-field/id #uuid "d28f612b-3349-546c-9210-2a56396e5c6f" :answer-field/key "The system is consistent dependent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186523173} {:answer-field/choices [{:answer/id #uuid "08e08fdf-8af3-5a6d-a236-96fcf159b0f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523095} {:answer/id #uuid "60e8b807-93c5-5642-bfc7-4739a9cf92c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523132}] :answer-field/correct {:answer/id #uuid "08e08fdf-8af3-5a6d-a236-96fcf159b0f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523095} :answer-field/id #uuid "f478684b-108b-505b-8b25-f8e1f9defb6d" :answer-field/key "The system is consistent independent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186523185}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8a8ea6cd-37c6-57a9-b6bb-655208ae0dae" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+2y-z &=1 \\\\ 2x+5y &=7 \\\\ -2x-3y+5z &=6\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 2 & -1 & 1 \\\\ 2 & 5 & 0 & 7 \\\\ -2 & -3 & 5 & 6\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & -1 & 1 \\\\ 2 & 5 & 0 & 7 \\\\ -2 & -3 & 5 & 6\\end{bmatrix} & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 2 & -1 & 1 \\\\ 0 & 1 & 2 & 5 \\\\ -2 & -3 & 5 & 6\\end{bmatrix} & {R}_{3}:={R}_{3}+(2){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 2 & -1 & 1 \\\\ 0 & 1 & 2 & 5 \\\\ 0 & 1 & 3 & 8\\end{bmatrix} & {R}_{3}:={R}_{3}+(-1){R}_{2} \\\\ & ∼\\begin{bmatrix}1 & 2 & -1 & 1 \\\\ 0 & 1 & 2 & 5 \\\\ 0 & 0 & 1 & 3\\end{bmatrix}\\end{aligned}\n$$\n\nThere is a pivot for each variable and no contradictory row. The system has a unique solution, so we conclude that the system is consistent independent.\n\nAs a result, only statement “The system is consistent independent” is true."} {:db/id #edb/ref 17592186523149 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b71e9efd-4041-5353-b773-e73d4943b58e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523163} {:answer/id #uuid "c040c9e9-b2b2-5290-9279-e6d8a22bf949" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523167}] :answer-field/correct {:answer/id #uuid "c040c9e9-b2b2-5290-9279-e6d8a22bf949" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523167} :answer-field/id #uuid "0c161978-1b18-5f69-ab37-c6a064914aa4" :answer-field/key "The system is inconsistent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186523097} {:answer-field/choices [{:answer/id #uuid "1070f3b9-edc1-598f-9822-27e3abfa3c58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523100} {:answer/id #uuid "86e55745-a3ef-551c-a3b4-ce4d34f0d892" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523142}] :answer-field/correct {:answer/id #uuid "1070f3b9-edc1-598f-9822-27e3abfa3c58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523100} :answer-field/id #uuid "8a48fbc9-4e49-5abc-8cad-5f489b22b567" :answer-field/key "The system is consistent dependent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186523145} {:answer-field/choices [{:answer/id #uuid "0ca331de-6d7a-5bec-913c-999c56c3d275" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523098} {:answer/id #uuid "768483dd-8204-52e1-a40b-ab97ef2fad60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523139}] :answer-field/correct {:answer/id #uuid "768483dd-8204-52e1-a40b-ab97ef2fad60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523139} :answer-field/id #uuid "96339ae7-9e2a-597d-b5f3-d761fa172570" :answer-field/key "The system is consistent independent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186523155}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8e31a150-29e9-5dea-94ac-a18aad26fe11" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+y &=1 \\\\ 2x+4y &=4\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 1 & 1 \\\\ 2 & 4 & 4\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 1 & 1 \\\\ 2 & 4 & 4\\end{bmatrix} & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 1 & 1 \\\\ 0 & 2 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nThere is a pivot for each variable and no contradictory row. The system has a unique solution, so we conclude that the system is consistent independent.\n\nAs a result, only statement “The system is consistent independent” is true."} {:db/id #edb/ref 17592186523165 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56e13df2-cbbc-5122-a312-3d4718cfd2d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523126} {:answer/id #uuid "8ce05a37-3f4d-53ca-9976-cf02a4b3a3bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523147}] :answer-field/correct {:answer/id #uuid "56e13df2-cbbc-5122-a312-3d4718cfd2d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523126} :answer-field/id #uuid "2629fa4f-103c-5153-9f74-91ca5c93439c" :answer-field/key "The system is consistent independent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186523110} {:answer-field/choices [{:answer/id #uuid "554b6c18-e491-5f95-965d-fa5a2bd9d88d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523125} {:answer/id #uuid "f97645eb-31df-5037-9f30-9be5b18f44ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523189}] :answer-field/correct {:answer/id #uuid "f97645eb-31df-5037-9f30-9be5b18f44ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523189} :answer-field/id #uuid "5bacc81c-a202-5de7-91a7-ef4e2100ffe9" :answer-field/key "The system is consistent dependent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186523128} {:answer-field/choices [{:answer/id #uuid "1682be06-115f-54ff-a73b-9b589617e8f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523105} {:answer/id #uuid "27fd6cae-d564-59e2-aa3f-8a705ed55e02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523111}] :answer-field/correct {:answer/id #uuid "1682be06-115f-54ff-a73b-9b589617e8f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523105} :answer-field/id #uuid "b680bc94-e35d-5672-8a29-61a6ce96c60b" :answer-field/key "The system is inconsistent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186523161}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bb7d6994-e998-58f7-aa63-248113b6349d" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+y &=4 \\\\ -x &=-8\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 1 & 4 \\\\ -1 & 0 & -8\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 1 & 4 \\\\ -1 & 0 & -8\\end{bmatrix} & {R}_{2}:={R}_{2}+(1){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 1 & 4 \\\\ 0 & 1 & -4\\end{bmatrix}\\end{aligned}\n$$\n\nThere is a pivot for each variable and no contradictory row. The system has a unique solution, so we conclude that the system is consistent independent.\n\nAs a result, only statement “The system is consistent independent” is true."} {:db/id #edb/ref 17592186523181 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9392a4b7-e0c1-50c1-a200-9aea19b85ad8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523152} {:answer/id #uuid "c54d1d3c-4700-5389-9521-819eca5efa3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523170}] :answer-field/correct {:answer/id #uuid "c54d1d3c-4700-5389-9521-819eca5efa3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523170} :answer-field/id #uuid "14a0dd8b-1651-52fe-a379-fa629f0b62ac" :answer-field/key "The system is consistent independent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186523104} {:answer-field/choices [{:answer/id #uuid "bc35ea2c-b5fa-5a21-af8c-52f26ca8f62f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523166} {:answer/id #uuid "d9a8d720-eb68-5c11-a4f9-701068036d21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523178}] :answer-field/correct {:answer/id #uuid "bc35ea2c-b5fa-5a21-af8c-52f26ca8f62f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523166} :answer-field/id #uuid "2f23ed57-d37c-5347-b6fc-2f6d63d7a37b" :answer-field/key "The system is inconsistent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186523115} {:answer-field/choices [{:answer/id #uuid "7fa07bf6-b3cb-5d2d-8a9f-a191e0b6e0f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523141} {:answer/id #uuid "c5a5ef39-054c-5b8e-b9af-e036a4693bb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523171}] :answer-field/correct {:answer/id #uuid "7fa07bf6-b3cb-5d2d-8a9f-a191e0b6e0f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523141} :answer-field/id #uuid "c354c352-0b95-52ed-8029-4f2c45821f10" :answer-field/key "The system is consistent dependent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186523168}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ec9855f3-8df8-5de8-aa96-4a294a867b64" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x-3y-3z &=5 \\\\ 2x-5y-9z &=10 \\\\ 2x-5y-9z &=10\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & -3 & -3 & 5 \\\\ 2 & -5 & -9 & 10 \\\\ 2 & -5 & -9 & 10\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -3 & -3 & 5 \\\\ 2 & -5 & -9 & 10 \\\\ 2 & -5 & -9 & 10\\end{bmatrix} & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & -3 & -3 & 5 \\\\ 0 & 1 & -3 & 0 \\\\ 2 & -5 & -9 & 10\\end{bmatrix} & {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & -3 & -3 & 5 \\\\ 0 & 1 & -3 & 0 \\\\ 0 & 1 & -3 & 0\\end{bmatrix} & {R}_{3}:={R}_{3}+(-1){R}_{2} \\\\ & ∼\\begin{bmatrix}1 & -3 & -3 & 5 \\\\ 0 & 1 & -3 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. Here there is one free variable, $z$. Therefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*.\n\nAs a result, only statement “The system is consistent dependent” is true."} {:db/id #edb/ref 17592186523190 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "652676ed-c325-50b3-9370-c0907c671f47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523136} {:answer/id #uuid "f3e7efd8-3b15-55b0-a40f-7c34b7c76512" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523183}] :answer-field/correct {:answer/id #uuid "f3e7efd8-3b15-55b0-a40f-7c34b7c76512" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523183} :answer-field/id #uuid "04645717-bac8-5e0f-80de-5dc8a6e34e04" :answer-field/key "The system is inconsistent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186523093} {:answer-field/choices [{:answer/id #uuid "0a148d48-fb64-5d16-b8f9-19a6596fe811" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523096} {:answer/id #uuid "3abd678a-230b-520d-a0dd-63dc44fa005b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523116}] :answer-field/correct {:answer/id #uuid "0a148d48-fb64-5d16-b8f9-19a6596fe811" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523096} :answer-field/id #uuid "cfcb9672-726a-595a-b7dd-19a4952a0aab" :answer-field/key "The system is consistent independent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186523172} {:answer-field/choices [{:answer/id #uuid "0fcc01c5-0bb3-5828-940a-30086cb2d945" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186523099} {:answer/id #uuid "d3e45317-561e-5c27-9374-58cfdb78546e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523174}] :answer-field/correct {:answer/id #uuid "d3e45317-561e-5c27-9374-58cfdb78546e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186523174} :answer-field/id #uuid "dc3eaf4f-09ba-503b-a672-da707e643826" :answer-field/key "The system is consistent dependent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186523180}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fe67b029-391e-51be-a295-1e535d93c516" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-3 \\\\ -2x-4y &=3\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 2 & -3 \\\\ -2 & -4 & 3\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & -3 \\\\ -2 & -4 & 3\\end{bmatrix} & {R}_{2}:={R}_{2}+(2){R}_{1} \\\\ & ∼\\begin{bmatrix}1 & 2 & -3 \\\\ 0 & 0 & -3\\end{bmatrix}\\end{aligned}\n$$\n\nThe final row corresponds to the equation $0x+0y=-3,$ and this has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, only statement “The system is inconsistent” is true."} {:db/id #edb/ref 17592186529209 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4bf30a48-c9e1-56ae-a6e7-d1c98a8ff3ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529217} {:answer/id #uuid "c73dcc5f-2dfd-545e-8686-1192c87baf69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529244}] :answer-field/correct {:answer/id #uuid "4bf30a48-c9e1-56ae-a6e7-d1c98a8ff3ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529217} :answer-field/id #uuid "6c836807-d3ab-5654-828e-8cfc6899a48e" :answer-field/key "$Q$ is **not** a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186529226} {:answer-field/choices [{:answer/id #uuid "3352e3a8-a31e-5489-b928-3600c98b31be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529215} {:answer/id #uuid "7eea3389-ae38-5700-acdf-02838bc43de5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529233}] :answer-field/correct {:answer/id #uuid "7eea3389-ae38-5700-acdf-02838bc43de5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529233} :answer-field/id #uuid "7319f1b7-7a37-5090-bc1d-79d9eee3c8d9" :answer-field/key "$det(Q)=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186529231} {:answer-field/choices [{:answer/id #uuid "59fb7559-abec-5a5a-8f38-66e0e05169a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529221} {:answer/id #uuid "edd1215a-893f-52eb-9b40-de5e574e65b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529249}] :answer-field/correct {:answer/id #uuid "edd1215a-893f-52eb-9b40-de5e574e65b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529249} :answer-field/id #uuid "885ed53f-bd5b-5462-9002-72b92ffeea39" :answer-field/key "$Q$ is a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186529235}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0f86b247-8f09-549d-8811-1a1520e150f7" :question/problem "Which of the following statements are true regarding the matrix $Q$ given below?\n\nSelect all that apply.\n\n$$\nQ=\\begin{bmatrix}\\frac{4 \\sqrt{2}}{3} & -1 & \\frac{\\sqrt{2}}{2} \\\\ \\frac{2 \\sqrt{2}}{3} & \\frac{3}{2} & \\frac{\\sqrt{2}}{2} \\\\ - \\frac{8 \\sqrt{2}}{3} & 2 & - \\sqrt{2}\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(Q) & =|\\begin{aligned}\\frac{4 \\sqrt{2}}{3} & -1 & \\frac{\\sqrt{2}}{2} \\\\ \\frac{2 \\sqrt{2}}{3} & \\frac{3}{2} & \\frac{\\sqrt{2}}{2} \\\\ - \\frac{8 \\sqrt{2}}{3} & 2 & - \\sqrt{2}\\end{aligned}| \\\\  & =\\frac{4 \\sqrt{2}}{3}|\\begin{aligned}\\frac{3}{2} & \\frac{\\sqrt{2}}{2} \\\\ 2 & - \\sqrt{2}\\end{aligned}|+1|\\begin{aligned}\\frac{2 \\sqrt{2}}{3} & \\frac{\\sqrt{2}}{2} \\\\ - \\frac{8 \\sqrt{2}}{3} & - \\sqrt{2}\\end{aligned}|+\\frac{\\sqrt{2}}{2}|\\begin{aligned}\\frac{2 \\sqrt{2}}{3} & \\frac{3}{2} \\\\ - \\frac{8 \\sqrt{2}}{3} & 2\\end{aligned}| \\\\  & =\\frac{4 \\sqrt{2}}{3}(- \\frac{3 \\sqrt{2}}{2}- \\sqrt{2})+1(- \\frac{4}{3}+\\frac{8}{3})+\\frac{\\sqrt{2}}{2}(\\frac{4 \\sqrt{2}}{3}+4 \\sqrt{2}) \\\\  & =\\frac{4 \\sqrt{2}}{3}\\cdot \\left(- \\frac{5 \\sqrt{2}}{2}\\right)+1\\cdot \\frac{4}{3}+\\frac{\\sqrt{2}}{2}\\cdot \\frac{16 \\sqrt{2}}{3} \\\\  & =- \\frac{20}{3}+\\frac{4}{3}+\\frac{16}{3} \\\\  & =0\\end{aligned}\n$$\n\nSince $det(Q)=0$, the matrix is singular. \n\nTherefore, only statements “$Q$ is a singular matrix” and $det(Q)=0$ are true."} {:db/id #edb/ref 17592186529214 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "623acce1-fff7-50e6-838b-7b0788c7f4cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529223} {:answer/id #uuid "6f989a4f-56c1-50c2-8a6c-3fc3965f7ada" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529228}] :answer-field/correct {:answer/id #uuid "623acce1-fff7-50e6-838b-7b0788c7f4cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529223} :answer-field/id #uuid "25dfb153-bf6c-5bc8-81b3-3f8c8e55fd75" :answer-field/key "$R$ is a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186529212} {:answer-field/choices [{:answer/id #uuid "6ea2a503-d065-55b2-