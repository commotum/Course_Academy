{4}{5} & \\frac{3 \\sqrt{2}}{2} \\\\ - \\frac{3 \\sqrt{2}}{4} & \\frac{2}{5} & - \\frac{\\sqrt{2}}{2}\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(R) & =|\\begin{aligned}- \\frac{\\sqrt{2}}{2} & \\frac{2}{5} & - \\sqrt{2} \\\\ \\frac{\\sqrt{2}}{2} & \\frac{4}{5} & \\frac{3 \\sqrt{2}}{2} \\\\ - \\frac{3 \\sqrt{2}}{4} & \\frac{2}{5} & - \\frac{\\sqrt{2}}{2}\\end{aligned}| \\\\  & =\\left(- \\frac{\\sqrt{2}}{2}\\right)|\\begin{aligned}\\frac{4}{5} & \\frac{3 \\sqrt{2}}{2} \\\\ \\frac{2}{5} & - \\frac{\\sqrt{2}}{2}\\end{aligned}|+\\left(- \\frac{2}{5}\\right)|\\begin{aligned}\\frac{\\sqrt{2}}{2} & \\frac{3 \\sqrt{2}}{2} \\\\ - \\frac{3 \\sqrt{2}}{4} & - \\frac{\\sqrt{2}}{2}\\end{aligned}|+(- \\sqrt{2})|\\begin{aligned}\\frac{\\sqrt{2}}{2} & \\frac{4}{5} \\\\ - \\frac{3 \\sqrt{2}}{4} & \\frac{2}{5}\\end{aligned}| \\\\  & =\\left(- \\frac{\\sqrt{2}}{2}\\right)(- \\frac{2 \\sqrt{2}}{5}- \\frac{3 \\sqrt{2}}{5})+\\left(- \\frac{2}{5}\\right)(- \\frac{1}{2}+\\frac{9}{4})+(- \\sqrt{2})(\\frac{\\sqrt{2}}{5}+\\frac{3 \\sqrt{2}}{5}) \\\\  & =\\left(- \\frac{\\sqrt{2}}{2}\\right)\\cdot (- \\sqrt{2})+\\left(- \\frac{2}{5}\\right)\\cdot \\frac{7}{4}+(- \\sqrt{2})\\cdot \\frac{4 \\sqrt{2}}{5} \\\\  & =1- \\frac{7}{10}- \\frac{8}{5} \\\\  & =- \\frac{13}{10}\\end{aligned}\n$$\n\nSince $det(R)=- \\frac{13}{10}\\ne 0$, the matrix is **not** singular. \n\nTherefore, only statement “$R$ is **not** a singular matrix” is true."} {:db/id #edb/ref 17592186529220 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f10ee21-6b89-5e0f-a04a-e49bcfa4c907"