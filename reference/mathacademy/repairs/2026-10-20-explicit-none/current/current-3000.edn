\\\ \\frac{1}{2} & -\\frac{1}{2}\\end{bmatrix},\\,C=\\begin{bmatrix}-\\frac{1}{4} & -\\frac{3}{4} \\\\ \\frac{1}{2} & \\frac{1}{2}\\end{bmatrix}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "- First, we check whether $AB=BA={I}_{2}.$ Computing $AB$, we get\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}2 & 3 \\\\ -2 & -1\\end{bmatrix}\\begin{bmatrix}-\\frac{1}{4} & -\\frac{3}{4} \\\\ \\frac{1}{2} & -\\frac{1}{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}∗ & -3 \\\\ ∗ & ∗\\end{bmatrix} \\\\  & \\ne {I}_{2}.\\,\\times \\end{aligned}\n$$\n\nSo, statement $AB=BA={I}_{2}$ is false. As a result, $B\\ne {A}^{-1}$ and statement $B={A}^{-1}$ is false too.\n\n- Now, we check whether $AC=CA={I}_{2}.$ Computing $AC$, we get\n\n$$\n\\begin{aligned}AC & =\\begin{bmatrix}2 & 3 \\\\ -2 & -1\\end{bmatrix}\\begin{bmatrix}-\\frac{1}{4} & -\\frac{3}{4} \\\\ \\frac{1}{2} & \\frac{1}{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $CA$, we get\n\n$$\n\\begin{aligned}CA & =\\begin{bmatrix}-\\frac{1}{4} & -\\frac{3}{4} \\\\ \\frac{1}{2} & \\frac{1}{2}\\end{bmatrix}\\begin{bmatrix}2 & 3 \\\\ -2 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nSo, statement $AC=CA={I}_{2}$ is true.\n\nTherefore, the correct answer is $AC=CA={I}_{2}$ only."} {:db/id #edb/ref 17592186557780 :knowledge-point/_questions [{:db/id #edb/ref 17592186087699 :knowledge-point/id #uuid "9b9ef325-2358-5041-8a8d-b459e8ed9f09" :knowledge-point/title "Determining the Inverse of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac5ff699-83f3-5502-8863-b5603f0fa78e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186557755} {:answer/id #uuid "d38a16ac-5ef0-5fbd-96ac-5b7ea626f6