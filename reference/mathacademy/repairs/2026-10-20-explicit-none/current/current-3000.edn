}{4} & -\\frac{1}{4}\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $CA$, we get\n\n$$\n\\begin{aligned}CA & =\\begin{bmatrix}-\\frac{1}{4} & \\frac{1}{4} \\\\ -\\frac{3}{4} & -\\frac{1}{4}\\end{bmatrix}\\begin{bmatrix}-1 & -1 \\\\ 3 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nSo, statement $AC=CA={I}_{2}$ is true. As a result, $C={A}^{-1}$ and statement $C={A}^{-1}$ is true too.\n\nTherefore, the correct answer is $AC=CA={I}_{2}$; $C={A}^{-1}$ only."} {:db/id #edb/ref 17592186562871 :knowledge-point/_questions [{:db/id #edb/ref 17592186100869 :knowledge-point/id #uuid "b494140f-206a-5317-8079-ff719a253140" :knowledge-point/title "Determining Whether Two Matrices Are Conformable for Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "076c6b2a-e1d0-5505-b700-bcf004ce4d75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186562854} {:answer/id #uuid "cc7f3c0d-6cd0-5f80-8b00-c608989978ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186562907}] :answer-field/correct {:answer/id #uuid "076c6b2a-e1d0-5505-b700-bcf004ce4d75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186562854} :answer-field/id #uuid "1073773b-df59-5220-8043-a441e8a3b974" :answer-field/key "The product $PR$ is well defined." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186562856} {:answer-field/choices [{:answer/id #uuid "8fc9c401-1e65-5873-89b4-5ede83dca30d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186562888} {:answer/id #uuid "fd7fd980-eed2-51e5-9c91-bb2c4b24efb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186562921}] :answer-field/correct {:answer/id #uuid "fd7fd980-eed2-51e5-9c91-bb2c4b24efb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186562921} :answer-field/id #uuid "a1b98f72-cdd0-540c-895f-00b0413680c5" :answer-field/key "The product $OP$ is well defined." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186562894} {:answer-field/choices [{:answer/id #uuid "4607e018-576d-516c-bd98-9f6231ff371d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186562867} {:answer/id #uuid "5e879290-41ce-5caa-9a80-54fb5adc6df8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186562875}] :answer-field/correct {:answer/id #uuid "5e879290-41ce-5caa-9a80-54fb5adc6df8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186562875} :answer-field/id #uuid "cbcce078-a3f1-5646-afef-3c0d9a54a619" :answer-field/key "The product $PO$ is well defined." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186562906}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "514aa297-d018-5213-8e1d-3b49622a8fe3" :question/problem "<div class=\"matrix-operands\">\n<div>$O=\\begin{bmatrix}4 & -3 & -5 & -5\\end{bmatrix}$</div>\n<div>$P=\\begin{bmatrix}-3 \\\\ -8 \\\\ 5 \\\\ 0 \\\\ 2\\end{bmatrix}$</div>\n<div>$R=\\begin{bmatrix}-8 & 3 & -2 \\\\ 6 & -1 & 1 \\\\ 0 & -4 & 0 \\\\ 0 & 7 & 6 \\\\ 4 & -7 & 5\\end{bmatrix}$</div>\n</div>\n\nWhich of the following statements are true regarding the matrices $O,P,$ and $R?$\n\nSelect all that apply." :question/worked-solution "Notice that $O$ is a $1\\times 4$ row vector, $P$ is a $5\\times 1$ column vector, and $R$ is a $5\\times 3$ matrix.\n\nThere are $4$ columns in $O$ and $5$ rows in $P.$ Since the number of columns in $O$ does **not** equal the number of rows in $P,$ the matrices $O$ and $P$ are **not** conformable for multiplication:\n\n$$\n{O}_{1\\times 4}{\\times }_{\\ne }{P}_{5\\times 1}=\\text{undefined}\n$$\n\nOn the other hand, there is $1$ column in $P$ and $5$ rows in $R.$ Since the number of columns in $P$ does **not** equal the number of rows in $R,$ the matrices $P$ and $R$ are **not** conformable for multiplication:\n\n$$\n{P}_{5\\times 1}{\\times }_{\\ne }{R}_{5\\times 3}=\\text{undefined}\n$$\n\nFinally, there is $1$ column in $P$ and $1$ row in $O.$ Since the number of columns in $P$ equals the number of rows in $O,$ the matrices $P$ and $O$ are conformable for multiplication:\n\n$$\n{P}_{5\\times \\boxed{\\text{1}}}{\\times }_{✓}{O}_{\\boxed{\\text{1}}\\times 4}=\\text{well defined}\n$$\n\nThe product $PO$ is well defined. The products $OP$ and $PR$ are undefined."} {:db/id #edb/ref 17592186562872 :knowledge-point/_questions [{:db/id #edb/ref 17592186100869 :knowledge-point/id #uuid "b494140f-206a-5317-8079-ff719a253140" :knowledge-point/title "Determining Whether Two Matrices Are Conformable for Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f4356be-29f1-5e2b-830b-308a53df5c34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186562882} {:answer/id #uuid "85c9a81f-67cf-5cc7-90ed-a7b1dbdd973d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186562885}] :answer-field/correct {:answer/id #uuid "7f4356be-29f1-5e2b-830b-308a53df5c34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186562882} :answer-field/id #u