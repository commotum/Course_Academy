88-8aa3-2c998b727a1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186546213} :answer-field/id #uuid "54859b64-c4fb-5101-ba6e-9bf69193a6b5" :answer-field/key "$B(t)=\\langle 2t, t^2, 1\\rangle$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186546158}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c1e08d45-f11f-52a8-85bf-c6d22d6aef09" :question/problem "Which of the following are vector fields on $\\mathbb R^3?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of $\\mathbb R^3.$ A vector field on $\\mathbb R^3$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in\\mathbb R^3.$\n\nWith that in mind, let's examine each function.\n\n- The function $A(x,y,z)$ is a vector field on $\\mathbb R^3.$ It assigns every point $(x,y,z)\\in\\mathbb R^3$ to a vector in $\\mathbb R^3.$\n\n- The function $B(t)$ is *not* a vector field on $\\mathbb R^3.$ It assigns points in $\\mathbb R$ (not $\\mathbb R^3$) to vectors in $\\mathbb R^3$.\n\n- The function $C(x,y,z)$ is a vector field on $\\mathbb R^3.$ It assigns every point $(x,y,z)\\in\\mathbb R^3$ to a vector in $\\mathbb R^3.$\n\nTherefore, the correct answer is $A(x,y,z)=\\langle 2x, x^2, 1\\rangle$; $C(x,y,z)=\\langle 2x, x^2, 1\\rangle$ only."} {:db/id #edb/ref 17592186546214 :knowledge-point/_questions [{:db/id #edb/ref 17592186172087 :knowledge-point/id #uuid "fb34fdb0-198e-507d-a944-9be782b4cfeb" :knowledge-point/title "Identifying Vector Fields on Three-Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89ad7ba9-81ac-553e-8ffe-37a112345fdc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186546179} {:answer/id #uuid "fd521762-6972-57ec-95f0-1451ab5b98af" :answer/type