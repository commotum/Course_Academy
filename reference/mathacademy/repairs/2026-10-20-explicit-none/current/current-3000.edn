/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186521787}] :answer-field/correct {:answer/id #uuid "359049d8-2b99-5751-bb03-ff9f055d1cd2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186521782} :answer-field/id #uuid "75fee8ed-8c3c-5d8e-8885-59cd9a1a038b" :answer-field/key "$(-1,-4)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186521814} {:answer-field/choices [{:answer/id #uuid "b7e67073-fb07-58a4-9874-e483c457ec81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186521843} {:answer/id #uuid "f3aa9a94-d8a4-5840-ab7a-2800c7878b3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186521873}] :answer-field/correct {:answer/id #uuid "b7e67073-fb07-58a4-9874-e483c457ec81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186521843} :answer-field/id #uuid "770dec33-da36-590b-98e3-de009fe90cf3" :answer-field/key "$(1,2)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186521816} {:answer-field/choices [{:answer/id #uuid "92e10c0d-3823-528f-87a3-277e9336972f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186521824} {:answer/id #uuid "d3cf240d-8708-5599-aca2-d261591ea7e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186521857}] :answer-field/correct {:answer/id #uuid "92e10c0d-3823-528f-87a3-277e9336972f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186521824} :answer-field/id #uuid "e9e874dd-4e18-58ae-af29-7f29c7c49fd9" :answer-field/key "$(0,4)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186521864}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "638eb9ae-09f8-5fce-b7bc-2aac37c3181f" :question/problem "At which points on the curve $8 x y + 2 y^{2}=16 x^{2} + 48$ is the tangent vector to the curve perpendicular to the vector $j$?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "First, we bring all variables to one side:\n\n$$\\begin{aligned}8 x y + 2 y^{2}&=16 x^{2} + 48\\\\- 16 x^{2} + 8 x y + 2 y^{2} - 48&=0\\end{aligned}$$\n\nIf we set $f(x,y)=- 16 x^{2} + 8 x y + 2 y^{2} - 48$, our curve can be viewed as the level curve $f(x,y)=0.$\n\nA tangent vector to the level curve can be computed as follows:\n\n$$t(x,y)=f_y(x,y)\\,i-f_x(x,y)\\,j$$\n\nSo, we calculate $t(x,y):$\n\n$$\\begin{aligned}t(x,y)&=\\frac{∂}{∂y}(- 16 x^{2} + 8 x y + 2 y^{2} - 48)\\,i-\\frac{∂}{∂x}(- 16 x^{2} + 8 x y + 2 y^{2} - 48)\\,j\\\\&=(8 x + 4 y)\\,i-(- 32 x + 8 y)\\,j\\end{aligned}$$\n\nSince our tangent vector needs to be perpendicular to $j$, we must have $t\\cdot j=0.$\n\n$$\\begin{aligned}t(x,y)\\cdot j&=0\\\\32 x - 8 y&=0\\\\y&=4x\\end{aligned}$$\n\nSubstituting $y=4x$ into the equation of our curve gives:\n\n$$\\begin{aligned}2(4x)^{2}+8x(4x)-16x^{2}-48&=0\\\\48x^{2}-48&=0\\\\x^{2}&=1\\\\x&=\\pm 1\\end{aligned}$$\n\nFinally, the corresponding points are $(1,4)$ and $(-1,-4)$."} {:db/id #edb/ref 17592186521870 :knowledge-point/_questions [{:db/id #edb/ref 17592186124456 :knowledge-point/id #uuid "84245283-3cf9-5889-8c42-896a0c8af291" :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f4e1d8e-84d6-5a20-9c01-8ae98987f8dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186521811} {:answer/id #uuid "c087c404-166b-5d66-9df7-23a64d6373c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186521847}] :answer-field/correct {:answer/id #uuid "c087c404-166b-5d66-9df7-23a64d6373c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186521847} :answer-field/id #uuid "01392b38-8c9f-501e-947f-a711423a8b27" :answer-field/key "$(2,2)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186521746} {:answer-field/choices [{:answer/id #uuid "355d6b08-c81d-5a24-8d9b-b5b309763df3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186521781} {:answer/id #uuid "b9468b67-fe8b-596a-b36c-8a9160644e13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186521844}] :answer-field/correct {:answer/id #uuid "355d6b08-c81d-5a24-8d9b-b5b309763df3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186521781} :answer-field/id #uuid "068014f6-160c-5582-b4e9-027adae7c44d" :answer-field/key "$(0,4)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186521749} {:answer-field/choices [{:answer/id #uuid "79fd7a02-7f40-548d-8d9e-67af6ec26c31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186521818} {:answer/id #uuid "91d5a3b4-81a9-5029-bfc7-fff806ff92c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186521823}] :answer-field/correct {:answer/id #uuid "91d5a3b4-81a9-5029-bfc7-fff806ff92c3" :answer/type {:db/id #edb/ref 17592186045499