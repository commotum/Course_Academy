rac{9}{5} & \\frac{6}{5}\\end{bmatrix}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "- First, we check whether $EF=FE={I}_{2}.$ Computing $EF$, we get\n\n$$\n\\begin{aligned}EF & =\\begin{bmatrix}1 & -1 \\\\ \\frac{3}{2} & -\\frac{2}{3}\\end{bmatrix}\\begin{bmatrix}-\\frac{4}{5} & \\frac{6}{5} \\\\ -\\frac{9}{5} & \\frac{6}{5}\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $FE$, we get\n\n$$\n\\begin{aligned}FE & =\\begin{bmatrix}-\\frac{4}{5} & \\frac{6}{5} \\\\ -\\frac{9}{5} & \\frac{6}{5}\\end{bmatrix}\\begin{bmatrix}1 & -1 \\\\ \\frac{3}{2} & -\\frac{2}{3}\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nSo, statement $EF=FE={I}_{2}$ is true.\n\n- Now, we check whether $EG=GE={I}_{2}.$ Computing $EG$, we get\n\n$$\n\\begin{aligned}EG & =\\begin{bmatrix}1 & -1 \\\\ \\frac{3}{2} & -\\frac{2}{3}\\end{bmatrix}\\begin{bmatrix}\\frac{4}{5} & \\frac{6}{5} \\\\ -\\frac{9}{5} & \\frac{6}{5}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{13}{5} & ∗ \\\\ ∗ & ∗\\end{bmatrix} \\\\  & \\ne {I}_{2}.\\,\\times \\end{aligned}\n$$\n\nSo, statement $EG=GE={I}_{2}$ is false. As a result, $G\\ne {E}^{-1}$ and statement $G={E}^{-1}$ is false too.\n\nTherefore, the correct answer is $EF=FE={I}_{2}$ only."} {:db/id #edb/ref 17592186557744 :knowledge-point/_questions [{:db/id #edb/ref 17592186087699 :knowledge-point/id #uuid "9b9ef325-2358-5041-8a8d-b459e8ed9f09" :knowledge-point/title "Determining the Inverse of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af6e0e43-fe72-533d-8ce8-b52921a85d3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186557759} {:answer/id #uuid "bd898e4d-5a1c-5b90-9026-8badc38ea15a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/t