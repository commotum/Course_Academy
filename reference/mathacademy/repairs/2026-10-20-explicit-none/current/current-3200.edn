36d-5f20-8ec0-3f9fe730ae60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186637703} :answer-field/id #uuid "e281b4f4-8172-5ef9-9e58-b1ba0a37caff" :answer-field/key "$3x+9=3x+9$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186637739}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ed69da33-8874-57af-9e3e-0f4e5cc3ed7b" :question/problem "Which of the following equations has infinitely many solutions?\n\nSelect all that apply." :question/worked-solution "Let's attempt to solve each equation in turn:\n\n- For the first equation, we have\n\n$$\n\\begin{aligned}-2x+1 & =-3x-1 \\\\ -2x+1+3x & =-3x-1+3x \\\\ x+1 & =-1 \\\\ x+1-1 & =-1-1 \\\\ x & =-2.\\end{aligned}\n$$\n\nTherefore, the equation $-2x+1=-3x-1$ has the unique solution $x=-2.$\n\n- For the second equation, we have\n\n$$\n\\begin{aligned}-x+1 & =-2x+1 \\\\ -x+1+2x & =-2x+1+2x \\\\ x+1 & =1 \\\\ x+1-1 & =1-1 \\\\ x & =0.\\end{aligned}\n$$\n\nTherefore, the equation $-x+1=-2x+1$ has the unique solution $x=0.$\n\n- For the third equation, we have\n\n$$\n\\begin{aligned}3x+9 & =3x+9 \\\\ 3x+9-3x & =3x+9-3x \\\\ 9 & =9.\\end{aligned}\n$$\n\nThis equation is true for all values of $x.$ Therefore, the equation $3x+9=3x+9$ has infinitely many solutions.\n\nTherefore, the correct answer is $3x+9=3x+9$ only."} {:db/id #edb/ref 17592186637743 :knowledge-point/_questions [{:db/id #edb/ref 17592186110719 :knowledge-point/id #uuid "ff4e9141-5743-55f1-a8be-3e28cb047eca" :knowledge-point/title "Identifying Equations With Infinitely Many Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70847084-8e8f-5e65-b624-5cb02831b5d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186637717} {:answer/id #uuid "e8684863-18a3-5ee1-9840-b5312864f