b/id #edb/ref 17592186628616}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3f3a2b79-75e1-5091-907c-0c44e8f36d34" :question/problem "![](images/7b/7b1496185812c5663cf8e07b02a8e51f9c3b07393d4c08d988cbf1fcd3179a06.png)\n\nConsider the diagram that is shown above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "- Statement I is true. The vectors $d$ and $e$ are parallel and have opposite directions. The magnitude of $d$ is $2$ times the magnitude of $e$. So, $d=-2e$.\n\n- Statement II is false. The vectors $a$ and $b$ are parallel and have the same direction. The magnitude of $a$ is $1$ times the magnitude of $b$. So, $a\\ne -b$.\n\n- Statement III is false. The vectors $d$ and $e$ are parallel and have opposite directions. The magnitude of $d$ is $2$ times the magnitude of $e$. So, $d\\ne 2e$.\n\nTherefore, only statement I is true."} {:db/id #edb/ref 17592186628589 :knowledge-point/_questions [{:db/id #edb/ref 17592186096700 :knowledge-point/id #uuid "dc5bab6c-1ce7-58b5-a59d-cff2ce35ecca" :knowledge-point/title "Identifying Parallel Vectors From a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b8dfad6-c081-53b4-aaa0-2e834483cc46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186628586} {:answer/id #uuid "6df7ba2d-a2db-5442-b586-0e76962bcc46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186628592}] :answer-field/correct {:answer/id #uuid "6df7ba2d-a2db-5442-b586-0e76962bcc46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186628592} :answer-field/id #uuid "27cc2e80-c5bb-53e5-8327-20592dc86c6e" :answer-field/key "$b=-\\frac{1}{2}d$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186628582} {:answer-field/choices [{:answer/id #uuid "1a76f318-9136-5ad7-a463-aa64f570a28c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186628579} {:answer/id #uuid "dd62623f-e10f-59e5-82de-e1b025bb8248" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186628610}] :answer-field/correct {:answer/id #uuid "dd62623f-e10f-59e5-82de-e1b025bb8248" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186628610} :answer-field/id #uuid "6867fa8d-25eb-5c06-a45e-330141e360cd" :answer-field/key "$a=e$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186628591} {:answer-field/choices [{:answer/id #uuid "403938a3-9935-53ed-bd80-1df23fc797d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186628584} {:answer/id #uuid "af92a61b-92f1-5f91-83c1-7c6752a3458b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186628604}] :answer-field/correct {:answer/id #uuid "af92a61b-92f1-5f91-83c1-7c6752a3458b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186628604} :answer-field/id #uuid "bc6ba19f-647e-5cb0-ab75-03ba29feb426" :answer-field/key "$d=-b$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186628606}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5edf6afc-78ce-5695-b6e3-1a33f6ac3097" :question/problem "![](images/b6/b6c26d5365880d39ef1e5170dbfad0632ca60735727a6779b20059f7b18e8687.png)\n\nConsider the diagram that is shown above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "- Statement I is false. The vectors $d$ and $b$ are parallel and have opposite directions. The magnitude of $d$ is $2$ times the magnitude of $b$. So, $d\\ne -b$.\n\n- Statement II is true. The vectors $b$ and $d$ are parallel and have opposite directions. The magnitude of $b$ is $\\frac{1}{2}$ times the magnitude of $d$. So, $b=-\\frac{1}{2}d$.\n\n- Statement III is false. The vectors $a$ and $e$ are parallel and have the same direction. The magnitude of $a$ is $2$ times the magnitude of $e$. So, $a\\ne e$.\n\nTherefore, only statement II is true."} {:db/id #edb/ref 17592186630378 :knowledge-point/_questions [{:db/id #edb/ref 17592186204089 :knowledge-point/id #uuid "d6226fdb-ee73-5a78-87d5-9d6a988a9eb4" :knowledge-point/title "Identifying an Equation With No Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4af2a62-3792-595f-9282-d1bda7b15577" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186630391} {:answer/id #uuid "ecf7ad2d-0023-5296-97f5-a6ec3f98ff3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186630398}] :answer-field/correct {:answer/id #uuid "c4af2a62-3792-595f-9282-d1bda7b15577" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186630391} :answer-field/id #uuid "16aa0189-d34d-5c5f-ab41-abbd86d393c8" :answer-field/key "$3z-8=2z-8$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186630361} {:answer-field/choices [{:answer/id #uuid "18c12ae6-1a37-5feb-bcd4-fccdc5dbcbce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186630362} {:answer/id #uuid "9d0da22c-6746-5d5e-9548-a2ca2ef6b8ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186630382}] :answer-field/correct {:answer/id #uuid "18c12ae6-1a37-5feb-bcd4-fccdc5dbcbce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186630362} :answer-field/id #uuid "99bd0dbd-bdf0-5727-aa4f-5eacef78a786" :answer-field/key "$3z+4=3z-9$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186630381} {:answer-field/choices [{:answer/id #uuid "6c37db4e-f4be-56be-b41e-c91f76f3fb5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186630374} {:answer/id #uuid "9e7008ac-0eaf-5100-b8dc-4cb153e1a76a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186630383}] :answer-field/correct {:answer/id #uuid "9e7008ac-0eaf-5100-b8dc-4cb153e1a76a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186630383} :answer-field/id #uuid "afae95da-ff11-53d9-a5a1-1019107583ae" :answer-field/key "$6z-2=6z-2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186630385}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8615f13e-2cad-55d9-82ec-ce70ea9ef1d4" :question/problem "Which of the following equations has no solutions?\n\nSelect all that apply." :question/worked-solution "Let's attempt to solve each equation in turn:\n\n- For the first equation, we have\n\n$$\n\\begin{aligned}3z+4 & =3z-9 \\\\ 3z+4-3z & =3z-9-3z \\\\ 4 & =-9.\\end{aligned}\n$$\n\nThis equation is false for all values of $z.$ Therefore, the equation $3z+4=3z-9$ has no solutions.\n\n- For the second equation, we have\n\n$$\n\\begin{aligned}3z-8 & =2z-8 \\\\ 3z-8-2z+8 & =2z-8-2z+8 \\\\ z & =0.\\end{aligned}\n$$\n\nTherefore, the equation $3z-8=2z-8$ has the unique solution $z=0.$\n\n- For the third equation, we have\n\n$$\n\\begin{aligned}6z-2 & =6z-2 \\\\ 6z-2-6z & =6z-2-6z \\\\ -2 & =-2.\\end{aligned}\n$$\n\nThis equation is true for all values of $z.$\n\nTherefore, the correct answer is $3z+4=3z-9$ only."} {:db/id #edb/ref 17592186630384 :knowledge-point/_questions [{:db/id #edb/ref 17592186204089 :knowledge-point/id #uuid "d6226fdb-ee73-5a78-87d5-9d6a988a9eb4" :knowledge-point/title "Identifying an Equation With No Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50e6670e-180e-55a0-b18e-0922e2e97809" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186630371} {:answer/id #uuid "d97135be-b92c-559b-9d4e-5c34faebb167" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186630395}] :answer-field/correct {:answer/id #uuid "50e6670e-180e-55a0-b18e-0922e2e97809" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186630371} :answer-field/id #uuid "14d0a397-197d-5aab-b9e1-bc4bad6c44d3" :answer-field/key "$9w+2=9w+8$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186630359} {:answer-field/choices [{:answer/id #uuid "1ee77d47-a6b6-5536-8457-c52445bbf3c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186630363} {:answer/id #uuid "be11c056-4e68-538c-9553-ec9eb602cabd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186630390}] :answer-field/correct {:answer/id #uuid "1ee77d47-a6b6-5536-8457-c52445bbf3c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186630363} :answer-field/id #uuid "dee649e1-c80f-54b6-a54c-69cc3233f3b4" :answer-field/key "$w-1=w-1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186630397} {:answer-field/choices [{:answer/id #uuid "d0f766cc-784d-5b88-a9d8-190a2c915197" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186630393} {:answer/id #uuid "ef13351f-851f-55b9-9cf9-c1d4d3c8b958" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186630399}] :answer-field/correct {:answer/id #uuid "d0f766cc-784d-5b88-a9d8-190a2c915197" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186630393} :answer-field/id #uuid "fb856950-f08c-5d85-b9a4-33c124184b0c" :answer-field/key "$3w-1=2w+9$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186630401}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a0773bfc-4558-5740-8e1c-f626fb0f4cac" :question/problem "Which of the following equations has no solutions?\n\nSelect all that apply." :question/worked-solution "Let's attempt to solve each equation in turn:\n\n- For the first equation, we have\n\n$$\n\\begin{aligned}9w+2 & =9w+8 \\\\ 9w+2-9w & =9w+8-9w \\\\ 2 & =8.\\end{aligned}\n$$\n\nThis equation is false for all values of $w.$ Therefore, the equation $9w+2=9w+8$ has no solutions.\n\n- For the second equation, we have\n\n$$\n\\begin{aligned}3w-1 & =2w+9 \\\\ 3w-1-2w+1 & =2w+9-2w+1 \\\\ w & =10.\\end{aligned}\n$$\n\nTherefore, the equation $3w-1=2w+9$ has the unique solution $w=10.$\n\n- For the third equation, we have\n\n$$\n\\begin{aligned}w-1 & =w-1 \\\\ w-1-w & =w-1-w \\\\ -1 & =-1.\\end{aligned}\n$$\n\nThis equation is true for all values of $w.$\n\nTherefore, the correct answer is $9w+2=9w+8$ only."} {:db/id #edb/ref 17592186630389 :knowledge-point/_questions [{:db/id #edb/ref 17592186204089 :knowledge-point/id #uuid "d6226fdb-ee73-5a78-87d5-9d6a988a9eb4" :knowledge-point/title "Identifying an Equation With No Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53cd0626-f4e5-5c62-883d-ad24dafdbf10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186630372} {:answer/id #uuid "b4360d65-2f69-5959-99fd-706197ce1df5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186630387}] :answer-field/correct {:answer/id #uuid "b4360d65-2f69-5959-99fd-706197ce1df5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186630387} :answer-field/id #uuid "0283e575-f7c6-5070-9e28-9f7841f93823" :answer-field/key "$-5z+6=9z+7$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186630357} {:answer-field/choices [{:answer/id #uuid "780fd271-d029-5228-b794-e279facdde6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186630375} {:answer/id #uuid "fd2fa7c7-57ba-572e-a7f3-c63022427804" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186630402}] :answer-field/correct {:answer/id #uuid "780fd271-d029-5228-b794-e279facdde6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186630375} :answer-field/id #uuid "45c1a7d1-21a8-5356-a49c-0ab85cd81ffc" :answer-field/key "$-7z+9=-7z+9$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186630369} {:answer-field/choices [{:answer/id #uuid "2dd0c986-fdf0-5ff5-88e5-a005724244e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186630365} {:answer/id #uuid "b7c4819e-3619-5b48-b872-94671551c4df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186630388}] :answer-field/correct {:answer/id #uuid "2dd0c986-fdf0-5ff5-88e5-a005724244e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186630365} :answer-field/id #uuid "c6296706-ad4d-54f8-967e-2cce22fde564" :answer-field/key "$5z+6=5z-8$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186630392}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bc996c97-d552-5421-8abc-e89e11fdf1d2" :question/problem "Which of the following equations has no solutions?\n\nSelect all that apply." :question/worked-solution "Let's attempt to solve each equation in turn:\n\n- For the first equation, we have\n\n$$\n\\begin{aligned}-5z+6 & =9z+7 \\\\ -5z+6-9z-6 & =9z+7-9z-6 \\\\ -14z & =1 \\\\ z & =- \\frac{1}{14}.\\end{aligned}\n$$\n\nTherefore, the equation $-5z+6=9z+7$ has the unique solution $z=- \\frac{1}{14}.$\n\n- For the second equation, we have\n\n$$\n\\begin{aligned}5z+6 & =5z-8 \\\\ 5z+6-5z & =5z-8-5z \\\\ 6 & =-8.\\end{aligned}\n$$\n\nThis equation is false for all values of $z.$ Therefore, the equation $5z+6=5z-8$ has no solutions.\n\n- For the third equation, we have\n\n$$\n\\begin{aligned}-7z+9 & =-7z+9 \\\\ -7z+9+7z & =-7z+9+7z \\\\ 9 & =9.\\end{aligned}\n$$\n\nThis equation is true for all values of $z.$\n\nTherefore, the correct answer is $5z+6=5z-8$ only."} {:db/id #edb/ref 17592186630394 :knowledge-point/_questions [{:db/id #edb/ref 17592186204089 :knowledge-point/id #uuid "d6226fdb-ee73-5a78-87d5-9d6a988a9eb4" :knowledge-point/title "Identifying an Equation With No Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "126b56ea-5c68-5b85-84d1-f57cc71b9e2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186630358} {:answer/id #uuid "4206dcd0-6c01-5c63-a3ef-ca784c6b7a67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186630367}] :answer-field/correct {:answer/id #uuid "4206dcd0-6c01-5c63-a3ef-ca784c6b7a67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186630367} :answer-field/id #uuid "40a2524e-0688-51c9-b57d-23b0f6d12c59" :answer-field/key "$4u-3=4u-3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186630366} {:answer-field/choices [{:answer/id #uuid "8c6077d8-016f-5bbb-8ae1-849bf8dccdc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186630380} {:answer/id #uuid "fb6104b5-9387-5770-adad-69f18c5cd1a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186630400}] :answer-field/correct {:answer/id #uuid "8c6077d8-016f-5bbb-8ae1-849bf8dccdc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186630380} :answer-field/id #uuid "6120e812-ea27-50d9-8568-e27acf95252f" :answer-field/key "$-3u-1=-3u-9$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186630373} {:answer-field/choices [{:answer/id #uuid "b1653a0e-4c4b-5d0f-8562-3c40d651246c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186630386} {:answer/id #uuid "da2121e2-964e-55f7-8377-e320e5063195" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186630396}] :answer-field/correct {:answer/id #uuid "b1653a0e-4c4b-5d0f-8562-3c40d651246c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186630386} :answer-field/id #uuid "83b90f20-acbe-522a-8f7d-4f200be37c83" :answer-field/key "$-5u+6=2u+5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186630377}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d6cdf0b2-935c-5ad7-83db-19a65c3ed2cd" :question/problem "Which of the following equations has no solutions?\n\nSelect all that apply." :question/worked-solution "Let's attempt to solve each equation in turn:\n\n- For the first equation, we have\n\n$$\n\\begin{aligned}-3u-1 & =-3u-9 \\\\ -3u-1+3u & =-3u-9+3u \\\\ -1 & =-9.\\end{aligned}\n$$\n\nThis equation is false for all values of $u.$ Therefore, the equation $-3u-1=-3u-9$ has no solutions.\n\n- For the second equation, we have\n\n$$\n\\begin{aligned}-5u+6 & =2u+5 \\\\ -5u+6-2u-6 & =2u+5-2u-6 \\\\ -7u & =-1 \\\\ u & =\\frac{1}{7}.\\end{aligned}\n$$\n\nTherefore, the equation $-5u+6=2u+5$ has the unique solution $u=\\frac{1}{7}.$\n\n- For the third equation, we have\n\n$$\n\\begin{aligned}4u-3 & =4u-3 \\\\ 4u-3-4u & =4u-3-4u \\\\ -3 & =-3.\\end{aligned}\n$$\n\nThis equation is true for all values of $u.$\n\nTherefore, the correct answer is $-3u-1=-3u-9$ only."} {:db/id #edb/ref 17592186633751 :knowledge-point/_questions [{:db/id #edb/ref 17592186100869 :knowledge-point/id #uuid "b494140f-206a-5317-8079-ff719a253140" :knowledge-point/title "Determining Whether Two Matrices Are Conformable for Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e1ffd3e-c48f-558d-aa8d-3e75a6661f28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186633775} {:answer/id #uuid "fa98ceba-4e20-545b-a8b6-e6b23548b57e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186633795}] :answer-field/correct {:answer/id #uuid "fa98ceba-4e20-545b-a8b6-e6b23548b57e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186633795} :answer-field/id #uuid "46002f51-18ad-5493-99ac-c8123b46346f" :answer-field/key "The product $LM$ is well defined." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186633757} {:answer-field/choices [{:answer/id #uuid "e31e702d-9db2-53a1-9b0f-da9b27b0d379" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186633791} {:answer/id #uuid "ffafa2d0-a964-5189-9e6e-4c5c83fbacc2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186633797}] :answer-field/correct {:answer/id #uuid "e31e702d-9db2-53a1-9b0f-da9b27b0d379" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186633791} :answer-field/id #uuid "654d0d50-70b7-58aa-8358-c688c0e3b152" :answer-field/key "The product $LN$ is well defined." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186633763} {:answer-field/choices [{:answer/id #uuid "14e9bcd1-f954-56e6-a7aa-d192a97f7c31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186633750} {:answer/id #uuid "a17b61ca-3bd1-57f0-8c42-0f2177282c49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186633778}] :answer-field/correct {:answer/id #uuid "14e9bcd1-f954-56e6-a7aa-d192a97f7c31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186633750} :answer-field/id #uuid "6dd6bf05-ea63-5da4-8371-ec8f95bde336" :answer-field/key "The product $MN$ is well defined." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186633766}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "17ef30d9-8db1-5397-afeb-61eb1b5c4bd5" :question/problem "<div class=\"matrix-operands\">\n<div>$L=\\begin{bmatrix}0 & -6 & -9 & 0 \\\\ -7 & -9 & 1 & -8 \\\\ -9 & 6 & -9 & -9\\end{bmatrix}$</div>\n<div>$M=\\begin{bmatrix}-9 & -9 & -4 \\\\ -9 & 0 & -3 \\\\ 6 & 4 & 8 \\\\ -9 & 7 & 6\\end{bmatrix}$</div>\n<div>$N=\\begin{bmatrix}-2 & 2 & -9 & 2 \\\\ -6 & -3 & 4 & 9 \\\\ -3 & 3 & 9 & -9 \\\\ 4 & 2 & 4 & 8\\end{bmatrix}$</div>\n</div>\n\nWhich of the following statements are true regarding the matrices $L,M,$ and $N?$\n\nSelect all that apply." :question/worked-solution "Notice that $L$ is a $3\\times 4$ matrix, $M$ is a $4\\times 3$ matrix, and $N$ is a $4\\times 4$ matrix.\n\nThere are $4$ columns in $L$ and $4$ rows in $N.$ Since the number of columns in $L$ equals the number of rows in $N,$ the matrices $L$ and $N$ are conformable for multiplication:\n\n$$\n{L}_{3\\times \\boxed{\\text{4}}}{\\times }_{✓}{N}_{\\boxed{\\text{4}}\\times 4}=\\text{well defined}\n$$\n\nOn the other hand, there are $3$ columns in $M$ and $4$ rows in $N.$ Since the number of columns in $M$ does **not** equal the number of rows in $N,$ the matrices $M$ and $N$ are **not** conformable for multiplication:\n\n$$\n{M}_{4\\times 3}{\\times }_{\\ne }{N}_{4\\times 4}=\\text{undefined}\n$$\n\nFinally, there are $4$ columns in $L$ and $4$ rows in $M.$ Since the number of columns in $L$ equals the number of rows in $M,$ the matrices $L$ and $M$ are conformable for multiplication:\n\n$$\n{L}_{3\\times \\boxed{\\text{4}}}{\\times }_{✓}{M}_{\\boxed{\\text{4}}\\times 3}=\\text{well defined}\n$$\n\nThe products $LN$ and $LM$ are well defined. The product $MN$ is undefined."} {:db/id #edb/ref 17592186633774 :knowledge-point/_questions [{:db/id #edb/ref 17592186100869 :knowledge-point/id #uuid "b494140f-206a-5317-8079-ff719a253140" :knowledge-point/title "Determining Whether Two Matrices Are Conformable for Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8616389b-02a2-540f-a566-c2a3523d934a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186633769} {:answer/id #uuid "cb5c51df-9c98-5a4c-bbbc-2a4c59714c5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186633788}] :answer-field/correct {:answer/id #uuid "cb5c51df-9c98-5a4c-bbbc-2a4c59714c5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186633788} :answer-field/id #uuid "67983946-00e4-507b-921b-3885e56c3057" :answer-field/key "The product $ZX$ is well defined." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186633764} {:answer-field/choices [{:answer/id #uuid "200587ba-1189-5553-9a29-4d828e285877" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186633752} {:answer/id #uuid "a0781e7f-d05d-5d5a-9010-f2d4f6eeecad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186633777}] :answer-field/correct {:answer/id #uuid "a0781e7f-d05d-5d5a-9010-f2d4f6eeecad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186633777} :answer-field/id #uuid "cd1b4788-6d11-51c5-93f5-02ebd9fc36cc" :answer-field/key "The product $XY$ is well defined." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186633789} {:answer-field/choices [{:answer/id #uuid "64e1d4cf-645e-52c4-a511-86e686e825db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186633762} {:answer/id #uuid "c41f1d15-c933-5084-a65a-6064feeb9695" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186633787}] :answer-field/correct {:answer/id #uuid "64e1d4cf-645e-52c4-a511-86e686e825db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186633762} :answer-field/id #uuid "e1ced5c5-b750-53d7-bc75-2f0ddc7cd9ad" :answer-field/key "The product $ZY$ is well defined." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186633790}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "917bc76f-87c3-5d04-9d95-1a2d87f13526" :question/problem "<div class=\"matrix-operands\">\n<div>$X=\\begin{bmatrix}0 & 0 & -4 \\\\ 1 & -1 & 0\\end{bmatrix}$</div>\n<div>$Y=\\begin{bmatrix}-2 & 8 \\\\ 4 & 6 \\\\ -1 & 4 \\\\ -7 & 4\\end{bmatrix}$</div>\n<div>$Z=\\begin{bmatrix}-6 & -8 & -7 & -2 \\\\ -1 & -4 & -6 & 0\\end{bmatrix}$</div>\n</div>\n\nWhich of the following statements are true regarding the matrices $X,Y,$ and $Z?$\n\nSelect all that apply." :question/worked-solution "Notice that $X$ is a $2\\times 3$ matrix, $Y$ is a $4\\times 2$ matrix, and $Z$ is a $2\\times 4$ matrix.\n\nThere are $4$ columns in $Z$ and $4$ rows in $Y.$ Since the number of columns in $Z$ equals the number of rows in $Y,$ the matrices $Z$ and $Y$ are conformable for multiplication:\n\n$$\n{Z}_{2\\times \\boxed{\\text{4}}}{\\times }_{✓}{Y}_{\\boxed{\\text{4}}\\times 2}=\\text{well defined}\n$$\n\nOn the other hand, there are $4$ columns in $Z$ and $2$ rows in $X.$ Since the number of columns in $Z$ does **not** equal the number of rows in $X,$ the matrices $Z$ and $X$ are **not** conformable for multiplication:\n\n$$\n{Z}_{2\\times 4}{\\times }_{\\ne }{X}_{2\\times 3}=\\text{undefined}\n$$\n\nFinally, there are $3$ columns in $X$ and $4$ rows in $Y.$ Since the number of columns in $X$ does **not** equal the number of rows in $Y,$ the matrices $X$ and $Y$ are **not** conformable for multiplication:\n\n$$\n{X}_{2\\times 3}{\\times }_{\\ne }{Y}_{4\\times 2}=\\text{undefined}\n$$\n\nThe product $ZY$ is well defined. The products $ZX$ and $XY$ are undefined."} {:db/id #edb/ref 17592186633779 :knowledge-point/_questions [{:db/id #edb/ref 17592186100869 :knowledge-point/id #uuid "b494140f-206a-5317-8079-ff719a253140" :knowledge-point/title "Determining Whether Two Matrices Are Conformable for Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ce4976c-e270-5524-b8bb-5bf1c8eb9025" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186633754} {:answer/id #uuid "fdcda7a9-06e4-5e5f-9dd2-5bd14d869476" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186633796}] :answer-field/correct {:answer/id #uuid "3ce4976c-e270-5524-b8bb-5bf1c8eb9025" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186633754} :answer-field/id #uuid "4f3b0c03-0e74-5d07-9d68-adaca68ae2f0" :answer-field/key "The product $TR$ is well defined." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186633760} {:answer-field/choices [{:answer/id #uuid "49abf4b9-b4ba-57be-aae1-66b114594b91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186633758} {:answer/id #uuid "5b92a91e-5aba-56ba-a382-9b930e2156a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref