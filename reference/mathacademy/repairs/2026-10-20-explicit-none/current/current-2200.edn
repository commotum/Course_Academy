r.type/text} :answer/value "true" :db/id #edb/ref 17592186470756}] :answer-field/correct {:answer/id #uuid "ec2b6e59-51a2-50f2-b695-fd346c52be27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470756} :answer-field/id #uuid "558da726-8b6e-5711-9276-1607b83bb232" :answer-field/key "$f$ is not an injection" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471883}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4be96f58-f72b-5ffd-a1b3-6817c52a2536" :question/math-academy-id "q-105122" :question/problem "![](images/80/80b80ea901c031439e50f42b34146401c75c65f9947ecca75ee8afda94540465.png)\n\nWhich of the following statements are true regarding the function $f:X\\to Y$ represented by the mapping diagram above?\n\nSelect all that apply." :question/worked-solution "A function $f:X\\to Y$ is an injection (also known as *one-to-one*) if *every* element in $X$ is mapped to a *distinct* element in $Y:$ \n\n$f:X\\to Y$ is an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement $f(4)\\ne f(8)$ is false. According to the diagram, we have $f(4)=1$ (we have an arrow from $4\\in X$ to $1\\in Y$) and $f(8)=1$ (we have an arrow from $8\\in X$ to $1\\in Y$).\n\n- Statement “$∀\\,{x}_{1},{x}_{2}\\in X,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}$” is false. According to the diagram, $f(4)=f(8)$ but $4\\ne 8.$ So, it's *not true* that for all ${x}_{1}$ and ${x}_{2}$ contained within the domain $X,$ if $f({x}_{1})$ and $f({x}_{2})$ are equal, then we must have ${x}_{1}={x}_{2}.$\n\n- Statement “$f$ is not an injection” is true. Indeed, since statement “$∀\\,{x}_{1},{x}_{2}\\in X,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}$” is false, $f$ is not an injection.\n\nTherefore, the correct answer is “$f$ is not an injection” only."} {:db/id #edb/ref 17592186380497 :knowledge-point/_questions [{:db/id #edb/ref 17592186152194 :knowledge-point/id #uuid "c805415f-c87d-50c5-b668-948fc46bcc7e" :knowledge-point/title "Identifying Injections For Functions Defined as Mapping Diagrams"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be3f6384-46cc-5ed8-9c8c-ef1ad8d65f89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470757} {:answer/id #uuid "fea77437-0761-570c-ad2d-f2af8587aff9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470758}] :answer-field/correct {:answer/id #uuid "be3f6384-46cc-5ed8-9c8c-ef1ad8d65f89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470757} :answer-field/id #uuid "c17c6dd8-60af-5e6d-8ed2-bc95512a4791" :answer-field/key "$f(-4)=f(-1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471884} {:answer-field/choices [{:answer/id #uuid "5b7fb7c4-c8f4-53e5-ba71-112e2e865e0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470759} {:answer/id #uuid "6f78400c-9000-58fe-86f0-9ae3b772a8fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470760}] :answer-field/correct {:answer/id #uuid "6f78400c-9000-58fe-86f0-9ae3b772a8fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470760} :answer-field/id #uuid "f7a6a6c3-e74a-5b4f-aebd-06b68ccc1254" :answer-field/key "$∀\\,{x}_{1},{x}_{2}\\in X,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471885} {:answer-field/choices [{:answer/id #uuid "1e00233b-77b7-54ff-af65-764581ffc212" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470761} {:answer/id #uuid "26382a75-8efa-5860-ab12-8c7bb883db31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470762}] :answer-field/correct {:answer/id #uuid "26382a75-8efa-5860-ab12-8c7bb883db31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470762} :answer-field/id #uuid "39deede4-882c-55c8-b539-19fcd3e2e5a6" :answer-field/key "$f$ is **one-to-one**" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471886}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3ef9f00e-29d5-5bdb-ace6-5ec77b1eb401" :question/math-academy-id "q-105126" :question/problem "![](images/3c/3cfee09c9688df45bd12654a1847ab9a2e9a311289e89dc52441abbb239138ed.png)\n\nWhich of the following statements are true regarding the function $f:X\\to Y$ represented by the mapping diagram above?\n\nSelect all that apply." :question/worked-solution "A function $f:X\\to Y$ is an injection (also known as *one-to-one*) if *every* element in $X$ is mapped to a *distinct* element in $Y:$ \n\n$f:X\\to Y$ is an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement $f(-4)=f(-1)$ is false. According to the diagram, we have $f(-4)=8$ (we have an arrow from $-4\\in X$ to $8\\in Y$) and $f(-1)=0$ (we have an arrow from $-1\\in X$ to $0\\in Y$).\n\n- Statement “$∀\\,{x}_{1},{x}_{2}\\in X,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}$” is true. As we can see from the diagram, there are no two distinct elements within $X$ that map to the same element in $Y.$ So, for all ${x}_{1}$ and ${x}_{2}$ contained within the domain $X,$ if $f({x}_{1})$ and $f({x}_{2})$ are equal, then we must have ${x}_{1}={x}_{2}.$\n\n- Statement “$f$ is **one-to-one**” is true. Indeed, since statement “$∀\\,{x}_{1},{x}_{2}\\in X,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}$” is true, $f$ is an injection (also known as *one-to-one*).\n\nTherefore, the correct answer is “$∀\\,{x}_{1},{x}_{2}\\in X,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}$”; “$f$ is **one-to-one**” only."} {:db/id #edb/ref 17592186380504 :knowledge-point/_questions [{:db/id #edb/ref 17592186152196 :knowledge-point/id #uuid "a347133c-5e5a-5dd2-89ef-bdd14245ee6b" :knowledge-point/title "Identifying Injections For Functions Defined on the Set of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "068ce277-2dbb-5270-87d7-a9bf5998c027" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470763} {:answer/id #uuid "d4731f22-b39d-57c8-969c-7f40b568c88c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470764}] :answer-field/correct {:answer/id #uuid "068ce277-2dbb-5270-87d7-a9bf5998c027" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470763} :answer-field/id #uuid "83afe26b-6790-547e-8093-0355641216d1" :answer-field/key "$f(-1)=f(1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471887} {:answer-field/choices [{:answer/id #uuid "f305f64e-7b6e-5547-9ece-e4bcb24d1f9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470765} {:answer/id #uuid "c6d919d9-bbe0-50cc-aa03-4680f115cece" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470766}] :answer-field/correct {:answer/id #uuid "c6d919d9-bbe0-50cc-aa03-4680f115cece" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470766} :answer-field/id #uuid "07d8b228-b9d6-5b5b-ae1d-af5673b9e56a" :answer-field/key "$∀\\,{x}_{1},{x}_{2}\\in R,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471888} {:answer-field/choices [{:answer/id #uuid "15787f80-103f-5fa7-af89-b14fbfb7e6e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470767} {:answer/id #uuid "b000e7ec-537f-54d9-af57-b9218d4e3905" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470768}] :answer-field/correct {:answer/id #uuid "b000e7ec-537f-54d9-af57-b9218d4e3905" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470768} :answer-field/id #uuid "06f0bf7a-4d0e-5b1d-a0f1-47b84b8413b5" :answer-field/key "$f$ is an injection" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471889}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a95fdab7-b3ba-5047-982f-ba6ecacd47b0" :question/math-academy-id "q-105129" :question/problem "![](images/2a/2a60bc27e7227cfe55c03611608e5210ad147d07058028e4ea78b10a96280797.png)\n\nWhich of the following statements are true regarding the function $f:R\\to R$ whose graph is shown above?\n\nSelect all that apply." :question/worked-solution "A function $f:X\\to Y$ is an injection (also known as *one-to-one*) if *every* element in $X$ is mapped to a *distinct* element in $Y:$ \n\n$f:X\\to Y$ is an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement $f(-1)=f(1)$ is false. According to the graph, we have $f(-1)=1$ and $f(1)=3.$\n\n- Statement “$∀\\,{x}_{1},{x}_{2}\\in R,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}$” is true. As we can see from the graph, it passes the horizontal line test, meaning that there are no two distinct elements within $R$ that map to the same element in $R.$ So, for all ${x}_{1}$ and ${x}_{2}$ contained within the domain $R,$ if $f({x}_{1})$ and $f({x}_{2})$ are equal, then we must have ${x}_{1}={x}_{2}.$\n\n- Statement “$f$ is an injection” is true. Indeed, since statement “$∀\\,{x}_{1},{x}_{2}\\in R,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}$” is true, $f$ is an injection.\n\nTherefore, the correct answer is “$∀\\,{x}_{1},{x}_{2}\\in R,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}$”; “$f$ is an injection” only."} {:db/id #edb/ref 17592186380566 :knowledge-point/_questions [{:db/id #edb/ref 17592186133885 :knowledge-point/id #uuid "5ada5d20-89d8-5bc9-9b10-172356be0eb4" :knowledge-point/title "Identifying an Orthogonal Fundamental Subspaces of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15d09262-d89e-5778-ba27-e28913c84b14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470859} {:answer/id #uuid "ed40d0fb-ff50-5e6b-9b1f-0ac9cefa339b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470860}] :answer-field/correct {:answer/id #uuid "15d09262-d89e-5778-ba27-e28913c84b14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470859} :answer-field/id #uuid "f5ee920f-0442-5db6-b451-a0b35c211448" :answer-field/key "$\\text{Null}(B)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471935} {:answer-field/choices [{:answer/id #uuid "de94ea6a-cbe4-5a33-bd3a-207b5830d7c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470861} {:answer/id #uuid "fa6f6f29-d475-51a5-96bb-6920805c5262" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470862}] :answer-field/correct {:answer/id #uuid "fa6f6f29-d475-51a5-96bb-6920805c5262" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470862} :answer-field/id #uuid "e5227833-d2bb-5cdd-839d-430c5143ad5d" :answer-field/key "$\\text{Col}(B)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471936} {:answer-field/choices [{:answer/id #uuid "2265464f-039e-5530-b971-1d47b26a93f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470863} {:answer/id #uuid "b5f59f7d-356e-56e0-803d-4229a968217e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470864}] :answer-field/correct {:answer/id #uuid "2265464f-039e-5530-b971-1d47b26a93f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470863} :answer-field/id #uuid "75f3ae48-a10b-5299-b200-d844511e2a81" :answer-field/key "$\\text{Col}({B}^{T})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471937}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fd0235ca-04db-545b-b3a6-a1ff38871984" :question/math-academy-id "q-109853" :question/problem "Which of the following subspaces must be orthogonal to $\\text{Null}({B}^{T})$ for every matrix $B?$\n\nSelect all that apply." :question/worked-solution "Recall that $\\text{Null}({B}^{T})$ is the left null space of $B.$ This consists of vectors that, when pre-multiplied by ${B}^{T},$ result in the zero-vector $0.$\n\nWhen pre-multiplying a vector by ${B}^{T},$ we actually multiply each row of ${B}^{T}$, that is, each column of $B$, by that vector. So, $\\text{Null}({B}^{T})$ must be orthogonal to the column space of $B,$ which is $\\text{Col}(B).$\n\nTherefore, the correct answer is $\\text{Col}(B)$ only.\n\n**Note:** In general, the four fundamental subspaces of a matrix $B$ can be schematically visualized, as shown below.\n\n![](images/18/18713ed3d103ca0a02d74cede1e6448012e0aa28a2df804d41cfb277589a0158.png)"} {:db/id #edb/ref 17592186380615 :knowledge-point/_questions [{:db/id #edb/ref 17592186176089 :knowledge-point/id #uuid "ba9d2401-4e30-5327-b8eb-b4db7108dd0c" :knowledge-point/title "Identifying True Statements Regarding Linear Transformations in the Cartesian Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48355326-ad4b-578d-906e-404260be62dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453288} {:answer/id #uuid "137c30dc-eac8-5144-aa6e-ecac88c88768" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453289}] :answer-field/correct {:answer/id #uuid "137c30dc-eac8-5144-aa6e-ecac88c88768" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453289} :answer-field/id #uuid "029df452-27e1-55c2-95cc-c51c4094c660" :answer-field/key "$⟨1,1⟩\\in \\text{Im}(T)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454394} {:answer-field/choices [{:answer/id #uuid "c79a7166-446d-5b5a-a95f-e732499d72f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453290} {:answer/id #uuid "1d2b1e1d-e940-5f7a-a610-b38db6adeb6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453291}] :answer-field/correct {:answer/id #uuid "c79a7166-446d-5b5a-a95f-e732499d72f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453290} :answer-field/id #uuid "e492fc36-ff9b-5ce9-b63f-47f732639a39" :answer-field/key "$\\text{Ker}(T)\\ne {0}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454395} {:answer-field/choices [{:answer/id #uuid "3f22ea7c-9234-582e-9fd8-6c4d53049067" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453292} {:answer/id #uuid "5ae5ae4c-d9b5-5c1e-8df4-fc71fc9b7598" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453293}] :answer-field/correct {:answer/id #uuid "5ae5ae4c-d9b5-5c1e-8df4-fc71fc9b7598" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453293} :answer-field/id #uuid "21f48fb4-a9ca-5657-b58f-f9b05523a3e0" :answer-field/key "$\\text{nullity}(T)=0$, where $T$ is the standard matrix of $T$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454396}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6d9c3015-ea78-542d-9de3-a1c266f8369d" :question/math-academy-id "q-111793" :question/problem "Consider a linear transformation $T$ that maps ${R}^{2}$ onto ${R}^{2}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that a linear transformation $T$ maps ${R}^{2}$ onto  ${R}^{2}$ if and only if \n\n$$\n\\text{rank}(T)=\\text{rank}(T)=2\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-2 \\\\  & =0.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement $⟨1,1⟩\\in \\text{Im}(T)$ is true. Indeed, The condition $\\text{rank}(T)=2$ in ${R}^{2}$ is equivalent to \n\n$$\n\\text{Im}(T)={R}^{2}.\n$$\n\nHence, $T$ is surjective and so  $⟨1,1⟩\\in \\text{Im}(T).$\n\n- Statement $\\text{Ker}(T)\\ne {0}$ is false. The condition $\\text{nullity}(T)=0$ in ${R}^{2}$ is equivalent to \n\n$$\n\\text{Ker}(T)={0}.\n$$\n\n- Statement “$\\text{nullity}(T)=0$, where $T$ is the standard matrix of $T$” is true. Indeed, we have that \n\n$$\n\\text{nullity}(T)=0.\n$$\n\nTherefore, the correct answer is $⟨1,1⟩\\in \\text{Im}(T)$; “$\\text{nullity}(T)=0$, where $T$ is the standard matrix of $T$” only."} {:db/id #edb/ref 17592186380657 :knowledge-point/_questions [{:db/id #edb/ref 17592186172085 :knowledge-point/id #uuid "019e5a17-1aab-565b-8881-447c86a9a7ec" :knowledge-point/title "Identifying Vector Fields on Two-Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "162499c9-d211-5946-8b2e-c019541c3034" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437606} {:answer/id #uuid "96e0faf2-fb61-5450-8ad0-ff90febe7fb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437607}] :answer-field/correct {:answer/id #uuid "96e0faf2-fb61-5450-8ad0-ff90febe7fb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437607} :answer-field/id #uuid "428e492b-b338-505d-b794-6840361998af" :answer-field/key "$G(x,y)={x}^{2}\\,i+\\operatorname{sin}⁡y\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438832} {:answer-field/choices [{:answer/id #uuid "4078c42f-287d-5b03-8583-af065de039c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437608} {:answer/id #uuid "b2eb56cf-3f62-5c54-b952-b89ebe56b894" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437609}] :answer-field/correct {:answer/id #uuid "4078c42f-287d-5b03-8583-af065de039c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437608} :answer-field/id #uuid "bc0a8721-d4c0-531c-850b-a28514d4f48c" :answer-field/key "$H(t)=\\sqrt{t}\\,i+t{e}^{t}\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438833} {:answer-field/choices [{:answer/id #uuid "24149d6d-29cf-587b-9c73-d17502c56d1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437610} {:answer/id #uuid "642982e1-2a9a-5105-be2e-a1a9730e6358" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437611}] :answer-field/correct {:answer/id #uuid "24149d6d-29cf-587b-9c73-d17502c56d1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437610} :answer-field/id #uuid "571b08b4-5fa1-5191-8779-09ec9667116b" :answer-field/key "$K(x,y,z)=2x\\,i+y\\,j-3z\\,k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438834}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1de1af2b-64e8-50cf-80c9-f414743fe7ca" :question/math-academy-id "q-122641" :question/problem "Which of the following are vector fields on ${R}^{2}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{2}.$ A vector field on ${R}^{2}$ is a function $F$ that maps every point $(x,y)$ in $S$ to a vector $F(x,y)\\in {R}^{2}.$\n\nWith that in mind, let's examine each function.\n\n- The function $G(x,y)$ is a vector field on ${R}^{2}.$ It maps every point $(x,y)\\in {R}^{2}$ to a vector in ${R}^{2}.$\n\n- The function $H(t)$ is *not* a vector field on ${R}^{2}.$  It assigns points in $R$ (not ${R}^{2}$) to vectors in ${R}^{2}.$\n\n- The function $K(x,y,z)$ is *not* a vector field on ${R}^{2}.$ It is a vector field on ${R}^{3}.$\n\nTherefore, the correct answer is $G(x,y)={x}^{2}\\,i+\\operatorname{sin}⁡y\\,j$ only."} {:db/id #edb/ref 17592186380664 :knowledge-point/_questions [{:db/id #edb/ref 17592186172085 :knowledge-point/id #uuid "019e5a17-1aab-565b-8881-447c86a9a7ec" :knowledge-point/title "Identifying Vector Fields on Two-Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1447082-f4e8-5788-a80e-d8c2f8b82522" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437630} {:answer/id #uuid "747beaa6-cbb1-5ab8-b6f0-aac6db2ca380" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437631}] :answer-field/correct {:answer/id #uuid "d1447082-f4e8-5788-a80e-d8c2f8b82522" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437630} :answer-field/id #uuid "89920c46-71c7-5175-8718-e990046088f6" :answer-field/key "$M(x,y)$ $=⟨y-{x}^{2},3x+{y}^{2},\\frac{1}{x+y}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438844} {:answer-field/choices [{:answer/id #uuid "5963b314-2add-567a-b457-6f81885a3dad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437632} {:answer/id #uuid "0a97ce34-6fad-5a23-a913-7a8c54c9939c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437633}] :answer-field/correct {:answer/id #uuid "0a97ce34-6fad-5a23-a913-7a8c54c9939c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437633} :answer-field/id #uuid "121c69dd-36e1-570a-bd6d-c832cafb4cd4" :answer-field/key "$N(x,y)=⟨\\operatorname{cos}⁡y+1,1-\\operatorname{sin}⁡x⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438845} {:answer-field/choices [{:answer/id #uuid "2852e063-18c2-5c27-805a-899fefe85cd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437634} {:answer/id #uuid "2d47eb09-37b1-5b48-8d81-6237d57c3ab0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437635}] :answer-field/correct {:answer/id #uuid "2852e063-18c2-5c27-805a-899fefe85cd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437634} :answer-field/id #uuid "c6caeebf-8412-599a-8bb3-625ed3e2bddb" :answer-field/key "$P(t)=⟨{t}^{3},\\sqrt{1-t}\\,⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438846}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "502cb71c-02d6-5e14-a31b-2cee28a0a5ef" :question/math-academy-id "q-122656" :question/problem "Which of the following are vector fields on ${R}^{2}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{2}.$ A vector field on ${R}^{2}$ is a function $F$ that maps every point $(x,y)$ in $S$ to a vector $F(x,y)\\in {R}^{2}.$\n\nWith that in mind, let's examine each function.\n\n- The function $M(x,y)$ is *not* a vector field on ${R}^{2}.$ It assigns points in  ${R}^{2}$ to vectors in ${R}^{3}$ (not in ${R}^{2}$).\n\n- The function $N(x,y)$ is a vector field on ${R}^{2}.$ It maps every point $(x,y)\\in {R}^{2}$ to a vector in ${R}^{2}.$\n\n- The function $P(t)$ is *not* a vector field on ${R}^{2}.$ It assigns points in  $R$ \n(not ${R}^{2}$) to vectors in ${R}^{2}.$\n\nTherefore, the correct answer is $N(x,y)=⟨\\operatorname{cos}⁡y+1,1-\\operatorname{sin}⁡x⟩$ only."} {:db/id #edb/ref 17592186380678 :knowledge-point/_questions [{:db/id #edb/ref 17592186172085 :knowledge-point/id #uuid "019e5a17-1aab-565b-8881-447c86a9a7ec" :knowledge-point/title "Identifying Vector Fields on Two-Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "acbf2816-9f71-5351-b1d8-a801bf30542d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437636} {:answer/id #uuid "308d0f3d-2e87-5cc6-b65f-2f83e5267801" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437637}] :answer-field/correct {:answer/id #uuid "308d0f3d-2e87-5cc6-b65f-2f83e5267801" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437637} :answer-field/id #uuid "bbe68175-15ca-5f31-9cf5-5f03083fe4fb" :answer-field/key "$C(x,y)=⟨\\frac{1}{x+y},{x}^{2}{e}^{y}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438847} {:answer-field/choices [{:answer/id #uuid "0725d6f3-2622-5e9f-9c94-bfc7b72d7402" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437638} {:answer/id #uuid "81503c2a-ae1a-5a4d-882d-f15bf57c0190" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437639}] :answer-field/correct {:answer/id #uuid "81503c2a-ae1a-5a4d-882d-f15bf57c0190" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437639} :answer-field/id #uuid "920a7af7-aee4-545a-b604-ad8eca5e6e88" :answer-field/key "$D(x,y)=⟨{y}^{3}-3,\\operatorname{cos}⁡(2x-y)⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438848} {:answer-field/choices [{:answer/id #uuid "ceb42624-bc8c-5336-8d28-af87d45d5914" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437640} {:answer/id #uuid "fc8e9ded-65e6-530c-8fb7-a0624c962138" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437641}] :answer-field/correct {:answer/id #uuid "ceb42624-bc8c-5336-8d28-af87d45d5914" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437640} :answer-field/id #uuid "2a744e92-3f60-596f-918f-2e9f6b8fc76b" :answer-field/key "$E(x,y)=⟨x+1,y+2,x-y⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438849}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5b352a16-fe6f-5946-bac9-7b334007947a" :question/math-academy-id "q-122675" :question/problem "Which of the following are vector fields on ${R}^{2}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{2}.$ A vector field on ${R}^{2}$ is a function $F$ that maps every point $(x,y)$ in $S$ to a vector $F(x,y)\\in {R}^{2}.$\n\nWith that in mind, let's examine each function.\n\n- The function $C(x,y)$ is a vector field on ${R}^{2}.$ It maps every point in the set $S,$ given by\n\n$$\nS={(x,y)\\in {R}^{2}\\,|\\,x+y\\ne 0}\n$$\n\nto a vector in ${R}^{2}.$\n\n- The function $D(x,y)$ is a vector field on ${R}^{2}.$ It maps every point $(x,y)\\in {R}^{2}$ to a vector in ${R}^{2}.$\n\n- The function $E(x,y,z)$ is *not* a vector field on ${R}^{2}.$ It assigns points in ${R}^{2}$ to vectors in ${R}^{3}$ (not ${R}^{2}$).\n\nTherefore, the correct answer is $C(x,y)=⟨\\frac{1}{x+y},{x}^{2}{e}^{y}⟩$; $D(x,y)=⟨{y}^{3}-3,\\operatorname{cos}⁡(2x-y)⟩$ only."} {:db/id #edb/ref 17592186380692 :knowledge-point/_questions [{:db/id #edb/ref 17592186172087 :knowledge-point/id #uuid "fb34fdb0-198e-507d-a944-9be782b4cfeb" :knowledge-point/title "Identifying Vector Fields on Three-Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa463bcd-c692-5b2e-81fb-6edd382301d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437654} {:answer/id #uuid "0f0c189c-4360-5311-8733-688846ac83f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437655}] :answer-field/correct {:answer/id #uuid "fa463bcd-c692-5b2e-81fb-6edd382301d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437654} :answer-field/id #uuid "eec2a251-816b-560e-984e-218cc993a24b" :answer-field/key "$P(x,y)=\\frac{1}{{x}^{2}}\\,i+(x+y)^{2}\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438856} {:answer-field/choices [{:answer/id #uuid "4e7e53ee-c545-556b-8c01-71673e0ac9c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437656} {:answer/id #uuid "133f3ccd-0846-5c2f-8e29-aac997ab0c45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437657}] :answer-field/correct {:answer/id #uuid "133f3ccd-0846-5c2f-8e29-aac997ab0c45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437657} :answer-field/id #uuid "1e2fd0e0-3c93-53a1-8f8a-f97251928fc1" :answer-field/key "$Q(x,y,z)$ $=\\operatorname{sin}⁡y\\,i$ $-\\frac{x}{y}\\,j$ $+\\frac{1}{z+1}\\,k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438857} {:answer-field/choices [{:answer/id #uuid "22acadb3-7ca8-5abe-ad3c-4d0f8a82b17b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437658} {:answer/id #uuid "bafa02fd-27b6-50a3-b21c-bc14c4e05eaa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437659}] :answer-field/correct {:answer/id #uuid "22acadb3-7ca8-5abe-ad3c-4d0f8a82b17b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437658} :answer-field/id #uuid "a898dd6a-8e9a-579f-bcba-72e40817966d" :answer-field/key "$R(t)=\\frac{1}{t+1}\\,i-(3t-1)\\,j+\\frac{1}{{t}^{2}}\\,k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438858}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b17979a9-57b7-5c2d-8065-c277267e307e" :question/math-academy-id "q-122686" :question/problem "Which of the following are vector fields on ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{3}.$ A vector field on ${R}^{3}$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in {R}^{3}.$\n\nWith that in mind, let's examine each function.\n\n- The function $P(x,y)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{2}$ (not ${R}^{3}$) to vectors in ${R}^{2}$ (not ${R}^{3}$).\n\n- The function $Q(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,z\\ne -1,\\,y\\ne 0}\n$$\n\nto a vector in ${R}^{3}.$\n\n- The function $R(t)$ is *not* a vector field on ${R}^{3}.$ It assigns points in $R$ (not ${R}^{3}$) to vectors in ${R}^{3}.$\n\nTherefore, the correct answer is $Q(x,y,z)$ $=\\operatorname{sin}⁡y\\,i$ $-\\frac{x}{y}\\,j$ $+\\frac{1}{z+1}\\,k$ only."} {:db/id #edb/ref 17592186380699 :knowledge-point/_questions [{:db/id #edb/ref 17592186172087 :knowledge-point/id #uuid "fb34fdb0-198e-507d-a944-9be782b4cfeb" :knowledge-point/title "Identifying Vector Fields on Three-Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91acbdcb-0819-512d-8f3a-8f5b18843d8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437678} {:answer/id #uuid "c042a6b6-5fe6-5670-9ac7-c7152c415d96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437679}] :answer-field/correct {:answer/id #uuid "c042a6b6-5fe6-5670-9ac7-c7152c415d96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437679} :answer-field/id #uuid "78ff1394-a615-59ad-bb26-46d4946b7591" :answer-field/key "$M(x,y,z)$ $=⟨z-{x}^{2},3x+{z}^{2},\\frac{1}{x+y}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438868} {:answer-field/choices [{:answer/id #uuid "77a73f89-d276-53da-ba0d-e39074166f8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437680} {:answer/id #uuid "83b30725-25b3-5535-9453-a881c12cb3ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437681}] :answer-field/correct {:answer/id #uuid "77a73f89-d276-53da-ba0d-e39074166f8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437680} :answer-field/id #uuid "2a11b4f3-6da8-5671-9b65-64280b7f35aa" :answer-field/key "$N(x,y)=⟨\\operatorname{cos}⁡y+1,1-\\operatorname{sin}⁡x⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438869} {:answer-field/choices [{:answer/id #uuid "2c27113d-a2f3-54dd-a0fe-40e814f8066c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437682} {:answer/id #uuid "88e9a9b2-4f69-57eb-9973-f4cc63d15d74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437683}] :answer-field/correct {:answer/id #uuid "2c27113d-a2f3-54dd-a0fe-40e814f8066c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437682} :answer-field/id #uuid "e6f83e16-f061-5b3d-ae8a-955bb9e63305" :answer-field/key "$P(t)=⟨{t}^{3},\\sqrt{1-t}\\,⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438870}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "438dc864-2346-5ec7-8b61-791bfb4d3c82" :question/math-academy-id "q-122695" :question/problem "Which of the following are vector fields on ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{3}.$ A vector field on ${R}^{3}$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in {R}^{3}.$\n\nWith that in mind, let's examine each function.\n\n- The function $M(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,x+y\\ne 0}\n$$\n\nto a vector in ${R}^{3}.$\n\n- The function $N(x,y)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{2}$ (not ${R}^{3}$) to vectors in ${R}^{2}$ (not ${R}^{3}$).\n\n- The function $P(t)$ is *not* a vector field on ${R}^{3}.$ It assigns points in $R$ (not ${R}^{3}$) to vectors in ${R}^{2}$ (not ${R}^{3}$).\n\nTherefore, the correct answer is $M(x,y,z)$ $=⟨z-{x}^{2},3x+{z}^{2},\\frac{1}{x+y}⟩$ only."} {:db/id #edb/ref 17592186380740 :knowledge-point/_questions [{:db/id #edb/ref 17592186157231 :knowledge-point/id #uuid "bc5b8688-3838-5e9e-9304-9a4c787034ee" :knowledge-point/title "Identifying Logically Equivalent Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25ed6a87-c7ef-5ebe-80b8-1327e0527690" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470967} {:answer/id #uuid "693db775-71df-5935-b66c-e1e720f6bca0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470968}] :answer-field/correct {:answer/id #uuid "25ed6a87-c7ef-5ebe-80b8-1327e0527690" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470967} :answer-field/id #uuid "72e9d168-8616-5d7a-a0cc-08f65358b7bc" :answer-field/key "$A∨B$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471989} {:answer-field/choices [{:answer/id #uuid "76540982-ba2f-5d75-adf4-43d2d26c2645" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470969} {:answer/id #uuid "e1a29096-2984-5fc1-8bab-a6bde77b0a60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470970}] :answer-field/correct {:answer/id #uuid "e1a29096-2984-5fc1-8bab-a6bde77b0a60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470970} :answer-field/id #uuid "5aac595e-10c8-504e-b949-4e22b1e45f80" :answer-field/key "$¬(¬A∧B)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471990} {:answer-field/choices [{:answer/id #uuid "5169fc92-f334-5952-8891-30b740db658e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470971} {:answer/id #uuid "3c0ff306-27ac-502d-b26a-0f286d52abe1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470972}] :answer-field/correct {:answer/id #uuid "3c0ff306-27ac-502d-b26a-0f286d52abe1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470972} :answer-field/id #uuid "d81243e1-0ab1-5b1d-a3f3-913586a1ef6d" :answer-field/key "$A∨¬B$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471991}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5bbe1542-19d1-529e-93b1-09c0d710a430" :question/math-academy-id "q-127960" :question/problem "Which of the following statements are logically equivalent?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Two statements are logically equivalent if they have the same truth table. So, we construct a truth table for the three given statements:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,A∨B\\,$ | $\\,¬(¬A∧B)\\,$ | $\\,A∨¬B\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ | $\\text{T}$ |\n\nWe see that only the statements $¬(¬A∧B)$ and $A∨¬B$ have the same truth table, so they are logically equivalent.\n\nTherefore, the correct answer is $¬(¬A∧B)$; $A∨¬B$ only."} {:db/id #edb/ref 17592186380824 :knowledge-point/_questions [{:db/id #edb/ref 17592186152199 :knowledge-point/id #uuid "624215ff-efdc-5b12-8d61-9d66371672d9" :knowledge-point/title "Determining a Valid Region to Define a Double Integral Over a Non-Rectangular Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fa48a8c-df5a-59a2-b3a6-b36d759bb950" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470985} {:answer/id #uuid "881a8d22-a86a-5597-b050-f520391b2e42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470986}] :answer-field/correct {:answer/id #uuid "881a8d22-a86a-5597-b050-f520391b2e42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470986} :answer-field/id #uuid "16688a30-9176-5f69-91c7-1fa1d4c4206a" :answer-field/key "$R=[-2,1]\\times [-2,2]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471998} {:answer-field/choices [{:answer/id #uuid "dec129a0-c31b-595f-947f-3541ab57fc10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470987} {:answer/id #uuid "9bfa30c7-a056-59f7-a690-483011e37207" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470988}] :answer-field/correct {:answer/id #uuid "dec129a0-c31b-595f-947f-3541ab57fc10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470987} :answer-field/id #uuid "07a338e7-6966-5284-b5db-3865bb664bd7" :answer-field/key "$R=[-2,2]\\times [-2,1]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471999} {:answer-field/choices [{:answer/id #uuid "48334b6a-ebee-5ace-b16c-7064b80595ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470989} {:answer/id #uuid "b7529184-23de-5f50-877f-d7786c411f11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470990}] :answer-field/correct {:answer/id #uuid "b7529184-23de-5f50-877f-d7786c411f11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470990} :answer-field/id #uuid "758245b5-8a63-5ed5-b2cd-c34179b44d24" :answer-field/key "$R=[-2,2]\\times [-2,2]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472000}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6a85798d-b6a4-58e9-9e7d-5ef7eeb355cb" :question/math-academy-id "q-129664" :question/problem "Let $D$ be a finite region enclosed by the curves $y=-{x}^{2}+2$ and $y=x.$ If \n\n$$\nf(x,y)={\\begin{aligned}{x}^{3}-xy, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}\\,\\text{and}\\,{∬}_{D}({x}^{3}-xy)\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of the rectangular domain $R?$\n\nSelect all that apply." :question/worked-solution "First, let's draw our region $D:$\n\n![](images/3f/3f071c27bfa281abcaabe63d4d67797ea7b051b931ee7658d2a32a58f80a0bac.png)\n\nNotice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)={\\begin{aligned}{x}^{3}-xy, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nthen we obtain\n\n$$\n{∬}_{D}({x}^{3}-xy)\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given rectangles.\n\n- Rectangle $R=[-2,2]\\times [-2,1]$ does not cover the region $D.$\n\n- Rectangles $R=[-2,1]\\times [-2,2]$ and $R=[-2,2]\\times [-2,2]$ cover the region $D$ completely.\n\nTherefore, the correct answer is $R=[-2,1]\\times [-2,2]$; $R=[-2,2]\\times [-2,2]$ only."} {:db/id #edb/ref 17592186380831 :knowledge-point/_questions [{:db/id #edb/ref 17592186152200 :knowledge-point/id #uuid "100ab73e-3dad-5b15-9da2-d244c67bcc9b" :knowledge-point/title "Identifying True Statements About Double Integrals Over Non-Rectangular Domains"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11ff200e-451b-54f1-a0ea-a42fd615d13b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470991} {:answer/id #uuid "2f2ab313-4081-529e-a033-5f1ac261fa78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470992}] :answer-field/correct {:answer/id #uuid "2f2ab313-4081-529e-a033-5f1ac261fa78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470992} :answer-field/id #uuid "f55fb5a4-76a6-5353-aacb-91441daf0c74" :answer-field/key "${∬}_{D}x{y}^{3}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-4,3]\\times [-2,3]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472001} {:answer-field/choices [{:answer/id #uuid "0578dca3-f285-59ce-bfd0-23483d07f537" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470993} {:answer/id #uuid "0ff0d22e-68e0-5eb6-9195-be14ccb2c011" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470994}] :answer-field/correct {:answer/id #uuid "0578dca3-f285-59ce-bfd0-23483d07f537" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470993} :answer-field/id #uuid "da620927-ff82-5956-b9cf-32fdce50c035" :answer-field/key "${∬}_{R}x{y}^{3}\\,\\text{d}A={∬}_{D}f(x,y)\\,\\text{d}A,\\,$ where $R=[-2,3]\\times [-2,2]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472002} {:answer-field/choices [{:answer/id #uuid "a25b0c79-f3d5-5e80-998c-f24b26f8a9fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470995} {:answer/id #uuid "c87ab37c-06f0-5922-b6d9-229a72108645" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470996}] :answer-field/correct {:answer/id #uuid "c87ab37c-06f0-5922-b6d9-229a72108645" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470996} :answer-field/id #uuid "3e54d311-6ed6-5186-ae87-4a877d422130" :answer-field/key "${∬}_{D}x{y}^{3}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-3,3]\\times [-2,4]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472003}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "07cce28a-e3b6-5366-babf-23b7cf23e641" :question/math-academy-id "q-129784" :question/problem "![](images/c5/c54c756568a5f20d1d82a228c333dc4253a82236060ab2a7aea6260b10612140.png)\n\nConsider the region $D$ shown above. If \n\n$$\nf(x,y)={\\begin{aligned}x{y}^{3}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Notice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)={\\begin{aligned}x{y}^{3}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}x{y}^{3}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given statements.\n\n- Statement “${∬}_{D}x{y}^{3}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-4,3]\\times [-2,3]$” is true. The rectangle $R$ covers the region $D$ completely.\n\n- Statement “${∬}_{R}x{y}^{3}\\,\\text{d}A={∬}_{D}f(x,y)\\,\\text{d}A,\\,$ where $R=[-2,3]\\times [-2,2]$” is false. The integrals have not been stated correctly with respect to the domains $R$ and $D$ (they have been swapped).\n\n- Statement “${∬}_{D}x{y}^{3}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-3,3]\\times [-2,4]$” is true. The rectangle $R$ covers the region $D$ completely.\n\nTherefore, the correct answer is “${∬}_{D}x{y}^{3}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-4,3]\\times [-2,3]$”; “${∬}_{D}x{y}^{3}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-3,3]\\times [-2,4]$” only."} {:db/id #edb/ref 17592186380838 :knowledge-point/_questions [{:db/id #edb/ref 17592186152198 :knowledge-point/id #uuid "0ad76e6b-acef-5221-8852-71dc42625bf3" :knowledge-point/title "Determining a Correct Function Used to Define a Double Integral Over a Non-Rectangular Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87cd12d0-6a34-5d69-a052-37dd7b665fa1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470997} {:answer/id #uuid "2a5c113f-8f85-54df-a191-e6a260a622ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470998}] :answer-field/correct {:answer/id #uuid "2a5c113f-8f85-54df-a191-e6a260a622ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470998} :answer-field/id #uuid "a053ccd6-a515-5e7f-a170-df59bdc9e410" :answer-field/key "$\\{\\begin{aligned}{e}^{x}\\operatorname{cos}⁡y, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472004} {:answer-field/choices [{:answer/id #uuid "499f94a8-9207-510d-9baa-5720b20b1c07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470999} {:answer/id #uuid "92e04b93-9fab-5c61-a3ba-0482b966ebc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471000}] :answer-field/correct {:answer/id #uuid "499f94a8-9207-510d-9baa-5720b20b1c07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470999} :answer-field/id #uuid "82cef237-2c86-5e8e-8666-abbf572a6632" :answer-field/key "$\\{\\begin{aligned}{e}^{x}\\operatorname{cos}⁡y, & (x,y)\\in R∖D \\\\ 0, & (x,y)\\in D\\end{aligned}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472005} {:answer-field/choices [{:answer/id #uuid "d53fcefd-cbee-5163-8861-b3c676aacc68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471001} {:answer/id #uuid "7b636524-5e3f-5180-98df-969975052f6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471002}] :answer-field/correct {:answer/id #uuid "d53fcefd-cbee-5163-8861-b3c676aacc68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471001} :answer-field/id #uuid "f4a80c0b-1724-53b6-833f-dcb16e1b056b" :answer-field/key "$\\{\\begin{aligned}{e}^{x}\\operatorname{cos}⁡y, & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472006}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d32f310d-7c80-57bd-8ae7-821e89abc170" :question/math-academy-id "q-129901" :question/problem "![](images/e2/e2ded513c72c8029b7d2909d2e3b37cbd659c4ba60a7be72c81379626a7a1234.png)\n\nConsider the region $D$ shown above. If $R=[-1,2]\\times [-1,3],$ and\n\n$$\n{∬}_{D}{e}^{x}\\operatorname{cos}⁡y\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nSelect all that apply.\n\nIf none apply, leave all boxes unchecked." :question/worked-solution "First, let's draw our region $D$ and rectangle $R:$\n\n![](images/77/77c8e1b1aacd29c6d69aa3c641c1641f43ff2aa1467dc713d417641f8b76b066.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal ${e}^{x}\\operatorname{cos}⁡y$ on $D$ and to be equal $0$ outside $D,$ we obtain\n\n$$\n{∬}_{D}{e}^{x}\\operatorname{cos}⁡y\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given functions.\n\n- We cannot use functions $\\{\\begin{aligned}{e}^{x}\\operatorname{cos}⁡y, & (x,y)\\in R∖D \\\\ 0, & (x,y)\\in D\\end{aligned}$ and $\\{\\begin{aligned}{e}^{x}\\operatorname{cos}⁡y, & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}$. Both of these functions are not identically zero for all points in $R\\,∖D.$ For example, $(x,y)=(2,3)\\in R\\,∖\\,D,$ but the functions are nonzero at this point.\n\n- Function $\\{\\begin{aligned}{e}^{x}\\operatorname{cos}⁡y, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}$ equals ${e}^{x}\\operatorname{cos}⁡y$ on $D$ and equals $0$ outside $D.$\n\nTherefore, the correct answer is $\\{\\begin{aligned}{e}^{x}\\operatorname{cos}⁡y, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}$ only."} {:db/id #edb/ref 17592186380845 :knowledge-point/_questions [{:db/id #edb/ref 17592186152198 :knowledge-point/id #uuid "0ad76e6b-acef-5221-8852-71dc42625bf3" :knowledge-point/title "Determining a Correct Function Used to Define a Double Integral Over a Non-Rectangular Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84e6ca1c-985b-57a6-bbdc-cfcae76d35e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471003} {:answer/id #uuid "d9d90adc-d8e3-5eed-84c7-910312448f23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471004}] :answer-field/correct {:answer/id #uuid "d9d90adc-d8e3-5eed-84c7-910312448f23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471004} :answer-field/id #uuid "7bf10497-649d-5202-b23e-b273af7bee99" :answer-field/key "$\\{\\begin{aligned}y{e}^{x+y}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\notin D\\end{aligned}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472007} {:answer-field/choices [{:answer/id #uuid "98097f2b-9e49-5e27-80f9-f06bc14aab86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471005} {:answer/id #uuid "fce61fa5-c452-5372-a5c0-cfe94d4a20f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471006}] :answer-field/correct {:answer/id #uuid "fce61fa5-c452-5372-a5c0-cfe94d4a20f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471006} :answer-field/id #uuid "f4b2628b-6aa3-5ec7-8908-353c28bcb1e4" :answer-field/key "$\\{\\begin{aligned}y{e}^{x+y}, & (x,y)\\in D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472008} {:answer-field/choices [{:answer/id #uuid "b103412c-5b4e-56d0-9003-8a8ec8267e02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471007} {:answer/id #uuid "a577d434-9c09-55d1-b36d-57e46a052ed5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471008}] :answer-field/correct {:answer/id #uuid "b103412c-5b4e-56d0-9003-8a8ec8267e02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471007} :answer-field/id #uuid "59c48db3-67b1-567b-8a55-234d3dd131bd" :answer-field/key "$\\{\\begin{aligned}0, & (x,y)\\in D \\\\ y{e}^{x+y}, & (x,y)\\in R∖D\\end{aligned}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472009}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a021db95-99b8-59d4-be5a-36dd8114ebe0" :question/math-academy-id "q-129907" :question/problem "Let $D$ be a finite region enclosed by the curve $\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{4}=1.$ If $R=[-3,3]\\times [-2,2],$ and\n\n$$\n{∬}_{D}y{e}^{x+y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nSelect all that apply." :question/worked-solution "First, let's draw our region $D$ and rectangle $R:$\n\n![](images/38/38c44f897999039f88df2c3e549a1229ec9f9a979bbc83dfe1a5d7279701450d.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal $y{e}^{x+y}$ on $D$ and to be equal $0$ outside $D,$ we obtain\n\n$$\n{∬}_{D}y{e}^{x+y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given functions.\n\n- Functions $\\{\\begin{aligned}y{e}^{x+y}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\notin D\\end{aligned}$ and $\\{\\begin{aligned}y{e}^{x+y}, & (x,y)\\in D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}$ equal $y{e}^{x+y}$ on $D$ and equal $0$ outside $D.$\n\n- We cannot use function $\\{\\begin{aligned}0, & (x,y)\\in D \\\\ y{e}^{x+y}, & (x,y)\\in R∖D\\end{aligned}$. The function is not identically zero for all points in $R\\,∖D.$ For example, $(x,y)=(3,2)\\in R\\,∖\\,D,$ but the function is nonzero at this point.\n\nTherefore, the correct answer is $\\{\\begin{aligned}y{e}^{x+y}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\notin D\\end{aligned}$; $\\{\\begin{aligned}y{e}^{x+y}, & (x,y)\\in D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}$ only."} {:db/id #edb/ref 17592186381055 :knowledge-point/_questions [{:db/id #edb/ref 17592186124466 :knowledge-point/id #uuid "9d090462-a031-5f96-ac13-90dac882edab" :knowledge-point/title "Identifying Points Where Partial Derivatives Exist"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81d96ac2-a71a-5eae-a1f2-a35c4f4a3421" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453374} {:answer/id #uuid "ecf2f7f5-879e-5b50-99b0-b4a8aef4ece7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453375}] :answer-field/correct {:answer/id #uuid "81d96ac2-a71a-5eae-a1f2-a35c4f4a3421" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453374} :answer-field/id #uuid "aa0701da-b463-5213-94f2-e02a73ff00ba" :answer-field/key "The partial derivative with respect to $x$ is defined at $(0,1,\\frac{\\pi }{2})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454437} {:answer-field/choices [{:answer/id #uuid "8aed5c28-8075-55ae-90c0-2b3580818ba0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453376} {:answer/id #uuid "9429cccf-885a-5592-a530-ce21f4be12af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453377}] :answer-field/correct {:answer/id #uuid "8aed5c28-8075-55ae-90c0-2b3580818ba0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453376} :answer-field/id #uuid "4a8eabc0-30ea-5a23-bb5c-bfb9f407a0da" :answer-field/key "${f}_{y}(\\frac{\\pi }{2},1,0)$ is defined" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454438} {:answer-field/choices [{:answer/id #uuid "594cbcc6-1f78-5c78-a783-2e90c24ef8b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453378} {:answer/id #uuid "7abba252-c5b0-5346-96fe-05d40dee8d1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453379}] :answer-field/correct {:answer/id #uuid "7abba252-c5b0-5346-96fe-05d40dee8d1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453379} :answer-field/id #uuid "923ab783-cb50-5906-95f1-23560f2f0e2b" :answer-field/key "${f}_{z}(1,1,\\frac{\\pi }{4})$ is defined" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454439}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "25283dae-901a-5291-a7bb-9324644a9dab" :question/math-academy-id "q-132732" :question/problem "Which of the following statements are true about the function $f(x,y,z)=\\frac{y}{x\\operatorname{sin}⁡z}?$\n\nSelect all that apply." :question/worked-solution "First, we compute the partial derivatives of $f(x,y,z):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{y}{\\operatorname{sin}⁡z}\\cdot \\left(-\\frac{1}{{x}^{2}}\\right) \\\\  & =-\\frac{y}{{x}^{2}\\operatorname{sin}⁡z} \\\\ \\frac{∂f}{∂y} & =\\frac{1}{x\\operatorname{sin}⁡z}\\cdot 1 \\\\  & =\\frac{1}{x\\operatorname{sin}⁡z} \\\\ \\frac{∂f}{∂z} & =\\frac{y}{x}\\cdot \\left(-\\frac{\\operatorname{cos}⁡z}{{sin}^{2}⁡z}\\right) \\\\  & =-\\frac{y\\operatorname{cos}⁡z}{x{sin}^{2}⁡z}\\end{aligned}\n$$\n\nNow, let's examine the statements one-by-one.\n\n- Statement “The partial derivative with respect to $x$ is defined at $(0,1,\\frac{\\pi }{2})$” is false. If we substitute $(0,1,\\frac{\\pi }{2})$ into $f$, we get\n\n$$\nf(0,1,\\frac{\\pi }{2})=\\frac{1}{0\\cdot \\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)}=\\frac{1}{0},\n$$\n\nwhich is undefined since we have division by zero. Since the function is not defined at the point, the derivative is also undefined.\n\n- Statement “${f}_{y}(\\frac{\\pi }{2},1,0)$ is defined” is false. If we substitute $(\\frac{\\pi }{2},1,0)$ into $f$, we get\n\n$$\nf(\\frac{\\pi }{2},1,0)=\\frac{1}{\\left(\\frac{\\pi }{2}\\right)\\operatorname{sin}⁡0}=\\frac{1}{0},\n$$\n\nwhich is undefined since we have division by zero. Since the function is not defined at the point, the derivative is also undefined.\n\n- Statement “${f}_{z}(1,1,\\frac{\\pi }{4})$ is defined” is true. Indeed, the function $f$ is defined at $(1,1,\\frac{\\pi }{4})$, where we have \n\n$$\nf(1,1,\\frac{\\pi }{4})=\\frac{1}{(1)\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right)}=\\sqrt{2},\n$$\n\nand ${f}_{z}$ is also defined at $(1,1,\\frac{\\pi }{4}):$\n\n$$\n\\begin{aligned}{f}_{z}(1,1,\\frac{\\pi }{4}) & =-\\frac{(1)\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}\\right)}{(1){sin}^{2}⁡\\left(\\frac{\\pi }{4}\\right)}=-\\sqrt{2}.\\end{aligned}\n$$\n\nTherefore, the correct answer is '“${f}_{z}(1,1,\\frac{\\pi }{4})$ is defined” only'."} {:db/id #edb/ref 17592186381146 :knowledge-point/_questions [{:db/id #edb/ref 17592186119924 :knowledge-point/id #uuid "7eb5ca50-e9f3-5513-aff1-1ada8c225a42" :knowledge-point/title "Identifying Linearly Independent Sets by Inspection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bdcfad6c-8f67-57f0-8e1a-a5145e94e79b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453424} {:answer/id #uuid "55aeaac9-a576-5295-97bc-ebd0c9e7e4e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453425}] :answer-field/correct {:answer/id #uuid "55aeaac9-a576-5295-97bc-ebd0c9e7e4e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453425} :answer-field/id #uuid "8f9ba92f-81fd-578e-97ef-9822e2732b3c" :answer-field/key "$-3{a}_{1}+{a}_{2}=0.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454462} {:answer-field/choices [{:answer/id #uuid "22fb0a31-52f6-57f8-8ea5-865c224e4380" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453426} {:answer/id #uuid "6acfaf3d-0245-5aea-b43a-808e8113c3a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453427}] :answer-field/correct {:answer/id #uuid "22fb0a31-52f6-57f8-8ea5-865c224e4380" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453426} :answer-field/id #uuid "79204f72-f15b-57b1-8a43-ec32e3cd9f9d" :answer-field/key "${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=0$ only if ${x}_{1}={x}_{2}=0.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454463} {:answer-field/choices [{:answer/id #uuid "e76b6fa9-4472-508a-aa11-4fb247f3829f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453428} {:answer/id #uuid "10a94ed2-5542-5c9a-944e-4e6ce2994230" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453429}] :answer-field/correct {:answer/id #uuid "10a94ed2-5542-5c9a-944e-4e6ce2994230" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453429} :answer-field/id #uuid "05f6d47f-184b-59c7-bb64-4405edcb8db2" :answer-field/key "The set ${{a}_{1},{a}_{2}}$ is linearly dependent." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454464}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1896da03-9822-50e1-8935-797efb12d1b2" :question/math-academy-id "q-157255" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=\\begin{bmatrix}5 \\\\ -1 \\\\ 2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}15 \\\\ -3 \\\\ 6\\end{bmatrix}\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "We say that two vectors ${v}_{1}$ and ${v}_{2}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}=0\n$$\n\nis ${x}_{1}={x}_{2}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's look at each statement in turn.\n\n- Statement $-3{a}_{1}+{a}_{2}=0.$ is true. Indeed:\n\n$$\n\\begin{aligned}-3{a}_{1}+{a}_{2} & =-3\\begin{bmatrix}5 \\\\ -1 \\\\ 2\\end{bmatrix}+\\begin{bmatrix}15 \\\\ -3 \\\\ 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-15 \\\\ 3 \\\\ -6\\end{bmatrix}+\\begin{bmatrix}15 \\\\ -3 \\\\ 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix} \\\\  & =0\\end{aligned}\n$$\n\n- Statement “${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=0$ only if ${x}_{1}={x}_{2}=0.$” is false. Since statement $-3{a}_{1}+{a}_{2}=0.$ is true, we have ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=0$ for ${x}_{1}=-3$ and ${x}_{2}=1.$\n\n- Statement “The set ${{a}_{1},{a}_{2}}$ is linearly dependent” is true. Since statement $-3{a}_{1}+{a}_{2}=0.$ is true, the set ${{a}_{1},{a}_{2}}$ is linearly dependent.\n\nTherefore, the correct answer is $-3{a}_{1}+{a}_{2}=0.$; “The set ${{a}_{1},{a}_{2}}$ is linearly dependent” only."} {:db/id #edb/ref 17592186381355 :knowledge-point/_questions [{:db/id #edb/ref 17592186152133 :knowledge-point/id #uuid "63a2b195-d0b3-580c-9230-58533d86afd5" :knowledge-point/title "Functions Whose Domain and Codomain Is the Set of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50c678ac-6856-5dc5-9afe-44b6fb6311de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453538} {:answer/id #uuid "ad824d0a-7f08-5933-8b16-8402f4a9fd2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453539}] :answer-field/correct {:answer/id #uuid "ad824d0a-7f08-5933-8b16-8402f4a9fd2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453539} :answer-field/id #uuid "56d2618d-d2f9-5b8b-b843-2e6f5786a8b9" :answer-field/key "The range of $f$ is $[-2,\\infty )$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454519} {:answer-field/choices [{:answer/id #uuid "8ae85886-4535-502f-84c0-5a86c1c9c7ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453540} {:answer/id #uuid "d9363502-c0da-51ae-a073-e57ff08e4ab2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453541}] :answer-field/correct {:answer/id #uuid "8ae85886-4535-502f-84c0-5a86c1c9c7ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453540} :answer-field/id #uuid "b52ed245-0c82-56d3-b8b0-0c0c07c09cac" :answer-field/key "$∀\\,y\\in R,$ $∃\\,x\\in R$ such that $f(x)=y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454520} {:answer-field/choices [{:answer/id #uuid "62b9178a-5f22-57aa-961e-121d6f20d793" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453542} {:answer/id #uuid "d5ca2d3b-efcd-5ca0-a83f-3513832fdc0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453543}] :answer-field/correct {:answer/id #uuid "62b9178a-5f22-57aa-961e-121d6f20d793" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453542} :answer-field/id #uuid "5a99e775-0837-5864-8cc7-c3563a0e99c0" :answer-field/key "$f$ is **onto**" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454521}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "97231f8f-64e5-5ea2-a413-41a730985778" :question/math-academy-id "q-170659" :question/problem "Which of the following statements are true regarding the function $f:R\\to R$ which is given by $f(x)=(x+1)^{2}-2?$\n\nSelect all that apply." :question/worked-solution "First, we graph the function.\n\n![](images/9e/9e8457a8caa2f9dbdb627521e23029325f9edda757336a7a5fbbffbda14b4985.png)\n\nA function $f:X\\to Y$ is a surjection (also known as *onto*) if, for *every* element $y$  in $Y,$ there is *at least one* element in $X$ that maps to $y:$ \n\n$f:X\\to Y$ is a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement “The range of $f$ is $[-2,\\infty )$” is true. From the graph, the lowest $y$-value is $-2,$ and it occurs at the point $(-1,-2).$ The graph will cover all $y$-values from $y=-2$ and greater, including the number $-2,$ so the range of the function is $[-2,\\infty ).$\n\n- Statement “$∀\\,y\\in R,$ $∃\\,x\\in R$ such that $f(x)=y$” is false. Consider $y=-3.$ As we can see from the range, there is no real number $x$ such that $f(x)=-3.$ So, it's *not true* that for all $y$ contained within $R,$ there exists some $x$ contained within $R$ such that $f(x)=y.$\n\n- Statement “$f$ is **onto**” is false. Since statement “$∀\\,y\\in R,$ $∃\\,x\\in R$ such that $f(x)=y$” is false, $f$ is not a surjection of $R$ onto $R.$\n\nTherefore, the correct answer is “The range of $f$ is $[-2,\\infty )$” only."} {:db/id #edb/ref 17592186381454 :knowledge-point/_questions [{:db/id #edb/ref 17592186152089 :knowledge-point/id #uuid "6927f03c-aa7a-56ac-8cd0-c036a11aadc9" :knowledge-point/title "Finding the Truth Value of a Statement Involving Nested Quantifiers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9929c09c-8f33-57ee-88cb-38daa710dcf9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453544} {:answer/id #uuid "1f16da6c-f534-5d72-880c-f328ccd0c191" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453545}] :answer-field/correct {:answer/id #uuid "1f16da6c-f534-5d72-880c-f328ccd0c191" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453545} :answer-field/id #uuid "9154c3d8-007c-5ee3-8a3b-e0dd67cef6cc" :answer-field/key "$∃\\,n\\in N,\\,5\\le n.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454522} {:answer-field/choices [{:answer/id #uuid "8124e520-c402-5a54-9af8-c0ce7d475102" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453546} {:answer/id #uuid "bce7b7f6-753e-5b37-b888-86bfae6f9dab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453547}] :answer-field/correct {:answer/id #uuid "bce7b7f6-753e-5b37-b888-86bfae6f9dab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453547} :answer-field/id #uuid "7c84fe16-6e6b-5a98-b741-ab03c807812b" :answer-field/key "The truth set of the predicate $(\\,∃n\\in N,\\,m\\le n\\,)$ is $N.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454523} {:answer-field/choices [{:answer/id #uuid "e1a128bf-59d0-5ed3-9481-22081c32fcbf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453548} {:answer/id #uuid "e1fa2398-f7d9-5cc4-b8aa-f1a48a45fe8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453549}] :answer-field/correct {:answer/id #uuid "e1fa2398-f7d9-5cc4-b8aa-f1a48a45fe8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453549} :answer-field/id #uuid "f34b228d-dfef-5a02-826b-d0dc59fab7b6" :answer-field/key "$∀\\,m\\in N,\\,∃n\\in N,\\,m\\le n.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454524}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e5934422-10d9-59ea-acc1-a33dbe6bcea0" :question/math-academy-id "q-171906" :question/problem "Let $m\\in N$ and $n\\in N.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, notice that the statement \n\n$$\n∀\\,m\\in N,\\,∃n\\in N,\\,m\\le n\n$$\n\nfrom option $∀\\,m\\in N,\\,∃n\\in N,\\,m\\le n.$ reads as follows:\n\n$\\,$ For every natural $m$ there exists natural $n$ such that $m\\le n.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement $∃\\,n\\in N,\\,5\\le n.$ is true since $5\\le n$ for some natural number $n$ (e.g., for $n=6$).\n\n- Statement “The truth set of the predicate $(\\,∃n\\in N,\\,m\\le n\\,)$ is $N.$” is true. The predicate\n\n$$\nP(m):\\,∃\\,n\\in N,\\,m\\le n\n$$\n\nis true for any natural $m.$ For example,\n\n$$\nP(1):\\,∃\\,n\\in N,\\,1\\le n\n$$\n\nis true since we can take $n=2.$ Similarly,\n\n$$\nP(2):\\,∃\\,n\\in N,\\,2\\le n\n$$\n\nis true since we can take $n=3.$ And so on. In general, it's sufficient to take $n=m+1.$\n\n- Statement $∀\\,m\\in N,\\,∃n\\in N,\\,m\\le n.$ is true. The sentence \n\n$$\n(\\,∀\\,m\\in N,\\,∃n\\in N,\\,m\\le n\\,)\n$$\n\ncan be written as\n\n$$\n∀\\,m\\in N\\,(\\,\\underbrace{∃n\\in N,\\,m\\le n}_{P(m)}\\,)\n$$\n\nwhich is true whenever the inner predicate $P(m)$ is true over the universal set $N.$ And, according to statement “The truth set of the predicate $(\\,∃n\\in N,\\,m\\le n\\,)$ is $N.$”, this is the case.\n\nTherefore, the correct answer is $∃\\,n\\in N,\\,5\\le n.$; “The truth set of the predicate $(\\,∃n\\in N,\\,m\\le n\\,)$ is $N.$”; $∀\\,m\\in N,\\,∃n\\in N,\\,m\\le n.$."} {:db/id #edb/ref 17592186381672 :knowledge-point/_questions [{:db/id #edb/ref 17592186198261 :knowledge-point/id #uuid "0d6db336-845a-506a-b020-cced1b38e23a" :knowledge-point/title "Using Laws Involving Implications and Equivalences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f93e2813-02cf-5d71-8c6e-1b9d088cf37c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471227} {:answer/id #uuid "8f7c7d04-8ec9-5c7c-a89b-1af88837f2d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471228}] :answer-field/correct {:answer/id #uuid "f93e2813-02cf-5d71-8c6e-1b9d088cf37c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471227} :answer-field/id #uuid "2908043c-33d5-5432-8597-803323613592" :answer-field/key "$x\\in \\{-1,0,3,7\\}\\cap N$ is equivalent to  $x\\in N.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472119} {:answer-field/choices [{:answer/id #uuid "1f507774-b258-5f58-9da0-7dada9be6c0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471229} {:answer/id #uuid "aac305d7-80df-5bae-86de-c0233a0b92dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471230}] :answer-field/correct {:answer/id #uuid "aac305d7-80df-5bae-86de-c0233a0b92dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471230} :answer-field/id #uuid "da4eecb9-2fcb-5fd1-85e8-328678f428e7" :answer-field/key "$x\\in \\{-1,0,3,7\\}\\cap N$ if and only if $x\\in \\{3,7\\}.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472120} {:answer-field/choices [{:answer/id #uuid "aff55999-9f8e-5e41-8ffe-cb3f305865cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471231} {:answer/id #uuid "823c701a-dfb4-543f-bb43-f79b09870c2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471232}] :answer-field/correct {:answer/id #uuid "aff55999-9f8e-5e41-8ffe-cb3f305865cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471231} :answer-field/id #uuid "7f179911-1302-54df-986f-67ecb682117f" :answer-field/key "If $x\\in \\{-1,0,3,7\\}\\cap N$ then $x\\in \\{3,7\\},$ or if $x\\in \\{3,7\\}$ then $x\\in \\{-1,0,3,7\\}\\cap N.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472121}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bf3548ae-a137-5c57-8262-82ca0ade3b9d" :question/math-academy-id "q-183356" :question/problem "Consider the following predicates.\n\n$\\,$ $A(x):$ $x\\in \\{-1,0,3,7\\}\\cap N.$ $\\,$ $B(x):$ $x\\in \\{3,7\\}.$ \n\nWhich of the following is equivalent to the biconditional predicate $A(x)⇔B(x)?$\n\nSelect all that apply." :question/worked-solution "A biconditional expression $P⇔Q≡(P⇒Q)∧(Q⇒P)$ can be read as shown below:\n\n- $P$ if and only if $Q$\n\n- $P$ is equivalent to $Q$\n\n- If $P$ then $Q,$ and if $Q$ then $P$\n\nSo, $A⇔B$ translates into the following sentences:\n\n- $x\\in \\{-1,0,3,7\\}\\cap N$ if and only if $x\\in \\{3,7\\}.$\n\n- $x\\in \\{-1,0,3,7\\}\\cap N$ is equivalent to $x\\in \\{3,7\\}.$\n\n- If $x\\in \\{-1,0,3,7\\}\\cap N$ then $x\\in \\{3,7\\},$ and if $x\\in \\{3,7\\}$ then $x\\in \\{-1,0,3,7\\}\\cap N.$\n\nTherefore, the correct answer is “$x\\in \\{-1,0,3,7\\}\\cap N$ if and only if $x\\in \\{3,7\\}.$” only."} {:db/id #edb/ref 17592186381679 :knowledge-point/_questions [{:db/id #edb/ref 17592186198261 :knowledge-point/id #uuid "0d6db336-845a-506a-b020-cced1b38e23a" :knowledge-point/title "Using Laws Involving Implications and Equivalences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38d82c66-da81-5da6-99b2-f8009487d231" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471233} {:answer/id #uuid "6cfd2ce4-c861-572f-be91-5a67f9259251" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471234}] :answer-field/correct {:answer/id #uuid "38d82c66-da81-5da6-99b2-f8009487d231" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471233} :answer-field/id #uuid "9bf3be5b-830f-58c9-a573-942a40eae3d7" :answer-field/key "$3\\,|\\,x$ if and only if $5\\,|x.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472122} {:answer-field/choices [{:answer/id #uuid "a3951911-eb29-5274-9d8c-cca561b05b9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471235} {:answer/id #uuid "15f517a1-1be6-5193-a806-cc5eb0a13364" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471236}] :answer-field/correct {:answer/id #uuid "a3951911-eb29-5274-9d8c-cca561b05b9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471235} :answer-field/id #uuid "0990f9ff-8884-566c-89d3-36080e85cb1c" :answer-field/key "If $3\\,|\\,x$ then $3\\,|\\,(x+15),$ or if $3\\,|\\,(x+15)$ then $3\\,|\\,x.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472123} {:answer-field/choices [{:answer/id #uuid "90c29c97-3228-56b1-859a-71e6720b678f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471237} {:answer/id #uuid "3e5acb9a-b1ff-54fa-9112-bdbc02b6fd10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471238}] :answer-field/correct {:answer/id #uuid "3e5acb9a-b1ff-54fa-9112-bdbc02b6fd10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471238} :answer-field/id #uuid "cfcc4a68-2133-54c2-b0a0-3c81584244b4" :answer-field/key "If $3\\,|\\,x$ then $3\\,|\\,(x+15),$ and if $3\\,|\\,(x+15)$ then $3\\,|\\,x.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472124}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9aa776da-0143-5b4b-9d08-2751ea2726a2" :question/math-academy-id "q-183357" :question/problem "Consider the following predicates.\n\n$\\,$ $A(x):$ $3\\,|\\,x.$ $\\,$ $B(x):$ $3\\,|\\,(x+15).$\n\nWhich of the following is equivalent to the biconditional predicate $A(x)⇔B(x)?$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A biconditional expression $P⇔Q≡(P⇒Q)∧(Q⇒P)$ can be read as shown below:\n\n- $P$ if and only if $Q$\n\n- $P$ is equivalent to $Q$\n\n- If $P$ then $Q,$ and if $Q$ then $P$\n\nSo, $A⇔B$ translates into the following sentences:\n\n- $3\\,|\\,x$ if and only if $3\\,|\\,(x+15).$\n\n- $3\\,|\\,x$ is equivalent to $3\\,|\\,(x+15).$\n\n- If $3\\,|\\,x$ then $3\\,|\\,(x+15),$ and if $3\\,|\\,(x+15)$ then $3\\,|\\,x.$\n\nTherefore, the correct answer is “If $3\\,|\\,x$ then $3\\,|\\,(x+15),$ and if $3\\,|\\,(x+15)$ then $3\\,|\\,x.$” only."} {:db/id #edb/ref 17592186381714 :knowledge-point/_questions [{:db/id #edb/ref 17592186152081 :knowledge-point/id #uuid "114dedd9-ed3d-5d25-8616-030ea4bd84c9" :knowledge-point/title "Identifying True Statements Involving Universal Quantifiers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8da2a78-6b7f-53b8-bffd-d448c3f847ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471239} {:answer/id #uuid "3bc7d23e-5f63-597f-b45f-ccd132f97e65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471240}] :answer-field/correct {:answer/id #uuid "3bc7d23e-5f63-597f-b45f-ccd132f97e65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471240} :answer-field/id #uuid "17e335b8-b98e-50fa-a484-bdd5b2409741" :answer-field/key "The truth set of $P(y)$ is $∅.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472125} {:answer-field/choices [{:answer/id #uuid "58586351-d58f-59e4-a4a4-9c608e02df09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471241} {:answer/id #uuid "6db9990c-720e-51d7-bb30-d39dacae1573" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471242}] :answer-field/correct {:answer/id #uuid "58586351-d58f-59e4-a4a4-9c608e02df09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471241} :answer-field/id #uuid "65c3c397-0d1d-516b-ac99-7fe8b9c00f19" :answer-field/key "The truth set of $P(y)$ is ${R}_{0}^{+}.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472126} {:answer-field/choices [{:answer/id #uuid "2441682b-b895-530a-8549-bac4919a1d4f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471243} {:answer/id #uuid "afd5bf33-6d41-5522-b11a-167be7a2855e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471244}] :answer-field/correct {:answer/id #uuid "2441682b-b895-530a-8549-bac4919a1d4f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471243} :answer-field/id #uuid "234c4b97-1890-58ba-9c35-cecd4649c7c3" :answer-field/key "$∀y\\in {R}_{0}^{+},\\,P(y).$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472127}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c1dd2623-6f10-56c3-88a0-4d1c15254f6e" :question/math-academy-id "q-183501" :question/problem "$\\,$ $P(y):$ ${y}^{3}\\ge 0$ and ${y}^{2}<0.$\n\nGiven that the above predicate is defined over the universal set ${R}_{0}^{+},$ which of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The *universal quantification* of a predicate $P(x),$ defined over the universal set $U,$ transforms this predicate into a statement that we write as\n\n$$\n∀x\\in U,\\,P(x).\n$$\n\nThis statement is true if the predicate $P(x)$ is true on the entire universal set $U,$ i.e. if the truth set ${T}_{P}$ of the predicate coincides with the universal set $U:$\n\n$$\n{T}_{P}=U\n$$\n\nFirst, notice that:\n\n- the truth set of \"${y}^{3}\\ge 0$\" is ${R}_{0}^{+},$ and\n\n- the truth set of \"${y}^{2}<0$\" is $∅.$\n\nSo, the truth set of our predicate is \n\n$$\n{T}_{P}={R}_{0}^{+}\\cap ∅=∅.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement “The truth set of $P(y)$ is $∅.$” is true. The truth set is empty.\n\n- Statement “The truth set of $P(y)$ is ${R}_{0}^{+}.$” is false. Indeed, ${T}_{P}\\ne {R}_{0}^{+}.$\n\n- Statement $∀y\\in {R}_{0}^{+},\\,P(y).$ is false. Since ${T}_{P}$ does *not* coincide with the universal set, the statement $∀y\\in R,\\,P(y)$ is false.\n\nTherefore, the correct answer is “The truth set of $P(y)$ is $∅.$” only."} {:db/id #edb/ref 17592186381721 :knowledge-point/_questions [{:db/id #edb/ref 17592186152081 :knowledge-point/id #uuid "114dedd9-ed3d-5d25-8616-030ea4bd84c9" :knowledge-point/title "Identifying True Statements Involving Universal Quantifiers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "defba699-4a25-5079-8da7-191e906362c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471245} {:answer/id #uuid "2ae74a0e-8685-51b9-8b86-3ea38abb603b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471246}] :answer-field/correct {:answer/id #uuid "defba699-4a25-5079-8da7-191e906362c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471245} :answer-field/id #uuid "aa65fd8b-9a17-5a0f-94a1-cbfbb0757ec1" :answer-field/key "The truth set of $P(x)$ is $∅.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472128} {:answer-field/choices [{:answer/id #uuid "6253e5dd-f178-507e-b0cb-82fbbd44aa21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471247} {:answer/id #uuid "c1539409-9db3-5470-a898-4ac923e6605f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471248}] :answer-field/correct {:answer/id #uuid "c1539409-9db3-5470-a898-4ac923e6605f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471248} :answer-field/id #uuid "c22a0b36-aaab-5d47-a469-7b5766b9a356" :answer-field/key "The truth set of $P(x)$ is $Z.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472129} {:answer-field/choices [{:answer/id #uuid "ba0e68d6-a9b0-5205-8fe6-9f651cd5ce63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471249} {:answer/id #uuid "b2b3038d-718e-582d-9c3c-f62a5783d2a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471250}] :answer-field/correct {:answer/id #uuid "b2b3038d-718e-582d-9c3c-f62a5783d2a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471250} :answer-field/id #uuid "646129fd-784c-5a2c-b410-5c53d3b646ed" :answer-field/key "$∀x\\in Z,\\,P(x).$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472130}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "df50f5a8-2783-58fd-a4cd-90489ec7d8e6" :question/math-academy-id "q-183505" :question/problem "$\\,$ $P(x):$ $x>0$ or $x\\le 0.$\n\nGiven that the above predicate is defined over the universal set $Z,$ which of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The *universal quantification* of a predicate $P(x),$ defined over the universal set $U,$ transforms this predicate into a statement that we write as\n\n$$\n∀x\\in U,\\,P(x).\n$$\n\nThis statement is true if the predicate $P(x)$ is true on the entire universal set $U,$ i.e. if the truth set ${T}_{P}$ of the predicate coincides with the universal set $U:$\n\n$$\n{T}_{P}=U\n$$\n\nFirst, notice that:\n\n- the truth set of \"$x>0$\" is ${Z}^{+},$ and\n\n- the truth set of \"$x\\le 0$\" is ${Z}_{0}^{-}.$\n\nSo, the truth set of our predicate is \n\n$$\n{T}_{P}={Z}^{+}\\cup {Z}_{0}^{-}=Z.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement “The truth set of $P(x)$ is $∅.$” is false. The truth set is *not* empty.\n\n- Statement “The truth set of $P(x)$ is $Z.$” is true. Indeed, ${T}_{P}=Z.$\n\n- Statement $∀x\\in Z,\\,P(x).$ is true. Since ${T}_{P}$ coincides with the universal set, the statement $∀x\\in Z,\\,P(x)$ is true.\n\nTherefore, the correct answer is “The truth set of $P(x)$ is $Z.$”; $∀x\\in Z,\\,P(x).$ only."} {:db/id #edb/ref 17592186381728 :knowledge-point/_questions [{:db/id #edb/ref 17592186152081 :knowledge-point/id #uuid "114dedd9-ed3d-5d25-8616-030ea4bd84c9" :knowledge-point/title "Identifying True Statements Involving Universal Quantifiers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cba4701d-2fd6-5372-b880-8d434ccdb270" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471251} {:answer/id #uuid "446db8d7-7cb7-5377-b9b2-bacbb4007a61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471252}] :answer-field/correct {:answer/id #uuid "446db8d7-7cb7-5377-b9b2-bacbb4007a61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471252} :answer-field/id #uuid "4d008faa-d8bb-541b-9843-da1781408cfe" :answer-field/key "The truth set of $P(z)$ is $∅.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472131} {:answer-field/choices [{:answer/id #uuid "bf171081-1331-5db9-a2de-12b23429df59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471253} {:answer/id #uuid "d3528246-9536-5d23-b342-adba8ac5dab0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471254}] :answer-field/correct {:answer/id #uuid "bf171081-1331-5db9-a2de-12b23429df59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471253} :answer-field/id #uuid "82ab5c53-5e15-5ea1-b774-b6f68e133cf3" :answer-field/key "The truth set of $P(z)$ is $R.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472132} {:answer-field/choices [{:answer/id #uuid "d8b3a8c0-a6c1-578d-9257-3e5ed98ce4ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471255} {:answer/id #uuid "9bc632e2-76b4-5b92-9ae0-3c66fa0e0b04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471256}] :answer-field/correct {:answer/id #uuid "d8b3a8c0-a6c1-578d-9257-3e5ed98ce4ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471255} :answer-field/id #uuid "78d00a60-493e-5993-9de4-453b1082e9fc" :answer-field/key "$∀z\\in R,\\,P(z).$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472133}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9947189b-8991-5f0c-ad01-e90d4c094369" :question/math-academy-id "q-183507" :question/problem "$\\,$ $P(z):$ ${e}^{z}<0$ or ${z}^{4}\\le -1.$\n\nGiven that the above predicate is defined over the universal set $R,$ which of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The *universal quantification* of a predicate $P(x),$ defined over the universal set $U,$ transforms this predicate into a statement that we write as\n\n$$\n∀x\\in U,\\,P(x).\n$$\n\nThis statement is true if the predicate $P(x)$ is true on the entire universal set $U,$ i.e. if the truth set ${T}_{P}$ of the predicate coincides with the universal set $U:$\n\n$$\n{T}_{P}=U\n$$\n\nFirst, notice that:\n\n- the truth set of \"${e}^{z}<0$\" is $∅,$ and\n\n- the truth set of \"${z}^{4}\\le -1$\" is $∅.$\n\nSo, the truth set of our predicate is \n\n$$\n{T}_{P}=∅\\cup ∅=∅.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement “The truth set of $P(z)$ is $∅.$” is true. The truth set is empty.\n\n- Statement “The truth set of $P(z)$ is $R.$” is false. Indeed, ${T}_{P}\\ne R.$\n\n- Statement $∀z\\in R,\\,P(z).$ is false. Since ${T}_{P}$ does *not* coincide with the universal set, the statement $∀z\\in R,\\,P(z)$ is false.\n\nTherefore, the correct answer is “The truth set of $P(z)$ is $∅.$” only."} {:db/id #edb/ref 17592186381735 :knowledge-point/_questions [{:db/id #edb/ref 17592186152081 :knowledge-point/id #uuid "114dedd9-ed3d-5d25-8616-030ea4bd84c9" :knowledge-point/title "Identifying True Statements Involving Universal Quantifiers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18ae95b2-959c-5227-9f9e-1c19714c4ad1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471257} {:answer/id #uuid "7cc9c0c5-0ca7-5f89-b217-7404ac391998" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471258}] :answer-field/correct {:answer/id #uuid "18ae95b2-959c-5227-9f9e-1c19714c4ad1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471257} :answer-field/id #uuid "7980a2fa-eb6b-5d8c-9821-21a864ae8331" :answer-field/key "The truth set of $P(z)$ is $∅.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472134} {:answer-field/choices [{:answer/id #uuid "13d2d6eb-2afa-5baf-96a0-4a3d9b090828" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471259} {:answer/id #uuid "50d9a4f4-7672-5d82-a3a1-4f0cb5139bf0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471260}] :answer-field/correct {:answer/id #uuid "50d9a4f4-7672-5d82-a3a1-4f0cb5139bf0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471260} :answer-field/id #uuid "681cecc5-b758-5526-8165-fd5d7c141bcc" :answer-field/key "The truth set of $P(z)$ is $Q.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472135} {:answer-field/choices [{:answer/id #uuid "25eae025-f164-5039-9dd9-e68aa7cdf5e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471261} {:answer/id #uuid "57a82495-a59e-5851-b7b5-f73ae72ff17d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471262}] :answer-field/correct {:answer/id #uuid "57a82495-a59e-5851-b7b5-f73ae72ff17d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471262} :answer-field/id #uuid "35a4aa85-26f8-5790-8558-316e6fcb8d17" :answer-field/key "$∀z\\in Q,\\,P(z).$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472136}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "53e303c8-88d9-51db-bc34-ac5638b42f29" :question/math-academy-id "q-183511" :question/problem "$\\,$ $P(z):$ $\\frac{z}{2}\\in Q⇒(z+1)^{2}\\ge 0.$\n\nGiven that the above predicate is defined over the universal set $Q,$ which of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The *universal quantification* of a predicate $P(x),$ defined over the universal set $U,$ transforms this predicate into a statement that we write as\n\n$$\n∀x\\in U,\\,P(x).\n$$\n\nThis statement is true if the predicate $P(x)$ is true on the entire universal set $U,$ i.e. if the truth set ${T}_{P}$ of the predicate coincides with the universal set $U:$\n\n$$\n{T}_{P}=U\n$$\n\nFirst, notice that:\n\n- the truth set of \"$\\frac{z}{2}\\in Q$\" is $Q,$ and\n\n- the truth set of \"$(z+1)^{2}\\ge 0$\" is $Q.$\n\nSince $A⇒B≡¬A∨B,$ the truth set of our predicate is \n\n$$\n{T}_{P}=\\overset{―}{Q}\\cup Q=∅\\cup Q=Q.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement “The truth set of $P(z)$ is $∅.$” is false. The truth set is not empty.\n\n- Statement “The truth set of $P(z)$ is $Q.$” is true. Indeed, ${T}_{P}=Q.$\n\n- Statement $∀z\\in Q,\\,P(z).$ is true. Since ${T}_{P}$ coincides with the universal set, the statement $∀z\\in Q,\\,P(z)$ is true.\n\nTherefore, the correct answer is “The truth set of $P(z)$ is $Q.$”; $∀z\\in Q,\\,P(z).$ only."} {:db/id #edb/ref 17592186381749 :knowledge-point/_questions [{:db/id #edb/ref 17592186152083 :knowledge-point/id #uuid "320c4694-1904-5fc7-a324-a4c89f0e3257" :knowledge-point/title "Identifying True Statements Involving Existential Quantifiers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99e8deea-e8f4-5ff7-bd37-2da11ae10889" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471263} {:answer/id #uuid "7cba0954-6700-5c1a-b3a9-0533c67f4a41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471264}] :answer-field/correct {:answer/id #uuid "7cba0954-6700-5c1a-b3a9-0533c67f4a41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471264} :answer-field/id #uuid "905855c6-d163-536a-ad9f-e392902c0e00" :answer-field/key "The truth set of $P(z)$ is $∅.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472137} {:answer-field/choices [{:answer/id #uuid "802fa2ed-3e2a-5dc8-9bd4-3cc9b95510ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471265} {:answer/id #uuid "5759a99b-eb18-5f4b-8146-b27b89d56c05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471266}] :answer-field/correct {:answer/id #uuid "802fa2ed-3e2a-5dc8-9bd4-3cc9b95510ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471265} :answer-field/id #uuid "9c260fb3-24b1-5e74-8cf9-41a7e45f67e4" :answer-field/key "The truth set of $P(z)$ is $N.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472138} {:answer-field/choices [{:answer/id #uuid "55f3de03-e853-59e3-a24a-a565f2b647b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471267} {:answer/id #uuid "291649bc-96db-597c-8dba-abb42d69354c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471268}] :answer-field/correct {:answer/id #uuid "55f3de03-e853-59e3-a24a-a565f2b647b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471267} :answer-field/id #uuid "6953743f-3bd6-54af-a1c3-18deab20dcc0" :answer-field/key "$∃z\\in N,\\,P(z).$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472139}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "79851a4f-18e1-5d49-91ff-0a7efb6d90a3" :question/math-academy-id "q-183549" :question/problem "$\\,$ $P(z):$ $\\sqrt{z}<1$\n\nGiven that the above predicate is defined over the universal set $N,$ which of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The *existential quantification* of a predicate $P(x),$ defined over the universal set $U,$ transforms this predicate into a statement that we write as\n\n$$\n∃x\\in U,\\,P(x).\n$$\n\nThis statement is true if the predicate $P(x)$ is true for a single element $x\\in U,$ i.e. if the truth set ${T}_{P}$ of the predicate is not empty:\n\n$$\n{T}_{P}\\ne ∅\n$$\n\nFirst, notice that the truth set of our predicate is \n\n$$\n{T}_{P}=∅.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement “The truth set of $P(z)$ is $∅.$” is true. The truth set is empty.\n\n- Statement “The truth set of $P(z)$ is $N.$” is false. Indeed, ${T}_{P}\\ne N.$\n\n- Statement $∃z\\in N,\\,P(z).$ is false. Since ${T}_{P}$ is empty, the statement $∃z\\in N,\\,P(z)$ is false.\n\nTherefore, the correct answer is “The truth set of $P(z)$ is $∅.$” only."}]
