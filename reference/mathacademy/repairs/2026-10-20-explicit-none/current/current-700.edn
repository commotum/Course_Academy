er/id #uuid "54ca6197-9f4e-5d4c-b779-d3fb088580a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462006} :answer-field/id #uuid "8761079b-fd03-558a-9a7b-5cb95289edfd" :answer-field/key "$2\\operatorname{sec}⁡x-5=-6$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462756}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2e821a2c-70b6-5ded-9b65-8ac018a20911" :question/math-academy-id "q-120487" :question/problem "Which of the following equations has no solutions for ${0}^{∘}\\le x<{360}^{∘}?$\n\nSelect all that apply." :question/worked-solution "We first simplify the given equations, and get\n\n- $\\operatorname{sec}⁡x=5$\n- $\\operatorname{sec}⁡x=-2$\n- $\\operatorname{sec}⁡x=-\\frac{1}{2}$\n\nNow, recall that the range of $\\operatorname{sec}⁡x$ for ${0}^{∘}\\le x<{360}^{∘}$ is given by\n\n$$\n\\operatorname{sec}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{sec}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation $2\\operatorname{sec}⁡x-5=-6$ has no solution."} {:db/id #edb/ref 17592186256427 :knowledge-point/_questions [{:db/id #edb/ref 17592186115222 :knowledge-point/id #uuid "80449399-3ae4-593f-8c3b-00bcdcc99727" :knowledge-point/title "Solving Trigonometric Equations Outside of the Range of Cosecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aeddf93a-d789-59a2-8c27-45c8c4d78c36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462007} {:answer/id #uuid "59d36712-da3e-5ba6-8ff6-e03916acc2f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462008}] :answer-field/correct {:answer/id #uuid "aeddf93a-d789-59a2-8c27-45c8c4d78c