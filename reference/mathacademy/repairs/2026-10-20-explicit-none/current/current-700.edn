nswer/id #uuid "0039b744-c30f-5b87-90ae-3f6e231319ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437677} :answer-field/id #uuid "28d18e6e-3fdd-511d-adcf-4ebf4d97e428" :answer-field/key "$Q(x,y,z)$ $=⟨-1,2,\\operatorname{ln}⁡(2x-y+z)⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438867}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "659f4527-cc88-5c6b-8485-f595eee1689f" :question/math-academy-id "q-122694" :question/problem "Which of the following are vector fields on ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{3}.$ A vector field on ${R}^{3}$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in {R}^{3}.$\n\nWith that in mind, let's examine each function.\n\n- The function $N(x,y)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{2}$ (not ${R}^{3}$) to vectors in ${R}^{2}$ (not ${R}^{3}$).\n\n- The function $P(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,3-x\\ge 0}\n$$\n\nto a vector in ${R}^{3}.$\n\n- The function $Q(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,2x-y+z>0}\n$$\n\nto a vector in ${R}^{3}.$\n\nTherefore, the correct answer is $P(x,y,z)$ $=⟨{e}^{x-2y},\\sqrt{3-x},3{z}^{3}⟩$; $Q(x,y,z)$ $=⟨-1,2,\\operatorname{ln}⁡(2x-y+z)⟩$ only."} {:db/id #edb/ref 17592186256699 :knowledge-point/_questions [{:db/id #edb/ref 17592186172087 :knowledge-point/id #uuid "fb34fdb0-198e-507d-a944-9be782b4cfeb" :knowledge-point/title "Identifying Vector Fields on Three-Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "381ec827-a8d9-525e-879e-9867a01781c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437684} {:answer/id #uuid "49b34905-3523-5220-8445-649a78b38000" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437685}] :answer-field/correct {:answer/id #uuid "381ec827-a8d9-525e-879e-9867a01781c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437684} :answer-field/id #uuid "18ab9680-7869-5328-9a15-6eba928afef1" :answer-field/key "$C(x,y,z)=\\frac{z}{x+y}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438871} {:answer-field/choices [{:answer/id #uuid "87e56ee0-4b15-585a-b00b-9c198815d5c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437686} {:answer/id #uuid "8084195c-c80f-5724-a464-b4190c772af2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437687}] :answer-field/correct {:answer/id #uuid "87e56ee0-4b15-585a-b00b-9c198815d5c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437686} :answer-field/id #uuid "f57b8a4e-6326-51ba-9d83-e214db0e9062" :answer-field/key "$D(x,y)$ $=⟨{y}^{3}-3,\\operatorname{cos}⁡(2x-y),7{x}^{3}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438872} {:answer-field/choices [{:answer/id #uuid "9acb7596-f53f-56d2-b363-d2432bfdfc06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437688} {:answer/id #uuid "7cff525b-7dbd-51e3-9c41-4f3a63d8b105" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437689}] :answer-field/correct {:answer/id #uuid "7cff525b-7dbd-51e3-9c41-4f3a63d8b105" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437689} :answer-field/id #uuid "ee64c134-4670-5bcf-b390-f48716fc96b5" :answer-field/key "$E(x,y,z)$ $=⟨\\operatorname{sin}⁡(x+z),\\operatorname{tan}⁡z,\\frac{1}{x-y}⟩$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438873}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "89ed8a40-4bb8-5a40-9a2c-1bf03637a8bf" :question/math-academy-id "q-122696" :question/problem "Which of the following are vector fields on ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{3}.$ A vector field on ${R}^{3}$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in {R}^{3}.$\n\nWith that in mind, let's examine each function.\n\n- The function $C(x,y,z)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{3}$ to functions in $R$ (not ${R}^{3}$).\n\n- The function $D(x,y)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{2}$ (not ${R}^{3}$) to vectors in ${R}^{3}.$\n\n- The function $E(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,x\\ne y,\\,z\\ne \\frac{\\pi }{2}+n\\pi ,\\,n\\in Z}\n$$\n\nto a vector in ${R}^{3}.$\n\nTherefore, the correct answer is $E(x,y,z)$ $=⟨\\operatorname{sin}⁡(x+z),\\operatorname{tan}⁡z,\\frac{1}{x-y}⟩$ only."} {:db/id #edb/ref 17592186256707 :knowledge-point/_questions [{:db/id #edb/ref 17592186092226 :knowledge-point/id #uuid "b0cbb889-0fe1-5347-94a3-53db3ff9a95c" :knowledge-point/title "Calculating the Vertices of a Polygon Given Its Image Under a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6f8e547-af48-5682-8cb8-9735daf137fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462049} {:answer/id #uuid "1ffc3df7-935b-55dd-898a-b4f350700906" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462050}] :answer-field/correct {:answer/id #uuid "1ffc3df7-935b-55dd-898a-b4f350700906" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462050} :answer-field/id #uuid "08918d95-147b-5c17-964b-fbe4a402aafb" :answer-field/key "The point $(-5,-2)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462778} {:answer-field/choices [{:answer/id #uuid "f8fe2f28-234b-5195-8ae3-225b9a029355" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462051} {:answer/id #uuid "cb77398c-765e-5328-adf2-825b0fb48082" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462052}] :answer-field/correct {:answer/id #uuid "cb77398c-765e-5328-adf2-825b0fb48082" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462052} :answer-field/id #uuid "1e6e515d-ee91-5f57-acdb-689c1e4bb6e0" :answer-field/key "The point $(-6,-3)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462779} {:answer-field/choices [{:answer/id #uuid "2a4bdccb-4a6b-5a80-884c-094072e98a63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462053} {:answer/id #uuid "fb248762-0e83-5bcd-b409-3390e810d66a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462054}] :answer-field/correct {:answer/id #uuid "fb248762-0e83-5bcd-b409-3390e810d66a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462054} :answer-field/id #uuid "e2c67c05-2f48-5fdf-8d8e-3bb13e3688a9" :answer-field/key "The point $(-8,-4)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462780}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d8bbd25c-a5f8-5d3d-a21d-9b7c851329bd" :question/math-academy-id "q-12273" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}.\n$$\n\nThe quadrilateral $Q$ is mapped to the quadrilateral ${Q}^{′}$ under the action of $T.$ The quadrilateral ${Q}^{′}$ has vertices $(2,-5),(3,-6),(4,-8),$ and $(3,-7).$ Which of the following are vertices of $Q?$\n\nSelect all that apply." :question/worked-solution "First, we create a matrix $Y$ containing all of the vertices of ${Q}^{′}:$ \n\n$$\nY=\\begin{bmatrix}2 & 3 & 4 & 3 \\\\ -5 & -6 & -8 & -7\\end{bmatrix}.\n$$\n\nNow, if $X$ denotes the matrix that contains the corresponding vertices of $Q$, we have\n\n$$\n\\begin{aligned}T\\cdot X & =Y \\\\ T\\cdot X & =\\begin{bmatrix}2 & 3 & 4 & 3 \\\\ -5 & -6 & -8 & -7\\end{bmatrix}.\\end{aligned}\n$$\n\nWe need to reverse the action of the matrix $T.$ So, we multiply the above equation by ${T}^{-1},$ and we get\n\n$$\n\\begin{aligned}{T}^{-1}\\cdot T\\cdot X & ={T}^{-1}\\cdot \\begin{bmatrix}2 & 3 & 4 & 3 \\\\ -5 & -6 & -8 & -7\\end{bmatrix} \\\\ X & ={T}^{-1}\\cdot \\begin{bmatrix}2 & 3 & 4 & 3 \\\\ -5 & -6 & -8 & -7\\end{bmatrix}.\\end{aligned}\n$$\n\nThe inverse of $T$ is\n\n$$\n\\begin{aligned}{T}^{-1} & =\\frac{1}{0-(-1)}\\begin{bmatrix}0 & 1 \\\\ -1 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 1 \\\\ -1 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}X & ={T}^{-1}\\cdot \\begin{bmatrix}2 & 3 & 4 & 3 \\\\ -5 & -6 & -8 & -7\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 1 \\\\ -1 & 0\\end{bmatrix}\\begin{bmatrix}2 & 3 & 4 & 3 \\\\ -5 & -6 & -8 & -7\\end{bmatrix} \\\\  & =\\begin{bmatrix}-5 & -6 & -8 & -7 \\\\ -2 & -3 & -4 & -3\\end{bmatrix}\\end{aligned}\n$$\n\nAs a result, the coordinates of $Q$ are $(-5,-2),(-6,-3),(-8,-4),(-7,-3).$\n\nTherefore, the correct answer is “The point $(-5,-2)$”; “The point $(-6,-3)$”; “The point $(-8,-4)$”."} {:db/id #edb/ref 17592186256711 :knowledge-point/_questions [{:db/id #edb/ref 17592186092226 :knowledge-point/id #uuid "b0cbb889-0fe1-5347-94a3-53db3ff9a95c" :knowledge-point/title "Calculating the Vertices of a Polygon Given Its Image Under a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00a6fe8d-2c16-5ed9-a469-12e945598a57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462055} {:answer/id #uuid "a2c56ce9-c0a0-567a-8fb9-6d9dd256d42a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462056}] :answer-field/correct {:answer/id #uuid "a2c56ce9-c0a0-567a-8fb9-6d9dd256d42a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462056} :answer-field/id #uuid "cb39bce1-60cf-5bba-9192-7ca5348113b4" :answer-field/key "The point $(-2,4)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462781} {:answer-field/choices [{:answer/id #uuid "afc0dd62-2bc3-5a3e-aafc-1436ace1cfcc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462057} {:answer/id #uuid "1e0886d8-9672-5eac-953d-670d4c428f9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462058}] :answer-field/correct {:answer/id #uuid "afc0dd62-2bc3-5a3e-aafc-1436ace1cfcc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462057} :answer-field/id #uuid "a0eec58b-6298-53fe-96fc-caaa73418a7e" :answer-field/key "The point $(1,-2)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462782} {:answer-field/choices [{:answer/id #uuid "697c2615-8e40-5e82-9789-3f41e7c39420" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462059} {:answer/id #uuid "367997cf-efbe-5ae7-8cd3-8c02764c0897" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462060}] :answer-field/correct {:answer/id #uuid "367997cf-efbe-5ae7-8cd3-8c02764c0897" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462060} :answer-field/id #uuid "95cfd858-94a4-5845-a230-50e26ead8ca0" :answer-field/key "The point $(4,4)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462783}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "566b96ca-03b3-52b8-9e22-e29d835f5f92" :question/math-academy-id "q-12275" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}2 & 1 \\\\ 0 & 1\\end{bmatrix}.\n$$\n\nThe quadrilateral $Q$ is mapped to the quadrilateral ${Q}^{′}$ under the action of $T.$ The quadrilateral ${Q}^{′}$ has vertices $(0,4),(-4,4),(12,4),$ and $(7,3).$ Which of the following are vertices of $Q?$\n\nSelect all that apply." :question/worked-solution "First, we create a matrix $Y$ containing all of the vertices of ${Q}^{′}:$ \n\n$$\nY=\\begin{bmatrix}0 & -4 & 12 & 7 \\\\ 4 & 4 & 4 & 3\\end{bmatrix}.\n$$\n\nNow, if $X$ denotes the matrix that contains the corresponding vertices of $Q$, we have\n\n$$\n\\begin{aligned}T\\cdot X & =Y \\\\ T\\cdot X & =\\begin{bmatrix}0 & -4 & 12 & 7 \\\\ 4 & 4 & 4 & 3\\end{bmatrix}.\\end{aligned}\n$$\n\nWe need to reverse the action of the matrix $T.$ So, we multiply the above equation by ${T}^{-1},$ and we get\n\n$$\n\\begin{aligned}{T}^{-1}\\cdot T\\cdot X & ={T}^{-1}\\cdot \\begin{bmatrix}0 & -4 & 12 & 7 \\\\ 4 & 4 & 4 & 3\\end{bmatrix} \\\\ X & ={T}^{-1}\\cdot \\begin{bmatrix}0 & -4 & 12 & 7 \\\\ 4 & 4 & 4 & 3\\end{bmatrix}.\\end{aligned}\n$$\n\nThe inverse of $T$ is\n\n$$\n\\begin{aligned}{T}^{-1} & =\\frac{1}{2-0}\\begin{bmatrix}1 & -1 \\\\ 0 & 2\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}1 & -1 \\\\ 0 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}X & ={T}^{-1}\\cdot \\begin{bmatrix}0 & -4 & 12 & 7 \\\\ 4 & 4 & 4 & 3\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}1 & -1 \\\\ 0 & 2\\end{bmatrix}\\begin{bmatrix}0 & -4 & 12 & 7 \\\\ 4 & 4 & 4 & 3\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}-4 & -8 & 8 & 4 \\\\ 8 & 8 & 8 & 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & -4 & 4 & 2 \\\\ 4 & 4 & 4 & 3\\end{bmatrix}.\\end{aligned}\n$$\n\nAs a result, the coordinates of $Q$ are $(-2,4),(-4,4),(4,4),(2,3).$\n\nTherefore, the correct answer is “The point $(-2,4)$”; “The point $(4,4)$” only."} {:db/id #edb/ref 17592186256721 :knowledge-point/_questions [{:db/id #edb/ref 17592186162083 :knowledge-point/id #uuid "96d48adf-a293-54ae-88fd-ee8471e5fc65" :knowledge-point/title "Applying Independence of Parametrization and Orientation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b877064-2518-5f0a-b4cc-e8ce3cdb6339" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462061} {:answer/id #uuid "d31ab5cc-8f03-565c-baa7-182f415d2e40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462062}] :answer-field/correct {:answer/id #uuid "4b877064-2518-5f0a-b4cc-e8ce3cdb6339" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462061} :answer-field/id #uuid "a889bc2a-6c37-5857-b5df-2f84c3f8a657" :answer-field/key "${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}s=-4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462784} {:answer-field/choices [{:answer/id #uuid "4072d32e-8787-592f-a6a0-ab69807057af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462063} {:answer/id #uuid "119a56a7-be8a-525d-bf38-85a10b27e983" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462064}] :answer-field/correct {:answer/id #uuid "4072d32e-8787-592f-a6a0-ab69807057af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462063} :answer-field/id #uuid "115eacf4-2515-53aa-bfd6-ab8ce878fbab" :answer-field/key "${\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s=8,$ where ${C}_{2}$ is parametrized by ${r}_{2}(u)=⟨16{u}^{4}-12{u}^{2},\\,2u⟩$ for $0\\le u\\le 1.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462785} {:answer-field/choices [{:answer/id #uuid "ac676307-c5cf-59c4-8590-312fc31f883c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462065} {:answer/id #uuid "298a07b4-50d6-5be9-96f1-5114af5fa7ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462066}] :answer-field/correct {:answer/id #uuid "298a07b4-50d6-5be9-96f1-5114af5fa7ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462066} :answer-field/id #uuid "99e4091b-8534-5001-a586-9ba94089c8a0" :answer-field/key "${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}s=4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462786}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5b1e210e-8810-5093-9deb-eb8812e9311b" :question/math-academy-id "q-122814" :question/problem "Suppose ${\\int }_{{C}_{1}}f(x,y)\\,\\text{d}s=4$ for some function $f(x,y),$ where ${C}_{1}$ is parametrized by ${r}_{1}(t)=⟨{t}^{4}-3{t}^{2},\\,t⟩$ for $0\\le t\\le 2.$\n\nWhich of the following must be true?\n\nSelect all that apply." :question/worked-solution "Line integrals with respect to arc length are independent of the choice of parametrization and orientation.\n\nWith that in mind, let's examine each statement. \n\n- Statement ${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}s=-4$ is false, while statement ${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}s=4$ is true. Reversing the curve's orientation does *not* change the value of a line integral with respect to arc length. Therefore, we have\n\n$$\n{\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}s={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}s=4.\n$$\n\n- Statement “${\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s=8,$ where ${C}_{2}$ is parametrized by ${r}_{2}(u)=⟨16{u}^{4}-12{u}^{2},\\,2u⟩$ for $0\\le u\\le 1.$” is false. Notice that ${C}_{1}$ and ${C}_{2}$ are different parameterizations of the same curve. Since line integrals with respect to arc length are independent of the choice of parameterization, we have\n\n$$\n{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s=4.\n$$\n\n \nTo see that ${C}_{1}$ and ${C}_{2}$ represent the same curve, we can convert each parametrization to Cartesian form. In doing so, we find that both parameterizations give the Cartesian curve\n\n$$\nx={y}^{4}-3{y}^{2},\\,0\\le y\\le 2.\n$$\n\nTherefore, the correct answer is ${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}s=4$ only."} {:db/id #edb/ref 17592186256722 :knowledge-point/_questions [{:db/id #edb/ref 17592186162083 :knowledge-point/id #uuid "96d48adf-a293-54ae-88fd-ee8471e5fc65" :knowledge-point/title "Applying Independence of Parametrization and Orientation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d69ae25e-4067-57d7-992a-aea277568ec9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462067} {:answer/id #uuid "738c6bee-a025-5815-b191-c51eede9211c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462068}] :answer-field/correct {:answer/id #uuid "d69ae25e-4067-57d7-992a-aea277568ec9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462067} :answer-field/id #uuid "c61b6f96-e8f3-53f9-b0c0-da26da3e6072" :answer-field/key "${\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s=2,$ where ${C}_{2}$ is parametrized by ${r}_{2}(t)=⟨\\operatorname{cos}⁡t,\\,\\operatorname{sin}⁡t⟩$ for $0\\le t\\le \\pi .$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462787} {:answer-field/choices [{:answer/id #uuid "f4efe198-1a08-51cc-bb7f-57e8f0ee8eb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462069} {:answer/id #uuid "51e47506-7d0a-5b3e-b515-61f96ae37f6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462070}] :answer-field/correct {:answer/id #uuid "f4efe198-1a08-51cc-bb7f-57e8f0ee8eb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462069} :answer-field/id #uuid "5edbd1d2-7f0f-56a6-b340-a1ec1e119077" :answer-field/key "${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}s=-1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462788} {:answer-field/choices [{:answer/id #uuid "1bba662d-b093-5629-b0a1-c818e13f06a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462071} {:answer/id #uuid "cad3636b-9235-5c64-8894-54bc8fd1a1b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462072}] :answer-field/correct {:answer/id #uuid "cad3636b-9235-5c64-8894-54bc8fd1a1b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462072} :answer-field/id #uuid "b3bdd892-fdc2-556f-bf24-620230aff8e4" :answer-field/key "${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}s=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462789}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "533221ac-cdcc-53a5-adcd-03f57c6b1b57" :question/math-academy-id "q-122815" :question/problem "Suppose ${\\int }_{{C}_{1}}f(x,y)\\,\\text{d}s=1$ for some function $f(x,y),$ where ${C}_{1}$ is parametrized by ${r}_{1}(u)=⟨\\operatorname{cos}⁡\\left(\\frac{u}{2}\\right),\\,\\operatorname{sin}⁡\\left(\\frac{u}{2}\\right)⟩$ for $0\\le u\\le 2\\pi .$ \n\nWhich of the following must be true?\n\nSelect all that apply." :question/worked-solution "Line integrals with respect to arc length are independent of the choice of parametrization and orientation.\n\nWith that in mind, let's examine each statement. \n\n- Statement “${\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s=2,$ where ${C}_{2}$ is parametrized by ${r}_{2}(t)=⟨\\operatorname{cos}⁡t,\\,\\operatorname{sin}⁡t⟩$ for $0\\le t\\le \\pi .$” is false. Notice that ${C}_{1}$ and ${C}_{2}$ are different parameterizations of the same curve. Since line integrals with respect to arc length are independent of the choice of parameterization, we have\n\n$$\n{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s=1.\n$$\n\n \nTo see that ${C}_{1}$ and ${C}_{2}$ represent the same curve, we note that both parameterizations traverse a half-circle of radius $1$ centered at $O$ between $0$ and $\\pi .$\n\n- Statement ${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}s=-1$ is false, while statement ${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}s=1$ is true. Reversing the curve's orientation does *not* change the value of a line integral with respect to arc length. Therefore, we have\n\n$$\n{\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}s={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}s=1.\n$$\n\nTherefore, the correct answer is ${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}s=1$ only."} {:db/id #edb/ref 17592186256723 :knowledge-point/_questions [{:db/id #edb/ref 17592186162083 :knowledge-point/id #uuid "96d48adf-a293-54ae-88fd-ee8471e5fc65" :knowledge-point/title "Applying Independence of Parametrization and Orientation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e05ec3e-cd64-5efe-b86c-3a85d32445a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462073} {:answer/id #uuid "555ded60-6e27-5822-bfad-111ae26de821" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462074}] :answer-field/correct {:answer/id #uuid "555ded60-6e27-5822-bfad-111ae26de821" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462074} :answer-field/id #uuid "570b3d91-151c-5000-a5f6-67a9b778db1d" :answer-field/key "${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}s=3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462790} {:answer-field/choices [{:answer/id #uuid "ce53e294-37f1-5e16-892e-9c87da353bbc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462075} {:answer/id #uuid "2fecce07-97ed-543c-9956-f750f8ecd7a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462076}] :answer-field/correct {:answer/id #uuid "ce53e294-37f1-5e16-892e-9c87da353bbc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462075} :answer-field/id #uuid "7c544999-5092-5e3f-ba7a-7f9b6e161fa2" :answer-field/key "${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}s=-3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462791} {:answer-field/choices [{:answer/id #uuid "d78c6e8e-5d8a-5dfc-b896-579c21a26b8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462077} {:answer/id #uuid "60092f97-7805-566d-a27b-a35ee30d9698" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462078}] :answer-field/correct {:answer/id #uuid "d78c6e8e-5d8a-5dfc-b896-579c21a26b8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462077} :answer-field/id #uuid "6319433e-b1e6-54c4-9ece-69e71614667d" :answer-field/key "${\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s=12,$ where ${C}_{2}$ is parametrized by ${r}_{2}(u)=⟨4u,\\,8{u}^{3/2}⟩$ for $0\\le u\\le 1.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462792}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aba31fa9-c0e0-5ac2-bdfd-ad58b74f6f1a" :question/math-academy-id "q-122816" :question/problem "Suppose ${\\int }_{{C}_{1}}f(x,y)\\,\\text{d}s=3$ for some function $f(x,y),$ where ${C}_{1}$ is parametrized by ${r}_{1}(t)=⟨t,\\,{t}^{3/2}⟩$ for $0\\le t\\le 4.$\n\nWhich of the following must be true?\n\nSelect all that apply." :question/worked-solution "Line integrals with respect to arc length are independent of the choice of parametrization and orientation.\n\nWith that in mind, let's examine each statement. \n\n- Statement ${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}s=3$ is true, while statement ${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}s=-3$ is false. Reversing the curve's orientation does *not* change the value of a line integral with respect to arc length. Therefore, we have\n\n$$\n{\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}s={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}s=3.\n$$\n\n- Statement “${\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s=12,$ where ${C}_{2}$ is parametrized by ${r}_{2}(u)=⟨4u,\\,8{u}^{3/2}⟩$ for $0\\le u\\le 1.$” is false. Notice that ${C}_{1}$ and ${C}_{2}$ are different parameterizations of the same curve. Since line integrals with respect to arc length are independent of the choice of parameterization, we have\n\n$$\n{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s=3.\n$$\n\n \nTo see that ${C}_{1}$ and ${C}_{2}$ represent the same curve, we can convert each parametrization to Cartesian form. In doing so, we find that both parameterizations give the Cartesian curve\n\n$$\ny={x}^{3/2},\\,0\\le x\\le 4.\n$$\n\nTherefore, the correct answer is ${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}s=3$ only."} {:db/id #edb/ref 17592186256734 :knowledge-point/_questions [{:db/id #edb/ref 17592186162083 :knowledge-point/id #uuid "96d48adf-a293-54ae-88fd-ee8471e5fc65" :knowledge-point/title "Applying Independence of Parametrization and Orientation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "756cdc53-2932-5002-93f3-0e049675c868" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462079} {:answer/id #uuid "c481b00c-7230-5985-9e66-4d8b6087f4e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462080}] :answer-field/correct {:answer/id #uuid "756cdc53-2932-5002-93f3-0e049675c868" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462079} :answer-field/id #uuid "a52e79c6-6b76-598b-a0c0-137e3101dc68" :answer-field/key "${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}s=-k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462793} {:answer-field/choices [{:answer/id #uuid "0be94117-938f-5e8d-b8dc-23f5959ac80d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462081} {:answer/id #uuid "d62869e1-04c3-5ef3-b5f6-f5bbc804f3f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462082}] :answer-field/correct {:answer/id #uuid "0be94117-938f-5e8d-b8dc-23f5959ac80d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462081} :answer-field/id #uuid "da261af8-d4c1-56bf-8d02-1b93eb8f0515" :answer-field/key "${\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s=\\frac{2k}{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462794} {:answer-field/choices [{:answer/id #uuid "d76ae1f0-3cf0-5980-8be4-9864329b561e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462083} {:answer/id #uuid "668a58f5-744b-5464-a0b3-4a5197e2f210" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462084}] :answer-field/correct {:answer/id #uuid "668a58f5-744b-5464-a0b3-4a5197e2f210" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462084} :answer-field/id #uuid "b55baf9c-63c9-5110-ad82-91c7b4d263f7" :answer-field/key "${\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s=k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462795}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "67eba06b-e142-51bc-86cf-6cd55545886d" :question/math-academy-id "q-122851" :question/problem "Consider the curves ${C}_{1}$ and ${C}_{2},$ defined parametrically as follows:\n\n$$\n\\begin{aligned}{C}_{1}:\\,{r}_{1}(t) & =⟨\\sqrt{9{t}^{2}+1},\\,3t⟩, & 0\\le t\\le \\frac{1}{3} \\\\ {C}_{2}:\\,{r}_{2}(u) & =⟨\\sqrt{4{u}^{2}+1},\\,2u⟩, & 0\\le u\\le \\frac{1}{2}\\end{aligned}\n$$\n\nNow suppose ${\\int }_{{C}_{1}}f(x,y)\\,\\text{d}s=k$ for some function $f(x,y)$ and real number $k.$ Which of the following must be true?\n\nSelect all that apply." :question/worked-solution "Line integrals with respect to arc length are independent of the choice of parametrization and orientation.\n\nWith that in mind, let's examine each statement. \n\n- Statement ${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}s=-k$ is false. Reversing the curve's orientation does *not* change the value of a line integral with respect to arc length. Therefore, we have\n\n$$\n{\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}s={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}s=k.\n$$\n\n- Statement ${\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s=\\frac{2k}{3}$ is false, while statement ${\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s=k$ is true. Notice that ${C}_{1}$ and ${C}_{2}$ are different parameterizations of the same curve. Since line integrals with respect to arc length are independent of the choice of parameterization, we have\n\n$$\n{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s=k.\n$$\n\n \nTo see that ${C}_{1}$ and ${C}_{2}$ represent the same curve, we can convert each parametrization to Cartesian form. In doing so, we find that both parameterizations give the Cartesian curve\n\n$$\nx=\\sqrt{{y}^{2}+1},\\,0\\le y\\le 1.\n$$\n\nTherefore, the correct answer is ${\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s=k$ only."} {:db/id #edb/ref 17592186256735 :knowledge-point/_questions [{:db/id #edb/ref 17592186162083 :knowledge-point/id #uuid "96d48adf-a293-54ae-88fd-ee8471e5fc65" :knowledge-point/title "Applying Independence of Parametrization and Orientation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d626c071-0c70-52ac-bc79-16a2a3cf5cad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462085} {:answer/id #uuid "db1e1ca4-1a4a-5645-912d-ad584f2b5ce9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462086}] :answer-field/correct {:answer/id #uuid "db1e1ca4-1a4a-5645-912d-ad584f2b5ce9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462086} :answer-field/id #uuid "1f97f6d4-1cc7-5a18-9002-6bc12e80f56c" :answer-field/key "${\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s=k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462796} {:answer-field/choices [{:answer/id #uuid "f8ec0988-8d3b-58bb-8f11-a31026537190" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462087} {:answer/id #uuid "7122ea47-8dea-506b-a7e9-89375fe1971b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462088}] :answer-field/correct {:answer/id #uuid "f8ec0988-8d3b-58bb-8f11-a31026537190" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462087} :answer-field/id #uuid "3eccce40-3459-5071-bdd9-96e4fe102f63" :answer-field/key "${\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s=2k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462797} {:answer-field/choices [{:answer/id #uuid "5cd90f72-67c5-5198-8924-c359511557f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462089} {:answer/id #uuid "97613da4-4123-53e9-ac7f-e007a645737b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462090}] :answer-field/correct {:answer/id #uuid "97613da4-4123-53e9-ac7f-e007a645737b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462090} :answer-field/id #uuid "56e9d11d-7777-5fe2-9ce3-8596ef406783" :answer-field/key "${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}s=k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462798}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "261c6852-f708-5ef6-9e89-3d88f4dbba8b" :question/math-academy-id "q-122868" :question/problem "Consider the curves ${C}_{1}$ and ${C}_{2},$ defined parametrically as follows:\n\n$$\n\\begin{aligned}{C}_{1}:\\,{r}_{1}(t) & =⟨2t,\\,2\\sqrt{t}⟩, & 0\\le t\\le 2 \\\\ {C}_{2}:\\,{r}_{2}(u) & =⟨4u,\\,2\\sqrt{2u}⟩, & 0\\le u\\le 1\\end{aligned}\n$$\n\nNow suppose ${\\int }_{{C}_{1}}f(x,y)\\,\\text{d}s=k$ for some function $f(x,y)$ and real number $k.$ Which of the following must be true?\n\nSelect all that apply." :question/worked-solution "Line integrals with respect to arc length are independent of the choice of parametrization and orientation.\n\nWith that in mind, let's examine each statement. \n\n- Statement ${\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s=k$ is true, while statement ${\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s=2k$ is false. Notice that ${C}_{1}$ and ${C}_{2}$ are different parameterizations of the same curve. Since line integrals with respect to arc length are independent of the choice of parameterization, we have\n\n$$\n{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s=k.\n$$\n\n \nTo see that ${C}_{1}$ and ${C}_{2}$ represent the same curve, we can convert each parametrization to Cartesian form. In doing so, we find that both parameterizations give the Cartesian curve\n\n$$\ny=\\sqrt{2x},\\,0\\le x\\le 4.\n$$\n\n- Statement ${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}s=k$ is true. Reversing the curve's orientation does *not* change the value of a line integral with respect to arc length. Therefore, we have\n\n$$\n{\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}s={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}s=k.\n$$\n\nTherefore, the correct answer is ${\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s=k$; ${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}s=k$ only."} {:db/id #edb/ref 17592186256748 :knowledge-point/_questions [{:db/id #edb/ref 17592186179723 :knowledge-point/id #uuid "2bc800b0-3901-5154-81ac-1ef853017320" :knowledge-point/title "Identifying Partitions of the Real Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27b20b3e-304f-5df6-8652-bce6edf26938" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462091} {:answer/id #uuid "489d1517-18d2-5e62-ba9d-deff93e291da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462092}] :answer-field/correct {:answer/id #uuid "489d1517-18d2-5e62-ba9d-deff93e291da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462092} :answer-field/id #uuid "aa7746cf-da4e-5bea-9ac8-a9cfe214feef" :answer-field/key "${-10,-9,-8,-4,-2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462799} {:answer-field/choices [{:answer/id #uuid "ff69bf31-c057-57e2-86a4-9ee808c23372" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462093} {:answer/id #uuid "91e66fa0-b75f-53ca-963d-a9fa01e18b82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462094}] :answer-field/correct {:answer/id #uuid "ff69bf31-c057-57e2-86a4-9ee808c23372" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462093} :answer-field/id #uuid "78ca3220-a686-585b-a4f6-89e0768fff3b" :answer-field/key "${-9,-5,-4,-2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462800} {:answer-field/choices [{:answer/id #uuid "896eb089-bc78-567d-a7b6-74bcc1d26fb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462095} {:answer/id #uuid "fb746655-4225-5924-ac54-c3777ea61a89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462096}] :answer-field/correct {:answer/id #uuid "896eb089-bc78-567d-a7b6-74bcc1d26fb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462095} :answer-field/id #uuid "11fab9d7-5cc0-5afc-bb7d-b8c6c494f124" :answer-field/key "$-10<-6<-4<-3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462801}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3e297ed2-2489-5ad9-8dda-10806650784e" :question/math-academy-id "q-122935" :question/problem "Which of the following are partitions of the real interval $[-10,-2]?$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A partition $P$ of a closed interval $[a,b]$ is a finite sequence of real numbers taken from $[a,b]$ such that\n\n$$\na={x}_{0}<{x}_{1}<{x}_{2}<…<{x}_{n}=b\\,.\n$$\n\nWe can express $P$ using set notation as\n\n$$\nP={{x}_{0},{x}_{1},…,{x}_{n}}.\n$$\n\n \n\nWith that in mind, let's consider each statement:\n\n- Statement ${-10,-9,-8,-4,-2}$ is a partition of $[-10,-2].$\n\n- Statement ${-9,-5,-4,-2}$ is not a partition of $[-10,-2]$  since it does not include the left endpoint $a=-10.$\n\n- Statement $-10<-6<-4<-3$ is not a partition of $[-10,-2]$ since it does not include the right endpoint $b=-2.$\n\nTherefore, the correct answer is ${-10,-9,-8,-4,-2}$ only."} {:db/id #edb/ref 17592186256749 :knowledge-point/_questions [{:db/id #edb/ref 17592186179723 :knowledge-point/id #uuid "2bc800b0-3901-5154-81ac-1ef853017320" :knowledge-point/title "Identifying Partitions of the Real Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26715d5c-8967-5870-a32d-f0e7de04504e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462097} {:answer/id #uuid "cffe34d1-2420-5409-9740-ce2cb5bd06e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462098}] :answer-field/correct {:answer/id #uuid "26715d5c-8967-5870-a32d-f0e7de04504e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462097} :answer-field/id #uuid "59a63827-ba0c-5262-83e4-7514a1d6d98a" :answer-field/key "${-3,-5,1,2,6}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462802} {:answer-field/choices [{:answer/id #uuid "5500db0b-5028-5ca1-9101-be045fa07fbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462099} {:answer/id #uuid "f59f0c27-693f-5b74-9c2c-1f1aaecba22c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462100}] :answer-field/correct {:answer/id #uuid "5500db0b-5028-5ca1-9101-be045fa07fbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462099} :answer-field/id #uuid "4bd4fdc7-a23b-54cd-bd68-59ae2ea9f1c1" :answer-field/key "${-3,0,3,7,8}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462803} {:answer-field/choices [{:answer/id #uuid "bfc8220c-0f8b-58d7-84b9-a08eddb6eba8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462101} {:answer/id #uuid "646e11a8-a44c-5fe3-934b-ea14c43adefb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462102}] :answer-field/correct {:answer/id #uuid "646e11a8-a44c-5fe3-934b-ea14c43adefb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462102} :answer-field/id #uuid "4e42328f-21c1-5e9f-b9f3-96c9ef90effe" :answer-field/key "${-3,-2,1,3,4,7}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462804}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bede805a-096d-538b-aca7-d4841b6beb80" :question/math-academy-id "q-122937" :question/problem "Which of the following are partitions of the real interval $[-3,7]?$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A partition $P$ of a closed interval $[a,b]$ is a finite sequence of real numbers taken from $[a,b]$ such that\n\n$$\na={x}_{0}<{x}_{1}<{x}_{2}<…<{x}_{n}=b\\,.\n$$\n\nWe can express $P$ using set notation as\n\n$$\nP={{x}_{0},{x}_{1},…,{x}_{n}}.\n$$\n\n \n\nWith that in mind, let's consider each statement:\n\n- Statement ${-3,-5,1,2,6}$ is not a partition of $[-3,7]$ since it does not include the right endpoint $b=7.$\n\n- Statement ${-3,0,3,7,8}$ is not a partition of $[-3,7]$ since $8$ does not belong to $[-3,7].$\n\n- Statement ${-3,-2,1,3,4,7}$ is a partition of $[-3,7].$\n\nTherefore, the correct answer is ${-3,-2,1,3,4,7}$ only."} {:db/id #edb/ref 17592186256750 :knowledge-point/_questions [{:db/id #edb/ref 17592186179723 :knowledge-point/id #uuid "2bc800b0-3901-5154-81ac-1ef853017320" :knowledge-point/title "Identifying Partitions of the Real Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72905ab0-a733-5444-b228-2909f22d66b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462103} {:answer/id #uuid "0bba932b-ac60-5190-b246-809450ca8184" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462104}] :answer-field/correct {:answer/id #uuid "72905ab0-a733-5444-b228-2909f22d66b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462103} :answer-field/id #uuid "a9bcd569-770e-5e56-999c-b6c6fea7c704" :answer-field/key "$0<0.5<1.5<2.5<4<4.5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462805} {:answer-field/choices [{:answer/id #uuid "4e8fceca-ad1f-553f-b1ae-fe2c3ddb4eab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462105} {:answer/id #uuid "882459bb-e603-5cca-bca5-49e509a1cc37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462106}] :answer-field/correct {:answer/id #uuid "4e8fceca-ad1f-553f-b1ae-fe2c3ddb4eab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462105} :answer-field/id #uuid "83c1ee2c-3ed9-508e-85bf-38d31fb14d69" :answer-field/key "${0,1,2,3.9}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462806} {:answer-field/choices [{:answer/id #uuid "4bfb0fa3-fc7f-5f90-b747-7ae59892eded" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462107} {:answer/id #uuid "17db6afa-0a52-5a1b-b581-fb1c6a16a12b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462108}] :answer-field/correct {:answer/id #uuid "17db6afa-0a52-5a1b-b581-fb1c6a16a12b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462108} :answer-field/id #uuid "ecabc5c1-9328-5f82-a212-4432161d262a" :answer-field/key "$0<0.1<1.5<2.5<4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462807}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8952dce8-c604-5674-b4ed-f948b3d55e92" :question/math-academy-id "q-122938" :question/problem "Which of the following are partitions of the real interval $[0,4]?$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A partition $P$ of a closed interval $[a,b]$ is a finite sequence of real numbers taken from $[a,b]$ such that\n\n$$\na={x}_{0}<{x}_{1}<{x}_{2}<…<{x}_{n}=b\\,.\n$$\n\nWe can express $P$ using set notation as\n\n$$\nP={{x}_{0},{x}_{1},…,{x}_{n}}.\n$$\n\n \n\nWith that in mind, let's consider each statement:\n\n- Statement $0<0.5<1.5<2.5<4<4.5$ is not a partition of $[0,4]$  since $4.5$ does not belong to $[0,4].$\n\n- Statement ${0,1,2,3.9}$ is not a partition of $[0,4]$  since it does not include the left endpoint $a=4.$\n\n- Statement $0<0.1<1.5<2.5<4$ is  a partition of  $[0,4].$\n\nTherefore, the correct answer is $0<0.1<1.5<2.5<4$ only."} {:db/id #edb/ref 17592186256753 :knowledge-point/_questions [{:db/id #edb/ref 17592186179723 :knowledge-point/id #uuid "2bc800b0-3901-5154-81ac-1ef853017320" :knowledge-point/title "Identifying Partitions of the Real Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3c94f60-dce8-5310-98c8-490721be660c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462109} {:answer/id #uuid "4690830e-d7a4-53ef-a3d0-da14683fd4cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462110}] :answer-field/correct {:answer/id #uuid "4690830e-d7a4-53ef-a3d0-da14683fd4cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462110} :answer-field/id #uuid "5c9bec84-5bfa-5f23-9d91-45481b6d2d4c" :answer-field/key "$-1<0<\\frac{1}{2}<1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462808} {:answer-field/choices [{:answer/id #uuid "e4b44a6e-1c77-50f9-95c4-1ea66bdb6535" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462111} {:answer/id #uuid "09c99a6b-29a5-58ee-92ac-18e79c0c1275" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462112}] :answer-field/correct {:answer/id #uuid "e4b44a6e-1c77-50f9-95c4-1ea66bdb6535" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462111} :answer-field/id #uuid "7920ed03-ed98-5ac8-b419-cddef93bd9f9" :answer-field/key "${-2,-1,0,1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462809} {:answer-field/choices [{:answer/id #uuid "7c714691-fe15-51e3-b17c-99e026e22a68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462113} {:answer/id #uuid "c51f69c8-096e-58f0-9239-99872860fc19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462114}] :answer-field/correct {:answer/id #uuid "7c714691-fe15-51e3-b17c-99e026e22a68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462113} :answer-field/id #uuid "a8fcadbd-4826-5e8c-a4ae-1089e883df98" :answer-field/key "${-1,0,2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462810}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "262ee643-f0e4-53c0-890c-0b72dbd00fad" :question/math-academy-id "q-122954" :question/problem "Which of the following are partitions of the real interval $[-1,1]?$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A partition $P$ of a closed interval $[a,b]$ is a finite sequence of real numbers taken from $[a,b]$ such that\n\n$$\na={x}_{0}<{x}_{1}<{x}_{2}<…<{x}_{n}=b\\,.\n$$\n\nWe can express $P$ using set notation as\n\n$$\nP={{x}_{0},{x}_{1},…,{x}_{n}}.\n$$\n\n \n\nWith that in mind, let's consider each statement:\n\n- Statement $-1<0<\\frac{1}{2}<1$ is a partition of $[-1,1].$\n\n- Statement ${-2,-1,0,1}$ is not a partition of $[-1,1]$ since $-2$ does not belong to $[-1,1].$\n\n- Statement ${-1,0,2}$ is not a partition of  $[-1,1]$ since $2$ does not belong to $[-1,1].$\n\nTherefore, the correct answer is $-1<0<\\frac{1}{2}<1$ only."} {:db/id #edb/ref 17592186259500 :knowledge-point/_questions [{:db/id #edb/ref 17592186133880 :knowledge-point/id #uuid "4f47e201-105a-579a-8cde-fcb6bf8cfa2a" :knowledge-point/title "Interpreting Divergence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bdadf6b7-b5f9-5ff7-9423-ee3c12b80906" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437696} {:answer/id #uuid "7afe5777-93e3-5e99-a2e4-41abc2620fde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437697}] :answer-field/correct {:answer/id #uuid "bdadf6b7-b5f9-5ff7-9423-ee3c12b80906" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437696} :answer-field/id #uuid "56b6426b-0fec-5055-bd39-2d631eea5084" :answer-field/key "$∇\\cdot F=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438877} {:answer-field/choices [{:answer/id #uuid "4ee82610-209a-5b78-b3d9-815a176668e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437698} {:answer/id #uuid "218da758-973f-597f-9d25-7e96cca48a13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437699}] :answer-field/correct {:answer/id #uuid "218da758-973f-597f-9d25-7e96cca48a13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437699} :answer-field/id #uuid "cf1d5aa2-61f4-5ae5-820b-1c0a43cd6b89" :answer-field/key "$∇\\cdot F>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438878} {:answer-field/choices [{:answer/id #uuid "a0cb7edd-be74-59d2-8f1d-e4b255c19180" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437700} {:answer/id #uuid "5c1d58ac-1b17-52c3-85f9-1a4e8ccf3e3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437701}] :answer-field/correct {:answer/id #uuid "a0cb7edd-be74-59d2-8f1d-e4b255c19180" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437700} :answer-field/id #uuid "5c31b148-ee70-55fa-98e7-113f08d54dcb" :answer-field/key "$∇\\cdot F<0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438879} {:answer-field/choices [{:answer/id #uuid "e0278e5b-a8cc-5043-8edc-7930e23fc2a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437702} {:answer/id #uuid "b0f04e4b-8759-51b7-872f-3f8b7a858ddb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437703}] :answer-field/correct {:answer/id #uuid "e0278e5b-a8cc-5043-8edc-7930e23fc2a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437702} :answer-field/id #uuid "4e31a88d-2ad7-541b-b970-bc6b7d159b50" :answer-field/key "$F$ is solenoidal" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438880}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d890a9be-d244-5a2b-a434-390b31123a28" :question/math-academy-id "q-123245" :question/problem "![](images/b3/b315be9ba524ab538388fdaad31161c280d7d6e5ab71261345063ac6ffe819d5.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\nSelect all that apply." :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $F$ acts like a source at $P,$ then $∇\\cdot F>0$ at $P.$\n\n- If $F$ acts like a sink at $P,$ then $∇\\cdot F<0$ at $P.$\n\n- If $F$ acts like neither a source nor a sink at $P,$ then $∇\\cdot F=0$ at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement $∇\\cdot F>0$ is true, whereas statements $∇\\cdot F=0$ and $∇\\cdot F<0$ are false. Notice that the lengths of the vectors increase as we move vertically and horizontally away from the origin. Therefore, the vector field $F$ acts like a source at every point.\n\n- Statement “$F$ is solenoidal” is false. Since $∇\\cdot F\\ne 0,$ the vector field $F$ is not solenoidal.\n\nTherefore, the correct answer is $∇\\cdot F>0$ only."} {:db/id #edb/ref 17592186259513 :knowledge-point/_questions [{:db/id #edb/ref 17592186096740 :knowledge-point/id #uuid "1d14dbef-9a16-537e-a182-87fd6853e543" :knowledge-point/title "Identifying Divergent Sequences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bca2530b-bb64-52f7-a45b-e9e942c12f70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462115} {:answer/id #uuid "ed7db762-1c0d-5250-9ebf-d6bb5d416616" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462116}] :answer-field/correct {:answer/id #uuid "bca2530b-bb64-52f7-a45b-e9e942c12f70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462115} :answer-field/id #uuid "af6273ab-67d5-5f4d-ae5a-ec2fea2a72be" :answer-field/key "${a}_{n}=\\frac{n}{{n}^{2}+1}$ for $n\\ge 1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462811} {:answer-field/choices [{:answer/id #uuid "3795a52b-460f-516d-b89a-3646a7684931" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462117} {:answer/id #uuid "e59292d2-d98c-5009-8584-63894e93b7c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462118}] :answer-field/correct {:answer/id #uuid "e59292d2-d98c-5009-8584-63894e93b7c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462118} :answer-field/id #uuid "96b5a61e-9bdb-540b-860d-f0d06105667e" :answer-field/key "${a}_{n}=\\frac{{n}^{2}-1}{n+2}$ for $n\\ge 1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462812} {:answer-field/choices [{:answer/id #uuid "e24e8386-fb94-51e5-a25c-a7d8802bcd8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462119} {:answer/id #uuid "5f3813d4-cdd5-55d9-967f-2fe41d570f50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462120}] :answer-field/correct {:answer/id #uuid "e24e8386-fb94-51e5-a25c-a7d8802bcd8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462119} :answer-field/id #uuid "5102062d-da0d-5d1f-82ce-ee0afd92695b" :answer-field/key "${a}_{n}=\\frac{2}{{n}^{2}}$ for $n\\ge 1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462813}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d4fb4950-bb82-5daa-8ec2-15e3bd87b309" :question/math-academy-id "q-123321" :question/problem "Which of the following sequences diverge?\n\nSelect all that apply." :question/worked-solution "Let's analyze each sequence in turn. We need to calculate the limit of each sequence as $n$ approaches infinity.\n\n- In sequence “${a}_{n}=\\frac{n}{{n}^{2}+1}$ for $n\\ge 1$”,  the dominant term in the denominator is ${n}^{2},$ so we divide the numerator and the denominator by ${n}^{2}$ and get\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }{a}_{n} & ={lim}_{n\\to \\infty }\\frac{n}{{n}^{2}+1} \\\\  & ={lim}_{n\\to \\infty }\\frac{\\left(\\frac{n}{{n}^{2}}\\right)}{(\\frac{{n}^{2}}{{n}^{2}}+\\frac{1}{{n}^{2}})} \\\\  & ={lim}_{n\\to \\infty }\\frac{\\left(\\frac{1}{n}\\right)}{(1+\\frac{1}{{n}^{2}})} \\\\  & =\\frac{0}{1+0} \\\\  & =0.\\end{aligned}\n$$\n\nThe limit exists, so the sequence converges.\n\n- In sequence “${a}_{n}=\\frac{{n}^{2}-1}{n+2}$ for $n\\ge 1$”, the dominant term in the denominator is $n,$ so we divide the numerator and the denominator by $n$ and get\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }{a}_{n} & ={lim}_{n\\to \\infty }\\frac{{n}^{2}-1}{n+2} \\\\  & ={lim}_{n\\to \\infty }\\frac{(\\frac{{n}^{2}}{n}-\\frac{1}{n})}{(\\frac{n}{n}+\\frac{2}{n})} \\\\  & ={lim}_{n\\to \\infty }\\frac{(n-\\frac{1}{n})}{(1+\\frac{2}{n})} \\\\  & ={lim}_{n\\to \\infty }\\frac{n-0}{1+0} \\\\  & =\\infty .\\end{aligned}\n$$\n\nThe limit does not exist, so the sequence diverges.\n\n- In sequence “${a}_{n}=\\frac{2}{{n}^{2}}$ for $n\\ge 1$”,  the limit is\n\n$$\n{lim}_{n\\to \\infty }{a}_{n}={lim}_{n\\to \\infty }\\frac{2}{{n}^{2}}=0.\n$$\n\nThe limit exists, so the sequence converges.\n\nIn conclusion, sequence “${a}_{n}=\\frac{{n}^{2}-1}{n+2}$ for $n\\ge 1$” diverges."} {:db/id #edb/ref 17592186259575 :knowledge-point/_questions [{:db/id #edb/ref 17592186172091 :knowledge-point/id #uuid "280e7ba4-7617-546b-9e0d-a5bdc33dad8d" :knowledge-point/title "Identifying Simply-Connected Regions in Euclidian Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b897e95-6751-561b-8fe2-d21f1c751aef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462121} {:answer/id #uuid "02bf65b2-4dee-5c75-bd11-dc4da68376bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462122}] :answer-field/correct {:answer/id #uuid "02bf65b2-4dee-5c75-bd11-dc4da68376bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462122} :answer-field/id #uuid "9a76947c-5a6b-5e4a-a6f6-ac98081baf53" :answer-field/key "${R}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462814} {:answer-field/choices [{:answer/id #uuid "f6739d37-a2f6-5db7-aff1-cdaafa0a656f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462123} {:answer/id #uuid "5c40bbe8-1385-5908-b8bb-8a4c13e1d9eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462124}] :answer-field/correct {:answer/id #uuid "f6739d37-a2f6-5db7-aff1-cdaafa0a656f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462123} :answer-field/id #uuid "fa4f729d-1314-52e4-8ead-056fdb497338" :answer-field/key "${(x,y)\\in {R}^{2}\\,|\\,1<{x}^{2}+{y}^{2}<4}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462815} {:answer-field/choices [{:answer/id #uuid "99d2c420-75a3-5cbb-b889-bcd9709d3efa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462125} {:answer/id #uuid "76cc7a7c-dfb6-5352-a448-d886f75dcc59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462126}] :answer-field/correct {:answer/id #uuid "99d2c420-75a3-5cbb-b889-bcd9709d3efa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462125} :answer-field/id #uuid "44efefaa-2790-5c2f-9f2e-d8be27d699d2" :answer-field/key "${(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}\\ne 0}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462816}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "43a2cfcc-f62a-5511-8a9e-2111b0d76d4f" :question/math-academy-id "q-123887" :question/problem "Which of the following regions are simply connected?\n\nSelect all that apply." :question/worked-solution "A connected region $D$ is simply connected if every simple closed curve in $D$ can be contracted to a point.\n\n![](images/7d/7d6aea1a62fb290702630ef95ec86f4119e7c8fdd74b8148b62b66e5ac871b58.png)\n\nA connected *plane* region $D$ is simply connected if every simple closed curve in $D$ encloses only points in $D.$ In other words, the region does not contain any holes. Plane regions containing holes are not simply connected, since some simple closed curves cannot be contracted to a point:\n\n![](images/c3/c3c3e7a60ff0dd917cf6c0b293dae7510e457a0455629add1c54cadac65248b7.png)\n\nLet's now examine our regions in turn.\n\n- Region ${R}^{2}$ is simply connected. It's a plane region without holes.\n\n- Region ${(x,y)\\in {R}^{2}\\,|\\,1<{x}^{2}+{y}^{2}<4}$ is *not* simply connected since it's a plane region (a circle) with a hole. In this case, the hole contains all points on the disc ${x}^{2}+{y}^{2}\\le 1.$\n\n- Region ${(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}\\ne 0}$ is *not* simply connected since it's a plane region with a hole at $(0,0).$\n\nTherefore, the correct answer is ${R}^{2}$ only."} {:db/id #edb/ref 17592186259578 :knowledge-point/_questions [{:db/id #edb/ref 17592186172091 :knowledge-point/id #uuid "280e7ba4-7617-546b-9e0d-a5bdc33dad8d" :knowledge-point/title "Identifying Simply-Connected Regions in Euclidian Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab02e9fa-a18a-5bfa-9a4a-7874d2595d15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462127} {:answer/id #uuid "bc3e1362-a334-597f-8485-f598c327597d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462128}] :answer-field/correct {:answer/id #uuid "bc3e1362-a334-597f-8485-f598c327597d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462128} :answer-field/id #uuid "21c918c9-a056-5a14-b108-cf36eee94f94" :answer-field/key "${(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}\\le 1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462817} {:answer-field/choices [{:answer/id #uuid "0820282f-a984-584d-bb09-4ba91b706ae5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462129} {:answer/id #uuid "022346a4-c6ef-5e3d-be52-9a15682c2b6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462130}] :answer-field/correct {:answer/id #uuid "0820282f-a984-584d-bb09-4ba91b706ae5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462129} :answer-field/id #uuid "40de5a38-0a97-54ce-bf6a-9b61bdad89f0" :answer-field/key "${(x,y)\\in {R}^{2}\\,|\\,(x,y)\\ne (2,1)}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462818} {:answer-field/choices [{:answer/id #uuid "eb50d634-93dd-5dba-aa37-be77a33be6b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462131} {:answer/id #uuid "b52fb96c-4878-59cc-b25e-fe43a2f31ba8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462132}] :answer-field/correct {:answer/id #uuid "eb50d634-93dd-5dba-aa37-be77a33be6b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462131} :answer-field/id #uuid "58585584-2f73-5c3c-ae4c-6fbf764850ac" :answer-field/key "${(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}>25}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462819}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "beac61f6-0d9e-58bf-85d2-405f0693eb4d" :question/math-academy-id "q-123916" :question/problem "Which of the following regions are simply connected?\n\nSelect all that apply." :question/worked-solution "A connected region $D$ is simply connected if every simple closed curve in $D$ can be contracted to a point.\n\n![](images/7d/7d6aea1a62fb290702630ef95ec86f4119e7c8fdd74b8148b62b66e5ac871b58.png)\n\nA connected *plane* region $D$ is simply connected if every simple closed curve in $D$ encloses only points in $D.$ In other words, the region does not contain any holes. Plane regions containing holes are not simply connected, since some simple closed curves cannot be contracted to a point:\n\n![](images/c3/c3c3e7a60ff0dd917cf6c0b293dae7510e457a0455629add1c54cadac65248b7.png)\n\nLet's now examine our regions in turn. \n\n- Region ${(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}\\le 1}$ is simply connected. It's a plane region (a circle) without holes.\n\n- Region ${(x,y)\\in {R}^{2}\\,|\\,(x,y)\\ne (2,1)}$ is *not* simply connected since it's a plane region with a hole at $(2,1).$\n\n- Region ${(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}>25}$ is *not* simply connected since it's a plane region with a hole. In this case, the hole contains all points on the disc ${x}^{2}+{y}^{2}\\le 25.$\n\nTherefore, the correct answer is ${(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}\\le 1}$ only."} {:db/id #edb/ref 17592186259579 :knowledge-point/_questions [{:db/id #edb/ref 17592186172091 :knowledge-point/id #uuid "280e7ba4-7617-546b-9e0d-a5bdc33dad8d" :knowledge-point/title "Identifying Simply-Connected Regions in Euclidian Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35574a80-0287-507b-88de-4c81ae7d6d13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462133} {:answer/id #uuid "c60a5879-3096-5a0a-919f-13e24b8584ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462134}] :answer-field/correct {:answer/id #uuid "35574a80-0287-507b-88de-4c81ae7d6d13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462133} :answer-field/id #uuid "24b3664c-da91-5036-9b62-f16a49bd6604" :answer-field/key "${(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}\\ne 1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462820} {:answer-field/choices [{:answer/id #uuid "d36e33c9-d5fe-5406-bc31-4bd39f4e0587" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462135} {:answer/id #uuid "afabceb2-3e43-58e3-a309-981fc0910b96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462136}] :answer-field/correct {:answer/id #uuid "d36e33c9-d5fe-5406-bc31-4bd39f4e0587" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462135} :answer-field/id #uuid "3e7c6623-9f65-56c6-8e08-bf71a010850f" :answer-field/key "${(x,y)\\in {R}^{2}\\,|\\,(x,y)\\ne (0,0)}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462821} {:answer-field/choices [{:answer/id #uuid "d193f0e7-ab4d-5e93-ba8e-b2623717b696" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462137} {:answer/id #uuid "6ee03dde-34a7-588a-a871-826d7b944ffb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462138}] :answer-field/correct {:answer/id #uuid "6ee03dde-34a7-588a-a871-826d7b944ffb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462138} :answer-field/id #uuid "182ce5ea-8de5-5895-8540-00589a1f0f62" :answer-field/key "${(x,y)\\in {R}^{2}\\,|\\,x\\ge 0}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462822}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cd4cc5a1-c047-51e7-8736-2282f38e56c0" :question/math-academy-id "q-123923" :question/problem "Which of the following regions are simply connected?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A connected region $D$ is simply connected if every simple closed curve in $D$ can be contracted to a point.\n\n![](images/7d/7d6aea1a62fb290702630ef95ec86f4119e7c8fdd74b8148b62b66e5ac871b58.png)\n\nA connected *plane* region $D$ is simply connected if every simple closed curve in $D$ encloses only points in $D.$ In other words, the region does not contain any holes. Plane regions containing holes are not simply connected, since some simple closed curves cannot be contracted to a point:\n\n![](images/c3/c3c3e7a60ff0dd917cf6c0b293dae7510e457a0455629add1c54cadac65248b7.png)\n\nLet's now examine our regions in turn.\n\n- Region ${(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}\\ne 1}$ is *not* simply connected. The region contains all the points of ${R}^{2}$ except those on the circle ${x}^{2}+{y}^{2}=1.$ Thus, the region is formed by two disjoint pieces and, therefore, is not even a connected region.\n\n- Region ${(x,y)\\in {R}^{2}\\,|\\,(x,y)\\ne (0,0)}$ is *not* simply connected since it's a plane region with a hole at $(0,0).$\n\n- Region ${(x,y)\\in {R}^{2}\\,|\\,x\\ge 0}$ is simply connected. It's a plane region without holes.\n\nTherefore, the correct answer is ${(x,y)\\in {R}^{2}\\,|\\,x\\ge 0}$ only."} {:db/id #edb/ref 17592186259580 :knowledge-point/_questions [{:db/id #edb/ref 17592186166863 :knowledge-point/id #uuid "65adbd80-9647-59d8-bd4a-42f431587c85" :knowledge-point/title "Identifying Conservative Vector Fields"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71ea03ce-0bea-5a33-b768-531593cecfa0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437710} {:answer/id #uuid "3e12d6c1-cf51-5a79-9824-a889289525f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437711}] :answer-field/correct {:answer/id #uuid "71ea03ce-0bea-5a33-b768-531593cecfa0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437710} :answer-field/id #uuid "e9705fa0-051d-5108-9f33-8e0b95bf6771" :answer-field/key "$F=x\\operatorname{sin}⁡y\\,i+y\\operatorname{cos}⁡x\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438884} {:answer-field/choices [{:answer/id #uuid "71524ab4-c1fe-56a5-b9b0-5f1247ce034e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437712} {:answer/id #uuid "9809981f-9ddb-5aa8-be88-9c61eb732ec0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437713}] :answer-field/correct {:answer/id #uuid "9809981f-9ddb-5aa8-be88-9c61eb732ec0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437713} :answer-field/id #uuid "57bc640c-07ec-54b1-ad03-d8c8b9f0a1f6" :answer-field/key "$G=3{e}^{3x+2y}\\,i+2{e}^{3x+2y}\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438885} {:answer-field/choices [{:answer/id #uuid "425e03bd-f65f-5c5d-a11e-3e1e0b0bfa52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437714} {:answer/id #uuid "6312d848-ea3c-5408-9f3b-a4a431e27732" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437715}] :answer-field/correct {:answer/id #uuid "6312d848-ea3c-5408-9f3b-a4a431e27732" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437715} :answer-field/id #uuid "482a8231-c447-5ba1-b319-c14d7a80bd76" :answer-field/key "$H=2xy\\,i+({x}^{2}+{y}^{2})\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438886}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dc1786af-49ed-5f49-98af-90852a6f6e8b" :question/math-academy-id "q-123984" :question/problem "Which of the following vector fields are conservative on ${R}^{2}?$\n\nSelect all that apply." :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D={R}^{2}.$ With this in mind, let's check each of the vector fields. \n\n- For the vector field $F,$ we have $P=x\\operatorname{sin}⁡y$ and $Q=y\\operatorname{cos}⁡x.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=x\\operatorname{cos}⁡y,\\,\\frac{∂Q}{∂x}=-y\\operatorname{sin}⁡x.\n$$\n\nSince the partial derivatives are not equal, we conclude that $F$ is not conservative on ${R}^{2}.$\n\n- For the vector field $G,$ we have $P=3{e}^{3x+2y}$ and $Q=2{e}^{3x+2y}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=6{e}^{3x+2y},\\,\\frac{∂Q}{∂x}=6{e}^{3x+2y}.\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $G$ is conservative on ${R}^{2}.$\n\n- For the vector field $H,$ we have $P=2xy$ and $Q={x}^{2}+{y}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=2x,\\,\\frac{∂Q}{∂x}=2x.\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $H$ is conservative on ${R}^{2}.$\n\nTherefore, the correct answer is $G=3{e}^{3x+2y}\\,i+2{e}^{3x+2y}\\,j$; $H=2xy\\,i+({x}^{2}+{y}^{2})\\,j$ only."} {:db/id #edb/ref 17592186259616 :knowledge-point/_questions [{:db/id #edb/ref 17592186179769 :knowledge-point/id #uuid "36996ffc-7dbc-51f8-8efe-46ed2c897045" :knowledge-point/title "Determining Whether an Affine Transformation is Orientation-Preserving"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54c59e1d-3aed-5da5-920b-29c76019c43a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448116} {:answer/id #uuid "65846218-0157-5d80-8b43-2067671bbc03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448117}] :answer-field/correct {:answer/id #uuid "54c59e1d-3aed-5da5-920b-29c76019c43a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448116} :answer-field/id #uuid "0fa076dd-8abf-59ea-9d79-6e4ebe730fb3" :answer-field/key "$A=\\begin{bmatrix}2 & 1 \\\\ 1 & 2\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449098} {:answer-field/choices [{:answer/id #uuid "156e6ee8-01e7-5772-b147-fd55c7d3c214" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448118} {:answer/id #uuid "51c116a2-fae9-567e-95e7-40ff22cbaba5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448119}] :answer-field/correct {:answer/id #uuid "51c116a2-fae9-567e-95e7-40ff22cbaba5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448119} :answer-field/id #uuid "edd5c395-ce4f-5039-81bb-88e680e6bc71" :answer-field/key "$det(A)=-3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449099} {:answer-field/choices [{:answer/id #uuid "d725b57b-1d7c-5344-ba8b-e298e326a6c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448120} {:answer/id #uuid "4043b8e8-4044-5bab-95d2-94eb0591fd0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448121}] :answer-field/correct {:answer/id #uuid "d725b57b-1d7c-5344-ba8b-e298e326a6c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448120} :answer-field/id #uuid "27bc06ab-a2f6-5b10-9434-da9802d98339" :answer-field/key "The transformation $T$ is orientation-preserving" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449100}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d0a1ba57-9eac-5d49-9cdd-f7f25fec8c92" :question/math-academy-id "q-124192" :question/problem "Consider the affine transformation $T$ defined as\n\n$$\nx=2v+u+1,\\,y=u-v-2.\n$$\n\nLet $A$ be the matrix representation of the linear transformation associated with $T.$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nLet's look at each statement in turn:\n\n- Statement $A=\\begin{bmatrix}2 & 1 \\\\ 1 & 2\\end{bmatrix}$ is false. Notice that the given transformation can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}2v+u+1 \\\\ u-v-2\\end{bmatrix} \\\\  & =\\begin{bmatrix}u+2v \\\\ u-v\\end{bmatrix}+\\begin{bmatrix}1 \\\\ -2\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}1 & 2 \\\\ 1 & -1\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}}_{b}\\end{aligned}\n$$\n\nTherefore, the matrix representation of the linear transformation associated with $T$ is $A=\\begin{bmatrix}1 & 2 \\\\ 1 & -1\\end{bmatrix}.$\n\n- Statement $det(A)=-3$ is true. Indeed, computing the determinant of $A,$ we get\n\n$$\ndet(A)=\\begin{vmatrix}1 & 2 \\\\ 1 & -1\\end{vmatrix}=1\\cdot (-1)-2\\cdot 1=-3.\n$$\n\n- Statement “The transformation $T$ is orientation-preserving” is false. Since $det(A)<0,$ the affine transformation $T$ is not orientation-preserving.\n\nTherefore, the correct answer is $det(A)=-3$ only."} {:db/id #edb/ref 17592186259620 :knowledge-point/_questions [{:db/id #edb/ref 17592186179770 :knowledge-point/id #uuid "e39ae7fc-ff0a-5b97-8e13-1f15b12a07e5" :knowledge-point/title "Identifying Invertible Affine Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34bfe153-da06-5e91-af3f-09f4545070dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448128} {:answer/id #uuid "3edad985-cc26-5a5e-af3e-6700e60c71ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448129}] :answer-field/correct {:answer/id #uuid "34bfe153-da06-5e91-af3f-09f4545070dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448128} :answer-field/id #uuid "eadb4e27-873a-5521-888f-69f05d97b5e2" :answer-field/key "$A=\\begin{bmatrix}2 & -6 \\\\ 5 & -1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449104} {:answer-field/choices [{:answer/id #uuid "2ba40652-c044-55c4-8a94-35b541239ded" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448130} {:answer/id #uuid "947b203f-00c8-5eca-95c1-efce409088a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448131}] :answer-field/correct {:answer/id #uuid "947b203f-00c8-5eca-95c1-efce409088a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448131} :answer-field/id #uuid "00944724-9959-5392-a192-85f20e1ec85e" :answer-field/key "$det(A)=4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449105} {:answer-field/choices [{:answer/id #uuid "20afd0a3-b0c0-5791-b565-fc7e5b831524" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448132} {:answer/id #uuid "9dda385e-2665-5c6a-93bd-f8b119850f77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448133}] :answer-field/correct {:answer/id #uuid "9dda385e-2665-5c6a-93bd-f8b119850f77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448133} :answer-field/id #uuid "36adaa95-128f-5bfd-b7a0-fecb70c1d1da" :answer-field/key "The transformation is invertible" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449106}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3230d0ef-3334-5e9c-bc28-426c4388c6b0" :question/math-academy-id "q-124213" :question/problem "Consider the affine transformation $T$ defined as\n\n$$\nx=2u-6v-2,\\,y=5v-u+9.\n$$\n\nSuppose that $A$ is the matrix that represents the linear transformation associated with $T.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nLet's look at each statement in turn:\n\n- Statement $A=\\begin{bmatrix}2 & -6 \\\\ 5 & -1\\end{bmatrix}$ is false. The given transformation can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}2u-6v-2 \\\\ 5v-u+9\\end{bmatrix} \\\\  & =\\begin{bmatrix}2u-6v \\\\ -u+5v\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ 9\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}2 & -6 \\\\ -1 & 5\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}-2 \\\\ 9\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\nA=\\begin{bmatrix}2 & -6 \\\\ -1 & 5\\end{bmatrix}\\ne \\begin{bmatrix}2 & -6 \\\\ 5 & -1\\end{bmatrix}.\n$$\n\n- Statement $det(A)=4$ is true. Computing the determinant of $A,$ we get\n\n$$\ndet(A)=\\begin{vmatrix}2 & -6 \\\\ -1 & 5\\end{vmatrix}=5\\cdot 2-(-6)\\cdot (-1)=4\\ne 0.\n$$\n\n- Statement “The transformation is invertible” is true. Since $det(A)\\ne 0,$ the affine transformation is invertible.\n\nTherefore, the correct answer is $det(A)=4$; “The transformation is invertible” only."} {:db/id #edb/ref 17592186259621 :knowledge-point/_questions [{:db/id #edb/ref 17592186179770 :knowledge-point/id #uuid "e39ae7fc-ff0a-5b97-8e13-1f15b12a07e5" :knowledge-point/title "Identifying Invertible Affine Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1daaab98-cbe8-5352-bacb-b5473639f7d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448134} {:answer/id #uuid "61d8fcde-639e-51e8-ad9a-369bc099832e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448135}] :answer-field/correct {:answer/id #uuid "61d8fcde-639e-51e8-ad9a-369bc099832e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448135} :answer-field/id #uuid "e8bf1e46-3b2c-510e-8fc9-4a0cac9760b0" :answer-field/key "$A=\\begin{bmatrix}8 & -6 \\\\ 4 & -3\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449107} {:answer-field/choices [{:answer/id #uuid "441c54c9-8ecc-5a18-9ccb-3f4010752b83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448136} {:answer/id #uuid "6a4e6a4b-8eb3-565f-a9a9-d81923448b30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448137}] :answer-field/correct {:answer/id #uuid "441c54c9-8ecc-5a18-9ccb-3f4010752b83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448136} :answer-field/id #uuid "3cf33e0a-cba5-5662-8a21-99a57c476012" :answer-field/key "$det(A)=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449108} {:answer-field/choices [{:answer/id #uuid "eb140b7e-c87d-5f72-9d09-3e36fca1601a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448138} {:answer/id #uuid "e8389ee7-d6c3-5f91-8889-ed2eee89b8a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448139}] :answer-field/correct {:answer/id #uuid "eb140b7e-c87d-5f72-9d09-3e36fca1601a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448138} :answer-field/id #uuid "eb21737e-2666-5ebe-87e7-f10521798b5a" :answer-field/key "The transformation is invertible" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449109}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "67b5699e-cde1-5170-92cc-4d8a2c62f657" :question/math-academy-id "q-124215" :question/problem "Consider the affine transformation $T$ defined as\n\n$$\nx=8u-6v+2,\\,y=4u-3v-1.\n$$\n\nSuppose that $A$ is the matrix that represents the linear transformation associated with $T.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nLet's look at each statement in turn:\n\n- Statement $A=\\begin{bmatrix}8 & -6 \\\\ 4 & -3\\end{bmatrix}$ is true. The given transformation can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}8u-6v+2 \\\\ 4u-3v-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}8u-6v \\\\ 4u-3v\\end{bmatrix}+\\begin{bmatrix}2 \\\\ -1\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}8 & -6 \\\\ 4 & -3\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\nA=\\begin{bmatrix}8 & -6 \\\\ 4 & -3\\end{bmatrix}.\n$$\n\n- Statement $det(A)=1$ is false. Computing the determinant of $A,$ we get\n\n$$\ndet(A)=\\begin{vmatrix}8 & -6 \\\\ 4 & -3\\end{vmatrix}=(-3)\\cdot 8-(-6)\\cdot 4=0.\n$$\n\n- Statement “The transformation is invertible” is false. Since $det(A)=0,$ the affine transformation is *not* invertible.\n\nTherefore, the correct answer is $A=\\begin{bmatrix}8 & -6 \\\\ 4 & -3\\end{bmatrix}$ only."} {:db/id #edb/ref 17592186259623 :knowledge-point/_questions [{:db/id #edb/ref 17592186179770 :knowledge-point/id #uuid "e39ae7fc-ff0a-5b97-8e13-1f15b12a07e5" :knowledge-point/title "Identifying Invertible Affine Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d8644aa-30c8-5f84-95f8-591ae101f520" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448140} {:answer/id #uuid "7d56c5c8-75e5-5ea5-96ad-cda45dad43a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448141}] :answer-field/correct {:answer/id #uuid "8d8644aa-30c8-5f84-95f8-591ae101f520" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448140} :answer-field/id #uuid "2e36209e-566c-514f-b7e4-aaee36041867" :answer-field/key "$A=\\begin{bmatrix}4 & -5 \\\\ 2 & 6\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449110} {:answer-field/choices [{:answer/id #uuid "ea2f9e42-7bf6-5f40-9368-3dda1b852ea2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448142} {:answer/id #uuid "73d58032-ea3b-55f4-8461-e52c44559040" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448143}] :answer-field/correct {:answer/id #uuid "73d58032-ea3b-55f4-8461-e52c44559040" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448143} :answer-field/id #uuid "29e9de89-bea2-5bee-8fc7-7e275041411e" :answer-field/key "$det(A)=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449111} {:answer-field/choices [{:answer/id #uuid "c502c020-a561-562e-9709-4015d249e451" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448144} {:answer/id #uuid "e3628c3d-6abc-5c9d-9e38-4a53a7f3c693" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448145}] :answer-field/correct {:answer/id #uuid "c502c020-a561-562e-9709-4015d249e451" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448144} :answer-field/id #uuid "c90de5ac-5ad0-5d21-bc0b-30dee157da82" :answer-field/key "The transformation is invertible" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449112}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d8f35619-da30-55db-920a-269c9cc6d2af" :question/math-academy-id "q-124219" :question/problem "Consider the affine transformation $T$ defined as\n\n$$\nx=4u+2v-5,\\,y=2u+v+6.\n$$\n\nSuppose that $A$ is the matrix that represents the linear transformation associated with $T.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nLet's look at each statement in turn:\n\n- Statement $A=\\begin{bmatrix}4 & -5 \\\\ 2 & 6\\end{bmatrix}$ is false. The given transformation can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}4u+2v-5 \\\\ 2u+v+6\\end{bmatrix} \\\\  & =\\begin{bmatrix}4u+2v \\\\ 2u+v\\end{bmatrix}+\\begin{bmatrix}-5 \\\\ 6\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}4 & 2 \\\\ 2 & 1\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}-5 \\\\ 6\\end{bmatrix}}_{b}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\nA=\\begin{bmatrix}4 & 2 \\\\ 2 & 1\\end{bmatrix}\\ne \\begin{bmatrix}4 & -5 \\\\ 2 & 6\\end{bmatrix}.\n$$\n\n- Statement $det(A)=0$ is true. Computing the determinant of $A,$ we get\n\n$$\ndet(A)=\\begin{vmatrix}4 & 2 \\\\ 2 & 1\\end{vmatrix}=1\\cdot 4-2\\cdot 2=0.\n$$\n\n- Statement “The transformation is invertible” is false. Since $det(A)=0,$ the affine transformation is *not* invertible.\n\nTherefore, the correct answer is $det(A)=0$ only."} {:db/id #edb/ref 17592186259662 :knowledge-point/_questions [{:db/id #edb/ref 17592186179769 :knowledge-point/id #uuid "36996ffc-7dbc-51f8-8efe-46ed2c897045" :knowledge-point/title "Determining Whether an Affine Transformation is Orientation-Preserving"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "346453bf-6ec7-5274-8c95-e05b921f9ffe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448146} {:answer/id #uuid "c8150770-d90b-59c6-8743-a1aaac54ae0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448147}] :answer-field/correct {:answer/id #uuid "c8150770-d90b-59c6-8743-a1aaac54ae0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448147} :answer-field/id #uuid "e7d34579-5dd5-574b-800f-09b6aea0ce21" :answer-field/key "$A=\\begin{bmatrix}-1 & 2 \\\\ 2 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449113} {:answer-field/choices [{:answer/id #uuid "d342b8a4-a9fa-5ec4-a6eb-6a136ee7f657" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448148} {:answer/id #uuid "abd09e98-ea9a-5dce-b9eb-228e0b717cd4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448149}] :answer-field/correct {:answer/id #uuid "abd09e98-ea9a-5dce-b9eb-228e0b717cd4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448149} :answer-field/id #uuid "3896a921-2ec9-5c62-ba95-289f7ebf249f" :answer-field/key "$det(A)=-5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449114} {:answer-field/choices [{:answer/id #uuid "02c44eed-233d-5ab9-b232-1f55f5c23ff4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448150} {:answer/id #uuid "f7de793d-0b93-5446-940d-cf97fc0a91ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448151}] :answer-field/correct {:answer/id #uuid "02c44eed-233d-5ab9-b232-1f55f5c23ff4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448150} :answer-field/id #uuid "9cec0683-efdd-5dfb-a194-1aced1608d2e" :answer-field/key "The transformation $T$ is orientation-preserving" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449115}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d6b75fa0-1178-5417-bc31-861bbdef5229" :question/math-academy-id "q-124321" :question/problem "Consider the affine transformation $T$ defined as\n\n$$\nx=2v-u+2,\\,y=2u+v-5.\n$$\n\nLet $A$ be the matrix representation of the linear transformation associated with $T.$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nLet's look at each statement in turn:\n\n- Statement $A=\\begin{bmatrix}-1 & 2 \\\\ 2 & 1\\end{bmatrix}$ is true. Indeed, notice that the given transformation can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}2v-u+2 \\\\ 2u+v-5\\end{bmatrix} \\\\  & =\\begin{bmatrix}-u+2v \\\\ 2u+v\\end{bmatrix}+\\begin{bmatrix}2 \\\\ -5\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}-1 & 2 \\\\ 2 & 1\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}2 \\\\ -5\\end{bmatrix}}_{b}\\end{aligned}\n$$\n\nTherefore, the matrix representation of the linear transformation associated with $T$ is $A=\\begin{bmatrix}-1 & 2 \\\\ 2 & 1\\end{bmatrix}.$\n\n- Statement $det(A)=-5$ is true. Indeed, computing the determinant of $A,$ we get\n\n$$\ndet(A)=\\begin{vmatrix}-1 & 2 \\\\ 2 & 1\\end{vmatrix}=(-1)\\cdot 1-2\\cdot 2=-5.\n$$\n\n- Statement “The transformation $T$ is orientation-preserving” is false. Since $det(A)<0,$ the affine transformation $T$ is not orientation-preserving.\n\nTherefore, the correct answer is $A=\\begin{bmatrix}-1 & 2 \\\\ 2 & 1\\end{bmatrix}$; $det(A)=-5$ only."} {:db/id #edb/ref 17592186259663 :knowledge-point/_questions [{:db/id #edb/ref 17592186179769 :knowledge-point/id #uuid "36996ffc-7dbc-51f8-8efe-46ed2c897045" :knowledge-point/title "Determining Whether an Affine Transformation is Orientation-Preserving"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1276ca3f-0817-57d0-81fc-4cf3b2b8c257" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448152} {:answer/id #uuid "743f6540-a3a1-5ce5-96a0-66ce9f284993" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448153}] :answer-field/correct {:answer/id #uuid "743f6540-a3a1-5ce5-96a0-66ce9f284993" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448153} :answer-field/id #uuid "e00b185e-48ee-59bd-8245-84a19a005d69" :answer-field/key "$A=\\begin{bmatrix}1 & 3 \\\\ 1 & 2\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449116} {:answer-field/choices [{:answer/id #uuid "0bef7659-decf-5b82-a6f5-3aa7e1134ac2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448154} {:answer/id #uuid "e16c8594-f347-5ced-a1db-0cbf8d2cab8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448155}] :answer-field/correct {:answer/id #uuid "0bef7659-decf-5b82-a6f5-3aa7e1134ac2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448154} :answer-field/id #uuid "5b28f605-aebe-5cbd-9d68-1760caa655fb" :answer-field/key "$det(A)=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449117} {:answer-field/choices [{:answer/id #uuid "c41386b4-b3e8-58e2-8d35-a3b72f57dc4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448156} {:answer/id #uuid "15e896ce-491a-591b-b5ca-d06c641aa278" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448157}] :answer-field/correct {:answer/id #uuid "c41386b4-b3e8-58e2-8d35-a3b72f57dc4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448156} :answer-field/id #uuid "3bd8e212-89b2-5734-8a82-96a437a9526f" :answer-field/key "The transformation $T$ is orientation-preserving" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449118}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8bc55bfe-e692-5546-9ff3-60dd10f588d6" :question/math-academy-id "q-124322" :question/problem "Consider the affine transformation $T$ defined as\n\n$$\nx=u+3v-5,\\,y=2v+u-4.\n$$\n\nLet $A$ be the matrix representation of the linear transformation associated with $T.$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nLet's look at each statement in turn:\n\n- Statement $A=\\begin{bmatrix}1 & 3 \\\\ 1 & 2\\end{bmatrix}$ is true. Indeed, notice that the given transformation can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}u+3v-5 \\\\ 2v+u-4\\end{bmatrix} \\\\  & =\\begin{bmatrix}u+3v \\\\ u+2v\\end{bmatrix}+\\begin{bmatrix}-5 \\\\ -4\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}1 & 3 \\\\ 1 & 2\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}-5 \\\\ -4\\end{bmatrix}}_{b}\\end{aligned}\n$$\n\nTherefore, the matrix representation of the linear transformation associated with $T$ is $A=\\begin{bmatrix}1 & 3 \\\\ 1 & 2\\end{bmatrix}.$\n\n- Statement $det(A)=1$ is false. Computing the determinant of $A,$ we get\n\n$$\ndet(A)=\\begin{vmatrix}1 & 3 \\\\ 1 & 2\\end{vmatrix}=1\\cdot 2-1\\cdot 3=-1.\n$$\n\n- Statement “The transformation $T$ is orientation-preserving” is false. Since $det(A)<0,$ the affine transformation $T$ is not orientation-preserving.\n\nTherefore, the correct answer is $A=\\begin{bmatrix}1 & 3 \\\\ 1 & 2\\end{bmatrix}$ only."} {:db/id #edb/ref 17592186259664 :knowledge-point/_questions [{:db/id #edb/ref 17592186179769 :knowledge-point/id #uuid "36996ffc-7dbc-51f8-8efe-46ed2c897045" :knowledge-point/title "Determining Whether an Affine Transformation is Orientation-Preserving"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b403f00-fca0-57ea-8284-891bf3566a31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448158} {:answer/id #uuid "843732ab-6614-502e-a8d6-137dd6b219b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448159}] :answer-field/correct {:answer/id #uuid "5b403f00-fca0-57ea-8284-891bf3566a31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448158} :answer-field/id #uuid "1800fb93-626f-555b-8257-53399e2b3330" :answer-field/key "$A=\\begin{bmatrix}4 & -2 \\\\ -3 & 2\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449119} {:answer-field/choices [{:answer/id #uuid "d03837d5-08d1-515b-abb3-46fa51e14d5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448160} {:answer/id #uuid "5db7ee30-ef80-5d31-b01c-bfcff70810a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448161}] :answer-field/correct {:answer/id #uuid "5db7ee30-ef80-5d31-b01c-bfcff70810a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448161} :answer-field/id #uuid "fec20ecf-0d1a-5d88-aabc-f6faea141357" :answer-field/key "$det(A)=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449120} {:answer-field/choices [{:answer/id #uuid "b74f99e4-3864-593f-90c0-b004a433a43e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448162} {:answer/id #uuid "7a942f96-ec40-5932-89f9-9e68f8f4c5d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448163}] :answer-field/correct {:answer/id #uuid "7a942f96-ec40-5932-89f9-9e68f8f4c5d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448163} :answer-field/id #uuid "398228c4-51eb-52d2-b0e8-75a3a41432b0" :answer-field/key "The transformation $T$ is orientation-preserving" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449121}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0642bf2f-73a7-542a-b570-be0c81694e35" :question/math-academy-id "q-124324" :question/problem "Consider the affine transformation $T$ defined as\n\n$$\nx=4u-3v-5,\\,y=-2u+2v+4.\n$$\n\nLet $A$ be the matrix representation of the linear transformation associated with $T.$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nLet's look at each statement in turn:\n\n- Statement $A=\\begin{bmatrix}4 & -2 \\\\ -3 & 2\\end{bmatrix}$ is false. Notice that the given transformation can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}4u-3v-5 \\\\ -2u+2v+4\\end{bmatrix} \\\\  & =\\begin{bmatrix}4u-3v \\\\ -2u+2v\\end{bmatrix}+\\begin{bmatrix}-5 \\\\ 4\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}4 & -3 \\\\ -2 & 2\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}-5 \\\\ 4\\end{bmatrix}}_{b}\\end{aligned}\n$$\n\nTherefore, the matrix representation of the linear transformation associated with $T$ is $A=\\begin{bmatrix}4 & -3 \\\\ -2 & 2\\end{bmatrix}.$\n\n- Statement $det(A)=2$ is true. Computing the determinant of $A,$ we get\n\n$$\ndet(A)=\\begin{vmatrix}4 & -3 \\\\ -2 & 2\\end{vmatrix}=4\\cdot 2-(-3)\\cdot (-2)=2.\n$$\n\n- Statement “The transformation $T$ is orientation-preserving” is true. Indeed, since $det(A)>0,$ the affine transformation $T$ is orientation-preserving.\n\nTherefore, the correct answer is $det(A)=2$; “The transformation $T$ is orientation-preserving” only."} {:db/id #edb/ref 17592186259666 :knowledge-point/_questions [{:db/id #edb/ref 17592186179769 :knowledge-point/id #uuid "36996ffc-7dbc-51f8-8efe-46ed2c897045" :knowledge-point/title "Determining Whether an Affine Transformation is Orientation-Preserving"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00b72bc2-de18-5a31-bfdf-fdac912549a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448164} {:answer/id #uuid "d3e96f5b-82de-5376-876d-7a84ae9bf74c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448165}] :answer-field/correct {:answer/id #uuid "d3e96f5b-82de-5376-876d-7a84ae9bf74c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448165} :answer-field/id #uuid "4e27ccb4-b5c0-5a9a-8d03-5e3c15a85d08" :answer-field/key "$A=\\begin{bmatrix}1 & 0 \\\\ 1 & -1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449122} {:answer-field/choices [{:answer/id #uuid "c25dc899-6e5e-5d48-a151-181957ec1b75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448166} {:answer/id #uuid "89240879-1b78-5c81-9622-9647e99c0713" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448167}] :answer-field/correct {:answer/id #uuid "89240879-1b78-5c81-9622-9647e99c0713" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448167} :answer-field/id #uuid "c5172e33-9775-5938-831d-f44ab65c3dcd" :answer-field/key "$det(A)=-1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449123} {:answer-field/choices [{:answer/id #uuid "c7080029-1010-516b-b69b-6dabb70fcd57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448168} {:answer/id #uuid "d634558c-1872-5b5c-9aff-88f13ebecb7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448169}] :answer-field/correct {:answer/id #uuid "c7080029-1010-516b-b69b-6dabb70fcd57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448168} :answer-field/id #uuid "6fe4987e-3c97-588e-81f0-536e77edb94f" :answer-field/key "The transformation $T$ is orientation-preserving" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449124}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5e2308b7-d41e-52ef-9ac3-a8e7e1231e38" :question/math-academy-id "q-124326" :question/problem "Consider the affine transformation $T$ defined as\n\n$$\nx=u-1,\\,y=u-v-2.\n$$\n\nLet $A$ be the matrix representation of the linear transformation associated with $T.$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nLet's look at each statement in turn:\n\n- Statement $A=\\begin{bmatrix}1 & 0 \\\\ 1 & -1\\end{bmatrix}$ is true. Indeed, notice that the given transformation can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}u-1 \\\\ u-v-2\\end{bmatrix} \\\\  & =\\begin{bmatrix}u \\\\ u-v\\end{bmatrix}+\\begin{bmatrix}-1 \\\\ -2\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}1 & 0 \\\\ 1 & -1\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}-1 \\\\ -2\\end{bmatrix}}_{b}\\end{aligned}\n$$\n\nTherefore, the matrix representation of the linear transformation associated with $T$ is $A=\\begin{bmatrix}1 & 0 \\\\ 1 & -1\\end{bmatrix}.$\n\n- Statement $det(A)=-1$ is true. Indeed, computing the determinant of $A,$ we get\n\n$$\ndet(A)=\\begin{vmatrix}1 & 0 \\\\ 1 & -1\\end{vmatrix}=1\\cdot (-1)-1\\cdot 0=-1.\n$$\n\n- Statement “The transformation $T$ is orientation-preserving” is false. Since $det(A)<0,$ the affine transformation $T$ is not orientation-preserving.\n\nTherefore, the correct answer is $A=\\begin{bmatrix}1 & 0 \\\\ 1 & -1\\end{bmatrix}$; $det(A)=-1$ only."} {:db/id #edb/ref 17592186259667 :knowledge-point/_questions [{:db/id #edb/ref 17592186179769 :knowledge-point/id #uuid "36996ffc-7dbc-51f8-8efe-46ed2c897045" :knowledge-point/title "Determining Whether an Affine Transformation is Orientation-Preserving"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f764cc6-1478-5e54-bd9c-3364a17fabe1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448170} {:answer/id #uuid "d7dd388d-1564-519e-9981-ab76abed4493" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448171}] :answer-field/correct {:answer/id #uuid "3f764cc6-1478-5e54-bd9c-3364a17fabe1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448170} :answer-field/id #uuid "c6b0a775-4d3d-5357-9449-e188e9662c7f" :answer-field/key "$A=\\begin{bmatrix}2 & 1 \\\\ -1 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449125} {:answer-field/choices [{:answer/id #uuid "061c1e82-b637-54b1-8c70-6b454f04e2da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448172} {:answer/id #uuid "6421248e-a238-52bf-810c-ffb6d4c763b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448173}] :answer-field/correct {:answer/id #uuid "6421248e-a238-52bf-810c-ffb6d4c763b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448173} :answer-field/id #uuid "115bb24b-f8bd-5a8f-8b4b-b0b7136582a6" :answer-field/key "$det(A)=-7$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449126} {:answer-field/choices [{:answer/id #uuid "9714ba44-1e2d-5473-a243-1b09bbe1be18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448174} {:answer/id #uuid "57ff4b59-8350-5857-8238-35585eb2ad54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448175}] :answer-field/correct {:answer/id #uuid "9714ba44-1e2d-5473-a243-1b09bbe1be18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448174} :answer-field/id #uuid "2da6067f-c334-515f-9b43-3cc92f6a6399" :answer-field/key "The transformation $T$ is orientation-preserving" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449127}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2083542b-ea7a-58bb-b614-773ec287a63e" :question/math-academy-id "q-124327" :question/problem "Consider the affine transformation $T$ defined as\n\n$$\nx=v-2u,\\,y=u+3v-1.\n$$\n\nLet $A$ be the matrix representation of the linear transformation associated with $T.$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nLet's look at each statement in turn:\n\n- Statement $A=\\begin{bmatrix}2 & 1 \\\\ -1 & 1\\end{bmatrix}$ is false. Notice that the given transformation can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}v-2u \\\\ u+3v-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2u+v \\\\ u+3v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ -1\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}-2 & 1 \\\\ 1 & 3\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}}_{b}\\end{aligned}\n$$\n\nTherefore, the matrix representation of the linear transformation associated with $T$ is $A=\\begin{bmatrix}-2 & 1 \\\\ 1 & 3\\end{bmatrix}.$\n\n- Statement $det(A)=-7$ is true. Computing the determinant of $A,$ we get\n\n$$\ndet(A)=\\begin{vmatrix}-2 & 1 \\\\ 1 & 3\\end{vmatrix}=(-2)\\cdot 3-1\\cdot 1=-7.\n$$\n\n- Statement “The transformation $T$ is orientation-preserving” is false. Since $det(A)<0,$ the affine transformation $T$ is not orientation-preserving.\n\nTherefore, the correct answer is $det(A)=-7$ only."} {:db/id #edb/ref 17592186259668 :knowledge-point/_questions [{:db/id #edb/ref 17592186179769 :knowledge-point/id #uuid "36996ffc-7dbc-51f8-8efe-46ed2c897045" :knowledge-point/title "Determining Whether an Affine Transformation is Orientation-Preserving"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "408d4376-fee3-576b-b919-78a362304433" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448176} {:answer/id #uuid "8fd32334-9fe7-58f0-b69d-c5e4b56cf483" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448177}] :answer-field/correct {:answer/id #uuid "408d4376-fee3-576b-b919-78a362304433" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448176} :answer-field/id #uuid "8ddf5a2c-e1ba-5ab8-a326-ef2effad6657" :answer-field/key "$A=\\begin{bmatrix}-2 & 1 \\\\ 4 & -1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449128} {:answer-field/choices [{:answer/id #uuid "267cd5a9-bfac-5eed-8904-017678ad4a9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448178} {:answer/id #uuid "53ccc33d-0646-52ce-a1eb-2f220bd004a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448179}] :answer-field/correct {:answer/id #uuid "267cd5a9-bfac-5eed-8904-017678ad4a9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448178} :answer-field/id #uuid "dfeb4901-6e2a-51fc-97ac-18cfb802789c" :answer-field/key "$det(A)=-4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449129} {:answer-field/choices [{:answer/id #uuid "8ce0c3e5-0bb1-5908-8e46-fb31e5b247a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448180} {:answer/id #uuid "a9d541bc-f6ed-52ec-bf3f-39047b585869" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448181}] :answer-field/correct {:answer/id #uuid "a9d541bc-f6ed-52ec-bf3f-39047b585869" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448181} :answer-field/id #uuid "de788145-c4bf-5fa3-888f-761cc5fd7fae" :answer-field/key "The transformation $T$ is orientation-preserving" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449130}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "76a65107-91d8-5259-9f73-6e2fee8f6ae9" :question/math-academy-id "q-124330" :question/problem "Consider the affine transformation $T$ defined as\n\n$$\nx=-2v+1,\\,y=4u-v-5.\n$$\n\nLet $A$ be the matrix representation of the linear transformation associated with $T.$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nLet's look at each statement in turn:\n\n- Statement $A=\\begin{bmatrix}-2 & 1 \\\\ 4 & -1\\end{bmatrix}$ is false. Notice that the given transformation can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}-2v+1 \\\\ 4u-v-5\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2v \\\\ 4u-v\\end{bmatrix}+\\begin{bmatrix}1 \\\\ -5\\end{bmatrix} \\\\  & =\\underbrace{\\begin{bmatrix}0 & -2 \\\\ 4 & -1\\end{bmatrix}}_{A}\\cdot \\underbrace{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{u}+\\underbrace{\\begin{bmatrix}1 \\\\ -5\\end{bmatrix}}_{b}\\end{aligned}\n$$\n\nTherefore, the matrix representation of the linear transformation associated with $T$ is $A=\\begin{bmatrix}0 & -2 \\\\ 4 & -1\\end{bmatrix}.$\n\n- Statement $det(A)=-4$ is false. Computing the determinant of $A,$ we get\n\n$$\ndet(A)=\\begin{vmatrix}0 & -2 \\\\ 4 & -1\\end{vmatrix}=0\\cdot (-1)-4\\cdot (-2)=8.\n$$\n\n- Statement “The transformation $T$ is orientation-preserving” is true. Indeed, since $det(A)>0,$ the affine transformation $T$ is orientation-preserving.\n\nTherefore, the correct answer is “The transformation $T$ is orientation-preserving” only."} {:db/id #edb/ref 17592186259730 :knowledge-point/_questions [{:db/id #edb/ref 17592186172091 :knowledge-point/id #uuid "280e7ba4-7617-546b-9e0d-a5bdc33dad8d" :knowledge-point/title "Identifying Simply-Connected Regions in Euclidian Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ecde6e98-53fd-5ddd-bdc1-6ff205d00d83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462139} {:answer/id #uuid "f49d1e0e-f360-53d6-9140-755bc53425ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462140}] :answer-field/correct {:answer/id #uuid "f49d1e0e-f360-53d6-9140-755bc53425ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462140} :answer-field/id #uuid "a82752cf-bf54-5079-8c9f-a8fa8464cd75" :answer-field/key "${(x,y)\\in {R}^{2}\\,|\\,y-x\\ge 0}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462823} {:answer-field/choices [{:answer/id #uuid "17fa137d-526a-57e9-8c8d-806b8a6e7139" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462141} {:answer/id #uuid "482d1113-1761-5039-8696-fb7a9c674eea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462142}] :answer-field/correct {:answer/id #uuid "17fa137d-526a-57e9-8c8d-806b8a6e7139" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462141} :answer-field/id #uuid "62c5e294-13bc-5717-9f9c-3fef7f5d4399" :answer-field/key "${(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}>1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462824} {:answer-field/choices [{:answer/id #uuid "e6953b99-2176-55bb-9f0e-69ab32d7d93e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462143} {:answer/id #uuid "b13b7134-2fe3-59e1-90c8-cc035011e284" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462144}] :answer-field/correct {:answer/id #uuid "e6953b99-2176-55bb-9f0e-69ab32d7d93e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462143} :answer-field/id #uuid "2df54704-5657-56ec-913b-dbeb0cf13cfe" :answer-field/key "${(x,y)\\in {R}^{2}\\,|\\,y+x\\ne 0}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462825}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "387d1688-e72e-5fdc-bd02-55d9c19c099b" :question/math-academy-id "q-124775" :question/problem "Which of the following regions are simply connected?\n\nSelect all that apply." :question/worked-solution "A connected region $D$ is simply connected if every simple closed curve in $D$ can be contracted to a point.\n\n![](images/7d/7d6aea1a62fb290702630ef95ec86f4119e7c8fdd74b8148b62b66e5ac871b58.png)\n\nA connected *plane* region $D$ is simply connected if every simple closed curve in $D$ encloses only points in $D.$ In other words, the region does not contain any holes. Plane regions containing holes are not simply connected, since some simple closed curves cannot be contracted to a point:\n\n![](images/c3/c3c3e7a60ff0dd917cf6c0b293dae7510e457a0455629add1c54cadac65248b7.png)\n\nLet's now examine our regions in turn.\n\n- Region ${(x,y)\\in {R}^{2}\\,|\\,y-x\\ge 0}$ is simply connected. Indeed, it is the half-plane $y\\ge x.$ So,   it's a plane region without holes,\n\n- Region ${(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}>1}$ is *not* simply connected since it's a plane region with a hole (containing all points of the circle ${x}^{2}+{y}^{2}\\le 1$).\n\n- Region ${(x,y)\\in {R}^{2}\\,|\\,y+x\\ne 0}$ is *not* simply connected. The region contains all the points of ${R}^{2}$ except those on the straight line $y=-x.$ Thus, the region is formed by two disjoint half-planes and, therefore, is not even a connected region.\n\nTherefore, the correct answer is ${(x,y)\\in {R}^{2}\\,|\\,y-x\\ge 0}$ only."} {:db/id #edb/ref 17592186259731 :knowledge-point/_questions [{:db/id #edb/ref 17592186172091 :knowledge-point/id #uuid "280e7ba4-7617-546b-9e0d-a5bdc33dad8d" :knowledge-point/title "Identifying Simply-Connected Regions in Euclidian Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18243450-8bc5-5ba5-92ae-2a12b967b1f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462145} {:answer/id #uuid "53526394-7618-5253-b8b8-39da508afb42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462146}] :answer-field/correct {:answer/id #uuid "18243450-8bc5-5ba5-92ae-2a12b967b1f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462145} :answer-field/id #uuid "701895d0-d3f5-5fd1-99cc-2ef0e7db9adb" :answer-field/key "${(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}\\ne 4}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462826} {:answer-field/choices [{:answer/id #uuid "bb1353f6-b0c0-5194-a209-45cfa89e9762" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462147} {:answer/id #uuid "67103826-f812-5a9c-a5d1-e93ca05c2123" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462148}] :answer-field/correct {:answer/id #uuid "67103826-f812-5a9c-a5d1-e93ca05c2123" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462148} :answer-field/id #uuid "c24c9f12-a9c4-502d-a521-d96ff0a52d43" :answer-field/key "${(x,y)\\in {R}^{2}\\,|\\,x\\ge 1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462827} {:answer-field/choices [{:answer/id #uuid "973fe3d8-28f4-5ce5-afa3-e107736244b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462149} {:answer/id #uuid "2f92d4a6-c6ba-5890-bc7a-b9c3b83bf58f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462150}] :answer-field/correct {:answer/id #uuid "973fe3d8-28f4-5ce5-afa3-e107736244b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462149} :answer-field/id #uuid "6b065414-05f8-5b5f-b809-0e2f2975f5ea" :answer-field/key "${(x,y)\\in {R}^{2}\\,|\\,xy\\ne 0}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462828}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bd4c2e21-ea3a-5149-9740-8c2a599beff2" :question/math-academy-id "q-124782" :question/problem "Which of the following regions are simply connected?\n\nSelect all that apply." :question/worked-solution "A connected region $D$ is simply connected if every simple closed curve in $D$ can be contracted to a point.\n\n![](images/7d/7d6aea1a62fb290702630ef95ec86f4119e7c8fdd74b8148b62b66e5ac871b58.png)\n\nA connected *plane* region $D$ is simply connected if every simple closed curve in $D$ encloses only points in $D.$ In other words, the region does not contain any holes. Plane regions containing holes are not simply connected, since some simple closed curves cannot be contracted to a point:\n\n![](images/c3/c3c3e7a60ff0dd917cf6c0b293dae7510e457a0455629add1c54cadac65248b7.png)\n\nLet's now examine our regions in turn.\n\n- Region ${(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}\\ne 4}$ is *not* simply connected. The region contains all the points of ${R}^{2}$ except those on the ellipse ${x}^{2}+{y}^{2}=4.$ Thus, the region is formed by two disjoint pieces and, therefore, is not even a connected region.\n\n- Region ${(x,y)\\in {R}^{2}\\,|\\,x\\ge 1}$  is simply connected. It's a plane region without holes.\n\n- Region ${(x,y)\\in {R}^{2}\\,|\\,xy\\ne 0}$ is *not* simply connected.  The region contains all the points of ${R}^{2}$ except those on the coordinate axes.  Thus, the region is formed by four disjoint pieces and, therefore, is not even a connected region.\n\nTherefore, the correct answer is ${(x,y)\\in {R}^{2}\\,|\\,x\\ge 1}$ only."} {:db/id #edb/ref 17592186259752 :knowledge-point/_questions [{:db/id #edb/ref 17592186078493 :knowledge-point/id #uuid "62736299-f6d6-503f-a5d1-e1091e8b0429" :knowledge-point/title "Identifying Convergent Geometric Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2b34516-3ea8-584f-906e-e8611ac12828" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462151} {:answer/id #uuid "291a43ca-613d-5a0d-9ab8-0303748e2957" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462152}] :answer-field/correct {:answer/id #uuid "c2b34516-3ea8-584f-906e-e8611ac12828" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462151} :answer-field/id #uuid "c25edcf3-d687-539e-bcd5-23dfed8b3afb" :answer-field/key "${\\sum }_{n=0}^{\\infty }0.25{(1.1)}^{n}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462829} {:answer-field/choices [{:answer/id #uuid "f07d465a-cb07-59a2-ba0c-6485c2e2203c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462153} {:answer/id #uuid "ebb4f3ab-0ab6-5c87-9b0a-255c44be23cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462154}] :answer-field/correct {:answer/id #uuid "f07d465a-cb07-59a2-ba0c-6485c2e2203c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462153} :answer-field/id #uuid "90d4580d-2f8a-562a-9bab-ac4b9c80c2c2" :answer-field/key "${\\sum }_{n=1}^{\\infty }\\frac{1}{4}{(-\\frac{5}{2})}^{n}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462830} {:answer-field/choices [{:answer/id #uuid "07ee1f91-30b1-5897-9518-97a3b6a06b2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462155} {:answer/id #uuid "9f36d431-b912-544f-a3f7-12ba6a12bb2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462156}] :answer-field/correct {:answer/id #uuid "07ee1f91-30b1-5897-9518-97a3b6a06b2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462155} :answer-field/id #uuid "6645ce3c-ff42-5463-89e7-d2920082b362" :answer-field/key "${\\sum }_{n=2}^{\\infty }\\frac{{3}^{n-1}}{{2}^{n}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462831}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6ce3cd55-5416-540d-b4b8-b6e9967829be" :question/math-academy-id "q-124906" :question/problem "Which of the following geometric series converge?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Let's look at each series in turn.\n\n- The series ${\\sum }_{n=0}^{\\infty }0.25{(1.1)}^{n}$ starts with $n=0.$ So the common ratio is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{1}}{{a}_{0}} & =\\frac{0.25{(1.1)}^{1}}{0.25{(1.1)}^{0}} \\\\  & =1.1\\end{aligned}\n$$\n\nTherefore, the series is divergent because $|r|\\ge 1.$\n\n- The series ${\\sum }_{n=1}^{\\infty }\\frac{1}{4}{\\left(-\\frac{5}{2}\\right)}^{n}$ starts with $n=1.$ So the common ratio is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{2}}{{a}_{1}} & =\\frac{\\frac{1}{4}{\\left(-\\frac{5}{2}\\right)}^{2}}{\\frac{1}{4}{\\left(-\\frac{5}{2}\\right)}^{1}} \\\\  & =-\\frac{5}{2}.\\end{aligned}\n$$\n\nTherefore, the series is divergent because $|r|\\ge 1.$\n\n- The series ${\\sum }_{n=2}^{\\infty }\\frac{{3}^{n-1}}{{2}^{n}}$ starts with $n=2.$ So the common ratio is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{3}}{{a}_{2}} & =\\frac{\\left(\\frac{{3}^{3-1}}{{2}^{3}}\\right)}{\\left(\\frac{{3}^{2-1}}{{2}^{2}}\\right)} \\\\  & =\\frac{\\left(\\frac{{3}^{2}}{{2}^{3}}\\right)}{\\left(\\frac{3}{{2}^{2}}\\right)} \\\\  & =\\left(\\frac{{3}^{2}}{{2}^{3}}\\right)\\left(\\frac{{2}^{2}}{3}\\right) \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$\n\nTherefore, the series is divergent because $|r|\\ge 1.$\n\nIn conclusion, the correct answer is \"None.\""} {:db/id #edb/ref 17592186259753 :knowledge-point/_questions [{:db/id #edb/ref 17592186078493 :knowledge-point/id #uuid "62736299-f6d6-503f-a5d1-e1091e8b0429" :knowledge-point/title "Identifying Convergent Geometric Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fad3c269-bef4-5865-aab8-6a0b35ec71d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462157} {:answer/id #uuid "98f93dc7-fe53-5026-b0cd-64e62c2fe4da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462158}] :answer-field/correct {:answer/id #uuid "98f93dc7-fe53-5026-b0cd-64e62c2fe4da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462158} :answer-field/id #uuid "a4bcc406-44ad-54a6-861c-b4d287a6c9c5" :answer-field/key "$162+108+72+48+⋯$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462832} {:answer-field/choices [{:answer/id #uuid "41ce7a7b-500a-5304-8f49-f2cb53102966" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462159} {:answer/id #uuid "835a9efd-c099-5f5a-bcff-920b942ffed3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462160}] :answer-field/correct {:answer/id #uuid "835a9efd-c099-5f5a-bcff-920b942ffed3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462160} :answer-field/id #uuid "967ad5b0-4dd2-5a4e-bc8d-8387b1e60467" :answer-field/key "$1-\\frac{3}{4}+\\frac{9}{16}-\\frac{27}{64}+⋯$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462833} {:answer-field/choices [{:answer/id #uuid "851361d5-17fd-547e-b912-e443e6fd861f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462161} {:answer/id #uuid "3cb42a01-ec53-52aa-b27b-17d3dc70d8d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462162}] :answer-field/correct {:answer/id #uuid "3cb42a01-ec53-52aa-b27b-17d3dc70d8d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462162} :answer-field/id #uuid "a76e67d3-a0bb-584a-9e18-bb2f2fd0f103" :answer-field/key "$-10-9-8.1-7.29-⋯$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462834}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "893c9c3b-88dc-5138-95d4-8126574b5268" :question/math-academy-id "q-124913" :question/problem "Which of the following geometric series converge?\n\nSelect all that apply." :question/worked-solution "Let's look at each series in turn.\n\n- For the geometric series $162+108+72+48+⋯$ the common ratio is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{2}}{{a}_{1}} & =\\frac{108}{162} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$\n\nTherefore, the series is convergent because $|r|<1.$\n\n- For the geometric series $1-\\frac{3}{4}+\\frac{9}{16}-\\frac{27}{64}+⋯$ the common ratio is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{2}}{{a}_{1}} & =\\frac{\\left(-\\frac{3}{4}\\right)}{1} \\\\  & =-\\frac{3}{4}.\\end{aligned}\n$$\n\nTherefore, the series is convergent because $|r|<1.$\n\n- For the geometric series $-10-9-8.1-7.29-⋯$  the common ratio is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{2}}{{a}_{1}} & =\\frac{-9}{-10} \\\\  & =0.9\\end{aligned}\n$$\n\nTherefore, the series is convergent because $|r|<1.$\n\nIn conclusion, series $162+108+72+48+⋯$, $1-\\frac{3}{4}+\\frac{9}{16}-\\frac{27}{64}+⋯$, and $-10-9-8.1-7.29-⋯$ converge."} {:db/id #edb/ref 17592186259776 :knowledge-point/_questions [{:db/id #edb/ref 17592186105817 :knowledge-point/id #uuid "2f7256c7-afea-5c33-a859-623b0531e88c" :knowledge-point/title "Identifying Discrete Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "afd9a568-8c3a-5db1-9df7-bea0a134ca5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462163} {:answer/id #uuid "4761d927-b65a-5fe8-9e03-e8d4fbed528e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462164}] :answer-field/correct {:answer/id #uuid "afd9a568-8c3a-5db1-9df7-bea0a134ca5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462163} :answer-field/id #uuid "8c25aa8a-c2d5-5b3a-8ee2-4c94e88ab1cc" :answer-field/key "The time it takes for a student to complete math homework" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462835} {:answer-field/choices [{:answer/id #uuid "3681eeac-9e8f-559d-951e-a7e413b1c642" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462165} {:answer/id #uuid "a1349f94-fafc-5f1b-8ea5-98e220143f86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462166}] :answer-field/correct {:answer/id #uuid "a1349f94-fafc-5f1b-8ea5-98e220143f86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462166} :answer-field/id #uuid "20c3754d-055a-54bb-9366-8ad968917b20" :answer-field/key "The number of hours you spend jogging in a week" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462836} {:answer-field/choices [{:answer/id #uuid "852602ce-afd8-5ba8-a935-74f8a3c60eec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462167} {:answer/id #uuid "a6305496-817c-5b29-a238-07677383adce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462168}] :answer-field/correct {:answer/id #uuid "a6305496-817c-5b29-a238-07677383adce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462168} :answer-field/id #uuid "62efaa6d-07eb-57d3-b082-03ee657e3223" :answer-field/key "The number of candies in a jar" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462837}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "35c884a2-41d0-58e7-ba4f-0c197a382264" :question/math-academy-id "q-125075" :question/problem "Which of the following are discrete random variables?\n\nSelect all that apply." :question/worked-solution "A random variable is a variable whose value is determined by the outcome of a trial or experiment.\n\nA *discrete* random variable is a random variable\n\n- that has finitely many possible values, or\n\n- whose possible values can be listed in a sequence: ${x}_{1},{x}_{2},{x}_{3},…$\n\nRemember that a real interval (e.g. $(a,b)$ or $[a,b]$) cannot be listed in a sequence.\n\nWith that in mind, let's consider each of the given statements.\n\n- Statement “The time it takes for a student to complete math homework” does *not* describe a discrete random variable. Although its value is determined by the result of an experiment, the possible values are real numbers that cannot be listed in a sequence.\n\n- Statement “The number of hours you spend jogging in a week” describes a discrete random variable. Its value is determined by the result of an experiment, and it has finitely many possible values: $0,1,2,3,…$\n\n- Statement “The number of candies in a jar” describes a discrete random variable. Its value is determined by the result of an experiment, and it has finitely many possible values: $0,1,2,3,…$\n\nTherefore, the correct answer is “The number of hours you spend jogging in a week”; “The number of candies in a jar” only."} {:db/id #edb/ref 17592186259791 :knowledge-point/_questions [{:db/id #edb/ref 17592186064280 :knowledge-point/id #uuid "5b4b32f9-8362-5c81-a1fe-4457d91ae571" :knowledge-point/title "Identifying Functions That Satisfy the Mean Value Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "417b034a-4a1b-57ea-ae71-c3692dd9c074" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462169} {:answer/id #uuid "366f4957-2ec0-53a1-aaec-db78bf39c189" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462170}] :answer-field/correct {:answer/id #uuid "366f4957-2ec0-53a1-aaec-db78bf39c189" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462170} :answer-field/id #uuid "b33e6574-4ffa-5b8b-8bd3-5160e7158367" :answer-field/key "$f(x)={e}^{x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462838} {:answer-field/choices [{:answer/id #uuid "2848015f-fd1c-524b-9770-6641ede3f19e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462171} {:answer/id #uuid "505d7bac-6415-5832-a400-b6da7b039903" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462172}] :answer-field/correct {:answer/id #uuid "2848015f-fd1c-524b-9770-6641ede3f19e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462171} :answer-field/id #uuid "9753bc53-75e5-5715-a073-5b1b466537bd" :answer-field/key "$g(x)=\\operatorname{ln}⁡|x|$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462839} {:answer-field/choices [{:answer/id #uuid "eee75ead-b5ed-510b-a4c5-d9a5d1757af7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462173} {:answer/id #uuid "7796dc8d-ca52-55f7-aa70-af05b82e9eb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462174}] :answer-field/correct {:answer/id #uuid "7796dc8d-ca52-55f7-aa70-af05b82e9eb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462174} :answer-field/id #uuid "629cf843-1a02-5f46-991b-cdafd055537c" :answer-field/key "$h(x)=x|x|$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462840}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "79dcb2e6-ddac-560d-acd7-0aceed9cb202" :question/math-academy-id "q-125259" :question/problem "Which of the following functions satisfies the conditions of the mean value theorem over the interval $[-1,1]?$\n\nSelect all that apply." :question/worked-solution "For a function to satisfy the conditions of the mean value theorem over the interval $[-1,1],$ the function must be continuous on $[-1,1]$ and differentiable on $(-1,1).$\n\nLet's check each function individually.\n\n- The function $f(x)={e}^{x}$ is continuous and differentiable on $(-\\infty ,\\infty ).$ In particular, it  is continuous on $[-1,1]$ and differentiable on $(-1,1).$ Therefore, $f(x)$ satisfies the conditions of the mean value theorem.\n\n- The function $g(x)=\\operatorname{ln}⁡|x|$ is not defined at $x=0.$ Therefore, $g(x)$ does not satisfiy the conditions of the mean value theorem.\n\n- The function  $h(x)=x|x|$ is continuous and differentiable on $(-\\infty ,\\infty ).$ In particular, it is continuous on $[-1,1]$ and differentiable on $(-1,1).$ Therefore, $h(x)$ satisfies the conditions of the mean value theorem.\n\nTherefore, only functions $f(x)={e}^{x}$ and $h(x)=x|x|$ satisfy the conditions for the mean value theorem over the interval $[-1,1].$"} {:db/id #edb/ref 17592186259803 :knowledge-point/_questions [{:db/id #edb/ref 17592186179740 :knowledge-point/id #uuid "6f30993e-b5c7-5d8a-9b27-2aed2c9223e1" :knowledge-point/title "Determining the Sign of a Circulation From a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb212b19-0efe-5595-8a6e-e47cc9adaa5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462175} {:answer/id #uuid "3d6f84f1-683f-5d00-9604-34d4790cb9c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462176}] :answer-field/correct {:answer/id #uuid "cb212b19-0efe-5595-8a6e-e47cc9adaa5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462175} :answer-field/id #uuid "c0a39db3-475c-5e0a-801d-11e7e55a57ab" :answer-field/key "${∮}_{C}F\\cdot \\text{d}r>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462841} {:answer-field/choices [{:answer/id #uuid "8ffe3f7d-d217-5537-9b72-5552de904647" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462177} {:answer/id #uuid "0df6588a-1243-5256-a273-81f127138027" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462178}] :answer-field/correct {:answer/id #uuid "0df6588a-1243-5256-a273-81f127138027" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462178} :answer-field/id #uuid "4b8dffca-0ed9-5da1-995f-1364b3fbea05" :answer-field/key "${∮}_{C}F\\cdot \\text{d}r=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462842} {:answer-field/choices [{:answer/id #uuid "32ca2cc7-24f7-507a-9285-aa88fa019e9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462179} {:answer/id #uuid "7ea2a08c-0d10-592a-9aa9-d6c47c1f74d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462180}] :answer-field/correct {:answer/id #uuid "32ca2cc7-24f7-507a-9285-aa88fa019e9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462179} :answer-field/id #uuid "68723449-ccac-55e8-b16a-59ae779fc661" :answer-field/key "${∮}_{-C}F\\cdot \\text{d}r>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462843}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4fa44014-b4ce-590d-a5cb-5c0b5e464aaa" :question/math-academy-id "q-125392" :question/problem "![](images/dc/dca985dc352c45477dbb6ada86ad5a9cfa4404969510191a1955e59b082709fe.png)\n\nConsider the circle $S$ and vector field $F$ shown above. Let $C$ be any path where $S$ is traversed once in the counterclockwise direction. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "The circulation $Γ$ measures the total work done by a force $F$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\nΓ={∮}_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nWe now recall the following:\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${∮}_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${∮}_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statement ${∮}_{C}F\\cdot \\text{d}r>0$ is false, while statement ${∮}_{C}F\\cdot \\text{d}r=0$ is true. Since the force $F$ acts perpendicular to the motion of the particle as it moves around $C,$ it neither helps nor hinders its motion. \n\n![](images/eb/eb4da8143700c7d31e0ceacd09ac76a8d1bcb10379a34dce5b59d48f2ae58c13.png)\n\nSo, ${∮}_{C}F\\cdot \\text{d}r=0.$\n\n- Statement ${∮}_{-C}F\\cdot \\text{d}r>0$ is false. If we reverse the orientation of $C,$ then the situation with regards to the work done by $F$ remains unchanged.\n\n![](images/70/70a473397216589350f63482ab3e36cb1247e7825046c70642254c8514564b00.png)\n\nSo, ${∮}_{-C}F\\cdot \\text{d}r=0.$\n\nTherefore, the correct answer is ${∮}_{C}F\\cdot \\text{d}r=0$ only."} {:db/id #edb/ref 17592186259813 :knowledge-point/_questions [{:db/id #edb/ref 17592186179739 :knowledge-point/id #uuid "dab6bfb9-608d-5ff8-88e7-5aa9612acda4" :knowledge-point/title "Interpreting the Sign of a Line Integral Over a Constant Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a312728-759b-5a18-bc9a-7a468e2c468e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462181} {:answer/id #uuid "b006ccd8-dbf9-52a5-8de6-8656396b4437" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462182}] :answer-field/correct {:answer/id #uuid "0a312728-759b-5a18-bc9a-7a468e2c468e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462181} :answer-field/id #uuid "c09c4b26-8176-500e-9d72-7fa8141a088c" :answer-field/key "${\\int }_{C}F\\cdot \\text{d}r>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462844} {:answer-field/choices [{:answer/id #uuid "822889f3-1878-5472-943f-bc21421aa019" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462183} {:answer/id #uuid "3f2cd909-af16-5666-9ee5-08e066d042c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462184}] :answer-field/correct {:answer/id #uuid "3f2cd909-af16-5666-9ee5-08e066d042c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462184} :answer-field/id #uuid "e45bb2d9-7504-598f-8971-17193667fabf" :answer-field/key "${\\int }_{C}F\\cdot \\text{d}r<0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462845} {:answer-field/choices [{:answer/id #uuid "3c27fd31-ee21-5aab-a03c-e98f38a45ae9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462185} {:answer/id #uuid "e661237d-bcf6-5e01-b2dc-8992ab58d984" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462186}] :answer-field/correct {:answer/id #uuid "e661237d-bcf6-5e01-b2dc-8992ab58d984" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462186} :answer-field/id #uuid "ebc3f15f-2730-55a5-bdbe-6cc6317a24d4" :answer-field/key "${\\int }_{-C}F\\cdot \\text{d}r>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462846}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0a58b62d-04d0-5a47-b1b2-408fc180c352" :question/math-academy-id "q-125487" :question/problem "![](images/9d/9da7dc42ad4e9eb5b6df7c42f06d7a0f7767820693f8e99e073c7b8bd7e93441.png)\n\nConsider the vector field $F$ shown above, and let $C$ be the path along the segment $\\overset{―}{AB}$ traversed from $A$ to $B.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Remember that ${\\int }_{C}F\\cdot \\text{d}r$ gives the total work done by a force $F$ in moving a particle along $C:$\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${\\int }_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${\\int }_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statement ${\\int }_{C}F\\cdot \\text{d}r>0$ is false, while statement ${\\int }_{C}F\\cdot \\text{d}r<0$ is true. It's clear from the picture below that $F$  works against the motion of the particle as it moves from $A$ to $B.$\n\n![](images/14/14e94a2c5d0faabff1beeadeccb6999aa2edd71fce06fff8a2655db74e585eba.png)\n\nSo, ${\\int }_{C}F\\cdot \\text{d}r<0.$\n\n- Statement ${\\int }_{-C}F\\cdot \\text{d}r>0$ is true. It's clear from the picture below that if we reverse the orientation of $C,$ then $F$ assists the motion of the particle as it moves from $B$ to $A.$\n\n![](images/c5/c54487081f2150216b7e41b1351f0f7b19c794b140297789f19d9afe830bd7b1.png)\n\nSo, ${\\int }_{-C}F\\cdot \\text{d}r>0.$\n\nTherefore, the correct answer is ${\\int }_{C}F\\cdot \\text{d}r<0$; ${\\int }_{-C}F\\cdot \\text{d}r>0$ only."} {:db/id #edb/ref 17592186259814 :knowledge-point/_questions [{:db/id #edb/ref 17592186179739 :knowledge-point/id #uuid "dab6bfb9-608d-5ff8-88e7-5aa9612acda4" :knowledge-point/title "Interpreting the Sign of a Line Integral Over a Constant Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d53d1d6-b5c4-5b67-bf25-7d27d099f803" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462187} {:answer/id #uuid "7ea8a4ee-7a15-5906-a035-85b03d8a5bf1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462188}] :answer-field/correct {:answer/id #uuid "6d53d1d6-b5c4-5b67-bf25-7d27d099f803" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462187} :answer-field/id #uuid "c81ca5e2-2c88-5480-af0e-02088df15e01" :answer-field/key "${\\int }_{C}F\\cdot \\text{d}r>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462847} {:answer-field/choices [{:answer/id #uuid "2f4889ea-7df9-5050-8467-49e0a39fea58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462189} {:answer/id #uuid "77388560-2b05-5177-b365-d77d025c0040" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462190}] :answer-field/correct {:answer/id #uuid "77388560-2b05-5177-b365-d77d025c0040" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462190} :answer-field/id #uuid "e54e19c2-5a75-508b-8a0e-b667cad3e56c" :answer-field/key "${\\int }_{C}F\\cdot \\text{d}r<0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/check