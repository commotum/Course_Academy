92186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450029}] :answer-field/correct {:answer/id #uuid "c2411d49-0b1c-5e7b-92ce-18503f09d34c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450029} :answer-field/id #uuid "f6b41c77-8fa2-5905-bcbd-bf1b82c295fa" :answer-field/key "$z+z=2z$  is not a $4$th root of unity" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450968}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "10662523-d7b1-54f8-907f-f332605eaff8" :question/math-academy-id "q-162368" :question/problem "Let $z$ be a $4$th root of unity. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's examine our statements in turn.\n\n- Statement ${z}^{4}=-1$ is false. If $z$ is a  $4$th root of unity, then (by definition) we have that\n\n$$\n{z}^{4}=1.\n$$\n\n- Statement $(z+z)^{4}=16$ is true. Indeed,\n\n$$\n\\begin{aligned}(z+z)^{4} & =(2z)^{4} \\\\  & ={2}^{4}\\cdot {z}^{4} \\\\  & =16\\cdot 1 \\\\  & =16.\\end{aligned}\n$$\n\n- Statement “$z+z=2z$  is not a $4$th root of unity” is true. From statement $(z+z)^{4}=16$, we have that $(z+z)^{4}\\ne 1,$ which means that $z+z=2z$ is *not* a $4$th root of unity.\n\nTherefore, the correct answer is $(z+z)^{4}=16$; “$z+z=2z$  is not a $4$th root of unity” only."} {:db/id #edb/ref 17592186281456 :knowledge-point/_questions [{:db/id #edb/ref 17592186192804 :knowledge-point/id #uuid "e42234c3-4dbf-5b79-a5ff-11e228be4469" :knowledge-point/title "Identifying True Statements Regarding Product and Quotient Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33261e2c-f530-55f6-9a1e-c48edf2dbfbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450030}