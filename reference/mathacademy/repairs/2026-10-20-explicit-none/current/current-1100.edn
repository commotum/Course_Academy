:db/id #edb/ref 17592186281452 :knowledge-point/_questions [{:db/id #edb/ref 17592186192804 :knowledge-point/id #uuid "e42234c3-4dbf-5b79-a5ff-11e228be4469" :knowledge-point/title "Identifying True Statements Regarding Product and Quotient Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a05e4afb-d3f8-5d45-8cff-94491c015c70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450018} {:answer/id #uuid "b9ecf89a-83b1-5400-ac93-8dcb9a12ada9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450019}] :answer-field/correct {:answer/id #uuid "b9ecf89a-83b1-5400-ac93-8dcb9a12ada9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450019} :answer-field/id #uuid "323f6009-65c0-5f1e-bfb4-e29af6ffa6f0" :answer-field/key "${z}^{3}=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450963} {:answer-field/choices [{:answer/id #uuid "470ae2f3-d813-5467-a00b-1e65976aabcb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450020} {:answer/id #uuid "362c8fda-2955-54a8-848b-306b145cabc2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450021}] :answer-field/correct {:answer/id #uuid "362c8fda-2955-54a8-848b-306b145cabc2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450021} :answer-field/id #uuid "7bc13bc5-159a-5499-af0e-47dcfe3e2739" :answer-field/key "$(z+z)^{3}=8$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450964} {:answer-field/choices [{:answer/id #uuid "0037f4d4-a7c7-535a-86c3-26dde47eab84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450022} {:answer/id #uuid "017941c4-8b78-585a-ac13-d3c49bc2ea32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450023}] :answer-field/correct {:answer/id #uuid "0037f4d4-a7c7-535a-86c3-26dde47eab84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450022} :answer-field/id #uuid "b18b7e10-b3be-5e48-b985-19fcdd420bc9" :answer-field/key "$w+w=2w$ is a cube root of unity" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450965}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6154f21e-3dc4-5e29-9ac5-5bb6e4c1043c" :question/math-academy-id "q-162351" :question/problem "Let $z$ and $w$ be cube roots of unity. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's examine our statements in turn.\n\n- Statement ${z}^{3}=1$ is true. If $z$ and $w$ are cube roots of unity, then (by definition) we have that \n\n$$\n{z}^{3}={w}^{3}=1.\n$$\n\n- Statement $(z+z)^{3}=8$ is true. We obtain \n\n$$\n\\begin{aligned}(z+z)^{3} & =(2z)^{3} \\\\  & ={2}^{3}\\cdot {z}^{3} \\\\  & =8\\cdot 1 \\\\  & =8.\\end{aligned}\n$$\n\n- Statement “$w+w=2w$ is a cube root of unity” is false. From statement $(z+z)^{3}=8$, we have that $(w+w)^{3}=8\\ne 1,$ which means that $w+w=2w$ is *not* a cube root of unity. \n\nIn general, the sum of $n$th roots of unity is *not* an $n$th root of unity.\n\nTherefore, the correct answer is ${z}^{3}=1$; $(z+z)^{3}=8$ only."} {:db/id #edb/ref 17592186281455 :knowledge-point/_questions [{:db/id #edb/ref 17592186192804 :knowledge-point/id #uuid "e42234c3-4dbf-5b79-a5ff-11e228be4469" :knowledge-point/title "Identifying True Statements Regard