} :db/id #edb/ref 17592186466517} {:answer-field/choices [{:answer/id #uuid "b8ed078f-086d-58b9-a696-c7cd78847109" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465349} {:answer/id #uuid "c5b364ae-b468-51d1-90be-aca1212d798d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465350}] :answer-field/correct {:answer/id #uuid "b8ed078f-086d-58b9-a696-c7cd78847109" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465349} :answer-field/id #uuid "465af3cf-f18e-566f-891f-bddb7b175944" :answer-field/key "The point $(-1,-2)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466518}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d53ec269-7021-530a-b0ec-0053da9223ca" :question/math-academy-id "q-160647" :question/problem "A triangle $S$ has vertices at  $(5,-1),(2,0),(-2,-1).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the **clockwise** rotation ${R}_{-\\pi /2}$ by an angle of $\\frac{\\pi }{2}$ radians about the origin?\n\nSelect all that apply." :question/worked-solution "The clockwise rotation ${R}_{-\\pi /2}$ by an angle of $\\frac{\\pi }{2}$ radians is the same as counterclockwise rotation by an angle of $\\frac{3\\pi }{2}.$ It's given by the matrix\n\n$$\nR=\\begin{bmatrix}0 & 1 \\\\ -1 & 0\\end{bmatrix}.\n$$\n\nTo find the image of $S$ under the action of ${R}_{-\\pi /2},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =\\begin{bmatrix}5 & 2 & -2 \\\\ -1 & 0 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{-\\pi /2}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =\\begin{bmatrix}0 & 1 \\\\ -1 & 0\\end{bmatrix}\\begin{bmatrix}5 & 2 & -2 \\\\ -1 & 0 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & 0 & -1 \\\\ -5 & -2 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-1,-5),(0,-2),(-1,2).$\n\nSo, the correct answer is “The point $(-1,-5)$” only."} {:db/id #edb/ref 17592186278333 :knowledge-point/_questions [{:db/id #edb/ref 17592186092223 :knowledge-point/id #uuid "1b86558a-4c99-5ccb-a100-719692a056f4" :knowledge-point/title "Using a Matrix That Represents a Rotation of 90 Degrees"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c65752e0-6e2e-5f72-b25d-1d72c342a96b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465351} {:answer/id #uuid "eab58d28-c443-5176-a039-e1fa9838636c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465352}] :answer-field/correct {:answer/id #uuid "eab58d28-c443-5176-a039-e1fa9838636c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465352} :answer-field/id #uuid "1ec3023b-35de-57b2-824e-9b649769e148" :answer-field/key "The point $(1,1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466519} {:answer-field/choices [{:answer/id #uuid "cbd8a6c5-ad41-5cf7-b3bc-dcb90d2ac81a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465353} {:answer/id #uuid "01666383-14af-5f55-8b80-78c4e4a00351" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465354}] :answer-field/correct {:answer/id #uuid "01666383-14af-5f55-8b80-78c4e4a00351" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465354} :answer-field/id #uuid "99673497-0585-5bb8-a72a-1a86acf1e6ef" :answer-field/key "The point $(-3,-2)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466520} {:answer-field/choices [{:answer/id #uuid "473dc8aa-de2e-51cf-b1d9-f31ef6382151" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465355} {:answer/id #uuid "fd7572b4-29be-5683-a60a-269cc13e764b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465356}] :answer-field/correct {:answer/id #uuid "473dc8aa-de2e-51cf-b1d9-f31ef6382151" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465355} :answer-field/id #uuid "04d83e53-0b0c-5bdf-9065-16d90a6c72fb" :answer-field/key "The point $(0,2)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466521}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "97308e70-f67e-5dc9-9884-0142720ba3a3" :question/math-academy-id "q-160648" :question/problem "A triangle $S$ has vertices at  $(1,-1),(-2,3),(-1,0).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the **clockwise** rotation ${R}_{-{270}^{∘}}$ by an angle of ${270}^{∘}$ about the origin?\n\nSelect all that apply." :question/worked-solution "The clockwise rotation ${R}_{-{270}^{∘}}$ by an angle of ${270}^{∘}$ is the same as counterclockwise rotation by an angle of ${90}^{∘}.$ It's given by the matrix\n\n$$\nR\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}.\n$$\n\nTo find the image of $S$ under the action of ${R}_{-{270}^{∘}},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =\\begin{bmatrix}1 & -2 & -1 \\\\ -1 & 3 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{-{270}^{∘}}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}1 & -2 & -1 \\\\ -1 & 3 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -3 & 0 \\\\ 1 & -2 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(1,1),(-3,-2),(0,-1).$\n\nSo, the correct answer is “The point $(1,1)$”; “The point $(-3,-2)$” only."} {:db/id #edb/ref 17592186278339 :knowledge-point/_questions [{:db/id #edb/ref 17592186124628 :knowledge-point/id #uuid "cb02b67c-90d9-5baf-b00e-590e9271d89e" :knowledge-point/title "Identifying Sets Closed Under Addition and Scalar Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6bf42653-1c16-5ce9-9e7e-a597a3c4c0b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449862} {:answer/id #uuid "e291d1ae-3162-5bd3-9373-07c3fb0e6b2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449863}] :answer-field/correct {:answer/id #uuid "e291d1ae-3162-5bd3-9373-07c3fb0e6b2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449863} :answer-field/id #uuid "dfc510c3-d1f2-5891-8a94-d2bea4297462" :answer-field/key "$p(x)\\in K,$ where $p(x)=(x-1)^{3}.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450885} {:answer-field/choices [{:answer/id #uuid "31d951d7-15ec-5f1a-86bd-6bde01c12b78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449864} {:answer/id #uuid "e2169951-765d-5b29-a074-703cde25c6fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449865}] :answer-field/correct {:answer/id #uuid "31d951d7-15ec-5f1a-86bd-6bde01c12b78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449864} :answer-field/id #uuid "be3c2c98-dd05-5fd0-8522-655aebe441e6" :answer-field/key "For any $f(x),g(x)\\in K$, we have $f(x)+g(x)\\in K.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450886} {:answer-field/choices [{:answer/id #uuid "7300715e-719a-5c20-b508-764068a2d67f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449866} {:answer/id #uuid "240f47a2-d186-5092-8211-3fe03ff9fda5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449867}] :answer-field/correct {:answer/id #uuid "7300715e-719a-5c20-b508-764068a2d67f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449866} :answer-field/id #uuid "ac24d236-2e02-5f9e-ab6c-df162685c94e" :answer-field/key "The set is closed under addition." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450887}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d50910b7-4560-52e1-8087-133e3875c50e" :question/math-academy-id "q-160861" :question/problem "Let $K$ be the set of all functions $f:R\\to R$ such that $f(0)=-1.$  Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's verify the statements one by one.\n\n- Statement “$p(x)\\in K,$ where $p(x)=(x-1)^{3}.$” is true. Indeed, $p(x)=(x-1)^{3}\\in K$ because \n\n$$\np(0)=(0-1)^{3}=(-1)^{3}=-1.\n$$\n\n- Statement “For any $f(x),g(x)\\in K$, we have $f(x)+g(x)\\in K.$” is false. There exist functions in $K$ such that their sum is *not* in $K.$ For example, let $f(x)=-1$ and $g(x)=(x-1)^{3}.$ Notice that both these functions belong to $K$ since $f(0)=g(0)=-1.$ However,\n\n$$\nf(0)+g(0)=-1+(0-1)^{3}=-2\\ne -1.\n$$\n\nHence, $f(x)+g(x)\\notin K.$\n\n- Statement “The set is closed under addition” is false. Since statement “For any $f(x),g(x)\\in K$, we have $f(x)+g(x)\\in K.$” is false, the set is *not* closed under addition.\n\nTherefore, the correct answer is “$p(x)\\in K,$ where $p(x)=(x-1)^{3}.$” only."} {:db/id #edb/ref 17592186278340 :knowledge-point/_questions [{:db/id #edb/ref 17592186124628 :knowledge-point/id #uuid "cb02b67c-90d9-5baf-b00e-590e9271d89e" :knowledge-point/title "Identifying Sets Closed Under Addition and Scalar Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ae1846d-f710-53e8-94a9-e6c799dde714" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449868} {:answer/id #uuid "482f6d32-a3ab-5fb3-a929-84acd8cefcce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449869}] :answer-field/correct {:answer/id #uuid "482f6d32-a3ab-5fb3-a929-84acd8cefcce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449869} :answer-field/id #uuid "8231998e-01b3-5f2f-9b76-98785ede333a" :answer-field/key "$q(x)\\in W,$ where $q(x)={x}^{2}+1.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450888} {:answer-field/choices [{:answer/id #uuid "2e8fb723-d3f2-5414-b94e-74c3b51047da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449870} {:answer/id #uuid "7b43714b-6bd2-5843-89ae-8b7e89b60abf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449871}] :answer-field/correct {:answer/id #uuid "2e8fb723-d3f2-5414-b94e-74c3b51047da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449870} :answer-field/id #uuid "1bc317ea-ab84-541a-a0b2-d8a93778ba55" :answer-field/key "For any $p(x)\\in W$ and $k\\in R,$ we have $k\\cdot p(x)\\in W.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450889} {:answer-field/choices [{:answer/id #uuid "2a8d7a21-0c6b-56e1-9665-85586283bc4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449872} {:answer/id #uuid "03fe0f7f-fa95-5286-8155-a88c804a9ccf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449873}] :answer-field/correct {:answer/id #uuid "2a8d7a21-0c6b-56e1-9665-85586283bc4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449872} :answer-field/id #uuid "9168617c-d949-50fb-a217-849c51506198" :answer-field/key "The set $W$ is closed under scalar multiplication." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450890}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c5fa4f79-ef60-5ce2-8e28-cc585f25eefe" :question/math-academy-id "q-160866" :question/problem "Let $W$ be the set of all functions $f:R\\to R$ such that $f(0)=1.$  Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's verify the statements one by one.\n\n- Statement “$q(x)\\in W,$ where $q(x)={x}^{2}+1.$” is true. Indeed, $q(x)={x}^{2}+1\\in W$ because\n\n$$\nq(0)=(0)^{2}+1=1.\n$$\n\n- Statement “For any $p(x)\\in W$ and $k\\in R,$ we have $k\\cdot p(x)\\in W.$” is false. There exists a function in $W$ that has a scalar multiple not in $W.$ For example, let $p(x)={x}^{2}+1$ and $k=2.$ Notice that $p(x)$ belongs to $W$ since $p(0)=1.$ However, \n\n$$\n2\\cdot p(0)=2\\cdot ({0}^{2}+1)=2\\ne 1.\n$$\n\n Hence, $k\\cdot p(x)\\notin W.$\n\n- Statement “The set $W$ is closed under scalar multiplication” is false. Since statement “For any $p(x)\\in W$ and $k\\in R,$ we have $k\\cdot p(x)\\in W.$” is false, the set is *not* closed under scalar multiplication.\n\nTherefore, the correct answer is “$q(x)\\in W,$ where $q(x)={x}^{2}+1.$” only."} {:db/id #edb/ref 17592186278341 :knowledge-point/_questions [{:db/id #edb/ref 17592186124628 :knowledge-point/id #uuid "cb02b67c-90d9-5baf-b00e-590e9271d89e" :knowledge-point/title "Identifying Sets Closed Under Addition and Scalar Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "051e21cd-15cd-57b6-90e1-60e53a56e03e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449874} {:answer/id #uuid "594bc633-9918-5b51-b0f2-ac79be004a67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449875}] :answer-field/correct {:answer/id #uuid "594bc633-9918-5b51-b0f2-ac79be004a67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449875} :answer-field/id #uuid "1fc70fe9-3a68-5612-afad-71294e56924f" :answer-field/key "${I}_{2}\\in R$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450891} {:answer-field/choices [{:answer/id #uuid "75517d2c-f45e-5df2-863f-3db4cf4b7df7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449876} {:answer/id #uuid "fbbbf1b5-919a-5559-ab85-bf72f2ea850d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449877}] :answer-field/correct {:answer/id #uuid "75517d2c-f45e-5df2-863f-3db4cf4b7df7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449876} :answer-field/id #uuid "506358ca-1987-5082-b9b7-0db23b896bd2" :answer-field/key "For every $A,B\\in R,$ we have $A+B\\in R.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450892} {:answer-field/choices [{:answer/id #uuid "b46510c8-b37a-5e16-9245-1ac6a98ee9fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449878} {:answer/id #uuid "2cd8b2a0-9b38-51bd-901b-612ac12339b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449879}] :answer-field/correct {:answer/id #uuid "b46510c8-b37a-5e16-9245-1ac6a98ee9fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449878} :answer-field/id #uuid "5e0d358c-f55f-5167-85ce-61aa140bb298" :answer-field/key "The set is closed under addition." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450893}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "94165333-3657-56e4-b088-f39008c588be" :question/math-academy-id "q-160872" :question/problem "Let $R$ be the set of all $2\\times 2$ matrices of the form $\\begin{bmatrix}1 & 0 \\\\ 0 & a\\end{bmatrix},$ where $a\\in R.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's examine each statement in turn. \n\n- Statement ${I}_{2}\\in R$ is true. The identity matrix ${I}_{2}=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}\\in R$ since \n\n$$\n\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}1 & 0 \\\\ 0 & a\\end{bmatrix}\n$$\n\nwith $a=1.$\n\n- Statement “For every $A,B\\in R,$ we have $A+B\\in R.$” is false. There are matrices in $R$ whose sum is *not* in $R.$ For example, let $A=B={I}_{2}.$ Then $A,B\\in R,$  however,\n\n$$\nA+B=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}+\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix}\\notin R,\n$$\n\nsince the $11$-entry of this resulting matrix is equal to  $2\\ne 1.$\n\n- Statement “The set is closed under addition” is false. Since statement “For every $A,B\\in R,$ we have $A+B\\in R.$” is false, the set is *not* closed under addition.\n\nTherefore, the correct answer is ${I}_{2}\\in R$ only."} {:db/id #edb/ref 17592186278342 :knowledge-point/_questions [{:db/id #edb/ref 17592186124628 :knowledge-point/id #uuid "cb02b67c-90d9-5baf-b00e-590e9271d89e" :knowledge-point/title "Identifying Sets Closed Under Addition and Scalar Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93214199-6a10-5339-9647-35cd16bdcedf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449880} {:answer/id #uuid "0149f4d9-a144-51fe-8e20-f590fc7cabb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449881}] :answer-field/correct {:answer/id #uuid "93214199-6a10-5339-9647-35cd16bdcedf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449880} :answer-field/id #uuid "fd674e35-0795-5636-8fe0-f8882be38364" :answer-field/key "$g(x)\\in C,$ where $g(x)={x}^{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450894} {:answer-field/choices [{:answer/id #uuid "87407cda-57f5-5666-84d6-693f62d4ccca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449882} {:answer/id #uuid "9bcc8b2a-9db9-5815-85e3-20c66b327154" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449883}] :answer-field/correct {:answer/id #uuid "9bcc8b2a-9db9-5815-85e3-20c66b327154" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449883} :answer-field/id #uuid "1e6f1b71-5eec-58b0-be10-d5087f3cf5ae" :answer-field/key "For every $p(x),q(x)\\in C,$ we have $p(x)+q(x)\\in C.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450895} {:answer-field/choices [{:answer/id #uuid "05711d9f-fe0c-5d6c-924d-02d102e0f888" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449884} {:answer/id #uuid "d13fec13-1dcf-51f3-907d-031b92b61292" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449885}] :answer-field/correct {:answer/id #uuid "d13fec13-1dcf-51f3-907d-031b92b61292" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449885} :answer-field/id #uuid "6b03f8c9-c106-5a7f-8433-cb73ee72afa3" :answer-field/key "The set is closed under addition." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450896}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e68dc301-469b-5da0-9b57-a516f231e45b" :question/math-academy-id "q-160874" :question/problem "Let $C$ be the set of all polynomials with real coefficients whose degree is less than or equal to $2.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's examine our statements one at a time.\n\n- Statement “$g(x)\\in C,$ where $g(x)={x}^{3}$” is false. The set $C$ contains only polynomials whose degree is less than or equal to $2,$ however\n\n$$\n\\operatorname{deg}⁡({x}^{3})=3>2.\n$$\n\nSo, $g(x)={x}^{3}\\notin C.$\n\n- Statement “For every $p(x),q(x)\\in C,$ we have $p(x)+q(x)\\in C.$” is true. Indeed, suppose $p(x),q(x)\\in C,$ then $\\operatorname{deg}⁡(p(x))\\le 2$ and $\\operatorname{deg}⁡(q(x))\\le 2.$ Since $\\operatorname{deg}⁡(p+q)$ is less than or equal to the maximum of the degrees of $p$ and $q$, we deduce that\n\n$$\n\\operatorname{deg}⁡(p+q)\\le 2.\n$$\n\nHence, $p(x)+q(x)\\in C.$\n\n- Statement “The set is closed under addition” is true. Since statement “For every $p(x),q(x)\\in C,$ we have $p(x)+q(x)\\in C.$” is true, the set is closed under addition.\n\nTherefore, the correct answer is “For every $p(x),q(x)\\in C,$ we have $p(x)+q(x)\\in C.$”; “The set is closed under addition” only."} {:db/id #edb/ref 17592186278349 :knowledge-point/_questions [{:db/id #edb/ref 17592186133820 :knowledge-point/id #uuid "7dea8612-414c-5394-869d-1e404b048156" :knowledge-point/title "Describing Type III Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1130b77-1288-56bd-9aaa-284154797e0d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449886} {:answer/id #uuid "aaa762f2-dc0f-5728-9c33-3aaa4b04b087" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449887}] :answer-field/correct {:answer/id #uuid "aaa762f2-dc0f-5728-9c33-3aaa4b04b087" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449887} :answer-field/id #uuid "87140375-5a1c-5411-8c83-810fa7a04bd4" :answer-field/key "${f}_{1}(x,z)={x}^{2}+{z}^{2}$ and ${f}_{2}(x,z)=2x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450897} {:answer-field/choices [{:answer/id #uuid "573ba76a-016c-5fd3-a9d5-46c55ef0bae9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449888} {:answer/id #uuid "a0e1c800-eff8-51af-a2e1-bce95049cc2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449889}] :answer-field/correct {:answer/id #uuid "573ba76a-016c-5fd3-a9d5-46c55ef0bae9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449888} :answer-field/id #uuid "1444a723-b137-52b0-acc1-1e143b5421ba" :answer-field/key "${g}_{1}(x)=-\\sqrt{1-{x}^{2}}$ and ${g}_{2}(x)=\\sqrt{1-{x}^{2}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450898} {:answer-field/choices [{:answer/id #uuid "2c8c4de2-7e16-5521-94ad-1f4111e81460" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449890} {:answer/id #uuid "6e1728e6-4f98-525f-86e7-fe2f33ca023b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449891}] :answer-field/correct {:answer/id #uuid "6e1728e6-4f98-525f-86e7-fe2f33ca023b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449891} :answer-field/id #uuid "70643b37-b031-537e-9582-c61eb42df2ec" :answer-field/key "$a=0$ and $b=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450899}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a2294020-eb10-5fa0-b942-17d14bfa1ac7" :question/math-academy-id "q-160962" :question/problem "The region $R$ is bounded between the elliptic paraboloid $y={x}^{2}+{z}^{2}$ and the plane $y=2x.$ Given its representation \n\n$$\nR={(x,y,z)\\,:\\,a\\le x\\le b,\\,{g}_{1}(x)\\le z\\le {g}_{2}(x),\\,{f}_{1}(x,z)\\le y\\le {f}_{2}(x,z)}\n$$\n\nas a type III region in three-dimensional space, which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A typical three-dimensional type III region can be visualized schematically, as shown below.\n\n![](images/c3/c3333ded3e00e7d7408f0dbd37807f1adec0301691cc6311871bfea6d7b9fa15.png)\n\n \n\nLet's find a type III representation of our region.\n\n**Step 1.** We start by finding the surfaces ${f}_{1}(x,z)$ and ${f}_{2}(x,z).$ Since all $y$ in the region are bounded *below* by $y={x}^{2}+{z}^{2}$ and *above* by $y=2x,$ we have\n\n$$\n\\underbrace{{x}^{2}+{z}^{2}}_{{f}_{1}(x,z)}\\le y\\le \\underbrace{2x}_{{f}_{2}(x,z)}.\n$$\n\nSo, statement “${f}_{1}(x,z)={x}^{2}+{z}^{2}$ and ${f}_{2}(x,z)=2x$” is true.\n\n**Step 2.** We find the projection of the intersection between the elliptic paraboloid $y={x}^{2}+{z}^{2}$ and the plane $y=2x$ onto the $xz$-plane.\n\nNotice that the equation of the plane is already solved for $y.$ Substituting this expression for $y$ into the equation of the paraboloid, we obtain: \n\n$$\n\\begin{aligned}2x & ={x}^{2}+{z}^{2} \\\\ {x}^{2}-2x+{z}^{2} & =0 \\\\ ({x}^{2}-2x+1)+{z}^{2} & =1 \\\\ (x-1)^{2}+{z}^{2} & =1\\end{aligned}\n$$\n\n \n\nSo, the projection of the intersection is the circle $(x-1)^{2}+{z}^{2}=1$ centered at $(1,0)$ in the $xz$-plane. \n\n![](images/0b/0bcadeca7ede6f709bf06391e10da66afd1b514fd0e041bbf108e6e4229b0da6.png)\n\nThe region is bounded *below* by $z=-\\sqrt{1-(x-1)^{2}}$ and bounded *above* by $z=\\sqrt{1-(x-1)^{2}}.$ Therefore,\n\n$$\n\\underbrace{-\\sqrt{1-(x-1)^{2}}}_{{g}_{1}(x)}\\le z\\le \\underbrace{\\sqrt{1-(x-1)^{2}}}_{{g}_{2}(x)}.\n$$\n\nSo, statement “${g}_{1}(x)=-\\sqrt{1-{x}^{2}}$ and ${g}_{2}(x)=\\sqrt{1-{x}^{2}}$” is false.\n\n**Step 3.** We find the bounds for $x.$ From the diagram, $x$ is bounded *below* by $x=0$ and bounded *above* by $x=2.$ Therefore,\n\n$$\n\\underbrace{0}_{a}\\le x\\le \\underbrace{2}_{b}.\n$$\n\nSo, statement “$a=0$ and $b=2$” is true.\n\nFinally, the correct answer is “${f}_{1}(x,z)={x}^{2}+{z}^{2}$ and ${f}_{2}(x,z)=2x$”; “$a=0$ and $b=2$” only."} {:db/id #edb/ref 17592186278354 :knowledge-point/_questions [{:db/id #edb/ref 17592186198384 :knowledge-point/id #uuid "58fbdce5-60b9-5682-a84e-1c8a5077c762" :knowledge-point/title "Finding the Image of a Horizontal Segment Under a Polar Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ced6f09a-8000-5f7c-ad47-988971bb0974" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465357} {:answer/id #uuid "af08fe73-31bb-5110-8d95-c99f400010f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465358}] :answer-field/correct {:answer/id #uuid "af08fe73-31bb-5110-8d95-c99f400010f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465358} :answer-field/id #uuid "9c25352d-9959-5019-ab3b-38ce4f009ae9" :answer-field/key "The image makes the angle of $0$ with the positive $x$-axis." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466522} {:answer-field/choices [{:answer/id #uuid "3e1d86f8-793d-549d-86cf-8de9d46ff35c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465359} {:answer/id #uuid "4ff2e8c0-a3a1-5652-9ba6-1bddbbb05bea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465360}] :answer-field/correct {:answer/id #uuid "3e1d86f8-793d-549d-86cf-8de9d46ff35c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465359} :answer-field/id #uuid "fcdfedc5-7865-5caf-a085-bd23bb5a113f" :answer-field/key "The image makes the angle of $\\frac{\\pi }{4}$ with the positive $x$-axis." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466523} {:answer-field/choices [{:answer/id #uuid "19440a4a-c00c-5eb4-84fa-d15885a94c0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465361} {:answer/id #uuid "96294057-8f7b-50e7-a15b-cbd756b65898" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465362}] :answer-field/correct {:answer/id #uuid "96294057-8f7b-50e7-a15b-cbd756b65898" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465362} :answer-field/id #uuid "03ab94df-f36b-504b-a946-93365d5695c3" :answer-field/key "One endpoint of the image is the origin $O$ of the $xy$-plane, and the other endpoint lies on the circle of radius $\\sqrt{3}$ centered at $O.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466524}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "507c7b5b-1f55-5451-94d5-1770ddfeea4a" :question/math-academy-id "q-161031" :question/problem "![](images/09/0963fc3c56b5baac68e2d587896bf4655950640ecce5b924edc2d8e26a3e64e2.png)\n\nConsider the square region $Δ$ in the $uv$-plane, given by\n\n$$\nΔ={(u,v)\\,:\\,0\\le u\\le \\sqrt{3},\\,\\,0\\le v\\le \\frac{\\pi }{4}},\n$$\n\nand the transformation $T,$ given by\n\n$$\nT:(u,v)\\to (u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v).\n$$\n\nThe image of the bottom side of $Δ$ under the action of $T$ is a line segment. Which of the following statements are true regarding the image?\n\nSelect all that apply." :question/worked-solution "To map the entire region $Δ$ onto the $xy$-plane, we consider the transformation of each side. However, in this case, we consider only the bottom side.\n\nFor the bottom side, we have $v=0$ and $0\\le u\\le \\sqrt{3}.$ \n\nSubstituting $v=0$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y) & =T(u,v) \\\\  & =(u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v) \\\\  & =(u\\operatorname{cos}⁡0,\\,u\\operatorname{sin}⁡0) \\\\  & =(u,\\,0),\\,0\\le u\\le \\sqrt{3}.\\end{aligned}\n$$\n\nThis is a parametric equation of the line segment shown below.\n\n![](images/92/92bd315a07a5d76e77c249c12ea4544ee1555b0c214c68cf1f92fc3f07a71ddf.png)\n\n \n\nNote that the line that this segment lies on passes through the origin. \n\nWith that in mind, let's examine our statements.\n\n- Statement “The image makes the angle of $0$ with the positive $x$-axis” is true, while statement “The image makes the angle of $\\frac{\\pi }{4}$ with the positive $x$-axis” is false. The slope of the line is\n\n$$\nk=\\frac{\\operatorname{sin}⁡0}{\\operatorname{cos}⁡0}=\\operatorname{tan}⁡0.\n$$\n\nAs a result, our line makes an angle of $0$ radians with the positive $x$-axis.\n\n- Statement “One endpoint of the image is the origin $O$ of the $xy$-plane, and the other endpoint lies on the circle of radius $\\sqrt{3}$ centered at $O.$” is true.\n\n- When $u=0,$ we obtain the point \n$(0,\\,0),$\nwhich is the origin $O$ of the $xy$-plane.\n\n- When $u=\\sqrt{3},$ we obtain the point \n$(\\sqrt{3}\\operatorname{cos}⁡0,\\,\\sqrt{3}\\operatorname{sin}⁡0),$\nwhose distance to $O$ is $\\sqrt{3}.$\n\nSo, one endpoint of the segment is the origin $O$ of the $xy$-plane, while the other endpoint lies on the circle with radius $\\sqrt{3}$ centered at $O.$\n\nTherefore, the correct answer is “The image makes the angle of $0$ with the positive $x$-axis”; “One endpoint of the image is the origin $O$ of the $xy$-plane, and the other endpoint lies on the circle of radius $\\sqrt{3}$ centered at $O.$” only."} {:db/id #edb/ref 17592186278355 :knowledge-point/_questions [{:db/id #edb/ref 17592186198384 :knowledge-point/id #uuid "58fbdce5-60b9-5682-a84e-1c8a5077c762" :knowledge-point/title "Finding the Image of a Horizontal Segment Under a Polar Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3096bf79-13cb-5594-8ff3-0aacf795dbf7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465363} {:answer/id #uuid "393ffa03-6956-52c3-9c56-83c0666a5be8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465364}] :answer-field/correct {:answer/id #uuid "3096bf79-13cb-5594-8ff3-0aacf795dbf7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465363} :answer-field/id #uuid "d865425f-0ed5-5b50-8ef9-b8868f1ed1a5" :answer-field/key "The image makes the angle of $\\frac{10\\pi }{9}$ with the positive $x$-axis." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466525} {:answer-field/choices [{:answer/id #uuid "313850ab-cf0e-5be1-adef-f98bf156970b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465365} {:answer/id #uuid "13a93521-b1c0-56cd-89e3-b6c1a0c7b8ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465366}] :answer-field/correct {:answer/id #uuid "13a93521-b1c0-56cd-89e3-b6c1a0c7b8ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465366} :answer-field/id #uuid "fd71148f-4e73-5e2a-8879-b803cc673e59" :answer-field/key "The image makes the angle of $\\frac{4\\pi }{3}$ with the positive $x$-axis." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466526} {:answer-field/choices [{:answer/id #uuid "8d8d6a03-31ff-5539-a052-c4af98a1c661" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465367} {:answer/id #uuid "c1b94c56-f71d-5f8c-82f5-974795670e84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465368}] :answer-field/correct {:answer/id #uuid "8d8d6a03-31ff-5539-a052-c4af98a1c661" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465367} :answer-field/id #uuid "f410ff3f-f43f-507a-8637-7fcae02b4d22" :answer-field/key "The endpoints of the image lie on the circles of radii $\\sqrt{2}$ and $2$ centered at $O.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466527}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4b7f9af3-cd62-5b44-9828-72b23454ff87" :question/math-academy-id "q-161032" :question/problem "![](images/16/16d74107dbbf12749766cd9cea7e38d16e28a59efb997bd224aed73c7830324e.png)\n\nConsider the square region $Δ$ in the $uv$-plane, given by\n\n$$\nΔ=\\{(u,v)\\,:\\,2\\le u\\le 4,\\,\\,\\frac{10\\pi }{9}\\le v\\le \\frac{4\\pi }{3}\\},\n$$\n\nand the transformation $T,$ given by\n\n$$\nT:(u,v)\\to (u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v).\n$$\n\nThe image of the top side of $Δ$ under the action of $T$ is a line segment. Which of the following statements are true regarding the image?\n\nSelect all that apply." :question/worked-solution "To map the entire region $Δ$ onto the $xy$-plane, we consider the transformation of each side. However, in this case, we consider only the top side.\n\nFor the top side, we have $v=\\frac{4\\pi }{3}$ and $2\\le u\\le 4.$ \n\nSubstituting $v=\\frac{4\\pi }{3}$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y) & =T(u,v) \\\\  & =(u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v) \\\\  & =(u\\operatorname{cos}⁡\\left(\\frac{4\\pi }{3}\\right),\\,u\\operatorname{sin}⁡\\left(\\frac{4\\pi }{3}\\right)),\\,2\\le u\\le 4.\\end{aligned}\n$$\n\nThis is a parametric equation of the line segment shown below.\n\n![](images/bf/bfe75ef6b4ea9ddd72be6501f95fd89dd1e80fb2aed691c3c22b158514141cc1.png)\n\n \n\nNote that the line that this segment lies on passes through the origin. \n\nWith that in mind, let's examine our statements.\n\n- Statement “The image makes the angle of $\\frac{10\\pi }{9}$ with the positive $x$-axis” is false, while statement “The image makes the angle of $\\frac{4\\pi }{3}$ with the positive $x$-axis” is true. The slope of the line is\n\n$$\nk=\\frac{\\operatorname{sin}⁡\\left(\\frac{4\\pi }{3}\\right)}{\\operatorname{cos}⁡\\left(\\frac{4\\pi }{3}\\right)}=\\operatorname{tan}⁡\\left(\\frac{4\\pi }{3}\\right).\n$$\n\nAs a result, our line makes an angle of $\\frac{4\\pi }{3}$ radians with the positive $x$-axis.\n\n- Statement “The endpoints of the image lie on the circles of radii $\\sqrt{2}$ and $2$ centered at $O.$” is false.\n\n- When $u=2,$ we obtain the point \n$(2\\operatorname{cos}⁡\\left(\\frac{4\\pi }{3}\\right),\\,2\\operatorname{sin}⁡\\left(\\frac{4\\pi }{3}\\right)),$\nwhose distance to the origin is $2.$\n\n- When $u=4,$ we obtain the point \n$(4\\operatorname{cos}⁡\\left(\\frac{4\\pi }{3}\\right),\\,4\\operatorname{sin}⁡\\left(\\frac{4\\pi }{3}\\right)),$\nwhose distance to the origin is $4.$\n\nSo, the endpoints of the line segment lie on the circles of radii $2$ and $4.$\n\nTherefore, the correct answer is “The image makes the angle of $\\frac{4\\pi }{3}$ with the positive $x$-axis” only."} {:db/id #edb/ref 17592186278356 :knowledge-point/_questions [{:db/id #edb/ref 17592186198384 :knowledge-point/id #uuid "58fbdce5-60b9-5682-a84e-1c8a5077c762" :knowledge-point/title "Finding the Image of a Horizontal Segment Under a Polar Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e9d7f9d-83aa-5312-b9f9-936431142ca4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465369} {:answer/id #uuid "0ac8bfb2-2b9e-55b8-bb40-8f8acd30ba03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465370}] :answer-field/correct {:answer/id #uuid "3e9d7f9d-83aa-5312-b9f9-936431142ca4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465369} :answer-field/id #uuid "3c3a02a3-a8fc-5d7d-a6a6-ce9f21391422" :answer-field/key "The image makes the angle of $0$ with the positive $x$-axis." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466528} {:answer-field/choices [{:answer/id #uuid "a7781f3c-7002-5af8-8927-9ec981d328c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465371} {:answer/id #uuid "a99cc1de-6948-5f01-b0c0-9f08fcb47a6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465372}] :answer-field/correct {:answer/id #uuid "a99cc1de-6948-5f01-b0c0-9f08fcb47a6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465372} :answer-field/id #uuid "bcb1bd5d-92e5-55ab-9836-46ae0a7485ce" :answer-field/key "The image makes the angle of $\\frac{3\\pi }{4}$ with the positive $x$-axis." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466529} {:answer-field/choices [{:answer/id #uuid "7401365f-e9ac-59db-a5a4-772ee4d7ef48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465373} {:answer/id #uuid "cd23ead9-89df-5865-9f9e-b85c6d699f6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465374}] :answer-field/correct {:answer/id #uuid "7401365f-e9ac-59db-a5a4-772ee4d7ef48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465373} :answer-field/id #uuid "789e9739-d69d-5715-b272-2c686ab19b73" :answer-field/key "One endpoint of the image is the origin $O$ of the $xy$-plane, and the other endpoint lies on the circle of radius $5$ centered at $O.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466530}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "35901d5d-b737-59bd-bd22-20c686ac3fe1" :question/math-academy-id "q-161035" :question/problem "![](images/8a/8afe0884ccf1e62ffdfef6cab4626bc59b3138aa5cd26f855980c88971753447.png)\n\nConsider the square region $Δ$ in the $uv$-plane, given by\n\n$$\nΔ={(u,v)\\,:\\,0\\le u\\le \\sqrt{5},\\,\\,0\\le v\\le \\frac{3\\pi }{4}},\n$$\n\nand the transformation $T,$ given by\n\n$$\nT:(u,v)\\to (u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v).\n$$\n\nThe image of the top side of $Δ$ under the action of $T$ is a line segment. Which of the following statements are true regarding the image?\n\nSelect all that apply.\n\nIf none apply, leave all boxes unchecked." :question/worked-solution "To map the entire region $Δ$ onto the $xy$-plane, we consider the transformation of each side. However, in this case, we consider only the top side.\n\nFor the top side, we have $v=\\frac{3\\pi }{4}$ and $0\\le u\\le \\sqrt{5}.$ \n\nSubstituting $v=\\frac{3\\pi }{4}$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y) & =T(u,v) \\\\  & =(u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v) \\\\  & =(u\\operatorname{cos}⁡\\left(\\frac{3\\pi }{4}\\right),\\,u\\operatorname{sin}⁡\\left(\\frac{3\\pi }{4}\\right)),\\,0\\le u\\le \\sqrt{5}.\\end{aligned}\n$$\n\nThis is a parametric equation of the line segment shown below.\n\n![](images/b8/b836799bc512db70d2ce5fcfe70db2af3b2572d584d317fa5ed515b363a11ddc.png)\n\n \n\nNote that the line that this segment lies on passes through the origin. \n\nWith that in mind, let's examine our statements.\n\n- Statement “The image makes the angle of $0$ with the positive $x$-axis” is false, while statement “The image makes the angle of $\\frac{3\\pi }{4}$ with the positive $x$-axis” is true. The slope of the line is\n\n$$\nk=\\frac{\\operatorname{sin}⁡\\left(\\frac{3\\pi }{4}\\right)}{\\operatorname{cos}⁡\\left(\\frac{3\\pi }{4}\\right)}=\\operatorname{tan}⁡\\left(\\frac{3\\pi }{4}\\right).\n$$\n\nAs a result, our line makes an angle of $\\frac{3\\pi }{4}$ radians with the positive $x$-axis.\n\n- Statement “One endpoint of the image is the origin $O$ of the $xy$-plane, and the other endpoint lies on the circle of radius $5$ centered at $O.$” is false.\n\n- When $u=0,$ we obtain the point $(0,\\,0),$ which is the origin $O$ of the $xy$-plane.\n\n- When $u=\\sqrt{5},$ we obtain the point \n$(\\sqrt{5}\\operatorname{cos}⁡\\left(\\frac{3\\pi }{4}\\right),\\,\\sqrt{5}\\operatorname{sin}⁡\\left(\\frac{3\\pi }{4}\\right)),$\nwhose distance to $O$ is $\\sqrt{5}.$\n\nSo, one endpoint of the segment is the origin $O$ of the $xy$-plane, while the other endpoint lies in the circle with radius $\\sqrt{5}$ centered at $O.$\n\nTherefore, the correct answer is “The image makes the angle of $\\frac{3\\pi }{4}$ with the positive $x$-axis” only."} {:db/id #edb/ref 17592186278386 :knowledge-point/_questions [{:db/id #edb/ref 17592186133818 :knowledge-point/id #uuid "4c05d4f9-eb1b-59a1-ae0b-5d6869bad7c5" :knowledge-point/title "Describing Type I Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dc900d5-6adb-5291-bb29-945c24e8a52d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465375} {:answer/id #uuid "c5db8b48-0145-59b3-853e-2dc9a73f5319" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465376}] :answer-field/correct {:answer/id #uuid "3dc900d5-6adb-5291-bb29-945c24e8a52d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465375} :answer-field/id #uuid "6ba930a6-1b15-54d9-9b76-147214cfd918" :answer-field/key "$\\begin{gathered}D=\\left\\{\\begin{gathered}(x,y)\\,:\\\\\\,0\\le x\\le 1,\\\\\\,0\\le y\\le 3\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466531} {:answer-field/choices [{:answer/id #uuid "86f9f9d7-6a29-54a0-b78d-ab1ada5cb3ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465377} {:answer/id #uuid "66070404-2e4d-59d0-81b6-d80fbc47cbca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465378}] :answer-field/correct {:answer/id #uuid "66070404-2e4d-59d0-81b6-d80fbc47cbca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465378} :answer-field/id #uuid "7e459526-4e2e-5b5d-9c5a-53a2552e46e3" :answer-field/key "${f}_{1}(x,y)=0$ and ${f}_{2}(x,y)=3-x+y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466532} {:answer-field/choices [{:answer/id #uuid "43c5d968-0c47-5b5c-af0a-2a7a009a838c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465379} {:answer/id #uuid "bf8627ef-3c0a-5dbb-bc99-ce2b4f5f165f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465380}] :answer-field/correct {:answer/id #uuid "43c5d968-0c47-5b5c-af0a-2a7a009a838c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465379} :answer-field/id #uuid "9b4d526b-c9a0-5573-a72d-651b90ac9856" :answer-field/key "${f}_{1}(x,y)=1$ and ${f}_{2}(x,y)=4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466533}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0b05250a-2126-54a5-8110-d92f7f2aa122" :question/math-academy-id "q-161117" :question/problem "![](images/7b/7bb6d2b9f9e09de44e078657ce3517bfd78261d3206743b7882abf0112f38a93.png)\n\nThe region $R$ is bounded by the planes $x=0$, $x=1$, $y=0$, $y=1$, $z=0,$ and $z=3-x+y.$ Given its representation \n\n$$\nR={(x,y,z)\\,:\\,(x,y)\\in D,\\,{f}_{1}(x,y)\\le z\\le {f}_{2}(x,y)}\n$$\n\nas a type I region in three-dimensional space, which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A typical three-dimensional type I region can be visualized schematically, as shown below.\n\n![](images/05/05f940e247c6cd5d862d81fc3a34658353bef5513dfe862bbc67a120c0345838.png)\n\n \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement $\\begin{gathered}D=\\left\\{\\begin{gathered}(x,y)\\,:\\\\\\,0\\le x\\le 1,\\\\\\,0\\le y\\le 3\\end{gathered}\\right\\}\\end{gathered}$ is false. The projection $D$ of the solid onto the $xy$-plane gives the domain \n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le 1}.\n$$\n\n- Statement “${f}_{1}(x,y)=0$ and ${f}_{2}(x,y)=3-x+y$” is true, while statement “${f}_{1}(x,y)=1$ and ${f}_{2}(x,y)=4$” is false. Indeed, we have\n\n- the *bottom* surface $z={f}_{1}(x,y)=0$, and\n\n- the *top* surface $z={f}_{2}(x,y)=3-x+y.$\n\n![](images/65/65e179e16b66009b9168c4380032b01c3a79b3c4a2afc3b8e5084defb77b85fc.png)\n\n \n\n$$\n\n$$\n\nTherefore, the correct answer is “${f}_{1}(x,y)=0$ and ${f}_{2}(x,y)=3-x+y$” only."} {:db/id #edb/ref 17592186278389 :knowledge-point/_questions [{:db/id #edb/ref 17592186133818 :knowledge-point/id #uuid "4c05d4f9-eb1b-59a1-ae0b-5d6869bad7c5" :knowledge-point/title "Describing Type I Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cabb0a8d-aff4-57ab-96f0-f8d0915a925d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465381} {:answer/id #uuid "6578be7a-a203-5728-8f45-7417f3a0a68c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465382}] :answer-field/correct {:answer/id #uuid "6578be7a-a203-5728-8f45-7417f3a0a68c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465382} :answer-field/id #uuid "f7df53d5-584d-50cd-959b-c1935fb43d75" :answer-field/key "$\\begin{gathered}D=\\left\\{\\begin{gathered}(x,y)\\,:\\\\\\,0\\le x\\le 3,\\\\\\,0\\le y\\le 2\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466534} {:answer-field/choices [{:answer/id #uuid "76e10513-2430-594e-8305-5bb7ccc10a75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465383} {:answer/id #uuid "5beefa76-4a9e-5425-8ae8-78a4b372ea51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465384}] :answer-field/correct {:answer/id #uuid "76e10513-2430-594e-8305-5bb7ccc10a75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465383} :answer-field/id #uuid "697d5114-f05b-5010-aa74-40202b0c59b3" :answer-field/key "${f}_{1}(x,y)=2$ and ${f}_{2}(x,y)=\\frac{15-4x}{5}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466535} {:answer-field/choices [{:answer/id #uuid "79f1e02b-e929-5dcd-8dd3-1c7a56b7b8b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465385} {:answer/id #uuid "61410729-3c43-570c-9bd4-40124d7efd17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465386}] :answer-field/correct {:answer/id #uuid "79f1e02b-e929-5dcd-8dd3-1c7a56b7b8b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465385} :answer-field/id #uuid "8b954c2f-713e-5e8c-9abc-b9a072f0f21c" :answer-field/key "${f}_{1}(x,y)=0$ and ${f}_{2}(x,y)=3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466536}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "99aeb9ca-3424-5f18-af86-89763375eaeb" :question/math-academy-id "q-161125" :question/problem "![](images/e5/e5369264a9ab9328449bafd6fd3dcda1a70b7d90cbaf4f9815211e0cc3873fc0.png)\n\nThe region $R$ is bounded by the planes $x=0$, $x=3$, $y=0$, $y=2$, $z=0,$ and $4x+5z=15.$ Given its representation\n\n$$\nR={(x,y,z)\\,:\\,(x,y)\\in D,\\,{f}_{1}(x,y)\\le z\\le {f}_{2}(x,y)}\n$$\n\nas a type I region in three-dimensional space, which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A typical three-dimensional type I region can be visualized schematically, as shown below.\n\n![](images/05/05f940e247c6cd5d862d81fc3a34658353bef5513dfe862bbc67a120c0345838.png)\n\n \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement $\\begin{gathered}D=\\left\\{\\begin{gathered}(x,y)\\,:\\\\\\,0\\le x\\le 3,\\\\\\,0\\le y\\le 2\\end{gathered}\\right\\}\\end{gathered}$ is true. The projection $D$ of the solid onto the $xy$-plane gives the domain \n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 3,\\,0\\le y\\le 2}.\n$$\n\n- Statement “${f}_{1}(x,y)=2$ and ${f}_{2}(x,y)=\\frac{15-4x}{5}$” and statement “${f}_{1}(x,y)=0$ and ${f}_{2}(x,y)=3$” are false. We have\n\n- the *bottom* surface $z={f}_{1}(x,y)=0$, and\n\n- the *top* surface $z={f}_{2}(x,y)=\\frac{15-4x}{5}.$\n\n![](images/ed/edea8af334c3362f583fcb86709150690eeec79a54185b67d242bfa14a8e4c75.png)\n\n \n\nTherefore, the correct answer is $\\begin{gathered}D=\\left\\{\\begin{gathered}(x,y)\\,:\\\\\\,0\\le x\\le 3,\\\\\\,0\\le y\\le 2\\end{gathered}\\right\\}\\end{gathered}$ only."} {:db/id #edb/ref 17592186278396 :knowledge-point/_questions [{:db/id #edb/ref 17592186133818 :knowledge-point/id #uuid "4c05d4f9-eb1b-59a1-ae0b-5d6869bad7c5" :knowledge-point/title "Describing Type I Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69833de8-8f53-508a-afb8-4cd0942cbfde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449892} {:answer/id #uuid "2e483b85-a74c-551d-91b1-c5d4b4a2b812" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449893}] :answer-field/correct {:answer/id #uuid "69833de8-8f53-508a-afb8-4cd0942cbfde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449892} :answer-field/id #uuid "0110c544-9d0f-5f58-877f-7f806d8b1d46" :answer-field/key "$D={(x,y)\\,:\\,(x-1)^{2}+{y}^{2}\\le 1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450900} {:answer-field/choices [{:answer/id #uuid "b72e12c2-7cfa-5bf6-8174-edfc888d1b27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449894} {:answer/id #uuid "0da01652-9a03-567e-8945-1d508e3a6b48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449895}] :answer-field/correct {:answer/id #uuid "0da01652-9a03-567e-8945-1d508e3a6b48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449895} :answer-field/id #uuid "dd1096c9-f257-5ee9-adb0-c66067e6606c" :answer-field/key "$D={(x,y)\\,:\\,{x}^{2}+{(y+1)}^{2}\\le 4}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450901} {:answer-field/choices [{:answer/id #uuid "a28d2746-3ce7-5e78-9a24-6dc4b1e7349f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449896} {:answer/id #uuid "66c8c5cd-4945-5b7d-8351-ceeb9212d153" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449897}] :answer-field/correct {:answer/id #uuid "66c8c5cd-4945-5b7d-8351-ceeb9212d153" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449897} :answer-field/id #uuid "e5d9a367-1c5d-5b35-90d9-1396788916ac" :answer-field/key "${f}_{1}(x,y)=2y+1$  and  ${f}_{2}(x,y)=4-{x}^{2}-{y}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450902}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d909db1e-2d8a-5169-914f-b321d4c2af66" :question/math-academy-id "q-161137" :question/problem "The region $R$ is bounded between  the plane $z=2y+1$ and the elliptic paraboloid $z=4-{x}^{2}-{y}^{2}.$  Given its representation\n\n$$\nR={(x,y,z)\\,:\\,(x,y)\\in D,\\,{f}_{1}(x,y)\\le z\\le {f}_{2}(x,y)}\n$$\n\nas a type I region in three-dimensional space, which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A typical three-dimensional type I region can be visualized schematically, as shown below.\n\n![](images/05/05f940e247c6cd5d862d81fc3a34658353bef5513dfe862bbc67a120c0345838.png)\n\n \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement $D={(x,y)\\,:\\,(x-1)^{2}+{y}^{2}\\le 1}$ is false, while statement $D={(x,y)\\,:\\,{x}^{2}+{(y+1)}^{2}\\le 4}$ is true. \n\nFirst, we find the projection of the intersection between the elliptic paraboloid $z=4-{x}^{2}-{y}^{2}$ and the plane $z=2y+1$ onto $xy$-plane.  \n\nNotice that the equation of the plane is already solved for $z.$ Substituting this expression for $z$ into the equation of the paraboloid, we obtain:\n\n$$\n\\begin{aligned}2y+1 & =4-{x}^{2}-{y}^{2} \\\\ {x}^{2}+{y}^{2}+2y & =3 \\\\ {x}^{2}+({y}^{2}+2y+1) & =4 \\\\ {x}^{2}+{(y+1)}^{2} & =4\\end{aligned}\n$$\n\nSo, the projection of the intersection is the circle ${x}^{2}+{(y+1)}^{2}=4$ centered at $(0,-1)$ in the $xy$-plane. Hence, the domain $D$ is given by the following disc:\n\n$$\nD={(x,y)\\,:\\,{x}^{2}+{(y+1)}^{2}\\le 4}\n$$\n\n- Statement “${f}_{1}(x,y)=2y+1$  and  ${f}_{2}(x,y)=4-{x}^{2}-{y}^{2}$” is true. We have that $z$ is \n\n- bounded *below* by ${f}_{1}(x,y)=2y+1,$ and\n\n- bounded *above* by ${f}_{2}(x,y)=4-{x}^{2}-{y}^{2}.$\n\nTherefore, the correct answer is $D={(x,y)\\,:\\,{x}^{2}+{(y+1)}^{2}\\le 4}$; “${f}_{1}(x,y)=2y+1$  and  ${f}_{2}(x,y)=4-{x}^{2}-{y}^{2}$” only."} {:db/id #edb/ref 17592186278399 :knowledge-point/_questions [{:db/id #edb/ref 17592186133818 :knowledge-point/id #uuid "4c05d4f9-eb1b-59a1-ae0b-5d6869bad7c5" :knowledge-point/title "Describing Type I Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18631c1a-dc9f-59f0-86c1-a1f4e22e3183" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449898} {:answer/id #uuid "e75ba7fe-c065-55c6-b1b7-248c7d69fe11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449899}] :answer-field/correct {:answer/id #uuid "18631c1a-dc9f-59f0-86c1-a1f4e22e3183" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449898} :answer-field/id #uuid "bad823b2-bc47-5409-8d5a-810924dea61c" :answer-field/key "${f}_{1}(x,y)=4-{x}^{2}-{y}^{2}$ and ${f}_{2}(x,y)=2y+1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450903} {:answer-field/choices [{:answer/id #uuid "3539321c-fba4-56ef-b602-afcc37f1af42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449900} {:answer/id #uuid "a6dc9624-9550-5e8e-a6ac-6b46adf72c76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449901}] :answer-field/correct {:answer/id #uuid "a6dc9624-9550-5e8e-a6ac-6b46adf72c76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449901} :answer-field/id #uuid "ee2f27fe-0d34-5cdf-9eda-b50effcd9fe7" :answer-field/key "${g}_{1}(y)=-\\sqrt{4-(y+1)^{2}}$ and ${g}_{2}(y)=\\sqrt{4-(y+1)^{2}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450904} {:answer-field/choices [{:answer/id #uuid "53d27d94-8283-5c40-b866-9bd4ada708fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449902} {:answer/id #uuid "836bce11-d60e-5dc2-beb2-4d81ce933354" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449903}] :answer-field/correct {:answer/id #uuid "53d27d94-8283-5c40-b866-9bd4ada708fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449902} :answer-field/id #uuid "fcd90bbb-c222-5223-b589-2b9cebe381d6" :answer-field/key "$a=1$ and $b=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450905}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "91da0da4-8cfa-5b1f-811f-ea50a1876fb0" :question/math-academy-id "q-161143" :question/problem "The region $R$ is bounded between  the plane $z=2y+1$ and the elliptic paraboloid $z=4-{x}^{2}-{y}^{2}.$ Given its representation\n\n$$\nR={(x,y,z)\\,:\\,a\\le y\\le b,\\,{g}_{1}(y)\\le x\\le {g}_{2}(y),\\,{f}_{1}(x,y)\\le z\\le {f}_{2}(x,y)}\n$$\n\nas a type I region in three-dimensional space, which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A typical three-dimensional type I region can be visualized schematically, as shown below.\n\n![](images/05/05f940e247c6cd5d862d81fc3a34658353bef5513dfe862bbc67a120c0345838.png)\n\n \n\nLet's find a type I representation of our region.\n\n**Step 1.** We start by finding the surfaces ${f}_{1}(x,y)$ and ${f}_{2}(x,y).$ Since all $z$ in the region are bounded *below* by $z=2y+1$ and *above* by $z=4-{x}^{2}-{y}^{2},$ we have \n\n$$\n\\underbrace{2y+1}_{{f}_{1}(x,y)}\\le z\\le \\underbrace{4-{x}^{2}-{y}^{2}}_{{f}_{2}(x,y)}.\n$$\n\nSo, statement “${f}_{1}(x,y)=4-{x}^{2}-{y}^{2}$ and ${f}_{2}(x,y)=2y+1$” is false.\n\n**Step 2.** We find the projection of the intersection between the elliptic paraboloid $z=4-{x}^{2}-{y}^{2}$ and the plane $z=2y+1$ onto the $xy$-plane. \n\nNotice that the equation of the plane is already solved for $z.$ Substituting this expression for $z$ into the equation of the paraboloid, we obtain: \n\n$$\n\\begin{aligned}2y+1 & =4-{x}^{2}-{y}^{2} \\\\ {x}^{2}+{y}^{2}+2y & =3 \\\\ {x}^{2}+({y}^{2}+2y+1) & =4 \\\\ {x}^{2}+{(y+1)}^{2} & =4\\end{aligned}\n$$\n\n   \n\nSo, the projection of the intersection is the circle ${x}^{2}+{(y+1)}^{2}=4$ centered at $(0,-1)$ in the $xy$-plane.    \n\n![](images/39/39d2daceb171d26d3396e5aaeab4d8b8da2e9b8324e4042f2b7ed048f4a5fdeb.png)\n\nThe region is bounded on the *left* by $x=-\\sqrt{4-(y+1)^{2}}$ and bounded on the *right* by $x=\\sqrt{4-(y+1)^{2}}.$ Therefore,      \n\n$$\n\\underbrace{-\\sqrt{4-(y+1)^{2}}}_{{g}_{1}(y)}\\le x\\le \\underbrace{\\sqrt{4-(y+1)^{2}}}_{{g}_{2}(y)}.\n$$\n\nSo, statement “${g}_{1}(y)=-\\sqrt{4-(y+1)^{2}}$ and ${g}_{2}(y)=\\sqrt{4-(y+1)^{2}}$” is true.\n\n**Step 3.** We find the bounds for $y.$ From the diagram, $y$ is bounded *below* by $y=-3$ and bounded *above* by $y=1.$ Therefore,\n\n$$\n\\underbrace{-3}_{a}\\le y\\le \\underbrace{1}_{b}.\n$$\n\nSo, statement “$a=1$ and $b=2$” is false.\n\nFinally, the correct answer is “${g}_{1}(y)=-\\sqrt{4-(y+1)^{2}}$ and ${g}_{2}(y)=\\sqrt{4-(y+1)^{2}}$” only."} {:db/id #edb/ref 17592186278403 :knowledge-point/_questions [{:db/id #edb/ref 17592186133818 :knowledge-point/id #uuid "4c05d4f9-eb1b-59a1-ae0b-5d6869bad7c5" :knowledge-point/title "Describing Type I Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dcc3ead-a5eb-59d5-b395-84368e02a2fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449904} {:answer/id #uuid "552b29d1-81b4-522d-a1e5-9344bd4cad3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449905}] :answer-field/correct {:answer/id #uuid "552b29d1-81b4-522d-a1e5-9344bd4cad3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449905} :answer-field/id #uuid "91461d3a-7bce-5e80-91c1-dce4ac1cc87d" :answer-field/key "$\\begin{gathered}D=\\left\\{\\begin{gathered}(x,y)\\,:\\\\\\,(x-1)^{2}+(y-1)^{2}\\le 4\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450906} {:answer-field/choices [{:answer/id #uuid "a02cc7a9-2caf-5794-bb5c-7df397d6341f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449906} {:answer/id #uuid "69bf2c68-8883-5ae2-9be1-422c63c83c1f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449907}] :answer-field/correct {:answer/id #uuid "a02cc7a9-2caf-5794-bb5c-7df397d6341f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449906} :answer-field/id #uuid "2c9d4940-8b58-5e01-be4b-3c772cf8c4ce" :answer-field/key "$D={(x,y)\\,:\\,{x}^{2}+{y}^{2}\\le 2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450907} {:answer-field/choices [{:answer/id #uuid "17d163fe-da7f-55c1-99a3-81e1b07d0123" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449908} {:answer/id #uuid "c4b0d5a4-2df0-5a30-9edb-eaa989bafb4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449909}] :answer-field/correct {:answer/id #uuid "17d163fe-da7f-55c1-99a3-81e1b07d0123" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449908} :answer-field/id #uuid "d3ab31af-0692-56bd-b3dc-792901c29841" :answer-field/key "${f}_{1}(x,y)=8-{x}^{2}-{y}^{2}$ and ${f}_{2}(x,y)=-2x-2y+6$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450908}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e71e8fdb-04f6-527e-89b1-2171dc56e3a9" :question/math-academy-id "q-161160" :question/problem "The region $R$ is bounded between the elliptic paraboloid $z=8-{x}^{2}-{y}^{2}$ and the plane $z=-2x-2y+6.$ Given its representation\n\n$$\nR={(x,y,z)\\,:\\,(x,y)\\in D,\\,{f}_{1}(x,y)\\le z\\le {f}_{2}(x,y)}\n$$\n\nas a type I region in three-dimensional space, which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A typical three-dimensional type I region can be visualized schematically, as shown below.\n\n![](images/05/05f940e247c6cd5d862d81fc3a34658353bef5513dfe862bbc67a120c0345838.png)\n\n \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement $\\begin{gathered}D=\\left\\{\\begin{gathered}(x,y)\\,:\\\\\\,(x-1)^{2}+(y-1)^{2}\\le 4\\end{gathered}\\right\\}\\end{gathered}$ is true, while statement $D={(x,y)\\,:\\,{x}^{2}+{y}^{2}\\le 2}$ is false. \n\nFirst, we find the projection of the intersection between the elliptic paraboloid $z=8-{x}^{2}-{y}^{2}$ and the plane $z=-2x-2y+6$ onto $xy$-plane. \n\nNotice that the equation of the plane is already solved for $z.$ Substituting this expression for $z$ into the equation of the paraboloid, we obtain:\n\n$$\n\\begin{aligned}-2x-2y+6 & =8-{x}^{2}-{y}^{2} \\\\ {x}^{2}-2x+{y}^{2}-2y & =2 \\\\ ({x}^{2}-2x+1)+({y}^{2}-2y+1) & =4 \\\\ (x-1)^{2}+(y-1)^{2} & =4\\end{aligned}\n$$\n\n \nSo, the projection of the intersection is the circle $(x-1)^{2}+(y-1)^{2}=4$ centered at $(1,1)$ in the $xy$-plane. Hence, the domain $D$ is given by the following disc:\n\n$$\nD={(x,y)\\,:\\,(x-1)^{2}+(y-1)^{2}\\le 4}\n$$\n\n- Statement “${f}_{1}(x,y)=8-{x}^{2}-{y}^{2}$ and ${f}_{2}(x,y)=-2x-2y+6$” is false. We have that $z$ is \n\n- bounded *below* by ${f}_{1}(x,y)=-2x-2y+6,$ and\n\n- bounded *above* by ${f}_{2}(x,y)=8-{x}^{2}-{y}^{2}.$\n\nTherefore, the correct answer is $\\begin{gathered}D=\\left\\{\\begin{gathered}(x,y)\\,:\\\\\\,(x-1)^{2}+(y-1)^{2}\\le 4\\end{gathered}\\right\\}\\end{gathered}$ only."} {:db/id #edb/ref 17592186278415 :knowledge-point/_questions [{:db/id #edb/ref 17592186133820 :knowledge-point/id #uuid "7dea8612-414c-5394-869d-1e404b048156" :knowledge-point/title "Describing Type III Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a794a4f8-da20-5971-8a90-3a6d7680175b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449910} {:answer/id #uuid "0ddc61b0-b1b8-57ae-a1f6-e691bde0a52e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449911}] :answer-field/correct {:answer/id #uuid "a794a4f8-da20-5971-8a90-3a6d7680175b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449910} :answer-field/id #uuid "be1dc7db-5a90-5ac6-b16c-3476af279190" :answer-field/key "$D={(x,z)\\,:\\,(2x-1)^{2}+{z}^{2}\\le 1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450909} {:answer-field/choices [{:answer/id #uuid "16ab18d4-5add-53fc-a4f1-49309f43d817" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449912} {:answer/id #uuid "8ef13aae-9d06-55e8-aa97-0b13a4e8888e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449913}] :answer-field/correct {:answer/id #uuid "8ef13aae-9d06-55e8-aa97-0b13a4e8888e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449913} :answer-field/id #uuid "5d1f0558-c605-5b82-8cc6-62553a4e58a7" :answer-field/key "$D={(x,z)\\,:\\,2{x}^{2}+(z-1)^{2}\\le 2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450910} {:answer-field/choices [{:answer/id #uuid "089b8d5f-df8d-5f82-b2b6-069b93905ae5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449914} {:answer/id #uuid "85696183-ea90-5370-a383-c83e17dff64c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449915}] :answer-field/correct {:answer/id #uuid "85696183-ea90-5370-a383-c83e17dff64c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449915} :answer-field/id #uuid "895d4087-1996-5d9e-a521-0e3cb5ce834c" :answer-field/key "${f}_{1}(x,z)=2{x}^{2}+{z}^{2}$ and ${f}_{2}(x,z)=2z+1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450911}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ae22adfc-61f1-5211-b117-6cf267aa0468" :question/math-academy-id "q-161190" :question/problem "The region $R$ is bounded between the elliptic paraboloid $y=2{x}^{2}+{z}^{2}$ and the plane $y=2z+1.$ Given its representation \n\n$$\nR={(x,y,z)\\,:\\,(x,z)\\in D,\\,{f}_{1}(x,z)\\le y\\le {f}_{2}(x,z)}\n$$\n\nas a type III region in three-dimensional space, which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A typical three-dimensional type III region can be visualized schematically, as shown below.\n\n![](images/c3/c3333ded3e00e7d7408f0dbd37807f1adec0301691cc6311871bfea6d7b9fa15.png)\n\n \nWith that in mind, let's examine our statements in turn.\n\n- Statement $D={(x,z)\\,:\\,(2x-1)^{2}+{z}^{2}\\le 1}$ is false, while statement $D={(x,z)\\,:\\,2{x}^{2}+(z-1)^{2}\\le 2}$ is true. First, we find the projection of the intersection between the elliptic paraboloid $y=2{x}^{2}+{z}^{2}$ and the plane $y=2z+1$ onto $xz$-plane.\n\nNotice that the equation of the plane is already solved for $y.$ Substituting this expression for $y$ into the equation of the paraboloid, we obtain:\n\n$$\n\\begin{aligned}2z+1 & =2{x}^{2}+{z}^{2} \\\\ 2{x}^{2}+{z}^{2}-2z-1 & =0 \\\\ 2{x}^{2}+({z}^{2}-2z+1) & =2 \\\\ 2{x}^{2}+(z-1)^{2} & =2\\end{aligned}\n$$\n\n \nSo, the projection of the intersection is the ellipse $2{x}^{2}+(z-1)^{2}=1$ centered at $(0,1)$ in the $xz$-plane. Hence, the domain $D$ is given by the interior part of the following ellipse:\n\n$$\nD={(x,z)\\,:\\,2{x}^{2}+(z-1)^{2}\\le 2}\n$$\n\n- Statement “${f}_{1}(x,z)=2{x}^{2}+{z}^{2}$ and ${f}_{2}(x,z)=2z+1$” is true. We have that $y$ is\n\n- bounded *below* by ${f}_{1}(x,z)=2{x}^{2}+{z}^{2}$, and\n\n- bounded *above* by ${f}_{2}(x,z)=2z+1.$\n\nTherefore, the correct answer is $D={(x,z)\\,:\\,2{x}^{2}+(z-1)^{2}\\le 2}$; “${f}_{1}(x,z)=2{x}^{2}+{z}^{2}$ and ${f}_{2}(x,z)=2z+1$” only."} {:db/id #edb/ref 17592186278433 :knowledge-point/_questions [{:db/id #edb/ref 17592186133820 :knowledge-point/id #uuid "7dea8612-414c-5394-869d-1e404b048156" :knowledge-point/title "Describing Type III Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0fdc915-2f4f-5be8-ace6-d347fb2f4865" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449916} {:answer/id #uuid "e00ae6d8-020c-528c-ba04-246cf66b857e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449917}] :answer-field/correct {:answer/id #uuid "e00ae6d8-020c-528c-ba04-246cf66b857e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449917} :answer-field/id #uuid "260c3d22-1e9f-5906-9107-1b9c02819237" :answer-field/key "$D={(x,z)\\,:\\,3{x}^{2}+(z+1)^{2}\\le 3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450912} {:answer-field/choices [{:answer/id #uuid "e17f328e-2edb-5810-9d94-d51cf2a49790" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449918} {:answer/id #uuid "b8cc3cc6-e5f0-5f92-b79b-c43f1acec5ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449919}] :answer-field/correct {:answer/id #uuid "e17f328e-2edb-5810-9d94-d51cf2a49790" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449918} :answer-field/id #uuid "77a70ca3-7a52-5b13-9518-39bf41505ce8" :answer-field/key "$D={(x,z)\\,:\\,{x}^{2}+(z+1)^{2}\\le 2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450913} {:answer-field/choices [{:answer/id #uuid "0874913e-527d-5ba6-9f78-dfdcb226fe66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449920} {:answer/id #uuid "36b546ec-cfc7-5682-84a0-926cc25d8896" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449921}] :answer-field/correct {:answer/id #uuid "36b546ec-cfc7-5682-84a0-926cc25d8896" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449921} :answer-field/id #uuid "b416ad05-b4e0-5f61-b941-be8dbb99929c" :answer-field/key "${f}_{1}(x,z)=2{x}^{2}+2z-1$ and ${f}_{2}(x,z)=-{x}^{2}-{z}^{2}+1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450914}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d04b955c-6599-5f09-8a8d-748ca0ca3061" :question/math-academy-id "q-161225" :question/problem "The region $R$ is bounded between the elliptic paraboloid $y=-{x}^{2}-{z}^{2}+1$ and the parabolic cylinder $y=2{x}^{2}+2z-1.$ Given its representation \n\n$$\nR={(x,y,z)\\,:\\,(x,z)\\in D,\\,{f}_{1}(x,z)\\le y\\le {f}_{2}(x,z)}\n$$\n\nas a type III region in three-dimensional space, which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A typical three-dimensional type III region can be visualized schematically, as shown below.\n\n![](images/c3/c3333ded3e00e7d7408f0dbd37807f1adec0301691cc6311871bfea6d7b9fa15.png)\n\n \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement $D={(x,z)\\,:\\,3{x}^{2}+(z+1)^{2}\\le 3}$ is true, while statement $D={(x,z)\\,:\\,{x}^{2}+(z+1)^{2}\\le 2}$ is false. First, we find the projection of the intersection between the elliptic paraboloid $y=-{x}^{2}-{z}^{2}+1$ and the parabolic cylinder $y=2{x}^{2}+2z-1$ onto $xz$-plane.\n\nNotice that the equations are already solved for $y.$ Equating the two expressions, we obtain:\n\n$$\n\\begin{aligned}-{x}^{2}-{z}^{2}+1 & =2{x}^{2}+2z-1 \\\\ 3{x}^{2}+{z}^{2}+2z-2 & =0 \\\\ 3{x}^{2}+({z}^{2}+2z+1) & =3 \\\\ 3{x}^{2}+(z+1)^{2} & =3\\end{aligned}\n$$\n\n \nSo, the projection of the intersection is the ellipse $3{x}^{2}+(z+1)^{2}=1$ centered at $(0,-1)$ in the $xz$-plane. Hence, the domain $D$ is given by the interior part of the ellipse:\n\n$$\nD={(x,z)\\,:\\,3{x}^{2}+(z+1)^{2}\\le 3}\n$$\n\n- Statement “${f}_{1}(x,z)=2{x}^{2}+2z-1$ and ${f}_{2}(x,z)=-{x}^{2}-{z}^{2}+1$” is true. We have that $y$ is\n\n- bounded *below* by ${f}_{1}(x,z)=2{x}^{2}+2z-1$, and\n\n- bounded *above* by ${f}_{2}(x,z)=-{x}^{2}-{z}^{2}+1.$\n\nTherefore, the correct answer is $D={(x,z)\\,:\\,3{x}^{2}+(z+1)^{2}\\le 3}$; “${f}_{1}(x,z)=2{x}^{2}+2z-1$ and ${f}_{2}(x,z)=-{x}^{2}-{z}^{2}+1$” only."} {:db/id #edb/ref 17592186278434 :knowledge-point/_questions [{:db/id #edb/ref 17592186133820 :knowledge-point/id #uuid "7dea8612-414c-5394-869d-1e404b048156" :knowledge-point/title "Describing Type III Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4f131be-9aa0-5bc3-ae76-2eb8786f9d33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449922} {:answer/id #uuid "e797117f-70c6-557d-bd1e-cbb4972747af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449923}] :answer-field/correct {:answer/id #uuid "e797117f-70c6-557d-bd1e-cbb4972747af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449923} :answer-field/id #uuid "e5069733-839b-5a49-a7a9-a29335ca99a8" :answer-field/key "${f}_{1}(x,z)=2{x}^{2}+2z-1$ and ${f}_{2}(x,z)=-{x}^{2}-{z}^{2}+1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450915} {:answer-field/choices [{:answer/id #uuid "fff03229-c2a9-50c3-be3d-bed8ece6abe2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449924} {:answer/id #uuid "15c7ceb4-b34d-5bbe-8b3d-91c9440e5a01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449925}] :answer-field/correct {:answer/id #uuid "fff03229-c2a9-50c3-be3d-bed8ece6abe2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449924} :answer-field/id #uuid "fb73a07c-0a5e-50a2-a801-7db3e31249e5" :answer-field/key "${g}_{1}(x)=-\\sqrt{3-3{x}^{2}}$ and ${g}_{2}(x)=\\sqrt{3-3{x}^{2}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450916} {:answer-field/choices [{:answer/id #uuid "be2629f8-d736-527c-8142-c79651c88560" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449926} {:answer/id #uuid "6d74fb52-0df1-54d2-9b79-aac32987bb61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449927}] :answer-field/correct {:answer/id #uuid "be2629f8-d736-527c-8142-c79651c88560" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449926} :answer-field/id #uuid "5c60454e-8a50-5bb0-a967-d107eee3f120" :answer-field/key "$a=0$ and $b=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450917}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2955e9f2-2674-539d-b301-d0ca76c12950" :question/math-academy-id "q-161227" :question/problem "The region $R$ is bounded between the elliptic paraboloid $y=-{x}^{2}-{z}^{2}+1$ and the parabolic cylinder $y=2{x}^{2}+2z-1.$ Given its representation \n\n$$\nR={(x,y,z)\\,:\\,a\\le x\\le b,\\,{g}_{1}(x)\\le z\\le {g}_{2}(x),\\,{f}_{1}(x,z)\\le y\\le {f}_{2}(x,z)}\n$$\n\nas a type III region in three-dimensional space, which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A typical three-dimensional type III region can be visualized schematically, as shown below.\n\n![](images/c3/c3333ded3e00e7d7408f0dbd37807f1adec0301691cc6311871bfea6d7b9fa15.png)\n\n \n\nLet's find a type III representation of our region.\n\n**Step 1.** We start by finding the surfaces ${f}_{1}(x,z)$ and ${f}_{2}(x,z).$ Since all $y$ in the region are bounded *below* by $y=2{x}^{2}+2z-1$ and *above* by $y=-{x}^{2}-{z}^{2}+1,$ we have\n\n$$\n\\underbrace{2{x}^{2}+2z-1}_{{f}_{1}(x,z)}\\le y\\le \\underbrace{-{x}^{2}-{z}^{2}+1}_{{f}_{2}(x,z)}.\n$$\n\nSo, statement “${f}_{1}(x,z)=2{x}^{2}+2z-1$ and ${f}_{2}(x,z)=-{x}^{2}-{z}^{2}+1$” is true.\n\n**Step 2.** We find the projection of the intersection between the elliptic paraboloid $y=-{x}^{2}-{z}^{2}+1$ and the parabolic cylinder $y=2{x}^{2}+2z-1$ onto $xz$-plane.\n\nNotice that the equations are already solved for $y.$ Equating the two expressions, we obtain: \n\n$$\n\\begin{aligned}-{x}^{2}-{z}^{2}+1 & =2{x}^{2}+2z-1 \\\\ 3{x}^{2}+{z}^{2}+2z-2 & =0 \\\\ 3{x}^{2}+({z}^{2}+2z+1) & =3 \\\\ 3{x}^{2}+(z+1)^{2} & =3\\end{aligned}\n$$\n\n \n\nSo, the projection of the intersection is the ellipse $3{x}^{2}+(z+1)^{2}=3$ centered at $(0,-1)$ in the $xz$-plane. \n\n![](images/86/868fceefed2a426feebe2a9199279826aaee935963fec8fa3761b17b97542c34.png)\n\nThe region is bounded *below* by $z=-1-\\sqrt{3-3{x}^{2}}$ and bounded *above* by $z=-1+\\sqrt{3-3{x}^{2}}.$ Therefore,\n\n$$\n\\underbrace{-1-\\sqrt{3-3{x}^{2}}}_{{g}_{1}(x)}\\le z\\le \\underbrace{-1+\\sqrt{3-3{x}^{2}}}_{{g}_{2}(x)}.\n$$\n\nSo, statement “${g}_{1}(x)=-\\sqrt{3-3{x}^{2}}$ and ${g}_{2}(x)=\\sqrt{3-3{x}^{2}}$” is false.\n\n**Step 3.** We find the bounds for $x.$ From the diagram, $x$ is bounded *below* by $x=-1$ and bounded *above* by $x=1.$ Therefore,\n\n$$\n\\underbrace{-1}_{a}\\le x\\le \\underbrace{1}_{b}.\n$$\n\nSo, statement “$a=0$ and $b=1$” is false.\n\nFinally, the correct answer is “${f}_{1}(x,z)=2{x}^{2}+2z-1$ and ${f}_{2}(x,z)=-{x}^{2}-{z}^{2}+1$” only."} {:db/id #edb/ref 17592186278444 :knowledge-point/_questions [{:db/id #edb/ref 17592186133819 :knowledge-point/id #uuid "7dcc1bf5-5eea-5615-8b16-b8ced5de7984" :knowledge-point/title "Describing Type II Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25a5de68-5950-514f-9ba1-08fa9d4299ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465387} {:answer/id #uuid "99ded4e4-29f1-558a-9986-b3ec79c00a35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465388}] :answer-field/correct {:answer/id #uuid "99ded4e4-29f1-558a-9986-b3ec79c00a35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465388} :answer-field/id #uuid "fcb986ee-74d8-55e7-ace6-4c46cc82d2fa" :answer-field/key "$\\begin{gathered}D=\\left\\{\\begin{gathered}(y,z)\\,:\\\\\\,0\\le y\\le 3,\\\\\\,0\\le z\\le 2\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466537} {:answer-field/choices [{:answer/id #uuid "805d79bd-85e2-5be6-930c-9af401f32ec5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465389} {:answer/id #uuid "9fc276e3-6d65-585e-9956-fe2637e49b11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465390}] :answer-field/correct {:answer/id #uuid "805d79bd-85e2-5be6-930c-9af401f32ec5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465389} :answer-field/id #uuid "845a991c-16c1-5dca-bbbc-d4f135e22f63" :answer-field/key "${f}_{1}(y,z)=0$ and ${f}_{2}(y,z)=2-y-z$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466538} {:answer-field/choices [{:answer/id #uuid "e54cac66-bf9d-526e-b2f2-c9397de7dc54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465391} {:answer/id #uuid "328852b4-a1a4-578a-9f26-a0109eec8aa2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465392}] :answer-field/correct {:answer/id #uuid "e54cac66-bf9d-526e-b2f2-c9397de7dc54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465391} :answer-field/id #uuid "e14d9582-0fba-5cac-a562-27db433f61d6" :answer-field/key "${f}_{1}(y,z)=2+y-z$ and ${f}_{2}(y,z)=5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466539}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "83e332b2-7a45-565f-946e-09fe8f179dcb" :question/math-academy-id "q-161247" :question/problem "![](images/60/60f622b161dbfb4da1d18e85d3eb3ab4e02c2af418f9845e05a3bf9704a28006.png)\n\nThe region $R$ is bounded by the planes $y=0$, $y=3$, $z=0$, $z=2$, $x=0,$ and $x=2+y-z.$ Given its representation \n\n$$\nR={(x,y,z)\\,:\\,(y,z)\\in D,\\,{f}_{1}(y,z)\\le x\\le {f}_{2}(y,z)}\n$$\n\nas a type II region in three-dimensional space, which of the following statements are true?\n\nSelect all that apply.\n\nIf none apply, leave all boxes unchecked." :question/worked-solution "A typical three-dimensional type II region can be visualized schematically, as shown below.\n\n![](images/e4/e4c9cbbad2f13e9cc125ddbb89125ed2d734eee3f80737125961f4af1846a972.png)\n\n \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement $\\begin{gathered}D=\\left\\{\\begin{gathered}(y,z)\\,:\\\\\\,0\\le y\\le 3,\\\\\\,0\\le z\\le 2\\end{gathered}\\right\\}\\end{gathered}$ is true. The projection $D$ of the solid onto the $yz$-plane gives the domain \n\n$$\nD={(y,z)\\,:\\,0\\le y\\le 3,\\,0\\le z\\le 2}.\n$$\n\n- Statements “${f}_{1}(y,z)=0$ and ${f}_{2}(y,z)=2-y-z$” and “${f}_{1}(y,z)=2+y-z$ and ${f}_{2}(y,z)=5$” are false. We have\n\n- the *back* surface $x={f}_{1}(y,z)=0$, and\n\n- the *front* surface $x={f}_{2}(y,z)=2+y-z.$\n\n![](images/c2/c2af4029bd979d250ed15f351ef7f14d3ae688806db4ffec199a24b3591dadac.png)\n\n \n\nTherefore, the correct answer is $\\begin{gathered}D=\\left\\{\\begin{gathered}(y,z)\\,:\\\\\\,0\\le y\\le 3,\\\\\\,0\\le z\\le 2\\end{gathered}\\right\\}\\end{gathered}$ only."} {:db/id #edb/ref 17592186278445 :knowledge-point/_questions [{:db/id #edb/ref 17592186133820 :knowledge-point/id #uuid "7dea8612-414c-5394-869d-1e404b048156" :knowledge-point/title "Describing Type III Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b46cd556-9148-553e-a9ee-002da12838f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465393} {:answer/id #uuid "c81a3b20-2fa7-53cf-ba24-e30a9d7def19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465394}] :answer-field/correct {:answer/id #uuid "c81a3b20-2fa7-53cf-ba24-e30a9d7def19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465394} :answer-field/id #uuid "8e938ae3-f27b-5e0d-93f6-fd7f5fbab6cf" :answer-field/key "$\\begin{gathered}D=\\left\\{\\begin{gathered}(x,z)\\,:\\\\\\,0\\le x\\le 1,\\\\\\,0\\le z\\le 3\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466540} {:answer-field/choices [{:answer/id #uuid "1f9e2552-d78f-5856-897c-1066c7c11370" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465395} {:answer/id #uuid "8e4fa949-854b-5ee7-8b85-75ab00ce9a7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465396}] :answer-field/correct {:answer/id #uuid "8e4fa949-854b-5ee7-8b85-75ab00ce9a7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465396} :answer-field/id #uuid "2ca3abf8-142e-5260-aec2-6a593434d8f3" :answer-field/key "${f}_{1}(x,z)=0$ and ${f}_{2}(x,z)=4-z$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466541} {:answer-field/choices [{:answer/id #uuid "f2305890-a995-5d60-b9bd-dda89a17580d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465397} {:answer/id #uuid "85d5eb5f-70d4-55e0-9577-81a9d91ad5e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465398}] :answer-field/correct {:answer/id #uuid "f2305890-a995-5d60-b9bd-dda89a17580d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465397} :answer-field/id #uuid "d0610e88-6eb9-5b63-8129-a7376026d04c" :answer-field/key "${f}_{1}(x,z)=4-z$ and ${f}_{2}(x,z)=4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466542}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8d0077c3-5809-5281-a04f-def492b7900c" :question/math-academy-id "q-161248" :question/problem "![](images/40/40091bf7a66577a4a3f3b8cdf3b5da34cbe0e0198fdc5731c6d3dae8cb727418.png)\n\nThe region $R$ is bounded by the planes $x=0$, $x=1$, $z=0$, $z=3$, $y=0,$ and $y=4-z.$ Given its representation \n\n$$\nR={(x,y,z)\\,:\\,(x,z)\\in D,\\,{f}_{1}(x,z)\\le y\\le {f}_{2}(x,z)}\n$$\n\nas a type III region in three-dimensional space, which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A typical three-dimensional type III region can be visualized schematically, as shown below.\n\n![](images/c3/c3333ded3e00e7d7408f0dbd37807f1adec0301691cc6311871bfea6d7b9fa15.png)\n\n \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement $\\begin{gathered}D=\\left\\{\\begin{gathered}(x,z)\\,:\\\\\\,0\\le x\\le 1,\\\\\\,0\\le z\\le 3\\end{gathered}\\right\\}\\end{gathered}$ is true. The projection $D$ of the solid onto the $xz$-plane gives the domain \n\n$$\nD={(x,z)\\,:\\,0\\le x\\le 1,\\,0\\le z\\le 3}.\n$$\n\n- Statement “${f}_{1}(x,z)=0$ and ${f}_{2}(x,z)=4-z$” is true, while statement “${f}_{1}(x,z)=4-z$ and ${f}_{2}(x,z)=4$” is false. We have\n\n- the *left* surface $y={f}_{1}(x,z)=0$, and\n\n- the *right* surface $y={f}_{2}(x,z)=4-z.$\n\n![](images/b1/b1046e312a3783dfc3253646f8a71ae226a173ac882a6305850bdd81aed9dd7e.png)\n\n \n\nTherefore, the correct answer is $\\begin{gathered}D=\\left\\{\\begin{gathered}(x,z)\\,:\\\\\\,0\\le x\\le 1,\\\\\\,0\\le z\\le 3\\end{gathered}\\right\\}\\end{gathered}$; “${f}_{1}(x,z)=0$ and ${f}_{2}(x,z)=4-z$” only."} {:db/id #edb/ref 17592186278447 :knowledge-point/_questions [{:db/id #edb/ref 17592186133820 :knowledge-point/id #uuid "7dea8612-414c-5394-869d-1e404b048156" :knowledge-point/title "Describing Type III Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87947aba-3ee6-5f0b-b3c6-cd6a066bd244" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465399} {:answer/id #uuid "97174b7f-38ab-52ee-b9d8-8cb8b66d0e1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465400}] :answer-field/correct {:answer/id #uuid "97174b7f-38ab-52ee-b9d8-8cb8b66d0e1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465400} :answer-field/id #uuid "4b5ae30f-59ec-58d7-a15c-4249798540d9" :answer-field/key "$\\begin{gathered}D=\\left\\{\\begin{gathered}(x,z)\\,:\\\\\\,0\\le x\\le 3,\\\\\\,0\\le z\\le 2\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466543} {:answer-field/choices [{:answer/id #uuid "2c1ea4a1-1147-5bfc-8507-1bf0d77960ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465401} {:answer/id #uuid "f84ca98d-56b9-5e97-bfb2-dff3175e39ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465402}] :answer-field/correct {:answer/id #uuid "2c1ea4a1-1147-5bfc-8507-1bf0d77960ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465401} :answer-field/id #uuid "73340b15-0013-5823-988c-a3ba50461d3c" :answer-field/key "${f}_{1}(x,z)=z-\\frac{x}{3}$ and ${f}_{2}(x,z)=3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466544} {:answer-field/choices [{:answer/id #uuid "eae65db7-54ff-596a-b1e0-2327b0ecaba1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465403} {:answer/id #uuid "23d0f29c-f34b-599c-8760-32746cd6d595" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465404}] :answer-field/correct {:answer/id #uuid "23d0f29c-f34b-599c-8760-32746cd6d595" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465404} :answer-field/id #uuid "1cb2eb83-9dd5-5fd0-a343-cff27dd76ab1" :answer-field/key "${f}_{1}(x,z)=0$ and ${f}_{2}(x,z)=3+\\frac{x}{3}-z$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466545}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9bbc7b8c-0af0-5315-ba58-db2c9cd43206" :question/math-academy-id "q-161250" :question/problem "![](images/d4/d447e5a00aa324d83a3f513db11ff677fd2db2c7b1b33d8bc2bcfa73b4a08f3f.png)\n\nThe region $R$ is bounded by the planes $x=0$, $x=3$, $z=0$, $z=2$, $y=0,$ and $y=3+\\frac{x}{3}-z.$ Given its representation \n\n$$\nR={(x,y,z)\\,:\\,(x,z)\\in D,\\,{f}_{1}(x,z)\\le y\\le {f}_{2}(x,z)}\n$$\n\nas a type III region in three-dimensional space, which of the following statements are true?\n\nSelect all that apply.\n\nIf none apply, leave all boxes unchecked." :question/worked-solution "A typical three-dimensional type III region can be visualized schematically, as shown below.\n\n![](images/c3/c3333ded3e00e7d7408f0dbd37807f1adec0301691cc6311871bfea6d7b9fa15.png)\n\n \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement $\\begin{gathered}D=\\left\\{\\begin{gathered}(x,z)\\,:\\\\\\,0\\le x\\le 3,\\\\\\,0\\le z\\le 2\\end{gathered}\\right\\}\\end{gathered}$ is true. The projection $D$ of the solid onto the $xz$-plane gives the domain \n\n$$\nD={(x,z)\\,:\\,0\\le x\\le 3,\\,0\\le z\\le 2}.\n$$\n\n- Statement “${f}_{1}(x,z)=z-\\frac{x}{3}$ and ${f}_{2}(x,z)=3$” is false, while statement “${f}_{1}(x,z)=0$ and ${f}_{2}(x,z)=3+\\frac{x}{3}-z$” is true. We have\n\n- the *left* surface $y={f}_{1}(x,z)=0$, and\n\n- the *right* surface $y={f}_{2}(x,z)=3+\\frac{x}{3}-z.$\n\n![](images/88/88b5fde383f094436dd94adefa7912f1a194319739fdb0b8a6a9a74693362219.png)\n\n \n\nTherefore, the correct answer is $\\begin{gathered}D=\\left\\{\\begin{gathered}(x,z)\\,:\\\\\\,0\\le x\\le 3,\\\\\\,0\\le z\\le 2\\end{gathered}\\right\\}\\end{gathered}$; “${f}_{1}(x,z)=0$ and ${f}_{2}(x,z)=3+\\frac{x}{3}-z$” only."} {:db/id #edb/ref 17592186278496 :knowledge-point/_questions [{:db/id #edb/ref 17592186133819 :knowledge-point/id #uuid "7dcc1bf5-5eea-5615-8b16-b8ced5de7984" :knowledge-point/title "Describing Type II Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "057db65a-eecb-52c7-ac69-c8a69baf0264" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465405} {:answer/id #uuid "4640f754-7b8a-5863-a4a7-4984c1ec21a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465406}] :answer-field/correct {:answer/id #uuid "4640f754-7b8a-5863-a4a7-4984c1ec21a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465406} :answer-field/id #uuid "ca4918c6-67e4-5f19-84fb-a1e03896cf0d" :answer-field/key "$\\begin{gathered}D=\\left\\{\\begin{gathered}(y,z)\\,:\\\\\\,0\\le y\\le 4,\\\\\\,0\\le z\\le 3\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466546} {:answer-field/choices [{:answer/id #uuid "25c8e774-2be1-50a4-be88-195ee7a64ff9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465407} {:answer/id #uuid "450f49eb-7a8d-5ee5-80f1-0b4c034f20a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465408}] :answer-field/correct {:answer/id #uuid "450f49eb-7a8d-5ee5-80f1-0b4c034f20a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465408} :answer-field/id #uuid "bed649e4-9512-5df5-8690-508a27d9b3e5" :answer-field/key "${f}_{1}(y,z)=0$ and ${f}_{2}(y,z)=4-y+2z$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466547} {:answer-field/choices [{:answer/id #uuid "906a29e2-7f19-5c43-bd9f-25622a39d650" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465409} {:answer/id #uuid "b1856245-617f-5aa9-b2a6-f6ea110eeb7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465410}] :answer-field/correct {:answer/id #uuid "906a29e2-7f19-5c43-bd9f-25622a39d650" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465409} :answer-field/id #uuid "c51647d3-edd0-55aa-b2d7-68154b9214d2" :answer-field/key "${f}_{1}(y,z)=4+y-2z$ and ${f}_{2}(y,z)=4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466548}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "59f1a985-1f99-5d8b-a66e-0643cac8da20" :question/math-academy-id "q-161361" :question/problem "![](images/f7/f7799ca5801bf019fc5b884590575346a8f298f8e9c91056c13a60c4dd23742d.png)\n\nThe region $R$ is bounded by the planes $y=0$, $y=4$, $z=0$, $z=3$, $x=0,$ and $x=4-y+2z.$ Given its representation \n\n$$\nR={(x,y,z)\\,:\\,(y,z)\\in D,\\,{f}_{1}(y,z)\\le x\\le {f}_{2}(y,z)}\n$$\n\nas a type II region in three-dimensional space, which of the following statements are true?\n\nSelect all that apply.\n\nIf none apply, leave all boxes unchecked." :question/worked-solution "A typical three-dimensional type II region can be visualized schematically, as shown below.\n\n![](images/e4/e4c9cbbad2f13e9cc125ddbb89125ed2d734eee3f80737125961f4af1846a972.png)\n\n \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement $\\begin{gathered}D=\\left\\{\\begin{gathered}(y,z)\\,:\\\\\\,0\\le y\\le 4,\\\\\\,0\\le z\\le 3\\end{gathered}\\right\\}\\end{gathered}$ is true. The projection $D$ of the solid onto the $yz$-plane gives the domain \n\n$$\nD={(y,z)\\,:\\,0\\le y\\le 4,\\,0\\le z\\le 3}.\n$$\n\n- Statement “${f}_{1}(y,z)=0$ and ${f}_{2}(y,z)=4-y+2z$” is true and statement “${f}_{1}(y,z)=4+y-2z$ and ${f}_{2}(y,z)=4$” is false. We have\n\n- the *back* surface $x={f}_{1}(y,z)=0$, and\n\n- the *front* surface $x={f}_{2}(y,z)=4-y+2z.$\n\n![](images/3b/3bf8e141067fb6f675933f52e465114d8909d951f6ac85fb09c8dda7efbc2f38.png)\n\n \n\nTherefore, the correct answer is $\\begin{gathered}D=\\left\\{\\begin{gathered}(y,z)\\,:\\\\\\,0\\le y\\le 4,\\\\\\,0\\le z\\le 3\\end{gathered}\\right\\}\\end{gathered}$; “${f}_{1}(y,z)=0$ and ${f}_{2}(y,z)=4-y+2z$” only."} {:db/id #edb/ref 17592186278505 :knowledge-point/_questions [{:db/id #edb/ref 17592186133819 :knowledge-point/id #uuid "7dcc1bf5-5eea-5615-8b16-b8ced5de7984" :knowledge-point/title "Describing Type II Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7d665b5-198a-55b9-8bf0-26a0989fd40d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449928} {:answer/id #uuid "1cc21ed5-3473-5160-9a7c-f60d49ba1004" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449929}] :answer-field/correct {:answer/id #uuid "a7d665b5-198a-55b9-8bf0-26a0989fd40d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449928} :answer-field/id #uuid "cf3cc37a-5965-531e-af36-32f1bfafcf65" :answer-field/key "$D={(y,z)\\,:\\,{y}^{2}+{z}^{2}\\le 1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450918} {:answer-field/choices [{:answer/id #uuid "f70b2733-9448-5ef8-9fed-f80eee91840f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449930} {:answer/id #uuid "b106c40c-33c4-5685-9951-2719c69fd8b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449931}] :answer-field/correct {:answer/id #uuid "b106c40c-33c4-5685-9951-2719c69fd8b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449931} :answer-field/id #uuid "fadb5115-6f6b-58f5-8341-276905f31336" :answer-field/key "$D={(y,z)\\,:\\,(y-1)^{2}+{z}^{2}\\le 1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450919} {:answer-field/choices [{:answer/id #uuid "23016ffc-39e9-5547-82ce-1b84aa5a0183" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449932} {:answer/id #uuid "92f2e35f-57e5-558a-885d-c46d619b49b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449933}] :answer-field/correct {:answer/id #uuid "92f2e35f-57e5-558a-885d-c46d619b49b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449933} :answer-field/id #uuid "26a23ac2-b6e0-583e-afa8-aef987afd7b2" :answer-field/key "${f}_{1}(y,z)=\\sqrt{{y}^{2}+{z}^{2}}$ and ${f}_{2}(y,z)=\\sqrt{2y}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450920}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "62e7d4a5-ede7-555e-89aa-1ccf67e4530f" :question/math-academy-id "q-161380" :question/problem "The region $R$ is bounded between the cone $x=\\sqrt{{y}^{2}+{z}^{2}}$ and the parabolic cylinder $x=\\sqrt{2y}.$ Given its representation \n\n$$\nR={(x,y,z)\\,:\\,(y,z)\\in D,\\,{f}_{1}(y,z)\\le x\\le {f}_{2}(y,z)}\n$$\n\nas a type II region in three-dimensional space, which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A typical three-dimensional region of type II can be visualized schematically, as shown below.\n\n![](images/98/98b9dc84e3d23d43c1fef204109d6f6b6c571d6f188592f1f08bb1abf4dc3641.png)\n\n \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement $D={(y,z)\\,:\\,{y}^{2}+{z}^{2}\\le 1}$ is false, and statement $D={(y,z)\\,:\\,(y-1)^{2}+{z}^{2}\\le 1}$ is true. \n\nFirst, we find the projection of the intersection between the cone $x=\\sqrt{{y}^{2}+{z}^{2}}$ and the paraboloid $x=\\sqrt{2y}$ onto $yz$-plane.\n\nNotice that the equation of the paraboloid is already solved for $x.$ Substituting this expression for $x$ into the equation of the cone, we obtain:\n\n$$\n\\begin{aligned}\\sqrt{{y}^{2}+{z}^{2}} & =\\sqrt{2y} \\\\ {y}^{2}+{z}^{2} & =2y \\\\ {y}^{2}-2y+{z}^{2} & =0 \\\\ {y}^{2}-2y+1+{z}^{2} & =1 \\\\ (y-1)^{2}+{z}^{2} & =1\\end{aligned}\n$$\n\n \nSo, the projection of the intersection is the circle $(y-1)^{2}+{z}^{2}=1$ centered at $(1,0)$ in the $yz$-plane. Hence, the domain $D$ is given by the following disc:\n\n$$\nD={(y,z)\\,:\\,(y-1)^{2}+{z}^{2}\\le 1}\n$$\n\n- Statement “${f}_{1}(y,z)=\\sqrt{{y}^{2}+{z}^{2}}$ and ${f}_{2}(y,z)=\\sqrt{2y}$” is true. We have that $x$ is\n\n- bounded *below* by ${f}_{1}(y,z)=\\sqrt{{y}^{2}+{z}^{2}},$ and\n\n- bounded *above* by ${f}_{2}(y,z)=\\sqrt{2y}.$\n\nTherefore, the correct answer is $D={(y,z)\\,:\\,(y-1)^{2}+{z}^{2}\\le 1}$; “${f}_{1}(y,z)=\\sqrt{{y}^{2}+{z}^{2}}$ and ${f}_{2}(y,z)=\\sqrt{2y}$” only."} {:db/id #edb/ref 17592186278508 :knowledge-point/_questions [{:db/id #edb/ref 17592186133819 :knowledge-point/id #uuid "7dcc1bf5-5eea-5615-8b16-b8ced5de7984" :knowledge-point/title "Describing Type II Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d47a24e-a556-5ced-ba9f-3c650813c6f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449934} {:answer/id #uuid "c8a9e2e0-aed2-5091-979e-21ff7c9eba24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449935}] :answer-field/correct {:answer/id #uuid "c8a9e2e0-aed2-5091-979e-21ff7c9eba24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449935} :answer-field/id #uuid "3e5d2a03-b9e9-5f0c-a3ec-d16a44ca37a2" :answer-field/key "${f}_{1}(y,z)=\\frac{1}{4}$ and ${f}_{2}(y,z)=\\frac{5}{4}-\\frac{{y}^{2}}{9}-\\frac{{z}^{2}}{16}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450921} {:answer-field/choices [{:answer/id #uuid "cee72eca-362e-5787-88b7-034467acdb24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449936} {:answer/id #uuid "43765983-0124-5795-a220-df09cf706cc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449937}] :answer-field/correct {:answer/id #uuid "cee72eca-362e-5787-88b7-034467acdb24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449936} :answer-field/id #uuid "c84360ce-bf39-55dc-bc78-8243b8db69d8" :answer-field/key "${g}_{1}(y)=-\\sqrt{1-\\frac{{y}^{2}}{9}}$ and ${g}_{2}(y)=\\sqrt{1-\\frac{{y}^{2}}{9}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450922} {:answer-field/choices [{:answer/id #uuid "15a0c394-f144-5433-850a-9baa59daa498" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449938} {:answer/id #uuid "0a7f24e0-7cfa-5706-831b-1bb82e855622" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449939}] :answer-field/correct {:answer/id #uuid "0a7f24e0-7cfa-5706-831b-1bb82e855622" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449939} :answer-field/id #uuid "f5938a9e-a410-5cc4-8d1d-82dada2ccbd0" :answer-field/key "$a=-3$ and $b=3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450923}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0a480e12-228f-5db7-81b6-a3f28cbc1181" :question/math-academy-id "q-161386" :question/problem "The region $R$ is bounded between  the elliptic paraboloid $x=\\frac{5}{4}-\\frac{{y}^{2}}{9}-\\frac{{z}^{2}}{16}$ and the plane $x=\\frac{1}{4}.$ Given its representation \n\n$$\nR={(x,y,z)\\,:\\,a\\le y\\le b,\\,{g}_{1}(y)\\le z\\le {g}_{2}(y),\\,{f}_{1}(y,z)\\le x\\le {f}_{2}(y,z)}\n$$\n\nas a type II region in three-dimensional space, which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A typical three-dimensional region of type II can be visualized schematically, as shown below.\n\n![](images/e4/e4c9cbbad2f13e9cc125ddbb89125ed2d734eee3f80737125961f4af1846a972.png)\n\n \n\nLet's find a type II representation of our region.\n\n**Step 1.** We start by finding the surfaces ${f}_{1}(y,z)$ and ${f}_{2}(y,z).$ Since all $x$ in the region are bounded *below* by $x=\\frac{1}{4}$ and *above* by $x=\\frac{5}{4}-\\frac{{y}^{2}}{9}-\\frac{{z}^{2}}{16},$ we have\n\n$$\n\\underbrace{\\frac{1}{4}}_{{f}_{1}(y,z)}\\le x\\le \\underbrace{\\frac{5}{4}-\\frac{{y}^{2}}{9}-\\frac{{z}^{2}}{16}}_{{f}_{2}(y,z)}.\n$$\n\nSo, statement “${f}_{1}(y,z)=\\frac{1}{4}$ and ${f}_{2}(y,z)=\\frac{5}{4}-\\frac{{y}^{2}}{9}-\\frac{{z}^{2}}{16}$” is true.\n\n**Step 2.** We find the projection of the intersection between the elliptic paraboloid $x=\\frac{5}{4}-\\frac{{y}^{2}}{9}-\\frac{{z}^{2}}{16}$ and the plane $x=\\frac{1}{4}$ onto the $yz$-plane.\n\nNotice that the equation of the plane is already solved for $x.$ Substituting this expression for $x$ into the equation of the paraboloid, we obtain: \n\n$$\n\\begin{aligned}\\frac{1}{4} & =\\frac{5}{4}-\\frac{{y}^{2}}{9}-\\frac{{z}^{2}}{16} \\\\ \\frac{{y}^{2}}{9}+\\frac{{z}^{2}}{16} & =1\\end{aligned}\n$$\n\n \n\nSo, the projection of the intersection is the ellipse $\\frac{{y}^{2}}{9}+\\frac{{z}^{2}}{16}=1$ centered at $(0,0)$ in the $yz$-plane. \n\n![](images/46/46757c2bf93af4916afbd019f0faed2eef25245e987acbeff7eafb3e0ca7cd8c.png)\n\nThe region is bounded *below* by $z=-4\\sqrt{1-\\frac{{y}^{2}}{9}}$ and bounded *above* by $z=4\\sqrt{1-\\frac{{y}^{2}}{9}}.$ Therefore,\n\n$$\n\\underbrace{-4\\sqrt{1-\\frac{{y}^{2}}{9}}}_{{g}_{1}(y)}\\le z\\le \\underbrace{4\\sqrt{1-\\frac{{y}^{2}}{9}}}_{{g}_{2}(y)}.\n$$\n\nSo, statement “${g}_{1}(y)=-\\sqrt{1-\\frac{{y}^{2}}{9}}$ and ${g}_{2}(y)=\\sqrt{1-\\frac{{y}^{2}}{9}}$” is false.\n\n**Step 3.** We find the bounds for $y.$ From the diagram, $y$ is bounded *below* by $y=-3$ and bounded *above* by $y=3.$ Therefore,\n\n$$\n\\underbrace{-3}_{a}\\le y\\le \\underbrace{3}_{b}.\n$$\n\nSo, statement “$a=-3$ and $b=3$” is true.\n\nFinally, the correct answer is “${f}_{1}(y,z)=\\frac{1}{4}$ and ${f}_{2}(y,z)=\\frac{5}{4}-\\frac{{y}^{2}}{9}-\\frac{{z}^{2}}{16}$”; “$a=-3$ and $b=3$” only."} {:db/id #edb/ref 17592186278571 :knowledge-point/_questions [{:db/id #edb/ref 17592186192786 :knowledge-point/id #uuid "a024c46e-0374-5d03-b895-eb754ff7ad97" :knowledge-point/title "Identifying True Statements Regarding Interiors and Boundaries of Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24d1e79b-e7fb-5978-8b61-317e3cdc2318" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449940} {:answer/id #uuid "bc77f129-c1ae-5fbc-bc29-dc39b9e0d483" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449941}] :answer-field/correct {:answer/id #uuid "bc77f129-c1ae-5fbc-bc29-dc39b9e0d483" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449941} :answer-field/id #uuid "6ad42456-eefd-513b-b1ff-1ddbbb8c3215" :answer-field/key "$A$ contains none of its boundary points." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450924} {:answer-field/choices [{:answer/id #uuid "0ee14783-2c54-554a-85a4-909bd52480c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449942} {:answer/id #uuid "57213e39-07f9-53b0-9e6a-2235cede2a82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449943}] :answer-field/correct {:answer/id #uuid "0ee14783-2c54-554a-85a4-909bd52480c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449942} :answer-field/id #uuid "43ad0e94-a683-565d-a041-fe8827a078c0" :answer-field/key "$A$ contains some (not all) of its boundary points." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450925} {:answer-field/choices [{:answer/id #uuid "1cdc4b8b-a4b8-5f63-9a52-137f8257c0db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449944} {:answer/id #uuid "ff06a87a-6dcf-5b24-936f-02500a3aa3ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449945}] :answer-field/correct {:answer/id #uuid "ff06a87a-6dcf-5b24-936f-02500a3aa3ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449945} :answer-field/id #uuid "b03afc6c-2900-515e-85f5-539a9b27b138" :answer-field/key "$\\text{int}\\,A=A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450926}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2307ae9e-a249-5090-bfed-df0660f7b0eb" :question/math-academy-id "q-161601" :question/problem "Consider the set $A,$ defined by \n\n$$\nA=\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+4{y}^{2}<36\\}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nIn this case, the set $A$ and its boundary $∂A$ are shown below.\n\n![](images/ff/ff1f735266f66879834e02ca7601e90e40dfa7929e5796d4a3f8cb4ff2828de7.png)\n\n  \n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nNotice that, in this case, the set $A$ contains none of its boundary points. \n\nWith that in mind, let's examine each statement:\n\n- Statement “$A$ contains none of its boundary points” is true, while statement “$A$ contains some (not all) of its boundary points” is false. As we've seen, $A$ contains none of its boundary points.\n\n- Statement $\\text{int}\\,A=A$ is true. Since $A$ contains none of its boundary points, we must have $\\text{int}\\,A=A.$\n\nTherefore, the correct answer is “$A$ contains none of its boundary points”; $\\text{int}\\,A=A$ only."} {:db/id #edb/ref 17592186278572 :knowledge-point/_questions [{:db/id #edb/ref 17592186192786 :knowledge-point/id #uuid "a024c46e-0374-5d03-b895-eb754ff7ad97" :knowledge-point/title "Identifying True Statements Regarding Interiors and Boundaries of Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be55a3c3-a14a-5616-b434-748a64016ec5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449946} {:answer/id #uuid "9b71986f-ed36-5a4e-9a5f-7dc9b8a49066" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449947}] :answer-field/correct {:answer/id #uuid "9b71986f-ed36-5a4e-9a5f-7dc9b8a49066" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449947} :answer-field/id #uuid "c0acb8a6-343b-54a7-9d7f-399cf2145053" :answer-field/key "$A$ contains all of its boundary points." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450927} {:answer-field/choices [{:answer/id #uuid "d69f8359-c7e9-5292-948c-328d26d2fcd4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449948} {:answer/id #uuid "947dbbdb-26b6-5c81-b11b-1ddb925d5b03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449949}] :answer-field/correct {:answer/id #uuid "d69f8359-c7e9-5292-948c-328d26d2fcd4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449948} :answer-field/id #uuid "7a149c98-887c-59d2-92f6-de50cb110a9c" :answer-field/key "$A$ contains none of its boundary points." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450928} {:answer-field/choices [{:answer/id #uuid "d9b547fe-4e7e-53cd-bca0-9119bfd32cd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449950} {:answer/id #uuid "69ad3907-4b5f-5519-bfd6-a21aa64633f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449951}] :answer-field/correct {:answer/id #uuid "d9b547fe-4e7e-53cd-bca0-9119bfd32cd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449950} :answer-field/id #uuid "ee22d64e-0f8b-5b04-928a-65a44a0afe68" :answer-field/key "$\\text{int}\\,A=A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450929}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4104ec23-658c-58b7-8dbf-72086dab259b" :question/math-academy-id "q-161622" :question/problem "Consider the set $A,$ defined by \n\n$$\nA={(x,y)\\in {R}^{2}\\,:\\,y\\ge -1+x}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nIn this case, the set $A$ and its boundary $∂A$ are shown below.\n\n![](images/3e/3e7d8c11ac4b3de8473741a362ad2b78555c764da2d61f955435e8d59771cf46.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nNotice that, in this case, the set $A$ contains all of its boundary points. \n\nWith that in mind, let's examine each statement:\n\n- Statement “$A$ contains all of its boundary points” is true, while statement “$A$ contains none of its boundary points” is false. As we've seen, $A$ contains all of its boundary points.\n\n- Statement $\\text{int}\\,A=A$ is false. Since $A$ contains all of its boundary points, we must have $A-∂A⊊A.$ Therefore $\\text{int}\\,A\\ne A.$\n\nTherefore, the correct answer is “$A$ contains all of its boundary points” only."} {:db/id #edb/ref 17592186278573 :knowledge-point/_questions [{:db/id #edb/ref 17592186192786 :knowledge-point/id #uuid "a024c46e-0374-5d03-b895-eb754ff7ad97" :knowledge-point/title "Identifying True Statements Regarding Interiors and Boundaries of Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34114c44-99df-5eb6-abf1-299e7f8a59e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449952} {:answer/id #uuid "a7a7d464-f27e-5816-910d-97e3198e8ac3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449953}] :answer-field/correct {:answer/id #uuid "34114c44-99df-5eb6-abf1-299e7f8a59e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449952} :answer-field/id #uuid "a8c5a9d2-ddb3-5ced-9423-63314912bd6c" :answer-field/key "$A$ contains none of its boundary points." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450930} {:answer-field/choices [{:answer/id #uuid "9d7ec702-57a1-5c3e-8b98-8dd92e48f1f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449954} {:answer/id #uuid "9b3e8b1f-44eb-5090-ac11-cc11a79bc546" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449955}] :answer-field/correct {:answer/id #uuid "9b3e8b1f-44eb-5090-ac11-cc11a79bc546" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449955} :answer-field/id #uuid "a05a88b2-59a5-5a9b-8d98-69da3d4daec3" :answer-field/key "$A$ contains some (not all) of its boundary points." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450931} {:answer-field/choices [{:answer/id #uuid "0d950cf8-fba5-5439-a346-fb6f6919aabb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449956} {:answer/id #uuid "f65576ec-dbd6-5f03-8c29-7a62088cf6b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449957}] :answer-field/correct {:answer/id #uuid "0d950cf8-fba5-5439-a346-fb6f6919aabb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449956} :answer-field/id #uuid "ef878e5f-c50a-5783-85f5-385663e493c3" :answer-field/key "$\\text{int}\\,A=A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450932}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "35b15061-fc8b-55f3-8742-4ca105208a91" :question/math-academy-id "q-161624" :question/problem "Consider the set $A,$ defined by \n\n$$\nA=\\{(x,y)\\in {R}^{2}\\,:\\,1<{x}^{2}+{y}^{2}\\le 4\\}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nIn this case, the set $A$ and its boundary $∂A$ are shown below.\n\n![](images/84/8414de2e05da43c03fae3c8b1ff2102401e990188e9fd4ee59a24308ec34b086.png)\n\n \n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nNotice that, in this case, the set $A$ contains some (not all) of its boundary points.\n\nWith that in mind, let's examine each statement:\n\n- Statement “$A$ contains none of its boundary points” is false, while statement “$A$ contains some (not all) of its boundary points” is true. As we have seen, $∂A$ consists of two concentric circles: the outer one is in $A,$ while the inner one is not.\n\n- Statement $\\text{int}\\,A=A$ is false. Since $A$ contains some of its boundary points, we must have $\\text{int}\\,A\\ne A.$\n\nTherefore, the correct answer is “$A$ contains some (not all) of its boundary points” only."} {:db/id #edb/ref 17592186278574 :knowledge-point/_questions [{:db/id #edb/ref 17592186192786 :knowledge-point/id #uuid "a024c46e-0374-5d03-b895-eb754ff7ad97" :knowledge-point/title "Identifying True Statements Regarding Interiors and Boundaries of Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "769ab244-b50f-5cca-ab22-fd43c9447cc4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465411} {:answer/id #uuid "2c5149c3-ecba-57d2-b462-3dbdfb69933a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465412}] :answer-field/correct {:answer/id #uuid "769ab244-b50f-5cca-ab22-fd43c9447cc4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465411} :answer-field/id #uuid "087f9ca1-8165-5d08-815b-de98c18b98c3" :answer-field/key "$A$ contains none of its boundary points." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466549} {:answer-field/choices [{:answer/id #uuid "61780875-68b1-505b-895f-12ff1ff66c15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465413} {:answer/id #uuid "dad38122-7c39-50f3-9242-6e99cb69a4f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465414}] :answer-field/correct {:answer/id #uuid "61780875-68b1-505b-895f-12ff1ff66c15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465413} :answer-field/id #uuid "65372a61-77ce-559a-9860-6323bcc95b27" :answer-field/key "$A$ contains some (not all) of its boundary points." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466550} {:answer-field/choices [{:answer/id #uuid "f0696dc0-2a39-515e-89a4-41b079d76ebe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465415} {:answer/id #uuid "61f6634a-9066-5bbf-b0fc-703e680d6c85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465416}] :answer-field/correct {:answer/id #uuid "61f6634a-9066-5bbf-b0fc-703e680d6c85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465416} :answer-field/id #uuid "db274c98-e65f-53ec-bc5e-861c8411a39d" :answer-field/key "$\\text{int}\\,A\\ne A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466551}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "be0484aa-ac87-5330-9ede-cd54e1386a15" :question/math-academy-id "q-161625" :question/problem "Consider the set $A,$ defined by \n\n$$\nA=\\{(x,y)\\in {R}^{2}\\,:\\,y\\ge 2-x\\}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nIn this case, the set $A$ and its boundary $∂A$ are shown below.\n\n![](images/cd/cdca164d343d8bff4c78a1e366e52c588ca6c54dfdea61acea1900bcbdc79f31.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nNotice that, in this case, the set $A$ contains all of its boundary points.\n\nWith that in mind, let's examine each statement:\n\n- Statements “$A$ contains none of its boundary points” and “$A$ contains some (not all) of its boundary points” are false. As we have seen, $A$ contains all its boundary points.\n\n- Statement $\\text{int}\\,A\\ne A$ is true. Since $A$ contains all of its boundary points, we must have $A-∂A⊊A.$ Therefore $\\text{int}\\,A\\ne A.$\n\nTherefore, the correct answer is $\\text{int}\\,A\\ne A$ only."} {:db/id #edb/ref 17592186278575 :knowledge-point/_questions [{:db/id #edb/ref 17592186192786 :knowledge-point/id #uuid "a024c46e-0374-5d03-b895-eb754ff7ad97" :knowledge-point/title "Identifying True Statements Regarding Interiors and Boundaries of Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f5b39a98-ac20-5cbf-805a-5c64b48f4d91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449958} {:answer/id #uuid "a6123e03-9f1a-55ae-8049-e66f7df48abf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449959}] :answer-field/correct {:answer/id #uuid "a6123e03-9f1a-55ae-8049-e66f7df48abf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449959} :answer-field/id #uuid "bb5b9ea3-b19f-572e-90a5-93f3f3d18280" :answer-field/key "$\\text{int}\\,A\\cap ∂A=∅$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450933} {:answer-field/choices [{:answer/id #uuid "bc09b043-a237-5147-8e74-3cb2d48c0db4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449960} {:answer/id #uuid "d3f5341e-9ebd-53a8-b977-c25f8d8c2d89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449961}] :answer-field/correct {:answer/id #uuid "bc09b043-a237-5147-8e74-3cb2d48c0db4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449960} :answer-field/id #uuid "45b72198-7edb-5c3f-a56e-f84b68b732be" :answer-field/key "$A-\\text{int}\\,A=∂A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450934} {:answer-field/choices [{:answer/id #uuid "3e755d2a-b5e6-5e96-88fd-d0e6cd0cfc47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449962} {:answer/id #uuid "896e016a-452b-53dc-9c84-3690b98756c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449963}] :answer-field/correct {:answer/id #uuid "896e016a-452b-53dc-9c84-3690b98756c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449963} :answer-field/id #uuid "3b80112e-c8cb-5761-852a-1dc1da395e6b" :answer-field/key "$∂A⊂{R}^{2}-A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450935}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "baee2889-195d-5ff5-b660-0a9acac1604c" :question/math-academy-id "q-161626" :question/problem "Consider the set $A,$ defined by \n\n$$\nA={(x,y)\\in {R}^{2}\\,:\\,\\frac{{x}^{2}}{4}+{y}^{2}<4}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nIn this case, the set $A$ and its boundary $∂A$ are shown below.\n\n![](images/45/4540e03fc5404474a0cd900c89004e6a5cfe7ac2d4702348e9d0395fc1c914e9.png)\n\n \n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.  \n\n![](images/2a/2a93b912f0d7b3a84bf0ec9c3b3596d080a9e71a345ff436e2f591edf042d9db.png)\n\n  \n\nWith that in mind, let's examine each statement:\n\n- Statement $\\text{int}\\,A\\cap ∂A=∅$ is true. Since $\\text{int}\\,A$ contains all points in $A$ except the boundary points, we must have $\\text{int}\\,A\\cap ∂A=∅,$ where $∅$ denotes the empty set.\n\n- Statement $A-\\text{int}\\,A=∂A$ is false. Since $A$ contains none of its boundary points, we must have $A=\\text{int}\\,A$ or, equivalently,  $A-\\text{int}\\,A=∅.$\n\n- Statement $∂A⊂{R}^{2}-A$ is true. In this case, the set $A$ contains none of its boundary points, so we must have $∂A⊂{R}^{2}-A.$\n\nTherefore, the correct answer is $\\text{int}\\,A\\cap ∂A=∅$; $∂A⊂{R}^{2}-A$ only."} {:db/id #edb/ref 17592186278576 :knowledge-point/_questions [{:db/id #edb/ref 17592186192767 :knowledge-point/id #uuid "7adf2c3e-4a73-5098-ab60-790d637728cf" :knowledge-point/title "Identifying Open and Closed Sets in the Plane in Set Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f462a13-e52b-5f50-bd9b-5e3e04a75ec4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465417} {:answer/id #uuid "7d035b1f-7fbf-59ff-b61e-ebb312eee7bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465418}] :answer-field/correct {:answer/id #uuid "7d035b1f-7fbf-59ff-b61e-ebb312eee7bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465418} :answer-field/id #uuid "f4834f1a-3776-5597-bca0-28aea74896d7" :answer-field/key "$\\begin{gathered}\\left\\{\\begin{gathered}(x,y)\\in {R}^{2}\\,:\\\\\\,1\\le x\\le 2,\\\\\\,0\\le y\\le \\sqrt{x}\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466552} {:answer-field/choices [{:answer/id #uuid "4acc30dd-b0dd-5587-9188-4cc8367a69bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465419} {:answer/id #uuid "28f06c85-e623-54b7-9f55-9afd7009566f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465420}] :answer-field/correct {:answer/id #uuid "28f06c85-e623-54b7-9f55-9afd7009566f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465420} :answer-field/id #uuid "ac548899-74b4-5b42-b1ca-0d1482e4229f" :answer-field/key "${(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+2{y}^{2}\\le 3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466553} {:answer-field/choices [{:answer/id #uuid "bb0fe9bc-f78c-5c55-bbf7-fd65e2ea1195" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465421} {:answer/id #uuid "c615d31d-cf76-5762-8eca-1a561a4f0997" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465422}] :answer-field/correct {:answer/id #uuid "bb0fe9bc-f78c-5c55-bbf7-fd65e2ea1195" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465421} :answer-field/id #uuid "28fa83d6-4600-547a-a25c-706ebb06a453" :answer-field/key "$\\begin{gathered}\\left\\{\\begin{gathered}(x,y)\\in {R}^{2}\\,:\\\\\\,-1<x<1,\\\\\\,0<y<2-{x}^{2}\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466554}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8fb05970-59dc-5904-9b90-0c1d735b4269" :question/math-academy-id "q-161638" :question/problem "Which of the following sets are closed?\n\nSelect all that apply." :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *closed* since it contains all of its boundary points (all the corresponding inequalities are not strict).\n\n- The second set is *closed* since it contains all of its boundary points (all the corresponding inequalities are not strict).\n\n- The third set is *open* since it doesn't contain any of its boundary points (all the corresponding inequalities are strict).\n\nTherefore, the correct answer is $\\begin{gathered}\\left\\{\\begin{gathered}(x,y)\\in {R}^{2}\\,:\\\\\\,1\\le x\\le 2,\\\\\\,0\\le y\\le \\sqrt{x}\\end{gathered}\\right\\}\\end{gathered}$; ${(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+2{y}^{2}\\le 3}$ only."} {:db/id #edb/ref 17592186278577 :knowledge-point/_questions [{:db/id #edb/ref 17592186192767 :knowledge-point/id #uuid "7adf2c3e-4a73-5098-ab60-790d637728cf" :knowledge-point/title "Identifying Open and Closed Sets in the Plane in Set Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1723e615-d467-58f5-999a-7973741641a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465423} {:answer/id #uuid "f9abc517-42f5-5df9-8763-751fa53ba7e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465424}] :answer-field/correct {:answer/id #uuid "1723e615-d467-58f5-999a-7973741641a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465423} :answer-field/id #uuid "1e72de96-4a0e-5793-9030-00840e107b1a" :answer-field/key "$\\begin{gathered}\\left\\{\\begin{gathered}(x,y)\\in {R}^{2}\\,:\\\\\\,-3<x<-1,\\\\\\,1<y<0.5x+3\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466555} {:answer-field/choices [{:answer/id #uuid "73751260-3c44-5990-85ed-3b267c03dae3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465425} {:answer/id #uuid "370be496-358b-5e7b-a667-394d18ea293a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465426}] :answer-field/correct {:answer/id #uuid "370be496-358b-5e7b-a667-394d18ea293a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465426} :answer-field/id #uuid "4fb24073-6d92-542f-8596-ac6f6e4394df" :answer-field/key "$\\begin{gathered}\\left\\{\\begin{gathered}(x,y)\\in {R}^{2}\\,:\\\\\\,-2\\le x\\le 2,\\\\\\,0\\le y\\le 4-{x}^{2}\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466556} {:answer-field/choices [{:answer/id #uuid "35f70d16-b32e-538c-9859-1005c1e1e446" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465427} {:answer/id #uuid "35894513-fdab-5a3b-8565-fe3a1eae24b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465428}] :answer-field/correct {:answer/id #uuid "35f70d16-b32e-538c-9859-1005c1e1e446" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465427} :answer-field/id #uuid "41160ea6-dde2-54a9-aa26-dda3dbb64fc8" :answer-field/key "$\\begin{gathered}\\left\\{\\begin{gathered}(x,y)\\in {R}^{2}\\,:\\\\\\,1<x<2,\\\\\\,0<y<2\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466557}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "20984d3c-4813-50f9-a16b-ba04fcaf3833" :question/math-academy-id "q-161640" :question/problem "Which of the following sets are closed?\n\nSelect all that apply." :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *open* since it doesn't contain any of its boundary points (all the corresponding inequalities are strict).\n\n- The second set is *closed* since it contains all of its boundary points (all the corresponding inequalities are not strict).\n\n- The third set is *open* since it doesn't contain any of its boundary points (all the corresponding inequalities are strict).\n\nTherefore, the correct answer is $\\begin{gathered}\\left\\{\\begin{gathered}(x,y)\\in {R}^{2}\\,:\\\\\\,-2\\le x\\le 2,\\\\\\,0\\le y\\le 4-{x}^{2}\\end{gathered}\\right\\}\\end{gathered}$ only."} {:db/id #edb/ref 17592186278578 :knowledge-point/_questions [{:db/id #edb/ref 17592186192767 :knowledge-point/id #uuid "7adf2c3e-4a73-5098-ab60-790d637728cf" :knowledge-point/title "Identifying Open and Closed Sets in the Plane in Set Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "032fb137-9168-5a99-a5e4-9074a94d7959" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465429} {:answer/id #uuid "31c96af2-d123-5df0-997d-6bf01aa71691" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465430}] :answer-field/correct {:answer/id #uuid "032fb137-9168-5a99-a5e4-9074a94d7959" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465429} :answer-field/id #uuid "35c8e728-3d73-591e-810b-c44bf8681591" :answer-field/key "$\\begin{gathered}\\left\\{\\begin{gathered}(x,y)\\in {R}^{2}\\,:\\\\\\,1<x<2,\\\\\\,0<y<\\frac{1}{x}\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466558} {:answer-field/choices [{:answer/id #uuid "0e266ca0-a8ca-599c-8613-42ac229a460d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465431} {:answer/id #uuid "63d6a33b-ed6b-53cf-b66d-884a485f3f3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465432}] :answer-field/correct {:answe