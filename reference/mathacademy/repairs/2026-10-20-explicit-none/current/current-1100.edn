592186278285 :knowledge-point/_questions [{:db/id #edb/ref 17592186092224 :knowledge-point/id #uuid "20f4ef93-3e7b-58ec-992e-3a62b12b74e2" :knowledge-point/title "Using a Matrix That Represents a Rotation of 180 Degrees"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "289e0b06-f3a5-5776-aef5-bb87fb2feb99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465267} {:answer/id #uuid "12fc5042-6ba0-5fb2-9125-d99fdcd576c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465268}] :answer-field/correct {:answer/id #uuid "289e0b06-f3a5-5776-aef5-bb87fb2feb99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465267} :answer-field/id #uuid "e027988e-566a-5a00-bd83-bd85e85804b5" :answer-field/key "The point $(-6,-1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466477} {:answer-field/choices [{:answer/id #uuid "c18cd31c-3286-523a-9509-b45791d2ba87" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465269} {:answer/id #uuid "94c973f3-941d-5c0e-a717-1f0e28e3a5ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465270}] :answer-field/correct {:answer/id #uuid "94c973f3-941d-5c0e-a717-1f0e28e3a5ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465270} :answer-field/id #uuid "ad4631ce-86c0-54fd-b549-a1e794042a96" :answer-field/key "The point $(4,-1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466478} {:answer-field/choices [{:answer/id #uuid "d27e867b-18a5-513e-8b91-feb847ed5a65" :answer/type {:db/id #e