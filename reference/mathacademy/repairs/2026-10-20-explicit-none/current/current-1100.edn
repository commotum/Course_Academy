/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465505} {:answer/id #uuid "61e4a967-940f-553b-b00f-ad2e376fcd6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465506}] :answer-field/correct {:answer/id #uuid "61e4a967-940f-553b-b00f-ad2e376fcd6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465506} :answer-field/id #uuid "66e05cae-0986-5eea-b30c-263f052d000a" :answer-field/key "$a$ is a local minimum of $f$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466596}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "59d86f24-1bbb-55d7-8154-a7330272c0b1" :question/math-academy-id "q-163779" :question/problem "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{2}$ is given by\n\n$$\nf(x)≈4+\\frac{1}{2}(x-a)^{T}A(x-a),\n$$\n\nwhere \n\n$$\nA=\\begin{bmatrix}5 & 2 \\\\ 2 & 1\\end{bmatrix}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The point $a\\in {R}^{n}$ is a critical point of the function $f:{R}^{n}\\to R$ if ${f}^{′}(a)={0}^{T}.$ In such cases, we can classify $a$ as follows:\n\n- if ${f}^{″}(a)$ is positive definite, then $a$ is a local minimum\n\n- if ${f}^{″}(a)$ is negative definite, then $a$ is a local maximum\n\n- if ${f}^{″}(a)$ is neither positive-definite nor negative-definite, then $a$ is a saddle point\n\nIn this case, we have $A={f}^{″}(a).$ Now, before we examine the statements, let's recall how to categorize quadratic forms.\n\nLet ${Δ}_{i}$ for $i=1,2,…,n$  denote the leading principal minors of an $n\\times n$ matrix $A.$ Then, according to Sylvester's criterion, the quadratic form ${x}^{T}\\,A\\,x$ (as well as the matrix $A$) is \n\n- positive-definite if and only if ${Δ}_{i}>0$ for all $i=1,2,…,n,$\n\n- negative-definite if and only if, for all $i=1,2,…,n,$ we have ${Δ}_{i}<0$ when $i$ is odd, and ${Δ}_{i}>0$ when $i$ is even.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement “${a}_{11}=5$ and $det(A)=2$” is false. Indeed, ${a}_{11}=5,$ but\n\n$$\ndet(A)=|\\begin{aligned}5 & 2 \\\\ 2 & 1\\end{aligned}|=1.\n$$\n\n- Statement “$A$ is positive-definite” is true. Notice that\n\n$$\n\\begin{aligned}{Δ}_{1} & ={a}_{11}=5>0, \\\\ {Δ}_{2} & =|\\begin{aligned}5 & 2 \\\\ 2 & 1\\end{aligned}|=1>0.\\end{aligned}\n$$\n\nSo, by Sylvester's criterion, the matrix $A$ is positive-definite.\n\n- Statement “$a$ is a local minimum of $f$” is true. Since the matrix $A$ is positive-definite, the critical point $a$ is a local minimum of $f.$\n\nTherefore, the correct answer is “$A$ is positive-definite”; “$a$ is a local minimum of $f$” only."} {:db/id #edb/ref 17592186284419 :knowledge-point/_questions [{:db/id #edb/ref 17592186124570 :knowledge-point/id #uuid "40d58ee6-1121-5ddc-a96f-1a7fa7a193dd" :knowledge-point/title "Classifying Local Extrema Using Sylvester's Criterion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35364fce-dfa4-57e3-b4b3-7ffde26baef4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465507} {:answer/id #uuid "abe81707-7bee-5f3d-9998-a89d0e5199e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465508}] :answer-field/correct {:answer/id #uuid "35364fce-dfa4-57e3-b4b3-7ffde26baef4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465507} :answer-field/id #uuid "a40580c0-664c-5c83-92d6-b7ba6d5f88f8" :answer-field/key "${a}_{11}=-1$ and $det(A)=4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466597} {:answer-field/choices [{:answer/id #uuid "2c4f5088-9b18-50ac-a385-00e43fa6bfd3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465509} {:answer/id #uuid "30bdc7e6-fb2d-5f8e-8626-9b6d3ba37448" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465510}] :answer-field/correct {:answer/id #uuid "30bdc7e6-fb2d-5f8e-8626-9b6d3ba37448" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465510} :answer-field/id #uuid "8d4dbc50-2382-5ace-b738-59f70f7581ec" :answer-field/key "$A$ is negative-definite" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466598} {:answer-field/choices [{:answer/id #uuid "35500f5f-9589-57c1-b99a-e40289eb9def" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465511} {:answer/id #uuid "fbbd6160-5664-504d-af50-fadc01831e76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465512}] :answer-field/correct {:answer/id #uuid "35500f5f-9589-57c1-b99a-e40289eb9def" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465511} :answer-field/id #uuid "fb722114-368c-5b3a-8c4c-b807849699e9" :answer-field/key "$a$ is a local minimum of $f$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466599}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "03651691-7356-5261-96f0-0d0badb00da3" :question/math-academy-id "q-163780" :question/problem "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{2}$ is given by\n\n$$\nf(x)≈-8+\\frac{1}{2}(x-a)^{T}A(x-a),\n$$\n\nwhere \n\n$$\nA=\\begin{bmatrix}-1 & 2 \\\\ 2 & -6\\end{bmatrix}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The point $a\\in {R}^{n}$ is a critical point of the function $f:{R}^{n}\\to R$ if ${f}^{′}(a)={0}^{T}.$ In such cases, we can classify $a$ as follows:\n\n- if ${f}^{″}(a)$ is positive definite, then $a$ is a local minimum\n\n- if ${f}^{″}(a)$ is negative definite, then $a$ is a local maximum\n\n- if ${f}^{″}(a)$ is neither positive-definite nor negative-definite, then $a$ is a saddle point\n\nIn this case, we have $A={f}^{″}(a).$ Now, before we examine the statements, let's recall how to categorize quadratic forms.\n\nLet ${Δ}_{i}$ for $i=1,2,…,n$  denote the leading principal minors of an $n\\times n$ matrix $A.$ Then, according to Sylvester's criterion, the quadratic form ${x}^{T}\\,A\\,x$ (as well as the matrix $A$) is \n\n- positive-definite if and only if ${Δ}_{i}>0$ for all $i=1,2,…,n,$\n\n- negative-definite if and only if, for all $i=1,2,…,n,$ we have ${Δ}_{i}<0$ when $i$ is odd, and ${Δ}_{i}>0$ when $i$ is even.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement “${a}_{11}=-1$ and $det(A)=4$” is false. Indeed, ${a}_{11}=-1,$ but\n\n$$\ndet(A)=|\\begin{aligned}-1 & 2 \\\\ 2 & -6\\end{aligned}|=2.\n$$\n\n- Statement “$A$ is negative-definite” is true. Notice that\n\n$$\n\\begin{aligned}{Δ}_{1} & ={a}_{11}=-1<0, \\\\ {Δ}_{2} & =|\\begin{aligned}-1 & 2 \\\\ 2 & -6\\end{aligned}|=2>0.\\end{aligned}\n$$\n\nSo, by Sylvester's criterion, the matrix $A$ is negative-definite.\n\n- Statement “$a$ is a local minimum of $f$” is false. Since the matrix $A$ is negative-definite, the critical point $a$ is a local maximum of $f.$\n\nTherefore, the correct answer is “$A$ is negative-definite” only."} {:db/id #edb/ref 17592186284423 :knowledge-point/_questions [{:db/id #edb/ref 17592186124570 :knowledge-point/id #uuid "40d58ee6-1121-5ddc-a96f-1a7fa7a193dd" :knowledge-point/title "Classifying Local Extrema Using Sylvester's Criterion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e792ff8-af62-57d5-a566-a450e4d2c073" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465513} {:answer/id #uuid "c06e501a-7fca-57b5-8fd8-00c7ba0828ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465514}] :answer-field/correct {:answer/id #uuid "6e792ff8-af62-57d5-a566-a450e4d2c073" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465513} :answer-field/id #uuid "7767a756-a8d3-5be5-bfc9-c38d9f8739ab" :answer-field/key "${a}_{11}=3$ and $det(A)>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466600} {:answer-field/choices [{:answer/id #uuid "d91f22ee-b903-5aa9-a3a0-e9971360e020" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465515} {:answer/id #uuid "ddaa9832-b748-5975-984c-dd66a942f7ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465516}] :answer-field/correct {:answer/id #uuid "ddaa9832-b748-5975-984c-dd66a942f7ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465516} :answer-field/id #uuid "caa63e50-d620-5761-8485-c5faf4821dd9" :answer-field/key "$A$ is neither positive-definite nor negative-definite" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466601} {:answer-field/choices [{:answer/id #uuid "476a495d-1c2e-59e7-a3f1-54bf4179f4b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465517} {:answer/id #uuid "6a781903-27e5-5a45-afd1-4d6f7a5fdce8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465518}] :answer-field/correct {:answer/id #uuid "6a781903-27e5-5a45-afd1-4d6f7a5fdce8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465518} :answer-field/id #uuid "4b937cb6-cf67-521a-8508-427cc88aed42" :answer-field/key "$a$ is a saddle point of $f$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466602}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c598e2d2-d26a-59ea-a0e5-a7e53e350ac2" :question/math-academy-id "q-163789" :question/problem "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{3}$ is given by\n\n$$\nf(x)≈16+\\frac{1}{2}(x-a)^{T}A(x-a),\n$$\n\nwhere \n\n$$\nA=\\begin{bmatrix}3 & 1 & -4 \\\\ 1 & 2 & -1 \\\\ -4 & -1 & 2\\end{bmatrix}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The point $a\\in {R}^{n}$ is a critical point of the function $f:{R}^{n}\\to R$ if ${f}^{′}(a)={0}^{T}.$ In such cases, we can classify $a$ as follows:\n\n- if ${f}^{″}(a)$ is positive definite, then $a$ is a local minimum\n\n- if ${f}^{″}(a)$ is negative definite, then $a$ is a local maximum\n\n- if ${f}^{″}(a)$ is neither positive-definite nor negative-definite, then $a$ is a saddle point\n\nIn this case, we have $A={f}^{″}(a).$ Now, before we examine the statements, we recall how to categorize quadratic forms.\n\nLet ${Δ}_{i}$ for $i=1,2,…,n$  denote the leading principal minors of an $n\\times n$ matrix $A.$ Then, according to Sylvester's criterion, the quadratic form ${x}^{T}\\,A\\,x$ (as well as the matrix $A$) is \n\n- positive-definite if and only if ${Δ}_{i}>0$ for all $i=1,2,…,n,$\n\n- negative-definite if and only if, for all $i=1,2,…,n,$ we have ${Δ}_{i}<0$ when $i$ is odd, and ${Δ}_{i}>0$ when $i$ is even.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement “${a}_{11}=3$ and $det(A)>0$” is false. Indeed, ${a}_{11}=3,$ but\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}3 & 1 & -4 \\\\ 1 & 2 & -1 \\\\ -4 & -1 & 2\\end{aligned}| \\\\  & =3\\cdot |\\begin{aligned}2 & -1 \\\\ -1 & 2\\end{aligned}|-1\\cdot |\\begin{aligned}1 & -1 \\\\ -4 & 2\\end{aligned}|+(-4)\\cdot |\\begin{aligned}1 & 2 \\\\ -4 & -1\\end{aligned}| \\\\  & =3(3)-1(-2)-4(7) \\\\  & =-17<0.\\end{aligned}\n$$\n\n- Statement “$A$ is neither positive-definite nor negative-definite” is true. Notice the following:\n\n$$\n\\begin{aligned}{Δ}_{1} & ={a}_{11}=3>0 \\\\ {Δ}_{2} & =|\\begin{aligned}3 & 1 \\\\ 1 & 2\\end{aligned}|=5>0 \\\\ {Δ}_{3} & =|A|=-17<0\\end{aligned}\n$$\n\nSo, by Sylvester's criterion, the matrix $A$ is neither positive-definite nor negative-definite.\n\n- Statement “$a$ is a saddle point of $f$” is true. Since the matrix $A$ is neither positive-definite nor negative-definite, the critical point $a$ is a saddle point of $f.$\n\nTherefore, the correct answer is “$A$ is neither positive-definite nor negative-definite”; “$a$ is a saddle point of $f$” only."} {:db/id #edb/ref 17592186284424 :knowledge-point/_questions [{:db/id #edb/ref 17592186124570 :knowledge-point/id #uuid "40d58ee6-1121-5ddc-a96f-1a7fa7a193dd" :knowledge-point/title "Classifying Local Extrema Using Sylvester's Criterion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bf8f149-6cad-5a5c-9d26-11b86bcaa720" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465519} {:answer/id #uuid "6b04f584-4740-59cf-8497-f747191febb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465520}] :answer-field/correct {:answer/id #uuid "6b04f584-4740-59cf-8497-f747191febb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465520} :answer-field/id #uuid "ddfefddd-b168-5878-87f2-f8f0e1876a2e" :answer-field/key "$det(A)=-19$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466603} {:answer-field/choices [{:answer/id #uuid "9f9329ab-4f40-5e23-86a5-bf4d0b285377" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465521} {:answer/id #uuid "5441ae78-27c1-5694-8618-d6f72b5ef496" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465522}] :answer-field/correct {:answer/id #uuid "5441ae78-27c1-5694-8618-d6f72b5ef496" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465522} :answer-field/id #uuid "d143db0c-e1c0-5daa-9470-d0193838ae88" :answer-field/key "$A$ is negative-definite" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466604} {:answer-field/choices [{:answer/id #uuid "12620dec-4540-5bfc-a97c-4be11c2d223d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465523} {:answer/id #uuid "13ec6254-73f7-5076-8506-15526b0e95bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465524}] :answer-field/correct {:answer/id #uuid "12620dec-4540-5bfc-a97c-4be11c2d223d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465523} :answer-field/id #uuid "c993b7a5-1549-5886-b715-49e5a62df038" :answer-field/key "$a$ is a local minimum of $f$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466605}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "00b2158a-941e-5a2f-b68c-c230bee6df19" :question/math-academy-id "q-163791" :question/problem "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{3}$ is given by\n\n$$\nf(x)≈8+\\frac{1}{2}(x-a)^{T}A(x-a),\n$$\n\nwhere \n\n$$\nA=\\begin{bmatrix}-2 & 1 & 0 \\\\ 1 & -4 & 1 \\\\ 0 & 1 & -3\\end{bmatrix}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The point $a\\in {R}^{n}$ is a critical point of the function $f:{R}^{n}\\to R$ if ${f}^{′}(a)={0}^{T}.$ In such cases, we can classify $a$ as follows:\n\n- if ${f}^{″}(a)$ is positive definite, then $a$ is a local minimum\n\n- if ${f}^{″}(a)$ is negative definite, then $a$ is a local maximum\n\n- if ${f}^{″}(a)$ is neither positive-definite nor negative-definite, then $a$ is a saddle point\n\nIn this case, we have $A={f}^{″}(a).$ Now, before we examine the statements, we recall how to categorize quadratic forms.\n\nLet ${Δ}_{i}$ for $i=1,2,…,n$  denote the leading principal minors of an $n\\times n$ matrix $A.$ Then, according to Sylvester's criterion, the quadratic form ${x}^{T}\\,A\\,x$ (as well as the matrix $A$) is \n\n- positive-definite if and only if ${Δ}_{i}>0$ for all $i=1,2,…,n,$\n\n- negative-definite if and only if, for all $i=1,2,…,n,$ we have ${Δ}_{i}<0$ when $i$ is odd, and ${Δ}_{i}>0$ when $i$ is even.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement $det(A)=-19$ is true. Indeed,\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}-2 & 1 & 0 \\\\ 1 & -4 & 1 \\\\ 0 & 1 & -3\\end{aligned}| \\\\  & =-2\\cdot |\\begin{aligned}-4 & 1 \\\\ 1 & -3\\end{aligned}|-1\\cdot |\\begin{aligned}1 & 1 \\\\ 0 & -3\\end{aligned}| \\\\  & =-2(11)-1(-3) \\\\  & =-19.\\end{aligned}\n$$\n\n- Statement “$A$ is negative-definite” is true. Notice the following:\n\n$$\n\\begin{aligned}{Δ}_{1} & ={a}_{11}=-2<0 \\\\ {Δ}_{2} & =|\\begin{aligned}-2 & 1 \\\\ 1 & -4\\end{aligned}|=7>0 \\\\ {Δ}_{3} & =|A|=-19<0\\end{aligned}\n$$\n\nSo, by Sylvester's criterion, the matrix $A$ is negative-definite.\n\n- Statement “$a$ is a local minimum of $f$” is false. Since the matrix $A$ is negative-definite, the critical point $a$ is a local maximum of $f.$\n\nTherefore, the correct answer is $det(A)=-19$; “$A$ is negative-definite” only."} {:db/id #edb/ref 17592186284427 :knowledge-point/_questions [{:db/id #edb/ref 17592186157363 :knowledge-point/id #uuid "b5586c38-e0ca-5a6d-90ab-71c0fead2cc2" :knowledge-point/title "Determining Whether a Point on a Solution Curve Is a Stationary Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bd2735b-7309-5cc2-aac7-6bdb82098c85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465525} {:answer/id #uuid "63bba5f3-2bf2-52fb-8ebe-f9a90bfd3e50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465526}] :answer-field/correct {:answer/id #uuid "63bba5f3-2bf2-52fb-8ebe-f9a90bfd3e50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465526} :answer-field/id #uuid "62291f9f-4657-5e75-859c-7df99d0d5361" :answer-field/key "$(\\pi ,1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466606} {:answer-field/choices [{:answer/id #uuid "de3b1313-5c20-5038-a4d8-28551dcef349" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465527} {:answer/id #uuid "093bcad8-2d30-54e0-9a4b-8040346d8fa8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465528}] :answer-field/correct {:answer/id #uuid "de3b1313-5c20-5038-a4d8-28551dcef349" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465527} :answer-field/id #uuid "8df5c487-ae24-53f7-907d-64c5902e3a4f" :answer-field/key "$(\\pi ,-1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466607} {:answer-field/choices [{:answer/id #uuid "e4aa774c-5a9f-5b63-8918-0557d528a6d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465529} {:answer/id #uuid "00498319-9288-5435-aa6b-b38bb3c21b9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465530}] :answer-field/correct {:answer/id #uuid "00498319-9288-5435-aa6b-b38bb3c21b9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465530} :answer-field/id #uuid "db4e3201-6ef4-5c64-9c7b-37b6045ee210" :answer-field/key "$(0,-1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466608}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4ce7de24-db57-5ead-8c61-93889fcd8ed1" :question/math-academy-id "q-163812" :question/problem "Consider the solution curves of the differential equation ${y}^{2}{y}^{′}=y+\\operatorname{cos}⁡x.$ Which of the following are stationary points of their respective solution curve?\n\nSelect all that apply." :question/worked-solution "Recall that a stationary point of $y(x)$ is a point $x=c$ in the domain of $y$ such that ${y}^{′}(c)=0.$ \n\nFirst, we make ${y}^{′}$ the subject of the equation.\n\n$$\n\\begin{aligned}{y}^{2}{y}^{′}=y+\\operatorname{cos}⁡x\\,⟹\\,{y}^{′}=\\frac{y+\\operatorname{cos}⁡x}{{y}^{2}}\\end{aligned}\n$$\n\nNow, we substitute the coordinates of our points into the differential equation and calculate the value of the derivative: \n\n$$\n\\begin{aligned}{{y}^{′}|}_{(\\pi ,1)} & ={\\left(\\frac{y+\\operatorname{cos}⁡x}{{y}^{2}}\\right)|}_{(\\pi ,1)} \\\\  & =\\frac{(1)+\\operatorname{cos}⁡(\\pi )}{(1)^{2}} \\\\  & =0\\,✓ \\\\ {{y}^{′}|}_{(\\pi ,-1)} & ={\\left(\\frac{y+\\operatorname{cos}⁡x}{{y}^{2}}\\right)|}_{(\\pi ,-1)} \\\\  & =\\frac{(-1)+\\operatorname{cos}⁡(\\pi )}{(-1)^{2}} \\\\  & =-2 \\\\  & \\ne 0\\,\\times  \\\\ {{y}^{′}|}_{(0,-1)} & ={\\left(\\frac{y+\\operatorname{cos}⁡x}{{y}^{2}}\\right)|}_{(0,-1)} \\\\  & =\\frac{(-1)+\\operatorname{cos}⁡(0)}{(-1)^{2}} \\\\  & =0\\,✓\\end{aligned}\n$$\n\nTherefore, the correct answer is $(\\pi ,1)$; $(0,-1)$ only."} {:db/id #edb/ref 17592186284442 :knowledge-point/_questions [{:db/id #edb/ref 17592186157368 :knowledge-point/id #uuid "f901a3ab-3b58-51a1-b653-f88ac4b09060" :knowledge-point/title "Using the Second Derivative Test To Classify a Point on a Solution Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b05e796-e00c-5de2-9ed1-30703c297087" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465531} {:answer/id #uuid "e130c91d-7b17-52a3-bbbe-7767095f3a35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465532}] :answer-field/correct {:answer/id #uuid "8b05e796-e00c-5de2-9ed1-30703c297087" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465531} :answer-field/id #uuid "1391c79c-130f-5328-917d-79dbf6fe63ec" :answer-field/key "$(-\\frac{1}{2},1)$ is a stationary point of the function $f$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466609} {:answer-field/choices [{:answer/id #uuid "ea44c227-3043-5844-9d11-64a4526e8f15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465533} {:answer/id #uuid "cb1d78a3-f02f-531f-84d8-088e936f9199" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465534}] :answer-field/correct {:answer/id #uuid "ea44c227-3043-5844-9d11-64a4526e8f15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465533} :answer-field/id #uuid "5a5c2786-4ef5-5ec0-8f4d-c449aa97de49" :answer-field/key "$(-\\frac{1}{2},1)$ is a local maximum point of the function $f$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466610} {:answer-field/choices [{:answer/id #uuid "604a2af8-96eb-5f23-87ff-0df87135405b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465535} {:answer/id #uuid "2598aec1-6d6c-5cb8-a449-91508e4cf00e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465536}] :answer-field/correct {:answer/id #uuid "604a2af8-96eb-5f23-87ff-0df87135405b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465535} :answer-field/id #uuid "dcee9c7c-2aa1-5f34-a629-c4b67e147f65" :answer-field/key "$(-\\frac{1}{2},1)$ is an inflection point of the function $f$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466611}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8eeb45f2-bc46-5681-a60d-c808242e288d" :question/math-academy-id "q-164138" :question/problem "The function $y=f(x)$ satisfies the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{y}{1+{x}^{2}}.\n$$\n\nGiven that the point $(-\\frac{1}{2},1)$ lies on the graph of $y=f(x),$ which of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "First, we find the value of the first and second derivatives of the function at the given point.\n\nTo find the first derivative of $f$ at $(-\\frac{1}{2},1),$ we substitute the coordinates of our point into the differential equation:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{(-1/2,1)} & ={\\left(\\frac{y}{1+{x}^{2}}\\right)|}_{(-1/2,1)} \\\\  & =\\frac{1}{1+{\\left(-\\frac{1}{2}\\right)}^{2}} \\\\  & =\\frac{4}{5}\\end{aligned}\n$$\n\nTo find the second derivative, we first need to differentiate the equation and then substitute the coordinates of the point:\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{\\text{d}y}{\\text{d}x}\\right) \\\\  & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{y}{1+{x}^{2}}\\right) \\\\  & =\\frac{1}{1+{x}^{2}}\\cdot \\frac{\\text{d}y}{\\text{d}x}-\\frac{2xy}{(1+{x}^{2})^{2}} \\\\  & =\\frac{1}{1+{x}^{2}}\\cdot \\frac{y}{1+{x}^{2}}-\\frac{2xy}{(1+{x}^{2})^{2}} \\\\  & =\\frac{y(1-2x)}{(1+{x}^{2})^{2}} \\\\ {\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(-1/2,1)} & ={\\left(\\frac{y(1-2x)}{(1+{x}^{2})^{2}}\\right)|}_{(-1/2,1)} \\\\  & =\\frac{1(1-2\\left(-\\frac{1}{2}\\right))}{{(1+{\\left(-\\frac{1}{2}\\right)}^{2})}^{2}} \\\\  & =\\frac{32}{25}.\\end{aligned}\n$$\n\nWith that in mind, let's examine the statements in turn.\n\n- Statement “$(-\\frac{1}{2},1)$ is a stationary point of the function $f$” is false. Indeed, since\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(-1/2,1)}=\\frac{4}{5}\\ne 0,\n$$\n\nwe obtain that $(-\\frac{1}{2},1)$ is not a stationary point of the function $f.$\n\n- Statement “$(-\\frac{1}{2},1)$ is a local maximum point of the function $f$” is false. There is no critical point at $(-\\frac{1}{2},1).$ Therefore we cannot have a local minimum at that point.\n\n- Statement “$(-\\frac{1}{2},1)$ is an inflection point of the function $f$” is false. Since the second derivative is not zero, there is no inflection point at $(-\\frac{1}{2},1).$\n\nTherefore, the correct answer is \"None of those listed.\""} {:db/id #edb/ref 17592186284447 :knowledge-point/_questions [{:db/id #edb/ref 17592186124647 :knowledge-point/id #uuid "f0fb118f-c1cc-51fd-a8cc-c29cf705acfe" :knowledge-point/title "Identifying the Local Extrema of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a548b762-254d-5503-9bdc-ee9b3db0343c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465537} {:answer/id #uuid "5b890428-e714-50e8-a25d-194ffa0fa64a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465538}] :answer-field/correct {:answer/id #uuid "a548b762-254d-5503-9bdc-ee9b3db0343c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465537} :answer-field/id #uuid "ebd0423b-7a8f-573f-9d6b-7f4e7280a365" :answer-field/key "Point $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466612} {:answer-field/choices [{:answer/id #uuid "de59ca97-1aed-5c82-97ae-0036990ece61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465539} {:answer/id #uuid "aba0580e-6d6b-54b7-9354-14b60eb284b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465540}] :answer-field/correct {:answer/id #uuid "aba0580e-6d6b-54b7-9354-14b60eb284b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465540} :answer-field/id #uuid "24e7a461-81df-553b-9d92-c7e10bc4d0f6" :answer-field/key "Point $B$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466613} {:answer-field/choices [{:answer/id #uuid "2ac0c9d0-2ccc-5127-9770-3602fe1c2d89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465541} {:answer/id #uuid "fd97d7fc-8560-50f4-a5ef-982684deaed5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465542}] :answer-field/correct {:answer/id #uuid "2ac0c9d0-2ccc-5127-9770-3602fe1c2d89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465541} :answer-field/id #uuid "62bb3be7-ac04-517e-97e6-83c3aca76a8c" :answer-field/key "Point $C$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466614} {:answer-field/choices [{:answer/id #uuid "9951cfdd-e926-5c89-b9b0-0744d28851f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465543} {:answer/id #uuid "3032c93e-22e6-5f71-81c9-c6bdd88b04e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465544}] :answer-field/correct {:answer/id #uuid "9951cfdd-e926-5c89-b9b0-0744d28851f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465543} :answer-field/id #uuid "48758690-7815-5e22-aea8-571e2ab0e1ff" :answer-field/key "Point $D$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466615}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "140468c2-8315-56a7-adfc-2601c4482a06" :question/math-academy-id "q-164150" :question/problem "![](images/fd/fdfae6a5a321d1dbc235d06438847d5a0cc471fa4e31575f36c3967dca239824.png)\n\nThe graph of the function $z=f(x,y)$ is shown above. Which of the points shown are local minimum points?\n\nSelect all that apply." :question/worked-solution "A function $f(x,y)$ has a local minimum point at $(a,b)$ if $f(x,y)\\ge f(a,b)$ for all points $(x,y)$ in a neighborhood of $(a,b).$ \n\nIn other words, we can take a neighborhood of $(x,y)$-values such that the point $(x,y,f(x,y))$ is the lowest point on the graph in the neighborhood.\n\nSuch neighborhood exists for the point $B.$ Hence, $B$ is a local minimum.\n\n![](images/82/82291f89bd32f3a3a20d39dfc89de91b2f673bec7c802cebf6d5fa3b4136ace1.png)"}]
