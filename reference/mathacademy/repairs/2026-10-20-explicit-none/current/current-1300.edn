[{:db/id #edb/ref 17592186290440 :knowledge-point/_questions [{:db/id #edb/ref 17592186184151 :knowledge-point/id #uuid "437c168a-6799-5d13-bd9b-031290a84da6" :knowledge-point/title "Finding the Intervals of Concavity of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2be22f62-445f-524d-b9e3-8e5afaa7420d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465887} {:answer/id #uuid "ebddb93c-cb3a-53b8-af7f-7c2c0137d262" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465888}] :answer-field/correct {:answer/id #uuid "2be22f62-445f-524d-b9e3-8e5afaa7420d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465887} :answer-field/id #uuid "668dee04-dff6-50da-9667-d8c73c75df22" :answer-field/key "$f(x)$ is concave up on $(0,1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466787} {:answer-field/choices [{:answer/id #uuid "52e3c39d-2a51-5303-9487-acd212076b78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465889} {:answer/id #uuid "38d6516f-117c-5c56-a5b5-cc594da416b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465890}] :answer-field/correct {:answer/id #uuid "38d6516f-117c-5c56-a5b5-cc594da416b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465890} :answer-field/id #uuid "64c3d988-6f8b-5f25-b00f-eab5079bfc05" :answer-field/key "$f(x)$ is concave down on $(0,1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466788} {:answer-field/choices [{:answer/id #uuid "77aecb7e-3a12-52e2-a0a0-4f675ac7f167" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465891} {:answer/id #uuid "3910cc85-5508-5c6f-b6b0-d5041c8c1376" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465892}] :answer-field/correct {:answer/id #uuid "77aecb7e-3a12-52e2-a0a0-4f675ac7f167" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465891} :answer-field/id #uuid "57297f62-17f1-58b7-8a9b-a5c727ad1f39" :answer-field/key "$f(x)$ is concave down on $(1,\\infty )$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466789}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c687bf7b-334e-54f3-b20c-cd4bb1895323" :question/math-academy-id "q-22826" :question/problem "Consider the function $f(x)={x}^{2}-\\frac{1}{x}$ defined on $x\\in (0,\\infty ).$ Which of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "First, we calculate the second derivative of $f(x),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =2x+\\frac{1}{{x}^{2}} \\\\ {f}^{″}(x) & =2-\\frac{2}{{x}^{3}}.\\end{aligned}\n$$\n\nTo find where the function is concave up, we need to solve ${f}^{″}(x)>0:$\n\n$$\n\\begin{aligned}2-\\frac{2}{{x}^{3}} & >0 \\\\ 2 & >\\frac{2}{{x}^{3}} \\\\ {x}^{3} & >1 \\\\ x & >1\\end{aligned}\n$$\n\nNote that we used the fact that $x>0.$\n\nHence, ${f}^{″}(x)>0$ when $x>1.$ So the graph is concave up on the interval $(1,\\infty ).$\n\nThe function $f(x)$ is concave down when ${f}^{″}(x)<0.$ By similar reasoning to before, this leads to the inequality $2-\\frac{2}{{x}^{3}}<0,$ which has the solution $(0,1).$\n\nTherefore, the correct answer is \" “$f(x)$ is concave down on $(0,1)$” only.\""} {:db/id #edb/ref 17592186290445 :knowledge-point/_questions [{:db/id #edb/ref 17592186059683 :knowledge-point/id #uuid "bba0ad98-6940-502a-873c-8a589a03a499" :knowledge-point/title "Finding Coterminal Angles in Degrees"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "438e4ae1-dec4-541f-bc71-9f29cc1eaab0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465893} {:answer/id #uuid "7a9ced1e-ad94-566f-aeda-fe4c34436c71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465894}] :answer-field/correct {:answer/id #uuid "7a9ced1e-ad94-566f-aeda-fe4c34436c71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465894} :answer-field/id #uuid "daad3acd-b8bf-5e86-910c-d0a63a90988e" :answer-field/key "${625}^{∘}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466790} {:answer-field/choices [{:answer/id #uuid "f55be858-1473-5d1c-8a52-ac1046a9bb98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465895} {:answer/id #uuid "7ea7713b-f938-50c1-aeb3-3e1053fc94d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465896}] :answer-field/correct {:answer/id #uuid "f55be858-1473-5d1c-8a52-ac1046a9bb98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465895} :answer-field/id #uuid "87c75c20-6d08-50bd-a57a-7fc6e93f4c49" :answer-field/key "${160}^{∘}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466791} {:answer-field/choices [{:answer/id #uuid "ed1fbb42-76aa-5dee-a67f-6420ccdefab9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465897} {:answer/id #uuid "0244befe-f2f7-56a7-b536-ba23abf3af78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465898}] :answer-field/correct {:answer/id #uuid "0244befe-f2f7-56a7-b536-ba23abf3af78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465898} :answer-field/id #uuid "6e17448c-1e24-55f5-8b2e-03cef8ac95c2" :answer-field/key "$-{455}^{∘}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466792}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ca248134-22cf-5031-924c-1fcc047804dc" :question/math-academy-id "q-22979" :question/problem "Which of the following angles are coterminal with $\\theta =-{95}^{∘}?$\n\nSelect all that apply." :question/worked-solution "To find the coterminal angles of a given angle $\\theta $, we add and subtract integer multiples of ${360}^{∘}:$\n\nLet's start by adding multiples of ${360}^{∘}$ to $-{95}^{∘}$:\n\n- $-{95}^{∘}+{360}^{∘}={265}^{∘}$\n\n- $-{95}^{∘}+2\\cdot {360}^{∘}={625}^{∘}\\,✓$\n\nOf the given values, there is no angle greater than ${625}^{∘}.$ So we can stop there.\n\nNow, let's subtract multiples of ${360}^{∘}$ from $-{95}^{∘}$\n\n- $-{95}^{∘}-{360}^{∘}=-{455}^{∘}\\,✓$\n\nOf the given angles, only ${625}^{∘}$ and $-{455}^{∘}$ are coterminal with $-{95}^{∘}.$\n\nSo the correct answer is ${625}^{∘}$ and $-{455}^{∘}$ only."} {:db/id #edb/ref 17592186290551 :knowledge-point/_questions [{:db/id #edb/ref 17592186064165 :knowledge-point/id #uuid "ae256269-0bec-5d57-ac4a-eb0b07926f6f" :knowledge-point/title "Finding Critical Points and Then Classifying Them Using the Second Derivative Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee22d465-d23e-58bb-a6e5-985647947a34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450346} {:answer/id #uuid "7e34cca7-55fc-587a-bb52-a396107f52a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450347}] :answer-field/correct {:answer/id #uuid "7e34cca7-55fc-587a-bb52-a396107f52a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450347} :answer-field/id #uuid "7246a483-a8ef-5043-9866-6db6fa53f5ad" :answer-field/key "${f}^{″}(-1)>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451127} {:answer-field/choices [{:answer/id #uuid "dd452fad-9cba-5e07-86b5-10e6871d8091" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450348} {:answer/id #uuid "f086abf8-0c02-5c83-a2e2-b6a7fd238294" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450349}] :answer-field/correct {:answer/id #uuid "f086abf8-0c02-5c83-a2e2-b6a7fd238294" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450349} :answer-field/id #uuid "a9e2a6eb-89de-515b-9ce8-7b6b1e2ed08a" :answer-field/key "$x=-1$ is a relative minimum of $f(x)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451128} {:answer-field/choices [{:answer/id #uuid "c52fe628-ed09-520c-8441-a3ffcc62317b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450350} {:answer/id #uuid "b37b58c5-d023-5311-b595-b6b169f70a5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450351}] :answer-field/correct {:answer/id #uuid "b37b58c5-d023-5311-b595-b6b169f70a5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450351} :answer-field/id #uuid "29b55f32-c23f-5e75-8003-0539296ef71d" :answer-field/key "${f}^{″}(1)<0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451129} {:answer-field/choices [{:answer/id #uuid "4789f33f-278a-5e8d-aaf4-e2ffad279372" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450352} {:answer/id #uuid "07929eaa-92d6-5560-be11-cb292fd561d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450353}] :answer-field/correct {:answer/id #uuid "4789f33f-278a-5e8d-aaf4-e2ffad279372" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450352} :answer-field/id #uuid "b8383fb1-af8f-5408-b4c9-fe4b8918e41d" :answer-field/key "$x=1$ is a relative minimum of $f(x)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451130}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "abc739c6-0758-56d6-9f78-098fd3207a39" :question/math-academy-id "q-2455" :question/problem "For the function $f(x)=3x-{x}^{3},$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "We need to identify the critical points. Then, we then need to classify them using the second derivative test.\n\nFirst, we need to identify the critical points. Differentiating $f(x)=3x-{x}^{3},$ we get\n\n$$\n{f}^{′}(x)=3-3{x}^{2},\n$$\n\nand solving ${f}^{′}(x)=0,$ we get\n\n$$\n\\begin{aligned}3-3{x}^{2} & =0 \\\\ 3(1-{x}^{2}) & =0 \\\\ 3(1-x)(1+x) & =0 \\\\ x & =\\pm 1.\\end{aligned}\n$$\n\nSo we have critical points at $x=\\pm 1.$\n\nNext, we need to determine the sign of ${f}^{″}(x)$ at the critical points. Computing ${f}^{″}(x),$ we get\n\n$$\n{f}^{″}(x)=-6x,\n$$\n\nand evaluating ${f}^{″}(x)$ at each critical point, we get\n\n$$\n\\begin{aligned}{f}^{″}(-1) & =6>0 \\\\ {f}^{″}(1) & =-6<0.\\end{aligned}\n$$\n\nWe conclude that:\n\n- Statements ${f}^{″}(-1)>0$ and “$x=-1$ is a relative minimum of $f(x)$” are true. The second derivative is positive at $x=-1,$ so this is a relative minimum of $f(x).$\n\n- Statement ${f}^{″}(1)<0$ is true while statement “$x=1$ is a relative minimum of $f(x)$” is false. The second derivative is negative at $x=1,$ so this is a relative maximum of $f(x).$\n\nTherefore, the correct answer is ${f}^{″}(-1)>0$; “$x=-1$ is a relative minimum of $f(x)$”; ${f}^{″}(1)<0$ only."} {:db/id #edb/ref 17592186290566 :knowledge-point/_questions [{:db/id #edb/ref 17592186064165 :knowledge-point/id #uuid "ae256269-0bec-5d57-ac4a-eb0b07926f6f" :knowledge-point/title "Finding Critical Points and Then Classifying Them Using the Second Derivative Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c29fd2a-ae48-52ee-ba67-7067dea380f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465899} {:answer/id #uuid "14c90ded-4dbd-5cc9-b578-8bbcf18e2466" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465900}] :answer-field/correct {:answer/id #uuid "5c29fd2a-ae48-52ee-ba67-7067dea380f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465899} :answer-field/id #uuid "06a90856-9f38-5923-8454-f545e75c55a3" :answer-field/key "${f}^{″}(0)<0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466793} {:answer-field/choices [{:answer/id #uuid "c64831ae-fe38-5483-9592-34c5ba078eb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465901} {:answer/id #uuid "ee9bc399-e38e-51c9-a24b-0515e5e03aa6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465902}] :answer-field/correct {:answer/id #uuid "ee9bc399-e38e-51c9-a24b-0515e5e03aa6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465902} :answer-field/id #uuid "3d4d7c55-71d2-50d5-95fe-51e81764dd1c" :answer-field/key "$x=0$ is a relative minimum of $f(x)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466794} {:answer-field/choices [{:answer/id #uuid "83cdc54b-214f-5986-8b82-254b42883bae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465903} {:answer/id #uuid "acac67e3-2f8e-55cd-b42c-649006d58792" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465904}] :answer-field/correct {:answer/id #uuid "83cdc54b-214f-5986-8b82-254b42883bae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465903} :answer-field/id #uuid "954c2c17-de3e-55b9-acbc-5eb1abb3d144" :answer-field/key "${f}^{″}(1)>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466795} {:answer-field/choices [{:answer/id #uuid "468616b9-692e-5d47-8126-953037fcb574" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465905} {:answer/id #uuid "ca3be01e-97a7-508b-b3c9-0ecc4baeb375" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465906}] :answer-field/correct {:answer/id #uuid "ca3be01e-97a7-508b-b3c9-0ecc4baeb375" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465906} :answer-field/id #uuid "a55e8f74-90ed-54c3-aa6c-dbaf15781e10" :answer-field/key "$x=1$ is a relative maximum of $f(x)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466796}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "54523433-2b3d-5350-9453-344ec229fc6f" :question/math-academy-id "q-2469" :question/problem "For the function $f(x)=6{x}^{2}-4{x}^{3},$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "We need to identify the critical points. Then, we then need to classify them using the second derivative test.\n\nFirst, we need to identify the critical points. Differentiating $f(x)=6{x}^{2}-4{x}^{3},$ we get\n\n$$\n{f}^{′}(x)=12x-12{x}^{2},\n$$\n\nand solving ${f}^{′}(x)=0,$ we get\n\n$$\n\\begin{aligned}12x-12{x}^{2} & =0 \\\\ 12x(1-x) & =0 \\\\ x & =0,1.\\end{aligned}\n$$\n\nSo we have critical points at $x=0,1.$\n\nNext, we need to determine the sign of ${f}^{″}(x)$ at the critical points. Computing ${f}^{″}(x),$ we get\n\n$$\n{f}^{″}(x)=12-24x,\n$$\n\nand evaluating ${f}^{″}(x)$ at each critical point, we get\n\n$$\n\\begin{aligned}{f}^{″}(0) & =12>0 \\\\ {f}^{″}(1) & =-12<0.\\end{aligned}\n$$\n\nWe conclude that:\n\n- Statement ${f}^{″}(0)<0$ is false while statement “$x=0$ is a relative minimum of $f(x)$” is true. The second derivative is positive at $x=0,$ so this is a relative minimum of $f(x).$\n\n- Statement ${f}^{″}(1)>0$ is false while statement “$x=1$ is a relative maximum of $f(x)$” is true. The second derivative is negative at $x=1,$ so this is a relative maximum of $f(x).$\n\nTherefore, the correct answer is “$x=0$ is a relative minimum of $f(x)$”; “$x=1$ is a relative maximum of $f(x)$” only."} {:db/id #edb/ref 17592186290567 :knowledge-point/_questions [{:db/id #edb/ref 17592186064165 :knowledge-point/id #uuid "ae256269-0bec-5d57-ac4a-eb0b07926f6f" :knowledge-point/title "Finding Critical Points and Then Classifying Them Using the Second Derivative Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0816a5ca-d233-5de3-b278-dbb902670115" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465907} {:answer/id #uuid "f96b1b20-d897-5062-93f6-064bcde23260" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465908}] :answer-field/correct {:answer/id #uuid "f96b1b20-d897-5062-93f6-064bcde23260" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465908} :answer-field/id #uuid "b7b45853-6985-5b1c-a81d-b66dab8d14e0" :answer-field/key "${f}^{″}(0)>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466797} {:answer-field/choices [{:answer/id #uuid "99387c6c-3ddf-5e6c-999e-d41fdd79f070" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465909} {:answer/id #uuid "1d219022-9306-536f-949c-6d874ce26dbf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465910}] :answer-field/correct {:answer/id #uuid "99387c6c-3ddf-5e6c-999e-d41fdd79f070" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465909} :answer-field/id #uuid "ccc10a60-f3da-5766-9a59-91d8841ae5e6" :answer-field/key "$x=0$ is a relative maximum of $f(x)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466798} {:answer-field/choices [{:answer/id #uuid "039db766-6a2b-5ff0-9a62-f0e43addb0ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465911} {:answer/id #uuid "39662058-7b0d-5dc9-907a-8c4194cce15f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465912}] :answer-field/correct {:answer/id #uuid "39662058-7b0d-5dc9-907a-8c4194cce15f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465912} :answer-field/id #uuid "878ea395-503e-5466-87e1-15fafb7cda6c" :answer-field/key "${f}^{″}(-2)<0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466799} {:answer-field/choices [{:answer/id #uuid "0baea45a-e521-55e5-a85e-0c96f76c085a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465913} {:answer/id #uuid "eef39c75-0496-5cd9-98db-a11876ef340b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465914}] :answer-field/correct {:answer/id #uuid "0baea45a-e521-55e5-a85e-0c96f76c085a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465913} :answer-field/id #uuid "beccd9e8-da77-5e9d-bc60-9f35d6fbabba" :answer-field/key "$x=-2$ is a relative minimum of $f(x)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466800}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "19694b62-f531-5e43-9d81-ba1b9a788be0" :question/math-academy-id "q-2471" :question/problem "For the function $f(x)=5{x}^{3}+15{x}^{2}-10,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "We need to identify the critical points. Then, we then need to classify them using the second derivative test.\n\nFirst, we need to identify the critical points. Differentiating $f(x)=5{x}^{3}+15{x}^{2}-10,$ we get\n\n$$\n{f}^{′}(x)=15{x}^{2}+30x,\n$$\n\nand solving ${f}^{′}(x)=0,$ we get\n\n$$\n\\begin{aligned}15{x}^{2}+30x & =0 \\\\ 15x(x+2) & =0 \\\\ x & =0,-2.\\end{aligned}\n$$\n\nSo we have critical points at $x=0,-2.$\n\nNext, we need to determine the sign of ${f}^{″}(x)$ at the critical points. Computing ${f}^{″}(x),$ we get\n\n$$\n{f}^{″}(x)=30x+30,\n$$\n\nand evaluating ${f}^{″}(x)$ at each critical point, we get\n\n$$\n\\begin{aligned}{f}^{″}(0) & =30>0 \\\\ {f}^{″}(-2) & =-30<0.\\end{aligned}\n$$\n\nWe conclude that:\n\n- Statements ${f}^{″}(0)>0$ is true while statement “$x=0$ is a relative maximum of $f(x)$” is false. The second derivative is positive at $x=0,$ so this is a relative minimum of $f(x).$\n\n- Statements ${f}^{″}(-2)<0$ is true while statement “$x=-2$ is a relative minimum of $f(x)$” is false. The second derivative is negative at $x=-2,$ so this is a relative maximum of $f(x).$\n\nTherefore, the correct answer is ${f}^{″}(0)>0$; ${f}^{″}(-2)<0$ only."} {:db/id #edb/ref 17592186292543 :knowledge-point/_questions [{:db/id #edb/ref 17592186129287 :knowledge-point/id #uuid "b4ade459-9aba-5520-95d3-69ef3fd62d9d" :knowledge-point/title "Classifying Recurrence Relations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ceaf758c-a8dd-5a9a-adee-637fa878f318" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465915} {:answer/id #uuid "36706676-91f8-50e4-adfb-60ef265d6f00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465916}] :answer-field/correct {:answer/id #uuid "36706676-91f8-50e4-adfb-60ef265d6f00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465916} :answer-field/id #uuid "d82bf7ae-578c-5f2b-9416-c4e0327e5258" :answer-field/key "${a}_{n}=2{a}_{n-1}+5{a}_{n-2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466801} {:answer-field/choices [{:answer/id #uuid "27f2539d-95b7-53fa-a714-8f58f9a9072d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465917} {:answer/id #uuid "35643f7e-51f3-58ac-8d43-310fefbcf937" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465918}] :answer-field/correct {:answer/id #uuid "35643f7e-51f3-58ac-8d43-310fefbcf937" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465918} :answer-field/id #uuid "21d81d7d-ae51-58cc-855e-0239b4ddc4ba" :answer-field/key "${b}_{n}={b}_{n-1}+3{b}_{n-2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466802} {:answer-field/choices [{:answer/id #uuid "fa265853-ac3f-54ad-b2e1-197486cd24ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465919} {:answer/id #uuid "a1f6d4ed-c8d7-54de-b410-4c092cb9100b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465920}] :answer-field/correct {:answer/id #uuid "fa265853-ac3f-54ad-b2e1-197486cd24ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465919} :answer-field/id #uuid "369d61de-0362-5726-9043-d7210b37adca" :answer-field/key "${c}_{n}=4{c}_{n-1}+7n$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466803}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5c70458e-a9c0-5f53-8bd6-90f09521b402" :question/math-academy-id "q-253144" :question/problem "Which of the following linear recurrence relations are homogeneous?\n\nSelect all that apply." :question/worked-solution "A linear recurrence relation (with constant coefficients) is **homogeneous** if the forcing function is zero. \n\nIn other words, the linear recurrence relation\n\n$$\n{a}_{n}={s}_{1}{a}_{n-1}+{s}_{2}{a}_{n-2}+…+{s}_{k}{a}_{n-k}+g(n),\n$$\n\nis homogeneous if $g(n)=0$ for all $n,$ and ${s}_{i}$ is constant for each $i.$\n\nLet's examine each recurrence relation in turn.\n\n- ${a}_{n}$ is homogeneous. The terms of the expression each contain a preceding term, ${a}_{n-1}$ and ${a}_{n-2}.$\n\n- ${b}_{n}$ is homogeneous. The terms of the expression each contain a preceding term, ${b}_{n-1}$ and ${b}_{n-2}.$\n\n- ${c}_{n}$ is not homogeneous. The term $7n$ of the expression doesn't contain preceding terms of the relation.\n\nTherefore, the correct answer is ${a}_{n}=2{a}_{n-1}+5{a}_{n-2}$; ${b}_{n}={b}_{n-1}+3{b}_{n-2}$ only."} {:db/id #edb/ref 17592186292557 :knowledge-point/_questions [{:db/id #edb/ref 17592186129287 :knowledge-point/id #uuid "b4ade459-9aba-5520-95d3-69ef3fd62d9d" :knowledge-point/title "Classifying Recurrence Relations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a42de4ff-e6ae-5cd0-a779-289253a7aa66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465921} {:answer/id #uuid "2e189d6c-8ef7-539f-b37f-87d967920ae9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465922}] :answer-field/correct {:answer/id #uuid "a42de4ff-e6ae-5cd0-a779-289253a7aa66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465921} :answer-field/id #uuid "d6a0f5a4-4ed4-51c8-be72-bc1c74b87ed7" :answer-field/key "${a}_{n}=\\frac{{a}_{n-2}}{2}+3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466804} {:answer-field/choices [{:answer/id #uuid "da65221a-be97-5688-8bd6-0d038b753c89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465923} {:answer/id #uuid "49f88e20-d91f-5914-9c9d-d823f5133e73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465924}] :answer-field/correct {:answer/id #uuid "da65221a-be97-5688-8bd6-0d038b753c89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465923} :answer-field/id #uuid "fcadfd18-6479-5741-a737-46067ac802f1" :answer-field/key "${b}_{n}=2{b}_{n-1}-{b}_{n-2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466805} {:answer-field/choices [{:answer/id #uuid "100989ed-9df9-5bed-8d9f-5d7deedc7db5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465925} {:answer/id #uuid "d293d52d-2035-55a0-bb5f-6f14c2e9051f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465926}] :answer-field/correct {:answer/id #uuid "d293d52d-2035-55a0-bb5f-6f14c2e9051f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465926} :answer-field/id #uuid "81bda147-d05b-535a-b0e7-50b958de0862" :answer-field/key "${c}_{n}={c}_{n-1}+\\frac{1}{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466806}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5e47f465-4e25-5a70-adfe-d172f722b8f2" :question/math-academy-id "q-253467" :question/problem "Which of the following recurrence relations are first-order?\n\nSelect all that apply." :question/worked-solution "The order of a recurrence relation is the largest index difference between ${a}_{n}$ and the preceding terms in the relation.\n\nLet's examine each recurrence relation in turn.\n\n- The largest index difference between ${a}_{n}$ and the preceding term ${a}_{n-2}$ in the relation is $2.$ So, this recurrence relation has order $2.$\n\n- The largest index difference between ${b}_{n}$ and the preceding terms ${b}_{n-1}$ and ${b}_{n-2}$ in the relation is $2.$ So, this recurrence relation has order $2.$\n\n- The largest index difference between ${c}_{n}$ and the preceding term ${c}_{n-1}$ in the relation is $1.$ So, this recurrence relation has order $1.$\n\nTherefore, the correct answer is ${c}_{n}={c}_{n-1}+\\frac{1}{3}$ only."} {:db/id #edb/ref 17592186292558 :knowledge-point/_questions [{:db/id #edb/ref 17592186129287 :knowledge-point/id #uuid "b4ade459-9aba-5520-95d3-69ef3fd62d9d" :knowledge-point/title "Classifying Recurrence Relations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5da79ef1-96cb-5b4e-9a6b-18070aae8aec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465927} {:answer/id #uuid "398214ec-746e-5583-915d-4658e5d0dbde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465928}] :answer-field/correct {:answer/id #uuid "398214ec-746e-5583-915d-4658e5d0dbde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465928} :answer-field/id #uuid "19bb0097-8ef2-5782-8199-519f11f865d6" :answer-field/key "${a}_{n}={a}_{n-1}^{2}+\\frac{1}{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466807} {:answer-field/choices [{:answer/id #uuid "ad77f923-4030-5476-996b-784990b92fb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465929} {:answer/id #uuid "9346465e-5a61-55af-9a94-19b9dcc759a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465930}] :answer-field/correct {:answer/id #uuid "ad77f923-4030-5476-996b-784990b92fb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465929} :answer-field/id #uuid "e7c92733-17a3-5258-b286-10ae5a0ef1fe" :answer-field/key "${b}_{n}=3{b}_{n-2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466808} {:answer-field/choices [{:answer/id #uuid "cd529a44-0779-54c2-95df-072238b94801" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465931} {:answer/id #uuid "786086b8-cc44-5fd7-9bfc-882037cb442c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465932}] :answer-field/correct {:answer/id #uuid "cd529a44-0779-54c2-95df-072238b94801" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465931} :answer-field/id #uuid "42aaa3c5-3ced-5e99-bc66-7f76f09bd5a8" :answer-field/key "${c}_{n}=\\frac{{c}_{n-1}}{3}-2{c}_{n-3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466809}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a1f62b55-725b-50fe-8589-865ff5ea3249" :question/math-academy-id "q-253468" :question/problem "Which of the following recurrence relations are first-order?\n\nSelect all that apply." :question/worked-solution "The order of a recurrence relation is the largest index difference between ${a}_{n}$ and the preceding terms in the relation.\n\nLet's examine each recurrence relation in turn.\n\n- The largest index difference between ${a}_{n}$ and the preceding term ${a}_{n-1}$ in the relation is $1.$ So, this recurrence relation has order $1.$\n\n- The largest index difference between ${b}_{n}$ and the preceding terms ${b}_{n-1}$ and ${b}_{n-2}$ in the relation is $2.$ So, this recurrence relation has order $2.$\n\n- The largest index difference between ${c}_{n}$ and the preceding terms ${c}_{n-1}$ and ${c}_{n-3}$ in the relation is $3.$ So, this recurrence relation has order $3.$\n\nTherefore, the correct answer is ${a}_{n}={a}_{n-1}^{2}+\\frac{1}{2}$ only."} {:db/id #edb/ref 17592186292560 :knowledge-point/_questions [{:db/id #edb/ref 17592186129287 :knowledge-point/id #uuid "b4ade459-9aba-5520-95d3-69ef3fd62d9d" :knowledge-point/title "Classifying Recurrence Relations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c562287f-567e-5b18-bc0f-0b1b5bc53786" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465933} {:answer/id #uuid "b676f57f-c612-58f3-b1f9-ab2eda52999a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465934}] :answer-field/correct {:answer/id #uuid "b676f57f-c612-58f3-b1f9-ab2eda52999a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465934} :answer-field/id #uuid "baca2b5b-37c8-5461-9a3e-aeed84c2afb9" :answer-field/key "${a}_{n}=3{a}_{n-1}+2{a}_{n-2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466810} {:answer-field/choices [{:answer/id #uuid "31e593dd-03bc-55d1-8ffe-d75533e7e4f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465935} {:answer/id #uuid "ac620402-9be4-5757-b9be-96f7e9ddb994" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465936}] :answer-field/correct {:answer/id #uuid "31e593dd-03bc-55d1-8ffe-d75533e7e4f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465935} :answer-field/id #uuid "b37b9455-3dc9-536e-b50d-f750f9d9c6a6" :answer-field/key "${b}_{n}=4{b}_{n-1}+{n}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466811} {:answer-field/choices [{:answer/id #uuid "0ce4f14c-d841-5934-8daa-69c9dc4cafdc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465937} {:answer/id #uuid "e738c6db-1cbb-5165-ba45-9828ee83b503" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465938}] :answer-field/correct {:answer/id #uuid "e738c6db-1cbb-5165-ba45-9828ee83b503" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465938} :answer-field/id #uuid "a487c1ee-a33f-548d-ba2f-e195f1eed56d" :answer-field/key "${c}_{n}=5{c}_{n-1}+6{c}_{n-2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466812}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6aaec8bd-79a0-54bb-bcfb-1f08b1113c88" :question/math-academy-id "q-253485" :question/problem "Which of the following linear recurrence relations are homogeneous?\n\nSelect all that apply." :question/worked-solution "A linear recurrence relation (with constant coefficients) is **homogeneous** if the forcing function is zero. \n\nIn other words, the linear recurrence relation\n\n$$\n{a}_{n}={s}_{1}{a}_{n-1}+{s}_{2}{a}_{n-2}+…+{s}_{k}{a}_{n-k}+g(n),\n$$\n\nis homogeneous if $g(n)=0$ for all $n,$ and ${s}_{i}$ is constant for each $i.$\n\nLet's examine each recurrence relation in turn.\n\n- ${a}_{n}$ is homogeneous. The terms of the expression each contain a preceding term, ${a}_{n-1}$ and ${a}_{n-2}.$\n\n- ${b}_{n}$ is not homogeneous. The term ${n}^{2}$ of the expression doesn't contain preceding terms of the relation.\n\n- ${c}_{n}$ is homogeneous. The terms of the expression each contain a preceding term, ${c}_{n-1}$ and ${c}_{n-2}.$\n\nTherefore, the correct answer is ${a}_{n}=3{a}_{n-1}+2{a}_{n-2}$; ${c}_{n}=5{c}_{n-1}+6{c}_{n-2}$ only."} {:db/id #edb/ref 17592186292684 :knowledge-point/_questions [{:db/id #edb/ref 17592186064164 :knowledge-point/id #uuid "2106ea68-f48f-5372-87c0-fa8126509655" :knowledge-point/title "Discarding Stationary Points of a Function on a Given Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8113e12-037b-5ab4-8904-cc26f703b298" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450354} {:answer/id #uuid "019a2903-dbfe-585c-b38a-15220753a443" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450355}] :answer-field/correct {:answer/id #uuid "019a2903-dbfe-585c-b38a-15220753a443" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450355} :answer-field/id #uuid "45065698-39ab-59fd-bed6-c15d7ce11961" :answer-field/key "The global maximum value is $3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451131} {:answer-field/choices [{:answer/id #uuid "614ba40b-81e8-5c27-b5c8-db2a50816429" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450356} {:answer/id #uuid "6dcc549e-094b-5829-abd1-b4ff28b232e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450357}] :answer-field/correct {:answer/id #uuid "614ba40b-81e8-5c27-b5c8-db2a50816429" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450356} :answer-field/id #uuid "d153b501-4351-5734-939a-e6163cc2d9eb" :answer-field/key "The global minimum value is $1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451132} {:answer-field/choices [{:answer/id #uuid "ae1443bc-459c-54cc-a4b1-75d3d7877f4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450358} {:answer/id #uuid "5d6f513d-ff03-5755-b3f3-78d48219a417" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450359}] :answer-field/correct {:answer/id #uuid "5d6f513d-ff03-5755-b3f3-78d48219a417" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450359} :answer-field/id #uuid "739b8deb-8362-5903-8bb3-eebc8ea9f3fd" :answer-field/key "The global minimum value is $-1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451133}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bea0a781-9898-5e25-a447-5b87446089a9" :question/math-academy-id "q-2690" :question/problem "For the function $f(x)={x}^{3}+6{x}^{2}+9x+3,$ on the closed interval $-4\\le x\\le -2,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's apply the candidates test step by step.\n\n**Step 1**: We find the critical points. Taking the derivative of $f(x)={x}^{3}+6{x}^{2}+9x+3,$ we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =3{x}^{2}+12x+9 \\\\  & =3({x}^{2}+4x+3) \\\\  & =3(x+1)(x+3),\\end{aligned}\n$$\n\nand solving ${f}^{′}(x)=0,$ we get \n\n$$\n3(x+1)(x+3)=0\\,⟹\\,x=-3,\\,-1.\n$$\n\nSince $x=-1$ does not belong to the interval $[-4,-2]$, the critical points are $x=-3$ and the endpoints $x=-4,-2$ (since the derivative is not defined at the endpoints).\n\n**Step 2**: We evaluate $f(x)$ at the critical points.\n\n$$\n\\begin{aligned}f(-4) & =(-4)^{3}+6(-4)^{2}+9(-4)+3=-1 \\\\ f(-3) & =(-3)^{3}+6(-3)^{2}+9(-3)+3=3 \\\\ f(-2) & =(-2)^{3}+6(-2)^{2}+9(-2)+3=1\\end{aligned}\n$$\n\n**Step 3**: We compare all of the values found in step $2.$\n\n- The greatest value is $f(-3)=3,$ so the global maximum is $3.$\n\n- The least value is $f(-4)=-1,$ so the global minimum is $-1.$\n\nTherefore, the correct answer is “The global maximum value is $3$”; “The global minimum value is $-1$” only.\n\n![](images/fa/fa85119166ca325f9925ddd03a578fb5daae463c59c3b7b9f7ac0f6464a30241.png)"} {:db/id #edb/ref 17592186292686 :knowledge-point/_questions [{:db/id #edb/ref 17592186064164 :knowledge-point/id #uuid "2106ea68-f48f-5372-87c0-fa8126509655" :knowledge-point/title "Discarding Stationary Points of a Function on a Given Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "153ce6d6-9514-5bf9-9fe3-72f754790405" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450360} {:answer/id #uuid "129f2af1-2aa6-5a58-aa8f-dda43e7bc34e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450361}] :answer-field/correct {:answer/id #uuid "129f2af1-2aa6-5a58-aa8f-dda43e7bc34e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450361} :answer-field/id #uuid "3d851183-3740-5d93-9abc-1766f25e3467" :answer-field/key "The global maximum value is $4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451134} {:answer-field/choices [{:answer/id #uuid "5b17ed33-ecec-5434-a6e7-ef1ea8e9fac3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450362} {:answer/id #uuid "f47d219c-c54c-5780-9ef5-8d361f12511a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450363}] :answer-field/correct {:answer/id #uuid "5b17ed33-ecec-5434-a6e7-ef1ea8e9fac3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450362} :answer-field/id #uuid "86a21b5f-3f5d-55b8-8d7c-df0eec8633bd" :answer-field/key "The global maximum value is $2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451135} {:answer-field/choices [{:answer/id #uuid "2511606c-1dd6-5eef-bb28-67d245254c48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450364} {:answer/id #uuid "36b70373-347a-5ff5-b990-5a4094595a2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450365}] :answer-field/correct {:answer/id #uuid "2511606c-1dd6-5eef-bb28-67d245254c48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450364} :answer-field/id #uuid "307f45f7-0190-55bf-a7a9-d947daf27287" :answer-field/key "The global minimum value is $0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451136}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e48a4a75-01e8-5c53-b3a8-5931680804d1" :question/math-academy-id "q-2691" :question/problem "For the function $f(x)={x}^{4}-3{x}^{2}+4,$ on the closed interval $-1\\le x\\le 1,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's apply the candidates test step by step.\n\n**Step 1**: We find the critical points. Taking the derivative of $f(x)={x}^{4}-3{x}^{2}+4,$ we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =4{x}^{3}-6x \\\\  & =2x(2{x}^{2}-3),\\end{aligned}\n$$\n\nand solving ${f}^{′}(x)=0,$ we get \n\n$$\n2x(2{x}^{2}-3)=0\\,⟹\\,x=0,\\,\\pm \\sqrt{\\frac{3}{2}}.\n$$\n\nSince $x=\\pm \\sqrt{\\frac{3}{2}}$ do not belong to the interval $[-1,1]$, the critical points are $x=0$ and the endpoints $x=-1,1$ (since the derivative is not defined at the endpoints).\n\n**Step 2**: We evaluate $f(x)$ at the critical points.\n\n$$\n\\begin{aligned}f(-1) & =(-1)^{4}-3(-1)^{2}+4=2 \\\\ f(0) & =(0)^{4}-3(0)^{2}+4=4 \\\\ f(1) & =(1)^{4}-3(1)^{2}+4=2\\end{aligned}\n$$\n\n**Step 3**: We compare all of the values found in step $2.$\n\n- The greatest value is $f(0)=4,$ so the global maximum is $4.$\n\n- The least value is $f(-1)=f(1)=2,$ so the global minimum is $2.$\n\nTherefore, the correct answer is “The global maximum value is $4$” only.\n\n![](images/a7/a7141a342d971d5b520b2f7f07f8fdb1c01ddca18a983fb0c83102a5bd4aee8e.png)"} {:db/id #edb/ref 17592186292696 :knowledge-point/_questions [{:db/id #edb/ref 17592186176047 :knowledge-point/id #uuid "542df339-5020-5680-a39c-a1ae161083e7" :knowledge-point/title "Describing Properties of the Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5868b07-bcc9-5439-8718-abc34721e4f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438022} {:answer/id #uuid "b4492437-18b0-5ea5-afe3-0c95f6e8c559" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438023}] :answer-field/correct {:answer/id #uuid "b4492437-18b0-5ea5-afe3-0c95f6e8c559" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438023} :answer-field/id #uuid "049db57c-a0e7-56de-b01d-934b8edb71e7" :answer-field/key "The function intersects the $x$-axis at $x=\\frac{\\pi }{2}.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439040} {:answer-field/choices [{:answer/id #uuid "f4c2d785-bfd8-52bd-920b-fdf30600fb45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438024} {:answer/id #uuid "65d473ca-16c2-5906-9a4b-4d38e4d203a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438025}] :answer-field/correct {:answer/id #uuid "f4c2d785-bfd8-52bd-920b-fdf30600fb45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438024} :answer-field/id #uuid "e8b8f0da-7701-59ac-b62e-e3c7f0b5a210" :answer-field/key "The function has a minimum value at  $x=2\\pi .$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439041} {:answer-field/choices [{:answer/id #uuid "88d518a6-aec2-5916-b3c0-47b033deb6e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438026} {:answer/id #uuid "0e2171a1-1911-5a58-a449-b31bc5f2edce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438027}] :answer-field/correct {:answer/id #uuid "88d518a6-aec2-5916-b3c0-47b033deb6e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438026} :answer-field/id #uuid "cf911183-758e-5ef8-9432-74581ddfaa58" :answer-field/key "The function intersects the $y$-axis at $y=0.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439042}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "69137884-05b3-53be-9c7c-95b53b1ed329" :question/math-academy-id "q-27009" :question/problem "Which of the following statements are true regarding the function $y=\\operatorname{cos}⁡x?$\n\nSelect all that apply." :question/worked-solution "Let's plot the graph of $y=cos⁡x.$\n\n![](images/9c/9c77bec4ebb04668fbff5176418ed9c09143a8660879fdf523a158c5f109006c.png)\n\nLet's go through each statement.\n\n- Statement “The function intersects the $x$-axis at $x=\\frac{\\pi }{2}.$” is true. At $x=\\frac{\\pi }{2}$ the function intersects the $x$-axis.\n\n- Statement “The function has a minimum value at  $x=2\\pi .$” is false. The function has a maximum at $x=2\\pi .$\n\n- Statement “The function intersects the $y$-axis at $y=0.$” is false. The function intersects the $y$-axis at $y=1.$"} {:db/id #edb/ref 17592186297168 :knowledge-point/_questions [{:db/id #edb/ref 17592186176049 :knowledge-point/id #uuid "4241c7bd-4a2b-556f-be9f-8a884addebb9" :knowledge-point/title "Describing Properties of the Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df692c1e-d1d5-5935-aa4f-58e66111c366" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438034} {:answer/id #uuid "9b4152bd-b840-569a-98b3-f7a6bbc4543b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438035}] :answer-field/correct {:answer/id #uuid "9b4152bd-b840-569a-98b3-f7a6bbc4543b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438035} :answer-field/id #uuid "4c4ce857-699d-5650-bbce-c9a33e567439" :answer-field/key "$tan⁡(x+\\pi )=tan⁡(x+n\\pi ).$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439046} {:answer-field/choices [{:answer/id #uuid "0ebcf390-41da-5232-afcf-76ca3cd35d70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438036} {:answer/id #uuid "c855dbc6-62a7-535d-acf4-3e0422823e8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438037}] :answer-field/correct {:answer/id #uuid "0ebcf390-41da-5232-afcf-76ca3cd35d70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438036} :answer-field/id #uuid "c9ad80d7-8062-5402-b3db-57b743c9edc8" :answer-field/key "The function has asymptotes at $x=n\\pi $" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439047} {:answer-field/choices [{:answer/id #uuid "4b955e63-485d-5f8d-acaf-14b8077b8a15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438038} {:answer/id #uuid "2efbdf03-740a-56f5-983f-e118131d7d73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438039}] :answer-field/correct {:answer/id #uuid "2efbdf03-740a-56f5-983f-e118131d7d73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438039} :answer-field/id #uuid "97cebb1e-e8e5-51e9-a969-4786401b7b78" :answer-field/key "$tan⁡(x-\\frac{\\pi }{2})=tan⁡(x+\\frac{\\pi }{2}).$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439048}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4be11add-d875-5219-b83f-33d16bf37abb" :question/math-academy-id "q-28675" :question/problem "Which of the following statements are true regarding the function $y=tan⁡x?$ Assume that $n$ represents any integer.\n\nSelect all that apply." :question/worked-solution "Let's recall the graph of $y=tan⁡x.$\n\n![](images/31/31b430f003171dcc04a8f17402d6035fbbc305c244d3676bbf5da83fa447bd50.png)\n\nLet's examine each statement.\n\n- Statement $tan⁡(x+\\pi )=tan⁡(x+n\\pi ).$ is true. The function $y=tan⁡x$ has period $\\pi .$ So, $tan⁡(x+\\pi )=tan⁡(x)=tan⁡(x+n\\pi )$ for any integer $n.$\n\n- Statement “The function has asymptotes at $x=n\\pi $” is false. The function $y=tan⁡x$ has asymptotes at $x=\\frac{\\pi }{2}+\\pi n.$\n\n- Statement $tan⁡(x-\\frac{\\pi }{2})=tan⁡(x+\\frac{\\pi }{2}).$ is true. The function $y=tan⁡x$ has period $\\pi .$ So, $tan⁡(x-\\frac{\\pi }{2})=tan⁡(x-\\frac{\\pi }{2}+\\pi )=tan⁡(x+\\frac{\\pi }{2}).$"} {:db/id #edb/ref 17592186297172 :knowledge-point/_questions [{:db/id #edb/ref 17592186204089 :knowledge-point/id #uuid "d6226fdb-ee73-5a78-87d5-9d6a988a9eb4" :knowledge-point/title "Identifying an Equation With No Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "533b9094-d677-5376-88f4-8f426a2a4cf6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438046} {:answer/id #uuid "2b5a3d38-5a54-5a47-a0a8-64956fa7cdee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438047}] :answer-field/correct {:answer/id #uuid "2b5a3d38-5a54-5a47-a0a8-64956fa7cdee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438047} :answer-field/id #uuid "bd3eb9cd-0eda-53a6-bbc3-9f6bfbd15e06" :answer-field/key "$-3u+4=-3u-1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439052} {:answer-field/choices [{:answer/id #uuid "38767ef4-49fe-519a-b838-3b77b5b7521b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438048} {:answer/id #uuid "36138474-e8c9-5d26-acfa-e3b7ef2f057d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438049}] :answer-field/correct {:answer/id #uuid "36138474-e8c9-5d26-acfa-e3b7ef2f057d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438049} :answer-field/id #uuid "e6d2fdbb-10bc-55e5-8c2c-6df645004975" :answer-field/key "$2u+5=2u+8$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439053} {:answer-field/choices [{:answer/id #uuid "4435d623-199a-5d01-8347-ab72dc2191c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438050} {:answer/id #uuid "83476a1a-ee79-50fd-b7a1-580c8914eb50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438051}] :answer-field/correct {:answer/id #uuid "4435d623-199a-5d01-8347-ab72dc2191c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438050} :answer-field/id #uuid "5259194c-9195-582d-b7ec-c468a67fa9be" :answer-field/key "$6u-2=3u+1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439054}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1b892079-10a1-5d68-a34f-01695fac566e" :question/math-academy-id "q-288066" :question/problem "Which of the following equations has no solutions?\n\nSelect all that apply." :question/worked-solution "Let's attempt to solve each equation in turn:\n\n- For the first equation, we have\n\n$$\n\\begin{aligned}-3u+4 & =-3u-1 \\\\ -3u+4+3u & =-3u-1+3u \\\\ 4 & =-1.\\end{aligned}\n$$\n\nThis equation is false for all values of $u.$ Therefore, the equation $-3u+4=-3u-1$ has no solutions.\n\n- For the second equation, we have\n\n$$\n\\begin{aligned}2u+5 & =2u+8 \\\\ 2u+5-2u & =2u+8-2u \\\\ 5 & =8.\\end{aligned}\n$$\n\nThis equation is false for all values of $u.$ Therefore, the equation $2u+5=2u+8$ has no solutions.\n\n- For the third equation, we have\n\n$$\n\\begin{aligned}6u-2 & =3u+1 \\\\ 6u-2-3u+2 & =3u+1-3u+2 \\\\ 3u & =3 \\\\ u & =1.\\end{aligned}\n$$\n\nTherefore, the equation $6u-2=3u+1$ has the unique solution $u=1.$\n\nTherefore, the correct answer is $-3u+4=-3u-1$; $2u+5=2u+8$ only."} {:db/id #edb/ref 17592186297173 :knowledge-point/_questions [{:db/id #edb/ref 17592186204089 :knowledge-point/id #uuid "d6226fdb-ee73-5a78-87d5-9d6a988a9eb4" :knowledge-point/title "Identifying an Equation With No Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bbb7117-6145-53ca-ad4c-bad31bb9f9af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438052} {:answer/id #uuid "671b6a92-35b3-597e-be0a-c9cb5b791a09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438053}] :answer-field/correct {:answer/id #uuid "671b6a92-35b3-597e-be0a-c9cb5b791a09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438053} :answer-field/id #uuid "27b44160-5603-5c9b-a638-902e6099883a" :answer-field/key "$-4y+2=-4y-5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439055} {:answer-field/choices [{:answer/id #uuid "4222c763-212d-511f-8fbd-f58190e2e759" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438054} {:answer/id #uuid "3f98701c-3dbf-5adb-90ef-8da0bf27f04a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438055}] :answer-field/correct {:answer/id #uuid "3f98701c-3dbf-5adb-90ef-8da0bf27f04a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438055} :answer-field/id #uuid "0b686279-275d-59b3-9845-affb7909a340" :answer-field/key "$6y+3=6y-1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439056} {:answer-field/choices [{:answer/id #uuid "b38af36b-5c28-52cd-827f-5d2c79c4e02b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438056} {:answer/id #uuid "5c014ef5-df66-55a4-9f0c-a5b36748f66b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438057}] :answer-field/correct {:answer/id #uuid "b38af36b-5c28-52cd-827f-5d2c79c4e02b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438056} :answer-field/id #uuid "61cc02af-d6dd-57ac-bd35-0666f970edb9" :answer-field/key "$5y-7=2y+1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439057}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9e1fdbd8-4927-548c-aafb-62f0ed007aa2" :question/math-academy-id "q-288070" :question/problem "Which of the following equations has no solutions?\n\nSelect all that apply." :question/worked-solution "Let's attempt to solve each equation in turn:\n\n- For the first equation, we have\n\n$$\n\\begin{aligned}-4y+2 & =-4y-5 \\\\ -4y+2+4y & =-4y-5+4y \\\\ 2 & =-5.\\end{aligned}\n$$\n\nThis equation is false for all values of $y.$ Therefore, the equation $-4y+2=-4y-5$ has no solutions.\n\n- For the second equation, we have\n\n$$\n\\begin{aligned}6y+3 & =6y-1 \\\\ 6y+3-6y & =6y-1-6y \\\\ 3 & =-1.\\end{aligned}\n$$\n\nThis equation is false for all values of $y.$ Therefore, the equation $6y+3=6y-1$ has no solutions.\n\n- For the third equation, we have\n\n$$\n\\begin{aligned}5y-7 & =2y+1 \\\\ 5y-7-2y+7 & =2y+1-2y+7 \\\\ 3y & =8 \\\\ y & =\\frac{8}{3}.\\end{aligned}\n$$\n\nTherefore, the equation $5y-7=2y+1$ has the unique solution $y=\\frac{8}{3}.$\n\nTherefore, the correct answer is $-4y+2=-4y-5$; $6y+3=6y-1$ only."} {:db/id #edb/ref 17592186297174 :knowledge-point/_questions [{:db/id #edb/ref 17592186204089 :knowledge-point/id #uuid "d6226fdb-ee73-5a78-87d5-9d6a988a9eb4" :knowledge-point/title "Identifying an Equation With No Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b7fde21a-0d8d-594b-a745-db65189df67f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438058} {:answer/id #uuid "8ece53fa-2eb2-5b1c-b285-9b87f8f4daae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438059}] :answer-field/correct {:answer/id #uuid "8ece53fa-2eb2-5b1c-b285-9b87f8f4daae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438059} :answer-field/id #uuid "84307fe1-029d-5028-aa23-639aad6faaed" :answer-field/key "$2z-4=2z+1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439058} {:answer-field/choices [{:answer/id #uuid "0d5cc2ff-b49f-5c4a-970f-cdbb15792abc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438060} {:answer/id #uuid "e7c10c6b-8ee7-5fa9-9d42-6f7cf79b8350" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438061}] :answer-field/correct {:answer/id #uuid "0d5cc2ff-b49f-5c4a-970f-cdbb15792abc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438060} :answer-field/id #uuid "5867c7b6-4f6f-5a06-af87-9049cb497b9a" :answer-field/key "$5z+6=5z+6$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439059} {:answer-field/choices [{:answer/id #uuid "ee6986a4-2a71-509d-9e9c-688693540c97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438062} {:answer/id #uuid "d69e090d-5eb5-5b4e-b8b4-4433ad55707e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438063}] :answer-field/correct {:answer/id #uuid "ee6986a4-2a71-509d-9e9c-688693540c97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438062} :answer-field/id #uuid "5782e1ec-cdc2-5bee-a672-c727cc727606" :answer-field/key "$3z+2=z+4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439060}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "22403a37-d9b4-5866-bee2-a28d9c27c3b3" :question/math-academy-id "q-288072" :question/problem "Which of the following equations has no solutions?\n\nSelect all that apply." :question/worked-solution "Let's attempt to solve each equation in turn:\n\n- For the first equation, we have\n\n$$\n\\begin{aligned}2z-4 & =2z+1 \\\\ 2z-4-2z & =2z+1-2z \\\\ -4 & =1.\\end{aligned}\n$$\n\nThis equation is false for all values of $z.$ Therefore, the equation $2z-4=2z+1$ has no solutions.\n\n- For the second equation, we have\n\n$$\n\\begin{aligned}5z+6 & =5z+6 \\\\ 5z+6-5z & =5z+6-5z \\\\ 6 & =6.\\end{aligned}\n$$\n\nThis equation is true for all values of $z.$\n\n- For the third equation, we have\n\n$$\n\\begin{aligned}3z+2 & =z+4 \\\\ 3z+2-z-2 & =z+4-z-2 \\\\ 2z & =2 \\\\ z & =1.\\end{aligned}\n$$\n\nTherefore, the equation $3z+2=z+4$ has the unique solution $z=1.$\n\nTherefore, the correct answer is $2z-4=2z+1$ only."} {:db/id #edb/ref 17592186297175 :knowledge-point/_questions [{:db/id #edb/ref 17592186204089 :knowledge-point/id #uuid "d6226fdb-ee73-5a78-87d5-9d6a988a9eb4" :knowledge-point/title "Identifying an Equation With No Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "220ca104-2317-5355-b6f9-238d7b5e2da7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438064} {:answer/id #uuid "29bf254a-4e1b-5c2b-b3eb-48992ead8349" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438065}] :answer-field/correct {:answer/id #uuid "220ca104-2317-5355-b6f9-238d7b5e2da7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438064} :answer-field/id #uuid "ad481161-f390-54f8-b99c-f0b018cbf93d" :answer-field/key "$3w+2=2w+2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439061} {:answer-field/choices [{:answer/id #uuid "7b8b1efb-e712-53d2-a457-f8729510edfa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438066} {:answer/id #uuid "2a584f47-36b5-5f9e-a333-07b07506ccab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438067}] :answer-field/correct {:answer/id #uuid "7b8b1efb-e712-53d2-a457-f8729510edfa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438066} :answer-field/id #uuid "20ba482c-6e9d-5a6e-a9d8-c815e493f55e" :answer-field/key "$4w-7=4w-7$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439062} {:answer-field/choices [{:answer/id #uuid "8617b3bd-b969-56d6-b993-a80ccaf50cf4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438068} {:answer/id #uuid "5f78f8cc-2978-55d1-9b15-8c6c21d6c9be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438069}] :answer-field/correct {:answer/id #uuid "5f78f8cc-2978-55d1-9b15-8c6c21d6c9be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438069} :answer-field/id #uuid "e00e8280-0c1c-5114-85aa-6e63beddc409" :answer-field/key "$6w+5=6w+9$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439063}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ae9bca83-e68f-5756-9519-1447b4343c01" :question/math-academy-id "q-288073" :question/problem "Which of the following equations has no solutions?\n\nSelect all that apply." :question/worked-solution "Let's attempt to solve each equation in turn:\n\n- For the first equation, we have\n\n$$\n\\begin{aligned}3w+2 & =2w+2 \\\\ 3w+2-2w-2 & =2w+2-2w-2 \\\\ w & =0.\\end{aligned}\n$$\n\nTherefore, the equation $3w+2=2w+2$ has the unique solution $w=0.$\n\n- For the second equation, we have\n\n$$\n\\begin{aligned}4w-7 & =4w-7 \\\\ 4w-7-4w & =4w-7-4w \\\\ -7 & =-7.\\end{aligned}\n$$\n\nThis equation is true for all values of $w.$\n\n- For the third equation, we have\n\n$$\n\\begin{aligned}6w+5 & =6w+9 \\\\ 6w+5-6w & =6w+9-6w \\\\ 5 & =9.\\end{aligned}\n$$\n\nThis equation is false for all values of $w.$ Therefore, the equation $6w+5=6w+9$ has no solutions.\n\nTherefore, the correct answer is $6w+5=6w+9$ only."} {:db/id #edb/ref 17592186297176 :knowledge-point/_questions 