/ref 17592186152256 :knowledge-point/id #uuid "3601ac83-0800-567a-9a0d-4d5c37cef413" :knowledge-point/title "Identifying Elements Belonging to an Equivalence Class"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "628ea40b-ea3c-5520-b003-e513180caca5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474942} {:answer/id #uuid "827b5c09-b00d-5748-862e-57400f85bc9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474943}] :answer-field/correct {:answer/id #uuid "827b5c09-b00d-5748-862e-57400f85bc9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474943} :answer-field/id #uuid "1d65f7bf-9220-5736-b706-48277ea961fe" :answer-field/key "The number $-8$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475397} {:answer-field/choices [{:answer/id #uuid "b8185cbb-4366-5acd-8f39-dcc3625941ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474944} {:answer/id #uuid "ce9abc7a-b119-50d1-947b-a90b799a3d7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474945}] :answer-field/correct {:answer/id #uuid "b8185cbb-4366-5acd-8f39-dcc3625941ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474944} :answer-field/id #uuid "786b07de-9820-5172-9cc7-34e2d9751571" :answer-field/key "The number $8$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475398} {:answer-field/choices [{:answer/id #uuid "759e913e-e77e-550f-a1c4-22cc9a13f9f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474946} {:answer/id #uuid "9dd54e9f-2b56-582c-bf83-ef6cf659a9ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474947}] :answer-field/correct {:answer/id #uuid "759e913e-e77e-550f-a1c4-22cc9a13f9f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474946} :answer-field/id #uuid "246ed5b8-f726-5f26-986d-9fdfc646ba8e" :answer-field/key "The number $2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475399}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bb353c96-604c-5c65-9adf-47096b9ec124" :question/math-academy-id "q-86223" :question/problem "Consider the equivalence relation $∼$ on $R,$ defined by $x∼y$ if $\\sqrt[3]{x}=\\sqrt[3]{y}.$ Which of the following are in the equivalence class $[-8]?$\n\nSelect all that apply." :question/worked-solution "The equivalence class $[-8]$ consists of the elements that are equivalent to $-8$ under the given equivalence relation. So, we have\n\n$$\n\\begin{aligned}[-8] & ={x\\in R\\,|\\,x∼-8} \\\\  & ={x\\in R\\,|\\,\\sqrt[3]{x}=\\sqrt[3]{-8}} \\\\  & ={x\\in R\\,|\\,\\sqrt[3]{x}=-2} \\\\  & ={-8}.\\end{aligned}\n$$\n\nWe see that $-8$ is in $[-8],$ while $8$ and $2$ are not.\n\nTherefore, the correct answer is “The number $-8$” only."} {:db/id #edb/ref 17592186421724 :knowledge-point/_questions [{:db/id #edb/ref 17592186152257 :knowledge-point/id #uuid "dacfbca6-6135-5d51-a07e-627fce79dfd1" :knowledge-point/title "Identifying Equivalence Classes Containing a Given Element"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf3b8092-688e-550d-bb8f-94927287de38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474948} {:answer/id #uuid "b3dd6