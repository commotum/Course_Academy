 :db/id #edb/ref 17592186475366}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3c1db003-08b1-562e-8980-51389652bb7b" :question/math-academy-id "q-77205" :question/problem "Consider the equivalence relation $∼$ on $C,$ defined by $x∼y$ if ${x}^{2}={y}^{2}.$ Which of the following are in the equivalence class $[-4]?$\n\nSelect all that apply." :question/worked-solution "The equivalence class $[-4]$ consists of the elements that are equivalent to $-4$ under the given equivalence relation. So, we have\n\n$$\n\\begin{aligned}[-4] & ={x\\in C\\,|\\,x∼-4} \\\\  & ={x\\in C\\,|\\,{x}^{2}=(-4)^{2}} \\\\  & ={x\\in C\\,|\\,{x}^{2}=16} \\\\  & ={-4,4}.\\end{aligned}\n$$\n\nWe see that $-4$ and $4$ are in $[-4],$ while $4\\text{i}$ is not.\n\nTherefore, the correct answer is “The number $-4$”; “The number $4$” only."} {:db/id #edb/ref 17592186421719 :knowledge-point/_questions [{:db/id #edb/ref 17592186152257 :knowledge-point/id #uuid "dacfbca6-6135-5d51-a07e-627fce79dfd1" :knowledge-point/title "Identifying Equivalence Classes Containing a Given Element"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62a4bb57-5969-52de-b010-ca21fe9a6007" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474714} {:answer/id #uuid "c172fb65-6319-5c94-8438-618f08c71003" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474715}] :answer-field/correct {:answer/id #uuid "62a4bb57-5969-52de-b010-ca21fe9a6007" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474714} :answer-field/id #uuid "48c6e22c-1de1-5dae-b9d0-54dcf023b85d" :answer-field/key "$[0]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475283} {:answer-field/choices [{:answer/id #