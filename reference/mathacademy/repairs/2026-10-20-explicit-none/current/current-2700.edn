db/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472962} {:answer/id #uuid "14a6cd09-f28b-53aa-af9f-2c14771bcdce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472963}] :answer-field/correct {:answer/id #uuid "8d3206f5-60dc-5e8e-9b96-56be36aaf3b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472962} :answer-field/id #uuid "c72b81df-1a34-5370-bcbb-bc9229da9345" :answer-field/key "![Digraph III](images/b3/b3284324550beef49dc6a9e2a9d4250acf5149a7befd8f87fcc6072f95614c23.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473876}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cd780cfc-a5dd-5c8f-a2c7-e44b9d2a3075" :question/math-academy-id "q-213543" :question/problem "Which of the below digraphs represents a symmetric relation defined on the set $A={1,2,3}?$\n\nSelect all that apply." :question/worked-solution "First, recall the following definitions:\n\n- A binary relation $R,$ defined on a set $A,$ is *symmetric* if for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,⟹\\,(y,x)\\in R.\n$$\n\nIn terms of a digraph, if we have an arrow $x\\to y,$ then the arrow $y\\to x$ must be in the digraph too.\n\n- A binary relation $R,$ defined on a set $A,$ is *antisymmetric* if for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,\\text{and}\\,(y,x)\\in R\\,⟹\\,x=y.\n$$\n\nSo, only one of the arrows, either $x\\to y$ or $y\\to x,$ can be in the digraph of an antisymmetric relation. Note that this condition allows loops.\n\nWith that in mind, let's examine our digraphs.\n\n- Digraph I represents an antisymmetric relation since for all possible $x$ and $y$ with $x\\ne y,$ *at most one* of the arrows (either $x\\to y$ or $y\\to x,$ but not both) belongs to the digraph.\n\n- Digraph II represents a symmetric relation since for every arrow $x\\to y$ belonging to the graph, the corresponding inverse arrow $y\\to x$ also belongs to the graph.\n\n- Digraph III represents neither a symmetric nor an antisymmetric relation. It's not symmetric since the arrow $1\\to 2$ belongs to the digraph while the arrow $2\\to 1$ does not. It is not antisymmetric since, for example, arrows $1\\to 3$ and $3\\to 1$ belong to the digraph.\n\nTherefore, the correct answer is digraph II only"} {:db/id #edb/ref 17592186417615 :knowledge-point/_questions [{:db/id #edb/ref 17592186203926 :knowledge-point/id #uuid "c4dee31d-47c2-5b56-8cea-22d42f7b9de2" :knowledge-point/title "Identifying Symmetric and Antisymmetric Relations From a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dff8459b-90ba-55e5-9f4c-e7dc1bde3386" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472952} {:answer/id #uuid "69b91f43-8ffb-569f-b70b-a21938ee98c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472953}] :answer-field/correct {:answer/id #uuid "69b91f43-8ffb-569f-b70b-a21938ee98c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472953} :answer-field/id #uuid "15ef4810-6e2e-50ca-bc69-366ef2ac37ff" :answer-field/key "![Digraph I](images/f5/f58d5e9f1d0c4f53ea088c7fba7c0451587c9ec985872ce80ccf90136127030f.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473871} {:answer-field/choices [{:answer/id #uuid "2a80a966-8115-55b3-b207-094cf3b39558" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472954} {:answer/id #uuid "c7175560-155a-5f70-8923-4994865bc4c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472955}] :answer-field/correct {:answer/id #uuid "2a80a966-8115-55b3-b207-094cf3b39558" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472954} :answer-field/id #uuid "2700e44f-bd91-59e9-97e3-31bcc3ae70f6" :answer-field/key "![Digraph II](images/ac/acfdd3e445e1c78b1f9cd3b69ce84d45b23b24039cc3b4be590f4d0c75471fd9.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473872} {:answer-field/choices [{:answer/id #uuid "24344aba-5447-5867-a059-23cb4cb82ec1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472956} {:answer/id #uuid "3c379a3c-ad71-5b86-b680-69c2aab6da10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472957}] :answer-field/correct {:answer/id #uuid "3c379a3c-ad71-5b86-b680-69c2aab6da10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472957} :answer-field/id #uuid "7fd4515f-510d-5afc-a79c-189bbfef1731" :answer-field/key "![Digraph III](images/21/2122aa13886fd7e5a772875f34de1dcbb9b8b9b7fb637ef3c1f31d356fd66dd9.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473873}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ee6fe66d-09a5-518d-9a32-a533c9b3cc75" :question/math-academy-id "q-213540" :question/problem "Which of the below digraphs represents a symmetric relation defined on the set $A={a,b,c}?$\n\nSelect all that apply." :question/worked-solution "First, recall the following definitions:\n\n- A binary relation $R,$ defined on a set $A,$ is *symmetric* if for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,⟹\\,(y,x)\\in R.\n$$\n\nIn terms of a digraph, if we have an arrow $x\\to y,$ then the arrow $y\\to x$ must be in the digraph too.\n\n- A binary relation $R,$ defined on a set $A,$ is *antisymmetric* if for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,\\text{and}\\,(y,x)\\in R\\,⟹\\,x=y.\n$$\n\nSo, only one of the arrows, either $x\\to y$ or $y\\to x,$ can be in the digraph of an antisymmetric relation. Note that this condition allows loops.\n\nWith that in mind, let's examine our digraphs.\n\n- Digraph I represents a symmetric relation since for every arrow $x\\to y$ belonging to the graph, the corresponding inverse arrow $y\\to x$ also belongs to the graph.\n\n- Digraph II represents an antisymmetric relation since for all possible $x$ and $y$ with $x\\ne y,$ *at most one* of the arrows (either $x\\to y$ or $y\\to x,$ but not both) belongs to the digraph.\n\n- Digraph III represents a symmetric relation since for every arrow $x\\to y$ belonging to the graph, the corresponding inverse arrow $y\\to x$ also belongs to the graph.\n\nTherefore, the correct answer is digraphs I and III only"} {:db/id #edb/ref 17592186417616 :knowledge-point/_questions [{:db/id #edb/ref 17592186203927 :knowledge-point/id #uuid "c70d6a7a-298e-54bb-8a5d-dff2213b17bf" :knowledge-point/title "Symmetric and Antisymmetric Over Infinite Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e40c48dc-e112-5050-ab58-40e28aca37d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472970} {:answer/id #uuid "bfc8cd32-07de-52bc-9812-9df201cd21ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472971}] :answer-field/correct {:answer/id #uuid "e40c48dc-e112-5050-ab58-40e28aca37d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472970} :answer-field/id #uuid "a3966c5d-4fd4-576a-aa5a-8af4208f68ce" :answer-field/key "$x\\,R\\,y$ if and only if $y={x}^{2},$ defined on $R$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473880} {:answer-field/choices [{:answer/id #uuid "db41ede4-d39a-594f-9cbf-c3280e5f8333" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472972} {:answer/id #uuid "4ef80bb4-d9c1-5bcb-affd-78fc449eb48c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472973}] :answer-field/correct {:answer/id #uuid "db41ede4-d39a-594f-9cbf-c3280e5f8333" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472972} :answer-field/id #uuid "48b39b89-1336-54cf-abaa-62896c6eb4d0" :answer-field/key "$X\\,S\\,Y$ if and only if $X⊂Y,$ defined on $P(R)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473881} {:answer-field/choices [{:answer/id #uuid "70a073a2-a27e-5ccd-9655-045b4e8967e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472974} {:answer/id #uuid "7f8fe957-451b-59db-8c93-9d1560fedb97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472975}] :answer-field/correct {:answer/id #uuid "7f8fe957-451b-59db-8c93-9d1560fedb97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472975} :answer-field/id #uuid "0010c237-26c5-5528-a141-70b3e174715b" :answer-field/key "$x\\,T\\,y$ if and only if $4∣(x+y),$ defined on $N$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473882}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fe8a5755-a006-512f-a829-ac55db45a0f7" :question/math-academy-id "q-213600" :question/problem "Which of the following relations are symmetric?\n\nSelect all that apply." :question/worked-solution "First, recall the following definitions:\n\n- A binary relation $R,$ defined on a set $A,$ is *symmetric* if for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,⟹\\,(y,x)\\in R.\n$$\n\nIn other words, if a pair $(x,y)$ belongs to a symmetric relation, then the pair $(y,x)$ should also be in the relation.\n\n- A binary relation $R,$ defined on a set $A,$ is *antisymmetric* if for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,\\text{and}\\,(y,x)\\in R\\,⟹\\,x=y.\n$$\n\nIn other words, only one of the pairs, either $(x,y)$ or $(y,x),$ can be in an antisymmetric relation. Note that this condition allows pairs of the form $(x,x).$\n\nWith that in mind, let's examine our relations.\n\n- Relation $R$ is not symmetric. Notice that \n\n- $(-1,1)\\in R$ since $1=(-1)^{2},$ while\n\n- $(1,-1)\\notin R$ since $-1\\ne {1}^{2}.$\n\n- Relation $S$ is not symmetric. Notice that \n\n- $({1},Z)\\in S$ since ${1}⊂Z,$ while\n\n- $(Z,{1})\\notin S$ since $Z⊄{1}.$\n\n- Relation $T$ is symmetric. Indeed, if $(x,y)\\in T$ then $(y,x)\\in T.$ Notice that \n\n$$\n4∣(x+y)\\,⟹\\,4∣(y+x)\n$$\n\nfor all $x,y\\in N.$\n\nTherefore, the correct answer is \"$T$ only.\""} {:db/id #edb/ref 17592186417703 :knowledge-point/_questions [{:db/id #edb/ref 17592186124521 :knowledge-point/id #uuid "e9d77214-796e-558f-a364-00ae3e25cc13" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5a8fd7b-d587-5f84-abef-00aeb093eb8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453892} {:answer/id #uuid "a3c74f36-a3a0-589c-a45b-af2f83dc7942" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453893}] :answer-field/correct {:answer/id #uuid "e5a8fd7b-d587-5f84-abef-00aeb093eb8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453892} :answer-field/id #uuid "88425be4-23e4-530d-894d-7ba2ee67cacc" :answer-field/key "$T$ is invertible" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454696} {:answer-field/choices [{:answer/id #uuid "42b1c9af-14b9-5566-a390-e0cfcfb93713" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453894} {:answer/id #uuid "56beb87c-fb76-5782-843d-1bb2ef34ea37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453895}] :answer-field/correct {:answer/id #uuid "56beb87c-fb76-5782-843d-1bb2ef34ea37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453895} :answer-field/id #uuid "6eccd02e-cd48-5da5-a4d4-40a643e437ff" :answer-field/key "$\\text{Ker}(T)\\ne {0}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454697} {:answer-field/choices [{:answer/id #uuid "62cc4c4f-6b01-5029-937b-d1096d770d25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453896} {:answer/id #uuid "998a225c-9aad-55b1-9522-e1b176e1886c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453897}] :answer-field/correct {:answer/id #uuid "62cc4c4f-6b01-5029-937b-d1096d770d25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453896} :answer-field/id #uuid "7b61e149-64e1-57db-98c8-d0a11bc647eb" :answer-field/key "$\\text{nullity}(T)=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454698}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0464e7a7-ce22-55cd-90ec-4b6a71a12079" :question/math-academy-id "q-38893" :question/problem "Which of the following statements are true given that $T:{R}^{5}\\to {R}^{5}$ is a linear transformation whose standard matrix is $T,$ and $T(x)=v$ has no solution?\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{5}$ into ${R}^{5},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,\\left\\{\\,\\begin{aligned} & \\text{Im}(T)={R}^{5} \\\\  & \\text{rank}(T)=5 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}\\right.$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement “$T$ is invertible” is false. Since $T(x)=v$ has no solution, we have that $v\\notin \\text{Im}(T),$ hence $\\text{Im}(T)\\ne {R}^{5}.$ According to the invertible matrix theorem, since $\\text{Im}(T)\\ne {R}^{5},$ the transformation $T$ and the matrix $T$ are not invertible.\n\n- Statement $\\text{Ker}(T)\\ne {0}$ is true. Since $T$ is not invertible, the invertible matrix theorem implies that  $\\text{Ker}(T)\\ne {0}.$\n\n- Statement $\\text{nullity}(T)=0$ is false. Since $T$ is not invertible, the invertible matrix theorem implies that $\\text{nullity}(T)\\ne 0.$\n\nTherefore, the correct answer is $\\text{Ker}(T)\\ne {0}$ only."} {:db/id #edb/ref 17592186417704 :knowledge-point/_questions [{:db/id #edb/ref 17592186124631 :knowledge-point/id #uuid "113a601e-220a-54a3-a64b-1e554bc3d79f" :knowledge-point/title "Сompleting a Sentence Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c07dae18-53b8-50d8-9953-c286f053f130" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473452} {:answer/id #uuid "f544fe4b-2071-53b8-8fd7-eb03478e4a89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473453}] :answer-field/correct {:answer/id #uuid "c07dae18-53b8-50d8-9953-c286f053f130" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473452} :answer-field/id #uuid "2548af25-17a2-5afb-af86-44ee79ccc156" :answer-field/key "$\\text{Ker}(T)={0}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474121} {:answer-field/choices [{:answer/id #uuid "0fea2177-f886-5ea3-bcfa-edb19fb1d593" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473454} {:answer/id #uuid "210dadc5-e8c8-5ceb-a5ce-5ab0c4ff06d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473455}] :answer-field/correct {:answer/id #uuid "210dadc5-e8c8-5ceb-a5ce-5ab0c4ff06d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473455} :answer-field/id #uuid "4e057aa0-f318-5406-860f-b5b16d8d2d93" :answer-field/key "$\\text{rank}(T)\\ne 3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474122} {:answer-field/choices [{:answer/id #uuid "ff6fa49d-2a3b-50f4-b709-7cf191c1f26a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473456} {:answer/id #uuid "fc1113bc-9c71-5f2b-98a5-ba108659a934" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473457}] :answer-field/correct {:answer/id #uuid "ff6fa49d-2a3b-50f4-b709-7cf191c1f26a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473456} :answer-field/id #uuid "2f0c4b97-3dd5-51e1-96d0-6bc6a154c613" :answer-field/key "$T$ is invertible" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474123}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c77aeb41-578d-533f-87d1-e33216f35c1e" :question/math-academy-id "q-84053" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T$ and ${u}_{1},{u}_{2}\\in {R}^{3}.$  Consider the following statement:\n\n*If ${u}_{1}-{u}_{2}\\ne 0$ and $T({u}_{1})-T({u}_{2})=0,$ then $\\underline{\\phantom{xxxxxx}}.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,\\left\\{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}\\right.$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement $\\text{Ker}(T)={0}$ is false. Since $T$ is a linear transformation and $T({u}_{1})-T({u}_{2})=0,$ we have $T({u}_{1}-{u}_{2})=0.$ So ${u}_{1}-{u}_{2}\\in \\text{Ker}(T)$ and ${u}_{1}-{u}_{2}\\ne 0.$ Therefore, we must have $\\text{Ker}(T)\\ne {0}.$\n\n- Statement $\\text{rank}(T)\\ne 3$ is true. Since $\\text{Ker}(T)\\ne {0}$, then $\\text{rank}(T)=\\text{rank}(T)\\ne 3.$\n\n- Statement “$T$ is invertible” is false. According to the invertible matrix theorem, since $\\text{rank}(T)\\ne 3,$ the transformation $T$ can't be invertible.\n\nTherefore, the correct answer is $\\text{rank}(T)\\ne 3$ only."} {:db/id #edb/ref 17592186417815 :knowledge-point/_questions [{:db/id #edb/ref 17592186124634 :knowledge-point/id #uuid "69b456ea-44de-59f0-b2c8-bc5b9495974f" :knowledge-point/title "Identifying True Statements From a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f955c119-f900-5747-9855-7eb87295f2f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473260} {:answer/id #uuid "dcc29abc-f9e8-53f8-a218-d470e670dac2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473261}] :answer-field/correct {:answer/id #uuid "dcc29abc-f9e8-53f8-a218-d470e670dac2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473261} :answer-field/id #uuid "c0b57ac4-5833-5f98-85f6-8d01d8cfbdee" :answer-field/key "$A$ is a boundary point of the set $M$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474025} {:answer-field/choices [{:answer/id #uuid "da87805c-dd59-5cd4-a00e-ea9010aca456" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473262} {:answer/id #uuid "ce41ce68-62e4-5bd8-8ba7-9e969d0aef89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473263}] :answer-field/correct {:answer/id #uuid "da87805c-dd59-5cd4-a00e-ea9010aca456" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473262} :answer-field/id #uuid "99f96f24-dff3-5ad2-ae8b-117ac4e4cad2" :answer-field/key "$B$ is an interior point of the set $M$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474026} {:answer-field/choices [{:answer/id #uuid "8eb19004-1309-5d14-8763-0cdb11e1bbb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473264} {:answer/id #uuid "64416903-13ab-5932-b3c4-6697b70d4774" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473265}] :answer-field/correct {:answer/id #uuid "8eb19004-1309-5d14-8763-0cdb11e1bbb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473264} :answer-field/id #uuid "85b6a004-2b46-516a-adc3-ac69774aa23d" :answer-field/key "$C$ is a boundary point of the set $M$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474027}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4db015a0-682b-5ff4-909b-ad19f05ab168" :question/math-academy-id "q-71826" :question/problem "![](images/b8/b838b945d0b4002d8ae2238af5992c83dcf23b2985c448c716a5caf8de31b369.png)\n\nConsider the set $M,$ depicted by the shaded region above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nWith that in mind, let's examine the statements in turn.\n\n$$\n\n$$\n\n![](images/be/be1ece00243777f3f6b6973319e15ea1e5c8556b2452b61a451713f9dcb86595.png)\n\n- Statement “$A$ is a boundary point of the set $M$” is true. Indeed, $A$ is a boundary point because every open neighborhood of $A$ contains points that belong to $M$ and points that do not belong to $M.$\n\n- Statement “$B$ is an interior point of the set $M$” is false. The point $B$ is a boundary point because every open neighborhood of $B$ contains points that belong to $M$ and points that do not belong to $M.$\n\n- Statement “$C$ is a boundary point of the set $M$” is false. The point $C$ is an interior point since there exists an open neighborhood of $C$ that is fully contained inside the set $M.$\n\nTherefore, the correct answer is '“$A$ is a boundary point of the set $M$” only'."} {:db/id #edb/ref 17592186417816 :knowledge-point/_questions [{:db/id #edb/ref 17592186124641 :knowledge-point/id #uuid "64ba57cc-a3eb-582a-963b-b94895a20bac" :knowledge-point/title "Identifying Interior and Boundary Points From Linear Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fb12b54-0323-5408-9f63-bd359e7b2e14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453448} {:answer/id #uuid "164d2254-207a-594f-a70d-382d51b3f8e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453449}] :answer-field/correct {:answer/id #uuid "164d2254-207a-594f-a70d-382d51b3f8e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453449} :answer-field/id #uuid "e5032cdf-c59e-5e33-880d-955f6d02841e" :answer-field/key "The point $P(1,-1)$ lies on the boundary of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454474} {:answer-field/choices [{:answer/id #uuid "3427dac4-97f1-5765-aafc-94068cf9677e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453450} {:answer/id #uuid "6c0ad7a7-e7bc-5678-aca2-5d4474e68307" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453451}] :answer-field/correct {:answer/id #uuid "3427dac4-97f1-5765-aafc-94068cf9677e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453450} :answer-field/id #uuid "e3387072-c1bc-59ee-8d45-dc6cd0e5411d" :answer-field/key "The point $P(1,-1)$ belongs to $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454475} {:answer-field/choices [{:answer/id #uuid "42ad1ee2-a34e-5097-bfd1-c65783c31fe4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453452} {:answer/id #uuid "0e0e000c-633e-51cc-bcaf-35de257a2bd6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453453}] :answer-field/correct {:answer/id #uuid "42ad1ee2-a34e-5097-bfd1-c65783c31fe4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453452} :answer-field/id #uuid "feaa10ce-c2f4-5d9a-998c-4aa5896d0d74" :answer-field/key "The point $Q(2,0)$ is an interior point of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454476}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7e4c0564-b5b1-55bc-bc17-3dffa3a951a9" :question/math-academy-id "q-158601" :question/problem "The set $A$ and its boundary $∂A$ are given by\n\n$$\nA={(x,y)\\in {R}^{2}:y<-1},\\,∂A={(x,y)\\in {R}^{2}:y=-1}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nNow, the set $A$ consists of all points that lie below the line $y=-1.$ A sketch of this region is shown below:\n\n![](images/75/75d5d199d12cc2f3170822a40c52762fcc8368caac26a8134661f9ac72ab462b.png)\n\nLet's add the points $P(1,-1)$ and $Q(2,0)$ and some neighborhoods of these points to our diagram.\n\n![](images/81/818da293be040897d3a536b396d6fe7ff992f3d91f976301e14a6253356b5bde.png)\n\nLet's examine the statements in turn.\n\n- Statement “The point $P(1,-1)$ lies on the boundary of $A$” is true. The coordinates of $P(1,-1)$ satisfy $y=-1.$ Hence, $P$ lies in the set $∂A,$ the boundary of $A.$\n\n- Statement “The point $P(1,-1)$ belongs to $A$” is false. The coordinates of $P(-1,1)$ do not satisfy the inequality $y<-1.$ Hence, $P$ does not lie in the set $A.$\n\n- Statement “The point $Q(2,0)$ is an interior point of $A$” is false. Indeed, $Q$ is not an interior point of $A$ since any neighborhood of $Q$ contains at least one point *outside* the set.\n\nTherefore, the correct answer is '“The point $P(1,-1)$ lies on the boundary of $A$” only.'"} {:db/id #edb/ref 17592186417817 :knowledge-point/_questions [{:db/id #edb/ref 17592186124641 :knowledge-point/id #uuid "64ba57cc-a3eb-582a-963b-b94895a20bac" :knowledge-point/title "Identifying Interior and Boundary Points From Linear Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ca900fdb-2d62-5862-8f58-5e2c93efbb46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453436} {:answer/id #uuid "839c8d82-74a4-5464-b707-309afd311002" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453437}] :answer-field/correct {:answer/id #uuid "839c8d82-74a4-5464-b707-309afd311002" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453437} :answer-field/id #uuid "8e5b6f56-ac9e-5312-8788-c82ee0344df5" :answer-field/key "The point $P(1,-1)$ lies on the boundary of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454468} {:answer-field/choices [{:answer/id #uuid "9eb2be68-e58e-5cf5-a802-398a76d09aee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453438} {:answer/id #uuid "ae1f7b94-44bb-5eab-8fad-f6e5da807f42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453439}] :answer-field/correct {:answer/id #uuid "ae1f7b94-44bb-5eab-8fad-f6e5da807f42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453439} :answer-field/id #uuid "49d1f656-b70c-5cbc-b720-c740ebcddde4" :answer-field/key "The point $Q(0,0)$ belongs to $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454469} {:answer-field/choices [{:answer/id #uuid "66605df2-8aaf-504d-949d-2dc2c5eb81cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453440} {:answer/id #uuid "fbb9751c-c1ad-5871-aa80-62619467576e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453441}] :answer-field/correct {:answer/id #uuid "fbb9751c-c1ad-5871-aa80-62619467576e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453441} :answer-field/id #uuid "54080e51-b892-57e7-b433-ee3c85f02bbe" :answer-field/key "The point $Q(0,0)$ is an interior point of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454470}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dbe53a96-4c4c-5897-ba48-d4861ec6cb49" :question/math-academy-id "q-158547" :question/problem "The set $A$ and its boundary $∂A$ are given by\n\n$$\nA={(x,y)\\in {R}^{2}:y>2x-3},\\,∂A={(x,y)\\in {R}^{2}:y=2x-3}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nNow, the set $A$ consists of all points that lie above the line $y=2x-3.$ A sketch of this region is shown below:\n\n![](images/5a/5af40a400e5ea4942a1cf89b09184a277df96d252e4a7fee41bd2df7024a631f.png)\n\nLet's add the points $P(1,-1)$ and $Q(0,0)$ and some neighborhoods of these points to our diagram.\n\n![](images/27/27b978864eac65c93c7886b2d54dfede7130f0f93a16ef96421cd0e5741a6940.png)\n\nLet's examine the statements in turn.\n\n- Statement “The point $P(1,-1)$ lies on the boundary of $A$” is true. The coordinates of $P(1,-1)$ satisfy $y=2x-3.$ Hence, $P$ lies in the set $∂A,$ the boundary of $A.$\n\n- Statement “The point $Q(0,0)$ belongs to $A$” is true. Indeed, the coordinates of $Q(0,0)$ satisfy the inequality $y>2x-3.$ Hence, $Q$ lies in the set $A.$\n\n- Statement “The point $Q(0,0)$ is an interior point of $A$” is true. Indeed, there exists an open neighborhood of $Q$ that is entirely contained inside the set $A.$\n\nTherefore, the correct answer is '“The point $P(1,-1)$ lies on the boundary of $A$”, “The point $Q(0,0)$ belongs to $A$”, and “The point $Q(0,0)$ is an interior point of $A$”.'"} {:db/id #edb/ref 17592186417818 :knowledge-point/_questions [{:db/id #edb/ref 17592186124634 :knowledge-point/id #uuid "69b456ea-44de-59f0-b2c8-bc5b9495974f" :knowledge-point/title "Identifying True Statements From a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24c50983-8391-5870-8348-d7f660e46076" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472748} {:answer/id #uuid "60e11f58-a5dd-5c6e-b89c-b922fde1c5fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472749}] :answer-field/correct {:answer/id #uuid "60e11f58-a5dd-5c6e-b89c-b922fde1c5fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472749} :answer-field/id #uuid "143a9e68-361d-54b4-9f3d-e48cc583f56a" :answer-field/key "$A$ is an interior point of the set $M$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473769} {:answer-field/choices [{:answer/id #uuid "6913eb54-9ddc-554e-82da-aa99b31eea06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472750} {:answer/id #uuid "03c27322-4cea-5897-a805-a6c4a07342da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472751}] :answer-field/correct {:answer/id #uuid "03c27322-4cea-5897-a805-a6c4a07342da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472751} :answer-field/id #uuid "7c72ab19-8f7b-5385-a77a-7bded7712b10" :answer-field/key "$B$ is a boundary point of the set $M$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473770} {:answer-field/choices [{:answer/id #uuid "e9f94601-7133-564b-ac38-53504ef01422" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472752} {:answer/id #uuid "b58541fc-27f2-5130-a4c2-74d24b8dffa6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472753}] :answer-field/correct {:answer/id #uuid "b58541fc-27f2-5130-a4c2-74d24b8dffa6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472753} :answer-field/id #uuid "3d9085bd-5d71-5a86-abfb-326a5e169143" :answer-field/key "$C$ is an interior point of the set $M$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473771}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f7105850-e717-5535-8a28-db3aaf9f3031" :question/math-academy-id "q-159495" :question/problem "![](images/19/19174ec33e43c900773031043d5de200e892f5e3ee51704d0800b6a944147155.png)\n\nConsider the set $M,$ depicted by the shaded region above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nWith that in mind, let's examine the statements in turn.\n\n$$\n\n$$\n\n![](images/43/43362800e91cbb57c22fc6851c10f00927a030a790dea9284e69a5c7c3d4ae25.png)\n\n$$\n\n$$\n\n- Statement “$A$ is an interior point of the set $M$” is true. Indeed, $A$ is an interior point since there exists an open neighborhood of $A$ that is fully contained inside the set $M.$\n\n- Statement “$B$ is a boundary point of the set $M$” is true. Indeed, $B$ is a boundary point because every open neighborhood of $B$ contains points that belong to $M$ and points that do not belong to $M.$\n\n- Statement “$C$ is an interior point of the set $M$” is true. Indeed, $C$ is an interior point since there exists an open neighborhood of $C$ that is fully contained inside the set $M.$\n\nTherefore, the correct answer is '“$A$ is an interior point of the set $M$”, “$B$ is a boundary point of the set $M$”, and “$C$ is an interior point of the set $M$”'."} {:db/id #edb/ref 17592186418065 :knowledge-point/_questions [{:db/id #edb/ref 17592186172049 :knowledge-point/id #uuid "337518a9-39a1-57e3-8686-74a135f7c3d7" :knowledge-point/title "Identifying Oriented Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f1d85587-6895-544b-83c3-34df9dd81893" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473602} {:answer/id #uuid "f00c4a71-2d1b-5f53-81d8-6257ba61cfd6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473603}] :answer-field/correct {:answer/id #uuid "f1d85587-6895-544b-83c3-34df9dd81893" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473602} :answer-field/id #uuid "cbf923bc-0b2a-5219-b161-b37d4db63dcb" :answer-field/key "![Curve I](images/27/2757ff2c0db1b0b460ad5c77b5cc3998740207414f018d51251dda06051a3d56.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474196} {:answer-field/choices [{:answer/id #uuid "ac6713d6-7624-50c7-b7b3-3b5824aa724f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473604} {:answer/id #uuid "87254a41-7712-5e74-a7d2-a329560b2b80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473605}] :answer-field/correct {:answer/id #uuid "ac6713d6-7624-50c7-b7b3-3b5824aa724f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 175921