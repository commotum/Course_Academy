d/id #uuid "efb9a414-4a76-529c-9c85-31eb6c09ac62" :answer-field/key "$[19]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475402}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c88f13fc-8d9b-5fc7-ac75-4d5797158af8" :question/math-academy-id "q-86231" :question/problem "Consider the equivalence relation $∼$ on $Z,$ defined by $x∼y$ if $2\\,|\\,(x-y).$ Which of the following equivalence classes contain the element $9?$\n\nSelect all that apply." :question/worked-solution "We have $9\\in [x]$ if $9∼x.$ Using the definition of the given equivalence relation, we require\n\n$$\n\\begin{aligned}2\\,|\\,(9-x).\\end{aligned}\n$$\n\nLet's now consider each of the given equivalence classes.\n\n- $9\\in [5]$ because $2\\,|\\,(9-5)\\,✓$\n\n- $9\\notin [2]$ because $2∤(9-2)\\,\\times $\n\n- $9\\in [19]$ because $2\\,|\\,(9-19)\\,✓$\n\nTherefore, the correct answer is $[5]$; $[19]$ only."} {:db/id #edb/ref 17592186421729 :knowledge-point/_questions [{:db/id #edb/ref 17592186152257 :knowledge-point/id #uuid "dacfbca6-6135-5d51-a07e-627fce79dfd1" :knowledge-point/title "Identifying Equivalence Classes Containing a Given Element"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a85e79af-2617-5247-8482-bb788fbf0452" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474882} {:answer/id #uuid "bb77f224-6079-51f9-a77f-252d44a54c3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474883}] :answer-field/correct {:answer/id #uuid "a85e79af-2617-5247-8482-bb788fbf0452" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474882} :answer-field/id #uuid "074c2cfd-78e9-58e8-8405-666adc0ddf75" :answer-field/key "$[3]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475367} {:answer-field/choices [{:answer/id #uuid "0bf38d88-8706-55c4-8972-3061317da5b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474884} {:answer/id #uuid "b4affa42-c1d2-5675-8171-dcc5f1d1b1dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474885}] :answer-field/correct {:answer/id #uuid "b4affa42-c1d2-5675-8171-dcc5f1d1b1dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474885} :answer-field/id #uuid "d21f2f2b-49fd-544f-93b3-db53c91c15b0" :answer-field/key "$[-1]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475368} {:answer-field/choices [{:answer/id #uuid "0870d16d-a967-5ca1-8136-ba7ac078415d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474886} {:answer/id #uuid "2b623fe2-18e6-59ca-b7f7-c5a2a514d4e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474887}] :answer-field/correct {:answer/id #uuid "2b623fe2-18e6-59ca-b7f7-c5a2a514d4e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474887} :answer-field/id #uuid "a5fdd2ab-eb04-5053-89b0-31aab6b55ac1" :answer-field/key "$[8]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475369}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fd41a54f-8627-52be-9ff1-ad5548f86090" :question/math-academy-id "q-77214" :question/problem "Consider the equivalence relation $∼$ on $Z,$ defined by $x∼y$ if $3\\,|\\,(x-y).$ Which of the following equivalence classes contain the element $5?$\n\nSelect all that apply." :question/worked-solution "We have $5\\in [x]$ if $5∼x.$ Using the definition of the given equivalence relation, we require\n\n$$\n\\begin{aligned}3\\,|\\,(5-x).\\end{aligned}\n$$\n\nLet's now consider each of the given equivalence classes.\n\n- $5\\notin [3]$ because $3∤(5-3)\\,\\times $\n\n- $5\\in [-1]$ because $3\\,|\\,(5-(-1))\\,✓$\n\n- $5\\in [8]$ because $3\\,|\\,(5-8)\\,✓$\n\nTherefore, the correct answer is $[-1]$; $[8]$ only."}]
