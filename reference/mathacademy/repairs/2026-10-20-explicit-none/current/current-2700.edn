d "1df7369c-f888-585b-b5a0-51c050df8758" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454124} {:answer/id #uuid "84ae4082-eeb0-54b9-8f03-f8d452322695" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454125}] :answer-field/correct {:answer/id #uuid "84ae4082-eeb0-54b9-8f03-f8d452322695" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454125} :answer-field/id #uuid "025dafa7-6607-51f9-8e1b-41f4d1f7008d" :answer-field/key "If ${2}^{3}\\,|\\,c$ and $3\\,|\\,c$ then $24\\,|\\,c$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454812}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5ddd359d-678b-53c8-9991-000fcf922944" :question/math-academy-id "q-93657" :question/problem "Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that for any integers $a,$ $b,$ and $c,$\n\n$a\\,|\\,c,$ $\\,b\\,|\\,c,\\,$ and $\\,\\text{gcd}(a,b)=1$ $\\,⟹\\,$ $ab\\,|\\,c$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement “If $3\\,|\\,a$ and $2\\,|\\,a$ then $6\\,|\\,a$” is true. First, note that $\\text{gcd}(2,3)=1$ and $2\\cdot 3=6.$ Therefore, we have $(2\\,|\\,a),(3\\,|\\,a),$ and $\\text{gcd}(2,3)=1,$ which implies $(6\\,|\\,a).$\n\n- Statement “If $7\\,|\\,b$ and $14\\,|\\,b$ then $98\\,|\\,b$” is false. As a counterexample, let $b=14.$ Then, $(7∣14)$ and $(14∣14),$ but $(98∤14).$\n\n- Statement “If ${2}^{3}\\,|\\,c$ and $3\\,|\\,c$ then $24\\,|\\,c$” is true. First, note that $\\text{gcd}({2}^{3},3)=1$ and ${2}^{3}\\cdot 3=24.$ Therefore, we have $({2}^{3}\\,|\\,c),(3\\,|\\,c),$ and $\\text{gcd}({2}^{3},3)=1,$ which implies $(24\\,|\\,c).$\n\nTherefore, the correct answer is “If $3\\,|\\,a$ and $2\\,|\\,a$ then $6\\,|\\,a$”; “If ${2}^{3}\\,|\\,c$ and $3\\,|\\,c$ then $24\\,|\\,c$” only."} {:db/id #edb/ref 17592186420264 :knowledge-point/_questions [{:db/id #edb/ref 17592186198311 :knowledge-point/id #uuid "c37bf66e-a574-5cf1-9c1a-fdfda98ca27b" :knowledge-point/title "Identifying True Statements Regarding Divisibility by a Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e971550-afed-59da-9c00-b2572793e69d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454126} {:answer/id #uuid "ad9813ed-d5d9-523d-b081-2668d852fa1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454127}] :answer-field/correct {:answer/id #uuid "ad9813ed-d5d9-523d-b081-2668d852fa1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454127} :answer-field/id #uuid "e8189c37-e52b-5bae-a536-f2eb9672a785" :answer-field/key "If $4\\,|\\,a$ and $9\\,|\\,a$ then $36\\,|\\,a$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454813} {:answer-field/choices [{:answer/id #uuid "035e53a3-a6de-5d10-b8b2-bdce89b90466" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454128} {:answer/id #uuid "934ae89c-1a1a-5389-af92-c23152ee7c71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454129}] :answer-field/correct {:answer/id #uuid "934ae89c-1a1a-5389-af92-c23152ee7c71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454129} :answer-field/id #uuid "70c93dc3-3af0-540d-9d04-a222f3f2bf34" :answer-field/key "If $5\\,|\\,b$ and $7\\,|\\,b$ then $35\\,|\\,b$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454814} {:answer-field/choices [{:answer/id #uuid "ef2efbec-ee42-5329-96fe-97e9248fd330" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454130} {:answer/id #uuid "58adc57e-9bd7-589d-8e1c-4a3354aeed1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454131}] :answer-field/correct {:answer/id #uuid "ef2efbec-ee42-5329-96fe-97e9248fd330" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454130} :answer-field/id #uuid "1cf2310a-22d8-5a6b-b36e-f907e424874e" :answer-field/key "If ${6}^{2}\\,|\\,c$ and $2\\,|\\,c$ then $72\\,|\\,c$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454815}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6d7153a0-178f-57d1-b332-d3ea8e076028" :question/math-academy-id "q-93658" :question/problem "Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that for any integers $a,$ $b,$ and $c,$\n\n$a\\,|\\,c,$ $\\,b\\,|\\,c,\\,$ and $\\,\\text{gcd}(a,b)=1$ $\\,⟹\\,$ $ab\\,|\\,c$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement “If $4\\,|\\,a$ and $9\\,|\\,a$ then $36\\,|\\,a$” is true. First, note that $\\text{gcd}(4,9)=1$ and $4\\cdot 9=36.$ Therefore, we have $(4\\,|\\,a),(9\\,|\\,a),$ and $\\text{gcd}(4,9)=1,$ which implies $(36\\,|\\,a).$\n\n- Statement “If $5\\,|\\,b$ and $7\\,|\\,b$ then $35\\,|\\,b$” is true. First, note that $\\text{gcd}(5,7)=1$ and $5\\cdot 7=35.$ Therefore, we have $(5\\,|\\,b),(7\\,|\\,b),$ and $\\text{gcd}(5,7)=1,$ which implies $(35\\,|\\,b).$\n\n- Statement “If ${6}^{2}\\,|\\,c$ and $2\\,|\\,c$ then $72\\,|\\,c$” is false. As a counterexample, let $c=36.$ Then, $({6}^{2}∣36)$ and $(2∣36),$ but $(72∤36).$\n\nTherefore, the correct answer is “If $4\\,|\\,a$ and $9\\,|\\,a$ then $36\\,|\\,a$”; “If $5\\,|\\,b$ and $7\\,|\\,b$ then $35\\,|\\,b$” only."} {:db/id #edb/ref 17592186420265 :knowledge-point/_questions [{:db/id #edb/ref 17592186198309 :knowledge-point/id #uuid "7eb430d5-5241-56a2-96be-73f44b0f2114" :knowledge-point/title "Identifying True Statements Regarding the Transitivity of Divisibility"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9f311fe-31b2-5bb0-9024-4a1542c58b5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453794} {:answer/id #uuid "4b7a35b7-cd50-59b6-8cb6-a5d519fe2985" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453795}] :answer-field/correct {:answer/id #uuid "4b7a35b7-cd50-59b6-8cb6-a5d519fe2985" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453795} :answer-field/id #uuid "1779d8ec-8897-538a-9e78-6ce356268b33" :answer-field/key "If $12∣h$ then $4∣h$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454647} {:answer-field/choices [{:answer/id #uuid "0170f81d-8cb2-5d63-b89e-313b3852372c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453796} {:answer/id #uuid "e6624e35-1287-54bb-aac2-5a914892c441" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453797}] :answer-field/correct {:answer/id #uuid "e6624e35-1287-54bb-aac2-5a914892c441" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453797} :answer-field/id #uuid "bcffcaa8-c3cf-5b50-b9f2-0085cba43a19" :answer-field/key "If $4∣h$ then $2∣h$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454648} {:answer-field/choices [{:answer/id #uuid "8c1b5927-257c-5610-a08d-af3853d534a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453798} {:answer/id #uuid "3e540739-1a45-52b6-be9d-27d235244263" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453799}] :answer-field/correct {:answer/id #uuid "8c1b5927-257c-5610-a08d-af3853d534a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453798} :answer-field/id #uuid "95dcbb32-4958-59b9-9b71-aef87e544a81" :answer-field/key "If $3∣h$ then $12∣h$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454649}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "73c135de-ad71-58aa-a780-c01d04341240" :question/math-academy-id "q-221379" :question/problem "Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "For any integers $a,$ $b,$ and $c,$ we have transitivity of divisibility:\n\n$a∣b\\,$ and $\\,b∣c$ $\\,⟹\\,$ $a∣c$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement “If $12∣h$ then $4∣h$” is true. First, note that $4∣12.$ Therefore, we have\n$4∣12$ and $12∣h,$ which implies that $4∣h.$\n\n- Statement “If $4∣h$ then $2∣h$” is true. First, note that $2∣4.$ Therefore, we have\n$2∣4$ and $4∣h,$ which implies that $2∣h.$\n\n- Statement “If $3∣h$ then $12∣h$” is false. As a counterexample, let $h=3.$ Then, $3∣3$ but $12∤3.$\n\nTherefore, the correct answer is “If $12∣h$ then $4∣h$”; “If $4∣h$ then $2∣h$” only."} {:db/id #edb/ref 17592186420269 :knowledge-point/_questions [{:db/id #edb/ref 17592186198310 :knowledge-point/id #uuid "6b3101aa-ee9e-5940-b170-2f4e78802150" :knowledge-point/title "Identifying True Statements Regarding the Divisibility of a Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8701a912-ef68-5863-a5cf-1e029092f167" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454102} {:answer/id #uuid "db9f8878-ded0-5bcb-9d41-9a3647d69fee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454103}] :answer-field/correct {:answer/id #uuid "db9f8878-ded0-5bcb-9d41-9a3647d69fee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454103} :answer-field/id #uuid "0ec63ad7-8480-580b-8832-9f3c4d1ce0ac" :answer-field/key "If ${3}^{2}\\,|\\,10b$ then ${3}^{2}\\,|\\,b$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454801} {:answer-field/choices [{:answer/id #uuid "06df3a3e-e9a7-5e3c-99e5-f2aeaa40e35a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454104} {:answer/id #uuid "5ec7c826-456c-5eaf-ac54-507319f46a5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454105}] :answer-field/correct {:answer/id #uuid "06df3a3e-e9a7-5e3c-99e5-f2aeaa40e35a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454104} :answer-field/id #uuid "84f1cf04-cf52-54c6-882b-230f7c6c2638" :answer-field/key "If ${17}^{2}\\,|\\,17b$ then ${17}^{2}\\,|\\,b$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454802} {:answer-field/choices [{:answer/id #uuid "a948fc10-5292-5a77-b044-770a048b0c9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454106} {:answer/id #uuid "8b7f8828-83e5-5419-9e0e-116c56de2b12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454107}] :answer-field/correct {:answer/id #uuid "8b7f8828-83e5-5419-9e0e-116c56de2b12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454107} :answer-field/id #uuid "2f093a1f-da2a-5ae9-9856-84636d51def5" :answer-field/key "If $20\\,|\\,{3}^{3}b$ then $20\\,|\\,b$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454803}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f3b9fb7f-2262-5e34-bb97-3a915acfa755" :question/math-academy-id "q-93648" :question/problem "Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "For any integers $a,$ $b,$ and $c,$\n\n$c\\,|\\,ab\\,$ and $\\,\\text{gcd}(a,c)=1$ $\\,⟹\\,$ $\\,c\\,|\\,b.$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement “If ${3}^{2}\\,|\\,10b$ then ${3}^{2}\\,|\\,b$” is true. First, note that $\\text{gcd}({3}^{2},10)=1.$ Therefore, we have ${3}^{2}\\,|\\,10b$ and $\\text{gcd}({3}^{2},10)=1,$ which implies ${3}^{2}\\,|\\,b.$\n\n- Statement “If ${17}^{2}\\,|\\,17b$ then ${17}^{2}\\,|\\,b$” is false. As a counterexample, let $b=17.$ Then, ${17}^{2}∣17\\cdot 17$ but ${17}^{2}∤17.$\n\n- Statement “If $20\\,|\\,{3}^{3}b$ then $20\\,|\\,b$” is true. First, note that $\\text{gcd}(20,{3}^{3})=1.$ Therefore, we have $20\\,|\\,{3}^{3}b$ and $\\text{gcd}(20,{3}^{3})=1,$ which implies $20\\,|\\,b.$\n\nTherefore, the correct answer is “If ${3}^{2}\\,|\\,10b$ then ${3}^{2}\\,|\\,b$”; “If $20\\,|\\,{3}^{3}b$ then $20\\,|\\,b$” only."} {:db/id #edb/ref 17592186420276 :knowledge-point/_questions [{:db/id #edb/ref 17592186161921 :knowledge-point/id #uuid "01ad9700-5aaa-5b00-8d2f-acce6ed59c9a" :knowledge-point/title "Functions Whose Codomain Is the Set of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "982f653f-6cf3-53fc-8e56-92ef7d70036a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473016} {:answer/id #uuid "edcc72a5-120b-5ee1-97e7-fd2c98eb5894" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473017}] :answer-field/correct {:answer/id #uuid "edcc72a5-120b-5ee1-97e7-fd2c98eb5894" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473017} :answer-field/id #uuid "aaa6136d-b30b-56e8-bf30-53b61fc6705c" :answer-field/key "The range of $f$ is $(1,\\infty )$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473903} {:answer-field/choices [{:answer/id #uuid "d7ee2327-d1e9-55df-aa68-0c11381e1802" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473018} {:answer/id #uuid "2feb2a73-5b5f-5e62-a646-b09fcd1fd29a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473019}] :answer-field/correct {:answer/id #uuid "2feb2a73-5b5f-5e62-a646-b09fcd1fd29a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473019} :answer-field/id #uuid "ddb77040-d533-5459-9ba9-3ae4efed3106" :answer-field/key "$∀\\,y\\in (1,\\infty ),$ $∃\\,x\\in R$ such that $f(x)=y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473904} {:answer-field/choices [{:answer/id #uuid "4606e02b-20d0-5cfc-93eb-144ed9f379b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473020} {:answer/id #uuid "aeb21794-a922-514c-b6d9-2a4e071ad20c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473021}] :answer-field/correct {:answer/id #uuid "aeb21794-a922-514c-b6d9-2a4e071ad20c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473021} :answer-field/id #uuid "d26a451b-cb27-5bb6-a13a-9b40b67b59dd" :answer-field/key "$f$ maps $R$ **into** $R$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473905}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ba992cb2-fd2f-5e4c-b95b-b82e7bb29b58" :question/math-academy-id "q-232536" :question/problem "Which of the following statements are true regarding the function $f:R\\to R$ which is given by $f(x)={3}^{x}+1?$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "First, we graph the function.\n\n![](images/0c/0cb3e23cecdbd82803f5757827f21a424672bdde6da03782ca995d23e1c4d7b4.png)\n\nRecall that $f:X\\to Y$ is an *into* function if it is not a surjection. In other words, there exists an element $y$ in $Y$ such that it has no preimage in $X:$ \n\n$f:X\\to Y$ is an into function if $∃\\,y\\in Y$ such that $∀\\,x\\in X,$ we have $f(x)\\ne y.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement “The range of $f$ is $(1,\\infty )$” is true. From the graph, the function takes all $y$-values greater than $y=1$, excluding $y=1$ itself. So the range of the function is indeed $(1,\\infty ).$\n\n- Statement “$∀\\,y\\in (1,\\infty ),$ $∃\\,x\\in R$ such that $f(x)=y$” is true. Since the range of the function is $(1,\\infty )$, then for all $y$ contained within $(1,\\infty ),$ there exists some $x$ contained within $R$ such that $f(x)=y.$\n\n- Statement “$f$ maps $R$ **into** $R$” is true. As we can see from the range, there is no real number $x$ such that $f(x)=0\\in R.$ So, $f$ maps $R$ *into* $R.$\n\nTherefore, the correct answer is “The range of $f$ is $(1,\\infty )$”; “$∀\\,y\\in (1,\\infty ),$ $∃\\,x\\in R$ such that $f(x)=y$”; “$f$ maps $R$ **into** $R$”."} {:db/id #edb/ref 17592186420329 :knowledge-point/_questions [{:db/id #edb/ref 17592186198270 :knowledge-point/id #uuid "f98332fd-e902-5390-a4d3-4e181ce97219" :knowledge-point/title "Sets Defined Using Trigonometric Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6638e9b8-04e0-5e37-bf80-a24ed5e188f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472802} {:answer/id #uuid "25de8cfd-80d4-51ce-970b-b5efd1192ad0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472803}] :answer-field/correct {:answer/id #uuid "6638e9b8-04e0-5e37-bf80-a24ed5e188f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472802} :answer-field/id #uuid "65143bba-26d2-5f3f-98dc-e17f220901ed" :answer-field/key "$A={n\\in Z\\,:\\,\\operatorname{cos}⁡(2n\\pi )=0}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473796} {:answer-field/choices [{:answer/id #uuid "b7788d5b-3620-567a-877a-59267d8da9ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472804} {:answer/id #uuid "87e018bc-6d30-551d-ad07-f1a36379af55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472805}] :answer-field/correct {:answer/id #uuid "87e018bc-6d30-551d-ad07-f1a36379af55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472805} :answer-field/id #uuid "762f3115-b8a0-5b32-9a0b-09ead9bd286d" :answer-field/key "$B={q\\in Q\\,:\\,\\operatorname{cos}⁡(2q\\pi )=0}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473797} {:answer-field/choices [{:answer/id #uuid "7c33f68a-a8a7-5bcf-ac0c-e8ae18ef5c4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472806} {:answer/id #uuid "3993f4fd-fbdd-548c-b5de-850da57be767" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472807}] :answer-field/correct {:answer/id #uuid "3993f4fd-fbdd-548c-b5de-850da57be767" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472807} :answer-field/id #uuid "4b7e5322-7530-5e96-9303-0361ea826df6" :answer-field/key "$C={x\\in R\\,:\\,\\operatorname{cos}⁡(2x\\pi )=0}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473798}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "787ecee8-f1f0-5525-9f42-a25a7295c8af" :question/math-academy-id "q-181669" :question/problem "Which of the following sets are infinite?\n\nSelect all that apply." :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements.\n\nWe start by finding the solutions to the equation $\\operatorname{cos}⁡(2x\\pi )=0$ for $x\\in R:$\n\n$$\n\\begin{aligned}2x\\pi  & =\\frac{\\pi }{2}+m\\pi  \\\\ x & =\\frac{1}{4}+\\frac{m}{2},\\,m\\in Z\\end{aligned}\n$$\n\nWith that in mind, let's examine our sets:\n\n- The set $A$ is finite. There are no values of $m\\in Z$ such that $\\frac{1}{4}+\\frac{m}{2}\\in Z.$ Therefore,\n\n$$\nA={}.\n$$\n\nConsequently, $|A|=0,$ which is finite.\n\n- The set $B$ is infinite. Listing the elements of $B$ for different values of $m,$ we have\n\n$$\nB={…,-\\frac{3}{4},-\\frac{1}{4},\\frac{1}{4},\\frac{3}{4},…}.\n$$\n\n- The set $C$ is infinite. Since $B$ is infinite, and $B⊆C,$ it follows that $C$ is infinite.\n\nTherefore, the correct answer is \"$B$ and $C$ only.\""} {:db/id #edb/ref 17592186420330 :knowledge-point/_questions [{:db/id #edb/ref 17592186198271 :knowledge-point/id #uuid "26758016-ed47-562a-9338-85c71ffbeaa9" :knowledge-point/title "Sets Defined Using Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eeb0bd26-a87f-5160-86c6-c88af654a1c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472790} {:answer/id #uuid "058a62c1-4870-5eee-97d2-27a48de6c20e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472791}] :answer-field/correct {:answer/id #uuid "058a62c1-4870-5eee-97d2-27a48de6c20e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472791} :answer-field/id #uuid "76792b10-9c83-5ec3-991b-6d887a31bad1" :answer-field/key "$\\begin{gathered}A=\\left\\{\\begin{gathered}{f}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}({e}^{1-2x})\\,:\\\\\\,n\\in {N}_{0}\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473790} {:answer-field/choices [{:answer/id #uuid "0b31da9e-5fdc-54f8-b67b-d7fd5360d29b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472792} {:answer/id #uuid "5883f247-a0a6-5d1a-8e80-822a5710f87e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472793}] :answer-field/correct {:answer/id #uuid "0b31da9e-5fdc-54f8-b67b-d7fd5360d29b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472792} :answer-field/id #uuid "79e111f3-86c2-566b-93bc-79837883bf7b" :answer-field/key "$\\begin{gathered}B=\\left\\{\\begin{gathered}{g}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(3{e}^{x})\\,:\\\\\\,n\\in {N}_{0}\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473791} {:answer-field/choices [{:answer/id #uuid "97702641-8974-5fba-ba14-8a27155d2a45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472794} {:answer/id #uuid "7e961b21-e701-5dc8-b49d-89b3c52beb1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472795}] :answer-field/correct {:answer/id #uuid "97702641-8974-5fba-ba14-8a27155d2a45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472794} :answer-field/id #uuid "63997d18-6e6c-51b4-907b-4e51f65b898a" :answer-field/key "$\\begin{gathered}C=\\left\\{\\begin{gathered}{h}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(4{e}^{-x})\\,:\\\\\\,n\\in {N}_{0}\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473792}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a6b24cf2-2976-579e-8d0e-dd268f3c65a7" :question/math-academy-id "q-181641" :question/problem "Which of the following sets are infinite?\n\nSelect all that apply." :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements.\n\n- The set $A$ is infinite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{f}^{(0)}(x) & ={e}^{1-2x} \\\\ {f}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{1-2x})=-2{e}^{1-2x} \\\\ {f}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-2{e}^{1-2x})=4{e}^{1-2x} \\\\ {f}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{1-2x})=-8{e}^{1-2x} \\\\ ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nA={{e}^{1-2x},-2{e}^{1-2x},4{e}^{1-2x},-8{e}^{1-2x},…}\n$$\n\nConsequently, $A$ is infinite.\n\n- The set $B$ is finite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{g}^{(0)}(x) & =3{e}^{x} \\\\ {g}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(3{e}^{x})=3{e}^{x} \\\\ {g}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(3{e}^{x})=3{e}^{x} \\\\ {g}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(3{e}^{x})=3{e}^{x} \\\\ ⋮\\end{aligned}\n$$\n\nThus, $B$ contains only one element:\n\n$$\nB={3{e}^{x}}\n$$\n\nConsequently, $|B|=1,$ which is finite.\n\n- The set $C$ is finite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{h}^{(0)}(x) & =4{e}^{-x} \\\\ {h}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{-x})=-4{e}^{-x} \\\\ {h}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-4{e}^{-x})=4{e}^{-x} \\\\ {h}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{-x})=-4{e}^{-x} \\\\ ⋮\\end{aligned}\n$$\n\nThus, $C$ contains only two elements:\n\n$$\nC={4{e}^{-x},-4{e}^{-x}}.\n$$\n\nConsequently, $|C|=2,$ which is finite.\n\nTherefore, the correct answer is \"$A$ only.\""} {:db/id #edb/ref 17592186420331 :knowledge-point/_questions [{:db/id #edb/ref 17592186198270 :knowledge-point/id #uuid "f98332fd-e902-5390-a4d3-4e181ce97219" :knowledge-point/title "Sets Defined Using Trigonometric Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6be98ed-2985-5a4b-9efa-6c626ef083aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472796} {:answer/id #uuid "a284a952-4302-5dfa-bf25-723f91b9dfd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472797}] :answer-field/correct {:answer/id #uuid "a284a952-4302-5dfa-bf25-723f91b9dfd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472797} :answer-field/id #uuid "25759778-8fb6-5f63-9330-330d39817923" :answer-field/key "$A={n\\in Z\\,:\\,\\operatorname{sin}⁡(\\frac{n\\pi }{2})=0}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473793} {:answer-field/choices [{:answer/id #uuid "c504450c-70b8-5a79-be85-1b4a58e25ce6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472798} {:answer/id #uuid "a36721f4-cd73-5f82-8636-041b9bcbe466" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472799}] :answer-field/correct {:answer/id #uuid "a36721f4-cd73-5f82-8636-041b9bcbe466" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472799} :answer-field/id #uuid "3db01313-83c9-5e0a-9bc2-aad0155a4cd1" :answer-field/key "$B={q\\in Q\\,:\\,\\operatorname{sin}⁡(\\frac{q\\pi }{2})=0}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473794} {:answer-field/choices [{:answer/id #uuid "b78aa730-cf2e-54c8-8191-51cb634845f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472800} {:answer/id #uuid "b01186a6-6a6b-5188-af10-54d4795a3700" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472801}] :answer-field/correct {:answer/id #uuid "b01186a6-6a6b-5188-af10-54d4795a3700" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472801} :answer-field/id #uuid "7c46ea6f-2d04-5c7b-a253-b975638bca17" :answer-field/key "$C={x\\in R\\,:\\,\\operatorname{sin}⁡(\\frac{x\\pi }{2})=0}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473795}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c8147626-87d7-56ca-be09-d1e1490d794e" :question/math-academy-id "q-181667" :question/problem "Which of the following sets are infinite?\n\nSelect all that apply." :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements.\n\nWe start by finding the solutions to the equation $\\operatorname{sin}⁡\\left(\\frac{x\\pi }{2}\\right)=0$ for $x\\in R:$\n\n$$\n\\begin{aligned}\\frac{x\\pi }{2} & =m\\pi  \\\\ x & =2m,\\,m\\in Z\\end{aligned}\n$$\n\nWith that in mind, let's examine our sets:\n\n- The set $A$ is infinite. Listing the elements of $B$ for different values of $m,$ we have\n\n$$\nA={…,-2,0,2,4,…}.\n$$\n\n- The set $B$ is infinite. Since $A$ is infinite, and $A⊆B,$ it follows that $B$ is infinite.\n\n- The set $C$ is infinite. Since $B$ is infinite, and $B⊆C,$ it follows that $C$ is infinite.\n\nTherefore, the correct answer is \"$A,$ $B,$ and $C.$\""} {:db/id #edb/ref 17592186420332 :knowledge-point/_questions [{:db/id #edb/ref 17592186198271 :knowledge-point/id #uuid "26758016-ed47-562a-9338-85c71ffbeaa9" :knowledge-point/title "Sets Defined Using Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee82b5b5-8eb7-5ff0-be35-a31c59aea9e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472808} {:answer/id #uuid "60c4e5f8-cc86-5c70-b850-fea2f6e02c33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472809}] :answer-field/correct {:answer/id #uuid "60c4e5f8-cc86-5c70-b850-fea2f6e02c33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472809} :answer-field/id #uuid "eab800ab-2c2e-5dc8-b86f-635d0d61cc60" :answer-field/key "$\\begin{gathered}A=\\left\\{\\begin{gathered}{f}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(\\sqrt[5]{{x}^{2}})\\,:\\\\\\,n\\in {N}_{0}\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473799} {:answer-field/choices [{:answer/id #uuid "88bd4daf-0b70-5425-88e1-3fbe6d0526ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472810} {:answer/id #uuid "c75f52b1-417d-59fb-a71b-22a7249d35f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472811}] :answer-field/correct {:answer/id #uuid "c75f52b1-417d-59fb-a71b-22a7249d35f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472811} :answer-field/id #uuid "2cf48651-9562-59ba-b1ef-9b8d571b7647" :answer-field/key "$\\begin{gathered}B=\\left\\{\\begin{gathered}{g}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(-\\sqrt{x})\\,:\\\\\\,n\\in {N}_{0}\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473800} {:answer-field/choices [{:answer/id #uuid "8f84b03a-b49d-5b9d-93fd-ac4bf51bc165" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472812} {:answer/id #uuid "9090acca-2e47-5919-9d10-e65cb241a5a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472813}] :answer-field/correct {:answer/id #uuid "9090acca-2e47-5919-9d10-e65cb241a5a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472813} :answer-field/id #uuid "1cb851b0-1008-559e-bba5-6ac2099260c3" :answer-field/key "$\\begin{gathered}C=\\left\\{\\begin{gathered}{h}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(\\frac{1}{{x}^{2}})\\,:\\\\\\,n\\in {N}_{0}\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473801}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d8b98aed-4075-5dac-9091-d486170b806a" :question/math-academy-id "q-181706" :question/problem "Which of the following sets are infinite?\n\nSelect all that apply." :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements.\n\n- The set $A$ is infinite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{f}^{(0)}(x) & =\\sqrt[5]{{x}^{2}} \\\\ {f}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt[5]{{x}^{2}})=\\frac{2}{5\\sqrt[5]{{x}^{3}}} \\\\ {f}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{2}{5\\sqrt[3]{{x}^{2}}}\\right)=-\\frac{6}{25\\sqrt[5]{{x}^{8}}} \\\\ ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nA={\\sqrt[5]{{x}^{2}},\\frac{2}{5\\sqrt[5]{{x}^{3}}},-\\frac{6}{25\\sqrt[5]{{x}^{8}}},…}\n$$\n\nConsequently, $A$ is infinite.\n\n- The set $B$ is also infinite. Similar to the previous case, listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{g}^{(0)}(x) & =-\\sqrt{x} \\\\ {g}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-\\sqrt{x})=-\\frac{1}{2\\sqrt{x}} \\\\ {g}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}\\left(-\\frac{1}{2\\sqrt{x}}\\right)=\\frac{1}{4\\sqrt{{x}^{3}}} \\\\  & ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nB={-\\sqrt{x},-\\frac{1}{2\\sqrt{x}},\\frac{1}{4\\sqrt{{x}^{3}}},…}\n$$\n\nConsequently, $B$ is infinite.\n\n- The set $C$ is also infinite. Listing a few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{h}^{(0)}(x) & =\\frac{1}{{x}^{2}} \\\\ {h}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{{x}^{2}}\\right)=-\\frac{2}{{x}^{3}} \\\\ {h}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}\\left(-\\frac{2}{{x}^{3}}\\right)=\\frac{6}{{x}^{4}} \\\\  & ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nC={\\frac{1}{{x}^{2}},-\\frac{2}{{x}^{3}},\\frac{6}{{x}^{4}},…}\n$$\n\nConsequently, $C$ is infinite.\n\nTherefore, the correct answer is \"$A,$ $B,$ and $C.$\""} {:db/id #edb/ref 17592186420353 :knowledge-point/_questions [{:db/id #edb/ref 17592186133913 :knowledge-point/id #uuid "abaeea03-6a2a-5d37-a2af-a9ea109175ad" :knowledge-point/title "Identifying the Reasons Why a Determinant Equals Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8345ca2e-07d0-5694-85e8-8ac1bcfa3d94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474822} {:answer/id #uuid "b5ff36f5-8430-54a9-bec5-2cc165a0f1ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474823}] :answer-field/correct {:answer/id #uuid "8345ca2e-07d0-5694-85e8-8ac1bcfa3d94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474822} :answer-field/id #uuid "df50f4aa-1524-57d2-b1e7-0affdd885093" :answer-field/key "$A$ has identical rows" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475337} {:answer-field/choices [{:answer/id #uuid "902e3414-ca2a-5ce2-850b-da2dc63be023" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474824} {:answer/id #uuid "4e173f75-196d-539f-971b-b9d002b2252d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474825}] :answer-field/correct {:answer/id #uuid "902e3414-ca2a-5ce2-850b-da2dc63be023" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474824} :answer-field/id #uuid "f4a68604-a5fe-5780-aff3-ee5e03c398ad" :answer-field/key "$A$ has proportional columns" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475338} {:answer-field/choices [{:answer/id #uuid "1c276a60-9989-5c94-9ab0-70747f4dd816" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474826} {:answer/id #uuid "50bacac0-c323-5e20-9449-31c6507754e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474827}] :answer-field/correct {:answer/id #uuid "50bacac0-c323-5e20-9449-31c6507754e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474827} :answer-field/id #uuid "affe140d-4863-54d4-bd0d-1629fd85f31c" :answer-field/key "$A$ has a zero row" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475339}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d2486be8-75b8-51f1-882e-08f8a79961f2" :question/math-academy-id "q-42463" :question/problem "$$\nA=\\begin{bmatrix}-2 & 3 & 1 \\\\ 0 & 0 & 0 \\\\ 1 & 6 & 4\\end{bmatrix}\n$$\n\nConsider the matrix given above. Identify **all** of the reasons why one can conclude that $|A|=0?$\n\nSelect all that apply." :question/worked-solution "Let's examine each of the statements in turn.\n\n- $A$ does *not* have identical rows.\n\n- $A$ does *not* have proportional columns.\n\n- $A$ has a zero row: \n\n$$\nA=\\begin{bmatrix}-2 & 3 & 1 \\\\ 0 & 0 & 0 \\\\ 1 & 6 & 4\\end{bmatrix}\\,✓\n$$\n\nTherefore, the correct answer is “$A$ has a zero row” only."} {:db/id #edb/ref 17592186420406 :knowledge-point/_questions [{:db/id #edb/ref 17592186203922 :knowledge-point/id #uuid "d4b47a31-7bda-5366-bac4-1d070776e776" :knowledge-point/title "Identifying Reflexive and Irreflexive Relations From a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ce9a0ce-3723-5b44-96fb-04d0366dd21f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474620} {:answer/id #uuid "b46dedea-1cf5-5e1a-9cb3-2c020f9a134a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474621}] :answer-field/correct {:answer/id #uuid "b46dedea-1cf5-5e1a-9cb3-2c020f9a134a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474621} :answer-field/id #uuid "9f4ec09c-15f2-5895-ac80-e0a9327e13e8" :answer-field/key "![Plot I](images/92/92170b58f843d160db2342ce1d6c0942e653deba9eaf6ff8db97ac885a77e11a.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475236} {:answer-field/choices [{:answer/id #uuid "db2e9622-3733-595c-8c9d-874df56fd4e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474622} {:answer/id #uuid "77a1df5c-f867-5e17-b31a-28de951253fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474623}] :answer-field/correct {:answer/id #uuid "77a1df5c-f867-5e17-b31a-28de951253fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474623} :answer-field/id #uuid "ed2b25fb-534d-5029-9329-43b777f6a7cb" :answer-field/key "![Plot II](images/04/0493caf901da783bd7b360866b56b102974169eacfec89718e0e1e6eb75b5fb3.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475237} {:answer-field/choices [{:answer/id #uuid "3138e399-9fd6-5486-a92a-e13b4eda5bb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474624} {:answer/id #uuid "1a41dd38-3d5f-528d-8956-0679daeec641" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474625}] :answer-field/correct {:answer/id #uuid "3138e399-9fd6-5486-a92a-e13b4eda5bb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474624} :answer-field/id #uuid "0c6cb471-5ba9-566a-9280-c3c37963f3a3" :answer-field/key "![Plot III](images/75/75adc21e2673f1fee3f3e5404256cc8904d96356ca713b257d51cb27d0bf5da0.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475238}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d5414df0-8556-5960-86b0-386e378b451e" :question/math-academy-id "q-213229" :question/problem "Which of the plots below represent a relation, defined on the set $A=\\{\\alpha ,\\beta ,\\delta \\},$ that is neither reflexive nor irreflexive?\n\nSelect all that apply." :question/worked-solution "A binary relation $R,$ defined on a set $A,$ is \n\n- *reflexive* if $(x,x)\\in R$ for all $x\\in A,$\n\n- *irreflexive* if $(x,x)\\notin R$ for all $x\\in A.$\n\nIf some pairs of the form $(x,x)$ belong to a relation and others do not, then the relation is neither reflexive nor irreflexive.\n\nSince $R$ must be neither reflective nor irreflexive, some of the points $(\\alpha ,\\alpha ),$ $(\\beta ,\\beta ),$ and $(\\delta ,\\delta )$ must be in $R,$ and others must not.\n\nThese ordered pairs correspond to the diagonal points on the plots, as shown below:\n\n![](images/7d/7d4257c9e249f9a4c2a53c5566292e21ae6dfa7f0e08e27042548da2d8e7e000.png)\n\n \n\nA plot corresponding to a relation that is neither reflexive nor irreflexive must contain some diagonal points, but not all of them. Therefore, the correct answer is plots I and II only"} {:db/id #edb/ref 17592186420504 :knowledge-point/_questions [{:db/id #edb/ref 17592186124654 :knowledge-point/id #uuid "4ca319c5-9f62-51e3-b670-611fc8a8daaa" :knowledge-point/title "Classifying a Critical Point Using the Second Partial Derivatives Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f54eb3dc-8f1a-5dd1-962f-c6bca73b03cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477271} {:answer/id #uuid "8c3bd524-ddd5-53ed-ac7b-67c5c3c6cc25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477272}] :answer-field/correct {:answer/id #uuid "f54eb3dc-8f1a-5dd1-962f-c6bca73b03cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477271} :answer-field/id #uuid "665a7adb-4995-5ab8-8dc0-620e006ab150" :answer-field/key "$H(1,1)>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477605} {:answer-field/choices [{:answer/id #uuid "32a85eda-3d96-59fb-ae1a-38073082f1cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477273} {:answer/id #uuid "dc13ebbc-79a8-5f41-b29b-888f990acc60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477274}] :answer-field/correct {:answer/id #uuid "dc13ebbc-79a8-5f41-b29b-888f990acc60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477274} :answer-field/id #uuid "3e1f0653-0d7e-5971-b6ae-0758b0a5f1c6" :answer-field/key "$\\frac{{∂}^{2}f}{∂{x}^{2}}(1,1)>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477606} {:answer-field/choices [{:answer/id #uuid "3e834f58-d2a9-5c2a-898e-e22835894832" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477275} {:answer/id #uuid "793854ab-f508-5b37-924d-9eca03e5429b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477276}] :answer-field/correct {:answer/id #uuid "3e834f58-d2a9-5c2a-898e-e22835894832" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477275} :answer-field/id #uuid "56acc568-b4e3-5dd3-8613-65932ac1d099" :answer-field/key "The point $(1,1)$ is a local minimum of $f$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477607}] :question/id #uuid "d1a7556c-36af-5f0b-b64c-a00089e6850e" :question/math-academy-id "q-37456" :question/problem "The function \n$f(x,y)$ \nhas the second derivative\n\n$$\n\\boldsymbol{f}^{″}(x,y)=\\begin{bmatrix}2 & 1 \\\\ 1 & 0\\end{bmatrix}\n$$\n\nand has a stationary point at $(1,1).$ If $H$ denotes the Hessian determinant of $f,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "The second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ we have the following:\n\n- If $H(a)>0,$ then:\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a$\n\n- If $H(a)<0,$ then $f$ has a saddle point at $a$\n\n- If $H(a)=0,$ then the second partial derivatives test is inconclusive.\n\nEvaluating the second derivative at $(1,1),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(1,1)=\\begin{bmatrix}2 & 1 \\\\ 1 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, let's examine our statements in turn.\n\n- Statement $H(1,1)>0$ is false. Indeed, computing the determinant of ${f}^{″}(1,1),$ we get\n\n$$\nH(1,1)=det({f}^{″}(1,1))=2\\cdot 0-{1}^{2}=-1<0.\n$$\n\n- Statement $\\frac{{∂}^{2}f}{∂{x}^{2}}(1,1)>0$ is true. Indeed, we have $\\frac{{∂}^{2}f}{∂{x}^{2}}(1,1)=({f}^{″}(1,1))_{11}=2>0.$\n\n- Statement “The point $(1,1)$ is a local minimum of $f$” is false. Since $H(1,1)<0,$ then $(1,1)$ is a saddle point by the second partial derivative test.\n\nTherefore, the correct answer is $\\frac{{∂}^{2}f}{∂{x}^{2}}(1,1)>0$ only."} {:db/id #edb/ref 17592186420586 :knowledge-point/_questions [{:db/id #edb/ref 17592186198269 :knowledge-point/id #uuid "efdb77bf-dd8b-5ccc-8265-79bd319afaa3" :knowledge-point/title "Sets Defined Using Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0da46976-50a0-5bba-a035-84d579bf8c14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474550} {:answer/id #uuid "5cfeed0b-7602-5236-8c0f-9326a62b26c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474551}] :answer-field/correct {:answer/id #uuid "5cfeed0b-7602-5236-8c0f-9326a62b26c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474551} :answer-field/id #uuid "250e3d08-bb55-52da-bcdc-28fa241e7bb6" :answer-field/key "$\\begin{gathered}A=\\left\\{\\begin{gathered}n\\in Z\\,:\\\\\\,-{n}^{2}+n+12\\le 0\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475201} {:answer-field/choices [{:answer/id #uuid "4b8cefbf-5387-5a3e-b149-b7a67085652a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474552} {:answer/id #uuid "72660f00-03ec-5af3-8cad-aee090d7cc5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474553}] :answer-field/correct {:answer/id #uuid "4b8cefbf-5387-5a3e-b149-b7a67085652a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474552} :answer-field/id #uuid "6c37b18b-100a-5c03-9a73-ee73cbe27f86" :answer-field/key "$\\begin{gathered}B=\\left\\{\\begin{gathered}m\\in Z\\,:\\\\\\,-{m}^{2}+m+12\\ge 0\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475202} {:answer-field/choices [{:answer/id #uuid "bf8823b7-fb7b-59e1-a6a7-cbae3eb388cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474554} {:answer/id #uuid "0f7216e9-2722-5e5b-a49d-30702f99303c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474555}] :answer-field/correct {:answer/id #uuid "0f7216e9-2722-5e5b-a49d-30702f99303c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474555} :answer-field/id #uuid "76951e29-2db8-583e-baea-5af2220a2cb6" :answer-field/key "$\\begin{gathered}C=\\left\\{\\begin{gathered}q\\in Q\\,:\\\\\\,-{q}^{2}+q+12\\ge 0\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475203}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7a7b8c64-0e50-5904-90c5-c8b0f74761de" :question/math-academy-id "q-181771" :question/problem "Which of the following sets are infinite?\n\nSelect all that apply." :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements. \n\nLet's start by analyzing the parabola $y=-{x}^{2}+x+12$ for $x\\in R.$\n\nFirst, we find the roots of the parabola:\n\n$$\n\\begin{aligned}-{x}^{2}+x+12 & =0 \\\\ -({x}^{2}-x-12) & =0 \\\\ -(x-4)(x+3) & =0\\end{aligned}\n$$\n\nSo, the roots are $x=-3$ and $x=4,$ and we can graph the parabola as follows:\n\n![](images/57/57d58b579557ba0ea8c6179bd37209c8199eee83e17d79c74828a051aa1382d6.png)\n\nTherefore:\n\n- The solution to the inequality $-{x}^{2}+x+12\\le 0$ for $x\\in R$ is \n\n$$\nx\\le -3\\,\\text{or}\\,x\\ge 4\n$$\n\nand can be expressed as $x\\in {I}_{1}=(-\\infty ,-3]\\cup [4,\\infty ).$\n\n- Similarly, the solution to the inequality $-{x}^{2}+x+12\\ge 0$ for $x\\in R$ is \n\n$$\n-3\\le x\\le 4\n$$\n\nand can be expressed as $x\\in {I}_{2}=[-3,4].$\n\nWith these in mind, let's examine our sets:\n\n- The set $A$ is infinite. If $n\\in Z,$ the solutions to the inequality $-{n}^{2}+n+12\\le 0$ are all the integers that lie in the interval ${I}_{1}.$ Therefore,\n\n$$\nA={…,-4,-3}\\cup {4,5,…}.\n$$\n\n- The set $B$ is finite. If $m\\in Z,$ the solutions to the inequality $-{m}^{2}+m+12\\ge 0$ are all the integers that lie in the interval ${I}_{2}.$ Therefore,\n\n$$\nB={-3,-2,-1,0,1,2,3,4}.\n$$\n\nConsequently, $|B|=8,$ which is finite.\n\n- The set $C$ is infinite. If $q\\in Q,$ the solutions to $-{q}^{2}+q+12\\ge 0$ are all the rational numbers that lie in the interval ${I}_{2}.$ Since any real interval of nonzero length contains infinitely many rational numbers, it follows that $C$ is infinite.\n\nTherefore, the correct answer is \"$A$ and $C$ only.\""} {:db/id #edb/ref 17592186420689 :knowledge-point/_questions [{:db/id #edb/ref 17592186152078 :knowledge-point/id #uuid "ed7345a2-810f-5a35-aa01-092e40df06f3" :knowledge-point/title "Identifying Sufficient Conditions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2fbefaa-38d7-5b1f-be3b-d344a924b231" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474672} {:answer/id #uuid "3aff4692-6312-58ed-98f2-0a3443f6028f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474673}] :answer-field/correct {:answer/id #uuid "f2fbefaa-38d7-5b1f-be3b-d344a924b231" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474672} :answer-field/id #uuid "e7c98675-6c8c-5b6c-81a1-9c741a4b1fef" :answer-field/key "$n\\ge -4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475262} {:answer-field/choices [{:answer/id #uuid "17ce5643-56db-5b30-bf6c-3f04636fd51a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474674} {:answer/id #uuid "c65cb16b-cf7f-5925-b88c-a3e129bea8aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474675}] :answer-field/correct {:answer/id #uuid "c65cb16b-cf7f-5925-b88c-a3e129bea8aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474675} :answer-field/id #uuid "20daba64-8669-59a5-ac11-cb70500da589" :answer-field/key "$n=-4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475263} {:answer-field/choices [{:answer/id #uuid "617bd55d-af8f-5b9b-b339-9b8aba87ef0d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474676} {:answer/id #uuid "02316f99-71bd-5da0-a01a-6cebde20bdbb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474677}] :answer-field/correct {:answer/id #uuid "617bd55d-af8f-5b9b-b339-9b8aba87ef0d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474676} :answer-field/id #uuid "b8022e07-677e-5054-a8ba-974ea9f7d635" :answer-field/key "$|n|\\le 4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475264}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "00b6d002-6ca8-5b5f-a710-55bc4f02fb94" :question/math-academy-id "q-216443" :question/problem "$\\,$ ${n}^{2}+7n+12=0$\n\nWhich of the following conditions are sufficient for the above to be true?\n\nSelect all that apply." :question/worked-solution "Given that the implication $S⇒N$ is true, we have the following:\n\n- $S$ being true *guarantees* that $N$ must also be true. Therefore, $S$ is a *sufficient condition* for $N.$\n\n- For $S$ to be true, it is *necessary* that $N$ is true. Therefore, $N$ is a *necessary condition* for $S.$ However, note that $N$ being true does *not* guarantee that $S$ is true.\n\nThese ideas can be summarized as follows:\n\n$$\n\\text{S}\\text{ufficient}\\,⇒\\,\\text{N}\\text{ecessary}.\n$$\n\n  \n\nIn our case, we need to find the conditions that are *sufficient* for the given one:\n\n$$\n\\text{S}\\text{ufficient}\\,⇒\\,({n}^{2}+7n+12=0)\n$$\n\nNote that the solutions to the given equation are\n\n$$\n\\begin{aligned}{n}^{2}+7n+12 & =0 \\\\ (n+4)(n+3) & =0 \\\\ n & =-4,-3.\\end{aligned}\n$$\n\nWith that in mind, let's inspect each of the given conditions.\n\n- Condition $n\\ge -4$ is *not* a sufficient condition:\n\n$$\n(n\\ge -4)\\,⇏\\,({n}^{2}+7n+12=0)\\,\\,\\times \n$$\n\nFor example, if $n=0,$ then $n\\ge -4,$ but ${n}^{2}+7n+12\\ne 0.$\n\n- Condition $n=-4$ is a sufficient condition:\n\n$$\n(n=-4)\\,⇒\\,({n}^{2}+7n+12=0)\\,\\,✓\n$$\n\nIf $n=-4,$ then ${n}^{2}+7n+12=0.$\n\n- Condition $|n|\\le 4$ is *not* a sufficient condition:\n\n$$\n(|n|\\le 4)\\,⇏\\,({n}^{2}+7n+12=0)\\,\\,\\times \n$$\n\nFor example, if $n=0,$ then $|n|\\le 4,$ but ${n}^{2}+7n+12\\ne 0.$\n\nTherefore, the correct answer is $n=-4$ only."} {:db/id #edb/ref 17592186420690 :knowledge-point/_questions [{:db/id #edb/ref 17592186152077 :knowledge-point/id #uuid "d0bc3ecd-2da1-5951-abba-95da02dee826" :knowledge-point/title "Identifying Necessary Conditions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c974654-2cb6-5b5b-97a1-e7952338aa19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474514} {:answer/id #uuid "77ac130e-f100-51be-bd73-406df515704d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474515}] :answer-field/correct {:answer/id #uuid "3c974654-2cb6-5b5b-97a1-e7952338aa19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474514} :answer-field/id #uuid "6c88976d-d907-52f4-b47a-d7b43494e038" :answer-field/key "$n$ is an odd number" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475183} {:answer-field/choices [{:answer/id #uuid "b124e103-45ef-5879-b034-67056b95ce39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474516} {:answer/id #uuid "ecb1842c-fdd9-5de9-8f9c-62da69dba519" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474517}] :answer-field/correct {:answer/id #uuid "b124e103-45ef-5879-b034-67056b95ce39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474516} :answer-field/id #uuid "0feb969b-f2b9-5a1a-83bd-b7a42fa61e97" :answer-field/key "$n$ is a positive number" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475184} {:answer-field/choices [{:answer/id #uuid "66d71eb4-f061-5c7b-9f2d-10d55ca0c471" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474518} {:answer/id #uuid "51e51cb2-94cf-54a5-bbf1-cbeee409ec60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474519}] :answer-field/correct {:answer/id #uuid "51e51cb2-94cf-54a5-bbf1-cbeee409ec60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474519} :answer-field/id #uuid "129babf3-fc18-5e17-9e10-6f9c8b2b5687" :answer-field/key "$n$ is a multiple of $2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475185}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "04618c03-3ca0-590d-b082-33d1176f03c4" :question/math-academy-id "q-172300" :question/problem "$\\,$ ${n}^{2}$ is an even number\n\nWhich of the following conditions are necessary for the above to be true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Given that the implication $S⇒N$ is true, we have the following:\n\n- $S$ being true *guarantees* that $N$ must also be true. Therefore, $S$ is a *sufficient condition* for $N.$\n\n- For $S$ to be true, it is *necessary* that $N$ is true. Therefore, $N$ is a *necessary condition* for $S.$ However, note that $N$ being true does *not* guarantee that $S$ is true.\n\nThese ideas can be summarized as follows:\n\n$$\n\\text{S}\\text{ufficient}\\,⇒\\,\\text{N}\\text{ecessary}.\n$$\n\nIn our case, we need to find the conditions that are *necessary* from the given one:\n\n$$\n({n}^{2}\\text{ is an even number})\\,⇒\\,\\text{N}\\text{ecessary}\n$$\n\nWith that in mind, let's inspect each of the given conditions. \n\n- Condition “$n$ is an odd number” is *not* a necessary condition: \n\n$$\n({n}^{2}\\text{ is an even number })\\,⇏\\,(n\\text{ is an odd number})\\,\\,\\times \n$$\n\nFor example, the number $n=2$ is not an odd number but ${2}^{2}$ is an even number.\n\n- Condition “$n$ is a positive number” is *not* a necessary condition: \n\n$$\n({n}^{2}\\text{ is an even number})\\,⇏\\,(\\text{ is a positive number})\\,\\,\\times \n$$\n\nFor example, the number $n=-2$ is not a positive number, but $(-2)^{2}$ is an even number.\n\n- Condition “$n$ is a multiple of $2$” is a necessary condition: \n\n$$\n({n}^{2}\\text{ is an even number})\\,⇒\\,(n\\text{ is a multiple of }2)\\,\\,✓\n$$\n\nSince ${n}^{2}$ is even, it must also be true that $n$ is even. Therefore, $n$ is a multiple of $2.$\n\nTherefore, the correct answer is “$n$ is a multiple of $2$” only."} {:db/id #edb/ref 17592186420691 :knowledge-point/_questions [{:db/id #edb/ref 17592186152078 :knowledge-point/id #uuid "ed7345a2-810f-5a35-aa01-092e40df06f3" :knowledge-point/title "Identifying Sufficient Conditions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5dea9d9d-31c2-5c01-a455-69465daf1b26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474526} {:answer/id #uuid "40fa915d-3313-5401-9881-502282158014" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474527}] :answer-field/correct {:answer/id #uuid "40fa915d-3313-5401-9881-502282158014" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474527} :answer-field/id #uuid "17214d23-c467-5173-8f61-0766426c313a" :answer-field/key "$n=4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475189} {:answer-field/choices [{:answer/id #uuid "56e611a6-dc82-58ef-8f11-dceebaf58e96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474528} {:answer/id #uuid "0826a1f6-c863-5d42-95b8-1df6c2a6e255" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474529}] :answer-field/correct {:answer/id #uuid "56e611a6-dc82-58ef-8f11-dceebaf58e96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474528} :answer-field/id #uuid "5e223d7b-f377-5bdd-ae40-106ebab7f04d" :answer-field/key "$-4<n<4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475190} {:answer-field/choices [{:answer/id #uuid "fc96775f-c6f5-5ca4-9703-f26d24ae7c04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474530} {:answer/id #uuid "7f69da4d-9e54-5cfd-923f-6c36718e49e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474531}] :answer-field/correct {:answer/id #uuid "fc96775f-c6f5-5ca4-9703-f26d24ae7c04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474530} :answer-field/id #uuid "d1764754-6220-5bd9-aaab-c9961114c472" :answer-field/key "$|n|<16$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475191}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "10fd92b2-5e05-5850-b7d2-d8140b9fd04f" :question/math-academy-id "q-172315" :question/problem "$\\,$ ${n}^{2}=16$\n\nWhich of the following conditions are sufficient for the above to be true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Given that the implication $S⇒N$ is true, we have the following:\n\n- $S$ being true *guarantees* that $N$ must also be true. Therefore, $S$ is a *sufficient condition* for $N.$\n\n- For $S$ to be true, it is *necessary* that $N$ is true. Therefore, $N$ is a *necessary condition* for $S.$ However, note that $N$ being true does *not* guarantee that $S$ is true.\n\nThese ideas can be summarized as follows:\n\n$$\n\\text{S}\\text{ufficient}\\,⇒\\,\\text{N}\\text{ecessary}.\n$$\n\nIn our case, we need to find the conditions that are *sufficient* for the given one:\n\n$$\n\\text{S}\\text{ufficient}\\,⇒\\,({n}^{2}=16)\n$$\n\nNote that the solution to the given equation is \n\n$$\n\\begin{aligned}{n}^{2} & =16 \\\\ {n}^{2}-16 & =0 \\\\ (n+4)(n-4) & =0 \\\\ n & =-4,4.\\end{aligned}\n$$\n\nWith that in mind, let's inspect each of the given conditions.\n\n- Condition $n=4$ is a sufficient condition:\n\n$$\n(n=4)\\,⇒\\,({n}^{2}=16)\\,\\,✓\n$$\n\nIf $n=4,$ then ${n}^{2}=16.$\n\n- Condition $-4<n<4$ is *not* a sufficient condition:\n\n$$\n(-4<n<4)\\,⇏\\,({n}^{2}=16)\\,\\,\\times \n$$\n\nFor example, if $n=-1,$ then\n\n$$\n\\begin{aligned}{n}^{2} & =(-1)^{2} \\\\  & =1\\ne 16.\\end{aligned}\n$$\n\n- Condition $|n|<16$ is *not* a sufficient condition:\n\n$$\n(|n|<16)\\,⇏\\,({n}^{2}=16)\\,\\,\\times \n$$\n\nFor example, if $n=-1,$ then $|n|<16,$ but ${n}^{2}=1\\ne 16.$\n\nTherefore, the correct answer is $n=4$ only."} {:db/id #edb/ref 17592186420692 :knowledge-point/_questions [{:db/id #edb/ref 17592186152078 :knowledge-point/id #uuid "ed7345a2-810f-5a35-aa01-092e40df06f3" :knowledge-point/title "Identifying Sufficient Conditions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6918f073-c442-5f18-b455-52622f56f35e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474538} {:answer/id #uuid "aaf41748-06d6-52c6-aa3b-308d83a706dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474539}] :answer-field/correct {:answer/id #uuid "6918f073-c442-5f18-b455-52622f56f35e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474538} :answer-field/id #uuid "3d8263b8-7e82-5b77-9f03-bec084e88fd5" :answer-field/key "$|x|>3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475195} {:answer-field/choices [{:answer/id #uuid "f9e39ef7-a88b-577a-b0d6-705ea2d526fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474540} {:answer/id #uuid "87a04c93-3149-5e28-8454-384821f8c32e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474541}] :answer-field/correct {:answer/id #uuid "87a04c93-3149-5e28-8454-384821f8c32e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474541} :answer-field/id #uuid "b2fed408-cdcd-55a9-a9f4-12abd80bada2" :answer-field/key "$x>3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475196} {:answer-field/choices [{:answer/id #uuid "e26f992c-0caf-597a-b322-2e782bc69db1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474542} {:answer/id #uuid "88843fa6-1855-53ff-af9a-14a6b6a49357" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474543}] :answer-field/correct {:answer/id #uuid "88843fa6-1855-53ff-af9a-14a6b6a49357" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474543} :answer-field/id #uuid "2accb876-bb81-5087-87aa-41721160c992" :answer-field/key "$x>4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475197}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "28567992-ba7f-5623-ad07-13abe4be416c" :question/math-academy-id "q-172325" :question/problem "$\\,$ $x+1>4$\n\nWhich of the following conditions are sufficient for the above to be true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Given that the implication $S⇒N$ is true, we have the following:\n\n- $S$ being true *guarantees* that $N$ must also be true. Therefore, $S$ is a *sufficient condition* for $N.$\n\n- For $S$ to be true, it is *necessary* that $N$ is true. Therefore, $N$ is a *necessary condition* for $S.$ However, note that $N$ being true does *not* guarantee that $S$ is true.\n\nThese ideas can be summarized as follows:\n\n$$\n\\text{S}\\text{ufficient}\\,⇒\\,\\text{N}\\text{ecessary}.\n$$\n\n  \n\nIn our case, we need to find the conditions that are *sufficient* for the given one:\n\n$$\n\\text{S}\\text{ufficient}\\,⇒\\,(x+1>4)\n$$\n\nNote that the solution to the given equation is \n\n$$\n\\begin{aligned}x+1 & >4 \\\\ x & >3.\\end{aligned}\n$$\n\nWith that in mind, let's inspect each of the given conditions.\n\n- Condition $|x|>3$ is *not* a sufficient condition:\n\n$$\n(|x|>3)\\,⇏\\,(x+1>4)\\,\\,\\times \n$$\n\nFor example, if $x=-4,$ then we have $x+1=-3≯4.$\n\n- Condition $x>3$ is a sufficient condition:\n\n$$\n(x>3)\\,⇒\\,(x+1>4)\\,\\,✓\n$$\n\nIf $x>3,$ then $x+1>4.$\n\n- Condition $x>4$ is a sufficient condition:\n\n$$\n(x>4)\\,⇒\\,(x+1>4)\\,\\,✓\n$$\n\nIf $x>4,$ then  $x+1>5>4.$\n\nTherefore, the correct answer is $x>3$; $x>4$ only."} {:db/id #edb/ref 17592186420693 :knowledge-point/_questions [{:db/id #edb/ref 17592186152079 :knowledge-point/id #uuid "655a0356-bbf0-5769-86d7-6674c65d0f87" :knowledge-point/title "Identifying Necessary and Sufficient Conditions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22fd7e43-5c76-592b-aee4-f521964cb28a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474690} {:answer/id #uuid "56db8c6a-3927-5f57-8d4a-f66704069758" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474691}] :answer-field/correct {:answer/id #uuid "22fd7e43-5c76-592b-aee4-f521964cb28a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474690} :answer-field/id #uuid "5591e25a-3ea8-5f89-9be5-e954600bbcf0" :answer-field/key "$f$ is a differentiable function" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475271} {:answer-field/choices [{:answer/id #uuid "0aaacbae-01bd-5b78-b909-ba34f4a8bfe5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474692} {:answer/id #uuid "9df9fb08-bffb-50d9-9054-b845a6a759d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474693}] :answer-field/correct {:answer/id #uuid "0aaacbae-01bd-5b78-b909-ba34f4a8bfe5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474692} :answer-field/id #uuid "a3b5576e-92d4-5f62-a180-abf1cc0efd81" :answer-field/key "$f(x)=\\operatorname{tan}⁡x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475272} {:answer-field/choices [{:answer/id #uuid "2a32688b-9a6e-5531-97e4-13b963ffda66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474694} {:answer/id #uuid "65d2bf31-d717-50e7-9174-4e253ccf20e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474695}] :answer-field/correct {:answer/id #uuid "65d2bf31-d717-50e7-9174-4e253ccf20e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474695} :answer-field/id #uuid "1bd972e0-15e5-5c38-b69b-4c566a479a6a" :answer-field/key "$f(x)=\\operatorname{tan}⁡x+C,$ for any $C\\in R$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475273}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "390cc44c-87e5-5905-81de-8b4495a342fd" :question/math-academy-id "q-216459" :question/problem "$\\,$ ${f}^{′}(x)={sec}^{2}⁡x$\n\nWhich of the following conditions are necessary and sufficient for the above statement to be true?\n\nSelect all that apply." :question/worked-solution "Given that the equivalence $P⇔Q$ is true, we have that $P$ is a *necessary and sufficient condition* for $Q.$  \n\nIn our case, we need to find the conditions that are *necessary and sufficient* for the given one. In other words,\n\n$$\n({f}^{′}(x)={sec}^{2}⁡x)\\,⇒\\,\\text{Condition}\n$$\n\nand\n\n$$\n({f}^{′}(x)={sec}^{2}⁡x)\\,⇐\\,\\text{Condition}.\n$$\n\nNotice that the solution to the differential equation ${f}^{′}(x)={sec}^{2}⁡x$ is \n\n$$\n\\begin{aligned}f(x) & =\\int {sec}^{2}⁡x\\,dx \\\\  & =\\operatorname{tan}⁡x+C\\end{aligned}\n$$\n\nwhere $C\\in R$ is the arbitrary constant.\n\nWith that in mind, let's inspect each of the given conditions.\n\n- Condition “$f$ is a differentiable function” is *not* a sufficient condition:\n\n$$\n({f}^{′}(x)={sec}^{2}⁡x)\\,⇍\\,(f\\text{ is a differentiable function})\\,\\,\\times \n$$\n\nFor example, the function $f(x)={e}^{x}$ is a differentiable function but ${f}^{′}(x)\\ne {sec}^{2}⁡x.$\n\n- Condition $f(x)=\\operatorname{tan}⁡x$ is *not* a necessary condition:\n\n$$\n({f}^{′}(x)={sec}^{2}⁡x)\\,⇏\\,(f(x)=\\operatorname{tan}⁡x)\\,\\,\\times \n$$\n\nFor example, for the function $f(x)=\\operatorname{tan}⁡x+1,$ the statement ${f}^{′}(x)={sec}^{2}⁡x$ is true but $f(x)\\ne \\operatorname{tan}⁡x+1.$\n\n- Condition “$f(x)=\\operatorname{tan}⁡x+C,$ for any $C\\in R$” is both necessary and sufficient: The statement ${f}^{′}(x)={sec}^{2}⁡x$ is true *if and only if* $f(x)=\\operatorname{tan}⁡x+C,$ for any $C\\in R.$\n\n$$\n({f}^{′}(x)={sec}^{2}⁡x)\\,⇒\\,(f(x)=\\operatorname{tan}⁡x+C)\n$$\n\nand\n\n$$\n({f}^{′}(x)={sec}^{2}⁡x)\\,⇐\\,(f(x)=\\operatorname{tan}⁡x+C).\n$$\n\nTherefore, we can write\n\n$$\n({f}^{′}(x)={sec}^{2}⁡x)\\,⇔\\,(f(x)=\\operatorname{tan}⁡x+C)\\,\\,✓\n$$\n\nTherefore, the correct answer is “$f(x)=\\operatorname{tan}⁡x+C,$ for any $C\\in R$” only."} {:db/id #edb/ref 17592186420694 :knowledge-point/_questions [{:db/id #edb/ref 17592186152077 :knowledge-point/id #uuid "d0bc3ecd-2da1-5951-abba-95da02dee826" :knowledge-point/title "Identifying Necessary Conditions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a89bb0c-0c7b-56f1-b539-37a12390f125" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474520} {:answer/id #uuid "6ae93c4e-dbee-5e05-a6c8-d9c42170ca16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474521}] :answer-field/correct {:answer/id #uuid "6ae93c4e-dbee-5e05-a6c8-d9c42170ca16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474521} :answer-field/id #uuid "ead4a86f-a7fe-5af4-9eb4-5b3a0b8b20db" :answer-field/key "$n$ is odd" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475186} {:answer-field/choices [{:answer/id #uuid "3e692d5a-6355-5a16-ad53-70eaf6632af4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474522} {:answer/id #uuid "a6f1e8fb-2da6-5ee5-9d4d-1da86e369e4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474523}] :answer-field/correct {:answer/id #uuid "3e692d5a-6355-5a16-ad53-70eaf6632af4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474522} :answer-field/id #uuid "f94fd077-0724-53df-91f5-264867194b12" :answer-field/key "$n$ is a multiple of $3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475187} {:answer-field/choices [{:answer/id #uuid "d6518693-7320-54ee-9d17-34a1c0cb7d16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474524} {:answer/id #uuid "f2f11120-7136-5045-b049-91d280b83ea4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474525}] :answer-field/correct {:answer/id #uuid "d6518693-7320-54ee-9d17-34a1c0cb7d16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474524} :answer-field/id #uuid "bd17e2ae-aab3-52ac-be51-99890d5d4e21" :answer-field/key "$n$ is a multiple of $5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475188}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4b376045-26da-55cb-becc-db924f8d2dac" :question/math-academy-id "q-172302" :question/problem "$\\,$ ${n}^{2}$ is an odd number\n\nWhich of the following conditions are necessary for the above to be true?\n\nSelect all that apply." :question/worked-solution "Given that the implication $S⇒N$ is true, we have the following:\n\n- $S$ being true *guarantees* that $N$ must also be true. Therefore, $S$ is a *sufficient condition* for $N.$\n\n- For $S$ to be true, it is *necessary* that $N$ is true. Therefore, $N$ is a *necessary condition* for $S.$ However, note that $N$ being true does *not* guarantee that $S$ is true.\n\nThese ideas can be summarized as follows:\n\n$$\n\\text{S}\\text{ufficient}\\,⇒\\,\\text{N}\\text{ecessary}.\n$$\n\nIn our case, we need to find the conditions that are *necessary* from the given one:\n\n$$\n({n}^{2}\\text{ is an odd number})\\,⇒\\,\\text{N}\\text{ecessary}\n$$\n\nWith that in mind, let's inspect each of the given conditions. \n\n- Condition “$n$ is odd” is a necessary condition: \n\n$$\n({n}^{2}\\text{ is an odd number})\\,⇒\\,(\\text{ }n\\text{ is odd})\\,\\,✓\n$$\n\nSince ${n}^{2}$ is odd, it must also be true that $n$ is odd.\n\n- Condition “$n$ is a multiple of $3$” is *not* a necessary condition: \n\n$$\n({n}^{2}\\text{ is an odd number})\\,⇏\\,(n\\text{ is a multiple of }3)\\,\\,\\times \n$$\n\nFor example, the number $n=7$ is not a multiple of $3,$ but ${n}^{2}=49$ is an odd number.\n\n- Condition “$n$ is a multiple of $5$” is *not* a necessary condition: \n\n$$\n({n}^{2}\\text{ is an odd number})\\,⇏\\,(n\\text{ is a multiple of }5)\\,\\,\\times \n$$\n\nFor example, the number $n=9$ is not a multiple of $5,$ but ${n}^{2}=81$ is an odd number.\n\nTherefore, the correct answer is “$n$ is odd” only."} {:db/id #edb/ref 17592186420695 :knowledge-point/_questions [{:db/id #edb/ref 17592186152076 :knowledge-point/id #uuid "6414abb9-00d3-55ea-a1e5-da99999c3ccc" :knowledge-point/title "Identifying Necessary or Sufficient Conditions From Implications"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ca89b64b-5016-52db-ad10-13fc71298748" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453656} {:answer/id #uuid "bf064bf2-82e9-5e43-b653-633779214409" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453657}] :answer-field/correct {:answer/id #uuid "ca89b64b-5016-52db-ad10-13fc71298748" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453656} :answer-field/id #uuid "0a87b594-92ce-5651-a817-9591309b3dd4" :answer-field/key "$m>0\\,∧n>0$ is a **necessary** condition for $m\\cdot n>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454578} {:answer-field/choices [{:answer/id #uuid "8d697a21-38e2-577f-b759-4f3dfc003f64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453658} {:answer/id #uuid "f1a27ab7-0a90-5d43-b7e1-77d9b3615543" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453659}] :answer-field/correct {:answer/id #uuid "f1a27ab7-0a90-5d43-b7e1-77d9b3615543" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453659} :answer-field/id #uuid "3886d4bc-30ff-5683-96ef-4bc49bde2d5a" :answer-field/key "$m>0\\,∧n>0$ is a **sufficient** condition for $m\\cdot n>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454579} {:answer-field/choices [{:answer/id #uuid "51996c26-0ab2-5c43-bc19-282ca02980ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 1759