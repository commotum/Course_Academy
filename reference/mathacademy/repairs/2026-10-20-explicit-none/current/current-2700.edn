swer is \"None.\""} {:db/id #edb/ref 17592186421412 :knowledge-point/_questions [{:db/id #edb/ref 17592186152067 :knowledge-point/id #uuid "968df6ec-e87e-5770-9c11-e7c8d8a27e6c" :knowledge-point/title "Identifying Equivalence Relations on Finite Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5ee2f8b-2f4a-5085-8ac7-65adbf13d05e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453750} {:answer/id #uuid "6afe72c6-f821-55f0-925a-2babdf1aaa05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453751}] :answer-field/correct {:answer/id #uuid "6afe72c6-f821-55f0-925a-2babdf1aaa05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453751} :answer-field/id #uuid "81b3e19a-7169-5f51-8ab6-427ddbdc1005" :answer-field/key "$R$ is reflexive" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454625} {:answer-field/choices [{:answer/id #uuid "3db430f6-da70-51bc-b16b-f2ef7eda9a8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453752} {:answer/id #uuid "2924385a-d774-5e69-8064-0afa269c2f2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453753}] :answer-field/correct {:answer/id #uuid "2924385a-d774-5e69-8064-0afa269c2f2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453753} :answer-field/id #uuid "dac67ce1-caaf-5c5d-8993-cf1b29f02b9b" :answer-field/key "$R$ is symmetric" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454626} {:answer-field/choices [{:answer/id #uuid "b8718d2f-32f3-5135-bee2-bf4b00d476db