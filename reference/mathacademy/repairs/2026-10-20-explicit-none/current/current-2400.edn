type/text} :answer/value "true" :db/id #edb/ref 17592186439494}] :answer-field/correct {:answer/id #uuid "2e884f18-53fd-5041-94e9-ff9a8b0abf64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439494} :answer-field/id #uuid "3b49d521-d2dd-5bd3-a65b-f63b17f6768a" :answer-field/key "$m=8$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440104}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "30a80f14-b653-5ec9-a12d-20d43bb40f91" :question/math-academy-id "q-128506" :question/problem "Given that the determinant of\n$\\begin{bmatrix}1 & 6 & m \\\\ m & 3 & 0 \\\\ 2 & 1 & 1\\end{bmatrix}$\nis $-29$, find all the possible values of $m.$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $m:$\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 6 & m \\\\ m & 3 & 0 \\\\ 2 & 1 & 1\\end{aligned}| & =1|\\begin{aligned}3 & 0 \\\\ 1 & 1\\end{aligned}|-6|\\begin{aligned}m & 0 \\\\ 2 & 1\\end{aligned}|+m|\\begin{aligned}m & 3 \\\\ 2 & 1\\end{aligned}| \\\\  & =(3-0)-6(m-0)+m(m-6) \\\\  & =3-6m+{m}^{2}-6m \\\\  & ={m}^{2}-12m+3\\end{aligned}\n$$\n\nSince the determinant of the matrix is $-29,$ we have:\n\n$$\n\\begin{aligned}{m}^{2}-12m+3 & =-29 \\\\ {m}^{2}-12m+32 & =0 \\\\ m & =\\frac{-(-12)\\pm \\sqrt{{12}^{2}-4\\cdot 1\\cdot 32}}{2\\cdot 1} \\\\  & =\\frac{12\\pm \\sqrt{16}}{2} \\\\  & =\\frac{12\\pm 4}{2} \\\\  & =6\\pm 2\\end{aligned}\n$$\n\nTherefore, the solutions are $m=4$ and $m=8.$"} {:db/id #edb/ref 17592186400373 :knowledge-point/_questions [{:db/id #edb/ref 17592186124445 :knowledge-point/id #uuid "e8d807a6-7896-5045-a14a-908b58831340" :knowledge-point/title "Finding the Points Where a Gradient Vanishes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5c6186e-dc96-51d6-82cf-5c90683fa84d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439503} {:answer/id #uuid "9cd21dd5-0725-5fc9-a948-255a7375e687" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439504}] :answer-field/correct {:answer/id #uuid "9cd21dd5-0725-5fc9-a948-255a7375e687" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439504} :answer-field/id #uuid "aae52bae-eb88-5ee0-a6c0-ddf96c9c5413" :answer-field/key "$(-3,-3)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440109} {:answer-field/choices [{:answer/id #uuid "26f138de-76d3-51c6-b70f-37f4ae000dfc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439505} {:answer/id #uuid "abd8a918-fae9-5155-b1e4-9387ec218bfd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439506}] :answer-field/correct {:answer/id #uuid "26f138de-76d3-51c6-b70f-37f4ae000dfc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439505} :answer-field/id #uuid "8ea60b4f-c7d5-5ba9-b54b-a47a64f292ec" :answer-field/key "$(-3,3)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440110} {:answer-field/choices [{:answer/id #uuid "707f2204-105d-5f98-a7c5-02aaedc7a057" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439507} {:answer/id #uuid "d8586660-fd7e-5eda-9284-01ae5a7a40b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439508}] :answer-field/correct {:answer/id #uuid "707f2204-105d-5f98-a7c5-02aaedc7a057" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439507} :answer-field/id #uuid "192ed7e0-867a-5042-9244-595a5145fa06" :answer-field/key "$(3,-3)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440111} {:answer-field/choices [{:answer/id #uuid "aa7553f1-861f-51c0-8547-71189b4ae228" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439509} {:answer/id #uuid "3f812865-94f7-5778-aa60-73b89c449256" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439510}] :answer-field/correct {:answer/id #uuid "aa7553f1-861f-51c0-8547-71189b4ae228" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439509} :answer-field/id #uuid "3dd2c2d4-80d6-5681-8a2f-d724cd733e7a" :answer-field/key "$(3,3)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440112}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a633d445-62c8-5864-b7bf-d694cd1cd56c" :question/math-academy-id "q-128519" :question/problem "Given that $g(x,y)=\\frac{9}{y}-\\frac{3y}{x}+x,$ find the points $(x,y)$ where $∇g(x,y)=0.$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(\\frac{9}{y}-\\frac{3y}{x}+x) \\\\  & =\\frac{3y}{{x}^{2}}+1 \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(\\frac{9}{y}-\\frac{3y}{x}+x) \\\\  & =-\\frac{9}{{y}^{2}}-\\frac{3}{x}\\end{aligned}\n$$\n\nHence, $∇g(x,y)=(\\frac{3y}{{x}^{2}}+1)i-(\\frac{9}{{y}^{2}}+\\frac{3}{x})j.$\n\nNow, we solve $∇g(x,y)=0:$\n\n$$\n(\\frac{3y}{{x}^{2}}+1)i-(\\frac{9}{{y}^{2}}+\\frac{3}{x})j=0\\,i+0\\,j\n$$\n\nSo, by equating the coefficients of $i$ and $j,$ we obtain:\n\n$$\n\\begin{cases}\\frac{3y}{{x}^{2}}+1=0 \\\\ \\frac{9}{{y}^{2}}+\\frac{3}{x}=0\\end{cases}\n$$\n\nFrom the first equation, we get $y=-\\frac{{x}^{2}}{3}.$ Substituting this into the second equation, we obtain\n\n$$\n\\begin{aligned}\\frac{9}{{\\left(-\\frac{{x}^{2}}{3}\\right)}^{2}}+\\frac{3}{x} & =0 \\\\ 9\\cdot {\\left(-\\frac{3}{{x}^{2}}\\right)}^{2}+\\frac{3}{x} & =0 \\\\ \\frac{81}{{x}^{4}}+\\frac{3}{x} & =0 \\\\ \\frac{81+3{x}^{3}}{{x}^{4}} & =0 \\\\ 81+3{x}^{3} & =0 \\\\ {x}^{3} & =-27 \\\\ x & =-3.\\end{aligned}\n$$\n\nFor $x=-3,$ we get $y=-\\frac{(-3)^{2}}{3}=-3.$\n\nTherefore, $∇g(x,y)=0$ at the point: $(-3,-3).$"} {:db/id #edb/ref 17592186400408 :knowledge-point/_questions [{:db/id #edb/ref 17592186129114 :knowledge-point/id #uuid "2d390841-351e-54f5-ad19-90b6ebae5799" :knowledge-point/title "Identifying Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c011bf74-4e03-5659-a095-597e0524fce9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472586} {:answer/id #uuid "e64784ae-73a3-527e-a9ca-515e7c49ea94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472587}] :answer-field/correct {:answer/id #uuid "e64784ae-73a3-527e-a9ca-515e7c49ea94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472587} :answer-field/id #uuid "129c2acd-23b9-5242-b875-c0ced1c0d4f2" :answer-field/key "$A=\\begin{bmatrix}-2 & 0 & 3 & 1 \\\\ 0 & 5 & 0 & -4 \\\\ 0 & 0 & 1 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473688} {:answer-field/choices [{:answer/id #uuid "6839a05c-d515-556e-8ab4-1b643298e3ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472588} {:answer/id #uuid "56dd2d05-be36-50c6-ba0a-273536e978cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472589}] :answer-field/correct {:answer/id #uuid "56dd2d05-be36-50c6-ba0a-273536e978cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472589} :answer-field/id #uuid "30de0c38-b03c-53b4-9e5a-aecafb7542d8" :answer-field/key "$B=\\begin{bmatrix}0 & -1 & 2 & -5 \\\\ 0 & 0 & 1 & 3 \\\\ 0 & 0 & 0 & 7\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473689} {:answer-field/choices [{:answer/id #uuid "4aa9083a-2e35-58cc-aa7f-4cb905ebf3a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472590} {:answer/id #uuid "474b59f6-2c15-5712-8de6-b7b3cc94ba29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472591}] :answer-field/correct {:answer/id #uuid "4aa9083a-2e35-58cc-aa7f-4cb905ebf3a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472590} :answer-field/id #uuid "4390b2a3-3b01-57b6-ad09-9ca4d3b9b3f5" :answer-field/key "$C=\\begin{bmatrix}1 & 0 & -1 & 0 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 5 & 0 & 0 \\\\ 0 & 0 & 0 & -9\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473690}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6061d8ea-d309-5b82-8a65-c5a4fc1b804c" :question/math-academy-id "q-129213" :question/problem "Which of the following matrices are in row echelon form?\n\nSelect all that apply." :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\nI. All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n\nII. Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is in row echelon form (both conditions are satisfied).\n\n$$\nA=\\begin{bmatrix}-2 & 0 & 3 & 1 \\\\ 0 & 5 & 0 & -4 \\\\ 0 & 0 & 1 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\begin{bmatrix}0 & -1 & 2 & -5 \\\\ 0 & 0 & 1 & 3 \\\\ 0 & 0 & 0 & 7\\end{bmatrix}\n$$\n\n- The matrix $C$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nC=\\begin{bmatrix}1 & 0 & -1 & 0 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 5 & 0 & 0 \\\\ 0 & 0 & 0 & -9\\end{bmatrix}\n$$\n\nTherefore, only $A$ and $B$ are in row echelon form."} {:db/id #edb/ref 17592186400415 :knowledge-point/_questions [{:db/id #edb/ref 17592186129114 :knowledge-point/id #uuid "2d390841-351e-54f5-ad19-90b6ebae5799" :knowledge-point/title "Identifying Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69bcd314-df9c-5935-9335-a09fa25e8d41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472592} {:answer/id #uuid "8865af33-97aa-5c4a-9244-e60cc4cee987" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472593}] :answer-field/correct {:answer/id #uuid "69bcd314-df9c-5935-9335-a09fa25e8d41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472592} :answer-field/id #uuid "9c83300b-74eb-54e0-bc36-0514d541679a" :answer-field/key "$A=\\begin{bmatrix}1 & 0 & 2 & -1 & 1 \\\\ 0 & 0 & -2 & 3 & 0 \\\\ 0 & 0 & 0 & 0 & 5 \\\\ 0 & 0 & 0 & 0 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473691} {:answer-field/choices [{:answer/id #uuid "38fb9531-056d-5ceb-831d-52b028bb8fda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472594} {:answer/id #uuid "06492854-4f41-5760-9db6-f1fac392f7d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472595}] :answer-field/correct {:answer/id #uuid "06492854-4f41-5760-9db6-f1fac392f7d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472595} :answer-field/id #uuid "45575979-eedd-534e-af96-a411d45a5c4e" :answer-field/key "$B=\\begin{bmatrix}-5 & 0 & -1 \\\\ 0 & 0 & 3 \\\\ 0 & 0 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473692} {:answer-field/choices [{:answer/id #uuid "f63471c3-8442-5cfa-ba81-ee7d063a01bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472596} {:answer/id #uuid "082ec0b2-e3c9-53c6-83cb-f251e283c424" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472597}] :answer-field/correct {:answer/id #uuid "082ec0b2-e3c9-53c6-83cb-f251e283c424" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472597} :answer-field/id #uuid "b65cc9f6-519d-53a0-9c92-4a7de7fe1e03" :answer-field/key "$C=\\begin{bmatrix}0 & 2 & 0 & -1 \\\\ 0 & 0 & 2 & 1 \\\\ 0 & 0 & 0 & -1 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473693}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8f982d65-21d3-5ca8-afbe-be436c69b22a" :question/math-academy-id "q-129217" :question/problem "Which of the following matrices are in row echelon form?\n\nSelect all that apply." :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\nI. All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n\nII. Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since the leading entry ${a}_{45}\\ne 0$ (condition II is violated). \n\n$$\nA=\\begin{bmatrix}1 & 0 & 2 & -1 & 1 \\\\ 0 & 0 & -2 & 3 & 0 \\\\ 0 & 0 & 0 & 0 & 5 \\\\ 0 & 0 & 0 & 0 & 1\\end{bmatrix}\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\begin{bmatrix}-5 & 0 & -1 \\\\ 0 & 0 & 3 \\\\ 0 & 0 & 0\\end{bmatrix}\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=\\begin{bmatrix}0 & 2 & 0 & -1 \\\\ 0 & 0 & 2 & 1 \\\\ 0 & 0 & 0 & -1 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\n$$\n\nTherefore, only $B$ and $C$ are in row echelon form."} {:db/id #edb/ref 17592186400422 :knowledge-point/_questions [{:db/id #edb/ref 17592186129114 :knowledge-point/id #uuid "2d390841-351e-54f5-ad19-90b6ebae5799" :knowledge-point/title "Identifying Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6a10c6a-c273-5b60-aa1d-e7a83843eb27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472598} {:answer/id #uuid "f0d03d0c-023e-5dfc-96d5-00773119971d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472599}] :answer-field/correct {:answer/id #uuid "f0d03d0c-023e-5dfc-96d5-00773119971d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472599} :answer-field/id #uuid "cbd4469b-951d-544d-97f3-8ed77d2160e8" :answer-field/key "$A=\\begin{bmatrix}-1 & 0 & 1 \\\\ 0 & -2 & 3 \\\\ 0 & 0 & 1 \\\\ 0 & 0 & -1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473694} {:answer-field/choices [{:answer/id #uuid "e0548548-12e3-5f3a-9a0d-c7bb8784abca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472600} {:answer/id #uuid "0dba5fad-44f1-5962-b40c-1a4bf7ea4791" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472601}] :answer-field/correct {:answer/id #uuid "0dba5fad-44f1-5962-b40c-1a4bf7ea4791" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472601} :answer-field/id #uuid "5131e743-cc81-5654-9cd6-1dd3499199fc" :answer-field/key "$B=\\begin{bmatrix}2 & 1 & -1 \\\\ 0 & -1 & 4 \\\\ 0 & 0 & 5 \\\\ 0 & 0 & -3 \\\\ 0 & 0 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473695} {:answer-field/choices [{:answer/id #uuid "39e0bdd4-a472-5cd4-8576-fc1670adda07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472602} {:answer/id #uuid "92093f3b-676c-547a-8e12-e16c925f1834" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472603}] :answer-field/correct {:answer/id #uuid "39e0bdd4-a472-5cd4-8576-fc1670adda07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472602} :answer-field/id #uuid "ab834763-22aa-5288-b62d-c63763b2a29d" :answer-field/key "$C=\\begin{bmatrix}5 & 1 & 0 \\\\ 0 & 0 & 2 \\\\ 0 & 0 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473696}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "88771814-b2fc-53f4-914f-2f284d52aece" :question/math-academy-id "q-129222" :question/problem "Which of the following matrices are **not** in row echelon form?\n\nSelect all that apply." :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since the leading entry ${a}_{43}\\ne 0$ (condition II is violated). \n\n$$\nA=\\begin{bmatrix}-1 & 0 & 1 \\\\ 0 & -2 & 3 \\\\ 0 & 0 & 1 \\\\ 0 & 0 & -1\\end{bmatrix}\n$$\n\n- The matrix $B$ is not in row echelon form since the leading entry ${b}_{43}\\ne 0$ (condition II is violated). \n\n$$\nB=\\begin{bmatrix}2 & 1 & -1 \\\\ 0 & -1 & 4 \\\\ 0 & 0 & 5 \\\\ 0 & 0 & -3 \\\\ 0 & 0 & 0\\end{bmatrix}\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=\\begin{bmatrix}5 & 1 & 0 \\\\ 0 & 0 & 2 \\\\ 0 & 0 & 0\\end{bmatrix}\n$$\n\nTherefore, only $A$ and $B$ are **not** in row echelon form."} {:db/id #edb/ref 17592186400436 :knowledge-point/_questions [{:db/id #edb/ref 17592186129113 :knowledge-point/id #uuid "f5d1d859-0b86-5507-a7bf-3d805a85adf3" :knowledge-point/title "Identifying Augmented Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c63daf6f-eed4-503b-a8b2-0baf04238897" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472610} {:answer/id #uuid "8c490ab2-ec7b-5dee-94e0-ca23a50fdead" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472611}] :answer-field/correct {:answer/id #uuid "8c490ab2-ec7b-5dee-94e0-ca23a50fdead" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472611} :answer-field/id #uuid "27d756e8-4693-5c8d-a097-a9d17ac33b68" :answer-field/key "$A=\\left[\\begin{array}{cc|c}2 & 0 & 1 \\\\ 0 & 0 & 3 \\\\ 0 & 7 & -1 \\\\ 0 & 0 & 0\\end{array}\\right]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473700} {:answer-field/choices [{:answer/id #uuid "360e1f52-5cdb-5c5e-9a6d-33c968fdb021" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472612} {:answer/id #uuid "cd099e05-d512-5614-a6fc-51d408232f9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472613}] :answer-field/correct {:answer/id #uuid "cd099e05-d512-5614-a6fc-51d408232f9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472613} :answer-field/id #uuid "3642312c-08a2-5f05-bb3f-1054acc8e9f4" :answer-field/key "$B=\\left[\\begin{array}{ccc|c}5 & 0 & 2 & 3 \\\\ 0 & 0 & -1 & -3 \\\\ 0 & 0 & 2 & 1\\end{array}\\right]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473701} {:answer-field/choices [{:answer/id #uuid "0e87742a-dcd6-5298-bb30-ef2ace74838c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472614} {:answer/id #uuid "6e8e3db4-35ea-53de-88a3-45ed4615b36f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472615}] :answer-field/correct {:answer/id #uuid "0e87742a-dcd6-5298-bb30-ef2ace74838c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472614} :answer-field/id #uuid "924222e4-fc3d-551f-a6c3-451ea17542f0" :answer-field/key "$C=\\left[\\begin{array}{cccc|c}1 & -5 & 0 & 1 & 2 \\\\ 0 & 0 & 2 & -3 & 1 \\\\ 0 & 0 & 0 & 1 & -2\\end{array}\\right]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473702}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3d92198e-4ce7-5520-a0eb-698c6d6eae5d" :question/math-academy-id "q-129231" :question/problem "Which of the following augmented matrices are **not** in row echelon form?\n\nSelect all that apply." :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nA=\\left[\\begin{array}{cc|c}2 & 0 & 1 \\\\ 0 & 0 & 3 \\\\ 0 & 7 & -1 \\\\ 0 & 0 & 0\\end{array}\\right]\n$$\n\n- The matrix $B$ is not in row echelon form since ${b}_{33}\\ne 0$ (condition II is violated).\n\n$$\nB=\\left[\\begin{array}{ccc|c}5 & 0 & 2 & 3 \\\\ 0 & 0 & -1 & -3 \\\\ 0 & 0 & 2 & 1\\end{array}\\right]\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=\\left[\\begin{array}{cccc|c}1 & -5 & 0 & 1 & 2 \\\\ 0 & 0 & 2 & -3 & 1 \\\\ 0 & 0 & 0 & 1 & -2\\end{array}\\right]\n$$\n\nTherefore, only $A$ and $B$ are **not** in row echelon form."} {:db/id #edb/ref 17592186400443 :knowledge-point/_questions [{:db/id #edb/ref 17592186152291 :knowledge-point/id #uuid "6302f81d-4834-56a5-b014-0a97c3dccd6f" :knowledge-point/title "Identifying True Statements About General Solutions of Second-Order Linear ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84c8f04c-de6b-5dce-8146-3527e7f3c7e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472628} {:answer/id #uuid "0061914e-dc5a-5b4b-b20d-0dff9b1f199a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472629}] :answer-field/correct {:answer/id #uuid "84c8f04c-de6b-5dce-8146-3527e7f3c7e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472628} :answer-field/id #uuid "3b786eeb-eeb2-5390-97de-30db0cd0a4a0" :answer-field/key "${y}_{1}(x)=\\operatorname{cos}⁡2x$ is a solution to the equation" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473709} {:answer-field/choices [{:answer/id #uuid "b39ecdd1-99d2-5181-a232-644b1fec6bb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472630} {:answer/id #uuid "09f679cc-1efe-592e-bc54-96e5c28fcd47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472631}] :answer-field/correct {:answer/id #uuid "09f679cc-1efe-592e-bc54-96e5c28fcd47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472631} :answer-field/id #uuid "f85cfc2b-302f-523b-9ac3-ac732c5a7401" :answer-field/key "${y}_{2}(x)=\\operatorname{sin}⁡{x}^{2}$ is a solution to the equation" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473710} {:answer-field/choices [{:answer/id #uuid "d4cb9d85-ad64-51d4-ace3-d8787ac79d59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472632} {:answer/id #uuid "37f1603b-5499-5a0f-96e1-ad3d9b521467" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472633}] :answer-field/correct {:answer/id #uuid "d4cb9d85-ad64-51d4-ace3-d8787ac79d59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472632} :answer-field/id #uuid "e0ef7d5f-8712-5e8d-8f93-b65f5f6af37b" :answer-field/key "The general solution of the equation is $y=A\\operatorname{cos}⁡2x+B\\operatorname{sin}⁡{x}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473711}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5007768b-5de4-5206-bbd7-b32aa44bd388" :question/math-academy-id "q-130005" :question/problem "Consider the differential equation $x{y}^{″}-{y}^{′}+4{x}^{3}y=0.$ Which of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Let's check each statement:\n\n- To determine whether ${y}_{1}(x)$ is a solution to the differential equation, we substitute ${y}_{1}$ and its derivatives into the equation.\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & =-2\\operatorname{sin}⁡2x \\\\ {y}_{1}^{″}(x) & =-4\\operatorname{cos}⁡2x.\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation. We get\n\n$$\nx(-4\\operatorname{cos}⁡2x)-(-2\\operatorname{sin}⁡2x)+4{x}^{3}\\operatorname{cos}⁡2x=(4{x}^{3}-4x)\\operatorname{cos}⁡2x+2\\operatorname{sin}⁡2x.\\,\\times \n$$\n\nSo, ${y}_{1}$ is not a solution to the equation, and therefore statement “${y}_{2}(x)=\\operatorname{sin}⁡{x}^{2}$ is a solution to the equation” is false.\n\n- Similarly, we compute the derivatives of ${y}_{2}$ and substitute to the equation. Computing the derivatives yields\n\nFirst, we find the first and second derivatives:\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & =2x\\operatorname{cos}⁡{x}^{2} \\\\ {y}_{2}^{″}(x) & =2\\operatorname{cos}⁡{x}^{2}-4{x}^{2}\\operatorname{sin}⁡{x}^{2}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation. We get\n\n$$\nx(2\\operatorname{cos}⁡{x}^{2}-4{x}^{2}\\operatorname{sin}⁡{x}^{2})-2x\\operatorname{cos}⁡{x}^{2}+4{x}^{3}\\operatorname{sin}⁡{x}^{2}=(2x-2x)\\operatorname{cos}⁡{x}^{2}+(4{x}^{3}-4{x}^{3})\\operatorname{sin}⁡{x}^{2}=0.\\,✓\n$$\n\nSo, ${y}_{2}$ is a solution to the equation, and therefore statement “${y}_{2}(x)=\\operatorname{sin}⁡{x}^{2}$ is a solution to the equation” is true.\n\n- So, ${y}_{2}$ is a solution while ${y}_{1}$ is not a solution of the equation, hence $y=A\\operatorname{cos}⁡2x+B\\operatorname{sin}⁡{x}^{2}$  is not the general solution.\n\nTherefore, statement “The general solution of the equation is $y=A\\operatorname{cos}⁡2x+B\\operatorname{sin}⁡{x}^{2}$” is false."} {:db/id #edb/ref 17592186400450 :knowledge-point/_questions [{:db/id #edb/ref 17592186124456 :knowledge-point/id #uuid "84245283-3cf9-5889-8c42-896a0c8af291" :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e3f9a2e3-bee8-5b1b-b1c5-43ca27a9ee8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439511} {:answer/id #uuid "f628d092-8784-5d3d-b54f-458bd5beb768" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439512}] :answer-field/correct {:answer/id #uuid "e3f9a2e3-bee8-5b1b-b1c5-43ca27a9ee8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439511} :answer-field/id #uuid "d87136b4-f54f-5a06-86b5-cf63e992b1d1" :answer-field/key "$(-2,0)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440113} {:answer-field/choices [{:answer/id #uuid "12fafdc0-e4b2-52e6-ae9c-99cc3b27a59b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439513} {:answer/id #uuid "d4b5298a-472b-5545-8b69-e594bf8766ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439514}] :answer-field/correct {:answer/id #uuid "d4b5298a-472b-5545-8b69-e594bf8766ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439514} :answer-field/id #uuid "4d688553-f546-5705-b1b5-e8fa688d5ccc" :answer-field/key "$(-2,2)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440114} {:answer-field/choices [{:answer/id #uuid "d89573c1-b7fc-57e0-b937-a941c611e3b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439515} {:answer/id #uuid "5a2526f8-dbfa-54f5-953e-68b316490ad0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439516}] :answer-field/correct {:answer/id #uuid "5a2526f8-dbfa-54f5-953e-68b316490ad0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439516} :answer-field/id #uuid "0da4e8cd-a37a-575d-b740-45d4e50ce9a5" :answer-field/key "$(0,0)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440115} {:answer-field/choices [{:answer/id #uuid "dcee5b74-6097-5de5-a2f9-1ef377001ba6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439517} {:answer/id #uuid "cc9ac649-f4ee-5a5e-aa1e-4df3984df146" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439518}] :answer-field/correct {:answer/id #uuid "dcee5b74-6097-5de5-a2f9-1ef377001ba6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439517} :answer-field/id #uuid "c9513575-9539-55dd-8564-2815f12cfbf6" :answer-field/key "$(0,2)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440116}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6851bbc7-80d6-5dc9-8a00-f559624fa12f" :question/math-academy-id "q-130217" :question/problem "At which points on the curve ${x}^{2}+{y}^{2}=2y-2x$ is the tangent vector to the curve perpendicular to the vector $-i+j?$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =2y-2x \\\\ {x}^{2}+{y}^{2}+2x-2y & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)={x}^{2}+{y}^{2}+2x-2y,$ our curve can be viewed as the level curve $f(x,y)=0.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}({x}^{2}+{y}^{2}+2x-2y)\\,i-\\frac{∂}{∂x}({x}^{2}+{y}^{2}+2x-2y)\\,j \\\\  & =(2y-2)\\,i-(2x+2)\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $-i+j,$ we must have $t\\cdot (-i+j)=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot (-i+j) & =0 \\\\ ((2y-2)\\,i-(2x+2)\\,j)\\cdot (-i+j) & =0 \\\\ -(2y-2)-(2x+2) & =0 \\\\ -2y-2x & =0 \\\\ y & =-x\\end{aligned}\n$$\n\nSubstituting $y=-x$ into the equation of our curve gives\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =2y-2x \\\\ {x}^{2}+(-x)^{2} & =2(-x)-2x \\\\ 2{x}^{2} & =-4x \\\\ 2{x}^{2}+4x & =0 \\\\ 2x(x+2) & =0 \\\\ x & =-2,0.\\end{aligned}\n$$\n\nFinally:\n\n- For $x=-2,$ we get $y=2,$ and the corresponding point is $(-2,2).$\n\n- For $x=0,$ we get $y=0,$ and the corresponding point is $(0,0).$"} {:db/id #edb/ref 17592186400457 :knowledge-point/_questions [{:db/id #edb/ref 17592186229137 :knowledge-point/id #uuid "17c792c0-3aec-5e40-8897-2eab9ff2ece0" :knowledge-point/title "Using the Properties of Linear Differential Operators to Identify Them"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56c5895f-0312-5a1b-aa81-74432f1a677a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472634} {:answer/id #uuid "d57966ac-2f7c-5bc4-a8c5-65630a1d5758" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472635}] :answer-field/correct {:answer/id #uuid "56c5895f-0312-5a1b-aa81-74432f1a677a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472634} :answer-field/id #uuid "0be720c7-5295-5e04-92ab-bc14f518e6df" :answer-field/key "${D}_{1}(y)=\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+y\\frac{\\text{d}y}{\\text{d}x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473712} {:answer-field/choices [{:answer/id #uuid "3182dc74-62d1-5167-9fb3-faf55e9da825" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472636} {:answer/id #uuid "778f926c-1c30-52dc-9b5b-093672a84639" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472637}] :answer-field/correct {:answer/id #uuid "778f926c-1c30-52dc-9b5b-093672a84639" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472637} :answer-field/id #uuid "ef1686d5-f2b2-56da-9484-96521f179d9c" :answer-field/key "${D}_{2}(y)=2\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-x\\frac{\\text{d}y}{\\text{d}x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473713} {:answer-field/choices [{:answer/id #uuid "8593b2a9-e446-54b2-b2ef-e7e11d7e793c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472638} {:answer/id #uuid "fefe0407-b32a-5fa0-a3d1-5fb9b7b3e4bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472639}] :answer-field/correct {:answer/id #uuid "fefe0407-b32a-5fa0-a3d1-5fb9b7b3e4bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472639} :answer-field/id #uuid "e4cd4326-93b9-5e74-b562-0ccf10e9684b" :answer-field/key "${D}_{3}(y)={x}^{2}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+2x\\frac{\\text{d}y}{\\text{d}x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473714}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3a8a1c12-7f84-5c3b-83f4-8db057221abd" :question/math-academy-id "q-130256" :question/problem "Which of the following are linear differential operators?\n\nSelect all that apply." :question/worked-solution "For any linear differential operator,\n\n$$\nD(a{y}_{1}+b{y}_{2})=aD({y}_{1})+bD({y}_{2})\n$$\n\nwhere $a$ and $b$ are constants. \n\nLet's check each case in turn.\n\n- The first operator is **not** linear. To see why, we first evaluate the left-hand side of the linearity condition:\n\n$$\n\\begin{aligned}{D}_{1}(a{y}_{1}+b{y}_{2}) & =\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2})+(a{y}_{1}+b{y}_{2})\\frac{\\text{d}}{\\text{d}x}(a{y}_{1}+b{y}_{2}) \\\\  & =a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+{a}^{2}{y}_{1}\\frac{\\text{d}{y}_{1}}{\\text{d}x}+{b}^{2}{y}_{2}\\frac{\\text{d}{y}_{2}}{\\text{d}x}+ab({y}_{1}\\frac{\\text{d}{y}_{2}}{\\text{d}x}+{y}_{2}\\frac{\\text{d}{y}_{1}}{\\text{d}x})\\end{aligned}\n$$\n\nThis is not the same as the right-hand side, because\n\n$$\n\\begin{aligned}a{D}_{1}({y}_{1})+b{D}_{1}({y}_{2}) & =a[\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+{y}_{1}\\frac{\\text{d}{y}_{1}}{\\text{d}x}]+b[\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+{y}_{2}\\frac{\\text{d}{y}_{2}}{\\text{d}x}] \\\\  & =a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+a{y}_{1}\\frac{\\text{d}{y}_{1}}{\\text{d}x}+b{y}_{2}\\frac{\\text{d}{y}_{2}}{\\text{d}x}.\\,\\times \\end{aligned}\n$$\n\n- The second operator is indeed linear. To see this, we check the above linearity condition:\n\n$$\n\\begin{aligned}{D}_{2}(a{y}_{1}+b{y}_{2}) & =2\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2})-x\\frac{\\text{d}}{\\text{d}x}(a{y}_{1}+b{y}_{2}) \\\\  & =2a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+2b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}-ax\\frac{\\text{d}{y}_{1}}{\\text{d}x}-bx\\frac{\\text{d}{y}_{2}}{\\text{d}x} \\\\  & =a[2\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}-x\\frac{\\text{d}{y}_{1}}{\\text{d}x}]+b[2\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}-x\\frac{\\text{d}{y}_{2}}{\\text{d}x}] \\\\  & =a{D}_{2}({y}_{1})+b{D}_{2}({y}_{2})\\,✓\\end{aligned}\n$$\n\n- The third operator is also linear. To see this, we check the above linearity condition:\n\n$$\n\\begin{aligned}{D}_{3}(a{y}_{1}+b{y}_{2}) & ={x}^{2}\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2})+2x\\frac{\\text{d}}{\\text{d}x}(a{y}_{1}+b{y}_{2}) \\\\  & =a{x}^{2}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b{x}^{2}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+2ax\\frac{\\text{d}{y}_{1}}{\\text{d}x}+2bx\\frac{\\text{d}{y}_{2}}{\\text{d}x} \\\\  & =a[{x}^{2}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+2x\\frac{\\text{d}{y}_{1}}{\\text{d}x}]+b[{x}^{2}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+2x\\frac{\\text{d}{y}_{2}}{\\text{d}x}] \\\\  & =a{D}_{3}({y}_{1})+b{D}_{3}({y}_{2})\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186400464 :knowledge-point/_questions [{:db/id #edb/ref 17592186229137 :knowledge-point/id #uuid "17c792c0-3aec-5e40-8897-2eab9ff2ece0" :knowledge-point/title "Using the Properties of Linear Differential Operators to Identify Them"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a45c661-0328-5b60-bf43-2805e6e2bdf8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472640} {:answer/id #uuid "3a9275d3-6d58-5c1e-8aed-a79464b0f60f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472641}] :answer-field/correct {:answer/id #uuid "3a9275d3-6d58-5c1e-8aed-a79464b0f60f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472641} :answer-field/id #uuid "50304e5e-3802-559a-a25b-e235dace79f9" :answer-field/key "${D}_{1}(y)=x\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-2xy$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473715} {:answer-field/choices [{:answer/id #uuid "df01b709-9070-50ce-9ec7-eafc96b7fdc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472642} {:answer/id #uuid "ec36995e-5892-5d87-9fbe-0d9e8f9e9890" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472643}] :answer-field/correct {:answer/id #uuid "ec36995e-5892-5d87-9fbe-0d9e8f9e9890" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472643} :answer-field/id #uuid "4f4c274f-4a5a-5381-ade3-6743e84b9acb" :answer-field/key "${D}_{2}(y)={x}^{3}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473716} {:answer-field/choices [{:answer/id #uuid "7dde77a8-6b23-5244-bbc0-5609fee08c2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472644} {:answer/id #uuid "c499ada1-6b3c-5d89-b482-ec6473f37078" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472645}] :answer-field/correct {:answer/id #uuid "7dde77a8-6b23-5244-bbc0-5609fee08c2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472644} :answer-field/id #uuid "fae89a85-f0db-583e-90c1-cc35ca650aa2" :answer-field/key "${D}_{3}(y)=y\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+xy$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473717}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3d8c3559-a0d3-57b0-8496-a5eb629e4fde" :question/math-academy-id "q-130261" :question/problem "Which of the following are linear differential operators?\n\nSelect all that apply." :question/worked-solution "For any linear differential operator,\n\n$$\nD(a{y}_{1}+b{y}_{2})=aD({y}_{1})+bD({y}_{2})\n$$\n\nwhere $a$ and $b$ are constants. \n\nLet's check each case in turn.\n\n- The first operator is indeed linear. To see this, we check the above linearity condition:\n\n$$\n\\begin{aligned}{D}_{1}(a{y}_{1}+b{y}_{2}) & =x\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2})-2x(a{y}_{1}+b{y}_{2}) \\\\  & =ax\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+bx\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}-2ax{y}_{1}-2bx{y}_{2} \\\\  & =a[x\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}-2x{y}_{1}]+b[x\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}-2x{y}_{2}] \\\\  & =a{D}_{1}({y}_{1})+b{D}_{1}({y}_{2})\\,✓\\end{aligned}\n$$\n\n- The second operator is also linear. To see this, we check the above linearity condition:\n\n$$\n\\begin{aligned}{D}_{2}(a{y}_{1}+b{y}_{2}) & ={x}^{3}\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2}) \\\\  & =a{x}^{3}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b{x}^{3}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}} \\\\  & =a[{x}^{3}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}]+b[{x}^{3}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}] \\\\  & =a{D}_{2}({y}_{1})+b{D}_{2}({y}_{2})\\,✓\\end{aligned}\n$$\n\n- The third operator is **not** linear.\nTo see why, we first evaluate the left-hand side of the linearity condition:\n\n$$\n\\begin{aligned}{D}_{3}(a{y}_{1}+b{y}_{2}) & =(a{y}_{1}+b{y}_{2})\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2})+x(a{y}_{1}+b{y}_{2}) \\\\  & =(a{y}_{1}+b{y}_{2})(a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}})+ax{y}_{1}+bx{y}_{2} \\\\  & ={a}^{2}{y}_{1}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+{b}^{2}{y}_{2}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+ab({y}_{1}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+{y}_{2}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}})+ax{y}_{1}+bx{y}_{2}\\end{aligned}\n$$\n\nThis is not the same as the right-hand side, because\n\n$$\n\\begin{aligned}a{D}_{3}({y}_{1})+b{D}_{3}({y}_{2}) & =a[{y}_{1}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+x{y}_{1}]+b[{y}_{2}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+x{y}_{2}] \\\\  & =a{y}_{1}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b{y}_{2}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+ax{y}_{1}+bx{y}_{2}.\\,\\times \\end{aligned}\n$$"} {:db/id #edb/ref 17592186400499 :knowledge-point/_questions [{:db/id #edb/ref 17592186115243 :knowledge-point/id #uuid "853a04b2-591a-51c2-b80f-73f559355d9f" :knowledge-point/title "Identifying an Elementary 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d4f8308-7466-5b10-aeb8-3c645cd76aac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472658} {:answer/id #uuid "6ef72410-bf24-549a-a67f-ebdeb7154ddd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472659}] :answer-field/correct {:answer/id #uuid "7d4f8308-7466-5b10-aeb8-3c645cd76aac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472658} :answer-field/id #uuid "db31b420-a5f5-58e8-97fd-f9e9cb76ee53" :answer-field/key "$P=\\begin{bmatrix}1 & 1 \\\\ -3 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473724} {:answer-field/choices [{:answer/id #uuid "bee9e24a-602d-5c0c-98ca-cdd5fbae2bd6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472660} {:answer/id #uuid "dc7362ee-1b3c-5b7d-b741-5aaa54d8f01e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472661}] :answer-field/correct {:answer/id #uuid "bee9e24a-602d-5c0c-98ca-cdd5fbae2bd6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472660} :answer-field/id #uuid "d9d9b753-6359-51de-b6d4-0b3f038c56f9" :answer-field/key "$Q=\\begin{bmatrix}1 & 1 \\\\ 1 & 2\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473725} {:answer-field/choices [{:answer/id #uuid "7057d88b-1459-5572-8b90-225fe7507d1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472662} {:answer/id #uuid "09ed49a2-61b4-5571-b71d-a8135e86fa2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472663}] :answer-field/correct {:answer/id #uuid "09ed49a2-61b4-5571-b71d-a8135e86fa2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472663} :answer-field/id #uuid "8936a0e3-4ffe-5d36-8c85-7c84649c2227" :answer-field/key "$S=\\begin{bmatrix}1 & -1 \\\\ 0 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473726}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0d49dd3c-2d26-5daf-baa6-13e98e158d10" :question/math-academy-id "q-130772" :question/problem "Which of the following are elementary matrices?\n\nSelect all that apply." :question/worked-solution "An elementary matrix is a matrix obtained from the identity matrix by applying exactly one elementary row operation. \n\nWith that in mind, let's examine our matrices.\n\n- The matrices $P$ and $Q$ are not elementary matrices because they can't be obtained from ${I}_{2}$ by applying only one elementary row operation.\n\n- The matrix $S$ is an elementary matrix because it can be obtained from ${I}_{2}$ by applying the elementary row operation ${R}_{1}:={R}_{1}+(-1){R}_{2},$ as follows:\n\n$$\n\\begin{aligned}{I}_{2} & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} &  & {R}_{1}:={R}_{1}+(-1){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -1 \\\\ 0 & 1\\end{bmatrix} \\\\  & =S\\end{aligned}\n$$\n\nTherefore, only $S$ is an elementary matrix."} {:db/id #edb/ref 17592186400506 :knowledge-point/_questions [{:db/id #edb/ref 17592186115243 :knowledge-point/id #uuid "853a04b2-591a-51c2-b80f-73f559355d9f" :knowledge-point/title "Identifying an Elementary 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c34442a-1ba5-50e6-9956-6c60c53a175d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472664} {:answer/id #uuid "bcb5e1b1-f89e-5daa-85b2-e0dde4da66b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472665}] :answer-field/correct {:answer/id #uuid "4c34442a-1ba5-50e6-9956-6c60c53a175d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472664} :answer-field/id #uuid "61214d2d-44ba-553b-b6a3-330618cebbc3" :answer-field/key "$A=\\begin{bmatrix}3 & -2 \\\\ 5 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473727} {:answer-field/choices [{:answer/id #uuid "41438b30-61cc-5947-860b-7cfc8403798e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472666} {:answer/id #uuid "341c504d-f433-56b8-84a8-a8071aab725e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472667}] :answer-field/correct {:answer/id #uuid "341c504d-f433-56b8-84a8-a8071aab725e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472667} :answer-field/id #uuid "404fba34-ac4e-5d8f-94be-c73393320824" :answer-field/key "$B=\\begin{bmatrix}4 & 0 \\\\ 0 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473728} {:answer-field/choices [{:answer/id #uuid "3cbd5216-0eff-5c56-b724-fc09fc8bb69a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472668} {:answer/id #uuid "a66c8c1d-1486-5250-a60d-94bda0fdbe47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472669}] :answer-field/correct {:answer/id #uuid "3cbd5216-0eff-5c56-b724-fc09fc8bb69a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472668} :answer-field/id #uuid "04ab6b85-9a99-552b-a3a8-da32f99df79a" :answer-field/key "$C=\\begin{bmatrix}6 & -2 \\\\ 3 & 9\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473729}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ea3b1565-0857-5d0a-8afe-805754b2cf2a" :question/math-academy-id "q-130778" :question/problem "Which of the following are elementary matrices?\n\nSelect all that apply." :question/worked-solution "An elementary matrix is a matrix obtained from the identity matrix by applying exactly one elementary row operation. \n\nWith that in mind, let's examine our matrices.\n\n- The matrices $A$ and $C$ are not elementary matrices because they can't be obtained from ${I}_{2}$ by applying only one elementary row operation.\n\n- The matrix $B$ is an elementary matrix because it can be obtained from ${I}_{2}$ by applying the elementary row operation ${R}_{1}:=4{R}_{1},$ as follows:\n\n$$\n\\begin{aligned}{I}_{2} & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} &  & {R}_{1}:=4{R}_{1} \\\\  & ∼\\begin{bmatrix}4 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =B\\end{aligned}\n$$\n\nTherefore, only $B$ is an elementary matrix."} {:db