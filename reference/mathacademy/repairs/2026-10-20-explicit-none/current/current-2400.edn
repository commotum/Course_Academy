swer/id #uuid "1cefc54e-0efc-53ef-8cc1-fff5488204b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473087}] :answer-field/correct {:answer/id #uuid "1cefc54e-0efc-53ef-8cc1-fff5488204b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473087} :answer-field/id #uuid "29967360-3ab9-5db6-88fc-1504799fabb3" :answer-field/key "$c=0$ gives the axes $x=0$ and $y=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473938}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fb8b2d04-67d4-51d3-8ebf-71fc804b1a61" :question/math-academy-id "q-35527" :question/problem "The level curves of the function $f(x,y)=xy$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}xy & =c\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=\\pm 1$ then the level curves are $xy=\\pm 1,$ which are hyperbolas.\n\n- If $c=0$ then the level curves are $xy=0,$ which consists of the axes $x=0$ and $y=0.$\n\nSo, only statements “$c=1$ gives a hyperbola” and “$c=0$ gives the axes $x=0$ and $y=0$” are true."} {:db/id #edb/ref 17592186402448 :knowledge-point/_questions [{:db/id #edb/ref 17592186124480 :knowledge-point/id #uuid "b1a557d6-52f3-5df3-8088-5b875296e72e" :knowledge-point/title "Finding the Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13d4e89d-c103-5d40-b38f-bacbe060842d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186574383} {:answer/id #uuid "5a39fce3-a6f9-55c3-9816-460c56fb07c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 175921