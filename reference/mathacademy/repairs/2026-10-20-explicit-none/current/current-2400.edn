{:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472670} {:answer/id #uuid "cd76ef06-44e2-5754-b673-0df8c217d82f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472671}] :answer-field/correct {:answer/id #uuid "cd76ef06-44e2-5754-b673-0df8c217d82f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472671} :answer-field/id #uuid "44168093-c10a-5d0a-8140-ec50530f4e49" :answer-field/key "$5{y}^{″}+x{y}^{′}+y$ $=\\operatorname{cos}⁡x,$ $\\,y(0)$ $=0,$ $\\,{y}^{′}(0)$ $=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473730} {:answer-field/choices [{:answer/id #uuid "8777ff23-d174-5667-8e1f-e6c3e117ab9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472672} {:answer/id #uuid "2dc36741-bfd4-5924-8053-01816df989ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472673}] :answer-field/correct {:answer/id #uuid "8777ff23-d174-5667-8e1f-e6c3e117ab9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472672} :answer-field/id #uuid "6718b63b-805d-5948-97da-74393d3fb5ba" :answer-field/key "${x}^{2}{y}^{″}-{e}^{x}{y}^{′}$ $=0,$ $\\,y(0)$ $=1,$ $\\,{y}^{′}(1)$ $=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473731} {:answer-field/choices [{:answer/id #uuid "71701165-79b0-527d-b2a4-9b177d828615" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472674} {:answer/id #uuid "9eee5dd1-afa1-5ed4-b8b2-4ac6dc7876a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472675}] :answer-field/correct {:answer/id #uuid "9eee5dd1-afa1-5ed4-b8b2-4ac6dc7876a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472675} :answer-field/id #uuid "3fd34cea-273a-53f0-96bd-f7662dd63ffa" :answer-field/key "$\\frac{1}{x}{y}^{″}+{x}^{2}{y}^{′}$ $={e}^{x},$ $\\,y(1)$ $=0,$ $\\,{y}^{′}(1)$ $=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473732}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "30c6fcc7-4b73-56ac-a7b7-837e8d6bcc9e" :question/math-academy-id "q-130998" :question/problem "Which of the following systems is an initial value problem?\n\nSelect all that apply." :question/worked-solution "If a second-order differential equation for the function $y(x)$ is given with two conditions specified at the *same* location in the domain of $y,$ then this is an **initial value problem**.\n\nLet's go through each equation in turn.\n\n- The first system is an initial value problem. The differential equation is together with two conditions at the same location in the domain of $y(x)$ (i.e., at $x=0$).\n\n- The second system is not an initial value problem. It consists of a differential equation together with two conditions at different points in the domain of $y(x)$ (i.e., at $x=0$ and $x=1$). This is a **boundary value problem.**\n\n- The third system is an initial value problem. The differential equation is together with two conditions at the same location in the domain of $y(x)$ (i.e., at $x=1$)."} {:db/id #edb/ref 17592186400590 :knowledge-point/_questions [{:db/id #edb/ref 17592186124480 :knowledge-point/id #uuid "b1a557d6-52f3-5df3-8088-5b875296e72e" :knowledge-point/title "Finding the Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "188cbed6-26