ield/choices [{:answer/id #uuid "a9877ba2-24a3-546f-b27b-5ccbc896ac71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186574189} {:answer/id #uuid "8d5fd6f1-9c75-5799-8817-ae66cc40580a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574190}] :answer-field/correct {:answer/id #uuid "8d5fd6f1-9c75-5799-8817-ae66cc40580a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574190} :answer-field/id #uuid "7b0cc220-9c83-509f-a721-addc6c55c08c" :answer-field/key "Column 3: $\\begin{bmatrix}4 \\\\ -1 \\\\ 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186574577}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0565b425-ebb4-5d4a-bad6-acea463e950b" :question/math-academy-id "q-130930" :question/problem "The row echelon form matrix $A$ is given below. What are the pivot columns of $A?$\n\n$$\nA=\\begin{bmatrix}-2 & 3 & 4 \\\\ 0 & 0 & -1 \\\\ 0 & 0 & 0\\end{bmatrix}\n$$\n\nSelect all that apply." :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $A$ has $2$ pivots in the $1$st and $3$rd columns:\n\n$$\nA=\\begin{bmatrix}-2 & 3 & 4 \\\\ 0 & 0 & -1 \\\\ 0 & 0 & 0\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186400527 :knowledge-point/_questions [{:db/id #edb/ref 17592186124477 :knowledge-point/id #uuid "488c9762-554b-5ea6-b414-ce6cbde9bbd1" :knowledge-point/title "Finding the Pivot Columns of a Matrix in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a22329d-0498-5ee7-8f39-94b88e103d4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db