ect {:answer/id #uuid "9e4326cb-4d8d-5207-b9c8-0fd4685f3014" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438464} :answer-field/id #uuid "333d2ca5-a645-504d-8a15-7152d8798643" :answer-field/key "$H = \\begin{bmatrix}-2 & 0 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439261}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "69d9ccdc-d7b6-5ce9-82c3-15199547a51a" :question/math-academy-id "q-69517" :question/problem "Which of the following is a $3\\times 1$ matrix?\n\nSelect all that apply." :question/worked-solution "- The matrix $F$ has $3$ rows and $3$ columns. So, its dimensions are $3\\times 3.$ $\\,\\times $\n\n- The matrix $G$ has $3$ rows and $1$ column. So, its dimensions are $3\\times 1.$ $\\,✓$\n\n- The matrix $H$ has $1$ row and $3$ columns. So, its dimensions are $1\\times 3.$ $\\,\\times $\n\nTherefore, only $G$ is a $3\\times 1$ matrix."} {:db/id #edb/ref 17592186403335 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8bfe8db-1989-5e4c-9ad9-c6db83ad7bb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438484} {:answer/id #uuid "6b7cbeaf-dee8-5b96-8308-94729708799c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438485}] :answer-field/correct {:answer/id #uuid "f8bfe8db-1989-5e4c-9ad9-c6db83ad7bb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438484} :answer-field/id #uuid "4ec23c8b-291b-5610-9226-611cabeda584" :answer-field/key "$T$ is a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439271} {:answer-field/choices [{:answer/id #uuid "f42e4a93-c186-58e5-951e-917759693098" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438486} {:answer/id #uuid "f52e2b00-e5d8-52b7-83e8-eba250bef166" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438487}] :answer-field/correct {:answer/id #uuid "f42e4a93-c186-58e5-951e-917759693098" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438486} :answer-field/id #uuid "dfb6943e-42d8-5697-b023-3106b7e5611c" :answer-field/key "$det(T)=-3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439272} {:answer-field/choices [{:answer/id #uuid "74d5746f-c69f-5b13-8c52-ab7a0cb272bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438488} {:answer/id #uuid "f9a8ba1d-5bcb-54c6-a41a-1a451759a5dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438489}] :answer-field/correct {:answer/id #uuid "f9a8ba1d-5bcb-54c6-a41a-1a451759a5dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438489} :answer-field/id #uuid "2f6d01c9-2762-59a1-a7a5-cb52ffab3689" :answer-field/key "$T$ is **not** a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439273}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0582f249-3bf5-5079-8fe1-8ed6df521a52" :question/math-academy-id "q-69835" :question/problem "Which of the following statements are true regarding the matrix $T$ given below?\n\nSelect all that apply.\n\n$$\nT=\\begin{bmatrix}4 & 2 & -1 \\\\ 1 & 2 & 3 \\\\ -2 & -1 & 1\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:  \n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}4 & 2 & -1 \\\\ 1 & 2 & 3 \\\\ -2 & -1 & 1\\end{aligned}| \\\\  & =4|\\begin{aligned}2 & 3 \\\\ -1 & 1\\end{aligned}|-2|\\begin{aligned}1 & 3 \\\\ -2 & 1\\end{aligned}|-1|\\begin{aligned}1 & 2 \\\\ -2 & -1\\end{aligned}| \\\\  & =4(2+3)-2(1+6)-1(-1+4) \\\\  & =4\\cdot 5-2\\cdot 7-1\\cdot 3 \\\\  & =20-14-3 \\\\  & =3\\end{aligned}\n$$\n\n \n\nSince $det(T)=3\\ne 0$, the matrix is **not** singular. \n\nTherefore, only statement “$T$ is **not** a singular matrix” is true."} {:db/id #edb/ref 17592186403377 :knowledge-point/_questions [{:db/id #edb/ref 17592186110575 :knowledge-point/id #uuid "af0b18ca-54a2-5a24-a670-faa311096abc" :knowledge-point/title "Determining Points that Lie on the Curve of the Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e246cc4f-48d8-5861-8ebf-2a330196ae62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473236} {:answer/id #uuid "b3e54515-10ce-5213-9b65-1a09d106ed36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473237}] :answer-field/correct {:answer/id #uuid "b3e54515-10ce-5213-9b65-1a09d106ed36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473237} :answer-field/id #uuid "5e252753-7868-5440-b351-a8755d6b1e4e" :answer-field/key "$(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{6})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474013} {:answer-field/choices [{:answer/id #uuid "f55beb42-3349-5766-8922-b1d49bc1a855" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473238} {:answer/id #uuid "b5a4732b-8a5e-5008-9531-7810daa2d694" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473239}] :answer-field/correct {:answer/id #uuid "f55beb42-3349-5766-8922-b1d49bc1a855" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473238} :answer-field/id #uuid "21d48d76-65ca-530a-8a8b-5386e752f1fe" :answer-field/key "$(\\frac{\\sqrt{3}}{2},-\\frac{\\pi }{6})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474014} {:answer-field/choices [{:answer/id #uuid "008c2ada-a21c-5f01-a377-7b26fb8ace47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473240} {:answer/id #uuid "655cdd69-6c8f-5b1c-a494-321618a7417a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473241}] :answer-field/correct {:answer/id #uuid "008c2ada-a21c-5f01-a377-7b26fb8ace47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473240} :answer-field/id #uuid "072bd673-0d84-5b7a-a19d-fa3ef7094ce9" :answer-field/key "$(1,\\frac{\\pi }{3})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474015}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3692464e-f017-5c85-befd-6c0f45c59ad9" :question/math-academy-id "q-70769" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arccos}⁡x?$\n\nSelect all that apply." :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arccos}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{cos}⁡x.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arccos}⁡x,$ which is $y\\in [0,\\pi ].$\n\nWith this in mind, let's check each of the points. \n\n- First, we consider the point $(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{6}).$ We note the following:\n\n- The point $(\\frac{\\pi }{6},\\frac{\\sqrt{3}}{2})$ lies on the graph of $y=\\operatorname{cos}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arccos}⁡x$ is $y\\in [0,\\pi ],$ and $y=\\frac{\\pi }{6}$ lies within this range. $\\,✓$\n\nTherefore, the point $(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{6})$ lies on the graph of $y=\\operatorname{arccos}⁡x.$\n\n- Next, we consider the point $(\\frac{\\sqrt{3}}{2},-\\frac{\\pi }{6}).$ We note the following:\n\n- The point $(-\\frac{\\pi }{6},\\frac{\\sqrt{3}}{2})$ lies on the graph of $y=\\operatorname{cos}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arccos}⁡x$ is $y\\in [0,\\pi ],$ and $y=-\\frac{\\pi }{6}$ does **not** lie within this range.   $\\,\\times $\n\nTherefore, the point $(\\frac{\\sqrt{3}}{2},-\\frac{\\pi }{6})$ does **not** lie on the graph of $y=\\operatorname{arccos}⁡x.$\n\n- Finally, we consider the point $(1,\\frac{\\pi }{3}).$ We note the following:\n\n- The point $(\\frac{\\pi }{3},1)$ does **not** lie on the graph of $y=\\operatorname{cos}⁡x.$  $\\,\\times $\n\nTherefore, the point $(1,\\frac{\\pi }{3})$ does **not** lie on the graph of $y=\\operatorname{arccos}⁡x.$"} {:db/id #edb/ref 17592186403384 :knowledge-point/_questions [{:db/id #edb/ref 17592186110587 :knowledge-point/id #uuid "5b834b64-9679-56c2-b5e9-ee26a54b5e13" :knowledge-point/title "Identifying Values in the Domain of the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e693f80-a3a3-551a-967f-182e4c12c493" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473242} {:answer/id #uuid "8835e78e-1e62-57b6-80f9-3386641d53b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473243}] :answer-field/correct {:answer/id #uuid "8835e78e-1e62-57b6-80f9-3386641d53b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473243} :answer-field/id #uuid "b008506d-0569-5fde-b5ee-4d41d0b9e621" :answer-field/key "$\\frac{\\pi }{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474016} {:answer-field/choices [{:answer/id #uuid "a3cbec53-2d59-565e-b893-c292adacfe80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473244} {:answer/id #uuid "6e4314c8-4230-52e3-b4d0-9b138072dd6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473245}] :answer-field/correct {:answer/id #uuid "6e4314c8-4230-52e3-b4d0-9b138072dd6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473245} :answer-field/id #uuid "cd874f9f-fbb9-5d95-9beb-7cd7270d087a" :answer-field/key "$2\\pi $" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474017} {:answer-field/choices [{:answer/id #uuid "7253d679-fba9-5e01-97d4-bcd23f4862a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473246} {:answer/id #uuid "073f3921-d722-50e5-9ec5-665fc78cf09a" :answer/type {:db/id #edb/ref 1759218604