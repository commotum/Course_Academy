pe {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438934}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "04472571-0a00-5fac-9502-9b8f8afd8c8a" :question/math-academy-id "q-128480" :question/problem "Which of the following statements are true regarding the matrix $D$ given below?\n\nSelect all that apply.\n\n$$\nD=\\begin{bmatrix}2 & -3 & 1 \\\\ -1 & 2 & 3 \\\\ -3 & 5 & 2\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(D) & =|\\begin{aligned}2 & -3 & 1 \\\\ -1 & 2 & 3 \\\\ -3 & 5 & 2\\end{aligned}| \\\\  & =2|\\begin{aligned}2 & 3 \\\\ 5 & 2\\end{aligned}|+3|\\begin{aligned}-1 & 3 \\\\ -3 & 2\\end{aligned}|+1|\\begin{aligned}-1 & 2 \\\\ -3 & 5\\end{aligned}| \\\\  & =2(4-15)+3(-2+9)+1(-5+6) \\\\  & =2\\cdot (-11)+3\\cdot 7+1\\cdot 1 \\\\  & =-22+21+1 \\\\  & =0\\end{aligned}\n$$\n\n \n\nSince $det(D)=0$, the matrix is singular. \n\nTherefore, only statements “$D$ is a singular matrix” and $det(D)=0$ are true."} {:db/id #edb/ref 17592186400359 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5b8b793-b0e3-5e04-8a37-a42568d9a5f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437818} {:answer/id #uuid "20bd5256-a3ef-5a48-b762-66cfb4a56832" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437819}] :answer-field/correct {:answer/id #uuid "d5b8b793-b0e3-5e04-8a37-a42568d9a5f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437818} :answer-field/id #uuid "f79065b5-83e0-5c45-91ca-02a92fe83586" :answer-field/key "$S$ is a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438938} {:answer-field/choices [{:answer/id #uuid "51e1d911-6963-56d2-a197-b7ef0fd454a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437820} {:answer/id #uuid "cee5556a-e5f1-5649-8414-f96934145291" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437821}] :answer-field/correct {:answer/id #uuid "cee5556a-e5f1-5649-8414-f96934145291" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437821} :answer-field/id #uuid "6d2d1bc7-850d-5cc3-a700-a5297c1412e2" :answer-field/key "$S$ is **not** a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438939} {:answer-field/choices [{:answer/id #uuid "c31c4506-e579-5c13-bf9e-df8c0b4217ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437822} {:answer/id #uuid "f7553a7c-6618-5039-9f2e-70225d0f69b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437823}] :answer-field/correct {:answer/id #uuid "c31c4506-e579-5c13-bf9e-df8c0b4217ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437822} :answer-field/id #uuid "bd92868f-3a2b-5764-95b0-634de408c963" :answer-field/key "$det(S)=5+2\\sqrt{7}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438940}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5bcc7af8-2cd5-53ed-a962-12d9bd009077" :question/math-academy-id "q-128491" :question/problem "Which of the following statements are true regarding the matrix $S$ given below?\n\nSelect all that apply.\n\n$$\nS=\\begin{bmatrix}2\\sqrt{7} & 0 & \\frac{1}{2} \\\\ -\\sqrt{7} & 2 & 0 \\\\ 5 & 0 & \\sqrt{7}\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(S) & =|\\begin{aligned}2\\sqrt{7} & 0 & \\frac{1}{2} \\\\ -\\sqrt{7} & 2 & 0 \\\\ 5 & 0 & \\sqrt{7}\\end{aligned}| \\\\  & =2\\sqrt{7}|\\begin{aligned}2 & 0 \\\\ 0 & \\sqrt{7}\\end{aligned}|-0|\\begin{aligned}-\\sqrt{7} & 0 \\\\ 5 & \\sqrt{7}\\end{aligned}|+\\frac{1}{2}|\\begin{aligned}-\\sqrt{7} & 2 \\\\ 5 & 0\\end{aligned}| \\\\  & =2\\sqrt{7}(2\\sqrt{7}-0)-0+\\frac{1}{2}(0-10) \\\\  & =2\\sqrt{7}\\cdot 2\\sqrt{7}+\\frac{1}{2}\\cdot (-10) \\\\  & =28-5 \\\\  & =23\\end{aligned}\n$$\n\nSince $det(S)=23\\ne 0$, the matrix is **not ** singular. \n\nTherefore, only statement “$S$ is **not** a singular matrix” is true."} {:db/id #edb/ref 17592186400366 :knowledge-point/_questions [{:db/id #edb/ref 17592186059849 :knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb" :knowledge-point/title "Solving for an Unknown Given the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3601e09a-9335-5956-9835-0fbca8ffb502" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439483} {:answer/id #uuid "3db08d97-0845-5f7c-ab43-56777bea1d91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186