eld/key "![Curve III](images/20/20bf870a2e238d4ab16860bd788180fb59f25d43f2f91b23ddd2256e8921a048.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473762}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8be6241f-30ce-53dd-8d31-e6a859245baf" :question/math-academy-id "q-141740" :question/problem "Which of the curves below are concave up?\n\nSelect all that apply." :question/worked-solution "The concavity of a function refers to the direction in which its graph curves.\n\n- If the graph curves upward, like a \"smile\" ($⌣$), then the graph is said to be *concave up*.\n\n- If the graph curves downward, like a \"frown\" ($⌢$), then the graph is said to be *concave down*.\n\nIt's helpful to remember the mnemonic \"concave down like a frown.\"\n\nOnly graphs I and III curve upward (like a \"smile\") among the given graphs."} {:db/id #edb/ref 17592186401586 :knowledge-point/_questions [{:db/id #edb/ref 17592186129169 :knowledge-point/id #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004" :knowledge-point/title "Classifying a Region as Type I, Type II, Both, or Neither"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4564e18e-6dd3-592f-b9bf-6a20676a3b9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472766} {:answer/id #uuid "45b0e7fa-80cd-5a12-9738-58511f6045e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472767}] :answer-field/correct {:answer/id #uuid "4564e18e-6dd3-592f-b9bf-6a20676a3b9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472766} :answer-field/id #uuid "855b803a-41ec-54c7-b217-cd7e07f3f903" :answer-field/key "It is a type I region" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473778} {:answer-field/choices [{:answer/id #uuid "90203ed1-4476-519f-9f88-b4e02ca64ace" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472768} {:answer/id #uuid "97ba8073-07f2-57a8-a1bd-4281e7eb3559" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472769}] :answer-field/correct {:answer/id #uuid "90203ed1-4476-519f-9f88-b4e02ca64ace" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472768} :answer-field/id #uuid "193ec04e-372e-5547-a37c-6dcc99f24e8b" :answer-field/key "It is a type II region" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473779} {:answer-field/choices [{:answer/id #uuid "cec72ac9-8abf-5d07-936d-25ec93cb55c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472770} {:answer/id #uuid "1f3c4534-d68b-508f-9b49-1132a3559fdc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472771}] :answer-field/correct {:answer/id #uuid "1f3c4534-d68b-508f-9b49-1132a3559fdc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472771} :answer-field/id #uuid "3aa6603a-92f4-51b4-90a0-db5e275129ca" :answer-field/key "It's neither a type I nor a type II region" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473780}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fd6f7437-bc45-50cb-9400-bcd422c5b408" :question/math-academy-id "q-168921" :question/problem "Which of the following statements are true regarding the finite region bounded between the circle ${x}^{2}+{y}^{2}=4$ and the ellipse $4{x}^{2}+(y+1)^{2}=1?$\n\nSelect all that apply." :question/worked-solution "First, let's sketch our region.\n\n![](images/bc/bc6b71d1fe69abd34dbd939dc62ede5201b75713e25456cf084e889bc44f449e.png)\n\nWe have the following:\n\n- The vertical line $x=0.4$ intersects the region in two separate intervals, as shown below. So, this can't be a type I region.\n\n![](images/4a/4a1fd7069abaa3b3fa4d9c286773d226798bf3ad565e85663cab44557fd635c1.png)\n\n- The horizontal line $y=-1$ intersects the region in two separate intervals, as shown below. So, this can't be a type II region.\n\n![](images/26/260e8e959ca95a029a98bd4102106a66df418ea73c0640398c8fdebfdbf812f6.png)\n\nTherefore, only statement “It's neither a type I nor a type II region” is true."} {:db/id #edb/ref 17592186401948 :knowledge-point/_questions [{:db/id #edb/ref 17592186115222 :knowledge-point/id #uuid "80449399-3ae4-593f-8c3b-00bcdcc99727" :knowledge-point/title "Solving Trigonometric Equations Outside of the Range of Cosecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e142106e-ef73-57fa-840c-e61255e848de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473028} {:answer/id #uuid "8b51a4de-5f58-5a3a-9667-4951bc2003c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473029}] :answer-field/correct {:answer/id #uuid "8b51a4de-5f58-5a3a-9667-4951bc2003c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473029} :answer-field/id #uuid "853fc5ed-1831-5264-84f8-89ac0a5394d8" :answer-field/key "$\\operatorname{csc}⁡x=\\frac{1}{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473909} {:answer-field/choices [{:answer/id #uuid "a178d0a0-7bb3-51f9-a2f0-d6770e6ab934" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473030} {:answer/id #uuid "8d8c6e69-3447-5efd-bc84-017d7a667be6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473031}] :answer-field/correct {:answer/id #uuid "a178d0a0-7bb3-51f9-a2f0-d6770e6ab934" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473030} :answer-field/id #uuid "3e7b7604-ac37-5dd6-8299-2c0bf2fa638c" :answer-field/key "$\\operatorname{csc}⁡x=3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473910} {:answer-field/choices [{:answer/id #uuid "d256c368-dee8-53d7-9b0f-05cd06cd375d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473032} {:answer/id #uuid "c453c311-c99b-5aaa-a02e-c0d2e2e20b4f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473033}] :answer-field/correct {:answer/id #uuid "d256c368-dee8-53d7-9b0f-05cd06cd375d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473032} :answer-field/id #uuid "bdfa7e16-65c0-53eb-9f2b-c2106fc2c104" :answer-field/key "$\\operatorname{csc}⁡x=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473911}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2c11092b-9e53-51e1-b299-c5287bf677e1" :question/math-academy-id "q-29477" :question/problem "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n\nSelect all that apply." :question/worked-solution "Recall that the range of $\\operatorname{csc}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{csc}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{csc}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation $\\operatorname{csc}⁡x=\\frac{1}{3}$ has no solutions."} {:db/id #edb/ref 17592186401988 :knowledge-point/_questions [{:db/id #edb/ref 17592186115236 :knowledge-point/id #uuid "64b2036f-da0f-59de-8a39-6b33e6cbdd04" :knowledge-point/title "Completing a True Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "065a462e-4cdc-5a25-9872-a7c085366472" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473034} {:answer/id #uuid "4796d2c2-5c3f-5420-b0ba-923e0a7362e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473035}] :answer-field/correct {:answer/id #uuid "4796d2c2-5c3f-5420-b0ba-923e0a7362e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473035} :answer-field/id #uuid "19956410-3b4e-5a83-9e55-0c91ef55ef44" :answer-field/key "invertible" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473912} {:answer-field/choices [{:answer/id #uuid "6ade44ee-fae7-5546-89bf-d1e056d045e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473036} {:answer/id #uuid "6dc593be-5cc2-56f6-8fa5-0c64040fb219" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473037}] :answer-field/correct {:answer/id #uuid "6ade44ee-fae7-5546-89bf-d1e056d045e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473036} :answer-field/id #uuid "e330bc56-8a53-567d-8afb-824a3a134195" :answer-field/key "**not ** invertible" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473913} {:answer-field/choices [{:answer/id #uuid "bf6585ad-85fb-5822-832a-d01d1092359f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473038} {:answer/id #uuid "f582afb8-3915-5150-91e3-1ad4ae998fd9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473039}] :answer-field/correct {:answer/id #uuid "bf6585ad-85fb-5822-832a-d01d1092359f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473038} :answer-field/id #uuid "fa659d4d-f3e6-5ed9-9b2f-d21dc395e444" :answer-field/key "singular" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473914}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "561c404c-366e-5e58-b3aa-1094d48ff6e7" :question/math-academy-id "q-31919" :question/problem "Which of the following completes the statement so that it is true:\n\n*If $det(A)\\ne 0,$ where $A$ is a $2\\times 2$-matrix, then $A$ is $\\underline{\\phantom{xxxxxx}}$ .*\n\nSelect all that apply." :question/worked-solution "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n1\\. $A$ is invertible.\n\n2\\. The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n3\\. The system $Ax=0$ has the unique zero solution.\n\n4\\. The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n5\\. $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.  \n\nNow, since the fifth part of the invertible matrix theorem is true ($det(A)\\ne 0$), all the other parts of the theorem are true too. Therefore, according to the theorem, only option “invertible” gives a true statement:\n\n- *If $det(A)\\ne 0$ , then $A$ is invertible.* $\\,✓$"} {:db/id #edb/ref 17592186402207 :knowledge-point/_questions [{:db/id #edb/ref 17592186152281 :knowledge-point/id #uuid "a34d342c-e7fc-581b-b3d1-ed6a49f1a62f" :knowledge-point/title "Identifying Boundary Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b33f4ea-eb87-5a10-9db9-b7060a761d33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473064} {:answer/id #uuid "69700ab0-c164-55f2-a3ee-f6417efe3d8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473065}] :answer-field/correct {:answer/id #uuid "6b33f4ea-eb87-5a10-9db9-b7060a761d33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473064} :answer-field/id #uuid "84c54142-24d8-5e31-86ee-c1250b8bd6d1" :answer-field/key "$4{y}^{″}-{y}^{′}=\\operatorname{cos}⁡(x),\\,y(0)=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473927} {:answer-field/choices [{:answer/id #uuid "6696cf6e-cfb2-5f0b-af4a-87a52e42df26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473066} {:answer/id #uuid "75536d10-6f3a-5468-a75f-4c616860138d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473067}] :answer-field/correct {:answer/id #uuid "75536d10-6f3a-5468-a75f-4c616860138d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473067} :answer-field/id #uuid "e3dfc732-f8ca-5d4d-8efb-65f422851544" :answer-field/key "${y}^{″}+xy$ $={e}^{x},$ $\\,y(1)$ $=0,$ $\\,y(3)$ $=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473928} {:answer-field/choices [{:answer/id #uuid "e3095ce6-3605-5e05-9148-e2f97eb9e6c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473068} {:answer/id #uuid "b0b40c26-33d9-54de-ba97-6856c59ae600" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473069}] :answer-field/correct {:answer/id #uuid "e3095ce6-3605-5e05-9148-e2f97eb9e6c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473068} :answer-field/id #uuid "88d1fff8-8726-59e9-acc2-36dabbf2409e" :answer-field/key "${y}^{″}={x}^{3},\\,y(2)=5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473929}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a42fad0a-c170-522e-8f97-0f501aa9bc73" :question/math-academy-id "q-338587" :question/problem "Which of the following systems is a boundary value problem?\n\nSelect all that apply." :question/worked-solution "If a second-order differential equation for the function $y(x)$ is given with two conditions specified at *different* locations in the domain of $y,$ then this is a **boundary value problem**.\n\nLet's go through each equation in turn.\n\n- The first system is not a boundary value problem. It consists of a differential equation combined with only one condition.\n\n- The second system is a boundary value problem. It consists of a differential equation together with two conditions at different points in the domain of $y(x)$ (i.e., at $x=1$ and $x=3$).\n\n- The third system is not a boundary value problem. It consists of a differential equation combined with only one condition."} {:db/id #edb/ref 17592186402242 :knowledge-point/_questions [{:db/id #edb/ref 17592186152276 :knowledge-point/id #uuid "2d0a7ede-b896-56c6-9b60-a6aec8eff9e8" :knowledge-point/title "Identifying Second-Order Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b12ca010-23c7-5c1b-8b4c-56840bb07736" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473070} {:answer/id #uuid "6b05e278-5bae-5e61-b32f-14598a9387a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473071}] :answer-field/correct {:answer/id #uuid "6b05e278-5bae-5e61-b32f-14598a9387a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473071} :answer-field/id #uuid "ed18b99e-c355-5c3f-b3e5-3b1f0558a889" :answer-field/key "${x}^{2}{y}^{″}-2{y}^{′}+y$ $=\\operatorname{ln}⁡x,$ $\\,y(4)$ $=1,$ $\\,{y}^{′}(4)$ $=-1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473930} {:answer-field/choices [{:answer/id #uuid "bb1b2585-68f4-53b5-9ec6-8bc4769a9d2b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473072} {:answer/id #uuid "733c8d21-4cf3-55af-8e1b-fa9735e99d08" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473073}] :answer-field/correct {:answer/id #uuid "bb1b2585-68f4-53b5-9ec6-8bc4769a9d2b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473072} :answer-field/id #uuid "628ab7bf-6d66-5209-9861-017c81de0995" :answer-field/key "$x{y}^{″}+{y}^{′}-2y=9$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473931} {:answer-field/choices [{:answer/id #uuid "edc555cb-dacc-5852-8727-9445340aa9e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473074} {:answer/id #uuid "12455a42-9fbf-5d7b-a5f0-7cf06096b870" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473075}] :answer-field/correct {:answer/id #uuid "12455a42-9fbf-5d7b-a5f0-7cf06096b870" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473075} :answer-field/id #uuid "28284641-0b1f-5dd4-b444-8cbf3767911a" :answer-field/key "${x}^{2}{y}^{″}-8x{y}^{′}+16y$ $=\\operatorname{cos}⁡x,$ $\\,y(2)$ $=0,$ $\\,{y}^{′}(2)$ $=3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473932}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c104c7c7-be1b-5f7c-9495-548d3d354240" :question/math-academy-id "q-339251" :question/problem "Which of the following systems is an initial value problem?\n\nSelect all that apply." :question/worked-solution "If a second-order differential equation for the function $y(x)$ is given with two conditions specified at the *same* location in the domain of $y,$ then this is an **initial value problem**.\n\nLet's go through each equation in turn.\n\n- The first system is an initial value problem. The differential equation is together with two conditions at the same location in the domain of $y(x)$ (i.e., at $x=4$).\n\n- The second system is not an initial value problem. It contains an equation only. No conditions are specified.\n\n- The third system is an initial value problem. The differential equation is together with two conditions at the same location in the domain of $y(x)$ (i.e., at $x=2$)."} {:db/id #edb/ref 17592186402249 :knowledge-point/_questions [{:db/id #edb/ref 17592186152276 :knowledge-point/id #uuid "2d0a7ede-b896-56c6-9b60-a6aec8eff9e8" :knowledge-point/title "Identifying Second-Order Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e348bc01-46b1-5bd2-b869-40487ff49328" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473076} {:answer/id #uuid "fc67943e-71f3-5673-8b78-a60fc34bb1c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473077}] :answer-field/correct {:answer/id #uuid "fc67943e-71f3-5673-8b78-a60fc34bb1c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473077} :answer-field/id #uuid "ba960e3f-7dfb-500b-a624-7b5dc38c1610" :answer-field/key "$x{y}^{″}-{y}^{′}+2y$ $=\\operatorname{cos}⁡x,$ $\\,y(0)$ $=1,$ $\\,{y}^{′}(0)$ $=-1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473933} {:answer-field/choices [{:answer/id #uuid "4f62c64b-c834-58fa-a346-8dfb03b9148f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473078} {:answer/id #uuid "d7885ee2-1285-579d-9ac5-47f82d22a162" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473079}] :answer-field/correct {:answer/id #uuid "4f62c64b-c834-58fa-a346-8dfb03b9148f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473078} :answer-field/id #uuid "f8d4195a-3427-5440-965f-cc6ccabf70a2" :answer-field/key "${x}^{2}{y}^{″}+{y}^{′}-y=5x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473934} {:answer-field/choices [{:answer/id #uuid "c0fc9a27-c2e8-5506-ad0c-35e8b198d13a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473080} {:answer/id #uuid "69a27a10-4a0a-5aac-a86f-2035515503d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473081}] :answer-field/correct {:answer/id #uuid "c0fc9a27-c2e8-5506-ad0c-35e8b198d13a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473080} :answer-field/id #uuid "18464276-4ba6-5bad-abd4-10456bac1421" :answer-field/key "${x}^{2}{y}^{″}-3x{y}^{′}+4y$ $={x}^{2},$ $\\,y(1)$ $=0,$ $\\,{y}^{′}(4)$ $=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473935}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e7b3292e-ae09-5cdf-bbb6-9d5f24a711b9" :question/math-academy-id "q-339256" :question/problem "Which of the following systems is an initial value problem?\n\nSelect all that apply." :question/worked-solution "If a second-order differential equation for the function $y(x)$ is given with two conditions specified at the *same* location in the domain of $y,$ then this is an **initial value problem**.\n\nLet's go through each equation in turn.\n\n- The first system is an initial value problem. The differential equation is together with two conditions at the same location in the domain of $y(x)$ (i.e., at $x=0$).\n\n- The second system is not an initial value problem. It contains an equation only. No conditions are specified.\n\n- The third system is not an initial value problem. It consists of a differential equation together with two conditions at different points in the domain of $y(x)$ (i.e., at $x=1$ and $x=4$). This is a **boundary value problem.**"} {:db/id #edb/ref 17592186402427 :knowledge-point/_questions [{:db/id #edb/ref 17592186124475 :knowledge-point/id #uuid 