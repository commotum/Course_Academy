db/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472560} {:answer/id #uuid "4b839b0b-1d64-53ff-8342-215cf365c7bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472561}] :answer-field/correct {:answer/id #uuid "6a9a4dcb-6c09-5277-adf5-a6e2be83659f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472560} :answer-field/id #uuid "82a5b354-8bcb-5b10-bade-10010a8005ac" :answer-field/key "$C=\\begin{bmatrix}2 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473675}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b1fe65ee-e4c1-507a-9313-0ea6b012c1aa" :question/math-academy-id "q-126278" :question/problem "Which of the following are square matrices?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "- $A$ is a square matrix since it has the same number of rows and columns. It has $1$ row and $1$ column, so it is a $1\\times 1$ matrix.\n\n- $B$ is a square matrix since it has the same number of rows and columns. It has $3$ rows and $3$ columns, so it is a $3\\times 3$ matrix.\n\n- $C$ is *not* a square matrix since the numbers of rows and columns are not the same. It has $1$ row and $2$ columns, so it's a $1\\times 2$ matrix.\n\nTherefore, only $A$ and $B$ are square matrices."} {:db/id #edb/ref 17592186400219 :knowledge-point/_questions [{:db/id #edb/ref 17592186087698 :knowledge-point/id #uuid "7b6ddadb-471a-5195-a0f5-fd44bdc8f780" :knowledge-point/title "Identifying Other Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "778e7dac-5d43-5278-8a2c-8d400611b7e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472562} {:answer/id #uuid "6090d412-485e-50cf-bfc7-d6f5ce1710e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472563}] :answer-field/correct {:answer/id #uuid "778e7dac-5d43-5278-8a2c-8d400611b7e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472562} :answer-field/id #uuid "254f4622-91f2-53e1-9ca7-228a6b89a866" :answer-field/key "$A=\\begin{bmatrix}-2 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473676} {:answer-field/choices [{:answer/id #uuid "6e6e0ca1-4931-5c90-b1e8-b3f10d94782b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472564} {:answer/id #uuid "6ad8d633-8913-57ff-81b6-ff6ed7cda5ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472565}] :answer-field/correct {:answer/id #uuid "6ad8d633-8913-57ff-81b6-ff6ed7cda5ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472565} :answer-field/id #uuid "eb175dfe-5424-5925-87ac-fcfcfe4f1ee9" :answer-field/key "$B=\\begin{bmatrix}2 \\\\ 0 \\\\ 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473677} {:answer-field/choices [{:answer/id #uuid "f8adb032-5514-5fe0-ac30-71530e19db78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472566} {:answer/id #uuid "c7c00a78-5e98-5faf-8370-a644cb2e14d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472567}] :answer-field/correct {:answer/id #uuid "f8adb032-5514-5fe0-ac30-71530e19db78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472566} :answer-field/id #uuid "51ad90c1-174f-5dc3-b843-6e2757ba5454" :answer-field/key "$C=\\begin{bmatrix}1 & -3 \\\\ -2 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473678}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c9fca4a1-9999-5571-b7b3-a6f45eb203a9" :question/math-academy-id "q-126287" :question/problem "Which of the following are column vectors?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "- $A$ is *not* a column vector. It has only one row (and $2$ columns), so it's a row vector.\n\n- $B$ is a column vector since it has only one column.\n\n- $C$ is *not* a column vector, since it has more than $1$ column (it has $2$ columns).\n\nTherefore, only $B$ is a column vector."} {:db/id #edb/ref 17592186400345 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "869e00c6-a4ba-5e49-adbb-6c7b2dfda6d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437800} {:answer/id #uuid "cc3eef7f-38ce-53c9-b7d7-5ad7331d9db5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437801}] :answer-field/correct {:answer/id #uuid "869e00c6-a4ba-5e49-adbb-6c7b2dfda6d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437800} :answer-field/id #uuid "ee1ffe9f-6a37-5717-a79c-006e1e279e9f" :answer-field/key "$det(F)=-7$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438929} {:answer-field/choices [{:answer/id #uuid "73f233cd-a07f-56cc-b019-5bf1a281c9e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437802} {:answer/id #uuid "0370b8e5-fbed-53fa-bba4-73a7be7e3de4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437803}] :answer-field/correct {:answer/id #uuid "0370b8e5-fbed-53fa-bba4-73a7be7e3de4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437803} :answer-field/id #uuid "91e6ecc2-f970-55e9-9644-03d1a8d33b21" :answer-field/key "$F$ is **not** a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438930} {:answer-field/choices [{:answer/id #uuid "ecabd635-8703-591e-8d3a-ae23bbdf9467" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437804} {:answer/id #uuid "a6071a93-94cd-5aa5-98a0-dee30b1fa3cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437805}] :answer-field/correct {:answer/id #uuid "ecabd635-8703-591e-8d3a-ae23bbdf9467" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437804} :answer-field/id #uuid "d1b2f581-bf3c-5b63-a3e5-a1336a490a06" :answer-field/key "$det(F)=-2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438931}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "af5c321a-ef93-52c0-aab1-818de4211e7b" :question/math-academy-id "q-128478" :question/problem "Which of the following statements are true regarding the matrix $F$ given below?\n\nSelect all that apply.\n\n$$\nF=\\begin{bmatrix}2 & 8 & 3 \\\\ -1 & 2 & 1 \\\\ 5 & 3 & 1\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(F) & =|\\begin{aligned}2 & 8 & 3 \\\\ -1 & 2 & 1 \\\\ 5 & 3 & 1\\end{aligned}| \\\\  & =2|\\begin{aligned}2 & 1 \\\\ 3 & 1\\end{aligned}|-8|\\begin{aligned}-1 & 1 \\\\ 5 & 1\\end{aligned}|+3|\\begin{aligned}-1 & 2 \\\\ 5 & 3\\end{aligned}| \\\\  & =2(2-3)-8(-1-5)+3(-3-10) \\\\  & =2\\cdot (-1)-8\\cdot (-6)+3\\cdot (-13) \\\\  & =-2+48-39 \\\\  & =7\\end{aligned}\n$$\n\nSince $det(F)=7$, the matrix is **not** singular. \n\nTherefore, only statement “$F$ is **not** a singular matrix” is true."} {:db/id #edb/ref 17592186400443 :knowledge-point/_questions [{:db/id #edb/ref 17592186152291 :knowledge-point/id #uuid "6302f81d-4834-56a5-b014-0a97c3dccd6f" :knowledge-point/title "Identifying True Statements About General Solutions of Second-Order Linear ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84c8f04c-de6b-5dce-8146-3527e7f3c7e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472628} {:answer/id #uuid "0061914e-dc5a-5b4b-b20d-0dff9b1f199a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472629}] :answer-field/correct {:answer/id #uuid "84c8f04c-de6b-5dce-8146-3527e7f3c7e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472628} :answer-field/id #uuid "3b786eeb-eeb2-5390-97de-30db0cd0a4a0" :answer-field/key "${y}_{1}(x)=\\operatorname{cos}⁡2x$ is a solution to the equation" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473709} {:answer-field/choices [{:answer/id #uuid "b39ecdd1-99d2-5181-a232-644b1fec6bb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472630} {:answer/id #uuid "09f679cc-1efe-592e-bc54-96e5c28fcd47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472631}] :answer-field/correct {:answer/id #uuid "09f679cc-1efe-592e-bc54-96e5c28fcd47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472631} :answer-field/id #uuid "f85cfc2b-302f-523b-9ac3-ac732c5a7401" :answer-field/key "${y}_{2}(x)=\\operatorname{sin}⁡{x}^{2}$ is a solution to the equation" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473710} {:answer-field/choices [{:answer/id #uuid "d4cb9d85-ad64-51d4-ace3-d8787ac79d59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472632} {:answer/id #uuid "37f1603b-5499-5a0f-96e1-ad3d9b521467" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472633}] :answer-field/correct {:answer/id #uuid "d4cb9d85-ad64-51d4-ace3-d8787ac79d59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472632} :answer-field/id #uuid "e0ef7d5f-8712-5e8d-8f93-b65f5f6af37b" :answer-field/key "The general solution of the equation is $y=A\\operatorname{cos}⁡2x+B\\operatorname{sin}⁡{x}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473711}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5007768b-5de4-5206-bbd7-b32aa44bd388" :question/math-academy-id "q-130005" :question/problem "Consider the differential equation $x{y}^{″}-{y}^{′}+4{x}^{3}y=0.$ Which of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Let's check each statement:\n\n- To determine whether ${y}_{1}(x)$ is a solution to the differential equation, we substitute ${y}_{1}$ and its derivatives into the equation.\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & =-2\\operatorname{sin}⁡2x \\\\ {y}_{1}^{″}(x) & =-4\\operatorname{cos}⁡2x.\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation. We get\n\n$$\nx(-4\\operatorname{cos}⁡2x)-(-2\\operatorname{sin}⁡2x)+4{x}^{3}\\operatorname{cos}⁡2x=(4{x}^{3}-4x)\\operatorname{cos}⁡2x+2\\operatorname{sin}⁡2x.\\,\\times \n$$\n\nSo, ${y}_{1}$ is not a solution to the equation, and therefore statement “${y}_{2}(x)=\\operatorname{sin}⁡{x}^{2}$ is a solution to the equation” is false.\n\n- Similarly, we compute the derivatives of ${y}_{2}$ and substitute to the equation. Computing the derivatives yields\n\nFirst, we find the first and second derivatives:\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & =2x\\operatorname{cos}⁡{x}^{2} \\\\ {y}_{2}^{″}(x) & =2\\operatorname{cos}⁡{x}^{2}-4{x}^{2}\\operatorname{sin}⁡{x}^{2}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation. We get\n\n$$\nx(2\\operatorname{cos}⁡{x}^{2}-4{x}^{2}\\operatorname{sin}⁡{x}^{2})-2x\\operatorname{cos}⁡{x}^{2}+4{x}^{3}\\operatorname{sin}⁡{x}^{2}=(2x-2x)\\operatorname{cos}⁡{x}^{2}+(4{x}^{3}-4{x}^{3})\\operatorname{sin}⁡{x}^{2}=0.\\,✓\n$$\n\nSo, ${y}_{2}$ is a solution to the equation, and therefore statement “${y}_{2}(x)=\\operatorname{sin}⁡{x}^{2}$ is a solution to the equation” is true.\n\n- So, ${y}_{2}$ is a solution while ${y}_{1}$ is not a solution of the equation, hence $y=A\\operatorname{cos}⁡2x+B\\operatorname{sin}⁡{x}^{2}$  is not the general solution.\n\nTherefore, statement “The general solution of the equation is $y=A\\operatorname{cos}⁡2x+B\\operatorname{sin}⁡{x}^{2}$” is false."} {:db/id #edb/ref 17592186400632 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "042c39af-05d4-5916-90ed-b2140841c0e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437884} {:answer/id #uuid "d6aa4878-727c-5081-a2f3-b05cc3779d8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437885}] :answer-field/correct {:answer/id #uuid "042c39af-05d4-5916-90ed-b2140841c0e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437884} :answer-field/id #uuid "819cb8bf-d475-5f1d-b674-12ded903565c" :answer-field/key "The system is consistent independent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438971} {:answer-field/choices [{:answer/id #uuid "2b9fab9a-732e-557e-89af-5c725e033f13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437886} {:answer/id #uuid "97937812-2266-5255-828e-cf5b3f4f3d5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437887}] :answer-field/correct {:answer/id #uuid "2b9fab9a-732e-557e-89af-5c725e033f13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437886} :answer-field/id #uuid "0eda7076-17f5-56be-93f9-786bf1b9618f" :answer-field/key "The system has no solution" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438972} {:answer-field/choices [{:answer/id #uuid "87384631-af80-5ad6-9a5c-bcc246f5f41d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437888} {:answer/id #uuid "46fcba46-2ddb-5e23-8878-f4e28acdd62f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437889}] :answer-field/correct {:answer/id #uuid "46fcba46-2ddb-5e23-8878-f4e28acdd62f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437889} :answer-field/id #uuid "fa55c229-a084-546e-87ad-83ef1343ba34" :answer-field/key "The system is consistent dependent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438973}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cd791ebf-f827-5528-ae25-d3ac1f74c5cc" :question/math-academy-id "q-131720" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}2x-6y-2z &=4 \\\\ 3x-9y-3z &=6\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}2 & -6 & -2 & 4 \\\\ 3 & -9 & -3 & 6\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & -6 & -2 & 4 \\\\ 3 & -9 & -3 & 6\\end{bmatrix} & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & -1 & 2 \\\\ 3 & -9 & -3 & 6\\end{bmatrix} & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & -1 & 2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x,$ and we have two free variables, $y$ and $z.$ That means we can find $x$ in terms of $y$ and $z.$ \n\nTherefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*. \n\nAs a result, only statement “The system is consistent dependent” is true."} {:db/id #edb/ref 17592186400639 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf929f6a-e145-57f9-9489-b8af5e174866" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437890} {:answer/id #uuid "7f26eb37-aeba-52b6-8b95-caafc52f3431" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437891}] :answer-field/correct {:answer/id #uuid "7f26eb37-aeba-52b6-8b95-caafc52f3431" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437891} :answer-field/id #uuid "2fbdbbd8-b352-5675-a10c-aa7c8880cb1e" :answer-field/key "The system is consistent independent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438974} {:answer-field/choices [{:answer/id #uuid "70be4c05-8842-5d93-9933-6a01768e4c37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437892} {:answer/id #uuid "6cec419e-f6b4-51c0-ae9e-deed2e858fc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437893}] :answer-field/correct {:answer/id #uuid "70be4c05-8842-5d93-9933-6a01768e4c37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437892} :answer-field/id #uuid "51c120d2-aebb-5e91-8e2f-ef0869ec4dd4" :answer-field/key "The system has no solution" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438975} {:answer-field/choices [{:answer/id #uuid "43f8ee53-d356-528d-9a82-f385997b6c3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437894} {:answer/id #uuid "262383e4-8fe8-5d1c-ad11-c487ac71bc1f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437895}] :answer-field/correct {:answer/id #uuid "43f8ee53-d356-528d-9a82-f385997b6c3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437894} :answer-field/id #uuid "07a2a3d4-474a-5d37-b1a5-05837e60f654" :answer-field/key "The system is consistent dependent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438976}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b9b47374-5548-52b6-9b51-17d923fcd37b" :question/math-academy-id "q-131721" :question/problem "Consider the following system of equations\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-1 \\\\ 3x+7y &=1 \\\\ -2x-4y &=2.\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}1 & 2 & -1 \\\\ 3 & 7 & 1 \\\\ -2 & -4 & 2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & -1 \\\\ 3 & 7 & 1 \\\\ -2 & -4 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & -1 \\\\ 0 & 1 & 4 \\\\ -2 & -4 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & -1 \\\\ 0 & 1 & 4 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nSince any numbers $x$ and $y$ are solutions to the third equation $0x+0y=0$, we can remove this equation from the system. So, the corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-1 \\\\ y &=4.\\end{aligned}\\right.\n$$\n\nFrom the second equation we have $y=4$ and substituting this into the first equation yields $x=-9.$ So,  we conclude that the system is consistent independent. \n\nAs a result, only statement “The system is consistent independent” is true."} {:db/id #edb/ref 17592186400646 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b14622e0-0a8b-52f6-8bf8-44a04ea90e2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437896} {:answer/id #uuid "422e0298-fb2d-5c6d-a4af-8cba072754ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437897}] :answer-field/correct {:answer/id #uuid "b14622e0-0a8b-52f6-8bf8-44a04ea90e2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437896} :answer-field/id #uuid "2ddef766-7f45-5b44-b48d-737353d4be25" :answer-field/key "The system is consistent dependent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438977} {:answer-field/choices [{:answer/id #uuid "522be474-9268-5719-9b67-fa3c52635318" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437898} {:answer/id #uuid "37b81bb5-685b-583b-8db4-0245d173fc7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437899}] :answer-field/correct {:answer/id #uuid "37b81bb5-685b-583b-8db4-0245d173fc7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437899} :answer-field/id #uuid "a0b79b55-bd9c-5274-8736-1fa18bb4e7d7" :answer-field/key "The system is consistent independent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438978} {:answer-field/choices [{:answer/id #uuid "63da7652-c50c-579a-9313-44ed8eac188b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437900} {:answer/id #uuid "715c6b27-3b25-5248-a7ad-aceb0fe78ca6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437901}] :answer-field/correct {:answer/id #uuid "63da7652-c50c-579a-9313-44ed8eac188b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437900} :answer-field/id #uuid "a893b756-f994-5e2f-ab56-a98d5a543109" :answer-field/key "The system has no solution" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438979}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4890e1ff-ed9a-5558-acd1-bcef01439e04" :question/math-academy-id "q-131722" :question/problem "Consider the following system of equations\n\n$$\n\\left\\{\\begin{aligned}3x-3y &=6 \\\\ -2x+y &=-3 \\\\ 4x-4y &=8.\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}3 & -3 & 6 \\\\ -2 & 1 & -3 \\\\ 4 & -4 & 8\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}3 & -3 & 6 \\\\ -2 & 1 & -3 \\\\ 4 & -4 & 8\\end{bmatrix} & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 \\\\ -2 & 1 & -3 \\\\ 4 & -4 & 8\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 \\\\ 0 & -1 & 1 \\\\ 4 & -4 & 8\\end{bmatrix} & {R}_{3} & :={R}_{3}-4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 \\\\ 0 & -1 & 1 \\\\ 0 & 0 & 0\\end{bmatrix} & {R}_{2} & :=-{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nSince any numbers $x$ and $y$ are solutions to the third equation $0x+0y=0$, we can remove this equation from the system. So, the corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-y &=2 \\\\ y &=-1.\\end{aligned}\\right.\n$$\n\nFrom the second equation we have $y=-1$ and substituting this into the first equation yields $x=1.$ So,  we conclude that the system is consistent independent. \n\nAs a result, only statement “The system is consistent independent” is true."} {:db/id #edb/ref 17592186402516 :knowledge-point/_questions [{:db/id #edb/ref 17592186124472 :knowledge-point/id #uuid "3bd13aa5-83a8-5b23-96cb-ea665039ea30" :knowledge-point/title "Identifying an Invertible Function From Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ee908e5-b0e1-5821-9642-419d9c1cdefe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438234} {:answer/id #uuid "f1b60777-4ac5-5644-a3f4-ed9efade6cee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 175921864