b/ref 17592186152066 :knowledge-point/id #uuid "b70dd396-b01a-51e6-a52c-8ff729f48c45" :knowledge-point/title "Determining Whether a Standard Relation Is an Equivalence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a9c693d2-46aa-5f80-92e0-a0d25e335e28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474650} {:answer/id #uuid "9eb32df2-8320-5fa4-96f0-b0f567cf3c41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474651}] :answer-field/correct {:answer/id #uuid "a9c693d2-46aa-5f80-92e0-a0d25e335e28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474650} :answer-field/id #uuid "34b06428-f421-54c5-a47d-9e8885796d5c" :answer-field/key "$R$ is reflexive" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475251} {:answer-field/choices [{:answer/id #uuid "3c857482-138f-5ec5-be1a-956fd271c304" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474652} {:answer/id #uuid "58491a53-f092-55cf-b93f-4cbc0d9a6a53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474653}] :answer-field/correct {:answer/id #uuid "3c857482-138f-5ec5-be1a-956fd271c304" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474652} :answer-field/id #uuid "28b32231-9944-5338-912f-d35d97a13b73" :answer-field/key "$R$ is symmetric" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475252} {:answer-field/choices [{:answer/id #uuid "28c4c488-52bb-5d20-b522-5c95270424db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answ