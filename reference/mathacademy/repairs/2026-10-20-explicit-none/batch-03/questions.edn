438238} :answer-field/id #uuid "584d185a-d45a-520e-a0b6-8fc65652f07f" :answer-field/key "![Graph III](images/20/2055a8f48c8a2041acee5eaf689934154c7f175fca45450f454eb0a6acd3f97d.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439148} {:answer-field/choices [{:answer/id #uuid "39fc4056-d5da-5499-b5fd-b75ffd9ed30a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438240} {:answer/id #uuid "8fb2127f-29d5-5a65-a21d-85c6217c1573" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438241}] :answer-field/correct {:answer/id #uuid "39fc4056-d5da-5499-b5fd-b75ffd9ed30a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438240} :answer-field/id #uuid "1edeb7e6-131b-572b-8dad-1add5e256e4a" :answer-field/key "![Graph IV](images/98/987e680d9de377a3d564647f5dbb71be69079b97358c72730cdd7a00b0a6b78f.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439149}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8cbc83e7-bc89-5609-b94a-0fe1dfb1bde0" :question/math-academy-id "q-36905" :question/problem "Which of the graphs below correspond to an invertible function?\n\nSelect all that apply." :question/worked-solution "A function is invertible if and only if it's a one-to-one function. To determine which of the functions are one-to-one, we use the horizontal line test.\n\nFrom the above, we see that in each of the four given graphs, some horizontal lines intersect the curve more than once. Therefore, these are not one-to-one functions. As a result, none of them correspond to an invertible function."} {:db/id #edb/ref 17592186402695 :knowledge-point/_questions [{:db/id #edb/ref 175921860