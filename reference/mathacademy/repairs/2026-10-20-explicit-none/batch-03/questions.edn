99 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471704}] :answer-field/correct {:answer/id #uuid "71d86641-644a-5180-9944-4e13cd8b3d8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471704} :answer-field/id #uuid "6b8f3aee-1841-55a9-8103-1de08193e82c" :answer-field/key "**If** $1+5<4,$ **then** $2+3<8.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472357}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6e834c31-c35d-57df-a0ce-02370148728a" :question/math-academy-id "q-82089" :question/problem "Which of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "An implication $A⇒B$ is true *unless* $A$ is true and $B$ is false. In other words, the implication is true unless the \"promise\" is broken.\n\n- Statement “**If** $2+3<4,$ **then** $1+5<8.$” is true. The antecedent $2+3<4$ is false, so the promise does not apply. Regardless of the consequent, the promise is *not* broken, and the statement is true.\n\n- Statement “**If** $1+5<8,$ **then** $2+3<4.$” is false. The antecedent $1+5<8$ is true, and the consequent $2+3<4$ is false. So the promise is broken, and the statement is false.\n\n- Statement “**If** $1+5<4,$ **then** $2+3<8.$” is true. Again, the antecedent $1+5<4$ is false, so the promise does not apply. Regardless of the consequent, the promise is *not* broken, and the statement is true.\n\nTherefore, the correct answer is “**If** $2+3<4,$ **then** $1+5<8.$”; “**If** $1+5<4,$ **then** $2+3<8.$” only."} {:db/id #edb/ref 17592186377969 :knowledge-point/_questions [{:db/id #edb/ref 17592186157231 :knowledge-point/id #uuid "bc5b8688-3838-5e9e-9304-9a4c787034ee" :knowledge-point/title "Identifying Logically Equivalent Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c290820-a094-51ac-84b5-47702a109966" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471771} {:answer/id #uuid "5e9124fe-1470-5337-aa89-5154e8ad7638" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471772}] :answer-field/correct {:answer/id #uuid "1c290820-a094-51ac-84b5-47702a109966" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471771} :answer-field/id #uuid "cb804d1c-5844-5bb6-9474-5a626bd3017a" :answer-field/key "$¬(¬X∧¬Y)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472391} {:answer-field/choices [{:answer/id #uuid "4ae3d2de-d895-5503-8bf5-477e4cd8f480" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471773} {:answer/id #uuid "5a33ccc0-89e2-571b-8c14-1c066339a00e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471774}] :answer-field/correct {:answer/id #uuid "5a33ccc0-89e2-571b-8c14-1c066339a00e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471774} :answer-field/id #uuid "c1f21ad2-346a-5efd-9af6-80034699cb49" :answer-field/key "$¬X∨¬Y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472392} {:answer-field/choices [{:answer/id #uuid "468d83f5-0c5a-509d-883e-66c99ea663ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471775} {:answer/id #uuid "0222d302-0120-53ed-b7e8-a1a6af1d2b8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471776}] :answer-field/correct {:answer/id #uuid "0222d302-0120-53ed-b7e8-a1a6af1d2b8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471776} :answer-field/id #uuid "20444d96-a20e-51cc-9ba0-b0767933578a" :answer-field/key "$¬(X∧Y)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472393}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c4951a3e-3ef9-5319-bbf9-d2c571b3026e" :question/math-academy-id "q-86684" :question/problem "Which of the following statements are logically equivalent?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Two statements are logically equivalent if they have the same truth table. So, we construct a truth table for the three given statements:\n\n| $\\,X\\,$ | $\\,Y\\,$ | $\\,¬(¬X∧¬Y)\\,$ | $\\,¬X∨¬Y\\,$ | $\\,¬(X∧Y)\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ | $\\text{T}$ |\n\nWe see that only the statements $¬X∨¬Y$ and $¬(X∧Y)$ have the same truth table, so they are logically equivalent.\n\nTherefore, the correct answer is $¬X∨¬Y$; $¬(X∧Y)$ only."} {:db/id #edb/ref 17592186377976 :knowledge-point/_questions [{:db/id #edb/ref 17592186157231 :knowledge-point/id #uuid "bc5b8688-3838-5e9e-9304-9a4c787034ee" :knowledge-point/title "Identifying Logically Equivalent Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cadf2b3a-2887-51a1-ac9a-6a100a720148" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471777} {:answer/id