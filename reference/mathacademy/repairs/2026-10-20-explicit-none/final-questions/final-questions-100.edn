wer/value "true" :db/id #edb/ref 17592186461334}] :answer-field/correct {:answer/id #uuid "53a05979-2f73-5e03-befa-a95239097935" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461334} :answer-field/id #uuid "ec2d0512-ad08-574d-8040-c9e512a431e4" :answer-field/key "$Z$ (integers)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462420} {:answer-field/choices [{:answer/id #uuid "472d4d65-ddeb-52d9-8391-df6881e7d8d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667800} {:answer/id #uuid "23a4374e-fdfc-5599-bc9c-d4e2a7020c4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667801}] :answer-field/correct {:answer/id #uuid "472d4d65-ddeb-52d9-8391-df6881e7d8d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667800} :answer-field/id #uuid "c4dcc492-4499-5e62-9f00-ffdae6bb6593" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668177}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1da25f7d-182b-5d2d-b5c8-9d3f66bb445c" :question/math-academy-id "q-104703" :question/problem "To which of the following sets does the number $\\sqrt{121}$ belong?\n\nSelect all that apply." :question/worked-solution "First, we note that $\\sqrt{121}=11$ is a natural number, so it belongs to $N.$\n\nSince every natural number is also an integer number, $\\sqrt{121}$ also belongs to $Z.$ \n\nOn the other hand, the sets ${Z}^{-}$ and ${Q}^{-}$ only contain negative numbers. Therefore, $\\sqrt{121}$ does not belong to either of these sets. \n\nTherefore, the correct answer is “$N$ (natural numbers)”; “$Z$ (integers)” only."} {:db/id #edb/ref 17592186240922 :knowledge-point/_questions [{:db/id #edb/ref 17592186133870 :knowledge-point/id #uuid "c2bcfcb6-8f8b-5aa9-8346-05db880fa5bb" :knowledge-point/title "Determining Whether a Set of Polynomials is Orthogonal With Respect to a Given Inner Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1ab2831-9a65-5a58-9e8a-cb5dbbe7e1a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461335} {:answer/id #uuid "0ddb2640-9d14-5cc8-8e8d-4e974dd74693" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461336}] :answer-field/correct {:answer/id #uuid "0ddb2640-9d14-5cc8-8e8d-4e974dd74693" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461336} :answer-field/id #uuid "9cb8992c-bc36-52ec-a230-f17c730b784a" :answer-field/key "${p}_{1}(t)⊥{p}_{2}(t)$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462421} {:answer-field/choices [{:answer/id #uuid "5c38c193-c193-5906-bff7-21c4434a17d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461337} {:answer/id #uuid "f7b751a5-d9a2-52fd-83eb-a65b524c7c34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461338}] :answer-field/correct {:answer/id #uuid "f7b751a5-d9a2-52fd-83eb-a65b524c7c34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461338} :answer-field/id #uuid "9da2ecac-8cc7-5c9c-ad53-6433a655dfdb" :answer-field/key "${p}_{1}(t)⊥{p}_{3}(t)$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462422} {:answer-field/choices [{:answer/id #uuid "10524738-640c-51dc-a18a-a31d95b37711" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461339} {:answer/id #uuid "1885443b-c221-5703-9e91-8edc29b40e94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461340}] :answer-field/correct {:answer/id #uuid "1885443b-c221-5703-9e91-8edc29b40e94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461340} :answer-field/id #uuid "6bbd1dcf-5a8c-5d7c-aec6-1f3c9e1d54eb" :answer-field/key "$S={{p}_{1}(t),{p}_{2}(t),{p}_{3}(t)}$ is an orthogonal set with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462423} {:answer-field/choices [{:answer/id #uuid "00bea7e3-c672-5996-95c4-b149a938be1f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667802} {:answer/id #uuid "ae1ca401-7f8f-511e-8ca0-2cc91fc15601" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667803}] :answer-field/correct {:answer/id #uuid "00bea7e3-c672-5996-95c4-b149a938be1f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667802} :answer-field/id #uuid "a4c689aa-6976-5836-a6b6-e7a794a3444a" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668178}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "95a9cd65-803f-5d19-875e-716631b2f8a2" :question/math-academy-id "q-104734" :question/problem "Consider the following set of polynomials:\n\n$$\n{p}_{1}(t)={t}^{2}+t,\\,{p}_{2}(t)={t}^{2}-t,\\,{p}_{3}(t)={t}^{2}-1.\n$$\n\nGiven that the inner product in the vector space ${R}_{2}[t]$ of polynomials of degree at most $2$ in the variable $t$ is defined as \n\n$$\n⟨p(t),q(t)⟩=p(-1)q(-1)+p(0)q(0)+p(1)q(1),\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that a set of vectors in an inner product space is orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement “${p}_{1}(t)⊥{p}_{2}(t)$ with respect to the given inner product” is true. Indeed, we have\n\n$$\n\\begin{aligned}⟨{p}_{1}(t),{p}_{2}(t)⟩ & =⟨{t}^{2}+t,{t}^{2}-t⟩ \\\\  & =({t}^{2}\\,+\\,t){|}_{-1}\\,\\cdot \\,({t}^{2}\\,-\\,t){|}_{-1}+({t}^{2}\\,+\\,t){|}_{0}\\,\\cdot \\,({t}^{2}\\,-\\,t){|}_{0}+({t}^{2}\\,+\\,t){|}_{1}\\,\\cdot \\,({t}^{2}\\,-\\,t){|}_{1} \\\\  & =((-1)^{2}\\,+\\,(-1))\\,\\cdot \\,((-1)^{2}\\,-\\,(-1))\\,+\\,({0}^{2}\\,+\\,0)\\,\\cdot \\,({0}^{2}\\,-\\,0)\\,+\\,({1}^{2}\\,+\\,1)\\,\\cdot \\,({1}^{2}\\,-\\,1) \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${p}_{1}(t)⊥{p}_{2}(t)$ with respect to the given inner product.\n\n- Statement “${p}_{1}(t)⊥{p}_{3}(t)$ with respect to the given inner product” is true. Indeed, we have\n\n$$\n\\begin{aligned}⟨{p}_{1}(t),{p}_{3}(t)⟩ & =⟨{t}^{2}+t,{t}^{2}-1⟩ \\\\  & =({t}^{2}\\,+\\,t){|}_{-1}\\,\\cdot \\,({t}^{2}\\,-\\,1){|}_{-1}\\,+\\,({t}^{2}\\,+\\,t){|}_{0}\\,\\cdot \\,({t}^{2}\\,-\\,1){|}_{0}+({t}^{2}\\,+\\,t){|}_{1}\\,\\cdot \\,({t}^{2}\\,-\\,t){|}_{1} \\\\  & =((-1)^{2}\\,+\\,(-1))\\,\\cdot \\,((-1)^{2}\\,-\\,1)\\,+\\,({0}^{2}\\,+\\,0)\\,\\cdot \\,({0}^{2}\\,-\\,1)\\,+\\,({1}^{2}\\,+\\,1)\\,\\cdot \\,({1}^{2}\\,-\\,1) \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${p}_{1}(t)⊥{p}_{3}(t)$ with respect to the given inner product.\n\n- Statement “$S={{p}_{1}(t),{p}_{2}(t),{p}_{3}(t)}$ is an orthogonal set with respect to the given inner product” is true. Let's check if ${p}_{2}(t)⊥{p}_{3}(t).$ Computing the inner product, we have\n\n$$\n\\begin{aligned}⟨{p}_{2}(t),{p}_{3}(t)⟩ & =⟨{t}^{2}-t,{t}^{2}-1⟩ \\\\  & =({t}^{2}\\,-\\,t){|}_{-1}\\,\\cdot \\,({t}^{2}\\,-\\,1){|}_{-1}+({t}^{2}\\,-\\,t){|}_{0}\\,\\cdot \\,({t}^{2}\\,-\\,1){|}_{0}+({t}^{2}\\,-\\,t){|}_{1}\\,\\cdot \\,({t}^{2}\\,-\\,1){|}_{1} \\\\  & =((-1)^{2}\\,-\\,(-1))\\,\\cdot \\,((-1)^{2}\\,-\\,1)\\,+\\,({0}^{2}\\,-\\,0)\\,\\cdot \\,({0}^{2}\\,-\\,1)\\,+\\,({1}^{2}\\,-\\,1)\\,\\cdot \\,({1}^{2}\\,-\\,1) \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${p}_{2}(t)⊥{p}_{3}(t)$ with respect to the given inner product. So, $S$ is an orthogonal set.\n\nTherefore, the correct answer is “${p}_{1}(t)⊥{p}_{2}(t)$ with respect to the given inner product”; “${p}_{1}(t)⊥{p}_{3}(t)$ with respect to the given inner product”; “$S={{p}_{1}(t),{p}_{2}(t),{p}_{3}(t)}$ is an orthogonal set with respect to the given inner product”."} {:db/id #edb/ref 17592186240923 :knowledge-point/_questions [{:db/id #edb/ref 17592186133870 :knowledge-point/id #uuid "c2bcfcb6-8f8b-5aa9-8346-05db880fa5bb" :knowledge-point/title "Determining Whether a Set of Polynomials is Orthogonal With Respect to a Given Inner Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41074944-190b-5200-8ca5-70749fdf342e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461341} {:answer/id #uuid "c22ad1f9-915d-5c7b-a895-be73f39a5ab4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461342}] :answer-field/correct {:answer/id #uuid "c22ad1f9-915d-5c7b-a895-be73f39a5ab4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461342} :answer-field/id #uuid "6e0c8223-726b-5e18-814f-2ce6bb661414" :answer-field/key "${p}_{1}(t)⊥{p}_{2}(t)$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462424} {:answer-field/choices [{:answer/id #uuid "8308e810-9158-545a-bda0-776e2aee683b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461343} {:answer/id #uuid "83b9fc92-e7ac-5745-a0e4-64d5dea39c60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461344}] :answer-field/correct {:answer/id #uuid "83b9fc92-e7ac-5745-a0e4-64d5dea39c60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461344} :answer-field/id #uuid "06a0f42f-f241-5187-8256-6b0cadab396d" :answer-field/key "${p}_{2}(t)⊥{p}_{3}(t)$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462425} {:answer-field/choices [{:answer/id #uuid "fafe3ff7-e1fb-5eb9-b544-a83e81be0784" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461345} {:answer/id #uuid "6c0dc6d8-7ec7-53ad-9eb2-5fdd1f6ccd7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461346}] :answer-field/correct {:answer/id #uuid "fafe3ff7-e1fb-5eb9-b544-a83e81be0784" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461345} :answer-field/id #uuid "49440439-3ff0-5069-8892-56fdd4d6fa07" :answer-field/key "$S={{p}_{1}(t),{p}_{2}(t),{p}_{3}(t)}$ is an orthogonal set with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462426} {:answer-field/choices [{:answer/id #uuid "d94a531c-c7f1-5eab-8d7d-5f57e0d712d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667804} {:answer/id #uuid "a2bf2d34-ca83-5c3a-8b14-d24b408bcd7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667805}] :answer-field/correct {:answer/id #uuid "d94a531c-c7f1-5eab-8d7d-5f57e0d712d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667804} :answer-field/id #uuid "bfd2c904-3050-5900-9be8-7985969ad364" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668179}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5d2cd958-2383-51a8-8ef7-f3c1ff9a5b43" :question/math-academy-id "q-104736" :question/problem "Consider the following set of polynomials:\n\n$$\n{p}_{1}(t)={t}^{2}-4,\\,{p}_{2}(t)={t}^{2}-t,\\,{p}_{3}(t)={t}^{2}-2t.\n$$\n\nGiven that the inner product in the vector space ${R}_{2}[t]$ of polynomials of degree at most $2$ in the variable $t$ is defined as \n\n$$\n⟨p(t),q(t)⟩=p(0)q(0)+p(1)q(1)+p(2)q(2),\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that a set of vectors in an inner product space is orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement “${p}_{1}(t)⊥{p}_{2}(t)$ with respect to the given inner product” is true. Indeed, we have\n\n$$\n\\begin{aligned}⟨{p}_{1}(t),{p}_{2}(t)⟩ & =⟨{t}^{2}-4,{t}^{2}-t⟩ \\\\  & =({t}^{2}\\,-\\,4){|}_{0}\\,\\cdot \\,({t}^{2}\\,-\\,t){|}_{0}+({t}^{2}\\,-\\,4){|}_{1}\\,\\cdot \\,({t}^{2}\\,-\\,t){|}_{1}+({t}^{2}\\,-\\,4){|}_{2}\\,\\cdot \\,({t}^{2}\\,-\\,2t){|}_{2} \\\\  & =({0}^{2}\\,-\\,4)\\,\\cdot \\,({0}^{2}\\,-\\,0)\\,+\\,({1}^{2}\\,-\\,4)\\,\\cdot \\,({1}^{2}\\,-\\,1)\\,+\\,({2}^{2}\\,-\\,4)\\,\\cdot \\,({2}^{2}\\,-\\,2(2)) \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${p}_{1}(t)⊥{p}_{2}(t)$ with respect to the given inner product.\n\n- Statement “${p}_{2}(t)⊥{p}_{3}(t)$ with respect to the given inner product” is true. Indeed, we have\n\n$$\n\\begin{aligned}⟨{p}_{2}(t),{p}_{3}(t)⟩ & =⟨{t}^{2}-t,{t}^{2}-2t⟩ \\\\  & =({t}^{2}\\,-\\,t){|}_{0}\\,\\cdot \\,({t}^{2}\\,-\\,2t){|}_{0}+({t}^{2}\\,-\\,t){|}_{1}\\,\\cdot \\,({t}^{2}\\,-\\,2t){|}_{1}+({t}^{2}\\,-\\,t){|}_{2}\\,\\cdot \\,({t}^{2}\\,-\\,2t){|}_{2} \\\\  & =({0}^{2}\\,-\\,0)\\,\\cdot \\,({0}^{2}\\,-\\,2(0))\\,+\\,({1}^{2}\\,-\\,1)\\,\\cdot \\,({1}^{2}\\,-\\,2(1))\\,+\\,({2}^{2}\\,-\\,2)\\,\\cdot \\,({2}^{2}-2(2)) \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${p}_{2}(t)⊥{p}_{3}(t)$ with respect to the given inner product.\n\n- Statement “$S={{p}_{1}(t),{p}_{2}(t),{p}_{3}(t)}$ is an orthogonal set with respect to the given inner product” is false. Let's check if ${p}_{1}(t)⊥{p}_{3}(t).$ Computing the inner product, we have\n\n$$\n\\begin{aligned}⟨{p}_{1}(t),{p}_{3}(t)⟩ & =⟨{t}^{2}-4,{t}^{2}-2t⟩ \\\\  & =({t}^{2}\\,-\\,4){|}_{0}\\,\\cdot \\,({t}^{2}\\,-\\,2t){|}_{0}+({t}^{2}\\,-\\,4){|}_{1}\\,\\cdot \\,({t}^{2}\\,-\\,2t){|}_{1}+({t}^{2}\\,-\\,4){|}_{2}\\,\\cdot \\,({t}^{2}\\,-\\,2t){|}_{2} \\\\  & =({0}^{2}\\,-\\,4)\\,\\cdot \\,({0}^{2}\\,-\\,2(0))\\,+\\,({1}^{2}\\,-\\,4)\\,\\cdot \\,({1}^{2}\\,-\\,2(1))\\,+\\,({2}^{2}\\,-\\,4)\\,\\cdot \\,({2}^{2}\\,-\\,2(2)) \\\\  & =3\\ne 0,\\end{aligned}\n$$\n\nwhich means that ${p}_{2}(t)⊥̸{p}_{3}(t)$ with respect to the given inner product. So, the set $S$ is *not* an orthogonal set.\n\nTherefore, the correct answer is “${p}_{1}(t)⊥{p}_{2}(t)$ with respect to the given inner product”; “${p}_{2}(t)⊥{p}_{3}(t)$ with respect to the given inner product” only."} {:db/id #edb/ref 17592186240972 :knowledge-point/_questions [{:db/id #edb/ref 17592186054631 :knowledge-point/id #uuid "9b7f1d12-3335-5dd7-bf36-e07077d0c45d" :knowledge-point/title "Identifying Subsets of Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e4e84a9-12cc-507d-82ec-e96b850a63c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461389} {:answer/id #uuid "03b2523b-6d7f-5343-be22-5d73eb55caa0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461390}] :answer-field/correct {:answer/id #uuid "0e4e84a9-12cc-507d-82ec-e96b850a63c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461389} :answer-field/id #uuid "21f585b3-4b7e-5b0c-950d-f170a9684585" :answer-field/key "$Z$ (integers)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462448} {:answer-field/choices [{:answer/id #uuid "e048d875-c5f8-5b05-91e6-d6e57d979a7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461391} {:answer/id #uuid "e7952205-57c2-5868-83de-4486f3e4ba9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461392}] :answer-field/correct {:answer/id #uuid "e7952205-57c2-5868-83de-4486f3e4ba9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461392} :answer-field/id #uuid "d5aee732-4e04-5c86-8c88-17358cec8f30" :answer-field/key "${Z}^{-}$ (the set of negative integers)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462449} {:answer-field/choices [{:answer/id #uuid "af0128c2-64d9-5023-a136-740b0739ee93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461393} {:answer/id #uuid "429ab79c-33d5-501e-9804-0a53e669ec6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461394}] :answer-field/correct {:answer/id #uuid "af0128c2-64d9-5023-a136-740b0739ee93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461393} :answer-field/id #uuid "c6abdd44-ff6b-5977-869d-6f5e6c1b1f43" :answer-field/key "$N$ (natural numbers)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462450} {:answer-field/choices [{:answer/id #uuid "ef9b335a-57be-5169-b224-8a02f7b49aeb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667806} {:answer/id #uuid "cb5b2419-6336-5097-9164-a8f20ad4fe23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667807}] :answer-field/correct {:answer/id #uuid "ef9b335a-57be-5169-b224-8a02f7b49aeb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667806} :answer-field/id #uuid "e14d90db-5f56-5ab8-bdd7-aae3879e352b" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668180}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "63db395b-88f4-58c0-8886-5830de0a85c3" :question/math-academy-id "q-105033" :question/problem "Which of the following are subsets of ${Q}_{0}^{-}$ (the set of non-positive rational numbers)?\n\nSelect all that apply." :question/worked-solution "$A$ is a subset of $B$ if every element of $A$ is an element of $B.$\n\nWith that in mind, let's inspect the given choices.\n\n- $Z$ is *not* a subset of ${Q}_{0}^{-}.$ For example, $1\\in Z$ but $1\\notin {Q}_{0}^{-}.$\n\n- ${Z}^{-}$ is  a subset of ${Q}_{0}^{-}.$ Every negative integer is a non-positive rational number.\n\n- $N$ is *not* a subset of ${Q}_{0}^{-}.$ For example, $1\\in N$ but $1\\notin {Q}_{0}^{-}.$\n\nTherefore, the correct answer is “${Z}^{-}$ (the set of negative integers)” only."} {:db/id #edb/ref 17592186241033 :knowledge-point/_questions [{:db/id #edb/ref 17592186119925 :knowledge-point/id #uuid "52a45814-d1e2-5948-b7bd-69dcaf6cd0eb" :knowledge-point/title "Identifying Linearly Independent and Dependent Sets Using Row Reduction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b0bd8cc-6ac8-5e72-b06f-73c1654ffe1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461413} {:answer/id #uuid "e80cc002-b38f-5d3e-892e-0841eebc40e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461414}] :answer-field/correct {:answer/id #uuid "e80cc002-b38f-5d3e-892e-0841eebc40e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461414} :answer-field/id #uuid "e3f887e6-6723-5611-bf95-bd986f87144d" :answer-field/key "The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$  has an infinite number of nonzero solutions." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462460} {:answer-field/choices [{:answer/id #uuid "a81cd52a-c09b-55c3-9802-d94055e5c375" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461415} {:answer/id #uuid "4189cfd7-3469-5cbf-a825-c816cd091f10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461416}] :answer-field/correct {:answer/id #uuid "4189cfd7-3469-5cbf-a825-c816cd091f10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461416} :answer-field/id #uuid "aa918275-0dac-5d62-b393-8f3adb29993b" :answer-field/key "The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462461} {:answer-field/choices [{:answer/id #uuid "a390f34d-043c-53c1-9c41-c6abbd279b8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461417} {:answer/id #uuid "34513fe0-1281-5699-84c3-b63f5d892959" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461418}] :answer-field/correct {:answer/id #uuid "a390f34d-043c-53c1-9c41-c6abbd279b8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461417} :answer-field/id #uuid "4f68b655-e005-5eb7-8191-01334bd4f1ec" :answer-field/key "The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462462} {:answer-field/choices [{:answer/id #uuid "732e0602-3cba-547c-8036-108d2abc2a81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667808} {:answer/id #uuid "c08d3ed4-ac72-56ec-b285-734990204a6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667809}] :answer-field/correct {:answer/id #uuid "732e0602-3cba-547c-8036-108d2abc2a81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667808} :answer-field/id #uuid "ba9a1a20-3f2b-5ae1-8ce3-15b1fe9b26ed" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668181}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "af32236d-520e-5b71-b7ec-9663a181498c" :question/math-academy-id "q-105310" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=\\begin{bmatrix}2 \\\\ 4 \\\\ -2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}7 \\\\ 15 \\\\ -7\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}-1 \\\\ -4 \\\\ 1\\end{bmatrix}.\n$$\n\nAssume that ${x}_{1},{x}_{2},$ and ${x}_{3}$ are real numbers. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system \n\n$$\n\\left\\{\\begin{aligned}2{x}_{1}+7{x}_{2}-{x}_{3} &=0 \\\\ 4{x}_{1}+15{x}_{2}-4{x}_{3} &=0 \\\\ -2{x}_{1}-7{x}_{2}+{x}_{3} &=0.\\end{aligned}\\right.\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & 7 & -1 & 0 \\\\ 4 & 15 & -4 & 0 \\\\ -2 & -7 & 1 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 7 & -1 & 0 \\\\ 0 & 1 & -2 & 0 \\\\ -2 & -7 & 1 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 7 & -1 & 0 \\\\ 0 & 1 & -2 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nFrom the matrix above, we conclude that the basic variables are ${x}_{1}$ and ${x}_{2}$, while ${x}_{3}$ is the free variable. \n\nSince there is one free variable, the equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has an infinite number of nonzero solutions, which means that the vectors are linearly dependent. \n\nTherefore, statement “The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent” is false, while statements “The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$  has an infinite number of nonzero solutions” and “The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent” are true."} {:db/id #edb/ref 17592186241050 :knowledge-point/_questions [{:db/id #edb/ref 17592186078487 :knowledge-point/id #uuid "f00fd821-a5d4-5844-9db5-795b9e321b94" :knowledge-point/title "Identifying the Largest Intervals of Continuity of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f5cd349-02df-57a4-87fa-ad7621dc7ca3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461425} {:answer/id #uuid "c80c29ed-ab88-5f84-a4f6-bfcf8509542b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461426}] :answer-field/correct {:answer/id #uuid "7f5cd349-02df-57a4-87fa-ad7621dc7ca3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461425} :answer-field/id #uuid "e49eba10-fb5d-5f25-ab9c-eda966fc66dc" :answer-field/key "$x\\in (-\\infty ,-2]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462466} {:answer-field/choices [{:answer/id #uuid "80c7e232-9bb0-5a13-b9a9-61d5156eef57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461427} {:answer/id #uuid "e7032692-1def-5667-b369-e6201ffbd33f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461428}] :answer-field/correct {:answer/id #uuid "e7032692-1def-5667-b369-e6201f