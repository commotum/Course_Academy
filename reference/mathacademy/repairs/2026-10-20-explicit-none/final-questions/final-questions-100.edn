type/text} :answer/value "true" :db/id #edb/ref 17592186667909}] :answer-field/correct {:answer/id #uuid "eac10547-b750-5c19-8f42-e58ef2288a41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667908} :answer-field/id #uuid "7ab1618b-d679-5713-993b-ef4d9392cbd2" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668231}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d890a9be-d244-5a2b-a434-390b31123a28" :question/math-academy-id "q-123245" :question/problem "![](images/b3/b315be9ba524ab538388fdaad31161c280d7d6e5ab71261345063ac6ffe819d5.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\nSelect all that apply." :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $F$ acts like a source at $P,$ then $∇\\cdot F>0$ at $P.$\n\n- If $F$ acts like a sink at $P,$ then $∇\\cdot F<0$ at $P.$\n\n- If $F$ acts like neither a source nor a sink at $P,$ then $∇\\cdot F=0$ at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement $∇\\cdot F>0$ is true, whereas statements $∇\\cdot F=0$ and $∇\\cdot F<0$ are false. Notice that the lengths of the vectors increase as we move vertically and horizontally away from the origin. Therefore, the vector field $F$ acts like a source at every point.\n\n- Statement “$F$ is solenoidal” is false. Since $∇\\cdot F\\ne 0,$ the vector field $F$ is not solenoidal.\n\nTherefore, the correct answer is $∇\\cdot F>0$ only."} {:db/id #edb/ref 17592186259579 :knowledge-point/_questions [{:db/id #edb/ref 17592186172091 :knowledge-point/id #uuid "280e7ba4-7617-546b-9e0d-a5bdc33dad8d" :knowledge-point/title "Identifying Simply-Connected Regions in Euclidian Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35574a80-0287-507b-88de-4c81ae7d6d13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462133} {:answer/id #uuid "c60a5879-3096-5a0a-919f-13e24b8584ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462134}] :answer-field/correct {:answer/id #uuid "35574a80-0287-507b-88de-4c81ae7d6d13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462133} :answer-field/id #uuid "24b3664c-da91-5036-9b62-f16a49bd6604" :answer-field/key "${(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}\\ne 1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462820} {:answer-field/choices [{:answer/id #uuid "d36e33c9-d5fe-5406-bc31-4bd39f4e0587" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462135} {:answer/id #uuid "afabceb2-3e43-58e3-a309-981fc0910b96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462136}] :answer-field/correct {:answer/id #uuid "d36e33c9-d5fe-5406-bc31-4bd39f4e0587" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462135} :answer-field/id #uuid "3e7c6623-9f65-56c6-8e08-bf71a010850f" :answer-field/key "${(x,y)\\in {R}^{2}\\,|\\,(x,y)\\ne (0,0)}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462821} {:answer-field/choices [{:answer/id #uuid "d193f0e7-ab4d-5e93-ba8e-b2623717b696" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462137} {:answer/id #uuid "6ee03dde-34a7-588a-a871-826d7b944ffb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462138}] :answer-field/correct {:answer/id #uuid "6ee03dde-34a7-588a-a871-826d7b944ffb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462138} :answer-field/id #uuid "182ce5ea-8de5-5895-8540-00589a1f0f62" :answer-field/key "${(x,y)\\in {R}^{2}\\,|\\,x\\ge 0}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462822} {:answer-field/choices [{:answer/id #uuid "5b35bdd8-2917-505e-a829-1661198c4e71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667910} {:answer/id #uuid "7e9de4db-21f4-5c66-a66a-eebc595afe00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667911}] :answer-field/correct {:answer/id #uuid "5b35bdd8-2917-505e-a829-1661198c4e71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667910} :answer-field/id #uuid "6ee25fb5-de76-5a04-82e8-add7eff77e0e" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668232}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cd4cc5a1-c047-51e7-8736-2282f38e56c0" :question/math-academy-id "q-123923" :question/problem "Which of the following regions are simply connected?\n\nSelect all that apply." :question/worked-solution "A connected region $D$ is simply connected if every simple closed curve in $D$ can be contracted to a point.\n\n![](images/7d/7d6aea1a62fb290702630ef95ec86f4119e7c8fdd74b8148b62b66e5ac871b58.png)\n\nA connected *plane* region $D$ is simply connected if every simple closed curve in $D$ encloses only points in $D.$ In other words, the region does not contain any holes. Plane regions containing holes are not simply connected, since some simple closed curves cannot be contracted to a point:\n\n![](images/c3/c3c3e7a60ff0dd917cf6c0b293dae7510e457a0455629add1c54cadac65248b7.png)\n\nLet's now examine our regions in turn.\n\n- Region ${(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}\\ne 1}$ is *not* simply connected. The region contains all the points of ${R}^{2}$ except those on the circle ${x}^{2}+{y}^{2}=1.$ Thus, the region is formed by two disjoint pieces and, therefore, is not even a connected region.\n\n- Region ${(x,y)\\in {R}^{2}\\,|\\,(x,y)\\ne (0,0)}$ is *not* simply connected since it's a plane region with a hole at $(0,0).$\n\n- Region ${(x,y)\\in {R}^{2}\\,|\\,x\\ge 0}$ is simply connected. It's a plane region without holes.\n\nTherefore, the correct answer is ${(x,y)\\in {R}^{2}\\,|\\,x\\ge 0}$ only."} {:db/id #edb/ref 17592186259752 :knowledge-point/_questions [{:db/id #edb/ref 17592186078493 :knowledge-point/id #uuid "62736299-f6d6-503f-a5d1-e1091e8b0429" :knowledge-point/title "Identifying Convergent Geometric Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2b34516-3ea8-584f-906e-e8611ac12828" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462151} {:answer/id #uuid "291a43ca-613d-5a0d-9ab8-0303748e2957" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462152}] :answer-field/correct {:answer/id #uuid "c2b34516-3ea8-584f-906e-e8611ac12828" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462151} :answer-field/id #uuid "c25edcf3-d687-539e-bcd5-23dfed8b3afb" :answer-field/key "${\\sum }_{n=0}^{\\infty }0.25{(1.1)}^{n}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462829} {:answer-field/choices [{:answer/id #uuid "f07d465a-cb07-59a2-ba0c-6485c2e2203c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462153} {:answer/id #uuid "ebb4f3ab-0ab6-5c87-9b0a-255c44be23cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462154}] :answer-field/correct {:answer/id #uuid "f07d465a-cb07-59a2-ba0c-6485c2e2203c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462153} :answer-field/id #uuid "90d4580d-2f8a-562a-9bab-ac4b9c80c2c2" :answer-field/key "${\\sum }_{n=1}^{\\infty }\\frac{1}{4}{(-\\frac{5}{2})}^{n}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462830} {:answer-field/choices [{:answer/id #uuid "07ee1f91-30b1-5897-9518-97a3b6a06b2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462155} {:answer/id #uuid "9f36d431-b912-544f-a3f7-12ba6a12bb2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462156}] :answer-field/correct {:answer/id #uuid "07ee1f91-30b1-5897-9518-97a3b6a06b2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462155} :answer-field/id #uuid "6645ce3c-ff42-5463-89e7-d2920082b362" :answer-field/key "${\\sum }_{n=2}^{\\infty }\\frac{{3}^{n-1}}{{2}^{n}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462831} {:answer-field/choices [{:answer/id #uuid "510c0f2e-aee7-59c9-94e2-709530a5abf5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667912} {:answer/id #uuid "fef4ff5c-2fd2-5be7-908a-e6026eee8964" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667913}] :answer-field/correct {:answer/id #uuid "fef4ff5c-2fd2-5be7-908a-e6026eee8964" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667913} :answer-field/id #uuid "7f05673e-4e9a-591e-bf75-2486849099b1" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668233}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6ce3cd55-5416-540d-b4b8-b6e9967829be" :question/math-academy-id "q-124906" :question/problem "Which of the following geometric series converge?\n\nSelect all that apply." :question/worked-solution "Let's look at each series in turn.\n\n- The series ${\\sum }_{n=0}^{\\infty }0.25{(1.1)}^{n}$ starts with $n=0.$ So the common ratio is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{1}}{{a}_{0}} & =\\frac{0.25{(1.1)}^{1}}{0.25{(1.1)}^{0}} \\\\  & =1.1\\end{aligned}\n$$\n\nTherefore, the series is divergent because $|r|\\ge 1.$\n\n- The series ${\\sum }_{n=1}^{\\infty }\\frac{1}{4}{\\left(-\\frac{5}{2}\\right)}^{n}$ starts with $n=1.$ So the common ratio is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{2}}{{a}_{1}} & =\\frac{\\frac{1}{4}{\\left(-\\frac{5}{2}\\right)}^{2}}{\\frac{1}{4}{\\left(-\\frac{5}{2}\\right)}^{1}} \\\\  & =-\\frac{5}{2}.\\end{aligned}\n$$\n\nTherefore, the series is divergent because $|r|\\ge 1.$\n\n- The series ${\\sum }_{n=2}^{\\infty }\\frac{{3}^{n-1}}{{2}^{n}}$ starts with $n=2.$ So the common ratio is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{3}}{{a}_{2}} & =\\frac{\\left(\\frac{{3}^{3-1}}{{2}^{3}}\\right)}{\\left(\\frac{{3}^{2-1}}{{2}^{2}}\\right)} \\\\  & =\\frac{\\left(\\frac{{3}^{2}}{{2}^{3}}\\right)}{\\left(\\frac{3}{{2}^{2}}\\right)} \\\\  & =\\left(\\frac{{3}^{2}}{{2}^{3}}\\right)\\left(\\frac{{2}^{2}}{3}\\right) \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$\n\nTherefore, the series is divergent because $|r|\\ge 1.$\n\nIn conclusion, the correct answer is \"None.\""} {:db/id #edb/ref 17592186259838 :knowledge-point/_questions [{:db/id #edb/ref 17592186179743 :knowledge-point/id #uuid "1da220a9-2afc-5b63-a423-a4d2b3de9567" :knowledge-point/title "Circulation in Conservative Vector Fields"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d433da7b-1e1e-535b-9f25-83bdf23e4df0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463500} {:answer/id #uuid "b9260be8-c900-5ecd-a29b-b1b5e76ddea0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463501}] :answer-field/correct {:answer/id #uuid "b9260be8-c900-5ecd-a29b-b1b5e76ddea0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463501} :answer-field/id #uuid "0f88a2a7-6b38-5992-98ee-3c8c44386624" :answer-field/key "$∇f$ is conservative" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464684} {:answer-field/choices [{:answer/id #uuid "dbb4515b-adce-511f-9f3e-7963532589f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463502} {:answer/id #uuid "dd0d50d9-8f3d-5d9f-b4f7-523d73146916" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463503}] :answer-field/correct {:answer/id #uuid "dbb4515b-adce-511f-9f3e-796