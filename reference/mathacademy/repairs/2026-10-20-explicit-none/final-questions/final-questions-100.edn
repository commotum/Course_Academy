 17592186463993}] :answer-field/correct {:answer/id #uuid "9be3fd1e-0669-5f34-b527-da1a9b508b28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463992} :answer-field/id #uuid "9473659a-cb3e-51ed-8227-bcaa2678cdef" :answer-field/key "$C=\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 5 & 0 \\\\ 4 & 5 & 3\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464930} {:answer-field/choices [{:answer/id #uuid "73e1b33f-0d98-571d-8033-6aed79accd61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667958} {:answer/id #uuid "3216c38c-3b52-54b6-825c-12d508e70075" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667959}] :answer-field/correct {:answer/id #uuid "3216c38c-3b52-54b6-825c-12d508e70075" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667959} :answer-field/id #uuid "9e70bc13-74b8-56c7-833c-e4d4c2f201ad" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668256}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "675c49ee-f80c-5132-87b4-3f13525060ae" :question/math-academy-id "q-131460" :question/problem "Which of the following matrices are block diagonal?\n\nSelect all that apply." :question/worked-solution "A block diagonal matrix can be partitioned so that it has only square blocks on the main diagonal, and all the other blocks contain only zeros.\n\nWith that in mind, let's examine our matrices.\n\n- $A$ is *not* a block diagonal matrix since it can't be partitioned in the way described above: \n\n$$\n\\begin{aligned}A=\\begin{bmatrix}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{bmatrix},\\,A=\\begin{bmatrix}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{bmatrix},\\,A=\\begin{bmatrix}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n- $B$ is *not* a block diagonal matrix since it can't be partitioned in the way described above:\n\n$$\nB=\\begin{bmatrix}2 & 0 \\\\ 3 & 0\\end{bmatrix}\n$$\n\n- $C$ is *not* a block diagonal matrix since it can't be partitioned in the way described above: \n\n$$\n\\begin{aligned}C=\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 5 & 0 \\\\ 4 & 5 & 3\\end{bmatrix},\\,C=\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 5 & 0 \\\\ 4 & 5 & 3\\end{bmatrix},\\,C=\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 5 & 0 \\\\ 4 & 5 & 3\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the correct answer is \"None.\""} {:db/id #edb/ref 17592186266113 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b502811a-4c5f-5724-8251-868a9480b1c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437878} {:answer/id #uuid "186cb15a-6c0f-5792-ab70-d713ad9b8faf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437879}] :answer-field/correct {:answer/id #uuid "b502811a-4c5f-5724-8251-868a9480b1c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437878} :answer-field/id #uuid "6923725d-7900-549a-b06a-031593c2ab18" :answer-field/key "The system is inconsistent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438968} {:answer-field/choices [{:answer/id #uuid "c85fcf8a-4336-5666-8410-cf5fbbf94767" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437880} {:answer/id #uuid "df5f6c33-1e84-5f01-826a-31cd583e3cc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437881}] :answer-field/correct {:answer/id #uuid "df5f6c33-1e84-5f01-826a-31cd583e3cc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437881} :answer-field/id #uuid "b513b48d-527b-559e-ab81-1586620cce1c" :answer-field/key "The system is consistent dependent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438969} {:answer-field/choices [{:answer/id #uuid "b5dc7bbd-657b-572d-b363-90d7302303fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437882} {:answer/id #uuid "50ff0389-893c-5201-a509-7c08e6f042f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437883}] :answer-field/correct {:answer/id #uuid "b5dc7bbd-657b-572d-b363-90d7302303fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437882} :answer-field/id #uuid "3cdaf77b-d135-55af-862e-3a96aaf3f51e" :answer-field/key "The system has a unique solution" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438970} {:answer-field/choices [{:answer/id #uuid "ed98a664-01d7-5ae0-b4ed-b816b4fda9f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667960} {:answer/id #uuid "0ff6cbd6-b592-558a-ba00-0409224cb898" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667961}] :answer-field/correct {:answer/id #uuid "ed98a664-01d7-5ae0-b4ed-b816b4fda9f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667960} :answer-field/id #uuid "fe4e1eec-1991-58e6-a18a-c03ea73fec67" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668257}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e7e2bc11-b1bf-5938-9267-7923a80ec463" :question/math-academy-id "q-131719" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+4y &=-1 \\\\ 2x+8y &=-2 \\\\ -3x-12y &=3\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 4 & -1 \\\\ 2 & 8 & -2 \\\\ -3 & -12 & 3\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 4 & -1 \\\\ 2 & 8 & -2 \\\\ -3 & -12 & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 4 & -1 \\\\ 0 & 0 & 0 \\\\ -3 & -12 & 3\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 4 & -1 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x,$ and we have one free variable, $y.$ That means we can find $x$ in terms of $y.$ \n\nTherefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*. \n\nAs a result, only statement “The system is consistent dependent” is true."}]
