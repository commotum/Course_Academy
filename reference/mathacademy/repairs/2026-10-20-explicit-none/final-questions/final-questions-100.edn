/id #uuid "cfd79fbb-6350-5330-9c70-fb8d411a90ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667864} :answer-field/id #uuid "7a7f113a-a5fc-5430-9b79-98819a67fc4f" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668209}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3a2a1a5b-82e0-576b-9a2b-9cca3c9ca19e" :question/math-academy-id "q-114271" :question/problem "Consider the function $f(x)=3{x}^{5}-5{x}^{4}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, we calculate the second derivative of $f(x),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =15{x}^{4}-20{x}^{3} \\\\ {f}^{″}(x) & =60{x}^{3}-60{x}^{2} \\\\  & =60{x}^{2}(x-1)\\end{aligned}\n$$\n\nTo find where the function is concave up, we need to solve ${f}^{″}(x)>0:$\n\n$$\n\\begin{aligned}60{x}^{2}(x-1) & >0 \\\\ x-1 & >0 \\\\ x & >1\\end{aligned}\n$$\n\nSo $f(x)$ is concave up on the interval   $(1,\\infty ).$\n\nThe function $f(x)$ is concave down when ${f}^{″}(x)<0.$ By similar reasoning, this leads to the inequality $x-1<0$ with $x\\ne 0,$ which has the solution $(-\\infty ,0)\\cup (0,1).$\n\nTherefore, the correct answer is “$f(x)$ is concave up on $(1,\\infty )$” only."} {:db/id #edb/ref 17592186250219 :knowledge-point/_questions [{:db/id #edb/ref 17592186184151 :knowledge-point/id #uuid "437c168a-6799-5d13-bd9b-031290a84da6" :knowledge-point/title "Finding the Intervals of Concavity of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7968f616-b6cd-5912-9ebb-c7e943c53ffd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461689} {:answer/id #uuid "315f2abe-9a26-53e9-83fa-b2133c290710" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461690}] :answer-field/correct {:answer/id #uuid "315f2abe-9a26-53e9-83fa-b2133c290710" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461690} :answer-field/id #uuid "796a9a88-fbec-5d78-a6c2-5887f0b84dee" :answer-field/key "$f(x)$ is concave up on $(-\\infty ,0)\\cup (0,\\infty )$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462598} {:answer-field/choices [{:answer/id #uuid "0501edb0-6193-5111-9965-3cf69fd6d025" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461691} {:answer/id #uuid "2aaefe3a-0e2c-598d-8ca5-0122976d169d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461692}] :answer-field/correct {:answer/id #uuid "0501edb0-6193-5111-9965-3cf69fd6d025" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461691} :answer-field/id #uuid "bfbfcd2b-c257-521a-a3e3-88fac2fbb5fa" :answer-field/key "$f(x)$ is concave down on $(0,\\infty )$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462599} {:answer-field/choices [{:answer/id #uuid "cf0cb466-895c-55a0-a52e-cf20a384c530" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461693} {:answer/id #uuid "70393936-4fa8-59bd-bb3e-4252b95fbf53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461694}] :answer-field/correct {:answer/id #uuid "cf0cb466-895c-55a0-a52e-cf20a384c530" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461693} :answer-field/id #uuid "f9be2509-66d6-56fb-8f54-59b1e96de6a5" :answer-field/key "$f(x)$ is concave down on $(-\\infty ,0)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462600} {:answer-field/choices [{:answer/id #uuid "46a91c4a-9dcf-5f50-84de-17b86b2bdbb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667866} {:answer/id #uuid "0b92d0c1-fd95-563c-9827-87e2fa351d3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667867}] :answer-field/correct {:answer/id #uuid "46a91c4a-9dcf-5f50-84de-17b86b2bdbb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667866} :answer-field/id #uuid "0aaedc0a-a184-557a-8e74-d82ea9542a31" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668210}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "136bbef5-7f5b-5272-816c-ea16bb2ceed2" :question/math-academy-id "q-114272" :question/problem "Consider the function $f(x)=({x}^{2}-4x+6){e}^{x}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, we calculate the second derivative of $f(x),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =({x}^{2}-4x+6){e}^{x}+(2x-4){e}^{x} \\\\  & =({x}^{2}-2x+2){e}^{x} \\\\ {f}^{″}(x) & =({x}^{2}-2x+2){e}^{x}+(2x-2){e}^{x} \\\\  & ={x}^{2}{e}^{x}\\end{aligned}\n$$\n\nTo find where the function is concave up, we need to solve ${f}^{″}(x)>0:$\n\n$$\n\\begin{aligned}{x}^{2}{e}^{x} & >0.\\end{aligned}\n$$\n\nSince ${e}^{x}>0$ and ${x}^{2}>0$ for all real values $x\\ne 0,$ the inequality ${f}^{″}(x)>0$ has the solution $(-\\infty ,0)\\cup (0,\\infty ).$ So $f(x)$ is concave up on the interval $(-\\infty ,0)\\cup (0,\\infty ).$\n\nThe function $f(x)$ is concave down when ${f}^{″}(x)<0.$ By similar reasoning to before, this leads to the inequality ${x}^{2}{e}^{x}<0,$ which does not have solutions. So $f(x)$ is concave down nowhere.\n\nTherefore, the correct answer is “$f(x)$ is concave up on $(-\\infty ,0)\\cup (0,\\infty )$” only."} {:db/id #edb/ref 17592186250221 :knowledge-point/_questions [{:db/id #edb/ref 17592186184151 :knowledge-point/id #uuid "437c168a-6799-5d13-bd9b-031290a84da6" :knowledge-point/title "Finding the Intervals of Concavity of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "242f19c6-0790-5b73-a95d-b9bf3ce752ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461695} {:answer/id #uuid "e4fad236-c416-5ae4-a529-59fa15587eac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461696}] :answer-field/correct {:answer/id #uuid "242f19c6-0790-5b73-a95d-b9bf3ce752ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461695} :answer-field/id #uuid "78ff58d7-6b13-59d9-8094-7aa224dde724" :answer-field/key "$f(x)$ is concave up on $(0,1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462601} {:answer-field/choices [{:answer/id #uuid "acf973ce-31c7-59e8-8863-2afd23e29694" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461697} {:answer/id #uuid "09c9c565-acb1-5e93-8cf2-d8560f1ed564" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461698}] :answer-field/correct {:answer/id #uuid "09c9c565-acb1-5e93-8cf2-d8560f1ed564" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461698} :answer-field/id #uuid "b0be23d3-289f-5073-8701-6cd532ad237d" :answer-field/key "$f(x)$ is concave down on $(0,1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462602} {:answer-field/choices [{:answer/id #uuid "600c592f-d550-5ca3-9317-e6c0c5c0e4a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461699} {:answer/id #uuid "9d046dd3-43dc-5a20-9121-50f2c2cf750b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461700}] :answer-field/correct {:answer/id #uuid "600c592f-d550-5ca3-9317-e6c0c5c0e4a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461699} :answer-field/id #uuid "884c486d-26aa-5b2b-a395-c1a37b40db8d" :answer-field/key "$f(x)$ is concave down on $(1,\\infty )$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462603} {:answer-field/choices [{:answer/id #uuid "64c7aa96-4481-5066-98f3-212cf1ae0a3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667868} {:answer/id #uuid "49a60689-ef54-59c4-b94d-a3047efd7566" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667869}] :answer-field/correct {:answer/id #uuid "64c7aa96-4481-5066-98f3-212cf1ae0a3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667868} :answer-field/id #uuid "79a536a1-2ffb-50e1-8ab4-4dc0cce26dab" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668211}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c1339af8-7ec4-512f-92c7-059b9ab8ffee" :question/math-academy-id "q-114277" :question/problem "Consider the function $f(x)={x}^{3}+6\\operatorname{ln}⁡x$ defined on $x\\in (0,\\infty ).$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, we calculate the second derivative of $f(x),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =3{x}^{2}+\\frac{6}{x} \\\\ {f}^{″}(x) & =6x-\\frac{6}{{x}^{2}} \\\\  & =\\frac{6({x}^{3}-1)}{{x}^{2}}.\\end{aligned}\n$$\n\nTo find where the function is concave up, we need to solve ${f}^{″}(x)>0:$\n\n$$\n\\begin{aligned}\\frac{6({x}^{3}-1)}{{x}^{2}} & >0 \\\\ {x}^{3}-1 & >0 \\\\ {x}^{3} & >1 \\\\ x & >1\\end{aligned}\n$$\n\nNote that we used the fact that ${x}^{2}>0.$\n\nHence, ${f}^{″}(x)>0$ when $x>1.$ So the graph is concave up on the interval $(1,\\infty ).$\n\nThe function $f(x)$ is concave down when ${f}^{″}(x)<0.$ By similar reasoning to before, this leads to the inequality ${x}^{3}-1<0,$ which has the solution $(0,1).$\n\nTherefore, the correct answer is \" “$f(x)$ is concave down on $(0,1)$” only.\""} {:db/id #edb/ref 17592186250260 :knowledge-point/_questions [{:db/id #edb/ref 17592186064165 :knowledge-point/id #uuid "ae256269-0bec-5d57-ac4a-eb0b07926f6f" :knowledge-point/title "Finding Critical Points and Then Classifying Them Using the Second Derivative Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a72430ec-f6b3-5a9f-9bc6-24032ddfc234" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461701} {:answer/id #uuid "263a2b10-5369-5daa-a857-d4f1a56ed0a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461702}] :answer-field/correct {:answer/id #uuid "263a2b10-5369-5daa-a857-d4f1a56ed0a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461702} :answer-field/id #uuid "47d3b3d6-f7d5-5785-b33f-2e2d8b7829df" :answer-field/key "$x=0$ is a critical point of $f(x)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462604} {:answer-field/choices [{:answer/id #uuid "52ad5dd7-be3c-56db-a7bc-0110b4655953" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461703} {:answer/id #uuid "bc70f5c3-d6e5-5e0a-bff8-3c04c94eee40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461704}] :answer-field/correct {:answer/id #uuid "bc70f5c3-d6e5-5e0a-bff8-3c04c94eee40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461704} :answer-field/id #uuid "dba2832e-7fc5-54f6-bacd-ebd504e6a597" :answer-field/key "${f}^{″}(0)<0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462605} {:answer-field/choices [{:answer/id #uuid "37e91a09-6937-50af-a536-8c4dbce2fd60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461705} {:answer/id #uuid "211188c2-8354-500b-b2dc-9d9d6b844de0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461706}] :answer-field/correct {:answer/id #uuid "37e91a09-6937-50af-a536-8c4dbce2fd60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461705} :answer-field/id #uuid "ab6ff90e-2bbf-5a1d-9cb9-ebcc273dbe85" :answer-field/key "$f(x)$ has a relative minimum at $x=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462606} {:answer-field/choices [{:answer/id #uuid "a05cbf00-ceec-5f3d-97e2-2128b4417524" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667870} {:answer/id #uuid "a985143b-0537-5d72-91d6-9e8f55a540a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667871}] :answer-field/correct {:answer/id #uuid "a05cbf00-ceec-5f3d-97e2-2128b4417524" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667870} :answer-field/id #uuid "991c5444-0a80-5a0b-b4b8-c589b368d114" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668212}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a75ae1b4-9111-5369-af8d-34d27de2f589" :question/math-academy-id "q-114414" :question/problem "For the function $f(x)=x-{e}^{x},$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "We need to identify whether $x=0$ is a critical point. If it is, we then need to classify it using the second derivative test.\n\nFirst, we need to identify the critical points. Differentiating $f(x)=x-{e}^{x},$ we get\n\n$$\n{f}^{′}(x)=1-{e}^{x},\n$$\n\nand solving ${f}^{′}(x)=0,$ we get\n\n$$\n\\begin{aligned}1-{e}^{x} & =0 \\\\ {e}^{x} & =1 \\\\ x & =0.\\end{aligned}\n$$\n\nSo we have a critical point at $x=0.$\n\nNext, we need to determine the sign of ${f}^{″}(x)$ at this critical point. Computing ${f}^{″}(x),$ we get\n\n$$\n{f}^{″}(x)=-{e}^{x},\n$$\n\nand evaluating ${f}^{″}(x)$ at $x=0$, we get\n\n$$\n{f}^{″}(0)=-1<0.\n$$\n\nThe second derivative is negative at $x=0,$ so this critical point is a relative *maximum*. \n\nTherefore, comparing our results with the given statements, we conclude that:\n\n- $x=0$ is a critical point of $f(x)\\,✓$\n\n- ${f}^{″}(0)<0\\,✓$\n\n- $f(0)$ has a relative *maximum* at $x=0\\,\\times $\n\nTherefore, the correct answer is “$x=0$ is a critical point of $f(x)$”; ${f}^{″}(0)<0$ only."} {:db/id #edb/ref 17592186250486 :knowledge-point/_questions [{:db/id #edb/ref 17592186166860 :knowledge-point/id #uuid "762c5225-00bd-5d2f-9859-394f886482cb" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using the Sign of the Slopes and Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05bfcbaa-d2b1-5fe0-ad56-ec1eaae881ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461767} {:answer/id #uuid "f2f5ed1e-509a-5016-b984-67ee16a92bea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461768}] :answer-field/correct {:answer/id #uuid "05bfcbaa-d2b1-5fe0-ad56-ec1eaae881ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461767} :answer-field/id #uuid "d0bff3c9-f537-55cb-a1c9-27fc825821aa" :answer-field/key "${y}^{′}=-2{x}^{2}-4x-2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462637} {:answer-field/choices [{:answer/id #uuid "73346110-21be-5682-8e62-0adb727d81ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461769} {:answer/id #uuid "26e67922-9884-5bea-aa66-b917a449fbbc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461770}] :answer-field/correct {:answer/id #uuid "26e67922-9884-5bea-aa66-b917a449fbbc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461770} :answer-field/id #uuid "92a7748a-62c0-5f15-97d3-4cfba9d041af" :answer-field/key "${y}^{′}={x}^{2}+2x+1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462638} {:answer-field/choices [{:answer/id #uuid "3782d80d-50d4-5d80-8925-6ddad28cab0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461771} {:answer/id #uuid "f789845b-9090-5a1d-b191-815a29e6ff58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461772}] :answer-field/correct {:answer/id #uuid "3782d80d-50d4-5d80-8925-6ddad28cab0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461771} :answer-field/id #uuid "517e6b35-18b0-5548-9e90-b787cba99ee2" :answer-field/key "${y}^{′}={x}^{2}-1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462639} {:answer-field/choices [{:answer/id #uuid "718cf01e-c060-5c0c-a606-9016c5d0548d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667872} {:answer/id #uuid "eaa069d4-4b72-577d-a91e-fe06fa117846" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667873}] :answer-field/correct {:answer/id #uuid "718cf01e-c060-5c0c-a606-9016c5d0548d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667872} :answer-field/id #uuid "780b102e-b294-552c-b706-85c3d2cffbf2" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668213}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3ef86548-9209-58c6-a39c-c5582ffe1c99" :question/math-academy-id "q-115813" :question/problem "![](images/5a/5a2a2b4b141f4f0c250e4865b174b9eb32b1ed4ab94cc6ebd074131673d5712c.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\nSelect all that apply." :question/worked-solution "![](images/69/69465ce0573d7b6deac631663766a5dd1c90afa29eeb0c5286cb5ef1f7ee1153.png)\n\n \n\nNotice the following properties of the given slope field:\n\n- First, the slope field is zero along the line $x=-1.$ Therefore, the right-hand side of the differential equation should evaluate to zero on this line.\n\n- Second, the line $x=-1$ divides the plane into $2$ regions. The sign of the slopes in each of the $2$ regions are easily deduced by considering the behavior of the solution curves in these regions. This information is summarized in the following table:\n\n| Region | $x<-1$ | $x>-1$ |\n| --- | --- | --- |\n| Slope | $↗$ | $↗$ |\n| Sign | $+$ | $+$ |\n\nWith that in mind, let's consider each equation.\n\n- The equation \n\n$$\n{y}^{′}=-2{x}^{2}-4x-2=-2(x+1)^{2}\n$$\n\ndoes *not* give the required behavior. The right-hand side evaluates to zero at $x=-1,$ but the sign of the slopes in the required regions (summarized below) do not correspond to the given slope field.\n\n| Region | $x<-1$ | $x>-1$ |\n| --- | --- | --- |\n| Slope | $↘$ | $↘$ |\n| Sign | $-$ | $-$ |\n\n- The equation \n\n$$\n{y}^{′}={x}^{2}+2x+1=(x+1)^{2}\n$$\n\ngives the required behavior.\n\n- The equation\n\n$$\n{y}^{′}={x}^{2}-1=(x+1)(x-1)\n$$\n\ndoes *not* give the required behavior. The right-hand side evaluates to zero at $x=-1$ and $x=1.$\n\nTherefore, the correct answer is ${y}^{′}={x}^{2}+2x+1$ only."} {:db/id #edb/ref 17592186253300 :knowledge-point/_questions [{:db/id #edb/ref 17592186110571 :knowledge-point/id #uuid "67692569-e3a4-51e8-99ac-79d8b3081363" :knowledge-point/title "Determining Points that Lie on the Curve of the Inverse Sine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d0a69c3-de2a-5629-9e9a-01e7bf9e2c72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461809} {:answer/id #uuid "0c3ff2c1-b103-5029-a96c-9f3d809db7c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461810}] :answer-field/correct {:answer/id #uuid "1d0a69c3-de2a-5629-9e9a-01e7bf9e2c72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461809} :answer-field/id #uuid "909a604a-0da9-52b3-8331-6540b6b46528" :answer-field/key "$(\\frac{\\sqrt{2}}{2},\\frac{3\\pi }{4})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462658} {:answer-field/choices [{:answer/id #uuid "5bc89b79-e7f9-5da0-89dc-18cb255ffce0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461811} {:answer/id #uuid "a12c7112-b5c5-5054-816c-47769741fe0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461812}] :answer-field/correct {:answer/id #uuid "5bc89b79-e7f9-5da0-89dc-18cb255ffce0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461811} :answer-field/id #uuid "09ecaba8-e054-56b0-984d-74d7c129549e" :answer-field/key "$(\\frac{1}{4},-\\frac{\\pi }{2})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462659} {:answer-field/choices [{:answer/id #uuid "bb00d1b4-e83c-5829-af51-92502125af82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461813} {:answer/id #uuid "eb3ad07f-1650-57aa-add0-1865e9384e87" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461814}] :answer-field/correct {:answer/id #uuid "bb00d1b4-e83c-5829-af51-92502125af82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461813} :answer-field/id #uuid "ff580f36-fed7-5993-a941-ba77d516a454" :answer-field/key "$(1,\\pi )$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462660} {:answer-field/choices [{:answer/id #uuid "99e28d53-5d38-56c2-9699-b35e1120ccc2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667878} {:answer/id #uuid "1a6c193b-3618-5ca6-a17e-89e0c99b4c8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667879}] :answer-field/correct {:answer/id #uuid "1a6c193b-3618-5ca6-a17e-89e0c99b4c8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667879} :answer-field/id #uuid "4d3b5fb4-bd3e-5d13-85f5-de75e70b45e0" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668216}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a9ed09ea-d30a-5142-9dec-aca74736564e" :question/math-academy-id "q-117025" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arcsin}⁡x?$\n\nSelect all that apply." :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arcsin}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{sin}⁡x,$ meaning $a=\\operatorname{sin}⁡b.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arcsin}⁡x,$ which is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}].$\n\nWith this in mind, let's check each of the points. \n\n- First, we consider the point $(\\frac{\\sqrt{2}}{2},\\frac{3\\pi }{4}).$ We note the following:\n\n- The point $(\\frac{3\\pi }{4},\\frac{\\sqrt{2}}{2})$ lies on the graph of $y=\\operatorname{sin}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arcsin}⁡x$ is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}],$ and $y=\\frac{3\\pi }{4}$ does **not** lie within this range. $\\,\\times $\n\nTherefore, the point $(\\frac{\\sqrt{2}}{2},\\frac{3\\pi }{4})$ does **not** lie on the graph of $y=\\operatorname{arcsin}⁡x.$\n\n- Next, we consider the point $(\\frac{1}{4},-\\frac{\\pi }{2}).$ We note the following:\n\n- The point $(-\\frac{\\pi }{2},\\frac{1}{4})$ does **not** lie on the graph of $y=\\operatorname{sin}⁡x.$  $\\,\\times $\n\nTherefore, the point $(\\frac{1}{4},-\\frac{\\pi }{2})$ does **not** lie on the graph of $y=\\operatorname{arcsin}⁡x.$\n\n- Finally, we consider the point $(1,\\pi ).$ We note the following:\n\n- The point $(\\pi ,1)$ does **not** lie on the graph of $y=\\operatorname{sin}⁡x.$  $\\,\\times $\n\nTherefore, the point $(1,\\pi )$ does **not** lie on the graph of $y=\\operatorname{arcsin}⁡x.$"} {:db/id #edb/ref 17592186253444 :knowledge-point/_questions [{:db/id #edb/ref 17592186172017 :knowledge-point/id #uuid "1616167b-5679-5ff6-b385-3e1b59352c64" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using the Sign of the Slopes and Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c63043b-4d95-5271-bd03-04c48cf42652" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461857} {:answer/id #uuid "c435a8df-48c3-55f3-bf34-545dd961babb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461858}] :answer-field/correct {:answer/id #uuid "7c63043b-4d95-5271-bd03-04c48cf42652" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461857} :answer-field/id #uuid "69e6dd76-17e5-5d00-b6a3-2725217da17c" :answer-field/key "${y}^{′}={x}^{2}y+{x}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462682} {:answer-field/choices [{:answer/id #uuid "9f3b0f15-11c5-5f91-8e39-a4700396d70b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461859} {:answer/id #uuid "413ccddf-0828-5899-b41a-c5b854115744" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461860}] :answer-field/correct {:answer/id #uuid "9f3b0f15-11c5-5f91-8e39-a4700396d70b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461859} :answer-field/id #uuid "8a8bbbbd-3619-58c4-a2c4-e30a857f4e01" :answer-field/key "${y}^{′}=xy-x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462683} {:answer-field/choices [{:answer/id #uuid "aa9e1a21-a120-5fbf-b91e-9951a669f7c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461861} {:answer/id #uuid "5bfa0a89-a5fb-5b03-9b6b-0a15e263c8c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461862}] :answer-field/correct {:answer/id #uuid "5bfa0a89-a5fb-5b03-9b6b-0a15e263c8c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461862} :answer-field/id #uuid "569a9252-47cd-5e75-9c9f-40b194a881a6" :answer-field/key "${y}^{′}=x{y}^{2}+2xy+x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462684} {:answer-field/choices [{:answer/id #uuid "437895e2-073a-5363-b803-6b665ad4635c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667880} {:answer/id #uuid "b82f048a-9764-54c8-a083-4d278f99bb9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667881}] :answer-field/correct {:answer/id #uuid "437895e2-073a-5363-b803-6b665ad4635c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667880} :answer-field/id #uuid "2b7b6eb2-0988-5c41-961b-554e8a189157" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668217}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f47e52f5-b113-5140-ac0d-d3912c7ac7a7" :question/math-academy-id "q-118025" :question/problem "![](images/50/5077a94fe8b5d5435b5bf50d0ea687f5bc87ae95011e22800ccfe473f8af78dd.png)\n\nThe diagram shown above is the slope field for which of the following differential equations?\n\nSelect all that apply." :question/worked-solution "![](images/2f/2f7075161363dee2817aeb8aff9e85781a10bd30c926bfff73724992eee699ac.png)\n\nNotice the following properties of the given slope field:\n\n- First, the slopes of the slope field are horizontal along the lines $x=0$ and $y=-1,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\n- Second, the lines $x=0$ and $y=-1$ divide the plane into $4$ quarters. The sign of the slopes in each of the $4$ quarters are easily deduced by considering the behavior of the solution curves in these regions. This information is summarized in the following table:\n\n| $y>-1$ | $↘$\n\n$(-)$ | $↗$\n\n$(+)$ |\n| --- | --- | --- |\n| $y<-1$ | $↘$\n\n$(-)$ | $↗$\n\n$(+)$ |\n|  | $x<0$ | $x>0$ |\n\nWith that in mind, let's consider each equation.\n\n- Equation ${y}^{′}={x}^{2}y+{x}^{2}$ does *not* give the required behavior. The right-hand side of\n\n$$\n{y}^{′}={x}^{2}y+{x}^{2}={x}^{2}(y+1)\n$$\n\nevaluates to zero at $x=0$ and $y=-1,$ but the sign of the slopes in the required regions (summarized below) do not correspond to the given slope field.\n\n| $y>-1$ | $+$ | $+$ |\n| --- | --- | --- |\n| $y<-1$ | $-$ | $-$ |\n|  | $x<0$ | $x>0$ |\n\n- Equation ${y}^{′}=xy-x$ does *not* give the required behavior. The right-hand side of\n\n$$\n{y}^{′}=xy-x=x(y-1)\n$$\n\nevaluates to zero at $x=0$ and $y=1.$\n\n- Equation ${y}^{′}=x{y}^{2}+2xy+x$ gives the required behavior. The right-hand side of\n\n$$\n{y}^{′}=x{y}^{2}+2xy+x=x(y+1)^{2}\n$$\n\nevaluates to zero at $x=0$ and $y=-1,$ and the sign of the slopes in the required regions (summarized below) correspond to the given slope field.\n\n| $y>-1$ | $-$ | $+$ |\n| --- | --- | --- |\n| $y<-1$ | $-$ | $+$ |\n|  | $x<0$ | $x>0$ |\n\nTherefore, the correct answer is ${y}^{′}=x{y}^{2}+2xy+x$ only."} {:db/id #edb/ref 17592186253513 :knowledge-point/_questions [{:db/id #edb/ref 17592186166815 :knowledge-point/id #uuid "13e08fd0-4f41-56eb-8650-b72aa739b7a1" :knowledge-point/title "Initial Value Problems and Initial Conditions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "289bb35b-99fe-5106-99b0-f71c04163a88" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422201} {:answer/id #uuid "2302fbb6-0adc-5661-bbf7-af76484dacc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422202}] :answer-field/correct {:answer/id #uuid "289bb35b-99fe-5106-99b0-f71c04163a88" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422201} :answer-field/id #uuid "5e48c6aa-29b3-5af2-98e8-cf9155d9f86e" :answer-field/key "${x}^{2}{y}^{‴}+9{x}^{3}{y}^{′}$ $=-7y,$ $\\,y(0)$ $={y}^{′}(0)$ $={y}^{″}(0)$ $=-4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422381} {:answer-field/choices [{:answer/id #uuid "beef713f-b9cc-55dc-8f1d-6cf37ec09f6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422203} {:answer/id #uuid "e499fae0-7b48-5f3b-93bb-81ab64c9da66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422204}] :answer-field/correct {:answer/id #uuid "e499fae0-7b48-5f3b-93bb-81ab64c9da66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422204} :answer-field/id #uuid "fbae87b9-4781-5997-879b-2dc1d3b6b122" :answer-field/key "$x{y}^{′}+{e}^{x}y=6,\\,y(0)=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422382} {:answer-field/choices [{:answer/id #uuid "aac407af-d819-550f-805d-c2f156435fe9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422205} {:answer/id #uuid "983242a4-a136-5392-8243-ada487eed7f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422206}] :answer-field/correct {:answer/id #uuid "aac407af-d819-550f-805d-c2f156435fe9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422205} :answer-field/id #uuid "259806e0-5727-5f05-a402-006bfaa14dbc" :answer-field/key "$6{y}^{″}+xy={e}^{x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422383} {:answer-field/choices [{:answer/id #uuid "00961f22-7d66-5970-9647-d30b12f91998" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667884} {:answer/id #uuid "6fe46914-dcb5-5fe6-a475-9f62220e4a70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667885}] :answer-field/correct {:answer/id #uuid "00961f22-7d66-5970-9647-d30b12f91998" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667884} :answer-field/id #uuid "6fa084b3-fd49-5582-a4a8-d2c91c912a39" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668219}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "941e9c2c-1b18-5669-bb2b-964e53cd46ef" :question/math-academy-id "q-118788" :question/problem "Which of the following systems is a first-order initial value problem?\n\nSelect all that apply." :question/worked-solution "A first-order initial value problem (or IVP) is a first-order ordinary differential equation together with an initial condition that specifies a value of the unknown function at a point in its domain. A first-order initial value problem typically takes the form\n\n$$\n{y}^{′}=f(x,y),\\,y({x}_{0})={y}_{0},\n$$\n\nwhere ${x}_{0}$ and ${y}_{0}$ are constants.\n\nWith that in mind, let's check each option.\n\n- System ${x}^{2}{y}^{‴}+9{x}^{3}{y}^{′}$ $=-7y,$ $\\,y(0)$ $={y}^{′}(0)$ $={y}^{″}(0)$ $=-4$ is not a first-order initial value problem. It consists of a *third*-order differential equation ${x}^{2}{y}^{‴}+9{x}^{3}{y}^{′}=-7y$ together with *three* initial conditions $y(0)={y}^{′}(0)={y}^{″}(0)=-4.$ This is a third-order initial value problem.\n\n- System $x{y}^{′}+{e}^{x}y=6,\\,y(0)=2$ is a first-order initial value problem. It consists of a first-order differential equation $x{y}^{′}+{e}^{x}y=6$ together with the initial condition $y(0)=2.$\n\n- System $6{y}^{″}+xy={e}^{x}$ is not a first-order initial value problem. We have here a second-order ordinary differential equation.\n\nTherefore, the correct answer is $x{y}^{′}+{e}^{x}y=6,\\,y(0)=2$ only."} {:db/id #edb/ref 17592186253520 :knowledge-point/_questions [{:db/id #edb/ref 17592186166814 :knowledge-point/id #uuid "2fa0c4b2-8dc6-5823-a9bb-b933a9f9ee7f" :knowledge-point/title "Determining Whether an Ordinary Differential Equation is Autonomous or Nonautonomous"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "205c2cd6-04ab-56ea-9090-bfc8e049d542" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422225} {:answer/id #uuid "78ae71d2-619b-56f3-92bf-ecfeebf9c3b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422226}] :answer-field/correct {:answer/id #uuid "205c2cd6-04ab-56ea-9090-bfc8e049d542" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422225} :answer-field/id #uuid "4adb79a2-2fca-5fcf-8dd7-6acc5f68f3a9" :answer-field/key "${y}^{′}-3{x}^{2}=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422393} {:answer-field/choices [{:answer/id #uuid "18e49df7-3c70-5cd8-beb4-ff959fd404aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422227} {:answer/id #uuid "38051905-c461-5911-8df5-70c9f959f1d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422228}] :answer-field/correct {:answer/id #uuid "38051905-c461-5911-8df5-70c9f959f1d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422228} :answer-field/id #uuid "cacddabc-75dd-59ce-afe3-05d7d1ba8798" :answer-field/key "${y}^{′}+6y={e}^{3y}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422394} {:answer-field/choices [{:answer/id #uuid "8a5168fb-5c6b-5a1a-8194-633d3b1f1dfb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422229} {:answer/id #uuid "f7168c22-e701-5df5-af8a-614a1a97b22e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422230}] :answer-field/correct {:answer/id #uuid "8a5168fb-5c6b-5a1a-8194-633d3b1f1dfb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422229} :answer-field/id #uuid "944c44c1-dc25-512a-858d-9642a5fec880" :answer-field/key "${y}^{′}=\\operatorname{ln}⁡(2{x}^{2}+1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422395} {:answer-field/choices [{:answer/id #uuid "f1fc7d74-08b1-529b-82d8-3459e708bb69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667886} {:answer/id #uuid "936e7953-8787-5637-9511-f824690dc631" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667887}] :answer-field/correct {:answer/id #uuid "f1fc7d74-08b1-529b-82d8-3459e708bb69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667886} :answer-field/id #uuid "9d1076ed-79d2-51a8-b030-775fe8db2afe" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668220}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "81da2b48-aa38-5eb5-8b7d-567a07263315" :question/math-academy-id "q-118859" :question/problem "Which of the following are autonomous ordinary differential equations?\n\nSelect all that apply." :question/worked-solution "An ordinary differential equation with dependent variable $y$ and independent variable $x$ is said to be autonomous if it can be written in the form $\\frac{\\text{d}y}{\\text{d}x}=f(y),$ or equivalently, ${y}^{′}=f(y).$\n\nWith that in mind, let's check each of the differential equations:\n\n- Equation ${y}^{′}-3{x}^{2}=1$ is not an autonomous differential equation. If we isolate the derivative term, we get\n\n$$\n\\begin{aligned}{y}^{′}-3{x}^{2} & =1 \\\\ {y}^{′} & =3{x}^{2}+1 \\\\ {y}^{′} & =f(x)\\end{aligned}\n$$\n\nwhere $f(x)=3{x}^{2}+1.$ So, it is not possible to write the equation in the form ${y}^{′}=f(y).$\n\n- Equation ${y}^{′}+6y={e}^{3y}$ is an autonomous differential equation. Writing the equation in the form ${y}^{′}=f(y),$ we get\n\n$$\n\\begin{aligned}{y}^{′}+6y & ={e}^{3y} \\\\ {y}^{′} & ={e}^{3y}-6y \\\\ {y}^{′} & =f(y)\\end{aligned}\n$$\n\nwhere $f(y)={e}^{3y}-6y.$\n\n- Equation ${y}^{′}=\\operatorname{ln}⁡(2{x}^{2}+1)$ is not an autonomous differential equation. It is not of the form ${y}^{′}=f(y).$\n\nTherefore, the correct answer is ${y}^{′}+6y={e}^{3y}$ only."} {:db/id #edb/ref 17592186253597 :knowledge-point/_questions [{:db/id #edb/ref 17592186172039 :knowledge-point/id #uuid "fd092f29-08bf-5425-88a4-8cba4f0a31c8" :knowledge-point/title "Identifying Quadrants Where a Slope Field Is Positive or Negative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "caf9f9a0-fe1d-58a6-a9a8-b5a5e2a9514b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437564} {:answer/id #uuid "c6011e7b-933f-5512-8d31-3053e17fd0dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437565}] :answer-field/correct {:answer/id #uuid "caf9f9a0-fe1d-58a6-a9a8-b5a5e2a9514b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437564} :answer-field/id #uuid "ecff95c2-727a-5dae-ab02-1414391132f2" :answer-field/key "At every point in the first quadrant, the slope of the slope field is positive" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438811} {:answer-field/choices [{:answer/id #uuid "791f7229-c5a9-5faf-8875-969a85713e63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437566} {:answer/id #uuid "a8d04d15-d334-5842-ab9f-31f5f6d0fe8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437567}] :answer-field/correct {:answer/id #uuid "791f7229-c5a9-5faf-8875-969a85713e63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437566} :answer-field/id #uuid "2fdf80c4-0c0f-5731-bd95-650894071c56" :answer-field/key "At every point in the second quadrant, the slope of the slope field is negative" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438812} {:answer-field/choices [{:answer/id #uuid "85f793cf-e920-5057-905e-6cd6b37d67be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437568} {:answer/id #uuid "42e66d50-d188-5d08-9d22-fe5a8a4b8fa5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437569}] :answer-field/correct {:answer/id #uuid "42e66d50-d188-5d08-9d22-fe5a8a4b8fa5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437569} :answer-field/id #uuid "b3f69ac8-557d-5583-a34f-bae77d1add4a" :answer-field/key "At every point in the fourth quadrant, the slope of the slope field is positive" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438813} {:answer-field/choices [{:answer/id #uuid "1181fc42-b86d-50d6-8782-d9ed9b1e42c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667888} {:answer/id #uuid "217ea4f1-ae91-53b2-b892-4e2f293b5b3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667889}] :answer-field/correct {:answer/id #uuid "1181fc42-b86d-50d6-8782-d9ed9b1e42c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667888} :answer-field/id #uuid "df06b130-bf24-5498-a9e1-2e7063078c8c" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668221}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e15411d6-1039-50b8-8bc5-cef852747aab" :question/math-academy-id "q-119769" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=-5xy$ and its slope field. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, we define $f(x,y)=-5xy.$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=0$ or $y=0.$ The lines $x=0$ and $y=0$ divide the plane into the usual four quadrants.\n\nIf we compute the sign of $f(x,y)$ in each quadrant (by considering some test points, for example), we get the following:\n\n![](images/2c/2c218c7df2bf4e159b4bffaccb4296beab8e3f44ab82d56b3589050af92ccf8e.png)\n\nWith that in mind, let's check each statement:\n\n- Statement “At every point in the first quadrant, the slope of the slope field is positive” is false. If $(x,y)$ is in the first quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in the first quadrant.\n\n- Statement “At every point in the second quadrant, the slope of the slope field is negative” is false. If $(x,y)$ is in the second quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the second quadrant.\n\n- Statement “At every point in the fourth quadrant, the slope of the slope field is positive” is true. If $(x,y)$ is in the fourth quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the fourth quadrant.\n\nTherefore, the correct answer is “At every point in the fourth quadrant, the slope of the slope field is positive” only."} {:db/id #edb/ref 17592186253601 :knowledge-point/_questions [{:db/id #edb/ref 17592186172039 :knowledge-point/id #uuid "fd092f29-08bf-5425-88a4-8cba4f0a31c8" :knowledge-point/title "Identifying Quadrants Where a Slope Field Is Positive or Negative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2acc8d45-b3cb-5472-808a-0ded96068ea4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437570} {:answer/id #uuid "5634aa7f-d685-513c-b71c-dd484269de1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437571}] :answer-field/correct {:answer/id #uuid "2acc8d45-b3cb-5472-808a-0ded96068ea4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437570} :answer-field/id #uuid "1a1d4246-8605-5a10-a963-fb61cf7903ea" :answer-field/key "At every point in the first quadrant, the slope of the slope field is negative" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438814} {:answer-field/choices [{:answer/id #uuid "dc34f3d5-600f-5ec4-ada6-979b186201d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437572} {:answer/id #uuid "a49a1c0b-79f3-538f-b749-b1d3bd1e40e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437573}] :answer-field/correct {:answer/id #uuid "a49a1c0b-79f3-538f-b749-b1d3bd1e40e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437573} :answer-field/id #uuid "c41e5771-7f8b-5c44-9d14-38d54c1a1ee9" :answer-field/key "At every point in the third quadrant, the slope of the slope field is positive" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438815} {:answer-field/choices [{:answer/id #uuid "59bd4a0c-4bd0-55c9-ad16-d8c9e25d7727" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437574} {:answer/id #uuid "a8d6c719-9178-53d2-a8bc-b7c6358a8cc9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437575}] :answer-field/correct {:answer/id #uuid "59bd4a0c-4bd0-55c9-ad16-d8c9e25d7727" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437574} :answer-field/id #uuid "5a4fd295-2359-5c48-b9f5-fdc795da9a6a" :answer-field/key "At every point in the fourth quadrant, the slope of the slope field is negative" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438816} {:answer-field/choices [{:answer/id #uuid "3cde11c7-cf2f-5cb9-95d2-dccab4335080" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667890} {:answer/id #uuid "f2b3a6e2-a93b-59e6-854b-9492e52b5f82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667891}] :answer-field/correct {:answer/id #uuid "3cde11c7-cf2f-5cb9-95d2-dccab4335080" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667890} :answer-field/id #uuid "2de75eeb-b32e-55a5-a13f-ac56c2af95a9" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668222}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c47e99b0-49b1-5362-97e1-164913960980" :question/math-academy-id "q-119774" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=8{x}^{2}{y}^{2}$ and its slope field. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, we define $f(x,y)=8{x}^{2}{y}^{2}.$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=0$ or $y=0.$ The lines $x=0$ and $y=0$ divide the plane into the usual four quadrants.\n\nIf we compute the sign of $f(x,y)$ in each quadrant (by considering some test points, for example), we get the following:\n\n![](images/d1/d1e4f48450a7f2032d755a5255d1a1e8a726dd16d273dae5dc1e587826d5ce58.png)\n\nWith that in mind, let's check each statement:\n\n- Statement “At every point in the first quadrant, the slope of the slope field is negative” is false. If $(x,y)$ is in the first quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the first quadrant.\n\n- Statement “At every point in the third quadrant, the slope of the slope field is positive” is true. If $(x,y)$ is in the third quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the third quadrant.\n\n- Statement “At every point in the fourth quadrant, the slope of the slope field is negative” is false. If $(x,y)$ is in the fourth quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the fourth quadrant.\n\nTherefore, the correct answer is “At every point in the third quadrant, the slope of the slope field is positive” only."} {:db/id #edb/ref 17592186253605 :knowledge-point/_questions [{:db/id #edb/ref 17592186172041 :knowledge-point/id #uuid "75710e99-e13c-54ba-9401-486bfec15284" :knowledge-point/title "Identifying Rectangular Regions Where a Slope Field Is Positive or Negative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e1be2fa-de0d-5f22-b440-911091c56105" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437582} {:answer/id #uuid "75d08e9a-c55b-5a67-abb2-4e27159b9b63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437583}] :answer-field/correct {:answer/id #uuid "7e1be2fa-de0d-5f22-b440-911091c56105" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437582} :answer-field/id #uuid "8390e0db-2166-50f2-a123-b7b9177c8341" :answer-field/key "At every point $(x,y)$ where $x<1$ and $y>2,$ the slope of the slope field is negative" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438820} {:answer-field/choices [{:answer/id #uuid "a3164774-f189-596d-acdb-746f708a14aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437584} {:answer/id #uuid "e364779c-88b2-5f8d-ac35-11f4c01ba4f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437585}] :answer-field/correct {:answer/id #uuid "a3164774-f189-596d-acdb-746f708a14aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437584} :answer-field/id #uuid "a904fb7a-832f-5a30-ac49-1d6d8c3a62e6" :answer-field/key "At every point $(x,y)$ where $x>1$ and $y<2,$ the slope of the slope field is negative" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438821} {:answer-field/choices [{:answer/id #uuid "b51910a4-e37d-5c34-adb4-b2218d1f40f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437586} {:answer/id #uuid "5ab61bfa-dc48-58d5-a149-9bf36c574b83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437587}] :answer-field/correct {:answer/id #uuid "b51910a4-e37d-5c34-adb4-b2218d1f40f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437586} :answer-field/id #uuid "71947ae8-7e46-57cd-b733-f67a0fa6d76c" :answer-field/key "At every point $(x,y)$ where $x<1$ and $y<2,$ the slope of the slope field is positive" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438822} {:answer-field/choices [{:answer/id #uuid "ef92f4f0-8c00-55fd-a115-09eccb6fe714" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667892} {:answer/id #uuid "14479ff4-2e02-5757-a626-8fa703a63eee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667893}] :answer-field/correct {:answer/id #uuid "14479ff4-2e02-5757-a626-8fa703a63eee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667893} :answer-field/id #uuid "52c518f8-757a-57a1-b9fe-e5ced44e0f67" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668223}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dff46479-0340-5239-b8ff-db620f2c9a7a" :question/math-academy-id "q-119800" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=(1-x)(y-2)$ and its slope field. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, we define $f(x,y)=(1-x)(y-2).$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=1$ or $y=2.$ This divides the $xy$-plane into four regions, as shown below.\n\n![](images/47/47784a3201e93648e495827b12078073cc9f1a03cd3c11904a875bad10a3bde2.png)\n\nIf we compute the sign of $f(x,y)$ in each of those four regions (by considering some test points, for example), we get the following:\n\n![](images/73/73631c178777b4489e35fa87d08474ccf2b8b484b9bf5fe7272b1ce25d45f1b0.png)\n\nWith that in mind, let's check each statement:\n\n- Statement “At every point $(x,y)$ where $x<1$ and $y>2,$ the slope of the slope field is negative” is false. If $x<1$ and $y>2,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in this region.\n\n- Statement “At every point $(x,y)$ where $x>1$ and $y<2,$ the slope of the slope field is negative” is false. If $x>1$ and $y<2,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in this region.\n\n- Statement “At every point $(x,y)$ where $x<1$ and $y<2,$ the slope of the slope field is positive” is false. If $x<1$ and $y<2,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in this region.\n\nTherefore, the correct answer is \"None of those listed.\""} {:db/id #edb/ref 17592186253635 :knowledge-point/_questions [{:db/id #edb/ref 17592186166821 :knowledge-point/id #uuid "5277f56d-3f2d-505c-bf73-48207a2310a3" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using the Sign of the Slopes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "982cc208-4ef7-53b6-b14e-eddf19d4f7f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461893} {:answer/id #uuid "dc4796b3-871f-5f81-a235-937da5930fa1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461894}] :answer-field/correct {:answer/id #uuid "dc4796b3-871f-5f81-a235-937da5930fa1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461894} :answer-field/id #uuid "313eb125-e9e4-5cbd-b384-ea16df717365" :answer-field/key "${y}^{′}=\\frac{1}{10}(x+3)(x-2)^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462700} {:answer-field/choices [{:answer/id #uuid "cc9b1942-b0bc-54f8-a6c3-1ff051b6a113" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461895} {:answer/id #uuid "e858c129-3cbe-507d-9eca-9bb753521056" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461896}] :answer-field/correct {:answer/id #uuid "cc9b1942-b0bc-54f8-a6c3-1ff051b6a113" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461895} :answer-field/id #uuid "da434888-6e69-5683-b144-41c6022c0ca0" :answer-field/key "${y}^{′}=\\frac{1}{5}(x+3)(2-x)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462701} {:answer-field/choices [{:answer/id #uuid "2191303c-5047-5ef5-8284-5beaca1777ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461897} {:answer/id #uuid "6eab0a1c-68e9-523d-9519-74a67c6d7470" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461898}] :answer-field/correct {:answer/id #uuid "2191303c-5047-5ef5-8284-5beaca1777ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461897} :answer-field/id #uuid "bf290901-b724-5bf9-b2cb-39afaae04ac0" :answer-field/key "${y}^{′}=(x+2)(x-3)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462702} {:answer-field/choices [{:answer/id #uuid "b54c8ea8-62f7-5147-88e9-450bafa088a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667894} {:answer/id #uuid "8f39341a-ac00-547e-b5b1-99fdef6a439b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667895}] :answer-field/correct {:answer/id #uuid "b54c8ea8-62f7-5147-88e9-450bafa088a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667894} :answer-field/id #uuid "85e1c1b3-18dd-5bc7-b654-cb00d77cff85" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668224}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a07799d5-cf00-5be4-9950-028a4e658d3e" :question/math-academy-id "q-120038" :question/problem "![](images/f8/f855062048a7d38b2fa6c843701a182661b2235b2042ad83fbedd600b1dd770c.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\nSelect all that apply." :question/worked-solution "![](images/8f/8fdec9bda9e2bcc514e56a14a6608b2f0cb74fd0943a51c944b29cc047e02cd9.png)\n\nNotice the following properties of the given slope field:\n\n- First, the slopes of the slope field are horizontal along the lines $x=-3$ and $x=2.$ Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\n- Second, the lines $x=-3$ and $x=2$ divide the plane into $3$ regions. The sign of the slopes in each of the $3$ regions are easily deduced by considering the behavior of the solution curves in these regions. This information is summarized in the following table:\n\n| Region | $x<-3$ | $-3<x<2$ | $x>2$ |\n| --- | --- | --- | --- |\n| Slope | $↘$ | $↗$ | $↗$ |\n| Sign | $-$ | $+$ | $+$ |\n\nWith that in mind, let's consider each equation.\n\n- The equation ${y}^{′}=\\frac{1}{10}(x+3)(x-2)^{2}$ gives the required behavior.\n\n- The equation ${y}^{′}=\\frac{1}{5}(x+3)(2-x)$ does *not* give the required behavior. The right-hand side evaluates to zero at $x=-3$ and $x=2,$ but the sign of the slopes in the required regions (summarized below) do not correspond to the given slope field.\n\n| Region | $x<-3$ | $-3<x<2$ | $x>2$ |\n| --- | --- | --- | --- |\n| Slope | $↘$ | $↗$ | $↘$ |\n| Sign | $-$ | $+$ | $-$ |\n\n- The equation ${y}^{′}=(x+2)(x-3)$ does *not* give the required behavior. The right-hand side evaluates to zero at $x=-2$ and $x=3.$\n\nTherefore, the correct answer is ${y}^{′}=\\frac{1}{10}(x+3)(x-2)^{2}$ only."} {:db/id #edb/ref 17592186253648 :knowledge-point/_questions [{:db/id #edb/ref 17592186087746 :knowledge-point/id #uuid "d8c04b23-e341-57e9-a072-985e4b536e5a" :knowledge-point/title "Identifying Linear Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "533214b3-6c61-52ee-85dd-a8d6006ced54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461917} {:answer/id #uuid "23c15b20-858c-5295-90c6-68f113ba9d04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461918}] :answer-field/correct {:answer/id #uuid "533214b3-6c61-52ee-85dd-a8d6006ced54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461917} :answer-field/id #uuid "52121635-762f-5923-b01d-1582f7ea794d" :answer-field/key "$T(kv)=kT(v)$ for any real $2\\times 1$ column vector $v$ and real scalar $k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462712} {:answer-field/choices [{:answer/id #uuid "a7d6c812-7ee3-5e26-b033-2a4ef6caab4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461919} {:answer/id #uuid "eba0a9bc-d740-58d4-9682-e24f2ebd01d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461920}] :answer-field/correct {:answer/id #uuid "a7d6c812-7ee3-5e26-b033-2a4ef6caab4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461919} :answer-field/id #uuid "b222fe66-ffd9-5e28-8684-edf53b486030" :answer-field/key "$T({v}_{1}+{v}_{2})=T({v}_{1})+T({v}_{2})$ for any real $2\\times 1$ column vectors ${v}_{1}$ and ${v}_{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462713} {:answer-field/choices [{:answer/id #uuid "1921f4a9-2a50-5748-bfbb-ee6ebd7a5229" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461921} {:answer/id #uuid "2feb6598-cea3-599a-adb9-4e0e897d27ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461922}] :answer-field/correct {:answer/id #uuid "2feb6598-cea3-599a-adb9-4e0e897d27ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461922} :answer-field/id #uuid "79c1742e-b505-51ed-b84e-0e730cf0b35e" :answer-field/key "$T$ is **NOT** a linear transformation" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462714} {:answer-field/choices [{:answer/id #uuid "61b77aee-4838-5a9c-96f5-eeeb774fbd90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667896} {:answer/id #uuid "28e306c7-56ef-5e46-8682-7096284c3742" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667897}] :answer-field/correct {:answer/id #uuid "61b77aee-4838-5a9c-96f5-eeeb774fbd90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667896} :answer-field/id #uuid "8ad7d3c9-e10f-5b51-a15b-012aad4defbf" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668225}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a3a19c98-b506-54b2-aa6b-86aada819468" :question/math-academy-id "q-12012" :question/problem "Let \n$T:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}{x}^{2} \\\\ 7y\\end{bmatrix}.$\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A linear transformation $T$ satisfies two properties:\n\n$$\n\\begin{aligned} & T\\begin{bmatrix}kx \\\\ ky\\end{bmatrix}=kT\\begin{bmatrix}x \\\\ y\\end{bmatrix}, \\\\  & T\\begin{bmatrix}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{bmatrix}=T\\begin{bmatrix}{x}_{1} \\\\ {y}_{1}\\end{bmatrix}+T\\begin{bmatrix}{x}_{2} \\\\ {y}_{2}\\end{bmatrix}.\\end{aligned}\n$$\n\n- Checking the first condition, we have\n\n$$\n\\begin{aligned}T\\begin{bmatrix}kx \\\\ ky\\end{bmatrix} & =\\begin{bmatrix}(kx)^{2} \\\\ 7(ky)\\end{bmatrix} \\\\  & =\\begin{bmatrix}{k}^{2}({x}^{2}) \\\\ k(7y)\\end{bmatrix} \\\\  & =k\\begin{bmatrix}k({x}^{2}) \\\\ 7y\\end{bmatrix} \\\\  & \\ne kT\\begin{bmatrix}x \\\\ y\\end{bmatrix}.\\,\\times \\end{aligned}\n$$\n\nTherefore, $\\text{T}$ is not a linear transformation.\n\n- Checking the second condition, we have\n\n$$\n\\begin{aligned}T\\begin{bmatrix}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{bmatrix} & =\\begin{bmatrix}({x}_{1}+{x}_{2})^{2} \\\\ 7({y}_{1}+{y}_{2})\\end{bmatrix} \\\\  & =\\begin{bmatrix}{x}_{1}^{2}+{x}_{2}^{2}+2{x}_{1}{x}_{2} \\\\ 7{y}_{1}+7{y}_{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}{x}_{1}^{2} \\\\ 7{y}_{1}\\end{bmatrix}+\\begin{bmatrix}{x}_{2}^{2} \\\\ 7{y}_{2}\\end{bmatrix}+\\begin{bmatrix}2{x}_{1}{x}_{2} \\\\ 0\\end{bmatrix} \\\\  & =T\\begin{bmatrix}{x}_{1} \\\\ {y}_{1}\\end{bmatrix}+T\\begin{bmatrix}{x}_{2} \\\\ {y}_{2}\\end{bmatrix}+\\begin{bmatrix}2{x}_{1}{x}_{2} \\\\ 0\\end{bmatrix} \\\\  & \\ne T\\begin{bmatrix}{x}_{1} \\\\ {y}_{1}\\end{bmatrix}+T\\begin{bmatrix}{x}_{2} \\\\ {y}_{2}\\end{bmatrix}.\\,\\times \\end{aligned}\n$$\n\nAs a result, only statement “$T$ is **NOT** a linear transformation” is true."} {:db/id #edb/ref 17592186256748 :knowledge-point/_questions [{:db/id #edb/ref 17592186179723 :knowledge-point/id #uuid "2bc800b0-3901-5154-81ac-1ef853017320" :knowledge-point/title "Identifying Partitions of the Real Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27b20b3e-304f-5df6-8652-bce6edf26938" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462091} {:answer/id #uuid "489d1517-18d2-5e62-ba9d-deff93e291da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462092}] :answer-field/correct {:answer/id #uuid "489d1517-18d2-5e62-ba9d-deff93e291da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462092} :answer-field/id #uuid "aa7746cf-da4e-5bea-9ac8-a9cfe214feef" :answer-field/key "${-10,-9,-8,-4,-2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462799} {:answer-field/choices [{:answer/id #uuid "ff69bf31-c057-57e2-86a4-9ee808c23372" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462093} {:answer/id #uuid "91e66fa0-b75f-53ca-963d-a9fa01e18b82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462094}] :answer-field/correct {:answer/id #uuid "ff69bf31-c057-57e2-86a4-9ee808c23372" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462093} :answer-field/id #uuid "78ca3220-a686-585b-a4f6-89e0768fff3b" :answer-field/key "${-9,-5,-4,-2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462800} {:answer-fie