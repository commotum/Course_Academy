x}2 & ∗ \\\\ ∗ & ∗\\end{bmatrix} \\\\  & \\ne {I}_{2}.\\,\\times \\end{aligned}\n$$\n\nSo, statement $AB=BA={I}_{2}$ is false.\n\n- Now, we check whether $AC=CA={I}_{2}.$ Computing $AC$, we get\n\n$$\n\\begin{aligned}AC & =\\begin{bmatrix}-2 & 2 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ \\frac{1}{2} & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $CA$, we get\n\n$$\n\\begin{aligned}CA & =\\begin{bmatrix}0 & 1 \\\\ \\frac{1}{2} & 1\\end{bmatrix}\\begin{bmatrix}-2 & 2 \\\\ 1 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nSo, statement $AC=CA={I}_{2}$ is true. As a result, $C={A}^{-1}$ and statement $C={A}^{-1}$ is true too.\n\nTherefore, the correct answer is $AC=CA={I}_{2}$; $C={A}^{-1}$ only."} {:db/id #edb/ref 17592186237922 :knowledge-point/_questions [{:db/id #edb/ref 17592186087699 :knowledge-point/id #uuid "9b9ef325-2358-5041-8a8d-b459e8ed9f09" :knowledge-point/title "Determining the Inverse of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a10723d3-f77a-5b16-956e-675d06c9d2d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461219} {:answer/id #uuid "f4b5ac11-5a94-5e5a-a683-6eaa4e645176" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461220}] :answer-field/correct {:answer/id #uuid "f4b5ac11-5a94-5e5a-a683-6eaa4e645176" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461220} :answer-field/id #uuid "b422ac1d-59ce-5d06-b337-6b4fb303c18d" :answer-field/key "$AB=BA={I}_{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462363} {:answer-field/choices [{:answer/id #uuid "af232cd6-6074-5