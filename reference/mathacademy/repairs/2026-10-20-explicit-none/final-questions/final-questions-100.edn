/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461568}] :answer-field/correct {:answer/id #uuid "1eeeb0c6-e947-5a46-853c-7fd461e4302f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461567} :answer-field/id #uuid "3ce4146e-cec5-5999-9d67-968a8eaa2ccc" :answer-field/key "$v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =-4$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462537} {:answer-field/choices [{:answer/id #uuid "9aa54337-fcdd-5109-8378-f65593993973" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667836} {:answer/id #uuid "2bd2cf5e-98a1-54ff-b4a7-cb1413edfcc1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667837}] :answer-field/correct {:answer/id #uuid "9aa54337-fcdd-5109-8378-f65593993973" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667836} :answer-field/id #uuid "6cc7718d-1f8f-52a2-a949-21d9ea70b83e" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668195}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2c9bad97-e078-5fd9-8cb8-6324032501fd" :question/math-academy-id "q-109508" :question/problem "$$\nA=\\begin{bmatrix}-5 & -1 \\\\ 1 & -3\\end{bmatrix},\\,v=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A+4I:$\n\n$$\nA+4I=\\begin{bmatrix}-5 & -1 \\\\ 1 & -3\\end{bmatrix}+4\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-1 & -1 \\\\ 1 & 1\\end{bmatrix}\n$$\n\n- Next, we find the image of $v$ under the action of $A+4I:$\n\n$$\n(A+4I)v=\\begin{bmatrix}-1 & -1 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}=\\underbrace{\\begin{bmatrix}-4 \\\\ 4\\end{bmatrix}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A+4I:$\n\n$$\n(A+4I)w=\\begin{bmatrix}-1 & -1 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}-4 \\\\ 4\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n\\underbrace{\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}}_{v}\\overset{A+4I\\,}{\\to }\\underbrace{\\begin{bmatrix}-4 \\\\ 4\\end{bmatrix}}_{w}\\overset{A+4I\\,}{\\to }\\underbrace{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{0}\n$$\n\nHere, we see that $A+4I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-4$ of $A.$*\n\nSo, the correct answer is “$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-4$ of $A$” only."} {:db/id #edb/ref 17592186247000 :knowledge-point/_questions [{:db/id #edb/ref 17592186152224 :knowledge-point/id #uuid "a0abad78-e492-5d09-a04d-bce54605c78c" :knowledge-point/title "Identifying Generalized Eigenvectors of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea90c8f5-d8b6-530a-bd3a-55a8a95477ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461569} {:answer/id #uuid "7f02e0f9-4218-50d0-8f74-b3bbce2ccd63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461570}] :answer-field/correct {:answer/id #uuid "7f02e0f9-4218-50d0-8f74-b3bbce2ccd63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461570} :answer-field/id #uuid "f3f48a61-a618-59bf-8258-975fc6843f3b" :answer-field/key "$v$ is an eigenvector corresponding to the eigenvalue $\\lambda =10$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462538} {:answer-field/choices [{:answer/id #uuid "268560d4-b12d-5c37-99f7-f084e893cfe6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461571} {:answer/id #uuid "ce284464-387a-52cf-9b51-1039384e97be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461572}] :answer-field/correct {:answer/id #uuid "268560d4-b12d-5c37-99f7-f084e893cfe6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461571} :answer-field/id #uuid "3c3c14b8-856f-5418-9438-2d823e014acb" :answer-field/key "$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =10$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462539} {:answer-field/choices [{:answer/id #uuid "a846bae0-2fb9-5cb8-9fae-ae7d4b22827f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461573} {:answer/id #uuid "7746f0e1-4798-5728-b7c7-4ff377910040" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461574}] :answer-field/correct {:answer/id #uuid "7746f0e1-4798-5728-b7c7-4ff377910040" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461574} :answer-field/id #uuid "c835039c-460a-5ea4-ab26-b6657a44f5dc" :answer-field/key "$v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =10$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462540} {:answer-field/choices [{:answer/id #uuid "6d6be7c5-bd49-5de6-bc92-263a56bc8e92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667838} {:answer/id #uuid "170562bd-b639-5aa7-ae3a-b987f9f39020" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667839}] :answer-field/correct {:answer/id #uuid "6d6be7c5-bd49-5de6-bc92-263a56bc8e92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667838} :answer-field/id #uuid "a167dfc0-67fe-5006-bb49-2333353a774f" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668196}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a35e1aa3-c186-545a-9105-317f752c0d95" :question/math-academy-id "q-109517" :question/problem "$$\nA=\\begin{bmatrix}12 & -1 \\\\ 4 & 8\\end{bmatrix},\\,v=\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A-10I:$\n\n$$\nA-10I=\\begin{bmatrix}12 & -1 \\\\ 4 & 8\\end{bmatrix}-10\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}2 & -1 \\\\ 4 & -2\\end{bmatrix}\n$$\n\nNext, we find the image of $v$ under the action of $A-10I:$\n\n$$\n(A-10I)v=\\begin{bmatrix}2 & -1 \\\\ 4 & -2\\end{bmatrix}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}=0\n$$\n\nSo, we obtain the following map:\n\n$$\n\\underbrace{\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}}_{v}\\overset{\\,A-10I\\,\\,}{\\to }\\underbrace{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{0}\n$$\n\n \n\nHere, we see that $A-10I$ maps $v$ to $0$ in $1$ step.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $1$ (a.k.a. an eigenvector) corresponding to the eigenvalue  $\\lambda =10$ of $A.$*\n\nSo, the correct answer is “$v$ is an eigenvector corresponding to the eigenvalue $\\lambda =10$ of $A$”; “$v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =10$ of $A$” only."} {:db/id #edb/ref 17592186247001 :knowledge-point/_questions [{:db/id #edb/ref 17592186152226 :knowledge-point/id #uuid "76e60bc4-ae61-5c39-ad80-14e0cdab14da" :knowledge-point/title "Identifying Generalized Eigenvectors of a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a25c4edf-bc28-5a6d-bce8-dc691f40f46d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461575} {:answer/id #uuid "b25784ef-0104-536a-b0f5-9202aac0e151" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461576}] :answer-field/correct {:answer/id #uuid "a25c4edf-bc28-5a6d-bce8-dc691f40f46d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :