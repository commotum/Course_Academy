db/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667936} {:answer/id #uuid "762bcf67-766f-5890-8998-e6a015db73c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667937}] :answer-field/correct {:answer/id #uuid "cea9d44a-5148-5f01-a7a8-00c3ad80c414" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667936} :answer-field/id #uuid "c6a04851-1238-5fde-88f8-ea2c153dd32c" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668245}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e545d245-a492-553a-a767-4497215c21cb" :question/math-academy-id "q-129176" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y={2}^{x}?$ \n\nSelect all that apply." :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nWith that in mind, let's take a look at each interval.\n\n- The interval $(0,10]$ is not closed, so the extreme value theorem is not applicable.\n\n- The interval $[0,10]$ is closed, and the function is continuous on $[0,10].$ Therefore, the extreme value theorem is applicable.\n\n- The interval $(0,\\infty )$ is not closed, so the extreme value theorem is not applicable.\n\nIn conclusion, the correct answer is $[0,10]$ only."} {:db/id #edb/ref 17592186262989 :knowledge-point/_questions [{:db/id #edb/ref 17592186175903 :knowledge-point/id #uuid "3bbc6a2d-2078-50d5-9584-c705c19212da" :knowledge-point/title "Identifying Intervals on Which a Given Function Satisfies the Extreme Value Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be60b44c-dc29-579a-8bbe