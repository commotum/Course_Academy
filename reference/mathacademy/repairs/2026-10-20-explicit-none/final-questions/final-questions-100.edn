 {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438794} {:answer-field/choices [{:answer/id #uuid "6c32cce3-0106-5213-a862-d30a09f97c34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437532} {:answer/id #uuid "eb00188a-471c-5bea-ac37-3dce741e8fa3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437533}] :answer-field/correct {:answer/id #uuid "6c32cce3-0106-5213-a862-d30a09f97c34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437532} :answer-field/id #uuid "8669b21d-34a9-51aa-abeb-f8498fec2f92" :answer-field/key "![Graph IV](images/c5/c5cffff53444f06cd486e69ad129a308aef50984a9c0ce8e2f2ef25996cd6c28.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438795} {:answer-field/choices [{:answer/id #uuid "4773d11f-46f5-5514-a920-083a58a75506" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667816} {:answer/id #uuid "cd7b6d11-9b66-579b-8c9b-4d0f83496896" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667817}] :answer-field/correct {:answer/id #uuid "4773d11f-46f5-5514-a920-083a58a75506" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667816} :answer-field/id #uuid "d44c8cfa-6c90-580b-baab-ead07274ac28" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668185}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1b86aaf3-f04f-5a9d-8491-875b7ee69bad" :question/math-academy-id "q-108605" :question/problem "Which of the graphs below correspond to an invertible function?\n\nSelect all that apply." :question/worked-solution "A function is invertible if and only if it's a one-to-one function. To determine which of the functions are one-to-one, we use the horizontal line test.\n\nFrom the above, we see that:\n\n- For graph II, any horizontal line will intersect the curve at most once, no matter where we draw the line. Therefore, graph II shows a one-to-one function. As a result, this function is invertible.\n\n- For graphs I, III, and IV, some horizontal lines intersect the curve more than once. These are not one-to-one functions. As a result, they are not invertible."} {:db/id #edb/ref 17592186244192 :knowledge-point/_questions [{:db/id #edb/ref 17592186147456 :knowledge-point/id #uuid "eef27d2b-6149-5070-b711-f4dcc7db2a03" :knowledge-point/title "Identifying Bernoulli Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a2b16ff-480b-5920-a02a-3a1113084ec6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461503} {:answer/id #uuid "bb654b6e-18b2-515f-a240-33d5be06024d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461504}] :answer-field/correct {:answer/id #uuid "1a2b16ff-480b-5920-a02a-3a1113084ec6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461503} :answer-field/id #uuid "0248c736-0f29-5188-901a-4d4aa3e4ae2c" :answer-field/key "${y}^{′}+{x}^{-2}{y}^{3}=\\operatorname{sin}⁡y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462505} {:answer-field/choices [{:answer/id #uuid "bac7a93d-d937-5618-80f7-910f2907cb9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461505} {:answer/id #uuid "6e24f40f-1611-5210-9da6-6cf12584dfe2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461506}] :answer-field/correct {:answer/id #uuid "6e24f40f-1611-5210-9da6-6cf12584dfe2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461506} :answer-field/id #uuid "69ef8d6f-1e8a-5807-9ad5-6be9ec18aef6" :answer-field/key "${y}^{′}-{e}^{x}y={x}^{2}{y}^{5}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462506} {:answer-field/choices [{:answer/id #uuid "399fd328-0dff-5b83-ad3e-6eadc53264ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461507} {:answer/id #uuid "f13ba9c6-fd30-5e83-986a-34fb441fe34e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461508}] :answer-field/correct {:answer/id #uuid "399fd328-0dff-5b83-ad3e-6eadc53264ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461507} :answer-field/id #uuid "c969fdd5-7a1f-5912-a7b8-46f92b36dfbd" :answer-field/key "${y}^{′}+{y}^{4}\\operatorname{ln}⁡x=-x{y}^{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462507} {:answer-field/choices [{:answer/id #uuid "6e3f9c1e-1a09-5df9-a906-a64fc9ab17fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667818} {:answer/id #uuid "9ac39937-5378-555c-9f02-4f1a4805f23f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667819}] :answer-field/correct {:answer/id #uuid "6e3f9c1e-1a09-5df9-a906-a64fc9ab17fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667818} :answer-field/id #uuid "360ead95-9f68-56b2-94da-45b9ffa83ea6" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668186}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bc73c612-2a32-5b85-8989-8b463754a48c" :question/math-academy-id "q-108913" :question/problem "Which of the following equations is a Bernoulli differential equation?\n\nSelect all that apply." :question/worked-solution "A Bernoulli differential equation has the form\n\n$$\n\\frac{dy}{dx}+p(x)y=q(x){y}^{n},\n$$\n\nwhere $n$ is a real number.\n\nWith that in mind, let's examine the given options.\n\n- Equation ${y}^{′}+{x}^{-2}{y}^{3}=\\operatorname{sin}⁡y$ is *not* a Bernoulli differential equation. It is missing both the $p(x)y$ and $q(x){y}^{n}$ terms.\n\n- Equation ${y}^{′}-{e}^{x}y={x}^{2}{y}^{5}$ is a Bernoulli differential equation. In this case, we have\n\n$$\np(x)=-{e}^{x},\\,q(x)={x}^{2},\\,n=5.\n$$\n\n- Equation ${y}^{′}+{y}^{4}\\operatorname{ln}⁡x=-x{y}^{3}$ is *not* a Bernoulli differential equation. It is missing the $p(x)y$ term.\n\nTherefore, the correct answer is ${y}^{′}-{e}^{x}y={x}^{2}{y}^{5}$ only."} {:db/id #edb/ref 17592186244193 :knowledge-point/_questions [{:db/id #edb/ref 17592186147456 :knowledge-point/id #uuid "eef27d2b-6149-5070-b711-f4dcc7db2a03" :knowledge-point/title "Identifying Bernoulli Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4188ff28-f5eb-597b-bef2-216186195b37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461509} {:answer/id #uuid "8c7a7e04-5442-58d1-a701-5ba3498e1a2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/re