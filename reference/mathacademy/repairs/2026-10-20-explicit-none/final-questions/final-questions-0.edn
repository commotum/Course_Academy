d #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459852}] :answer-field/correct {:answer/id #uuid "192fb319-480e-5a3f-bc8b-a5bec8b0c334" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459851} :answer-field/id #uuid "fca5cf1d-3106-5e01-b467-cfe14762ca39" :answer-field/key "![Diagram III](images/90/902a485b7c5d2c3fd940b06123ee5316fb74b5e2a2d969b7bf0562fb15cf1a58.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460792} {:answer-field/choices [{:answer/id #uuid "f3e1b17f-e8fa-5a3e-a96a-2879505ef308" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668038} {:answer/id #uuid "3d8551f2-109b-5c0d-be41-ddc4ffa5584d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668039}] :answer-field/correct {:answer/id #uuid "f3e1b17f-e8fa-5a3e-a96a-2879505ef308" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668038} :answer-field/id #uuid "29fdfb15-2502-5efc-863d-acbab7f6a3ac" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668296}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "99d3ff8e-37f2-5365-be21-7d8861823943" :question/math-academy-id "q-35595" :question/problem "Which of the diagrams shown below represent subspaces of ${R}^{2}$ or ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Let's analyze each diagram in turn.\n\n- Diagram I does not represent a subspace. The origin $0=\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}$ clearly lies outside the subset.\n\n- Diagram II represents the origin $0=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}\\,,\\,$ which is considered a special (trivial) subspace of ${R}^{2}.$\n\n- Diagram III represents a line that does not pass through the origin. But every subspace must contain the origin, so the line in Diagram III is not a subspace of ${R}^{3}.$\n\nSo, the correct answer is diagram II only"}]
