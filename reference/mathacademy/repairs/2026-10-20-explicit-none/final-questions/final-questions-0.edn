db/id #edb/ref 17592186460160}] :answer-field/correct {:answer/id #uuid "606315b7-0138-573f-8c5f-15212b7196f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460159} :answer-field/id #uuid "6e9cb025-b523-5afd-9e2b-488c18701756" :answer-field/key "$g(x)$ has a removable discontinuity at $x=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460946} {:answer-field/choices [{:answer/id #uuid "021ed5ec-30ec-573d-b233-f37d36e3315a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668102} {:answer/id #uuid "0245a861-eaef-536c-b0f9-8dae433bd52c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668103}] :answer-field/correct {:answer/id #uuid "021ed5ec-30ec-573d-b233-f37d36e3315a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668102} :answer-field/id #uuid "54c59900-36a5-50a1-a923-6618e8439e09" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668328}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "de45d0f1-1f5a-51b7-a854-73bfcba5bbdc" :question/math-academy-id "q-71181" :question/problem "Given that \n\n$$\n\\begin{aligned}g(x) & ={\\begin{aligned}5x-5, & x<1 \\\\ 0, & x=1 \\\\ {x}^{3}-1, & x>1\\end{aligned}\\end{aligned}\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's check our continuity conditions:\n\n- $g(1)=0$ exists $\\,✓$\n\n- The left and right-sided limits are\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,{1}^{-}}g(x) & ={lim}_{x\\to \\,{1}^{-}}(5x-5)=5(1)-5=0, \\\\ {lim}_{x\\to \\,{1}^{+}}g(x) & ={lim}_{x\\to \\,{1}^{+}}({x}^{3}-1)={1}^{3}-1=0.\\end{aligned}\n$$\n\nSince the left and right-sided limits are equal, we conclude that statement ${lim}_{x\\to {1}^{+}}g(x)={lim}_{x\\to {1}^{-}}g(x)$ is true and\n\n$$\n{lim}_{x\\to 1}g(x)=0.\\,\\,✓\n$$\n\n- The value of the limit is ${lim}_{x\\to 1}g(x)=0,$ and the value of the function is $g(1)=0.$ So, statement ${lim}_{x\\to 1}g(x)=g(1)$ is true and\n\n$$\n{lim}_{x\\to 1}g(x)=g(1)\\,\\,✓\n$$\n\nSo, the function is continuous at $x=0,$ and statement “$g(x)$ has a removable discontinuity at $x=1$” is false.\n\nIn conclusion, only statements ${lim}_{x\\to {1}^{+}}g(x)={lim}_{x\\to {1}^{-}}g(x)$ and ${lim}_{x\\to 1}g(x)=g(1)$ are true."} {:db/id #edb/ref 17592186134055 :knowledge-point/_questions [{:db/id #edb/ref 17592186133870 :knowledge-point/id #uuid "c2bcfcb6-8f8b-5aa9-8346-05db880fa5bb" :knowledge-point/title "Determining Whether a Set of Polynomials is Orthogonal With Respect to a Given Inner Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "503d7110-6cc5-5cf2-87e2-1045c8a36886" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459341} {:answer/id #uuid "d57ce771-3028-5baa-b0f2-f4de7d3617d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459342}] :answer-field/correct {:answer/id #uuid "d57ce771-3028-5baa-b0f2-f4de7d3617d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459342} :answer-field/id #uuid "1af3661f-6783-5478-b5e6-eede91cb4aa6" :answer-field/key "${p}_{1}(t)⊥{p}_{2}(t)$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460537} {:answer-field/choices [{:answer/id #uuid "9564e0ca-db68-5b0e-bdf8-c5593c07408e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459343} {:answer/id #uuid "fdd76439-cdc4-56b2-bd84-3cb9d3bce0cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459344}] :answer-field/correct {:answer/id #uuid "fdd76439-cdc4-56b2-bd84-3cb9d3bce0cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459344} :answer-field/id #uuid "80d76efe-3861-569a-b729-ec393ecd874e" :answer-field/key "${p}_{1}(t)⊥̸{p}_{3}(t)$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460538} {:answer-field/choices [{:answer/id #uuid "60137c2c-ff15-5a99-a0a7-4cfa1f1442f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459345} {:answer/id #uuid "cff078f1-3b0f-5053-b2a0-745dbd7d061e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459346}] :answer-field/correct {:answer/id #uuid "60137c2c-ff15-5a99-a0a7-4cfa1f1442f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459345} :answer-field/id #uuid "ec498012-39b0-5787-b344-2b214924c219" :answer-field/key "$S=\\{{p}_{1}(t),{p}_{2}(t),{p}_{3}(t)\\}$ is an orthogonal set with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460539} {:answer-field/choices [{:answer/id #uuid "a951e8ed-a7bf-5541-ad43-5d515c1a2253" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667768} {:answer/id #uuid "5cf20ff5-5786-547f-9365-b74a4a517a90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667769}] :answer-field/correct {:answer/id #uuid "a951e8ed-a7bf-5541-ad43-5d515c1a2253" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667768} :answer-field/id #uuid "700cedce-16d4-541e-91a1-5429a27939c8" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668161}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "97d43a34-aeb6-5e6a-8281-47dcdcd73020" :question/math-academy-id "q-100128" :question/problem "Consider the following set of polynomials:\n\n$$\n{p}_{1}(t)=2t,\\,{p}_{2}(t)=t+1,\\,{p}_{3}(t)=2t+1.\n$$\n\nGiven that the inner product in the vector space ${R}_{1}[t]$ of polynomials of degree at most $1$ in the variable $t$ is defined as \n\n$$\n⟨p(t),q(t)⟩=p(0)q(0)+p(-1)q(-1),\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that a set of vectors in an inner product space is orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement “${p}_{1}(t)⊥{p}_{2}(t)$ with respect to the given inner product” is true. Indeed, we have\n\n$$\n\\begin{aligned}⟨{p}_{1}(t),{p}_{2}(t)⟩ & =⟨2t,t+1⟩ \\\\  & =(2t){|}_{0}\\cdot (t+1){|}_{0}+(2t){|}_{-1}\\cdot (t+1){|}_{-1} \\\\  & =2(0)\\cdot (0+1)+2(-1)\\cdot ((-1)+1) \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${p}_{1}(t)⊥{p}_{2}(t)$ with respect to the given inner product.\n\n- Statement “${p}_{1}(t)⊥̸{p}_{3}(t)$ with respect to the given inner product” is true since\n\n$$\n\\begin{aligned}⟨{p}_{1}(t),{p}_{3}(t)⟩ & =⟨2t,2t+1⟩ \\\\  & =(2t){|}_{0}\\cdot (2t+1){|}_{0}+(2t){|}_{-1}\\cdot (2t+1){|}_{-1} \\\\  & =2(0)\\cdot (2(0)+1)+2(-1)\\cdot (2(-1)+1) \\\\  & =2\\ne 0,\\end{aligned}\n$$\n\nwhich means that ${p}_{1}(t)⊥̸{p}_{3}(t)$ with respect to the given inner product.\n\n- Statement “$S=\\{{p}_{1}(t),{p}_{2}(t),{p}_{3}(t)\\}$ is an orthogonal set with respect to the given inner product” is false. Since ${p}_{1}(t)⊥̸{p}_{3}(t),$ the set $S$ is *not* orthogonal.\n\nTherefore, the correct answer is “${p}_{1}(t)⊥{p}_{2}(t)$ with respect to the given inner product”; “${p}_{1}(t)⊥̸{p}_{3}(t)$ with respect to the given inner product” only."} {:db/id #edb/ref 17592186134229 :knowledge-point/_questions [{:db/id #edb/ref 17592186133778 :knowledge-point/id #uuid "7b03ea89-5152-5ff4-813a-ca985d60ed5b" :knowledge-point/title "Identifying True Statements About Orthogonality"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c70e775-e2ea-5880-9766-a759863e80f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459945} {:answer/id #uuid "bd18d096-0ce7-5f4c-89c9-2427688240d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459946}] :answer-field/correct {:answer/id #uuid "bd18d096-0ce7-5f4c-89c9-2427688240d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459946} :answer-field/id #uuid "dd285e45-1587-5995-8414-eb1c2ea5950c" :answer-field/key "$u⊥H,\\,$ where $H={\\begin{bmatrix}2 \\\\ -1 \\\\ -3\\end{bmatrix},\\begin{bmatrix}-4 \\\\ -1 \\\\ 3\\end{bmatrix}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460839} {:answer-field/choices [{:answer/id #uuid "5241e690-f33a-54a5-93ed-5931af0130f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459947} {:answer/id #uuid "018ac307-36aa-5934-8c04-ba6821becb4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459948}] :answer-field/correct {:answer/id #uuid "5241e690-f33a-54a5-93ed-5931af0130f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459947} :answer-field/id #uuid "aa8089e8-1efa-54cb-b513-323981c5c513" :answer-field/key "$u⊥V,\\,$ where $V={\\begin{bmatrix}5 \\\\ 2 \\\\ -3\\end{bmatrix},\\begin{bmatrix}1 \\\\ -4 \\\\ -2\\end{bmatrix},\\begin{bmatrix}3 \\\\ -4 \\\\ -5\\end{bmatrix}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460840} {:answer-field/choices [{:answer/id #uuid "a709466b-e806-5a2b-a8e5-ce3b8a71f657" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459949} {:answer/id #uuid "f8f735b1-c60f-50bf-a2f5-a892299f3d54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459950}] :answer-field/correct {:answer/id #uuid "f8f735b1-c60f-50bf-a2f5-a892299f3d54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459950} :answer-field/id #uuid "1be6f333-0eca-51dc-8a15-10b5dc865754" :answer-field/key "$u⊥W,\\,$ where $W={\\begin{bmatrix}-3 \\\\ 5 \\\\ 8\\end{bmatrix},\\begin{bmatrix}2 \\\\ 4 \\\\ 2\\end{bmatrix}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460841} {:answer-field/choices [{:answer/id #uuid "e4c412e9-e615-550c-b531-9153a0f347ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668062} {:answer/id #uuid "c4aed7ff-6349-5517-8cc2-d8dbc519394b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668063}] :answer-field/correct {:answer/id #uuid "e4c412e9-e615-550c-b531-9153a0f347ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668062} :answer-field/id #uuid "5a8371fc-1b1e-5762-bb7f-619f41772374" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668308}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2175cca2-c03f-5359-9970-f5c376ea77b9" :question/math-academy-id "q-39630" :question/problem "For the vector $u=\\begin{bmatrix}-1 \\\\ 1 \\\\ -1\\end{bmatrix}$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's denote the vectors of $H,V$ and $W$ as ${{h}_{1},{h}_{2}},{{v}_{1},{v}_{2},{v}_{3}}$ and ${{w}_{1},{w}_{2}}$, respectively. \n\nNow, we have to compute the dot product between $u$ and the vectors in each set. \n\n- For the set $H:$\n\n$$\n\\begin{aligned}u\\cdot {h}_{1} & =(-1)\\cdot 2+1\\cdot (-1)+(-1)\\cdot (-3)=0 & ✓ \\\\ u\\cdot {h}_{2} & =(-1)\\cdot (-4)+1\\cdot (-1)+(-1)\\cdot 3=0 & ✓\\end{aligned}\n$$\n\nSo, $u⊥H.$\n\n- For the set $V:$\n\n$$\n\\begin{aligned}u\\cdot {v}_{1} & =(-1)\\cdot 5+1\\cdot 2+(-1)\\cdot (-3)=0 & ✓ \\\\ u\\cdot {v}_{2} & =(-1)\\cdot 1+1\\cdot (-4)+(-1)\\cdot (-2)=-3\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $u⊥̸V.$ Notice that we stopped after finding the first non-orthogonal vector in the set.\n\n- For the set $W:$\n\n$$\n\\begin{aligned}u\\cdot {w}_{1} & =(-1)\\cdot (-3)+1\\cdot 5+(-1)\\cdot 8=0 & ✓ \\\\ u\\cdot {w}_{2} & =(-1)\\cdot 2+1\\cdot 4+(-1)\\cdot 2=0 & ✓\\end{aligned}\n$$\n\nSo, $u⊥W.$\n\nTherefore, the correct answer is, “$u⊥H,\\,$ where $H={\\begin{bmatrix}2 \\\\ -1 \\\\ -3\\end{bmatrix},\\begin{bmatrix}-4 \\\\ -1 \\\\ 3\\end{bmatrix}}$”; “$u⊥W,\\,$ where $W={\\begin{bmatrix}-3 \\\\ 5 \\\\ 8\\end{bmatrix},\\begin{bmatrix}2 \\\\ 4 \\\\ 2\\end{bmatrix}}$” only."} {:db/id #edb/ref 17592186134286 :knowledge-point/_questions [{:db/id #edb/ref 17592186133843 :knowledge-point/id #uuid "ee1838df-f1d6-5bc4-908c-b96e2ad577c9" :knowledge-point/title "Determining Whether Sets are Orthogonal"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d41eb58-a65e-56a5-9117-5205ed521c04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477295} {:answer/id #uuid "614d31b7-430f-5330-9830-17e68125321c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477296}] :answer-field/correct {:answer/id #uuid "614d31b7-430f-5330-9830-17e68125321c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477296} :answer-field/id #uuid "d497ca69-614a-5476-b4f7-ea420e1aea47" :answer-field/key "$U={\\begin{bmatrix}5 \\\\ -1\\end{bmatrix},\\begin{bmatrix}1 \\\\ 5\\end{bmatrix}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477617} {:answer-field/choices [{:answer/id #uuid "db9ff70b-8a47-5900-9f7c-85621fec1e70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477297} {:answer/id #uuid "2e9c0da7-a4f3-51cf-b560-3fd6913d8c18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477298}] :answer-field/correct {:answer/id #uuid "db9ff70b-8a47-5900-9f7c-85621fec1e70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477297} :answer-field/id #uuid "f3f87861-7334-555b-b5d5-73b1a9086a27" :answer-field/key "$V={\\begin{bmatrix}1 \\\\ -1\\end{bmatrix},\\begin{bmatrix}1 \\\\ 0\\end{bmatrix},\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477618} {:answer-field/choices [{:answer/id #uuid "3e172dd6-8a6e-5feb-9f4a-b7632263774d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477299} {:answer/id #uuid "9cd763a3-751b-5cd2-a223-ced10b4486f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477300}] :answer-field/correct {:answer/id #uuid "9cd763a3-751b-5cd2-a223-ced10b4486f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477300} :answer-field/id #uuid "dbda19e6-aa51-5ebe-8932-291b89c0b589" :answer-field/key "$W={\\begin{bmatrix}4 \\\\ 0 \\\\ -1\\end{bmatrix},\\begin{bmatrix}1 \\\\ 0 \\\\ 4\\end{bmatrix}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477619} {:answer-field/choices [{:answer/id #uuid "aca2ff40-9885-53ab-8c0b-c3eff2830129" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668066} {:answer/id #uuid "9ced0437-020d-551a-8d88-7a40bad2aed3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668067}] :answer-field/correct {:answer/id #uuid "aca2ff40-9885-53ab-8c0b-c3eff2830129" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668066} :answer-field/id #uuid "4b63d39b-da24-5dd7-8384-437db025043b" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668310}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e9044d8e-a639-50ef-a904-30bfb3f37874" :question/math-academy-id "q-40400" :question/problem "Which of the following sets are orthogonal?\n\nSelect all that apply." :question/worked-solution "Let's denote the vectors of the given sets as \n${{u}_{1},{u}_{2}},$ \n${{v}_{1},{v}_{2},{v}_{3}},$ and \n${{w}_{1},{w}_{2}},$ respectively. \n\nThe sets $U,V,$ and $W$ are orthogonal if the following conditions on each set hold:\n\n- ${u}_{1}\\cdot {u}_{2}=0.$\n\n- ${v}_{1}\\cdot {v}_{2}=0,\\,{v}_{1}\\cdot {v}_{3}=0,\\,{v}_{2}\\cdot {v}_{3}=0.$\n\n- ${w}_{1}\\cdot {w}_{2}=0.$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get the following:\n\n$$\n\\begin{aligned}{u}_{1}\\cdot {u}_{2} & =\\begin{bmatrix}5 \\\\ -1\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 5\\end{bmatrix}=5-5=0 & ✓\\end{aligned}\n$$\n\nSo, the set $U$ is orthogonal.\n\n- The set $V$ cannot be orthogonal since it contains  $3$ vectors from ${R}^{2}$ (in which we can have an orthogonal set with at most $2$ non-zero vectors). So, $V$ is not an orthogonal set.\n\n- For the set $W,$ we get the following:\n\n$$\n\\begin{aligned}{w}_{1}\\cdot {w}_{2} & =\\begin{bmatrix}4 \\\\ 0 \\\\ -1\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 0 \\\\ 4\\end{bmatrix}=4+0-4=0 & ✓\\end{aligned}\n$$\n\nSo, the set $W$ is orthogonal.\n\nTherefore, we conclude that the correct answer is \"$U$ and $W$ only\"."} {:db/id #edb/ref 17592186134559 :knowledge-point/_questions [{:db/id #edb/ref 17592186133870 :knowledge-point/id #uuid "c2bcfcb6-8f8b-5aa9-8346-05db880fa5bb" :knowledge-point/title "Determining Whether a Set of Polynomials is Orthogonal With Respect to a Given Inner Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "222f50fb-1e6d-551e-968f-50c73844d197" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460507} {:answer/id #uuid "44a1d641-30a1-5670-a624-6e0d0235945d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460508}] :answer-field/correct {:answer/id #uuid "44a1d641-30a1-5670-a624-6e0d0235945d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460508} :answer-field/id #uuid "ea3a75a2-870e-5fbf-8b32-79ded3135f76" :answer-field/key "${p}_{1}(t)⊥{p}_{2}(t)$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461120} {:answer-field/choices [{:answer/id #uuid "28c286fa-b1fe-5de9-9f3d-391b223d89db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460509} {:answer/id #uuid "883078f4-006a-5c5e-95a5-6b76ce41b72a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460510}] :answer-field/correct {:answer/id #uuid "883078f4-006a-5c5e-95a5-6b76ce41b72a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460510} :answer-field/id #uuid "74b55017-3ba1-5628-9f41-22f729dadf78" :answer-field/key "${p}_{1}(t)⊥{p}_{3}(t)$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461121} {:answer-field/choices [{:answer/id #uuid "95223db9-c430-5634-a8b3-9b3aac9bcfe1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460511} {:answer/id #uuid "ae12af06-acfb-53ad-8b5c-db8297ba04cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460512}] :answer-field/correct {:answer/id #uuid "95223db9-c430-5634-a8b3-9b3aac9bcfe1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460511} :answer-field/id #uuid "7391ba90-c816-58f9-9ce4-2f0c7949edd2" :answer-field/key "$S=\\{{p}_{1}(t),{p}_{2}(t),{p}_{3}(t)\\}$ is an orthogonal set with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461122} {:answer-field/choices [{:answer/id #uuid "a5786ee9-7283-547c-9b34-7fa5c5774b17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668148} {:answer/id #uuid "58064ab2-438f-5fb3-a5cc-436945951e61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668149}] :answer-field/correct {:answer/id #uuid "a5786ee9-7283-547c-9b34-7fa5c5774b17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668148} :answer-field/id #uuid "135f4522-c5d7-50d1-a7d8-f1dcdd1e4ef2" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668351}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5292a809-1b54-5803-b4fb-793edab32841" :question/math-academy-id "q-98522" :question/problem "Consider the following set of polynomials:\n\n$$\n{p}_{1}(t)=t,\\,{p}_{2}(t)=t-1,\\,{p}_{3}(t)=2t-2.\n$$\n\nGiven that the inner product in the vector space ${R}_{1}[t]$ of polynomials of degree at most $1$ in the variable $t$ is defined as \n\n$$\n⟨p(t),q(t)⟩=p(0)q(0)+p(1)q(1),\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that a set of vectors in an inner product space is orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement “${p}_{1}(t)⊥{p}_{2}(t)$ with respect to the given inner product” is true. Indeed, we have\n\n$$\n\\begin{aligned}⟨{p}_{1}(t),{p}_{2}(t)⟩ & =⟨t,t-1⟩ \\\\  & =(t){|}_{0}\\cdot (t-1){|}_{0}+(t){|}_{1}\\cdot (t-1){|}_{1} \\\\  & =0\\cdot (0-1)+1\\cdot (1-1) \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${p}_{1}(t)⊥{p}_{2}(t)$ with respect to the given inner product.\n\n- Statement “${p}_{1}(t)⊥{p}_{3}(t)$ with respect to the given inner product” is true. Indeed, we have\n\n$$\n\\begin{aligned}⟨{p}_{1}(t),{p}_{3}(t)⟩ & =⟨t,2t-2⟩ \\\\  & =(t){|}_{0}\\cdot (2t-2){|}_{0}+(t){|}_{1}\\cdot (2t-2){|}_{1} \\\\  & =0\\cdot (2(0)-2)+1\\cdot (2(1)-2) \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${p}_{1}(t)⊥{p}_{3}(t)$ with respect to the given inner product.\n\n- Statement “$S=\\{{p}_{1}(t),{p}_{2}(t),{p}_{3}(t)\\}$ is an orthogonal set with respect to the given inner product” is false. Let's check if ${p}_{2}(t)⊥{p}_{3}(t).$ Computing the inner product, we have\n\n$$\n\\begin{aligned}⟨{p}_{2}(t),{p}_{3}(t)⟩ & =⟨t-1,2t-2⟩ \\\\  & =(t-1){|}_{0}\\cdot (2t-2){|}_{0}+(t-1){|}_{1}\\cdot (2t-2){|}_{1} \\\\  & =(0-1)\\cdot (2(0)-2)+(1-1)\\cdot (2(1)-2) \\\\  & =2\\ne 0,\\end{aligned}\n$$\n\nwhich means that ${p}_{2}(t)⊥̸{p}_{3}(t)$ with respect to the given inner product. So, $S$ is *not* orthogonal.\n\nTherefore, the correct answer is “${p}_{1}(t)⊥{p}_{2}(t)$ with respect to the given inner product”; “${p}_{1}(t)⊥{p}_{3}(t)$ with respect to the given inner product” only."} {:db/id #edb/ref 17592186134560 :knowledge-point/_questions [{:db/id #edb/ref 17592186133871 :knowledge-point/id #uuid "67683e7d-bf4f-5fdf-8fe5-df996c30e836" :knowledge-point/title "Determining Whether a Set of Vectors Is Orthogonal With Respect to a Given Inner Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bfe4101-1788-57a5-8ac1-2c57a2f6071f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460513} {:answer/id #uuid "6e71543c-7657-547f-a18c-7f2c9399f2e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460514}] :answer-field/correct {:answer/id #uuid "6e71543c-7657-547f-a18c-7f2c9399f2e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460514} :answer-field/id #uuid "df08f260-5444-5ae9-8d62-29e40a4e506b" :answer-field/key "${v}_{1}⊥{v}_{2}$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461123} {:answer-field/choices [{:answer/id #uuid "0be9b958-1cbc-5d5c-ab57-ff274247d9ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460515} {:answer/id #uuid "9910ea02-2b27-5ca3-97ce-4b26453b65a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460516}] :answer-field/correct {:answer/id #uuid "0be9b958-1cbc-5d5c-ab57-ff274247d9ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460515} :answer-field/id #uuid "405cf54e-21d8-5914-a3f7-9997f14dd3b0" :answer-field/key "${v}_{1}⊥{v}_{3}$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461124} {:answer-field/choices [{:answer/id #uuid "fd98d551-abd5-51b0-9163-7cca51863f36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460517} {:answer/id #uuid "6acd70ed-8270-5710-b977-1d407c3bc24e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460518}] :answer-field/correct {:answer/id #uuid "fd98d551-abd5-51b0-9163-7cca51863f36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460517} :answer-field/id #uuid "6ce29998-b7b3-5f9a-8e15-33f308175a0f" :answer-field/key "$S=\\{{v}_{1},{v}_{2},{v}_{3}\\}$ is an orthogonal set with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461125} {:answer-field/choices [{:answer/id #uuid "4d7a3430-05d0-5b7a-97e2-75a48b382042" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668150} {:answer/id #uuid "3ebede7b-08e5-5f95-9e41-864a485a29bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668151}] :answer-field/correct {:answer/id #uuid "4d7a3430-05d0-5b7a-97e2-75a48b382042" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668150} :answer-field/id #uuid "d95e83d5-ac00-59cf-9fb3-e29c67884bb4" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668352}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "89d04c73-ac43-52ba-9b0d-f07e5d286354" :question/math-academy-id "q-98523" :question/problem "$$\n{v}_{1}=\\begin{bmatrix}6 \\\\ 0 \\\\ -2\\end{bmatrix},\\,{v}_{2}=\\begin{bmatrix}-1 \\\\ 1 \\\\ -1\\end{bmatrix},\\,{v}_{3}=\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}\n$$\n\nConsider the vectors shown above. Given that the inner product in the vector space ${R}^{3}$ is defined as \n\n$$\n⟨x,y⟩={x}_{1}{y}_{1}+2{x}_{2}{y}_{2}+3{x}_{3}{y}_{3},\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that a set of vectors in an inner product space is orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement “${v}_{1}⊥{v}_{2}$ with respect to the given inner product” is true. Indeed, we have\n\n$$\n\\begin{aligned}⟨{v}_{1},{v}_{2}⟩ & =(6)(-1)+2(0)(1)+3(-2)(-1) \\\\  & =-6+0+6 \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${v}_{1}⊥{v}_{2}$ with respect to the given inner product.\n\n- Statement “${v}_{1}⊥{v}_{3}$ with respect to the given inner product” is false since \n\n$$\n\\begin{aligned}⟨{v}_{1},{v}_{3}⟩ & =(6)(1)+2(0)(1)+3(-2)(0) \\\\  & =6+0+0 \\\\  & =6\\ne 0,\\end{aligned}\n$$\n\nwhich means that ${v}_{1}⊥̸{v}_{3}$ with respect to the given inner product.\n\n- Statement “$S=\\{{v}_{1},{v}_{2},{v}_{3}\\}$ is an orthogonal set with respect to the given inner product” is false. Since ${v}_{1}⊥̸{v}_{3},$ the set $S$ is *not* orthogonal.\n\nTherefore, the correct answer is “${v}_{1}⊥{v}_{2}$ with respect to the given inner product” only."} {:db/id #edb/ref 17592186134561 :knowledge-point/_questions [{:db/id #edb/ref 17592186133872 :knowledge-point/id #uuid "382a6db7-2708-5711-885e-6f3f3037e8df" :knowledge-point/title "Determining Whether a Set of Functions is Orthogonal With Respect to a Given Inner Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "338f1d6d-db3e-5039-8b5f-aae22fabbd02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460519} {:answer/id #uuid "dd0aa715-cd46-53c6-8496-e8659486cc4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460520}] :answer-field/correct {:answer/id #uuid "338f1d6d-db3e-5039-8b5f-aae22fabbd02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460519} :answer-field/id #uuid "e072e774-4518-5103-b30b-43265d9155f3" :answer-field/key "${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461126} {:answer-field/choices [{:answer/id #uuid "63cc9190-0ae1-5996-a7f6-181e038cbfa0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460521} {:answer/id #uuid "2fa45487-8b6f-5b57-a845-0357f250b036" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460522}] :answer-field/correct {:answer/id #uuid "63cc9190-0ae1-5996-a7f6-181e038cbfa0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460521} :answer-field/id #uuid "4bad1972-2fc5-5c34-b0b0-ea00210ef3e4" :answer-field/key "${f}_{1}(t)⊥{f}_{3}(t)$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461127} {:answer-field/choices [{:answer/id #uuid "948e577a-3aef-54e4-b34e-06b35d762788" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460523} {:answer/id #uuid "fef9594e-8ffa-5e45-92ae-7b0feb6eda72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460524}] :answer-field/correct {:answer/id #uuid "948e577a-3aef-54e4-b34e-06b35d762788" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460523} :answer-field/id #uuid "42e7f608-b7d2-507d-802e-9a170099ff23" :answer-field/key "$S=\\{{f}_{1}(t),{f}_{2}(t),{f}_{3}(t)\\}$ is an orthogonal set with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461128} {:answer-field/choices [{:answer/id #uuid "adfd4ecb-dae4-5645-b471-d32d332a3c28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668152} {:answer/id #uuid "de49105a-4d8a-54f4-b860-ed8632474d85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668153}] :answer-field/correct {:answer/id #uuid "de49105a-4d8a-54f4-b860-ed8632474d85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668153} :answer-field/id #uuid "2b18a8a4-37a7-55ac-b089-b7db698cd333" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668353}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2a5307a8-8a58-5d9f-8aa3-c19ff22a65ad" :question/math-academy-id "q-98524" :question/problem "Consider the following set of functions:\n\n$$\n{f}_{1}(t)=\\operatorname{cos}⁡t,\\,{f}_{2}(t)=\\operatorname{sin}⁡(2t),\\,{f}_{3}(t)=t\n$$\n\nGiven that the inner product in the vector space $C[0,\\pi ]$ of continuous functions over $[0,\\pi ]$ is defined as \n\n$$\n⟨f(t),g(t)⟩={\\int }_{0}^{\\pi }f(t)g(t)\\,\\text{d}t,\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that a set of vectors in an inner product space is called orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement “${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the given inner product” is false. We have\n\n$$\n\\begin{aligned}⟨{f}_{1}(t),{f}_{2}(t)⟩=⟨\\operatorname{cos}⁡t,\\operatorname{sin}⁡(2t)⟩={\\int }_{0}^{\\pi }\\operatorname{cos}⁡t\\operatorname{sin}⁡(2t)\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can evaluate this integral using the identity $\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta =\\frac{1}{2}(\\operatorname{sin}⁡(\\alpha -\\beta )+\\operatorname{sin}⁡(\\alpha +\\beta ))$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }\\operatorname{cos}⁡t\\,\\operatorname{sin}⁡(2t)\\,\\text{d}t & =\\frac{1}{2}{\\int }_{0}^{\\pi }(\\operatorname{sin}⁡(2t-t)+\\operatorname{sin}⁡(2t+t))\\,\\text{d}t \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }(\\operatorname{sin}⁡t+\\operatorname{sin}⁡(3t))\\,\\text{d}t \\\\  & =\\frac{1}{2}(-\\operatorname{cos}⁡t-\\frac{1}{3}\\operatorname{cos}⁡(3t)){|}_{0}^{\\pi } \\\\  & =\\frac{1}{2}(-\\operatorname{cos}⁡(\\pi )-\\frac{1}{3}\\operatorname{cos}⁡(3\\pi ))-\\frac{1}{2}(-\\operatorname{cos}⁡(0)-\\frac{1}{3}\\operatorname{cos}⁡(0)) \\\\  & =\\frac{1}{2}\\cdot \\frac{4}{3}-\\frac{1}{2}\\cdot \\left(-\\frac{4}{3}\\right) \\\\  & =\\frac{4}{3}\\ne 0.\\end{aligned}\n$$\n\nThis means that ${f}_{1}(t)⊥̸{f}_{2}(t)$ with respect to the given inner product.\n\n- Statement “${f}_{1}(t)⊥{f}_{3}(t)$ with respect to the given inner product” is false. We have\n\n$$\n\\begin{aligned}⟨{f}_{1}(t),{f}_{3}(t)⟩=⟨\\operatorname{cos}⁡t,t⟩={\\int }_{0}^{\\pi }t\\operatorname{cos}⁡t\\,\\text{d}t.\\end{aligned}\n$$\n\nLet's use integration by parts. We denote\n\n$$\n\\begin{aligned}u=t & ⟹ & {u}^{′}=1, \\\\ {v}^{′}=\\operatorname{cos}⁡t & ⟹ & v=\\int {v}^{′}\\,\\text{d}t=\\int \\operatorname{cos}⁡t\\,\\text{d}t=\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nNow, applying the integration by parts formula, we obtain \n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }t\\operatorname{cos}⁡t\\,\\text{d}t & =uv{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }{u}^{′}v\\,\\text{d}t \\\\  & =(t\\operatorname{sin}⁡t){|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }\\operatorname{sin}⁡t\\,\\text{d}t \\\\  & =(\\pi \\cdot \\operatorname{sin}⁡(\\pi )-0\\cdot \\operatorname{sin}⁡(0))+\\operatorname{cos}⁡t{|}_{0}^{\\pi } \\\\  & =0+(\\operatorname{cos}⁡(\\pi )-\\operatorname{cos}⁡(0)) \\\\  & =-2\\ne 0.\\end{aligned}\n$$\n\nThis means that ${f}_{1}(t)⊥̸{f}_{3}(t)$ with respect to the given inner product.\n\n- Statement “$S=\\{{f}_{1}(t),{f}_{2}(t),{f}_{3}(t)\\}$ is an orthogonal set with respect to the given inner product” is false. Since ${f}_{1}(t)⊥̸{f}_{2}(t),$ the set $S$ is *not* orthogonal.\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186134568 :knowledge-point/_questions [{:db/id #edb/ref 17592186133871 :knowledge-point/id #uuid "67683e7d-bf4f-5fdf-8fe5-df996c30e836" :knowledge-point/title "Determining Whether a Set of Vectors Is Orthogonal With Respect to a Given Inner Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cd9f0e8-a24e-56ca-9b35-3d20cfaf108a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460531} {:answer/id #uuid "259c4552-e209-5c99-a5e6-bd6496de834a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460532}] :answer-field/correct {:answer/id #uuid "259c4552-e209-5c99-a5e6-bd6496de834a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460532} :answer-field/id #uuid "501bcedc-e9e7-5701-8822-63b288ec14e5" :answer-field/key "${v}_{1}⊥{v}_{2}$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461132} {:answer-field/choices [{:answer/id #uuid "e1177f64-3b06-57ce-8e76-cb501ace8944" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460533} {:answer/id #uuid "19f13dcd-f1c9-5b3c-9af0-25c639ba91e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460534}] :answer-field/correct {:answer/id #uuid "19f13dcd-f1c9-5b3c-9af0-25c639ba91e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460534} :answer-field/id #uuid "d1c8e995-7173-5c3d-abca-4ce5910c0c51" :answer-field/key "${v}_{1}⊥{v}_{3}$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461133} {:answer-field/choices [{:answer/id #uuid "dff2943b-54f6-5db5-b389-bb1522249521" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460535} {:answer/id #uuid "04d21503-375a-5aba-bcd6-32a725fdf8a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460536}] :answer-field/correct {:answer/id #uuid "04d21503-375a-5aba-bcd6-32a725fdf8a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460536} :answer-field/id #uuid "5ab9e1ce-f903-5879-9b70-776ebbe8c793" :answer-field/key "$S=\\{{v}_{1},{v}_{2},{v}_{3}\\}$ is an orthogonal set with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461134} {:answer-field/choices [{:answer/id #uuid "07a080fd-916f-5486-8aef-7a965758c6f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668154} {:answer/id #uuid "176096eb-3a64-554d-bd9b-8a875dfc6d95" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668155}] :answer-field/correct {:answer/id #uuid "07a080fd-916f-5486-8aef-7a965758c6f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668154} :answer-field/id #uuid "be8e33af-dd3a-5483-89d1-5e4ece35a83a" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668354}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f758f1fb-abdb-5749-9b81-10132d816072" :question/math-academy-id "q-99636" :question/problem "$$\n{v}_{1}=\\begin{bmatrix}4 \\\\ -2 \\\\ 2\\end{bmatrix},\\,{v}_{2}=\\begin{bmatrix}-8 \\\\ 4 \\\\ 5\\end{bmatrix},\\,{v}_{3}=\\begin{bmatrix}1 \\\\ 2 \\\\ 0\\end{bmatrix}\n$$\n\nConsider the vectors shown above. Given that the inner product in the vector space ${R}^{3}$ is defined as \n\n$$\n⟨x,y⟩={x}_{1}{y}_{1}+{x}_{2}{y}_{2}+4{x}_{3}{y}_{3},\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that a set of vectors in an inner product space is orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement “${v}_{1}⊥{v}_{2}$ with respect to the given inner product” is true. Indeed, we have\n\n$$\n\\begin{aligned}⟨{v}_{1},{v}_{2}⟩ & =(4)(-8)+(-2)(4)+4(2)(5) \\\\  & =-32-8+40 \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${v}_{1}⊥{v}_{2}$ with respect to the given inner product.\n\n- Statement “${v}_{1}⊥{v}_{3}$ with respect to the given inner product” is true. Indeed, we have \n\n$$\n\\begin{aligned}⟨{v}_{1},{v}_{3}⟩ & =(4)(1)+(-2)(2)+4(2)(0) \\\\  & =4-4+0 \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${v}_{1}⊥{v}_{3}$ with respect to the given inner product.\n\n- Statement “$S=\\{{v}_{1},{v}_{2},{v}_{3}\\}$ is an orthogonal set with respect to the given inner product” is true. Indeed, computing the inner product $⟨{v}_{2},{v}_{3}⟩$, we have \n\n$$\n\\begin{aligned}⟨{v}_{2},{v}_{3}⟩ & =(-8)(1)+(4)(2)+4(5)(0) \\\\  & =-8+8+0 \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${v}_{2}⊥{v}_{3}$ with respect to the given inner product.\nAs a result, the set $S$ is orthogonal.\n\nTherefore, the correct answer is “${v}_{1}⊥{v}_{2}$ with respect to the given inner product”; “${v}_{1}⊥{v}_{3}$ with respect to the given inner product”; “$S=\\{{v}_{1},{v}_{2},{v}_{3}\\}$ is an orthogonal set with respect to the given inner product”."} {:db/id #edb/ref 17592186147801 :knowledge-point/_questions [{:db/id #edb/ref 17592186147544 :knowledge-point/id #uuid "638e604b-5416-5d3c-a61f-5be645aa255b" :knowledge-point/title "Identifying True Statements in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "828f3b62-d6fc-55e1-890d-d6145d705ec4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459829} {:answer/id #uuid "539b6b66-f4ad-5922-9730-438128ba5b07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459830}] :answer-field/correct {:answer/id #uuid "539b6b66-f4ad-5922-9730-438128ba5b07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459830} :answer-field/id #uuid "69d15af5-fbb9-5372-a601-ae7f5758d4d2" :answer-field/key "Less than half of Lionel's goals scored were from the penalty spot." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460781} {:answer-field/choices [{:answer/id #uuid "263c2f5a-1877-5619-a24b-221f11d150a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459831} {:answer/id #uuid "1a1a5cd4-be57-5868-99a4-583204f33015" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459832}] :answer-field/correct {:answer/id #uuid "263c2f5a-1877-5619-a24b-221f11d150a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459831} :answer-field/id #uuid "0678aeb4-97dd-5a0c-ba48-5da21cc51635" :answer-field/key "More than half of David's goals scored were from the penalty spot." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460782} {:answer-field/choices [{:answer/id #uuid "84821ab6-88a8-5a73-bd50-ca06f607081f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459833} {:answer/id #uuid "3245b31d-675f-5700-81fc-86a8ab50e5f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459834}] :answer-field/correct {:answer/id #uuid "3245b31d-675f-5700-81fc-86a8ab50e5f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459834} :answer-field/id #uuid "ad59991b-d7c3-5f26-ac4f-f72283e8c6f9" :answer-field/key "Lionel had a greater percentage of goals scored from the penalty spot compared to David." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460783} {:answer-field/choices [{:answer/id #uuid "2fad6c37-42e9-5bef-8ca6-08dcf39a66a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668034} {:answer/id #uuid "43877b74-8070-50fc-becd-7dd079d020bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668035}] :answer-field/correct {:answer/id #uuid "2fad6c37-42e9-5bef-8ca6-08dcf39a66a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668034} :answer-field/id #uuid "0928aac2-a9a2-5c66-8dc7-c5f81012b76c" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668294}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "436201f3-78ea-5cda-b175-c5331e2f77ae" :question/math-academy-id "q-348980" :question/problem "Lionel and David are youth soccer players. In the previous season, $12%$ of Lionel’s goals were scored from the penalty spot, while the decimal proportion of David’s goals scored from the penalty spot was $0.1.$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's examine our statements in turn.\n\n- Statement “Less than half of Lionel's goals scored were from the penalty spot” is true. Indeed, since \n\n$$\n12%<50%,\n$$\n\nless than half of Lionel's goals scored were from the penalty spot.\n\n- Statement “More than half of David's goals scored were from the penalty spot” is false. Notice that \n\n$$\n0.1<0.5.\n$$\n\nSo, less than half of David's goals scored were from the penalty spot.\n\n- Statement “Lionel had a greater percentage of goals scored from the penalty spot compared to David” is true. We can compare $12%$ and $0.1$ by converting the decimal into a percent. \n\nTo do this, we multiply it by $100:$\n\n$$\n0.1\\times 100=10%\n$$\n\nSince  $12%>10%,$ Lionel had a **greater** percentage of goals scored from the penalty spot compared to David.\n\nTherefore, the correct answer is “Less than half of Lionel's goals scored were from the penalty spot”; “Lionel had a greater percentage of goals scored from the penalty spot compared to David” only."} {:db/id #edb/ref 17592186148216 :knowledge-point/_questions [{:db/id #edb/ref 17592186147492 :knowledge-point/id #uuid "6e71c0c9-7dd1-5f09-a55c-96b5bed1ee9a" :knowledge-point/title "Identifying a Differential Equation Corresponding to a Phase Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e6e4576-cb2c-5f40-a024-0b79d87ba611" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460449} {:answer/id #uuid "26b14906-c7f3-5d7f-b0ad-99c28013e0d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460450}] :answer-field/correct {:answer/id #uuid "26b14906-c7f3-5d7f-b0ad-99c28013e0d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460450} :answer-field/id #uuid "38c7ed42-808d-5461-8925-03413bd4c72d" :answer-field/key "$\\frac{\\text{d}y}{\\text{d}x}={y}^{2}-1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461091} {:answer-field/choices [{:answer/id #uuid "1ff26235-ad35-5b68-8248-700bc1d7a8cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460451} {:answer/id #uuid "707e809b-5526-5183-832e-8d66c5aae6cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460452}] :answer-field/correct {:answer/id #uuid "1ff26235-ad35-5b68-8248-700bc1d7a8cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460451} :answer-field/id #uuid "f0c652fd-ac7d-5203-b330-84bd10a9ee1c" :answer-field/key "$\\frac{\\text{d}y}{\\text{d}x}=(y-1)^{2}(y+1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461092} {:answer-field/choices [{:answer/id #uuid "3964794a-ae53-591f-93de-d8ce066bcc8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460453} {:answer/id #uuid "d18e5255-26c2-53ec-9ae8-fdfff869cd5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460454}] :answer-field/correct {:answer/id #uuid "3964794a-ae53-591f-93de-d8ce066bcc8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460453} :answer-field/id #uuid "34932bd5-c652-5539-b173-7a6c06a591cc" :answer-field/key "$\\frac{\\text{d}y}{\\text{d}x}=(y-1)^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461093} {:answer-field/choices [{:answer/id #uuid "b158f133-c4d7-5251-b2a7-0b8789a1829c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668144} {:answer/id #uuid "f6246b65-0d90-5a93-a854-f009eaf3949c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668145}] :answer-field/correct {:answer/id #uuid "b158f133-c4d7-5251-b2a7-0b8789a1829c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668144} :answer-field/id #uuid "d5aedf92-a5c3-5a79-b997-1f27b48c856e" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668349}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f8c00e37-f5cb-5639-8ab6-118fe74f0e44" :question/math-academy-id "q-96513" :question/problem "![](images/d3/d3a06bdc7a63a86651752ff70331010920d24728e7f4e4ad9f067eb860ebaf4b.png)\n\nConsider the phase line shown above. Which of the following differential equations could have this phase line?\n\nSelect all that apply." :question/worked-solution "First, notice that all three differential equations are of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(y).\n$$\n\nThe phase line gives us the following information:\n\n- The equilibrium solutions are $y=-1$ and $y=1.$\n\n- $f(y)$ is positive for $y\\in (-\\infty ,-1)\\cup (1,\\infty ).$\n\n- $f(y)$ is negative for $y\\in (-1,1).$\n\nWith this in mind, let's study each of the given equations.\n\n- We start by considering ${y}^{′}={y}^{2}-1.$\n\nFirst, we see that $f(y)={y}^{2}-1,$ so $f(y)=0$ if $y=-1,1.$ So, the equilibrium solutions correspond to those shown in the phase line.\n\nNow, we can construct a sign table for $f(y)$ as follows: \n\n|  | $(-\\infty ,-1)$ | $(-1,1)$ | $(1,\\infty )$ |\n| --- | --- | --- | --- |\n| $y+1$ | $-$ | $+$ | $+$ |\n| $y-1$ | $-$ | $-$ | $+$ |\n| $f(y)$ | $+$ | $-$ | $+$ |\n\nSo, we have that $f(y)$ is negative for  $y\\in (-1,1),$ and $f(y)$ is positive for $y\\in (-\\infty ,-1)\\cup (1,\\infty ).$ This corresponds to the arrows shown on the phase line.\n\nTherefore, equation $\\frac{\\text{d}y}{\\text{d}x}={y}^{2}-1$ has the given phase line.\n\n- Next, we consider ${y}^{′}=(y-1)^{2}(y+1).$\n\nFirst, $f(y)=(y-1)^{2}(y+1),$ so $f(y)=0$ if $y=-1,1.$ So, the equilibrium solutions correspond to those shown in the phase line.\n\nHowever, we note that $f(y)<0$ for $y\\in (-\\infty ,-1).$ This does *not* correspond to the arrows shown on the phase line.\n\nTherefore, equation $\\frac{\\text{d}y}{\\text{d}x}=(y-1)^{2}(y+1)$ does not have the given phase line.\n\n- Finally, we consider ${y}^{′}=(y-1)^{2}.$\n\nIn this case, $f(y)=(y-1)^{2},$ and the equilibrium solution is $y=1$ only.\n\nTherefore, equation $\\frac{\\text{d}y}{\\text{d}x}=(y-1)^{2}$ does not have the given phase line.\n\nTherefore, the correct answer is $\\frac{\\text{d}y}{\\text{d}x}={y}^{2}-1$ only."} {:db/id #edb/ref 17592186148223 :knowledge-point/_questions [{:db/id #edb/ref 17592186147495 :knowledge-point/id #uuid "4535b48e-a33f-5f62-95d3-a5c0991c1f6d" :knowledge-point/title "Classifying Equilibrium Points Using a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00f13d25-8aaa-53fe-b649-79f759aca692" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460461} {:answer/id #uuid "9b5118f7-bea8-56bb-9fa7-7066d9d15341" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460462}] :answer-field/correct {:answer/id #uuid "00f13d25-8aaa-53fe-b649-79f759aca692" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460461} :answer-field/id #uuid "0ed60369-6527-596a-aa20-10745731f2e3" :answer-field/key "$y=1$ is a node." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461097} {:answer-field/choices [{:answer/id #uuid "58384368-2e9c-513d-884f-c895ead26452" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460463} {:answer/id #uuid "8ab5835d-dd16-5c59-b329-2d76fad3fea1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460464}] :answer-field/correct {:answer/id #uuid "8ab5835d-dd16-5c59-b329-2d76fad3fea1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460464} :answer-field/id #uuid "9c4a2a63-53b5-5ff5-adec-a8a211a46343" :answer-field/key "$y=-2$ is a sink." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461098} {:answer-field/choices [{:answer/id #uuid "e56d3d31-42e8-5b71-9337-634db804ceee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460465} {:answer/id #uuid "5632df88-4d15-5fcb-8683-ca20c35ee138" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460466}] :answer-field/correct {:answer/id #uuid "e56d3d31-42e8-5b71-9337-634db804ceee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460465} :answer-field/id #uuid "b652d627-c7ef-5e71-8927-79a18df27daa" :answer-field/key "$y=3$ is a source." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461099} {:answer-field/choices [{:answer/id #uuid "f788f1a8-e1e9-5531-af27-51c828a1773b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668146} {:answer/id #uuid "3d7a504e-5e22-5092-a81d-d0d2e56ccd4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668147}] :answer-field/correct {:answer/id #uuid "f788f1a8-e1e9-5531-af27-51c828a1773b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668146} :answer-field/id #uuid "244ce761-d4d6-5692-a242-f0d82073b8a2" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668350}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "68af5d21-8052-5193-93c5-650cda389ee6" :question/math-academy-id "q-96560" :question/problem "![](images/93/936d303dcc89c5c27e77fa3d7cfc8b63643284d9e203f176c9e0c5588c27e049.png)\n\nConsiderer the differential equation $\\frac{\\text{d}y}{\\text{d}x}=f(y)$ where the graph of $f(y)$ is shown above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "We can classify the equilibrium solutions of an autonomous ODE ${y}^{′}=f(y)$ by examining its phase line.\n\n- An equilibrium solution is a *sink* if the arrows directly above and below it on the phase line both point *toward* the equilibrium solution.\n\n- An equilibrium solution is a *source* if the arrows directly above and below it on the phase line both point *away* from the equilibrium solution.\n\n- An equilibrium solution is a *node* if the arrows directly above and below it on the phase line point in the same direction.\n\nThe phase line that corresponds to the given graph is as follows:\n\n![](images/69/69e895d4091075f6d50eb9e44dc027c342d1fe7ca0269224c9b6a019ab312c77.png)\n\nTherefore, we have:\n\n- Statement “$y=1$ is a node” is false. From the phase line, we see that $y=1$ is a source.\n\n- Statement “$y=-2$ is a sink” is true. From the phase line, we see that $y=-2$ is a sink.\n\n- Statement “$y=3$ is a source” is false. From the phase line, we see that $y=3$ is a sink.\n\nTherefore, the correct answer is “$y=-2$ is a sink” only."} {:db/id #edb/ref 17592186152380 :knowledge-point/_questions [{:db/id #edb/ref 17592186152224 :knowledge-point/id #uuid "a0abad78-e492-5d09-a04d-bce54605c78c" :knowledge-point/title "Identifying Generalized Eigenvectors of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37857c14-e9d8-5ff8-b371-453bdcccb1bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459365} {:answer/id #uuid "39c98a6d-0b5b-56e4-a2d6-30cb920436ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459366}] :answer-field/correct {:answer/id #uuid "37857c14-e9d8-5ff8-b371-453bdcccb1bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459365} :answer-field/id #uuid "2880db24-3981-59f1-8156-a1eedd6e86dd" :answer-field/key "$v$ is an eigenvector corresponding to the eigenvalue $\\lambda =3$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460549} {:answer-field/choices [{:answer/id #uuid "114bd932-69e9-56f5-8f32-bd3d35462900" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459367} {:answer/id #uuid "acc3af12-c7ea-5216-8ed6-4ca5dab78a07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459368}] :answer-field/correct {:answer/id #uuid "acc3af12-c7ea-5216-8ed6-4ca5dab78a07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459368} :answer-field/id #uuid "bcd568dc-05a5-58da-b3ec-6002251d7945" :answer-field/key "$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =3$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460550} {:answer-field/choices [{:answer/id #uuid "47acaf3b-ff10-55be-bc1b-9101c802c80d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459369} {:answer/id #uuid "c23b93b7-3a6c-58e0-b193-425d41fe60e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459370}] :answer-field/correct {:answer/id #uuid "47acaf3b-ff10-55be-bc1b-9101c802c80d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459369} :answer-field/id #uuid "d643dc1b-cb05-5416-ab2c-d769dada2c8d" :answer-field/key "$v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =3$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460551} {:answer-field/choices [{:answer/id #uuid "8a39ef1a-16d8-5ecd-b658-016c5378e7a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667826} {:answer/id #uuid "0f4a17f3-ea73-5fc1-9b44-c57db201cf08" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667827}] :answer-field/correct {:answer/id #uuid "8a39ef1a-16d8-5ecd-b658-016c5378e7a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667826} :answer-field/id #uuid "313ee7f7-e99a-5498-85c6-2178368491f2" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668190}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "86e7e59c-5f60-5647-9c15-90e1d3a1ac43" :question/math-academy-id "q-109113" :question/problem "$$\nA=\\begin{bmatrix}4 & 1 \\\\ -1 & 2\\end{bmatrix},\\,v=\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$ \n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A-3I:$\n\n$$\nA-3I=\\begin{bmatrix}4 & 1 \\\\ -1 & 2\\end{bmatrix}-3\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}1 & 1 \\\\ -1 & -1\\end{bmatrix}\n$$\n\n- Next, we find the image of $v$ under the action of $A-3I:$\n\n$$\n(A-3I)v=\\begin{bmatrix}1 & 1 \\\\ -1 & -1\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}=\\underbrace{\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A-3I:$\n\n$$\n(A-3I)w=\\begin{bmatrix}1 & 1 \\\\ -1 & -1\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n\\underbrace{\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}}_{v}\\overset{A-3I\\,}{\\to }\\underbrace{\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}}_{w}\\overset{A-3I\\,}{\\to }\\underbrace{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{0}\n$$\n\nHere, we see that $A-3I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =3$ of $A.$*\n\nSo, the correct answer is “$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =3$ of $A$” only."} {:db/id #edb/ref 17592186152381 :knowledge-point/_questions [{:db/id #edb/ref 17592186152226 :knowledge-point/id #uuid "76e60bc4-ae61-5c39-ad80-14e0cdab14da" :knowledge-point/title "Identifying Generalized Eigenvectors of a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "515bc565-71af-5221-9644-0aa83842a772" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459371} {:answer/id #uuid "85ca1bc0-8767-5bbd-8c32-74c4ccecbceb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459372}] :answer-field/correct {:answer/id #uuid "515bc565-71af-5221-9644-0aa83842a772" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459371} :answer-field/id #uuid "c5bc38a4-b7d8-54fc-a15e-6051610958ae" :answer-field/key "$v$ is an eigenvector corresponding to the eigenvalue $\\lambda =-3$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460552} {:answer-field/choices [{:answer/id #uuid "add4fd71-0330-508c-967e-e91acae428b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459373} {:answer/id #uuid "3a6dc8f6-e3ff-57d2-80a2-3f7f19e8d919" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459374}] :answer-field/correct {:answer/id #uuid "add4fd71-0330-508c-967e-e91acae428b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459373} :answer-field/id #uuid "ceea3f1e-528b-558b-9481-3e2b4047d516" :answer-field/key "$v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =-3$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460553} {:answer-field/choices [{:answer/id #uuid "fcd49110-f42e-5516-8b3e-d072308e4699" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459375} {:answer/id #uuid "07449d7d-1c19-5c1b-918c-57445e2e3e8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459376}] :answer-field/correct {:answer/id #uuid "fcd49110-f42e-5516-8b3e-d072308e4699" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459375} :answer-field/id #uuid "3e971058-f913-5f6c-a9c3-556bd4e47f97" :answer-field/key "$v$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =-3$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460554} {:answer-field/choices [{:answer/id #uuid "0182fbce-9e2c-5bb6-9fc6-455d9887dfbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667828} {:answer/id #uuid "3926f0e5-2ca3-50a6-8899-9ea1fe658a86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667829}] :answer-field/correct {:answer/id #uuid "3926f0e5-2ca3-50a6-8899-9ea1fe658a86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667829} :answer-field/id #uuid "8f509afd-2e3e-52cd-ab97-4feb70697b87" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668191}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7971d731-7317-51d2-bfe1-46fc4b23c3f9" :question/math-academy-id "q-109117" :question/problem "$$\nA=\\begin{bmatrix}-5 & 1 & -5 \\\\ -4 & -1 & -1 \\\\ 0 & 0 & -3\\end{bmatrix},\\,v=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A *generalized eigenvector* ${v}_{n}$ of rank $n$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{n}\\overset{A-\\lambda I\\,}{\\to }{v}_{n-1}\\overset{A-\\lambda I\\,}{\\to }…\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{n-1},{v}_{n-2},…,{v}_{1}\\ne 0.$ An *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nFirst, we compute $A+3I:$\n\n$$\nA+3I=\\begin{bmatrix}-5 & 1 & -5 \\\\ -4 & -1 & -1 \\\\ 0 & 0 & -3\\end{bmatrix}+3\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}-2 & 1 & -5 \\\\ -4 & 2 & -1 \\\\ 0 & 0 & 0\\end{bmatrix}\n$$\n\n- Next, we find the image of $v$ under the action of $A+3I:$\n\n$$\n(A+3I)v=\\begin{bmatrix}-2 & 1 & -5 \\\\ -4 & 2 & -1 \\\\ 0 & 0 & 0\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}=\\underbrace{\\begin{bmatrix}-2 \\\\ -4 \\\\ 0\\end{bmatrix}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A+3I:$\n\n$$\n(A+3I)w=\\begin{bmatrix}-2 & 1 & -5 \\\\ -4 & 2 & -1 \\\\ 0 & 0 & 0\\end{bmatrix}\\begin{bmatrix}-2 \\\\ -4 \\\\ 0\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n\\underbrace{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}}_{v}\\overset{A+3I\\,}{\\to }\\underbrace{\\begin{bmatrix}-2 \\\\ -4 \\\\ 0\\end{bmatrix}}_{w}\\overset{A+3I\\,}{\\to }\\underbrace{\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}}_{0}\n$$\n\nHere, we see that $A+3I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-3$ of $A.$*\n\nSo, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186152383 :knowledge-point/_questions [{:db/id #edb/ref 17592186152224 :knowledge-point/id #uuid "a0abad78-e492-5d09-a04d-bce54605c78c" :knowledge-point/title "Identifying Generalized Eigenvectors of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bbca469-a09a-5aae-9061-eaabaf47cb82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459383} {:answer/id #uuid "f24a4df8-1519-516f-987c-510381d92a7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459384}] :answer-field/correct {:answer/id #uuid "f24a4df8-1519-516f-987c-510381d92a7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459384} :answer-field/id #uuid "54cfa585-bc9e-5739-a2b3-2cec274bc4a3" :answer-field/key "$v$ is an eigenvector corresponding to the eigenvalue $\\lambda =2$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460558} {:answer-field/choices [{:answer/id #uuid "03c36856-0511-53a2-b1e2-b7e4a2d0a856" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459385} {:answer/id #uuid "d3640da3-5e4d-595a-bdba-1a90c3045d43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459386}] :answer-field/correct {:answer/id #uuid "d3640da3-5e4d-595a-bdba-1a90c3045d43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459386} :answer-field/id #uuid "a7056ce4-0dc2-5a6e-9a67-45ab92d795ee" :answer-field/key "$v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =2$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460559} {:answer-field/choices [{:answer/id #uuid "cc576af0-e18c-56ef-afbf-731c68a1fc36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459387} {:answer/id #uuid "3a2ff2a7-9088-54bb-8657-c345c13ee7b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459388}] :answer-field/correct {:answer/id #uuid "cc576af0-e18c-56ef-afbf-731c68a1fc36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459387} :answer-field/id #uuid "8be9ee5d-49cc-51bd-876f-c730adca6226" :answer-field/key "$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =2$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460560} {:answer-field/choices [{:answer/id #uuid "abd38a13-cc6b-5f8c-aaae-9b09869ce244" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667832} {:answer/id #uuid "ea42bc0d-a47f-59be-b993-3acc19f1e508" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667833}] :answer-field/correct {:answer/id #uuid "abd38a13-cc6b-5f8c-aaae-9b09869ce244" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667832} :answer-field/id #uuid "cc4c1917-3a8b-5ee1-97d0-f4a189c49b0b" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668193}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "13d405ca-1969-5fbd-88a4-d12478e301e3" :question/math-academy-id "q-109500" :question/problem "$$\nA=\\begin{bmatrix}0 & -2 \\\\ 2 & 4\\end{bmatrix},\\,v=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$ \n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A-2I:$\n\n$$\nA-2I=\\begin{bmatrix}0 & -2 \\\\ 2 & 4\\end{bmatrix}-2\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-2 & -2 \\\\ 2 & 2\\end{bmatrix}\n$$\n\nNext, we find the image of $v$ under the action of $A-2I:$\n\n$$\n(A-2I)v=\\begin{bmatrix}-2 & -2 \\\\ 2 & 2\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}=0\n$$\n\nSo, we obtain the following map:\n\n$$\n\\underbrace{\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}}_{v}\\overset{\\,A-2I\\,\\,}{\\to }\\underbrace{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{0}\n$$\n\n \n\nHere, we see that $A-2I$ maps $v$ to $0$ in $1$ step.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $1$ (a.k.a. an eigenvector) corresponding to the eigenvalue  $\\lambda =2$ of $A.$*\n\nSo, the correct answer is “$v$ is an eigenvector corresponding to the eigenvalue $\\lambda =2$ of $A$”; “$v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =2$ of $A$” only."} {:db/id #edb/ref 17592186152384 :knowledge-point/_questions [{:db/id #edb/ref 17592186152226 :knowledge-point/id #uuid "76e60bc4-ae61-5c39-ad80-14e0cdab14da" :knowledge-point/title "Identifying Generalized Eigenvectors of a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "590283a9-e891-5d0c-b51e-c560f3e54daa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459389} {:answer/id #uuid "c6f625c4-00e1-5289-b535-2b768c528b1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459390}] :answer-field/correct {:answer/id #uuid "c6f625c4-00e1-5289-b535-2b768c528b1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459390} :answer-field/id #uuid "dd0e91cb-f6f7-5c3e-bb8b-d1156e9e5bb0" :answer-field/key "$v$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =-5$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460561} {:answer-field/choices [{:answer/id #uuid "ba9c2356-d274-52ab-a056-4da50da53ed6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459391} {:answer/id #uuid "07882ba2-c232-540f-8fe0-c6653a895e48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459392}] :answer-field/correct {:answer/id #uuid "ba9c2356-d274-52ab-a056-4da50da53ed6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459391} :answer-field/id #uuid "d425a32e-7f30-58d3-bb5c-b3c831df78c1" :answer-field/key "$v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =-5$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460562} {:answer-field/choices [{:answer/id #uuid "71977d8b-bf39-5b1d-8d7e-94b8041534c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459393} {:answer/id #uuid "1d00776f-5194-5977-b5af-d8769896ebd2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459394}] :answer-field/correct {:answer/id #uuid "71977d8b-bf39-5b1d-8d7e-94b8041534c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459393} :answer-field/id #uuid "b9dd487e-dc8d-5257-a09f-ba81a3aa1ca8" :answer-field/key "$v$ is an eigenvector corresponding to the eigenvalue $\\lambda =-5$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460563} {:answer-field/choices [{:answer/id #uuid "539d38b7-cfd5-5fec-a368-162d4db59560" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667848} {:answer/id #uuid "10ef6b22-8288-5420-a8b0-4cb62110f0b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667849}] :answer-field/correct {:answer/id #uuid "539d38b7-cfd5-5fec-a368-162d4db59560" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667848} :answer-field/id #uuid "8c982795-04d8-5864-aa6d-68d9e1817d85" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668201}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6f4f929d-c8e6-554e-bc37-364f30077a9f" :question/math-academy-id "q-109587" :question/problem "$$\nA=\\begin{bmatrix}-6 & 2 & -1 \\\\ -1 & -2 & -2 \\\\ -1 & 3 & -7\\end{bmatrix},\\,v=\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A *generalized eigenvector* ${v}_{n}$ of rank $n$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{n}\\overset{A-\\lambda I\\,}{\\to }{v}_{n-1}\\overset{A-\\lambda I\\,}{\\to }…\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{n-1},{v}_{n-2},…,{v}_{1}\\ne 0.$ An *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nFirst, we compute $A+5I:$\n\n$$\nA+5I=\\begin{bmatrix}-6 & 2 & -1 \\\\ -1 & -2 & -2 \\\\ -1 & 3 & -7\\end{bmatrix}+5\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}-1 & 2 & -1 \\\\ -1 & 3 & -2 \\\\ -1 & 3 & -2\\end{bmatrix}\n$$\n\n- Next, we find the image of $v$ under the action of $A+5I:$\n\n$$\n(A+5I)v=\\begin{bmatrix}-1 & 2 & -1 \\\\ -1 & 3 & -2 \\\\ -1 & 3 & -2\\end{bmatrix}\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}=\\underbrace{\\begin{bmatrix}1 \\\\ 2 \\\\ 2\\end{bmatrix}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector, we now compute the image of $w$ under the action of $A+5I:$\n\n$$\n(A+5I)w=\\begin{bmatrix}-1 & 2 & -1 \\\\ -1 & 3 & -2 \\\\ -1 & 3 & -2\\end{bmatrix}\\begin{bmatrix}1 \\\\ 2 \\\\ 2\\end{bmatrix}=\\underbrace{\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix}}_{x}\\ne 0\n$$\n\n- Again, since we got a nonzero vector in the last step, we now compute the image of $x$ under the action of $A+5I:$\n\n$$\n(A+5I)x=\\begin{bmatrix}-1 & 2 & -1 \\\\ -1 & 3 & -2 \\\\ -1 & 3 & -2\\end{bmatrix}\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n\\underbrace{\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}}_{v}\\overset{A+5I\\,}{\\to }\\underbrace{\\begin{bmatrix}1 \\\\ 2 \\\\ 2\\end{bmatrix}}_{w}\\overset{A+5I\\,}{\\to }\\underbrace{\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix}}_{x}\\overset{A+5I\\,}{\\to }\\underbrace{\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}}_{0}\n$$\n\nHere, we see that $A+5I$ maps $v$ to $0$ in $3$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =-5$ of $A.$*\n\nSo, the correct answer is “$v$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =-5$ of $A$” only."} {:db/id #edb/ref 17592186152410 :knowledge-point/_questions [{:db/id #edb/ref 17592186152234 :knowledge-point/id #uuid "35453324-c2ff-5be4-86aa-70b3085154dc" :knowledge-point/title "Interpreting Information From a Scatter Plot"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "575dccbf-d52e-5dd2-b80e-45c63714f303" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459529} {:answer/id #uuid "418bea30-cd14-5069-90a1-572182d3998c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459530}] :answer-field/correct {:answer/id #uuid "418bea30-cd14-5069-90a1-572182d3998c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459530} :answer-field/id #uuid "f18459b3-fcb2-52b5-b3c8-03c91c6ac6e7" :answer-field/key "There is only one child who spends $3.5$ hours playing outdoors." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460631} {:answer-field/choices [{:answer/id #uuid "92a5b226-87e1-5bcc-9924-a64cb1a3cba1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459531} {:answer/id #uuid "603b980e-c926-5a8a-bf43-ebed5422d4e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459532}] :answer-field/correct {:answer/id #uuid "92a5b226-87e1-5bcc-9924-a64cb1a3cba1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459531} :answer-field/id #uuid "7d2674a1-ade2-52de-8083-812d250b99dc" :answer-field/key "There is only one child aged $6$ among those surveyed." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460632} {:answer-field/choices [{:answer/id #uuid "3f536b65-945c-5069-ade1-ce17175a0b7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459533} {:answer/id #uuid "97573cd7-4a82-50f5-b3ca-e92bff2279fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459534}] :answer-field/correct {:answer/id #uuid "3f536b65-945c-5069-ade1-ce17175a0b7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459533} :answer-field/id #uuid "2bbf7638-1805-5c9a-962c-88753c4aaa5e" :answer-field/key "None of the children spend less than $2$ hours playing outdoors." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460633} {:answer-field/choices [{:answer/id #uuid "aa17e8f6-768c-5dae-b669-9ca34f8fc163" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667962} {:answer/id #uuid "2dc95979-7ef9-5769-b6d7-c4a10a9d1fdf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667963}] :answer-field/correct {:answer/id #uuid "aa17e8f6-768c-5dae-b669-9ca34f8fc163" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667962} :answer-field/id #uuid "10e343d5-8d74-528b-8819-1cec0baa3f22" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668258}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1109475d-9e0b-5521-b99e-3e1bd3fbb649" :question/math-academy-id "q-133622" :question/problem "![](images/e4/e4b568fe2226154be401a2332c718f143954d98fdbd8a0c679fdb99fcdd47d14.png)\n\nSarah interviewed some parents, asking them how much time their children spend playing outdoors per day. The information she received is summarized in the scatter plot above. \n\nGiven that none of the points overlap, which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's examine our scatter plot.\n\n- Statement “There is only one child who spends $3.5$ hours playing outdoors” is true. The scatter plot has only one dot whose vertical coordinate equals $3.5,$ namely, $(5,3.5).$ This means that only one child spends $3.5$ hours playing outdoors.\n\n![](images/01/0103370189c7156f9677ca576e2480bc99314cd312702fca3ea3e50cb4f7287a.png)\n\n- Statement “There is only one child aged $6$ among those surveyed” is false. The scatter plot has two dots whose horizontal coordinate equals $6,$ namely, $(6,2)$ and $(6,2.5).$ This means that there were two children of age $6$ among those surveyed.\n\n![](images/0a/0a8ca9628b48e643e1aa9e9f0216148881db237c2d29054b29f4377ad182503d.png)\n\n- Statement “None of the children spend less than $2$ hours playing outdoors” is false. From the scatter plot, two children spend less than $2$ hours playing outdoors. Those children are represented by the two dots below the horizontal line.\n\n![](images/4d/4d9709c131045f2e440204f79ad3fd8ff22707312b0e99138da558393e8b7f6d.png)\n\nTherefore, the correct answer is “There is only one child who spends $3.5$ hours playing outdoors” only."} {:db/id #edb/ref 17592186152569 :knowledge-point/_questions [{:db/id #edb/ref 17592186152280 :knowledge-point/id #uuid "e66005fe-df33-590a-9d9c-91947cd4a608" :knowledge-point/title "Identifying Fundamental Sets of Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01457e13-545a-541f-acce-7e047fbcc408" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459799} {:answer/id #uuid "87fffe77-2143-5ff9-a2da-d1695227d7bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459800}] :answer-field/correct {:answer/id #uuid "87fffe77-2143-5ff9-a2da-d1695227d7bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459800} :answer-field/id #uuid "5e5a869e-488e-5c2d-b679-699f90c7fb17" :answer-field/key "${y}_{1}(x)=\\operatorname{sin}⁡(x)$ is a solution to the equation." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460766} {:answer-field/choices [{:answer/id #uuid "6c86362a-34b4-52d6-ad75-a83bcdd09134" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459801} {:answer/id #uuid "f98b348b-31e2-5430-8135-c980ff086ccb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459802}] :answer-field/correct {:answer/id #uuid "f98b348b-31e2-5430-8135-c980ff086ccb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459802} :answer-field/id #uuid "cd47a839-63c4-5a6d-b3f2-177b46628555" :answer-field/key "${y}_{2}(x)=3\\operatorname{sin}⁡(x)$ is a solution to the equation." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460767} {:answer-field/choices [{:answer/id #uuid "d15df765-6a00-5bd1-8191-5dfbfb9a0320" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459803} {:answer/id #uuid "41ca8881-af27-5681-851a-1d131d4cd84d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459804}] :answer-field/correct {:answer/id #uuid "d15df765-6a00-5bd1-8191-5dfbfb9a0320" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459803} :answer-field/id #uuid "2930a8aa-b164-5efa-ac05-ac74a56ddd9f" :answer-field/key "The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460768} {:answer-field/choices [{:answer/id #uuid "2d0983dd-268a-5729-9ff0-7442930a90c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668012} {:answer/id #uuid "c8f2f4f8-943e-5891-84ce-151c6163fd2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668013}] :answer-field/correct {:answer/id #uuid "2d0983dd-268a-5729-9ff0-7442930a90c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668012} :answer-field/id #uuid "e1f62d2b-8b37-5011-9317-8232e0614af8" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668283}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f5244118-e12b-5ac2-ae1e-3e2ab9060947" :question/math-academy-id "q-333520" :question/problem "$$\n{y}^{″}+y=0\n$$\n\nConsider the differential equation above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation. \n\nLet's check each statement in turn.\n\n- Statement “${y}_{1}(x)=\\operatorname{sin}⁡(x)$ is a solution to the equation” is true. First, we find the first and second derivatives of ${y}_{1}(x):$\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & =\\operatorname{cos}⁡(x) \\\\ {y}_{1}^{″}(x) & =-\\operatorname{sin}⁡(x)\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}-\\operatorname{sin}⁡(x)+\\operatorname{sin}⁡(x) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{1}(x)$ is a solution to the equation.\n\n- Statement “${y}_{2}(x)=3\\operatorname{sin}⁡(x)$ is a solution to the equation” is true. First, we find the first and second derivatives of ${y}_{2}(x):$\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & =3\\operatorname{cos}⁡(x) \\\\ {y}_{2}^{″}(x) & =-3\\operatorname{sin}⁡(x)\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}-3\\operatorname{sin}⁡(x)+3\\operatorname{sin}⁡(x) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{2}(x)$ is a solution to the equation.\n\n- Statement “The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation” is false. Both ${y}_{1}$ and ${y}_{2}$ are solutions of the equation. To check if these functions are linearly independent, we compute the Wronskian:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}\\operatorname{sin}⁡(x) & 3\\operatorname{sin}⁡(x) \\\\ \\operatorname{cos}⁡(x) & 3\\operatorname{cos}⁡(x)\\end{aligned}| \\\\  & =\\operatorname{sin}⁡(x)\\cdot 3\\operatorname{cos}⁡(x)-3\\operatorname{sin}⁡(x)\\cdot \\operatorname{cos}⁡(x) \\\\  & =3\\operatorname{sin}⁡(x)\\operatorname{cos}⁡(x)-3\\operatorname{sin}⁡(x)\\operatorname{cos}⁡(x) \\\\  & =0\\end{aligned}\n$$\n\nSince the  Wronskian equals $0$ for all $x\\in R,$ the functions are not linearly independent. Hence, ${y}_{1}(x)$ and ${y}_{2}(x)$ don't form a set of fundamental solutions to the equation.\n\nTherefore, the correct answer is “${y}_{1}(x)=\\operatorname{sin}⁡(x)$ is a solution to the equation”; “${y}_{2}(x)=3\\operatorname{sin}⁡(x)$ is a solution to the equation” only."} {:db/id #edb/ref 17592186152570 :knowledge-point/_questions [{:db/id #edb/ref 17592186152280 :knowledge-point/id #uuid "e66005fe-df33-590a-9d9c-91947cd4a608" :knowledge-point/title "Identifying Fundamental Sets of Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1e82711-ac51-5228-a804-1fa990c75224" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459805} {:answer/id #uuid "863f65d1-6c09-5fc7-9229-f2192ef8b701" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459806}] :answer-field/correct {:answer/id #uuid "863f65d1-6c09-5fc7-9229-f2192ef8b701" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459806} :answer-field/id #uuid "782a33f2-c589-5a92-89c3-730260ecc10a" :answer-field/key "${y}_{1}(x)={e}^{-x}$ is a solution to the equation." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460769} {:answer-field/choices [{:answer/id #uuid "d25a391a-473d-59a2-a939-6f566cc09ec1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459807} {:answer/id #uuid "b2ed9d3b-064f-5134-a779-fd16eac2b208" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459808}] :answer-field/correct {:answer/id #uuid "d25a391a-473d-59a2-a939-6f566cc09ec1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459807} :answer-field/id #uuid "48062bbd-ee12-5738-a47f-04a9032c16f2" :answer-field/key "${y}_{2}(x)=1+{e}^{-x}$ is a solution to the equation." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460770} {:answer-field/choices [{:answer/id #uuid "1a6bdefd-4eb4-5101-b957-85e5319b7fa8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459809} {:answer/id #uuid "92b100bd-b5bc-5ebe-a3ef-e3746c7a2aa2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459810}] :answer-field/correct {:answer/id #uuid "1a6bdefd-4eb4-5101-b957-85e5319b7fa8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459809} :answer-field/id #uuid "f03c3346-2011-57c2-9e66-8f81c201e4aa" :answer-field/key "The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460771} {:answer-field/choices [{:answer/id #uuid "a4a59468-f654-511b-b7a1-04f01a614ee0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668014} {:answer/id #uuid "2584cc39-9a67-5af0-9c26-e66ed00ead44" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668015}] :answer-field/correct {:answer/id #uuid "a4a59468-f654-511b-b7a1-04f01a614ee0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668014} :answer-field/id #uuid "bca4921a-1f2e-5a99-8549-861873b044c0" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668284}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7e7ec306-a94e-573b-92ac-0141248c8937" :question/math-academy-id "q-333522" :question/problem "$$\n{y}^{″}+7{y}^{′}+6y=0\n$$\n\nConsider the differential equation above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation. \n\nLet's check each statement in turn.\n\n- Statement “${y}_{1}(x)={e}^{-x}$ is a solution to the equation” is true. We find the first and second derivatives of ${y}_{1}(x):$\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & =-{e}^{-x} \\\\ {y}_{1}^{″}(x) & ={e}^{-x}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{e}^{-x}+7(-{e}^{-x})+6{e}^{-x} & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{1}(x)$ is a solution to the equation.\n\n- Statement “${y}_{2}(x)=1+{e}^{-x}$ is a solution to the equation” is false. We find the first and second derivatives of ${y}_{2}(x):$\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & =-{e}^{-x} \\\\ {y}_{2}^{″}(x) & ={e}^{-x}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{e}^{-x}+7(-{e}^{-x})+6(1+{e}^{-x}) & =0 \\\\ 6 & =0\\,\\times \\end{aligned}\n$$\n\nSo, ${y}_{2}(x)$ is not a solution to the equation.\n\n- Statement “The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation” is false. Since ${y}_{2}(x)$ is not a solution of the given differential equation, ${y}_{1}(x)$ and ${y}_{2}(x)$ don't form a set of fundamental solutions to the equation.\n\nTherefore, the correct answer is “${y}_{1}(x)={e}^{-x}$ is a solution to the equation” only."} {:db/id #edb/ref 17592186152731 :knowledge-point/_questions [{:db/id #edb/ref 17592186152263 :knowledge-point/id #uuid "bfbebc20-1b48-5718-a057-b743c8af8de1" :knowledge-point/title "Identifying Bijections For Functions Defined on the Set of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3677e56c-6799-57b0-a2d4-f62b70624054" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477413} {:answer/id #uuid "986ca73f-18b3-50fc-93d5-8e624b067635" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477414}] :answer-field/correct {:answer/id #uuid "3677e56c-6799-57b0-a2d4-f62b70624054" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477413} :answer-field/id #uuid "e79b7a06-269e-5a7e-94eb-e32048cbf57a" :answer-field/key "The function is an injection" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477676} {:answer-field/choices [{:answer/id #uuid "6d7494d5-369a-50ec-84c5-6ae29165167e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477415} {:answer/id #uuid "432bc379-c608-5673-b288-439236462e6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477416}] :answer-field/correct {:answer/id #uuid "6d7494d5-369a-50ec-84c5-6ae29165167e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477415} :answer-field/id #uuid "21693608-ac7d-5fa0-ad21-5b2b41f2c025" :answer-field/key "The function is a surjection" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477677} {:answer-field/choices [{:answer/id #uuid "f7b823b5-896c-5e38-9546-157a5a41bc8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477417} {:answer/id #uuid "19fe52d7-263e-54d5-b802-087079d99e8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477418}] :answer-field/correct {:answer/id #uuid "f7b823b5-896c-5e38-9546-157a5a41bc8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477417} :answer-field/id #uuid "acae7c55-2445-5861-bd53-dba6dee4e0e4" :answer-field/key "The function is a bijection" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477678} {:answer-field/choices [{:answer/id #uuid "4846b637-3704-5a87-ae63-069150d28303" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668106} {:answer/id #uuid "cce7be73-c8f3-5bbe-b820-874f64da8103" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668107}] :answer-field/correct {:answer/id #uuid "cce7be73-c8f3-5bbe-b820-874f64da8103" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668107} :answer-field/id #uuid "7153064b-a663-59e1-a50d-c355f350f7c7" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668330}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ed18a3e4-6415-576f-b0e6-2282d7b910ac" :question/math-academy-id "q-76219" :question/problem "For the function $f:R\\to R$ defined by $f(x)={x}^{2},$ which of the following  statements are true? \n\nSelect all that apply." :question/worked-solution "Recall that a function $f:X\\to Y$ is \n\n- an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ whenever $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2},$\n\n- a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y,$\n\n- a bijection if it is both a surjection and an injection.\n\nWith this in mind, let's check each statement.\n\n- Statement “The function is an injection” is false. For instance, $f(2)=4=f(-2)$, but $2\\ne -2.$ So, $f(x)$ is not an injection.\n\n- Statement “The function is a surjection” is false. For example, there is no $x\\in R$ such that $f(x)=-1.$ So, $f(x)$ is not a surjection.\n\n- Statement “The function is a bijection” is false because the function is not both an injection and a surjection.\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186152809 :knowledge-point/_questions [{:db/id #edb/ref 17592186152192 :knowledge-point/id #uuid "42bc95a3-4e0c-5487-8427-31cee0ecf80b" :knowledge-point/title "Identifying Solutions of Linear ODEs Using the Sum Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19ac0897-f919-5edf-bf78-26e13f92883d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460227} {:answer/id #uuid "5cac7a37-3782-5a73-b5ca-7a757aae2a8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460228}] :answer-field/correct {:answer/id #uuid "19ac0897-f919-5edf-bf78-26e13f92883d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460227} :answer-field/id #uuid "4f68fb17-bbf0-5de2-a733-f061bc57f907" :answer-field/key "$y(x)=(\\operatorname{sin}⁡x\\operatorname{cos}⁡x)^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460980} {:answer-field/choices [{:answer/id #uuid "38299350-adac-58c2-b237-ae74f9e17918" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460229} {:answer/id #uuid "d576b556-948d-5f01-85dd-7dbbbbb23e10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460230}] :answer-field/correct {:answer/id #uuid "38299350-adac-58c2-b237-ae74f9e17918" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460229} :answer-field/id #uuid "f893192f-f2df-574d-b0f9-690d9e384ab5" :answer-field/key "$y(x)=x\\operatorname{sin}⁡x\\operatorname{cos}⁡x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460981} {:answer-field/choices [{:answer/id #uuid "88d4d6b6-5445-510e-9981-988d2a0d34df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460231} {:answer/id #uuid "70814542-0d28-542a-97d6-915bb53990c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460232}] :answer-field/correct {:answer/id #uuid "70814542-0d28-542a-97d6-915bb53990c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460232} :answer-field/id #uuid "d26bf839-1097-5aab-ab35-a98e10712050" :answer-field/key "$y(x)=\\operatorname{sin}⁡x+\\operatorname{cos}⁡x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460982} {:answer-field/choices [{:answer/id #uuid "e000fa92-61c3-5e97-9b66-14d804e5b782" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668110} {:answer/id #uuid "cc23552a-cdb5-5fb2-a881-fdf53254426d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668111}] :answer-field/correct {:answer/id #uuid "e000fa92-61c3-5e97-9b66-14d804e5b782" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668110} :answer-field/id #uuid "d7a63717-959c-57bd-a912-2014f4eacff0" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668332}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "46b25723-729d-510e-b94e-77440edfe286" :question/math-academy-id "q-79724" :question/problem "Given that ${y}_{1}(x)=\\operatorname{sin}⁡x$ and ${y}_{2}(x)=\\operatorname{cos}⁡x$ are solutions to a homogeneous, linear, second-order ODE, then according to the superposition principle which of the following must also be a solution to the equation?\n\nSelect all that apply." :question/worked-solution "According to the superposition principle, if the functions ${y}_{1}(x)$ and ${y}_{2}(x)$ are solutions to a homogeneous, linear differential equation, then $y(x)={y}_{1}(x)+{y}_{2}(x)$ is also a solution to the equation.\n\nLet's consider each option:\n\n- The function $y(x)=(\\operatorname{sin}⁡x\\operatorname{cos}⁡x)^{2}$ is **not** guaranteed to be a solution of the equation by the superposition principle. The superposition principle does not extend to the product of the known solutions.\n\n- The function $y(x)=x\\operatorname{sin}⁡x\\operatorname{cos}⁡x$ is **not** guaranteed to be a solution of the equation by the superposition principle. The superposition principle does not extend to the product of a function and the known solutions.\n\n- The function $y(x)=\\operatorname{sin}⁡x+\\operatorname{cos}⁡x$ is a solution of the equation by the superposition principle.\n\nTherefore, the correct answer is $y(x)=\\operatorname{sin}⁡x+\\operatorname{cos}⁡x$ only."} {:db/id #edb/ref 17592186152819 :knowledge-point/_questions [{:db/id #edb/ref 17592186152196 :knowledge-point/id #uuid "a347133c-5e5a-5dd2-89ef-bdd14245ee6b" :knowledge-point/title "Identifying Injections For Functions Defined on the Set of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f78d8474-b7db-5ba0-8689-12d453fbad7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460239} {:answer/id #uuid "d0bbc983-2258-5972-96b8-7f137a39e449" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460240}] :answer-field/correct {:answer/id #uuid "f78d8474-b7db-5ba0-8689-12d453fbad7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460239} :answer-field/id #uuid "6e76259e-cc28-59a9-ae04-a17677637170" :answer-field/key "$f(-2)\\ne f(0)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460986} {:answer-field/choices [{:answer/id #uuid "412336dc-01af-52b8-82e5-1d35ce6a80fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460241} {:answer/id #uuid "cfa10937-de88-58d9-bb3c-1b823502fd3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460242}] :answer-field/correct {:answer/id #uuid "412336dc-01af-52b8-82e5-1d35ce6a80fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460241} :answer-field/id #uuid "49d1c497-51a6-5a06-b829-9044a6911447" :answer-field/key "$∀\\,{x}_{1},{x}_{2}\\in R,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460987} {:answer-field/choices [{:answer/id #uuid "1224b958-4ce7-5572-b30e-6b81553dfae6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460243} {:answer/id #uuid "0b37fb7a-7125-50a7-a5dd-3d0e07ca6d8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460244}] :answer-field/correct {:answer/id #uuid "1224b958-4ce7-5572-b30e-6b81553dfae6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460243} :answer-field/id #uuid "67a5ad5d-8099-50e0-a241-4540894a930a" :answer-field/key "$f$ is **one-to-one**" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460988} {:answer-field/choices [{:answer/id #uuid "ce8eea8d-ec2d-5a91-958d-a18421906e4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668112} {:answer/id #uuid "7de70ac9-b46f-56fb-bd4e-038889076a48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668113}] :answer-field/correct {:answer/id #uuid "7de70ac9-b46f-56fb-bd4e-038889076a48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668113} :answer-field/id #uuid "8977518d-3565-5ea3-b9b0-6a36a5095ebe" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668333}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0c274592-717b-5063-8a47-5f35487eca60" :question/math-academy-id "q-80091" :question/problem "![](images/9d/9df0c9dd8b76ac337b6110fc92019924ad2ee1c4cc0da8216c27709b641a8451.png)\n\nWhich of the following statements are true regarding the function $f:R\\to R$ whose graph is shown above?\n\nSelect all that apply." :question/worked-solution "A function $f:X\\to Y$ is an injection (also known as *one-to-one*) if *every* element in $X$ is mapped to a *distinct* element in $Y:$ \n\n$f:X\\to Y$ is an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement $f(-2)\\ne f(0)$ is false. According to the graph, we have $f(-2)=f(0)=2.$\n\n- Statement “$∀\\,{x}_{1},{x}_{2}\\in R,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}$” is false. Again, we have $f(-2)=f(0)$ but $-2\\ne 0.$ So, it's *not true* that for all ${x}_{1}$ and ${x}_{2}$ contained within the domain $R,$ if $f({x}_{1})$ and $f({x}_{2})$ are equal, then we must have ${x}_{1}={x}_{2}.$\n\n- Statement “$f$ is **one-to-one**” is false. Indeed, since statement “$∀\\,{x}_{1},{x}_{2}\\in R,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}$” is false, $f$ is not an injection (also known as *one-to-one*).\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186152823 :knowledge-point/_questions [{:db/id #edb/ref 17592186152198 :knowledge-point/id #uuid "0ad76e6b-acef-5221-8852-71dc42625bf3" :knowledge-point/title "Determining a Correct Function Used to Define a Double Integral Over a Non-Rectangular Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c9626fb4-cff7-5f72-a3da-eff590c67d0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477455} {:answer/id #uuid "b75c9c36-7dd1-5943-93dc-db6d2394a2c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477456}] :answer-field/correct {:answer/id #uuid "b75c9c36-7dd1-5943-93dc-db6d2394a2c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477456} :answer-field/id #uuid "412e2bd2-f4cd-5ab4-81ea-96d5defa60f4" :answer-field/key "$\\left\\{\\begin{aligned}xy+{y}^{2}, & (x,y)\\in D \\\\ 0, & (x,y)\\notin D\\end{aligned}\\right.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477697} {:answer-field/choices [{:answer/id #uuid "59646261-7506-5533-a028-9e320a20cc81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477457} {:answer/id #uuid "5b40393c-448e-5584-bb5f-c1974488ef49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477458}] :answer-field/correct {:answer/id #uuid "59646261-7506-5533-a028-9e320a20cc81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477457} :answer-field/id #uuid "2df8d22e-5497-5f1d-b286-74922e1a1cf2" :answer-field/key "$\\left\\{\\begin{aligned}xy+{y}^{2}, & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}\\right.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477698} {:answer-field/choices [{:answer/id #uuid "071029fa-4c51-5606-a733-ae4126d8cd62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477459} {:answer/id #uuid "4339f87d-cf57-5b64-b7ad-544e826fcafa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477460}] :answer-field/correct {:answer/id #uuid "4339f87d-cf57-5b64-b7ad-544e826fcafa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477460} :answer-field/id #uuid "cb36d37d-bfeb-5eb9-a7dc-0098e584aa18" :answer-field/key "$\\left\\{\\begin{aligned}xy+{y}^{2}, & (x,y)\\in D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}\\right.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477699} {:answer-field/choices [{:answer/id #uuid "178194c8-9347-5501-8f90-86cc1ba0c11c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668114} {:answer/id #uuid "12a3da08-6066-54c7-b3f8-e3f007d6a14f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668115}] :answer-field/correct {:answer/id #uuid "178194c8-9347-5501-8f90-86cc1ba0c11c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668114} :answer-field/id #uuid "ea77ca65-16b3-5e6d-ab60-f9ca93164591" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668334}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "75838641-c52f-5634-aa18-714596e405a2" :question/math-academy-id "q-80265" :question/problem "Let $D$ be a finite region enclosed by the curve $y=1-{x}^{2}$ and the $x$-axis. If $R=[-2,2]\\times [-1,1],$ and\n\n$$\n{∬}_{D}(xy+{y}^{2})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nSelect all that apply." :question/worked-solution "First, let's draw our region $D$ and rectangle $R:$\n\n![](images/66/66f4c5d8824bf692d096ed533d90c9fdcf80c3725828e9033308757a0cdaa779.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal $xy+{y}^{2}$ on $D$ and to be equal $0$ outside $D,$ we obtain\n\n$$\n{∬}_{D}(xy+{y}^{2})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given functions.\n\n- Functions $\\left\\{\\begin{aligned}xy+{y}^{2}, & (x,y)\\in D \\\\ 0, & (x,y)\\notin D\\end{aligned}\\right.$ and $\\left\\{\\begin{aligned}xy+{y}^{2}, & (x,y)\\in D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}\\right.$ equal $xy+{y}^{2}$ on $D$ and equal $0$ outside $D.$\n\n- We cannot use function $\\left\\{\\begin{aligned}xy+{y}^{2}, & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}\\right.$. The $xy$ term integrates to zero over both regions by symmetry. Over $D$, the integral of $y^2$ is $\\int_{-1}^{1}(1-x^2)^3/3\\,\\mathrm{d}x=32/105$. Over $R$, it is $4\\int_{-1}^{1}y^2\\,\\mathrm{d}y=8/3$. These values are different, so function $\\left\\{\\begin{aligned}xy+{y}^{2}, & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}\\right.$ does not satisfy the required equality.\n\nTherefore, the correct answer is $\\left\\{\\begin{aligned}xy+{y}^{2}, & (x,y)\\in D \\\\ 0, & (x,y)\\notin D\\end{aligned}\\right.$; $\\left\\{\\begin{aligned}xy+{y}^{2}, & (x,y)\\in D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}\\right.$ only."} {:db/id #edb/ref 17592186152825 :knowledge-point/_questions [{:db/id #edb/ref 17592186152200 :knowledge-point/id #uuid "100ab73e-3dad-5b15-9da2-d244c67bcc9b" :knowledge-point/title "Identifying True Statements About Double Integrals Over Non-Rectangular Domains"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b99d976a-f891-5006-b006-1f89b0aed82b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460261} {:answer/id #uuid "fb9e8db1-87d7-5816-a338-04d02f84dbe4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460262}] :answer-field/correct {:answer/id #uuid "fb9e8db1-87d7-5816-a338-04d02f84dbe4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460262} :answer-field/id #uuid "8797be38-2755-5b03-9566-c909c3af6f17" :answer-field/key "${∬}_{D}({x}^{2}+{y}^{2})\\,\\text{d}A$ $={∬}_{R}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-2,2]\\times [-6,6]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460997} {:answer-field/choices [{:answer/id #uuid "f3bef40b-07d1-567e-a53c-086d7570c681" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460263} {:answer/id #uuid "561e321f-7bb3-54a3-9484-d79887120eed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460264}] :answer-field/correct {:answer/id #uuid "f3bef40b-07d1-567e-a53c-086d7570c681" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460263} :answer-field/id #uuid "632f4f21-76a6-593f-87d5-e2ea2f58cd86" :answer-field/key "${∬}_{R}({x}^{2}+{y}^{2})\\,\\text{d}A$ $={∬}_{D}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-1,1]\\times [-6,6]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460998} {:answer-field/choices [{:answer/id #uuid "e0bf614e-4003-5fba-acfe-eac707b4783b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460265} {:answer/id #uuid "537369b8-b99a-5260-b918-86b0e348c6b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460266}] :answer-field/correct {:answer/id #uuid "e0bf614e-4003-5fba-acfe-eac707b4783b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460265} :answer-field/id #uuid "c5cb38e4-a3c2-56e0-91a3-3fb1f913c942" :answer-field/key "${∬}_{D}({x}^{2}+{y}^{2})\\,\\text{d}A$ $={∬}_{R}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-2,2]\\times [-2,2]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460999} {:answer-field/choices [{:answer/id #uuid "7ed1f69d-4bc9-5fde-8a44-ca3050dfc384" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668116} {:answer/id #uuid "1bee5f25-1c5c-54b0-8318-1c0ce1c80503" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668117}] :answer-field/correct {:answer/id #uuid "7ed1f69d-4bc9-5fde-8a44-ca3050dfc384" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668116} :answer-field/id #uuid "2fd78c3d-07ec-5d05-ae27-090629849b53" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668335}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f66ee2a6-cdd7-5b19-895e-1ea6e9717b7b" :question/math-academy-id "q-80267" :question/problem "Let $D$ be a finite region enclosed between the curves $y={x}^{2}-6$ and $y=2-{x}^{2}.$ If \n\n$$\nf(x,y)={\\begin{aligned}{x}^{2}+{y}^{2}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, let's draw our region $D:$\n\n![](images/76/760595b548b2327b9c7c44f336d2c0c2b6a69688c887587f162f8ff2ac5bb5ab.png)\n\nNotice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)={\\begin{aligned}{x}^{2}+{y}^{2}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}({x}^{2}+{y}^{2})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given statements.\n\n- Statement “${∬}_{D}({x}^{2}+{y}^{2})\\,\\text{d}A$ $={∬}_{R}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-2,2]\\times [-6,6]$” is true. The rectangle $R$ covers the region $D$ completely.\n\n- Statement “${∬}_{R}({x}^{2}+{y}^{2})\\,\\text{d}A$ $={∬}_{D}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-1,1]\\times [-6,6]$” is false. The integrals have not been stated correctly with respect to the domains $R$ and $D$ (they have been swapped).\n\n- Statement “${∬}_{D}({x}^{2}+{y}^{2})\\,\\text{d}A$ $={∬}_{R}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-2,2]\\times [-2,2]$” is false. The rectangle $R$ does not cover the region $D.$\n\nTherefore, the correct answer is “${∬}_{D}({x}^{2}+{y}^{2})\\,\\text{d}A$ $={∬}_{R}f(x,y)\\,\\text{d}A,$ $\\,$ where $R=[-2,2]\\times [-6,6]$” only."} {:db/id #edb/ref 17592186152826 :knowledge-point/_questions [{:db/id #edb/ref 17592186152198 :knowledge-point/id #uuid "0ad76e6b-acef-5221-8852-71dc42625bf3" :knowledge-point/title "Determining a Correct Function Used to Define a Double Integral Over a Non-Rectangular Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e019259c-a480-51c7-adee-7e64d30db325" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460275} {:answer/id #uuid "3c62bbae-8481-50c2-900d-f50750addcab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460276}] :answer-field/correct {:answer/id #uuid "e019259c-a480-51c7-adee-7e64d30db325" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460275} :answer-field/id #uuid "ed25a22e-c812-5c51-97bf-3f552b015487" :answer-field/key "$\\left\\{\\begin{aligned}\\operatorname{sin}⁡y+{x}^{2}, & (x,y)\\in R∖D \\\\ 0, & (x,y)\\in D∖R\\end{aligned}\\right.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461004} {:answer-field/choices [{:answer/id #uuid "6f843948-205f-56d3-9549-f072aa94f578" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460277} {:answer/id #uuid "b8af677d-062c-5280-a8a3-61adf659040c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460278}] :answer-field/correct {:answer/id #uuid "b8af677d-062c-5280-a8a3-61adf659040c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460278} :answer-field/id #uuid "25f5cff7-ebff-5f64-bebb-f05d813e5cf0" :answer-field/key "$\\left\\{\\begin{aligned}0, & (x,y)\\in R∖D \\\\ \\operatorname{sin}⁡y+{x}^{2}, & (x,y)\\in D\\end{aligned}\\right.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461005} {:answer-field/choices [{:answer/id #uuid "bd0c58ef-21d5-557b-b1f3-8d8357abcf16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460279} {:answer/id #uuid "31b0c3fa-e8ff-5c10-b771-f69f3886b0f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460280}] :answer-field/correct {:answer/id #uuid "bd0c58ef-21d5-557b-b1f3-8d8357abcf16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460279} :answer-field/id #uuid "43970d5a-70f7-5eaf-9c95-866b3155b96e" :answer-field/key "$\\left\\{\\begin{aligned}\\operatorname{sin}⁡y+{x}^{2}, & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}\\right.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461006} {:answer-field/choices [{:answer/id #uuid "64f836f9-b340-58af-8138-99bf7c313ca0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668118} {:answer/id #uuid "1a426251-a322-5162-9d76-bb43d3565fba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668119}] :answer-field/correct {:answer/id #uuid "64f836f9-b340-58af-8138-99bf7c313ca0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668118} :answer-field/id #uuid "75a4e11f-f670-5e07-9402-53b82dcfe6f6" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668336}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5ca2c9d4-83c1-5596-b062-1537df902124" :question/math-academy-id "q-80425" :question/problem "![](images/d0/d09a23a1ae9f737c7f19ba83d6d20c3fbcea3c7deb71fa307264c90afabc6580.png)\n\nConsider the region $D$ shown above. If $R=[-2,2]\\times [-2,2],$ and\n\n$$\n{∬}_{D}(\\operatorname{sin}⁡y+{x}^{2})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nSelect all that apply." :question/worked-solution "First, let's draw our region $D$ and rectangle $R:$\n\n![](images/16/1620acdcfd3783df478322ebe5e81cb274d908db12d9c8bdc701fe21070b828f.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal $\\operatorname{sin}⁡y+{x}^{2}$ on $D$ and to be equal $0$ outside $D,$ we obtain\n\n$$\n{∬}_{D}(\\operatorname{sin}⁡y+{x}^{2})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given functions.\n\n- We cannot use functions $\\left\\{\\begin{aligned}\\operatorname{sin}⁡y+{x}^{2}, & (x,y)\\in R∖D \\\\ 0, & (x,y)\\in D∖R\\end{aligned}\\right.$ and $\\left\\{\\begin{aligned}\\operatorname{sin}⁡y+{x}^{2}, & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}\\right.$. Both of these functions are not identically zero for all points in $R\\,∖D.$ For example, $(x,y)=(2,2)\\in R\\,∖\\,D,$ but the functions are nonzero at this point.\n\n- Function $\\left\\{\\begin{aligned}0, & (x,y)\\in R∖D \\\\ \\operatorname{sin}⁡y+{x}^{2}, & (x,y)\\in D\\end{aligned}\\right.$ equals $\\operatorname{sin}⁡y+{x}^{2}$ on $D$ and equals $0$ outside $D.$\n\nTherefore, the correct answer is $\\left\\{\\begin{aligned}0, & (x,y)\\in R∖D \\\\ \\operatorname{sin}⁡y+{x}^{2}, & (x,y)\\in D\\end{aligned}\\right.$ only."} {:db/id #edb/ref 17592186152842 :knowledge-point/_questions [{:db/id #edb/ref 17592186152262 :knowledge-point/id #uuid "22bcdfb2-485a-5242-a5b5-dd9ef8cee027" :knowledge-point/title "Identifying Bijections For Functions Defined as Mapping Diagrams"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96bd8409-dcca-57c6-8689-ad6dde5d5e75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477467} {:answer/id #uuid "e8a67f51-6bff-5d06-8823-bdfd0c1ead32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477468}] :answer-field/correct {:answer/id #uuid "e8a67f51-6bff-5d06-8823-bdfd0c1ead32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477468} :answer-field/id #uuid "cd70bb18-d2ea-5c5b-be24-6ea76cef2a3d" :answer-field/key "$f$ is a surjection" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477703} {:answer-field/choices [{:answer/id #uuid "dbbbd50a-9aae-560b-86aa-3fb9786b2d72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477469} {:answer/id #uuid "b37eb430-be64-52eb-b6e2-50acf8b43948" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477470}] :answer-field/correct {:answer/id #uuid "b37eb430-be64-52eb-b6e2-50acf8b43948" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477470} :answer-field/id #uuid "49d085fe-03b3-5d08-8e2f-d17d80eb7bf2" :answer-field/key "$f$ is an injection" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477704} {:answer-field/choices [{:answer/id #uuid "68410897-f5f5-5a84-b79c-ea9f5afaf679" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477471} {:answer/id #uuid "2a782488-c4de-5edf-9173-2ec218b074f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477472}] :answer-field/correct {:answer/id #uuid "2a782488-c4de-5edf-9173-2ec218b074f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477472} :answer-field/id #uuid "b0aa7905-ea8d-5afa-8c98-aeb6b8dc03fa" :answer-field/key "$f$ is a bijection" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477705} {:answer-field/choices [{:answer/id #uuid "c76f983e-b911-5050-a250-44f337d86395" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668130} {:answer/id #uuid "f35b8884-b736-5d17-9aa5-62b4f0909f7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668131}] :answer-field/correct {:answer/id #uuid "c76f983e-b911-5050-a250-44f337d86395" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668130} :answer-field/id #uuid "08f09b0a-9abf-55ed-812e-bab991c2ba78" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668342}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2b7fec18-8819-50a6-ad9e-b4237d8c4fc4" :question/math-academy-id "q-82109" :question/problem "![](images/51/5130380c907723f29eb6232b5de8ea1fb93716c20df983a47725cb3e29e71702.png)\n\nWhich of the following statements are true regarding the function $f:X\\to Y$ represented by the mapping diagram above?\n\nSelect all that apply." :question/worked-solution "Recall that a function $f:X\\to Y$ is \n\n- a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y,$\n\n- an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ whenever $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2},$\n\n- a bijection if it is both a surjection and an injection.\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement “$f$ is a surjection” is true. Indeed, according to the diagram, for every element $y\\in Y,$ we have an arrow from some element $x\\in X$ to it, which means that $f(x)=y.$ So, $f$ is a surjection.\n\n- Statement “$f$ is an injection” is true. As we can see from the diagram, there are no two distinct elements within $X$ that map to the same element in $Y.$ So, for all ${x}_{1}$ and ${x}_{2}$ contained within the domain $X,$ if $f({x}_{1})$ and $f({x}_{2})$ are equal, then we must have ${x}_{1}={x}_{2}.$ As a result, $f$ is an injection.\n\n- Statement “$f$ is a bijection” is true. Indeed, since both statements “$f$ is a surjection” and “$f$ is an injection” are true, $f$ is a bijection.\n\nTherefore, the correct answer is “$f$ is a surjection”; “$f$ is an injection”; “$f$ is a bijection”."} {:db/id #edb/ref 17592186157794 :knowledge-point/_questions [{:db/id #edb/ref 17592186157231 :knowledge-point/id #uuid "bc5b8688-3838-5e9e-9304-9a4c787034ee" :knowledge-point/title "Identifying Logically Equivalent Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d9123f6-1ac3-577d-8448-fa5f35090fb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477461} {:answer/id #uuid "7f5ec496-8711-51ea-967c-940ed57f12cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477462}] :answer-field/correct {:answer/id #uuid "7f5ec496-8711-51ea-967c-940ed57f12cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477462} :answer-field/id #uuid "a41e8230-3016-56f5-9ecd-0c0ca53982c9" :answer-field/key "$¬A∧B$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477700} {:answer-field/choices [{:answer/id #uuid "4b9f76af-3775-5573-8674-5ed519df7677" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477463} {:answer/id #uuid "c3b32afa-ec9b-50ed-9315-54748539b4b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477464}] :answer-field/correct {:answer/id #uuid "c3b32afa-ec9b-50ed-9315-54748539b4b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477464} :answer-field/id #uuid "e9bb9216-5611-5306-b6e2-7e2dbeb9f076" :answer-field/key "$¬(A∨¬B)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477701} {:answer-field/choices [{:answer/id #uuid "d2422dd1-c3e9-5d60-8594-d85ecf4d1266" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477465} {:answer/id #uuid "2d788219-eebe-5d12-9e1f-57b8008ed228" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477466}] :answer-field/correct {:answer/id #uuid "d2422dd1-c3e9-5d60-8594-d85ecf4d1266" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477465} :answer-field/id #uuid "ebb1ad31-5edb-5c7d-ae51-d6dab75641d2" :answer-field/key "$A∨¬B$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477702} {:answer-field/choices [{:answer/id #uuid "5b58a409-9835-554c-9263-a94bf44413ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668124} {:answer/id #uuid "2d3da413-77fa-5661-8ba9-a09b65565639" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668125}] :answer-field/correct {:answer/id #uuid "5b58a409-9835-554c-9263-a94bf44413ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668124} :answer-field/id #uuid "44af02af-4d61-52ea-b1a6-7d75ac588c04" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668339}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7074b983-3ace-5190-bf87-4742f8c8239b" :question/math-academy-id "q-81053" :question/problem "Which of the following statements are logically equivalent?\n\nSelect all that apply." :question/worked-solution "Two statements are logically equivalent if they have the same truth table. So, we construct a truth table for the three given statements:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,¬A∧B\\,$ | $\\,¬(A∨¬B)\\,$ | $\\,A∨¬B\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |\n\nWe see that only the statements $¬A∧B$ and $¬(A∨¬B)$ have the same truth table, so they are logically equivalent.\n\nTherefore, the correct answer is $¬A∧B$; $¬(A∨¬B)$ only."} {:db/id #edb/ref 17592186157803 :