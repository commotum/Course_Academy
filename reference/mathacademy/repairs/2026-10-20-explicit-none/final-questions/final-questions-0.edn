92186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459709} {:answer/id #uuid "6aa92fc9-03e6-57dc-9911-40ad3d1d7c33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459710}] :answer-field/correct {:answer/id #uuid "37ba7205-2106-5ef0-9ed6-ab1f3f726736" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459709} :answer-field/id #uuid "222d5208-0c8d-53a7-9d1a-051fc3b939a2" :answer-field/key "$¬(P⇒Q)≡P∨¬Q$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460721} {:answer-field/choices [{:answer/id #uuid "2328ffda-b122-53b8-b9a4-de410c71b9c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667986} {:answer/id #uuid "783d876b-fe27-530c-b120-390bc684a953" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667987}] :answer-field/correct {:answer/id #uuid "2328ffda-b122-53b8-b9a4-de410c71b9c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667986} :answer-field/id #uuid "b21027a6-9ed8-57cd-8a4d-d038b9377029" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668270}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "866aa1bc-982d-58ab-8e07-dd5148fa5235" :question/math-academy-id "q-182470" :question/problem "Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's examine each of our statements:\n\n- Statement $P⇒Q≡¬P∨Q$ is true. Indeed, $P⇒Q$ is logically equivalent to the disjunction $¬P∨Q.$\n\n- Statement $¬(P⇒Q)≡P∧¬Q$ is true, while statement $¬(P⇒Q)≡P∨¬Q$ is false. From part $P⇒Q≡¬P∨Q$, we have the following equivalence:\n\n$$\nP⇒Q≡¬P∨Q\n$$\n\nBy negating this statement, we get\n\n$$\n¬(P⇒Q)≡¬(¬P∨Q).\n$$\n\nDistributing the negation over the disjunction using De Morgan's law, we have\n\n$$\n¬(¬P∨Q)≡¬(¬P)∧¬Q.\n$$\n\nCanceling out double negation, we reach\n\n$$\nP∧¬Q.\n$$\n\nSo, $¬(P⇒Q)$ is equivalent to $P∧¬Q.$\n\nTherefore, the correct answer is $P⇒Q≡¬P∨Q$; $¬(P⇒Q)≡P∧¬Q$ only."} {:db/id #edb/ref 17592186064512 :knowledge-point/_questions [{:db/id #edb/ref 17592186064316 :knowledge-point/id #uuid "8edb0a6c-f22f-56cf-9545-2fae93896db2" :knowledge-point/title "Verifying Continuity at a Point Using the Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a8662b0-fb2f-5171-b01f-382934bc5cc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459553} {:answer/id #uuid "61f973b1-b0c6-5b87-b6b1-9ba65dc89e05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459554}] :answer-field/correct {:answer/id #uuid "61f973b1-b0c6-5b87-b6b1-9ba65dc89e05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459554} :answer-field/id #uuid "6f9e9c56-fe3f-5f92-abe3-36a570dc0f56" :answer-field/key "$f(x)$ is defined at $x=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460643} {:answer-field/choices [{:answer/id #uuid "930eb0b7-9c85-56f1-9e64-eacc6678902f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459555} {:answer/id #uuid "6f616fbf-4237-5137-ba0c-efb9f6a5bb3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459556}] :answer-field/correct {:answer/id #uuid "6f616fbf-4237-5137-ba0c-efb9f6a5bb3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459556} :answer-field/id #uuid "076dd6c9-01bd-509f-a759-2c228cec2286" :answer-field/key "${lim}_{x\\to {1}^{-}}f(x)={lim}_{x\\to {1}^{+}}f(x)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460644} {:answer-field/choices [{:answer/id #uuid "3c69d8cc-0615-5b2a-9991-d9a975a062ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459557} {:answer/id #uuid "6a424ca2-d617-545e-aa58-f149fde873dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459558}] :answer-field/correct {:answer/id #uuid "6a424ca2-d617-545e-aa58-f149fde873dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459558} :answer-field/id #uuid "b1722d0e-c273-58cd-a707-9e97e58b4993" :answer-field/key "${lim}_{x\\to 1}f(x)=f(1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460645} {:answer-field/choices [{:answer/id #uuid "3685fa34-c23b-5bb9-8b7e-da2374e5c1e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459559} {:answer/id #uuid "d61e3594-67cd-5c88-9509-91fe787b5472" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459560}] :answer-field/correct {:answer/id #uuid "d61e3594-67cd-5c88-9509-91fe787b5472" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459560} :answer-field/id #uuid "fe56aed9-5461-5f8d-9d63-0a8076cff1cd" :answer-field/key "$f(x)$ is continuous at $x=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460646} {:answer-field/choices [{:answer/id #uuid "db36c5c5-6df1-54da-ab53-6e4b7a6a5943" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667966} {:answer/id #uuid "d1841b93-0ffa-5cca-83e0-a813df501b06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667967}] :answer-field/correct {:answer/id #uuid "db36c5c5-6df1-54da-ab53-6e4b7a6a5943" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667966} :answer-field/id #uuid "11464b73-fed5-5903-b8f0-d460d5e1e704" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668260}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9d96aa7c-3228-53f8-9efa-38bbf767192d" :question/math-academy-id "q-152832" :question/problem "Consider the following function:\n\n$$\nf(x)={\\begin{aligned}2x-1, & x<1 \\\\ 2-x, & x\\ge 1\\end{aligned}\n$$\n\nWhich of the following statements are true regarding $f(x)?$\n\nSelect all that apply." :question/worked-solution "To test for continuity of $f(x)$ at a point $x=c$, we need to check three conditions:\n\n- Does $f(c)$ exist?\n\n- Does ${lim}_{x\\to c}f(x)$ exist?\n\n- Does ${lim}_{x\\to c}f(x)=f(c)?$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement “$f(x)$ is defined at $x=1$” is true. Using the expression for the second branch of the function, we obtain that \n\n$$\nf(1)=2-(1)=1.\n$$\n\nSo, $f(x)$ is defined at $x=1.$ $\\,\\,✓$\n\n- Statement ${lim}_{x\\to {1}^{-}}f(x)={lim}_{x\\to {1}^{+}}f(x)$ is true. By calculating the one-sided limits, we get the following:\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{-}}f(x) & ={lim}_{x\\to {1}^{-}}(2x-1) \\\\  & =2(1)-1 \\\\  & =1 \\\\ {lim}_{x\\to {1}^{+}}f(x) & ={lim}_{x\\to {1}^{+}}(2-x) \\\\  & =2-(1) \\\\  & =1\\end{aligned}\n$$\n\nAs a result:\n\n$$\n{lim}_{x\\to {1}^{-}}f(x)={lim}_{x\\to {1}^{+}}f(x)\n$$\n\n \nTherefore, the limit of $f(x)$ at $x=1$ exists:\n\n$$\n{lim}_{x\\to 1}f(x)=1\\,\\,✓\n$$\n\n- Statement ${lim}_{x\\to 1}f(x)=f(1)$ is true. Indeed, we have that ${lim}_{x\\to 1}f(x)=1=f(1).$  $\\,\\,✓$\n\n- Statement “$f(x)$ is continuous at $x=1$” is true. Since all statements “$f(x)$ is defined at $x=1$”; ${lim}_{x\\to {1}^{-}}f(x)={lim}_{x\\to {1}^{+}}f(x)$; ${lim}_{x\\to 1}f(x)=f(1)$ are true, according to the continuity test, the function $f(x)$ is continuous at $x=1.$\n\nTherefore, the correct answer is \"All the statements are true.\""} {:db/id #edb/ref 17592186064582 :knowledge-point/_questions [{:db/id #edb/ref 17592186064165 :knowledge-point/id #uuid "ae256269-0bec-5d57-ac4a-eb0b07926f6f" :knowledge-point/title "Finding Critical Points and Then Classifying Them Using the Second Derivative Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba20353a-359a-579a-81b4-ad6b54d23cbf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459725} {:answer/id #uuid "abe7fc7d-0cee-5635-859d-bdb1efc11301" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459726}] :answer-field/correct {:answer/id #uuid "abe7fc7d-0cee-5635-859d-bdb1efc11301" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459726} :answer-field/id #uuid "faa90c59-18fa-592c-835f-dd823e7e23bc" :answer-field/key "$x=-1$ is a critical point of $f(x)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460729} {:answer-field/choices [{:answer/id #uuid "5030960c-213a-5c03-bcab-5063c0a40070" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459727} {:answer/id #uuid "abfb5bb1-e557-518d-b1a9-3fb683a8b8d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459728}] :answer-field/correct {:answer/id #uuid "abfb5bb1-e557-518d-b1a9-3fb683a8b8d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459728} :answer-field/id #uuid "4dca7c79-0c87-500a-89ac-e5450ae6d72b" :answer-field/key "${f}^{″}(-1)<0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460730} {:answer-field/choices [{:answer/id #uuid "e451b995-7b83-57a1-b453-0753fb215e09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459729} {:answer/id #uuid "d9d7f2ab-f0fe-5d95-b870-6cbb5376a51d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459730}] :answer-field/correct {:answer/id #uuid "e451b995-7b83-57a1-b453-0753fb215e09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459729} :answer-field/id #uuid "b2bba020-673d-5398-8c82-9a7282ae4c35" :answer-field/key "$f(x)$ has a relative minimum at $x=-1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460731} {:answer-field/choices [{:answer/id #uuid "a744d6c1-d8d2-5b45-bc1b-b3c71425dd7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667988} {:answer/id #uuid "f5ac53c4-b121-5711-8914-3c87a8394798" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667989}] :answer-field/correct {:answer/id #uuid "a744d6c1-d8d2-5b45-bc1b-b3c71425dd7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667988} :answer-field/id #uuid "e8f40bb8-251d-5729-b779-9e0d14e2d81d" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668271}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1fa08ecc-691c-5923-94fb-19ce5c958e14" :question/math-academy-id "q-21502" :question/problem "For the function $f(x)=2{x}^{3}-6x+12,$ which of the following statements are true?\n\nSelect all that apply." :question/requires-calculator true :question/worked-solution "We need to identify whether $x=-1$ is a critical point. If it is, we then need to classify it using the second derivative test.\n\nFirst, we need to identify the critical points. Differentiating $f(x)=2{x}^{3}-6x+12,$ we get\n\n$$\n{f}^{′}(x)=2\\cdot 3{x}^{2}-6=6{x}^{2}-6,\n$$\n\nand solving ${f}^{′}(x)=0,$ we get\n\n$$\n\\begin{aligned}6{x}^{2}-6 & =0 \\\\ 6({x}^{2}-1) & =0 \\\\ 6(x+1)(x-1) & =0 \\\\ x & =\\pm 1.\\end{aligned}\n$$\n\nSo we have critical points at $x=\\pm 1.$ We're interested in the critical point $x=-1.$\n\nNext, we need to determine the sign of ${f}^{″}(x)$ at this critical point. Computing ${f}^{″}(x),$ we get\n\n$$\n{f}^{″}(x)=12x,\n$$\n\nand evaluating ${f}^{″}(x)$ at $x=-1$, we get\n\n$$\n{f}^{″}(-1)=-12<0.\n$$\n\nThe second derivative is negative at $x=-1,$ so this critical point is a relative *maximum*. \n\nTherefore, comparing our results with the given statements, we conclude that:\n\n- $x=-1$ is a critical point of $f(x)\\,✓$\n\n- ${f}^{″}(-1)<0\\,✓$\n\n- $f(x)$ has a relative *maximum* at $x=-1\\,\\times $\n\nTherefore, the correct answer is “$x=-1$ is a critical point of $f(x)$”; ${f}^{″}(-1)<0$ only."} {:db/id #edb/ref 17592186064814 :knowledge-point/_questions [{:db/id #edb/ref 17592186064280 :knowledge-point/id #uuid "5b4b32f9-8362-5c81-a1fe-4457d91ae571" :knowledge-point/title "Identifying Functions That Satisfy the Mean Value Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "308c23ff-1eff-5628-8b09-64ca2aebdb91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460065} {:answer/id #uuid "287850b7-a355-59c4-aea1-eb7ffebcbb4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460066}] :answer-field/correct {:answer/id #uuid "287850b7-a355-59c4-aea1-eb7ffebcbb4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460066} :answer-field/id #uuid "f976515e-3b8c-585a-9e7d-392f11b1ec8f" :answer-field/key "$f(x)={x}^{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460899} {:answer-field/choices [{:answer/id #uuid "458f04df-9a80-5ac2-9b8f-e4bd017fbdb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460067} {:answer/id #uuid "407acba4-3722-588f-85dc-9922d329d2a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460068}] :answer-field/correct {:answer/id #uuid "407acba4-3722-588f-85dc-9922d329d2a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460068} :answer-field/id #uuid "bbd840a5-96a0-5a61-9948-1d1ce4f95701" :answer-field/key "$g(x)=|x|$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460900} {:answer-field/choices [{:answer/id #uuid "4c1e94e8-4982-5977-b24d-9f30a38f35c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460069} {:answer/id #uuid "5681eee1-761e-5e3d-92d2-5e3908c29a1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460070}] :answer-field/correct {:answer/id #uuid "4c1e94e8-4982-5977-b24d-9f30a38f35c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460069} :answer-field/id #uuid "36fc8ab0-84b0-50ac-bcd1-914034b5407e" :answer-field/key "$h(x)=\\operatorname{ln}⁡(x-1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460901} {:answer-field/choices [{:answer/id #uuid "3e6564ec-dd9b-5ce2-94a7-8aba2a8273d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668094} {:answer/id #uuid "75ae94d9-35a5-5e16-9ada-a9bc8b024b9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668095}] :answer-field/correct {:answer/id #uuid "3e6564ec-dd9b-5ce2-94a7-8aba2a8273d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668094} :answer-field/id #uuid "85e19dad-68a9-5f61-b6e1-494c5933c7b4" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668324}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9e7b61b7-5224-5508-b07f-2f649466a990" :question/math-academy-id "q-48352" :question/problem "Which of the following functions satisfies the conditions of the mean value theorem over the interval $[1,5]?$\n\nSelect all that apply." :question/worked-solution "For a function to satisfy the conditions of the mean value theorem over the interval $[1,5],$ the function must be continuous on $[1,5]$ and differentiable on $(1,5).$\n\nLet's check each function individually.\n\n- The function $f(x)={x}^{3}$ is continuous and differentiable on $(-\\infty ,\\infty ).$ In particular, it  is continuous on $[1,5]$ and differentiable on $(1,5).$ Therefore, $f(x)$ satisfies the conditions of the mean value theorem.\n\n- The function $g(x)=|x|$ is continuous on $[1,5]$ and differentiable on $(1,5)$ because it is equivalent to $p(x)=x$ over the given interval. Therefore, $g(x)$ satisfies the conditions of the mean value theorem. Note that the graph of $y=g(x)$ has a corner point at $x=0$ but this point does not lie inside $(1,5).$\n\n- The function  $h(x)=\\operatorname{ln}⁡(x-1)$ is not defined at $x=1$, so it is not continuous at $x=1$, which means it is not continuous on $[1,5].$ Therefore, $h(x)$ does not satisfiy the conditions of the mean value theorem.\n\nTherefore, only functions $f(x)={x}^{3}$ and $g(x)=|x|$ satisfy the conditions for the mean value theorem over the interval $[1,5].$"} {:db/id #edb/ref 17592186069313 :knowledge-point/_questions [{:db/id #edb/ref 17592186068700 :knowledge-point/id #uuid "81247553-750f-5bf7-a1c4-698ad63b5ae4" :knowledge-point/title "Identifying True Statements Regarding Left- and Right-Continuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8cd203b-0235-5547-88b9-dd0b5ff2c526" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459921} {:answer/id #uuid "000e824e-f9f5-5ba7-9c14-3a48d73bd0fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459922}] :answer-field/correct {:answer/id #uuid "f8cd203b-0235-5547-88b9-dd0b5ff2c526" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459921} :answer-field/id #uuid "ec72f3f5-0411-5c9a-9043-b8766cb1991d" :answer-field/key "The function is left-continuous at $x=-1$" :