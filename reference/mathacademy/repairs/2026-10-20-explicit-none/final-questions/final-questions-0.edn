41-a1ce-925daa85ec41" :answer-field/key "${\\int }_{C}∇f\\cdot \\text{d}r=0$ for any piecewise smooth path $C\\in {R}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460620} {:answer-field/choices [{:answer/id #uuid "9ea644c1-0089-5ce6-9c36-851f16684cb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667914} {:answer/id #uuid "aa7eefa9-0544-5a49-95ea-35c04ebfb56c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667915}] :answer-field/correct {:answer/id #uuid "9ea644c1-0089-5ce6-9c36-851f16684cb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667914} :answer-field/id #uuid "0697e6d0-3d3e-5782-af58-1eb3c156fa23" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668234}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "76c1a939-3dff-51ed-a845-c6333747802b" :question/math-academy-id "q-125424" :question/problem "Consider the scalar field $f(x,y)=\\frac{1}{1+{x}^{2}+{y}^{2}}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "If $F$ is a conservative vector field on ${R}^{2},$ then the circulation $Γ=0$ for any *closed* path $C\\in {R}^{2},$ that is \n\n$$\nΓ={∮}_{C}F\\cdot \\text{d}r=0.\n$$\n\nWith that in mind, let's consider each statement in turn:\n\n- Statement “$∇f$ is conservative” is true. The vector field $∇f$ is conservative by definition.\n\n- Statement “${∮}_{C}∇f\\cdot \\text{d}r=0$ for any closed path $C\\in {R}^{2}$” is true, while statement “${\\int }_{C}∇f\\cdot \\text{d}r=0$ for any piecewise smooth path $C\\in {R}^{2}$” is false. The result $Γ=0$ applies to closed curves only.\n\nTherefore, the correct answer is “$∇f$ is conservative”; “${∮}_{C}∇f\\cdot \\text{d}r=0$ for any closed path $C\\in {R}^{2}$” only."} {:db/id #edb/ref 17592186184603 :knowledge-point/_questions [{:db/id #edb/ref 17592186184151 :knowledge-point/id #uuid "437c168a-6799-5d13-bd9b-031290a84da6" :knowledge-point/title "Finding the Intervals of Concavity of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f3ba8a2-f374-5ff0-8d46-b1e4cc49e3c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459731} {:answer/id #uuid "d9f4725e-06fa-5bb9-8df0-53060c59bc67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459732}] :answer-field/correct {:answer/id #uuid "d9f4725e-06fa-5bb9-8df0-53060c59bc67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459732} :answer-field/id #uuid "f9f1976f-f067-5f01-8186-d3d93e10c9a1" :answer-field/key "$f(x)$ is concave up on $(-\\infty ,0)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460732} {:answer-field/choices [{:answer/id #uuid "f1d621ec-c2b1-5ad2-82cb-bb412ad83365" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459733} {:answer/id #uuid "19a8ec59-5411-56da-8ec9-e91bef5ecdf9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459734}] :answer-field/correct {:answer/id #uuid "f1d621ec-c2b1-5ad2-82cb-bb412ad83365" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459733} :answer-field/id #uuid "b0fa5f92-f5e8-5072-9751-731861433a89" :answer-field/key "$f(x)$ is concave down on $(-\\infty ,0)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460733} {:answer-field/choices [{:answer/id #uuid "37c26edb-fe62-5bab-936d-163bf45dbd60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459735} {:answer/id #uuid "1fe8759d-2a68-56ae-b5ab-81b73af5bad1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459736}] :answer-field/correct {:answer/id #uuid "1fe8759d-2a68-56ae-b5ab-81b73af5bad1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459736} :answer-field/id #uuid "1e07c1f5-403e-5e7b-a75c-b5c5379cc5da" :answer-field/key "$f(x)$ is concave down on $(0,\\infty )$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460734} {:answer-field/choices [{:answer/id #uuid "4d89c78a-e8bd-5da5-a576-1020c78d2451" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667990} {:answer/id #uuid "ce173500-4391-53ac-8b19-c403026d9e51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667991}] :answer-field/correct {:answer/id #uuid "4d89c78a-e8bd-5da5-a576-1020c78d2451" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667990} :answer-field/id #uuid "6f98fc31-39f3-5d63-b998-a0f7432e045e" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668272}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d75ab107-adf9-5afd-9401-bb2be46187e8" :question/math-academy-id "q-22703" :question/problem "Consider the function $f(x)={x}^{2}-2{e}^{x}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, we calculate the second derivative of $f(x),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =2x-2{e}^{x} \\\\ {f}^{″}(x) & =2-2{e}^{x}\\end{aligned}\n$$\n\nTo find where the function is concave up, we need to solve ${f}^{″}(x)>0:$\n\n$$\n\\begin{aligned}2-2{e}^{x} & >0 \\\\ {e}^{x} & <1.\\end{aligned}\n$$\n\nWe can solve this inequality by considering the graph of $y={e}^{x}.$\n\n![](images/c1/c199b110a3d19ecc23454f52dc7470af318ce871805595fd5fe7609dee5b0545.png)\n\nFrom the graph, we see that ${e}^{x}<1$ when $x<0.$ So the graph is concave up on the interval $(-\\infty ,0).$\n\nThe function $f(x)$ is concave down when ${f}^{″}(x)<0.$ By similar reasoning to before, this leads to the inequality ${e}^{x}>1,$ which has the solution $(0,\\infty ).$\n\nTherefore, the correct answer is “$f(x)$ is concave up on $(-\\infty ,0)$”; “$f(x)$ is concave down on $(0,\\infty )$” only."} {:db/id #edb/ref 17592186184608 :knowledge-point/_questions [{:db/id #edb/ref 17592186184151 :knowledge-point/id #uuid "437c168a-6799-5d13-bd9b-031290a84da6" :knowledge-point/title "Finding the Intervals of Concavity of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc9224b4-433a-5f80-a270-42e5f6c8f479" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459737} {:answer/id #uuid "75eef7c3-8ef6-538f-b899-cfbfca2092bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459738}] :answer-field/correct {:answer/id #uuid "bc9224b4-433a-5f80-a270-42e5f6c8f479" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459737} :answer-field/id #uuid "0273e3d2-8f40-57b0-8760-87a6e4708855" :answer-field/key "$f(x)$ is concave down on $(0,\\frac{\\pi }{2})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460735} {:answer-field/choices [{:answer/id #uuid "7e88db70-4c40-5b96-8eeb-76200ab3e765" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459739} {:answer/id #uuid "a4af2a11-d55c-5902-a757-e674f4fa1006" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459740}] :answer-field/correct {:answer/id #uuid "7e88db70-4c40-5b96-8eeb-76200ab3e765" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459739} :answer-field/id #uuid "feec5bc4-700c-509a-9a99-e729bc37944f" :answer-field/key "$f(x)$ is concave up on $(\\frac{\\pi }{2},\\pi )$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460736} {:answer-field/choices [{:answer/id #uuid "0f6278ba-04dc-5eaa-8a03-374d43ff3e3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459741} {:answer/id #uuid "e4f83e2f-da64-5b8f-9e71-f3ab0371c271" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459742}] :answer-field/correct {:answer/id #uuid "e4f83e2f-da64-5b8f-9e71-f3ab0371c271" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459742} :answer-field/id #uuid "57e62459-e37c-51f5-af05-d2e3cb154f78" :answer-field/key "$f(x)$ is concave down on $(\\frac{\\pi }{2},\\pi )$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460737} {:answer-field/choices [{:answer/id #uuid "f848609e-898d-569e-b76b-a004e6599c51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667992} {:answer/id #uuid "e09f4049-eecc-522d-a9ab-d8f4ed1717c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667993}] :answer-field/correct {:answer/id #uuid "f848609e-898d-569e-b76b-a004e6599c51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667992} :answer-field/id #uuid "4047d8af-d946-596b-9e6e-e224019a158c" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668273}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7adfc0dd-472e-52b3-a8a1-63de79ba74b4" :question/math-academy-id "q-22809" :question/problem "Consider the function $f(x)={e}^{x}\\operatorname{sin}⁡x,$ defined on $x\\in (0,\\pi ).$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, we calculate the second derivative of $f(x),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={e}^{x}\\operatorname{sin}⁡x+{e}^{x}\\operatorname{cos}⁡x={e}^{x}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x) \\\\ {f}^{″}(x) & ={e}^{x}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)+{e}^{x}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡x) \\\\  & ={e}^{x}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x+\\operatorname{cos}⁡x-\\operatorname{sin}⁡x) \\\\  & =2{e}^{x}\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTo find where the function is concave up, we need to solve ${f}^{″}(x)>0:$\n\n$$\n\\begin{aligned}2{e}^{x}\\operatorname{cos}⁡x & >0 \\\\ \\operatorname{cos}⁡x & >0.\\end{aligned}\n$$\n\nWe can solve this inequality by considering the graph of $y=\\operatorname{cos}⁡x$ over the interval $(0,\\pi ).$\n\n![](images/41/410e0af2ed20a065c27da5edaf0095dfd22c8a37a92e3d8fbaeece629cefa278.png)\n\nFrom the graph, we see that $\\operatorname{cos}⁡x>0$ when $0<x<\\frac{\\pi }{2}.$ So the graph is concave up on the interval $(0,\\frac{\\pi }{2}).$\n\nThe function $f(x)$ is concave down when ${f}^{″}(x)<0.$ By similar reasoning to before, this leads to the inequality $\\operatorname{cos}⁡x<0,$ which has the solution $(\\frac{\\pi }{2},\\pi ).$\n\nTherefore, the correct answer is “$f(x)$ is concave down on $(\\frac{\\pi }{2},\\pi )$” only."} {:db/id #edb/ref 17592186188911 :knowledge-point/_questions [{:db/id #edb/ref 17592186188273 :knowledge-point/id #uuid "e12609b7-286b-50a8-8373-a331d60ab904" :knowledge-point/title "Identifying True Statements Using the Rank-Nullity Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef4c3240-efcc-5031-be97-b18f24fa624c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477283} {:answer/id #uuid "80eef841-b3bb-539f-a20d-b7af5fdc129f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477284}] :answer-field/correct {:answer/id #uuid "ef4c3240-efcc-5031-be97-b18f24fa624c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477283} :answer-field/id #uuid "97b22468-5364-5814-ab56-00d3827125a4" :answer-field/key "$\\text{rank}(T)=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477611} {:answer-field/choices [{:answer/id #uuid "2ddb04cf-498a-5aa6-bd12-7e6b3799bde4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477285} {:answer/id #uuid "6462c36b-1577-5e5f-980f-afbd1f21ace1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477286}] :answer-field/correct {:answer/id #uuid "6462c36b-1577-5e5f-980f-afbd1f21ace1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477286} :answer-field/id #uuid "f417e3d1-8fa9-576f-97f4-84f0c7ed2417" :answer-field/key "$\\text{nullity}(T)=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477612} {:answer-field/choices [{:answer/id #uuid "e7971526-d720-5bf2-916b-1c3268cfc3a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477287} {:answer/id #uuid "ca68341f-f266-5714-a2d3-03c3de4d3096" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477288}] :answer-field/correct {:answer/id #uuid "e7971526-d720-5bf2-916b-1c3268cfc3a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477287} :answer-field/id #uuid "cf2f78e9-40f7-51c7-9823-236bb1c047ce" :answer-field/key "$T$ is a bijection" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477613} {:answer-field/choices [{:answer/id #uuid "dad2b53a-9b72-5aca-ae20-ced330f615f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668054} {:answer/id #uuid "113a1219-816f-5da1-b654-98dc8b40613a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668055}] :answer-field/correct {:answer/id #uuid "dad2b53a-9b72-5aca-ae20-ced330f615f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668054} :answer-field/id #uuid "d1582b0b-b3f5-527f-b60e-2369809f333a" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668304}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e86ac40c-9f96-593f-88c6-aef65bbc3b17" :question/math-academy-id "q-38136" :question/problem "Let $T:{R}^{5}\\to {R}^{5}$ be a linear transformation whose standard matrix is $T,$ and let ${{v}_{1},{v}_{2},{v}_{3}}$ be a set of linearly independent vectors in ${R}^{5}.$ Consider the following statement:\n\n*If  $\\text{Im}(T)=\\text{Span}{{v}_{1},{v}_{2},{v}_{3}}$, then $\\underline{\\phantom{xxxxxx}}.$ *\n\nWhich of the following can be placed into the blank space to make a true statement?\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{5}$ into ${R}^{5},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,\\left\\{\\,\\begin{aligned} & \\text{Im}(T)={R}^{5} \\\\  & \\text{rank}(T)=5 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}\\right.$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=5.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement $\\text{rank}(T)=1$ is false. Since $\\text{Im}(T)=\\text{Span}{{v}_{1},{v}_{2},{v}_{3}}$ and the set ${{v}_{1},{v}_{2},{v}_{3}}$ is linearly independent, we get that $\\text{rank}(T)=\\text{rank}(T)=3.$\n\n- Statement $\\text{nullity}(T)=2$ is true. According to the rank-nullity theorem, we obtain \n\n$$\n\\begin{aligned}\\text{nullity}(T) & =5-\\text{rank}(T) \\\\  & =5-3 \\\\  & =2.\\end{aligned}\n$$\n\n- Statement “$T$ is a bijection” is false. Since $\\text{rank}(T)\\ne 5$ (or since $\\text{nullity}(T)\\ne 0$), the linear transformation $T$ cannot be a bijection according to the invertible matrix theorem.\n\nTherefore, the correct option is $\\text{nullity}(T)=2$ only."} {:db/id #edb/ref 17592186193207 :knowledge-point/_questions [{:db/id #edb/ref 17592186192786 :knowledge-point/id #uuid "a024c46e-0374-5d03-b895-eb754ff7ad97" :knowledge-point/title "Identifying True Statements Regarding Interiors and Boundaries of Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fe507f3-8527-5f21-a721-634b58840b7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459593} {:answer/id #uuid "77761fd6-0e94-53bd-b8c5-72db41020fb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459594}] :answer-field/correct {:answer/id #uuid "2fe507f3-8527-5f21-a721-634b58840b7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459593} :answer-field/id #uuid "06f87cf3-f603-5eff-95ff-c1bae5dbb25b" :answer-field/key "$A$ contains all of its boundary points." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460663} {:answer-field/choices [{:answer/id #uuid "f2cd58fb-78f4-562a-9420-9f1156d98abf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459595} {:answer/id #uuid "12885778-ec5e-53cd-96b2-b72a20448566" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459596}] :answer-field/correct {:answer/id #uuid "12885778-ec5e-53cd-96b2-b72a20448566" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459596} :answer-field/id #uuid "08cf2006-06fc-5f94-8e1a-739789d7be8e" :answer-field/key "$A$ contains none of its boundary points." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460664} {:answer-field/choices [{:answer/id #uuid "586336b7-1f15-5b0c-a3b2-dad8f88b8daa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459597} {:answer/id #uuid "c8a5df21-20e1-5124-8aa9-f6e537cc7cde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459598}] :answer-field/correct {:answer/id #uuid "c8a5df21-20e1-5124-8aa9-f6e537cc7cde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459598} :answer-field/id #uuid "882b009d-1a05-565a-aa3f-fa7d9e3e447a" :answer-field/key "$\\text{int}\\,A=A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460665} {:answer-field/choices [{:answer/id #uuid "bb329b0f-20ce-57e1-87fe-ed68d1f3400b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667974} {:answer/id #uuid "ac4e2afc-7c5d-592d-b9f0-819cd8f18205" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667975}] :answer-field/correct {:answer/id #uuid "bb329b0f-20ce-57e1-87fe-ed68d1f3400b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667974} :answer-field/id #uuid "2316628c-08c1-52c5-87b5-46a49d659f6a" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668264}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1eb8e242-f7cb-5632-a09c-62dcc98103d6" :question/math-academy-id "q-161445" :question/problem "Consider the set $A,$ defined by \n\n$$\nA=\\{(x,y)\\in {R}^{2}\\,:\\,y<1-x\\}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nIn this case, the set $A$ and its boundary $∂A$ are shown below.\n\n![](images/51/5151df3c5b84ffaca9aa16b401cd9364fea10a240d39c9c28d815b36e417b16d.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nNotice that, in this case, the set $A$ contains none of its boundary points. \n\nWith that in mind, let's examine each statement:\n\n- Statement “$A$ contains all of its boundary points” is false, while statement “$A$ contains none of its boundary points” is true. As we've seen, $A$ contains none of its boundary points.\n\n- Statement $\\text{int}\\,A=A$ is true. Since $A$ contains none of its boundary points, we must have $\\text{int}\\,A=A.$\n\nTherefore, the correct answer is “$A$ contains none of its boundary points”; $\\text{int}\\,A=A$ only."} {:db/id #edb/ref 17592186193312 :knowledge-point/_questions [{:db/id #edb/ref 17592186192780 :knowledge-point/id #uuid "e3fe3596-340e-5155-bed3-cf25f5843d70" :knowledge-point/title "Identifying Whether Sets Represented Graphically Are Subspaces in Two-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e86471bd-e6c5-5896-af8e-c48e8e06dc45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459811} {:answer/id #uuid "0ae10483-1250-5ee8-a5b7-56019635b6ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459812}] :answer-field/correct {:answer/id #uuid "e86471bd-e6c5-5896-af8e-c48e8e06dc45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459811} :answer-field/id #uuid "3e3e684d-5745-5881-b7a9-0cb4fc6b3e66" :answer-field/key "![Diagram I](images/e7/e79e96039bc2ebbe1787345b90a84e42e7410c0ef500dfac37844bdc1a10e756.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :a