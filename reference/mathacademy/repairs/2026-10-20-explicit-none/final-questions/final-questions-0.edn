186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477282} :answer-field/id #uuid "2870ac10-bdff-5d8b-af67-13e6e02c0504" :answer-field/key "$\\text{rank}(T)<8$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477610} {:answer-field/choices [{:answer/id #uuid "9f95207b-533c-54da-97d3-ca314db9c397" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668052} {:answer/id #uuid "b5e03c5c-9f92-59d0-af5c-3ad1b7647c67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668053}] :answer-field/correct {:answer/id #uuid "9f95207b-533c-54da-97d3-ca314db9c397" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668052} :answer-field/id #uuid "cdaefd22-ab3c-53cd-bff7-d29dfd7ea3fd" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668303}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d2b1c7be-1664-54ba-8015-a807eb2f1187" :question/math-academy-id "q-38033" :question/problem "Which of the following statements are true given that $T:{R}^{8}\\to {R}^{8}$ is a linear transformation whose standard matrix is $T,$ and $T({v}_{1})=T({v}_{2})$ for some distinct vectors  ${v}_{1}$ and ${v}_{2}?$ \n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{8}$ into ${R}^{8},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,\\{\\,\\begin{aligned} & \\text{Im}(T)={R}^{8} \\\\  & \\text{rank}(T)=8 \\\\  & \\text{Ker}(T)=\\{0\\} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nSince $T$ is a linear transformation, we have that\n\n$$\nT({v}_{1})=T({v}_{2})\\,⟹\\,T({v}_{1}-{v}_{2})=0.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement $\\text{Ker}(T)=\\{0\\}$ is false. Since ${v}_{1}-{v}_{2}\\in \\text{Ker}(T)$ and ${v}_{1}\\ne {v}_{2},$ we must have that $\\text{Ker}(T)\\ne \\{0\\}.$\n\n- Statement “$T$ is invertible” is false. According to the invertible matrix theorem, since $\\text{Ker}(T)\\ne \\{0\\},$ the transformation $T$ and the matrix $T$ are not invertible.\n\n- Statement $\\text{rank}(T)<8$ is true. Since $T$ is not invertible, the invertible matrix theorem implies that $\\text{rank}(T)\\ne 8.$ In turn, this means that $\\text{rank}(T)<8.$\n\nTherefore, the correct answer is $\\text{rank}(T)<8$ only."} {:db/id #edb/ref 17592186129659 :knowledge-point/_questions [{:db/id #edb/ref 17592186129321 :knowledge-point/id #uuid "359bc41e-1b6d-5177-9642-4f8697bc5ba0" :knowledge-point/title "Identifying Rotation-Scaling Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "562f2805-9f09-5e89-b09c-94c4809435a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459909} {:answer/id #uuid "feaa5d1c-ea0d-51b8-a656-0e78ecb7f2db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459910}] :answer-field/correct {:answer/id #uuid "feaa5d1c-ea0d-51b8-a656-0e78ecb7f2db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459910} :answer-field/id #uuid "743ed65d-70d0-5027-9c43-b6b316cce648" :answer-field/key "$A=\\begin{bmatrix}2 & -5 \\\\ 5 & 2\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460821} {:answer-field/choices [{:answer/id #uuid "b08d56f9-5c6e-5427-8ac8-973f2cb2c0d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459911} {:answer/id #uuid "f842c9c8-bda5-5681-b9c2-ac48835e9445" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459912}] :answer-field/correct {:answer/id #uuid "b08d56f9-5c6e-5427-8ac8-973f2cb2c0d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459911} :answer-field/id #uuid "21401d46-cadc-5ebc-9505-4a1961e95c21" :answer-field/key "$B=\\begin{bmatrix}2 & -1 \\\\ -1 & 2\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460822} {:answer-field/choices [{:answer/id #uuid "535db015-38fb-51e0-b841-97ef9b67c6f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459913} {:answer/id #uuid "bac13582-2752-58d1-a164-33571b4f5329" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459914}] :answer-field/correct {:answer/id #uuid "bac13582-2752-58d1-a164-33571b4f5329" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459914} :answer-field/id #uuid "681d3363-4bb9-5097-bd6c-7727036faa45" :answer-field/key "$C=\\begin{bmatrix}-3 & 2 \\\\ -2 & -3\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460823} {:answer-field/choices [{:answer/id #uuid "ebca91bc-220c-5d0e-9f0d-cd01588ad61e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668056} {:answer/id #uuid "cf9e9537-658f-5593-89aa-8fb74261f375" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668057}] :answer-field/correct {:answer/id #uuid "ebca91bc-220c-5d0e-9f0d-cd01588ad61e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668056} :answer-field/id #uuid "74d2aa7f-685b-5c9d-800c-c6e74d4d2921" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668305}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d3837446-5faf-5668-beb3-7a2ca40df6bb" :question/math-academy-id "q-38517" :question/problem "Which of the following are rotation-scaling matrices?\n\nSelect all that apply." :question/worked-solution "A rotation-scaling matrix has the form \n\n$$\n\\begin{bmatrix}a & -b \\\\ b & a\\end{bmatrix},\n$$\n\n where $a$ and $b$ are real numbers that are not equal to zero simultaneously. Notice that the entries on the main diagonal are the same, while the antidiagonal entries have opposite signs.\n\nWith that in mind let's check each of the given matrices:\n\n- $A=\\begin{bmatrix}2 & -5 \\\\ 5 & 2\\end{bmatrix}$ is a rotation-scaling matrix.\n\n- $B=\\begin{bmatrix}2 & -1 \\\\ -1 & 2\\end{bmatrix}$ is *not* a rotation-scaling matrix since the entries on the antidiagonal do not have opposite signs.\n\n- $C=\\begin{bmatrix}-3 & 2 \\\\ -2 & -3\\end{bmatrix}$ is a rotation-scaling matrix.\n\nIn conclusion, the correct answer is $A=\\begin{bmatrix}2 & -5 \\\\ 5 & 2\\end{bmatrix}$; $C=\\begin{bmatrix}-3 & 2 \\\\ -2 & -3\\end{bmatrix}$ only."} {:db/id #edb/ref 17592186129698 :knowledge-point/_questions [{:db/id #edb/ref 17592186129154 :knowledge-point/id #uuid "a66188f6-3228-59e9-9766-0f9bacbe8443" :knowledge-point/title "Identifying True Statements Regarding the Graph of a Given Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e76d3042-f7ae-57ef-b396-eb6626b7976b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439667} {:answer/id #uuid "2a530406-e55f-5a02-bcae-6dda607cc6d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439668}] :answer-field/correct {:answer/id #uuid "2a530406-e55f-5a02-bcae-6dda607cc6d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439668} :answer-field/id #uuid "6d4c09b8-af08-5b44-aa99-0093f513761c" :answer-field/key "$x = 2$ is a root of even multiplicity." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440191} {:answer-field/choices [{:answer/id #uuid "0c2050e7-dbe2-5d05-86f9-06cb01ed3583" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439669} {:answer/id #uuid "39f80e33-1da7-5439-9b91-357f2d0f3496" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439670}] :answer-field/correct {:answer/id #uuid "39f80e33-1da7-5439-9b91-357f2d0f3496" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439670} :answer-field/id #uuid "8b11cd7d-37b5-5212-9ef6-22f0c845c9c6" :answer-field/key "$x = ± 1$ are roots of odd multiplicity." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440192} {:answer-field/choices [{:answer/id #uuid "abb18603-78f7-50e8-be5d-ea5aa74811ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439671} {:answer/id #uuid "bdfff5d6-10ab-57f7-a5b3-5fa3c88e84c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439672}] :answer-field/correct {:answer/id #uuid "abb18603-78f7-50e8-be5d-ea5aa74811ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439671} :answer-field/id #uuid "299234ca-1b77-5fea-b8e4-a49cfd0e7ccb" :answer-field/key "$p(0) = 2$." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440193} {:answer-field/choices [{:answer/id #uuid "58696808-96d3-58cd-b6b9-7d4bf0364eed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668060} {:answer/id #uuid "d697909a-acc9-5f90-97bd-6b75525dfc95" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668061}] :answer-field/correct {:answer/id #uuid "58696808-96d3-58cd-b6b9-7d4bf0364eed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668060} :answer-field/id #uuid "0780d307-28aa-5309-a5f1-f7c3ce63ce07" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668307}] :question/id #uuid "01c0cb00-762a-57c6-9d3d-dec1ec64cc03" :question/math-academy-id "q-38762" :question/problem "![](images/dc/dc2079e479351c8d0193961138aeb4dabd4689426c3e621668f314eb8445258f.png)\n\nThe graph of a polynomial $p(x)$ is shown above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "At x=2 the curve touches and turns at the x-axis (even multiplicity). At x=-1 and x=1 it crosses (odd multiplicity). The y-intercept is below zero, so p(0)=2 is false."} {:db/id #edb/ref 17592186129836 :knowledge-point/_questions [{:db/id #edb/ref 17592186129086 :knowledge-point/id #uuid "9110c50a-62db-5447-b4d0-60819c80eb31" :knowledge-point/title "Identifying Properties Related to Point Discontinuities Given a Function Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bb3ef39