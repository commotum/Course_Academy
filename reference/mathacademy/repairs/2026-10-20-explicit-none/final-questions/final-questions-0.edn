e/checkbox} :db/id #edb/ref 17592186477628} {:answer-field/choices [{:answer/id #uuid "2fd542d8-c589-50f8-b140-1b42ee57c42a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668072} {:answer/id #uuid "160c3def-4e78-5bc9-b0d6-6d916a63980e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668073}] :answer-field/correct {:answer/id #uuid "2fd542d8-c589-50f8-b140-1b42ee57c42a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668072} :answer-field/id #uuid "448c5a92-cb68-5d06-85eb-bc355cfa5526" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668313}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f1bdc4c9-5c09-5a10-a62f-cd8a566a9012" :question/math-academy-id "q-42438" :question/problem "Which of the following values lies in the domain of $y=\\operatorname{arctan}⁡x?$\n\nSelect all that apply." :question/worked-solution "Let's recall the graph of $y=\\operatorname{arctan}⁡x.$\n\n![](images/d7/d7984b9098d02bfc2b1e9a422aef919533abce54fbb94117e709c7613b0870a3.png)\n\nNote that:\n\n- The function is defined for all real numbers.\n\nTherefore, all the given values are in the domain of $y=\\operatorname{arctan}⁡x.$"} {:db/id #edb/ref 17592186111361 :knowledge-point/_questions [{:db/id #edb/ref 17592186110575 :knowledge-point/id #uuid "af0b18ca-54a2-5a24-a670-faa311096abc" :knowledge-point/title "Determining Points that Lie on the Curve of the Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56708daa-2130-56c2-b5e5-0e10fce06ad0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477377} {:answer/id #uuid "069f7725-2ffb-56bc-b017-8a08b698c7d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477378}] :answer-field/correct {:answer/id #uuid "56708daa-2130-56c2-b5e5-0e10fce06ad0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477377} :answer-field/id #uuid "26418a45-1f09-5776-8b0c-9a26dcd446be" :answer-field/key "$(\\frac{\\pi }{3},\\frac{1}{2})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477658} {:answer-field/choices [{:answer/id #uuid "6da7d1b6-c1c9-5c43-b65c-bb52d0bfe2e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477379} {:answer/id #uuid "6afe67fd-e587-5ac9-aa45-2ce8c2ddabaa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477380}] :answer-field/correct {:answer/id #uuid "6da7d1b6-c1c9-5c43-b65c-bb52d0bfe2e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477379} :answer-field/id #uuid "c101de9b-6361-5a36-80c8-a332d15ffc8e" :answer-field/key "$(\\frac{\\sqrt{2}}{2},\\frac{7\\pi }{4})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477659} {:answer-field/choices [{:answer/id #uuid "6fa74c9b-7103-53bd-92a6-59bf19bfd993" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477381} {:answer/id #uuid "4e8b820f-4706-5ad1-a108-f9996746f3da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477382}] :answer-field/correct {:answer/id #uuid "4e8b820f-4706-5ad1-a108-f9996746f3da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477382} :answer-field/id #uuid "aaa43211-a26e-56b1-b5fe-f62fbbce7f90" :answer-field/key "$(-\\frac{\\sqrt{2}}{2},\\frac{3\\pi }{4})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477660} {:answer-field/choices [{:answer/id #uuid "1188b658-3183-5944-acc4-465419611ed0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668098} {:answer/id #uuid "f06ce865-ca07-51c5-b16b-c6e0ce99e2a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668099}] :answer-field/correct {:answer/id #uuid "1188b658-3183-5944-acc4-465419611ed0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668098} :answer-field/id #uuid "8b6b0b02-dfed-5c84-b6d7-22891e1c7990" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668326}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4c5ae160-d78c-57fc-8666-ed9ed6778702" :question/math-academy-id "q-65828" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arccos}⁡x?$\n\nSelect all that apply." :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arccos}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{cos}⁡x.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arccos}⁡x,$ which is $y\\in [0,\\pi ].$\n\nWith this in mind, let's check each of the points. \n\n- First, we consider the point $(\\frac{\\pi }{3},\\frac{1}{2}).$ We note the following:\n\n- The point $(\\frac{1}{2},\\frac{\\pi }{3})$ does **not** lie on the graph of $y=\\operatorname{cos}⁡x.$  $\\,\\times $\n\nTherefore, the point $(\\frac{\\pi }{3},\\frac{1}{2})$ does **not** lie on the graph of $y=\\operatorname{arccos}⁡x.$\n\n- Next, we consider the point $(\\frac{\\sqrt{2}}{2},\\frac{7\\pi }{4}).$ We note the following:\n\n- The point $(\\frac{7\\pi }{4},\\frac{\\sqrt{2}}{2})$ lies on the graph of $y=\\operatorname{cos}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arccos}⁡x$ is $y\\in [0,\\pi ],$ and $y=\\frac{7\\pi }{4}$ does **not** lie within this range.   $\\,\\times $\n\nTherefore, the point $(\\frac{\\sqrt{2}}{2},\\frac{7\\pi }{4})$ does **not** lie on the graph of $y=\\operatorname{arccos}⁡x.$\n\n- Finally, we consider the point $(-\\frac{\\sqrt{2}}{2},\\frac{3\\pi }{4}).$ We note the following:\n\n- The point $(\\frac{3\\pi }{4},-\\frac{\\sqrt{2}}{2})$ lies on the graph of $y=\\operatorname{cos}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arccos}⁡x$ is $y\\in [0,\\pi ],$ and $y=\\frac{3\\pi }{4}$ lies within this range. $\\,✓$\n\nTherefore, the point $(-\\frac{\\sqrt{2}}{2},\\frac{3\\pi }{4})$ lies on the graph of $y=\\operatorname{arccos}⁡x.$"} {:db/id #edb/ref 17592186111366 :knowledge-point/_questions [{:db/id #edb/ref 17592186110588 :knowledge-point/id #uuid "7f045b43-4785-5989-8b5a-dcb8401d1bb3" :knowledge-point/title "Determining Points that Lie on the Graph of the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c3e5842-1547-59ba-9208-2bc031dae35e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477389} {:answer/id #uuid "c07f5b10-6f57-5305-b1e6-03784d7864e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477390}] :answer-field/correct {:answer/id #uuid "1c3e5842-1547-59ba-9208-2bc031dae35e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477389} :answer-field/id #uuid "9dbc26e7-585f-583e-9117-7c9855328c2e" :answer-field/key "$(1,\\frac{\\pi }{6})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477664} {:answer-field/choices [{:answer/id #uuid "71427446-42d1-50bc-96dc-6a7bcc3483b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477391} {:answer/id #uuid "7258453b-b30b-5cd8-9f5f-9a0316184e9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477392}] :answer-field/correct {:answer/id #uuid "7258453b-b30b-5cd8-9f5f-9a0316184e9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477392} :answer-field/id #uuid "443fd704-4af0-5164-a30d-449dc4a4896f" :answer-field/key "$(\\sqrt{3},\\frac{\\pi }{3})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477665} {:answer-field/choices [{:answer/id #uuid "440582ef-5343-57df-ae59-0ef5f8b6ba78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477393} {:answer/id #uuid "dd24ea94-65b3-5131-b858-7899c9ee14ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477394}] :answer-field/correct {:answer/id #uuid "dd24ea94-65b3-5131-b858-7899c9ee14ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477394} :answer-field/id #uuid "1841116c-b941-5647-9b76-e22ed9974dce" :answer-field/key "$(-1,-\\frac{\\pi }{4})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477666} {:answer-field/choices [{:answer/id #uuid "1617904e-7c5f-5a0b-adf5-f49b66f1908a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668100} {:answer/id #uuid "546293da-2472-533a-ae47-01369595f4ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668101}] :answer-field/correct {:answer/id #uuid "1617904e-7c5f-5a0b-adf5-f49b66f1908a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668100} :answer-field/id #uuid "86ea7c20-2334-5552-a7b9-9bd9de79f070" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668327}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b81fb291-176e-5b1d-97d6-f57c92461362" :question/math-academy-id "q-65990" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arctan}⁡x?$\n\nSelect all that apply." :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arctan}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{tan}⁡x.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arctan}⁡x,$ which is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}).$\n\nWith this in mind, let's check each of the points. \n\n- First,  we consider the point $(1,\\frac{\\pi }{6}).$ We note the following:\n\n- The point $(\\frac{\\pi }{6},1)$ does **not** lie on the graph of $y=\\operatorname{tan}⁡x.$  $\\,\\times $\n\nTherefore, the point $(1,\\frac{\\pi }{6})$ does **not** lie on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Next, we consider the point $(\\sqrt{3},\\frac{\\pi }{3}).$ We note the following:\n\n- The point $(\\frac{\\pi }{3},\\sqrt{3})$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=\\frac{\\pi }{3}$ lies within this range. $\\,✓$\n\nTherefore, the point $(\\sqrt{3},\\frac{\\pi }{3})$ lies on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Finally, we consider the point $(-1,-\\frac{\\pi }{4}).$ We note the following:\n\n- The point $(-\\frac{\\pi }{4},-1)$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=-\\frac{\\pi }{4}$ lies within this range. $\\,✓$\n\nTherefore, the point $(-1,-\\frac{\\pi }{4})$ does lie on the graph of $y=\\operatorname{arctan}⁡x.$"} {:db/id #edb/ref 17592186115749 :knowledge-point/_questions [{:db/id #edb/ref 17592186115236 :knowledge-point/id #uuid "64b2036f-da0f-59de-8a39-6b33e6cbdd04" :knowledge-point/title "Completing a True Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a433b800-1989-563e-83e7-5397c5645766" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459769} {:answer/id #uuid "f27cd420-457b-52b0-be46-420933044538" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459770}] :answer-field/correct {:answer/id #uuid "f27cd420-457b-52b0-be46-420933044538" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459770} :answer-field/id #uuid "6cb2e9f1-fb8f-51c5-b00d-72cffd6f3c70" :answer-field/key "$Ax=0$ has exactly one solution" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460751} {:answer-field/choices [{:answer/id #uuid "87a1cebe-01c8-5058-9714-b637af1f37da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459771} {:answer/id #uuid "b3681972-1d5a-565f-8458-5b8fb369970e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459772}] :answer-field/correct {:answer/id #uuid "87a1cebe-01c8-5058-9714-b637af1f37da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459771} :answer-field/id #uuid "66227881-d1e0-51a9-ab58-2ae984608738" :answer-field/key "$Ax=0$ has infinitely many solutions" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460752} {:answer-field/choices [{:answer/id #uuid "4aeb3e0e-1388-5c9a-acdc-1e8fd08c915c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459773} {:answer/id #uuid "b0269478-23f2-5548-a846-c1bfeff061d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459774}] :answer-field/correct {:answer/id #uuid "b0269478-23f2-5548-a846-c1bfeff061d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459774} :answer-field/id #uuid "41ad434b-4089-5c1e-9be7-18886b5005e0" :answer-field/key "$det(A)\\ne 0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460753} {:answer-field/choices [{:answer/id #uuid "df0aa631-4f7d-52ff-b8fa-e98cd55e1424" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667994} {:answer/id #uuid "8e129199-8e86-52c5-a1ed-68530da0b1fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667995}] :answer-field/correct {:answer/id #uuid "df0aa631-4f7d-52ff-b8fa-e98cd55e1424" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667994} :answer-field/id #uuid "58b8c8bb-f5d0-5691-b09e-ae65bb2f9d3c" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668274}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e42babae-3f60-5ad6-9c62-eaf91af5f106" :question/math-academy-id "q-32167" :question/problem "Which of the following completes the statement so that it is true:\n\n*If a $2\\times 2$-matrix $A$ is invertible, then $\\underline{\\phantom{xxxxxx}}$ . *\n\nSelect all that apply." :question/worked-solution "Recall that given $A=\\begin{bmatrix}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{bmatrix}$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\nNow, since the first part of the invertible matrix theorem is true ($A$ is invertible), all the other parts of the theorem are true too. Therefore, according to the theorem, only options “$Ax=0$ has exactly one solution” and $det(A)\\ne 0$ give us true statements:\n\n- *If $A$ is invertible, then $Ax=0$ has exactly one solution.* $\\,✓$\n\n- *If $A$ is invertible, then $det(A)\\ne 0.$* $\\,✓$"} {:db/id #edb/ref 17592186115752 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4bdc967-dd67-5770-b3b