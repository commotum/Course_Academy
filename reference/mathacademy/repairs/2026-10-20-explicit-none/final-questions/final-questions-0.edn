 :answer/value "false" :db/id #edb/ref 17592186460321} {:answer/id #uuid "4250ef8d-0db6-535f-a90f-5adee0079036" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460322}] :answer-field/correct {:answer/id #uuid "4250ef8d-0db6-535f-a90f-5adee0079036" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460322} :answer-field/id #uuid "fcd3e95a-2be7-576c-97fd-864d4440ee21" :answer-field/key "$¬Y∧(X∨X)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461027} {:answer-field/choices [{:answer/id #uuid "7ec04424-6119-5f63-b6ef-a037244461f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668128} {:answer/id #uuid "40d871c6-31ad-5629-bdaf-d1beaebc3e7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668129}] :answer-field/correct {:answer/id #uuid "7ec04424-6119-5f63-b6ef-a037244461f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668128} :answer-field/id #uuid "c2d72663-b026-5272-8122-e1bf527fda45" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668341}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "39f394a7-df4a-5b3c-93b6-e97b645cd2dc" :question/math-academy-id "q-81351" :question/problem "Which of the following statements are logically equivalent?\n\nSelect all that apply." :question/worked-solution "Two statements are logically equivalent if they have the same truth table. So, we construct a truth table for the three given statements:\n\n| $\\,X\\,$ | $\\,Y\\,$ | $\\,X∧¬Y\\,$ | $\\,¬(Y∨¬X)\\,$ | $\\,¬Y∧(X∨X)\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ |\n\nWe see that all three statements have the same truth table, so they are logically equivalent.\n\nTherefore, the correct answer is $X∧¬Y$; $¬(Y∨¬X)$; $¬Y∧(X∨X)$."} {:db/id #edb/ref 17592186157990 :knowledge-point/_questions [{:db/id #edb/ref 17592186157368 :knowledge-point/id #uuid "f901a3ab-3b58-51a1-b653-f88ac4b09060" :knowledge-point/title "Using the Second Derivative Test To Classify a Point on a Solution Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8268ccf0-99a1-5d50-8124-3a25abf40250" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460371} {:answer/id #uuid "467412e3-15b3-512a-a802-f684b3aad556" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460372}] :answer-field/correct {:answer/id #uuid "8268ccf0-99a1-5d50-8124-3a25abf40250" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460371} :answer-field/id #uuid "8f12e9d4-9113-5647-8742-cb9eb7878c4c" :answer-field/key "$(0,e)$ is a stationary point of the function $f$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461052} {:answer-field/choices [{:answer/id #uuid "e5834a2e-2485-5518-9c4e-a231b610596c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460373} {:answer/id #uuid "36f7dc46-36f6-5ffb-8b98-9f2a040465ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460374}] :answer-field/correct {:answer/id #uuid "e5834a2e-2485-5518-9c4e-a231b610596c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460373} :answer-field/id #uuid "a632297b-aee6-55bd-ae1d-e83e983aa846" :answer-field/key "$(0,e)$ is a local minimum point of the function $f$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461053} {:answer-field/choices [{:answer/id #uuid "f85fb627-473f-5914-840c-ec1363bd899e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460375} {:answer/id #uuid "29a59bd9-65df-5364-b6dd-86ae7f65047c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460376}] :answer-field/correct {:answer/id #uuid "f85fb627-473f-5914-840c-ec1363bd899e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460375} :answer-field/id #uuid "203247ac-2cf9-5872-b932-97a101cdfd65" :answer-field/key "$(0,e)$ is an inflection point of the function $f$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461054} {:answer-field/choices [{:answer/id #uuid "4130e1b7-7227-5593-8520-38085ed5028e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668134} {:answer/id #uuid "f8b8ba74-08a9-5edc-b5e0-dd14fe6fae05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668135}] :answer-field/correct {:answer/id #uuid "f8b8ba74-08a9-5edc-b5e0-dd14fe6fae05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668135} :answer-field/id #uuid "3661b3e3-bc87-56ba-9234-279af594fa20" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668344}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0ad3120d-6b06-5341-b227-fa4c2d83974e" :question/math-academy-id "q-89891" :question/problem "The function $y=f(x)$ satisfies the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=y{e}^{x}.\n$$\n\nGiven that the point $(0,e)$ lies on the graph of $y=f(x),$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, we find the value of the first and second derivatives of the function at the given point.\n\nTo find the first derivative of $f$ at $(0,e),$ we substitute the coordinates of our point into the differential equation:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{(0,e)} & ={(y{e}^{x})|}_{(0,e)} \\\\  & =e\\cdot {e}^{0} \\\\  & =e\\end{aligned}\n$$\n\nTo find the second derivative, we first need to differentiate the equation and then substitute the coordinates of the point:\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{\\text{d}y}{\\text{d}x}\\right) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(y{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(y)\\cdot {e}^{x}+y\\cdot \\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =\\frac{\\text{d}y}{\\text{d}x}\\cdot {e}^{x}+y{e}^{x} \\\\  & =(y{e}^{x}){e}^{x}+y{e}^{x} \\\\  & =y{e}^{2x}+y{e}^{x} \\\\ {\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(0,e)} & ={(y{e}^{2x}+y{e}^{x})|}_{(0,e)} \\\\  & =e\\cdot {e}^{2(0)}+e\\cdot {e}^{0} \\\\  & =2e \\\\  & >0\\end{aligned}\n$$\n\nWith that in mind, let's examine the statements in turn.\n\n- Statement “$(0,e)$ is a stationary point of the function $f$” is false. Indeed, since\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(0,e)}=e\\ne 0,\n$$\n\nwe obtain that $(0,e)$ is not a stationary point of the function $f.$\n\n- Statement “$(0,e)$ is a local minimum point of the function $f$” is false. There is no critical point at $(0,e),$ therefore we cannot have a local minimum at that point.\n\n- Statement “$(0,e)$ is an inflection point of the function $f$” is false. Since the second derivative is not zero, there is no inflection point at $(0,e).$\n\nTherefore, the correct answer is \"None of those listed.\""} {:db/id #edb/ref 17592186162457 :knowledge-point/_questions [{:db/id #edb/ref 17592186162155 :knowledge-point/id #uuid "35de7257-8d35-5f81-89be-c7faa73d6bc3" :knowledge-point/title "Determining Whether Two Random Variables are Independent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87397041-9730-5ac2-a54f-4f891bebe983" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459599} {:answer/id #uuid "81a4679b-33f0-5db9-bcd4-8c2fa9f080a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459600}] :answer-field/correct {:answer/id #uuid "87397041-9730-5ac2-a54f-4f891bebe983" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459599} :answer-field/id #uuid "98585a00-8503-5452-8f06-692b91a8edad" :answer-field/key "$P(X=1,Y=1)$ $=P(X=1)\\cdot P(Y=1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460666} {:answer-field/choices [{:answer/id #uuid "d1a0a1d9-e9bd-523d-979a-8498255ba1c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459601} {:answer/id #uuid "6922f743-73d0-5a55-99be-0d69f049e344" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459602}] :answer-field/correct {:answer/id #uuid "d1a0a1d9-e9bd-523d-979a-8498255ba1c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459601} :answer-field/id #uuid "71a67bd3-f3d9-56ab-8352-c30b3a171ccd" :answer-field/key "$P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460667} {:answer-field/choices [{:answer/id #uuid "afe8f777-32ed-5e0c-81b1-d151b12d83b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459603} {:answer/id #uuid "9c039497-425d-51d2-ac3d-12ab757783ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459604}] :answer-field/correct {:answer/id #uuid "afe8f777-32ed-5e0c-81b1-d151b12d83b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459603} :answer-field/id #uuid "39be9191-3d03-583a-8f67-fb10524c2446" :answer-field/key "$X$ and $Y$ are independent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460668} {:answer-field/choices [{:answer/id #uuid "b6150840-eefa-5c67-ac6a-03acee9e70ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667976} {:answer/id #uuid "da93b427-a62f-5268-83a5-46cbecf68f1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667977}] :answer-field/correct {:answer/id #uuid "da93b427-a62f-5268-83a5-46cbecf68f1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667977} :answer-field/id #uuid "d022c9a1-d6ea-513f-b339-7ecfa806810c" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668265}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2b10e877-0140-5f79-97b2-25494c500279" :question/math-academy-id "q-162744" :question/problem "| $f$ | $Y=0$ | $Y=1$ |\n| --- | --- | --- |\n| $X=0$ | $0.1$ | $0.2$ |\n| $X=1$ | $0.1$ | $0.6$ |\n\nThe joint probability distribution $f(x,y)$ of the discrete random variables $X$ and $Y$ is given above, while the marginal mass functions for these variables are shown below.\n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">$x$</td>\n<td align=\"center\">$0$</td>\n<td align=\"center\">$1$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">${f}_{X}(x)$</td>\n<td align=\"center\">$0.3$</td>\n<td align=\"center\">$0.7$</td>\n</tr>\n</tbody></table>\n<p></p></th>\n<th width=\"50\"></th>\n<th>\n<table align=\"center\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">$y$</td>\n<td align=\"center\">$0$</td>\n<td align=\"center\">$1$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">${f}_{Y}(y)$</td>\n<td align=\"center\">$0.2$</td>\n<td align=\"center\">$0.8$</td>\n</tr>\n</tbody></table>\n<p></p></th></tr></tbody></table>\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/requires-calculator true :question/worked-solution "Two discrete random variables $X$ and $Y$ with a joint probability mass function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability mass functions for $X$ and $Y,$ respectively.\n\nWith that in mind, let's examine our statements.\n\n- Statements $P(X=1,Y=1)$ $=P(X=1)\\cdot P(Y=1)$ and “$P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$” are false. From the table, we obtain that $P(X=1,Y=1)=f(1,1)=0.6.$ However, \n\n$$\nP(X=1)\\cdot P(Y=1)={f}_{X}(1)\\cdot {f}_{Y}(1)=0.7\\cdot 0.8=0.56.\\,\\times \n$$\n\nTherefore, \n\n$$\nP(X=1,Y=1)\\ne P(X=1)\\cdot P(Y=1),\n$$\n\nand $P(X=x,Y=y)\\ne P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y.$\n\n- Statement “$X$ and $Y$ are independent” is false. Since statement “$P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$” is false, our random variables $X$ and $Y$ are *not* independent.\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186162634 :knowledge-point/_questions [{:db/id #edb/ref 17592186162008 :knowledge-point/id #uuid "6289ad34-2393-5f5f-b7f0-a1ab1a3916f4" :knowledge-point/title "Identifying Possible Quadratic Form Types Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16b5e14d-829f-5937-ba9c-fd1598dfd032" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460401} {:answer/id #uuid "2b15cd94-9900-5ec3-b324-7c8de72f8378" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460402}] :answer-field/correct {:answer/id #uuid "2b15cd94-9900-5ec3-b324-7c8de72f8378" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460402} :answer-field/id #uuid "7eef49da-ab56-5f63-9232-a5c3209069b9" :answer-field/key "$R(x)={x}_{1}^{2}+{x}_{2}^{2}+5{x}_{1}{x}_{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461067} {:answer-field/choices [{:answer/id #uuid "bd50e9e3-7d6e-5a99-bbb3-83c0411a955a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460403} {:answer/id #uuid "fdec5c33-ce90-5d1f-b401-3adcbfe452b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460404}] :answer-field/correct {:answer/id #uuid "bd50e9e3-7d6e-5a99-bbb3-83c0411a955a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460403} :answer-field/id #uuid "c054462a-1b17-563a-9bca-0de76f27561c" :answer-field/key "$S(x)={x}^{T}\\,\\begin{bmatrix}1 & -2 \\\\ -2 & 9\\end{bmatrix}x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461068} {:answer-field/choices [{:answer/id #uuid "3c9182d9-8713-5210-af2a-b1ddcd840e25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460405} {:answer/id #uuid "0523bbf6-1585-5852-a37a-544ef336c339" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460406}] :answer-field/correct {:answer/id #uuid "3c9182d9-8713-5210-af2a-b1ddcd840e25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460405} :answer-field/id #uuid "3b4d2033-06b6-5ccf-b5f8-aab0b12b6d1b" :answer-field/key "$T(x)={x}_{1}^{2}+{x}_{2}^{2}+{x}_{1}{x}_{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461069} {:answer-field/choices [{:answer/id #uuid "75dddf87-7d0e-5055-ba9f-bb29f8c533f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668136} {:answer/id #uuid "f7a02a45-fc0c-549f-8868-649355b0edd6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668137}] :answer-field/correct {:answer/id #uuid "75dddf87-7d0e-5055-ba9f-bb29f8c533f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668136} :answer-field/id #uuid "36712fab-0c81-5dfc-8c32-dd1de81af815" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668345}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "19082f66-1046-53f5-8de5-47b2fc5eafb6" :question/math-academy-id "q-94462" :question/problem "$$\n\n$$\n\nConsider the vector $x=\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}.$ By evaluating the following quadratic forms at $x$ **only,** determine which of them **cannot** be positive-definite.\n\nSelect all that apply." :question/worked-solution "A quadratic form $Q(x)$ is positive-definite if $Q(x)>0$ for all $x\\in {R}^{n}∖{0}.$\n\nWith that in mind, let's examine each of the quadratic forms by substituting $x=\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}:$\n\n- Quadratic form $R(x)={x}_{1}^{2}+{x}_{2}^{2}+5{x}_{1}{x}_{2}$ *cannot* be positive-definite since \n\n$$\n\\begin{aligned}R(x) & ={1}^{2}+(-2)^{2}+5\\cdot 1\\cdot (-2) \\\\  & =1+4-10 \\\\  & =-5<0.\\end{aligned}\n$$\n\n- Quadratic form $S(x)={x}^{T}\\,\\begin{bmatrix}1 & -2 \\\\ -2 & 9\\end{bmatrix}x$ *might* be positive-definite. Indeed,\n\n$$\n\\begin{aligned}S(x) & =\\begin{bmatrix}1 & -2\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ -2 & 9\\end{bmatrix}\\begin{bmatrix}1 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & -20\\end{bmatrix}\\begin{bmatrix}1 \\\\ -2\\end{bmatrix} \\\\  & =45>0.\\end{aligned}\n$$\n\n- Quadratic form $T(x)={x}_{1}^{2}+{x}_{2}^{2}+{x}_{1}{x}_{2}$ *might* be positive-definite. Indeed,\n\n$$\n\\begin{aligned}T(x) & ={1}^{2}+(-2)^{2}+1\\cdot (-2) \\\\  & =1+4-2 \\\\  & =3>0.\\end{aligned}\n$$\n\nTherefore, the correct answer is $R(x)={x}_{1}^{2}+{x}_{2}^{2}+5{x}_{1}{x}_{2}$ only."} {:db/id #edb/ref 17592186162639 :knowledge-point/_questions [{:db/id #edb/ref 17592186162010 :knowledge-point/id #uuid "cbebdd1b-0716-55cb-8df6-12a35b517ab5" :knowledge-point/title "Identifying a Quadratic Form Type Using Sylvester's Criterion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8704f06e-0eca-5a70-9700-c5526052b2a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460407} {:answer/id #uuid "6518d566-4b59-5853-9f01-fa65f41a11a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460408}] :answer-field/correct {:answer/id #uuid "8704f06e-0eca-5a70-9700-c5526052b2a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460407} :answer-field/id #uuid "328cbc85-02de-5782-9f6f-1bfc8ec8fbb3" :answer-field/key "${a}_{11}=-1$ and $det(A)>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461070} {:answer-field/choices [{:answer/id #uuid "b050a0c6-7aec-5f7e-8f14-b631435a1e5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460409} {:answer/id #uuid "7dea8288-7e98-5761-9e3b-5108736ab6b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460410}] :answer-field/correct {:answer/id #uuid "7dea8288-7e98-5761-9e3b-5108736ab6b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460410} :answer-field/id #uuid "147acc30-38f6-5dd4-b1fc-756ff6c1cd6a" :answer-field/key "${x}^{T}\\,A\\,x$ is negative-definite" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461071} {:answer-field/choices [{:answer/id #uuid "70cc8a99-fd5f-545d-944d-b10871efed96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460411} {:answer/id #uuid "ed4651ad-1ec2-5084-a1f5-126f6778fe6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460412}] :answer-field/correct {:answer/id #uuid "70cc8a99-fd5f-545d-944d-b10871efed96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460411} :answer-field/id #uuid "d6975a47-d056-596c-bc2f-5293e337fd67" :answer-field/key "$A$ is positive-definite" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461072} {:answer-field/choices [{:answer/id #uuid "a5b242a4-d56a-55ce-8e1f-17ec28153e76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668138} {:answer/id #uuid "08ca7ab6-0d10-52a3-9931-8c199021c084" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668139}] :answer-field/correct {:answer/id #uuid "a5b242a4-d56a-55ce-8e1f-17ec28153e76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668138} :answer-field/id #uuid "a9b9517d-8690-576c-a18e-f70b8b8be18f" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668346}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1a18cc33-e8b9-51a0-9ec6-b247bdd1e062" :question/math-academy-id "q-94467" :question/problem "$$\nA=\\begin{bmatrix}-1 & 2 & 0 \\\\ 2 & -6 & 0 \\\\ 0 & 0 & -2\\end{bmatrix}\n$$\n\nConsider the matrix $A$ shown above.\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let ${Δ}_{i}$ for $i=1,2,…,n$  denote the leading principal minors of an $n\\times n$ matrix $A.$ Then, according to Sylvester's criterion, the quadratic form ${x}^{T}\\,A\\,x$ (as well as the matrix $A$) is \n\n- positive definite if and only if ${Δ}_{i}>0$ for all $i=1,2,…,n,$\n\n- negative definite if and only if, for all $i=1,2,…,n,$ we have ${Δ}_{i}<0$ when $i$ is odd, and ${Δ}_{i}>0$ when $i$ is even.\n\nWith that in mind, let's examine each of the statements in turn.\n\n- Statement “${a}_{11}=-1$ and $det(A)>0$” is false. Indeed, ${a}_{11}=-1$ but \n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}-1 & 2 & 0 \\\\ 2 & -6 & 0 \\\\ 0 & 0 & -2\\end{aligned}| \\\\  & =-2\\cdot |\\begin{aligned}-1 & 2 \\\\ 2 & -6\\end{aligned}| \\\\  & =-2\\cdot 2 \\\\  & =-4<0.\\end{aligned}\n$$\n\n- Statement “${x}^{T}\\,A\\,x$ is negative-definite” is true, while statement “$A$ is positive-definite” is false. Notice the following:\n\n$$\n\\begin{aligned}{Δ}_{1} & ={a}_{11}=-1<0 \\\\ {Δ}_{2} & =|\\begin{aligned}-1 & 2 \\\\ 2 & -6\\end{aligned}|=2>0 \\\\ {Δ}_{3} & =|A|=-4<0\\end{aligned}\n$$\n\nSo, by Sylvester's criterion, the form ${x}^{T}\\,A\\,x,$ and the matrix $A,$ are negative-definite.\n\nTherefore, the correct answer is “${x}^{T}\\,A\\,x$ is negative-definite” only."} {:db/id #edb/ref 17592186167051 :knowledge-point/_questions [{:db/id #edb/ref 17592186166863 :knowledge-point/id #uuid "65adbd80-9647-59d8-bd4a-42f431587c85" :knowledge-point/title "Identifying Conservative Vector Fields"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a34e9e6f-2888-5f5e-8d46-214f1d392b60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437366} {:answer/id #uuid "cb59301c-abc9-51ad-b0e3-c4ff391b8b74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437367}] :answer-field/correct {:answer/id #uuid "a34e9e6f-2888-5f5e-8d46-214f1d392b60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437366} :answer-field/id #uuid "5d0a4f31-7a33-5fef-82ec-37c61f532a12" :answer-field/key "$F=x{e}^{xy}\\,i+y{e}^{xy}\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438712} {:answer-field/choices [{:answer/id #uuid "45ad8b6d-306b-5c2f-9bc1-af6874eaf7dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437368} {:answer/id #uuid "5afdf89b-d566-5135-9459-4a771ed47ff5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437369}] :answer-field/correct {:answer/id #uuid "45ad8b6d-306b-5c2f-9bc1-af6874eaf7dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437368} :answer-field/id #uuid "c4bc42d9-4ade-5ab1-a4a6-2546001b1cbb" :answer-field/key "$G=(xy+{y}^{2})\\,i+(xy+{x}^{2})\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438713} {:answer-field/choices [{:answer/id #uuid "970d8e6b-fc38-53e4-90d8-b02eee99b29d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437370} {:answer/id #uuid "790f5db3-f1d6-5dcd-bbeb-89e1313e0a83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437371}] :answer-field/correct {:answer/id #uuid "790f5db3-f1d6-5dcd-bbeb-89e1313e0a83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437371} :answer-field/id #uuid "fabc5da5-1944-5cda-a505-51d0b2452429" :answer-field/key "$H=\\operatorname{cos}⁡(x-y)\\,i-\\operatorname{cos}⁡(x-y)\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438714} {:answer-field/choices [{:answer/id #uuid "bda0dc9a-8fd0-5aab-8701-103939165177" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667794} {:answer/id #uuid "d5882955-b679-5420-909f-e4cc4efd4736" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667795}] :answer-field/correct {:answer/id #uuid "bda0dc9a-8fd0-5aab-8701-103939165177" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667794} :answer-field/id #uuid "2b7f39e8-ce7b-54d1-a4a5-9ae6d9d7a7cb" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668174}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ef2b9923-252b-570f-aaa0-557007eb97e9" :question/math-academy-id "q-104570" :question/problem "Which of the following vector fields are conservative on ${R}^{2}?$\n\nSelect all that apply." :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D={R}^{2}.$ With this in mind, let's check each of the vector fields. \n\n- For the vector field $F,$ we have $P=x{e}^{xy}$ and $Q=y{e}^{xy}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}={x}^{2}{e}^{xy},\\,\\frac{∂Q}{∂x}={y}^{2}{e}^{xy}.\n$$\n\nSince the partial derivatives are not equal, we conclude that $F$ is not conservative on ${R}^{2}.$\n\n- For the vector field $G,$ we have $P=xy+{y}^{2}$ and $Q=xy+{x}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=x+2y,\\,\\frac{∂Q}{∂x}=y+2x.\n$$\n\nSince the partial derivatives are not equal, we conclude that $G$ is not conservative on ${R}^{2}.$\n\n- For the vector field $H,$ we have $P=\\operatorname{cos}⁡(x-y)$ and $Q=-\\operatorname{cos}⁡(x-y).$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=\\operatorname{sin}⁡(x-y),\\,\\frac{∂Q}{∂x}=\\operatorname{sin}⁡(x-y).\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $H$ is conservative on ${R}^{2}.$\n\nTherefore, the correct answer is $H=\\operatorname{cos}⁡(x-y)\\,i-\\operatorname{cos}⁡(x-y)\\,j$ only."} {:db/id #edb/ref 17592186167158 :knowledge-point/_questions [{:db/id #edb/ref 17592186166896 :knowledge-point/id #uuid "276898e7-57a4-5ca6-8df7-99fd318a2702" :knowledge-point/title "Identifying a Decoupled System of Linear ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "871d0018-8af3-5194-80d2-5ac799e0e74b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459781} {:answer/id #uuid "0e5d37a7-235b-58da-9176-50a5406c47e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459782}] :answer-field/correct {:answer/id #uuid "871d0018-8af3-5194-80d2-5ac799e0e74b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459781} :answer-field/id #uuid "adc64a7c-f339-5add-8b51-7e099516b0a8" :answer-field/key "$\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=-3{x}_{1}(t)+2{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=-{x}_{2}(t)\\end{aligned}\\right.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460757} {:answer-field/choices [{:answer/id #uuid "9fe665c3-b260-583f-93c2-db271c87cfaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459783} {:answer/id #uuid "bdcfc842-2be6-5cc6-a6c8-4735e7a2503e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459784}] :answer-field/correct {:answer/id #uuid "bdcfc842-2be6-5cc6-a6c8-4735e7a2503e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459784} :answer-field/id #uuid "afd0886b-cd2a-5989-a481-fcc4b3521cd1" :answer-field/key "$\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=-3{x}_{1}(t) \\\\ {x}_{2}^{′}(t) &=\\pi {x}_{2}(t)\\end{aligned}\\right.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460758} {:answer-field/choices [{:answer/id #uuid "de2539e6-6013-5df3-bae3-dfc16b908cc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459785} {:answer/id #uuid "b6fc4512-79f9-5eaf-805a-675f960eebf7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459786}] :answer-field/correct {:answer/id #uuid "de2539e6-6013-5df3-bae3-dfc16b908cc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459785} :answer-field/id #uuid "befcf771-5bfb-5535-90a8-6ca43c7ff0ac" :answer-field/key "$\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &={x}_{1}(t)+2{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &={x}_{1}(t)-{x}_{2}(t)\\end{aligned}\\right.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460759} {:answer-field/choices [{:answer/id #uuid "b6b07d00-e463-535c-9c05-0459f46a79be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667996} {:answer/id #uuid "2953e74c-d13d-5e03-b782-525fe8949087" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667997}] :answer-field/correct {:answer/id #uuid "b6b07d00-e463-535c-9c05-0459f46a79be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667996} :answer-field/id #uuid "eb95d228-5fb5-5955-9948-c23cec9daca7" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668275}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "93f6eb79-95de-5426-8745-3fc400e1052d" :question/math-academy-id "q-321901" :question/problem "Which of the following systems of linear ODEs are decoupled?\n\nSelect all that apply." :question/worked-solution "A *decoupled system* consists of equations depending on only one variable, such as\n\n$$\n{x}_{i}^{′}(t)={\\lambda }_{i}{x}_{i}(t),\n$$\n\nwhere ${\\lambda }_{i}$ is a constant. This means that we can solve each equation independently. \n\nWith this in mind, let's examine our systems.\n\n- Systems $\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=-3{x}_{1}(t)+2{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=-{x}_{2}(t)\\end{aligned}\\right.$ is *not* decoupled because some of its equations depend on more than one variable. For example, ${x}_{1}^{′}(t)=-3{x}_{1}(t)+2{x}_{2}(t)$ depends on ${x}_{1}(t)$ and ${x}_{2}(t).$\n\n- System $\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=-3{x}_{1}(t) \\\\ {x}_{2}^{′}(t) &=\\pi {x}_{2}(t)\\end{aligned}\\right.$ is decoupled since its equations depend on only one variable each. Indeed, ${x}_{1}^{′}(t)=-3{x}_{1}(t)$ depends on only ${x}_{1}(t)$ and ${x}_{2}^{′}(t)=-{x}_{2}(t)$ depends on only ${x}_{2}(t).$\n\n- Systems $\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &={x}_{1}(t)+2{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &={x}_{1}(t)-{x}_{2}(t)\\end{aligned}\\right.$ is *not* decoupled because some of its equations depend on more than one variable. For example, ${x}_{1}^{′}(t)={x}_{1}(t)+2{x}_{2}(t)$ depends on ${x}_{1}(t)$ and ${x}_{2}(t).$\n\nTherefore, the correct answer is $\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=-3{x}_{1}(t) \\\\ {x}_{2}^{′}(t) &=\\pi {x}_{2}(t)\\end{aligned}\\right.$ only."} {:db/id #edb/ref 17592186167178 :knowledge-point/_questions [{:db/id #edb/ref 17592186166901 :knowledge-point/id #uuid "3f6920b1-2a94-5a47-840f-c823c9f70e36" :knowledge-point/title "Constructing General Solutions of First-Order Linear Systems of ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06c88a1a-2be2-5f23-8f34-0f8091026b64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459787} {:answer/id #uuid "6f6cebc5-f379-52b7-8ad6-732c59b1127b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459788}] :answer-field/correct {:answer/id #uuid "6f6cebc5-f379-52b7-8ad6-732c59b1127b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459788} :answer-field/id #uuid "8b56c806-a367-549f-93fe-a1283a94d778" :answer-field/key "$3\\cdot {x}_{1}(t)+{x}_{p}(t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460760} {:answer-field/choices [{:answer/id #uuid "4a02b4af-5caa-556e-8f71-3d6589615288" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459789} {:answer/id #uuid "b1a998be-c340-5b8e-9e86-385c70e0bf27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459790}] :answer-field/correct {:answer/id #uuid "4a02b4af-5caa-556e-8f71-3d6589615288" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459789} :answer-field/id #uuid "aef60d4b-4621-5e3e-b990-59e09eaff664" :answer-field/key "${x}_{1}(t)-{x}_{2}(t)+2\\cdot {x}_{p}(t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460761} {:answer-field/choices [{:answer/id #uuid "92af7bd9-c7a1-563a-b92c-de068d2ee21d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459791} {:answer/id #uuid "481b9e81-89e5-5758-aafd-8e9f6167d6c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459792}] :answer-field/correct {:answer/id #uuid "481b9e81-89e5-5758-aafd-8e9f6167d6c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459792} :answer-field/id #uuid "12ce4b31-83ca-56b4-85eb-c0b0f4258f34" :answer-field/key "$-4\\cdot {x}_{2}(t)+{x}_{p}(t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460762} {:answer-field/choices [{:answer/id #uuid "db764791-f8f2-517c-8668-3a7df89dcb9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668002} {:answer/id #uuid "9678ee1e-107a-594f-9a5f-204ba87ee2b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668003}] :answer-field/correct {:answer/id #uuid "db764791-f8f2-517c-8668-3a7df89dcb9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668002} :answer-field/id #uuid "5b09295b-1451-5ce6-adc2-6fa4abe7f948" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668278}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e2754510-2110-5629-8492-795ca0ada54d" :question/math-academy-id "q-330290" :question/problem "Let ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfy the homogeneous system ${x}^{′}(t)=A\\text{ }x(t)$ and ${x}_{p}(t)$ satisfy the inhomogeneous system\n${x}^{′}(t)=A\\text{ }x(t)+f(t).$\nWhich of the following is **always** a solution of the same inhomogeneous system?\n\nSelect all that apply." :question/worked-solution "Recall that if ${x}_{h}(t)$ satisfies a homogeneous linear system ${x}^{′}(t)=Ax(t)$ and ${x}_{p}(t)$ is a particular solution to an inhomogeneous linear system ${x}^{′}(t)=Ax(t)+f(t),$ then ${x}_{h}(t)+{x}_{p}(t)$ is also a solution to the same inhomogeneous system.\n\nAdditonally, the *linearity principle* for systems of linear ordinary differential equations (ODEs) states that if ${x}_{1}(t),$ ${x}_{2}(t),…,{x}_{k}(t)$ are solutions to a homogeneous linear system ${x}^{′}(t)=Ax(t),$ then any linear combination \n\n$$\n{c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t)+⋯+{c}_{k}{x}_{k}(t)\n$$\n\nwith ${c}_{1},{c}_{2},…,{c}_{k}\\in R$ is also a solution of the same homogeneous system. \n\nWith that in mind, let's examine the given expression.\n\n- Option $3\\cdot {x}_{1}(t)+{x}_{p}(t)$ is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)=3\\cdot {x}_{1}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n\\underbrace{3\\cdot {x}_{1}(t)}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\n- Option ${x}_{1}(t)-{x}_{2}(t)+2\\cdot {x}_{p}(t)$ might be *not* a solution to the inhomogeneous system. Notice that ${x}_{1}(t)-{x}_{2}(t)+2\\cdot {x}_{p}(t)$ can't be written as \n\n$$\n{x}_{h}(t)+{x}_{p}(t),\n$$\n\nwhere ${x}_{h}(t)$ is a solution of the homogeneous system, because of the multiplier $2$ next to the particular solution ${x}_{p}(t).$\n\n- Option $-4\\cdot {x}_{2}(t)+{x}_{p}(t)$ is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)=-4\\cdot {x}_{2}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n\\underbrace{-4\\cdot {x}_{2}(t)}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\nTherefore, the correct answer is $3\\cdot {x}_{1}(t)+{x}_{p}(t)$; $-4\\cdot {x}_{2}(t)+{x}_{p}(t)$ only."} {:db/id #edb/ref 17592186167180 :knowledge-point/_questions [{:db/id #edb/ref 17592186166899 :knowledge-point/id #uuid "95de2c3e-5810-5aa0-a1d0-b98b012572d4" :knowledge-point/title "Applying the Linearity Principle to the Solutions of a Homogeneous System of ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1569a98-e96a-5e51-bb58-9aadddb9d08a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459793} {:answer/id #uuid "eea333c6-8feb-50a5-95fd-1c9292d14d3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459794}] :answer-field/correct {:answer/id #uuid "c1569a98-e96a-5e51-bb58-9aadddb9d08a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459793} :answer-field/id #uuid "fb017122-bd1f-5472-9306-8b2b8f730f18" :answer-field/key "$x(t)={e}^{t}\\,{x}_{1}(t)+{x}_{2}(t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460763} {:answer-field/choices [{:answer/id #uuid "86af1a2f-2d92-5b53-8b39-b69bcbcd0f68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459795} {:answer/id #uuid "212cf8ec-0fde-5674-9fac-aacc362a2944" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459796}] :answer-field/correct {:answer/id #uuid "212cf8ec-0fde-5674-9fac-aacc362a2944" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459796} :answer-field/id #uuid "b285c10d-c8ac-59ba-8390-241351735b35" :answer-field/key "$x(t)={x}_{1}(t)+{x}_{2}(t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460764} {:answer-field/choices [{:answer/id #uuid "3076afdc-275c-57b3-ae8f-75c9ddc30b59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459797} {:answer/id #uuid "266e6c2e-cccf-5864-aca8-e806d17477a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459798}] :answer-field/correct {:answer/id #uuid "3076afdc-275c-57b3-ae8f-75c9ddc30b59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459797} :answer-field/id #uuid "b27da750-edbb-5e75-90c0-78ba73b12331" :answer-field/key "$x(t)={x}_{1}(t)\\times {x}_{2}(t)$ (cross-product)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460765} {:answer-field/choices [{:answer/id #uuid "ef6142e5-298e-5b29-a9d9-dceda1703777" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668004} {:answer/id #uuid "e41ed398-dc20-56bf-8a8c-fe671a07ffb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668005}] :answer-field/correct {:answer/id #uuid "ef6142e5-298e-5b29-a9d9-dceda1703777" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668004} :answer-field/id #uuid "c64f0f02-941b-5dad-9d84-f0e303bd84e6" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668279}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1e8067e3-26d8-5336-9a9a-e66c696fa115" :question/math-academy-id "q-330348" :question/problem "Suppose ${x}_{1}(t)$ and ${x}_{2}(t)$ are both solutions of the homogeneous system\n${x}^{′}(t)=A\\text{ }x(t).$\nWhich of the following is **always** a solution of the same system?\n\nSelect all that apply." :question/worked-solution "The *linearity principle* for systems of linear ordinary differential equations (ODEs) states that if ${x}_{1}(t)$ and ${x}_{2}(t)$ are solutions to a homogeneous linear system, then for any constants ${c}_{1}$ and ${c}_{2},$ the linear combination \n\n$$\n{c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t)\n$$\n\nis also a solution of the system. \n\nWith that in mind, let's examine the given expressions.\n\n- Option $x(t)={e}^{t}\\,{x}_{1}(t)+{x}_{2}(t)$ might be *not* a solution to the system since it's not a linear combination of the solutions ${x}_{1}(t)$ and ${x}_{2}(t).$ Notice that the multiplier of the first term is not a constant.\n\n- Option $x(t)={x}_{1}(t)+{x}_{2}(t)$ is a solution to the system. Indeed, notice that\n\n$$\n{x}_{1}(t)+{x}_{2}(t)\n$$\n\nis a linear combination of the solutions ${x}_{1}(t)$ and ${x}_{2}(t)$ with constant multiplies ${c}_{1}=1$ and ${c}_{2}=1,$ respectively.\n\n- Option “$x(t)={x}_{1}(t)\\times {x}_{2}(t)$ (cross-product)” might be *not* a solution to the system since it's not a linear combination of the solutions ${x}_{1}(t)$ and ${x}_{2}(t).$\n\nTherefore, the correct answer is $x(t)={x}_{1}(t)+{x}_{2}(t)$ only."} {:db/id #edb/ref 17592186167399 :knowledge-point/_questions [{:db/id #edb/ref 17592186166790 :knowledge-point/id #uuid "ba6a29e6-4dab-5854-815c-fa26292c31d8" :knowledge-point/title "Identifying True Statements About Equilibrium Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1de193f1-7887-58ac-b4da-f431a0a24901" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460425} {:answer/id #uuid "aebd0414-d323-5c68-8b95-4fa8b7556447" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460426}] :answer-field/correct {:answer/id #uuid "aebd0414-d323-5c68-8b95-4fa8b7556447" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460426} :answer-field/id #uuid "37a41adf-a36b-5182-915e-8fcb6bd22f16" :answer-field/key "${y}_{1}(x)=1$ is an equilibrium solution of the equation" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461079} {:answer-field/choices [{:answer/id #uuid "395fc8c6-657e-507d-880c-02beab075364" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460427} {:answer/id #uuid "2aa32acb-99b0-5b7d-9308-de823d8c7e6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460428}] :answer-field/correct {:answer/id #uuid "2aa32acb-99b0-5b7d-9308-de823d8c7e6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460428} :answer-field/id #uuid "f289f19d-b0d0-5ba8-a7e7-5feed3e84e29" :answer-field/key "The equation has $3$ distinct equilibrium solutions, ${y}_{1}(x),{y}_{2}(x),$ and ${y}_{3}(x)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461080} {:answer-field/choices [{:answer/id #uuid "c7346218-43a0-5e19-8343-631d98a743fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460429} {:answer/id #uuid "b14fdaff-72cb-5718-bb61-3eefd2af02a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460430}] :answer-field/correct {:answer/id #uuid "b14fdaff-72cb-5718-bb61-3eefd2af02a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460430} :answer-field/id #uuid "00094fcf-4b53-5edb-8f62-8f2a96cb88e5" :answer-field/key "${y}_{1}(x)+{y}_{2}(x)+{y}_{3}(x)=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461081} {:answer-field/choices [{:answer/id #uuid "faa64f10-f20e-52f6-b1f0-8994aaa7f074" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668140} {:answer/id #uuid "d13286dc-c46b-50a8-bf60-dc3743baea24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668141}] :answer-field/correct {:answer/id #uuid "faa64f10-f20e-52f6-b1f0-8994aaa7f074" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668140} :answer-field/id #uuid "7bc93c8e-39e3-5a8d-96bf-a32b3e4ae04a" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668347}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ff7b1af7-af38-533c-a6d2-a2ca545a8e42" :question/math-academy-id "q-95733" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}={y}^{3}-7y+6.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Given an autonomous differential equation ${y}^{′}(x)=f(y),$ if there exists a constant $c$ such that $f(c)=0,$ then $y=c$ is an equilibrium solution of the equation.\n\nIn our case, we have that $f(y)={y}^{3}-7y+6.$\n\nLet's examine the statement one-by-one.\n\n- Statement “${y}_{1}(x)=1$ is an equilibrium solution of the equation” is true.  We have that $f(1)={1}^{3}-7(1)+6=0.$\n\n- Statement “The equation has $3$ distinct equilibrium solutions, ${y}_{1}(x),{y}_{2}(x),$ and ${y}_{3}(x)$” is true. We know that $y=1$ is a solution to $f(y)=0,$ and so $(y-1)$ is a factor of the polynomial $f(y).$ Dividing $f(y)$ by $(y-1)$ using synthetic division, we get\n\n|  | ${y}^{3}$ | ${y}^{2}$ | ${y}^{1}$ | ${y}^{0}$ |\n| --- | --- | --- | --- | --- |\n| $1$ | $1$ | $0$ | $-7$ | $6$ |\n|  | $↓$ | $1$ | $1$ | $-6$ |\n|  | $1$ | $1$ | $-6$ | $0$ |\n\n \nTherefore, \n\n$$\n\\begin{aligned}f(y) & =(y-1)({y}^{2}+y-6) \\\\  & =(y-1)(y-2)(y+3)\\end{aligned}\n$$\n\nHence, $f(y)$ has three distinct equilibrium solutions, \n\n$$\n{y}_{1}(x)=1,\\,{y}_{2}(x)=2,\\,{y}_{3}(x)=-3.\n$$\n\n- Statement ${y}_{1}(x)+{y}_{2}(x)+{y}_{3}(x)=0$ is true. We have ${y}_{1}(x)+{y}_{2}(x)+{y}_{3}(x)=1+2+(-3)=0.$\n\nTherefore, the correct answer is “${y}_{1}(x)=1$ is an equilibrium solution of the equation”; “The equation has $3$ distinct equilibrium solutions, ${y}_{1}(x),{y}_{2}(x),$ and ${y}_{3}(x)$”; ${y}_{1}(x)+{y}_{2}(x)+{y}_{3}(x)=0$."} {:db/id #edb/ref 17592186167440 :knowledge-point/_questions [{:db/id #edb/ref 17592186166813 :knowledge-point/id #uuid "443c0bd0-2e77-50a8-91d3-a288d4ee852b" :knowledge-point/title "Identifying the Order of an Ordinary Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68bd231d-9e13-571c-877b-269bf3710fa5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422255} {:answer/id #uuid "7ed54d05-d26e-52c1-9f98-8a77b88ca5f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422256}] :answer-field/correct {:answer/id #uuid "7ed54d05-d26e-52c1-9f98-8a77b88ca5f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422256} :answer-field/id #uuid "f322ec74-487b-53f0-b9c7-a8290b3eeda9" :answer-field/key "${y}^{‴}+3x{y}^{′}=xy$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422408} {:answer-field/choices [{:answer/id #uuid "690c87af-9ba3-5188-a6c9-7004cd7ed245" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422257} {:answer/id #uuid "3abb4d56-10ee-58da-b334-bd3d4d312f6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422258}] :answer-field/correct {:answer/id #uuid "690c87af-9ba3-5188-a6c9-7004cd7ed245" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422257} :answer-field/id #uuid "97cd6e48-b23a-590e-a423-5f82ee6788fa" :answer-field/key "$3{y}^{″}{y}^{′}-2xy=2{y}^{′}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422409} {:answer-field/choices [{:answer/id #uuid "b3fcb428-35a7-5079-97a4-0ee4b813532c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422259} {:answer/id #uuid "71d4db59-c3a1-5b9f-be64-7507b8ddd8d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422260}] :answer-field/correct {:answer/id #uuid "b3fcb428-35a7-5079-97a4-0ee4b813532c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422259} :answer-field/id #uuid "adbb6891-6585-580f-a301-03d7e06beded" :answer-field/key "${x}^{3}{y}^{′}-2x={y}^{″}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186422410} {:answer-field/choices [{:answer/id #uuid "59768791-53db-5b5d-af10-b16fadb77b60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668142} {:answer/id #uuid "d286968b-9b5d-5238-884f-108b8060976b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668143}] :answer-field/correct {:answer/id #uuid "59768791-53db-5b5d-af10-b16fadb77b60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668142} :answer-field/id #uuid "354421a1-9166-59a9-9d68-9744e7c54f6a" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668348}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7ca07102-6a61-5eae-b487-0be414d1c1ab" :question/math-academy-id "q-95983" :question/problem "Which of the following are third-order ordinary differential equations?\n\nSelect all that apply." :question/worked-solution "A differential equation is of third-order if the largest derivative term in the equation is ${y}^{‴}.$\n\nKeeping this in mind, let's check each given equation.\n\n- Equation ${y}^{‴}+3x{y}^{′}=xy$ is a third-order differential equation. The highest derivative in this equation is ${y}^{‴}.$\n\n- Equation $3{y}^{″}{y}^{′}-2xy=2{y}^{′}$ is not a third-order differential equation. The highest derivative in this equation is ${y}^{″},$ so this is a second-order differential equation.\n\n- Equation ${x}^{3}{y}^{′}-2x={y}^{″}$ is not a third-order differential equation. The highest derivative in this equation is ${y}^{″},$ so this is a second-order differential equation.\n\nTherefore, the correct answer is ${y}^{‴}+3x{y}^{′}=xy$ only."} {:db/id #edb/ref 17592186172279 :knowledge-point/_questions [{:db/id #edb/ref 17592186172087 :knowledge-point/id #uuid "fb34fdb0-198e-507d-a944-9be782b4cfeb" :knowledge-point/title "Identifying Vector Fields on Three-Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "257efe5e-2614-5ac2-bf85-79ecbfa90a56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437600} {:answer/id #uuid "9b6b7630-7b4f-55f1-bc9a-d761bb022686" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437601}] :answer-field/correct {:answer/id #uuid "257efe5e-2614-5ac2-bf85-79ecbfa90a56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437600} :answer-field/id #uuid "cb7b4231-7e44-5469-8d42-537ade15949a" :answer-field/key "$G(t)={e}^{t}\\,i-t\\,j+\\operatorname{sin}⁡t\\,k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438829} {:answer-field/choices [{:answer/id #uuid "c2a1f4d6-a1e4-52e9-8825-2408433db854" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437602} {:answer/id #uuid "d3b41f11-8dd8-570a-b746-ce040d0c6094" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437603}] :answer-field/correct {:answer/id #uuid "c2a1f4d6-a1e4-52e9-8825-2408433db854" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437602} :answer-field/id #uuid "666ed197-24fa-5d30-ae83-a374aabe3407" :answer-field/key "$H(x,y)={x}^{2}\\,i-{y}^{2}\\,j$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438830} {:answer-field/choices [{:answer/id #uuid "0b2abe03-84b2-5689-9957-2c5ddaaeaf0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437604} {:answer/id #uuid "4235aad1-8567-5a5f-b358-a0eadb4ecae7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437605}] :answer-field/correct {:answer/id #uuid "4235aad1-8567-5a5f-b358-a0eadb4ecae7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437605} :answer-field/id #uuid "3a3877a7-32e1-5f78-bf7a-c67ae72c6830" :answer-field/key "$K(x,y,z)=\\operatorname{cot}⁡x\\,i-y\\,j+z\\,k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438831} {:answer-field/choices [{:answer/id #uuid "8569c70f-2bfe-5561-900c-c949586fd083" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667898} {:answer/id #uuid "3fd8870d-5fe4-5a14-8492-203e852a74db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186667899}] :answer-field/correct {:answer/id #uuid "8569c70f-2bfe-5561-900c-c949586fd083" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186667898} :answer-field/id #uuid "d3a45992-62c2-5edf-b51d-a0126cb3cdef" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668226}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "060c20fc-1491-5624-9b50-89ab0dfe4d22" :question/math-academy-id "q-122467" :question/problem "Which of the following are vector fields on ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Suppose that $S$ is a subset of ${R}^{3}.$ A vector field on ${R}^{3}$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in {R}^{3}.$\n\nWith that in mind, let's examine each function.\n\n- The function $G(t)$ is *not* a vector field on ${R}^{3}.$ It assigns points in $R$ (not ${R}^{3}$) to vectors in ${R}^{3}.$\n\n- The function $H(x,y)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{2}$ (not ${R}^{3}$) to vectors in ${R}^{2}$ (not ${R}^{3}$).\n\n- The function $K(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,x\\ne n\\pi ,\\,n\\in Z}\n$$\n\nto a vector in ${R}^{3}.$\n\nTherefore, the correct answer is $K(x,y,z)=\\operatorname{cot}⁡x\\,i-y\\,j+z\\,k$ only."} {:db/id #edb/ref 17592186172569 :knowledge-point/_questions [{:db/id #edb/ref 17592186172018 :knowledge-point/id #uuid "244419de-9b13-5923-b0a5-1bdc6f9b03b2" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using the Sign of the Slopes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b141b2a6-6f61-5e9d-b419-e3770f1e0984" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460083} {:answer/id #uuid "499fda92-d9e4-5263-8bc2-ef1eae055b2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460084}] :answer-field/correct {:answer/id #uuid "b141b2a6-6f61-5e9d-b419-e3770f1e0984" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460083} :answer-field/id #uuid "35a6896a-8a35-59c8-b44a-e1c9f4d15980" :answer-field/key "${y}^{′}=2xy$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460908} {:answer-field/choices [{:answer/id #uuid "97b25c56-fd70-5ee4-b322-d1c1653537cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460085} {:answer/id #uuid "e41e9c75-a017-527e-a98b-18fa337a8c2b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460086}] :answer-field/correct {:answer/id #uuid "e41e9c75-a017-527e-a98b-18fa337a8c2b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460086} :answer-field/id #uuid "4b9c4db5-7452-5f2e-863e-d11c400f2c88" :answer-field/key "${y}^{′}=-xy$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460909} {:answer-field/choices [{:answer/id #uuid "ef7cfed8-397e-5393-a6ec-a93e8c26ba50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460087} {:answer/id #uuid "77654353-17a5-52c3-be06-25e9314c15c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460088}] :answer-field/correct {:answer/id #uuid "ef7cfed8-397e-5393-a6ec-a93e8c26ba50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460087} :answer-field/id #uuid "0cdda0ee-37a2-5936-921a-0b1e86c097c4" :answer-field/key "${y}^{′}=x+1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460910} {:answer-field/choices [{:answer/id #uuid "0d957bb7-47a9-5435-a280-f2edb08af156" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668096} {:answer/id #uuid "2fa73eec-20cf-5287-8dd8-296602a86447" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668097}] :answer-field/correct {:answer/id #uuid "0d957bb7-47a9-5435-a280-f2edb08af156" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668096} :answer-field/id #uuid "6ce1d5e6-a2e5-5ae7-a2f7-c6cd9abd57fc" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668325}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bc5e6ef1-2f84-542e-97fb-884aded42acc" :question/math-academy-id "q-50189" :question/problem "![](images/35/35f52e6a2c3eafe59fea3c14351067fdf4b78b8c2f247454429952eb3a6f8270.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\nSelect all that apply." :question/worked-solution "![](images/e3/e3afa2080ea81f679c9c9b3423cfbe7b11bed5625854a0a33ff01312ca3629e4.png)\n\n \n\nNotice the following properties of the given slope field:\n\n- First, the slopes of the slope field are horizontal along the lines $x=0$ and $y=0,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\n- Second, the lines $x=0$ and $y=0$ divide the plane into $4$ regions. The sign of the slopes in each of the $4$ regions are easily deduced by considering the behavior of the solution curves in these regions. This information is summarized in the following table:\n\n| $y>0$ | $↗$\n\n$(+)$ | $↘$\n\n$(-)$ |\n| --- | --- | --- |\n| $y<0$ | $↘$\n\n$(-)$ | $↗$\n\n$(+)$ |\n|  | $x<0$ | $x>0$ |\n\nWith that in mind, let's consider each equation.\n\n- Equation ${y}^{′}=2xy$ does *not* give the required behavior. The right-hand side of ${y}^{′}=2xy$ evaluates to zero at $x=0$ and $y=0,$ but the sign of the slopes in the required regions (summarized below) do not correspond to the given slope field.\n\n| $y>0$ | $-$ | $+$ |\n| --- | --- | --- |\n| $y<0$ | $+$ | $-$ |\n|  | $x<0$ | $x>0$ |\n\n- Equation ${y}^{′}=-xy$ gives the required behavior. The right-hand side of ${y}^{′}=-xy$ evaluates to zero at $x=0$ and $y=0,$ and the sign of the slopes in the required regions (summarized below) correspond to the given slope field.\n\n| $y>0$ | $+$ | $-$ |\n| --- | --- | --- |\n| $y<0$ | $-$ | $+$ |\n|  | $x<0$ | $x>0$ |\n\n- Equation ${y}^{′}=x+1$ does *not* give the required behavior. The right-hand side of ${y}^{′}=x+1$ evaluates to zero at $x=-1$ only.\n\nTherefore, the correct answer is ${y}^{′}=-xy$ only."} {:db/id #edb/ref 17592186176487 :knowledge-point/_questions [{:db/id #edb/ref 17592186176053 :knowledge-point/id #uuid "92d6129b-a5c5-597a-86ee-3f19af20f326" :knowledge-point/title "Describing the General Properties of the Cosecant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c5e2592-4591-5762-bcbe-2782ea0f3180" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439767} {:answer/id #uuid "3bc8ccba-ce7d-5e48-8754-9ea49736590b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439768}] :answer-field/correct {:answer/id #uuid "3bc8ccba-ce7d-5e48-8754-9ea49736590b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439768} :answer-field/id #uuid "c3f557e4-66ef-5920-8da5-88cce596386c" :answer-field/key "The point $(π,-1)$ is not on the graph." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440241} {:answer-field/choices [{:answer/id #uuid "6880fb21-3096-58cb-af07-7d1e2ea7dd77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439769} {:answer/id #uuid "0cd10553-ba3f-56b6-ad32-275f9052a89a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439770}] :answer-field/correct {:answer/id #uuid "0cd10553-ba3f-56b6-ad32-275f9052a89a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439770} :answer-field/id #uuid "49359634-c5ac-52d1-a03b-87b9054fe601" :answer-field/key "The function has a vertical asymptotes at $x = nπ$." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440242} {:answer-field/choices [{:answer/id #uuid "9eb04900-1fcb-52ce-91bc-e54e340f3cc2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439771} {:answer/id #uuid "b8452449-f7ba-5c1c-9d12-c1bb509ee50c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439772}] :answer-field/correct {:answer/id #uuid "b8452449-f7ba-5c1c-9d12-c1bb509ee50c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439772} :answer-field/id #uuid "058bbf0f-d4f4-55ca-8a1f-a84af0d4303a" :answer-field/key "The value $y = 2$ is in the range of the function." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440243} {:answer-field/choices [{:answer/id #uuid "45db66c0-91bb-5b0a-8896-ad1b61da9857" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668080} {:answer/id #uuid "c468cbd3-1912-57e9-a574-64580f9f2725" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668081}] :answer-field/correct {:answer/id #uuid "45db66c0-91bb-5b0a-8896-ad1b61da9857" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668080} :answer-field/id #uuid "bbf2e4fc-d4fc-55f2-acb1-56dd872908ff" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668317}] :question/id #uuid "5961bc49-07f6-5191-b949-28358553d498" :question/math-academy-id "q-42912" :question/problem "Which of the following statements are true regarding the function $y = \\csc x$? Assume $n$ is an integer.\n\nSelect all that apply." :question/worked-solution "Cosecant is undefined at pi and at every n*pi, so (pi,-1) is not on its graph and those x-values are vertical asymptotes. It takes the value 2 where sin(x)=1/2."} {:db/id #edb/ref 17592186176497 :knowledge-point/_questions [{:db/id #edb/ref 17592186175901 :knowledge-point/id #uuid "eede91c4-9099-55df-a803-f87895d9f51b" :knowledge-point/title "Applying the Extreme Value Theorem to Piecewise Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80f70124-c2af-5ee2-b010-11aa7285d0d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460047} {:answer/id #uuid "cd1a1354-5046-5b4b-9996-9e9aa5387d93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460048}] :answer-field/correct {:answer/id #uuid "80f70124-c2af-5ee2-b010-11aa7285d0d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460047} :answer-field/id #uuid "7e6caf9b-4980-529e-97b4-de8f4825f3e5" :answer-field/key "$[0,2]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460890} {:answer-field/choices [{:answer/id #uuid "0bfa2956-3ca2-54c2-95f5-1587e0995009" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460049} {:answer/id #uuid "9c0dc7bf-2fa2-5fd5-bc3c-554429a21d6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460050}] :answer-field/correct {:answer/id #uuid "0bfa2956-3ca2-54c2-95f5-1587e0995009" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460049} :answer-field/id #uuid "08d86bc0-031b-56ef-9be7-e1e3067eb03e" :answer-field/key "$(1,2)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460891} {:answer-field/choices [{:answer/id #uuid "cf06108a-57f4-54ba-a053-e5138c94a590" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460051} {:answer/id #uuid "d7f7b59e-3df8-5891-bd78-1c7831303d8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460052}] :answer-field/correct {:answer/id #uuid "cf06108a-57f4-54ba-a053-e5138c94a590" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460051} :answer-field/id #uuid "6e3ce31e-0b4e-56e4-9147-5055ff5d8219" :answer-field/key "$[-2,2]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460892} {:answer-field/choices [{:answer/id #uuid "b8be7a3c-4c60-5da2-8676-aa325a8f7b91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668088} {:answer/id #uuid "dbdf4541-90c7-5131-a4c9-b18d3d295d09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668089}] :answer-field/correct {:answer/id #uuid "dbdf4541-90c7-5131-a4c9-b18d3d295d09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668089} :answer-field/id #uuid "5dba5afe-1ff5-58d8-868a-5888f621f143" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668321}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "76bcbf01-0552-53da-87ac-24d7932ac118" :question/math-academy-id "q-47922" :question/problem "Suppose that $f(x)$ is defined as\n\n$$\nf(x)={\\begin{aligned}\\,\\,{x}^{2}+1, & x<1 \\\\ -x+2, & x\\ge 1.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\nSelect all that apply." :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals.\n\n- Consider $[0,2].$ We have\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{-}}f(x) & ={lim}_{x\\to 1}({x}^{2}+1)=(1)^{2}+1=2, \\\\ {lim}_{x\\to {1}^{+}}f(x) & ={lim}_{x\\to 1}(-x+2)=-1+2=1.\\end{aligned}\n$$\n\nSo, the limits from the left and from the right of $x=1$ are not the same. Hence, $f(x)$ has a discontinuity at $x=1.$ Therefore, $f(x)$ is not continuous on the interval $[0,2],$ and the extreme value theorem is not applicable on this interval.\n\n- The interval $(1,2)$ is not closed, so the extreme value theorem is not applicable.\n\n- Finally, consider $[-2,2].$ The only discontinuity of the function $f(x)$ is at $x=1,$ which is belongs to the interval $[-2,2].$ Therefore, $f(x)$ is not continuous on the interval $[-2,2],$ and the extreme value theorem is not applicable on this interval.\n\nIn conclusion, the correct answer is \"None\"."} {:db/id #edb/ref 17592186180026 :knowledge-point/_questions [{:db/id #edb/ref 17592186179743 :knowledge-point/id #uuid "1da220a9-2afc-5b63-a423-a4d2b3de9567" :knowledge-point/title "Circulation in Conservative Vector Fields"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f564f77-c024-5353-a9d9-c19914097692" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459503} {:answer/id #uuid "660514de-f28c-53cb-a27c-34d751510c68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/tex