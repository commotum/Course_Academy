f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464070} :answer-field/id #uuid "738f91c0-56e2-59fb-bc86-5d2fb319fe65" :answer-field/key "$b\\cdot a=5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464969} {:answer-field/choices [{:answer/id #uuid "70d3b863-80c1-5c2d-8b71-c0065fdbeb85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668367} {:answer/id #uuid "2071d22e-da4b-5f44-8c70-3ef9cf532ca8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668368}] :answer-field/correct {:answer/id #uuid "2071d22e-da4b-5f44-8c70-3ef9cf532ca8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668368} :answer-field/id #uuid "317f027e-c2ff-58c5-9011-3bbbfd22ab5b" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668761}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2a127128-cb22-56be-ba7d-5b1447ce81f1" :question/math-academy-id "q-139957" :question/problem "Suppose $a\\cdot (a+b)=0$, where $a\\ne 0.$ Which of the following statements are true? \n\nSelect all that apply." :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement $a\\cdot a<0$ is false. Indeed, $a\\ne 0$ implies that $a\\cdot a>0.$\n\n- Statement $b\\cdot a>0$ and $b\\cdot a=5$ are false. Simplifying the expression $a\\cdot (a+b)=0$, we have\n\n$$\n\\begin{aligned}a\\cdot (a+b) & =0 \\\\ a\\cdot a+a\\cdot b & =0 \\\\ a\\cdot a+b\\cdot a & =0 \\\\ b\\cdot a & =-a\\cdot a\\end{aligned}\n$$\n\n \nSince $a\\ne 0$ implies that $a\\cdot a>0$, we obtain that $b\\cdot a<0.$\n\nTherefore, we conclude that the correct answer is \"None of the statements are true\"."} {:db/id #edb/ref 17592186272012 :knowledge-point/_questions [{:db/id #edb/ref 17592186133913 :knowledge-point/id #uuid "abaeea03-6a2a-5d37-a2af-a9ea109175ad" :knowledge-point/title "Identifying the Reasons Why a Determinant Equals Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "643b4a3a-7263-51ad-8b17-fdd82678cf99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464084} {:answer/id #uuid "e3e66fb8-1a18-56f4-8033-3baba4940db9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464085}] :answer-field/correct {:answer/id #uuid "643b4a3a-7263-51ad-8b17-fdd82678cf99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464084} :answer-field/id #uuid "2ceb200f-e369-571b-b619-8f16a603488c" :answer-field/key "$A$ is a triangular matrix" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464976} {:answer-field/choices [{:answer/id #uuid "198009c8-d9e6-556e-aa1c-228a37b12311" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464086} {:answer/id #uuid "da19cf9c-0b56-5a20-b004-c70d313f5184" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464087}] :answer-field/correct {:answer/id #uuid "da19cf9c-0b56-5a20-b004-c70d313f5184" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464087} :answer-field/id #uuid "d98905ac-4493-5551-96b2-6d52f8e3f566" :answer-field/key "$A$ does not have identical rows" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464977} {:answer-field/choices [{:answer/id #uuid "63ea76cf-d936-573e-a0be-56de7954b8ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464088} {:answer/id #uuid "24e2aa19-faca-5a81-a238-e9e984e89ef4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464089}] :answer-field/correct {:answer/id #uuid "24e2aa19-faca-5a81-a238-e9e984e89ef4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464089} :answer-field/id #uuid "ed42e6d2-1aff-5708-ad8c-b45de0195450" :answer-field/key "$A$ does not have proportional columns" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464978} {:answer-field/choices [{:answer/id #uuid "b81dca9a-2edb-53b6-ac28-fe026cf18a80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668369} {:answer/id #uuid "e27aabb7-2b76-5680-824e-723218866528" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668370}] :answer-field/correct {:answer/id #uuid "b81dca9a-2edb-53b6-ac28-fe026cf18a80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668369} :answer-field/id #uuid "c8bd4adc-5f90-5bb1-9c55-741e26d0510c" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668762}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f60fdb9d-cf89-59bd-ad65-e9ec096b82df" :question/math-academy-id "q-140049" :question/problem "Let $A$ be a $2\\times 2$ matrix such that $|A|\\ne 0.$ Which of the following statements must be true?\n\nSelect all that apply." :question/worked-solution "Let's consider our statements in turn.\n\n- Statement “$A$ is a triangular matrix” is false. For example, consider the matrix \n\n$$\nA=\\begin{bmatrix}1 & -2 \\\\ 2 & 1\\end{bmatrix}.\n$$\n\nWe have that \n\n$$\n|A|=1\\cdot 1-(-2)\\cdot 2=5\\ne 0\n$$\n\nbut $A$ is not a triangular matrix.\n\n- Statements “$A$ does not have identical rows” and “$A$ does not have proportional columns” are true. Indeed, we can make use of the following fact:\n\n$|A|=0$ *if and only if one of the rows/columns of $A$ is a linear combination of other rows/columns of $A.$*\n\nIn the case of a $2\\times 2$ matrix, this means that one of the rows/columns must be proportional to another row/column.\nHence, if $|A|\\ne 0$ then $A$ doesn't have proportional nor identical rows/columns.\n\nTherefore, the correct answer is “$A$ does not have identical rows”; “$A$ does not have proportional columns” only."} {:db/id #edb/ref 17592186272013 :knowledge-point/_questions [{:db/id #edb/ref 17592186133913 :knowledge-point/id #uuid "abaeea03-6a2a-5d37-a2af-a9ea109175ad" :knowledge-point/title "Identifying the Reasons Why a Determinant Equals Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9dcaf5cb-763f-5cf3-9460-94fc22fd63a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464090} {:answer/id #uuid "94b51605-0792-5dfb-9caa-c9f83344d279" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464091}] :answer-field/correct {:answer/id #uuid "94b51605-0792-5dfb-9caa-c9f83344d279" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464091} :answer-field/id #uuid "977b3534-4011-5dfd-a7b9-79927cd06b86" :answer-field/key "$A$ has proportional columns" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/i