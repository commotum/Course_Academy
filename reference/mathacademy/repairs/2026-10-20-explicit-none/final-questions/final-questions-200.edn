17592186668358}] :answer-field/correct {:answer/id #uuid "6fd2aee6-bbc7-5d60-978b-5663607e432b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668357} :answer-field/id #uuid "45aa11bd-b5c4-55d6-b571-41c7eb02390f" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668756}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "09e95d08-30a6-5777-a8a8-348db8bfab42" :question/math-academy-id "q-131724" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x-2y &=2 \\\\ -3x-4y &=3 \\\\ 2x-4y &=-1\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & -2 & 2 \\\\ -3 & -4 & 3 \\\\ 2 & -4 & -1\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -2 & 2 \\\\ -3 & -4 & 3 \\\\ 2 & -4 & -1\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 2 \\\\ 0 & -10 & 9 \\\\ 2 & -4 & -1\\end{bmatrix} & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 2 \\\\ 0 & -10 & 9 \\\\ 0 & 0 & -5\\end{bmatrix}\\end{aligned}\n$$\n\nThe final row corresponds to the equation $0x+0y=-5,$ and this has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, only statement “The system is inconsistent” is true."} {:db/id #edb/ref 17592186269024 :knowledge-point/_questions [{:db/id #edb/ref 17592186124615 :knowledge-point/id #uuid "f4f2f4f4-af4a-597d-b6c6-afb82e708fc2" :knowledge-point/title "Identifying Steady-State Vectors of Stochastic Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7fab7f30-6daa-5568-b92a-c8222dbff730" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464024} {:answer/id #uuid "693c3e17-97fa-51ee-90dc-89044808a0ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464025}] :answer-field/correct {:answer/id #uuid "693c3e17-97fa-51ee-90dc-89044808a0ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464025} :answer-field/id #uuid "81a3115e-2494-5d9d-933b-598d187f85cb" :answer-field/key "$q$ is a stochastic vector" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464946} {:answer-field/choices [{:answer/id #uuid "ae0f49bf-0cd6-54f7-8f07-c3e4c2a0820e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464026} {:answer/id #uuid "edde4065-f83b-537f-b778-128d3d7e37bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464027}] :answer-field/correct {:answer/id #uuid "edde4065-f83b-537f-b778-128d3d7e37bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464027} :answer-field/id #uuid "c06fe170-3e20-5457-900e-718afcde8f0d" :answer-field/key "$Pq=q$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464947} {:answer-field/choices [{:answer/id #uuid "319d511e-1cf0-56b4-8aff-8cd32c8fecef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464028} {:answer/id #uuid "17e9985b-24ce-5cf5-ab6d-998a5381b5c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464029}] :answer-field/correct {:answer/id #uuid "17e9985b-24ce-5cf5-ab6d-998a5381b5c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464029} :answer-field/id #uuid "80e294d2-17d3-5a25-b256-c28be00fc333" :answer-field/key "$q$ is a steady-state vector of $P$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464948} {:answer-field/choices [{:answer/id #uuid "1f9eaf27-2828-562e-a8ba-a7ed6378af93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668359} {:answer/id #uuid "1325f2ef-af0b-5078-bde7-0be0d40f691d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668360}] :answer-field/correct {:answer/id #uuid "1f9eaf27-2828-562e-a8ba-a7ed6378af93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668359} :answer-field/id #uuid "add8299a-9379-57c8-8fe4-d53cb8fad226" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668757}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c393953b-f9cd-55bd-bdae-3a3a7283cff2" :question/math-academy-id "q-135306" :question/problem "$$\nP=\\begin{bmatrix}0.8 & 0.15 \\\\ 0.2 & 0.85\\end{bmatrix},\\,q=\\begin{bmatrix}\\frac{3}{7} \\\\ \\frac{4}{7}\\end{bmatrix}\n$$\n\nConsider the stochastic matrix $P$ and vector $q$ shown above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that a steady-state vector of a stochastic matrix $P$ is a stochastic vector $q$ such that $Pq=q.$\n\nWith that in mind, let's examine our statements.\n\n- Statement “$q$ is a stochastic vector” is true. Indeed, $q$ is a stochastic vector since its entries are non-negative and add up to $1.$\n\n- Statement $Pq=q$ is true. Indeed, we have \n\n$$\nPq=\\begin{bmatrix}0.8 & 0.15 \\\\ 0.2 & 0.85\\end{bmatrix}\\begin{bmatrix}\\frac{3}{7} \\\\ \\frac{4}{7}\\end{bmatrix}=\\begin{bmatrix}\\frac{2.4}{7}+\\frac{0.6}{7} \\\\ \\frac{0.6}{7}+\\frac{3.4}{7}\\end{bmatrix}=\\begin{bmatrix}\\frac{3}{7} \\\\ \\frac{4}{7}\\end{bmatrix}=q.\n$$\n\n- Statement “$q$ is a steady-state vector of $P$” is true. Indeed, $q$ is a stochastic vector such that $Pq=q.$ So, it's a steady-state vector of $P.$\n\nTherefore, the correct answer is “$q$ is a stochastic vector”; $Pq=q$; “$q$ is a steady-state vector of $P$”."} {:db/id #edb/ref 17592186269025 :knowledge-point/_questions [{:db/id #edb/ref 17592186124615 :knowledge-point/id #uuid "f4f2f4f4-af4a-597d-b6c6-afb82e708fc2" :knowledge-point/title "Identifying Steady-State Vectors of Stochastic Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50cf12ba-0f8c-5d6a-86d7-d5466a1a1711" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464030} {:answer/id #uuid "766369ab-0fe7-5050-9921-76a53d28350f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464031}] :answer-field/correct {:answer/id #uuid "766369ab-0fe7-5050-9921-76a53d28350f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464031} :answer-field/id #uuid "5420eb4b-5e25-5cf6-9eef-93eee3f6b1a1" :answer-field/key "$q$ is a stochastic vector" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464949} {:answer-field/choices [{:answer/id #uuid "eecec88c-b638-5721-a82f-fe220b0509b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :ans