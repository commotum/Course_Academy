12-0b75-5b94-81cd-9bd5456409db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668509} {:answer/id #uuid "955d31a6-d249-543a-8ba6-98cffa97b68c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668510}] :answer-field/correct {:answer/id #uuid "3f9dbc12-0b75-5b94-81cd-9bd5456409db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668509} :answer-field/id #uuid "61b21d83-e65d-5667-a4f5-d105f0e2fdfe" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668832}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1e347cb6-d962-5b7a-b93a-2a8ccafaafbe" :question/math-academy-id "q-22080" :question/problem "For the function $f(x)={x}^{5}-5{x}^{3}+15,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "We need to identify whether $x=\\sqrt{3}$ is a critical point. If it is, we then need to classify it using the second derivative test.\n\nFirst, we need to identify the critical points. Differentiating $f(x)={x}^{5}-5{x}^{3}+15,$ we get\n\n$$\n{f}^{′}(x)=5{x}^{4}-15{x}^{2},\n$$\n\nand solving ${f}^{′}(x)=0,$ we get\n\n$$\n\\begin{aligned}5{x}^{4}-15{x}^{2} & =0 \\\\ 5{x}^{2}({x}^{2}-3) & =0 \\\\ 5{x}^{2}(x+\\sqrt{3})(x-\\sqrt{3}) & =0 \\\\ x & =\\pm \\sqrt{3},0.\\end{aligned}\n$$\n\nSo we have critical points at $x=\\pm \\sqrt{3},0.$ We're interested in the critical point $x=\\sqrt{3}.$\n\nNext, we need to determine the sign of ${f}^{″}(x)$ at this critical point. Computing ${f}^{″}(x),$ we get\n\n$$\n{f}^{″}(x)=20{x}^{3}-30x,\n$$\n\nand evaluating ${f}^{″}(x)$ at $x=\\sqrt{3},$ we get\n\n$$\n{f}^{″}(\\sqrt{3})=20(\\sqrt{3})^{3}-30\\sqrt{3}=30\\sqrt{3}>0.\n$$\n\nThe second derivative is positive at $x=\\sqrt{3},$ so this critical point is a relative *minimum*. \n\nTherefore, comparing our results with the given statements, we conclude that:\n\n- $x=\\sqrt{3}$ is a critical point of $f(x)\\,✓$\n\n- ${f}^{″}(\\sqrt{3})<0\\,\\times $\n\n- $f(x)$ has a relative *minimum* at $x=\\sqrt{3}\\,✓$\n\nTherefore, the correct answer is “$x=\\sqrt{3}$ is a critical point of $f(x)$”; “$f(x)$ has a relative minimum at $x=\\sqrt{3}$” only."} {:db/id #edb/ref 17592186290410 :knowledge-point/_questions [{:db/id #edb/ref 17592186064165 :knowledge-point/id #uuid "ae256269-0bec-5d57-ac4a-eb0b07926f6f" :knowledge-point/title "Finding Critical Points and Then Classifying Them Using the Second Derivative Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0273afcf-1982-5569-8348-f10a8e77aad7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465881} {:answer/id #uuid "1526315c-74f6-5bb1-a15f-52ce2cf483f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465882}] :answer-field/correct {:answer/id #uuid "1526315c-74f6-5bb1-a15f-52ce2cf483f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465882} :answer-field/id #uuid "7a11075d-7e91-53e3-8287-8ac5fd97acb2" :answer-field/key "$x=\\frac{\\pi }{4}$ is a critical point of $f(x)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466784} {:answer-field/choices [{:answer/id #uuid "c496d87e-e47e-5f9d-8298-d6c0c32cca85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465883} {:answer/id #uuid "9b5f781a-5bc0-57ae-80e8-0675eb804587" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 175