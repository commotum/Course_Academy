t :answer-field.type/checkbox} :db/id #edb/ref 17592186466671} {:answer-field/choices [{:answer/id #uuid "7677d252-a3d8-50c2-b717-527086af9f76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668483} {:answer/id #uuid "42e1dc4d-5228-5970-9bfa-84b6cd71a295" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668484}] :answer-field/correct {:answer/id #uuid "42e1dc4d-5228-5970-9bfa-84b6cd71a295" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668484} :answer-field/id #uuid "9c1b0a57-3577-5516-9893-11064e9f55ae" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668819}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1e67e934-1049-5a47-aaca-94c1d2a3bfc1" :question/math-academy-id "q-177118" :question/problem "$$\n{u}_{1}=\\begin{bmatrix}2 \\\\ 3 \\\\ 5\\end{bmatrix},\\,{u}_{2}=\\begin{bmatrix}1 \\\\ 4 \\\\ -1\\end{bmatrix},\\,{u}_{3}=\\begin{bmatrix}3 \\\\ 3 \\\\ -3\\end{bmatrix}\n$$\n\nConsider the vectors above, and let $Q$ be an orthogonal linear transformation. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nWith that in mind, let's examine our statements.\n\n- Statement ${u}_{1}\\cdot {u}_{2}=0$ is false since\n\n$$\n{u}_{1}\\cdot {u}_{2}=\\begin{bmatrix}2 \\\\ 3 \\\\ 5\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 4 \\\\ -1\\end{bmatrix}=2+12-5=9\\ne 0.\n$$\n\n- Statement “${Q({u}_{1}),Q({u}_{2}),Q({u}_{3})}$ is orthogonal” is false. Notice that, for example, $Q({u}_{1})⊥̸Q({u}_{2})$ since\n\n$$\nQ({u}_{1})\\cdot Q({u}_{2})={u}_{1}\\cdot {u}_{2}\\ne 0.\n$$\n\n- Statement “${Q({u}_{1}),Q({u}_{2}),Q({u}_{3})}$ is orthonormal” is false since the set is not even orthogonal.\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186284756 :knowledge-point/_questions [{:db/id #edb/ref 17592186133948 :knowledge-point/id #uuid "b9017b4e-ddb3-56f6-ba30-b494a7e4e09f" :knowledge-point/title "Identifying Orthogonal Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e96d429-426d-57be-9829-ac4f3df0f0f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465657} {:answer/id #uuid "63d8e8dc-2cdc-5569-842a-a09fd62da3cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465658}] :answer-field/correct {:answer/id #uuid "6e96d429-426d-57be-9829-ac4f3df0f0f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465657} :answer-field/id #uuid "445e63e5-652e-5dc8-8351-e2fbc1b14148" :answer-field/key "$A$ is a square matrix" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466672} {:answer-field/choices [{:answer/id #uuid "b73478f8-b885-594b-a9a0-e27cc437e81a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465659} {:answer/id #uuid "ab8b414f-27f6-5450-99ad-7a22e6912793" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465660}] :answer-field/correct {:answer/id #uuid "ab8b414f-27f6-5450-99ad-7a22e6912793" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465660} :answer-field/id #uuid "62e7ea1a-de3f-549d-b7d9-e591346c6e82" :answer-field/key "${A}^{T}\\cdot A=I$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466673} {:answer-field/choices [{:answer/id #uuid "77359e72-e6db-54da-84e0-5a07ac19909a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465661} {:answer/id #uuid "aa4ea3dc-1b67-5809-a058-95b24fde0dc4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465662}] :answer-field/correct {:answer/id #uuid "77359e72-e6db-54da-84e0-5a07ac19909a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465661} :answer-field/id #uuid "993baea2-7ee4-5876-a225-396d9a3cd0af" :answer-field/key "$A$ is an orthogonal matrix" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466674} {:answer-field/choices [{:answer/id #uuid "985dd455-4f23-5e02-bc47-df2c71a38d22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668485} {:answer/id #uuid "6e15e6f9-6c55-556c-b732-69862999db48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668486}] :answer-field/correct {:answer/id #uuid "985dd455-4f23-5e02-bc47-df2c71a38d22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668485} :answer-field/id #uuid "d6544be2-64b4-5293-abc7-8f0e24ca3470" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668820}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "71c46d34-a9b9-54b7-8de2-8c7deffeb5f5" :question/math-academy-id "q-177667" :question/problem "$$\nA=\\begin{bmatrix}1 & 0 \\\\ 0 & 1 \\\\ 0 & 0\\end{bmatrix}\n$$\n\nConsider the matrix $A$ above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that a square matrix $A$ is **orthogonal** if and only if\n\n$$\nA\\cdot {A}^{T}={A}^{T}\\cdot A=I\n$$\n\nwhere $I$ is the identity matrix.\n\nWith that in mind, let's examine the given statements. \n\n- Statement “$A$ is a square matrix” is false. The number of rows in $A$ is not the same as the number of columns. So, it's not a square matrix.\n\n- Statement ${A}^{T}\\cdot A=I$ is true. Note that\n\n$$\n{A}^{T}\\cdot A=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ 0 & 1 \\\\ 0 & 0\\end{bmatrix}=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}.\n$$\n\n- Statement “$A$ is an orthogonal matrix” is false. Since $A$ is not a square matrix, our matrix is **not** orthogonal.\n\nTherefore, the correct answer is ${A}^{T}\\cdot A=I$ only."} {:db/id #edb/ref 17592186284761 :knowledge-point/_questions [{:db/id #edb/ref 17592186198449 :knowledge-point/id #uuid "b4a5d6b1-e76a-5b33-8973-04d1d9062dc6" :knowledge-point/title "Identifying the Orthogonality of a Two-Vector Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4bc2efb6-9eca-5951-8e7b-36ca586cc91e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465663} {:answer/id #uuid "4c94335e-da4f-5437-a16e-06f74b8263ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465664}] :answer-field/correct {:answer/id #uuid "4c94335e-da4f-5437-a16e-06f74b8263ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465664} :answer-field/id #uuid "1aa48675-e440-5d05-bce2-e8ba5671377c" :answer-field/key "${u}_{1}\\cdot {u}_{2}=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466675} {:answer-field/choices [{:answer/id #uuid "ebb7ea2d-fda8-5bb3-8b30-53e628e49462" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465665} {:answer/id #uuid "4a519b06-c877-5f24-b5ab-94c362d829af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465666}] :answer-field/correct {:answer/id #uuid "4a519b06-c877-5f24-b5ab-94c362d829af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465666} :answer-field/id #uuid "b36b6346-2bec-52b5-be58-2c49b45e65b8" :answer-field/key "${Q({u}_{1}),Q({u}_{2})}$ is orthogonal" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466676} {:answer-field/choices [{:answer/id #uuid "67109f8f-67eb-5347-861b-978220010be2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465667} {:answer/id #uuid "3f25123c-227b-583e-a1b9-25f891486d3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465668}] :answer-field/correct {:answer/id #uuid "3f25123c-227b-583e-a1b9-25f891486d3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465668} :answer-field/id #uuid "c2a91194-5a35-55f8-b752-19469120d84b" :answer-field/key "${Q({u}_{1}),Q({u}_{2})}$ is orthonormal" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466677} {:answer-field/choices [{:answer/id #uuid "c4877d64-bc68-5ac2-9306-418d08a8c381" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668487} {:answer/id #uuid "96776a5d-9770-5e4f-84b2-c98a01d48685" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668488}] :answer-field/correct {:answer/id #uuid "c4877d64-bc68-5ac2-9306-418d08a8c381" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668487} :answer-field/id #uuid "274179cc-3e13-5739-86d8-98f465afb872" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668821}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e9ed15ab-e314-5efe-ab81-8f51e9de96ca" :question/math-academy-id "q-178026" :question/problem "$$\n{u}_{1}=\\begin{bmatrix}\\frac{4}{5} \\\\ \\frac{3}{5}\\end{bmatrix},\\,{u}_{2}=\\begin{bmatrix}-\\frac{3}{5} \\\\ \\frac{4}{5}\\end{bmatrix}\n$$\n\nConsider the vectors above, and let $Q$ be an orthogonal linear transformation. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nWith that in mind, let's examine our statements.\n\n- Statement ${u}_{1}\\cdot {u}_{2}=0$ is true. Indeed,\n\n$$\n{u}_{1}\\cdot {u}_{2}=\\begin{bmatrix}\\frac{4}{5} \\\\ \\frac{3}{5}\\end{bmatrix}\\cdot \\begin{bmatrix}-\\frac{3}{5} \\\\ \\frac{4}{5}\\end{bmatrix}=-\\frac{12}{25}+\\frac{12}{25}=0.\n$$\n\n- Statement “${Q({u}_{1}),Q({u}_{2})}$ is orthogonal” is true. Indeed, $Q({u}_{1})⊥Q({u}_{2})$ since\n\n$$\nQ({u}_{1})\\cdot Q({u}_{2})={u}_{1}\\cdot {u}_{2}=0.\n$$\n\n- Statement “${Q({u}_{1}),Q({u}_{2})}$ is orthonormal” is true. Indeed, both $Q({u}_{1})$ and $Q({u}_{2})$ are unit vectors:\n\n$$\n\\begin{aligned}‖Q({u}_{1})‖ & =‖{u}_{1}‖=\\sqrt{\\left(\\frac{4}{5}\\right)^{2}+\\left(\\frac{3}{5}\\right)^{2}}=1 \\\\ ‖Q({u}_{2})‖ & =‖{u}_{2}‖=\\sqrt{\\left(-\\frac{3}{5}\\right)^{2}+\\left(\\frac{4}{5}\\right)^{2}}=1\\end{aligned}\n$$\n\nTherefore, the correct answer is ${u}_{1}\\cdot {u}_{2}=0$; “${Q({u}_{1}),Q({u}_{2})}$ is orthogonal”; “${Q({u}_{1}),Q({u}_{2})}$ is orthonormal”."} {:db/id #edb/ref 17592186284764 :knowledge-point/_questions [{:db/id #edb/ref 17592186198449 :knowledge-point/id #uuid "b4a5d6b1-e76a-5b33-8973-04d1d9062dc6" :knowledge-point/title "Identifying the Orthogonality of a Two-Vector Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1f6862c-27fd-5c39-8eb2-3cbbffed6df8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465669} {:answer/id #uuid "786a7ab2-a3ec-5b80-8a00-e9e1753b87d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465670}] :answer-field/correct {:answer/id #uuid "e1f6862c-27fd-5c39-8eb2-3cbbffed6df8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465669} :answer-field/id #uuid "55fa8074-b199-52f0-b9ec-a64e6d2e74dd" :answer-field/key "${u}_{1}\\cdot {u}_{2}=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466678} {:answer-field/choices [{:answer/id #uuid "14cbd69a-f982-5d8b-a7b5-faa1d54ef043" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465671} {:answer/id #uuid "a3dbd501-b3c0-564f-92ea-a9a572fb9e89" :answer/type {:db/id #edb/ref 