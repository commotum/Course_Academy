/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668372}] :answer-field/correct {:answer/id #uuid "5c152f02-0747-5d5e-81d3-22176678b033" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668371} :answer-field/id #uuid "9ce27b83-2c2c-53a0-9721-40df10d78761" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668763}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "14e63fd3-62b7-575e-b489-4cda5c20ed53" :question/math-academy-id "q-140050" :question/problem "$$\nA=\\begin{bmatrix}1 & -2 & 3 \\\\ 2 & -4 & 5 \\\\ -1 & 2 & 7\\end{bmatrix}\n$$\n\nConsider the matrix given above. Identify **all** of the reasons why one can conclude that $|A|=0?$\n\nSelect all that apply." :question/worked-solution "Let's examine each of the statements in turn.\n\n- $A$ has proportional columns: \n\n$$\nA=\\begin{bmatrix}1 & -2 & 3 \\\\ 2 & -4 & 5 \\\\ -1 & 2 & 7\\end{bmatrix}\\,✓\n$$\n\n- $A$ does *not* have identical columns.\n\n- $A$ does *not* have identical rows.\n\nTherefore, the correct answer is “$A$ has proportional columns” only."} {:db/id #edb/ref 17592186272087 :knowledge-point/_questions [{:db/id #edb/ref 17592186133869 :knowledge-point/id #uuid "62a2f835-498f-5b9e-9051-89c946558e56" :knowledge-point/title "Identifying True Statements About Orthogonal Vectors in Inner Product Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "497c7760-d42f-5692-9a2b-f696bcb0055b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464102} {:answer/id #uuid "277a5a87-418d-51a1-a726-67cf72fc412e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464103}] :answer-field/correct {:answer/id #uuid "277a5a87-418d-51a1-a726-67cf72fc412e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464103} :answer-field/id #uuid "83086f7a-b7cb-5812-935f-60e558109693" :answer-field/key "$⟨f(t),g(t)⟩=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464985} {:answer-field/choices [{:answer/id #uuid "f8236707-38fd-5c0b-89a7-0a27fffeb00e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464104} {:answer/id #uuid "57b74907-7a7f-5031-9194-c6a7d4bdc948" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464105}] :answer-field/correct {:answer/id #uuid "f8236707-38fd-5c0b-89a7-0a27fffeb00e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464104} :answer-field/id #uuid "274eab40-126e-5394-8c41-1828340662f4" :answer-field/key "$⟨f(t),g(t)⟩=\\frac{1}{4}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464986} {:answer-field/choices [{:answer/id #uuid "8913ca1a-f4ac-570e-9fa4-f8c757505f49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464106} {:answer/id #uuid "6fc3a2fc-28db-525b-8a74-baf7b5fc3108" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464107}] :answer-field/correct {:answer/id #uuid "6fc3a2fc-28db-525b-8a74-baf7b5fc3108" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464107} :answer-field/id #uuid "080e9bc1-5374-5406-97b7-4e6bef226207" :answer-field/key "$f(t)⊥g(t)$ with respect to the inner product $⟨\\cdot ,\\cdot ⟩$ in $V$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464987} {:answer-field/choices [{:answer/id #uuid "d01c4534-d731-599a-919d-1353a9ce54f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668373} {:answer/id #uuid "f905deb4-2ed6-59d2-a6a5-9eed1e3cdbdd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668374}] :answer-field/correct {:answer/id #uuid "d01c4534-d731-599a-919d-1353a9ce54f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668373} :answer-field/id #uuid "802fae7c-1769-57a0-bbd6-032c3fac79cf" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668764}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a0e37cf1-8e7e-52da-9921-f2cfa10fc56d" :question/math-academy-id "q-140434" :question/problem "Let $V=C[-1,0]$ be the vector space of all functions that are continuous on $[-1,0],$ equipped with the inner product \n\n$$\n⟨f(t),g(t)⟩={\\int }_{-1}^{0}f(t)g(t)\\,\\text{d}t.\n$$\n\nGiven the functions $f(t)=({t}^{3}+t+1)^{3}$ and $g(t)=3{t}^{2}+1,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, we need to evaluate \n\n$$\n⟨f(t),g(t)⟩={\\int }_{-1}^{0}({t}^{3}+t+1)^{3}(3{t}^{2}+1)\\,\\text{d}t.\n$$\n\nWe can evaluate this integral using the substitution $u={t}^{3}+t+1,$ $\\text{d}u=(3{t}^{2}+1)\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{-1}^{0}({t}^{3}+t+1)^{3}(3{t}^{2}+1)\\,\\text{d}t & ={\\int }_{-1}^{1}{u}^{3}\\,\\text{d}u \\\\  & =\\frac{1}{4}{u}^{4}\\,{|}_{-1}^{1} \\\\  & =[\\frac{1}{4}(1)^{4}]-[\\frac{1}{4}(-1)^{4}] \\\\  & =0\\end{aligned}\n$$\n\nLet's now examine the statements:\n\n- Statement $⟨f(t),g(t)⟩=0$ is true, while statement $⟨f(t),g(t)⟩=\\frac{1}{4}$ is false. This is as a result of the above calculations.\n\n- Statement “$f(t)⊥g(t)$ with respect to the inner product $⟨\\cdot ,\\cdot ⟩$ in $V$” is true. Since the inner product is zero, our vectors are orthogonal.\n\nTherefore, the correct answer is $⟨f(t),g(t)⟩=0$; “$f(t)⊥g(t)$ with respect to the inner product $⟨\\cdot ,\\cdot ⟩$ in $V$” only."} {:db/id #edb/ref 17592186272112 :knowledge-point/_questions [{:db/id #edb/ref 17592186133872 :knowledge-point/id #uuid "382a6db7-2708-5711-885e-6f3f3037e8df" :knowledge-point/title "Determining Whether a Set of Functions is Orthogonal With Respect to a Given Inner Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14825df6-62a0-58c7-84f8-874b33d80648" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464126} {:answer/id #uuid "e1fbbaf0-77de-5023-a066-2a3d3242c32e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464127}] :answer-field/correct {:answer/id #uuid "14825df6-62a0-58c7-84f8-874b33d80648" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464126} :answer-field/id #uuid "5210290a-0c21-5691-8070-7eab6efd06ea" :answer-field/key "${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464997} {:answer-field/choices [{:answer/id #uuid "e25fed85-ab3b-5a31-8f1d-2a199858b504" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464128} {:answer/id #uuid "5b56749b-79d6-59cb-8f18-a65746c114a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464129}] :answer-field/correct {:answer/id #uuid "e25fed85-ab3b-5a31-8f1d-2a199858b504" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464128} :answer-field/id #uuid "09f16e55-e049-5129-afae-8b306d36faba" :answer-field/key "${f}_{1}(t)⊥{f}_{3}(t)$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464998} {:answer-field/choices [{:answer/id #uuid "0a92bd8e-cc40-5cc1-818c-7a58e0faa065" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464130} {:answer/id #uuid "71370a5b-7609-5a96-aecd-d3b1db769e68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464131}] :answer-field/correct {:answer/id #uuid "0a92bd8e-cc40-5cc1-818c-7a58e0faa065" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464130} :answer-field/id #uuid "0148a50b-ed82-5196-9619-6267975e2539" :answer-field/key "$S=\\{{f}_{1}(t),{f}_{2}(t),{f}_{3}(t)\\}$ is an orthogonal set with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464999} {:answer-field/choices [{:answer/id #uuid "b754a309-8c6f-5934-9fa7-fcfda5d0e3bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668375} {:answer/id #uuid "00cb01dc-9f22-5784-9de5-d696a76ccd06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668376}] :answer-field/correct {:answer/id #uuid "00cb01dc-9f22-5784-9de5-d696a76ccd06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668376} :answer-field/id #uuid "e23bbd23-dbdc-53c6-b220-50d8c9ad23f6" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668765}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0aa2e7ba-284c-52fb-a0ea-9a38be5541e4" :question/math-academy-id "q-140500" :question/problem "Consider the following set of functions:\n\n$$\n{f}_{1}(t)=t,\\,{f}_{2}(t)={e}^{t},\\,{f}_{3}(t)={e}^{-t}\n$$\n\nGiven that the inner product in the vector space $C[-1,1]$ of continuous functions over $[-1,1]$ is defined as \n\n$$\n⟨f(t),g(t)⟩={\\int }_{-1}^{1}f(t)g(t)\\,\\text{d}t,\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that a set of vectors in an inner product space is called orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement “${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the given inner product” is false. We have\n\n$$\n\\begin{aligned}⟨{f}_{1}(t),{f}_{2}(t)⟩ & =⟨t,{e}^{t}⟩ \\\\  & ={\\int }_{-1}^{1}t{e}^{t}\\,\\text{d}t\\end{aligned}\n$$\n\nLet's use integration by parts. We denote\n\n$$\n\\begin{aligned}u=t & ⟹ & {u}^{′}=1, \\\\ {v}^{′}={e}^{t} & ⟹ & v=\\int {v}^{′}\\,\\text{d}t=\\int {e}^{t}\\,\\text{d}t={e}^{t}.\\end{aligned}\n$$\n\nNow, applying the integration by parts formula, we obtain \n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}t{e}^{t}\\,\\text{d}t & =uv{|}_{-1}^{1}-{\\int }_{-1}^{1}{u}^{′}v\\,\\text{d}t \\\\  & =t{e}^{t}{|}_{-1}^{1}-{\\int }_{-1}^{1}{e}^{t}\\,\\text{d}t \\\\  & =(e+{e}^{-1})-{e}^{t}{|}_{-1}^{1} \\\\  & =(e+{e}^{-1})-(e-{e}^{-1}) \\\\  & =2{e}^{-1}\\ne 0.\\end{aligned}\n$$\n\nThis means that ${f}_{1}(t)⊥̸{f}_{2}(t)$ with respect to the given inner product.\n\n- Statement “${f}_{1}(t)⊥{f}_{3}(t)$ with respect to the given inner product” is false. We have\n\n$$\n\\begin{aligned}⟨{f}_{1}(t),{f}_{3}(t)⟩ & =⟨t,{e}^{-t}⟩ \\\\  & ={\\int }_{-1}^{1}t{e}^{-t}\\,\\text{d}t\\end{aligned}\n$$\n\nLet's use integration by parts. We denote\n\n$$\n\\begin{aligned}u=t & ⟹ & {u}^{′}=1, \\\\ {v}^{′}={e}^{-t} & ⟹ & v=\\int {v}^{′}\\,\\text{d}t=\\int {e}^{-t}\\,\\text{d}t=-{e}^{-t}.\\end{aligned}\n$$\n\nNow, applying the integration by parts formula, we obtain \n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}t{e}^{-t}\\,\\text{d}t & =uv{|}_{-1}^{1}-{\\int }_{-1}^{1}{u}^{′}v\\,\\text{d}t \\\\  & =-t{e}^{-t}{|}_{-1}^{1}+{\\int }_{-1}^{1}{e}^{-t}\\,\\text{d}t \\\\  & =(-{e}^{-1}-e)-{e}^{-t}{|}_{-1}^{1} \\\\  & =(-{e}^{-1}-e)-({e}^{-1}-e) \\\\  & =-2{e}^{-1}\\ne 0.\\end{aligned}\n$$\n\nThis means that ${f}_{1}(t)⊥̸{f}_{3}(t)$ with respect to the given inner product.\n\n- Statement “$S=\\{{f}_{1}(t),{f}_{2}(t),{f}_{3}(t)\\}$ is an orthogonal set with respect to the given inner product” is false. Since ${f}_{1}(t)⊥̸{f}_{2}(t),$ the set $S$ is *not* orthogonal.\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186272134 :knowledge-point/_questions [{:db/id #edb/ref 17592186133951 :knowledge-point/id #uuid "da20ffe7-173b-5fc0-8629-3b9b70222860" :knowledge-point/title "Identifying True Statements About Orthogonal Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98311a5d-c789-50b1-998c-82789cf3e15c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464132} {:answer/id #uuid "4a1caad2-1552-53b2-ad65-0faf937f9cf9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464133}] :answer-field/correct {:answer/id #uuid "4a1caad2-1552-53b2-ad65-0faf937f9cf9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464133} :answer-field/id #uuid "94d3e7a6-f070-518f-bca6-72c0a2e523f0" :answer-field/key "If $\\lambda $ is a real eigenvalue of $Q,$ then $\\lambda =\\pm 1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465000} {:answer-field/choices [{:answer/id #uuid "2950a552-7b64-54f3-9df5-37fbc1daf708" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464134} {:answer/id #uuid "57bc0bcf-2d74-5b42-80b8-a9462aac80d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464135}] :answer-field/correct {:answer/id #uuid "2950a552-7b64-54f3-9df5-37fbc1daf708" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464134} :answer-field/id #uuid "11e24475-4728-5731-901b-4204e0ce6cef" :answer-field/key "If the determinant of $P$ is either $1$ or $-1,$ then $P$ is orthogonal" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465001} {:answer-field/choices [{:answer/id #uuid "427e5f77-75e3-5ea5-8f93-8f5a66733617" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464136} {:answer/id #uuid "01222f75-c4bd-542d-8467-b02dd4c8ea9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464137}] :answer-field/correct {:answer/id #uuid "427e5f77-75e3-5ea5-8f93-8f5a66733617" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464136} :answer-field/id #uuid "d74724c4-d89e-52f6-b857-07eecbd822cb" :answer-field/key "$Q-I$ is singular" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465002} {:answer-field/choices [{:answer/id #uuid "685085c5-4f76-5449-aba7-272f35f605e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668377} {:answer/id #uuid "3468d280-608a-53c5-bdea-8dd36ba8fdfc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668378}] :answer-field/correct {:answer/id #uuid "685085c5-4f76-5449-aba7-272f35f605e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668377} :answer-field/id #uuid "dbb6a335-3974-597f-a03c-f98e6dd50d6a" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668766}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a3d61daa-c943-5ecf-a98c-7f9bcd210491" :question/math-academy-id "q-140565" :question/problem "Which of the following statements are true regarding the $n\\times n$ orthogonal matrix $Q$ and the $n\\times n$ matrix $P?$\n\nSelect all that apply." :question/worked-solution "Recall that a matrix $Q$ is orthogonal if and only if\n\n$$\nQ{Q}^{T}={Q}^{T}Q=I.\n$$\n\nTo check that a matrix is orthogonal, it is sufficient to check that the above equation is satisfied.\n\nMoreover, we have the following properties:\n\n- For any orthogonal matrix $Q,$ we have ${Q}^{-1}={Q}^{T}.$\n\n- $(AB)^{T}={B}^{T}{A}^{T}$ for conformable matrices $A$ and $B.$\n\nWith that in mind, let's inspect each of the statements in turn.\n\n- Statement “If $\\lambda $ is a real eigenvalue of $Q,$ then $\\lambda =\\pm 1$” is true. If $\\lambda $ is an eigenvalue of an orthogonal matrix $Q$ then $\\lambda =\\pm 1$\n\n- Statement “If the determinant of $P$ is either $1$ or $-1,$ then $P$ is orthogonal” is false. Every orthogonal matrix has the determinant equal to $\\pm 1$, but not every matrix with the determinant equal to $\\pm 1$ is orthogonal. As a counterexample, consider the following matrix:\n\n$$\nP=\\begin{bmatrix}2 & 1 \\\\ 1 & 1\\end{bmatrix}\n$$\n\nThe determinant of $P$ is\n\n$$\n\\begin{aligned}det(P)=2\\cdot 1-1\\cdot 1=1,\\end{aligned}\n$$\n\n however, $P$ is not orthogonal since, for example, the first column is not normalized.\n\n- Statement “$Q-I$ is singular” is false. As a counterexample, consider the following orthogonal matrix:\n\n$$\nQ=\\begin{bmatrix}\\frac{3}{5} & -\\frac{4}{5} \\\\ \\frac{4}{5} & \\frac{3}{5}\\end{bmatrix}\n$$\n\nWe have that\n\n$$\nQ-I=\\begin{bmatrix}\\frac{3}{5} & -\\frac{4}{5} \\\\ \\frac{4}{5} & \\frac{3}{5}\\end{bmatrix}-\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-\\frac{2}{5} & -\\frac{4}{5} \\\\ \\frac{4}{5} & -\\frac{2}{5}\\end{bmatrix}\n$$\n\nand $Q-I$ is not singular since, for example, it doesn't have proportional rows or columns.\n\nTherefore, the correct answer is “If $\\lambda $ is a real eigenvalue of $Q,$ then $\\lambda =\\pm 1$” only."} {:db/id #edb/ref 17592186272185 :knowledge-point/_questions [{:db/id #edb/ref 17592186184224 :knowledge-point/id #uuid "25229703-4cfb-5010-ae5c-f6a54503ced3" :knowledge-point/title "Verifying Continuity of Three-Piece Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce697823-b9ba-531c-b6f6-70c01e71b761" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464150} {:answer/id #uuid "80fb9aca-744f-5fe8-afe1-cdac1ac5b86b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464151}] :answer-field/correct {:answer/id #uuid "80fb9aca-744f-5fe8-afe1-cdac1ac5b86b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464151} :answer-field/id #uuid "65ae853f-8dce-5116-80a7-2c8ac7eba9c7" :answer-field/key "$g(x)$ is left-continuous at $x=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465009} {:answer-field/choices [{:answer/id #uuid "1e5c4e5a-3e5f-5204-b749-a5e0440b79b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464152} {:answer/id #uuid "e233e265-68ee-5d13-a722-52a821c352f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464153}] :answer-field/correct {:answer/id #uuid "1e5c4e5a-3e5f-5204-b749-a5e0440b79b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464152} :answer-field/id #uuid "da3ea246-aa5b-5727-95be-be543e633a91" :answer-field/key "$g(x)$ is right-continuous at $x=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465010} {:answer-field/choices [{:answer/id #uuid "1a4ef20b-9de9-53a0-84f4-1b5455e1dafb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464154} {:answer/id #uuid "bb9e1cf6-558c-558b-b78c-b49fab9a0c52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464155}] :answer-field/correct {:answer/id #uuid "1a4ef20b-9de9-53a0-84f4-1b5455e1dafb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464154} :answer-field/id #uuid "c96e675e-3b15-5e60-9aa2-5c5f606831d2" :answer-field/key "$g(x)$ is continuous at $x=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465011} {:answer-field/choices [{:answer/id #uuid "5c427c03-0bf8-5e9d-b8a9-89bbf3541306" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668379} {:answer/id #uuid "88189059-4ace-578a-9024-6a99f1f82ad8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668380}] :answer-field/correct {:answer/id #uuid "5c427c03-0bf8-5e9d-b8a9-89bbf3541306" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668379} :answer-field/id #uuid "20c66141-8226-5ef3-9077-5cdfbb60742a" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668767}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b7059aa8-79d3-5da6-b8bc-f64a765f9c2a" :question/math-academy-id "q-141014" :question/problem "Which of the following statements are true regarding the function $g(x),$ defined below?\n\n$$\ng(x)={\\begin{aligned}\\frac{1}{x-1}, & x<0 \\\\ -1, & x=0 \\\\ x+1, & x>0\\end{aligned}\n$$\n\nSelect all that apply." :question/worked-solution "We're required to determine the left and right continuity properties of $g(x)$ at $x=0.$\n\nFirst, we note that \n\n$$\n\\begin{aligned}g(0)=-1.\\end{aligned}\n$$\n\nNow, let's look at each statement in turn:\n\n- Statement “$g(x)$ is left-continuous at $x=0$” is true. The function is left-continuous at $x=0$ since the left-sided limit is equal to the function value:\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{-}}g(x) & =\\frac{1}{0-1} \\\\  & =-\\frac{1}{1} \\\\  & =-1 \\\\  & =g(0)\\end{aligned}\n$$\n\n- Statement “$g(x)$ is right-continuous at $x=0$” is false. The function is *not* right-continuous at $x=0$ since the right-sided limit is *not* equal to the function value:\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}g(x) & =0+1 \\\\  & =1 \\\\  & \\ne g(0)\\end{aligned}\n$$\n\n- Statement “$g(x)$ is continuous at $x=0$” is false. For the function to be continuous at $x=0,$ it must be both left-continuous and right-continuous. However, we have already determined that the function is not right-continuous at $x=0.$\n\nTherefore, the correct answer is “$g(x)$ is left-continuous at $x=0$” only."} {:db/id #edb/ref 17592186272186 :knowledge-point/_questions [{:db/id #edb/ref 17592186184224 :knowledge-point/id #uuid "25229703-4cfb-5010-ae5c-f6a54503ced3" :knowledge-point/title "Verifying Continuity of Three-Piece Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a46dca9-6a77-532b-a621-e5e80789d8e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464156} {:answer/id #uuid "5799ce27-8068-5b2f-8fc8-1f78767a9193" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464157}] :answer-field/correct {:answer/id #uuid "1a46dca9-6a77-532b-a621-e5e80789d8e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464156} :answer-field/id #uuid "b6b70a5b-de1a-57c7-b6ce-d41bca7868cc" :answer-field/key "$h(x)$ is left-continuous at $x=\\frac{\\pi }{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465012} {:answer-field/choices [{:answer/id #uuid "029a3a0e-cfc6-552a-aa69-8f2a2cb429c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464158} {:answer/id #uuid "518c434f-e88b-53ed-afdc-7cca270b0fc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464159}] :answer-field/correct {:answer/id #uuid "029a3a0e-cfc6-552a-aa69-8f2a2cb429c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464158} :answer-field/id #uuid "4f08f511-e51f-5132-9f31-250abcbd76a9" :answer-field/key "$h(x)$ is right-continuous at $x=\\frac{\\pi }{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465013} {:answer-field/choices [{:answer/id #uuid "07badc24-5a5f-5098-9c7b-2981336dbdc2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464160} {:answer/id #uuid "0c0605c1-7e2a-5150-b68c-ac31d743ba94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464161}] :answer-field/correct {:answer/id #uuid "07badc24-5a5f-5098-9c7b-2981336dbdc2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464160} :answer-field/id #uuid "d54d83fd-9fa4-552f-9d17-d870629c26c9" :answer-field/key "$h(x)$ is continuous at $x=\\frac{\\pi }{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465014} {:answer-field/choices [{:answer/id #uuid "4ec1942a-5db7-5628-aad8-13403420765b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668381} {:answer/id #uuid "5122ad87-09b2-5e54-a1ac-44fb016c87ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668382}] :answer-field/correct {:answer/id #uuid "5122ad87-09b2-5e54-a1ac-44fb016c87ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668382} :answer-field/id #uuid "0b7874b0-9036-5c67-91a6-89d05400f807" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668768}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4a7b393e-0e8e-512c-933e-c05c7c1e88c8" :question/math-academy-id "q-141016" :question/problem "Which of the following statements are true regarding the function $h(x),$ defined below?\n\n$$\nh(x)={\\begin{aligned}\\operatorname{cos}⁡x, & x<\\frac{\\pi }{2} \\\\ 1, & x=\\frac{\\pi }{2} \\\\ 2x, & x>\\frac{\\pi }{2}\\end{aligned}\n$$\n\nSelect all that apply." :question/worked-solution "We're required to determine the left and right continuity properties of $h(x)$ at $x=\\frac{\\pi }{2}.$\n\nFirst, we note that \n\n$$\n\\begin{aligned}h\\left(\\frac{\\pi }{2}\\right)=1.\\end{aligned}\n$$\n\nNow, let's look at each statement in turn:\n\n- Statement “$h(x)$ is left-continuous at $x=\\frac{\\pi }{2}$” is false. The function is *not* left-continuous at $x=\\frac{\\pi }{2}$ since the left-sided limit is *not* equal to the function value:\n\n$$\n\\begin{aligned}{lim}_{x\\to (\\pi /2)^{-}}h(x) & =\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right) \\\\  & =0 \\\\  & \\ne h\\left(\\frac{\\pi }{2}\\right)\\end{aligned}\n$$\n\n- Statement “$h(x)$ is right-continuous at $x=\\frac{\\pi }{2}$” is false. The function is *not* right-continuous at $x=\\frac{\\pi }{2}$ since the right-sided limit is *not* equal to the function value:\n\n$$\n\\begin{aligned}{lim}_{x\\to (\\pi /2)^{+}}h(x) & =2\\left(\\frac{\\pi }{2}\\right) \\\\  & =\\pi  \\\\  & \\ne h\\left(\\frac{\\pi }{2}\\right)\\end{aligned}\n$$\n\n- Statement “$h(x)$ is continuous at $x=\\frac{\\pi }{2}$” is false. For the function to be continuous at $x=\\frac{\\pi }{2},$ it must be both left-continuous and right-continuous. However, we have already determined that the function is neither left-continuous nor right-continuous at $x=\\frac{\\pi }{2}.$\n\nTherefore, the correct answer is \"None.\""} {:db/id #edb/ref 17592186272187 :knowledge-point/_questions [{:db/id #edb/ref 17592186184224 :knowledge-point/id #uuid "25229703-4cfb-5010-ae5c-f6a54503ced3" :knowledge-point/title "Verifying Continuity of Three-Piece Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "988e81c4-45bb-54db-b4b2-1ec2c36ff182" :answer/type {:db/id 