/ref 17592186668504}] :answer-field/correct {:answer/id #uuid "ffb27d71-6970-5190-970e-51d7432db1df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668503} :answer-field/id #uuid "00149b3c-3f62-5264-8228-4c971f6f30d6" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668829}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f2b37341-4b83-58cd-8078-617f2c8f3e30" :question/math-academy-id "q-22011" :question/problem "For the function $f(x)=12{x}^{3}-\\frac{{x}^{5}}{5},$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "We need to identify whether $x=-6$ is a critical point. If it is, we then need to classify it using the second derivative test.\n\nFirst, we need to identify the critical points. Differentiating $f(x)=12{x}^{3}-\\frac{{x}^{5}}{5},$ we get\n\n$$\n{f}^{′}(x)=36{x}^{2}-{x}^{4},\n$$\n\nand solving ${f}^{′}(x)=0,$ we get\n\n$$\n\\begin{aligned}36{x}^{2}-{x}^{4} & =0 \\\\ -{x}^{2}({x}^{2}-36) & =0 \\\\ -{x}^{2}(x+6)(x-6) & =0 \\\\ x & =-6,0,6.\\end{aligned}\n$$\n\nSo we have critical points at $x=-6,0,6.$ We're interested in the critical point $x=-6.$\n\nNext, we need to determine the sign of ${f}^{″}(x)$ at this critical point. Computing ${f}^{″}(x),$ we get\n\n$$\n{f}^{″}(x)=72x-4{x}^{3},\n$$\n\nand evaluating ${f}^{″}(x)$ at $x=-6$, we get\n\n$$\n{f}^{″}(-6)=432>0.\n$$\n\nThe second derivative is positive at $x=-6,$ so this critical point is a relative *minimum*. \n\nTherefore, comparing our results with the given statements, we conclude that:\n\n- $x=-6$ is a critical point of $f(x)\\,✓$\n\n- ${f}^{″}(-6)<0\\,\\times $\n\n- $f(x)$ has a relative *minimum* at $x=-6\\,✓$\n\nTherefore, the correct answer is “$x=-6$ is a critical point of $f(x)$”; “$f(x)$ has a relative minimum at $x=-6$” only."} {:db/id #edb/ref 17592186290364 :knowledge-point/_questions [{:db/id #edb/ref 17592186064165 :knowledge-point/id #uuid "ae256269-0bec-5d57-ac4a-eb0b07926f6f" :knowledge-point/title "Finding Critical Points and Then Classifying Them Using the Second Derivative Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ee50943-da0c-5eb5-b2f8-b23f8c2e2962" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465863} {:answer/id #uuid "da99fa0d-321e-5f45-9408-87319e559341" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465864}] :answer-field/correct {:answer/id #uuid "da99fa0d-321e-5f45-9408-87319e559341" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465864} :answer-field/id #uuid "130f3f1b-18e0-559e-a756-d5a532252295" :answer-field/key "$x=\\sqrt{2}$ is a critical point of $f(x)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466775} {:answer-field/choices [{:answer/id #uuid "3430b47f-98c6-5d2f-942f-81215b4cbc00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465865} {:answer/id #uuid "c64e37d6-0a0b-5b63-b0ff-3c87bbe1d80d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465866}] :answer-field/correct {:answer/id #uuid "3430b47f-98c6-5d2f-942f-81215b4cbc00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465865} :answer-field/id #uuid "221e1b3f-0f02-5f36-ab41-cab13c8646e8" :answer-field/key "${f}^{″}(\\sqrt{2})<0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466776} {:answer-field/choices [{:answer/id #uuid "3e344f84-a25f-5a7a-8f4d-4e58384a648d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465867} {:answer/id #uuid "47bf9edb-8d51-58f7-b466-69861f4dc405" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465868}] :answer-field/correct {:answer/id #uuid "47bf9edb-8d51-58f7-b466-69861f4dc405" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465868} :answer-field/id #uuid "5656ba5f-9174-562a-a795-3a1018968dad" :answer-field/key "$f(x)$ has a relative minimum at $x=\\sqrt{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466777} {:answer-field/choices [{:answer/id #uuid "d21073f0-15be-55ed-903d-af9645d805a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668505} {:answer/id #uuid "a18ffbea-252f-5639-8dc4-e4eefe8a1b34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668506}] :answer-field/correct {:answer/id #uuid "d21073f0-15be-55ed-903d-af9645d805a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668505} :answer-field/id #uuid "8882d672-174c-5259-b12b-76972a51c2a1" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668830}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "247bae04-64ae-5dcd-80c8-d60760babf45" :question/math-academy-id "q-22015" :question/problem "For the function $f(x)=3{x}^{5}-10{x}^{3}+9,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "We need to identify whether $x=\\sqrt{2}$ is a critical point. If it is, we then need to classify it using the second derivative test.\n\nFirst, we need to identify the critical points. Differentiating $f(x)=3{x}^{5}-10{x}^{3}+9,$ we get\n\n$$\n{f}^{′}(x)=15{x}^{4}-30{x}^{2},\n$$\n\nand solving ${f}^{′}(x)=0,$ we get\n\n$$\n\\begin{aligned}15{x}^{4}-30{x}^{2} & =0 \\\\ 15{x}^{2}({x}^{2}-2) & =0 \\\\ 15{x}^{2}(x+\\sqrt{2})(x-\\sqrt{2}) & =0 \\\\ x & =\\pm \\sqrt{2},0.\\end{aligned}\n$$\n\nSo we have critical points at $x=\\pm \\sqrt{2},0.$ We're interested in the critical point $x=\\sqrt{2}.$\n\nNext, we need to determine the sign of ${f}^{″}(x)$ at this critical point. Computing ${f}^{″}(x),$ we get\n\n$$\n{f}^{″}(x)=60{x}^{3}-60x,\n$$\n\nand evaluating ${f}^{″}(x)$ at $x=\\sqrt{2}$, we get\n\n$$\n{f}^{″}(\\sqrt{2})=60(\\sqrt{2})^{3}-60\\sqrt{2}=60\\sqrt{2}>0.\n$$\n\nThe second derivative is positive at $x=\\sqrt{2},$ so this critical point is a relative *minimum*. \n\nTherefore, comparing our results with the given statements, we conclude that:\n\n- $x=\\sqrt{2}$ is a critical point of $f(x)\\,✓$\n\n- ${f}^{″}(\\sqrt{2})>0\\,\\times $\n\n- $f(x)$ has a relative *minimum* at $x=\\sqrt{2}\\,✓$\n\nTherefore, the correct answer is “$x=\\sqrt{2}$ is a critical point of $f(x)$”; “$f(x)$ has a relative minimum at $x=\\sqrt{2}$” only."} {:db/id #edb/ref 17592186290365 :knowledge-point/_questions [{:db/id #edb/ref 17592186064166 :knowledge-point/id #uuid "fbee870b-4a67-5ccb-b274-45fac627be6e" :knowledge-point/title "Classifying a Given Critical Point Using the Second Derivative Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52b64840-cdbe-51af-ae5f-3a1ebf8b1eb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465869} {:answer/id #uuid "539318a7-8cb6-5daa-ac08-572b27b2eefd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value 