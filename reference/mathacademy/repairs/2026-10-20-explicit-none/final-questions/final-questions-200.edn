92186668824}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4b374349-dba8-556c-833d-28419c5d38a1" :question/math-academy-id "q-182011" :question/problem "For the sets $X=\\{x,z\\},$ $Y=\\{a,b\\},$ and $Z=X\\times Y,$ determine which of the following statements are true.\n\nSelect all that apply." :question/worked-solution "The Cartesian product $X\\times Y$ consists of all ordered pairs whose first coordinate belongs to $X$ and whose second coordinate belongs to $Y.$\n\nIn this case, the schematic for $X\\times Y$ is shown below.\n\n![](images/b7/b73e7aeb017bd9f7c50f7d110c7933763834eb391ac4a3e97d25f4e587a8a3d4.png)\n\nHence, the set $Z=X\\times Y$ is given by\n\n$$\nZ={(x,a),(x,b),(z,a),(z,b)}.\n$$\n\nTherefore, the correct answer is $(z,a)\\in Z$ only."} {:db/id #edb/ref 17592186287794 :knowledge-point/_questions [{:db/id #edb/ref 17592186054634 :knowledge-point/id #uuid "a6128eca-7f76-5386-9d67-d81db2943eeb" :knowledge-point/title "Computing a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95846851-9e8b-5ceb-9f37-6ad8c04fb4f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465821} {:answer/id #uuid "9afd3716-75a0-5b6c-a94c-e21e54fd24b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465822}] :answer-field/correct {:answer/id #uuid "9afd3716-75a0-5b6c-a94c-e21e54fd24b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465822} :answer-field/id #uuid "891afbe7-2139-5274-9bde-c2fc0aa50a55" :answer-field/key "$(u,t)\\in Y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466754} {:answer-field/choices [{:answer/id #uuid "25c814d0-fe82-5991-9c4b-2e04a6d8a6b5" :answer/type {:db/id #edb/ref 1