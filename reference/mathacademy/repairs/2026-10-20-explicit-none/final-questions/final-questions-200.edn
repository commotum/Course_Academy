d #uuid "c37efec2-77d1-5d31-9f9f-b29a46d81229" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437906} {:answer/id #uuid "606ba1d3-bcb9-5739-b0cd-4e6ddfbaf77d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437907}] :answer-field/correct {:answer/id #uuid "c37efec2-77d1-5d31-9f9f-b29a46d81229" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437906} :answer-field/id #uuid "0f404ad7-7486-5271-8eb0-8c1a59d275b4" :answer-field/key "The system is consistent dependent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438982} {:answer-field/choices [{:answer/id #uuid "bd0ddc71-3170-556d-88e1-c5190883286b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668355} {:answer/id #uuid "ae67e80c-50b2-5d23-9af4-a4babee4a6bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668356}] :answer-field/correct {:answer/id #uuid "bd0ddc71-3170-556d-88e1-c5190883286b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668355} :answer-field/id #uuid "70c244ab-b0b7-556a-9798-94a84511aabe" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668755}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a61d7528-3ce2-5d0a-af23-11395074997a" :question/math-academy-id "q-131723" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x-y+z &=3 \\\\ -3x+3y-3z &=10\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & -1 & 1 & 3 \\\\ -3 & 3 & -3 & 10\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -1 & 1 & 3 \\\\ -3 & 3 & -3 & 10\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 1 & 3 \\\\ 0 & 0 & 0 & 19\\end{bmatrix}\\end{aligned}\n$$\n\nThe final row corresponds to the equation $0x+0y+0z=19,$ and this has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, only statement “The system is inconsistent” is true."} {:db/id #edb/ref 17592186266115 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2950aad8-79f5-5899-8a58-73ef75011ac0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437908} {:answer/id #uuid "e5392af0-e88c-54d2-80ee-57cd98c53027" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437909}] :answer-field/correct {:answer/id #uuid "2950aad8-79f5-5899-8a58-73ef75011ac0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437908} :answer-field/id #uuid "6c277d28-497a-56d5-a22a-96f890c9bcb2" :answer-field/key "The system is consistent dependent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438983} {:answer-field/choices [{:answer/id #uuid "f6d