093e7c5630c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668495} :answer-field/id #uuid "a4567b17-0ed8-5b2c-b3f7-d8bcd70072a0" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668825}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "700eeff1-f170-54bf-ba40-d6fc6885d99f" :question/math-academy-id "q-182020" :question/problem "For the sets $Z={t,u}$ and $Y=Z\\times Z,$ determine which of the following statements are true.\n\nSelect all that apply." :question/worked-solution "The Cartesian product $Z\\times Z$ consists of all ordered pairs whose first coordinate belongs to $Z$ and whose second coordinate belongs to $Z.$\n\nIn this case, the schematic for ${Z}^{2}=Z\\times Z$ is shown below.\n\n![](images/fa/fa14e54c0518f8f5e64d3ccb4f725bd0b3804fb197d7b90320398ebbf09d68d4.png)\n\nHence, the set $Y=Z\\times Z$ is given by\n\n$$\nY={(t,t),(t,u)(u,t),(u,u)}.\n$$\n\nTherefore, the correct answer is $(u,t)\\in Y$ only."} {:db/id #edb/ref 17592186290259 :knowledge-point/_questions [{:db/id #edb/ref 17592186064166 :knowledge-point/id #uuid "fbee870b-4a67-5ccb-b274-45fac627be6e" :knowledge-point/title "Classifying a Given Critical Point Using the Second Derivative Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28647c8d-4e8f-57ff-b684-32be4e568f93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465827} {:answer/id #uuid "34c6fe0b-a8ad-5fd9-aeb4-86f2e50df8aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465828}] :answer-field/correct {:answer/id #uuid "34c6fe0b-a8ad-5fd9-aeb4-86f2e50df8aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465828} :answer-field/id #uuid "5f1146a9-10ee-58b8-94c8-f3a680255e30" :answer-field/key "${f}^{″}(2)=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466757} {:answer-field/choices [{:answer/id #uuid "268ffdcd-667c-544c-bc23-360a262c796a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465829} {:answer/id #uuid "c559cc34-97ab-5326-abee-590301d3ea53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465830}] :answer-field/correct {:answer/id #uuid "268ffdcd-667c-544c-bc23-360a262c796a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465829} :answer-field/id #uuid "64d9dcfc-ac33-5ace-8683-bacd9076f2a3" :answer-field/key "$f(x)$ has a relative minimum at $x=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466758} {:answer-field/choices [{:answer/id #uuid "24f8b749-3169-5d99-b3ab-2b4f4afd0b8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465831} {:answer/id #uuid "489ce9b4-9556-5322-bdad-c68e6b5f09be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465832}] :answer-field/correct {:answer/id #uuid "24f8b749-3169-5d99-b3ab-2b4f4afd0b8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465831} :answer-field/id #uuid "f1ef321f-b386-5632-8cec-c42e20b7fd95" :answer-field/key "$f(x)$ has a relative maximum at $x=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466759} {:answer-field/choices [{:answer/id #uuid "be66b8e8-6383-5184-97d1-3c17b987d826" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668497} {:answer/id #uuid "4a30d4ec-d7a9-557c-b1a4-af75a26f8398" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668498}] :answer-field/correct {:answer/id #uuid "be66b8e8-6383-5184-97d1-3c17b987d826" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668497} :answer-field/id #uuid "a3387881-e7aa-533f-b5ed-4eca47c14e01" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668826}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "206675d2-b06e-5deb-b30d-ae541d334107" :question/math-academy-id "q-20983" :question/problem "Consider the function $f(x)=2{x}^{3}-12{x}^{2}+24x.$ Given that ${f}^{′}(2)=0,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "We're given that $x=2$ is a stationary point of $f(x).$ We will use the second derivative test to classify this stationary point.\n\nCalculating the first derivative for the function $f(x)=2{x}^{3}-12{x}^{2}+24x,$ we get\n\n$$\n{f}^{′}(x)=6{x}^{2}-24x+24.\n$$\n\nCalculating the second derivative, we get \n\n$$\n{f}^{″}(x)=12x-24.\n$$\n\nSubstituting $x=2,$ we get\n\n$$\n\\begin{aligned}{f}^{″}(2) & =12\\cdot 2-24=0.\\end{aligned}\n$$\n\nSince the second derivative is zero, we conclude that the test is inconclusive, we need to use the first derivative test.\n\nLet's  find other stationary points. These points are the solution of the equation ${f}^{′}(x)=0:$\n\n$$\n\\begin{aligned}6{x}^{2}-24x+24 & =0 \\\\ 6(x-2)^{2} & =0 \\\\ x & =2\\end{aligned}\n$$\n\n \n\nTherefore, the only stationary point is $x=2.$\n\nLet's choose auxiliary points from each side of the stationary point and evaluate the first derivative at them. We take the auxiliary points $x=1,3$\n\n$$\n\\begin{aligned}{f}^{′}(1) & =6(1)^{2}-24(1)+24=6>0 \\\\ {f}^{′}(3) & =6(3)^{2}-24(3)+24=6>0.\\end{aligned}\n$$\n\n \n\nSince the first derivative does not change the sign at $x=2$, we conclude that $f(x)$ has no relative extrema at this point.\n\nTherefore, the correct answer is ${f}^{″}(2)=0$ only."} {:db/id #edb/ref 17592186290309 :knowledge-point/_questions [{:db/id #edb/ref 17592186064165 :knowledge-point/id #uuid "ae256269-0bec-5d57-ac4a-eb0b07926f6f" :knowledge-point/title "Finding Critical Points and Then Classifying Them Using the Second Derivative Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2beee5fa-9bef-5383-a9c4-8f197153726a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465845} {:answer/id #uuid "178776c8-5b13-58a3-af74-43b9a4920dc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465846}] :answer-field/correct {:answer/id #uuid "178776c8-5b13-58a3-af74-43b9a4920dc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465846} :answer-field/id #uuid "63beb250-5e87-52c5-9f14-675220a194f9" :answer-field/key "$x=1$ is a critical point of $f(x)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466766} {:answer-field/choices [{:answer/id #uuid "bf2568b9-f9f4-53c4-8e09-04a0f239a570" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465847} {:answer/id #uuid "ae14151f-054b-57b3-8e30-192d064b3b7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465848}] :answer-field/correct {:answer/id #uuid "ae14151f-054b-57b3-8e30-192d064b3b7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465848} :answer-field/id #uuid "27d88766-cf3f-56c9-aaf4-2204f4fb9d53" :answer-field/key "${f}^{″}(1)<0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466767} {:answer-field/choices [{:answer/id #uuid "916be62e-0dc0-5595-8742-ad982de206bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465849} {:answer/id #uuid "c9c663d7-33c4-5849-b63d-28884d3a4cf8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465850}] :answer-field/correct {:answer/id #uuid "916be62e-0dc0-5595-8742-ad982de206bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465849} :answer-field/id #uuid "800b5f7d-59d0-5331-b789-3c5eb2e6b1bf" :answer-field/key "$f(x)$ has a relative minimum at $x=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466768} {:answer-field/choices [{:answer/id #uuid "22411b74-8496-52ae-b182-94b2748fe696" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668499} {:answer/id #uuid "a3e5b00a-06b2-5d07-bcf3-0cfa7b4b9900" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668500}] :answer-field/correct {:answer/id #uuid "22411b74-8496-52ae-b182-94b2748fe696" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668499} :answer-field/id #uuid "2dcb9e33-8508-55cb-aa88-3af5d4e8a538" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668827}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "48699d28-6189-5c8c-ac56-4e78a856e54a" :question/math-academy-id "q-21500" :question/problem "For the function $f(x)=-3{x}^{5/2}+5{x}^{3/2}+15$ on $(0,\\infty ),$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "We need to identify whether $x=1$ is a critical point. If it is, we then need to classify it using the second derivative test.\n\nFirst, we need to identify the critical points. Differentiating $f(x)=-3{x}^{5/2}+5{x}^{3/2}+15,$ we get\n\n$$\n{f}^{′}(x)=-3\\cdot \\frac{5}{2}{x}^{3/2}+5\\cdot \\frac{3}{2}{x}^{1/2}=-\\frac{15}{2}{x}^{3/2}+\\frac{15}{2}{x}^{1/2},\n$$\n\nand solving ${f}^{′}(x)=0,$ we get\n\n$$\n\\begin{aligned}-\\frac{15}{2}{x}^{3/2}+\\frac{15}{2}{x}^{1/2} & =0 \\\\ -\\frac{15}{2}{x}^{1/2}(x-1) & =0 \\\\ x & =0,1.\\end{aligned}\n$$\n\nSo we have a critical point at $x=1.$\n\nNext, we need to determine the sign of ${f}^{″}(x)$ at this critical point. Computing ${f}^{″}(x),$ we get\n\n$$\n{f}^{″}(x)=-\\frac{15}{2}\\cdot \\frac{3}{2}{x}^{1/2}+\\frac{15}{2}\\cdot \\frac{1}{2}{x}^{-1/2}=-\\frac{45}{4}{x}^{1/2}+\\frac{15}{4}{x}^{-1/2},\n$$\n\nand evaluating ${f}^{″}(x)$ at $x=1$, we get\n\n$$\n{f}^{″}(1)=-\\frac{45}{4}(1)^{1/2}+\\frac{15}{4}(1)^{-1/2}=-\\frac{15}{2}<0.\n$$\n\nThe second derivative is negative at $x=1,$ so this critical point is a relative *maximum*. \n\nTherefore, comparing our results with the given statements, we conclude that:\n\n- $x=1$ is a critical point of $f(x)\\,✓$\n\n- ${f}^{″}(1)<0\\,✓$\n\n- $f(x)$ has a relative *maximum* at $x=1\\,\\times $\n\nTherefore, the correct answer is “$x=1$ is a critical point of $f(x)$”; ${f}^{″}(1)<0$ only."} {:db/id #edb/ref 17592186290310 :knowledge-point/_questions [{:db/id #edb/ref 17592186064165 :knowledge-point/id #uuid "ae256269-0bec-5d57-ac4a-eb0b07926f6f" :knowledge-point/