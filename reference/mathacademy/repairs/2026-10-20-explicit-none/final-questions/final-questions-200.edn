db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466879} {:answer-field/choices [{:answer/id #uuid "9dfe565b-fa14-5be3-99e6-b8bcaf0e2812" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668533} {:answer/id #uuid "f6ed16a3-8660-536b-bfcc-6f45e7f0e021" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668534}] :answer-field/correct {:answer/id #uuid "9dfe565b-fa14-5be3-99e6-b8bcaf0e2812" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668533} :answer-field/id #uuid "fe9bf712-1037-56b7-a278-39d63e5d2ddc" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668844}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "30787f50-63d0-5577-9588-239251d45d11" :question/math-academy-id "q-333092" :question/problem "For which of the following values is Euler's method stable, given that $\\lambda $ is the parameter of the test equation ${y}^{′}=-\\lambda y$ with $y=y(x),y(0)=1,x\\ge 0,\\lambda >0,$ and step size $Δx?$  \n\n*Hint: The stability function for Euler's method is given by* $R(\\lambda Δx)=1-\\lambda Δx.$\n\nSelect all that apply." :question/worked-solution "A numerical method\n${y}_{n+1}={y}_{n}+Δ{y}_{n}$\nis stable for a given step size $Δx$ if, when applied to the test equation\n\n$$\n{y}^{′}=-\\lambda y,\\,y(0)=1,\\,x\\ge 0,\\,\\lambda >0,\n$$\n\nthe numerical solution satisfies ${y}_{n}\\to 0$ as $n\\to \\infty ,$ just like the exact solution.\n\nFor stability, we require that the following condition holds:\n\n$$\n\\begin{aligned}|R(\\lambda Δx)| & <1 \\\\ |1-\\lambda Δx| & <1\\end{aligned}\n$$\n\nSolving this gives\n\n$$\n0<\\lambda Δx<2.\n$$\n\nThis means that Euler's method is stable when applied to the test equation for values in the region $0<\\lambda Δx<2.$ Of the given values:\n\n- $\\lambda Δx=0.4$ falls *within* the given region,\n\n- $\\lambda Δx=2.0$ falls *outside* of the given region,\n\n- $\\lambda Δx=2.4$ falls *outside* the given region, and\n\n- $\\lambda Δx=1.2$ falls *within* the given region.\n\nHence, Euler's method is stable for $\\lambda Δx=0.4$ and $\\lambda Δx=1.2$ only.\n\nTherefore, the correct answer is $\\lambda Δx=0.4$; $\\lambda Δx=1.2$ only."} {:db/id #edb/ref 17592186308541 :knowledge-point/_questions [{:db/id #edb/ref 17592186229159 :knowledge-point/id #uuid "d4823cf5-2656-5616-b4af-193f70c3f2bc" :knowledge-point/title "Determining Stability in Euler's Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b10c1f0-1c23-5e6a-a638-00d4206c3941" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466109} {:answer/id #uuid "d28a6002-55cd-5f7f-bbe3-33e7f86078a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466110}] :answer-field/correct {:answer/id #uuid "d28a6002-55cd-5f7f-bbe3-33e7f86078a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466110} :answer-field/id #uuid "5b58cc72-a7dc-5a38-80f8-5fdd3ef64402" :answer-field/key "$Δx=\\frac{0.25}{\\lambda }$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466898} {:answer-field/choices [{:answer/id #uuid "9f3abbc4-dcb2-5435-b51f-36e87dfc500c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466111} {:answer/id #uuid "931ce38c-be5f-547d-9880-9d2b3317aecb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466112}] :answer-field/correct {:a