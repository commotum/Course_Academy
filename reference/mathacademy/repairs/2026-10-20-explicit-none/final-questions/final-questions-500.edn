nswer-field/key "The digit $8$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475085} {:answer-field/choices [{:answer/id #uuid "87219c45-8a3d-5be1-9864-20d46faf4328" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669041} {:answer/id #uuid "4ceaaf35-5070-5431-bbf0-0fc7a9a31c8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669042}] :answer-field/correct {:answer/id #uuid "87219c45-8a3d-5be1-9864-20d46faf4328" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669041} :answer-field/id #uuid "d751d30f-9587-59cf-abe3-6c201f30a1e4" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669320}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ef2c41de-4b26-57f5-bd27-cd0dbe211bfd" :question/math-academy-id "q-131860" :question/problem "Which digits, when inserted into the blank, make the number $123\\,321\\,87◻$ divisible by $4?$\n\nSelect all that apply." :question/worked-solution "A number is divisible by $4$ if the last two digits form a number that is divisible by $4.$\n\nThe last two digits of the number $123\\,321\\,87◻$ are $7◻.$\n\n- If $2$ is substituted into the blank, then the last two digits are $72,$ which is indeed divisible by $4.$\n\n- If $4$ is substituted into the blank, then the last two digits are $74,$ which is *not* divisible by $4.$\n\n- If $8$ is substituted into the blank, then the last two digits are $78,$ which is *not* divisible by $4.$\n\nTherefore, the correct answer is “The digit $2$” only."} {:db/id #edb/ref 17592186425980 :knowledge-point/_questions [{:db/id #edb/ref 17592186198280 :knowledge-point/id #uuid "aa2f2ccb-45b0-5d6a-aa94-ac3eb95c745b" :knowledge-point/title "Identifying Predicates of More Than One Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f548d9d7-5c43-5510-85e7-89f665103530" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474544} {:answer/id #uuid "299c3818-e21a-5d63-9d43-edb435384b5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474545}] :answer-field/correct {:answer/id #uuid "299c3818-e21a-5d63-9d43-edb435384b5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474545} :answer-field/id #uuid "33029c5d-a58f-5846-b20f-d30fb9ae1431" :answer-field/key "$P(y):$ ${y}^{2}-1=8$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475198} {:answer-field/choices [{:answer/id #uuid "cffbbad6-2ff2-508a-a394-ef1effcca096" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474546} {:answer/id #uuid "966aa064-e076-50ec-9fdb-88187a6d9994" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474547}] :answer-field/correct {:answer/id #uuid "cffbbad6-2ff2-508a-a394-ef1effcca096" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474546} :answer-field/id #uuid "8eb33668-d751-5e1f-a8f1-d04525bc5ad1" :answer-field/key "$Q(a,b):$ ${a}^{2}+{b}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475199} {:answer-field/choices [{:answer/id #uuid "a3099e3c-5a65-5e1b-a4c9-9aceb7935c7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474548} {:answer/id #uuid "517d0ea8-bd34-5d06-9d04-f78f5ae6a208" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474549}] :answer-field/correct {:answer/id #uuid "517d0ea8-bd34-5d06-9d04-f78f5ae6a208" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474549} :answer-field/id #uuid "3bc37e72-ebc3-54f5-abd0-30ce43dacb22" :answer-field/key "$R(x,y):$ $\\frac{x}{y}\\in N\\cap Q$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475200} {:answer-field/choices [{:answer/id #uuid "520c95da-9340-5ba0-ac09-cbd266d73296" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669099} {:answer/id #uuid "165b0990-e705-563a-97f9-44aeef74399a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669100}] :answer-field/correct {:answer/id #uuid "520c95da-9340-5ba0-ac09-cbd266d73296" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669099} :answer-field/id #uuid "be21ab48-a968-552e-8ccb-c6a398c09b92" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669349}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "86866e7c-73c9-5409-8743-b71ad4d3cbe4" :question/math-academy-id "q-175366" :question/problem "Which of the following are mathematical predicates?\n\nSelect all that apply." :question/worked-solution "A *predicate* of the variables ${x}_{1},{x}_{2},…,{x}_{n}$ is a sentence that contains the variables defined on some *universal set*, and has the property that when we substitute concrete values for all the variables into the predicate, the result becomes a statement that is either true or false.\n\nWith that in mind, let's examine our options. \n\n- Option “$P(y):$ ${y}^{2}-1=8$” is a predicate of one variable. Substituting a concrete value for $y$ into the sentence, we get a statement that is either true or false.\n\n- Option “$Q(a,b):$ ${a}^{2}+{b}^{2}$” is *not* a predicate. Substituting a concrete pair of values $(a,b)$ into the sentence, we do not get a statement that is either true or false.\n\n- Option “$R(x,y):$ $\\frac{x}{y}\\in N\\cap Q$” is a predicate of two variables. Substituting a concrete pair of values $(x,y)$ into the sentence, we get a statement that is either true or false.\n\nTherefore, the correct answer is “$P(y):$ ${y}^{2}-1=8$”; “$R(x,y):$ $\\frac{x}{y}\\in N\\cap Q$” only."} {:db/id #edb/ref 17592186426030 :knowledge-point/_questions [{:db/id #edb/ref 17592186162153 :knowledge-point/id #uuid "196e7d31-5af8-5c82-b2bd-0cf1ed7415e2" :knowledge-point/title "Determining Whether Two Random Variables are Independent Given the Joint PMF Only"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eef6c94a-e496-5891-a2ca-b9ac53696b93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474392} {:answer/id #uuid "741b2c42-773e-5ec4-9974-e7e956acbdca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474393}] :answer-field/correct {:answer/id #uuid "741b2c42-773e-5ec4-9974-e7e956acbdca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474393} :answer-field/id #uuid "5e8f1f9b-c7ae-59c4-9600-fc6d84220816" :answer-field/key "$P(X=1,Y=1)$ $=P(X=1)\\cdot P(Y=1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475122} {:answer-field/choices [{:answer/id #uuid "d17410a8-6d51-5fbd-a6e2-afab502e03a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474394} {:answer/id #uuid "af4458a5-0951-5cde-ba22-486fe27e56df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474395}] :answer-field/correct {:answer/id #uuid "d17410a8-6d51-5fbd-a6e2-afab502e03a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474394} :answer-field/id #uuid "6d41f5c7-38fe-52a2-ac70-78a54dd7e7be" :answer-field/key "$P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475123} {:answer-field/choices [{:answer/id #uuid "45d41db6-c839-5651-be71-5da1d3518353" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474396} {:answer/id #uuid "7c8c5f95-5115-5b8c-87c7-c97126e15804" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474397}] :answer-field/correct {:answer/id #uuid "45d41db6-c839-5651-be71-5da1d3518353" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474396} :answer-field/id #uuid "569f02b4-e8e3-5e5d-a2af-5774202b1895" :answer-field/key "$X$ and $Y$ are independent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475124} {:answer-field/choices [{:answer/id #uuid "36588ac2-cc78-56b0-8adc-d10170dd815e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669059} {:answer/id #uuid "6fcf8c1a-a5a9-553b-a064-9484e90c3780" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669060}] :answer-field/correct {:answer/id #uuid "36588ac2-cc78-56b0-8adc-d10170dd815e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669059} :answer-field/id #uuid "0ea1c5b9-5353-51ee-ba5f-6972b65d512f" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669329}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1ce1827c-c98c-5481-b210-2bd31e84c14f" :question/math-academy-id "q-143337" :question/problem "The joint probability distribution $f(x,y)$ of the discrete random variables $X$ and $Y$ are given below. \n\n| $f$ | $Y=1$ | $Y=2$ | $Y=3$ |\n| --- | --- | --- | --- |\n| $X=0$ | $0.14$ | $0.16$ | $0.05$ |\n| $X=1$ | $0.26$ | $0.34$ | $0.05$ |\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Two discrete random variables $X$ and $Y$ with a joint probability mass function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability mass functions for $X$ and $Y,$ respectively.\n\nComputing the marginal probability mass functions for  $X$ and $Y,$ we obtain the following:\n\n| $f$ | $Y=1$ | $Y=2$ | $Y=3$ | ${f}_{X}$ |\n| --- | --- | --- | --- | --- |\n| $X=0$ | $0.14$ | $0.16$ | $0.05$ | $0.35$ |\n| $X=1$ | $0.26$ | $0.34$ | $0.05$ | $0.65$ |\n| ${f}_{Y}$ | $0.4$ | $0.5$ | $0.1$ | $1$ |\n\nWith that in mind, let's examine our statements.\n\n- Statement $P(X=1,Y=1)$ $=P(X=1)\\cdot P(Y=1)$ is true. From the table, we obtain that $P(X=1,Y=1)=f(1,1)=0.26.$ On the other hand, \n\n$$\nP(X=1)\\cdot P(Y=1)={f}_{X}(1)\\cdot {f}_{Y}(1)=0.65\\cdot 0.4=0.26.\\,✓\n$$\n\n- Statement “$P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$” is false. Checking some possible products, we obtain the following:\n\n$$\n\\begin{aligned}f(0,1) & =0.14=0.35\\cdot 0.4={f}_{X}(0)\\cdot {f}_{Y}(1) & ✓ \\\\ f(0,2) & =0.16\\ne 0.35\\cdot 0.5={f}_{X}(0)\\cdot {f}_{Y}(2) & \\times \\end{aligned}\n$$\n\nSo, $P(X=x,Y=y)\\ne P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y.$\n\n- Statement “$X$ and $Y$ are independent” is false. Since statement “$P(X=x,Y=y)$ $=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$” is false, our random variables $X$ and $Y$ are *not* independent.\n\nTherefore, the correct answer is $P(X=1,Y=1)$ $=P(X=1)\\cdot P(Y=1)$ only."} {:db/id #edb/ref 17592186426532 :knowledge-point/_questions [{:db/id #edb/ref 17592186192780 :knowledge-point/id #uuid "e3fe3596-340e-5155-bed3-cf25f5843d70" :knowledge-point/title "Identifying Whether Sets Represented Graphically Are Subspaces in Two-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98e36e60-7f4e-5471-9c79-3de0fa9fb055" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474254} {:answer/id #uuid "ecd5cedc-0fa5-539c-83af-8334b94a61b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474255}] :answer-field/correct {:answer/id #uuid "98e36e60-7f4e-5471-9c79-3de0fa9fb055" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474254} :answer-field/id #uuid "45f824b7-26f5-51aa-88da-6f8a9190aea6" :answer-field/key "![Diagram I](images/58/589fb32bea6b8957a7898d7a03991e5bf36e4b9592b39bd6bb5bc2c0ee042c0b.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475053} {:answer-field/choices [{:answer/id #uuid "d05a5c0b-7cf8-5741-abe3-5160cf118536" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474256} {:answer/id #uuid "eb08479f-5f31-5a03-a005-616f28978efb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474257}] :answer-field/correct {:answer/id #uuid "d05a5c0b-7cf8-5741-abe3-5160cf118536" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474256} :answer-field/id #uuid "60c1be91-8261-58d6-be0c-8554e0b3f515" :answer-field/key "![Diagram II](images/46/462f8e01fa8a0d56f18998a67af72a8512d7e37180641fb1de10a8a069fe2b81.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475054} {:answer-field/choices [{:answer/id #uuid "a2c29e1d-be92-5d99-b462-8c335808a7c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474258} {:answer/id #uuid "ca799662-448d-5eb3-89be-6549746e0a79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474259}] :answer-field/correct {:answer/id #uuid "a2c29e1d-be92-5d99-b462-8c335808a7c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474258} :answer-field/id #uuid "435b445b-a1d3-5c7e-bda2-9e456fd12252" :answer-field/key "![Diagram III](images/57/57d69ec94f2cdfb8e20d959240983309aac60814ac0f50fba2f7381f04da2429.svg)" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475055} {:answer-field/choices [{:answer/id #uuid "b4459c66-a2f3-5445-90f0-ae904bdcc170" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668989} {:answer/id #uuid "a6ccc508-a7f2-5577-ab13-670537fed342" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668990}] :answer-field/correct {:answer/id #uuid "a6ccc508-a7f2-5577-ab13-670537fed342" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668990} :answer-field/id #uuid "3588ac9c-129e-5d9d-8648-01c928c71177" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669294}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "61609b84-fa99-5574-b117-b0c4a018b4cb" :question/math-academy-id "q-110456" :question/problem "Which of the diagrams shown below represent subspaces of ${R}^{2}?$\n\nSelect all that apply." :question/worked-solution "Let's analyze each diagram in turn.\n\n- Diagram I does not represent a subspace. The vector $a=\\begin{bmatrix}-1 \\\\ -1\\end{bmatrix}$ lies inside the given subset. But \n\n$$\n(-1)\\cdot a=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}\n$$\n\nlies outside the subset.\n\n- Diagram II represents a set that does not contain the origin. But every subspace must contain the origin, so Diagram II is not a subspace of ${R}^{2}.$\n\n- Diagram III represents the whole plane ${R}^{2}$ without the origin. But every subspace must contain the origin, so Diagram III is not a subspace of ${R}^{2}.$\n\nSo, the correct answer is \"None.\""} {:db/id #edb/ref 17592186430806 :knowledge-point/_questions [{:db/id #edb/ref 17592186133871 :knowledge-point/id #uuid "67683e7d-bf4f-5fdf-8fe5-df996c30e836" :knowledge-point/title "Determining Whether a Set of Vectors Is Orthogonal With Respect to a Given Inner Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c6f05695-5d5d-5e1b-bfad-77c51f81a863" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474374} {:answer/id #uuid "dcc309ff-eb8f-559c-b906-81545a54e0e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474375}] :answer-field/correct {:answer/id #uuid "dcc309ff-eb8f-559c-b906-81545a54e0e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474375} :answer-field/id #uuid "2d94332b-01c8-5d93-bd36-59655b6dc3cf" :answer-field/key "${v}_{1}⊥{v}_{2}$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475113} {:answer-field/choices [{:answer/id #uuid "2df48fe1-4c0e-5788-ae44-be72c3a42df4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474376} {:answer/id #uuid "674b056b-93cf-5bbe-ae7e-6ce2c2c14c50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474377}] :answer-field/correct {:answer/id #uuid "2df48fe1-4c0e-5788-ae44-be72c3a42df4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474376} :answer-field/id #uuid "05746e78-6328-58c4-96d3-034fda58ec6d" :answer-field/key "${v}_{2}⊥̸{v}_{3}$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475114} {:answer-field/choices [{:answer/id #uuid "99e78717-3155-5738-b52e-432f0cf2cf83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474378} {:answer/id #uuid "f66fe2c1-0155-5688-b8cc-b89a397d5048" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474379}] :answer-field/correct {:answer/id #uuid "f66fe2c1-0155-5688-b8cc-b89a397d5048" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474379} :answer-field/id #uuid "453a25c3-916b-52ae-94c1-1cdb5d5d8d36" :answer-field/key "$S=\\{{v}_{1},{v}_{2},{v}_{3}\\}$ is an orthogonal set with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475115} {:answer-field/choices [{:answer/id #uuid "4707323a-31a2-5b84-92e1-2a1c29bc1ed7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669053} {:answer/id #uuid "dce3363f-b5b3-504f-a3f7-739a292f9768" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669054}] :answer-field/correct {:answer/id #uuid "4707323a-31a2-5b84-92e1-2a1c29bc1ed7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669053} :answer-field/id #uuid "b5649159-30a6-583d-a2b7-4f350f02cf3a" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669326}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7f21c5fc-f92d-5b81-95e0-bb89748670fa" :question/math-academy-id "q-140497" :question/problem "$$\n{v}_{1}=\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix},\\,{v}_{2}=\\begin{bmatrix}-1 \\\\ 7 \\\\ -1\\end{bmatrix},\\,{v}_{3}=\\begin{bmatrix}2 \\\\ 0 \\\\ -5\\end{bmatrix}\n$$\n\nConsider the vectors shown above. Given that the inner product in the vector space ${R}^{3}$ is defined as \n\n$$\n⟨x,y⟩=5{x}_{1}{y}_{1}+{x}_{2}{y}_{2}+2{x}_{3}{y}_{3},\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that a set of vectors in an inner product space is orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement “${v}_{1}⊥{v}_{2}$ with respect to the given inner product” is true. Indeed, we have\n\n$$\n\\begin{aligned}⟨{v}_{1},{v}_{2}⟩ & =5(1)(-1)+(1)(7)+2(1)(-1) \\\\  & =-5+7-2 \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${v}_{1}⊥{v}_{2}$ with respect to the given inner product.\n\n- Statement “${v}_{2}⊥̸{v}_{3}$ with respect to the given inner product” is false since \n\n$$\n\\begin{aligned}⟨{v}_{2},{v}_{3}⟩ & =5(-1)(2)+(7)(0)+2(-1)(-5) \\\\  & =-10+0+10 \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${v}_{2}⊥{v}_{3}$ with respect to the given inner product.\n\n- Statement “$S=\\{{v}_{1},{v}_{2},{v}_{3}\\}$ is an orthogonal set with respect to the given inner product” is true. Indeed, computing the inner product $⟨{v}_{1},{v}_{3}⟩$, we have \n\n$$\n\\begin{aligned}⟨{v}_{1},{v}_{3}⟩ & =5(1)(2)+(1)(0)+2(1)(-5) \\\\  & =10+0-10 \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${v}_{1}⊥{v}_{3}$ with respect to the given inner product.\nAs a result, the set $S$ is orthogonal.\n\nTherefore, the correct answer is “${v}_{1}⊥{v}_{2}$ with respect to the given inner product”; “$S=\\{{v}_{1},{v}_{2},{v}_{3}\\}$ is an orthogonal set with respect to the given inner product” only."} {:db/id #edb/ref 17592186430807 :knowledge-point/_questions [{:db/id #edb/ref 17592186133870 :knowledge-point/id #uuid "c2bcfcb6-8f8b-5aa9-8346-05db880fa5bb" :knowledge-point/title "Determining Whether a Set of Polynomials is Orthogonal With Respect to a Given Inner Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4a33807-0dc5-58b8-9e96-d36c211cd17f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474200} {:answer/id #uuid "630190b1-87c4-5c43-bc91-504b4950f58e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474201}] :answer-field/correct {:answer/id #uuid "630190b1-87c4-5c43-bc91-504b4950f58e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474201} :answer-field/id #uuid "4790b87e-09c0-53d0-8040-c5d65661c89f" :answer-field/key "${p}_{1}(t)⊥̸{p}_{2}(t)$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475026} {:answer-field/choices [{:answer/id #uuid "2983d130-4a1c-5f7c-92f8-2b8f8ef9258b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474202} {:answer/id #uuid "5a01831f-984b-5618-8beb-6e5a83c9d9c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474203}] :answer-field/correct {:answer/id #uuid "5a01831f-984b-5618-8beb-6e5a83c9d9c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474203} :answer-field/id #uuid "08ee9bbc-f25e-576b-8ecb-a39f90ca2847" :answer-field/key "${p}_{1}(t)⊥{p}_{3}(t)$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475027} {:answer-field/choices [{:answer/id #uuid "9c407a64-fdc1-57ce-9336-528dd1775a08" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474204} {:answer/id #uuid "b332a85e-6f82-5133-8e3a-be50909f94ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474205}] :answer-field/correct {:answer/id #uuid "9c407a64-fdc1-57ce-9336-528dd1775a08" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474204} :answer-field/id #uuid "4c2d9797-b732-51a2-940c-b09caf6ff041" :answer-field/key "$S=\\{{p}_{1}(t),{p}_{2}(t),{p}_{3}(t)\\}$ is an orthogonal set with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475028} {:answer-field/choices [{:answer/id #uuid "7956c371-f1a8-5774-8ee8-4e0c74035776" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668961} {:answer/id #uuid "de454c30-25c9-5325-8548-65079dc1d0b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668962}] :answer-field/correct {:answer/id #uuid "7956c371-f1a8-5774-8ee8-4e0c74035776" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668961} :answer-field/id #uuid "00d05342-c58d-593c-bc52-820754a0100e" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669280}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c3a213f9-9ffe-56d7-a8aa-efb68c3978ef" :question/math-academy-id "q-104735" :question/problem "Consider the following set of polynomials:\n\n$$\n{p}_{1}(t)=3t,\\,{p}_{2}(t)=t+1,\\,{p}_{3}(t)={t}^{2}-1.\n$$\n\nGiven that the inner product in the vector space ${R}_{2}[t]$ of polynomials of degree at most $2$ in the variable $t$ is defined as \n\n$$\n⟨p(t),q(t)⟩=p(-1)q(-1)+p(0)q(0)+p(1)q(1),\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that a set of vectors in an inner product space is orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement “${p}_{1}(t)⊥̸{p}_{2}(t)$ with respect to the given inner product” is true. Indeed, we have\n\n$$\n\\begin{aligned}⟨{p}_{1}(t),{p}_{2}(t)⟩ & =⟨3t,t+1⟩ \\\\  & =(3t){|}_{-1}\\cdot (t+1){|}_{-1}+(3t){|}_{0}\\cdot (t+1){|}_{0}+(3t){|}_{1}\\cdot (t+1){|}_{1} \\\\  & =(3(-1))\\cdot ((-1)+1)+(3(0))\\cdot (0+1)+(3(1))\\cdot (1+1) \\\\  & =6\\ne 0,\\end{aligned}\n$$\n\nwhich means that ${p}_{1}(t)⊥̸{p}_{2}(t)$ with respect to the given inner product.\n\n- Statement “${p}_{1}(t)⊥{p}_{3}(t)$ with respect to the given inner product” is true. Indeed, we have\n\n$$\n\\begin{aligned}⟨{p}_{1}(t),{p}_{3}(t)⟩ & =⟨3t,{t}^{2}-1⟩ \\\\  & =(3t){|}_{-1}\\cdot ({t}^{2}-1){|}_{-1}+(3t){|}_{0}\\cdot ({t}^{2}-1){|}_{0}+(3t){|}_{1}\\cdot ({t}^{2}-1){|}_{1} \\\\  & =(3(-1))\\cdot ((-1)^{2}-1)+(3(0))\\cdot ({0}^{2}-1)+(3(1))\\cdot ({1}^{2}-1) \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${p}_{1}(t)⊥{p}_{3}(t)$ with respect to the given inner product.\n\n- Statement “$S=\\{{p}_{1}(t),{p}_{2}(t),{p}_{3}(t)\\}$ is an orthogonal set with respect to the given inner product” is false. Since ${p}_{1}(t)⊥̸{p}_{2}(t),$ the set $S$ is *not* an orthogonal set.\n\nTherefore, the correct answer is “${p}_{1}(t)⊥̸{p}_{2}(t)$ with respect to the given inner product”; “${p}_{1}(t)⊥{p}_{3}(t)$ with respect to the given inner product” only."} {:db/id #edb/ref 17592186430808 :knowledge-point/_questions [{:db/id #edb/ref 17592186133871 :knowledge-point/id #uuid "67683e7d-bf4f-5fdf-8fe5-df996c30e836" :knowledge-point/title "Determining Whether a Set of Vectors Is Orthogonal With Respect to a Given Inner Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f67cf98-c041-56b4-b675-cd6608fe0e87" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186475020} {:answer/id #uuid "0fa3734e-111b-53f2-8ebe-871dfb1f88e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186475021}] :answer-field/correct {:answer/id #uuid "4f67cf98-c041-56b4-b675-cd6608fe0e87" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186475020} :answer-field/id #uuid "17fd2243-0f57-5f80-9382-57761ade6958" :answer-field/key "${v}_{1}⊥̸{v}_{2}$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475436} {:answer-field/choices [{:answer/id #uuid "e85a7d43-b6d8-581b-9e5f-5f063c7c4b21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186475022} {:answer/id #uuid "b53eb6b7-af91-5d0b-8d68-a78f87a43b92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186475023}] :answer-field/correct {:answer/id #uuid "b53eb6b7-af91-5d0b-8d68-a78f87a43b92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186475023} :answer-field/id #uuid "623fd893-1fe0-5fbf-984e-f62b33160f96" :answer-field/key "${v}_{2}⊥{v}_{3}$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475437} {:answer-field/choices [{:answer/id #uuid "113ff175-e867-564a-8a13-cc2d64307b61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186475024} {:answer/id #uuid "72498a25-b060-53eb-8bae-7190cb5973bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186475025}] :answer-field/correct {:answer/id #uuid "72498a25-b060-53eb-8bae-7190cb5973bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186475025} :answer-field/id #uuid "9ac4eba3-941d-510f-b8db-bb23b5d39486" :answer-field/key "$S=\\{{v}_{1},{v}_{2},{v}_{3}\\}$ is an orthogonal set with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475438} {:answer-field/choices [{:answer/id #uuid "dbaf05a7-6385-5e23-ba00-2b83a3dee723" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669253} {:answer/id #uuid "cf86df33-8bad-5b91-9123-cbcd52985621" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669254}] :answer-field/correct {:answer/id #uuid "dbaf05a7-6385-5e23-ba00-2b83a3dee723" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669253} :answer-field/id #uuid "1e528a99-beb5-5dea-ae67-24c2b2fd743e" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669426}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e1da803c-87de-5156-b3a7-d636001e9616" :question/math-academy-id "q-99637" :question/problem "$$\n{v}_{1}=\\begin{bmatrix}2 \\\\ -1 \\\\ 1\\end{bmatrix},\\,{v}_{2}=\\begin{bmatrix}1 \\\\ 1 \\\\ -1\\end{bmatrix},\\,{v}_{3}=\\begin{bmatrix}0 \\\\ 1 \\\\ 3\\end{bmatrix}\n$$\n\nConsider the vectors shown above. Given that the inner product in the vector space ${R}^{3}$ is defined as \n\n$$\n⟨x,y⟩=2{x}_{1}{y}_{1}+3{x}_{2}{y}_{2}+{x}_{3}{y}_{3},\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that a set of vectors in an inner product space is orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement “${v}_{1}⊥̸{v}_{2}$ with respect to the given inner product” is false since\n\n$$\n\\begin{aligned}⟨{v}_{1},{v}_{2}⟩ & =2(2)(1)+3(-1)(1)+(1)(-1) \\\\  & =4-3-1 \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${v}_{1}⊥{v}_{2}$ with respect to the given inner product.\n\n- Statement “${v}_{2}⊥{v}_{3}$ with respect to the given inner product” is true. Indeed, we have \n\n$$\n\\begin{aligned}⟨{v}_{2},{v}_{3}⟩ & =2(1)(0)+3(1)(1)+(-1)(3) \\\\  & =0+3-3 \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${v}_{2}⊥{v}_{3}$ with respect to the given inner product.\n\n- Statement “$S=\\{{v}_{1},{v}_{2},{v}_{3}\\}$ is an orthogonal set with respect to the given inner product” is true. Indeed, computing the inner product $⟨{v}_{1},{v}_{3}⟩$, we have \n\n$$\n\\begin{aligned}⟨{v}_{1},{v}_{3}⟩ & =2(2)(0)+3(-1)(1)+(1)(3) \\\\  & =0-3+3 \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${v}_{1}⊥{v}_{3}$ with respect to the given inner product.\nAs a result, the set $S$ is orthogonal.\n\nTherefore, the correct answer is “${v}_{2}⊥{v}_{3}$ with respect to the given inner product”; “$S=\\{{v}_{1},{v}_{2},{v}_{3}\\}$ is an orthogonal set with respect to the given inner product” only."} {:db/id #edb/ref 17592186432579 :knowledge-point/_questions [{:db/id #edb/ref 17592186152280 :knowledge-point/id #uuid "e66005fe-df33-590a-9d9c-91947cd4a608" :knowledge-point/title "Identifying Fundamental Sets of Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9434ee35-97a1-5285-97bd-642508f58883" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474768} {:answer/id #uuid "2e62f471-e501-527c-a2bf-b58c36ed0de8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474769}] :answer-field/correct {:answer/id #uuid "2e62f471-e501-527c-a2bf-b58c36ed0de8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474769} :answer-field/id #uuid "f52c9065-8b6f-5163-be58-9a1c7fadbe10" :answer-field/key "${y}_{1}(x)=\\frac{1}{x}$ is a solution to the equation for $x>0.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475310} {:answer-field/choices [{:answer/id #uuid "ee5d6baf-53f3-5f60-82f6-8b26db329f95" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474770} {:answer/id #uuid "87258704-04de-53fe-86be-3991a51c9d68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474771}] :answer-field/correct {:answer/id #uuid "87258704-04de-53fe-86be-3991a51c9d68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474771} :answer-field/id #uuid "4f5919f8-4a8b-57fc-ba5e-3d0f046a50c8" :answer-field/key "${y}_{2}(x)=\\sqrt{x}$ is a solution to the equation for $x>0.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475311} {:answer-field/choices [{:answer/id #uuid "7a4f9e18-0783-5aa4-ba7f-a403d553756b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474772} {:answer/id #uuid "b9af53cc-7fb3-530b-a444-9b33c32f55d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474773}] :answer-field/correct {:answer/id #uuid "b9af53cc-7fb3-530b-a444-9b33c32f55d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474773} :answer-field/id #uuid "da939024-b939-5a26-a4f7-b9817e50d965" :answer-field/key "The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation on $(0,\\infty ).$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475312} {:answer-field/choices [{:answer/id #uuid "31f59168-4cfc-56af-bf7f-019fc0d12390" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669163} {:answer/id #uuid "583b5b43-6df7-5d81-8579-cea13e85d426" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669164}] :answer-field/correct {:answer/id #uuid "31f59168-4cfc-56af-bf7f-019fc0d12390" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669163} :answer-field/id #uuid "88133f31-18b8-58be-acbb-c90966099ef5" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669381}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "248767b0-4e8f-59a2-a18a-6d7a3f7d1129" :question/math-academy-id "q-334262" :question/problem "$$\n4{x}^{2}{y}^{″}+6x{y}^{′}-2y=0\n$$\n\nConsider the differential equation above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation. \n\nLet's check each statement in turn.\n\n- Statement “${y}_{1}(x)=\\frac{1}{x}$ is a solution to the equation for $x>0.$” is true. First, we find the first and second derivatives of ${y}_{1}(x).$ Notice that $\\frac{1}{x}={x}^{-1},$ so we have:\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & =-\\frac{1}{{x}^{2}} \\\\ {y}_{1}^{″}(x) & =\\frac{2}{{x}^{3}}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}4{x}^{2}\\left(\\frac{2}{{x}^{3}}\\right)+6x\\left(-\\frac{1}{{x}^{2}}\\right)-2\\left(\\frac{1}{x}\\right) & =0 \\\\ (\\frac{8}{x}-\\frac{6}{x}-\\frac{2}{x}) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{1}(x)$ is a solution to the equation.\n\n- Statement “${y}_{2}(x)=\\sqrt{x}$ is a solution to the equation for $x>0.$” is true. First, we find the first and second derivatives of ${y}_{2}(x).$ Notice that $\\sqrt{x}={x}^{\\frac{1}{2}},$ so we have:\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & =\\frac{1}{2}{x}^{-1/2} \\\\ {y}_{2}^{″}(x) & =-\\frac{1}{4}{x}^{-3/2}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}4{x}^{2}(-\\frac{1}{4}{x}^{-3/2})+6x(\\frac{1}{2}{x}^{-1/2})-2\\sqrt{x} & =0 \\\\ (-{x}^{1/2}+3{x}^{1/2}-2{x}^{1/2}) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{2}(x)$ is a solution to the equation.\n\n- Statement “The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation on $(0,\\infty ).$” is true. Both ${y}_{1}$ and ${y}_{2}$ are solutions of the equation. To check if these functions are linearly independent, we compute the Wronskian:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}{x}^{-1} & {x}^{1/2} \\\\ -{x}^{-2} & \\frac{1}{2}{x}^{-1/2}\\end{aligned}| \\\\  & ={x}^{-1}\\cdot \\frac{1}{2}{x}^{-1/2}-{x}^{1/2}\\cdot (-{x}^{-2}) \\\\  & =\\frac{1}{2}{x}^{-3/2}+{x}^{-3/2} \\\\  & =\\frac{3}{2}{x}^{-3/2}\\end{aligned}\n$$\n\nSince the  Wronskian is not identically $0$ on $(0,\\infty ),$ the functions are linearly independent. Hence, ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation on $(0,\\infty ).$\n\nTherefore, the correct answer is “${y}_{1}(x)=\\frac{1}{x}$ is a solution to the equation for $x>0.$”; “${y}_{2}(x)=\\sqrt{x}$ is a solution to the equation for $x>0.$”; “The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation on $(0,\\infty ).$”."} {:db/id #edb/ref 17592186432580 :knowledge-point/_questions [{:db/id #edb/ref 17592186152280 :knowledge-point/id #uuid "e66005fe-df33-590a-9d9c-91947cd4a608" :knowledge-point/title "Identifying Fundamental Sets of Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bacd32ae-566a-595f-ae61-c7390064179f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474762} {:answer/id #uuid "af9b7df9-824a-5976-8ef0-0ed97e33de24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474763}] :answer-field/correct {:answer/id #uuid "bacd32ae-566a-595f-ae61-c7390064179f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474762} :answer-field/id #uuid "8b52e612-ea71-5a2e-a81c-18901ac0011f" :answer-field/key "${y}_{1}(x)=\\frac{1}{{x}^{3}}$ is a solution to the equation." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475307} {:answer-field/choices [{:answer/id #uuid "b9146691-1ccc-57f9-88b9-54805a3f76b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474764} {:answer/id #uuid "5bb64cb4-e2ff-50e2-a176-9905722d9d9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474765}] :answer-field/correct {:answer/id #uuid "5bb64cb4-e2ff-50e2-a176-9905722d9d9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474765} :answer-field/id #uuid "e7f934a8-f5e6-5690-a1d4-2746d5ccf5fa" :answer-field/key "${y}_{2}(x)={x}^{3}$ is a solution to the equation." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475308} {:answer-field/choices [{:answer/id #uuid "c25a7c82-ba97-5324-83d9-8843be6f251d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474766} {:answer/id #uuid "97e7e003-0f8d-59ae-a1f3-79ac064de7a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474767}] :answer-field/correct {:answer/id #uuid "c25a7c82-ba97-5324-83d9-8843be6f251d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474766} :answer-field/id #uuid "9fb9f336-1bf0-5e57-b4b7-e8e56b5843aa" :answer-field/key "The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475309} {:answer-field/choices [{:answer/id #uuid "c3afcad9-b96a-542d-93d2-13dc85849129" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669161} {:answer/id #uuid "d5a48733-9d35-5dca-abec-a33a03d053a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669162}] :answer-field/correct {:answer/id #uuid "c3afcad9-b96a-542d-93d2-13dc85849129" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669161} :answer-field/id #uuid "782071e7-63ab-57f8-8b98-9927a0c4f6ea" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669380}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8005871f-5013-58a1-b9ee-7ef831d491ac" :question/math-academy-id "q-334257" :question/problem "$$\n{x}^{2}{y}^{″}+2x{y}^{′}-12y=0\n$$\n\nConsider the differential equation above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation. \n\nLet's check each statement in turn.\n\n- Statement “${y}_{1}(x)=\\frac{1}{{x}^{3}}$ is a solution to the equation” is false. We find the first and second derivatives of ${y}_{1}(x):$\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & =-\\frac{3}{{x}^{4}} \\\\ {y}_{1}^{″}(x) & =\\frac{12}{{x}^{5}}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{x}^{2}\\left(\\frac{12}{{x}^{5}}\\right)+2x\\left(-\\frac{3}{{x}^{4}}\\right)-12\\left(\\frac{1}{{x}^{3}}\\right) & =0 \\\\ -\\frac{6}{{x}^{3}} & =0\\,\\times \\end{aligned}\n$$\n\nSo, ${y}_{1}(x)$ is not a solution to the equation.\n\n- Statement “${y}_{2}(x)={x}^{3}$ is a solution to the equation” is true. We find the first and second derivatives of ${y}_{2}(x):$\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & =3{x}^{2} \\\\ {y}_{2}^{″}(x) & =6x\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{x}^{2}(6x)+2x(3{x}^{2})-12({x}^{3}) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{2}(x)$ is a solution to the equation.\n\n- Statement “The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation” is false. Since ${y}_{1}(x)$ is not a solution of the given differential equation, ${y}_{1}(x)$ and ${y}_{2}(x)$ don't form a set of fundamental solutions to the equation.\n\nTherefore, the correct answer is “${y}_{2}(x)={x}^{3}$ is a solution to the equation” only."} {:db/id #edb/ref 17592186432698 :knowledge-point/_questions [{:db/id #edb/ref 17592186172066 :knowledge-point/id #uuid "7e75041c-d0be-5db2-a0db-7c2c2b57b44e" :knowledge-point/title "Defining the Gamma Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef308e06-992f-56cb-a814-cd6e2eabff6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474230} {:answer/id #uuid "2b21cf5a-1e34-520e-9b32-cc50912a07a5"