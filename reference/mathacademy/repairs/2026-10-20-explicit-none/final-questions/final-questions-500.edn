db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474234} :answer-field/id #uuid "c352f108-be80-5fd3-9710-17251641c6d4" :answer-field/key "$3{\\int }_{1}^{\\infty }{t}^{3z-1}{e}^{-t}\\,\\text{d}t$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475043} {:answer-field/choices [{:answer/id #uuid "fb907ebb-191d-5907-90af-27b7d4477407" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668975} {:answer/id #uuid "1968be07-2c91-5316-b8bf-ea79cc91b0cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668976}] :answer-field/correct {:answer/id #uuid "fb907ebb-191d-5907-90af-27b7d4477407" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668975} :answer-field/id #uuid "c3e9be32-d1c4-599f-9cd8-a2493a575d10" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669287}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ef7933ca-459a-5897-8c5b-5b08b877b68b" :question/math-academy-id "q-107838" :question/problem "Which of the following integrals are equivalent to $Γ(z)$ for $\\text{Re}(z)>0?$\n\nSelect all that apply." :question/worked-solution "First, let's recall the definition of the gamma function:\n\n$$\nΓ(z)={\\int }_{0}^{\\infty }{t}^{z-1}{e}^{-t}\\,\\text{d}t,\\,\\text{Re}(z)>0.\n$$\n\nWith this definition in mind, let's consider each of the given integrals.\n\n- Integral $3{\\int }_{0}^{\\infty }\\frac{{t}^{3z-1}}{{e}^{{t}^{3}}}\\,\\text{d}t$ matches the definition. We use a substitution $s={t}^{3},$ then $3{t}^{2}\\,\\text{d}t=\\text{d}s.$ We get\n\n$$\n\\begin{aligned}3{\\int }_{0}^{\\infty }{t}^{3z-1}{e}^{-{t}^{3}}\\,\\text{d}t & =3{\\int }_{0}^{\\infty }{t}^{3(z-1)+2}{e}^{-{t}^{3}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{t}^{3(z-1)}{e}^{-{t}^{3}}(3{t}^{2})\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{s}^{z-1}{e}^{-s}\\,\\text{d}s=Γ(z).\\end{aligned}\n$$\n\n- Integral $3{\\int }_{0}^{\\infty }{t}^{3z-3}{e}^{-{t}^{3}}\\,\\text{d}t$ does *not* match the definition. The integrand ${t}^{3z-3}{e}^{-{t}^{3}}$ is not equivalent to that shown in the definition.\n\n- Integral $3{\\int }_{1}^{\\infty }{t}^{3z-1}{e}^{-t}\\,\\text{d}t$ does *not* match the definition. The lower bound of integration does not match that given in the definition.\n\nTherefore, the correct answer is $3{\\int }_{0}^{\\infty }\\frac{{t}^{3z-1}}{{e}^{{t}^{3}}}\\,\\text{d}t$ only."} {:db/id #edb/ref 17592186432785 :knowledge-point/_questions [{:db/id #edb/ref 17592186171933 :knowledge-point/id #uuid "b483f9f7-47a9-5725-b1f1-fe0ea39a7e96" :knowledge-point/title "Determining if a Number Is Divisible by 6"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b3a1c18-402a-5826-bf79-0dba558c64fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474332} {:answer/id #uuid "6c88f31b-1b8f-5242-b277-9bc33fcc1d53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474333}] :answer-field/correct {:answer/id #uuid "6c88f31b-1b8f-5242-b277-9bc33fcc1d53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474333} :answer-field/id #uuid "bc5edc77-177d-5283-b4ed-f6d29e6130f3" :answer-field/key "$185\\,346$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475092} {:answer-field/choices [{:answer/id #uuid "3717d0fa-e38b-5a2c-bc8b-96a33d55cf5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :