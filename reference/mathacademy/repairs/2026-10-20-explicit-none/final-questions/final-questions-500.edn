b/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474331}] :answer-field/correct {:answer/id #uuid "7f0d690b-a2af-51f1-908f-dcffce79cd11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474330} :answer-field/id #uuid "619d29e9-1652-56eb-a3ec-9f5d3d435236" :answer-field/key "$733\\,123$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475091} {:answer-field/choices [{:answer/id #uuid "ceedd337-fbde-579b-802e-f95f96ad25d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669045} {:answer/id #uuid "0b6cfaf6-3a2a-50d9-b7b9-f8fd34f824f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669046}] :answer-field/correct {:answer/id #uuid "0b6cfaf6-3a2a-50d9-b7b9-f8fd34f824f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669046} :answer-field/id #uuid "f7c525d3-55f2-5cd3-a7f9-b1269c6001ed" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669322}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e2757e05-6aab-58ae-aed8-77516507381e" :question/math-academy-id "q-132392" :question/problem "Which of the following numbers are divisible by $9?$\n\nSelect all that apply." :question/worked-solution "A number is divisible by $9$ if the sum of its digits is divisible by $9.$\n\n- The sum of the digits of $34\\,154\\,119$ is\n\n$$\n3+4+1+5+4+1+1+9=28,\n$$\n\nwhich is *not* divisible by $9.$ So, $34\\,154\\,119$ is *not* divisible by $9.$\n\n- The sum of the digits of $9\\,173\\,589$ is\n\n$$\n9+1+7+3+5+8+9=42,\n$$\n\nwhich is *not* divisible by $9.$ So, $9\\,173\\,589$ is *not* divisible by $9.$\n\n- The sum of the digits of $733\\,123$ is\n\n$$\n7+3+3+1+2+3=19,\n$$\n\nwhich is *not* divisible by $9.$ So, $733\\,123$ is *not* divisible by $9.$\n\nTherefore, the correct answer is \"None.\""} {:db/id #edb/ref 17592186433150 :knowledge-point/_questions [{:db/id #edb/ref 17592186133843 :knowledge-point/id #uuid "ee1838df-f1d6-5bc4-908c-b96e2ad577c9" :knowledge-point/title "Determining Whether Sets are Orthogonal"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6083824-86d5-51f3-b347-2895e58da839" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474816} {:answer/id #uuid "d6e8226e-0172-5d33-9eb5-ed8aacac25ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474817}] :answer-field/correct {:answer/id #uuid "e6083824-86d5-51f3-b347-2895e58da839" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474816} :answer-field/id #uuid "32a51cde-4bef-52b2-99da-b68e5b7cd2c8" :answer-field/key "$U=\\{\\begin{bmatrix}-2 \\\\ -1\\end{bmatrix},\\begin{bmatrix}3 \\\\ 2\\end{bmatrix},\\begin{bmatrix}15 \\\\ -20\\end{bmatrix}\\}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475334} {:answer-field/choices [{:answer/id #uuid "16e1ada7-48ac-55ea-abdc-58511cd98079" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474818} {:answer/id #uuid "937b8e9c-3d28-5737-8eed-9c803640fa7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474819}] :answer-field/correct {:answer/id #uuid "16e1ada7-48ac-55ea-abdc-58511cd98079" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474818} :answer-field/id #uuid "13bfc2a0-134b-5d27-9187-31d9b6d86aed" :answer-field/key "$V=\\{\\begin{bmatrix}0 \\\\ 5\\end{bmatrix},\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}\\}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475335} {:answer-field/choices [{:answer/id #uuid "04fb905e-e74d-5d79-b882-03aceed66713" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474820} {:answer/id #uuid "dcf0a431-8efe-5df5-ab12-1ca33c633645" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474821}] :answer-field/correct {:answer/id #uuid "04fb905e-e74d-5d79-b882-03aceed66713" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474820} :answer-field/id #uuid "ad31b141-6411-5cf5-a477-5373690eb045" :answer-field/key "$W=\\{\\begin{bmatrix}6 \\\\ 1 \\\\ -1\\end{bmatrix},\\begin{bmatrix}2 \\\\ 3 \\\\ 1\\end{bmatrix},\\begin{bmatrix}0 \\\\ -1 \\\\ 0\\end{bmatrix}\\}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475336} {:answer-field/choices [{:answer/id #uuid "ebc3de7c-b579-5bbf-aeea-55db25e493c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669191} {:answer/id #uuid "d065d1f0-99f9-53a3-9e72-0faf6c920ff1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669192}] :answer-field/correct {:answer/id #uuid "d065d1f0-99f9-53a3-9e72-0faf6c920ff1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669192} :answer-field/id #uuid "4983c225-f2a8-5e12-8e2c-5094b85a894b" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669395}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9cc85c8f-2fc1-51b5-90b3-b4c40aaa9ac5" :question/math-academy-id "q-40288" :question/problem "Which of the following sets are orthogonal?\n\nSelect all that apply." :question/worked-solution "Let's denote the vectors of the given sets as \n$\\{{u}_{1},{u}_{2},{u}_{3}\\},$ \n$\\{{v}_{1},{v}_{2}\\},$ and \n$\\{{w}_{1},{w}_{2},{w}_{3}\\},$ respectively. \n\nThe sets $U,V,$ and $W$ are orthogonal if the following conditions on each set hold:\n\n- ${u}_{1}\\cdot {u}_{2}=0,\\,{u}_{1}\\cdot {u}_{3}=0,\\,{u}_{2}\\cdot {u}_{3}=0.$\n\n- ${v}_{1}\\cdot {v}_{2}=0.$\n\n- ${w}_{1}\\cdot {w}_{2}=0,\\,{w}_{1}\\cdot {w}_{3}=0,\\,{w}_{2}\\cdot {w}_{3}=0.$\n\nWith that in mind, let's examine our sets in turn.\n\n- The set $U$ cannot be orthogonal since it contains  $3$ vectors from ${R}^{2}$ (in which we can have an orthogonal set with at most 2 non-zero vectors). Therefore, $U$ is not an orthogonal set.\n\n- For the set $V,$ notice that\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {v}_{2} & =\\begin{bmatrix}0 \\\\ 5\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 2\\end{bmatrix}=0+10=10\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthogonal set.\n\n- For the set $W,$ notice that \n\n$$\n\\begin{aligned}{w}_{1}\\cdot {w}_{2} & =\\begin{bmatrix}6 \\\\ 1 \\\\ -1\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ 3 \\\\ 1\\end{bmatrix}=12+3-1=14\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $W$ is not an orthogonal set.\n\nTherefore, we conclude that the correct answer is \"None of the listed\"."} {:db/id #edb/ref 17592186433173 :knowledge-point/_questions [{:db/id #edb/ref 17592186119925 :knowledge-point/id #uuid "52a45814-d1e2-5948-b7bd-69dcaf6cd0eb" :knowledge-point/title "Identifying Linearly Independent and Dependent Sets Using Row Reduction"}] :question/answer-fi