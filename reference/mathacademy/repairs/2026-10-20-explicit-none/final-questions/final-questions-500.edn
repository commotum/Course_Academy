ype/text} :answer/value "false" :db/id #edb/ref 17592186669047} :answer-field/id #uuid "3b6eaa77-18fb-5154-817a-328e59dce0db" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669323}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "245a9f1f-3fc0-594c-a273-205b94f4bf02" :question/math-academy-id "q-132405" :question/problem "Which of the following numbers are divisible by $6?$\n\nSelect all that apply." :question/worked-solution "A number is divisible by $6$ if it is divisible by both $2$ and $3.$\n\n- The number $185\\,346$ is divisible by $2,$ and it is also divisible by $3$ since the sum of its digits is divisible by $3:$\n\n$$\n1+8+5+3+4+6=27\n$$\n\nSo, $185\\,346$ is divisible by $6.$\n\n- The number $2\\,525\\,934$ is divisible by $2,$ and it is also divisible by $3$ since the sum of its digits is divisible by $3:$\n\n$$\n2+5+2+5+9+3+4=30\n$$\n\nSo, $2\\,525\\,934$ is divisible by $6.$\n\n- The number $15\\,070\\,962$ is divisible by $2,$ and it is also divisible by $3$ since the sum of its digits is divisible by $3:$\n\n$$\n1+5+0+7+0+9+6+2=30\n$$\n\nSo, $15\\,070\\,962$ is divisible by $6.$\n\nTherefore, the correct answer is $185\\,346$; $2\\,525\\,934$; $15\\,070\\,962$."} {:db/id #edb/ref 17592186432793 :knowledge-point/_questions [{:db/id #edb/ref 17592186171932 :knowledge-point/id #uuid "fb8fa39c-a982-569a-b2e0-833c51259711" :knowledge-point/title "Determining if a Number Is Divisible by 3 or 9"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1023f7e6-e59f-53cd-8a5f-2e42ef71c00f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474320} {:answer/id #uuid "2dc32817-8382-5025-99f0-ad2c0c830416" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 1