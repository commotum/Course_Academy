38b-7e3c-5e6e-944c-f8c28d16f24c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669107} :answer-field/id #uuid "da920b09-e93e-58a8-be07-cbf4dfd0a18d" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669353}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "23603376-708c-5de8-b4d0-019ec40ac31f" :question/math-academy-id "q-183340" :question/problem "$\\,$ **If** $-2\\in Z,$ **then** $5$ is prime.\n\nWhich of the following statements are equivalent to the conditional statement above?\n\nSelect all that apply." :question/worked-solution "Let's recall the following facts:\n\n- The contrapositive is logically equivalent to the original statement.\n\n- The inverse and the converse are logically equivalent to each other, but not to the original statement.\n\n![](images/0d/0deb19675402bf931111bb80cb616682aac08491b5cd3e1ab5812da05b6df8a8.png)\n\nSo, we are looking for the contrapositive of the given statement.\n\n- Statement “If $-2\\notin Z,$ then $5$ is not prime” is the inverse, not the contrapositive. $\\,\\times $\n\n- Statement “If $5$ is prime, then $-2\\in Z.$” is the converse, not the contrapositive. $\\,\\times $\n\n- Statement “If $5$ is not prime, then $-2\\notin Z.$” is the contrapositive. $\\,✓$\n\nTherefore, the correct answer is “If $5$ is not prime, then $-2\\notin Z.$” only."} {:db/id #edb/ref 17592186407811 :knowledge-point/_questions [{:db/id #edb/ref 17592186152081 :knowledge-point/id #uuid "114dedd9-ed3d-5d25-8616-030ea4bd84c9" :knowledge-point/title "Identifying True Statements Involving Universal Quantifiers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e67907b7-e5fc-55ed-b02e-f04b7649034e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472832} {:answer/id #uuid "9ac5139a-0ed3-5e4e-b49c-444e16cd16da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472833}] :answer-field/correct {:answer/id #uuid "e67907b7-e5fc-55ed-b02e-f04b7649034e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472832} :answer-field/id #uuid "49ca68e3-cdcb-5115-9df3-5c384f137d37" :answer-field/key "The truth set of $P(y)$ is $∅.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473811} {:answer-field/choices [{:answer/id #uuid "05e15c7d-6886-5d43-a1d4-a913c7e4a2ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472834} {:answer/id #uuid "d9d489d0-bbdf-56c9-87c9-a4dd8210ffdc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472835}] :answer-field/correct {:answer/id #uuid "d9d489d0-bbdf-56c9-87c9-a4dd8210ffdc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472835} :answer-field/id #uuid "3c5d54ab-2cf1-5535-92fe-67334161b71f" :answer-field/key "The truth set of $P(y)$ is ${Z}^{-}.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473812} {:answer-field/choices [{:answer/id #uuid "c5ae3570-9ffe-5221-809e-3dd6d305bbe2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472836} {:answer/id #uuid "b542d4a4-7ae3-596b-b54c-ae7b5ec35225" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472837}] :answer-field/correct {:answer/id #uuid "b542d4a4-7ae3-596b-b54c-ae7b5ec35225" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472837} :answer-field/id #uuid "5679e407-6097-5abf-95a3-0053125f2381" :answer-field/key "$∀y\\in {Z}^{-},\\,P(y).$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473813} {:answer-field/choices [{:answer/id #uuid "edfad5a6-8fca-5023-8919-73a4b608fbec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669119} {:answer/id #uuid "88f05b5a-218a-55c4-83d6-655f300fe3ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669120}] :answer-field/correct {:answer/id #uuid "edfad5a6-8fca-5023-8919-73a4b608fbec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669119} :answer-field/id #uuid "9583a5b5-e1e1-5c93-ad1d-b9670fa47881" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669359}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "25efa028-94e4-52c8-9fb8-df2dc5b08098" :question/math-academy-id "q-183509" :question/problem "$\\,$ $P(y):$ $y<y+1⇒{y}^{-1}\\in Q.$\n\nGiven that the above predicate is defined over the universal set ${Z}^{-},$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "The *universal quantification* of a predicate $P(x),$ defined over the universal set $U,$ transforms this predicate into a statement that we write as\n\n$$\n∀x\\in U,\\,P(x).\n$$\n\nThis statement is true if the predicate $P(x)$ is true on the entire universal set $U,$ i.e. if the truth set ${T}_{P}$ of the predicate coincides with the universal set $U:$\n\n$$\n{T}_{P}=U\n$$\n\nFirst, notice that:\n\n- the truth set of \"$y<y+1$\" is ${Z}^{-},$ and\n\n- the truth set of \"${y}^{-1}\\in Q$\" is ${Z}^{-}.$\n\nSince $A⇒B≡¬A∨B,$ the truth set of our predicate is \n\n$$\n{T}_{P}=\\overset{―}{{Z}^{-}}\\cup {Z}^{-}=∅\\cup {Z}^{-}={Z}^{-}.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement “The truth set of $P(y)$ is $∅.$” is false. The truth set is *not* empty.\n\n- Statement “The truth set of $P(y)$ is ${Z}^{-}.$” is true. Indeed, ${T}_{P}={Z}^{-}.$\n\n- Statement $∀y\\in {Z}^{-},\\,P(y).$ is true. Since ${T}_{P}$ coincides with the universal set, the statement $∀y\\in {Z}^{-},\\,P(y)$ is true.\n\nTherefore, the correct answer is “The truth set of $P(y)$ is ${Z}^{-}.$”; $∀y\\in {Z}^{-},\\,P(y).$ only."} {:db/id #edb/ref 17592186407812 :knowledge-point/_questions [{:db/id #edb/ref 17592186152081 :knowledge-point/id #uuid "114dedd9-ed3d-5d25-8616-030ea4bd84c9" :knowledge-point/title "Identifying True Statements Involving Universal Quantifiers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c12effc-0d2e-5f60-91b3-4b082defc75b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473010} {:answer/id #uuid "db6f8ca9-f659-5482-bfbc-ac3d14292808" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473011}] :answer-field/correct {:answer/id #uuid "0c12effc-0d2e-5f60-91b3-4b082defc75b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473010} :answer-field/id #uuid "ac2a7ba8-a7d5-51bb-9737-2fb9badb547c" :answer-field/key "The truth set of $P(m)$ is $∅.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473900} {:answer-field/choices [{:answer/id #uuid "fd0196f9-2a31-51aa-978b-076eb83f731a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473012} {:answer/id #uuid "6cefa553-9147-584d-b52d-ba0b6c919c8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473013}] :answer-field/correct {:answer/id #uuid "6cefa553-9147-584d-b52d-ba0b6c919c8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473013} :answer-field/id #uuid "f20bcb74-e9de-5e43-9dff-893367804923" :answer-field/key "The truth set of $P(m)$ is ${2k:k\\in Z}.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473901} {:answer-field/choices [{:answer/id #uuid "ace0e580-09a3-5a7c-ae03-3d96cd58410a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473014} {:answer/id #uuid "0554a362-f73e-52dd-acda-14d2788d4c29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473015}] :answer-field/correct {:answer/id #uuid "ace0e580-09a3-5a7c-ae03-3d96cd58410a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473014} :answer-field/id #uuid "a230043a-bfb8-5b6a-b5dc-5c9f0de766a1" :answer-field/key "$∀m\\in Z,\\,P(m).$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473902} {:answer-field/choices [{:answer/id #uuid "405c3dcd-4b6e-5286-af28-133dd7016e9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669145} {:answer/id #uuid "dff4d212-1027-5723-b642-efa2624acfc9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669146}] :answer-field/correct {:answer/id #uuid "405c3dcd-4b6e-5286-af28-133dd7016e9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669145} :answer-field/id #uuid "21923036-5891-5d45-96c3-186986c5a29a" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669372}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "303b12dc-4682-5eea-846a-0e1ea50fc6ae" :question/math-academy-id "q-216465" :question/problem "$\\,$ $P(m):$ $\\frac{m}{2}$ is an integer\n\nGiven that the above predicate is defined over the universal set $Z,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "The *universal quantification* of a predicate $P(x),$ defined over the universal set $U,$ transforms this predicate into a statement that we write as\n\n$$\n∀x\\in U,\\,P(x).\n$$\n\nThis statement is true if the predicate $P(x)$ is true on the entire universal set $U,$ i.e. if the truth set ${T}_{P}$ of the predicate coincides with the universal set $U:$\n\n$$\n{T}_{P}=U\n$$\n\nSince $\\frac{m}{2}$ is an integer if and only if $m$ is even, we have that the truth set of our predicate is ${T}_{P}={2k:k\\in Z}.$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement “The truth set of $P(m)$ is $∅.$” is false. The truth set is *not* empty.\n\n- Statement “The truth set of $P(m)$ is ${2k:k\\in Z}.$” is true. Indeed, ${T}_{P}={2k:k\\in Z}.$\n\n- Statement $∀m\\in Z,\\,P(m).$ is false. Since ${T}_{P}$ doesn't coincide with the universal set, the statement $∀m\\in Z,\\,P(m)$ is false.\n\nTherefore, the correct answer is “The truth set of $P(m)$ is ${2k:k\\in Z}.$” only."} {:db/id #edb/ref 17592186407815 :knowledge-point/_questions [{:db/id #edb/ref 17592186152083 :knowledge-point/id #uuid "320c4694-1904-5fc7-a324-a4c89f0e3257" :knowledge-point/title "Identifying True Statements Involving Existential Quantifiers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34b07de6-ecea-5b68-a5d9-e87a2a3ec45b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472838} {:answer/id #uuid "8ed51100-bbe2-55e1-8e9b-85999c3ab3a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472839}] :answer-field/correct {:answer/id #uuid "34b07de6-ecea-5b68-a5d9-e87a2a3ec45b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472838} :answer-field/id #uuid "60cf991e-baef-58cf-8f92-e59f983a0af0" :answer-field/key "The truth set of $P(n)$ is $∅.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473814} {:answer-field/choices [{:answer/id #uuid "e3cb4523-4231-5d71-bf66-75b9c85bda65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472840} {:answer/id #uuid "4c23c8a9-f972-515b-934f-3475849ad4b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472841}] :answer-field/correct {:answer/id #uuid "4c23c8a9-f972-515b-934f-3475849ad4b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472841} :answer-field/id #uuid "32b5e41e-2d16-51ee-b311-b285088e6473" :answer-field/key "The truth set of $P(n)$ is $N.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473815} {:answer-field/choices [{:answer/id #uuid "5e3b2f22-6930-528a-8709-74fb24f79384" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472842} {:answer/id #uuid "057da9f1-a7a7-55f3-89d1-becde4fe4af7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472843}] :answer-field/correct {:answer/id #uuid "057da9f1-a7a7-55f3-89d1-becde4fe4af7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472843} :answer-field/id #uuid "3382a728-8dac-58e5-b18b-2b9a83affe0c" :answer-field/key "$∃n\\in N,\\,P(n).$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473816} {:answer-field/choices [{:answer/id #uuid "c291cf5d-37fd-53c2-a943-e02076248e2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669125} {:answer/id #uuid "e60cd705-dcc6-52f2-a329-dd9575afd660" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669126}] :answer-field/correct {:answer/id #uuid "c291cf5d-37fd-53c2-a943-e02076248e2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669125} :answer-field/id #uuid "fe86c0f9-5bac-5171-be3f-8f7ce0d4efc0" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669362}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9ab7419f-dd45-5016-a048-0ef13ef60278" :question/math-academy-id "q-183552" :question/problem "$\\,$ $P(n):$ ${n}^{2}\\in N$ and $n+5>1$ \n\nGiven that the above predicate is defined over the universal set $N,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "The *existential quantification* of a predicate $P(x),$ defined over the universal set $U,$ transforms this predicate into a statement that we write as\n\n$$\n∃x\\in U,\\,P(x).\n$$\n\nThis statement is true if the predicate $P(x)$ is true for a single element $x\\in U,$ i.e. if the truth set ${T}_{P}$ of the predicate is not empty:\n\n$$\n{T}_{P}\\ne ∅\n$$\n\nFirst, notice that:\n\n- the truth set of \"${n}^{2}\\in N$\" is the set $N,$ and\n\n- the truth set of \"$n+5>1$\" is $N.$\n\nSo, the truth set of our predicate is\n\n$$\n{T}_{P}=N\\cap N=N.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement “The truth set of $P(n)$ is $∅.$” is false. The truth set is *not* empty.\n\n- Statement “The truth set of $P(n)$ is $N.$” is true. Indeed, ${T}_{P}=N.$\n\n- Statement $∃n\\in N,\\,P(n).$ is true. Since ${T}_{P}$ is *not* empty, the statement $∃n\\in N,\\,P(n)$ is true.\n\nTherefore, the correct answer is “The truth set of $P(n)$ is $N.$”; $∃n\\in N,\\,P(n).$ only."} {:db/id #edb/ref 17592186411117 :knowledge-point/_questions [{:db/id #edb/ref 17592186157231 :knowledge-point/id #uuid "bc5b8688-3838-5e9e-9304-9a4c787034ee" :knowledge-point/title "Identifying Logically Equivalent Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ff3ba28-38e8-51bc-a126-2eff2903bff1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472574} {:answer/id #uuid "2d8239a8-397c-5bf4-8f09-ac6412a0e0bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472575}] :answer-field/correct {:answer/id #uuid "2d8239a8-397c-5bf4-8f09-ac6412a0e0bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472575} :answer-field/id #uuid "1d4328ce-d94c-50ad-9bc6-66e180d0c379" :answer-field/key "$¬Q∧(P∨Q)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473682} {:answer-field/choices [{:answer/id #uuid "de4aeae3-2eea-55f8-9d3b-f6f28669d75a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472576} {:answer/id #uuid "ffb9487c-635d-5949-9980-a665c9ff96ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472577}] :answer-field/correct {:answer/id #uuid "ffb9487c-635d-5949-9980-a665c9ff96ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472577} :answer-field/id #uuid "21b67704-7d9c-5f26-8cd4-1364e0247ba7" :answer-field/key "$P∧¬Q$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473683} {:answer-field/choices [{:answer/id #uuid "428e1b82-e6da-5eab-9b6a-0c2af131b494" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472578} {:answer/id #uuid "d54291b6-7ef2-55e0-96fb-76e1195bcd41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472579}] :answer-field/correct {:answer/id #uuid "428e1b82-e6da-5eab-9b6a-0c2af131b494" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472578} :answer-field/id #uuid "fa69a530-25df-51d2-8915-d0fef8fbe9e6" :answer-field/key "$¬P∧¬Q$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473684} {:answer-field/choices [{:answer/id #uuid "64e469f4-0e1a-5ca9-9191-9a34c43891f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669017} {:answer/id #uuid "847409ca-ab5f-5a89-bbfe-8578a670a557" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669018}] :answer-field/correct {:answer/id #uuid "64e469f4-0e1a-5ca9-9191-9a34c43891f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669017} :answer-field/id #uuid "204ab4ef-2f92-5ea1-8fae-0bcaa83cb30a" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669308}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b8076c0f-174e-5d1d-bedf-553b0bcc1d94" :question/math-academy-id "q-127969" :question/problem "Which of the following statements are logically equivalent?\n\nSelect all that apply." :question/worked-solution "Two statements are logically equivalent if they have the same truth table. So, we construct a truth table for the three given statements:\n\n| $\\,P\\,$ | $\\,Q\\,$ | $\\,¬Q∧(P∨Q)\\,$ | $\\,P∧¬Q\\,$ | $\\,¬P∧¬Q\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{T}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |\n\nWe see that only the statements $¬Q∧(P∨Q)$ and $P∧¬Q$ have the same truth table, so they are logically equivalent.\n\nTherefore, the correct answer is $¬Q∧(P∨Q)$; $P∧¬Q$ only."} {:db/id #edb/ref 17592186411286 :knowledge-point/_questions [{:db/id #edb/ref 17592186105769 :knowledge-point/id #uuid "32467c2c-5605-50e9-b961-a29535a0effb" :knowledge-point/title "Identifying True Statements About Eigenvalues and Eigenvectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee9114a1-aa7f-5df3-814e-651d0530d5ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473326} {:answer/id #uuid "032cba6f-622b-5534-9122-a6d2e0064c5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473327}] :answer-field/correct {:answer/id #uuid "ee9114a1-aa7f-5df3-814e-651d0530d5ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473326} :answer-field/id #uuid "86c73323-d68f-52e7-bb08-f5a7c5c876ad" :answer-field/key "$v=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}-2 & -1 \\\\ 4 & 3\\end{bmatrix}$ that corresponds to the eigenvalue $\\lambda =1.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474058} {:answer-field/choices [{:answer/id #uuid "20ef3ca8-ce71-5b0e-9160-127af09d7f2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473328} {:answer/id #uuid "2b7e1916-223f-548d-9df4-0fcfee646ccd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473329}] :answer-field/correct {:answer/id #uuid "20ef3ca8-ce71-5b0e-9160-127af09d7f2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473328} :answer-field/id #uuid "55a5184c-a43a-5418-856c-b2919b5f0f7f" :answer-field/key "$v=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}1 & 5 \\\\ 4 & 0\\end{bmatrix}$ that corresponds to the eigenvalue $\\lambda =5.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474059} {:answer-field/choices [{:answer/id #uuid "7b23bec9-7f3a-5e08-adee-f648ba08bc5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473330} {:answer/id #uuid "c58c188c-bab8-504b-94fd-1ab2f97a5ab8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473331}] :answer-field/correct {:answer/id #uuid "c58c188c-bab8-504b-94fd-1ab2f97a5ab8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473331} :answer-field/id #uuid "3c1a60f6-a246-55e5-8725-fa3150b13681" :answer-field/key "If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $\\lambda =-3,$ then $2v$ is an eigenvector of $A$ corresponding to $\\lambda =-3.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474060} {:answer-field/choices [{:answer/id #uuid "0091c69a-0716-57cf-98d8-822bdef9c9be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669201} {:answer/id #uuid "e59c0295-862d-5743-bf80-99e6fc1db664" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669202}] :answer-field/correct {:answer/id #uuid "0091c69a-0716-57cf-98d8-822bdef9c9be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669201} :answer-field/id #uuid "203edee0-c8e7-5361-9f35-d382ce47e454" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669400}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0ddf6872-c9fc-59bb-a8a4-f3c287d11e0a" :question/math-academy-id "q-75724" :question/problem "Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ With that in mind, let's examine the statements one by one.\n\n- Statement “$v=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}-2 & -1 \\\\ 4 & 3\\end{bmatrix}$ that corresponds to the eigenvalue $\\lambda =1.$” is false. We have\n\n$$\n\\begin{aligned}Av & =\\begin{bmatrix}-2 & -1 \\\\ 4 & 3\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ -1\\end{bmatrix} \\\\  & =-1\\cdot \\begin{bmatrix}-1 \\\\ 1\\end{bmatrix} \\\\  & =-1v.\\end{aligned}\n$$\n\n \nSince $Av=v,$ we conclude that $v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =-1$ (but not $1$).\n\n- Statement “$v=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}1 & 5 \\\\ 4 & 0\\end{bmatrix}$ that corresponds to the eigenvalue $\\lambda =5.$” is false. We have\n\n$$\n\\begin{aligned}A{v}_{1} & =\\begin{bmatrix}1 & 5 \\\\ 4 & 0\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 \\\\ -4\\end{bmatrix} \\\\  & =-4\\cdot \\begin{bmatrix}-1 \\\\ 1\\end{bmatrix} \\\\  & =-4{v}_{1}.\\end{aligned}\n$$\n\n \nSince $Av=-4v,$ we conclude that $v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =-4$ (but not $5$).\n\n- Statement “If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $\\lambda =-3,$ then $2v$ is an eigenvector of $A$ corresponding to $\\lambda =-3.$” is true. We have\n\n$$\n\\begin{aligned}A(2v)=2Av=2(-3v)=-3(2v).\\end{aligned}\n$$\n\nSince, $A(2v)=-3(2v),$ and $2v\\ne 0,$ this implies that $2v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =-3.$\n\n**Note:** In general, any non-zero multiple of an eigenvector is again an eigenvector, and the corresponding eigenvalue is the same.\n\nTherefore, the correct answer is “If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $\\lambda =-3,$ then $2v$ is an eigenvector of $A$ corresponding to $\\lambda =-3.$” only."} {:db/id #edb/ref 17592186411410 :knowledge-point/_questions [{:db/id #edb/ref 17592186157237 :knowledge-point/id #uuid "8479a60b-b5db-5ad4-8100-fd2db8002091" :knowledge-point/title "Using the x R y Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81eac6d8-a430-574b-a73a-7693bdbf9561" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472886} {:answer/id #uuid "e86bb8e8-1da8-5c04-a45b-a4be5b0a9e58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472887}] :answer-field/correct {:answer/id #uuid "81eac6d8-a430-574b-a73a-7693bdbf9561" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472886} :answer-field/id #uuid "e8bc59ab-a020-5283-b995-4b3f01b96792" :answer-field/key "${0}\\,R\\,{0,1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473838} {:answer-field/choices [{:answer/id #uuid "5871897b-5bfc-587f-a860-d3f937f45f8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472888} {:answer/id #uuid "3d525756-0d92-5c9f-ad36-67c13bf7e9ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472889}] :answer-field/correct {:answer/id #uuid "5871897b-5bfc-587f-a860-d3f937f45f8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472888} :answer-field/id #uuid "a0415415-2a3d-5687-a51f-4a9cd8a2ce8f" :answer-field/key "${0,1}\\,R\\,{0,1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473839} {:answer-field/choices [{:answer/id #uuid "112fcfe9-f163-5402-bb4c-1c126bca51d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472890} {:answer/id #uuid "448edde1-a526-52c0-ba25-3145d1c46f49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472891}] :answer-field/correct {:answer/id #uuid "448edde1-a526-52c0-ba25-3145d1c46f49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472891} :answer-field/id #uuid "db9f241c-836d-5fde-9168-5d59cd8ab428" :answer-field/key "${0}\\,\\cancel{\\,R\\,}\\,{0}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473840} {:answer-field/choices [{:answer/id #uuid "9d536028-b91b-59ef-a2b4-75a3592fe8d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669137} {:answer/id #uuid "26c4f84b-1486-5105-926c-93a52fab7d9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669138}] :answer-field/correct {:answer/id #uuid "9d536028-b91b-59ef-a2b4-75a3592fe8d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669137} :answer-field/id #uuid "e2c3de4d-9b40-5037-b964-319c2330d1e1" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669368}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2006d399-9a69-519f-8bb4-45f612aefe6e" :question/math-academy-id "q-213141" :question/problem "Consider the following set:\n\n$$\nA={{0},{0,1}}\n$$\n\nGiven the relation $R$ on $A$ defined by\n\n$$\nX\\,R\\,Y\\,⇔\\,X⊃Y,\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A relation $R$ on a set $A$ is a subset of the Cartesian product $A\\times A={A}^{2}.$\n\n$$\nR⊂{A}^{2}\n$$\n\nWe also have the following notations:\n\n- $x\\,R\\,y$ if and only if $(x,y)\\in R$\n\n- $x\\,\\cancel{\\,R\\,}\\,y$ if and only if $(x,y)\\notin R$\n\nIn this case, we have $X\\,R\\,Y$ if and only if $X⊃Y.$ For this relation, note that\n\n- the symbols $R$ and $⊃$ are interchangeable, and\n\n- the symbols $\\cancel{\\,R\\,}$ and $⊅$ are also interchangeable.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement ${0}\\,R\\,{0,1}$ is false. Replacing $R$ with the symbol $⊃,$ we have ${0}⊃{0,1}.$ This is equivalent to ${0,1}⊂{0},$ which is false.\n\n- Statement ${0,1}\\,R\\,{0,1}$ is false. Replacing $R$ with the symbol $⊃,$ we have ${0,1}⊃{0,1}.$ This is equivalent to ${0,1}⊂{0,1},$ which is false.\n\n- Statement ${0}\\,\\cancel{\\,R\\,}\\,{0}$ is true. Replacing $\\cancel{\\,R\\,}$ with the symbol $⊅,$ we have ${0}⊅{0}.$ This is equivalent to ${0}⊄{0},$ which is true.\n\nTherefore, the correct answer is ${0}\\,\\cancel{\\,R\\,}\\,{0}$ only."} {:db/id #edb/ref 17592186411420 :knowledge-point/_questions [{:db/id #edb/ref 17592186157236 :knowledge-point/id #uuid "f77177ee-74b0-5681-92a8-ed6994ab9f9c" :knowledge-point/title "Identifying Elements of Standard Relations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "858d1b5f-5918-5ac9-99e7-cf79a2a46733" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472868} {:answer/id #uuid "2533356f-13ee-5d42-ad0e-d1a267e0303d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472869}] :answer-field/correct {:answer/id #uuid "858d1b5f-5918-5ac9-99e7-cf79a2a46733" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472868} :answer-field/id #uuid "89cfb84f-7bdd-58d3-bfb5-bb04de54defe" :answer-field/key "$({0},{1,0})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473829} {:answer-field/choices [{:answer/id #uuid "8e26b1ad-a11f-58c2-b68b-eb2904daa308" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472870} {:answer/id #uuid "904056bb-a15e-552e-9d05-d3e6998208bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472871}] :answer-field/correct {:answer/id #uuid "904056bb-a15e-552e-9d05-d3e6998208bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472871} :answer-field/id #uuid "876dfd72-f2f4-50c0-a2d6-2e6b60c3e021" :answer-field/key "$({1,0},{0})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473830} {:answer-field/choices [{:answer/id #uuid "989df4ea-589f-56da-b83c-762f6d608713" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472872} {:answer/id #uuid "7477b5ed-7893-5893-8195-ef07b8905aa8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472873}] :answer-field/correct {:answer/id #uuid "989df4ea-589f-56da-b83c-762f6d608713" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472872} :answer-field/id #uuid "3a92b2f8-77ee-5489-93de-bf8f95ddbcef" :answer-field/key "$({1,0},{1,0})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473831} {:answer-field/choices [{:answer/id #uuid "f04f0ddf-e668-5a6c-adc8-b048aa164f60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669135} {:answer/id #uuid "d8e345c3-852e-5dc7-bf78-48f3b523b36e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669136}] :answer-field/correct {:answer/id #uuid "f04f0ddf-e668-5a6c-adc8-b048aa164f60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669135} :answer-field/id #uuid "efb5fd5e-8f4c-5c14-b29f-329b3079c774" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669367}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bb1a702e-c18f-5fe7-b6f2-5f1506bc9396" :question/math-academy-id "q-213003" :question/problem "Consider the following set:\n\n$$\nA={{0},{1,0}}\n$$\n\nWhich of the following ordered pairs is an element of the relation \"is **not** a subset of\" on $A?$ \n\nSelect all that apply." :question/worked-solution "A relation $R$ on a set $A$ is a subset of the Cartesian product $A\\times A={A}^{2}.$\n\n$$\nR⊆{A}^{2}\n$$\n\nIn this case, $R$ is the set of ordered pairs $(x,y)\\in {A}^{2}$ such that $x⊈y.$\n\nWith that in mind, let's examine our ordered pairs in turn.\n\n- The ordered pair $({0},{1,0})$ is **not** an element of $R$ since ${0}⊆{1,0}.\\,\\times $\n\n- The ordered pair $({1,0},{0})$ is an element of $R$ since ${1,0}⊈{0}.\\,✓$\n\n- The ordered pair $({1,0},{1,0})$ is **not** an element of $R$ since ${1,0}⊆{1,0}.\\,\\times $\n\nTherefore, the correct answer is $({1,0},{0})$ only."} {:db/id #edb/ref 17592186411616 :knowledge-point/_questions [{:db/id #edb/ref 17592186124615 :knowledge-point/id #uuid "f4f2f4f4-af4a-597d-b6c6-afb82e708fc2" :knowledge-point/title "Identifying Steady-State Vectors of Stochastic Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16370931-5fc9-5536-9fd7-45afe61a10b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472688} {:answer/id #uuid "8ab6d543-ae19-5030-b18a-58051110b60a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472689}] :answer-field/correct {:answer/id #uuid "8ab6d543-ae19-5030-b18a-58051110b60a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472689} :answer-field/id #uuid "9b4b12e7-31db-52dd-a206-759d60508923" :answer-field/key "$q$ is a stochastic vector" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473739} {:answer-field/choices [{:answer/id #uuid "71dd4b86-fcee-58b2-a783-19a83e01d1dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472690} {:answer/id #uuid "3f7a9115-7513-51f1-a218-6359bc259d69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472691}] :answer-field/correct {:answer/id #uuid "71dd4b86-fcee-58b2-a783-19a83e01d1dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472690} :answer-field/id #uuid "2dc16e75-61f9-56a2-8f15-331022147565" :answer-field/key "$Pq=q$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473740} {:answer-field/choices [{:answer/id #uuid "3605e075-25c5-54da-bf16-7e2307304916" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472692} {:answer/id #uuid "9db4a1e3-8985-5443-8d1e-4853b29ea3d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472693}] :answer-field/correct {:answer/id #uuid "3605e075-25c5-54da-bf16-7e2307304916" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472692} :answer-field/id #uuid "cb71628d-05cf-5ce1-8a2b-c44a3882f058" :answer-field/key "$q$ is a steady-state vector of $P$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473741} {:answer-field/choices [{:answer/id #uuid "c74608bc-104c-523a-b841-4103682ce36e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669049} {:answer/id #uuid "7cf20cac-ceeb-553c-b0a7-de77d47fceeb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669050}] :answer-field/correct {:answer/id #uuid "c74608bc-104c-523a-b841-4103682ce36e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669049} :answer-field/id #uuid "afc00842-2c9e-5a05-8a7c-01e9dfffb033" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669324}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "62944003-1237-5928-b405-2159dbe448f0" :question/math-academy-id "q-135308" :question/problem "$$\nP=\\begin{bmatrix}0.3 & 0.8 \\\\ 0.7 & 0.2\\end{bmatrix},\\,q=\\begin{bmatrix}0.1 \\\\ 0.9\\end{bmatrix}\n$$\n\nConsider the stochastic matrix $P$ and vector $q$ shown above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that a steady-state vector of a stochastic matrix $P$ is a stochastic vector $q$ such that $Pq=q.$\n\nWith that in mind, let's examine our statements.\n\n- Statement “$q$ is a stochastic vector” is true. Indeed, $q$ is a stochastic vector since its entries are non-negative and add up to $1.$\n\n- Statement $Pq=q$ is false. Note that\n\n$$\nPq=\\begin{bmatrix}0.3 & 0.8 \\\\ 0.7 & 0.2\\end{bmatrix}\\begin{bmatrix}0.1 \\\\ 0.9\\end{bmatrix}=\\begin{bmatrix}0.03+0.72 \\\\ 0.07+0.18\\end{bmatrix}=\\begin{bmatrix}0.75 \\\\ 0.25\\end{bmatrix}\\ne q.\n$$\n\n- Statement “$q$ is a steady-state vector of $P$” is false. Since $Pq\\ne q,$ it is not a steady-state vector of $P.$\n\nTherefore, the correct answer is “$q$ is a stochastic vector” only."} {:db/id #edb/ref 17592186411865 :knowledge-point/_questions [{:db/id #edb/ref 17592186198449 :knowledge-point/id #uuid "b4a5d6b1-e76a-5b33-8973-04d1d9062dc6" :knowledge-point/title "Identifying the Orthogonality of a Two-Vector Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f8e2907-6f9f-5945-87a4-4b320b3c5c7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472784} {:answer/id #uuid "363acb19-a7c4-58f9-889f-e407b2331d8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472785}] :answer-field/correct {:answer/id #uuid "1f8e2907-6f9f-5945-87a4-4b320b3c5c7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472784} :answer-field/id #uuid "51607494-5a75-5d4c-92f2-cb8a34490a90" :answer-field/key "${u}_{1}\\cdot {u}_{3}=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473787} {:answer-field/choices [{:answer/id #uuid "30463986-efbd-51fd-a6e9-b681bf1c31ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472786} {:answer/id #uuid "7e0850f2-9a46-5214-af3b-d2ee5b9d05f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472787}] :answer-field/correct {:answer/id #uuid "30463986-efbd-51fd-a6e9-b681bf1c31ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472786} :answer-field/id #uuid "576b8513-a337-57bb-a0b8-42a8d11e9c97" :answer-field/key "$\\{Q({u}_{1}),Q({u}_{2}),Q({u}_{3})\\}$ is orthogonal" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473788} {:answer-field/choices [{:answer/id #uuid "2da457c8-29f9-53a4-9a7b-82bd8117f5ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472788} {:answer/id #uuid "9252ae02-4d55-5e0b-ab06-d7222907f63c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472789}] :answer-field/correct {:answer/id #uuid "2da457c8-29f9-53a4-9a7b-82bd8117f5ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472788} :answer-field/id #uuid "b8436333-b398-5406-b728-7406ac2b71f3" :answer-field/key "$\\{Q({u}_{1}),Q({u}_{2}),Q({u}_{3})\\}$ is orthonormal" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473789} {:answer-field/choices [{:answer/id #uuid "12aa7dee-6930-51a9-9005-531050cbac3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669103} {:answer/id #uuid "8e625597-4c6d-54c4-8c47-5e959e233f94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669104}] :answer-field/correct {:answer/id #uuid "8e625597-4c6d-54c4-8c47-5e959e233f94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669104} :answer-field/id #uuid "4e6867e9-cec3-5d9e-8877-806350a4cff1" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669351}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8d807e12-6960-57f6-b74d-aa3fe66f0f76" :question/math-academy-id "q-178271" :question/problem "$$\n{u}_{1}=\\begin{bmatrix}3 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{u}_{2}=\\begin{bmatrix}1 \\\\ 1 \\\\ -3\\end{bmatrix},\\,{u}_{3}=\\begin{bmatrix}1 \\\\ -3 \\\\ 0\\end{bmatrix}\n$$\n\nConsider the vectors above, and let $Q$ be an orthogonal linear transformation. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nWith that in mind, let's examine our statements.\n\n- Statement ${u}_{1}\\cdot {u}_{3}=0$ is false since\n\n$$\n{u}_{1}\\cdot {u}_{3}=\\begin{bmatrix}3 \\\\ 0 \\\\ 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ -3 \\\\ 0\\end{bmatrix}=3\\ne 0.\n$$\n\n- Statement “$\\{Q({u}_{1}),Q({u}_{2}),Q({u}_{3})\\}$ is orthogonal” is false. Notice that, for example, $Q({u}_{1})⊥̸Q({u}_{3})$ since\n\n$$\nQ({u}_{1})\\cdot Q({u}_{3})={u}_{1}\\cdot {u}_{3}\\ne 0.\n$$\n\n- Statement “$\\{Q({u}_{1}),Q({u}_{2}),Q({u}_{3})\\}$ is orthonormal” is false since the set is not even orthogonal.\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186412805 :knowledge-point/_questions [{:db/id #edb/ref 17592186166899 :knowledge-point/id #uuid "95de2c3e-5810-5aa0-a1d0-b98b012572d4" :knowledge-point/title "Applying the Linearity Principle to the Solutions of a Homogeneous System of ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c1c0b90-23e9-5b83-a708-3ea2a44a1581" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473040} {:answer/id #uuid "d96841dd-b0ce-57d2-8366-ed50689beb53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473041}] :answer-field/correct {:answer/id #uuid "2c1c0b90-23e9-5b83-a708-3ea2a44a1581" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473040} :answer-field/id #uuid "334c6ac2-2b02-5e0f-a88a-b19789c7086c" :answer-field/key "$x(t)={x}_{1}(t)\\times {x}_{2}(t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473915} {:answer-field/choices [{:answer/id #uuid "43066d0d-a047-5a30-8822-f5d690da8c86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473042} {:answer/id #uuid "12848657-20bc-5e4e-8323-c54bfc0aa80a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473043}] :answer-field/correct {:answer/id #uuid "43066d0d-a047-5a30-8822-f5d690da8c86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473042} :answer-field/id #uuid "34af04fe-4273-5909-afb6-13e9d8b36c79" :answer-field/key "$x(t)=\\operatorname{sin}⁡(t)\\cdot {x}_{2}(t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473916} {:answer-field/choices [{:answer/id #uuid "216b9e19-7285-56cb-8603-99b3f8d13d7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473044} {:answer/id #uuid "a0db2386-3a66-5f9c-a3fd-5640d25f6a54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473045}] :answer-field/correct {:answer/id #uuid "a0db2386-3a66-5f9c-a3fd-5640d25f6a54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473045} :answer-field/id #uuid "381905b6-4e83-545a-8560-cb908ea74f55" :answer-field/key "$x(t)=-3\\cdot {x}_{2}(t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473917} {:answer-field/choices [{:answer/id #uuid "110307fa-28b8-52a6-847a-a72ca32bc5d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669151} {:answer/id #uuid "8b4680a7-5fc5-55bc-9b7a-010619a93e05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669152}] :answer-field/correct {:answer/id #uuid "110307fa-28b8-52a6-847a-a72ca32bc5d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669151} :answer-field/id #uuid "e6c98528-8d8f-5ac7-85de-2c0f2b8ced16" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669375}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "71a6807f-51a3-5e94-a65a-0087aa5dc119" :question/math-academy-id "q-330333" :question/problem "Suppose ${x}_{1}(t)$ and ${x}_{2}(t)$ are both solutions of the homogeneous system\n${x}^{′}(t)=A\\text{ }x(t).$\nWhich of the following is **always** a solution of the same system?\n\nSelect all that apply." :question/worked-solution "The *linearity principle* for systems of linear ordinary differential equations (ODEs) states that if ${x}_{1}(t)$ and ${x}_{2}(t)$ are solutions to a homogeneous linear system, then for any constants ${c}_{1}$ and ${c}_{2},$ the linear combination \n\n$$\n{c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t)\n$$\n\nis also a solution of the system. \n\nWith that in mind, let's examine the given expressions.\n\n- Option $x(t)={x}_{1}(t)\\times {x}_{2}(t)$ might be *not* a solution to the system since it's not a scalar multiple of any of the solutions ${x}_{1}(t)$ and ${x}_{2}(t).$\n\n- Option $x(t)=\\operatorname{sin}⁡(t)\\cdot {x}_{2}(t)$ might be *not* a solution to the system since it's not a scalar multiple of any of the solutions ${x}_{1}(t)$ and ${x}_{2}(t).$ Notice that the multiplier is not a constant.\n\n- Option $x(t)=-3\\cdot {x}_{2}(t)$ is a solution to the system. Indeed, notice that\n\n$$\n-3\\cdot {x}_{2}(t)\n$$\n\nis a linear combination of the solutions ${x}_{1}(t)$ and ${x}_{2}(t)$ with constant multiplies ${c}_{1}=0$ and ${c}_{2}=-3,$ respectively.\n\nTherefore, the correct answer is $x(t)=-3\\cdot {x}_{2}(t)$ only."} {:db/id #edb/ref 17592186412806 :knowledge-point/_questions [{:db/id #edb/ref 17592186166899 :knowledge-point/id #uuid "95de2c3e-5810-5aa0-a1d0-b98b012572d4" :knowledge-point/title "Applying the Linearity Principle to the Solutions of a Homogeneous System of ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b89ff11c-d1b7-5405-82c1-94c7d7c99ea8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473046} {:answer/id #uuid "c81e64dc-937e-5cab-8f29-f5b6154dc03a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473047}] :answer-field/correct {:answer/id #uuid "c81e64dc-937e-5cab-8f29-f5b6154dc03a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473047} :answer-field/id #uuid "c191f663-afad-5fac-a9f2-fac3b31f3803" :answer-field/key "$x(t)={x}_{1}(t)+{x}_{2}(t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473918} {:answer-field/choices [{:answer/id #uuid "e9185fe4-0729-55cd-91d0-1540bf55d2e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473048} {:answer/id #uuid "44919b96-98f2-5972-8f19-8568c044e939" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473049}] :answer-field/correct {:answer/id #uuid "e9185fe4-0729-55cd-91d0-1540bf55d2e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473048} :answer-field/id #uuid "4eb579d0-ff0e-56d8-afd8-faecf8a98e18" :answer-field/key "$x(t)$ $=\\operatorname{sin}⁡(t)\\cdot {x}_{1}(t)$ $-\\operatorname{cos}⁡(t)\\cdot {x}_{2}(t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473919} {:answer-field/choices [{:answer/id #uuid "498d2ce6-8636-51d1-aabe-214949bb04ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473050} {:answer/id #uuid "4038ba31-96d0-5ea2-80fe-ff8ad8b3e1b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473051}] :answer-field/correct {:answer/id #uuid "4038ba31-96d0-5ea2-80fe-ff8ad8b3e1b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473051} :answer-field/id #uuid "a207e67d-e805-59c2-970d-7203de37688e" :answer-field/key "$x(t)={x}_{1}(t)-{x}_{2}(t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473920} {:answer-field/choices [{:answer/id #uuid "c0cbe241-f4aa-5efa-ab7f-3a494833c756" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669153} {:answer/id #uuid "e1f48b5c-ec18-5799-9fa6-d8dad5563032" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669154}] :answer-field/correct {:answer/id #uuid "c0cbe241-f4aa-5efa-ab7f-3a494833c756" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669153} :answer-field/id #uuid "f6ac0587-5222-5094-b131-7987c099f0d1" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669376}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e5a0af42-71ea-5bb3-8eb8-b8b29ef8a2c6" :question/math-academy-id "q-330354" :question/problem "Suppose ${x}_{1}(t)$ and ${x}_{2}(t)$ are both solutions of the homogeneous system\n${x}^{′}(t)=A\\text{ }x(t).$\nWhich of the following is **always** a solution of the same system?\n\nSelect all that apply." :question/worked-solution "The *linearity principle* for systems of linear ordinary differential equations (ODEs) states that if ${x}_{1}(t)$ and ${x}_{2}(t)$ are solutions to a homogeneous linear system, then for any constants ${c}_{1}$ and ${c}_{2},$ the linear combination \n\n$$\n{c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t)\n$$\n\nis also a solution of the system. \n\nWith that in mind, let's examine the given expressions.\n\n- Option $x(t)={x}_{1}(t)+{x}_{2}(t)$ is a solution to the system. Indeed, notice that\n\n$$\n{x}_{1}(t)+{x}_{2}(t)\n$$\n\nis a linear combination of the solutions with constant multiplies ${c}_{1}=1$ and ${c}_{2}=1,$ respectively.\n\n- Option $x(t)$ $=\\operatorname{sin}⁡(t)\\cdot {x}_{1}(t)$ $-\\operatorname{cos}⁡(t)\\cdot {x}_{2}(t)$ might be *not* a solution to the system since it's not a linear combination of the solutions ${x}_{1}(t)$ and ${x}_{2}(t).$ Notice that the multipliers of the first and the second terms are not constant.\n\n- Option $x(t)={x}_{1}(t)-{x}_{2}(t)$ is a solution to the system. Indeed, notice that\n\n$$\n{x}_{1}(t)-{x}_{2}(t)\n$$\n\nis a linear combination of the solutions with constant multiplies ${c}_{1}=1$ and ${c}_{2}=-1,$ respectively.\n\nTherefore, the correct answer is $x(t)={x}_{1}(t)+{x}_{2}(t)$; $x(t)={x}_{1}(t)-{x}_{2}(t)$ only."} {:db/id #edb/ref 17592186412999 :knowledge-point/_questions [{:db/id #edb/ref 17592186152224 :knowledge-point/id #uuid "a0abad78-e492-5d09-a04d-bce54605c78c" :knowledge-point/title "Identifying Generalized Eigenvectors of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "787f9f37-580f-5658-9df9-ce826b611451" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472496} {:answer/id #uuid "c4403496-69e1-5d08-b02d-1b03668dd8c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472497}] :answer-field/correct {:answer/id #uuid "787f9f37-580f-5658-9df9-ce826b611451" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472496} :answer-field/id #uuid "0f1a3fb6-945f-5879-9865-fdc5a922c3f4" :answer-field/key "$v$ is an eigenvector corresponding to the eigenvalue $\\lambda =2$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473643} {:answer-field/choices [{:answer/id #uuid "7460c1a4-dd63-595d-8732-ee34d9a2c09a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472498} {:answer/id #uuid "71f5c96a-5c5b-5605-9ce0-b480c9528139" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472499}] :answer-field/correct {:answer/id #uuid "7460c1a4-dd63-595d-8732-ee34d9a2c09a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472498} :answer-field/id #uuid "a767f879-2f51-5809-aebb-daff65b44383" :answer-field/key "$v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =2$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473644} {:answer-field/choices [{:answer/id #uuid "2a97ed2f-d3d1-546a-874d-42ae2f24fc40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472500} {:answer/id #uuid "be2ff147-060f-5c7b-81e0-38256805dec8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472501}] :answer-field/correct {:answer/id #uuid "be2ff147-060f-5c7b-81e0-38256805dec8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472501} :answer-field/id #uuid "b3046741-713a-58b0-a1a8-53bf395bbfbb" :answer-field/key "$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =2$ of $A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473645} {:answer-field/choices [{:answer/id #uuid "417c497d-c468-5112-b9ee-f86175c93173" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668983} {:answer/id #uuid "9479db40-eacb-50de-9937-a714d2708b7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668984}] :answer-field/correct {:answer/id #uuid "417c497d-c468-5112-b9ee-f86175c93173" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668983} :answer-field/id #uuid "d433c441-a61a-50e6-8aaa-9e46552e7836" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669291}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5e5966d3-ce4d-5835-ab91-1f478e587602" :question/math-academy-id "q-109510" :question/problem "$$\nA=\\begin{bmatrix}1 & -1 \\\\ 1 & 3\\end{bmatrix},\\,v=\\begin{bmatrix}1 \\\\ 4\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A-2I:$\n\n$$\nA-2I=\\begin{bmatrix}1 & -1 \\\\ 1 & 3\\end{bmatrix}-2\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-1 & -1 \\\\ 1 & 1\\end{bmatrix}\n$$\n\n- Next, we find the image of $v$ under the action of $A-2I:$\n\n$$\n(A-2I)v=\\begin{bmatrix}-1 & -1 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}1 \\\\ 4\\end{bmatrix}=\\underbrace{\\begin{bmatrix}-5 \\\\ 5\\end{bmatrix}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A-2I:$\n\n$$\n(A-2I)w=\\begin{bmatrix}-1 & -1 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}-5 \\\\ 5\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n\\underbrace{\\begin{bmatrix}1 \\\\ 4\\end{bmatrix}}_{v}\\overset{\\,A-2I\\,\\,}{\\to }\\underbrace{\\begin{bmatrix}-5 \\\\ 5\\end{bmatrix}}_{w}\\overset{\\,A-2I\\,\\,}{\\to }\\underbrace{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{0}\n$$\n\nHere, we see that $A-2I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =2$ of $A.$*\n\nSo, the correct answer is “$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =2$ of $A$” only."} {:db/id #edb/ref 17592186413343 :knowledge-point/_questions [{:db/id #edb/ref 17592186157397 :knowledge-point/id #uuid "3a247336-9bc8-5799-9956-e3de188ce2d2" :knowledge-point/title "Identifying Integrals That Evaluate to Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5901841-e8c8-5cbf-a277-7f5d6bd154ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472508} {:answer/id #uuid "89815d70-f7a8-5a3d-8dc6-edd3a9b414b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472509}] :answer-field/correct {:answer/id #uuid "b5901841-e8c8-5cbf-a277-7f5d6bd154ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472508} :answer-field/id #uuid "8ad307b8-c32d-51ae-9cc5-239fd502f244" :answer-field/key "${\\int }_{-1}^{1}{e}^{2x}\\,\\text{d}x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473649} {:answer-field/choices [{:answer/id #uuid "675b79aa-0b55-56b0-b75a-127b830e9a0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472510} {:answer/id #uuid "a52bb3cf-32df-58c4-893f-1fc229df6b15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472511}] :answer-field/correct {:answer/id #uuid "675b79aa-0b55-56b0-b75a-127b830e9a0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472510} :answer-field/id #uuid "2847c887-d4df-5a65-acf5-493a754fad3e" :answer-field/key "${\\int }_{0}^{\\pi }\\sqrt[3]{x}\\operatorname{cos}⁡x\\,\\text{d}x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473650} {:answer-field/choices [{:answer/id #uuid "ef07f37d-ed46-50c3-8961-01e5ac788b9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472512} {:answer/id #uuid "33cab82b-32ec-5fa0-9569-1db28a6ff758" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472513}] :answer-field/correct {:answer/id #uuid "33cab82b-32ec-5fa0-9569-1db28a6ff758" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472513} :answer-field/id #uuid "e2e79f4d-084b-5b53-8f38-886deae491b2" :answer-field/key "${\\int }_{-4}^{4}x{e}^{{x}^{2}}\\,\\text{d}x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473651} {:answer-field/choices [{:answer/id #uuid "80241764-e36f-520d-be50-5761afda7037" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668993} {:answer/id #uuid "d88a9549-3796-5476-851e-1072b17998a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668994}] :answer-field/correct {:answer/id #uuid "80241764-e36f-520d-be50-5761afda7037" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668993} :answer-field/id #uuid "bb4f3cc5-7320-5433-92c3-a03b82854068" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669296}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "93763c90-6504-59a6-ad5e-8ed17cc5ac6d" :question/math-academy-id "q-115272" :question/problem "Which of the following integrals evaluates to zero due to symmetry?\n\nSelect all that apply." :question/worked-solution "Recall the following:\n\n- a function $f(x)$ is *even* if $f(-x)=f(x)$\n\n- a function $f(x)$ is *odd* if $f(-x)=-f(x)$\n\nMoreover, for any odd function $f(x),$ the graph of $y=f(x)$ has rotational symmetry of order $2$ about the origin, so we have\n\n$$\n{\\int }_{-a}^{a}f(x)\\,\\text{d}x=0.\n$$\n\nSo, to determine which integrals evaluate to $0$ due to symmetry, we have to determine which integrands are odd functions.\n\n- The function $f(x)={e}^{2x}$ is *not* an odd function:\n\n$$\n\\begin{aligned}f(-x) & ={e}^{2(-x)} \\\\  & ={e}^{-2x} \\\\  & \\ne -f(x)\\,\\times \\end{aligned}\n$$\n\n- The function $g(x)=\\sqrt[3]{x}\\operatorname{cos}⁡x$ is an odd function, but integral ${\\int }_{0}^{\\pi }\\sqrt[3]{x}\\operatorname{cos}⁡x\\,\\text{d}x$ is not of the form ${\\int }_{-a}^{a}g(x)\\,\\text{d}x$ since the upper and lower limits are not opposites. Therefore, we cannot use symmetry to simplify the integral.\n\n- The function $h(x)=x{e}^{{x}^{2}}$ is an odd function:\n\n$$\n\\begin{aligned}h(-x) & =(-x){e}^{(-x)^{2}} \\\\  & =-x{e}^{{x}^{2}} \\\\  & =-h(x)\\,✓\\end{aligned}\n$$\n\nTherefore, by symmetry, we can conclude that\n\n$$\n{\\int }_{-4}^{4}x{e}^{{x}^{2}}\\,\\text{d}x=0.\n$$\n\nTherefore, the correct answer is ${\\int }_{-4}^{4}x{e}^{{x}^{2}}\\,\\text{d}x$ only."} {:db/id #edb/ref 17592186413605 :knowledge-point/_questions [{:db/id #edb/ref 17592186166896 :knowledge-point/id #uuid "276898e7-57a4-5ca6-8df7-99fd318a2702" :knowledge-point/title "Identifying a Decoupled System of Linear ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ac55073-69fa-5d04-beb1-b62f89911c8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473052} {:answer/id #uuid "474df447-a674-59d3-8567-60b8dfff4e16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473053}] :answer-field/correct {:answer/id #uuid "9ac55073-69fa-5d04-beb1-b62f89911c8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473052} :answer-field/id #uuid "52e96549-c627-5583-a9fb-cf1da90d12c3" :answer-field/key "$\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=4{x}_{1}(t)+5{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=-{x}_{1}(t)+2{x}_{2}(t)\\end{aligned}\\right.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473921} {:answer-field/choices [{:answer/id #uuid "bd70a287-a637-5426-81c9-78d3016dd9e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473054} {:answer/id #uuid "caf9bc9c-885d-592e-b0ad-f4214345b3a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473055}] :answer-field/correct {:answer/id #uuid "bd70a287-a637-5426-81c9-78d3016dd9e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473054} :answer-field/id #uuid "d01f4732-ff58-597f-8c0f-c64f05d02e95" :answer-field/key "$\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=-2{x}_{1}(t)+3{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &={x}_{1}(t)-{x}_{2}(t)\\end{aligned}\\right.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473922} {:answer-field/choices [{:answer/id #uuid "f1b720fa-eff2-5721-8737-d3949780bca3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473056} {:answer/id #uuid "07107876-6eb0-508b-a5c8-b915a1c3f6e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473057}] :answer-field/correct {:answer/id #uuid "07107876-6eb0-508b-a5c8-b915a1c3f6e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473057} :answer-field/id #uuid "e3487039-0ced-5468-aee8-6fe1bf8ee226" :answer-field/key "$\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=-7{x}_{1}(t) \\\\ {x}_{2}^{′}(t) &=9{x}_{2}(t)\\end{aligned}\\right.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473923} {:answer-field/choices [{:answer/id #uuid "c20a2a54-410e-514d-8dea-bdbeaf31b117" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669155} {:answer/id #uuid "1d9de99c-6dba-5e44-ba37-f89f4eaf1488" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669156}] :answer-field/correct {:answer/id #uuid "c20a2a54-410e-514d-8dea-bdbeaf31b117" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669155} :answer-field/id #uuid "75690008-4111-5f1c-9a89-58943392f73e" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669377}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "96f65a49-2a61-5981-a404-aa212d4de13c" :question/math-academy-id "q-331097" :question/problem "Which of the following systems of linear ODEs are decoupled?\n\nSelect all that apply." :question/worked-solution "A *decoupled system* consists of equations depending on only one variable, such as\n\n$$\n{x}_{i}^{′}(t)={\\lambda }_{i}{x}_{i}(t),\n$$\n\nwhere ${\\lambda }_{i}$ is a constant. This means that we can solve each equation independently. \n\nWith this in mind, let's examine our systems.\n\n- System $\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=4{x}_{1}(t)+5{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=-{x}_{1}(t)+2{x}_{2}(t)\\end{aligned}\\right.$ is *not* decoupled because some of its equations depend on more than one variable. For example, ${x}_{1}^{′}(t)=4{x}_{1}(t)+5{x}_{2}(t)$ depends on ${x}_{1}(t)$ and ${x}_{2}(t).$\n\n- System $\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=-2{x}_{1}(t)+3{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &={x}_{1}(t)-{x}_{2}(t)\\end{aligned}\\right.$ is *not* decoupled because some of its equations depend on more than one variable. For example, ${x}_{2}^{′}(t)={x}_{1}(t)-{x}_{2}(t)$ depends on ${x}_{2}(t)$ and ${x}_{1}(t).$\n\n- System $\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=-7{x}_{1}(t) \\\\ {x}_{2}^{′}(t) &=9{x}_{2}(t)\\end{aligned}\\right.$ is decoupled since its equations depend on only one variable each. Indeed, ${x}_{1}^{′}(t)=-7{x}_{1}(t)$ depends on only ${x}_{1}(t)$ and ${x}_{2}^{′}(t)=9{x}_{2}(t)$ depends on only ${x}_{2}(t).$\n\nTherefore, the correct answer is $\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=-7{x}_{1}(t) \\\\ {x}_{2}^{′}(t) &=9{x}_{2}(t)\\end{aligned}\\right.$ only."} {:db/id #edb/ref 17592186415156 :knowledge-point/_questions [{:db/id #edb/ref 17592186198449 :knowledge-point/id #uuid "b4a5d6b1-e76a-5b33-8973-04d1d9062dc6" :knowledge-point/title "Identifying the Orthogonality of a Two-Vector Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81d08864-6101-5251-8351-5c0043998d07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472778} {:answer/id #uuid "1a22dbe5-0d2b-5c0a-9531-8c54bafdc81e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472779}] :answer-field/correct {:answer/id #uuid "1a22dbe5-0d2b-5c0a-9531-8c54bafdc81e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472779} :answer-field/id #uuid "71e4259d-b2ae-5c52-927d-7cf47899f776" :answer-field/key "${u}_{1}\\cdot {u}_{2}=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473784} {:answer-field/choices [{:answer/id #uuid "c84ccb50-f1be-591e-8bac-35014caba949" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472780} {:answer/id #uuid "19621db5-93e2-50ee-9ddb-8440f2d6f313" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472781}] :answer-field/correct {:answer/id #uuid "19621db5-93e2-50ee-9ddb-8440f2d6f313" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472781} :answer-field/id #uuid "7af95f9f-6948-54ed-b3d3-37b3b7e7a68c" :answer-field/key "${Q({u}_{1}),Q({u}_{2})}$ is orthogonal" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473785} {:answer-field/choices [{:answer/id #uuid "5b309452-f7e7-54e9-bbdf-9a3025bd85c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472782} {:answer/id #uuid "f4968354-f03a-5157-9f0d-8be8dbd50643" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472783}] :answer-field/correct {:answer/id #uuid "5b309452-f7e7-54e9-bbdf-9a3025bd85c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472782} :answer-field/id #uuid "46245871-924f-5edd-8bb1-a6c28bc755b4" :answer-field/key "${Q({u}_{1}),Q({u}_{2})}$ is orthonormal" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473786} {:answer-field/choices [{:answer/id #uuid "7d29e23e-a42a-557c-9cd8-36cdc476c1b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669101} {:answer/id #uuid "6852a441-ec3f-5957-a17b-e134f4c25c6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669102}] :answer-field/correct {:answer/id #uuid "7d29e23e-a42a-557c-9cd8-36cdc476c1b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669101} :answer-field/id #uuid "b1bc571b-32e8-51f0-acbf-3e12094414e0" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669350}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2a7fbace-2464-5d79-be05-e6f28745c3de" :question/math-academy-id "q-178014" :question/problem "$$\n{u}_{1}=\\begin{bmatrix}3 \\\\ -6\\end{bmatrix},\\,{u}_{2}=\\begin{bmatrix}4 \\\\ 2\\end{bmatrix}\n$$\n\nConsider the vectors above, and let $Q$ be an orthogonal linear transformation. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nWith that in mind, let's examine our statements.\n\n- Statement ${u}_{1}\\cdot {u}_{2}=0$ is true. Indeed,\n\n$$\n{u}_{1}\\cdot {u}_{2}=\\begin{bmatrix}3 \\\\ -6\\end{bmatrix}\\cdot \\begin{bmatrix}4 \\\\ 2\\end{bmatrix}=12-12=0.\n$$\n\n- Statement “${Q({u}_{1}),Q({u}_{2})}$ is orthogonal” is true. Indeed, $Q({u}_{1})⊥Q({u}_{2})$ since\n\n$$\nQ({u}_{1})\\cdot Q({u}_{2})={u}_{1}\\cdot {u}_{2}=0.\n$$\n\n- Statement “${Q({u}_{1}),Q({u}_{2})}$ is orthonormal” is false. Notice that, for example, $Q({u}_{1})$ is not a unit vector since\n\n$$\n‖Q({u}_{1})‖=‖{u}_{1}‖=\\sqrt{{3}^{2}+(-6)^{2}}\\ne 1.\n$$\n\nTherefore, the correct answer is ${u}_{1}\\cdot {u}_{2}=0$; “${Q({u}_{1}),Q({u}_{2})}$ is orthogonal” only."} {:db/id #edb/ref 17592186415314 :knowledge-point/_questions [{:db/id #edb/ref 17592186179743 :knowledge-point/id #uuid "1da220a9-2afc-5b63-a423-a4d2b3de9567" :knowledge-point/title "Circulation in Conservative Vector Fields"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51baee7c-4f09-5886-aa36-1dcdf90f0b1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472538} {:answer/id #uuid "46738186-25bf-5244-a8cd-2cfae05fe1b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472539}] :answer-field/correct {:answer/id #uuid "51baee7c-4f09-5886-aa36-1dcdf90f0b1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472538} :answer-field/id #uuid "2343f5a2-9a6f-5456-bd97-3e506bdd18a6" :answer-field/key "$F$ is **not** conservative" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473664} {:answer-field/choices [{:answer/id #uuid "43d8099c-d11a-55ed-bd66-5bc9bfad9a06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472540} {:answer/id #uuid "91e139e0-9b3e-56d8-b8c4-b1714fe1291e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472541}] :answer-field/correct {:answer/id #uuid "43d8099c-d11a-55ed-bd66-5bc9bfad9a06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472540} :answer-field/id #uuid "f7751525-7c16-596e-8c69-5d8f650009fe" :answer-field/key "${\\int }_{C}F\\cdot \\text{d}r=0$ for any smooth path $C\\in {R}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473665} {:answer-field/choices [{:answer/id #uuid "860e69b6-35d8-5d31-ba12-9202b482813d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472542} {:answer/id #uuid "4b8bf411-3432-5e8d-81ec-008c129f27d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472543}] :answer-field/correct {:answer/id #uuid "4b8bf411-3432-5e8d-81ec-008c129f27d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472543} :answer-field/id #uuid "09f14689-536e-5986-8e63-f7f4a981a39f" :answer-field/key "${∮}_{C}F\\cdot \\text{d}r=0$ for any ellipse $C\\in {R}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473666} {:answer-field/choices [{:answer/id #uuid "d95761ef-ef8a-59a8-8e89-af33add923ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669003} {:answer/id #uuid "e7735880-3d1a-574a-b1d0-0f7e2aa996db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669004}] :answer-field/correct {:answer/id #uuid "d95761ef-ef8a-59a8-8e89-af33add923ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669003} :answer-field/id #uuid "75dc52ae-6fcb-587b-862d-316f1cbc03a3" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669301}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "77e87c43-f6db-5082-9277-93ef32960dff" :question/math-academy-id "q-125659" :question/problem "Consider the vector field $F(x,y)=2x\\operatorname{arctan}⁡2y\\,i+\\frac{2{x}^{2}}{1+4{y}^{2}}\\,j.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "If $F$ is a conservative vector field on ${R}^{2},$ then the circulation $Γ=0$ for any *closed* path $C\\in {R}^{2},$ that is \n\n$$\nΓ={∮}_{C}F\\cdot \\text{d}r=0.\n$$\n\nWe notice that $F=P\\,i+Q\\,j$ is a vector field with domain $D={R}^{2}.$ Computing the partial derivatives, we have\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}=\\frac{4x}{1+4{y}^{2}}.\n$$\n\nWith that in mind, let's consider each statement in turn:\n\n- Statement “$F$ is **not** conservative” is false. The vector field $F$ is conservative since the partial derivatives are equal and continuous everywhere on ${R}^{2}.$\n\n- Statement “${\\int }_{C}F\\cdot \\text{d}r=0$ for any smooth path $C\\in {R}^{2}$” is false, while statement “${∮}_{C}F\\cdot \\text{d}r=0$ for any ellipse $C\\in {R}^{2}$” is true. The result $Γ=0$ applies to closed curves only.\n\nTherefore, the correct answer is “${∮}_{C}F\\cdot \\text{d}r=0$ for any ellipse $C\\in {R}^{2}$” only."} {:db/id #edb/ref 17592186416927 :knowledge-point/_questions [{:db/id #edb/ref 17592186188280 :knowledge-point/id #uuid "fd3fd748-f238-59b2-badf-54b6e762836c" :knowledge-point/title "Identifying Statistics"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91928ab5-1c08-5709-ade9-42c3fbbc3f62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472736} {:answer/id #uuid "8ee1a951-eaaf-5f12-8f31-8f125d603255" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472737}] :answer-field/correct {:answer/id #uuid "91928ab5-1c08-5709-ade9-42c3fbbc3f62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472736} :answer-field/id #uuid "2f5bc247-9c01-53e3-aadd-ed34804268a7" :answer-field/key "$\\mu \\cdot \\sigma -\\text{min}({X}_{1},{X}_{2},…,{X}_{16})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473763} {:answer-field/choices [{:answer/id #uuid "5d5702a5-502e-5b8d-9267-895c288c6f32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472738} {:answer/id #uuid "af515352-e650-5ec1-92cb-48d3ce1f3514" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472739}] :answer-field/correct {:answer/id #uuid "5d5702a5-502e-5b8d-9267-895c288c6f32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472738} :answer-field/id #uuid "81ff48ec-fbac-56c6-88aa-5530077f7640" :answer-field/key "$\\mu -\\text{median}({X}_{2},{X}_{4},…,{X}_{16})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473764} {:answer-field/choices [{:answer/id #uuid "f929db08-b244-5145-89ee-3131d2530bfa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472740} {:answer/id #uuid "df817a80-9731-505c-9947-3f51347deb8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472741}] :answer-field/correct {:answer/id #uuid "df817a80-9731-505c-9947-3f51347deb8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472741} :answer-field/id #uuid "b551a732-145c-5747-b844-8f4d584df8bc" :answer-field/key "$\\sigma -max({X}_{1},{X}_{3},…,{X}_{15})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473765} {:answer-field/choices [{:answer/id #uuid "20a668c3-f104-5174-a0a0-784427f54b65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669063} {:answer/id #uuid "e9f73a11-4553-5c1a-a180-bd65fda711ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669064}] :answer-field/correct {:answer/id #uuid "20a668c3-f104-5174-a0a0-784427f54b65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669063} :answer-field/id #uuid "d6d5657e-4902-5850-941f-179d490a0cc0" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669331}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4893e2e1-c5c0-525e-90bd-45f0ee89d95b" :question/math-academy-id "q-143552" :question/problem "A sample ${X}_{1},{X}_{2},…,{X}_{16}$ is drawn from a population with population mean $\\mu $ and population variance ${\\sigma }^{2}.$ If $\\mu $ is unknown and $\\sigma $ is known, which of the following are statistics?\n\nSelect all that apply." :question/worked-solution "Suppose ${X}_{1},{X}_{2},…,{X}_{n}$ is a sequence of random variables representing a random sample of size $n$ drawn from a population. A statistic is a random variable expressed as a function of ${X}_{i}.$\n\nStatistics cannot involve unknown population parameters.\n\nWith that in mind, let's examine each expression.\n\n- Expressions $\\mu \\cdot \\sigma -\\text{min}({X}_{1},{X}_{2},…,{X}_{16})$ and $\\mu -\\text{median}({X}_{2},{X}_{4},…,{X}_{16})$ are *not* statistics. They are functions that contain the unknown population mean $\\mu .$\n\n- Expression $\\sigma -max({X}_{1},{X}_{3},…,{X}_{15})$ is a statistic. It is a function of the sample ${X}_{1},{X}_{2},…,{X}_{16}$ and the *known* population standard deviation $\\sigma $ only. Note that a statistic doesn't need to include every sample element.\n\nTherefore, the correct answer is $\\sigma -max({X}_{1},{X}_{3},…,{X}_{15})$ only."} {:db/id #edb/ref 17592186420276 :knowledge-point/_questions [{:db/id #edb/ref 17592186161921 :knowledge-point/id #uuid "01ad9700-5aaa-5b00-8d2f-acce6ed59c9a" :knowledge-point/title "Functions Whose Codomain Is the Set of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "982f653f-6cf3-53fc-8e56-92ef7d70036a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473016} {:answer/id #uuid "edcc72a5-120b-5ee1-97e7-fd2c98eb5894" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473017}] :answer-field/correct {:answer/id #uuid "edcc72a5-120b-5ee1-97e7-fd2c98eb5894" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473017} :answer-field/id #uuid "aaa6136d-b30b-56e8-bf30-53b61fc6705c" :answer-field/key "The range of $f$ is $(1,\\infty )$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473903} {:answer-field/choices [{:answer/id #uuid "d7ee2327-d1e9-55df-aa68-0c11381e1802" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473018} {:answer/id #uuid "2feb2a73-5b5f-5e62-a646-b09fcd1fd29a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473019}] :answer-field/correct {:answer/id #uuid "2feb2a73-5b5f-5e62-a646-b09fcd1fd29a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473019} :answer-field/id #uuid "ddb77040-d533-5459-9ba9-3ae4efed3106" :answer-field/key "$∀\\,y\\in (1,\\infty ),$ $∃\\,x\\in R$ such that $f(x)=y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473904} {:answer-field/choices [{:answer/id #uuid "4606e02b-20d0-5cfc-93eb-144ed9f379b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473020} {:answer/id #uuid "aeb21794-a922-514c-b6d9-2a4e071ad20c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473021}] :answer-field/correct {:answer/id #uuid "aeb21794-a922-514c-b6d9-2a4e071ad20c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473021} :answer-field/id #uuid "d26a451b-cb27-5bb6-a13a-9b40b67b59dd" :answer-field/key "$f$ maps $R$ **into** $R$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473905} {:answer-field/choices [{:answer/id #uuid "34ba8a63-f897-58fb-8370-cef7a0be7f75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669149} {:answer/id #uuid "ef2b5b41-6eeb-5138-ba6f-970650e0a0bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669150}] :answer-field/correct {:answer/id #uuid "34ba8a63-f897-58fb-8370-cef7a0be7f75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669149} :answer-field/id #uuid "0e2e8472-7afe-51be-ab93-2eaf50b49f7d" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669374}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ba992cb2-fd2f-5e4c-b95b-b82e7bb29b58" :question/math-academy-id "q-232536" :question/problem "Which of the following statements are true regarding the function $f:R\\to R$ which is given by $f(x)={3}^{x}+1?$\n\nSelect all that apply." :question/worked-solution "First, we graph the function.\n\n![](images/0c/0cb3e23cecdbd82803f5757827f21a424672bdde6da03782ca995d23e1c4d7b4.png)\n\nRecall that $f:X\\to Y$ is an *into* function if it is not a surjection. In other words, there exists an element $y$ in $Y$ such that it has no preimage in $X:$ \n\n$f:X\\to Y$ is an into function if $∃\\,y\\in Y$ such that $∀\\,x\\in X,$ we have $f(x)\\ne y.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement “The range of $f$ is $(1,\\infty )$” is true. From the graph, the function takes all $y$-values greater than $y=1$, excluding $y=1$ itself. So the range of the function is indeed $(1,\\infty ).$\n\n- Statement “$∀\\,y\\in (1,\\infty ),$ $∃\\,x\\in R$ such that $f(x)=y$” is true. Since the range of the function is $(1,\\infty )$, then for all $y$ contained within $(1,\\infty ),$ there exists some $x$ contained within $R$ such that $f(x)=y.$\n\n- Statement “$f$ maps $R$ **into** $R$” is true. As we can see from the range, there is no real number $x$ such that $f(x)=0\\in R.$ So, $f$ maps $R$ *into* $R.$\n\nTherefore, the correct answer is “The range of $f$ is $(1,\\infty )$”; “$∀\\,y\\in (1,\\infty ),$ $∃\\,x\\in R$ such that $f(x)=y$”; “$f$ maps $R$ **into** $R$”."} {:db/id #edb/ref 17592186420690 :knowledge-point/_questions [{:db/id #edb/ref 17592186152077 :knowledge-point/id #uuid "d0bc3ecd-2da1-5951-abba-95da02dee826" :knowledge-point/title "Identifying Necessary Conditions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c974654-2cb6-5b5b-97a1-e7952338aa19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474514} {:answer/id #uuid "77ac130e-f100-51be-bd73-406df515704d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474515}] :answer-field/correct {:answer/id #uuid "3c974654-2cb6-5b5b-97a1-e7952338aa19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474514} :answer-field/id #uuid "6c88976d-d907-52f4-b47a-d7b43494e038" :answer-field/key "$n$ is an odd number" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475183} {:answer-field/choices [{:answer/id #uuid "b124e103-45ef-5879-b034-67056b95ce39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474516} {:answer/id #uuid "ecb1842c-fdd9-5de9-8f9c-62da69dba519" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474517}] :answer-field/correct {:answer/id #uuid "b124e103-45ef-5879-b034-67056b95ce39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474516} :answer-field/id #uuid "0feb969b-f2b9-5a1a-83bd-b7a42fa61e97" :answer-field/key "$n$ is a positive number" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475184} {:answer-field/choices [{:answer/id #uuid "66d71eb4-f061-5c7b-9f2d-10d55ca0c471" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474518} {:answer/id #uuid "51e51cb2-94cf-54a5-bbf1-cbeee409ec60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474519}] :answer-field/correct {:answer/id #uuid "51e51cb2-94cf-54a5-bbf1-cbeee409ec60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474519} :answer-field/id #uuid "129babf3-fc18-5e17-9e10-6f9c8b2b5687" :answer-field/key "$n$ is a multiple of $2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475185} {:answer-field/choices [{:answer/id #uuid "9c3e81cb-bbe4-515c-8eb7-9f81c6fbc87a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669091} {:answer/id #uuid "c587da29-66ef-565a-8e53-75e0622146d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669092}] :answer-field/correct {:answer/id #uuid "9c3e81cb-bbe4-515c-8eb7-9f81c6fbc87a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669091} :answer-field/id #uuid "8ac04d66-2edf-5c41-927c-d48c85d48145" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669345}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "04618c03-3ca0-590d-b082-33d1176f03c4" :question/math-academy-id "q-172300" :question/problem "$\\,$ ${n}^{2}$ is an even number\n\nWhich of the following conditions are necessary for the above to be true?\n\nSelect all that apply." :question/worked-solution "Given that the implication $S⇒N$ is true, we have the following:\n\n- $S$ being true *guarantees* that $N$ must also be true. Therefore, $S$ is a *sufficient condition* for $N.$\n\n- For $S$ to be true, it is *necessary* that $N$ is true. Therefore, $N$ is a *necessary condition* for $S.$ However, note that $N$ being true does *not* guarantee that $S$ is true.\n\nThese ideas can be summarized as follows:\n\n$$\n\\text{S}\\text{ufficient}\\,⇒\\,\\text{N}\\text{ecessary}.\n$$\n\nIn our case, we need to find the conditions that are *necessary* from the given one:\n\n$$\n({n}^{2}\\text{ is an even number})\\,⇒\\,\\text{N}\\text{ecessary}\n$$\n\nWith that in mind, let's inspect each of the given conditions. \n\n- Condition “$n$ is an odd number” is *not* a necessary condition: \n\n$$\n({n}^{2}\\text{ is an even number })\\,⇏\\,(n\\text{ is an odd number})\\,\\,\\times \n$$\n\nFor example, the number $n=2$ is not an odd number but ${2}^{2}$ is an even number.\n\n- Condition “$n$ is a positive number” is *not* a necessary condition: \n\n$$\n({n}^{2}\\text{ is an even number})\\,⇏\\,(\\text{ is a positive number})\\,\\,\\times \n$$\n\nFor example, the number $n=-2$ is not a positive number, but $(-2)^{2}$ is an even number.\n\n- Condition “$n$ is a multiple of $2$” is a necessary condition: \n\n$$\n({n}^{2}\\text{ is an even number})\\,⇒\\,(n\\text{ is a multiple of }2)\\,\\,✓\n$$\n\nSince ${n}^{2}$ is even, it must also be true that $n$ is even. Therefore, $n$ is a multiple of $2.$\n\nTherefore, the correct answer is “$n$ is a multiple of $2$” only."} {:db/id #edb/ref 17592186420691 :knowledge-point/_questions [{:db/id #edb/ref 17592186152078 :knowledge-point/id #uuid "ed7345a2-810f-5a35-aa01-092e40df06f3" :knowledge-point/title "Identifying Sufficient Conditions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5dea9d9d-31c2-5c01-a455-69465daf1b26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474526} {:answer/id #uuid "40fa915d-3313-5401-9881-502282158014" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474527}] :answer-field/correct {:answer/id #uuid "40fa915d-3313-5401-9881-502282158014" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474527} :answer-field/id #uuid "17214d23-c467-5173-8f61-0766426c313a" :answer-field/key "$n=4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475189} {:answer-field/choices [{:answer/id #uuid "56e611a6-dc82-58ef-8f11-dceebaf58e96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474528} {:answer/id #uuid "0826a1f6-c863-5d42-95b8-1df6c2a6e255" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474529}] :answer-field/correct {:answer/id #uuid "56e611a6-dc82-58ef-8f11-dceebaf58e96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474528} :answer-field/id #uuid "5e223d7b-f377-5bdd-ae40-106ebab7f04d" :answer-field/key "$-4<n<4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475190} {:answer-field/choices [{:answer/id #uuid "fc96775f-c6f5-5ca4-9703-f26d24ae7c04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474530} {:answer/id #uuid "7f69da4d-9e54-5cfd-923f-6c36718e49e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474531}] :answer-field/correct {:answer/id #uuid "fc96775f-c6f5-5ca4-9703-f26d24ae7c04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474530} :answer-field/id #uuid "d1764754-6220-5bd9-aaab-c9961114c472" :answer-field/key "$|n|<16$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475191} {:answer-field/choices [{:answer/id #uuid "409886be-d348-5cda-a5bb-896d75a5dfda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669093} {:answer/id #uuid "e2764e5d-261b-5616-8e97-ed76189505d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669094}] :answer-field/correct {:answer/id #uuid "409886be-d348-5cda-a5bb-896d75a5dfda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669093} :answer-field/id #uuid "b0ece827-7991-5a89-93ba-01b377ef5e4f" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669346}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "10fd92b2-5e05-5850-b7d2-d8140b9fd04f" :question/math-academy-id "q-172315" :question/problem "$\\,$ ${n}^{2}=16$\n\nWhich of the following conditions are sufficient for the above to be true?\n\nSelect all that apply." :question/worked-solution "Given that the implication $S⇒N$ is true, we have the following:\n\n- $S$ being true *guarantees* that $N$ must also be true. Therefore, $S$ is a *sufficient condition* for $N.$\n\n- For $S$ to be true, it is *necessary* that $N$ is true. Therefore, $N$ is a *necessary condition* for $S.$ However, note that $N$ being true does *not* guarantee that $S$ is true.\n\nThese ideas can be summarized as follows:\n\n$$\n\\text{S}\\text{ufficient}\\,⇒\\,\\text{N}\\text{ecessary}.\n$$\n\nIn our case, we need to find the conditions that are *sufficient* for the given one:\n\n$$\n\\text{S}\\text{ufficient}\\,⇒\\,({n}^{2}=16)\n$$\n\nNote that the solution to the given equation is \n\n$$\n\\begin{aligned}{n}^{2} & =16 \\\\ {n}^{2}-16 & =0 \\\\ (n+4)(n-4) & =0 \\\\ n & =-4,4.\\end{aligned}\n$$\n\nWith that in mind, let's inspect each of the given conditions.\n\n- Condition $n=4$ is a sufficient condition:\n\n$$\n(n=4)\\,⇒\\,({n}^{2}=16)\\,\\,✓\n$$\n\nIf $n=4,$ then ${n}^{2}=16.$\n\n- Condition $-4<n<4$ is *not* a sufficient condition:\n\n$$\n(-4<n<4)\\,⇏\\,({n}^{2}=16)\\,\\,\\times \n$$\n\nFor example, if $n=-1,$ then\n\n$$\n\\begin{aligned}{n}^{2} & =(-1)^{2} \\\\  & =1\\ne 16.\\end{aligned}\n$$\n\n- Condition $|n|<16$ is *not* a sufficient condition:\n\n$$\n(|n|<16)\\,⇏\\,({n}^{2}=16)\\,\\,\\times \n$$\n\nFor example, if $n=-1,$ then $|n|<16,$ but ${n}^{2}=1\\ne 16.$\n\nTherefore, the correct answer is $n=4$ only."} {:db/id #edb/ref 17592186420692 :knowledge-point/_questions [{:db/id #edb/ref 17592186152078 :knowledge-point/id #uuid "ed7345a2-810f-5a35-aa01-092e40df06f3" :knowledge-point/title "Identifying Sufficient Conditions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6918f073-c442-5f18-b455-52622f56f35e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474538} {:answer/id #uuid "aaf41748-06d6-52c6-aa3b-308d83a706dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474539}] :answer-field/correct {:answer/id #uuid "6918f073-c442-5f18-b455-52622f56f35e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474538} :answer-field/id #uuid "3d8263b8-7e82-5b77-9f03-bec084e88fd5" :answer-field/key "$|x|>3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475195} {:answer-field/choices [{:answer/id #uuid "f9e39ef7-a88b-577a-b0d6-705ea2d526fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474540} {:answer/id #uuid "87a04c93-3149-5e28-8454-384821f8c32e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474541}] :answer-field/correct {:answer/id #uuid "87a04c93-3149-5e28-8454-384821f8c32e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474541} :answer-field/id #uuid "b2fed408-cdcd-55a9-a9f4-12abd80bada2" :answer-field/key "$x>3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475196} {:answer-field/choices [{:answer/id #uuid "e26f992c-0caf-597a-b322-2e782bc69db1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474542} {:answer/id #uuid "88843fa6-1855-53ff-af9a-14a6b6a49357" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474543}] :answer-field/correct {:answer/id #uuid "88843fa6-1855-53ff-af9a-14a6b6a49357" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474543} :answer-field/id #uuid "2accb876-bb81-5087-87aa-41721160c992" :answer-field/key "$x>4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475197} {:answer-field/choices [{:answer/id #uuid "ca1d5ccb-0acf-5c19-a676-394750f2eda3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669097} {:answer/id #uuid "9f399751-2e0e-532a-a3ee-c2e4256fd292" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669098}] :answer-field/correct {:answer/id #uuid "ca1d5ccb-0acf-5c19-a676-394750f2eda3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669097} :answer-field/id #uuid "de6bb1c4-cf10-5997-a2fd-38c9a5ef4931" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669348}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "28567992-ba7f-5623-ad07-13abe4be416c" :question/math-academy-id "q-172325" :question/problem "$\\,$ $x+1>4$\n\nWhich of the following conditions are sufficient for the above to be true?\n\nSelect all that apply." :question/worked-solution "Given that the implication $S⇒N$ is true, we have the following:\n\n- $S$ being true *guarantees* that $N$ must also be true. Therefore, $S$ is a *sufficient condition* for $N.$\n\n- For $S$ to be true, it is *necessary* that $N$ is true. Therefore, $N$ is a *necessary condition* for $S.$ However, note that $N$ being true does *not* guarantee that $S$ is true.\n\nThese ideas can be summarized as follows:\n\n$$\n\\text{S}\\text{ufficient}\\,⇒\\,\\text{N}\\text{ecessary}.\n$$\n\n  \n\nIn our case, we need to find the conditions that are *sufficient* for the given one:\n\n$$\n\\text{S}\\text{ufficient}\\,⇒\\,(x+1>4)\n$$\n\nNote that the solution to the given equation is \n\n$$\n\\begin{aligned}x+1 & >4 \\\\ x & >3.\\end{aligned}\n$$\n\nWith that in mind, let's inspect each of the given conditions.\n\n- Condition $|x|>3$ is *not* a sufficient condition:\n\n$$\n(|x|>3)\\,⇏\\,(x+1>4)\\,\\,\\times \n$$\n\nFor example, if $x=-4,$ then we have $x+1=-3≯4.$\n\n- Condition $x>3$ is a sufficient condition:\n\n$$\n(x>3)\\,⇒\\,(x+1>4)\\,\\,✓\n$$\n\nIf $x>3,$ then $x+1>4.$\n\n- Condition $x>4$ is a sufficient condition:\n\n$$\n(x>4)\\,⇒\\,(x+1>4)\\,\\,✓\n$$\n\nIf $x>4,$ then  $x+1>5>4.$\n\nTherefore, the correct answer is $x>3$; $x>4$ only."} {:db/id #edb/ref 17592186420702 :knowledge-point/_questions [{:db/id #edb/ref 17592186152078 :knowledge-point/id #uuid "ed7345a2-810f-5a35-aa01-092e40df06f3" :knowledge-point/title "Identifying Sufficient Conditions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "408df0cb-6c6f-5d9b-90f1-7f582171bc71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474532} {:answer/id #uuid "e8c3c23c-90bd-53c4-815e-4acbcce6f3e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474533}] :answer-field/correct {:answer/id #uuid "e8c3c23c-90bd-53c4-815e-4acbcce6f3e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474533} :answer-field/id #uuid "c650a4e4-46df-5663-8cc8-623efe286c07" :answer-field/key "$a=10$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475192} {:answer-field/choices [{:answer/id #uuid "c9112523-8587-5ffa-8287-6ac21dbb9e74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474534} {:answer/id #uuid "d42bf337-0cdd-5dad-902c-9e538740fc05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474535}] :answer-field/correct {:answer/id #uuid "d42bf337-0cdd-5dad-902c-9e538740fc05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474535} :answer-field/id #uuid "03bb3ee9-bab8-5ebf-9f70-e330a2b233ff" :answer-field/key "$a>15$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475193} {:answer-field/choices [{:answer/id #uuid "e5ba5bf5-e61c-5fb1-91c6-c2c59dbcaad9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474536} {:answer/id #uuid "fa034870-2511-553a-a643-bf518efcae8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474537}] :answer-field/correct {:answer/id #uuid "e5ba5bf5-e61c-5fb1-91c6-c2c59dbcaad9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474536} :answer-field/id #uuid "7d785b52-fdd9-556d-a378-0f57be058f85" :answer-field/key "$a>5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475194} {:answer-field/choices [{:answer/id #uuid "cdf01400-3617-5476-a0a6-b9a32db8139a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669095} {:answer/id #uuid "d13ba5bf-aa4f-54b6-adb5-0ca2eb3691be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669096}] :answer-field/correct {:answer/id #uuid "cdf01400-3617-5476-a0a6-b9a32db8139a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669095} :answer-field/id #uuid "d8fca62b-9db0-5ec8-84f4-c970b0db85ff" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669347}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e4cdd56d-10e6-5abf-be98-585e1ce87428" :question/math-academy-id "q-172322" :question/problem "$\\,$ $a\\ge 10$\n\nWhich of the following conditions are sufficient for the above to be true?\n\nSelect all that apply." :question/worked-solution "Given that the implication $S⇒N$ is true, we have the following:\n\n- $S$ being true *guarantees* that $N$ must also be true. Therefore, $S$ is a *sufficient condition* for $N.$\n\n- For $S$ to be true, it is *necessary* that $N$ is true. Therefore, $N$ is a *necessary condition* for $S.$ However, note that $N$ being true does *not* guarantee that $S$ is true.\n\nThese ideas can be summarized as follows:\n\n$$\n\\text{S}\\text{ufficient}\\,⇒\\,\\text{N}\\text{ecessary}.\n$$\n\nIn our case, we need to find the conditions that are *sufficient* for the given one:\n\n$$\n\\text{S}\\text{ufficient}\\,⇒\\,(a\\ge 10)\n$$\n\nWith that in mind, let's inspect each of the given conditions.\n\n- Condition $a=10$ is a sufficient condition:\n\n$$\n(a=10)\\,⇒\\,(a\\ge 10)\\,\\,✓\n$$\n\nIf $a=10,$ then $a\\ge 10.$\n\n- Condition $a>15$ is a sufficient condition:\n\n$$\n(a>15)\\,⇒\\,(a\\ge 10)\\,\\,✓\n$$\n\nIf $a>15,$ then $a\\ge 10.$\n\n- Condition $a>5$ is *not* a sufficient condition:\n\n$$\n(a>5)\\,⇏\\,(a\\ge 10)\\,\\,\\times \n$$\n\nFor example, if $a=7,$ then we have $a≱10.$\n\nTherefore, the correct answer is $a=10$; $a>15$ only."} {:db/id #edb/ref 17592186420985 :knowledge-point/_questions [{:db/id #edb/ref 17592186054636 :knowledge-point/id #uuid "3fca5176-1359-5ad8-b012-592ffa9b20b5" :knowledge-point/title "Cartesian Products With Three Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "977dd536-4220-524b-931c-3ba60f55073d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474556} {:answer/id #uuid "48cbd00d-6155-5f97-ad98-53542fd4bb4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474557}] :answer-field/correct {:answer/id #uuid "977dd536-4220-524b-931c-3ba60f55073d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474556} :answer-field/id #uuid "251277cb-3ad8-5af9-897f-6f40b45fce72" :answer-field/key "$(-2,d,c)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475204} {:answer-field/choices [{:answer/id #uuid "c59c1ac2-aac3-545b-8f90-1ae8a978cafa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474558} {:answer/id #uuid "741d8b65-925b-5a70-8aff-77354bc69797" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474559}] :answer-field/correct {:answer/id #uuid "c59c1ac2-aac3-545b-8f90-1ae8a978cafa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474558} :answer-field/id #uuid "d170f76e-4e31-5ac5-b1a2-1881ac8d197d" :answer-field/key "$(-2,(c,d))$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475205} {:answer-field/choices [{:answer/id #uuid "ffc21ad4-56fc-56ad-8058-de8c73d359e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474560} {:answer/id #uuid "4843b0fb-74a8-5c2c-b516-cacac8678dd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474561}] :answer-field/correct {:answer/id #uuid "4843b0fb-74a8-5c2c-b516-cacac8678dd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474561} :answer-field/id #uuid "254e65e2-d3aa-5440-89cf-3f8963043077" :answer-field/key "$((2,d),c)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475206} {:answer-field/choices [{:answer/id #uuid "260d3fd9-8d79-55c0-adc8-55962cdabfd6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669105} {:answer/id #uuid "26c1a8ea-3f9e-5f75-b8f4-4c8f5fa66cb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669106}] :answer-field/correct {:answer/id #uuid "260d3fd9-8d79-55c0-adc8-55962cdabfd6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669105} :answer-field/id #uuid "f5c670ca-1e3e-5df8-9afe-3af2cd9e1845" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669352}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1c44203d-f0c3-504e-a004-3addf0955223" :question/math-academy-id "q-181956" :question/problem "If $A=\\{-2,2\\}$ and $B=\\{c,d\\},$ which of the following elements belong to $(A\\times B)\\times B?$\n\nSelect all that apply." :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nIn this case, $A\\times B$ consists of every combination of ${-2,2}$ with ${c,d},$ as shown in the schematic below.\n\n![](images/98/98e7cfca515290b952ea5aefc9b2516a5cd6a68de0dc048c2075128e6c60b651.png)\n\nHence, the set $A\\times B$ is given by\n\n$$\nA\\times B={(-2,c),(-2,d),(2,c),(2,d)}.\n$$\n\nNote that \n\n$$\n|A\\times B|=|A|\\cdot |B|=2\\cdot 2=4.\n$$\n\nNow, the Cartesian product\n\n$$\n(A\\times B)\\times B\n$$\n\nconsists of every combination of $A\\times B$ and $B,$ as shown in the schematic below.\n\n![](images/1e/1e96aeb1c5bfb1f9faa590a8eb8b01528a1ce9431a3f1ceac92b156a9bdde221.png)\n\nNote that \n\n$$\n|(A\\times B)\\times B|=|A\\times B|\\cdot |B|=4\\cdot 2=8.\n$$\n\nFrom the given options, we see that only $((2,d),c)\\in (A\\times B)\\times B.$\n\nTherefore, the correct answer is $((2,d),c)$ only."} {:db/id #edb/ref 17592186421311 :knowledge-point/_questions [{:db/id #edb/ref 17592186152280 :knowledge-point/id #uuid "e66005fe-df33-590a-9d9c-91947cd4a608" :knowledge-point/title "Identifying Fundamental Sets of Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "efc36190-e9b2-59a8-90c3-e42746b56e48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474756} {:answer/id #uuid "64273c85-b54b-59a4-85ac-81ca202e2b07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474757}] :answer-field/correct {:answer/id #uuid "64273c85-b54b-59a4-85ac-81ca202e2b07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474757} :answer-field/id #uuid "f069e89d-9efc-5468-a700-6f1c190427d9" :answer-field/key "${y}_{1}(x)=x$ is a solution to the equation." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475304} {:answer-field/choices [{:answer/id #uuid "2c223e50-374d-53fb-9ef7-5a76d425c