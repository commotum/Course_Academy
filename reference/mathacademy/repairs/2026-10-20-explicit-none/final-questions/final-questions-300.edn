/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468839} {:answer-field/choices [{:answer/id #uuid "c49e98e0-e3b6-5f90-a8b1-65fe4c1d56d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668713} {:answer/id #uuid "67a9a4b6-3566-57e5-a278-93909e0c5584" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668714}] :answer-field/correct {:answer/id #uuid "c49e98e0-e3b6-5f90-a8b1-65fe4c1d56d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668713} :answer-field/id #uuid "c2115b7c-6145-5ecd-b354-71d3d68ba36b" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668934}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d60b7843-0bd3-5e4e-8b85-becdd36b22ac" :question/math-academy-id "q-79047" :question/problem "Consider the function $f(x)=2+3x-{e}^{-x}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, we calculate the second derivative of $f(x),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =3+{e}^{-x} \\\\ {f}^{″}(x) & =-{e}^{-x}\\end{aligned}\n$$\n\nSince ${e}^{-x}>0$ for every real value of $x,$ it follows that $-{e}^{-x}<0$ for every real value of $x.$ Therefore, ${f}^{″}(x)$ is never positive, so there are no intervals where $f(x)$ is concave up.\n\nSince ${f}^{″}(x)<0$ for every real value of $x,$ the function is concave down on $(-\\infty ,\\infty ).$\n\nTherefore, the correct answer is “$f(x)$ is concave down on $(-\\infty ,\\infty )$” only."} {:db/id #edb/ref 17592186348433 :knowledge-point/_questions [{:db/id #edb/ref 17592186087842 :knowledge-point/id #uuid "60c99086-75e7-5d91-b425-4e1b6f582bcc" :knowledge-point/title "Calculating the Vertical Asymptotes of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fbf6982-05b4-57ae-9835-2a8ab3b2e21d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439961} {:answer/id #uuid "54cc906b-e4bc-599d-8d74-6fa3a9b26e21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439962}] :answer-field/correct {:answer/id #uuid "6fbf6982-05b4-57ae-9835-2a8ab3b2e21d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439961} :answer-field/id #uuid "07350d2f-29b2-579d-9e6d-ceb08289cfd4" :answer-field/key "$x=-3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440338} {:answer-field/choices [{:answer/id #uuid "f25878b7-8130-555e-aa37-27cbe26000c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439963} {:answer/id #uuid "27376910-59b5-508c-953c-14f679761cf6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439964}] :answer-field/correct {:answer/id #uuid "27376910-59b5-508c-953c-14f679761cf6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439964} :answer-field/id #uuid "41d6080f-1108-5fe0-9c51-3a0c440cb68c" :answer-field/key "$x=-1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440339} {:answer-field/choices [{:answer/id #uuid "c7894690-5c97-58f9-8498-da751ab39da4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439965} {:answer/id #uuid "c9827e3f-acf0-5df9-9fe2-90c258c048b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439966}] :answer-field/correct {:answer/id #uuid "c7894690-5c97-58f9-8498-da751ab39da4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439965} :answer-field/id #uuid "70ca306e-3cd4-5425-bff4-3f369e2d93d1" :answer-field/key "$x=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440340} {:answer-field/choices [{:answer/id #uuid "112e2955-ebe3-5b34-83f3-8f2972dcf1a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439967} {:answer/id #uuid "81445fe9-98f9-5684-afdd-6798f390e9ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439968}] :answer-field/correct {:answer/id #uuid "81445fe9-98f9-5684-afdd-6798f390e9ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439968} :answer-field/id #uuid "a6554586-5933-53ba-ba8d-33fbdb8aa00a" :answer-field/key "$x=4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440341} {:answer-field/choices [{:answer/id #uuid "b5836d44-e46b-5fd6-b4fd-76b917fae421" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668715} {:answer/id #uuid "5c61d290-729d-57fb-bed1-673ce366de3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668716}] :answer-field/correct {:answer/id #uuid "b5836d44-e46b-5fd6-b4fd-76b917fae421" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668715} :answer-field/id #uuid "a714e3e2-3159-56a6-8541-ebc2d28aa243" :answer-field/key "The function has no vertical asymptotes" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668935}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "45255a84-5494-574a-bd9f-880b4b37a48c" :question/math-academy-id "q-80669" :question/problem "Determine the vertical asymptotes of $f(x)=\\frac{{x}^{2}+3x}{{x}^{2}-3x-4}.$\n\nSelect all that apply." :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator, we get\n\n$$\nf(x)=\\frac{x(x+3)}{(x+1)(x-4)}.\n$$\n\nThere are no common factors in the numerator and denominator, so we set the denominator equal to zero and solve for $x:$\n\n$$\n\\begin{aligned}(x+1)(x-4) & =0\\end{aligned}\n$$\n\nThis gives the two solutions $x=-1$ and $x=4.$ Therefore, the equations of the vertical asymptotes are $x=-1$ and $x=4.$"} {:db/id #edb/ref 17592186348436 :knowledge-point/_questions [{:db/id #edb/ref 17592186087843 :knowledge-point/id #uuid "53b26ee4-53af-5660-a9e6-8e5cca8b3e1d" :knowledge-point/title "Calculating Vertical Asymptotes With Common Factors in the Numerator and Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17477df2-f0f4-5538-a244-56aea05cba72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439987} {:answer/id #uuid "4111ff3c-d0bc-54cd-ae53-5033ced42cf9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439988}] :answer-field/correct {:answer/id #uuid "17477df2-f0f4-5538-a244-56aea05cba72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #