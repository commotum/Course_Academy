type/text} :answer/value "false" :db/id #edb/ref 17592186668717} {:answer/id #uuid "05458843-f3e1-5c1b-8d96-d2f35510c778" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668718}] :answer-field/correct {:answer/id #uuid "56ffc4fb-9210-5e8c-9578-8bd7aa050e84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668717} :answer-field/id #uuid "c307f59b-6dd1-586e-9b8c-bb6bf53b6cbf" :answer-field/key "The function has no vertical asymptotes" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668936}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3dad69b3-29eb-58b2-9a73-eefa5740f30c" :question/math-academy-id "q-80691" :question/problem "Calculate the vertical asymptotes of $f(x)=\\frac{x+2}{{x}^{2}+2x}.$\n\nSelect all that apply." :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{x+2}{{x}^{2}+2x} \\\\  & =\\frac{x+2}{x(x+2)} \\\\  & =\\frac{\\cancel{x+2}}{x\\cancel{(x+2)}} \\\\  & =\\frac{1}{x}.\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero and solve for $x:$\n\n$$\nx=0\n$$\n\nThis gives the solution $x=0.$ Therefore, $x=0$ is the only vertical asymptote."} {:db/id #edb/ref 17592186348437 :knowledge-point/_questions [{:db/id #edb/ref 17592186087845 :knowledge-point/id #uuid "4b0b57da-f9af-5fab-a337-51ee4cb28f9e" :knowledge-point/title "Calculating Vertical Asymptotes With Common Factors When the Denominator Has Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a23df9c-0bb4-5f06-a2ce-f5