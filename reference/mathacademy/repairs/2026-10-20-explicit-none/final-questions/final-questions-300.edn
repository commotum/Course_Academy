/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668652}] :answer-field/correct {:answer/id #uuid "1112ab69-a314-536e-b396-42d7005bcc6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668651} :answer-field/id #uuid "a323a1cc-482f-59fd-98c7-c56192376429" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668903}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "005586ff-4a9c-5e53-b470-73135485f7ce" :question/math-academy-id "q-39216" :question/problem "Which of the following are rotation-scaling matrices?\n\nSelect all that apply." :question/worked-solution "A rotation-scaling matrix has the form \n\n$$\n\\begin{bmatrix}a & -b \\\\ b & a\\end{bmatrix},\n$$\n\n where $a$ and $b$ are real numbers that are not equal to zero simultaneously. Notice that the entries on the main diagonal are the same, while the antidiagonal entries have opposite signs.\n\nWith that in mind let's check each of the given matrices:\n\n- $A=\\begin{bmatrix}-5 & 4 \\\\ -4 & -5\\end{bmatrix}$ is a rotation-scaling matrix.\n\n- $B=\\begin{bmatrix}3 & -\\frac{2}{3} \\\\ \\frac{2}{3} & 3\\end{bmatrix}$ is a rotation-scaling matrix.\n\n- $C=\\begin{bmatrix}1 & 1 \\\\ -1 & 1\\end{bmatrix}$ is a rotation-scaling matrix.\n\nIn conclusion, the correct answer is $A=\\begin{bmatrix}-5 & 4 \\\\ -4 & -5\\end{bmatrix}$; $B=\\begin{bmatrix}3 & -\\frac{2}{3} \\\\ \\frac{2}{3} & 3\\end{bmatrix}$; $C=\\begin{bmatrix}1 & 1 \\\\ -1 & 1\\end{bmatrix}$."} {:db/id #edb/ref 17592186326753 :knowledge-point/_questions [{:db/id #edb/ref 17592186129321 :knowledge-point/id #uuid "359bc41e-1b6d-5177-9642-4f8697bc5ba0" :knowledge-point/title "Identifying Rotation-Scaling Matrices"}] :question/answer-fields [{:answer-field/choices [{: