ices [{:answer/id #uuid "4111f59a-4b7c-5386-b33f-c50f28c6b443" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467806} {:answer/id #uuid "3a8877fa-dbdd-5cc9-920f-2f627ad68b11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467807}] :answer-field/correct {:answer/id #uuid "3a8877fa-dbdd-5cc9-920f-2f627ad68b11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467807} :answer-field/id #uuid "584dfcf7-c414-5c45-a5d2-c3f57b7c501d" :answer-field/key "The function has no minimum value." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468624} {:answer-field/choices [{:answer/id #uuid "3a62cd36-3671-5aea-909d-1e1fbba55da0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467808} {:answer/id #uuid "1c1baf72-e23c-5b90-89c0-467c8a2f799c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467809}] :answer-field/correct {:answer/id #uuid "3a62cd36-3671-5aea-909d-1e1fbba55da0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467808} :answer-field/id #uuid "4a36ebcb-12e9-5824-809d-5c01b37f2b30" :answer-field/key "$x=-4\\pi $ is in the domain of the function." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468625} {:answer-field/choices [{:answer/id #uuid "0a53073c-9e3e-5db0-80fa-1486b957c632" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467810} {:answer/id #uuid "ca319a17-4107-55f9-bf22-cfeb8644f794" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467811}] :answer-field/correct {:answer/id #uuid "ca319a17-4107-55f9-bf22-cfeb8644f794" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467811} :answer-field/id #uuid "1ddab15c-2977-5c7e-aeed-f38132f57ba4" :answer-field/key "$x=-\\frac{3\\pi }{2}$ is a zero of the function." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468626} {:answer-field/choices [{:answer/id #uuid "c4ed9233-a58f-5e63-8b07-a34c2aa2bc7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668687} {:answer/id #uuid "8c145c65-a5a7-5d96-b165-db6afc2658e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668688}] :answer-field/correct {:answer/id #uuid "c4ed9233-a58f-5e63-8b07-a34c2aa2bc7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668687} :answer-field/id #uuid "65951739-3dc7-58fe-96b0-bd4d5f9c907d" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668921}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4a752d35-73b8-55ea-bb50-4d11f60be65b" :question/math-academy-id "q-70669" :question/problem "Which of the following statements are true regarding the function $y=\\operatorname{cot}⁡x?$ Assume $n$ is an integer.\n\nSelect all that apply." :question/worked-solution "Let's plot the graph of $y=cot⁡x.$\n\n![](images/8b/8bc549c68a3bc5b7989ac1835e4bb58183066c7797264b8cccd4f3fd2c895056.png)\n\nNow, let's go through each statement.\n\n- Statement “The function has no minimum value” is true. The function has no minimum or maximum value.\n\n- Statement “$x=-4\\pi $ is in the domain of the function” is false. The function is defined for all real numbers except the values $n\\pi $ for any integer $n$, thus it is not defined for $x=-4\\pi .$\n\n- Statement “$x=-\\frac{3\\pi }{2}$ is a zero of the function” is true. The zeros of $y=cot⁡x$ occur at $\\frac{\\pi }{2}+n\\pi ,$ for any integer $n.$ Therefore, $x=-\\frac{3\\pi }{2}$ is a zero of the function."} {:db/id #edb/ref 17592186338909 :knowledge-point/_questions [{:db/id #edb/ref 17592186129086 :knowledge-point/id #uuid "9110c50a-62db-5447-b4d0-60819c80eb31" :knowledge-point/title "Identifying Properties Related to Point Discontinuities Given a Function Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd64c57e-db4c-58c2-9c0a-6fb1e52a8dc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467836} {:answer/id #uuid "6d8068b5-f3a3-5dc6-a0ec-cecb527ccb80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467837}] :answer-field/correct {:answer/id #uuid "6d8068b5-f3a3-5dc6-a0ec-cecb527ccb80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467837} :answer-field/id #uuid "f2422695-230f-5927-9490-102b7e7aad51" :answer-field/key "${lim}_{x\\to {4}^{+}}g(x)={lim}_{x\\to {4}^{-}}g(x)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468639} {:answer-field/choices [{:answer/id #uuid "8baeab37-9b1a-57ad-b7b9-83f94da0b272" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467838} {:answer/id #uuid "38e2dab8-9fb9-5e67-a816-3499bc06a78f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467839}] :answer-field/correct {:answer/id #uuid "8baeab37-9b1a-57ad-b7b9-83f94da0b272" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467838} :answer-field/id #uuid "7db0f81d-fea3-51ed-b360-51d8b22165a7" :answer-field/key "${lim}_{x\\to 4}g(x)=g(4)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468640} {:answer-field/choices [{:answer/id #uuid "3a5f7ff8-b409-5399-af3b-b0798c72be3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467840} {:answer/id #uuid "9c5a5569-d89a-528c-8eda-f01b3b4a0dcb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467841}] :answer-field/correct {:answer/id #uuid "9c5a5569-d89a-528c-8eda-f01b3b4a0dcb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467841} :answer-field/id #uuid "e8f8893a-0805-523d-a0fc-3f3104e0d117" :answer-field/key "$g(x)$ has a removable discontinuity at $x=4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468641} {:answer-field/choices [{:answer/id #uuid "0fe7f643-b6fb-5a70-9fad-da788a78a1bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668689} {:answer/id #uuid "dfb15371-6ebe-561e-acf1-0c19b876da4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668690}] :answer-field/correct {:answer/id #uuid "0fe7f643-b6fb-5a70-9fad-da788a78a1bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668689} :answer-field/id #uuid "35b10628-9577-5f2c-9d9e-61dac9f5ecd7" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668922}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d44ff842-4620-550a-bab6-87cb0a1ac002" :question/math-academy-id "q-71179" :question/problem "Given that \n\n$$\n\\begin{aligned}g(x) & ={\\begin{aligned}3x, & x\\ne 4 \\\\ 13, & x=4,\\end{aligned}\\end{aligned}\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's check our continuity conditions:\n\n- $g(4)=13$ exists$\\,\\,✓$\n\n- The left and right-sided limits are\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,{4}^{-}}g(x) & ={lim}_{x\\to \\,{4}^{-}}3x=12, \\\\ {lim}_{x\\to \\,{4}^{+}}g(x) & ={lim}_{x\\to \\,{4}^{+}}3x=12.\\end{aligned}\n$$\n\nSince the left and right-sided limits are equal, we conclude that statement ${lim}_{x\\to {4}^{+}}g(x)={lim}_{x\\to {4}^{-}}g(x)$ is true and\n\n$$\n{lim}_{x\\to 4}g(x)=12.\\,\\,✓\n$$\n\n- The value of the limit is ${lim}_{x\\to 4}g(x)=12,$ while the value of the function is $g(4)=13.$ So, statement ${lim}_{x\\to 4}g(x)=g(4)$ is false and\n\n$$\n{lim}_{x\\to 4}g(x)\\ne g(4)\\,\\,\\times \n$$\n\nSince the third condition failed, the function has a removable discontinuity at $x=4,$ and statement “$g(x)$ has a removable discontinuity at $x=4$” is true.\n\nIn conclusion, only statements ${lim}_{x\\to {4}^{+}}g(x)={lim}_{x\\to {4}^{-}}g(x)$ and “$g(x)$ has a removable discontinuity at $x=4$” are true."} {:db/id #edb/ref 17592186341908 :knowledge-point/_questions [{:db/id #edb/ref 17592186068700 :knowledge-point/id #uuid "81247553-750f-5bf7-a1c4-698ad63b5ae4" :knowledge-point/title "Identifying True Statements Regarding Left- and Right-Continuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fb1b728-e5c1-56d0-a773-6a13b86c144a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467968} {:answer/id #uuid "1f3e086a-3eee-5014-bba7-217442e99470" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467969}] :answer-field/correct {:answer/id #uuid "8fb1b728-e5c1-56d0-a773-6a13b86c144a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467968} :answer-field/id #uuid "5010ced0-6c65-57ca-86ab-3156cee7409a" :answer-field/key "The function is left-continuous at $x=3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468705} {:answer-field/choices [{:answer/id #uuid "28b93087-ad7b-53c4-b3da-e44b9829803b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467970} {:answer/id #uuid "e772286c-b6b9-5b76-afdf-c7a1d919f850" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467971}] :answer-field/correct {:answer/id #uuid "e772286c-b6b9-5b76-afdf-c7a1d919f850" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467971} :answer-field/id #uuid "59560ccb-ca91-5b45-807c-a046f0c20497" :answer-field/key "The function is right-continuous at $x=3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468706} {:answer-field/choices [{:answer/id #uuid "068e637a-e3be-5f92-a484-ea2d9e3dc524" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467972} {:answer/id #uuid "e3ebd06a-49a6-522d-8839-e499931d4990" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467973}] :answer-field/correct {:answer/id #uuid "068e637a-e3be-5f92-a484-ea2d9e3dc524" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467972} :answer-field/id #uuid "e764c6f9-b95b-5630-b381-cb9920f27ccc" :answer-field/key "The function is continuous at $x=3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468707} {:answer-field/choices [{:answer/id #uuid "aab69a50-2292-506f-b480-9bd5efd798a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668691} {:answer/id #uuid "8a0ce50e-fea5-5117-ae07-9f8c14ff6691" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668692}] :answer-field/correct {:answer/id #uuid "aab69a50-2292-506f-b480-9bd5efd798a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668691} :answer-field/id #uuid "611a0010-a45b-5345-9bd9-589c115b0bb5" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668923}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "79464211-37d1-5cac-b164-284bb9d9308a" :question/math-academy-id "q-73105" :question/problem "![](images/ad/ad3fb8a0cce2a6dac706d7876aca0a2339fe49c05cb7aa6ae54de86735ceafab.png)\n\nWhich of the following statements are true regarding the function $y=f(x)$ plotted above?\n\nSelect all that apply." :question/worked-solution "Let's look at each statement in turn:\n\n- Statement “The function is left-continuous at $x=3$” is false. The function is not left-continuous at $x=3,$ since the left-sided limit is not equal to the function value:\n\n$$\n{lim}_{x\\to {3}^{-}}f(x)=3\\ne 1=f(3)\n$$\n\n- Statement “The function is right-continuous at $x=3$” is true. The function is right-continuous at $x=3,$ since the right-sided limit is equal to the function value:\n\n$$\n{lim}_{x\\to {3}^{+}}f(x)=1=f(3)\n$$\n\n- Statement “The function is continuous at $x=3$” is false. In order for the function to be continuous at $x=3,$ it must be both left-continuous and right-continuous. However, we have already determined that the function is not left-continuous at this point.\n\nIn conclusion, only statement “The function is right-continuous at $x=3$” is true."} {:db/id #edb/ref 17592186341909 :knowledge-point/_questions [{:db/id #edb/ref 17592186068700 :knowledge-point/id #uuid "81247553-750f-5bf7-a1c4-698ad63b5ae4" :knowledge-point/title "Identifying True Statements Regarding Left- and Right-Continuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a608917-3bf1-55b6-a1bb-215006677c7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467974} {:answer/id #uuid "92f6a6c0-fc6e-5d78-b192-ddfb75af8562" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467975}] :answer-field/correct {:answer/id #uuid "3a608917-3bf1-55b6-a1bb-215006677c7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467974} :answer-field/id #uuid "f3ad906d-0368-5141-9cec-66c6957d94f0" :answer-field/key "The function is left-continuous at $x=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468708} {:answer-field/choices [{:answer/id #uuid "0f047c94-ee38-5779-a5bd-6407415c9b57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467976} {:answer/id #uuid "6dc2bf8d-81a1-55ee-8642-345888a14521" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467977}] :answer-field/correct {:answer/id #uuid "0f047c94-ee38-5779-a5bd-6407415c9b57" :answe