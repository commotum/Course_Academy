d #uuid "08bc47ae-635a-5401-88ad-448e7833a2da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668611} {:answer/id #uuid "33b610b5-c9b9-5aee-bbe1-d5dd991e02cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668612}] :answer-field/correct {:answer/id #uuid "08bc47ae-635a-5401-88ad-448e7833a2da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668611} :answer-field/id #uuid "4fd81551-96ad-5200-96b9-b5e7551faeb4" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668883}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "113a385d-0512-508f-a50c-e45bc26c3c1f" :question/math-academy-id "q-34300" :question/problem "Which of the diagrams shown below represent subspaces of ${R}^{2}$ or ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Let's analyze each diagram in turn.\n\n- Diagram I represents a line that does not pass through the origin. But every subspace must contain the origin, so the line in Diagram I is not a subspace of ${R}^{2}.$\n\n- Diagram II is a line that passes through the origin. Therefore, it is a subspace of ${R}^{3}.$\n\n- Diagram III does not represent a subspace. The origin $0=\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}$ lies outside the subset.\n\nSo, the correct answer is diagram II only"} {:db/id #edb/ref 17592186317431 :knowledge-point/_questions [{:db/id #edb/ref 17592186231429 :knowledge-point/id #uuid "cac41120-247d-5821-b7f6-b342dbcf8f18" :knowledge-point/title "Identifying Solutions to Forced Harmonic Motion Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f62d1759-0498-58c4-ab55-caa874c6319e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467268} {:answer/id #uuid "d1649d8f-ee2f-5778-b299-fa2795a13fbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467269}] :answer-field/correct {:answer/id #uuid "d1649d8f-ee2f-5778-b299-fa2795a13fbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467269} :answer-field/id #uuid "2d72ca48-f0c0-538a-84c8-10419eca178e" :answer-field/key "$y$ $=R\\operatorname{cos}⁡(3t+ϕ)$ $+\\frac{1}{2}t\\operatorname{cos}⁡(3t)$ $-2t\\operatorname{sin}⁡(3t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468355} {:answer-field/choices [{:answer/id #uuid "ce9985f7-ada6-59aa-9213-ea46b2f0103a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467270} {:answer/id #uuid "2b5c8f3b-63a5-5160-a7b3-de3cdcbe35f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467271}] :answer-field/correct {:answer/id #uuid "2b5c8f3b-63a5-5160-a7b3-de3cdcbe35f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467271} :answer-field/id #uuid "c70a8fc2-cc6d-5e11-8840-935b2c760d12" :answer-field/key "$y$ $=R\\operatorname{sin}⁡(3t+ϕ)$ $+\\frac{1}{2}t\\operatorname{cos}⁡(3t)$ $-2t\\operatorname{sin}⁡(3t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468356} {:answer-field/choices [{:answer/id #uuid "891fbb34-02a0-5178-be8c-59a9c40ccee8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467272} {:answer/id #uuid "b5910d95-689b-5498-970e-cb215a933405" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467273}] :answer-field/correct {:answer/id #uuid "b5910d95-689b-5498-970e-cb215a933405" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467273} :answer-field/id #uuid "1174ed98-32d3-5eef-b1f3-eb94a6edeefc" :answer-field/key "$y$ $=A\\operatorname{cos}⁡(3t)$ $+B\\operatorname{sin}⁡(3t)$ $+\\frac{1}{2}t\\operatorname{cos}⁡(3t)$ $-2t\\operatorname{sin}⁡(3t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468357} {:answer-field/choices [{:answer/id #uuid "0801883c-e06f-5bcb-94ad-9475d6c0d083" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668613} {:answer/id #uuid "dbaf67e7-ce8b-5385-8360-8e802084d2b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668614}] :answer-field/correct {:answer/id #uuid "0801883c-e06f-5bcb-94ad-9475d6c0d083" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668613} :answer-field/id #uuid "0e5f9f85-7184-574b-8dbc-f647962e07be" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668884}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ceda7f80-0812-553b-8a96-78a8d37d4fb1" :question/math-academy-id "q-343761" :question/problem "A particle is moving with forced harmonic motion without damping. The particle is acted on by an external periodic force\n$f(t)=-12\\operatorname{cos}⁡(3t)-3\\operatorname{sin}⁡(3t).$\nAssuming the system experiences resonance, which of the following could be used to represent the general solution for the position $y(t)?$\n\nNote that $A,$ $B,$ $R,$ and $ϕ$ are constants.\n\nSelect all that apply." :question/worked-solution "Because the motion is undamped and the system experiences resonance, the forcing frequency equals the natural frequency $\\omega .$\n\nThe external force is $f(t)=-12\\operatorname{cos}⁡(3t)-3\\operatorname{sin}⁡(3t),$ which is sinusoidal with frequency $3.$ Therefore,\n$\\omega =3.$\n\nThe complementary solution for the associated simple harmonic motion equation can be written in three different forms:\n\n1\\. ${y}_{c}=R\\operatorname{cos}⁡(\\omega t+ϕ)=R\\operatorname{cos}⁡(3t+ϕ)$\n\n2\\. ${y}_{c}=R\\operatorname{sin}⁡(\\omega t+ϕ)=R\\operatorname{sin}⁡(3t+ϕ)$\n\n3\\. ${y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t=A\\operatorname{cos}⁡(3t)+B\\operatorname{sin}⁡(3t)$\n\nAt resonance, a sinusoidal trial at frequency $\\omega $ duplicates the complementary solution, so we multiply by $t$ and take a resonant particular solution of the form\n\n$$\n{y}_{p}(t)=t(C\\operatorname{cos}⁡(3t)+D\\operatorname{sin}⁡(3t)).\n$$\n\nBy substituting the particular solution and $\\omega =3$ into the differential equation, ${y}^{″}+{\\omega }^{2}y=f(t),$ we get \n\n$$\n\\begin{aligned}[(6D-9Ct)\\operatorname{cos}⁡(3t)-(6C+9Dt)\\operatorname{sin}⁡(3t)]+9t(C\\operatorname{cos}⁡(3t)+D\\operatorname{sin}⁡(3t)) & =-12\\operatorname{cos}⁡(3t)-3\\operatorname{sin}⁡(3t) \\\\ 6D\\operatorname{cos}⁡(3t)-6C\\operatorname{sin}⁡(3t) & =-12\\operatorname{cos}⁡(3t)-3\\operatorname{sin}⁡(3t)\\end{aligned}\n$$\n\nEquating coefficients, $C=\\frac{1}{2}$ and $D=-2.$ \n\nSo, the particular solution is\n\n$$\n{y}_{p}(t)=\\frac{1}{2}t\\operatorname{cos}⁡(3t)-2t\\operatorname{sin}⁡(3t).\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n1\\. $y$ $=R\\operatorname{cos}⁡(3t+ϕ)$ $+\\frac{1}{2}t\\operatorname{cos}⁡(3t)$ $-2t\\operatorname{sin}⁡(3t)$\n\n2\\. $y$ $=R\\operatorname{sin}⁡(3t+ϕ)$ $+\\frac{1}{2}t\\operatorname{cos}⁡(3t)$ $-2t\\operatorname{sin}⁡(3t)$\n\n3\\. $y$ $=A\\operatorname{cos}⁡(3t)$ $+B\\operatorname{sin}⁡(3t)$ $+\\frac{1}{2}t\\operatorname{cos}⁡(3t)$ $-2t\\operatorname{sin}⁡(3t)$\n\nSolutions $y$ $=R\\operatorname{cos}⁡(3t+ϕ)$ $+\\frac{1}{2}t\\operatorname{cos}⁡(3t)$ $-2t\\operatorname{sin}⁡(3t)$, $y$ $=R\\operatorname{sin}⁡(3t+ϕ)$ $+\\frac{1}{2}t\\operatorname{cos}⁡(3t)$ $-2t\\operatorname{sin}⁡(3t)$, and $y$ $=A\\operatorname{cos}⁡(3t)$ $+B\\operatorname{sin}⁡(3t)$ $+\\frac{1}{2}t\\operatorname{cos}⁡(3t)$ $-2t\\operatorname{sin}⁡(3t)$ match the forms above.\nTherefore, the correct answer is $y$ $=R\\operatorname{cos}⁡(3t+ϕ)$ $+\\frac{1}{2}t\\operatorname{cos}⁡(3t)$ $-2t\\operatorname{sin}⁡(3t)$; $y$ $=R\\operatorname{sin}⁡(3t+ϕ)$ $+\\frac{1}{2}t\\operatorname{cos}⁡(3t)$ $-2t\\operatorname{sin}⁡(3t)$; $y$ $=A\\operatorname{cos}⁡(3t)$ $+B\\operatorname{sin}⁡(3t)$ $+\\frac{1}{2}t\\operatorname{cos}⁡(3t)$ $-2t\\operatorname{sin}⁡(3t)$."} {:db/id #edb/ref 17592186317432 :knowledge-point/_questions [{:db/id #edb/ref 17592186231429 :knowledge-point/id #uuid "cac41120-247d-5821-b7f6-b342dbcf8f18" :knowledge-point/title "Identifying Solutions to Forced Harmonic Motion Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2e62c72-eded-5251-b82c-a13d292823c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467274} {:answer/id #uuid "9fb19eae-ca8e-5045-ac0b-02fb0e26ab98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467275}] :answer-field/correct {:answer/id #uuid "9fb19eae-ca8e-5045-ac0b-02fb0e26ab98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467275} :answer-field/id #uuid "02a5b1b5-2edc-57f9-8e94-8a8cfee97bf6" :answer-field/key "$y=R\\operatorname{cos}⁡(5t+ϕ)+\\frac{4}{5}t\\operatorname{cos}⁡(5t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468358} {:answer-field/choices [{:answer/id #uuid "3e4ce250-d6fe-5c49-815c-c76f72ac39fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467276} {:answer/id #uuid "4728d8f9-b0e2-58cc-9643-baef6b9acf1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467277}] :answer-field/correct {:answer/id #uuid "4728d8f9-b0e2-58cc-9643-baef6b9acf1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467277} :answer-field/id #uuid "02f5f7a4-dd66-5a2d-84ea-dc6d67d5ea40" :answer-field/key "$y=R\\operatorname{sin}⁡(5t+ϕ)+\\frac{4}{5}t\\operatorname{cos}⁡(5t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468359} {:answer-field/choices [{:answer/id #uuid "3e31d498-a889-5e2d-92ad-8d9f6917a513" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467278} {:answer/id #uuid "337baf08-590c-5adb-893e-b9abba1a49e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467279}] :answer-field/correct {:answer/id #uuid "337baf08-590c-5adb-893e-b9abba1a49e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467279} :answer-field/id #uuid "ae837c68-e797-51f7-9e34-a00bf88b7f3b" :answer-field/key "$y$ $=A\\operatorname{cos}⁡(5t)$ $+B\\operatorname{sin}⁡(5t)$ $+\\frac{4}{5}t\\operatorname{cos}⁡(5t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468360} {:answer-field/choices [{:answer/id #uuid "7e58fb70-4b7e-5a27-8669-10dd17c7540a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668615} {:answer/id #uuid "29856bfd-eef2-51c7-b5d1-aa4baeb7f7af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668616}] :answer-field/correct {:answer/id #uuid "7e58fb70-4b7e-5a27-8669-10dd17c7540a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668615} :answer-field/id #uuid "bd69f45d-0de0-5c0b-a97b-70e58dd04aea" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668885}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b4e3c955-6b4a-5e2d-8d23-b51d3a994a7d" :question/math-academy-id "q-343763" :question/problem "A particle is moving with forced harmonic motion without damping. The particle is acted on by an external periodic force\n$f(t)=-8\\operatorname{sin}⁡(5t).$\nAssuming the system experiences resonance, which of the following could be used to represent the general solution for the position $y(t)?$\n\nNote that $A,$ $B,$ $R,$ and $ϕ$ are constants.\n\nSelect all that apply." :question/worked-solution "Because the motion is undamped and the system experiences resonance, the forcing frequency equals the natural frequency $\\omega .$\n\nThe external force is $f(t)=-8\\operatorname{sin}⁡(5t),$ which is sinusoidal with frequency $5.$ Therefore,\n$\\omega =5.$\n\nThe complementary solution for the associated simple harmonic motion equation can be written in three different forms:\n\n1\\. ${y}_{c}=R\\operatorname{cos}⁡(\\omega t+ϕ)=R\\operatorname{cos}⁡(5t+ϕ)$\n\n2\\. ${y}_{c}=R\\operatorname{sin}⁡(\\omega t+ϕ)=R\\operatorname{sin}⁡(5t+ϕ)$\n\n3\\. ${y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t=A\\operatorname{cos}⁡(5t)+B\\operatorname{sin}⁡(5t)$\n\nAt resonance, a sinusoidal trial at frequency $\\omega $ duplicates the complementary solution, so we multiply by $t$ and take a resonant particular solution of the form\n\n$$\n{y}_{p}(t)=t(C\\operatorname{cos}⁡(5t)+D\\operatorname{sin}⁡(5t)).\n$$\n\nBy substituting the particular solution and $\\omega =5$ into the differential equation, ${y}^{″}+{\\omega }^{2}y=f(t),$ we get \n\n$$\n\\begin{aligned}[(10D-25Ct)\\operatorname{cos}⁡(5t)-(10C+25Dt)\\operatorname{sin}⁡(5t)]+25t(C\\operatorname{cos}⁡(5t)+D\\operatorname{sin}⁡(5t)) & =-8\\operatorname{sin}⁡(5t) \\\\ 10D\\operatorname{cos}⁡(5t)-10C\\operatorname{sin}⁡(5t) & =-8\\operatorname{sin}⁡(5t)\\end{aligned}\n$$\n\nEquating coefficients, $C=\\frac{4}{5}$ and $D=0.$ \n\nSo, the particular solution is\n\n$$\n{y}_{p}(t)=\\frac{4}{5}t\\operatorname{cos}⁡(5t).\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n1\\. $y=R\\operatorname{cos}⁡(5t+ϕ)+\\frac{4}{5}t\\operatorname{cos}⁡(5t)$\n\n2\\. $y=R\\operatorname{sin}⁡(5t+ϕ)+\\frac{4}{5}t\\operatorname{cos}⁡(5t)$\n\n3\\. $y$ $=A\\operatorname{cos}⁡(5t)$ $+B\\operatorname{sin}⁡(5t)$ $+\\frac{4}{5}t\\operatorname{cos}⁡(5t)$\n\nSolutions $y=R\\operatorname{cos}⁡(5t+ϕ)+\\frac{4}{5}t\\operatorname{cos}⁡(5t)$, $y=R\\operatorname{sin}⁡(5t+ϕ)+\\frac{4}{5}t\\operatorname{cos}⁡(5t)$, and $y$ $=A\\operatorname{cos}⁡(5t)$ $+B\\operatorname{sin}⁡(5t)$ $+\\frac{4}{5}t\\operatorname{cos}⁡(5t)$ match the forms above.\nTherefore, the correct answer is $y=R\\operatorname{cos}⁡(5t+ϕ)+\\frac{4}{5}t\\operatorname{cos}⁡(5t)$; $y=R\\operatorname{sin}⁡(5t+ϕ)+\\frac{4}{5}t\\operatorname{cos}⁡(5t)$; $y$ $=A\\operatorname{cos}⁡(5t)$ $+B\\operatorname{sin}⁡(5t)$ $+\\frac{4}{5}t\\operatorname{cos}⁡(5t)$."} {:db/id #edb/ref 17592186317433 :knowledge-point/_questions [{:db/id #edb/ref 17592186231429 :knowledge-point/id #uuid "cac41120-247d-5821-b7f6-b342dbcf8f18" :knowledge-point/title "Identifying Solutions to Forced Harmonic Motion Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8deee66-8faa-5103-9ffb-a0528de31c35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467280} {:answer/id #uuid "8efe3b1c-13b5-58c1-8319-811c069ec943" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467281}] :answer-field/correct {:answer/id #uuid "8efe3b1c-13b5-58c1-8319-811c069ec943" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467281} :answer-field/id #uuid "791e5bec-2bbe-5ef0-be17-7936c37a397d" :answer-field/key "$y=R\\operatorname{cos}⁡(3t+ϕ)+\\frac{5}{3}t\\operatorname{sin}⁡(3t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468361} {:answer-field/choices [{:answer/id #uuid "4b11162f-ed10-562f-a582-635aca5f072e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467282} {:answer/id #uuid "c1df0d29-07b6-5d2b-a737-504fb58038dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467283}] :answer-field/correct {:answer/id #uuid "c1df0d29-07b6-5d2b-a737-504fb58038dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467283} :answer-field/id #uuid "930db752-9805-5bd5-8731-4cec255544bb" :answer-field/key "$y=R\\operatorname{sin}⁡(3t+ϕ)+\\frac{5}{3}t\\operatorname{sin}⁡(3t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468362} {:answer-field/choices [{:answer/id #uuid "db48d1bd-0f55-5b7e-8868-e1d284da68cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467284} {:answer/id #uuid "1a443ce3-df82-501c-a748-ef96d7ff6e86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467285}] :answer-field/correct {:answer/id #uuid "1a443ce3-df82-501c-a748-ef96d7ff6e86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467285} :answer-field/id #uuid "80f14578-0fa8-5566-9fd0-14c07a82fade" :answer-field/key "$y$ $=A\\operatorname{cos}⁡(3t)$ $+B\\operatorname{sin}⁡(3t)$ $+\\frac{5}{3}t\\operatorname{sin}⁡(3t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468363} {:answer-field/choices [{:answer/id #uuid "850589cc-5012-5472-af95-67773c8124c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668617} {:answer/id #uuid "b0111823-9d42-5f13-9ea4-c672702ef26e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668618}] :answer-field/correct {:answer/id #uuid "850589cc-5012-5472-af95-67773c8124c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668617} :answer-field/id #uuid "57449f04-e5d1-534b-842b-3df9ec8a7d29" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668886}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7120fcf0-d3de-513a-93a7-21786701d7c0" :question/math-academy-id "q-343764" :question/problem "A particle is moving with forced harmonic motion without damping. The particle is acted on by an external periodic force\n$f(t)=10\\operatorname{cos}⁡(3t).$\nAssuming the system experiences resonance, which of the following could be used to represent the general solution for the position $y(t)?$\n\nNote that $A,$ $B,$ $R,$ and $ϕ$ are constants.\n\nSelect all that apply." :question/worked-solution "Because the motion is undamped and the system experiences resonance, the forcing frequency equals the natural frequency $\\omega .$\n\nThe external force is $f(t)=10\\operatorname{cos}⁡(3t),$ which is sinusoidal with frequency $3.$ Therefore,\n$\\omega =3.$\n\nThe complementary solution for the associated simple harmonic motion equation can be written in three different forms:\n\n1\\. ${y}_{c}=R\\operatorname{cos}⁡(\\omega t+ϕ)=R\\operatorname{cos}⁡(3t+ϕ)$\n\n2\\. ${y}_{c}=R\\operatorname{sin}⁡(\\omega t+ϕ)=R\\operatorname{sin}⁡(3t+ϕ)$\n\n3\\. ${y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t=A\\operatorname{cos}⁡(3t)+B\\operatorname{sin}⁡(3t)$\n\nAt resonance, a sinusoidal trial at frequency $\\omega $ duplicates the complementary solution, so we multiply by $t$ and take a resonant particular solution of the form\n\n$$\n{y}_{p}(t)=t(C\\operatorname{cos}⁡(3t)+D\\operatorname{sin}⁡(3t)).\n$$\n\nBy substituting the particular solution and $\\omega =3$ into the differential equation, ${y}^{″}+{\\omega }^{2}y=f(t),$ we get \n\n$$\n\\begin{aligned}[(6D-9Ct)\\operatorname{cos}⁡(3t)-(6C+9Dt)\\operatorname{sin}⁡(3t)]+9t(C\\operatorname{cos}⁡(3t)+D\\operatorname{sin}⁡(3t)) & =10\\operatorname{cos}⁡(3t) \\\\ 6D\\operatorname{cos}⁡(3t)-6C\\operatorname{sin}⁡(3t) & =10\\operatorname{cos}⁡(3t)\\end{aligned}\n$$\n\nEquating coefficients, $C=0$ and $D=\\frac{5}{3}.$ \n\nSo, the particular solution is\n\n$$\n{y}_{p}(t)=\\frac{5}{3}t\\operatorname{sin}⁡(3t).\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n1\\. $y=R\\operatorname{cos}⁡(3t+ϕ)+\\frac{5}{3}t\\operatorname{sin}⁡(3t)$\n\n2\\. $y=R\\operatorname{sin}⁡(3t+ϕ)+\\frac{5}{3}t\\operatorname{sin}⁡(3t)$\n\n3\\. $y$ $=A\\operatorname{cos}⁡(3t)$ $+B\\operatorname{sin}⁡(3t)$ $+\\frac{5}{3}t\\operatorname{sin}⁡(3t)$\n\nSolutions $y=R\\operatorname{cos}⁡(3t+ϕ)+\\frac{5}{3}t\\operatorname{sin}⁡(3t)$, $y=R\\operatorname{sin}⁡(3t+ϕ)+\\frac{5}{3}t\\operatorname{sin}⁡(3t)$, and $y$ $=A\\operatorname{cos}⁡(3t)$ $+B\\operatorname{sin}⁡(3t)$ $+\\frac{5}{3}t\\operatorname{sin}⁡(3t)$ match the forms above.\nTherefore, the correct answer is $y=R\\operatorname{cos}⁡(3t+ϕ)+\\frac{5}{3}t\\operatorname{sin}⁡(3t)$; $y=R\\operatorname{sin}⁡(3t+ϕ)+\\frac{5}{3}t\\operatorname{sin}⁡(3t)$; $y$ $=A\\operatorname{cos}⁡(3t)$ $+B\\operatorname{sin}⁡(3t)$ $+\\frac{5}{3}t\\operatorname{sin}⁡(3t)$."} {:db/id #edb/ref 17592186319150 :knowledge-point/_questions [{:db/id #edb/ref 17592186119925 :knowledge-point/id #uuid "52a45814-d1e2-5948-b7bd-69dcaf6cd0eb" :knowledge-point/title "Identifying Linearly Independent and Dependent Sets Using Row Reduction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dfbe41c-73e7-5f56-8ce0-fab54ad50616" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467286} {:answer/id #uuid "f341d81e-bf26-5210-b2f0-54763ec31dc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467287}] :answer-field/correct {:answer/id #uuid "f341d81e-bf26-5210-b2f0-54763ec31dc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467287} :answer-field/id #uuid "cf382855-5600-5598-8164-5bd2d028dbce" :answer-field/key "The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has an infinite number of nonzero solutions." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468364} {:answer-field/choices [{:answer/id #uuid "5748a03b-cb2b-5a33-8622-5e3f40a35b20" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467288} {:answer/id #uuid "114a823e-72e5-59c8-8d1c-742efeb3c793" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467289}] :answer-field/correct {:answer/id #uuid "5748a03b-cb2b-5a33-8622-5e3f40a35b20" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467288} :answer-field/id #uuid "a8ad6860-dfb4-5757-801b-d9850857f91a" :answer-field/key "The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468365} {:answer-field/choices [{:answer/id #uuid "861d0168-10b8-592b-ae21-e0ad86936c5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467290} {:answer/id #uuid "8b18b4b9-7ea2-5329-bec7-e618d7c6db3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467291}] :answer-field/correct {:answer/id #uuid "8b18b4b9-7ea2-5329-bec7-e618d7c6db3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467291} :answer-field/id #uuid "e64595f5-23c8-52a5-9fe4-2c3e7d56935c" :answer-field/key "The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468366} {:answer-field/choices [{:answer/id #uuid "c5708e06-a3e5-5159-99d8-b2272c60e24a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668619} {:answer/id #uuid "8c4d1d36-eeaa-5058-853e-82e5379c5be3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668620}] :answer-field/correct {:answer/id #uuid "c5708e06-a3e5-5159-99d8-b2272c60e24a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668619} :answer-field/id #uuid "65f7c0d9-3efa-5564-8558-114d17a00978" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668887}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0c6e61ad-5f9a-5a1b-a420-c0ce7a3cc35c" :question/math-academy-id "q-34700" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=\\begin{bmatrix}2 \\\\ -1 \\\\ 0\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-4 \\\\ 6 \\\\ -2\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}2 \\\\ 3 \\\\ -2\\end{bmatrix}.\n$$\n\nAssume that ${x}_{1},{x}_{2},$ and ${x}_{3}$ are real numbers. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system\n\n$$\n\\left\\{\\begin{aligned}2{x}_{1}-4{x}_{2}+2{x}_{3} &=0 \\\\ -{x}_{1}+6{x}_{2}+3{x}_{3} &=0 \\\\ -2{x}_{2}-2{x}_{3} &=0.\\end{aligned}\\right.\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & -4 & 2 & 0 \\\\ -1 & 6 & 3 & 0 \\\\ 0 & -2 & -2 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -4 & 2 & 0 \\\\ 0 & 4 & 4 & 0 \\\\ 0 & -2 & -2 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{2} \\\\  & ∼\\begin{bmatrix}2 & -4 & 2 & 0 \\\\ 0 & 4 & 4 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nFrom the matrix above, we conclude that the basic variables are ${x}_{1}$ and ${x}_{2}$, while ${x}_{3}$ is the free variable. \n\nSince there is one free variable, the equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has an infinite number of nonzero solutions, which means that the vectors are linearly dependent. \n\nTherefore, statement “The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent” is false, while statements “The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has an infinite number of nonzero solutions” and “The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent” are true."} {:db/id #edb/ref 17592186319157 :knowledge-point/_questions [{:db/id #edb/ref 17592186119925 :knowledge-point/id #uuid "52a45814-d1e2-5948-b7bd-69dcaf6cd0eb" :knowledge-point/title "Identifying Linearly Independent and Dependent Sets Using Row Reduction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae02702d-cbaa-5d1a-aa13-b56e62ddc9bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467292} {:answer/id #uuid "8beff570-6962-575d-83e8-fba6dd1988f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467293}] :answer-field/correct {:answer/id #uuid "8beff570-6962-575d-83e8-fba6dd1988f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467293} :answer-field/id #uuid "fa0b3013-1ffe-5f8b-9931-4aa005775eb9" :answer-field/key "The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has only the trivial solution ${x}_{1}={x}_{2}={x}_{3}=0.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468367} {:answer-field/choices [{:answer/id #uuid "8bf5efc0-d0b0-5ab3-9ccc-0f8c702a8c55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467294} {:answer/id #uuid "16afad4c-9e4f-5af8-9660-d5618a99eb7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467295}] :answer-field/correct {:answer/id #uuid "8bf5efc0-d0b0-5ab3-9ccc-0f8c702a8c55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467294} :answer-field/id #uuid "7f0fc8a3-12a0-5de6-975a-2b93da0b8887" :answer-field/key "The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468368} {:answer-field/choices [{:answer/id #uuid "c50196f4-ea00-5775-b667-c59254cbbc4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467296} {:answer/id #uuid "b5af3771-12a3-55ad-b5c8-8f960c1dfa83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467297}] :answer-field/correct {:answer/id #uuid "b5af3771-12a3-55ad-b5c8-8f960c1dfa83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467297} :answer-field/id #uuid "496267ed-e481-5779-8831-27ec9128e7bf" :answer-field/key "The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468369} {:answer-field/choices [{:answer/id #uuid "bd4c2787-d0c1-564e-a437-28d9b6282249" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668621} {:answer/id #uuid "db0470c2-12ac-53c3-8ca1-e608a1b4a09d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668622}] :answer-field/correct {:answer/id #uuid "bd4c2787-d0c1-564e-a437-28d9b6282249" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668621} :answer-field/id #uuid "eb48b3d4-fc15-569b-a755-b2995ddab156" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668888}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b1abddd4-93e9-501d-bf47-b8161bdb88cb" :question/math-academy-id "q-34714" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ -2 \\\\ 3\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}1 \\\\ -1 \\\\ 3\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix}.\n$$\n\nAssume that ${x}_{1},{x}_{2},$ and ${x}_{3}$ are real numbers. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2} &=0 \\\\ -2{x}_{1}-{x}_{2}+{x}_{3} &=0 \\\\ 3{x}_{1}+3{x}_{2}+{x}_{3} &=0.\\end{aligned}\\right.\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 1 & 0 & 0 \\\\ -2 & -1 & 1 & 0 \\\\ 3 & 3 & 1 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & 0 & 0 \\\\ 0 & 1 & 1 & 0 \\\\ 3 & 3 & 1 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-3){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 1 & 0 & 0 \\\\ 0 & 1 & 1 & 0 \\\\ 0 & 0 & 1 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nSo, the system is now\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2} &=0 \\\\ {x}_{2}+{x}_{3} &=0 \\\\ {x}_{3} &=0.\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get ${x}_{3}=0.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}+(0)=0\\,⟹\\,{x}_{2}=0\n$$\n\nand, substituting this into the first equation, we obtain\n\n$$\n{x}_{1}+(0)=0\\,⟹\\,{x}_{1}=0.\n$$\n\nSince ${x}_{1}={x}_{2}={x}_{3}=0$, we get that the set ${{a}_{1},{a}_{2},{a}_{3}}$ is linearly independent.\n\nTherefore, statements “The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has only the trivial solution ${x}_{1}={x}_{2}={x}_{3}=0.$” and “The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent” are true, while statement “The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent” is false."} {:db/id #edb/ref 17592186319199 :knowledge-point/_questions [{:db/id #edb/ref 17592186124490 :knowledge-point/id #uuid "ca956d3e-37a8-5f0f-a062-97d0567d54e6" :knowledge-point/title "Identifying True Statements About Bases of Abstract Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26f0f70b-01ad-54d8-8ebf-898c5fe4a5ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467298} {:answer/id #uuid "fb802504-b985-574f-8a9d-3bec9d243fe1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467299}] :answer-field/correct {:answer/id #uuid "26f0f70b-01ad-54d8-8ebf-898c5fe4a5ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467298} :answer-field/id #uuid "1e9feac7-9064-55a0-bfec-cd6e08f02bc2" :answer-field/key "${{c}_{1},{c}_{2},x}$ is a basis of ${R}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468370} {:answer-field/choices [{:answer/id #uuid "899ffc4b-f3bc-5a5a-b2b2-a4baa23129c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467300} {:answer/id #uuid "49992a1c-d3d1-51dc-acc4-0664a7fe647f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467301}] :answer-field/correct {:answer/id #uuid "899ffc4b-f3bc-5a5a-b2b2-a4baa23129c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467300} :answer-field/id #uuid "e01f4bda-c99b-5a8d-abab-2d7127981cca" :answer-field/key "${{b}_{3},{b}_{1},{b}_{1}+{b}_{3}}$ is a basis of ${R}^{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468371} {:answer-field/choices [{:answer/id #uuid "288f07a5-4416-53ed-8a09-84f609c31a09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467302} {:answer/id #uuid "3e5dced2-a28c-53a7-be07-84415c967344" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467303}] :answer-field/correct {:answer/id #uuid "288f07a5-4416-53ed-8a09-84f609c31a09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467302} :answer-field/id #uuid "353db63d-6718-5fd5-b88a-f76be029806b" :answer-field/key "${x,{b}_{2},{c}_{1}}$ is a basis of ${R}^{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468372} {:answer-field/choices [{:answer/id #uuid "e32a22e2-e828-54d1-bce9-e2e4de9dfa84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668623} {:answer/id #uuid "7699dec6-1dc0-5575-b676-aeae9a87451d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668624}] :answer-field/correct {:answer/id #uuid "7699dec6-1dc0-5575-b676-aeae9a87451d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668624} :answer-field/id #uuid "93dcc7aa-6c96-5347-8048-a8b2f6387c0d" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668889}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4fa1c1b6-aa0b-5eb1-b0a4-3972a58dc98e" :question/math-academy-id "q-34768" :question/problem "Let $B={{b}_{1},{b}_{2},{b}_{3}}$ and $C={{c}_{1},{c}_{2}}$ be bases of ${R}^{3}$ and ${R}^{2}$, respectively. \n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Since $B$ and $C$ are bases, the following properties must hold:\n\n- $B$ and $C$ are maximally linearly independent sets in ${R}^{2}$ and ${R}^{3},$ respectively, and\n\n- $B$ spans ${R}^{3},$ while $C$ spans ${R}^{2}.$\n\nWith that in mind, let's examine our statements.\n\n- Statement “${{c}_{1},{c}_{2},x}$ is a basis of ${R}^{2}$” is false. Since $C={{c}_{1},{c}_{2}}$ is a basis of ${R}^{2}$, any vector of ${R}^{2},$ including the given vector $x,$ can be written as a linear combination of ${c}_{1}$ and ${c}_{2}.$ This means that ${{c}_{1},{c}_{2},x}$ is linearly dependent and therefore, cannot be a basis.\n\n- Statement “${{b}_{3},{b}_{1},{b}_{1}+{b}_{3}}$ is a basis of ${R}^{3}$” is false. The set ${{b}_{3},{b}_{1},{b}_{1}+{b}_{3}}$ is not a basis of ${R}^{3}$ because the third vector is a linear combination of ${b}_{3}$ and ${b}_{1}.$ This means that the set is linearly dependent and therefore, cannot be a basis.\n\n- Statement “${x,{b}_{2},{c}_{1}}$ is a basis of ${R}^{3}$” is false. The set ${x,{b}_{2},{c}_{1}}$ is not a basis of ${R}^{3}$ because the set contains vectors from another vector space.\n\nTherefore, the correct answer is \"None of the statements are true\"."} {:db/id #edb/ref 17592186321014 :knowledge-point/_questions [{:db/id #edb/ref 17592186124490 :knowledge-point/id #uuid "ca956d3e-37a8-5f0f-a062-97d0567d54e6" :knowledge-point/title "Identifying True Statements About Bases of Abstract Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49e71ad1-ea91-5baf-ac78-a0a822a0304d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467304} {:answer/id #uuid "23617b73-b0c1-56a3-94d8-5e95a1ec53e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467305}] :answer-field/correct {:answer/id #uuid "23617b73-b0c1-56a3-94d8-5e95a1ec53e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467305} :answer-field/id #uuid "f98b53cd-b6ce-5f24-81a4-7fdcfa0d6dcf" :answer-field/key "${{b}_{1},{b}_{2},{b}_{2}+{b}_{3}}$ is a basis of ${R}^{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468373} {:answer-field/choices [{:answer/id #uuid "8fa1b6d3-f46b-546a-b479-70f15e2991a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467306} {:answer/id #uuid "5b607205-ca72-5983-b64d-742e571d204a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467307}] :answer-field/correct {:answer/id #uuid "5b607205-ca72-5983-b64d-742e571d204a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467307} :answer-field/id #uuid "6bca7760-9dab-5b33-a4da-148b71b29bed" :answer-field/key "${3{c}_{2},{c}_{1}}$ is a basis of ${R}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468374} {:answer-field/choices [{:answer/id #uuid "c3aa2298-16cc-5a08-bf62-ff6520fa43f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467308} {:answer/id #uuid "da723a23-ee4b-5c25-9bd8-061a2e359b0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467309}] :answer-field/correct {:answer/id #uuid "c3aa2298-16cc-5a08-bf62-ff6520fa43f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467308} :answer-field/id #uuid "5a6e4e94-b485-52c8-b42a-9cc118288739" :answer-field/key "${{b}_{1},{b}_{2},{b}_{3},x}$ is a basis of ${R}^{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468375} {:answer-field/choices [{:answer/id #uuid "e37884fb-0a1c-5e43-8fdf-3b1c57051dc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668625} {:answer/id #uuid "5d7ed160-f770-507b-adcb-69857a1c32a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668626}] :answer-field/correct {:answer/id #uuid "e37884fb-0a1c-5e43-8fdf-3b1c57051dc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668625} :answer-field/id #uuid "f467f12e-21d4-50f2-8fce-41bc2c49519a" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668890}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d3cfa016-2023-56d8-80a8-ced31694c0b6" :question/math-academy-id "q-35263" :question/problem "Let $B={{b}_{1},{b}_{2},{b}_{3}}$ and $C={{c}_{1},{c}_{2}}$ be bases of ${R}^{3}$ and ${R}^{2}$, respectively. \n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Since $B$ and $C$ are bases, the following properties must hold:\n\n- $B$ and $C$ are maximally linearly independent sets in ${R}^{2}$ and ${R}^{3},$ respectively, and\n\n- $B$ spans ${R}^{2},$ while $C$ spans ${R}^{3}.$\n\nWith that in mind, let's examine our statements.\n\n- Statement “${{b}_{1},{b}_{2},{b}_{2}+{b}_{3}}$ is a basis of ${R}^{3}$” is true. Indeed, the equation\n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}({b}_{2}+{b}_{3}) & =0\\end{aligned}\n$$\n\nis equivalent to\n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+({x}_{2}+{x}_{3}){b}_{2}+{x}_{3}{b}_{3} & =0,\\end{aligned}\n$$\n\nwhich, since ${{b}_{1},{b}_{2},{b}_{3}}$ is linearly independent, gives\n\n$$\n\\left\\{\\begin{aligned}{x}_{1} &=0 \\\\ {x}_{2}+{x}_{3} &=0 \\\\ {x}_{3} &=0\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}{x}_{1} &=0 \\\\ {x}_{2} &=0 \\\\ {x}_{3} &=0.\\end{aligned}\\right.\n$$\n\nAlso, ${{b}_{1},{b}_{2},{b}_{2}+{b}_{3}}$ spans $V$ since any linear combination of vectors from $B$ can be expressed as a linear combination of ${{b}_{1},{b}_{2},{b}_{2}+{b}_{3}}:$\n\n$$\n{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3}={x}_{1}{b}_{1}+({x}_{2}-{x}_{3}){b}_{2}+{x}_{3}({b}_{2}+{b}_{3})\n$$\n\n- Statement “${3{c}_{2},{c}_{1}}$ is a basis of ${R}^{2}$” is true. Indeed, the equation\n\n$$\n\\begin{aligned}{x}_{1}(3{c}_{2})+{x}_{2}{c}_{1} & =0\\end{aligned}\n$$\n\nis equivalent to\n\n$$\n\\begin{aligned}(3{x}_{1}){c}_{2}+{x}_{2}{c}_{1} & =0,\\end{aligned}\n$$\n\nwhich, since ${{c}_{1},{c}_{2}}$ is linearly independent, gives\n\n$$\n\\left\\{\\begin{aligned}3{x}_{1} &=0 \\\\ {x}_{2} &=0\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}{x}_{1} &=0 \\\\ {x}_{2} &=0.\\end{aligned}\\right.\n$$\n\nAlso, ${3{c}_{2},{c}_{1}}$ spans $V$ since any linear combination of $C$ can be expressed as a linear combination of ${3{c}_{2},{c}_{1}}:$\n\n$$\n{x}_{1}{c}_{1}+{x}_{2}{c}_{2}={x}_{1}{c}_{1}+\\frac{{x}_{2}}{3}(3{c}_{2})\n$$\n\n- Statement “${{b}_{1},{b}_{2},{b}_{3},x}$ is a basis of ${R}^{3}$” is false. Since $B={{b}_{1},{b}_{2},{b}_{3}}$ is a basis of ${R}^{3}$, any vector of ${R}^{3},$ including the given vector $x,$ can be written as a linear combination of ${b}_{1},$ ${b}_{2}$ and ${b}_{3}.$ This means that ${{b}_{1},{b}_{2},{b}_{3},x}$ is linearly dependent and therefore, cannot be a basis.\n\nTherefore, the correct answer is “${{b}_{1},{b}_{2},{b}_{2}+{b}_{3}}$ is a basis of ${R}^{3}$”; “${3{c}_{2},{c}_{1}}$ is a basis of ${R}^{2}$” only."} {:db/id #edb/ref 17592186321043 :knowledge-point/_questions [{:db/id #edb/ref 17592186119848 :knowledge-point/id #uuid "1d847ec9-c379-5013-ab77-a9b92dc8ca27" :knowledge-point/title "Identifying the Matrix With a Given Rank by Inspection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c38e2b1e-6c94-5624-8794-4c613a255924" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467310} {:answer/id #uuid "5d54ebf0-003a-5f1c-bd7e-8c9967853943" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467311}] :answer-field/correct {:answer/id #uuid "c38e2b1e-6c94-5624-8794-4c613a255924" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467310} :answer-field/id #uuid "e26dd5b4-e353-584a-b82f-a7001a7ceafd" :answer-field/key "$A=\\begin{bmatrix}1 & 3 & 5 & 0 & 6 \\\\ 0 & 0 & 3 & 7 & 5 \\\\ 0 & 0 & 1 & 4 & 2 \\\\ 0 & 0 & 0 & 2 & 3 \\\\ 0 & 0 & 0 & 0 & 3 \\\\ 0 & 0 & 0 & 0 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468376} {:answer-field/choices [{:answer/id #uuid "80281206-d511-56fb-abc8-2ec2bd14982e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467312} {:answer/id #uuid "0ee50a33-bcd1-57ca-af8a-fea5667b18e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467313}] :answer-field/correct {:answer/id #uuid "80281206-d511-56fb-abc8-2ec2bd14982e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467312} :answer-field/id #uuid "2eb96f6f-4c8d-5ec7-a8ea-8d4572cc6d20" :answer-field/key "$B=\\begin{bmatrix}1 & 0 & 1 & 6 \\\\ 0 & 4 & 2 & -3 \\\\ 0 & 0 & 1 & -1 \\\\ 0 & 0 & 0 & 6 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468377} {:answer-field/choices [{:answer/id #uuid "b9723544-78fc-5712-9c8f-ca9dda43b954" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467314} {:answer/id #uuid "c1730f02-53e8-5c11-881b-06d6506cf09b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467315}] :answer-field/correct {:answer/id #uuid "c1730f02-53e8-5c11-881b-06d6506cf09b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467315} :answer-field/id #uuid "9a295ee6-c8e9-5be1-8d44-50156c244fcb" :answer-field/key "$C=\\begin{bmatrix}1 & 0 & 2 & 2 & 5 & 2 \\\\ 0 & 1 & 3 & 1 & 0 & 1 \\\\ 0 & 0 & 3 & 4 & 7 & 2 \\\\ 0 & 0 & 0 & 1 & 0 & 1 \\\\ 0 & 0 & 0 & 0 & 4 & 1 \\\\ 0 & 0 & 0 & 0 & 0 & 2\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468378} {:answer-field/choices [{:answer/id #uuid "e63fb83e-2f58-5939-8f3a-8cde5f664f93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668627} {:answer/id #uuid "74224d33-55c6-592e-88b0-75f43ae550bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668628}] :answer-field/correct {:answer/id #uuid "e63fb83e-2f58-5939-8f3a-8cde5f664f93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668627} :answer-field/id #uuid "01bc5a1c-98be-5bbb-a2ec-c3dadf9fdfb4" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668891}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "43599508-ddd2-50d6-b640-692e29bcfb0e" :question/math-academy-id "q-35283" :question/problem "Which of the following matrices have a rank of $6?$\n\nSelect all that apply." :question/worked-solution "First, notice that a matrix of rank $6$ must have at least $6$ columns and at least $6$ rows. \nSo, we disregard the matrix $A$ since it has only $5$ columns and the matrix $B$ since it has only $4$ columns.\n\nAlso, the matrix must have $6$ pivot columns. As we can see, the matrix $C$ has exactly $6$ pivot columns. So, $\\text{rank}(C)=6.$\n\nTherefore, the correct answer is \"$C$ only\"."} {:db/id #edb/ref 17592186323703 :knowledge-point/_questions [{:db/id #edb/ref 17592186192780 :knowledge-point/id #uuid "e3fe3596-340e-5155-bed3-cf25f5843d70" :knowledge-point/title "Identifying Whether Sets Represented Graphically Are Subspaces in Two-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0970f7c9-0267-5fd4-9880-d41ae3a79463" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/