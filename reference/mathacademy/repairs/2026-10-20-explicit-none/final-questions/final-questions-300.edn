04-500b-a841-77d0ae40552c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439997} :answer-field/id #uuid "81e0421e-636c-51a4-83fb-f74c8f1eae44" :answer-field/key "$x=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440356} {:answer-field/choices [{:answer/id #uuid "5a7580ab-5386-5dcd-92fd-0306b2bfc1e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668719} {:answer/id #uuid "815eec93-e015-5f93-a83b-b48b70c9e441" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668720}] :answer-field/correct {:answer/id #uuid "815eec93-e015-5f93-a83b-b48b70c9e441" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668720} :answer-field/id #uuid "8e8fe487-d986-550f-b434-f6b314bd80c1" :answer-field/key "The function has no vertical asymptotes" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668937}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d7fbfa1c-696c-569c-8a32-b9f903615eb9" :question/math-academy-id "q-80696" :question/problem "Determine the vertical asymptotes of $f(x)=\\frac{4x}{x({x}^{2}+1)}.$\n\nSelect all that apply." :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{4x}{x({x}^{2}+1)} \\\\  & =\\frac{4\\cancel{x}}{\\cancel{x}({x}^{2}+1)} \\\\  & =\\frac{4}{{x}^{2}+1}\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero:\n\n$$\n{x}^{2}+1=0\n$$\n\nThis equation does not have any real solutions. Therefore, $f(x)$ has no vertical asymptotes."} {:db/id #edb/ref 17592186351471 :knowledge-point/_questions [{:db/id #edb/ref 17592186087746 :knowledge-point/id #uuid "d8c04b23-e341-57e9-a072-985e4b536e5a" :knowledge-point/title "Identifying Linear Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae458531-3fea-5d4a-9fef-16784006df96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469290} {:answer/id #uuid "70a6a5c7-d36a-5ba3-beef-83d4658904d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469291}] :answer-field/correct {:answer/id #uuid "70a6a5c7-d36a-5ba3-beef-83d4658904d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469291} :answer-field/id #uuid "ab84475d-72cc-534c-be81-a6861c464c13" :answer-field/key "$T(kv)=kT(v)$ for any real $2\\times 1$ column vector $v$ and real scalar $k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470257} {:answer-field/choices [{:answer/id #uuid "3a743681-e458-539f-acc1-e7e101830b51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469292} {:answer/id #uuid "0d6b3d1d-d8b2-5500-997a-fadb43a18f4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469293}] :answer-field/correct {:answer/id #uuid "0d6b3d1d-d8b2-5500-997a-fadb43a18f4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469293} :answer-field/id #uuid "21f12b61-0b8f-58ec-be60-cd2667a6b36b" :answer-field/key "$T({v}_{1}+{v}_{2})=T({v}_{1})+T({v}_{2})$ for any real $2\\times 1$ column vectors ${v}_{1}$ and ${v}_{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470258} {:answer-field/choices [{:answer/id #uuid "4fdad23f-a509-5ce9-9efa-82f9ccbc40a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469294} {:answer/id #uuid "9cb92e59-8505-5e39-a0e2-9326bc50742f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469295}] :answer-field/correct {:answer/id #uuid "9cb92e59-8505-5e39-a0e2-9326bc50742f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469295} :answer-field/id #uuid "45138a1d-ce8d-542c-875e-b3141969f4d5" :answer-field/key "$T$ is a linear transformation" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470259} {:answer-field/choices [{:answer/id #uuid "c5e1f391-252a-5fde-b1fc-dbea1947fee6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668721} {:answer/id #uuid "fe104fdc-9ed2-56ca-833b-c2e58ae18d93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668722}] :answer-field/correct {:answer/id #uuid "c5e1f391-252a-5fde-b1fc-dbea1947fee6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668721} :answer-field/id #uuid "3d855db1-a9e3-51fd-aecb-0e039c81a179" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668938}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d21c33a8-a8c0-5b77-a079-4c787c111b5f" :question/math-academy-id "q-8296" :question/problem "Let \n$T:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}5x+2y \\\\ 3y\\end{bmatrix}.$\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A linear transformation $T$ satisfies two properties:\n\n$$\n\\begin{aligned} & T\\begin{bmatrix}kx \\\\ ky\\end{bmatrix}=kT\\begin{bmatrix}x \\\\ y\\end{bmatrix}, \\\\  & T\\begin{bmatrix}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{bmatrix}=T\\begin{bmatrix}{x}_{1} \\\\ {y}_{1}\\end{bmatrix}+T\\begin{bmatrix}{x}_{2} \\\\ {y}_{2}\\end{bmatrix}.\\end{aligned}\n$$\n\n- Checking the first condition, we have\n\n$$\n\\begin{aligned}T\\begin{bmatrix}kx \\\\ ky\\end{bmatrix} & =\\begin{bmatrix}5(kx)+2(ky) \\\\ 3(ky)\\end{bmatrix} \\\\  & =\\begin{bmatrix}k(5x+2y) \\\\ k(3y)\\end{bmatrix} \\\\  & =k\\begin{bmatrix}5x+2y \\\\ 3y\\end{bmatrix} \\\\  & =kT\\begin{bmatrix}x \\\\ y\\end{bmatrix}.\\,✓\\end{aligned}\n$$\n\n- Checking the second condition, we have\n\n$$\n\\begin{aligned}T\\begin{bmatrix}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{bmatrix} & =\\begin{bmatrix}5({x}_{1}+{x}_{2})+2({y}_{1}+{y}_{2}) \\\\ 3({y}_{1}+{y}_{2})\\end{bmatrix} \\\\  & =\\begin{bmatrix}5{x}_{1}+2{y}_{1} \\\\ 3{y}_{1}\\end{bmatrix}+\\begin{bmatrix}5{x}_{2}+2{y}_{2} \\\\ 3{y}_{2}\\end{bmatrix} \\\\  & =T\\begin{bmatrix}{x}_{1} \\\\ {y}_{1}\\end{bmatrix}+T\\begin{bmatrix}{x}_{2} \\\\ {y}_{2}\\end{bmatrix}.\\,✓\\end{aligned}\n$$\n\nTherefore, $\\text{T}$ is a linear transformation.\n\nAs a result, all three statements are true."} {:db/id #edb/ref 17592186351472 :knowledge-point/_questions [{:db/id #edb/ref 17592186087746 :knowledge-point/id #uuid "d8c04b23-e341-57e9-a072-985e4b536e5a" :knowledge-point/title "Identifying Linear Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "78f2bbb7-924e-519b-858e-8781702c24be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 1759218646929