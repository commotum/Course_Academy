5499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467348} :answer-field/id #uuid "7dee68bc-a430-5c4c-bd73-876dd575e220" :answer-field/key "${Z}^{-}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468395} {:answer-field/choices [{:answer/id #uuid "71c4fdc4-55b2-5820-b0a9-99b1ca6e5ff6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668635} {:answer/id #uuid "823d5350-40af-594c-a328-ff773852b753" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668636}] :answer-field/correct {:answer/id #uuid "71c4fdc4-55b2-5820-b0a9-99b1ca6e5ff6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668635} :answer-field/id #uuid "fda05a27-fe42-505f-9ca8-5d7630ca9caf" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668895}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4fc9ff9e-591c-5172-b83a-e2856d63bd94" :question/math-academy-id "q-36248" :question/problem "To which of the following sets do all the positive integers belong?\n\nSelect all that apply." :question/worked-solution "The positive integer numbers are $1,2,3,…$\n\n- Since all positive integer numbers are natural numbers, all the positive integers belong to $N.$ $\\,✓$\n\n- Since all positive integer numbers are positive real numbers, all the positive integer numbers belong to ${R}^{+}.$ $\\,✓$\n\n- The set ${Q}^{-}$ contains all the negative rational numbers. However, positive integer numbers as, for instance, $2$ don't belong to ${Q}^{-},$ so ${Q}^{-}$ does *not* contain the positive integer numbers. $\\,\\times $\n\n- The set ${Z}^{-}$ contains all the negative integer numbers. However, positive integer numbers as, for instance, $2$ don't belong to ${Z}^{-},$ so ${Z}^{-}$ does *not* contain the positive integer numbers. $\\,\\times $\n\nTherefore, the correct answer is “$N$ (natural numbers)”; ${R}^{+}$ only."} {:db/id #edb/ref 17592186323843 :knowledge-point/_questions [{:db/id #edb/ref 17592186105769 :knowledge-point/id #uuid "32467c2c-5605-50e9-b961-a29535a0effb" :knowledge-point/title "Identifying True Statements About Eigenvalues and Eigenvectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ed2777a-34cb-534d-a3c0-f46d98a7f57f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467350} {:answer/id #uuid "382ea96b-f840-5089-97ad-613a3c3ea86b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467351}] :answer-field/correct {:answer/id #uuid "382ea96b-f840-5089-97ad-613a3c3ea86b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467351} :answer-field/id #uuid "cf044f59-5458-5a3f-9122-e042b2ce2609" :answer-field/key "$v=\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}2 & 0 \\\\ -2 & 1\\end{bmatrix}$ that corresponds to the eigenvalue $2.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468396} {:answer-field/choices [{:answer/id #uuid "56892055-3446-54d3-b7c7-091f7041424b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467352} {:answer/id #uuid "97140039-2706-5181-86d8-83d99a14c98f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467353}] :answer-field/correct {:answer/id #uuid "56892055-3446-54d3-b7c7-091f7041424b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467352} :answer-field/id #uuid "1b33e161-c9a5-5c82-a2b4-80ffc8368590" :answer-field/key "If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $\\lambda =2,$ then $-v$ is an eigenvector of $A$ corresponding to $\\lambda =-2.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468397} {:answer-field/choices [{:answer/id #uuid "2c95eee0-8ca5-5722-b7c5-52773baa10a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467354} {:answer/id #uuid "af46bc38-7ce0-5c3a-9720-7658d86d8093" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467355}] :answer-field/correct {:answer/id #uuid "af46bc38-7ce0-5c3a-9720-7658d86d8093" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467355} :answer-field/id #uuid "d185ed44-db67-5969-a945-aa27c7caa20f" :answer-field/key "$v=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}$ that corresponds to the eigenvalue $0.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468398} {:answer-field/choices [{:answer/id #uuid "3c89ebac-ac2d-5c9f-bc9a-0a3ab34ef7f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668637} {:answer/id #uuid "74026c27-de20-575e-8af0-447442b6de46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668638}] :answer-field/correct {:answer/id #uuid "3c89ebac-ac2d-5c9f-bc9a-0a3ab34ef7f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668637} :answer-field/id #uuid "d31707d5-8a24-5048-ad0d-df8b512b53f5" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668896}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "187c7a1d-e687-5fd7-b36a-8bd4869c300f" :question/math-academy-id "q-36678" :question/problem "Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ With that in mind, let's examine the statements one by one.\n\n- Statement “$v=\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}2 & 0 \\\\ -2 & 1\\end{bmatrix}$ that corresponds to the eigenvalue $2.$” is true. We have \n\n$$\n\\begin{aligned}Av & =\\begin{bmatrix}2 & 0 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}1 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ -4\\end{bmatrix} \\\\  & =2\\begin{bmatrix}1 \\\\ -2\\end{bmatrix} \\\\  & =2v.\\end{aligned}\n$$\n\nSince $Av=2v,$ we conclude that $v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =2.$\n\n- Statement “If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $\\lambda =2,$ then $-v$ is an eigenvector of $A$ corresponding to $\\lambda =-2.$” is false. We have\n\n$$\n\\begin{aligned}A(-v)=-Av=-(2v)=2(-v).\\end{aligned}\n$$\n\nSince, $A(-v)=2(-v),$ and $-v\\ne 0,$ this implies that $-v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =2$ (but not $-2$).\n\n**Note:** In general, any non-zero multiple of an eigenvector is again an eigenvector, and the corresponding eigenvalue is the same.\n\n- Statement “$v=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}$ that corresponds to the eigenvalue $0.$” is true. We have \n\n$$\n\\begin{aligned}Av & =\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & =0\\begin{bmatrix}1 \\\\ 1\\end{bmatrix} \\\\  & =0v.\\end{aligned}\n$$\n\nSince $Av=0v,$ we conclude that $v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =0.$\n\nTherefore, the correct answer is “$v=\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}2 & 0 \\\\ -2 & 1\\end{bmatrix}$ that corresponds to the eigenvalue $2.$”; “$v=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}$ that corresponds to the eigenvalue $0.$” only."} {:db/id #edb/ref 17592186323858 :knowledge-point/_questions [{:db/id #edb/ref 17592186105769 :knowledge-point/id #uuid "32467c2c-5605-50e9-b961-a29535a0effb" :knowledge-point/title "Identifying True Statements About Eigenvalues and Eigenvectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83ea7e4d-2142-5b09-923c-d1732b846aef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467356} {:answer/id #uuid "d55181ee-827a-5082-8727-316c1c665376" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467357}] :answer-field/correct {:answer/id #uuid "d55181ee-827a-5082-8727-316c1c665376" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467357} :answer-field/id #uuid "80fb52f1-d337-52da-ab2b-f0e26b72af8a" :answer-field/key "If $v$ is an eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =3$ then $v$ is also an eigenvector of the matrix ${A}^{-1}$ that corresponds to $\\lambda =\\frac{1}{3}.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468399} {:answer-field/choices [{:answer/id #uuid "69f8eeec-acb8-50ef-b931-56646b1a48a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467358} {:answer/id #uuid "95027d50-dda7-59a1-90d9-fcb2fc8d7016" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467359}] :answer-field/correct {:answer/id #uuid "69f8eeec-acb8-50ef-b931-56646b1a48a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467358} :answer-field/id #uuid "f91083d4-1dec-5899-9c25-5a1767f35d18" :answer-field/key "An eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =2$ is also an eigenvector of the inverse ${A}^{-1}$ that corresponds to the same eigenvalue $\\lambda =2.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468400} {:answer-field/choices [{:answer/id #uuid "e8cdfafa-f8c6-57ed-9615-9c048196643d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467360} {:answer/id #uuid "773e58d3-1733-5646-800f-a4d36ca8f057" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467361}] :answer-field/correct {:answer/id #uuid "773e58d3-1733-5646-800f-a4d36ca8f057" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467361} :answer-field/id #uuid "c66eca36-f5d2-521d-aeda-fb7f80625ed9" :answer-field/key "If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $\\lambda =-3,$ then $5v$ is also an eigenvector of $A$ corresponding to $\\lambda =-3.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468401} {:answer-field/choices [{:answer/id #uuid "4665c17a-bdba-570b-bb64-4f58ebb53c0d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668639} {:answer/id #uuid "a982e84c-e726-5535-b831-63d2b57d7abe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668640}] :answer-field/correct {:answer/id #uuid "4665c17a-bdba-570b-bb64-4f58ebb53c0d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668639} :answer-field/id #uuid "e7e4c5f9-34d1-52af-905d-4502d2735c23" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668897}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1d99b1dd-fcce-5575-b1d6-40adbcb0e805" :question/math-academy-id "q-36865" :question/problem "Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ With that in mind, let's examine the statements one by one.\n\n- Statement “If $v$ is an eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =3$ then $v$ is also an eigenvector of the matrix ${A}^{-1}$ that corresponds to $\\lambda =\\frac{1}{3}.$” is true. By the definition of an eigenvector, we have \n\n$$\nAv=3v.\n$$\n\n \nMultiplying it by ${A}^{-1}$ from the left, we obtain \n\n$$\nv=3{A}^{-1}v.\n$$\n\nDividing both sides by $3$, we get \n\n$$\n{A}^{-1}v=\\frac{1}{3}v.\n$$\n\n \nSo, $v$ is an eigenvector  of ${A}^{-1}$ that corresponds to the eigenvalue $\\frac{1}{3}.$\n\n**Note:** In general, an eigenvector of an invertible matrix $A$ that corresponds to an eigenvalue $\\lambda $ is an eigenvector of ${A}^{-1}$ that corresponds to the eigenvalue $\\frac{1}{\\lambda }.$\n\n- Statement “An eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =2$ is also an eigenvector of the inverse ${A}^{-1}$ that corresponds to the same eigenvalue $\\lambda =2.$” is false. According to the statement above, an eigenvector of $A$ that corresponds to the eigenvalue $\\lambda =2$ is an eigenvector of ${A}^{-1}$ that corresponds to $\\lambda =\\frac{1}{2}.$\n\n- Statement “If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $\\lambda =-3,$ then $5v$ is also an eigenvector of $A$ corresponding to $\\lambda =-3.$” is true. We have\n\n$$\n\\begin{aligned}A(5v)=5Av=5(-3v)=-3(5v).\\end{aligned}\n$$\n\nSince, $A(5v)=-3(5v),$ and $5v\\ne 0,$ this implies that $5v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =-3.$\n\n**Note:** In general, any non-zero multiple of an eigenvector is again an eigenvector, and the corresponding eigenvalue is the same.\n\nTherefore, the correct answer is “If $v$ is an eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =3$ then $v$ is also an eigenvector of the matrix ${A}^{-1}$ that corresponds to $\\lambda =\\frac{1}{3}.$”; “If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $\\lambda =-3,$ then $5v$ is also an eigenvector of $A$ corresponding to $\\lambda =-3.$” only."} {:db/id #edb/ref 17592186323865 :knowledge-point/_questions [{:db/id #edb/ref 17592186124473 :knowledge-point/id #uuid "ffd143c8-a993-5d0b-85a5-821d6482ae60" :knowledge-point/title "Identifying the Intervals on Which a Function is Invertible Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c89bf3bc-912d-524b-b8c7-166e854b250f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438242} {:answer/id #uuid "c6255188-de6f-5359-b3ce-b11fa26ffa9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438243}] :answer-field/correct {:answer/id #uuid "c89bf3bc-912d-524b-b8c7-166e854b250f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438242} :answer-field/id #uuid "35f5bf02-6bde-5643-acf0-85bec1bb3263" :answer-field/key "$x\\in [-2,0]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439150} {:answer-field/choices [{:answer/id #uuid "c10d5b55-5751-534e-848f-312026170d5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438244} {:answer/id #uuid "e0e0d146-26cc-5512-87e3-871fc6ff47b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438245}] :answer-field/correct {:answer/id #uuid "e0e0d146-26cc-5512-87e3-871fc6ff47b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438245} :answer-field/id #uuid "edb61cc5-3d51-546d-9186-fa06d6294e86" :answer-field/key "$x\\in (-3,-2]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439151} {:answer-field/choices [{:answer/id #uuid "af022492-4d4b-5fe8-ace0-066ff89badcc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438246} {:answer/id #uuid "d1341450-0c68-5e67-bd60-bd2b0eef6a3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438247}] :answer-field/correct {:answer/id #uuid "af022492-4d4b-5fe8-ace0-066ff89badcc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438246} :answer-field/id #uuid "781dd2b1-5946-5698-92e6-edc4b9e58172" :answer-field/key "$x\\in (-3,-1]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439152} {:answer-field/choices [{:answer/id #uuid "92853057-891a-5350-9c7d-a6651584bc7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668641} {:answer/id #uuid "116f5de7-bdb8-5c5d-9901-0414e7745bd6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668642}] :answer-field/correct {:answer/id #uuid "92853057-891a-5350-9c7d-a6651584bc7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668641} :answer-field/id #uuid "6adc84a4-5e96-5649-a85d-788e00df8809" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668898}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2b24e31b-6e93-5c8b-93d0-5c6b5852eeb3" :question/math-academy-id "q-36934" :question/problem "![](images/1e/1eccd6630b69558f8a86f8336e9f0e49f37ffb29acf4a3c8f58be34346b4c93c.png)\n\nOn which of the following intervals is the function $f(x)$ (shown above) invertible?\n\nSelect all that apply." :question/worked-solution "A function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test. \n\n- The given function is **not** invertible on each of the intervals $x\\in [-2,0]$  and $x\\in (-3,-1]$ because some horizontal lines will intersect the curve more than once.\n\n![](images/d8/d8cc826df6fed7a4106539d88ffa8a1fdc0529904497c2d5413f9761acaccd12.png)\n\n        \n\n- The given function is invertible on the interval $x\\in (-3,-2].$ Indeed, any horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](images/bc/bc00ed8f4bdf03b248dbd9a1651ed073e352d512b830139505fba3b60e05e7e9.png)\n\nTherefore, the correct answer is \" $x\\in (-3,-2]$ only\"."} {:db/id #edb/ref 17592186323877 :knowledge-point/_questions [{:db/id #edb/ref 17592186105769 :knowledge-point/id #uuid "32467c2c-5605-50e9-b961-a29535a0effb" :knowledge-point/title "Identifying True Statements About Eigenvalues and Eigenvectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33f5d441-8d4b-58c1-8c22-addd3278df62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467362} {:answer/id #uuid "5290a625-f39a-53d8-892c-452c72d705f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467363}] :answer-field/correct {:answer/id #uuid "5290a625-f39a-53d8-892c-452c72d705f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467363} :answer-field/id #uuid "c7fc9d30-3ccb-5565-83ba-123a94e4a7f6" :answer-field/key "If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $5$ then $10v$ is also an eigenvector corresponding to $5.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468402} {:answer-field/choices [{:answer/id #uuid "412514e3-a9e7-5613-a307-779d4d58279b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467364} {:answer/id #uuid "ee9e4674-ca29-59e5-8966-974fa679ea90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467365}] :answer-field/correct {:answer/id #uuid "ee9e4674-ca29-59e5-8966-974fa679ea90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467365} :answer-field/id #uuid "32d88f51-d3f8-5b52-a864-157037e8ae37" :answer-field/key "$v=\\begin{bmatrix}2 \\\\ 3\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}3 & 2 \\\\ 3 & 4\\end{bmatrix}$ that corresponds to the eigenvalue $6.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468403} {:answer-field/choices [{:answer/id #uuid "f4c67b74-bb04-5491-ad72-7bd19c8d5879" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467366} {:answer/id #uuid "3b128b1a-4960-589c-b9b3-e50d9b123f91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467367}] :answer-field/correct {:answer/id #uuid "3b128b1a-4960-589c-b9b3-e50d9b123f91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467367} :answer-field/id #uuid "102ab22e-5d62-5644-8b69-6d1e5e3127ad" :answer-field/key "$v=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}3 & 1 \\\\ 3 & 1\\end{bmatrix}$ that corresponds to the eigenvalue $4.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468404} {:answer-field/choices [{:answer/id #uuid "18bad07b-2aa2-5bad-a88f-e62ec322078f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668643} {:answer/id #uuid "ed22004e-6533-5c77-8018-8651cbaeaf65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668644}] :answer-field/correct {:answer/id #uuid "18bad07b-2aa2-5bad-a88f-e62ec322078f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668643} :answer-field/id #uuid "26d48e9c-7a17-5cbd-8c90-af24226e718d" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668899}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5bcdf208-8bdf-5d43-b755-321074d52b2d" :question/math-academy-id "q-37090" :question/problem "Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ With that in mind, let's examine the statements one by one.\n\n- Statement “If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $5$ then $10v$ is also an eigenvector corresponding to $5.$” is true. We have\n\n$$\n\\begin{aligned}A(10v)=10Av=10(5v)=5(10v).\\end{aligned}\n$$\n\nSince, $A(10v)=5(10v),$ and $10v\\ne 0,$ this implies that $10v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =5.$\n\n**Note:** In general, any non-zero multiple of an eigenvector is again an eigenvector, and the corresponding eigenvalue is the same.\n\n- Statement “$v=\\begin{bmatrix}2 \\\\ 3\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}3 & 2 \\\\ 3 & 4\\end{bmatrix}$ that corresponds to the eigenvalue $6.$” is true. We have\n\n$$\n\\begin{aligned}Av & =\\begin{bmatrix}3 & 2 \\\\ 3 & 4\\end{bmatrix}\\begin{bmatrix}2 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}12 \\\\ 18\\end{bmatrix} \\\\  & =6\\begin{bmatrix}2 \\\\ 3\\end{bmatrix} \\\\  & =6v.\\end{aligned}\n$$\n\nSince $Av=6v,$ we conclude that $v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =6.$\n\n- Statement “$v=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}3 & 1 \\\\ 3 & 1\\end{bmatrix}$ that corresponds to the eigenvalue $4.$” is true. We have \n\n$$\n\\begin{aligned}Av & =\\begin{bmatrix}3 & 1 \\\\ 3 & 1\\end{bmatrix}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 \\\\ 4\\end{bmatrix} \\\\  & =4\\begin{bmatrix}1 \\\\ 1\\end{bmatrix} \\\\  & =4v.\\end{aligned}\n$$\n\nSince $Av=4v,$ we conclude that $v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =4.$\n\nTherefore, the correct answer is “If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $5$ then $10v$ is also an eigenvector corresponding to $5.$”; “$v=\\begin{bmatrix}2 \\\\ 3\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}3 & 2 \\\\ 3 & 4\\end{bmatrix}$ that corresponds to the eigenvalue $6.$”; “$v=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$ is an eigenvector of $A=\\begin{bmatrix}3 & 1 \\\\ 3 & 1\\end{bmatrix}$ that corresponds to the eigenvalue $4.$”."} {:db/id #edb/ref 17592186323919 :knowledge-point/_questions [{:db/id #edb/ref 17592186124528 :knowledge-point/id #uuid "20a6c0cf-04d4-5908-a03f-1adf491b9282" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem in Terms of Eigenvalues"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7f09b1c-9964-5ae6-9322-bf6de2b57681" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467398} {:answer/id #uuid "dd858fdf-4fbe-5af0-b7f7-3d32c5fc5ff9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467399}] :answer-field/correct {:answer/id #uuid "dd858fdf-4fbe-5af0-b7f7-3d32c5fc5ff9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467399} :answer-field/id #uuid "e939d814-ae4b-507f-b423-19079a26ac60" :answer-field/key "${\\lambda }^{3}-3{\\lambda }^{2}+1=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468420} {:answer-field/choices [{:answer/id #uuid "f2758e74-ea85-5f56-a8cf-c1056f59c3d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467400} {:answer/id #uuid "e83bbd17-0d14-5570-83ce-8018039ac54b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467401}] :answer-field/correct {:answer/id #uuid "e83bbd17-0d14-5570-83ce-8018039ac54b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467401} :answer-field/id #uuid "6089e5b4-5b31-5cc3-8e8f-3c2b0ef217f0" :answer-field/key "$(\\lambda -3)(\\lambda +1)(\\lambda +5)=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468421} {:answer-field/choices [{:answer/id #uuid "3adb0444-ee54-507e-bc74-75995133eade" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467402} {:answer/id #uuid "e35df19c-c12d-5884-9bab-6220a82bac4f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467403}] :answer-field/correct {:answer/id #uuid "3adb0444-ee54-507e-bc74-75995133eade" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467402} :answer-field/id #uuid "cfa1370c-c573-5558-8a76-57bd2125c1c9" :answer-field/key "${\\lambda }^{3}+2{\\lambda }^{2}-4\\lambda =0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468422} {:answer-field/choices [{:answer/id #uuid "16b71c6e-0366-5b6b-826c-42ff86d18660" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668645} {:answer/id #uuid "f7220f9d-978a-538c-ad10-82103a4ce9f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668646}] :answer-field/correct {:answer/id #uuid "16b71c6e-0366-5b6b-826c-42ff86d18660" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668645} :answer-field/id #uuid "406193e6-9d7e-5a5d-827f-c0f71fd36986" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668900}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "26a6234c-3080-57fe-a159-1f4332413072" :question/math-academy-id "q-37527" :question/problem "If $B$ is a $3\\times 3$ invertible matrix, then which of the following could be the characteristic equation of $B?$\n\nSelect all that apply." :question/worked-solution "Since $B$ is invertible, according to the invertible matrix theorem, $0$ can't be an eigenvalue of $B.$ As a result, $\\lambda =0$ should not be a solution to the corresponding characteristic equation. \n\nWith that in mind, let's examine the given equations in turn.\n\n- Equation ${\\lambda }^{3}-3{\\lambda }^{2}+1=0$ could  be the characteristic equation of $B.$ Indeed, $\\lambda =0$ is not a root of the equation.\n\n- Equation $(\\lambda -3)(\\lambda +1)(\\lambda +5)=0$ could be the characteristic equation of $B.$ Indeed, $\\lambda =0$ is not a root of the equation.\n\n- Equation ${\\lambda }^{3}+2{\\lambda }^{2}-4\\lambda =0$ **cannot** be the characteristic equation of $B$ since $\\lambda =0$ is a root of the equation.\n\nTherefore, the correct answer is ${\\lambda }^{3}-3{\\lambda }^{2}+1=0$; $(\\lambda -3)(\\lambda +1)(\\lambda +5)=0$ only."} {:db/id #edb/ref 17592186326691 :knowledge-point/_questions [{:db/id #edb/ref 17592186068700 :knowledge-point/id #uuid "81247553-750f-5bf7-a1c4-698ad63b5ae4" :knowledge-point/title "Identifying True Statements Regarding Left- and Right-Continuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "005e3900-6b8d-5e21-aabf-447866db29b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.t