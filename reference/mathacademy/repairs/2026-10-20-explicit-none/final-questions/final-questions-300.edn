b30-aeec-c4089b6d4315" :answer-field/key "$C={⟨x,y,z⟩\\in {R}^{3}:y=-1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468764} {:answer-field/choices [{:answer/id #uuid "7ce11628-b3f5-578a-ab84-8015541fd894" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668695} {:answer/id #uuid "8d0643a8-0d37-5ac4-a88a-e9cd0e0dbf1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668696}] :answer-field/correct {:answer/id #uuid "8d0643a8-0d37-5ac4-a88a-e9cd0e0dbf1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668696} :answer-field/id #uuid "824306a8-7a4d-51f8-ac57-01ae94ef5558" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668925}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5037faf6-6f8a-5ea2-800f-2c136a3bb59e" :question/math-academy-id "q-74218" :question/problem "Which of the following sets is a subspace of ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0,0⟩$ does not satisfy the condition ${x}^{2}+{y}^{2}+{z}^{2}=1$ since ${0}^{2}+{0}^{2}+{0}^{2}\\ne 1.$\n\n- The set $B$ is not a subspace because it is not closed under vector addition. Indeed, both $a=⟨1,0,1⟩$ and $b=⟨0,1,1⟩$ belong to $B$ but \n\n$$\na+b=⟨1,0,1⟩+⟨0,1,1⟩=⟨1,1,2⟩\n$$\n\n \ndoes not satisfy the condition $xyz=0$ since $1\\cdot 1\\cdot 2\\ne 0.$\n\n- The set $C$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0,0⟩$ does not satisfy the condition $y=-1$ since $0\\ne -1.$\n\nSo, the correct answer is \"None.\""} {:db/id #edb/ref 17592186345112 :knowledge-point/_questions [{:db/id #edb/ref 17592186119925 :knowledge-point/id #uuid "52a45814-d1e2-5948-b7bd-69dcaf6cd0eb" :knowledge-point/title "Identifying Linearly Independent and Dependent Sets Using Row Reduction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3917c546-1a71-5b69-95fa-031bd8a95f70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468148} {:answer/id #uuid "685efbb1-a98a-5e24-81fb-c69c96152f79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468149}] :answer-field/correct {:answer/id #uuid "685efbb1-a98a-5e24-81fb-c69c96152f79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468149} :answer-field/id #uuid "0b4d8e60-f36f-5898-86ce-56958409039b" :answer-field/key "The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468795} {:answer-field/choices [{:answer/id #uuid "799189fe-d9b2-592f-8d4d-7c1f35029fbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468150} {:answer/id #uuid "4b25fdd6-dd1d-55bd-b563-27dbc04b5ac4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468151}] :answer-field/correct {:answer/id #uuid "799189fe-d9b2-592f-8d4d-7c1f35029fbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468150} :answer-field/id #uuid "24d36265-d1fc-567a-8fcc-21fe29ff2d57" :answer-field/key "The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468796} {:answer-field/choices [{:answer/id #uuid "c73bf89d-de06-5c8f-ac60-6e163bb23230" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468152} {:answer/id #uuid "0777f273-c934-5fa7-a08b-0aa490e67340" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468153}] :answer-field/correct {:answer/id #uuid "c73bf89d-de06-5c8f-ac60-6e163bb23230" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468152} :answer-field/id #uuid "22390857-93d9-508c-9a5a-4191c39a0625" :answer-field/key "The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has only the trivial solution ${x}_{1}={x}_{2}={x}_{3}=0.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468797} {:answer-field/choices [{:answer/id #uuid "904c16f6-e179-5937-a4cc-ef4421cee709" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668697} {:answer/id #uuid "7fc946e4-f5de-5269-b7af-9e3d19f12b55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668698}] :answer-field/correct {:answer/id #uuid "904c16f6-e179-5937-a4cc-ef4421cee709" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668697} :answer-field/id #uuid "9da6270a-fa11-5beb-ac9c-bcf162fe47f8" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668926}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2f25df3d-4b0c-5b67-901d-8d878d2769ac" :question/math-academy-id "q-75655" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=\\begin{bmatrix}3 \\\\ -6 \\\\ 12\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-1 \\\\ 3 \\\\ -4\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}1 \\\\ 1 \\\\ 4\\end{bmatrix}.\n$$\n\nAssume that ${x}_{1},{x}_{2},$ and ${x}_{3}$ are real numbers. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system\n\n$$\n\\left\\{\\begin{aligned}3{x}_{1}-{x}_{2}+{x}_{3} &=0 \\\\ -6{x}_{1}+3{x}_{2}+{x}_{3} &=0 \\\\ 12{x}_{1}-4{x}_{2}+4{x}_{3} &=0.\\end{aligned}\\right.\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}3 & -1 & 1 & 0 \\\\ -6 & 3 & 1 & 0 \\\\ 12 & -4 & 4 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}3 & -1 & 1 & 0 \\\\ 0 & 1 & 3 & 0 \\\\ 12 & -4 & 4 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-4){R}_{2} \\\\  & ∼\\begin{bmatrix}3 & -1 & 1 & 0 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nFrom the matrix above, we conclude that the basic variables are ${x}_{1}$ and ${x}_{2}$, while ${x}_{3}$ is the free variable. \n\nSince there is one free variable, the equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has an infinite number of nonzero solutions, which means that the vectors are linearly dependent. \n\nTherefore, statements “The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent” and “The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has only the trivial solution ${x}_{1}={x}_{2}={x}_{3}=0.$” are false, while statement “The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent” is true."} {:db/id #edb/ref 17592186345113 :knowledge-point/_questions [{:db/id #edb/ref 17592186119925 :knowledge-point/id #uuid "52a45814-d1e2-5948-b7bd-69dcaf6cd0eb" :knowledge-point/title "Identifying Linearly Independent and Dependent Sets Using Row Reduction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6bafe8fd-72d8-57d1-bc5f-2d080ed75be6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468154} {:answer/id #uuid "85d07ff4-4f7d-5633-83c1-35a840fa221c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468155}] :answer-field/correct {:answer/id #uuid "6bafe8fd-72d8-57d1-bc5f-2d080ed75be6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468154} :answer-field/id #uuid "5e6d4ee9-771a-5696-bc88-03f95f6a365b" :answer-field/key "The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468798} {:answer-field/choices [{:answer/id #uuid "0211896a-1507-5fae-b661-63d9b4006bfb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468156} {:answer/id #uuid "e538415b-f7c4-5194-8711-1b826788fa1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468157}] :answer-field/correct {:answer/id #uuid "e538415b-f7c4-5194-8711-1b826788fa1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468157} :answer-field/id #uuid "76ccb41d-e467-5e5a-8866-b19917b240b8" :answer-field/key "The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has only the trivial solution ${x}_{1}={x}_{2}={x}_{3}=0.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468799} {:answer-field/choices [{:answer/id #uuid "617d8744-96d7-5762-8987-dbfc8acaed28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468158} {:answer/id #uuid "f2a4a05a-b344-5855-b641-f345041b157b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468159}] :answer-field/correct {:answer/id #uuid "f2a4a05a-b344-5855-b641-f345041b157b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468159} :answer-field/id #uuid "a2aa78d3-df8a-59d9-9a6e-298d4dfe1189" :answer-field/key "The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468800} {:answer-field/choices [{:answer/id #uuid "4ee1947e-5c5e-5107-84eb-94f49fe0fd78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668699} {:answer/id #uuid "f64c9540-891e-5558-9f9d-efdb7b09397a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668700}] :answer-field/correct {:answer/id #uuid "4ee1947e-5c5e-5107-84eb-94f49fe0fd78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668699} :answer-field/id #uuid "731602d2-6911-5787-ae2a-57c2b8fc1221" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668927}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0d48ab70-ab46-5142-a432-382f1feb7bb9" :question/math-academy-id "q-75659" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ -1 \\\\ 2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-1 \\\\ 2 \\\\ -2\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}0 \\\\ -2 \\\\ 1\\end{bmatrix}.\n$$\n\nAssume that ${x}_{1},{x}_{2},$ and ${x}_{3}$ are real numbers. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2} &=0 \\\\ -{x}_{1}+2{x}_{2}-2{x}_{3} &=0 \\\\ 2{x}_{1}-2{x}_{2}+{x}_{3} &=0.\\end{aligned}\\right.\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -1 & 0 & 0 \\\\ -1 & 2 & -2 & 0 \\\\ 2 & -2 & 1 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 0 & 0 \\\\ 0 & 1 & -2 & 0 \\\\ 2 & -2 & 1 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 0 & 0 \\\\ 0 & 1 & -2 & 0 \\\\ 0 & 0 & 1 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nSo, the system is now\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2} &=0 \\\\ {x}_{2}-2{x}_{3} &=0 \\\\ {x}_{3} &=0.\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get ${x}_{3}=0.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}-2(0)=0\\,⟹\\,{x}_{2}=0\n$$\n\nand, substituting this into the first equation, we obtain\n\n$$\n{x}_{1}-(0)=0\\,⟹\\,{x}_{1}=0.\n$$\n\nSince ${x}_{1}={x}_{2}={x}_{3}=0$, we get that the set $\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is linearly independent.\n\nTherefore, statements “The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has only the trivial solution ${x}_{1}={x}_{2}={x}_{3}=0.$” and “The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent” are true, while statement “The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent” is false."} {:db/id #edb/ref 17592186345114 :knowledge-point/_questions [{:db/id #edb/ref 17592186119925 :knowledge-point/id #uuid "52a45814-d1e2-5948-b7bd-69dcaf6cd0eb" :knowledge-point/title "Identifying Linearly Independent and Dependent Sets Using Row Reduction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "493d511c-3fa2-54f4-906f-3d10df060915" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468160} {:answer/id #uuid "8f671f0b-993d-528f-b2eb-6b89c5eb4f65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468161}] :answer-field/correct {:answer/id #uuid "8f671f0b-993d-528f-b2eb-6b89c5eb4f65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468161} :answer-field/id #uuid "984e11bf-4e99-50cb-a93f-68d5978b7a68" :answer-field/key "The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468801} {:answer-field/choices [{:answer/id #uuid "c0174516-2301-5678-aabd-d794fd74401e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468162} {:answer/id #uuid "426af5ad-f62d-552a-9782-a9d6d03d7b97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468163}] :answer-field/correct {:answer/id #uuid "c0174516-2301-5678-aabd-d794fd74401e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468162} :answer-field/id #uuid "20ee08d3-8d95-51aa-87d4-23a80c7b3d51" :answer-field/key "The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468802} {:answer-field/choices [{:answer/id #uuid "392d404a-6778-5ca0-8617-cce66facc8c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468164} {:answer/id #uuid "72c49299-2a0c-575b-8373-00f8a3aee6a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468165}] :answer-field/correct {:answer/id #uuid "392d404a-6778-5ca0-8617-cce66facc8c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468164} :answer-field/id #uuid "7a289ad7-4d94-5940-ba11-7c8a3c9465d3" :answer-field/key "The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has an infinite number of nonzero solutions." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468803} {:answer-field/choices [{:answer/id #uuid "032f9058-42f2-5fb8-a485-67ca77145a3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668701} {:answer/id #uuid "48f6efa1-0881-5f62-bf78-d9dc24f064e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668702}] :answer-field/correct {:answer/id #uuid "032f9058-42f2-5fb8-a485-67ca77145a3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668701} :answer-field/id #uuid "accbbac3-201e-5646-8e1a-9ff966ed493c" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668928}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8d177800-f6a6-59b3-bf6e-5adc772e358a" :question/math-academy-id "q-75660" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ -4 \\\\ -3\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-3 \\\\ 13 \\\\ 9\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}2 \\\\ -7 \\\\ -4\\end{bmatrix}.\n$$\n\nAssume that ${x}_{1},{x}_{2},$ and ${x}_{3}$ are real numbers. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-3{x}_{2}+2{x}_{3} &=0 \\\\ -4{x}_{1}+13{x}_{2}-7{x}_{3} &=0 \\\\ -3{x}_{1}+9{x}_{2}-4{x}_{3} &=0.\\end{aligned}\\right.\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -3 & 2 & 0 \\\\ -4 & 13 & -7 & 0 \\\\ -3 & 9 & -4 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 2 & 0 \\\\ 0 & 1 & 1 & 0 \\\\ -3 & 9 & -4 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 2 & 0 \\\\ 0 & 1 & 1 & 0 \\\\ 0 & 0 & 2 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nSo, the system is now\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-3{x}_{2}+2{x}_{3} &=0 \\\\ {x}_{2}+{x}_{3} &=0 \\\\ 2{x}_{3} &=0.\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get ${x}_{3}=0.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}+(0)=0\\,⟹\\,{x}_{2}=0\n$$\n\nand, substituting this into the first equation, we obtain\n\n$$\n{x}_{1}-3(0)+2(0)=0\\,⟹\\,{x}_{1}=0.\n$$\n\nSince ${x}_{1}={x}_{2}={x}_{3}=0$, we get that the set $\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is linearly independent.\n\nTherefore, statements “The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent” and “The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has an infinite number of nonzero solutions” are false, while statement “The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent” is true."} {:db/id #edb/ref 17592186345121 :knowledge-point/_questions [{:db/id #edb/ref 17592186105769 :knowledge-point/id #uuid "32467c2c-5605-50e9-b961-a29535a0effb" :knowledge-point/title "Identifying True Statements About Eigenvalues and Eigenvectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fba09f7-6fb0-5d6c-8424-e721e8481780" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468166} {:answer/id #uuid "1cfcaae9-18c3-556e-876b-dbe83dd13637" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468167}] :answer-field/correct {:answer/id #uuid "1fba09f7-6fb0-5d6c-8424-e721e8481780" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468166} :answer-field/id #uuid "1111e0c2-88ed-5b55-afd9-e459c3ebe34f" :answer-field/key "If $v$ is an eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =2$ then $v$ is also an eigenvector of the matrix ${A}^{-1}$ that corresponds to $\\lambda =-2.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468804} {:answer-field/choices [{:answer/id #uuid "f3eda578-a166-50a0-a055-3491f285c249" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468168} {:answer/id #uuid "162f9645-e89a-5701-ad26-d9ed38cd8047" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468169}] :answer-field/correct {:answer/id #uuid "162f9645-e89a-5701-ad26-d9ed38cd8047" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468169} :answer-field/id #uuid "c285d321-3810-5e14-84d2-43bf04bf70f6" :answer-field/key "An eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =1$ is also an eigenvector of the inverse ${A}^{-1}$ that corresponds to the same eigenvalue $\\lambda =1.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468805} {:answer-field/choices [{:answer/id #uuid "6b017c3c-7510-5e3d-b988-1b2e3d35ce99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468170} {:answer/id #uuid "178b845d-847d-59e6-9f16-2bed3653076e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468171}] :answer-field/correct {:answer/id #uuid "6b017c3c-7510-5e3d-b988-1b2e3d35ce99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468170} :answer-field/id #uuid "1a6cf479-04ac-5307-9b8b-3196833e508d" :answer-field/key "If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $\\lambda =2,$ then $7v$ is also an eigenvector of $A$ corresponding to $\\lambda =\\frac{1}{2}.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468806} {:answer-field/choices [{:answer/id #uuid "6b375f19-b948-5097-8f5f-72d1354a4a86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668703} {:answer/id #uuid "2a4b710b-abde-509f-8ec6-d72180d31df0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668704}] :answer-field/correct {:answer/id #uuid "6b375f19-b948-5097-8f5f-72d1354a4a86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668703} :answer-field/id #uuid "3afb1555-4181-5f40-808e-1c04ccbeb58f" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668929}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7a5c031b-68ff-5d30-80f0-79dec42f9067" :question/math-academy-id "q-75729" :question/problem "Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ With that in mind, let's examine the statements one by one.\n\n- Statement is false. By the definition of an eigenvector, we have \n\n$$\nAv=2v.\n$$\n\n \nMultiplying it by ${A}^{-1}$ from the left, we obtain \n\n$$\nv=2{A}^{-1}v.\n$$\n\nDividing both sides by $2$, we get \n\n$$\n{A}^{-1}v=\\frac{1}{2}v.\n$$\n\n \nSo, $v$ is an eigenvector  of ${A}^{-1}$ that corresponds to the eigenvalue $\\frac{1}{2}.$\n\n**Note:** In general, an eigenvector of an invertible matrix $A$ that corresponds to an eigenvalue $\\lambda $ is an eigenvector of ${A}^{-1}$ that corresponds to the eigenvalue $\\frac{1}{\\lambda }.$\n\n- Statement “An eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =1$ is also an eigenvector of the inverse ${A}^{-1}$ that corresponds to the same eigenvalue $\\lambda =1.$” is true. According to the statement above, an eigenvector of $A$ that corresponds to the eigenvalue $\\lambda =1$ is an eigenvector of ${A}^{-1}$ that corresponds to $\\lambda =\\frac{1}{1}=1.$\n\n- Statement “If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $\\lambda =2,$ then $7v$ is also an eigenvector of $A$ corresponding to $\\lambda =\\frac{1}{2}.$” is false. We have\n\n$$\n\\begin{aligned}A(7v)=7Av=7(2v)=2(7v).\\end{aligned}\n$$\n\nSince, $A(7v)=2(7v),$ and $7v\\ne 0,$ this implies that $7v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =2.$\n\n**Note:** In general, any non-zero multiple of an eigenvector is again an eigenvector, and the corresponding eigenvalue is the same.\n\nTherefore, the correct answer is “An eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =1$ is also an eigenvector of the inverse ${A}^{-1}$ that corresponds to the same eigenvalue $\\lambda =1.$” only."} {:db/id #edb/ref 17592186345195 :knowledge-point/_questions [{:db/id #edb/ref 17592186078487 :knowledge-point/id #uuid "f00fd821-a5d4-5844-9db5-795b9e321b94" :knowledge-point/title "Identifying the Largest Intervals of Continuity of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cc598710-e322-5db2-83bc-e862528237bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468178} {:answer/id #uuid "2575c1e4-9a08-598b-a4a6-ba47900d821f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468179}] :answer-field/correct {:answer/id #uuid "2575c1e4-9a08-598b-a4a6-ba47900d821f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468179} :answer-field/id #uuid "d0bcebac-d48f-5104-a76e-f3bf41ace939" :answer-field/key "$x\\in (-\\infty ,-1]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468810} {:answer-field/choices [{:answer/id #uuid "