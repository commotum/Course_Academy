type/text} :answer/value "false" :db/id #edb/ref 17592186439743} {:answer/id #uuid "0477e31a-6a45-5821-ab82-2a1844d48dbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439744}] :answer-field/correct {:answer/id #uuid "fc06c13a-02a5-52da-8c5f-33478dd82019" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439743} :answer-field/id #uuid "f85e3c8e-67f8-5920-9a7f-eec1efb5cb19" :answer-field/key "$x=2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440229} {:answer-field/choices [{:answer/id #uuid "c1ab2849-ad67-54a6-b3f9-746ba45c259a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668657} {:answer/id #uuid "dfbd957b-ae33-533f-abc7-005f6521ef46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668658}] :answer-field/correct {:answer/id #uuid "dfbd957b-ae33-533f-abc7-005f6521ef46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668658} :answer-field/id #uuid "158a75e3-0b5d-509f-bc84-32aaacc4133e" :answer-field/key "The function has no vertical asymptotes" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668906}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2f92ee8b-33fa-5343-9c16-73df2f465b76" :question/math-academy-id "q-39934" :question/problem "Determine the vertical asymptotes of the function $f(x)=\\frac{{x}^{2}+3x}{{x}^{3}+2{x}^{2}+8x}.$\n\nSelect all that apply." :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}+3x}{{x}^{3}+2{x}^{2}+8x} \\\\  & =\\frac{x(x+3)}{x({x}^{2}+2x+8)} \\\\  & =\\frac{\\cancel{x}(x+3)}{\\cancel{x}({x}^{2}+2x+8)} \\\\  & =\\frac{x+3}{{x}^{2}+2x+8}\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero:\n\n$$\n{x}^{2}+2x+8=0\n$$\n\nThis equation does not have any real solutions because the discriminant $D$ is negative:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & ={2}^{2}-4(1)(8) \\\\  & =-28\\end{aligned}\n$$\n\nTherefore, $f(x)$ has no vertical asymptotes."} {:db/id #edb/ref 17592186326808 :knowledge-point/_questions [{:db/id #edb/ref 17592186133758 :knowledge-point/id #uuid "41c2d289-8df5-551b-9501-3a762c67386f" :knowledge-point/title "Identifying True Statements About the Dot Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1db8eb7-e09f-56da-a287-35714cc28cf2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467458} {:answer/id #uuid "b1ff2546-2a88-5435-acbe-93df7f7eeafd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467459}] :answer-field/correct {:answer/id #uuid "b1ff2546-2a88-5435-acbe-93df7f7eeafd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467459} :answer-field/id #uuid "ba8eda63-91b1-56f5-a4df-cc1f8bc6d99c" :answer-field/key "$a\\cdot a>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468450} {:answer-field/choices [{:answer/id #uuid "1e828117-5723-519f-b893-5316f2b3b3b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467460} {:answer/id #uuid "c561fe9a-88e5-52