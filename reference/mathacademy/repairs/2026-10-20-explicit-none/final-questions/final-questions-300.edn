f 17592186668659} :answer-field/id #uuid "6dfe2b54-d3cd-5b26-af9e-4f8ba489803d" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668907}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b1453d9c-0156-5211-9ae1-5e44ccac6939" :question/math-academy-id "q-40116" :question/problem "Suppose $(6a-9b)\\cdot a=0$, where $a\\ne 0.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement $a\\cdot a>0$ is true. Indedd, $a\\ne 0$ implies that $a\\cdot a>0.$\n\n- Statement $a\\cdot a=\\frac{1}{2}(b\\cdot a)$ is false. Simplifying the expression $(6a-9b)\\cdot a=0$, we have\n\n$$\n\\begin{aligned}(6a-9b)\\cdot a & =0 \\\\ (6a)\\cdot a-(9b)\\cdot a & =0 \\\\ 6(a\\cdot a)-9(b\\cdot a) & =0 \\\\ 6(a\\cdot a) & =9(b\\cdot a) \\\\ a\\cdot a & =\\frac{3}{2}(b\\cdot a)\\end{aligned}\n$$\n\n- Statement $b\\cdot a=-4$ is false since it leads to a contradiction. If $b\\cdot a=-4$, we get\n\n$$\n\\begin{aligned}(6a-9b)\\cdot a & =0 \\\\ 6(a\\cdot a)-9(b\\cdot a) & =0 \\\\ 6(a\\cdot a)-9(-4) & =0 \\\\ a\\cdot a & =-6,\\end{aligned}\n$$\n\nbut this is a contradiction since $a\\ne 0$ implies that $a\\cdot a>0.$\n\nTherefore, we conclude that the correct answer is $a\\cdot a>0$ only."} {:db/id #edb/ref 17592186326848 :knowledge-point/_questions [{:db/id #edb/ref 17592186115201 :knowledge-point/id #uuid "ef75bc93-76da-5992-8285-181b808eb7a0" :knowledge-point/title "Finding the Range of a Transformed Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fba6985-3012-59f9-9046-f7eb81bd2134" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467470} {:answer/id #uuid "4176abbf-bd07-546f-8c5b-1cbab5b0a94b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467471}] :answer-field/correct {:answer/id #uuid "4176abbf-bd07-546f-8c5b-1cbab5b0a94b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467471} :answer-field/id #uuid "a3b98d53-5717-5f50-8dd4-dd0c7af69429" :answer-field/key "The number $-3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468456} {:answer-field/choices [{:answer/id #uuid "88ac396c-2449-52a9-a0d6-33a2b4292428" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467472} {:answer/id #uuid "c8ec575c-69f5-5fb8-9972-08b07552919e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467473}] :answer-field/correct {:answer/id #uuid "c8ec575c-69f5-5fb8-9972-08b07552919e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467473} :answer-field/id #uuid "95a51358-016b-50f8-9abd-1bdef89debaa" :answer-field/key "The number $2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468457} {:answer-field/choices [{:answer/id #uuid "aa42429c-3d19-5a80-9479-8973b3e68f6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467474} {:answer/id #uuid "5098c1b0-3b23-5a63-8473-81c712f3c23c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467475}] :answer-field/correct {:answer/id #uuid "aa42429c-3d19-5a80-9479-8973b3e68f6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467474} :answer-field/id #uuid "694365a2-c4b5-5df8-91a8-0c68236bf025" :answer-field/key "The number $10$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468458} {:answer-field/choices [{:answer/id #uuid "3569cb4b-5daa-5070-9d39-c6757dbc285d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668661} {:answer/id #uuid "4a40808c-8f74-536b-8d73-02017ce0879b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668662}] :answer-field/correct {:answer/id #uuid "3569cb4b-5daa-5070-9d39-c6757dbc285d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668661} :answer-field/id #uuid "97ee3989-6fa2-5a6b-a2d5-249cbbadd09b" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668908}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b0164c43-f6ad-58eb-9330-df1855ede5c5" :question/math-academy-id "q-40556" :question/problem "Which of the following values ​are possible outputs of $f(x)=-5{\\left(\\frac{2}{3}\\right)}^{x-1}+3?$\n\nSelect all that apply." :question/worked-solution "The range of ${\\left(\\frac{2}{3}\\right)}^{x}$ is\n\n$$\n{\\left(\\frac{2}{3}\\right)}^{x}>0.\n$$\n\nHorizontal shifts and stretches do not affect the range. Therefore,\n\n$$\n{\\left(\\frac{2}{3}\\right)}^{x-1}>0.\n$$\n\nMultiplying the above inequality by $-5$ and then adding $3,$ we get the following:\n\n$$\n\\begin{aligned}{\\left(\\frac{2}{3}\\right)}^{x-1} & >0 \\\\ -5{\\left(\\frac{2}{3}\\right)}^{x-1} & <0 \\\\ -5{\\left(\\frac{2}{3}\\right)}^{x-1}+3 & <0+3 \\\\ f(x) & <3\\end{aligned}\n$$\n\nTherefore, the range is $f(x)<3.$ Thus, of the given values, only $y=-3$ and $y=2$ are  outputs of $y=f(x).$\n\nWe can also see that this is true from the graph of the function. The graph of $y=f(x)$ is shown below.\n\n![](images/b2/b220b9c53bfaa49fe9b1b1c70fb9e21d08e247f44df8716846d08fd37ac2cf11.png)\n\n  \n\nSo, the correct answer is “The number $-3$”; “The number $2$” only."} {:db/id #edb/ref 17592186326879 :knowledge-point/_questions [{:db/id #edb/ref 17592186115201 :knowledge-point/id #uuid "ef75bc93-76da-5992-8285-181b808eb7a0" :knowledge-point/title "Finding the Range of a Transformed Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2be919c0-2e7e-55ba-ac96-3989376a6465" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467476} {:answer/id #uuid "12d89c1a-7b91-587f-bcd6-3572509206a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467477}] :answer-field/correct {:answer/id #uuid "12d89c1a-7b91-587f-bcd6-3572509206a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467477} :answer-field/id #uuid "b068adf9-1de1-54ce-add1-bac0f0ac7414" :answer-field/key "The number $0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468459} {:answer-field/choices [{:answer/id #uuid "b77c347b-36a4-5c6e-b52e-370b44d8a7b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467478} {:answer/id #uuid "ed8d4346-33f6-59a1-b92e-7148fbd3fdf1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467479}] :answer-field/correct {:answer/id #uuid "ed8d4346-33f6-59a1-b92e-7148fbd3fdf1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467479} :answer-field/id #uuid "e6620f20-85ec-523b-96f2-0a064cfa262d" :answer-field/key "The number $-0.2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468460} {:answer-field/choices [{:answer/id #uuid "992ba742-0d05-53df-85ef-a4b6b932078e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467480} {:answer/id #uuid "f4b8515a-b879-54b3-9bb0-f5d32d477ca5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467481}] :answer-field/correct {:answer/id #uuid "992ba742-0d05-53df-85ef-a4b6b932078e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467480} :answer-field/id #uuid "07c07e13-de4b-5e64-850c-da341cdcf490" :answer-field/key "The number $-0.8$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468461} {:answer-field/choices [{:answer/id #uuid "657868c0-4f3c-5702-b039-b2bcc2e0359f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668663} {:answer/id #uuid "e609ff1b-c8fd-58b3-a9eb-0d93d758a930" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668664}] :answer-field/correct {:answer/id #uuid "657868c0-4f3c-5702-b039-b2bcc2e0359f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668663} :answer-field/id #uuid "327e338e-507c-5911-b2cc-ac683a81095b" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668909}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f9f596e3-81e5-5b3c-9173-334b5d50904e" :question/math-academy-id "q-40798" :question/problem "Which of the following values ​are possible outputs of  $f(x)={(1.5)}^{2x}-0.5?$ \n\nSelect all that apply." :question/worked-solution "The range of ${(1.5)}^{x}$ is\n\n$$\n{(1.5)}^{x}>0.\n$$\n\nHorizontal shifts and stretches do not affect the range. Therefore,\n\n$$\n{(1.5)}^{2x}>0.\n$$\n\nSubtracting  $0.5$ from the above inequality yields the following:\n\n$$\n\\begin{aligned}{(1.5)}^{2x} & >0 \\\\ {(1.5)}^{2x}-0.5 & >0-0.5 \\\\ f(x) & >-0.5\\end{aligned}\n$$\n\nTherefore, the range is $f(x)>-0.5.$ Thus, of the given values, only $y=0$ and $y=-0.2$ are outputs of $y=f(x).$\n\nWe can also see that this is true from the graph of the function. The graph of $y=f(x)$ is shown below.\n\n![](images/58/5876d2095bfd91417d2e6395f8a02ae817ebd476076bae929d79709ea7961a3e.png)\n\nSo, the correct answer is “The number $0$”; “The number $-0.2$” only."} {:db/id #edb/ref 17592186326880 :knowledge-point/_questions [{:db/id #edb/ref 17592186115201 :knowledge-point/id #uuid "ef75bc93-76da-5992-8285-181b808eb7a0" :knowledge-point/title "Finding the Range of a Transformed Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b128238-89f2-56ef-a3a0-db3141972f7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467482} {:answer/id #uuid "6c788197-15ab-5d92-beb7-29c4da863ea1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467483}] :answer-field/correct {:answer/id #uuid "5b128238-89f2-56ef-a3a0-db3141972f7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467482} :answer-field/id #uuid "d90e7fa7-4834-5a3a-8d52-f6168385cd71" :answer-field/key "The number $0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468462} {:answer-field/choices [{:answer/id #uuid "24464fc7-7df1-50c5-bf7d-9