ddf-b6cc-27bce778c863" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467414} :answer-field/id #uuid "977f0cda-4b4d-5298-9b59-46efd06a7e03" :answer-field/key "The function is continuous at $x=-1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468428} {:answer-field/choices [{:answer/id #uuid "e9a16c4f-ed98-538f-8c0c-59ad66c55225" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668647} {:answer/id #uuid "485460d9-9596-54bf-bdf0-00058edb5feb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668648}] :answer-field/correct {:answer/id #uuid "485460d9-9596-54bf-bdf0-00058edb5feb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668648} :answer-field/id #uuid "a12337e2-b75b-58db-a22a-333c54793900" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668901}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "aa66e43c-92cc-5831-9942-3be250ef9ed8" :question/math-academy-id "q-38546" :question/problem "![](images/8f/8fdb835ed2998fae4d8afc3fd5e593bac6c72b1ee45c8b4fe01bdc4348322d1e.png)\n\nWhich of the following statements are true regarding the function $y=f(x)$ plotted above?\n\nSelect all that apply." :question/worked-solution "Let's look at each statement in turn:\n\n- Statement “The function is left-continuous at $x=-1$” is false. The function is not left-continuous at $x=-1,$ since the left-sided limit is not equal to the function value:\n\n$$\n{lim}_{x\\to (-1)^{-}}f(x)=-1\\ne 1=f(-1)\n$$\n\n- Statement “The function is right-continuous at $x=-1$” is false. The function is not right-continuous at $x=-1,$ since the right-sided limit is not equal to the function value:\n\n$$\n{lim}_{x\\to (-1)^{+}}f(x)=-1\\ne 1=f(-1)\n$$\n\n- Statement “The function is continuous at $x=-1$” is false. In order for the function to be continuous at $x=-1,$ it must be both left-continuous and right-continuous. However, we have already determined that the function is neither left-continuous nor right-continuous at this point.\n\nIn conclusion, none of the statements are true."} {:db/id #edb/ref 17592186326750 :knowledge-point/_questions [{:db/id #edb/ref 17592186133758 :knowledge-point/id #uuid "41c2d289-8df5-551b-9501-3a762c67386f" :knowledge-point/title "Identifying True Statements About the Dot Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4bab5c6a-f15f-5312-8be0-740e41bde8bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467434} {:answer/id #uuid "8011ab83-1ae9-5f11-8342-7b42a240103f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467435}] :answer-field/correct {:answer/id #uuid "4bab5c6a-f15f-5312-8be0-740e41bde8bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467434} :answer-field/id #uuid "c63fa5ab-754e-567b-9e4b-510a7a6ad162" :answer-field/key "$b\\cdot a>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468438} {:answer-field/choices [{:answer/id #uuid "9bc03224-7ff5-5865-b574-29adcd9ee3e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467436} {:answer/id #uuid "fcd5b92b-7d63-5ddd-b688-cb1c28b1b2d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467437}] :answer-field/correct {:answer/