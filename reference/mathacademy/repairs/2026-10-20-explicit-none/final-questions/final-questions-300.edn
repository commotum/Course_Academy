7592186466403} {:answer/id #uuid "5fb604ea-6a7f-54d2-887c-5edae00dba6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466404}] :answer-field/correct {:answer/id #uuid "70d4b961-effc-5654-b426-2322d8a2bd14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466403} :answer-field/id #uuid "fa5fd7ab-beb9-5ce4-8b2d-e61c300f6b86" :answer-field/key "${D}_{3}(y)=\\frac{{\\text{d}}^{3}y}{\\text{d}{x}^{3}}+\\operatorname{tan}⁡(y)\\,y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467045} {:answer-field/choices [{:answer/id #uuid "ce131b0b-937f-556f-bd72-56db5da84e6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668581} {:answer/id #uuid "9f712228-e074-5b67-8666-004f5309e4a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668582}] :answer-field/correct {:answer/id #uuid "ce131b0b-937f-556f-bd72-56db5da84e6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668581} :answer-field/id #uuid "d8fd51f1-57c2-5d42-847f-dec39915423c" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668868}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "47d8bb1c-4d46-5c7b-bec5-01c857be1d48" :question/math-academy-id "q-337777" :question/problem "Which of the following are linear differential operators?\n\nSelect all that apply." :question/worked-solution "An $n$th-order differential operator $L$ is linear if it is of the following form:\n\n$$\nL(y)={f}_{n}(x)\\frac{{\\text{d}}^{n}y}{\\text{d}{x}^{n}}+{f}_{n-1}(x)\\frac{{\\text{d}}^{n-1}y}{\\text{d}{x}^{n-1}}+⋯+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwhere each ${f}_{i}$ is a function of $x$ only. \n\nWith that in mind, let's check each operator.\n\n- Operator ${D}_{1}$ is *not* linear. The coefficient of the first term is $xy,$ which depends on $y$ and therefore fails linearity.\n\n- Operator ${D}_{2}$ is linear. It is a second-order linear differential operator of the form\n\n$$\n{D}_{2}(y)={f}_{2}(x)\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwith ${f}_{2}(x)=\\operatorname{cos}⁡(x),{f}_{1}(x)={x}^{2},$ and ${f}_{0}(x)={e}^{x}.$\n\n- Operator ${D}_{3}$ is *not* linear. The coefficient of the last term is $\\operatorname{tan}⁡(y),$ which depends on $y$ and therefore fails linearity.\n\nTherefore, the correct answer is ${D}_{2}(y)$ $=\\operatorname{cos}⁡(x)\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ $+{x}^{2}\\frac{\\text{d}y}{\\text{d}x}$ $+{e}^{x}y$ only."} {:db/id #edb/ref 17592186311885 :knowledge-point/_questions [{:db/id #edb/ref 17592186229138 :knowledge-point/id #uuid "f5976004-053f-58ec-9d75-54d43a419397" :knowledge-point/title "Identifying Linear Differential Operators Using the General Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8462488e-272b-5772-bf64-9aa1638edb21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466405} {:answer/id #uuid "06728173-b51c-55c4-92d8-9851289d57bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466406}] :answer-field/correct {:answer/id #uuid "06728173-b51c-55c4-92d8-9851289d57bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466406} :answer-field/id #uuid "caa1bd4a-3eba-56e1-a3ba-6e63da10f9e6" :answer-field/key "${D}_{1}(y)=\\frac{1}{x+1}\\frac{\\text{d}y}{\\text{d}x}+\\operatorname{sin}⁡(x)\\,y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467046} {:answer-field/choices [{:answer/id #uuid "bc57e6f5-5ce9-51db-a506-35f8fe3453e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466407} {:answer/id #uuid "634f6c08-51bc-5474-b7ad-cca79735d829" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466408}] :answer-field/correct {:answer/id #uuid "634f6c08-51bc-5474-b7ad-cca79735d829" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466408} :answer-field/id #uuid "e33b4fc0-086e-5fab-be31-3e3d8f7b2025" :answer-field/key "${D}_{2}(y)$ $=\\sqrt{x}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ $-\\operatorname{ln}⁡(x)\\frac{\\text{d}y}{\\text{d}x}$ $-2y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467047} {:answer-field/choices [{:answer/id #uuid "e38e3054-6ed9-56c7-8585-41217d71f832" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466409} {:answer/id #uuid "1168cf38-73e5-5de7-a26b-6306956051c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466410}] :answer-field/correct {:answer/id #uuid "1168cf38-73e5-5de7-a26b-6306956051c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466410} :answer-field/id #uuid "10a51316-22f5-5b3e-9744-bdf00aa12c02" :answer-field/key "${D}_{3}(y)=2\\frac{{\\text{d}}^{3}y}{\\text{d}{x}^{3}}+{e}^{x}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-\\frac{1}{1+{x}^{2}}\\,y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467048} {:answer-field/choices [{:answer/id #uuid "456ef5e6-b59f-52f8-a36f-4f868bcc713e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668583} {:answer/id #uuid "3f573645-4b3e-58bf-ba5f-046cd20fa9d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668584}] :answer-field/correct {:answer/id #uuid "456ef5e6-b59f-52f8-a36f-4f868bcc713e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668583} :answer-field/id #uuid "dadc7114-3cf6-5be9-b94c-323a658cba46" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668869}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7a6ed137-ea67-591f-bf1a-a0d1b0037ea7" :question/math-academy-id "q-337778" :question/problem "Which of the following are linear differential operators?\n\nSelect all that apply." :question/worked-solution "An $n$th-order differential operator $L$ is linear if it is of the following form:\n\n$$\nL(y)={f}_{n}(x)\\frac{{\\text{d}}^{n}y}{\\text{d}{x}^{n}}+{f}_{n-1}(x)\\frac{{\\text{d}}^{n-1}y}{\\text{d}{x}^{n-1}}+⋯+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwhere each ${f}_{i}$ is a function of $x$ only. \n\nWith that in mind, let's check each operator.\n\n- Operator ${D}_{1}$ is linear. It is a first-order linear differential operator of the form\n\n$$\n{D}_{1}(y)={f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwith ${f}_{1}(x)=\\frac{1}{x+1}$ and ${f}_{0}(x)=\\operatorname{sin}⁡(x).$\n\n- Operator ${D}_{2}$ is linear. It is a second-order linear differential operator of the form\n\n$$\n{D}_{2}(y)={f}_{2}(x)\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwith ${f}_{2}(x)=\\sqrt{x},{f}_{1}(x)=-\\operatorname{ln}⁡(x),$ and ${f}_{0}(x)=-2.$\n\n- Operator ${D}_{3}$ is linear. It is a third-order linear differential operator of the form\n\n$$\n{D}_{3}(y)={f}_{3}(x)\\frac{{\\text{d}}^{3}y}{\\text{d}{x}^{3}}+{f}_{2}(x)\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwith ${f}_{3}(x)=2,{f}_{2}(x)={e}^{x},{f}_{1}(x)=0,$ and ${f}_{0}(x)=-\\frac{1}{1+{x}^{2}}.$\n\nTherefore, the correct answer is ${D}_{1}(y)=\\frac{1}{x+1}\\frac{\\text{d}y}{\\text{d}x}+\\operatorname{sin}⁡(x)\\,y$; ${D}_{2}(y)$ $=\\sqrt{x}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ $-\\operatorname{ln}⁡(x)\\frac{\\text{d}y}{\\text{d}x}$ $-2y$; ${D}_{3}(y)=2\\frac{{\\text{d}}^{3}y}{\\text{d}{x}^{3}}+{e}^{x}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-\\frac{1}{1+{x}^{2}}\\,y$."} {:db/id #edb/ref 17592186311917 :knowledge-point/_questions [{:db/id #edb/ref 17592186229138 :knowledge-point/id #uuid "f5976004-053f-58ec-9d75-54d43a419397" :knowledge-point/title "Identifying Linear Differential Operators Using the General Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "537e9287-d40b-541a-a771-35fdebb7a68e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466417} {:answer/id #uuid "b86f20e9-e99e-5043-a105-41ba0d06d907" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466418}] :answer-field/correct {:answer/id #uuid "537e9287-d40b-541a-a771-35fdebb7a68e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466417} :answer-field/id #uuid "ee149c43-cd32-54e1-88b1-1a761ba1088d" :answer-field/key "${D}_{1}(y)=\\frac{\\text{d}y}{\\text{d}x}+\\operatorname{sin}⁡(y)\\frac{\\text{d}y}{\\text{d}x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467052} {:answer-field/choices [{:answer/id #uuid "56ff9540-7748-56d0-8dcc-17c53b286037" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466419} {:answer/id #uuid "99c15a2b-52b5-5f4f-a9bd-e392ccd7dd01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466420}] :answer-field/correct {:answer/id #uuid "56ff9540-7748-56d0-8dcc-17c53b286037" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466419} :answer-field/id #uuid "fbafeabb-acd0-55ae-b50b-63a06106240a" :answer-field/key "${D}_{2}(y)=x\\operatorname{tan}⁡(y)\\,\\frac{{\\text{d}}^{3}y}{\\text{d}{x}^{3}}+y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467053} {:answer-field/choices [{:answer/id #uuid "71c453fc-3161-5efe-87c9-b5487086f7eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466421} {:answer/id #uuid "d3699871-4a43-5354-8111-f56a66a66074" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466422}] :answer-field/correct {:answer/id #uuid "d3699871-4a43-5354-8111-f56a66a66074" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466422} :answer-field/id #uuid "31b0a69c-b01a-51bf-ad6d-bd58d94109aa" :answer-field/key "${D}_{3}(y)$ $=(1+{x}^{2})\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ $+\\operatorname{ln}⁡(1+x)\\frac{\\text{d}y}{\\text{d}x}$ $+\\frac{3}{{x}^{2}}y$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467054} {:answer-field/choices [{:answer/id #uuid "49d6fb0b-316a-5d15-b1d5-95c342c77c76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668585} {:answer/id #uuid "15c9488a-33cc-5ac4-967e-bd5b36adb4f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668586}] :answer-field/correct {:answer/id #uuid "49d6fb0b-316a-5d15-b1d5-95c342c77c76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668585} :answer-field/id #uuid "bd3cf9c7-f79b-51f9-8c28-c951359caf16" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668870}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c1c5937c-0d4d-5848-8380-65f08dc10e61" :question/math-academy-id "q-338104" :question/problem "Which of the following are linear differential operators?\n\nSelect all that apply." :question/worked-solution "An $n$th-order differential operator $L$ is linear if it is of the following form:\n\n$$\nL(y)={f}_{n}(x)\\frac{{\\text{d}}^{n}y}{\\text{d}{x}^{n}}+{f}_{n-1}(x)\\frac{{\\text{d}}^{n-1}y}{\\text{d}{x}^{n-1}}+⋯+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwhere each ${f}_{i}$ is a function of $x$ only. \n\nWith that in mind, let's check each operator.\n\n- Operator ${D}_{1}$ is *not* linear. The coefficient of the second term is $\\operatorname{sin}⁡(y),$ which depends on $y$ and therefore fails linearity.\n\n- Operator ${D}_{2}$ is *not* linear. The coefficient of the first term is $x\\operatorname{tan}⁡(y),$ which depends on $y$ and therefore fails linearity.\n\n- Operator ${D}_{3}$ is linear. It is a second-order linear differential operator of the form\n\n$$\n{D}_{3}(y)={f}_{2}(x)\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwith ${f}_{2}(x)=1+{x}^{2},{f}_{1}(x)=\\operatorname{ln}⁡(1+x),$ and ${f}_{0}(x)=\\frac{3}{{x}^{2}}.$\n\nTherefore, the correct answer is ${D}_{3}(y)$ $=(1+{x}^{2})\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ $+\\operatorname{ln}⁡(1+x)\\frac{\\text{d}y}{\\text{d}x}$ $+\\frac{3}{{x}^{2}}y$ only."} {:db/id #edb/ref 17592186314812 :knowledge-point/_questions [{:db/id #edb/ref 17592186129316 :knowledge-point/id #uuid "28939f65-9fd6-564d-a0c2-73c1038ac898" :knowledge-point/title "Identifying Homogeneous and Inhomogeneous Systems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d8056b2-2a73-571e-b455-5dc959eab75c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467094} {:answer/id #uuid "19066ca7-4b35-5bbc-916c-8942673e263a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467095}] :answer-field/correct {:answer/id #uuid "19066ca7-4b35-5bbc-916c-8942673e263a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467095} :answer-field/id #uuid "e2d11d82-97b5-5b1e-915e-55ea8d5404b4" :answer-field/key "${x}^{′}(t)=\\begin{bmatrix}4 & -8 \\\\ 0 & 0\\end{bmatrix}x(t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468268} {:answer-field/choices [{:answer/id #uuid "4b07810f-ee82-5427-bc3c-6e03044e112d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467096} {:answer/id #uuid "83f2e770-7ab3-5255-bb2f-cb9e2b28e8d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467097}] :answer-field/correct {:answer/id #uuid "83f2e770-7ab3-5255-bb2f-cb9e2b28e8d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467097} :answer-field/id #uuid "f23e06d0-8cb5-5713-a17a-0e2f451fb7be" :answer-field/key "${x}^{′}(t)=\\begin{bmatrix}2 & 1 \\\\ -1 & 2\\end{bmatrix}x(t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468269} {:answer-field/choices [{:answer/id #uuid "7b167c9a-3b03-5972-8017-bab5080db934" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467098} {:answer/id #uuid "d231795b-8757-56af-91b9-2c6cfcf69d5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467099}] :answer-field/correct {:answer/id #uuid "d231795b-8757-56af-91b9-2c6cfcf69d5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467099} :answer-field/id #uuid "6ebb5d0b-f2f2-5117-9404-8eb5fae48147" :answer-field/key "${x}^{′}(t)=\\begin{bmatrix}1 & 2 \\\\ 3 & 4\\end{bmatrix}x(t)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468270} {:answer-field/choices [{:answer/id #uuid "d2c03e4f-742b-5ffd-a2bd-5c5e8d441871" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668587} {:answer/id #uuid "6792b0d5-57eb-5625-bc1b-fb56aa6dd78f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668588}] :answer-field/correct {:answer/id #uuid "d2c03e4f-742b-5ffd-a2bd-5c5e8d441871" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668587} :answer-field/id #uuid "fcdb10dd-7180-5212-bd26-303ded096eb4" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668871}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d50aebed-a4c6-5b64-b5c3-ebb00a836540" :question/math-academy-id "q-339658" :question/problem "Which of the following systems are homogeneous?\n\nSelect all that apply." :question/worked-solution "In matrix form, the system\n\n$$\n{x}^{′}(t)=A(t)x(t)+f(t)\n$$\n\nis *homogeneous* when $f≡0,$ and *inhomogeneous* when $f≢0.$\n\nWith this in mind, let's inspect each system:\n\n- System ${x}^{′}(t)=\\begin{bmatrix}4 & -8 \\\\ 0 & 0\\end{bmatrix}x(t)$ is homogeneous since $f≡0.$\n\n- System ${x}^{′}(t)=\\begin{bmatrix}2 & 1 \\\\ -1 & 2\\end{bmatrix}x(t)$ is homogeneous since $f≡0.$\n\n- System ${x}^{′}(t)=\\begin{bmatrix}1 & 2 \\\\ 3 & 4\\end{bmatrix}x(t)$ is homogeneous since $f≡0.$\n\nTherefore, the correct answer is ${x}^{′}(t)=\\begin{bmatrix}4 & -8 \\\\ 0 & 0\\end{bmatrix}x(t)$; ${x}^{′}(t)=\\begin{bmatrix}2 & 1 \\\\ -1 & 2\\end{bmatrix}x(t)$; ${x}^{′}(t)=\\begin{bmatrix}1 & 2 \\\\ 3 & 4\\end{bmatrix}x(t)$."} {:db/id #edb/ref 17592186314813 :knowledge-point/_questions [{:db/id #edb/ref 17592186129316 :knowledge-point/id #uuid "28939f65-9fd6-564d-a0c2-73c1038ac898" :knowledge-point/title "Identifying Homogeneous and Inhomogeneous Systems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1015030b-9dc0-59b2-a199-21b03bef2718" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467100} {:answer/id #uuid "dad9ffc4-12f0-5fc1-8c72-3d4ee6a0f268" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467101}] :answer-field/correct {:answer/id #uuid "dad9ffc4-12f0-5fc1-8c72-3d4ee6a0f268" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467101} :answer-field/id #uuid "d9296136-c645-521c-bb63-058fcb9fb89f" :answer-field/key "${x}^{′}(t)=\\begin{bmatrix}2 & -1 \\\\ 0 & 3\\end{bmatrix}x(t)$" :answer-field/type {:db/id #edb/re