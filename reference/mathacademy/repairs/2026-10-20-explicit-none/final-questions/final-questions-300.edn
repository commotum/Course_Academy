-0f68-512e-9fed-4c8095e6b7b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668589} {:answer/id #uuid "80fe7909-a803-54d6-b053-f5eaa03da4f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668590}] :answer-field/correct {:answer/id #uuid "394e061c-0f68-512e-9fed-4c8095e6b7b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668589} :answer-field/id #uuid "474823cb-aee5-5768-b6a7-58bea3460d1a" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668872}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d86591cd-cf9c-5b7c-ab46-ee83fbeda055" :question/math-academy-id "q-339661" :question/problem "Which of the following systems are homogeneous?\n\nSelect all that apply." :question/worked-solution "In matrix form, the system\n\n$$\n{x}^{′}(t)=A(t)x(t)+f(t)\n$$\n\nis *homogeneous* when $f≡0,$ and *inhomogeneous* when $f≢0.$\n\nWith this in mind, let's inspect each system:\n\n- System ${x}^{′}(t)=\\begin{bmatrix}2 & -1 \\\\ 0 & 3\\end{bmatrix}x(t)$ is homogeneous since $f≡0.$\n\n- System ${x}^{′}(t)=\\begin{bmatrix}1 & 1 \\\\ 1 & 1\\end{bmatrix}x(t)+\\begin{bmatrix}t \\\\ 1\\end{bmatrix}$ is inhomogeneous since $f=\\begin{bmatrix}t \\\\ 1\\end{bmatrix}≢0.$\n\n- System ${x}^{′}(t)=\\begin{bmatrix}0 & 1 \\\\ -1 & 0\\end{bmatrix}x(t)+\\begin{bmatrix}\\operatorname{cos}⁡(t) \\\\ \\operatorname{sin}⁡(t)\\end{bmatrix}$ is inhomogeneous since $f=\\begin{bmatrix}\\operatorname{cos}⁡(t) \\\\ \\operatorname{sin}⁡(t)\\end{bmatrix}≢0.$\n\nTherefore, the correct answer is ${x}^{′}(t)=\\begin{bmatrix}2 & -1 \\\\ 0 & 3\\end{bmatrix}x(t)$ only."} {:db/id #edb/ref 17592186314814 :knowledge-point/_questions [{:db/id #edb/ref 17592186129316 :knowledge-point/id #uuid "28939f65-9fd6-564d-a0c2-73c1038ac898" :knowledge-point/title "Identifying Homogeneous and Inhomogeneous Systems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "899117d7-db47-58c1-8b04-71ff13db84ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467106} {:answer/id #uuid "c51319a9-62aa-53bf-977b-1b28d347c8d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467107}] :answer-field/correct {:answer/id #uuid "c51319a9-62aa-53bf-977b-1b28d347c8d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467107} :answer-field/id #uuid "7811e01e-7754-5558-a044-86b309427f20" :answer-field/key "$\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=-2{x}_{1}(t)+{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=4{x}_{1}(t)-{x}_{2}(t)\\end{aligned}\\right.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468274} {:answer-field/choices [{:answer/id #uuid "ea6cd620-ed14-54e4-8d80-41ebc61e1d4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467108} {:answer/id #uuid "934a6947-dd5d-54b5-bf56-c18d89fefdaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467109}] :answer-field/correct {:answer/id #uuid "ea6cd620-ed14-54e4-8d80-41ebc61e1d4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467108} :answer-field/id #uuid "26240d32-05e4-5a29-bd70-9c4756fb5be2" :answer-field/key "$\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &={x}_{1}(t)+2{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=-{x}_{1}(t)+t\\end{aligned}\\right.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468275} {:answer-field/choices [{:answer/id #uuid "46c0bc7d-9227-55bc-b43d-05893caeff18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467110} {:answer/id #uuid "255a0fd0-e3a2-5794-a709-e0ee7f3d415d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467111}] :answer-field/correct {:answer/id #uuid "255a0fd0-e3a2-5794-a709-e0ee7f3d415d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467111} :answer-field/id #uuid "0319c04f-0988-5a05-98de-dc9e795cbf20" :answer-field/key "$\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &={x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=-{x}_{1}(t)\\end{aligned}\\right.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468276} {:answer-field/choices [{:answer/id #uuid "db84ac80-d8d1-5beb-8004-2dae70263f4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668591} {:answer/id #uuid "c2b978dd-f55e-55f1-8813-c5dc415888cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668592}] :answer-field/correct {:answer/id #uuid "db84ac80-d8d1-5beb-8004-2dae70263f4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668591} :answer-field/id #uuid "fff208b9-3a16-5170-a939-f901ba89d6eb" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668873}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1a032209-c882-5496-a788-3681657f5173" :question/math-academy-id "q-339663" :question/problem "Which of the following systems are homogeneous?\n\nSelect all that apply." :question/worked-solution "Recall that a first-order linear system of differential equations with two dependent variables is a system of the form\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=a(t){x}_{1}(t)+b(t){x}_{2}(t)+f(t) \\\\ {x}_{2}^{′}(t) &=c(t){x}_{1}(t)+d(t){x}_{2}(t)+g(t).\\end{aligned}\\right.\n$$\n\nIf $f≡0$ and $g≡0$ (i.e., both $f$ and $g$ are zero functions), then the system is *homogeneous*. Otherwise, if at least one of $f$ or $g$ is not identically zero, the system is *inhomogeneous*.\n\nWith this in mind, let's inspect each system:\n\n- System $\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=-2{x}_{1}(t)+{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=4{x}_{1}(t)-{x}_{2}(t)\\end{aligned}\\right.$ is homogeneous since it can be written in the standard form with $f≡0$ and $g≡0:$\n\n$$\n\\begin{aligned}a(t)=-2, &  & b(t)=1, &  & f(t)=0 \\\\ c(t)=4, &  & d(t)=-1, &  & g(t)=0\\end{aligned}\n$$\n\n- System $\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &={x}_{1}(t)+2{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=-{x}_{1}(t)+t\\end{aligned}\\right.$ is inhomogeneous since it can be written in the standard form with $g≢0:$\n\n$$\n\\begin{aligned}a(t)=1, &  & b(t)=2, &  & f(t)=0 \\\\ c(t)=-1, &  & d(t)=0, &  & g(t)=t\\end{aligned}\n$$\n\n- System $\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &={x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=-{x}_{1}(t)\\end{aligned}\\right.$ is homogeneous since it can be written in the standard form with $f≡0$ and $g≡0:$\n\n$$\n\\begin{aligned}a(t)=0, &  & b(t)=1, &  & f(t)=0 \\\\ c(t)=-1, &  & d(t)=0, &  & g(t)=0\\end{aligned}\n$$\n\nTherefore, the correct answer is $\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=-2{x}_{1}(t)+{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=4{x}_{1}(t)-{x}_{2}(t)\\end{aligned}\\right.$; $\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &={x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=-{x}_{1}(t)\\end{aligned}\\right.$ only."} {:db/id #edb/ref 17592186314817 :knowledge-point/_questions [{:db/id #edb/ref 17592186129316 :knowledge-point/id #uuid "28939f65-9fd6-564d-a0c2-73c1038ac898" :knowledge-point/title "Identifying Homogeneous and Inhomogeneous Systems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a16b4af-a3c6-52be-9017-ad0ff1124280" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467124} {:answer/id #uuid "a4a091fe-c72f-5f93-9d2b-1f06e62d6afc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467125}] :answer-field/correct {:answer/id #uuid "0a16b4af-a3c6-52be-9017-ad0ff1124280" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467124} :answer-field/id #uuid "c96620b0-a25e-53c9-addc-4724bc41e2fb" :answer-field/key "$\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=3{x}_{1}(t)+2{x}_{2}(t)+\\operatorname{ln}⁡(5t) \\\\ {x}_{2}^{′}(t) &=-{x}_{1}(t)+4{x}_{2}(t)+1\\end{aligned}\\right.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468283} {:answer-field/choices [{:answer/id #uuid "bae1c72d-b801-5e76-b195-593b182a757e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467126} {:answer/id #uuid "71b25915-a547-5dea-8e7d-6ef8de74b585" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467127}] :answer-field/correct {:answer/id #uuid "71b25915-a547-5dea-8e7d-6ef8de74b585" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467127} :answer-field/id #uuid "8dd3d80f-1d80-5b15-9c50-2481adf059bc" :answer-field/key "$\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=-{x}_{1}(t)+{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=5{x}_{1}(t)+6{x}_{2}(t)\\end{aligned}\\right.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468284} {:answer-field/choices [{:answer/id #uuid "a6ad4a64-2d4c-5a05-935d-21b75b394c29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467128} {:answer/id #uuid "73396a32-eb81-5b5d-8986-0369cb82f7b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467129}] :answer-field/correct {:answer/id #uuid "a6ad4a64-2d4c-5a05-935d-21b75b394c29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467128} :answer-field/id #uuid "8e315c1f-d9bb-5594-a4f3-b6684053e206" :answer-field/key "$\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=4{x}_{1}(t)+{e}^{2} \\\\ {x}_{2}^{′}(t) &={x}_{2}(t)+3t\\end{aligned}\\right.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468285} {:answer-field/choices [{:answer/id #uuid "9592c02c-233d-5c02-b125-d4b99ea45161" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668593} {:answer/id #uuid "ed6e2c0f-dc4e-5b45-8254-cd15ad4d67a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668594}] :answer-field/correct {:answer/id #uuid "9592c02c-233d-5c02-b125-d4b99ea45161" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668593} :answer-field/id #uuid "6f3b741a-0edd-537d-8dbf-9eb6f1782924" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668874}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d6099dfb-5cd3-520d-98c0-7759f4ae7ca2" :question/math-academy-id "q-339672" :question/problem "Which of the following systems are homogeneous?\n\nSelect all that apply." :question/worked-solution "Recall that a first-order linear system of differential equations with two dependent variables is a system of the form\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=a(t){x}_{1}(t)+b(t){x}_{2}(t)+f(t) \\\\ {x}_{2}^{′}(t) &=c(t){x}_{1}(t)+d(t){x}_{2}(t)+g(t).\\end{aligned}\\right.\n$$\n\nIf $f≡0$ and $g≡0$ (i.e., both $f$ and $g$ are zero functions), then the system is *homogeneous*. Otherwise, if at least one of $f$ or $g$ is not identically zero, the system is *inhomogeneous*.\n\nWith this in mind, let's inspect each system:\n\n- System $\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=3{x}_{1}(t)+2{x}_{2}(t)+\\operatorname{ln}⁡(5t) \\\\ {x}_{2}^{′}(t) &=-{x}_{1}(t)+4{x}_{2}(t)+1\\end{aligned}\\right.$ is inhomogeneous since it can be written in the standard form with $f≢0$ and $g≢0:$\n\n$$\n\\begin{aligned}a(t)=3, &  & b(t)=2, &  & f(t)=\\operatorname{ln}⁡(5t) \\\\ c(t)=-1, &  & d(t)=4, &  & g(t)=1\\end{aligned}\n$$\n\n- System $\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=-{x}_{1}(t)+{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=5{x}_{1}(t)+6{x}_{2}(t)\\end{aligned}\\right.$ is homogeneous since it can be written in the standard form with $f≡0$ and $g≡0:$\n\n$$\n\\begin{aligned}a(t)=-1, &  & b(t)=1, &  & f(t)=0 \\\\ c(t)=5, &  & d(t)=6, &  & g(t)=0\\end{aligned}\n$$\n\n- System $\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=4{x}_{1}(t)+{e}^{2} \\\\ {x}_{2}^{′}(t) &={x}_{2}(t)+3t\\end{aligned}\\right.$ is inhomogeneous since it can be written in the standard form with $f≢0$ and $g≢0:$\n\n$$\n\\begin{aligned}a(t)=4, &  & b(t)=0, &  & f(t)={e}^{2} \\\\ c(t)=0, &  & d(t)=1, &  & g(t)=3t\\end{aligned}\n$$\n\nTherefore, the correct answer is $\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=-{x}_{1}(t)+{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=5{x}_{1}(t)+6{x}_{2}(t)\\end{aligned}\\right.$ only."} {:db/id #edb/ref 17592186317234 :knowledge-point/_questions [{:db/id #edb/ref 17592186124677 :knowledge-point/id #uuid "9e7d1368-06ee-5135-b9f4-d3d4d2756b32" :knowledge-point/title "Identifying Regular and Irregular Singular Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e9a4c96-43fa-5287-87ab-e21349de37d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467190} {:answer/id #uuid "276c2b5f-dd00-52b7-8c1d-6ce75f463861" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467191}] :answer-field/correct {:answer/id #uuid "276c2b5f-dd00-52b7-8c1d-6ce75f463861" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467191} :answer-field/id #uuid "fe7daa95-4d2d-517d-9d71-1edb7ff485f9" :answer-field/key "The functions $P(x)=\\frac{x}{{x}^{2}-1}$ and $Q(x)=\\frac{{e}^{x}}{{x}^{2}-1}$ are analytic about $x=0.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468316} {:answer-field/choices [{:answer/id #uuid "af517c28-aae7-53be-b6d7-3b41927254b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467192} {:answer/id #uuid "92f7e79b-d815-5ee2-9318-38d9f2b65ab5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467193}] :answer-field/correct {:answer/id #uuid "92f7e79b-d815-5ee2-9318-38d9f2b65ab5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467193} :answer-field/id #uuid "8226dddc-7d72-59c3-b2bb-d0c8e17007a2" :answer-field/key "The functions $xP(x)$ and ${x}^{2}Q(x)$ are analytic about $x=0.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468317} {:answer-field/choices [{:answer/id #uuid "171850f3-b5d7-5b49-9740-52d5f9f4f4d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467194} {:answer/id #uuid "222fcf3d-3109-5f47-a245-e67afddc63cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467195}] :answer-field/correct {:answer/id #uuid "171850f3-b5d7-5b49-9740-52d5f9f4f4d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467194} :answer-field/id #uuid "072ca5e1-ee75-57ee-8c43-02549fc0ad4f" :answer-field/key "The point $x=0$ is a **regular** singular point of the differential equation." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468318} {:answer-field/choices [{:answer/id #uuid "e399f942-c9b3-551e-8428-61add603d800" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668595} {:answer/id #uuid "f9f2dbc8-403a-5652-8e04-37293fde61bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668596}] :answer-field/correct {:answer/id #uuid "e399f942-c9b3-551e-8428-61add603d800" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668595} :answer-field/id #uuid "557b670b-f53e-5cdf-8989-29ec2cde5c0d" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668875}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fac58339-a2d8-5129-8e48-737c1bfcbe88" :question/math-academy-id "q-342299" :question/problem "$$\n({x}^{2}-1){y}^{″}+x{y}^{′}+{e}^{x}y=0\n$$\n\nConsider the differential equation given above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A singular point $x=a$ of the differential equation\n\n$$\n{y}^{″}+P(x){y}^{′}+Q(x)y=f(x)\n$$\n\nis regular if both $(x-a)P(x)$ and $(x-a)^{2}Q(x)$ are analytic about $x=a.$ Otherwise, the singular point is irregular.\n\nFirst, we rewrite the differential equation in standard form by dividing by $({x}^{2}-1):$\n\n$$\n\\begin{aligned}({x}^{2}-1){y}^{″}+x{y}^{′}+{e}^{x}y & =0 \\\\ {y}^{″}+\\frac{x}{{x}^{2}-1}{y}^{′}+\\frac{{e}^{x}}{{x}^{2}-1}y & =0\\end{aligned}\n$$\n\nSo, we have\n\n$$\nP(x)=\\frac{x}{{x}^{2}-1}\\,\\text{and}\\,Q(x)=\\frac{{e}^{x}}{{x}^{2}-1}.\n$$\n\nLet's now check each statement in turn.\n\n- Both $P(x)$ and $Q(x)$ are analytic about $x=0.$ So, statement “The functions $P(x)=\\frac{x}{{x}^{2}-1}$ and $Q(x)=\\frac{{e}^{x}}{{x}^{2}-1}$ are analytic about $x=0.$” is true.\n\n- Since $P(x)$ and $Q(x)$ are analytic about $x=0,$ multiplying them by $x$ and ${x}^{2},$ respectively, they remain analytic about $x=0.$ Therefore, statement “The functions $xP(x)$ and ${x}^{2}Q(x)$ are analytic about $x=0.$” is true.\n\n- Since statement “The functions $P(x)=\\frac{x}{{x}^{2}-1}$ and $Q(x)=\\frac{{e}^{x}}{{x}^{2}-1}$ are analytic about $x=0.$” is true, $x=0$ is an ordinary point, not a singular point. Thus, statement “The point $x=0$ is a **regular** singular point of the differential equation” is false.\n\nTherefore, the correct answer is “The functions $P(x)=\\frac{x}{{x}^{2}-1}$ and $Q(x)=\\frac{{e}^{x}}{{x}^{2}-1}$ are analytic about $x=0.$”; “The functions $xP(x)$ and ${x}^{2}Q(x)$ are analytic about $x=0.$” only."} {:db/id #edb/ref 17592186317235 :knowledge-point/_questions [{:db/id #edb/ref 17592186124677 :knowledge-point/id #uuid "9e7d1368-06ee-5135-b9f4-d3d4d2756b32" :knowledge-point/title "Identifying Regular and Irregular Singular Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b7793ce5-15ff-5b47-a37d-9da5824b876c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467196} {:answer/id #uuid "b3f71b86-58a1-549c-8d6f-3b8b5e3a54dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467197}] :answer-field/correct {:answer/id #uuid "b7793ce5-15ff-5b47-a37d-9da5824b876c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467196} :answer-field/id #uuid "8409e5b2-c7a3-5cdb-888a-155f06ea7493" :answer-field/key "The functions $P(x)=\\frac{1}{x}$ and $Q(x)=\\frac{1}{{x}^{2}}$ are analytic about $x=0.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468319} {:answer-field/choices [{:answer/id #uuid "6299e52e-8932-5c1a-a081-893c3d68d775" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467198} {:answer/id #uuid "fd4fb28e-9720-5ef3-a59c-b822e0d712e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467199}] :answer-field/correct {:answer/id #uuid "fd4fb28e-9720-5ef3-a59c-b822e0d712e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467199} :answer-field/id #uuid "6238fb21-5d0c-51a9-a39c-230145dd17ce" :answer-field/key "The functions $xP(x)$ and ${x}^{2}Q(x)$ are analytic about $x=0.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468320} {:answer-field/choices [{:answer/id #uuid "95e1469b-461d-569b-b247-6fdc19f5ee8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467200} {:answer/id #uuid "ead7cfc0-2c13-575b-a9ba-0f6e4e25e709" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467201}] :answer-field/correct {:answer/id #uuid "95e1469b-461d-569b-b247-6fdc19f5ee8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467200} :answer-field/id #uuid "457626e7-0327-5d43-9dd1-76fd6a6f102e" :answer-field/key "The point $x=0$ is an **irregular** singular point of the differential equation." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468321} {:answer-field/choices [{:answer/id #uuid "65599964-eae2-5848-96dd-3afd7023ac22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668597} {:answer/id #uuid "410e7345-979c-5c89-b0f0-c5223d337065" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668598}] :answer-field/correct {:answer/id #uuid "65599964-eae2-5848-96dd-3afd7023ac22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668597} :answer-field/id #uuid "8da33f62-39ba-5078-9bcf-dad6cbe603c5" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668876}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "182bf2f2-0927-5526-ba0f-19a051c0f88c" :question/math-academy-id "q-342300" :question/problem "$$\n{x}^{2}{y}^{″}+x{y}^{′}+y=0\n$$\n\nConsider the differential equation given above. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "A singular point $x=a$ of the differential equation\n\n$$\n{y}^{″}+P(x){y}^{′}+Q(x)y=f(x)\n$$\n\nis regular if both $(x-a)P(x)$ and $(x-a)^{2}Q(x)$ are analytic about $x=a.$ Otherwise, the singular point is irregular.\n\nFirst, we rewrite the differential equation in standard form by dividing by ${x}^{2}:$\n\n$$\n\\begin{aligned}{x}^{2}{y}^{″}+x{y}^{′}+y & =0 \\\\ {y}^{″}+\\frac{1}{x}{y}^{′}+\\frac{1}{{x}^{2}}y & =0\\end{aligned}\n$$\n\nSo, we have\n\n$$\nP(x)=\\frac{1}{x}\\,\\text{and}\\,Q(x)=\\frac{1}{{x}^{2}}.\n$$\n\nLet's now check each statement in turn.\n\n- Since the denominators of both $P(x)$ and $Q(x)$ vanish at $x=0,$ they are *not* analytic about $x=0.$ So, statement “The functions $P(x)=\\frac{1}{x}$ and $Q(x)=\\frac{1}{{x}^{2}}$ are analytic about $x=0.$” is false.\n\n- The function\n\n$$\nxP(x)=x\\cdot \\frac{1}{x}=1\n$$\n\nis analytic about $x=0,$ and the function\n\n$$\n{x}^{2}Q(x)={x}^{2}\\cdot \\frac{1}{{x}^{2}}=1\n$$\n\nis also analytic about $x=0.$ Therefore, statement “The functions $xP(x)$ and ${x}^{2}Q(x)$ are analytic about $x=0.$” is true.\n\n- Since statement “The functions $P(x)=\\frac{1}{x}$ and $Q(x)=\\frac{1}{{x}^{2}}$ are analytic about $x=0.$” is false, $x=0$ is a singular point. Also, since statement “The functions $xP(x)$ and ${x}^{2}Q(x)$ are analytic about $x=0.$” is true, it follows that $x=0$ is a **regular** singular point. Thus, statement “The point $x=0$ is an **irregular** singular point of the differential equation” is false.\n\nTherefore, the correct answer is “The functions $xP(x)$ and ${x}^{2}Q(x)$ are analytic about $x=0.$” only."} {:db/id #edb/ref 17592186317236 :knowledge-point/_questions [{:db/id #edb/ref 17592186124677 :knowledge-point/id #uuid "9e7d1368-06ee-5135-b9f4-d3d4d2756b32" :knowledge-point/title "Identifying Regular and Irregular Singular Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ff0f11c-1635-5de0-bb9b-318cebabf753" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467202} {:answer/id #uuid "6520152a-550e-51db-86ef-17b9ab825abd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186