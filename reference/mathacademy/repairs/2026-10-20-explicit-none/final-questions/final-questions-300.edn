eld.type/checkbox} :db/id #edb/ref 17592186466990} {:answer-field/choices [{:answer/id #uuid "7ceea4e5-9793-50bb-8c56-b2d422525637" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466295} {:answer/id #uuid "97841c80-6e56-5adb-9408-75ee7c8afebf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466296}] :answer-field/correct {:answer/id #uuid "97841c80-6e56-5adb-9408-75ee7c8afebf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466296} :answer-field/id #uuid "040257a7-e75b-5b8f-94b5-f87d56de22ed" :answer-field/key "${F}_{3}(t)={\\int }_{0}^{1}\\frac{1}{1+x+t}\\,\\text{d}x,\\,t\\in (0,1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466991} {:answer-field/choices [{:answer/id #uuid "17b55312-901b-502c-8968-75ce7995a52c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668555} {:answer/id #uuid "0dbf7800-a4f4-58d9-a851-e26979a2023e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668556}] :answer-field/correct {:answer/id #uuid "17b55312-901b-502c-8968-75ce7995a52c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668555} :answer-field/id #uuid "28f78f8c-62e2-5127-a099-556a9a9e0419" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668855}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0a8a1841-dc47-5a84-bd2d-e5c201943d9f" :question/math-academy-id "q-335246" :question/problem "For which of the following functions is it valid to differentiate under the integral sign?\n\nSelect all that apply." :question/worked-solution "Suppose $f(x,t)$ is continuous on $R=[a,b]\\times [c,d]$ and $\\frac{∂f}{∂t}$ exists and is continuous on $R.$ Then, the function\n\n$$\nF(t)={\\int }_{a}^{b}f(x,t)\\,\\text{d}x\n$$\n\nis differentiable on $(c,d),$ and\n\n$$\n{F}^{′}(t)=\\frac{\\text{d}}{\\text{d}t}{\\int }_{a}^{b}f(x,t)\\,\\text{d}x={\\int }_{a}^{b}\\frac{∂f}{∂t}(x,t)\\,\\text{d}x.\n$$\n\nThis is known as *differentiating under the integral sign.*\n\nWith that in mind, let's check each function:\n\n- For the first function, we have \n\n$$\n{f}_{1}(x,t)=\\frac{1}{\\sqrt[3]{|x-t|}}.\n$$\n\nWe fix ${t}_{0}\\in (0,1)$ and choose $c<{t}_{0}<d$ such that $[c,d]⊆(0,1),$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{1}$ is undefined when $x=t,$ since the denominator vanishes. Thus, ${f}_{1}$ is not continuous on $R,$ and differentiating under the integral sign is *not* valid.\n\n- For the second function, we have \n\n$$\n{f}_{2}(x,t)=\\frac{x}{1+{t}^{2}}.\n$$\n\nWe fix ${t}_{0}\\in R$ and choose $c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{2}$ is continuous on $R.$ Computing the partial derivative, we have\n\n$$\n\\frac{∂{f}_{2}}{∂t}=-\\frac{2tx}{(1+{t}^{2})^{2}}\n$$\n\nwhich exists and is continuous on $R.$ Thus, differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{2}^{′}(t)$ for all real $t.$\n\n- For the third function, we have \n\n$$\n{f}_{3}(x,t)=\\frac{1}{1+x+t}.\n$$\n\nWe fix ${t}_{0}\\in (0,1)$ and choose $c<{t}_{0}<d$ such that $[c,d]⊂(0,1),$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{3}$ is continuous on $R$ (since the denominator never vanishes on $R$). Computing the partial derivative, we have\n\n$$\n\\frac{∂{f}_{3}}{∂t}=-\\frac{1}{(1+x+t)^{2}}\n$$\n\nwhich exists and is continuous on $R.$ Thus, differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{3}^{′}(t)$ for all $t\\in (0,1).$\n\nTherefore, the correct answer is ${F}_{2}(t)={\\int }_{0}^{1}\\frac{x}{1+{t}^{2}}\\,\\text{d}x,\\,t\\in R$; ${F}_{3}(t)={\\int }_{0}^{1}\\frac{1}{1+x+t}\\,\\text{d}x,\\,t\\in (0,1)$ only."} {:db/id #edb/ref 17592186311550 :knowledge-point/_questions [{:db/id #edb/ref 17592186229192 :knowledge-point/id #uuid "bbefb3bb-4783-5d77-b404-1f43ee8765de" :knowledge-point/title "Identifying Cases Where Differentiating Under the Integral Sign Applies"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b300e0b9-d29d-5f4a-b4c6-ddf029e8438c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466297} {:answer/id #uuid "048f2c66-c0d9-54d0-b540-10593e6a06b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466298}] :answer-field/correct {:answer/id #uuid "048f2c66-c0d9-54d0-b540-10593e6a06b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466298} :answer-field/id #uuid "abb212ca-feab-55fb-bbe5-bf2eaadf951c" :answer-field/key "${F}_{1}(t)={\\int }_{0}^{1}\\sqrt{x+t}\\,\\text{d}x,\\,t>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466992} {:answer-field/choices [{:answer/id #uuid "9dbd657e-103b-5d31-b5c6-791565f66d6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466299} {:answer/id #uuid "569d20a0-8036-5d36-bb7b-12d1ef5dc3b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466300}] :answer-field/correct {:answer/id #uuid "569d20a0-8036-5d36-bb7b-12d1ef5dc3b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466300} :answer-field/id #uuid "eafc1e72-ec71-5219-9230-3bf6c0ee7ba2" :answer-field/key "${F}_{2}(t)={\\int }_{0}^{1}\\frac{xt}{{x}^{2}+{t}^{2}}\\,\\text{d}x,\\,t>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466993} {:answer-field/choices [{:answer/id #uuid "58b98bf5-3fd9-5b73-9571-b262aca2b590" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466301} {:answer/id #uuid "d7d11a7e-0e24-5812-8b81-e408a2fa4534" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466302}] :answer-field/correct {:answer/id #uuid "d7d11a7e-0e24-5812-8b81-e408a2fa4534" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466302} :answer-field/id #uuid "e69c2a12-6035-509f-9da1-9d85906ac437" :answer-field/key "${F}_{3}(t)={\\int }_{0}^{1}\\frac{1}{x-t}\\,\\text{d}x,\\,t>1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466994} {:answer-field/choices [{:answer/id #uuid "e08d850d-4d9c-5f85-9bcf-069022276ce6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668557} {:answer/id #uuid "bf7df605-b778-547a-8ad8-3f5886364e89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668558}] :answer-field/correct {:answer/id #uuid "e08d850d-4d9c-5f85-9bcf-069022276ce6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668557} :answer-field/id #uuid "e4ccbb8b-ea1e-538d-a290-a51ef9f5a0ad" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668856}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9de6d57f-11dc-5bb2-bebc-d38ef2773685" :question/math-academy-id "q-335247" :question/problem "For which of the following functions is it valid to differentiate under the integral sign?\n\nSelect all that apply." :question/worked-solution "Suppose $f(x,t)$ is continuous on $R=[a,b]\\times [c,d]$ and $\\frac{∂f}{∂t}$ exists and is continuous on $R.$ Then, the function\n\n$$\nF(t)={\\int }_{a}^{b}f(x,t)\\,\\text{d}x\n$$\n\nis differentiable on $(c,d),$ and\n\n$$\n{F}^{′}(t)=\\frac{\\text{d}}{\\text{d}t}{\\int }_{a}^{b}f(x,t)\\,\\text{d}x={\\int }_{a}^{b}\\frac{∂f}{∂t}(x,t)\\,\\text{d}x.\n$$\n\nThis is known as *differentiating under the integral sign.*\n\nWith that in mind, let's check each function:\n\n- For the first function, we have \n\n$$\n{f}_{1}(x,t)=\\sqrt{x+t}.\n$$\n\nWe fix ${t}_{0}>0$ and choose $[c,d]⊂(0,\\infty )$ such that $c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{1}$ is continuous on $R.$ Computing the partial derivative, we have\n\n$$\n\\frac{∂{f}_{1}}{∂t}=\\frac{1}{2\\sqrt{x+t}},\n$$\n\nwhich exists and is continuous on $R$ (since $x+t\\ge c>0$ on $R$). Thus, differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{1}^{′}(t)$ for all real $t>0.$\n\n- For the second function, we have \n\n$$\n{f}_{2}(x,t)=\\frac{xt}{{x}^{2}+{t}^{2}}.\n$$\n\nWe fix ${t}_{0}>0$ and choose $[c,d]⊂(0,\\infty )$ such that $c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{2}$ is continuous on $R$ (since the denominator never vanishes on $R$). Computing the partial derivative, we have\n\n$$\n\\frac{∂{f}_{2}}{∂t}=\\frac{x({x}^{2}+{t}^{2})-2x{t}^{2}}{({x}^{2}+{t}^{2})^{2}},\n$$\n\nwhich exists and is continuous on $R.$ Thus, differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{2}^{′}(t)$ for all real $t>0.$\n\n- For the third function, we have \n\n$$\n{f}_{3}(x,t)=\\frac{1}{x-t}.\n$$\n\nWe fix ${t}_{0}>1$ and choose $[c,d]⊂(1,\\infty )$ such that $c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nNote that for $t>1$ and $x\\in [0,1],$ the denominator $x-t$ never vanishes on $R,$ so ${f}_{3}$ is continuous on $R.$ Computing the partial derivative, we have\n\n$$\n\\frac{∂{f}_{3}}{∂t}=\\frac{1}{(x-t)^{2}},\n$$\n\nwhich exists and is continuous on $R.$ Thus, differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{3}^{′}(t)$ for all real $t>1.$\n\nTherefore, the correct answer is ${F}_{1}(t)={\\int }_{0}^{1}\\sqrt{x+t}\\,\\text{d}x,\\,t>0$; ${F}_{2}(t)={\\int }_{0}^{1}\\frac{xt}{{x}^{2}+{t}^{2}}\\,\\text{d}x,\\,t>0$; ${F}_{3}(t)={\\int }_{0}^{1}\\frac{1}{x-t}\\,\\text{d}x,\\,t>1$."} {:db/id #edb/ref 17592186311551 :knowledge-point/_questions [{:db/id #edb/ref 17592186229192 :knowledge-point/id #uuid "bbefb3bb-4783-5d77-b404-1f43ee8765de" :knowledge-point/title "Identifying Cases Where Differentiating Under the Integral Sign Applies"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a4f09b1-f161-5622-a23d-b0ffdfb2d435" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466303} {:answer/id #uuid "fcd5f489-5a61-5601-8ecc-98a5906dddc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466304}] :answer-field/correct {:answer/id #uuid "fcd5f489-5a61-5601-8ecc-98a5906dddc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466304} :answer-field/id #uuid "0e605653-b47a-5ef7-9a12-6a6e858e1bbf" :answer-field/key "${F}_{1}(t)={\\int }_{0}^{1}{x}^{2}t{e}^{-xt}\\,\\text{d}x,\\,t>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466995} {:answer-field/choices [{:answer/id #uuid "22edb3de-f55b-58a1-9692-099dbd00066f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466305} {:answer/id #uuid "581893f8-2232-5da0-be5a-6d7f06e1d7e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466306}] :answer-field/correct {:answer/id #uuid "22edb3de-f55b-58a1-9692-099dbd00066f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466305} :answer-field/id #uuid "6c8b9f4c-0d1d-538d-9987-3817690edcc4" :answer-field/key "${F}_{2}(t)={\\int }_{0}^{1}\\frac{1}{|x-t|}\\,\\text{d}x,\\,t\\in (0,1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466996} {:answer-field/choices [{:answer/id #uuid "17a13b11-4489-5b2f-bce4-6df115f00f40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466307} {:answer/id #uuid "31dd6c34-6e6b-519e-82c4-6849b3fc2a97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466308}] :answer-field/correct {:answer/id #uuid "31dd6c34-6e6b-519e-82c4-6849b3fc2a97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466308} :answer-field/id #uuid "29ee4bc8-90a4-5de9-b5bb-ad229b502589" :answer-field/key "${F}_{3}(t)={\\int }_{0}^{1}\\frac{1}{(x-t)^{2}+1}\\,\\text{d}x,\\,t\\in [0,1]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466997} {:answer-field/choices [{:answer/id #uuid "dc5a1920-1272-5d69-a655-af55844f5cde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668559} {:answer/id #uuid "4e4024aa-e272-59d6-b3d3-1e95df296444" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668560}] :answer-field/correct {:answer/id #uuid "dc5a1920-1272-5d69-a655-af55844f5cde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668559} :answer-field/id #uuid "2fcccf1a-7559-5a7b-9d11-395ca6b4488d" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668857}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "57d1f543-d099-580f-9280-d60da64177c3" :question/math-academy-id "q-335248" :question/problem "For which of the following functions is it valid to differentiate under the integral sign?\n\nSelect all that apply." :question/worked-solution "Suppose $f(x,t)$ is continuous on $R=[a,b]\\times [c,d]$ and $\\frac{∂f}{∂t}$ exists and is continuous on $R.$ Then, the function\n\n$$\nF(t)={\\int }_{a}^{b}f(x,t)\\,\\text{d}x\n$$\n\nis differentiable on $(c,d),$ and\n\n$$\n{F}^{′}(t)=\\frac{\\text{d}}{\\text{d}t}{\\int }_{a}^{b}f(x,t)\\,\\text{d}x={\\int }_{a}^{b}\\frac{∂f}{∂t}(x,t)\\,\\text{d}x.\n$$\n\nThis is known as *differentiating under the integral sign.*\n\nWith that in mind, let's check each function:\n\n- For the first function, we have \n\n$$\n{f}_{1}(x,t)={x}^{2}t{e}^{-xt}.\n$$\n\nWe fix ${t}_{0}>0$ and choose $0<c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{1}$ is continuous on $R.$ Computing the partial derivative, we have\n\n$$\n\\frac{∂{f}_{1}}{∂t}={x}^{2}{e}^{-xt}-{x}^{3}t{e}^{-xt}\n$$\n\nwhich exists and is continuous on $R.$ Thus, differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{1}^{′}(t)$ for all $t>0.$\n\n- For the second function, we have \n\n$$\n{f}_{2}(x,t)=\\frac{1}{|x-t|}.\n$$\n\nWe fix ${t}_{0}\\in (0,1)$ and choose $c<{t}_{0}<d$ such that $[c,d]⊆(0,1),$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{2}$ is undefined when $x=t,$ since the denominator vanishes. Thus, ${f}_{2}$ is not continuous on $R,$ and differentiating under the integral sign is *not* valid.\n\n- For the third function, we have \n\n$$\n{f}_{3}(x,t)=\\frac{1}{(x-t)^{2}+1}.\n$$\n\nWe fix ${t}_{0}\\in (0,1)$ and choose $c<{t}_{0}<d$ such that $[c,d]⊆[0,1],$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{3}$ is continuous on $R$ because the denominator is always positive. Computing the partial derivative, we have\n\n$$\n\\frac{∂{f}_{3}}{∂t}=\\frac{2(x-t)}{{((x-t)^{2}+1)}^{2}}\n$$\n\nwhich exists and is continuous on $R.$ Thus, differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{3}^{′}(t)$ for all $t\\in [0,1].$\n\nTherefore, the correct answer is ${F}_{1}(t)={\\int }_{0}^{1}{x}^{2}t{e}^{-xt}\\,\\text{d}x,\\,t>0$; ${F}_{3}(t)={\\int }_{0}^{1}\\frac{1}{(x-t)^{2}+1}\\,\\text{d}x,\\,t\\in [0,1]$ only."} {:db/id #edb/ref 17592186311552 :knowledge-point/_questions [{:db/id #edb/ref 17592186229192 :knowledge-point/id #uuid "bbefb3bb-4783-5d77-b404-1f43ee8765de" :knowledge-point/title "Identifying Cases Where Differentiating Under the Integral Sign Applies"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "333a10d9-6acd-51bc-a542-e5834510336a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466309} {:answer/id #uuid "0896e53d-ce4d-51df-a6c6-c42afcb5b091" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466310}] :answer-field/correct {:answer/id #uuid "0896e53d-ce4d-51df-a6c6-c42afcb5b091" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466310} :answer-field/id #uuid "d140fccf-9864-5e7c-ab64-46dce6612c96" :answer-field/key "${F}_{1}(t)={\\int }_{0}^{1}\\frac{{t}^{2}}{{x}^{2}+{t}^{2}}\\,\\text{d}x,\\,t>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466998} {:answer-field/choices [{:answer/id #uuid "cf441900-eba8-530f-9a51-60c9dde68b74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466311} {:answer/id #uuid "1b704fe9-df2a-5b5b-835b-671871eaa101" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466312}] :answer-field/correct {:answer/id #uuid "cf441900-eba8-530f-9a51-60c9dde68b74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466311} :answer-field/id #uuid "97b4a9dc-d50b-57ee-a809-22e3de81aa9c" :answer-field/key "${F}_{2}(t)={\\int }_{0}^{1}\\frac{1}{\\sqrt{|x-t|}}\\,\\text{d}x,\\,t\\in (0,1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466999} {:answer-field/choices [{:answer/id #uuid "bc749d3b-d1da-5e3f-96d4-b8e2ecc22be3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466313} {:answer/id #uuid "11dac17e-58fd-523c-9348-ca7babe92e81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466314}] :answer-field/correct {:answer/id #uuid "11dac17e-58fd-523c-9348-ca7babe92e81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466314} :answer-field/id #uuid "6ebc44d1-abfd-536f-a11f-5b1f2580b68d" :answer-field/key "${F}_{3}(t)={\\int }_{0}^{1}\\operatorname{ln}⁡(x+{t}^{2})\\,\\text{d}x,\\,t>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467000} {:answer-field/choices [{:answer/id #uuid "4cff30a7-e647-58df-9dbb-4b3d58625058" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668561} {:answer/id #uuid "b6fc7477-ec04-5f57-a151-0b0856191466" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668562}] :answer-field/correct {:answer/id #uuid "4cff30a7-e647-58df-9dbb-4b3d58625058" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668561} :answer-field/id #uuid "84a0e519-a25f-534f-8f8f-9e2900d4ca9d" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668858}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b7963456-3a78-5141-94e0-577dece1c8b8" :question/math-academy-id "q-335249" :question/problem "For which of the following functions is it valid to differentiate under the integral sign?\n\nSelect all that apply." :question/worked-solution "Suppose $f(x,t)$ is continuous on $R=[a,b]\\times [c,d]$ and $\\frac{∂f}{∂t}$ exists and is continuous on $R.$ Then, the function\n\n$$\nF(t)={\\int }_{a}^{b}f(x,t)\\,\\text{d}x\n$$\n\nis differentiable on $(c,d),$ and\n\n$$\n{F}^{′}(t)=\\frac{\\text{d}}{\\text{d}t}{\\int }_{a}^{b}f(x,t)\\,\\text{d}x={\\int }_{a}^{b}\\frac{∂f}{∂t}(x,t)\\,\\text{d}x.\n$$\n\nThis is known as *differentiating under the integral sign.*\n\nWith that in mind, let's check each function:\n\n- For the first function, we have \n\n$$\n{f}_{1}(x,t)=\\frac{{t}^{2}}{{x}^{2}+{t}^{2}}.\n$$\n\nWe fix ${t}_{0}>0$ and choose $[c,d]⊂(0,\\infty )$ such that $c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{1}$ is continuous on $R$ because the denominator is always positive. Computing the partial derivative, we have\n\n$$\n\\frac{∂{f}_{1}}{∂t}=\\frac{2t({x}^{2}+{t}^{2})-2{t}^{3}}{({x}^{2}+{t}^{2})^{2}}=\\frac{2t{x}^{2}}{({x}^{2}+{t}^{2})^{2}}\n$$\n\nwhich exists and is continuous on $R.$ So, differentiating under the integral sign is valid for all $t>0.$\n\n- For the second function, we have \n\n$$\n{f}_{2}(x,t)=\\frac{1}{\\sqrt{|x-t|}}.\n$$\n\nWe fix ${t}_{0}\\in (0,1)$ and choose $[c,d]⊂(0,1)$ such that $c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nNote that this function is undefined when $x=t,$ since the denominator vanishes. Thus, ${f}_{2}$ is not continuous on $R,$ and differentiating under the integral sign is *not* valid.\n\n- For the third function, we have \n\n$$\n{f}_{3}(x,t)=\\operatorname{ln}⁡(x+{t}^{2}).\n$$\n\nWe fix ${t}_{0}>0$ and choose $[c,d]⊂(0,\\infty )$ such that $c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nSince $x\\in [0,1]$ and $t>0,$ we have $x+{t}^{2}>0,$ so ${f}_{3}$ is continuous. Computing the partial derivative, we have\n\n$$\n\\frac{∂{f}_{3}}{∂t}=\\frac{2t}{x+{t}^{2}}\n$$\n\nwhich exists and is continuous on $R.$ Thus, differentiating under the integral sign is valid for all $t>0.$\n\nTherefore, the correct answer is ${F}_{1}(t)={\\int }_{0}^{1}\\frac{{t}^{2}}{{x}^{2}+{t}^{2}}\\,\\text{d}x,\\,t>0$; ${F}_{3}(t)={\\int }_{0}^{1}\\operatorname{ln}⁡(x+{t}^{2})\\,\\text{d}x,\\,t>0$ only."} {:db/id #edb/ref 17592186311554 :knowledge-point/_questions [{:db/id #edb/ref 17592186229192 :knowledge-point/id #uuid "bbefb3bb-4783-5d77-b404-1f43ee8765de" :knowledge-point/title "Identifying Cases Where Differentiating Under the Integral Sign Applies"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cbf574b6-eadc-5800-be26-b717065fccf7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466315} {:answer/id #uuid "47094ddd-c2bd-538f-ac32-cd8b1a036024" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466316}] :answer-field/correct {:answer/id #uuid "47094ddd-c2bd-538f-ac32-cd8b1a036024" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466316} :answer-field/id #uuid "b7b8f2ac-6e53-518c-ac65-9b2a794b1a14" :answer-field/key "${F}_{1}(t)$ $={\\int }_{0}^{1}\\frac{\\operatorname{ln}⁡(1+tx)}{1+{x}^{2}}\\,\\text{d}x,$ $\\,t\\in (-1,1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467001} {:answer-field/choices [{:answer/id #uuid "09b24a03-0840-5112-a6ae-85ba64feb1ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466317} {:answer/id #uuid "19aece31-40c7-53b0-9e65-e7912b5a8f69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466318}] :answer-field/correct {:answer/id #uuid "19aece31-40c7-53b0-9e65-e7912b5a8f69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466318} :answer-field/id #uuid "58af3294-3290-5a03-bc06-7906ebd614eb" :answer-field/key "${F}_{2}(t)={\\int }_{0}^{1}\\frac{1}{x-t}\\,\\text{d}x,\\,t\\in (1,2)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467002} {:answer-field/choices [{:answer/id #uuid "b033fba9-aa64-512d-a47b-ee5a966fb49b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466319} {:answer/id #uuid "e3e28aaa-7313-5516-adc5-06bd1a4249cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466320}] :answer-field/correct {:answer/id #uuid "b033fba9-aa64-512d-a47b-ee5a966fb49b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466319} :answer-field/id #uuid "e089d006-f109-5586-8f39-6db728f8f9b6" :answer-field/key "${F}_{3}(t)={\\int }_{0}^{1}\\frac{1}{\\sqrt{|x-t|}}\\,\\text{d}x,\\,t\\in (0,1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467003} {:answer-field/choices [{:answer/id #uuid "3b787848-cce8-55dc-a757-5a201435b275" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668563} {:answer/id #uuid "14bf531a-a1db-508c-bb8b-cad0ac0f3e26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668564}] :answer-field/correct {:answer/id #uuid "3b787848-cce8-55dc-a757-5a201435b275" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668563} :answer-field/id #uuid "81637428-8bc0-5866-9c54-b72e8031d2ed" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668859}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8de3c48f-01de-56bf-9ee6-1a3bd0e95cc5" :question/math-academy-id "q-335251" :question/problem "For which of the following functions is it valid to differentiate under the integral sign?\n\nSelect all that apply." :question/worked-solution "Suppose $f(x,t)$ is continuous on $R=[a,b]\\times [c,d]$ and $\\frac{∂f}{∂t}$ exists and is continuous on $R.$ Then, the function\n\n$$\nF(t)={\\int }_{a}^{b}f(x,t)\\,\\text{d}x\n$$\n\nis differentiable on $(c,d),$ and\n\n$$\n{F}^{′}(t)=\\frac{\\text{d}}{\\text{d}t}{\\int }_{a}^{b}f(x,t)\\,\\text{d}x={\\int }_{a}^{b}\\frac{∂f}{∂t}(x,t)\\,\\text{d}x.\n$$\n\nThis is known as *differentiating under the integral sign.*\n\nWith that in mind, let's check each function:\n\n- For the first function, we have \n\n$$\n{f}_{1}(x,t)=\\frac{\\operatorname{ln}⁡(1+tx)}{1+{x}^{2}}.\n$$\n\nWe fix ${t}_{0}\\in (-1,1)$ and choose $[c,d]⊂(-1,1)$ such that $c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{1}$ is continuous on $R$ (since $1+tx>0$). Computing the  partial derivative, we have\n\n$$\n\\frac{∂{f}_{1}}{∂t}=\\frac{x}{(1+tx)(1+{x}^{2})}\n$$\n\nwhich exists and is continuous on $R.$ Thus, differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{1}^{′}(t)$ for all $t\\in (-1,1).$\n\n- For the second function, we have \n\n$$\n{f}_{2}(x,t)=\\frac{1}{x-t}.\n$$\n\nWe fix ${t}_{0}\\in (1,2)$ and choose $[c,d]⊂(1,2)$ such that $c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{2}$ is continuous on $R$ (since the denominator never vanishes on $R$). Computing the partial derivative, we have\n\n$$\n\\frac{∂{f}_{2}}{∂t}=\\frac{1}{(x-t)^{2}},\n$$\n\nwhich exists and is continuous on $R.$ Thus, differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{2}^{′}(t)$ for all $t\\in (1,2).$\n\n- For the third function, we have \n\n$$\n{f}_{3}(x,t)=\\frac{1}{\\sqrt{|x-t|}}.\n$$\n\nWe fix ${t}_{0}\\in (0,1)$ and choose $[c,d]⊂(0,1)$ such that $c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nNote that this function is undefined when $x=t,$ since the denominator vanishes. Thus, ${f}_{3}$ is not continuous on $R,$ and differentiating under the integral sign is *not* valid.\n\nTherefore, the correct answer is ${F}_{1}(t)$ $={\\int }_{0}^{1}\\frac{\\operatorname{ln}⁡(1+tx)}{1+{x}^{2}}\\,\\text{d}x,$ $\\,t\\in (-1,1)$; ${F}_{2}(t)={\\int }_{0}^{1}\\frac{1}{x-t}\\,\\text{d}x,\\,t\\in (1,2)$ only."} {:db/id #edb/ref 17592186311555 :knowledge-point/_questions [{:db/id #edb/ref 17592186229192 :knowledge-point/id #uuid "bbefb3bb-4783-5d77-b404-1f43ee8765de" :knowledge-point/title "Identifying Cases Where Differentiating Under the Integral Sign Applies"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21f7e4c1-6c8c-516f-99d4-3016aca7887a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466321} {:answer/id #uuid "a65ba9ef-0cc8-52d0-9799-3481656ed4a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466322}] :answer-field/correct {:answer/id #uuid "a65ba9ef-0cc8-52d0-9799-3481656ed4a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466322} :answer-field/id #uuid "591c30be-8419-5dc6-80a9-275d90e3124a" :answer-field/key "${F}_{1}(t)={\\int }_{0}^{1}{e}^{-{t}^{2}x}\\,\\text{d}x,\\,t\\in R$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467004} {:answer-field/choices [{:answer/id #uuid "d9372c8d-42b6-5923-978a-5855e094b76b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466323} {:answer/id #uuid "b5b3441a-93b7-54ca-a1d1-eb627c0c175b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466324}] :answer-field/correct {:answer/id #uuid "d9372c8d-42b6-5923-978a-5855e094b76b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466323} :answer-field/id #uuid "7308a380-c9c9-5971-af9f-58b1d0cea85c" :answer-field/key "${F}_{2}(t)={\\int }_{0}^{1}|x-t|\\,\\text{d}x,\\,t\\ge 0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467005} {:answer-field/choices [{:answer/id #uuid "d96d0868-95f2-538f-a7e5-d8a250db5ce6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466325} {:answer/id #uuid "9df9f9c9-4956-531c-b65e-ed180dad9e8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466326}] :answer-field/correct {:answer/id #uuid "9df9f9c9-4956-531c-b65e-ed180dad9e8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466326} :answer-field/id #uuid "9b3e4b44-d0ed-53af-8a31-aa805a851393" :answer-field/key "${F}_{3}(t)={\\int }_{0}^{1}\\frac{1}{{x}^{2}+{t}^{2}}\\,\\text{d}x,\\,t>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467006} {:answer-field/choices [{:answer/id #uuid "9f3a2b83-5dac-59cc-aa3f-f05034443045" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668565} {:answer/id #uuid "a98d3fe9-ced3-51e9-8878-2a7944c8275b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668566}] :answer-field/correct {:answer/id #uuid "9f3a2b83-5dac-59cc-aa3f-f05034443045" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668565} :answer-field/id #uuid "9fc38713-4933-5a54-b135-47d79b1fdcb4" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668860}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2b175da7-6b72-569e-916d-da964786e33a" :question/math-academy-id "q-335252" :question/problem "For which of the following functions is it valid to differentiate under the integral sign?\n\nSelect all that apply." :question/worked-solution "Suppose $f(x,t)$ is continuous on $R=[a,b]\\times [c,d]$ and $\\frac{∂f}{∂t}$ exists and is continuous on $R.$ Then, the function\n\n$$\nF(t)={\\int }_{a}^{b}f(x,t)\\,\\text{d}x\n$$\n\nis differentiable on $(c,d),$ and\n\n$$\n{F}^{′}(t)=\\frac{\\text{d}}{\\text{d}t}{\\int }_{a}^{b}f(x,t)\\,\\text{d}x={\\int }_{a}^{b}\\frac{∂f}{∂t}(x,t)\\,\\text{d}x.\n$$\n\nThis is known as *differentiating under the integral sign.*\n\nWith that in mind, let's check each function:\n\n- For the first function, we have \n\n$$\n{f}_{1}(x,t)={e}^{-{t}^{2}x}.\n$$\n\nWe fix ${t}_{0}\\in R$ and choose $c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{1}$ is continuous on $R.$ Computing the partial derivative, we have\n\n$$\n\\frac{∂{f}_{1}}{∂t}=-2tx{e}^{-{t}^{2}x},\n$$\n\nwhich exists and is continuous on $R.$ Thus, differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{1}^{′}(t)$ for all real $t.$\n\n- For the second function, we have \n\n$$\n{f}_{2}(x,t)=|x-t|.\n$$\n\nWe fix ${t}_{0}\\in (0,1)$ and choose $c<{t}_{0}<d$ such that $[c,d]⊆[0,1],$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{2}$ is continuous on $R.$ However, the partial derivative\n\n$$\n\\frac{∂{f}_{2}}{∂t}={\\begin{aligned}-1,\\,x>t \\\\ 1,\\,x<t\\end{aligned}\n$$\n\ndoes *not* exist whenever $x=t={t}_{0},$ and is therefore not defined everywhere on $R.$ Thus, differentiating under the integral sign is *not* valid.\n\n- For the third function, we have \n\n$$\n{f}_{3}(x,t)=\\frac{1}{{x}^{2}+{t}^{2}}.\n$$\n\nWe fix ${t}_{0}>0$ and choose $[c,d]⊂(0,\\infty )$ such that $c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{3}$ is continuous on $R$ (since the denominator never vanishes on $R$). Computing the partial derivative, we have\n\n$$\n\\frac{∂{f}_{3}}{∂t}=-\\frac{2t}{({x}^{2}+{t}^{2})^{2}},\n$$\n\nwhich exists and is continuous on $R.$ Thus, differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{3}^{′}(t)$ for all $t>0.$\n\nTherefore, the correct answer is ${F}_{1}(t)={\\int }_{0}^{1}{e}^{-{t}^{2}x}\\,\\text{d}x,\\,t\\in R$; ${F}_{3}(t)={\\int }_{0}^{1}\\frac{1}{{x}^{2}+{t}^{2}}\\,\\text{d}x,\\,t>0$ only."} {:db/id #edb/ref 17592186311556 :knowledge-point/_questions [{:db/id #edb/ref 17592186229192 :knowledge-point/id #uuid "bbefb3bb-4783-5d77-b404-1f43ee8765de" :knowledge-point/title "Identifying Cases Where Differentiating Under the Integral Sign Applies"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f193bbe0-8e7c-5b6f-a8dd-105f7c96e087" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466327} {:answer/id #uuid "047ad879-475c-51be-8100-93116e6fb609" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466328}] :answer-field/correct {:answer/id #uuid "047ad879-475c-51be-8100-93116e6fb609" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466328} :answer-field/id #uuid "c351f140-003f-5de1-a059-b4c452861f54" :answer-field/key "${F}_{1}(t)={\\int }_{0}^{1}\\frac{1}{\\sqrt{{x}^{2}+{t}^{2}}}\\,\\text{d}x,\\,t>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467007} {:answer-field/choices [{:answer/id #uuid "0ac05226-c0db-52a3-ae14-60638c0dc180" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466329} {:answer/id #uuid "6fe0749a-3fbf-53af-8a74-6c63016e53d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466330}] :answer-field/correct {:answer/id #uuid "6fe0749a-3fbf-53af-8a74-6c63016e53d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466330} :answer-field/id #uuid "ec4aa8ac-f5ec-5952-835d-341387814949" :answer-field/key "${F}_{2}(t)={\\int }_{0}^{1}\\operatorname{cos}⁡(xt)\\,\\text{d}x,\\,t\\in R$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467008} {:answer-field/choices [{:answer/id #uuid "6dde5e19-36cd-5710-ac44-3b7ccc338aa7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466331} {:answer/id #uuid "ae4ce050-9839-5301-bc39-df7b6379da2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466332}] :answer-field/correct {:answer/id #uuid "ae4ce050-9839-5301-bc39-df7b6379da2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466332} :answer-field/id #uuid "52c91a3d-646c-5c9e-9c53-efcea5dea94b" :answer-field/key "${F}_{3}(t)={\\int }_{0}^{1}\\frac{{x}^{3}}{1+t{x}^{2}}\\,\\text{d}x,\\,t>-1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467009} {:answer-field/choices [{:answer/id #uuid "d971e79e-582e-5d75-a044-d3057edb0cc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668567} {:answer/id #uuid "589ae22a-6a95-54d1-907c-5100f7db59af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668568}] :answer-field/correct {:answer/id #uuid "d971e79e-582e-5d75-a044-d3057edb0cc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668567} :answer-field/id #uuid "5b128e6b-50c0-5c24-8215-f3a8bddea527" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668861}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e0283e52-8fee-5c3a-a13d-c279ee722034" :question/math-academy-id "q-335253" :question/problem "For which of the following functions is it valid to differentiate under the integral sign?\n\nSelect all that apply." :question/worked-solution "Suppose $f(x,t)$ is continuous on $R=[a,b]\\times [c,d]$ and $\\frac{∂f}{∂t}$ exists and is continuous on $R.$ Then, the function\n\n$$\nF(t)={\\int }_{a}^{b}f(x,t)\\,\\text{d}x\n$$\n\nis differentiable on $(c,d),$ and\n\n$$\n{F}^{′}(t)=\\frac{\\text{d}}{\\text{d}t}{\\int }_{a}^{b}f(x,t)\\,\\text{d}x={\\int }_{a}^{b}\\frac{∂f}{∂t}(x,t)\\,\\text{d}x.\n$$\n\nThis is known as *differentiating under the integral sign.*\n\nWith that in mind, let's check each function:\n\n- For the first function, we have \n\n$$\n{f}_{1}(x,t)=\\frac{1}{\\sqrt{{x}^{2}+{t}^{2}}}.\n$$\n\nWe fix ${t}_{0}>0$ and choose $[c,d]⊂(0,\\infty )$ such that $c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{1}$ is continuous on $R$ (since ${x}^{2}+{t}^{2}>0$ on $R$). Computing the partial derivative, we have\n\n$$\n\\frac{∂{f}_{1}}{∂t}=-\\frac{t}{({x}^{2}+{t}^{2})^{3/2}},\n$$\n\nwhich exists and is continuous on $R.$ Thus, differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{1}^{′}(t)$ for all $t>0.$\n\n- For the second function, we have \n\n$$\n{f}_{2}(x,t)=\\operatorname{cos}⁡(xt).\n$$\n\nWe fix ${t}_{0}\\in R$ and choose $c<{t}_{0}<d$ so that $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{2}$ is continuous on $R.$ Computing the partial derivative, we have\n\n$$\n\\frac{∂{f}_{2}}{∂t}=-x\\operatorname{sin}⁡(xt)\n$$\n\nwhich exists and is continuous on $R.$ Thus differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{2}^{′}(t)$ for all real $t.$\n\n- For the third function, we have \n\n$$\n{f}_{3}(x,t)=\\frac{{x}^{3}}{1+t{x}^{2}}.\n$$\n\nWe fix ${t}_{0}>-1$ and choose $[c,d]⊂(-1,\\infty )$ such that $c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{3}$ is continuous on $R$ (since the denominator never vanishes on $R$). Computing the partial derivative, we have\n\n$$\n\\frac{∂{f}_{3}}{∂t}=-\\frac{{x}^{5}}{(1+t{x}^{2})^{2}},\n$$\n\nwhich exists and is continuous on $R.$ Thus, differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{3}^{′}(t)$ for all $t>-1.$\n\nTherefore, the correct answer is ${F}_{1}(t)={\\int }_{0}^{1}\\frac{1}{\\sqrt{{x}^{2}+{t}^{2}}}\\,\\text{d}x,\\,t>0$; ${F}_{2}(t)={\\int }_{0}^{1}\\operatorname{cos}⁡(xt)\\,\\text{d}x,\\,t\\in R$; ${F}_{3}(t)={\\int }_{0}^{1}\\frac{{x}^{3}}{1+t{x}^{2}}\\,\\text{d}x,\\,t>-1$."} {:db/id #edb/ref 17592186311557 :knowledge-point/_questions [{:db/id #edb/ref 17592186229192 :knowledge-point/id #uuid "bbefb3bb-4783-5d77-b404-1f43ee8765de" :knowledge-point/title "Identifying Cases Where Differentiating Under the Integral Sign Applies"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "958e50e4-711b-576c-ab91-0087c75945cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466333} {:answer/id #uuid "ce8fed5f-0e8b-5ec1-8918-492f6fc7c6b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466334}] :answer-field/correct {:answer/id #uuid "958e50e4-711b-576c-ab91-0087c75945cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466333} :answer-field/id #uuid "5372760e-066f-55e0-b7b9-2ff11d55e2c0" :answer-field/key "${F}_{1}(t)={\\int }_{0}^{1}|x-t|\\,\\text{d}x,\\,t\\in (0,1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467010} {:answer-field/choices [{:answer/id #uuid "832c18d4-aaf4-5e10-9aeb-143c9e0d4b0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466335} {:answer/id #uuid "51ef8b21-0c2d-5d7e-bac0-f3e5033cf5eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466336}] :answer-field/correct {:answer/id #uuid "51ef8b21-0c2d-5d7e-bac0-f3e5033cf5eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466336} :answer-field/id #uuid "1aeac474-d1d6-5a95-a8c4-6a2ce80af73e" :answer-field/key "${F}_{2}(t)={\\int }_{0}^{1}\\frac{t}{1+{x}^{2}+{t}^{2}}\\,\\text{d}x,\\,t\\in R$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467011} {:answer-field/choices [{:answer/id #uuid "800c1d5b-5d46-5618-b8ef-1b9451c13e6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466337} {:answer/id #uuid "4250fbe7-e751-5a5c-88fa-cbb83498f5e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466338}] :answer-field/correct {:answer/id #uuid "4250fbe7-e751-5a5c-88fa-cbb83498f5e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466338} :answer-field/id #uuid "f7db462d-3fc8-5643-b099-4624769f01bf" :answer-field/key "${F}_{3}(t)$ $={\\int }_{0}^{1}\\frac{1}{(x+t+1)^{3}}\\,\\text{d}x,$ $\\,t\\in (0,1)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467012} {:answer-field/choices [{:answer/id #uuid "0388c2b6-61dd-5a05-b49a-b2edbecebd17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668569} {:answer/id #uuid "355908b5-537d-556d-b0db-0fd010fe8681" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668570}] :answer-field/correct {:answer/id #uuid "0388c2b6-61dd-5a05-b49a-b2edbecebd17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668569} :answer-field/id #uuid "6321aa94-7628-5cfa-95a9-3b189d58a851" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668862}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "757f1645-7b5c-5866-81f6-7ae1eefa124d" :question/math-academy-id "q-335254" :question/problem "For which of the following functions is it valid to differentiate under the integral sign?\n\nSelect all that apply." :question/worked-solution "Suppose $f(x,t)$ is continuous on $R=[a,b]\\times [c,d]$ and $\\frac{∂f}{∂t}$ exists and is continuous on $R.$ Then, the function\n\n$$\nF(t)={\\int }_{a}^{b}f(x,t)\\,\\text{d}x\n$$\n\nis differentiable on $(c,d),$ and\n\n$$\n{F}^{′}(t)=\\frac{\\text{d}}{\\text{d}t}{\\int }_{a}^{b}f(x,t)\\,\\text{d}x={\\int }_{a}^{b}\\frac{∂f}{∂t}(x,t)\\,\\text{d}x.\n$$\n\nThis is known as *differentiating under the integral sign.*\n\nWith that in mind, let's check each function:\n\n- For the first function, we have \n\n$$\n{f}_{1}(x,t)=|x-t|.\n$$\n\nWe fix ${t}_{0}\\in (0,1)$ and choose $c<{t}_{0}<d$ such that $[c,d]⊆(0,1),$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{1}$ is continuous on $R.$ However, the partial derivative\n\n$$\n\\frac{∂{f}_{1}}{∂t}={\\begin{aligned}-1,\\,x>t \\\\ 1,\\,x<t\\end{aligned}\n$$\n\ndoes *not* exist whenever $x=t={t}_{0},$ and is therefore not defined everywhere on $R.$ Thus, differentiating under the integral sign is *not* valid.\n\n- For the second function, we have \n\n$$\n{f}_{2}(x,t)=\\frac{t}{1+{x}^{2}+{t}^{2}}.\n$$\n\nWe fix ${t}_{0}\\in R$ and choose $c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{2}$ is continuous on $R.$ Computing the partial derivative, we have\n\n$$\n\\frac{∂{f}_{2}}{∂t}=\\frac{(1+{x}^{2}+{t}^{2})-2{t}^{2}}{(1+{x}^{2}+{t}^{2})^{2}}=\\frac{1+{x}^{2}-{t}^{2}}{(1+{x}^{2}+{t}^{2})^{2}}\n$$\n\nwhich exists and is continuous on $R.$ Thus, differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{2}^{′}(t)$ for all real $t.$\n\n- For the third function, we have \n\n$$\n{f}_{3}(x,t)=\\frac{1}{(x+t+1)^{3}}.\n$$\n\nWe fix ${t}_{0}\\in (0,1)$ and choose $c<{t}_{0}<d$ such that $[c,d]⊆(0,1),$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{3}$ is continuous on $R.$ Computing the partial derivative, we have\n\n$$\n\\frac{∂{f}_{3}}{∂t}=-\\frac{3}{(x+t+1)^{4}}\n$$\n\nwhich exists and is continuous on $R.$ Thus, differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{3}^{′}(t)$ for all $t\\in (0,1).$\n\nTherefore, the correct answer is ${F}_{2}(t)={\\int }_{0}^{1}\\frac{t}{1+{x}^{2}+{t}^{2}}\\,\\text{d}x,\\,t\\in R$; ${F}_{3}(t)$ $={\\int }_{0}^{1}\\frac{1}{(x+t+1)^{3}}\\,\\text{d}x,$ $\\,t\\in (0,1)$ only."} {:db/id #edb/ref 17592186311558 :knowledge-point/_questions [{:db/id #edb/ref 17592186229192 :knowledge-point/id #uuid "bbefb3bb-4783-5d77-b404-1f43ee8765de" :knowledge-point/title "Identifying Cases Where Differentiating Under the Integral Sign Applies"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a22ab5cf-13df-5925-8c56-24a2e18fabaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466339} {:answer/id #uuid "ff310a56-8a6f-5ed7-bf98-61e53df7dc8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466340}] :answer-field/correct {:answer/id #uuid "a22ab5cf-13df-5925-8c56-24a2e18fabaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466339} :answer-field/id #uui