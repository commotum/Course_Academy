x} :db/id #edb/ref 17592186668902}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "994b0436-bb09-5be1-b2e9-9e0b690f2b7e" :question/math-academy-id "q-39203" :question/problem "Suppose $(a+b)\\cdot a=0$, where $a\\ne 0.$ Which of the following statements are true? \n\nSelect all that apply." :question/worked-solution "Let's analyze each statement in turn.\n\n- Statements $b\\cdot a>0$ and $b\\cdot a=0$ are false. Simplifying the expression $(a+b)\\cdot a=0$, we have\n\n$$\n\\begin{aligned}(a+b)\\cdot a & =0 \\\\ a\\cdot a+b\\cdot a & =0 \\\\ b\\cdot a & =-a\\cdot a\\end{aligned}\n$$\n\n \nSince $a\\ne 0$ implies that $a\\cdot a>0$, we obtain that $-a\\cdot a<0.$\n\n- Statement $a\\cdot a=0$ is false. Since $a\\ne 0,$ we must have $a\\cdot a>0.$\n\nTherefore, we conclude that none of the statements are true."} {:db/id #edb/ref 17592186326751 :knowledge-point/_questions [{:db/id #edb/ref 17592186129321 :knowledge-point/id #uuid "359bc41e-1b6d-5177-9642-4f8697bc5ba0" :knowledge-point/title "Identifying Rotation-Scaling Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aebd1d9b-7682-54a1-87d1-5625b9a74a32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467440} {:answer/id #uuid "ae1c3ef4-6d14-5347-a96d-aa3d56907e32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467441}] :answer-field/correct {:answer/id #uuid "ae1c3ef4-6d14-5347-a96d-aa3d56907e32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467441} :answer-field/id #uuid "0c341505-ef51-58ef-9929-830b95c5da1b" :answer-field/key "$A=\\begin{bmatrix}-5 & 4 \\\\ -4 & -5\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468441} {:answe