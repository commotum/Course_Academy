    "question": {
      ":question/id": "fd7dfdf6-c611-53db-8653-b6ef840cf9f9",
      ":question/difficulty": ":question.difficulty/easy",
      ":question/problem": "Given that $\\sqrt[5]{{x}^{2}}={x}^{n},$ what is $n?$\n\nAssume $x>0$.",
      ":question/answer-fields": [
        {
          ":answer-field/id": "84e40b40-d257-5a1f-aa26-8b22f2aff5da",
          ":answer-field/key": "selection",
          ":answer-field/type": ":answer-field.type/radio",
          ":answer-field/choices": [
            {
              ":answer/id": "67afc9cc-3370-5ee7-8318-5df76172b45b",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{2}{5}"
            },
            {
              ":answer/id": "d0b15829-5979-57cf-9089-4bbeccc33c54",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{2}{3}"
            },
            {
              ":answer/id": "2a53deb9-4fd7-5e59-9dfc-65fd5c4aeb43",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{3}{7}"
            },
            {
              ":answer/id": "388d49bc-87f6-54f4-9d13-6bcc0572e3b2",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{4}{9}"
            },
            {
              ":answer/id": "85c7b6f8-647f-56a1-a376-1d8654619740",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{6}{7}"
            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "67afc9cc-3370-5ee7-8318-5df76172b45b"
          ]
        }
      ],
      ":question/worked-solution": "First, we convert the radical to a fractional exponent, and then we apply the power rule:\n\n$$\n\\begin{aligned}\\sqrt[5]{{x}^{2}} &= {({x}^{2})}^{1/5} \\\\ &= {x}^{2\\cdot (1/5)} \\\\ &= {x}^{2/5}\\end{aligned}\n$$\n\nTherefore, $n=\\frac{2}{5}.$"
    },
