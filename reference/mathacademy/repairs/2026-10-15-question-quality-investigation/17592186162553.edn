}_{3}\\,$ and $\\,{R}_{2}:={R}_{2}+2{R}_{3}$" :db/id #edb/ref 17592186402823} {:answer/id #uuid "e1f3583d-774f-5ecb-8116-1df3e691e528" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${R}_{1}:={R}_{1}-2{R}_{3}\\,$ and $\\,{R}_{2}:={R}_{2}+2{R}_{3}$" :db/id #edb/ref 17592186402824} {:answer/id #uuid "90c1f27f-acca-5eb4-87c7-900c3850a303" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${R}_{1}:={R}_{1}-2{R}_{3}\\,$ and $\\,{R}_{2}:={R}_{2}+{R}_{3}$" :db/id #edb/ref 17592186402825} {:answer/id #uuid "cd27bad4-f644-5526-96c8-69746fbc2f25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${R}_{1}:={R}_{1}-2{R}_{3}\\,$ and $\\,{R}_{2}:={R}_{2}-2{R}_{3}$" :db/id #edb/ref 17592186402826} {:answer/id #uuid "8db3fa2f-76d6-52a6-9b7c-ba57a595ce6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${R}_{1}:={R}_{1}+2{R}_{3}\\,$ and $\\,{R}_{2}:={R}_{2}-2{R}_{3}$" :db/id #edb/ref 17592186402827}] :answer-field/correct {:answer/id #uuid "cd27bad4-f644-5526-96c8-69746fbc2f25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${R}_{1}:={R}_{1}-2{R}_{3}\\,$ and $\\,{R}_{2}:={R}_{2}-2{R}_{3}$" :db/id #edb/ref 17592186402826} :answer-field/id #uuid "5de261ee-7f92-5aa5-a69d-40b482f1b158" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402822}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "122850ae-d465-5748-ba36-b0dbdbbedca0" :question/math-academy-id "q-42531" :question/problem "$$\nA=\\begin{bmatrix}-3 & 2 & -1 \\\\ 1 & 2 & 1 \\\\ 0 & 1 & 2\\end{bmatrix}\n$$\n\n$$\nB=\\begin{bmatrix}-3 & 0 & -5 \\\\ 1 & 0 & -3 \\\\ 0 & 1 & 2\\end{bmatrix}\n$$\n\nBy applying elementary row operations of the form ${R}_{i}:={R}_{i}+k{R}_{3},$ the matrix $A$ can be transformed into the matrix $B.$ What are the elementary row operations?" :question/worked-solution "To transform $A$ into $B,$ we need to make the entries above ${a}_{32}=1$ equal to $0.$\n\nTo do this, we can apply the following elementary row operations:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}-3 & 2 & -1 \\\\ 1 & 2 & 1 \\\\ 0 & 1 & 2\\end{bmatrix} &  & \\,\\begin{aligned}{R}_{1}: &={R}_{1}-2{R}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}-3 & 0 & -5 \\\\ 1 & 2 & 1 \\\\ 0 & 1 & 2\\end{bmatrix} &  & \\,\\begin{aligned}{R}_{2}: &={R}_{2}-2{R}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}-3 & 0 & -5 \\\\ 1 & 0 & -3 \\\\ 0 & 1 & 2\\end{bmatrix} \\\\  & =B\\end{aligned}\n$$\n\nTherefore, the elementary row operations are\n\n$\\,$ ${R}_{1}:={R}_{1}-2{R}_{3}\\,$ and $\\,{R}_{2}:={R}_{2}-2{R}_{3}.$"}
