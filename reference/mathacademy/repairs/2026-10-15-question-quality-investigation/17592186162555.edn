_{3}\\,$ and $\\,{C}_{4}:={C}_{4}-{C}_{3}$" :db/id #edb/ref 17592186402836} {:answer/id #uuid "a6adea6e-da8c-598e-b0fd-53965c425cab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}+3{C}_{3}\\,$ and $\\,{C}_{4}:={C}_{4}-2{C}_{3}$" :db/id #edb/ref 17592186402837} {:answer/id #uuid "b5e87be8-81e4-505f-ae32-f4180bc1a520" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}+3{C}_{3}\\,$ and $\\,{C}_{4}:={C}_{4}+2{C}_{3}$" :db/id #edb/ref 17592186402838} {:answer/id #uuid "ecb1522e-12aa-50b2-8b8c-79d8efc4b505" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}-{C}_{3}\\,$ and $\\,{C}_{4}:={C}_{4}-2{C}_{3}$" :db/id #edb/ref 17592186402839} {:answer/id #uuid "c0d52c6b-6d27-5e70-9d2f-67cd54be5121" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}-3{C}_{3}\\,$ and $\\,{C}_{4}:={C}_{4}-2{C}_{3}$" :db/id #edb/ref 17592186402840}] :answer-field/correct {:answer/id #uuid "c0d52c6b-6d27-5e70-9d2f-67cd54be5121" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}-3{C}_{3}\\,$ and $\\,{C}_{4}:={C}_{4}-2{C}_{3}$" :db/id #edb/ref 17592186402840} :answer-field/id #uuid "21b43853-c32f-5465-8d87-0bae0b61fc32" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402835}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "44844b50-2f6e-5293-a5b6-be91cc0464d5" :question/math-academy-id "q-42563" :question/problem "$$\nA=\\begin{bmatrix}5 & 0 & 2 & 7 \\\\ 1 & -7 & -4 & -6 \\\\ -1 & 3 & 1 & 2 \\\\ 2 & 7 & 2 & 3\\end{bmatrix}\n$$\n\n$$\nB=\\begin{bmatrix}7 & -6 & 2 & 3 \\\\ -3 & 5 & -4 & 2 \\\\ 0 & 0 & 1 & 0 \\\\ 4 & 1 & 2 & -1\\end{bmatrix}\n$$\n\nConsider the matrices $A$ and $B$ above. By applying three matrix elementary column operations \n\nI. ${C}_{1}:={C}_{1}+{C}_{3}$\nII. ${C}_{2}:=…$\nIII. ${C}_{4}:=…$\n\neach of the form ${C}_{i}:={C}_{i}+k{C}_{3},$ the matrix $A$ can be transformed into the matrix $B.$ What are the missing elementary column operations?" :question/worked-solution "To transform $A$ into $B,$ we need to make entries to the left and to the right of ${a}_{33}=1$ equal to $0.$\n\nTo do this, we can apply the following elementary column operations:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}5 & 0 & 2 & 7 \\\\ 1 & -7 & -4 & -6 \\\\ -1 & 3 & 1 & 2 \\\\ 2 & 7 & 2 & 3\\end{bmatrix} &  & \\,\\begin{aligned}{C}_{1}: &={C}_{1}+{C}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}7 & 0 & 2 & 7 \\\\ -3 & -7 & -4 & -6 \\\\ 0 & 3 & 1 & 2 \\\\ 4 & 7 & 2 & 3\\end{bmatrix} &  & \\,\\begin{aligned}{C}_{2}: &={C}_{2}-3{C}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}7 & -6 & 2 & 7 \\\\ -3 & 5 & -4 & -6 \\\\ 0 & 0 & 1 & 2 \\\\ 4 & 1 & 2 & 3\\end{bmatrix} &  & \\,\\begin{aligned}{C}_{4}: &={C}_{4}-2{C}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}7 & -6 & 2 & 3 \\\\ -3 & 5 & -4 & 2 \\\\ 0 & 0 & 1 & 0 \\\\ 4 & 1 & 2 & -1\\end{bmatrix} \\\\  & =B\\end{aligned}\n$$\n\nTherefore, the corresponding elementary column operations are\n\n$\\,$ ${C}_{2}:={C}_{2}-3{C}_{3}\\,$ and $\\,{C}_{4}:={C}_{4}-2{C}_{3}.$"}
