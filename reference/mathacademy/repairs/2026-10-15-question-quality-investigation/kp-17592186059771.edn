in{bmatrix}3 & 3 & 6 \\\\ 0 & 8 & 1 \\\\ 4 & -1 & 3\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237897 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b0ae7c7-831d-5433-9390-889330306d24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 4 & -1 \\\\ 7 & 4 & -1 \\\\ 0 & 5 & -2\\end{bmatrix}" :db/id #edb/ref 17592186235871} {:answer/id #uuid "30eaaa83-5cd1-5e22-a46e-6e3b5195a079" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 4 & -1 \\\\ 0 & 5 & -2 \\\\ 1 & 5 & -3\\end{bmatrix}" :db/id #edb/ref 17592186236128} {:answer/id #uuid "bab3efd1-d5b4-58ad-bfff-d99746961975" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 7 & -1 \\\\ 5 & 1 & -3 \\\\ 5 & 0 & -2\\end{bmatrix}" :db/id #edb/ref 17592186237011} {:answer/id #uuid "df090ab6-463d-55fd-9c82-27652ad50d03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 5 & -3 \\\\ 7 & 4 & -1 \\\\ 0 & 5 & -2\\end{bmatrix}" :db/id #edb/ref 17592186237219} {:answer/id #uuid "faa1874f-baa6-5eb3-8044-094998eb5d5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 5 & -2 \\\\ 7 & 4 & -1 \\\\ 1 & 5 & -3\\end{bmatrix}" :db/id #edb/ref 17592186237402}] :answer-field/correct {:answer/id #uuid "df090ab6-463d-55fd-9c82-27652ad50d03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 5 & -3 \\\\ 7 & 4 & -1 \\\\ 0 & 5 & -2\\end{bmatrix}" :db/id #edb/ref 17592186237219} :answer-field/id #uuid "3d143e11-fa10-5879-b30c-3e557bb06f36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237518}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "89449fa7-e2ad-5aa8-8f8e-c30702d39ac6" :question/math-academy-id "q-10244" :question/problem "Consider the matrix $A,$ given by\n\n$$\nA=\\begin{bmatrix}7 & 4 & -1 \\\\ 1 & 5 & -3 \\\\ 0 & 5 & -2\\end{bmatrix}.\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{1}↔{R}_{2}$ on $A?$" :question/worked-solution "The operation ${R}_{1}↔{R}_{2}$ means that we need to swap the first and second rows.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}7 & 4 & -1 \\\\ 1 & 5 & -3 \\\\ 0 & 5 & -2\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 5 & -3 \\\\ 7 & 4 & -1 \\\\ 0 & 5 & -2\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265796 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0afbf473-cf2c-557a-b166-cf94f46b04fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{3} & \\frac{2}{3} & \\frac{7}{3} \\\\ 7 & -1 & 3 \\\\ 6 & 9 & -3\\end{bmatrix}" :db/id #edb/ref 17592186263105} {:answer/id #uuid "39cae253-d68f-537c-b71f-b07e5c03621e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 2 & 7 \\\\ \\frac{7}{3} & -\\frac{1}{3} & 1 \\\\ 6 & 9 & -3\\end{bmatrix}" :db/id #edb/ref 17592186263515} {:answer/id #uuid "5c917f32-40fe-536b-976e-64ddba176487" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 3 & -1 \\\\ 7 & -1 & 3 \\\\ 2 & 2 & 7\\end{bmatrix}" :db/id #edb/ref 17592186263800} {:answer/id #uuid "d2202449-4412-5126-800a-2b62df1d2a71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 2 & 7 \\\\ 7 & -1 & 3 \\\\ 2 & 3 & -1\\end{bmatrix}" :db/id #edb/ref 17592186264833} {:answer/id #uuid "fc2ff622-6bf9-5fc1-9910-0b357c357bf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 2 & 7 \\\\ 7 & -1 & 3 \\\\ 18 & 27 & -9\\end{bmatrix}" :db/id #edb/ref 17592186265210}] :answer-field/correct {:answer/id #uuid "d2202449-4412-5126-800a-2b62df1d2a71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 2 & 7 \\\\ 7 & -1 & 3 \\\\ 2 & 3 & -1\\end{bmatrix}" :db/id #edb/ref 17592186264833} :answer-field/id #uuid "a68b5eeb-7e97-5637-b883-d5b1091e0338" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265542}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1b5f24a7-25be-5f91-9261-490e6919b435" :question/math-academy-id "q-130006" :question/problem "Consider the matrix $A,$ given by\n\n$$\nA=\\begin{bmatrix}2 & 2 & 7 \\\\ 7 & -1 & 3 \\\\ 6 & 9 & -3\\end{bmatrix}.\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{3}:=\\frac{1}{3}{R}_{3}$ on $A?$" :question/worked-solution "The operation ${R}_{3}:=\\frac{1}{3}{R}_{3}$ means that we need to multiply the third row of the matrix by $\\frac{1}{3}.$\n\nMultiplying the $3$rd row by $\\frac{1}{3}$, we obtain the following:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}2 & 2 & 7 \\\\ 7 & -1 & 3 \\\\ 6 & 9 & -3\\end{bmatrix} & {R}_{3}:=\\frac{1}{3}\\cdot {R}_{3} \\\\  & ∼\\begin{bmatrix}2 & 2 & 7 \\\\ 7 & -1 & 3 \\\\ \\frac{1}{3}\\cdot 6 & \\frac{1}{3}\\cdot 9 & \\frac{1}{3}\\cdot -3\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}2 & 2 & 7 \\\\ 7 & -1 & 3 \\\\ 2 & 3 & -1\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265809 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73a2c4e4-50d2-503f-bd6c-ff089298616e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 4 & 7 \\\\ -10 & 0 & 5 \\\\ 6 & 5 & 1\\end{bmatrix}" :db/id #edb/ref 17592186264003} {:answer/id #uuid "7ff361c5-1ff3-5bae-bd7f-64bc0ff75321" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & 8 & -9 \\\\ 5 & 2 & 1 \\\\ 6 & 5 & 1\\end{bmatrix}" :db/id #edb/ref 17592186264101} {:answer/id #uuid "a4eeb7c2-1749-5db5-9f69-4de6d50bbc49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & 0 & 5 \\\\ 5 & 2 & 1 \\\\ 6 & 5 & 1\\end{bmatrix}" :db/id #edb/ref 17592186264408} {:answer/id #uuid "a8f82394-8f99-5fa4-ba5d-107b492af231" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & 0 & 5 \\\\ 6 & 5 & 1 \\\\ 1 & 3 & 0\\end{bmatrix}" :db/id #edb/ref 17592186264445} {:answer/id #uuid "bacc0ddd-dc83-59e3-9874-8cfac2adf105" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & 0 & 5 \\\\ 5 & 2 & 1 \\\\ 1 & 3 & 0\\end{bmatrix}" :db/id #edb/ref 17592186264622}] :answer-field/correct {:answer/id #uuid "a4eeb7c2-1749-5db5-9f69-4de6d50bbc49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & 0 & 5 \\\\ 5 & 2 & 1 \\\\ 6 & 5 & 1\\end{bmatrix}" :db/id #edb/ref 17592186264408} :answer-field/id #uuid "3ed109b8-a919-5012-a65d-4a4d80d99f80" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265361}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "89540d9f-9bfa-5f07-91be-e72783b1a7bc" :question/math-academy-id "q-130064" :question/problem "Consider the matrix $C,$ given by\n\n$$\nC=\\begin{bmatrix}0 & 4 & 7 \\\\ 5 & 2 & 1 \\\\ 1 & 3 & 0\\end{bmatrix}.\n$$\n\nWhat matrix results from carrying out the following row operations on $C?$\n\n$$\n\\begin{aligned}{R}_{1} & :={R}_{1}-2{R}_{2} \\\\ {R}_{3} & :={R}_{3}+{R}_{2}\\end{aligned}\n$$" :question/worked-solution "Let's list the required operations:\n\n- The operation ${R}_{1}:={R}_{1}-2{R}_{2}$ means that we need to add $-2$ times the second row to the first row.\n\n- The operation ${R}_{3}:={R}_{3}+{R}_{2}$ means that we need to add $1$ times the second row to the third row.\n\nApplying the operations, we obtain the following:\n\n$$\n\\begin{aligned}C & =\\begin{bmatrix}0 & 4 & 7 \\\\ 5 & 2 & 1 \\\\ 1 & 3 & 0\\end{bmatrix}\\,{R}_{1}:={R}_{1}+(-2)\\cdot {R}_{2} \\\\  & ∼\\begin{bmatrix}0+(-2)(5) & 4+(-2)(2) & 7+(-2)(1) \\\\ 5 & 2 & 1 \\\\ 1 & 3 & 0\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}-10 & 0 & 5 \\\\ 5 & 2 & 1 \\\\ 1 & 3 & 0\\end{bmatrix}\\,{R}_{3}:={R}_{3}+(1)\\cdot {R}_{2} \\\\  & ∼\\begin{bmatrix}-10 & 0 & 5 \\\\ 5 & 2 & 1 \\\\ 1+(1)(5) & 3+(1)(2) & 0+(1)(1)\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}-10 & 0 & 5 \\\\ 5 & 2 & 1 \\\\ 6 & 5 & 1\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265810 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03949c4b-6891-5b84-b41d-57552e4e94cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 2 & -2 \\\\ 1 & 0 & -9 \\\\ 2 & 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186263030} {:answer/id #uuid "5841ddf4-5f71-5cdd-afc7-47cedd7a87e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 2 & -4 \\\\ -19 & 0 & -1 \\\\ 2 & 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186263760} {:answer/id #uuid "aaef4050-007d-5267-8d48-c8df487afab0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 & 1 \\\\ 7 & 2 & -2 \\\\ 1 & 0 & -9\\end{bmatrix}" :db/id #edb/ref 17592186264465} {:answer/id #uuid "be5ea1db-c697-51d4-aeb0-b74aead3cc03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 & 1 \\\\ 7 & 2 & -2 \\\\ 2 & 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186264654} {:answer/id #uuid "c8d8bd0a-43ee-511e-985d-7a0790baba7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 2 & -2 \\\\ -9 & 0 & -4 \\\\ 1 & 0 & -9\\end{bmatrix}" :db/id #edb/ref 17592186264760}] :answer-field/correct {:answer/id #uuid "03949c4b-6891-5b84-b41d-57552e4e94cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 2 & -2 \\\\ 1 & 0 & -9 \\\\ 2 & 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186263030} :answer-field/id #uuid "8d7835eb-fe41-51f2-8257-6d4458713548" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265496}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "873c8162-c75c-5ddc-aed6-146d6160fb0b" :question/math-academy-id "q-130065" :question/problem "Consider the matrix $C,$ given by\n\n$$\nC=\\begin{bmatrix}1 & 2 & 1 \\\\ -9 & 0 & -4 \\\\ 2 & 0 & -1\\end{bmatrix}.\n$$\n\nWhat matrix results from carrying out the following row operations on $C?$\n\n$$\n\\begin{aligned}{R}_{1} & :={R}_{1}+3{R}_{3} \\\\ {R}_{2} & :={R}_{2}+5{R}_{3}\\end{aligned}\n$$" :question/worked-solution "Let's list the required operations:\n\n- The operation ${R}_{1}:={R}_{1}+3{R}_{3}$ means that we need to add $3$ times the third row to the first row.\n\n- The operation ${R}_{2}:={R}_{2}+5{R}_{3}$ means that we need to add $5$ times the third row to the second row.\n\nApplying the operations, we obtain the following:\n\n$$\n\\begin{aligned}C & =\\begin{bmatrix}1 & 2 & 1 \\\\ -9 & 0 & -4 \\\\ 2 & 0 & -1\\end{bmatrix}\\,{R}_{1}:={R}_{1}+3\\cdot {R}_{3} \\\\  & ∼\\begin{bmatrix}1+(3)(2) & 2+(3)(0) & 1+(3)(-1) \\\\ -9 & 0 & -4 \\\\ 2 & 0 & -1\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}7 & 2 & -2 \\\\ -9 & 0 & -4 \\\\ 2 & 0 & -1\\end{bmatrix}\\,{R}_{2}:={R}_{2}+5\\cdot {R}_{3} \\\\  & ∼\\begin{bmatrix}7 & 2 & -2 \\\\ -9+(5)(2) & 0+(5)(0) & -4+(5)(-1) \\\\ 2 & 0 & -1\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}7 & 2 & -2 \\\\ 1 & 0 & -9 \\\\ 2 & 0 & -1\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287981 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f838c2c-b1d0-52ca-bdd1-759b3f28e9b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 & 1 \\\\ 0 & -7 & -2 \\\\ 2 & 3 & 2\\end{bmatrix}" :db/id #edb/ref 17592186285663} {:answer/id #uuid "6d2a787c-8b97-57cc-8fe2-47181a3b7d2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & -3 & -1 \\\\ 1 & 2 & 1 \\\\ 3 & -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186285790} {:answer/id #uuid "77cd75e4-8855-5c13-9dee-73fe9f426575" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -7 & -2 \\\\ 1 & 2 & 1 \\\\ 2 & 3 & 2\\end{bmatrix}" :db/id #edb/ref 17592186285902} {:answer/id #uuid "b0405152-868b-5aca-9457-e8ef9b46e55b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 & 1 \\\\ 3 & -1 & 1 \\\\ -1 & -3 & -1\\end{bmatrix}" :db/id #edb/ref 17592186286397} {:answer/id #uuid "f1bcca47-aebf-5c20-bf86-bec34ef21f8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -1 & 1 \\\\ 3 & -10 & 1 \\\\ 2 & -3 & 2\\end{bmatrix}" :db/id #edb/ref 17592186287007}] :answer-field/correct {:answer/id #uuid "5f838c2c-b1d0-52ca-bdd1-759b3f28e9b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 & 1 \\\\ 0 & -7 & -2 \\\\ 2 & 3 & 2\\end{bmatrix}" :db/id #edb/ref 17592186285663} :answer-field/id #uuid "d6cd03db-7e93-5314-902f-ae586cc7310d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287587}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e33508b0-e7bc-5f7b-ba8e-f8058d2dcab4" :question/math-academy-id "q-20239" :question/problem "Consider the matrix $X,$ given by\n\n$$\nX=\\begin{bmatrix}1 & 2 & 1 \\\\ 3 & -1 & 1 \\\\ 2 & 3 & 2\\end{bmatrix}.\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{2}:={R}_{2}-3{R}_{1}$ on $X?$" :question/worked-solution "The operation ${R}_{2}:={R}_{2}-3{R}_{1}$ means that we need to add $-3$ times the first row to the second row. \n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}X & =\\begin{bmatrix}1 & 2 & 1 \\\\ 3 & -1 & 1 \\\\ 2 & 3 & 2\\end{bmatrix}\\,{R}_{2}:={R}_{2}+(-3)\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 1 \\\\ 3+(-3)(1) & -1+(-3)(2) & 1+(-3)(1) \\\\ 2 & 3 & 2\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}1 & 2 & 1 \\\\ 0 & -7 & -2 \\\\ 2 & 3 & 2\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186386014 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17d6b6ba-73af-5b0e-aadb-df2b92946446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 3 & 6 \\\\ 0 & 24 & 27 \\\\ 1 & 5 & 10\\end{bmatrix}" :db/id #edb/ref 17592186386016} {:answer/id #uuid "fd96430f-7419-56b6-99da-8a526bba22e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 3 & 6 \\\\ 0 & 21 & 27 \\\\ 0 & 5 & 10\\end{bmatrix}" :db/id #edb/ref 17592186386017} {:answer/id #uuid "83bf736c-a7af-587e-9671-a0755c99d45c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 3 & 6 \\\\ 0 & 24 & 27 \\\\ 0 & 5 & 10\\end{bmatrix}" :db/id #edb/ref 17592186386018} {:answer/id #uuid "be7cd770-89d2-5f9f-b60e-e8df5d9ff51c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 3 & 6 \\\\ 0 & 24 & 27 \\\\ 0 & -5 & 10\\end{bmatrix}" :db/id #edb/ref 17592186386019} {:answer/id #uuid "f19e8491-c92c-5661-8c92-a31904c65e32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 3 & 6 \\\\ 0 & 24 & 25 \\\\ 0 & 5 & 10\\end{bmatrix}" :db/id #edb/ref 17592186386020}] :answer-field/correct {:answer/id #uuid "83bf736c-a7af-587e-9671-a0755c99d45c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 3 & 6 \\\\ 0 & 24 & 27 \\\\ 0 & 5 & 10\\end{bmatrix}" :db/id #edb/ref 17592186386018} :answer-field/id #uuid "5f488fbc-4f0a-58a9-aca2-89c02a7e41b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386015}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d89fad28-1b46-55f3-b90e-6ed4c3f194da" :question/math-academy-id "q-10245" :question/problem "Consider the matrix $B,$ given by\n\n$$\nB=\\begin{bmatrix}1 & 3 & 6 \\\\ -4 & 12 & 3 \\\\ -1 & 2 & 4\\end{bmatrix}.\n$$\n\nWhat matrix results from carrying out the following row operations on $B?$\n\n$$\n\\begin{aligned}{R}_{2} & :={R}_{2}+4{R}_{1} \\\\ {R}_{3} & :={R}_{3}+{R}_{1}\\end{aligned}\n$$" :question/worked-solution "Let's list the required operations:\n\n- The operation ${R}_{2}:={R}_{2}+4{R}_{1}$ means that we need to add $4$ times the first row to the second row.\n\n- The operation ${R}_{3}:={R}_{3}+{R}_{1}$ means that we need to add $1$ times the first row to the third row.\n\nApplying the operations, we obtain the following:\n\n$$\n\\begin{aligned}B & =\\begin{bmatrix}1 & 3 & 6 \\\\ -4 & 12 & 3 \\\\ -1 & 2 & 4\\end{bmatrix}\\,{R}_{2}:={R}_{2}+4\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & 6 \\\\ -4+(4)(1) & 12+(4)(3) & 3+(4)(6) \\\\ -1 & 2 & 4\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}1 & 3 & 6 \\\\ 0 & 24 & 27 \\\\ -1 & 2 & 4\\end{bmatrix}\\,{R}_{3}:={R}_{3}+{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & 6 \\\\ 0 & 24 & 27 \\\\ -1+1 & 2+3 & 4+6\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}1 & 3 & 6 \\\\ 0 & 24 & 27 \\\\ 0 & 5 & 10\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186388062 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3918bbf4-16cc-5c1f-a802-36adb86390c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 6 & -7 \\\\ -14 & 3 & -4 \\\\ -2 & 4 & -3\\end{bmatrix}" :db/id #edb/ref 17592186388064} {:answer/id #uuid "e62342b5-074d-5e24-9642-83584f678838" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 6 & -7 \\\\ 30 & 11 & -20 \\\\ -2 & 4 & -3\\end{bmatrix}" :db/id #edb/ref 17592186388065} {:answer/id #uuid "b6849f47-5bf1-537e-9558-fee095da4647" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 6 & -7 \\\\ 28 & 15 & -23 \\\\ -2 & 4 & -3\\end{bmatrix}" :db/id #edb/ref 17592186388066} {:answer/id #uuid "7c6fc884-3dee-5e5f-9162-e9d9a9e34a9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 6 & -7 \\\\ -5 & 9 & -11 \\\\ -2 & 4 & -3\\end{bmatrix}" :db/id #edb/ref 17592186388067} {:answer/id #uuid "22917917-c3d7-5ada-b4ca-d45cebf96675" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 6 & -7 \\\\ 26 & 19 & -26 \\\\ -2 & 4 & -3\\end{bmatrix}" :db/id #edb/ref 17592186388068}] :answer-field/correct {:answer/id #uuid "e62342b5-074d-5e24-9642-83584f678838" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 6 & -7 \\\\ 30 & 11 & -20 \\\\ -2 & 4 & -3\\end{bmatrix}" :db/id #edb/ref 17592186388065} :answer-field/id #uuid "f9ef02a3-2e92-5a2e-a56c-df3ea22f0bc2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388063}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d1a5db75-1b21-5cae-946a-8cdf4a8b6bd6" :question/math-academy-id "q-130010" :question/problem "Consider the matrix $C,$ given by\n\n$$\nC=\\begin{bmatrix}9 & 6 & -7 \\\\ 1 & -3 & -2 \\\\ -2 & 4 & -3\\end{bmatrix}.\n$$\n\nWhat matrix results from carrying out the following row operations on $C?$\n\n$$\n\\begin{aligned}{R}_{2} & :={R}_{2}+3{R}_{1} \\\\ {R}_{2} & :={R}_{2}-{R}_{3}\\end{aligned}\n$$" :question/worked-solution "Let's list the required operations:\n\n- The operation ${R}_{2}:={R}_{2}+3{R}_{1}$ means that we need to add $3$ times the first row to the second row.\n\n- The operation ${R}_{2}:={R}_{2}-{R}_{3}$ means that we need to add $-1$ times the third row to the second row.\n\nApplying the operations, we obtain the following:\n\n$$\n\\begin{aligned}C & =\\begin{bmatrix}9 & 6 & -7 \\\\ 1 & -3 & -2 \\\\ -2 & 4 & -3\\end{bmatrix}\\,{R}_{2}:={R}_{2}+3\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}9 & 6 & -7 \\\\ 1+(3)(9) & -3+(3)(6) & -2+(3)(-7) \\\\ -2 & 4 & -3\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}9 & 6 & -7 \\\\ 28 & 15 & -23 \\\\ -2 & 4 & -3\\end{bmatrix}\\,{R}_{2}:={R}_{2}+(-1)\\cdot {R}_{3} \\\\  & ∼\\begin{bmatrix}9 & 6 & -7 \\\\ 28+(-1)(-2) & 15+(-1)(4) & -23+(-1)(-3) \\\\ -2 & 4 & -3\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}9 & 6 & -7 \\\\ 30 & 11 & -20 \\\\ -2 & 4 & -3\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186525161 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bc3f2a4-97c2-5c0d-b22f-c697220cb4de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & -7 & 3 \\\\ -1 & -3 & 0 \\\\ 1 & -1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186525166} {:answer/id #uuid "339b3fce-80f2-5a99-ad32-3a542c5154c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -1 & 0 \\\\ 3 & -7 & 3 \\\\ -1 & -3 & 0\\end{bmatrix}" :db/id #edb/ref 17592186525167} {:answer/id #uuid "6dce46c5-7b2d-5380-87ee-e008451d03ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -1 & 0 \\\\ -1 & -8 & -4 \\\\ 0 & -4 & 3\\end{bmatrix}" :db/id #edb/ref 17592186525178} {:answer/id #uuid "84d1a19e-e5b7-5ec8-8970-8ffef28c8f77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & -16 & 3 \\\\ -1 & -5 & -4 \\\\ 1 & -4 & 0\\end{bmatrix}" :db/id #edb/ref 17592186525182} {:answer/id #uuid "9973e3d5-f174-549a-ba73-a2b3bd9f96ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -4 & 3 \\\\ -1 & -8 & -4 \\\\ 1 & -1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186525185}] :answer-field/correct {:answer/id #uuid "9973e3d5-f174-549a-ba73-a2b3bd9f96ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -4 & 3 \\\\ -1 & -8 & -4 \\\\ 1 & -1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186525185} :answer-field/id #uuid "d63134ff-ec19-5a58-a63b-10a83dd10e0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525190}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0263ee6f-bf93-5391-a8a8-b7824d1495d1" :question/problem "Consider the matrix $X,$ given by\n\n$$\nX=\\begin{bmatrix}3 & -7 & 3 \\\\ -1 & -8 & -4 \\\\ 1 & -1 & 0\\end{bmatrix}.\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{1}:={R}_{1}-3{R}_{3}$ on $X?$" :question/worked-solution "The operation ${R}_{1}:={R}_{1}-3{R}_{3}$ means that we need to add $-3$ times the third row to the first row.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}X & =\\begin{bmatrix}3 & -7 & 3 \\\\ -1 & -8 & -4 \\\\ 1 & -1 & 0\\end{bmatrix}\\,{R}_{1}:={R}_{1}-3{R}_{3} \\\\  & \\sim\\begin{bmatrix}3+(-3)(1) & -7+(-3)(-1) & 3+(-3)(0) \\\\ -1 & -8 & -4 \\\\ 1 & -1 & 0\\end{bmatrix} \\\\  & \\sim\\begin{bmatrix}0 & -4 & 3 \\\\ -1 & -8 & -4 \\\\ 1 & -1 & 0\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186525176 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09b2f900-3f15-5866-9618-204cddbfe4a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 1 & -4 \\\\ 1 & -3 & 1 \\\\ -1 & -4 & -1\\end{bmatrix}" :db/id #edb/ref 17592186525162} {:answer/id #uuid "15818a12-82fa-579a-a024-e08dbf485d00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & -4 & -1 \\\\ 4 & 1 & -4 \\\\ 1 & -3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186525163} {:answer/id #uuid "38939706-0fed-55ec-a33c-a11f87668533" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-9 & 27 & -5 \\\\ 4 & -15 & -4 \\\\ 1 & -7 & 1\\end{bmatrix}" :db/id #edb/ref 17592186525168} {:answer/id #uuid "f0e1d9ab-6b2b-520e-8508-d83b245a1b32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-9 & -9 & -5 \\\\ 0 & 13 & -8 \\\\ 1 & -3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186525192} {:answer/id #uuid "f4b2936b-e2e8-5f57-aac3-c3443db2b90a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-9 & -9 & -5 \\\\ 1 & -3 & 1 \\\\ 0 & 13 & -8\\end{bmatrix}" :db/id #edb/ref 17592186525194}] :answer-field/correct {:answer/id #uuid "f0e1d9ab-6b2b-520e-8508-d83b245a1b32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-9 & -9 & -5 \\\\ 0 & 13 & -8 \\\\ 1 & -3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186525192} :answer-field/id #uuid "2a4218ac-3308-5543-a41f-fc9f5ffad971" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id 