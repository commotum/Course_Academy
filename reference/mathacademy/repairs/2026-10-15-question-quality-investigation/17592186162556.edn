}_{3}\\,$ and $\\,{C}_{2}:={C}_{2}-3{C}_{3}$" :db/id #edb/ref 17592186402849} {:answer/id #uuid "fa7b06ad-0e94-585e-8310-368aee37f960" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}-3{C}_{3}\\,$ and $\\,{C}_{2}:={C}_{2}+4{C}_{3}$" :db/id #edb/ref 17592186402850} {:answer/id #uuid "b4d041e9-b045-57f0-802c-3e06f948a087" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}-3{C}_{3}\\,$ and $\\,{C}_{2}:={C}_{2}+{C}_{3}$" :db/id #edb/ref 17592186402851} {:answer/id #uuid "87a20a0c-83fd-540e-aa98-9006f1c7cbe2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}-4{C}_{3}\\,$ and $\\,{C}_{2}:={C}_{2}-3{C}_{3}$" :db/id #edb/ref 17592186402852} {:answer/id #uuid "650c8674-8a72-5292-8d19-40ec5f80cf6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}-3{C}_{3}\\,$ and $\\,{C}_{2}:={C}_{2}-4{C}_{3}$" :db/id #edb/ref 17592186402853}] :answer-field/correct {:answer/id #uuid "650c8674-8a72-5292-8d19-40ec5f80cf6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}-3{C}_{3}\\,$ and $\\,{C}_{2}:={C}_{2}-4{C}_{3}$" :db/id #edb/ref 17592186402853} :answer-field/id #uuid "ad6392da-77cb-57bf-a513-c82c1f289bd4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402848}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a68c2e7c-c605-5187-a1fa-13349acf01b6" :question/math-academy-id "q-42917" :question/problem "$$\nA=\\begin{bmatrix}-1 & 2 & 2 \\\\ 1 & 3 & 1 \\\\ 3 & 4 & 1\\end{bmatrix}\n$$\n\n$$\nB=\\begin{bmatrix}-7 & -6 & 2 \\\\ -2 & -1 & 1 \\\\ 0 & 0 & 1\\end{bmatrix}\n$$\n\nBy applying elementary column operations of the form ${C}_{i}:={C}_{i}+k{C}_{3},$ the matrix $A$ can be transformed into the matrix $B.$ What are the elementary column operations?" :question/worked-solution "To transform $A$ into $B,$ we need to make entries to the left of ${a}_{33}=1$ equal to $0.$\n\nTo do this, we can apply the following elementary column operations:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}-1 & 2 & 2 \\\\ 1 & 3 & 1 \\\\ 3 & 4 & 1\\end{bmatrix} &  & \\,\\begin{aligned}{C}_{1}: &={C}_{1}-3{C}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}-7 & 2 & 2 \\\\ -2 & 3 & 1 \\\\ 0 & 4 & 1\\end{bmatrix} &  & \\,\\begin{aligned}{C}_{2}: &={C}_{2}-4{C}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}-7 & -6 & 2 \\\\ -2 & -1 & 1 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =B\\end{aligned}\n$$\n\nTherefore, the elementary column operations are\n\n$\\,$ ${C}_{1}:={C}_{1}-3{C}_{3}\\,$ and $\\,{C}_{2}:={C}_{2}-4{C}_{3}.$"}
