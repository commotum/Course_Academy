db/ref 17592186619178} {:answer/id #uuid "0badb911-dc42-54bd-8f12-70c803d19589" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186619182} {:answer/id #uuid "453f1660-7f7f-549a-9558-278a8f838121" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186619274} {:answer/id #uuid "5b2e620e-e33d-555e-9870-eaf5a4d7f38d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186619310} {:answer/id #uuid "902bb513-64f3-5b27-a11e-5c8dd557012f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186619397}] :answer-field/correct {:answer/id #uuid "5b2e620e-e33d-555e-9870-eaf5a4d7f38d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186619310} :answer-field/id #uuid "2afa55b1-1531-516a-9092-f25b369f0055" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186619608}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5812b78f-60da-5a8e-a675-a6e00a135cfc" :question/math-academy-id "q-150738" :question/problem "How many ${60}^{∘}$ angles are needed to make a complete turn?" :question/worked-solution "Remember that a full turn has a measure of ${360}^{∘}.$\n\nTo find the number of ${60}^{∘}$ angles needed to make a complete turn, we need to find the value of $360÷60.$ Writing this division problem as a fraction, we get\n\n$$\n\\frac{360}{60}.\n$$\n\nFirst, we divide the numerator and denominator by $10:$\n\n$$\n\\begin{aligned}\\frac{360}{60} & = \\\\ \\frac{360÷10}{60÷10} & = \\\\ \\frac{36\\,\\cancel{0}}{6\\,\\cancel{0}} & = \\\\ \\frac{36}{6} & \\end{aligned}\n$$\n\nNow, we evaluate the fraction by expressing it as a division:\n\n$$\n\\begin{aligned}\\frac{36}{6} & = \\\\ 36÷6 & = \\\\ 6 & \\end{aligned}\n$$\n\nTherefore, $6$ angles of ${60}^{∘}$ are required to make a complete turn."}] [{:db/id #edb/ref 17592186619766 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b357ccd-9cfc-5c00-8c33-a202a8d6edd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\left(\\frac{360}{30}\\right)}^{∘}" :db/id #edb/ref 17592186619181} {:answer/id #uuid "58e85661-9ea0-5e44-a212-8c75c63e4cda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\left(\\frac{300}{30}\\right)}^{∘}" :db/id #edb/ref 17592186619305} {:answer/id #uuid "98089b04-35ab-51c6-8857-bde80dd7031a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\left(\\frac{330}{30}\\right)}^{∘}" :db/id #edb/ref 17592186619414} {:answer/id #uuid "b5c884d6-e3d1-5463-99a5-39f9de1e7541" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\left(\\frac{180}{30}\\right)}^{∘}" :db/id #edb/ref 17592186619467} {:answer/id #uuid "d1102984-fa7c-54bf-984f-2f83d3719e47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\left(\\frac{90}{30}\\right)}^{∘}" :db/id #edb/ref 17592186619515}] :answer-field/correct {:answer/id #uuid "0b357ccd-9cfc-5c00-8c33-a202a8d6edd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\left(\\frac{360}{30}\\right)}^{∘}" :db/id #edb/ref 17592186619181} :answer-field/id #uuid "99b229e3-36e3-583b-8d38-f9fe0e014ff8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186619661}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6d23eee3-337c-55dc-9584-ab5df2e93c28" :question/math-academy-id "q-152250" :question/problem "![](images/78/7894f4ca70