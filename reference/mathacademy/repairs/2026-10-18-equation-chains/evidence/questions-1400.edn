#{[{:db/id #edb/ref 17592186619732 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29d607ee-e18a-52a8-adcf-4e283a7292c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2p}{3}" :db/id #edb/ref 17592186619234} {:answer/id #uuid "7f1f3d8c-c789-51a6-b553-2f7c768a34ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2p}{9}" :db/id #edb/ref 17592186619366} {:answer/id #uuid "830144d5-0cd6-5710-912c-064c9b03d926" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5p}{3}" :db/id #edb/ref 17592186619379} {:answer/id #uuid "8af2952f-b532-575a-8aaf-67e3c6614d2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3p}{2}" :db/id #edb/ref 17592186619391} {:answer/id #uuid "d890eb95-dc5e-54cc-8b7c-71ab4823d7fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{p}{8}" :db/id #edb/ref 17592186619524}] :answer-field/correct {:answer/id #uuid "8af2952f-b532-575a-8aaf-67e3c6614d2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3p}{2}" :db/id #edb/ref 17592186619391} :answer-field/id #uuid "22718fd8-4945-50a8-8a4f-1a6a433b68a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186619602}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3053c844-75ab-59a9-af70-75efad73e851" :question/math-academy-id "q-51659" :question/problem "$\\frac{4p}{3}+\\frac{p}{6}=$" :question/worked-solution "We combine the like terms by adding the coefficients:\n\n$$\n\\begin{aligned}\\frac{4p}{3}+\\frac{p}{6} & = \\\\ (\\frac{4}{3}+\\frac{1}{6})p\\end{aligned}\n$$\n\nIn order to add the coefficients, we have to convert them to have the same denominator:\n\n$$\n\\begin{aligned}(\\frac{4}{3}+\\frac{1}{6})p & = \\\\ (\\frac{8}{6}+\\frac{1}{6})p & = \\\\ \\left(\\frac{8+1}{6}\\right)p & = \\\\ \\left(\\frac{9}{6}\\right)p & = \\\\ \\left(\\frac{\\cancel{3}\\cdot 3}{\\cancel{3}\\cdot 2}\\right)p & = \\\\ \\frac{3}{2}p & = \\\\ \\frac{3p}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186619733 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16e40d92-918a-5d6b-9686-2ef40235ea2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "55" :db/id #edb/ref 17592186619197} {:answer/id #uuid "278e6788-dfae-5be1-b886-6b278f07da55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186619228} {:answer/id #uuid "42763e57-191f-5bad-8bba-5e3a396247e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186619268} {:answer/id #uuid "9ab6eabf-1e01-5bbb-9e2f-9eee72cd0139" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186619421} {:answer/id #uuid "e834739a-a27d-58dd-a0f8-790e63046918" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186619549}] :answer-field/correct {:answer/id #uuid "42763e57-191f-5bad-8bba-5e3a396247e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186619268} :answer-field/id #uuid "e9de9474-20f0-58ee-8077-f36e6c2df6d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186619700}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "312e20e7-2316-5138-9692-60f72a632305" :question/math-academy-id "q-150747" :question/problem "How many ${6}^{∘}$ angles are needed to make a complete turn?" :question/worked-solution "Remember that a full turn has a measure of ${360}^{∘}.$\n\nTo find the number of ${6}^{∘}$ angles needed to make a complete turn, we need to find the value of $360÷6.$ Writing this division problem as a fraction, we get\n\n$$\n\\frac{360}{6}.\n$$\n\nWe can solve this division problem using place value strategies as follows:\n\n$$\n\\begin{aligned}\\frac{360}{6} & = \\\\ 360÷6 & = \\\\ 36\\times 10÷6 & = \\\\ (36÷6)\\times 10 & = \\\\ 6\\times 10 & = \\\\ 60 & \\end{aligned}\n$$\n\nTherefore, $60$ angles of ${6}^{∘}$ are required to make a complete turn."}] [{:db/id #edb/ref 17592186619736 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f5c2612-6a83-5598-b4cb-cbb20ae60f95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4r+6" :db/id #edb/ref 17592186619290} {:answer/id #uuid "79769135-0f2b-5b80-a18d-7e2cbe5764e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4r-6" :db/id #edb/ref 17592186619361} {:answer/id #uuid "9983b65c-08d8-5503-99ac-4adfcd0c6f3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r+5" :db/id #edb/ref 17592186619419} {:answer/id #uuid "acf7e6e0-a60b-52ae-a10a-59a696c77af8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4r+5" :db/id #edb/ref 17592186619447} {:answer/id #uuid "f42ee108-8bd9-5769-9bb9-a501afaae829" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r-5" :db/id #edb/ref 17592186619571}] :answer-field/correct {:answer/id #uuid "4f5c2612-6a83-5598-b4cb-cbb20ae60f95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4r+6" :db/id #edb/ref 17592186619290} :answer-field/id #uuid "79abc6e5-2cba-555a-905c-92a302018571" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186619647}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "393fc29c-b44c-5af1-ae30-320e2aa6b248" :question/math-academy-id "q-51449" :question/problem "$r+(r+2)\\cdot 3=$" :question/worked-solution "First, we distribute the $3$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}r+(r+2)\\cdot 3 & = \\\\ r+r\\cdot 3+2\\cdot 3 & = \\\\ r+(3r)+(6) & = \\\\ r+3r+6\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}r+3r+6 & = \\\\ (r+3r)+6 & = \\\\ 4r+6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186619739 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03d2b195-d155-5eac-8be3-d6ceea8cc4e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{∘}" :db/id #edb/ref 17592186619164} {:answer/id #uuid "60296c41-b808-52bb-bbba-f06c2c9c295b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1}^{∘}" :db/id #edb/ref 17592186619316} {:answer/id #uuid "60d9c64f-4672-55a8-a487-08042f8f98f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{4}^{∘}" :db/id #edb/ref 17592186619317} {:answer/id #uuid "61ba9b2d-7421-53d5-942b-9eb49be45df3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2}^{∘}" :db/id #edb/ref 17592186619319} {:answer/id #uuid "f7714702-a066-5dc7-b3db-525a4116fbc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{5}^{∘}" :db/id #edb/ref 17592186619576}] :answer-field/correct {:answer/id #uuid "61ba9b2d-7421-53d5-942b-9eb49be45df3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2}^{∘}" :db/id #edb/ref 17592186619319} :answer-field/id #uuid "39707ed2-9ff4-527c-a8b3-92d64de886c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186619615}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3bc37b68-4774-5b2e-85b8-fa18c6806cb6" :question/math-academy-id "q-152938" :question/problem "![](images/7c/7ccd3efeb63e1113dcd2fef0e7f8263028504813836d1a1b1cf0f086d5e874b9.png)\n\nIn the diagram above, $∠AOB$ is $\\frac{1}{180}$ of a full turn. What is the degree measure of the angle?" :question/worked-solution "Remember that a full turn has a measure of ${360}^{∘}.$\n\nTherefore, the measure of $∠AOB$ is\n\n$$\n\\begin{aligned}\\frac{1}{180}\\times {360}^{∘} & = \\\\ \\frac{1\\times {360}^{∘}}{180} & = \\\\ \\frac{{360}^{∘}}{180} & = \\\\ {\\left(\\frac{360}{180}\\right)}^{∘} & \\end{aligned}\n$$\n\nTo solve this division problem, we divide the numerator and denominator by $10:$\n\n$$\n\\begin{aligned}\\frac{360}{180} & = \\\\ \\frac{360÷10}{180÷10} & = \\\\ \\frac{36\\,\\cancel{0}}{18\\,\\cancel{0}} & = \\\\ \\frac{36}{18} & \\end{aligned}\n$$\n\nNow, we evaluate the fraction by expressing it as a division:\n\n$$\n\\begin{aligned}\\frac{36}{18} & = \\\\ 36÷18 & = \\\\ (6\\times 6)÷(6\\times 3) & = \\\\ 6÷3 & = \\\\ 2 & \\end{aligned}\n$$\n\nTherefore, the measure of $∠AOB$ is ${2}^{∘}.$"}] [{:db/id #edb/ref 17592186619742 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18121ffc-c88b-5e76-a20e-7c07bdd12528" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\left(\\frac{180}{8}\\right)}^{∘}" :db/id #edb/ref 17592186619200} {:answer/id #uuid "1ac12be5-01bc-5ddc-b6e3-af70789e51d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\left(\\frac{270}{8}\\right)}^{∘}" :db/id #edb/ref 17592186619202} {:answer/id #uuid "95915cb4-44c1-5ad8-89b1-0b8bddb4a4d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\left(\\frac{90}{8}\\right)}^{∘}" :db/id #edb/ref 17592186619408} {:answer/id #uuid "97257278-ddee-57b9-ad56-ed4bae1c8e79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\left(\\frac{360}{8}\\right)}^{∘}" :db/id #edb/ref 17592186619413} {:answer/id #uuid "c98ec3e0-8921-5f6e-bc97-8e4a0fbdbf8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\left(\\frac{45}{8}\\right)}^{∘}" :db/id #edb/ref 17592186619502}] :answer-field/correct {:answer/id #uuid "97257278-ddee-57b9-ad56-ed4bae1c8e79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\left(\\frac{360}{8}\\right)}^{∘}" :db/id #edb/ref 17592186619413} :answer-field/id #uuid "62ebb09f-ce2f-50c6-a928-445b20643dae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186619636}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "41d0eeee-102a-5401-8983-a5857cb1db90" :question/math-academy-id "q-150706" :question/problem "![](images/bd/bd26c1543a59159c50c51fcdf127401f9f1c063c63e580cb6a0587c8ce0ad51f.png)\n\nIn the diagram above, $∠AOB$ is $\\frac{1}{8}$ of a full turn. Expressed as an improper fraction, what is the degree measure of the angle?" :question/worked-solution "Remember that a full turn has a measure of ${360}^{∘}.$\n\nTherefore, the measure of $∠AOB$ is\n\n$$\n\\begin{aligned}\\frac{1}{8}\\times {360}^{∘} & = \\\\ \\frac{1\\times {360}^{∘}}{8} & = \\\\ \\frac{{360}^{∘}}{8} & .\\end{aligned}\n$$\n\nIt's common to write the fraction in parentheses and place the degree symbol outside, as follows:\n\n$$\n\\begin{aligned}{\\left(\\frac{360}{8}\\right)}^{∘}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186619751 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c4f98d9-4230-5883-aef0-29b5ca53c095" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186619183}] :answer-field/correct {:answer/id #uuid "0c4f98d9-4230-5883-aef0-29b5ca53c095" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186619183} :answer-field/id #uuid "2510424a-b8c0-5382-aaf4-1fcd6cfa599d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186619606} {:answer-field/choices [{:answer/id #uuid "334eece3-cfab-5a3c-9237-9afa2fc445e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186619249}] :answer-field/correct {:answer/id #uuid "334eece3-cfab-5a3c-9237-9afa2fc445e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186619249} :answer-field/id #uuid "f92fb65c-119a-5dff-87db-2bf34567c025" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186619708}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4ac2614f-b7f1-5cbf-bc6b-f169952e5d07" :question/math-academy-id "q-175618" :question/problem "$\\frac{5x}{2}+6(\\frac{x}{4}+\\frac{3y}{2})=${{field-1}}\n$x\\,+$\n{{field-2}}\n$y$" :question/worked-solution "First, we apply the distributive law:\n\n$$\n\\begin{aligned}\\frac{5x}{2}+6(\\frac{x}{4}+\\frac{3y}{2}) & = \\\\ \\frac{5x}{2}+6\\left(\\frac{x}{4}\\right)+6\\left(\\frac{3y}{2}\\right) & = \\\\ \\frac{5x}{2}+\\frac{3x}{2}+9y\\end{aligned}\n$$\n\nThen, we collect and combine the like terms, simplifying the coefficients as much as possible:\n\n$$\n\\begin{aligned}\\frac{5x}{2}+\\frac{3x}{2}+9y & = \\\\ (\\frac{5x}{2}+\\frac{3x}{2})+9y & = \\\\ \\frac{5x+3x}{2}+9y & = \\\\ \\frac{8x}{2}+9y & = \\\\ 4\\,x+9\\,y\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186619753 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50895fe9-7958-549d-af49-43ff3c30174d" :answer/type {:db/id #