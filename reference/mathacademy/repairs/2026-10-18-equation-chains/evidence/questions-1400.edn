360}{15}\\right)}^{∘}" :db/id #edb/ref 17592186619444} :answer-field/id #uuid "9423d00d-77cf-5591-93be-89ffe3c1e021" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186619657}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6f30df5d-118b-55c5-9747-07cf49ed22a1" :question/math-academy-id "q-150707" :question/problem "![](images/92/92a9eb00d994ab38ff43f388714535e434f787de2c38d0a668df2691494f7215.png)\n\nIn the diagram above, $∠AOB$ is $\\frac{1}{15}$ of a full turn. Expressed as an improper fraction, what is the degree measure of the angle?" :question/worked-solution "Remember that a full turn has a measure of ${360}^{∘}.$\n\nTherefore, the measure of $∠AOB$ is\n\n$$\n\\begin{aligned}\\frac{1}{15}\\times {360}^{∘} & = \\\\ \\frac{1\\times {360}^{∘}}{15} & = \\\\ \\frac{{360}^{∘}}{15} & .\\end{aligned}\n$$\n\nIt's common to write the fraction in parentheses and place the degree symbol outside, as follows:\n\n$$\n\\begin{aligned}{\\left(\\frac{360}{15}\\right)}^{∘}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186619770 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c817462c-82c1-5012-b202-f80c5a331e2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186619501}] :answer-field/correct {:answer/id #uuid "c817462c-82c1-5012-b202-f80c5a331e2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186619501} :answer-field/id #uuid "642f5745-8806-55bd-8faf-44d5fde7d49a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186619637} {:answer-field/choices [{:answer/id #uuid "7d6d1c26-20d0-542f-9b3f-bb177d848cd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186619364}] :answer-field/correct {:answer/id #uuid "7d6d1c26-20d0-542f-9b3f-bb177d848cd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186619364} :answer-field/id #uuid "ff7a8da3-4ee8-54d4-8fbd-003cfc4ceafa" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186619710}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7384edc3-4f01-5a14-977f-08ebf41530f9" :question/math-academy-id "q-171505" :question/problem "$(9+6x)\\cdot (-2)+24=${{field-1}}\n$-$\n{{field-2}}\n$x$" :question/worked-solution "First, we distribute the $(-2)$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}\\begin{aligned}(9+6x)\\cdot (-2)+24 & = \\\\ 9\\cdot (-2)+6x\\cdot (-2)+24 & = \\\\ (-18)+(-12x)+24 & = \\\\ -18-12x+24\\end{aligned}\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n \n\n$$\n\\begin{aligned}-18-12x+24 & = \\\\ (-18+24)-12x & = \\\\ 6-12\\,x & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186619773 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ebe31134-2d7c-593d-9cde-767e0f1244b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186619555}] :answer-field/correct {:answer/id #uuid "ebe31134-2d7c-593d-9cde-767e0f1244b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186619555} :answer-field/id #uuid "98bf3018-e384-5ac7-8223-da6abbc236ef" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186619659} {:answer-field/choices [{:answer/id #uuid "7ce0c854-f24b-5fd6-b9a2-04a138fecace" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186619363}] :answer-field/correct {:answer/id #uuid "7ce0c854-f24b-5fd6-b9a2-04a138fecace" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186619363} :answer-field/id #uuid "b4d0c88f-929a-53b5-a77a-0948f6ef5bec" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186619677}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7ece68ae-b0bf-5eed-aec9-db4933ac6a74" :question/math-academy-id "q-171508" :question/problem "$15z+(2y-z)\\cdot 8=${{field-1}}\n$z\\,+$\n{{field-2}}\n$y$" :question/worked-solution "First, we distribute the $8$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}\\begin{aligned}15z+(2y-z)\\cdot 8 & = \\\\ 15z+2y\\cdot 8+(-z)\\cdot 8 & = \\\\ 15z+(16y)+(-8z) & = \\\\ 15z+16y-8z\\end{aligned}\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}15z+16y-8z & = \\\\ (15z-8z)+16y & = \\\\ 7\\,z+16\\,y\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186619774 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23eebb01-dc51-5b5b-ba19-db27e7344e34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-46y-6" :db/id #edb/ref 17592186619219} {:answer/id #uuid "54f1cdb7-77f3-5c43-ade5-7af246d389c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-y-8" :db/id #edb/ref 17592186619300} {:answer/id #uuid "71f4e0cc-b415-5ea8-8773-334f8cb8bae5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14y-1" :db/id #edb/ref 17592186619347} {:answer/id #uuid "74fe883e-1a1d-596f-aef3-ee0eab904073" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11y-8" :db/id #edb/ref 17592186619352} {:answer/id #uuid "fd2a4d78-3b1f-52ec-97b3-6c3c706d7410" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-46y-8" :db/id #edb/ref 17592186619588}] :answer-field/correct {:answer/id #uuid "fd2a4d78-3b1f-52ec-97b3-6c3c706d7410" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-46y-8" :db/id #edb/ref 17592186619588} :answer-field/id #uuid "ee27581e-f6fe-5e2b-915b-64c94afabd17" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186619701}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "827766df-7b9e-56ed-96ce-9076b092fbcf" :question/math-academy-id "q-141922" :question/problem "$-6y+(-8)(1+5y)=$" :question/worked-solution "First, we distribute the $(-8)$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}\\begin{aligned}-6y+(-8)(1+5y) & = \\\\ -6y+(-8)\\cdot 1+(-8)\\cdot 5y & = \\\\ -6y+(-8)+(-40y) & = \\\\ -6y-8-40y\\end{aligned}\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}\\begin{aligned}-6y-8-40y & = \\\\ (-6y-40y)-8 & = \\\\ -46y-8 & \\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186619779 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02e14526-26ee-5277-b087-adb7e6971199" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7-7y" :db/id #edb/ref 17592186619162} {:answer/id #uuid "62151b7f-8d4a-58de-9dfc-b19a6cd79a62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10-14y" :db/id #edb/ref 17592186619321} {:answer/id #uuid "754fd578-bc50-5f72-acf3-66f1a6365345" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-2y" :db/id #edb/ref 17592186619353} {:answer/id #uuid "ab1eb52a-c82b-5355-90e2-56261339b0bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10-2y" :db/id #edb/ref 17592186619443} {:answer/id #uuid "e75847c9-ebc3-5ce3-9a5f-63135a34e7b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-14y" :db/id #edb/ref 17592186619546}] :answer-field/correct {:answer/id #uuid "62151b7f-8d4a-58de-9dfc-b19a6cd79a62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10-14y" :db/id #edb/ref 17592186619321} :answer-field/id #uuid "606b4b92-ddfb-5179-a088-1287ad5505e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186619635}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "950b66ab-1671-5a63-bace-fdca7c4e25d3" :question/math-academy-id "q-141951" :question/problem "$(1-2y)\\cdot 7+3=$" :question/worked-solution "First, we distribute the $7$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}(1-2y)\\cdot 7+3 & = \\\\ 1\\cdot 7+(-2y)\\cdot 7+3 & = \\\\ (7)+(-14y)+3 & = \\\\ 7-14y+3\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}7-14y+3 & = \\\\ (7+3)-14y & = \\\\ 10-14y\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186619792 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a549a51-3209-5c7f-aba1-b66dd597990b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\left(\\frac{360}{5}\\right)}^{∘}" :db/id #edb/ref 17592186619179} {:answer/id #uuid "1061bfe9-4633-5628-8be3-e25b8851bebb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\left(\\frac{270}{5}\\right)}^{∘}" :db/id #edb/ref 17592186619190} {:answer/id #uuid "43db966d-2146-5e84-be13-c1e59fd5ab9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\left(\\frac{180}{5}\\right)}^{∘}" :db/id #edb/ref 17592186619270} {:answer/id #uuid "65c1bff6-8ae5-5f1e-8cd1-6eec22010830" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\left(\\frac{100}{5}\\right)}^{∘}" :db/id #edb/ref 17592186619325} {:answer/id #uuid "c17b52b0-fd0a-5a7b-a815-2653803dfa1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\left(\\frac{90}{5}\\right)}^{∘}" :db/id #edb/ref 17592186619489}] :answer-field/correct {:answer/id #uuid "0a549a51-3209-5c7f-aba1-b66dd597990b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\left(\\frac{360}{5}\\right)}^{∘}" :db/id #edb/ref 17592186619179} :answer-field/id #uuid "a54b1301-fe82-5933-9647-454953a314f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186619665}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ba72d950-51fa-5cbc-9883-83efa7d7397b" :question/math-academy-id "q-150704" :question/problem "![](images/78/7844748929dd05b53a0c75aed4b050e98482de20bbf49b36454a609c69840ad4.png)\n\nIn the diagram above, $∠AOB$ is $\\frac{1}{5}$ of a full turn. Expressed as an improper fraction, what is the degree measure of the angle?" :question/worked-solution "Remember that a full turn has a measure of ${360}^{∘}.$\n\nTherefore, the measure of $∠AOB$ is\n\n$$\n\\begin{aligned}\\frac{1}{5}\\times {360}^{∘} & = \\\\ \\frac{1\\times {360}^{∘}}{5} & = \\\\ \\frac{{360}^{∘}}{5} & .\\end{aligned}\n$$\n\nIt's common to write the fraction in parentheses and place the degree symbol outside, as follows:\n\n$$\n\\begin{aligned}{\\left(\\frac{360}{5}\\right)}^{∘}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186619795 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00c08082-a35e-5192-9cee-e0fc7b183339" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\left(\\frac{180}{18}\\right)}^{∘}" :db/id #edb/ref 17592186619153} {:answer/id #uuid "4ba3a7ae-f13e-54e1-9ccb-552c8e09a