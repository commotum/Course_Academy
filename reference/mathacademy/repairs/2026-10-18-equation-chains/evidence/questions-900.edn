ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "51b4f2a2-d5b5-571a-9fa7-6251a05de673" :question/math-academy-id "q-72667" :question/problem "Simplify $\\frac{{u}^{-4}}{{u}^{-7}}.$" :question/worked-solution "We subtract the exponents, as follows:\n\n$$\n\\begin{aligned}\\frac{{u}^{-4}}{{u}^{-7}} & = \\\\ {u}^{-4-(-7)} & = \\\\ {u}^{-4+7} & = \\\\ {u}^{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485534 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f21b191-5b62-5c0c-994b-82c06678781d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\sqrt[3]{4}-\\sqrt{3}" :db/id #edb/ref 17592186484874} {:answer/id #uuid "4e601af1-3e88-5fbe-ba65-a25c0f8a7dda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21\\sqrt[3]{4}-\\sqrt{3}" :db/id #edb/ref 17592186484988} {:answer/id #uuid "53dfe897-c9ef-5994-b809-12a2b1fe9e9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt[3]{4}-\\sqrt{3}" :db/id #edb/ref 17592186485002} {:answer/id #uuid "816719f9-fd7d-5be7-bd5d-0eb6da521c78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt{3}" :db/id #edb/ref 17592186485096} {:answer/id #uuid "e7709f1c-d64f-535c-bdca-965e218fce82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20\\sqrt[3]{4}" :db/id #edb/ref 17592186485304}] :answer-field/correct {:answer/id #uuid "4e601af1-3e88-5fbe-ba65-a25c0f8a7dda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21\\sqrt[3]{4}-\\sqrt{3}" :db/id #edb/ref 17592186484988} :answer-field/id #uuid "cf930231-9174-5665-b2ca-c6932f6a88a4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485456}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "589b43ec-34cc-5c99-9404-4a02a5e69293" :question/math-academy-id "q-134564" :question/problem "Simplify $4\\sqrt[3]{500}+\\sqrt[3]{4}-\\sqrt{3}.$" :question/worked-solution "First, we use the product rule for radicals, as follows:\n\n$$\n\\begin{aligned}\\sqrt[3]{500} & =\\sqrt[3]{125\\cdot 4}=\\sqrt[3]{125}\\cdot \\sqrt[3]{4}=5\\sqrt[3]{4} & \\end{aligned}\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}4\\sqrt[3]{500}+\\sqrt[3]{4}-\\sqrt{3} & = \\\\ 4(5\\sqrt[3]{4})+\\sqrt[3]{4}-\\sqrt{3} & = \\\\ 20\\sqrt[3]{4}+\\sqrt[3]{4}-\\sqrt{3}.\\end{aligned}\n$$\n\nNow, we can combine the two $\\sqrt[3]{4}$ terms together:\n\n$$\n\\begin{aligned}20\\sqrt[3]{4}+\\sqrt[3]{4}-\\sqrt{3} & = \\\\ (20\\sqrt[3]{4}+\\sqrt[3]{4})-\\sqrt{3} & = \\\\ (20+1)\\sqrt[3]{4}-\\sqrt{3} & = \\\\ 21\\sqrt[3]{4}-\\sqrt{3} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485537 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ab91932-e355-5352-aba3-b6df560e9b3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{7}+14\\sqrt[3]{6}" :db/id #edb/ref 17592186484836} {:answer/id #uuid "55572885-5954-5b49-bbf7-ae2b41c0b283" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{7}+18\\sqrt[3]{6}" :db/id #edb/ref 17592186485010} {:answer/id #uuid "7451faf5-8af1-525e-8e9d-8f546d5c31b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{7}+2\\sqrt[3]{6}" :db/id #edb/ref 17592186485068} {:answer/id #uuid "90c5b765-e85d-55b5-bfdb-78a5e3f6f707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15\\sqrt[3]{6}" :db/id #edb/ref 17592186485133} {:answer/id #uuid "ebecd2a6-8dca-5397-bfd3-0a2018b2b27f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{7}" :db/id #edb/ref 17592186485320}] :answer-field/correct {:answer/id #uuid "0ab91932-e355-5352-aba3-b6df560e9b3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{7}+14\\sqrt[3]{6}" :db/id #edb/ref 17592186484836} :answer-field/id #uuid "648d8aec-59b5-5928-b88a-f36a1aea213d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485407}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5ea12d57-149c-5e75-92c8-881bf2f1c4e9" :question/math-academy-id "q-134567" :question/problem "Simplify $\\sqrt{7}+5\\sqrt[3]{162}-\\sqrt[3]{6}.$" :question/worked-solution "First, we use the product rule for radicals, as follows:\n\n$$\n\\begin{aligned}\\sqrt[3]{162} & =\\sqrt[3]{27\\cdot 6}=\\sqrt[3]{27}\\cdot \\sqrt[3]{6}=3\\sqrt[3]{6} & \\end{aligned}\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}\\sqrt{7}+5\\sqrt[3]{162}-\\sqrt[3]{6} & = \\\\ \\sqrt{7}+5(3\\sqrt[3]{6})-\\sqrt[3]{6}= \\\\ \\sqrt{7}+15\\sqrt[3]{6}-\\sqrt[3]{6}. & \\end{aligned}\n$$\n\nNow, we can combine the two $\\sqrt[3]{6}$ terms together:\n\n$$\n\\begin{aligned}\\sqrt{7}+15\\sqrt[3]{6}-\\sqrt[3]{6}= \\\\ \\sqrt{7}+(15\\sqrt[3]{6}-\\sqrt[3]{6}) & = \\\\ \\sqrt{7}+(15-1)\\sqrt[3]{6} & = \\\\ \\sqrt{7}+14\\sqrt[3]{6} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485540 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50bdbe27-2bc4-5ad2-a889-9db297e5d396" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5w{z}^{10}" :db/id #edb/ref 17592186484991} {:answer/id #uuid "7ec5a431-f189-59bc-9e59-56377be1d86b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10{w}^{2}}{{z}^{10}}" :db/id #edb/ref 17592186485093} {:answer/id #uuid "ac1d18ab-a726-5ed7-85a6-e6ebc28f5085" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25w}{{z}^{5}}" :db/id #edb/ref 17592186485189} {:answer/id #uuid