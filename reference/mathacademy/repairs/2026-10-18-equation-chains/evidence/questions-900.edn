#{[{:db/id #edb/ref 17592186483361 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fb21ada-6744-5f70-b1dc-ecaec4ba734e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186482872}] :answer-field/correct {:answer/id #uuid "1fb21ada-6744-5f70-b1dc-ecaec4ba734e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186482872} :answer-field/id #uuid "36a2e263-cd65-5517-af18-d6768ff0e51b" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186483257} {:answer-field/choices [{:answer/id #uuid "5050617d-d60e-5d12-93de-50f83c35fc74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186482955}] :answer-field/correct {:answer/id #uuid "5050617d-d60e-5d12-93de-50f83c35fc74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186482955} :answer-field/id #uuid "4894e318-1ff2-5f50-b281-d62b33594a63" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186483262} {:answer-field/choices [{:answer/id #uuid "b0647f1f-8929-5a4c-a972-69473a57b03a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186483111}] :answer-field/correct {:answer/id #uuid "b0647f1f-8929-5a4c-a972-69473a57b03a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186483111} :answer-field/id #uuid "d93f8853-6923-594d-a9b4-a58c020bf26c" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186483325}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3b50cd1f-80a5-51f1-b3eb-2663a6e28812" :question/math-academy-id "q-224897" :question/problem "Factor the following quadratic expression.\n\n$20{b}^{2}-12b+1=(2b\\,-$\n{{field-1}}$)($\n{{field-2}}$b\\,-$\n{{field-3}}$)$" :question/worked-solution "We must factor the quadratic expression\n\n$$\n20{b}^{2}-12b+1.\n$$\n\nFirst, we find two numbers that \n\n- multiply to the product of the quadratic coefficient and the constant ($20\\times 1=20$), and\n\n- add to the linear coefficient ($-12$).\n\nSince the linear coefficient is negative and the product of the quadratic coefficient and constant is positive, we only need to consider the negative factor pairs of $20.$\n\nThe negative factor pairs of $20$ are\n\n$$\n(-1,-20),\\,(-2,-10),\\,(-4,-5).\n$$\n\nNotice the numbers in the factor pair $(-2,-10)$ add to $-12:$ \n\n$$\n\\begin{aligned}(-2)+(-10) & =-12\\,✓\\end{aligned}\n$$\n\nThen, we write the linear term as $-2b-10b,$ and factor the result by grouping:\n\n$$\n\\begin{aligned}20{b}^{2}-12b+1 & = \\\\ 20{b}^{2}-2b-10b+1 & = \\\\ (20{b}^{2}-2b)-(10b-1) & = \\\\ 2b(10b-1)-(10b-1) & = \\\\ (2b-1)(10b-1) & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186483362 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c9b5b22-1261-57ae-b393-0b6b1b6c421d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-4{n}^{2}" :db/id #edb/ref 17592186482831} {:answer/id #uuid "76dd4622-7b42-5852-945a-b5eead441723" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+4{n}^{4}" :db/id #edb/ref 17592186483021} {:answer/id #uuid "a5613e99-0c63-5fea-a3f4-de16d9f37878" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+2{n}^{2}" :db/id #edb/ref 17592186483093} {:answer/id #uuid "be0124c8-a638-5d71-8192-beef025b53d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-2{n}^{2}" :db/id #edb/ref 17592186483130} {:answer/id #uuid "fead1c73-30c9-59a8-94c2-69c1b572ca7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-4{n}^{4}" :db/id #edb/ref 17592186483239}] :answer-field/correct {:answer/id #uuid "fead1c73-30c9-59a8-94c2-69c1b572ca7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-4{n}^{4}" :db/id #edb/ref 17592186483239} :answer-field/id #uuid "b6b48621-49d9-5b78-b295-e4625cfd3145" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483314}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3eea8cdc-2e47-57e6-a2cc-366fd1162497" :question/math-academy-id "q-5131" :question/problem "$(1-2{n}^{2})(1+2{n}^{2})=$" :question/worked-solution "We will use the difference of squares formula:\n\n$$\n(a+b)(a-b)={a}^{2}-{b}^{2}\n$$\n\nSubstituting $a=1$ and $b=2{n}^{2},$ we have\n\n$$\n\\begin{aligned}(1-2{n}^{2})(1+2{n}^{2}) & = \\\\ {1}^{2}-{(2{n}^{2})}^{2} & = \\\\ 1-4{n}^{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186483365 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d31edaf-e68f-5896-886f-ba0c8884747c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5h-3)(h+3)" :db/id #edb/ref 17592186483031} {:answer/id #uuid "83ff1739-d53c-5c8a-bb8e-be1d8a7c3c55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5h+3)(h-3)" :db/id #edb/ref 17592186483042} {:answer/id #uuid "e66b9ced-ce85-5b70-a931-a9180edc99f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5h+3)(h-1)" :db/id #edb/ref 17592186483202} {:answer/id #uuid "f1e12de1-9652-519c-a92a-edcd7c96464d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5h+1)(h-3)" :db/id #edb/ref 17592186483218} {:answer/id #uuid "f61fabd3-a06c-5ead-8f35-37c1f39d63e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5h+1)(h-9)" :db/id #edb/ref 17592186483227}] :answer-field/correct {:answer/id #uuid "83ff1739-d53c-5c8a-bb8e-be1d8a7c3c55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5h+3)(h-3)" :db/id #edb/ref 17592186483042} :answer-field/id #uuid "37c5d472-7e62-5f47-b3dc-73ce05638ddc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483258}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "433698fd-3b83-5c8a-9280-a485202f8699" :question/math-academy-id "q-52254" :question/problem "Factor $5{h}^{2}-12h-9.$" :question/worked-solution "We must factor the quadratic expression\n\n$$\n5{h}^{2}-12h-9.\n$$\n\nFirst, we find two numbers that \n\n- multiply to the product of the quadratic coefficient and the constant ($5\\times -9=-45$), and\n\n- add to the linear coefficient ($-12$).\n\nThe factor pairs of $-45$ are\n\n$$\n(1,-45),\\,\\,(-1,45),\\,\\,(3,-15),\\,\\,(-3,15),\\,\\,(5,-9),\\,\\,(-5,9).\n$$\n\nNotice the numbers in the factor pair $(3,-15)$ add to $-12:$ \n\n$$\n3-15=-12\\,✓\n$$\n\nThen, rewrite the linear term as $3h-15h,$ and factor the result by grouping:\n\n$$\n\\begin{aligned}5{h}^{2}-12h-9 & = \\\\ 5{h}^{2}+3h-15h-9 & = \\\\ 5{h}^{2}-15h+3h-9 & = \\\\ (5{h}^{2}-15h)+(3h-9) & = \\\\ 5h(h-3)+3(h-3) & = \\\\ (5h+3)(h-3) & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186483366 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4616f056-d400-5fed-af7e-805ceebb663a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{6}" :db/id #edb/ref 17592186482935} {:answer/id #uuid "56837697-58ac-5ac8-bb0e-bac392cdf4c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{6}" :db/id #edb/ref 17592186482964} {:answer/id #uuid "bc62b660-ca90-5160-8d3b-b8f9d40e5821" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{6}" :db/id #edb/ref 17592186483129} {:answer/id #uuid "ca122d4f-8f7f-562e-8e01-40a512ff22e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{3}" :db/id #edb/ref 17592186483147} {:answer/id #uuid "dfbfbe94-55cc-5cd7-acb5-5a1300990f3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{2}" :db/id #edb/ref 17592186483190}] :answer-field/correct {:answer/id #uuid "bc62b660-ca90-5160-8d3b-b8f9d40e5821" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{6}" :db/id #edb/ref 17592186483129} :answer-field/id #uuid "8e90436a-a035-56c5-a51b-e49d7f390847" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483297}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "47b013be-1b3f-5223-b931-2de57a055397" :question/math-academy-id "q-110876" :question/problem "Evaluate $\\sqrt{x+6}$ for $x=18.$" :question/worked-solution "We replace $x$ with $18$ in the given expression, and simplify:\n\n$$\n\\begin{aligned}\\sqrt{x+6} & = \\\\ \\sqrt{18+6} & = \\\\ \\sqrt{24}\\end{aligned}\n$$\n\nWe can simplify even further using the product rule:\n\n$$\n\\begin{aligned}\\sqrt{24} & = \\\\ \\sqrt{4\\cdot 6} & = \\\\ \\sqrt{{2}^{2}\\cdot 6} & = \\\\ \\sqrt{{2}^{2}}\\cdot \\sqrt{6} & = \\\\ 2\\sqrt{6}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186483368 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79fb38e2-b8f8-59e4-8e66-c482f633d831" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2m}+{x}^{m}{y}^{n}-2{y}^{2n}" :db/id #edb/ref 17592186483024} {:answer/id #uuid "8651a14d-b29c-5410-b18b-9006aa26e59b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2m}-4{y}^{2n}" :db/id #edb/ref 17592186483044} {:answer/id #uuid "a96ea889-07a5-542d-bfc6-b28a257fafd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{m}+{x}^{m}{y}^{n}-2{y}^{n}" :db/id #edb/ref 17592186483098} {:answer/id #uuid "c8e6d4be-489a-5d61-86a2-a12c1aba0257" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{m}+{x}^{m}{y}^{n}-2{y}^{n}" :db/id #edb/ref 17592186483146} {:answer/id #uuid "f72a7406-29d1-50c7-b869-6a5dfeeab416" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2m}+4{x}^{m}{y}^{n}+2{y}^{2n}" :db/id #edb/ref 17592186483230}] :answer-field/correct {:answer/id #uuid "8651a14d-b29c-5410-b18b-9006aa26e59b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2m}-4{y}^{2n}" :db/id #edb/ref 17592186483044} :answer-field/id #uuid "9c66292c-e36a-5e53-8923-f81b1303b890" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483303}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4a8a7bf3-5b8f-5a40-b9f8-b1ddba947324" :question/math-academy-id "q-31176" :question/problem "$({x}^{m}-2{y}^{n})({x}^{m}+2{y}^{n})=$" :question/worked-solution "We will use the difference of squares formula:\n\n$$\n(a+b)(a-b)={a}^{2}-{b}^{2}\n$$\n\nSubstituting $a={x}^{m}$ and $b=2{y}^{n},$ we have\n\n$$\n\\begin{aligned}({x}^{m}-2{y}^{n})({x}^{m}+2{y}^{n}) & = \\\\ {({x}^{m})}^{2}-{(2{y}^{n})}^{2} & = \\\\ {({x}^{m})}^{2}-{2}^{2}\\cdot {({y}^{n})}^{2} & = \\\\ {x}^{2m}-4{y}^{2n}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186483375 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27a47b63-7e07-581d-978f-3dccf5855a7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186482881} {:answer/id #uuid "56772ae2-cad4-5fde-980a-bbea606ea018" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186482963} {:answer/id #uuid "a2f632f9-78c7-5486-b830-3a6212593dcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186483085} {:answer/id #uuid "cd9434a0-e706-544d-be79-f52eabca7932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186483155} {:answer/id #uuid "e4f5c15f-6fb5-5fc1-a3e6-e8629f0df664" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186483198}] :answer-field/correct {:answer/id #uuid "a2f632f9-78c7-5486-b830-3a6212593dcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186483085} :answer-field/id #uuid "51974270-1ca8-52e1-824e-f717ac5b66dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483266}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6568de84-d0cb-5425-90cd-1a3ef070df84" :question/math-academy-id "q-78193" :question/problem "What is the coefficient of $v{w}^{2}$ in the product $(v+w)({v}^{2}+4vw+{w}^{2})?$" :question/worked-solution "We distribute both terms of the binomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}(v+w)({v}^{2}+4vw+{w}^{2}) & = \\\\ v({v}^{2}+4vw+{w}^{2})+w({v}^{2}+4vw+{w}^{2}) & = \\\\ {v}^{3}+4{v}^{2}w+v{w}^{2}+{v}^{2}w+4v{w}^{2}+{w}^{3} & = \\\\ {v}^{3}+5{v}^{2}w+5v{w}^{2}+{w}^{3} & \\end{aligned}\n$$\n\nTherefore, the coefficient of $v{w}^{2}$ is $5.$"}] [{:db/id #edb/ref 17592186483376 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15099937-83e9-5c72-9432-7caf2eb1b27a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81+18y+{y}^{2}" :db/id #edb/ref 17592186482849} {:answer/id #uuid "1a5542ec-b9b2-564c-871d-15f3d7a885cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81-18y-{y}^{2}" :db/id #edb/ref 17592186482864} {:answer/id #uuid "42d99c28-fe1a-598e-9ff0-09981c2f67c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81+18y-{y}^{2}" :db/id #edb/ref 17592186482926} {:answer/id #uuid "500a8310-ca26-58f9-8936-872ef14dcc38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81-{y}^{2}" :db/id #edb/ref 17592186482953} {:answer/id #uuid "665d0ee9-863a-5693-bca5-7a38edc7ca78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81+{y}^{2}" :db/id #edb/ref 17592186482991}] :answer-field/correct {:answer/id #uuid "500a8310-ca26-58f9-8936-872ef14dcc38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81-{y}^{2}" :db/id #edb/ref 17592186482953} :answer-field/id #uuid "e15b82c8-d6ca-58f4-9a30-37b8485a176e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483329}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6c871005-09ff-5497-b5c8-d9bfa75173ab" :question/math-academy-id "q-110716" :question/problem "$(9-y)(9+y)=$" :question/worked-solution "We will use the difference of squares formula:\n\n$$\n(a+b)(a-b)={a}^{2}-{b}^{2}\n$$\n\nSubstituting $a=9$ and $b=y,$ we have\n\n$$\n\\begin{aligned}(9-y)(9+y) & = \\\\ {9}^{2}-{y}^{2} & = \\\\ 81-{y}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb