} & = \\\\ {n}^{5} & \\end{aligned}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{n}{{n}^{4}}\\cdot {n}^{8}={n}^{5}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485520 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9cd5afff-35ba-512f-895d-7fc13413ccb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{30}}{36}" :db/id #edb/ref 17592186485158} {:answer/id #uuid "a1376f32-3c6c-502e-874b-c9b520266ec5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{6}}{6}" :db/id #edb/ref 17592186485166} {:answer/id #uuid "bffd9b26-1657-573a-8d7e-6c67e8061588" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{30}}{6}" :db/id #edb/ref 17592186485228} {:answer/id #uuid "e9662345-2198-5134-aafa-9713775ded1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{6}}{36}" :db/id #edb/ref 17592186485311} {:answer/id #uuid "fa639878-d1ba-5045-bbb7-9fadaab646b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{6}" :db/id #edb/ref 17592186485352}] :answer-field/correct {:answer/id #uuid "a1376f32-3c6c-502e-874b-c9b520266ec5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{6}}{6}" :db/id #edb/ref 17592186485166} :answer-field/id #uuid "70cf80ed-f33e-5432-9ed8-1a1a922f0cfd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485411}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3e56e0ed-1ba2-5a25-8811-643841869c5d" :question/math-academy-id "q-68832" :question/problem "$\\frac{5}{\\sqrt{6}}=$" :question/worked-solution "To remove the radical $\\sqrt{6}$ fro