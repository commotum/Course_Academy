nswer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186483330}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b84ec7b7-6813-5817-a8fb-50c9de1b86e9" :question/math-academy-id "q-237281" :question/problem "Expand the following product.\n\n$(5x-\\sqrt{6})(5x+\\sqrt{6})=$\n{{field-1}}" :question/worked-solution "We will use the difference of squares formula:\n\n$$\n(a+b)(a-b)={a}^{2}-{b}^{2}\n$$\n\nSubstituting $a=5x$ and $b=\\sqrt{6},$ we have\n\n$$\n\\begin{aligned}(5x-\\sqrt{6})(5x+\\sqrt{6}) & = \\\\ (5x)^{2}-(\\sqrt{6})^{2} & = \\\\ 25{x}^{2}-6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186483401 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44c26405-c9e8-5b8d-b617-8a4c895247f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186482931} {:answer/id #uuid "6b981511-553b-51fd-9968-f5007d617ad5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}-\\sqrt[3]{4}" :db/id #edb/ref 17592186482998} {:answer/id #uuid "89e3ad7b-e29a-54e1-93c0-e9b1de54fa63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}-4\\sqrt[3]{2}" :db/id #edb/ref 17592186483054} {:answer/id #uuid "e462e986-00a1-584c-9e31-8de004506627" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}-\\sqrt[3]{2}" :db/id #edb/ref 17592186483197} {:answer/id #uuid "f5b60c12-92c3-5869-8174-2f4a7acd8cae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5-\\sqrt[3]{2}" :db/id #edb/ref 17592186483225}] :answer-field/correct {:answer/id #uuid "44c26405-c9e8-5b8d-b617-8a4c895247f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186482931} :answer-field/id #uuid "b5c17bd7-94a6-5