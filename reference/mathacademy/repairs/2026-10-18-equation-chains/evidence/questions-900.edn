\n\\begin{aligned}5\\sqrt{5}-2\\sqrt{3}+3\\sqrt{5} & = \\\\ (5\\sqrt{5}+3\\sqrt{5})-2\\sqrt{3} & = \\\\ (5+3)\\sqrt{5}-2\\sqrt{3} & = \\\\ 8\\sqrt{5}-2\\sqrt{3} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485549 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f1b56f4-5312-5a1d-9090-9aa8edf36063" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12b" :db/id #edb/ref 17592186484847} {:answer/id #uuid "1e73fca2-d467-5d96-bd18-0876077189a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64{b}^{3}" :db/id #edb/ref 17592186484872} {:answer/id #uuid "2a2a8d78-d5d4-5ef9-897e-b199b87deb22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16{b}^{3}" :db/id #edb/ref 17592186484901} {:answer/id #uuid "ad9b06a7-56ba-59ed-8de1-eec7ce9ba740" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-64{b}^{3}" :db/id #edb/ref 17592186485191} {:answer/id #uuid "e863e271-50f0-5297-9ad5-9e8318153f0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12{b}^{3}" :db/id #edb/ref 17592186485306}] :answer-field/correct {:answer/id #uuid "1e73fca2-d467-5d96-bd18-0876077189a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64{b}^{3}" :db/id #edb/ref 17592186484872} :answer-field/id #uuid "a14b1298-3747-5fd1-899b-de85652e50c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485436}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7f18a486-2b6b-5f9e-8e38-324212260786" :question/math-academy-id "q-22334" :question/problem "Simplify $-(-4b)^{3}.$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}-(-4b)^{3} & = \\\\ -((-4)^{3}\\cdot {b}^{3}) & = \\\\ -(-64{b}^{3}) & = \\\\ 64{b}^{3} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485553 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00ddfa3b-7d8d-5460-89cf-64315fc87036" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{q}^{5}}" :db/id #edb/ref 17592186484815} {:answer/id #uuid "4692b4b8-c0ef-5a31-bbc7-0c0cee5491eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{q}^{5}" :db/id #edb/ref 17592186484967} {:answer/id #uuid "46a86097-4fe5-5eec-b23c-2d48991beefe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{q}^{3}" :db/id #edb/ref 17592186484968} {:answer/id #uuid "64ef98c1-92eb-56d9-954f-a4978e35f40c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{q}^{3}}" :db/id #edb/ref 17592186485037} {:answer/id #uuid "e0f90363-cd83-574a-8e4c-59b61b493419" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186485292}] :answer-field/correct {:answer/id #uuid "64ef98c1-92eb-56d9-954f-a4978e35f40c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{q}^{3}}" :db/id #edb/ref 17592186485037} :answer-field/id #uuid "18a56d48-4b3b-5ee9-aa5b-0b92f3bd8a6d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485377}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8ac0604e-5343-56c6-8dd6-8c555b217bdc" :question/math-academy-id "q-72682" :question/problem "Simplify the  expression\n${q}^{2}\\cdot \\frac{{q}^{3}}{{q}^{8}}.$" :question/worked-solution "First we apply the quotient rule, subtracting exponents in the fraction:\n\n$$\n\\begin{aligned}\\begin{aligned}{q}^{2}\\cdot \\frac{{q}^{3}}{{q}^{8}} & = \\\\ {q}^{2}\\cdot {q}^{3-8} & = \\\\ {q}^{2}\\cdot {q}^{-5} & \\end{aligned}\\end{aligned}\n$$\n\nThen we apply the product rule, adding exponents in the product:\n\n$$\n\\begin{aligned}\\begin{aligned}{q}^{2}\\cdot {q}^{-5} & = \\\\ {q}^{2+(-5)} & = \\\\ {q}^{2-5} & = \\\\ {q}^{-3} & = \\\\ \\frac{1}{{q}^{3}} & \\end{aligned}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{q}^{2}\\cdot \\frac{{q}^{3}}{{q}^{8}}=\\frac{1}{{q}^{3}}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485554 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2aaf527d-34f7-5ae4-b8a8-94bafa5a4ff2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}-3\\sqrt{3}" :db/id #edb/ref 17592186484903} {:answer/id #uuid "3d304dda-963e-5449-a2b5-7b6c48a04212" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{3}+3\\sqrt{2}" :db/id #edb/ref 17592186484948} {:answer/id #uuid "99379c0c-fbdc-5b04-b21f-46cc528ca026" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186485148} {:answer/id #uuid "e58ff2d0-9c33-5c99-b226-92f645dc8184" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{5}" :db/id #edb/ref 17592186485301} {:answer/id #uuid "f61ffdce-8ed4-5969-8dc1-2edeb1532a5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{3}" :db/id #edb/ref 17592186485344}] :answer-field/correct {:answer/id #uuid "3d304dda-963e-5449-a2b5-7b6c48a04212" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{3}+3\\sqrt{2}" :db/id #edb/ref 17592186484948} :answer-field/id #uuid "313f6d3b-87ef-5fe1-a20b-9b07b45be5c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485388}] :question/diffi