ty/easy} :question/id #uuid "8c05d166-8209-505e-9ddb-93264370350e" :question/math-academy-id "q-51802" :question/problem "${(5w)}^{3}=$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}{(5w)}^{3} & = \\\\ {5}^{3}\\cdot {w}^{3} & = \\\\ 125{w}^{3} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485556 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00ecdfe3-9b08-5fb1-b2c4-f7c14a6803f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{6}}{7}" :db/id #edb/ref 17592186484816} {:answer/id #uuid "3d1ca554-efa8-56a0-b421-8583c61a580d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{14}" :db/id #edb/ref 17592186484946} {:answer/id #uuid "4b832563-57cf-5661-a855-3ef11dd96c9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{7}" :db/id #edb/ref 17592186484985} {:answer/id #uuid "7d52b5db-b014-5690-b1f1-62a55cd0fe0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{14}" :db/id #edb/ref 17592186485090} {:answer/id #uuid "95721d58-634e-5313-b505-bcce7a586680" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{7}" :db/id #edb/ref 17592186485139}] :answer-field/correct {:answer/id #uuid "00ecdfe3-9b08-5fb1-b2c4-f7c14a6803f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{6}}{7}" :db/id #edb/ref 17592186484816} :answer-field/id #uuid "cdfbed6e-c86a-586c-98ee-e7940e24e99d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485455}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8e0ee09c-000d-5a57-8be4-46c85b5f432d" :question/math-academy-id "q-213447" :question/problem "$\\frac{4\\sqrt{3}}{7\\sqrt{2}}=$" :question/worked-solution "To remove the radical $\\sqrt{2}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{2}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{4\\sqrt{3}}{7\\sqrt{2}} & = \\\\ \\frac{4\\sqrt{3}}{7\\sqrt{2}}\\cdot \\frac{\\sqrt{2}}{\\sqrt{2}} & = \\\\ \\frac{4\\sqrt{3}\\cdot \\sqrt{2}}{7\\cdot (\\sqrt{2})^{2}} & = \\\\ \\frac{4\\sqrt{3}\\cdot \\sqrt{2}}{7\\cdot 2} & = \\\\ \\frac{4\\sqrt{3}\\cdot \\sqrt{2}}{14} & = \\\\ \\frac{2\\sqrt{3}\\cdot \\sqrt{2}}{7}\\end{aligned}\n$$\n\nNow, we use the product rule:\n\n$$\n\\begin{aligned}\\frac{2\\sqrt{3}\\cdot \\sqrt{2}}{7} & = \\\\ \\frac{2\\sqrt{2\\cdot 3}}{7} & = \\\\ \\frac{2\\sqrt{6}}{7} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485557 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7270e6c9-0760-5534-bd69-99eb37676bfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10\\sqrt{3}}{3}" :db/id #edb/ref 17592186485062} {:answer/id #uuid "8e6482d3-8b4e-51f9-af69-bb7d168e6604" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{10}" :db/id #edb/ref 17592186485124} {:answer/id #uuid "c1271618-7e94-5c30-b124-fcca133353e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10\\sqrt{3}}{9}" :db/id #edb/ref 17592186485230} {:answer/id #uuid "de090934-196d-5a6c-921a-1acde47b6cbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{30}}{9}" :db/id #edb/ref 17592186485282} {:answer/id #uuid "f361e532-24a1-5450-b639-abcbe4c85cc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{30}}{3}" :db/id #edb/ref 17592186485335}] :answer-field/correct {:answer/id #uuid "7270e6c9-0760-5534-bd69-99eb37676bfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10\\sqrt{3}}{3}" :db/id #edb/ref 17592186485062} :answer-field/id #uuid "7cac3015-4f89-5535-8102-a1a6527db224" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485416}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9207bda9-62e5-54ee-9184-105f95fd4290" :question/math-academy-id "q-68834" :question/problem "$\\frac{10}{\\sqrt{3}}=$" :question/worked-solution "To remove the radical $\\sqrt{3}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{3}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{10}{\\sqrt{3}} & = \\\\ \\frac{10}{\\sqrt{3}}\\cdot \\frac{\\sqrt{3}}{\\sqrt{3}} & = \\\\ \\frac{10\\sqrt{3}}{(\\sqrt{3})^{2}} & = \\\\ \\frac{10\\sqrt{3}}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485565 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "434da3af-7fa0-5d0d-a654-44fb07e9ab54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{19}" :db/id #edb/ref 17592186484963} {:answer/id #uuid "51af9948-ec0f-5e4a-8822-48dac8698c6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{13}}{13}" :db/id #edb/ref 17592186484995} {:answer/id #uuid "a70bf489-59ff-5a5c-a982-86836a76afb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6\\sqrt{13}}{13}" :db/id #edb/ref 17592186485179} {:answer/id #uuid "da1097e4-58f2-5451-bca0-1353ad387c81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6\\sqrt{6}}{13}" :db/id #edb/ref 17592186485275} {:answer/id #uuid "e9cf44e1-ef05-5e96-a33f-2d93a5fd1480" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6\\sqrt{13}}{19}" :db/id #edb/ref 17592186485314}] :answer-field/correct {:answer/id #uuid "a70bf489-59ff-5a5c-a982-86836a76afb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6\\sqrt{13}}{13}" :db/id #edb/ref 17592186485179} :answer-field/id #uuid "8f1fe427-f208-5905-b459-e17ca82b3a3d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485425}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a64a909b-05fd-57b7-b6a0-ceee0bbc9acd" :question/math-academy-id "q-99624" :question/problem "$\\frac{6}{\\sqrt{13}}=$" :question/worked-solution "To remove the radical $\\sqrt{13}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{13}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{6}{\\sqrt{13}} & = \\\\ \\frac{6}{\\sqrt{13}}\\cdot \\frac{\\sqrt{13}}{\\sqrt{13}} & = \\\\ \\frac{6\\sqrt{13}}{(\\sqrt{13})^{2}} & = \\\\ \\frac{6\\sqrt{13}}{13}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485566 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "771e6036-105c-5e38-8132-37931b12b769" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\sqrt{5}" :db/id #edb/ref 17592186485071} {:answer/id #uuid "85921482-60cc-5b3b-bac9-34c591e98316" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\sqrt{5}+2\\sqrt{10}" :db/id #edb/ref 17592186485107} {:answer/id #uuid "89e8d243-f4d9-5efb-b831-ec8cb1c16af1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{5}+4\\sqrt{10}" :db/id #edb/ref 17592186485119} {:answer/id #uuid "d73f86a3-d6be-5522-9996-33d10e15ceab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\sqrt{10}-2\\sqrt{5}" :db/id #edb/ref 17592186485269} {:answer/id #uuid "dfe8f46d-8281-5450-aa1e-1db2a8b09dbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\sqrt{10}" :db/id #edb/ref 17592186485289}] :answer-field/correct {:answer/id #uuid "89e8d243-f4d9-5efb-b831-ec8cb1c16af1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{5}+4\\sqrt{10}" :db/id #edb/ref 17592186485119} :answer-field/id #uuid "11096cdf-2d5a-55cb-ab12-cdce2b0d4e9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485372}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a9e25ac2-f767-5781-99ee-621462efc511" :question/math-academy-id "q-134546" :question/problem "Simplify $\\sqrt{500}+4\\sqrt{10}-2\\sqrt{5}.$" :question/worked-solution "First, we use the product rule for radicals, as follows:\n\n$$\n\\begin{aligned}\\sqrt{500} & =\\sqrt{100\\cdot 5}=\\sqrt{100}\\cdot \\sqrt{5}=10\\sqrt{5} & \\end{aligned}\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}\\sqrt{500}+4\\sqrt{10}-2\\sqrt{5} & = \\\\ 10\\sqrt{5}+4\\sqrt{10}-2\\sqrt{5} & \\end{aligned}\n$$\n\nNow, we can combine the two $\\sqrt{5}$ terms together:\n\n$$\n\\begin{aligned}10\\sqrt{5}+4\\sqrt{10}-2\\sqrt{5} & = \\\\ (10\\sqrt{5}-2\\sqrt{5})+4\\sqrt{10} & = \\\\ (10-2)\\sqrt{5}+4\\sqrt{10} & = \\\\ 8\\sqrt{5}+4\\sqrt{10} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485567 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ba3ed68-f9b0-551a-b735-3b58271dc472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{z}^{6}" :db/id #edb/ref 17592186484838} {:answer/id #uuid "5dd8d384-a7d9-5d9c-b75d-8eccfb8510e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{10}" :db/id #edb/ref 17592186485026} {:answer/id #uuid "69953e64-808d-5a62-a3aa-5724135190c5" :answer/typ