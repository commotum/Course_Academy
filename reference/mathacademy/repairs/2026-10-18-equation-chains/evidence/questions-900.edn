6}^{2}} & = \\\\ \\frac{1}{3}\\cdot 6 & = \\\\ 2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186483392 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "366574e0-8d03-534e-bd96-f68d90bec0be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^2-12" :db/id #edb/ref 17592186482907}] :answer-field/correct {:answer/id #uuid "366574e0-8d03-534e-bd96-f68d90bec0be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^2-12" :db/id #edb/ref 17592186482907} :answer-field/id #uuid "d57c0389-9992-5a66-ad36-469b7c1191d1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186483322}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ab277d55-701f-5a3b-8c81-a817296b0326" :question/math-academy-id "q-237266" :question/problem "Expand the following product.\n\n$(x-2\\sqrt{3})(x+2\\sqrt{3})=$\n{{field-1}}" :question/worked-solution "We will use the difference of squares formula:\n\n$$\n(a+b)(a-b)={a}^{2}-{b}^{2}\n$$\n\nSubstituting $a=x$ and $b=2\\sqrt{3},$ we have\n\n$$\n\\begin{aligned}(x-2\\sqrt{3})(x+2\\sqrt{3}) & = \\\\ {x}^{2}-(2\\sqrt{3})^{2} & = \\\\ {x}^{2}-4\\cdot 3 & = \\\\ {x}^{2}-12. & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186483394 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a9d9b4b-ca94-5d3d-944d-072608c2a0de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186482970} {:answer/id #uuid "765bdb1f-67ac-5dc9-bba2-204cd7872f04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186483017} {:answer/id #uuid "a9ee0db0-eadf-5cac-9bef-5cd84f91d4de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186483100} {:answer/id #