\sqrt[3]{{(\\frac{{x}^{2}}{{p}^{2}})}^{3}} & = \\\\ \\frac{{x}^{2}}{{p}^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485491 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f736fcc-85fb-5c42-a897-a5c64769aece" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{u}^{2}}" :db/id #edb/ref 17592186484849} {:answer/id #uuid "40d1ff6c-f0dd-599b-9ead-da6280659594" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{u}^{3}" :db/id #edb/ref 17592186484959} {:answer/id #uuid "478c94ea-ecb9-5809-b6e0-766a914d613c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u" :db/id #edb/ref 17592186484970} {:answer/id #uuid "77faa779-0ed1-5798-90c4-6b5937932352" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{u}" :db/id #edb/ref 17592186485075} {:answer/id #uuid "fa955127-e822-5873-b42b-da50dcdb291c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{u}^{7}" :db/id #edb/ref 17592186485354}] :answer-field/correct {:answer/id #uuid "40d1ff6c-f0dd-599b-9ead-da6280659594" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{u}^{3}" :db/id #edb/ref 17592186484959} :answer-field/id #uuid "3a1b077b-b152-51c0-a29f-ce4a7d4cee76" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485392}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0c16d02f-29ad-5f66-b01c-bdf6dca8d018" :question/math-academy-id "q-72673" :question/problem "Simplify the  expression\n${u}^{5}\\cdot \\frac{{u}^{2}}{{u}^{4}}.$" :question/worked-solution "First we apply the quotient rule, subtracting exponents in the fraction:\n\n$$\n\\begin{aligned}\\begin{aligned}{u}^{5}\\cdot \\frac{{u}^{2}}{{u}^{4}} & = \\\\ {u}^{5}\\cdot {u}^{2-4} & = \\\\ {u}^{5}\\cdot {u}^{-2} & \\end{aligned}\\end{aligned}\n$$\n\nThen we apply the product rule, adding exponents in the product:\n\n$$\n\\begin{aligned}\\begin{aligned}{u}^{5}\\cdot {u}^{-2} & = \\\\ {u}^{5+(-2)} & = \\\\ {u}^{5-2} & = \\\\ {u}^{3} & \\end{aligned}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{u}^{5}\\cdot \\frac{{u}^{2}}{{u}^{4}}={u}^{3}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485493 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "151cc72e-9a16-5fea-b5af-cfb0164f5ded" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{7}}{7}" :db/id #edb/ref 17592186484858} {:answer/id #uuid "53bc57ef-fd28-5eea-a280-1cc2b4078d55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{7}" :db/id #edb/ref 17592186485001} {:answer/id #uuid "59c29fb2-4f87-5b2d-a98f-846bafb443e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{7}}{7}" :db/id #edb/ref 17592186485019} {:answer/id #uuid "a3bc7f92-5853-5b1b-982b-ca40ed08990a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}}{14}" :db/id #edb/ref 17592186485173} {:answer/id #uuid "e126a8cc-71d1-5b99-a0a2-2f8c634f63c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{14}}{7}" :db/id #edb/ref 17592186485293}] :answer-field/correct {:answer/id #uuid "e126a8cc-71d1-5b99-a0a2-2f8c634f63c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{14}}{7}" :db/id #edb/ref 17592186485293} :answer-field/id #uuid "f9658bd1-b07d-5909-8e50-bb388a4e036f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485474}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0ded43df-0d6f-557a-8481-c4307edc8e48" :question/math-academy-id "q-68977" :question/problem "$\\frac{\\sqrt{2}}{\\sqrt{7}}=$" :question/worked-solution "To remove the radical $\\sqrt{7}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{7}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{2}}{\\sqrt{7}} & = \\\\ \\frac{\\sqrt{2}}{\\sqrt{7}}\\cdot \\frac{\\sqrt{7}}{\\sqrt{7}} & = \\\\ \\frac{\\sqrt{2}\\cdot \\sqrt{7}}{(\\sqrt{7})^{2}} & = \\\\ \\frac{\\sqrt{2}\\cdot \\sqrt{7}}{7} & \\end{aligned}\n$$\n\nNow, we use the product rule to simplify the numerator:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{2}\\cdot \\sqrt{7}}{7} & = \\\\ \\frac{\\sqrt{2\\cdot 7}}{7} & = \\\\ \\frac{\\sqrt{14}}{7} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485494 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2655cd3b-2747-5203-9113-5c1c82e5f477" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186484888} {:answer/id #uuid "3dcd1809-ac2d-5261-ae5d-73e582ca6db3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{2}" :db/id #edb/ref 17592186484951} {:answer/id #uuid "4a5d0cba-b75a-5db6-8ed5-3ab5cbf01c72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{a}" :db/id #edb/ref 17592186484981} {:answer/id #uuid "daa1f54f-f802-5d5b-a24b-5777fb6a7514" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a" :db/id #edb/ref 17592186485277} {:answer/id #uuid "dfd7bb96-cae9-57b2-980a-b903d96581dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{4}" :db/id #edb/ref 17592186485288}] :answer-field/correct {:answer/id #uuid "2655cd3b-2747-5203-9113-5c1c82e5f477" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186484888} :answer-field/id #uuid "2f65387b-3f20-5940-81f4-84e80b5a99c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485386}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0e69e5e6-7016-5a90-88d1-935042e944fb" :question/math-academy-id "q-72677" :question/problem "Simplify ${a}^{5}\\cdot \\frac{{a}^{-3}}{{a}^{2}}.$" :question/worked-solution "First we apply the quotient rule, subtracting exponents in the fraction:\n\n$$\n\\begin{aligned}{a}^{5}\\cdot \\frac{{a}^{-3}}{{a}^{2}} & = \\\\ {a}^{5}\\cdot {a}^{(-3-2)} & = \\\\ {a}^{5}\\cdot {a}^{-5} & \\end{aligned}\n$$\n\nThen we apply the product rule, adding exponents in the product:\n\n$$\n\\begin{aligned}\\begin{aligned}{a}^{5}\\cdot {a}^{-5} & = \\\\ {a}^{5+(-5)} & = \\\\ {a}^{5-5} & = \\\\ {a}^{0} & = \\\\ 1 & \\end{aligned}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{a}^{5}\\cdot \\frac{{a}^{-3}}{{a}^{2}}=1.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485495 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89d0d529-dc53-5ae0-adf4-e66f90a363a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{2}-3\\sqrt{3}" :db/id #edb/ref 17592186485118} {:answer/id #uuid "b24309b9-90da-522b-82c2-9ae592e33512" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16-3\\sqrt{3}" :db/id #edb/ref 17592186485204} {:answer/id #uuid "eac5bd26-581e-5a30-9d48-9b5f3066d6c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{2}-3\\sqrt{3}" :db/id #edb/ref 17592186485316} {:answer/id #uuid "f1c503e0-51c7-5099-b50a-cb3c4bfb3507" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 1759