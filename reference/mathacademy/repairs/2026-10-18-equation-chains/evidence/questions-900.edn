{:answer/id #uuid "5a8175c1-02fa-50e9-a6cd-d3cc478b8b05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+5x" :db/id #edb/ref 17592186488642} {:answer/id #uuid "a82c0323-a9df-5774-94f2-0aaef3aa4133" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+3x" :db/id #edb/ref 17592186488804}] :answer-field/correct {:answer/id #uuid "5a8175c1-02fa-50e9-a6cd-d3cc478b8b05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+5x" :db/id #edb/ref 17592186488642} :answer-field/id #uuid "56cc9ec7-a78c-54b1-a942-1c31a8e69346" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186489063}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fadc73be-dedf-5384-82b7-e3c8b9123466" :question/math-academy-id "q-173697" :question/problem "$12-3x+(4x-5)\\cdot 2=$" :question/worked-solution "First, we distribute the $2$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}12-3x+(4x-5)\\cdot 2 & = \\\\ 12-3x+4x\\cdot 2+(-5)\\cdot 2 & = \\\\ 12-3x+(8x)+(-10) & = \\\\ 12-3x+8x-10\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}12-3x+8x-10 & = \\\\ (12-10)+(-3x+8x) & = \\\\ (2)+(5x) & = \\\\ 2+5x\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186490224 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "545f6b34-8b08-5486-9f0e-2cc84dac10e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186489714} {:answer/id #uuid "5923c943-f43e-5441-819c-fc4c38287552" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186489731} {:answer/id #uuid "7575186d-b230-5c3f-951f-24397f6e911d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186489787} {:answer/id #uuid "b71f29a1-8d1a-5479-ac04-69c1694fac07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186489917} {:answer/id #uuid "c44f6e25-54af-5112-a2ff-488411a644f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186489938}] :answer-field/correct {:answer/id #uuid "b71f29a1-8d1a-5479-ac04-69c1694fac07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186489917} :answer-field/id #uuid "7a5fd354-5df8-5dcc-bf17-82ac638ded50" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490142}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "27f65119-9cfd-5858-830b-dc487011110a" :question/math-academy-id "q-69345" :question/problem "Calculate $\\frac{5}{8}\\times 3-(8-10)^{-3}.$" :question/worked-solution "To evaluate the given expression, we use PEMDAS.\n\nFirst, we compute the expression inside the parentheses:\n\n$$\n\\frac{5}{8}\\times 3-(8-10)^{-3}=\\frac{5}{8}\\times 3-(-2)^{-3}\n$$\n\nNext, notice that $(-2)^{-3}=\\frac{1}{(-2)^{3}}=-\\frac{1}{8}.$ So, we obtain:\n\n$$\n\\begin{aligned}\\frac{5}{8}\\times 3-(-2)^{-3} & = \\\\ \\frac{5}{8}\\times 3-(-\\frac{1}{8}) & = \\\\ \\frac{5}{8}\\times \\frac{3}{1}+\\frac{1}{8} & = \\\\ \\frac{5\\times 3}{8\\times 1}+\\frac{1}{8} & = \\\\ \\frac{15}{8}+\\frac{1}{8} & = \\\\ \\frac{15+1}{8} & = \\\\ \\frac{16}{8} & = \\\\ 2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186490227 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68f6dbdb-d583-5244-98af-d51948d327ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{a}^{2}-4a{b}^{2}+{b}^{4}" :db/id #edb/ref 17592186489767} {:answer/id #uuid "823a99ee-ed71-595d-979e-7d9efe2268fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{a}^{2}+{b}^{4}" :db/id #edb/ref 17592186489812} {:answer/id #uuid "8ebe3a75-ff92-5c14-947a-6c9b06c84f8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{a}^{2}-{b}^{4}" :db/id #edb/ref 17592186489837} {:answer/id #uuid "d24981a6-c6ea-5260-94b3-3a43009f92cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{a}^{2}-2a{b}^{2}-{b}^{4}" :db/id #edb/ref 17592186489979} {:answer/id #uuid "f2c12960-665c-559d-b833-9b56dd740b5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{a}^{2}+4a{b}^{2}+{b}^{4}" :db/id #edb/ref 17592186490036}] :answer-field/correct {:answer/id #uuid "68f6dbdb-d583-5244-98af-d51948d327ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{a}^{2}-4a{b}^{2}+{b}^{4}" :db/id #edb/ref 17592186489767} :answer-field/id #uuid "ec200471-10b2-5681-96c2-657a58983bc0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490200}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2be683e9-4308-5a65-9d13-a50367058c8f" :question/math-academy-id "q-33114" :question/problem "${(2a-{b}^{2})}^{2}=$" :question/worked-solution "We will use the following formula:\n\n$$\n(x-y)^{2}={x}^{2}-2xy+{y}^{2}\n$$\n\nSubstituting $x=2a$ and $y={b}^{2},$ we have\n\n$$\n\\begin{aligned}{(2a-{b}^{2})}^{2} & = \\\\ (2a)^{2}-2(2a)({b}^{2})+{({b}^{2})}^{2} & = \\\\ 4{a}^{2}-4a{b}^{2}+{b}^{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186490236 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90c61a4c-acb5-5943-83c3-2a9169499652" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{125}" :db/id #edb/ref 17592186489842}] :answer-field/correct {:answer/id #uuid "90c61a4c-acb5-5943-83c3-2a9169499652" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{125}" :db/id #edb/ref 17592186489842} :answer-field/id #uuid "3292a063-82f7-566f-97f5-25f4fc63cbef" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186490100}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "355c3927-42d5-52b6-8af5-1388530c1ab2" :question/math-academy-id "q-171378" :question/problem "$(-1+7.35)^{0}\\times {5}^{-3}=${{field-1}}" :question/worked-solution "To evaluate the given expression, we use PEMDAS.\n\nFirst, we compute the expression inside the parentheses:\n\n$$\n(-1+7.35)^{0}\\times {5}^{-3}=(6.35)^{0}\\times {5}^{-3}\n$$\n\nNext, notice that $(6.35)^{0}=1.$ So, we obtain:\n\n$$\n\\begin{aligned}(6.35)^{0}\\times {5}^{-3} & = \\\\ 1\\times {5}^{-3} & = \\\\ {5}^{-3}\\end{aligned}\n$$\n\nFinally, \n\n$$\n{5}^{-3}=\\frac{1}{{5}^{3}}=\\frac{1}{125}.\n$$"}] [{:db/id #edb/ref 17592186490256 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a76c1ed-9c9a-5884-8b85-3040e0c60944" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{10}" :db/id #edb/ref 17592186489795}] :answer-field/correct {:answer/id #uuid "7a76c1ed-9c9a-5884-8b85-3040e0c60944" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{10}" :db/id #edb/ref 17592186489795} :answer-field/id #uuid "370651de-97e9-5350-9a2a-8b5e0ff4246c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186490104}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5fe451b2-edf1-59c7-ba6b-aec83b3dbee5" :question/math-academy-id "q-175956" :question/problem "${2}^{-3}\\times (\\frac{8}{5}+4)=${{field-1}}" :question/worked-solution "To evaluate the given expression, we use PEMDAS.\n\nNotice that ${2}^{-3}=\\frac{1}{{2}^{3}}.$ So, we obtain:\n\n$$\n\\begin{aligned}{2}^{-3}\\times (\\frac{8}{5}+4) & = \\\\ \\frac{1}{{2}^{3}}\\times (\\frac{8}{5}+4) & = \\\\ \\frac{1}{8}\\times (\\frac{8}{5}+4) & = \\\\ \\frac{1}{8}\\times \\frac{8+20}{5} & = \\\\ \\frac{1}{8}\\times \\frac{28}{5} & = \\\\ \\frac{1\\times 28}{8\\times 5} & = \\\\ \\frac{1\\times 4\\times 7}{2\\times 4\\times 5} & = \\\\ \\frac{1\\times \\cancel{4}\\times 7}{2\\times \\cancel{4}\\times 5} & = \\\\ \\frac{7}{10}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186490277 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1383eea4-8385-5b80-a00d-bc4a381cec34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}+6x" :db/id #edb/ref 17592186489557} {:answer/id #uuid "469c4db6-332e-52b7-9453-76a3e2e8733c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}y+6xy" :db/id #edb/ref 17592186489677} {:answer/id #uuid "80fd8b82-26bf-59a6-af6c-1efba9feb3e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}y+3x" :db/id #edb/ref 17592186489808} {:answer/id #uuid "f38cbb7a-75fa-5860-832a-bf4ea3489c86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}y+6x" :db/id #edb/ref 17592186490039} {:answer/id #uuid "f4ba294a-378d-5da9-9fd9-e632d9345e57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}y+2" :db/id #edb/ref 17592186490043}] :answer-field/correct {:answer/id #uuid "f38cbb7a-75fa-5860-832a-bf4ea3489c86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}y+6x" :db/id #edb/ref 17592186490039} :answer-field/id #uuid "7d5fa659-d7d1-55a1-83c5-184b6ed1af7f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490145}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9cfc88f5-5c61-5b90-beb5-64a3476a024f" :question/math-academy-id "q-44727" :question/problem "$3x({x}^{2}y+2)=$" :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}3x({x}^{2}y+2) & = \\\\ 3x({x}^{2}y)+3x(2) & = \\\\ 3\\cdot {x}^{2+1}y+6x & = \\\\ 3{x}^{3}y+6x\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186490282 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f663968-9914-51d2-a0d5-0de18327bcb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-5{x}^{4}" :db/id #edb/ref 17592186489659} {:answer/id #uuid "aa8be593-a930-5092-b401-4276e53f4bb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-\\frac{5{x}^{4}}{2}" :db/id #edb/ref 17592186489890} {:answer/id #uuid "aab4c61d-684a-5773-b4d6-164888798bb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x}{2}-5{x}^{4}" :db/id #edb/ref 17592186489891} {:answer/id #uuid "c9c56fc1-b117-576b-81a6-2f4abdab9754" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3x}{2}-\\frac{5{x}^{4}}{2}" :db/id #edb/ref 17592186489955} {:answer/id #uuid "f6bfd523-eab9-5a44-b230-8dd48c8d9b55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x+5{x}^{4}" :db/id #edb/ref 17592186490049}] :answer-field/correct {:answer/id #uuid "3f663968-9914-51d2-a0d5-0de18327bcb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-5{x}^{4}" :db/id #edb/ref 17592186489659} :answer-field/id #uuid "cc8bf450-8384-5183-8fd7-ee109eb1c278" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490181}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a0223a5d-a1d6-5c40-af63-e8dfd73551f8" :question/math-academy-id "q-111117" :question/problem "$\\frac{x}{2}(6-10{x}^{3})=$" :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}\\frac{x}{2}(6-10{x}^{3}) & = \\\\ (\\frac{x}{2})(6)+(\\frac{x}{2})(-10{x}^{3}) & = \\\\ (\\frac{1}{2}x)(6)+(\\frac{1}{2}x)(-10{x}^{3}) & = \\\\ (\\frac{1}{2}\\cdot 6)x+(\\frac{1}{2}\\cdot (-10))(x\\cdot {x}^{3}) & = \\\\ (3)x+(-5)({x}^{1+3}) & = \\\\ 3x-5{x}^{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186490286 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d65759d-e36d-5045-acc5-db2984da989f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}+{x}^{2}" :db/id #edb/ref 17592186489544} {:answer/id #uuid "174ed3f2-66bc-5124-aa00-570861734082" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}+\\frac{1}{3}{x}^{2}+{x}^{2}" :db/id #edb/ref 17592186489567} {:answer/id #uuid "84c7c962-da54-5750-9444-176e8e186f3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}+\\frac{2}{3}{x}^{2}+{x}^{4}" :db/id #edb/ref 17592186489819} {:answer/id #uuid "ea56582c-7d40-5467-bb1c-047ef74db56a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}+{x}^{4}" :db/id #edb/ref 17592186490023} {:answer/id #uuid "f2c7773c-a23f-5f60-a9f6-ea4c2e71ce2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}+\\frac{2}{3}{x}^{2}+{x}^{2}" :db/id #edb/ref 17592186490037}] :answer-field/correct {:answer/id #uuid "84c7c962-da54-5750-9444-176e8e186f3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}+\\frac{2}{3}{x}^{2}+{x}^{4}" :db/id #edb/ref 17592186489819} :answer-field/id #uuid "1248bc9c-da8e-5444-ae7b-ffd4127ab86f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490084}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a62d676a-9c38-5dd1-a066-72e04e4e8a97" :question/math-academy-id "q-33095" :question/problem "${(\\frac{1}{3}+{x}^{2})}^{2}=$" :question/worked-solution "We will use the following formula:\n\n$$\n(a+b)^{2}={a}^{2}+2ab+{b}^{2}\n$$\n\nSubstituting $a=\\frac{1}{3}$ and $b={x}^{2},$ we have\n\n$$\n\\begin{aligned}{(\\frac{1}{3}+{x}^{2})}^{2} & = \\\\ {(\\frac{1}{3})}^{2}+2(\\frac{1}{3})({x}^{2})+{({x}^{2})}^{2} & = \\\\ \\frac{1}{9}+\\frac{2}{3}{x}^{2}+{x}^{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186490289 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10618d86-2776-5cce-97a6-7ca9e920abd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{2}-3{a}^{4}+{a}^{5}" :db/id #edb/ref 17592186489553} {:answer/id #uuid "47ed6dd6-b0d1-5887-8326-53ee4a3b117a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{a}^{6}+2{a}^{4}+5{a}^{2}" :db/id #edb/ref 17592186489681} {:answer/id #uuid "4cfe73b4-b0e8-50ac-850e-f133bc075de3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{a}^{6}+3{a}^{3}+6a" :db/id #edb/ref 17592186489696} {:answer/id #uuid "4ff82ea5-a53e-581b-bf6e-70bfe7b8756b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{a}^{5}+3{a}^{2}+6{a}^{2}" :db/id #edb/ref 17592186489706} {:answer/id #uuid "f80efb83-27d0-51e9-bdfb-27593f4de169" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{a}^{6}+3{a}^{4}+6{a}^{2}" :db/id #edb/ref 17592186490054}] :answer-field/correct {:answer/id #uuid "f80efb83-27d0-51e9-bdfb-27593f4de169" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{a}^{6}+3{a}^{4}+6{a}^{2}" :db/id #edb/ref 17592186490054} :answer-field/id #uuid "f72b4150-b00a-5010-ad64-3981725c8bb1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490204}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aad55e06-4983-5ff1-b72a-41466f8cbb81" :question/math-academy-id "q-110835" :question/problem "$-{a}^{2}(2{a}^{4}-3{a}^{2}-6)=$" :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}-{a}^{2}(2{a}^{4}-3{a}^{2}-6) & = \\\\ (-{a}^{2})(2{a}^{4})+(-{a}^{2})(-3{a}^{2})+(-{a}^{2})(-6) & = \\\\ ((-1)\\cdot 2)({a}^{2}\\cdot {a}^{4})+((-1)\\cdot (-3))({a}^{2}\\cdot {a}^{2})+((-1)\\cdot (-6))({a}^{2}) & = \\\\ (-2){a}^{2+4}+(3){a}^{2+2}+(6){a}^{2} & = \\\\ -2{a}^{6}+3{a}^{4}+6{a}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186490303 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d91b24d-4cf0-5621-b56a-13fa12f96cc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9+6{w}^{3}+2{w}^{6}" :db/id #edb/ref 17592186489615} {:answer/id #uuid "30e198a1-9cd9-532e-b734-b7de40702f8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9+12{w}^{3}+2{w}^{6}" :db/id #edb/ref 17592186489623} {:answer/id #uuid "46ec2942-f6fe-5960-a870-5c13e581e7b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9+12{w}^{3}+4{w}^{6}" :db/id #edb/ref 17592186489678} {:answer/id #uuid "6598702c-b178-5390-8d47-dc145c750494" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9+12{w}^{3}+2{w}^{5}" :db/id #edb/ref 17592186489753} {:answer/id #uuid "b72d3e86-d7b2-5212-a462-13f5e6b36f94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9+4{w}^{6}" :db/id #edb/ref 17592186489918}] :answer-field/correct {:answer/id #uuid "46ec2942-f6fe-5960-a870-5c13e581e7b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9+12{w}^{3}+4{w}^{6}" :db/id #edb/ref 17592186489678} :answer-field/id #uuid "c012204b-f827-5e31-922c-3c631ad51cc6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490178}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c9bc34bd-c944-573e-9a8a-bd4bb9a0f491" :question/math-academy-id "q-31551" :question/problem "${(3+2{w}^{3})}^{2}=$" :question/worked-solution "We will use the following formula:\n\n$$\n(a+b)^{2}={a}^{2}+2ab+{b}^{2}\n$$\n\nSubstituting $a=3$ and $b=2{w}^{3},$ we have\n\n$$\n\\begin{aligned}(3+2{w}^{3})^{2} & = \\\\ {3}^{2}+2(3)(2{w}^{3})+(2{w}^{3})^{2} & = \\\\ 9+12{w}^{3}+4{w}^{6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186491117 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "219210f0-ae9d-5c25-bfa0-285a2895557a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186490573}] :answer-field/correct {:answer/id #uuid "219210f0-ae9d-5c25-bfa0-285a2895557a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186490573} :answer-field/id #uuid "df6c9788-4bdb-5360-8148-5d2109336609" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186491092}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "11f803ec-fc39-5be9-aa77-adbf9149db85" :question/math-academy-id "q-185358" :question/problem "Expressed in its simplest form, $\\frac{\\,(-\\frac{5}{4})\\,}{(-\\frac{1}{8})}=${{field-1}}." :question/worked-solution "First, remember that a fraction represents a division.  So, a fraction of fractions is a division of two fractions:\n\n$$\n\\frac{\\,(-\\frac{5}{4})\\,}{(-\\frac{1}{8})}=(-\\frac{5}{4})÷(-\\frac{1}{8})\n$$\n\nNow, recall that dividing by $-\\frac{1}{8}$ is the same as multiplying by its reciprocal $-\\frac{8}{1}.$ We can use this fact to simplify the fraction above:\n\n$$\n\\begin{aligned}\\begin{aligned}(-\\frac{5}{4})÷(-\\frac{1}{8}) & = \\\\ (-\\frac{5}{4})\\times (-\\frac{8}{1}) & = \\\\ \\frac{5\\times 8}{4\\times 1} & = \\\\ \\frac{40}{4} & = \\\\ 10\\end{aligned}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{\\,(-\\frac{5}{4})\\,}{(-\\frac{1}{8})}=10.\n$$"}] [{:db/id #edb/ref 17592186491149 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "abfc1b8e-9de5-5538-aee2-de9cac0e9509" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186490853}] :answer-field/correct {:answer/id #uuid "abfc1b8e-9de5-5538-aee2-de9cac0e9509" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186490853} :answer-field/id #uuid "ae77bf12-3e74-5cbf-b87a-cc3a8d30f6a1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186491071}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5b99e56c-ad94-54d0-842e-fa2fe1eccf19" :question/math-academy-id "q-179537" :question/problem "If $v=8,$ then $2-\\frac{v}{5}=${{field-1}}." :question/worked-solution "Replacing $v$ with $8$ in the expression, we get\n\n$$\n\\begin{aligned}2-\\frac{v}{5} & = \\\\ 2-\\frac{8}{5} & = \\\\ \\frac{2\\cdot 5-8}{5} & = \\\\ \\frac{2}{5} & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186491160 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1e91889-c904-5f8c-9474-ea776f1c6a0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-1" :db/id #edb/ref 17592186490867}] :answer-field/correct {:answer/id #uuid "b1e91889-c904-5f8c-9474-ea776f1c6a0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-1" :db/id #edb/ref 17592186490867} :answer-field/id #uuid "c332bba8-52a5-58c3-9d60-949adcb70443" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186491080}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6ef18d76-1c69-5646-b6be-0fad6315bf41" :question/math-academy-id "q-133831" :question/problem "![](images/87/87d9088567f74124a4af55333306d81d27cf41798a5411445b68ae0c8bc57550.png)\n\nA utility pole is located on the edge of Jacob's land, as shown above. The distance from the right edge of Jacob's plot to the pole is $x+1$ meters. Find the distance to the pole from the left edge as a function of $x.$\n\nThe required distance is \n{{field-1}}\nmeters." :question/worked-solution "In part 1, we found that the length of Jacob's plot is $2x$ meters.\n\nTo find the required distance, we need to subtract polynomials $2x$ and $x+1:$\n\nWe put a minus sign between the two polynomials, distribute it over the second polynomial, collect like terms, and then simplify:\n\n$$\n\\begin{aligned}(2x)-(x+1) & = \\\\ 2x-x-1 & = \\\\ (2-1)x-1 & = \\\\ x-1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186491165 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44edaed4-d77d-5497-9983-08058b8e2c2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "154" :db/id #edb/ref 17592186490641}] :answer-field/correct {:answer/id #uuid "44edaed4-d77d-5497-9983-08058b8e2c2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "154" :db/id #edb/ref 17592186490641} :answer-field/id #uuid "8e136489-d10a-5940-aea3-8d29829ada22" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186491056}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "794c979f-c161-5b28-8239-699e664adb18" :question/math-academy-id "q-133834" :question/problem "If $x=12\\,\\text{m},$ what is the area of Tom's land plot?\n\nArea $\\,=$\n{{field-1}}\n${\\text{m}}^{2}$" :question/worked-solution "To find the area, we have to evaluate the polynomial ${x}^{2}+x-2$ at $x=12.$\n\nSo, we substitute $x=12$ into the polynomial and simplify: \n\n$$\n\\begin{aligned}{x}^{2}+x-2 & = \\\\ (12)^{2}+(12)-2 & = \\\\ 144+12-2 & = \\\\ 154\\end{aligned}\n$$\n\nTherefore, the area is $154\\,{\\text{m}}^{2}.$"}] [{:db/id #edb/ref 17592186491166 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3a3f7b6-e8b6-5e89-888c-8054c2bbbae3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186490846}] :answer-field/correct {:answer/id #uuid "a3a3f7b6-e8b6-5e89-888c-8054c2bbbae3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186490846} :answer-field/id #uuid "73f6cac1-03ce-521d-a9ba-b9024d58d2b5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186491047}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "79ba2bde-8132-53b1-8d2a-2c8fb0089fe0" :question/math-academy-id "q-180248" :question/problem "If $h=5,$ then $3(h-8)+11=${{field-1}}." :question/worked-solution "We replace $h$ with $5$ in the expression and evaluate the parentheses first:\n\n$$\n\\begin{aligned}3(h-8)+11 & = \\\\ 3(5-8)+11 & = \\\\ 3(-3)+11 & = \\\\ -9+11 & = \\\\ 2 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186491184 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d1ea965-b653-537d-891c-225d500492d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\frac{2}{3}" :db/id #edb/ref 17592186490532} {:answer/id #uuid "2b8cac6b-3adc-5b5a-be21-3757ca7d66de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186490596} {:answer/id #uuid "32ba64b6-8f8c-5b2c-9521-0cad7a6d4ce9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186490608} {:answer/id #uuid "7f25c3b5-76c3-5920-bdf2-e88ae7188124" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186490764} {:answer/id #uuid "f21e0a43-a88c-5092-b67f-7a7fbd7a577f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5\\frac{2}{3}" :db/id #edb/ref 17592186490973}] :answer-field/correct {:answer/id #uuid "7f25c3b5-76c3-5920-bdf2-e88ae7188124" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186490764} :answer-field/id #uuid "abea8f89-7891-58cb-8e3f-b822bc185677" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491070}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a0005d92-ca31-5bc9-800e-ea467608e665" :question/math-academy-id "q-99765" :question/problem "$\\frac{\\,\\,(-4)\\,\\,}{(\\frac{1}{5})}=$" :question/worked-solution "First, remember that a fraction represents a division:\n\n$$\n\\frac{\\,\\,(-4)\\,\\,}{(\\frac{1}{5})}=(-4)÷\\frac{1}{5}\n$$\n\nNow, recall that $-4=-\\frac{4}{1}$ and dividing by $\\frac{1}{5}$ is the same as multiplying by its reciprocal $\\frac{5}{1}.$ We can use these facts to simplify the fraction above:  \n\n$$\n\\begin{aligned}(-4)÷\\frac{1}{5} & = \\\\ (-\\frac{4}{1})\\times \\frac{5}{1} & = \\\\ -\\frac{4\\times 5}{1\\times 1} & = \\\\ -\\frac{20}{1} & = \\\\ -20 & \\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{\\,\\,(-4)\\,\\,}{(\\frac{1}{5})}=-20.\n$$"}] [{:db/id #edb/ref 17592186491186 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec61a87e-9a96-56fd-b489-b4024081d4b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2" :db/id #edb/ref 17592186490961}] :answer-field/correct {:answer/id #uuid "ec61a87e-9a96-56fd-b489-b4024081d4b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2" :db/id #edb/ref 17592186490961} :answer-field/id #uuid "f6fb5d65-68b8-5e66-b581-58fb181cc889" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186491104}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a9f4b7be-1158-5a94-a23c-150a70b64b99" :question/math-academy-id "q-133832" :question/problem "![](images/be/bef0863eeb7006d89cc92a80be2a84e6ea09bca14cbb29c15af4f2e01e79045f.png)\n\nJacob's neighbor to the south, Tom, has a land plot of area ${x}^{2}+x-2$ square meters, as shown in the picture. Given that the length of Tom's plot of land is $x-1$ meters, what is the width of the plot in terms of $x?$\n\nTom's plot width is\n{{field-1}}\nmeters." :question/worked-solution "To find the required width, we need to factor the expression ${x}^{2}+x-2.$\n\nFirst, we find the factor pairs of the constant term $(-2).$ The constant term is negative, so that means one of the factors is negative, and the other is positive:\n\n$$\n\\begin{aligned}1 & \\times (-2) \\\\ (-1) & \\times 2\\end{aligned}\n$$\n\nNow, we find which factor pair adds up to the coefficient of the linear term $1:$\n\n$$\n\\begin{aligned}1+(-2) & =-1 & \\times  \\\\ -1+2 & =1 & ✓\\end{aligned}\n$$\n\nUsing the factor pair identified above, write the linear term as $x=2x-x:$\n\n$$\n\\begin{aligned}{x}^{2}+x-2 & ={x}^{2}+2x-x-2\\end{aligned}\n$$\n\nFinally, we factor the first two terms and the last two terms separately, and then factor the expression completely:\n\n$$\n\\begin{aligned}{x}^{2}+2x-x-2 & = \\\\ ({x}^{2}+2x)+(-x-2) & = \\\\ x(x+2)-(x+2) & = \\\\ (x-1)(x+2)\\end{aligned}\n$$\n\nAs a result, we conclude that the width must be $x+2$ meters. \n\n![](images/d2/d2b543dc559c23c191231543701ffb05a7c8350bc066a047b836fe64766c7289.png)"}] [{:db/id #edb/ref 17592186491189 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32bca134-6367-5be4-9fd2-5d82101d533a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186490609} {:answer/id #uuid "61eb38f1-6922-58af-8b15-1c45bf4f22a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{7}" :db/id #edb/ref 17592186490694} {:answer/id #uuid "834381da-ec1c-5b75-9720-f4882787a1ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186490776} {:answer/id #uuid "9856080b-5615-58ba-9305-8f394edcbc9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186490824} {:answer/id #uuid "d3c6ed7d-9644-5e4e-a9ee-748599da8dad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186490908}] :answer-field/correct {:answer/id #uuid "9856080b-5615-58ba-9305-8f394edcbc9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186490824} :answer-field/id #uuid "e8815dfd-179a-5c5e-bb6e-8c58a712bc57" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491096}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b0a96863-abdb-5fbd-be57-181eec5befbe" :question/math-academy-id "q-99769" :question/problem "$\\frac{(\\frac{7}{4})}{7}=$" :question/worked-solution "We can use either of the following two methods.\n\n**Method 1 - The Long Way**\n\nFirst, remember that a fraction represents a division:\n\n$$\n\\frac{(\\frac{7}{4})}{7}=\\frac{7}{4}÷7\n$$\n\nNow, recall that dividing by $7$ is the same as multiplying by its reciprocal $\\frac{1}{7}.$ We can use this fact to simplify the fraction above:\n\n$$\n\\begin{aligned}\\frac{7}{4}÷7 & = \\\\ \\frac{7}{4}\\times \\frac{1}{7} & = \\\\ \\frac{7\\times 1}{4\\times 7} & = \\\\ \\frac{7}{28}\\end{aligned}\n$$\n\n \n\nFinally, we simplify:\n\n$$\n\\frac{7}{28}=\\frac{7÷7}{28÷7}=\\frac{1}{4}\n$$\n\nTherefore, \n\n$$\n\\frac{(\\frac{7}{4})}{7}=\\frac{1}{4}.\n$$\n\n**Method 2 - The Quick Way**\n\nThe result will have the same numerator as the top fraction, and the denominator is just the product of the two denominators:\n\n$$\n\\begin{aligned}\\frac{(\\frac{7}{4})}{7} & = \\\\ \\frac{7}{4\\times 7} & = \\\\ \\frac{7}{28} & = \\\\ \\frac{7÷7}{28÷7} & = \\\\ \\frac{1}{4} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186491190 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b98cca8-6f0e-5482-9fa8-f7aeb424a305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{6}" :db/id #edb/ref 17592186490562} {:answer/id #uuid "69c8c086-db77-5758-967f-00696124f83f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{4}" :db/id #edb/ref 17592186490709} {:answer/id #uuid "7b71d305-a5a2-5d89-92a2-1dc57deb1bf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{7}" :db/id #edb/ref 17592186490757} {:answer/id #uuid "a89968b9-3ad0-5516-ace6-ad93f1456e61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186490849} {:answer/id #uuid "aab949d1-ff11-5cbe-a57e-c6e2603a0932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{21}" :db/id #edb/ref 17592186490851}] :answer-field/correct {:answer/id #uuid "7b71d305-a5a2-5d89-92a2-1dc57deb1bf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{7}" :db/id #edb/ref 17592186490757} :answer-field/id #uuid "f3466160-186f-5215-84d6-837a7ed4ec4b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491102}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b2af5d91-5331-52df-9dc3-29a55153bfaf" :question/math-academy-id "q-43486" :question/problem "$\\frac{(\\frac{3}{7})}{(\\frac{1}{4})}=$" :question/worked-solution "First, remember that a fraction represents a division.  So, a fraction of fractions is a division of two fractions:\n\n$$\n\\begin{aligned}\\frac{(\\frac{3}{7})}{(\\frac{1}{4})}=\\frac{3}{7}÷\\frac{1}{4}\\end{aligned}\n$$\n\nNow, recall that dividing by $\\frac{1}{4}$ is the same as multiplying by its reciprocal $\\frac{4}{1}.$ We can use this fact to simplify the fraction above:\n\n$$\n\\begin{aligned}\\frac{3}{7}÷\\frac{1}{4} & = \\\\ \\frac{3}{7}\\times \\frac{4}{1} & = \\\\ \\frac{3\\times 4}{7\\times 1} & = \\\\ \\frac{12}{7}\\end{aligned}\n$$\n\n  \n\nTherefore,\n\n$$\n\\frac{(\\frac{3}{7})}{(\\frac{1}{4})}=\\frac{12}{7}.\n$$"}] [{:db/id #edb/ref 17592186491191 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ecfe9ff-1de0-5d94-8b8b-66524693914d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186490839}] :answer-field/correct {:answer/id #uuid "9ecfe9ff-1de0-5d94-8b8b-66524693914d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186490839} :answer-field/id #uuid "10e8c887-cc39-5c97-a10d-b38457e1a9d6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186491009}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b304ff54-539e-5d0d-a04c-2339ab8e6486" :question/math-academy-id "q-133829" :question/problem "Expressed as a polynomial in terms of $x,$ the length of Jacob's plot of land is{{field-1}}\nmeters." :question/worked-solution "The width of the plot is $x+1$ meters, and its area is $2{x}^{2}+2x$ square meters. Since the $\\text{area}=\\text{length}\\times \\text{width},$ we factor the expression for the area to find the length.\n\nFirst, we find the $\\text{GCF}$ of the two terms:\n\n$$\n\\text{GCF}(2{x}^{2},2x)=2x\n$$\n\nThen, we rewrite each term in the original expression as a product with the $\\text{GCF}:$\n\n$$\n\\begin{aligned}2{x}^{2}+2x & = \\\\ (2x\\cdot x)+(2x\\cdot 1)\\end{aligned}\n$$\n\nNext, we write the $\\text{GCF}$ outside the parentheses and keep the remaining terms inside:\n\n$$\n\\begin{aligned}(2x\\cdot x)+(2x\\cdot 1) & = \\\\ 2x(x+1)\\end{aligned}\n$$\n\nAs a result, we conclude that the length of the plot must be $2x$ meters.\n\n![](images/4c/4c27076821a19720b9038ab64552c85befa0c544e5295f1677b493ab36e6c9c9.png)"}] [{:db/id #edb/ref 17592186491206 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "101bedaa-1d23-5c71-acab-0e6d2fa138fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{7}" :db/id #edb/ref 17592186490542} {:answer/id #uuid "10694063-5723-5959-b976-e8be9c93ac53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186490544} {:answer/id #uuid "2a46a3d3-5441-51d1-a705-2184fded9e3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{9}" :db/id #edb/ref 17592186490592} {:answer/id #uuid "2d5c6dcb-c785-52d6-847d-e13376bf3e3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{6}" :db/id #edb/ref 17592186490599} {:answer/id #uuid "f4264b47-3558-59ba-bc2d-0756e456b5b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{36}" :db/id #edb/ref 17592186490978}] :answer-field/correct {:answer/id #uuid "f4264b47-3558-59ba-bc2d-0756e456b5b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{36}" :db/id #edb/ref 17592186490978} :answer-field/id #uuid "41a56275-c6fa-56a6-b15e-4abe5e29fee8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491029}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e483ad67-316a-51cc-8531-219d3a80b4f4" :question/math-academy-id "q-99773" :question/problem "$\\frac{(-\\frac{7}{4})}{(-9)}=$" :question/worked-solution "We can use either of the following two methods.\n\n**Method 1 - The Long Way**\n\nFirst, remember that a fraction represents a division:\n\n$$\n\\frac{(-\\frac{7}{4})}{(-9)}=(-\\frac{7}{4})÷(-9)\n$$\n\nNow, recall that dividing by $-9$ is the same as multiplying by its reciprocal $-\\frac{1}{9}.$ We can use this fact to simplify the fraction above: \n\n$$\n\\begin{aligned}(-\\frac{7}{4})÷(-9) & = \\\\ (-\\frac{7}{4})\\times (-\\frac{1}{9}) & = \\\\ \\frac{7\\times 1}{4\\times 9} & = \\\\ \\frac{7}{36}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{(-\\frac{7}{4})}{(-9)}=\\frac{7}{36}.\n$$\n\n**Method 2 - The Quick Way**\nThe result will have the same numerator as the top fraction, and the denominator is just the product of the two denominators:\n\n$$\n\\begin{aligned}\\frac{(-\\frac{7}{4})}{(-9)} & = \\\\ \\frac{-7}{4\\times (-9)} & = \\\\ \\frac{-7}{-36} & = \\\\ \\frac{7}{36} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186491217 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1750e457-61df-5f93-b615-35b2f02cf305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{4}" :db/id #edb/ref 17592186490557} {:answer/id #uuid "5b321ef0-fa18-53af-9de3-8bac3c88ce32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{24}" :db/id #edb/ref 17592186490682} {:answer/id #uuid "91f1e84e-b335-5652-bf66-1bfe42b9aa1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{7}" :db/id #edb/ref 17592186490806} {:answer/id #uuid "9922953e-e34d-59ba-a9f1-d4d61a61aa52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{24}" :db/id #edb/ref 17592186490826} {:answer/id #uuid "b09b4a98-9578-5f56-ac72-344906f876cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{12}" :db/id #edb/ref 17592186490863}] :answer-field/correct {:answer/id #uuid "b09b4a98-9578-5f56-ac72-344906f876cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{12}" :db/id #edb/ref 17592186490863} :answer-field/id #uuid "2f53ff46-6bcb-5804-9c51-551d655fc687" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491025}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f784b6ba-5095-5d61-b18c-c45f932db76c" :question/math-academy-id "q-43489" :question/problem "$\\frac{(-\\frac{14}{3})}{(-8)}=$" :question/worked-solution "We can use either of the following two methods.\n\n**Method 1 - The Long Way**\n\nFirst, remember that a fraction represents a division:\n\n$$\n\\frac{(-\\frac{14}{3})}{(-8)}=(-\\frac{14}{3})÷(-8)\n$$\n\nNow, recall that dividing by $-8$ is the same as multiplying by its reciprocal $-\\frac{1}{8}.$ We can use this fact to simplify the fraction above:\n\n$$\n\\begin{aligned}(-\\frac{14}{3})÷(-8) & = \\\\ (-\\frac{14}{3})\\times (-\\frac{1}{8}) & = \\\\ \\frac{14\\times 1}{3\\times 8} & = \\\\ \\frac{14}{24}\\end{aligned}\n$$\n\nFinally, we simplify:\n\n$$\n\\frac{14}{24}=\\frac{14÷2}{24÷2}=\\frac{7}{12}\n$$\n\nTherefore, \n\n$$\n\\frac{(-\\frac{14}{3})}{(-8)}=\\frac{7}{12}.\n$$\n\n**Method 2 - The Quick Way**\n\nThe result will have the same numerator as the top fraction, and the denominator is just the product of the two denominators:\n\n$$\n\\begin{aligned}\\frac{(-\\frac{14}{3})}{(-8)} & = \\\\ \\frac{-14}{3\\times (-8)} & = \\\\ \\frac{-14}{-24} & = \\\\ \\frac{-14÷2}{-24÷2} & = \\\\ \\frac{7}{12}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492001 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1159a985-d3e7-5ea5-9edc-8cb0dc94ade4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{6}}{11}" :db/id #edb/ref 17592186491489} {:answer/id #uuid "48b80554-80e9-51c6-ba68-7718499fcfe4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{6}}{7}" :db/id #edb/ref 17592186491591} {:answer/id #uuid "5e0fa41d-14f0-57f7-a37b-2be2a23d1b25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{7}" :db/id #edb/ref 17592186491624} {:answer/id #uuid "f3a55a62-0c0c-5220-b8c6-af6e6528b232" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7\\sqrt{6}" :db/id #edb/ref 17592186491870} {:answer/id #uuid "f76ea64e-21fc-595c-abaa-ccb166764691" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11\\sqrt{6}" :db/id #edb/ref 17592186491877}] :answer-field/correct {:answer/id #uuid "48b80554-80e9-51c6-ba68-7718499fcfe4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{6}}{7}" :db/id #edb/ref 17592186491591} :answer-field/id #uuid "baaef671-af9a-562b-9900-23310ee68578" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491957}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "22c774c3-0c22-5336-81d9-8b5ada9d82d8" :question/math-academy-id "q-136199" :question/problem "$\\sqrt{6}÷(2-{3}^{2})=$" :question/worked-solution "To simplify the given expression, we use PEMDAS. In terms of the order of operations: \n\n- expressions underneath radicals are treated the same as parentheses\n\n- radicals themselves are treated as exponents\n\nTherefore, following the order of operations, we obtain:\n\n$$\n\\begin{aligned}\\sqrt{6}÷(2-{3}^{2}) & = \\\\ \\sqrt{6}÷(2-9) & = \\\\ \\sqrt{6}÷(-7) & = \\\\ \\frac{\\sqrt{6}}{(-7)} & = \\\\ -\\frac{\\sqrt{6}}{7}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492014 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bf2b462-2502-592a-b0ce-07bd8bf7b790" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-22" :db/id #edb/ref 17592186491511} {:answer/id #uuid "44ce22a6-0172-53a7-b33b-5c382ed5ecf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186491585} {:answer/id #uuid "b6e64d39-c835-59ae-a49d-efc231137210" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186491769} {:answer/id #uuid "e36757c9-fa2f-5360-aa90-a67c5ef3c9ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186491842} {:answer/id #uuid "edde2d09-ca70-53d3-8e63-3242c380bf5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186491863}] :answer-field/correct {:answer/id #uuid "edde2d09-ca70-53d3-8e63-3242c380bf5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186491863} :answer-field/id #uuid "1116abcc-56e2-5d6f-a608-53f2c148f2a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491894}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "50acaf8f-e65d-537d-be92-5374b0715e0a" :question/math-academy-id "q-99407" :question/problem "Find the value of  $(\\sqrt{36}+16)÷(-7-4).$" :question/worked-solution "To evaluate the given expression, we use PEMDAS. In terms of the order of operations: \n\n- expressions underneath radicals are treated the same as parentheses\n\n- radicals themselves are treated as exponents\n\nTherefore, following the order of operations, we obtain:\n\n$$\n\\begin{aligned}(\\sqrt{36}+16)÷(-7-4) & = \\\\ (\\sqrt{36}+16)÷(-11) & = \\\\ (\\sqrt{6\\cdot 6}+16)÷(-11) & = \\\\ (\\sqrt{{6}^{2}}+16)÷(-11) & = \\\\ (6+16)÷(-11) & = \\\\ 22÷(-11) & = \\\\ -2\\end{aligned}\n$$"}]}
