.type/math} :answer/value "{z}^{12}" :db/id #edb/ref 17592186538445} {:answer/id #uuid "7872b3f6-c2d7-5cae-9ed4-21e7de27441c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{7}" :db/id #edb/ref 17592186538505} {:answer/id #uuid "a2cd87da-b89d-562c-81bd-4756e6c1e055" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{z}^{12}}" :db/id #edb/ref 17592186538619} {:answer/id #uuid "b9de8e18-f770-596b-8f87-37d29419a8d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{z}^{7}}" :db/id #edb/ref 17592186538668}] :answer-field/correct {:answer/id #uuid "7872b3f6-c2d7-5cae-9ed4-21e7de27441c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{7}" :db/id #edb/ref 17592186538505} :answer-field/id #uuid "3b9fc6f8-b371-50fb-914d-71a4829c2da7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538834}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "16bce723-03c6-53a5-b2a1-c812d455c8ee" :question/math-academy-id "q-2893" :question/problem "${z}^{4}\\cdot {z}^{3}=$" :question/worked-solution "We add the exponents, as follows:\n\n$$\n\\begin{aligned}{z}^{4}\\cdot {z}^{3} & = \\\\ {z}^{4+3} & = \\\\ {z}^{7}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186538938 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06a93b05-ba04-5b12-b9af-ad0b8b110e94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6q-9" :db/id #edb/ref 17592186538248} {:answer/id #uuid "adf2da43-a52a-5c4e-a6cc-d107314f80ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7q-9" :db/id #edb/ref 17592186538643} {:answer/id #uuid "b3413e8a-2ffd-566c-9eeb-e2b5771ed2a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7q+9" :db/id #edb/ref 17592186538651} {:answer/id #uuid "e6f8dd87-eed3-5563-a9b9-ebac8afe85be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5q-9" :db/id #edb/ref 17592186538758} {:answer/id #uuid "fc2542d6-6523-51ba-a6d9-3c06637ea467" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5q+9" :db/id #edb/ref 17592186538801}] :answer-field/correct {:answer/id #uuid "b3413e8a-2ffd-566c-9eeb-e2b5771ed2a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7q+9" :db/id #edb/ref 17592186538651} :answer-field/id #uuid "ac226765-7bac-59c7-b218-c5a2ec7022c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538887}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2eb696c5-dbcf-5ba0-8d82-82e64e6ac266" :question/math-academy-id "q-144246" :question/problem "Simplify the expression $-6q-(q-9).$" :question/worked-solution "First, we remove the parentheses by distributing the negative sign. This gives\n\n$$\n-6q-q+9\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}-6q-q+9 & = \\\\ (-6q-q)+9 & = \\\\ -7q+9 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186538948 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "768779f2-cfcd-52c5-945b-acc0d08b63b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186538500}] :answer-field/correct {:answer/id #uuid "768779f2-cfcd-52c5-945b-acc0d08b63b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186538500} :answer-field/id #uuid "97a23528-f8a8-5a73-9c66-2133c045b42e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186538881}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3d20e092-7a52-54cf-904a-8aa79d562ce0" :question/math-academy-id "q-175877" :question/problem "If $r=1,$ then $\\frac{7r}{15}+\\frac{6}{5r}=${{field-1}}." :question/worked-solution "We replace $r$ with $1$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{7r}{15}+\\frac{6}{5r} & = \\\\ \\frac{7\\cdot 1}{15}+\\frac{6}{5\\cdot 1} & = \\\\ \\frac{7}{15}+\\frac{6}{5} & = \\\\ \\frac{7}{15}+\\frac{18}{15} & = \\\\ \\frac{7+18}{15} & = \\\\ \\frac{25}{15} & = \\\\ \\frac{5}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186538949 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b62c904-4d93-5e91-8fcd-3d63b312cd13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186538293} {:answer/id #uuid "543e9569-ebcc-52ee-b615-3c6d09b84d55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186538415} {:answer/id #uuid "5cb9b356-5932-53cb-a1f6-0aeb3ef4cb11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186538431} {:answer/id #uuid "d1540b6d-345a-5120-8ab5-0582cc400a53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186538717} {:answer/id #uuid "e404cb10-11b0-59fe-9d87-fdcbd419c82f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186538752}] :answer-field/correct {:answer/id #uuid "5cb9b356-5932-53cb-a1f6-0aeb3ef4cb11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186538431} :answer-field/id #uuid "52c1e553-d74d-59fd-a539-db479dc23184" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538846}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3e848dbc-438d-5d9d-8de6-41c96328b31b" :question/math-academy-id "q-131806" :question/problem "If $x=2$ then $|3-{2}^{x}|+4=$" :question/worked-solution "We substitute $x=2$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|3-{2}^{x}|+4 & = \\\\ |3-{2}^{2}|+4 & = \\\\ |3-4|+4 & = \\\\ |-1|+4 & = \\\\ 1+4 & = \\\\ 5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186538955 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03b9ac09-8a0b-5e19-8eed-d5880937da6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15u}{14v}" :db/id #edb/ref 17592186538242} {:answer/id #uuid "29e6cb3e-b4ac-5e03-989e-fb0e1ead58f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{35uv}" :db/id #edb/ref 17592186538322} {:answer/id #uuid "89b64097-1ab5-5998-aca4-a169f7923341" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{15uv}" :db/id #edb/ref 17592186538552} {:answer/id #uuid "9bcefeb9-a1e2-5ee5-bae1-918c0d6a6ac9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4v}{5u}" :db/id #edb/ref 17592186538601} {:answer/id #uuid "ac4b9935-1677-51f7-bfe7-8f40cf53d972" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14v}{15u}" :db/id #edb/ref 17592186538638}] :answer-field/correct {:answer/id #uuid "ac4b9935-1677-51f7-bfe7-8f40cf53d972" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14v}{15u}" :db/id #edb/ref 17592186538638} :answer-field/id #uuid "fa25d937-0cb4-59d9-82ac-b31ee7968be2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538920}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4dcf3cdc-27a5-54d1-8c1d-7131e7d4a1a0" :question/math-academy-id "q-113798" :question/problem "$\\frac{2}{5u}÷\\frac{3}{7v}=$" :question/worked-solution "To compute\n\n$$\n\\frac{2}{5u}÷\\frac{3}{7v},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{2}{5u}÷\\frac{3}{7v} & = \\\\ \\frac{2}{5u}\\cdot \\frac{7v}{3} & = \\\\ \\frac{14v}{15u} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186538965 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24240d5d-9699-58fb-8663-ef448a1296b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+8" :db/id #edb/ref 17592186538305} {:answer/id #uuid "aafbf437-5412-58dc-86e3-6f4bc151f85e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{x-5}" :db/id #edb/ref 17592186538633} {:answer/id #uuid "b1b02b83-478f-5565-a598-0b24437db7e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-5}{x+8}" :db/id #edb/ref 17592186538646} {:answer/id #uuid "e9718652-7a2a-51d9-93d2-a20b22cde1b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186538763} {:answer/id #uuid "fec52fe6-cb5d-5c54-b138-3ee0039ec4da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+8}{x-8}" :db/id #edb/ref 17592186538804}] :answer-field/correct {:answer/id #uuid "fec52fe6-cb5d-5c54-b138-3ee0039ec4da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+8}{x-8}" :db/id #edb/ref 17592186538804} :answer-field/id #uuid "03a34a35-604f-5749-8973-20d9e084ced6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538807}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "64ed62a5-f26a-57d4-b199-8c8c51b737ac" :question/math-academy-id "q-30011" :question/problem "Given that $\\frac{{x}^{2}-64}{x-5}=a$ and $\\frac{(x-8)^{2}}{x-5}=b,$ what is $a÷b?$" :question/worked-solution "To compute\n\n$$\na÷b=\\frac{{x}^{2}-64}{x-5}÷\\frac{(x-8)^{2}}{x-5},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}-64}{x-5}÷\\frac{(x-8)^{2}}{x-5} & = \\\\ \\frac{{x}^{2}-64}{x-5}\\cdot \\frac{x-5}{(x-8)^{2}} & = \\\\ \\frac{(x-8)(x+8)}{x-5}\\cdot \\frac{x-5}{(x-8)(x-8)} & = \\\\ \\frac{\\cancel{(x-8)}(x+8)}{\\cancel{x-5}}\\cdot \\frac{\\cancel{x-5}}{\\cancel{(x-8)}(x-8)} & = \\\\ (x+8)\\cdot \\frac{1}{(x-8)} & = \\\\ \\frac{x+8}{x-8}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186538969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18a638e8-6cda-5be6-a77d-f20d9d4443b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186538288} {:answer/id #uuid "18f4ba97-b8dc-5324-888d-a39a7e05bc49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186538290} {:answer/id #uuid "310cbe50-de0c-523d-89e2-0bff3267c529" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186538331} {:answer/id #uuid "3cdc4bb2-5d9e-5596-97e3-5781ff5e4c86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186538357} {:answer/id #uuid "a07da073-1567-54b2-ab82-80e4aeed8938" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186538615}] :answer-field/correct {:answer/id #uuid "18f4ba97-b8dc-5324-888d-a39a7e05bc49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186538290} :answer-field/id #uuid "e60f0809-006d-5d59-8100-1de6658c3ea0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538911}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "68630caf-af8f-50ee-bc03-18c9657f8cb4" :question/math-academy-id "q-103238" :question/problem "Evaluate $|x-5|-|3-x|+2$ for $x=8.$" :question/worked-solution "We substitute $x=8$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|x-5|-|3-x|+2 & = \\\\ |8-5|-|3-8|+2 & = \\\\ |3|-|-5|+2 & = \\\\ 3-5+2 & = \\\\ 0 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186538971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da4845bf-1401-512a-8c52-28302042301c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186538733}] :answer-field/correct {:answer/id #uuid "da4845bf-1401-512a-8c52-28302042301c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186538733} :answer-field/id #uuid "ea38a251-ab23-5c87-abfe-28a8670ee8a6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186538912}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6a42fde9-ed9b-5e9d-86c6-940fc99b7d25" :question/math-academy-id "q-215803" :question/problem "If $y=0,$ then $|2y+3{|}^{3}-|y+2|=${{field-1}}." :question/worked-solution "We substitute $y=0$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|2y+3{|}^{3}-|y+2| & = \\\\ |2(0)+3{|}^{3}-|0+2| & = \\\\ |0+3{|}^{3}-|0+2| & = \\\\ |3{|}^{3}-|2| & = \\\\ {3}^{3}-2 & = \\\\ 27-2 & = \\\\ 25 & \\end{aligned}\n$$"}]}
