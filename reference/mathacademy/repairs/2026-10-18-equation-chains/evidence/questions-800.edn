db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{29}{6}" :db/id #edb/ref 17592186478891} {:answer/id #uuid "e3491aad-f540-5d63-b808-205276445ed8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{3}" :db/id #edb/ref 17592186478913}] :answer-field/correct {:answer/id #uuid "4dbc7d01-1ba7-5cfe-8510-01783b2399ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{31}{6}" :db/id #edb/ref 17592186478670} :answer-field/id #uuid "94188954-378c-51e7-898f-7f8bdd2e70ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479017}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bcde543e-81aa-57ea-886b-66ee35330ede" :question/math-academy-id "q-99811" :question/problem "$\\frac{4}{3}+5-\\frac{7}{6}=$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nWe add and subtract, from left to right:\n\n$$\n\\begin{aligned}\\frac{4}{3}+5-\\frac{7}{6} & = \\\\ (\\frac{4}{3}+5)-\\frac{7}{6} & = \\\\ (\\frac{4}{3}+\\frac{15}{3})-\\frac{7}{6} & = \\\\ \\frac{4+15}{3}-\\frac{7}{6} & = \\\\ \\frac{19}{3}-\\frac{7}{6} & = \\\\ \\frac{38}{6}-\\frac{7}{6} & = \\\\ \\frac{38-7}{6} & = \\\\ \\frac{31}{6}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479123 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "586d57ed-6322-50cd-9bf2-d3afc104c6b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186478682}] :answer-field/correct {:answer/id #uuid "586d57ed-6322-50cd-9bf2-d3afc104c6b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186478682} :answer-field/id #uuid "8a3e180a-4f98-588d-a55b-f82b3f9dfac9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479014}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c4c3b101-24b5-5159-855c-3722311747de" :question/math-academy-id "q-171410" :question/problem "If $b=8,$ then $3b-11=${{field-1}}." :question/worked-solution "Replacing $b$ with $8$ in the expression, we get\n\n$$\n\\begin{aligned}3b-11 & = \\\\ 3(8)-11 & = \\\\ 24-11 & = \\\\ 13 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479125 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a25c3b76-33b2-5ddb-bd40-9f882ef4f25b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186478825}] :answer-field/correct {:answer/id #uuid "a25c3b76-33b2-5ddb-bd40-9f882ef4f25b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186478825} :answer-field/id #uuid "8e20507b-53cf-5029-9ff9-03e4a68206bb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479016}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c819591b-7976-59a4-815e-5b13c1691fd5" :question/math-academy-id "q-180268" :question/problem "If $w=2$ and $z=-4,$ then $w+5z=${{field-1}}." :question/worked-solution "Replacing $w$ with $2$ and $z$ with $-4,$ we get\n\n$$\n\\begin{aligned}w+5z & = \\\\ 2+5(-4) & = \\\\ 2-20 & = \\\\ -18 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479127 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b403c69-74fe-5349-aefb-9cb442a9a6e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{2}" :db/id #edb/ref 17592186478814}] :answer-field/correct {:answer/id #uuid "9b403c69-74fe-5349-aefb-9cb442a9a6e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{2}" :db/id #edb/ref 17592186478814} :answer-field/id #uuid "89a1c7b6-5a65-5b4e-bfb7-cbbcc3b7d3f6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479013}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cafba121-70b2-571d-a218-1d3bb9b3e4ea" :question/math-academy-id "q-175955" :question/problem "Expressed as an improper fraction in lowest terms, $\\frac{3}{7}÷\\frac{2}{5}\\times 7=${{field-1}}." :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nWe divide and multiply, from left to right:\n\n$$\n\\begin{aligned}\\frac{3}{7}÷\\frac{2}{5}\\times 7 & = \\\\ (\\frac{3}{7}÷\\frac{2}{5})\\times 7 & = \\\\ (\\frac{3}{7}\\times \\frac{5}{2})\\times 7 & = \\\\ \\frac{3\\times 5}{7\\times 2}\\times 7 & = \\\\ \\frac{15}{14}\\times 7 & = \\\\ \\frac{15}{14}\\times \\frac{7}{1} & = \\\\ \\frac{15\\times 7}{14\\times 1} & = \\\\ \\frac{105}{14} & = \\\\ \\frac{15}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479134 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e65ebf46-2f69-57b1-97a2-8a7627364272" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{8}" :db/id #edb/ref 17592186478917}] :answer-field/correct {:answer/id #uuid "e65ebf46-2f69-57b1-97a2-8a7627364272" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{8}" :db/id #edb/ref 17592186478917} :answer-field/id #uuid "64409c9a-b082-5202-877a-44cfa2b215a2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186478999}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "db6984e3-bfbe-5e15-a092-ee9588e31df7" :question/math-academy-id "q-175940" :question/problem "Expressed as an improper fraction in lowest terms, $\\frac{1}{4}+3-\\frac{5}{8}=${{field-1}}." :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nWe add and subtract, from left to right:\n\n$$\n\\begin{aligned}\\frac{1}{4}+3-\\frac{5}{8} & = \\\\ (\\frac{1}{4}+3)-\\frac{5}{8} & = \\\\ (\\frac{1}{4}+\\frac{12}{4})-\\frac{5}{8} & = \\\\ \\frac{1+12}{4}-\\frac{5}{8} & = \\\\ \\frac{13}{4}-\\frac{5}{8} & = \\\\ \\frac{26}{8}-\\frac{5}{8} & = \\\\ \\frac{26-5}{8} & = \\\\ \\frac{21}{8}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479837 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c59e113-f08a-53ee-867d-94d7fb5788b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186479378} {:answer/id #uuid "11936538-40d4-54b8-8b7b-d33e072de285" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186479385} {:answer/id #uuid "8e0ec6de-9581-5bd8-bb44-d0aa83898ca2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186479570} {:answer/id #uuid "f4806540-adde-54c6-a865-acf5b657cc39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186479724} {:answer/id #uuid "fc830cf0-6f39-543f-9250-0e261d7a0ffd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186479739}] :answer-field/correct {:answer/id #uuid "fc830cf0-6f39-543f-9250-0e261d7a0ffd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186479739} :answer-field/id #uuid "14fd58b4-2f30-5ee5-84aa-9be98305fb78" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479750}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "155136a2-7453-5b52-882f-507c2e2bad0d" :question/math-academy-id "q-14373" :question/problem "$\\frac{3+2x}{2x+3}=$" :question/worked-solution "First, we notice that $2x+3=3+2x.$ So we have:\n\n$$\n\\begin{aligned}\\frac{3+2x}{2x+3}=\\frac{3+2x}{3+2x}\\end{aligned}\n$$\n\nThen, we cancel out all the pairs of common factors in the numerator and denominator. In this case, there is one pair of $3+2x.$\n\n$$\n\\begin{aligned}\\frac{3+2x}{3+2x} & = \\\\ \\frac{\\cancel{(3+2x)}}{\\cancel{(3+2x)}} & = \\\\ 1\\end{aligned}\n$$\n\nThus, the expression simplifies to $1.$"}] [{:db/id #edb/ref 17592186479838 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fa47c90-822e-5cae-9c90-9811be703303" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186479382} {:answer/id #uuid "13cd9def-d62d-523f-bcc8-d8abfd3e4096" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186479389} {:answer/id #uuid "6bf40da0-404d-5051-9d95-09134da5b392" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186479521} {:answer/id #uuid "8e50ea8a-2303-5b56-a731-389bce2ade00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186479571} {:answer/id #uuid "948f56c7-8f8d-5b25-a476-f644a3998656" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186479582}] :answer-field/correct {:answer/id #uuid "948f56c7-8f8d-5b25-a476-f644a3998656" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186479582} :answer-field/id #uuid "5ce10bcb-f75f-5da4-9cc0-483d51851272" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479776}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "15e3ee11-29b6-56d8-a84c-a4bce1a94db1" :question/math-academy-id "q-67237" :question/problem "Evaluate $\\frac{6x}{2t}-\\frac{3x}{t}$ if $x=-1$ and $t=3$ ." :question/worked-solution "We replace $x$ with $-1$ and $t$ with $3$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{6x}{2t}-\\frac{3x}{t} & = \\\\ \\frac{6(-1)}{2(3)}-\\frac{3(-1)}{3} & = \\\\ \\frac{-6}{6}-\\frac{-3}{3} & = \\\\ -1-(-1) & = \\\\ 0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479846 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d27b27a-980b-5ba5-86b9-9aff77b35144" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3y}{x}" :db/id #edb/ref 17592186479405} {:answer/id #uuid "5991eaf9-379d-5279-909a-66c42b65d53b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y}{3x}" :db/id #edb/ref 17592186479486} {:answer/id #uuid "77606623-9e12-5922-8bc5-274712f9ce66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y}{x}" :db/id #edb/ref 17592186479539} {:answer/id #uuid "9775a4ef-c5bc-58e2-beec-931ce7d2fd7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y}{3z}" :db/id #edb/ref 17592186479589} {:answer/id #uuid "fe3b7392-9245-5b25-b8dd-39ac5d0958a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{z}{3x}" :db/id #edb/ref 17592186479743}] :answer-field/correct {:answer/id #uuid "5991eaf9-379d-5279-909a-66c42b65d53b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y}{3x}" :db/id #edb/ref 17592186479486} :answer-field/id #uuid "36ab8a45-ab87-53fd-b22d-f561bdade95f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479762}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4044453a-5a6d-5fd7-b8c8-665b004cb36e" :question/math-academy-id "q-100066" :question/problem "What is $\\frac{yz}{3xz}$ reduced to lowest terms?" :question/worked-solution "First, we decompose all of the terms into their various factors.\n\n$$\n\\begin{aligned}\\frac{yz}{3xz}=\\frac{y\\cdot z}{3\\cdot x\\cdot z}\\end{aligned}\n$$\n\nThen, we cancel out all the pairs of common factors in the numerator and denominator. In this case, there is one pair of $z$'s.\n\n$$\n\\begin{aligned}\\frac{y\\cdot z}{3\\cdot x\\cdot z} & = \\\\ \\frac{y\\cdot \\cancel{z}}{3\\cdot x\\cdot \\cancel{z}} & = \\\\ \\frac{y}{3x}\\end{aligned}\n$$\n\nThus, the expression simplifies to $\\frac{y}{3x}.$"}] [{:db/id #edb/ref 17592186479857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "492ca173-32de-5ad3-ab96-01eda6d35cd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{17}" :db/id #edb/ref 17592186479466} {:answer/id #uuid "73fd8ce8-60c1-5892-97a7-ca62b504e224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{7}" :db/id #edb/ref 17592186479534} {:answer/id #uuid "8998867c-2920-592a-b642-f1440b72c516" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{17}{2}" :db/id #edb/ref 17592186479563} {:answer/id #uuid "9a93ac9b-b8c1-54ca-9c6c-3304b49dca1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{2}" :db/id #edb/ref 17592186479595} {:answer/id #uuid "d88a5b69-267c-5551-979c-1ae79b8e5657" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{17}" :db/id #edb/ref 17592186479684}] :answer-field/correct {:answer/id #uuid "8998867c-2920-592a-b642-f1440b72c516" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{17}{2}" :db/id #edb/ref 17592186479563} :answer-field/id #uuid "14dd0833-e969-55f0-900c-6ed71684dc4e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479749}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5b344d92-93c1-5290-a0ad-6b1e4107b056" :question/math-academy-id "q-99873" :question/problem "Evaluate $\\frac{p(5p-2)}{6(3p+8)}$ for $p=-3.$" :question/worked-solution "We replace $p$ with $-3$ in the above expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{p(5p-2)}{6(3p+8)} & = \\\\ \\frac{(-3)(5(-3)-2)}{6(3(-3)+8)} & = \\\\ \\frac{(-3)(-15-2)}{6(-9+8)} & = \\\\ \\frac{(-3)(-17)}{6(-1)} & = \\\\ \\frac{51}{(-6)} & = \\\\ -\\frac{17}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479861 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28980dc0-67fe-568a-95f7-85f6561039b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2+5z}{3}" :db/id #edb/ref 17592186479419} {:answer/id #uuid "5c4226aa-9491-52f8-9c50-18fb61fb5a1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5+2z}{3}" :db/id #edb/ref 17592186479490} {:answer/id #uuid "65bf5c02-8884-527a-8596-a864fde66c5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2+2z}{3}" :db/id #edb/ref 17592186479509} {:answer/id #uuid "cb387617-f782-5ecb-bb3d-85ab96c34d51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5+2z}{z}" :db/id #edb/ref 17592186479668} {:answer/id #uuid "efe243fe-0627-5bc7-ac0c-58cbf7e19251" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5+5z}{3}" :db/id #edb/ref 17592186479715}] :answer-field/correct {:answer/id #uuid "5c4226aa-9491-52f8-9c50-18fb61fb5a1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5+2z}{3}" :db/id #edb/ref 17592186479490} :answer-field/id #uuid "112af529-727f-510a-876d-604ecec5f0bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479748}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "61eea428-2437-5847-999f-591f4a5a456c" :question/math-academy-id "q-67242" :question/problem "Which of the following is equivalent to $\\frac{z(5+2z)}{3z}?$" :question/worked-solution "First, we decompose all of the terms into their various factors.\n\n$$\n\\begin{aligned}\\frac{z(5+2z)}{3z}=\\frac{z\\cdot (5+2z)}{3\\cdot z}\\end{aligned}\n$$\n\nThen, we cancel out all the pairs of common factors in the numerator and denominator. In this case, there is one pair of $z$'s.\n\n$$\n\\begin{aligned}\\frac{z\\cdot (5+2z)}{3\\cdot z} & = \\\\ \\frac{\\cancel{z}\\cdot (5+2z)}{3\\cdot \\cancel{z}} & = \\\\ \\frac{5+2z}{3}\\end{aligned}\n$$\n\nThus, the expression simplifies to $\\frac{5+2z}{3}.$"}] [{:db/id #edb/ref 17592186479868 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "081c1c0a-d0e8-54bb-88e9-73fe216a5ecb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(x-1)}{5x}" :db/id #edb/ref 17592186479371} {:answer/id #uuid "28b2884a-06e6-568f-b579-7f8512014993" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-1}{x}" :db/id #edb/ref 17592186479420} {:answer/id #uuid "e670a8e1-db7a-57a0-a060-c21171cecfbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4(x-1)}{5x}" :db/id #edb/ref 17592186479698} {:answer/id #uuid "ef34483e-106e-5818-a18b-e61e50d39479" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(x-1)}{3x}" :db/id #edb/ref 17592186479713} {:answer/id #uuid "f0cc50e3-0b5b-5c1a-862e-bef50e0df483" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5(x-1)}{4x}" :db/id #edb/ref 17592186479719}] :answer-field/correct {:answer/id #uuid "e670a8e1-db7a-57a0-a060-c21171cecfbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4(x-1)}{5x}" :db/id #edb/ref 17592186479698} :answer-field/id #uuid "e2e828d3-cf66-52fd-bbb8-8a49e2cdb0b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479814}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "85ebb17c-ed44-5cf2-a5c7-233470157f33" :question/math-academy-id "q-75369" :question/problem "$\\frac{12(x-1)}{15x}=$" :question/worked-solution "First, we decompose all of the terms into their various factors. The $12(x-1)$ in the numerator becomes $2\\cdot 2\\cdot 3\\cdot (x-1),$ and the $15x$ in the denominator becomes $3\\cdot 5\\cdot x.$\n\n$$\n\\begin{aligned}\\frac{12(x-1)}{15x}=\\frac{2\\cdot 2\\cdot 3\\cdot (x-1)}{3\\cdot 5\\cdot x}\\end{aligned}\n$$\n\nThen, we cancel out all the pairs of common factors in the numerator and denominator. In this case, there is one pair of $3$'s.\n\n$$\n\\begin{aligned}\\frac{2\\cdot 2\\cdot 3\\cdot (x-1)}{3\\cdot 5\\cdot x} & = \\\\ \\frac{2\\cdot 2\\cdot \\cancel{3}\\cdot (x-1)}{\\cancel{3}\\cdot 5\\cdot x} & = \\\\ \\frac{2\\cdot 2\\cdot (x-1)}{5\\cdot x} & = \\\\ \\frac{4(x-1)}{5x}\\end{aligned}\n$$\n\nThus, the expression simplifies to $\\frac{4(x-1)}{5x}.$"}] [{:db/id #edb/ref 17592186479871 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dad6b761-626c-5e60-b184-97c3c374f08a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186479685}] :answer-field/correct {:answer/id #uuid "dad6b761-626c-5e60-b184-97c3c374f08a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186479685} :answer-field/id #uuid "c649b4ef-f1a9-5c40-9e0e-b1c1946fdccc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479802}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "87efd59d-ce0a-5957-a5fd-7fe6753d07aa" :question/math-academy-id "q-175684" :question/problem "If $x=4,$ then $\\frac{5x-4}{x-2}=${{field-1}}." :question/worked-solution "We replace $x$ with $4$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{5x-4}{x-2} & = \\\\ \\frac{5(4)-4}{4-2} & = \\\\ \\frac{16}{2} & = \\\\ 8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479873 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c48f353-e4e8-5167-a7c6-69ea1c45a203" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2a}{a+2}" :db/id #edb/ref 17592186479522} {:answer/id #uuid "96e5afa7-7dcc-5372-8334-82d34be0002e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{a}{a+2}" :db/id #edb/ref 17592186479586} {:answer/id #uuid "ae72a19a-bc7f-5755-8385-3842bcb247e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{a}{a+1}" :db/id #edb/ref 17592186479621} {:answer/id #uuid "efe9d29e-816e-5929-beb1-1ede407394ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2a}{a+1}" :db/id #edb/ref 17592186479716} {:answer/id #uuid "fb512587-b0fa-560f-b1c8-d8ffb99f24fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2a}{3(a+2)}" :db/id #edb/ref 17592186479736}] :answer-field/correct {:answer/id #uuid "6c48f353-e4e8-5167-a7c6-69ea1c45a203" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2a}{a+2}" :db/id #edb/ref 17592186479522} :answer-field/id #uuid "82d46f26-d6b2-510f-a75b-7142f40cc7f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479783}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8cbe3ef2-930d-574e-83d8-95fc23d584d3" :question/math-academy-id "q-75370" :question/problem "$\\frac{18a}{9(a+2)}=$" :question/worked-solution "First, we decompose all of the terms into their various factors. The $18a$ in the numerator becomes $2\\cdot 3\\cdot 3\\cdot a,$ and the $9(a+2)$ in the denominator becomes $3\\cdot 3\\cdot (a+2).$\n\n$$\n\\begin{aligned}\\frac{18a}{9(a+2)}=\\frac{2\\cdot 3\\cdot 3\\cdot a}{3\\cdot 3\\cdot (a+2)}\\end{aligned}\n$$\n\nThen, we cancel out all the pairs of common factors in the numerator and denominator. In this case, there are two pairs of $3$'s.\n\n$$\n\\begin{aligned}\\frac{2\\cdot 3\\cdot 3\\cdot a}{3\\cdot 3\\cdot (a+2)} & = \\\\ \\frac{2\\cdot \\cancel{3}\\cdot \\cancel{3}\\cdot a}{\\cancel{3}\\cdot \\cancel{3}\\cdot (a+2)} & = \\\\ \\frac{2\\cdot a}{a+2} & = \\\\ \\frac{2a}{a+2}\\end{aligned}\n$$\n\nThus, the expression simplifies to $\\frac{2a}{a+2}.$"}] [{:db/id #edb/ref 17592186479874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f65767b-700b-514d-abc3-d7fa9a5ea4a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186479547}] :answer-field/correct {:answer/id #uuid "7f65767b-700b-514d-abc3-d7fa9a5ea4a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186479547} :answer-field/id #uuid "0f109fc3-9149-5bcd-ab8c-1f1c08cac4eb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479747}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9225fcc6-6a47-5dc8-ba01-452e86bfb00e" :question/math-academy-id "q-173732" :question/problem "If $x=4,$ then $\\frac{4}{x}+\\frac{12}{5x}=${{field-1}}." :question/worked-solution "We replace $x$ with $4$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{4}{x}+\\frac{12}{5x} & = \\\\ \\frac{4}{4}+\\frac{12}{5\\cdot 4} & = \\\\ 1+\\frac{3}{5} & = \\\\ \\frac{5}{5}+\\frac{3}{5} & = \\\\ \\frac{5+3}{5} & = \\\\ \\frac{8}{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479878 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "065d2cc6-2b7a-5048-8381-f0d529cf916c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-1}{x+1}" :db/id #edb/ref 17592186479368} {:answer/id #uuid "630c5016-91ed-523f-b3a0-229839ac925d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186479504} {:answer/id #uuid "89dff5ec-8950-5602-9e19-37aace0522e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(x-1)}{(x+1)}" :db/id #edb/ref 17592186479564} {:answer/id #uuid "b342417f-d18f-57d0-bb5d-9490f37f2f1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186479625} {:answer/id #uuid "b4c5a728-8678-55ce-b083-4259d62dcb90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+1" :db/id #edb/ref 17592186479630}] :answer-field/correct {:answer/id #uuid "065d2cc6-2b7a-5048-8381-f0d529cf916c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-1}{x+1}" :db/id #edb/ref 17592186479368} :answer-field/id #uuid "9063d8ee-9fe6-5e2b-88bd-23fe4635e865" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479790}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a06dc73c-225f-5c37-b7d5-563ea645e257" :question/math-academy-id "q-155" :question/problem "$\\frac{2(x-1)}{2(x+1)}=$" :question/worked-solution "First, we decompose all of the terms into their various factors. The $2(x-1)$ in the numerator becomes $2\\cdot (x-1),$ and the $2(x+1)$ in the denominator becomes $2\\cdot (x+1).$\n\n$$\n\\begin{aligned}\\frac{2(x-1)}{2(x+1)}=\\frac{2\\cdot (x-1)}{2\\cdot (x+1)}\\end{aligned}\n$$\n\nThen, we cancel out all the pairs of common factors in the numerator and denominator. In this case, there is only one pair of $2$'s.\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{2\\cdot (x-1)}{2\\cdot (x+1)} & = \\\\ \\frac{\\cancel{2}\\cdot (x-1)}{\\cancel{2}\\cdot (x+1)} & = \\\\ \\frac{(x-1)}{(x+1)}\\end{aligned}\\end{aligned}\n$$\n\nThus, the expression simplifies to $\\frac{x-1}{x+1}.$"}] [{:db/id #edb/ref 17592186479884 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bb2dabd-d3ff-58f7-863a-fb9e1d9b390d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5(y-3)}" :db/id #edb/ref 17592186479376} {:answer/id #uuid "2e0cda42-eedf-5058-93d1-bf12ded0aa50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}(y-3)" :db/id #edb/ref 17592186479428} {:answer/id #uuid "8b7d6847-74d4-52eb-a60f-8f439d660902" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5(y-3)}" :db/id #edb/ref 17592186479566} {:answer/id #uuid "90dafb0a-1f40-562d-bd76-33cd101d6a40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}(y-3)" :db/id #edb/ref 17592186479579} {:answer/id #uuid "b8b60fe1-7c11-525d-b2b1-13712ed4a16d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5(y-3)}" :db/id #edb/ref 17592186479635}] :answer-field/correct {:answer/id #uuid "b8b60fe1-7c11-525d-b2b1-13712ed4a16d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5(y-3)}" :db/id #edb/ref 17592186479635} :answer-field/id #uuid "fe3e14eb-22b8-5147-9028-3893a72c3d27" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479824}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b68074c4-93d7-57b0-8864-ec0076cbeea0" :question/math-academy-id "q-41549" :question/problem "$\\frac{16}{20(y-3)}=$" :question/worked-solution "First, we decompose all of the terms into their various factors. The $16$ in the numerator becomes $2\\cdot 2\\cdot 2\\cdot 2,$ and the $20(y-3)$ in the denominator becomes $2\\cdot 2\\cdot 5\\cdot (y-3).$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{16}{20(y-3)}=\\frac{2\\cdot 2\\cdot 2\\cdot 2}{2\\cdot 2\\cdot 5\\cdot (y-3)}\\end{aligned}\\end{aligned}\n$$\n\nThen, we cancel out all the pairs of common factors in the numerator and denominator. In this case, there are two pairs of $2$'s.\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{2\\cdot 2\\cdot 2\\cdot 2}{2\\cdot 2\\cdot 5\\cdot (y-3)} & = \\\\ \\frac{\\cancel{2}\\cdot \\cancel{2}\\cdot 2\\cdot 2}{\\cancel{2}\\cdot \\cancel{2}\\cdot 5\\cdot (y-3)} & = \\\\ \\frac{2\\cdot 2}{5\\cdot (y-3)} & = \\\\ \\frac{4}{5(y-3)}\\end{aligned}\\end{aligned}\n$$\n\nThus, the expression simplifies to $\\frac{4}{5(y-3)}.$"}] [{:db/id #edb/ref 17592186479890 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90695084-425d-5a63-8e98-c52c1fc270bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{2}" :db/id #edb/ref 17592186479578}] :answer-field/correct {:answer/id #uuid "90695084-425d-5a63-8e98-c52c1fc270bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{2}" :db/id #edb/ref 17592186479578} :answer-field/id #uuid "f7d10e84-318f-5815-a469-6c3b1e58e115" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479821}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c7c69cd2-d2ae-54a6-bb6d-38d0dd05009e" :question/math-academy-id "q-175906" :question/problem "If $x=-4$ and $y=3,$ then $\\frac{3x+2}{3}+\\frac{x+y}{2y}=${{field-1}}." :question/worked-solution "Replacing $x$ with $-4$ and $y$ with $3$ in the expression, we get the following:\n\n$$\n\\begin{aligned}\\frac{3x+2}{3}+\\frac{x+y}{2y} & = \\\\ \\frac{3(-4)+2}{3}+\\frac{-4+3}{2(3)} & = \\\\ \\frac{-12+2}{3}+\\frac{(-1)}{6} & = \\\\ -\\frac{10}{3}-\\frac{1}{6} & = \\\\ -\\frac{20}{6}-\\frac{1}{6} & = \\\\ \\frac{-20-1}{6} & = \\\\ -\\frac{21}{6} & = \\\\ -\\frac{7}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479894 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2091d8a1-eaab-5a05-8861-1f8abb34b955" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186479414} {:answer/id #uuid "85fb3187-facc-57f1-ab70-b630841edb64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(5z+1)}{3z}" :db/id #edb/ref 17592186479558} {:answer/id #uuid "ebc04d96-6d76-50b3-a8c9-411832fae8f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4(5z+1)}{z}" :db/id #edb/ref 17592186479707} {:answer/id #uuid "f72bdc69-b108-572c-bd30-099ea2502466" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8(5z+1)}{3z}" :db/id #edb/ref 17592186479730} {:answer/id #uuid "f90a5767-60e8-51c1-8857-0d450ea81290" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186479732}] :answer-field/correct {:answer/id #uuid "f72bdc69-b108-572c-bd30-099ea2502466" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8(5z+1)}{3z}" :db/id #edb/ref 17592186479730} :answer-field/id #uuid "62023835-2ec7-51b8-9552-f67efdf117fc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479778}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d8919a5c-5e3b-5274-9d2f-901afddd5e90" :question/math-academy-id "q-41557" :question/problem "Simplify $\\frac{32x(5z+1)}{12xz}.$" :question/worked-solution "First, we decompose all of the terms into their various factors. The $32x(5z+1)$ in the numerator becomes $2\\cdot 2\\cdot 2\\cdot 2\\cdot 2\\cdot x\\cdot (5z+1),$ and the $12xz$ in the denominator becomes $3\\cdot 2\\cdot 2\\cdot x\\cdot z.$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{32x(5z+1)}{12xz}=\\frac{2\\cdot 2\\cdot 2\\cdot 2\\cdot 2\\cdot x\\cdot (5z+1)}{3\\cdot 2\\cdot 2\\cdot x\\cdot z}\\end{aligned}\\end{aligned}\n$$\n\nThen, we cancel out all the pairs of common factors in the numerator and denominator. In this case, there are two pairs of $2\\text{'s}$ and one pair of $x$'s.\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{2\\cdot 2\\cdot 2\\cdot 2\\cdot 2\\cdot x\\cdot (5z+1)}{3\\cdot 2\\cdot 2\\cdot x\\cdot z} & = \\\\ \\frac{\\cancel{2}\\cdot \\cancel{2}\\cdot 2\\cdot 2\\cdot 2\\cdot \\cancel{x}\\cdot (5z+1)}{3\\cdot \\cancel{2}\\cdot \\cancel{2}\\cdot \\cancel{x}\\cdot z} & = \\\\ \\frac{2\\cdot 2\\cdot 2\\cdot (5z+1)}{3\\cdot z} & = \\\\ \\frac{8(5z+1)}{3z}\\end{aligned}\\end{aligned}\n$$\n\nThus, the expression simplifies to $\\frac{8(5z+1)}{3z}.$"}] [{:db/id #edb/ref 17592186479897 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72bc25be-0c58-52ca-abbd-b05107247f5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{10}" :db/id #edb/ref 17592186479529}] :answer-field/correct {:answer/id #uuid "72bc25be-0c58-52ca-abbd-b05107247f5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{10}" :db/id #edb/ref 17592186479529} :answer-field/id #uuid "5cc10fd6-407a-53fb-b5c9-ca815a84b79f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479775}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e26eed03-f29f-5ce3-a1e7-151a8b9035cd" :question/math-academy-id "q-175875" :question/problem "If $p=5,$ then $\\frac{3p}{10}+\\frac{1}{p}=${{field-1}}." :question/worked-solution "We replace $p$ with $5$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{3p}{10}+\\frac{1}{p}= \\\\ \\frac{3(5)}{10}+\\frac{1}{5} & = \\\\ \\frac{15}{10}+\\frac{1}{5} & = \\\\ \\frac{15}{10}+\\frac{2}{10} & = \\\\ \\frac{15+2}{10} & = \\\\ \\frac{17}{10}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479900 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d3677bf-742c-53a4-a047-d86fc48f3bbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186479450} {:answer/id #uuid "3ddfa06b-86d5-559c-85a2-4fc800367521" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{13}" :db/id #edb/ref 17592186479452} {:answer/id #uuid "47743e4d-66ff-57e8-a301-5fcb5f2dd10f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{2}" :db/id #edb/ref 17592186479462} {:answer/id #uuid "6039b89d-8e65-5ba1-8241-2b05954ba057" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186479500} {:answer/id #uuid "7ba6ab15-6cf9-5ef9-a2bd-146153a7b34d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186479541}] :answer-field/correct {:answer/id #uuid "47743e4d-66ff-57e8-a301-5fcb5f2dd10f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{2}" :db/id #edb/ref 17592186479462} :answer-field/id #uuid "1fef7ddd-1525-56e1-9913-003a91c9ac36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479753}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fa6ce3e2-d928-5ded-b467-af49a788ffd9" :question/math-academy-id "q-99771" :question/problem "Evaluate $\\frac{5x+8}{3-x}$ for $x=1.$" :question/worked-solution "We replace $x$ with $1$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{5x+8}{3-x} & = \\\\ \\frac{5(1)+8}{3-1} & = \\\\ \\frac{13}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "362a7338-66ee-57c0-a245-11f4e62738f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4y}" :db/id #edb/ref 17592186479440} {:answer/id #uuid "37115e22-5ffc-53cf-adb7-fa70a8cb055e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x}{4y}" :db/id #edb/ref 17592186479441} {:answer/id #uuid "77eff539-c70f-5cc6-a384-798f4fb1bfae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}x" :db/id #edb/ref 17592186479540} {:answer/id #uuid "beccfae6-b5ee-5736-b110-8316f9b6d40c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186479647} {:answer/id #uuid "d0c1f978-3d95-58dc-be98-003e32663ad2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{4}x" :db/id #edb/ref 17592186479677}] :answer-field/correct {:answer/id #uuid "77eff539-c70f-5cc6-a384-798f4fb1bfae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}x" :db/id #edb/ref 17592186479540} :answer-field/id #uuid "3ac2e58a-247b-5a34-a1a7-53a045e18181" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479763}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fad200a4-e2f6-57c9-aa77-2766fc482dc1" :question/math-academy-id "q-41552" :question/problem "Simplify $\\frac{(3x)(7y)}{28y}.$" :question/worked-solution "First, we decompose all of the terms into their various factors. The $(3x)(7y)$ in the numerator becomes $3\\cdot 7\\cdot x\\cdot y,$ and the $28y$ in the denominator becomes $2\\cdot 2\\cdot 7\\cdot y.$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{(3x)(7y)}{28y}=\\frac{3\\cdot 7\\cdot x\\cdot y}{2\\cdot 2\\cdot 7\\cdot y}\\end{aligned}\\end{aligned}\n$$\n\nThen, we cancel out all the pairs of common factors in the numerator and denominator. In this case, there is one pair of $7\\text{'s}$ and one pair of $y$'s.\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{3\\cdot 7\\cdot x\\cdot y}{2\\cdot 2\\cdot 7\\cdot y} & = \\\\ \\frac{3\\cdot \\cancel{7}\\cdot x\\cdot \\cancel{y}}{2\\cdot 2\\cdot \\cancel{7}\\cdot \\cancel{y}} & = \\\\ \\frac{3\\cdot x}{2\\cdot 2} & = \\\\ \\frac{3}{4}x\\end{aligned}\\end{aligned}\n$$\n\nThus, the expression simplifies to $\\frac{3}{4}x.$"}] [{:db/id #edb/ref 17592186480638 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77e5bd0e-3c61-550f-bf29-e8fd2b0a9051" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+5" :db/id #edb/ref 17592186480306}] :answer-field/correct {:answer/id #uuid "77e5bd0e-3c61-550f-bf29-e8fd2b0a9051" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+5" :db/id #edb/ref 17592186480306} :answer-field/id #uuid "17348961-19d5-502d-926a-4b0fe905626b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186480541}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1a7f0062-c2c7-5c0c-af15-d14b42ae0b4e" :question/math-academy-id "q-133269" :question/problem "![](images/0a/0a3abcc5987a334da234faca33d5d906fde8b1482631e7a4bf281b2094c2339b.png)\n\nA utility pole is located on the edge of Fred's land, as shown above. The distance from the right edge of Fred's plot to the pole is $x-5$ meters. Find the distance to the pole from the left edge as a function of $x.$\n\nThe required distance is \n{{field-1}}\nmeters." :question/worked-solution "In part 1, we found that the length of Fred's plot is $2x$ meters.\n\nTo find the required distance, we need to subtract polynomials $2x$ and $x-5:$\n\nWe put a minus sign between the two polynomials, distribute it over the second polynomial, collect like terms, and then simplify:\n\n$$\n\\begin{aligned}(2x)-(x-5) & = \\\\ 2x-x+5 & = \\\\ (2-1)x+5 & = \\\\ x+5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186480640 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ca88955-2551-56b5-ae77-f58ffc8d46ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2}^{2}\\cdot {3}^{3}" :db/id #edb/ref 17592186480158} {:answer/id #uuid "20a27ccd-ef69-5159-a07a-6bb960f42037" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2}^{3}\\cdot 3" :db/id #edb/ref 17592186480166} {:answer/id #uuid "23e3fcda-86fd-5c67-80ac-0a18aa283291" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2}^{3}\\cdot {3}^{2}" :db/id #edb/ref 17592186480170} {:answer/id #uuid "95450425-9751-51d9-bdf4-48d8be8b762f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2}^{2}\\cdot {3}^{2}" :db/id #edb/ref 17592186480356} {:answer/id #uuid "ce847297-eafd-5ed8-a2c0-a653698ee15b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2}^{3}\\cdot {3}^{3}" :db/id #edb/ref 17592186480454}] :answer-field/correct {:answer/id #uuid "ce847297-eafd-5ed8-a2c0-a653698ee15b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2}^{3}\\cdot {3}^{3}" :db/id #edb/ref 17592186480454} :answer-field/id #uuid "ef793749-fafc-5291-be50-cc1de1416ebc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186480619}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1e6c10cd-7db6-5a24-8c7d-80ae10691af2" :question/math-academy-id "q-22315" :question/problem "Use exponents to rewrite the product $2\\cdot 2\\cdot 2\\cdot 3\\cdot 3\\cdot 3.$" :question/worked-solution "We can apply the product rule to the two numbers independently:\n\n$$\n\\begin{aligned}2\\cdot 2\\cdot 2\\cdot 3\\cdot 3\\cdot 3 & = \\\\ ({2}^{1}\\cdot {2}^{1}\\cdot {2}^{1})({3}^{1}\\cdot {3}^{1}\\cdot {3}^{1}) & = \\\\ {2}^{3}\\cdot {3}^{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186480642 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52df8e4e-e473-5190-9aeb-f0096927f5fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{-3}" :db/id #edb/ref 17592186480251} {:answer/id #uuid "97487b45-8238-58f3-9c27-00ee8e3855c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}" :db/id #edb/ref 17592186480359} {:answer/id #uuid "c5e9a546-66e7-5266-9000-f8a352e3b453" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186480441} {:answer/id #uuid "c638a612-ac6b-5641-b143-681bed9091a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}" :db/id #edb/ref 17592186480443} {:answer/id #uuid "d0395dd1-17ba-540c-87b8-c76d002accac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{5}" :db/id #edb/ref 17592186480462}] :answer-field/correct {:answer/id #uuid "c638a612-ac6b-5641-b143-681bed9091a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}" :db/id #edb/ref 17592186480443} :answer-field/id #uuid "a8328799-896e-5212-8c80-2907af8b6d2a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186480589}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2158d6ec-2be1-5446-9223-07b6831e7100" :question/math-academy-id "q-388" :question/problem "Simplify the expression $x\\cdot {x}^{2}.$" :question/worked-solution "We add the exponents, as follows:\n\n$$\n\\begin{aligned}x\\cdot {x}^{2} & = \\\\ {x}^{1}\\cdot {x}^{2} & = \\\\ {x}^{1+2} & = \\\\ {x}^{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186480646 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d07857e-d64a-5376-a325-458a741d04e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{6}" :db/id #edb/ref 17592186480207} {:answer/id #uuid "40a85261-cfab-5279-bc88-4ad582c5e156" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{5}" :db/id #edb/ref 17592186480218} {:answer/id #uuid "5458b9d5-ded6-5501-8699-41a14efeced2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{32}" :db/id #edb/ref 17592186480253} {:answer/id #uuid "a24a4819-bbe1-55d7-a054-4813e2a51e0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}" :db/id #edb/ref 17592186480377} {:answer/id #uuid "bd95db74-a0a7-5658-8e11-27e1514781be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186480426}] :answer-field/correct {:answer/id #uuid "40a85261-cfab-5279-bc88-4ad582c5e156" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{5}" :db/id #edb/ref 17592186480218} :answer-field/id #uuid "c7c0ea57-ce94-5903-a23c-6168dc95f384" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186480599}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "24348bb2-c07f-5da2-b2dd-e3e224260e04" :question/math-academy-id "q-2863" :question/problem "${x}^{3}\\cdot {x}^{2}=$" :question/worked-solution "We add the exponents, as follows:\n\n$$\n\\begin{aligned}{x}^{3}\\cdot {x}^{2} & = \\\\ {x}^{3+2} & = \\\\ {x}^{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186480647 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f68f0b0-453f-59b0-bee4-466dbbe05765" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "450" :db/id #edb/ref 17592186480187}] :answer-field/correct {:answer/id #uuid "2f68f0b0-453f-59b0-bee4-466dbbe05765" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "450" :db/id #edb/ref 17592186480187} :answer-field/id #uuid "b4d2cd95-745f-5a52-99a9-88f26c0bf6c0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186480595}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "27b43ba5-62b8-50b7-a27d-9c99f1e28b1d" :question/math-academy-id "q-133273" :question/problem "If $x=20\\,\\text{m},$ what is the area of Emma's land plot?\n\nArea $\\,=$\n{{field-1}}\n${\\text{m}}^{2}$" :question/worked-solution "To find the area, we have to evaluate the polynomial ${x}^{2}+3x-10$ at $x=20.$\n\nSo, we substitute $x=20$ into the polynomial and simplify: \n\n$$\n\\begin{aligned}{x}^{2}+3x-10 & = \\\\ (20)^{2}+3(20)-10 & = \\\\ 400+60-10 & = \\\\ 450\\end{aligned}\n$$\n\nTherefore, the area is $450\\,{\\text{m}}^{2}.$"}] [{:db/id #edb/ref 17592186480655 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba0f05c3-c538-51c4-9189-cfab53990b09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186480419}] :answer-field/correct {:answer/id #uuid "ba0f05c3-c538-51c4-9189-cfab53990b09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186480419} :answer-field/id #uuid "85424d4a-06a8-54a2-8057-3520a4258478" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186480577}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4f002498-444e-5f1e-b174-d456ccc0407b" :question/math-academy-id "q-133261" :question/problem "Expressed as a polynomial in terms of $x,$ the length of Fred's plot of land is{{field-1}}\nmeters." :question/worked-solution "The width of the plot is $x+3$ meters, and its area is $2{x}^{2}+6x$ square meters. Since the $\\text{area}=\\text{length}\\times \\text{width},$ we factor the expression for the area to find the length.\n\nFirst, we find the $\\text{GCF}$ of the two terms:\n\n$$\n\\text{GCF}(2{x}^{2},6x)=2x\n$$\n\nThen, we rewrite each term in the original expression as a product with the $\\text{GCF}:$\n\n$$\n\\begin{aligned}2{x}^{2}+6x & = \\\\ (2x\\cdot x)+(2x\\cdot 3)\\end{aligned}\n$$\n\nNext, we write the $\\text{GCF}$ outside the parentheses and keep the remaining terms inside:\n\n$$\n\\begin{aligned}(2x\\cdot x)+(2x\\cdot 3) & = \\\\ 2x(x+3)\\end{aligned}\n$$\n\nAs a result, we conclude that the length of the plot must be $2x$ meters.\n\n![](images/19/19307236885ccd9bc41d9bdd70df230932f2858804a24e96945880124dee0457.png)"}] [{:db/id #edb/ref 17592186480665 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a185603-b4f1-56c6-ba48-0f42bd7d26a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186480151} {:answer/id #uuid "4a2f878c-fec5-5755-96bb-1161995eeedf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186480237} {:answer/id #uuid "55a85215-f199-5cc4-8988-d8d0f0927e6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "187.5" :db/id #edb/ref 17592186480255} {:answer/id #uuid "6acc2ab7-51cb-51f1-a07f-1a3b4d54d305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186480283} {:answer/id #uuid "9306faf8-4093-5e6f-9781-92a5fd1a0a66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-187.5" :db/id #edb/ref 17592186480351}] :answer-field/correct {:answer/id #uuid "6acc2ab7-51cb-51f1-a07f-1a3b4d54d305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186480283} :answer-field/id #uuid "10176a3c-6389-5f3b-b3b8-ccc8df0a7ec2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186480537}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6b52aa6c-ff41-5226-8eac-b56efc594a90" :question/math-academy-id "q-100159" :question/problem "Evaluate $(3\\times (-5)^{2})÷\\frac{5}{2}.$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, consider the expression inside the parentheses:\n\n$$\n\\begin{aligned}3\\times (-5)^{2}\\end{aligned}\n$$\n\nApplying PEMDAS to this expression, we obtain:\n\n$$\n\\begin{aligned}3\\times (-5)^{2} & = \\\\ 3\\times 25 & = \\\\ 75\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}(3\\times (-5)^{2})÷\\frac{5}{2} & = \\\\ 75÷\\frac{5}{2} & = \\\\ 75\\times \\frac{2}{5} & = \\\\ \\frac{75}{1}\\times \\frac{2}{5} & = \\\\ \\frac{75\\times 2}{1\\times 5} & = \\\\ \\frac{150}{5} & = \\\\ 30\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186480672 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fb4f86a-5824-53e7-b06b-eae5d318b941" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186480163} {:answer/id #uuid "847e9538-1bc6-5da0-86d9-ab816861e8cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186480333} {:answer/id #uuid "8a4a55fc-8448-5c08-9c7a-c0eccb5983f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186480343} {:answer/id #uuid "dd6d9510-cb9d-5190-ad74-b673c7f23c44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186480481} {:answer/id #uuid "e9fc6f9a-d398-50b4-9cff-c334ca944fe1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186480497}] :answer-field/correct {:answer/id #uuid "1fb4f86a-5824-53e7-b06b-eae5d318b941" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186480163} :answer-field/id #uuid "96ae24e2-5006-5a83-a03f-bea224f75aee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186480586}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7907920d-205f-5377-afe5-d6463114236a" :question/math-academy-id "q-22371" :question/problem "Find $n$ such that  ${a}^{2}\\cdot {a}^{3}\\cdot {a}^{4}={a}^{n}$  is correct." :question/worked-solution "We add the exponents, as follows:\n\n$$\n\\begin{aligned}{a}^{2}\\cdot {a}^{3}\\cdot {a}^{4} & = \\\\ {a}^{(2+3+4)} & = \\\\ {a}^{9}\\end{aligned}\n$$\n\nTherefore ${a}^{n}={a}^{9}$, so $n=9.$"}] [{:db/id #edb/ref 17592186480674 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8bbbd880-d7e2-5a44-b42a-0dfce6cf9fa9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186480347}] :answer-field/correct {:answer/id #uuid "8bbbd880-d7e2-5a44-b42a-0dfce6cf9fa9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186480347} :answer-field/id #uuid "06fd876a-80c1-5d01-8d82-49f786db185b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186480530}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "92e6407b-23f0-522c-8861-cf43d1d90280" :question/math-academy-id "q-184059" :question/problem "$(-18)÷((-3)^{4}÷9)=${{field-1}}" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, consider the expression inside the parentheses:\n\n$$\n\\begin{aligned}(-3)^{4}÷9\\end{aligned}\n$$\n\nApplying PEMDAS to this expression, we obtain:\n\n$$\n\\begin{aligned}(-3)^{4}÷9 & = \\\\ 81÷9 & = \\\\ \\frac{81}{9} & = \\\\ 9\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}(-18)÷((-3)^{4}÷9) & = \\\\ (-18)÷9 & = \\\\ \\frac{(-18)}{9} & = \\\\ -\\frac{18}{9} & = \\\\ -2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186480700 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f967a28-837b-54d2-af49-03c005191815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-2" :db/id #edb/ref 17592186480373}] :answer-field/correct {:answer/id #uuid "9f967a28-837b-54d2-af49-03c005191815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-2" :db/id #edb/ref 17592186480373} :answer-field/id #uuid "df1e0c5e-89c3-5935-b671-11830fe30345" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186480609}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e97c6917-f66f-5f90-bc2c-151969a83727" :question/math-academy-id "q-133265" :question/problem "![](images/5b/5bbf82f97549272635ff1ea78d945691cf356dfbde2d0933788f734d6b7f9601.png)\n\nFred's neighbor to the south, Emma, has a land plot of area ${x}^{2}+3x-10$ square meters, as shown in the picture. Given that the length of Emma's plot of land is $x+5$ meters, what is the width of the plot in terms of $x?$\n\nEmma's plot width is\n{{field-1}}\nmeters." :question/worked-solution "To find the required width, we need to factor the expression ${x}^{2}+3x-10.$\n\nFirst, we find the factor pairs of the constant term $(-10).$ The constant term is negative, so that means one of the factors is negative, and the other is positive:\n\n$$\n\\begin{aligned}1 & \\times (-10) \\\\ (-1) & \\times 10 \\\\ 2 & \\times (-5) \\\\ (-2) & \\times 5\\end{aligned}\n$$\n\nNow, we find which factor pair adds up to the coefficient of the linear term $3:$\n\n$$\n\\begin{aligned}1+(-10) & =-9 & \\times  \\\\ -1+10 & =9 & \\times  \\\\ 2+(-5) & =-3 & \\times  \\\\ -2+5 & =3 & ✓\\end{aligned}\n$$\n\nUsing the factor pair identified above, write the linear term as $3x=5x-2x:$\n\n$$\n\\begin{aligned}{x}^{2}+3x-10 & ={x}^{2}+5x-2x-10\\end{aligned}\n$$\n\nFinally, we factor the first two terms and the last two terms separately, and then factor the expression completely:\n\n$$\n\\begin{aligned}{x}^{2}+5x-2x-10 & = \\\\ ({x}^{2}+5x)+(-2x-10) & = \\\\ x(x+5)-2(x+5) & = \\\\ (x-2)(x+5)\\end{aligned}\n$$\n\nAs a result, we conclude that the width must be $x-2$ meters. \n\n![](images/6b/6bdc252e1952c6e56a971c7d88c126a75a68e3ae48783c7cb65495ed5b4b86b1.png)"}] [{:db/id #edb/ref 17592186481340 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e30d5f8-b029-5e8f-994f-f9d19469b0bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "33" :db/id #edb/ref 17592186480946}] :answer-field/correct {:answer/id #uuid "6e30d5f8-b029-5e8f-994f-f9d19469b0bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "33" :db/id #edb/ref 17592186480946} :answer-field/id #uuid "0b2d042f-d653-58ff-8c3e-46fccccb3798" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186481243}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "00632209-b439-5ff0-a973-a59862d161d8" :question/math-academy-id "q-178582" :question/problem "${8}^{0}+{2}^{3}\\times 4=${{field-1}}" :question/worked-solution "To evaluate the given expression, we use PEMDAS.\n\nNotice that ${8}^{0}=1.$ So, we obtain:\n\n$$\n\\begin{aligned}{8}^{0}+{2}^{3}\\times 4 & = \\\\ 1+8\\times 4 & = \\\\ 1+(8\\times 4) & = \\\\ 1+32 & = \\\\ 33\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481342 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2affc424-b64d-5e66-8ac0-e677197618b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x^{5}+5x^{4}" :db/id #edb/ref 17592186480818}] :answer-field/correct {:answer/id #uuid "2affc424-b64d-5e66-8ac0-e677197618b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x^{5}+5x^{4}" :db/id #edb/ref 17592186480818} :answer-field/id #uuid "73fd6360-f6ac-52b2-8f2e-d34673fe83c2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186481278}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "02b8d95c-cd10-56fd-a2ee-19a46309a688" :question/math-academy-id "q-215318" :question/problem "Expand the following product. Write your answer in **standard form.**\n\n$-{x}^{3}(2{x}^{2}-5x)=$\n{{field-1}}" :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}-{x}^{3}(2{x}^{2}-5x) & = \\\\ (-{x}^{3})(2{x}^{2})+(-{x}^{3})(-5x) & = \\\\ ((-1)\\cdot 2)({x}^{3}\\cdot {x}^{2})+((-1)\\cdot (-5))({x}^{3}\\cdot x) & = \\\\ (-2){x}^{3+2}+(5){x}^{3+1} & = \\\\ -2{x}^{5}+5{x}^{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481344 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b7be341b-eeb1-56cd-a834-c863d737ab2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "77u^{2}-20u-12" :db/id #edb/ref 17592186481090}] :answer-field/correct {:answer/id #uuid "b7be341b-eeb1-56cd-a834-c863d737ab2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "77u^{2}-20u-12" :db/id #edb/ref 17592186481090} :answer-field/id #uuid "cded0974-27ad-56b0-a5f7-77743e5c2583" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186481314}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "04f1ace1-c4c7-5004-a410-92cc0ba374dc" :question/math-academy-id "q-216721" :question/problem "Expand the following product of binomials. Write your answer in **standard form.**\n\n$(11u-6)(7u+2)=$\n{{field-1}}" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}(11u-6)(7u+2) & = \\\\ 11u(7u+2)+(-6)(7u+2) & = \\\\ 77{u}^{2}+22u-42u-12 & = \\\\ 77{u}^{2}-20u-12\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481346 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eee98293-3395-5eb0-b143-f256c73f4a75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3x^{6}+x^{3}-2x^{2}" :db/id #edb/ref 17592186481196}] :answer-field/correct {:answer/id #uuid "eee98293-3395-5eb0-b143-f256c73f4a75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3x^{6}+x^{3}-2x^{2}" :db/id #edb/ref 17592186481196} :answer-field/id #uuid "d01f0664-679f-5f38-857f-275bf91d4556" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186481316}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0b6d8c42-1d59-52b0-9958-cceeca4a3dbe" :question/math-academy-id "q-216998" :question/problem "Expand the following product. Write your answer in **standard form.**\n\n$-{x}^{2}(3{x}^{4}-x+2)=$\n{{field-1}}" :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}-{x}^{2}(3{x}^{4}-x+2) & = \\\\ (-{x}^{2})(3{x}^{4})+(-{x}^{2})(-x)+(-{x}^{2})2 & = \\\\ ((-1)\\cdot 3)({x}^{2}\\cdot {x}^{4})+((-1)\\cdot (-1))({x}^{2}\\cdot x)+((-1)\\cdot 2)({x}^{2}) & = \\\\ (-3){x}^{2+4}+(1){x}^{2+1}+(-2){x}^{2} & = \\\\ -3{x}^{6}+{x}^{3}-2{x}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481347 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da556150-891e-5d8b-9f01-4c094a952cfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186481151}] :answer-field/correct {:answer/id #uuid "da556150-891e-5d8b-9f01-4c094a952cfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186481151} :answer-field/id #uuid "da963681-e81e-570e-8ee7-27f4ce7fcb83" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186481323}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0c594a87-b025-5472-b8ba-c9c1f57faafe" :question/math-academy-id "q-215788" :question/problem "If $x=-2,$ then $|{x}^{3}-x|+2x=${{field-1}}." :question/worked-solution "We substitute $x=-2$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|{x}^{3}-x|+2x & = \\\\ |(-2)^{3}-(-2)|+2(-2) & = \\\\ |-8+2|-4 & = \\\\ |-6|-4 & = \\\\ 6-4 & = \\\\ 2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481351 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f23fdbd-3fd3-56f8-9056-aa6d59dc3eab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x^{6}+8x^{2}" :db/id #edb/ref 17592186480981}] :answer-field/correct {:answer/id #uuid "7f23fdbd-3fd3-56f8-9056-aa6d59dc3eab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x^{6}+8x^{2}" :db/id #edb/ref 17592186480981} :answer-field/id #uuid "5587de01-f6eb-59f8-8ec0-eb041dd8281c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186481269}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1c4a8c11-58ca-529c-a377-f348add911e4" :question/math-academy-id "q-216986" :question/problem "Expand the following product. Write your answer in **standard form.**\n\n$2{x}^{2}(3{x}^{4}+4)=$\n{{field-1}}" :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}2{x}^{2}(3{x}^{4}+4) & = \\\\ 2{x}^{2}\\cdot (3{x}^{4})+2{x}^{2}\\cdot 4 & = \\\\ 6{x}^{2+4}+8{x}^{2} & = \\\\ 6{x}^{6}+8{x}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481353 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff37ba3f-b657-5468-a046-c7a885ae86ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{16}" :db/id #edb/ref 17592186481235}] :answer-field/correct {:answer/id #uuid "ff37ba3f-b657-5468-a046-c7a885ae86ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{16}" :db/id #edb/ref 17592186481235} :answer-field/id #uuid "c9a275f8-e12f-531b-9ed6-2c3eda31cf0e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186481313}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2dbc86c1-eb39-5436-87d8-eb16a5d4d270" :question/math-academy-id "q-179401" :question/problem "$(7-5)^{-4}+{(\\frac{3}{5}-\\frac{1}{2})}^{0}=${{field-1}}" :question/worked-solution "To evaluate the given expression, we use PEMDAS. \n\nFirst, we compute the expression inside the parentheses:\n\n$$\n\\begin{aligned}(7-5)^{-4}+{(\\frac{3}{5}-\\frac{1}{2})}^{0} & = \\\\ {2}^{-4}+{(\\frac{6}{10}-\\frac{5}{10})}^{0} & = \\\\ {2}^{-4}+{(\\frac{1}{10})}^{0}\\end{aligned}\n$$\n\nNext, notice that ${(\\frac{1}{10})}^{0}=1.$ So, we obtain:\n\n$$\n\\begin{aligned}{2}^{-4}+{(\\frac{1}{10})}^{0} & = \\\\ {2}^{-4}+1\\end{aligned}\n$$\n\nFinally, notice that ${2}^{-4}=\\frac{1}{{2}^{4}}=\\frac{1}{16}.$ So, \n\n$$\n\\begin{aligned}{2}^{-4}+1 & = \\\\ \\frac{1}{16}+1 & = \\\\ \\frac{1+16}{16} & = \\\\ \\frac{17}{16}. & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481355 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "031fe889-8bcf-55b6-9e2c-5bc76ff27045" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186480742} {:answer/id #uuid "18283892-3eb2-55cd-b35f-59a9010c6395" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186480785} {:answer/id #uuid "2e9c3feb-96eb-537a-af4e-a8b745ab09c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186480824} {:answer/id #uuid "43f5d7d0-17b2-565d-a98f-1e82335af6f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186480869} {:answer/id #uuid "f9d07389-9d7e-558b-836a-ab159ef21592" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186481224}] :answer-field/correct {:answer/id #uuid "43f5d7d0-17b2-565d-a98f-1e82335af6f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186480869} :answer-field/id #uuid "aed2c6d7-4afd-5487-8b46-d9d9acb8c258" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186481301}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "372dbe69-5a97-5673-bcbc-f7d304887030" :question/math-academy-id "q-100293" :question/problem "${7}^{-1}\\times (2+\\frac{1}{3})=$" :question/worked-solution "To evaluate the given expression, we use PEMDAS.\n\nNotice that ${7}^{-1}=\\frac{1}{7}.$ So, we obtain:\n\n$$\n\\begin{aligned}{7}^{-1}\\times (2+\\frac{1}{3}) & = \\\\ \\frac{1}{7}\\times (2+\\frac{1}{3}) & = \\\\ \\frac{1}{7}\\times \\frac{6+1}{3} & = \\\\ \\frac{1}{7}\\times \\frac{7}{3} & = \\\\ \\frac{1\\times 7}{7\\times 3} & = \\\\ \\frac{1\\times \\cancel{7}}{3\\times \\cancel{7}} & = \\\\ \\frac{1}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481358 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "069e3471-ebe0-5e7e-8dba-bc08c1f1ec1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186480751}] :answer-field/correct {:answer/id #uuid "069e3471-ebe0-5e7e-8dba-bc08c1f1ec1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186480751} :answer-field/id #uuid "ae6361ee-8e08-51d0-bc10-6459c6132ecc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186481300}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3d01c032-f798-5a69-9d8e-9a45c684623b" :question/math-academy-id "q-215798" :question/problem "If $x=-7,$ then $|x+2|+|x|=${{field-1}}." :question/worked-solution "We substitute $x=-7$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|x+2|+|x| & = \\\\ |-7+2|+|-7| & = \\\\ |-5|+|-7| & = \\\\ 5+7 & = \\\\ 12 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481362 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08f20868-6a4d-50d9-a8bc-710ffae4cb97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186480758} {:answer/id #uuid "85811a93-a7cf-52b7-942f-22f7a24348c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/v