+2d)+3d({c}^{4}+2d) & = \\\\ 2{c}^{8}+4{c}^{4}d+3{c}^{4}d+6{d}^{2} & = \\\\ 2{c}^{8}+7{c}^{4}d+6{d}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481382 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c3f777b-2d3d-5028-ab4c-2a89deea13e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{t}^{2}+7t+4" :db/id #edb/ref 17592186480799} {:answer/id #uuid "4c7038a0-59cb-517f-918a-cf6c4f8f6e6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{t}^{2}+8t+12" :db/id #edb/ref 17592186480882} {:answer/id #uuid "4e9fd079-7bb1-5fa9-abf8-4aec6fa53dca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{t}^{2}+12t+12" :db/id #edb/ref 17592186480885} {:answer/id #uuid "e4d1b00d-721f-5870-9994-9a3298e7364f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{t}^{2}+7t+12" :db/id #edb/ref 17592186481173} {:answer/id #uuid "f9a8b617-9e06-5778-8fee-4edce9c97310" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{t}^{2}+12t+4" :db/id #edb/ref 17592186481222}] :answer-field/correct {:answer/id #uuid "e4d1b00d-721f-5870-9994-9a3298e7364f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{t}^{2}+7t+12" :db/id #edb/ref 17592186481173} :answer-field/id #uuid "47a17889-807c-5ba1-9cad-1b1c96d9d53e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186481266}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6f29a61b-d59f-5f7b-8b19-ba0d9192d12c" :question/math-academy-id "q-52151" :question/problem "$(t+3)(t+4)=$" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}(t+3)(t+4) & = \\\\ t(t+4)+3(t+4) & = \\\\ {t}^{2}+4t+3t+12 & = \\\\ {t}^{2}+7t+12\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481390 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "069f88ba-133f-535f-a723-563b81e5b29c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21{k}^{2}+5k+14" :db/id #edb/ref 17592186480752} {:answer/id #uuid "1c0fe191-f3df-5f09-b110-f2120896e9c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21{k}^{2}+56k+9" :db/id #edb/ref 17592186480798} {:answer/id #uuid "268d21ce-8e44-5443-9606-72092afa2e67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21{k}^{2}-55k+14" :db/id #edb/ref 17592186480809} {:answer/id #uuid "979209d8-91c0-5568-969c-cf60d20e453d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21{k}^{2}-5k+14" :db/id #edb/ref 17592186481030} {:answer/id #uuid "c2babc74-c619-5fbd-b511-3dc958506365" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21{k}^{2}+55k+14" :db/id #edb/ref 17592186481112}] :answer-field/correct {:answer/id #uuid "c2babc74-c619-5fbd-b511-3dc958506365" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21{k}^{2}+55k+14" :db/id #edb/ref 17592186481112} :answer-field/id #uuid "90bc955a-ad0b-54ff-af0f-b3b9d809da85" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186481288}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "84908780-ec57-5aef-8661-1e98636ea221" :question/math-academy-id "q-111345" :question/problem "$(3k+7)(7k+2)=$" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}(3k+7)(7k+2) & = \\\\ 3k(7k+2)+7(7k+2) & = \\\\ 21{k}^{2}+6k+49k+14 & = \\\\ 21{k}^{2}+55k+14\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481392 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3871d1a8-8b5e-554b-aea0-bef649450799" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186480848}] :answer-field/correct {:answer/id #uuid "3871d1a8-8b5e-554b-aea0-bef649450799" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186480848} :answer-field/id #uuid "36e13187-05a7-5f23-83c3-7072e5bce2e1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186481260}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8db98389-40f2-5730-bf5c-0c0bb991f194" :question/math-academy-id "q-212311" :question/problem "If $y=10,$ then $|y-15|+2-y=${{field-1}}." :question/worked-solution "We substitute $y=10$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|y-15|+2-y & = \\\\ |10-15|+2-10 & = \\\\ |-5|+2-10 & = \\\\ 5+2-10 & = \\\\ -3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481394 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6cc06e26-7f7d-5361-947a-a5a6be1a9519" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186480943}] :answer-field/correct {:answer/id #uuid "6cc06e26-7f7d-5361-947a-a5a6be1a9519" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186480943} :answer-field/id #uuid "aceab721-8a64-56ee-a107-a68ea20a149a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186481298}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8e7406b5-c760-50f7-b793-e44ff061d556" :question/math-academy-id "q-215801" :question/problem "If $y=-2,$ then $|3-{y}^{4}|+|y|-8=${{field-1}}." :question/worked-solution "We substitute $y=-2$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|3-{y}^{4}|+|y|-8 & = \\\\ |3-(-2)^{4}|+|-2|-8 & = \\\\ |3-16|+|-2|-8 & = \\\\ |-13|+|-2|-8 & = \\\\ 13+2-8 & = \\\\ 7 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481395 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "417d82f2-955e-5809-8bcc-e9b8832280b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186480864}] :answer-field/correct {:answer/id #uuid "417d82f2-955e-5809-8bcc-e9b8832280b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186480864} :answer-field/id #uuid "609c007e-c457-5fc9-a429-2f89995ec208" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186481273}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9362880e-cb69-5b9a-a326-3f6c64c489b9" :question/math-academy-id "q-178596" :question/problem "$((-4)^{0}-5)÷{2}^{2}+7=${{field-1}}" :question/worked-solution "To evaluate the given expression, we use PEMDAS. \n\nNotice that $(-4)^{0}=1.$ So, we obtain:\n\n$$\n\\begin{aligned}((-4)^{0}-5)÷{2}^{2}+7 & = \\\\ (1-5)÷{2}^{2}+7 & = \\\\ -4÷{2}^{2}+7 & = \\\\ -4÷4+7 & = \\\\ -1+7 & = \\\\ 6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481397 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18dcdf6a-ecae-52ab-8293-7ebd8c69e629" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8}{7|z|}" :db/id #edb/ref 17592186480789} {:answer/id #uuid "2a94091a-8723-5ac9-ab16-627223c2b062" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{7}" :db/id #edb/ref 17592186480815} {:answer/id #uuid "7b0fa393-9bee-571c-812f-725f1e012ed7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8z}{7}" :db/id #edb/ref 17592186480967} {:answer/id #uuid "b21cf601-c80a-571f-be86-fe9a0465fc46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{7|z|}" :db/id #edb/ref 17592186481074} {:answer/id #uuid "f842a0ab-0c8a-584b-8c0f-87f8286b4a05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8z}{7}" :db/id #edb/ref 17592186481219}] :answer-field/correct {:answer/id #uuid "b21cf601-c80a-571f-be86-fe9a0465fc46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{7|z|}" :db/id #edb/ref 17592186481074} :answer-field/id #uuid "cded725a-dfe2-53ba-903c-8e4d5a08f11d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186481315}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9b56ca18-7b32-5eb8-a22c-8e34fda01fb4" :question/math-academy-id "q-78907" :question/problem "$|-\\frac{8}{7z}|=$" :question/worked-solution "Firstly, since $|-a|=|a|,$ we can write our expression as\n\n$$\n|\\frac{8}{7z}|.\n$$\n\nThen, we distribute the absolute value over the division, and simplify:\n\n$$\n\\begin{aligned}|\\frac{8}{7z}| & = \\\\ \\frac{|8|}{|7z|} & = \\\\ \\frac{8}{|7z|} & = \\\\ \\frac{8}{|7\\cdot z|} & = \\\\ \\frac{8}{|7|\\cdot |z|} & = \\\\ \\frac{8}{7|z|}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481401 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dedb42c4-e00d-5bfa-8c63-1f4242d6fe90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3a^{5}-5a^{2}" :db/id #edb/ref 17592186481158}] :answer-field/correct {:answer/id #uuid "dedb42c4-e00d-5bfa-8c63-1f4242d6fe90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3a^{5}-5a^{2}" :db/id #edb/ref 17592186481158} :answer-field/id #uuid "e0d39888-088e-5d8c-98c5-3147b816b4d7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186481327}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a358c984-11c0-53e4-9e16-174bbfcc06eb" :question/math-academy-id "q-217022" :question/problem "Expand the following product. Write your answer in **standard form.**\n\n$\\frac{1}{3}a(9{a}^{4}-15a)=$\n{{field-1}}" :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}\\frac{1}{3}a(9{a}^{4}-15a) & = \\\\ (\\frac{1}{3}a)(9{a}^{4})+(\\frac{1}{3}a)(-15a) & = \\\\ (\\frac{1}{3}\\cdot 9)({a}^{1}\\cdot {a}^{4})+(\\frac{1}{3}\\cdot (-15))(a\\cdot a) & = \\\\ (3)({a}^{1+4})+(-5)({a}^{1+1}) & = \\\\ 3{a}^{5}-5{a}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481409 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3376d8a9-d9cf-56fe-87c0-0b074a11fc4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186480838} {:answer/id #uuid "4c4f1470-7854-5859-9502-6ce3be1a1e33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-37" :db/id #edb/ref 17592186480880} {:answer/id #uuid "771e746f-2dfa-570e-8e4f-dfd41179284f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-45" :db/id #edb/ref 17592186480958} {:answer/id #uuid "96142681-b0f0-50c5-a1f6-961274b69ff4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-27" :db/id #edb/ref 17592186481026} {:answer/id #uuid "cafe2d6b-b1ac-5a21-9a9b-b7f3a5473123" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186481123}] :answer-field/correct {:answer/id #uuid "4c4f1470-7854-5859-9502-6ce3be1a1e33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-37" :db/id #edb/ref 17592186480880} :answer-field/id #uuid "b182bfc6-2593-5081-baaf-c8b369d39b1e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186481302}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b3323b73-981f-531d-b13a-02484111e1fb" :question/math-academy-id "q-131823" :question/problem "Evaluate $|{2}^{y}|-5|{y}^{2}|$ for $y=3.$" :question/worked-solution "We substitute $y=3$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|{2}^{y}|-5|{y}^{2}| & = \\\\ |{2}^{3}|-5|{3}^{2}| & = \\\\ |8|-5|9| & = \\\\ 8-5(9) & = \\\\ 8-45 & = \\\\ -37\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481413 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "213a2f49-0016-5875-84c9-889f8190ab98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186480805}] :answer-field/correct {:answer/id #uuid "213a2f49-0016-5875-84c9-889f8190ab98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186480805} :answer-field/id #uuid "392e6cec-195a-576a-925d-034fd1114be2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186481262}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bfd0e220-31b0-52ce-8e2c-55afd941a790" :question/math-academy-id "q-175947" :question/problem "$15+(-3)^{3}÷{7}^{0}=${{field-1}}" :question/worked-solution "To evaluate the given expression, we use PEMDAS.\n\nNotice that ${7}^{0}=1.$ So, we obtain:\n\n$$\n\\begin{aligned}15+(-3)^{3}÷{7}^{0} & = \\\\ 15+(-27)÷1 & = \\\\ 15+(-27) & = \\\\ 15-27 & = \\\\ -12\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481428 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38f7e8e6-c1c7-508e-8d6a-3fd5596d3fe5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{w}^{6}-6{w}^{4}-4{w}^{3}" :db/id #edb/ref 17592186480851} {:answer/id #uuid "7f860bb7-7c51-532a-820b-6f6498f5e522" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{w}^{6}+3w+2" :db/id #edb/ref 17592186480984} {:answer/id #uuid "ca26b375-4a8c-5ae3-b1e9-dd7d05125d32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{w}^{6}-6{w}^{4}+4{w}^{3}" :db/id #edb/ref 17592186481122} {:answer/id #uuid "f7876760-d7ee-5fa6-8f80-c522e35eda1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{w}^{6}-6{w}^{4}+2" :db/id #edb/ref 17592186481216} {:answer/id #uuid "f9b42dee-7635-536d-b190-e1e49a5af093" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{w}^{6}-3{w}^{4}-2{w}^{3}" :db/id #edb/ref 17592186481223}] :answer-field/correct {:answer/id #uuid "38f7e8e6-c1c7-508e-8d6a-3fd5596d3fe5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{w}^{6}-6{w}^{4}-4{w}^{3}" :db/id #edb/ref 17592186480851} :answer-field/id #uuid "2ea4164d-199b-5fa8-988a-88bdda69d024" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186481256}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "dfaf6e99-1d8f-5b5e-92bd-9fd3c571d232" :question/math-academy-id "q-44642" :question/problem "$-2{w}^{3}({w}^{3}+3w+2)=$" :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}-2{w}^{3}({w}^{3}+3w+2) & = \\\\ (-2{w}^{3})({w}^{3})+(-2{w}^{3})(3w)+(-2{w}^{3})(2) & = \\\\ (-2)({w}^{3}\\cdot {w}^{3})+((-2)\\cdot 3)({w}^{3}\\cdot w)+((-2)\\cdot 2)({w}^{3}) & = \\\\ (-2){w}^{3+3}+(-6){w}^{3+1}+(-4){w}^{3} & = \\\\ -2{w}^{6}-6{w}^{4}-4{w}^{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481436 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "684c058e-fbb0-5665-8e58-bdc2317acb6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186480932}] :answer-field/correct {:answer/id #uuid "684c058e-fbb0-5665-8e58-bdc2317acb6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186480932} :answer-field/id #uuid "0f498857-35a2-5b14-a67d-d149c66e46bb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186481247}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f8176f08-c3fb-5b9f-a7f7-c8961022e13b" :question/math-academy-id "q-215791" :question/problem "If $y=-3,$ then $|2y+7{|}^{6}=${{field-1}}." :question/worked-solution "We substitute $y=-3$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|2y+7{|}^{6} & = \\\\ |2(-3)+7{|}^{6} & = \\\\ |-6+7{|}^{6} & = \\\\ |1{|}^{6} & = \\\\ {1}^{6} & = \\\\ 1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481441 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid 