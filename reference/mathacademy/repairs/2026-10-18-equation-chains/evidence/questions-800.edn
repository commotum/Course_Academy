d{aligned}\n$$"}] [{:db/id #edb/ref 17592186482578 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04417ca8-5b44-5f47-8588-203cc9670c83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{p}^{2}}{2}+\\frac{3}{4}p+\\frac{9}{2}" :db/id #edb/ref 17592186481779} {:answer/id #uuid "3b77de52-656a-5d60-a77d-89b9ba362ce9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{p}^{2}}{4}+\\frac{9}{4}" :db/id #edb/ref 17592186481921} {:answer/id #uuid "53a9e444-9bb4-5607-8e5c-dff301ba180a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{p}^{2}}{2}+3p+\\frac{9}{4}" :db/id #edb/ref 17592186481976} {:answer/id #uuid "c668be38-d1ab-5b18-93b6-f9c30310d732" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{p}^{2}}{2}+\\frac{9}{2}" :db/id #edb/ref 17592186482244} {:answer/id #uuid "f6ec47ef-9394-5b6f-bf61-3e7cfa86d762" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{p}^{2}}{4}+\\frac{3}{2}p+\\frac{9}{4}" :db/id #edb/ref 17592186482360}] :answer-field/correct {:answer/id #uuid "f6ec47ef-9394-5b6f-bf61-3e7cfa86d762" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{p}^{2}}{4}+\\frac{3}{2}p+\\frac{9}{4}" :db/id #edb/ref 17592186482360} :answer-field/id #uuid "bd6480f1-db17-5206-8b50-adeb65376df5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186482479}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ae2cfcdb-b465-5141-b188-02dc5998e9f5" :question/math-academy-id "q-33092" :question/problem "${(\\frac{p}{2}+\\frac{3}{2})}^{2}=$" :question/worked-solution "We will use the following formula:\n\n$$\n(a+b)^{2}={a}^{2}+2ab+{b}^{2}\n$$\n\nSubstituting $a=\\frac{p}{2}$ and $b=\\frac{3}{2},$ we have\n\n$$\n\\begin{aligned}{(\\frac{p}{2}+\\frac{3}{2})}^{2} & = \\\\ {(\\frac{p}{2})}^{2}+2(\\frac{p}{2})(\\frac{3}{2})+{(\\frac{3}{2})}^{2} & = \\\\ \\frac{{p}^{2}}{4}+\\frac{3}{2}p+\\frac{9}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186482581 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79c01a83-b5d6-5769-bd3e-9071be86c070" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186482056} {:answer/id #uuid "98a03a70-0f68-53dd-8f66-007f630f4929" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186482134} {:answer/id #uuid "b3221abf-3137-573d-a169-ef9108202aa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186482195} {:answer/id #uuid "c216d6d4-e126-5ff3-8529-49885caaa9eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186482237} {:answer/id #uuid "d06a0e38-f6cc-5b53-9560-3b91aa3818ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186482272}] :answer-field/correct {:answer/id #uuid "79c01a83-b5d6-5769-bd3e-9071be86c070" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186482056} :answer-field/id #uuid "719b405c-02b7-5abd-9fbb-e9f0c434b9e9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186482436}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b558035c-db2a-5cb8-b598-445d3a220fdc" :question/math-academy-id "q-99397" :question/problem "$\\sqrt{4÷({3}^{2}-5)}=$" :question/worked-solution "To simplify the given expression, we use PEMDAS. In 