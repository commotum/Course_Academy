nswer.type/math} :answer/value "3" :db/id #edb/ref 17592186483113} {:answer/id #uuid "b63acf3d-4721-599f-a3c9-ed430f3df95a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt[3]{3}" :db/id #edb/ref 17592186483120}] :answer-field/correct {:answer/id #uuid "55226f44-eddc-576c-bc1e-f415c75b6779" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt[3]{2}" :db/id #edb/ref 17592186482960} :answer-field/id #uuid "b23220f2-f280-5ed4-95bf-4e6807424bc5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483309}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "39e9c0e1-e2d8-5a05-8dd1-6cb147dae13d" :question/math-academy-id "q-110888" :question/problem "Evaluate $\\sqrt[3]{8t+6}$ at $t=6.$" :question/worked-solution "We replace $t$ with $6$ in the given expression, and simplify as much as possible:\n\n$$\n\\begin{aligned}\\sqrt[3]{8t+6} & = \\\\ \\sqrt[3]{8(6)+6} & = \\\\ \\sqrt[3]{48+6} & = \\\\ \\sqrt[3]{54} & = \\\\ \\sqrt[3]{27\\cdot 2} & = \\\\ \\sqrt[3]{27}\\cdot \\sqrt[3]{2} & = \\\\ \\sqrt[3]{{3}^{3}}\\cdot \\sqrt[3]{2} & = \\\\ 3\\sqrt[3]{2}\\end{aligned}\n$$"}]}
