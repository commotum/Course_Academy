#{[{:db/id #edb/ref 17592186475950 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aa24d74-d9dc-5a8e-9eda-f3a3016da541" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11z+9" :db/id #edb/ref 17592186475459} {:answer/id #uuid "8dcbb5f9-2e57-519d-9b79-c6eecd256576" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-17z+18" :db/id #edb/ref 17592186475656} {:answer/id #uuid "ab7b29d1-5012-5948-9f3a-7ef9d0fa006c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11z+18" :db/id #edb/ref 17592186475694} {:answer/id #uuid "e842cecc-85a1-5003-9253-2d9e20e7af70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-17z-6" :db/id #edb/ref 17592186475798} {:answer/id #uuid "f36aa5ba-bb68-557f-92dd-41193183f7ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7z+9" :db/id #edb/ref 17592186475815}] :answer-field/correct {:answer/id #uuid "8dcbb5f9-2e57-519d-9b79-c6eecd256576" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-17z+18" :db/id #edb/ref 17592186475656} :answer-field/id #uuid "6612aa6a-9bb2-5533-866f-7b58d5968c70" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186475864}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "98d2da5e-a56a-51ef-b628-e972a6b524aa" :question/math-academy-id "q-141957" :question/problem "$-5z-6(2z-3)=$" :question/worked-solution "Notice that the expression we need to subtract from $-5z$ must be expanded using the distributive law. \n\nSo first, let's write some big brackets around the expression in parentheses, keeping the minus sign *outside*.\n\n$$\n-5z-[6(2z-3)]\n$$\n\nNext, we expand the expression inside the brackets using the distributive law. This gives\n\n$$\n-5z-[12z-18].\n$$\n\nNow, we remove the brackets by distributing the negative sign. This gives\n\n$$\n-5z-12z+18.\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}-5z-12z+18 & = \\\\ (-5z-12z)+18 & = \\\\ -17z+18 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186475951 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dae3037-4575-5765-9479-a15a5d86b990" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5-7u" :db/id #edb/ref 17592186475531} {:answer/id #uuid "5a9d893f-3209-5732-a6d8-9ce794343443" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8+7u" :db/id #edb/ref 17592186475572} {:answer/id #uuid "73ca03a1-7934-590a-a077-2fd21093bf6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8-7u" :db/id #edb/ref 17592186475608} {:answer/id #uuid "79d9e989-2454-5618-910e-e1371e040f39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-7u" :db/id #edb/ref 17592186475618} {:answer/id #uuid "cb509127-6045-5ce5-9072-138713c10958" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+7u" :db/id #edb/ref 17592186475747}] :answer-field/correct {:answer/id #uuid "79d9e989-2454-5618-910e-e1371e040f39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-7u" :db/id #edb/ref 17592186475618} :answer-field/id #uuid "341ab2cc-5573-5b61-8445-9e89253684c0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186475844}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9aa821db-a963-5bfc-89f9-99a159ea39a0" :question/math-academy-id "q-144243" :question/problem "Simplify the expression $-3-(7u-5).$" :question/worked-solution "First, we remove the parentheses by distributing the negative sign. This gives\n\n$$\n-3-7u+5\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}-3-7u+5 & = \\\\ (-3+5)-7u & = \\\\ 2-7u & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186475964 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23b16e92-2292-5715-bb10-bc5a558ed8ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186475489} {:answer/id #uuid "7deb8e1b-88d7-53bb-bd62-7687e0cbc7b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186475627} {:answer/id #uuid "80dafac6-1744-54a5-91a9-aac2775ca26e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186475633} {:answer/id #uuid "9d7c0feb-906d-5c58-b538-182863203f26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186475675} {:answer/id #uuid "bba30883-38cf-5f77-94ed-e41a5f4310a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186475727}] :answer-field/correct {:answer/id #uuid "7deb8e1b-88d7-53bb-bd62-7687e0cbc7b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186475627} :answer-field/id #uuid "043c22a6-a8b9-531b-b9a8-8e3078e51e28" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186475829}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c3f87d4f-6893-5e8e-9c8f-8e34389c2e99" :question/math-academy-id "q-43337" :question/problem "$\\sqrt[3]{-1}=$" :question/worked-solution "First, notice that the number $-1$ is a perfect cube.\n\nSo, to determine the value of $\\sqrt[3]{-1},$ we express $-1$ as a perfect cube:\n\n$$\n\\begin{aligned}\\sqrt[3]{-1} & = \\\\ \\sqrt[3]{(-1)\\cdot (-1)\\cdot (-1)} & = \\\\ \\sqrt[3]{(-1)^{3}} & = \\\\ -1 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186475981 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f8a55e4-c42a-5a98-aa39-a2c1159e99f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13-8b" :db/id #edb/ref 17592186475482} {:answer/id #uuid "347cfb63-115f-55b3-9368-59edd66954c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4-8b" :db/id #edb/ref 17592186475513} {:answer/id #uuid "3e5e3e49-98cf-5d0d-bf3b-a666881820b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13+8b" :db/id #edb/ref 17592186475534} {:answer/id #uuid "ce97c6e3-987a-57f7-b0a7-2f6cdd65ed96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+8b" :db/id #edb/ref 17592186475752} {:answer/id #uuid "effb8580-755c-5546-b30d-ad7484380e66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-8b" :db/id #edb/ref 17592186475810}] :answer-field/correct {:answer/id #uuid "1f8a55e4-c42a-5a98-aa39-a2c1159e99f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13-8b" :db/id #edb/ref 17592186475482} :answer-field/id #uuid "3e868b29-0793-5cd6-9a3d-fe9a4f09f0db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186475849}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "effd2690-1ce3-5bfd-837f-fb52a891061c" :question/math-academy-id "q-144260" :question/problem "$7-2(4b-3)=$" :question/worked-solution "Notice that the expression we need to subtract from $7$ must be expanded using the distributive law. \n\nSo first, let's write some big brackets around the expression in parentheses, keeping the minus sign *outside*.\n\n$$\n7-[2(4b-3)]\n$$\n\nNext, we expand the expression inside the brackets using the distributive law. This gives\n\n$$\n7-[8b-6].\n$$\n\nNow, we remove the brackets by distributing the negative sign. This gives\n\n$$\n7-8b+6.\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}7-8b+6 & = \\\\ (7+6)-8b & = \\\\ 13-8b & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186475982 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf3d970e-04da-5aa1-a97a-e87cc67fb4ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186475753}] :answer-field/correct {:answer/id #uuid "cf3d970e-04da-5aa1-a97a-e87cc67fb4ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186475753} :answer-field/id #uuid "249a5df1-da20-50af-9054-d6d04854a01f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186475839} {:answer-field/choices [{:answer/id #uuid "86832dc0-4298-586a-8e43-de507470c150" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186475646}] :answer-field/correct {:answer/id #uuid "86832dc0-4298-586a-8e43-de507470c150" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186475646} :answer-field/id #uuid "284c3cde-a7c6-5c11-83e9-da9910a1d2bf" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186475841}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f10306d0-b077-5314-9baa-700a263e9595" :question/math-academy-id "q-171523" :question/problem "The expression $-a-(3a+1)$ can be written as{{field-1}}\n$a\\,-$\n{{field-2}}." :question/worked-solution "First, we remove the parentheses by distributing the negative sign. This gives\n\n$$\n-a-3a-1.\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}-a-3a-1 & = \\\\ (-a-3a)-1 & = \\\\ -4a-1 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186475983 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f328f54-0498-5e32-9f91-3d142c477a88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4-6y" :db/id #edb/ref 17592186475466} {:answer/id #uuid "2c4670ca-af66-5cff-8304-47b8087b3f65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-22+6y" :db/id #edb/ref 17592186475504} {:answer/id #uuid "38ea4a4a-e8be-54c5-8c53-25387149ad6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4+6y" :db/id #edb/ref 17592186475520} {:answer/id #uuid "790b1852-965b-57cd-a3f9-8847540987e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-22-6y" :db/id #edb/ref 17592186475617} {:answer/id #uuid "acb188d1-c611-5b5e-8ea6-c4fb3aa8a424" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10-2y" :db/id #edb/ref 17592186475696}] :answer-field/correct {:answer/id #uuid "790b1852-965b-57cd-a3f9-8847540987e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-22-6y" :db/id #edb/ref 17592186475617} :answer-field/id #uuid "05baa02c-244c-5f4c-8c25-2580b8b26401" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186475831}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fbe26239-f4a5-5ec1-a88c-e3440a20795a" :question/math-academy-id "q-144252" :question/problem "$-13-3(2y+3)=$" :question/worked-solution "Notice that the expression we need to subtract from $-13$ must be expanded using the distributive law. \n\nSo first, let's write some big brackets around the expression in parentheses, keeping the minus sign *outside*.\n\n$$\n-13-[3(2y+3)]\n$$\n\nNext, we expand the expression inside the brackets using the distributive law. This gives\n\n$$\n-13-[6y+9].\n$$\n\nNow, we remove the brackets by distributing the negative sign. This gives\n\n$$\n-13-6y-9.\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}-13-6y-9 & = \\\\ (-13-9)-6y & = \\\\ -22-6y & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186476872 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aab9ce2-cbfa-5ebd-884c-a4950519a3af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6{w}^{9}+3{w}^{4}" :db/id #edb/ref 17592186476220} {:answer/id #uuid "5955a692-dbb2-5272-9aae-c8989adf2445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{w}^{9}-12{w}^{4}" :db/id #edb/ref 17592186476395} {:answer/id #uuid "7acfb0db-7152-596b-b1f2-b0ecd6821403" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{w}^{9}+9{w}^{4}" :db/id #edb/ref 17592186476476} {:answer/id #uuid "b04507f4-90d0-57e4-b9da-e0e36f66a3bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{w}^{9}-3{w}^{4}" :db/id #edb/ref 17592186476597} {:answer/id #uuid "d6de6484-f44f-5b5a-8c53-cdd81f663e09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6{w}^{9}+6{w}^{4}" :db/id #edb/ref 17592186476686}] :answer-field/correct {:answer/id #uuid "d6de6484-f44f-5b5a-8c53-cdd81f663e09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6{w}^{9}+6{w}^{4}" :db/id #edb/ref 17592186476686} :answer-field/id #uuid "003b4804-d14f-578e-8656-2a90c49c95cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186476760}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "034e440a-6b0a-5b2a-b439-84edad47d0e5" :question/math-academy-id "q-44706" :question/problem "$-6{w}^{9}+9{w}^{4}-3{w}^{4}=$" :question/worked-solution "Here, $9{w}^{4}$ and $-3{w}^{4}$ are like terms, so we group them, and then we add or subtract the coefficients.\n\n$$\n\\begin{aligned}-6{w}^{9}+9{w}^{4}-3{w}^{4} & = \\\\ -6{w}^{9}+(9{w}^{4}-3{w}^{4}) & = \\\\ -6{w}^{9}+(9-3){w}^{4} & = \\\\ -6{w}^{9}+6{w}^{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186476933 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "285a1466-9430-5687-bbcf-29121fab75da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}{x}^{2}+\\frac{4}{3}x" :db/id #edb/ref 17592186476295} {:answer/id #uuid "32dae763-b632-5eb9-a345-87aa4c02570b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}{x}^{2}+\\frac{15}{3}x" :db/id #edb/ref 17592186476315} {:answer/id #uuid "637465f4-79f7-5282-b818-a1b5a378c60b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{2}{x}^{2}+\\frac{4}{3}x" :db/id #edb/ref 17592186476427} {:answer/id #uuid "8cad9be0-f5bf-5d8e-b89a-2f174676d7aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{13}{2}{x}^{2}+\\frac{15}{3}x" :db/id #edb/ref 17592186476505} {:answer/id #uuid "b90be755-ae0b-5fa0-9b25-e6f73288c4fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}{x}^{2}+\\frac{4}{3}x" :db/id #edb/ref 17592186476622}] :answer-field/correct {:answer/id #uuid "285a1466-9430-5687-bbcf-29121fab75da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}{x}^{2}+\\frac{4}{3}x" :db/id #edb/ref 17592186476295} :answer-field/id #uuid "becea34b-bc1c-530f-ba36-e7d6968724eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186476840}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a820117b-ea24-5225-acf7-be7cc5fe0269" :question/math-academy-id "q-31028" :question/problem "Simplify the polynomial $-\\frac{5x}{3}+4{x}^{2}-\\frac{5{x}^{2}}{2}+3x.$" :question/worked-solution "Here,   $4{x}^{2}$ and $-\\frac{5{x}^{2}}{2}$ are like terms, and the $-\\frac{5x}{3}$ and $3x$ are also like terms. So, we group and add each pair of  like terms separately:\n\n$$\n\\begin{aligned}-\\frac{5x}{3}+4{x}^{2}-\\frac{5{x}^{2}}{2}+3x & = \\\\ (4{x}^{2}-\\frac{5{x}^{2}}{2})+(3x-\\frac{5x}{3}) & = \\\\ (4-\\frac{5}{2}){x}^{2}+(3-\\frac{5}{3})x & = \\\\ \\frac{3}{2}{x}^{2}+\\frac{4}{3}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186476970 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70812f52-10fa-52ae-91c6-d4dd671618ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{c}^{4}-3{c}^{2}+7" :db/id #edb/ref 17592186476456} {:answer/id #uuid "826fb077-82c4-5621-837d-2593cdb45648" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8{c}^{4}-4{c}^{2}+7" :db/id #edb/ref 17592186476489} {:answer/id #uuid "b1a6a4d0-b51f-514f-8f75-68f248162e57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{c}^{4}-3{c}^{2}+7" :db/id #edb/ref 17592186476600} {:answer/id #uuid "d02eef8e-525a-5a6e-89f5-c93dfac2e187" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6{c}^{4}-2{c}^{2}+7" :db/id #edb/ref 17592186476668} {:answer/id #uuid "fe6312fb-f2a1-5eee-88d0-3c05acdff2da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6{c}^{4}-{c}^{2}+7" :db/id #edb/ref 17592186476758}] :answer-field/correct {:answer/id #uuid "d02eef8e-525a-5a6e-89f5-c93dfac2e187" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6{c}^{4}-2{c}^{2}+7" :db/id #edb/ref 17592186476668} :answer-field/id #uuid "2d9b3bc2-9c69-5479-8c20-ed590e77d8ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186476774}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e4e12c2d-18b6-5dcb-8703-4bb161f999a5" :question/math-academy-id "q-110820" :question/problem "The standard form of the polynomial $3{c}^{2}-5{c}^{2}-6{c}^{4}+7$ is" :question/worked-solution "First, we collect like terms:\n\n$$\n\\begin{aligned}3{c}^{2}-5{c}^{2}-6{c}^{4}+7 & = \\\\ (3{c}^{2}-5{c}^{2})-6{c}^{4}+7 & = \\\\ (3-5){c}^{2}-6{c}^{4}+7 & = \\\\ -2{c}^{2}-6{c}^{4}+7\\end{aligned}\n$$\n\nNow, we need to express our polynomial in standard form.\n\nThe highest exponent term is $-6{c}^{4},$ followed by $-2{c}^{2},$ and finally $7.$\n\nSo, the standard form of the polynomial is:\n\n$$\n-6{c}^{4}-2{c}^{2}+7\n$$"}] [{:db/id #edb/ref 17592186478382 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "805c3fae-b4ea-5501-aafe-149f2da5f17a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\text{ }048" :db/id #edb/ref 17592186478003} {:answer/id #uuid "a372df46-54e9-569b-9131-04fb7cdea086" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186478050} {:answer/id #uuid "a923561e-b076-5bd7-9a63-c5488c5c282c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186478060} {:answer/id #uuid "bbde2b35-d5f5-5292-96a2-fc41eecc88a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186478101} {:answer/id #uuid "c8388fbb-2786-5dd8-9edf-64fab71802a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186478131}] :answer-field/correct {:answer/id #uuid "a372df46-54e9-569b-9131-04fb7cdea086" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186478050} :answer-field/id #uuid "336b5468-1d04-5f97-aabf-5464e0cd4df9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186478267}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "227dea09-ff86-55c7-8478-5e0e49c51311" :question/math-academy-id "q-43544" :question/problem "Find $\\sqrt[3]{2}\\cdot \\sqrt{8}\\cdot \\sqrt[3]{2}\\cdot \\sqrt{8}\\cdot \\sqrt[3]{2}$." :question/worked-solution "We have\n\n$$\n\\begin{aligned}\\sqrt[3]{2}\\cdot \\sqrt{8}\\cdot \\sqrt[3]{2}\\cdot \\sqrt{8}\\cdot \\sqrt[3]{2} & = \\\\ (\\sqrt[3]{2}\\cdot \\sqrt[3]{2}\\cdot \\sqrt[3]{2})(\\sqrt{8}\\cdot \\sqrt{8}) & = \\\\ {(\\sqrt[3]{2})}^{3}{(\\sqrt{8})}^{2} & = \\\\ 2\\cdot 8 & = \\\\ 16 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479059 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "287b8b8b-a357-530b-a29a-b4409ba9867a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{24}" :db/id #edb/ref 17592186478620}] :answer-field/correct {:answer/id #uuid "287b8b8b-a357-530b-a29a-b4409ba9867a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{24}" :db/id #edb/ref 17592186478620} :answer-field/id #uuid "78bc0c44-a6c7-5cb4-b731-9e72f7a43817" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479005}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0d504829-eef7-5492-8d82-0cc4f8d13b08" :question/math-academy-id "q-176475" :question/problem "Expressed as a fraction in lowest terms, $\\frac{5}{2}÷(7+5)=${{field-1}}." :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, we perform the operation inside the parentheses:\n\n$$\n\\begin{aligned}\\frac{5}{2}÷(7+5) & = \\\\ \\frac{5}{2}÷12\\end{aligned}\n$$\n\nFinally, we divide:\n\n$$\n\\begin{aligned}\\frac{5}{2}÷12 & = \\\\ \\frac{5}{2}÷\\frac{12}{1} & = \\\\ \\frac{5}{2}\\times \\frac{1}{12} & = \\\\ \\frac{5\\times 1}{2\\times 12} & = \\\\ \\frac{5}{24}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479062 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b37aad9-8d7b-5f08-b01a-3e1380d7558a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186478717} {:answer/id #uuid "8258126f-2d8a-570d-985d-7fa3deb42dfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186478757} {:answer/id #uuid "9f3fbbd3-ee5b-5228-ac94-895b7f45ee77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186478818} {:answer/id #uuid "f0fb9f75-4bee-548e-9ef2-b33485b0e693" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186478935} {:answer/id #uuid "f7c8c01e-55d8-55d3-bf0a-de95013d08dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186478946}] :answer-field/correct {:answer/id #uuid "6b37aad9-8d7b-5f08-b01a-3e1380d7558a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186478717} :answer-field/id #uuid "3538e5cf-6fb8-5a5e-a234-cabbb29eccf2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186478978}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1113da48-16db-5f6c-b647-7ec659a2ab4d" :question/math-academy-id "q-186019" :question/problem "If $w=-6,$ then $-4w-15=$" :question/worked-solution "Replacing $w$ with $-6$ in the expression, we get\n\n$$\n\\begin{aligned}-4w-15 & = \\\\ -4(-6)-15 & = \\\\ 24-15 & = \\\\ 9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479063 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0ce97a1-5e79-58a4-9cd7-c578898dcd66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.3" :db/id #edb/ref 17592186478934}] :answer-field/correct {:answer/id #uuid "f0ce97a1-5e79-58a4-9cd7-c578898dcd66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.3" :db/id #edb/ref 17592186478934} :answer-field/id #uuid "07818ad5-3003-5a61-89f8-d143f34c577f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186478961}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "16c2fdd2-5848-54fb-8203-57bceb610cf0" :question/math-academy-id "q-175317" :question/problem "$(0.6+2)÷2=${{field-1}}" :question/worked-solution "First, we perform the operation inside the parentheses:\n\n$$\n\\begin{aligned}(0.6+2)÷2 & = \\\\ 2.6÷2\\end{aligned}\n$$\n\nFinally, we multiply and divide, from left to right:\n\n$$\n\\begin{aligned}2.6÷2 & =1.3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479068 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d52de4c-5e14-522e-ace7-29624b919a04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186478629}] :answer-field/correct {:answer/id #uuid "2d52de4c-5e14-522e-ace7-29624b919a04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186478629} :answer-field/id #uuid "e0c1c5bf-53f5-5527-a2d2-65ab11db2807" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479046}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1eb0410f-52e0-5fe3-aa6d-2cf67e29e0a3" :question/math-academy-id "q-180270" :question/problem "If $p=2$ and $q=-1,$ then $-p+3q=${{field-1}}." :question/worked-solution "Replacing $p$ with $2$ and $q$ with $-1,$ we get\n\n$$\n\\begin{aligned}-p+3q & = \\\\ -(2)+3(-1) & = \\\\ -2-3 & = \\\\ -5 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479069 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "baa78b79-9595-528a-8f0c-86d24b469c78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186478861}] :answer-field/correct {:answer/id #uuid "baa78b79-9595-528a-8f0c-86d24b469c78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186478861} :answer-field/id #uuid "d08a94ad-a59e-5ab7-8898-71db1e4d9b6e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479041}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2175ddd7-b5c7-5bcd-b639-d4f01939487a" :question/math-academy-id "q-180211" :question/problem "If $h=4,$ then $\\frac{3h}{2}+9=${{field-1}}." :question/worked-solution "Replacing $h$ with $4$ in the expression, we get\n\n$$\n\\begin{aligned}\\frac{3h}{2}+9 & = \\\\ \\frac{3(4)}{2}+9 & = \\\\ \\frac{12}{2}+9 & = \\\\ 6+9 & = \\\\ 15 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479078 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dcc6f5fd-050d-5fbb-88f7-e841559dfb66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186478906}] :answer-field/correct {:answer/id #uuid "dcc6f5fd-050d-5fbb-88f7-e841559dfb66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186478906} :answer-field/id #uuid "af98e227-3993-52d7-9ae5-2d273b174754" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479027}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "32e41319-b064-5c4a-91f7-13675a0d7fcb" :question/math-academy-id "q-174388" :question/problem "Expressed as a fraction in lowest terms, $\\frac{4}{3}÷2-\\frac{1}{3}=${{field-1}}." :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, we divide:\n\n$$\n\\begin{aligned}\\frac{4}{3}÷2-\\frac{1}{3} & = \\\\ (\\frac{4}{3}÷\\frac{2}{1})-\\frac{1}{3} & = \\\\ (\\frac{4}{3}\\times \\frac{1}{2})-\\frac{1}{3} & = \\\\ (\\frac{4\\times 1}{3\\times 2})-\\frac{1}{3} & = \\\\ \\frac{4}{6}-\\frac{1}{3}\\end{aligned}\n$$\n\nFinally, we subtract:\n\n$$\n\\begin{aligned}\\frac{4}{6}-\\frac{1}{3} & = \\\\ \\frac{2}{3}-\\frac{1}{3} & = \\\\ \\frac{2-1}{3} & = \\\\ \\frac{1}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479079 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b07c6de-b540-57b6-96a7-08b3703af820" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{2}" :db/id #edb/ref 17592186478644} {:answer/id #uuid "654dcaef-b3ac-5aa3-a431-ca34193d3cdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{21}" :db/id #edb/ref 17592186478707} {:answer/id #uuid "6edf906e-43f0-5d16-aa0d-11200a173867" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-42" :db/id #edb/ref 17592186478725} {:answer/id #uuid "7bd7035f-0535-5d1b-baf7-fe650baf14c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186478743} {:answer/id #uuid "f1cde2af-e93f-51ce-b249-b3c8098d9356" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{4}" :db/id #edb/ref 17592186478936}] :answer-field/correct {:answer/id #uuid "7bd7035f-0535-5d1b-baf7-fe650baf14c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186478743} :answer-field/id #uuid "6483320d-efd6-5033-ac44-8b3c7ef96b4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479000}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "35969ec8-7388-5a9c-af50-84fbe5444368" :question/math-academy-id "q-75812" :question/problem "$\\frac{7}{2}\\times 3÷\\frac{1}{4}=$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nWe multiply and divide, from left to right:\n\n$$\n\\begin{aligned}\\frac{7}{2}\\times 3÷\\frac{1}{4} & = \\\\ (\\frac{7}{2}\\times 3)÷\\frac{1}{4} & = \\\\ (\\frac{7}{2}\\times \\frac{3}{1})÷\\frac{1}{4} & = \\\\ \\frac{7\\times 3}{2\\times 1}÷\\frac{1}{4} & = \\\\ \\frac{21}{2}÷\\frac{1}{4} & = \\\\ \\frac{21}{2}\\times \\frac{4}{1} & = \\\\ \\frac{21\\times 4}{2\\times 1} & = \\\\ \\frac{84}{2} & = \\\\ 42\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479081 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "211095ff-43cb-58b6-aefd-f9eef6c48868" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186478610}] :answer-field/correct {:answer/id #uuid "211095ff-43cb-58b6-aefd-f9eef6c48868" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186478610} :answer-field/id #uuid "4a444ff8-f2c0-5ca6-95a6-e2911034fd96" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186478988}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3ba0af4d-b531-5e58-b782-4b7a32460438" :question/math-academy-id "q-180261" :question/problem "If $x=2,$ then $12-4(3x-4)=${{field-1}}." :question/worked-solution "We replace $x$ with $2$ in the expression and evaluate the parentheses first:\n\n$$\n\\begin{aligned}12-4(3x-4) & = \\\\ 12-4(3\\cdot 2-4) & = \\\\ 12-4(6-4) & = \\\\ 12-4(2) & = \\\\ 12-8 & = \\\\ 4 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479096 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d396ebfa-2351-59b3-9a9a-85e9a027b858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-13" :db/id #edb/ref 17592186478895}] :answer-field/correct {:answer/id #uuid "d396ebfa-2351-59b3-9a9a-85e9a027b858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-13" :db/id #edb/ref 17592186478895} :answer-field/id #uuid "a6b9cf49-c2bb-5ce4-941d-b3540c075320" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479024}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "720361bc-07a5-589b-85d2-04870e7c2310" :question/math-academy-id "q-176386" :question/problem "Expressed as an integer, $8÷(-\\frac{4}{5})-3=${{field-1}}" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, we divide:\n\n$$\n\\begin{aligned}8÷(-\\frac{4}{5})-3 & = \\\\ (8÷(-\\frac{4}{5}))-3 & = \\\\ (\\frac{8}{1}\\times (-\\frac{5}{4}))-3 & = \\\\ -\\frac{8\\times 5}{1\\times 4}-3 & = \\\\ -\\frac{40}{4}-3 & = \\\\ -10-3\\end{aligned}\n$$\n\nFinally, we subtract:\n\n$$\n\\begin{aligned}-10-3 & =-13\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479109 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b90ecccc-4503-5760-b2d3-96866aca4524" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186478858}] :answer-field/correct {:answer/id #uuid "b90ecccc-4503-5760-b2d3-96866aca4524" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186478858} :answer-field/id #uuid "1639e847-f891-584d-90ce-1361c0620ec9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186478966}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9a5e0230-7894-51f3-afd6-6cc279d87228" :question/math-academy-id "q-180267" :question/problem "If $y=-2,$ then $3-4(3-2y)=${{field-1}}." :question/worked-solution "We replace $y$ with $-2$ in the expression and evaluate the parentheses first:\n\n$$\n\\begin{aligned}3-4(3-2y) & = \\\\ 3-4(3-2(-2)) & = \\\\ 3-4(3+4) & = \\\\ 3-4(7) & = \\\\ 3-28 & = \\\\ -25 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479111 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41f7a202-2c88-5780-a174-3331ee2546d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{5}" :db/id #edb/ref 17592186478649} {:answer/id #uuid "5b555cc0-0ed8-506e-80ce-b3b4bdb41696" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186478686} {:answer/id #uuid "72872caa-7826-5d33-9478-418fcf7b7bc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{10}" :db/id #edb/ref 17592186478727} {:answer/id #uuid "968707ff-2d1c-5885-9528-97f8f79a7377" :answer/type {:db/id #edb/ref 1759