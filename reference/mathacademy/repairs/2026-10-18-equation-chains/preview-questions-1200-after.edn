db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186550722} :answer-field/id #uuid "2955e3b5-359a-52c1-ba32-374efd6a1771" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186551088}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aec99370-575e-52b4-9e36-bb43c957f2bf" :question/math-academy-id "q-266852" :question/problem "$\\operatorname{tan}⁡{45}^{∘}+\\operatorname{tan}⁡{0}^{∘}-\\operatorname{sin}⁡{90}^{∘}=${{field-1}}" :question/worked-solution "The angles of ${0}^{∘},$ ${45}^{∘},$ and ${90}^{∘}$ are special, and their trigonometric ratios have values\n\n$$\n\\operatorname{sin}⁡{90}^{∘}=1,\\,\\operatorname{tan}⁡{0}^{∘}=0,\\,\\operatorname{tan}⁡{45}^{∘}=1.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡{45}^{∘}+\\operatorname{tan}⁡{0}^{∘}-\\operatorname{sin}⁡{90}^{∘} &= 1+0-1 \\\\ &= 0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186551334 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0826b2a3-5ac7-5dcc-ac1d-bf03465aeb17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3x" :db/id #edb/ref 17592186550391} {:answer/id #uuid "27bed5b6-f163-5dd7-8925-f268bc816087" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x" :db/id #edb/ref 17592186550465} {:answer/id #uuid "8ab00684-1404-54cc-8b78-5a8eed09285d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x" :db/id #edb/ref 17592186550720} {:answer/id #uuid "9556c8b9-a5b5-559b-8d5e-07a1166eca58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}" :db/id #edb/ref 17592186550742} {:answer/id #uuid "af753c10-bf82-5a32-9969-0aabdfdf7f04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186550846}