igned}\\frac{4{r}^{2}}{\\sqrt{2r-1}-1} &= \\frac{4{r}^{2}}{\\sqrt{2r-1}-1}\\cdot \\frac{\\sqrt{2r-1}+1}{\\sqrt{2r-1}+1} \\\\ &= \\frac{4{r}^{2}(\\sqrt{2r-1}+1)}{(\\sqrt{2r-1}-1)(\\sqrt{2r-1}+1)} \\\\ &= \\frac{4{r}^{2}(\\sqrt{2r-1}+1)}{(\\sqrt{2r-1})^{2}-{1}^{2}} \\\\ &= \\frac{4{r}^{2}(\\sqrt{2r-1}+1)}{2r-1-1} \\\\ &= \\frac{4{r}^{2}(\\sqrt{2r-1}+1)}{2r-2} \\\\ &= \\frac{2{r}^{2}(\\sqrt{2r-1}+1)}{r-1}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186570003 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e10bf21-a085-5225-9e50-b8399bd50bc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{s}^{4}(s+2)(s-2)" :db/id #edb/ref 17592186569508} {:answer/id #uuid "6c382d23-03d9-5fba-94e6-efeccbf637e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{s}^{4}(s-2)^{2}" :db/id #edb/ref 17592186569615} {:answer/id #uuid "96a29d2f-4d5d-549b-80ab-68c608300205" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{s}^{5}(s-4)" :db/id #edb/ref 17592186569681} {:answer/id #uuid "be84eb82-1c77-5ed7-8435-bb77d4b7d622" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{s}^{2}(s+2)^{2}(s-2)^{2}" :db/id #edb/ref 17592186569747} {:answer/id #uuid "fe095cce-7414-588e-8038-6dedc80d8543" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{s}^{3}(s-2)^{2}(s+2)" :db/id #edb/ref 17592186569843}] :answer-field/correct {:answer/id #uuid "6c382d23-03d9-5fba-94e6-efeccbf637e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{s}^{4}(s-2)^{2}" :db/id #edb/ref 17592186569615} :answer-field/id #uuid "97ab82ae-a070-54e1-a8a1-4a953ee8477c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569901}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7cf33662-4ad6-5aa7-8431-3b990d895f49" :question/math-academy-id "q-69844" :question/problem "Factor the expression ${s}^{6}-4{s}^{5}+4{s}^{4}.$" :question/worked-solution "First, notice that all of the terms have a common factor of ${s}^{4}.$ To simplify the computation, we can factor out the ${s}^{4},$ as follows:\n\n$$\n\\begin{aligned}{s}^{6}-4{s}^{5}+4{s}^{4} & ={s}^{4}({s}^{2}-4s+4)\\end{aligned}\n$$\n\nThe expression ${s}^{2}-4s+4$ is a perfect square trinomial that can be factored as follows:\n\n$$\n\\begin{aligned}{s}^{4}({s}^{2}-4s+4) &= {s}^{4}({s}^{2}-4s+{2}^{2}) \\\\ &= {s}^{4}({s}^{2}-2\\cdot 2\\cdot s+{2}^{2}) \\\\ &= {s}^{4}(s-2)^{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186570007 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20d26f86-2dc9-5463-bba9-a9c64837cfba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3w}+\\sqrt{2}}{w-2}" :db/id #edb/ref 17592186569489} {:answer/id #uuid "2cc75ee0-7521-5750-8f0f-3f1a36938006" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{w+2}" :db/id #edb/ref 17592186569506} {:answer/id #uuid "4188c38e-2d83-5519-96c9-a6eb79f16eb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3w}}{3w-2}" :db/id #edb/ref 17592186569533} {:answer/id #uuid "4f30b0d7-48f8-5ace-8f0f-4568d9df43f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3w}-\\sqrt{2}}{3w-2}" :db/id #edb/ref 17592186569557} {:answer/id #uuid "f1dc7873-f819-53f3-a6f8-115519757005" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3w}-\\sqrt{2}}{3w-4}" :db/id #edb/ref 17592186569825}] :answer-field/correct {:answer/id #uuid "4f30b0d7-48f8-5ace-8f0f-4568d9df43f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3w}-\\sqrt{2}}{3w-2}" :db/id #edb/ref 17592186569557} :answer-field/id #uuid "0f562f05-e64d-5189-84cb-9fa3a27158ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569852}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "87b6f4b7-9188-5e3b-b5e9-cf42f85068fb" :question/math-academy-id "q-85406" :question/problem "Rationalize the denominator of $\\frac{1}{\\sqrt{3w}+\\sqrt{2}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{3w}-\\sqrt{2}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{3w}-\\sqrt{2},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{1}{\\sqrt{3w}+\\sqrt{2}} &= \\frac{1}{\\sqrt{3w}+\\sqrt{2}}\\cdot \\frac{\\sqrt{3w}-\\sqrt{2}}{\\sqrt{3w}-\\sqrt{2}} \\\\ &= \\frac{\\sqrt{3w}-\\sqrt{2})}{(\\sqrt{3w}+\\sqrt{2})(\\sqrt{3w}-\\sqrt{2})} \\\\ &= \\frac{\\sqrt{3w}-\\sqrt{2}}{(\\sqrt{3w})^{2}-(\\sqrt{2})^{2}} \\\\ &= \\frac{\\sqrt{3w}-\\sqrt{2}}{3w-2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186570008 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1210df57-e67c-591e-853e-f366af5fe6a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{a}+2}{a-4}" :db/id #edb/ref 17592186569470} {:answer/id #uuid "3ff4e421-7a8e-5dab-94d7-0ab518f1e766" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{a}+2}{a+2}" :db/id #edb/ref 17592186569528} {:answer/id #uuid "4d91c8dd-a38c-5dee-bd68-0b344a9f5c8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{a}+4}{a-4}" :db/id #edb/ref 17592186569551} {:answer/id #uuid "d216d8db-12cb-5b4f-8606-256ce552eb03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{a}-2}{a+4}" :db/id #edb/ref 17592186569772} {:answer/id #uuid "ffb17e41-8330-5e0e-b46c-af5fb670df17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{a}+2}{a-2}" :db/id #edb/ref 17592186569844}] :answer-field/correct {:answer/id #uuid "1210df57-e67c-591e-853e-f366af5fe6a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{a}+2}{a-4}" :db/id #edb/ref 17592186569470} :answer-field/id #uuid "e334166a-4c51-5693-8a67-91594d7b8111" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569939}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "899489ed-bce7-5e1a-a61e-2e188dc20acb" :question/math-academy-id "q-85320" :question/problem "Rationalize the denominator of $\\frac{1}{\\sqrt{a}-2}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{a}+2.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{a}+2,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{1}{\\sqrt{a}-2} &= \\frac{1}{\\sqrt{a}-2}\\cdot \\frac{\\sqrt{a}+2}{\\sqrt{a}+2} \\\\ &= \\frac{\\sqrt{a}+2}{(\\sqrt{a}-2)(\\sqrt{a}+2)} \\\\ &= \\frac{\\sqrt{a}+2}{(\\sqrt{a})^{2}-{2}^{2}} \\\\ &= \\frac{\\sqrt{a}+2}{a-4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186570014 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f1bbe86-ce5f-55c6-8bed-f62f18b202e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{t}+\\sqrt{t-2}}{t}" :db/id #edb/ref 17592186569510} {:answer/id #uuid "4a192ac0-05c0-5288-be68-d3263570531f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(\\sqrt{t}+\\sqrt{t-2})}{t}" :db/id #edb/ref 17592186569543} {:answer/id #uuid "511af3b