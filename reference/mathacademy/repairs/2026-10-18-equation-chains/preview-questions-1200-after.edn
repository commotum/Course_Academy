nd{aligned}\n$$"} {:db/id #edb/ref 17592186570018 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "053449de-1640-59ff-8add-5d09a15ab3b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(1+\\sqrt{1-t})" :db/id #edb/ref 17592186569452} {:answer/id #uuid "4f7f5fd8-4a4f-5258-bc4b-8b18611c412d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(1+\\sqrt{1-t})" :db/id #edb/ref 17592186569559} {:answer/id #uuid "90e3da05-aacf-5f13-859e-cd646558384f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+\\sqrt{1-t}}{3}" :db/id #edb/ref 17592186569672} {:answer/id #uuid "c4784f20-700b-5193-9d79-5c5d10119b44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3t(1+\\sqrt{1-t})}{2}" :db/id #edb/ref 17592186569752} {:answer/id #uuid "dad32430-bd0b-52bf-9c2e-17412e09f115" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+\\sqrt{1-t}}{2}" :db/id #edb/ref 17592186569789}] :answer-field/correct {:answer/id #uuid "4f7f5fd8-4a4f-5258-bc4b-8b18611c412d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(1+\\sqrt{1-t})" :db/id #edb/ref 17592186569559} :answer-field/id #uuid "cc06a8d8-50aa-5640-bc51-88b6bf88a0d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569927}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ad79abb9-c428-5a43-aa85-5dde8ceb1da4" :question/math-academy-id "q-111086" :question/problem "Rationalize the denominator of $\\frac{3t}{1-\\sqrt{1-t}}.$" :question/worked-solution "First, note that the denominator's conjugate is $1+\\sqrt{1-t}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $1+\\sqrt{1-t},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{3t}{1-\\sqrt{1-t}} &= \\frac{3t}{1-\\sqrt{1-t}}\\cdot \\frac{1+\\sqrt{1-t}}{1+\\sqrt{1-t}} \\\\ &= \\frac{3t(1+\\sqrt{1-t})}{(1-\\sqrt{1-t})(1+\\sqrt{1-t})} \\\\ &= \\frac{3t(1+\\sqrt{1-t})}{{1}^{2}-(\\sqrt{1-t})^{2}} \\\\ &= \\frac{3t(1+\\sqrt{1-t})}{1-(1-t)} \\\\ &= \\frac{3\\cancel{t}(1+\\sqrt{1-t})}{\\cancel{t}} \\\\ &= 3(1+\\sqrt{1-t})\\end{aligned}\n$$"} {:db/id #edb/ref 17592186570024 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12e23d40-d227-5424-b5b7-586c63816d72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{3}(3n+4)^{2}" :db/id #edb/ref 17592186569473} {:answer/id #uuid "2fd4fa4b-4269-5a19-9696-33db33bf7069" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{3}(3n-7)^{2}" :db/id #edb/ref 17592186569511} {:answer/id #uuid "4eae722a-276d-56a3-8d3f-0f4ca15c0011" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{2}(2{n}^{2}-14)(n+2)" :db/id #edb/ref 17592186569555} {:answer/id #uuid "a2f6c753-5968-5e31-b594-ba31ba82d2aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{3}(3n-4)(n+7)" :db/id #edb/ref 17592186569704} {:answer/id #uuid "c7f338ee-1cf8-53b5-9adf-f59a8579be4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{2}(n-4)(3n+7)" :db/id #edb/ref 17592186569762}] :answer-field/correct {:answer/id #uuid "a2f6c753-5968-5e31-b594-ba31ba82d2aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{3}(3n-4)(n+7)" :db/id #edb/ref 17592186569704} :answer-field/id #uuid "60e37793-57d8-5148-aa95-28701d621f67" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569884}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cfe388a1-fc00-503a-b10d-218d6be786a1" :question/math-academy-id "q-44531" :question/problem "Factor $3{n}^{5}+17{n}^{4}-28{n}^{3}.$" :question/worked-solution "Note that all of the terms have a common factor of ${n}^{3}.$ To simplify the computation, we can factor out the ${n}^{3},$ as follows:\n\n$$\n\\begin{aligned}3{n}^{5}+17{n}^{4}-28{n}^{3} & ={n}^{3}(3{n}^{2}+17n-28)\\end{aligned}\n$$\n\nNow, we factor the polynomial $3{n}^{2}+17n-28,$ as follows:\n\n$$\n\\begin{aligned}{n}^{3}(3{n}^{2}+17n-28) &= {n}^{3}((3{n}^{2}-4n)+(21n-28)) \\\\ &= {n}^{3}((3n-4)n+(3n-4)7) \\\\ &= {n}^{3}(3n-4)(n+7)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186570025 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "577f1978-28ee-500b-afa8-1a8ac4bd93cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{x-2}-\\sqrt{x-3}" :db/id #edb/ref 17592186569571} {:answer/id #uuid "5b8e10bd-69c0-5e63-b024-1ff745bea904" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\sqrt{x-2}+3\\sqrt{x-3}" :db/id #edb/ref 17592186569577} {:answer/id #uuid "a18fb80d-85d6-5638-abcc-79aac05f2512" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{x-2}-3\\sqrt{x-3}" :db/id #edb/ref 17592186569700} {:answer/id #uuid "ecc80fb0-df28-5c6d-b00a-f863b6c4153f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(\\sqrt{x-2}+\\sqrt{x-3})" :db/id #edb/ref 17592186569817} {:answer/id #uuid "f61a4d96-d1b8-552e-b8b3-6cd378a8add8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(\\sqrt{x-3}+\\sqrt{x-2})" :db/id #edb/ref 17592186569828}] :answer-field/correct {:answer/id #uuid "a18fb80d-85d6-5638-abcc-79aac05f2512" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{x-2}-3\\sqrt{x-3}" :db/id #edb/ref 17592186569700} :answer-field/id #uuid "f4bcca3d-b352-5572-98c7-6dddf7325a1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569949}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d0a87847-eb14-5299-88a2-d7b26adced93" :question/math-academy-id "q-296038" :question/problem "Rationalize the denominator of $\\frac{3}{\\sqrt{x-3}+\\sqrt{x-2}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{x-3}-\\sqrt{x-2}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{x-3}-\\sqrt{x-2},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{3}{\\sqrt{x-3}+\\sqrt{x-2}} &= \\frac{3}{\\sqrt{x-3}+\\sqrt{x-2}}\\cdot \\frac{\\sqrt{x-3}-\\sqrt{x-2}}{\\sqrt{x-3}-\\sqrt{x-2}} \\\\ &= \\frac{3(\\sqrt{x-3}-\\sqrt{x-2})}{(\\sqrt{x-3}+\\sqrt{x-2})(\\sqrt{x-3}-\\sqrt{x-2})} \\\\ &= \\frac{3(\\sqrt{x-3}-\\sqrt{x-2})}{(\\sqrt{x-3})^{2}-(\\sqrt{x-2})^{2}} \\\\ &= \\frac{3(\\sqrt{x-3}-\\sqrt{x-2})}{x-3-(x-2)} \\\\ &= \\frac{3(\\sqrt{x-3}-\\sqrt{x-2})}{-1} \\\\ &= 3\\sqrt{x-2}-3\\sqrt{x-3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186570031 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07490dcd-1d48-5d43-b184-f74901680c80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{t(\\sqrt{t}-2)}{{t}^{2}-4}" :db/id #edb/ref 17592186569457} {:answer/id #uuid "3b01c92b-0e73-5e47-985c-a0f88f58ee99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{t}^{2}(\\sqrt{t}-2)}{{t}^{2}-4}" :db/id #edb/ref 17592186569524} {:answer/id #uuid "881aef92-cb00-57f1-a26c-bbcc579a0047" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{t(\\sqrt{t}-2)}{t-4}" :db/id #edb/ref 17592186569667} {:answer/id #uuid "9da858ca-2c7e-50ba-bdf0-dace67270f08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{t}^{2}(\\sqrt{t}-2)}{t-2}" :db/id #edb/ref 17592186569695} {:answer/id #uuid "bdcfb4fe-239c-5f02-aef3-366ababc7e75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{t(\\sqrt{t}-2)}{t-2}" :db/id #edb/ref 17592186569746}] :answer-field/correct {:answer/id #uuid "881aef92-cb00-57f1-a26c-bbcc579a0047" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{t(\\sqrt{t}-2)}{t-4}" :db/id #edb/ref 17592186569667} :answer-field/id #uuid "58d07260-1021-54bf-a6eb-cc2bfc3a0615" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569880}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dad03d87-b391-52d0-a812-6cdef4bf6aad" :question/math-academy-id "q-111070" :question/problem "Rationalize the denominator of $\\frac{t}{\\sqrt{t}+2}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{t}-2.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{t}-2,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{t}{\\sqrt{t}+2} &= \\frac{t}{\\sqrt{t}+2}\\cdot \\frac{\\sqrt{t}-2}{\\sqrt{t}-2} \\\\ &= \\frac{t(\\sqrt{t}-2)}{(\\sqrt{t}+2)(\\sqrt{t}-2)} \\\\ &= \\frac{t(\\sqrt{t}-2)}{(\\sqrt{t})^{2}-{2}^{2}} \\\\ &= \\frac{t(\\sqrt{t}-2)}{t-4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186570038 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e5aa24a-40ad-54c1-ac48-1556e82c4564" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+2\\sqrt{1-2w}}{w}" :db/id #edb/ref 17592186569586} {:answer/id #uuid "7f8c1f90-43e4-5654-845d-4116ec994488" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-\\sqrt{1-2w}}{w}" :db/id #edb/ref 17592186569655} {:answer/id #uuid "83afa538-5275-50c6-985d-07cbd1e01393" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2-2\\sqrt{1-2w}}{w}" :db/id #edb/ref 17592186569659} {:answer/id #uuid "c70653d1-4c66-5b9a-aaf5-222808226c0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-\\sqrt{1-2w}}{1+w}" :db/id #edb/ref 17592186569759} {:answer/id #uuid "d7ceee2c-5737-50d2-8e0b-837aedd0d714" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2+2\\sqrt{1-2w}}{1+w}" :db/id #edb/ref 17592186569782}] :answer-field/correct {:answer/id #uuid "7f8c1f90-43e4-5654-845d-4116ec994488" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-\\sqrt{1-2w}}{w}" :db/id #edb/ref 17592186569655} :answer-field/id #uuid "6438280a-ee3f-52a1-9aff-83da651ba794" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569887}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e9419475-d219-538e-ac38-b80302aae79f" :question/math-academy-id "q-85376" :question/problem "Rationalize the denominator of $\\frac{2}{1+\\sqrt{1-2w}}.$" :question/worked-solution "First, note that the denominator's conjugate is $1-\\sqrt{1-2w}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $1-\\sqrt{1-2w},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{2}{1+\\sqrt{1-2w}} &= \\frac{2}{1+\\sqrt{1-2w}}\\cdot \\frac{1-\\sqrt{1-2w}}{1-\\sqrt{1-2w}} \\\\ &= \\frac{2(1-\\sqrt{1-2w})}{(1+\\sqrt{1-2w})(1-\\sqrt{1-2w})} \\\\ &= \\frac{2(1-\\sqrt{1-2w})}{{1}^{2}-(\\sqrt{1-2w})^{2}} \\\\ &= \\frac{2(1-\\sqrt{1-2w})}{1-(1-2w)} \\\\ &= \\frac{2(1-\\sqrt{1-2w})}{2w} \\\\ &= \\frac{1-\\sqrt{1-2w}}{w}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186570039 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12504374-f500-5a7f-b4db-b77450c91b60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{m}+m" :db/id #edb/ref 17592186569471} {:answer/id #uuid "38faf8d0-cece-5038-82eb-9bd8a6b1aebc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{m}+m}{m+1}" :db/id #edb/ref 17592186569522} {:answer/id #uuid "61b52762-ce7c-5796-8c24-fb5ccc1bd64d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{m}-m}{1-m}" :db/id #edb/ref 17592186569596} {:answer/id #uuid "764dd4e6-766e-598f-9f8a-78544dd4f1d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{m}-m" :db/id #edb/ref 17592186569642} {:answer/id #uuid "7d10c88a-0e24-5427-806c-cf9d6bb12840" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{m}-1}{2}" :db/id #edb/ref 17592186569650}] :answer-field/correct {:answer/id #uuid "61b52762-ce7c-5796-8c24-fb5ccc1bd64d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{m}-m}{1-m}" :db/id #edb/ref 17592186569596} :answer-field/id #uuid "49769777-8cbf-5d9d-87a8-3536737bbec2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569872}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e9d96fa3-8e95-5519-8ecc-c21bd99ca106" :question/math-academy-id "q-34864" :question/problem "Rationalize the denominator of $\\frac{m}{\\sqrt{m}+m}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{m}-m.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{m}-m,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{m}{\\sqrt{m}+m} &= \\frac{m}{\\sqrt{m}+m}\\cdot \\frac{\\sqrt{m}-m}{\\sqrt{m}-m} \\\\ &= \\frac{m(\\sqrt{m}-m)}{(\\sqrt{m}+m)(\\sqrt{m}-m)} \\\\ &= \\frac{m(\\sqrt{m}-m)}{(\\sqrt{m})^{2}-{m}^{2}} \\\\ &= \\frac{m(\\sqrt{m}-m)}{m-{m}^{2}} \\\\ &= \\frac{\\cancel{m}(\\sqrt{m}-m)}{\\cancel{m}(1-m)} \\\\ &= \\frac{\\sqrt{m}-m}{1-m}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186570713 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "126f825b-54f7-557c-902d-f23f70ba9df9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6|t|" :db/id #edb/ref 17592186570158} {:answer/id #uuid "4631f84e-d5a6-5799-b347-9ad541471ba1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30t" :db/id #edb/ref 17592186570248} {:answer/id #uuid "4c75ccdd-f6c5-5e94-a601-725a713a3f5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6|t|}{5}" :db/id #edb/ref 17592186570258} {:answer/id #uuid "8977733d-92ba-5dd8-ade8-abf7ee937741" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5t" :db/id #edb/ref 17592186570367} {:answer/id #uuid "de74d234-a125-5b01-bbcf-59800aca3ef1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30\\sqrt{t}" :db/id #edb/ref 17592186570515}] :answer-field/correct {:answer/id #uuid "4c75ccdd-f6c5-5e94-a601-725a713a3f5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6|t|}{5}" :db/id #edb/ref 17592186570258} :answer-field/id #uuid "fc9a310b-5a8f-5f99-b66d-f83152a549f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186570694}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2a409742-71a6-54c6-bd19-7151d386a675" :question/math-academy-id "q-162918" :question/problem "$\\sqrt{\\frac{36{t}^{2}}{25}}=$" :question/worked-solution "First, we put the numerator and denominator under separate radicals and then simplify the result:\n\n$$\n\\sqrt{\\frac{36{t}^{2}}{25}}=\\frac{\\sqrt{36{t}^{2}}}{\\sqrt{25}}=\\frac{\\sqrt{36{t}^{2}}}{\\sqrt{{5}^{2}}}=\\frac{\\sqrt{36{t}^{2}}}{5}\n$$\n\nNow, notice that the expression inside the radical is a perfect square. So, we can continue simplifying by writing the expression as this perfect square:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{36{t}^{2}}}{5} &= \\frac{\\sqrt{(6t)^{2}}}{5} \\\\ &= \\frac{|6t|}{5} \\\\ &= \\frac{|6|\\cdot |t|}{5} \\\\ &= \\frac{6\\cdot |t|}{5} \\\\ &= \\frac{6|t|}{5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186571411 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11048dc5-c619-5b38-9741-5859a2f2a50f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p(s-11)" :db/id #edb/ref 17592186570916} {:answer/id #uuid "32002788-a360-5052-ae64-5689e34590f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(p-12)({s}^{2}-11)" :db/id #edb/ref 17592186570971} {:answer/id #uuid "b4209178-f9e4-5a9e-b002-8f82ea618938" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11(p-12)" :db/id #edb/ref 17592186571169} {:answer/id #uuid "b8a948e4-12fe-5885-adb8-61fce698c6ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(12-p)({s}^{2}-11)" :db/id #edb/ref 17592186571176} {:answer/id #uuid "d58b1732-c1c0-510d-8b42-66c08129e6a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(p-11)({s}^{2}-12)" :db/id #edb/ref 17592186571222}] :answer-field/correct {:answer/id #uuid "32002788-a360-5052-ae64-5689e34590f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(p-12)({s}^{2}-11)" :db/id #edb/ref 17592186570971} :answer-field/id #uuid "069a8ba6-90f3-5bde-b0e0-93af47e1ca96" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571286}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6b40873b-cd99-5437-a84e-b998bb4576d6" :question/math-academy-id "q-52275" :question/problem "Factor the polynomial expression $p({s}^{2}-11)-12({s}^{2}-11).$" :question/worked-solution "First, we find the $\\text{GCF}$ of the two terms:\n\n$$\n\\text{GCF}(p({s}^{2}-11),12({s}^{2}-11))={s}^{2}-11\n$$\n\nEach term is already written as a product with the $\\text{GCF}:$\n\n$$\n\\begin{aligned}p\\cdot ({s}^{2}-11)-12\\cdot ({s}^{2}-11)\\end{aligned}\n$$\n\nFinally, we write the $\\text{GCF}$ outside the parentheses and keep the remaining terms inside:\n\n$$\n\\begin{aligned}p\\cdot ({s}^{2}-11)-12\\cdot ({s}^{2}-11) &= (p-12)({s}^{2}-11)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186571445 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2abccb54-16a1-565a-a3d7-7b17784660fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-6)(w-10)" :db/id #edb/ref 17592186570953} {:answer/id #uuid "66ae83bc-77cf-51f1-a087-6bdd8ac365c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10(w-6)" :db/id #edb/ref 17592186571048} {:answer/id #uuid "7895f872-6b80-5972-8cff-a79b32fa8e44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10x(w-6)" :db/id #edb/ref 17592186571080} {:answer/id #uuid "a36b2445-43ae-55ce-a7aa-df740ce6b8f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(w-6)" :db/id #edb/ref 17592186571147} {:answer/id #uuid "ae6a0a05-29ac-5657-8660-18b7cdfba4cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-10)(w-6)" :db/id #edb/ref 17592186571160}] :answer-field/correct {:answer/id #uuid "ae6a0a05-29ac-5657-8660-18b7cdfba4cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-10)(w-6)" :db/id #edb/ref 17592186571160} :answer-field/id #uuid "2708da49-07a5-536d-a886-c5f8ed22fc70" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571299}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e2bc30f9-89bd-586d-8e06-36b5ff066cb1" :question/math-academy-id "q-52250" :question/problem "Factor the polynomial expression $x(w-6)-10(w-6).$" :question/worked-solution "First, we find the $\\text{GCF}$ of the two terms:\n\n$$\n\\text{GCF}(x(w-6),10(w-6))=w-6\n$$\n\nEach term is already written as a product with the $\\text{GCF}:$\n\n$$\n\\begin{aligned}x\\cdot (w-6)-10\\cdot (w-6)\\end{aligned}\n$$\n\nFinally, we write the $\\text{GCF}$ outside the parentheses and keep the remaining terms inside:\n\n$$\n\\begin{aligned}x\\cdot (w-6)-10\\cdot (w-6) &= (x-10)(w-6)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186572124 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58fbaa76-4be3-5810-9fca-639dcb62397d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{42p}}{7p}" :db/id #edb/ref 17592186571694} {:answer/id #uuid "8c042201-2e31-56b9-9702-f689b45b0c3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{13p}}{7p}" :db/id #edb/ref 17592186571778} {:answer/id #uuid "f61222d0-e8d9-55d4-8873-2cca126d2600" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7\\sqrt{6p}}{7p}" :db/id #edb/ref 17592186571961} {:answer/id #uuid "f7473de6-7b7e-515e-9736-b0cbdd110a8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7p}}{42p}" :db/id #edb/ref 17592186571962} {:answer/id #uuid "fec08322-cdbe-591d-8353-32e8ee674331" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6\\sqrt{7p}}{7p}" :db/id #edb/ref 17592186571979}] :answer-field/correct {:answer/id #uuid "58fbaa76-4be3-5810-9fca-639dcb62397d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{42p}}{7p}" :db/id #edb/ref 17592186571694} :answer-field/id #uuid "59851225-0325-52a4-8d88-a304533ac22e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572025}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3bff8ce6-eaad-5e46-86a8-f4fe4b2862a6" :question/math-academy-id "q-111056" :question/problem "Rationalize the denominator of $\\sqrt{\\frac{6}{7p}}.$" :question/worked-solution "First, we apply the quotient rule and put the numerator and denominator under separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{\\frac{6}{7p}} & =\\frac{\\sqrt{6}}{\\sqrt{7p}}\\end{aligned}\n$$\n\nNow, we need to remove the radical $\\sqrt{7p}$ from the denominator. To do this, we multiply both the numerator and denominator by $\\sqrt{7p},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{6}}{\\sqrt{7p}}\\cdot \\frac{\\sqrt{7p}}{\\sqrt{7p}} &= \\frac{\\sqrt{42p}}{(\\sqrt{7p})^{2}} \\\\ &= \\frac{\\sqrt{42p}}{7p}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186572136 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c2f45df-4f60-5116-9efa-d662af1cd213" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{2}+2z-35" :db/id #edb/ref 17592186571561} {:answer/id #uuid "158f13cf-06f8-5671-9ba0-7b986831fb4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{2}+12z-35" :db/id #edb/ref 17592186571577} {:answer/id #uuid "6bdc5840-c168-54a5-bc38-c99449256be6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{2}-2z-2" :db/id #edb/ref 17592186571721} {:answer/id #uuid "87b22d66-eea0-50cf-81b1-912e9e1f8a95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{2}-12z-35" :db/id #edb/ref 17592186571772} {:answer/id #uuid "bc41fd89-5484-57c0-aaf5-755da3cd1786" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{2}-2z-35" :db/id #edb/ref 17592186571875}] :answer-field/correct {:answer/id #uuid "bc41fd89-5484-57c0-aaf5-755da3cd1786" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{2}-2z-35" :db/id #edb/ref 17592186571875} :answer-field/id #uuid "8895b1d9-28a9-54aa-a012-08481cc5a266" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572044}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5fbbc181-ab02-53e1-a097-fa8b9ef68cb3" :question/math-academy-id "q-111297" :question/problem "$(z-7)(z+5)=$" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}(z-7)(z+5) &= z(z+5)+(-7)(z+5) \\\\ &= {z}^{2}+5z-7z-35 \\\\ &= {z}^{2}-2z-35\\end{aligned}\n$$"} {:db/id #edb/ref 17592186572169 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d149dcf-bc00-5039-ad6d-3e55cf380535" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186571615} {:answer/id #uuid "47481b34-eee7-5c53-a851-a0d02c6f04d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt[3]{xy}-24\\sqrt{xy}" :db/id #edb/ref 17592186571666} {:answer/id #uuid "835be230-c641-55e2-9c48-887dbccaded2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt[3]{xy}-2\\sqrt{xy}" :db/id #edb/ref 17592186571763} {:answer/id #uuid "9d3c2885-add8-5d0b-940c-e52b3aeada68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt[3]{xy}+2\\sqrt{xy}" :db/id #edb/ref 17592186571811} {:answer/id #uuid "d96f079d-bb01-5b16-9e68-54a60c3c5d79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt[3]{xy}+2|x|\\sqrt{y}" :db/id #edb/ref 17592186571931}] :answer-field/correct {:answer/id #uuid "9d3c2885-add8-5d0b-940c-e52b3aeada68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt[3]{xy}+2\\sqrt{xy}" :db/id #edb/ref 17592186571811} :answer-field/id #uuid "49b5efc9-5d97-504a-9727-7f1b6b2050e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572016}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b56a30ba-e6cb-544a-bbd5-8a6dcd830acc" :question/math-academy-id "q-34204" :question/problem "Simplify $-2\\sqrt[3]{xy}-4\\sqrt{xy}+6\\sqrt{xy}.$" :question/worked-solution "We can combine the two $\\sqrt{xy}$ terms together, but we cannot combine $\\sqrt{xy}$ and $\\sqrt[3]{xy}$ term:\n\n$$\n\\begin{aligned}-2\\sqrt[3]{xy}-4\\sqrt{xy}+6\\sqrt{xy} &= -2\\sqrt[3]{xy}+(-4+6)\\sqrt{xy} \\\\ &= -2\\sqrt[3]{xy}+2\\sqrt{xy}\\end{aligned}\n$$"}]
