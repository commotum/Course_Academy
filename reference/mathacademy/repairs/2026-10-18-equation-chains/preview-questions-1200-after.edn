}^{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186554586 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ac23f07-19eb-5a0a-91fe-2143e303a9c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{a}^{3}{b}^{4}\\sqrt{2a}" :db/id #edb/ref 17592186553890} {:answer/id #uuid "8a26477d-d557-5b83-8ec1-5e390a04ff66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{b}^{4}\\sqrt{2a}" :db/id #edb/ref 17592186554161} {:answer/id #uuid "c3fbfc23-489f-58fe-b8ff-e2ebc4569716" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{b}^{3}\\sqrt{2a}" :db/id #edb/ref 17592186554295} {:answer/id #uuid "cec1e7d9-d8c0-5441-9601-896e2db22b3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8a{b}^{4}\\sqrt{a}" :db/id #edb/ref 17592186554321} {:answer/id #uuid "e7e84788-8981-5728-a6a0-aba9de9a572d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{a}^{2}{b}^{4}\\sqrt{2}" :db/id #edb/ref 17592186554371}] :answer-field/correct {:answer/id #uuid "0ac23f07-19eb-5a0a-91fe-2143e303a9c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{a}^{3}{b}^{4}\\sqrt{2a}" :db/id #edb/ref 17592186553890} :answer-field/id #uuid "aef36574-d26a-51ae-8adf-50d31d43f76c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554498}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "758c8bb2-c32e-5b6a-b65e-f02ce4ad0d8b" :question/math-academy-id "q-29342" :question/problem "Simplify $\\sqrt{32{a}^{7}{b}^{8}}$ given that $a\\ge 0.$" :question/worked-solution "We first write $32{a}^{7}{b}^{8}$ as the product $16{a}^{6}{b}^{8}\\cdot 2a$ which contains a perfect square $(16{a}^{6}{b}^{8}).$ Then, we separate the product into two separate radicals, one of which can be simplified:\n\n$$\n\\begin{aligned}\\sqrt{32{a}^{7}{b}^{8}} &= \\sqrt{16{a}^{6}{b}^{8}\\cdot 2a} \\\\ &= \\sqrt{(4{a}^{3}{b}^{4})^{2}\\cdot 2a} \\\\ &= \\sqrt{(4{a}^{3}{b}^{4})^{2}}\\cdot \\sqrt{2a} \\\\ &= |4{a}^{3}{b}^{4}|\\cdot \\sqrt{2a} \\\\ &= |4|\\cdot |{a}^{3}|\\cdot |{b}^{4}|\\cdot \\sqrt{2a} \\\\ &= 4\\cdot |{a}^{3}|\\cdot |{b}^{4}|\\cdot \\sqrt{2a}\\end{aligned}\n$$\n\nA number raised to the power of four is always positive or zero, and the absolute value of any positive (or zero) number is itself, so we have that $|{b}^{4}|={b}^{4}$ and $|{a}^{3}|={a}^{3}.$ Therefore, our final answer is\n\n$$\n\\begin{aligned}4\\cdot |{a}^{3}|\\cdot |{b}^{4}|\\cdot \\sqrt{2a} &= 4\\cdot {a}^{3}\\cdot {b}^{4}\\cdot \\sqrt{2a} \\\\ &= 4{a}^{3}{b}^{4}\\sqrt{2a}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186554597 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07df4f6b-9049-50d7-8512-583bba676f26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{s}^{-2}{t}^{4}" :db/id #edb/ref 17592186553885} {:answer/id #uuid "456bb3da-ad27-5108-aeb8-1382f2461e8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{s}^{-1}{t}^{8}" :db/id #edb/ref 17592186553998} {:answer/id #uuid "6ea2d663-45f2-5abe-b547-69845ba53fa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{s}^{-1}{t}^{8}" :db/id #edb/ref 17592186554087} {:answer/id #uuid "9a6cb21d-a49b-5e2a-8746-b06ae9edbf59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{s}^{-4}{t}^{4}" :db/id #edb/ref 17592186554206} {:answer/id #uuid "b27dfddf-37bd-561f-8a81-94cb1772fc8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{s}^{-4}{t}^{8}" :db/id #edb/ref 17592186554263}] :answer-field/correct {:answer/id #uuid "b27dfddf-37bd-561f-8a81-94cb1772fc8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{s}^{-4}{t}^{8}" :db/id #edb/ref 17592186554263} :answer-field/id #uuid "44861fea-3410-5450-86b8-07e1b724a388" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554455}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "88e971de-92ab-5f11-8659-2661a18f45d8" :question/math-academy-id "q-72561" :question/problem "Which of the following is equivalent to ${(2{s}^{-1}{t}^{2})}^{4}?$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}{(2{s}^{-1}{t}^{2})}^{4} &= {2}^{4}\\cdot {({s}^{-1})}^{4}\\cdot {({t}^{2})}^{4} \\\\ &= {2}^{4}\\cdot {s}^{-1\\cdot 4}\\cdot {t}^{2\\cdot 4} \\\\ &= 16{s}^{-4}{t}^{8}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186554603 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12d2c391-f724-56a7-827a-5b0ee1b7184c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{a}^{-12}" :db/id #edb/ref 17592186553907} {:answer/id #uuid "3476cf8d-22e9-5166-95b3-22c6d287fda7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2a" :db/id #edb/ref 17592186553962} {:answer/id #uuid "9eecc025-04bf-5f32-a413-b83d915ee7b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16a" :db/id #edb/ref 17592186554220} {:answer/id #uuid "b9c886d3-298f-5f9a-9fff-7c4c836fe3de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{a}^{-12}" :db/id #edb/ref 17592186554272} {:answer/id #uuid "ecded79e-f3fd-5eb2-b624-d0cb685b64e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{a}^{12}" :db/id #edb/ref 17592186554388}] :answer-field/correct {:answer/id #uuid "12d2c391-f724-56a7-827a-5b0ee1b7184c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{a}^{-12}" :db/id #edb/ref 17592186553907} :answer-field/id #uuid "b457e636-29ae-54cf-8fbb-773aa5b75aa5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554501}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "90c0de8b-ab19-5e68-9b86-0c6dd26a2646" :question/math-academy-id "q-72552" :question/problem "Which of the following is equivalent to ${(2{a}^{-3})}^{4}?$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}{(2{a}^{-3})}^{4} &= {2}^{4}{({a}^{-3})}^{4} \\\\ &= 16\\cdot {a}^{-3\\cdot 4} \\\\ &= 16{a}^{-12}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186554641 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c8d00de-5cfb-5d7d-b6ce-1a3fcf580c19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{n}^{2}\\sqrt{5n}" :db/id #edb/ref 17592186553951} {:answer/id #uuid "493f354b-b71f-58ef-b5af-c43b305893c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2n\\sqrt{5n}" :db/id #edb/ref 17592186554009} {:answer/id #uuid "8a439d62-6628-5381-a609-99d4cc463d9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5n\\sqrt{2n}" :db/id #edb/ref 17592186554162} {:answer/id #uuid "c8dc9bd6-1c8a-5517-9d4e-a5d506cda766" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{n}^{2}\\sqrt{2n}" :db/id #edb/ref 17592186554312} {:answer/id #uuid "ddeb1d91-9f54-55f6-b72d-fd60d991fa39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{2}\\sqrt{5n}" :db/id #edb/ref 17592186554353}] :answer-field/correct {:answer/id #uuid "2c8d00de-5cfb-5d7d-b6ce-1a3fcf580c19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{n}^{2}\\sqrt{5n}" :db/id #edb/ref 17592186553951} :answer-field/id #uuid "5f773159-8463-5e37-81f8-8746b86bfcf3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554468}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f380d0a4-2ab4-5ffd-9f65-88568a9b06d4" :question/math-academy-id "q-33483" :question/problem "Simplify $\\sqrt{20{n}^{5}}.$" :question/worked-solution "We first write $20{n}^{5}$ as the product $4{n}^{4}\\cdot 5n$ which contains a perfect square $(4{n}^{4}).$ Then, we can separate the product into two separate radicals, one of which can be simplified:\n\n$$\n\\begin{aligned}\\sqrt{20{n}^{5}} &= \\sqrt{4{n}^{4}\\cdot 5n} \\\\ &= \\sqrt{(2{n}^{2})^{2}\\cdot 5n} \\\\ &= \\sqrt{(2{n}^{2})^{2}}\\cdot \\sqrt{5n} \\\\ &= |2{n}^{2}|\\cdot \\sqrt{5n} \\\\ &= |2|\\cdot |{n}^{2}|\\cdot \\sqrt{5n} \\\\ &= 2\\cdot |{n}^{2}|\\cdot \\sqrt{5n}\\end{aligned}\n$$\n\nA squared number is always positive or zero, and the absolute value of any positive (or zero) number is itself, so we have\n\n$$\n\\begin{aligned}2\\cdot |{n}^{2}|\\cdot \\sqrt{5n} &= 2\\cdot {n}^{2}\\cdot \\sqrt{5n} \\\\ &= 2{n}^{2}\\sqrt{5n}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186554644 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d1b1998-3649-527c-9f18-85f6ed4d186b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{-6}y" :db/id #edb/ref 17592186553897} {:answer/id #uuid "50b57b47-dd06-59e4-862a-1653f1f39acf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{6}{y}^{-3}" :db/id #edb/ref 17592186554027} {:answer/id #uuid "9c590931-8e73-502b-9ded-3f5d518bafca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{-5}{y}^{-2}" :db/id #edb/ref 17592186554211} {:answer/id #uuid "b0038dc0-b689-596e-9dc9-df1132a86d6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{-2}{y}^{-3}" :db/id #edb/ref 17592186554259} {:answer/id #uuid "fc30d189-cf7d-5f99-8f8f-388141bfd59a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{6}y" :db/id #edb/ref 17592186554415}] :answer-field/correct {:answer/id #uuid "50b57b47-dd06-59e4-862a-1653f1f39acf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{6}{y}^{-3}" :db/id #edb/ref 17592186554027} :answer-field/id #uuid "1bb59579-2959-5258-9103-13e2353b2c81" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554443}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fc3c433e-4980-575f-8e3b-31e27fc92890" :question/math-academy-id "q-72556" :question/problem "Which of the following is equivalent to ${({x}^{-2}y)}^{-3}?$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}{({x}^{-2}y)}^{-3} &= {({x}^{-2})}^{-3}{y}^{-3} \\\\ &= {x}^{-2(-3)}\\cdot {y}^{-3} \\\\ &= {x}^{6}{y}^{-3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186555836 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a214e20-11ee-5746-8810-076a062c13ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{7}" :db/id #edb/ref 17592186555160} {:answer/id #uuid "5573251c-6bf9-557c-a86c-d0de8177c93e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10}}{7}" :db/id #edb/ref 17592186555192} {:answer/id #uuid "7e6d0021-df51-5890-84d9-4c364481d3fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{14}}{10}" :db/id #edb/ref 17592186555291} {:answer/id #uuid "813abaaf-ebbb-5bad-8723-5b8696d33fab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{42}}{3}" :db/id #edb/ref 17592186555297} {:answer/id #uuid "fb149d86-bb17-5026-a277-cf3474adfb64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{14}}{21}" :db/id #edb/ref 17592186555620}] :answer-field/correct {:answer/id #uuid "fb149d86-bb17-5026-a277-cf3474adfb64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{14}}{21}" :db/id #edb/ref 17592186555620} :answer-field/id #uuid "00b9f5df-6016-5b3f-a644-4963b4ea3a42" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555638}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "97180f1c-2846-5a93-ae87-17ba0602d531" :question/math-academy-id "q-212910" :question/problem "$\\frac{\\sqrt{2}}{3\\sqrt{7}}=$" :question/worked-solution "To remove the radical $\\sqrt{7}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{7}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{2}}{3\\sqrt{7}} &= \\frac{\\sqrt{2}}{3\\sqrt{7}}\\cdot \\frac{\\sqrt{7}}{\\sqrt{7}} \\\\ &= \\frac{\\sqrt{2}\\cdot \\sqrt{7}}{3\\cdot (\\sqrt{7})^{2}} \\\\ &= \\frac{\\sqrt{2}\\cdot \\sqrt{7}}{3\\cdot 7} \\\\ &= \\frac{\\sqrt{2}\\cdot \\sqrt{7}}{21}\\end{aligned}\n$$\n\nNow, we use the product rule to simplify the numerator:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{2}\\cdot \\sqrt{7}}{21} &= \\frac{\\sqrt{2\\cdot 7}}{21} \\\\ &= \\frac{\\sqrt{14}}{21}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186558498 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "288914e4-d493-515b-808a-f912ce333ad3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{a}^{3}}{3}" :db/id #edb/ref 17592186557949} {:answer/id #uuid "353136f8-ecf7-5c48-8473-c7eadd6d95e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{a}^{3}}{9}" :db/id #edb/ref 17592186557975} {:answer/id #uuid "408e521d-947c-50e2-b5f6-7d4ba495fdc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16{a}^{3}}{9}" :db/id #edb/ref 17592186557996} {:answer/id #uuid "627caa3c-e441-5d00-9e01-34bb5014d364" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{a}^{3}}{3}" :db/id #edb/ref 17592186558055} {:answer/id #uuid "b4c77165-e838-5062-b664-1874e30c4e8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16{a}^{3}}{3}" :db/id #edb/ref 17592186558226}] :answer-field/correct {:answer/id #uuid "408e521d-947c-50e2-b5f6-7d4ba495fdc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16{a}^{3}}{9}" :db/id #edb/ref 17592186557996} :answer-field/id #uuid "6615ef83-050b-5898-b15a-e3a3716fe011" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186558408}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "21ebb6b3-86f2-53e7-bae9-ebede4e1482d" :question/math-academy-id "q-22491" :question/problem "Simplify $6{(\\frac{2a}{3})}^{3}.$" :question/worked-solution "First, we apply the power of quotient rule:\n\n$$\n\\begin{aligned}6{(\\frac{2a}{3})}^{3}=6\\cdot \\frac{(2a)^{3}}{{3}^{3}}\\end{aligned}\n$$\n\nThen, we apply the power of product rule and simplify:\n\n$$\n\\begin{aligned}6\\cdot \\frac{(2a)^{3}}{{3}^{3}} &= 6\\cdot \\frac{{2}^{3}{a}^{3}}{{3}^{3}} \\\\ &= 6\\cdot \\frac{8{a}^{3}}{27} \\\\ &= \\frac{48{a}^{3}}{27} \\\\ &= \\frac{16{a}^{3}}{9}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186558500 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34109e3d-3b0d-5003-a125-952c0bd2d86d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(r+4)^{2}" :db/id #edb/ref 17592186557974} {:answer/id #uuid "4a6acba3-20a0-545b-bf46-336da2fad31d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r+4)^{2}" :db/id #edb/ref 17592186558010} {:answer/id #uuid "8fb7a897-e757-5775-aca0-77aeb1d2bec0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4(r+2)^{2}" :db/id #edb/ref 17592186558148} {:answer/id #uuid "b4ea14d1-f64a-52c0-95f0-ce44bda17a42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2r+4)^{2}" :db/id #edb/ref 17592186558227} {:answer/id #uuid "ec2b8135-416e-5959-a1ee-51202d97ac35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r+2)^{2}" :db/id #edb/ref 17592186558338}] :answer-field/correct {:answer/id #uuid "34109e3d-3b0d-5003-a125-952c0bd2d86d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(r+4)^{2}" :db/id #edb/ref 17592186557974} :answer-field/id #uuid "8df196d8-9a07-500d-a8ae-b16af44641d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186558428}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "275b1fab-422b-52b6-b4bd-24f3217dcda4" :question/math-academy-id "q-79007" :question/problem "Factor the expression $2{r}^{2}+16r+32.$" :question/worked-solution "Notice that all of the terms have a common factor of $2.$ Therefore, we can simplify the expression by factoring out $2,$ as follows:\n\n$$\n\\begin{aligned}2{r}^{2}+16r+32 &= 2({r}^{2}+8r+16)\\end{aligned}\n$$\n\nNow, let's factor the expression inside parentheses using the square of a sum formula:\n\n$$\n\\begin{aligned}{r}^{2}+8r+16 &= {r}^{2}+8r+{4}^{2} \\\\ &= {r}^{2}+2\\cdot 4r+{4}^{2} \\\\ &= (r+4)^{2}\\end{aligned}\n$$\n\n \n\nTherefore, our original expression factors as follows:\n\n$$\n\\begin{aligned}2({r}^{2}+8r+16) &= 2(r+4)^{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186558504 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8934827e-e1a4-57aa-b9c6-f41a1c0f56fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b=-\\frac{2}{5}" :db/id #edb/ref 17592186558138} {:answer/id #uuid "9ccdfcfa-5451-5de0-b346-ec9c16f0e00e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b=-\\frac{12}{5}" :db/id #edb/ref 17592186558176} {:answer/id #uuid "aaca70d2-4202-5062-ab16-0babf7140c48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b=\\pm \\sqrt{\\frac{12}{5}}" :db/id #edb/ref 17592186558205} {:answer/id #uuid "f26e943a-7ae3-5e4c-8e3a-b37f9af30ceb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b=\\pm 2" :db/id #edb/ref 17592186558344} {:answer/id #uuid "f6db3fe8-7692-5d66-b32a-4fca3ee9ca87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b=\\frac{12}{5},\\,\\pm \\sqrt{2}" :db/id #edb/ref 17592186558351}] :answer-field/correct {:answer/id #uuid "9ccdfcfa-5451-5de0-b346-ec9c16f0e00e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b=-\\frac{12}{5}" :db/id #edb/ref 17592186558176} :answer-field/id #uuid "81b1231e-91d3-5a68-9071-c04003144caf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186558424}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "36a20ff4-bc02-5ebc-9459-ae85a99d7c37" :question/math-academy-id "q-14116" :question/problem "Find all the real solutions to the equation $5{b}^{3}+12{b}^{2}+20b+48=0.$" :question/worked-solution "We proceed to factor the left-hand side by grouping:\n\n$$\n\\begin{aligned}5{b}^{3}+12{b}^{2}+20b+48 &= (5{b}^{3}+12{b}^{2})+(20b+48) \\\\ &= {b}^{2}(5b+12)+4(5b+12) \\\\ &= (5b+12)\\cdot {b}^{2}+(5b+12)\\cdot 4 \\\\ &= (5b+12)({b}^{2}+4).\\end{aligned}\n$$\n\nThen, we solve $(5b+12)({b}^{2}+4)=0$ by setting each factor equal to $0.$\n\n- Setting the factor $(5b+12)$ equal to $0,$ we get\n\n$$\n\\begin{aligned}5b+12 & =0 \\\\ 5b & =-12 \\\\ b & =-\\frac{12}{5}.\\end{aligned}\n$$\n\n- Setting the factor $({b}^{2}+4)$ equal to $0,$ we get\n\n$$\n\\begin{aligned}{b}^{2}+4 & =0 \\\\ {b}^{2} & =-4.\\end{aligned}\n$$\n\nSince a squared real number cannot be negative, the equation ${b}^{2}+4=0$ has no real solutions.\n\nTherefore,  $b=-\\frac{12}{5}$ is the only real solution."} {:db/id #edb/ref 17592186558522 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19f927e8-fd04-5b24-9051-6b5a918ad64c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{(3x-\\frac{1}{3})}^{2}" :db/id #edb/ref 17592186557925} {:answer/id #uuid "32f2a486-695a-5441-9417-59951b7b6c17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{(x-\\frac{2}{3})}^{2}" :db/id #edb/ref 17592186557973} {:answer/id #uuid "4c6361cb-48a2-5f00-a113-53b05b147d44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{(3x-\\frac{1}{3})}^{2}" :db/id #edb/ref 17592186558013} {:answer/id #uuid "be3f0de2-0bc3-54c5-b294-c07f2c0dc17f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{(3x-\\frac{2}{3})}^{2}" :db/id #edb/ref 17592186558247} {:answer/id #uuid "ef63b783-49af-546d-8cf4-f1476656f81b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{(3x+\\frac{4}{9})}^{2}" :db/id #edb/ref 17592186558342}] :answer-field/correct {:answer/id #uuid "be3f0de2-0bc3-54c5-b294-c07f2c0dc17f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{(3x-\\frac{2}{3})}^{2}" :db/id #edb/ref 17592186558247} :answer-field/id #uuid "5b7c1f54-810f-55b1-ab45-181c23bc394b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186558401}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6884ae1e-aa7f-516d-8c30-2f343ce00f89" :question/math-academy-id "q-79010" :question/problem "Factor $-9{x}^{2}+4x-\\frac{4}{9}.$" :question/worked-solution "Notice that the leading coefficient is negative. To reduce the expression to a more familiar form, we can factor out $-1,$ as follows:\n\n$$\n\\begin{aligned}-9{x}^{2}+4x-\\frac{4}{9} &= -(9{x}^{2}-4x+\\frac{4}{9})\\end{aligned}\n$$\n\nNow, we factor the quadratic expression inside the parentheses using the square of a difference  formula: \n\n$$\n\\begin{aligned}9{x}^{2}-4x+\\frac{4}{9} &= (3x)^{2}-4x+{(\\frac{2}{3})}^{2} \\\\ &= (3x)^{2}-2\\cdot (\\frac{2}{3}\\cdot 3x)+{(\\frac{2}{3})}^{2} \\\\ &= {(3x-\\frac{2}{3})}^{2}\\end{aligned}\n$$\n\nTherefore, our original expression factors as follows:\n\n$$\n\\begin{aligned}-(9{x}^{2}-4x+\\frac{4}{9}) &= -{(3x-\\frac{2}{3})}^{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186558524 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11615e8c-79b7-5430-8245-0a55f42d7861" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(r-2)^{2}" :db/id #edb/ref 17592186557903} {:answer/id #uuid "564d466f-3e14-571e-98fa-b5a61a8cfbed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4(r-2)^{2}" :db/id #edb/ref 17592186558028} {:answer/id #uuid "af67a4bf-7608-52ba-b8bb-4cfbeb581cb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4(2r-1)^{2}" :db/id #edb/ref 17592186558215} {:answer/id #uuid "afb197b9-ef77-55c0-8d73-cfe31f69e11f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(4r-1)^{2}" :db/id #edb/ref 17592186558216} {:answer/id #uuid "d5417484-3bdb-5d4d-ae0d-d6f710f8b199" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4(2r-4)^{2}" :db/id #edb/ref 17592186558286}] :answer-field/correct {:answer/id #uuid "af67a4bf-7608-52ba-b8bb-4cfbeb581cb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4(2r-1)^{2}" :db/id #edb/ref 17592186558215} :answer-field/id #uuid "c99dfe19-b0ba-52de-a707-b226b7df9dfd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186558454}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6b4b9fe6-eb97-5c93-8f7d-fda1228ca372" :question/math-academy-id "q-111641" :question/problem "Factor the expression $16{r}^{2}-16r+4.$" :question/worked-solution "Notice that all of the terms have a common factor of $4.$ Therefore, we can simplify the expression by factoring out $4,$ as follows:\n\n$$\n\\begin{aligned}16{r}^{2}-16r+4 &= 4(4{r}^{2}-4r+1)\\end{aligned}\n$$\n\nNow, let's factor the expression inside parentheses using the square of a difference formula:\n\n$$\n\\begin{aligned}4{r}^{2}-4r+1 &= (2r)^{2}-4r+{1}^{2} \\\\ &= (2r)^{2}-2\\cdot (2r\\cdot 1)+{1}^{2} \\\\ &= (2r-1)^{2}\\end{aligned}\n$$\n\nTherefore, our original expression factors as follows:\n\n$$\n\\begin{aligned}4(4{r}^{2}-4r+1) &= 4(2r-1)^{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186558546 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1158a179-4af2-57c0-b482-1b618b682555" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2,\\,\\pm 3" :db/id #edb/ref 17592186557902} {:answer/id #uuid "11ab1234-f864-588c-a250-034b00261075" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt{2},\\,\\sqrt{3}" :db/id #edb/ref 17592186557904} {:answer/id #uuid "6d45e655-7700-5ee3-8c5a-ec66765eebe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3,\\,\\pm \\sqrt{2}" :db/id #edb/ref 17592186558080} {:answer/id #uuid "96d81797-9816-5915-9fed-357eee6ed9ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2,\\,3" :db/id #edb/ref 17592186558159} {:answer/id #uuid "a44cb772-a5d5-5548-a04a-c2f728e6f3bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt{2},\\,3" :db/id #edb/ref 17592186558193}] :answer-field/correct {:answer/id #uuid "6d45e655-7700-5ee3-8c5a-ec66765eebe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3,\\,\\pm \\sqrt{2}" :db/id #edb/ref 17592186558080} :answer-field/id #uuid "543735e3-a26c-5ffd-9ec2-86ffb989af36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186558398}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a043cae8-5322-50e0-9c25-76e939ce12b0" :question/math-academy-id "q-72032" :question/problem "Solve $-{y}^{3}+3{y}^{2}+2y-6=0.$" :question/worked-solution "First, we multiply the equation by $-1$ to make the coefficient of the cubic term positive. This gives\n\n$$\n{y}^{3}-3{y}^{2}-2y+6=0.\n$$\n\nWe then proceed to factor the left-hand side by grouping:\n\n$$\n\\begin{aligned}{y}^{3}-3{y}^{2}-2y+6 &= ({y}^{3}-3{y}^{2})+(-2y+6) \\\\ &= {y}^{2}(y-3)-2(y-3) \\\\ &= ({y}^{2}-2)(y-3)\\end{aligned}\n$$\n\nThen, we solve $({y}^{2}-2)(y-3)=0$ by setting each factor equal to $0.$\n\n- Setting the factor $({y}^{2}-2)$ equal to $0,$ we get $y=\\pm \\sqrt{2}.$\n\n- Setting the factor $(y-3)$ equal to $0,$ we get $y=3.$\n\nTherefore, the solutions are $y=3,\\,\\pm \\sqrt{2}.$"} {:db/id #edb/ref 17592186559778 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a19ebb9-eb32-5f26-b024-e4e111e111e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5(h+5)}{h-5}" :db/id #edb/ref 17592186559322} {:answer/id #uuid "9a149eb4-3b76-5d09-90e7-b82fe272cdf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "h-15" :db/id #edb/ref 17592186559406} {:answer/id #uuid "a5c62dbc-9eb7-5b0e-9f7c-6b7a00979eee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5h-15" :db/id #edb/ref 17592186559433} {:answer/id #uuid "c22acf02-c6c6-5c01-be71-8571630d69d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5(h+5)}{h+3}" :db/id #edb/ref 17592186559494} {:answer/id #uuid "dd4c551c-c05a-570f-9f97-6911d7e8970e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5h-25" :db/id #edb/ref 17592186559559}] :answer-field/correct {:answer/id #uuid "dd4c551c-c05a-570f-9f97-6911d7e8970e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5h-25" :db/id #edb/ref 17592186559559} :answer-field/id #uuid "7505a7c9-8965-5038-af54-42cf0716d0a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559710}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0c6bffa8-a78e-5e02-8975-6f49c316264d" :question/math-academy-id "q-112994" :question/problem "What is $\\frac{5{h}^{2}-10h-75}{h+3}$ reduced to lowest terms?" :question/worked-solution "The numerator can be factored as\n\n$$\n5{h}^{2}-10h-75=5({h}^{2}-2h-15)=5(h-5)(h+3).\n$$\n\nCanceling out any common factors that appear in the numerator and the denominator, we get\n\n$$\n\\begin{aligned}\\frac{5{h}^{2}-10h-75}{h+3} &= \\frac{5(h-5)(h+3)}{h+3} \\\\ &= \\frac{5(h-5)\\cancel{(h+3)}}{\\cancel{h+3}} \\\\ &= \\frac{5(h-5)}{1} \\\\ &= 5h-25.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186559786 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa972374-4a13-56c9-9cad-962d8ee51506" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186559633}] :answer-field/correct {:answer/id #uuid "fa972374-4a13-56c9-9cad-962d8ee51506" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186559633} :answer-field/id #uuid "63c49bf2-4fa7-5960-9c8b-b53c37923e52" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186559700}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "21de0665-fffe-50d8-acfd-284a6430dcc9" :question/math-academy-id "q-178587" :question/problem "$64\\times (-2)^{-3}=${{field-1}}" :question/worked-solution "To evaluate the given expression, we use PEMDAS.\n\nNotice that $(-2)^{-3}=\\frac{1}{(-2)^{3}}.$ So, we obtain:\n\n$$\n\\begin{aligned}64\\times (-2)^{-3} &= 64\\times \\frac{1}{(-2)^{3}} \\\\ &= 64\\times \\frac{1}{(-8)} \\\\ &= -\\frac{64}{8} \\\\ &= -(64÷8) \\\\ &= -8\\end{aligned}\n$$"} {:db/id #edb/ref 17592186559824 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4aed9040-08cc-5807-b5a4-1787d0109cec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-28{c}^{2}" :db/id #edb/ref 17592186559213} {:answer/id #uuid "4f24db4a-1005-5049-be48-5d4cdcd1f83c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{c}^{2}}{7}" :db/id #edb/ref 17592186559220} {:answer/id #uuid "6effc252-b0f9-5d2b-ad31-932aa4478f40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4{c}^{2}}{7}" :db/id #edb/ref 17592186559290} {:answer/id #uuid "b66c1b22-292a-59dd-be49-5eeabdfb43cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28{c}^{2}" :db/id #edb/ref 17592186559471} {:answer/id #uuid "e9c0d0b4-c3e0-5116-88df-a59415a5b128" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-4(c)^{2}}{7}" :db/id #edb/ref 17592186559588}] :answer-field/correct {:answer/id #uuid "4f24db4a-1005-5049-be48-5d4cdcd1f83c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{c}^{2}}{7}" :db/id #edb/ref 17592186559220} :answer-field/id #uuid "5d6de616-d83b-5377-8c79-b2dcdeb0a26b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559697}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8404264d-3a64-5581-ad4c-0afe9c6e6c44" :question/math-academy-id "q-78940" :question/problem "$|-\\frac{4{c}^{2}}{7}|=$" :question/worked-solution "Firstly, since $|-a|=|a|,$ we can write our expression as\n\n$$\n|\\frac{4{c}^{2}}{7}|.\n$$\n\nThen, we distribute the absolute value over the multiplication and division:\n\n$$\n\\begin{aligned}|\\frac{4{c}^{2}}{7}| &= \\frac{|4{c}^{2}|}{|7|} \\\\ &= \\frac{4|{c}^{2}|}{|7|} \\\\ &= \\frac{4|{c}^{2}|}{7}\\end{aligned}\n$$\n\nSince ${c}^{2}\\ge 0$ for any real $c,$ we have that $|{c}^{2}|={c}^{2}.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{4|{c}^{2}|}{7} & =\\frac{4{c}^{2}}{7}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186561049 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "323dbbe1-3082-574e-a141-37fe7a4c73f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }(3x-4)\\operatorname{sin}⁡(7x)\\,\\text{d}x" :db/id 