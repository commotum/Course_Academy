t {:answer/id #uuid "ca21d742-cc43-5c28-9388-f527772dc009" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt[3]{21}" :db/id #edb/ref 17592186550912} :answer-field/id #uuid "d99382d4-4eef-5bcc-8e0c-245c996446a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551205}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d56a0cf9-3169-596f-ae20-a8cf3a250f28" :question/math-academy-id "q-134560" :question/problem "$7\\sqrt[3]{21}-3\\sqrt[3]{21}=$" :question/worked-solution "We can combine the two $\\sqrt[3]{21}$ terms together, as follows:\n\n$$\n\\begin{aligned}7\\sqrt[3]{21}-3\\sqrt[3]{21} &= (7-3)\\sqrt[3]{21} \\\\ &= 4\\sqrt[3]{21}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186551341 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ae499bb-bf8f-5fc4-aec9-2dc9bdb9a4df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186550590} {:answer/id #uuid "7ea00391-81e6-5aa5-92c3-aab074a102d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2-\\sqrt{2}}{2}" :db/id #edb/ref 17592186550683} {:answer/id #uuid "7fee911c-477b-55c3-9770-f92077500b94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186550691} {:answer/id #uuid "9d2f2ca5-e104-5920-9146-0e49e1295162" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186550769} {:answer/id #uuid "a898a109-7268-53b6-8036-8d9cf20ccf01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186550815}] :answer-field/correct {:answer/id #uuid "5ae499bb-bf8f-5fc4-aec9-2dc9bdb9a4df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186550590} :answer-field/id #uuid "edfb1d06-ff84-5a5e-b3ca-4378a3fc65ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551218}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "da211e88-d789-5f6a-b87d-2366e18b07f4" :question/math-academy-id "q-5991" :question/problem "$1-\\operatorname{sin}⁡{30}^{∘}=$" :question/worked-solution "The angle ${30}^{∘}$ is special, and its sine has the value\n\n$$\n\\operatorname{sin}⁡{30}^{∘}=\\frac{1}{2}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}1-\\operatorname{sin}⁡{30}^{∘} &= 1-\\frac{1}{2} \\\\ &= \\frac{1}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186552428 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3aeb3eef-29a8-5ea6-b548-ddcb20776a00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186551807} {:answer/id #uuid "487830ca-ce0a-5e85-8c66-6e544da4f594" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186551841} {:answer/id #uuid "67785bcb-303e-5072-8f88-6d857e799dc9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186551906} {:answer/id #uuid "78a5611f-f5c6-5764-bfa1-f8b3d4886119" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I  and III only" :db/id #edb/ref 17592186551949} {:answer/id #uuid "adb4124d-f77d-5b00-b0f0-2fbbee5b7d24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186552082}] :answer-field/correct {:answer/id #uuid "adb4124d-f77d-5b00-b0f0-2fbbee5b7d24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186552082} :answer-field/id #uuid "52ee438e-ac14-5d2d-9ba2-e23f74a8dc8e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552301}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4251c35b-5737-5f81-8168-9bb04b9bfceb" :question/math-academy-id "q-3894" :question/problem "Which of the following is a root of the polynomial ${v}^{4}-4{v}^{3}+7v-28?$\n\nI. $v=-4$\n\nII. $v=4$\n\nIII. $v=2$" :question/worked-solution "- Substituting $-4$ for $v$ in the polynomial and evaluating, we get the following result:\n\n$$\n\\begin{aligned}(-4)^{4}-4(-4)^{3}+7(-4)-28 &= 256+256-28-28 \\\\ &= 456\\end{aligned}\n$$\n\nThe polynomial does *not* equal $0$ when $-4$ is substituted for $v.$ Therefore, $-4$ is *not*  a root.\n\n- Substituting $4$ for $v$ in the polynomial and evaluating, we get the following result:\n\n$$\n\\begin{aligned}(4)^{4}-4(4)^{3}+7(4)-28 &= 256-256+28-28 \\\\ &= 0\\end{aligned}\n$$\n\nThe polynomial is $0$ when $4$ is substituted for $v.$ Therefore, $4$ is a root.\n\n- Substituting $2$ for $v$ in the polynomial and evaluating, we get the following result:\n\n$$\n\\begin{aligned}(2)^{4}-4(2)^{3}+7(2)-28 &= 16-32+14-28 \\\\ &= -30\\end{aligned}\n$$\n\nThe polynomial does *not* equal $0$ when $2$ is substituted for $v.$ Therefore, $2$ is *not*  a root.\n\nTherefore, the root is $v=4,$ so the correct answer is \"II only\"."} {:db/id #edb/ref 17592186552435 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a9ad680-ea7c-5349-8099-ee0f7360edf9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186551722} {:answer/id #uuid "1f2cf0d6-8ae2-54dc-8299-3d8f8c1181f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186551731} {:answer/id #uuid "3b455006-8a18-50b3-9dfd-7f67b1c755e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186551809} {:answer/id #uuid "ab6327b9-2262-5b77-8b24-265e4673cdf2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186552076} {:answer/id #uuid "ce1cf656-c57d-5c73-a614-b3fbde117e8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186552155}] :answer-field/correct {:answer/id #uuid "1f2cf0d6-8ae2-54dc-8299-3d8f8c1181f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186551731} :answer-field/id #uuid "c7315726-3016-58de-b132-f1d5a281014b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552370}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "492f172a-6ec8-53da-b873-64a863435b9b" :question/math-academy-id "q-3896" :question/problem "Which of the following is a root of the polynomial ${u}^{4}-26{u}^{2}+25?$\n\nI. $u=1$\n\nII. $u=5$\n\nIII. $u=3$" :question/worked-solution "- Substituting $1$ for $u$ in the polynomial and evaluating, we get the following result:\n\n$$\n\\begin{aligned}{1}^{4}-26(1)^{2}+25 &= 1-26(1)+25 \\\\ &= 1-26+25 \\\\ &= 0\\end{aligned}\n$$\n\nThe polynomial is $0$ when $1$ is substituted for $u.$ Therefore, $1$ is a root.\n\n- Substituting $5$ for $u$ in the polynomial and evaluating, we get the following result:\n\n$$\n\\begin{aligned}(5)^{4}-26(5)^{2}+25 &= 625-26(25)+25 \\\\ &= 625-650+25 \\\\ &= 0\\end{aligned}\n$$\n\nThe polynomial is $0$ when $5$ is substituted for $u.$ Therefore, $5$ is a root.\n\n- Substituting $3$ for $u$ in the polynomial and evaluating, we get the following result:\n\n$$\n\\begin{aligned}(3)^{4}-26(3)^{2}+25 &= 81-26(9)+25 \\\\ &= 81-234+25 \\\\ &= -128\\end{aligned}\n$$\n\nThe polynomial does *not* equal $0$ when $3$ is substituted for $u.$ Therefore, $3$ is *not*  a root.\n\nTherefore, the roots are $u=1$ and $u=5,$ so the correct answer is \"I and II only\"."} {:db/id #edb/ref 17592186552497 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ed4f90b-7446-5fe1-a027-5e3a5ce07b55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186551892} {:answer/id #uuid "6a45a887-7bd4-55cc-9567-0be073fde218" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186551911} {:answer/id #uuid "7d5b8ea2-92f3-534a-af6b-e41b17d163cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186551963} {:answer/id #uuid "871e3b59-d5c2-5e57-ac83-1e3ea351c7c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186551992} {:answer/id #uuid "e70da112-f9be-571f-9779-eff48a54af1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186552203}] :answer-field/correct {:answer/id #uuid "871e3b59-d5c2-5e57-ac83-1e3ea351c7c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186551992} :answer-field/id #uuid "670a06f6-a994-5703-aa13-cc5f486be4c0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552311}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b7f2915e-8d70-5b64-9329-25d718df5c40" :question/math-academy-id "q-37656" :question/problem "Which of the following is a root of the polynomial ${x}^{3}-6{x}^{2}+9x+1?$\n\nI. $x=-6$\n\nII. $x=0$\n\nIII. $x=2$" :question/worked-solution "- Substituting $-6$ for $x$ in the polynomial and evaluating, we get the following result:\n\n$$\n\\begin{aligned}(-6)^{3}-6(-6)^{2}+9(-6)+1 &= -216-216-54+1 \\\\ &= -485\\end{aligned}\n$$\n\nThe polynomial does *not* equal $0$ when $-6$ is substituted for $x.$ Therefore, $-6$ is *not*  a root.\n\n- Substituting $0$ for $x$ in the polynomial and evaluating, we get the following result:\n\n$$\n\\begin{aligned}(0)^{3}-6(0)^{2}+9(0)+1 &= 0-0+0+1 \\\\ &= 1\\end{aligned}\n$$\n\nThe polynomial does *not* equal $0$ when $0$ is substituted for $x.$ Therefore, $0$ is *not*  a root.\n\n- Substituting $2$ for $x$ in the polynomial and evaluating, we get the following result:\n\n$$\n\\begin{aligned}(2)^{3}-6(2)^{2}+9(2)+1 &= 8-24+18+1 \\\\ &= 3\\end{aligned}\n$$\n\nThe polynomial does *not* equal $0$ when $2$ is substituted for $x.$ Therefore, $2$ is *not*  a root.\n\nTherefore, there are no roots among the given options, so the correct answer is \"None\"."} {:db/id #edb/ref 17592186553503 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "100858d8-fbb8-53d1-94ff-c723fb8181a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3{v}^{2}{u}^{3}}" :db/id #edb/ref 17592186552890} {:answer/id #uuid "1012a099-490e-55a1-91fe-96513e31d553" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{{v}^{2}{u}^{3}}" :db/id #edb/ref 17592186552891} {:answer/id #uuid "b785f732-b7a8-5013-8b45-005925d7b461" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3vu}" :db/id #edb/ref 17592186553234} {:answer/id #uuid "f1e2a5a9-241f-5141-b300-982a2112367c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2{v}^{2}{u}^{3}}" :db/id #edb/ref 17592186553344} {:answer/id #uuid "ff2dc043-19d6-5231-9ee1-3d43616eb3b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3{v}^{2}{u}^{2}}" :db/id #edb/ref 17592186553375}] :answer-field/correct {:answer/id #uuid "1012a099-490e-55a1-91fe-96513e31d553" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{{v}^{2}{u}^{3}}" :db/id #edb/ref 17592186552891} :answer-field/id #uuid "68afb3d3-4f53-59cf-a56f-7809a2483d3e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553425}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "22efbe5c-dc42-517a-9c47-dc7951665162" :question/math-academy-id "q-22530" :question/problem "$\\frac{2}{3}{(\\frac{3}{v})}^{2}{(\\frac{1}{u})}^{3}=$" :question/worked-solution "We apply the power of quotient rule and simplify:\n\n$$\n\\begin{aligned}\\frac{2}{3}{(\\frac{3}{v})}^{2}{(\\frac{1}{u})}^{3} &= \\frac{2}{3}\\cdot \\frac{{3}^{2}}{{v}^{2}}\\cdot \\frac{{1}^{3}}{{u}^{3}} \\\\ &= \\frac{2}{3}\\cdot \\frac{9}{{v}^{2}}\\cdot \\frac{1}{{u}^{3}} \\\\ &= \\frac{18}{3{v}^{2}{u}^{3}} \\\\ &= \\frac{6}{{v}^{2}{u}^{3}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186553531 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "299f70f9-d586-5ab8-9fa1-e66b62718b96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{y}^{2}" :db/id #edb/ref 17592186552943} {:answer/id #uuid "80553c4f-13fb-5669-97d1-2d6f13f16069" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{y}^{4}" :db/id #edb/ref 17592186553128} {:answer/id #uuid "b1f092b1-289b-5644-bdf4-12f442a05dc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{y}^{4}" :db/id #edb/ref 17592186553226} {:answer/id #uuid "ccc4e58e-78e3-5701-87e5-d91a3ca12c42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{y}^{4}" :db/id #edb/ref 17592186553278} {:answer/id #uuid "d3c80396-4cef-5dc3-ac82-29205d9d7fa2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8y" :db/id #edb/ref 17592186553292}] :answer-field/correct {:answer/id #uuid "ccc4e58e-78e3-5701-87e5-d91a3ca12c42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{y}^{4}" :db/id #edb/ref 17592186553278} :answer-field/id #uuid "33389c7b-23f5-548b-b70a-903275cf55e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553396}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "677c1e28-0032-5401-8f05-31d06a622d65" :question/math-academy-id "q-60587" :question/problem "Simplify $(2y)^{4}.$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}(2y)^{4} &= {2}^{4}\\cdot {y}^{4} \\\\ &= 16{y}^{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186553553 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1abb5c2a-f907-5ec8-8eaa-045849906fd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{33}" :db/id #edb/ref 17592186552913} {:answer/id #uuid "23f1850b-9cf1-5ba9-958d-6192a230eab4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{33}{4}" :db/id #edb/ref 17592186552932} {:answer/id #uuid "68099384-0fa4-5c9d-b726-604bfb900ce3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{44}{3}" :db/id #edb/ref 17592186553087} {:answer/id #uuid "6fd4d1ee-f3c3-561f-b1b0-76bd0e228df6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186553097} {:answer/id #uuid "8a90a5e9-09f1-5cfd-a38d-7c4b2dd144a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{3}" :db/id #edb/ref 17592186553147}] :answer-field/correct {:answer/id #uuid "68099384-0fa4-5c9d-b726-604bfb900ce3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{44}{3}" :db/id #edb/ref 17592186553087} :answer-field/id #uuid "202889fe-fbdf-5866-9db5-d7e0eb76934f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553387}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "97290040-c817-56ab-b0de-389c63e1806d" :question/math-academy-id "q-99763" :question/problem "$\\frac{11}{(\\frac{3}{4})}=$" :question/worked-solution "First, remember that a fraction represents a division:\n\n$$\n\\begin{aligned}\\frac{11}{(\\frac{3}{4})}=11÷\\frac{3}{4}\\end{aligned}\n$$\n\nNow, recall that $11=\\frac{11}{1}$ and dividing by $\\frac{3}{4}$ is the same as multiplying by its reciprocal $\\frac{4}{3}.$ We can use these facts to simplify the fraction above: \n\n$$\n\\begin{aligned}11÷\\frac{3}{4} &= \\frac{11}{1}\\times \\frac{4}{3} \\\\ &= \\frac{11\\times 4}{1\\times 3} \\\\ &= \\frac{44}{3}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{11}{(\\frac{3}{4})}=\\frac{44}{3}.\n$$"} {:db/id #edb/ref 17592186554540 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0431e39d-71d1-5768-88be-409ca33f6c7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}\\sqrt{5}" :db/id #edb/ref 17592186553875} {:answer/id #uuid "369e7a6b-727f-5c71-8be5-8892046afcfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3y\\sqrt{5}" :db/id #edb/ref 17592186553967} {:answer/id #uuid "78a5d1c0-2297-5d46-9446-2060429a75d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15y" :db/id #edb/ref 17592186554112} {:answer/id #uuid "889645be-9d28-546a-9122-d1ad0f6e84d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5y\\sqrt{3}" :db/id #edb/ref 17592186554155} {:answer/id #uuid "d1a5b4b0-a22e-503c-b26d-aee6391ea028" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{5y}" :db/id #edb/ref 17592186554325}] :answer-field/correct {:answer/id #uuid "369e7a6b-727f-5c71-8be5-8892046afcfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3y\\sqrt{5}" :db/id #edb/ref 17592186553967} :answer-field/id #uuid "391f389b-05b6-594c-95d0-cca64d0e6b52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554452}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "09d71431-cc0e-5153-8350-c0a86eafb77b" :question/math-academy-id "q-3047" :question/problem "Simplify $\\sqrt{45{y}^{2}}$ given that $y\\ge 0.$" :question/worked-solution "We first write $45{y}^{2}$ as the product $9{y}^{2}\\cdot 5$ which contains a perfect square $(9{y}^{2}).$ Then, we can separate the product into two separate radicals, one of which can be simplified:\n\n$$\n\\begin{aligned}\\sqrt{45{y}^{2}} &= \\sqrt{9{y}^{2}\\cdot 5} \\\\ &= \\sqrt{(3y)^{2}\\cdot 5} \\\\ &= \\sqrt{(3y)^{2}}\\cdot \\sqrt{5} \\\\ &= |3y|\\cdot \\sqrt{5} \\\\ &= |3|\\cdot |y|\\cdot \\sqrt{5} \\\\ &= 3\\cdot |y|\\cdot \\sqrt{5}\\end{aligned}\n$$\n\nSince $y\\ge 0,$ we have $|y|=y,$ and we can simplify further. Therefore, our final answer is\n\n$$\n\\begin{aligned}3\\cdot |y|\\cdot \\sqrt{5} &= 3\\cdot y\\cdot \\sqrt{5} \\\\ &= 3y\\sqrt{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186554554 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d7ff446-5e4c-5311-bd0a-4828ed37f42b" :answer/t