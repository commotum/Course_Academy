46609}] :answer-field/correct {:answer/id #uuid "88c4d714-07f1-5806-b454-0b9377675255" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186446598} :answer-field/id #uuid "1e7c4932-12c2-55fd-b4a9-63d1a3d70eed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446614}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e7d87357-9dbd-5804-b609-79909ab26f10" :question/math-academy-id "q-152051" :question/problem "Simplify $\\sqrt{\\frac{1}{36}}.$" :question/worked-solution "Recall that if $a\\ge 0,$ then\n\n$$\n\\sqrt{{a}^{2}}=a.\n$$\n\nFirst, notice that $1$ and $36$ are both perfect squares, where\n\n$$\n1={1}^{2}.\n$$\n\nand\n\n$$\n36={6}^{2}.\n$$\n\nSo, to work out $\\sqrt{\\frac{1}{36}},$ we express $\\frac{1}{36}$ as a perfect square:\n\n$$\n\\begin{aligned}\\sqrt{\\frac{1}{36}} &= \\sqrt{\\frac{{1}^{2}}{{6}^{2}}} \\\\ &= \\sqrt{\\frac{1\\cdot 1}{6\\cdot 6}} \\\\ &= \\sqrt{\\frac{1}{6}\\cdot \\frac{1}{6}} \\\\ &= \\sqrt{{(\\frac{1}{6})}^{2}} \\\\ &= \\frac{1}{6}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186446632 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac55b45e-36cf-5ce5-a3a9-88ee734e0054" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186446601}] :answer-field/correct {:answer/id #uuid "ac55b45e-36cf-5ce5-a3a9-88ee734e0054" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186446601} :answer-field/id #uuid "a3ffaf66-88bf-5785-a4c3-fe54ed409050" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186446617}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ed622752-4bb3-5695-8b97-40b6d4099979" :question/math-academy-id "q-178662" :question/problem "Expressed as a fraction in its simplest form, $\\sqrt{\\frac{4}{25}}=${{field-1}}." :question/worked-solution "Recall that if $a\\ge 0,$ then\n\n$$\n\\sqrt{{a}^{2}}=a.\n$$\n\nFirst, notice that $4$ and $25$ are both perfect squares, where\n\n$$\n4={2}^{2},\n$$\n\nand\n\n$$\n25={5}^{2}.\n$$\n\nSo, to work out $\\sqrt{\\frac{4}{25}},$ we express $\\frac{4}{25}$ as a perfect square:\n\n$$\n\\begin{aligned}\\sqrt{\\frac{4}{25}} &= \\sqrt{\\frac{{2}^{2}}{{5}^{2}}} \\\\ &= \\sqrt{\\frac{2\\cdot 2}{5\\cdot 5}} \\\\ &= \\sqrt{\\frac{2}{5}\\cdot \\frac{2}{5}} \\\\ &= \\sqrt{{(\\frac{2}{5})}^{2}} \\\\ &= \\frac{2}{5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186446899 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "530dd5a9-f465-5462-94e9-f01a209b0d78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-\\frac{4a}{5}" :db/id #edb/ref 17592186446879} {:answer/id #uuid "58d31a0f-1cc7-5817-86b7-5127bda2669e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5-\\frac{a}{5}" :db/id #edb/ref 17592186446881} {:answer/id #uuid "5ed01a2f-aebe-5710-bb22-50c7d72b1cbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-\\frac{8a}{5}" :db/id #edb/ref 17592186446882} {:answer/id #uuid "9006bbdb-d766-5f52-962e-8440379f6cce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-8a" :db/id #edb/ref 17592186446889} {:answer/id #uuid "bbaf1a3e-a51d-568b-8426-87f8af9a03aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5-\\frac{8a}{5}" :db/id #edb/ref 17592186446892}] :answer-field/correct {:answer/id #uuid "5ed01a2f-aebe-5710-bb22-50c7d72b1cbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-\\frac{8a}{5}" :db/id #edb/ref 17592186446882} :answer-field/id #uuid "f376e390-4e95-5028-9093-ef1c0f9ff815" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446898}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3df2a403-93cd-5b64-9814-34a448286c87" :question/math-academy-id "q-103611" :question/problem "Which of the following is equivalent to $\\frac{10-8a}{5}?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in individual terms, we get\n\n$$\n\\begin{aligned}\\frac{10-8a}{5} &= \\frac{10}{5}-\\frac{8a}{5} \\\\ &= 2-\\frac{8a}{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186446900 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48a6505d-1142-59a6-8de5-35951e5ab5d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{a}{4}+\\frac{5b}{4}-\\frac{3c}{4}" :db/id #edb/ref 17592186446877} {:answer/id #uuid "5243e457-add4-5054-99f0-cb9f8d0b61ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2a+\\frac{5b}{4}+\\frac{3c}{2}" :db/id #edb/ref 17592186446878} {:answer/id #uuid "7b456930-e6cd-5a95-ac0e-a775bec47f3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{a}{2}+\\frac{5b}{4}-\\frac{3c}{2}" :db/id #edb/ref 17592186446883} {:answer/id #uuid "836a86a0-52d2-5bb6-85f7-08745b789b15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{a}{4}+\\frac{5b}{4}-3c" :db/id #edb/ref 17592186446887} {:answer/id #uuid "d9f67298-3106-53a6-9427-8810ddae2046" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{a}{2}+5b-\\frac{3c}{4}" :db/id #edb/ref 17592186446894}] :answer-field/correct {:answer/id #uuid "7b456930-e6cd-5a95-ac0e-a775bec47f3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{a}{2}+\\frac{5b}{4}-\\frac{3c}{2}" :db/id #edb/ref 17592186446883} :answer-field/id #uuid "ba3923bd-8380-52fe-8508-6d5f9d84c266" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446897}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5d87cdbc-df13-5193-a29d-fd4c82ca5467" :question/math-academy-id "q-103631" :question/problem "$\\frac{4a+10b-12c}{8}=$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in individual terms, we get\n\n$$\n\\begin{aligned}\\frac{4a+10b-12c}{8} &= \\frac{4a}{8}+\\frac{10b}{8}-\\frac{12c}{8} \\\\ &= \\frac{4}{8}\\cdot a+\\frac{10}{8}\\cdot b-\\frac{12}{8}\\cdot c \\\\ &= \\frac{1}{2}\\cdot a+\\frac{5}{4}\\cdot b-\\frac{3}{2}\\cdot c \\\\ &= \\frac{a}{2}+\\frac{5b}{4}-\\frac{3c}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186446901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01a02ab5-3cde-53e5-8def-fa56bb2f44e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-\\frac{1}{3}" :db/id #edb/ref 17592186446875} {:answer/id #uuid "41737690-1985-5531-8052-7be9b91b3f57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+\\frac{1}{2}" :db/id #edb/ref 17592186446876} {:answer/id #uuid "7e0b0d8c-0464-5afe-8503-cacd0ae75675" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+2" :db/id #edb/ref 17592186446884} {:answer/id #uuid "805c8a50-245c-58af-bd42-b38be8fbdd2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-2" :db/id #edb/ref 17592186446885} {:answer/id #uuid "94c300a0-1022-5004-81fd-c22c0bf39989" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-\\frac{1}{2}" :db/id #edb/ref 17592186446890}] :answer-field/correct {:answer/id #uuid "805c8a50-245c-58af-bd42-b38be8fbdd2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-2" :db/id #edb/ref 17592186446885} :answer-field/id #uuid "11c4f691-19c6-5faa-97dd-197cfd379445" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446895}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9cea6c8e-15d8-5c1a-96d6-c4ced565f8d5" :question/math-academy-id "q-2576" :question/problem "Which of the following is equivalent to $\\frac{6x-4}{2}?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned}\\frac{6x-4}{2} &= \\frac{6x}{2}-\\frac{4}{2} \\\\ &= \\frac{6}{2}\\cdot x-\\frac{4}{2} \\\\ &= 3x-2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186459205 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a56a8231-fa23-5f97-b089-27fbbd678426" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186458921}] :answer-field/correct {:answer/id #uuid "a56a8231-fa23-5f97-b089-27fbbd678426" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186458921} :answer-field/id #uuid "a13a9d5d-2416-5caf-aa6b-9a5345f1752d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186459153}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "00c8c3c6-017f-53bd-8aef-13e6a3aec175" :question/math-academy-id "q-171540" :question/problem "$\\frac{5}{2}q-\\frac{7}{6}q=${{field-1}}\n$q$" :question/worked-solution "We combine the like terms by subtracting the coefficients:\n\n$$\n\\begin{aligned}\\frac{5}{2}q-\\frac{7}{6}q &= (\\frac{5}{2}-\\frac{7}{6})q\\end{aligned}\n$$\n\nIn order to subtract the coefficients, we have to convert them to have the same denominator:\n\n$$\n\\begin{aligned}(\\frac{5}{2}-\\frac{7}{6})q &= (\\frac{15}{6}-\\frac{7}{6})q \\\\ &= (\\frac{15-7}{6})q \\\\ &= \\frac{8}{6}q \\\\ &= \\frac{4}{3}\\,q\\end{aligned}\n$$"} {:db/id #edb/ref 17592186459206 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19813603-2ff6-5970-bfa0-a18fe649a92e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{y}{4}-4" :db/id #edb/ref 17592186458670} {:answer/id #uuid "2e952626-46ee-5082-8870-a4f12c88b01e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{y}{2}+4" :db/id #edb/ref 17592186458719} {:answer/id #uuid "6224b75f-2ecf-55a0-8d31-a1c8dd965483" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y}{8}" :db/id #edb/ref 17592186458797} {:answer/id #uuid "b79d8989-3956-514d-8613-e3f7d9d32e9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{y}{8}-4" :db/id #edb/ref 17592186458960} {:answer/id #uuid "ff65897b-ae3f-5dde-b154-c5eaeea76e9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y}{4}-2" :db/id #edb/ref 17592186459082}] :answer-field/correct {:answer/id #uuid "19813603-2ff6-5970-bfa0-a18fe649a92e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{y}{4}-4" :db/id #edb/ref 17592186458670} :answer-field/id #uuid "a52eccb8-b500-5312-ae2a-22b1fe553ea4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186459154}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "020fed93-fcd3-5223-ae8a-0e7f2cc99320" :question/math-academy-id "q-51440" :question/problem "$\\frac{y}{8}+7-\\frac{3y}{8}-11=$" :question/worked-solution "We collect and combine the like terms, simplifying the coefficients as much as possible:\n\n$$\n\\begin{aligned}\\frac{y}{8}+7-\\frac{3y}{8}-11 &= (\\frac{y}{8}-\\frac{3y}{8})+(7-11) \\\\ &= (\\frac{y-3y}{8})-4 \\\\ &= -\\frac{2y}{8}-4 \\\\ &= -\\frac{y}{4}-4\\end{aligned}\n$$"} {:db/id #edb/ref 17592186459226 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "079e330a-ed7c-5585-893b-009f113e791f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{5}m+11" :db/id #edb/ref 17592186458629} {:answer/id #uuid "6202db53-1c31-5b08-a010-38ef6126b872" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}m+6" :db/id #edb/ref 17592186458795} {:answer/id #uuid "6481e2e7-aaff-5589-acf0-e3b8ef29ba0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "m-7" :db/id #edb/ref 17592186458800} {:answer/id #uuid "652bbb0b-a61f-5ea0-8bdc-a045d8ae7042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8}{5}m-5" :db/id #edb/ref 17592186458805} {:answer/id #uuid "7bd3d776-8cef-5da7-94a2-8514d7604576" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{5}m+5" :db/id #edb/ref 17592186458848}] :answer-field/correct {:answer/id #uuid "7bd3d776-8cef-5da7-94a2-8514d7604576" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{5}m+5" :db/id #edb/ref 17592186458848} :answer-field/id #uuid "267a169a-8097-5d51-bee3-87afdd83ccc8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186459101}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "37caea09-08c3-57fc-903e-0d9f1b5634da" :question/math-academy-id "q-51439" :question/problem "$\\frac{2}{5}m+8-\\frac{6}{5}m-3=$" :question/worked-solution "We collect and combine the like terms, simplifying the coefficients as much as possible:\n\n$$\n\\begin{aligned}\\frac{2}{5}m+8-\\frac{6}{5}m-3 &= (\\frac{2}{5}m-\\frac{6}{5}m)+(8-3) \\\\ &= (\\frac{2-6}{5})m+5 \\\\ &= -\\frac{4}{5}m+5\\end{aligned}\n$$"} {:db/id #edb/ref 17592186459228 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "769c9f8d-44e3-5cb7-8aa3-d35e0ebe3590" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186458836}] :answer-field/correct {:answer/id #uuid "769c9f8d-44e3-5cb7-8aa3-d35e0ebe3590" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186458836} :answer-field/id #uuid "b9e6d683-4798-50e1-8613-685a14130585" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186459165} {:answer-field/choices [{:answer/id #uuid "1fedff19-9172-5d54-8787-5512405d7cfd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186458688}] :answer-field/correct {:answer/id #uuid "1fedff19-9172-5d54-8787-5512405d7cfd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186458688} :answer-field/id #uuid "c9a92f75-9f75-5e24-9502-2166440337ae" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186459176}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "382c9a42-23fb-50da-958e-822e7f1e9af7" :question/math-academy-id "q-178171" :question/problem "$2a+8(\\frac{5a}{2}-\\frac{b}{4})=${{field-1}}\n$a\\,-$\n{{field-2}}\n$b$" :question/worked-solution "First, we apply the distributive law:\n\n$$\n\\begin{aligned}2a+8(\\frac{5a}{2}-\\frac{b}{4}) &= 2a+8(\\frac{5a}{2})-8(\\frac{b}{4}) \\\\ &= 2a+\\frac{40a}{2}-\\frac{8b}{4} \\\\ &= 2a+20a-2b\\end{aligned}\n$$\n\nThen, we collect and combine the like terms, simplifying the coefficients as much as possible:\n\n$$\n\\begin{aligned}2a+20a-2b &= (2a+20a)-2b \\\\ &= 22\\,a-2\\,b\\end{aligned}\n$$"} {:db/id #edb/ref 17592186459231 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e58851f-dafe-5dcb-897c-397ab579ce85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186458683}] :answer-field/correct {:answer/id #uuid "1e58851f-dafe-5dcb-897c-397ab579ce85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186458683} :answer-field/id #uuid "e38e0faa-22d6-52a4-b086-cbb2f25306e6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186459189}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3db3f415-786b-5457-aad2-de0f20c99ed5" :question/math-academy-id "q-133641" :question/problem "Expressed as a polynomial in terms of $x,$ the length of Dan's plot of land is{{field-1}}\nyards." :question/worked-solution "The width of the plot is $x+2$  yards, and its area is $2{x}^{2}+4x$ square  yards. Since the $\\text{area}=\\text{length}\\times \\text{width},$ we factor the expression for the area to find the length.\n\nFirst, we find the $\\text{GCF}$ of the two terms:\n\n$$\n\\text{GCF}(2{x}^{2},4x)=2x\n$$\n\nThen, we rewrite each term in the original expression as a product with the $\\text{GCF}:$\n\n$$\n\\begin{aligned}2{x}^{2}+4x &= (2x\\cdot x)+(2x\\cdot 2)\\end{aligned}\n$$\n\nNext, we write the $\\text{GCF}$ outside the parentheses and keep the remaining terms inside:\n\n$$\n\\begin{aligned}(2x\\cdot x)+(2x\\cdot 2) &= 2x(x+2)\\end{aligned}\n$$\n\n \n\nAs a result, we conclude that the length of the plot must be $2x$ yards. \n\n![](images/3b/3b2ce07890c58ec158e3b939b933a9c97c5b3adeb8f7e7636a4bb471df80be03.png)"} {:db/id #edb/ref 17592186459240 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d480761-07cc-54fa-8c93-5f0e2a3f25b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-3" :db/id #edb/ref 17592186458646}] :answer-field/correct {:answer/id #uuid "0d480761-07cc-54fa-8c93-5f0e2a3f25b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-3" :db/id #edb/ref 17592186458646} :answer-field/id #uuid "0ecbbb3d-6c3d-53df-92d0-c6b505c2fabc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186459091}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "520f98f4-9505-5523-8b56-8c2da22c20e2" :question/math-academy-id "q-133644" :question/problem "![](images/2c/2c0b4f45715c1c328bc73b9f308aac68267a67d5017acd246ec7e30752710c8d.png)\n\nDan's neighbor to the south, John, has a land plot of area ${x}^{2}+x-12$ square yards, as shown in the picture. Given that the length of John's plot of land is $x+4$ yards, what is the width of the plot in terms of $x?$\n\nJohn's plot width is\n{{field-1}}\nyards." :question/worked-solution "To find the required width, we need to factor the expression ${x}^{2}+x-12.$\n\nFirst, we find the factor pairs of the constant term $(-12).$ The constant term is negative, so that means one of the factors is negative, and the other is positive:\n\n$$\n\\begin{aligned}1 & \\times (-12) \\\\ (-1) & \\times 12 \\\\ 2 & \\times (-6) \\\\ (-2) & \\times 6 \\\\ 3 & \\times (-4) \\\\ (-3) & \\times 4\\end{aligned}\n$$\n\n \n\nNow, we find which factor pair adds up to the coefficient of the linear term $1:$\n\n$$\n\\begin{aligned}1+(-12) & =-11 & \\times  \\\\ -1+12 & =11 & \\times  \\\\ 2+(-6) & =-4 & \\times  \\\\ -2+6 & =4 & \\times  \\\\ 3+(-4) & =-1 & \\times  \\\\ -3+4 & =1 & ✓\\end{aligned}\n$$\n\nUsing the factor pair identified above, write the linear term as $x=4x-3x:$\n\n$$\n\\begin{aligned}{x}^{2}+x-12 & ={x}^{2}+4x-3x-12\\end{aligned}\n$$\n\nFinally, we factor the first two terms and the last two terms separately, and then factor the expression completely:\n\n$$\n\\begin{aligned}{x}^{2}+4x-3x-12 &= ({x}^{2}+4x)+(-3x-12) \\\\ &= x(x+4)-3(x+4) \\\\ &= (x-3)(x+4)\\end{aligned}\n$$\n\nAs a result, we conclude that the width must be $x-3$ yards. \n\n![](images/3a/3a055374fa5f3e47f7c3f14c5289551b6c1ecbd6676da3e10aa71b549ab9af2a.png)"} {:db/id #edb/ref 17592186459268 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b415296-fd66-541d-b285-00af687bf3a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+4" :db/id #edb/ref 17592186458674}] :answer-field/correct {:answer/id #uuid "1b415296-fd66-541d-b285-00af687bf3a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+4" :db/id #edb/ref 17592186458674} :answer-field/id #uuid "c11ffe1a-6963-545f-8907-17ef245ddba2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186459169}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "aae19179-380d-501e-9fd2-7ef3ca82ec12" :question/math-academy-id "q-133643" :question/problem "![](images/ba/bae1c067ff90bded7fa991f0f48433598a1ab5df190f0bff437f161d643abfc3.png)\n\nA utility pole is located on the edge of Dan's land, as shown above. The distance from the right edge of Dan's plot to the pole is $x-4$ yards. Find the distance to the pole from the left edge as a function of $x.$\n\nThe required distance is \n{{field-1}}\nyards." :question/worked-solution "In part 1, we found that the length of Dan's plot is $2x$ yards.\n\nTo find the required distance, we need to subtract polynomials $2x$ and $x-4:$\n\nWe put a minus sign between the two polynomials, distribute it over the second polynomial, collect like terms, and then simplify:\n\n$$\n\\begin{aligned}(2x)-(x-4) &= 2x-x+4 \\\\ &= (2-1)x+4 \\\\ &= x+4\\end{aligned}\n$$"} {:db/id #edb/ref 17592186459288 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d14116a7-25cd-55f0-9feb-5d2b4683f446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186458991}] :answer-field/correct {:answer/id #uuid "d14116a7-25cd-55f0-9feb-5d2b4683f446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186458991} :answer-field/id #uuid "5c3af921-0dbd-532b-94fa-6556205e3ff7" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186459124} {:answer-field/choices [{:answer/id #uuid "21928bb2-a099-507a-a58a-1610176fa0b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186458695}] :answer-field/correct {:answer/id #uuid "21928bb2-a099-507a-a58a-1610176fa0b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186458695} :answer-field/id #uuid "9f51f4b4-8549-5d79-95d6-fb8ceebc3e8a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186459152}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cdd60168-9917-57e2-b45a-41f742c7ebef" :question/math-academy-id "q-178169" :question/problem "$2(\\frac{3x}{4}+2y)+\\frac{5x}{2}=${{field-1}}\n$x\\,+$\n{{field-2}}\n$y$" :question/worked-solution "First, we apply the distributive law:\n\n$$\n\\begin{aligned}2(\\frac{3x}{4}+2y)+\\frac{5x}{2} &= 2\\cdot \\frac{3x}{4}+2\\cdot 2y+\\frac{5x}{2} \\\\ &= \\frac{6x}{4}+4y+\\frac{5x}{2} \\\\ &= \\frac{3x}{2}+4y+\\frac{5x}{2}\\end{aligned}\n$$\n\nThen, we collect and combine the like terms, simplifying the coefficients as much as possible:\n\n$$\n\\begin{aligned}\\frac{3x}{2}+4y+\\frac{5x}{2} &= (\\frac{3x}{2}+\\frac{5x}{2})+4y \\\\ &= \\frac{3x+5x}{2}+4y \\\\ &= \\frac{8x}{2}+4y \\\\ &= 4\\,x+4\\,y\\end{aligned}\n$$"} {:db/id #edb/ref 17592186459293 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01c09e5b-7e4c-5782-8384-76280dc7cfdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23x}{35}+22" :db/id #edb/ref 17592186458618} {:answer/id #uuid "01c5e166-86c7-5683-922c-c6a72cf2a69d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{22x}{35}+23" :db/id #edb/ref 17592186458619} {:answer/id #uuid "3ca191ae-ecd6-5959-8171-b55afa13cc03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{35x}{23}-22" :db/id #edb/ref 17592186458744} {:answer/id #uuid "a539b382-351d-5f45-96fd-7219ec78e7f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23x}{35}-22" :db/id #edb/ref 17592186458920} {:answer/id #uuid "c4f90038-622c-52d6-84df-3ba78748cf1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{22x}{5}+23" :db/id #edb/ref 17592186458981}] :answer-field/correct {:answer/id #uuid "01c5e166-86c7-5683-922c-c6a72cf2a69d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{22x}{35}+23" :db/id #edb/ref 17592186458619} :answer-field/id #uuid "aa284a81-c607-55d4-8e5d-f033a3ac3d07" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186459158}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dc80fc0c-88ad-5f7a-b174-a89a65c11a38" :question/math-academy-id "q-100054" :question/problem "Simplify the expression $\\frac{6x}{5}+15-\\frac{4x}{7}+8.$" :question/worked-solution "We collect and combine the like terms, simplifying the coefficients as much as possible:\n\n$$\n\\begin{aligned}\\frac{6x}{5}+15-\\frac{4x}{7}+8 &= (\\frac{6x}{5}-\\frac{4x}{7})+(15+8) \\\\ &= (\\frac{42x}{35}-\\frac{20x}{35})+(15+8) \\\\ &= (\\frac{42x-20x}{35})+23 \\\\ &= \\frac{22x}{35}+23\\end{aligned}\n$$"} {:db/id #edb/ref 17592186459300 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ca43479-ad39-5336-a3b2-cd39406eb181" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "98" :db/id #edb/ref 17592186458643}] :answer-field/correct {:answer/id #uuid "0ca43479-ad39-5336-a3b2-cd39406eb181" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "98" :db/id #edb/ref 17592186458643} :answer-field/id #uuid "41ec5518-68f4-529d-a790-78e7045bf0f0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186459120}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "eedc1616-8911-59c0-a664-fbc46a72c752" :question/math-academy-id "q-133646" :question/problem "If $x=10\\,\\text{yd},$ what is the area of John's land plot?\n\nArea $\\,=$\n{{field-1}}\n${\\text{yd}}^{2}$" :question/worked-solution "To find the area, we have to evaluate the polynomial ${x}^{2}+x-12$ at $x=10.$\n\nSo, we substitute $x=10$ into the polynomial and simplify: \n\n$$\n\\begin{aligned}{x}^{2}+x-12 &= (10)^{2}+(10)-12 \\\\ &= 100+10-12 \\\\ &= 98\\end{aligned}\n$$\n\nTherefore, the area is $98\\,{\\text{yd}}^{2}.$"} {:db/id #edb/ref 17592186475915 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ae753e7-70e5-5221-84b1-e330ef9c348d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{10}" :db/id #edb/ref 17592186475651}] :answer-field/correct {:answer/id #uuid "8ae753e7-70e5-5221-84b1-e330ef9c348d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{10}" :db/id #edb/ref 17592186475651} :answer-field/id #uuid "87b88d6e-de4a-5887-8e9c-fdbdf319a532" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186475873}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0f1f731d-e9c5-5dff-95c0-76702cc6de15" :question/math-academy-id "q-171386" :question/problem "Evaluate the following:\n\n$\\sqrt[3]{-\\frac{1}{1,000}}=$\n{{field-1}}" :question/worked-solution "First, notice that the numbers $1$ and $1000$ are both perfect cubes.\n\nSo, to determine the value of $\\sqrt[3]{-\\frac{1}{1,000}},$ we express $-\\frac{1}{1,000}$ as a perfect cube:\n\n$$\n\\begin{aligned}\\sqrt[3]{-\\frac{1}{1,000}} &= \\sqrt[3]{\\frac{(-1)^{3}}{{10}^{3}}} \\\\ &= \\sqrt[3]{\\frac{(-1)\\cdot (-1)\\cdot (-1)}{10\\cdot 10\\cdot 10}} \\\\ &= \\sqrt[3]{(-\\frac{1}{10})\\cdot (-\\frac{1}{10})\\cdot (-\\frac{1}{10})} \\\\ &= \\sqrt[3]{{(-\\frac{1}{10})}^{3}} \\\\ &= -\\frac{1}{10}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186475916 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "612f3cb8-e5e7-5d6e-b940-51d288212baa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186475586}] :answer-field/correct {:answer/id #uuid "612f3cb8-e5e7-5d6e-b940-51d288212baa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186475586} :answer-field/id #uuid "8d432477-4db5-5583-ac69-893afb3defd6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186475875}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "10213554-6b50-5566-8a12-87c52f6a8607" :question/math-academy-id "q-186159" :question/problem "Evaluate the following:\n\n$\\sqrt[3]{\\frac{64}{27}}=$\n{{field-1}}" :question/worked-solution "First, notice that the numbers $64$ and $27$ are both perfect cubes. \n\nSo, to determine the value of $\\sqrt[3]{\\frac{64}{27}},$ we express $\\frac{64}{27}$ as a perfect cube:\n\n$$\n\\begin{aligned}\\sqrt[3]{\\frac{64}{27}} &= \\sqrt[3]{\\frac{{4}^{3}}{{3}^{3}}} \\\\ &= \\sqrt[3]{\\frac{4\\cdot 4\\cdot 4}{3\\cdot 3\\cdot 3}} \\\\ &= \\sqrt[3]{\\frac{4}{3}\\cdot \\frac{4}{3}\\cdot \\frac{4}{3}} \\\\ &= \\sqrt[3]{{(\\frac{4}{3})}^{3}} \\\\ &= \\frac{4}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186475944 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "baf6f1d2-fbec-5363-972f-cafbb43c97bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186475726}] :answer-field/correct {:answer/id #uuid "baf6f1d2-fbec-5363-972f-cafbb43c97bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186475726} :answer-field/id #uuid "404ad5b9-ee70-5fbe-8b26-e4e1a3d4eb2f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186475851} {:answer-field/choices [{:answer/id #uuid "3ab4c3b5-282b-5e0c-945f-fe042c9bdaca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186475524}] :answer-field/correct {:answer/id #uuid "3ab4c3b5-282b-5e0c-945f-fe042c9bdaca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186475524} :answer-field/id #uuid "dce83c35-0469-5e49-bd24-ced898bca6fd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186475898}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8bada953-d1ec-5430-baf3-32480cff3e3b" :question/math-academy-id "q-181301" :question/problem "The expression $10-(7u+8)$ can be written as{{field-1}}\n$-$\n{{field-2}}\n$u.$" :question/worked-solution "First, we remove the parentheses by distributing the negative sign. This gives\n\n$$\n10-7u-8.\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}10-7u-8 &= (10-8)-7u \\\\ &= 2-7\\,u\\end{aligned}\n$$"} {:db/id #edb/ref 17592186475946 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1605f4c-5e8c-5d13-a5c6-33118c45cc08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186475787}] :answer-field/correct {:answer/id #uuid "e1605f4c-5e8c-5d13-a5c6-33118c45cc08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186475787} :answer-field/id #uuid "55cc041c-1be5-5d06-aa0c-b583d8a885af" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186475859} {:answer-field/choices [{:answer/id #uuid "deb0ac8f-1163-57aa-b169-608958b1a87e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186475783}] :answer-field/correct {:answer/id #uuid "deb0ac8f-1163-57aa-b169-608958b1a87e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186475783} :answer-field/id #uuid "d16d18e8-ecbb-53f2-b58f-64ff0cd149b7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186475893}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8e87c3a3-adbf-5bc1-93e9-45cedd31d826" :question/math-academy-id "q-181400" :question/problem "The expression $15-3(k+3)$ can be written as{{field-1}}\n$-$\n{{field-2}}\n$k.$" :question/worked-solution "Notice that the expression we need to subtract from $15$ must be expanded using the distributive law.  \n\nSo first, let's write some big brackets around the expression in parentheses, keeping the minus sign *outside*.\n\n$$\n15-[3(k+3)]\n$$\n\nNext, we expand the expression inside the brackets using the distributive law. This gives\n\n$$\n15-[3k+9].\n$$\n\nNow, we remove the brackets by distributing the negative sign. This gives\n\n$$\n15-3k-9.\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}15-3k-9 &= (15-9)-3k \\\\ &= 6-3\\,k\\end{aligned}\n$$"}]
