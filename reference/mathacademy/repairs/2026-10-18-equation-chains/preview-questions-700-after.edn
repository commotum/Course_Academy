⁡(x),\\operatorname{sin}⁡(x)⟩}" :db/id #edb/ref 17592186397556} {:answer/id #uuid "330f62f3-2b9c-5888-9cec-d52701d82d24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{⟨1,1⟩}{⟨f(x),1⟩}" :db/id #edb/ref 17592186397557}] :answer-field/correct {:answer/id #uuid "fd0b285c-99a5-5dc6-b53e-349ca170a4bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2⟨f(x),1⟩}{⟨1,1⟩}" :db/id #edb/ref 17592186397555} :answer-field/id #uuid "7e635cb7-5fb0-5dc2-9345-111ede6d51d4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186397552}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "73b220ad-78ed-5227-b775-ed2065f7b0fd" :question/math-academy-id "q-341308" :question/problem "Let $F(x)=3x+1$ for $x\\in R,$ and let $f(x)$ be the $2\\pi $-periodic extension of $F$ from $x\\in [0,2\\pi )$ to $x\\in R.$ The Fourier series of $f$ is given by\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)).\n$$\n\nSelect the correct options in the expression for the coefficient ${a}_{0}$ below, where $⟨\\,,⟩$ denotes the usual inner product on functions over $[0,2\\pi ).$\n\n$$\n\\begin{aligned}{a}_{0} & ={{field-1}} \\\\  & ={{field-2}}\\,\\cdot \\,{{field-3}}\\end{aligned}\n$$" :question/worked-solution "The usual inner product of functions $f$ and $g$ over $x\\in [0,2\\pi )$ is given by\n\n$$\n⟨f(x),g(x)⟩={\\int }_{0}^{2\\pi }f(x)g(x)\\,\\text{d}x.\n$$\n\nFor a $2\\pi $-periodic function $f(x)$ that's piecewise continuous over $x\\in [0,2\\pi ),$ the Fourier series of $f$ is given by \n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\n$$\n\nwhere ${a}_{0},$ ${a}_{n},$ and ${b}_{n}$ are constants to be determined. \n\nNow, we find the inner product of $f(x)$ with $1:$\n\n$$\n\\begin{aligned}⟨f(x),1⟩ &= ⟨\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),1⟩ \\\\ &= ⟨\\frac{{a}_{0}}{2},1⟩+{\\sum }_{n=1}^{\\infty }⟨{a}_{n}\\operatorname{cos}⁡(nx),1⟩+{\\sum }_{n=1}^{\\infty }⟨{b}_{n}\\operatorname{sin}⁡(nx),1⟩ \\\\ &= \\frac{{a}_{0}}{2}⟨1,1⟩+{\\sum }_{n=1}^{\\infty }{a}_{n}⟨\\operatorname{cos}⁡(nx),1⟩+{\\sum }_{n=1}^{\\infty }{b}_{n}⟨\\operatorname{sin}⁡(nx),1⟩\\end{aligned}\n$$\n\nSince the functions\n$1,\\operatorname{sin}⁡(x),\\operatorname{cos}⁡(x),\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(2x),…$\nare orthogonal with respect to the defined inner product, the only nonzero term in the final expression above is\n\n$$\n\\frac{{a}_{0}}{2}⟨1,1⟩.\n$$\n\nComputing the inner product, we have\n\n$$\n\\begin{aligned}⟨1,1⟩ & ={\\int }_{0}^{2\\pi }1\\,\\text{d}x \\\\  & ={[x]}_{-0}^{2\\pi } \\\\  & =2\\pi .\\end{aligned}\n$$\n\nFinally, we obtain that\n\n$$\n\\begin{aligned}⟨f(x),1⟩ & =\\frac{{a}_{0}}{2}⟨1,1⟩ \\\\ {a}_{0} & =\\frac{2⟨f(x),1⟩}{⟨1,1⟩} \\\\ {a}_{0} & =\\frac{1}{\\pi }{\\int }_{0}^{2\\pi }f(x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot {\\int }_{0}^{2\\pi }(3x+1)\\,\\text{d}x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186402375 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b1137f1-8456-5fcb-b627-0a6bfcd1ccb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7{\\lambda }^{2}-9\\lambda +5=0" :db/id #edb/ref 17592186402377} {:answer/id #uuid "5e54758b-b04a-5e99-aba8-744f15c11790" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7{\\lambda }^{2}-9\\lambda -5=0" :db/id #edb/ref 17592186402378} {:answer/id #uuid "0cb98fd7-0760-5ff3-9e0a-7397b57a816d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9{\\lambda }^{2}-7\\lambda +5=0" :db/id #edb/ref 17592186402379} {:answer/id #uuid "3bcbf29d-5a75-567b-aab9-b022e535042d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{2}-9\\lambda +7=0" :db/id #edb/ref 17592186402380} {:answer/id #uuid "cd43344f-883e-5e1e-a891-2db669e2c3a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7{\\lambda }^{2}+9\\lambda +5=0" :db/id #edb/ref 17592186402381}] :answer-field/correct {:answer/id #uuid "7b1137f1-8456-5fcb-b627-0a6bfcd1ccb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7{\\lambda }^{2}-9\\lambda +5=0" :db/id #edb/ref 17592186402377} :answer-field/id #uuid "f7e55e1f-40ba-53f0-bfe4-bffbf8e87e07" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402376}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e617971d-af12-59ac-a1e1-3a955cbb7317" :question/math-academy-id "q-345274" :question/problem "$$\n-7{x}^{2}{y}^{″}+2x{y}^{′}+(x-5)y=0\n$$\n\nFind the indicial equation for a Frobenius series solution about the regular singular point $x=0$ of the differential equation above." :question/worked-solution "If $x=0$ is a regular singular point of a second-order homogeneous linear differential equation, then the method of Frobenius states that there is at least one solution of the form\n\n$$\ny={x}^{\\lambda }{\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n},\n$$\n\nwhere $\\lambda $ and ${a}_{n}$ for $n=0,1,2,…$ are constants.\n\nSubstituting this solution and its derivatives into the ODE, collecting like terms, and setting coefficients equal to zero, we obtain: \n\n- the indicial equation from the coefficients of the $n=0$ term for arbitrary ${a}_{0},$ and\n\n- a recurrence formula from the coefficients of the $n\\ge 1$ terms.\n\n**Step 1**: Write the solution $y$ as a Frobenius power series:\n\n$$\ny={x}^{\\lambda }{\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n}={\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{\\lambda +n}\n$$\n\n**Step 2**: Compute the derivatives ${y}^{′}$ and ${y}^{″}:$\n\n$$\n\\begin{aligned}{y}^{′} & ={\\sum }_{n=0}^{\\infty }(\\lambda +n){a}_{n}{x}^{\\lambda +n-1}, \\\\ {y}^{″} & ={\\sum }_{n=0}^{\\infty }(\\lambda +n-1)(\\lambda +n){a}_{n}{x}^{\\lambda +n-2}\\end{aligned}\n$$\n\n**Step 3**: Rewrite all the series so that they use the same index of summation.\n\nThe terms of the differential equation are\n\n$$\n\\begin{aligned}-7{x}^{2}{y}^{″} & =-7{x}^{2}\\cdot {\\sum }_{n=0}^{\\infty }(\\lambda +n-1)(\\lambda +n){a}_{n}{x}^{\\lambda +n-2} \\\\  & =-{\\sum }_{n=0}^{\\infty }7((\\lambda +n)^{2}-(\\lambda +n)){a}_{n}{x}^{\\lambda +n}, \\\\ 2x{y}^{′} & =2x\\cdot {\\sum }_{n=0}^{\\infty }(\\lambda +n){a}_{n}{x}^{\\lambda +n-1} \\\\  & ={\\sum }_{n=0}^{\\infty }2(\\lambda +n){a}_{n}{x}^{\\lambda +n}, \\\\ (x-5)y & =(x-5){\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{\\lambda +n} \\\\  & ={\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{\\lambda +n+1}-{\\sum }_{n=0}^{\\infty }5{a}_{n}{x}^{\\lambda +n}.\\end{aligned}\n$$\n\nIn the first sum of the $y$ term, we change the index of the summation by writing $m=n+1.$ This gives\n\n$$\n(x-5)y={\\sum }_{m=1}^{\\infty }{a}_{m-1}{x}^{\\lambda +m}-{\\sum }_{n=0}^{\\infty }5{a}_{n}{x}^{\\lambda +n}.\n$$\n\nThen, replacing $m$ with $n$ (since it does not matter which letter we use) and isolating the $n=0$ term gives\n\n$$\n(x-5)y={\\sum }_{n=1}^{\\infty }{a}_{n-1}{x}^{\\lambda +n}-5{a}_{0}{x}^{\\lambda }-{\\sum }_{n=1}^{\\infty }5{a}_{n}{x}^{\\lambda +n}.\n$$\n\nSimilarly, isolating the $n=0$ terms for the other terms in the ODE, we have\n\n$$\n\\begin{aligned}-7{x}^{2}{y}^{″} & =-7({\\lambda }^{2}-\\lambda ){a}_{0}{x}^{\\lambda }-{\\sum }_{n=1}^{\\infty }7((\\lambda +n)^{2}-(\\lambda +n)){a}_{n}{x}^{\\lambda +n}, \\\\ 2x{y}^{′} & =2\\lambda {a}_{0}{x}^{\\lambda }+{\\sum }_{n=1}^{\\infty }2(\\lambda +n){a}_{n}{x}^{\\lambda +n}.\\end{aligned}\n$$\n\n**Step 4**: Consolidate all the series into a single series that is equal to $0.$\n\nCollecting the terms for $n=0,$ we have\n\n$$\n\\begin{aligned}-7({\\lambda }^{2}-\\lambda ){a}_{0}{x}^{\\lambda }+2\\lambda {a}_{0}{x}^{\\lambda }-5{a}_{0}{x}^{\\lambda } &= (-7{\\lambda }^{2}+7\\lambda +2\\lambda -5){a}_{0}{x}^{\\lambda } \\\\ &= (-7{\\lambda }^{2}+9\\lambda -5){a}_{0}{x}^{\\lambda }.\\end{aligned}\n$$\n\nSimilarly, collecting terms for $n\\ge 1,$ we obtain an infinite series of the form\n${x}^{\\lambda }{\\sum }_{n=1}^{\\infty }{b}_{n}(\\lambda ){x}^{n},$\nfor some ${b}_{n}(\\lambda ),$ $n\\ge 1.$\nTherefore, substituting into the homogeneous ODE, we have\n\n$$\n\\begin{aligned}(-7{\\lambda }^{2}+2\\lambda -5){a}_{0}{x}^{\\lambda }+{x}^{\\lambda }{\\sum }_{n=1}^{\\infty }{b}_{n}(\\lambda ){x}^{n} & =0 \\\\ (-7{\\lambda }^{2}+2\\lambda -5){a}_{0}+{\\sum }_{n=1}^{\\infty }{b}_{n}(\\lambda ){x}^{n} & =0.\\end{aligned}\n$$\n\n**Step 5**:  Set the coefficients of the series equal to $0.$\n\nSetting the coefficient of the $n=0$ term equal to $0$ with arbitrary ${a}_{0}\\ne 0,$ we obtain the indicial equation:\n\n$$\n\\begin{aligned}(-7{\\lambda }^{2}+2\\lambda -5){a}_{0} & =0 \\\\ 7{\\lambda }^{2}-2\\lambda +5 & =0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186410427 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "482654bc-a522-5c5c-8a44-d4ee24bd95bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{10}+\\sqrt{3}+2\\sqrt{15}+3\\sqrt{2}}{7}" :db/id #edb/ref 17592186410251} {:answer/id #uuid "4b94d91c-f649-53fe-abf1-ed4fae112291" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10}+\\sqrt{3}+2\\sqrt{15}+3\\sqrt{2}}{14}" :db/id #edb/ref 17592186410254} {:answer/id #uuid "6c5459bc-05a6-570e-8c22-2d312daed4ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10}+\\sqrt{3}+2\\sqrt{15}}{7}" :db/id #edb/ref 17592186410273} {:answer/id #uuid "7b9e2051-9eec-5423-bfe6-d13f30f71ad4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10}+\\sqrt{3}+3\\sqrt{2}}{7}" :db/id #edb/ref 17592186410281} {:answer/id #uuid "f2b527ba-9c52-5c95-9e0f-cd91704806e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}+\\sqrt{3}+\\sqrt{10}+2\\sqrt{15}}{7}" :db/id #edb/ref 17592186410365}] :answer-field/correct {:answer/id #uuid "f2b527ba-9c52-5c95-9e0f-cd91704806e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}+\\sqrt{3}+\\sqrt{10}+2\\sqrt{15}}{7}" :db/id #edb/ref 17592186410365} :answer-field/id #uuid "c2ea22de-638e-5104-ae1a-904032c8e659" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410409}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "809412f4-737f-5a7f-aa0e-0c96aef026e3" :question/math-academy-id "q-293739" :question/problem "Rationalize the denominator of $\\frac{1+\\sqrt{6}}{\\sqrt{10}-\\sqrt{3}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{10}+\\sqrt{3}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{10}+\\sqrt{3},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{1+\\sqrt{6}}{\\sqrt{10}-\\sqrt{3}} &= \\frac{1+\\sqrt{6}}{\\sqrt{10}-\\sqrt{3}}\\cdot \\frac{\\sqrt{10}+\\sqrt{3}}{\\sqrt{10}+\\sqrt{3}} \\\\ &= \\frac{(1+\\sqrt{6})(\\sqrt{1}0+\\sqrt{3})}{(\\sqrt{10}-\\sqrt{3})(\\sqrt{1}0+\\sqrt{3})} \\\\ &= \\frac{\\sqrt{10}+\\sqrt{3}+\\sqrt{60}+\\sqrt{18}}{(\\sqrt{10})^{2}-(\\sqrt{3})^{2}} \\\\ &= \\frac{\\sqrt{10}+\\sqrt{3}+2\\sqrt{15}+3\\sqrt{2}}{10-3} \\\\ &= \\frac{3\\sqrt{2}+\\sqrt{3}+\\sqrt{10}+2\\sqrt{15}}{7}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186410432 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47d8d125-9abc-5899-89d9-d8880316794d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{b}-a}{4}" :db/id #edb/ref 17592186410250} {:answer/id #uuid "4a67fe05-eddb-551c-bfbb-b46c0a2ba0f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{a}-1}{4}" :db/id #edb/ref 17592186410252} {:answer/id #uuid "9575bbba-541f-5939-ab74-aaab428aa24b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{a}-\\sqrt{b}}{4b}" :db/id #edb/ref 17592186410298} {:answer/id #uuid "aa82d8aa-f13b-58b4-bb31-9edaa9f0fdd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{ab}-b}{4b}" :db/id #edb/ref 17592186410319} {:answer/id #uuid "bfacf6f8-3a02-5c30-9cd8-59f545117ccc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{ab}-1}{4b}" :db/id #edb/ref 17592186410332}] :answer-field/correct {:answer/id #uuid "aa82d8aa-f13b-58b4-bb31-9edaa9f0fdd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{ab}-b}{4b}" :db/id #edb/ref 17592186410319} :answer-field/id #uuid "66448a61-1f26-5e7e-a756-7e6120ce1b93" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410388}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9740bcef-2a83-552d-9db0-632ce64e6011" :question/math-academy-id "q-77886" :question/problem "Express $\\frac{\\sqrt{a}-\\sqrt{b}}{4\\sqrt{b}}\\,$ without radicals in the denominator." :question/worked-solution "To remove the radical $\\sqrt{b}$ from the denominator, we multiply both the numerator and denominator by $\\sqrt{b}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{a}-\\sqrt{b}}{4\\sqrt{b}} &= \\frac{\\sqrt{a}-\\sqrt{b}}{4\\sqrt{b}}\\cdot \\frac{\\sqrt{b}}{\\sqrt{b}} \\\\ &= \\frac{(\\sqrt{a}-\\sqrt{b})\\sqrt{b}}{4(\\sqrt{b})^{2}} \\\\ &= \\frac{\\sqrt{a}\\cdot \\sqrt{b}-(\\sqrt{b})^{2}}{4(\\sqrt{b})^{2}} \\\\ &= \\frac{\\sqrt{ab}-b}{4b}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186436442 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d22de40-ea9d-5b02-b173-001334c7aa47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186436406} {:answer/id #uuid "a179ef6b-2edf-5a1b-a42e-681c262094e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(\\operatorname{cos}⁡2-\\operatorname{cos}⁡1)" :db/id #edb/ref 17592186436416} {:answer/id #uuid "a9eea812-8b18-5d6c-8b4a-96c0c0fdf7a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186436418} {:answer/id #uuid "c036b8c0-7240-5495-8524-f123ce10d9ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(\\operatorname{sin}⁡2-\\operatorname{sin}⁡2)" :db/id #edb/ref 17592186436420} {:answer/id #uuid "e4e1cdb2-01c4-599a-b0e1-dac97bfc07ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡1-\\operatorname{csc}⁡2" :db/id #edb/ref 17592186436422}] :answer-field/correct {:answer/id #uuid "6d22de40-ea9d-5b02-b173-001334c7aa47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186436406} :answer-field/id #uuid "05543962-4127-57e7-802c-654a5d1cc094" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436426}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "67ca50b0-637c-5544-b80a-0086acfa0a59" :question/math-academy-id "q-114468" :question/problem "Calculate ${\\int }_{1}^{2}(2{sin}^{2}⁡(\\frac{x}{3}-1)-3+2{cos}^{2}⁡(\\frac{x}{3}-1))\\text{d}x.$" :question/worked-solution "From the identity ${sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta =1,$ with $\\theta =\\frac{x}{3}-1,$ we get \n\n$$\n\\begin{aligned}{sin}^{2}⁡(\\frac{x}{3}-1)+{cos}^{2}⁡(\\frac{x}{3}-1)=1.\\end{aligned}\n$$\n\nSubstituting the above into our integral gives\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}(2{sin}^{2}⁡(\\frac{x}{3}-1)-3+2{cos}^{2}⁡(\\frac{x}{3}-1))\\text{d}x &= {\\int }_{1}^{2}(2[{sin}^{2}⁡(\\frac{x}{3}-1)+{cos}^{2}⁡(\\frac{x}{3}-1)]-3)\\text{d}x \\\\ &= {\\int }_{1}^{2}(2(1)-3)\\text{d}x \\\\ &= -{\\int }_{1}^{2}\\text{d}x \\\\ &= -x\\,{|}_{1}^{2} \\\\ &= -(2-1) \\\\ &= -1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186443076 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cc3e59fe-fbeb-561a-9571-4860f2729517" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{81}{49}" :db/id #edb/ref 17592186443042}] :answer-field/correct {:answer/id #uuid "cc3e59fe-fbeb-561a-9571-4860f2729517" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{81}{49}" :db/id #edb/ref 17592186443042} :answer-field/id #uuid "72380fe8-b5f4-5ca0-9fd3-c403c8836a0a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186443060}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "397f8e4c-8a02-58fc-a48a-6b5a482557f8" :question/math-academy-id "q-185186" :question/problem "Expressed as an improper fraction or mixed number, ${(-\\frac{9}{7})}^{2}=${{field-1}}." :question/worked-solution "To work out ${(-\\frac{9}{7})}^{2},$ we multiply $-\\frac{9}{7}$ by itself:\n\n$$\n\\begin{aligned}{(-\\frac{9}{7})}^{2} &= (-\\frac{9}{7})\\cdot (-\\frac{9}{7}) \\\\ &= \\frac{9\\cdot 9}{7\\cdot 7} \\\\ &= \\frac{81}{49}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186443091 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1532522-099e-56ec-9764-1cc17c4b430e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{81}{4}" :db/id #edb/ref 17592186443037}] :answer-field/correct {:answer/id #uuid "b1532522-099e-56ec-9764-1cc17c4b430e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{81}{4}" :db/id #edb/ref 17592186443037} :answer-field/id #uuid "8014c3df-88df-588f-9988-d74a862c708c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186443065}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fa89591c-42d2-57e3-bfd4-69e840192bd4" :question/math-academy-id "q-185191" :question/problem "Expressed as an improper fraction or mixed number, ${(-\\frac{9}{2})}^{2}=${{field-1}}." :question/worked-solution "To work out ${(-\\frac{9}{2})}^{2},$ we multiply $-\\frac{9}{2}$ by itself:\n\n$$\n\\begin{aligned}{(-\\frac{9}{2})}^{2} &= (-\\frac{9}{2})\\cdot (-\\frac{9}{2}) \\\\ &= \\frac{9\\cdot 9}{2\\cdot 2} \\\\ &= \\frac{81}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186445149 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d235ff94-e2a3-51a0-b6bc-81a043590012" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-42" :db/id #edb/ref 17592186445132}] :answer-field/correct {:answer/id #uuid "d235ff94-e2a3-51a0-b6bc-81a043590012" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-42" :db/id #edb/ref 17592186445132} :answer-field/id #uuid "4415fb7e-0c64-568e-8b39-038589dcda18" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186445138} {:answer-field/choices [{:answer/id #uuid "9320fcd8-c