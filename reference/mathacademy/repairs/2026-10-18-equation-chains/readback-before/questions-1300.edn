/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4m+5n" :db/id #edb/ref 17592186618296} {:answer/id #uuid "61b4b95a-7a78-5472-a4e9-d8eaccff9f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4m-5n" :db/id #edb/ref 17592186618354} {:answer/id #uuid "ed441294-b6e4-5395-bdbf-cab1cad1f931" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2m+n" :db/id #edb/ref 17592186618565}] :answer-field/correct {:answer/id #uuid "61b4b95a-7a78-5472-a4e9-d8eaccff9f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4m-5n" :db/id #edb/ref 17592186618354} :answer-field/id #uuid "996a5f58-07a3-5902-8d08-3dd496df0075" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186618655}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "67c34126-3e17-5783-8e10-152299553c83" :question/math-academy-id "q-154860" :question/problem "$6m-8n-2m+3n=$" :question/worked-solution "First, we group the like terms.\n\n$$\n\\begin{aligned}6m-8n-2m+3n & = \\\\ \\underbrace{6m-2m}_{m\\text{ terms}}\\,+\\,\\underbrace{3n-8n}_{n\\text{ terms}}\\end{aligned}\n$$\n\nThen, we combine the like terms: \n\n$$\n\\begin{aligned}\\underbrace{6m-2m}\\,+\\,\\underbrace{3n-8n} & = \\\\ (6-2)m+(3-8)n & = \\\\ 4m-5n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186618759 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68fcac5c-9cac-5259-a33b-2a967b2596e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{y}+\\sqrt{y-1}}{8}" :db/id #edb/ref 17592186618364} {:answer/id #uuid "74e2a10a-8be0-56d4-a0b2-1ce11d687eec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4(\\sqrt{y}+\\sqrt{y-1})" :db/id #edb/ref 17592186618375} {:answer/id #uuid "cb6ec1db-7bb8-57fe-ae71-f3d6632996f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{y}+\\sqrt{y-1}}{2}" :db/id #edb/ref 17592186618505} {:answer/id #uuid "d1341f33-6fe2-5ece-a825-c5e55d46c783" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8(\\sqrt{y}-\\sqrt{y-1})" :db/id #edb/ref 17592186618512} {:answer/id #uuid "d3b08c70-d8cd-5de3-b078-311b7e402838" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8(\\sqrt{y}+\\sqrt{y-1})" :db/id #edb/ref 17592186618520}] :answer-field/correct {:answer/id #uuid "d3b08c70-d8cd-5de3-b078-311b7e402838" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8(\\sqrt{y}+\\sqrt{y-1})" :db/id #edb/ref 17592186618520} :answer-field/id #uuid "64441755-52f1-55f6-98ed-36405625f6ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186618633}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "690e4b34-240e-5372-a5e3-f666ad50d478" :question/math-academy-id "q-296025" :question/problem "Rationalize the denominator of $\\frac{8}{\\sqrt{y}-\\sqrt{y-1}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{y}+\\sqrt{y-1}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{y}+\\sqrt{y-1},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{8}{\\sqrt{y}-\\sqrt{y-1}} & = \\\\ \\frac{8}{\\sqrt{y}-\\sqrt{y-1}}\\cdot \\frac{\\sqrt{y}+\\sqrt{y-1}}{\\sqrt{y}+\\sqrt{y-1}} & = \\\\ \\frac{8(\\sqrt{y}+\\sqrt{y-1})}{(\\sqrt{y}+\\sqrt{y-1})(\\sqrt{y}-\\sqrt{y-1})} & = \\\\ \\frac{8(\\sqrt{y}+\\sqrt{y-1})}{(\\sqrt{y})^{2}-(\\sqrt{y-1})^{2}} & = \\\\ \\frac{8(\\sqrt{y}+\\sqrt{y-1})}{y-(y-1)} & = \\\\ \\frac{8(\\sqrt{y}+\\sqrt{y-1})}{1} & = \\\\ 8(\\sqrt{y}+\\sqrt{y-1}) & \\end{aligned}\n$$"} {:db/id #edb/ref 17592186618767 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c98e896-2ac0-5ec2-9338-46b59cd7c967" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5u+4v" :db/id #edb/ref 17592186618301} {:answer/id #uuid "67eb8e1c-2d59-5b54-9fca-0197327cece6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15u-4v" :db/id #edb/ref 17592186618361} {:answer/id #uuid "68bb56e1-309c-56c5-9409-98bde310330b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12u-3v" :db/id #edb/ref 17592186618363} {:answer/id #uuid "70c49df7-652e-50d1-9423-7e03b792186f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9uv" :db/id #edb/ref 17592186618368} {:answer/id #uuid "a71e8bc1-f8f3-5a9c-b294-89359e87d97c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12u+3v" :db/id #edb/ref 17592186618455}] :answer-field/correct {:answer/id #uuid "68bb56e1-309c-56c5-9409-98bde310330b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12u-3v" :db/id #edb/ref 17592186618363} :answer-field/id #uuid "96037457-e51d-5853-883b-cd3af2e10417" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186618653}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7741df1c-31b1-5f46-b5c9-34b3bfb750f2" :question/math-academy-id "q-51452" :question/problem "$10u+2v+2u-5v=$" :question/worked-solution "First, we group the like terms.\n\n$$\n\\begin{aligned}10u+2v+2u-5v & = \\\\ \\underbrace{10u+2u}_{u\\text{ terms}}+\\underbrace{2v-5v}_{v\\text{ terms}} & \\end{aligned}\n$$\n\nThen, we combine the like terms:\n\n$$\n\\begin{aligned}\\underbrace{10u+2u}+\\underbrace{2v-5v} & = \\\\ (10+2)u+(