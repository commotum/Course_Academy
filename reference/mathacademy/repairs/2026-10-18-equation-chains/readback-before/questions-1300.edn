"3324ede1-9061-5f0f-93f8-7a9f8d69c7c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5(\\sqrt{t+6}+\\sqrt{t})}{6}" :db/id #edb/ref 17592186618290} :answer-field/id #uuid "e57ab1c7-9043-5910-9a35-a52589b97e6e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186618702}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d269d576-e021-5e72-9293-c4bd39866a58" :question/math-academy-id "q-296026" :question/problem "Rationalize the denominator of $\\frac{5}{\\sqrt{t+6}-\\sqrt{t}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{t+6}+\\sqrt{t}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{t+6}+\\sqrt{t},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{5}{\\sqrt{t+6}-\\sqrt{t}} & = \\\\ \\frac{5}{\\sqrt{t+6}-\\sqrt{t}}\\cdot \\frac{\\sqrt{t+6}+\\sqrt{t}}{\\sqrt{t+6}+\\sqrt{t}} & = \\\\ \\frac{5(\\sqrt{t+6}+\\sqrt{t})}{(\\sqrt{t+6}+\\sqrt{t})(\\sqrt{t+6}-\\sqrt{t})} & = \\\\ \\frac{5(\\sqrt{t+6}+\\sqrt{t})}{(\\sqrt{t+6})^{2}-(\\sqrt{t})^{2}} & = \\\\ \\frac{5(\\sqrt{t+6}+\\sqrt{t})}{t+6-t} & = \\\\ \\frac{5(\\sqrt{t+6}+\\sqrt{t})}{6}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186618796 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e0555b5-ee1b-538e-8d5a-9287e3d894b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11t-3" :db/id #edb/ref 17592186618282} {:answer/id #uuid "5ed89d16-3238-54b2-ac66-ebd51cf23d2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12t-4w" :db/id #edb/ref 17592186618351} {:answer/id #uuid "737b37ed-a411-53d7-a305-e9c5687fc022" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9t-w" :db/id #edb/ref 17592186618371} {:answer/id #uuid "a01c7422-c334-588a-9e6c-c6d1fec86a5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8t-w-3" :db/id #edb/ref 17592186618441} {:answer/id #uuid "d35e364f-e722-52cc-bde8-5f04f93f3f80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12t-w-3" :db/id #edb/ref 17592186618518}] :answer-field/correct {:answer/id #uuid "d35e364f-e722-52cc-bde8-5f04f93f3f80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12t-w-3" :db/id #edb/ref 17592186618518} :answer-field/id #uuid "d13b18ec-d5f4-574b-a9ab-bfd600b0dedd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186618686}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d3eb239e-3851-5d44-a46a-60ed022ef12d" :question/math-academy-id "q-154857" :question/problem "$10t-3-w+2t=$" :question/worked-solution "We rearrange the terms so that the like terms, $10t$ and $2t$, are together.\n\n$$\n\\begin{aligned}10t-3-w+2t & = \\\\ \\underbrace{10t+2t}_{t\\text{ terms}}-w-3 & \\end{aligned}\n$$\n\nThen, we combine the like terms:\n\n$$\n\\begin{aligned}\\underbrace{10t+2t}-w-3 & = \\\\ (10+2)t-w-3 & = \\\\ 12t-w-3\\end{aligned}\n$$"} {:db/id #edb/ref 17592186618797 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58cd2dc8-5577-5026-b6f5-31a870401656" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186618338} {:answer/id #uuid "976ade02-6544-58fa-af09-2c78ae82bb75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x" :db/id #edb/ref 17592186618426} {:answer/id #uuid "9a6510ab-f7eb-5392-a119-d520db831e8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x" :db/id #edb/ref 17592186618430} {:answer/id #uuid "bc8e1f28-efb0-5e59-be73-d9df38735f41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186618487} {:answer/id #uuid "ee5a2e2f-9e7e-5406-b5ed-034856a2a3f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x" :db/id #edb/ref 17592186618567}] :answer-field/correct {:answer/id #uuid "bc8e1f28-efb0-5e59-be73-d9df38735f41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186618487} :answer-field/id #uuid "dad91ec7-fc5a-5d6c-a30f-3f33d1faf3be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186618692}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d6510599-38b6-5d88-b2dc-474b16c6228e" :question/math-academy-id "q-584" :question/problem "$-2x+5x-x=$" :question/worked-solution "We have three like terms, $-2x,$ $5x$ and $-x.$ To collect these like terms, we combine them into a single term, adding their coefficients:\n\n$$\n\\begin{aligned}-2x+5x-x & = \\\\ (-2+5-1)x & = \\\\ 2x\\end{aligned}\n$$"} {:db/id #edb/ref 17592186618804 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4af2bab-0bbd-58db-81d5-27bd457c6721" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186618476}] :answer-field/correct {:answer/id #uuid "b4af2bab-0bbd-58db-81d5-27bd457c6721" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186618476} :answer-field/id #uuid "42208ba0-3d6e-5efb-8809-212a0f857264" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186618616} {:answer-field/choices [{:answer/id #uuid "77118325-a899-5b39-8c1f-8be89fe7f6d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186618378}] :answer-field/correct {:answer/id #uuid "77118325-a899-5b39-8c1f-8be89fe7f6d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186618378} :answer-field/id #uuid "8a9a750e-0acc-55eb-b3a0-f4309d7ee630" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186618649}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e65fccdc-2c4d-5c06-af34-a33cfa63761d" :question/math-academy-id "q-178237" :question/problem "$9x-8x+7x+6=${{field-1}}\n$x\\,+$\n{{field-2}}" :question/worked-solution "We have three like terms, $9x,$ $-8x,$ and $7x.$ \n\nTo collect these like terms, we combine them into a single term, adding their coefficients:\n\n$$\n\\begin{aligned}9x-8x+7x+6 & = \\\\ (9-8+7)x+6 & = \\\\ 8\\,x+6\\end{aligned}\n$$"} {:db/id #edb/ref 17592186618805 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ecea1d32-fb27-5cf8-b3a5-bb9e2f002034" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186618564}] :answer-field/correct {:answer/id #uuid "ecea1d32-fb27-5cf8-b3a5-bb9e2f002034" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186618564} :answer-field/id #uuid "ad191715-d42a-5acf-9a3d-865181d14c69" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186618665} {:answer-field/choices [{:answer/id #uuid "fd259e6d-5800-52de-9f41-fad68c60dcd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186618589}] :answer-field/correct {:answer/id #uuid "fd259e6d-5800-52de-9f41-fad68c60dcd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186618589} :answer-field/id #uuid "b57eeb09-d880-5376-8ee4-29c4f96b329f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186618667}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "eaa266db-7589-51d7-a773-a87a63af5a57" :question/math-academy-id "q-178241" :question/problem "$3t+4t-5t+4r=${{field-1}}\n$t\\,+$\n{{field-2}}\n$r$" :question/worked-solution "We have three like terms, $3t,4t,$ and $-5t.$ \n\nTo collect these like terms, we combine them into a single term, adding their coefficients:\n\n$$\n\\begin{aligned}3t+4t-5t+4r & = \\\\ (3+4-5)t+4r & = \\\\ 2\\,t+4\\,r\\end{aligned}\n$$"} {:db/id #edb/ref 17592186619712 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66b403d8-ae27-561f-a9d9-06bb7ca8023d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186619327}] :answer-field/correct {:answer/id #uuid "66b403d8-ae27-561f-a9d9-06bb7ca8023d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186619327} :answer-field/id #uuid "687a85d5-987d-5033-89a1-d6d11c8082be" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186619640} {:answer-field/choices [{:answer/id #uuid "96218f5c-6d81-548b-8225-b12d38ba8171" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186619410}] :answer-field/correct {:answer/id #uuid "96218f5c-6d81-548b-8225-b12d38ba8171" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186619410} :answer-field/id #uuid "a4c08516-0ca2-598c-9ab5-d4dbd7000f92" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186619664}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0328346c-8cae-5ca3-82a4-e114768947ec" :question/math-academy-id "q-178177" :question/problem "$(4p+3q)\\cdot 2+5p=${{field-1}}\n$p\\,+$\n{{field-2}}\n$q$" :question/worked-solution "First, we distribute the $2$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}\\begin{aligned}(4p+3q)\\cdot 2+5p & = \\\\ 4p\\cdot 2+3q\\cdot 2+5p & = \\\\ (8p)+(6q)+5p & = \\\\ 8p+6q+5p\\end{aligned}\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n \n\n$$\n\\begin{aligned}8p+6q+5p & = \\\\ (8p+5p)+6q & = \\\\ 13\\,p+6\\,q\\end{aligned}\n$$"} {:db/id #edb/ref 17592186619715 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95f8f178-9646-5a69-bb59-9f2183ca2530" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186619409}] :answer-field/correct {:answer/id #uuid "95f8f178-9646-5a69-bb59-9f2183ca2530" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186619409} :answer-field/id #uuid "15fdc788-9141-591a-af76-f36106c247d1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186619600}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0706d4f3-08df-5f8d-85d6-a0c1cc1e3682" :question/math-academy-id "q-171722" :question/problem "![](images/11/1137416a3908a881ca6c53c79f95cb7edca2a89fecb4bf7a20d5b01bd47084b8.png)\n\nIn the diagram above, $∠AOB$ is $\\frac{1}{12}$ of a full turn. The degree measure of the angle is{{field-1}}${}^{∘}.$" :question/worked-solution "Remember that a full turn has a measure of ${360}^{∘}.$\n\nTherefore, the measure of $∠AOB$ is\n\n$$\n\\begin{aligned}\\frac{1}{12}\\times {360}^{∘} & = \\\\ \\frac{1\\times {360}^{∘}}{12} & = \\\\ \\frac{{360}^{∘}}{12} & = \\\\ {\\left(\\frac{360}{12}\\right)}^{∘} & \\end{aligned}\n$$\n\nTo solve this division problem, we use the fact that $360=36\\times 10,$ and then we swap the order of the multiplication and division, as follows:\n\n$$\n\\begin{aligned}\\frac{360}{12} & = \\\\ 360÷12 & = \\\\ 36\\times 10÷12 & = \\\\ (36÷12)\\times 10 & = \\\\ 3\\times 10 & = \\\\ 30 & \\end{aligned}\n$$\n\nTherefore, the measure of $∠AOB$ is ${30}^{∘}.$"} {:db/id #edb/ref 17592186619723 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2faf1ec-1a66-5e76-a5ca-6ad8ad823297" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186619566}] :answer-field/correct {:answer/id #uuid "f2faf1ec-1a66-5e76-a5ca-6ad8ad823297" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186619566} :answer-field/id #uuid "825a7a95-9d5b-5310-b2d6-11aaf1905cb6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186619651} {:answer-field/choices [{:answer/id #uuid "b187b768-e5f5-5bcc-8f98-ed43aa020f97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186619457}] :answer-field/correct {:answer/id #uuid "b187b768-e5f5-5bcc-8f98-ed43aa020f97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186619457} :answer-field/id #uuid "c0695288-4414-585b-98e3-426533ea2851" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186619685}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "13dfd038-c3e4-5e87-afd3-05dcebe9d23c" :question/math-academy-id "q-173715" :question/problem "$9t+(2t+5)\\cdot 5=${{field-1}}\n$t\\,+$\n{{field-2}}" :question/worked-solution "First, we distribute the $5$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}9t+(2t+5)\\cdot 5 & = \\\\ 9t+2t\\cdot 5+5\\cdot 5 & = \\\\ 9t+(10t)+(25) & = \\\\ 9t+10t+25 & \\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}9t+10t+25 & = \\\\ (9t+10t)+25 & = \\\\ 19\\,t+25\\end{aligned}\n$$"} {:db/id #edb/ref 17592186619726 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69d18270-5322-5b9d-b1ea-9b4bed054dda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186619333}] :answer-field/correct {:answer/id #uuid "69d18270-5322-5b9d-b1ea-9b4bed054dda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186619333} :answer-field/id #uuid "78c50a16-6240-54fb-b38c-cbfa35d3fb2d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186619646} {:answer-field/choices [{:answer/id #uuid "01d66b7b-a553-5822-ab9d-1d2a8ac27f4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186619156}] :answer-field/correct {:answer/id #uuid "01d66b7b-a553-5822-ab9d-1d2a8ac27f4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186619156} :answer-field/id #uuid "f90cf1f5-f6e6-5245-9bcc-bd902bb62e37" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186619707}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1af3bb65-ee1f-5e00-b86b-87b3dd14266c" :question/math-academy-id "q-178170" :question/problem "$\\frac{1}{3}(6s-15t)-7s=${{field-1}}\n$s\\,-$\n{{field-2}}\n$t$" :question/worked-solution "First, we apply the distributive law:\n\n$$\n\\begin{aligned}\\frac{1}{3}(6s-15t)-7s & = \\\\ \\frac{1}{3}\\cdot 6s-\\frac{1}{3}\\cdot 15t-7s & = \\\\ \\frac{6s}{3}-\\frac{15t}{3}-7s & = \\\\ 2s-5t-7s\\end{aligned}\n$$\n\nThen, we collect and combine the like terms, simplifying the coefficients as much as possible:\n\n$$\n\\begin{aligned}2s-5t-7s & = \\\\ (2s-7s)-5t & = \\\\ -5\\,s-5\\,t\\end{aligned}\n$$"} {:db/id #edb/ref 17592186619727 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1539c906-9b1a-588e-95de-5a274fc43714" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28d+9" :db/id #edb/ref 17592186619194} {:answer/id #uuid "178d350c-0027-506a-b2e1-aeadf589ab5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28d-9" :db/id #edb/ref 17592186619198} {:answer/id #uuid "6c4d17df-28a0-5d23-808d-eca1965f1f5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11d-5" :db/id #edb/ref 17592186619339} {:answer/id #uuid "6e8efb6c-bc7b-52a4-82f2-6d5e2eb8209c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24d+13" :db/id #edb/ref 17592186619341} {:answer/id #uuid "d6b2690a-f510-5ef3-9fe0-b33b688bcc27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22d-15" :db/id #edb/ref 17592186619523}] :answer-field/correct {:answer/id #uuid "1539c906-9b1a-588e-95de-5a274fc43714" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28d+9" :db/id #edb/ref 17592186619194} :answer-field/id #uuid "3d1ae0ed-7e8d-55cd-86ea-c26c4850fdcd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186619618}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2163f487-4820-513c-a2f5-0c3fb1d6029f" :question/math-academy-id "q-109137" :question/problem "$4(7d+6)-15=$" :question/worked-solution "First, we distribute the $4$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}\\begin{aligned}4(7d+6)-15 & = \\\\ 4\\cdot 7d+4\\cdot 6-15 & = \\\\ (28d)+(24)-15 & = \\\\ 28d+24-15 & \\end{aligned}\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}\\begin{aligned}28d+24-15 & = \\\\ 28d+(24-15) & = \\\\ 28d+9\\end{aligned}\\end{aligned}\n$$"}]
