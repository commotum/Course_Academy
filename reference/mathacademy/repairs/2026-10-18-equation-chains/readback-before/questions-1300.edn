}{6}\\cdot 3a+\\frac{1}{6}\\cdot 24b-\\frac{1}{6}\\cdot 36)+\\frac{7a}{2} & = \\\\ \\frac{3a}{6}+\\frac{24b}{6}-\\frac{36}{6}+\\frac{7a}{2} & = \\\\ \\frac{a}{2}+4b-6+\\frac{7a}{2}\\end{aligned}\n$$\n\nThen, we collect and combine the like terms, simplifying the coefficients as much as possible:\n\n$$\n\\begin{aligned}\\frac{a}{2}+4b-6+\\frac{7a}{2} & = \\\\ (\\frac{a}{2}+\\frac{7a}{2})+4b-6 & = \\\\ \\frac{a+7a}{2}+4b-6 & = \\\\ \\frac{8a}{2}+4b-6 & = \\\\ 4\\,a+4\\,b-6\\end{aligned}\n$$"} {:db/id #edb/ref 17592186612481 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34ad69f6-1c9e-580d-9a8a-6fa61f6e3679" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186611815}] :answer-field/correct {:answer/id #uuid "34ad69f6-1c9e-580d-9a8a-6fa61f6e3679" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186611815} :answer-field/id #uuid "390b88a7-9d1e-51e6-ab6e-9f9329ef5fa7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186612283} {:answer-field/choices [{:answer/id #uuid "c9436832-c699-5788-bd1c-4f400cf0c8e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186612118}] :answer-field/correct {:answer/id #uuid "c9436832-c699-5788-bd1c-4f400cf0c8e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186612118} :answer-field/id #uuid "8171c6da-cc1b-5b29-832e-8ccae90366aa" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186612327}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dd986eb9-437d-582c-814d-317bf330b94b" :question/math-academy-id "q-175596" :question/problem "$6(\