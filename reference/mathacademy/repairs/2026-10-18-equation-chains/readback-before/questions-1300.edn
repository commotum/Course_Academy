908b0-3074-507e-a7ee-16d42a7eb4e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.3" :db/id #edb/ref 17592186613310} {:answer/id #uuid "7a2a8e67-bcdd-52b4-b580-214cc547aa70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186613460} {:answer/id #uuid "b52d490b-16e3-584d-b038-94f3f74dc737" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.2" :db/id #edb/ref 17592186613538} {:answer/id #uuid "baeaade0-9a21-559e-8e07-396a6febc82c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186613546} {:answer/id #uuid "f990e2e0-1b0a-583e-9f3c-8ca68a868d36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5" :db/id #edb/ref 17592186613621}] :answer-field/correct {:answer/id #uuid "baeaade0-9a21-559e-8e07-396a6febc82c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186613546} :answer-field/id #uuid "9292b3b7-9426-5864-903a-190b64c2c9f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186613681}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ff5a47ff-7228-5b88-90c4-db2bd9b45939" :question/math-academy-id "q-62670" :question/problem "Given that the mean of the data set below is $6$, what is the mean absolute deviation of the data?\n\n$$\n7,\\,5,\\,9,\\,3\n$$" :question/worked-solution "Since we are given the mean ($6$), we subtract it from each number in the data set, find the absolute value of the results, and add all these together:\n\n$$\n\\begin{aligned}|7-6|+|5-6|+|9-6|+|3-6| & = \\\\ |\\,1\\,|+|-1|+|\\,3\\,|+|-3| & = \\\\ 1+1+3+3 & = \\\\ 8\\end{aligned}\n$$\n\nFinally, to calculate the mean absolute deviation (MAD), we divide the sum obtained above ($8$) by the total number of data points ($4$):\n\n$$\n\\text{MAD}=\\frac{8}{4}=2\n$$"} {:db/id #edb/ref 17592186616966 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4efe0d0f-f78c-5fd2-a000-236b75f98ab6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$12.5$ pounds" :db/id #edb/ref 17592186616509} {:answer/id #uuid "5d935bc2-f2c4-53d8-abfb-490bd4d3655e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10.5$ pounds" :db/id #edb/ref 17592186616541} {:answer/id #uuid "8da705ec-e1e8-599c-96d0-389908ae66c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$13$ pounds" :db/id #edb/ref 17592186616624} {:answer/id #uuid "91b6a7f0-acb6-58c7-bebd-602c02bd59b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$12$ pounds" :db/id #edb/ref 17592186616633} {:answer/id #uuid "d39efa9e-0be1-597e-ba38-8eb0e5b274d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ pounds" :db/id #edb/ref 17592186616753}] :answer-field/correct {:answer/id #uuid "d39efa9e-0be1-597e-ba38-8eb0e5b274d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ pounds" :db/id #edb/ref 17592186616753} :answer-field/id #uuid "8c605b0b-f139-58fc-aa70-a12c92672ef0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186616889}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5149f849-9f49-5a46-b85d-07f34cd9157a" :question/math-academy-id "q-91761" :question/problem "![](images/6b/6b537f6369284292bc2b736263fc41f529b1056f5f4ab75d9b9ef4096371cfcc.png)\n\nThe dot plot above shows the weights of a small group of basketball players (rounded to the nearest five pounds). What is the mean absolute deviation for this data if the mean is $252.5\\,\\text{lbs}?$" :question/worked-solution "The dot plot tells us the following:\n\n- $1$ player weighs $225$ pounds\n\n- $1$ player weighs $250$ pounds\n\n- $2$ players weigh $255$ pounds\n\n- $2$ players weigh $265$ pounds\n\nSo, we get the following data:\n\n$$\n225,\\,250,\\,255,\\,255,\\,265,\\,265\n$$\n\nNow, we subtract the mean from each number in the data set, find the absolute value of the results, and add all these together:\n\n$$\n\\begin{aligned}|225\\,-\\,252.5|+|250\\,-\\,252.5|+|255\\,-\\,252.5|+|255\\,-\\,252.5|+|265\\,-\\,252.5|+|265\\,-\\,252.5| & = \\\\ |-27.5|+|-2.5|+|\\,2.5\\,|+|\\,2.5\\,|+|\\,12.5\\,|+|\\,12.5\\,| & = \\\\ 27.5+2.5+2.5+2.5+12.5+12.5 & = \\\\ 60 & \\end{aligned}\n$$\n\nFinally, to calculate the mean absolute deviation (MAD), we divide the sum obtained above ($60$) by the total number of data points ($6$). This gives\n\n$$\n\\text{MAD}=\\frac{60}{6}=10.\n$$"} {:db/id #edb/ref 17592186616968 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09e26ea9-c8fe-506e-9e76-d27c8ec1ef16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186616393} {:answer/id #uuid "664d40a4-28a4-59ab-ade3-25fd1f717b1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7.5" :db/id #edb/ref 17592186616555} {:answer/id #uuid "80e2b201-9ad2-56a4-b7b3-5ef15d390eea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.5" :db/id #edb/ref 17592186616602} {:answer/id #uuid "be026d7d-d4d9-59f1-b2bf-3c7861a62067" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186616719} {:answer/id #uuid "d2af12e1-12d2-5050-a00a-9adffacd290b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186616752}] :answer-field/correct {:answer/id #uuid "d2af12e1-12d2-5050-a00a-9adffacd290b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186616752} :answer-field/id #uuid "ef480bb4-e399-585e-b52b-6d4357668c96" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186616931}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "52f0f8bc-b28d-58be-a2dd-94c24f37cf62" :question/math-academy-id "q-63041" :question/problem "![](images/a7/a7b19d2f5fb89f076d279ef492fff941da2b74f0ba31524cfdc1fd1637cf8273.png)\n\nGiven the dot plot above, what is the mean absolute deviation for this data?" :question/worked-solution "The dot plot tells us the following:\n\n- there are $3$ values in the data set equal to $3$\n\n- there are $2$ values in the data set equal to $6$\n\n- there is $1$ value in the data set equal to $12$\n\nSo, we get the following data:\n\n$$\n3,\\,3,\\,3,\\,6,\\,6,\\,12\n$$\n\nNow, we find the mean of the data:\n\n$$\n\\text{mean}=\\frac{(3\\times 3)+(6\\times 2)+(12\\times 1)}{6}=\\frac{33}{6}=5.5\n$$\n\nNext, we subtract the mean from each number in the data set, find the absolute value of the results, and add all these together:\n\n$$\n\\begin{aligned}|3-5.5|+|3-5.5|+|3-5.5|+|6-5.5|+|6-5.5|+|12-5.5| & = \\\\ |-2.5|+|-2.5|+|-2.5|+|\\,0.5\\,|+|\\,0.5\\,|+|\\,6.5\\,| & = \\\\ 2.5+2.5+2.5+0.5+0.5+6.5 & = \\\\ 15 & \\end{aligned}\n$$\n\nFinally, to calculate the mean absolute deviation (MAD), we divide the sum obtained above ($15$) by the total number of data points ($6$). This gives\n\n$$\n\\text{MAD}=\\frac{15}{6}=2.5\n$$"} {:db/id #edb/ref 17592186617008 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53d29a91-d03b-5d5a-a4ea-93b55b6f92d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10.5" :db/id #edb/ref 17592186616518} {:answer/id #uuid "933d8c82-efc4-54ad-8bca-fc3e9b7c0905" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186616638} {:answer/id #uuid "bd9506e2-f914-58ab-a8f7-b37672ac074c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.8" :db/id #edb/ref 17592186616718} {:answer/id #uuid "d68aef7b-4560-50c5-a969-91d0d62a2619" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21.2" :db/id #edb/ref 17592186616760} {:answer/id #uuid "eaf20551-8502-5cee-b32c-ce6e3f327cdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186616787}] :answer-field/correct {:answer/id #uuid "bd9506e2-f914-58ab-a8f7-b37672ac074c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.8" :db/id #edb/ref 17592186616718} :answer-field/id #uuid "d99bf9d4-b493-5f07-a9f8-6cfacb930a44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186616918}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ab11b605-486d-5289-bde7-4930069bb81c" :question/math-academy-id "q-63035" :question/problem "![](images/da/dabf69161df67ff05c0b7363d7c3941922d9f42567d27383ab5b2f37f5089f01.png)\n\nGiven the dot plot above, what is the mean absolute deviation for this data?" :question/worked-solution "The dot plot tells us the following:\n\n- there is $1$ value in the data set equal to $10$\n\n- there is $1$ value in the data set equal to $20$\n\n- there are $2$ values in the data set equal to $30$\n\n- there is $1$ value in the data set equal to $40$\n\nSo, we get the following data:\n\n$$\n10,\\,20,\\,30,\\,30,\\,40\n$$\n\nNow, we find the mean of the data:\n\n$$\n\\text{mean}=\\frac{(10\\times 1)+(20\\times 1)+(30\\times 2)+(40\\times 1)}{5}=\\frac{130}{5}=26\n$$\n\nNext, we subtract the mean from each number in the data set, find the absolute value of the results, and add all these together:\n\n$$\n\\begin{aligned}|10-26|+|20-26|+|30-26|+|30-26|+|40-26| & = \\\\ |-16|+|-6|+|\\,4\\,|+|\\,4\\,|+|\\,14\\,| & = \\\\ 16+6+4+4+14 & = \\\\ 44 & \\end{aligned}\n$$\n\nFinally, to calculate the mean absolute deviation (MAD), we divide the sum obtained above ($44$) by the total number of data points ($5$). This gives\n\n$$\n\\text{MAD}=\\frac{44}{5}=8.8.\n$$"} {:db/id #edb/ref 17592186617017 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "452452d9-2a4f-5972-8467-824616414caa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$ years" :db/id #edb/ref 17592186616486} {:answer/id #uuid "4e0de1ab-3e72-5524-a9aa-15f47e5e6ce7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$ years" :db/id #edb/ref 17592186616505} {:answer/id #uuid "544f3435-2f8f-5fb6-863d-1ed32492efc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ years" :db/id #edb/ref 17592186616519} {:answer/id #uuid "a52ae4ed-ba17-51d1-ac06-e9e074532567" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ years" :db/id #edb/ref 17592186616674} {:answer/id #uuid "d1b853ab-ef5b-5ec8-b3f7-67199dd72609" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ years" :db/id #edb/ref 17592186616751}] :answer-field/correct {:answer/id #uuid "544f3435-2f8f-5fb6-863d-1ed32492efc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ years" :db/id #edb/ref 17592186616519} :answer-field/id #uuid "b4b4dc40-cc78-5d58-90ab-d2a26e8b7ccd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186616902}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c702859e-f0cb-5b42-b933-7a97f4f11e31" :question/math-academy-id "q-91755" :question/problem "![](images/9e/9e1e1aa3d867537d814a529f11f48d24474263fe83582fb44e85829879d589bb.png)\n\nThe dot plot above shows the ages of a small group of university teachers.  What is the mean absolute deviation for this data if the mean is $30.5?$" :question/worked-solution "The dot plot tells us the following:\n\n- $2$ teachers are $28$ years old\n\n- $2$ teachers are $30$ years old\n\n- $1$ teacher is $31$ years old\n\n- $1$ teacher is $36$ years old\n\nSo, we get the following data:\n\n$$\n28,\\,28,\\,30,\\,30,\\,31,\\,36\n$$\n\nNow, we subtract the mean from each number in the data set, find the absolute value of the results, and add all these together:\n\n$$\n\\begin{aligned}|28-30.5|+|28-30.5|+|30-30.5|+|30-30.5|+|31-30.5|+|36-30.5| & = \\\\ |-2.5|+|-2.5|+|-0.5|+|-0.5|+|\\,0.5\\,|+|\\,5.5\\,| & = \\\\ 2.5+2.5+0.5+0.5+0.5+5.5 & = \\\\ 12 & \\end{aligned}\n$$\n\nFinally, to calculate the mean absolute deviation (MAD), we divide the sum obtained above ($12$) by the total number of data points ($6$). This gives\n\n$$\n\\text{MAD}=\\frac{12}{6}=2.\n$$"} {:db/id #edb/ref 17592186618718 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0150ab76-d338-5e2d-8ef7-ca36d13f46a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(\\sqrt{x+2}+\\sqrt{x})}{2}" :db/id #edb/ref 17592186618200} {:answer/id #uuid "2050afa8-2149-540e-83d1-1b7a44293898" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{x+2}-\\sqrt{x}}{2}" :db/id #edb/ref 17592186618260} {:answer/id #uuid "23a5ad34-f2ad-51df-8647-efbe6f2eb98e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(\\sqrt{x+2}-\\sqrt{x})" :db/id #edb/ref 17592186618269} {:answer/id #uuid "76c394dd-4c3c-5614-8b2a-85c486392ba4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{x}-\\sqrt{x+2}}{2}" :db/id #edb/ref 17592186618377} {:answer/id #uuid "b4087519-351f-5c47-a9ed-9b06c0687178" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{x+2}+\\sqrt{x}}{2}" :db/id #edb/ref 17592186618474}] :answer-field/correct {:answer/id #uuid "2050afa8-2149-540e-83d1-1b7a44293898" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{x+2}-\\sqrt{x}}{2}" :db/id #edb/ref 17592186618260} :answer-field/id #uuid "01b7b105-cb5f-5e97-9c5f-92de29fec603" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186618602}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0414c216-7613-5fa0-8e34-18a57af0957a" :question/math-academy-id "q-296020" :question/problem "Rationalize the denominator of $\\frac{1}{\\sqrt{x+2}+\\sqrt{x}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{x+2}-\\sqrt{x}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{x+2}-\\sqrt{x},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{1}{\\sqrt{x+2}+\\sqrt{x}} & = \\\\ \\frac{1}{\\sqrt{x+2}+\\sqrt{x}}\\cdot \\frac{\\sqrt{x+2}-\\sqrt{x}}{\\sqrt{x+2}-\\sqrt{x}} & = \\\\ \\frac{\\sqrt{x+2}-\\sqrt{x}}{(\\sqrt{x+2}+\\sqrt{x})(\\sqrt{x+2}-\\sqrt{x})} & = \\\\ \\frac{\\sqrt{x+2}-\\sqrt{x}}{(\\sqrt{x+2})^{2}-(\\sqrt{x})^{2}} & = \\\\ \\frac{\\sqrt{x+2}-\\sqrt{x}}{x+2-x} & = \\\\ \\frac{\\sqrt{x+2}-\\sqrt{x}}{2} & \\end{aligned}\n$$"} {:db/id #edb/ref 17592186618721 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c45bc791-d37b-5b25-a105-75447b774405" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186618499}] :answer-field/correct {:answer/id #uuid "c45bc791-d37b-5b25-a105-75447b774405" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186618499} :answer-field/id #uuid "c8e6f9b4-8eb1-5124-b4d7-607e454c0cce" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186618682} {:answer-field/choices [{:answer/id #uuid "02445df7-ce0a-578a-aaf6-86123d4000bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186618203}] :answer-field/correct {:answer/id #uuid "02445df7-ce0a-578a-aaf6-86123d4000bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186618203} :answer-field/id #uuid "f822ba94-1f22-5278-acbf-e2a4c57058d4" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186618714}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0cfd408d-13ed-57aa-83c3-9fe5b4b28e44" :question/math-academy-id "q-178227" :question/problem "$2x+5y+3y=${{field-1}}\n$x\\,+$\n{{field-2}}\n$y$" :question/worked-solution "We have two like terms, $5y$ and $3y.$ \n\nTo collect these like terms, we combine them into a single term, adding their coefficients:\n\n$$\n\\begin{aligned}2x+5y+3y & = \\\\ 2x+(5y+3y) & = \\\\ 2x+(5+3)y & = \\\\ 2\\,x+8\\,y\\end{aligned}\n$$"} {:db/id #edb/ref 17592186618723 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81d12d1a-1eed-5983-8706-6b270ecb5077" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{d(\\sqrt{d-4}-2)}{d+4}" :db/id #edb/ref 17592186618397} {:answer/id #uuid "9146be21-5efa-5b5b-844f-b639e8b7281b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{d(\\sqrt{d-4}-2)}{d+8}" :db/id #edb/ref 17592186618415} {:answer/id #uuid "a2c8c0a4-9e1b-5f8f-86c5-2a77f9b68a2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3d(\\sqrt{d-4}-2)}{d-4}" :db/id #edb/ref 17592186618445} {:answer/id #uuid "aa50ef5b-4f4e-5b30-879d-7d6bf82d1ecf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3d(\\sqrt{d-4}-2)}{d-8}" :db/id #edb/ref 17592186618459} {:answer/id #uuid "e8d62231-6133-5b3f-84ba-b067a42f2a0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3d(\\sqrt{d-4}-2)}{d-2}" :db/id #edb/ref 17592186618555}] :answer-field/correct {:answer/id #uuid "aa50ef5b-4f4e-5b30-879d-7d6bf82d1ecf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3d(\\sqrt{d-4}-2)}{d-8}" :db/id #edb/ref 17592186618459} :answer-field/id #uuid "cb9f72ee-76b2-533a-b193-ce11261e5d14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186618684}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0ebd8f8a-1a44-54a5-895c-3f0351865533" :question/math-academy-id "q-111089" :question/problem "Rationalize the denominator of $\\frac{3d}{\\sqrt{d-4}+2}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{d-4}-2.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{d-4}-2,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{3d}{\\sqrt{d-4}+2} & = \\\\ \\frac{3d}{\\sqrt{d-4}+2}\\cdot \\frac{\\sqrt{d-4}-2}{\\sqrt{d-4}-2} & = \\\\ \\frac{3d(\\sqrt{d-4}-2)}{(\\sqrt{d-4}+2)(\\sqrt{d-4}-2)} & = \\\\ \\frac{3d(\\sqrt{d-4}-2)}{(\\sqrt{d-4})^{2}-{2}^{2}} & = \\\\ \\frac{3d(\\sqrt{d-4}-2)}{d-4-4} & = \\\\ \\frac{3d(\\sqrt{d-4}-2)}{d-8} & \\end{aligned}\n$$"} {:db/id #edb/ref 17592186618726 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02a274bc-c92b-53b3-8cda-676b2a8dfa2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6b-3" :db/id #edb/ref 17592186618206} {:answer/id #uuid "5913b57f-9e31-516c-9f3e-96fb409ea111" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2b+3" :db/id #edb/ref 17592186618339} {:answer/id #uuid "7a03ffcd-68d1-58dd-b66c-a28891c00431" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4b-3" :db/id #edb/ref 17592186618384} {:answer/id #uuid "974251e3-c4ff-5f61-a5ef-a559f4d4bdc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4b+3" :db/id #edb/ref 17592186618424} {:answer/id #uuid "ffebaa60-9608-50b4-ad74-2bbf9923f1ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2b-3" :db/id #edb/ref 17592186618600}] :answer-field/correct {:answer/id #uuid "7a03ffcd-68d1-58dd-b66c-a28891c00431" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4b-3" :db/id #edb/ref 17592186618384} :answer-field/id #uuid "5b6694a3-269c-540d-a0cf-47cbbc74f3ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186618627}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "185c99a1-f0b5-56d8-aabf-d98a5537bfd9" :question/math-academy-id "q-75673" :question/problem "$3b-3+b=$" :question/worked-solution "We rearrange the terms so that the like terms, $3b$ and $b$, are together.\n\n$$\n\\begin{aligned}3b-3+b & = \\\\ \\underbrace{3b+b}_{b\\text{ terms}}-3 & \\end{aligned}\n$$\n\nThen, we combine the like terms: \n\n$$\n\\begin{aligned}\\underbrace{3b+b}-3 & = \\\\ (3+1)b-3 & = \\\\ 4b-3\\end{aligned}\n$$"} {:db/id #edb/ref 1759218661