592186045498 :db/ident :answer.type/math} :answer/value "m^{10}\\cdot n^{18}" :db/id #edb/ref 17592186577489} {:answer/id #uuid "e8c7dbe3-dcec-56bc-927f-ad918bc9216e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "m^{20}\\cdot n^{19}" :db/id #edb/ref 17592186577495} {:answer/id #uuid "f64f165d-a3a3-5d03-85e8-894a90a37cc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "m^{22}\\cdot n^{17}" :db/id #edb/ref 17592186577496}] :answer-field/correct {:answer/id #uuid "acb8778d-5f88-5e13-af7b-1d7e2468719f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "m^{14}\\cdot n^{10}" :db/id #edb/ref 17592186577484} :answer-field/id #uuid "8d9fd41d-a6f8-5b6e-9d38-cb41816ecd32" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186577482}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fdc8adc0-252e-517c-a0e7-37b14255c97b" :question/problem "Use exponents to rewrite the product $n^{2}\\cdot n\\cdot m^{6}\\cdot n^{3}\\cdot m^{3}\\cdot m^{5}\\cdot n^{4}.$" :question/worked-solution "Here we have 2 variables, $m$ and $n$. We will start by grouping the bases separately:\n\n$$\n\\begin{aligned}n^{2}\\cdot n\\cdot m^{6}\\cdot n^{3}\\cdot m^{3}\\cdot m^{5}\\cdot n^{4} &= \\\\ (m^{6}\\cdot m^{3}\\cdot m^{5})\\cdot (n^{2}\\cdot n^{1}\\cdot n^{3}\\cdot n^{4})\\end{aligned}\n$$\n\nThis way, we can apply the product rule to the bases independently. An unwritten exponent is 1:\n\n$$\n\\begin{aligned}(m^{6}\\cdot m^{3}\\cdot m^{5})\\cdot (n^{2}\\cdot n^{1}\\cdot n^{3}\\cdot n^{4}) &= \\\\ m^{(6+3+5)}\\cdot n^{(2+1+3+4)} &= \\\\ m^{14}\\cdot n^{10}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186583600 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1209f55a-acc6-566a-94e4-cac49f8199cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3-3\\sqrt{a}}{7-a}" :db/id #edb/ref 17592186583191} {:answer/id #uuid "3a3a561e-412d-5a9d-ab76-9b013ee6d04c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21+3\\sqrt{a}}{49-a}" :db/id #edb/ref 17592186583257} {:answer/id #uuid "3aacf336-b8a8-5702-9bca-e18144df37f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21+\\sqrt{a}}{49+a}" :db/id #edb/ref 17592186583258} {:answer/id #uuid "cf8c5ccd-a62d-5c66-98c0-fee93a763a38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21-3\\sqrt{a}}{49-a}" :db/id #edb/ref 17592186583447} {:answer/id #uuid "e76b8063-b611-5f82-9a03-ca140c9e07ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7-3\\sqrt{a}}{7+a}" :db/id #edb/ref 17592186583473}] :answer-field/correct {:answer/id #uuid "cf8c5ccd-a62d-5c66-98c0-fee93a763a38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21-3\\sqrt{a}}{49-a}" :db/id #edb/ref 17592186583447} :answer-field/id #uuid "5869cc8c-e3ed-5c11-9d00-ee93fd437bc7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186583534}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "41c40def-df62-5d1f-a7f3-ac0eedebf282" :question/math-academy-id "q-34851" :question/problem "Rationalize the denominator of $\\frac{3}{7+\\sqrt{a}}.$" :question/worked-solution "First, note that the denominator's conjugate is $7-\\sqrt{a}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $7-\\sqrt{a},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{3}{7+\\sqrt{a}} & = \\\\ \\frac{3}{7+\\sqrt{a}}\\cdot \\frac{7-\\sqrt{a}}{7-\\sqrt{a}} & = \\\\ \\frac{3(7-\\sqrt{a})}{(7+\\sqrt{a})(7-\\sqrt{a})} & = \\\\ \\frac{21-3\\sqrt{a}}{{7}^{2}-(\\sqrt{a})^{2}} & = \\\\ \\frac{21-3\\sqrt{a}}{49-a}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186583644 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "320951cc-e499-5902-83fa-0d2e559d44b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{x-3}+1}{x+4}" :db/id #edb/ref 17592186583245} {:answer/id #uuid "4e636aad-044d-5aee-8d04-c5876ae2f076" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{x-3}-1}{x-4}" :db/id #edb/ref 17592186583279} {:answer/id #uuid "9988722f-fa63-52de-a00c-fb960fdd64c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{x-3}+1}{x-2}" :db/id #edb/ref 17592186583370} {:answer/id #uuid "d91dddfc-c2b6-51ed-a138-5665f52e9285" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{x-3}-1}{x+2}" :db/id #edb/ref 17592186583452} {:answer/id #uuid "e6b120bb-3ae5-58bf-9d1b-0c50a440a6d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{x-3}+1}{x-4}" :db/id #edb/ref 17592186583471}] :answer-field/correct {:answer/id #uuid "4e636aad-044d-5aee-8d04-c5876ae2f076" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{x-3}-1}{x-4}" :db/id #edb/ref 17592186583279} :answer-field/id #uuid "5f2c6e37-9e4c-5bbb-86af-0200953bfc4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186583536}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d756be6a-a1ee-5750-ae84-d5d413e96766" :question/math-academy-id "q-85381" :question/problem "Rationalize the denominator of $\\frac{1}{\\sqrt{x-3}+1}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{x-3}-1.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{x-3}-1,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{1}{\\sqrt{x-3}+1} & = \\\\ \\frac{1}{\\sqrt{x-3}+1}\\cdot \\frac{\\sqrt{x-3}-1}{\\sqrt{x-3}-1} & = \\\\ \\frac{\\sqrt{x-3}-1}{(\\sqrt{x-3}+1)(\\sqrt{x-3}-1)} & = \\\\ \\frac{\\sqrt{x-3}-1}{(\\sqrt{x-3})^{2}-{1}^{2}} & = \\\\ \\frac{\\sqrt{x-3}-1}{x-3-1} & = \\\\ \\frac{\\sqrt{x-3}-1}{x-4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186583653 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15ee1a93-1a22-5769-b086-28bac6dc4dcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{4p}-p}{1-p}" :db/id #edb/ref 17592186583196} {:answer/id #uuid "16c2fac0-2504-5197-8f22-d9a02d3a2661" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{8p}-2p}{2-p}" :db/id #edb/ref 17592186583199} {:answer/id #uuid "1caa8d11-4a60-5334-856b-b35b8b4bb13f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{8p}-p}{1-p}" :db/id #edb/ref 17592186583212} {:answer/id #uuid "2fbaac26-a778-57cd-9392-1e21e62ca3c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{8p}-2p}{8p-4{p}^{2}}" :db/id #edb/ref 17592186583242} {:answer/id #uuid "c3010278-9762-52cd-93d6-f080033a58b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{8p}-2p}{4p}" :db/id #edb/ref 17592186583429}] :answer-field/correct {:answer/id #uuid "16c2fac0-2504-5197-8f22-d9a02d3a2661" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{8p}-2p}{2-p}" :db/id #edb/ref 17592186583199} :answer-field/id #uuid "48d57c8f-10ce-5acb-8ab4-a2461f28cc38" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186583524}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ee6dcc16-5260-5152-924b-43327c21fdeb" :question/math-academy-id "q-34865" :question/problem "Rationalize the denominator of $-\\frac{4p}{\\sqrt{8p}+2p}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{8p}-2p.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{8p}-2p,$ and simplify:\n\n$$\n\\begin{aligned}-\\frac{4p}{\\sqrt{8p}+2p} & = \\\\ -\\frac{4p}{\\sqrt{8p}+2p}\\cdot \\frac{\\sqrt{8p}-2p}{\\sqrt{8p}-2p} & = \\\\ -\\frac{4p(\\sqrt{8p}-2p)}{(\\sqrt{8p}+2p)(\\sqrt{8p}-2p)} & = \\\\ -\\frac{4p(\\sqrt{8p}-2p)}{(\\sqrt{8p})^{2}-(2p)^{2}} & = \\\\ -\\frac{4p(\\sqrt{8p}-2p)}{8p-4{p}^{2}} & = \\\\ -\\frac{\\cancel{4p}(\\sqrt{8p}-2p)}{\\cancel{4p}(2-p)} & = \\\\ -\\frac{\\sqrt{8p}-2p}{2-p}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186583658 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ce8153b-20a6-5c46-a1fa-b17a7b366d2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{z}^{2}(2+\\sqrt{z})}{2(z-1)}" :db/id #edb/ref 17592186583185} {:answer/id #uuid "8a651490-655f-592f-9713-6f431f80c534" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{z}^{2}(2+\\sqrt{z})}{z-1}" :db/id #edb/ref 17592186583352} {:answer/id #uuid "8b3e1aab-d085-5fe5-993c-2a1a46a748de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{z}^{2}(1+\\sqrt{z})}{2(z-1)}" :db/id #edb/ref 17592186583355} {:answer/id #uuid "9b308021-186e-5f13-b21c-8263f2f6ae4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{z}^{2}(1+\\sqrt{z})}{z-1}" :db/id #edb/ref 17592186583372} {:answer/id #uuid "ded6e117-3c1e-5962-be9a-a4430376399b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{z}^{2}(2+\\sqrt{z})}{z-1}" :db/id #edb/ref 17592186583458}] :answer-field/correct {:answer/id #uuid "9b308021-186e-5f13-b21c-8263f2f6ae4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{z}^{2}(1+\\sqrt{z})}{z-1}" :db/id #edb/ref 17592186583372} :answer-field/id #uuid "24a9aa48-b086-58a4-8b7f-6a2e3e996f4f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186583514}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f61c7520-c78b-5a8b-8259-42034d000f14" :question/math-academy-id "q-111074" :question/problem "Rationalize the denominator of $-\\frac{2{z}^{2}}{1-\\sqrt{z}}.$" :question/worked-solution "First, note that the denominator's conjugate is $1+\\sqrt{z}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $1+\\sqrt{z},$ and simplify:\n\n$$\n\\begin{aligned}-\\frac{2{z}^{2}}{1-\\sqrt{z}} & = \\\\ -\\frac{2{z}^{2}}{1-\\sqrt{z}}\\cdot \\frac{1+\\sqrt{z}}{1+\\sqrt{z}} & = \\\\ -\\frac{2{z}^{2}(1+\\sqrt{z})}{(1-\\sqrt{z})(1+\\sqrt{z})} & = \\\\ -\\frac{2{z}^{2}(1+\\sqrt{z})}{{1}^{2}-(\\sqrt{z})^{2}} & = \\\\ -\\frac{2{z}^{2}(1+\\sqrt{z})}{1-z} & = \\\\ \\frac{2{z}^{2}(1+\\sqrt{z})}{z-1} & \\end{aligned}\n$$"} {:db/id #edb/ref 17592186584336 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cb21269-b5c0-5756-9ccb-68431bf02aa6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{m}^{2}-100}}{m-10}" :db/id #edb/ref 17592186583800} {:answer/id #uuid "918fc1ab-7721-5224-a702-7c4977368aac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{m}^{2}+100}}{m+10}" :db/id #edb/ref 17592186584024} {:answer/id #uuid "d619a806-2c08-5279-894a-465d759f87e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{m}^{2}-10}}{m-10}" :db/id #edb/ref 17592186584154} {:answer/id #uuid "da3034d3-341c-5661-9301-f8600cd6297d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{m}^{2}-10}}{m+10}" :db/id #edb/ref 17592186584159} {:answer/id #uuid "e0ad3125-861f-5558-87ef-5227f78d0bcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{m-100}}{m-10}" :db/id #edb/ref 17592186584173}] :answer-field/correct {:answer/id #uuid "0cb21269-b5c0-5756-9ccb-68431bf02aa6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{m}^{2}-100}}{m-10}" :db/id #edb/ref 17592186583800} :answer-field/id #uuid "291ee914-efbb-5b9b-a6f0-dee27cd5fa15" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186584249}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "15dbf470-01ad-555f-8188-b6e8c9b18aac" :question/math-academy-id "q-34960" :question/problem "Express $\\sqrt{\\frac{m+10}{m-10}}\\,$ without radicals in the denominator." :question/worked-solution "First, we apply the quotient rule and put the numerator and denominator under separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{\\frac{m+10}{m-10}} & =\\frac{\\sqrt{m+10}}{\\sqrt{m-10}}\\end{aligned}\n$$\n\nTo remove the radical $\\sqrt{m-10}$ from the denominator, we multiply both the numerator and denominator by $\\sqrt{m-10}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{m+10}}{\\sqrt{m-10}} & = \\\\ \\frac{\\sqrt{m+10}}{\\sqrt{m-10}}\\cdot \\frac{\\sqrt{m-10}}{\\sqrt{m-10}} & = \\\\ \\frac{\\sqrt{m+10}\\cdot \\sqrt{m-10}}{\\sqrt{m-10}\\cdot \\sqrt{m-10}} & = \\\\ \\frac{\\sqrt{(m+10)(m-10)}}{(\\sqrt{m-10})^{2}} & = \\\\ \\frac{\\sqrt{{m}^{2}-{10}^{2}}}{m-10} & = \\\\ \\frac{\\sqrt{{m}^{2}-100}}{m-10}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186584397 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a239b86-9aab-5ed5-b1a4-334ae7bbe6bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "w=\\frac{4}{3}" :db/id #edb/ref 17592186583822} {:answer/id #uuid "42a14c78-daf5-5a02-a316-48591f2dbe77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "w=\\pm 2" :db/id #edb/ref 17592186583878} {:answer/id #uuid "7af77269-29fc-57ca-81f5-81b768d4027d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "w=\\frac{4}{3},\\pm \\sqrt{3}" :db/id #edb/ref 17592186583977} {:answer/id #uuid "8557667a-d63f-5c3f-97ca-5ce2ccd9f946" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "w=\\pm \\frac{4\\sqrt{3}}{3}" :db/id #edb/ref 17592186583996} {:answer/id #uuid "b6339360-a5ee-56bd-a30f-b2554d5b16d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "w=\\frac{3}{2}" :db/id #edb/ref 17592186584091}] :answer-field/correct {:answer/id #uuid "1a239b86-9aab-5ed5-b1a4-334ae7bbe6bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "w=\\frac{4}{3}" :db/id #edb/ref 17592186583822} :answer-field/id #uuid "cfe04e5f-afa3-52d9-baad-be9069fd8238" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186584313}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a51054b6-5c18-5c53-bfd4-85bb3d43aae2" :question/math-academy-id "q-114191" :question/problem "Find all of the real solutions to the equation $3{w}^{3}-4{w}^{2}+12w-16=0.$" :question/worked-solution "We proceed to factor the left-hand side by grouping:\n\n$$\n\\begin{aligned}3{w}^{3}-4{w}^{2}+12w-16 & = \\\\ (3{w}^{3}-4{w}^{2})+(12w-16) & = \\\\ {w}^{2}(3w-4)+4(3w-4) & = \\\\ (3w-4)\\cdot {w}^{2}+(3w-4)\\cdot 4 & = \\\\ (3w-4)({w}^{2}+4) & \\end{aligned}\n$$\n\nThen, we solve $(3w-4)({w}^{2}+4)=0$ by setting each factor equal to $0.$\n\n- Setting the factor $(3w-4)$ equal to $0,$ we get\n\n$$\n\\begin{aligned}3w-4 & =0 \\\\ 3w & =4 \\\\ w & =\\frac{4}{3}.\\end{aligned}\n$$\n\n- Setting the factor $({w}^{2}+4)$ equal to $0,$ we get\n\n$$\n\\begin{aligned}{w}^{2}+4 & =0 \\\\ {w}^{2} & =-4.\\end{aligned}\n$$\n\nSince a squared real number cannot be negative, the equation ${w}^{2}+4=0$ has no real solutions.\n\nTherefore,  $w=\\frac{4}{3}$ is the only real solution."} {:db/id #edb/ref 17592186584399 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01f4dcb9-37c4-50c1-b4f3-57996a98263c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{pr}}{{r}^{3}}" :db/id #edb/ref 17592186583775} {:answer/id #uuid "0590492e-3ee0-5233-96c7-ef191c26ab6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7pr}}{14{r}^{2}}" :db/id #edb/ref 17592186583785} {:answer/id #uuid "167a2cc9-4e52-5571-854a-db2d3976dabf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{pr}}{7r}" :db/id #edb/ref 17592186583819} {:answer/id #uuid "6678101c-81b1-5b43-9919-e791dbf93f4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{7pr}}{7{r}^{3}}" :db/id #edb/ref 17592186583934} {:answer/id #uuid "be05706e-cf3a-52d7-8fc5-7cdaac3e1473" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{pr}}{7{r}^{3}}" :db/id #edb/ref 17592186584108}] :answer-field/correct {:answer/id #uuid "be05706e-cf3a-52d7-8fc5-7cdaac3e1473" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{pr}}{7{r}^{3}}" :db/id #edb/ref 17592186584108} :answer-field/id #uuid "cbe7a649-07eb-5d09-849b-98576763033b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186584312}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a7b4769e-7094-55a2-aef0-0ce0dbadd625" :question/math-academy-id "q-111052" :question/problem "Rationalize $\\frac{\\sqrt{16p}}{\\sqrt{49{r}^{5}}}.$" :question/worked-solution "We need to remove the radical $\\sqrt{49{r}^{5}}$ from the denominator. To do this, we multiply both the numerator and denominator by $\\sqrt{49{r}^{5}},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{16p}}{\\sqrt{49{r}^{5}}} & = \\\\ \\frac{\\sqrt{16p}\\cdot \\sqrt{49{r}^{5}}}{\\sqrt{49{r}^{5}}\\cdot \\sqrt{49{r}^{5}}} & = \\\\ \\frac{\\sqrt{16\\cdot p}\\cdot \\sqrt{49{r}^{4}\\cdot r}}{(\\sqrt{49{r}^{5}})^{2}} & = \\\\ \\frac{4\\sqrt{p}\\cdot 7{r}^{2}\\sqrt{r}}{49{r}^{5}} & = \\\\ \\frac{28{r}^{2}\\cdot \\sqrt{pr}}{49{r}^{5}} & = \\\\ \\frac{4\\cdot \\cancel{7{r}^{2}}\\cdot \\sqrt{pr}}{7\\cdot \\cancel{7{r}^{2}}\\cdot {r}^{3}} & = \\\\ \\frac{4\\sqrt{pr}}{7{r}^{3}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186584424 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63d3d5ef-7268-5541-8024-3cc703de54ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10x}}{x}" :db/id #edb/ref 17592186583930} {:answer/id #uuid "6554a66d-6840-54a9-9eaf-07038e3da285" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5x}}{x}" :db/id #edb/ref 17592186583932} {:answer/id #uuid "ac2ebe6d-cc09-5da3-924d-e57a52bfe0da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5x}}{2x}" :db/id #edb/ref 17592186584067} {:answer/id #uuid "b4f631ad-109c-51c0-9cf6-67978e4dca24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10x}}{5x}" :db/id #edb/ref 17592186584088} {:answer/id #uuid "f8fa90ca-a911-59eb-8d47-ed1c4cf44d08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10x}}{2x}" :db/id #edb/ref 17592186584213}] :answer-field/correct {:answer/id #uuid "f8fa90ca-a911-59eb-8d47-ed1c4cf44d08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10x}}{2x}" :db/id #edb/ref 17592186584213} :answer-field/id #uuid "f24e49c5-dc1f-505f-942b-2cebd7cc7e16" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186584325}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fc3cefea-b084-512c-aa33-9842e4fadf8a" :question/math-academy-id "q-77869" :question/problem "Rationalize the denominator of $\\sqrt{\\frac{5}{2x}}.$" :question/worked-solution "First, we apply the quotient rule and put the numerator and denominator under separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{\\frac{5}{2x}} & =\\frac{\\sqrt{5}}{\\sqrt{2x}}\\end{aligned}\n$$\n\nNow, we need to remove the radical $\\sqrt{2x}$ from the denominator. To do this, we multiply both the numerator and denominator by $\\sqrt{2x},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{5}}{\\sqrt{2x}}\\cdot \\frac{\\sqrt{2x}}{\\sqrt{2x}} & = \\\\ \\frac{\\sqrt{10x}}{(\\sqrt{2x})^{2}} & = \\\\ \\frac{\\sqrt{10x}}{2x}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186585088 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04e42ff3-44ae-54c1-9e29-1f70a48ccb59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{7}x^{\\frac{7}{6}}" :db/id #edb/ref 17592186584517}] :answer-field/correct {:answer/id #uuid "04e42ff3-44ae-54c1-9e29-1f70a48ccb59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{7}x^{\\frac{7}{6}}" :db/id #edb/ref 17592186584517} :answer-field/id #uuid "d2400e32-0626-57f4-aa86-36f297e53f28" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186585001}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "94477f44-1be5-5969-98a4-26af9184571a" :question/math-academy-id "q-167646" :question/problem "The antiderivative of $\\sqrt[6]{x}$ equals{{field-1}} $+\\,\\text{ }C$" :question/worked-solution "Since $\\sqrt[6]{x}={x}^{1/6}$, we can apply the power rule with $n=\\frac{1}{6}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{1/6}\\,\\text{d}x & =\\frac{{x}^{1/6+1}}{(\\frac{1}{6}+1)}+C \\\\  & =\\frac{{x}^{7/6}}{(\\frac{7}{6})}+C \\\\  & =\\frac{6{x}^{7/6}}{7}+C.\\end{aligned}\n$$\n\nLet's check our answer by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{6{x}^{7/6}}{7}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{6{x}^{7/6}}{7})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{6}{7}\\frac{\\text{d}}{\\text{d}x}({x}^{7/6})+0 & = \\\\ \\frac{6}{7}\\cdot \\frac{7}{6}{x}^{7/6-1} & = \\\\ {x}^{1/6}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186587304 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2202f6fe-b53b-5a2d-a1db-2533ed538332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}x^{\\frac{5}{4}}" :db/id #edb/ref 17592186586733}] :answer-field/correct {:answer/id #uuid "2202f6fe-b53b-5a2d-a1db-2533ed538332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}x^{\\frac{5}{4}}" :db/id #edb/ref 17592186586733} :answer-field/id #uuid "3d10d539-8c5e-514d-8877-3d19db95faab" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186587183}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3efb6512-0e32-57d7-9bcc-102471dd5cbb" :question/math-academy-id "q-167541" :question/problem "The antiderivative of $\\sqrt[4]{x}$ equals{{field-1}} $+\\,\\text{ }C$" :question/worked-solution "Since $\\sqrt[4]{x}={x}^{1/4}$, we can apply the power rule with $n=\\frac{1}{4}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{1/4}\\,\\text{d}x & =\\frac{{x}^{1/4+1}}{(\\frac{1}{4}+1)}+C \\\\  & =\\frac{{x}^{5/4}}{(\\frac{5}{4})}+C \\\\  & =\\frac{4{x}^{5/4}}{5}+C.\\end{aligned}\n$$\n\nLet's check our answer by differentiating: \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{4{x}^{5/4}}{5}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{4{x}^{5/4}}{5})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{4}{5}\\frac{\\text{d}}{\\text{d}x}({x}^{5/4})+0 & = \\\\ \\frac{4}{5}\\cdot \\frac{5}{4}{x}^{5/4-1} & = \\\\ {x}^{1/4}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186594695 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "761dd29f-8638-506e-9f33-d3fbb6fc5d04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186594445}] :answer-field/correct {:answer/id #uuid "761dd29f-8638-506e-9f33-d3fbb6fc5d04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186594445} :answer-field/id #uuid "24fb6379-fa9d-5f4a-83dd-2d9ed14fe012" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186594602} {:answer-field/choices [{:answer/id #uuid "de92f53d-9591-5a9d-a11c-fe6b6fc93228" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186594553}] :answer-field/correct {:answer/id #uuid "de92f53d-9591-5a9d-a11c-fe6b6fc93228" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186594553} :answer-field/id #uuid "809c7377-d69c-5f62-ba5d-227f140b4e0b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186594628} {:answer-field/choices [{:answer/id #uuid "739c7bc1-c680-588c-b15f-8f9e6ec614a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186594442}] :answer-field/correct {:answer/id #uuid "739c7bc1-c680-588c-b15f-8f9e6ec614a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186594442} :answer-field/id #uuid "d245930a-12b9-5a45-b58e-f3fff46555af" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186594649}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "82394788-42e3-5b00-bf3b-6519a3b8110f" :question/math-academy-id "q-249957" :question/problem "The equation of the parabola $y=7{x}^{2}-28x+18$ in vertex form is\n\n$y=$\n{{field-1}}$(x\\,-$\n{{field-2}}$)^{2}-$\n{{field-3}}." :question/worked-solution "To express the equation of the parabola in vertex form, we need to complete the square. \n\nFirst, we take out a factor of $7$ from the entire expression:\n\n$$\n\\begin{aligned}7{x}^{2}-28x+18 & =7({x}^{2}-4x+\\frac{18}{7})\\end{aligned}\n$$\n\nNow, we complete the square for the expression inside the parentheses:\n\n$$\n\\begin{aligned}{x}^{2}-4x+\\frac{18}{7} & = \\\\ {x}^{2}-2\\cdot 2\\cdot x+\\frac{18}{7} & = \\\\ {x}^{2}-2\\cdot 2\\cdot x+{2}^{2}-{2}^{2}+\\frac{18}{7} & = \\\\ ({x}^{2}-2\\cdot 2\\cdot x+{2}^{2})-{2}^{2}+\\frac{18}{7} & = \\\\ (x-2)^{2}-{2}^{2}+\\frac{18}{7} & = \\\\ (x-2)^{2}-4+\\frac{18}{7} & = \\\\ (x-2)^{2}-\\frac{10}{7} & \\end{aligned}\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}7({x}^{2}-4x+\\frac{18}{7}) & = \\\\ 7((x-2)^{2}-\\frac{10}{7}) & = \\\\ 7(x-2)^{2}-10\\end{aligned}\n$$\n\nTherefore, expressed in vertex form, the equation of the parabola is $y=7(x-2)^{2}-10.$"} {:db/id #edb/ref 17592186594703 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ef79daf-269f-5391-89e7-0894ce3f61b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3{(x+2)}^{2}-10" :db/id #edb/ref 17592186594344} {:answer/id #uuid "4895654d-48cc-505c-84b0-d9995b10dab5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(x-4)}^{2}-13" :db/id #edb/ref 17592186594401} {:answer/id #uuid "5b22b51b-4f81-58d0-849b-cbfbc42268ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(x-2)}^{2}+17" :db/id #edb/ref 17592186594414} {:answer/id #uuid "7f361332-e6d9-5894-8e73-d5de8529e4b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3{(x+4)}^{2}+10" :db/id #edb/ref 17592186594454} {:answer/id #uuid "e4576085-dcb1-5bd3-9cac-cdf674717900" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3{(x-2)}^{2}-17" :db/id #edb/ref 17592186594559}] :answer-field/correct {:answer/id #uuid "e4576085-dcb1-5bd3-9cac-cdf674717900" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3{(x-2)}^{2}-17" :db/id #edb/ref 17592186594559} :answer-field/id #uuid "adc777db-26a4-5c34-8001-900968af049f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594638}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9d471c35-a397-5381-862c-8746654afb00" :question/math-academy-id "q-13441" :question/problem "Write the equation of the parabola $y=3{x}^{2}-12x-5$ in vertex form." :question/worked-solution "To express the equation of the parabola in vertex form, we need to complete the square. \n\nFirst, we take out a factor of $3$ from the entire expression:\n\n$$\n3{x}^{2}-12x-5=3({x}^{2}-4x-\\frac{5}{3})\n$$\n\nNow, we complete the square for the expression inside the parentheses:\n\n$$\n\\begin{aligned}{x}^{2}-4x-\\frac{5}{3} & = \\\\ {x}^{2}-2\\cdot 2\\cdot x-\\frac{5}{3} & = \\\\ {x}^{2}-2\\cdot 2\\cdot x+{2}^{2}-{2}^{2}-\\frac{5}{3} & = \\\\ ({x}^{2}-2\\cdot 2\\cdot x+{2}^{2})-{2}^{2}-\\frac{5}{3} & = \\\\ (x-2)^{2}-{2}^{2}-\\frac{5}{3} & = \\\\ (x-2)^{2}-4-\\frac{5}{3} & = \\\\ (x-2)^{2}-\\frac{17}{3} & \\end{aligned}\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}3({x}^{2}-4x-\\frac{5}{3}) & = \\\\ 3((x-2)^{2}-\\frac{17}{3}) & = \\\\ 3{(x-2)}^{2}-17\\end{aligned}\n$$\n\nTherefore, expressed in vertex form, the equation of the parabola is $y=3{(x-2)}^{2}-17.$"} {:db/id #edb/ref 17592186595976 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1905defa-2bfb-5218-aadf-edb0636d19e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2(m-3)}" :db/id #edb/ref 17592186594908} {:answer/id #uuid "2a4585b6-9262-5a3b-9bdb-dc1941bd1997" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(m-3)" :db/id #edb/ref 17592186594961} {:answer/id #uuid "4a4debf6-8759-50c0-aa53-a0ff9a9ecbcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(m+3)" :db/id #edb/ref 17592186595056} {:answer/id #uuid "6676399d-f73a-5ba9-9071-e13ca2b748ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{m+3}" :db/id #edb/ref 17592186595153} {:answer/id #uuid "9e7f0535-d1aa-53d7-8f12-16f57e0cc15c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{m-3}" :db/id #edb/ref 17592186595367}] :answer-field/correct {:answer/id #uuid "1905defa-2bfb-5218-aadf-edb0636d19e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2(m-3)}" :db/id #edb/ref 17592186594908} :answer-field/id #uuid "24dbb485-2a06-598f-95ac-8d8017430572" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186595729}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a9357030-5d35-5cab-9d6b-f58ccc5f7723" :question/math-academy-id "q-30012" :question/problem "Which of the following is equivalent to $\\frac{1}{{m}^{2}-9}÷\\frac{2}{m+3}?$" :question/worked-solution "To compute\n\n$$\n\\frac{1}{{m}^{2}-9}÷\\frac{2}{m+3},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{1}{{m}^{2}-9}÷\\frac{2}{m+3} & = \\\\ \\frac{1}{{m}^{2}-9}\\cdot \\frac{m+3}{2} & = \\\\ \\frac{1}{(m-3)(m+3)}\\cdot \\frac{m+3}{2} & = \\\\ \\frac{1}{(m-3)\\cancel{(m+3)}}\\cdot \\frac{\\cancel{m+3}}{2} & = \\\\ \\frac{1}{2(m-3)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186599196 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aa55ab3-ec01-5b98-ae85-7c17d2cecb12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186598734} {:answer/id #uuid "233435f7-4a03-5c36-a4f4-6a146186c26b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\pi }" :db/id #edb/ref 17592186598767} {:answer/id #uuid "2ed5a052-01c4-58a4-8cd9-a9f2ce6c8fe5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\pi }" :db/id #edb/ref 17592186598783} {:answer/id #uuid "3f983546-e05b-5154-a767-06ac140b37ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/mat