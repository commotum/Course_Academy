[{:db/id #edb/ref 17592186572173 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ae8dd84-1056-5afc-bdc6-13595c3ec750" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5(a+b)}}{5(a+b)}" :db/id #edb/ref 17592186571559} {:answer/id #uuid "0f075ce4-fb79-5eda-ae39-63d67635fa33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5(a+b)}" :db/id #edb/ref 17592186571564} {:answer/id #uuid "5ddd2e2e-8471-56e7-a9d7-6310c3988ee4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{a+b}}{5(a+b)}" :db/id #edb/ref 17592186571700} {:answer/id #uuid "a26f3e02-92d3-5d1f-b928-01b20bb52ebf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5(a+b)}}{a+b}" :db/id #edb/ref 17592186571820} {:answer/id #uuid "b1dd8cac-e702-5ca8-9e50-f2b488451c81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{a+b}}{a+b}" :db/id #edb/ref 17592186571849}] :answer-field/correct {:answer/id #uuid "a26f3e02-92d3-5d1f-b928-01b20bb52ebf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5(a+b)}}{a+b}" :db/id #edb/ref 17592186571820} :answer-field/id #uuid "39c3806c-d499-553b-a0be-7c5643b8cfe0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572006}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bb598f6a-4308-50e9-9232-77329f4110cd" :question/math-academy-id "q-111061" :question/problem "Express $\\sqrt{\\frac{5}{a+b}}\\,$ without radicals in the denominator." :question/worked-solution "First, we apply the quotient rule and put the numerator and denominator under separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{\\frac{5}{a+b}} & =\\frac{\\sqrt{5}}{\\sqrt{a+b}}\\end{aligned}\n$$\n\nTo remove the radical $\\sqrt{a+b}$ from the denominator, we multiply both the numerator and denominator by $\\sqrt{a+b}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{5}}{\\sqrt{a+b}} & = \\\\ \\frac{\\sqrt{5}}{\\sqrt{a+b}}\\cdot \\frac{\\sqrt{a+b}}{\\sqrt{a+b}} & = \\\\ \\frac{\\sqrt{5}\\cdot \\sqrt{a+b}}{\\sqrt{a+b}\\cdot \\sqrt{a+b}} & = \\\\ \\frac{\\sqrt{5(a+b)}}{(\\sqrt{a+b})^{2}} & = \\\\ \\frac{\\sqrt{5(a+b)}}{a+b} & \\end{aligned}\n$$"} {:db/id #edb/ref 17592186573281 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "880a7533-d27a-5209-9676-048622c816b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186572999}] :answer-field/correct {:answer/id #uuid "880a7533-d27a-5209-9676-048622c816b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186572999} :answer-field/id #uuid "4a8fb50b-f581-55fc-8b2e-6ae22914031e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573176} {:answer-field/choices [{:answer/id #uuid "72d3c220-e470-557e-bcd0-a9f8849b3dc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{6}" :db/id #edb/ref 17592186572966}] :answer-field/correct {:answer/id #uuid "72d3c220-e470-557e-bcd0-a9f8849b3dc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{6}" :db/id #edb/ref 17592186572966} :answer-field/id #uuid "54dab796-cb41-55f7-82f8-49c26b926e11" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573181}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "64689025-90b1-5416-8d71-9bc463abeb1c" :question/math-academy-id "q-175584" :question/problem "$\\frac{7}{2}u+4w-\\frac{2}{3}u-w=${{field-1}}\n$u\\,+$\n{{field-2}}\n$w$" :question/worked-solution "We collect and combine the like terms, simplifying the coefficients as much as possible:\n\n$$\n\\begin{aligned}\\frac{7}{2}u+4w-\\frac{2}{3}u-w & = \\\\ (\\frac{7}{2}u-\\frac{2}{3}u)+(4w-w) & = \\\\ (\\frac{7}{2}-\\frac{2}{3})u+(4-1)w & = \\\\ (\\frac{21}{6}-\\frac{4}{6})u+3w & = \\\\ (\\frac{21-4}{6})u+3w & = \\\\ \\frac{17}{6}\\,u+3\\,w\\end{aligned}\n$$"} {:db/id #edb/ref 17592186573292 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17152414-1ddb-5e41-9abb-42921b68db62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{15a{b}^{2}}" :db/id #edb/ref 17592186572848} {:answer/id #uuid "5d1c0afa-44a7-534c-9aa8-dbc746816bd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{5}ab" :db/id #edb/ref 17592186572929} {:answer/id #uuid "724b9d8c-8955-5a21-ab47-bd79bfc2648c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{15ab}" :db/id #edb/ref 17592186572965} {:answer/id #uuid "7b5ba170-762f-5afc-ac78-ade8780eeb8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15ab" :db/id #edb/ref 17592186572981} {:answer/id #uuid "860c6ce0-0936-5949-979e-21b5c6244968" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{3}ab" :db/id #edb/ref 17592186572996}] :answer-field/correct {:answer/id #uuid "17152414-1ddb-5e41-9abb-42921b68db62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{15a{b}^{2}}" :db/id #edb/ref 17592186572848} :answer-field/id #uuid "11331198-c809-57a2-b886-e3b7b744c7fe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573153}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "90e80b30-af1b-594f-ba5d-4e938ac90b8f" :question/math-academy-id "q-141914" :question/problem "$\\sqrt[3]{3ab}\\cdot \\sqrt[3]{5b}=$" :question/worked-solution "We apply the product rule for radicals, as follows:\n\n$$\n\\begin{aligned}\\sqrt[3]{3ab}\\cdot \\sqrt[3]{5b} & = \\\\ \\sqrt[3]{3ab\\cdot 5b} & = \\\\ \\sqrt[3]{15a{b}^{2}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186575616 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b980c429-3941-5497-9718-eff2d9e2f790" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186575278}] :answer-field/correct {:answer/id #uuid "b980c429-3941-5497-9718-eff2d9e2f790" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186575278} :answer-field/id #uuid "1743a921-81e3-55b5-9d48-3a7a62d7fca6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186575416} {:answer-field/choices [{:answer/id #uuid "592954bd-e4e3-532e-b6ca-f2133054c745" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186575106}] :answer-field/correct {:answer/id #uuid "592954bd-e4e3-532e-b6ca-f2133054c745" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186575106} :answer-field/id #uuid "417b571f-db4b-5ef9-8922-9b03f5302044" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186575447} {:answer-field/choices [{:answer/id #uuid "fc2978a6-8ff8-5d5b-8005-22bef1697c15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186575402}] :answer-field/correct {:answer/id #uuid "fc2978a6-8ff8-5d5b-8005-22bef1697c15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186575402} :answer-field/id #uuid "97e49246-be20-50e1-b49e-21fb6572d864" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186575474}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e8fb1410-51ee-5a0a-9a08-61072eaa2e45" :question/math-academy-id "q-225260" :question/problem "**Fully** factor the following trinomial.\n\n$-12{a}^{2}-6a+6=$\n{{field-1}}$(a\\,+$\n{{field-2}}\n$)($\n{{field-3}}\n$a\\,-1)$" :question/worked-solution "We need to factor the following expression:\n\n$$\n-12{a}^{2}-6a+6\n$$\n\nFirst, notice that all the terms have a common factor of $-6.$ So, we can simplify the calculation by first factoring out $-6:$\n\n$$\n\\begin{aligned}-6(2{a}^{2}+a-1)\\end{aligned}\n$$\n\nNow, we just need to factor the trinomial $2{a}^{2}+a-1$ in parentheses. To do this, we find two numbers that \n\n- multiply to the product of the quadratic coefficient and the constant (which is $2\\times (-1)=-2$), and\n\n- add to the linear coefficient (which is $1$).\n\nThe factor pairs of $-2$ are\n\n$$\n(1,-2),\\,(-1,2).\n$$\n\nNotice the numbers in the factor pair $(-1,2)$ add to $1:$ \n\n$$\n-1+2=1\\,✓\n$$\n\nThen, we write the linear term as $-a+2a,$ and factor the result by grouping:\n\n$$\n\\begin{aligned}2{a}^{2}+a-1 & = \\\\ 2{a}^{2}-a+2a-1 & = \\\\ (2{a}^{2}-a)+(2a-1) & = \\\\ a(2a-1)+(2a-1) & = \\\\ (a+1)(2a-1) & \\end{aligned}\n$$\n\nTherefore, the original trinomial factors as follows:\n\n$$\n\\begin{aligned}-12{a}^{2}-6a+6 & = \\\\ -6(2{a}^{2}+a-1) & = \\\\ -6(a+1)(2a-1) & \\end{aligned}\n$$"} {:db/id #edb/ref 17592186577465 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f2812c8-0923-5c8f-9968-98a39882a006" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{8}\\cdot y^{15}" :db/id #edb/ref 17592186577467} {:answer/id #uuid "4bf5da52-4e21-5a35-b0e9-533fdda32010" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{19}\\cdot y^{16}" :db/id #edb/ref 17592186577471} {:answer/id #uuid "552a6229-15c5-5e8b-a7e5-2f83ffab01d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{16}\\cdot y^{22}" :db/id #edb/ref 17592186577474} {:answer/id #uuid "8d6038a0-41d6-5756-99be-d4ef516d047b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{11}\\cdot y^{22}" :db/id #edb/ref 17592186577481} {:answer/id #uuid "fbc1aa51-b2e9-5808-8629-259ec7cbe4c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{10}\\cdot y^{25}" :db/id #edb/ref 17592186577497}] :answer-field/correct {:answer/id #uuid "fbc1aa51-b2e9-5808-8629-259ec7cbe4c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{10}\\cdot y^{25}" :db/id #edb/ref 17592186577497} :answer-field/id #uuid "484fd29a-efa5-59a6-90d2-3949bb5ee39d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186577470}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "00c97d32-04ec-56e7-94ad-342cee54ae6f" :question/problem "Use exponents to rewrite the product $y^{5}\\cdot y^{9}\\cdot x^{7}\\cdot x^{2}\\cdot y^{6}\\cdot y^{5}\\cdot x.$" :question/worked-solution "Here we have 2 variables, $x$ and $y$. We will start by grouping the bases separately:\n\n$$\n\\begin{aligned}y^{5}\\cdot y^{9}\\cdot x^{7}\\cdot x^{2}\\cdot y^{6}\\cdot y^{5}\\cdot x &= \\\\ (x^{7}\\cdot x^{2}\\cdot x^{1})\\cdot (y^{5}\\cdot y^{9}\\cdot y^{6}\\cdot y^{5})\\end{aligned}\n$$\n\nThis way, we can apply the product rule to the bases independently. An unwritten exponent is 1:\n\n$$\n\\begin{aligned}(x^{7}\\cdot x^{2}\\cdot x^{1})\\cdot (y^{5}\\cdot y^{9}\\cdot y^{6}\\cdot y^{5}) &= \\\\ x^{(7+2+1)}\\cdot y^{(5+9+6+5)} &= \\\\ x^{10}\\cdot y^{25}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186577478 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52034838-de5c-5214-95f8-1f7b61193f5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "m^{15}\\cdot n^{12}" :db/id #edb/ref 17592186577473} {:answer/id #uuid "b1f81a32-9344-537e-9d1a-9f68739016f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "m^{15}\\cdot n^{13}" :db/id #edb/ref 17592186577485} {:answer/id #uuid "b7944200-e3c5-574c-ac4c-8564c0d3a910" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "m^{13}\\cdot n^{21}" :db/id #edb/ref 17592186577486} {:answer/id #uuid "c40bc044-f82a-53fc-8e69-b0a99d92c07c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "m^{22}\\cdot n^{16}" :db/id #edb/ref 17592186577488} {:answer/id #uuid "da6b4218-b8ff-59fb-a6fc-fe84c1928172" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "m^{18}\\cdot n^{18}" :db/id #edb/ref 17592186577492}] :answer-field/correct {:answer/id #uuid "b7944200-e3c5-574c-ac4c-8564c0d3a910" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "m^{13}\\cdot n^{21}" :db/id #edb/ref 17592186577486} :answer-field/id #uuid "a0bc3d55-2226-57db-b4b1-daea5fd8769e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186577483}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7a6b21d0-fbb0-5b5b-8439-3eb40efb4471" :question/problem "Use exponents to rewrite the product $m^{8}\\cdot n^{8}\\cdot n\\cdot n^{8}\\cdot m^{3}\\cdot m^{2}\\cdot n^{4}.$" :question/worked-solution "Here we have 2 variables, $m$ and $n$. We will start by grouping the bases separately:\n\n$$\n\\begin{aligned}m^{8}\\cdot n^{8}\\cdot n\\cdot n^{8}\\cdot m^{3}\\cdot m^{2}\\cdot n^{4} &= \\\\ (m^{8}\\cdot m^{3}\\cdot m^{2})\\cdot (n^{8}\\cdot n^{1}\\cdot n^{8}\\cdot n^{4})\\end{aligned}\n$$\n\nThis way, we can apply the product rule to the bases independently. An unwritten exponent is 1:\n\n$$\n\\begin{aligned}(m^{8}\\cdot m^{3}\\cdot m^{2})\\cdot (n^{8}\\cdot n^{1}\\cdot n^{8}\\cdot n^{4}) &= \\\\ m^{(8+3+2)}\\cdot n^{(8+1+8+4)} &= \\\\ m^{13}\\cdot n^{21}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186577480 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d71e39f-168e-58bf-8075-4dd3fe137719" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b^{15}\\cdot c^{18}" :db/id #edb/ref 17592186577472} {:answer/id #uuid "5b45ba95-94a5-5ba8-9b45-9ba29df74250" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b^{16}\\cdot c^{25}" :db/id #edb/ref 17592186577475} {:answer/id #uuid "75a9daaa-24ee-5218-bb77-f41a0456cbb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b^{15}\\cdot c^{25}" :db/id #edb/ref 17592186577476} {:answer/id #uuid "bbc94fb9-2507-5266-b752-806107fc9c1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b^{15}\\cdot c^{16}" :db/id #edb/ref 17592186577487} {:answer/id #uuid "d4d3cda0-6438-5791-97a2-3cf8ce4141aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b^{19}\\cdot c^{16}" :db/id #edb/ref 17592186577490}] :answer-field/correct {:answer/id #uuid "5b45ba95-94a5-5ba8-9b45-9ba29df74250" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b^{16}\\cdot c^{25}" :db/id #edb/ref 17592186577475} :answer-field/id #uuid "766a5b52-bd2b-570d-ac8f-be6d53a2964a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186577477}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8cca68cb-2d9a-509b-a799-14c919573f64" :question/problem "Use exponents to rewrite the product $c^{8}\\cdot b^{5}\\cdot b^{7}\\cdot c^{8}\\cdot b\\cdot c^{9}\\cdot b^{3}.$" :question/worked-solution "Here we have 2 variables, $b$ and $c$. We will start by grouping the bases separately:\n\n$$\n\\begin{aligned}c^{8}\\cdot b^{5}\\cdot b^{7}\\cdot c^{8}\\cdot b\\cdot c^{9}\\cdot b^{3} &= \\\\ (b^{5}\\cdot b^{7}\\cdot b^{1}\\cdot b^{3})\\cdot (c^{8}\\cdot c^{8}\\cdot c^{9})\\end{aligned}\n$$\n\nThis way, we can apply the product rule to the bases independently. An unwritten exponent is 1:\n\n$$\n\\begin{aligned}(b^{5}\\cdot b^{7}\\cdot b^{1}\\cdot b^{3})\\cdot (c^{8}\\cdot c^{8}\\cdot c^{9}) &= \\\\ b^{(5+7+1+3)}\\cdot c^{(8+8+9)} &= \\\\ b^{16}\\cdot c^{25}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186577493 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45b8c299-6f41-5382-81e4-45f5969170e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b^{17}\\cdot c^{14}" :db/id #edb/ref 17592186577469} {:answer/id #uuid "82203143-1c44-579a-bb4d-12db3ea734c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b^{14}\\cdot c^{14}" :db/id #edb/ref 17592186577479} {:answer/id #uuid "d632a00d-5ecb-5258-89a0-5bcfbf554e27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b^{12}\\cdot c^{12}" :db/id #edb/ref 17592186577491} {:answer/id #uuid "e31ac03a-61a3-5b5f-9c06-5a265f729650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b^{20}\\cdot c^{20}" :db/id #edb/ref 17592186577494} {:answer/id #uuid "fcf55a05-1ce5-5472-bd20-674111c5376f" :answer/type {:db/id #edb/ref 17592186045