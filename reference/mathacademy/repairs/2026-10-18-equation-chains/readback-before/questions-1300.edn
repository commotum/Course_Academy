nswer/id #uuid "f2a19968-b76f-5b95-8182-68c6e0dba0d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186618574}] :answer-field/correct {:answer/id #uuid "f2a19968-b76f-5b95-8182-68c6e0dba0d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186618574} :answer-field/id #uuid "c8995d90-2840-590b-ac5b-7c4ef4778810" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186618680} {:answer-field/choices [{:answer/id #uuid "3f8080f8-cf30-5300-a680-df98784e04fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186618305}] :answer-field/correct {:answer/id #uuid "3f8080f8-cf30-5300-a680-df98784e04fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186618305} :answer-field/id #uuid "eb411452-738a-5827-8eb3-b5f23fd57a01" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186618705}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "38c7c35c-52cf-54ea-895a-05e8801a1e0c" :question/math-academy-id "q-178236" :question/problem "$8-2z-5z+z=${{field-1}}\n$-$\n{{field-2}}\n$z$" :question/worked-solution "We have three like terms, $-2z,$ $-5z,$ and $z.$ \n\nTo collect these like terms, we combine them into a single term, adding their coefficients:\n\n$$\n\\begin{aligned}8-2z-5z+z & = \\\\ 8+(-2-5+1)z & = \\\\ 8+(-6)z & = \\\\ 8-6\\,z\\end{aligned}\n$$"} {:db/id #edb/ref 17592186618751 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d0306a5-c879-594d-9665-d65acc7d8ee3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 1759218