3a-\\frac{7b}{2}+5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233686 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03200003-7c03-5877-9799-fe42b38367d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5d}{3}-3e+2f" :db/id #edb/ref 17592186513535} {:answer/id #uuid "875b0e1a-c6ee-5156-9b67-b9182be36dd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}-3e+2f" :db/id #edb/ref 17592186513884} {:answer/id #uuid "a837bab8-9905-5840-bdf4-12b924029d23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5d}{3}-3e-2f" :db/id #edb/ref 17592186513968} {:answer/id #uuid "b7dfca26-24d1-5b2e-89b8-03b7057f94a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "d-9e-2f" :db/id #edb/ref 17592186514016} {:answer/id #uuid "e8af9eea-0d25-50f2-b747-1968474f3c58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2d-9e-2f" :db/id #edb/ref 17592186514140}] :answer-field/correct {:answer/id #uuid "a837bab8-9905-5840-bdf4-12b924029d23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5d}{3}-3e-2f" :db/id #edb/ref 17592186513968} :answer-field/id #uuid "5be07d56-1b09-5907-9a4a-651321f7cdec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514269}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cedc5783-2073-5a5a-9238-c637979688f1" :question/math-academy-id "q-2595" :question/problem "$\\frac{5d-9e-6f}{3}=$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned}\\frac{5d-9e-6f}{3} &= \\frac{5d}{3}-\\frac{9e}{3}-\\frac{6f}{3} \\\\ &= \\frac{5d}{3}-\\frac{9}{3}\\cdot e-\\frac{6}{3}\\cdot f \\\\ &= \\frac{5d}{3}-3e-2f.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233687 :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6e6cb504-72e1-58e7-beff-0443a76911f9" :question/math-academy-id "q-2601" :question/problem "If $\\frac{16a-8}{4}$ is written in the form $pa+q,$ what are the values of $p$ and $q?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned}\\frac{16a-8}{4} &= \\frac{16a}{4}-\\frac{8}{4} \\\\ &= \\frac{16}{4}\\cdot a-2 \\\\ &= 4a-2.\\end{aligned}\n$$\n\nWriting the above in the form $pa+qb,$ we get\n\n$$\n\\begin{aligned}\\underbrace{(4)}_{p}a+\\underbrace{(-2)}_{q}.\\end{aligned}\n$$\n\nTherefore, $p=4$ and $q=-2.$"} {:db/id #edb/ref 17592186233706 :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "872c4f68-faa5-5619-88fd-07a441457df3" :question/math-academy-id "q-2744" :question/problem "What is the coefficient of $ac$ in the product $(a+b+c)(a-b-c)?$" :question/worked-solution "We distribute the terms of the trinomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}(a+b+c)(a-b-c) &= a(a-b-c)+b(a-b-c)+c(a-b-c) \\\\ &= {a}^{2}-ab-ac+ba-{b}^{2}-bc+ca-cb-{c}^{2} \\\\ &= {a}^{2}-{b}^{2}+0ab+0ac-2bc-{c}^{2}.\\end{aligned}\n$$\n\nTherefore,  the coefficient of $ac$ is $0.$"} {:db/id #edb/ref 17592186233756 :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b4c41763-a855-522e-8561-f186041bf2fd" :question/math-academy-id "q-29948" :question/problem "Which of the following is equivalent to $\\frac{{x}^{2}+3x}{3{y}^{2}}÷\\frac{x+3}{21{y}^{3}}?$" :question/worked-solution "To compute\n\n$$\n\\frac{{x}^{2}+3x}{3{y}^{2}}÷\\frac{x+3}{21{y}^{3}},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}+3x}{3{y}^{2}}÷\\frac{x+3}{21{y}^{3}} &= \\frac{{x}^{2}+3x}{3{y}^{2}}\\cdot \\frac{21{y}^{3}}{x+3} \\\\ &= \\frac{x(x+3)}{3{y}^{2}}\\cdot \\frac{7\\cdot 3{y}^{2}\\cdot y}{x+3} \\\\ &= \\frac{x\\cancel{(x+3)}}{\\cancel{3{y}^{2}}}\\cdot \\frac{7\\cdot \\cancel{3{y}^{2}}\\cdot y}{\\cancel{x+3}} \\\\ &= x\\cdot 7y \\\\ &= 7xy\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233757 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d9d372c-4477-5559-a60e-525b79945d82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{a}^{2}}{5b{c}^{2}}" :db/id #edb/ref 17592186565778} {:answer/id #uuid "a3d57647-a858-58be-b6c6-5a8426f661a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5b{c}^{2}}{6{a}^{2}}" :db/id #edb/ref 17592186565940} {:answer/id #uuid "b3162ef4-1d4d-5280-b14a-835a8f8afd09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{b{c}^{2}}{6{a}^{2}}" :db/id #edb/ref 17592186565963} {:answer/id #uuid "c14dcc77-87a2-509e-aefb-42b5a939a216" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{b{c}^{2}}{2{a}^{2}}" :db/id #edb/ref 17592186565987} {:answer/id #uuid "cd4945a6-b616-5950-9cff-ca98bb020943" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{c}^{2}}{6{a}^{2}}" :db/id #edb/ref 17592186566011}] :answer-field/correct {:answer/id #uuid "a3d57647-a858-58be-b6c6-5a8426f661a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5b{c}^{2}}{6{a}^{2}}" :db/id #edb/ref 17592186565940} :answer-field/id #uuid "144673bd-7ce0-5009-80d2-846588e5d153" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186566112}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3a8407af-a47a-5ef1-a65f-b4b72289472c" :question/math-academy-id "q-29966" :question/problem "If $\\frac{24{a}^{3}{b}^{2}}{25{c}^{3}}\\cdot X=\\frac{12a{b}^{3}}{15c},$ then what is $X?$" :question/worked-solution "Since $\\frac{24{a}^{3}{b}^{2}}{25{c}^{3}}\\cdot X=\\frac{12a{b}^{3}}{15c},$ we have\n\n$$\nX=\\frac{12a{b}^{3}}{15c}÷\\frac{24{a}^{3}{b}^{2}}{25{c}^{3}}.\n$$\n\nTo compute this quotient, we just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{12a{b}^{3}}{15c}÷\\frac{24{a}^{3}{b}^{2}}{25{c}^{3}} &= \\frac{12a{b}^{3}}{15c}\\cdot \\frac{25{c}^{3}}{24{a}^{3}{b}^{2}} \\\\ &= \\frac{12\\cdot a{b}^{2}\\cdot b}{3\\cdot 5c}\\cdot \\frac{5\\cdot 5c\\cdot {c}^{2}}{12\\cdot 2{a}^{2}\\cdot a{b}^{2}} \\\\ &= \\frac{\\cancel{12}\\cdot \\cancel{a{b}^{2}}\\cdot b}{3\\cdot \\cancel{5c}}\\cdot \\frac{5\\cdot \\cancel{5c}\\cdot {c}^{2}}{\\cancel{12}\\cdot 2{a}^{2}\\cdot \\cancel{a{b}^{2}}} \\\\ &= \\frac{b}{3}\\cdot \\frac{5{c}^{2}}{2{a}^{2}} \\\\ &= \\frac{5b{c}^{2}}{6{a}^{2}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233790 :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3b98fea0-a66b-5248-90db-62d7c85781e1" :question/math-academy-id "q-31383" :question/problem "What is the coefficient of ${x}^{2}y$ in the product $(2x+y)({x}^{2}-2xy+3{y}^{2})?$" :question/worked-solution "We distribute both terms of the binomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}(2x+y)({x}^{2}-2xy+3{y}^{2}) &= 2x({x}^{2}-2xy+3{y}^{2})+y({x}^{2}-2xy+3{y}^{2}) \\\\ &= 2{x}^{3}-4{x}^{2}y+6x{y}^{2}+{x}^{2}y-2x{y}^{2}+3{y}^{3} \\\\ &= 2{x}^{3}-3{x}^{2}y+4x{y}^{2}+3{y}^{3}\\end{aligned}\n$$\n\nTherefore, the coefficient of ${x}^{2}y$ is $-3.$"} {:db/id #edb/ref 17592186233791 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30c71a89-1b78-5e7a-bc51-93f4bdcc0b79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}+22{x}^{2}+51x-36" :db/id #edb/ref 17592186482898} {:answer/id #uuid "4c8f52e7-2b8e-575c-9217-06206fea6f30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}-14{x}^{2}-51x-36" :db/id #edb/ref 17592186482948} {:answer/id #uuid "581beaca-78ca-59ab-ba2b-664041e07f97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}+4{x}^{2}-24x-36" :db/id #edb/ref 17592186482968} {:answer/id #uuid "b74b1c83-4325-5d72-b041-4d5e0349539b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}+4{x}^{2}-12x-18" :db/id #edb/ref 17592186483124} {:answer/id #uuid "d0c91194-623b-5e2f-ae4f-faff21602694" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}-18{x}^{2}-27x-36" :db/id #edb/ref 17592186483159}] :answer-field/correct {:answer/id #uuid "4c8f52e7-2b8e-575c-9217-06206fea6f30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}-14{x}^{2}-51x-36" :db/id #edb/ref 17592186482948} :answer-field/id #uuid "f5ad427f-a5c6-5d28-90ed-675589d89537" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483337}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "76a8faca-c056-5acc-8cda-bb43a948af4e" :question/math-academy-id "q-31385" :question/problem "Which of the following is equivalent to $(3x+4)({x}^{2}-6x-9)?$" :question/worked-solution "We distribute both terms of the binomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}(3x+4)({x}^{2}-6x-9) &= 3x({x}^{2}-6x-9)+4({x}^{2}-6x-9) \\\\ &= 3{x}^{3}-18{x}^{2}-27x+4{x}^{2}-24x-36 \\\\ &= 3{x}^{3}-14{x}^{2}-51x-36\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233823 :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8886d6a0-4a9d-561b-86e1-e9e73e7f172e" :question/math-academy-id "q-32102" :question/problem "$-4{y}^{2}+8y+12=$" :question/worked-solution "First, notice that we can factor out a $(-4)$ from each of the terms:\n\n$$\n\\begin{aligned}-4{y}^{2}+8y+12 & =-4({y}^{2}-2y-3)\\end{aligned}\n$$\n\nNow, we just need to factor the polynomial ${y}^{2}-2y-3$ in parentheses.\n\nWe start by listing the factor pairs of the constant term $(-3).$ The constant term is negative, so that means one of the factors is negative and the other is positive:\n\n$$\n\\begin{aligned}1 & \\times (-3) \\\\ (-1) & \\times 3\\end{aligned}\n$$\n\nNow, we find which factor pair adds up to the coefficient of the linear term $(-2):$\n\n$$\n\\begin{aligned}1+(-3) & =-2 & ✓ \\\\ (-1)+3 & =2 & \\times \\end{aligned}\n$$\n\nUsing the factor pair identified above, we write the linear term as $-2y=y-3y$ and then factor the expression completely:\n\n$$\n\\begin{aligned}-4({y}^{2}-2y-3) &= -4({y}^{2}+y-3y-3) \\\\ &= -4(({y}^{2}+y)+(-3y-3)) \\\\ &= -4(y(y+1)-3(y+1)) \\\\ &= -4(y-3)(y+1)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233966 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69df2f53-5c50-59ae-8338-33f06671b49c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{y-3}-10}{y-7}" :db/id #edb/ref 17592186512353} {:answer/id #uuid "6c32fdae-9578-5230-9c6a-0030dc42ee0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{y+3}+10}{y-1}" :db/id #edb/ref 17592186512357} {:answer/id #uuid "97224d93-ee75-5b28-87bf-a215b4d67a60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{y+3}-10}{y+7}" :db/id #edb/ref 17592186512455} {:answer/id #uuid "c408e350-5f98-5e07-beed-90e315ab7e7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{y+3}+2}{y+1}" :db/id #edb/ref 17592186512571} {:answer/id #uuid "eb76173e-aa86-561d-80e6-1b55db1b9cdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{y-3}+2}{y-1}" :db/id #edb/ref 17592186512665}] :answer-field/correct {:answer/id #uuid "6c32fdae-9578-5230-9c6a-0030dc42ee0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{y+3}+10}{y-1}" :db/id #edb/ref 17592186512357} :answer-field/id #uuid "767f1526-f555-548a-8c1f-53ab5b15fedc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512791}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b8bdad77-9abf-5122-8282-321bd75ae69b" :question/math-academy-id "q-34858" :question/problem "Rationalize the denominator of $\\frac{5}{\\sqrt{y+3}-2}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{y+3}+2.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{y+3}+2,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{5}{\\sqrt{y+3}-2} &= \\frac{5}{\\sqrt{y+3}-2}\\cdot \\frac{\\sqrt{y+3}+2}{\\sqrt{y+3}+2} \\\\ &= \\frac{5(\\sqrt{y+3}+2)}{(\\sqrt{y+3}-2)(\\sqrt{y+3}+2)} \\\\ &= \\frac{5\\sqrt{y+3}+10}{(\\sqrt{y+3})^{2}-{2}^{2}} \\\\ &= \\frac{5\\sqrt{y+3}+10}{y+3-4} \\\\ &= \\frac{5\\sqrt{y+3}+10}{y-1}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233988 :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "af55f4d3-0b67-5616-a9fe-b58675056d80" :question/math-academy-id "q-3507" :question/problem "$\\frac{z-5}{{z}^{2}-2z-8}÷\\frac{1}{z-4}=$" :question/worked-solution "To compute\n\n$$\n\\frac{z-5}{{z}^{2}-2z-8}÷\\frac{1}{z-4},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{z-5}{{z}^{2}-2z-8}÷\\frac{1}{z-4} &= \\frac{z-5}{{z}^{2}-2z-8}\\cdot \\frac{z-4}{1} \\\\ &= \\frac{z-5}{(z-4)(z+2)}\\cdot \\frac{z-4}{1} \\\\ &= \\frac{z-5}{\\cancel{(z-4)}(z+2)}\\cdot \\frac{\\cancel{z-4}}{1} \\\\ &= \\frac{z-5}{z+2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233989 :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4b1bf3df-b095-5dd8-aa6c-20ff7d54d87b" :question/math-academy-id "q-3509" :question/problem "Which of the following is equivalent to $\\frac{a-b}{6b}-\\frac{6a-3b}{6b}?$" :question/worked-solution "We have a common denominator of $6b,$ so we subtract the numerators and simplify:\n\n$$\n\\begin{aligned}\\frac{a-b}{6b}-\\frac{6a-3b}{6b} &= \\frac{a-b-(6a-3b)}{6b} \\\\ &= \\frac{a-b-6a+3b}{6b} \\\\ &= \\frac{-5a+2b}{6b}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234001 :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e75ed635-7243-55c9-832d-0312e621f6f5" :question/math-academy-id "q-3635" :question/problem "$\\frac{9x}{xy+5y}÷\\frac{{y}^{2}}{3x+15}=$" :question/worked-solution "To compute\n\n$$\n\\frac{9x}{xy+5y}÷\\frac{{y}^{2}}{3x+15},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{9x}{xy+5y}÷\\frac{{y}^{2}}{3x+15} &= \\frac{9x}{xy+5y}\\cdot \\frac{3x+15}{{y}^{2}} \\\\ &= \\frac{9x}{y(x+5)}\\cdot \\frac{3(x+5)}{{y}^{2}} \\\\ &= \\frac{9x}{y\\cancel{(x+5)}}\\cdot \\frac{3\\cancel{(x+5)}}{{y}^{2}} \\\\ &= \\frac{9x}{y}\\cdot \\frac{3}{{y}^{2}} \\\\ &= \\frac{27x}{{y}^{3}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234061 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dc2ec08-ccd3-52d6-ba27-4d0c5b4a6f70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186512203} {:answer/id #uuid "3be7a489-8098-540d-bf9d-af04ee7bcc91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186512229} {:answer/id #uuid "481a228a-6054-5d3b-9727-76814a95d100" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186512252} {:answer/id #uuid "5882ed18-1e8f-5fb9-ae77-3f8984bbac2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186512304} {:answer/id #uuid "d79197b3-4c94-57d3-bae0-0b19e5e807a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186512612}] :answer-field/correct {:answer/id #uuid "3be7a489-8098-540d-bf9d-af04ee7bcc91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186512229} :answer-field/id #uuid "e0744bce-0ef4-5d83-bb98-f340a557f518" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512849}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7b10f970-f0c0-5c1c-948f-9f92d7941265" :question/math-academy-id "q-46167" :question/problem "The curve $y=4{x}^{2}-24x+24$ can be written as $y=a(x+b)^{2}+c.$ Calculate $a+b+c.$" :question/worked-solution "To express the equation of the parabola in vertex form, we need to complete the square. \n\nFirst, we take out a factor of $4$ from the entire expression:\n\n$$\n\\begin{aligned}4{x}^{2}-24x+24 & =4({x}^{2}-6x+6)\\end{aligned}\n$$\n\nNow, we complete the square for the expression inside the parentheses:\n\n$$\n\\begin{aligned}{x}^{2}-6x+6 &= {x}^{2}-2\\cdot 3\\cdot x+6 \\\\ &= {x}^{2}-2\\cdot 3\\cdot x+{3}^{2}-{3}^{2}+6 \\\\ &= ({x}^{2}-2\\cdot 3\\cdot x+{3}^{2})-{3}^{2}+6 \\\\ &= (x-3)^{2}-{3}^{2}+6 \\\\ &= (x-3)^{2}-9+6 \\\\ &= (x-3)^{2}-3\\end{aligned}\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}4({x}^{2}-6x+6) &= 4((x-3)^{2}-3) \\\\ &= 4(x-3)^{2}-12\\end{aligned}\n$$\n\nSo,  $a+b+c=4+(-3)+(-12)=-11.$"} {:db/id #edb/ref 17592186234094 :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6bb14b64-aadc-52aa-9ee3-c1ddaebaaa46" :question/math-academy-id "q-48510" :question/problem "Find the equation of the tangent to the curve $y=\\sec(3x)-2x$ at the point $\\left(0,1\\right).$" :question/worked-solution "Let $g(x)=\\sec(3x )$ and $h(x)=-2x.$ Then,\n\n\\begin{align}\nf(x)&=g(x)+h(x) . \n\\end{align}\n\nFirst, we differentiate $g(x).$ We express $g(x)=\\sec(3x)$ as the composite function\n\\[\ng = \\sec u, \\qquad u = 3x.\n\\]\n\nDifferentiating gives\n\n\\[\n\\dfrac{\\textrm d g}{\\textrm d u} = \\sec u \\tan u \\qquad \\text{and} \\qquad \\dfrac{\\textrm{d}u}{\\textrm d x} = 3.\n\\]\n\nWe now apply the chain rule, and we get\n\\[\n\t\\begin{aligned}\n\\dfrac{\\textrm{d}g}{\\textrm{d}x}&=\\dfrac{\\textrm{d}g}{\\textrm{d}u}\\cdot \\dfrac{\\textrm{d}u}{\\textrm{d}x}\\\\[5pt]\n\t\t\t\t\t\t\t\t\t&=\\sec u \\tan u \\cdot (3)\\\\[5pt]\n\t\t\t\t\t\t\t\t\t&=3 \\sec u \\tan u\\\\[5pt]\n                                                                        & =3\\sec (3x) \\tan (3x)\n\\end{aligned}\n\n\\]\n\nNext, we differentiate $h(x)=-2x.$ \n\nDifferentiating gives\n\n\\[\n\\dfrac{\\textrm d h}{\\textrm d x} = -2\n\\]\n\nHence,\n\\[f'(x)=g'(x)+h'(x)=3\\sec (3x) \\tan (3x) -2.\\]\n\nEvaluating at $x=0,$ we find\n\n\\begin{align*}\nm=f'(0) & =3\\sec\\left(3\\cdot 0\\right)\\tan\\left(3\\cdot 0\\right) -2\\\\[3pt]\n\t& =3\\sec 0\\tan 0 -2\\\\[3pt]\n\t& =3\\cdot 1\\cdot 0 - 2\\\\[3pt]\n\t&=-2.       \n\\end{align*}\n\nFinally, we find the equation of the tangent at the point $(0,1) \\mathbin{:}$\n\n\\begin{align}\ny-y_1&=m(x-x_1)\\\\[3pt]\ny-1&=-2 \\left(x-0 \\right)\\\\[3pt]\ny-1&=-2x\\\\[3pt]\ny&=-2x+1.\n\\end{align}"} {:db/id #edb/ref 17592186234097 :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9728f53e-cf89-532c-9077-996c48020b2d" :question/math-academy-id "q-48644" :question/problem "Find the equation of the tangent to the curve $y =\\cos \\left(\\sin x \\right)$ at the point $\\left(0,1 \\right).$" :question/worked-solution "First, the slope of $y = f(x)$ at $x = 0$ is given by $f'(0).$\n\nWe will calculate $f'(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\n\\[\nf = \\cos{u}, \\qquad u = \\sin x.\n\\]\n\nDifferentiating gives\n\n\\[\n\\dfrac{\\textrm d f}{\\textrm d u} = -\\sin{u}, \\qquad \\dfrac{\\textrm d u}{\\textrm d x} =\\cos x.\n\\]\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\n \\dfrac{\\textrm d f}{\\textrm d x} &= \\dfrac{\\textrm d f}{\\textrm d u} \\cdot \\dfrac{\\textrm d u}{\\textrm d x}\\\\[5pt]\n&=-\\sin u \\cdot (\\cos x)\\\\[5pt]\n&=-\\cos x \\sin (\\sin x).\n\\end{aligned}\n$$\n\nEvaluating at $x=0,$ we find\n\\[\n\t\\begin{aligned}\n\tf'(0)&=-\\cos (0) \\sin (\\sin (0))\\\\[3pt]\n\t&=-1 \\cdot 0 \\\\[3pt]\n        &=0.\n\\end{aligned}\n\\]\n\nFinally, we find the equation of the tangent at the point $(0,1) \\mathbin{:}$\n\n$$\n\\begin{aligned}\ny-y_1 &= m(x-x_1)\\\\[3pt]\ny-1 &= (0)\\cdot\\left(x-0\\right)\\\\[3pt]\ny&=1.\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234126 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35491d80-a77f-52c6-a568-bd24e13c7116" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9{u}^{3}+4{v}^{2}" :db/id #edb/ref 17592186492329} {:answer/id #uuid "9e781594-53d3-5ca5-9e41-43c8424c3fa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81{u}^{3}-16{v}^{2}" :db/id #edb/ref 17592186492526} {:answer/id #uuid "a600b6da-a934-537d-9ba1-c9162991c253" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81{u}^{6}-16{v}^{4}" :db/id #edb/ref 17592186492553} {:answer/id #uuid "c02f0190-7201-5e62-92ea-188e7964fa1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9{u}^{3}-4{v}^{2}" :db/id #edb/ref 17592186492599} {:answer/id #uuid "e741361b-5fc6-54dd-b921-faf3dea25837" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9{u}^{6}-4{v}^{4}" :db/id #edb/ref 17592186492666}] :answer-field/correct {:answer/id #uuid "a600b6da-a934-537d-9ba1-c9162991c253" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81{u}^{6}-16{v}^{4}" :db/id #edb/ref 17592186492553} :answer-field/id #uuid "26889d78-c51c-51db-a21e-7c52ae1d80b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492718}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a97a25c8-3d64-58a0-8a46-bc117211d97c" :question/math-academy-id "q-5132" :question/problem "$(9{u}^{3}-4{v}^{2})(9{u}^{3}+4{v}^{2})=$" :question/worked-solution "We will use the difference of squares formula:\n\n$$\n(a+b)(a-b)={a}^{2}-{b}^{2}\n$$\n\nSubstituting $a=9{u}^{3}$ and $b=4{v}^{2},$ we have\n\n$$\n\\begin{aligned}(9{u}^{3}-4{v}^{2})(9{u}^{3}+4{v}^{2}) &= {(9{u}^{3})}^{2}-{(4{v}^{2})}^{2} \\\\ &= 81{u}^{6}-16{v}^{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234186 :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "48cc16d0-0280-564d-bcf3-e481ad8d20ab" :question/math-academy-id "q-66126" :question/problem "Calculate $\\int 1\\,\\text{d}x.$" :question/worked-solution "If we write the integrand as a power of $x$, we have ${x}^{0}=1.$ Therefore, we can use the power rule with $n=0$ and we get\n\n$$\n\\begin{aligned}\\int 1\\,\\text{d}x & =\\int {x}^{0}\\,\\text{d}x \\\\  & =\\frac{{x}^{0+1}}{0+1}+C \\\\  & =x+C.\\end{aligned}\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(x+C) &= \\frac{\\text{d}}{\\text{d}x}(x)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= 1+0 \\\\ &= 1\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234255 :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "82da9e60-e2ff-59f4-8dd3-2567c61dce48" :question/math-academy-id "q-69836" :question/problem "Factor the expression $8{x}^{5}-16{x}^{4}+6{x}^{3}.$" :question/worked-solution "Note that all of the terms have a common factor of $2{x}^{3}.$ To simplify the computation, we can factor out the $2{x}^{3},$ as follows:\n\n$$\n\\begin{aligned}8{x}^{5}-16{x}^{4}+6{x}^{3} & =2{x}^{3}(4{x}^{2}-8x+3)\\end{aligned}\n$$\n\nNow, we factor the polynomial $4{x}^{2}-8x+3,$ as follows:\n\n$$\n\\begin{aligned}2{x}^{3}(4{x}^{2}-8x+3) &= 2{x}^{3}((4{x}^{2}-6x)+(-2x+3)) \\\\ &= 2{x}^{3}(2x(2x-3)-1(2x-3)) \\\\ &= 2{x}^{3}(2x-1)(2x-3)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234263 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0293cb2c-bda1-5c83-8a0c-78a43f11388d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186479362} {:answer/id #uuid "3a9dcd64-e665-5bbe-99de-6af676869a0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186479446} {:answer/id #uuid "43dc56a9-ef06-5ad5-95ce-cadbd8aaaa52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186479458} {:answer/id #uuid "5de57ac8-c0f1-53fd-85b6-a8da90591bd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186479495} {:answer/id #uuid "e9e04f32-f49f-5493-8cf1-70b85078e012" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186479703}] :answer-field/correct {:answer/id #uuid "e9e04f32-f49f-5493-8cf1-70b85078e012" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186479703} :answer-field/id #uuid "bc540408-0f45-50a3-8a94-f7c3024065c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479799}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "26c367db-a0c7-5b44-a453-a1b81bc2c048" :question/math-academy-id "q-70116" :question/problem "Evaluate $\\frac{2(x-3)}{4-x}$ for $x=2.$" :question/worked-solution "We replace $x$ with $2$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{2(x-3)}{4-x} &= \\frac{2(2-3)}{4-2} \\\\ &= \\frac{2(-1)}{2} \\\\ &= \\frac{\\cancel{2}(-1)}{\\cancel{2}} \\\\ &= -1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234264 :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d66d9a11-d1ab-54a4-aca7-58ede8d0cd27" :question/math-academy-id "q-70142" :question/problem "Simplify $\\frac{3x+2}{3x}+\\frac{x-3}{3x}.$" :question/worked-solution "We have a common denominator of $3x,$ so we add the numerators and simplify:\n\n$$\n\\begin{aligned}\\frac{3x+2}{3x}+\\frac{x-3}{3x} &= \\frac{3x+2+x-3}{3x} \\\\ &= \\frac{(3x+x)+(2-3)}{3x} \\\\ &= \\frac{4x-1}{3x}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234265 :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "74c481bd-853a-5071-a7fe-0ad1a6173a26" :question/math-academy-id "q-70143" :question/problem "Simplify $\\frac{2z-5w}{4z}+\\frac{3z+2w}{4z}.$" :question/worked-solution "We have a common denominator of $4z,$ so we add the numerators and simplify:\n\n$$\n\\begin{aligned}\\frac{2z-5w}{4z}+\\frac{3z+2w}{4z} &= \\frac{2z-5w+3z+2w}{4z} \\\\ &= \\frac{(2z+3z)+(-5w+2w)}{4z} \\\\ &= \\frac{5z-3w}{4z}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234267 :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b3a10eb5-d01b-5c56-aeca-e9f6f41edb31" :question/math-academy-id "q-70326" :question/problem "Simplify $\\frac{2}{w+1}-\\frac{4z}{(w+1)(2z+3)}.$" :question/worked-solution "In order to subtract the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $(w+1)(2z+3)$ if we multiply the top and bottom of the first fraction by $2z+3:$\n\n$$\n\\begin{aligned}\\frac{2}{w+1}-\\frac{4z}{(w+1)(2z+3)} &= \\frac{2z+3}{2z+3}\\cdot \\frac{2}{w+1}-\\frac{4z}{(w+1)(2z+3)} \\\\ &= \\frac{2(2z+3)}{(w+1)(2z+3)}-\\frac{4z}{(w+1)(2z+3)} \\\\ &= \\frac{2(2z+3)-4z}{(w+1)(2z+3)} \\\\ &= \\frac{4z+6-4z}{(w+1)(2z+3)} \\\\ &= \\frac{6}{(w+1)(2z+3)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234268 :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "562ad4a0-13af-504d-a823-9ba166f8a5f5" :question/math-academy-id "q-70350" :question/problem "What is the result of dividing $\\frac{8a}{3}$ by $\\frac{7b}{2}?$" :question/worked-solution "To compute\n\n$$\n\\frac{8a}{3}÷\\frac{7b}{2},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{8a}{3}÷\\frac{7b}{2} &= \\frac{8a}{3}\\cdot \\frac{2}{7b} \\\\ &= \\frac{16a}{21b}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234269 :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c45628ee-4680-549c-90a6-1c8091f85ddf" :question/math-academy-id "q-70355" :question/problem "$\\frac{14}{a}÷\\frac{7}{b}=$" :question/worked-solution "To compute\n\n$$\n\\frac{14}{a}÷\\frac{7}{b},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{14}{a}÷\\frac{7}{b} &= \\frac{14}{a}\\cdot \\frac{b}{7} \\\\ &= \\frac{14b}{7a} \\\\ &= \\frac{2\\cdot \\cancel{7}\\cdot b}{\\cancel{7}a} \\\\ &= \\frac{2b}{a}\\end{aligned}\n$$\n\nNote that in the final step, we canceled out a common factor of $7$ in the numerator and denominator."} {:db/id #edb/ref 17592186234270 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16c23837-9722-5faa-902a-3e9a610ae018" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4t}{3t(t+2)}" :db/id #edb/ref 17592186512151} {:answer/id #uuid "389e3585-eb6e-5e0b-b7ad-c87d63aa1f56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{t(t+2)}" :db/id #edb/ref 17592186512223} {:answer/id #uuid "aaef2d17-80ab-59de-9959-f78c7423de66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{t+3}{3t(t+2)}" :db/id #edb/ref 17592186512503} {:answer/id #uuid "e9e2076f-e637-5540-becf-7c08397db46e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6t+5}{t(t+2)}" :db/id #edb/ref 17592186512662} {:answer/id #uuid "fd95737c-f9df-54a0-8ab8-9ef3e07fdf1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2t+1}{3t(t+2)}" :db/id #edb/ref 17592186512715}] :answer-field/correct {:answer/id #uuid "fd95737c-f9df-54a0-8ab8-9ef3e07fdf1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2t+1}{3t(t+2)}" :db/id #edb/ref 17592186512715} :answer-field/id #uuid "c848d579-8366-518a-a3ba-b24a64e2c36d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512832}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ee038b53-750c-5b8c-99dc-a961b717435d" :question/math-academy-id "q-70358" :question/problem "$\\frac{t+1}{t(t+2)}-\\frac{1}{3t}=$" :question/worked-solution "In this case, we need to put the fractions over a common denominator of $3t(t+2),$ since there are no common factors in either denominator that we can exploit.\n\nTo do this, we multiply the top and bottom of the first fraction by $3$, and the top and bottom of the second fraction by $(t+2):$\n\n$$\n\\begin{aligned}\\frac{t+1}{t(t+2)}-\\frac{1}{3t} &= \\frac{3}{3}\\cdot \\frac{t+1}{t(t+2)}-\\frac{t+2}{t+2}\\cdot \\frac{1}{3t} \\\\ &= \\frac{3(t+1)}{3t(t+2)}-\\frac{t+2}{3t(t+2)} \\\\ &= \\frac{3(t+1)-(t+2)}{3t(t+2)} \\\\ &= \\frac{3t+3-t-2}{3t(t+2)} \\\\ &= \\frac{2t+1}{3t(t+2)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234298 :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4c9da781-1702-5ac7-9948-600ab4559823" :question/math-academy-id "q-71096" :question/problem "Find the antiderivative of ${x}^{5/2}.$" :question/worked-solution "We can apply the power rule with $n=\\frac{5}{2}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{5/2}\\,\\text{d}x & =\\frac{{x}^{5/2+1}}{(\\frac{5}{2}+1)}+C \\\\  & =\\frac{{x}^{7/2}}{(\\frac{7}{2})}+C \\\\  & =\\frac{2{x}^{7/2}}{7}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{2{x}^{7/2}}{7}+C) &= \\frac{\\text{d}}{\\text{d}x}(\\frac{2{x}^{7/2}}{7})+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{2}{7}\\frac{\\text{d}}{\\text{d}x}({x}^{7/2})+0 \\\\ &= \\frac{2}{7}\\cdot \\frac{7}{2}{x}^{7/2-1} \\\\ &= {x}^{5/2}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234300 :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "eb47b292-deba-58b8-a79e-0386e8ea55e3" :question/math-academy-id "q-71121" :question/problem "Calculate $\\int {x}^{10}\\,\\text{d}x.$" :question/worked-solution "We apply the power rule with $n=10$, and we get\n\n$$\n\\int {x}^{10}\\,\\text{d}x=\\frac{{x}^{10+1}}{10+1}+C=\\frac{{x}^{11}}{11}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{11}}{11}+C) &= \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{11}}{11})+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{11}\\frac{\\text{d}}{\\text{d}x}({x}^{11})+0 \\\\ &= \\frac{1}{11}\\cdot 11{x}^{10} \\\\ &= {x}^{10}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234404 :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ca8f6868-f485-5407-858b-66b9b3950355" :question/math-academy-id "q-78167" :question/problem "Which of the following is equivalent to $(4b+3)({b}^{2}+2b+4)?$" :question/worked-solution "We distribute both terms of the binomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}(4b+3)({b}^{2}+2b+4) &= 4b({b}^{2}+2b+4)+3({b}^{2}+2b+4) \\\\ &= 4{b}^{3}+8{b}^{2}+16b+3{b}^{2}+6b+12 \\\\ &= 4{b}^{3}+11{b}^{2}+22b+12\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234405 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16a4e61c-85ba-53f6-8b3d-37e1af2be870" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186482855} {:answer/id #uuid "4909ebb6-5668-52a9-9f12-5dcbd320aa36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186482942} {:answer/id #uuid "7bd0ebfd-7f2c-544d-82ef-f50f2ab806ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186483029} {:answer/id #uuid "a64ff90e-83d3-5d8d-8482-09680c347a23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186483094} {:answer/id #uuid "b3c8c890-0e53-5290-b46b-8bf2245c28c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186483117}] :answer-field/correct {:answer/id #uuid "7bd0ebfd-7f2c-544d-82ef-f50f2ab806ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186483029} :answer-field/id #uuid "ef32ad11-6f3b-5dfc-a8a9-de51cab41cf5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483333}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4ce674de-c42a-508a-99bd-3e2090e8e038" :question/math-academy-id "q-78174" :question/problem "Given that  $(3{w}^{2}+w+5)({w}^{2}+w+1)=3{w}^{4}+a{w}^{3}+b{w}^{2}+cw+5,$ calculate $a+b+c.$" :question/worked-solution "We distribute all three terms of the trinomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}(3{w}^{2}+w+5)({w}^{2}+w+1) &= 3{w}^{2}({w}^{2}+w+1)+w({w}^{2}+w+1)+5({w}^{2}+w+1) \\\\ &= 3{w}^{4}+3{w}^{3}+3{w}^{2}+{w}^{3}+{w}^{2}+w+5{w}^{2}+5w+5 \\\\ &= 3{w}^{4}+4{w}^{3}+9{w}^{2}+6w+5\\end{aligned}\n$$\n\nTherefore, $a=4,$ $b=9,$ and $c=6.$ So, \n\n$$\na+b+c=4+9+6=19.\n$$"} {:db/id #edb/ref 17592186234414 :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fe2c15af-8288-51d2-b453-d4a7be03c631" :question/math-academy-id "q-79526" :question/problem "$\\frac{2m}{3}÷\\frac{n}{4}=$" :question/worked-solution "To compute\n\n$$\n\\frac{2m}{3}÷\\frac{n}{4},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{2m}{3}÷\\frac{n}{4} &= \\frac{2m}{3}\\cdot \\frac{4}{n} \\\\ &= \\frac{8m}{3n}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234415 :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c6f516a5-6c56-5845-9658-a29e33e78a19" :question/math-academy-id "q-79540" :question/problem "Simplify $\\frac{x-3}{2x}+\\frac{3+2x}{2x}.$" :question/worked-solution "We have a common denominator of $2x,$ so we add the numerators and simplify:\n\n$$\n\\begin{aligned}\\frac{x-3}{2x}+\\frac{3+2x}{2x} &= \\frac{x-3+3+2x}{2x} \\\\ &= \\frac{(-3+3)+(x+2x)}{2x} \\\\ &= \\frac{3x}{2x} \\\\ &= \\frac{3}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234416 :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e50fa76f-0f26-5d2e-8ac2-858b58a1f652" :question/math-academy-id "q-79541" :question/problem "Simplify $\\frac{2a-b}{4b}-\\frac{a-3b}{4b}.$" :question/worked-solution "We have a common denominator of $4b,$ so we add the numerators and simplify:\n\n$$\n\\begin{aligned}\\frac{2a-b}{4b}-\\frac{a-3b}{4b} &= \\frac{2a-b-(a-3b)}{4b} \\\\ &= \\frac{2a-b-a+3b}{4b} \\\\ &= \\frac{a+2b}{4b}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234417 :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3abd23b9-4804-5f85-9707-27d5fd905591" :question/math-academy-id "q-79542" :question/problem "Simplify $\\frac{k-4}{5k}+\\frac{1+3k}{5k}.$" :question/worked-solution "We have a common denominator of $5k,$ so we add the numerators and simplify:\n\n$$\n\\begin{aligned}\\frac{k-4}{5k}+\\frac{1+3k}{5k} &= \\frac{k-4+1+3k}{5k} \\\\ &= \\frac{(-4+1)+(k+3k)}{5k} \\\\ &= \\frac{4k-3}{5k}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234418 :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ae1669c6-d3dc-5ca9-9f09-9add8691eee5" :question/math-academy-id "q-79547" :question/problem "Given that $\\frac{3y}{2y-1}=a$ and $\\frac{1-y}{2(2y-1)}=b,$ what is $a-b?$" :question/worked-solution "We wish to subtract the following fractions:\n\n$$\na-b=\\frac{3y}{2y-1}-\\frac{1-y}{2(2y-1)}\n$$\n\nIn order to subtract the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $2(2y-1)$ if we multiply the top and bottom of the first fraction by $2:$\n\n$$\n\\begin{aligned}\\frac{3y}{2y-1}-\\frac{1-y}{2(2y-1)} &= \\frac{2}{2}\\cdot \\frac{3y}{2y-1}-\\frac{1-y}{2(2y-1)} \\\\ &= \\frac{2\\cdot 3y}{2(2y-1)}-\\frac{1-y}{2(2y-1)} \\\\ &= \\frac{6y}{2(2y-1)}-\\frac{1-y}{2(2y-1)} \\\\ &= \\frac{6y-(1-y)}{2(2y-1)} \\\\ &= \\frac{6y-1+y}{2(2y-1)} \\\\ &= \\frac{7y-1}{2(2y-1)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234419 :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b42d5053-d02c-5ab3-82ac-52fa380c9d21" :question/math-academy-id "q-79553" :question/problem "Simplify $\\frac{2}{x(2y+1)}+\\frac{3}{2y+1}.$" :question/worked-solution "In order to add the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $x(2y+1)$ if we multiply the top and bottom of the second fraction by $x:$\n\n$$\n\\begin{aligned}\\frac{2}{x(2y+1)}+\\frac{3}{2y+1} &= \\frac{2}{x(2y+1)}+\\frac{x}{x}\\cdot \\frac{3}{2y+1} \\\\ &= \\frac{2}{x(2y+1)}+\\frac{3x}{x(2y+1)} \\\\ &= \\frac{3x+2}{x(2y+1)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186235444 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e0647bb9-4d67-5b7d-a9c8-a4806d762874" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{x}^{6/5}}{6}" :db/id #edb/ref 17592186234897}] :answer-field/correct {:answer/id #uuid "e0647bb9-4d67-5b7d-a9c8-a4806d762874" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{x}^{6/5}}{6}" :db/id #edb/ref 17592186234897} :answer-field/id #uuid "f4aa3c58-8fd9-5d31-988a-048384e9e06f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235265}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cee13c2e-6226-5f1c-9ea2-cd4611314d87" :question/math-academy-id "q-167564" :question/problem "The antiderivative of $\\sqrt[5]{x}$ equals\n\n                            \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                         $+\\,\\text{ }C$" :question/worked-solution "Since $\\sqrt[5]{x}={x}^{1/5}$, we can apply the power rule with $n=\\frac{1}{5}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{1/5}\\,\\text{d}x & =\\frac{{x}^{1/5+1}}{(\\frac{1}{5}+1)}+C \\\\  & =\\frac{{x}^{6/5}}{(\\frac{6}{5})}+C \\\\  & =\\frac{5{x}^{6/5}}{6}+C.\\end{aligned}\n$$\n\nLet's check our answer by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{6/5}}{6}+C) &= \\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{6/5}}{6})+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{5}{6}\\frac{\\text{d}}{\\text{d}x}({x}^{6/5})+0 \\\\ &= \\frac{5}{6}\\cdot \\frac{6}{5}{x}^{6/5-1} \\\\ &= {x}^{1/5}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186240887 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0564dc77-a95c-55f8-906f-951bff4fd103" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{3}+8{x}^{2}+4" :db/id #edb/ref 17592186238126} {:answer/id #uuid "856b4f7e-750f-5a83-a3bf-7dfd48f978fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{3}+2{x}^{2}+5x+4" :db/id #edb/ref 17592186239218} {:answer/id #uuid "8c008be2-f90d-557c-b2af-dac8e29a0744" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{3}+4{x}^{2}+8x" :db/id #edb/ref 17592186239271} {:answer/id #uuid "99494341-7922-5afb-a809-342cfe9b4f9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{3}+8{x}^{2}+12x+16" :db/id #edb/ref 17592186239387} {:answer/id #uuid "e53fb575-4873-5670-80a1-6d7358e3a2d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{3}+8{x}^{2}+20x" :db/id #edb/ref 17592186240069}] :answer-field/correct {:answer/id #uuid "e53fb575-4873-5670-80a1-6d7358e3a2d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{3}+8{x}^{2}+20x" :db/id #edb/ref 17592186240069} :answer-field/id #uuid "17e6a458-bb70-566d-a44f-7c13e1fcf530" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240366}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a3f1939b-50de-5b94-bcb7-196c51156f21" :question/math-academy-id "q-104478" :question/problem "![](images/8d/8d940d158c631143a1fe7652a4fb83bf2f67f3fd4bbdbbc4a33643bd282b5028.png)\n\nThe Argand diagram above shows the roots of the cubic polynomial $f(x).$ Find $f(x)$ given that the coefficient of the cubic term is $4.$" :question/worked-solution "From the diagram, we see that $f(x)$ has roots ${x}_{1}=0$ and ${x}_{2,3}=-1\\pm 2\\text{i}.$ Additionally, we're given that the coefficient of the cubic term is $a=4.$ Therefore, we can write the polynomial as follows:\n\n$$\n\\begin{aligned}f(x) & =a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) \\\\  & =4(x-0)(x-(-1+2\\text{i}))(x-(-1-2\\text{i})) \\\\  & =4x(x-(-1+2\\text{i}))(x-(-1-2\\text{i}))\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}4x(x-(-1+2\\text{i}))(x-(-1-2\\text{i})) &= 4x({x}^{2}-x(-1-2\\text{i})-x(-1+2\\text{i})+(-1+2\\text{i})(-1-2\\text{i})) \\\\ &= 4x({x}^{2}+2x+5) \\\\ &= 4{x}^{3}+8{x}^{2}+20x.\\end{aligned}\n$$\n\nTherefore, $f(x)=4{x}^{3}+8{x}^{2}+20x.$"} {:db/id #edb/ref 17592186240888 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59074ef9-086c-58ad-a7d8-980d9b9a9d9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}+5{x}^{2}+27x-45" :db/id #edb/ref 17592186238822} {:answer/id #uuid "7ca38533-c4df-51e5-9004-4d767f6b1121" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}+15{x}^{2}+27x+135" :db/id #edb/ref 17592186239132} {:answer/id #uuid "8ecac77e-8d0d-508c-ac20-d5475ce11dcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}+15{x}^{2}+18x+45" :db/id #edb/ref 17592186239297} {:answer/id #uuid "c38ecfd2-1368-5e2e-bdfa-5d7b64a17003" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}-5{x}^{2}-9x+70" :db/id #edb/ref 17592186239782} {:answer/id #uuid "e1e60595-83e9-5b02-941d-642dfd9e5c6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}-15{x}^{2}-27x-135" :db/id #edb/ref 17592186240040}] :answer-field/correct {:answer/id #uuid "7ca38533-c4df-51e5-9004-4d767f6b1121" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}+15{x}^{2}+27x+135" :db/id #edb/ref 17592186239132} :answer-field/id #uuid "81c9fddb-f906-537a-9707-e0d41a21b3d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240561}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a483d6da-3355-5ef5-a0a8-57b7cc6e7d69" :question/math-academy-id "q-104487" :question/problem "The cubic polynomial $f(x)$ has roots ${x}_{1}=-5,{x}_{2,3}=\\pm 3\\text{i},$ and the coefficient of the cubic term is $3.$ Find $f(x).$" :question/worked-solution "Since $f(x)$ has roots ${x}_{1}=-5$ and ${x}_{2,3}=\\pm 3\\text{i},$ and the coefficient of the cubic term is $a=3,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}f(x) & =a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) \\\\  & =3(x-(-5))(x-3\\text{i})(x-(-3\\text{i})) \\\\  & =3(x+5)(x-3\\text{i})(x+3\\text{i})\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}3(x+5)(x-3\\text{i})(x+3\\text{i}) &= 3(x+5)({x}^{2}-(3\\text{i})^{2}) \\\\ &= 3(x+5)({x}^{2}+9) \\\\ &= 3({x}^{3}+9x+5{x}^{2}+45) \\\\ &= 3{x}^{3}+15{x}^{2}+27x+135.\\end{aligned}\n$$\n\nTherefore, $f(x)=3{x}^{3}+15{x}^{2}+27x+135.$"} {:db/id #edb/ref 17592186240889 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25676e83-3095-558f-a486-fd80a96c8d65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-4{x}^{2}-2x+20" :db/id #edb/ref 17592186238381} {:answer/id #uuid "2d33d16a-e52b-5b3f-8d70-0915e2d0b277" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{x}^{3}+4{x}^{2}+2x+20" :db/id #edb/ref 17592186238454} {:answer/id #uuid "a5e597be-fdb4-521e-b120-6476c6f417a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-2{x}^{2}+4x-10" :db/id #edb/ref 17592186239493} {:answer/id #uuid "ea32235c-f940-562b-86eb-5d5312fc39d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{x}^{3}+2{x}^{2}-4x+10" :db/id #edb/ref 17592186240116} {:answer/id #uuid "f0c0159c-448a-5f74-9af8-d19ca2c7a0d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{x}^{3}+4{x}^{2}+2x-20" :db/id #edb/ref 17592186240179}] :answer-field/correct {:answer/id #uuid "f0c0159c-448a-5f74-9af8-d19ca2c7a0d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{x}^{3}+4{x}^{2}+2x-20" :db/id #edb/ref 17592186240179} :answer-field/id #uuid "4db6eab0-eda1-50da-b991-0247906b717a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240466}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "af9df84b-0467-5970-802a-2be3fc5449e7" :question/math-academy-id "q-104489" :question/problem "The cubic polynomial $f(x)$ has roots ${x}_{1}=-2,{x}_{2,3}=3\\pm \\text{i},$ and the coefficient of the cubic term is $-1.$ Find $f(x).$" :question/worked-solution "Since $f(x)$ has roots ${x}_{1}=-2$ and ${x}_{2,3}=3\\pm \\text{i},$ and the coefficient of the cubic term is $a=-1,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}f(x) & =a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) \\\\  & =-1(x-(-2))(x-(3+\\text{i}))(x-(3-\\text{i})) \\\\  & =-(x+2)(x-(3+\\text{i}))(x-(3-\\text{i}))\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}-(x+2)(x-(3+\\text{i}))(x-(3-\\text{i})) &= -(x+2)({x}^{2}-x(3-\\text{i})-x(3+\\text{i})+(3+\\text{i})(3-\\text{i})) \\\\ &= -(x+2)({x}^{2}-6x+10) \\\\ &= -({x}^{3}-6{x}^{2}+10x+2{x}^{2}-12x+20) \\\\ &= -{x}^{3}+4{x}^{2}+2x-20.\\end{aligned}\n$$\n\nTherefore, $f(x)=-{x}^{3}+4{x}^{2}+2x-20.$"} {:db/id #edb/ref 17592186240891 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03ddab8b-ea2b-55eb-b6af-9fc42380d8ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2,3\\pm \\text{i}" :db/id #edb/ref 17592186238116} {:answer/id #uuid "0c4923f7-6dbe-533f-8fc9-cd13423241ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2,3\\pm \\text{i}" :db/id #edb/ref 17592186238167} {:answer/id #uuid "15f92b3d-72a2-5edf-8070-6e3c6616c37c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2,0,3-\\text{i}" :db/id #edb/ref 17592186238239} {:answer/id #uuid "219adb45-cc4a-595d-8997-8c9e5569e301" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm 2,3-\\text{i}" :db/id #edb/ref 17592186238347} {:answer/id #uuid "7310bcc0-1b4c-5dac-8f9c-c7809bf84977" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=0,3-\\text{i},1+3\\text{i}" :db/id #edb/ref 17592186239039}] :answer-field/correct {:answer/id #uuid "0c4923f7-6dbe-533f-8fc9-cd13423241ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2,3\\pm \\text{i}" :db/id #edb/ref 17592186238167} :answer-field/id #uuid "ece2ff83-0d7a-55e7-848c-06928bf3c946" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240745}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0788e647-7a4e-5549-adea-a1cd056a2776" :question/math-academy-id "q-104514" :question/problem "Find all of the solutions to ${x}^{3}-4{x}^{2}-2x+20=0$ given that $x=3-\\text{i}$ is a solution." :question/worked-solution "First, we let $f(x)={x}^{3}-4{x}^{2}-2x+20.$ \n\nSince $f(x)$ has real coefficients and ${x}_{1}=3-\\text{i}$ is a root of $f(x),$ the complex conjugate \n\n$$\n\\overset{―}{{x}_{1}}=\\overset{―}{3-\\text{i}}=3+\\text{i}\n$$\n\nmust also be a root of $f(x).$\n\nNow, according to the factor theorem, \n$(x-(3-\\text{i}))(x-(3+\\text{i}))$\nis a factor of $f(x).$ Expanding the parentheses, we obtain\n\n$$\n\\begin{aligned}(x-(3-\\text{i}))(x-(3+\\text{i})) &= {x}^{2}-(3-\\text{i}+(3+\\text{i)})x+(3-\\text{i})(3+\\text{i}) \\\\ &= {x}^{2}-6x+({3}^{2}-(\\text{i})^{2}) \\\\ &= {x}^{2}-6x+10.\\end{aligned}\n$$\n\nNext, we find the quotient when $f(x)$ is divided by ${x}^{2}-6x+10$ using polynomial division.\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,x+2 \\\\  & {x}^{2}-6x+10\\,\\,\\enclose{longdiv}{\\,{x}^{3}-4{x}^{2}-\\phantom{2}2x+20} \\\\  & \\,\\,\\,\\,\\,{{x}^{3}-6{x}^{2}+10x}_{―} \\\\  & \\,\\,\\,\\,\\,2{x}^{2}-12x+20 \\\\  & \\,\\,\\,\\,\\,{2{x}^{2}-12x+20}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,0\\end{aligned}\n$$\n\n     \n\nThus, $f(x)=({x}^{2}-6x+10)(x+2).$ \n\nTo find the remaining root, we set the linear factor equal to zero and solve for $x:$\n\n$$\n\\begin{aligned}x+2=0\\,⟹\\,x=-2.\\end{aligned}\n$$\n\nTherefore, the roots are $x=-2,3\\pm \\text{i}.$"} {:db/id #edb/ref 17592186240892 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aea373f-7c96-5b68-9731-2e656356b158" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-4,0,-5+2\\text{i}" :db/id #edb/ref 17592186238158} {:answer/id #uuid "0e72db85-3f8c-58b9-8b51-13c25222f1dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=0,4,-5+2\\text{i}" :db/id #edb/ref 17592186238180} {:answer/id #uuid "3a5ebd82-7075-5092-81f4-f465a40268f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm 4,-5+2\\text{i}" :db/id #edb/ref 17592186238564} {:answer/id #uuid "9ddb6547-8aaf-51f7-9078-f4201f415cdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=4,-5\\pm 2\\text{i}" :db/id #edb/ref 17592186239434} {:answer/id #uuid "dfbf0afb-1527-5fe1-a5fa-a1efaa5f2f47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-4,-5\\pm 2\\text{i}" :db/id #edb/ref 17592186240010}] :answer-field/correct {:answer/id #uuid "9ddb6547-8aaf-51f7-9078-f4201f415cdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=4,-5\\pm 2\\text{i}" :db/id #edb/ref 17592186239434} :answer-field/id #uuid "45673382-dcde-536a-a583-e028748bc7e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240449}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d1be54b7-7530-59ba-90a4-e2866a7b30e9" :question/math-academy-id "q-104516" :question/problem "Find all of the solutions to ${x}^{3}+6{x}^{2}-11x-116=0$ given that $x=-5+2\\text{i}$ is a solution." :question/worked-solution "First, we let $f(x)={x}^{3}+6{x}^{2}-11x-116.$\n\nSince $f(x)$ has real coefficients and ${x}_{1}=-5+2\\text{i}$ is a root of $f(x),$ the complex conjugate \n\n$$\n\\overset{―}{{x}_{1}}=\\overset{―}{-5+2\\text{i}}=-5-2\\text{i}\n$$\n\nmust also be a root of $f(x).$\n\nNow, according to the factor theorem, \n$(x-(-5+2\\text{i}))(x-(-5-2\\text{i}))$\nis a factor of $f(x).$ Expanding the parentheses, we obtain\n\n$$\n\\begin{aligned}(x-(-5+2\\text{i}))(x-(-5-2\\text{i})) &= {x}^{2}-(-5+2\\text{i}+(-5-2\\text{i)})x+(-5+2\\text{i})(-5-2\\text{i}) \\\\ &= {x}^{2}+10x+((-5)^{2}-(2\\text{i})^{2}) \\\\ &= {x}^{2}+10x+29.\\end{aligned}\n$$\n\nNext, we find the quotient when $f(x)$ is divided by ${x}^{2}+10x+29$ using polynomial division.\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,x-4 \\\\  & {x}^{2}+10x+29\\,\\,\\enclose{longdiv}{\\,{x}^{3}+\\phantom{1}6{x}^{2}-11x-116} \\\\  & \\,\\,\\,\\,\\,{{x}^{3}+10{x}^{2}+29x}_{―} \\\\  & \\,\\,\\,\\,-4{x}^{2}+40x-116 \\\\  & \\,\\,\\,{-4{x}^{2}+40x-116}_{―} \\\\  & \\,\\,\\,\\,0\\end{aligned}\n$$\n\n        \n\nThus, $f(x)=({x}^{2}+10x+29)(x-4).$ \n\nTo find the remaining root, we set the linear factor equal to zero and solve for $x:$\n\n$$\n\\begin{aligned}x-4=0\\,⟹\\,x=4.\\end{aligned}\n$$\n\nTherefore, the roots are $x=4,-5\\pm 2\\text{i}.$"} {:db/id #edb/ref 17592186244023 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "993ae900-0b4b-5abe-9f83-6751e2fb1c11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447862} {:answer/id #uuid "e695c7f1-667b-5020-86a7-e386d42f1a7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447863}] :answer-field/correct {:answer/id #uuid "e695c7f1-667b-5020-86a7-e386d42f1a7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447863} :answer-field/id #uuid "0f0d1d52-7140-5348-9cd1-1a8686f2ba48" :answer-field/key "$D$ is closed under matrix addition" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448971} {:answer-field/choices [{:answer/id #uuid "c459fa0e-ba69-5797-a8f3-156380db3ae9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447864} {:answer/id #uuid "7a734cc8-b862-5978-9bf3-23c44c430045" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447865}] :answer-field/correct {:answer/id #uuid "7a734cc8-b862-5978-9bf3-23c44c430045" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447865} :answer-field/id #uuid "eb0e53d6-ce03-554c-8ebc-cfddde79bc53" :answer-field/key "$D$ is closed under scalar multiplication" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448972} {:answer-field/choices [{:answer/id #uuid "a468ba0f-e58b-5475-abdf-a2e8beac6de7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447866} {:answer/id #uuid "8f7dce65-5e9c-54f3-bf6d-f0bdded38c59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447867}] :answer-field/correct {:answer/id #uuid "8f7dce65-5e9c-54f3-bf6d-f0bdded38c59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447867} :answer-field/id #uuid "45d468d9-ad9e-5842-b1a1-0d81106ec1a5" :answer-field/key "$D$ is a subspace of ${\\text{M}}_{2}(R)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448973} {:answer-field/choices [{:answer/id #uuid "dc820af5-3c85-57d4-81c4-43eca3e0a851" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447868} {:answer/id #uuid "d8582ad8-c4ee-5cb2-b47f-96766390b92f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186447869}] :answer-field/correct {:answer/id #uuid "dc820af5-3c85-57d4-81c4-43eca3e0a851" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186447868} :answer-field/id #uuid "e7cdbeab-101c-5f0b-8940-0a457a37d7f7" :answer-field/key "$D$ is **not** a subspace of ${\\text{M}}_{2}(R)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186448974}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "72b2f218-4463-5051-8c3b-5d02162b5905" :question/math-academy-id "q-107115" :question/problem "Consider the vector space ${\\text{M}}_{2}(R)$ of all $2\\times 2$ matrices over $R,$  and its subset $D$ containing all $2\\times 2$ matrices such that the sum of all its entries equals $0.$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement “$D$ is closed under matrix addition” is true. Suppose ${A}_{1}=\\begin{bmatrix}{a}_{1} & {b}_{1} \\\\ {c}_{1} & {d}_{1}\\end{bmatrix}$ and ${A}_{2}=\\begin{bmatrix}{a}_{2} & {b}_{2} \\\\ {c}_{2} & {d}_{2}\\end{bmatrix}$ are two matrices from $D.$  then \n\n$$\n{A}_{1}+{A}_{2}=\\begin{bmatrix}{a}_{1}+{a}_{2} & {b}_{1}+{b}_{2} \\\\ {c}_{1}+{c}_{2} & {d}_{1}+{d}_{2}\\end{bmatrix},\n$$\n\n and since \n\n$$\n\\begin{aligned}({a}_{1}+{a}_{2})+({b}_{1}+{b}_{2})+({c}_{1}+{c}_{2})+({d}_{1}+{d}_{2}) &= ({a}_{1}+{b}_{1}+{c}_{1}+{d}_{1})+({a}_{1}+{b}_{1}+{c}_{1}+{d}_{1}) \\\\ &= 0+0 \\\\ &= 0\\end{aligned}\n$$\n\nwe can conclude that ${A}_{1}+{A}_{2}$ also belongs to $D.$ So, $D$ is closed under addition.\n\n- Statement “$D$ is closed under scalar multiplication” is true. Indeed, suppose $A=\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix}\\in D$ and let $\\alpha \\in R.$ Then \n\n$$\n\\alpha A=\\begin{bmatrix}\\alpha a & \\alpha b \\\\ \\alpha c & \\alpha d\\end{bmatrix},\n$$\n\n and so\nthe sum of the entries of $\\alpha A$ is\n\n$$\n\\begin{aligned}\\alpha a+\\alpha b+\\alpha c+\\alpha d & =\\alpha (a+b+c+d) \\\\  & =\\alpha \\cdot 0 \\\\  & =0.\\end{aligned}\n$$\n\nSo, $D$ is closed under scalar multiplication.\n\n- Statement “$D$ is a subspace of ${\\text{M}}_{2}(R)$” is true, while statement “$D$ is **not** a subspace of ${\\text{M}}_{2}(R)$” is false. $D$ is a subspace because it's closed under addition and scalar multiplication.\n\nTherefore, the correct answer is “$D$ is closed under matrix addition”; “$D$ is closed under scalar multiplication”; “$D$ is a subspace of ${\\text{M}}_{2}(R)$” only."} {:db/id #edb/ref 17592186244074 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "125b5441-169c-5c8c-9e85-5a63fc3213e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}+{x}^{2}+16x+32" :db/id #edb/ref 17592186241336} {:answer/id #uuid "9fa66e90-1523-5fd6-86ba-c90bc2cca67d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}+{x}^{2}+16x+16" :db/id #edb/ref 17592186242578} {:answer/id #uuid "b3472ffd-7be3-5657-aa95-029ef4173284" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}+2{x}^{2}+32x+32" :db/id #edb/ref 17592186242742} {:answer/id #uuid "b96dcbb4-3010-59db-8ba3-1575ffe3ad6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-{x}^{2}+16x-16" :db/id #edb/ref 17592186242807} {:answer/id #uuid "c279c09c-db82-5f98-a262-873a41535a25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}-2{x}^{2}+32x-32" :db/id #edb/ref 17592186242886}] :answer-field/correct {:answer/id #uuid "b3472ffd-7be3-5657-aa95-029ef4173284" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}+2{x}^{2}+32x+32" :db/id #edb/ref 17592186242742} :answer-field/id #uuid "38bd56dd-1b91-57f1-a323-61ffffbffb5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243546}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cfde5111-ff04-5cb7-9dca-923364fa8f8f" :question/math-academy-id "q-107541" :question/problem "The cubic polynomial $f(x)$ has roots ${x}_{1}=-1,{x}_{2,3}=\\pm 4\\text{i},$ and the coefficient of the cubic term is $2.$ Find $f(x).$" :question/worked-solution "Since $f(x)$ has roots ${x}_{1}=-1$ and ${x}_{2,3}=\\pm 4\\text{i},$ and the coefficient of the cubic term is $a=2,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}f(x) & =a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) \\\\  & =2(x-(-1))(x-4\\text{i})(x-(-4\\text{i})) \\\\  & =2(x+1)(x-4\\text{i})(x+4\\text{i})\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}2(x+1)(x-4\\text{i})(x+4\\text{i}) &= 2(x+1)({x}^{2}-(4\\text{i})^{2}) \\\\ &= 2(x+1)({x}^{2}+16) \\\\ &= 2({x}^{3}+{x}^{2}+16x+16) \\\\ &= 2{x}^{3}+2{x}^{2}+32x+32.\\end{aligned}\n$$\n\nTherefore, $f(x)=2{x}^{3}+2{x}^{2}+32x+32.$"} {:db/id #edb/ref 17592186244097 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dca6afc-05ee-5091-aae2-340523b6e26e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}-6{x}^{2}+20x-15" :db/id #edb/ref 17592186241297} {:answer/id #uuid "38c7b47d-8713-5cfe-bf1d-cc09ed6cae5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}+6{x}^{2}+50x+10" :db/id #edb/ref 17592186241689} {:answer/id #uuid "3e2941ca-d5f7-5c2b-b424-dfafe8576353" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}+6{x}^{2}+50x+150" :db/id #edb/ref 17592186241734} {:answer/id #uuid "d8b09b9a-26fb-5eb5-b228-9952f4ba6e9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}-6{x}^{2}+50x-150" :db/id #edb/ref 17592186243108} {:answer/id #uuid "e28b9c62-3182-54e0-a9d5-e6c22aa66148" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-3{x}^{2}+25x-75" :db/id #edb/ref 17592186243192}] :answer-field/correct {:answer/id #uuid "d8b09b9a-26fb-5eb5-b228-9952f4ba6e9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}-6{x}^{2}+50x-150" :db/id #edb/ref 17592186243108} :answer-field/id #uuid "67f68c43-f87d-5fdf-9a7e-13e49e2d2ba3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243644}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3c8eacb5-c4fc-55c6-a117-32cf498dd072" :question/math-academy-id "q-107669" :question/problem "The cubic polynomial $f(x)$ has roots ${x}_{1}=3,{x}_{2,3}=\\pm 5\\text{i},$ and the coefficient of the cubic term is $2.$ Find $f(x).$" :question/worked-solution "Since $f(x)$ has roots ${x}_{1}=3$ and ${x}_{2,3}=\\pm 2\\text{i},$ and the coefficient of the cubic term is $a=2,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}f(x) & =a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) \\\\  & =2(x-3)(x-5\\text{i})(x-(-5\\text{i})) \\\\  & =2(x-3)(x-5\\text{i})(x+5\\text{i})\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}2(x-3)(x-5\\text{i})(x+5\\text{i}) &= 2(x-3)({x}^{2}-(5\\text{i})^{2}) \\\\ &= 2(x-3)({x}^{2}+25) \\\\ &= 2({x}^{3}-3{x}^{2}+25x-75) \\\\ &= 2{x}^{3}-6{x}^{2}+50x-150.\\end{aligned}\n$$\n\nTherefore, $f(x)=2{x}^{3}-6{x}^{2}+50x-150.$"} {:db/id #edb/ref 17592186244098 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97bd4273-e4e0-500a-8825-2b95afd28437" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{3}-4{x}^{2}+8x" :db/id #edb/ref 17592186242508} {:answer/id #uuid "aa1e5403-83ff-59b0-8131-aec05d0f5997" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{3}-2{x}^{2}+3x" :db/id #edb/ref 17592186242669} {:answer/id #uuid "bea9ead4-c01f-5f13-b721-b4191d121113" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{3}-16{x}^{2}+32x" :db/id #edb/ref 17592186242852} {:answer/id #uuid "c80f4aa7-2aa2-5910-b13d-58ca13127753" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{3}-8{x}^{2}+16x" :db/id #edb/ref 17592186242946} {:answer/id #uuid "e7dc2316-1713-5701-9aec-0117a93aeec4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{3}-5{x}^{2}+10x" :db/id #edb/ref 17592186243233}] :answer-field/correct {:answer/id #uuid "bea9ead4-c01f-5f13-b721-b4191d121113" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{3}-16{x}^{2}+32x" :db/id #edb/ref 17592186242852} :answer-field/id #uuid "fc2a8fba-eea0-52ae-b63e-a0f707f2bd15" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243878}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2decd930-e39a-52cd-b5e4-e2dcc753b106" :question/math-academy-id "q-107670" :question/problem "![](images/a9/a926400e24bc00ca9027d44461e800fa22015ff8289f05fba3a8b51f8b72cce5.png)\n\nThe Argand diagram above shows the roots of the cubic polynomial $f(x).$ Find $f(x)$ given that the coefficient of the cubic term is $4.$" :question/worked-solution "From the diagram, we see that $f(x)$ has roots ${x}_{1}=0$ and ${x}_{2,3}=2\\pm 2\\text{i}.$ Additionally, we're given that the coefficient of the cubic term is $a=4.$ Therefore, we can write the polynomial as follows:\n\n$$\n\\begin{aligned}f(x) & =a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) \\\\  & =4(x-0)(x-(2+2\\text{i}))(x-(2-2\\text{i})) \\\\  & =4x(x-(2+2\\text{i}))(x-(2-2\\text{i}))\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}4x(x-(2+2\\text{i}))(x-(2-2\\text{i})) &= 4x({x}^{2}-x(2-2\\text{i})-x(2+2\\text{i})+(2+2\\text{i})(2-2\\text{i})) \\\\ &= 4x({x}^{2}-4x+8) \\\\ &= 4{x}^{3}-16{x}^{2}+32x.\\end{aligned}\n$$\n\nTherefore, $f(x)=4{x}^{3}-16{x}^{2}+32x.$"} {:db/id #edb/ref 17592186247251 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24cbc620-3f1b-5499-a56a-3ccd781a5ff3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60(x-5)^{5}(y-2)^{3}" :db/id #edb/ref 17592186244641} {:answer/id #uuid "6eaaa960-bdce-5c2f-9ce5-c28877c55ed7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30(x-5)^{5}(y-2)^{3}" :db/id #edb/ref 17592186245296} {:answer/id #uuid "97bbe93f-3660-5ad4-a774-eb1346889136" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90(x-5)^{5}(y-2)^{3}" :db/id #edb/ref 17592186245654} {:answer/id #uuid "a4d1b7ba-9322-54c0-b83a-512b51cc299b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60(x-5)^{11}(y-2)^{7}" :db/id #edb/ref 17592186245789} {:answer/id #uuid "e74b41a8-47d9-5b68-a085-eb961f016311" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90(x-5)^{11}(y-2)^{7}" :db/id #edb/ref 17592186246361}] :answer-field/correct {:answer/id #uuid "24cbc620-3f1b-5499-a56a-3ccd781a5ff3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60(x-5)^{5}(y-2)^{3}" :db/id #edb/ref 17592186244641} :answer-field/id #uuid "149fcc7b-154b-5bdb-97b5-46b12b6632d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246583}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "467c944d-a18c-50f2-9456-d9d3072e545c" :question/math-academy-id "q-112230" :question/problem "Find the least common multiple of the polynomials $5(x-5)^{5}(y-2)^{3},$ $\\,6(x-5)^{3}(y-2)^{3},$ and $12(x-5)^{3}(y-2)^{2}.$" :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of three polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of each variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(5,6,12):$\n\n- Multiples of $5:$ $\\,5,\\,10,…,\\,55,\\,60,\\,65,\\,…$\n\n- Multiples of $6:$ $\\,6,\\,12,…,\\,54,\\,60,\\,66,…$\n\n- Multiples of $12:$ $\\,12,\\,24,\\,36,\\,48,\\,60,\\,72,…$\n\nSo, $\\text{LCM}(5,6,12)=60.$\n\nTo find the $\\text{LCM}$ of $(x-5)^{5}(y-2)^{3},(x-5)^{3}(y-2)^{3},$ and $(x-5)^{3}(y-2)^{2},$ we find the largest powers for $(x-5)$ and $(y-2)$ that appear in all these expressions:\n\n- For $(x-5)^{5},(x-5)^{3},$ and $(x-5)^{3},$ the largest power is $5.$\n\n- For $(y-2)^{3},(y-2)^{3},$ and $(y-2)^{2},$ the largest power is $3.$\n\nNow, we raise $(x-5)$ and $(y-2)$ to the corresponding largest powers. Therefore,\n\n$$\n\\text{LCM}((x-5)^{5}(y-2)^{3},\\,(x-5)^{3}(y-2)^{3},\\,(x-5)^{3}(y-2)^{2})=(x-5)^{5}\\cdot (y-2)^{3}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\begin{aligned}\\text{LCM}(5(x-5)^{5}(y-2)^{3},\\,6(x-5)^{3}(y-2)^{3},\\,12(x-5)^{3}(y-2)^{2}) &= 60\\cdot (x-5)^{5}\\cdot (y-2)^{3} \\\\ &= 60(x-5)^{5}(y-2)^{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186247330 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67dd3b57-45c4-5d45-b295-110610505df3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5h-2g}{3h}" :db/id #edb/ref 17592186245234} {:answer/id #uuid "a9a17a60-6446-593c-822d-c54e7059e45d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2h-3g}{3h}" :db/id #edb/ref 17592186245828} {:answer/id #uuid "bbbd2f91-5b3d-5e4f-809b-7f62c87bdbdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5h-g}{h}" :db/id #edb/ref 17592186245988} {:answer/id #uuid "c5b54a51-9bfd-551f-be9a-13168b235e52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5h+g}{3h}" :db/id #edb/ref 17592186246067} {:answer/id #uuid "cab4bd36-5e91-51f6-8f60-a0028a404018" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{h-2g}{h}" :db/id #edb/ref 17592186246115}] :answer-field/correct {:answer/id #uuid "67dd3b57-45c4-5d45-b295-110610505df3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5h-2g}{3h}" :db/id #edb/ref 17592186245234} :answer-field/id #uuid "0be469b5-185b-5d16-b7db-5997fc487b93" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246570}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "820302ba-7daa-5842-ae37-80ccb4043de0" :question/math-academy-id "q-113214" :question/problem "Simplify $\\frac{5g+3h}{3h}-\\frac{7g-2h}{3h}.$" :question/worked-solution "We have a common denominator of $3h,$ so we add the numerators and simplify:\n\n$$\n\\begin{aligned}\\frac{5g+3h}{3h}-\\frac{7g-2h}{3h} &= \\frac{5g+3h-(7g-2h)}{3h} \\\\ &= \\frac{5g+3h-7g+2h}{3h} \\\\ &= \\frac{5h-2g}{3h}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186247331 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b25ac5b-cbcc-57ea-af98-36cbf2debd6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{p-5}{p}" :db/id #edb/ref 17592186244417} {:answer/id #uuid "2835dbf8-8dfd-5b11-9840-111aa89d7e47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2p-5}{p}" :db/id #edb/ref 17592186244668} {:answer/id #uuid "3e3d761c-0e4f-53bc-9bc6-dd4223070293" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(p+5)}{p}" :db/id #edb/ref 17592186244861} {:answer/id #uuid "72ffb2d8-d1e6-5411-9428-219a615ab1ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2p+5}{p}" :db/id #edb/ref 17592186245343} {:answer/id #uuid "b2cd2d36-c9bd-5a3c-ac47-c6f5b8d1b85a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{p+5}{p}" :db/id #edb/ref 17592186245905}] :answer-field/correct {:answer/id #uuid "72ffb2d8-d1e6-5411-9428-219a615ab1ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2p+5}{p}" :db/id #edb/ref 17592186245343} :answer-field/id #uuid "3900ea01-ab69-50df-9eb2-9740cea656bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246643}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "db256712-a567-5c31-aac9-855b317092f8" :question/math-academy-id "q-113217" :question/problem "Write $3+\\frac{5-p}{p}$ as a single fraction." :question/worked-solution "Using the fact that $3=\\frac{3}{1},$ we can write the expression as\n\n$$\n\\frac{3}{1}+\\frac{5-p}{p}.\n$$\n\n \n\nIn order to add the two fractions, we need them to have a common denominator. So, we put both fractions over a common denominator of $p$ by multiplying the top and bottom of the first fraction by $p:$\n\n$$\n\\begin{aligned}\\frac{3}{1}+\\frac{5-p}{p} &= \\frac{p}{p}\\cdot \\frac{3}{1}+\\frac{5-p}{p} \\\\ &= \\frac{3p}{p}+\\frac{5-p}{p}\\end{aligned}\n$$\n\nFinally, we add the fractions and simplify the result:\n\n$$\n\\begin{aligned}\\frac{3p}{p}+\\frac{5-p}{p} &= \\frac{3p+5-p}{p} \\\\ &= \\frac{2p+5}{p}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186247332 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b73d21d-9416-5109-9b2c-366c52f5b440" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(t-3)}{t}" :db/id #edb/ref 17592186244557} {:answer/id #uuid "5046202d-b128-535c-b53a-0d1b293edf6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{t-6}{t}" :db/id #edb/ref 17592186245028} {:answer/id #uuid "7efac3a0-17a0-5291-a8ff-2de851fc536b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{t+3}{t}" :db/id #edb/ref 17592186245434} {:answer/id #uuid "9bfb59c7-e9e8-5eea-99f5-562e3547dd90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{t+6}{t}" :db/id #edb/ref 17592186245694} {:answer/id #uuid "e914672f-3b03-5112-ab49-51ee5fd298c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(t+3)}{t}" :db/id #edb/ref 17592186246376}] :answer-field/correct {:answer/id #uuid "e914672f-3b03-5112-ab49-51ee5fd298c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(t+3)}{t}" :db/id #edb/ref 17592186246376} :answer-field/id #uuid "90edd1ba-2ab1-5ced-aca0-6729f02c3d28" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246796}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6a165a7a-a9ab-5ae7-96ca-f3a6cb8eeab0" :question/math-academy-id "q-113218" :question/problem "$2-\\frac{(-6)}{t}=$" :question/worked-solution "Using the fact that $2=\\frac{2}{1},$ we can write the expression as\n\n$$\n\\frac{2}{1}-\\frac{(-6)}{t}=.\n$$\n\n \n\nIn order to subtract the two fractions, we need them to have a common denominator. So, we put both fractions over a common denominator of $t$ by multiplying the top and bottom of the first fraction by $t:$\n\n$$\n\\begin{aligned}\\frac{2}{1}-\\frac{(-6)}{t} &= \\frac{t}{t}\\cdot \\frac{2}{1}-\\frac{(-6)}{t} \\\\ &= \\frac{2t}{t}-\\frac{(-6)}{t}\\end{aligned}\n$$\n\nFinally, we subtract the fractions and simplify the result:\n\n$$\n\\begin{aligned}\\frac{2t}{t}-\\frac{(-6)}{t} &= \\frac{2t-(-6)}{t} \\\\ &= \\frac{2t+6}{t} \\\\ &= \\frac{2(t+3)}{t}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186247333 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "165183aa-3273-5868-996d-bf72842cf7e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(2h+1)}{h}" :db/id #edb/ref 17592186244519} {:answer/id #uuid "4270531d-a040-562e-b202-75ec50fead69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(2h-1)}{h}" :db/id #edb/ref 17592186244895} {:answer/id #uuid "9220ca4b-6d7c-5b14-9adf-33f3030837cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2h-1}{h}" :db/id #edb/ref 17592186245586} {:answer/id #uuid "d60d60b4-9436-5997-b763-9f4ab2aa9c33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{h-3}{h}" :db/id #edb/ref 17592186246220} {:answer/id #uuid "fc805e18-0d87-57e6-a207-15782a97edad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2h+1}{h}" :db/id #edb/ref 17592186246523}] :answer-field/correct {:answer/id #uuid "4270531d-a040-562e-b202-75ec50fead69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(2h-1)}{h}" :db/id #edb/ref 17592186244895} :answer-field/id #uuid "c644fa58-4381-548f-9a70-2fdfff8866ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246903}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "896043de-6bd3-58d0-93eb-3b6444623304" :question/math-academy-id "q-113219" :question/problem "Write $5+\\frac{h-3}{h}$ as a single fraction." :question/worked-solution "Using the fact that $5=\\frac{5}{1},$ we can write the expression as\n\n$$\n\\frac{5}{1}+\\frac{h-3}{h}.\n$$\n\n \n\nIn order to add the two fractions, we need them to have a common denominator. So, we put both fractions over a common denominator of $h$ by multiplying the top and bottom of the first fraction by $h:$\n\n$$\n\\begin{aligned}\\frac{5}{1}+\\frac{h-3}{h} &= \\frac{h}{h}\\cdot \\frac{5}{1}+\\frac{h-3}{h} \\\\ &= \\frac{5h}{h}+\\frac{h-3}{h}\\end{aligned}\n$$\n\nFinally, we add the fractions and simplify the result:\n\n$$\n\\begin{aligned}\\frac{5h}{h}+\\frac{h-3}{h} &= \\frac{5h+h-3}{h} \\\\ &= \\frac{6h-3}{h} \\\\ &= \\frac{3(2h-1)}{h}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186247334 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "289df949-9aca-5868-b2e6-7fc123437b02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(k-1)}{k}" :db/id #edb/ref 17592186244670} {:answer/id #uuid "4507562e-327a-5923-9637-3a4a0ff8978c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(k+1)}{k}" :db/id #edb/ref 17592186244924} {:answer/id #uuid "4a25b4c7-7b47-56ec-be00-4e147b03506b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8k-3}{k}" :db/id #edb/ref 17592186244974} {:answer/id #uuid "9c84f288-b8d5-5b4a-9815-6bf9c4a6b654" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4k-1}{k}" :db/id #edb/ref 17592186245703} {:answer/id #uuid "f4731473-088e-5492-9779-f5756af54cf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4k+3}{k}" :db/id #edb/ref 17592186246469}] :answer-field/correct {:answer/id #uuid "f4731473-088e-5492-9779-f5756af54cf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4k+3}{k}" :db/id #edb/ref 17592186246469} :answer-field/id #uuid "bdcaaf35-9eee-5f60-848f-59fe01863b31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246890}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d25e0ccf-d3b4-58e5-809a-e678b308dab7" :question/math-academy-id "q-113221" :question/problem "Write $6+\\frac{3-2k}{k}$ as a single fraction." :question/worked-solution "Using the fact that $6=\\frac{6}{1},$ we can write the expression as\n\n$$\n\\frac{6}{1}+\\frac{3-2k}{k}.\n$$\n\n \n\nIn order to add the two fractions, we need them to have a common denominator. So, we put both fractions over a common denominator of $k$ by multiplying the top and bottom of the first fraction by $k:$\n\n$$\n\\begin{aligned}\\frac{6}{1}+\\frac{3-2k}{k} &= \\frac{k}{k}\\cdot \\frac{6}{1}+\\frac{3-2k}{k} \\\\ &= \\frac{6k}{k}+\\frac{3-2k}{k}\\end{aligned}\n$$\n\nFinally, we add the fractions and simplify the result:\n\n$$\n\\begin{aligned}\\frac{6k}{k}+\\frac{3-2k}{k} &= \\frac{6k+3-2k}{k} \\\\ &= \\frac{4k+3}{k}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186247335 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b4b1d38-2311-56d2-8ff8-847101e91f10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(w-4)}{w+4}" :db/id #edb/ref 17592186244420} {:answer/id #uuid "479080f6-d6c2-57ac-a222-41a329f2d8a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{w+24}{w+4}" :db/id #edb/ref 17592186244950} {:answer/id #uuid "5f729ef3-6438-56ea-be0a-f771bd49e8e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{w+8}{w+4}" :db/id #edb/ref 17592186245152} {:answer/id #uuid "7fd105ba-0c19-5160-8f3f-a2296231bc46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3(w+8)}{w+4}" :db/id #edb/ref 17592186245441} {:answer/id #uuid "dd1770bb-e867-52f8-8128-c619cca15269" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3w+10}{w+4}" :db/id #edb/ref 17592186246278}] :answer-field/correct {:answer/id #uuid "7fd105ba-0c19-5160-8f3f-a2296231bc46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3(w+8)}{w+4}" :db/id #edb/ref 17592186245441} :answer-field/id #uuid "c619d20c-25a8-5fd7-b8dd-7593cc8993f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246902}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0d456d55-d203-5b62-816e-e770a13ebca5" :question/math-academy-id "q-113225" :question/problem "Write $\\frac{3w}{w+4}-6$ as a single fraction." :question/worked-solution "Using the fact that $6=\\frac{6}{1}$, we can write the expression as\n\n$$\n\\frac{3w}{w+4}-\\frac{6}{1}.\n$$\n\n \n\nIn order to subtract the two fractions, we need them to have a common denominator. So, we put both fractions over a common denominator of $w+4$ by multiplying the top and bottom of the second fraction by $w+4:$\n\n$$\n\\begin{aligned}\\frac{3w}{w+4}-\\frac{6}{1} &= \\frac{3w}{w+4}-\\frac{w+4}{w+4}\\cdot \\frac{6}{1} \\\\ &= \\frac{3w}{w+4}-\\frac{6(w+4)}{w+4}\\end{aligned}\n$$\n\nFinally, we subtract the fractions and simplify the result:\n\n$$\n\\begin{aligned}\\frac{3w}{w+4}-\\frac{6(w+4)}{w+4} &= \\frac{3w-6(w+4)}{w+4} \\\\ &= \\frac{3w-6w-24}{w+4} \\\\ &= \\frac{-3w-24}{w+4} \\\\ &= -\\frac{3(w+8)}{w+4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186247338 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "585269a6-c920-5376-8ab2-ea00af2530d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3n+2}{n-2}" :db/id #edb/ref 17592186245094} {:answer/id #uuid "62524c32-b910-5a62-a7d1-de72532adce1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7n+2}{n-2}" :db/id #edb/ref 17592186245176} {:answer/id #uuid "922cb471-2d72-58c0-9f71-d49afdb6fa50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3n-2}{n-2}" :db/id #edb/ref 17592186245587} {:answer/id #uuid "9cbdcd01-5dfc-5a29-b2ce-1797405d3388" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5n+4}{n-2}" :db/id #edb/ref 17592186245706} {:answer/id #uuid "bce0146c-26a7-5b70-a794-aafc5c80578f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7n-4}{n-2}" :db/id #edb/ref 17592186245998}] :answer-field/correct {:answer/id #uuid "62524c32-b910-5a62-a7d1-de72532adce1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7n+2}{n-2}" :db/id #edb/ref 17592186245176} :answer-field/id #uuid "ad3980b8-5f47-5336-ad4c-27cc915bacf5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246859}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "66bb3bb0-0115-554d-a6a3-f538c995da20" :question/math-academy-id "q-113291" :question/problem "Given that $\\frac{5n+3}{n-2}=b$ and $\\frac{2n-1}{2-n}=c,$ what is $b-c?$" :question/worked-solution "We wish to subtract the following fractions:\n\n$$\nb-c=\\frac{5n+3}{n-2}-\\frac{2n-1}{2-n}\n$$\n\nIn order to subtract the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $n-2$ if we multiply the top and bottom of the second fraction by $-1:$\n\n$$\n\\begin{aligned}\\frac{5n+3}{n-2}-\\frac{2n-1}{2-n} &= \\frac{5n+3}{n-2}-\\frac{(-1)}{(-1)}\\cdot \\frac{2n-1}{2-n} \\\\ &= \\frac{5n+3}{n-2}-\\frac{-2n+1}{n-2} \\\\ &= \\frac{(5n+3)-(-2n+1)}{n-2} \\\\ &= \\frac{5n+3+2n-1}{n-2} \\\\ &= \\frac{7n+2}{n-2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186247339 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0af04033-a6ba-55b9-a3cf-e88062146da2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3+8v}{3+2v}" :db/id #edb/ref 17592186244413} {:answer/id #uuid "22c65f9d-8809-5b40-a4ac-12894dc5fb71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(2-v)}{2(3+2v)}" :db/id #edb/ref 17592186244619} {:answer/id #uuid "590e2778-3be8-5b98-82cb-b429232a3edf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3-8v}{2(3+2v)}" :db/id #edb/ref 17592186245100} {:answer/id #uuid "68f4011e-d001-588c-8473-c4e6ecca6ef6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5-8v}{2(3+2v)}" :db/id #edb/ref 17592186245240} {:answer/id #uuid "74a2e865-4b12-53b0-9d9d-023142d8fc7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(3+v)}{3+2v}" :db/id #edb/ref 17592186245352}] :answer-field/correct {:answer/id #uuid "22c65f9d-8809-5b40-a4ac-12894dc5fb71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(2-v)}{2(3+2v)}" :db/id #edb/ref 17592186244619} :answer-field/id #uuid "4f65e550-213e-5735-8350-553dfc51c9ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246685}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "77efbc7d-72cb-5364-b916-b8865a568a34" :question/math-academy-id "q-113296" :question/problem "Given that $\\frac{7v}{2(3+2v)}=t$ and $\\frac{3-5v}{3+2v}=r,$ what is $t+r?$" :question/worked-solution "We wish to add the following fractions:\n\n$$\nt+r=\\frac{7v}{2(3+2v)}+\\frac{3-5v}{3+2v}\n$$\n\nIn order to add the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $2(3+2v)$ if we multiply the top and bottom of the second fraction by $2:$\n\n$$\n\\begin{aligned}\\frac{7v}{2(3+2v)}+\\frac{3-5v}{3+2v} &= \\frac{7v}{2(3+2v)}+\\frac{2}{2}\\cdot \\frac{3-5v}{3+2v} \\\\ &= \\frac{7v}{2(3+2v)}+\\frac{2(3-5v)}{2(3+2v)} \\\\ &= \\frac{7v+2(3-5v)}{2(3+2v)} \\\\ &= \\frac{7v+6-10v}{2(3+2v)} \\\\ &= \\frac{6-3v}{2(3+2v)} \\\\ &= \\frac{3(2-v)}{2(3+2v)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186247340 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b8b770-6c21-56e3-b336-b5d95a1f29e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2g}{2-h}" :db/id #edb/ref 17592186244324} {:answer/id #uuid "025ab6a7-c175-5bda-a5ae-71435f2b411c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5g-3}{2-h}" :db/id #edb/ref 17592186244327} {:answer/id #uuid "31851e6a-ae53-558a-abeb-21c73e270e9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{g-8}{g(2-h)}" :db/id #edb/ref 17592186244756} {:answer/id #uuid "6ca976fc-984c-5548-a93e-3086a908c594" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5g-3}{g(2-h)}" :db/id #edb/ref 17592186245274} {:answer/id #uuid "baae5de1-50ed-564b-82ed-9a3209161644" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2g}{g(2-h)}" :db/id #edb/ref 17592186245981}] :answer-field/correct {:answer/id #uuid "6ca976fc-984c-5548-a93e-3086a908c594" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5g-3}{g(2-h)}" :db/id #edb/ref 17592186245274} :answer-field/id #uuid "a59a56f0-3a08-5ffd-bb0c-f4cdd17dbade" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246841}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d446f78d-7f19-5904-b8b0-ee54e70de00c" :question/math-academy-id "q-113303" :question/problem "Simplify $\\frac{5}{2-h}-\\frac{3}{g(2-h)}.$" :question/worked-solution "In order to subtract the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $g(2-h)$ if we multiply the top and bottom of the first fraction by $g:$\n\n$$\n\\begin{aligned}\\frac{5}{2-h}-\\frac{3}{g(2-h)} &= \\frac{g}{g}\\cdot \\frac{5}{2-h}-\\frac{3}{g(2-h)} \\\\ &= \\frac{5g}{g(2-h)}-\\frac{3}{g(2-h)} \\\\ &= \\frac{5g-3}{g(2-h)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186247341 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0667b27b-fcd1-5eea-8483-9e730f2685c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5-c}{c(5d+1)}" :db/id #edb/ref 17592186244364} {:answer/id #uuid "84786e7b-65de-5ac1-abf6-651be983eb47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5d+1}" :db/id #edb/ref 17592186245482} {:answer/id #uuid "8e8a4657-da1c-50de-8358-078a7ae39279" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3-c}{5d+1}" :db/id #edb/ref 17592186245558} {:answer/id #uuid "c992b10b-e9db-5c26-b469-65a453b7ce0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(3-5c)}{c(5d+1)}" :db/id #edb/ref 17592186246099} {:answer/id #uuid "e01f7323-13ba-5de0-a173-42fb5242397d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3-5c}{c(5d+1)}" :db/id #edb/ref 17592186246305}] :answer-field/correct {:answer/id #uuid "e01f7323-13ba-5de0-a173-42fb5242397d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3-5c}{c(5d+1)}" :db/id #edb/ref 17592186246305} :answer-field/id #uuid "45325eaa-3962-5b22-9066-af3f7d9b490f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246661}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ee962794-bfd5-55de-8444-a687faba72af" :question/math-academy-id "q-113315" :question/problem "Simplify $\\frac{3}{c(5d+1)}-\\frac{5}{5d+1}.$" :question/worked-solution "In order to subtract the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $c(5d+1)$ if we multiply the top and bottom of the second fraction by $c:$\n\n$$\n\\begin{aligned}\\frac{3}{c(5d+1)}-\\frac{5}{5d+1} &= \\frac{3}{c(5d+1)}-\\frac{c}{c}\\cdot \\frac{5}{5d+1} \\\\ &= \\frac{3}{c(5d+1)}-\\frac{5c}{c(5d+1)} \\\\ &= \\frac{3-5c}{c(5d+1)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250117 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3138c09d-4d43-51c5-bead-0fdb778e1372" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5k}{2h}" :db/id #edb/ref 17592186247870} {:answer/id #uuid "31b53764-ce11-5727-886a-8d35ebdf717e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{kh}{2}" :db/id #edb/ref 17592186247876} {:answer/id #uuid "4536e350-3f2a-5750-abb4-9f26a11d9ba9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2hk}" :db/id #edb/ref 17592186248045} {:answer/id #uuid "a62285a7-f22e-5063-a1e7-ac6ebe678521" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{k}{5h}" :db/id #edb/ref 17592186248905} {:answer/id #uuid "eee7c8c3-97c8-59fa-9ad6-63ca4f761b48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{k}{2h}" :db/id #edb/ref 17592186249521}] :answer-field/correct {:answer/id #uuid "eee7c8c3-97c8-59fa-9ad6-63ca4f761b48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{k}{2h}" :db/id #edb/ref 17592186249521} :answer-field/id #uuid "1a8d3447-4499-5d0e-ad45-b2bcd7eff6ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249715}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d696dd66-1554-57e6-9d74-9c8f4a560ef5" :question/math-academy-id "q-113818" :question/problem "$\\frac{5}{h}÷\\frac{10}{k}=$" :question/worked-solution "To compute\n\n$$\n\\frac{5}{h}÷\\frac{10}{k},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{5}{h}÷\\frac{10}{k} &= \\frac{5}{h}\\cdot \\frac{k}{10} \\\\ &= \\frac{5k}{10h} \\\\ &= \\frac{\\cancel{5}\\cdot k}{\\cancel{5}\\cdot 2h} \\\\ &= \\frac{k}{2h}\\end{aligned}\n$$\n\nNote that in the final step, we canceled out a common factor of $5$ in the numerator and denominator."} {:db/id #edb/ref 17592186250118 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ef75184-0029-5205-b994-78244900daac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{z}^{2}}{7}" :db/id #edb/ref 17592186247563} {:answer/id #uuid "1f218037-4fee-52d7-b793-13dca3175000" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7{z}^{2}}{3{y}^{2}}" :db/id #edb/ref 17592186247700} {:answer/id #uuid "717672a9-8c72-51a4-9aee-9e854cca3b19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21{z}^{2}}{{y}^{2}}" :db/id #edb/ref 17592186248415} {:answer/id #uuid "794f8014-9605-5d3d-8e80-3e1c4023f31e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{z}^{2}}{7{y}^{2}}" :db/id #edb/ref 17592186248489} {:answer/id #uuid "c910ee71-9ff7-56c4-8792-8d6c4baaddb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{7{y}^{2}}" :db/id #edb/ref 17592186249213}] :answer-field/correct {:answer/id #uuid "794f8014-9605-5d3d-8e80-3e1c4023f31e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{z}^{2}}{7{y}^{2}}" :db/id #edb/ref 17592186248489} :answer-field/id #uuid "a2eafa97-a244-577b-815e-cbf679554d37" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249957}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "73d1b02b-baff-5504-b510-6aee5b6536db" :question/math-academy-id "q-113821" :question/problem "What is $\\frac{{x}^{2}}{2{y}^{2}z}÷\\frac{7{x}^{2}}{6{z}^{3}}?$" :question/worked-solution "To compute\n\n$$\n\\frac{{x}^{2}}{2{y}^{2}z}÷\\frac{7{x}^{2}}{6{z}^{3}},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{2{y}^{2}z}÷\\frac{7{x}^{2}}{6{z}^{3}} &= \\frac{{x}^{2}}{2{y}^{2}z}\\cdot \\frac{6{z}^{3}}{7{x}^{2}} \\\\ &= \\frac{{x}^{2}}{{y}^{2}\\cdot 2z}\\cdot \\frac{3\\cdot 2z\\cdot {z}^{2}}{7\\cdot {x}^{2}} \\\\ &= \\frac{\\cancel{{x}^{2}}}{{y}^{2}\\cdot \\cancel{2z}}\\cdot \\frac{3\\cdot \\cancel{2z}\\cdot {z}^{2}}{7\\cdot \\cancel{{x}^{2}}} \\\\ &= \\frac{3{z}^{2}}{7{y}^{2}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250119 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "050110f2-d593-53b9-9aa1-59b07475f042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{h}^{2}}{g}" :db/id #edb/ref 17592186247461} {:answer/id #uuid "0c837872-f037-5fe1-a395-692c9866cb4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{g{h}^{2}}{3}" :db/id #edb/ref 17592186247537} {:answer/id #uuid "88f2887e-4ad7-5f6d-a826-f3a3efb80d5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{g}{3{h}^{2}}" :db/id #edb/ref 17592186248643} {:answer/id #uuid "da5ed084-1bcb-545b-ba93-1e58fbcf59a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3g}{{h}^{2}}" :db/id #edb/ref 17592186249354} {:answer/id #uuid "e6b97d80-768b-5e51-9142-4785a3bd93a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{g}^{2}}{3h}" :db/id #edb/ref 17592186249457}] :answer-field/correct {:answer/id #uuid "88f2887e-4ad7-5f6d-a826-f3a3efb80d5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{g}{3{h}^{2}}" :db/id #edb/ref 17592186248643} :answer-field/id #uuid "cc59e529-9826-5d81-9516-8ebd91b4adb7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250022}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ba32a502-c504-5632-a2b1-6335fbd8b6b5" :question/math-academy-id "q-113824" :question/problem "Given that $\\frac{4{g}^{2}}{7{h}^{3}}=a$ and $\\frac{12g}{7h}=b,$ what is $a÷b?$" :question/worked-solution "To compute\n\n$$\na÷b=\\frac{4{g}^{2}}{7{h}^{3}}÷\\frac{12g}{7h},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{4{g}^{2}}{7{h}^{3}}÷\\frac{12g}{7h} &= \\frac{4{g}^{2}}{7{h}^{3}}\\cdot \\frac{7h}{12g} \\\\ &= \\frac{4g\\cdot g}{7h\\cdot {h}^{2}}\\cdot \\frac{7h}{3\\cdot 4g} \\\\ &= \\frac{\\cancel{4g}\\cdot g}{\\cancel{7h}\\cdot {h}^{2}}\\cdot \\frac{\\cancel{7h}}{3\\cdot \\cancel{4g}} \\\\ &= \\frac{g}{3{h}^{2}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250120 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97c1c6ab-73c5-56f5-9fee-ca0a10e54db6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(z-2)}{z+1}" :db/id #edb/ref 17592186248776} {:answer/id #uuid "a9625933-0685-5510-8621-3032717dd0ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18(z-2)}{z+1}" :db/id #edb/ref 17592186248929} {:answer/id #uuid "b3efc6b8-c94f-51b9-8dc1-1921a321212b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18}{z+1}" :db/id #edb/ref 17592186249034} {:answer/id #uuid "badd22b5-a641-5ad8-8db4-43458737b054" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18(z+1)}{z-2}" :db/id #edb/ref 17592186249093} {:answer/id #uuid "ef35f532-0726-5061-9704-c32df9534b0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{z+1}" :db/id #edb/ref 17592186249524}] :answer-field/correct {:answer/id #uuid "b3efc6b8-c94f-51b9-8dc1-1921a321212b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18}{z+1}" :db/id #edb/ref 17592186249034} :answer-field/id #uuid "96e98c2b-f5b8-5971-a5f1-a27e14529d08" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249939}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fd3f875b-33f7-55de-93e3-693ddb1d2606" :question/math-academy-id "q-113826" :question/problem "Given that $\\frac{3(z-2)}{(z+1)^{2}}=a$ and $\\frac{z-2}{6(z+1)}=b,$ what is $a÷b?$" :question/worked-solution "To compute\n\n$$\na÷b=\\frac{3(z-2)}{(z+1)^{2}}÷\\frac{z-2}{6(z+1)},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{3(z-2)}{(z+1)^{2}}÷\\frac{z-2}{6(z+1)} &= \\frac{3(z-2)}{(z+1)^{2}}\\cdot \\frac{6(z+1)}{z-2} \\\\ &= \\frac{3\\cancel{(z-2)}}{(z+1)^{\\cancel{2}}}\\cdot \\frac{6\\cancel{(z+1)}}{\\cancel{(z-2)}} \\\\ &= \\frac{3}{z+1}\\cdot 6 \\\\ &= \\frac{18}{z+1}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250273 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01fdb005-8179-54c2-a098-7a92883a30b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{tan}⁡(3x+2)+C" :db/id #edb/ref 17592186247436} {:answer/id #uuid "339edf8e-b1b5-5c42-85d5-0ea922cac214" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{cot}⁡(3x+2)+C" :db/id #edb/ref 17592186247890} {:answer/id #uuid "628f63d4-ac2f-5bae-a486-68847a2a7cf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}{cot}^{2}⁡(3x+2)+C" :db/id #edb/ref 17592186248314} {:answer/id #uuid "a3803a20-435b-5eef-bd00-4200e4e0c33d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{tan}^{2}⁡(3x+2)+C" :db/id #edb/ref 17592186248886} {:answer/id #uuid "c27eb4c6-5c1c-5c79-82eb-47c0d4c1cb3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{tan}⁡(3x+2)+C" :db/id #edb/ref 17592186249153}] :answer-field/correct {:answer/id #uuid "01fdb005-8179-54c2-a098-7a92883a30b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{tan}⁡(3x+2)+C" :db/id #edb/ref 17592186247436} :answer-field/id #uuid "b025cb0b-872f-5b78-9d55-94c0d0e6743d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249980}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "35e08417-e875-5f7f-a591-7aa6eac3199b" :question/math-academy-id "q-114467" :question/problem "$\\int \\frac{1}{{cos}^{4}⁡(3x+2)+{cos}^{2}⁡(3x+2){sin}^{2}⁡(3x+2)}\\,\\text{d}x=$" :question/worked-solution "From the identity ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ with $\\theta =3x+2,$ we get \n\n$$\n\\begin{aligned}{cos}^{2}⁡(3x+2)+{sin}^{2}⁡(3x+2)=1.\\end{aligned}\n$$\n\nSubstituting the above into our integral gives\n\n$$\n\\begin{aligned}\\int \\frac{1}{{cos}^{4}⁡(3x+2)+{cos}^{2}⁡(3x+2){sin}^{2}⁡(3x+2)}\\,\\text{d}x &= \\int \\frac{1}{{cos}^{2}⁡(3x+2)({cos}^{2}⁡(3x+2)+{sin}^{2}⁡(3x+2))}\\,\\text{d}x \\\\ &= \\int \\frac{1}{{cos}^{2}⁡(3x+2)}\\,\\text{d}x \\\\ &= \\int {sec}^{2}⁡(3x+2)\\,\\text{d}x \\\\ &= \\frac{1}{3}\\operatorname{tan}⁡(3x+2)+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250274 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "429c4e06-3048-55b1-b208-72019f1b0474" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{tan}⁡(2x+\\frac{\\pi }{5})+C" :db/id #edb/ref 17592186248017} {:answer/id #uuid "7e54eb59-7b2b-5295-a85f-69bab12eefd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡(2x+\\frac{\\pi }{5})+C" :db/id #edb/ref 17592186248535} {:answer/id #uuid "8021e056-c15c-5db2-b077-c41b6d899f49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sec}⁡(2x+\\frac{\\pi }{5})+C" :db/id #edb/ref 17592186248549} {:answer/id #uuid "848e9fc1-831c-51f0-9f79-1b100b19ee3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{sin}⁡(2x+\\frac{\\pi }{5})+C" :db/id #edb/ref 17592186248600} {:answer/id #uuid "b94c2031-9662-5675-9f0a-6203b77aab15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡(2x+\\frac{\\pi }{5})+C" :db/id #edb/ref 17592186249079}] :answer-field/correct {:answer/id #uuid "7e54eb59-7b2b-5295-a85f-69bab12eefd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡(2x+\\frac{\\pi }{5})+C" :db/id #edb/ref 17592186248535} :answer-field/id #uuid "e0cd4974-971c-56d8-b46a-a70cd95372ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250057}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a520c33d-1aa5-5864-8fa9-daf66894b11e" :question/math-academy-id "q-114469" :question/problem "Calculate $\\int \\frac{1}{{tan}^{2}⁡(2x+\\frac{\\pi }{5})\\operatorname{cos}⁡(2x+\\frac{\\pi }{5})+\\operatorname{cos}⁡(2x+\\frac{\\pi }{5})}\\,\\text{d}x.$" :question/worked-solution "From the identity $1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta ,$ with $\\theta =2x+\\frac{\\pi }{5},$ we get \n\n$$\n\\begin{aligned}1+{tan}^{2}⁡(2x+\\frac{\\pi }{5})={sec}^{2}⁡(2x+\\frac{\\pi }{5}).\\end{aligned}\n$$\n\nSubstituting the above into our integral gives\n\n$$\n\\begin{aligned}\\int \\frac{1}{{tan}^{2}⁡(2x+\\frac{\\pi }{5})\\operatorname{cos}⁡(2x+\\frac{\\pi }{5})+\\operatorname{cos}⁡(2x+\\frac{\\pi }{5})}\\,\\text{d}x &= \\int \\frac{1}{[{tan}^{2}⁡(2x+\\frac{\\pi }{5})+1]\\operatorname{cos}⁡(2x+\\frac{\\pi }{5})}\\,\\text{d}x \\\\ &= \\int \\frac{1}{{sec}^{2}⁡(2x+\\frac{\\pi }{5})\\operatorname{cos}⁡(2x+\\frac{\\pi }{5})}\\,\\text{d}x \\\\ &= \\int \\frac{{cos}^{2}⁡(2x+\\frac{\\pi }{5})}{\\operatorname{cos}⁡(2x+\\frac{\\pi }{5})}\\,\\text{d}x \\\\ &= \\int \\operatorname{cos}⁡(2x+\\frac{\\pi }{5})\\text{d}x \\\\ &= \\frac{1}{2}\\operatorname{sin}⁡(2x+\\frac{\\pi }{5})+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250277 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "294ec01d-16ec-5129-a5ad-20b579ee06d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\operatorname{cos}⁡(5x-2)+C" :db/id #edb/ref 17592186247791} {:answer/id #uuid "3d365e84-3849-54a8-821f-4d24a73fbc3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{sec}⁡(5x-2)+C" :db/id #edb/ref 17592186247964} {:answer/id #uuid "7f136ce4-b6e2-5f01-bd33-5da390a739d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5}\\operatorname{sin}⁡(5x-2)+C" :db/id #edb/ref 17592186248541} {:answer/id #uuid "aec045a7-c97c-5a7e-8592-b75ce23f306a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5}\\operatorname{cos}⁡(5x-2)+C" :db/id #edb/ref 17592186248987} {:answer/id #uuid "e868382a-54c8-5c28-8250-a33c21643162" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5\\operatorname{sec}⁡(5x-2)+C" :db/id #edb/ref 17592186249475}] :answer-field/correct {:answer/id #uuid "aec045a7-c97c-5a7e-8592-b75ce23f306a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5}\\operatorname{cos}⁡(5x-2)+C" :db/id #edb/ref 17592186248987} :answer-field/id #uuid "7e84622e-de5e-5b8b-968b-5b509078c80e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249891}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8ce9a833-7138-5c70-a343-cfc3b184c5d8" :question/math-academy-id "q-114510" :question/problem "Determine $\\int \\frac{1}{{cot}^{2}⁡(5x-2)\\operatorname{sin}⁡(5x-2)+\\operatorname{sin}⁡(5x-2)}\\,\\text{d}x.$" :question/worked-solution "From the identity $1+{cot}^{2}⁡\\theta ={csc}^{2}⁡\\theta ,$ with $\\theta =5x-2,$ we get \n\n$$\n\\begin{aligned}1+{cot}^{2}⁡(5x-2)={csc}^{2}⁡(5x-2).\\end{aligned}\n$$\n\nSubstituting the above into our integral gives\n\n$$\n\\begin{aligned}\\int \\frac{1}{{cot}^{2}⁡(5x-2)\\operatorname{sin}⁡(5x-2)+\\operatorname{sin}⁡(5x-2)}\\,\\text{d}x &= \\int \\frac{1}{[{cot}^{2}⁡(5x-2)+1]\\operatorname{sin}⁡(5x-2)}\\,\\text{d}x \\\\ &= \\int \\frac{1}{{csc}^{2}⁡(5x-2)\\operatorname{sin}⁡(5x-2)}\\,\\text{d}x \\\\ &= \\int \\frac{{sin}^{2}⁡(5x-2)}{\\operatorname{sin}⁡(5x-2)}\\,\\text{d}x \\\\ &= \\int \\operatorname{sin}⁡(5x-2)\\text{d}x \\\\ &= -\\frac{1}{5}\\operatorname{cos}⁡(5x-2)+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262835 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fe78bf8-7ac3-5189-bff3-2c01abd83f80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-5,0,0⟩" :db/id #edb/ref 17592186260556} {:answer/id #uuid "55d1fef6-f7ac-57bb-b250-1ef2f14cdf76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,-5,0⟩" :db/id #edb/ref 17592186260608} {:answer/id #uuid "569921ed-c576-5fb7-89fc-7dc8845f8c9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,5,0⟩" :db/id #edb/ref 17592186260615} {:answer/id #uuid "6e32f91d-e1b8-5637-bf32-c747b24cff0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-5,0,10⟩" :db/id #edb/ref 17592186260844} {:answer/id #uuid "d4da54f4-6265-5fdb-8cdc-b74a0d4db467" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,5,10⟩" :db/id #edb/ref 17592186261751}] :answer-field/correct {:answer/id #uuid "55d1fef6-f7ac-57bb-b250-1ef2f14cdf76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,-5,0⟩" :db/id #edb/ref 17592186260608} :answer-field/id #uuid "f2a037ed-685c-5ce7-8e35-ec4164485d85" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262546}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "afcc8d33-fe9b-5c65-a7f2-97b6d0a1032f" :question/math-academy-id "q-127861" :question/problem "Find $(3b-c)\\times (9a-2b)$, if $a\\times b=⟨0,0,1⟩$, $a\\times c=⟨0,-1,3⟩$ and $c\\times b=⟨0,2,0⟩.$" :question/worked-solution "First, recall that:\n\n- The cross product distributes over addition/subtraction:\n\n$$\n\\begin{aligned}(a\\pm b)\\times c & =a\\times c\\pm b\\times c \\\\ c\\times (a\\pm b) & =c\\times a\\pm c\\times b\\end{aligned}\n$$\n\n- The cross product is associative with respect to scalar multiplication:\n\n$$\n\\begin{aligned}(\\lambda a)\\times b & =\\lambda (a\\times b) \\\\ a\\times (\\lambda b) & =\\lambda (a\\times b)\\end{aligned}\n$$\n\n- The cross product of parallel vectors equals the zero vector. In particular,\n\n$$\na\\times a=0.\n$$\n\n- The cross product is anticommutative:\n\n$$\n\\begin{aligned}a\\times b & =-b\\times a\\end{aligned}\n$$\n\nWith that in mind, let's evaluate our expression:\n\n- First, we use the distributive property:\n\n$$\n\\begin{aligned}(3b-c)\\times (9a-2b) &= ((3b)\\times (9a))-((3b)\\times (2b))-(c\\times (9a))+(c\\times (2b))\\end{aligned}\n$$\n\n- Next, we factor out the scalars:\n\n$$\n\\begin{aligned}(3b-c)\\times (9a-2b) &= ((3b)\\times (9a))-((3b)\\times (2b))-(c\\times (9a))+(c\\times (2b)) \\\\ &= (3\\cdot 9)(b\\times a)-(3\\cdot 2)(b\\times b)-9(c\\times a)+2(c\\times b) \\\\ &= 27(b\\times a)-6(b\\times b)-9(c\\times a)+2(c\\times b)\\end{aligned}\n$$\n\n- Then, we use anticommutativity, and the fact that $b\\times b=0:$\n\n$$\n\\begin{aligned}27(b\\times a)-6(b\\times b)-9(c\\times a)+2(c\\times b) &= -27(a\\times b)-6(0)+9(a\\times c)+2(c\\times b) \\\\ &= -27(a\\times b)+9(a\\times c)+2(c\\times b)\\end{aligned}\n$$\n\n- Finally, we substitute the given values and simplify:\n\n$$\n\\begin{aligned}-27(a\\times b)+9(a\\times c)+2(c\\times b) &= -27⟨0,0,1⟩+9⟨0,-1,3⟩+2⟨0,2,0⟩ \\\\ &= ⟨0,0,-27⟩+⟨0,-9,27⟩+⟨0,4,0⟩ \\\\ &= ⟨0,-5,0⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186275147 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06368d8d-e8cc-5093-b179-f46913edb67d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{g}" :db/id #edb/ref 17592186272444} {:answer/id #uuid "140af3f2-c890-5051-8864-91381615cd30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2g}" :db/id #edb/ref 17592186272567} {:answer/id #uuid "1c419ad3-8f0e-57be-8748-249953a12c6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8g}{3}" :db/id #edb/ref 17592186272633} {:answer/id #uuid "7d59d9bf-e572-570b-8b5b-7f29aac90361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{g}^{2}}{3}" :db/id #edb/ref 17592186273460} {:answer/id #uuid "f4005a97-9254-5f58-a0f5-c75a5bbbac16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4g}{15}" :db/id #edb/ref 17592186274542}] :answer-field/correct {:answer/id #uuid "1c419ad3-8f0e-57be-8748-249953a12c6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8g}{3}" :db/id #edb/ref 17592186272633} :answer-field/id #uuid "611519a7-0326-5a3d-b26e-01b722addb01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274803}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f7b45625-1cac-5462-8fbc-e99fa13fa49c" :question/math-academy-id "q-14432" :question/problem "$\\frac{4}{5g}÷\\frac{3}{10{g}^{2}}=$" :question/worked-solution "To compute\n\n$$\n\\frac{4}{5g}÷\\frac{3}{10{g}^{2}},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{4}{5g}÷\\frac{3}{10{g}^{2}} &= \\frac{4}{5g}\\cdot \\frac{10{g}^{2}}{3} \\\\ &= \\frac{4}{\\cancel{5}\\cdot \\cancel{g}}\\cdot \\frac{\\cancel{5}\\cdot 2\\cdot {g}^{\\cancel{2}}}{3} \\\\ &= 4\\cdot \\frac{2g}{3} \\\\ &= \\frac{8g}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186284698 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08d38bc3-2276-52bd-9c20-5924ec72b981" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}+4{x}^{2}-12" :db/id #edb/ref 17592186281766} {:answer/id #uuid "297424e6-e2d2-51b0-805b-782c53e1b021" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-2{x}^{2}+3x-18" :db/id #edb/ref 17592186282050} {:answer/id #uuid "2b87dc02-ab30-57a5-a3d6-20164e71169d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-5{x}^{2}+16" :db/id #edb/ref 17592186282072} {:answer/id #uuid "5a92f44d-c1e7-5114-b85f-b50709bf7a26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-4{x}^{2}+9x-36" :db/id #edb/ref 17592186282455} {:answer/id #uuid "7a409101-5072-5f2d-bed1-54facfec8be7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-8{x}^{2}+10x-14" :db/id #edb/ref 17592186282736}] :answer-field/correct {:answer/id #uuid "5a92f44d-c1e7-5114-b85f-b50709bf7a26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-4{x}^{2}+9x-36" :db/id #edb/ref 17592186282455} :answer-field/id #uuid "ec3feba0-e3b4-5936-abc8-fbdc476d9467" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284352}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "16b9faf7-c029-5ea4-8fce-56b4f1ca45df" :question/math-academy-id "q-17407" :question/problem "![](images/b7/b771ac7e3d7e724b1eae9ebfc592d36a903a1fc46cc2aac5a55ea9517dc2ce12.png)\n\nThe Argand diagram above shows the roots of a cubic polynomial $f(x).$\nFind $f(x)$ given that the coefficient of the cubic term is $1.$" :question/worked-solution "From the diagram, we see that $f(x)$ has roots ${x}_{1}=4$ and ${x}_{2,3}=\\pm 3\\text{i}.$ Additionally, we're given that the coefficient of the cubic term is $a=1.$ Therefore, we can write the polynomial as follows:\n\n$$\n\\begin{aligned}f(x) & =a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) \\\\  & =1(x-4)(x-3\\text{i})(x-(-3\\text{i})) \\\\  & =(x-4)(x-3\\text{i})(x+3\\text{i})\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}(x-4)(x-3\\text{i})(x+3\\text{i}) &= (x-4)({x}^{2}-x(-3\\text{i})-x(3\\text{i})+(3\\text{i})(-3\\text{i})) \\\\ &= (x-4)({x}^{2}+9) \\\\ &= {x}^{3}+9x-4{x}^{2}-36 \\\\ &= {x}^{3}-4{x}^{2}+9x-36.\\end{aligned}\n$$\n\nTherefore, $f(x)={x}^{3}-4{x}^{2}+9x-36.$"} {:db/id #edb/ref 17592186284699 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e5c10ae-8211-5dc9-9fbd-b908492c5ab6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-2{x}^{2}+3x-18" :db/id #edb/ref 17592186282636} {:answer/id #uuid "ae64746e-e12c-523e-9379-1e3ec53c2f26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-7{x}^{2}+25x-39" :db/id #edb/ref 17592186283195} {:answer/id #uuid "d6d1e0f8-8a3a-51bd-8e55-0d965aac0e13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-7{x}^{2}-36" :db/id #edb/ref 17592186283559} {:answer/id #uuid "f6ed72c6-dd7e-530f-9284-166441519a1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-9{x}^{2}+24x-14" :db/id #edb/ref 17592186283846} {:answer/id #uuid "fbee277f-b194-5f64-969e-16339611d399" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}+4{x}^{2}-13" :db/id #edb/ref 17592186283896}] :answer-field/correct {:answer/id #uuid "ae64746e-e12c-523e-9379-1e3ec53c2f26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-7{x}^{2}+25x-39" :db/id #edb/ref 17592186283195} :answer-field/id #uuid "f44c7a5f-2605-5fcc-aec1-f95581fc428e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284369}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2351145f-98b4-53bf-9596-f4822bb0e33b" :question/math-academy-id "q-17408" :question/problem "![](images/75/75fab7d9a7b9aabdd19a769384c548b033a3d8d30879bf647d6e8852c7b3ba9a.png)\n\nThe Argand diagram above shows the roots of the cubic polynomial $f(x).$ Find $f(x)$ given that the coefficient of the cubic term is $1.$" :question/worked-solution "From the diagram, we see that $f(x)$ has roots ${x}_{1}=3$ and ${x}_{2,3}=2\\pm 3\\text{i}.$ Additionally, we're given that the coefficient of the cubic term is $a=1.$ Therefore, we can write the polynomial as follows:\n\n$$\n\\begin{aligned}f(x) & =a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) \\\\  & =1(x-3)(x-(2+3\\text{i}))(x-(2-3\\text{i})) \\\\  & =(x-3)(x-(2+3\\text{i}))(x-(2-3\\text{i}))\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}(x-3)(x-(2+3\\text{i}))(x-(2-3\\text{i})) &= (x-3)({x}^{2}-x(2-3\\text{i})-x(2+3\\text{i})+(2+3\\text{i})(2-3\\text{i})) \\\\ &= (x-3)({x}^{2}-4x+13) \\\\ &= {x}^{3}-4{x}^{2}+13x-3{x}^{2}+12x-39 \\\\ &= {x}^{3}-7{x}^{2}+25x-39.\\end{aligned}\n$$\n\nTherefore, $f(x)={x}^{3}-7{x}^{2}+25x-39.$"} {:db/id #edb/ref 17592186287956 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "323eaa4e-f2e9-5113-9450-8c44caaf1e3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6j-3k" :db/id #edb/ref 17592186285244} {:answer/id #uuid "55ac46af-a9d8-59f5-bfee-da66cc48c308" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6i-2j" :db/id #edb/ref 17592186285573} {:answer/id #uuid "55b1d06c-1ce0-5af3-b7dd-4c5d790fa7c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9j+6k" :db/id #edb/ref 17592186285576} {:answer/id #uuid "bd7c0cca-930c-5c89-8791-719ae27eff54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9j+2k" :db/id #edb/ref 17592186286521} {:answer/id #uuid "d8e96620-e26e-5aaa-9833-b2c37c9a5d6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9j-6k" :db/id #edb/ref 17592186286764}] :answer-field/correct {:answer/id #uuid "d8e96620-e26e-5aaa-9833-b2c37c9a5d6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9j-6k" :db/id #edb/ref 17592186286764} :answer-field/id #uuid "61f72f43-311c-58f9-af25-6e9606eadcd0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287355}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c3e9b2b8-80c6-5b5f-a8f3-154d30b790dd" :question/math-academy-id "q-19777" :question/problem "Find $(2a+3c)\\times (b+2c)$, if $a\\times b=3i-2j+k$, $a\\times c=j-2k$ and $b\\times c=2i-3j.$" :question/worked-solution "First, recall that:\n\n- The cross product distributes over addition/subtraction:\n\n$$\n\\begin{aligned}(a\\pm b)\\times c & =a\\times c\\pm b\\times c \\\\ c\\times (a\\pm b) & =c\\times a\\pm c\\times b\\end{aligned}\n$$\n\n- The cross product is associative with respect to scalar multiplication:\n\n$$\n\\begin{aligned}(\\lambda a)\\times b & =\\lambda (a\\times b) \\\\ a\\times (\\lambda b) & =\\lambda (a\\times b)\\end{aligned}\n$$\n\n- The cross product of parallel vectors equals the zero vector. In particular,\n\n$$\na\\times a=0.\n$$\n\n- The cross product is anticommutative:\n\n$$\n\\begin{aligned}a\\times b & =-b\\times a\\end{aligned}\n$$\n\nWith that in mind, let's evaluate our expression:\n\n- First, we use the distributive property:\n\n$$\n\\begin{aligned}(2a+3c)\\times (b+2c) &= ((2a)\\times b)+((2a)\\times (2c))+((3c)\\times b)+((3c)\\times (2c))\\end{aligned}\n$$\n\n- Next, we factor out the scalars:\n\n$$\n\\begin{aligned}((2a)\\times b)+((2a)\\times (2c))+((3c)\\times b)+((3c)\\times (2c)) &= 2(a\\times b)+(2\\cdot 2)(a\\times c)+3(c\\times b)+(3\\cdot 2)(c\\times c) \\\\ &= 2(a\\times b)+4(a\\times c)+3(c\\times b)+6(c\\times c)\\end{aligned}\n$$\n\n- Then, we use anticommutativity, and the fact that $c\\times c=0:$\n\n$$\n\\begin{aligned}2(a\\times b)+4(a\\times c)+3(c\\times b)+6(c\\times c) &= 2(a\\times b)+4(a\\times c)-3(b\\times c)+6(0) \\\\ &= 2(a\\times b)+4(a\\times c)-3(b\\times c)\\end{aligned}\n$$\n\n- Finally, we substitute the given values and simplify:\n\n$$\n\\begin{aligned}2(a\\times b)+4(a\\times c)-3(b\\times c) &= 2(3i-2j+k)+4(j-2k)-3(2i-3j) \\\\ &= (6i-4j+2k)+(4j-8k)-(6i-9j) \\\\ &= (6i-6i)+(-4j+4j+9j)+(2k-8k) \\\\ &= 9j-6k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290394 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f9850102-7e14-5d4c-949f-cb0de894e85e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24(x-7)^{5}(y+2)^{3}" :db/id #edb/ref 17592186289675}] :answer-field/correct {:answer/id #uuid "f9850102-7e14-5d4c-949f-cb0de894e85e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24(x-7)^{5}(y+2)^{3}" :db/id #edb/ref 17592186289675} :answer-field/id #uuid "40340b2a-2837-52af-8052-7abd0e71f539" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289873}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a3921e42-85dc-515d-bb06-08aaaefda961" :question/math-academy-id "q-222132" :question/problem "The least common multiple of the polynomials $3(x-7)(y+2)^{3},\\,8(x-7)^{3}(y+2),$ and $2(x-7)^{5}(y+2)^{2}$ is{{field-1}}." :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of three polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of each variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(3,8,2):$\n\n- Multiples of $3:$ $\\,3,\\,6,\\,9,\\,12,\\,15,\\,18,\\,21,\\,24,\\,27,…$\n\n- Multiples of $8:$ $\\,8,\\,16,\\,24,\\,32,…$\n\n- Multiples of $2:$ $\\,2,\\,4,\\,⋯,\\,22,\\,24,\\,26,…$\n\nSo, $\\text{LCM}(3,8,2)=24.$\n\nTo find the $\\text{LCM}$ of $(x-7)(y+2)^{3},(x-7)^{3}(y+2),$ and $(x-7)^{5}(y+2)^{2},$ we find the largest powers for $(x-y)$ and $(y+2)$ that appear in all these expressions:\n\n- For $(x-7),(x-7)^{3},$ and $(x-7)^{5},$ the largest power is $5.$\n\n- For $(y+2)^{3},(y+2),$ and $(y+2)^{2},$ the largest power is $3.$\n\nNow, we raise $(x-7)$ and $(y+2)$ to the corresponding largest powers. Therefore,\n\n$$\n\\text{LCM}((x-7)(y+2)^{3},(x-7)^{3}(y+2),(x-7)^{5}(y+2)^{2})=(x-7)^{5}\\cdot (y+2)^{3}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\begin{aligned}\\text{LCM}(3(x-7)(y+2)^{3},\\,8(x-7)^{3}(y+2),\\,2(x-7)^{5}(y+2)^{2}) &= 24\\cdot (x-7)^{5}\\cdot (y+2)^{3} \\\\ &= 24(x-7)^{5}(y+2)^{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292810 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a75bf3b4-79f6-5eb9-836e-c58e5790e733" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "65" :db/id #edb/ref 17592186291363}] :answer-field/correct {:answer/id #uuid "a75bf3b4-79f6-5eb9-836e-c58e5790e733" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "65" :db/id #edb/ref 17592186291363} :answer-field/id #uuid "07086316-e1b9-5f0d-be58-cbca0b5bb3ed" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291757} {:answer-field/choices [{:answer/id #uuid "fff7093d-4cea-5fd8-a0fa-dc824f3ed313" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186291725}] :answer-field/correct {:answer/id #uuid "fff7093d-4cea-5fd8-a0fa-dc824f3ed313" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186291725} :answer-field/id #uuid "651486f1-5634-5126-8458-b908813eb231" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292040} {:answer-field/choices [{:answer/id #uuid "cbbec8ed-f963-55aa-aa69-f70b90eca08d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186291503}] :answer-field/correct {:answer/id #uuid "cbbec8ed-f963-55aa-aa69-f70b90eca08d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186291503} :answer-field/id #uuid "66c736dd-6d0a-5dcb-a7cb-03d58b6e3edf" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292047} {:answer-field/choices [{:answer/id #uuid "fe5c616e-4310-5873-bc09-bc2deba42cf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "95" :db/id #edb/ref 17592186291717}] :answer-field/correct {:answer/id #uuid "fe5c616e-4310-5873-bc09-bc2deba42cf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "95" :db/id #edb/ref 17592186291717} :answer-field/id #uuid "8279e0e6-2703-5143-bdae-a2e08dff21ce" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292137}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "400b3f57-390d-5059-9036-21bd69c10c6b" :question/math-academy-id "q-275172" :question/problem "![](images/21/210d2120771bef60b0db703a04a06df395225a0c9a884faf012d55f0ed1f60d6.png)\n\nThe Argand diagram above shows the roots of the cubic polynomial $f(x).$ Find $f(x)$ given that the coefficient of the cubic term is $5.$\n\n$f(x)=$\n{{field-1}}${x}^{3}\\,-$\n{{field-2}}${x}^{2}\\,+$\n{{field-3}}$x\\,-$\n{{field-4}}" :question/worked-solution "From the diagram, we see that $f(x)$ has roots ${x}_{1}=1$ and ${x}_{2,3}=3\\pm 2\\text{i}.$ Additionally, we're given that the coefficient of the cubic term is $a=5.$ Therefore, we can write the polynomial as follows:\n\n$$\n\\begin{aligned}f(x) & =a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) \\\\  & =5(x-1)(x-(3+2\\text{i}))(x-(3-2\\text{i}))\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}5(x-1)(x-(3+2\\text{i}))(x-(3-2\\text{i})) &= 5(x-1)({x}^{2}-x(3-2\\text{i})-x(3+2\\text{i})+(3+2\\text{i})(3-2\\text{i})) \\\\ &= 5(x-1)({x}^{2}-6x+13) \\\\ &= 5({x}^{3}-6{x}^{2}+13x-{x}^{2}+6x-13) \\\\ &= 5{x}^{3}-35{x}^{2}+95x-65.\\end{aligned}\n$$\n\nTherefore, $f(x)=5{x}^{3}-35{x}^{2}+95x-65.$"} {:db/id #edb/ref 17592186292838 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41c4c013-c44d-5c78-8c53-eb8219f9e997" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{4}+6{x}^{3}+18{x}^{2}+54x" :db/id #edb/ref 17592186290906}] :answer-field/correct {:answer/id #uuid "41c4c013-c44d-5c78-8c53-eb8219f9e997" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{4}+6{x}^{3}+18{x}^{2}+54x" :db/id #edb/ref 17592186290906} :answer-field/id #uuid "1c47a644-9100-5092-a145-3f8a10d04801" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291842}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2953dc9b-6a3e-5b21-b491-760fe5bd6075" :question/math-academy-id "q-275317" :question/problem "![](images/43/431ba020bfc39615e1d49a866c6ee7c30cf8cc8f84ebde6866ef0e0cb9c8708b.png)\n\nThe Argand diagram above shows the roots of a quartic polynomial $f(x).$ Determine the **expanded form** of $f(x)$ given that the coefficient of the quartic term is $3.$\n\n$f(x)=$\n{{field-1}}\n$-\\,81$" :question/worked-solution "From the diagram, we see that $f(x)$ has roots ${x}_{1}=-3,$ ${x}_{1}=1,$ and ${x}_{3,4}=\\pm 3\\text{i}.$ Additionally, we're given that the coefficient of the quartic term is $a=3.$ Therefore, we can write the polynomial as follows:\n\n$$\n\\begin{aligned}f(x) & =a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3})(x-{x}_{4}) \\\\  & =3(x-(-3))(x-1)(x-(-3\\text{i}))(x-3\\text{i}) \\\\  & =3(x+3)(x-1)(x+3\\text{i})(x-3\\text{i})\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}3(x+3)(x-1)(x+3\\text{i})(x-3\\text{i}) &= 3({x}^{2}-x+3x-3)({x}^{2}-3\\text{i}x+3\\text{i}x-(3\\text{i})^{2}) \\\\ &= 3({x}^{2}+2x-3)({x}^{2}+9) \\\\ &= 3({x}^{4}+9{x}^{2}+2{x}^{3}+18x-3{x}^{2}-27) \\\\ &= 3({x}^{4}+2{x}^{3}+6{x}^{2}+18x-27) \\\\ &= 3{x}^{4}+6{x}^{3}+18{x}^{2}+54x-81.\\end{aligned}\n$$\n\nTherefore, $f(x)=3{x}^{4}+6{x}^{3}+18{x}^{2}+54x\\,-81.$"} {:db/id #edb/ref 17592186297255 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e5dc4a6-908d-57a6-9094-fa8f22c5e2af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5pq" :db/id #edb/ref 17592186295439} {:answer/id #uuid "516a9b77-9c55-5dd2-9b77-7901f0d4f690" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186295736} {:answer/id #uuid "8e423492-9c63-5e03-829f-49e1595e1b95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{pq}{10}" :db/id #edb/ref 17592186296024} {:answer/id #uuid "9135a69c-cc83-5c07-97e3-28b29327b300" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2p}{5q}" :db/id #edb/ref 17592186296048} {:answer/id #uuid "ae900e15-e3a5-5490-a7b8-9a5b2c0a527a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186296187}] :answer-field/correct {:answer/id #uuid "ae900e15-e3a5-5490-a7b8-9a5b2c0a527a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186296187} :answer-field/id #uuid "0a2d39ab-0403-5cfb-b533-472b08e7b982" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296660}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6857c1e3-b4e6-5a35-bde2-f265ec9c08c1" :question/math-academy-id "q-29953" :question/problem "Given that $\\frac{14{p}^{3}}{3{q}^{3}}=a$ and  $\\frac{7{p}^{3}}{15{q}^{3}}=b,$ what is the value of $a÷b?$" :question/worked-solution "To compute\n\n$$\na÷b=\\frac{14{p}^{3}}{3{q}^{3}}÷\\frac{7{p}^{3}}{15{q}^{3}},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{14{p}^{3}}{3{q}^{3}}÷\\frac{7{p}^{3}}{15{q}^{3}} &= \\frac{14{p}^{3}}{3{q}^{3}}\\cdot \\frac{15{q}^{3}}{7{p}^{3}} \\\\ &= \\frac{2\\cdot 7{p}^{3}}{3{q}^{3}}\\cdot \\frac{5\\cdot 3{q}^{3}}{7{p}^{3}} \\\\ &= \\frac{2\\cdot \\cancel{7{p}^{3}}}{\\cancel{3{q}^{3}}}\\cdot \\frac{5\\cdot \\cancel{3{q}^{3}}}{\\cancel{7{p}^{3}}} \\\\ &= 2\\cdot 5 \\\\ &= 10\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297256 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c4f1d16-78b3-5045-8bb5-5579fec4543a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11(k+2)}{{y}^{2}}" :db/id #edb/ref 17592186295613} {:answer/id #uuid "4d3602d9-f3c5-5344-8c7b-288df52749cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11{y}^{2}}{k+4}" :db/id #edb/ref 17592186295709} {:answer/id #uuid "93b20eed-4388-595a-84d8-977910934218" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{k+4}{{y}^{2}}" :db/id #edb/ref 17592186296058} {:answer/id #uuid "aa7ed919-742c-5a4c-b988-a4265e3f6f06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{44(k+2)}" :db/id #edb/ref 17592186296162} {:answer/id #uuid "e8492be0-a6b9-5d09-afa1-2e0f3bbeb2cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{22(k+2)}{{y}^{2}}" :db/id #edb/ref 17592186296502}] :answer-field/correct {:answer/id #uuid "e8492be0-a6b9-5d09-afa1-2e0f3bbeb2cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{22(k+2)}{{y}^{2}}" :db/id #edb/ref 17592186296502} :answer-field/id #uuid "17d9d487-4676-539c-9b1c-0c3a024bdb73" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296680}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "964f86e1-4f13-55f4-a1ab-8caf3da2db2d" :question/math-academy-id "q-29970" :question/problem "If $\\frac{2(k+2)}{121y}\\cdot Y=\\frac{4(k+2)^{2}}{11{y}^{3}},$ then what is $Y?$" :question/worked-solution "Since $\\frac{2(k+2)}{121y}\\cdot Y=\\frac{4(k+2)^{2}}{11{y}^{3}},$ we have\n\n$$\nY=\\frac{4(k+2)^{2}}{11{y}^{3}}÷\\frac{2(k+2)}{121y}.\n$$\n\nTo compute this quotient, we just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{4(k+2)^{2}}{11{y}^{3}}÷\\frac{2(k+2)}{121y} &= \\frac{4(k+2)^{2}}{11{y}^{3}}\\cdot \\frac{121y}{2(k+2)} \\\\ &= \\frac{2\\cdot 2(k+2)\\cdot (k+2)}{11y\\cdot {y}^{2}}\\cdot \\frac{11\\cdot 11y}{2(k+2)} \\\\ &= \\frac{2\\cdot \\cancel{2(k+2)}\\cdot (k+2)}{\\cancel{11y}\\cdot {y}^{2}}\\cdot \\frac{11\\cdot \\cancel{11y}}{\\cancel{2(k+2)}} \\\\ &= \\frac{2(k+2)}{{y}^{2}}\\cdot 11 \\\\ &= \\frac{22(k+2)}{{y}^{2}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297527 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "abab6ba9-2340-5960-b471-9ff70fdcb7d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186296169}] :answer-field/correct {:answer/id #uuid "abab6ba9-2340-5960-b471-9ff70fdcb7d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186296169} :answer-field/id #uuid "09c0fd7c-0cd9-5a60-b746-3554d790a0f4" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296657} {:answer-field/choices [{:answer/id #uuid "d11c78ac-709d-598f-acea-032ed0f4530e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186296365}] :answer-field/correct {:answer/id #uuid "d11c78ac-709d-598f-acea-032ed0f4530e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186296365} :answer-field/id #uuid "55b0992d-e2df-59c2-b739-46d25466dd82" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296805} {:answer-field/choices [{:answer/id #uuid "5dac74c2-3c04-5a7a-ad84-56065e96e298" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "96" :db/id #edb/ref 17592186295807}] :answer-field/correct {:answer/id #uuid "5dac74c2-3c04-5a7a-ad84-56065e96e298" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "96" :db/id #edb/ref 17592186295807} :answer-field/id #uuid "ab045dc7-942d-5d54-a985-0e40265b5e76" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296995} {:answer-field/choices [{:answer/id #uuid "55e35590-84b8-5272-a722-ba953172d8db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186295763}] :answer-field/correct {:answer/id #uuid "55e35590-84b8-5272-a722-ba953172d8db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186295763} :answer-field/id #uuid "e0f79dd0-5a38-52c4-9a3e-4a4ea539bf0f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186297097}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3731cd34-f150-5722-ad6e-69edbb9e6285" :question/math-academy-id "q-316646" :question/problem "The cubic polynomial $f(x)$ has roots ${x}_{1}=-2,{x}_{2,3}=\\pm 4\\text{i},$ and the coefficient of the cubic term is $3.$ Find $f(x).$\n\n$f(x)=$\n{{field-1}}${x}^{3}\\,+$\n{{field-2}}${x}^{2}\\,+$\n{{field-3}}$x\\,+$\n{{field-4}}" :question/worked-solution "Since $f(x)$ has roots ${x}_{1}=-2$ and ${x}_{2,3}=\\pm 4\\text{i},$ and the coefficient of the cubic term is $a=3,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}f(x) & =a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) \\\\  & =3(x-(-2))(x-4\\text{i})(x-(-4\\text{i})) \\\\  & =3(x+2)(x-4\\text{i})(x+4\\text{i})\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}3(x+2)(x-4\\text{i})(x+4\\text{i}) &= 3(x+2)({x}^{2}-(4\\text{i})^{2}) \\\\ &= 3(x+2)({x}^{2}+16) \\\\ &= 3({x}^{3}+2{x}^{2}+16x+32) \\\\ &= 3{x}^{3}+6{x}^{2}+48x+96.\\end{aligned}\n$$\n\nTherefore, $f(x)=3{x}^{3}+6{x}^{2}+48x+96.$"} {:db/id #edb/ref 17592186297528 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29923c34-a24a-5694-b43d-f2bc9ebd6377" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186295502}] :answer-field/correct {:answer/id #uuid "29923c34-a24a-5694-b43d-f2bc9ebd6377" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186295502} :answer-field/id #uuid "3b9e3361-917f-5870-a3e7-78bdfff16a31" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296748} {:answer-field/choices [{:answer/id #uuid "4a029436-0f54-52a7-b530-a8451eeec18f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186295689}] :answer-field/correct {:answer/id #uuid "4a029436-0f54-52a7-b530-a8451eeec18f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186295689} :answer-field/id #uuid "61dd64b3-c67c-5d25-9d4f-9a6a445c054b" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296835} {:answer-field/choices [{:answer/id #uuid "fffb9244-7287-5424-a423-5f1afcd17e91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186296637}] :answer-field/correct {:answer/id #uuid "fffb9244-7287-5424-a423-5f1afcd17e91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186296637} :answer-field/id #uuid "ab2ca594-7556-57b7-8a25-12c4cef27a1f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296996} {:answer-field/choices [{:answer/id #uuid "588c5212-c939-5826-a13c-464093975046" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186295778}] :answer-field/correct {:answer/id #uuid "588c5212-c939-5826-a13c-464093975046" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186295778} :answer-field/id #uuid "c705f490-0438-5ab2-ad73-0e758ad871e3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186297044}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aec895e8-bc3e-50c1-904e-c5d1b4fa0402" :question/math-academy-id "q-316649" :question/problem "The cubic polynomial $f(x)$ has roots ${x}_{1}=-5,{x}_{2,3}=\\pm 2\\text{i},$ and the coefficient of the cubic term is $5.$ Find $f(x).$\n\n$f(x)=$\n{{field-1}}${x}^{3}\\,+$\n{{field-2}}${x}^{2}\\,+$\n{{field-3}}$x\\,+$\n{{field-4}}" :question/worked-solution "Since $f(x)$ has roots ${x}_{1}=-5$ and ${x}_{2,3}=\\pm 2\\text{i},$ and the coefficient of the cubic term is $a=5,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}f(x) & =a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) \\\\  & =5(x-(-5))(x-2\\text{i})(x-(-2\\text{i})) \\\\  & =5(x+5)(x-2\\text{i})(x+2\\text{i})\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}5(x+5)(x-2\\text{i})(x+2\\text{i}) &= 5(x+5)({x}^{2}-(2\\text{i})^{2}) \\\\ &= 5(x+5)({x}^{2}+4) \\\\ &= 5({x}^{3}+5{x}^{2}+4x+20) \\\\ &= 5{x}^{3}+25{x}^{2}+20x+100.\\end{aligned}\n$$\n\nTherefore, $f(x)=5{x}^{3}+25{x}^{2}+20x+100.$"} {:db/id #edb/ref 17592186297529 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90e4d173-6568-539d-9771-86c4235e3500" :answer/typ