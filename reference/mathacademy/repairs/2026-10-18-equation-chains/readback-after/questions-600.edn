17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\pi }" :db/id #edb/ref 17592186312290} {:answer/id #uuid "2eb87721-e3e6-52a8-a533-1c79843076da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\pi }" :db/id #edb/ref 17592186312344} {:answer/id #uuid "4f98fd94-9114-5563-b0f3-8c799c71c061" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\pi }" :db/id #edb/ref 17592186312620} {:answer/id #uuid "680f9bf6-6f75-556f-b032-d0db1d91f844" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186312790} {:answer/id #uuid "6c90963a-b0b3-5bf8-8a7f-12061b08aec8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186312826}] :answer-field/correct {:answer/id #uuid "298d9191-54cb-5bf9-8423-e6c508a4a3af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\pi }" :db/id #edb/ref 17592186312290} :answer-field/id #uuid "e66deadc-ef85-53ee-92ca-373956718828" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314643}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b8b54f2c-8781-54b8-a107-16250836e9fb" :question/math-academy-id "q-340648" :question/problem "Let $F(x)={x}^{2}+6x$ for $x\\in R,$ and let $f(x)$ be the $2\\pi $-periodic extension of $F$ from $x\\in [-\\pi ,\\pi )$ to $x\\in R.$ The Fourier series of $f$ is given by\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)).\n$$\n\nSelect the correct options in the expression for the coefficient ${b}_{3}$ below, where $⟨\\,,⟩$ denotes the usual inner product on functions over $[-\\pi ,\\pi ).$\n\n$$\n\\begin{aligned}{b}_{3} & ={{field-1}} \\\\  & ={{field-2}}\\,\\cdot \\,{{field-3}}\\end{aligned}\n$$" :question/worked-solution "The usual inner product of functions $f$ and $g$ over $x\\in [-\\pi ,\\pi )$ is given by\n\n$$\n⟨f(x),g(x)⟩={\\int }_{-\\pi }^{\\pi }f(x)g(x)\\,\\text{d}x.\n$$\n\nFor a $2\\pi $-periodic function $f(x)$ that's piecewise continuous over $x\\in [-\\pi ,\\pi ),$ the Fourier series of $f$ is given by \n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\n$$\n\nwhere ${a}_{0},$ ${a}_{n},$ and ${b}_{n}$ are constants to be determined. \n\nNow, we find the inner product of $f(x)$ with $\\operatorname{sin}⁡(3x):$\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{sin}⁡(3x)⟩ &= ⟨\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\\operatorname{sin}⁡(3x)⟩ \\\\ &= ⟨\\frac{{a}_{0}}{2},\\operatorname{sin}⁡(3x)⟩+{\\sum }_{n=1}^{\\infty }⟨{a}_{n}\\operatorname{cos}⁡(nx),\\operatorname{sin}⁡(3x)⟩+{\\sum }_{n=1}^{\\infty }⟨{b}_{n}\\operatorname{sin}⁡(nx),\\operatorname{sin}⁡(3x)⟩ \\\\ &= \\frac{{a}_{0}}{2}⟨1,\\operatorname{sin}⁡(3x)⟩+{\\sum }_{n=1}^{\\infty }{a}_{n}⟨\\operatorname{cos}⁡(nx),\\operatorname{sin}⁡(3x)⟩+{\\sum }_{n=1}^{\\infty }{b}_{n}⟨\\operatorname{sin}⁡(nx),\\operatorname{sin}⁡(3x)⟩\\end{aligned}\n$$\n\nSince the functions\n$1,\\operatorname{sin}⁡(x),\\operatorname{cos}⁡(x),\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(2x),…$\nare orthogonal with respect to the defined inner product, the only nonzero term in the final expression above is\n\n$$\n{b}_{3}⟨\\operatorname{sin}⁡(3x),\\operatorname{sin}⁡(3x)⟩.\n$$\n\nComputing the inner product, we have\n\n$$\n\\begin{aligned}⟨\\operatorname{sin}⁡(3x),\\operatorname{sin}⁡(3x)⟩ & ={\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡(3x)\\,\\text{d}x \\\\  & ={\\int }_{-\\pi }^{\\pi }\\frac{1}{2}-\\frac{1}{2}\\operatorname{cos}⁡(6x)\\,\\text{d}x \\\\  & ={[\\frac{1}{2}x-\\frac{1}{12}\\operatorname{sin}⁡(6x)]}_{-\\pi }^{\\pi } \\\\  & =\\frac{1}{2}(\\pi -(-\\pi ))-\\frac{1}{12}(\\operatorname{sin}⁡(6\\pi )-(\\operatorname{sin}⁡(-6\\pi ))) \\\\  & =\\pi .\\end{aligned}\n$$\n\nFinally, we obtain that\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{sin}⁡(3x)⟩ & ={b}_{3}⟨\\operatorname{sin}⁡(3x),\\operatorname{sin}⁡(3x)⟩ \\\\ {b}_{3} & =\\frac{⟨f(x),\\operatorname{sin}⁡(3x)⟩}{⟨\\operatorname{sin}⁡(3x),\\operatorname{sin}⁡(3x)⟩} \\\\ {b}_{3} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{sin}⁡(3x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot {\\int }_{-\\pi }^{\\pi }({x}^{2}+6x)\\operatorname{sin}⁡(3x)\\,\\text{d}x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a94b1c8-4d5d-57f8-8d53-ac3a6453ca96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }({x}^{3}-3{x}^{2})\\operatorname{sin}⁡(x)\\,\\text{d}x" :db/id #edb/ref 17592186312056} {:answer/id #uuid "53816f6c-3e82-50d9-ac80-035267b9b313" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }({x}^{3}-3{x}^{2})\\operatorname{cos}⁡(x)\\,\\text{d}x" :db/id #edb/ref 17592186312652} {:answer/id #uuid "7ef6361a-50cc-5c14-ac0e-7f3592a2bc20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\infty }({x}^{3}-3{x}^{2})\\operatorname{cos}⁡(x)\\,\\text{d}x" :db/id #edb/ref 17592186312996} {:answer/id #uuid "e1fe8b43-b488-50d6-beab-ddb1e8e7c81e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }({x}^{3}-3{x}^{2})\\operatorname{sin}⁡(x)\\,\\text{d}x" :db/id #edb/ref 17592186313755} {:answer/id #uuid "e9e238a1-1b26-5122-a8fe-5ff7e768750a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }({x}^{3}-3{x}^{2})\\operatorname{cos}⁡(x)\\,\\text{d}x" :d