acc-9c82-844150388863" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{11t}" :db/id #edb/ref 17592186503324} {:answer/id #uuid "b195dfc3-03fb-5220-941c-824823148fff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{36}{11t}" :db/id #edb/ref 17592186503341}] :answer-field/correct {:answer/id #uuid "779d3383-19e0-50ea-9d73-d522be2f3d68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6}{11t}" :db/id #edb/ref 17592186503221} :answer-field/id #uuid "d917ef30-e7dc-5bfc-871f-18df149530e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503623}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a2aa05db-1a86-5603-983d-94f822e3df23" :question/math-academy-id "q-162959" :question/problem "Simplify $\\sqrt{\\frac{36}{121{t}^{2}}}$ given that $t<0.$" :question/worked-solution "First, we put the numerator and denominator under separate radicals and then simplify the result:\n\n$$\n\\sqrt{\\frac{36}{121{t}^{2}}}=\\frac{\\sqrt{36}}{\\sqrt{121{t}^{2}}}=\\frac{\\sqrt{{6}^{2}}}{\\sqrt{121{t}^{2}}}=\\frac{6}{\\sqrt{121{t}^{2}}}\n$$\n\nNow, notice that the expression inside the radical is a perfect square. So, we can continue simplifying by writing the expression as this perfect square:\n\n$$\n\\begin{aligned}\\frac{6}{\\sqrt{121{t}^{2}}} &= \\frac{6}{\\sqrt{(11t)^{2}}} \\\\ &= \\frac{6}{|11t|} \\\\ &= \\frac{6}{|11|\\cdot |t|} \\\\ &= \\frac{6}{11\\cdot |t|}\\end{aligned}\n$$\n\nLastly, we are told that $t<0,$ so we have $|t|=-t.$ Therefore, the final answer is\n\n$$\n\\begin{aligned}\\frac{6}{11\\cdot |t|} &= \\frac{6}{11\\cdot (-t)} \\\\ &= -\\frac{6}{11t}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503731 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "088c6b4c-b361-5d39-9983-8191161ab392" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{2}x" :db/id #edb/ref 17592186502998} {:answer/id #uuid "293f37f8-650c-59c4-8c5e-887aafb8d3d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186503058} {:answer/id #uuid "2f4ac90d-1e90-59c7-8b30-f6f858bde1ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt[3]{x}" :db/id #edb/ref 17592186503068} {:answer/id #uuid "781dc60c-44ce-5ed6-a636-63ebe0108fe3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x" :db/id #edb/ref 17592186503224} {:answer/id #uuid "af34ed75-698b-53d3-913f-34e99574be51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{2x}" :db/id #edb/ref 17592186503336}] :answer-field/correct {:answer/id #uuid "293f37f8-650c-59c4-8c5e-887aafb8d3d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186503058} :answer-field/id #uuid "e1f83cd6-e452-5786-beb6-ec5bc7114735" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503627}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b49efc81-0ddf-5a4e-8d55-47ad95f0b7d1" :question/math-academy-id "q-141846" :question/problem "$\\sqrt[3]{x}\\cdot \\sqrt[3]{8{x}^{2}}=$" :question/worked-solution "We perform the multiplication under a single radical and then simplify the result:\n\n$$\n\\begin{aligned}\\sqrt[3]{x}\\cdot \\sqrt[3]{8{x}^{2}} &= \\sqrt[3]{x\\cdot 8{x}^{2}} \\\\ &= \\sqrt[3]{8\\cdot {x}^{3}} \\\\ &= \\sqrt[3]{(2x)^{3}} \\\\ &= 2x\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503733 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05cd87b2-a486-59e8-85ee-e76c7c31902b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15{z}^{4}" :db/id #edb/ref 17592186502990} {:answer/id #uuid "10e1544e-48e2-5db7-a5cf-be0b233078c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{2}\\sqrt{15z}" :db/id #edb/ref 17592186503018} {:answer/id #uuid "492dabbf-4621-5e6f-9294-dfbe3cbd667e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{3}\\sqrt{15z}" :db/id #edb/ref 17592186503118} {:answer/id #uuid "9f0a6e86-1cc6-5082-a1e5-5f66102b512a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15{z}^{3}\\sqrt{z}" :db/id #edb/ref 17592186503299} {:answer/id #uuid "ddeb8158-e099-5e92-b52e-6505d13a382f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{4}\\sqrt{15}" :db/id #edb/ref 17592186503431}] :answer-field/correct {:answer/id #uuid "492dabbf-4621-5e6f-9294-dfbe3cbd667e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{3}\\sqrt{15z}" :db/id #edb/ref 17592186503118} :answer-field/id #uuid "5505afd0-bf5c-53e8-aefd-6b87f5951abf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503550}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b57aff47-fce6-506a-bd4c-d85de1a296a5" :question/math-academy-id "q-110957" :question/problem "If $z\\ge 0,$ then $\\sqrt{3z}\\cdot \\sqrt{5{z}^{6}}=$" :question/worked-solution "We perform the multiplication under a single radical and then simplify the result:\n\n$$\n\\begin{aligned}\\sqrt{3z}\\cdot \\sqrt{5{z}^{6}} &= \\sqrt{3z\\cdot 5{z}^{6}} \\\\ &= \\sqrt{{z}^{6}\\cdot 15z} \\\\ &= \\sqrt{{({z}^{3})}^{2}\\cdot 15z} \\\\ &= \\sqrt{{({z}^{3})}^{2}}\\cdot \\sqrt{15z} \\\\ &= |{z}^{3}|\\cdot \\sqrt{15z} \\\\ &= |z{|}^{3}\\cdot \\sqrt{15z}\\end{aligned}\n$$\n\nSince $z\\ge 0,$ we have $|z|=z,$ and we can simplify further. Therefore, our final answer is\n\n$$\n|z{|}^{3}\\cdot \\sqrt{15z}={z}^{3}\\sqrt{15z}.\n$$"} {:db/id #edb/ref 17592186503743 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "423b0bc1-99df-50d0-bdac-012d5259dc1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}{w}^{2}" :db/id #edb/ref 17592186503108} {:answer/id #uuid "66d3a962-42e6-57db-9470-e68aab60000d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12{w}^{2}" :db/id #edb/ref 17592186503184} {:answer/id #uuid "6cadb21d-3925-58c7-91fc-d739ee327c7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36{w}^{2}" :db/id #edb/ref 17592186503197} {:answer/id #uuid "78f6ba2e-a044-5c94-85cf-c825a698fcd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\sqrt{3}{w}^{2}" :db/id #edb/ref 17592186503226} {:answer/id #uuid "7bf84e7f-1220-51b8-81a0-06fe76cc54c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}{w}^{2}" :db/id #edb/ref 17592186503233}] :answer-field/correct {:answer/id #uuid "6cadb21d-3925-58c7-91fc-d739ee327c7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36{w}^{2}" :db/id #edb/ref 17592186503197} :answer-field/id #uuid "fc0cced4-cb6d-5244-b5cc-9c304fe01b62" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503645}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d17d0de9-c925-52f5-bd49-81ba61ecf89c" :question/math-academy-id "q-141845" :question/problem "$\\sqrt{16w}\\cdot 3\\sqrt{9{w}^{3}}=$" :question/worked-solution "We perform the multiplication under a single radical and then simplify the result:\n\n$$\n\\begin{aligned}\\sqrt{16w}\\cdot 3\\sqrt{9{w}^{3}} &= 3\\sqrt{16w\\cdot 9{w}^{3}} \\\\ &= 3\\sqrt{144{w}^{4}} \\\\ &= 3\\sqrt{(12{w}^{2})^{2}} \\\\ &= 3|12{w}^{2}| \\\\ &= 3\\cdot |12|\\cdot |{w}^{2}| \\\\ &= 3\\cdot 12\\cdot |{w}^{2}| \\\\ &= 36\\cdot |{w}^{2}|\\end{aligned}\n$$\n\nA squared number is always positive or zero, and the absolute value of any positive (or zero) number is itself, so we have\n\n$$\n\\begin{aligned}36\\cdot |{w}^{2}| & =36{w}^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503848 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d6ad986-0c26-5cd6-9cd3-04a7be56d694" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{6}}{7}+C" :db/id #edb/ref 17592186503846} {:answer/id #uuid "4ec8b324-f032-547f-97d9-6c73f80f4440" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{7}+C" :db/id #edb/ref 17592186503850} {:answer/id #uuid "7fe67df0-46d1-5acd-abf6-e732a8688e8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{8}+C" :db/id #edb/ref 17592186503855} {:answer/id #uuid "b8b1f0d3-bec7-598d-ba2e-a3f438f06ce3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7x^{7}+C" :db/id #edb/ref 17592186503868} {:answer/id #uuid "fa59a2a3-a8ed-5b0b-abda-91a9bba04e9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{7}}{7}+C" :db/id #edb/ref 17592186503875}] :answer-field/correct {:answer/id #uuid "fa59a2a3-a8ed-5b0b-abda-91a9bba04e9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{7}}{7}+C" :db/id #edb/ref 17592186503875} :answer-field/id #uuid "b67f2104-8e47-50cd-b752-fad1aa17e5ed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503867}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4194dc2e-82ad-5109-91f4-d383eed4b18e" :question/problem "Calculate $\\int {x}^{6}\\,\\text{d}x.$" :question/worked-solution "We apply the power rule with $n=6$, and we get\n\n$$\n\\int {x}^{6}\\,\\text{d}x=\\frac{{x}^{6+1}}{6+1}+C=\\frac{{x}^{7}}{7}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{7}}{7}+C) &= \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{7}}{7})+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{7}\\frac{\\text{d}}{\\text{d}x}({x}^{7})+0 \\\\ &= \\frac{1}{7}\\cdot 7{x}^{6} \\\\ &= {x}^{6}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503851 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b9bd22-8b41-542b-82ba-62e400af4a02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{8} + C" :db/id #edb/ref 17592186503842} {:answer/id #uuid "0b7b7de0-eaf8-57d9-8475-c23f72194dd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8x^{8}" :db/id #edb/ref 17592186503844} {:answer/id #uuid "a5bb73e6-3ec8-51dd-ad3b-1cd6d6243b7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8 + C" :db/id #edb/ref 17592186503862} {:answer/id #uuid "b52194ac-60ec-5ec7-91b2-c8a58426c3e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{8}" :db/id #edb/ref 17592186503866} {:answer/id #uuid "f1d839d9-d182-5a2a-8ca4-8961f79ffaae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{8} + C" :db/id #edb/ref 17592186503874}] :answer-field/correct {:answer/id #uuid "01b9bd22-8b41-542b-82ba-62e400af4a02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{8} + C" :db/id #edb/ref 17592186503842} :answer-field/id #uuid "88eaa69f-9171-51b9-9926-45e937a2ad36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503859}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4fc55d29-07c8-58f3-8bc8-d1223d0589d0" :question/problem "Calculate $\\int {x}^{7}\\,\\text{d}x.$ Include the arbitrary constant of integration." :question/worked-solution "We apply the power rule with $n=7$, and we get\n\n$$\n\\int {x}^{7}\\,\\text{d}x=\\frac{{x}^{7+1}}{7+1}+C=\\frac{{x}^{8}}{8}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{8}}{8}+C) &= \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{8}}{8})+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{8}\\frac{\\text{d}}{\\text{d}x}({x}^{8})+0 \\\\ &= \\frac{1}{8}\\cdot 8{x}^{7} \\\\ &= {x}^{7}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503854 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "081fa2f5-42b3-5c04-80c9-10a003c271a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x^{4} + C" :db/id #edb/ref 17592186503843} {:answer/id #uuid "4a21e63a-5ffd-51d5-a90e-548e77d4bab3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{6}}{6} + C" :db/id #edb/ref 17592186503849} {:answer/id #uuid "7015537d-a311-57e0-815f-dece8e7c2eea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{6} + C" :db/id #edb/ref 17592186503853} {:answer/id #uuid "84bc4aa5-c9e8-54dc-9352-f633e5591d8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{5}}{5} + C" :db/id #edb/ref 17592186503857} {:answer/id #uuid "dd56a3a8-a755-5234-b43f-e287021340e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{4} + C" :db/id #edb/ref 17592186503870}] :answer-field/corre