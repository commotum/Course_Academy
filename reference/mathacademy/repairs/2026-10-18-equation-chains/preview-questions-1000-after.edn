swer/value "4|u{|}^{4}\\sqrt{11}" :db/id #edb/ref 17592186500843} {:answer/id #uuid "ccb9a3f1-55c2-57c9-b329-b187936a94f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2|u{|}^{4}\\sqrt{11}" :db/id #edb/ref 17592186500903} {:answer/id #uuid "e1b43e48-be98-5967-b286-728ee8cbc556" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11|u{|}^{8}\\sqrt{2}" :db/id #edb/ref 17592186500943} {:answer/id #uuid "f25b5c8a-e6b1-58c5-abb0-68b7842aaaf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2|u{|}^{8}\\sqrt{11}" :db/id #edb/ref 17592186500982}] :answer-field/correct {:answer/id #uuid "ccb9a3f1-55c2-57c9-b329-b187936a94f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2|u{|}^{4}\\sqrt{11}" :db/id #edb/ref 17592186500903} :answer-field/id #uuid "532d42ad-6983-5ac0-b812-0adeaa85ae60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501051}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c2d5742a-0261-5618-8222-f4f0f769fb79" :question/math-academy-id "q-141477" :question/problem "Simplify $\\sqrt{44{u}^{8}}.$" :question/worked-solution "We first write $44{u}^{8}$ as the product $4{u}^{8}\\cdot 11$ which contains a perfect square $(4{u}^{8}):$ \n\n$$\n\\begin{aligned}\\sqrt{44{u}^{8}} &= \\sqrt{4{u}^{8}\\cdot 11}\\end{aligned}\n$$\n\nThen, we separate the product into two separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{4{u}^{8}\\cdot 11} &= \\sqrt{{(2{u}^{4})}^{2}\\cdot 11} \\\\ &= \\sqrt{{(2{u}^{4})}^{2}}\\cdot \\sqrt{11}\\end{aligned}\n$$\n\nFinally, we simplify the radical containing the perfect square:\n\n$$\n\\begin{aligned}\\sqrt{{(2{u}^{4})}^{2}}\\cdot \\sqrt{11} &= |2{u}^{4}|\\cdot \\sqrt{11} \\\\ &= |2|\\cdot |{u}^{4}|\\cdot \\sqrt{11} \\\\ &= 2|u{|}^{4}\\sqrt{11}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186501226 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e876c5a-9037-5baf-acbf-9ba00705fd57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4fgh" :db/id #edb/ref 17592186500564} {:answer/id #uuid "30583952-b0c6-55ee-864d-2722626ca01e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2fg{h}^{2}" :db/id #edb/ref 17592186500567} {:answer/id #uuid "32d2d786-51d7-5f07-ab4d-ba30edce218c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2fgh" :db/id #edb/ref 17592186500574} {:answer/id #uuid "43664aa3-e124-5faa-aa77-ae09767124ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2fgh" :db/id #edb/ref 17592186500597} {:answer/id #uuid "4c8ae3d4-7dac-56f0-afcc-4269286bdf5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4fgh" :db/id #edb/ref 17592186500620}] :answer-field/correct {:answer/id #uuid "32d2d786-51d7-5f07-ab4d-ba30edce218c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2fgh" :db/id #edb/ref 17592186500574} :answer-field/id #uuid "d0c3eb9e-8664-5cd5-8345-3716f6532fd0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501114}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d271c02f-63d9-52da-abf5-d399868f3744" :question/math-academy-id "q-110919" :question/problem "Simplify $\\sqrt{4{f}^{2}{g}^{2}{h}^{2}}$ given that $f<0,$ $g<0$ and $h>0.$" :question/worked-solution "The square root of a squared quantity can be simplified using absolute value.\n\n$$\n\\sqrt{{x}^{2}}=|x|\n$$\n\nIn our case, we can simplify the given expression as follows:\n\n$$\n\\begin{aligned}\\sqrt{4{f}^{2}{g}^{2}{h}^{2}} &= \\sqrt{{(2fgh)}^{2}} \\\\ &= |2fgh| \\\\ &= |2|\\cdot |fgh| \\\\ &= 2\\cdot |fgh|\\end{aligned}\n$$\n\nWe are told that $f<0,$ $g<0$ and $h>0.$ We know that the absolute value of any positive number is just itself, and to take the absolute value of any negative number we need to flip the sign. Therefore, our final answer is\n\n$$\n\\begin{aligned}2\\cdot |fgh| &= 2\\cdot |f|\\cdot |g|\\cdot |h| \\\\ &= 2\\cdot (-f)\\cdot (-g)\\cdot (h) \\\\ &= 2fgh.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186501231 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0863c307-3fc4-50bb-8193-2637b4d1fbf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{y}" :db/id #edb/ref 17592186500482} {:answer/id #uuid "19bc5229-73fa-5621-ae34-90fcabb4ab10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{y}" :db/id #edb/ref 17592186500522} {:answer/id #uuid "2f44c7a4-9e6e-5b6f-85e7-5e7350d7fb51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{{y}^{2}}" :db/id #edb/ref 17592186500565} {:answer/id #uuid "c0622a2f-34d6-58c4-b16a-d4b9c8c6f07c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{y}" :db/id #edb/ref 17592186500866} {:answer/id #uuid "efca88fd-4fef-5d52-a234-b3f67f03da6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{{y}^{2}}" :db/id #edb/ref 17592186500975}] :answer-field/correct {:answer/id #uuid "19bc5229-73fa-5621-ae34-90fcabb4ab10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{y}" :db/id #edb/ref 17592186500522} :answer-field/id #uuid "72fd739d-61ce-572d-ba84-147f6daa016b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501068}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e44f5e7f-50c8-5f61-b0b8-699aaec6f842" :question/math-academy-id "q-52504" :question/problem "Simplify $\\sqrt{\\frac{9}{{y}^{2}}}\\,$ given that $y<0.$" :question/worked-solution "The square root of a squared quantity can be simplified using absolute value.\n\n$$\n\\sqrt{{x}^{2}}=|x|\n$$\n\nIn our case, we can simplify the given expression as follows:\n\n$$\n\\begin{aligned}\\sqrt{\\frac{9}{{y}^{2}}} &= \\sqrt{\\frac{3}{y}\\cdot \\frac{3}{y}} \\\\ &= \\sqrt{{(\\frac{3}{y})}^{2}} \\\\ &= |\\frac{3}{y}| \\\\ &= \\frac{|3|}{|y|} \\\\ &= \\frac{3}{|y|}\\end{aligned}\n$$\n\nWe are told that $y<0.$ To take the absolute value of any negative number we need to flip the sign, so we have $|y|=-y.$ Therefore, our final answer is\n\n$$\n\\frac{3}{|y|}=-\\frac{3}{y}.\n$$"} {:db/id #edb/ref 17592186502097 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00a3bbbb-3d58-5812-91fd-8458c0795915" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186501464} {:answer/id #uuid "12288c26-42df-51dd-808b-20f205e3ddd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{x}" :db/id #edb/ref 17592186501497} {:answer/id #uuid "4c2fc26f-d391-5c9e-920f-520d82144c0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\sqrt{x}" :db/id #edb/ref 17592186501605} {:answer/id #uuid "4dfca826-0d43-5c60-a846-18bed3fc4466" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186501608} {:answer/id #uuid "97ddaa21-49aa-5eb8-9cbb-6265ff11235f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\sqrt{x}" :db/id #edb/ref 17592186501753}] :answer-field/correct {:answer/id #uuid "12288c26-42df-51dd-808b-20f205e3ddd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{x}" :db/id #edb/ref 17592186501497} :answer-field/id #uuid "7f247b26-452d-5f9b-bfd1-ec0918630ed5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502020}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3efd4daf-a1cf-5957-b4aa-c8ff94e19b4d" :question/math-academy-id "q-52391" :question/problem "$3\\sqrt{x}-2\\sqrt{x}=$" :question/worked-solution "We can combine the two $\\sqrt{x}$ terms together, as follows:\n\n$$\n\\begin{aligned}3\\sqrt{x}-2\\sqrt{x} &= (3-2)\\sqrt{x} \\\\ &= \\sqrt{x}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186502098 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fd144af-d507-5334-8bb4-0403c5376fa2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(p-4)\\sqrt[3]{p}+\\sqrt{p}" :db/id #edb/ref 17592186501583} {:answer/id #uuid "7c01e360-4b50-5260-b311-2ea621722164" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(p+1)\\sqrt[3]{p}-2\\sqrt{p}" :db/id #edb/ref 17592186501698} {:answer/id #uuid "8b456b28-3a4a-5b14-a2fc-7ae17008160f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1-p)\\sqrt{p}-4\\sqrt[3]{p}" :db/id #edb/ref 17592186501734} {:answer/id #uuid "a5345b39-e7c1-50d0-9c54-c658acc7bcb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(p+1)\\sqrt{p}-2\\sqrt[3]{p}" :db/id #edb/ref 17592186501785} {:answer/id #uuid "e2171678-dbe0-5c40-aba8-dc750a70794f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1-p)\\sqrt[3]{p}-2\\sqrt{p}" :db/id #edb/ref 17592186501917}] :answer-field/correct {:answer/id #uuid "7c01e360-4b50-5260-b311-2ea621722164" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(p+1)\\sqrt[3]{p}-2\\sqrt{p}" :db/id #edb/ref 17592186501698} :answer-field/id #uuid "4914e07f-3d93-5356-b4b8-8517fb1d7635" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501997}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "40cade47-943f-50c4-8cf4-c4d5f9b88bc8" :question/math-academy-id "q-134506" :question/problem "$2\\sqrt{p}-\\sqrt{16p}+\\sqrt[3]{p}+\\sqrt[3]{{p}^{4}}=$" :question/worked-solution "We simplify each of the radical terms using the product rule:\n\n$$\n\\begin{aligned}2\\sqrt{p}-\\sqrt{16p}+\\sqrt[3]{p}+\\sqrt[3]{{p}^{4}} &= 2\\sqrt{p}-\\sqrt{16\\cdot p}+\\sqrt[3]{p}+\\sqrt[3]{{p}^{3}\\cdot p} \\\\ &= 2\\sqrt{p}-\\sqrt{16}\\cdot \\sqrt{p}+\\sqrt[3]{p}+\\sqrt[3]{{p}^{3}}\\cdot \\sqrt[3]{p} \\\\ &= 2\\sqrt{p}-4\\sqrt{p}+\\sqrt[3]{p}+p\\sqrt[3]{p}\\end{aligned}\n$$\n\nFinally, we combine the like terms:\n\n$$\n\\begin{aligned}2\\sqrt{p}-4\\sqrt{p}+\\sqrt[3]{p}+p\\sqrt[3]{p} &= (2-4)\\sqrt{p}+(1+p)\\sqrt[3]{p} \\\\ &= -2\\sqrt{p}+(1+p)\\sqrt[3]{p} \\\\ &= (p+1)\\sqrt[3]{p}-2\\sqrt{p}\\end{aligned}\n$$\n\nNotice that we cannot combine the $\\sqrt[3]{p}$ and $\\sqrt{p}$ terms."} {:db/id #edb/ref 17592186502101 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10416c63-126d-535c-8234-46889c821e2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{z}" :db/id #edb/ref 17592186501494} {:answer/id #uuid "1409de6f-8d4c-561a-bf02-e951797f383b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3z}" :db/id #edb/ref 17592186501504} {:answer/id #uuid "badeb28a-792c-5ea5-8883-c07f39f28e6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3z" :db/id #edb/ref 17592186501836} {:answer/id #uuid "c8a76dcc-4b19-5947-8692-6d6df0c64d65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{z}" :db/id #edb/ref 17592186501865} {:answer/id #uuid "f98bd692-ae23-58eb-8a79-31282bc0610f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{3z}" :db/id #edb/ref 17592186501963}] :answer-field/correct {:answer/id #uuid "1409de6f-8d4c-561a-bf02-e951797f383b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3z}" :db/id #edb/ref 17592186501504} :answer-field/id #uuid "21504cce-4e5d-5521-b05b-808c98517963" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501987}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "48442579-8421-52f2-adbc-f2ba91a631dd" :question/math-academy-id "q-34206" :question/problem "Simplify $\\sqrt{192z}-\\sqrt{147z}.$" :question/worked-solution "We simplify each of the radical terms using the product rule:\n\n$$\n\\begin{aligned}\\sqrt{192z}-\\sqrt{147z} &= \\sqrt{64\\cdot 3z}-\\sqrt{49\\cdot 3z} \\\\ &= \\sqrt{64}\\cdot \\sqrt{3z}-\\sqrt{49}\\cdot \\sqrt{3z} \\\\ &= 8\\sqrt{3z}-7\\sqrt{3z}\\end{aligned}\n$$\n\nFinally, we combine the like terms:\n\n$$\n\\begin{aligned}8\\sqrt{3z}-7\\sqrt{3z} &= (8-7)\\sqrt{3z} \\\\ &= \\sqrt{3z}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186502133 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "013c5fbb-49f5-5cea-af95-36393c4411da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{n}^{2}\\sqrt{3n}" :db/id #edb/ref 17592186501468} {:answer/id #uuid "92318117-1a9a-54a3-b50a-b61d8666f7b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{n}^{2}\\sqrt{2n}" :db/id #edb/ref 17592186501746} {:answer/id #uuid "bbcd05f3-4d31-538b-823a-86edda099981" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answe