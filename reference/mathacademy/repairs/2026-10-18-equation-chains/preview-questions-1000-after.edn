e "\\frac{7}{10}" :db/id #edb/ref 17592186494325} {:answer/id #uuid "28e4f656-f65d-5411-8d23-3582c6860ee1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{10}" :db/id #edb/ref 17592186494395} {:answer/id #uuid "7e76872b-704c-5f0c-a9ff-08c0e8fdc198" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{7}" :db/id #edb/ref 17592186494593} {:answer/id #uuid "93ee67a5-c7ed-59bc-a55b-a2b9816ca144" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{17}{10}" :db/id #edb/ref 17592186494657} {:answer/id #uuid "a652b819-cc60-593b-be0f-164896bc2a59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{10}{17}" :db/id #edb/ref 17592186494698}] :answer-field/correct {:answer/id #uuid "93ee67a5-c7ed-59bc-a55b-a2b9816ca144" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{17}{10}" :db/id #edb/ref 17592186494657} :answer-field/id #uuid "df747204-bd95-5057-9f83-9ee058a01322" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186495026}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0f15a926-c445-59e0-9b0e-24fb3d26db90" :question/math-academy-id "q-99830" :question/problem "Evaluate $\\frac{8}{x}+\\frac{2}{4x}$ for $x=-5.$" :question/worked-solution "We replace $x$ with $-5$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{8}{x}+\\frac{2}{4x} &= \\frac{8}{(-5)}+\\frac{2}{4\\cdot (-5)} \\\\ &= -\\frac{8}{5}+(-\\frac{2}{20}) \\\\ &= -\\frac{8}{5}-\\frac{1}{10} \\\\ &= -\\frac{16}{10}-\\frac{1}{10} \\\\ &= \\frac{-16-1}{10} \\\\ &= -\\frac{17}{10}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186495065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a193