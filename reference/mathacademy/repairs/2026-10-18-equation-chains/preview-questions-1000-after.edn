}^{2}+{s}^{2})+(-2s)({r}^{2}+{s}^{2}) \\\\ &= {r}^{3}+r{s}^{2}-2s{r}^{2}-2{s}^{3}.\\end{aligned}\n$$\n\nWe cannot simplify the above expression any further because there are no like terms."} {:db/id #edb/ref 17592186495091 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08ba6809-48d6-572e-a887-ee445eb17ac5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{3}}{5}" :db/id #edb/ref 17592186494341} {:answer/id #uuid "9541ae86-02b9-5a82-a43c-89a200374f23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt{3}" :db/id #edb/ref 17592186494660} {:answer/id #uuid "e1e2d6be-e1f7-5b7f-b3e5-50ad0be9ac8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{5}" :db/id #edb/ref 17592186494854} {:answer/id #uuid "e294048f-eaaa-5e29-aeaf-312c92a62877" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{15}}{5}" :db/id #edb/ref 17592186494858} {:answer/id #uuid "eafd7840-0948-5dc2-99ff-617d14233294" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186494875}] :answer-field/correct {:answer/id #uuid "e1e2d6be-e1f7-5b7f-b3e5-50ad0be9ac8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{5}" :db/id #edb/ref 17592186494854} :answer-field/id #uuid "8e4335f4-0a43-52eb-920e-e7c8066542cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186494981}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6053c699-eed7-5f85-aa40-b59fc9957b5c" :question/math-academy-id "q-68973" :question/problem "$\\frac{3}{5\\sqrt{3}}=$" :question/worked-solution "To remove the radical $\\sqrt{3}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{3}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{3}{5\\sqrt{3}} &= \\frac{3}{5\\sqrt{3}}\\cdot \\frac{\\sqrt{3}}{\\sqrt{3}} \\\\ &= \\frac{3\\sqrt{3}}{5\\cdot (\\sqrt{3})^{2}} \\\\ &= \\frac{3\\sqrt{3}}{5\\cdot 3} \\\\ &= \\frac{\\sqrt{3}}{5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186495109 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90b1e99c-00a5-5d5c-9c07-a9ac4425d78b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{4}" :db/id #edb/ref 17592186494647}] :answer-field/correct {:answer/id #uuid "90b1e99c-00a5-5d5c-9c07-a9ac4425d78b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{4}" :db/id #edb/ref 17592186494647} :answer-field/id #uuid "390cda6c-7afa-531f-b8d2-8d4ab6b358f0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186494941}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8ab342b9-3bac-54fe-9ede-058c11e77bac" :question/math-academy-id "q-175902" :question/problem "If $p=-2$ and $q=6,$ then $\\frac{2q-3}{4}+\\frac{4}{4-2p}=${{field-1}}." :question/worked-solution "Replacing $p$ with $-2$ and $q$ with $6$ in the expression, we get the following:\n\n$$\n\\begin{aligned}\\frac{2q-3}{4}+\\frac{4}{4-2p} &= \\frac{2(6)-3}{4}+\\frac{4}{4-2(-2)} \\\\ &= \\frac{12-3}{4}+\\frac{4}{4+4} \\\\ &= \\frac{9}{4}+\\frac{4}{8} \\\\ &= \\frac{18}{8}+\\frac{4}{8} \\\\ &= \\frac{18+4}{8} \\\\ &= \\frac{22}{8} \\\\ &= \\frac{11}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186495125 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f7a6999-f8f4-59e0-98e0-015a493f1d2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{21}}{7}" :db/id #edb/ref 17592186494555} {:answer/id #uuid "89a01196-ecc5-54e7-97a0-a62b76df60ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9\\sqrt{7}}{7}" :db/id #edb/ref 17592186494626} {:answer/id #uuid "9af2d328-e266-562e-9983-62f0ac8950e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{63}}{7}" :db/id #edb/ref 17592186494673} {:answer/id #uuid "c52da2ef-45c8-5cc1-8d40-dcc039628f7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{7}}{7}" :db/id #edb/ref 17592186494781} {:answer/id #uuid "e2e5fe20-ac58-5d90-b58b-91cc21887122" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}}{21}" :db/id #edb/ref 17592186494859}] :answer-field/correct {:answer/id #uuid "6f7a6999-f8f4-59e0-98e0-015a493f1d2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{21}}{7}" :db/id #edb/ref 17592186494555} :answer-field/id #uuid "a3bf9e83-273c-5b34-b405-581696dd025a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186494994}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ae109d24-9fc2-5d5a-8052-a06c5bb12363" :question/math-academy-id "q-68978" :question/problem "$\\frac{\\sqrt{3}}{\\sqrt{7}}=$" :question/worked-solution "To remove the radical $\\sqrt{7}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{7}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{3}}{\\sqrt{7}} &= \\frac{\\sqrt{3}}{\\sqrt{7}}\\cdot \\frac{\\sqrt{7}}{\\sqrt{7}} \\\\ &= \\frac{\\sqrt{3}\\cdot \\sqrt{7}}{(\\sqrt{7})^{2}} \\\\ &= \\frac{\\sqrt{3}\\cdot \\sqrt{7}}{7}\\end{aligned}\n$$\n\nNow, we use the product rule to simplify the numerator:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{3}\\cdot \\sqrt{7}}{7} &= \\frac{\\sqrt{3\\cdot 7}}{7} \\\\ &= \\frac{\\sqrt{21}}{7}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186495145 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e3dbef9-dc90-5521-aad3-0e986ff0a9c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186494374} {:answer/id #uuid "2f95e908-cc3c-52a0-b192-0d0710737e7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186494411} {:answer/id #uuid "8afd3cea-dcab-580e-a906-ca6e1b3ef1ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186494632} {:answer/id #uuid "c99f603d-0d8c-5cad-a745-389ae3790563" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186494793} {:answer/id #uuid "fc53b599-5c2a-51eb-849a-b5560be90857" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186494912}] :answer-field/correct {:answer/id #uuid "c99f603d-0d8c-5cad-a745-389ae3790563" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186494793} :answer-field/id #uuid "ae640502-6ec1-5965-8f84-422b9cf2d36f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186494999}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cd9fe40e-bc91-5a44-83a1-8324033e7c36" :question/math-academy-id "q-41396" :question/problem "Evaluate $\\frac{4p-1}{2(2p+2)}$ for $p=4.$" :question/worked-solution "We replace $p$ with $4$ in the above expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{4p-1}{2(2p+2)} &= \\frac{4(4)-1}{2(2(4)+2)} \\\\ &= \\frac{15}{2(8+2)} \\\\ &= \\frac{15}{20} \\\\ &= \\frac{3}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186495155 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c2a21ab-44c4-5643-851b-b4a76932cc75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16y^{2}+42y+5" :db/id #edb/ref 17592186494344}] :answer-field/correct {:answer/id #uuid "0c2a21ab-44c4-5643-851b-b4a76932cc75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16y^{2}+42y+5" :db/id #edb/ref 17592186494344} :answer-field/id #uuid "e00f9b37-087b-5f93-99a9-aa065185418d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186495027}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e2cad58f-c472-581c-a16b-711a6072cc50" :question/math-academy-id "q-216712" :question/problem "Expand the following product of binomials. Write your answer in **standard form.**\n\n$(8y+1)(2y+5)=$\n{{field-1}}" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}(8y+1)(2y+5) &= 8y(2y+5)+1(2y+5) \\\\ &= 16{y}^{2}+40y+2y+5 \\\\ &= 16{y}^{2}+42y+5\\end{aligned}\n$$"} {:db/id #edb/ref 17592186495162 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16d21786-f17d-5f51-b039-3a8847d6393b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186494363} {:answer/id #uuid "3624078e-face-5369-96cf-5bd66283c3d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186494430} {:answer/id #uuid "506d0e3d-76e7-56a6-8950-11ce3311fb87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}