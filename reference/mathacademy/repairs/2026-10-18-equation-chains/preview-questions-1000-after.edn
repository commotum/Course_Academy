"b653142d-595d-5dac-942f-8b41a4d42831" :question/math-academy-id "q-142029" :question/problem "Simplify $\\sqrt{144{b}^{7}}.$" :question/worked-solution "We first write $144{b}^{7}$ as the product $144{b}^{6}\\cdot b$ which contains a perfect square $(144{b}^{6}):$ \n\n$$\n\\begin{aligned}\\sqrt{144{b}^{7}} &= \\sqrt{144{b}^{6}\\cdot b}\\end{aligned}\n$$\n\nThen, we separate the product into two separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{144{b}^{6}\\cdot b} &= \\sqrt{{(12{b}^{3})}^{2}\\cdot b} \\\\ &= \\sqrt{{(12{b}^{3})}^{2}}\\cdot \\sqrt{b}\\end{aligned}\n$$\n\nFinally, we simplify the radical containing the perfect square:\n\n$$\n\\begin{aligned}\\sqrt{{(12{b}^{3})}^{2}}\\cdot \\sqrt{b} &= |12{b}^{3}|\\cdot \\sqrt{b} \\\\ &= |12|\\cdot |{b}^{3}|\\cdot \\sqrt{b} \\\\ &= 12|b{|}^{3}\\sqrt{b}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186501216 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a85dfae-b58e-5110-b0b2-b9912f1cccfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3y\\sqrt{6}" :db/id #edb/ref 17592186500584} {:answer/id #uuid "5b029b06-3fe8-5023-a99f-576ac04f043d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9y\\sqrt{2}" :db/id #edb/ref 17592186500654} {:answer/id #uuid "ae31e598-f5ee-5a89-8202-3e24a0c7c88b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3y\\sqrt{2}" :db/id #edb/ref 17592186500828} {:answer/id #uuid "e6a4c910-97b2-5aac-ba3f-9b72d7d1e641" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9|y|\\sqrt{6}" :db/id #edb/ref 17592186500958} {:answer/id #uuid "f81c3cae-04ac-5c1d-9a0e-992240cc9e4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3|y|\\sqrt{6}" :db/id #edb/ref 17592186500996}] :answer-field/correct {:answer/id #uuid "f81c3cae-04ac-5c1d-9a0e-992240cc9e4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3|y|\\sqrt{6}" :db/id #edb/ref 17592186500996} :answer-field/id #uuid "e7cd740e-2e2f-5d86-98a0-50d1b58bfb81" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501121}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b89f2670-8d2c-52b5-b612-dd1804214943" :question/math-academy-id "q-141464" :question/problem "Simplify $\\sqrt{54{y}^{2}}.$" :question/worked-solution "We first write $54{y}^{2}$ as the product $9{y}^{2}\\cdot 6$ which contains a perfect square $(9{y}^{2}):$ \n\n$$\n\\begin{aligned}\\sqrt{54{y}^{2}} &= \\sqrt{9{y}^{2}\\cdot 6}\\end{aligned}\n$$\n\nThen, we can separate the product into two separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{9{y}^{2}\\cdot 6} &= \\sqrt{(3y)^{2}\\cdot 6} \\\\ &= \\sqrt{(3y)^{2}}\\cdot \\sqrt{6}\\end{aligned}\n$$\n\nFinally, we simplify the radical containing the perfect square:\n\n$$\n\\begin{aligned}\\sqrt{(3y)^{2}}\\cdot \\sqrt{6} &= |3y|\\cdot \\sqrt{6} \\\\ &= |3|\\cdot |y|\\cdot \\sqrt{6} \\\\ &= 3|y|\\sqrt{6}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186501220 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09b27bcd-d69a-57ab-86dc-d75b13132e84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21\\sqrt{5b}" :db/id #edb/ref 17592186500485} {:answer/id #uuid "1f89ef35-2105-591f-b568-8c349c6c6c9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{57b}" :db/id #edb/ref 17592186500532} {:answer/id #uuid "9f5db809-d03e-58da-aed3-c6e305d1dda2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\sqrt{2b}+12\\sqrt{3b}" :db/id #edb/ref 17592186500792} {:answer/id #uuid "ac618e26-1e71-53d5-a4e7-3fc20e2dddd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\