{:answer/id #uuid "5da55407-8883-53ea-b5c6-491837548baf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{z}^{2}}{14}" :db/id #edb/ref 17592186503163} {:answer/id #uuid "bfa63f28-de50-5192-abd5-b8c2bb8902a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14{z}^{2}" :db/id #edb/ref 17592186503364} {:answer/id #uuid "c9c73b4e-428e-50cc-93e0-cbd14e3b1e99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{z}^{2}}{7}" :db/id #edb/ref 17592186503385} {:answer/id #uuid "fa300cbc-65c1-5757-b142-52fb10a55301" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2|z|}{7}" :db/id #edb/ref 17592186503499}] :answer-field/correct {:answer/id #uuid "c9c73b4e-428e-50cc-93e0-cbd14e3b1e99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{z}^{2}}{7}" :db/id #edb/ref 17592186503385} :answer-field/id #uuid "8026c441-d57b-5d0b-9cf5-6a390d5fe400" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503575}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0691dce4-a0cf-573f-ba88-5eaf489529db" :question/math-academy-id "q-162926" :question/problem "$\\sqrt{\\frac{4{z}^{4}}{49}}=$" :question/worked-solution "First, we put the numerator and denominator under separate radicals and then simplify the result:\n\n$$\n\\sqrt{\\frac{4{z}^{4}}{49}}=\\frac{\\sqrt{4{z}^{4}}}{\\sqrt{49}}=\\frac{\\sqrt{4{z}^{4}}}{\\sqrt{{7}^{2}}}=\\frac{\\sqrt{4{z}^{4}}}{7}\n$$\n\nNow, notice that the expression inside the radical is a perfect square. So, we can continue simplifying by writing the expression as this perfect square:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{4{z}^{4}}}{7} &= \\frac{\\sqrt{(2{z}^{2})^{2}}}{7} \\\\ &= \\frac{|2{z}^{2}|}{7} \\\\ &= \\frac{|2|\\cdot |{z}^{2}|}{7} \\\\ &= \\frac{2\\cdot |{z}^{2}|}{7}\\end{aligned}\n$$\n\nA squared number is always positive or zero, and the absolute value of any positive (or zero) number is itself, so we have\n\n$$\n\\begin{aligned}\\frac{2\\cdot |{z}^{2}|}{7} &= \\frac{2\\cdot {z}^{2}}{7} \\\\ &= \\frac{2{z}^{2}}{7}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503656 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "062d7dd5-f242-5a3b-9405-9a5b5ea96bc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7d}{4}" :db/id #edb/ref 17592186502993} {:answer/id #uuid "2a275a66-ebf4-5205-a5ef-cde8f8dbe9c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28d" :db/id #edb/ref 17592186503061} {:answer/id #uuid "b37dac13-b301-58de-a731-8916f547f6e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4|d|}{7}" :db/id #edb/ref 17592186503348} {:answer/id #uuid "e846052d-00aa-51a2-bb65-4538a6247a50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4d" :db/id #edb/ref 17592186503459} {:answer/id #uuid "f563e148-82b5-5280-9458-176982ebb37c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4|d|" :db/id #edb/ref 17592186503483}] :answer-field/correct {:answer/id #uuid "b37dac13-b301-58de-a731-8916f547f6e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4|d|}{7}" :db/id #edb/ref 17592186503348} :answer-field/id #uuid "ae423bd2-3a38-5bbb-a890-bc1ea84e6baf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503604}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1335ac60-8bcf-5956-af28-bb3838c1f5f0" :question/math-academy-id "q-162907" :question/problem "$\\sqrt{\\frac{16{d}^{2}}{49}}=$" :question/worked-solution "First, we put the numerator and denominator under separate radicals and then simplify the result:\n\n$$\n\\sqrt{\\frac{16{d}^{2}}{49}}=\\frac{\\sqrt{16{d}^{2}}}{\\sqrt{49}}=\\frac{\\sqrt{16{d}^{2}}}{\\sqrt{{7}^{2}}}=\\frac{\\sqrt{16{d}^{2}}}{7}\n$$\n\nNow, notice that the expression inside the radical is a perfect square. So, we can continue simplifying by writing the expression as this perfect square:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{16{d}^{2}}}{7} &= \\frac{\\sqrt{(4d)^{2}}}{7} \\\\ &= \\frac{|4d|}{7} \\\\ &= \\frac{|4|\\cdot |d|}{7} \\\\ &= \\frac{4\\cdot |d|}{7} \\\\ &= \\frac{4|d|}{7}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503672 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "013e435b-60eb-5378-b398-aed373e0a7b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2|k|}" :db/id #edb/ref 17592186502981} {:answer/id #uuid "22250168-100e-5b9e-8fd7-96f4a7947d15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4|k|}" :db/id #edb/ref 17592186503047} {:answer/id #uuid "ae7ed17d-d022-575f-bb63-efbbf8963701" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18|k|" :db/id #edb/ref 17592186503333} {:answer/id #uuid "dd284de2-fe3b-5cd8-b881-4715aed76717" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4k}{9}" :db/id #edb/ref 17592186503428} {:answer/id #uuid "fa620601-fae5-51be-8d5c-fcf623fc1b84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4k" :db/id #edb/ref 17592186503500}] :answer-field/correct {:answer/id #uuid "22250168-100e-5b9e-8fd7-96f4a7947d15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4|k|}" :db/id #edb/ref 17592186503047} :answer-field/id #uuid "9f9ae805-7144-5790-b998-04aad918bbdb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503593}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "31429a2f-5c61-530a-8222-8a7650300604" :question/math-academy-id "q-162911" :question/problem "$\\sqrt{\\frac{81}{16{k}^{2}}}=$" :question/worked-solution "First, we put the numerator and denominator under separate radicals and then simplify the result:\n\n$$\n\\sqrt{\\frac{81}{16{k}^{2}}}=\\frac{\\sqrt{81}}{\\sqrt{16{k}^{2}}}=\\frac{\\sqrt{{9}^{2}}}{\\sqrt{16{k}^{2}}}=\\frac{9}{\\sqrt{16{k}^{2}}}\n$$\n\nNow, notice that the expression inside the radical is a perfect square. So, we can continue simplifying by writing the expression as this perfect square:\n\n$$\n\\begin{aligned}\\frac{9}{\\sqrt{16{k}^{2}}} &= \\frac{9}{\\sqrt{(4k)^{2}}} \\\\ &= \\frac{9}{|4k|} \\\\ &= \\frac{9}{|4|\\cdot |k|} \\\\ &= \\frac{9}{4\\cdot |k|} \\\\ &= \\frac{9}{4|k|}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503673 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03aa9e77-c1bd-5499-b44b-44dc50ce6ae6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\sqrt{u+v}" :db/id #edb/ref 17592186502986} {:answer/id #uuid "08f49d0c-f8bf-5cbd-b4c6-6dfe0604684e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\sqrt{uv}" :db/id #edb/ref 17592186503000} {:answer/id #uuid "2cbb732d-82d4-547c-80a8-7d83e3b744d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{14u+v}" :db/id #edb/ref 17592186503063} {:answer/id #uuid "5ab73013-fe3d-5603-853c-82b4701416c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{7uv}" :db/id #edb/ref 17592186503156} {:answer/id #uuid "e61a8f64-3597-5f56-9cf2-f1c26072d67c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{14uv}" :db/id #edb/ref 17592186503453}] :answer-field/correct {:answer/id #uuid "e61a8f64-3597-5f56-9cf2-f1c26072d67c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{14uv}" :db/id #edb/ref 17592186503453} :answer-field/id #uuid "57fdcfe6-6d56-5f51-bb7b-b1eef860472e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503551}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3146291f-928e-5260-bc40-131359b787ef" :question/math-academy-id "q-141493" :question/problem "The expression $\\sqrt{14u}\\cdot \\sqrt{v}$ is equivalent to" :question/worked-solution "We apply the product rule for radicals, as follows:\n\n$$\n\\begin{aligned}\\sqrt{14u}\\cdot \\sqrt{v} &= \\sqrt{14u\\cdot v} \\\\ &= \\sqrt{14uv}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503686 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44fbf470-b73e-59c0-88a9-4c46a647db06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2a}" :db/id #edb/ref 17592186503113} {:answer/id #uuid "7077dca4-6231-5f02-a788-1ad28179ed34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2a" :db/id #edb/ref 17592186503207} {:answer/id #uuid "ad2a658c-d5e3-56ad-a06c-c64d2889f443" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{a}^{2}" :db/id #edb/ref 17592186503329} {:answer/id #uuid "cb239db5-410c-5e11-903a-4547890ad3a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{a}" :db/id #edb/ref 17592186503390} {:answer/id #uuid "cc350026-beb3-51bc-9cae-86763e7a5745" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{a}^{2}" :db/id #edb/ref 17592186503391}] :answer-field/correct {:answer/id #uuid "ad2a658c-d5e3-56ad-a06c-c64d2889f443" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{a}^{2}" :db/id #edb/ref 17592186503329} :answer-field/id #uuid "9d51e237-68b4-5192-8980-07627460502d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503592}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "53830319-4c61-59d6-b464-6d52b63f8b1c" :question/math-academy-id "q-162932" :question/problem "$\\frac{\\sqrt{12{a}^{4}}}{\\sqrt{3}}=$" :question/worked-solution "First, we bring the quotient under a single radical and then simplify the result:\n\n$$\n\\frac{\\sqrt{12{a}^{4}}}{\\sqrt{3}}=\\sqrt{\\frac{12{a}^{4}}{3}}=\\sqrt{4{a}^{4}}\n$$\n\nNow, notice that the expression inside the radical is a perfect square. So, we can continue simplifying by writing the expression as this perfect square:\n\n$$\n\\begin{aligned}\\sqrt{4{a}^{4}} &= \\sqrt{(2{a}^{2})^{2}} \\\\ &= |2{a}^{2}| \\\\ &= |2|\\cdot |{a}^{2}| \\\\ &= 2\\cdot |{a}^{2}|\\end{aligned}\n$$\n\nA squared number is always positive or zero, and the absolute value of any positive (or zero) number is itself, so we have\n\n$$\n\\begin{aligned}2\\cdot |{a}^{2}| &= 2\\cdot {a}^{2} \\\\ &= 2{a}^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503701 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f45291e-26c4-5a77-a250-9b4d7159788c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{10A+B}" :db/id #edb/ref 17592186503042} {:answer/id #uuid "a1b3d433-a29b-5881-8391-eb5774e8fd89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{10+AB}" :db/id #edb/ref 17592186503306} {:answer/id #uuid "a38e0637-2b88-5e28-aa89-8f04ee007a5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :