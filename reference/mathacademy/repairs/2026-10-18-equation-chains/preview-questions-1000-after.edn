}-\\sqrt{32÷4+8} &= \\sqrt[3]{-125}-\\sqrt{8+8} \\\\ &= \\sqrt[3]{-125}-\\sqrt{16} \\\\ &= \\sqrt[3]{(-5)\\cdot (-5)\\cdot (-5)}-\\sqrt{4\\cdot 4} \\\\ &= \\sqrt[3]{(-5)^{3}}-\\sqrt{{4}^{2}} \\\\ &= -5-4 \\\\ &= -9\\end{aligned}\n$$"} {:db/id #edb/ref 17592186492039 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42836e12-3199-5792-994a-293af74f2ed1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186491581} {:answer/id #uuid "61738bb0-adff-576e-ab79-4270a837a4b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10.225" :db/id #edb/ref 17592186491628} {:answer/id #uuid "74c48537-34b2-5ccf-ad5e-f4377afc1278" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186491660} {:answer/id #uuid "7c5aa268-63e4-5c47-9891-92a7d1698d23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.292" :db/id #edb/ref 17592186491673} {:answer/id #uuid "95047847-b017-5a0b-95c7-067528cc8d44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10.292" :db/id #edb/ref 17592186491711}] :answer-field/correct {:answer/id #uuid "95047847-b017-5a0b-95c7-067528cc8d44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10.292" :db/id #edb/ref 17592186491711} :answer-field/id #uuid "b57a9137-46c6-56a0-8684-2be92f313fab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491956}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9d8a210d-995e-535a-9fa6-41cb0df374c0" :question/math-academy-id "q-69274" :question/problem "What is the value of $\\sqrt{1+81÷3}-(-8+3)$ rounded to $3$ decimal places?" :question/worked-solution "To simplify the given expression, we use PEMDAS. In terms of the order of operations: \n\n- expressions underneath radicals are treated the same as parentheses\n\n- radicals themselves are treated as exponents\n\nTherefore, following the order of operations, we obtain:\n\n$$\n\\begin{aligned}\\sqrt{1+81÷3}-(-8+3) &= \\sqrt{1+81÷3}-(-5) \\\\ &= \\sqrt{1+27}+5 \\\\ &= \\sqrt{28}+5\\end{aligned}\n$$\n\nNow, we approximate the value of the radical using a calculator:\n\n$$\n\\sqrt{28}≈5‭.291\\,503\n$$\n\nrounded to $6$ decimal places.\n\nFinally, we approximate the value of the expression:\n\n$$\n\\begin{aligned}\\sqrt{28}+5 &≈ ‭‭‭5.291\\,503+5 \\\\ &= 10.291\\,503 \\\\ &≈ 10.292\\end{aligned}\n$$\n\nrounded to $3$ decimal places."} {:db/id #edb/ref 17592186492848 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11a9a132-bbd3-56be-adc6-9533d084b6e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49{w}^{2}-20w+16" :db/id #edb/ref 17592186492248} {:answer/id #uuid "3447384d-9ecf-572f-8792-7b3d981567eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49{w}^{2}-16" :db/id #edb/ref 17592186492326} {:answer/id #uuid "46caea5b-a2f6-5db9-b407-dc210ac19aaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49{w}^{2}-10w+16" :db/id #edb/ref 17592186492358} {:answer/id #uuid "a3c7e7dc-f643-5b4e-b56d-495a7442aa92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49{w}^{2}+20w+16" :db/id #edb/ref 17592186492546} {:answer/id #uuid "bdf1dae4-c035-5207-86e5-e426c6896c0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49{w}^{2}+16" :db/id #edb/ref 17592186492596}] :answer-field/correct {:answer/id #uuid "3447384d-9ecf-572f-8792-7b3d981567eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49{w}^{2}-16" :db/id #edb/ref 17592186492326} :answer-field/id #uuid "49a31005-f7ac-5156-8bbe-2b2e28da6848" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492733}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "33f90fc9-0783-587e-8fb0-ea53809ed85b" :question/math-academy-id "q-52169" :question/problem "$(7w-4)(7w+4)=$" :question/worked-solution "We will use the difference of squares formula:\n\n$$\n(a+b)(a-b)={a}^{2}-{b}^{2}\n$$\n\nSubstituting $a=7w$ and $b=4,$ we have\n\n$$\n\\begin{aligned}(7w-4)(7w+4) &= (7w)^{2}-{4}^{2} \\\\ &= 49{w}^{2}-16.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186492854 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d45f977-a56a-5280-89d6-5518e60df5dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186492275} {:answer/id #uuid "59218a65-4882-5870-b7c8-86f2679e51b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186492393} {:answer/id #uuid "9f2ed906-57e2-5ab3-bd06-a081c49eed93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "41" :db/id #edb/ref 17592186492529} {:answer/id #uuid "a1b41a41-e6b5-57fd-8c0d-4ddb0799752c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186492540} {:answer/id #uuid "b55f6a79-05b0-5b79-92d7-0fdbb4341b3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "29" :db/id #edb/ref 17592186492581}] :answer-field/correct {:answer/id #uuid "a1b41a41-e6b5-57fd-8c0d-4ddb0799752c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186492540} :answer-field/id #uuid "eb93eac8-5e68-5a3c-9c7e-30e76a8c37ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492807}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "42db367f-fca9-5107-a4d2-7795dc6e4fc0" :question/math-academy-id "q-103235" :question/problem "Evaluate $|{x}^{2}|-2|x|+6$ for $x=-5.$" :question/worked-solution "We substitute $x=-5$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|{x}^{2}|-2|x|+6 &= |(-5)^{2}|-2|-5|+6 \\\\ &= |25|-2(5)+6 \\\\ &= 25-10+6 \\\\ &= 21\\end{aligned}\n$$"} {:db/id #edb/ref 17592186492855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fde7be7-c167-5669-9a0e-b5b44e3f124c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186492280} {:answer/id #uuid "54f5373f-0023-5804-abbc-0d46f9f86a86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186492378} {:answer/id #uuid "693a8a82-a0bc-5675-8d14-e1888aae079e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186492426} {:answer/id #uuid "b3421362-8e23-5e85-ae83-5b52d5e44df5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186492575} {:answer/id #uuid "e01edf29-ecf9-53cc-bc5d-84c6e77d2648" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186492652}] :answer-field/correct {:answer/id #uuid "e01edf29-ecf9-53cc-bc5d-84c6e77d2648" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186492652} :answer-field/id #uuid "cef39244-d4ac-5c09-b904-ef69c6554e61" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492789}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "46b75057-d4db-5536-a016-1c597f33ff13" :question/math-academy-id "q-25403" :question/problem "If $x=-9$ then $-|x-12|+7=$" :question/worked-solution "We substitute $x=-9$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}-|x-12|+7 &= -|-9-12|+7 \\\\ &= -|-21|+7 \\\\ &= -21+7 \\\\ &= -14\\end{aligned}\n$$"} {:db/id #edb/ref 17592186492867 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dab20d8-435c-5874-9820-b9c7777aa63b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186492238} {:answer/id #uuid "23606116-0c3d-57f4-9d18-6b22a6023384" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186492290} {:answer/id #uuid "a1fdf384-9dc0-54c1-8ead-ad298d903b8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186492542} {:answer/id #uuid "cabd6727-7e51-5b45-af79-5c74ca0fead2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186492621} {:answer/id #uuid "fb1e9546-e023-51f6-b4d3-475e7aee4ad8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186492700}] :answer-field/correct {:answer/id #uuid "0dab20d8-435c-5874-9820-b9c7777aa63b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186492238} :answer-field/id #uuid "cc5e42ce-3f11-5ff2-b5ec-1401d70485f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492787}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "63dd321a-10a4-552c-a65d-35ddf70e7775" :question/math-academy-id "q-61447" :question/problem "If $x=-2$ then $|x+3|-|3x-1|+x=$" :question/worked-solution "We substitute $x=-2$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|x+3|-|3x-1|+x &= |-2+3|-|3(-2)-1|+(-2) \\\\ &= |1|-|-6-1|-2 \\\\ &= |1|-|-7|-2 \\\\ &= 1-7-2 \\\\ &= -8\\end{aligned}\n$$"} {:db/id #edb/ref 17592186492909 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51adf9ba-7d77-5e07-9003-ad27a96bdcac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{k}^{2m}+5" :db/id #edb/ref 17592186492373} {:answer/id #uuid "61d76e6c-c1dd-58ac-aa25-215aafd382c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{k}^{m}-5" :db/id #edb/ref 17592186492415} {:answer/id #uuid "7365dd6a-4ad2-587b-b7f1-820e11f5f06f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{k}^{2m}-5" :db/id #edb/ref 17592186492447} {:answer/id #uuid "a46ed410-3c39-592c-9c9d-b33b33a4edbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{k}^{2m}+\\sqrt{5}" :db/id #edb/ref 17592186492549} {:answer/id #uuid "ae58ba3b-6b4e-5ca7-97a8-b167bcc4b7f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{k}^{m}+\\sqrt{5}" :db/id #edb/ref 17592186492566}] :answer-field/correct {:answer/id #uuid "7365dd6a-4ad2-587b-b7f1-820e11f5f06f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{k}^{2m}-5" :db/id #edb/ref 17592186492447} :answer-field/id #uuid "9f69e280-5ee5-5da5-b875-931b7eef7051" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492768}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c1188285-b76b-5dfe-bc37-680ab9486187" :question/math-academy-id "q-78928" :question/problem "$({k}^{m}+\\sqrt{5})({k}^{m}-\\sqrt{5})=$" :question/worked-solution "We will use the difference of squares formula:\n\n$$\n(a+b)(a-b)={a}^{2}-{b}^{2}\n$$\n\nSubstituting $a={k}^{m}$ and $b=\\sqrt{5},$ we have \n\n$$\n\\begin{aligned}({k}^{m}+\\sqrt{5})({k}^{m}-\\sqrt{5}) &= ({k}^{m})^{2}-(\\sqrt{5})^{2} \\\\ &= {k}^{2m}-5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493892 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cbd15cf-50e0-5f6c-a023-66b7777a5ea1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186493467}] :answer-field/correct {:answer/id #uuid "2cbd15cf-50e0-5f6c-a023-66b7777a5ea1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186493467} :answer-field/id #uuid "77156935-a293-5f77-b17e-01ad81fabeda" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493837}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "03b02208-a47d-5484-9a1d-0e9d1a5e06da" :question/math-academy-id "q-186156" :question/problem "Evaluate the following:\n\n$\\sqrt[3]{\\frac{125}{8}}=$\n{{field-1}}" :question/worked-solution "First, notice that the numbers $125$ and $8$ are both perfect cubes. \n\nSo, to determine the value of $\\sqrt[3]{\\frac{125}{8}},$ we express $\\frac{125}{8}$ as a perfect cube:\n\n$$\n\\begin{aligned}\\sqrt[3]{\\frac{125}{8}} &= \\sqrt[3]{\\frac{{5}^{3}}{{2}^{3}}} \\\\ &= \\sqrt[3]{\\frac{5\\cdot 5\\cdot 5}{2\\cdot 2\\cdot 2}} \\\\ &= \\sqrt[3]{\\frac{5}{2}\\cdot \\frac{5}{2}\\cdot \\frac{5}{2}} \\\\ &= \\sqrt[3]{{(\\frac{5}{2})}^{3}} \\\\ &= \\frac{5}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493893 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45d6a08d-6d7d-5529-8bdc-d6d7908e4abe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9{w}^{2}{t}^{2}}{16}" :db/id #edb/ref 17592186493508} {:answer/id #uuid "585705f5-55b8-5e41-8d82-25afa8aca06f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3w{t}^{2}}{64}" :db/id #edb/ref 17592186493528} {:answer/id #uuid "7c68b2cf-a842-5b65-883c-8a300658d216" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9{w}^{2}{t}^{2}}{64}" :db/id #edb/ref 17592186493581} {:answer/id #uuid "9f00d4c0-64d1-5a27-99b5-9446d2472496" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{w}^{2}{t}^{2}}{16}" :db/id #edb/ref 17592186493641} {:answer/id #uuid "b7d8c84f-7912-54d2-9d1a-a6a45984a651" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6w{t}^{2}}{64}" :db/id #edb/ref 17592186493690}] :answer-field/correct {:answer/id #uuid "7c68b2cf-a842-5b65-883c-8a300658d216" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9{w}^{2}{t}^{2}}{64}" :db/id #edb/ref 17592186493581} :answer-field/id #uuid "7738ffa0-90e5-5f35-a40f-b6600bc5cc7c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493838}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0ada8c79-b2a0-5a2c-836a-ac533831ba5c" :question/math-academy-id "q-51810" :question/problem "${(\\frac{3wt}{8})}^{2}=$" :question/worked-solution "First, we apply the power of quotient rule:\n\n$$\n\\begin{aligned}{(\\frac{3wt}{8})}^{2}=\\frac{(3wt)^{2}}{{8}^{2}}\\end{aligned}\n$$\n\nThen, we apply the power of product rule:\n\n$$\n\\begin{aligned}\\frac{(3wt)^{2}}{{8}^{2}} &= \\frac{{3}^{2}{w}^{2}{t}^{2}}{{8}^{2}} \\\\ &= \\frac{9{w}^{2}{t}^{2}}{64}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493895 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05f097c2-d349-566d-b1a7-de1e08a5e932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{s}^{2}}{{t}^{4}}" :db/id #edb/ref 17592186493399} {:answer/id #uuid "5835df03-1013-5074-bc17-921ef4066c19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{s}^{2}}{2{t}^{4}}" :db/id #edb/ref 17592186493526} {:answer/id #uuid "77d79dfc-932a-53e0-932b-d5746983cdec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{s}^{4}}{4{t}^{2}}" :db/id #edb/ref 17592186493571} {:answer/id #uuid "81552270-b895-5d9c-aa3e-247dcc5c61c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8{s}^{4}}{{t}^{2}}" :db/id #edb/ref 17592186493594} {:answer/id #uuid "d19d7351-db8e-5855-b293-25857ae699e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{s}^{4}}{{t}^{2}}" :db/id #edb/ref 17592186493724}] :answer-field/correct {:answer/id #uuid "d19d7351-db8e-5855-b293-25857ae699e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{s}^{4}}{{t}^{2}}" :db/id #edb/ref 17592186493724} :answer-field/id #uuid "b1dcbc3c-c562-52fc-969a-fd133bdc4cdc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493863}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "12eb7643-9611-58a5-926c-4abbb115bd9f" :question/math-academy-id "q-72635" :question/problem "${(\\frac{s}{2})}^{4}{(\\frac{4}{t})}^{2}=$" :question/worked-solution "We apply the power of quotient rule and simplify:\n\n$$\n\\begin{aligned}{(\\frac{s}{2})}^{4}{(\\frac{4}{t})}^{2} &= \\frac{{s}^{4}}{{2}^{4}}\\cdot \\frac{{4}^{2}}{{t}^{2}} \\\\ &= \\frac{{s}^{4}}{16}\\cdot \\frac{16}{{t}^{2}} \\\\ &= \\frac{16{s}^{4}}{16{t}^{2}} \\\\ &= \\frac{{s}^{4}}{{t}^{2}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493900 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6186a0e8-15ad-5f04-9514-03a897bd46d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186493536} {:answer/id #uuid "79daec01-1bd7-52c2-9729-762b7fa0a1f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186493575} {:answer/id #uuid "7bcf2e2e-64a8-5b8a-80c5-fd2e2740d5d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186493579} {:answer/id #uuid "89b4a778-8744-54f1-9b64-0291ebefd5aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186493606} {:answer/id #uuid "db0402ea-ca02-5133-8b2b-0f9106ee55f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186493735}] :answer-field/correct {:answer/id #uuid "6186a0e8-15ad-5f04-9514-03a897bd46d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186493536} :answer-field/id #uuid "fb22af84-6e18-5551-a3f1-bbcb3eb8cfb6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493889}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "222f2e72-f895-5b79-8f06-000077812dd5" :question/math-academy-id "q-78171" :question/problem "Given that  $({t}^{2}+t+2)({t}^{2}+2t+1)={t}^{4}+a{t}^{3}+b{t}^{2}+ct+2,$ calculate $a+b+c.$" :question/worked-solution "We distribute all three terms of the trinomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}({t}^{2}+t+2)({t}^{2}+2t+1) &= {t}^{2}({t}^{2}+2t+1)+t({t}^{2}+2t+1)+2({t}^{2}+2t+1) \\\\ &= {t}^{4}+2{t}^{3}+{t}^{2}+{t}^{3}+2{t}^{2}+t+2{t}^{2}+4t+2 \\\\ &= {t}^{4}+3{t}^{3}+5{t}^{2}+5t+2\\end{aligned}\n$$\n\nTherefore, $a=3,$ $b=5,$ and $c=5.$ So, \n\n$$\na+b+c=3+5+5=13.\n$$"} {:db/id #edb/ref 17592186493905 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b428a97-41e2-590a-aace-24167e2b3de2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{125}{9{x}^{2}}" :db/id #edb/ref 17592186493409} {:answer/id #uuid "4fe68738-1add-5c51-b2f9-83c9eca8db5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{250}{3}" :db/id #edb/ref 17592186493519} {:answer/id #uuid "7fee2a5e-fafd-50c8-b51c-2713c379fc2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9x}{250}" :db/id #edb/ref 17592186493591} {:answer/id #uuid "ad881ae7-fad5-5cfc-afce-bd920e92937c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9x}{125}" :db/id #edb/ref 17592186493665} {:answer/id #uuid "f31e6fee-19f2-52ae-9c5f-033e7ed7a3be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{125{x}^{2}}" :db/id #edb/ref 17592186493784}] :answer-field/correct {:answer/id #uuid "7fee2a5e-fafd-50c8-b51c-2713c379fc2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9x}{250}" :db/id #edb/ref 17592186493591} :answer-field/id #uuid "55b1ecfe-bba9-59e4-a0d9-5e7720e663f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493824}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2b75a1b6-f44a-5a5a-8342-d11fe3f5f88d" :question/math-academy-id "q-72638" :question/problem "${(\\frac{3}{4x})}^{2}{(\\frac{-2x}{5})}^{3}=$" :question/worked-solution "First, we apply the power of quotient rule:\n\n$$\n\\begin{aligned}{(\\frac{3}{4x})}^{2}{(\\frac{-2x}{5})}^{3}=\\frac{{3}^{2}}{(4x)^{2}}\\cdot \\frac{(-2x)^{3}}{{5}^{3}}\\end{aligned}\n$$\n\nNext, we apply the power of product rule and multiply:\n\n$$\n\\begin{aligned}\\frac{{3}^{2}}{(4x)^{2}}\\cdot \\frac{(-2x)^{3}}{{5}^{3}} &= \\frac{{3}^{2}}{{4}^{2}{x}^{2}}\\cdot \\frac{(-2)^{3}{x}^{3}}{{5}^{3}} \\\\ &= \\frac{9}{16{x}^{2}}\\cdot \\frac{-8{x}^{3}}{125} \\\\ &= \\frac{-8\\cdot 9{x}^{3}}{16\\cdot 125{x}^{2}}\\end{aligned}\n$$\n\nFinally, we apply the quotient rule and simplify:\n\n$$\n\\begin{aligned}\\frac{-8\\cdot 9{x}^{3}}{16\\cdot 125{x}^{2}} &= -\\frac{9{x}^{3-2}}{2\\cdot 125} \\\\ &= -\\frac{9x}{250}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493913 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0306dc06-62f4-5b7e-b879-3f9511d72369" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{a}^{3}{c}^{3}}{{b}^{3}{d}^{3}}" :db/id #edb/ref 17592186493395} {:answer/id #uuid "4223f171-c54d-5992-b8eb-283452e403f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{a}^{3}{c}^{2}}{{b}^{3}{d}^{2}}" :db/id #edb/ref 17592186493503} {:answer/id #uuid "5bdac1e5-fa32-5ec5-b843-e3fd6cca8bcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{a}^{2}{c}^{2}}{{b}^{2}{d}^{2}}" :db/id #edb/ref 17592186493532} {:answer/id #uuid "a25282c7-8210-5ec4-8b82-539d7cd1e52c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{a}^{3}{d}^{2}}{{b}^{3}{c}^{2}}" :db/id #edb/ref 17592186493648} {:answer/id #uuid "d98dcd18-7738-5d61-a167-5958e7f35e79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{a}^{3}{c}^{2}}{{b}^{3}{d}^{2}}" :db/id #edb/ref 17592186493729}] :answer-field/correct {:answer/id #uuid "4223f171-c54d-5992-b8eb-283452e403f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{a}^{3}{c}^{2}}{{b}^{3}{d}^{2}}" :db/id #edb/ref 17592186493503} :answer-field/id #uuid "b9c9de44-c1c6-51ff-85d8-62b2b5e04b65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493869}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3cbc76cf-73cd-53cf-89d7-15a5f1f46f2b" :question/math-academy-id "q-22532" :question/problem "${(-\\frac{a}{b})}^{3}{(\\frac{c}{d})}^{2}=$" :question/worked-solution "We apply the power of quotient rule and simplify:\n\n$$\n\\begin{aligned}{(-\\frac{a}{b})}^{3}{(\\frac{c}{d})}^{2} &= \\frac{(-a)^{3}}{{b}^{3}}\\cdot \\frac{{c}^{2}}{{d}^{2}} \\\\ &= \\frac{-{a}^{3}}{{b}^{3}}\\cdot \\frac{{c}^{2}}{{d}^{2}} \\\\ &= -\\frac{{a}^{3}{c}^{2}}{{b}^{3}{d}^{2}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493916 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12992113-2342-5279-9f39-93240a16d420" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186493424} {:answer/id #uuid "96d4b2d0-aff1-5142-9b3d-ae023cf3bdf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186493628} {:answer/id #uuid "9f727f0d-4e72-5891-b43a-44489bd73c19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186493642} {:answer/id #uuid "b594613f-b609-5d9f-b507-7ed04d8bb283" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186493685} {:answer/id #uuid "e4eed5e2-fde8-5761-9397-e3a699b2d564" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186493754}] :answer-field/correct {:answer/id #uuid "12992113-2342-5279-9f39-93240a16d420" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186493424} :answer-field/id #uuid "ae7bcc7d-7b8b-541d-a96a-a62bcd62870a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493861}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4227b37a-8e18-5afd-83bf-26143e32cd4d" :question/math-academy-id "q-68842" :question/problem "$2÷\\frac{2}{5}\\times 4=$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nWe divide and multiply, from left to right:\n\n$$\n\\begin{aligned}2÷\\frac{2}{5}\\times 4 &= (2÷\\frac{2}{5})\\times 4 \\\\ &= (2\\times \\frac{5}{2})\\times 4 \\\\ &= (\\frac{2}{1}\\times \\frac{5}{2})\\times 4 \\\\ &= \\frac{2\\times 5}{1\\times 2}\\times 4 \\\\ &= \\frac{\\cancel{2}\\times 5}{1\\times \\cancel{2}}\\times 4 \\\\ &= 5\\times 4 \\\\ &= 20\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493945 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa5916f5-b95b-5530-9d9f-19d0168e2209" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186493658}] :answer-field/correct {:answer/id #uuid "aa5916f5-b95b-5530-9d9f-19d0168e2209" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186493658} :answer-field/id #uuid "f90a68c7-dc57-5362-b958-0dc11f3f0c40" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493888}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "aafcb24f-fde2-52b2-b44a-c7d7fddbc683" :question/math-academy-id "q-186155" :question/problem "Evaluate the following:\n\n$\\sqrt[3]{\\frac{27}{8}}=$\n{{field-1}}" :question/worked-solution "First, notice that the numbers $27$ and $8$ are both perfect cubes. \n\nSo, to determine the value of $\\sqrt[3]{\\frac{27}{8}},$ we express $\\frac{27}{8}$ as a perfect cube:\n\n$$\n\\begin{aligned}\\sqrt[3]{\\frac{27}{8}} &= \\sqrt[3]{\\frac{{3}^{3}}{{2}^{3}}} \\\\ &= \\sqrt[3]{\\frac{3\\cdot 3\\cdot 3}{2\\cdot 2\\cdot 2}} \\\\ &= \\sqrt[3]{\\frac{3}{2}\\cdot \\frac{3}{2}\\cdot \\frac{3}{2}} \\\\ &= \\sqrt[3]{{(\\frac{3}{2})}^{3}} \\\\ &= \\frac{3}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493958 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c7ca818-f28b-5d60-b216-a2e87b1e5db2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8.8" :db/id #edb/ref 17592186493494}] :answer-field/correct {:answer/id #uuid "3c7ca818-f28b-5d60-b216-a2e87b1e5db2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8.8" :db/id #edb/ref 17592186493494} :answer-field/id #uuid "c4974698-7ea2-58ec-9b02-4e54bbb36aee" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493873}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c9b4fb98-fcb9-51e9-9d1c-a0e33aad2c53" :question/math-academy-id "q-175320" :question/problem "$(-4)\\times (2.3-0.1)=${{field-1}}" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, we perform the operation inside the parentheses:\n\n$$\n\\begin{aligned}(-4)\\times (2.3-0.1) &= (-4)\\times 2.2\\end{aligned}\n$$\n\nFinally, we multiply:\n\n$$\n\\begin{aligned}(-4)\\times 2.2 & =-8.8\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493960 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6da77181-6032-5e5c-929d-4a017fc0454f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186493553}] :answer-field/correct {:answer/id #uuid "6da77181-6032-5e5c-929d-4a017fc0454f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186493553} :answer-field/id #uuid "5932016c-ec0a-5d79-9f39-b11ee0e695a8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493826}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d4dc1b86-0478-57c7-a48b-3ee42621256c" :question/math-academy-id "q-175957" :question/problem "Expressed as an integer, $(-4)÷(\\frac{2}{5})\\times 6=${{field-1}}" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nWe multiply and divide, from left to right:\n\n$$\n\\begin{aligned}(-4)÷\\frac{2}{5}\\times 6 &= ((-4)÷\\frac{2}{5})\\times 6 \\\\ &= (\\frac{-4}{1}\\times \\frac{5}{2})\\times 6 \\\\ &= (\\frac{(-4)\\times 5}{1\\times 2})\\times 6 \\\\ &= (-\\frac{20}{2})\\times 6 \\\\ &= (-10)\\times 6 \\\\ &= -60\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493963 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1509f49e-da21-5888-a3e2-156f6abd8874" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186493429} {:answer/id #uuid "39d6163e-8a28-5dea-acdf-43f43b916822" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186493487} {:answer/id #uuid "45f89047-5bab-5a07-8abc-c0436c6ee8a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186493509} {:answer/id #uuid "e27c97bd-9bdc-5a82-9295-1903f7e28d23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186493750} {:answer/id #uuid "e8b629bc-bc84-51ab-bcdf-5cf5e9435232" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186493763}] :answer-field/correct {:answer/id #uuid "e27c97bd-9bdc-5a82-9295-1903f7e28d23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186493750} :answer-field/id #uuid "d4c94381-cca8-57b8-bdf5-3cd85a1f90d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493877}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d9aae8a4-653e-5752-9c3b-a882c899846f" :question/math-academy-id "q-78170" :question/problem "Given that  $({p}^{2}+p+1)({p}^{2}+3p+1)={p}^{4}+a{p}^{3}+b{p}^{2}+cp+1,$ calculate $a+b+c.$" :question/worked-solution "We distribute all three terms of the trinomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}({p}^{2}+p+1)({p}^{2}+3p+1) &= {p}^{2}({p}^{2}+3p+1)+p({p}^{2}+3p+1)+1({p}^{2}+3p+1) \\\\ &= {p}^{4}+3{p}^{3}+{p}^{2}+{p}^{3}+3{p}^{2}+p+{p}^{2}+3p+1 \\\\ &= {p}^{4}+4{p}^{3}+5{p}^{2}+4p+1\\end{aligned}\n$$\n\nTherefore, $a=4,$ $b=5,$ and $c=4.$ So, \n\n$$\na+b+c=4+5+4=13.\n$$"} {:db/id #edb/ref 17592186495047 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b1b5fba-fdd8-5128-9a27-cbfb26a9e1c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{5}}{5}" :db/id #edb/ref 17592186494634} {:answer/id #uuid "a519e98f-6574-52d8-8a8c-870b9a1a0093" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{15}}{5}" :db/id #edb/ref 17592186494694} {:answer/id #uuid "aabd3a95-2d4e-5129-96fc-6ea2f3661cd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{15}" :db/id #edb/ref 17592186494712} {:answer/id #uuid "e7a916dc-cd3b-563d-8a31-4a98472fc173" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{30}}{5}" :db/id #edb/ref 17592186494867} {:answer/id #uuid "e7d7cf72-8c4a-588a-92d9-55fa1de43c10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{5}" :db/id #edb/ref 17592186494868}] :answer-field/correct {:answer/id #uuid "a519e98f-6574-52d8-8a8c-870b9a1a0093" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{15}}{5}" :db/id #edb/ref 17592186494694} :answer-field/id #uuid "a8d63188-077b-53b4-bf34-059f17e831ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186494996}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0166b33d-cd65-51f2-b6e7-3a4bfb8c5ea3" :question/math-academy-id "q-68979" :question/problem "$\\frac{\\sqrt{3}}{\\sqrt{5}}=$" :question/worked-solution "To remove the radical $\\sqrt{5}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{5}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{3}}{\\sqrt{5}} &= \\frac{\\sqrt{3}}{\\sqrt{5}}\\cdot \\frac{\\sqrt{5}}{\\sqrt{5}} \\\\ &= \\frac{\\sqrt{3}\\cdot \\sqrt{5}}{(\\sqrt{5})^{2}} \\\\ &= \\frac{\\sqrt{3}\\cdot \\sqrt{5}}{5}\\end{aligned}\n$$\n\nNow, we use the product rule to simplify the numerator:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{3}\\cdot \\sqrt{5}}{5} &= \\frac{\\sqrt{3\\cdot 5}}{5} \\\\ &= \\frac{\\sqrt{15}}{5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186495055 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25e004be-f08e-52db-afcf-7bfb57aca531" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answe