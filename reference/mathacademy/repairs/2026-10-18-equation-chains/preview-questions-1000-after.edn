#edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t+7\\sqrt[3]{2t}" :db/id #edb/ref 17592186501551} {:answer/id #uuid "30d278a9-e551-5555-b465-1a9126efba85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7+5t\\sqrt[3]{2t}" :db/id #edb/ref 17592186501552} {:answer/id #uuid "9da8cfd5-4237-5f1e-9ddc-17c0aa461cd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(t+7)\\sqrt[3]{2t}" :db/id #edb/ref 17592186501760} {:answer/id #uuid "a3012e8a-4fdb-529f-9953-c32624052358" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7(1+t)\\sqrt[3]{2t}" :db/id #edb/ref 17592186501778}] :answer-field/correct {:answer/id #uuid "30d278a9-e551-5555-b465-1a9126efba85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7+5t\\sqrt[3]{2t}" :db/id #edb/ref 17592186501552} :answer-field/id #uuid "9972e5ae-f3d9-5083-8d1b-be6157c6f289" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502030}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b5988724-f4b1-5a52-8719-b7ac5bee89d1" :question/math-academy-id "q-134508" :question/problem "$7-\\sqrt[3]{2{t}^{4}}+6t\\sqrt[3]{2t}=$" :question/worked-solution "We simplify each of the radical terms using the product rule:\n\n$$\n\\begin{aligned}7-\\sqrt[3]{2{t}^{4}}+6t\\sqrt[3]{2t} &= 7-\\sqrt[3]{{t}^{3}\\cdot 2t}+6t\\sqrt[3]{2t} \\\\ &= 7-\\sqrt[3]{{t}^{3}}\\cdot \\sqrt[3]{2t}+6t\\sqrt[3]{2t} \\\\ &= 7-t\\sqrt[3]{2t}+6t\\sqrt[3]{2t}\\end{aligned}\n$$\n\nFinally, we combine the like terms:\n\n$$\n\\begin{aligned}7-t\\sqrt[3]{2t}+6t\\sqrt[3]{2t} &= 7+(-t+6t)\\sqrt[3]{2t} \\\\ &= 7+5t\\sqrt[3]{2t}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186502146 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "248265cd-124a-59ae-9