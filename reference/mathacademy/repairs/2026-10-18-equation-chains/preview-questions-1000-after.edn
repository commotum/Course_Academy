-a6a069a28374" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{{y}^{4}}" :db/id #edb/ref 17592186498752} {:answer/id #uuid "7470470e-9dcb-5cb6-a298-354e8bd306a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[6]{y}" :db/id #edb/ref 17592186498987} {:answer/id #uuid "b150665b-cc55-5a3e-9bc9-352c3cbb62f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[4]{{y}^{3}}" :db/id #edb/ref 17592186499125} {:answer/id #uuid "b33aa548-4b46-5ab9-830b-ffa8ce5ad423" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{y}" :db/id #edb/ref 17592186499130} {:answer/id #uuid "badfdb89-f38f-5c6f-b938-cf0c832948ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[4]{y}" :db/id #edb/ref 17592186499148}] :answer-field/correct {:answer/id #uuid "b150665b-cc55-5a3e-9bc9-352c3cbb62f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[4]{{y}^{3}}" :db/id #edb/ref 17592186499125} :answer-field/id #uuid "2373b85f-68d6-5beb-815d-bde5b1392e92" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499326}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "64c8a090-cafc-5e88-b591-72ecb0cc7b81" :question/math-academy-id "q-142145" :question/problem "Simplify the expression $\\sqrt{y}\\cdot \\sqrt[4]{y}.$" :question/worked-solution "First, we rewrite the radical as a fractional exponent:\n\n$$\n\\begin{aligned}\\sqrt{y}\\cdot \\sqrt[4]{y}={y}^{1/2}\\cdot {y}^{1/4}\\end{aligned}\n$$\n\nThen, we apply the product rule:\n\n$$\n\\begin{aligned}{y}^{1/2}\\cdot {y}^{1/4} &= {y}^{1/2+1/4} \\\\ &= {y}^{3/4}\\end{aligned}\n$$\n\nFinally, we express the result as a radical:\n\n$$\n\\begin{aligned}{y}^{3/4} & =\\sqrt[4]{{y}^{3}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186499500 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f28308b-720b-5df8-a2b3-3f5e70ac4866" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{{y}^{3}}" :db/id #edb/ref 17592186498838} {:answer/id #uuid "3195d9ce-4aa6-599a-be0b-62ab0a5b2c62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{y}" :db/id #edb/ref 17592186498845} {:answer/id #uuid "a28d9916-0048-550e-ab13-3f717c29f173" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{{y}^{5}}" :db/id #edb/ref 17592186499079} {:answer/id #uuid "bd06633e-df0e-50eb-902f-8ff48110959f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[4]{{y}^{5}}" :db/id #edb/ref 17592186499150} {:answer/id #uuid "c48364e6-a284-5fda-a5f7-dfb7c464c310" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[4]{y}" :db/id #edb/ref 17592186499162}] :answer-field/correct {:answer/id #uuid "bd06633e-df0e-50eb-902f-8ff48110959f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[4]{{y}^{5}}" :db/id #edb/ref 17592186499150} :answer-field/id #uuid "f2675a89-c5db-5be6-a863-504dfe78916e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499426}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "842d5936-85a3-5b6e-b4fa-f505a9d0860b" :question/math-academy-id "q-72511" :question/problem "Simplify the expression $y\\cdot \\sqrt[4]{y}.$" :question/worked-solution "First, we rewrite the radical as a fractional exponent:\n\n$$\n\\begin{aligned}y\\cdot \\sqrt[4]{y}=y\\cdot {y}^{1/4}\\end{aligned}\n$$\n\nThen, we apply the product 