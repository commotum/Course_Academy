}{v}^{-3/5})}^{-2/3}=$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}{(27{u}^{6}{v}^{-3/5})}^{-2/3} &= {({3}^{3}{u}^{6}{v}^{-3/5})}^{-2/3} \\\\ &= {({3}^{3})}^{-2/3}\\cdot {({u}^{6})}^{-2/3}\\cdot {({v}^{-3/5})}^{-2/3} \\\\ &= {3}^{3\\cdot (-2/3)}\\cdot {u}^{6\\cdot (-2/3)}\\cdot {v}^{(-3/5)\\cdot (-2/3)} \\\\ &= {3}^{-6/3}\\cdot {u}^{-12/3}\\cdot {v}^{6/15} \\\\ &= {3}^{-2}\\cdot {u}^{-4}\\cdot {v}^{2/5} \\\\ &= \\frac{{v}^{2/5}}{{3}^{2}{u}^{4}} \\\\ &= \\frac{{v}^{2/5}}{9{u}^{4}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186499508 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d432e0b-5e73-5082-9179-2c0e5ce1c203" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{4}{b}^{2}" :db/id #edb/ref 17592186498793} {:answer/id #uuid "3cb1b4cf-3291-5299-99a3-e0138a299fe2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{7}{b}^{4}" :db/id #edb/ref 17592186498869} {:answer/id #uuid "4b251482-3f03-5972-a333-8643986852ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{5}{b}^{2}" :db/id #edb/ref 17592186498905} {:answer/id #uuid "a049de80-4ef4-573d-94a4-648d945c51f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{3}{b}^{2}" :db/id #edb/ref 17592186499070} {:answer/id #uuid "e19aa923-8c4f-59fb-90ad-9fe011b14fc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{7}{b}^{2}" :db/id #edb/ref 17592186499237}] :answer-field/correct {:answer/id #uuid "3cb1b4cf-3291-5299-99a3-e0138a299fe2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{7}{b}^{4}" :db/id #edb/ref 17592186498869} :answer-field/id #uuid "262de599-4be0-58c1-8c31-b5e8da1d1817" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499327}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8bcb7c88-fa9c-5de4-82d6-48872f12ed89" :question/math-academy-id "q-141984" :question/problem "${({a}^{2}b)}^{3}\\cdot ab=$" :question/worked-solution "We start by using the power of product rule:\n\n$$\n\\begin{aligned}{({a}^{2}b)}^{3}\\cdot ab=({a}^{2})^{3}\\cdot {b}^{3}\\cdot ab & \\end{aligned}\n$$\n\nThen, we use the power rule:\n\n$$\n\\begin{aligned}({a}^{2})^{3}\\cdot {b}^{3}\\cdot ab &= {a}^{2\\cdot 3}\\cdot {b}^{3}\\cdot ab \\\\ &= {a}^{6}\\cdot {b}^{3}\\cdot ab\\end{aligned}\n$$\n\nFinally, we use the product rule:\n\n$$\n\\begin{aligned}{a}^{6}\\cdot {b}^{3}\\cdot ab &= ({a}^{6}\\cdot a)\\cdot ({b}^{3}\\cdot b) \\\\ &= {a}^{6+1}\\cdot {b}^{3+1} \\\\ &= {a}^{7}\\cdot {b}^{4} \\\\ &= {a}^{7}{b}^{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186499514 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "190ab1b2-874e-5bb3-a0ed-b02168022ef8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{49}{{x}^{3}}" :db/id #edb/ref 17592186498784} {:answer/id #uuid "56bb8639-a83b-5c9f-bd37-2d2900c18393" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{{x}^{3}}" :db/id #edb/ref 17592186498927} {:answer/id #uuid "5d92a4cf-c350-5c03-8652-d25b59a9ea08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49{x}^{10}" :db/id #edb/ref 17592186498944} {:answer/id #uuid "a35a3d2b-2936-57a9-91bf-b88b9ea4ee2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{49}{{x}^{10}}" :db/id #edb/ref 17592186499083} {:answer/id #uuid "de2b212e-5da9-515f-8bd1-2141c6761d88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{{x}^{10}}" :db/id #edb/ref 17592186499224}] :answer-field/correct {:answer/id #uuid "a35a3d2b-2936-57a9-91bf-b88b9ea4ee2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{49}{{x}^{10}}" :db/id #edb/ref 17592186499083} :answer-field/id #uuid "bcd19327-ff40-5dae-b2cf-088be8eeca6b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499399}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "997d06ae-bfea-5bdd-ad34-25a8461aee43" :question/math-academy-id "q-72553" :question/problem "Which of the following is equivalent to ${(7{x}^{-5})}^{2}?$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}{(7{x}^{-5})}^{2} &= {7}^{2}{({x}^{-5})}^{2} \\\\ &= 49\\cdot {x}^{-5\\cdot 2} \\\\ &= 49{x}^{-10} \\\\ &= \\frac{49}{{x}^{10}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186499517 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01a0d9e9-f16f-5e35-91eb-3bd865760ce9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-{x}^{8}{y}^{-3}}{6}" :db/id #edb/ref 17592186498733} {:answer/id #uuid "45914d4a-b895-5bc8-a1de-5a3d97104256" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{6}{y}^{-3}}{6}" :db/id #edb/ref 17592186498891} {:answer/id #uuid "49c8eea6-1485-5196-a051-14e2a91ed557" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{6}{y}^{-3}}{8}" :db/id #edb/ref 17592186498901} {:answer/id #uuid "d3a6ab37-02d3-5559-97f9-826e50636e02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{8}{y}^{3}}{6}" :db/id #edb/ref 17592186499201} {:answer/id #uuid "e19915ad-81b9-58ed-9cd8-716103a6d691" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-{x}^{6}{y}^{-3}}{8}" :db/