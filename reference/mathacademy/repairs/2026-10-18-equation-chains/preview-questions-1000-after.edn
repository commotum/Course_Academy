f 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{{y}^{34}}" :db/id #edb/ref 17592186499126}] :answer-field/correct {:answer/id #uuid "7c464b8a-119e-51a8-ab64-abc53812e731" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{{y}^{20}}" :db/id #edb/ref 17592186499008} :answer-field/id #uuid "d8df651f-f104-583c-9836-0f9f71da1bc3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499415}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "af52435b-8d7b-5fb6-b052-723de06fafd6" :question/math-academy-id "q-104671" :question/problem "Simplify the expression $\\frac{{y}^{9}}{\\sqrt[3]{{y}^{7}}}.$" :question/worked-solution "First, we rewrite the radical as a fractional exponent:\n\n$$\n\\begin{aligned}\\frac{{y}^{9}}{\\sqrt[3]{{y}^{7}}}=\\frac{{y}^{9}}{{({y}^{7})}^{1/3}}\\end{aligned}\n$$\n\nNow, we apply the power rule for exponents:\n\n$$\n\\frac{{y}^{9}}{{({y}^{7})}^{1/3}}=\\frac{{y}^{9}}{{y}^{7(1/3)}}=\\frac{{y}^{9}}{{y}^{7/3}}\n$$\n\nThen, we apply the quotient rule:\n\n$$\n\\begin{aligned}\\frac{{y}^{9}}{{y}^{7/3}} &= {y}^{9-7/3} \\\\ &= {y}^{20/3}\\end{aligned}\n$$\n\nFinally, we express the result as a radical:\n\n$$\n\\begin{aligned}{y}^{20/3} & =\\sqrt[3]{{y}^{20}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186499549 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "465a9a31-c9a7-5242-b06e-83d1de732242" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{u}^{10}}{32{v}^{20}}" :db/id #edb/ref 17592186498892} {:answer/id #uuid "4ea53a6a-43cc-5424-b0c0-f4959baa4754" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{u}^{7}}{32{v}^{9}}" :db/id #edb/ref 17592186498913} {:answer/id #uuid "6842d70f-c788-545a-96c5-2eb791e9c865" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{u}^{5}}{16{v}^{5}}" :db/id #edb/ref 17592186498965} {:answer/id #uuid "a8cdef2e-ff7f-5848-8193-597d13abef49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{u}^{6}}{8{v}^{12}}" :db/id #edb/ref 17592186499100} {:answer/id #uuid "cc5a67c3-eb72-52e8-8d6e-906807a56f0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{u}^{10}}{2{v}^{20}}" :db/id #edb/ref 17592186499182}] :answer-field/correct {:answer/id #uuid "465a9a31-c9a7-5242-b06e-83d1de732242" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{u}^{10}}{32{v}^{20}}" :db/id #edb/ref 17592186498892} :answer-field/id #uuid "e4acd8be-661d-5d96-83bb-5a718612e8be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499418}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e0110074-4c62-517f-b5cb-ff4cff4e0579" :question/math-academy-id "q-22838" :question/problem "Which of the following is equivalent to ${(\\frac{{u}^{2}}{-2{v}^{4}})}^{5}?$" :question/worked-solution "We start by using the power of quotient rule:\n\n$$\n\\begin{aligned}{(\\frac{{u}^{2}}{-2{v}^{4}})}^{5} &= \\frac{{({u}^{2})}^{5}}{{(-2{v}^{4})}^{5}}\\end{aligned}\n$$\n\nThen, we apply the power rule in the numerator and the power of product rule in the denominator:\n\n$$\n\\begin{aligned}\\frac{{({u}^{2})}^{5}}{{(-2{v}^{4})}^{5}} &= \\frac{{u}^{2\\cdot 5}}{(-2)^{5}\\cdot {({v}^{4})}^{5}} \\\\ &= \\frac{{u}^{10}}{(-2)^{5}\\cdot {({v}^{4})}^{5}}\\end{aligned}\n$$\n\nFinally, we apply the power rule for exponents:\n\n$$\n\\begin{aligned}\\frac{{u}^{10}}{(-2)^{5}\\cdot {({v}^{4})}^{5}} &= \\frac{{u}^{10}}{(-2)^{5}\\cdot {v}^{4\\cdot 5}} \\\\ &= \\frac{{u}^{10}}{(-32)\\cdot {v}^{20}} \\\\ &= -\\frac{{u}^{10}}{32{v}^{20}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186500312 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "492942ee-22f4-59db-934a-e22733b6184d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5t-4)(t+1)" :db/id #edb/ref 17592186499791} {:answer/id #uuid "52b70ec8-bf60-5ca2-9500-bf2667045ba3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5(t+2)(t-2)" :db/id #edb/ref 17592186499811} {:answer/id #uuid "9b86139f-59b5-5233-bc2a-d13f5dba4489" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5(t-4)(t+1)" :db/id #edb/ref 17592186499955} {:answer/id #uuid "b9e27368-2343-5732-958d-8a429ac47df7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5t+2)(t-2)" :db/id #edb/ref 17592186500034} {:answer/id #uuid "ef378e59-9ad9-542b-aa16-7399d5fbff76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5(t+4)(t-1)" :db/id #edb/ref 17592186500147}] :answer-field/correct {:answer/id #uuid "9b86139f-59b5-5233-bc2a-d13f5dba4489" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5(t-4)(t+1)" :db/id #edb/ref 17592186499955} :answer-field/id #uuid "94c06265-2366-51a7-b0d0-03e55f741385" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186500238}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "51a9e6b4-a8d3-5a57-a795-b4c3e7575128" :question/math-academy-id "q-2855" :question/problem "$5{t}^{2}-15t-20=$" :question/worked-solution "First, notice that we can factor out $5$ from each of the terms:\n\n$$\n\\begin{aligned}5{t}^{2}-15t-20 & =5({t}^{2}-3t-4)\\end{aligned}\n$$\n\nNow, we just need to factor the polynomial ${t}^{2}-3t-4$ in parentheses.\n\nFirst, we find the factor pairs of the constant term $(-4).$ The constant term is negative, so that means one of the factors is negative and the other is positive:\n\n$$\n\\begin{aligned}1 & \\times (-4) \\\\ (-1) & \\times 4 \\\\ 2 & \\times (-2)\\end{aligned}\n$$\n\nNow, we find which factor pair adds up to the coefficient of the linear term $(-3):$\n\n$$\n\\begin{aligned}1+(-4) & =-3 & ✓ \\\\ (-1)+4 & =3 & \\times  \\\\ 2+(-2) & =0 & \\times \\end{aligned}\n$$\n\nUsing the factor pair identified above, we write the linear term as $-3t=t-4t$ and then factor:\n\n$$\n\\begin{aligned}{t}^{2}-3t-4 &= {t}^{2}+t-4t-4 \\\\ &= ({t}^{2}+t)+(-4t-4) \\\\ &= t(t+1)-4(t+1) \\\\ &= (t-4)(t+1)\\end{aligned}\n$$\n\nTherefore, our original expression factors as follows:\n\n$$\n\\begin{aligned}5({t}^{2}-3t-4) & =5(t-4)(t+1)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186500320 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b107508-c497-5022-876e-eecbf2e11f49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186499830} {:answer/id #uuid "7f090948-7631-5696-93e9-27c3f569baa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186499894} {:answer/id #uuid "9bdcfe25-e05c-5e4e-b69a-8716e49777a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186499956} {:answer/id #uuid "a936416f-f189-5f46-bd0f-f7f48beaf553" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186499984} {:answer/id #uuid "d3062eb8-1be4-55c1-abe5-0531007f28e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186500087}] :answer-field/correct {:answer/id #uuid "7f090948-7631-5696-93e9-27c3f569baa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186499894} :answer-field/id #uuid "06764b2b-0fcb-5201-9043-354b15b5afa9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186500181}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7598e646-e70e-5042-8a78-36ec6c081791" :question/math-academy-id "q-32107" :question/problem "If $5{b}^{2}-15b+10=5(b+p)(b+q),$ then $p+q=$" :question/worked-solution "First, notice that we can factor out $5$ from each of the terms:\n\n$$\n\\begin{aligned}5{b}^{2}-15b+10 & =5({b}^{2}-3b+2)\\end{aligned}\n$$\n\nNow, we just need to factor the polynomial ${b}^{2}-3b+2$ in parentheses.\n\nWe start by listing the factor pairs of the constant term $(2).$ We will want to find the factor pair that also adds up to the coefficient of the linear term $(-3),$ so we will consider the negative factor pairs in particular:\n\n$$\n\\begin{aligned}(-1) & \\times (-2)\\end{aligned}\n$$\n\nNow, we find which factor pair adds up to the coefficient of the linear term $(-3):$\n\n$$\n\\begin{aligned}(-1)+(-2) & =-3 & ✓\\end{aligned}\n$$\n\nUsing the factor pair identified above, we write the linear term as $-3b=-b-2b$ and then factor:\n\n$$\n\\begin{aligned}{b}^{2}-3b+2 &= {b}^{2}-b-2b+2 \\\\ &= ({b}^{2}-b)+(-2b+2) \\\\ &= b(b-1)-2(b-1) \\\\ &= (b-2)(b-1)\\end{aligned}\n$$\n\nTherefore, our original expression factors as follows:\n\n$$\n\\begin{aligned}5({b}^{2}-3b+2) & =5(b-2)(b-1)\\end{aligned}\n$$\n\nHence, $p=-2,q=-1,$ and $p+q=-3.$"} {:db/id #edb/ref 17592186500345 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0472e445-7f02-503d-8b15-9cb91772ed43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3(x+2)(x-1)" :db/id #edb/ref 17592186499659} {:answer/id #uuid "7be4e3a3-34cb-572b-8974-2b87a20cfbb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3(x-2)(x+1)" :db/id #edb/ref 17592186499886} {:answer/id #uuid "9c579a24-2a9d-597c-bcee-586175e4ecd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+2)(x-3)" :db/id #edb/ref 17592186499957} {:answer/id #uuid "ae8abbbd-95f4-5109-a120-3ff6ea915413" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-(3x-2)(x+1)" :db/id #edb/ref 17592186500003} {:answer/id #uuid "b601254e-067f-525c-b190-c1e96f078bfd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3x+2)(x-1)" :db/id #edb/ref 17592186500025}] :answer-field/correct {:answer/id #uuid "0472e445-7f02-503d-8b15-9cb91772ed43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3(x+2)(x-1)" :db/id #edb/ref 17592186499659} :answer-field/id #uuid "37ecc6ff-8871-56b2-aab9-81dfb39a048c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186500206}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b8115771-d0c0-58ad-81dd-b9545f4b8d28" :question/math-academy-id "q-80173" :question/problem "Factor $6-3x-3{x}^{2}.$" :question/worked-solution "First, notice that we can factor out a $(-3)$ from each of the terms:\n\n$$\n\\begin{aligned}6-3x-3{x}^{2} & =-3({x}^{2}+x-2)\\end{aligned}\n$$\n\nNow, we just need to factor the polynomial ${x}^{2}+x-2$ in parentheses.\n\nWe start by listing the factor pairs of the constant term $(-2).$ The constant term is negative, so that means one of the factors is negative and the other is positive:\n\n$$\n\\begin{aligned}1 & \\times (-2) \\\\ (-1) & \\times 2\\end{aligned}\n$$\n\nNow, we find which factor pair adds up to the coefficient of the linear term $(1):$\n\n$$\n\\begin{aligned}1+(-2) & =-1 & \\times  \\\\ (-1)+(2) & =1 & ✓\\end{aligned}\n$$\n\n \n\nUsing the factor pair identified above, we write the linear term as $x=-x+2x$ and then factor:\n\n$$\n\\begin{aligned}-3({x}^{2}+x-2) &= -3({x}^{2}-x+2x-2) \\\\ &= -3(({x}^{2}-x)+(2x-2)) \\\\ &= -3(x(x-1)+2(x-1)) \\\\ &= -3(x+2)(x-1)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186501137 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25d10642-3f32-5349-83fc-e6491cc2d7d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q" :db/id #edb/ref 17592186500541} {:answer/id #uuid "a45a06ff-3e53-5c5d-9d54-bac4613fd44b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(p+q)x" :db/id #edb/ref 17592186500798} {:answer/id #uuid "a596a05b-b96c-562c-ac17-a124fcdf385a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(p+q)\\sqrt{x}" :db/id #edb/ref 17592186500807} {:answer/id #uuid "c24d2f73-41ea-580c-a26c-a3767f056a4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "pq" :db/id #edb/ref 17592186500871} {:answer/id #uuid "cecc8a16-5543-50aa-aace-6409797f0f81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "pq\\sqrt{x}" :db/id #edb/ref 17592186500910}] :answer-field/correct {:answer/id #uuid "a596a05b-b96c-562c-ac17-a124fcdf385a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(p+q)\\sqrt{x}" :db/id #edb/ref 17592186500807} :answer-field/id #uuid "5999d2a9-f36a-5f69-8e3a-9981b335b405" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501054}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "07885ed6-fd3c-5e89-9b4b-974d90f1b3c9" :question/math-academy-id "q-52394" :question/problem "$p\\sqrt{x}+q\\sqrt{x}=$" :question/worked-solution "We can combine the two $\\sqrt{x}$ terms together, as follows:\n\n$$\n\\begin{aligned}p\\sqrt{x}+q\\sqrt{x} &= p\\cdot \\sqrt{x}+q\\cdot \\sqrt{x} \\\\ &= (p+q)\\sqrt{x}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186501139 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2151c7cd-e6ab-52e8-9366-584c9ea7f941" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{r}^{2}\\sqrt{r}" :db/id #edb/ref 17592186500536} {:answer/id #uuid "321221f6-baac-50eb-978c-4a7948aff069" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5|r|\\sqrt{5r}" :db/id #edb/ref 17592186500572} {:answer/id #uuid "644eff91-0f4b-5176-bf9d-5c3031d27583" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{r}^{2}\\sqrt{5r}" :db/id #edb/ref 17592186500677} {:answer/id #uuid "7813cfa6-4b6c-57be-975c-44d185242f6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|r|\\sqrt{5r}" :db/id #edb/ref 17592186500717} {:answer/id #uuid "9ca20a89-e601-5fc3-8b5a-f7ecb7cc0938" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5|r|\\sqrt{r}" :db/id #edb/ref 17592186500783}] :answer-field/correct {:answer/id #uuid "9ca20a89-e601-5fc3-8b5a-f7ecb7cc0938" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5|r|\\sqrt{r}" :db/id #edb/ref 17592186500783} :answer-field/id #uuid "77cf1334-15c4-5697-9c8a-01320f361d7e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501071}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0902afad-f2ba-5dbf-8fa2-d595df73885c" :question/math-academy-id "q-141778" :question/problem "Simplify $\\sqrt{25{r}^{3}}.$" :question/worked-solution "We first write $25{r}^{3}$ as the product $25{r}^{2}\\cdot r$ which contains a perfect square $(25{r}^{2}):$ \n\n$$\n\\begin{aligned}\\sqrt{25{r}^{3}} &= \\sqrt{25{r}^{2}\\cdot r}\\end{aligned}\n$$\n\nThen, we can separate the product into two separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{25{r}^{2}\\cdot r} &= \\sqrt{(5r)^{2}\\cdot r} \\\\ &= \\sqrt{(5r)^{2}}\\cdot \\sqrt{r}\\end{aligned}\n$$\n\nFinally, we simplify the radical containing the perfect square:\n\n$$\n\\begin{aligned}\\sqrt{(5r)^{2}}\\cdot \\sqrt{r} &= |5r|\\cdot \\sqrt{r} \\\\ &= |5|\\cdot |r|\\cdot \\sqrt{r} \\\\ &= 5|r|\\sqrt{r}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186501140 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fee27c5-65e3-596c-92c8-4162ad079fb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{p}-5\\sqrt[3]{p}" :db/id #edb/ref 17592186500501} {:answer/id #uuid "2c27b2f1-36dd-5430-a493-ff6a014ae9b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt[3]{p}" :db/id #edb/ref 17592186500558} {:answer/id #uuid "3a1a81c7-f1e5-5830-91a9-9aede4bd40aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{p}+6\\sqrt[3]{p}" :db/id #edb/ref 17592186500583} {:answer/id #uuid "5bc8c704-d1c4-59fd-a6c2-bf73a1a9ea59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{p}" :db/id #edb/ref 17592186500656} {:answer/id #uuid "61e5f9d5-ceea-58e8-8b94-2e31f14539f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt{p}-6\\sqrt[3]{p}" :db/id #edb/ref 17592186500670}] :answer-field/correct {:answer/id #uuid "0fee27c5-65e3-596c-92c8-4162ad079fb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{p}-5\\sqrt[3]{p}" :db/id #edb/ref 17592186500501} :answer-field/id #uuid "f877f913-f3d5-5963-b845-f4d71f87b43c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501130}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "09941e60-aba3-5a69-ab9a-c50e221cd8d0" :question/math-academy-id "q-134504" :question/problem "Simplify $\\sqrt[3]{p}+4\\sqrt{p}-6\\sqrt[3]{p}.$" :question/worked-solution "We can combine the two $\\sqrt[3]{p}$ terms together, but we cannot combine $\\sqrt[3]{p}$ and $\\sqrt{p}$ terms:\n\n$$\n\\begin{aligned}\\sqrt[3]{p}+4\\sqrt{p}-6\\sqrt[3]{p} &= 4\\sqrt{p}+\\sqrt[3]{p}-6\\sqrt[3]{p} \\\\ &= 4\\sqrt{p}+(1-6)\\sqrt[3]{p} \\\\ &= 4\\sqrt{p}-5\\sqrt[3]{p}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186501143 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55c0d6da-ec19-5da3-b2dc-7f663e03694e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2a\\sqrt{2}" :db/id #edb/ref 17592186500641} {:answer/id #uuid "6bff48a8-8066-543e-beda-b761e7cc572b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{a}^{2}" :db/id #edb/ref 17592186500688} {:answer/id #uuid "82bc2d85-b1c1-5c55-a2c7-2b61a9daf911" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4a" :db/id #edb/ref 17592186500737} {:answer/id #uuid "9f55a8e6-e0d9-5e67-80ef-09398f8eab35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{a}^{2}" :db/id #edb/ref 17592186500791} {:answer/id #uuid "cb925792-6008-5f93-bb6b-6fe323c888e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2a" :db/id #edb/ref 17592186500898}] :answer-field/correct {:answer/id #uuid "55c0d6da-ec19-5da3-b2dc-7f663e03694e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2a\\sqrt{2}" :db/id #edb/ref 17592186500641} :answer-field/id #uuid "2d6498f4-a70b-50c1-9ce5-2cc3f0cc3064" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501032}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1704928a-5b6a-5e32-992c-5da9fe38c678" :question/math-academy-id "q-2934" :question/problem "Simplify $\\sqrt{8{a}^{2}}$ given that $a\\ge 0.$" :question/worked-solution "We first write $8{a}^{2}$ as the product $4{a}^{2}\\cdot 2$ which contains a perfect square $(4{a}^{2}).$ Then, we can separate the product into two separate radicals, one of which can be simplified:\n\n$$\n\\begin{aligned}\\sqrt{8{a}^{2}} &= \\sqrt{4{a}^{2}\\cdot 2} \\\\ &= \\sqrt{(2a)^{2}\\cdot 2} \\\\ &= \\sqrt{(2a)^{2}}\\cdot \\sqrt{2} \\\\ &= |2a|\\sqrt{2} \\\\ &= |2|\\cdot |a|\\cdot \\sqrt{2} \\\\ &= 2\\cdot |a|\\cdot \\sqrt{2}\\end{aligned}\n$$\n\nSince $a\\ge 0,$ we have $|a|=a,$ and we can simplify further. Therefore, our final answer is\n\n$$\n\\begin{aligned}2\\cdot |a|\\cdot \\sqrt{2} &= 2\\cdot a\\cdot \\sqrt{2} \\\\ &= 2a\\sqrt{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186501154 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "100abe81-d1c0-5161-a04e-33a7b5191e1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20\\sqrt[3]{a}" :db/id #edb/ref 17592186500502} {:answer/id #uuid "8e1f7442-f98f-5cfa-8619-f2ec4315173a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{a}+12\\sqrt[3]{a}" :db/id #edb/ref 17592186500763} {:answer/id #uuid "ccf9de9b-45e4-5332-8a6c-a8aecf8d85d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20\\sqrt{a}" :db/id #edb/ref 17592186500904} {:answer/id #uuid "e518a7ea-b1f3-5d92-97dc-7835eada6dcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{a}+6\\sqrt[3]{a}" :db/id #edb/ref 17592186500953} {:answer/id #uuid "ff435ffa-2ffe-5bba-8398-60ba2c315789" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{a}+27\\sqrt[3]{a}" :db/id #edb/ref 17592186501010}] :answer-field/correct {:answer/id #uuid "8e1f7442-f98f-5cfa-8619-f2ec4315173a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{a}+12\\sqrt[3]{a}" :db/id #edb/ref 17592186500763} :answer-field/id #uuid "b5a34002-68da-5cb0-ae07-e3053d069076" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501100}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2b536617-f99c-5ac2-ab20-131751027d16" :question/math-academy-id "q-34203" :question/problem "Simplify $8\\sqrt{a}+9\\sqrt[3]{a}+3\\sqrt[3]{a}.$" :question/worked-solution "We can combine the two $\\sqrt[3]{a}$ terms together, but we cannot combine $\\sqrt[3]{a}$ and $\\sqrt{a}$ term:\n\n$$\n\\begin{aligned}8\\sqrt{a}+9\\sqrt[3]{a}+3\\sqrt[3]{a} &= 8\\sqrt{a}+(9+3)\\sqrt[3]{a} \\\\ &= 8\\sqrt{a}+12\\sqrt[3]{a}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186501177 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14751749-11a7-54dd-a588-054ae0830a81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{t}^{3}{y}^{4}" :db/id #edb/ref 17592186500512} {:answer/id #uuid "1591c3c8-6452-5e01-9abd-248681176903" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t{y}^{7}" :db/id #edb/ref 17592186500514} {:answer/id #uuid "50955ec0-816e-58a7-a9d7-c62e54da9246" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{t}^{2}{y}^{3}" :db/id #edb/ref 17592186500632} {:answer/id #uuid "927ababd-3fe9-5c8c-9f72-29c5ebc246de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{t}^{6}{y}^{4}" :db/id #edb/ref 17592186500770} {:answer/id #uuid "b341937b-e966-5703-8327-863c0e18b4d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{t}^{4}{y}^{3}" :db/id #edb/ref 17592186500842}] :answer-field/correct {:answer/id #uuid "b341937b-e966-5703-8327-863c0e18b4d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{t}^{4}{y}^{3}" :db/id #edb/ref 17592186500842} :answer-field/id #uuid "a4993c43-1633-58f3-990c-54e890b3dad0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501092}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6ef216dc-f6cf-5481-bcc8-f1b9abb1bf84" :question/math-academy-id "q-2913" :question/problem "Simplify $\\sqrt{{t}^{8}{y}^{6}}$ given that $y>0.$" :question/worked-solution "The square root of a squared quantity can be simplified using absolute value.\n\n$$\n\\sqrt{{x}^{2}}=|x|\n$$\n\nIn our case, we can simplify the given expression as follows:\n\n$$\n\\begin{aligned}\\sqrt{{t}^{8}{y}^{6}} &= \\sqrt{{t}^{4}{y}^{3}\\cdot {t}^{4}{y}^{3}} \\\\ &= \\sqrt{{({t}^{4}{y}^{3})}^{2}} \\\\ &= |{t}^{4}{y}^{3}| \\\\ &= |{t}^{4}|\\cdot |{y}^{3}| \\\\ &= |{t}^{4}|\\cdot |y{|}^{3}\\end{aligned}\n$$\n\nAn even power of a number is always positive or zero, and the absolute value of any positive (or zero) number is itself, so we have $|{t}^{4}|={t}^{4}.$ \n\nOn the other hand, we are told that $y>0,$ and we know that the absolute value of any positive number is just itself, so we have $|y|=y.$ Therefore, our final answer is\n\n$$\n\\begin{aligned}|{t}^{4}|\\cdot |y{|}^{3}={t}^{4}\\cdot {y}^{3}={t}^{4}{y}^{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186501180 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6578d9db-a288-52f9-a467-0b0d762ddb26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5t\\sqrt[3]{2{t}^{2}}" :db/id #edb/ref 17592186500679} {:answer/id #uuid "9e49f226-05e2-5fa3-9a9a-fc0c384b82cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t(t+2)\\sqrt[3]{2{t}^{2}}" :db/id #edb/ref 17592186500788} {:answer/id #uuid "dbf1a99b-f93a-5240-a156-32a1ef9fc430" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2t+3)\\sqrt[3]{2{t}^{2}}" :db/id #edb/ref 17592186500936} {:answer/id #uuid "f3172cb9-844c-5b93-8c38-158577da8e24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3t+2)\\sqrt[3]{2{t}^{2}}" :db/id #edb/ref 17592186500983} {:answer/id #uuid "fde2ec43-fbe3-5185-a065-7e41fef7648b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t(t+3)\\sqrt[3]{2{t}^{2}}" :db/id #edb/ref 17592186501006}] :answer-field/correct {:answer/id #uuid "dbf1a99b-f93a-5240-a156-32a1ef9fc430" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2t+3)\\sqrt[3]{2{t}^{2}}" :db/id #edb/ref 17592186500936} :answer-field/id #uuid "59cee49a-4507-5298-9c98-5e820d68d9ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501056}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "70fd859a-d33f-544f-b045-d1ae93fdfb95" :question/math-academy-id "q-134509" :question/problem "$t\\sqrt[3]{2{t}^{2}}+\\sqrt[3]{2{t}^{5}}+\\sqrt[3]{54{t}^{2}}=$" :question/worked-solution "We simplify each of the radical terms using the product rule:\n\n$$\n\\begin{aligned}t\\sqrt[3]{2{t}^{2}}+\\sqrt[3]{2{t}^{5}}+\\sqrt[3]{54{t}^{2}} &= t\\sqrt[3]{2{t}^{2}}+\\sqrt[3]{{t}^{3}\\cdot 2{t}^{2}}+\\sqrt[3]{27\\cdot 2{t}^{2}} \\\\ &= t\\sqrt[3]{2{t}^{2}}+\\sqrt[3]{{t}^{3}\\cdot 2{t}^{2}}+\\sqrt[3]{{3}^{3}\\cdot 2{t}^{2}} \\\\ &= t\\sqrt[3]{2{t}^{2}}+\\sqrt[3]{{t}^{3}}\\cdot \\sqrt[3]{2{t}^{2}}+\\sqrt[3]{{3}^{3}}\\cdot \\sqrt[3]{2{t}^{2}} \\\\ &= t\\sqrt[3]{2{t}^{2}}+t\\sqrt[3]{2{t}^{2}}+3\\sqrt[3]{2{t}^{2}}\\end{aligned}\n$$\n\nFinally, we combine the like terms:\n\n$$\n\\begin{aligned}t\\sqrt[3]{2{t}^{2}}+t\\sqrt[3]{2{t}^{2}}+3\\sqrt[3]{2{t}^{2}} &= (t+t+3)\\sqrt[3]{2{t}^{2}} \\\\ &= (2t+3)\\sqrt[3]{2{t}^{2}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186501203 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b2b8404-6210-5633-8b09-63f13a00d71b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{q}" :db/id #edb/ref 17592186500552} {:answer/id #uuid "528ae977-d06b-5c6e-9c5a-f9b69e895a8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt[3]{q}" :db/id #edb/ref 17592186500637} {:answer/id #uuid "a63a6e70-5841-5920-be18-141632aa45e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt[3]{q}-2\\sqrt{q}" :db/id #edb/ref 17592186500810} {:answer/id #uuid "e0a4d7e2-717f-59ea-b8b6-591fcebb1d42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt[3]{q}+4\\sqrt{q}" :db/id #edb/ref 17592186500942} {:answer/id #uuid "e4335664-d920-5a4b-a640-c4944143fa22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt[3]{q}+2\\sqrt{q}" :db/id #edb/ref 17592186500951}] :answer-field/correct {:answer/id #uuid "a63a6e70-5841-5920-be18-141632aa45e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt[3]{q}-2\\sqrt{q}" :db/id #edb/ref 17592186500810} :answer-field/id #uuid "c53cc0e1-da9e-551f-a889-af2f14ce3458" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501108}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a6334648-97e7-5622-8a2d-3ac7b05ed9c2" :question/math-academy-id "q-134505" :question/problem "$3\\sqrt[3]{q}-4\\sqrt{q}+2\\sqrt[3]{q}+2\\sqrt{q}=$" :question/worked-solution "We can combine the two $\\sqrt[3]{q}$ terms together, and the two $\\sqrt{q}$ terms together:\n\n$$\n\\begin{aligned}3\\sqrt[3]{q}-4\\sqrt{q}+2\\sqrt[3]{q}+2\\sqrt{q} &= 3\\sqrt[3]{q}+2\\sqrt[3]{q}-4\\sqrt{q}+2\\sqrt{q} \\\\ &= (3+2)\\sqrt[3]{q}+(-4+2)\\sqrt{q} \\\\ &= 5\\sqrt[3]{q}-2\\sqrt{q}\\end{aligned}\n$$\n\nNotice that we cannot combine the $\\sqrt[3]{q}$ and $\\sqrt{q}$ terms."} {:db/id #edb/ref 17592186501209 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ff75db6-8ba4-526a-a519-335413e4ac2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2p-q)\\sqrt{y}" :db/id #edb/ref 17592186500630} {:answer/id #uuid "972a9aa4-598b-52a4-a773-a52358c681bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2p-q)y" :db/id #edb/ref 17592186500776} {:answer/id #uuid "a55d3d7e-4693-57f0-8376-bce5262512c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2pq\\sqrt{y}" :db/id #edb/ref 17592186500806} {:answer/id #uuid "c439e8e4-2e85-57ab-a5b2-71a06c2f0f0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2p}{q\\sqrt{y}}" :db/id #edb/ref 17592186500880} {:answer/id #uuid "cf4c7e42-ee11-55b0-81ae-d9b046e18ca5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2p\\sqrt{y}}{q}" :db/id #edb/ref 17592186500912}] :answer-field/correct {:answer/id #uuid "4ff75db6-8ba4-526a-a519-335413e4ac2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2p-q)\\sqrt{y}" :db/id #edb/ref 17592186500630} :answer-field/id #uuid "dace7bbf-b422-5e70-b829-8a637b2e7746" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501117}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.dif