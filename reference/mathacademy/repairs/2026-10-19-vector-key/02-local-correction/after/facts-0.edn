ned}\n$$" #edb/ref 17592186576411] [17592186649978 #edb/ref 1080 "r\\times \\begin{bmatrix}4 \\\\ 9 \\\\ 5\\end{bmatrix}=-41i+31j-23k" #edb/ref 17592186576411] [17592186649978 #edb/ref 1081 "Locally authored correction by Codex; this option was absent from the original Math Academy bank." #edb/ref 17592186576411] [17592186649978 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186576411] [17592186649978 #edb/ref 1083 #uuid "2889dceb-0038-550a-b032-295566f22cba" #edb/ref 17592186576411] [17592186649979 #edb/ref 1075 #edb/ref 17592186649972 #edb/ref 17592186576411] [17592186649979 #edb/ref 1075 #edb/ref 17592186649973 #edb/ref 17592186576411] [17592186649979 #edb/ref 1075 #edb/ref 17592186649974 #edb/ref 17592186576411] [17592186649979 #edb/ref 1075 #edb/ref 17592186649975 #edb/ref 17592186576411] [17592186649979 #edb/ref 1075 #edb/ref 17592186649976 #edb/ref 17592186576411] [17592186649979 #edb/ref 1075 #edb/ref 17592186649978 #edb/ref 17592186576411] [17592186649979 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186576411] [17592186649979 #edb/ref 1077 "selection" #edb/ref 17592186576411] [17592186649979 #edb/ref 1078 #edb/ref 17592186649978 #edb/ref 17592186576411] [17592186649979 #edb/ref 1079 #uuid "b1439bbb-bd02-5648-b8fa-4994eaa3e108" #edb/ref 17592186576411]}
