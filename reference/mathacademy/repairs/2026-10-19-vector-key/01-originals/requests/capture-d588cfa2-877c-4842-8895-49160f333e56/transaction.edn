[{:db/id "question-c9705608-d638-5e5d-b560-a728314a7a4d" :question/id #uuid "c9705608-d638-5e5d-b560-a728314a7a4d" :question/math-academy-id "q-104098" :question/problem "A line passes through the points  $P(-3,-1,4)$ and $Q(1,8,9).$ Find its vector equation in the form $r\\times v=c.$" :question/worked-solution "We know that the line passes through the points $P(-3,-1,4)$ and $Q(1,8,9).$ Now, we need to find a vector parallel to the given line. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =q-p \\\\  & =\\begin{bmatrix}1 \\\\ 8 \\\\ 9\\end{bmatrix}-\\begin{bmatrix}-3 \\\\ -1 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 \\\\ 9 \\\\ 5\\end{bmatrix}\\end{aligned}\n$$\n\nNow, starting with the equation of the line using the cross product, we manipulate the equation and then substitute in our values of $p$ and $v$ as follows:\n\n$$\n\\begin{aligned}(r-p)\\times v & =0 \\\\ r\\times v-p\\times v & =0 \\\\ r\\times v & =p\\times v \\\\ r\\times \\begin{bmatrix}4 \\\\ 9 \\\\ 5\\end{bmatrix} & =\\begin{bmatrix}-3 \\\\ -1 \\\\ 4\\end{bmatrix}\\times \\begin{bmatrix}4 \\\\ 9 \\\\ 5\\end{bmatrix} \\\\ r\\times \\begin{bmatrix}4 \\\\ 9 \\\\ 5\\end{bmatrix} & =\\begin{vmatrix}i & j & k \\\\ -3 & -1 & 4 \\\\ 4 & 9 & 5\\end{vmatrix} \\\\ r\\times \\begin{bmatrix}4 \\\\ 9 \\\\ 5\\end{bmatrix} & =-41i-31j+23k.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "answer-59df5186-2517-50e6-a29d-5983ee8cd661" :answer/id #uuid "59df5186-2517-50e6-a29d-5983ee8cd661" :answer/type :answer.type/math :answer/value "r\\times \\begin{bmatrix}4 \\\\ 9 \\\\ 5\\end{bmatrix}=31i-41j+23k" :db/ensure [:answer/validate]} {:db/id "answer-20f5a3c7-a0cd-5eb1-8a11-5ef6d32e799b" :answer/id #uuid "20f5a3c7-a0cd-5eb1-8a11-5ef6d32e799b" :answer/type :answer.type/math :answer/value "r\\times \\begin{bmatrix}-3 \\\\ -1 \\\\ 4\\end{bmatrix}=23i+31j-41k" :db/ensure [:answer/validate]} {:db/id "answer-0e21dc5f-5a5e-55da-87c8-e2f9c689c401" :answer/id #uuid "0e21dc5f-5a5e-55da-87c8-e2f9c689c401" :answer/type :answer.type/math :answer/value "r\\times \\begin{bmatrix}4 \\\\ 9 \\\\ 5\\end{bmatrix}=41i-31j+23k" :db/ensure [:answer/validate]} {:db/id "answer-ac0b9c7e-802d-5d18-97cc-2fdab405a4c0" :answer/id #uuid "ac0b9c7e-802d-5d18-97cc-2fdab405a4c0" :answer/type :answer.type/math :answer/value "r\\times \\begin{bmatrix}-3 \\\\ -1 \\\\ 4\\end{bmatrix}=41i-31j+23k" :db/ensure [:answer/validate]} {:db/id "answer-f5a7241f-9bb0-58a3-a055-665ee79f6a11" :answer/id #uuid "f5a7241f-9bb0-58a3-a055-665ee79f6a11" :answer/type :answer.type/math :answer/value "r\\times \\begin{bmatrix}-3 \\\\ -1 \\\\ 4\\end{bmatrix}=23i-41j-31k" :db/ensure [:answer/validate]}]
