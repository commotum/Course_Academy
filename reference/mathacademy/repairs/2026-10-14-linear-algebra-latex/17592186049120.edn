/ident :answer.type/math} :answer/value "{R}_{3}↔{R}_{2}" :db/id #edb/ref 17592186341327}] :answer-field/correct {:db/id #edb/ref 17592186339953} :answer-field/id #uuid "ef2e4b02-8def-5910-b9cb-c64b8d3a1992" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341809}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4620d00b-e63c-5bb6-90cb-233c01e9e5ab" :question/math-academy-id "q-72857" :question/problem "Given that\n$C=\\begin{bmatrix}2 & \\,-4 & \\,\\,-2 \\\\ 0 & \\,-1 & \\,4 \\\\ 2 & \\,2 & \\,1\\end{bmatrix}$,\nwhich of the following elementary row operations makes ${a}_{33}=0?$" :question/worked-solution "Of the given options, we consider the row operation    \n\n$$\n{R}_{3}:={R}_{3}+\\frac{1}{2}{R}_{1}.\n$$\n\nApplying the above row operation, we obtain the following:\n\n$$\n\\begin{aligned}C & =\\begin{bmatrix}2 & \\,-4 & \\,\\,-2 \\\\ 0 & \\,-1 & \\,4 \\\\ 2 & \\,2 & \\,1\\end{bmatrix}\\,{R}_{3}:={R}_{3}+\\frac{1}{2}\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}2 & \\,-4 & \\,\\,-2 \\\\ 0 & \\,-1 & \\,4 \\\\ 3 & \\,0 & \\,0\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{3}:={R}_{3}+\\frac{1}{2}{R}_{1}.\n$$"} {:db/id #edb/ref 17592186341881 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44ff5f78-99ee-52f3-bd1d-6f04102d7f6c" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}-3{R}_{1}" :db/id #edb/ref 17592186339741} {:answer/id #uuid "64bc7a5d-f05c-508b-8e6f-0c816e66dd68" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}↔{R}_{1}" :db/id #edb/ref 17592186340019} {:answer/id #uuid "66d5039f-7e91-5441-b9ac-066a1add60d4" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}↔{R}_{2}" :db/id #edb/ref 17592186340032} {:answer/id #uuid "6efcee92-7f3a-5b03-8419-b8d8e7b73d4d" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}-2{R}_{2}" :db/id #edb/ref 17592186340112} {:answer/id #uuid "98eddd1d-580c-5f43-aabf-9b49e45c9fcb" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:=\\frac{1}{3}{R}_{3}" :db/id #edb/ref 17592186340508}] :answer-field/correct {:db/id #edb/ref 17592186339741} :answer-field/id #uuid "51eb3628-ef5f-5e6a-a72e-2dd27e5eda70" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341527}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d64eac74-31dd-5514-b904-fdc9f48abd1b" :question/math-academy-id "q-72860" :question/problem "Given that\n$S=\\begin{bmatrix}1 & -1 & 1 \\\\ 3 & 2 & 1 \\\\ 1 & 1 & 3\\end{bmatrix}$,\nwhich of the following elementary row operations makes ${a}_{33}=0?$" :question/worked-solution "Of the given options, we consider the row operation \n\n$$\n{R}_{3}:={R}_{3}-3{R}_{1}={R}_{3}+(-3)\\cdot {R}_{1}\n$$\n\nApplying the above row operation, we obtain the following:\n\n$$\n\\begin{aligned}S & =\\begin{bmatrix}1 & -1 & 1 \\\\ 3 & 2 & 1 \\\\ 1 & 1 & 3\\end{bmatrix}\\,{R}_{3}:={R}_{3}+(-3)\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 1 \\\\ 3 & 2 & 1 \\\\ -2 & 4 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the required row operation is \n\n$$\n{R}_{3}:={R}_{3}+(-3)\\cdot {R}_{1}\n$$\n\nor simply\n\n$$\n{R}_{3}:={R}_{3}-3{R}_{1}.\n$$"}] :knowledge-point/title "Identifying the Appropriate Row Operation To Transform a Given Entry to a Desired Value"} :step/id #uuid "0daa33bf-3f45-5650-9a9c-808f765e3f26" :step/math-academy-id 17187}] :activity/title "Elementary Row Operations" :activity/type {:db/id #edb/ref 17592186045463} :db/id #edb/ref 17592186059883}] :db/id #edb/ref 17592186049120 :topic/difficulty 0.3962220148324326 :topic/id #uuid "dc267e07-dc7a-5013-bcb3-616951f01683" :topic/knowledge-points [{:db/id #edb/ref 17592186059771 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059580 :question/id #uuid "836f2f1b-5dd4-5dba-81cc-eb9ffe7db8d1" :question/math-academy-id "e-4693" :question/problem "Consider the matrix $A,$ given by\n![](images/62/627d12115d61ddfdedf9db08330269de2137a23abceada977d039e90e5b88675.png)\nWhat matrix results from carrying out the row operation $R_2 := R_2 +(- 4) \\cdot R_1$ on $A?$" :question/worked-solution "The operation $R_2:=R_2 + (-4) R_1$ means that we need to add $-4$ times the first row to the second row. \n\nCarrying out this row operation, we get the following:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}1 & 2 & 3 \\\\ 4 & 2 & -1 \\\\ 7 & 12 & 13\\end{bmatrix}\\,{R}_{2}:={R}_{2}+(-4)\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 3 \\\\ 4+(-4)(1) & 2+(-4)(2) & -1+(-4)(3) \\\\ 7 & 12 & 13\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}1 & 2 & 3 \\\\ 0 & -6 & -13 \\\\ 7 & 12 & 13\\end{bmatrix}\\end{aligned}\n$$"} :knowledge-point/id #uuid "eb1afe82-86ba-5a15-9037-74717692ecb2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050163}] :knowledge-point/questions [{:db/id #edb/ref 17592186059961 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5a9bba7-f581-5372-a873-0fc17a55fb02" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 1 & -9 \\\\ 8 & 3 & 1 \\\\ -1 & 2 & 4\\end{bmatrix}" :db/id #edb/ref 17592186056126} {:answer/id #uuid "b9c177a1-6771-55e3-bd09-bf47def49ac2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & -1 & 9 \\\\ 8 & 3 & 1 \\\\ -1 & 2 & 4\\end{bmatrix}" :db/id #edb/ref 17592186056127} {:answer/id #uuid "0d1d8e7e-44fc-5700-9bdc-f19ade4437e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 3 & -1 & 9\\end{bmatrix}" :db/id #edb/ref 17592186056128} {:answer/id #uuid "5f95897b-76c9-50f9-ba67-9a60ae42a4ef" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 0 & -1 & 9\\end{bmatrix}" :db/id #edb/ref 17592186056129} {:answer/id #uuid "64489d72-05e0-5199-9ab5-2517bee16eda" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 0 & 5 & 21\\end{bmatrix}" :db/id #edb/ref 17592186056130}] :answer-field/id #uuid "fe11ff0e-55ca-57c1-896c-442215af5968" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186056125} {:answer-field/choices [{:answer/id #uuid "3e95e2e5-f4c7-556f-9d3b-6806aa203aac" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 0 & 5 & 21\\end{bmatrix}" :db/id #edb/ref 17592186386022} {:answer/id #uuid "93d2127b-e5d6-5f6a-b77b-e49e6b3917a4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 3 & -1 & 9\\end{bmatrix}" :db/id #edb/ref 17592186386023} {:answer/id #uuid "dfcd1624-4c95-5d1d-b7c3-eadfb5affb1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 1 & -9 \\\\ 8 & 3 & 1 \\\\ -1 & 2 & 4\\end{bmatrix}" :db/id #edb/ref 17592186386024} {:answer/id #uuid "84d65aa0-7f3f-56d8-8813-60439890bf5a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 0 & -1 & 9\\end{bmatrix}" :db/id #edb/ref 17592186386025} {:answer/id #uuid "f47ccd2f-8569-5e0e-ae2f-f78a4ee09a4d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & -1 & 9 \\\\ 8 & 3 & 1 \\\\ -1 & 2 & 4\\end{bmatrix}" :db/id #edb/ref 17592186386026}] :answer-field/correct {:db/id #edb/ref 17592186386022} :answer-field/id #uuid "6265e561-15e0-5e23-846a-8eab1f2ab8dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186386021}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "73199f2e-4821-5c88-b3d1-fc53d8677008" :question/math-academy-id "q-10248" :question/problem "Consider the matrix $M,$ given by\n\n$$\nM=\\begin{bmatrix}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 3 & -1 & 9\\end{bmatrix}.\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{3}:={R}_{3}+3{R}_{1}$ on $M?$" :question/worked-solution "The operation ${R}_{3}:={R}_{3}+3{R}_{1}$ means that we need to add $3$ times the first row to the third row.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 3 & -1 & 9\\end{bmatrix}\\,{R}_{3}:={R}_{3}+3\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & -4 \\\\ 8 & 3 & 1 \\\\ 3+(3)(-1) & -1+(3)(2) & 9+(3)(4)\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 0 & 5 & 21\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186059962 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03dc59cb-fd09-565f-9b4f-7c5b09fa0d6a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 3 & 6 \\\\ 4 & -1 & 3 \\\\ 0 & 8 & 1\\end{bmatrix}" :db/id #edb/ref 17592186235821} {:answer/id #uuid "13851fd1-8586-537b-b24a-6845ca174846" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 8 & 1 \\\\ 3 & 3 & 6 \\\\ 4 & -1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186235931} {:answer/id #uuid "2ca00ef3-9d64-5399-b711-41bbe0eaeaea" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & -1 & 3 \\\\ 0 & 8 & 1 \\\\ 3 & 3 & 6\\end{bmatrix}" :db/id #edb/ref 17592186236097} {:answer/id #uuid "7c169d8a-0156-5a46-bcad-6fcf3b499bde" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 3 & 6 \\\\ 0 & 8 & 1 \\\\ 4 & -1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186236593} {:answer/id #uuid "c6f87e96-eee1-5c3b-b11d-b31db823cd13" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & -1 & 3 \\\\ 3 & 3 & 6 \\\\ 0 & 8 & 1\\end{bmatrix}" :db/id #edb/ref 17592186237077}] :answer-field/correct {:db/id #edb/ref 17592186236593} :answer-field/id #uuid "1923a0a4-f52b-5133-bedc-c31b8ed88e76" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237468}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "855eebc5-e47a-5262-b735-bfa0d3ece889" :question/math-academy-id "q-10250" :question/problem "Consider the matrix $A,$ given by\n\n$$\nA=\\begin{bmatrix}0 & 8 & 1 \\\\ 3 & 3 & 6 \\\\ 4 & -1 & 3\\end{bmatrix}.\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{1}↔{R}_{2}$ on $A?$" :question/worked-solution "The operation ${R}_{1}↔{R}_{2}$ means that we need to swap the first and second rows.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}0 & 8 & 1 \\\\ 3 & 3 & 6 \\\\ 4 & -1 & 3\\end{bmatrix} & {R}_{1}↔{R}_{2} \\\\  & ∼\\begin{bmatrix}3 & 3 & 6 \\\\ 0 & 8 & 1 \\\\ 4 & -1 & 3\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237897 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b0ae7c7-831d-5433-9390-889330306d24" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 4 & -1 \\\\ 7 & 4 & -1 \\\\ 0 & 5 & -2\\end{bmatrix}" :db/id #edb/ref 17592186235871} {:answer/id #uuid "30eaaa83-5cd1-5e22-a46e-6e3b5195a079" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 4 & -1 \\\\ 0 & 5 & -2 \\\\ 1 & 5 & -3\\end{bmatrix}" :db/id #edb/ref 17592186236128} {:answer/id #uuid "bab3efd1-d5b4-58ad-bfff-d99746961975" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 7 & -1 \\\\ 5 & 1 & -3 \\\\ 5 & 0 & -2\\end{bmatrix}" :db/id #edb/ref 17592186237011} {:answer/id #uuid "df090ab6-463d-55fd-9c82-27652ad50d03" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 5 & -3 \\\\ 7 & 4 & -1 \\\\ 0 & 5 & -2\\end{bmatrix}" :db/id #edb/ref 17592186237219} {:answer/id #uuid "faa1874f-baa6-5eb3-8044-094998eb5d5a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 5 & -2 \\\\ 7 & 4 & -1 \\\\ 1 & 5 & -3\\end{bmatrix}" :db/id #edb/ref 17592186237402}] :answer-field/correct {:db/id #edb/ref 17592186237219} :answer-field/id #uuid "3d143e11-fa10-5879-b30c-3e557bb06f36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237518}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "89449fa7-e2ad-5aa8-8f8e-c30702d39ac6" :question/math-academy-id "q-10244" :question/problem "Consider the matrix $A,$ given by\n\n$$\nA=\\begin{bmatrix}7 & 4 & -1 \\\\ 1 & 5 & -3 \\\\ 0 & 5 & -2\\end{bmatrix}.\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{1}↔{R}_{2}$ on $A?$" :question/worked-solution "The operation ${R}_{1}↔{R}_{2}$ means that we need to swap the first and second rows.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}7 & 4 & -1 \\\\ 1 & 5 & -3 \\\\ 0 & 5 & -2\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 5 & -3 \\\\ 7 & 4 & -1 \\\\ 0 & 5 & -2\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265796 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0afbf473-cf2c-557a-b166-cf94f46b04fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{3} & \\frac{2}{3} & \\frac{7}{3} \\\\ 7 & -1 & 3 \\\\ 6 & 9 & -3\\end{bmatrix}" :db/id #edb/ref 17592186263105} {:answer/id #uuid "39cae253-d68f-537c-b71f-b07e5c03621e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 2 & 7 \\\\ \\frac{7}{3} & -\\frac{1}{3} & 1 \\\\ 6 & 9 & -3\\end{bmatrix}" :db/id #edb/ref 17592186263515} {:answer/id #uuid "5c917f32-40fe-536b-976e-64ddba176487" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 3 & -1 \\\\ 7 & -1 & 3 \\\\ 2 & 2 & 7\\end{bmatrix}" :db/id #edb/ref 17592186263800} {:answer/id #uuid "d2202449-4412-5126-800a-2b62df1d2a71" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 2 & 7 \\\\ 7 & -1 & 3 \\\\ 2 & 3 & -1\\end{bmatrix}" :db/id #edb/ref 17592186264833} {:answer/id #uuid "fc2ff622-6bf9-5fc1-9910-0b357c357bf4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 2 & 7 \\\\ 7 & -1 & 3 \\\\ 18 & 27 & -9\\end{bmatrix}" :db/id #edb/ref 17592186265210}] :answer-field/correct {:db/id #edb/ref 17592186264833} :answer-field/id #uuid "a68b5eeb-7e97-5637-b883-d5b1091e0338" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265542}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1b5f24a7-25be-5f91-9261-490e6919b435" :question/math-academy-id "q-130006" :question/problem "Consider the matrix $A,$ given by\n\n$$\nA=\\begin{bmatrix}2 & 2 & 7 \\\\ 7 & -1 & 3 \\\\ 6 & 9 & -3\\end{bmatrix}.\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{3}:=\\frac{1}{3}{R}_{3}$ on $A?$" :question/worked-solution "The operation ${R}_{3}:=\\frac{1}{3}{R}_{3}$ means that we need to multiply the third row of the matrix by $\\frac{1}{3}.$\n\nMultiplying the $3$rd row by $\\frac{1}{3}$, we obtain the following:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}2 & 2 & 7 \\\\ 7 & -1 & 3 \\\\ 6 & 9 & -3\\end{bmatrix} & {R}_{3}:=\\frac{1}{3}\\cdot {R}_{3} \\\\  & ∼\\begin{bmatrix}2 & 2 & 7 \\\\ 7 & -1 & 3 \\\\ \\frac{1}{3}\\cdot 6 & \\frac{1}{3}\\cdot 9 & \\frac{1}{3}\\cdot -3\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}2 & 2 & 7 \\\\ 7 & -1 & 3 \\\\ 2 & 3 & -1\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265809 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73a2c4e4-50d2-503f-bd6c-ff089298616e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 4 & 7 \\\\ -10 & 0 & 5 \\\\ 6 & 5 & 1\\end{bmatrix}" :db/id #edb/ref 17592186264003} {:answer/id #uuid "7ff361c5-1ff3-5bae-bd7f-64bc0ff75321" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & 8 & -9 \\\\ 5 & 2 & 1 \\\\ 6 & 5 & 1\\end{bmatrix}" :db/id #edb/ref 17592186264101} {:answer/id #uuid "a4eeb7c2-1749-5db5-9f69-4de6d50bbc49" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & 0 & 5 \\\\ 5 & 2 & 1 \\\\ 6 & 5 & 1\\end{bmatrix}" :db/id #edb/ref 17592186264408} {:answer/id #uuid "a8f82394-8f99-5fa4-ba5d-107b492af231" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & 0 & 5 \\\\ 6 & 5 & 1 \\\\ 1 & 3 & 0\\end{bmatrix}" :db/id #edb/ref 17592186264445} {:answer/id #uuid "bacc0ddd-dc83-59e3-9874-8cfac2adf105" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & 0 & 5 \\\\ 5 & 2 & 1 \\\\ 1 & 3 & 0\\end{bmatrix}" :db/id #edb/ref 17592186264622}] :answer-field/correct {:db/id #edb/ref 17592186264408} :answer-field/id #uuid "3ed109b8-a919-5012-a65d-4a4d80d99f80" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265361}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "89540d9f-9bfa-5f07-91be-e72783b1a7bc" :question/math-academy-id "q-130064" :question/problem "Consider the matrix $C,$ given by\n\n$$\nC=\\begin{bmatrix}0 & 4 & 7 \\\\ 5 & 2 & 1 \\\\ 1 & 3 & 0\\end{bmatrix}.\n$$\n\nWhat matrix results from carrying out the following row operations on $C?$\n\n$$\n\\begin{aligned}{R}_{1} & :={R}_{1}-2{R}_{2} \\\\ {R}_{3} & :={R}_{3}+{R}_{2}\\end{aligned}\n$$" :question/worked-solution "Let's list the required operations:\n\n- The operation ${R}_{1}:={R}_{1}-2{R}_{2}$ means that we need to add $-2$ times the second row to the first row.\n\n- The operation ${R}_{3}:={R}_{3}+{R}_{2}$ means that we need to add $1$ times the second row to the third row.\n\nApplying the operations, we obtain the following:\n\n$$\n\\begin{aligned}C & =\\begin{bmatrix}0 & 4 & 7 \\\\ 5 & 2 & 1 \\\\ 1 & 3 & 0\\end{bmatrix}\\,{R}_{1}:={R}_{1}+(-2)\\cdot {R}_{2} \\\\  & ∼\\begin{bmatrix}0+(-2)(5) & 4+(-2)(2) & 7+(-2)(1) \\\\ 5 & 2 & 1 \\\\ 1 & 3 & 0\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}-10 & 0 & 5 \\\\ 5 & 2 & 1 \\\\ 1 & 3 & 0\\end{bmatrix}\\,{R}_{3}:={R}_{3}+(1)\\cdot {R}_{2} \\\\  & ∼\\begin{bmatrix}-10 & 0 & 5 \\\\ 5 & 2 & 1 \\\\ 1+(1)(5) & 3+(1)(2) & 0+(1)(1)\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}-10 & 0 & 5 \\\\ 5 & 2 & 1 \\\\ 6 & 5 & 1\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265810 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03949c4b-6891-5b84-b41d-57552e4e94cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 2 & -2 \\\\ 1 & 0 & -9 \\\\ 2 & 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186263030} {:answer/id #uuid "5841ddf4-5f71-5cdd-afc7-47cedd7a87e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 2 & -4 \\\\ -19 & 0 & -1 \\\\ 2 & 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186263760} {:answer/id #uuid "aaef4050-007d-5267-8d48-c8df487afab0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 & 1 \\\\ 7 & 2 & -2 \\\\ 1 & 0 & -9\\end{bmatrix}" :db/id #edb/ref 17592186264465} {:answer/id #uuid "be5ea1db-c697-51d4-aeb0-b74aead3cc03" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 & 1 \\\\ 7 & 2 & -2 \\\\ 2 & 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186264654} {:answer/id #uuid "c8d8bd0a-43ee-511e-985d-7a0790baba7a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 2 & -2 \\\\ -9 & 0 & -4 \\\\ 1 & 0 & -9\\end{bmatrix}" :db/id #edb/ref 17592186264760}] :answer-field/correct {:db/id #edb/ref 17592186263030} :answer-field/id #uuid "8d7835eb-fe41-51f2-8257-6d4458713548" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265496}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "873c8162-c75c-5ddc-aed6-146d6160fb0b" :question/math-academy-id "q-130065" :question/problem "Consider the matrix $C,$ given by\n\n$$\nC=\\begin{bmatrix}1 & 2 & 1 \\\\ -9 & 0 & -4 \\\\ 2 & 0 & -1\\end{bmatrix}.\n$$\n\nWhat matrix results from carrying out the following row operations on $C?$\n\n$$\n\\begin{aligned}{R}_{1} & :={R}_{1}+3{R}_{3} \\\\ {R}_{2} & :={R}_{2}+5{R}_{3}\\end{aligned}\n$$" :question/worked-solution "Let's list the required operations:\n\n- The operation ${R}_{1}:={R}_{1}+3{R}_{3}$ means that we need to add $3$ times the third row to the first row.\n\n- The operation ${R}_{2}:={R}_{2}+5{R}_{3}$ means that we need to add $5$ times the third row to the second row.\n\nApplying the operations, we obtain the following:\n\n$$\n\\begin{aligned}C & =\\begin{bmatrix}1 & 2 & 1 \\\\ -9 & 0 & -4 \\\\ 2 & 0 & -1\\end{bmatrix}\\,{R}_{1}:={R}_{1}+3\\cdot {R}_{3} \\\\  & ∼\\begin{bmatrix}1+(3)(2) & 2+(3)(0) & 1+(3)(-1) \\\\ -9 & 0 & -4 \\\\ 2 & 0 & -1\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}7 & 2 & -2 \\\\ -9 & 0 & -4 \\\\ 2 & 0 & -1\\end{bmatrix}\\,{R}_{2}:={R}_{2}+5\\cdot {R}_{3} \\\\  & ∼\\begin{bmatrix}7 & 2 & -2 \\\\ -9+(5)(2) & 0+(5)(0) & -4+(5)(-1) \\\\ 2 & 0 & -1\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}7 & 2 & -2 \\\\ 1 & 0 & -9 \\\\ 2 & 0 & -1\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287981 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f838c2c-b1d0-52ca-bdd1-759b3f28e9b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 & 1 \\\\ 0 & -7 & -2 \\\\ 2 & 3 & 2\\end{bmatrix}" :db/id #edb/ref 17592186285663} {:answer/id #uuid "6d2a787c-8b97-57cc-8fe2-47181a3b7d2d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & -3 & -1 \\\\ 1 & 2 & 1 \\\\ 3 & -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186285790} {:answer/id #uuid "77cd75e4-8855-5c13-9dee-73fe9f426575" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -7 & -2 \\\\ 1 & 2 & 1 \\\\ 2 & 3 & 2\\end{bmatrix}" :db/id #edb/ref 17592186285902} {:answer/id #uuid "b0405152-868b-5aca-9457-e8ef9b46e55b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 & 1 \\\\ 3 & -1 & 1 \\\\ -1 & -3 & -1\\end{bmatrix}" :db/id #edb/ref 17592186286397} {:answer/id #uuid "f1bcca47-aebf-5c20-bf86-bec34ef21f8f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -1 & 1 \\\\ 3 & -10 & 1 \\\\ 2 & -3 & 2\\end{bmatrix}" :db/id #edb/ref 17592186287007}] :answer-field/correct {:db/id #edb/ref 17592186285663} :answer-field/id #uuid "d6cd03db-7e93-5314-902f-ae586cc7310d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287587}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e33508b0-e7bc-5f7b-ba8e-f8058d2dcab4" :question/math-academy-id "q-20239" :question/problem "Consider the matrix $X,$ given by\n\n$$\nX=\\begin{bmatrix}1 & 2 & 1 \\\\ 3 & -1 & 1 \\\\ 2 & 3 & 2\\end{bmatrix}.\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{2}:={R}_{2}-3{R}_{1}$ on $X?$" :question/worked-solution "The operation ${R}_{2}:={R}_{2}-3{R}_{1}$ means that we need to add $-3$ times the first row to the second row. \n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}X & =\\begin{bmatrix}1 & 2 & 1 \\\\ 3 & -1 & 1 \\\\ 2 & 3 & 2\\end{bmatrix}\\,{R}_{2}:={R}_{2}+(-3)\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 1 \\\\ 3+(-3)(1) & -1+(-3)(2) & 1+(-3)(1) \\\\ 2 & 3 & 2\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}1 & 2 & 1 \\\\ 0 & -7 & -2 \\\\ 2 & 3 & 2\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186386014 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17d6b6ba-73af-5b0e-aadb-df2b92946446" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 3 & 6 \\\\ 0 & 24 & 27 \\\\ 1 & 5 & 10\\end{bmatrix}" :db/id #edb/ref 17592186386016} {:answer/id #uuid "fd96430f-7419-56b6-99da-8a526bba22e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 3 & 6 \\\\ 0 & 21 & 27 \\\\ 0 & 5 & 10\\end{bmatrix}" :db/id #edb/ref 17592186386017} {:answer/id #uuid "83bf736c-a7af-587e-9671-a0755c99d45c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 3 & 6 \\\\ 0 & 24 & 27 \\\\ 0 & 5 & 10\\end{bmatrix}" :db/id #edb/ref 17592186386018} {:answer/id #uuid "be7cd770-89d2-5f9f-b60e-e8df5d9ff51c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 3 & 6 \\\\ 0 & 24 & 27 \\\\ 0 & -5 & 10\\end{bmatrix}" :db/id #edb/ref 17592186386019} {:answer/id #uuid "f19e8491-c92c-5661-8c92-a31904c65e32" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 3 & 6 \\\\ 0 & 24 & 25 \\\\ 0 & 5 & 10\\end{bmatrix}" :db/id #edb/ref 17592186386020}] :answer-field/correct {:db/id #edb/ref 17592186386018} :answer-field/id #uuid "5f488fbc-4f0a-58a9-aca2-89c02a7e41b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186386015}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d89fad28-1b46-55f3-b90e-6ed4c3f194da" :question/math-academy-id "q-10245" :question/problem "Consider the matrix $B,$ given by\n\n$$\nB=\\begin{bmatrix}1 & 3 & 6 \\\\ -4 & 12 & 3 \\\\ -1 & 2 & 4\\end{bmatrix}.\n$$\n\nWhat matrix results from carrying out the following row operations on $B?$\n\n$$\n\\begin{aligned}{R}_{2} & :={R}_{2}+4{R}_{1} \\\\ {R}_{3} & :={R}_{3}+{R}_{1}\\end{aligned}\n$$" :question/worked-solution "Let's list the required operations:\n\n- The operation ${R}_{2}:={R}_{2}+4{R}_{1}$ means that we need to add $4$ times the first row to the second row.\n\n- The operation ${R}_{3}:={R}_{3}+{R}_{1}$ means that we need to add $1$ times the first row to the third row.\n\nApplying the operations, we obtain the following:\n\n$$\n\\begin{aligned}B & =\\begin{bmatrix}1 & 3 & 6 \\\\ -4 & 12 & 3 \\\\ -1 & 2 & 4\\end{bmatrix}\\,{R}_{2}:={R}_{2}+4\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & 6 \\\\ -4+(4)(1) & 12+(4)(3) & 3+(4)(6) \\\\ -1 & 2 & 4\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}1 & 3 & 6 \\\\ 0 & 24 & 27 \\\\ -1 & 2 & 4\\end{bmatrix}\\,{R}_{3}:={R}_{3}+{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & 6 \\\\ 0 & 24 & 27 \\\\ -1+1 & 2+3 & 4+6\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}1 & 3 & 6 \\\\ 0 & 24 & 27 \\\\ 0 & 5 & 10\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186388062 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3918bbf4-16cc-5c1f-a802-36adb86390c4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 6 & -7 \\\\ -14 & 3 & -4 \\\\ -2 & 4 & -3\\end{bmatrix}" :db/id #edb/ref 17592186388064} {:answer/id #uuid "e62342b5-074d-5e24-9642-83584f678838" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 6 & -7 \\\\ 30 & 11 & -20 \\\\ -2 & 4 & -3\\end{bmatrix}" :db/id #edb/ref 17592186388065} {:answer/id #uuid "b6849f47-5bf1-537e-9558-fee095da4647" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 6 & -7 \\\\ 28 & 15 & -23 \\\\ -2 & 4 & -3\\end{bmatrix}" :db/id #edb/ref 17592186388066} {:answer/id #uuid "7c6fc884-3dee-5e5f-9162-e9d9a9e34a9d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 6 & -7 \\\\ -5 & 9 & -11 \\\\ -2 & 4 & -3\\end{bmatrix}" :db/id #edb/ref 17592186388067} {:answer/id #uuid "22917917-c3d7-5ada-b4ca-d45cebf96675" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 6 & -7 \\\\ 26 & 19 & -26 \\\\ -2 & 4 & -3\\end{bmatrix}" :db/id #edb/ref 17592186388068}] :answer-field/correct {:db/id #edb/ref 17592186388065} :answer-field/id #uuid "f9ef02a3-2e92-5a2e-a56c-df3ea22f0bc2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186388063}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d1a5db75-1b21-5cae-946a-8cdf4a8b6bd6" :question/math-academy-id "q-130010" :question/problem "Consider the matrix $C,$ given by\n\n$$\nC=\\begin{bmatrix}9 & 6 & -7 \\\\ 1 & -3 & -2 \\\\ -2 & 4 & -3\\end{bmatrix}.\n$$\n\nWhat matrix results from carrying out the following row operations on $C?$\n\n$$\n\\begin{aligned}{R}_{2} & :={R}_{2}+3{R}_{1} \\\\ {R}_{2} & :={R}_{2}-{R}_{3}\\end{aligned}\n$$" :question/worked-solution "Let's list the required operations:\n\n- The operation ${R}_{2}:={R}_{2}+3{R}_{1}$ means that we need to add $3$ times the first row to the second row.\n\n- The operation ${R}_{2}:={R}_{2}-{R}_{3}$ means that we need to add $-1$ times the third row to the second row.\n\nApplying the operations, we obtain the following:\n\n$$\n\\begin{aligned}C & =\\begin{bmatrix}9 & 6 & -7 \\\\ 1 & -3 & -2 \\\\ -2 & 4 & -3\\end{bmatrix}\\,{R}_{2}:={R}_{2}+3\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}9 & 6 & -7 \\\\ 1+(3)(9) & -3+(3)(6) & -2+(3)(-7) \\\\ -2 & 4 & -3\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}9 & 6 & -7 \\\\ 28 & 15 & -23 \\\\ -2 & 4 & -3\\end{bmatrix}\\,{R}_{2}:={R}_{2}+(-1)\\cdot {R}_{3} \\\\  & ∼\\begin{bmatrix}9 & 6 & -7 \\\\ 28+(-1)(-2) & 15+(-1)(4) & -23+(-1)(-3) \\\\ -2 & 4 & -3\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}9 & 6 & -7 \\\\ 30 & 11 & -20 \\\\ -2 & 4 & -3\\end{bmatrix}\\end{aligned}\n$$"}] :knowledge-point/title "Applying Row Operations To a Coefficients Matrix"} {:db/id #edb/ref 17592186059772 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059581 :question/id #uuid "2ff0a6f5-f3b2-5b39-8b69-1a0c969548cf" :question/math-academy-id "e-4694" :question/problem "Consider the augmented matrix $A,$ given by\n![](images/82/82729e1d34174d58f01547b58aa63db28ec68a4e1964ef5cd127a2167ed4a722.png) \n\nWhat matrix results from carrying out the row operation $R_1 \\leftrightarrow R_2$ on $A?$" :question/worked-solution "The operation $R_1 \\leftrightarrow R_2$ means that we need to swap the first and second rows.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}A & =[\\begin{array}{ccc|c}-1 & 5 & 4 & 1 \\\\ 1 & 0 & 5 & 2 \\\\ 3 & 7 & 1 & 9\\end{array}]\\,{R}_{1}↔{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 5 & 2 \\\\ -1 & 5 & 4 & 1 \\\\ 3 & 7 & 1 & 9\\end{array}\\right]\\end{aligned}\n$$"} :knowledge-point/id #uuid "c27a3f3c-77c7-55e9-8714-1f24c4a48063" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050765}] :knowledge-point/questions [{:db/id #edb/ref 17592186059956 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41036779-8884-58ba-a52a-187ec59149c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & 9 & 1 \\\\ 5 & 2 & -1 & 1 \\\\ 0 & -3 & 3 & 0\\end{array}\\right]" :db/id #edb/ref 17592186236231} {:answer/id #uuid "524035f0-b03f-50f7-9a6c-85d843872657" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & 9 & 1 \\\\ 5 & -1 & 2 & 1 \\\\ 5 & 2 & -1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186236337} {:answer/id #uuid "ad326773-ff13-534e-8509-6da366e37306" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & 9 & 1 \\\\ 0 & -3 & 3 & 0 \\\\ 5 & 2 & -1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186236920} {:answer/id #uuid "d6db9a07-407a-56d4-9a6b-716466b733e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}5 & 2 & -1 & 1 \\\\ 5 & -1 & 2 & 1 \\\\ 1 & 3 & 9 & 1\\end{array}\\right]" :db/id #edb/ref 17592186237177} {:answer/id #uuid "e7ddcfed-b7f1-5a02-8226-faae52c986bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}0 & -3 & 3 & 0 \\\\ 5 & 2 & -1 & 1 \\\\ 1 & 3 & 9 & 1\\end{array}\\right]" :db/id #edb/ref 17592186237275}] :answer-field/correct {:db/id #edb/ref 17592186236920} :answer-field/id #uuid "a2d34fd5-89b5-526e-b7a7-ac7984b3ddb5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237653}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "00a500f4-f378-5f41-9cd3-c3d0604af452" :question/math-academy-id "q-10217" :question/problem "Consider the augmented matrix $M,$ given by\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & 3 & 9 & 1 \\\\ 5 & -1 & 2 & 1 \\\\ 5 & 2 & -1 & 1\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{2}:={R}_{2}+(-1)\\cdot {R}_{3}$ on $M?$" :question/worked-solution "The operation ${R}_{2}:={R}_{2}+(-1)\\cdot {R}_{3}$ means that we need to add $-1$ times the third row to the second row.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}1 & 3 & 9 & 1 \\\\ 5 & -1 & 2 & 1 \\\\ 5 & 2 & -1 & 1\\end{array}\\right]\\,{R}_{2}:={R}_{2}+(-1)\\cdot {R}_{3} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 3 & 9 & 1 \\\\ 5+(-1)(5) & -1+(-1)(2) & 2+(-1)(-1) & 1+(-1)(1) \\\\ 5 & 2 & -1 & 1\\end{array}\\right] \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 3 & 9 & 1 \\\\ 0 & -3 & 3 & 0 \\\\ 5 & 2 & -1 & 1\\end{array}\\right]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186059963 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85f1ad10-af76-57c6-940f-54720a66b04e" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}1 & 4 & 6 \\\\ 6 & 8 & 10 \\\\ 8 & 12 & 14\\end{array}\\right]" :db/id #edb/ref 17592186056138} {:answer/id #uuid "dc6b2671-bf35-5e2b-8ae2-6ed3f7c4f920" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}1 & 4 & 6 \\\\ 1 & 12 & 15 \\\\ 1 & 24 & 28\\end{array}\\right]" :db/id #edb/ref 17592186056139} {:answer/id #uuid "e2588b59-90ef-5467-875e-c92359e99c71" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}2 & 4 & 6 \\\\ 3 & 4 & 5 \\\\ 4 & 6 & 7\\end{array}\\right]" :db/id #edb/ref 17592186056140} {:answer/id #uuid "0df38360-a680-533c-85cb-cbf6cc1b956d" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}2 & 2 & 3 \\\\ 6 & 4 & 5 \\\\ 8 & 6 & 7\\end{array}\\right]" :db/id #edb/ref 17592186056141} {:answer/id #uuid "5fc99020-ce13-5c21-9960-e34814529660" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}2 & 2 & 3 \\\\ 3 & 4 & 5 \\\\ 4 & 6 & 7\\end{array}\\right]" :db/id #edb/ref 17592186056142}] :answer-field/id #uuid "7e5993af-0e10-5818-81f9-6717646c2956" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186056137}] :question/id #uuid "afe0707b-0259-50d7-a719-7a8d24334500" :question/math-academy-id "q-10252" :question/problem "Consider the augmented matrix $A$, given by\n$A = \\left[\\begin{array}{cc|c}1 & 2 & 3 \\\\ 3 & 4 & 5 \\\\ 4 & 6 & 7\\end{array}\\right]$.\nWhat matrix results from carrying out the row operation $R_{1}:=2R_{1}$ on $A$?"} {:db/id #edb/ref 17592186265811 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d500c09-be89-583e-9e7e-72a524f28363" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}6 & 5 & -6 \\\\ -1 & -9 & 1 \\\\ 4 & -1 & 9\\end{array}\\right]" :db/id #edb/ref 17592186263810} {:answer/id #uuid "5fb13c26-f7a7-5dad-b6a2-9be9b73aa159" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}-1 & -9 & 1 \\\\ 4 & -1 & 9 \\\\ 6 & 5 & -6\\end{array}\\right]" :db/id #edb/ref 17592186263828} {:answer/id #uuid "6d610375-2bf0-5cef-9d1c-7da845f2aece" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}4 & -1 & 9 \\\\ 6 & 5 & -6 \\\\ -1 & -9 & 1\\end{array}\\right]" :db/id #edb/ref 17592186263948} {:answer/id #uuid "a974f595-cd6b-5b5a-9845-0ea11de039af" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}-1 & -9 & 1 \\\\ 6 & 5 & -6 \\\\ 4 & -1 & 9\\end{array}\\right]" :db/id #edb/ref 17592186264448} {:answer/id #uuid "bd12ade3-f67a-5e97-b1c6-bbbec107e0be" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}6 & 5 & -6 \\\\ 4 & -1 & 9 \\\\ -1 & -9 & 1\\end{array}\\right]" :db/id #edb/ref 17592186264641}] :answer-field/correct {:db/id #edb/ref 17592186264641} :answer-field/id #uuid "21e9df06-4ceb-5344-9619-cdc4b1c38a8d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265303}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "926d4b45-89b4-5d26-9733-b0d97c69c160" :question/math-academy-id "q-130070" :question/problem "Consider the augmented matrix $A,$ given by\n\n$$\nA=\\left[\\begin{array}{cc|c}4 & -1 & 9 \\\\ 6 & 5 & -6 \\\\ -1 & -9 & 1\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{1}↔{R}_{2}$ on $A?$" :question/worked-solution "The operation ${R}_{1}↔{R}_{2}$ means that we need to swap the first and second rows.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}A & =\\left[\\begin{array}{cc|c}4 & -1 & 9 \\\\ 6 & 5 & -6 \\\\ -1 & -9 & 1\\end{array}\\right]\\,{R}_{1}↔{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}6 & 5 & -6 \\\\ 4 & -1 & 9 \\\\ -1 & -9 & 1\\end{array}\\right]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265812 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6efbd8af-10b5-53c6-857e-b823622056a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}-1 & 9 & -2 & 6 \\\\ -5 & 4 & 1 & 0 \\\\ 9 & 0 & 5 & 7\\end{array}\\right]" :db/id #edb/ref 17592186263962} {:answer/id #uuid "8c6b89e1-6402-52a9-b448-8fa56de1c9cf" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}9 & 0 & 5 & 7 \\\\ -5 & 4 & 1 & 0 \\\\ -1 & 9 & -2 & 6\\end{array}\\right]" :db/id #edb/ref 17592186264202} {:answer/id #uuid "9f1fa668-8238-5411-8f92-5693201d70e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}4 & 4 & 6 & 7 \\\\ -10 & 9 & -7 & -1 \\\\ 9 & 0 & 5 & 7\\end{array}\\right]" :db/id #edb/ref 17592186264355} {:answer/id #uuid "c043b83a-ecdb-5690-bcb9-8317f969f29a" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}9 & 0 & 5 & 7 \\\\ 5 & -5 & 8 & 1 \\\\ -1 & 9 & -2 & 6\\end{array}\\right]" :db/id #edb/ref 17592186264672} {:answer/id #uuid "d32e7d42-9a50-5b42-b498-3e00947b27f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}9 & 0 & 5 & 7 \\\\ 4 & 4 & 6 & 7 \\\\ -1 & 9 & -2 & 6\\end{array}\\right]" :db/id #edb/ref 17592186264841}] :answer-field/correct {:db/id #edb/ref 17592186264672} :answer-field/id #uuid "54ad4053-e7d1-5505-b41b-3448a4f4c97b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265396}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "25230851-35bf-5052-9d49-2045d4671518" :question/math-academy-id "q-130072" :question/problem "Consider the augmented matrix $V,$ given by\n\n$$\nV=\\left[\\begin{array}{ccc|c}-1 & 9 & -2 & 6 \\\\ 4 & 4 & 6 & 7 \\\\ 9 & 0 & 5 & 7\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the following row operations on $V?$\n\n$$\n\\begin{aligned}{R}_{1} & ↔{R}_{3} \\\\ {R}_{2} & :={R}_{2}+(-1)\\cdot {R}_{3}\\end{aligned}\n$$" :question/worked-solution "Let's list the required operations:\n\n- The operation ${R}_{1}↔{R}_{3}$ means that we need to swap the first and third rows.\n\n- The operation ${R}_{2}:={R}_{2}+(-1)\\cdot {R}_{3}$ means that we need to add $-1$ times the third row to the second row.\n\nApplying the operations, we obtain the following:\n\n$$\n\\begin{aligned}V & =\\left[\\begin{array}{ccc|c}-1 & 9 & -2 & 6 \\\\ 4 & 4 & 6 & 7 \\\\ 9 & 0 & 5 & 7\\end{array}\\right]\\,{R}_{1}↔{R}_{3} \\\\  & ∼\\left[\\begin{array}{ccc|c}9 & 0 & 5 & 7 \\\\ 4 & 4 & 6 & 7 \\\\ -1 & 9 & -2 & 6\\end{array}\\right]\\,{R}_{2}:={R}_{2}+(-1)\\cdot {R}_{3} \\\\  & ∼\\left[\\begin{array}{ccc|c}9 & 0 & 5 & 7 \\\\ 4+(-1)(-1) & 4+(-1)(9) & 6+(-1)(-2) & 7+(-1)(6) \\\\ -1 & 9 & -2 & 6\\end{array}\\right] \\\\  & ∼\\left[\\begin{array}{ccc|c}9 & 0 & 5 & 7 \\\\ 5 & -5 & 8 & 1 \\\\ -1 & 9 & -2 & 6\\end{array}\\right]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47342003-0f7a-57c7-8078-e0f5b89cbe17" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & 9 & 1 \\\\ 0 & -3 & 3 & 0 \\\\ 0 & 1 & 1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186339758} {:answer/id #uuid "4a4e65ba-c319-5c08-b0e3-c9aebf3725a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}0 & -2 & 1 & 4 \\\\ 1 & 0 & 2 & 3 \\\\ 1 & 1 & 0 & -2\\end{array}\\right]" :db/id #edb/ref 17592186339797} {:answer/id #uuid "aa16b685-af65-56c2-863d-85ebb28720ec" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 0 & -1 & -1 & -1\\end{array}\\right]" :db/id #edb/ref 17592186340679} {:answer/id #uuid "ac12c08c-7cda-5cfc-92cd-fec65f15dc5c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}0 & -2 & 1 & 4 \\\\ 1 & 0 & 2 & 3 \\\\ 1 & 1 & 0 & 2\\end{array}\\right]" :db/id #edb/ref 17592186340698} {:answer/id #uuid "d50c28fb-2517-5de6-83c6-0fda23c711b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 1 & -1 & 1 & 2\\end{array}\\right]" :db/id #edb/ref 17592186341011}] :answer-field/correct {:db/id #edb/ref 17592186340679} :answer-field/id #uuid "4f29d7cf-1107-533f-a29c-b3d47d877104" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341519}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7de40719-e1b7-5230-a137-1dc3c55de0ef" :question/math-academy-id "q-72763" :question/problem "Consider the augmented matrix $M,$ given by\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 1 & -1 & 1 & 2\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{3}:={R}_{3}+(-1)\\cdot {R}_{1}$ on $M?$" :question/worked-solution "The operation ${R}_{3}:={R}_{3}+(-1)\\cdot {R}_{1}$ means that we need to add $-1$ times the first row to the third row.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 1 & -1 & 1 & 2\\end{array}\\right]\\,{R}_{3}:={R}_{3}+(-1)\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 1+(-1)(1) & -1+(-1)(0) & 1+(-1)(2) & 2+(-1)(3)\\end{array}\\right] \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 0 & -1 & -1 & -1\\end{array}\\right]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341863 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "059aa882-887d-5963-939d-82931aef6767" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -2 \\\\ 0 & 2 & 0 & 6 \\\\ 0 & 1 & -3 & 10\\end{array}\\right]" :db/id #edb/ref 17592186339173} {:answer/id #uuid "4b0bec89-af06-5c39-a6ae-0b90c1b29c8f" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -2 \\\\ 0 & 2 & 0 & 6 \\\\ 0 & 2 & -3 & 10\\end{array}\\right]" :db/id #edb/ref 17592186339802} {:answer/id #uuid "5eeb714f-153e-596d-a218-51cd00bee02c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & -3 & 7\\end{array}\\right]" :db/id #edb/ref 17592186339971} {:answer/id #uuid "6a24ab21-f606-59a2-ae94-25e33a5c5d35" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -2 \\\\ 0 & 1 & 0 & 6 \\\\ 0 & 0 & -3 & 10\\end{array}\\right]" :db/id #edb/ref 17592186340069} {:answer/id #uuid "8d2c9e9c-f924-5be6-803e-89dd2685301d" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & -2 & 2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 1 & 3 & -7\\end{array}\\right]" :db/id #edb/ref 17592186340394}] :answer-field/correct {:db/id #edb/ref 17592186339971} :answer-field/id #uuid "71d01fb6-6a2b-5600-96a6-bbb4758f192b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341576}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4f7e0cb8-b82b-5c57-8695-0b8e08268369" :question/math-academy-id "q-72786" :question/problem "Consider the augmented matrix $U,$ given by\n\n$$\nU=\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -2 \\\\ 0 & 2 & 0 & 6 \\\\ 0 & -1 & -3 & 4\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the following row operations on $U?$\n\n$$\n\\begin{aligned}{R}_{2} & :=\\frac{1}{2}{R}_{2} \\\\ {R}_{3} & :={R}_{3}+{R}_{2}\\end{aligned}\n$$" :question/worked-solution "Let's list the required operations:\n\n- The operation ${R}_{2}:=\\frac{1}{2}{R}_{2}$ means that we need to multiply the second row of the matrix by $\\frac{1}{2}.$\n\n- The operation ${R}_{3}:={R}_{3}+{R}_{2}$ means that we need to add $1$ times the second row to the third row.\n\nApplying the operations, we obtain the following:\n\n$$\n\\begin{aligned}U & =\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -2 \\\\ 0 & 2 & 0 & 6 \\\\ 0 & -1 & -3 & 4\\end{array}\\right]\\,{R}_{2}:=\\frac{1}{2}\\cdot {R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & -1 & -3 & 4\\end{array}\\right]\\,{R}_{3}:={R}_{3}+{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -2 \\\\ 0 & 1 & 0 & 3 \\\\ 0+0 & -1+1 & -3+0 & 4+3\\end{array}\\right] \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & -3 & 7\\end{array}\\right]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186388069 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f5228249-42b4-5b6c-a34b-688628cf3c23" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & -\\frac{8}{3} & -1 \\\\ 7 & 1 & 3 & 4 \\\\ 6 & -3 & -3 & 0\\end{array}\\right]" :db/id #edb/ref 17592186388071} {:answer/id #uuid "0df908b7-b9cf-5d37-aca8-7f00b46a2051" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ 6 & -3 & -3 & 0\\end{array}\\right]" :db/id #edb/ref 17592186388072} {:answer/id #uuid "afd3402b-d0f0-5d8e-92cd-42bc4ac1d793" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ -2 & 1 & -3 & 0\\end{array}\\right]" :db/id #edb/ref 17592186388073} {:answer/id #uuid "269dae98-aadc-597a-82e7-371420d4533a" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -1 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ -2 & 1 & -3 & 0\\end{array}\\right]" :db/id #edb/ref 17592186388074} {:answer/id #uuid "1ee9af5a-41eb-5f3b-a278-9fcb76973748" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ -2 & -3 & 9 & 0\\end{array}\\right]" :db/id #edb/ref 17592186388075}] :answer-field/correct {:db/id #edb/ref 17592186388073} :answer-field/id #uuid "95465894-f1f7-5a8d-84b8-f2ad025aafe5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186388070}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0f08a2c2-eb16-5d85-a714-beb36e4a0c94" :question/math-academy-id "q-130071" :question/problem "Consider the augmented matrix $A,$ given by\n\n$$\nA=\\left[\\begin{array}{ccc|c}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ 6 & -3 & 9 & 0\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{3}:=-\\frac{1}{3}{R}_{3}$ on $A?$" :question/worked-solution "The operation ${R}_{3}:=-\\frac{1}{3}{R}_{3}$ means that we need to multiply the third row of the matrix by $-\\frac{1}{3}.$\n\nMultiplying the $3$rd row by $-\\frac{1}{3}$, we obtain the following:\n\n$$\n\\begin{aligned}A & =\\left[\\begin{array}{ccc|c}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ 6 & -3 & 9 & 0\\end{array}\\right]\\,{R}_{3}:=(-\\frac{1}{3})\\cdot {R}_{3} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ (-\\frac{1}{3})\\cdot 6 & (-\\frac{1}{3})\\cdot (-3) & (-\\frac{1}{3})\\cdot 9 & (-\\frac{1}{3})\\cdot 0\\end{array}\\right] \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ -2 & 1 & -3 & 0\\end{array}\\right]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393222 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6756ed00-330f-5c8c-8a4d-fbb86cdc2c8e" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ 0 & 5 & 4\\end{array}\\right]" :db/id #edb/ref 17592186393224} {:answer/id #uuid "8dfcb35e-95c9-5403-a320-dcd7face84d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ 0 & -5 & -4\\end{array}\\right]" :db/id #edb/ref 17592186393225} {:answer/id #uuid "d3557d97-0c1d-5853-b9fd-91ee81522e54" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ 0 & 4 & -5\\end{array}\\right]" :db/id #edb/ref 17592186393226} {:answer/id #uuid "7936a577-d3bd-55bd-b9c4-bfcbd8d64f15" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ 0 & -4 & 5\\end{array}\\right]" :db/id #edb/ref 17592186393227} {:answer/id #uuid "3c473b8d-8970-5a89-afb6-b17390deb661" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ 0 & 4 & 5\\end{array}\\right]" :db/id #edb/ref 17592186393228}] :answer-field/correct {:db/id #edb/ref 17592186393228} :answer-field/id #uuid "43860d4a-16fb-54d3-8d76-5164ce10d9b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393223}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7e529998-60b8-53c0-bae5-50351fb55c46" :question/math-academy-id "q-72757" :question/problem "Consider the augmented matrix $T,$ given by\n\n$$\nT=\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ -2 & -2 & 1\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{2}:={R}_{2}+2{R}_{1}$ on $T?$" :question/worked-solution "The operation ${R}_{2}:={R}_{2}+2{R}_{1}$ means that we need to add $2$ times the first row to the second row. \n\nApplying this row operation, we obtain the following:  \n\n$$\n\\begin{aligned}T & =\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ -2 & -2 & 1\\end{array}\\right]\\,{R}_{2}:={R}_{2}+2\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ -2+(2)(1) & -2+(2)(3) & 1+(2)(2)\\end{array}\\right] \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ 0 & 4 & 5\\end{array}\\right]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393229 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76e35e5d-3d96-5355-b632-9dcb08a7d598" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & 2 & 1 \\\\ 0 & 2 & -3 & 2 \\\\ 3 & 4 & -2 & 3\\end{array}\\right]" :db/id #edb/ref 17592186393231} {:answer/id #uuid "37c197ca-a8a9-536c-8b89-25989a9a892c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & 2 & 1 \\\\ 0 & 2 & -3 & 1 \\\\ 3 & 4 & -2 & 3\\end{array}\\right]" :db/id #edb/ref 17592186393232} {:answer/id #uuid "3f1549bb-38c0-5786-af6b-6a9b6ef9bf0a" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & 2 & 1 \\\\ 1 & 5 & -1 & 1 \\\\ 3 & 4 & -2 & 3\\end{array}\\right]" :db/id #edb/ref 17592186393233} {:answer/id #uuid "c179bedb-d3a8-5e87-84d3-747a29243083" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & 2 & 1 \\\\ 3 & 4 & -2 & 3 \\\\ 0 & 2 & -3 & 1\\end{array}\\right]" :db/id #edb/ref 17592186393234} {:answer/id #uuid "eaff7f31-1a3f-5265-bb26-9a65dd39c96f" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & 1 & 2 \\\\ 1 & 5 & 2 & -1 \\\\ 3 & 4 & 3 & -2\\end{array}\\right]" :db/id #edb/ref 17592186393235}] :answer-field/correct {:db/id #edb/ref 17592186393232} :answer-field/id #uuid "af067c4c-af32-5a6c-b8af-bc4ef4997af6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393230}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4f1ba7f0-e4f6-511d-875d-abce33676c37" :question/math-academy-id "q-72760" :question/problem "Consider the augmented matrix $X,$ given by\n\n$$\nX=\\left[\\begin{array}{ccc|c}1 & 3 & 2 & 1 \\\\ 1 & 5 & -1 & 2 \\\\ 3 & 4 & -2 & 3\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{2}:={R}_{2}+(-1)\\cdot {R}_{1}$ on $X?$" :question/worked-solution "The operation ${R}_{2}:={R}_{2}+(-1)\\cdot {R}_{1}$ means that we need to add $-1$ times the first row to the second row. \n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}X & =\\left[\\begin{array}{ccc|c}1 & 3 & 2 & 1 \\\\ 1 & 5 & -1 & 2 \\\\ 3 & 4 & -2 & 3\\end{array}\\right]\\,{R}_{2}:={R}_{2}+(-1)\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 3 & 2 & 1 \\\\ 1+(-1)(1) & 5+(-1)(3) & -1+(-1)(2) & 2+(-1)(1) \\\\ 3 & 4 & -2 & 3\\end{array}\\right] \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 3 & 2 & 1 \\\\ 0 & 2 & -3 & 1 \\\\ 3 & 4 & -2 & 3\\end{array}\\right]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393236 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "756e234a-8217-5c8b-abaa-69ea121a0c6c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 0 & 1 & 0 & 1 \\\\ 7 & -1 & 3 & 1\\end{array}\\right]" :db/id #edb/ref 17592186393238} {:answer/id #uuid "f11a15bf-be0f-553b-b1be-80f41c622717" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 0 & 5 & 0 & 5 \\\\ 7 & -1 & 3 & 1\\end{array}\\right]" :db/id #edb/ref 17592186393239} {:answer/id #uuid "1a9cf17b-a149-5bc6-9345-792b1cc2a3c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 0 & -5 & 0 & 5 \\\\ 7 & -1 & 3 & 1\\end{array}\\right]" :db/id #edb/ref 17592186393240} {:answer/id #uuid "1d4576b0-5970-52fb-8377-b193cb931a98" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 0 & -1 & 0 & 1 \\\\ 7 & -1 & 3 & 1\\end{array}\\right]" :db/id #edb/ref 17592186393241} {:answer/id #uuid "4cfa023b-7905-5d00-83b5-528df496267c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 0 & 1 & 0 & -1 \\\\ 7 & -1 & 3 & 1\\end{array}\\right]" :db/id #edb/ref 17592186393242}] :answer-field/correct {:db/id #edb/ref 17592186393239} :answer-field/id #uuid "bdfc7f8f-fcd9-55fe-82a8-5f2ff5b50086" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393237}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2facacda-0611-5507-a35e-091ce7069bfa" :question/math-academy-id "q-72781" :question/problem "Consider the augmented matrix $N,$ given by\n\n$$\nN=\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 2 & 1 & 2 & 3 \\\\ 7 & -1 & 3 & 1\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{2}:={R}_{2}+(-2)\\cdot {R}_{1}$ on $N?$" :question/worked-solution "The operation ${R}_{2}:={R}_{2}+(-2)\\cdot {R}_{1}$ means that we need to add $-2$ times the first row to the second row.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}N & =\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 2 & 1 & 2 & 3 \\\\ 7 & -1 & 3 & 1\\end{array}\\right]\\,{R}_{2}:={R}_{2}+(-2)\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 2+(-2)(1) & 1+(-2)(-2) & 2+(-2)(1) & 3+(-2)(-1) \\\\ 7 & -1 & 3 & 1\\end{array}\\right] \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 0 & 5 & 0 & 5 \\\\ 7 & -1 & 3 & 1\\end{array}\\right]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186409514 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b4ab753-6b82-5ab8-ba3d-7608aa4c916d" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 0 & 1 & 0 & -1 \\\\ 4 & 3 & 2 & 1\\end{array}\\right]" :db/id #edb/ref 17592186409502} {:answer/id #uuid "194870f0-6df3-5b30-a6cd-f6757f9664e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 0 & 2 & 0 & -1 \\\\ 4 & 3 & 2 & 1\\end{array}\\right]" :db/id #edb/ref 17592186409503} {:answer/id #uuid "1b67b21e-36ae-5c1e-8349-3329a2526d09" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 0 & -2 & 0 & -2 \\\\ 4 & 3 & 2 & 1\\end{array}\\right]" :db/id #edb/ref 17592186409504} {:answer/id #uuid "d17d40c5-c1fa-5dba-9197-d5e6fe380c64" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 0 & -1 & 0 & 1 \\\\ 4 & 3 & 2 & 1\\end{array}\\right]" :db/id #edb/ref 17592186409509} {:answer/id #uuid "ded53cb4-d3ae-5aa7-b6fd-20bffcd08576" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 0 & -2 & 0 & -1 \\\\ 4 & 3 & 2 & 1\\end{array}\\right]" :db/id #edb/ref 17592186409510}] :answer-field/correct {:db/id #edb/ref 17592186409509} :answer-field/id #uuid "7dcb6b06-d72f-52cd-bd8f-33eb7f67405b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409512}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "56624c75-a028-5dc9-962f-9700b721674f" :question/math-academy-id "q-72785" :question/problem "Consider the augmented matrix $V,$ given by\n\n$$\nV=\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 4 & 3 & 2 & 1 \\\\ 1 & -1 & 0 & 3\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the following row operations on $V?$\n\n$$\n\\begin{aligned}{R}_{2} & ↔{R}_{3} \\\\ {R}_{2} & :={R}_{2}+(-1)\\cdot {R}_{1}\\end{aligned}\n$$" :question/worked-solution "Let's list the required operations:\n\n- The operation ${R}_{2}↔{R}_{3}$ means that we need to swap the second and third rows.\n\n- The operation ${R}_{2}:={R}_{2}+(-1)\\cdot {R}_{1}$ means that we need to add $-1$ times the first row to the second row.\n\nApplying the operations, we obtain the following:\n\n$$\n\\begin{aligned}V & =\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 4 & 3 & 2 & 1 \\\\ 1 & -1 & 0 & 3\\end{array}\\right]\\,{R}_{2}↔{R}_{3} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 1 & -1 & 0 & 3 \\\\ 4 & 3 & 2 & 1\\end{array}\\right]\\,{R}_{2}:={R}_{2}+(-1)\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 1+(-1)(1) & -1+(-1)(0) & 0+(-1)(0) & 3+(-1)(2) \\\\ 4 & 3 & 2 & 1\\end{array}\\right] \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 0 & -1 & 0 & 1 \\\\ 4 & 3 & 2 & 1\\end{array}\\right]\\end{aligned}\n$$"}] :knowledge-point/title "Applying Row Operations To an Augmented Matrix"} {:db/id #edb/ref 17592186059773 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059582 :question/id #uuid "a24c9621-793b-5c60-9c47-2b452f0faa2b" :question/math-academy-id "e-4695" :question/problem "Which elementary row operation could transform the matrix $A$ into the matrix $B$, where \n![](images/56/56fd7e343edf6c26f36718a30f899af6c8eaf0cad5f6b07c90ffa93c19df6346.png)" :question/worked-solution "First, notice that the $1$st and the $3$rd rows are the same in both matrices. The only row that has been changed is the $2$nd row. \n\nNow, applying the operation $R_2:=R_2+1 \\cdot R_1,$ we get the following:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}-4 & -2 & 4 \\\\ 4 & 1 & 2 \\\\ 1 & 2 & 3\\end{bmatrix}\\,{R}_{2}:={R}_{2}+1\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}-4 & -2 & 4 \\\\ 4+1\\cdot (-4) & 1+1\\cdot (-2) & 2+1\\cdot 4 \\\\ 1 & 2 & 3\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}-4 & -2 & 4 \\\\ 0 & -1 & 6 \\\\ 1 & 2 & 3\\end{bmatrix} \\\\  & =B\\end{aligned}\n$$\n\nTherefore, the transformation could be done by the operation \n\n$$\nR_2:=R_2+1\\cdot R_1\n$$\n\nor simply\n\n$$\nR_2:=R_2+R_1.\n$$"} :knowledge-point/id #uuid "691b9107-a935-5965-b3ac-0f3a193ce9bd" :knowledge-point/questions [{:db/id #edb/ref 17592186060199 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6a9a638-e29c-5cbb-95da-3c9432fff576" :answer/type {:db/ident :answer.type/math} :answer/value "R_{2}:=R_{2} + R_{3}" :db/id #edb/ref 17592186057655} {:answer/id #uuid "e74c6cd7-7601-5870-a276-a97c972b2d62" :answer/type {:db/ident :answer.type/math} :answer/value "R_{1}:=R_{1} + \\frac{1}{4}R_{2}" :db/id #edb/ref 17592186057656} {:answer/id #uuid "1a8a15ec-ce37-5b11-beb7-6800b50f1cfd" :answer/type {:db/ident :answer.type/math} :answer/value "R_{2}:=\\frac{1}{4}R_{2}" :db/id #edb/ref 17592186057657} {:answer/id #uuid "4be00846-229b-5fb9-8858-1207d8d92927" :answer/type {:db/ident :answer.type/math} :answer/value "R_{2}:=R_{2} + (-3)R_{1}" :db/id #edb/ref 17592186057658} {:answer/id #uuid "6153c56b-fcda-50c4-8d6e-921afef47c5f" :answer/type {:db/ident :answer.type/math} :answer/value "R_{1}↔R_{2}" :db/id #edb/ref 17592186057659}] :answer-field/id #uuid "9f48f084-035b-5804-a392-e1b695b074e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186057654}] :question/id #uuid "e2dc9d0e-faaf-52a3-b487-1837ebe01f47" :question/math-academy-id "q-20240" :question/problem "Which of the following elementary row operations transforms the matrix $A$ into the matrix $B$, where\n$A = \\begin{bmatrix}1 & 2 & 4 \\\\ 4 & 1 & 2 \\\\ 0 & -7 & -14\\end{bmatrix}, B = \\begin{bmatrix}1 & 2 & 4 \\\\ 1 & -5 & -10 \\\\ 0 & -7 & -14\\end{bmatrix}$?"} {:db/id #edb/ref 17592186060203 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ddfed05c-425f-552b-b8cc-895234c69fd3" :answer/type {:db/ident :answer.type/math} :answer/value "R_{3}:=R_{3} + (-3)R_{1}" :db/id #edb/ref 17592186057679} {:answer/id #uuid "1e87f9e1-9cbe-5c36-a131-fbbba14c1293" :answer/type {:db/ident :answer.type/math} :answer/value "R_{3}:=\\frac{1}{3}R_{3}" :db/id #edb/ref 17592186057680} {:answer/id #uuid "3f3782c8-74ea-5e38-92bb-cff6d4a22f36" :answer/type {:db/ident :answer.type/math} :answer/value "R_{1}↔R_{3}" :db/id #edb/ref 17592186057681} {:answer/id #uuid "46d42c59-6fef-5a37-ae48-bc9e582ce69d" :answer/type {:db/ident :answer.type/math} :answer/value "R_{1}↔R_{2}" :db/id #edb/ref 17592186057682} {:answer/id #uuid "6402f5be-8426-5a6f-9157-a02fa3dfe02f" :answer/type {:db/ident :answer.type/math} :answer/value "R_{2}:=R_{2} + 3R_{1}" :db/id #edb/ref 17592186057683}] :answer-field/id #uuid "67101441-c29f-53f5-8a75-53e447a10ce2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186057678}] :question/id #uuid "a2105120-b69b-54ae-a450-1a629e320d19" :question/math-academy-id "q-20389" :question/problem "Which of the following elementary row operations transforms the matrix $X$ into the matrix $Y$, where\n$X = \\begin{bmatrix}7 & 3 & 2 \\\\ 4 & 5 & 2 \\\\ 9 & 3 & 5\\end{bmatrix}, Y = \\begin{bmatrix}9 & 3 & 5 \\\\ 4 & 5 & 2 \\\\ 7 & 3 & 2\\end{bmatrix}$?"} {:db/id #edb/ref 17592186265820 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1af69085-0030-572e-b52e-dcc632cfeb8d" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}+(-2)\\cdot {R}_{1}" :db/id #edb/ref 17592186263254} {:answer/id #uuid "5ebcc636-d88c-55d2-a740-a27caf069c18" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:=\\frac{1}{5}\\cdot {R}_{3}" :db/id #edb/ref 17592186263822} {:answer/id #uuid "780bfbb2-7d3d-56d9-8b2b-a7d0e4c71c99" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}+{R}_{2}" :db/id #edb/ref 17592186264042} {:answer/id #uuid "90babf1e-2cff-5e69-94d1-dffcb8720e1d" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+{R}_{3}" :db/id #edb/ref 17592186264244} {:answer/id #uuid "e15f22cd-b3f4-5838-8dce-e4a76cdee1d4" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+(-\\frac{3}{10})\\cdot {R}_{3}" :db/id #edb/ref 17592186264958}] :answer-field/correct {:db/id #edb/ref 17592186263822} :answer-field/id #uuid "1e506518-b054-5cf5-929f-375c13a354c0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265294}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b8c55c12-17df-581d-b93b-78d07db8cec0" :question/math-academy-id "q-130087" :question/problem "Which of the following elementary row operations transforms the matrix $A$ into the matrix $B$, where\n\n$$\nA=\\begin{bmatrix}5 & 2 & -3 \\\\ -8 & 0 & 2 \\\\ 10 & 5 & -5\\end{bmatrix},\\,B=\\begin{bmatrix}5 & 2 & -3 \\\\ -8 & 0 & 2 \\\\ 2 & 1 & -1\\end{bmatrix}?\n$$" :question/worked-solution "First, notice that the $1$st and the $2$nd rows are the same in both matrices. The only row that has changed is the $3$rd row. \n\nBy considering the given row operations that modify the $3$rd row, we notice that\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}5 & 2 & -3 \\\\ -8 & 0 & 2 \\\\ 10 & 5 & -5\\end{bmatrix} & {R}_{3}:=\\frac{1}{5}\\cdot {R}_{3} \\\\  & ∼\\begin{bmatrix}5 & 2 & -3 \\\\ -8 & 0 & 2 \\\\ 2 & 1 & -1\\end{bmatrix} \\\\  & =B.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{3}:=\\frac{1}{5}\\cdot {R}_{3}.\n$$"} {:db/id #edb/ref 17592186265822 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18eecb6b-e55a-580a-a528-9515405968ac" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+{R}_{2}" :db/id #edb/ref 17592186263237} {:answer/id #uuid "73f8fe8d-5e24-5253-ba73-d97dee5c4859" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:=\\frac{1}{3}\\cdot {R}_{1}" :db/id #edb/ref 17592186264009} {:answer/id #uuid "74c9e1f2-6a6b-56d3-9d44-66769ac34cd5" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{3}" :db/id #edb/ref 17592186264013} {:answer/id #uuid "94ca2a1b-485a-5fd5-b46c-769bb7676a4b" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:=3\\cdot {R}_{1}" :db/id #edb/ref 17592186264273} {:answer/id #uuid "c31b9aac-2e88-5b1a-b16a-3655f0039486" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+(-\\frac{4}{7})\\cdot {R}_{2}" :db/id #edb/ref 17592186264700}] :answer-field/correct {:db/id #edb/ref 17592186264273} :answer-field/id #uuid "879c7689-ba35-53bc-8a73-459e579b54ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265484}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "84b806b0-6ebe-59b8-9bb2-7c89ea346a6f" :question/math-academy-id "q-130095" :question/problem "Which of the following elementary row operations transforms the matrix  $C$ into the matrix $D$, where \n\n$$\nC=\\begin{bmatrix}-2 & 1 & -1 \\\\ 7 & 7 & 2 \\\\ -6 & 1 & 6\\end{bmatrix},\\,D=\\begin{bmatrix}-6 & 3 & -3 \\\\ 7 & 7 & 2 \\\\ -6 & 1 & 6\\end{bmatrix}?\n$$" :question/worked-solution "First, notice that the $2$nd and the $3$rd rows are the same in both matrices. The only row that has changed is the $1$st row. \n\nBy considering the given row operations that modify the $1$st row, we notice that\n\n$$\n\\begin{aligned}C & =\\begin{bmatrix}-2 & 1 & -1 \\\\ 7 & 7 & 2 \\\\ -6 & 1 & 6\\end{bmatrix} & {R}_{1} & :=3\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}-6 & 3 & -3 \\\\ 7 & 7 & 2 \\\\ -6 & 1 & 6\\end{bmatrix} \\\\  & =D.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{1}:=3\\cdot {R}_{1}.\n$$"} {:db/id #edb/ref 17592186265824 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70b5d61f-c9bb-53db-b9f8-776572325e44" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}-{R}_{1}" :db/id #edb/ref 17592186263975} {:answer/id #uuid "80400201-820c-5bf7-9494-f3be26c3120e" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:=(-\\frac{8}{3})\\cdot {R}_{3}" :db/id #edb/ref 17592186264103} {:answer/id #uuid "8cc226bf-c629-576a-a0b1-9200550a1b26" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}↔{R}_{3}" :db/id #edb/ref 17592186264204} {:answer/id #uuid "9d09eadd-fb6a-5d4b-9197-8a7bc4cf994d" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+(-5)\\cdot {R}_{1}" :db/id #edb/ref 17592186264343} {:answer/id #uuid "da0b59f1-817e-5b44-bdcc-047175c24ec1" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=(-\\frac{3}{8})\\cdot {R}_{2}" :db/id #edb/ref 17592186264901}] :answer-field/correct {:db/id #edb/ref 17592186264204} :answer-field/id #uuid "d8120c56-5c2a-5c36-bb8b-b495ce68084e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265620}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "85e6dfb7-2447-51c4-a184-4a363a6b54d0" :question/math-academy-id "q-130100" :question/problem "Which of the following elementary row operations transforms the matrix $E$ into the matrix $F$, where\n\n$$\nE=\\begin{bmatrix}5 & -2 & 3 \\\\ 8 & -3 & 7 \\\\ -3 & 1 & -3\\end{bmatrix},\\,F=\\begin{bmatrix}5 & -2 & 3 \\\\ -3 & 1 & -3 \\\\ 8 & -3 & 7\\end{bmatrix}?\n$$" :question/worked-solution "First, notice that the $1$st row is the same in both matrices. The only rows that have changed are the $2$nd row and the $3$rd row.   \n\nBy considering the given row operations that change both the $2$nd and the $3$rd row, we notice that \n\n$$\n\\begin{aligned}E & =\\begin{bmatrix}5 & -2 & 3 \\\\ 8 & -3 & 7 \\\\ -3 & 1 & -3\\end{bmatrix} & {R}_{2}↔{R}_{3} \\\\  & ∼\\begin{bmatrix}5 & -2 & 3 \\\\ -3 & 1 & -3 \\\\ 8 & -3 & 7\\end{bmatrix} \\\\  & =F.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}↔{R}_{3}.\n$$"} {:db/id #edb/ref 17592186265825 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04b59128-335a-5c7e-a797-47cf712164a4" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+5{R}_{3}" :db/id #edb/ref 17592186263043} {:answer/id #uuid "07b0872a-0ee3-5a48-8b29-e7a390b686f5" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+{R}_{2}" :db/id #edb/ref 17592186263070} {:answer/id #uuid "7ce7255c-8139-5e6e-977f-00a5882719ed" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+\\frac{1}{5}{R}_{3}" :db/id #edb/ref 17592186264077} {:answer/id #uuid "8f523dfa-2a5c-572d-a6a8-32d391eb708f" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{2}" :db/id #edb/ref 17592186264229} {:answer/id #uuid "cf8961fc-9d65-5127-950c-b6ad08adc159" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}+5{R}_{1}" :db/id #edb/ref 17592186264816}] :answer-field/correct {:db/id #edb/ref 17592186263043} :answer-field/id #uuid "f5287a79-37ef-5b18-8c01-fe42f7511edd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265684}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8d79bcd3-c9f6-51cc-bac3-1326fcc4218c" :question/math-academy-id "q-130103" :question/problem "Which of the following elementary row operations transforms the matrix $X$ into the matrix $W$, where\n\n$$\nX=\\begin{bmatrix}0 & 0 & 5 \\\\ 5 & 6 & 10 \\\\ 1 & -1 & -3\\end{bmatrix},\\,W=\\begin{bmatrix}5 & -5 & -10 \\\\ 5 & 6 & 10 \\\\ 1 & -1 & -3\\end{bmatrix}?\n$$" :question/worked-solution "First, notice that the $2$nd and the $3$rd rows are the same in both matrices. The only row that has changed is the $1$st row. \n\nBy considering the given row operations that modify the $1$st row, we notice that\n\n$$\n\\begin{aligned}X & =\\begin{bmatrix}0 & 0 & 5 \\\\ 5 & 6 & 10 \\\\ 1 & -1 & -3\\end{bmatrix}\\,{R}_{1}:={R}_{1}+5\\cdot {R}_{3} \\\\  & ∼\\begin{bmatrix}5 & -5 & -10 \\\\ 5 & 6 & 10 \\\\ 1 & -1 & -3\\end{bmatrix} \\\\  & =W.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{1}:={R}_{1}+5{R}_{3}.\n$$"} {:db/id #edb/ref 17592186287989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f5c7599-29ce-5dfb-b9ba-7e6fb2bf85d8" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}-\\frac{1}{2}{R}_{3}" :db/id #edb/ref 17592186284920} {:answer/id #uuid "3a3de505-4af9-587f-bcca-65ed2365b867" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:=-\\frac{1}{4}{R}_{1}" :db/id #edb/ref 17592186285336} {:answer/id #uuid "5495a455-efc7-5ebe-b382-a6c7dce1ea64" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:=\\frac{1}{4}{R}_{1}" :db/id #edb/ref 17592186285564} {:answer/id #uuid "f489821f-daaf-5cd9-bdf8-076fa189ac14" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:=(-2){R}_{1}" :db/id #edb/ref 17592186287030} {:answer/id #uuid "fd46554d-54cc-5fd1-8d36-7125d02933cd" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+\\frac{1}{4}{R}_{2}" :db/id #edb/ref 17592186287104}] :answer-field/correct {:db/id #edb/ref 17592186285564} :answer-field/id #uuid "5b9e0856-cd52-5230-aead-a0e0ab0fa9b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287343}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bf5f9366-1ce3-5395-93b6-14a04149ebc4" :question/math-academy-id "q-20387" :question/problem "Which of the following elementary row operations transforms the matrix $S$ into the matrix $T$, where\n\n$$\nS=\\begin{bmatrix}60 & 0 & 120 \\\\ 20 & 0 & 40 \\\\ 15 & 0 & 30\\end{bmatrix},\\,T=\\begin{bmatrix}15 & 0 & 30 \\\\ 20 & 0 & 40 \\\\ 15 & 0 & 30\\end{bmatrix}?\n$$" :question/worked-solution "First, notice that the $2$nd and $3$rd rows are the same in both matrices. The only row that has changed is the $1$st row. \n\nBy considering the given row operations that changes the $1$st  row, we notice that\n\n$$\n\\begin{aligned}S & =\\begin{bmatrix}60 & 0 & 120 \\\\ 20 & 0 & 40 \\\\ 15 & 0 & 30\\end{bmatrix} & \\,{R}_{1}:=\\frac{1}{4}\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}15 & 0 & 30 \\\\ 20 & 0 & 40 \\\\ 15 & 0 & 30\\end{bmatrix} \\\\  & =T.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{1}:=\\frac{1}{4}{R}_{1}.\n$$"} {:db/id #edb/ref 17592186341877 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cc83716-bcdd-5971-b345-0a3b056ccd8d" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{3}" :db/id #edb/ref 17592186339517} {:answer/id #uuid "2d77cf58-f845-5176-9aa2-991f2712d10d" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}↔{R}_{1}" :db/id #edb/ref 17592186339527} {:answer/id #uuid "765b9679-06bc-5c19-a38d-2a4e2df30fc9" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{2}+(-5){R}_{1}" :db/id #edb/ref 17592186340183} {:answer/id #uuid "9762987d-0a0c-5c9d-a411-04ea1e36360b" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}↔{R}_{3}" :db/id #edb/ref 17592186340491} {:answer/id #uuid "f9f7715c-928c-5d36-aa0c-fa5710955380" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=2{R}_{3}+4{R}_{1}" :db/id #edb/ref 17592186341337}] :answer-field/correct {:db/id #edb/ref 17592186339517} :answer-field/id #uuid "323bfb27-13db-5ad8-9ce5-e34beac999ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341469}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c70a88ac-8f1d-5e97-afff-9c3f83ff71f2" :question/math-academy-id "q-72850" :question/problem "Which of the following elementary row operations transforms the matrix $U$ into the matrix $V$, where\n\n$$\nU=\\begin{bmatrix}1 & 3 & 2 \\\\ 6 & 4 & 5 \\\\ 1 & 2 & -1\\end{bmatrix},\\,V=\\begin{bmatrix}1 & 2 & -1 \\\\ 6 & 4 & 5 \\\\ 1 & 3 & 2\\end{bmatrix}?\n$$" :question/worked-solution "First, notice that the $2$nd row is the same in both matrices. The only rows that have changed are the $1$st row and the $3$rd row.   \n\nBy considering the given row operations that change both the $1$st and the $3$rd row, we notice that\n\n$$\n\\begin{aligned}U & =\\begin{bmatrix}1 & 3 & 2 \\\\ 6 & 4 & 5 \\\\ 1 & 2 & -1\\end{bmatrix} & \\,{R}_{1}↔{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 2 & -1 \\\\ 6 & 4 & 5 \\\\ 1 & 3 & 2\\end{bmatrix} \\\\  & =V.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{1}↔{R}_{3}.\n$$"} {:db/id #edb/ref 17592186341878 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14beb007-c69a-5ab7-974c-8b10dc220da9" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+{R}_{3}" :db/id #edb/ref 17592186339312} {:answer/id #uuid "195eaddc-f871-5643-a440-887c3d944ede" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+2{R}_{3}" :db/id #edb/ref 17592186339352} {:answer/id #uuid "5638c8ca-be0f-53bb-8e47-8a06ac66a0a5" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{2}" :db/id #edb/ref 17592186339916} {:answer/id #uuid "a87e9a85-4c7f-5663-9658-9578bf406123" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+4{R}_{1}" :db/id #edb/ref 17592186340659} {:answer/id #uuid "dd65c7d4-9bf4-5a81-bb2c-8537f1f6b07f" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}↔{R}_{3}" :db/id #edb/ref 17592186341094}] :answer-field/correct {:db/id #edb/ref 17592186340659} :answer-field/id #uuid "327a5532-0a35-5d86-90b5-6ede866a293a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341471}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4a88dee0-a622-519b-8c88-19f1fcfff46b" :question/math-academy-id "q-72854" :question/problem "Which of the following elementary row operations transforms the matrix $X$ into the matrix $W$, where\n\n$$\nX=\\begin{bmatrix}1 & 1 & 2 \\\\ -4 & -1 & 1 \\\\ 2 & 1 & 6\\end{bmatrix},\\,W=\\begin{bmatrix}1 & 1 & 2 \\\\ 0 & 3 & 9 \\\\ 2 & 1 & 6\\end{bmatrix}?\n$$" :question/worked-solution "First, notice that the $1$st and the $3$rd rows are the same in both matrices. The only row that has changed is the $2$nd row. \n\nBy considering the given row operations that modify the $2$nd row, we notice that\n\n$$\n\\begin{aligned}X & =\\begin{bmatrix}1 & 1 & 2 \\\\ -4 & -1 & 1 \\\\ 2 & 1 & 6\\end{bmatrix}\\,{R}_{2}:={R}_{2}+4\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & 2 \\\\ 0 & 3 & 9 \\\\ 2 & 1 & 6\\end{bmatrix} \\\\  & =W.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}:={R}_{2}+4{R}_{1}.\n$$"} {:db/id #edb/ref 17592186341879 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10fde8ed-c795-5da4-a95b-29e46375fcb5" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+2{R}_{1}" :db/id #edb/ref 17592186339278} {:answer/id #uuid "48f4fc3d-dee9-5c13-9595-5090d724fdc4" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}↔{R}_{3}" :db/id #edb/ref 17592186339781} {:answer/id #uuid "911d1403-8ac9-5500-adca-d4b8a3503e13" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=\\frac{1}{2}{R}_{2}" :db/id #edb/ref 17592186340430} {:answer/id #uuid "e9244a29-e0f3-5ccf-9e6a-6f0730c28beb" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+(-2){R}_{3}" :db/id #edb/ref 17592186341181} {:answer/id #uuid "ee14cd60-0a49-5fe7-9d23-89ee4e2073f7" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}↔{R}_{1}" :db/id #edb/ref 17592186341228}] :answer-field/correct {:db/id #edb/ref 17592186339278} :answer-field/id #uuid "257bad1f-221a-57d2-9d78-0054a16aca97" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341445}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dd718a57-6301-5304-b58e-f8632645f2ed" :question/math-academy-id "q-72856" :question/problem "Which of the following elementary row operations transforms the matrix $K$ into the matrix $L$, where\n\n$$\nK=\\begin{bmatrix}1 & 3 & 2 \\\\ -2 & 4 & -2 \\\\ 0 & -1 & -1\\end{bmatrix},\\,L=\\begin{bmatrix}1 & 3 & 2 \\\\ 0 & 10 & 2 \\\\ 0 & -1 & -1\\end{bmatrix}?\n$$" :question/worked-solution "First, notice that the $1$st and the $3$rd rows are the same in both matrices. The only row that has changed is the $2$nd row. \n\nBy considering the given row operations that modify the $2$nd row, we notice that\n\n$$\n\\begin{aligned}K & =\\begin{bmatrix}1 & 3 & 2 \\\\ -2 & 4 & -2 \\\\ 0 & -1 & -1\\end{bmatrix}\\,{R}_{2}:={R}_{2}+2\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & 2 \\\\ 0 & 10 & 2 \\\\ 0 & -1 & -1\\end{bmatrix} \\\\  & =L.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}:={R}_{2}+2{R}_{1}.\n$$"}] :knowledge-point/title "Identifying the Appropriate Row Operation To Transform One Matrix Into Another"} {:db/id #edb/ref 17592186059774 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059583 :question/id #uuid "f8417bbc-b748-519b-a997-fbb4aed755eb" :question/math-academy-id "e-4696" :question/problem "Given that\n![](images/59/59ee8e91d058e347238320a2bd5496630f33534564f67f901d2ddf89000f0108.png) which elementary row operation could make $a_{22}=0?$" :question/worked-solution "In the given matrix, we have $a_{22}=5$ and we want to perform an elementary row operation that makes $a_{22}=0.$\n\n- We *cannot* make $a_{22}=0$ by switching two rows, because there are no rows with $0$ as the second entry.\n\n- We *cannot* multiply the second row by $0,$ because we are only allowed to multiply rows by *nonzero* constants.\n\n- However, we *can* add a multiple of another row to the $2$nd row to make $a_{22}=0.$\n\nLooking at the first row, we see that $a_{12}=1.$ If we add $-5$ times this entry to $a_{22},$ we will get $a_{22}=0$ as desired. So, the elementary row operation that we need to use is\n\n$$\nR_2 := R_2 + (-5) \\cdot R_1.\n$$\n\nApplying this operation, we obtain the following:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}3 & 1 & -2 \\\\ -1 & 5 & 6 \\\\ 0 & 2 & 4\\end{bmatrix}\\,{R}_{2}:={R}_{2}+(-5)\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}3 & 1 & -2 \\\\ -1+(-5)\\cdot 3 & 5+(-5)\\cdot 1 & 6+(-5)\\cdot (-2) \\\\ 0 & 2 & 4\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}3 & 1 & -2 \\\\ -16 & 0 & 16 \\\\ 0 & 2 & 4\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the desired elemetary row operation is\n\n$$\nR_2 := R_2 + (-5) \\cdot R_1,\n$$\n\nor simply\n\n$$\nR_2 := R_2 -5 R_1.\n$$"} :knowledge-point/id #uuid "0464b51e-8568-521e-96a5-a65c04569c2a" :knowledge-point/questions [{:db/id #edb/ref 17592186060202 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41716f23-ee4c-5bb2-a921-beab82d30ab6" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=(-2){R}_{2}" :db/id #edb/ref 17592186285397} {:answer/id #uuid "b9c8e1e8-c9d8-5c14-aef8-3d331f2305c6" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{3}" :db/id #edb/ref 17592186286481} {:answer/id #uuid "d18900fd-9449-5555-8667-d815a552643c" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}↔{R}_{3}" :db/id #edb/ref 17592186286692} {:answer/id #uuid "eaa65898-2c49-5b99-bcc1-f887fbd2e749" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+(-3){R}_{1}" :db/id #edb/ref 17592186286938} {:answer/id #uuid "ef596c19-3210-593c-9060-0306e67f0299" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+(-2){R}_{3}" :db/id #edb/ref 17592186286983}] :answer-field/correct {:db/id #edb/ref 17592186286983} :answer-field/id #uuid "a3482a72-d76b-517a-a632-b7cefc297370" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287475}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9ec5da5b-045b-5f9b-81d1-dca84ed41202" :question/math-academy-id "q-20388" :question/problem "Given that\n$C=\\begin{bmatrix}4 & 6 & 2 \\\\ 3 & 6 & 4 \\\\ 2 & 3 & 1\\end{bmatrix}$,\nwhich of the following elementary row operations makes ${a}_{22}=0?$" :question/worked-solution "Of the given options, we consider the row operation \n\n$$\n{R}_{2}:={R}_{2}+(-2){R}_{3}.\n$$\n\nApplying the above row operation, we obtain the following:\n\n$$\n\\begin{aligned}C & =\\begin{bmatrix}4 & 6 & 2 \\\\ 3 & 6 & 4 \\\\ 2 & 3 & 1\\end{bmatrix}\\,{R}_{2}:={R}_{2}+(-2)\\cdot {R}_{3} \\\\  & ∼\\begin{bmatrix}4 & 6 & 2 \\\\ -1 & 0 & 2 \\\\ 2 & 3 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}:={R}_{2}+(-2){R}_{3}.\n$$"} {:db/id #edb/ref 17592186060204 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dbacce2f-e401-55d5-b198-479ced06aab8" :answer/type {:db/ident :answer.type/math} :answer/value "R_{2}:=\\frac{1}{3}R_{2}" :db/id #edb/ref 17592186057685} {:answer/id #uuid "ed4da000-e209-5984-82b2-47dcd76ab0db" :answer/type {:db/ident :answer.type/math} :answer/value "R_{2}:=(-1)R_{2}" :db/id #edb/ref 17592186057686} {:answer/id #uuid "fee2cb51-1eff-502c-8aef-dc646f0368ce" :answer/type {:db/ident :answer.type/math} :answer/value "R_{3}↔R_{1}" :db/id #edb/ref 17592186057687} {:answer/id #uuid "19035f05-2f9f-5ad0-9df1-b300d9f2846b" :answer/type {:db/ident :answer.type/math} :answer/value "R_{2}:=R_{2} + R_{1}" :db/id #edb/ref 17592186057688} {:answer/id #uuid "5e83af35-57c0-56fe-9662-1c2a19b19f93" :answer/type {:db/ident :answer.type/math} :answer/value "R_{2}:=R_{2} + (-1)R_{1}" :db/id #edb/ref 17592186057689}] :answer-field/id #uuid "f82aec7f-6798-5202-809c-fbb9a0d39797" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186057684}] :question/id #uuid "45680acf-db20-5a6f-9386-10731c57b3e2" :question/math-academy-id "q-20392" :question/problem "Given that\n$X = \\begin{bmatrix}1 & -2 & 1 \\\\ -1 & 5 & 4 \\\\ 2 & 8 & 3\\end{bmatrix}$,\nwhich of the following elementary row operations makes $a_{21} = 0$?"} {:db/id #edb/ref 17592186265873 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a9cbb2b-c328-5b94-8a04-615184baa2e2" :answ