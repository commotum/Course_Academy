:answer.type/math} :answer/value "⟨-4,3,31⟩" :db/id #edb/ref 17592186429805} {:answer/id #uuid "6c5b071d-27ac-57b7-af6d-728934e76426" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-3,5,31⟩" :db/id #edb/ref 17592186429808} {:answer/id #uuid "745f1be0-1559-5f77-9632-8cdde3498554" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-5,3,31⟩" :db/id #edb/ref 17592186429809} {:answer/id #uuid "cb172289-6398-5303-bbd8-83b5e2e9bc68" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-5,7,31⟩" :db/id #edb/ref 17592186429811} {:answer/id #uuid "dea73573-73e0-539b-8d97-0a1d8ac2f0eb" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-5,3,27⟩" :db/id #edb/ref 17592186429812}] :answer-field/correct {:db/id #edb/ref 17592186429809} :answer-field/id #uuid "e9b496fd-8c3a-561b-bf53-11d88d290ff5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186429816}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3c3b23dc-4bcb-57b2-b0fc-dd67734d3e36" :question/math-academy-id "q-128493" :question/problem "Find a normal vector to the plane\n\n$$\nr=\\begin{bmatrix}-3 \\\\ 17 \\\\ 5\\end{bmatrix}+t\\begin{bmatrix}2 \\\\ -7 \\\\ 1\\end{bmatrix}+s\\begin{bmatrix}3 \\\\ 5 \\\\ 0\\end{bmatrix},\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨2,-7,1⟩$ and $w=⟨3,5,0⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =\\begin{bmatrix}2 \\\\ -7 \\\\ 1\\end{bmatrix}\\times \\begin{bmatrix}3 \\\\ 5 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ 2 & -7 & 1 \\\\ 3 & 5 & 0\\end{vmatrix} \\\\  & =-5i+3j+31k \\\\  & =⟨-5,3,31⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨-5,3,31⟩.$"} {:db/id #edb/ref 17592186490266 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "426d2f86-6e44-5b72-8222-a1d8c826de45" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-3,-5,7⟩" :db/id #edb/ref 17592186489666} {:answer/id #uuid "5ee143c1-2d22-5a6b-8226-53337f0c9aa5" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,1,7⟩" :db/id #edb/ref 17592186489742} {:answer/id #uuid "81af70fa-ea19-54cc-83e0-b0a21fab95e2" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-34,-22,8⟩" :db/id #edb/ref 17592186489809} {:answer/id #uuid "87ba8eac-d335-511b-94ef-29242597cc39" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,-5,1⟩" :db/id #edb/ref 17592186489824} {:answer/id #uuid "a52411c7-786b-5482-9881-e7a8a452b864" :answer/type {:db/ident :answer.type/math} :answer/value "⟨36,22,2⟩" :db/id #edb/ref 17592186489882}] :answer-field/correct {:db/id #edb/ref 17592186489882} :answer-field/id #uuid "8bf0e22c-7173-584a-ae1b-a7c0bd01e586" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490153}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7340caf5-7f57-5ed9-b918-72cd124f498f" :question/math-academy-id "q-70975" :question/problem "Find a normal vector to the plane\n\n$$\nr=⟨0,8,-1⟩+t⟨-1,1,7⟩+s⟨3,-5,1⟩,\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨-1,1,7⟩$ and $w=⟨3,-5,1⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =\\begin{bmatrix}-1 \\\\ 1 \\\\ 7\\end{bmatrix}\\times \\begin{bmatrix}3 \\\\ -5 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ -1 & 1 & 7 \\\\ 3 & -5 & 1\\end{vmatrix} \\\\  & =36i+22j+2k \\\\  & =⟨36,22,2⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨36,22,2⟩.$"}] :knowledge-point/title "Finding a Normal Vector To a Plane Given by Parametric Equation"} {:db/id #edb/ref 17592186119935 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119648 :question/id #uuid "297bda8f-6e33-5cc2-a2e1-5ab6186fa9d0" :question/math-academy-id "e-4941" :question/problem "Find a parametric equation of the plane that passes through the point $C(2,50,-19)$ and is parallel to the lines $\\mathbf{r}= \\langle 2,\\sqrt{6},17 \\rangle + s \\langle -1,7,2 \\rangle$ and $\\mathbf{r}= \\langle 20,-44, 27 \\rangle + t \\langle 2\\sqrt{3},9,-8 \\rangle$." :question/worked-solution "The direction vectors of the lines are $\\mathbf{v_1}=\\langle  -1,7,2  \\rangle$ and $\\mathbf{v_2}=\\langle 2\\sqrt{3},9,-8 \\rangle$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $C(2,50,-19)$ lies on the plane and its position vector is $\\mathbf{c}=\\langle 2,50,-19 \\rangle.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =c+s{v}_{1}+t{v}_{2} \\\\ r & =⟨2,50,-19⟩+s\\,⟨-1,7,2⟩+t\\,⟨2\\sqrt{3},9,-8⟩,\\,s,t\\in (-\\infty ,\\infty )\\end{aligned}\n$$"} :knowledge-point/id #uuid "3061cb06-f57f-57c8-8821-dbd962b1e78e" :knowledge-point/questions [{:db/id #edb/ref 17592186120225 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd010f61-f497-566f-ac0f-c50c695f2870" :answer/type {:db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186390876} {:answer/id #uuid "e4fe09e5-ac83-5e62-97ff-7cc91f6b67c5" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨0,6,2⟩+s⟨3,2,5⟩+t⟨6,-5,10⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390877} {:answer/id #uuid "5b991d71-53b1-55cf-8e90-ebe111f71f38" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨5,-3,1⟩+s⟨8,1,0⟩+t⟨0,6,2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390878} {:answer/id #uuid "c86fee90-6ade-5c0b-9714-4278894c742b" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨5,-3,1⟩+s⟨8,1,0⟩+t⟨6,-5,10⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390879} {:answer/id #uuid "db01346f-8d56-5827-aa82-3725170f51a2" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨5,-3,1⟩+s⟨3,2,5⟩+t⟨0,6,2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390880}] :answer-field/correct {:db/id #edb/ref 17592186390880} :answer-field/id #uuid "cf886e4d-3534-5b42-92f4-88d2e9d1dbe7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186390875}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0602f3f6-acc2-53ef-a72e-b71caa5d5289" :question/math-academy-id "q-33066" :question/problem "Find a parametric equation of the plane that passes through the point $A(5,-3,1)$ and is parallel to the lines $r=⟨8,1,0⟩+s⟨3,2,5⟩$ and $r=⟨6,-5,10⟩+t⟨0,6,2⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨3,2,5⟩$ and ${v}_{2}=⟨0,6,2⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $A(5,-3,1)$ lies on the plane and its position vector is $a=⟨5,-3,1⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =a+s{v}_{1}+t{v}_{2} \\\\ r & =⟨5,-3,1⟩+s⟨3,2,5⟩+t⟨0,6,2⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186120236 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2646d87e-2e74-5757-bc34-02f20d6114fd" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨-2,23,14⟩+s⟨-3,5,4⟩+t⟨4,7,-1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186302705} {:answer/id #uuid "5ff6b838-1af4-5c00-868a-734468c82814" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨-2,23,14⟩+s⟨-3,5,1⟩+t⟨-30,55,25⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186303040} {:answer/id #uuid "68558628-ae8a-519a-9cf8-9a1b1e7f6286" :answer/type {:db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186303091} {:answer/id #uuid "c6a9c33e-fe94-5b43-8ee0-a43a2a47c5eb" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨-2,23,14⟩+s⟨-3,5,1⟩+t⟨4,7,-1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186303676} {:answer/id #uuid "e74734b6-d893-59de-a060-0512213f4bdd" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨-3,5,4⟩+s⟨-2,23,14⟩+t⟨4,7,-1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186303894}] :answer-field/correct {:db/id #edb/ref 17592186302705} :answer-field/id #uuid "b8f249d4-cd35-55dd-9318-5acc4887eb5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186304576}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "88872368-686b-5e7f-9016-e33ff5ee0ad5" :question/math-academy-id "q-33158" :question/problem "Find a parametric equation of the plane that passes through the point $B(-2,23,14)$ and is parallel to the lines $r=⟨-3,5,1⟩+s⟨-3,5,4⟩$ and $r=⟨-30,55,25⟩+t⟨4,7,-1⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨-3,5,4⟩$ and ${v}_{2}=⟨4,7,-1⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $B(-2,23,14)$ lies on the plane and its position vector is $b=⟨-2,23,14⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =b+s{v}_{1}+t{v}_{2} \\\\ r & =⟨-2,23,14⟩+s⟨-3,5,4⟩+t⟨4,7,-1⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$\n\n$$\n\n$$"} {:db/id #edb/ref 17592186262922 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "259294bf-42a6-5b1f-a914-2eeba4786e4b" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨-3,12,-7⟩+s⟨1,3,-5⟩+t⟨1,6,5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186260203} {:answer/id #uuid "3660d937-cc87-5a73-a31f-13375df8d401" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨-7,12,-3⟩+s⟨-5,3,1⟩+t⟨1,5,6⟩,\\,s,t\\in (-\\infty ,\\infty )" :d