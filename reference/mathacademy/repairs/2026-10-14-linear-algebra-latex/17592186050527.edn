 5 & 0 & 7 & 3 \\\\ 5 & -4 & 5 & -2 \\\\ 6 & -2 & 1 & -1\\end{bmatrix} &  & \\,\\begin{aligned}{R}_{3}:={R}_{3}-2{R}_{4}\\end{aligned} \\\\  & ∼\\begin{bmatrix}7 & 0 & 4 & 3 \\\\ 5 & 0 & 7 & 3 \\\\ -7 & 0 & 3 & 0 \\\\ 6 & -2 & 1 & -1\\end{bmatrix} \\\\  & =B\\end{aligned}\n$$\n\nTherefore, the missing elementary row operations are\n\n$\\,$ ${R}_{1}:={R}_{1}+4{R}_{4}\\,$ and $\\,{R}_{2}:={R}_{2}+2{R}_{4}.$"} {:db/id #edb/ref 17592186329695 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0166ede7-ac8b-5aee-a3fc-ae0a17866fce" :answer/type {:db/ident :answer.type/text} :answer/value "${R}_{1}:={R}_{1}+4{R}_{3}\\,$ and $\\,{R}_{4}:={R}_{4}-3{R}_{3}$" :db/id #edb/ref 17592186326949} {:answer/id #uuid "2ccc7768-32ec-5947-9670-1ec97e53d1da" :answer/type {:db/ident :answer.type/text} :answer/value "${R}_{1}:={R}_{1}+4{R}_{3}\\,$ and $\\,{R}_{4}:={R}_{4}+3{R}_{3}$" :db/id #edb/ref 17592186327328} {:answer/id #uuid "54c6de8d-19a8-57aa-96b2-7a92b017ceaa" :answer/type {:db/ident :answer.type/text} :answer/value "${R}_{1}:={R}_{1}-4{R}_{3}\\,$ and $\\,{R}_{4}:={R}_{4}+3{R}_{3}$" :db/id #edb/ref 17592186327667} {:answer/id #uuid "57b8eae7-5346-50fa-98a2-5cd486bfdba3" :answer/type {:db/ident :answer.type/text} :answer/value "${R}_{1}:={R}_{1}-4{R}_{3}\\,$ and $\\,{R}_{4}:={R}_{4}-3{R}_{3}$" :db/id #edb/ref 17592186327701} {:answer/id #uuid "ddddd82a-3c70-51bf-a2eb-edddccc2e4c2" :answer/type {:db/ident :answer.type/text} :answer/value "${R}_{1}:={R}_{1}+3{R}_{3}\\,$ and $\\,{R}_{4}:={R}_{4}-4{R}_{3}$" :db/id #edb/ref 17592186328873}] :answer-field/correct {:db/id #edb/ref 17592186326949} :answer-field/id #uuid "326f90b0-553c-55c5-999d-072fa4528fa2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186329280}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5b4f6183-748c-523a-a6b7-35464ca87075" :question/math-academy-id "q-42918" :question/problem "$$\nA=\\begin{bmatrix}-3 & 1 & 1 & 8 \