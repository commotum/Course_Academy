}_{2}:={C}_{2}-{C}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 6 \\\\ 2 & 7 & 0 \\\\ 1 & 0 & 9\\end{bmatrix} &  & \\,\\begin{aligned}{C}_{3}:={C}_{3}-6{C}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ 2 & 7 & -12 \\\\ 1 & 0 & 3\\end{bmatrix} \\\\  & =B\\end{aligned}\n$$\n\nTherefore, the elementary column operations are\n\n$\\,$ ${C}_{2}:={C}_{2}-{C}_{1}\\,$ and $\\,{C}_{3}:={C}_{3}-6{C}_{1}.$"} {:db/id #edb/ref 17592186357507 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d1a3d24-7126-55ea-a34b-70f76d6fdf52" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}-{C}_{1}\\,$ and $\\,{C}_{3}:={C}_{3}+9{C}_{1}$" :db/id #edb/ref 17592186354786} {:answer/id #uuid "2a853443-5800-574c-9abe-46a222763db5" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}-3{C}_{1}\\,$ and $\\,{C}_{3}:={C}_{3}-3{C}_{1}$" :db/id #edb/ref 17592186355022} {:answer/id #uuid "4e508a67-1aac-59ec-a272-1cb21851645a" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}-{C}_{1}\\,$ and $\\,{C}_{3}:={C}_{3}-9{C}_{1}$" :db/id #edb/ref 17592186355359} {:answer/id #uuid "b487d758-61a1-59b9-9e1a-394a030e8b5e" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}+{C}_{1}\\,$ and $\\,{C}_{3}:={C}_{3}-9{C}_{1}$" :db/id #edb/ref 17592186356251} {:answer/id #uuid "ce82c20b-8830-5dee-81d1-6b8df15c8355" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}-9{C}_{1}\\,$ and $\\,{C}_{3}:={C}_{3}-{C}_{1}$" :db/id #edb/ref 17592186356474}] :answer-field/correct {:db/id #edb/ref 17592186355359} :answer-field/id #uuid "023d35bb-cd43-5544-a5e7-645fb4b23cf1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186356913}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8c748818-492d-57de-bb7c-4dda21885c24" :question/math-academy-id "q-91187" :question/problem "$$\nA=\\begin{bmatrix}1 & 3 & 2 \\\\ 1 & 1 & 9 \\\\ 0 & 4 & 7\\end{bmatrix},\\,B=\\begin{bmatrix}1 & 2 & -7 \\\\ 1 & 0 & 0 \\\\ 0 & 4 & 7\\end{bmatrix}\n$$\n\nBy applying elementary column operations of the form ${C}_{i}:={C}_{i}+k{C}_{1},$ the matrix $A$ can be transformed into the matrix $B.$ What are the elementary column operations?" :question/worked-solution "To transform $A$ into $B,$ we need to make entries to the right of ${a}_{21}=1$ equal to $0.$\n\nTo do this, we can apply the following elementary column operations:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}1 & 3 & 2 \\\\ 1 & 1 & 9 \\\\ 0 & 4 & 7\\end{bmatrix} &  & \\,\\begin{aligned}{C}_{2}:={C}_{2}-{C}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 2 & 2 \\\\ 1 & 0 & 9 \\\\ 0 & 4 & 7\\end{bmatrix} &  & \\,\\begin{aligned}{C}_{3}:={C}_{3}-9{C}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 2 & -7 \\\\ 1 & 0 & 0 \\\\ 0 & 4 & 7\\end{bmatrix} \\\\  & =B\\end{aligned}\n$$\n\nTherefore, the elementary column operations are\n\n$\\,$ ${C}_{1}:={C}_{1}-{C}_{2}\\,$ and $\\,{C}_{3}:={C}_{3}-9{C}_{1}.$"} {:db/id #edb/ref 17592186394847 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7a49d49-b987-592d-a5ab-ef5a39e415ec" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}-2{C}_{3}\\,$ and $\\,{C}_{2}:={C}_{2}+{C}_{3}$" :db/id #edb/ref 17592186394849} {:answer/id #uuid "a725ab5c-38ec-5280-8e6d-bf99ac6248fe" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}-2{C}_{3}\\,$ and $\\,{C}_{2}:={C}_{2}-{C}_{3}$" :db/id #edb/ref 17592186394850} {:answer/id #uuid "c1c70665-108e-5278-aafc-0ea3f14976f7" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}-{C}_{3}\\,$ and $\\,{C}_{2}:={C}_{2}-2{C}_{3}$" :db/id #edb/ref 17592186394851} {:answer/id #uuid "4b2a901c-98ec-57e7-a35c-861ca187014e" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}+2{C}_{3}\\,$ and $\\,{C}_{2}:={C}_{2}-{C}_{3}$" :db/id #edb/ref 17592186394852} {:answer/id #uuid "81d4b256-