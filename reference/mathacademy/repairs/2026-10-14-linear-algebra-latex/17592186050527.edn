15 & 0 & -2 \\\\ 1 & 1 & 2 & 9\\end{bmatrix} &  & \\,\\begin{aligned}{R}_{4}:={R}_{4}-2{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}-4 & 6 & 1 & 1 \\\\ 10 & -29 & 0 & -4 \\\\ 7 & -15 & 0 & -2 \\\\ 9 & -11 & 0 & 7\\end{bmatrix} \\\\  & =B\\end{aligned}\n$$\n\nTherefore, the missing elementary row operations are\n\n$\\,$ ${R}_{3}:={R}_{3}-3{R}_{1}\\,$ and $\\,{R}_{4}:={R}_{4}-2{R}_{1}.$"}] :knowledge-point/title "Using Row Operations to Create a Column of Zeros in a 4x4 Matrix"} :step/id #uuid "8918fe56-d9e1-5eae-97d1-dfc810e443e6" :step/math-academy-id 30053 :step/next {:db/id #edb/ref 17592186162750}} {:db/id #edb/ref 17592186162827 :step/content {:db/id #edb/ref 17592186161966 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161758 :question/id #uuid "cbf8e85c-ffa6-55b9-a087-2a5272f10f25" :question/math-academy-id "e-8049" :question/problem "![](images/81/81176c8bb51128cdaf5d72842e2b2b909b1c41d63249eb3640d745bc9e0c7f9b.png)\n\nConsider the matrices $A$ and $B$ above. By applying three matrix elementary column operations \n\n- $C_1:=\\ldots$\n\n- $C_3:= C_3 - 4C_2$\n\n- $C_4:= \\ldots$\n\neach of the form $C_i:=C_i+kC_2,$ the matrix $A$ can be transformed into the matrix $B.$ What are the missing elementary column operations?" :question/worked-solution "To transform $A$ into $B,$ we need to make entries to the left and to the right of $a_{32}={\\color{blue}\\bbox[lightgray,2pt]{1}}$ equal to ${\\color{red}0}.$\n\nTo do this, we can apply the following elementary column operations:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}7 & -3 & -1 & -6 \\\\ 7 & -2 & -2 & -4 \\\\ -5 & 1 & 4 & 2 \\\\ -8 & -3 & -6 & -4\\end{bmatrix} &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}+5{C}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}-8 & -3 & -1 & -6 \\\\ -3 & -2 & -2 & -4 \\\\ 0 & 1 & 4 & 2 \\\\ -23 & -3 & -6 & -4\\end{bmatrix} &  & \\,\\begin{aligned}{C}_{3}:={C}_{3}-4{C}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}-8 & -3 & 11 & -6 \\\\ -3 & -2 & 6 & -4 \\\\ 0 & 1 & 0 & 2 \\\\ -23 & -3 & 6 & -4\\end{bmatrix} &  & \\,\\begin{aligned}{C}_{4}:={C}_{4}-2{C}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}-8 & -3 & 11 & 0 \\\\ -3 & -2 & 6 & 0 \\\\ 0 & 1 & 0 & 0 \\\\ -23 & -3 & 6 & 2\\end{bmatrix} \\\\  & =B\\end{aligned}\n$$\n\nTherefore, the corresponding elementary column operations are\n\n$\\qquad$ $C_1:=C_1+5C_2\\quad$ and $\\quad C_4:=C_4-2C_2.$"} :knowledge-point/id #uuid "958cdcf3-aaba-5275-85f8-9531f10b3d0e" :knowledge-point/questions [{:db/id #edb/ref 17592186162555 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "915464df-5b28-5e21-9ce7-c5e53914c0e4" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{2}:=C_{2} + 2C_{3}$ and $C_{4}:=C_{4} - C_{3}$" :db/id #edb/ref 17592186160623} {:answer/id #uuid "acebead1-b006-507e-b9ac-0d2f492285a7" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{2}:=C_{2} + 3C_{3}$ and $C_{4}:=C_{4} - 2C_{3}$" :db/id #edb/ref 17592186160624} {:answer/id #uuid "de2280d9-c63e-577e-aa0e-3f77b8fdb1bb" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{2}:=C_{2} + 3C_{3}$ and $C_{4}:=C_{4} + 2C_{3}$" :db/id #edb/ref 17592186160625} {:answer/id #uuid "e7c20803-213e-5aff-9d8f-b82a9b813dbe" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{2}:=C_{2} - C_{3}$ and $C_{4}:=C_{4} - 2C_{3}$" :db/id #edb/ref 17592186160626} {:answer/id #uuid "62589062-1881-5ef2-9996-e06d1b5fdc55" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{2}:=C_{2} - 3C_{3}$ and $C_{4}:=C_{4} - 2C_{3}$" :db/id #edb/ref 17592186160627}] :answer-field/id #uuid "f0b9949a-1e16-59bc-84b5-22fee2765678" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186160622} {:answer-field/choices [{:answer/id #uuid "145a529c-e254-57d6-977d-c517e6cad38e" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}+2{C}_{3}\\,$ and $\\,{C}_{4}:={C}_{4}-{C}_{3}$" :db/id #edb/ref 17592186402836} {:answer/id #uuid "a6adea6e-da8c-598e-b0fd