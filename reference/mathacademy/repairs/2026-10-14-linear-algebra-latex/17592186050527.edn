 9 & -3 & 7 \\\\ 4 & 2 & 1 & -8 \\\\ 5 & 4 & 3 & 3\\end{bmatrix} &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}-2{C}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}0 & 4 & -2 & 8 \\\\ 0 & 9 & -3 & 7 \\\\ 2 & 2 & 1 & -8 \\\\ -1 & 4 & 3 & 3\\end{bmatrix} &  & \\,\\begin{aligned}{C}_{2}:={C}_{2}+2{C}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}0 & 0 & -2 & 8 \\\\ 0 & 3 & -3 & 7 \\\\ 2 & 4 & 1 & -8 \\\\ -1 & 10 & 3 & 3\\end{bmatrix} &  & \\,\\begin{aligned}{C}_{4}:={C}_{4}+4{C}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}0 & 0 & -2 & 0 \\\\ 0 & 3 & -3 & -5 \\\\ 2 & 4 & 1 & -4 \\\\ -1 & 10 & 3 & 15\\end{bmatrix} \\\\  & =B.\\end{aligned}\n$$\n\nTherefore, the corresponding elementary column operations are\n\n$\\,$ ${C}_{1}:={C}_{1}-2{C}_{3}\\,$ and $\\,{C}_{4}:={C}_{4}+4{C}_{3}.$"} {:db/id #edb/ref 17592186402828 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f950a42d-a540-5921-9a3d-d668bd318fcd" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}-4{C}_{1}\\,$ and $\\,{C}_{4}:={C}_{4}+3{C}_{1}$" :db/id #edb/ref 17592186402830} {:answer/id #uuid "01d7bfc6-a04a-533c-8665-b132159f8eb1" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}-3{C}_{1}\\,$ and $\\,{C}_{4}:={C}_{4}+4{C}_{1}$" :db/id #edb/ref 17592186402831} {:answer/id #uuid "ce6ab905-f6c2-51df-be91-308b16286694" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}-2{C}_{1}\\,$ and $\\,{C}_{4}:={C}_{4}+3{C}_{1}$" :db/id #edb/ref 17592186402832} {:answer/id #uuid "fc1548a5-d455-56f1-be69-1c079b40aef3" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}+4{C}_{1}\\,$ and $\\,{C}_{4}:={C}_{4}+3{C}_{1}$" :db/id #edb/ref 17592186402833} {:answer/id #uuid "5a20cf7f-f569-51b2-9f0c-7247587435dd" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}-4{C}_{1}\\,$ and $\\,{C}_{4}:={C}_{4}-3{C}_{1}$" :db/id #edb/ref 17592186402834}] :answer-field/correct {:db/id #edb/ref 17592186402830} :answer-field/id 