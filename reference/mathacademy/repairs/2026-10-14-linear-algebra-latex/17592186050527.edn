 $A$ into $B,$ we need to make entries to the right of ${a}_{21}=1$ equal to $0.$\n\nTo do this, we can apply the following elementary column operations:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}1 & 3 & 2 \\\\ 1 & 1 & 9 \\\\ 0 & 4 & 7\\end{bmatrix} &  & \\,\\begin{aligned}{C}_{2}:={C}_{2}-{C}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 2 & 2 \\\\ 1 & 0 & 9 \\\\ 0 & 4 & 7\\end{bmatrix} &  & \\,\\begin{aligned}{C}_{3}:={C}_{3}-9{C}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 2 & -7 \\\\ 1 & 0 & 0 \\\\ 0 & 4 & 7\\end{bmatrix} \\\\  & =B\\end{aligned}\n$$\n\nTherefore, the elementary column operations are\n\n$\\,$ ${C}_{1}:={C}_{1}-{C}_{2}\\,$ and $\\,{C}_{3}:={C}_{3}-9{C}_{1}.$"} {:db/id #edb/ref 17592186394847 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7a49d49-b987-592d-a5ab-ef5a39e415ec" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}-2{C}_{3}\\,$ and $\\,{C}_{2}:={C}_{2}+{C}_{3}$" :db/id #edb/ref 17592186394849} {:answer/id #uuid "a725ab5c-38ec-5280-8e6d-bf99ac6248fe" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}-2{C}_{3}\\,$ and $\\,{C}_{2}:={C}_{2}-{C}_{3}$" :db/id #edb/ref 17592186394850} {:answer/id #uuid "c1c70665-108e-5278-aafc-0ea3f14976f7" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}-{C}_{3}\\,$ and $\\,{C}_{2}:={C}_{2}-2{C}_{3}$" :db/id #edb/ref 17592186394851} {:answer/id #uuid "4b2a901c-98ec-57e7-a35c-861ca187014e" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}+2{C}_{3}\\,$ and $\\,{C}_{2}:={C}_{2}-{C}_{3}$" :db/id #edb/ref 17592186394852} {:answer/id #uuid "81d4b256-f048-5f14-a7ac-3d309b8b6fe4" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}-6{C}_{3}\\,$ and $\\,{C}_{2}:={C}_{2}-{C}_{3}$" :db/id #edb/ref 17592186394853}] :answer-field/correct {:db/id #edb/ref 17592186394850} :answer-field/id #uuid "788cdc09-4fc8-540a-b4a5-c69fdf43bd48" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186394848}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "50d09abe-1ccb-5c67-80df-655b78fbf493" :question/math-academy-id "q-91192" :question/problem "$$\nA=\\begin{bmatrix}4 & 2 & 2 \\\\ -6 & 7 & 1 \\\\ -7 & -5 & 2\\end{bmatrix},\\,B=\\begin{bmatrix}0 & 0 & 2 \\\\ -8 & 6 & 1 \\\\ -11 & -7 & 2\\end{bmatrix}\n$$\n\nBy applying elementary column operations of the form ${C}_{i}:={C}_{i}+k{C}_{3},$ the matrix $A$ can be transformed into the matrix $B.$ What are the elementary column operations?" :question/worked-solution "To transform $A$ into $B,$ we need to make entries to the left of ${a}_{13}=2$ equal to $0.$\n\nTo do this, we can apply the following elementary column operations:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}4 & 2 & 2 \\\\ -6 & 7 & 1 \\\\ -7 & -5 & 2\\end{bmatrix} &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}-2{C}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}0 & 2 & 2 \\\\ -8 & 7 & 1 \\\\ -11 & -5 & 2\\end{bmatrix} &  & \\,\\begin{aligned}{C}_{2}:={C}_{2}-{C}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}0 & 0 & 2 \\\\ -8 & 6 & 1 \\\\ -11 & -7 & 2\\end{bmatrix} \\\\  & =B\\end{aligned}\n$$\n\nTherefore, the elementary column operations are\n\n$\\,$ ${C}_{1}:={C}_{1}-2{C}_{3}\\,$ and $\\,{C}_{2}:={C}_{2}-{C}_{3}.$"} {:db/id #edb/ref 17592186412026 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "166feab7-a264-55aa-acc5-4218b97966a9" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}-2{C}_{1}\\,$ and $\\,{C}_{3}:={C}_{3}+{C}_{1}$" :db/id #edb/ref 17592186412014} {:answer/id #uuid "4c552dee-9870-5f80-99c4-13a42caad182" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}+3{C}_{1}\\,$ and $\\,{C}_{3}:={C}_{3}+2{C}_{1}$" :db/id #edb/ref 17592186412017} {:answer/id #uuid "99b872c0-2012-5d57-9afd-16e6b6bde53b" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}+2{C}_{1}\\,$ and $\\,{C}_{3}: