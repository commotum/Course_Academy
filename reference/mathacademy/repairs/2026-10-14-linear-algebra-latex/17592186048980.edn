ref 17592186340851} {:answer/id #uuid "ca366175-0694-5a41-b05d-54da41240eae" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{41}$ only" :db/id #edb/ref 17592186340918} {:answer/id #uuid "ce709e9e-af22-552e-b450-be6e9b13af12" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{33}$ and ${a}_{41}$ only" :db/id #edb/ref 17592186340964}] :answer-field/correct {:db/id #edb/ref 17592186340964} :answer-field/id #uuid "376fe002-648d-5f2e-a527-df3b16389230" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341480}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b1197e9c-9cbb-5cfc-8f5c-c95842ee4a3f" :question/math-academy-id "q-73154" :question/problem "Consider the matrix $A$ given below.\nWhich entries of $A$ could be replaced by $0$ in order to get a matrix in row echelon form?\n\n$$\nA=\\begin{bmatrix}5 & 1 & 0 & 3 \\\\ 0 & 0 & 6 & 0 \\\\ 0 & 0 & 3 & 0 \\\\ 1 & 0 & 0 & 0\\end{bmatrix}\n$$" :question/worked-solution "Notice that by replacing ${a}_{33}$ and ${a}_{41}$ with $0$, we get a matrix in row echelon form:\n\n$$\nA=\\begin{bmatrix}5 & 1 & 0 & 3 \\\\ 0 & 0 & 6 & 0 \\\\ 0 & 0 & 3 & 0 \\\\ 1 & 0 & 0 & 0\\end{bmatrix}\\,⟶\\,\\begin{bmatrix}5 & 1 & 0 & 3 \\\\ 0 & 0 & 6 & 0 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}.\n$$\n\nThe other options will not give us a matrix in row echelon form."} {:db/id #edb/ref 17592186402803 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b0bafaf-8dbb-5862-adfc-ea4a5627d6e6" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{22}$ and ${a}_{31}$ only" :db/id #edb/ref 17592186402805} {:answer/id #uuid "51a1d5ef-bb24-57b9-8e5f-df855915d4f6" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{31}$ and ${a}_{41}$ only" :db/id #edb/ref 17592186402806} {:answer/id #uuid "00548f4b-907b-5549-a159-574002d99445" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{41}$ only" :db/id #edb/ref 17592186402807} {:answer/id #uuid "e6a498aa-50d0-5a9f-9598-532b0d569048" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{22}$ and ${a}_{41}$ only" :db/id #edb/ref 17592186402808} {:answer/id #uuid "7f326825-ad7d-5868-81cc-11851f2f09a4" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{11}$ and ${a}_{22}$ only" :db/id #edb/ref 17592186402809}] :answer-field/correct {:db/id #edb/ref 17592186402806} :answer-field/id #uuid "e19073ec-b0ab-5ca4-a2db-dda76dda434a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186402804}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4345cd19-b7ef-5838-8cce-11c3300963ff" :question/math-academy-id "q-42372" :question/problem "Consider the matrix $A$ given below.\nWhich entries of $A$ could be replaced by $0$ in order to get a matrix in row echelon form?\n\n$$\nA=\\begin{bmatrix}1 & -2 & 3 & -4 \\\\ 0 & 1 & 5 & 0 \\\\ -5 & 0 & 0 & 3 \\\\ 7 & 0 & 0 & 0\\end{bmatrix}\n$$" :question/worked-solution "Notice that by replacing ${a}_{31}$ and ${a}_{41}$ with $0$, we get a matrix in row echelon form:\n\n$$\nA=\\begin{bmatrix}1 & -2 & 3 & -4 \\\\ 0 & 1 & 5 & 0 \\\\ -5 & 0 & 0 & 3 \\\\ 7 & 0 & 0 & 0\\end{bmatrix}\\,⟶\\,\\begin{bmatrix}1 & -2 & 3 & -4 \\\\ 0 & 1 & 5 & 0 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}.\n$$\n\nThe other options will not give us a matrix in row echelon form."} {:db/id #edb/ref 17592186413822 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e03e0f4-f6d8-5e5e-be1b-2065040084b9" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{43}$ only" :db/id #edb/ref 17592186413799} {:answer/id #uuid "2231485a-d292-515f-b51b-91f31ecd0efe" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{32}$, ${a}_{43}$ and ${a}_{44}$ only" :db/id #edb/ref 17592186413804} {:answer/id #uuid "82eb2341-c973-51c4-a691-9aab4038100d" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{32}$ only" :db/id #edb/ref 17592186413808} {:answer/id #uuid "a5bcd7de-6ec8-511e-9e85-d25e1afb7c50" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{32}$ and ${a}_{22}$ only" :db/id #edb/ref 17592186413809} {:answer/id #uuid "dbd6ae2c-f7e4-5a2b-9120-ea5f2f442053" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{32}$ and ${a}_{43}$ only" :db/id #edb/ref 17592186413815}] :answer-field/correct {:db/id #edb/ref 17592186413804} :answer-field/id #uuid "c9772538-fd34-5f2a-b5f8-a7d295110074" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186413821}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "17d0a606-b191-57ce-bda5-cb6bdd31b9a8" :question/math-academy-id "q-42373" :question/problem "Consider the matrix $A$ given below.\nWhich entries of $A$ could be replaced by $0$ in order to get a matrix in row echelon form?\n\n$$\nA=\\begin{bmatrix}-1 & 5 & 0 & 0 \\\\ 0 & -1 & 2 & 3 \\\\ 0 & -1 & 0 & 2 \\\\ 0 & 0 & 2 & 4\\end{bmatrix}\n$$" :question/worked-solution "Notice that by replacing ${a}_{32}$, ${a}_{43}$ and ${a}_{44}$ with $0$, we get a matrix in row echelon form:\n\n$$\nA=\\begin{bmatrix}-1 & 5 & 0 & 0 \\\\ 0 & -1 & 2 & 3 \\\\ 0 & -1 & 0 & 2 \\\\ 0 & 0 & 2 & 4\\end{bmatrix}\\,⟶\\,\\begin{bmatrix}-1 & 5 & 0 & 0 \\\\ 0 & -1 & 2 & 3 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}.\n$$\n\nThe other options will not give us a matrix in row echelon form."}] :knowledge-point/title "Identifying Operations That Would Transform a Matrix To Row Echelon Form"} :step/id #uuid "ed25462b-dcf5-53b8-af91-93afa32dea4c" :step/math-academy-id 17178} {:db/id #edb/ref 17592186130041 :step/content {:db/id #edb/ref 17592186130380 :tutorial/content "Let's consider our matrices $A$ and $B$ once more, with the leading entries highlighted.\n\n![](images/af/af61f32297e248ab9989ba59ea6c9bda2f99efe19d25df525fef916617843a32.svg)\n\nWe say that a matrix is in **row echelon form** if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nHere, $B$ is in row echelon form since both conditions are satisfied. However, $A$ is not in row echelon form since condition II is violated: the leading entry of the third row $(a_{32}={\\color{red}1})$ is placed just below the leading entry of the second row $(a_{22}=3).$\n\nGenerally speaking, row echelon form means that we have *stairs* where each step (represented by a leading entry $\\bbox[lightgray, 3pt]{\\large\\ast}$) has a height of $1.$\n\n![](images/67/67f83c454e59d16ae80cf67a19b19f968182251a2e5d1b405e2c422e0313d5b7.png)\n\nFinally, an *augmented* matrix is in row echelon form if the coefficient matrix (i.e., the part that is to the left of the vertical bar) is in row echelon form." :tutorial/id #uuid "137b0909-9a5e-5edf-8019-24e803307903" :tutorial/math-academy-id 3896 :tutorial/title "Row Echelon Form"} :step/id #uuid "1430eddc-7fc0-5265-81de-85b9a44bbf70" :step/math-academy-id 23024 :step/next {:db/id #edb/ref 17592186129940}} {:db/id #edb/ref 17592186130042 :step/content {:db/id #edb/ref 17592186129176 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128995 :question/id #uuid "7fd5c01f-c20e-5c47-b8d9-8cfbe634c14d" :question/math-academy-id "e-6166" :question/problem "What is the sum of the leading entries of the $1$st, $3$rd and $4$th rows in the matrix $A,$ given below?\n![](images/85/8579b0afd584298a247c38af153d4e69945e73923e9605a168734c9250f3d18a.svg)" :question/worked-solution "The first non-zero entry of each row (from left to right) is the leading entry. \n\nTherefore, the leading entries of the $1$st, $3$rd and $4$th rows of $A$ are $-1$, $-4$ and $8$, respectively.\n\n![](images/11/11af9a5354d23586af399f9bfade0641e9bb10898068ea825755de5c645e3d9c.svg)\n\nSo, the answer is $-1+(-4)+8=3.$"} :knowledge-point/id #uuid "31c3678b-4f00-54d6-bb84-c7718fd622cb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050163}] :knowledge-point/questions [{:db/id #edb/ref 17592186129776 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5da3307-45b7-5e9f-a6a9-658f6827340b" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186128138} {:answer/id #uuid "bc8cbdc7-7567-56cc-8d55-dc3c4c7b565a" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186128139} {:answer/id #uuid "dbdcaeb0-9527-5770-8701-cba329b9819b" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186128140} {:answer/id #uuid "e296c04e-9507-5a04-b94f-9d47fdb50e15" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186128141} {:answer/id #uuid "33bc9a7c-58bf-52ef-9a75-10ceecc3d143" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186128142}] :answer-field/id #uuid "7befadfa-ae8b-5031-b843-c2f8edff91b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186128137}] :question/id #uuid "a2cf9f95-71df-5204-ad8a-59de853d764f" :question/math-academy-id "q-42362" :question/problem "What is the sum of the leading entries of the $2$nd, $3$rd, and $4$th rows in the matrix $A$, given below?\n$A = \\begin{bmatrix}2 & 4 & 6 & 1 \\\\ 0 & 3 & 2 & 0 \\\\ 0 & 1 & 0 & 1 \\\\ 0 & 0 & 2 & -2\\end{bmatrix}$"} {:db/id #edb/ref 17592186129777 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93adc8f4-4ed3-5fa8-868c-0f2a9799cda4" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186128144} {:answer/id #uuid "bc2e8202-0303-5b4b-9dc0-6e1d26fda482" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186128145} {:answer/id #uuid "0947f161-c462-5ea8-94ec-fae218820ca5" :answer/type {:db/ident :answer.type/math} :answer/value