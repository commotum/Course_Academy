9 \\\\ 0 & 2 & 2 & 7 \\\\ 0 & 0 & 1 & 5 \\\\ 0 & 0 & 0 & 3\\end{bmatrix}\n$$\n\nTherefore, only $C$ is in row echelon form."}] :knowledge-point/title "Identifying Matrices in Row Echelon Form"} :step/id #uuid "d00efb7b-6c6d-5f75-a839-fd2c4b29adfc" :step/math-academy-id 17177 :step/next {:db/id #edb/ref 17592186129939}} {:db/id #edb/ref 17592186129941 :step/content {:db/id #edb/ref 17592186129115 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128927 :question/id #uuid "97237f8e-b317-5c86-86d1-8fd3cc83e66b" :question/math-academy-id "e-4689" :question/problem "Consider the matrix $A$ given below.\nWhich entries of $A$ could be replaced by $0$ in order to get a matrix in row echelon form?\n![](images/aa/aad9e35c3e07e67260a7f3ce96da685be97fab68fe542d262be0ed4f0941f909.svg)" :question/worked-solution "Notice that by replacing $a_{32}$, $a_{42}$, and $a_{43}$ with $0$, we get a matrix in row echelon form:\n![](images/f8/f89c32a7464b2eeb0f6db6a2c80feef98e8aa24d012b44695e7c7d24b91829ec.svg)"} :knowledge-point/id #uuid "fe0050b2-b5bc-54a6-aeaf-94cd5d7e5dfb" :knowledge-point/questions [{:db/id #edb/ref 17592186129772 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "235dc5af-aefe-5bea-8651-43b78d1c968f" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{21}$ and ${a}_{43}$ only" :db/id #edb/ref 17592186324261} {:answer/id #uuid "2e25d52d-b3a1-56c2-a229-c83120279d9b" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{21}$,  ${a}_{33}$, and ${a}_{44}$ only" :db/id #edb/ref 17592186324339} {:answer/id #uuid "7abca97a-1851-5e67-9633-f11bcb2e2e30" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{22}$ and ${a}_{33}$ only" :db/id #edb/ref 17592186324999} {:answer/id #uuid "982046e6-3f52-5bfb-bc6b-db4bf8c78d69" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{21}$ only" :db/id #edb/ref 17592186325263} {:answer/id #uuid "e435a192-10d9-5156-8113-e7659f0e7728" :answer/type {:db/ident :answer.type/text