& 4 & -2 \\\\ 0 & 0 & 0 & 0 & 0 \\\\ 0 & 0 & 1 & 4 & 4\\end{bmatrix},\\,C=\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & -1 \\\\ 0 & -1 & 0 \\\\ 4 & 0 & 7 \\\\ 0 & 0 & 0\\end{bmatrix}.\n$$\n\nSelect all that apply." :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is in row echelon form (both conditions are satisfied).\n\n$$\nA=\\begin{bmatrix}6 & 0 & 3 & 0 \\\\ 0 & 0 & 5 & 1 \\\\ 0 & 0 & 0 & 3\\end{bmatrix}\n$$\n\n- The matrix $B$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nB=\\begin{bmatrix}1 & 0 & 3 & 4 & -2 \\\\ 0 & 0 & 0 & 0 & 0 \\\\ 0 & 0 & 1 & 4 & 4\\end{bmatrix}\n$$\n\n- The matrix $C$ is not in row echelon form since the leading entry ${c}_{32}\\ne 0$ (condition II is violated). \n\n$$\nC=\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & -1 \\\\ 0 & -1 & 0 \\\\ 4 & 0 & 7 \\\\ 0 & 0 & 0\\end{bmatrix}\n$$\n\nTherefore, only $B$ and $C$ are **not** in row echelon form."} {:db/id #edb/ref 17592186339127 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aad04b9e-e1c0-5bb1-8988-f13ae2b12a53" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467944} {:answer/id #uuid "182256c0-eed4-5308-8899-646442169606" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467945}] :answer-field/correct {:db/id #edb/ref 17592186467944} :answer-field/id #uuid "e337cd9d-13a4-5dac-9234-3d41da87d9a0" :answer-field/key "A" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468693} {:answer-field/choices [{:answer/id #uuid "0777136a-d863-5438-b95f-bc866c333a22" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467946} {:answer/id #uuid "96cecc84-650b-5579-bf1d-d6d830e791b7" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467947}] :answer-field/correct {:db/id #edb/ref 17592186467947} :answer-field/id #uuid "a790397a-6735-5a19-8785-3d13a0ca79b8" :answer-field/key "B" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468694} {:answer-field/choices [{:answer/id #uuid "72991cce-897b-580a-82d9-a6ea9e4374ce" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467948} {:answer/id #uuid "44145af0-fb61-51cd-b673-1a7fef08d8a1" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467949}] :answer-field/correct {:db/id #edb/ref 17592186467948} :answer-field/id #uuid "05c578b4-fa57-5327-837b-e40c8423b3ba" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468695}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "937eaf0d-76e6-56ec-a651-23458856322a" :question/math-academy-id "q-72498" :question/problem "Which of the following matrices are in row echelon form?\n\n$$\nA=\\begin{bmatrix}1 & 3 & 5 \\\\ 0 & 2 & 0 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}0 & 4 & 6 & 10 \\\\ 0 & 0 & 6 & 7 \\\\ 0 & 0 & 0 & 1\\end{bmatrix},\\,C=\\begin{bmatrix}3 & 5 & 0 & 2 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 3 & 4 & 1\\end{bmatrix}.\n$$\n\nSelect all that apply." :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$  is not in row echelon form since ${a}_{32}\\ne 0$ (condition II is violated). \n\n$$\nA=\\begin{bmatrix}1 & 3 & 5 \\\\ 0 & 2 & 0 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 1\\end{bmatrix}\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\begin{bmatrix}0 & 4 & 6 & 10 \\\\ 0 & 0 & 6 & 7 \\\\ 0 & 0 & 0 & 1\\end{bmatrix}\n$$\n\n- The matrix $C$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nC=\\begin{bmatrix}3 & 5 & 0 & 2 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 3 & 4 & 1\\end{bmatrix}\n$$\n\nTherefore, only $B$ is in row echelon form."} {:db/id #edb/ref 17592186400408 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c011bf74-4e03-5659-a095-597e0524fce9" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472586} {:answer/id #uuid "e64784ae-73a3-527e-a9ca-515e7c49ea94" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472587}] :answer-field/correct {:db/id #edb/ref 17592186472587} :answer-field/id #uuid "129c2acd-23b9-5242-b875-c0ced1c0d4f2" :answer-field/key "A" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186473688} {:answer-field/choices [{:answer/id #uuid "6839a05c-d515-556e-8ab4-1b643298e3ef" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472588} {:answer/id #uuid "56dd2d05-be36-50c6-ba0a-273536e978cd" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472589}] :answer-field/correct {:db/id #edb/ref 17592186472589} :answer-field/id #uuid "30de0c38-b03c-53b4-9e5a-aecafb7542d8" :answer-field/key "B" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186473689} {:answer-field/choices [{:answer/id #uuid "4aa9083a-2e35-58cc-aa7f-4cb905ebf3a5" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472590} {:answer/id #uuid "474b59f6-2c15-5712-8de6-b7b3cc94ba29" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472591}] :answer-field/correct {:db/id #edb/ref 17592186472590} :answer-field/id #uuid "4390b2a3-3b01-57b6-ad09-9ca4d3b9b3f5" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186473690}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6061d8ea-d309-5b82-8a65-c5a4fc1b804c" :question/math-academy-id "q-129213" :question/problem "Which of the following matrices are in row echelon form?\n\n$$\nA=\\begin{bmatrix}-2 & 0 & 3 & 1 \\\\ 0 & 5 & 0 & -4 \\\\ 0 & 0 & 1 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix},\\,B=\\begin{bmatrix}0 & -1 & 2 & -5 \\\\ 0 & 0 & 1 & 3 \\\\ 0 & 0 & 0 & 7\\end{bmatrix},\\,C=\\begin{bmatrix}1 & 0 & -1 & 0 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 5 & 0 & 0 \\\\ 0 & 0 & 0 & -9\\end{bmatrix}.\n$$\n\nSelect all that apply." :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\nI. All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n\nII. Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is in row echelon form (both conditions are satisfied).\n\n$$\nA=\\begin{bmatrix}-2 & 0 & 3 & 1 \\\\ 0 & 5 & 0 & -4 \\\\ 0 & 0 & 1 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\begin{bmatrix}0 & -1 & 2 & -5 \\\\ 0 & 0 & 1 & 3 \\\\ 0 & 0 & 0 & 7\\end{bmatrix}\n$$\n\n- The matrix $C$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nC=\\begin{bmatrix}1 & 0 & -1 & 0 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 5 & 0 & 0 \\\\ 0 & 0 & 0 & -9\\end{bmatrix}\n$$\n\nTherefore, only $A$ and $B$ are in row echelon form."} {:db/id #edb/ref 17592186400415 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69bcd314-df9c-5935-9335-a09fa25e8d41" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472592} {:answer/id #uuid "8865af33-97aa-5c4a-9244-e60cc4cee987" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472593}] :answer-field/correct {:db/id #edb/ref 17592186472592} :answer-field/id #uuid "9c83300b-74eb-54e0-bc36-0514d541679a" :answer-field/key "A" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186473691} {:answer-field/choices [{:answer/id #uuid "38fb9531-056d-5ceb-831d-52b028bb8fda" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472594} {:answer/id #uuid "06492854-4f41-5760-9db6-f1fac392f7d1" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472595}] :answer-field/correct {:db/id #edb/ref 17592186472595} :answer-field/id #uuid "45575979-eedd-534e-af96-a411d45a5c4e" :answer-field/key "B" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186473692} {:answer-field/choices [{:answer/id #uuid "f63471c3-8442-5cfa-ba81-ee7d063a01bb" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472596} {:answer/id #uuid "082ec0b2-e3c9-53c6-83cb-f251e283c424" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472597}] :answer-field/correct {:db/id #edb/ref 17592186472597} :answer-field/id #uuid "b65cc9f6-519d-53a0-9c92-4a7de7fe1e03" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186473693}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8f982d65-21d3-5ca8-afbe-be436c69b22a" :question/math-academy-id "q-129217" :question/problem "Which of the following matrices are in row echelon form?\n\n$$\nA=\\begin{bmatrix}1 & 0 & 2 & -1 & 1 \\\\ 0 & 0 & -2 & 3 & 0 \\\\ 0 & 0 & 0 & 0 & 5 \\\\ 0 & 0 & 0 & 0 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}-5 & 0 & -1 \\\\ 0 & 0 & 3 \\\\ 0 & 0 & 0\\end{bmatrix},\\,C=\\begin{bmatrix}0 & 2 & 0 & -1 \\\\ 0 & 0 & 2 & 1 \\\\ 0 & 0 & 0 & -1 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}.\n$$\n\nSelect all that apply." :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\nI. All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n\nII. Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since the leading entry ${a}_{45}\\ne 0$ (condition II is violated). \n\n$$\nA=\\begin{bmatrix}1 & 0 & 2 & -1 & 1 \\\\ 0 & 0 & -2 & 3 & 0 \\\\ 0 & 0 & 0 & 0 & 5 \\\\ 0 & 0 & 0 & 0 & 1\\end{bmatrix}\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\begin{bmatrix}-5 & 0 & -1 \\\\ 0 & 0 & 3 \\\\ 0 & 0 & 0\\end{bmatrix}\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=\\begin{bmatrix}0 & 2 & 0 & -1 \\\\ 0 & 0 & 2 & 1 \\\\ 0 & 0 & 0 & -1 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\n$$\n\nTherefore, only $B$ and $C$ are in row echelon form."} {:db/id #edb/ref 17592186400422 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6a10c6a-c273-5b60-aa1d-e7a83843eb27" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472598} {:answer/id #uuid "f0d03d0c-023e-5dfc-96d5-00773119971d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472599}] :answer-field/correct {:db/id #edb/ref 17592186472599} :answer-field/id #uuid "cbd4469b-951d-544d-97f3-8ed77d2160e8" :answer-field/key "A" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186473694} {:answer-field/choices [{:answer/id #uuid "e0548548-12e3-5f3a-9a0d-c7bb8784abca" :answer/ty