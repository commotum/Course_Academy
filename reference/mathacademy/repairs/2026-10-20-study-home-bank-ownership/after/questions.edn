d}\n$$\n\nSetting up our points and drawing our line segments, we get the following diagram.\n\n![](images/2e/2e0a934b40d6ff2955cdbb9d4af2e5bf834ea59c13a212ccd128ffb04f2663e2.png)"} {:db/id #edb/ref 17592186526334 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cdf06b9-0ec4-5811-a3ae-b9d9e29a16cd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/78/783718942621381675559793bcfbffc933a3b475b411da20b577a9ff86c8d220.png" :db/id #edb/ref 17592186526304} {:answer/id #uuid "1f81ed22-0259-5ba8-83a9-3990a9bfb9ba" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c2/c285ad3d0e1131020ff3a769c7984a65bf64de4b0902821f1db46c8ffab2d3db.png" :db/id #edb/ref 17592186526309} {:answer/id #uuid "2059c211-7671-56cf-beb5-3f860c7789bd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f5/f5fa28a440278e54d5d2463c91c494b091e2473430857ebe437196ef1feb1000.png" :db/id #edb/ref 17592186526311} {:answer/id #uuid "99979a10-c07a-56ad-badc-a77e7e0e7788" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/df/df1b5e97bd1a74c6d54f0e7f57b592186336430d6fcc779302d6f5ead9962d7b.png" :db/id #edb/ref 17592186526342} {:answer/id #uuid "f33c98fd-0532-5521-8689-d95b9e3629f4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/15/1520124880f8f1a1f62b5f32f1d8d279234d3e539bdf1650aced55d25dab7a40.png" :db/id #edb/ref 17592186526363}] :answer-field/correct {:answer/id #uuid "1f81ed22-0259-5ba8-83a9-3990a9bfb9ba" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c2/c285ad3d0e1131020ff3a769c7984a65bf64de4b0902821f1db46c8ffab2d3db.png" :db/id #edb/ref 17592186526309} :answer-field/id #uuid "6d4c88c0-dd99-5cae-8049-3bbbefd1e1d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186526333}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "73fbe9c8-3536-5207-91d6-fc946d7384b3" :question/problem "Which of the following diagrams gives the slope field at the points indicated for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{2}-(2)xy?$" :question/retired true :question/worked-solution "We have to sketch the slope field at the points $(-1,-1)$,$(0,3)$,$(1,-1)$.\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation.\n\n$$\n\\begin{aligned} & {\\frac{\\text{d}y}{\\text{d}x}|}_{(-1,-1)}=\\frac{1}{2}-2(-1)(-1)=\\frac{1}{2}-(2)=- \\frac{3}{2}, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(0,3)}=\\frac{1}{2}-2(0)(3)=\\frac{1}{2}-(0)=\\frac{1}{2}, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(1,-1)}=\\frac{1}{2}-2(1)(-1)=\\frac{1}{2}-(-2)=\\frac{5}{2}.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following diagram.\n\n![](images/c2/c285ad3d0e1131020ff3a769c7984a65bf64de4b0902821f1db46c8ffab2d3db.png)"} {:db/id #edb/ref 17592186526341 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06a901d5-ca4f-5737-bade-9a3f95e9fcd3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/93/93ca31dd0832f9b09274e8357adfb1b27cefac07efc2ea1fdae1cadff7fa3b69.png" :db/id #edb/ref 17592186526301} {:answer/id #uuid "2c0977f8-8622-51a6-88a6-3fc7164c99ad" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d8/d8014fb86ea2854bf8184fb5aa805fe0b6d3e1a8261622bbf6f5f619a8ce1ed2.png" :db/id #edb/ref 17592186526315} {:answer/id #uuid "4390a21d-ba70-57a9-93e0-edfc65e04c1e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3d/3d41555957cd320f3631109842e318bb713699b0dcebc428f4fd644675c807a2.png" :db/id #edb/ref 17592186526324} {:answer/id #uuid "8d4f1112-d5b0-57c6-92ab-ecb8479ec106" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9d/9d155a396810956274ddd882f0936851ff5cb5d8fce675323359f44b77e118d8.png" :db/id #edb/ref 17592186526339} {:answer/id #uuid "cd1aa56d-e965-583f-a3e3-be8c7e709980" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/be/bed3530863181b65d9203e422502eabdffeb7edfb9a1d6ceff0f650024825ed5.png" :db/id #edb/ref 17592186526352}] :answer-field/correct {:answer/id #uuid "cd1aa56d-e965-583f-a3e3-be8c7e709980" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/be/bed3530863181b65d9203e422502eabdffeb7edfb9a1d6ceff0f650024825ed5.png" :db/id #edb/ref 17592186526352} :answer-field/id #uuid "9a818083-44bf-57bd-b9d9-d68d87092f62" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186526343}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "997fd844-921f-59ba-966d-0ef1a0054bf4" :question/problem "Which of the following diagrams gives the slope field at the points indicated for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=\\left(- \\frac{3}{2}\\right)x^{2}-(-2)y^{2}?$" :question/retired true :question/worked-solution "We have to sketch the slope field at the points $(- \\frac{1}{2},- \\frac{7}{2})$,$(- \\frac{1}{2},\\frac{1}{2})$,$(- \\frac{7}{2},\\frac{1}{2})$.\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation.\n\n$$\n\\begin{aligned} & {\\frac{\\text{d}y}{\\text{d}x}|}_{(- \\frac{1}{2},- \\frac{7}{2})}=\\left(- \\frac{3}{2}\\right)\\left(- \\frac{1}{2}\\right)^{2}-(-2)\\left(- \\frac{7}{2}\\right)^{2}=- \\frac{3}{8}-\\left(- \\frac{49}{2}\\right)=\\frac{193}{8}, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(- \\frac{1}{2},\\frac{1}{2})}=\\left(- \\frac{3}{2}\\right)\\left(- \\frac{1}{2}\\right)^{2}-(-2)\\left(\\frac{1}{2}\\right)^{2}=- \\frac{3}{8}-\\left(- \\frac{1}{2}\\right)=\\frac{1}{8}, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(- \\frac{7}{2},\\frac{1}{2})}=\\left(- \\frac{3}{2}\\right)\\left(- \\frac{7}{2}\\right)^{2}-(-2)\\left(\\frac{1}{2}\\right)^{2}=- \\frac{147}{8}-\\left(- \\frac{1}{2}\\right)=- \\frac{143}{8}.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following diagram.\n\n![](images/be/bed3530863181b65d9203e422502eabdffeb7edfb9a1d6ceff0f650024825ed5.png)"} {:db/id #edb/ref 17592186526360 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b51aee6-9fa0-57f5-bc0a-956ada38b2b3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/76/7614d446d369132f98076b6aa1d0128ca570b62918c41f2eb4d62ffa6b1c7aea.png" :db/id #edb/ref 17592186526303} {:answer/id #uuid "26a07a3a-e60f-5f43-8fe4-a687ab16e462" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/26/26f06483a213fae96c995273ff0ff1e2fd2a735e668d4fbfc3852b79f77f9331.png" :db/id #edb/ref 17592186526313} {:answer/id #uuid "9d4a40d6-5b22-56a0-8d7e-49dc77ab593a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f7/f77d4f1780e4ff74fce5e0303564f38a77968bd2e56390603a9b5b97f03b39a9.png" :db/id #edb/ref 17592186526344} {:answer/id #uuid "f2573c4a-1006-56c0-b90a-1c9782cd7914" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/38/38321f6b03143f9dc71efafa9be23d756bc3ae8f44eaaa114b67cff1d5cb7f5b.png" :db/id #edb/ref 17592186526362} {:answer/id #uuid "ff291dd9-7e80-5548-8e7c-69c72e8026bd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5b/5b40d4c48e2f7d61b67a1777300b39dac72f5455b098d67e95707606a2e427a2.png" :db/id #edb/ref 17592186526367}] :answer-field/correct {:answer/id #uuid "9d4a40d6-5b22-56a0-8d7e-49dc77ab593a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f7/f77d4f1780e4ff74fce5e0303564f38a77968bd2e56390603a9b5b97f03b39a9.png" :db/id #edb/ref 17592186526344} :answer-field/id #uuid "a6c89f1e-2821-5513-846d-453f92c546d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186526346}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e6247f84-7d87-51dd-98a1-cd1a03e15bc0" :question/problem "Which of the following diagrams gives the slope field at the points indicated for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=\\frac{5}{2}-(3)xy?$" :question/retired true :question/worked-solution "We have to sketch the slope field at the points $(1,-1)$,$(0,-2)$,$(-2,2)$.\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation.\n\n$$\n\\begin{aligned} & {\\frac{\\text{d}y}{\\text{d}x}|}_{(1,-1)}=\\frac{5}{2}-3(1)(-1)=\\frac{5}{2}-(-3)=\\frac{11}{2}, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(0,-2)}=\\frac{5}{2}-3(0)(-2)=\\frac{5}{2}-(0)=\\frac{5}{2}, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(-2,2)}=\\frac{5}{2}-3(-2)(2)=\\frac{5}{2}-(-12)=\\frac{29}{2}.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following diagram.\n\n![](images/f7/f77d4f1780e4ff74fce5e0303564f38a77968bd2e56390603a9b5b97f03b39a9.png)"} {:db/id #edb/ref 17592186526361 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "009fad15-5d1a-5691-9dbb-aa0e0c3f2c51" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/92/921545ac305c978db5f35718ddcc60aea6240a4bf0c92e3134649e944bbceeb1.png" :db/id #edb/ref 17592186526299} {:answer/id #uuid "027dcc9c-6cc1-5c14-beb5-3f82d7071dd3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bb/bbe64090631ee780d071785a8f97a8870dd2f6557746e2ed7395e9db6e326b48.png" :db/id #edb/ref 17592186526300} {:answer/id #uuid "2e976e20-a065-57ab-8f05-59b325938a8a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7a/7a323280b383e42c19701d86c4b005a769ae33539b380fa72e74b117629daac3.png" :db/id #edb/ref 17592186526316} {:answer/id #uuid "b632995b-2aa6-549d-a84f-ba75faa988eb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/52/527b523863037a491a2adf844ad97a183e26eb76db708d931b1f6baac31c10c7.png" :db/id #edb/ref 17592186526348} {:answer/id #uuid "e51273cd-2b6f-50e1-87c1-939e753b8e95" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ca/ca18948802d9d78a214c7fe1c311b070dd75cb34cf1a86e419a11327dce67c6a.png" :db/id #edb/ref 17592186526359}] :answer-field/correct {:answer/id #uuid "2e976e20-a065-57ab-8f05-59b325938a8a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7a/7a323280b383e42c19701d86c4b005a769ae33539b380fa72e74b117629daac3.png" :db/id #edb/ref 17592186526316} :answer-field/id #uuid "368b9ac6-233e-5c72-a838-3c8d9640927d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186526319}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ec562691-61f7-5234-8201-f633bff4db89" :question/problem "Which of the following diagrams gives the slope field at the points indicated for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{2}x^{2}-(-1)y^{2}?$" :question/retired true :question/worked-solution "We have to sketch the slope field at the points $(-2,-1)$,$(2,-2)$,$(-1,3)$.\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation.\n\n$$\n\\begin{aligned} & {\\frac{\\text{d}y}{\\text{d}x}|}_{(-2,-1)}=\\frac{1}{2}(-2)^{2}-(-1)(-1)^{2}=2-(-1)=3, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(2,-2)}=\\frac{1}{2}(2)^{2}-(-1)(-2)^{2}=2-(-4)=6, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(-1,3)}=\\frac{1}{2}(-1)^{2}-(-1)(3)^{2}=\\frac{1}{2}-(-9)=\\frac{19}{2}.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following diagram.\n\n![](images/7a/7a323280b383e42c19701d86c4b005a769ae33539b380fa72e74b117629daac3.png)"}]
