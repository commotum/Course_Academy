Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b83e75eb-68ab-567d-a460-9470152445c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "intersect at one point" :db/id #edb/ref 17592186070381} {:answer/id #uuid "fb057ae1-6d19-5e10-9555-8ef14e34ac05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "do not intersect" :db/id #edb/ref 17592186070382} {:answer/id #uuid "6a6737ed-0efb-5044-904e-0bbf76ec3016" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "intersect at infinitely many points" :db/id #edb/ref 17592186070383}] :answer-field/id #uuid "19065220-42bb-5118-b439-9be235fa2f10" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186070380}] :question/id #uuid "c2c1547a-6290-54a8-97be-3db72633dabf" :question/math-academy-id "q-237095" :question/problem "Consider the lines $l_{1}$ and $l_{2}$, defined by\n\n$$\n\\begin{alignedat}{2}\nl_{1}:\\quad & y &{}={}& 3x - 4 \\\\[6pt]\nl_{2}:\\quad & 12x - 4y &{}={}& 16\n\\end{alignedat}\n$$\n\nAt how many points do these lines intersect?\n\nThe lines $l_{1}$ and $l_{2}$ {{field-1}}."}] [{:db/id #edb/ref 17592186074138 :knowledge-point/_questions [{:db/id #edb/ref 17592186073778 :knowledge-point/id #uuid "50351666-c691-510f-863c-168c61f9980b" :knowledge-point/title "Finding the General Solution to a System With Infinitely Many Intersection Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec4c6de4-a7fd-5851-accd-9c5156477afd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x, 2x - 3)" :db/id #edb/ref 17592186071026} {:answer/id #uuid "f81e9c0d-0f7f-5808-ae52-8f03e0039400" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x, x + 2)" :db/id #edb/ref 17592186071027} {:answer/id #uuid "0e89162b-dfe2-5744-9796-d0f1635ed693" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x, 3x + 2)" :db/id #edb/ref 17592186071028} {:answer/id #uuid "49a90275-fbc9-561c-b080-6352f5ee175a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x, x + 3)" :db/id #edb/ref 17592186071029} {:answer/id #uuid "677e1be5-b5d0-5254-975c-3550e4fc1853" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x, 3x - 2)" :db/id #edb/ref 17592186071030}] :answer-field/id #uuid "4ea64686-cfe1-5de1-94d2-5c5e04adbf93" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186071025}] :question/id #uuid "cb252b96-4a13-53c2-bed5-4b7dd119cf7c" :question/math-academy-id "q-25524" :question/problem "Find all points of intersection of the following lines:\n\n$$\n\\begin{aligned}\n9x - 3y &= -6 \\\\[6pt]\n3x - y &= -2\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186542434 :knowledge-point/_questions [{:db/id #edb/ref 17592186073778 :knowledge-point/id #uuid "50351666-c691-510f-863c-168c61f9980b" :knowledge-point/title "Finding the General Solution to a System With Infinitely Many Intersection Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "296b4bc1-fdc9-57c7-8838-c40039d81743" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -4u + 8)" :db/id #edb/ref 17592186542454} {:answer/id #uuid "511c3e07-7b86-5d35-b593-e086d056c9e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -\\frac{1}{4}u + 2)" :db/id #edb/ref 17592186542467} {:answer/id #uuid "72f94d33-8b49-509e-9f3b-feef2915a2d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, 8)" :db/id #edb/ref 17592186542474} {:answer/id #uuid "993d12f6-8426-5581-93dc-e143dd73cada" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, 4u + 8)" :db/id #edb/ref 17592186542483} {:answer/id #uuid "d647aaba-1ddd-551d-acf3-4af820d6199d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -4u - 8)" :db/id #edb/ref 17592186542497}] :answer-field/correct {:answer/id #uuid "296b4bc1-fdc9-57c7-8838-c40039d81743" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -4u + 8)" :db/id #edb/ref 17592186542454} :answer-field/id #uuid "a496eb60-5280-58e8-963e-50a6d3c4762a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542486}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "088c2bc7-791c-5d33-989e-2db1686f3a99" :question/problem "Find all points of intersection of the following lines:\n\n$$\n\\begin{aligned}\n4x + y &= 8 \\\\[6pt]\n-8x - 2y &= -16\n\\end{aligned}\n$$" :question/worked-solution "The points of intersection of the lines correspond to the solutions of the following system:\n\n$$\n\\left\\{\\begin{aligned}4x + y &=8 \\\\ -8x - 2y &=-16\\end{aligned}\\right.\n$$\n\nWe will solve the system using elimination. Notice that if we multiply the first equation by $2$, then we will get a $8x$ term that can cancel with the $-8x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}4x + y &=8 && \\mid \\cdot (2) \\\\ -8x - 2y &=-16\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n8x + 2y &= 16 \\\\\n-8x - 2y &= -16 \\\\\n0 &= (16 - 16) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nBecause we obtained a true statement, we conclude that there are infinitely many solutions to the system. Therefore, the lines have infinitely many intersection points.\n\nWe want to find an expression that represents every solution to the system. Any value of $x$ can be chosen, and we can find the corresponding $y$-coordinate for each $x$-coordinate by solving one of the lines for $y$, as follows:\n\n$$\n\\begin{aligned}\n4x + y &= 8 \\\\\ny &= 8 - 4x \\\\\ny &= \\frac{8 - 4x}{1} \\\\\ny &= 8 - 4x\n\\end{aligned}\n$$\n\nLet $u=x$ be the free coordinate.\n\nTherefore, the points of intersection are\n\n$$\n\\left(u,8 - 4u \\right)\n$$\n\nwhere $u$ is any number."}] [{:db/id #edb/ref 17592186542435 :knowledge-point/_questions [{:db/id #edb/ref 17592186073778 :knowledge-point/id #uuid "50351666-c691-510f-863c-168c61f9980b" :knowledge-point/title "Finding the General Solution to a System With Infinitely Many Intersection Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76fe33fa-ce38-5b2f-ae1b-8a6fb1ff5121" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, \\frac{1}{4}u + \\frac{3}{4})" :db/id #edb/ref 17592186542475} {:answer/id #uuid "c99c9047-694a-52fb-90a1-920055039ded" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, \\frac{1}{4}u - \\frac{3}{4})" :db/id #edb/ref 17592186542494} {:answer/id #uuid "ca2b29a2-d8c3-5c8b-ab33-30360a9a3463" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -\\frac{1}{4}u - \\frac{3}{4})" :db/id #edb/ref 17592186542495} {:answer/id #uuid "e3aad1d2-6e42-5eec-9dca-2cec7a5ae0b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, 4u + 3)" :db/id #edb/ref 17592186542503} {:answer/id #uuid "ff7fd8bf-f7d2-584f-a1df-b2f38182412f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -\\frac{3}{4})" :db/id #edb/ref 17592186542511}] :answer-field/correct {:answer/id #uuid "c99c9047-694a-52fb-90a1-920055039ded" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, \\frac{1}{4}u - \\frac{3}{4})" :db/id #edb/ref 17592186542494} :answer-field/id #uuid "0bf547af-6a9e-5a7b-a100-571509ee17b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542436}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0b630dc7-b870-5e2b-85ac-37faee98683d" :question/problem "Find all points of intersection of the following lines:\n\n$$\n\\begin{aligned}\nx - 4y &= 3 \\\\[6pt]\n-4x + 16y &= -12\n\\end{aligned}\n$$" :question/worked-solution "The points of intersection of the lines correspond to the solutions of the following system:\n\n$$\n\\left\\{\\begin{aligned}x - 4y &=3 \\\\ -4x + 16y &=-12\\end{aligned}\\right.\n$$\n\nWe will solve the system using elimination. Notice that if we multiply the first equation by $4$, then we will get a $4x$ term that can cancel with the $-4x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}x - 4y &=3 && \\mid \\cdot (4) \\\\ -4x + 16y &=-12\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n4x - 16y &= 12 \\\\\n-4x + 16y &= -12 \\\\\n0 &= (12 - 12) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nBecause we obtained a true statement, we conclude that there are infinitely many solutions to the system. Therefore, the lines have infinitely many intersection points.\n\nWe want to find an expression that represents every solution to the system. Any value of $x$ can be chosen, and we can find the corresponding $y$-coordinate for each $x$-coordinate by solving one of the lines for $y$, as follows:\n\n$$\n\\begin{aligned}\nx - 4y &= 3 \\\\\n-4y &= 3 - x \\\\\ny &= \\frac{3 - x}{-4} \\\\\ny &= -\\frac{3}{4} + \\frac{1}{4}x\n\\end{aligned}\n$$\n\nLet $u=x$ be the free coordinate.\n\nTherefore, the points of intersection are\n\n$$\n\\left(u,-\\frac{3}{4} + \\frac{1}{4}u \\right)\n$$\n\nwhere $u$ is any number."}] [{:db/id #edb/ref 17592186542442 :knowledge-point/_questions [{:db/id #edb/ref 17592186073778 :knowledge-point/id #uuid "50351666-c691-510f-863c-168c61f9980b" :knowledge-point/title "Finding the General Solution to a System With Infinitely Many Intersection Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a28e7ec-e71a-5f77-bd2b-aee856b5039c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(t, 2t + 10)" :db/id #edb/ref 17592186542444} {:answer/id #uuid "1bbc4b58-5af2-531c-9f2a-e95c4507960c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(t, \\frac{1}{2}t - 5)" :db/id #edb/ref 17592186542446} {:answer/id #uuid "2528686b-8db2-507f-9663-1012eeb1fbf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(t, -5)" :db/id #edb/ref 17592186542453} {:answer/id #uuid "6ae1c305-4510-5421-8776-69299ea2148b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(t, -\\frac{1}{2}t - 5)" :db/id #edb/ref 17592186542473} {:answer/id #uuid "ea2d669d-5e96-546b-9cbb-0faab3e8ff37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(t, \\frac{1}{2}t + 5)" :db/id #edb/ref 17592186542504}] :answer-field/correct {:answer/id #uuid "1bbc4b58-5af2-531c-9f2a-e95c4507960c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(t, \\frac{1}{2}t - 5)" :db/id #edb/ref 17592186542446} :answer-field/id #uuid "0f8a0b2e-30d5-55be-9faa-704ff5f10ec6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542440}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "111bc200-5458-59e4-8bff-0e4766f93526" :question/problem "Find all points of intersection of the following lines:\n\n$$\n\\begin{aligned}\nx - 2y &= 10 \\\\[6pt]\n3x - 6y &= 30\n\\end{aligned}\n$$" :question/worked-solution "The points of intersection of the lines correspond to the solutions of the following system:\n\n$$\n\\left\\{\\begin{aligned}x - 2y &=10 \\\\ 3x - 6y &=30\\end{aligned}\\right.\n$$\n\nWe will solve the system using elimination. Notice that if we multiply the first equation by $-3$, then we will get a $-3x$ term that can cancel with the $3x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}x - 2y &=10 && \\mid \\cdot (-3) \\\\ 3x - 6y &=30\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n-3x + 6y &= -30 \\\\\n3x - 6y &= 30 \\\\\n0 &= (-30 + 30) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nBecause we obtained a true statement, we conclude that there are infinitely many solutions to the system. Therefore, the lines have infinitely many intersection points.\n\nWe want to find an expression that represents every solution to the system. Any value of $x$ can be chosen, and we can find the corresponding $y$-coordinate for each $x$-coordinate by solving one of the lines for $y$, as follows:\n\n$$\n\\begin{aligned}\nx - 2y &= 10 \\\\\n-2y &= 10 - x \\\\\ny &= \\frac{10 - x}{-2} \\\\\ny &= -5 + \\frac{1}{2}x\n\\end{aligned}\n$$\n\nLet $t=x$ be the free coordinate.\n\nTherefore, the points of intersection are\n\n$$\n\\left(t,-5 + \\frac{1}{2}t \\right)\n$$\n\nwhere $t$ is any number."}] [{:db/id #edb/ref 17592186542448 :knowledge-point/_questions [{:db/id #edb/ref 17592186073778 :knowledge-point/id #uuid "50351666-c691-510f-863c-168c61f9980b" :knowledge-point/title "Finding the General Solution to a System With Infinitely Many Intersection Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "216e4d60-197f-5cc4-a6a9-1f0aa4798fd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -1)" :db/id #edb/ref 17592186542451} {:answer/id #uuid "677f2479-49ce-5f74-a164-ff8f5c291ff1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -2u - 1)" :db/id #edb/ref 17592186542472} {:answer/id #uuid "925e9f49-23ce-555d-bfa2-ceaec62717c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, 2u + 1)" :db/id #edb/ref 17592186542481} {:answer/id #uuid "b93fa3dc-f26f-535d-b424-a60e27978200" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, 2u - 1)" :db/id #edb/ref 17592186542490} {:answer/id #uuid "f9ce12fe-1da9-5977-a390-7992e5b701d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, \\frac{1}{2}u + \\frac{1}{2})" :db/id #edb/ref 17592186542508}] :answer-field/correct {:answer/id #uuid "b93fa3dc-f26f-535d-b424-a60e27978200" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, 2u - 1)" :db/id #edb/ref 17592186542490} :answer-field/id #uuid "db9b9d32-7ef3-5e9b-8814-93028e12c1b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542499}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1dff70b5-3044-54d1-b535-83ffa052215f" :question/problem "Find all points of intersection of the following lines:\n\n$$\n\\begin{aligned}\n2x - y &= 1 \\\\[6pt]\n-4x + 2y &= -2\n\\end{aligned}\n$$" :question/worked-solution "The points of intersection of the lines correspond to the solutions of the following system:\n\n$$\n\\left\\{\\begin{aligned}2x - y &=1 \\\\ -4x + 2y &=-2\\end{aligned}\\right.\n$$\n\nWe will solve the system using elimination. Notice that if we multiply the first equation by $2$, then we will get a $4x$ term that can cancel with the $-4x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}2x - y &=1 && \\mid \\cdot (2) \\\\ -4x + 2y &=-2\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n4x - 2y &= 2 \\\\\n-4x + 2y &= -2 \\\\\n0 &= (2 - 2) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nBecause we obtained a true statement, we conclude that there are infinitely many solutions to the system. Therefore, the lines have infinitely many intersection points.\n\nWe want to find an expression that represents every solution to the system. Any value of $x$ can be chosen, and we can find the corresponding $y$-coordinate for each $x$-coordinate by solving one of the lines for $y$, as follows:\n\n$$\n\\begin{aligned}\n2x - y &= 1 \\\\\n-y &= 1 - 2x \\\\\ny &= \\frac{1 - 2x}{-1} \\\\\ny &= -1 + 2x\n\\end{aligned}\n$$\n\nLet $u=x$ be the free coordinate.\n\nTherefore, the points of intersection are\n\n$$\n\\left(u,-1 + 2u \\right)\n$$\n\nwhere $u$ is any number."}] [{:db/id #edb/ref 17592186542452 :knowledge-point/_questions [{:db/id #edb/ref 17592186073778 :knowledge-point/id #uuid "50351666-c691-510f-863c-168c61f9980b" :knowledge-point/title "Finding the General Solution to a System With Infinitely Many Intersection Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "329c8c6c-64c9-53b9-abcb-a88c8eeeb32e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2t + 6" :db/id #edb/ref 17592186542458}] :answer-field/correct {:answer/id #uuid "329c8c6c-64c9-53b9-abcb-a88c8eeeb32e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2t + 6" :db/id #edb/ref 17592186542458} :answer-field/id #uuid "d774ba4e-5e04-5b25-ac80-8bb3704ee4df" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186542498}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "23da70bf-d870-5a7b-895c-27d6ebda3437" :question/problem "Describe the points that lie on the intersection of the following lines:\n\n$$\n\\begin{aligned}\n2x - y &= -6 \\\\[6pt]\n6x - 3y &= -18\n\\end{aligned}\n$$\n\nExpress your answer in terms of $t$ only.\n\nThe intersection points are\n\n$(t,$ {{field-1}} $),$\n\nwhere $t$ is any number." :question/worked-solution "The points of intersection of the lines correspond to the solutions of the following system:\n\n$$\n\\left\\{\\begin{aligned}2x - y &=-6 \\\\ 6x - 3y &=-18\\end{aligned}\\right.\n$$\n\nWe will solve the system using elimination. Notice that if we multiply the first equation by $-3$, then we will get a $-6x$ term that can cancel with the $6x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}2x - y &=-6 && \\mid \\cdot (-3) \\\\ 6x - 3y &=-18\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n-6x + 3y &= 18 \\\\\n6x - 3y &= -18 \\\\\n0 &= (18 - 18) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nBecause we obtained a true statement, we conclude that there are infinitely many solutions to the system. Therefore, the lines have infinitely many intersection points.\n\nWe want to find an expression that represents every solution to the system. Any value of $x$ can be chosen, and we can find the corresponding $y$-coordinate for each $x$-coordinate by solving one of the lines for $y$, as follows:\n\n$$\n\\begin{aligned}\n2x - y &= -6 \\\\\n-y &= -6 - 2x \\\\\ny &= \\frac{-6 - 2x}{-1} \\\\\ny &= 6 + 2x\n\\end{aligned}\n$$\n\nLet $t=x$ be the free coordinate.\n\nTherefore, the points of intersection are\n\n$$\n\\left(t,6 + 2t \\right)\n$$\n\nwhere $t$ is any number."}] [{:db/id #edb/ref 17592186542462 :knowledge-point/_questions [{:db/id #edb/ref 17592186073778 :knowledge-point/id #uuid "50351666-c691-510f-863c-168c61f9980b" :knowledge-point/title "Finding the General Solution to a System With Infinitely Many Intersection Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b794602-b4c5-54ab-8bfc-db1e61594521" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x + \\frac{11}{2}" :db/id #edb/ref 17592186542479}] :answer-field/correct {:answer/id #uuid "8b794602-b4c5-54ab-8bfc-db1e61594521" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x + \\frac{11}{2}" :db/id #edb/ref 17592186542479} :answer-field/id #uuid "337c5621-421b-56d4-95de-5c351f0f1ad9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186542460}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3e38b0b3-85f1-537d-9bdc-738a5616e813" :question/problem "Describe the points that lie on the intersection of the following lines:\n\n$$\n\\begin{aligned}\n4x - 2y &= -11 \\\\[6pt]\n8x - 4y &= -22\n\\end{aligned}\n$$\n\nExpress your answer in terms of $x$ only.\n\nThe intersection points are\n\n$(x,$ {{field-1}} $),$\n\nwhere $x$ is any number." :question/worked-solution "The points of intersection of the lines correspond to the solutions of the following system:\n\n$$\n\\left\\{\\begin{aligned}4x - 2y &=-11 \\\\ 8x - 4y &=-22\\end{aligned}\\right.\n$$\n\nWe will solve the system using elimination. Notice that if we multiply the first equation by $-2$, then we will get a $-8x$ term that can cancel with the $8x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}4x - 2y &=-11 && \\mid \\cdot (-2) \\\\ 8x - 4y &=-22\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n-8x + 4y &= 22 \\\\\n8x - 4y &= -22 \\\\\n0 &= (22 - 22) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nBecause we obtained a true statement, we conclude that there are infinitely many solutions to the system. Therefore, the lines have infinitely many intersection points.\n\nWe want to find an expression that represents every solution to the system. Any value of $x$ can be chosen, and we can find the corresponding $y$-coordinate for each $x$-coordinate by solving one of the lines for $y$, as follows:\n\n$$\n\\begin{aligned}\n4x - 2y &= -11 \\\\\n-2y &= -11 - 4x \\\\\ny &= \\frac{-11 - 4x}{-2} \\\\\ny &= \\frac{11}{2} + 2x\n\\end{aligned}\n$$\n\nTherefore, the points of intersection are\n\n$$\n\\left(x,\\frac{11}{2} + 2x \\right)\n$$\n\nwhere $x$ is any number."}] [{:db/id #edb/ref 17592186542465 :knowledge-point/_questions [{:db/id #edb/ref 17592186073778 :knowledge-point/id #uuid "50351666-c691-510f-863c-168c61f9980b" :knowledge-point/title "Finding the General Solution to a System With Infinitely Many Intersection Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1265d20a-0e86-57c1-9549-b3dffb34e245" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{5}x - \\frac{6}{5}" :db/id #edb/ref 17592186542443} {:answer/id #uuid "d4c47599-772d-4df0-ba90-27dffe08fede" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12x-6}{5}" :db/id #edb/ref 17592186574774}] :answer-field/correct {:answer/id #uuid "1265d20a-0e86-57c1-9549-b3dffb34e245" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{5}x - \\frac{6}{5}" :db/id #edb/ref 17592186542443} :answer-field/id #uuid "0eef6127-aaa5-5be2-ac0e-d2adcd5bbbc7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186542439}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "48520d96-a4e1-575b-9ec9-8c8c3ed1fafc" :question/problem "Describe the points that lie on the intersection of the following lines:\n\n$$\n\\begin{aligned}\n-12x + 5y &= -6 \\\\[6pt]\n24x - 10y &= 12\n\\end{aligned}\n$$\n\nExpress your answer in terms of $x$ only.\n\nThe intersection points are\n\n$(x,$ {{field-1}} $),$\n\nwhere $x$ is any number." :question/worked-solution "The points of intersection of the lines correspond to the solutions of the following system:\n\n$$\n\\left\\{\\begin{aligned}-12x + 5y &=-6 \\\\ 24x - 10y &=12\\end{aligned}\\right.\n$$\n\nWe will solve the system using elimination. Notice that if we multiply the first equation by $2$, then we will get a $-24x$ term that can cancel with the $24x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}-12x + 5y &=-6 && \\mid \\cdot (2) \\\\ 24x - 10y &=12\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n-24x + 10y &= -12 \\\\\n24x - 10y &= 12 \\\\\n0 &= (-12 + 12) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nBecause we obtained a true statement, we conclude that there are infinitely many solutions to the system. Therefore, the lines have infinitely many intersection points.\n\nWe want to find an expression that represents every solution to the system. Any value of $x$ can be chosen, and we can find the corresponding $y$-coordinate for each $x$-coordinate by solving one of the lines for $y$, as follows:\n\n$$\n\\begin{aligned}\n-12x + 5y &= -6 \\\\\n5y &= -6 + 12x \\\\\ny &= \\frac{-6 + 12x}{5} \\\\\ny &= -\\frac{6}{5} + \\frac{12}{5}x\n\\end{aligned}\n$$\n\nTherefore, the points of intersection are\n\n$$\n\\left(x,-\\frac{6}{5} + \\frac{12}{5}x \\right)\n$$\n\nwhere $x$ is any number."}] [{:db/id #edb/ref 17592186542470 :knowledge-point/_questions [{:db/id #edb/ref 17592186073778 :knowledge-point/id #uuid "50351666-c691-510f-863c-168c61f9980b" :knowledge-point/title "Finding the General Solution to a System With Infinitely Many Intersection Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4830ac95-7dc9-5c52-9bdb-fa5c81554b07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -4u + 4)" :db/id #edb/ref 17592186542464} {:answer/id #uuid "59e2aa79-4c55-547b-90bf-a161e58917b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -\\frac{1}{4}u - 1)" :db/id #edb/ref 17592186542469} {:answer/id #uuid "ae8e8497-f8a2-5256-b0c3-49b354163e46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, \\frac{1}{4}u + 1)" :db/id #edb/ref 17592186542487} {:answer/id #uuid "c6c78b75-34eb-5180-b93a-45a32364f55c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -\\frac{1}{4}u + 1)" :db/id #edb/ref 17592186542493} {:answer/id #uuid "e238b8ec-01f6-516b-b4d3-05d0921577b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, 1)" :db/id #edb/ref 17592186542501}] :answer-field/correct {:answer/id #uuid "c6c78b75-34eb-5180-b93a-45a32364f55c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -\\frac{1}{4}u + 1)" :db/id #edb/ref 17592186542493} :answer-field/id #uuid "1ade77da-f05d-59b2-a201-6a199f319be8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542445}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5cb1d607-78ca-599f-a42f-6cb360fcbf56" :question/problem "Find all points of intersection of the following lines:\n\n$$\n\\begin{aligned}\n-x - 4y &= -4 \\\\[6pt]\n2x + 8y &= 8\n\\end{aligned}\n$$" :question/worked-solution "The points of intersection of the lines correspond to the solutions of the following system:\n\n$$\n\\left\\{\\begin{aligned}-x - 4y &=-4 \\\\ 2x + 8y &=8\\end{aligned}\\right.\n$$\n\nWe will solve the system using elimination. Notice that if we multiply the first equation by $2$, then we will get a $-2x$ term that can cancel with the $2x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}-x - 4y &=-4 && \\mid \\cdot (2) \\\\ 2x + 8y &=8\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n-2x - 8y &= -8 \\\\\n2x + 8y &= 8 \\\\\n0 &= (-8 + 8) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nBecause we obtained a true statement, we conclude that there are infinitely many solutions to the system. Therefore, the lines have infinitely many intersection points.\n\nWe want to find an expression that represents every solution to the system. Any value of $x$ can be chosen, and we can find the corresponding $y$-coordinate for each $x$-coordinate by solving one of the lines for $y$, as follows:\n\n$$\n\\begin{aligned}\n-x - 4y &= -4 \\\\\n-4y &= -4 + x \\\\\ny &= \\frac{-4 + x}{-4} \\\\\ny &= 1 - \\frac{1}{4}x\n\\end{aligned}\n$$\n\nLet $u=x$ be the free coordinate.\n\nTherefore, the points of intersection are\n\n$$\n\\left(u,1 - \\frac{1}{4}u \\right)\n$$\n\nwhere $u$ is any number."}] [{:db/id #edb/ref 17592186542476 :knowledge-point/_questions [{:db/id #edb/ref 17592186073778 :knowledge-point/id #uuid "50351666-c691-510f-863c-168c61f9980b" :knowledge-point/title "Finding the General Solution to a System With Infinitely Many Intersection Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32ec9eaf-8a8c-5485-9397-f4080cccdb42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x, \\frac{2}{7}x - \\frac{6}{7})" :db/id #edb/ref 17592186542459} {:answer/id #uuid "3dc42961-0c2f-541f-bb32-0b326bb279c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x, \\frac{7}{2}x + 3)" :db/id #edb/ref 17592186542461} {:answer/id #uuid "9ab9055c-41fa-52d4-98cc-67b4d8dd46ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x, 3)" :db/id #edb/ref 17592186542484} {:answer/id #uuid "e29a0d02-5cca-5ff8-bf75-9db725841961" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x, \\frac{7}{2}x - 3)" :db/id #edb/ref 17592186542502} {:answer/id #uuid "f097021f-ff70-5357-a6ad-89cefc4a73f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x, -\\frac{7}{2}x + 3)" :db/id #edb/ref 17592186542506}] :answer-field/correct {:answer/id #uuid "3dc42961-0c2f-541f-bb32-0b326bb279c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x, \\frac{7}{2}x + 3)" :db/id #edb/ref 17592186542461} :answer-field/id #uuid "ffc4aaed-af07-5113-8443-30d9a263ac17" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542512}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7ab21255-f04c-59e1-a7a8-fd7625364758" :question/problem "Find all points of intersection of the following lines:\n\n$$\n\\begin{aligned}\n-7x + 2y &= 6 \\\\[6pt]\n-21x + 6y &= 18\n\\end{aligned}\n$$" :question/worked-solution "The points of intersection of the lines correspond to the solutions of the following system:\n\n$$\n\\left\\{\\begin{aligned}-7x + 2y &=6 \\\\ -21x + 6y &=18\\end{aligned}\\right.\n$$\n\nWe will solve the system using elimination. Notice that if we multiply the first equation by $-3$, then we will get a $21x$ term that can cancel with the $-21x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}-7x + 2y &=6 && \\mid \\cdot (-3) \\\\ -21x + 6y &=18\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n21x - 6y &= -18 \\\\\n-21x + 6y &= 18 \\\\\n0 &= (-18 + 18) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nBecause we obtained a true statement, we conclude that there are infinitely many solutions to the system. Therefore, the lines have infinitely many intersection points.\n\nWe want to find an expression that represents every solution to the system. Any value of $x$ can be chosen, and we can find the corresponding $y$-coordinate for each $x$-coordinate by solving one of the lines for $y$, as follows:\n\n$$\n\\begin{aligned}\n-7x + 2y &= 6 \\\\\n2y &= 6 + 7x \\\\\ny &= \\frac{6 + 7x}{2} \\\\\ny &= 3 + \\frac{7}{2}x\n\\end{aligned}\n$$\n\nTherefore, the points of intersection are\n\n$$\n\\left(x,3 + \\frac{7}{2}x \\right)\n$$\n\nwhere $x$ is any number."}] [{:db/id #edb/ref 17592186542477 :knowledge-point/_questions [{:db/id #edb/ref 17592186073778 :knowledge-point/id #uuid "50351666-c691-510f-863c-168c61f9980b" :knowledge-point/title "Finding the General Solution to a System With Infinitely Many Intersection Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0473f996-4e92-58c5-bd48-4ace42741c79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{3}t + \\frac{10}{3}" :db/id #edb/ref 17592186542433}] :answer-field/correct {:answer/id #uuid "0473f996-4e92-58c5-bd48-4ace42741c79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{3}t + \\frac{10}{3}" :db/id #edb/ref 17592186542433} :answer-field/id #uuid "2e20b028-6414-53a2-a73b-b3e227d7d3fa" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186542456}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7cd05dfa-1d47-5a9e-9f5f-9a75d2347390" :question/problem "Describe the points that lie on the intersection of the following lines:\n\n$$\n\\begin{aligned}\n7x + 3y &= 10 \\\\[6pt]\n21x + 9y &= 30\n\\end{aligned}\n$$\n\nExpress your answer in terms of $t$ only.\n\nThe intersection points are\n\n$(t,$ {{field-1}} $),$\n\nwhere $t$ is any number." :question/worked-solution "The points of intersection of the lines correspond to the solutions of the following system:\n\n$$\n\\left\\{\\begin{aligned}7x + 3y &=10 \\\\ 21x + 9y &=30\\end{aligned}\\right.\n$$\n\nWe will solve the system using elimination. Notice that if we multiply the first equation by $-3$, then we will get a $-21x$ term that can cancel with the $21x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}7x + 3y &=10 && \\mid \\cdot (-3) \\\\ 21x + 9y &=30\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n-21x - 9y &= -30 \\\\\n21x + 9y &= 30 \\\\\n0 &= (-30 + 30) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nBecause we obtained a true statement, we conclude that there are infinitely many solutions to the system. Therefore, the lines have infinitely many intersection points.\n\nWe want to find an expression that represents every solution to the system. Any value of $x$ can be chosen, and we can find the corresponding $y$-coordinate for each $x$-coordinate by solving one of the lines for $y$, as follows:\n\n$$\n\\begin{aligned}\n7x + 3y &= 10 \\\\\n3y &= 10 - 7x \\\\\ny &= \\frac{10 - 7x}{3} \\\\\ny &= \\frac{10}{3} - \\frac{7}{3}x\n\\end{aligned}\n$$\n\nLet $t=x$ be the free coordinate.\n\nTherefore, the points of intersection are\n\n$$\n\\left(t,\\frac{10}{3} - \\frac{7}{3}t \\right)\n$$\n\nwhere $t$ is any number."}]}
