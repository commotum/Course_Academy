id #uuid "2054f218-d7fb-5f4b-bb1e-7462237fd4e8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186070314}] :question/id #uuid "dffc4e2c-f9ea-5274-92e6-4d3948a4c014" :question/math-academy-id "q-211986" :question/problem "Consider the lines $l_{1}$ and $l_{2}$, defined by\n\n$$\n\\begin{alignedat}{2}\nl_{1}:\\quad & 2x - y &{}={}& -2 \\\\[6pt]\nl_{2}:\\quad & 6x - 3y &{}={}& -12\n\\end{alignedat}\n$$\n\nAt how many points do these lines intersect?\n\nThe lines $l_{1}$ and $l_{2}$ {{field-1}}."}] [{:db/id #edb/ref 17592186074086 :knowledge-point/_questions [{:db/id #edb/ref 17592186073776 :knowledge-point/id #uuid "a24fb4f3-6e3c-5c45-b31e-85b7ce290eda" :knowledge-point/title "Finding the Number of Solutions to a System" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e68ea0f6-0c4b-5948-83f5-ff28c2e4168d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186070367} {:answer/id #uuid "2538c1b9-bfe4-5a49-9a4d-041fb3280dc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186070368} {:answer/id #uuid "3052b8bd-d15e-5191-af99-65807ded222d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186070369}] :answer-field/id #uuid "56f7931c-2301-53d0-aff9-d64e1ec4c799" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186070366}] :question/id #uuid "cc576833-ebf9-5c8f-b749-c0cfe585139d" :question/math-academy-id "q-237043" :question/problem "Consider the following system of equations:\n\n$$\n\\left\\{\\begin