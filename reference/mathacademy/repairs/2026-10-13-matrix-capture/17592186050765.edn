edb/ref 17592186260632} {:answer/id #uuid "d3b048fb-312b-5b1e-97f0-cbc0b7c03663" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 5 & -1 \\\\ 5 & -9 & -1\\end{aligned}]" :db/id #edb/ref 17592186261738} {:answer/id #uuid "f9d8a88e-5dc4-5817-a2f4-72a515f6966c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 & 5 \\\\ 5 & 9 & 1\\end{aligned}]" :db/id #edb/ref 17592186262057}] :answer-field/correct {:answer/id #uuid "1c35e2f6-fe6c-54e6-a8bc-27d1cd5ff62a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 & 5 \\\\ 5 & -9 & -1\\end{aligned}]" :db/id #edb/ref 17592186260116} :answer-field/id #uuid "30e051d5-7b61-53d4-982a-e57239cc0e2b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262211}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "553e355c-3ed5-592a-b9a8-9897676499b2" :question/math-academy-id "q-129124" :question/problem "What is the augmented matrix for the following system of linear equations?\n\n$$\n\\begin{aligned}{\\begin{aligned}2y=5-x \\\\ 5x-9y+1=0\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "First, we organize the system so that the variables are ordered $x,y$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\n\\begin{aligned}{\\begin{aligned}x+2y=5 \\\\ 5x-9y=-1\\end{aligned}\\end{aligned}\n$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n[\\begin{aligned}1 & 2 \\\\ 5 & -9\\end{aligned}]\n$$\n\nThe augmented matrix  is the coefficient matrix augmented with the column that represents the right-hand sides of the equations: \n\n$$\n[\\begin{aligned}1 & 2 & 5 \\\\ 5 & -9 & -1\\end{aligned}]\n$$"} {:db/id #edb/ref 17592186338976 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16e9c5d7-63ce-5359-983d-17894b881c44" :answer/type {:db/ident :answer.type/math} :