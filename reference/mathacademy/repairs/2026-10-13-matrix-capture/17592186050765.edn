hoices [{:answer/id #uuid "57c409da-6d07-543c-b9dd-272447545262" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 9 & 4\\end{aligned}]" :db/id #edb/ref 17592186260624} {:answer/id #uuid "6b057865-98b1-52bc-9c2b-5ee56a07f285" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 \\\\ 9 & 4\\end{aligned}]" :db/id #edb/ref 17592186260812} {:answer/id #uuid "c2c22d8d-482d-598f-8c2b-743196fb2975" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 6 \\\\ 9 & 4 & -1\\end{aligned}]" :db/id #edb/ref 17592186261594} {:answer/id #uuid "f4d443d2-df29-5ed0-858d-f89c9fb3d820" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -1 \\\\ 9 & 4\\end{aligned}]" :db/id #edb/ref 17592186262016}] :answer-field/correct {:answer/id #uuid "57c409da-6d07-543c-b9dd-272447545262" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 9 & 4\\end{aligned}]" :db/id #edb/ref 17592186260624} :answer-field/id #uuid "cde4cd36-f021-5934-b1a4-43062eaa155f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262483}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2a9c733a-3be1-55f9-ae18-d007236cde70" :question/math-academy-id "q-129050" :question/problem "What is the coefficient matrix for the following system of linear equations?\n\n$$\n\\begin{aligned}{\\begin{aligned}x=6 \\\\ 9x+4y=-1\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "First, we organize the system so that the variables are ordered $x,y$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\n\\begin{aligned}{\\begin{aligned}x+0y=6 \\\\ 9x+4y=-1\\end{aligned}\\end{aligned}\n$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n[\\begin{aligned}1 & 0 \\\\ 9 & 4\\end{aligned}]\n$$"} {:db/id #edb/ref 175921862629