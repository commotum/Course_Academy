r-field/choices [{:answer/id #uuid "1863edce-f2ec-5a50-a21f-05e421f1ea0f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & -1 & 4 \\\\ -11 & 0 & 3 & -1\\end{aligned}]" :db/id #edb/ref 17592186241392} {:answer/id #uuid "7072cee5-2648-59ca-97b2-078189a3001c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -4 & -1 & 0 \\\\ -11 & 0 & 3 & -1\\end{aligned}]" :db/id #edb/ref 17592186242182} {:answer/id #uuid "7be93f80-7c8c-5b43-983a-793f919a89d7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -1 & 4 \\\\ 3 & -11 & -1\\end{aligned}]" :db/id #edb/ref 17592186242267} {:answer/id #uuid "b0f0d9d4-4e81-5ba0-91aa-2178ad3b6deb" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -4 & -1 & 0 \\\\ -11 & 0 & 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186242720} {:answer/id #uuid "b6d1250e-1895-5e34-abe2-28333a02d8a5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -1 & 0 & 4 \\\\ -3 & -11 & 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186242781}] :answer-field/correct {:answer/id #uuid "7072cee5-2648-59ca-97b2-078189a3001c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -4 & -1 & 0 \\\\ -11 & 0 & 3 & -1\\end{aligned}]" :db/id #edb/ref 17592186242182} :answer-field/id #uuid "1c88d913-c353-5501-9331-c6c82155dd5e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243493}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c33e89a9-178e-58d6-a7fe-c1f9dae2ffc1" :question/math-academy-id "q-1073" :question/problem "What is the augmented matrix for the following system of linear equations? \n\n$$\n\\begin{aligned}{\\begin{aligned}a-c=4b \\\\ 3c-11a=-1\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "First, we organize the system so that the variables are ordered $a,b,c$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\n\\begin{aligned}{\\begin{aligned}a-4b-c=0 \\\\ -11a+0b+3c=-1\\end{aligned}\\end{aligned}\n$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n[\\begin{aligned}1 & -4 & -1 \\\\ -11 & 0 & 3\\end{aligned}]\n$$\n\nThe augmented matrix is the coefficient matrix augmented with the column that represents the right-hand sides of the equations:\n\n$$\n[\\begin{aligned}1 & -4 & -1 & 0 \\\\ -11 & 0 & 3 & -1\\end{aligned}]\n$$"} {:db/id #edb/ref 17592186262950 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0acbb9cc-3db1-5c34-93c1-7fc8960f7d77" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 1 \\\\ 9 & 4 & 2\\end{aligned}]" :db/id #edb/ref 17592186259972} {:answer/id #uuid "45cb00db-0f55-5e4c-9c41-33375dee0b1b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 2 \\\\ 9 & -4 & 1 \\\\ 0 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186260484} {:answer/id #uuid "4f1567d5-cdb7-5010-937a-5c816fb34cd7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 & 3 \\\\ 9 & 1 & -4\\end{aligned}]" :db/id #edb/ref 17592186260549} {:answer/id #uuid "b94fb6c4-bbf4-5744-b765-ded102eac091" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 2 \\\\ 9 & -4 & 1\\end{aligned}]" :db/id #edb/ref 17592186261498} {:answer/id #uuid "d4ce31d3-e365-58dc-a63d-dfd97d046b99" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 9 \\\\ 3 & -4 \\\\ 2 & 1\\end{aligned}]" :db/id #edb/ref 17592186261750}] :answer-field/correct {:answer/id #uuid "b94fb6c4-bbf4-5744-b765-ded102eac091" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 2 \\\\ 9 & -4 & 1\\end{aligned}]" :db/id #edb/ref 17592186261498} :answer-field/id #uuid "e090c189-3297-54e8-878b-d3da5c293ac7" :answer-field/key "selection" :answer-field/type {:db/ident :answ