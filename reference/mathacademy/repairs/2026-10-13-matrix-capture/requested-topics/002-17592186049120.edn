 0 & -3 & 10\\end{array}\\right]"] [:db/cas 17592186340394 :answer/value "[\\begin{aligned}1 & 0 & -2 & 2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 1 & 3 & -7\\end{aligned}]" "\\left[\\begin{array}{ccc|c}1 & 0 & -2 & 2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 1 & 3 & -7\\end{array}\\right]"] [:db/cas 17592186340679 :answer/value "[\\begin{aligned}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 0 & -1 & -1 & -1\\end{aligned}]" "\\left[\\begin{array}{ccc|c}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 0 & -1 & -1 & -1\\end{array}\\right]"] [:db/cas 17592186340698 :answer/value "[\\begin{aligned}0 & -2 & 1 & 4 \\\\ 1 & 0 & 2 & 3 \\\\ 1 & 1 & 0 & 2\\end{aligned}]" "\\left[\\begin{array}{ccc|c}0 & -2 & 1 & 4 \\\\ 1 & 0 & 2 & 3 \\\\ 1 & 1 & 0 & 2\\end{array}\\right]"] [:db/cas 17592186341011 :answer/value "[\\begin{aligned}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 1 & -1 & 1 & 2\\end{aligned}]" "\\left[\\begin{array}{ccc|c}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 1 & -1 & 1 & 2\\end{array}\\right]"] [:db/cas 17592186341857 :question/problem "Consider the augmented matrix $M,$ given by\n\n$$\nM=[\\begin{aligned}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 1 & -1 & 1 & 2\\end{aligned}].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{3}:={R}_{3}+(-1)\\cdot {R}_{1}$ on $M?$" "Consider the augmented matrix $M,$ given by\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 1 & -1 & 1 & 2\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{3}:={R}_{3}+(-1)\\cdot {R}_{1}$ on $M?$"] [:db/cas 17592186341857 :question/worked-solution "The operation ${R}_{3}:={R}_{3}+(-1)\\cdot {R}_{1}$ means that we need to add $-1$ times the first row to the third row.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 1 & -1 & 1 & 2\\end{aligned}]\\,{R}_{3}:={R}_{3}+(-1)\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 1+(-1)(1) & -1+(-1)(0) & 1+(-1)(2) & 2+(-1)(3)\\end{aligned}] \\\\  & ∼[\\begin{aligned}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 0 & -1 & -1 & -1\\end{aligned}]\\end{aligned}\n$$" "The operation ${R}_{3}:={R}_{3}+(-1)\\cdot {R}_{1}$ means that we need to add $-1$ times the first row to the third row.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 1 & -1 & 1 & 2\\end{array}\\right]\\,{R}_{3}:={R}_{3}+(-1)\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 1+(-1)(1) & -1+(-1)(0) & 1+(-1)(2) & 2+(-1)(3)\\end{array}\\right] \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 0 & -1 & -1 & -1\\end{array}\\right]\\end{aligned}\n$$"] [:db/cas 17592186341863 :question/problem "Consider the augmented matrix $U,$ given by\n\n$$\nU=[\\begin{aligned}1 & 0 & 2 & -2 \\\\ 0 & 2 & 0 & 6 \\\\ 0 & -1 & -3 & 4\\end{aligned}].\n$$\n\nWhat matrix results from carrying out the following row operations on $U?$\n\n$$\n\\begin{aligned}{R}_{2} & :=\\frac{1}{2}{R}_{2} \\\\ {R}_{3} & :={R}_{3}+{R}_{2}\\end{aligned}\n$$" "Consider the augmented matrix $U,$ given by\n\n$$\nU=\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -2 \\\\ 0 & 2 & 0 & 6 \\\\ 0 & -1 & -3 & 4\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the following row operations on $U?$\n\n$$\n\\begin{aligned}{R}_{2} & :=\\frac{1}{2}{R}_{2} \\\\ {R}_{3} & :={R}_{3}+{R}_{2}\\end{aligned}\n$$"] [:db/cas 17592186341863 :question/worked-solution "Let's list the required operations:\n\n- The operation ${R}_{2}:=\\frac{1}{2}{R}_{2}$ means that we need to multiply the second row of the matrix by $\\frac{1}{2}.$\n\n- The operation ${R}_{3}:={R}_{3}+{R}_{2}$ means that we need to add $1$ times the second row to the third row.\n\nApplying the operations, we obtain the following:\n\n$$\n\\begin{aligned}U & =[\\begin{aligned}1 & 0 & 2 & -2 \\\\ 0 & 2 & 0 & 6 \\\\ 0 & -1 & -3 & 4\\end{aligned}]\\,{R}_{2}:=\\frac{1}{2}\\cdot {R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 2 & -2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & -1 & -3 & 4\\end{aligned}]\\,{R}_{3}:={R}_{3}+{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 2 & -2 \\\\ 0 & 1 & 0 & 3 \\\\ 0+0 & -1+1 & -3+0 & 4+3\\end{aligned}] \\\\  & ∼[\\begin{aligned}1 & 0 & 2 & -2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & -3 & 7\\end{aligned}]\\end{aligned}\n$$" "Let's list the required operations:\n\n- The operation ${R}_{2}:=\\frac{1}{2}{R}_{2}$ means that we need to multiply the second row of the matrix by $\\frac{1}{2}.$\n\n- The operation ${R}_{3}:={R}_{3}+{R}_{2}$ means that we need to add $1$ times the second row to the third row.\n\nApplying the operations, we obtain the following:\n\n$$\n\\begin{aligned}U & =\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -2 \\\\ 0 & 2 & 0 & 6 \\\\ 0 & -1 & -3 & 4\\end{array}\\right]\\,{R}_{2}:=\\frac{1}{2}\\cdot {R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & -1 & -3 & 4\\end{array}\\right]\\,{R}_{3}:={R}_{3}+{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -2 \\\\ 0 & 1 & 0 & 3 \\\\ 0+0 & -1+1 & -3+0 & 4+3\\end{array}\\right] \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & -3 & 7\\end{array}\\right]\\end{aligned}\n$$"] [:db/cas 17592186341877 :question/problem "Which of the following elementary row operations transforms the matrix $U$ into the matrix $V$, where\n\n$$\nU=[\\begin{aligned}1 & 3 & 2 \\\\ 6 & 4 & 5 \\\\ 1 & 2 & -1\\end{aligned}],\\,V=[\\begin{aligned}1 & 2 & -1 \\\\ 6 & 4 & 5 \\\\ 1 & 3 & 2\\end{aligned}]?\n$$" "Which of the following elementary row operations transforms the matrix $U$ into the matrix $V$, where\n\n$$\nU=\\begin{bmatrix}1 & 3 & 2 \\\\ 6 & 4 & 5 \\\\ 1 & 2 & -1\\end{bmatrix},\\,V=\\begin{bmatrix}1 & 2 & -1 \\\\ 6 & 4 & 5 \\\\ 1 & 3 & 2\\end{bmatrix}?\n$$"] [:db/cas 17592186341877 :question/worked-solution "First, notice that the $2$nd row is the same in both matrices. The only rows that have changed are the $1$st row and the $3$rd row.   \n\nBy considering the given row operations that change both the $1$st and the $3$rd row, we notice that\n\n$$\n\\begin{aligned}U & =[\\begin{aligned}1 & 3 & 2 \\\\ 6 & 4 & 5 \\\\ 1 & 2 & -1\\end{aligned}] & \\,{R}_{1}↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 2 & -1 \\\\ 6 & 4 & 5 \\\\ 1 & 3 & 2\\end{aligned}] \\\\  & =V.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{1}↔{R}_{3}.\n$$" "First, notice that the $2$nd row is the same in both matrices. The only rows that have changed are the $1$st row and the $3$rd row.   \n\nBy considering the given row operations that change both the $1$st and the $3$rd row, we notice that\n\n$$\n\\begin{aligned}U & =\\begin{bmatrix}1 & 3 & 2 \\\\ 6 & 4 & 5 \\\\ 1 & 2 & -1\\end{bmatrix} & \\,{R}_{1}↔{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 2 & -1 \\\\ 6 & 4 & 5 \\\\ 1 & 3 & 2\\end{bmatrix} \\\\  & =V.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{1}↔{R}_{3}.\n$$"] [:db/cas 17592186341878 :question/problem "Which of the following elementary row operations transforms the matrix $X$ into the matrix $W$, where\n\n$$\nX=[\\begin{aligned}1 & 1 & 2 \\\\ -4 & -1 & 1 \\\\ 2 & 1 & 6\\end{aligned}],\\,W=[\\begin{aligned}1 & 1 & 2 \\\\ 0 & 3 & 9 \\\\ 2 & 1 & 6\\end{aligned}]?\n$$" "Which of the following elementary row operations transforms the matrix $X$ into the matrix $W$, where\n\n$$\nX=\\begin{bmatrix}1 & 1 & 2 \\\\ -4 & -1 & 1 \\\\ 2 & 1 & 6\\end{bmatrix},\\,W=\\begin{bmatrix}1 & 1 & 2 \\\\ 0 & 3 & 9 \\\\ 2 & 1 & 6\\end{bmatrix}?\n$$"] [:db/cas 17592186341878 :question/worked-solution "First, notice that the $1$st and the $3$rd rows are the same in both matrices. The only row that has changed is the $2$nd row. \n\nBy considering the given row operations that modify the $2$nd row, we notice that\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}1 & 1 & 2 \\\\ -4 & -1 & 1 \\\\ 2 & 1 & 6\\end{aligned}]\\,{R}_{2}:={R}_{2}+4\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 2 \\\\ 0 & 3 & 9 \\\\ 2 & 1 & 6\\end{aligned}] \\\\  & =W.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}:={R}_{2}+4{R}_{1}.\n$$" "First, notice that the $1$st and the $3$rd rows are the same in both matrices. The only row that has changed is the $2$nd row. \n\nBy considering the given row operations that modify the $2$nd row, we notice that\n\n$$\n\\begin{aligned}X & =\\begin{bmatrix}1 & 1 & 2 \\\\ -4 & -1 & 1 \\\\ 2 & 1 & 6\\end{bmatrix}\\,{R}_{2}:={R}_{2}+4\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & 2 \\\\ 0 & 3 & 9 \\\\ 2 & 1 & 6\\end{bmatrix} \\\\  & =W.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}:={R}_{2}+4{R}_{1}.\n$$"] [:db/cas 17592186341879 :question/problem "Which of the following elementary row operations transforms the matrix $K$ into the matrix $L$, where\n\n$$\nK=[\\begin{aligned}1 & 3 & 2 \\\\ -2 & 4 & -2 \\\\ 0 & -1 & -1\\end{aligned}],\\,L=[\\begin{aligned}1 & 3 & 2 \\\\ 0 & 10 & 2 \\\\ 0 & -1 & -1\\end{aligned}]?\n$$" "Which of the following elementary row operations transforms the matrix $K$ into the matrix $L$, where\n\n$$\nK=\\begin{bmatrix}1 & 3 & 2 \\\\ -2 & 4 & -2 \\\\ 0 & -1 & -1\\end{bmatrix},\\,L=\\begin{bmatrix}1 & 3 & 2 \\\\ 0 & 10 & 2 \\\\ 0 & -1 & -1\\end{bmatrix}?\n$$"] [:db/cas 17592186341879 :question/worked-solution "First, notice that the $1$st and the $3$rd rows are the same in both matrices. The only row that has changed is the $2$nd row. \n\nBy considering the given row operations that modify the $2$nd row, we notice that\n\n$$\n\\begin{aligned}K & =[\\begin{aligned}1 & 3 & 2 \\\\ -2 & 4 & -2 \\\\ 0 & -1 & -1\\end{aligned}]\\,{R}_{2}:={R}_{2}+2\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 2 \\\\ 0 & 10 & 2 \\\\ 0 & -1 & -1\\end{aligned}] \\\\  & =L.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}:={R}_{2}+2{R}_{1}.\n$$" "First, notice that the $1$st and the $3$rd rows are the same in both matrices. The only row that has changed is the $2$