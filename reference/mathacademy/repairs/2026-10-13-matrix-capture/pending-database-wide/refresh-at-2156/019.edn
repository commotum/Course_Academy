 2\\end{aligned}]-3[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}-4 & 0 & 0 \\\\ 0 & -1 & 1 \\\\ 0 & 1 & -1\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-3I)x=0$ gives the eigenvector ${v}_{1}=[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}].$ Dividing ${v}_{1}$ by its norm $‖{v}_{1}‖=\\sqrt{2},$ we get \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}].\n$$\n\n- For ${\\lambda }_{2}=1,$ we have\n\n$$\n\\begin{aligned}A-I & =[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & 2 & 1 \\\\ 0 & 1 & 2\\end{aligned}]-[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}-2 & 0 & 0 \\\\ 0 & 1 & 1 \\\\ 0 & 1 & 1\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-I)x=0$ gives the eigenvector ${v}_{2}=[\\begin{aligned}0 \\\\ -1 \\\\ 1\\end{aligned}].$ Dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=\\sqrt{2},$ we get \n\n$$\n\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}0 \\\\ -1 \\\\ 1\\end{aligned}].\n$$\n\n- For ${\\lambda }_{3}=-1,$ we have\n\n$$\n\\begin{aligned}A-(-1)I & =[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & 2 & 1 \\\\ 0 & 1 & 2\\end{aligned}]-(-1)[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 3 & 1 \\\\ 0 & 1 & 3\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-(-1)I)x=0$ gives the eigenvector ${v}_{3}=[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}].$ Dividing ${v}_{3}$ by its norm $‖{v}_{3}‖=1,$ we get \n\n$$\n\\frac{{v}_{3}}{‖{v}_{3}‖}=\\frac{1}{1}[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]=[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}].\n$$\n\nFinally, we construct the orthogonal matrix $P$ in the usual way, and this gives us the following:\n\n$$\nP=[\\begin{aligned}0 & 0 & 1 \\\\ \\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} & 0 \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} & 0\\end{aligned}]\n$$"] [175921