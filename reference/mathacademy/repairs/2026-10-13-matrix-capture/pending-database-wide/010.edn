 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 5\\end{aligned}]$\nand\n$P=[\\begin{aligned}1 & 3 & 0 \\\\ 3 & -1 & 3 \\\\ 0 & 0 & -1\\end{aligned}]$" "$D=\\begin{bmatrix}-3 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 5\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}1 & 3 & 0 \\\\ 3 & -1 & 3 \\\\ 0 & 0 & -1\\end{bmatrix}$"] [:db/cas 17592186271467 :answer/value "$D=[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 9\\end{aligned}]$\nand\n$P=[\\begin{aligned}1 & 2 & 0 \\\\ 0 & 1 & -1 \\\\ 1 & 0 & 1\\end{aligned}]$" "$D=\\begin{bmatrix}-1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 9\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}1 & 2 & 0 \\\\ 0 & 1 & -1 \\\\ 1 & 0 & 1\\end{bmatrix}$"] [:db/cas 17592186271477 :answer/value "[\\begin{aligned}1 \\\\ 2\\end{aligned}]" "\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}"] [:db/cas 17592186271483 :answer/value "$D=[\\begin{aligned}-2 & 0 \\\\ 0 & 2\\end{aligned}]$\nand\n$P=[\\begin{aligned}4 & 3 \\\\ 1 & 1\\end{aligned}]$" "$D=\\begin{bmatrix}-2 & 0 \\\\ 0 & 2\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}4 & 3 \\\\ 1 & 1\\end{bmatrix}$"] [:db/cas 17592186271502 :answer/value "[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}]" "\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}"] [:db/cas 17592186271956 :question/problem "| $x$ | **$-2$** | **$-1$** | **$0$** | **$1$** | **$2$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $-1$ | $1$ | $2$ | $3$ | $5$ |\n\nFind the line of the form $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above.\n\n*Hint: You can use the fact that*\n\n$$\n({X}^{T}\\,X)^{-1}=\\frac{1}{10}[\\begin{aligned}2 & 0 \\\\ 0 & 1\\end{aligned}],\\,{X}^{T}y=[\\begin{aligned}10 \\\\ 14\\end{aligned}],\n$$\n\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*" "| $x$ | **$-2$** | **$-1$** | **$0$** | **$1$** | **$2$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $-1$ | $1$ | $2$ | $3$ | $5$ |\n\nFind the line of the form $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above.\n\n*Hint: You can use the fact that*\n\n$$\n({X}^{T}\\,X)^{-1}=\\frac{1}{10}\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix},\\,{X}^{T}y=\\begin{bmatrix}10 \\\\ 14\\end{bmatrix},\n$$\n\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*"] [:db/cas 17592186271956 :question/worked-solution "The coefficients of the line that best fits the data can be found as the least-squares solution $\\overset{^}{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{[\\begin{aligned}1 & -2 \\\\ 1 & -1 \\\\ 1 & 0 \\\\ 1 & 1 \\\\ 1 & 2\\end{aligned}]}}\\overset{\\beta }{\\overset{⏞}{[\\begin{aligned}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{aligned}]}} & =\\overset{y}{\\overset{⏞}{[\\begin{aligned}-6 \\\\ -5 \\\\ -1 \\\\ 1 \\\\ 1\\end{aligned}]}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation by ${X}^{T},$ we obtain the corresponding normal equation\n\n$$\n{X}^{T}\\,X\\overset{^}{\\beta }={X}^{T}y.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X}^{T}X$ is invertible and \n\n$$\n\\overset{^}{\\beta }=({X}^{T}\\,X)^{-1}{X}^{T}y.\n$$\n\nSubstituting the given values of $({X}^{T}X)^{-1}$ and ${X}^{T}y$ into the formula, we get\n\n$$\n\\begin{aligned}\\overset{^}{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{10}[\\begin{aligned}2 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}10 \\\\ 14\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 1.4\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we have the line $y=2+1.4x.$" "The coefficients of the line that best fits the data can be found as the least-squares solution $\\hat{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & -2 \\\\ 1 & -1 \\\\ 1 & 0 \\\\ 1 & 1 \\\\ 1 & 2\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}-6 \\\\ -5 \\\\ -1 \\\\ 1 \\\\ 1\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation by ${X}^{T},$ we obtain the corresponding normal equation\n\n$$\n{X}^{T}\\,X\\hat{\\beta }={X}^{T}y.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X}^{T}X$ is invertible and \n\n$$\n\\hat{\\beta }=({X}^{T}\\,X)^{-1}{X}^{T}y.\n$$\n\nSubstituting the given values of $({X}^{T}X)^{-1}$ and ${X}^{T}y$ into the formula, we get\n\n$$\n\\begin{aligned}\\hat{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{10}\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}10 \\\\ 14\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ 1.4\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have the line $y=2+1.4x.$"] [:db/cas 17592186271957 :question/problem "| $x$ | **$-2$** | **$-1$** | **$0$** | **$1$** |\n| --- | --- | --- | --- | --- |\n| $y$ | $1$ | $5$ | $8$ | $10$ |\n\nFind the line of the form $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above.\n\n*Hint: You can use the fact that*\n\n$$\n({X}^{T}\\,X)^{-1}=\\frac{1}{20}[\\begin{aligned}6 & 2 \\\\ 2 & 4\\end{aligned}],\\,{X}^{T}y=[\\begin{aligned}24 \\\\ 3\\end{aligned}],\n$$\n\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*" "| $x$ | **$-2$** | **$-1$** | **$0$** | **$1$** |\n| --- | --- | --- | --- | --- |\n| $y$ | $1$ | $5$ | $8$ | $10$ |\n\nFind the line of the form $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above.\n\n*Hint: You can use the fact that*\n\n$$\n({X}^{T}\\,X)^{-1}=\\frac{1}{20}\\begin{bmatrix}6 & 2 \\\\ 2 & 4\\end{bmatrix},\\,{X}^{T}y=\\begin{bmatrix}24 \\\\ 3\\end{bmatrix},\n$$\n\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*"] [:db/cas 17592186271957 :question/worked-solution "The coefficients of the line that best fits the data can be found as the least-squares solution $\\overset{^}{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{[\\begin{aligned}1 & -2 \\\\ 1 & -1 \\\\ 1 & 0 \\\\ 1 & 1\\end{aligned}]}}\\overset{\\beta }{\\overset{⏞}{[\\begin{aligned}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{aligned}]}} & =\\overset{y}{\\overset{⏞}{[\\begin{aligned}1 \\\\ 5 \\\\ 8 \\\\ 10\\end{aligned}]}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation by ${X}^{T},$ we obtain the corresponding normal equation \n\n$$\n{X}^{T}\\,X\\overset{^}{\\beta }={X}^{T}y.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X}^{T}X$ is invertible and \n\n$$\n\\overset{^}{\\beta }=({X}^{T}\\,X)^{-1}{X}^{T}y.\n$$\n\nSubstituting the given values of $({X}^{T}X)^{-1}$ and ${X}^{T}y$ into the formula, we get\n\n$$\n\\begin{aligned}\\overset{^}{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{20}[\\begin{aligned}6 & 2 \\\\ 2 & 4\\end{aligned}][\\begin{aligned}24 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}7.5 \\\\ 3\\end{aligned}].\\end{aligned}\n$$\n\nHence, $y=7.5+3x.$" "The coefficients of the line that best fits the data can be found as the least-squares solution $\\hat{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & -2 \\\\ 1 & -1 \\\\ 1 & 0 \\\\ 1 & 1\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}1 \\\\ 5 \\\\ 8 \\\\ 10\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation by ${X}^{T},$ we obtain the corresponding normal equation \n\n$$\n{X}^{T}\\,X\\hat{\\beta }={X}^{T}y.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X}^{T}X$ is invertible and \n\n$$\n\\hat{\\beta }=({X}^{T}\\,X)^{-1}{X}^{T}y.\n$$\n\nSubstituting the given values of $({X}^{T}X)^{-1}$ and ${X}^{T}y$ into the formula, we get\n\n$$\n\\begin{aligned}\\hat{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{20}\\begin{bmatrix}6 & 2 \\\\ 2 & 4\\end{bmatrix}\\begin{bmatrix}24 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}7.5 \\\\ 3\\end{bmatrix}.\\end{aligned}\n$$\n\nHence, $y=7.5+3x.$"] [:db/cas 17592186271958 :question/problem "| $x$ | **$-3$** | **$0$** | **$1$** | **$2$** |\n| --- | --- | --- | --- | --- |\n| $y$ | $1$ | $5$ | $7$ | $12$ |\n\nFind the line of the form $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above.\n\n*Hint: You can use the fact that*\n\n$$\n({X}^{T}\\,X)^{-1}=\\frac{1}{56}[\\begin{aligned}14 & 0 \\\\ 0 & 4\\end{aligned}],\\,{X}^{T}y=[\\begin{aligned}25 \\\\ 28\\end{aligned}],\n$$\n\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*" "| $x$ | **$-3$** | **$0$** | **$1$** | **$2$** |\n| --- | --- | --- | --- | --- |\n| $y$ | $1$ | $5$ | $7$ | $12$ |\n\nFind the line of the form $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above.\n\n*Hint: You can use the fact that*\n\n$$\n({X}^{T}\\,X)^{-1}=\\frac{1}{56}\\begin{bmatrix}14 & 0 \\\\ 0 & 4\\end{bmatrix},\\,{X}^{T}y=\\begin{bmatrix}25 \\\\ 28\\end{bmatrix},\n$$\n\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*"] [:db/cas 17592186271958 :question/worked-solution "The coefficients of the line that best fits the data can be found as the least-squares solution $\\overset{^}{\\beta }$ to the system  \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{[\\begin{aligned}1 & -3 \\\\ 1 & 0 \\\\ 1 & 1 \\\\ 1 & 2\\end{aligned}]}}\\overset{\\beta }{\\overset{⏞}{[\\begin{aligned}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{aligned}]}} & =\\overset{y}{\\overset{⏞}{[\\begin{aligned}1 \\\\ 5 \\\\ 7 \\\\ 12\\end{aligned}]}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation b