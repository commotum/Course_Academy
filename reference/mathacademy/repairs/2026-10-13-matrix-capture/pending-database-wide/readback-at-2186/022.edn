lambda }_{3})\\end{bmatrix}\n$$\n\nand\n\n$$\nP=\\begin{bmatrix}| & | & | & | \\\\ \\text{Re}({v}_{1}) & \\text{Im}({v}_{1}) & \\text{Re}({v}_{3}) & \\text{Im}({v}_{3}) \\\\ | & | & | & |\\end{bmatrix}.\n$$\n\nSwapping the blocks on the main diagonal of $B$ will result in switching the corresponding columns in $P.$\n\nFrom our block diagonal matrix\n\n$$\nB=\\begin{bmatrix}-4 & -3 & 0 & 0 \\\\ 3 & -4 & 0 & 0 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & -2 & 0\\end{bmatrix},\n$$\n\nwe deduce that the first and second columns of $P$ correspond to the complex eigenvector ${v}_{1},$ and the third and forth columns of $P$ correspond to the complex eigenvector ${v}_{3}.$ Therefore,\n\n$$\nP=\\begin{bmatrix}-7 & -6 & -2 & 5 \\\\ 4 & 4 & -2 & -1 \\\\ -2 & 5 & -3 & 0 \\\\ -1 & -2 & -1 & -7\\end{bmatrix}.\n$$"] [17592186388398 :answer/value "\\begin{bmatrix}4 & 4 & -2 & -1 \\\\ -7 & -6 & -2 & 5 \\\\ -1 & -2 & -1 & -7 \\\\ -2 & 5 & -3 & 0\\end{bmatrix}"] [17592186388399 :answer/value "\\begin{bmatrix}4 & 4 & -1 & -2 \\\\ -2 & 5 & 0 & -3 \\\\ -7 & -6 & 5 & -2 \\\\ -1 & -2 & -7 & -1\\end{bmatrix}"] [17592186388400 :answer/value "\\begin{bmatrix}4 & 4 & -2 & -1 \\\\ -2 & 5 & -3 & 0 \\\\ -7 & -6 & -2 & 5 \\\\ -1 & -2 & -1 & -7\\end{bmatrix}"] [17592186388401 :answer/value "\\begin{bmatrix}-7 & -6 & -2 & 5 \\\\ 4 & 4 & -2 & -1 \\\\ -2 & 5 & -3 & 0 \\\\ -1 & -2 & -1 & -7\\end{bmatrix}"] [17592186388402 :answer/value "\\begin{bmatrix}-6 & -7 & -2 & 5 \\\\ 4 & 4 & -2 & -1 \\\\ 5 & -2 & -3 & 0 \\\\ -2 & -1 & -1 & -7\\end{bmatrix}"] [17592186388403 :question/problem "Find $By$  if \n$B=\\begin{bmatrix}b & b \\\\ c & c\\end{bmatrix}$\nand\n$y=\\begin{bmatrix}3 \\\\ 4\\end{bmatrix}.$"] [17592186388403 :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product: \n\n$$\n\\begin{aligned}By & =\\begin{bmatrix}b & b \\\\ c & c\\end{bmatrix}\\begin{bmatrix}3 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}b\\cdot 3+b\\cdot 4 \\\\ c\\cdot 3+c\\cdot 4\\end{bmatrix} 