 3\\end{bmatrix}\n$$"] [17592186388425 :answer/value "\\begin{bmatrix}3 & 0 & 2 \\\\ 4 & 1 & 0 \\\\ 2 & 3 & 6\\end{bmatrix}"] [17592186388426 :answer/value "\\begin{bmatrix}4 & 6 & 2 \\\\ 3 & 1 & 0 \\\\ 2 & 2 & 3\\end{bmatrix}"] [17592186388427 :answer/value "\\begin{bmatrix}3 & 2 & 2 \\\\ 4 & 1 & 0 \\\\ 2 & 6 & 3\\end{bmatrix}"] [17592186388428 :answer/value "\\begin{bmatrix}2 & 2 & 3 \\\\ 4 & 1 & 0 \\\\ 0 & 6 & 3\\end{bmatrix}"] [17592186388429 :answer/value "\\begin{bmatrix}1 & 2 & 3 \\\\ 4 & 0 & 1 \\\\ 2 & 6 & 3\\end{bmatrix}"] [17592186388430 :question/problem "Consider the vectors ${v}_{1}$ and ${v}_{3}$ and the block diagonal matrix $B$ shown below, where the $2\\times 2$ block of $B$ represents a rotation-scaling matrix:\n\n$$\n{v}_{1}=\\begin{bmatrix}3+5\\text{i} \\\\ 1-6\\text{i} \\\\ 4\\text{i}\\end{bmatrix},\\,{v}_{3}=\\begin{bmatrix}5 \\\\ 2 \\\\ 1\\end{bmatrix},\\,B=\\begin{bmatrix}2 & 8 & 0 \\\\ -8 & 2 & 0 \\\\ 0 & 0 & -5\\end{bmatrix}\n$$\n\nThe vectors ${v}_{1}$ and ${v}_{3}$ are the eigenvectors of a matrix $A$ corresponding to the eigenvalues ${\\lambda }_{1}=2+8\\text{i}$ and ${\\lambda }_{3}=-5,$ respectively. \nGiven that $A=PB{P}^{-1},$ which of the following could be the matrix $P?$"] [17592186388430 :question/worked-solution "Recall that if $A$ is a real $3\\times 3$ matrix that has one real eigenvalue ${\\lambda }_{3}$ with corresponding eigenvector ${v}_{3},$ and two complex eigenvalues ${\\lambda }_{1}={\\overset{―}{\\lambda }}_{2}$ with corresponding eigenvectors ${v}_{1}={\\overset{―}{v}}_{2},$ then $A=PB{P}^{-1},$ where\n\n$$\nB=\\begin{bmatrix}\\text{Re}({\\lambda }_{1}) & \\text{Im}({\\lambda }_{1}) & 0 \\\\ -\\text{Im}({\\lambda }_{1}) & \\text{Re}({\\lambda }_{1}) & 0 \\\\ 0 & 0 & {\\lambda }_{3}\\end{bmatrix},\\,\\,P=\\begin{bmatrix}| & | & | \\\\ \\text{Re}({v}_{1}) & \\text{Im}({v}_{1}) & {v}_{3} \\\\ | & | & |\\end{bmatrix}.\n$$\n\nSwapping the blocks on the main diagonal of $B$ will result in switching the corresponding columns in $P.$\n\nFrom our block diagonal matrix\n\n$$\nB=\\begin{bmatrix}2 & 8 & 0 \\\\ -8 & 2 & 0 \\\\ 0 & 0 & -5\\end{bmatrix},\n$$\n\nwe deduce that the first and second columns of $P$ will correspond to the complex eigenvector ${v}_{1},$ and the third column of $P$ will correspond to the real eigenvector ${v}_{3}:$\n\n$$\nP=\\begin{bmatrix}3 & 5 & 5 \\\\ 1 & -6 & 2 \\\\ 0 & 4 & 1\\end{bmatrix}\n$$"] [17592186388432 :answer/value "\\begin{bmatrix}5 & 5 & 2 \\\\ 1 & 0 & 2 \\\\ -6 & 4 & 1\\end{bmatrix}"] [17592186388433 :answer/value "\\begin{bmatrix}3 & 2 & 5 \\\\ 1 & 6 & 2 \\\\ 1 & 4 & 0\\end{bmatrix}"] [17592186388434 :answer/value "\\begin{bmatrix}3 & 5 & 5 \\\\ 1 & -6 & 2 \\\\ 0 & 4 & 1\\end{bmatrix}"] [17592186388435 :answer/value "\\begin{bmatrix}3 & 5 & 1 \\\\ 5 & -6 & 5 \\\\ 0 & 4 & 6\\end{bmatrix}"] [17592186388436 :answer/value "\\begin{bmatrix}3 & 5 & 3 \\\\ 2 & -6 & 0 \\\\ 0 & 1 & -4\\end{bmatrix}"] [17592186388437 :question/problem "Consider the vectors ${v}_{1}$ and ${v}_{2}$ and the block diagonal matrix $B$ shown below, where the $2\\times 2$ block of $B$ represents a rotation-scaling matrix:\n\n$$\n{v}_{1}=\\begin{bmatrix}4 \\\\ 0 \\\\ -3\\end{bmatrix},\\,{v}_{2}=\\begin{bmatrix}1-\\text{i} \\\\ -6+3\\text{i} \\\\ -5\\text{i}\\end{bmatrix},\\,B=\\begin{bmatrix}7 & 0 & 0 \\\\ 0 & 4 & 8 \\\\ 0 & -8 & 4\\end{bmatrix}\n$$\n\nThe vectors ${v}_{1}$ and ${v}_{2}$ are the eigenvectors of a matrix $A$ corresponding to the eigenvalues ${\\lambda }_{1}=7$ and ${\\lambda }_{2}=4+8\\text{i},$ respectively. \nGiven that $A=PB{P}^{-1},$ which of the following could be the matrix $P?$"] [17592186388437 :question/worked-solution "Recall that if $A$ is a real $3\\times 3$ matrix that has one real eigenvalue ${\\lambda }_{1}$ with corresponding eigenvector ${v}_{1},$ and two complex eigenvalues ${\\lambda }_{2}={\\overset{―}{\\lambda }}_{3}$ with corresponding eigenvectors ${v}_{2}={\\overset{―}{v}}_{3},$ then $A=PB{P}^{-1},$ where\n\n$$\nB=\\begin{bmatrix}{\\lambda }_{