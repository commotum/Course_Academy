 & \\frac{1}{\\sqrt{17}}\\end{aligned}]$\nand\n$V=[\\begin{aligned}\\frac{1}{\\sqrt{17}} & -\\frac{4}{\\sqrt{17}} \\\\ \\frac{4}{\\sqrt{17}} & \\frac{1}{\\sqrt{17}}\\end{aligned}]$" "$U=\\begin{bmatrix}-\\frac{1}{\\sqrt{17}} & \\frac{4}{\\sqrt{17}} \\\\ \\frac{4}{\\sqrt{17}} & \\frac{1}{\\sqrt{17}}\\end{bmatrix}$\nand\n$V=\\begin{bmatrix}\\frac{1}{\\sqrt{17}} & -\\frac{4}{\\sqrt{17}} \\\\ \\frac{4}{\\sqrt{17}} & \\frac{1}{\\sqrt{17}}\\end{bmatrix}$"] [:db/cas 17592186371373 :answer/value "$U=[\\begin{aligned}\\frac{3}{\\sqrt{10}} & -\\frac{1}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}}\\end{aligned}]$\nand\n$V=[\\begin{aligned}-\\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{aligned}]$" "$U=\\begin{bmatrix}\\frac{3}{\\sqrt{10}} & -\\frac{1}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}}\\end{bmatrix}$\nand\n$V=\\begin{bmatrix}-\\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{bmatrix}$"] [:db/cas 17592186371374 :question/problem "$$\nA=[\\begin{aligned}1 & -3 \\\\ 3 & -9\\end{aligned}],\\,Σ=[\\begin{aligned}10 & 0 \\\\ 0 & 0\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $Σ$ shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the matrices $U$ and $V?$" "$$\nA=\\begin{bmatrix}1 & -3 \\\\ 3 & -9\\end{bmatrix},\\,Σ=\\begin{bmatrix}10 & 0 \\\\ 0 & 0\\end{bmatrix}\n$$\n\nConsider the matrices $A$ and $Σ$ shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the matrices $U$ and $V?$"] [:db/cas 17592186371374 :question/worked-solution "Let's find the singular value decomposition of $A$ using the usual algorithm.\n\n- **Step 1.** Compute ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={[\\begin{aligned}1 & -3 \\\\ 3 & -9\\end{aligned}]}^{T}[\\begin{aligned}1 & -3 \\\\ 3 & -9\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 3 \\\\ -3 & -9\\end{aligned}][\\begin{aligned}1 & -3 \\\\ 3 & -9\\end{aligned}] \\\\  & =[\\begin{aligned}10 & -30 \\\\ -30 & 90\\end{aligned}]\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values: Notice that from the matrix $Σ,$ we can deduce that ${\\sigma }_{1}=10$ and ${\\sigma }_{2}=0$ without solving the characteristic equation.\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of ${A}^{T}\\,A$):\n\n- For ${\\lambda }_{1}={\\sigma }_{1}^{2}=100,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-100I & =[\\begin{aligned}10 & -30 \\\\ -30 & 90\\end{aligned}]-100[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-90 & -30 \\\\ -30 & -10\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-100I)v=0$ gives a unit eigenvector\n\n$$\n{v}_{1}=[\\begin{aligned}-\\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{aligned}].\n$$\n\n- For ${\\lambda }_{2}={\\sigma }_{2}^{2}=0,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-0I & =[\\begin{aligned}10 & -30 \\\\ -30 & 90\\end{aligned}]-0[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}10 & -30 \\\\ -30 & 90\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-0I)v=0$ gives a unit eigenvector\n\n$$\n{v}_{2}=[\\begin{aligned}\\frac{3}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}}\\end{aligned}].\n$$\n\n- **Step 4.** Find the left singular vectors of $A$ (i.e., the unit eigenvectors of $A{A}^{T}$): Since the first singular value is not zero, and we know the corresponding singular right vector, we can compute the first column of $U$ as follows:\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{10}[\\begin{aligned}1 & -3 \\\\ 3 & -9\\end{aligned}][\\begin{aligned}-\\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{aligned}] \\\\  & =\\frac{1}{10}[\\begin{aligned}-\\frac{10}{\\sqrt{10}} \\\\ -\\frac{30}{\\sqrt{10}}\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{1}{\\sqrt{10}} \\\\ -\\frac{3}{\\sqrt{10}}\\end{aligned}]\\end{aligned}\n$$\n\nSince the second singular value is ${\\sigma }_{2}=0$, we can't use the same formula to find the second column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector\n\n$$\n{u}_{2}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]\n$$\n\nsuch that \n\n$$\n{u}_{1}\\cdot {u}_{2}=0\\,\\text{and}\\,‖{u}_{2}‖=1.\n$$\n\n \n\nSolving ${u}_{1}\\cdot {u}_{2}=0,$ which is equivalent to\n\n$$\n-\\frac{1}{\\sqrt{10}}{x}_{1}-\\frac{3}{\\sqrt{10}}{x}_{2}=0,\n$$\n\nwe get a nonzero solution $[\\begin{aligned}-3 \\\\ 1\\end{aligned}].$ Normalizing this vector, we finally obtain the  second column of $U:$\n\n$$\n{u}_{2}=\\frac{1}{\\sqrt{10}}[\\begin{aligned}-3 \\\\ 1\\end{aligned}]=[\\begin{aligned}-\\frac{3}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}}\\end{aligned}]\n$$\n\nFinally, we construct the matrices $U$ and $V:$\n\n$$\nU=[\\begin{aligned}-\\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}} \\\\ -\\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{aligned}],\\,V=[\\begin{aligned}-\\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{aligned}]\n$$" "Let's find the singular value decomposition of $A$ using the usual algorithm.\n\n- **Step 1.** Compute ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}1 & -3 \\\\ 3 & -9\\end{bmatrix}}^{T}\\begin{bmatrix}1 & -3 \\\\ 3 & -9\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 3 \\\\ -3 & -9\\end{bmatrix}\\begin{bmatrix}1 & -3 \\\\ 3 & -9\\end{bmatrix} \\\\  & =\\begin{bmatrix}10 & -30 \\\\ -30 & 90\\end{bmatrix}\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values: Notice that from the matrix $Σ,$ we can deduce that ${\\sigma }_{1}=10$ and ${\\sigma }_{2}=0$ without solving the characteristic equation.\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of ${A}^{T}\\,A$):\n\n- For ${\\lambda }_{1}={\\sigma }_{1}^{2}=100,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-100I & =\\begin{bmatrix}10 & -30 \\\\ -30 & 90\\end{bmatrix}-100\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-90 & -30 \\\\ -30 & -10\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-100I)v=0$ gives a unit eigenvector\n\n$$\n{v}_{1}=\\begin{bmatrix}-\\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{bmatrix}.\n$$\n\n- For ${\\lambda }_{2}={\\sigma }_{2}^{2}=0,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-0I & =\\begin{bmatrix}10 & -30 \\\\ -30 & 90\\end{bmatrix}-0\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}10 & -30 \\\\ -30 & 90\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-0I)v=0$ gives a unit eigenvector\n\n$$\n{v}_{2}=\\begin{bmatrix}\\frac{3}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}}\\end{bmatrix}.\n$$\n\n- **Step 4.** Find the left singular vectors of $A$ (i.e., the unit eigenvectors of $A{A}^{T}$): Since the first singular value is not zero, and we know the corresponding singular right vector, we can compute the first column of $U$ as follows:\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{10}\\begin{bmatrix}1 & -3 \\\\ 3 & -9\\end{bmatrix}\\begin{bmatrix}-\\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{bmatrix} \\\\  & =\\frac{1}{10}\\begin{bmatrix}-\\frac{10}{\\sqrt{10}} \\\\ -\\frac{30}{\\sqrt{10}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{1}{\\sqrt{10}} \\\\ -\\frac{3}{\\sqrt{10}}\\end{bmatrix}\\end{aligned}\n$$\n\nSince the second singular value is ${\\sigma }_{2}=0$, we can't use the same formula to find the second column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector\n\n$$\n{u}_{2}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}\n$$\n\nsuch that \n\n$$\n{u}_{1}\\cdot {u}_{2}=0\\,\\text{and}\\,‖{u}_{2}‖=1.\n$$\n\n \n\nSolving ${u}_{1}\\cdot {u}_{2}=0,$ which is equivalent to\n\n$$\n-\\frac{1}{\\sqrt{10}}{x}_{1}-\\frac{3}{\\sqrt{10}}{x}_{2}=0,\n$$