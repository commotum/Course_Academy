\\ -2 & 0 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{\\sqrt{5}}[\\begin{aligned}0 \\\\ -2 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ -\\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}}\\end{aligned}]\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{2}[\\begin{aligned}0 & 2 \\\\ -2 & 0 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}2 \\\\ 0 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nSince we do not have the third singular value, we can't use the same formula to find the third column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector \n\n$$\n{u}_{3}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]\n$$\n\nsuch that \n\n$$\n\\{\\begin{aligned}{u}_{1}\\cdot {u}_{3}=0 \\\\ {u}_{2}\\cdot {u}_{3}=0,\\end{aligned}\\,‖{u}_{3}‖=1.\n$$\n\nSolving this system, which is equivalent to\n\n$$\n\\{\\begin{aligned}-\\frac{2}{\\sqrt{5}}{x}_{2}-\\frac{1}{\\sqrt{5}}{x}_{3}=0 \\\\ {x}_{1}=0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}2{x}_{2}+{x}_{3}=0 \\\\ {x}_{1}=0,\\end{aligned}\n$$\n\nwe get the nonzero normalized solution \n\n$$\n{u}_{3}=[\\begin{aligned}0 \\\\ -\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{aligned}].\n$$\n\nFinally, we construct the matrix $U:$\n\n$$\nU=[\\begin{aligned}0 & 1 & 0 \\\\ -\\frac{2}{\\sqrt{5}} & 0 & -\\frac{1}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}} & 0 & \\frac{2}{\\sqrt{5}}\\end{aligned}]\n$$" "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=\\sqrt{5}$ and ${\\sigma }_{2}=2.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the $1$st and $2$nd columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{\\sqrt{5}}\\begin{bmatrix}0 & 2 \\\\ -2 & 0 \\\\ -1 & 0\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix} \\\\  & =\\frac{1}{\\sqrt{5}}\\begin{bmatrix}0 \\\\ -2 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ -\\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}}\\end{bmatrix}\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{2}\\begin{bmatrix}0 & 2 \\\\ -2 & 0 \\\\ -1 & 0\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}2 \\\\ 0 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$\n\nSince we do not have the third singular value, we can't use the same formula to find the third column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector \n\n$$\n{u}_{3}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\n$$\n\nsuch that \n\n$$\n\\{\\begin{aligned}{u}_{1}\\cdot {u}_{3}=0 \\\\ {u}_{2}\\cdot {u}_{3}=0,\\end{aligned}\\,‖{u}_{3}‖=1.\n$$\n\nSolving this system, which is equivalent to\n\n$$\n\\{\\begin{aligned}-\\frac{2}{\\sqrt{5}}{x}_{2}-\\frac{1}{\\sqrt{5}}{x}_{3}=0 \\\\ {x}_{1}=0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}2{x}_{2}+{x}_{3}=0 \\\\ {x}_{1}=0,\\end{aligned}\n$$\n\nwe get the nonzero normalized solution \n\n$$\n{u}_{3}=\\begin{bmatrix}0 \\\\ -\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{bmatrix}.\n$$\n\nFinally, we construct the matrix $U:$\n\n$$\nU=\\begin{bmatrix}0 & 1 & 0 \\\\ -\\frac{2}{\\sqrt{5}} & 0 & -\\frac{1}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}} & 0 & \\frac{2}{\\sqrt{5}}\\end{bmatrix}\n$$"] [:db/cas 17592186371424 :answer/value "[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} \\\\ 0\\end{aligned}]" "\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} \\\\ 0\\end{bmatrix}"] [:db/cas 17592186371425 :answer/value "[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]" "\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}"] [:db/cas 17592186371426 :answer/value "[\\begin{aligned}0 \\\\ -\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{aligned}]" "\\begin{bmatrix}0 \\\\ -\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{bmatrix}"] [:db/cas 17592186371427 :answer/value "[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]" "\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}"] [:db/cas 17592186371428 :answer/value "[\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} \\\\ 0\\end{aligned}]" "\\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} \\\\ 0\\end{bmatrix}"] [:db/cas 17592186371429 :question/problem "$$\nA=[\\begin{aligned}0 & 1 \\\\ -1 & 0 \\\\ 1 & 0\\end{aligned}],\\,Σ=[\\begin{aligned}\\sqrt{2} & 0 \\\\ 0 & 1 \\\\ 0 & 0\\end{aligned}],\\,V=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the $3$rd column of the matrix $U?$" "$$\nA=\\begin{bmatrix}0 & 1 \\\\ -1 & 0 \\\\ 1 & 0\\end{bmatrix},\\,Σ=\\begin{bmatrix}\\sqrt{2} & 0 \\\\ 0 & 1 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the $3$rd column of the matrix $U?$"] [:db/cas 17592186371429 :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=\\sqrt{2}$ and ${\\sigma }_{2}=1.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the $1$st and $2$nd columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{\\sqrt{2}}[\\begin{aligned}0 & 1 \\\\ -1 & 0 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{\\sqrt{2}}[\\begin{aligned}0 \\\\ -1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}]\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{1}[\\begin{aligned}0 & 1 \\\\ -1 & 0 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nSince we do not have the third singular value, we can't use the same formula to find the third column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector \n\n$$\n{u}_{3}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]\n$$\n\nsuch that \n\n$$\n\\{\\begin{aligned}{u}_{1}\\cdot {u}_{3}=0 \\\\ {u}_{2}\\cdot {u}_{3}=0,\\end{aligned}\\,‖{u}_{3}‖=1.\n$$\n\nSolving this system, which is equivalent to\n\n$$\n\\{\\begin{aligned}-\\frac{1}{\\sqrt{2}}{x}_{2}+\\frac{1}{\\sqrt{2}}{x}_{3}=0 \\\\ {x}_{1}=0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}{x}_{2}-{x}_{3}=0 \\\\ {x}_{1}=0,\\end{aligned}\n$$\n\nwe get the nonzero normalized solution \n\n$$\n{u}_{3}=[\\begin{aligned}0 \\\\ \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}].\n$$\n\nFinally, we construct the matrix $U:$\n\n$$\nU=[\\begin{aligned}0 & 1 & 0 \\\\ -\\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}}\\end{aligned}]\n$$" "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=\\sqrt{2}$ and ${\\sigma }_{2}=1.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the $1$st and $2$nd columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{\\sqrt{2}}\\begin{bmatrix}0 & 1 \\\\ -1 & 0 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix} \\\\  & =\\frac{1}{\\sqrt{2}}\\begin{bmatrix}0 \\\\ -1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{1}\\begin{bmatrix}0 & 1 \\\\ -1 & 0 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$\n\nSince we do not have the third singular value, we can't use the same formula to find the third column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector \n\n$$\n{u}_{3}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\n$$\n\nsuch that \n\n$$\n\\{\\begin{aligned}{u}_{1}\\cdot {u}_{3}=0 \\\\ {u}_{2}\\cdot {u}_{3}=0,\\end{aligned}\\,‖{u}_{3}‖=1.\n$$\n\nSolving this system, which is equivalent to\n\n$$\n\\{\\begin{aligned}-\\frac{1}{\\sqrt{2}}{x}_{2}+\\frac{1}{\\sqrt{2}}{x}_{3}=0 \\\\ {x}_{1}=0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}{x}_{2}-{x}_{3}=0 \\\\ {x}_{1}=0,\\end{aligned}\n$$\n\nwe get the nonzero normalized solution \n\n$$\n{u}_{3}=\\begin{bmatrix}0 \\\\ \\frac{1}{\