ix}\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u} & ={{\\begin{bmatrix}-2 & -3 \\\\ 1 & \\frac{5}{3}\\end{bmatrix}}_{⏟}}_{{A}^{-1}}\\cdot ({{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{⏟}}_{x}-{{\\begin{bmatrix}3 \\\\ -2\\end{bmatrix}}_{⏟}}_{b}) \\\\  & =\\begin{bmatrix}-2 & -3 \\\\ 1 & \\frac{5}{3}\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}-2 & -3 \\\\ 1 & \\frac{5}{3}\\end{bmatrix}\\begin{bmatrix}3 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & -3 \\\\ 1 & \\frac{5}{3}\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}0 \\\\ -\\frac{1}{3}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & -3 \\\\ 1 & \\frac{5}{3}\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}+\\begin{bmatrix}0 \\\\ \\frac{1}{3}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=-2+\\frac{5}{3}+\\frac{1}{3}=0.\n$$"] [17592186259633 :question/problem "The matrix form of the affine transformation $T$ is given by\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}8 & 9 \\\\ 4 & 5\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}6 \\\\ 2\\end{bmatrix}.\n$$\n\nFind $a+b+c,$ given that the matrix form of the inverse transformation ${T}^{-1}$ is given by\n\n$$\n\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}a & b \\\\ -1 & c\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}+\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix}.\n$$"] [17592186259633 :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nThe matrix form of $T$ gives us the following information:\n\n$$\n{{\\begin{bmatrix}8 & 9 \\\\ 4 & 5\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}6 \\\\ 2\\end{bmatrix}}_{⏟}}_{b}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{5\\cdot 8-9\\cdot 4}\\begin{bmatrix}5 & -9 \\\\ -4 & 8\\end{bmatrix} \\\\  & =\\frac{1}{4}\\begin{bmatrix}5 & -9 \\\\ -4 & 8\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u} & ={{\\begin{bmatrix}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{bmatrix}}_{⏟}}_{{A}^{-1}}\\cdot ({{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{⏟}}_{x}-{{\\begin{bmatrix}6 \\\\ 2\\end{bmatrix}}_{⏟}}_{b}) \\\\  & =\\begin{bmatrix}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}6 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}3 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}+\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=\\frac{5}{4}+(-\\frac{9}{4})+2=1.\n$$"] [17592186259634 :question/problem "The matrix form of the affine transformation $T$ is given by\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-2 & 5 \\\\ -1 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}6 \\\\ 2\\end{bmatrix}.\n$$\n\nFind $a+b+c,$ given that the matrix form of the inverse transformation ${T}^{-1}$ is given by\n\n$$\n\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}a & 5 \\\\ b & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}+\\begin{bmatrix}c \\\\ 2\\end{bmatrix}.\n$$"] [17592186259634 :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nThe matrix form of $T$ gives us the following information:\n\n$$\n{{\\begin{bmatrix}-2 & 5 \\\\ -1 & 3\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}6 \\\\ 2\\end{bmatrix}}_{⏟}}_{b}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{3\\cdot (-2)-5\\cdot (-1)}\\begin{bmatrix}3 & -5 \\\\ 1 & -2\\end{bmatrix} \\\\  & =\\frac{1}{-1}\\begin{bmatrix}3 & -5 \\\\ 1 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & 5 \\\\ -1 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u} & ={{\\begin{bmatrix}-3 & 5 \\\\ -1 & 2\\end{bmatrix}}_{⏟}}_{{A}^{-1}}\\cdot ({{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{⏟}}_{x}-{{\\begin{bmatrix}6 \\\\ 2\\end{bmatrix}}_{⏟}}_{b}) \\\\  & =\\begin{bmatrix}-3 & 5 \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}-3 & 5 \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}6 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & 5 \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}-8 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & 5 \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}+\\begin{bmatrix}8 \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=-3+(-1)+8=4.\n$$"] [17592186259635 :question/problem "Which of the following are affine transformations?\n\n- ${T}_{1}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}7u-v+6 \\\\ -7\\end{bmatrix}$\n- ${T}_{2}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}8v-9u \\\\ 4u-v\\end{bmatrix}$\n- ${T}_{3}:\\