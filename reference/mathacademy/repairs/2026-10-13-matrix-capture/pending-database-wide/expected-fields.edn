 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}"] [17592186390717 :answer/value "x=\\begin{bmatrix}1 & 1 \\\\ -2 & 3\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}"] [17592186390718 :question/worked-solution "This system can be written as\n\n$$\n\\begin{bmatrix}2 & 6 \\\\ 8 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}46 \\\\ -23\\end{bmatrix}.\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=\\begin{bmatrix}2 & 6 \\\\ 8 & 1\\end{bmatrix}.$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{2\\cdot 1-6\\cdot 8}\\begin{bmatrix}1 & -6 \\\\ -8 & 2\\end{bmatrix} \\\\  & =-\\frac{1}{46}\\begin{bmatrix}1 & -6 \\\\ -8 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{46}\\begin{bmatrix}1 & -6 \\\\ -8 & 2\\end{bmatrix}\\begin{bmatrix}46 \\\\ -23\\end{bmatrix}\\end{aligned}\n$$"] [17592186390720 :answer/value "x=-\\frac{1}{50}\\begin{bmatrix}2 & -6 \\\\ -8 & 1\\end{bmatrix}\\begin{bmatrix}46 \\\\ -23\\end{bmatrix}"] [17592186390721 :answer/value "x=-\\frac{1}{46}\\begin{bmatrix}1 & -8 \\\\ -6 & 2\\end{bmatrix}\\begin{bmatrix}46 \\\\ -23\\end{bmatrix}"] [17592186390722 :answer/value "x=\\frac{1}{50}\\begin{bmatrix}1 & 6 \\\\ 8 & 2\\end{bmatrix}\\begin{bmatrix}46 \\\\ -23\\end{bmatrix}"] [17592186390723 :answer/value "x=\\frac{1}{46}\\begin{bmatrix}2 & 6 \\\\ 8 & 1\\end{bmatrix}\\begin{bmatrix}46 \\\\ -23\\end{bmatrix}"] [17592186390724 :answer/value "x=-\\frac{1}{46}\\begin{bmatrix}1 & -6 \\\\ -8 & 2\\end{bmatrix}\\begin{bmatrix}46 \\\\ -23\\end{bmatrix}"] [17592186390732 :answer/value "\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}"] [17592186390733 :answer/value "\\begin{bmatrix}6 & -9 \\\\ 4 & -6\\end{bmatrix}"] [17592186390734 :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}"] [17592186390735 :answer/value "\\begin{bmatrix}6 & -6 \\\\ 4 & -9\\end{bmatrix}"] [17592186390736 :answer/value "\\begin{bmatrix}-6 & 9 \\\\ -4 & 6\\end{bmatrix}"] [17592186390745 :answer/value "\\begin{bmatrix}21t+10 \\\\ 45{t}^{2} \\\\ -24{t}^{3}-2t-6\\end{bmatrix}"] [17592186390746 :answer/value "\\begin{bmatrix}8-45{t}^{2} \\\\ 42t+20 \\\\ -24{t}^{3}-2t-6\\end{bmatrix}"] [17592186390747 :answer/value "\\begin{bmatrix}-42t-20 \\\\ 8-45{t}^{2} \\\\ 24{t}^{3}+2t+6\\end{bmatrix}"] [17592186390748 :answer/value "\\begin{bmatrix}-24{t}^{3}-2t-6 \\\\ 8-45{t}^{2} \\\\ 42t+20\\end{bmatrix}"] [17592186390749 :answer/value "\\begin{bmatrix}42t+20 \\\\ 8-45{t}^{2} \\\\ -24{t}^{3}-2t-6\\end{bmatrix}"] [17592186390750 :question/problem "If \n$D=\\begin{bmatrix}\\frac{1}{2} & \\frac{1}{4} \\\\ 1 & \\frac{1}{2}\\end{bmatrix}$, then ${D}^{3}=$"] [17592186390750 :question/worked-solution "First, we compute ${D}^{2}$ as follows:\n\n$$\n\\begin{aligned}{D}^{2} & =D\\cdot D \\\\  & =\\begin{bmatrix}\\frac{1}{2} & \\frac{1}{4} \\\\ 1 & \\frac{1}{2}\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{1}{2} & \\frac{1}{4} \\\\ 1 & \\frac{1}{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{1}{2} & \\frac{1}{4} \\\\ 1 & \\frac{1}{2}\\end{bmatrix} \\\\  & =D\\end{aligned}\n$$\n\nNotice that ${D}^{2}=D,$ so $D$ is an idempotent matrix.\n\nWe can use this fact to compute ${D}^{3}$ quickly, as follows:\n\n$$\n\\begin{aligned}{D}^{3} & ={D}^{2}\\cdot D \\\\  & =D\\cdot D \\\\  & ={D}^{2} \\\\  & =D\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{D}^{3}=\\begin{bmatrix}\\frac{1}{2} & \\frac{1}{4} \\\\ 1 & \\frac{1}{2}\\end{bmatrix}.\n$$"] [17592186390752 :answer/value "\\begin{bmatrix}\\frac{1}{2} & \\frac{1}{4} \\\\ \\frac{1}{2} & \\frac{1}{4}\\end{bmatrix}"] [17592186390753 :answer/value "\\begin{bmatrix}\\frac{1}{2} & \\frac{1}{8} \\\\ 1 & \\frac{1}{4}\\end{bmatrix}"] [17592186390754 :answer/value "\\begin{bmatrix}\\frac{1}{2} & \\frac{1}{8} \\\\ \\frac{1}{4} & \\frac{1}{4}\\end{bmatrix}"] [17592186390755 :answer/value "\\begin{bmatrix}\\frac{1}{2} & \\frac{1}{4} \\\\ 1 & \\frac{1}{2}\\end{bmatrix}"] [17592186390756 :answer/value "\\begin{bmatrix}\\frac{1}{2} & \\frac{1}{8} \\\\ 1 & \\frac{1}{2}\\end{bmatrix}"] [17592186390757 :question/problem "Consider the LU decomposition of the matrix $A$ and the vector $b,$ given by\n\n$$\nA={{\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}1 & 3 \\\\ 0 & 2\\end{bmatrix}}_{⏟}}_{U},\\,b=\\begin{bmatrix}3 \\\\ -3\\end{bmatrix}.\n$$\n\nIf $⟨{x}_{1},{x}_{2}⟩$ and $⟨{y}_{1},{y}_{2}⟩$ are the solutions to the systems $Ax=b$ and $Ly=b$ respectively, what is the value of ${x}_{1}\\cdot {y}_{1}?$"] [17592186390757 :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\{\\begin{aligned}Ly=b \\\\ Ux=y.\\end{aligned}\n$$\n\nNow, we solve the two systems in turn.\n\n- First, we solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}=b=\\begin{bmatrix}3 \\\\ -3\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\{\\begin{aligned}{y}_{1}=3 \\\\ -2{y}_{1}+{y}_{2}=-3.\\end{aligned}\n$$\n\nThe solution to this system is ${y}_{1}=3$ and ${y}_{2}=3.$ Therefore, \n\n$$\ny=\\begin{bmatrix}3 \\\\ 3\\end{bmatrix}.\n$$\n\n- Next, we solve $Ux=y.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 3 \\\\ 0 & 2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=y=\\begin{bmatrix}3 \\\\ 3\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\{\\begin{aligned}{x}_{1}+3{x}_{2}=3 \\\\ 2{x}_{2}=3.\\end{aligned}\n$$\n\nThe solution to this system is ${x}_{2}=\\frac{3}{2}$ and ${x}_{1}=-\\frac{3}{2}.$ Therefore, \n\n$$\nx=\\begin{bmatrix}-\\frac{3}{2} \\\\ \\frac{3}{2}\\end{bmatrix}.\n$$\n\nFinally, ${x}_{1}\\cdot {y}_{1}=-\\frac{3}{2}\\cdot 3=-\\frac{9}{2}.$"] [17592186390777 :question/problem "Find the solution to the initial value problem\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t) \\\\ {x}_{2}^{′}(t)=-{x}_{1}(t)+3{x}_{2}(t),\\end{aligned}\\,x(0)=\\begin{bmatrix}1 \\\\ -3\\end{bmatrix}.\n$$"] [17592186390777 :question/worked-solution "First, we write down the matrix differential equation ${x}^{′}(t)=Ax(t)$ for the given system:\n\n$$\n\\begin{bmatrix}{x}_{1}^{′}(t) \\\\ {x}_{2}^{′}(t)\\end{bmatrix}=\\begin{bmatrix}1 & 0 \\\\ -1 & 3\\end{bmatrix}\\begin{bmatrix}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{bmatrix}\n$$\n\nWe need to find the eigenvalues and the eigenvectors of the matrix $A.$\n\n- Since $A$ is lower-triangular, the eigenvalues are \n\n$$\n{\\lambda }_{1}=1\\,\\text{and}\\,{\\lambda }_{2}=3.\n$$\n\n- Let's go through the process of finding the eigenvectors.\n\n- For ${\\lambda }_{1}=1,$ we get \n\n$$\nA-{\\lambda }_{1}I=\\begin{bmatrix}0 & 0 \\\\ -1 & 2\\end{bmatrix}∼\\begin{bmatrix}1 & -2 \\\\ 0 & 0\\end{bmatrix}.\n$$\n\nSo, we get an eigenvector \n${v}_{1}=\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}.$\n\n- For ${\\lambda }_{2}=3,$ we get \n\n$$\nA-{\\lambda }_{2}I=\\begin{bmatrix}-2 & 0 \\\\ -1 & 0\\end{bmatrix}∼\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}.\n$$\n\nSo, we get an eigenvector \n${v}_{2}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.$\n\nNow, we write down the general solution to the given linear system of differential equations:\n\n$$\n\\begin{aligned}x(t) & ={c}_{1}{v}_{1}{e}^{{\\lambda }_{1}t}+{c}_{2}{v}_{2}{e}^{{\\lambda }_{2}t} \\\\  & ={c}_{1}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}{e}^{t}+{c}_{2}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}{e}^{3t},\\,{c}_{1},{c}_{2}\\in R\\end{aligned}\n$$\n\nNext, we find the values of ${c}_{1}$ and ${c}_{2}.$ Substituting $t=0$ into the general solution, we get the following:\n\n$$\n\\begin{aligned}x(0) & =\\begin{bmatrix}1 \\\\ -3\\end{bmatrix} \\\\ {c}_{1}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}{e}^{0}+{c}_{2}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}{e}^{0} & =\\begin{bmatrix}1 \\\\ -3\\end{bmatrix} \\\\ \\begin{bmatrix}2{c}_{1} \\\\ {c}_{1}+{c}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ -3\\end{bmatrix}\\end{aligned}\n$$\n\nSo, we have a system of linear equations\n\n$$\n{\\begin{aligned}2{c}_{1}=1 \\\\ {c}_{1}+{c}_{2}=-3.\\end{aligned}\n$$\n\nFrom the first equation, we get ${c}_{1}=\\frac{1}{2}.$ Substituting into the second equation, we obtain ${c}_{2}=-\\frac{7}{2}.$ \n\nFinally, we write down the solution to the initial value problem:\n\n$$\n\\begin{aligned}x(t) & =\\frac{1}{2}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}{e}^{t}-\\frac{7}{2}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}{e}^{3t}\\end{aligned}\n$$"] [17592186390779 :answer/value "x(t)=-\\frac{3}{2}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}{e}^{t}+\\frac{9}{2}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}{e}^{3t}"] [17592186390780 :answer/value "x(t)=-\\frac{7}{2}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}{e}^{t}+\\frac{1}{2}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}{e}^{3t}"] [17592186390781 :answer/value "x(t)=\\frac{3}{2}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}{e}^{3t}-\\frac{9}{2}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}{e}^{t}"] [17592186390782 :answer/value "x(t)=\\frac{1}{2}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}{e}^{t}-\\frac{7}{2}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}{e}^{3t}"] [17592186390783 :answer/value "x(t)=\\frac{7}{2}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}{e}^{3t}-\\frac{1}{2}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}{e}^{t}"] [17592186390784 :question/problem "Find the solution to the initial value problem\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t)-{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-2{x}_{1}(t)+2{x}_{2}(t)\\end{aligned},\\,x(1)=\\begin{bmatrix}-2{e}^{4} \\\\ {e}^{4}\\end{bmatrix}.\n$$\n\n*Hint: The eigenvalues of the system's matrix are ${\\lambda }_{1}=3$ and ${\\lambda }_{2}=0.$*"] [17592186390784 :question/worked-solution "First, we write down the matrix differential equation ${x}^{′}(t)=Ax(t)$ for the given system:\n\n$$\n\\begin{bmatrix}{x}_{1}^{′}(t) \\\\ {x}_{2}^{′}(t)\\end{bmatrix}=\\begin{bmatrix}1 & -1 \\\\ -2 & 2\\end{bmatrix}\\begin{bmatrix}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{bmatrix}\n$$\n\nWe need to find the eigenvalues and the eigenvectors of the matrix $A.$\n\n- We are given that the eigenvalues are\n\n$$\n{\\lambda }_{1}=3\\,\\text{and}\\,{\\lambda }_{2}=0.\n$$\n\n- Let's go through the process of finding the eigenvectors.\n\n- For ${\\lambda }_{1}=3,$ we get \n\n$$\nA-{\\lambda }_{1}I=\\begin{bmatrix}-2 & -1 \\\\ -2 & -1\\end{bmatrix}∼\\begin{bmatrix}1 & 1/2 \\\\ 0 & 0\\end{bmatrix}.\n$$\n\nSo, we get an eigenvector \n${v}_{1}=\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}.$\n\n- For ${\\lambda }_{2}=0,$ we get \n\n$$\nA-{\\lambda }_{2}I=\\begin{bmatrix}1 & -1 \\\\ -2 & 2\\end{bmatrix}∼\\begin{bmatrix}1 & -1 \\\\ 0 & 0\\end{bmatrix}.\n$$\n\nSo, we get an eigenvector \n${v}_{2}=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.$\n\nNow, we write down the general solution to the given linear system of differential equations:\n\n$$\n\\begin{aligned}x(t) & ={c}_{1}{v}_{1}{e}^{{\\lambda }_{1}t}+{c}_{2}{v}_{2}{e}^{{\\lambda }_{2}t} \\\\  & ={c}_{1}\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}{e}^{3t}+{c}_{2}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}{e}^{0} \\\\  & ={c}_{1}\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}{e}^{3t}+{c}_{2}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix},\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nNext, we find the values of ${c}_{1}$ and ${c}_{2}.$ Substituting $t=1$ into the general solution, we get the following:\n\n$$\n\\begin{aligned}x(1) & =\\begin{bmatrix}{e}^{4} \\\\ {e}^{4}\\end{bmatrix} \\\\ {c}_{1}\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}{e}^{3}+{c}_{2}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}-2{e}^{4} \\\\ {e}^{4}\\end{bmatrix} \\\\ \\begin{bmatrix}-{e}^{3}{c}_{1}+{c}_{2} \\\\ 2{e}^{3}{c}_{1}+{c}_{2}\\end{bmatrix} & =\\begin{bmatrix}-2{e}^{4} \\\\ {e}^{4}\\end{bmatrix}\\end{aligned}\n$$\n\nSo, we have a system of linear equations\n\n$$\n{\\begin{aligned}-{e}^{3}{c}_{1}+{c}_{2}=-2{e}^{4} \\\\ 2{e}^{3}{c}_{1}+{c}_{2}={e}^{4}.\\end{aligned}\n$$\n\nSubtracting the first equation from the second one, we get \n\n$$\n\\begin{aligned}3{e}^{3}{c}_{1}=3{e}^{4}\\,⟹\\,{c}_{1}=e.\\end{aligned}\n$$\n\nSubstituting ${c}_{1}=e$ into the second equation, we obtain \n\n$$\n\\begin{aligned}2{e}^{3}(e)+{c}_{2}={e}^{4}\\,⟹\\,{c}_{2}=-{e}^{4}.\\end{aligned}\n$$\n\nFinally, we write down the solution to the initial value problem:\n\n$$\n\\begin{aligned}x(t) & =e\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}{e}^{3t}-{e}^{4}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$"] [17592186390786 :answer/value "x(t)=-2{e}^{2}\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}{e}^{3t}-3e\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}"] [17592186390787 :answer/value "x(t)=2e\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}{e}^{2t}-3{e}^{4}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}"] [17592186390788 :answer/value "x(t)=e\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}{e}^{3t}-{e}^{4}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}"] [17592186390789 :answer/value "x(t)=2e\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}{e}^{3t}+{e}^{3}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}"] [17592186390790 :answer/value "x(t)=2\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}{e}^{-3t}-3\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}"] [17592186390791 :question/problem "What is the minor of ${f}_{13}$ in  $F=\\begin{bmatrix}0 & -1 & 5 & -2 & 2 \\\\ 0 & 7 & 2 & 0 & 3 \\\\ 1 & 2 & 8 & 4 & -1 \\\\ 5 & -5 & 2 & 1 & 0 \\\\ -1 & 4 & 3 & 11 & 2\\end{bmatrix}?$"] [17592186390791 :question/worked-solution "To get the minor of ${f}_{13}$, we remove the $1$st row and $3$rd column:\n\n$$\nF=\\begin{bmatrix}∗ & ∗ & 5 & ∗ & ∗ \\\\ 0 & 7 & ∗ & 0 & 3 \\\\ 1 & 2 & ∗ & 4 & -1 \\\\ 5 & -5 & ∗ & 1 & 0 \\\\ -1 & 4 & ∗ & 11 & 2\\end{bmatrix}\n$$\n\n   \n\nSo, the minor is\n\n$$\n{M}_{13}=\\begin{vmatrix}0 & 7 & 0 & 3 \\\\ 1 & 2 & 4 & -1 \\\\ 5 & -5 & 1 & 0 \\\\ -1 & 4 & 11 & 2\\end{vmatrix}.\n$$"] [17592186390806 :answer/value "\\text{x}(t)=\\begin{bmatrix}3\\operatorname{sin}⁡t+\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t-\\operatorname{cos}⁡t\\end{bmatrix}"] [17592186390807 :answer/value "\\text{x}(t)=\\begin{bmatrix}3\\operatorname{sin}⁡t+\\operatorname{cos}⁡t \\\\ 2\\operatorname{sin}⁡t-\\operatorname{cos}⁡t\\end{bmatrix}"] [17592186390808 :answer/value "\\text{x}(t)=\\begin{bmatrix}\\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ -\\operatorname{cos}⁡t\\end{bmatrix}"] [17592186390809 :answer/value "\\text{x}(t)=\\begin{bmatrix}\\operatorname{sin}⁡t+\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t-\\operatorname{cos}⁡t\\end{bmatrix}"] [17592186390810 :answer/value "\\text{x}(t)=\\begin{bmatrix}\\operatorname{cos}⁡t \\\\ -\\operatorname{cos}⁡t+\\operatorname{sin}⁡t\\end{bmatrix}"] [17592186390939 :question/problem "$$\n{\\begin{aligned}{x}_{1}^{′}(t)=-4{x}_{1}(t)-5{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=5{x}_{1}(t)-3{x}_{2}(t),\\end{aligned}\\,x(0)=\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation, we get the system\n\n$$\n{\\begin{aligned}{{field-1}}={{field-2}} \\\\ {{field-3}}=5{X}_{1}(s)-3{X}_{2}(s)\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively."] [17592186390955 :question/problem "$$\n{\\begin{aligned}{x}_{1}^{′}(t)=3{x}_{1}(t)-4{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=2{x}_{1}(t)+6{x}_{2}(t),\\end{aligned}\\,x(0)=\\begin{bmatrix}-2 \\\\ 5\\end{bmatrix}\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation, we get the system\n\n$$\n{\\begin{aligned}{{field-1}}={{field-2}} \\\\ {{field-3}}=2{X}_{1}(s)+6{X}_{2}(s)\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively."] [17592186390971 :question/worked-solution "Recall that the $xy$-coordinate plane is called the *phase plane* of the system. A particular solution of an initial value problem is called a *trajectory* (or *orbit*).\n\nIn our case, the trajectory (solution) passes through the point $(x,y)=(1,-1)$ in the phase space. Substituting the coordinates of this point into the equations of our system, we obtain the following:\n\n$$\n\\begin{aligned}{x}^{′} & =5x-y \\\\  & =5(1)-(-1) \\\\  & =5+1 \\\\  & =6 \\\\ {y}^{′} & =-x-2y \\\\  & =-1-2(-1) \\\\  & =-1+2 \\\\  & =1\\end{aligned}\n$$\n\nTherefore, the tangent vector to the trajectory is\n\n$$\n\\begin{bmatrix}{x}^{′} \\\\ {y}^{′}\\end{bmatrix}=\\begin{bmatrix}6 \\\\ 1\\end{bmatrix}.\n$$"] [17592186390973 :answer/value "\\begin{bmatrix}6 \\\\ 1\\end{bmatrix}"] [17592186390974 :answer/value "\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}"] [17592186390975 :answer/value "\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}"] [17592186390976 :answer/value "\\begin{bmatrix}5 \\\\ -1\\end{bmatrix}"] [17592186390977 :answer/value "\\begin{bmatrix}6 \\\\ -1\\end{bmatrix}"] [17592186390978 :question/problem "$$\n{x}^{′}(t)=\\begin{bmatrix}2 & 0 \\\\ 0 & 4\\end{bmatrix}x(t),\\,x(0)=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix},\\,x(t)={e}^{2t}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}+{e}^{4t}\\begin{bmatrix}0 \\\\ 3\\end{bmatrix}\n$$\n\nConsider the initial value problem and its solution given above. What is the tangent vector to the solution curve at the point corresponding to $t=\\operatorname{ln}⁡2?$"] [17592186390978 :question/worked-solution "Recall that the $xy$-coordinate plane is called the *phase plane* of the system. A particular solution of an initial value problem is called a *trajectory* (or *orbit*).\n\nFirst, we compute the point that corresponds to $t=\\operatorname{ln}⁡2$ on the given trajectory:\n\n$$\n\\begin{aligned}x(\\operatorname{ln}⁡2) & ={e}^{2(\\operatorname{ln}⁡2)}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}+{e}^{4(\\operatorname{ln}⁡2)}\\begin{bmatrix}0 \\\\ 3\\end{bmatrix} \\\\  & =4\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}+16\\begin{bmatrix}0 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 \\\\ 0\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 48\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 \\\\ 48\\end{bmatrix}\\end{aligned}\n$$\n\nSubstituting this into the equation of our system, we obtain the tangent vector to the trajectory.\n\n$$\n\\begin{aligned}{x}^{′}(\\operatorname{ln}⁡2) & =\\begin{bmatrix}2 & 0 \\\\ 0 & 4\\end{bmatrix}\\begin{bmatrix}4 \\\\ 48\\end{bmatrix} \\\\  & =\\begin{bmatrix}2(4)+0(48) \\\\ 0(4)+4(48)\\end{bmatrix} \\\\  & =\\begin{bmatrix}8 \\\\ 192\\end{bmatrix}\\end{aligned}\n$$"] [17592186390980 :answer/value "\\begin{bmatrix}8 \\\\ 48\\end{bmatrix}"] [17592186390981 :answer/value "\\begin{bmatrix}4 \\\\ 48\\end{bmatrix}"] [17592186390982 :answer/value "\\begin{bmatrix}2 \\\\ 12\\end{bmatrix}"] [17592186390983 :answer/value "\\begin{bmatrix}8 \\\\ 192\\end{bmatrix}"] [17592186390984 :answer/value "\\begin{bmatrix}192 \\\\ 8\\end{bmatrix}"] [17592186390985 :question/problem "$$\n{x}^{′}(t)=\\begin{bmatrix}-1 & 0 \\\\ 0 & 2\\end{bmatrix}x(t),\\,x(0)=\\begin{bmatrix}2 \\\\ -4\\end{bmatrix},\\,x(t)={e}^{-t}\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}+{e}^{2t}\\begin{bmatrix}0 \\\\ -4\\end{bmatrix}\n$$\n\nConsider the initial value problem and its solution given above. What is the tangent vector to the solution curve at the point corresponding to $t=\\operatorname{ln}⁡3?$"] [17592186390985 :question/worked-solution "Recall that the $xy$-coordinate plane is called the *phase plane* of the system. A particular solution of an initial value problem is called a *trajectory* (or *orbit*).\n\nFirst, we compute the point that corresponds to $t=\\operatorname{ln}⁡3$ on the given trajectory:\n\n$$\n\\begin{aligned}x(\\operatorname{ln}⁡3) & ={e}^{-\\operatorname{ln}⁡3}\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}+{e}^{2(\\operatorname{ln}⁡3)}\\begin{bmatrix}0 \\\\ -4\\end{bmatrix} \\\\  & =\\frac{1}{3}\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}+9\\begin{bmatrix}0 \\\\ -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{2}{3} \\\\ 0\\end{bmatrix}+\\begin{bmatrix}0 \\\\ -36\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{2}{3} \\\\ -36\\end{bmatrix}\\end{aligned}\n$$\n\nSubstituting this into the equation of our system, we obtain the tangent vector to the trajectory.\n\n$$\n\\begin{aligned}{x}^{′}(\\operatorname{ln}⁡3) & =\\begin{bmatrix}-1 & 0 \\\\ 0 & 2\\end{bmatrix}\\begin{bmatrix}\\frac{2}{3} \\\\ -36\\end{bmatrix} \\\\  & =\\begin{bmatrix}(-1)(\\frac{2}{3})+0(-36) \\\\ 0\\cdot (\\frac{2}{3})+2(-36)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{2}{3} \\\\ -72\\end{bmatrix}\\end{aligned}\n$$"] [17592186390987 :answer/value "\\begin{bmatrix}\\frac{2}{3} \\\\ 72\\end{bmatrix}"] [17592186390988 :answer/value "\\begin{bmatrix}-\\frac{2}{3} \\\\ -72\\end{bmatrix}"] [17592186390989 :answer/value "\\begin{bmatrix}-2 \\\\ -36\\end{bmatrix}"] [17592186390990 :answer/value "\\begin{bmatrix}\\frac{2}{3} \\\\ -36\\end{bmatrix}"] [17592186390991 :answer/value "\\begin{bmatrix}-72 \\\\ -\\frac{2}{3}\\end{bmatrix}"] [17592186390992 :question/problem "$$\n{x}^{′}(t)=\\begin{bmatrix}-2 & 0 \\\\ 0 & 1\\end{bmatrix}x(t),\\,x(0)=\\begin{bmatrix}3 \\\\ 2\\end{bmatrix},\\,x(t)={e}^{-2t}\\begin{bmatrix}3 \\\\ 0\\end{bmatrix}+{e}^{t}\\begin{bmatrix}0 \\\\ 2\\end{bmatrix}\n$$\n\nConsider the initial value problem and its solution given above. What is the tangent vector to the solution curve at the point corresponding to $t=\\operatorname{ln}⁡3?$"] [17592186390992 :question/worked-solution "Recall that the $xy$-coordinate plane is called the *phase plane* of the system. A particular solution of an initial value problem is called a *trajectory* (or *orbit*).\n\nFirst, we compute the point that corresponds to $t=\\operatorname{ln}⁡3$ on the given trajectory:\n\n$$\n\\begin{aligned}x(\\operatorname{ln}⁡3) & ={e}^{-2(\\operatorname{ln}⁡3)}\\begin{bmatrix}3 \\\\ 0\\end{bmatrix}+{e}^{\\operatorname{ln}⁡3}\\begin{bmatrix}0 \\\\ 2\\end{bmatrix} \\\\  & =\\frac{1}{9}\\begin{bmatrix}3 \\\\ 0\\end{bmatrix}+3\\begin{bmatrix}0 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{1}{3} \\\\ 0\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{1}{3} \\\\ 6\\end{bmatrix}\\end{aligned}\n$$\n\nSubstituting this into the equation of our system, we obtain the tangent vector to the trajectory.\n\n$$\n\\begin{aligned}{x}^{′}(\\operatorname{ln}⁡3) & =\\begin{bmatrix}-2 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}\\frac{1}{3} \\\\ 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2(\\frac{1}{3})+0(6) \\\\ 0(\\frac{1}{3})+1(6)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{2}{3} \\\\ 6\\end{bmatrix}\\end{aligned}\n$$"] [17592186390994 :answer/value "\\begin{bmatrix}-\\frac{2}{3} \\\\ -6\\end{bmatrix}"] [17592186390995 :answer/value "\\begin{bmatrix}-\\frac{2}{3} \\\\ 6\\end{bmatrix}"] [17592186390996 :answer/value "\\begin{bmatrix}6 \\\\ -\\frac{2}{3}\\end{bmatrix}"] [17592186390997 :answer/value "\\begin{bmatrix}\\frac{1}{3} \\\\ 6\\end{bmatrix}"] [17592186390998 :answer/value "\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}"] [17592186391043 :question/worked-solution "Writing our system in matrix form, we have\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}2 & 0 \\\\ 0 & -7\\end{bmatrix}x(t)\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}.$\n\nSince our system is decoupled, its eigenvectors are the following:\n\n- Eigenvalue ${\\lambda }_{1}=2$ with the corresponding eigenvector $\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.$\n\n- Eigenvalue ${\\lambda }_{2}=-7$ with the corresponding eigenvector $\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.$\n\nThe general solution of the system is\n\n$$\nx(t)={c}_{1}{e}^{2t}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}+{c}_{2}{e}^{-7t}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.\n$$\n\nNow, notice that:\n\n- The straight-line solutions of the form\n${c}_{1}{e}^{2t}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}$\nlie on the $x$-axis. Since ${e}^{2t}\\to \\infty $ as $t\\to \\infty ,$ these solutions approach infinity as $t\\to \\infty .$\n\n- The straight-line solutions of the form\n${c}_{2}{e}^{-7t}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}$\nlie on the $y$-axis. Since ${e}^{-7t}\\to 0$ as $t\\to \\infty ,$ these solutions approach the origin as $t\\to \\infty .$\n\nAmong the given options, the only phase portrait satisfying these conditions is the following:\n\n![](images/d6/d604781deed3206caf0a3bf6afa857c00beca9d532a26dedef5c717b4f684225.png)"] [17592186391050 :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}8 & 0 \\\\ 0 & -\\sqrt{5}\\end{bmatrix}x(t),\\,x(0)=\\begin{bmatrix}-3 \\\\ 6\\end{bmatrix}.\n$$"] [17592186391050 :question/worked-solution "We have a decoupled system. Therefore, the general solution is given by\n\n$$\nx(t)={c}_{1}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}{e}^{8t}+{c}_{2}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}{e}^{-\\sqrt{5}t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nNow, we need to find the values of ${c}_{1}$ and ${c}_{2}$ using the initial condition $x(0)=\\begin{bmatrix}-3 \\\\ 6\\end{bmatrix}.$ Substituting $t=0$ into the general solution gives\n\n$$\n\\begin{aligned}x(0) & ={c}_{1}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}+{c}_{2}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}-3 \\\\ 6\\end{bmatrix} & =\\begin{bmatrix}{c}_{1} \\\\ {c}_{2}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}x(t) & =(-3)\\cdot \\begin{bmatrix}1 \\\\ 0\\end{bmatrix}{e}^{8t}+6\\cdot \\begin{bmatrix}0 \\\\ 1\\end{bmatrix}{e}^{-\\sqrt{5}t} \\\\  & =\\begin{bmatrix}-3 \\\\ 0\\end{bmatrix}{e}^{8t}+\\begin{bmatrix}0 \\\\ 6\\end{bmatrix}{e}^{-\\sqrt{5}t}.\\end{aligned}\n$$"] [17592186391052 :answer/value "x(t)=\\begin{bmatrix}-3 \\\\ 0\\end{bmatrix}{e}^{-\\sqrt{5}t}+\\begin{bmatrix}0 \\\\ 6\\end{bmatrix}{e}^{8t}"] [17592186391053 :answer/value "x(t)=\\begin{bmatrix}-3 \\\\ 0\\end{bmatrix}{e}^{8t}"] [17592186391054 :answer/value "x(t)=\\begin{bmatrix}0 \\\\ 6\\end{bmatrix}{e}^{-\\sqrt{5}t}"] [17592186391055 :answer/value "x(t)=\\begin{bmatrix}-3 \\\\ 0\\end{bmatrix}{e}^{8t}+\\begin{bmatrix}0 \\\\ 6\\end{bmatrix}{e}^{-\\sqrt{5}t}"] [17592186391056 :answer/value "x(t)=\\begin{bmatrix}3 \\\\ 0\\end{bmatrix}{e}^{8t}+\\begin{bmatrix}0 \\\\ 6\\end{bmatrix}{e}^{-\\sqrt{5}t}"] [17592186391057 :question/worked-solution "Writing our system in matrix form, we have\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}3 & 0 \\\\ 0 & 7\\end{bmatrix}x(t)\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}.$\n\nSince our system is decoupled, its eigenvectors are the following:\n\n- Eigenvalue ${\\lambda }_{1}=3$ with the corresponding eigenvector $\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.$\n\n- Eigenvalue ${\\lambda }_{2}=7$ with the corresponding eigenvector $\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.$\n\nThe general solution of the system is\n\n$$\nx(t)={c}_{1}{e}^{3t}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}+{c}_{2}{e}^{7t}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.\n$$\n\nNow, notice that:\n\n- The straight-line solutions of the form\n${c}_{1}{e}^{3t}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}$\nlie on the $x$-axis. Since ${e}^{3t}\\to \\infty $ as $t\\to \\infty ,$ these solutions approach infinity as $t\\to \\infty .$\n\n- The straight-line solutions of the form\n${c}_{2}{e}^{7t}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}$\nlie on the $y$-axis. Since ${e}^{7t}\\to \\infty $ as $t\\to \\infty ,$ these solutions approach infinity as $t\\to \\infty .$\n\nAmong the given options, there are two phase portraits satisfying these conditions:\n\n![](images/96/96801605aa5d777eb18c13ded1f7b7e59ae74968b210da3b7a26f339a1c9f673.png)\n\nLet's consider the solutions $x(t)={c}_{1}{e}^{3t}$ and $y(t)={c}_{2}{e}^{7t}$ provided that ${c}_{1},{c}_{2}\\ne 0.$ Then,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}=\\frac{({c}_{2}{e}^{7t})^{′}}{({c}_{1}{e}^{3t})^{′}}=\\frac{7{c}_{2}{e}^{7t}}{3{c}_{1}{e}^{3t}}=\\frac{7{c}_{2}}{3{c}_{1}}{e}^{4t}.\\end{aligned}\n$$\n\nSo, $\\frac{\\text{d}y}{\\text{d}x}\\to \\pm \\infty $ as $t\\to \\infty ,$ meaning that the tangents to the solution become more and more vertical as we move away from the origin. This corresponds to the following phase portrait:\n\n![](images/20/20ef7519d0ca517d0d7d06d2998f7bd6c77f04145243f721e197fbef5c087791.png)"] [17592186391064 :question/problem "$$\n{\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t)+4{t}^{2}+2 \\\\ {x}_{2}^{′}(t)=-2{x}_{1}(t)+2{x}_{2}(t)-4,\\end{aligned}\\,x(0)=\\begin{bmatrix}0 \\\\ 3\\end{bmatrix}\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation, we get the system\n\n$$\n{\\begin{aligned}s{X}_{1}(s)={{field-1}}+\\frac{2}{s} \\\\ {{field-2}}=-2{X}_{1}(s)+2{X}_{2}(s)-{{field-3}}\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively."] [17592186391080 :question/problem "$$\n{\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t)+6 \\\\ {x}_{2}^{′}(t)=-3{x}_{1}(t)+2{x}_{2}(t)+1,\\end{aligned}\\,x(0)=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation, we get the system\n\n$$\n{\\begin{aligned}s{X}_{1}(s)={{field-1}} \\\\ {{field-2}}=-3{X}_{1}(s)+2{X}_{2}(s)+{{field-3}}\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively."] [17592186391144 :question/worked-solution "Writing our system in matrix form, we have\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}9 & 0 \\\\ 0 & 4\\end{bmatrix}x(t)\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}.$\n\nSince our system is decoupled, its eigenvectors are the following:\n\n- Eigenvalue ${\\lambda }_{1}=9$ with the corresponding eigenvector $\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.$\n\n- Eigenvalue ${\\lambda }_{2}=4$ with the corresponding eigenvector $\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.$\n\nThe general solution of the system is\n\n$$\nx(t)={c}_{1}{e}^{9t}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}+{c}_{2}{e}^{4t}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.\n$$\n\nNow, notice that:\n\n- The straight-line solutions of the form\n${c}_{1}{e}^{9t}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}$\nlie on the $x$-axis. Since ${e}^{9t}\\to \\infty $ as $t\\to \\infty ,$ these solutions approach infinity as $t\\to \\infty .$\n\n- The straight-line solutions of the form\n${c}_{2}{e}^{4t}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}$\nlie on the $y$-axis. Since ${e}^{4t}\\to \\infty $ as $t\\to \\infty ,$ these solutions approach infinity as $t\\to \\infty .$\n\nAmong the given options, there are two phase portraits satisfying these conditions:\n\n![](images/99/99d6e9894c7117c5684e17702540d0eb469b6e824381cf2263c843f8f55ee8d8.png)\n\nLet's consider the solutions $x(t)={c}_{1}{e}^{9t}$ and $y(t)={c}_{2}{e}^{4t}$ provided that ${c}_{1},{c}_{2}\\ne 0.$ Then,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}=\\frac{({c}_{2}{e}^{4t})^{′}}{({c}_{1}{e}^{9t})^{′}}=\\frac{4{c}_{2}{e}^{4t}}{9{c}_{1}{e}^{9t}}=\\frac{4{c}_{2}}{9{c}_{1}}{e}^{-5t}.\\end{aligned}\n$$\n\nSo, $\\frac{\\text{d}y}{\\text{d}x}\\to 0$ as $t\\to \\infty ,$ meaning that the tangents to the solution become more and more horizontal as we move away from the origin. This corresponds to the following phase portrait:\n\n![](images/c4/c497d1f9dd6cb5bc473bd46ec56c465228408447fb2436b80f16a23b282654b2.png)"] [17592186391151 :question/worked-solution "Writing our system in matrix form, we have\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}-3 & 0 \\\\ 0 & -4\\end{bmatrix}x(t)\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}.$\n\nSince our system is decoupled, its eigenvectors are the following:\n\n- Eigenvalue ${\\lambda }_{1}=-3$ with the corresponding eigenvector $\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.$\n\n- Eigenvalue ${\\lambda }_{2}=-4$ with the corresponding eigenvector $\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.$\n\nThe general solution of the system is\n\n$$\nx(t)={c}_{1}{e}^{-3t}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}+{c}_{2}{e}^{-4t}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.\n$$\n\nNow, notice that:\n\n- The straight-line solutions of the form\n${c}_{1}{e}^{-3t}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}$\nlie on the $x$-axis. Since ${e}^{-3t}\\to 0$ as $t\\to \\infty ,$ these solutions approach the origin as $t\\to \\infty .$\n\n- The straight-line solutions of the form\n${c}_{2}{e}^{-4t}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}$\nlie on the $y$-axis. Since ${e}^{-4t}\\to 0$ as $t\\to \\infty ,$ these solutions also approach the origin as $t\\to \\infty .$\n\nAmong the given options, there are two phase portraits satisfying these conditions:\n\n![](images/3f/3fdbeba46a0f4640e909b0ba489c1aec1fa87a6aa7740f19d08f274b7351d11b.png)\n\nLet's consider the solutions $x(t)={c}_{1}{e}^{-3t}$ and $y(t)={c}_{2}{e}^{-4t}$ provided that ${c}_{1},{c}_{2}\\ne 0.$ Then,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}=\\frac{({c}_{2}{e}^{-4t})^{′}}{({c}_{1}{e}^{-3t})^{′}}=\\frac{-4{c}_{2}{e}^{-4t}}{-3{c}_{1}{e}^{-3t}}=\\frac{4{c}_{2}}{3{c}_{1}}{e}^{-t}.\\end{aligned}\n$$\n\nSo, $\\frac{\\text{d}y}{\\text{d}x}\\to 0$ as $t\\to \\infty ,$ meaning that the tangents to the solution become more and more horizontal as the trajectories approach the origin. This corresponds to the following phase portrait:\n\n![](images/41/4193300af5a8950ce70e2c469812424235665faac279dac0c89289a0307ab46a.png)"] [17592186391158 :question/worked-solution "Writing our system in matrix form, we have\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}-2 & 0 \\\\ 0 & -4\\end{bmatrix}x(t)\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}.$\n\nRecall that a homogeneous system of linear differential equations has a single equilibrium (fixed point) at the origin.\n\nSince our system is decoupled, its eigenvectors are the following:\n\n- Eigenvalue ${\\lambda }_{1}=-2$ with the eigenvector $\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.$ The corresponding straight-line solutions of the form\n${c}_{1}{e}^{-2t}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}$\nlie on the $x$-axis and approach the origin as $t\\to \\infty .$ So, the $x$-axis is the $\\text{stable}$ line.\n\n- Eigenvalue ${\\lambda }_{2}=-4$ with the eigenvector $\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.$ The corresponding straight-line solutions of the form\n${c}_{2}{e}^{-4t}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}$\nlie on the $y$-axis and also approach the origin as $t\\to \\infty .$ So, the $y$-axis is the $\\text{stable}$ line.\n\nTherefore, the equilibrium point (origin) is $\\text{a stable node (sink)}.$ \n\n**Note:** The phase portrait of the system looks as follows:\n\n![](images/06/062b58a307f6d40c7be59d527cc01d7d301bd3f0115a0074ba0f3dca54412425.png)"] [17592186391169 :question/worked-solution "Writing our system in matrix form, we have\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}-4 & 0 \\\\ 0 & -5\\end{bmatrix}x(t)\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}.$\n\nRecall that a homogeneous system of linear differential equations has a single equilibrium (fixed point) at the origin.\n\nSince our system is decoupled, its eigenvectors are the following:\n\n- Eigenvalue ${\\lambda }_{1}=-4$ with the eigenvector $\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.$ The corresponding straight-line solutions of the form\n${c}_{1}{e}^{-4t}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}$\nlie on the $x$-axis and approach the origin as $t\\to \\infty .$ So, the $x$-axis is the $\\text{stable}$ line.\n\n- Eigenvalue ${\\lambda }_{2}=-5$ with the eigenvector $\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.$ The corresponding straight-line solutions of the form\n${c}_{2}{e}^{-5t}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}$\nlie on the $y$-axis and also approach the origin as $t\\to \\infty .$ So, the $y$-axis is the $\\text{stable}$ line.\n\nTherefore, the equilibrium point (origin) is $\\text{a stable node (sink)}.$ \n\n**Note:** The phase portrait of the system looks as follows:\n\n![](images/b4/b406c864e820819c5ae6f548c7a025a1e1d8197fb785ea5689080034e04210cb.png)"] [17592186391187 :question/worked-solution "Writing our system in matrix form, we have\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}3 & 0 \\\\ 0 & 3\\end{bmatrix}x(t)\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}.$\n\nSince our system is decoupled, its eigenvalues are ${\\lambda }_{1}={\\lambda }_{2}=3$ with the corresponding eigenvectors $\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}$ and $\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.$\n\nThe general solution of the system is\n\n$$\nx(t)={c}_{1}{e}^{3t}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}+{c}_{2}{e}^{3t}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}={e}^{3t}\\begin{bmatrix}{c}_{1} \\\\ {c}_{2}\\end{bmatrix},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nNotice that for each vector $\\begin{bmatrix}{c}_{1} \\\\ {c}_{2}\\end{bmatrix},$ we get the straight-line solutions of the form\n${e}^{3t}\\begin{bmatrix}{c}_{1} \\\\ {c}_{2}\\end{bmatrix}$\nthat represent the line passing through the origin and parallel to the vector $\\begin{bmatrix}{c}_{1} \\\\ {c}_{2}\\end{bmatrix}.$\n\nSince ${e}^{3t}\\to \\infty $ as $t\\to \\infty ,$ these solutions move away from the origin as $t\\to \\infty .$ \n\nAmong the given options, the only phase portrait satisfying these conditions is the following:\n\n![](images/c4/c46568f3173dfeaab6e33e83269262e8692f13e245a42983ba1a9d4302ec5357.png)"] [17592186391194 :question/worked-solution "Writing our system in matrix form, we have\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}-4 & 0 \\\\ 0 & -4\\end{bmatrix}x(t)\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}.$\n\nSince our system is decoupled, its eigenvalues are ${\\lambda }_{1}={\\lambda }_{2}=-4$ with the corresponding eigenvectors $\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}$ and $\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.$\n\nThe general solution of the system is\n\n$$\nx(t)={c}_{1}{e}^{-4t}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}+{c}_{2}{e}^{-4t}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}={e}^{-4t}\\begin{bmatrix}{c}_{1} \\\\ {c}_{2}\\end{bmatrix},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nNotice that for each vector $\\begin{bmatrix}{c}_{1} \\\\ {c}_{2}\\end{bmatrix},$ we get the straight-line solutions of the form\n${e}^{-4t}\\begin{bmatrix}{c}_{1} \\\\ {c}_{2}\\end{bmatrix}$\nthat represent the line passing through the origin and parallel to the vector $\\begin{bmatrix}{c}_{1} \\\\ {c}_{2}\\end{bmatrix}.$\n\nSince ${e}^{-4t}\\to 0$ as $t\\to \\infty ,$ these solutions approach the origin as $t\\to \\infty .$\n\nAmong the given options, the only phase portrait satisfying these conditions is the following:\n\n![](images/a2/a27e83035006f198d454498aafe91624e0576ab43993bde970faf426a9e4cef2.png)"] [17592186391219 :question/worked-solution "The matrix of our system is\n\n$$\nA=\\begin{bmatrix}-1 & -1 \\\\ 1 & -3\\end{bmatrix}.\n$$\n\nNotice that:\n\n- Since the only (repeated) eigenvalue of $A$ is negative, we have a $\\text{stable}$ node.\n\n- Since $A$ is not diagonal and has a repeated eigenvalue, there is only one linearly independent eigenvector. So, we have a $\\text{degenerate}$ node.\n\n**Note:** The phase portrait of the system looks as follows:\n\n![](images/c1/c1d7f49dfe79bcd36394e4b0bb49180167ac7a8791555f0f6974f5fe49fa249f.png)"] [17592186391226 :question/worked-solution "The general solution of the system is\n\n$$\n\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}={c}_{1}{e}^{2t}\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}+{c}_{2}{e}^{4t}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\n- The line that passes through the origin and is parallel to ${v}_{1}=\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}$ has the equation \n\n$$\ny=-\\frac{1}{2}x.\n$$\n\nThe straight-line solutions of the form\n${c}_{1}{e}^{2t}\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}$\nlie on that line and approach infinity as $t\\to \\infty .$ So, $y=-\\frac{1}{2}x$ is $\\text{an unstable}$ line.\n\n- The line that passes through the origin and is parallel to ${v}_{2}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}$ has the equation \n\n$$\nx=0.\n$$\n\nThe straight-line solutions of the form\n${c}_{2}{e}^{4t}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}$\nlie on that line and approach infinity as $t\\to \\infty .$ So, $x=0$ is $\\text{an unstable}$ line.\n\nTherefore, the equilibrium point (origin) is $\\text{an unstable node (source)}.$ \n\n**Note:** The phase portrait of the system looks as follows:\n\n![](images/0d/0d9e032bfffa68f487347d6c169999e313247e89ef7de3fae28edb216dcf718f.png)"] [17592186391257 :question/worked-solution "The matrix of our system is\n\n$$\nA=\\begin{bmatrix}-1 & 0 \\\\ 0 & -1\\end{bmatrix}.\n$$\n\nNotice that:\n\n- Since the only (repeated) eigenvalue of $A$ is $\\lambda =-1$ and it's negative, we have a $\\text{stable}$ node.\n\n- Since $A$ is diagonal and has a repeated eigenvalue, there are infinitely many linearly independent eigenvectors. So, we have a $\\text{star}$ node.\n\n**Note:** The phase portrait of the system looks as follows:\n\n![](images/92/92efcce675a436ad349ca6139cb12cda88fbdd5bdeaf2a5f1e755e7ba1f6d037.png)"] [17592186391264 :question/worked-solution "Let's justify each of the selected steps.\n\n- We first consider line $\\text{L2}.$ Since $Φ(t)$ is a fundamental matrix, its columns ${x}_{1}(t)$ and ${x}_{2}(t)$ are linearly independent solutions of the homogeneous system ${x}^{′}(t)=Ax(t).$ This means that each column satisfies the differential equation. In particular, \n\n$$\n{x}_{1}^{′}(t)=A{x}_{1}(t).\n$$\n\nTherefore, $\\text{L2}$ follows from the fact that ${x}_{1}\\text{ is a solution of the system}.$\n\n- Next, we consider lines $\\text{L4}$ and $\\text{L5}.$ By definition, the derivative of $Φ(t)$ is obtained by differentiating each column,\n\n$$\n{Φ}^{′}(t)=\\begin{bmatrix}\\,| & | \\\\ {x}_{1}^{′}(t) & {x}_{2}^{′}(t) \\\\ \\,| & |\\end{bmatrix}.\n$$\n\nUsing ${x}_{1}^{′}(t)=A{x}_{1}(t)$ from $\\text{L2}$ and ${x}_{2}^{′}(t)=A{x}_{2}(t)$ from $\\text{L3},$ we substitute each derivative into the matrix to get\n\n$$\n{Φ}^{′}(t)=\\begin{bmatrix}\\,| & | \\\\ A{x}_{1}(t) & A{x}_{2}(t) \\\\ \\,| & |\\end{bmatrix}.\n$$\n\nThus, $\\text{L5}$ follows from $\\text{L4}$ by substitution from $\\text{L2}\\text{ and }\\text{L3}.$\n\n- Finally, we consider lines $\\text{L5}$ and $\\text{L6}.$ We now factor the matrix $A$ on the left:\n\n$$\n{Φ}^{′}(t)=\\begin{bmatrix}\\,| & | \\\\ A{x}_{1}(t) & A{x}_{2}(t) \\\\ \\,| & |\\end{bmatrix}=A\\begin{bmatrix}\\,| & | \\\\ {x}_{1}(t) & {x}_{2}(t) \\\\ \\,| & |\\end{bmatrix}=AΦ(t)\n$$\n\nTherefore, $\\text{L6}$ follows from $\\text{L5}$ by $\\text{factoring out }A\\text{ on the left}.$"] [17592186391286 :question/worked-solution "The general solution of the system is\n\n$$\nx(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}={c}_{1}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}+{c}_{2}{e}^{4t}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nLet's now sketch the phase portrait.\n\n- First, notice that ${x}_{E}(t)={c}_{1}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}$ are the equilibrium solutions of the system since ${x}_{E}^{′}(t)=0.$ These solutions form the line with the equation $y=-x$ in the phase space, as shown below.\n\n![](images/bd/bdfe2e3f89db20665d2c7c1e49c7ddae42387fc1e5bdde8849a9ed1de7e33687.png)\n\n- Now, the line that passes through the origin and is parallel to ${v}_{2}=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}$ has the equation \n$y=3x$\nand the straight-line solutions of the form\n${c}_{2}{e}^{4t}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}$\nlie on that line. Since ${e}^{4t}\\to \\infty $ as $t\\to \\infty ,$ these solutions approach infinity as $t\\to \\infty .$\n\n![](images/99/99629c2f73e3a10db2ef139848c93c6a2489d995d3d992b7dfb0332989b4f48f.png)\n\nAll other non-equilibrium solutions are parallel to the vector ${v}_{2}.$ So, the phase portrait of our system looks as follows:\n\n![](images/cb/cb491075c2fecf4aa28f4b167e91ac5a0b7475cf57c1b43eb94e8e1427a28922.png)"] [17592186391293 :question/worked-solution "The general solution of the system is\n\n$$\nx(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}={c}_{1}\\begin{bmatrix}-1 \\\\ 3\\end{bmatrix}+{c}_{2}{e}^{5t}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nLet's now sketch the phase portrait.\n\n- First, notice that ${x}_{E}(t)={c}_{1}\\begin{bmatrix}-1 \\\\ 3\\end{bmatrix}$ are the equilibrium solutions of the system since ${x}_{E}^{′}(t)=0.$ These solutions form the line with the equation $y=-3x$ in the phase space, as shown below.\n\n![](images/b3/b39e589968babd6f1417b37dc0f53796ab363ee80ec5fc3860e9793b88b1e98c.png)\n\n- Now, the line that passes through the origin and is parallel to ${v}_{2}=\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}$ has the equation \n$y=2x$\nand the straight-line solutions of the form\n${c}_{2}{e}^{5t}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}$\nlie on that line. Since ${e}^{5t}\\to \\infty $ as $t\\to \\infty ,$ these solutions approach infinity as $t\\to \\infty .$\n\n![](images/12/12a1f8f11c3f1063804220884e6616ae4c9e9aee956adc575de1f0e88e0dd038.png)\n\nAll other non-equilibrium solutions are parallel to the vector ${v}_{2}.$ So, the phase portrait of our system looks as follows: \n\n![](images/1b/1b3ed684a9981397191fda952481ff10e114f5f092e83b3defa618c9c8d1cb46.png)"] [17592186391300 :question/problem "$$\n{x}_{1}(t)=\\begin{bmatrix}2\\operatorname{cos}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t)\\end{bmatrix},\\,{x}_{2}(t)=\\begin{bmatrix}\\operatorname{sin}⁡(2t) \\\\ 2\\operatorname{cos}⁡(2t)\\end{bmatrix},\\,t\\in R\n$$\n\nConsider the vector-valued functions ${x}_{1}(t)$ and ${x}_{2}(t)$ above. Given that ${x}_{1}$ and ${x}_{2}$ are solutions of the same system of linear ODEs, select the correct options in the reasoning below.$\\,$ The Wronskian is $W({x}_{1},{x}_{2})=$ \n{{field-1}},\n\n$\\,$ which is\n{{field-2}}.  \n\n$\\,$ Therefore, the set ${{x}_{1}(t),{x}_{2}(t)}$ is linearly \n{{field-3}} \non $R.$"] [17592186391300 :question/worked-solution "The Wronskian $W({x}_{1},{x}_{2})$ of two vector-valued functions \n\n$$\n{x}_{1}(t)=\\begin{bmatrix}{x}_{11}(t) \\\\ {x}_{21}(t)\\end{bmatrix},\\,{x}_{2}(t)=\\begin{bmatrix}{x}_{12}(t) \\\\ {x}_{22}(t)\\end{bmatrix}\n$$\n\nis defined as\n\n$$\nW({x}_{1},{x}_{2})=det({x}_{1},{x}_{2})=\\begin{vmatrix}{x}_{11}(t) & {x}_{12}(t) \\\\ {x}_{21}(t) & {x}_{22}(t)\\end{vmatrix}.\n$$\n\nNote the following:\n\n- If the Wronskian is not identically zero, then ${x}_{1}$ and ${x}_{2}$ are linearly independent.\n\n- If the Wronskian is identically zero, and it's known that ${x}_{1}$ and ${x}_{2}$ are solutions to the same system of linear ODEs, then ${x}_{1}$ and ${x}_{2}$ are linearly dependent.\n\nIn our case, our Wronskian is given by\n\n$$\n\\begin{aligned}W({x}_{1},{x}_{2}) & =\\begin{vmatrix}2\\operatorname{cos}⁡(2t) & \\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t) & 2\\operatorname{cos}⁡(2t)\\end{vmatrix} \\\\  & =(2\\operatorname{cos}⁡(2t))\\cdot (2\\operatorname{cos}⁡(2t))-\\operatorname{sin}⁡(2t)\\cdot (-\\operatorname{sin}⁡(2t)) \\\\  & =4{cos}^{2}⁡(2t)+{sin}^{2}⁡(2t) \\\\  & =4{cos}^{2}⁡(2t)+{sin}^{2}⁡(2t)\\end{aligned}\n$$\n\nwhich is $\\text{nonzero for at least one }t\\in R.$\n\nTherefore, the set ${{x}_{1}(t),{x}_{2}(t)}$ is linearly $\\text{independent}$ on $R.$"] [17592186391312 :question/problem "$$\n{x}_{1}(t)=\\begin{bmatrix}3\\operatorname{cos}⁡(2t) \\\\ -6\\operatorname{sin}⁡(2t)\\end{bmatrix},\\,{x}_{2}(t)=\\begin{bmatrix}-\\operatorname{cos}⁡(2t) \\\\ 2\\operatorname{sin}⁡(2t)\\end{bmatrix},\\,t\\in R\n$$\n\nConsider the vector-valued functions ${x}_{1}(t)$ and ${x}_{2}(t)$ above. Given that ${x}_{1}$ and ${x}_{2}$ are solutions of the same system of linear ODEs, select the correct options in the reasoning below.$\\,$ The Wronskian is $W({x}_{1},{x}_{2})=$ \n{{field-1}},\n\n$\\,$ which is\n{{field-2}}.  \n\n$\\,$ Therefore, the set ${{x}_{1}(t),{x}_{2}(t)}$ is linearly \n{{field-3}} \non $R.$"] [17592186391312 :question/worked-solution "The Wronskian $W({x}_{1},{x}_{2})$ of two vector-valued functions \n\n$$\n{x}_{1}(t)=\\begin{bmatrix}{x}_{11}(t) \\\\ {x}_{21}(t)\\end{bmatrix},\\,{x}_{2}(t)=\\begin{bmatrix}{x}_{12}(t) \\\\ {x}_{22}(t)\\end{bmatrix}\n$$\n\nis defined as\n\n$$\nW({x}_{1},{x}_{2})=det({x}_{1},{x}_{2})=\\begin{vmatrix}{x}_{11}(t) & {x}_{12}(t) \\\\ {x}_{21}(t) & {x}_{22}(t)\\end{vmatrix}.\n$$\n\nNote the following:\n\n- If the Wronskian is not identically zero, then ${x}_{1}$ and ${x}_{2}$ are linearly independent.\n\n- If the Wronskian is identically zero, and it's known that ${x}_{1}$ and ${x}_{2}$ are solutions to the same system of linear ODEs, then ${x}_{1}$ and ${x}_{2}$ are linearly dependent.\n\nIn our case, our Wronskian is given by\n\n$$\n\\begin{aligned}W({x}_{1},{x}_{2}) & =\\begin{vmatrix}3\\operatorname{cos}⁡(2t) & -\\operatorname{cos}⁡(2t) \\\\ -6\\operatorname{sin}⁡(2t) & 2\\operatorname{sin}⁡(2t)\\end{vmatrix} \\\\  & =(3\\operatorname{cos}⁡(2t))\\cdot (2\\operatorname{sin}⁡(2t))-(-\\operatorname{cos}⁡(2t))\\cdot (-6\\operatorname{sin}⁡(2t)) \\\\  & =6\\operatorname{cos}⁡(2t)\\operatorname{sin}⁡(2t)-6\\operatorname{cos}⁡(2t)\\operatorname{sin}⁡(2t) \\\\  & =0\\end{aligned}\n$$\n\nwhich is $\\text{zero for all }t\\in R.$\n\nTherefore, the set ${{x}_{1}(t),{x}_{2}(t)}$ is linearly $\\text{dependent}$ on $R.$"] [17592186391324 :question/problem "$$\n{x}_{1}(t)=\\begin{bmatrix}4\\operatorname{cos}⁡(3t) \\\\ 5\\operatorname{sin}⁡(3t)\\end{bmatrix},\\,{x}_{2}(t)=\\begin{bmatrix}-8\\operatorname{cos}⁡(3t) \\\\ -10\\operatorname{sin}⁡(3t)\\end{bmatrix},\\,t\\in R\n$$\n\nConsider the vector-valued functions ${x}_{1}(t)$ and ${x}_{2}(t)$ above. Given that ${x}_{1}$ and ${x}_{2}$ are solutions of the same system of linear ODEs, select the correct options in the reasoning below.$\\,$ The Wronskian is $W({x}_{1},{x}_{2})=$ \n{{field-1}},\n\n$\\,$ which is\n{{field-2}}.  \n\n$\\,$ Therefore, the set ${{x}_{1}(t),{x}_{2}(t)}$ is linearly \n{{field-3}} \non $R.$"] [17592186391324 :question/worked-solution "The Wronskian $W({x}_{1},{x}_{2})$ of two vector-valued functions \n\n$$\n{x}_{1}(t)=\\begin{bmatrix}{x}_{11}(t) \\\\ {x}_{21}(t)\\end{bmatrix},\\,{x}_{2}(t)=\\begin{bmatrix}{x}_{12}(t) \\\\ {x}_{22}(t)\\end{bmatrix}\n$$\n\nis defined as\n\n$$\nW({x}_{1},{x}_{2})=det({x}_{1},{x}_{2})=\\begin{vmatrix}{x}_{11}(t) & {x}_{12}(t) \\\\ {x}_{21}(t) & {x}_{22}(t)\\end{vmatrix}.\n$$\n\nNote the following:\n\n- If the Wronskian is not identically zero, then ${x}_{1}$ and ${x}_{2}$ are linearly independent.\n\n- If the Wronskian is identically zero, and it's known that ${x}_{1}$ and ${x}_{2}$ are solutions to the same system of linear ODEs, then ${x}_{1}$ and ${x}_{2}$ are linearly dependent.\n\nIn our case, our Wronskian is given by\n\n$$\n\\begin{aligned}W({x}_{1},{x}_{2}) & =\\begin{vmatrix}4\\operatorname{cos}⁡(3t) & -8\\operatorname{cos}⁡(3t) \\\\ 5\\operatorname{sin}⁡(3t) & -10\\operatorname{sin}⁡(3t)\\end{vmatrix} \\\\  & =(4\\operatorname{cos}⁡(3t))\\cdot (-10\\operatorname{sin}⁡(3t))-(-8\\operatorname{cos}⁡(3t))\\cdot (5\\operatorname{sin}⁡(3t)) \\\\  & =-40\\operatorname{cos}⁡(3t)\\operatorname{sin}⁡(3t)+40\\operatorname{cos}⁡(3t)\\operatorname{sin}⁡(3t) \\\\  & =0\\end{aligned}\n$$\n\nwhich is $\\text{zero for all }t\\in R.$\n\nTherefore, the set ${{x}_{1}(t),{x}_{2}(t)}$ is linearly $\\text{dependent}$ on $R.$"] [17592186391336 :question/problem "$$\n{x}_{1}(t)=\\begin{bmatrix}\\operatorname{cos}⁡(2t) \\\\ 3\\operatorname{sin}⁡(2t)\\end{bmatrix},\\,{x}_{2}(t)=\\begin{bmatrix}5\\operatorname{cos}⁡(2t) \\\\ 15\\operatorname{sin}⁡(2t)\\end{bmatrix},\\,t\\in R\n$$\n\nConsider the vector-valued functions ${x}_{1}(t)$ and ${x}_{2}(t)$ above. Given that ${x}_{1}$ and ${x}_{2}$ are solutions of the same system of linear ODEs, select the correct options in the reasoning below.$\\,$ The Wronskian is $W({x}_{1},{x}_{2})=$ \n{{field-1}},\nwhich is\n{{field-2}}.  \n\n$\\,$ Therefore, the set ${{x}_{1}(t),{x}_{2}(t)}$ is linearly \n{{field-3}} \non $R.$"] [17592186391336 :question/worked-solution "The Wronskian $W({x}_{1},{x}_{2})$ of two vector-valued functions \n\n$$\n{x}_{1}(t)=\\begin{bmatrix}{x}_{11}(t) \\\\ {x}_{21}(t)\\end{bmatrix},\\,{x}_{2}(t)=\\begin{bmatrix}{x}_{12}(t) \\\\ {x}_{22}(t)\\end{bmatrix}\n$$\n\nis defined as\n\n$$\nW({x}_{1},{x}_{2})=det({x}_{1},{x}_{2})=\\begin{vmatrix}{x}_{11}(t) & {x}_{12}(t) \\\\ {x}_{21}(t) & {x}_{22}(t)\\end{vmatrix}.\n$$\n\nNote the following:\n\n- If the Wronskian is not identically zero, then ${x}_{1}$ and ${x}_{2}$ are linearly independent.\n\n- If the Wronskian is identically zero, and it's known that ${x}_{1}$ and ${x}_{2}$ are solutions to the same system of linear ODEs, then ${x}_{1}$ and ${x}_{2}$ are linearly dependent.\n\nIn our case, our Wronskian is given by\n\n$$\n\\begin{aligned}W({x}_{1},{x}_{2}) & =\\begin{vmatrix}\\operatorname{cos}⁡(2t) & 5\\operatorname{cos}⁡(2t) \\\\ 3\\operatorname{sin}⁡(2t) & 15\\operatorname{sin}⁡(2t)\\end{vmatrix} \\\\  & =(\\operatorname{cos}⁡(2t))\\cdot (15\\operatorname{sin}⁡(2t))-(5\\operatorname{cos}⁡(2t))\\cdot (3\\operatorname{sin}⁡(2t)) \\\\  & =15\\operatorname{cos}⁡(2t)\\operatorname{sin}⁡(2t)-15\\operatorname{cos}⁡(2t)\\operatorname{sin}⁡(2t) \\\\  & =0\\end{aligned}\n$$\n\nwhich is $\\text{zero for all }t\\in R.$\n\nTherefore, the set ${{x}_{1}(t),{x}_{2}(t)}$ is linearly $\\text{dependent}$ on $R.$"] [17592186391373 :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}-3 & 10 \\\\ -1 & 3\\end{bmatrix}x(t),\\,x(0)=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}.\n$$\n\n*Hint: The matrix has the eigenvalue ${\\lambda }_{1}=\\text{i}$ with the corresponding eigenvector ${v}_{1}=\\begin{bmatrix}3-\\text{i} \\\\ 1\\end{bmatrix}.$*"] [17592186391373 :question/worked-solution "We need to find the eigenvalues and associated eigenvectors of the matrix $A=\\begin{bmatrix}-3 & 10 \\\\ -1 & 3\\end{bmatrix}.$\n\nWe are given the eigenvalue ${\\lambda }_{1}=\\text{i}$ and the corresponding eigenvector ${v}_{1}=\\begin{bmatrix}3-\\text{i} \\\\ 1\\end{bmatrix}.$\n\n**Note:** The eigenvector corresponding to the second eigenvalue ${\\lambda }_{2}={\\overset{―}{\\lambda }}_{1}$ is \n${v}_{2}={\\overset{―}{v}}_{1}.$ But we do not require this eigenvector for solving our system.\n\nThe solution that we obtain for the eigenvalue ${\\lambda }_{1}=\\text{i}$ and its associated eigenvector is\n\n$$\n{x}_{1}(t)=\\begin{bmatrix}3-\\text{i} \\\\ 1\\end{bmatrix}{e}^{\\text{i}t}.\n$$\n\nWe now express this as a real function. Using Euler's formula, we obtain\n\n$$\n\\begin{aligned}{x}_{1}(t) & =\\begin{bmatrix}3-\\text{i} \\\\ 1\\end{bmatrix}{e}^{\\text{i}t} \\\\  & =\\begin{bmatrix}3-\\text{i} \\\\ 1\\end{bmatrix}(\\operatorname{cos}⁡t+\\text{i}\\operatorname{sin}⁡t) \\\\  & =\\begin{bmatrix}3\\operatorname{cos}⁡t+3\\text{i}\\operatorname{sin}⁡t-\\text{i}\\operatorname{cos}⁡t+\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t+\\text{i}\\operatorname{sin}⁡t\\end{bmatrix} \\\\  & =\\begin{bmatrix}3\\operatorname{cos}⁡t+\\operatorname{sin}⁡t+\\text{i}(3\\operatorname{sin}⁡t-\\operatorname{cos}⁡t) \\\\ \\operatorname{cos}⁡t+\\text{i}\\operatorname{sin}⁡t\\end{bmatrix} \\\\  & =\\begin{bmatrix}3\\operatorname{cos}⁡t+\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{bmatrix}+\\text{i}\\begin{bmatrix}3\\operatorname{sin}⁡t-\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{bmatrix} \\\\  & ={\\text{w}}_{1}(t)+\\text{i}{\\text{w}}_{2}(t).\\end{aligned}\n$$\n\nThe vectors ${w}_{1}$ and ${w}_{2}$ are linearly independent. Therefore, the general solution of the system is\n\n$$\n\\begin{aligned}\\text{x}(t) & ={c}_{1}{\\text{w}}_{1}(t)+{c}_{2}{\\text{w}}_{2}(t) \\\\  & ={c}_{1}\\begin{bmatrix}3\\operatorname{cos}⁡t+\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{bmatrix}+{c}_{2}\\begin{bmatrix}3\\operatorname{sin}⁡t-\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we need to find the values of ${c}_{1}$ and ${c}_{2}$ using the initial condition $x(0)=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}.$ Substituting $t=0$ into the general solution gives\n\n$$\n\\begin{aligned}\\text{x}(0) & ={c}_{1}\\begin{bmatrix}3 \\\\ 1\\end{bmatrix}+{c}_{2}\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}1 \\\\ -1\\end{bmatrix} & =\\begin{bmatrix}3{c}_{1}-{c}_{2} \\\\ {c}_{1}\\end{bmatrix} \\\\ \\begin{bmatrix}{c}_{1} \\\\ {c}_{2}\\end{bmatrix} & =\\begin{bmatrix}-1 \\\\ -4\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}\\text{x}(t) & =-\\begin{bmatrix}3\\operatorname{cos}⁡t+\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{bmatrix}-4\\begin{bmatrix}3\\operatorname{sin}⁡t-\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{cos}⁡t-13\\operatorname{sin}⁡t \\\\ -\\operatorname{cos}⁡t-4\\operatorname{sin}⁡t\\end{bmatrix}.\\end{aligned}\n$$"] [17592186391375 :answer/value "x(t)=\\begin{bmatrix}\\operatorname{cos}⁡t \\\\ -\\operatorname{cos}⁡t+2\\operatorname{sin}⁡t\\end{bmatrix}"] [17592186391376 :answer/value "\\text{x}(t)=\\begin{bmatrix}\\operatorname{cos}⁡t-13\\operatorname{sin}⁡t \\\\ -\\operatorname{cos}⁡t-4\\operatorname{sin}⁡t\\end{bmatrix}"] [17592186391377 :answer/value "x(t)=\\begin{bmatrix}\\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ -\\operatorname{cos}⁡t\\end{bmatrix}"] [17592186391378 :answer/value "x(t)=\\begin{bmatrix}\\operatorname{cos}⁡t+6\\operatorname{sin}⁡t \\\\ -\\operatorname{cos}⁡t+2\\operatorname{sin}⁡t\\end{bmatrix}"] [17592186391379 :answer/value "x(t)=\\begin{bmatrix}\\operatorname{cos}⁡t+3\\operatorname{sin}⁡t \\\\ -\\operatorname{cos}⁡t\\end{bmatrix}"] [17592186391380 :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}-1 & 1 \\\\ -2 & 1\\end{bmatrix}x(t),\\,x(0)=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.\n$$\n\n*Hint: The matrix has the eigenvalue ${\\lambda }_{1}=\\text{i}$ with the corresponding eigenvector ${v}_{1}=\\begin{bmatrix}1-\\text{i} \\\\ 2\\end{bmatrix}.$*"] [17592186391380 :question/worked-solution "We need to find the eigenvalues and associated eigenvectors of the matrix $A=\\begin{bmatrix}-1 & 1 \\\\ -2 & 1\\end{bmatrix}.$ \n\nWe are given the eigenvalue ${\\lambda }_{1}=\\text{i}$ and the corresponding eigenvector ${v}_{1}=\\begin{bmatrix}1-\\text{i} \\\\ 2\\end{bmatrix}.$\n\n**Note:** The eigenvector corresponding to the second eigenvalue ${\\lambda }_{2}={\\overset{―}{\\lambda }}_{1}$ is \n${v}_{2}={\\overset{―}{v}}_{1}.$ But we do not require this eigenvector for solving our system.\n\nThe solution that we obtain for the eigenvalue ${\\lambda }_{1}=\\text{i}$ and its associated eigenvector is\n\n$$\n{x}_{1}(t)=\\begin{bmatrix}1-\\text{i} \\\\ 2\\end{bmatrix}{e}^{\\text{i}t}.\n$$\n\nWe now express this as a real function. Using Euler's formula, we obtain\n\n$$\n\\begin{aligned}{x}_{1}(t) & =\\begin{bmatrix}1-\\text{i} \\\\ 2\\end{bmatrix}{e}^{\\text{i}t} \\\\  & =\\begin{bmatrix}1-\\text{i} \\\\ 2\\end{bmatrix}\\cdot (\\operatorname{cos}⁡t+\\text{i}\\operatorname{sin}⁡t) \\\\  & =\\begin{bmatrix}\\operatorname{cos}⁡t+\\text{i}\\operatorname{sin}⁡t-\\text{i}\\operatorname{cos}⁡t+\\operatorname{sin}⁡t \\\\ 2\\operatorname{cos}⁡t+2\\text{i}\\operatorname{sin}⁡t\\end{bmatrix} \\\\  & =\\begin{bmatrix}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)+\\text{i}(\\operatorname{sin}⁡t-\\operatorname{cos}⁡t) \\\\ 2\\operatorname{cos}⁡t+2\\text{i}\\operatorname{sin}⁡t\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{cos}⁡t+\\operatorname{sin}⁡t \\\\ 2\\operatorname{cos}⁡t\\end{bmatrix}+\\text{i}\\begin{bmatrix}\\operatorname{sin}⁡t-\\operatorname{cos}⁡t \\\\ 2\\operatorname{sin}⁡t\\end{bmatrix} \\\\  & ={\\text{w}}_{1}(t)+\\text{i}{\\text{w}}_{2}(t).\\end{aligned}\n$$\n\nThe vectors ${w}_{1}$ and ${w}_{2}$ are linearly independent. Therefore, the general solution of the system is\n\n$$\n\\begin{aligned}\\text{x}(t) & ={c}_{1}{\\text{w}}_{1}(t)+{c}_{2}{\\text{w}}_{2}(t) \\\\  & ={c}_{1}\\begin{bmatrix}\\operatorname{cos}⁡t+\\operatorname{sin}⁡t \\\\ 2\\operatorname{cos}⁡t\\end{bmatrix}+{c}_{2}\\begin{bmatrix}\\operatorname{sin}⁡t-\\operatorname{cos}⁡t \\\\ 2\\operatorname{sin}⁡t\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we need to find the values of ${c}_{1}$ and ${c}_{2}$ using the initial condition $x(0)=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.$ Substituting $t=0$ into the general solution gives\n\n$$\n\\begin{aligned}\\text{x}(0) & ={c}_{1}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}+{c}_{2}\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}1 \\\\ 0\\end{bmatrix} & =\\begin{bmatrix}{c}_{1}-{c}_{2} \\\\ 2{c}_{1}\\end{bmatrix} \\\\ \\begin{bmatrix}{c}_{1} \\\\ {c}_{2}\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}\\text{x}(t) & =0\\begin{bmatrix}\\operatorname{cos}⁡t+\\operatorname{sin}⁡t \\\\ 2\\operatorname{cos}⁡t\\end{bmatrix}-\\begin{bmatrix}\\operatorname{sin}⁡t-\\operatorname{cos}⁡t \\\\ 2\\operatorname{sin}⁡t\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ -2\\operatorname{sin}⁡t\\end{bmatrix}.\\end{aligned}\n$$"] [17592186391382 :answer/value "\\text{x}(t)=\\begin{bmatrix}\\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ -2\\operatorname{sin}⁡t\\end{bmatrix}"] [17592186391383 :answer/value "x(t)=\\begin{bmatrix}\\operatorname{cos}⁡t+\\operatorname{sin}⁡t \\\\ \\operatorname{sin}⁡t\\end{bmatrix}"] [17592186391384 :answer/value "x(t)=\\begin{bmatrix}\\operatorname{cos}⁡t \\\\ -\\operatorname{sin}⁡t\\end{bmatrix}"] [17592186391385 :answer/value "x(t)=\\begin{bmatrix}\\operatorname{cos}⁡t-2\\operatorname{sin}⁡t \\\\ -\\operatorname{sin}⁡t\\end{bmatrix}"] [17592186391386 :answer/value "x(t)=\\begin{bmatrix}\\operatorname{cos}⁡t \\\\ 3\\operatorname{sin}⁡t\\end{bmatrix}"] [17592186391394 :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}0 & 1 \\\\ -16 & 0\\end{bmatrix}x(t),\\,x(0)=\\begin{bmatrix}2 \\\\ 0\\en