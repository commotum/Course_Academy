4\\end{aligned}] & {R}_{2} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 5 \\\\ 0 & 1 & 4 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe pivot columns correspond to linearly independent vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the $1$st and $2$nd columns are pivot columns, while the $3$rd column is a non-pivot column.\n\nRemember that we need to pick the pivot columns from the *original matrix*, not from the reduced one. \n\nThe $1$st and $2$nd columns from the original matrix are ${v}_{1}$ and ${v}_{2}.$ So, a basis of $\\text{Col}(V)$ is $\\{{v}_{1},{v}_{2}\\},$ that is to say, \n\n$$\nB=\\{[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}],[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]\\}.\n$$" "In order to find a basis of $\\text{Col}(V),$ we reduce the matrix $V$ to row echelon form:\n\n$$\n\\begin{aligned}V & =\\begin{bmatrix}1 & 0 & 5 \\\\ 0 & 0 & 0 \\\\ 0 & 1 & 4\\end{bmatrix} & {R}_{2} & ↔{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 0 & 5 \\\\ 0 & 1 & 4 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe pivot columns correspond to linearly independent vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the $1$st and $2$nd columns are pivot columns, while the $3$rd column is a non-pivot column.\n\nRemember that we need to pick the pivot columns from the *original matrix*, not from the reduced one. \n\nThe $1$st and $2$nd columns from the original matrix are ${v}_{1}$ and ${v}_{2}.$ So, a basis of $\\text{Col}(V)$ is $\\{{v}_{1},{v}_{2}\\},$ that is to say, \n\n$$\nB=\\{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}\\}.\n$$"] [:db/cas 17592186423621 :question/problem "The matrix $F$ is given below. Let ${f}_{1}$, ${f}_{2}$,  ${f}_{3}$ and ${f}_{4}$ be the respective columns of $F.$\nDetermine if $B=\\text{{}{f}_{1},{f}_{2},{f}_{3}\\text{}}$ is a basis of $\\text{Col}(F).$ \nIf that is the case, find ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}$, where ${f}_{4}={x}_{1}{f}_{1}+{x}_{2}{f}_{2}+{x}_{3}{f}_{3}.$ \n\n$$\nF=[\\begin{aligned}-4 & -4 & -24 & -4 \\\\ 0 & 1 & 1 & 0 \\\\ -1 & -1 & -6 & -1\\end{aligned}]\n$$" "The matrix $F$ is given below. Let ${f}_{1}$, ${f}_{2}$,  ${f}_{3}$ and ${f}_{4}$ be the respective columns of $F.$\nDetermine if $B=\\text{{}{f}_{1},{f}_{2},{f}_{3}\\text{}}$ is a basis of $\\text{Col}(F).$ \nIf that is the case, find ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}$, where ${f}_{4}={x}_{1}{f}_{1}+{x}_{2}{f}_{2}+{x}_{3}{f}_{3}.$ \n\n$$\nF=\\begin{bmatrix}-4 & -4 & -24 & -4 \\\\ 0 & 1 & 1 & 0 \\\\ -1 & -1 & -6 & -1\\end{bmatrix}\n$$"] [:db/cas 17592186423621 :question/worked-solution "First, we reduce the matrix $F$ to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned}F & =[\\begin{aligned}-4 & -4 & -24 & -4 \\\\ 0 & 1 & 1 & 0 \\\\ -1 & -1 & -6 & -1\\end{aligned}] & {R}_{1} & :=(-\\frac{1}{4}){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 6 & 1 \\\\ 0 & 1 & 1 & 0 \\\\ -1 & -1 & -6 & -1\\end{aligned}] & {R}_{3} & :={R}_{3}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 6 & 1 \\\\ 0 & 1 & 1 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}] & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 5 & 1 \\\\ 0 & 1 & 1 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nFrom the matrix above, we see that the pivot columns are the $1$st and $2$nd columns. So, a basis of $\\text{Col}(F)$ is $\\{{f}_{1},{f}_{2}\\}.$ \n\nTherefore, we conclude that $B=\\{{f}_{1},{f}_{2},{f}_{3}\\}$ is not a basis of $\\text{Col}(F).$" "First, we reduce the matrix $F$ to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned}F & =\\begin{bmatrix}-4 & -4 & -24 & -4 \\\\ 0 & 1 & 1 & 0 \\\\ -1 & -1 & -6 & -1\\end{bmatrix} & {R}_{1} & :=(-\\frac{1}{4}){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & 6 & 1 \\\\ 0 & 1 & 1 & 0 \\\\ -1 & -1 & -6 & -1\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & 6 & 1 \\\\ 0 & 1 & 1 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 5 & 1 \\\\ 0 & 1 & 1 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nFrom the matrix above, we see that the pivot columns are the $1$st and $2$nd columns. So, a basis of $\\text{Col}(F)$ is $\\{{f}_{1},{f}_{2}\\}.$ \n\nTherefore, we conclude that $B=\\{{f}_{1},{f}_{2},{f}_{3}\\}$ is not a basis of $\\text{Col}(F).$"] [:db/cas 17592186423652 :question/problem "Let $u=[\\begin{aligned}-5 \\\\ -3 \\\\ 2 \\\\ 0\\end{aligned}],v=[\\begin{aligned}1 \\\\ -3 \\\\ -4 \\\\ 1\\end{aligned}]$ and $w=[\\begin{aligned}2 \\\\ 2 \\\\ 8 \\\\ 3\\end{aligned}]$ be vectors such that $u$ and $w$ are orthogonal. Find $(u+2w)\\cdot (u-4v)-u\\cdot u.$" "Let $u=\\begin{bmatrix}-5 \\\\ -3 \\\\ 2 \\\\ 0\\end{bmatrix},v=\\begin{bmatrix}1 \\\\ -3 \\\\ -4 \\\\ 1\\end{bmatrix}$ and $w=\\begin{bmatrix}2 \\\\ 2 \\\\ 8 \\\\ 3\\end{bmatrix}$ be vectors such that $u$ and $w$ are orthogonal. Find $(u+2w)\\cdot (u-4v)-u\\cdot u.$"] [:db/cas 17592186423653 :question/problem "Given the vector $u=[\\begin{aligned}3 \\\\ 0 \\\\ -1 \\\\ 1\\end{aligned}]$, which of the following vectors are orthogonal to $u?$\n\n$$\nv=[\\begin{aligned}-1 \\\\ -3 \\\\ 1 \\\\ 2\\end{aligned}],\\,w=[\\begin{aligned}1 \\\\ 3 \\\\ 1 \\\\ -2\\end{aligned}],\\,x=[\\begin{aligned}2 \\\\ 1 \\\\ 2 \\\\ -4\\end{aligned}].\n$$" "Given the vector $u=\\begin{bmatrix}3 \\\\ 0 \\\\ -1 \\\\ 1\\end{bmatrix}$, which of the following vectors are orthogonal to $u?$\n\n$$\nv=\\begin{bmatrix}-1 \\\\ -3 \\\\ 1 \\\\ 2\\end{bmatrix},\\,w=\\begin{bmatrix}1 \\\\ 3 \\\\ 1 \\\\ -2\\end{bmatrix},\\,x=\\begin{bmatrix}2 \\\\ 1 \\\\ 2 \\\\ -4\\end{bmatrix}.\n$$"] [:db/cas 17592186423654 :question/problem "If $u=[\\begin{aligned}-5 \\\\ k \\\\ 2 \\\\ -6\\end{aligned}]$ and $v=[\\begin{aligned}-3 \\\\ -1 \\\\ -8 \\\\ 1\\end{aligned}]$ are orthogonal vectors, then $k=$" "If $u=\\begin{bmatrix}-5 \\\\ k \\\\ 2 \\\\ -6\\end{bmatrix}$ and $v=\\begin{bmatrix}-3 \\\\ -1 \\\\ -8 \\\\ 1\\end{bmatrix}$ are orthogonal vectors, then $k=$"] [:db/cas 17592186423655 :question/problem "Let $u=[\\begin{aligned}1 \\\\ 4 \\\\ -2 \\\\ 3\\end{aligned}],v=[\\begin{aligned}2 \\\\ -1 \\\\ 2 \\\\ 2\\end{aligned}]$ and $w=[\\begin{aligned}3 \\\\ -2 \\\\ 1 \\\\ 2\\end{aligned}]$ be vectors such that $u\\,⊥\\,v.$ Find $(u-2w)\\cdot (w-4v).$" "Let $u=\\begin{bmatrix}1 \\\\ 4 \\\\ -2 \\\\ 3\\end{bmatrix},v=\\begin{bmatrix}2 \\\\ -1 \\\\ 2 \\\\ 2\\end{bmatrix}$ and $w=\\begin{bmatrix}3 \\\\ -2 \\\\ 1 \\\\ 2\\end{bmatrix}$ be vectors such that $u\\,⊥\\,v.$ Find $(u-2w)\\cdot (w-4v).$"] [:db/cas 17592186423656 :question/problem "Let $u=[\\begin{aligned}2 \\\\ a \\\\ 7 \\\\ b\\end{aligned}],v=[\\begin{aligned}1 \\\\ 4 \\\\ 0 \\\\ -6\\end{aligned}],$ and $w=[\\begin{aligned}-4 \\\\ 3 \\\\ 5 \\\\ 4\\end{aligned}]$ be vectors such that $u$ is orthogonal to $v$ and $w.$ What is the value of $a+b?$" "Let $u=\\begin{bmatrix}2 \\\\ a \\\\ 7 \\\\ b\\end{bmatrix},v=\\begin{bmatrix}1 \\\\ 4 \\\\ 0 \\\\ -6\\end{bmatrix},$ and $w=\\begin{bmatrix}-4 \\\\ 3 \\\\ 5 \\\\ 4\\end{bmatrix}$ be vectors such that $u$ is orthogonal to $v$ and $w.$ What is the value of $a+b?$"] [:db/cas 17592186423671 :question/worked-solution "The correct answer is \n\n*$T$ is **not** a vector space (with respect to addition of matrices and multiplication of matrices by a real number) because **multiplication by a scalar is not closed.** *\n\n For example, the identity matrix \n\n$$\nI=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}],\n$$\n\nlies in $T$, but\n\n$$\n\\sqrt{2}\\cdot I=[\\begin{aligned}\\sqrt{2} & 0 \\\\ 0 & \\sqrt{2}\\end{aligned}]\\notin T\n$$\n\nbecause $\\sqrt{2}+\\sqrt{2}$ is not a rational number.\n\nOn the other hand,\n\n- The zero matrix belongs to $T.$  $\\,✓$\n\n- Addition of matrices with real entries is commutative, in general.    $\\,✓$\n\n- Addition of matrices with real entries is associative, in general.    $\\,✓$\n\n- Given any $A\\in T,$  the additive inverse matrix $-A=(-1)\\cdot A$ is also in  $T,$ and   $A+(-A)=O.$  $\\,✓$" "The correct answer is \n\n*$T$ is **not** a vector space (with respect to addition of matrices and multiplication of matrices by a real number) because **multiplication by a scalar is not closed.** *\n\n For example, the identity matrix \n\n$$\nI=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix},\n$$\n\nlies in $T$, but\n\n$$\n\\sqrt{2}\\cdot I=\\begin{bmatrix}\\sqrt{2} & 0 \\\\ 0 & \\sqrt{2}\\end{bmatrix}\\notin T\n$$\n\nbecause $\\sqrt{2}+\\sqrt{2}$ is not a rational number.\n\nOn the other hand,\n\n- The zero matrix belongs to $T.$  $\\,✓$\n\n- Addition of matrices with real entries is commutative, in general.    $\\,✓$\n\n- Addition of matrices with real entries is associative, in general.    $\\,✓$\n\n- Given any $A\\in T,$  the additive inverse matrix $-A=(-1)\\cdot A$ is also in  $T,$ and   $A+(-A)=O.$  $\\,✓$"] [:db/cas 17592186423685 :answer/value "[\\begin{aligned}\\frac{2}{\\sqrt{6}} \\\\ -\\frac{1}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{6}}\\end{aligned}]" "\\begin{bmatrix}\\frac{2}{\\sqrt{6}} \\\\ -\\frac{1}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{6}}\\end{bmatrix}"] [:db/cas 17592186423700 :answer/value "[\\begin{aligned}\\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{aligned}]" "\\begin{bmatrix}\\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{bmatrix}"] [:db/cas 17592186423716 :answer/value "[\\begin{aligned}\\frac{1}{3\\sqrt{2}} \\\\ -\\frac{1}{3\\sqrt{2}} \\\\ -\\frac{4}{3\\sqrt{2}}\\end{aligned}]" "\\begin{bmatrix}\\frac{1}{3\\sqrt{2}} \\\\ -\\frac{1}{3\\sqrt{2}} \\\\ -\\frac{4}{3\\sqrt{2}}\\end{bmatrix}"] [:db/cas 17592186423720 :answer/value "[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]" "\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}"] [:db/cas 17592186423721 :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]" "\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}"] [:db/cas 17592186423723 :answer/value "[\\begi