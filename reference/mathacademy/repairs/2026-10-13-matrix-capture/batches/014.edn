} & (t-s){e}^{5(t-s)} \\\\ 0 & {e}^{5(t-s)}\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{5(t-s)} \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s & ={\\int }_{0}^{t}[\\begin{aligned}{e}^{5(t-s)} \\\\ 0\\end{aligned}]\\text{d}s \\\\  & ={[\\begin{aligned}-\\frac{1}{5}{e}^{5(t-s)} \\\\ 0\\end{aligned}]}_{s=0}^{s=t} \\\\  & =[\\begin{aligned}\\frac{1}{5}{e}^{5t}-\\frac{1}{5} \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}0 \\\\ 0\\end{aligned}]+[\\begin{aligned}\\frac{1}{5}{e}^{5t}-\\frac{1}{5} \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{5}{e}^{5t}-\\frac{1}{5} \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{5}[\\begin{aligned}{e}^{5t}-1 \\\\ 0\\end{aligned}].\\end{aligned}\n$$" "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}5 & 1 \\\\ 0 & 5\\end{bmatrix}x(t)+g(t),\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}$ and $g(t)=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.$ So, the matrix of the system is $A=\\begin{bmatrix}5 & 1 \\\\ 0 & 5\\end{bmatrix}.$\n\nGiven the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that \n\n$$\n{e}^{At}=\\begin{bmatrix}{e}^{5t} & t{e}^{5t} \\\\ 0 & {e}^{5t}\\end{bmatrix}.\n$$\n\nSince the initial conditions are given at $t={t}_{0}=0,$ we have\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})}x(0) & ={e}^{At}\\,x(0) \\\\  & =\\begin{bmatrix}{e}^{5t} & t{e}^{5t} \\\\ 