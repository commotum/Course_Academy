^{4t} & 0 \\\\ 0 & {e}^{t}\\end{aligned}] \\\\  & ={e}^{-5t}[\\begin{aligned}{e}^{4t} & 0 \\\\ 0 & {e}^{t}\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{-t} & 0 \\\\ 0 & {e}^{-4t}\\end{aligned}]. \\\\ {Φ}^{-1}\\,f(t) & =[\\begin{aligned}{e}^{-t} & 0 \\\\ 0 & {e}^{-4t}\\end{aligned}][\\begin{aligned}2 \\\\ -8\\end{aligned}] \\\\  & =[\\begin{aligned}2{e}^{-t} \\\\ -8{e}^{-4t}\\end{aligned}]\\end{aligned}\n$$\n\nNow, using our formula for $u(t),$ we obtain\n\n$$\n\\begin{aligned}u(t) & =\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t \\\\  & =\\int [\\begin{aligned}2{e}^{-t} \\\\ -8{e}^{-4t}\\end{aligned}]\\,\\text{d}t \\\\  & =[\\begin{aligned}\\int 2{e}^{-t}\\,\\text{d}t \\\\ \\int -8{e}^{-4t}\\,\\text{d}t\\end{aligned}] \\\\  & =[\\begin{aligned}-2{e}^{-t} \\\\ 2{e}^{-4t}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{x}_{p}(t) & =Φ\\,u(t) \\\\  & =[\\begin{aligned}{e}^{t} & 0 \\\\ 0 & {e}^{4t}\\end{aligned}][\\begin{aligned}-2{e}^{-t} \\\\ 2{e}^{-4t}\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ 2\\end{aligned}].\\end{aligned}\n$$" "We'll look for a particular solution in the form\n\n$$\n{x}_{p}(t)=Φ\\,u(t)\n$$\n\nwhere $Φ$ is a fundamental matrix for the corresponding homogeneous system, $f(t)$ is the forcing column vector and\n\n$$\nu(t)=\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t.\n$$\n\nIn our case,\n\n$$\nΦ=\\begin{bmatrix}{e}^{t} & 0 \\\\ 0 & {e}^{4t}\\end{bmatrix},\\,f(t)=\\begin{bmatrix}2 \\\\ -8\\end{bmatrix}.\n$$\n\nSince $Φ$ is a fundamental matrix, it must be invertible. Using the formula for the inverse of a $2\\times 2$ matrix, we get the following:\n\n$$\n\\begin{aligned}{Φ}^{-1} & =\\frac{1}{{e}^{t}\\cdot {e}^{4t}-0\\cdot 0}\\begin{bmatrix}{e}^{4t} & 0 \\\\ 0 & {e}^{t}\\end{bmatrix} \\\\  & ={e}^{-5t}\\begin{bmatrix}{e}^{4t} & 0 \\\\ 0 & {e}^{t}\\end{bmatrix} \\\\  & =\\begin{bmatrix}{e}^{-t} & 0 \\\\ 0 & {e}^{-4t}\\end{bmatrix}. \\\\ {Φ}^{-1}\\,f(t) & =\\begin{bmatrix}{e}^{-t} & 0 \\\\ 0 & {e}^{-4t}\\end{bmatrix}\\begin{bmatrix}2 \\\\ -8\\end{bmatrix} \\\\  & =\\begin{bmatrix}2{e}^{-t} \\\\ -8{e}^{-4t}\\end{bmatrix}\\end{aligned}\n$$\n\nNow, using our formula for $u(t),$ we obtain\n\n$$\n\\begin{aligned}u(t) & =\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t \\\\  & =\\int \\begin{bmatrix}2{e}^{-t} \\\\ -8{e}^{-4t}\\end{bmatrix}\\,\\text{d}t \\\\  & =\\begin{bmatrix}\\int 2{e}^{-t}\\,\\text{d}t \\\\ \\int -8{e}^{-4t}\\,\\text{d}t\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2{e}^{-t} \\\\ 2{e}^{-4t}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{x}_{p}(t) & =Φ\\,u(t) \\\\  & =\\begin{bmatrix}{e}^{t} & 0 \\\\ 0 & {e}^{4t}\\end{bmatrix}\\begin{bmatrix}-2{e}^{-t} \\\\ 2{e}^{-4t}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$"] [:db/cas 17592186311828 :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}4 & 0 \\\\ -5 & -1\\end{aligned}]x(t)+\\overset{f(t)}{\\overset{⏞}{[\\begin{aligned}{e}^{t} \\\\ 4{e}^{t}\\end{aligned}]}},\\,Φ=[\\begin{aligned}0 & 3{e}^{4t} \\\\ {e}^{-t} & -3{e}^{4t}\\end{aligned}]\n$$\n\nConsider the system of differential equations and the fundamental matrix of the corresponding homogeneous system above. Using the method of variation of parameters, compute ${Φ}^{-1}\\,f(t)$ and the particular solution ${x}_{p}(t)$ of the system.\n\n| ${Φ}^{-1}\\,f(t)=\\,\\,$ |  | {{field-1}} |  | $\\,,\\,$ | ${x}_{p}(t)={e}^{t}\\,\\,$ |  | {{field-2}} |  |  |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | $\\frac{1}{3}{e}^{-3t}$ |  |  | $\\frac{17}{6}$ |  |  |  |  |  |" "$$\n{x}^{′}(t)=\\begin{bmatrix}4 & 0 \\\\ -5 & -1\\end{bmatrix}x(t)+\\overset{f(t)}{\\overset{⏞}{\\begin{bmatrix}{e}^{t} \\\\ 4{e}^{t}\\end{bmatrix}}},\\,Φ=\\begin{bmatrix}0 & 3{e}^{4t} \\\\ {e}^{-t} & -3{e}^{4t}\\end{bmatrix}\n$$\n\nConsider the system of differential equations and the fundamental matrix of the corresponding homogeneous system above. Using the method of variation of parameters, compute ${Φ}^{-1}\\,f(t)$ and the particular solution ${x}_{p}(t)$ of the system.\n\n| ${Φ}^{-1}\\,f(t)=\\,\\,$ |  | {{field-1}} |  | $\\,,\\,$ | ${x}_{p}(t)={e}^{t}\\,\\,$ |  | {{field-2}} |  |  |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | $\\frac{1}{3}{e}^{-3t}$ |  |  | $\\frac{17}{6}$ |  |  |  |  |  |"] [:db/cas 17592186311828 :question/worked-solution "We'll look for a particular solution in the form\n\n$$\n{x}_{p}(t)=Φ\\,u(t)\n$$\n\nwhere $Φ$ is a fundamental matrix for the corresponding homogeneous system, $f(t)$ is the forcing column vector and\n\n$$\nu(t)=\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t.\n$$\n\nIn our case,\n\n$$\nΦ=[\\begin{aligned}0 & 3{e}^{4t} \\\\ {e}^{-t} & -3{e}^{4t}\\end{aligned}],\\,f(t)=[\\begin{aligned}{e}^{t} \\\\ 4{e}^{t}\\end{aligned}].\n$$\n\nSince $Φ$ is a fundamental matrix, it must be invertible. Using the formula for the inverse of a $2\\times 2$ matrix, we get the following:\n\n$$\n\\begin{aligned}{Φ}^{-1} & =\\frac{1}{0\\cdot (-3{e}^{4t})-3{e}^{4t}\\cdot {e}^{-t}}[\\begin{aligned}-3{e}^{4t} & -3{e}^{4t} \\\\ -{e}^{-t} & 0\\end{aligned}] \\\\  & =-\\frac{{e}^{-3t}}{3}[\\begin{aligned}-3{e}^{4t} & -3{e}^{4t} \\\\ -{e}^{-t} & 0\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{t} & {e}^{t} \\\\ \\frac{1}{3}{e}^{-4t} & 0\\end{aligned}] \\\\ {Φ}^{-1}\\,f(t) & =[\\begin{aligned}{e}^{t} & {e}^{t} \\\\ \\frac{1}{3}{e}^{-4t} & 0\\end{aligned}][\\begin{aligned}{e}^{t} \\\\ 4{e}^{t}\\end{aligned}] \\\\  & =[\\begin{aligned}5{e}^{2t} \\\\ \\frac{1}{3}{e}^{-3t}\\end{aligned}]\\end{aligned}\n$$\n\nNow, using our formula for $u(t),$ we obtain\n\n$$\n\\begin{aligned}u(t) & =\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t \\\\  & =\\int [\\begin{aligned}5{e}^{2t} \\\\ \\frac{1}{3}{e}^{-3t}\\end{aligned}]\\,\\text{d}t \\\\  & =[\\begin{aligned}\\int 5{e}^{2t}\\,\\text{d}t \\\\ \\int \\frac{1}{3}{e}^{-3t}\\,\\text{d}t\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{5}{2}{e}^{2t} \\\\ -\\frac{1}{9}{e}^{-3t}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{x}_{p}(t) & =Φ\\,u(t) \\\\  & =[\\begin{aligned}0 & 3{e}^{4t} \\\\ {e}^{-t} & -3{e}^{4t}\\end{aligned}][\\begin{aligned}\\frac{5}{2}{e}^{2t} \\\\ -\\frac{1}{9}{e}^{-3t}\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{1}{3}{e}^{t} \\\\ \\frac{17}{6}{e}^{t}\\end{aligned}] \\\\  & ={e}^{t}[\\begin{aligned}-\\frac{1}{3} \\\\ \\frac{17}{6}\\end{aligned}].\\end{aligned}\n$$" "We'll look for a particular solution in the form\n\n$$\n{x}_{p}(t)=Φ\\,u(t)\n$$\n\nwhere $Φ$ is a fundamental matrix for the corresponding homogeneous system, $f(t)$ is the forcing column vector and\n\n$$\nu(t)=\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t.\n$$\n\nIn our case,\n\n$$\nΦ=\\begin{bmatrix}0 & 3{e}^{4t} \\\\ {e}^{-t} & -3{e}^{4t}\\end{bmatrix},\\,f(t)=\\begin{bmatrix}{e}^{t} \\\\ 4{e}^{t}\\end{bmatrix}.\n$$\n\nSince $Φ$ is a fundamental matrix, it must be invertible. Using the formula for the inverse of a $2\\times 2$ matrix, we get the following:\n\n$$\n\\begin{aligned}{Φ}^{-1} & =\\frac{1}{0\\cdot (-3{e}^{4t})-3{e}^{4t}\\cdot {e}^{-t}}\\begin{bmatrix}-3{e}^{4t} & -3{e}^{4t} \\\\ -{e}^{-t} & 0\\end{bmatrix} \\\\  & =-\\frac{{e}^{-3t}}{3}\\begin{bmatrix}-3{e}^{4t} & -3{e}^{4t} \\\\ -{e}^{-t} & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}{e}^{t} & {e}^{t} \\\\ \\frac{1}{3}{e}^{-4t} & 0\\end{bmatrix} \\\\ {Φ}^{-1}\\,f(t) & =\\begin{bmatrix}{e}^{t} & {e}^{t} \\\\ \\frac{1}{3}{e}^{-4t} & 0\\end{bmatrix}\\begin{bmatrix}{e}^{t} \\\\ 4{e}^{t}\\end{bmatrix} \\\\  & =\\begin{bmatrix}5{e}^{2t} \\\\ \\frac{1}{3}{e}^{-3t}\\end{bmatrix}\\end{aligned}\n$$\n\nNow, using our formula for $u(t),$ we obtain\n\n$$\n\\begin{aligned}u(t) & =\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t \\\\  & =\\int \\begin{bmatrix}5{e}^{2t} \\\\ \\frac{1}{3}{e}^{-3t}\\end{bmatrix}\\,\\text{d}t \\\\  & =\\begin{bmatrix}\\int 5{e}^{2t}\\,\\text{d}t \\\\ \\int \\frac{1}{3}{e}^{-3t}\\,\\text{d}t\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{5}{2}{e}^{2t} \\\\ -\\frac{1}{9}{e}^{-3t}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{x}_{p}(t) & =Φ\\,u(t) \\\\  & =\\begin{bmatrix}0 & 3{e}^{4t} \\\\ {e}^{-t} & -3{e}^{4t}\\end{bmatrix}\\begin{bmatrix}\\frac{5}{2}{e}^{2t} \\\\ -\\frac{1}{9}{e}^{-3t}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{1}{3}{e}^{t} \\\\ \\frac{17}{6}{e}^{t}\\end{bmatrix} \\\\  & ={e}^{t}\\begin{bmatrix}-\\frac{1}{3} \\\\ \\frac{17}{6}\\end{bmatrix}.\\end{aligned}\n$$"] [:db/cas 17592186311829 :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}-3 & 0 \\\\ 4 & 2\\end{aligned}]x(t)+\\overset{f(t)}{\\overset{⏞}{[\\begin{aligned}3{e}^{t} \\\\ 2{e}^{t}\\end{aligned}]}},\\,Φ=[\\begin{aligned}0 & 5{e}^{-3t} \\\\ {e}^{2t} & -4{e}^{-3t}\\end{aligned}]\n$$\n\nConsider the system of differential equations and the fundamental matrix of the corresponding homogeneous system above. Using the method of variation of parameters, compute ${Φ}^{-1}\\,f(t)$ and the particular solution ${x}_{p}(t)$ of the system.\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">${Φ}^{-1}\\,f(t)=\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$\\,,\\,$</td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">${x}_{p}(t)={e}^{t}\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\"></td>\n</tr>\n<tr>\n<td height=\"60px\" width=\"5px\"></td>\n<td align=\"center\">$\\frac{3}{5}{e}^{4t}$</td>\n<td align=\"center\"></td>\n<td height=\"60px\" width=\"5px\"></td>\n<td align=\"center\">$-5$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" "$$\n{x}^{′}(t)=\\begin{bmatrix}-3 & 0 \\\\ 4 & 2\\end{bmatrix}x(t)+\\overset{f(t)}{\\overset{⏞}{\\begin{bmatrix}3{e}^{t} \\\\ 2{e}^{t}\\end{bmatrix}}},\\,Φ=\\begin{bmatrix}0 & 5{e}^{-3t} \\\\ {e}^{2t} & -4{e}^{-3t}\\end{bmatrix}\n$$\n\nConsider the system of differential equations and the fundamental matrix of the corresponding homogeneous system above. Using the method of variation of parameters, compute ${Φ}^{-1}\\,f(t)$ and the particular solution ${x}_{p}(t)$ of the system.\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">${Φ}^{-1}\\,f(t)=\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$\\,,\\,$</td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">${x}_{p}(t)={e}^{t}\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\"></td>\n</tr>\n<tr>\n<td height=\"60px\" width=\"5px\"></td>\n<td align=\"center\">$\\frac{3}{5}{e}^{4t}$</td>\n<td align=\"center\"></td>\n<td height=\"60px\" width=\"5px\"></td>\n<td align=\"center\">$-5$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>"] [:db/cas 17592186311829 :question/worked-solution "We'll look for a particular solution in the form\n\n$$\n{x}_{p}(t)=Φ\\,u(t)\n$$\n\nwhere $Φ$ is a fundamental matrix for the corresponding homogeneous system, $f(t)$ is the forcing column vector and\n\n$$\nu(t)=\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t.\n$$\n\nIn our case,\n\n$$\nΦ=[\\begin{aligned}0 & 5{e}^{-3t} \\\\ {e}^{2t} & -4{e}^{-3t}\\end{aligned}],\\,f(t)=[\\begin{aligned}3{e}^{t} \\\\ 2{e}^{t}\\end{aligned}].\n$$\n\nSince $Φ$ is a fundamental matrix, it must be invertible. Using the formula for the inverse of a $2\\times 2$ matrix, we get the following:\n\n$$\n\\begin{aligned}{Φ}^{-1} & =\\frac{1}{0\\cdot (-4{e}^{-3t})-5{e}^{-3t}\\cdot {e}^{2t}}[\\begin{aligned}-4{e}^{-3t} & -5{e}^{-3t} \\\\ -{e}^{2t} & 0\\end{aligned}] \\\\  & =-\\frac{{e}^{t}}{5}[\\begin{aligned}-4{e}^{-3t} & -5{e}^{-3t} \\\\ -{e}^{2t} & 0\\end{aligned}] \\\\  & =-\\frac{1}{5}[\\begin{aligned}-4{e}^{-2t} & -5{e}^{-2t} \\\\ -{e}^{3t} & 0\\end{aligned}] \\\\ {Φ}^{-1}\\,f(t) & =-\\frac{1}{5}[\\begin{aligned}-4{e}^{-2t} & -5{e}^{-2t} \\\\ -{e}^{3t} & 0\\end{aligned}][\\begin{aligned}3{e}^{t} \\\\ 2{e}^{t}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{22}{5}{e}^{-t} \\\\ \\frac{3}{5}{e}^{4t}\\end{aligned}]\\end{aligned}\n$$\n\nNow, using our formula for $u(t),$ we obtain\n\n$$\n\\begin{aligned}u(t) & =\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t \\\\  & =\\int [\\begin{aligned}\\frac{22}{5}{e}^{-t} \\\\ \\frac{3}{5}{e}^{4t}\\end{aligned}]\\,\\text{d}t \\\\  & =[\\begin{aligned}\\int \\frac{22}{5}{e}^{-t}\\,\\text{d}t \\\\ \\int \\frac{3}{5}{e}^{4t}\\,\\text{d}t\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{22}{5}{e}^{-t} \\\\ \\frac{3}{20}{e}^{4t}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{x}_{p}(t) & =Φ\\,u(t) \\\\  & =[\\begin{aligned}0 & 5{e}^{-3t} \\\\ {e}^{2t} & -4{e}^{-3t}\\end{aligned}][\\begin{aligned}-\\frac{22}{5}{e}^{-t} \\\\ \\frac{3}{20}{e}^{4t}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{3}{4}{e}^{t} \\\\ -5{e}^{t}\\end{aligned}] \\\\  & ={e}^{t}[\\begin{aligned}\\frac{3}{4} \\\\ -5\\end{aligned}].\\end{aligned}\n$$" "We'll look for a particular solution in the form\n\n$$\n{x}_{p}(t)=Φ\\,u(t)\n$$\n\nwhere $Φ$ is a fundamental matrix for the corresponding homogeneous system, $f(t)$ is the forcing column vector and\n\n$$\nu(t)=\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t.\n$$\n\nIn our case,\n\n$$\nΦ=\\begin{bmatrix}0 & 5{e}^{-3t} \\\\ {e}^{2t} & -4{e}^{-3t}\\end{bmatrix},\\,f(t)=\\begin{bmatrix}3{e}^{t} \\\\ 2{e}^{t}\\end{bmatrix}.\n$$\n\nSince $Φ$ is a fundamental matrix, it must be invertible. Using the formula for the inverse of a $2\\times 2$ matrix, we get the following:\n\n$$\n\\begin{aligned}{Φ}^{-1} & =\\frac{1}{0\\cdot (-4{e}^{-3t})-5{e}^{-3t}\\cdot {e}^{2t}}\\begin{bmatrix}-4{e}^{-3t} & -5{e}^{-3t} \\\\ -{e}^{2t} & 0\\end{bmatrix} \\\\  & =-\\frac{{e}^{t}}{5}\\begin{bmatrix}-4{e}^{-3t} & -5{e}^{-3t} \\\\ -{e}^{2t} & 0\\end{bmatrix} \\\\  & =-\\frac{1}{5}\\begin{bmatrix}-4{e}^{-2t} & -5{e}^{-2t} \\\\ -{e}^{3t} & 0\\end{bmatrix} \\\\ {Φ}^{-1}\\,f(t) & =-\\frac{1}{5}\\begin{bmatrix}-4{e}^{-2t} & -5{e}^{-2t} \\\\ -{e}^{3t} & 0\\end{bmatrix}\\begin{bmatrix}3{e}^{t} \\\\ 2{e}^{t}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{22}{5}{e}^{-t} \\\\ \\frac{3}{5}{e}^{4t}\\end{bmatrix}\\end{aligned}\n$$\n\nNow, using our formula for $u(t),$ we obtain\n\n$$\n\\begin{aligned}u(t) & =\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t \\\\  & =\\int \\begin{bmatrix}\\frac{22}{5}{e}^{-t} \\\\ \\frac{3}{5}{e}^{4t}\\end{bmatrix}\\,\\text{d}t \\\\  & =\\begin{bmatrix}\\int \\frac{22}{5}{e}^{-t}\\,\\text{d}t \\\\ \\int \\frac{3}{5}{e}^{4t}\\,\\text{d}t\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{22}{5}{e}^{-t} \\\\ \\frac{3}{20}{e}^{4t}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{x}_{p}(t) & =Φ\\,u(t) \\\\  & =\\begin{bmatrix}0 & 5{e}^{-3t} \\\\ {e}^{2t} & -4{e}^{-3t}\\end{bmatrix}\\begin{bmatrix}-\\frac{22}{5}{e}^{-t} \\\\ \\frac{3}{20}{e}^{4t}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{3}{4}{e}^{t} \\\\ -5{e}^{t}\\end{bmatrix} \\\\  & ={e}^{t}\\begin{bmatrix}\\frac{3}{4} \\\\ -5\\end{bmatrix}.\\end{aligned}\n$$"] [:db/cas 17592186311830 :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}-4 & 1 \\\\ -3 & 0\\end{aligned}]x(t)+[\\begin{aligned}3t \\\\ t\\end{aligned}]\n$$\n\nConsider the system of differential equations. Using the method of variation of parameters, the general solution of the equation can be written in the form\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$x(t)={c}_{1}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{-3t}+{c}_{2}[\\begin{aligned}1 \\\\ 3\\end{aligned}]{e}^{-t}+\\,\\,\\frac{1}{9}$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">.</td>\n</tr>\n<tr>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">$23-15t$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" "$$\n{x}^{′}(t)=\\begin{bmatrix}-4 & 1 \\\\ -3 & 0\\end{bmatrix}x(t)+\\begin{bmatrix}3t \\\\ t\\end{bmatrix}\n$$\n\nConsider the system of differential equations. Using the method of variation of parameters, the general solution of the equation can be written in the form\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$x(t)={c}_{1}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}{e}^{-3t}+{c}_{2}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}{e}^{-t}+\\,\\,\\frac{1}{9}$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">.</td>\n</tr>\n<tr>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">$23-15t$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>"] [:db/cas 17592186311830 :question/worked-solution "Recall that the general solution of an inhomogeneous system can be written as \n\n$$\nx(t)={x}_{c}(t)+{x}_{p}(t)\n$$\n\nwhere ${x}_{c}(t)$ is the complementary solution (solution of the corresponding homogeneous system) and ${x}_{p}(t)$ is a particular solution.\n\nNotice that we are given that\n\n$$\n{x}_{c}(t)={c}_{1}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{-3t}+{c}_{2}[\\begin{aligned}1 \\\\ 3\\end{aligned}]{e}^{-t}.\n$$\n\nWe'll look for a particular solution in the form\n\n$$\n{x}_{p}(t)=Φ\\,u(t)\n$$\n\nwhere $Φ$ is a fundamental matrix for the corresponding homogeneous system, $f(t)$ is the forcing column vector and\n\n$$\nu(t)=\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t.\n$$\n\nIn our case,\n\n$$\nΦ=[\\begin{aligned}{e}^{-3t} & {e}^{-t} \\\\ {e}^{-3t} & 3{e}^{-t}\\end{aligned}],\\,f(t)=[\\begin{aligned}3t \\\\ t\\end{aligned}].\n$$\n\nSince $Φ$ is a fundamental matrix, it must be invertible. Using the formula for the inverse of a $2\\times 2$ matrix, we get the following:\n\n$$\n\\begin{aligned}{Φ}^{-1} & =\\frac{1}{{e}^{-3t}\\cdot 3{e}^{-t}-{e}^{-t}\\cdot {e}^{-3t}}[\\begin{aligned}3{e}^{-t} & -{e}^{-t} \\\\ -{e}^{-3t} & {e}^{-3t}\\end{aligned}] \\\\  & =\\frac{1}{2{e}^{-4t}}[\\begin{aligned}3{e}^{-t} & -{e}^{-t} \\\\ -{e}^{-3t} & {e}^{-3t}\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}3{e}^{3t} & -{e}^{3t} \\\\ -{e}^{t} & {e}^{t}\\end{aligned}].\\end{aligned}\n$$\n\n$$\n\\begin{aligned}{Φ}^{-1}\\,f(t) & =\\frac{1}{2}[\\begin{aligned}3{e}^{3t} & -{e}^{3t} \\\\ -{e}^{t} & {e}^{t}\\end{aligned}][\\begin{aligned}3t \\\\ t\\end{aligned}] \\\\  & =[\\begin{aligned}4t{e}^{3t} \\\\ -t{e}^{t}\\end{aligned}].\\end{aligned}\n$$\n\nNow, using our formula for $u(t),$ we obtain\n\n$$\n\\begin{aligned}u(t) & =\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t \\\\  & =\\int [\\begin{aligned}4t{e}^{3t} \\\\ -t{e}^{t}\\end{aligned}]\\,\\text{d}t \\\\  & =[\\begin{aligned}\\int 4t{e}^{3t}\\,\\text{d}t \\\\ \\int -t{e}^{t}\\,\\text{d}t\\end{aligned}].\\end{aligned}\n$$\n\nIntegrating the components by parts, we get the following:\n\n- For the first component, let $u=4t$ and $\\text{d}v={e}^{3t}\\,\\text{d}t.$ Then, $\\text{d}u=4\\,\\text{d}t$ and $v=\\frac{1}{3}{e}^{3t}.$ So,\n\n$$\n\\begin{aligned}\\int 4t{e}^{3t}\\,\\text{d}t & =(4t)\\cdot \\frac{1}{3}{e}^{3t}-\\int \\frac{1}{3}{e}^{3t}\\cdot (4\\,\\text{d}t) \\\\  & =\\frac{4}{3}t{e}^{3t}-\\frac{4}{3}\\int {e}^{3t}\\,\\text{d}t \\\\  & =\\frac{4}{3}t{e}^{3t}-\\frac{4}{9}{e}^{3t} \\\\  & =\\frac{4}{9}{e}^{3t}(3t-1).\\end{aligned}\n$$\n\n- For the second component, let $u=-t$ and $\\text{d}v={e}^{t}\\,\\text{d}t.$ Then, $\\text{d}u=-\\,\\text{d}t$ and $v={e}^{t}.$ So,\n\n$$\n\\begin{aligned}\\int -t{e}^{t}\\,\\text{d}t & =(-t)\\cdot {e}^{t}-\\int {e}^{t}(-\\,\\text{d}t) \\\\  & =-t{e}^{t}+\\int {e}^{t}\\,\\text{d}t \\\\  & =-t{e}^{t}+{e}^{t} \\\\  & ={e}^{t}(1-t).\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{x}_{p}(t) & =Φ\\,u(t) \\\\  & =[\\begin{aligned}{e}^{-3t} & {e}^{-t} \\\\ {e}^{-3t} & 3{e}^{-t}\\end{aligned}][\\begin{aligned}\\frac{4}{9}{e}^{3t}(3t-1) \\\\ {e}^{t}(1-t)\\end{aligned}] \\\\  & =\\frac{1}{9}[\\begin{aligned}4(3t-1)+9(1-t) \\\\ 4(3t-1)+27(1-t)\\end{aligned}] \\\\  & =\\frac{1}{9}[\\begin{aligned}3t+5 \\\\ 23-15t\\end{aligned}].\\end{aligned}\n$$" "Recall that the general solution of an inhomogeneous system can be written as \n\n$$\nx(t)={x}_{c}(t)+{x}_{p}(t)\n$$\n\nwhere ${x}_{c}(t)$ is the complementary solution (solution of the corresponding homogeneous system) and ${x}_{p}(t)$ is a particular solution.\n\nNotice that we are given that\n\n$$\n{x}_{c}(t)={c}_{1}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}{e}^{-3t}+{c}_{2}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}{e}^{-t}.\n$$\n\nWe'll look for a particular solution in the form\n\n$$\n{x}_{p}(t)=Φ\\,u(t)\n$$\n\nwhere $Φ$ is a fundamental matrix for the corresponding homogeneous system, $f(t)$ is the forcing column vector and\n\n$$\nu(t)=\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t.\n$$\n\nIn our case,\n\n$$\nΦ=\\begin{bmatrix}{e}^{-3t} & {e}^{-t} \\\\ {e}^{-3t} & 3{e}^{-t}\\end{bmatrix},\\,f(t)=\\begin{bmatrix}3t \\\\ t\\end{bmatrix}.\n$$\n\nSince $Φ$ is a fundamental matrix, it must be invertible. Using the formula for the inverse of a $2\\times 2$ matrix, we get the following:\n\n$$\n\\begin{aligned}{Φ}^{-1} & =\\frac{1}{{e}^{-3t}\\cdot 3{e}^{-t}-{e}^{-t}\\cdot {e}^{-3t}}\\begin{bmatrix}3{e}^{-t} & -{e}^{-t} \\\\ -{e}^{-3t} & {e}^{-3t}\\end{bmatrix} \\\\  & =\\frac{1}{2{e}^{-4t}}\\begin{bmatrix}3{e}^{-t} & -{e}^{-t} \\\\ -{e}^{-3t} & {e}^{-3t}\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}3{e}^{3t} & -{e}^{3t} \\\\ -{e}^{t} & {e}^{t}\\end{bmatrix}.\\end{aligned}\n$$\n\n$$\n\\begin{aligned}{Φ}^{-1}\\,f(t) & =\\frac{1}{2}\\begin{bmatrix}3{e}^{3t} & -{e}^{3t} \\\\ -{e}^{t} & {e}^{t}\\end{bmatrix}\\begin{bmatrix