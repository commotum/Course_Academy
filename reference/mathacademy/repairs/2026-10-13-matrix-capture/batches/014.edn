}⁡(4t) \\\\ -4\\operatorname{sin}⁡(4t) & 4\\operatorname{cos}⁡(4t)-2\\operatorname{sin}⁡(4t)\\end{aligned}].\n$$" "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}2 & 5 \\\\ -4 & -2\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2{\\alpha }_{1}t+{\\alpha }_{0} & 5{\\alpha }_{1}t \\\\ -4{\\alpha }_{1}t & -{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix},\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The eigenvalues or $At$ are \n\n$$\n{\\lambda }_{1}=4\\text{i}t,\\,{\\lambda }_{2}=-4\\text{i}t,\n$$\n\nwhich are complex conjugates. Thus, we have the following:\n\n$$\n\\begin{aligned}r(4\\text{i}t) & ={e}^{4\\text{i}t} \\\\ {\\alpha }_{1}\\cdot 4\\text{i}t+{\\alpha }_{0} & =\\operatorname{cos}⁡(4t)+\\text{i}\\operatorname{sin}⁡(4t) \\\\ {\\alpha }_{0}+4{\\alpha }_{1}\\text{i}t & =\\operatorname{cos}⁡(4t)+\\text{i}\\operatorname{sin}⁡(4t).\\end{aligned}\n$$\n\nNow, we equate the real and imaginary parts, and solve for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n$$\n\\begin{aligned}{\\begin{aligned}{\\alpha }_{0}=\\operatorname{cos}⁡(4t) \\\\ 4{\\alpha }_{1}t=\\operatorname{sin}⁡(4t)\\end{aligned}\\,⇒\\,{\\begin{aligned}{\\alpha }_{1}=\\frac{1}{4t}\\operatorname{sin}⁡(4t) \\\\ {\\alpha }_{0}=\\operatorname{cos}⁡(4t)\\end{aligned}\\end{aligned}\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}2{\\alpha }_{1}t+{\\alpha }_{0} & =2\\cdot \\frac{1}{4t}\\operatorname{sin}⁡(4t)\\cdot t+\\operatorname{cos}⁡(4t) \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡(4t)+\\operatorname{cos}⁡(4t) \\\\  & =\\frac{1}{4}(4\\operatorname{cos}⁡(4t)+2\\operatorname{sin}⁡(4t)) \\\\ -{\\alpha }_{1}t+{\\alpha }_{0} & =-\\frac{1}{4t}\\operatorname{sin}⁡(4t)\\cdot t+\\operatorname{cos}⁡(4t) \\\\  & =-\\frac{1}{4}\\operatorname{sin}⁡(4t)+\\operatorname{cos}⁡(4t) \\\\  & =\\frac{1}{4}(4\\operatorname{cos}⁡(4t)-2\\operatorname{sin}⁡(4t))\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}=\\frac{1}{4}\\begin{bmatrix}4\\operatorname{cos}⁡(4t)+2\\operatorname{sin}⁡(4t) & 5\\operatorname{sin}⁡(4t) \\\\ -4\\operatorname{sin}⁡(4t) & 4\\operatorname{cos}⁡(4t)-2\\operatorname{sin}⁡(4t)\\end{bmatrix}.\n$$"] [:db/cas 17592186308659 :question/problem "Find ${e}^{At}$ for $A=[\\begin{aligned}2 & 1 \\\\ -5 & -2\\end{aligned}].$ \n\n*Hint: The eigenvalues of $A$ are $\\pm \\text{i}.$*\n\n| ${e}^{At}=\\,\\,$ |  | $\\operatorname{cos}⁡(t)+2\\operatorname{sin}⁡(t)$ | {{field-1}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-2}} | $\\operatorname{cos}⁡(t)-2\\operatorname{sin}⁡(t)$ |  |  |" "Find ${e}^{At}$ for $A=\\begin{bmatrix}2 & 1 \\\\ -5 & -2\\end{bmatrix}.$ \n\n*Hint: The eigenvalues of $A$ are $\\pm \\text{i}.$*\n\n| ${e}^{At}=\\,\\,$ |  | $\\operatorname{cos}⁡(t)+2\\operatorname{sin}⁡(t)$ | {{field-1}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-2}} | $\\operatorname{cos}⁡(t)-2\\operatorname{sin}⁡(t)$ |  |  |"] [:db/cas 17592186308659 :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}[\\begin{aligned}2 & 1 \\\\ -5 & -2\\end{aligned}]t+{\\alpha }_{0}[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2{\\alpha }_{1}t+{\\alpha }_{0} & {\\alpha }_{1}t \\\\ -5{\\alpha }_{1}t & -2{\\alpha }_{1}t+{\\alpha }_{0}\\end{aligned}],\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The eigenvalues or $At$ are \n\n$$\n{\\lambda }_{1}=\\text{i}t,\\,{\\lambda }_{2}=-\\text{i}t,\n$$\n\nwhich are complex conjugates. Thus, we have the following:\n\n$$\n\\begin{aligned}r(\\text{i}t) & ={e}^{\\text{i}t} \\\\ {\\alpha }_{1}\\cdot \\text{i}t+{\\alpha }_{0} & =\\operatorname{cos}⁡(t)+\\text{i}\\operatorname{sin}⁡(t) \\\\ {\\alpha }_{0}+{\\alpha }_{1}\\text{i}t & =\\operatorname{cos}⁡(t)+\\text{i}\\operatorname{sin}⁡(t).\\end{aligned}\n$$\n\nNow, we equate the real and imaginary parts, and solve for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n$$\n\\begin{aligned}{\\begin{aligned}{\\alpha }_{0}=\\operatorname{cos}⁡(t) \\\\ {\\alpha }_{1}t=\\operatorname{sin}⁡(t)\\end{aligned}\\,⇒\\,{\\begin{aligned}{\\alpha }_{1}=\\frac{1}{t}\\operatorname{sin}⁡(t) \\\\ {\\alpha }_{0}=\\operatorname{cos}⁡(t)\\end{aligned}\\end{aligned}\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}{\\alpha }_{1}t & =\\frac{1}{t}\\operatorname{sin}⁡(t)\\cdot t \\\\  & =\\operatorname{sin}⁡(t) \\\\ -5{\\alpha }_{1}t & =-5\\cdot \\frac{1}{t}\\operatorname{sin}⁡(t)\\cdot t \\\\  & =-5\\operatorname{sin}⁡(t)\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(t)+2\\operatorname{sin}⁡(t) & \\operatorname{sin}⁡(t) \\\\ -5\\operatorname{sin}⁡(t) & \\operatorname{cos}⁡(t)-2\\operatorname{sin}⁡(t)\\end{aligned}].\n$$" "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}2 & 1 \\\\ -5 & -2\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2{\\alpha }_{1}t+{\\alpha }_{0} & {\\alpha }_{1}t \\\\ -5{\\alpha }_{1}t & -2{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix},\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The eigenvalues or $At$ are \n\n$$\n{\\lambda }_{1}=\\text{i}t,\\,{\\lambda }_{2}=-\\text{i}t,\n$$\n\nwhich are complex conjugates. Thus, we have the following:\n\n$$\n\\begin{aligned}r(\\text{i}t) & ={e}^{\\text{i}t} \\\\ {\\alpha }_{1}\\cdot \\text{i}t+{\\alpha }_{0} & =\\operatorname{cos}⁡(t)+\\text{i}\\operatorname{sin}⁡(t) \\\\ {\\alpha }_{0}+{\\alpha }_{1}\\text{i}t & =\\operatorname{cos}⁡(t)+\\text{i}\\operatorname{sin}⁡(t).\\end{aligned}\n$$\n\nNow, we equate the real and imaginary parts, and solve for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n$$\n\\begin{aligned}{\\begin{aligned}{\\alpha }_{0}=\\operatorname{cos}⁡(t) \\\\ {\\alpha }_{1}t=\\operatorname{sin}⁡(t)\\end{aligned}\\,⇒\\,{\\begin{aligned}{\\alpha }_{1}=\\frac{1}{t}\\operatorname{sin}⁡(t) \\\\ {\\alpha }_{0}=\\operatorname{cos}⁡(t)\\end{aligned}\\end{aligned}\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}{\\alpha }_{1}t & =\\frac{1}{t}\\operatorname{sin}⁡(t)\\cdot t \\\\  & =\\operatorname{sin}⁡(t) \\\\ -5{\\alpha }_{1}t & =-5\\cdot \\frac{1}{t}\\operatorname{sin}⁡(t)\\cdot t \\\\  & =-5\\operatorname{sin}⁡(t)\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(t)+2\\operatorname{sin}⁡(t) & \\operatorname{sin}⁡(t) \\\\ -5\\operatorname{sin}⁡(t) & \\operatorname{cos}⁡(t)-2\\operatorname{sin}⁡(t)\\end{bmatrix}.\n$$"] [:db/cas 17592186308660 :question/problem "Find ${e}^{At}$ for $A=[\\begin{aligned}1 & 2 \\\\ -13 & -1\\end{aligned}].$ \n\n*Hint: The eigenvalues of $A$ are $\\pm 5\\text{i}.$*\n\n| ${e}^{At}=\\frac{1}{5}\\,\\,$ |  | $5\\operatorname{cos}⁡(5t)+\\operatorname{sin}⁡(5t)$ | $2\\operatorname{sin}⁡(5t)$ |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-1}} | {{field-2}} |  |  |" "Find ${e}^{At}$ for $A=\\begin{bmatrix}1 & 2 \\\\ -13 & -1\\end{bmatrix}.$ \n\n*Hint: The eigenvalues of $A$ are $\\pm 5\\text{i}.$*\n\n| ${e}^{At}=\\frac{1}{5}\\,\\,$ |  | $5\\operatorname{cos}⁡(5t)+\\operatorname{sin}⁡(5t)$ | $2\\operatorname{sin}⁡(5t)$ |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-1}} | {{field-2}} |  |  |"] [:db/cas 17592186308660 :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}[\\begin{aligned}1 & 2 \\\\ -13 & -1\\end{aligned}]t+{\\alpha }_{0}[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}{\\alpha }_{1}t+{\\alpha }_{0} & 2{\\alpha }_{1}t \\\\ -13{\\alpha }_{1}t & -{\\alpha }_{1}t+{\\alpha }_{0}\\end{aligned}],\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The eigenvalues or $At$ are \n\n$$\n{\\lambda }_{1}=5\\text{i}t,\\,{\\lambda }_{2}=-5\\text{i}t,\n$$\n\nwhich are complex conjugates. Thus, we have the following:\n\n$$\n\\begin{aligned}r(5\\text{i}t) & ={e}^{5\\text{i}t} \\\\ {\\alpha }_{1}\\cdot 5\\text{i}t+{\\alpha }_{0} & =\\operatorname{cos}⁡(5t)+\\text{i}\\operatorname{sin}⁡(5t) \\\\ {\\alpha }_{0}+5{\\alpha }_{1}\\text{i}t & =\\operatorname{cos}⁡(5t)+\\text{i}\\operatorname{sin}⁡(5t).\\end{aligned}\n$$\n\nNow, we equate the real and imaginary parts, and solve for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n$$\n\\begin{aligned}{\\begin{aligned}{\\alpha }_{0}=\\operatorname{cos}⁡(5t) \\\\ 5{\\alpha }_{1}t=\\operatorname{sin}⁡(5t)\\end{aligned}\\,⇒\\,{\\begin{aligned}{\\alpha }_{1}=\\frac{1}{5t}\\operatorname{sin}⁡(5t) \\\\ {\\alpha }_{0}=\\operatorname{cos}⁡(5t)\\end{aligned}\\end{aligned}\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}-13{\\alpha }_{1}t & =-13\\cdot \\frac{1}{5t}\\operatorname{sin}⁡(5t)\\cdot t \\\\  & =-\\frac{13}{5}\\operatorname{sin}⁡(5t) \\\\ -{\\alpha }_{1}t+{\\alpha }_{0} & =-\\frac{1}{5t}\\operatorname{sin}⁡(5t)\\cdot t+\\operatorname{cos}⁡(5t) \\\\  & =-\\frac{1}{5}\\operatorname{sin}⁡(5t)+\\operatorname{cos}⁡(5t) \\\\  & =\\frac{1}{5}(5\\operatorname{cos}⁡(5t)-\\operatorname{sin}⁡(5t))\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}=\\frac{1}{5}[\\begin{aligned}5\\operatorname{cos}⁡(5t)+\\operatorname{sin}⁡(5t) & 2\\operatorname{sin}⁡(5t) \\\\ -13\\operatorname{sin}⁡(5t) & 5\\operatorname{cos}⁡(5t)-\\operatorname{sin}⁡(5t)\\end{aligned}].\n$$" "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}1 & 2 \\\\ -13 & -1\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}{\\alpha }_{1}t+{\\alpha }_{0} & 2{\\alpha }_{1}t \\\\ -13{\\alpha }_{1}t & -{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix},\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The eigenvalues or $At$ are \n\n$$\n{\\lambda }_{1}=5\\text{i}t,\\,{\\lambda }_{2}=-5\\text{i}t,\n$$\n\nwhich are complex conjugates. Thus, we have the following:\n\n$$\n\\begin{aligned}r(5\\text{i}t) & ={e}^{5\\text{i}t} \\\\ {\\alpha }_{1}\\cdot 5\\text{i}t+{\\alpha }_{0} & =\\operatorname{cos}⁡(5t)+\\text{i}\\operatorname{sin}⁡(5t) \\\\ {\\alpha }_{0}+5{\\alpha }_{1}\\text{i}t & =\\operatorname{cos}⁡(5t)+\\text{i}\\operatorname{sin}⁡(5t).\\end{aligned}\n$$\n\nNow, we equate the real and imaginary parts, and solve for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n$$\n\\begin{aligned}{\\begin{aligned}{\\alpha }_{0}=\\operatorname{cos}⁡(5t) \\\\ 5{\\alpha }_{1}t=\\operatorname{sin}⁡(5t)\\end{aligned}\\,⇒\\,{\\begin{aligned}{\\alpha }_{1}=\\frac{1}{5t}\\operatorname{sin}⁡(5t) \\\\ {\\alpha }_{0}=\\operatorname{cos}⁡(5t)\\end{aligned}\\end{aligned}\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}-13{\\alpha }_{1}t & =-13\\cdot \\frac{1}{5t}\\operatorname{sin}⁡(5t)\\cdot t \\\\  & =-\\frac{13}{5}\\operatorname{sin}⁡(5t) \\\\ -{\\alpha }_{1}t+{\\alpha }_{0} & =-\\frac{1}{5t}\\operatorname{sin}⁡(5t)\\cdot t+\\operatorname{cos}⁡(5t) \\\\  & =-\\frac{1}{5}\\operatorname{sin}⁡(5t)+\\operatorname{cos}⁡(5t) \\\\  & =\\frac{1}{5}(5\\operatorname{cos}⁡(5t)-\\operatorname{sin}⁡(5t))\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}=\\frac{1}{5}\\begin{bmatrix}5\\operatorname{cos}⁡(5t)+\\operatorname{sin}⁡(5t) & 2\\operatorname{sin}⁡(5t) \\\\ -13\\operatorname{sin}⁡(5t) & 5\\operatorname{cos}⁡(5t)-\\operatorname{sin}⁡(5t)\\end{bmatrix}.\n$$"] [:db/cas 17592186308661 :question/worked-solution "Since we have a repeated eigenvalue $\\lambda =0$ (of multiplicity two) and only one corresponding eigenvector $v,$ the solution of the system is given by\n\n$$\nx(t)={c}_{1}v{e}^{\\lambda t}+{c}_{2}(vt{e}^{\\lambda t}+w{e}^{\\lambda t}\\,),\n$$\n\nwhere $w$ is a solution to the equation $(A-\\lambda I)w=v.$\n\nIn our case, \n\n$$\n\\lambda =0,\\,v=[\\begin{aligned}1 \\\\ 3\\end{aligned}],\\,w=[\\begin{aligned}-\\frac{1}{3} \\\\ 0\\end{aligned}].\n$$\n\n \nThus, the general solution of the system is\n\n$$\n\\begin{aligned}[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}] & ={c}_{1}[\\begin{aligned}1 \\\\ 3\\end{aligned}]+{c}_{2}([\\begin{aligned}1 \\\\ 3\\end{aligned}]t+[\\begin{aligned}-\\frac{1}{3} \\\\ 0\\end{aligned}]) \\\\  & ={c}_{1}[\\begin{aligned}1 \\\\ 3\\end{aligned}]+{c}_{2}[\\begin{aligned}t-\\frac{1}{3} \\\\ 3t\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nFirst, notice that ${x}_{E}(t)={c}_{1}[\\begin{aligned}1 \\\\ 3\\end{aligned}]$ are equilibrium solutions of the system since ${x}_{E}^{′}(t)=0.$ These solutions form the line with the equation $y=3x$ in the phase space, as shown below.\n\n![](images/3a/3a70188cf5de7e7b64530aa661447b7fa7fc1e918ca3de41088e67274d813b7a.png)\n\nNow, we consider some general solutions of the form \n\n$$\n[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]={c}_{1}[\\begin{aligned}1 \\\\ 3\\end{aligned}]+{c}_{2}[\\begin{aligned}t-\\frac{1}{3} \\\\ 3t\\end{aligned}].\n$$\n\nFor example:\n\n- When ${c}_{1}=1$ and ${c}_{2}=3,$ we get the following curve: \n\n$$\n\\{\\begin{aligned}x=3t \\\\ y=9t+3\\end{aligned}\n$$\n\nLet's add it to the phase space:\n\n![](images/37/37deb5a0fda7ef15a016ec2d73a3b935074b6696184dd480ebe5b858ce517500.png)\n\n- When ${c}_{1}=-1$ and ${c}_{2}=-3,$ we get the following curve: \n\n$$\n\\{\\begin{aligned}x=-3t \\\\ y=-9t-3\\end{aligned}\n$$\n\nLet's add it to the phase space:\n\n![](images/60/60b49680cf94888122f25432586a3546dea206ae960f951afd187444afc8881a.png)\n\nThe phase portrait of our system looks as follows:\n\n![](images/7b/7b4de40b147f1745986476ab0b0cbad22ad0484924f62389c6c19187d5d06245.png)" "Since we have a repeated eigenvalue $\\lambda =0$ (of multiplicity two) and only one corresponding eigenvector $v,$ the solution of the system is given by\n\n$$\nx(t)={c}_{1}v{e}^{\\lambda t}+{c}_{2}(vt{e}^{\\lambda t}+w{e}^{\\lambda t}\\,),\n$$\n\nwhere $w$ is a solution to the equation $(A-\\lambda I)w=v.$\n\nIn our case, \n\n$$\n\\lambda =0,\\,v=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix},\\,w=\\begin{bmatrix}-\\frac{1}{3} \\\\ 0\\end{bmatrix}.\n$$\n\n \nThus, the general solution of the system is\n\n$$\n\\begin{aligned}\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix} & ={c}_{1}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}+{c}_{2}(\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}t+\\begin{bmatrix}-\\frac{1}{3} \\\\ 0\\end{bmatrix}) \\\\  & ={c}_{1}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}+{c}_{2}\\begin{bmatrix}t-\\frac{1}{3} \\\\ 3t\\end{bmatrix},\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nFirst, notice that ${x}_{E}(t)={c}_{1}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}$ are equilibrium solutions of the system since ${x}_{E}^{′}(t)=0.$ These solutions form the line with the equation $y=3x$ in the phase space, as shown below.\n\n![](images/3a/3a70188cf5de7e7b64530aa661447b7fa7fc1e918ca3de41088e67274d813b7a.png)\n\nNow, we consider some general solutions of the form \n\n$$\n\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}={c}_{1}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}+{c}_{2}\\begin{bmatrix}t-\\frac{1}{3} \\\\ 3t\\end{bmatrix}.\n$$\n\nFor example:\n\n- When ${c}_{1}=1$ and ${c}_{2}=3,$ we get the following curve: \n\n$$\n\\{\\begin{aligned}x=3t \\\\ y=9t+3\\end{aligned}\n$$\n\nLet's add it to the phase space:\n\n![](images/37/37deb5a0fda7ef15a016ec2d73a3b935074b6696184dd480ebe5b858ce517500.png)\n\n- When ${c}_{1}=-1$ and ${c}_{2}=-3,$ we get the following curve: \n\n$$\n\\{\\begin{aligned}x=-3t \\\\ y=-9t-3\\end{aligned}\n$$\n\nLet's add it to the phase space:\n\n![](images/60/60b49680cf94888122f25432586a3546dea206ae960f951afd187444afc8881a.png)\n\nThe phase portrait of our system looks as follows:\n\n![](images/7b/7b4de40b147f1745986476ab0b0cbad22ad0484924f62389c6c19187d5d06245.png)"] [:db/cas 17592186308662 :question/worked-solution "Since we have a repeated eigenvalue $\\lambda =0$ (of multiplicity two) and only one corresponding eigenvector $v,$ the solution of the system is given by\n\n$$\nx(t)={c}_{1}v{e}^{\\lambda t}+{c}_{2}(vt{e}^{\\lambda t}+w{e}^{\\lambda t}\\,),\n$$\n\nwhere $w$ is a solution to the equation $(A-\\lambda I)w=v.$\n\nIn our case, \n\n$$\n\\lambda =0,\\,v=[\\begin{aligned}2 \\\\ 1\\end{aligned}],\\,w=[\\begin{aligned}\\frac{1}{2} \\\\ 0\\end{aligned}].\n$$\n\n \nThus, the general solution of the system is\n\n$$\n\\begin{aligned}[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}] & ={c}_{1}[\\begin{aligned}2 \\\\ 1\\end{aligned}]+{c}_{2}([\\begin{aligned}2 \\\\ 1\\end{aligned}]t+[\\begin{aligned}\\frac{1}{2} \\\\ 0\\end{aligned}]) \\\\  & ={c}_{1}[\\begin{aligned}2 \\\\ 1\\end{aligned}]+{c}_{2}[\\begin{aligned}2t+\\frac{1}{2} \\\\ t\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nFirst, notice that ${x}_{E}(t)={c}_{1}[\\begin{aligned}2 \\\\ 1\\end{aligned}]$ are equilibrium solutions of the system since ${x}_{E}^{′}(t)=0.$ These solutions form the line with the equation $y=\\frac{1}{2}x$ in the phase space, as shown below.\n\n![](images/bf/bff5cf9d21f0b01571b577ebe3d98ef08525d13a70a1d7379b537f6ba5319613.png)\n\nNow, we consider some general solutions of the form \n\n$$\n[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]={c}_{1}[\\begin{aligned}2 \\\\ 1\\end{aligned}]+{c}_{2}[\\begin{aligned}2t+\\frac{1}{2} \\\\ t\\end{aligned}].\n$$\n\nFor example:\n\n- When ${c}_{1}=1$ and ${c}_{2}=2,$ we get the following curve: \n\n$$\n{\\begin{aligned}x=4t+3 \\\\ y=2t+1\\end{aligned}\n$$\n\nLet's add it to the phase space:\n\n![](images/7d/7d590ee38f7f1b6b43c9b650890f42fa31b4c15951dab8bcb003b1ac1cc45c39.png)\n\n- When ${c}_{1}=-1$ and ${c}_{2}=-2,$ we get the following curve: \n\n$$\n{\\begin{aligned}x=-4t-3 \\\\ y=-2t-1\\end{aligned}\n$$\n\nLet's add it to the phase space:\n\n![](images/b9/b965e3e244bc49b5e0f52840550c2ae997a0e38dc40e8757f0f51905c448d7af.png)\n\nThe phase portrait of our system looks as follows:\n\n![](images/1b/1b785127a21453e56d7d0df4f641133a44d2109008e21f8bd3057d8ac22a351f.png)" "Since we have a repeated eigenvalue $\\lambda =0$ (of multiplicity two) and only one corresponding eigenvector $v,$ the solution of the system is given by\n\n$$\nx(t)={c}_{1}v{e}^{\\lambda t}+{c}_{2}(vt{e}^{\\lambda t}+w{e}^{\\lambda t}\\,),\n$$\n\nwhere $w$ is a solution to the equation $(A-\\lambda I)w=v.$\n\nIn our case, \n\n$$\n\\lambda =0,\\,v=\\begin{bmatrix}2 \\\\ 1\\end{bmatrix},\\,w=\\begin{bmatrix}\\frac{1}{2} \\\\ 0\\end{bmatrix}.\n$$\n\n \nThus, the general solution of the system is\n\n$$\n\\begin{aligned}\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix} & ={c}_{1}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}+{c}_{2}(\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}t+\\begin{bmatrix}\\frac{1}{2} \\\\ 0\\end{bmatrix}) \\\\  & ={c}_{1}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}+{c}_{2}\\begin{bmatrix}2t+\\frac{1}{2} \\\\ t\\end{bmatrix},\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nFirst, notice that ${x}_{E}(t)={c}_{1}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}$ are equilibrium solutions of the system since ${x}_{E}^{′}(t)=0.$ These solutions form the line with the equation $y=\\frac{1}{2}x$ in the phase space, as shown below.\n\n![](images/bf/bff5cf9d21f0b01571b577ebe3d98ef08525d13a70a1d7379b537f6ba5319613.png)\n\nNow, we consider some general solutions of the form \n\n$$\n\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}={c}_{1}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}+{c}_{2}\\begin{bmatrix}2t+\\frac{1}{2} \\\\ t\\end{bmatrix}.\n$$\n\nFor example:\n\n- When ${c}_{1}=1$ and ${c}_{2}=2,$ we get the following curve: \n\n$$\n{\\begin{aligned}x=4t+3 \\\\ y=2t+1\\end{aligned}\n$$\n\nLet's add it to the phase space:\n\n![](images/7d/7d590ee38f7f1b6b43c9b650890f42fa31b4c15951dab8bcb003b1ac1cc45c39.png)\n\n- When ${c}_{1}=-1$ and ${c}_{2}=-2,$ we get the following curve: \n\n$$\n{\\begin{aligned}x=-4t-3 \\\\ y=-2t-1\\end{aligned}\n$$\n\nLet's add it to the phase space:\n\n![](images/b9/b965e3e244bc49b5e0f52840550c2ae997a0e38dc40e8757f0f51905c448d7af.png)\n\nThe phase portrait of our system looks as follows:\n\n![](images/1b/1b785127a21453e56d7d0df4f641133a44d2109008e21f8bd3057d8ac22a351f.png)"] [:db/cas 17592186308668 :question/problem "Find the shortest distance between the point $P(4,15,-5)$ and the plane $Π$ with equation $(r-[\\begin{aligned}6 \\\\ 9 \\\\ 2\\end{aligned}])\\cdot [\\begin{aligned}-5 \\\\ 1 \\\\ -2\\end{aligned}]=0.$" "Find the shortest distance between the point $P(4,15,-5)$ and the plane $Π$ with equation $(r-\\begin{bmatrix}6 \\\\ 9 \\\\ 2\\end{bmatrix})\\cdot \\begin{bmatrix}-5 \\\\ 1 \\\\ -2\\end{bmatrix}=0.$"] [:db/cas 17592186308668 :question/worked-solution "Let's pick a point on the plane, for instance, $Q(6,9,2).$ Then \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =[\\begin{aligned}6 \\\\ 9 \\\\ 2\\end{aligned}]-[\\begin{aligned}4 \\\\ 15 \\\\ -5\\end{aligned}]=[\\begin{aligned}2 \\\\ -6 \\\\ 7\\end{aligned}].\\end{aligned}\n$$\n\nAlso, from the equation of the plane, we get a normal vector $n=[\\begin{aligned}-5 \\\\ 1 \\\\ -2\\end{aligned}].$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|2\\cdot (-5)+(-6)\\cdot 1+7\\cdot (-2)|}{\\sqrt{(-5)^{2}+{1}^{2}+(-2)^{2}}} \\\\  & =\\frac{|-10-6-14|}{\\sqrt{25+1+4}} \\\\  & =\\frac{|-30|}{\\sqrt{30}} \\\\  & =\\sqrt{30}\\end{aligned}\n$$" "Let's pick a point on the plane, for instance, $Q(6,9,2).$ Then \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =\\begin{bmatrix}6 \\\\ 9 \\\\ 2\\end{bmatrix}-\\begin{bmatrix}4 \\\\ 15 \\\\ -5\\end{bmatrix}=\\begin{bmatrix}2 \\\\ -6 \\\\ 7\\end{bmatrix}.\\end{aligned}\n$$\n\nAlso, from the equation of the plane, we get a normal vector $n=\\begin{bmatrix}-5 \\\\ 1 \\\\ -2\\end{bmatrix}.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|2\\cdot (-5)+(-6)\\cdot 1+7\\cdot (-2)|}{\\sqrt{(-5)^{2}+{1}^{2}+(-2)^{2}}} \\\\  & =\\frac{|-10-6-14|}{\\sqrt{25+1+4}} \\\\  & =\\frac{|-30|}{\\sqrt{30}} \\\\  & =\\sqrt{30}\\end{aligned}\n$$"] [:db/cas 17592186308670 :question/problem "Find ${e}^{At}$ for $A=[\\begin{aligned}6 & -3 \\\\ 3 & 0\\end{aligned}].$ \n\n*Hint: The only eigenvalue of $A$ is $3,$ and it has multiplicity two.*\n\n| ${e}^{At}={e}^{3t}\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | $3t$ | $1-3t$ |  |  |" "Find ${e}^{At}$ for $A=\\begin{bmatrix}6 & -3 \\\\ 3 & 0\\end{bmatrix}.$ \n\n*Hint: The only eigenvalue of $A$ is $3,$ and it has multiplicity two.*\n\n| ${e}^{At}={e}^{3t}\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | $3t$ | $1-3t$ |  |  |"] [:db/cas 17592186308670 :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}[\\begin{aligned}6 & -3 \\\\ 3 & 0\\end{aligned}]t+{\\alpha }_{0}[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}6{\\alpha }_{1}t+{\\alpha }_{0} & -3{\\alpha }_{1}t \\\\ 3{\\alpha }_{1}t & {\\alpha }_{0}\\end{aligned}],\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The only eigenvalue of $At$ is \n\n$$\n{\\lambda }_{1}=3t\n$$\n\nof multiplicity two. Thus, we have the following:\n\n$$\n\\begin{aligned}{\\begin{aligned}r(3t)={e}^{3t} \\\\ \\frac{\\text{d}}{\\text{d}\\lambda }r(3t)={e}^{3t}\\end{aligned}\\,⇒\\,{\\begin{aligned}3t{\\alpha }_{1}+{\\alpha }_{0}={e}^{3t} \\\\ {\\alpha }_{1}={e}^{3t}\\end{aligned}\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- From the second equation, we get\n\n$$\n{\\alpha }_{1}={e}^{3t}.\n$$\n\n- Substituting this into the first one, we get\n\n$$\n3t{e}^{3t}+{\\alpha }_{0}={e}^{3t}\\,⇒\\,{\\alpha }_{0}={e}^{3t}(1-3t).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}6{\\alpha }_{1}t+{\\alpha }_{0} & =6{e}^{3t}t+{e}^{3t}(1-3t) \\\\  & ={e}^{3t}(1+3t), \\\\ -3{\\alpha }_{1}t & =-3{e}^{3t}t\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{3t}[\\begin{aligned}1+3t & -3t \\\\ 3t & 1-3t\\end{aligned}].\n$$" "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}6 & -3 \\\\ 3 & 0\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}6{\\alpha }_{1}t+{\\alpha }_{0} & -3{\\alpha }_{1}t \\\\ 3{\\alpha }_{1}t & {\\alpha }_{0}\\end{bmatrix},\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The only eigenvalue of $At$ is \n\n$$\n{\\lambda }_{1}=3t\n$$\n\nof multiplicity two. Thus, we have the following:\n\n$$\n\\begin{aligned}{\\begin{aligned}r(3t)={e}^{3t} \\\\ \\frac{\\text{d}}{\\text{d}\\lambda }r(3t)={e}^{3t}\\end{aligned}\\,⇒\\,{\\begin{aligned}3t{\\alpha }_{1}+{\\alpha }_{0}={e}^{3t} \\\\ {\\alpha }_{1}={e}^{3t}\\end{aligned}\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- From the second equation, we get\n\n$$\n{\\alpha }_{1}={e}^{3t}.\n$$\n\n- Substituting this into the first one, we get\n\n$$\n3t{e}^{3t}+{\\alpha }_{0}={e}^{3t}\\,⇒\\,{\\alpha }_{0}={e}^{3t}(1-3t).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}6{\\alpha }_{1}t+{\\alpha }_{0} & =6{e}^{3t}t+{e}^{3t}(1-3t) \\\\  & ={e}^{3t}(1+3t), \\\\ -3{\\alpha }_{1}t & =-3{e}^{3t}t\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{3t}\\begin{bmatrix}1+3t & -3t \\\\ 3t & 1-3t\\end{bmatrix}.\n$$"] [:db/cas 17592186308671 :question/problem "Find ${e}^{At}$ for $A=[\\begin{aligned}-2 & 1 \\\\ -9 & 4\\end{aligned}].$ \n\n*Hint: The only eigenvalue of $A$ is $1,$ and it has multiplicity two.*\n\n| ${e}^{At}={e}^{t}\\,\\,$ |  | $1-3t$ | $t$ |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-1}} | {{field-2}} |  |  |" "Find ${e}^{At}$ for $A=\\begin{bmatrix}-2 & 1 \\\\ -9 & 4\\end{bmatrix}.$ \n\n*Hint: The only eigenvalue of $A$ is $1,$ and it has multiplicity two.*\n\n| ${e}^{At}={e}^{t}\\,\\,$ |  | $1-3t$ | $t$ |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-1}} | {{field-2}} |  |  |"] [:db/cas 17592186308671 :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}[\\begin{aligned}-2 & 1 \\\\ -9 & 4\\end{aligned}]t+{\\alpha }_{0}[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-2{\\alpha }_{1}t+{\\alpha }_{0} & {\\alpha }_{1}t \\\\ -9{\\alpha }_{1}t & 4{\\alpha }_{1}t+{\\alpha }_{0}\\end{aligned}].\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The only eigenvalue of $At$ is \n\n$$\n{\\lambda }_{1}=t\n$$\n\nof multiplicity two. Thus, we have the following:\n\n$$\n\\begin{aligned}{\\begin{aligned}r(t)={e}^{t} \\\\ \\frac{\\text{d}}{\\text{d}\\lambda }r(t)={e}^{t}\\end{aligned}\\,⇒\\,{\\begin{aligned}t{\\alpha }_{1}+{\\alpha }_{0}={e}^{t} \\\\ {\\alpha }_{1}={e}^{t}\\end{aligned}\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- From the second equation, we get\n\n$$\n{\\alpha }_{1}={e}^{t}.\n$$\n\n- Substituting this into the first one, we get\n\n$$\nt{e}^{t}+{\\alpha }_{0}={e}^{t}\\,⇒\\,{\\alpha }_{0}={e}^{t}(1-t).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}-9{\\alpha }_{1}t & =-9{e}^{t}t \\\\ 4{\\alpha }_{1}t+{\\alpha }_{0} & =4{e}^{t}t+{e}^{t}(1-t) \\\\  & ={e}^{t}(1+3t)\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{t}[\\begin{aligned}1-3t & t \\\\ -9t & 1+3t\\end{aligned}].\n$$" "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}-2 & 1 \\\\ -9 & 4\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2{\\alpha }_{1}t+{\\alpha }_{0} & {\\alpha }_{1}t \\\\ -9{\\alpha }_{1}t & 4{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix}.\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The only eigenvalue of $At$ is \n\n$$\n{\\lambda }_{1}=t\n$$\n\nof multiplicity two. Thus, we have the following:\n\n$$\n\\begin{aligned}{\\begin{aligned}r(t)={e}^{t} \\\\ \\frac{\\text{d}}{\\text{d}\\lambda }r(t)={e}^{t}\\end{aligned}\\,⇒\\,{\\begin{aligned}t{\\alpha }_{1}+{\\alpha }_{0}={e}^{t} \\\\ {\\alpha }_{1}={e}^{t}\\end{aligned}\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- From the second equation, we get\n\n$$\n{\\alpha }_{1}={e}^{t}.\n$$\n\n- Substituting this into the first one, we get\n\n$$\nt{e}^{t}+{\\alpha }_{0}={e}^{t}\\,⇒\\,{\\alpha }_{0}={e}^{t}(1-t).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}-9{\\alpha }_{1}t & =-9{e}^{t}t \\\\ 4{\\alpha }_{1}t+{\\alpha }_{0} & =4{e}^{t}t+{e}^{t}(1-t) \\\\  & ={e}^{t}(1+3t)\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{t}\\begin{bmatrix}1-3t & t \\\\ -9t & 1+3t\\end{bmatrix}.\n$$"] [:db/cas 17592186308672 :question/problem "Find ${e}^{At}$ for $A=[\\begin{aligned}8 & -3 \\\\ 12 & -4\\end{aligned}].$ \n\n*Hint: The only eigenvalue of $A$ is $2,$ and it has multiplicity two.*\n\n| ${e}^{At}={e}^{2t}\\,\\,$ |  | {{field-1}} | $-3t$ |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-2}} | $1-6t$ |  |  |" "Find ${e}^{At}$ for $A=\\begin{bmatrix}8 & -3 \\\\ 12 & -4\\end{bmatrix}.$ \n\n*Hint: The only eigenvalue of $A$ is $2,$ and it has multiplicity two.*\n\n| ${e}^{At}={e}^{2t}\\,\\,$ |  | {{field-1}} | $-3t$ |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-2}} | $1-6t$ |  |  |"] [:db/cas 17592186308672 :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}[\\begin{aligned}8 & -3 \\\\ 12 & -4\\end{aligned}]t+{\\alpha }_{0}[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}8{\\alpha }_{1}t+{\\alpha }_{0} & -3{\\alpha }_{1}t \\\\ 12{\\alpha }_{1}t & -4{\\alpha }_{1}t+{\\alpha }_{0}\\end{aligned}].\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The only eigenvalue of $At$ is \n\n$$\n{\\lambda }_{1}=2t\n$$\n\nof multiplicity two. Thus, we have the following:\n\n$$\n\\begin{aligned}{\\begin{aligned}r(2t)={e}^{2t} \\\\ \\frac{\\text{d}}{\\text{d}\\lambda }r(2t)={e}^{2t}\\end{aligned}\\,⇒\\,{\\begin{aligned}2t{\\alpha }_{1}+{\\alpha }_{0}={e}^{2t} \\\\ {\\alpha }_{1}={e}^{2t}\\end{aligned}\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- From the second equation, we get\n\n$$\n{\\alpha }_{1}={e}^{2t}.\n$$\n\n- Substituting this into the first one, we get\n\n$$\n2t{e}^{2t}+{\\alpha }_{0}={e}^{2t}\\,⇒\\,{\\alpha }_{0}={e}^{2t}(1-2t).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}8{\\alpha }_{1}t+{\\alpha }_{0} & =8{e}^{2t}t+{e}^{2t}(1-2t) \\\\  & ={e}^{2t}(1+6t) \\\\ 12{\\alpha }_{1}t & =12{e}^{2t}t\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{2t}[\\begin{aligned}1+6t & -3t \\\\ 12t & 1-6t\\end{aligned}].\n$$" "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}8 & -3 \\\\ 12 & -4\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}8{\\alpha }_{1}t+{\\alpha }_{0} & -3{\\alpha }_{1}t \\\\ 12{\\alpha }_{1}t & -4{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix}.\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The only eigenvalue of $At$ is \n\n$$\n{\\lambda }_{1}=2t\n$$\n\nof multiplicity two. Thus, we have the following:\n\n$$\n\\begin{aligned}{\\begin{aligned}r(2t)={e}^{2t} \\\\ \\frac{\\text{d}}{\\text{d}\\lambda }r(2t)={e}^{2t}\\end{aligned}\\,⇒\\,{\\begin{aligned}2t{\\alpha }_{1}+{\\alpha }_{0}={e}^{2t} \\\\ {\\alpha }_{1}={e}^{2t}\\end{aligned}\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- From the second equation, we get\n\n$$\n{\\alpha }_{1}={e}^{2t}.\n$$\n\n- Substituting this into the first one, we get\n\n$$\n2t{e}^{2t}+{\\alpha }_{0}={e}^{2t}\\,⇒\\,{\\alpha }_{0}={e}^{2t}(1-2t).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}8{\\alpha }_{1}t+{\\alpha }_{0} & =8{e}^{2t}t+{e}^{2t}(1-2t) \\\\  & ={e}^{2t}(1+6t) \\\\ 12{\\alpha }_{1}t & =12{e}^{2t}t\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{2t}\\begin{bmatrix}1+6t & -3t \\\\ 12t & 1-6t\\end{bmatrix}.\n$$"] [:db/cas 17592186308673 :question/problem "Find ${e}^{At}$ for $A=[\\begin{aligned}7 & 1 \\\\ -1 & 5\\end{aligned}].$ \n\n*Hint: The only eigenvalue of $A$ is $6,$ and it has multiplicity two.*\n\n| ${e}^{At}={e}^{6t}\\,\\,$ |  | $1+t$ | $t$ |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-1}} | {{field-2}} |  |  |" "Find ${e}^{At}$ for $A=\\begin{bmatrix}7 & 1 \\\\ -1 & 5\\end{bmatrix}.$ \n\n*Hint: The only eigenvalue of $A$ is $6,$ and it has multiplicity two.*\n\n| ${e}^{At}={e}^{6t}\\,\\,$ |  | $1+t$ | $t$ |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-1}} | {{field-2}} |  |  |"] [:db/cas 17592186308673 :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}[\\begin{aligned}7 & 1 \\\\ -1 & 5\\end{aligned}]t+{\\alpha }_{0}[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}7{\\alpha }_{1}t+{\\alpha }_{0} & {\\alpha }_{1}t \\\\ -{\\alpha }_{1}t & 5{\\alpha }_{1}t+{\\alpha }_{0}\\end{aligned}],\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The only eigenvalue of $At$ is \n\n$$\n{\\lambda }_{1}=6t\n$$\n\nof multiplicity two. Thus, we have the following:\n\n$$\n\\begin{aligned}{\\begin{aligned}r(6t)={e}^{6t} \\\\ \\frac{\\text{d}}{\\text{d}\\lambda }r(6t)={e}^{6t}\\end{aligned}\\,⇒\\,{\\begin{aligned}6t{\\alpha }_{1}+{\\alpha }_{0}={e}^{6t} \\\\ {\\alpha }_{1}={e}^{6t}\\end{aligned}\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- From the second equation, we get\n\n$$\n{\\alpha }_{1}={e}^{6t}.\n$$\n\n- Substituting this into the first one, we get\n\n$$\n6t{e}^{6t}+{\\alpha }_{0}={e}^{6t}\\,⇒\\,{\\alpha }_{0}={e}^{6t}(1-6t).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}-{\\alpha }_{1}t & =-{e}^{6t}t \\\\  & ={e}^{6t}(-t), \\\\ 5{\\alpha }_{1}t+{\\alpha }_{0} & =5{e}^{6t}t+{e}^{6t}(1-6t) \\\\  & ={e}^{6t}(1-t)\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{6t}[\\begin{aligned}1+t & t \\\\ -t & 1-t\\end{aligned}].\n$$" "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}7 & 1 \\\\ -1 & 5\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}7{\\alpha }_{1}t+{\\alpha }_{0} & {\\alpha }_{1}t \\\\ -{\\alpha }_{1}t & 5{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix},\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The only eigenvalue of $At$ is \n\n$$\n{\\lambda }_{1}=6t\n$$\n\nof multiplicity two. Thus, we have the following:\n\n$$\n\\begin{aligned}{\\begin{aligned}r(6t)={e}^{6t} \\\\ \\frac{\\text{d}}{\\text{d}\\lambda }r(6t)={e}^{6t}\\end{aligned}\\,⇒\\,{\\begin{aligned}6t{\\alpha }_{1}+{\\alpha }_{0}={e}^{6t} \\\\ {\\alpha }_{1}={e}^{6t}\\end{aligned}\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- From the second equation, we get\n\n$$\n{\\alpha }_{1}={e}^{6t}.\n$$\n\n- Substituting this into the first one, we get\n\n$$\n6t{e}^{6t}+{\\alpha }_{0}={e}^{6t}\\,⇒\\,{\\alpha }_{0}={e}^{6t}(1-6t).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}-{\\alpha }_{1}t & =-{e}^{6t}t \\\\  & ={e}^{6t}(-t), \\\\ 5{\\alpha }_{1}t+{\\alpha }_{0} & =5{e}^{6t}t+{e}^{6t}(1-6t) \\\\  & ={e}^{6t}(1-t)\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{6t}\\begin{bmatrix}1+t & t \\\\ -t & 1-t\\end{bmatrix}.\n$$"] [:db/cas 17592186308674 :question/problem "Find ${e}^{At}$ for $A=[\\begin{aligned}7 & -2 \\\\ 8 & -1\\end{aligned}].$ \n\n*Hint: The only eigenvalue of $A$ is $3,$ and it has multiplicity two.*\n\n| ${e}^{At}={e}^{3t}\\,\\,$ |  | $1+4t$ | {{field-1}} |  |\n| --- | --- | --- | --- | --- |\n|  | $8t$ | {{field-2}} |  |  |" "Find ${e}^{At}$ for $A=\\begin{bmatrix}7 & -2 \\\\ 8 & -1\\end{bmatrix}.$ \n\n*Hint: The only eigenvalue of $A$ is $3,$ and it has multiplicity two.*\n\n| ${e}^{At}={e}^{3t}\\,\\,$ |  | $1+4t$ | {{field-1}} |  |\n| --- | --- | --- | --- | --- |\n|  | $8t$ | {{field-2}} |  |  |"] [:db/cas 17592186308674 :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}[\\begin{aligned}7 & -2 \\\\ 8 & -1\\end{aligned}]t+{\\alpha }_{0}[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}7{\\alpha }_{1}t+{\\alpha }_{0} & -2{\\alpha }_{1}t \\\\ 8{\\alpha }_{1}t & -{\\alpha }_{1}t+{\\alpha }_{0}\\end{aligned}].\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The only eigenvalue of $At$ is \n\n$$\n{\\lambda }_{1}=3t\n$$\n\nof multiplicity two. Thus, we have the following:\n\n$$\n\\begin{aligned}{\\begin{aligned}r(3t)={e}^{3t} \\\\ \\frac{\\text{d}}{\\text{d}\\lambda }r(3t)={e}^{3t}\\end{aligned}\\,⇒\\,{\\begin{aligned}3t{\\alpha }_{1}+{\\alpha }_{0}={e}^{3t} \\\\ {\\alpha }_{1}={e}^{3t}\\end{aligned}\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- From the second equation, we get\n\n$$\n{\\alpha }_{1}={e}^{3t}.\n$$\n\n- Substituting this into the first one, we get\n\n$$\n3t{e}^{3t}+{\\alpha }_{0}={e}^{3t}\\,⇒\\,{\\alpha }_{0}={e}^{3t}(1-3t).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}-2{\\alpha }_{1}t & =-2{e}^{3t}t \\\\  & ={e}^{3t}(-2t) \\\\ -{\\alpha }_{1}t+{\\alpha }_{0} & =-{e}^{3t}t+{e}^{3t}(1-3t) \\\\  & ={e}^{3t}(1-4t)\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{3t}[\\begin{aligned}1+4t & -2t \\\\ 8t & 1-4t\\end{aligned}].\n$$" "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}7 & -2 \\\\ 8 & -1\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}7{\\alpha }_{1}t+{\\alpha }_{0} & -2{\\alpha }_{1}t \\\\ 8{\\alpha }_{1}t & -{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix}.\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The only eigenvalue of $At$ is \n\n$$\n{\\lambda }_{1}=3t\n$$\n\nof multiplicity two. Thus, we have the following:\n\n$$\n\\begin{aligned}{\\begin{aligned}r(3t)={e}^{3t} \\\\ \\frac{\\text{d}}{\\text{d}\\lambda }r(3t)={e}^{3t}\\end{aligned}\\,⇒\\,{\\begin{aligned}3t{\\alpha }_{1}+{\\alpha }_{0}={e}^{3t} \\\\ {\\alpha }_{1}={e}^{3t}\\end{aligned}\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- From the second equation, we get\n\n$$\n{\\alpha }_{1}={e}^{3t}.\n$$\n\n- Substituting this into the first one, we get\n\n$$\n3t{e}^{3t}+{\\alpha }_{0}={e}^{3t}\\,⇒\\,{\\alpha }_{0}={e}^{3t}(1-3t).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}-2{\\alpha }_{1}t & =-2{e}^{3t}t \\\\  & ={e}^{3t}(-2t) \\\\ -{\\alpha }_{1}t+{\\alpha }_{0} & =-{e}^{3t}t+{e}^{3t}(1-3t) \\\\  & ={e}^{3t}(1-4t)\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{3t}\\begin{bmatrix}1+4t & -2t \\\\ 8t & 1-4t\\end{bmatrix}.\n$$"] [:db/cas 17592186308675 :question/problem "Find ${e}^{At}$ for $A=[\\begin{aligned}6 & -5 \\\\ 5 & -4\\end{aligned}].$ \n\n*Hint: The only eigenvalue of $A$ is $1,$ and it has multiplicity two.*\n\n| ${e}^{At}={e}^{t}\\,\\,$ |  | {{field-1}} | $-5t$ |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-2}} | $1-5t$ |  |  |" "Find ${e}^{At}$ for $A=\\begin{bmatrix}6 & -5 \\\\ 5 & -4\\end{bmatrix}.$ \n\n*Hint: The only eigenvalue of $A$ is $1,$ and it has multiplicity two.*\n\n| ${e}^{At}={e}^{t}\\,\\,$ |  | {{field-1}} | $-5t$ |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-2}} | $1-5t$ |  |  |"] [:db/cas 17592186308675 :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}[\\begin{aligned}6 & -5 \\\\ 5 & -4\\end{aligned}]t+{\\alpha }_{0}[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}6{\\alpha }_{1}t+{\\alpha }_{0} & -5{\\alpha }_{1}t \\\\ 5{\\alpha }_{1}t & -4{\\alpha }_{1}t+{\\alpha }_{0}\\end{aligned}].\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The only eigenvalue of $At$ is \n\n$$\n{\\lambda }_{1}=t\n$$\n\nof multiplicity two. Thus, we have the following:\n\n$$\n\\begin{aligned}{\\begin{aligned}r(t)={e}^{t} \\\\ \\frac{\\text{d}}{\\text{d}\\lambda }r(t)={e}^{t}\\end{aligned}\\,⇒\\,{\\begin{aligned}t{\\alpha }_{1}+{\\alpha }_{0}={e}^{t} \\\\ {\\alpha }_{1}={e}^{t}\\end{aligned}\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- From the second equation, we get\n\n$$\n{\\alpha }_{1}={e}^{t}.\n$$\n\n- Substituting this into the first one, we get\n\n$$\nt{e}^{t}+{\\alpha }_{0}={e}^{t}\\,⇒\\,{\\alpha }_{0}={e}^{t}(1-t).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}6{\\alpha }_{1}t+{\\alpha }_{0} & =6{e}^{t}t+{e}^{t}(1-t) \\\\  & ={e}^{t}(1+5t) \\\\ 5{\\alpha }_{1}t & =5{e}^{t}t \\\\  & ={e}^{t}(5t)\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{t}[\\begin{aligned}1+5t & -5t \\\\ 5t & 1-5t\\end{aligned}].\n$$" "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}\\begin{bmatrix}6 & -5 \\\\ 5 & -4\\end{bmatrix}t+{\\alpha }_{0}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}6{\\alpha }_{1}t+{\\alpha }_{0} & -5{\\alpha }_{1}t \\\\ 5{\\alpha }_{1}t & -4{\\alpha }_{1}t+{\\alpha }_{0}\\end{bmatrix}.\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The only eigenvalue of $At$ is \n\n$$\n{\\lambda }_{1}=t\n$$\n\nof multiplicity two. Thus, we have the following:\n\n$$\n\\begin{aligned}{\\begin{aligned}r(t)={e}^{t} \\\\ \\frac{\\text{d}}{\\text{d}\\lambda }r(t)={e}^{t}\\end{aligned}\\,⇒\\,{\\begin{aligned}t{\\alpha }_{1}+{\\alpha }_{0}={e}^{t} \\\\ {\\alpha }_{1}={e}^{t}\\end{aligned}\\end{aligned}\n$$\n\nNow, we solve the system for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n- From the second equation, we get\n\n$$\n{\\alpha }_{1}={e}^{t}.\n$$\n\n- Substituting this into the first one, we get\n\n$$\nt{e}^{t}+{\\alpha }_{0}={e}^{t}\\,⇒\\,{\\alpha }_{0}={e}^{t}(1-t).\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}6{\\alpha }_{1}t+{\\alpha }_{0} & =6{e}^{t}t+{e}^{t}(1-t) \\\\  & ={e}^{t}(1+5t) \\\\ 5{\\alpha }_{1}t & =5{e}^{t}t \\\\  & ={e}^{t}(5t)\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{t}\\begin{bmatrix}1+5t & -5t \\\\ 5t & 1-5t\\end{bmatrix}.\n$$"] [:db/cas 17592186308684 :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=6x(t)+y(t) \\\\ {y}^{′}(t)=6y(t)\\end{aligned}\n$$\n\nWhich of the following gives the general solution to the system of ODEs above?\n\n*Hint: ${e}^{At}=[\\begin{aligned}{e}^{6t} & t{e}^{6t} \\\\ 0 & {e}^{6t}\\end{aligned}],$ where $A=[\\begin{aligned}6 & 1 \\\\ 0 & 6\\end{aligned}].$*" "$$\n\\{\\begin{aligned}{x}^{′}(t)=6x(t)+y(t) \\\\ {y}^{′}(t)=6y(t)\\end{aligned}\n$$\n\nWhich of the following gives the general solution to the system of ODEs above?\n\n*Hint: ${e}^{At}=\\begin{bmatrix}{e}^{6t} & t{e}^{6t} \\\\ 0 & {e}^{6t}\\end{bmatrix},$ where $A=\\begin{bmatrix}6 & 1 \\\\ 0 & 6\\end{bmatrix}.$*"] [:db/cas 17592186308684 :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}6 & 1 \\\\ 0 & 6\\end{aligned}]x(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}6 & 1 \\\\ 0 & 6\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the general solution of the system can be written as\n\n$$\nx(t)=Φ(t)\\,c,\n$$\n\nwhere $Φ(t)$ is a fundamental matrix of the system, and $c$ is a constant vector.\n\nNow, using the given information, the standard fundamental matrix ${Φ}_{0}(t)$ of the system is given by\n\n$$\n{Φ}_{0}(t)={e}^{At}=[\\begin{aligned}{e}^{6t} & t{e}^{6t} \\\\ 0 & {e}^{6t}\\end{aligned}].\n$$\n\nTherefore, the general solution is\n\n$$\n\\begin{aligned}x(t) & ={Φ}_{0}(t)\\,c \\\\  & ={e}^{At}\\,c \\\\  & =[\\begin{aligned}{e}^{6t} & t{e}^{6t} \\\\ 0 & {e}^{6t}\\end{aligned}][\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}] \\\\  & ={c}_{1}[\\begin{aligned}{e}^{6t} \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}t{e}^{6t} \\\\ {e}^{6t}\\end{aligned}] \\\\  & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{6t}+{c}_{2}[\\begin{aligned}t \\\\ 1\\end{aligned}]{e}^{6t},\\end{aligned}\n$$\n\nwhere ${c}_{1},{c}_{2}\\in R.$" "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}6 & 1 \\\\ 0 & 6\\end{bmatrix}x(t),\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}.$ So, the matrix of the system is $A=\\begin{bmatrix}6 & 1 \\\\ 0 & 6\\end{bmatrix}.$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the general solution of the system can be written as\n\n$$\nx(t)=Φ(t)\\,c,\n$$\n\nwhere $Φ(t)$ is a fundamental matrix of the system, and $c$ is a constant vector.\n\nNow, using the given information, the standard fundamental matrix ${Φ}_{0}(t)$ of the system is given by\n\n$$\n{Φ}_{0}(t)={e}^{At}=\\begin{bmatrix}{e}^{6t} & t{e}^{6t} \\\\ 0 & {e}^{6t}\\end{bmatrix}.\n$$\n\nTherefore, the general solution is\n\n$$\n\\begin{aligned}x(t) & ={Φ}_{0}(t)\\,c \\\\  & ={e}^{At}\\,c \\\\  & =\\begin{bmatrix}{e}^{6t} & t{e}^{6t} \\\\ 0 & {e}^{6t}\\end{bmatrix}\\begin{bmatrix}{c}_{1} \\\\ {c}_{2}\\end{bmatrix} \\\\  & ={c}_{1}\\begin{bmatrix}{e}^{6t} \\\\ 0\\end{bmatrix}+{c}_{2}\\begin{bmatrix}t{e}^{6t} \\\\ {e}^{6t}\\end{bmatrix} \\\\  & ={c}_{1}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}{e}^{6t}+{c}_{2}\\begin{bmatrix}t \\\\ 1\\end{bmatrix}{e}^{6t},\\end{aligned}\n$$\n\nwhere ${c}_{1},{c}_{2}\\in R.$"] [:db/cas 17592186308685 :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=-5x(t)+y(t) \\\\ {y}^{′}(t)=-5y(t)\\end{aligned}\n$$\n\nWhich of the following gives the general solution to the system of ODEs above?\n\n*Hint: ${e}^{At}=[\\begin{aligned}{e}^{-5t} & t{e}^{-5t} \\\\ 0 & {e}^{-5t}\\end{aligned}],$ where $A=[\\begin{aligned}-5 & 1 \\\\ 0 & -5\\end{aligned}].$*" "$$\n{\\begin{aligned}{x}^{′}(t)=-5x(t)+y(t) \\\\ {y}^{′}(t)=-5y(t)\\end{aligned}\n$$\n\nWhich of the following gives the general solution to the system of ODEs above?\n\n*Hint: ${e}^{At}=\\begin{bmatrix}{e}^{-5t} & t{e}^{-5t} \\\\ 0 & {e}^{-5t}\\end{bmatrix},$ where $A=\\begin{bmatrix}-5 & 1 \\\\ 0 & -5\\end{bmatrix}.$*"] [:db/cas 17592186308685 :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}-5 & 1 \\\\ 0 & -5\\end{aligned}]x(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}-5 & 1 \\\\ 0 & -5\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the general solution of the system can be written as\n\n$$\nx(t)=Φ(t)\\,c,\n$$\n\nwhere $Φ(t)$ is a fundamental matrix of the system, and $c$ is a constant vector.\n\nNow, using the given information, the standard fundamental matrix ${Φ}_{0}(t)$ of the system is given by\n\n$$\n{Φ}_{0}(t)={e}^{At}=[\\begin{aligned}{e}^{-5t} & t{e}^{-5t} \\\\ 0 & {e}^{-5t}\\end{aligned}].\n$$\n\nTherefore, the general solution is\n\n$$\n\\begin{aligned}x(t) & ={Φ}_{0}(t)\\,c \\\\  & ={e}^{At}\\,c \\\\  & =[\\begin{aligned}{e}^{-5t} & t{e}^{-5t} \\\\ 0 & {e}^{-5t}\\end{aligned}][\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}] \\\\  & ={c}_{1}[\\begin{aligned}{e}^{-5t} \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}t{e}^{-5t} \\\\ {e}^{-5t}\\end{aligned}] \\\\  & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-5t}+{c}_{2}[\\begin{aligned}t \\\\ 1\\end{aligned}]{e}^{-5t},\\end{aligned}\n$$\n\nwhere ${c}_{1},{c}_{2}\\in R.$" "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}-5 & 1 \\\\ 0 & -5\\end{bmatrix}x(t),\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}.$ So, the matrix of the system is $A=\\begin{bmatrix}-5 & 1 \\\\ 0 & -5\\end{bmatrix}.$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the general solution of the system can be written as\n\n$$\nx(t)=Φ(t)\\,c,\n$$\n\nwhere $Φ(t)$ is a fundamental matrix of the system, and $c$ is a constant vector.\n\nNow, using the given information, the standard fundamental matrix ${Φ}_{0}(t)$ of the system is given by\n\n$$\n{Φ}_{0}(t)={e}^{At}=\\begin{bmatrix}{e}^{-5t} & t{e}^{-5t} \\\\ 0 & {e}^{-5t}\\end{bmatrix}.\n$$\n\nTherefore, the general solution is\n\n$$\n\\begin{aligned}x(t) & ={Φ}_{0}(t)\\,c \\\\  & ={e}^{At}\\,c \\\\  & =\\begin{bmatrix}{e}^{-5t} & t{e}^{-5t} \\\\ 0 & {e}^{-5t}\\end{bmatrix}\\begin{bmatrix}{c}_{1} \\\\ {c}_{2}\\end{bmatrix} \\\\  & ={c}_{1}\\begin{bmatrix}{e}^{-5t} \\\\ 0\\end{bmatrix}+{c}_{2}\\begin{bmatrix}t{e}^{-5t} \\\\ {e}^{-5t}\\end{bmatrix} \\\\  & ={c}_{1}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}{e}^{-5t}+{c}_{2}\\begin{bmatrix}t \\\\ 1\\end{bmatrix}{e}^{-5t},\\end{aligned}\n$$\n\nwhere ${c}_{1},{c}_{2}\\in R.$"] [:db/cas 17592186308688 :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}3 & 1 \\\\ 0 & 3\\end{aligned}]x+[\\begin{aligned}0 \\\\ {e}^{3t}\\end{aligned}],\\,x(0)=[\\begin{aligned}1 \\\\ 0\\end{aligned}]\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}{e}^{3t} & t{e}^{3t} \\\\ 0 & {e}^{3t}\\end{aligned}],$ where $A=[\\begin{aligned}3 & 1 \\\\ 0 & 3\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,+{\\int }_{0}^{t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">$(t-s){e}^{3t}$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,\\text{d}s$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\"></td>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" "$$\n{x}^{′}(t)=\\begin{bmatrix}3 & 1 \\\\ 0 & 3\\end{bmatrix}x+\\begin{bmatrix}0 \\\\ {e}^{3t}\\end{bmatrix},\\,x(0)=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}{e}^{3t} & t{e}^{3t} \\\\ 0 & {e}^{3t}\\end{bmatrix},$ where $A=\\begin{bmatrix}3 & 1 \\\\ 0 & 3\\end{bmatrix}.$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,+{\\int }_{0}^{t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">$(t-s){e}^{3t}$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,\\text{d}s$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\"></td>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>"] [:db/cas 17592186308688 :question/worked-solution "Given the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that ${e}^{At}=[\\begin{aligned}{e}^{3t} & t{e}^{3t} \\\\ 0 & {e}^{3t}\\end{aligned}].$ So,\n\n$$\n\\begin{aligned}{e}^{At}\\,x(0) & =[\\begin{aligned}{e}^{3t} & t{e}^{3t} \\\\ 0 & {e}^{3t}\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{3t} \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}{e}^{3(t-s)} & (t-s){e}^{3(t-s)} \\\\ 0 & {e}^{3(t-s)}\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}{e}^{3(t-s)} & (t-s){e}^{3(t-s)} \\\\ 0 & {e}^{3(t-s)}\\end{aligned}][\\begin{aligned}0 \\\\ {e}^{3s}\\end{aligned}] \\\\  & =[\\begin{aligned}(t-s){e}^{3t} \\\\ {e}^{3t}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}{e}^{3t} \\\\ 0\\end{aligned}]+{\\int }_{0}^{t}[\\begin{aligned}(t-s){e}^{3t} \\\\ {e}^{3t}\\end{aligned}]\\text{d}s.\\end{aligned}\n$$" "Given the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that ${e}^{At}=\\begin{bmatrix}{e}^{3t} & t{e}^{3t} \\\\ 0 & {e}^{3t}\\end{bmatrix}.$ So,\n\n$$\n\\begin{aligned}{e}^{At}\\,x(0) & =\\begin{bmatrix}{e}^{3t} & t{e}^{3t} \\\\ 0 & {e}^{3t}\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}{e}^{3t} \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=\\begin{bmatrix}{e}^{3(t-s)} & (t-s){e}^{3(t-s)} \\\\ 0 & {e}^{3(t-s)}\\end{bmatrix}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =\\begin{bmatrix}{e}^{3(t-s)} & (t-s){e}^{3(t-s)} \\\\ 0 & {e}^{3(t-s)}\\end{bmatrix}\\begin{bmatrix}0 \\\\ {e}^{3s}\\end{bmatrix} \\\\  & =\\begin{bmatrix}(t-s){e}^{3t} \\\\ {e}^{3t}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =\\begin{bmatrix}{e}^{3t} \\\\ 0\\end{bmatrix}+{\\int }_{0}^{t}\\begin{bmatrix}(t-s){e}^{3t} \\\\ {e}^{3t}\\end{bmatrix}\\text{d}s.\\end{aligned}\n$$"] [:db/cas 17592186308692 :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}5 & 1 \\\\ 0 & 5\\end{aligned}]x+[\\begin{aligned}{e}^{5t} \\\\ 0\\end{aligned}],\\,x(1)=[\\begin{aligned}2 \\\\ 0\\end{aligned}]\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}{e}^{5t} & t{e}^{5t} \\\\ 0 & {e}^{5t}\\end{aligned}],$ where $A=[\\begin{aligned}5 & 1 \\\\ 0 & 5\\end{aligned}].$*\n\n| $x(t)=\\,\\,$ |  | {{field-1}} |  | $\\,\\,+{\\int }_{1}^{t}\\,\\,$ |  | {{field-2}} |  | $\\,\\,\\text{d}s$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | $0$ |  |  | $0$ |  |  |  |  |" "$$\n{x}^{′}(t)=\\begin{bmatrix}5 & 1 \\\\ 0 & 5\\end{bmatrix}x+\\begin{bmatrix}{e}^{5t} \\\\ 0\\end{bmatrix},\\,x(1)=\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}{e}^{5t} &