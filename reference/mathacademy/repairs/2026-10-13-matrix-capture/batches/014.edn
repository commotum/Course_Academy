{c}_{2}\\end{aligned}] & =[\\begin{aligned}2 \\\\ -3\\end{aligned}].\\end{aligned}\n$$\n\nFinally, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}\\text{x}(t) & =2[\\begin{aligned}2\\operatorname{cos}⁡(2t)-2\\operatorname{sin}⁡(2t) \\\\ \\operatorname{cos}⁡(2t)\\end{aligned}]{e}^{-3t}-3[\\begin{aligned}2\\operatorname{sin}⁡(2t)+2\\operatorname{cos}⁡(2t) \\\\ \\operatorname{sin}⁡(2t)\\end{aligned}]{e}^{-3t} \\\\  & =[\\begin{aligned}-2\\operatorname{cos}⁡(2t)-10\\operatorname{sin}⁡(2t) \\\\ 2\\operatorname{cos}⁡(2t)-3\\operatorname{sin}⁡(2t)\\end{aligned}]{e}^{-3t}.\\end{aligned}\n$$" "We need to find the eigenvalues and associated eigenvectors of the matrix $A=\\begin{bmatrix}-1 & -8 \\\\ 1 & -5\\end{bmatrix}.$ \n\nWe are given the eigenvalue ${\\lambda }_{1}=-3+2\\text{i}$ and the corresponding eigenvector ${v}_{1}=\\begin{bmatrix}2+2\\text{i} \\\\ 1\\end{bmatrix}.$\n\n**Note:** The eigenvector corresponding to the second eigenvalue ${\\lambda }_{2}={\\overset{―}{\\lambda }}_{1}$ is \n${v}_{2}={\\overset{―}{v}}_{1}.$ But we do not require this eigenvector for solving our system.\n\nThe solution that we obtain for the eigenvalue ${\\lambda }_{1}=-3+2\\text{i}$ and its associated eigenvector is\n\n$$\n{x}_{1}(t)=\\begin{bmatrix}2+2\\text{i} \\\\ 1\\end{bmatrix}{e}^{(-3+2\\text{i})t}.\n$$\n\nWe now express this as a real function. Using Euler's formula, we obtain\n\n$$\n\\begin{aligned}{x}_{1}(t) & =\\begin{bmatrix}2+2\\text{i} \\\\ 1\\end{bmatrix}{e}^{(-3+2\\text{i})t} \\\\  & =\\begin{bmatrix}2+2\\text{i} \\\\ 1\\end{bmatrix}{e}^{-3t}(\\operatorname{cos}⁡(2t)+\\text{i}\\operatorname{sin}⁡(2t)) \\\\  & =\\begin{bmatrix}2{e}^{-3t}\\operatorname{cos}⁡(2t)+2\\text{i}{e}^{-3t}\\operatorname{sin}⁡(2t)+2\\text{i}{e}^{-3t}\\operatorname{cos}⁡(2t)-2{e}^{-3t}\\operatorname{sin}⁡(2t) \\\\ {e}^{-3t}\\operatorname{cos}⁡(2t)+\\text{i}{e}^{-3t}\\operatorname{sin}⁡(2t)\\end{bmatrix} \\\\  & =\\begin{bmatrix}{e}^{-3t}(2\\operatorname{cos}⁡(2t)-2\\operatorname{sin}⁡(2t))+\\text{i}{e}^{-3t}(2\\operatorname{sin}⁡(2t)+2\\operatorname{cos}⁡(2t)) \\\\ {e}^{-3t}\\operatorname{cos}⁡(2t)+\\text{i}{e}^{-3t}\\operatorname{sin}⁡(2t)\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\operatorname{cos}⁡(2t)-2\\operatorname{sin}⁡(2t) \\\\ \\operatorname{cos}⁡(2t)\\end{bmatrix}{e}^{-3t}+\\text{i}\\begin{bmatrix}2\\operatorname{sin}⁡(2t)+2\\operatorname{cos}⁡(2t) \\\\ \\operatorname{sin}⁡(2t)\\end{bmatrix}{e}^{-3t} \\\\  & ={\\text{w}}_{1}(t)+\\text{i}{\\text{w}}_{2}(t).\\end{aligned}\n$$\n\nThe vectors ${w}_{1}$ and ${w}_{2}$ are linearly independent. Therefore, the general solution of the system is\n\n$$\n\\begin{aligned}\\text{x}(t) & ={c}_{1}{\\text{w}}_{1}(t)+{c}_{2}{\\text{w}}_{2}(t) \\\\  & ={c}_{1}\\begin{bmatrix}2\\operatorname{cos}⁡(2t)-2\\operatorname{sin}⁡(2t) \\\\ \\operatorname{cos}⁡(2t)\\end{bmatrix}{e}^{-3t}+{c}_{2}\\begin{bmatrix}2\\operatorname{sin}⁡(2t)+2\\operatorname{cos}⁡(2t) \\\\ \\operatorname{sin}⁡(2t)\\end{bmatrix}{e}^{-3t}.\\end{aligned}\n$$\n\nNow, we need to find the values of ${c}_{1}$ and ${c}_{2}$ using the initial condition $x(0)=\\begin{bmatrix}-2 \\\\ 2\\end{bmatrix}.$ Substituting $t=0$ into the general solution gives\n\n$$\n\\begin{aligned}\\text{x}(0) & ={c}_{1}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}+{c}_{2}\\begin{bmatrix}2 \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}-2 \\\\ 2\\end{bmatrix} & =\\begin{bmatrix}2{c}_{1}+2{c}_{2} \\\\ {c}_{1}\\end{bmatrix} \\\\ \\begin{bmatrix}{c}_{1} \\\\ {c}_{2}\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ -3\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}\\text{x}(t) & =2\\begin{bmatrix}2\\operatorname{cos}⁡(2t)-2\\operatorname{sin}⁡(2t) \\\\ \\operatorname{cos}⁡(2t)\\end{bmatrix}{e}^{-3t}-3\\begin{bmatrix}2\\operatorname{sin}⁡(2t)+2\\operatorname{cos}⁡(2t) \\\\ \\operatorname{sin}⁡(2t)\\end{bmatrix}{e}^{-3t} \\\\  & =\\begin{bmatrix}-2\\operatorname{cos}⁡(2t)-10\\operatorname{sin}⁡(2t) \\\\ 2\\operatorname{cos}⁡(2t)-3\\operatorname{sin}⁡(2t)\\end{bmatrix}{e}^{-3t}.\\end{aligned}\n$$"] [:db/cas 17592186308599 :question/problem "$$\n{x}^{′}=[\\begin{aligned}3 & -2 \\\\ 0 & 3\\end{aligned}]x,\\,{x}_{1}(t)=[\\begin{aligned}2 \\\\ 0\\end{aligned}]{e}^{3t},\\,{x}_{2}(t)=[\\begin{aligned}2t \\\\ -1\\end{aligned}]{e}^{3t}\n$$\n\nConsider the system of linear ODEs and two of its linearly independent solutions ${x}_{1}$ and ${x}_{2},$ shown above. Which of the following is a fundamental matrix for the system?" "$$\n{x}^{′}=\\begin{bmatrix}3 & -2 \\\\ 0 & 3\\end{bmatrix}x,\\,{x}_{1}(t)=\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}{e}^{3t},\\,{x}_{2}(t)=\\begin{bmatrix}2t \\\\ -1\\end{bmatrix}{e}^{3t}\n$$\n\nConsider the system of linear ODEs and two of its linearly independent solutions ${x}_{1}$ and ${x}_{2},$ shown above. Which of the following is a fundamental matrix for the system?"] [:db/cas 17592186308599 :question/worked-solution "Given a linear system ${x}^{′}=Ax,$ where $A$ is an $n\\times n$ matrix, a *fundamental matrix* $Φ(t)$ of the system is an $n\\times n$ matrix whose columns are linearly independent solutions of the system.\n\nIn our case, we have a $2\\times 2$ system. We are also given that the two linearly independent solutions of the system are the following:\n\n$$\n\\begin{aligned}{x}_{1}(t) & =[\\begin{aligned}2 \\\\ 0\\end{aligned}]{e}^{3t}=[\\begin{aligned}2{e}^{3t} \\\\ 0\\end{aligned}] \\\\ {x}_{2}(t) & =[\\begin{aligned}2t \\\\ -1\\end{aligned}]{e}^{3t}=[\\begin{aligned}2t{e}^{3t} \\\\ -{e}^{3t}\\end{aligned}]\\end{aligned}\n$$\n\n \n\nTherefore, our fundamental could be written as\n\n$$\nΦ(t)=[\\begin{aligned}2{e}^{3t} & 2t{e}^{3t} \\\\ 0 & -{e}^{3t}\\end{aligned}].\n$$\n\n**Note:** The columns of $Φ$ can be written in any order." "Given a linear system ${x}^{′}=Ax,$ where $A$ is an $n\\times n$ matrix, a *fundamental matrix* $Φ(t)$ of the system is an $n\\times n$ matrix whose columns are linearly independent solutions of the system.\n\nIn our case, 