 {2}^{2} & {2}^{3} \\\\ 4 & {4}^{2} & {4}^{3}\\end{aligned}]}}\\overset{\\beta }{\\overset{⏞}{[\\begin{aligned}{\\beta }_{1} \\\\ {\\beta }_{2} \\\\ {\\beta }_{3}\\end{aligned}]}} & =\\overset{y}{\\overset{⏞}{[\\begin{aligned}-7 \\\\ 10 \\\\ -2 \\\\ 1 \\\\ -5\\end{aligned}]}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector." "| $x$ | **$-4$** | **$-2$** | **$0$** | **$2$** | **$4$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $-7$ | $10$ | $-2$ | $1$ | $-5$ |\n\nThe coefficients of the curve \n\n$$\ny={\\beta }_{1}x+{\\beta }_{2}{x}^{2}+{\\beta }_{3}{x}^{3}\n$$\n\nthat best fits the data can be found as the least-squares solution $\\hat{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}-4 & (-4)^{2} & (-4)^{3} \\\\ -2 & (-2)^{2} & (-2)^{3} \\\\ 0 & {0}^{2} & {0}^{3} \\\\ 2 & {2}^{2} & {2}^{3} \\\\ 4 & {4}^{2} & {4}^{3}\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{1} \\\\ {\\beta }_{2} \\\\ {\\beta }_{3}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}-7 \\\\ 10 \\\\ -2 \\\\ 1 \\\\ -5\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector."] [:db/cas 17592186400821 :answer/value "[\\begin{aligned}-7 & (-4)^{2} & (-4)^{3} \\\\ 10 & (-2)^{2} & (-2)^{3} \\\\ -2 & {0}^{2} & {0}^{3} \\\\ 1 & {2}^{2} & {2}^{3} \\\\ -5 & {4}^{2} & {4}^{3}\\end{aligned}]" "\\begin{bmatrix}-7 & (-4)^{2} & (-4)^{3} \\\\ 10 & (-2)^{2} & (-2)^{3} \\\\ -2 & {0}^{2} & {0}^{3} \\\\ 1 & {2}^{2} & {2}^{3} \\\\ -5 & {4}^{2} & {4}^{3}\\end{bmatrix}"] [:db/cas 17592186400822 :answer/value "[\\begin{aligned}1 & -4 & (-4)^{2} \\\\ 1 & -2 & (-2)^{2} \\\\ 1 & 0 & {0}^{2} \\\\ 1 & 2 & {2}^{2} \\\\ 1 & 4 & {4}^{2}\\end{aligned}]" "\\begin{bmatrix}1 & -4 & (-4)^{2} \\\\ 1 & -2 & (-2)^{2} \\\\ 1 & 0 & {0}^{2} \\\\ 1 & 2 & {2}^{2} \\\\ 1 & 4 & {4}^{2}\\end{bmatrix}"] [:db/cas 17592186400823 :answer/value "[\\begin{aligned}1 & -4 & (-4)^{3} \\\\ 1 & -2 & (-2)^{3} \\\\ 1 & 0 & {0}^{3} \\\\ 1 & 2 & {2}^{3} \\\\ 1 & 4 & {4}^{3}\\end{aligned}]" "\\begin{bmatrix}1 & -4 & (-4)^{3} \\\\ 1 & -2 & (-2)^{3} \\\\ 1 & 0 & {0}^{3} \\\\ 1 & 2 & {2}^{3} \\\\ 1 & 4 & {4}^{3}\\end{bmatrix}"] [:db/cas 17592186400824 :answer/value "[\\begin{aligned}-4 & (-4)^{2} & (-4)^{3} \\\\ -2 & (-2)^{2} & (-2)^{3} \\\\ 0 & {0}^{2} & {0}^{3} \\\\ 2 & {2}^{2} & {2}^{3} \\\\ 4 & {4}^{2} & {4}^{3}\\end{aligned}]" "\\begin{bmatrix}-4 & (-4)^{2} & (-4)^{3} \\\\ -2 & (-2)^{2} & (-2)^{3} \\\\ 0 & {0}^{2} & {0}^{3} \\\\ 2 & {2}^{2} & {2}^{3} \\\\ 4 & {4}^{2} & {4}^{3}\\end{bmatrix}"] [:db/cas 17592186400825 :answer/value "[\\begin{aligned}1 & (-4)^{2} & (-4)^{3} \\\\ 1 & (-2)^{2} & (-2)^{3} \\\\ 1 & {0}^{2} & {0}^{3} \\\\ 1 & {2}^{2} & {2}^{3} \\\\ 1 & {4}^{2} & {4}^{3}\\end{aligned}]" "\\begin{bmatrix}1 & (-4)^{2} & (-4)^{3} \\\\ 1 & (-2)^{2} & (-2)^{3} \\\\ 1 & {0}^{2} & {0}^{3} \\\\ 1 & {2}^{2} & {2}^{3} \\\\ 1 & {4}^{2} & {4}^{3}\\end{bmatrix}"] [:db/cas 17592186400826 :question/problem "A bungee jumping instructor measures how much a bungee rope stretches (in meters) when one end of the rope is attached to the bridge railing while a weight of $x$ kilograms is hung on the other. This data is shown below.\n\n| Weight $(x)$ | **$10$** | **$20$** | **$30$** | **$40$** |\n| --- | --- | --- | --- | --- |\n| Stretch $(y)$ | $1$ | $1.5$ | $2$ | $2.5$ |\n\nFind the line of the form $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above. According to the model, how much will the rope stretch if the instructor uses a $65$-kilogram mass, assuming the trend continues?  \n\n*Hint: You can use the fact that* \n\n$$\n({X}^{T}\\,X)^{-1}=\\frac{1}{500}[\\begin{aligned}750 & -25 \\\\ -25 & 1\\end{aligned}],\\,{X}^{T}y=[\\begin{aligned}7 \\\\ 200\\end{aligned}],\n$$\n\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*" "A bungee jumping instructor measures how much a bungee rope stretches (in meters) when one end of the rope is attached to the bridge railing while a weight of $x$ kilograms is hung on the other. This data is shown below.\n\n| Weight $(x)$ | **$10$** | **$20$** | **$30$** | **$40$** |\n| --- | --- | --- | --- | --- |\n| Stretch $(y)$ | $1$ | $1.5$ | $2$ | $2.5$ |\n\nFind the line of the form $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above. According to the model, how much will the rope stretch if the instructor uses a $65$-kilogram mass, assuming the trend continues?  \n\n*Hint: You can use the fact that* \n\n$$\n({X}^{T}\\,X)^{-1}=\\frac{1}{500}\\begin{bmatrix}750 & -25 \\\\ -25 & 1\\end{bmatrix},\\,{X}^{T}y=\\begin{bmatrix}7 \\\\ 200\\end{bmatrix},\n$$\n\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*"] [:db/cas 17592186400826 :question/worked-solution "The coefficients of the line that best fits the data can be found as the least-squares solution $\\overset{^}{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{[\\begin{aligned}1 & 10 \\\\ 1 & 20 \\\\ 1 & 30 \\\\ 1 & 40\\end{aligned}]}}\\overset{\\beta }{\\overset{⏞}{[\\begin{aligned}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{aligned}]}} & =\\overset{y}{\\overset{⏞}{[\\begin{aligned}1 \\\\ 1.5 \\\\ 2 \\\\ 2.5\\end{aligned}]}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation by ${X}^{T},$ we obtain the corresponding normal equation\n\n$$\n{X}^{T}\\,X\\overset{^}{\\beta }={X}^{T}y.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X}^{T}X$ is invertible and \n\n$$\n\\overset{^}{\\beta }=({X}^{T}\\,X)^{-1}{X}^{T}y.\n$$\n\nSubstituting the given values of $({X}^{T}X)^{-1}$ and ${X}^{T}y$ into the formula, we get\n\n$$\n\\begin{aligned}\\overset{^}{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{500}[\\begin{aligned}750 & -25 \\\\ -25 & 1\\end{aligned}]\\cdot [\\begin{aligned}7 \\\\ 200\\end{aligned}] \\\\  & =[\\begin{aligned}0.5 \\\\ 0.05\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we have the line $y=0.5+0.05x.$\n\nFinally, to predict how much the rope will stretch if a $65$-kilogram mass is hung from it, we substitute $x=65$ into the equation of the line:\n\n$$\n\\begin{aligned}y & =0.5+0.05(65) \\\\  & =3.75\\end{aligned}\n$$\n\nSo, according to the model, the rope will stretch $3.75$ meters if a $65$-kilogram mass is hung from it.\n\n**Note**: Since we're extrapolating ($x=65$ is not within the range of the original set of $x$-values), our result *may* be unreliable." "The coefficients of the line that best fits the data can be found as the least-squares solution $\\hat{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & 10 \\\\ 1 & 20 \\\\ 1 & 30 \\\\ 1 & 40\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}1 \\\\ 1.5 \\\\ 2 \\\\ 2.5\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation by ${X}^{T},$ we obtain the corresponding normal equation\n\n$$\n{X}^{T}\\,X\\hat{\\beta }={X}^{T}y.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X}^{T}X$ is invertible and \n\n$$\n\\hat{\\beta }=({X}^{T}\\,X)^{-1}{X}^{T}y.\n$$\n\nSubstituting the given values of $({X}^{T}X)^{-1}$ and ${X}^{T}y$ into the formula, we get\n\n$$\n\\begin{aligned}\\hat{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{500}\\begin{bmatrix}750 & -25 \\\\ -25 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}7 \\\\ 200\\end{bmatrix} \\\\  & =\\begin{bmatrix}0.5 \\\\ 0.05\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have the line $y=0.5+0.05x.$\n\nFinally, to predict how much the rope will stretch if a $65$-kilogram mass is hung from it, we substitute $x=65$ into the equation of the line:\n\n$$\n\\begin{aligned}y & =0.5+0.05(65) \\\\  & =3.75\\end{aligned}\n$$\n\nSo, according to the model, the rope will stretch $3.75$ meters if a $65$-kilogram mass is hung from it.\n\n**Note**: Since we're extrapolating ($x=65$ is not within the range of the original set of $x$-values), our result *may* be unreliable."] [:db/cas 17592186400839 :question/problem "| ${x}_{1}$ | **$1$** | **$2$** | **$3$** | **$4$** | **$5$** |\n| --- | --- | --- | --- | --- | --- |\n| ${x}_{2}$ | **$10$** | **$28$** | **$13$** | **$34$** | **$40$** |\n| $y$ | $0$ | $-2$ | $-8$ | $3$ | $10$ |\n\nThe vector of coefficients of the plane $y={\\beta }_{0}+{\\beta }_{1}{x}_{1}+{\\beta }_{2}{x}_{2}$ that best fits the data above can be found using multiple linear regression as \n\n$$\n[\\begin{aligned}{\\beta }_{0} \\\\ {\\beta }_{1} \\\\ {\\beta }_{2}\\end{aligned}]=({X}^{T}\\,X)^{-1}{X}^{T}y,\n$$\n\nwhere $X$ is the corresponding design matrix and $y$ is the observation vector. Which of the following is the design matrix $X$ in this context?" "| ${x}_{1}$ | **$1$** | **$2$** | **$3$** | **$4$** | **$5$** |\n| --- | --- | --- | --- | --- | --- |\n| ${x}_{2}$ | **$10$** | **$28$** | **$13$** | **$34$** | **$40$** |\n| $y$ | $0$ | $-2$ | $-8$ | $3$ | $10$ |\n\nThe vector of coefficients of the plane $y={\\beta }_{0}+{\\beta }_{1}{x}_{1}+{\\beta }_{2}{x}_{2}$ that best fits the data above can be found using multiple linear regression as \n\n$$\n\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1} \\\\ {\\beta }_{2}\\end{bmatrix}=({X}^{T}\\,X)^{-1}{X}^{T}y,\n$$\n\nwhere $X$ is the corresponding design matrix and $y$ is the observation vector. Which of the following is the design matrix $X$ in this context?"] [:db/cas 17592186400839 :question/worked-solution "| ${x}_{1}$ | **$1$** | **$2$** | **$3$** | **$4$** | **$5$** |\n| --- | --- | --- | --- | --- | --- |\n| ${x}_{2}$ | **$10$** | **$28$** | **$13$** | **$34$** | **$40$** |\n| $y$ | $0$ | $-2