 \\\\ 2{e}^{3t}\\end{aligned}]\\,\\text{d}t \\\\  & =[\\begin{aligned}\\int 5{e}^{-2t}\\,\\text{d}t \\\\ \\int 2{e}^{3t}\\,\\text{d}t\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{5}{2}{e}^{-2t} \\\\ \\frac{2}{3}{e}^{3t}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{x}_{p}(t) & =Φ\\,u(t) \\\\  & =[\\begin{aligned}0 & {e}^{-2t} \\\\ {e}^{3t} & -{e}^{-2t}\\end{aligned}][\\begin{aligned}-\\frac{5}{2}{e}^{-2t} \\\\ \\frac{2}{3}{e}^{3t}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{2}{3}{e}^{t} \\\\ -\\frac{19}{6}{e}^{t}\\end{aligned}] \\\\  & ={e}^{t}[\\begin{aligned}\\frac{2}{3} \\\\ -\\frac{19}{6}\\end{aligned}].\\end{aligned}\n$$" "We'll look for a particular solution in the form\n\n$$\n{x}_{p}(t)=Φ\\,u(t)\n$$\n\nwhere $Φ$ is a fundamental matrix for the corresponding homogeneous system, $f(t)$ is the forcing column vector and\n\n$$\nu(t)=\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t.\n$$\n\nIn our case,\n\n$$\nΦ=\\begin{bmatrix}0 & {e}^{-2t} \\\\ {e}^{3t} & -{e}^{-2t}\\end{bmatrix},\\,f(t)=\\begin{bmatrix}2{e}^{t} \\\\ 3{e}^{t}\\end{bmatrix}.\n$$\n\nSince $Φ$ is a fundamental matrix, it must be invertible. Using the formula for the inverse of a $2\\times 2$ matrix, we get the following:\n\n$$\n\\begin{aligned}{Φ}^{-1} & =\\frac{1}{0\\cdot (-{e}^{-2t})-{e}^{-2t}\\cdot {e}^{3t}}\\begin{bmatrix}-{e}^{-2t} & -{e}^{-2t} \\\\ -{e}^{3t} & 0\\end{bmatrix} \\\\  & =-{e}^{-t}\\begin{bmatrix}-{e}^{-2t} & -{e}^{-2t} \\\\ -{e}^{3t} & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}{e}^{-3t} & {e}^{-3t} \\\\ {e}^{2t} & 0\\end{bmatrix} \\\\ {Φ}^{-1}\\,f(t) & =\\begin{bmatrix}{e}^{-3t} & {e}^{-3t} \\\\ {e}^{2t} & 0\\end{bmatrix}\\begin{bmatrix}2{e}^{t} \\\\ 3{e}^{t}\\end{bmatrix} \\\\  & =\\begin{bmatrix}5{e}^{-2t} \\\\ 2{e}^{3t}\\end{bmatrix}\\end{aligned}\n$$\n\nNow, using our formula for $u(t),$ we obtain\n\n$$\n\\begin{aligned}u(t) & =\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t \\\\  & =\\int \\begin{bmatrix}5{e}^{-2t} \\\\ 2{e}^{3t}\\end{bmatrix}