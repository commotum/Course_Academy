12+6\\text{i})\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1+2\\text{i} & -3-3\\text{i} \\\\ 12+\\text{i} & -12-3\\text{i}\\end{bmatrix}.\\end{aligned}\n$$"] [:db/cas 17592186366290 :answer/value "[\\begin{aligned}-1+2\\text{i} & -12-3\\text{i} \\\\ 12+\\text{i} & -3-3\\text{i}\\end{aligned}]" "\\begin{bmatrix}-1+2\\text{i} & -12-3\\text{i} \\\\ 12+\\text{i} & -3-3\\text{i}\\end{bmatrix}"] [:db/cas 17592186366291 :answer/value "[\\begin{aligned}-1+2\\text{i} & 12+\\text{i} \\\\ -3-3\\text{i} & -12-3\\text{i}\\end{aligned}]" "\\begin{bmatrix}-1+2\\text{i} & 12+\\text{i} \\\\ -3-3\\text{i} & -12-3\\text{i}\\end{bmatrix}"] [:db/cas 17592186366292 :answer/value "[\\begin{aligned}12+\\text{i} & -3-3\\text{i} \\\\ -1+2\\text{i} & -12-3\\text{i}\\end{aligned}]" "\\begin{bmatrix}12+\\text{i} & -3-3\\text{i} \\\\ -1+2\\text{i} & -12-3\\text{i}\\end{bmatrix}"] [:db/cas 17592186366293 :answer/value "[\\begin{aligned}-1+2\\text{i} & -3-3\\text{i} \\\\ 12+\\text{i} & -12-3\\text{i}\\end{aligned}]" "\\begin{bmatrix}-1+2\\text{i} & -3-3\\text{i} \\\\ 12+\\text{i} & -12-3\\text{i}\\end{bmatrix}"] [:db/cas 17592186366294 :answer/value "[\\begin{aligned}-3-12\\text{i} & -3-3\\text{i} \\\\ 12+\\text{i} & 2-\\text{i}\\end{aligned}]" "\\begin{bmatrix}-3-12\\text{i} & -3-3\\text{i} \\\\ 12+\\text{i} & 2-\\text{i}\\end{bmatrix}"] [:db/cas 17592186366295 :question/problem "Given the matrix $A=[\\begin{aligned}2\\text{i} & 6\\text{i} \\\\ -1+3\\text{i} & -2\\end{aligned}]$, find the result of applying to $A$ the following elementary row operations: \n\n$$\n{R}_{1}:=\\frac{1}{2\\text{i}}{R}_{1},\\,{R}_{2}:={R}_{2}+(1-3\\text{i}){R}_{1}\n$$" "Given the matrix $A=\\begin{bmatrix}2\\text{i} & 6\\text{i} \\\\ -1+3\\text{i} & -2\\end{bmatrix}$, find the result of applying to $A$ the following elementary row operations: \n\n$$\n{R}_{1}:=\\frac{1}{2\\text{i}}{R}_{1},\\,{R}_{2}:={R}_{2}+(1-3\\text{i}){R}_{1}\n$$"] [:db/cas 17592186366295 :question/worked-solution "Let's apply the row operations to $A:$\