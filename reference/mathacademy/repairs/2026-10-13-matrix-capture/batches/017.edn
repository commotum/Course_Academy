atrix}6 & 6 \\\\ 6 & 6\\end{bmatrix}"] [:db/cas 17592186347273 :answer/value "[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]" "\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}"] [:db/cas 17592186347289 :answer/value "[x]_{C}=[\\begin{aligned}\\frac{1}{3} \\\\ -\\frac{2}{3}\\end{aligned}]" "[x]_{C}=\\begin{bmatrix}\\frac{1}{3} \\\\ -\\frac{2}{3}\\end{bmatrix}"] [:db/cas 17592186347291 :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]" "\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}"] [:db/cas 17592186347308 :answer/value "[\\begin{aligned}0 & -1 \\\\ 3 & -1\\end{aligned}]" "\\begin{bmatrix}0 & -1 \\\\ 3 & -1\\end{bmatrix}"] [:db/cas 17592186347312 :answer/value "$D=[\\begin{aligned}2 & 0 \\\\ 0 & -2\\end{aligned}]$ and $P=[\\begin{aligned}2 & -1 \\\\ -1 & 1\\end{aligned}]$" "$D=\\begin{bmatrix}2 & 0 \\\\ 0 & -2\\end{bmatrix}$ and $P=\\begin{bmatrix}2 & -1 \\\\ -1 & 1\\end{bmatrix}$"] [:db/cas 17592186347317 :answer/value "$D=[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}]$ and $P=[\\begin{aligned}3 & -1 \\\\ 2 & 1\\end{aligned}]$" "$D=\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix}$ and $P=\\begin{bmatrix}3 & -1 \\\\ 2 & 1\\end{bmatrix}$"] [:db/cas 17592186347322 :answer/value "[\\begin{aligned}-1 \\\\ 2\\end{aligned}]" "\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}"] [:db/cas 17592186347328 :answer/value "[\\begin{aligned}2 \\\\ -2\\end{aligned}]" "\\begin{bmatrix}2 \\\\ -2\\end{bmatrix}"] [:db/cas 17592186347334 :answer/value "$D=[\\begin{aligned}0 & 0 \\\\ 0 & -1\\end{aligned}]$ and\n$P=[\\begin{aligned}2 & 1 \\\\ -1 & -1\\end{aligned}]$" "$D=\\begin{bmatrix}0 & 0 \\\\ 0 & -1\\end{bmatrix}$ and\n$P=\\begin{bmatrix}2 & 1 \\\\ -1 & -1\\end{bmatrix}$"] [:db/cas 17592186347373 :answer/value "x(t)={c}_{1}[\\begin{aligned}-2 \\\\ 1\\end{aligned}]{e}^{t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{-t},\\,{c}_{1},{c}_{2}\\in R" "x(t)={c}_{1}\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}{e}^{t}+{c}_{2}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}{e}^{-t},\\,{c}_{1},{c}_{