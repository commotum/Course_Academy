}\\end{array}\\right]"] [:db/cas 17592186261738 :answer/value "[\\begin{aligned}2 & 5 & -1 \\\\ 5 & -9 & -1\\end{aligned}]" "\\left[\\begin{array}{cc|c}2 & 5 & -1 \\\\ 5 & -9 & -1\\end{array}\\right]"] [:db/cas 17592186261750 :answer/value "[\\begin{aligned}1 & 9 \\\\ 3 & -4 \\\\ 2 & 1\\end{aligned}]" "\\left[\\begin{array}{c|c}1 & 9 \\\\ 3 & -4 \\\\ 2 & 1\\end{array}\\right]"] [:db/cas 17592186261826 :answer/value "[\\begin{aligned}\\frac{1}{3} & 5 & 11 \\\\ 0 & 4 & -8 \\\\ 6 & -1 & \\frac{2}{5}\\end{aligned}]" "\\left[\\begin{array}{cc|c}\\frac{1}{3} & 5 & 11 \\\\ 0 & 4 & -8 \\\\ 6 & -1 & \\frac{2}{5}\\end{array}\\right]"] [:db/cas 17592186261916 :answer/value "[\\begin{aligned}4 & -1 & 4 \\\\ -7 & 0 & 8\\end{aligned}]" "\\left[\\begin{array}{cc|c}4 & -1 & 4 \\\\ -7 & 0 & 8\\end{array}\\right]"] [:db/cas 17592186262016 :answer/value "[\\begin{aligned}1 & -1 \\\\ 9 & 4\\end{aligned}]" "\\begin{bmatrix}1 & -1 \\\\ 9 & 4\\end{bmatrix}"] [:db/cas 17592186262057 :answer/value "[\\begin{aligned}1 & 2 & 5 \\\\ 5 & 9 & 1\\end{aligned}]" "\\left[\\begin{array}{cc|c}1 & 2 & 5 \\\\ 5 & 9 & 1\\end{array}\\right]"] [:db/cas 17592186262931 :question/worked-solution "First, we organize the system so that the variables are ordered $x,y$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\n\\begin{aligned}{\\begin{aligned}x+0y=6 \\\\ 9x+4y=-1\\end{aligned}\\end{aligned}\n$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n[\\begin{aligned}1 & 0 \\\\ 9 & 4\\end{aligned}]\n$$" "First, we organize the system so that the variables are ordered $x,y$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\n\\begin{aligned}{\\begin{aligned}x+0y=6 \\\\ 9x+4y=-1\\end{aligned}\\end{aligned}\n$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n\\begin{bmatrix}1 & 0 \\\\ 9 & 4\\end{bmatrix}\n$$"] [:db/cas 17592186262932 :question/problem "What is the coefficient matrix for the following system of linear equations?\n\n$$\n\\begin{aligned}\\{\\begin{aligned}5x-8y+z=-1 \\\\ 9y=2 \\\\ 3x-y-8z=-4\\end{aligned}\\end{aligned}\n$$" "What is the coefficient matrix for the following system of linear equations?\n\n$$\\begin{cases}5x-8y+z=-1 \\\\ 9y=2 \\\\ 3x-y-8z=-4\\end{cases}$$"] [:db/cas 17592186262932 :question/worked-solution "First, we organize the system so that the variables are ordered $x,y,z$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\n\\begin{aligned}\\{\\begin{aligned}5x-8y+z=-1 \\\\ 0x+9y+0z=2 \\\\ 3x-y-8z=-4\\end{aligned}\\end{aligned}\n$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n[\\begin{aligned}5 & \\,\\,\\,-8 & 1 \\\\ 0 & 9 & 0 \\\\ 3 & \\,\\,\\,-1 & \\,\\,\\,-8\\end{aligned}]\n$$" "First, we organize the system so that the variables are ordered $x,y,z$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\\begin{cases}5x-8y+z=-1 \\\\ 0x+9y+0z=2 \\\\ 3x-y-8z=-4\\end{cases}$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n\\begin{bmatrix}5 & \\,\\,\\,-8 & 1 \\\\ 0 & 9 & 0 \\\\ 3 & \\,\\,\\,-1 & \\,\\,\\,-8\\end{bmatrix}\n$$"] [:db/cas 17592186262947 :question/worked-solution "First, we organize the system so that the variables are ordered $x,y$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient: \n\n$$\n{\\begin{aligned}4x-y=4 \\\\ 8x+0y=-7\\end{aligned}\n$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n[\\begin{aligned}4 & -1 \\\\ 8 & 0\\end{aligned}]\n$$\n\nThe augmented matrix  is the coefficient matrix augmented with the column that represents the right-hand sides of the equations:\n\n$$\n[\\begin{aligned}4 & -1 & 4 \\\\ 8 & 0 & -7\\end{aligned}]\n$$" "First, we organize the system so that the variables are ordered $x,y$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient: \n\n$$\\begin{cases}4x-y=4 \\\\ 8x+0y=-7\\end{cases}$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n\\left[\\begin{array}{c|c}4 & -1 \\\\ 8 & 0\\end{array}\\right]\n$$\n\nThe augmented matrix  is the coefficient matrix augmented with the column that represents the right-hand sides of the equations:\n\n$$\n\\left[\\begin{array}{cc|c}4 & -1 & 4 \\\\ 8 & 0 & -7\\end{array}\\right]\n$$"] [:db/cas 17592186262948 :question/worked-solution "First, we organize the system so that the variables are ordered $x,y$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\n\\begin{aligned}{\\begin{aligned}x+2y=5 \\\\ 5x-9y=-1\\end{aligned}\\end{aligned}\n$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n[\\begin{aligned}1 & 2 \\\\ 5 & -9\\end{aligned}]\n$$\n\nThe augmented matrix  is the coefficient matrix augmented with the column that represents the right-hand sides of the equations: \n\n$$\n[\\begin{aligned}1 & 2 & 5 \\\\ 5 & -9 & -1\\end{aligned}]\n$$" "First, we organize the system so that the variables are ordered $x,y$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\n\\begin{aligned}{\\begin{aligned}x+2y=5 \\\\ 5x-9y=-1\\end{aligned}\\end{aligned}\n$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n\\left[\\begin{array}{c|c}1 & 2 \\\\ 5 & -9\\end{array}\\right]\n$$\n\nThe augmented matrix  is the coefficient matrix augmented with the column that represents the right-hand sides of the equations: \n\n$$\n\\left[\\begin{array}{cc|c}1 & 2 & 5 \\\\ 5 & -9 & -1\\end{array}\\right]\n$$"] [:db/cas 17592186262949 :question/problem "What would be the system of equations for the following augmented matrix?\n\n$$\n[\\begin{aligned}7 & -4 & 0 & 9 \\\\ -3 & 