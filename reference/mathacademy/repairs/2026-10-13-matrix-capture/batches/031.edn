& 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]\\cdot A" "\\begin{bmatrix}1 & 0 & 5 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{bmatrix}\\cdot A"] [:db/cas 17592186500961 :answer/value "[\\begin{aligned}0 & 1 & 0 \\\\ \\frac{3}{2} & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 1 & 1\\end{aligned}]\\cdot A" "\\begin{bmatrix}0 & 1 & 0 \\\\ \\frac{3}{2} & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 1 & 1\\end{bmatrix}\\cdot A"] [:db/cas 17592186500993 :answer/value "[\\begin{aligned}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & \\frac{3}{2} & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" "\\begin{bmatrix}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & \\frac{3}{2} & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A"] [:db/cas 17592186501135 :question/problem "Consider the basis $B=\\{{b}_{1},{b}_{2}\\}$ of the vector space $V$ and the basis $C$ of ${R}^{2}$ given by\n\n$$\nC=\\{[\\begin{aligned}1 \\\\ -4\\end{aligned}],[\\begin{aligned}-1 \\\\ 1\\end{aligned}]\\}.\n$$\n\nFind the matrix $[T]_{B|C}$ of the map $T:V\\to {R}^{2}$ relative to these bases if \n\n$$\nT({b}_{1})=[\\begin{aligned}2 \\\\ 1\\end{aligned}],\\,T({b}_{2})=[\\begin{aligned}-1 \\\\ 1\\end{aligned}].\n$$" "Consider the basis $B=\\{{b}_{1},{b}_{2}\\}$ of the vector space $V$ and the basis $C$ of ${R}^{2}$ given by\n\n$$\nC=\\{\\begin{bmatrix}1 \\\\ -4\\end{bmatrix},\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}\\}.\n$$\n\nFind the matrix $[T]_{B|C}$ of the map $T:V\\to {R}^{2}$ relative to these bases if \n\n$$\nT({b}_{1})=\\begin{bmatrix}2 \\\\ 1\\end{bmatrix},\\,T({b}_{2})=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}.\n$$"] [:db/cas 17592186501135 :question/worked-solution "Recall that $[T]_{B|C}$ is the matrix whose columns are the coordinates of the vectors $T({b}_{1})$ and $T({b}_{2})$ relative to the basis $C.$\n\nFirst, we need to find the coordinates of $T({b}_{i})$ relative to the basis $C$ for each $i=1,2.$ We can do this simultaneously by considering the following matrix:\n\n$$\nM=[\\begin{aligned}| & | & | & | \\\\ {c}_{1} & {c}_{2} & T({b}_{1}) & T({b}_{2}) \\\\ | & | & | & |\\end{aligned}].\n$$\n\nWe reduce the left-hand side to reduced row echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -1 & 2 & -1 \\\\ -4 & 1 & 1 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & -1 \\\\ 0 & -3 & 9 & -3\\end{aligned}] & {R}_{2} & :=(-\\frac{1}{3}){R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & -1 \\\\ 0 & 1 & -3 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & -1 & 0 \\\\ 0 & 1 & -3 & 1\\end{aligned}]\\end{aligned}\n$$\n\nFinally, the right-hand side gives the matrix of the linear transformation relative to the bases $B$ and $C:$\n\n$$\n[T]_{B|C}=[\\begin{aligned}-1 & 0 \\\\ -3 & 1\\end{aligned}]\n$$" "Recall that $[T]_{B|C}$ is the matrix whose columns are the coordinates of the vectors $T({b}_{1})$ and $T({b}_{2})$ relative to the basis $C.$\n\nFirst, we need to find the coordinates of $T({b}_{i})$ relative to the basis $C$ for each $i=1,2.$ We can do this simultaneously by considering the following matrix:\n\n$$\nM=\\begin{bmatrix}| & | & | & | \\\\ {c}_{1} & {c}_{2} & T({b}_{1}) & T({b}_{2}) \\\\ | & | & | & |\\end{bmatrix}.\n$$\n\nWe reduce the left-hand side to reduced row echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -1 & 2 & -1 \\\\ -4 & 1 & 1 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 & -1 \\\\ 0 & -3 & 9 & -3\\end{bmatrix} & {R}_{2} & :=(-\\frac{1}{3}){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 & -1 \\\\ 0 & 1 & -3 & 1\\end{bmatrix} & {R}_{1} & :={R}_{1}+{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & -1 & 0 \\\\ 0 & 1 & -3 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, the right-hand side gives the matrix of the linear transformation relative to the bases $B$ and $C:$\n\n$$\n[T]_{B|C}=\\begin{bmatrix}-1 & 0 \\\\ -3 & 1\\end{bmatrix}\n$$"] [:db/cas 17592186501141 :question/problem "Determine ${f}^{″}(t)$ given that $f(t)=[\\begin{aligned}4\\sqrt{t} \\\\ {e}^{1-2t} \\\\ -2{t}^{6}\\end{aligned}].$\n\n|  |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n| ${f}^{″}(t)=\\,\\,$ |  | {{field-2}} |  |\n|  |  | {{field-3}} |  |" "Determine ${f}^{″}(t)$ given that $f(t)=\\begin{bmatrix}4\\sqrt{t} \\\\ {e}^{1-2t} \\\\ -2{t}^{6}\\end{bmatrix}.$\n\n|  |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n| ${f}^{″}(t)=\\,\\,$ |  | {{field-2}} |  |\n|  |  | {{field-3}} |  |"] [:db/cas 17592186501141 :question/worked-solution "First, we find the derivative of $f(t)$ by differentiating each component.\n\n$$\n{f}^{′}(t)=[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(4\\sqrt{t}) \\\\ \\frac{\\text{d}}{\\text{d}t}({e}^{1-2t})\\,\\,\\,\\, \\\\ \\frac{\\text{d}}{\\text{d}t}(-2{t}^{6})\\end{aligned}]=[\\begin{aligned}\\frac{2}{\\sqrt{t}} \\\\ -2{e}^{1-2t} \\\\ -12{t}^{5}\\end{aligned}]\n$$\n\nNext, we calculate ${f}^{″}(t)$ by differentiating ${f}^{′}(t):$\n\n$$\n{f}^{″}(t)=[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(\\frac{2}{\\sqrt{t}}) \\\\ \\frac{\\text{d}}{\\text{d}t}(-2{e}^{1-2t}) \\\\ \\frac{\\text{d}}{\\text{d}t}(-12{t}^{5})\\,\\end{aligned}]=[\\begin{aligned}-\\frac{1}{{t}^{3/2}} \\\\ 4{e}^{1-2t} \\\\ -60{t}^{4}\\end{aligned}]\n$$" "First, we find the derivative of $f(t)$ by differentiating each component.\n\n$$\n{f}^{′}(t)=\\begin{bmatrix}\\frac{\\text{d}}{\\text{d}t}(4\\sqrt{t}) \\\\ \\frac{\\text{d}}{\\text{d}t}({e}^{1-2t})\\,\\,\\,\\, \\\\ \\frac{\\text{d}}{\\text{d}t}(-2{t}^{6})\\end{bmatrix}=\\begin{bmatrix}\\frac{2}{\\sqrt{t}} \\\\ -2{e}^{1-2t} \\\\ -12{t}^{5}\\end{bmatrix}\n$$\n\nNext, we calculate ${f}^{″}(t)$ by differentiating ${f}^{′}(t):$\n\n$$\n{f}^{″}(t)=\\begin{bmatrix}\\frac{\\text{d}}{\\text{d}t}(\\frac{2}{\\sqrt{t}}) \\\\ \\frac{\\text{d}}{\\text{d}t}(-2{e}^{1-2t}) \\\\ \\frac{\\text{d}}{\\text{d}t}(-12{t}^{5})\\,\\end{bmatrix}=\\begin{bmatrix}-\\frac{1}{{t}^{3/2}} \\\\ 4{e}^{1-2t} \\\\ -60{t}^{4}\\end{bmatrix}\n$$"] [:db/cas 17592186501153 :question/worked-solution "First, let's find the elementary matrices corresponding to the given elementary row operations.\n\n- The first operation is ${R}_{1}↔{R}_{3}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1}↔{R}_{3} \\\\  & ∼[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}] \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second operation is ${R}_{2}:={R}_{2}+5{R}_{3}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+5{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 5 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={E}_{2}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$\n\n$$\n[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]\\cdot A\n$$\n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$\n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 5 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]\\cdot A\n$$" "First, let's find the elementary matrices corresponding to the given elementary row operations.\n\n- The first operation is ${R}_{1}↔{R}_{3}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{1}↔{R}_{3} \\\\  & ∼\\begin{bmatrix}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{bmatrix} \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second operation is ${R}_{2}:={R}_{2}+5{R}_{3}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+5{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 5 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & ={E}_{2}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$\n\n$$\n\\begin{bmatrix}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{bmatrix}\\cdot A\n$$\n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 5 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{bmatrix}\\cdot A\n$$"] [:db/cas 17592186501158 :question/worked-solution "First, we write the images of vectors in $B$ relative to the basis $C:$ \n\n$$\n\\begin{aligned}T({b}_{1})=-3{c}_{1}-5{c}_{2} & \\,⟹\\,[T({b}_{1})]_{C}=[\\begin{aligned}-3 \\\\ -5\\end{aligned}] \\\\ T({b}_{2})={c}_{1}-4{c}_{2} & \\,⟹\\,[T({b}_{2})]_{C}=[\\begin{aligned}1 \\\\ -4\\end{aligned}] \\\\ T({b}_{3})=5{c}_{1} & \\,⟹\\,[T({b}_{3})]_{C}=[\\begin{aligned}5 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, $[T]_{B|C}$ is the matrix  whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2})$ and $T({b}_{3})$ relative to the basis $C:$\n\n$$\n[T]_{B|C}=[\\begin{aligned}-3 & 1 & 5 \\\\ -5 & -4 & 0\\end{aligned}]\n$$" "First, we write the images of vectors in $B$ relative to the basis $C:$ \n\n$$\n\\begin{aligned}T({b}_{1})=-3{c}_{1}-5{c}_{2} & \\,⟹\\,[T({b}_{1})]_{C}=\\begin{bmatrix}-3 \\\\ -5\\end{bmatrix} \\\\ T({b}_{2})={c}_{1}-4{c}_{2} & \\,⟹\\,[T({b}_{2})]_{C}=\\begin{bmatrix}1 \\\\ -4\\end{bmatrix} \\\\ T({b}_{3})=5{c}_{1} & \\,⟹\\,[T({b}_{3})]_{C}=\\begin{bmatrix}5 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$\n\nNow, $[T]_{B|C}$ is the matrix  whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2})$ and $T({b}_{3})$ relative to the basis $C:$\n\n$$\n[T]_{B|C}=\\begin{bmatrix}-3 & 1 & 5 \\\\ -5 & -4 & 0\\end{bmatrix}\n$$"] [:db/cas 17592186501159 :question/worked-solution "We need to find a matrix $E$ such that $EA$ is equivalent to applying the elementary row operation ${R}_{2}↔{R}_{3}$ to $A.$\n\nTo find $E,$ we apply the given row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{2} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 1 & 0\\end{aligned}] \\\\  & =E\\end{aligned}\n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 1 & 0\\end{aligned}]\\cdot A\n$$" "We need to find a matrix $E$ such that $EA$ is equivalent to applying the elementary row operation ${R}_{2}↔{R}_{3}$ to $A.$\n\nTo find $E,$ we apply the given row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{2} & ↔{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 1 & 0\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 1 & 0\\end{bmatrix}\\cdot A\n$$"] [:db/cas 17592186501170 :question/worked-solution "We need to find a matrix $E$ such that $EA$ is equivalent to applying the elementary row operation ${R}_{1}↔{R}_{2}$ to $A.$\n\nTo find $E,$ we apply the given row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =E\\end{aligned}\n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n[\\begin{aligned}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A\n$$" "We need to find a matrix $E$ such that $EA$ is equivalent to applying the elementary row operation ${R}_{1}↔{R}_{2}$ to $A.$\n\nTo find $E,$ we apply the given row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n\\begin{bmatrix}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A\n$$"] [:db/cas 17592186501214 :question/worked-solution "First, let's find the elementary matrices corresponding to the given elementary row operations.\n\n- The first operation is ${R}_{2}:=3{R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{2} & :=3{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second operation is ${R}_{3}:={R}_{3}+(-3){R}_{1}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}] \\\\  & ={E}_{2}\\end{aligned}\n$$\n\n- The third operation is ${R}_{1}:={R}_{1}+{R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={E}_{3}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$\n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A\n$$\n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$\n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A\n$$\n\nFinally, to apply the third elementary row operation to ${E}_{2}{E}_{1}A,$ we multiply by ${E}_{3}$ on the left and get ${E}_{3}{E}_{2}{E}_{1}A:$ \n\n$$\n[\\begin{aligned}1 & 1 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A\n$$" "First, let's find the elementary matrices corresponding to the given elementary row operations.\n\n- The first operation is ${R}_{2}:=3{R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{2} & :=3{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second operation is ${R}_{3}:={R}_{3}+(-3){R}_{1}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix} \\\\  & ={E}_{2}\\end{aligned}\n$$\n\n- The third operation is ${R}_{1}:={R}_{1}+{R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{1} & :={R}_{1}+{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 1 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & ={E}_{3}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A\n$$\n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A\n$$\n\nFinally, to apply the third elementary row operation to ${E}_{2}{E}_{1}A,$ we multiply by ${E}_{3}$ on the left and get ${E}_{3}{E}_{2}{E}_{1}A:$ \n\n$$\n\\begin{bmatrix}1 & 1 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A\n$$"] [:db/cas 17592186501217 :question/problem "$$\n[T]_{B|C}=[\\begin{aligned}0 & 2 \\\\ 3 & 7 \\\\ 6 & 5\\end{aligned}],\\,[x]_{B}=[\\begin{aligned}4 \\\\ -2\\end{aligned}]\n$$\n\nSuppose $B$ and $C$ are bases of the vector spaces $V$ and $W,$ respectively. The matrix $[T]_{B|C}$ of the linear map $T:V\\to W$ relative to these bases, and the coordinates of the vector $x\\in V$ relative to $B$ are shown above. Find $[T(x)]_{C}.$" "$$\n[T]_{B|C}=\\begin{bmatrix}0 & 2 \\\\ 3 & 7 \\\\ 6 & 5\\end{bmatrix},\\,[x]_{B}=\\begin{bmatrix}4 \\\\ -2\\end{bmatrix}\n$$\n\nSuppose $B$ and $C$ are bases of the vector spaces $V$ and $W,$ respectively. The matrix $[T]_{B|C}$ of the linear map $T:V\\to W$ relative to these bases, and the coordinates of the vector $x\\in V$ relative to $B$ are shown above. Find $[T(x)]_{C}.$"] [:db/cas 17592186501217 :question/worked-solution "The coordinates of the image of $x$ under $T$ relative to the basis $C$ can be found as follows:\n\n$$\n\\begin{aligned}[T(x)]_{C} & =[T]_{B|C}\\cdot [x]_{B} \\\\  & =[\\begin{aligned}0 & 2 \\\\ 3 & 7 \\\\ 6 & 5\\end{aligned}][\\begin{aligned}4 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}-4 \\\\ -2 \\\\ 14\\end{aligned}]\\end{aligned}\n$$" "The coordinates of the image of $x$ under $T$ relative to the basis $C$ can be found as follows:\n\n$$\n\\begin{aligned}[T(x)]_{C} & =[T]_{B|C}\\cdot [x]_{B} \\\\  & =\\begin{bmatrix}0 & 2 \\\\ 3 & 7 \\\\ 6 & 5\\end{bmatrix}\\begin{bmatrix}4 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4 \\\\ -2 \\\\ 14\\end{bmatrix}\\end{aligned}\n$$"] [:db/cas 17592186501235 :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\text{ }dxdy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))\\,|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find a suitable change of variables.\n\nThe integrand\n\n$$\nf(x,y)=(x-y){e}^{x+y}\n$$\n\nsuggests that we use the change of variables \n\n$$\nu=x-y,\\,v=x+y.\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y\\end{aligned}]\\to [\\begin{aligned}u(x,y) \\\\ v(x,y)\\end{aligned}].\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nThe vertices of our domain $Δ$ in the $uv$-plane are as follows:\n\n$$\n\\begin{aligned}{T}^{-1}(0,0) & =(0-0,0+0) \\\\  & =(0,0) \\\\ {T}^{-1}(2,-2) & =(2-(-2),2+(-2)) \\\\  & =(4,0) \\\\ {T}^{-1}(3,-1) & =(3-(-1),3+(-1)) \\\\  & =(4,2) \\\\ {T}^{-1}(1,1) & =(1-1,1+1) \\\\  & =(0,2)\\end{aligned}\n$$\n\nTherefore, our domain in the $uv$-plane is the following rectangle:\n\n$$\nΔ=\\{(u,v)\\,:\\,0\\le u\\le 4,\\,0\\le v\\le 2\\}\n$$\n\n![](images/0b/0b23c6463447aa1fb64bdeeca689a40711f8dad59b348bb7943c2b9d2de7e8fc.png)\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{aligned}| \\\\  & =|\\begin{aligned}1 & -1 \\\\ 1 & \\text{ }\\text{ }1\\end{aligned}| \\\\  & =2.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}=\\frac{1}{2}\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Perform the change of variables, and evaluate the integral:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}(x-y){e}^{x+y}\\,\\text{d}x\\text{d}y & ={∬}_{Δ}u{e}^{v}\\,|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}u{e}^{v}\\,|\\frac{1}{2}|\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}{\\int }_{0}^{4}u{e}^{v}\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}{e}^{v}\\,\\text{d}v{\\int }_{0}^{4}u\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot [{e}^{v}]_{0}^{2}\\cdot {[\\frac{1}{2}{u}^{2}]}_{0}^{4}\\,\\text{d}v \\\\  & =\\frac{1}{2}\\cdot ({e}^{2}-1)\\cdot 8 \\\\  & =4({e}^{2}-1).\\end{aligned}\n$$" "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\text{ }dxdy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))\\,|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find a suitable change of variables.\n\nThe integrand\n\n$$\nf(x,y)=(x-y){e}^{x+y}\n$$\n\nsuggests that we use the change of variables \n\n$$\nu=x-y,\\,v=x+y.\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nThe vertices of our domain $Δ$ in the $uv$-plane are as follows:\n\n$$\n\\begin{aligned}{T}^{-1}(0,0) & =(0-0,0+0) \\\\  & =(0,0) \\\\ {T}^{-1}(2,-2) & =(2-(-2),2+(-2)) \\\\  & =(4,0) \\\\ {T}^{-1}(3,-1) & =(3-(-1),3+(-1)) \\\\  & =(4,2) \\\\ {T}^{-1}(1,1) & =(1-1,1+1) \\\\  & =(0,2)\\end{aligned}\n$$\n\nTherefore, our domain in the $uv$-plane is the following rectangle:\n\n$$\nΔ=\\{(u,v)\\,:\\,0\\le u\\le 4,\\,0\\le v\\le 2\\}\n$$\n\n![](images/0b/0b23c6463447aa1fb64bdeeca689a40711f8dad59b348bb7943c2b9d2de7e8fc.png)\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & -1 \\\\ 1 & \\text{ }\\text{ }1\\end{vmatrix} \\\\  & =2.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}=\\frac{1}{2}\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Perform the change of variables, and evaluate the integral:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}(x-y){e}^{x+y}\\,\\text{d}x\\text{d}y & ={∬}_{Δ}u{e}^{v}\\,|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}u{e}^{v}\\,|\\frac{1}{2}|\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}{\\int }_{0}^{4}u{e}^{v}\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}{e}^{v}\\,\\text{d}v{\\int }_{0}^{4}u\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot [{e}^{v}]_{0}^{2}\\cdot {[\\frac{1}{2}{u}^{2}]}_{0}^{4}\\,\\text{d}v \\\\  & =\\frac{1}{2}\\cdot ({e}^{2}-1)\\cdot 8 \\\\  & =4({e}^{2}-1).\\end{aligned}\n$$"] [:db/cas 17592186501239 :question/worked-solution "First, let's find the elementary matrices corresponding to the two given elementary row operations.\n\n- The first operation is ${R}_{2}:=\\frac{3}{2}{R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{2} & :=\\frac{3}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & \\frac{3}{2} & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second operation is ${R}_{1}↔{R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={E}_{2}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$\n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ 0 & \\frac{3}{2} & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A\n$$\n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$\n\n$$\n[\\begin{aligned}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & \\frac{3}{2} & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A\n$$" "First, let's find the elementary matrices corresponding to the two given elementary row operations.\n\n- The first operation is ${R}_{2}:=\\frac{3}{2}{R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{2} & :=\\frac{3}{2}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & \\frac{3}{2} & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second operation is ${R}_{1}↔{R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & ={E}_{2}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & \\frac{3}{2} & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A\n$$\n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$\n\n$$\n\\begin{bmatrix}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & \\frac{3}{2} & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A\n$$"] [:db/cas 17592186502096 :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(3,1)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{u}^{3}-v \\\\ v-u\\end{aligned}]?\n$$" "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(3,1)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}{u}^{3}-v \\\\ v-u\\end{bmatrix}?\n$$"]]
