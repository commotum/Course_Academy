bmatrix}4t \\\\ -2t \\\\ t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ \\frac{3}{4} \\\\ 3\\end{bmatrix}+t\\begin{bmatrix}4 \\\\ -2 \\\\ 1\\end{bmatrix} \\\\ r & =\\begin{bmatrix}2 \\\\ \\frac{3}{4} \\\\ 3\\end{bmatrix}+t\\begin{bmatrix}4 \\\\ -2 \\\\ 1\\end{bmatrix},\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$"] [:db/cas 17592186262683 :question/worked-solution "These parametric equations are equivalent to\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-3 \\\\ 5t \\\\ -2\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-3 \\\\ 0 \\\\ -2\\end{aligned}]+[\\begin{aligned}0 \\\\ 5t \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-3 \\\\ 0 \\\\ -2\\end{aligned}]+t[\\begin{aligned}0 \\\\ 5 \\\\ 0\\end{aligned}] \\\\ r & =[\\begin{aligned}-3 \\\\ 0 \\\\ -2\\end{aligned}]+t[\\begin{aligned}0 \\\\ 5 \\\\ 0\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$" "These parametric equations are equivalent to\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}-3 \\\\ 5t \\\\ -2\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}-3 \\\\ 0 \\\\ -2\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 5t \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}-3 \\\\ 0 \\\\ -2\\end{bmatrix}+t\\begin{bmatrix}0 \\\\ 5 \\\\ 0\\end{bmatrix} \\\\ r & =\\begin{bmatrix}-3 \\\\ 0 \\\\ -2\\end{bmatrix}+t\\begin{bmatrix}0 \\\\ 5 \\\\ 0\\end{bmatrix},\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$"] [:db/cas 17592186262684 :question/worked-solution "These parametric equations are equivalent to\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}11 \\\\ 3+7t \\\\ -5t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned