2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix} \\\\  & \\ne I,\\,\\times  \\\\ B & =\\begin{bmatrix}2 & 1 \\\\ 1 & 0\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =I\\,✓ \\\\ C & =\\begin{bmatrix}2 & 1 \\\\ -1 & 0\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}-1 & 0 \\\\ 2 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}-1 & 0 \\\\ 4 & 1\\end{bmatrix} \\\\  & \\ne I,\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"."] [:db/cas 17592186266000 :question/problem "Given the vectors\n${x}_{1}=[\\begin{aligned}-2\\text{i} \\\\ -1-4\\text{i}\\end{aligned}]$\nand\n${x}_{2}=[\\begin{aligned}-1+3\\text{i} \\\\ -3-4\\text{i}\\end{aligned}]$, then ${\\overset{―}{x}}_{1}+\\text{i}\\cdot {x}_{2}=$" "Given the vectors\n${x}_{1}=\\begin{bmatrix}-2\\text{i} \\\\ -1-4\\text{i}\\end{bmatrix}$\nand\n${x}_{2}=\\begin{bmatrix}-1+3\\text{i} \\\\ -3-4\\text{i}\\end{bmatrix}$, then ${\\overset{―}{x}}_{1}+\\text{i}\\cdot {x}_{2}=$"] [:db/cas 17592186266000 :question/worked-solution "To find the complex conjugate of a vector, we take the complex conjugate of the entries of the vector. So, we have\n\n$$\n\\begin{aligned}{\\overset{―}{x}}_{1} & =\\overset{―}{[\\begin{aligned}-2\\text{i} \\\\ -1-4\\text{i}\\end{aligned}]} \\\\  & =[\\begin{aligned}\\overset{―}{-2\\text{i}} \\\\ \\overset{―}{-1-4\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}2\\text{i} \\\\ -1+4\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nMultiplying the second vector, we get\n\n$$\n\\begin{aligned}\\text{i}\\cdot {x}_{2} & =\\text{i}\\cdot [\\begin{aligned}-1+3\\text{i} \\\\ -3-4\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}-\\text{i}+3{\\text{i}}^{2} \\\\ -3\\text{i}-4{\\text{i}}^{2}\\end{aligned}] \\\\  & =[\\begin{aligned}-3-\\text{i} \\\\ 4-3\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\overset{―}{x}}_{1}+\\text{i}\\cdot {x}_{2} & =[\\begin{aligned}2\\text{i} \\\\ -1+4\\text{i}\\end{aligned}]+[\\begin{aligned}-3-\\text{i} \\\\ 4-3\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}-3+\\text{i} \\\\ 3+\\text{i}\\end{aligned}].\\end{aligned}\n$$" "To find the complex conjugate of a vector, we take the complex conjugate of the entries of the vector. So, we have\n\n$$\n\\begin{aligned}{\\overset{―}{x}}_{1} & =\\overset{―}{\\begin{bmatrix}-2\\text{i} \\\\ -1-4\\text{i}\\end{bmatrix}} \\\\  & =\\begin{bmatrix}\\overset{―}{-2\\text{i}} \\\\ \\overset{―}{-1-4\\text{i}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\text{i} \\\\ -1+4\\text{i}\\end{bmatrix}.\\end{aligned}\n$$\n\nMultiplying the second vector, we get\n\n$$\n\\begin{aligned}\\text{i}\\cdot {x}_{2} & =\\text{i}\\cdot \\begin{bmatrix}-1+3\\text{i} \\\\ -3-4\\text{i}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\text{i}+3{\\text{i}}^{2} \\\\ -3\\text{i}-4{\\text{i}}^{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3-\\text{i} \\\\ 4-3\\text{i}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\overset{―}{x}}_{1}+\\text{i}\\cdot {x}_{2} & =\\begin{bmatrix}2\\text{i} \\\\ -1+4\\text{i}\\end{bmatrix}+\\begin{bmatrix}-3-\\text{i} \\\\ 4-3\\text{i}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3+\\text{i} \\\\ 3+\\text{i}\\end{bmatrix}.\\end{aligned}\n$$"] [:db/cas 17592186266001 :question/problem "If $\\,\\text{Re}(x)=[\\begin{aligned}a \\\\ b\\end{aligned}]\\,$ and $\\,\\text{Im}(x)=[\\begin{aligned}c \\\\ d\\end{aligned}]\\,$ are the real and imaginary parts of the vector $\\,x=[\\begin{aligned}1-3\\text{i} \\\\ -1-5\\text{i}\\end{aligned}]\\,$ then what is the value of $ac+bd?$" "If $\\,\\text{Re}(x)=\\begin{bmatrix}a \\\\ b\\end{bmatrix}\\,$ and $\\,\\text{Im}(x)=\\begin{bmatrix}c \\\\ d\\end{bmatrix}\\,$ are the real and imaginary parts of the vector $\\,x=\\begin{bmatrix}1-3\\text{i} \\\\ -1-5\\text{i}\\end{bmatrix}\\,$ then what is the value of $ac+bd?$"] [:db/cas 17592186266001 :question/worked-solution "For the given vector $\\,x=[\\begin{aligned}1-3\\text{i} \\\\ -1-5\\text{i}\\end{aligned}]\\,$ we have that\n\n$$\n\\begin{aligned}x & =[\\begin{aligned}1-3\\text{i} \\\\ -1-5\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}1 \\\\ -1\\end{aligned}]}_{⏟}}_{\\text{Re}(x)}+\\text{i}{{[\\begin{aligned}-3 \\\\ -5\\end{aligned}]}_{⏟}}_{\\text{Im}(x)}.\\end{aligned}\n$$\n\nTherefore $\\,a=1,b=-1,c=-3$ and $d=-5$, which implies that \n\n$$\nac+bd=1\\cdot (-3)+(-1)\\cdot (-5)=2.\n$$" "For the given vector $\\,x=\\begin{bmatrix}1-3\\text{i} \\\\ -1-5\\text{i}\\end{bmatrix}\\,$ we have that\n\n$$\n\\begin{aligned}x & =\\begin{bmatrix}1-3\\text{i} \\\\ -1-5\\text{i}\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}}_{⏟}}_{\\text{Re}(x)}+\\text{i}{{\\begin{bmatrix}-3 \\\\ -5\\end{bmatrix}}_{⏟}}_{\\text{Im}(x)}.\\end{aligned}\n$$\n\nTherefore $\\,a=1,b=-1,c=-3$ and $d=-5$, which implies that \n\n$$\nac+bd=1\\cdot (-3)+(-1)\\cdot (-5)=2.\n$$"] [:db/cas 17592186266002 :question/problem "Find the real and imaginary parts of the vector $v=[\\begin{aligned}\\text{i}+2 \\\\ 4-2\\text{i}\\end{aligned}].$" "Find the real and imaginary parts of the vector $v=\\begin{bmatrix}\\text{i}+2 \\\\ 4-2\\text{i}\\end{bmatrix}.$"] [:db/cas 17592186266002 :question/worked-solution "For the given vector $\\,v=[\\begin{aligned}2\\text{i}-1 \\\\ -\\text{i}\\end{aligned}]\\,$ we have that\n\n$$\n\\begin{aligned}v & =[\\begin{aligned}\\text{i}+2 \\\\ 4-2\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}2+\\text{i} \\\\ 4-2\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}2 \\\\ 4\\end{aligned}]}_{⏟}}_{\\text{Re}(v)}+\\text{i}\\,{{[\\begin{aligned}1 \\\\ -2\\end{aligned}]}_{⏟}}_{\\text{Im}(v)}.\\end{aligned}\n$$" "For the given vector $\\,v=\\begin{bmatrix}2\\text{i}-1 \\\\ -\\text{i}\\end{bmatrix}\\,$ we have that\n\n$$\n\\begin{aligned}v & =\\begin{bmatrix}\\text{i}+2 \\\\ 4-2\\text{i}\\end{bmatrix} \\\\  & =\\begin{bmatrix}2+\\text{i} \\\\ 4-2\\text{i}\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}}_{⏟}}_{\\text{Re}(v)}+\\text{i}\\,{{\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}}_{⏟}}_{\\text{Im}(v)}.\\end{aligned}\n$$"] [:db/cas 17592186266003 :question/problem "Find $\\text{Re}(k)$ given that\n$v=[\\begin{aligned}3 \\\\ 3+2\\text{i}\\end{aligned}]$\nand\n$\\overset{―}{kv}=[\\begin{aligned}18-18\\text{i} \\\\ 6-30\\text{i}\\end{aligned}].$" "Find $\\text{Re}(k)$ given that\n$v=\\begin{bmatrix}3 \\\\ 3+2\\text{i}\\end{bmatrix}$\nand\n$\\overset{―}{kv}=\\begin{bmatrix}18-18\\text{i} \\\\ 6-30\\text{i}\\end{bmatrix}.$"] [:db/cas 17592186266003 :question/worked-solution "Since $\\overset{―}{kv}=\\overset{―}{v},$ we get the following equation:\n\n$$\n\\begin{aligned}\\overset{―}{kv} & =\\overset{―}{k}\\,\\overset{―}{v} \\\\ [\\begin{aligned}18-18\\text{i} \\\\ 6-30\\text{i}\\end{aligned}] & =\\overset{―}{k}\\,\\overset{―}{[\\begin{aligned}3 \\\\ 3+2\\text{i}\\end{aligned}]} \\\\ [\\begin{aligned}18-18\\text{i} \\\\ 6-30\\text{i}\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}\\overset{―}{3} \\\\ \\overset{―}{3+2\\text{i}}\\end{aligned}] \\\\ [\\begin{aligned}18-18\\text{i} \\\\ 6-30\\text{i}\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}3 \\\\ 3-2\\text{i}\\end{aligned}] \\\\ [\\begin{aligned}18-18\\text{i} \\\\ 6-30\\text{i}\\end{aligned}] & =[\\begin{aligned}3\\overset{―}{k} \\\\ (3-2\\text{i})\\overset{―}{k}\\end{aligned}]\\end{aligned}\n$$\n\nSo, we obtain the system\n\n$$\n{\\begin{aligned}3\\overset{―}{k}=18-18\\text{i} \\\\ (3-2\\text{i})\\overset{―}{k}=6-30\\text{i}.\\end{aligned}\n$$\n\nFrom the first equation, we get\n\n$$\n\\overset{―}{k}=6-6\\text{i}\n$$\n\nSubstituting this into the second equation, we obtain the true statement\n\n$$\n(3-2\\text{i})(6-6\\text{i})=6-30\\text{i}\n$$\n\nTherefore, $k=\\overset{―}{6-6\\text{i}}=6+6\\text{i}.$\n\nFinally, $\\text{Re}(k)=6.$" "Since $\\overset{―}{kv}=\\overset{―}{v},$ we get the following equation:\n\n$$\n\\begin{aligned}\\overset{―}{kv} & =\\overset{―}{k}\\,\\overset{―}{v} \\\\ \\begin{bmatrix}18-18\\text{i} \\\\ 6-30\\text{i}\\end{bmatrix} & =\\overset{―}{k}\\,\\overset{―}{\\begin{bmatrix}3 \\\\ 3+2\\text{i}\\end{bmatrix}} \\\\ \\begin{bmatrix}18-18\\text{i} \\\\ 6-30\\text{i}\\end{bmatrix} & =\\overset{―}{k}\\,\\begin{bmatrix}\\overset{―}{3} \\\\ \\overset{―}{3+2\\text{i}}\\end{bmatrix} \\\\ \\begin{bmatrix}18-18\\text{i} \\\\ 6-30\\text{i}\\end{bmatrix} & =\\overset{―}{k}\\,\\begin{bmatrix}3 \\\\ 3-2\\text{i}\\end{bmatrix} \\\\ \\begin{bmatrix}18-18\\text{i} \\\\ 6-30\\text{i}\\end{bmatrix} & =\\begin{bmatrix}3\\overset{―}{k} \\\\ (3-2\\text{i})\\overset{―}{k}\\end{bmatrix}\\end{aligned}\n$$\n\nSo, we obtain the system\n\n$$\n{\\begin{aligned}3\\overset{―}{k}=18-18\\text{i} \\\\ (3-2\\text{i})\\overset{―}{k}=6-30\\text{i}.\\end{aligned}\n$$\n\nFrom the first equation, we get\n\n$$\n\\overset{―}{k}=6-6\\text{i}\n$$\n\nSubstituting this into the second equation, we obtain the true statement\n\n$$\n(3-2\\text{i})(6-6\\text{i})=6-30\\text{i}\n$$\n\nTherefore, $k=\\overset{―}{6-6\\text{i}}=6+6\\text{i}.$\n\nFinally, $\\text{Re}(k)=6.$"] [:db/cas 17592186266004 :question/problem "Find $\\text{Re}(k)$ given that\n$v=[\\begin{aligned}4 \\\\ -5-\\text{i}\\end{aligned}]$\nand\n$\\overset{―}{kv}=[\\begin{aligned}-20+28\\text{i} \\\\ 18-40\\text{i}\\end{aligned}].$" "Find $\\text{Re}(k)$ given that\n$v=\\begin{bmatrix}4 \\\\ -5-\\text{i}\\end{bmatrix}$\nand\n$\\overset{―}{kv}=\\begin{bmatrix}-20+28\\text{i} \\\\ 18-40\\text{i}\\end{bmatrix}.$"] [:db/cas 17592186266004 :question/worked-solution "Since $\\overset{―}{kv}=\\overset{―}{v},$ we get the following equation:\n\n$$\n\\begin{aligned}\\overset{―}{kv} & =\\overset{―}{k}\\,\\overset{―}{v} \\\\ [\\begin{aligned}-20+28\\text{i} \\\\ 18-40\\text{i}\\end{aligned}] & =\\overset{―}{k}\\,\\overset{―}{[\\begin{aligned}4 \\\\ -5-\\text{i}\\end{aligned}]} \\\\ [\\begin{aligned}-20+28\\text{i} 