\\end{aligned}]=[\\begin{aligned}4 & 3 \\\\ -3 & 4\\end{aligned}]=C.\n$$\n\nNext, we can find the real and imaginary parts of our eigenvector:\n\n$$\n\\begin{aligned}v & =[\\begin{aligned}-1+\\text{i} \\\\ 2\\end{aligned}]={{[\\begin{aligned}-1 \\\\ 2\\end{aligned}]}_{⏟}}_{\\text{Re}(v)}+\\text{i}{{[\\begin{aligned}1 \\\\ 0\\end{aligned}]}_{⏟}}_{\\text{Im}(v)}\\end{aligned}\n$$\n\nFinally, we can now construct $P:$ \n\n$$\n\\begin{aligned}P & =[\\begin{aligned}| & | \\\\ \\text{Re}(v) & \\text{Im}(v) \\\\ | & |\\end{aligned}]=[\\begin{aligned}-1 & 1 \\\\ 2 & 0\\end{aligned}].\\end{aligned}\n$$" "Recall that for any $2\\times 2$ real matrix $A$ with complex eigenvalues, we have $A=PC{P}^{-1},$ where \n\n$$\nP=\\begin{bmatrix}| & | \\\\ \\text{Re}(v) & \\text{Im}(v) \\\\ | & |\\end{bmatrix},\\,C=\\begin{bmatrix}\\text{Re}(\\lambda ) & \\text{Im}(\\lambda ) \\\\ -\\text{Im}(\\lambda ) & \\text{Re}(\\lambda )\\end{bmatrix},\n$$\n\nand $v$ is an eigenvector of $A$ corresponding to the complex eigenvalue  $\\lambda .$\n\nFirst, notice that \n\n$$\n\\begin{bmatrix}\\text{Re}(\\lambda ) & \\text{Im}(\\lambda ) \\\\ -\\text{Im}(\\lambda ) & \\text{Re}(\\lambda )\\end{bmatrix}=\\begin{bmatrix}4 & 3 \\\\ -3 & 4\\end{bmatrix}=C.\n$$\n\nNext, we can find the real and imaginary parts of our eigenvector:\n\n$$\n\\begin{aligned}v & =\\begin{bmatrix}-1+\\text{i} \\\\ 2\\end{bmatrix}={{\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}}_{⏟}}_{\\text{Re}(v)}+\\text{i}{{\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}}_{⏟}}_{\\text{Im}(v)}\\end{aligned}\n$$\n\nFinally, we can now construct $P:$ \n\n$$\n\\begin{aligned}P & =\\begin{bmatrix}| & | \\\\ \\text{Re}(v) & \\text{Im}(v) \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}-1 & 1 \\\\ 2 & 0\\end{bmatrix}.\\end{aligned}\n$$"] [:db/cas 17592186410864 :answer/value "r=s[\\begin{aligned}-1 \\\\ 2 \\\\ 0\\end{aligned}]+t[\\begin{aligned}-5 \\\\ 1.5 \\\\ 2\\end{aligned}],\\,s,t\\in (-\\infty ,\\infty )" "r=s\\begin{bmatrix}-1 \\\\ 2 \\\\ 0\\end{bmatrix}+t\\begin{bma