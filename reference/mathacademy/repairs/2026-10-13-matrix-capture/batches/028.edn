frac{5}{4}\\end{bmatrix}"] [:db/cas 17592186432491 :answer/value "[x]_{C}=[\\begin{aligned}1 \\\\ 10 \\\\ -1\\end{aligned}]" "[x]_{C}=\\begin{bmatrix}1 \\\\ 10 \\\\ -1\\end{bmatrix}"] [:db/cas 17592186432492 :answer/value "[x]_{B}=[\\begin{aligned}-4 \\\\ 3\\end{aligned}]" "[x]_{B}=\\begin{bmatrix}-4 \\\\ 3\\end{bmatrix}"] [:db/cas 17592186432493 :answer/value "[x]_{C}=[\\begin{aligned}1 \\\\ 5 \\\\ -1\\end{aligned}]" "[x]_{C}=\\begin{bmatrix}1 \\\\ 5 \\\\ -1\\end{bmatrix}"] [:db/cas 17592186432498 :question/problem "Let $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ be a basis of ${R}^{3}$ and $[x]_{B}=[\\begin{aligned}1 \\\\ 10 \\\\ -7\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2},{c}_{3}\\},$ where ${c}_{1}=-7{b}_{3}$, ${c}_{2}=2{b}_{2}$ and ${c}_{3}=-{b}_{1}?$" "Let $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ be a basis of ${R}^{3}$ and $[x]_{B}=\\begin{bmatrix}1 \\\\ 10 \\\\ -7\\end{bmatrix}.$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2},{c}_{3}\\},$ where ${c}_{1}=-7{b}_{3}$, ${c}_{2}=2{b}_{2}$ and ${c}_{3}=-{b}_{1}?$"] [:db/cas 17592186432498 :question/worked-solution "Since $[x]_{B}=[\\begin{aligned}1 \\\\ 10 \\\\ -7\\end{aligned}]$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & ={b}_{1}+10{b}_{2}-7{b}_{3} \\\\  & =-7{b}_{3}+10{b}_{2}+{b}_{1} \\\\  & =-7{b}_{3}+5(2{b}_{2})-(-{b}_{1}) \\\\  & ={c}_{1}+5{c}_{2}-{c}_{3}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}1 \\\\ 5 \\\\ -1\\end{aligned}].$" "Since $[x]_{B}=\\begin{bmatrix}1 \\\\ 10 \\\\ -7\\end{bmatrix}$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & ={b}_{1}+10{b}_{2}-7{b}_{3} \\\\  & =-7{b}_{3}+10{b}_{2}+{b}_{1} \\\\  & =-7{b}_{3}+5(2{b}_{2})-(-{b}_{1}) \\\\  & ={c}_{1}+5{c}_{2}-{c}_{3}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=\\begin{bmatrix}1 \\\\ 5 \\\\ -1\\end{bmatrix}.$"] [:db/cas 17592186432499 :question/problem "Let $B=\\{{b}_{1},{b}_{2}\\}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}-1 \\\\ 3\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2}\\},$ where ${c}_{1}=2{b}_{1}+{b}_{2}$ and ${c}_{2}=-{b}_{1}?$" "Let $B=\\{{b}_{1},{b}_{2}\\}$ be a basis of ${R}^{2}$ and $[x]_{B}=\\begin{bmatrix}-1 \\\\ 3\\end{bmatrix}.$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2}\\},$ where ${c}_{1}=2{b}_{1}+{b}_{2}$ and ${c}_{2}=-{b}_{1}?$"] [:db/cas 17592186432499 :question/worked-solution "We are given that\n\n$$\n\\{\\begin{aligned}{c}_{1}=2{b}_{1}+{b}_{2} \\\\ {c}_{2}=-{b}_{1}.\\end{aligned}\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. From the second equation, we get \n\n$$\n{b}_{1}=-{c}_{2}.\n$$\n\nSubstituting this into the first equation, we obtain\n\n$$\n{c}_{1}=2(-{c}_{2})+{b}_{2}\\,⟹\\,{b}_{2}={c}_{1}+2{c}_{2}.\n$$\n\nSince $[x]_{B}=[\\begin{aligned}-1 \\\\ 3\\end{aligned}]$, we can write the vector $x$ as follows: \n\n$$\n\\begin{aligned}x & =-{b}_{1}+3{b}_{2} \\\\  & =-(-{c}_{2})+3({c}_{1}+2{c}_{2}) \\\\  & ={c}_{2}+3{c}_{1}+6{c}_{2} \\\\  & =7{c}_{2}+3{c}_{1}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}3 \\\\ 7\\end{aligned}].$" "We are given that\n\n$$\n\\{\\begin{aligned}{c}_{1}=2{b}_{1}+{b}_{2} \\\\ {c}_{2}=-{b}_{1}.\\end{aligned}\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. From the second equation, we get \n\n$$\n{b}_{1}=-{c}_{2}.\n$$\n\nSubstituting this into the first equation, we obtain\n\n$$\n{c}_{1}=2(-{c}_{2})+{b}_{2}\\,⟹\\,{b}_{2}={c}_{1}+2{c}_{2}.\n$$\n\nSince $[x]_{B}=\\begin{bmatrix}-1 \\\\ 3\\end{bmatrix}$, we can write the vector $x$ as follows: \n\n$$\n\\begin{aligned}x & =-{b}_{1}+3{b}_{2} \\\\  & =-(-{c}_{2})+3({c}_{1}+2{c}_{2}) \\\\  & ={c}_{2}+3{c}_{1}+6{c}_{2} \\\\  & =7{c}_{2}+3{c}_{1}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=\\begin{bmatrix}3 \\\\ 7\\end{bmatrix}.$"] [:db/cas 17592186432500 :question/problem "Let $C=\\{{c}_{1},{c}_{2}\\}$ be a basis of ${R}^{2}$ and $[x]_{C}=[\\begin{aligned}-3 \\\\ -5\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $B=\\{{b}_{1},{b}_{2}\\},$ where ${b}_{1}=4{c}_{2}$ and ${b}_{2}=-2{c}_{1}?$" "Let $C=\\{{c}_{1},{c}_{2}\\}$ be a basis of ${R}^{2}$ and $[x]_{C}=\\begin{bmatrix}-3 \\\\ -5\\end{bmatrix}.$ What are the coordinates of $x$ relative to the basis $B=\\{{b}_{1},{b}_{2}\\},$ where ${b}_{1}=4{c}_{2}$ and ${b}_{2}=-2{c}_{1}?$"] [:db/cas 17592186432500 :question/worked-solution "Since $[x]_{C}=[\\begin{aligned}-3 \\\\ -5\\end{aligned}]$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & =-3{c}_{1}-5{c}_{2} \\\\  & =-5{c}_{2}-3{c}_{1} \\\\  & =-5({c}_{2})+3(-{c}_{1}) \\\\  & =-\\frac{5}{4}(4{c}_{2})+\\frac{3}{2}(-2{c}_{1}) \\\\  & =-\\frac{5}{4}{b}_{1}+\\frac{3}{2}{b}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}-\\frac{5}{4} \\\\ \\frac{3}{2}\\end{aligned}].$" "Since $[x]_{C}=\\begin{bmatrix}-3 \\\\ -5\\end{bmatrix}$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & =-3{c}_{1}-5{c}_{2} \\\\  & =-5{c}_{2}-3{c}_{1} \\\\  & =-5({c}_{2})+3(-{c}_{1}) \\\\  & =-\\frac{5}{4}(4{c}_{2})+\\frac{3}{2}(-2{c}_{1}) \\\\  & =-\\frac{5}{4}{b}_{1}+\\frac{3}{2}{b}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{B}=\\begin{bmatrix}-\\frac{5}{4} \\\\ \\frac{3}{2}\\end{bmatrix}.$"] [:db/cas 17592186432501 :question/problem "Let $B=\\{{b}_{1},{b}_{2}\\}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}6 \\\\ 4\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2}\\},$ where ${c}_{1}=-8{b}_{2}$ and ${c}_{2}=3{b}_{1}?$" "Let $B=\\{{b}_{1},{b}_{2}\\}$ be a basis of ${R}^{2}$ and $[x]_{B}=\\begin{bmatrix}6 \\\\ 4\\end{bmatrix}.$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2}\\},$ where ${c}_{1}=-8{b}_{2}$ and ${c}_{2}=3{b}_{1}?$"] [:db/cas 17592186432501 :question/worked-solution "Since $[x]_{B}=[\\begin{aligned}6 \\\\ 4\\end{aligned}]$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & =6{b}_{1}+4{b}_{2} \\\\  & =4{b}_{2}+6{b}_{1} \\\\  & =-(-4{b}_{2})+2(3{b}_{1}) \\\\  & =-\\frac{1}{2}(-8{b}_{2})+2(3{b}_{1}) \\\\  & =-\\frac{1}{2}{c}_{1}+2{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}-\\frac{1}{2} \\\\ 2\\end{aligned}].$" "Since $[x]_{B}=\\begin{bmatrix}6 \\\\ 4\\end{bmatrix}$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & =6{b}_{1}+4{b}_{2} \\\\  & =4{b}_{2}+6{b}_{1} \\\\  & =-(-4{b}_{2})+2(3{b}_{1}) \\\\  & =-\\frac{1}{2}(-8{b}_{2})+2(3{b}_{1}) \\\\  & =-\\frac{1}{2}{c}_{1}+2{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=\\begin{bmatrix}-\\frac{1}{2} \\\\ 2\\end{bmatrix}.$"] [:db/cas 17592186432586 :answer/value "\\frac{1}{25}[\\begin{aligned}1 & -2 & 0 \\\\ -2 & 4 & 0\\end{aligned}]" "\\frac{1}{25}\\begin{bmatrix}1 & -2 & 0 \\\\ -2 & 4 & 0\\end{bmatrix}"] [:db/cas 17592186432587 :answer/value "\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 & 1 \\\\ 0 & 0\\end{aligned}]" "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 & 1 \\\\ 0 & 0\\end{bmatrix}"] [:db/cas 17592186432588 :answer/value "\\frac{1}{16}[\\begin{aligned}1 & -2 \\\\ -2 & 4 \\\\ 0 & 0\\end{aligned}]" "\\frac{1}{16}\\begin{bmatrix}1 & -2 \\\\ -2 & 4 \\\\ 0 & 0\\end{bmatrix}"] [:db/cas 17592186432589 :answer/value "\\frac{1}{\\sqrt{10}}[\\begin{aligned}2 & -2 \\\\ -1 & 1\\end{aligned}]" "\\frac{1}{\\sqrt{10}}\\begin{bmatrix}2 & -2 \\\\ -1 & 1\\end{bmatrix}"] [:db/cas 17592186432590 :answer/value "\\frac{1}{16}[\\begin{aligned}1 & -2 & 0 \\\\ -2 & 4 & 0\\end{aligned}]" "\\frac{1}{16}\\begin{bmatrix}1 & -2 & 0 \\\\ -2 & 4 & 0\\end{bmatrix}"] [:db/cas 17592186432591 :answer/value "\\frac{1}{4}[\\begin{aligned}1 & -1 \\\\ -1 & 1\\end{aligned}]" "\\frac{1}{4}\\begin{bmatrix}1 & -1 \\\\ -1 & 1\\end{bmatrix}"] [:db/cas 17592186432592 :answer/value "\\frac{1}{4}[\\begin{aligned}1 & 1 \\\\ 1 & 1\\end{aligned}]" "\\frac{1}{4}\\begin{bmatrix}1 & 1 \\\\ 1 & 1\\end{bmatrix}"] [:db/cas 17592186432593 :answer/value "\\frac{1}{2}[\\begin{aligned}1 & 1 \\\\ 1 & 1\\end{aligned}]" "\\frac{1}{2}\\begin{bmatrix}1 & 1 \\\\ 1 & 1\\end{bmatrix}"] [:db/cas 17592186432594 :answer/value "\\frac{1}{25}[\\begin{aligned}-2 & 1 \\\\ 4 & -2 \\\\ 0 & 0\\end{aligned}]" "\\frac{1}{25}\\begin{bmatrix}-2 & 1 \\\\ 4 & -2 \\\\ 0 & 0\\end{bmatrix}"] [:db/cas 17592186432595 :answer/value "\\frac{1}{25}[\\begin{aligned}-2 & 4 & 0 \\\\ 1 & -2 & 0\\end{aligned}]" "\\frac{1}{25}\\begin{bmatrix}-2 & 4 & 0 \\\\ 1 & -2 & 0\\end{bmatrix}"] [:db/cas 17592186432597 :question/problem "$$\nU=[\\begin{aligned}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}],\\,Σ=[\\begin{aligned}2 & 0 \\\\ 0 & 0\\end{aligned}],\\,V=[\\begin{aligned}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ find the pseudoinverse ${A}^{+}.$" "$$\nU=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix},\\,Σ=\\begin{bmatrix}2 & 0 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ find the pseudoinverse ${A}^{+}.$"] [:db/cas 17592186432597 :question/worked-solution "If $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\nV\\,{Σ}^{+}\\,{U}^{T},\n$$\n\nwhere ${Σ}^{+}$ is the pseudoinverse of $Σ.$\n\nFirst, notice that\n\n$$\nV=\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 & 1 \\\\ 1 & 1\\end{aligned}],\\,{Σ}^{+}=\\frac{1}{2}[\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}],\\,{U}^{T}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 & 1 \\\\ 1 & 1\\end{aligned}].\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & =V\\,{Σ}^{+}\\,{U}^{T} \\\\  & =\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 & 1 \\\\ 1 & 1\\end{aligned}]\\cdot \\frac{1}{2}[\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}]\\cdot \\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 & 1 \\\\ 1 & 1\\end{aligned}] \\\\  & =\\frac{1}{4}[\\begin{aligned}-1 & 1 \\\\ 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}]\\cdot [\\begin{aligned}-1 & 1 \\\\ 1 & 1\\end{aligned}] \\\\  & =\\frac{1}{4}[\\begin{aligned}-1 & 0 \\\\ 1 & 0\\end{aligned}]\\cdot [\\begin{aligned}-1 & 1 \\\\ 1 & 1\\end{aligned}] \\\\  & =\\frac{1}{4}[\\begin{aligned}1 & -1 \\\\ -1 & 1\\end{aligned}].\\end{aligned}\n$$" "If $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\nV\\,{Σ}^{+}\\,{U}^{T},\n$$\n\nwhere ${Σ}^{+}$ is the pseudoinverse of $Σ.$\n\nFirst, notice that\n\n$$\nV=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix},\\,{Σ}^{+}=\\frac{1}{2}\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\,{U}^{T}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & =V\\,{Σ}^{+}\\,{U}^{T} \\\\  & =\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix}\\cdot \\frac{1}{2}\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{4}\\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{4}\\begin{bmatrix}-1 & 0 \\\\ 1 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{4}\\begin{bmatrix}1 & -1 \\\\ -1 & 1\\end{bmatrix}.\\end{aligned}\n$$"] [:db/cas 17592186433149 :question/problem "Consider the orthogonal set $U$ below. By adding a new vector $x=[{x}_{1},\\,{x}_{2},\\,{x}_{3}]^{T},$ extend the set so that it forms an orthogonal basis of ${R}^{3}.$ What is the value of $\\frac{{x}_{1}}{{x}_{2}}?$\n\n$$\nU=\\{[\\begin{aligned}4 \\\\ 2 \\\\ 3\\end{aligned}],[\\begin{aligned}1 \\\\ -2 \\\\ 0\\end{aligned}]\\}\n$$" "Consider the orthogonal set $U$ below. By adding a new vector $x=[{x}_{1},\\,{x}_{2},\\,{x}_{3}]^{T},$ extend the set so that it forms an orthogonal basis of ${R}^{3}.$ What is the value of $\\frac{{x}_{1}}{{x}_{2}}?$\n\n$$\nU=\\{\\begin{bmatrix}4 \\\\ 2 \\\\ 3\\end{bmatrix},\\begin{bmatrix}1 \\\\ -2 \\\\ 0\\end{bmatrix}\\}\n$$"] [:db/cas 17592186433149 :question/worked-solution "Let's denote the vectors of $U$ as ${u}_{1},\\,{u}_{2}.$ To extend the given set to an orthogonal basis of ${R}^{3}$, we need to find a third vector $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]$ such that\n\n$$\n\\{\\begin{aligned}{u}_{1}\\cdot x=0 \\\\ {u}_{2}\\cdot x=0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}4{x}_{1}+2{x}_{2}+3{x}_{3}=0 \\\\ {x}_{1}+-2{x}_{2}=0.\\end{aligned}\n$$\n\nNow, we consider the augmented matrix $M$ of the system above and reduce it to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}4 & 2 & 3 & 0 \\\\ 1 & -2 & 0 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+(-\\frac{1}{4}){R}_{1} \\\\  & ∼[\\begin{aligned}4 & 2 & 3 & 0 \\\\ 0 & -\\frac{5}{2} & -\\frac{3}{4} & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, there are two pivot columns ($1$st and $2$nd). Thus, ${x}_{3}$ is a free variable. From the second equation, we get ${x}_{2}=-\\frac{3}{10}{x}_{3}.$ Substituting this into the first equation, we obtain\n\n$$\n\\begin{aligned}4{x}_{1}+2(-\\frac{3}{10}{x}_{3})+3{x}_{3}=0\\,⟹\\,{x}_{1}=(-\\frac{3}{5}){x}_{3}.\\end{aligned}\n$$\n\nSo, the general solution is\n\n$$\n[\\begin{aligned}-\\frac{3}{5}{x}_{3} \\\\ -\\frac{3}{10}{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in R.\n$$\n\nSetting ${x}_{3}=10,$ we obtain the vector \n\n$$\nx=[\\begin{aligned}-6 \\\\ -3 \\\\ 10\\end{aligned}].\n$$\n\nTherefore, an orthogonal basis of ${R}^{3}$ is\n\n$$\n\\{[\\begin{aligned}4 \\\\ 2 \\\\ 3\\end{aligned}],[\\begin{aligned}1 \\\\ -2 \\\\ 0\\end{aligned}],[\\begin{aligned}-6 \\\\ -3 \\\\ 10\\end{aligned}]\\}.\n$$\n\nFinally, $\\frac{{x}_{1}}{{x}_{2}}=\\frac{-6}{-3}=2.$" "Let's denote the vectors of $U$ as ${u}_{1},\\,{u}_{2}.$ To extend the given set to an orthogonal basis of ${R}^{3}$, we need to find a third vector $x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}$ such that\n\n$$\n\\{\\begin{aligned}{u}_{1}\\cdot x=0 \\\\ {u}_{2}\\cdot x=0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}4{x}_{1}+2{x}_{2}+3{x}_{3}=0 \\\\ {x}_{1}+-2{x}_{2}=0.\\end{aligned}\n$$\n\nNow, we consider the augmented matrix $M$ of the system above and reduce it to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}4 & 2 & 3 & 0 \\\\ 1 & -2 & 0 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-\\frac{1}{4}){R}_{1} \\\\  & ∼\\begin{bmatrix}4 & 2 & 3 & 0 \\\\ 0 & -\\frac{5}{2} & -\\frac{3}{4} & 0\\end{bmatrix}\\end{aligned}\n$$\n\nIn the reduced matrix above, there are two pivot columns ($1$st and $2$nd). Thus, ${x}_{3}$ is a free variable. From the second equation, we get ${x}_{2}=-\\frac{3}{10}{x}_{3}.$ Substituting this into the first equation, we obtain\n\n$$\n\\begin{aligned}4{x}_{1}+2(-\\frac{3}{10}{x}_{3})+3{x}_{3}=0\\,⟹\\,{x}_{1}=(-\\frac{3}{5}){x}_{3}.\\end{aligned}\n$$\n\nSo, the general solution is\n\n$$\n\\begin{bmatrix}-\\frac{3}{5}{x}_{3} \\\\ -\\frac{3}{10}{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in R.\n$$\n\nSetting ${x}_{3}=10,$ we obtain the vector \n\n$$\nx=\\begin{bmatrix}-6 \\\\ -3 \\\\ 10\\end{bmatrix}.\n$$\n\nTherefore, an orthogonal basis of ${R}^{3}$ is\n\n$$\n\\{\\begin{bmatrix}4 \\\\ 2 \\\\ 3\\end{bmatrix},\\begin{bmatrix}1 \\\\ -2 \\\\ 0\\end{bmatrix},\\begin{bmatrix}-6 \\\\ -3 \\\\ 10\\end{bmatrix}\\}.\n$$\n\nFinally, $\\frac{{x}_{1}}{{x}_{2}}=\\frac{-6}{-3}=2.$"] [:db/cas 17592186433150 :question/problem "Which of the following sets are orthogonal?\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $U=\\{[\\begin{aligned}-2 \\\\ -1\\end{aligned}],[\\begin{aligned}3 \\\\ 2\\end{aligned}],[\\begin{aligned}15 \\\\ -20\\end{aligned}]\\}$\n\n- **II.** $V=\\{[\\begin{aligned}0 \\\\ 5\\end{aligned}],[\\begin{aligned}1 \\\\ 2\\end{aligned}]\\}$\n\n- **III.** $W=\\{[\\begin{aligned}6 \\\\ 1 \\\\ -1\\end{aligned}],[\\begin{aligned}2 \\\\ 3 \\\\ 1\\end{aligned}],[\\begin{aligned}0 \\\\ -1 \\\\ 0\\end{aligned}]\\}$" "Which of the following sets are orthogonal?\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $U=\\{\\begin{bmatrix}-2 \\\\ -1\\end{bmatrix},\\begin{bmatrix}3 \\\\ 2\\end{bmatrix},\\begin{bmatrix}15 \\\\ -20\\end{bmatrix}\\}$\n\n- **II.** $V=\\{\\begin{bmatrix}0 \\\\ 5\\end{bmatrix},\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}\\}$\n\n- **III.** $W=\\{\\begin{bmatrix}6 \\\\ 1 \\\\ -1\\end{bmatrix},\\begin{bmatrix}2 \\\\ 3 \\\\ 1\\end{bmatrix},\\begin{bmatrix}0 \\\\ -1 \\\\ 0\\end{bmatrix}\\}$"] [:db/cas 17592186433150 :question/worked-solution "Let's denote the vectors of the given sets as \n$\\{{u}_{1},{u}_{2},{u}_{3}\\},$ \n$\\{{v}_{1},{v}_{2}\\},$ and \n$\\{{w}_{1},{w}_{2},{w}_{3}\\},$ respectively. \n\nThe sets $U,V,$ and $W$ are orthogonal if the following conditions on each set hold:\n\n- ${u}_{1}\\cdot {u}_{2}=0,\\,{u}_{1}\\cdot {u}_{3}=0,\\,{u}_{2}\\cdot {u}_{3}=0.$\n\n- ${v}_{1}\\cdot {v}_{2}=0.$\n\n- ${w}_{1}\\cdot {w}_{2}=0,\\,{w}_{1}\\cdot {w}_{3}=0,\\,{w}_{2}\\cdot {w}_{3}=0.$\n\nWith that in mind, let's examine our sets in turn.\n\n- The set $U$ cannot be orthogonal since it contains  $3$ vectors from ${R}^{2}$ (in which we can have an orthogonal set with at most 2 non-zero vectors). Therefore, $U$ is not an orthogonal set.\n\n- For the set $V,$ notice that\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {v}_{2} & =[\\begin{aligned}0 \\\\ 5\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 2\\end{aligned}]=0+10=10\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthogonal set.\n\n- For the set $W,$ notice that \n\n$$\n\\begin{aligned}{w}_{1}\\cdot {w}_{2} & =[\\begin{aligned}6 \\\\ 1 \\\\ -1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 3 \\\\ 1\\end{aligned}]=12+3-1=14\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $W$ is not an orthogonal set.\n\nTherefore, we conclude that the correct answer is \"None of the listed\"." "Let's denote the vectors of the given sets as \n$\\{{u}_{1},{u}_{2},{u}_{3}\\},$ \n$\\{{v}_{1},{v}_{2}\\},$ and \n$\\{{w}_{1},{w}_{2},{w}_{3}\\},$ respectively. \n\nThe sets $U,V,$ and $W$ are orthogonal if the following conditions on each set hold:\n\n- ${u}_{1}\\cdot {u}_{2}=0,\\,{u}_{1}\\cdot {u}_{3}=0,\\,{u}_{2}\\cdot {u}_{3}=0.$\n\n- ${v}_{1}\\cdot {v}_{2}=0.$\n\n- ${w}_{1}\\cdot {w}_{2}=0,\\,{w}_{1}\\cdot {w}_{3}=0,\\,{w}_{2}\\cdot {w}_{3}=0.$\n\nWith that in mind, let's examine our sets in turn.\n\n- The set $U$ cannot be orthogonal since it contains  $3$ vectors from ${R}^{2}$ (in which we can have an orthogonal set with at most 2 non-zero vectors). Therefore, $U$ is not an orthogonal set.\n\n- For the set $V,$ notice that\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {v}_{2} & =\\begin{bmatrix}0 \\\\ 5\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 2\\end{bmatrix}=0+10=10\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthogonal set.\n\n- For the set $W,$ notice that \n\n$$\n\\begin{aligned}{w}_{1}\\cdot {w}_{2} & =\\begin{bmatrix}6 \\\\ 1 \\\\ -1\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ 3 \\\\ 1\\end{bmatrix}=12+3-1=14\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $W$ is not an orthogonal set.\n\nTherefore, we conclude that the correct answer is \"None of the listed\"."] [:db/cas 17592186433151 :question/problem "Consider the **orthonormal** set $U$ below. By adding a new vector $x=[{x}_{1},\\,{x}_{2},\\,{x}_{3}]^{T},$ extend the set so that it forms an **orthonormal** basis of ${R}^{3}.$ What is the value of $|{x}_{1}|+|{x}_{2}|+|{x}_{3}|?$\n\n$$\nU=\\{[\\begin{aligned}\\frac{1}{\\sqrt{6}} \\\\ \\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{6}}\\end{aligned}],[\\begin{aligned}\\frac{2}{\\sqrt{21}} \\\\ \\frac{1}{\\sqrt{21}} \\\\ -\\frac{4}{\\sqrt{21}}\\end{aligned}]\\}\n$$" "Consider the **orthonormal** set $U$ below. By adding a new vector $x=[{x}_{1},\\,{x}_{2},\\,{x}_{3}]^{T},$ extend the set so that it forms an **orthonormal** basis of ${R}^{3}.$ What is the value of $|{x}_{1}|+|{x}_{2}|+|{x}_{3}|?$\n\n$$\nU=\\{\\begin{bmatrix}\\frac{1}{\\sqrt{6}} \\\\ \\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{6}}\\end{bmatrix},\\begin{bmatrix}\\frac{2}{\\sqrt{21}} \\\\ \\frac{1}{\\sqrt{21}} \\\\ -\\frac{4}{\\sqrt{21}}\\end{bmatrix}\\}\n$$"] [:db/cas 17592186433151 :question/worked-solution "Let's denote the vectors of $U$ as ${u}_{1},\\,{u}_{2}.$ To extend the given set to an orthonormal basis of ${R}^{3}$, we need to find a third vector $x$ such that $‖x‖=1,$ and\n\n$$\n\\{\\begin{aligned}{u}_{1}\\cdot x=0 \\\\ {u}_{2}\\cdot x=0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}\\frac{1}{\\sqrt{6}}{x}_{1}+\\frac{2}{\\sqrt{6}}{x}_{2}+\\frac{1}{\\sqrt{6}}{x}_{3}=0 \\\\ \\frac{2}{\\sqrt{21}}{x}_{1}+\\frac{1}{\\sqrt{21}}{x}_{2}-\\frac{4}{\\sqrt{21}}{x}_{3}=0.\\end{aligned}\n$$\n\nNow, we consider the augmented matrix $M$ of the system above and reduce it to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}\\frac{1}{\\sqrt{6}} & \\frac{2}{\\sqrt{6}} & \\frac{1}{\\sqrt{6}} & 0 \\\\ \\frac{2}{\\sqrt{21}} & \\frac{1}{\\sqrt{21}} & -\\frac{4}{\\sqrt{21}} & 0\\end{aligned}] &  & \\begin{aligned}{R}_{1}:=\\sqrt{6}\\cdot {R}_{1} \\\\ {R}_{2}:=\\sqrt{21}\\cdot {R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 2 & 1 & 0 \\\\ 2 & 1 & -4 & 0\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}-2{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 2 & 1 & 0 \\\\ 0 & -3 & -6 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, there are two pivot columns ($1$st and $2$nd). Thus, ${x}_{3}$ is a free variable. From the second equation, we get ${x}_{2}=-2{x}_{3}.$ Substituting this into the first equation, we obtain \n\n$$\n{x}_{1}+2(-2{x}_{3})+{x}_{3}=0\\,⟹\\,{x}_{1}=3{x}_{3}.\n$$\n\nSo, the general solution is\n\n$$\n[\\begin{aligned}3{x}_{3} \\\\ -2{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in R.\n$$\n\nSetting ${x}_{3}=1,$ we obtain the vector \n$x=[\\begin{aligned}3 \\\\ -2 \\\\ 1\\end{aligned}].$ \n\nNow, we need to normalize $x.$ Notice that $‖x‖=\\sqrt{{3}^{2}+(-2)^{2}+{1}^{2}}=\\sqrt{14}.$ So, we normalize $x$ as follows:\n\n$$\n\\frac{x}{‖x‖}=[\\begin{aligned}\\frac{3}{\\sqrt{14}} \\\\ -\\frac{2}{\\sqrt{14}} \\\\ \\frac{1}{\\sqrt{14}}\\end{aligned}]\n$$\n\nTherefore, an orthonormal basis of ${R}^{3}$ is\n\n$$\n\\{[\\begin{aligned}\\frac{1}{\\sqrt{6}} \\\\ \\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{6}}\\end{aligned}],[\\begin{aligned}\\frac{2}{\\sqrt{21}} \\\\ \\frac{1}{\\sqrt{21}} \\\\ -\\frac{4}{\\sqrt{21}}\\end{aligned}],[\\begin{aligned}\\frac{3}{\\sqrt{14}} \\\\ -\\frac{2}{\\sqrt{14}} \\\\ \\frac{1}{\\sqrt{14}}\\end{aligned}]\\}.\n$$\n\nFinally, $|{x}_{1}|+|{x}_{2}|+|{x}_{3}|=|\\frac{3}{\\sqrt{14}}|+|-\\frac{2}{\\sqrt{14}}|+|\\frac{1}{\\sqrt{14}}|=\\frac{6}{\\sqrt{14}}.$" "Let's denote the vectors of $U$ as ${u}_{1},\\,{u}_{2}.$ To extend the given set to an orthonormal basis of ${R}^{3}$, we need to find a third vector $x$ such that $‖x‖=1,$ and\n\n$$\n\\{\\begin{aligned}{u}_{1}\\cdot x=0 \\\\ {u}_{2}\\cdot x=0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}\\frac{1}{\\sqrt{6}}{x}_{1}+\\frac{2}{\\sqrt{6}}{x}_{2}+\\frac{1}{\\sqrt{6}}{x}_{3}=0 \\\\ \\frac{2}{\\sqrt{21}}{x}_{1}+\\frac{1}{\\sqrt{21}}{x}_{2}-\\frac{4}{\\sqrt{21}}{x}_{3}=0.\\end{aligned}\n$$\n\nNow, we consider the augmented matrix $M$ of the system above and reduce it to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}\\frac{1}{\\sqrt{6}} & \\frac{2}{\\sqrt{6}} & \\frac{1}{\\sqrt{6}} & 0 \\\\ \\frac{2}{\\sqrt{21}} & \\frac{1}{\\sqrt{21}} & -\\frac{4}{\\sqrt{21}} & 0\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:=\\sqrt{6}\\cdot {R}_{1} \\\\ {R}_{2}:=\\sqrt{21}\\cdot {R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 2 & 1 & 0 \\\\ 2 & 1 & -4 & 0\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}-2{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 2 & 1 & 0 \\\\ 0 & -3 & -6 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nIn the reduced matrix above, there are two pivot columns ($1$st and $2$nd). Thus, ${x}_{3}$ is a free variable. From the second equation, we get ${x}_{2}=-2{x}_{3}.$ Substituting this into the first equation, we obtain \n\n$$\n{x}_{1}+2(-2{x}_{3})+{x}_{3}=0\\,⟹\\,{x}_{1}=3{x}_{3}.\n$$\n\nSo, the general solution is\n\n$$\n\\begin{bmatrix}3{x}_{3} \\\\ -2{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in R.\n$$\n\nSetting ${x}_{3}=1,$ we obtain the vector \n$x=\\begin{bmatrix}3 \\\\ -2 \\\\ 1\\end{bmatrix}.$ \n\nNow, we need to normalize $x.$ Notice that $‖x‖=\\sqrt{{3}^{2}+(-2)^{2}+{1}^{2}}=\\sqrt{14}.$ So, we normalize $x$ as follows:\n\n$$\n\\frac{x}{‖x‖}=\\begin{bmatrix}\\frac{3}{\\sqrt{14}} \\\\ -\\frac{2}{\\sqrt{14}} \\\\ \\frac{1}{\\sqrt{14}}\\end{bmatrix}\n$$\n\nTherefore, an orthonormal basis of ${R}^{3}$ is\n\n$$\n\\{\\begin{bmatrix}\\frac{1}{\\sqrt{6}} \\\\ \\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{6}}\\end{bmatrix},\\begin{bmatrix}\\frac{2}{\\sqrt{21}} \\\\ \\frac{1}{\\sqrt{21}} \\\\ -\\frac{4}{\\sqrt{21}}\\end{bmatrix},\\begin{bmatrix}\\frac{3}{\\sqrt{14}} \\\\ -\\frac{2}{\\sqrt{14}} \\\\ \\frac{1}{\\sqrt{14}}\\end{bmatrix}\\}.\n$$\n\nFinally, $|{x}_{1}|+|{x}_{2}|+|{x}_{3}|=|\\frac{3}{\\sqrt{14}}|+|-\\frac{2}{\\sqrt{14}}|+|\\frac{1}{\\sqrt{14}}|=\\frac{6}{\\sqrt{14}}.$"] [:db/cas 17592186433152 :question/problem "Which of the following sets are orthogonal?\n\nSelect all that apply.\n\n- **I.** $U=\\{[\\begin{aligned}1 \\\\ 0 \\\\ -2 \\\\ 2\\end{aligned}],[\\begin{aligned}-3 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}]\\}$\n\n- **II.** $V=\\{[\\begin{aligned}1 \\\\ 0 \\\\ -2 \\\\ 2\\end{aligned}],[\\begin{aligned}0 \\\\ 3 \\\\ -2 \\\\ -2\\end{aligned}],[\\begin{aligned}2 \\\\ 2 \\\\ 2 \\\\ 1\\end{aligned}]\\}$\n\n- **III.** $W=\\{[\\begin{aligned}1 \\\\ -1 \\\\ 4\\end{aligned}],[\\begin{aligned}2 \\\\ -2 \\\\ 1\\end{aligned}]\\}$" "Which of the following sets are orthogonal?\n\nSelect all that apply.\n\n- **I.** $U=\\{\\begin{bmatrix}1 \\\\ 0 \\\\ -2 \\\\ 2\\end{bmatrix},\\begin{bmatrix}-3 \\\\ 1 \\\\ 1 \\\\ 1\\end{bmatrix}\\}$\n\n- **II.** $V=\\{\\begin{bmatrix}1 \\\\ 0 \\\\ -2 \\\\ 2\\end{bmatrix},\\begin{bmatrix}0 \\\\ 3 \\\\ -2 \\\\ -2\\end{bmatrix},\\begin{bmatrix}2 \\\\ 2 \\\\ 2 \\\\ 1\\end{bmatrix}\\}$\n\n- **III.** $W=\\{\\begin{bmatrix}1 \\\\ -1 \\\\ 4\\end{bmatrix},\\begin{bmatrix}2 \\\\ -2 \\\\ 1\\end{bmatrix}\\}$"] [:db/cas 17592186433152 :question/worked-solution "Let's denote the vectors of the given sets as \n$\\{{u}_{1},{u}_{2}\\},$ \n$\\{{v}_{1},{v}_{2},{v}_{3}\\},$ and \n$\\{{w}_{1},{w}_{2}\\},$ respectively. \n\nThe sets $U,V,$ and $W$ are orthogonal if the following conditions on each set hold:\n\n- ${u}_{1}\\cdot {u}_{2}=0.$\n\n- ${v}_{1}\\cdot {v}_{2}=0,\\,{v}_{1}\\cdot {v}_{3}=0,\\,{v}_{2}\\cdot {v}_{3}=0.$\n\n- ${w}_{1}\\cdot {w}_{2}=0.$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get the following:\n\n$$\n\\begin{aligned}{u}_{1}\\cdot {u}_{2} & =[\\begin{aligned}1 \\\\ 0 \\\\ -2 \\\\ 2\\end{aligned}]\\cdot [\\begin{aligned}-3 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}]=-3+0-2+2=-3\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $U$ is not an orthogonal set.\n\n- For the set $V,$ we get the following:\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {v}_{2} & =[\\begin{aligned}1 \\\\ 0 \\\\ -2 \\\\ 2\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 3 \\\\ -2 \\\\ -2\\end{aligned}]=4-4=0 & ✓ \\\\ {v}_{1}\\cdot {v}_{3} & =[\\begin{aligned}1 \\\\ 0 \\\\ -2 \\\\ 2\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 2 \\\\ 2 \\\\ 1\\end{aligned}]=2+0-4+2=0 & ✓ \\\\ {v}_{2}\\cdot {v}_{3} & =[\\begin{aligned}0 \\\\ 3 \\\\ -2 \\\\ -2\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 2 \\\\ 2 \\\\ 1\\end{aligned}]=0+6-4-2=0 & ✓\\end{aligned}\n$$\n\nSo, the set $V$ is orthogonal.\n\n- For the set $W,$ notice that \n\n$$\n\\begin{aligned}{w}_{1}\\cdot {w}_{2} & =[\\begin{aligned}1 \\\\ -1 \\\\ 4\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ -2 \\\\ 1\\end{aligned}]=2+2+4=8\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $W$ is not an orthogonal set.\n\nTherefore, we conclude that the correct answer is \"$V$ only\"." "Let's denote the vectors of the given sets as \n$\\{{u}_{1},{u}_{2}\\},$ \n$\\{{v}_{1},{v}_{2},{v}_{3}\\},$ and \n$\\{{w}_{1},{w}_{2}\\},$ respectively. \n\nThe sets $U,V,$ and $W$ are orthogonal if the following conditions on each set hold:\n\n- ${u}_{1}\\cdot {u}_{2}=0.$\n\n- ${v}_{1}\\cdot {v}_{2}=0,\\,{v}_{1}\\cdot {v}_{3}=0,\\,{v}_{2}\\cdot {v}_{3}=0.$\n\n- ${w}_{1}\\cdot {w}_{2}=0.$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get the following:\n\n$$\n\\begin{aligned}{u}_{1}\\cdot {u}_{2} & =\\begin{bmatrix}1 \\\\ 0 \\\\ -2 \\\\ 2\\end{bmatrix}\\cdot \\begin{bmatrix}-3 \\\\ 1 \\\\ 1 \\\\ 1\\end{bmatrix}=-3+0-2+2=-3\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $U$ is not an orthogonal set.\n\n- For the set $V,$ we get the following:\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {v}_{2} & =\\begin{bmatrix}1 \\\\ 0 \\\\ -2 \\\\ 2\\end{bmatrix}\\cdot \\begin{bmatrix}0 \\\\ 3 \\\\ -2 \\\\ -2\\end{bmatrix}=4-4=0 & ✓ \\\\ {v}_{1}\\cdot {v}_{3} & =\\begin{bmatrix}1 \\\\ 0 \\\\ -2 \\\\ 2\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ 2 \\\\ 2 \\\\ 1\\end{bmatrix}=2+0-4+2=0 & ✓ \\\\ {v}_{2}\\cdot {v}_{3} & =\\begin{bmatrix}0 \\\\ 3 \\\\ -2 \\\\ -2\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ 2 \\\\ 2 \\\\ 1\\end{bmatrix}=0+6-4-2=0 & ✓\\end{aligned}\n$$\n\nSo, the set $V$ is orthogonal.\n\n- For the set $W,$ notice that \n\n$$\n\\begin{aligned}{w}_{1}\\cdot {w}_{2} & =\\begin{bmatrix}1 \\\\ -1 \\\\ 4\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ -2 \\\\ 1\\end{bmatrix}=2+2+4=8\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $W$ is not an orthogonal set.\n\nTherefore, we conclude that the correct answer is \"$V$ only\"."] [:db/cas 17592186433153 :question/problem "Which of the following sets are orthonormal?\n\nSelect all that apply.\n\n- **I.** $U=\\{[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}],[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{aligned}]\\}$\n\n- **II.** $V=\\{[\\begin{aligned}1 \\\\ 4 \\\\ -3\\end{aligned}],[\\begin{aligned}0 \\\\ 3 \\\\ -2\\end{aligned}],[\\begin{aligned}8 \\\\ -1 \\\\ -9\\end{aligned}]\\}$\n\n- **III.** $W=\\{[\\begin{aligned}\\frac{4}{5} \\\\ \\frac{3}{5}\\end{aligned}],[\\begin{aligned}\\frac{3}{5} \\\\ -\\frac{4}{5}\\end{aligned}]\\}$" "Which of the following sets are orthonormal?\n\nSelect all that apply.\n\n- **I.** $U=\\{\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix},\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{bmatrix}\\}$\n\n- **II.** $V=\\{\\begin{bmatrix}1 \\\\ 4 \\\\ -3\\end{bmatrix},\\begin{bmatrix}0 \\\\ 3 \\\\ -2\\end{bmatrix},\\begin{bmatrix}8 \\\\ -1 \\\\ -9\\end{bmatrix}\\}$\n\n- **III.** $W=\\{\\begin{bmatrix}\\frac{4}{5} \\\\ \\frac{3}{5}\\end{bmatrix},\\begin{bmatrix}\\frac{3}{5} \\\\ -\\frac{4}{5}\\end{bmatrix}\\}$"] [:db/cas 17592186433153 :question/worked-solution "Let's denote the vectors of the given sets as \n$\\{{u}_{1},{u}_{2}\\},$ \n$\\{{v}_{1},{v}_{2},{v}_{3}\\},$ and \n$\\{{w}_{1},{w}_{2}\\},$ respectively. \n\nThe sets $U,V,$ and $W$ are orthonormal if the following conditions on each set hold:\n\n- ${u}_{1}\\cdot {u}_{2}=0\\,\\text{and}\\,\\{\\begin{aligned}{u}_{1}\\cdot {u}_{1}=1 \\\\ {u}_{2}\\cdot {u}_{2}=1.\\end{aligned}$\n\n- $\\{\\begin{aligned}{v}_{1}\\cdot {v}_{2}=0 \\\\ {v}_{1}\\cdot {v}_{3}=0 \\\\ {v}_{2}\\cdot {v}_{3}=0\\end{aligned}\\,\\text{and}\\,\\{\\begin{aligned}{v}_{1}\\cdot {v}_{1}=1 \\\\ {v}_{2}\\cdot {v}_{2}=1 \\\\ {v}_{3}\\cdot {v}_{3}=1.\\end{aligned}$\n\n- ${w}_{1}\\cdot {w}_{2}=0\\,\\text{and}\\,\\{\\begin{aligned}{w}_{1}\\cdot {w}_{1}=1 \\\\ {w}_{2}\\cdot {w}_{2}=1.\\end{aligned}$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get the following:\n\n$$\n\\begin{aligned}{u}_{1}\\cdot {u}_{2} & =[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{aligned}]=\\frac{1}{2}-\\frac{1}{2}=0 & ✓ \\\\ {u}_{1}\\cdot {u}_{1} & =[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}]=\\frac{1}{2}+\\frac{1}{2}=1 & ✓ \\\\ {u}_{2}\\cdot {u}_{2} & =[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{aligned}]=\\frac{1}{2}+\\frac{1}{2}=1 & ✓\\end{aligned}\n$$\n\nSo, the set $U$ is orthonormal.\n\n- For the set $V,$ notice that\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {v}_{2} & =[\\begin{aligned}1 \\\\ 4 \\\\ -3\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 3 \\\\ -2\\end{aligned}]=0+12+6=18\\ne 1 & \\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthonormal set.\n\n- For the set $W,$ we get the following:\n\n$$\n\\begin{aligned}{w}_{1}\\cdot {w}_{2} & =[\\begin{aligned}\\frac{4}{5} \\\\ \\frac{3}{5}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{3}{5} \\\\ -\\frac{4}{5}\\end{aligned}]=\\frac{12}{25}-\\frac{12}{25}=0 & ✓ \\\\ {w}_{1}\\cdot {w}_{1} & =[\\begin{aligned}\\frac{4}{5} \\\\ \\frac{3}{5}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{4}{5} \\\\ \\frac{3}{5}\\end{aligned}]=\\frac{16}{25}+\\frac{9}{25}=1 & ✓ \\\\ {w}_{2}\\cdot {w}_{2} & =[\\begin{aligned}\\frac{3}{5} \\\\ -\\frac{4}{5}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{3}{5} \\\\ -\\frac{4}{5}\\end{aligned}]=\\frac{9}{25}+\\frac{16}{25}=1 & ✓\\end{aligned}\n$$\n\nSo, $W$ is an orthonormal set.\n\nTherefore, we conclude that the correct answer is \"$U$ and $W$ only\"." "Let's denote the vectors of the given sets as \n$\\{{u}_{1},{u}_{2}\\},$ \n$\\{{v}_{1},{v}_{2},{v}_{3}\\},$ and \n$\\{{w}_{1},{w}_{2}\\},$ respectively. \n\nThe sets $U,V,$ and $W$ are orthonormal if the following conditions on each set hold:\n\n- ${u}_{1}\\cdot {u}_{2}=0\\,\\text{and}\\,\\{\\begin{aligned}{u}_{1}\\cdot {u}_{1}=1 \\\\ {u}_{2}\\cdot {u}_{2}=1.\\end{aligned}$\n\n- $\\{\\begin{aligned}{v}_{1}\\cdot {v}_{2}=0 \\\\ {v}_{1}\\cdot {v}_{3}=0 \\\\ {v}_{2}\\cdot {v}_{3}=0\\end{aligned}\\,\\text{and}\\,\\{\\begin{aligned}{v}_{1}\\cdot {v}_{1}=1 \\\\ {v}_{2}\\cdot {v}_{2}=1 \\\\ {v}_{3}\\cdot {v}_{3}=1.\\end{aligned}$\n\n- ${w}_{1}\\cdot {w}_{2}=0\\,\\text{and}\\,\\{\\begin{aligned}{w}_{1}\\cdot {w}_{1}=1 \\\\ {w}_{2}\\cdot {w}_{2}=1.\\end{aligned}$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get the following:\n\n$$\n\\begin{aligned}{u}_{1}\\cdot {u}_{2} & =\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{bmatrix}=\\frac{1}{2}-\\frac{1}{2}=0 & ✓ \\\\ {u}_{1}\\cdot {u}_{1} & =\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}=\\frac{1}{2}+\\frac{1}{2}=1 & ✓ \\\\ {u}_{2}\\cdot {u}_{2} & =\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{bmatrix}=\\frac{1}{2}+\\frac{1}{2}=1 & ✓\\end{aligned}\n$$\n\nSo, the set $U$ is orthonormal.\n\n- For the set $V,$ notice that\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {v}_{2} & =\\begin{bmatrix}1 \\\\ 4 \\\\ -3\\end{bmatrix}\\cdot \\begin{bmatrix}0 \\\\ 3 \\\\ -2\\end{bmatrix}=0+12+6=18\\ne 1 & \\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthonormal set.\n\n- For the set $W,$ we get the following:\n\n$$\n\\begin{aligned}{w}_{1}\\cdot {w}_{2} & =\\begin{bmatrix}\\frac{4}{5} \\\\ \\frac{3}{5}\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{3}{5} \\\\ -\\frac{4}{5}\\end{bmatrix}=\\frac{12}{25}-\\frac{12}{25}=0 & ✓ \\\\ {w}_{1}\\cdot {w}_{1} & =\\begin{bmatrix}\\frac{4}{5} \\\\ \\frac{3}{5}\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{4}{5} \\\\ \\frac{3}{5}\\end{bmatrix}=\\frac{16}{25}+\\frac{9}{25}=1 & ✓ \\\\ {w}_{2}\\cdot {w}_{2} & =\\begin{bmatrix}\\frac{3}{5} \\\\ -\\frac{4}{5}\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{3}{5} \\\\ -\\frac{4}{5}\\end{bmatrix}=\\frac{9}{25}+\\frac{16}{25}=1 & ✓\\end{aligned}\n$$\n\nSo, $W$ is an orthonormal set.\n\nTherefore, we conclude that the correct answer is \"$U$ and $W$ only\"."] [:db/cas 17592186433173 :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=[\\begin{aligned}2 \\\\ 0 \\\\ -5\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ 2 \\\\ 0\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}-3 \\\\ -2 \\\\ 5\\end{aligned}].\n$$\n\nAssume that ${x}_{1},{x}_{2},$ and ${x}_{3}$ are real numbers. Which of the following statements are true?\n\nI. The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent.\n\nII. The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$  has an infinite number of nonzero solutions.\n\nIII. The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent.\n\nSelect all that apply. If none apply, leave all boxes unchecked." "Consider the following vectors:\n\n$$\n{a}_{1}=\\begin{bmatrix}2 \\\\ 0 \\\\ -5\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}1 \\\\ 2 \\\\ 0\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}-3 \\\\ -2 \\\\ 5\\end{bmatrix}.\n$$\n\nAssume that ${x}_{1},{x}_{2},$ and ${x}_{3}$ are real numbers. Which of the following statements are true?\n\nI. The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent.\n\nII. The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$  has an infinite number of nonzero solutions.\n\nIII. The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent.\n\nSelect all that apply. If none apply, leave all boxes unchecked."] [:db/cas 17592186433173 :question/worked-solution "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system \n\n$$\n\\{\\begin{aligned}2{x}_{1}+{x}_{2}-3{x}_{3}=0 \\\\ 2{x}_{2}-2{x}_{3}=0 \\\\ -5{x}_{1}+5{x}_{3}=0.\\end{aligned}\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & 1 & -3 & 0 \\\\ 0 & 2 & -2 & 0 \\\\ -5 & 0 & 5 & 0\\end{aligned}] & {R}_{1} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}-5 & 0 & 5 & 0 \\\\ 0 & 2 & -2 & 0 \\\\ 2 & 1 & -3 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+\\frac{2}{5}{R}_{1} \\\\  & ∼[\\begin{aligned}-5 & 0 & 5 & 0 \\\\ 0 & 2 & -2 & 0 \\\\ 0 & 1 & -1 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+(-\\frac{1}{2}){R}_{2} \\\\  & ∼[\\begin{aligned}-5 & 0 & 5 & 0 \\\\ 0 & 2 & -2 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nFrom the matrix above, we conclude that the basic variables are ${x}_{1}$ and ${x}_{2}$, while ${x}_{3}$ is the free variable. \n\nSince there is one free variable, the equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has an infinite number of nonzero solutions, which means that the vectors are linearly dependent. \n\nTherefore, statement III is false, while statements I and II are true." "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system \n\n$$\n\\{\\begin{aligned}2{x}_{1}+{x}_{2}-3{x}_{3}=0 \\\\ 2{x}_{2}-2{x}_{3}=0 \\\\ -5{x}_{1}+5{x}_{3}=0.\\end{aligned}\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & 1 & -3 & 0 \\\\ 0 & 2 & -2 & 0 \\\\ -5 & 0 & 5 & 0\\end{bmatrix} & {R}_{1} & ↔{R}_{3} \\\\  & ∼\\begin{bmatrix}-5 & 0 & 5 & 0 \\\\ 0 & 2 & -2 & 0 \\\\ 2 & 1 & -3 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+\\frac{2}{5}{R}_{1} \\\\  & ∼\\begin{bmatrix}-5 & 0 & 5 & 0 \\\\ 0 & 2 & -2 & 0 \\\\ 0 & 1 & -1 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-\\frac{1}{2}){R}_{2} \\\\  & ∼\\begin{bmatrix}-5 & 0 & 5 & 0 \\\\ 0 & 2 & -2 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nFrom the matrix above, we conclude that the basic variables are ${x}_{1}$ and ${x}_{2}$, while ${x}_{3}$ is the free variable. \n\nSince there is one free variable, the equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has an infinite number of nonzero solutions, which means that the vectors are linearly dependent. \n\nTherefore, statement III is false, while statements I and II are true."] [:db/cas 17592186433217 :question/problem "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=-4{x}_{1}(t) \\\\ {x}_{2}^{′}(t)=7{x}_{1}(t)+{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}-5 \\\\ 4\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation, we get the system\n\n$$\n\\{\\begin{aligned}{{field-1}}=-4{X}_{1}(s) \\\\ {{field-2}}={{field-3}}\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively." "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=-4{x}_{1}(t) \\\\ {x}_{2}^{′}(t)=7{x}_{1}(t)+{x}_{2}(t),\\end{aligned}\\,x(0)=\\begin{bmatrix}-5 \\\\ 4\\end{bmatrix}\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation, we get the system\n\n$$\n\\{\\begin{aligned}{{field-1}}=-4{X}_{1}(s) \\\\ {{field-2}}={{field-3}}\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively."] [:db/cas 17592186433218 :question/problem "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=2{x}_{1}(t)-{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-2{x}_{1}(t)+{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}3 \\\\ -6\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform $L$ to both sides of each equation in our system, we get a system with variables ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}.$ In terms of the parameter $s,$ the solution of the new system is\n\n${X}_{1}(s)=$ {{field-1}},\n$\\,{X}_{2}(s)=\\frac{-6(s-1)}{s(s-3)}.$" "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=2{x}_{1}(t)-{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-2{x}_{1}(t)+{x}_{2}(t),\\end{aligned}\\,x(0)=\\begin{bmatrix}3 \\\\ -6\\end{bmatrix}\n$$\n\nConsider the initial value problem above. By applying the Laplace transform $L$ to both sides of each equation in our system, we get a system with variables ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}.$ In terms of the parameter $s,$ the solution of the new system is\n\n${X}_{1}(s)=$ {{field-1}},\n$\\,{X}_{2}(s)=\\frac{-6(s-1)}{s(s-3)}.$"] [:db/cas 17592186433219 :question/problem "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=-7{x}_{1}(t)-4{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-5{x}_{1}(t)+4{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}-1 \\\\ -6\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation, we get the system\n\n$$\n\\{\\begin{aligned}{{field-1}}={{field-2}} \\\\ {{field-3}}=-5{X}_{1}(s)+4{X}_{2}(s)\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively." "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=-7{x}_{1}(t)-4{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-5{x}_{1}(t)+4{x}_{2}(t),\\end{aligned}\\,x(0)=\\begin{bmatrix}-1 \\\\ -6\\end{bmatrix}\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation, we get the system\n\n$$\n\\{\\begin{aligned}{{field-1}}={{field-2}} \\\\ {{field-3}}=-5{X}_{1}(s)+4{X}_{2}(s)\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively."] [:db/cas 17592186433504 :question/problem "Find the locations of all of the critical points of the transformation $T,$ where $T$ is defined as\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}(u-1)^{3}-(v-2)^{3} \\\\ u+v\\end{aligned}].\n$$" "Find the locations of all of the critical points of the transformation $T,$ where $T$ is defined as\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}(u-1)^{3}-(v-2)^{3} \\\\ u+v\\end{bmatrix}.\n$$"] [:db/cas 17592186433504 :question/worked-solution "Given a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}|.\\end{aligned}\n$$\n\nTo find the locations of the critical points of $T,$ we need to solve \n\n$$\n\\frac{∂(x,y)}{∂(u,v)}=0.\n$$\n\nHere, we have $x(u,v)=(u-1)^{3}-(v-2)^{3}$ and $y(u,v)=u+v.$  \n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =3(u-1)^{2} & \\,\\frac{∂x}{∂v} & =-3(v-2)^{2} \\\\ \\frac{∂y}{∂u} & =1 & \\,\\frac{∂y}{∂v} & =1\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}3(u-1)^{2} & -3(v-2)^{2} \\\\ 1 & 1\\end{aligned}| \\\\  & =3(u-1)^{2}\\cdot 1-(-3(v-2)^{2})\\cdot 1 \\\\  & =3(u-1)^{2}+3(v-2)^{2}.\\end{aligned}\n$$\n\nThe function has critical points when $\\frac{∂(x,y)}{∂(u,v)}=0.$ So, we obtain\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =0 \\\\ 3(u-1)^{2}+3(v-2)^{2} & =0.\\end{aligned}\n$$\n\nThe equation $3(u-1)^{2}+3(v-2)^{2}=0$ defines the point $(1,2)$ in the $uv$-plane." "Given a transformation \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix},\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix}.\\end{aligned}\n$$\n\nTo find the locations of the critical points of $T,$ we need to solve \n\n$$\n\\frac{∂(x,y)}{∂(u,v)}=0.\n$$\n\nHere, we have $x(u,v)=(u-1)^{3}-(v-2)^{3}$ and $y(u,v)=u+v.$  \n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =3(u-1)^{2} & \\,\\frac{∂x}{∂v} & =-3(v-2)^{2} \\\\ \\frac{∂y}{∂u} & =1 & \\,\\frac{∂y}{∂v} & =1\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\  & =\\begin{vmatrix}3(u-1)^{2} & -3(v-2)^{2} \\\\ 1 & 1\\end{vmatrix} \\\\  & =3(u-1)^{2}\\cdot 1-(-3(v-2)^{2})\\cdot 1 \\\\  & =3(u-1)^{2}+3(v-2)^{2}.\\end{aligned}\n$$\n\nThe function has critical points when $\\frac{∂(x,y)}{∂(u,v)}=0.$ So, we obtain\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =0 \\\\ 3(u-1)^{2}+3(v-2)^{2} & =0.\\end{aligned}\n$$\n\nThe equation $3(u-1)^{2}+3(v-2)^{2}=0$ defines the point $(1,2)$ in the $uv$-plane."] [:db/cas 17592186433715 :question/problem "$$\nA=[\\begin{aligned}1 & 1 & -1 \\\\ 2 & 4 & -2 \\\\ 3 & 1 & 1\\end{aligned}],\\,v=[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nI. $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =2$ of $A$\n\nII. $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =2$ of $A$\n\nIII. $v$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =2$ of $A$\n\nSelect all that apply. If none apply, leave all boxes unchecked." "$$\nA=\\begin{bmatrix}1 & 1 & -1 \\\\ 2 & 4 & -2 \\\\ 3 & 1 & 1\\end{bmatrix},\\,v=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nI. $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =2$ of $A$\n\nII. $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =2$ of $A$\n\nIII. $v$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =2$ of $A$\n\nSelect all that apply. If none apply, leave all boxes unchecked."] [:db/cas 17592186433715 :question/worked-solution "A *generalized eigenvector* ${v}_{n}$ of rank $n$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{n}\\overset{A-\\lambda I\\,}{\\to }{v}_{n-1}\\overset{A-\\lambda I\\,}{\\to }…\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{n-1},{v}_{n-2},…,{v}_{1}\\ne 0.$ An *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nFirst, we compute $A-2I:$\n\n$$\nA-2I=[\\begin{aligned}1 & 1 & -1 \\\\ 2 & 4 & -2 \\\\ 3 & 1 & 1\\end{aligned}]-2[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}-1 & 1 & -1 \\\\ 2 & 2 & -2 \\\\ 3 & 1 & -1\\end{aligned}]\n$$\n\n- Next, we find the image of $v$ under the action of $A-2I:$\n\n$$\n(A-2I)v=[\\begin{aligned}-1 & 1 & -1 \\\\ 2 & 2 & -2 \\\\ 3 & 1 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]={{[\\begin{aligned}-2 \\\\ 0 \\\\ 2\\end{aligned}]}_{⏟}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector, we now compute the image of $w$ under the action of $A-2I:$\n\n$$\n(A-2I)w=[\\begin{aligned}-1 & 1 & -1 \\\\ 2 & 2 & -2 \\\\ 3 & 1 & -1\\end{aligned}][\\begin{aligned}-2 \\\\ 0 \\\\ 2\\end{aligned}]={{[\\begin{aligned}0 \\\\ -8 \\\\ -8\\end{aligned}]}_{⏟}}_{x}\\ne 0\n$$\n\n- Again, since we got a nonzero vector in the last step, we now compute the image of $x$ under the action of $A-2I:$\n\n$$\n(A-2I)x=[\\begin{aligned}-1 & 1 & -1 \\\\ 2 & 2 & -2 \\\\ 3 & 1 & -1\\end{aligned}][\\begin{aligned}0 \\\\ -8 \\\\ -8\\end{aligned}]=[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n{{[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]}_{⏟}}_{v}\\overset{A-2I\\,}{\\to }{{[\\begin{aligned}-2 \\\\ 0 \\\\ 2\\end{aligned}]}_{⏟}}_{w}\\overset{A-2I\\,}{\\to }{{[\\begin{aligned}0 \\\\ -8 \\\\ -8\\end{aligned}]}_{⏟}}_{x}\\overset{A-2I\\,}{\\to }{{[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]}_{⏟}}_{0}\n$$\n\nHere, we see that $A-2I$ maps $v$ to $0$ in $3$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =2$ of $A.$*\n\nSo, the correct answer is \"III only.\"" "A *generalized eigenvector* ${v}_{n}$ of rank $n$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{n}\\overset{A-\\lambda I\\,}{\\to }{v}_{n-1}\\overset{A-\\lambda I\\,}{\\to }…\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{n-1},{v}_{n-2},…,{v}_{1}\\ne 0.$ An *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nFirst, we compute $A-2I:$\n\n$$\nA-2I=\\begin{bmatrix}1 & 1 & -1 \\\\ 2 & 4 & -2 \\\\ 3 & 1 & 1\\end{bmatrix}-2\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}-1 & 1 & -1 \\\\ 2 & 2 & -2 \\\\ 3 & 1 & -1\\end{bmatrix}\n$$\n\n- Next, we find the image of $v$ under the action of $A-2I:$\n\n$$\n(A-2I)v=\\begin{bmatrix}-1 & 1 & -1 \\\\ 2 & 2 & -2 \\\\ 3 & 1 & -1\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}={{\\begin{bmatrix}-2 \\\\ 0 \\\\ 2\\end{bmatrix}}_{⏟}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector, we now compute the image of $w$ under the action of $A-2I:$\n\n$$\n(A-2I)w=\\begin{bmatrix}-1 & 1 & -1 \\\\ 2 & 2 & -2 \\\\ 3 & 1 & -1\\end{bmatrix}\\begin{bmatrix}-2 \\\\ 0 \\\\ 2\\end{bmatrix}={{\\begin{bmatrix}0 \\\\ -8 \\\\ -8\\end{bmatrix}}_{⏟}}_{x}\\ne 0\n$$\n\n- Again, since we got a nonzero vector in the last step, we now compute the image of $x$ under the action of $A-2I:$\n\n$$\n(A-2I)x=\\begin{bmatrix}-1 & 1 & -1 \\\\ 2 & 2 & -2 \\\\ 3 & 1 & -1\\end{bmatrix}\\begin{bmatrix}0 \\\\ -8 \\\\ -8\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n{{\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}}_{⏟}}_{v}\\overset{A-2I\\,}{\\to }{{\\begin{bmatrix}-2 \\\\ 0 \\\\ 2\\end{bmatrix}}_{⏟}}_{w}\\overset{A-2I\\,}{\\to }{{\\begin{bmatrix}0 \\\\ -8 \\\\ -8\\end{bmatrix}}_{⏟}}_{x}\\overset{A-2I\\,}{\\to }{{\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}}_{⏟}}_{0}\n$$\n\nHere, we see that $A-2I$ maps $v$ to $0$ in $3$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =2$ of $A.$*\n\nSo, the correct answer is \"III only.\""] [:db/cas 17592186433716 :question/problem "$$\nA=[\\begin{aligned}3 & -1 \\\\ 4 & -1\\end{aligned}],\\,v=[\\begin{aligned}2 \\\\ 1\\end{aligned}]\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =1$ of $A$\n\n- **II.** $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =1$ of $A$\n\n- **III.** $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =1$ of $A$" "$$\nA=\\begin{bmatrix}3 & -1 \\\\ 4 & -1\\end{bmatrix},\\,v=\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =1$ of $A$\n\n- **II.** $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =1$ of $A$\n\n- **III.** $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =1$ of $A$"] [:db/cas 17592186433716 :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A-I:$\n\n$$\nA-I=[\\begin{aligned}3 & -1 \\\\ 4 & -1\\end{aligned}]-[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}2 & -1 \\\\ 4 & -2\\end{aligned}]\n$$\n\n- Next, we find the image of $v$ under the action of $A-I:$\n\n$$\n(A-I)v=[\\begin{aligned}2 & -1 \\\\ 4 & -2\\end{aligned}][\\begin{aligned}2 \\\\ 1\\end{aligned}]={{[\\begin{aligned}3 \\\\ 6\\end{aligned}]}_{⏟}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A-I:$\n\n$$\n(A-I)w=[\\begin{aligned}2 & -1 \\\\ 4 & -2\\end{aligned}][\\begin{aligned}3 \\\\ 6\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}]=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n{{[\\begin{aligned}2 \\\\ 1\\end{aligned}]}_{⏟}}_{v}\\overset{A-I\\,}{\\to }{{[\\begin{aligned}3 \\\\ 6\\end{aligned}]}_{⏟}}_{w}\\overset{A-I\\,}{\\to }{{[\\begin{aligned}0 \\\\ 0\\end{aligned}]}_{⏟}}_{0}\n$$\n\nHere, we see that $A-I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =1$ of $A.$*\n\nSo, the correct answer is \"I only.\"" "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A-I:$\n\n$$\nA-I=\\begin{bmatrix}3 & -1 \\\\ 4 & -1\\end{bmatrix}-\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}2 & -1 \\\\ 4 & -2\\end{bmatrix}\n$$\n\n- Next, we find the image of $v$ under the action of $A-I:$\n\n$$\n(A-I)v=\\begin{bmatrix}2 & -1 \\\\ 4 & -2\\end{bmatrix}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}={{\\begin{bmatrix}3 \\\\ 6\\end{bmatrix}}_{⏟}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A-I:$\n\n$$\n(A-I)w=\\begin{bmatrix}2 & -1 \\\\ 4 & -2\\end{bmatrix}\\begin{bmatrix}3 \\\\ 6\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n{{\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}}_{⏟}}_{v}\\overset{A-I\\,}{\\to }{{\\begin{bmatrix}3 \\\\ 6\\end{bmatrix}}_{⏟}}_{w}\\overset{A-I\\,}{\\to }{{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{⏟}}_{0}\n$$\n\nHere, we see that $A-I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =1$ of $A.$*\n\nSo, the correct answer is \"I only.\""] [:db/cas 17592186433717 :question/problem "$$\nA=[\\begin{aligned}-2 & 1 \\\\ -1 & 0\\end{aligned}],\\,v=[\\begin{aligned}0 \\\\ 1\\end{aligned}]\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =-1$ of $A$\n\n- **II.** $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-1$ of $A$\n\n- **III.** $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =-1$ of $A$" "$$\nA=\\begin{bmatrix}-2 & 1 \\\\ -1 & 0\\end{bmatrix},\\,v=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =-1$ of $A$\n\n- **II.** $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-1$ of $A$\n\n- **III.** $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =-1$ of $A$"] [:db/cas 17592186433717 :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A+I:$\n\n$$\nA+I=[\\begin{aligned}-2 & 1 \\\\ -1 & 0\\end{aligned}]+[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-1 & 1 \\\\ -1 & 1\\end{aligned}]\n$$\n\n- Next, we find the image of $v$ under the action of $A+I:$\n\n$$\n(A+I)v=[\\begin{aligned}-1 & 1 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]={{[\\begin{aligned}1 \\\\ 1\\end{aligned}]}_{⏟}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A+I:$\n\n$$\n(A+I)w=[\\begin{aligned}-1 & 1 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}1 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}]=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n{{[\\begin{aligned}0 \\\\ 1\\end{aligned}]}_{⏟}}_{v}\\overset{A+I\\,}{\\to }{{[\\begin{aligned}1 \\\\ 1\\end{aligned}]}_{⏟}}_{w}\\overset{A+I\\,}{\\to }{{[\\begin{aligned}0 \\\\ 0\\end{aligned}]}_{⏟}}_{0}\n$$\n\nHere, we see that $A+I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-1$ of $A.$*\n\nSo, the correct answer is \"II only.\"" "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A+I:$\n\n$$\nA+I=\\begin{bmatrix}-2 & 1 \\\\ -1 & 0\\end{bmatrix}+\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-1 & 1 \\\\ -1 & 1\\end{bmatrix}\n$$\n\n- Next, we find the image of $v$ under the action of $A+I:$\n\n$$\n(A+I)v=\\begin{bmatrix}-1 & 1 \\\\ -1 & 1\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}={{\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}}_{⏟}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A+I:$\n\n$$\n(A+I)w=\\begin{bmatrix}-1 & 1 \\\\ -1 & 1\\end{bmatrix}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n{{\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}}_{⏟}}_{v}\\overset{A+I\\,}{\\to }{{\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}}_{⏟}}_{w}\\overset{A+I\\,}{\\to }{{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{⏟}}_{0}\n$$\n\nHere, we see that $A+I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-1$ of $A.$*\n\nSo, the correct answer is \"II only.\""] [:db/cas 17592186433718 :question