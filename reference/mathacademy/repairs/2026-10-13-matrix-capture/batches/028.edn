{5} & \\frac{3}{5}\\end{bmatrix}$\nand\n$V=\\begin{bmatrix}\\frac{3}{5} & -\\frac{4}{5} \\\\ \\frac{4}{5} & \\frac{3}{5}\\end{bmatrix}$"] [:db/cas 17592186434252 :answer/value "$U=[\\begin{aligned}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}}\\end{aligned}]$ and $V=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]$" "$U=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}}\\end{bmatrix}$ and $V=\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}$"] [:db/cas 17592186434255 :question/problem "$$\nA=[\\begin{aligned}6 & 2 \\\\ -2 & 6\\end{aligned}]\n$$\n\nConsider the matrix shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the matrices $U$ and $V?$" "$$\nA=\\begin{bmatrix}6 & 2 \\\\ -2 & 6\\end{bmatrix}\n$$\n\nConsider the matrix shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the matrices $U$ and $V?$"] [:db/cas 17592186434255 :question/worked-solution "Let's find the singular value decomposition of $A$ using the usual algorithm.\n\n- **Step 1.** Compute ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={[\\begin{aligned}6 & 2 \\\\ -2 & 6\\end{aligned}]}^{T}[\\begin{aligned}6 & 2 \\\\ -2 & 6\\end{aligned}] \\\\  & ={[\\begin{aligned}6 & -2 \\\\ 2 & 6\\end{aligned}]}^{T}[\\begin{aligned}6 & 2 \\\\ -2 & 6\\end{aligned}] \\\\  & =[\\begin{aligned}40 & 0 \\\\ 0 & 40\\end{aligned}]\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values: Notice that since ${A}^{T}\\,A$ is diagonal, the singular values of $A$ are \n\n$\\,$ ${\\sigma }_{1}={\\sigma }_{2}=\\sqrt{40}.$\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of ${A}^{T}\\,A$): Seeking non-zero solutions of $({A}^{T}\\,A-40I)v=0,$ we obtain the unit eigenvectors \n\n$\\,$ ${v}_{1}=[\\begin{aligned}0 \\\\ 1\\end{aligned}]\\,$ and $\\,{v}_{2}=[\\begin{aligned}1 \\\\ 0\\end{aligned}].$\n\n- **Step 4.** Find the left singular vectors of $A$: Since we know the singular values and right singular vectors, we can compute the columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{\\sqrt{40}}[\\begin{aligned}6 & 2 \\\\ -2 & 6\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}] \\\\  & =\\frac{1}{\\sqrt{40}}[\\begin{aligned}2 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{aligned}]\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{\\sqrt{40}}[\\begin{aligned}6 & 2 \\\\ -2 & 6\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{\\sqrt{40}}[\\begin{aligned}6 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{3}{\\sqrt{10}} \\\\ -\\frac{1}{\\sqrt{10}}\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we construct the matrices $U,$ $Σ,$ and $V:$ \n\n$$\nU=[\\begin{aligned}\\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & -\\frac{1}{\\sqrt{10}}\\end{aligned}],\\,Σ=[\\begin{aligned}\\sqrt{40} & 0 \\\\ 0 & \\sqrt{40}\\end{aligned}],\\,V=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]\n$$" "Let's find the singular value decomposition of $A$ using the usual algorithm.\n\n- **Step 1.** Compute ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}6 & 2 \\\\ -2 & 6\\end{bmatrix}}^{T}\\begin{bmatrix}6 & 2 \\\\ -2 & 6\\end{bmatrix} \\\\  & ={\\begin{bmatrix}6 & -2 \\\\ 2 & 6\\end{bmatrix}}^{T}\\begin{bmatrix}6 & 2 \\\\ -2 & 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}40 & 0 \\\\ 0 & 40\\end{bmatrix}\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values: Notice that since ${A}^{T}\\,A$ is diagonal, the singular values of $A$ are \n\n$\\,$ ${\\sigma }_{1}={\\sigma }_{2}=\\sqrt{40}.$\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of ${A}^{T}\\,A$): Seeking non-zero solutions of $({A}^{T}\\,A-40I)v=0,$ we obtain the unit eigenvectors \n\n$\\,$ ${v}_{1}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}\\,$ and $\\,{v}_{2}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.$\n\n- **Step 4.** Find the left singular vectors of $A$: Since we know the singular values and right singular vectors, we can compute the columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{\\sqrt{40}}\\begin{bmatrix}6 & 2 \\\\ -2 & 6\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix} \\\\  & =\\frac{1}{\\sqrt{40}}\\begin{bmatrix}2 \\\\ 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{bmatrix}\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{\\sqrt{40}}\\begin{bmatrix}6 & 2 \\\\ -2 & 6\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix} \\\\  & =\\frac{1}{\\sqrt{40}}\\begin{bmatrix}6 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{3}{\\sqrt{10}} \\\\ -\\frac{1}{\\sqrt{10}}\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, we construct the matrices $U,$ $Σ,$ and $V:$ \n\n$$\nU=\\begin{bmatrix}\\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & -\\frac{1}{\\sqrt{10}}\\end{bmatrix},\\,Σ=\\begin{bmatrix}\\sqrt{40} & 0 \\\\ 0 & \\sqrt{40}\\end{bmatrix},\\,V=\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\n$$"] [:db/cas 17592186434256 :question/problem "$$\nA=[\\begin{aligned}1 & -2 \\\\ 2 & -4\\end{aligned}],\\,Σ=[\\begin{aligned}5 & 0 \\\\ 0 & 0\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $Σ$ shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the matrices $U$ and $V?$" "$$\nA=\\begin{bmatrix}1 & -2 \\\\ 2 & -4\\end{bmatrix},\\,Σ=\\begin{bmatrix}5 & 0 \\\\ 0 & 0\\end{bmatrix}\n$$\n\nConsider the matrices $A$ and $Σ$ shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the matrices $U$ and $V?$"] [:db/cas 17592186434256 :question/worked-solution "Let's find the singular value decomposition of $A$ using the usual algorithm.\n\n- **Step 1.** Compute ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={[\\begin{aligned}1 & -2 \\\\ 2 & -4\\end{aligned}]}^{T}[\\begin{aligned}1 & -2 \\\\ 2 & -4\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ -2 & -4\\end{aligned}][\\begin{aligned}1 & -2 \\\\ 2 & -4\\end{aligned}] \\\\  & =[\\begin{aligned}5 & -10 \\\\ -10 & 20\\end{aligned}]\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values: Notice that from the matrix $Σ,$ we can deduce that ${\\sigma }_{1}=5$ and ${\\sigma }_{2}=0$ without solving the characteristic equation.\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of ${A}^{T}\\,A$):\n\n- For ${\\lambda }_{1}={\\sigma }_{1}^{2}=25,$ we have \n\n$$\n\\begin{aligned}{A}^{T}\\,A-25I & =[\\begin{aligned}5 & -10 \\\\ -10 & 20\\end{aligned}]-25[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-20 & -10 \\\\ -10 & -5\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-25I)v=0$ gives a unit eigenvector\n\n$$\n{v}_{1}=[\\begin{aligned}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{aligned}].\n$$\n\n- For ${\\lambda }_{2}={\\sigma }_{2}^{2}=0,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-0I & =[\\begin{aligned}5 & -10 \\\\ -10 & 20\\end{aligned}]-0[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}5 & -10 \\\\ -10 & 20\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-0I)v=0$ gives a unit eigenvector\n\n$$\n{v}_{2}=[\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{aligned}].\n$$\n\n- **Step 4.** Find the left singular vectors of $A$ (i.e., the unit eigenvectors of $A{A}^{T}$): Since the first singular value is not zero, and we know the corresponding singular right vector, we can compute the first column of $U$ as follows:\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{5}[\\begin{aligned}1 & -2 \\\\ 2 & -4\\end{aligned}][\\begin{aligned}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{aligned}] \\\\  & =\\frac{1}{5}[\\begin{aligned}-\\frac{5}{\\sqrt{5}} \\\\ -\\frac{10}{\\sqrt{5}}\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{1}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{aligned}]\\end{aligned}\n$$\n\n  \n\nSince the second singular value is ${\\sigma }_{2}=0$, we can't use the same formula to find the second column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector\n\n$$\n{u}_{2}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]\n$$\n\nsuch that \n\n$$\n{u}_{1}\\cdot {u}_{2}=0\\,\\text{and}\\,‖{u}_{2}‖=1.\n$$\n\n \n\nSolving ${u}_{1}\\cdot {u}_{2}=0,$ which is equivalent to\n\n$$\n-\\frac{1}{\\sqrt{5}}{x}_{1}-\\frac{2}{\\sqrt{5}}{x}_{2}=0,\n$$\n\nwe get a nonzero solution $[\\begin{aligned}-2 \\\\ 1\\end{aligned}].$ Normalizing this vector, we finally obtain the  second column of $U:$ \n\n$$\n{u}_{2}=\\frac{1}{\\sqrt{5}}[\\begin{aligned}-2 \\\\ 1\\end{aligned}]=[\\begin{aligned}-\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{aligned}]\n$$\n\nFinally, we construct the matrices $U$ and $V:$\n\n$$\nU=[\\begin{aligned}-\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{aligned}],\\,V=[\\begin{aligned}-\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{aligned}]\n$$" "Let's find the singular value decomposition of $A$ using the usual algorithm.\n\n- **Step 1.** Compute ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}1 & -2 \\\\ 2 & -4\\end{bmatrix}}^{T}\\begin{bmatrix}1 & -2 \\\\ 2 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 2 \\\\ -2 & -4\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ 2 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & -10 \\\\ -10 & 20\\end{bmatrix}\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values: Notice that from the matrix $Σ,$ we can deduce that ${\\sigma }_{1}=5$ and ${\\sigma }_{2}=0$ without solving the characteristic equation.\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of ${A}^{T}\\,A$):\n\n- For ${\\lambda }_{1}={\\sigma }_{1}^{2}=25,$ we have \n\n$$\n\\begin{aligned}{A}^{T}\\,A-25I & =\\begin{bmatrix}5 & -10 \\\\ -10 & 20\\end{bmatrix}-25\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-20 & -10 \\\\ -10 & -5\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-25I)v=0$ gives a unit eigenvector\n\n$$\n{v}_{1}=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{bmatrix}.\n$$\n\n- For ${\\lambda }_{2}={\\sigma }_{2}^{2}=0,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-0I & =\\begin{bmatrix}5 & -10 \\\\ -10 & 20\\end{bmatrix}-0\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}5 & -10 \\\\ -10 & 20\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-0I)v=0$ gives a unit eigenvector\n\n$$\n{v}_{2}=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{bmatrix}.\n$$\n\n- **Step 4.** Find the left singular vectors of $A$ (i.e., the unit eigenvectors of $A{A}^{T}$): Since the first singular value is not zero, and we know the corresponding singular right vector, we can compute the first column of $U$ as follows:\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{5}\\begin{bmatrix}1 & -2 \\\\ 2 & -4\\end{bmatrix}\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{bmatrix} \\\\  & =\\frac{1}{5}\\begin{bmatrix}-\\frac{5}{\\sqrt{5}} \\\\ -\\frac{10}{\\sqrt{5}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{bmatrix}\\end{aligned}\n$$\n\n  \n\nSince the second singular value is ${\\sigma }_{2}=0$, we can't use the same formula to find the second column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector\n\n$$\n{u}_{2}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}\n$$\n\nsuch that \n\n$$\n{u}_{1}\\cdot {u}_{2}=0\\,\\text{and}\\,‖{u}_{2}‖=1.\n$$\n\n \n\nSolving ${u}_{1}\\cdot {u}_{2}=0,$ which is equivalent to\n\n$$\n-\\frac{1}{\\sqrt{5}}{x}_{1}-\\frac{2}{\\sqrt{5}}{x}_{2}=0,\n$$\n\nwe get a nonzero solution $\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}.$ Normalizing this vector, we finally obtain the  second column of $U:$ \n\n$$\n{u}_{2}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}-\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{bmatrix}\n$$\n\nFinally, we construct the matrices $U$ and $V:$\n\n$$\nU=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix},\\,V=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}\n$$"] [:db/cas 17592186434751 :question/problem "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{3}$ is given by\n\n$$\nf(x)≈-78+\\frac{1}{2}(x-a)^{T}[\\begin{aligned}-4 & 0 & 4 \\\\ 0 & -6 & 0 \\\\ 4 & 0 & 8\\end{aligned}](x-a).\n$$\n\nGiven that the eigenvalues of ${f}^{″}(a)$ are ${\\lambda }_{1}=-6,{\\lambda }_{2}=2-2\\sqrt{13}$ and ${\\lambda }_{3}=2+2\\sqrt{13},$ what type of point is $a?$" "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{3}$ is given by\n\n$$\nf(x)≈-78+\\frac{1}{2}(x-a)^{T}\\begin{bmatrix}-4 & 0 & 4 \\\\ 0 & -6 & 0 \\\\ 4 & 0 & 8\\end{bmatrix}(x-a).\n$$\n\nGiven that the eigenvalues of ${f}^{″}(a)$ are ${\\lambda }_{1}=-6,{\\lambda }_{2}=2-2\\sqrt{13}$ and ${\\lambda }_{3}=2+2\\sqrt{13},$ what type of point is $a?$"] [:db/cas 17592186434752 :question/problem "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{2}$ is given by\n\n$$\nf(x)≈1+\\frac{1}{2}(x-a)^{T}[\\begin{aligned}3 & 1 \\\\ 1 & -1\\end{aligned}](x-a).\n$$\n\nGiven that the eigenvalues of ${f}^{″}(a)$ are ${\\lambda }_{1}=1-\\sqrt{5}$ and ${\\lambda }_{2}=1+\\sqrt{5},$ what type of point is $a?$" "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{2}$ is given by\n\n$$\nf(x)≈1+\\frac{1}{2}(x-a)^{T}\\begin{bmatrix}3 & 1 \\\\ 1 & -1\\end{bmatrix}(x-a).\n$$\n\nGiven that the eigenvalues of ${f}^{″}(a)$ are ${\\lambda }_{1}=1-\\sqrt{5}$ and ${\\lambda }_{2}=1+\\sqrt{5},$ what type of point is $a?$"] [:db/cas 17592186434753 :question/problem "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{2}$ is given by\n\n$$\nf(x)≈-\\frac{1}{3}+\\frac{1}{2}(x-a)^{T}[\\begin{aligned}2 & 1 \\\\ 1 & 2\\end{aligned}](x-a).\n$$\n\nGiven that the eigenvalues of ${f}^{″}(a)$ are ${\\lambda }_{1}=1$ and ${\\lambda }_{2}=3,$ what type of point is $a?$" "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{2}$ is given by\n\n$$\nf(x)≈-\\frac{1}{3}+\\frac{1}{2}(x-a)^{T}\\begin{bmatrix}2 & 1 \\\\ 1 & 2\\end{bmatrix}(x-a).\n$$\n\nGiven that the eigenvalues of ${f}^{″}(a)$ are ${\\lambda }_{1}=1$ and ${\\lambda }_{2}=3,$ what type of point is $a?$"] [:db/cas 17592186434754 :question/problem "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{2}$ is given by\n\n$$\nf(x)≈5+\\frac{1}{2}(x-a)^{T}A(x-a),\n$$\n\nwhere \n\n$$\nA=[\\begin{aligned}-3 & -1 \\\\ -1 & -3\\end{aligned}].\n$$\n\n \n\nWhich of the following statements are true?\n\nI. ${a}_{11}=-3$ and $det(A)=8$\n\nII. $A$ is neither positive-definite nor negative-definite\n\nIII. $a$ is a local maximum of $f$\n\nSelect all that apply. If none apply, leave all boxes unchecked." "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{2}$ is given by\n\n$$\nf(x)≈5+\\frac{1}{2}(x-a)^{T}A(x-a),\n$$\n\nwhere \n\n$$\nA=\\begin{bmatrix}-3 & -1 \\\\ -1 & -3\\end{bmatrix}.\n$$\n\n \n\n