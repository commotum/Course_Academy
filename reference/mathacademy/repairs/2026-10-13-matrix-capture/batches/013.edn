ned}27 \\\\ -18\\end{aligned}] \\\\ T([\\begin{aligned}-3 \\\\ 2\\end{aligned}]) & =\\frac{1}{3}[\\begin{aligned}27 \\\\ -18\\end{aligned}] \\\\ T([\\begin{aligned}-3 \\\\ 2\\end{aligned}]) & =[\\begin{aligned}9 \\\\ -6\\end{aligned}].\\end{aligned}\n$$" "Since $T$ is a linear transformation, it must satisfy $T(kv)=kT(v).$ Noting that $\\begin{bmatrix}-9 \\\\ 6\\end{bmatrix}=3\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix},$ we have\n\n$$\n\\begin{aligned}T(\\begin{bmatrix}-9 \\\\ 6\\end{bmatrix}) & =T(3\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix})=3T(\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix}).\\end{aligned}\n$$\n\nNow, since we're told that \n\n$$\nT(\\begin{bmatrix}-9 \\\\ 6\\end{bmatrix})=\\begin{bmatrix}27 \\\\ -18\\end{bmatrix},\n$$\n\nwe must have\n\n$$\n\\begin{aligned}3T(\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix}) & =\\begin{bmatrix}27 \\\\ -18\\end{bmatrix} \\\\ T(\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix}) & =\\frac{1}{3}\\begin{bmatrix}27 \\\\ -18\\end{bmatrix} \\\\ T(\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix}) & =\\begin{bmatrix}9 \\\\ -6\\end{bmatrix}.\\end{aligned}\n$$"] [:db/cas 17592186299638 :question/problem "If $\\,T\\,$ is a linear transformation and $\\,T([\\begin{aligned}3 \\\\ -4\\end{aligned}])=[\\begin{aligned}8 \\\\ -2\\end{aligned}]$, then find $T([\\begin{aligned}-9 \\\\ 12\\end{aligned}]).$\n\n| $\\,T([\\begin{aligned}-9 \\\\ 12\\end{aligned}])=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |" "If $\\,T\\,$ is a linear transformation and $\\,T(\\begin{bmatrix}3 \\\\ -4\\end{bmatrix})=\\begin{bmatrix}8 \\\\ -2\\end{bmatrix}$, then find $T(\\begin{bmatrix}-9 \\\\ 12\\end{bmatrix}).$\n\n| $\\,T(\\begin{bmatrix}-9 \\\\ 12\\end{bmatrix})=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |"] [:db/cas 17592186299638 :question/worked-solution "Since $T$ is a linear transformation, it must satisfy $T(kv)=kT(v).$ Noting that $[\\begin{aligned}-9 \\\\ 12\\end{aligned}]=-3[\\begin{aligned}3 \\\\ -4\\end{aligned}],$ we have\n\n$$\n\\begin{aligned}T([\\begin{aligned}-9 \\\\ 12\\end{aligned}]) & =T(-3[\\begin{aligned}3 \\\\ -4\\end{aligned}]) \\\\  & =-3T([\\begin{aligned}3 \\\\ -4\\end{aligned}]) \\\\  & =-3[\\begin{aligned}8 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}-24 \\\\ 6\\end{aligned}].\\end{aligned}\n$$" "Since $T$ is a linear transformation, it must satisfy $T(kv)=kT(v).$ Noting that $\\begin{bmatrix}-9 \\\\ 12\\end{bmatrix}=-3\\begin{bmatrix}3 \\\\ -4\\end{bmatrix},$ we have\n\n$$\n\\begin{aligned}T(\\begin{bmatrix}-9 \\\\ 12\\end{bmatrix}) & =T(-3\\begin{bmatrix}3 \\\\ -4\\end{bmatrix}) \\\\  & =-3T(\\begin{bmatrix}3 \\\\ -4\\end{bmatrix}) \\\\  & =-3\\begin{bmatrix}8 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-24 \\\\ 6\\end{bmatrix}.\\end{aligned}\n$$"] [:db/cas 17592186299639 :question/problem "If $\\,T\\,$ is a linear transformation and $\\,T([\\begin{aligned}6 \\\\ -12\\end{aligned}])=[\\begin{aligned}-18 \\\\ 36\\end{aligned}]$, then find $T([\\begin{aligned}3 \\\\ -6\\end{aligned}]).$\n\n| $\\,T([\\begin{aligned}3 \\\\ -6\\end{aligned}])=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |" "If $\\,T\\,$ is a linear transformation and $\\,T(\\begin{bmatrix}6 \\\\ -12\\end{bmatrix})=\\begin{bmatrix}-18 \\\\ 36\\end{bmatrix}$, then find $T(\\begin{bmatrix}3 \\\\ -6\\end{bmatrix}).$\n\n| $\\,T(\\begin{bmatrix}3 \\\\ -6\\end{bmatrix})=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |"] [:db/cas 17592186299639 :question/worked-solution "Since $T$ is a linear transformation, it must satisfy $T(kv)=kT(v).$ Noting that $[\\begin{aligned}6 \\\\ -12\\end{aligned}]=2[\\begin{aligned}3 \\\\ -6\\end{aligned}],$ we have\n\n$$\n\\begin{aligned}T([\\begin{aligned}6 \\\\ -12\\end{aligned}]) & =T(2[\\begin{aligned}3 \\\\ -6\\end{aligned}])=2T([\\begin{aligned}3 \\\\ -6\\end{aligned}]).\\end{aligned}\n$$\n\nNow, since we're told that \n\n$$\nT([\\begin{aligned}6 \\\\ -12\\end{aligned}])=[\\begin{alig