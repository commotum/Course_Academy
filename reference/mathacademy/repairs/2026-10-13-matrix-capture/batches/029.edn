nd{aligned}]" "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}"] [:db/cas 17592186478130 :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ -\\frac{1}{2} & -\\frac{3}{2} & 1\\end{aligned}]" "\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ -\\frac{1}{2} & -\\frac{3}{2} & 1\\end{bmatrix}"] [:db/cas 17592186478146 :answer/value "[\\begin{aligned}\\frac{5}{2} & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" "\\begin{bmatrix}\\frac{5}{2} & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A"] [:db/cas 17592186478184 :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -5 & 0 & 1\\end{aligned}]" "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -5 & 0 & 1\\end{bmatrix}"] [:db/cas 17592186478187 :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 1 & 0\\end{aligned}]\\cdot [\\begin{aligned}-1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & -1\\end{aligned}]\\cdot A" "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 1 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}-1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & -1\\end{bmatrix}\\cdot A"] [:db/cas 17592186478193 :answer/value "[\\begin{aligned}t \\\\ 0\\end{aligned}]" "\\begin{bmatrix}t \\\\ 0\\end{bmatrix}"] [:db/cas 17592186478199 :answer/value "[\\begin{aligned}-\\frac{5}{2} & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" "\\begin{bmatrix}-\\frac{5}{2} & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A"] [:db/cas 17592186478226 :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 6 & 1 & 0 \\\\ 0 & 0 & 6\\end{aligned}]" "\\begin{bmatrix}1 & 0 & 0 \\\\ 6 & 1 & 0 \\\\ 0 & 0 & 6\\end{bmatrix}"] [:db/cas 17592186478234 :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 0 & -5 & 1\\end{aligned}]" "\\begin{bmatrix}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 0 & -5 & 1\\end{bmatrix}"] [:db/cas 17592186478236 :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{3}{2} & 1 & 0 \\\\ -\\frac{1}{2} & -1 & 1\\end{aligned}]" "\\begin{bmatrix}1 & 0 & 0 \\\\ -\\frac{3}{2} & 1 & 0 \\\\ -\\frac{1}{2} & -1 & 1\\end{bmatrix}"] [:db/cas 17592186478375 :question/problem "Consider $E=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & \\frac{5}{4}\\end{aligned}]$ and a $3\\times 3$ matrix $A.$ Find the row operation that, when applied to $A,$ is equivalent to multiplying $A$ by the given elementary matrix $E$ from the left." "Consider $E=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & \\frac{5}{4}\\end{bmatrix}$ and a $3\\times 3$ matrix $A.$ Find the row operation that, when applied to $A,$ is equivalent to multiplying $A$ by the given elementary matrix $E$ from the left."] [:db/cas 17592186478375 :question/worked-solution "The given matrix $E$ is obtained by multiplying the third row of ${I}_{3}$ by $\\frac{5}{4}:$\n\n$$\n\\begin{aligned}{I}_{3} & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{3} & :=\\frac{5}{4}{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & \\frac{5}{4}\\end{aligned}] \\\\  & =E\\end{aligned}\n$$\n\nTherefore, $EA$ is equivalent to applying the elementary \nrow operation ${R}_{3}:=\\frac{5}{4}{R}_{3}$ to $A.$" "The given matrix $E$ is obtained by multiplying the third row of ${I}_{3}$ by $\\frac{5}{4}:$\n\n$$\n\\begin{aligned}{I}_{3} & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{3} & :=\\frac{5}{4}{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & \\frac{5}{4}\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, $EA$ is equivalent to applying the elementary \nrow operation ${R}_{3}:=\\frac{5}{4}{R}_{3}$ to $A.$"] [:db/cas 17592186478379 :question/problem "Given that \n$A=[\\begin{aligned}2 & 6 \\\\ 4 & 12\\end{aligned}],$\nhas the LU decomposition $A=LU$, then ${l}_{21}+{u}_{22}=$" "Given that \n$A=\\begin{bmatrix}2 & 6 \\\\ 4 & 12\\end{bmatrix},$\nhas the LU decomposition $A=LU$, then ${l}_{21}+{u}_{22}=$"] [:db/cas 17592186478379 :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2 & 6 \\\\ 4 & 12\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}2 & 6 \\\\ 0 & 0\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}2 & 6 \\\\ 0 & 0\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=2,{u}_{22}=0,$ and ${l}_{21}+{u}_{22}=2.$" "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}2 & 6 \\\\ 4 & 12\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}2 & 6 \\\\ 0 & 0\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}}^{-1}U \\\\ A & ={{\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}2 & 6 \\\\ 0 & 0\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=2,{u}_{22}=0,$ and ${l}_{21}+{u}_{22}=2.$"] [:db/cas 17592186478383 :question/worked-solution "First, let's find the elementary matrices corresponding to the given elementary row operations.\n\n- The first operation is ${R}_{3}:=(-1){R}_{3}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{3} & :=(-1){R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{aligned}] \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second operation is ${R}_{2}↔{R}_{3}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{2}↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 1 & 0\\end{aligned}] \\\\  & ={E}_{2}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$\n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{aligned}]\\cdot A\n$$\n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$\n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 1 & 0\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{aligned}]\\cdot A\n$$" "First, let's find the elementary matrices corresponding to the given elementary row operations.\n\n- The first operation is ${R}_{3}:=(-1){R}_{3}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{3} & :=(-1){R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{bmatrix} \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second operation is ${R}_{2}↔{R}_{3}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{2}↔{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 1 & 0\\end{bmatrix} \\\\  & ={E}_{2}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{bmatrix}\\cdot A\n$$\n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 1 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{bmatrix}\\cdot A\n$$"] [:db/cas 17592186478385 :question/problem "Given that \n$A=[\\begin{aligned}-1 & 1 & -4 \\\\ 3 & -5 & 6 \\\\ 0 & 1 & 1\\end{aligned}]$ has the LU decomposition $A=LU,$ then ${l}_{32}\\cdot {u}_{33}=$" "Given that \n$A=\\begin{bmatrix}-1 & 1 & -4 \\\\ 3 & -5 & 6 \\\\ 0 & 1 & 1\\end{bmatrix}$ has the LU decomposition $A=LU,$ then ${l}_{32}\\cdot {u}_{33}=$"] [:db/cas 17592186478385 :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-1 & 1 & -4 \\\\ 3 & -5 & 6 \\\\ 0 & 1 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}-1 & 1 & -4 \\\\ 0 & -2 & -6 \\\\ 0 & 1 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{2} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & \\frac{1}{2} & 1\\end{aligned}]}}\\cdot {E}_{1}\\cdot A \\\\  & ∼[\\begin{aligned}-1 & 1 & -4 \\\\ 0 & -2 & -6 \\\\ 0 & 0 & -2\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}A=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}A & =U \\\\ {E}_{1}A & ={E}_{2}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & \\frac{1}{2} & 1\\end{aligned}]}^{-1}U \\\\ A & =([\\begin{aligned}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -\\frac{1}{2} & 1\\end{aligned}])U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 0 & -\\frac{1}{2} & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}-1 & 1 & -4 \\\\ 0 & -2 & -6 \\\\ 0 & 0 & -2\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{32}=-\\frac{1}{2},{u}_{33}=-2,$ and ${l}_{32}\\cdot {u}_{33}=1.$" "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}-1 & 1 & -4 \\\\ 3 & -5 & 6 \\\\ 0 & 1 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}-1 & 1 & -4 \\\\ 0 & -2 & -6 \\\\ 0 & 1 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{2} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & \\frac{1}{2} & 1\\end{bmatrix}}}\\cdot {E}_{1}\\cdot A \\\\  & ∼\\begin{bmatrix}-1 & 1 & -4 \\\\ 0 & -2 & -6 \\\\ 0 & 0 & -2\\end{bmatrix} \\\\  