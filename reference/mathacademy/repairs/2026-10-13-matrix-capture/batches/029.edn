aligned}1 & -3 & 1 \\\\ 0 & -4 & -2 \\\\ 5 & 0 & -1\\end{aligned}]" "\\begin{bmatrix}1 & -3 & 1 \\\\ 0 & -4 & -2 \\\\ 5 & 0 & -1\\end{bmatrix}"] [:db/cas 17592186479613 :answer/value "[\\begin{aligned}-1 & 1 \\\\ 2 & 3\\end{aligned}]" "\\begin{bmatrix}-1 & 1 \\\\ 2 & 3\\end{bmatrix}"] [:db/cas 17592186479616 :answer/value "[\\begin{aligned}5 & 3 \\\\ -4 & 0\\end{aligned}]" "\\begin{bmatrix}5 & 3 \\\\ -4 & 0\\end{bmatrix}"] [:db/cas 17592186479618 :answer/value "[\\begin{aligned}9 & 6 \\\\ -7 & -4\\end{aligned}]" "\\begin{bmatrix}9 & 6 \\\\ -7 & -4\\end{bmatrix}"] [:db/cas 17592186479629 :answer/value "[\\begin{aligned}3 & 1 \\\\ 2 & -1\\end{aligned}]" "\\begin{bmatrix}3 & 1 \\\\ 2 & -1\\end{bmatrix}"] [:db/cas 17592186479631 :answer/value "[\\begin{aligned}3 & 9 \\\\ -2 & -7\\end{aligned}]" "\\begin{bmatrix}3 & 9 \\\\ -2 & -7\\end{bmatrix}"] [:db/cas 17592186479632 :answer/value "[\\begin{aligned}2 \\\\ 3 \\\\ -2\\end{aligned}]" "\\begin{bmatrix}2 \\\\ 3 \\\\ -2\\end{bmatrix}"] [:db/cas 17592186479642 :answer/value "[\\begin{aligned}1 & -4 & 0 \\\\ -1 & 3 & -3 \\\\ 3 & 5 & 1\\end{aligned}]" "\\begin{bmatrix}1 & -4 & 0 \\\\ -1 & 3 & -3 \\\\ 3 & 5 & 1\\end{bmatrix}"] [:db/cas 17592186479651 :answer/value "[\\begin{aligned}-4 & 3 \\\\ 5 & 3\\end{aligned}]" "\\begin{bmatrix}-4 & 3 \\\\ 5 & 3\\end{bmatrix}"] [:db/cas 17592186479653 :answer/value "[\\begin{aligned}-4 & 3 \\\\ 5 & 0\\end{aligned}]" "\\begin{bmatrix}-4 & 3 \\\\ 5 & 0\\end{bmatrix}"] [:db/cas 17592186479656 :answer/value "[\\begin{aligned}1 & -1 & 3 \\\\ -4 & 3 & 5 \\\\ 0 & -3 & 1\\end{aligned}]" "\\begin{bmatrix}1 & -1 & 3 \\\\ -4 & 3 & 5 \\\\ 0 & -3 & 1\\end{bmatrix}"] [:db/cas 17592186479659 :answer/value "[\\begin{aligned}-3 \\\\ -2\\end{aligned}]" "\\begin{bmatrix}-3 \\\\ -2\\end{bmatrix}"] [:db/cas 17592186479678 :answer/value "[\\begin{aligned}2 & 3 \\\\ -1 & 1\\end{aligned}]" "\\begin{bmatrix}2 & 3 \\\\ -1 & 1\\end{bmatrix}"] [:db/cas 17592186479682 :answer/value "[\\begin{aligned}-1 \\\\ 0 \\\\ 2\\end{aligned}]" "\\begin{bmatrix}-1 \\\\ 0 \\\\ 2\\end{bmatrix}"] [:db/cas 17592186479696 :answer/value "[\\begin{aligned}-1 \\\\ 0\\end{aligned}]" "\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}"] [:db/cas 17592186479709 :answer/value "[\\begin{aligned}-16 \\\\ 6\\end{aligned}]" "\\begin{bmatrix}-16 \\\\ 6\\end{bmatrix}"] [:db/cas 17592186479718 :answer/value "[\\begin{aligned}-1 & 3 & -3 \\\\ 3 & 5 & 1 \\\\ 1 & -4 & 0\\end{aligned}]" "\\begin{bmatrix}-1 & 3 & -3 \\\\ 3 & 5 & 1 \\\\ 1 & -4 & 0\\end{bmatrix}"] [:db/cas 17592186479720 :answer/value "[\\begin{aligned}2 \\\\ -2 \\\\ 3\\end{aligned}]" "\\begin{bmatrix}2 \\\\ -2 \\\\ 3\\end{bmatrix}"] [:db/cas 17592186479723 :answer/value "[\\begin{aligned}-13 \\\\ -20\\end{aligned}]" "\\begin{bmatrix}-13 \\\\ -20\\end{bmatrix}"] [:db/cas 17592186479729 :answer/value "[\\begin{aligned}1 & -4 & -1 \\\\ 1 & 0 & 0 \\\\ -3 & -2 & 5\\end{aligned}]" "\\begin{bmatrix}1 & -4 & -1 \\\\ 1 & 0 & 0 \\\\ -3 & -2 & 5\\end{bmatrix}"] [:db/cas 17592186479735 :answer/value "[\\begin{aligned}3 \\\\ 2 \\\\ -2\\end{aligned}]" "\\begin{bmatrix}3 \\\\ 2 \\\\ -2\\end{bmatrix}"] [:db/cas 17592186479737 :answer/value "[\\begin{aligned}1 \\\\ 0 \\\\ -2\\end{aligned}]" "\\begin{bmatrix}1 \\\\ 0 \\\\ -2\\end{bmatrix}"] [:db/cas 17592186479740 :answer/value "[\\begin{aligned}20 \\\\ 13\\end{aligned}]" "\\begin{bmatrix}20 \\\\ 13\\end{bmatrix}"] [:db/cas 17592186479830 :question/problem "Let $B$ be a basis of ${R}^{2}$ and let $T:{R}^{2}\\to {R}^{2}$ be a linear transformation. Find $[\\,T\\,]_{B}$, given that\n\n$\\,$ $T([\\begin{aligned}x \\\\ y\\end{aligned}])=[\\begin{aligned}2x \\\\ x-3y\\end{aligned}]\\,$ and $\\,B=\\{[\\begin{aligned}1 \\\\ 1\\end{aligned}],[\\begin{aligned}1 \\\\ 2\\end{aligned}]\\}.$" "Let $B$ be a basis of ${R}^{2}$ and let $T:{R}^{2}\\to {R}^{2}$ be a linear transformation. Find $[\\,T\\,]_{B}$, given that\n\n$\\,$ $T(\\begin{bmatrix}x \\\\ y\\end{bmatrix})=\\begin{bmatrix}2x \\\\ x-3y\\end{bmatrix}\\,$ and $\\,B=\\{\\begin{bmatrix}1 \\\\ 1\\end{bmatrix},\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}\\}.$"] [:db/cas 17592186479830 :question/worked-solution "Let's denote the vectors of $B$ as $\\{{b}_{1},{b}_{2}\\}.$ The $B$-matrix for $T$ is a matrix whose columns are the coordinates of the vectors $T({b}_{1})$ and $T({b}_{2})$ relative to the basis $B.$\n\nFirst, let's find the image of ${b}_{1}$ and ${b}_{2}$ under $T,$ as follows:\n\n$$\n\\begin{aligned}T({b}_{1}) & =T([\\begin{aligned}1 \\\\ 1\\end{aligned}])=[\\begin{aligned}2 \\\\ -2\\end{aligned}] \\\\ T({b}_{2}) & =T([\\begin{aligned}1 \\\\ 2\\end{aligned}])=[\\begin{aligned}2 \\\\ -5\\end{aligned}]\\end{aligned}\n$$\n\nTo find the coordinates of $T({b}_{1})$ and $T({b}_{2})$ relative to the basis $B$, we consider the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | \\\\ {b}_{1} & {b}_{2} & T({b}_{1}) & T({b}_{2}) \\\\ | & | & | & |\\end{aligned}].\n$$\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $B$-matrix for $T:$\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 1 & 2 & 2 \\\\ 1 & 2 & -2 & -5\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}-{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 1 & 2 & 2 \\\\ 0 & 1 & -4 & -7\\end{aligned}] &  & \\begin{aligned}{R}_{1}:={R}_{1}-{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & 6 & 9 \\\\ 0 & 1 & -4 & -7\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=[\\begin{aligned}6 & 9 \\\\ -4 & -7\\end{aligned}].\n$$" "Let's denote the vectors of $B$ as $\\{{b}_{1},{b}_{2}\\}.$ The $B$-matrix for $T$ is a matrix whose columns are the coordinates of the vectors $T({b}_{1})$ and $T({b}_{2})$ relative to the basis $B.$\n\nFirst, let's find the image of ${b}_{1}$ and ${b}_{2}$ under $T,$ as follows:\n\n$$\n\\begin{aligned}T({b}_{1}) & =T(\\begin{bmatrix}1 \\\\ 1\\end{bmatrix})=\\begin{bmatrix}2 \\\\ -2\\end{bmatrix} \\\\ T({b}_{2}) & =T(\\begin{bmatrix}1 \\\\ 2\\end{bmatrix})=\\begin{bmatrix}2 \\\\ -5\\end{bmatrix}\\end{aligned}\n$$\n\nTo find the coordinates of $T({b}_{1})$ and $T({b}_{2})$ relative to the basis $B$, we consider the matrix\n\n$$\nM=\\begin{bmatrix}| & | & | & | \\\\ {b}_{1} & {b}_{2} & T({b}_{1}) & T({b}_{2}) \\\\ | & | & | & |\\end{bmatrix}.\n$$\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $B$-matrix for $T:$\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 1 & 2 & 2 \\\\ 1 & 2 & -2 & -5\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}-{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 1 & 2 & 2 \\\\ 0 & 1 & -4 & -7\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:={R}_{1}-{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 6 & 9 \\\\ 0 & 1 & -4 & -7\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=\\begin{bmatrix}6 & 9 \\\\ -4 & -7\\end{bmatrix}.\n$$"] [:db/cas 17592186479835 :question/problem "Let $B=\\{{b}_{1},{b}_{2}\\}$ be a basis of ${R}^{2}$ and let $T:{R}^{2}\\to {R}^{2}$ be a linear transformation. Find $[T(x)]_{B}$, given that\n$\\,$ $[T]_{B}=[\\begin{aligned}-3 & 5 \\\\ 1 & -1\\end{aligned}]\\,$ and $\\,[x]_{B}=[\\begin{aligned}7 \\\\ 1\\end{aligned}].$" "Let $B=\\{{b}_{1},{b}_{2}\\}$ be a basis of ${R}^{2}$ and let $T:{R}^{2}\\to {R}^{2}$ be a linear transformation. Find $[T(x)]_{B}$, given that\n$\\,$ $[T]_{B}=\\begin{bmatrix}-3 & 5 \\\\ 1 & -1\\end{bmatrix}\\,$ and $\\,[x]_{B}=\\begin{bmatrix}7 \\\\ 1\\end{bmatrix}.$"] [:db/cas 17592186479835 :question/worked-solution "The image of $[x]_{B}$ relative to the basis $B$ under the action of the linear transformation $T$ is given by \n\n$$\n\\begin{aligned}[T(x)]_{B} & =[T]_{B}[x]_{B} \\\\  & =[\\begin{aligned}-3 & 5 \\\\ 1 & -1\\end{aligned}][\\begin{aligned}7 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-16 \\\\ 6\\end{aligned}].\\end{aligned}\n$$" "The image of $[x]_{B}$ relative to the basis $B$ under the action of the linear transformation $T$ is given by \n\n$$\n\\begin{aligned}[T(x)]_{B} & =[T]_{B}[x]_{B} \\\\  & =\\begin{bmatrix}-3 & 5 \\\\ 1 & -1\\end{bmatrix}\\begin{bmatrix}7 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-16 \\\\ 6\\end{bmatrix}.\\end{aligned}\n$$"] [:db/cas 17592186479845 :question/problem "Let $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ be a basis of ${R}^{3}$ and let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation. Find $[T(x)]_{B},$ given that\n$\\,$ $[T]_{B}=[\\begin{aligned}1 & 0 & 1 \\\\ 1 & 1 & 0 \\\\ -1 & 0 & 2\\end{aligned}]\\,$ and $\\,[x]_{B}=[\\begin{aligned}2 \\\\ 1 \\\\ 0\\end{aligned}].$" "Let $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ be a basis of ${R}^{3}$ and let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation. Find $[T(x)]_{B},$ given that\n$\\,$ $[T]_{B}=\\begin{bmatrix}1 & 0 & 1 \\\\ 1 & 1 & 0 \\\\ -1 & 0 & 2\\end{bmatrix}\\,$ and $\\,[x]_{B}=\\begin{bmatrix}2 \\\\ 1 \\\\ 0\\end{bmatrix}.$"] [:db/cas 17592186479845 :question/worked-solution "The image of $[x]_{B}$ relative to the basis $B$ under the action of the linear transformation $T$ is given by \n\n$$\n\\begin{aligned}[T(x)]_{B} & =[T]_{B}[x]_{B} \\\\  & =[\\begin{aligned}1 & 0 & 1 \\\\ 1 & 1 & 0 \\\\ -1 & 0 & 2\\end{aligned}][\\begin{aligned}2 \\\\ 1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 3 \\\\ -2\\end{aligned}].\\end{aligned}\n$$" "The image of $[x]_{B}$ relative to the basis $B$ under the action of the linear transformation $T$ is given by \n\n$$\n\\begin{aligned}[T(x)]_{B} & =[T]_{B}[x]_{B} \\\\  & =\\begin{bmatrix}1 & 0 & 1 \\\\ 1 & 1 & 0 \\\\ -1 & 0 & 2\\end{bmatrix}\\begin{bmatrix}2 \\\\ 1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ 3 \\\\ -2\\end{bmatrix}.\\end{aligned}\n$$"] [:db/cas 17592186479848 :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}0 & 4 \\\\ 4 & 0\\end{aligned}]x+[\\begin{aligned}0 \\\\ {e}^{4t}\\end{aligned}],\\,x(0)=[\\begin{aligned}1 \\\\ 3\\end{aligned}]\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(4t) & \\operatorname{sinh}⁡(4t) \\\\ \\operatorname{sinh}⁡(4t) & \\operatorname{cosh}⁡(4t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 4 \\\\ 4 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"160px\">$\\operatorname{cosh}⁡(4t)+3\\operatorname{sinh}⁡(4t)$</td>\n<td align=\"center\" width=\"5px\"></td><td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,+{\\int }_{0}^{t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"160px\">${e}^{4s}\\operatorname{sinh}⁡(4(t-s))$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,\\text{d}s$</td>\n</tr><tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\"></td><td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" "$$\n{x}^{′}(t)=\\begin{bmatrix}0 & 4 \\\\ 4 & 0\\end{bmatrix}x+\\begin{bmatrix}0 \\\\ {e}^{4t}\\end{bmatrix},\\,x(0)=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}\\operatorname{cosh}⁡(4t) & \\operatorname{sinh}⁡(4t) \\\\ \\operatorname{sinh}⁡(4t) & \\operatorname{cosh}⁡(4t)\\end{bmatrix},$ where $A=\\begin{bmatrix}0 & 4 \\\\ 4 & 0\\end{bmatrix}.$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"160px\">$\\operatorname{cosh}⁡(4t)+3\\operatorname{sinh}⁡(4t)$</td>\n<td align=\"center\" width=\"5px\"></td><td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,+{\\int }_{0}^{t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"160px\">${e}^{4s}\\operatorname{sinh}⁡(4(t-s))$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,\\text{d}s$</td>\n</tr><tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\"></td><td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>"] [:db/cas 17592186479848 :question/worked-solution "Given the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that ${e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(4t) & \\operatorname{sinh}⁡(4t) \\\\ \\operatorname{sinh}⁡(4t) & \\operatorname{cosh}⁡(4t)\\end{aligned}].$ So,\n\n$$\n\\begin{aligned}{e}^{At}\\,x(0) & =[\\begin{aligned}\\operatorname{cosh}⁡(4t) & \\operatorname{sinh}⁡(4t) \\\\ \\operatorname{sinh}⁡(4t) & \\operatorname{cosh}⁡(4t)\\end{aligned}][\\begin{aligned}1 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{cosh}⁡(4t)+3\\operatorname{sinh}⁡(4t) \\\\ \\operatorname{sinh}⁡(4t)+3\\operatorname{cosh}⁡(4t)\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}\\operatorname{cosh}⁡(4(t-s)) & \\operatorname{sinh}⁡(4(t-s)) \\\\ \\operatorname{sinh}⁡(4(t-s)) & \\operatorname{cosh}⁡(4(t-s))\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}\\operatorname{cosh}⁡(4(t-s)) & \\operatorname{sinh}⁡(4(t-s)) \\\\ \\operatorname{sinh}⁡(4(t-s)) & \\operatorname{cosh}⁡(4(t-s))\\end{aligned}][\\begin{aligned}0 \\\\ {e}^{4s}\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{4s}\\operatorname{sinh}⁡(4(t-s)) \\\\ {e}^{4s}\\operatorname{cosh}⁡(4(t-s))\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}\\operatorname{cosh}⁡(4t)+3\\operatorname{sinh}⁡(4t) \\\\ \\operatorname{sinh}⁡(4t)+3\\operatorname{cosh}⁡(4t)\\end{aligned}]+{\\int }_{0}^{t}[\\begin{aligned}{e}^{4s}\\operatorname{sinh}⁡(4(t-s)) \\\\ {e}^{4s}\\operatorname{cosh}⁡(4(t-s))\\end{aligned}]\\text{d}s.\\end{aligned}\n$$" "Given the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that ${e}^{At}=\\begin{bmatrix}\\operatorname{cosh}⁡(4t) & \\operatorname{sinh}⁡(4t) \\\\ \\operatorname{sinh}⁡(4t) & \\operatorname{cosh}⁡(4t)\\end{bmatrix}.$ So,\n\n$$\n\\begin{aligned}{e}^{At}\\,x(0) & =\\begin{bmatrix}\\operatorname{cosh}⁡(4t) & \\operatorname{sinh}⁡(4t) \\\\ \\operatorname{sinh}⁡(4t) & \\operatorname{cosh}⁡(4t)\\end{bmatrix}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{cosh}⁡(4t)+3\\operatorname{sinh}⁡(4t) \\\\ \\operatorname{sinh}⁡(4t)+3\\operatorname{cosh}⁡(4t)\\end{bmatrix}.\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=\\begin{bmatrix}\\operatorname{cosh}⁡(4(t-s)) & \\operatorname{sinh}⁡(4(t-s)) \\\\ \\operatorname{sinh}⁡(4(t-s)) & \\operatorname{cosh}⁡(4(t-s))\\end{bmatrix}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =\\begin{bmatrix}\\operatorname{cosh}⁡(4(t-s)) & \\operatorname{sinh}⁡(4(t-s)) \\\\ \\operatorname{sinh}⁡(4(t-s)) & \\operatorname{cosh}⁡(4(t-s))\\end{bmatrix}\\begin{bmatrix}0 \\\\ {e}^{4s}\\end{bmatrix} \\\\  & =\\begin{bmatrix}{e}^{4s}\\operatorname{sinh}⁡(4(t-s)) \\\\ {e}^{4s}\\operatorname{cosh}⁡(4(t-s))\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =\\begin{bmatrix}\\operatorname{cosh}⁡(4t)+3\\operatorname{sinh}⁡(4t) \\\\ \\operatorname{sinh}⁡(4t)+3\\operatorname{cosh}⁡(4t)\\end{bmatrix}+{\\int }_{0}^{t}\\begin{bmatrix}{e}^{4s}\\operatorname{sinh}⁡(4(t-s)) \\\\ {e}^{4s}\\operatorname{cosh}⁡(4(t-s))\\end{bmatrix}\\text{d}s.\\end{aligned}\n$$"] [:db/cas 17592186479850 :question/problem "Find the angle between $a=[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]$ and $b=[\\begin{aligned}0 \\\\ -1 \\\\ 1\\end{aligned}].$" "Find the angle between $a=\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}$ and $b=\\begin{bmatrix}0 \\\\ -1 \\\\ 1\\end{bmatrix}.$"] [:db/cas 17592186479851 :question/worked-solution "Every linear transformation in ${R}^{2}$ can be represented as a $2\\times 2$ matrix. The standard matrix representation of the transformation has columns that are the images of the vectors $i$ and $j$ under the action of the transformation.\n\nFrom the diagram we see that \n${i}^{′}=[\\begin{aligned}2 \\\\ 3\\end{aligned}]$ \nand \n${j}^{′}=[\\begin{aligned}-1 \\\\ 1\\end{aligned}].$\n\nTherefore, the standard matrix for the linear transformation is \n\n$$\nT=[\\begin{aligned}2 & -1 \\\\ 3 & 1\\end{aligned}].\n$$" "Every linear transformation in ${R}^{2}$ can be represented as a $2\\times 2$ matrix. The standard matrix representation of the transformation has columns that are the images of the vectors $i$ and $j$ under the action of the transformation.\n\nFrom the diagram we see that \n${i}^{′}=\\begin{bmatrix}2 \\\\ 3\\end{bmatrix}$ \nand \n${j}^{′}=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}.$\n\nTherefore, the standard matrix for the linear transformation is \n\n$$\nT=\\begin{bmatrix}2 & -1 \\\\ 3 & 1\\end{bmatrix}.\n$$"] [:db/cas 17592186479853 :question/problem "Consider all non-critical points of the transformation $T:(u,v)\\to (x(u,v),y(u,v)).$ The inverse transformation ${T}^{-1}(x,y)\\to (u(x,y),v(x,y))$ is given by\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}{e}^{{x}^{2}-{y}^{2}} \\\\ x+y\\end{aligned}].\n$$\n\nFind the Jacobian determinant of $T$ in terms of $u$ and $v.$" "Consider all non-critical points of the transformation $T:(u,v)\\to (x(u,v),y(u,v)).$ The inverse transformation ${T}^{-1}(x,y)\\to (u(x,y),v(x,y))$ is given by\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}{e}^{{x}^{2}-{y}^{2}} \\\\ x+y\\end{bmatrix}.\n$$\n\nFind the Jacobian determinant of $T$ in terms of $u$ and $v.$"] [:db/cas 17592186479853 :question/worked-solution "Given a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}|.\\end{aligned}\n$$\n\nIn this case, we're only given ${T}^{-1}.$ So, we compute the Jacobian determinant of $T$ as follows:\n\n- First, we compute $\\frac{∂(u,v)}{∂(x,y)},$ the Jacobian determinant of ${T}^{-1}.$\n\n- Then, we will compute the Jacobian determinant of $T$ using the relation\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}.\n$$\n\nHere, we have $u(x,y)={e}^{{x}^{2}-{y}^{2}}$ and $v(x,y)=x+y.$ \n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂u}{∂x} & =2x{e}^{{x}^{2}-{y}^{2}} & \\,\\frac{∂u}{∂y} & =2y{e}^{{x}^{2}-{y}^{2}} \\\\ \\frac{∂v}{∂x} & =1 & \\,\\frac{∂v}{∂y} & =1\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{aligned}| \\\\  & =|\\begin{aligned}2x{e}^{{x}^{2}-{y}^{2}} & -2y{e}^{{x}^{2}-{y}^{2}} \\\\ 1 & 1\\end{aligned}| \\\\  & =2x{e}^{{x}^{2}-{y}^{2}}\\cdot 1-(-2y{e}^{{x}^{2}-{y}^{2}})\\cdot 1 \\\\  & =2x{e}^{{x}^{2}-{y}^{2}}+2y{e}^{{x}^{2}-{y}^{2}} \\\\  & =2\\cdot (x+y)\\cdot {e}^{{x}^{2}-{y}^{2}} \\\\  & =2uv.\\end{aligned}\n$$\n\n \n\nFinally, we take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & ={(\\frac{∂(u,v)}{∂(x,y)})}^{-1} \\\\  & =\\frac{1}{2uv}\\end{aligned}\n$$" "Given a transformation \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix},\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix}.\\end{aligned}\n$$\n\nIn this case, we're only given ${T}^{-1}.$ So, we compute the Jacobian determinant of $T$ as follows:\n\n- First, we compute $\\frac{∂(u,v)}{∂(x,y)},$ the Jacobian determinant of ${T}^{-1}.$\n\n- Then, we will compute the Jacobian determinant of $T$ using the relation\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}.\n$$\n\nHere, we have $u(x,y)={e}^{{x}^{2}-{y}^{2}}$ and $v(x,y)=x+y.$ \n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂u}{∂x} & =2x{e}^{{x}^{2}-{y}^{2}} & \\,\\frac{∂u}{∂y} & =2y{e}^{{x}^{2}-{y}^{2}} \\\\ \\frac{∂v}{∂x} & =1 & \\,\\frac{∂v}{∂y} & =1\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}2x{e}^{{x}^{2}-{y}^{2}} & -2y{e}^{{x}^{2}-{y}^{2}} \\\\ 1 & 1\\end{vmatrix} \\\\  & =2x{e}^{{x}^{2}-{y}^{2}}\\cdot 1-(-2y{e}^{{x}^{2}-{y}^{2}})\\cdot 1 \\\\  & =2x{e}^{{x}^{2}-{y}^{2}}+2y{e}^{{x}^{2}-{y}^{2}} \\\\  & =2\\cdot (x+y)\\cdot {e}^{{x}^{2}-{y}^{2}} \\\\  & =2uv.\\end{aligned}\n$$\n\n \n\nFinally, we take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & ={(\\frac{∂(u,v)}{∂(x,y)})}^{-1} \\\\  & =\\frac{1}{2uv}\\end{aligned}\n$$"] [:db/cas 17592186479854 :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}0 & 4 \\\\ -4 & 0\\end{aligned}]x+[\\begin{aligned}0 \\\\ {e}^{4t}\\end{aligned}],\\,x(1)=[\\begin{aligned}0 \\\\ 5\\end{aligned}]\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(4t) & \\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t) & \\operatorname{cos}⁡(4t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 4 \\\\ -4 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"100px\">$5\\operatorname{sin}⁡(4(t-1))$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,+{\\int }_{1}^{t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"100px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,\\text{d}s$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n<td align=\"center\"></td>\n<td align=\"center\">${e}^{4s}\\operatorname{cos}⁡(4(t-s))$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" "$$\n{x}^{′}(t)=\\begin{bmatrix}0 & 4 \\\\ -4 & 0\\end{bmatrix}x+\\begin{bmatrix}0 \\\\ {e}^{4t}\\end{bmatrix},\\,x(1)=\\begin{bmatrix}0 \\\\ 5\\end{bmatrix}\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(4t) & \\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t) & \\operatorname{cos}⁡(4t)\\end{bmatrix},$ where $A=\\begin{bmatrix}0 & 4 \\\\ -4 & 0\\end{bmatrix}.$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"100px\">$5\\operatorname{sin}⁡(4(t-1))$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,+{\\int }_{1}^{t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"100px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,\\text{d}s$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n<td align=\"center\"></td>\n<td align=\"center\">${e}^{4s}\\operatorname{cos}⁡(4(t-s))$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>"] [:db/cas 17592186479854 :question/worked-solution "Given the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(4t) & \\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t) & \\operatorname{cos}⁡(4t)\\end{aligned}].$ So,\n\n$$\n\\begin{aligned}{e}^{A(t-1)}\\,x(1) & =[\\begin{aligned}\\operatorname{cos}⁡(4(t-1)) & \\operatorname{sin}⁡(4(t-1)) \\\\ -\\operatorname{sin}⁡(4(t-1)) & \\operatorname{cos}⁡(4(t-1))\\end{aligned}][\\begin{aligned}0 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}5\\operatorname{sin}⁡(4(t-1)) \\\\ 5\\operatorname{cos}⁡(4(t-1))\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}\\operatorname{cos}⁡(4(t-s)) & \\operatorname{sin}⁡(4(t-s)) \\\\ -\\operatorname{sin}⁡(4(t-s)) & \\operatorname{cos}⁡(4(t-s))\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}\\operatorname{cos}⁡(4(t-s)) & \\operatorname{sin}⁡(4(t-s)) \\\\ -\\operatorname{sin}⁡(4(t-s)) & \\operatorname{cos}⁡(4(t-s))\\end{aligned}][\\begin{aligned}0 \\\\ {e}^{4s}\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{4s}\\operatorname{sin}⁡(4(t-s)) \\\\ {e}^{4s}\\operatorname{cos}⁡(4(t-s))\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}5\\operatorname{sin}⁡(4(t-1)) \\\\ 5\\operatorname{cos}⁡(4(t-1))\\end{aligned}]+{\\int }_{1}^{t}[\\begin{aligned}{e}^{4s}\\operatorname{sin}⁡(4(t-s)) \\\\ {e}^{4s}\\operatorname{cos}⁡(4(t-s))\\end{aligned}]\\text{d}s.\\end{aligned}\n$$" "Given the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that ${e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(4t) & \\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t) & \\operatorname{cos}⁡(4t)\\end{bmatrix}.$ So,\n\n$$\n\\begin{aligned}{e}^{A(t-1)}\\,x(1) & =\\begin{bmatrix}\\operatorname{cos}⁡(4(t-1)) & \\operatorname{sin}⁡(4(t-1)) \\\\ -\\operatorname{sin}⁡(4(t-1)) & \\operatorname{cos}⁡(4(t-1))\\end{bmatrix}\\begin{bmatrix}0 \\\\ 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}5\\operatorname{sin}⁡(4(t-1)) \\\\ 5\\operatorname{cos}⁡(4(t-1))\\end{bmatrix}.\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=\\begin{bmatrix}\\operatorname{cos}⁡(4(t-s)) & \\operatorname{sin}⁡(4(t-s)) \\\\ -\\operatorname{sin}⁡(4(t-s)) & \\operatorname{cos}⁡(4(t-s))\\end{bmatrix}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =\\begin{bmatrix}\\operatorname{cos}⁡(4(t-s)) & \\operatorname{sin}⁡(4(t-s)) \\\\ -\\operatorname{sin}⁡(4(t-s)) & \\operatorname{cos}⁡(4(t-s))\\end{bmatrix}\\begin{bmatrix}0 \\\\ {e}^{4s}\\end{bmatrix} \\\\  & =\\begin{bmatrix}{e}^{4s}\\operatorname{sin}⁡(4(t-s)) \\\\ {e}^{4s}\\operatorname{cos}⁡(4(t-s))\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =\\begin{bmatrix}5\\operatorname{sin}⁡(4(t-1)) \\\\ 5\\operatorname{cos}⁡(4(t-1))\\end{bmatrix}+{\\int }_{1}^{t}\\begin{bmatrix}{e}^{4s}\\operatorname{sin}⁡(4(t-s)) \\\\ {e}^{4s}\\operatorname{cos}⁡(4(t-s))\\end{bmatrix}\\text{d}s.\\end{aligned}\n$$"] [:db/cas 17592186479862 :question/worked-solution "Every linear transformation in ${R}^{3}$ can be represented as a $3\\times 3$ matrix. The standard matrix representation of the transformation has columns that are the images of the vectors $i,j,$ and $k$ under the action of the transformation.\n\nTherefore, the standard matrix for the linear transformation is \n\n$$\nT=[\\begin{aligned}1 & -3 & 1 \\\\ -4 & -2 & 0 \\\\ -1 & 5 & 0\\end{aligned}].\n$$" "Every linear transformation in ${R}^{3}$ can be represented as a $3\\times 3$ matrix. The standard matrix representation of the transformation has columns that are the images of the vectors $i,j,$ and $k$ under the action of the transformation.\n\nTherefore, the standard matrix for the linear transformation is \n\n$$\nT=\\begin{bmatrix}1 & -3 & 1 \\\\ -4 & -2 & 0 \\\\ -1 & 5 & 0\\end{bmatrix}.\n$$"] [:db/cas 17592186479866 :question/worked-solution "Every linear transformation in ${R}^{2}$ can be represented as a $2\\times 2$ matrix. The standard matrix representation of the transformation has columns that are the images of the vectors $i$ and $j$ under the action of the transformation.\n\nTherefore, the standard matrix for this linear transformation is \n\n$$\nT=[\\begin{aligned}-4 & 5 \\\\ 3 & 0\\end{aligned}].\n$$" "Every linear transformation in ${R}^{2}$ can be represented as a $2\\times 2$ matrix. The standard matrix representation of the transformation has columns that are the images of the vectors $i$ and $j$ under the action of the transformation.\n\nTherefore, the standard matrix for this linear transformation is \n\n$$\nT=\\begin{bmatrix}-4 & 5 \\\\ 3 & 0\\end{bmatrix}.\n$$"] [:db/cas 17592186479875 :question/problem "Rounded to two decimal places, what is the acute angle between the vectors $v=[\\begin{aligned}1 \\\\ -1 \\\\ 2 \\\\ 2\\end{aligned}]$ and $w=[\\begin{aligned}3 \\\\ 2 \\\\ 1 \\\\ 0\\end{aligned}]?$" "Rounded to two decimal places, what is the acute angle between the vectors $v=\\begin{bmatrix}1 \\\\ -1 \\\\ 2 \\\\ 2\\end{bmatrix}$ and $w=\\begin{bmatrix}3 \\\\ 2 \\\\ 1 \\\\ 0\\end{bmatrix}?$"] [:db/cas 17592186479879 :question/worked-solution "Let $v=\\overset{\\to }{AB}$ and $w=\\overset{\\to }{AC}.$ Then we have\n\n$$\n\\begin{aligned}v & =b-a \\\\  & =[\\begin{aligned}4 \\\\ 2 \\\\ 1 \\\\ -1\\end{aligned}]-[\\begin{aligned}4 \\\\ -1 \\\\ 1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 3 \\\\ 0 \\\\ -1\\end{aligned}]\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}w & =c-a \\\\  & =[\\begin{aligned}0 \\\\ -5 \\\\ 3 \\\\ 2\\end{aligned}]-[\\begin{aligned}4 \\\\ -1 \\\\ 1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}-4 \\\\ -4 \\\\ 2 \\\\ 2\\end{aligned}].\\end{aligned}\n$$\n\nLet $\\theta =m∠BAC$ be the angle between the vectors $v$ and $w.$ Then, we can find $\\operatorname{cos}⁡\\theta $ using the following formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{v\\cdot w}{‖v‖\\,‖w‖} \\\\  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\,\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{0\\cdot (-4)+3\\cdot (-4)+0\\cdot 2+(-1)\\cdot 2}{\\sqrt{{0}^{2}+{3}^{2}+{0}^{2}+(-1)^{2}}\\,\\sqrt{(-4)^{2}+(-4)^{2}+(-2)^{2}+{2}^{2}}} \\\\  & =\\frac{-14}{\\sqrt{10}\\cdot \\sqrt{40}} \\\\  & =-\\frac{14}{20} \\\\  & =-\\frac{14÷2}{20÷2} \\\\  & =-\\frac{7}{10}\\end{aligned}\n$$" "Let $v=\\overset{\\to }{AB}$ and $w=\\overset{\\to }{AC}.$ Then we have\n\n$$\n\\begin{aligned}v & =b-a \\\\  & =\\begin{bmatrix}4 \\\\ 2 \\\\ 1 \\\\ -1\\end{bmatrix}-\\begin{bmatrix}4 \\\\ -1 \\\\ 1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 3 \\\\ 0 \\\\ -1\\end{bmatrix}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}w & =c-a \\\\  & =\\begin{bmatrix}0 \\\\ -5 \\\\ 3 \\\\ 2\\end{bmatrix}-\\begin{bmatrix}4 \\\\ -1 \\\\ 1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4 \\\\ -4 \\\\ 2 \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$\n\nLet $\\theta =m∠BAC$ be the angle between the vectors $v$ and $w.$ Then, we can find $\\operatorname{cos}⁡\\theta $ using the following formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{v\\cdot w}{‖v‖\\,‖w‖} \\\\  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\,\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{0\\cdot (-4)+3\\cdot (-4)+0\\cdot 2+(-1)\\cdot 2}{\\sqrt{{0}^{2}+{3}^{2}+{0}^{2}+(-1)^{2}}\\,\\sqrt{(-4)^{2}+(-4)^{2}+(-2)^{2}+{2}^{2}}} \\\\  & =\\frac{-14}{\\sqrt{10}\\cdot \\sqrt{40}} \\\\  & =-\\frac{14}{20} \\\\  & =-\\frac{14÷2}{20÷2} \\\\  & =-\\frac{7}{10}\\end{aligned}\n$$"] [:db/cas 17592186479886 :question/worked-solution "First, let\n\n$$\n\\begin{aligned}a=\\overset{\\to }{OA}=[\\begin{aligned}2 \\\\ 2 \\\\ 1 \\\\ -1\\end{aligned}],\\,b=\\overset{\\to }{OB}=[\\begin{aligned}1 \\\\ 0 \\\\ 0 \\\\ 3\\end{aligned}].\\end{aligned}\n$$\n\n \n\nAlso, let $\\theta =m∠AOB$ be the angle between the vectors $a$ and $b.$ Then, we can find $\\operatorname{cos}⁡\\theta $ using the following formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{‖a‖\\,‖b‖} \\\\  & =\\frac{{a}_{1}{b}_{1}+{a}_{2}{b}_{2}+{a}_{3}{b}_{3}+{a}_{4}{b}_{4}}{\\sqrt{{a}_{1}^{2}+{a}_{2}^{2}+{a}_{3}^{2}+{a}_{4}^{2}}\\,\\sqrt{{b}_{1}^{2}+{b}_{2}^{2}+{b}_{3}^{2}+{b}_{4}^{2}}} \\\\  & =\\frac{2\\cdot 1+2\\cdot 0+1\\cdot 0+(-1)\\cdot 3}{\\sqrt{{2}^{2}+{2}^{2}+{1}^{2}+(-1)^{2}}\\,\\sqrt{{1}^{2}+{0}^{2}+{0}^{2}+{3}^{2}}} \\\\  & =\\frac{-1}{\\sqrt{10}\\cdot \\sqrt{10}} \\\\  & =-\\frac{1}{10}\\end{aligned}\n$$" "First, let\n\n$$\n\\begin{aligned}a=\\overset{\\to }{OA}=\\begin{bmatrix}2 \\\\ 2 \\\\ 1 \\\\ -1\\end{bmatrix},\\,b=\\overset{\\to }{OB}=\\begin{bmatrix}1 \\\\ 0 \\\\ 0 \\\\ 3\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nAlso, let $\\theta =m∠AOB$ be the angle between the vectors $a$ and $b.$ Then, we can find $\\operatorname{cos}⁡\\theta $ using the following formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{‖a‖\\,‖b‖} \\\\  & =\\frac{{a}_{1}{b}_{1}+{a}_{2}{b}_{2}+{a}_{3}{b}_{3}+{a}_{4}{b}_{4}}{\\sqrt{{a}_{1}^{2}+{a}_{2}^{2}+{a}_{3}^{2}+{a}_{4}^{2}}\\,\\sqrt{{b}_{1}^{2}+{b}_{2}^{2}+{b}_{3}^{2}+{b}_{4}^{2}}} \\\\  & =\\frac{2\\cdot 1+2\\cdot 0+1\\cdot 0+(-1)\\cdot 3}{\\sqrt{{2}^{2}+{2}^{2}+{1}^{2}+(-1)^{2}}\\,\\sqrt{{1}^{2}+{0}^{2}+{0}^{2}+{3}^{2}}} \\\\  & =\\frac{-1}{\\sqrt{10}\\cdot \\sqrt{10}} \\\\  & =-\\frac{1}{10}\\end{aligned}\n$$"] [:db/cas 17592186479888 :question/problem "Let $B=\\{{b}_{1},{b}_{2}\\}$ be a basis of ${R}^{2}$ and let $T:{R}^{2}\\to {R}^{2}$ be a linear transformation. Find $[T(x)]_{B}$, given that\n$\\,$ $[T]_{B}=[\\begin{aligned}1 & -3 \\\\ 2 & -4\\end{aligned}]\\,$ and $\\,[x]_{B}=[\\begin{aligned}-4 \\\\ 3\\end{aligned}].$" "Let $B=\