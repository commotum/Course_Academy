ned}1 & 0 \\\\ 2 & -5\\end{aligned}] & =[\\begin{aligned}1\\cdot 1+6\\cdot 2 & 1\\cdot 0+6\\cdot (-5) \\\\ 8\\cdot 1+(-3)\\cdot 2 & 8\\cdot 0+(-3)\\cdot (-5)\\end{aligned}] \\\\  & =[\\begin{aligned}1+12 & 0+(-30) \\\\ 8+(-6) & 0+15\\end{aligned}] \\\\  & =[\\begin{aligned}13 & -30 \\\\ 2 & 15\\end{aligned}].\\end{aligned}\n$$" "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & 6 \\\\ 8 & -3\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ 2 & -5\\end{bmatrix} & =\\begin{bmatrix}1\\cdot 1+6\\cdot 2 & 1\\cdot 0+6\\cdot (-5) \\\\ 8\\cdot 1+(-3)\\cdot 2 & 8\\cdot 0+(-3)\\cdot (-5)\\end{bmatrix} \\\\  & =\\begin{bmatrix}1+12 & 0+(-30) \\\\ 8+(-6) & 0+15\\end{bmatrix} \\\\  & =\\begin{bmatrix}13 & -30 \\\\ 2 & 15\\end{bmatrix}.\\end{aligned}\n$$"] [:db/cas 17592186385981 :answer/value "[\\begin{aligned}13 & -29 \\\\ 2 & -15\\end{aligned}]" "\\begin{bmatrix}13 & -29 \\\\ 2 & -15\\end{bmatrix}"] [:db/cas 17592186385982 :answer/value "[\\begin{aligned}9 & -30 \\\\ 2 & -15\\end{aligned}]" "\\begin{bmatrix}9 & -30 \\\\ 2 & -15\\end{bmatrix}"] [:db/cas 17592186385983 :answer/value "[\\begin{aligned}13 & -30 \\\\ -14 & 15\\end{aligned}]" "\\begin{bmatrix}13 & -30 \\\\ -14 & 15\\end{bmatrix}"] [:db/cas 17592186385984 :answer/value "[\\begin{aligned}9 & -30 \\\\ -14 & -15\\end{aligned}]" "\\begin{bmatrix}9 & -30 \\\\ -14 & -15\\end{bmatrix}"] [:db/cas 17592186385985 :answer/value "[\\begin{aligned}13 & -30 \\\\ 2 & 15\\end{aligned}]" "\\begin{bmatrix}13 & -30 \\\\ 2 & 15\\end{bmatrix}"] [:db/cas 17592186385986 :question/problem "$[\\begin{aligned}7 & 12 \\\\ -20 & -6\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=$" "$\\begin{bmatrix}7 & 12 \\\\ -20 & -6\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=$"] [:db/cas 17592186385986 :question/worked-solution "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}7 & 12 \\\\ -20 & -6\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] & =[\\begin{aligned}7\\cdot 1+12\\cdot 0 & 7\\cdot 0+12\\cdot 1 \\\\ -20\\cdot 1+(-6)\\cdot 0 & -20\\cdot 0+(-6)\\cdot 1\\end{aligned}] \\\\  & =[\\begin{aligned}7+0 & 0+12 \\\\ -20+0 & 0+(-6)\\end{aligned}] \\\\  & =[\\begin{aligned}7 & 12 \\\\ -20 & -6\\end{aligned}].\\end{aligned}\n$$" "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}7 & 12 \\\\ -20 & -6\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & =\\begin{bmatrix}7\\cdot 1+12\\cdot 0 & 7\\cdot 0+12\\cdot 1 \\\\ -20\\cdot 1+(-6)\\cdot 0 & -20\\cdot 0+(-6)\\cdot 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}7+0 & 0+12 \\\\ -20+0 & 0+(-6)\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 & 12 \\\\ -20 & -6\\end{bmatrix}.\\end{aligned}\n$$"] [:db/cas 17592186385988 :answer/value "[\\begin{aligned}19 & 12 \\\\ -20 & -6\\end{aligned}]" "\\begin{bmatrix}19 & 12 \\\\ -20 & -6\\end{bmatrix}"] [:db/cas 17592186385989 :answer/value "[\\begin{aligned}7 & 12 \\\\ 20 & -6\\end{aligned}]" "\\begin{bmatrix}7 & 12 \\\\ 20 & -6\\end{bmatrix}"] [:db/cas 17592186385990 :answer/value "[\\begin{aligned}7 & 19 \\\\ -20 & -6\\end{aligned}]" "\\begin{bmatrix}7 & 19 \\\\ -20 & -6\\end{bmatrix}"] [:db/cas 17592186385991 :answer/value "[\\begin{aligned}7 & 12 \\\\ -20 & -6\\end{aligned}]" "\\begin{bmatrix}7 & 12 \\\\ -20 & -6\\end{bmatrix}"] [:db/cas 17592186385992 :answer/value "[\\begin{aligned}7 & 12 \\\\ -20 & -26\\end{aligned}]" "\\begin{bmatrix}7 & 12 \\\\ -20 & -26\\end{bmatrix}"] [:db/cas 17592186386000 :question/problem "Given the **orthonormal** basis $B=\\{[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{aligned}],[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}]\\}$ of ${R}^{2},$ find $[x]_{B}$ if $x=[\\begin{aligned}4 \\\\ 2\\end{aligned}].$" "Given the **orthonormal** basis $B=\\{\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{bmatrix},\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}\\}$ of ${R}^{2},$ find $[x]_{B}$ if $x=\\begin{bmatrix}4 \\\\ 2\\end{bmatrix}.$"] [:db/cas 17592186386000 :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2}.$ \n\nSince $B$ is an orthonormal basis, we have that $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$, where ${x}_{i}=x\\cdot {q}_{i}.$ Computing the components of $x,$ we get the following: \n\n$$\n\\begin{aligned}{x}_{1} & =[\\begin{aligned}4 \\\\ 2\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{aligned}]=\\frac{4}{\\sqrt{2}}-\\frac{2}{\\sqrt{2}}=\\frac{2}{\\sqrt{2}} \\\\ {x}_{2} & =[\\begin{aligned}4 \\\\ 2\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}]=\\frac{4}{\\sqrt{2}}+\\frac{2}{\\sqrt{2}}=\\frac{6}{\\sqrt{2}}\\end{aligned}\n$$\n\nTherefore, we have \n\n$$\n[x]_{B}=[\\begin{aligned}\\frac{2}{\\sqrt{2}} \\\\ \\frac{6}{\\sqrt{2}}\\end{aligned}].\n$$" "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2}.$ \n\nSince $B$ is an orthonormal basis, we have that $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}$, where ${x}_{i}=x\\cdot {q}_{i}.$ Computing the components of $x,$ we get the following: \n\n$$\n\\begin{aligned}{x}_{1} & =\\begin{bmatrix}4 \\\\ 2\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{bmatrix}=\\frac{4}{\\sqrt{2}}-\\frac{2}{\\sqrt{2}}=\\frac{2}{\\sqrt{2}} \\\\ {x}_{2} & =\\begin{bmatrix}4 \\\\ 2\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}=\\frac{4}{\\sqrt{2}}+\\frac{2}{\\sqrt{2}}=\\frac{6}{\\sqrt{2}}\\end{aligned}\n$$\n\nTherefore, we have \n\n$$\n[x]_{B}=\\begin{bmatrix}\\frac{2}{\\sqrt{2}} \\\\ \\frac{6}{\\sqrt{2}}\\end{bmatrix}.\n$$"] [:db/cas 17592186386002 :answer/value "[\\begin{aligned}0 \\\\ \\frac{2}{\\sqrt{2}}\\end{aligned}]" "\\begin{bmatrix}0 \\\\ \\frac{2}{\\sqrt{2}}\\end{bmatrix}"] [:db/cas 17592186386003 :answer/value "[\\begin{aligned}\\frac{6}{\\sqrt{2}} \\\\ \\frac{2}{\\sqrt{2}}\\end{aligned}]" "\\begin{bmatrix}\\frac{6}{\\sqrt{2}} \\\\ \\frac{2}{\\sqrt{2}}\\end{bmatrix}"] [:db/cas 17592186386004 :answer/value "[\\begin{aligned}-\\frac{2}{\\sqrt{2}} \\\\ \\frac{2}{\\sqrt{2}}\\end{aligned}]" "\\begin{bmatrix}-\\frac{2}{\\sqrt{2}} \\\\ \\frac{2}{\\sqrt{2}}\\end{bmatrix}"] [:db/cas 17592186386005 :answer/value "[\\begin{aligned}\\frac{2}{\\sqrt{2}} \\\\ \\frac{6}{\\sqrt{2}}\\end{aligned}]" "\\begin{bmatrix}\\frac{2}{\\sqrt{2}} \\\\ \\frac{6}{\\sqrt{2}}\\end{bmatrix}"] [:db/cas 17592186386006 :answer/value "[\\begin{aligned}-\\frac{4}{\\sqrt{2}} \\\\ -\\frac{2}{\\sqrt{2}}\\end{aligned}]" "\\begin{bmatrix}-\\frac{4}{\\sqrt{2}} \\\\ -\\frac{2}{\\sqrt{2}}\\end{bmatrix}"] [:db/cas 17592186386048 :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\begin{aligned}\\{\\begin{aligned}x+3y=0 \\\\ 2y=1.\\end{aligned}\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}1 & 3 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ 1\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=[\\begin{aligned}1 & 3 \\\\ 0 & 2\\end{aligned}].$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{1\\cdot 2-0\\cdot 3}[\\begin{aligned}2 & -3 \\\\ 0 & 1\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}2 & -3 \\\\ 0 & 1\\end{aligned}].\\end{aligned}\n$$\n\nWe can now find the solution to this system as:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{2}[\\begin{aligned}2 & -3 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]\\end{aligned}\n$$" "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\begin{aligned}\\{\\begin{aligned}x+3y=0 \\\\ 2y=1.\\end{aligned}\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n\\begin{bmatrix}1 & 3 \\\\ 0 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=\\begin{bmatrix}1 & 3 \\\\ 0 & 2\\end{bmatrix}.$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{1\\cdot 2-0\\cdot 3}\\begin{bmatrix}2 & -3 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}2 & -3 \\\\ 0 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now find the solution to this system as:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{2}\\begin{bmatrix}2 & -3 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$"] [:db/cas 17592186386050 :answer/value "x=\\frac{1}{6}[\\begin{aligned}2 & 3 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]" "x=\\frac{1}{6}\\begin{bmatrix}2 & 3 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}"] [:db/cas 17592186386051 :answer/value "x=2[\\begin{aligned}1 & -3 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]" "x=2\\begin{bmatrix}1 & -3 \\\\ 0 & 2\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}"] [:db/cas 17592186386052 :answer/value "x=\\frac{1}{2}[\\begin{aligned}-2 & -3 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]" "x=\\frac{1}{2}\\begin{bmatrix}-2 & -3 \\\\ 0 & -1\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}"] [:db/cas 17592186386053 :answer/value "x=\\frac{1}{2}[\\begin{aligned}2 & -3 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]" "x=\\frac{1}{2}\\begin{bmatrix}2 & -3 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}"] [:db/cas 17592186386054 :answer/value "x=[\\begin{aligned}1 & 3 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]" "x=\\begin{bmatrix}1 & 3 \\\\ 0 & 2\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}"] [:db/cas 17592186386055 :question/problem "Find the inverse of the matrix $A=[\\begin{aligned}1 & 0 & 2 \\\\ 1 & -1 & 1 \\\\ 2 & 1 & 1\\end{aligned}]$\ngiven that $det(A)=4.$" "Find the inverse of the matrix $A=\\begin{bmatrix}1 & 0 & 2 \\\\ 1 & -1 & 1 \\\\ 2 & 1 & 1\\end{bmatrix}$\ngiven that $det(A)=4.$"] [:db/cas 17592186386055 :question/worked-solution "Let's follow the standard five-step procedure.\n\n**Step 1:** We are given the determinant of $A:$\n\n$$\n\\begin{aligned}det(A)=4\\end{aligned}\n$$\n\n**Step 2:** Form the matrix of the minors of $A.$\nTo make this matrix, we replace each entry of $A$ by its minor.\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}|\\begin{aligned}-1 & 1 \\\\ 1 & 1\\end{aligned}| & |\\begin{aligned}1 & 1 \\\\ 2 & 1\\end{aligned}| & |\\begin{aligned}1 & -1 \\\\ 2 & 1\\end{aligned}| \\\\ |\\begin{aligned}0 & 2 \\\\ 1 & 1\\end{aligned}| & |\\begin{aligned}1 & 2 \\\\ 2 & 1\\end{aligned}| & |\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}| \\\\ |\\begin{aligned}0 & 2 \\\\ -1 & 1\\end{aligned}| & |\\begin{aligned}1 & 2 \\\\ 1 & 1\\end{aligned}| & |\\begin{aligned}1 & 0 \\\\ 1 & -1\\end{aligned}|\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -1 & 3 \\\\ -2 & -3 & 1 \\\\ 2 & -1 & -1\\end{aligned}].\\end{aligned}\n$$\n\n**Step 3:** Create the matrix of cofactors by changing the sign of some of the entries of $M$ according to the rule of alternating signs.\n\n$$\nC=[\\begin{aligned}-2 & 1 & 3 \\\\ 2 & -3 & -1 \\\\ 2 & 1 & -1\\end{aligned}].\n$$\n\n**Step 4:** Write down the transpose of the matrix of cofactors.\n\n$$\n{C}^{T}=[\\begin{aligned}-2 & 2 & 2 \\\\ 1 & -3 & 1 \\\\ 3 & -1 & -1\\end{aligned}].\n$$\n\n**Step 5:** Use the formula for the inverse of a $3\\times 3$ matrix.\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}{C}^{T} \\\\  & =\\frac{1}{4}[\\begin{aligned}-2 & 2 & 2 \\\\ 1 & -3 & 1 \\\\ 3 & -1 & -1\\end{aligned}].\\end{aligned}\n$$" "Let's follow the standard five-step procedure.\n\n**Step 1:** We are given the determinant of $A:$\n\n$$\n\\begin{aligned}det(A)=4\\end{aligned}\n$$\n\n**Step 2:** Form the matrix of the minors of $A.$\nTo make this matrix, we replace each entry of $A$ by its minor.\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}\\begin{vmatrix}-1 & 1 \\\\ 1 & 1\\end{vmatrix} & \\begin{vmatrix}1 & 1 \\\\ 2 & 1\\end{vmatrix} & \\begin{vmatrix}1 & -1 \\\\ 2 & 1\\end{vmatrix} \\\\ \\begin{vmatrix}0 & 2 \\\\ 1 & 1\\end{vmatrix} & \\begin{vmatrix}1 & 2 \\\\ 2 & 1\\end{vmatrix} & \\begin{vmatrix}1 & 0 \\\\ 2 & 1\\end{vmatrix} \\\\ \\begin{vmatrix}0 & 2 \\\\ -1 & 1\\end{vmatrix} & \\begin{vmatrix}1 & 2 \\\\ 1 & 1\\end{vmatrix} & \\begin{vmatrix}1 & 0 \\\\ 1 & -1\\end{vmatrix}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & -1 & 3 \\\\ -2 & -3 & 1 \\\\ 2 & -1 & -1\\end{bmatrix}.\\end{aligned}\n$$\n\n**Step 3:** Create the matrix of cofactors by changing the sign of some of the entries of $M$ according to the rule of alternating signs.\n\n$$\nC=\\begin{bmatrix}-2 & 1 & 3 \\\\ 2 & -3 & -1 \\\\ 2 & 1 & -1\\end{bmatrix}.\n$$\n\n**Step 4:** Write down the transpose of the matrix of cofactors.\n\n$$\n{C}^{T}=\\begin{bmatrix}-2 & 2 & 2 \\\\ 1 & -3 & 1 \\\\ 3 & -1 & -1\\end{bmatrix}.\n$$\n\n**Step 5:** Use the formula for the inverse of a $3\\times 3$ matrix.\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}{C}^{T} \\\\  & =\\frac{1}{4}\\begin{bmatrix}-2 & 2 & 2 \\\\ 1 & -3 & 1 \\\\ 3 & -1 & -1\\end{bmatrix}.\\end{aligned}\n$$"] [:db/cas 17592186386057 :answer/value "4[\\begin{aligned}-3 & 1 & 2 \\\\ 1 & -1 & 1 \\\\ 1 & 1 & -1\\end{aligned}]" "4\\begin{bmatrix}-3 & 1 & 2 \\\\ 1 & -1 & 1 \\\\ 1 & 1 & -1\\end{bmatrix}"] [:db/cas 17592186386058 :answer/value "\\frac{1}{4}[\\begin{aligned}-2 & 1 & 3 \\\\ 2 & -3 & -1 \\\\ 2 & 1 & -1\\end{aligned}]" "\\frac{1}{4}\\begin{bmatrix}-2 & 1 & 3 \\\\ 2 & -3 & -1 \\\\ 2 & 1 & -1\\end{bmatrix}"] [:db/cas 17592186386059 :answer/value "\\frac{1}{4}[\\begin{aligned}-2 & 1 & 2 \\\\ 1 & -1 & 1 \\\\ 2 & 1 & -1\\end{aligned}]" "\\frac{1}{4}\\begin{bmatrix}-2 & 1 & 2 \\\\ 1 & -1 & 1 \\\