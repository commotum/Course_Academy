}_{3}\\cdot {a}_{3}}{a}_{3}=\\frac{4\\cdot (-2)+6\\cdot (-1)+(-1)\\cdot (-3)+(-4)\\cdot 1}{(-2)^{2}+(-1)^{2}+(-3)^{2}+{1}^{2}}{a}_{2}=[\\begin{aligned}2 \\\\ 1 \\\\ 3 \\\\ -1\\end{aligned}]\\end{aligned}\n$$\n\n \n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x \\\\  & =[\\begin{aligned}-2 \\\\ 2 \\\\ 0 \\\\ -2\\end{aligned}]+[\\begin{aligned}4 \\\\ 2 \\\\ -4 \\\\ -2\\end{aligned}]+[\\begin{aligned}2 \\\\ 1 \\\\ 3 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ 5 \\\\ -1 \\\\ -5\\end{aligned}].\\end{aligned}\n$$" "Since the set $\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}\\{{a}_{1}\\},$ $\\text{Span}\\{{a}_{2}\\},$ and $\\text{Span}\\{{a}_{3}\\}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{4\\cdot (-1)+6\\cdot 1+(-1)\\cdot 0+(-4)\\cdot (-1)}{(-1)^{2}+{1}^{2}+{0}^{2}+(-1)^{2}}{a}_{1}=\\begin{bmatrix}-2 \\\\ 2 \\\\ 0 \\\\ -2\\end{bmatrix} \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{4\\cdot 2+6\\cdot 1+(-1)\\cdot (-2)+(-4)\\cdot (-1)}{{2}^{2}+{1}^{2}+(-2)^{2}+(-1)^{2}}{a}_{2}=\\begin{bmatrix}4 \\\\ 2 \\\\ -4 \\\\ -2\\end{bmatrix} \\\\ {\\text{proj}}_{{a}_{3}}x & =\\frac{x\\cdot {a}_{3}}{{a}_{3}\\cdot {a}_{3}}{a}_{3}=\\frac{4\\cdot (-2)+6\\cdot (-1)+(-1)\\cdot (-3)+(-4)\\cdot 1}{(-2)^{2}+(-1)^{2}+(-3)^{2}+{1}^{2}}{a}_{2}=\\begin{bmatrix}2 \\\\ 1 \\\\ 3 \\\\ -1\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x \\\\  & =\\begin{bmatrix}-2 \\\\ 2 \\\\ 0 