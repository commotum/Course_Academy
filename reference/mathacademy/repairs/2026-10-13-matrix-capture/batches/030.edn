\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}$ and \n$V=\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}$"] [:db/cas 17592186497017 :answer/value "[\\begin{aligned}0 \\\\ 1\\end{aligned}]" "\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}"] [:db/cas 17592186497022 :answer/value "[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]" "\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}"] [:db/cas 17592186497071 :answer/value "[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}]" "\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}"] [:db/cas 17592186497081 :answer/value "$U=[\\begin{aligned}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]$ and $V=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]$" "$U=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}$ and $V=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}$"] [:db/cas 17592186497115 :answer/value "[\\begin{aligned}\\frac{1}{\\sqrt{3}} \\\\ -\\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{3}}\\end{aligned}]" "\\begin{bmatrix}\\frac{1}{\\sqrt{3}} \\\\ -\\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{3}}\\end{bmatrix}"] [:db/cas 17592186497140 :answer/value "[\\begin{aligned}-\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{aligned}]" "\\begin{bmatrix}-\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{bmatrix}"] [:db/cas 17592186497150 :answer/value "[\\begin{aligned}\\frac{2}{\\sqrt{6}} \\\\ -\\frac{1}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{6}}\\end{aligned}]" "\\begin{bmatrix}\\frac{2}{\\sqrt{6}} \\\\ -\\frac{1}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{6}}\\end{bmatrix}"] [:db/cas 17592186497166 :answer/value "[\\begin{aligned}\\frac{1}{\\sqrt{5}} \\\\ -\\frac{\\sqrt{2}}{\\sqrt{5}}\\end{aligned}]" "\\begin{bmatrix}\\frac{1}{\\sqrt{5}} \\\\ -\\frac{\\sqrt{2}}{\\sqrt{5}}\\end{bmatrix}"] [:db/cas 17592186497184 :answer/value "[\\begin{aligned}\\frac{2}{\\sqrt{3}} \\\\ -\\frac{1}{\\sqrt{3}}\\end{aligned}]" "\\begin{bmatrix}\\frac{2}{\\sqrt{3}} \\\\ -\\frac{1}{\\sqrt{3}}\\end{bmatrix}"] [:db/cas 17592186497193 :answer/value "[\\begin{aligned}1 \\\\ 0\\end{aligned}]" "\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}"] [:db/cas 17592186497329 :question/problem "$$\nA=[\\begin{aligned}2 & 3 \\\\ -3 & 2\\end{aligned}]\n$$\n\nConsider the matrix shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the matrices $U$ and $V?$" "$$\nA=\\begin{bmatrix}2 & 3 \\\\ -3 & 2\\end{bmatrix}\n$$\n\nConsider the matrix shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the matrices $U$ and $V?$"] [:db/cas 17592186497329 :question/worked-solution "Let's find the singular value decomposition of $A$ using the usual algorithm.\n\n- **Step 1.** Compute ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={[\\begin{aligned}2 & 3 \\\\ -3 & 2\\end{aligned}]}^{T}[\\begin{aligned}2 & 3 \\\\ -3 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -3 \\\\ 3 & 2\\end{aligned}][\\begin{aligned}2 & 3 \\\\ -3 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}13 & 0 \\\\ 0 & 13\\end{aligned}]\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values: Notice that since ${A}^{T}\\,A$ is diagonal, the singular values of $A$ are \n\n$\\,$ ${\\sigma }_{1}={\\sigma }_{2}=\\sqrt{13}.$\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of ${A}^{T}\\,A$): Seeking non-zero solutions of $({A}^{T}\\,A-13I)v=0,$ we obtain the unit eigenvectors \n\n$\\,$ ${v}_{1}=[\\begin{aligned}0 \\\\ 1\\end{aligned}]\\,$ and $\\,{v}_{2}=[\\begin{aligned}1 \\\\ 0\\end{aligned}].$\n\n- **Step 4.** Find the left singular vectors of $A$: Since we know the singular values and right singular vectors, we can compute the columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{\\sqrt{13}}[\\begin{aligned}2 & 3 \\\\ -3 & 2\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}] \\\\  & =\\frac{1}{\\sqrt{13}}[\\begin{aligned}3 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{aligned}]\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{\\sqrt{13}}[\\begin{aligned}2 & 3 \\\\ -3 & 2\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{\\sqrt{13}}[\\begin{aligned}2 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{2}{\\sqrt{13}} \\\\ -\\frac{3}{\\sqrt{13}}\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we construct the matrices $U,$ $Σ,$ and $V:$\n\n$$\nU=[\\begin{aligned}\\frac{3}{\\sqrt{13}} & \\frac{2}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}} & -\\frac{3}{\\sqrt{13}}\\end{aligned}],\\,Σ=[\\begin{aligned}\\sqrt{13} & 0 \\\\ 0 & \\sqrt{13}\\end{aligned}],\\,V=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]\n$$" "Let's find the singular value decomposition of $A$ using the usual algorithm.\n\n- **Step 1.** Compute ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}2 & 3 \\\\ -3 & 2\\end{bmatrix}}^{T}\\begin{bmatrix}2 & 3 \\\\ -3 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & -3 \\\\ 3 & 2\\end{bmatrix}\\begin{bmatrix}2 & 3 \\\\ -3 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}13 & 0 \\\\ 0 & 13\\end{bmatrix}\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values: Notice that since ${A}^{T}\\,A$ is diagonal, the singular values of $A$ are \n\n$\\,$ ${\\sigma }_{1}={\\sigma }_{2}=\\sqrt{13}.$\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of ${A}^{T}\\,A$): Seeking non-zero solutions of $({A}^{T}\\,A-13I)v=0,$ we obtain the unit eigenvectors \n\n$\\,$ ${v}_{1}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}\\,$ and $\\,{v}_{2}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.$\n\n- **Step 4.** Find the left singular vectors of $A$: Since we know the singular values and right singular vectors, we can compute the columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{\\sqrt{13}}\\begin{bmatrix}2 & 3 \\\\ -3 & 2\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix} \\\\  & =\\frac{1}{\\sqrt{13}}\\begin{bmatrix}3 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{bmatrix}\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{\\sqrt{13}}\\begin{bmatrix}2 & 3 \\\\ -3 & 2\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix} \\\\  & =\\frac{1}{\\sqrt{13}}\\begin{bmatrix}2 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{2}{\\sqrt{13}} \\\\ -\\frac{3}{\\sqrt{13}}\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, we construct the matrices $U,$ $Σ,$ and $V:$\n\n$$\nU=\\begin{bmatrix}\\frac{3}{\\sqrt{13}} & \\frac{2}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}} & -\\frac{3}{\\sqrt{13}}\\end{bmatrix},\\,Σ=\\begin{bmatrix}\\sqrt{13} & 0 \\\\ 0 & \\sqrt{13}\\end{bmatrix},\\,V=\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\n$$"] [:db/cas 17592186497334 :question/problem "$$\nA=[\\begin{aligned}\\sqrt{2} & -1 \\\\ -\\sqrt{2} & 1\\end{aligned}],\\,Σ=[\\begin{aligned}\\sqrt{6} & 0 \\\\ 0 & 0\\end{aligned}],\\,V=[\\begin{aligned}-\\frac{\\sqrt{2}}{\\sqrt{3}} & \\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{3}} & \\frac{\\sqrt{2}}{\\sqrt{3}}\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ what is the second column of $U?$" "$$\nA=\\begin{bmatrix}\\sqrt{2} & -1 \\\\ -\\sqrt{2} & 1\\end{bmatrix},\\,Σ=\\begin{bmatrix}\\sqrt{6} & 0 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}-\\frac{\\sqrt{2}}{\\sqrt{3}} & \\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{3}} & \\frac{\\sqrt{2}}{\\sqrt{3}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ what is the second column of $U?$"] [:db/cas 17592186497334 :question/worked-solution "Recall that if $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ and ${\\sigma }_{i}\\ne 0,$ then the $i$th column of $U$ can be found as\n\n$$\n{u}_{i}=\\frac{1}{{\\sigma }_{i}}A{v}_{i},\n$$\n\n \n\nwhere ${u}_{i}$ and ${v}_{i}$ are the $i$th columns of the orthogonal matrices $U$ and $V,$ respectively.  \n\nFrom the matrix $Σ,$ we deduce that the singular values are ${\\sigma }_{1}=\\sqrt{6}$ and ${\\sigma }_{2}=0.$ Therefore, the first column of $U$ is\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{\\sqrt{6}}[\\begin{aligned}\\sqrt{2} & -1 \\\\ -\\sqrt{2} & 1\\end{aligned}][\\begin{aligned}-\\frac{\\sqrt{2}}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{3}}\\end{aligned}] \\\\  & =\\frac{1}{\\sqrt{6}}[\\begin{aligned}-\\sqrt{3} \\\\ \\sqrt{3}\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}].\\end{aligned}\n$$\n\n \n\nSince the second singular value is ${\\sigma }_{2}=0$, we can't use the same formula to find the second column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector\n\n$$\n{u}_{2}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]\n$$\n\nsuch that \n\n$$\n{u}_{1}\\cdot {u}_{2}=0\\,\\text{and}\\,‖{u}_{2}‖=1.\n$$\n\n \n\nSolving ${u}_{1}\\cdot {u}_{2}=0,$ which is equivalent to\n\n$$\n-\\frac{1}{\\sqrt{2}}{x}_{1}+\\frac{1}{\\sqrt{2}}{x}_{2}=0,\n$$\n\nwe get a nonzero solution $[\\begin{aligned}1 \\\\ 1\\end{aligned}].$ Normalizing this vector, we finally obtain the  second column of $U:$ \n\n$$\n{u}_{2}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 1\\end{aligned}]=[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}]\n$$" "Recall that if $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ and ${\\sigma }_{i}\\ne 0,$ then the $i$th column of $U$ can be found as\n\n$$\n{u}_{i}=\\frac{1}{{\\sigma }_{i}}A{v}_{i},\n$$\n\n \n\nwhere ${u}_{i}$ and ${v}_{i}$ are the $i$th columns of the orthogonal matrices $U$ and $V,$ respectively.  \n\nFrom the matrix $Σ,$ we deduce that the singular values are ${\\sigma }_{1}=\\sqrt{6}$ and ${\\sigma }_{2}=0.$ Therefore, the first column of $U$ is\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{\\sqrt{6}}\\begin{bmatrix}\\sqrt{2} & -1 \\\\ -\\sqrt{2} & 1\\end{bmatrix}\\begin{bmatrix}-\\frac{\\sqrt{2}}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{3}}\\end{bmatrix} \\\\  & =\\frac{1}{\\sqrt{6}}\\begin{bmatrix}-\\sqrt{3} \\\\ \\sqrt{3}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nSince the second singular value is ${\\sigma }_{2}=0$, we can't use the same formula to find the second column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector\n\n$$\n{u}_{2}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}\n$$\n\nsuch that \n\n$$\n{u}_{1}\\cdot {u}_{2}=0\\,\\text{and}\\,‖{u}_{2}‖=1.\n$$\n\n \n\nSolving ${u}_{1}\\cdot {u}_{2}=0,$ which is equivalent to\n\n$$\n-\\frac{1}{\\sqrt{2}}{x}_{1}+\\frac{1}{\\sqrt{2}}{x}_{2}=0,\n$$\n\nwe get a nonzero solution $\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.$ Normalizing this vector, we finally obtain the  second column of $U:$ \n\n$$\n{u}_{2}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}\n$$"] [:db/cas 17592186497345 :question/problem "$$\nA=[\\begin{aligned}1 & 3 \\\\ 2 & 2 \\\\ 3 & 1\\end{aligned}],\\,Σ=[\\begin{aligned}2\\sqrt{6} & 0 \\\\ 0 & 2 \\\\ 0 & 0\\end{aligned}],\\,V=[\\begin{aligned}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the $3$rd column of the matrix $U?$" "$$\nA=\\begin{bmatrix}1 & 3 \\\\ 2 & 2 \\\\ 3 & 1\\end{bmatrix},\\,Σ=\\begin{bmatrix}2\\sqrt{6} & 0 \\\\ 0 & 2 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the $3$rd column of the matrix $U?$"] [:db/cas 17592186497345 :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=2\\sqrt{6}$ and ${\\sigma }_{2}=2.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the $1$st and $2$nd columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{2\\sqrt{6}}[\\begin{aligned}1 & 3 \\\\ 2 & 2 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}] \\\\  & =\\frac{1}{2\\sqrt{6}}[\\begin{aligned}2\\sqrt{2} \\\\ 2\\sqrt{2} \\\\ 2\\sqrt{2}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{3}}\\end{aligned}]\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{2}[\\begin{aligned}1 & 3 \\\\ 2 & 2 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}\\sqrt{2} \\\\ 0 \\\\ -\\sqrt{2}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ 0 \\\\ -\\frac{1}{\\sqrt{2}}\\end{aligned}]\\end{aligned}\n$$\n\nSince we do not have the third singular value, we can't use the same formula to find the third column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector \n\n$$\n{u}_{3}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]\n$$\n\nsuch that \n\n$$\n\\{\\begin{aligned}{u}_{1}\\cdot {u}_{3}=0 \\\\ {u}_{2}\\cdot {u}_{3}=0,\\end{aligned}\\,‖{u}_{3}‖=1.\n$$\n\nSolving this system, which is equivalent to\n\n$$\n\\{\\begin{aligned}\\frac{1}{\\sqrt{3}}{x}_{1}+\\frac{1}{\\sqrt{3}}{x}_{2}+\\frac{1}{\\sqrt{3}}{x}_{3}=0 \\\\ \\frac{1}{\\sqrt{2}}{x}_{1}-\\frac{1}{\\sqrt{2}}{x}_{3}=0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}{x}_{1}+{x}_{2}+{x}_{3}=0 \\\\ {x}_{1}-{x}_{3}=0,\\end{aligned}\n$$\n\nwe get the nonzero normalized solution \n\n$$\n{u}_{3}=[\\begin{aligned}\\frac{1}{\\sqrt{6}} \\\\ -\\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{6}}\\end{aligned}].\n$$\n\nFinally, we construct the matrix $U:$\n\n$$\nU=[\\begin{aligned}\\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{3}} & 0 & -\\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{3}} & -\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{6}}\\end{aligned}]\n$$" "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=2\\sqrt{6}$ and ${\\sigma }_{2}=2.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the $1$st and $2$nd columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{2\\sqrt{6}}\\begin{bmatrix}1 & 3 \\\\ 2 & 2 \\\\ 3 & 1\\end{bmatrix}\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\frac{1}{2\\sqrt{6}}\\begin{bmatrix}2\\sqrt{2} \\\\ 2\\sqrt{2} \\\\ 2\\sqrt{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{3}}\\end{bmatrix}\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{2}\\begin{bmatrix}1 & 3 \\\\ 2 & 2 \\\\ 3 & 1\\end{bmatrix}\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}\\sqrt{2} \\\\ 0 \\\\ -\\sqrt{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ 0 \\\\ -\\frac{1}{\\sqrt{2}}\\end{bmatrix}\\end{aligned}\n$$\n\nSince we do not have the third singular value, we can't use the same formula to find the third column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector \n\n$$\n{u}_{3}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\n$$\n\nsuch that \n\n$$\n\\{\\begin{aligned}{u}_{1}\\cdot {u}_{3}=0 \\\\ {u}_{2}\\cdot {u}_{3}=0,\\end{aligned}\\,‖{u}_{3}‖=1.\n$$\n\nSolving this system, which is equivalent to\n\n$$\n\\{\\begin{aligned}\\frac{1}{\\sqrt{3}}{x}_{1}+\\frac{1}{\\sqrt{3}}{x}_{2}+\\frac{1}{\\sqrt{3}}{x}_{3}=0 \\\\ \\frac{1}{\\sqrt{2}}{x}_{1}-\\frac{1}{\\sqrt{2}}{x}_{3}=0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}{x}_{1}+{x}_{2}+{x}_{3}=0 \\\\ {x}_{1}-{x}_{3}=0,\\end{aligned}\n$$\n\nwe get the nonzero normalized solution \n\n$$\n{u}_{3}=\\begin{bmatrix}\\frac{1}{\\sqrt{6}} \\\\ -\\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{6}}\\end{bmatrix}.\n$$\n\nFinally, we construct the matrix $U:$\n\n$$\nU=\\begin{bmatrix}\\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{3}} & 0 & -\\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{3}} & -\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{6}}\\end{bmatrix}\n$$"] [:db/cas 17592186497350 :question/problem "$$\nA=[\\begin{aligned}3 & 3 \\\\ 2 & 2\\end{aligned}],\\,Σ=[\\begin{aligned}\\sqrt{26} & 0 \\\\ 0 & 0\\end{aligned}],\\,V=[\\begin{aligned}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ what is the second column of $U?$" "$$\nA=\\begin{bmatrix}3 & 3 \\\\ 2 & 2\\end{bmatrix},\\,Σ=\\begin{bmatrix}\\sqrt{26} & 0 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ what is the second column of $U?$"] [:db/cas 17592186497350 :question/worked-solution "Recall that if $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ and ${\\sigma }_{i}\\ne 0,$ then the $i$th column of $U$ can be found as\n\n$$\n{u}_{i}=\\frac{1}{{\\sigma }_{i}}A{v}_{i},\n$$\n\n \n\nwhere ${u}_{i}$ and ${v}_{i}$ are the $i$th columns of the orthogonal matrices $U$ and $V,$ respectively.  \n\nFrom the matrix $Σ,$ we deduce that the singular values are ${\\sigma }_{1}=\\sqrt{26}$ and ${\\sigma }_{2}=0.$ Therefore, the first column of $U$ is\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{\\sqrt{26}}[\\begin{aligned}3 & 3 \\\\ 2 & 2\\end{aligned}][\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}] \\\\  & =\\frac{1}{\\sqrt{26}}[\\begin{aligned}\\frac{6}{\\sqrt{2}} \\\\ \\frac{4}{\\sqrt{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{aligned}].\\end{aligned}\n$$\n\nSince the second singular value is ${\\sigma }_{2}=0$, we can't use the same formula to find the second column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector\n\n$$\n{u}_{2}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]\n$$\n\nsuch that \n\n$$\n{u}_{1}\\cdot {u}_{2}=0\\,\\text{and}\\,‖{u}_{2}‖=1.\n$$\n\n \n\nSolving ${u}_{1}\\cdot {u}_{2}=0,$ which is equivalent to\n\n$$\n\\frac{3}{\\sqrt{13}}{x}_{1}+\\frac{2}{\\sqrt{13}}{x}_{2}=0,\n$$\n\nwe get a nonzero solution $[\\begin{aligned}-2 \\\\ 3\\end{aligned}].$ Normalizing this vector, we finally obtain the  second column of $U:$\n\n$$\n{u}_{2}=\\frac{1}{\\sqrt{13}}[\\begin{aligned}-2 \\\\ 3\\end{aligned}]=[\\begin{aligned}-\\frac{2}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}}\\end{aligned}]\n$$" "Recall that if $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ and ${\\sigma }_{i}\\ne 0,$ then the $i$th column of $U$ can be found as\n\n$$\n{u}_{i}=\\frac{1}{{\\sigma }_{i}}A{v}_{i},\n$$\n\n \n\nwhere ${u}_{i}$ and ${v}_{i}$ are the $i$th columns of the orthogonal matrices $U$ and $V,$ respectively.  \n\nFrom the matrix $Σ,$ we deduce that the singular values are ${\\sigma }_{1}=\\sqrt{26}$ and ${\\sigma }_{2}=0.$ Therefore, the first column of $U$ is\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{\\sqrt{26}}\\begin{bmatrix}3 & 3 \\\\ 2 & 2\\end{bmatrix}\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\frac{1}{\\sqrt{26}}\\begin{bmatrix}\\frac{6}{\\sqrt{2}} \\\\ \\frac{4}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{bmatrix}.\\end{aligned}\n$$\n\nSince the second singular value is ${\\sigma }_{2}=0$, we can't use the same formula to find the second column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector\n\n$$\n{u}_{2}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}\n$$\n\nsuch that \n\n$$\n{u}_{1}\\cdot {u}_{2}=0\\,\\text{and}\\,‖{u}_{2}‖=1.\n$$\n\n \n\nSolving ${u}_{1}\\cdot {u}_{2}=0,$ which is equivalent to\n\n$$\n\\frac{3}{\\sqrt{13}}{x}_{1}+\\frac{2}{\\sqrt{13}}{x}_{2}=0,\n$$\n\nwe get a nonzero solution $\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix}.$ Normalizing this vector, we finally obtain the  second column of $U:$\n\n$$\n{u}_{2}=\\frac{1}{\\sqrt{13}}\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix}=\\begin{bmatrix}-\\frac{2}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}}\\end{bmatrix}\n$$"] [:db/cas 17592186497352 :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}-3 & -4 \\\\ 0 & 1\\end{aligned}]x(t)+\\overset{f(t)}{\\overset{⏞}{[\\begin{aligned}-6 \\\\ 4\\end{aligned}]}},\\,Φ=[\\begin{aligned}{e}^{-3t} & -{e}^{t} \\\\ 0 & {e}^{t}\\end{aligned}]\n$$\n\nConsider the system of differential equations and the fundamental matrix of the corresponding homogeneous system above. Using the method of variation of parameters, compute ${Φ}^{-1}\\,f(t)$ and the particular solution ${x}_{p}(t)$ of the system.\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">${Φ}^{-1}\\,f(t)=\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">$-2{e}^{3t}$</td>\n<td width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$\\,,\\,$</td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">${x}_{p}(t)=\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">$\\frac{10}{3}$</td>\n<td width=\"5px\"></td>\n<td height=\"40px\" rowspan=\"2\"></td>\n</tr>\n<tr>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td></td>\n</tr>\n</tbody></table>" "$$\n{x}^{′}(t)=\\begin{bmatrix}-3 & -4 \\\\ 0 & 1\\end{bmatrix}x(t)+\\overset{f(t)}{\\overset{⏞}{\\begin{bmatrix}-6 \\\\ 4\\end{bmatrix}}},\\,Φ=\\begin{bmatrix}{e}^{-3t} & -{e}^{t} \\\\ 0 & {e}^{t}\\end{bmatrix}\n$$\n\nConsider the system of differential equations and the fundamental matrix of the corresponding homogeneous system above. Using the method of variation of parameters, compute ${Φ}^{-1}\\,f(t)$ and the particular solution ${x}_{p}(t)$ of the system.\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">${Φ}^{-1}\\,f(t)=\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">$-2{e}^{3t}$</td>\n<td width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$\\,,\\,$</td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">${x}_{p}(t)=\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">$\\frac{10}{3}$</td>\n<td width=\"5px\"></td>\n<td height=\"40px\" rowspan=\"2\"></td>\n</tr>\n<tr>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td></td>\n</tr>\n</tbody></table>"] [:db/cas 17592186497352 :question/worked-solution "We'll look for a particular solution in the form\n\n$$\n{x}_{p}(t)=Φ\\,u(t)\n$$\n\nwhere $Φ$ is a fundamental matrix for the corresponding homogeneous system, $f(t)$ is the forcing column vector and\n\n$$\nu(t)=\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t.\n$$\n\nIn our case,\n\n$$\nΦ=[\\begin{aligned}{e}^{-3t} & -{e}^{t} \\\\ 0 & {e}^{t}\\end{aligned}],\\,f(t)=[\\begin{aligned}-6 \\\\ 4\\end{aligned}].\n$$\n\nSince $Φ$ is a fundamental matrix, it must be invertible. Using the formula for the inverse of a $2\\times 2$ matrix, we get the following:\n\n$$\n\\begin{aligned}{Φ}^{-1} & =\\frac{1}{{e}^{-3t}{e}^{t}-0\\cdot {e}^{t}}[\\begin{aligned}{e}^{t} & {e}^{t} \\\\ 0 & {e}^{-3t}\\end{aligned}] \\\\  & ={e}^{2t}[\\begin{aligned}{e}^{t} & {e}^{t} \\\\ 0 & {e}^{-3t}\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{3t} & {e}^{3t} \\\\ 0 & {e}^{-t}\\end{aligned}]. \\\\ {Φ}^{-1}\\,f(t) & =[\\begin{aligned}{e}^{3t} & {e}^{3t} \\\\ 0 & {e}^{-t}\\end{aligned}][\\begin{aligned}-6 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}-2{e}^{3t} \\\\ 4{e}^{-t}\\end{aligned}]\\end{aligned}\n$$\n\nNow, using our formula for $u(t),$ we obtain\n\n$$\n\\begin{aligned}u(t) & =\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t \\\\  & =\\int [\\begin{aligned}-2{e}^{3t} \\\\ 4{e}^{-t}\\end{aligned}]\\,\\text{d}t \\\\  & =[\\begin{aligned}\\int -2{e}^{3t}\\,\\text{d}t \\\\ \\int 4{e}^{-t}\\,\\text{d}t\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{-2}{3}{e}^{3t} \\\\ -4{e}^{-t}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{x}_{p}(t) & =Φ\\,u(t) \\\\  & =[\\begin{aligned}{e}^{-3t} & -{e}^{t} \\\\ 0 & {e}^{t}\\end{aligned}]\\,[\\begin{aligned}\\frac{-2}{3}{e}^{3t} \\\\ -4{e}^{-t}\\end{aligned}]. \\\\  & =[\\begin{aligned}\\frac{10}{3} \\\\ -4\\end{aligned}].\\end{aligned}\n$$" "We'll look for a particular solution in the form\n\n$$\n{x}_{p}(t)=Φ\\,u(t)\n$$\n\nwhere $Φ$ is a fundamental matrix for the corresponding homogeneous system, $f(t)$ is the forcing column vector and\n\n$$\nu(t)=\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t.\n$$\n\nIn our case,\n\n$$\nΦ=\\begin{bmatrix}{e}^{-3t} & -{e}^{t} \\\\ 0 & {e}^{t}\\end{bmatrix},\\,f(t)=\\begin{bmatrix}-6 \\\\ 4\\end{bmatrix}.\n$$\n\nSince $Φ$ is a fundamental matrix, it must be invertible. Using the formula for the inverse of a $2\\times 2$ matrix, we get the following:\n\n$$\n\\begin{aligned}{Φ}^{-1} & =\\frac{1}{{e}^{-3t}{e}^{t}-0\\cdot {e}^{t}}\\begin{bmatrix}{e}^{t} & {e}^{t} \\\\ 0 & {e}^{-3t}\\end{bmatrix} \\\\  & ={e}^{2t}\\begin{bmatrix}{e}^{t} & {e}^{t} \\\\ 0 & {e}^{-3t}\\end{bmatrix} \\\\  & =\\begin{bmatrix}{e}^{3t} & {e}^{3t} \\\\ 0 & {e}^{-t}\\end{bmatrix}. \\\\ {Φ}^{-1}\\,f(t) & =\\begin{bmatrix}{e}^{3t} & {e}^{3t} \\\\ 0 & {e}^{-t}\\end{bmatrix}\\begin{bmatrix}-6 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2{e}^{3t} \\\\ 4{e}^{-t}\\end{bmatrix}\\end{aligned}\n$$\n\nNow, using our formula for $u(t),$ we obtain\n\n$$\n\\begin{aligned}u(t) & =\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t \\\\  & =\\int \\begin{bmatrix}-2{e}^{3t} \\\\ 4{e}^{-t}\\end{bmatrix}\\,\\text{d}t \\\\  & =\\begin{bmatrix}\\int -2{e}^{3t}\\,\\text{d}t \\\\ \\int 4{e}^{-t}\\,\\text{d}t\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{-2}{3}{e}^{3t} \\\\ -4{e}^{-t}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{x}_{p}(t) & =Φ\\,u(t) \\\\  & =\\begin{bmatrix}{e}^{-3t} & -{e}^{t} \\\\ 0 & {e}^{t}\\end{bmatrix}\\,\\begin{bmatrix}\\frac{-2}{3}{e}^{3t} \\\\ -4{e}^{-t}\\end{bmatrix}. \\\\  & =\\begin{bmatrix}\\frac{10}{3} \\\\ -4\\end{bmatrix}.\\end{aligned}\n$$"] [:db/cas 17592186497377 :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}7 & -6 \\\\ 9 & -8\\end{aligned}]x(t)+[\\begin{aligned}5t \\\\ 0\\end{aligned}]\n$$\n\nConsider the system of differential equations. Using the method of variation of parameters, the general solution of the equation can be written in the form\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$x(t)={c}_{1}[\\begin{aligned}2 \\\\ 3\\end{aligned}]{e}^{-2t}+{c}_{2}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{t}-\\,\\,\\frac{1}{4}$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">.</td>\n</tr>\n<tr>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">$90t+45$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" "$$\n{x}^{′}(t)=\\begin{bmatrix}7 & -6 \\\\ 9 & -8\\end{bmatrix}x(t)+\\begin{bmatrix}5t \\\\ 0\\end{bmatrix}\n$$\n\nConsider the system of differential equations. Using the method of variation of parameters, the general solution of the equation can be written in the form\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$x(t)={c}_{1}\\begin{bmatrix}2 \\\\ 3\\end{bmatrix}{e}^{-2t}+{c}_{2}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}{e}^{t}-\\,\\,\\frac{1}{4}$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">.</td>\n</tr>\n<tr>\n<td height=\"30px\" width=\"5px\"></td>\n<t