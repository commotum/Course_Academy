qrt{5}\\end{aligned}]$\nand \n$B=[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}].$" "Find the product $AB$, if\n$A=\\begin{bmatrix}\\sqrt{3} & -5 & 5 \\\\ -5 & 3\\sqrt{2} & -3.5 \\\\ 1 & 2 & -4\\sqrt{5}\\end{bmatrix}$\nand \n$B=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}.$"] [:db/cas 17592186392435 :question/worked-solution "Notice that $B$ is the $3$rd *column* of the identity matrix ${I}_{3}.$\n\nSince we're multiplying the $3\\times 3$ matrix $A$ by the $3$rd *column* of the identity matrix ${I}_{3}$, the result must be the $3$rd column of $A.$ Therefore,\n\n$$\nAB=[\\begin{aligned}5 \\\\ -3.5 \\\\ -4\\sqrt{5}\\end{aligned}].\n$$\n\n \n\nLet's check the long way:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}\\sqrt{3} & -5 & 5 \\\\ -5 & 3\\sqrt{2} & -3.5 \\\\ 1 & 2 & -4\\sqrt{5}\\end{aligned}][\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}\\sqrt{3}\\cdot 0+(-5)\\cdot 0+5\\cdot 1 \\\\ (-5)\\cdot 0+3\\sqrt{2}\\cdot 0+(-3.5)\\cdot 1 \\\\ 1\\cdot 0+2\\cdot 0+(-4\\sqrt{5})\\cdot 1\\end{aligned}] \\\\  & =[\\begin{aligned}5 \\\\ -3.5 \\\\ -4\\sqrt{5}\\end{aligned}]\\end{aligned}\n$$" "Notice that $B$ is the $3$rd *column* of the identity matrix ${I}_{3}.$\n\nSince we're multiplying the $3\\times 3$ matrix $A$ by the $3$rd *column* of the identity matrix ${I}_{3}$, the result must be the $3$rd column of $A.$ Therefore,\n\n$$\nAB=\\begin{bmatrix}5 \\\\ -3.5 \\\\ -4\\sqrt{5}\\end{bmatrix}.\n$$\n\n \n\nLet's check the long way:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}\\sqrt{3} & -5 & 5 \\\\ -5 & 3\\sqrt{2} & -3.5 \\\\ 1 & 2 & -4\\sqrt{5}\\end{bmatrix}\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\sqrt{3}\\cdot 0+(-5)\\cdot 0+5\\cdot 1 \\\\ (-5)\\cdot 0+3\\sqrt{2}\\cdot 0+(-3.5)\\cdot 1 \\\\ 1\\cdot 0+2\\cdot 0+(-4\\sqrt{5})\\cdot 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 \\\\ -3.5 \\\\ -4\\sqrt{5}\\end{bmatrix}\\end{aligned}\n$$"] [:db/cas 17592186392437 :answer/value "[\\begin{aligned}5 \\\\ -3.5 \\\\ -4\\sqrt{5