 & -26 & -23 \\\\ 0 & 1 & 10 & 8\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=[\\begin{aligned}-26 & -23 \\\\ 10 & 8\\end{aligned}].\n$$" "Let's denote the vectors of $B$ as ${{b}_{1},{b}_{2}}.$ The $B$-matrix for $T$ is a matrix whose columns are the coordinates of the vectors $T({b}_{1})$ and $T({b}_{2})$ relative to the basis $B.$\n\nTo find the coordinates of $T({b}_{1})$ and $T({b}_{2})$ relative to the basis $B$, we consider the matrix\n\n$$\nM=\\begin{bmatrix}| & | & | & | \\\\ {b}_{1} & {b}_{2} & T({b}_{1}) & T({b}_{2}) \\\\ | & | & | & |\\end{bmatrix}.\n$$\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $B$-matrix for $T:$\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 3 & 4 & 1 \\\\ -3 & -8 & -2 & 5\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+3{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 3 & 4 & 1 \\\\ 0 & 1 & 10 & 8\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:={R}_{1}-3{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & -26 & -23 \\\\ 0 & 1 & 10 & 8\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=\\begin{bmatrix}-26 & -23 \\\\ 10 & 8\\end{bmatrix}.\n$$"] [:db/cas 17592186392187 :answer/value "[\\begin{aligned}-26 & -23 \\\\ 10 & 8\\end{aligned}]" "\\begin{bmatrix}-26 & -23 \\\\ 10 & 8\\end{bmatrix}"] [:db/cas 17592186392188 :answer/value "[\\begin{aligned}-23 & -26 \\\\ 10 & 8\\end{aligned}]" "\\begin{bmatrix}-23 & -26 \\\\ 10 & 8\\end{bmatrix}"] [:db/cas 17592186392189 :answer/value "[\\begin{aligned}-16 & -13 \\\\ 10 & 8\\end{aligned}]" "\\begin{bmatrix}-16 & -13 \\\\ 10 & 8\\end{bmatrix}"] [:db/cas 17592186392190 :answer/value "[\\begin{aligned}-26 & -23 \\\\ 8 & 10\\end{aligned}]" "\\begin{bmatrix}-26 & -23 \\\\ 8 & 10\\end{bmatrix}"] [:db/cas 17592186392191 :answer/value "[\\begin{aligned}8 & -23 \\\\ 10 & -26\\end{aligned}]" "\\begin{bmatrix}8 & -23 \\\\ 10 & -26\\end{bmatrix}"] 