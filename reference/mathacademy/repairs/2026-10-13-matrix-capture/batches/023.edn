\end{aligned}]\\cdot {e}^{t} \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{3t} \\\\ 1\\end{aligned}]\\end{aligned}\n$$" "Using the chain rule, we can write\n\n$$\n(f∘u)^{′}(t)={f}^{′}(u(t)){u}^{′}(t).\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(u) & =\\begin{bmatrix}\\frac{\\text{d}}{\\text{d}u}(\\operatorname{cos}⁡u) \\\\ \\frac{\\text{d}}{\\text{d}u}\\,({u}^{3}) \\\\ \\frac{\\text{d}}{\\text{d}u}(\\operatorname{ln}⁡u)\\end{bmatrix}=\\begin{bmatrix}-\\operatorname{sin}⁡u \\\\ 3{u}^{2} \\\\ \\frac{1}{u}\\end{bmatrix} \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & ={f}^{′}(u(t)){u}^{′}(t) \\\\  & =\\begin{bmatrix}-\\operatorname{sin}⁡(u(t)) \\\\ 3(u(t))^{2} \\\\ \\frac{1}{u(t)}\\end{bmatrix}\\cdot {u}^{′}(t) \\\\  & =\\begin{bmatrix}-\\operatorname{sin}⁡({e}^{t}) \\\\ 3({e}^{t})^{2} \\\\ \\frac{1}{{e}^{t}}\\end{bmatrix}\\cdot {e}^{t} \\\\  & =\\begin{bmatrix}-\\operatorname{sin}⁡({e}^{t}) \\\\ 3{e}^{2t} \\\\ \\frac{1}{{e}^{t}}\\end{bmatrix}\\cdot {e}^{t} \\\\  & =\\begin{bmatrix}-\\operatorname{sin}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{3t} \\\\ 1\\end{bmatrix}\\end{aligned}\n$$"] [:db/cas 17592186393010 :answer/value "[\\begin{aligned}-\\operatorname{cos}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{t} \\\\ 1\\end{aligned}]" "\\begin{bmatrix}-\\operatorname{cos}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{t} \\\\ 1\\end{bmatrix}"] [:db/cas 17592186393011 :answer/value "[\\begin{aligned}-\\operatorname{sin}⁡({e}^{2t}) \\\\ 3{e}^{2t} \\\\ 1\\end{aligned}]" "\\begin{bmatrix}-\\operatorname{sin}⁡({e}^{2t}) \\\\ 3{e}^{2t} \\\\ 1\\end{bmatrix}"] [:db/cas 17592186393012 :answer/value "[\\begin{aligned}\\operatorname{cos}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{3t} \\\\ {e}^{2t}\\end{aligned}]" "\\begin{bmatrix}\\operatorname{cos}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{3t} \\\\ {e}^{2t}\\end{bmatrix}"] [:db/cas 17592186393013 :answer/value "[\\begin{aligned}\\operatorna