#{[{:db/id #edb/ref 17592186508210 :knowledge-point/_questions [{:db/id #edb/ref 17592186073752 :knowledge-point/id #uuid "5e79a91b-c479-53da-9f06-59c082fa4187" :knowledge-point/title "Solving a System of Linear Equations Using Substitution" :topic/_knowledge-points [{:db/id #edb/ref 17592186048826 :topic/title "Solving Systems of Equations by Substitution"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0095545e-54d6-52cd-924a-d0a5a2f5a1ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186508169} {:answer/id #uuid "2f4bd4b3-9bdd-5c11-8b51-838c43d39c9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186508180} {:answer/id #uuid "337996a5-122c-53fe-a44a-810d11d9fbdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186508184} {:answer/id #uuid "3c4b4903-fe0a-5fb0-a751-3f0fa8df877f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186508186} {:answer/id #uuid "6432dee2-0978-5e2c-8294-660f6ce4dc02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186508202}] :answer-field/correct {:answer/id #uuid "6432dee2-0978-5e2c-8294-660f6ce4dc02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186508202} :answer-field/id #uuid "d61ec2e2-631a-51c9-9a12-395b3a9c74bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186508231}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "873b7f6f-85bd-5d73-adb8-dc5d593e552e" :question/problem "Given the system of equations below, what is the value of $a - b$?\n\n$$\n\\left\\{\\begin{aligned}-3a-3b &=6 \\\\ -4a+b &=-7\\end{aligned}\\right.\n$$" :question/worked-solution "We will isolate a variable in one of the equations and then substitute it into the other equation. \n\nUsing the second equation, we can isolate $b$:\n\n$$\n\\begin{aligned}-4a+b & =-7 \\\\ b & =-7+4a\\end{aligned}\n$$\n\nThen, we substitute $b=-7+4a$ into the first equation and solve for $a:$\n\n$$\n\\begin{aligned}-3a-3b & =6 \\\\ -3a-3(-7+4a) & =6 \\\\ -3a+21-12a & =6 \\\\ -15a+21 & =6 \\\\ -15a & =-15 \\\\ a & =1\\end{aligned}\n$$\n\nIf we now substitute $a=1$ into $b=-7+4a,$ we can then find the value of $b:$\n\n$$\n\\begin{aligned}b & =-7+4(1) \\\\ b & =-3\\end{aligned}\n$$\n\nTherefore, $a-b=1-(-3)=4.$"}] [{:db/id #edb/ref 17592186508215 :knowledge-point/_questions [{:db/id #edb/ref 17592186073752 :knowledge-point/id #uuid "5e79a91b-c479-53da-9f06-59c082fa4187" :knowledge-point/title "Solving a System of Linear Equations Using Substitution" :topic/_knowledge-points [{:db/id #edb/ref 17592186048826 :topic/title "Solving Systems of Equations by Substitution"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a525fbe-b100-56e5-b363-b84bd9a5d52e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186508173} {:answer/id #uuid "5b7578d1-6cb2-5958-9c79-b1f69ff339d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186508199} {:answer/id #uuid "9fbaa74b-19ed-5c95-b977-ac0cc7054256" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186508222} {:answer/id #uuid "b7b07809-444e-59d8-a95b-553b710baa60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186508229} {:answer/id #uuid "eac62da3-8a0e-571b-9e13-3d68ba632045" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186508235}] :answer-field/correct {:answer/id #uuid "0a525fbe-b100-56e5-b363-b84bd9a5d52e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186508173} :answer-field/id #uuid "97f66384-4244-5039-a3bb-781c22ba011e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186508218}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9362a51f-6c19-5264-931e-57aaf13ce3e6" :question/problem "Given the system of equations below, what is the value of $a - b$?\n\n$$\n\\left\\{\\begin{aligned}-2a-4b &=-14 \\\\ -2a+b &=6\\end{aligned}\\right.\n$$" :question/worked-solution "We will isolate a variable in one of the equations and then substitute it into the other equation. \n\nUsing the second equation, we can isolate $b$:\n\n$$\n\\begin{aligned}-2a+b & =6 \\\\ b & =6+2a\\end{aligned}\n$$\n\nThen, we substitute $b=6+2a$ into the first equation and solve for $a:$\n\n$$\n\\begin{aligned}-2a-4b & =-14 \\\\ -2a-4(6+2a) & =-14 \\\\ -2a-24-8a & =-14 \\\\ -10a-24 & =-14 \\\\ -10a & =10 \\\\ a & =-1\\end{aligned}\n$$\n\nIf we now substitute $a=-1$ into $b=6+2a,$ we can then find the value of $b:$\n\n$$\n\\begin{aligned}b & =6+2(-1) \\\\ b & =4\\end{aligned}\n$$\n\nTherefore, $a-b=-1-(4)=-5.$"}] [{:db/id #edb/ref 17592186508227 :knowledge-point/_questions [{:db/id #edb/ref 17592186073752 :knowledge-point/id #uuid "5e79a91b-c479-53da-9f06-59c082fa4187" :knowledge-point/title "Solving a System of Linear Equations Using Substitution" :topic/_knowledge-points [{:db/id #edb/ref 17592186048826 :topic/title "Solving Systems of Equations by Substitution"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e04510d-2fe1-543a-ac55-911f068010c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186508221}] :answer-field/correct {:answer/id #uuid "9e04510d-2fe1-543a-ac55-911f068010c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186508221} :answer-field/id #uuid "496722ff-acc0-5b76-a13e-09917012d73d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186508192} {:answer-field/choices [{:answer/id #uuid "08a38b64-b8c2-526f-8347-6ba7980eb350" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{3}" :db/id #edb/ref 17592186508172}] :answer-field/correct {:answer/id #uuid "08a38b64-b8c2-526f-8347-6ba7980eb350" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{3}" :db/id #edb/ref 17592186508172} :answer-field/id #uuid "b547fc55-eab5-5d24-ba49-2faa2df55e6a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186508228}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b0966484-f411-5cf8-8677-c24b7843a43c" :question/problem "Find the solution $(x,y)$ to this system using the method of substitution.\n\n$$\n\\left\\{\\begin{aligned}5x-2y &=5 \\\\ 2x+y &=-1\\end{aligned}\\right.\n$$\n\nThe solution is $($ {{field-1}} $, $ {{field-2}} $)$" :question/worked-solution "We will isolate a variable in one of the equations and then substitute it into the other equation. \n\nUsing the second equation, we can isolate $y$:\n\n$$\n\\begin{aligned}2x+y & =-1 \\\\ y & =-1-2x\\end{aligned}\n$$\n\nThen, we substitute $y=-1-2x$ into the first equation and solve for $x:$\n\n$$\n\\begin{aligned}5x-2y & =5 \\\\ 5x-2(-1-2x) & =5 \\\\ 5x+2+4x & =5 \\\\ 9x+2 & =5 \\\\ 9x & =3 \\\\ x & =\\frac{1}{3}\\end{aligned}\n$$\n\nIf we now substitute $x=\\frac{1}{3}$ into $y=-1-2x,$ we can then find the value of $y:$\n\n$$\n\\begin{aligned}y & =-1-2(\\frac{1}{3}) \\\\ y & =-\\frac{5}{3}\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=\\frac{1}{3},\\,y=-\\frac{5}{3}.$"}] [{:db/id #edb/ref 17592186508233 :knowledge-point/_questions [{:db/id #edb/ref 17592186073752 :knowledge-point/id #uuid "5e79a91b-c479-53da-9f06-59c082fa4187" :knowledge-point/title "Solving a System of Linear Equations Using Substitution" :topic/_knowledge-points [{:db/id #edb/ref 17592186048826 :topic/title "Solving Systems of Equations by Substitution"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "609dae4d-f20b-597d-8d5c-bd3985bfb3ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186508200}] :answer-field/correct {:answer/id #uuid "609dae4d-f20b-597d-8d5c-bd3985bfb3ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186508200} :answer-field/id #uuid "313ebe14-9bc4-580a-8ef0-cc446d43568b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186508182} {:answer-field/choices [{:answer/id #uuid "54ede735-9e0a-5b8d-8cb8-1ec5b24e8a75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{3}" :db/id #edb/ref 17592186508195}] :answer-field/correct {:answer/id #uuid "54ede735-9e0a-5b8d-8cb8-1ec5b24e8a75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{3}" :db/id #edb/ref 17592186508195} :answer-field/id #uuid "40fbd52d-5989-56ab-8589-60d240620d11" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186508190}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ddedcc45-5aba-5229-89b3-d8e7abbe4344" :question/problem "Find the solution $(x,y)$ to this system using the method of substitution.\n\n$$\n\\left\\{\\begin{aligned}2x+2y &=12 \\\\ -2x+y &=5\\end{aligned}\\right.\n$$\n\nThe solution is $($ {{field-1}} $, $ {{field-2}} $)$" :question/worked-solution "We will isolate a variable in one of the equations and then substitute it into the other equation. \n\nUsing the second equation, we can isolate $y$:\n\n$$\n\\begin{aligned}-2x+y & =5 \\\\ y & =5+2x\\end{aligned}\n$$\n\nThen, we substitute $y=5+2x$ into the first equation and solve for $x:$\n\n$$\n\\begin{aligned}2x+2y & =12 \\\\ 2x+2(5+2x) & =12 \\\\ 2x+10+4x & =12 \\\\ 6x+10 & =12 \\\\ 6x & =2 \\\\ x & =\\frac{1}{3}\\end{aligned}\n$$\n\nIf we now substitute $x=\\frac{1}{3}$ into $y=5+2x,$ we can then find the value of $y:$\n\n$$\n\\begin{aligned}y & =5+2(\\frac{1}{3}) \\\\ y & =\\frac{17}{3}\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=\\frac{1}{3},\\,y=\\frac{17}{3}.$"}] [{:db/id #edb/ref 17592186508249 :knowledge-point/_questions [{:db/id #edb/ref 17592186192655 :knowledge-point/id #uuid "3e7bfcbe-4913-53e0-98c7-171965adfe62" :knowledge-point/title "Eliminating the Second Variable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050190 :topic/title "Solving Systems of Linear Equations Using Elimination: One Transformation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ffbf027-a8c3-57cc-b9a9-4640b8800250" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186508253} {:answer/id #uuid "1a0c1fe8-1252-52c2-9c87-6db5b5d15c17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186508260} {:answer/id #uuid "2c42c3f1-acac-508c-a741-325c7f155335" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186508269} {:answer/id #uuid "613b124a-52a6-536f-b5bf-a938b8a9516b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186508303}] :answer-field/correct {:answer/id #uuid "2c42c3f1-acac-508c-a741-325c7f155335" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186508269} :answer-field/id #uuid "0c2f485c-c0f1-591b-86b0-fe957edd4a4f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186508250} {:answer-field/choices [{:answer/id #uuid "29b35e16-f22f-597d-93ba-b82e8bf204f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "second" :db/id #edb/ref 17592186508267} {:answer/id #uuid "e49c439c-a969-56e3-a863-ca3dbe265312" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "first" :db/id #edb/ref 17592186508363}] :answer-field/correct {:answer/id #uuid "e49c439c-a969-56e3-a863-ca3dbe265312" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "first" :db/id #edb/ref 17592186508363} :answer-field/id #uuid "f300ef54-4bdd-5f40-99eb-20c59ef401be" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186508369}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0b561ffa-2e48-5300-9c0f-dc37e617a67e" :question/problem "Consider the following system of equations.\n$$\n\\left\\{\\begin{aligned}-8a + 4b &=5 \\\\ -2a - 12b &=5\\end{aligned}\\right.\n$$\nDescribe the steps needed to eliminate the variable $b$ from the system:\nUse an integer multiplier and leave the other equation unchanged.\n\nTo eliminate $b$, multiply the\n{{field-1}}\nequation by\n{{field-2}},\nand add the equations." :question/worked-solution "Notice that the coefficient of $b$ in the first equation is $4$, while in the second equation it is $-12$.\n\nIf we multiply the first equation by ${\\color{blue}3}$, then the coefficient of $b$ will turn into $12$, which will cancel with the coefficient of $-12$ in the second equation.\n\n$$\n\\left\\{\\begin{aligned}&(-8a + 4b = 5)\\cdot (3) \\\\ &-2a - 12b = 5\\end{aligned}\\right.\n$$\n\nNow, when we add the two equations, the variable $b$ will be eliminated:\n\n$$\n\\begin{aligned}\n-24a + 12b &= 15 \\\\\n-2a - 12b &= 5 \\\\\n(-24a - 2a) &= (15 + 5) \\\\\n-26a &= 20\n\\end{aligned}\n$$\n\nTherefore, the correct answer is the following:\n\n> *To eliminate $b$, multiply the $\\bbox[3pt,Gainsboro]{\\color{blue}\\text{first}}$ equation by $\\bbox[3pt,Gainsboro]{\\color{blue}3}$, and add the equations*."}] [{:db/id #edb/ref 17592186508268 :knowledge-point/_questions [{:db/id #edb/ref 17592186192655 :knowledge-point/id #uuid "3e7bfcbe-4913-53e0-98c7-171965adfe62" :knowledge-point/title "Eliminating the Second Variable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050190 :topic/title "Solving Systems of Linear Equations Using Elimination: One Transformation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48f8e738-0572-5121-922d-d8e38fb86c3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186508286} {:answer/id #uuid "4cd845b8-5401-5d60-a03b-9a759c275fb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186508287} {:answer/id #uuid "a112c9cb-8d88-5623-a13e-d989a8243fa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186508331} {:answer/id #uuid "f803e108-8054-582f-a2d5-145329d8c27d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186508371}] :answer-field/correct {:answer/id #uuid "48f8e738-0572-5121-922d-d8e38fb86c3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186508286} :answer-field/id #uuid "075b0439-b453-57c0-a744-1bcb64243346" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186508247} {:answer-field/choices [{:answer/id #uuid "9c454440-b1b8-513b-9f73-0f7dc8536063" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "first" :db/id #edb/ref 17592186508328} {:answer/id #uuid "a6e83d65-e084-55b9-9c2a-92d5a80729d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "second" :db/id #edb/ref 17592186508334}] :answer-field/correct {:answer/id #uuid "9c454440-b1b8-513b-9f73-0f7dc8536063" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "first" :db/id #edb/ref 17592186508328} :answer-field/id #uuid "ccc2f91f-fe2d-582d-b3e5-fdf6e12b119f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186508350}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2b1cb458-ef47-59b8-b185-bca727e5bdc2" :question/problem "Consider the following system of equations.\n$$\n\\left\\{\\begin{aligned}5a - 4b &=6 \\\\ 8a - 24b &=-6\\end{aligned}\\right.\n$$\nDescribe the steps needed to eliminate the variable $b$ from the system:\nUse an integer multiplier and leave the other equation unchanged.\n\nTo eliminate $b$, multiply the\n{{field-1}}\nequation by\n{{field-2}},\nand add the equations." :question/worked-solution "Notice that the coefficient of $b$ in the first equation is $-4$, while in the second equation it is $-24$.\n\nIf we multiply the first equation by ${\\color{blue}-6}$, then the coefficient of $b$ will turn into $24$, which will cancel with the coefficient of $-24$ in the second equation.\n\n$$\n\\left\\{\\begin{aligned}&(5a - 4b = 6)\\cdot (-6) \\\\ &8a - 24b = -6\\end{aligned}\\right.\n$$\n\nNow, when we add the two equations, the variable $b$ will be eliminated:\n\n$$\n\\begin{aligned}\n-30a + 24b &= -36 \\\\\n8a - 24b &= -6 \\\\\n(-30a + 8a) &= (-36 - 6) \\\\\n-22a &= -42\n\\end{aligned}\n$$\n\nTherefore, the correct answer is the following:\n\n> *To eliminate $b$, multiply the $\\bbox[3pt,Gainsboro]{\\color{blue}\\text{first}}$ equation by $\\bbox[3pt,Gainsboro]{\\color{blue}-6}$, and add the equations*."}] [{:db/id #edb/ref 17592186508298 :knowledge-point/_questions [{:db/id #edb/ref 17592186192655 :knowledge-point/id #uuid "3e7bfcbe-4913-53e0-98c7-171965adfe62" :knowledge-point/title "Eliminating the Second Variable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050190 :topic/title "Solving Systems of Linear Equations Using Elimination: One Transformation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "621daa3f-f6bd-5b36-9874-b650477f8088" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186508305} {:answer/id #uuid "a2985571-dbf8-51bf-a4f9-d9b6a23fb056" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186508332} {:answer/id #uuid "c2e22db4-43ce-578a-b7fc-4204d456f11a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186508343} {:answer/id #uuid "ef083660-ccf2-5acb-becc-021580a075e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186508368}] :answer-field/correct {:answer/id #uuid "c2e22db4-43ce-578a-b7fc-4204d456f11a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186508343} :answer-field/id #uuid "68ee5b4f-0b69-590f-a728-db8f8c5b2a77" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17