$-3$, then the $y$-coefficient will become $-6$, which will cancel with the coefficient of $6$ in the first equation.\n\n$$\n\\{ x+6y=-17; \\left(-7x+2y=-13\\right)\\cdot (-3)\n$$\n\nNow, when we add the two equations, the variable $y$ will be eliminated:\n\n$$\n\\begin{aligned}\nx+6y&=-17 \\\\\n21x-6y&=39 \\\\\n(x+21x)&=(-17+39) \\\\\n22x&=22 \\\\\nx&=1\n\\end{aligned}\n$$\n\nSo, the solution must have $x = 1$. However, we still need to find $y$. To do this, we substitute $x = 1$ back into one of the equations. Let's choose the second equation:\n\n$$\n\\begin{aligned}\n-7x+2y&=-13 \\\\\n-7(1)+2y&=-13 \\\\\n-7+2y&=-13 \\\\\n2y&=-6 \\\\\ny&=-3\n\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is\n\n$$\nx = 1, \\,y = -3\n$$\n\nwhich can be expressed as $(1,-3)$."} {:db/id #edb/ref 17592186509271 :knowledge-point/_questions [{:db/id #edb/ref 17592186192657 :knowledge-point/id #uuid "238f847f-5009-5183-b9bd-b8e136f0ba4d" :knowledge-point/title "Solving a System of Equations by Eliminating the Second Variable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050190 :topic/title "Solving Systems of Linear Equations Using Elimination: One Transformation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f908001-8c0e-5ad5-bf2c-a4aae8e1a691" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186509264}] :answer-field/correct {:answer/id #uuid "0f908001-8c0e-5ad5-bf2c-a4aae8e1a691" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186509264} :answer-field/id #uuid "cc24fa13-ffeb-5ff7-9dbb-b1d479e2964b" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186509330} {:answer-field/choices [{:answer/id #uuid "0e86f70f-2c51-5c48-9d22-0d5dc6889c88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186509263}] :answer-field/correct {:answer/id #uuid "0e86f70f-2c51-5c48-9d22-0d5dc6889c88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186509263} :answer-field/id #uuid "d5fd3803-15e2-50c5-94bb-4bdef29b8a99" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186509334}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "23b70eba-8c0c-5171-b139-0ac2370d20a6" :question/problem "Consider the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}5x+14y&=-36\\\\-7x-2y&=-20\\end{aligned}\\right.\n$$\n\nFind the solution $(x, y)$ to this system by eliminating the variable $y$.\n\nThe solution is $($ {{field-1}} $,$ {{field-2}} $)$." :question/worked-solution "Notice that the $y$-coefficient in the first equation is $14$, while in the second equation it is $-2$.\n\nIf we multiply the second equation by $7$, then the $y$-coefficient will become $-14$, which will cancel with the coefficient of $14$ in the first equation.\n\n$$\n\\{ 5x+14y=-36; \\left(-7x-2y=-20\\right)\\cdot (7)\n$$\n\nNow, when we add the two equations, the variable $y$ will be eliminated:\n\n$$\n\\begin{aligned}\n5x+14y&=-36 \\\\\n-49x-14y&=-140 \\\\\n(5x-49x)&=(-36-140) \\\\\n-44x&=-176 \\\\\nx&=4\n\\end{aligned}\n$$\n\nSo, the solution must have $x = 4$. However, we still need to find $y$. To do this, we substitute $x = 4$ back into one of the equations. Let's choose the second equation:\n\n$$\n\\begin{aligned}\n-7x-2y&=-20 \\\\\n-7(4)-2y&=-20 \\\\\n-28-2y&=-20 \\\\\n-2y&=8 \\\\\ny&=-4\n\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is\n\n$$\nx = 4, \\,y = -4\n$$\n\nwhich can be expressed as $(4,-4)$."} {:db/id #edb/ref 17592186509278 :knowledge-point/_questions [{:db/id #edb/ref 17592186192657 :knowledge-point/id #uuid "238f847f-5009-5183-b9bd-b8e136f0ba4d" :knowledge-point/title "Solving a System of Equations by Eliminating the Second Variable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050190 :topic/title "Solving Systems of Linear Equations Using Elimination: One Transformation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b382fd6-c1bc-58a5-ab3b-203bfcd1d3f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-10)" :db/id #edb/ref 17592186509275} {:answer/id #uuid "35155a6e-f543-56cc-895d-88462084d35c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,-3)" :db/id #edb/ref 17592186509277} {:answer/id #uuid "8ee68739-5943-5dba-a7b3-6a408d7f228a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,3)" :db/id #edb/ref 17592186509309} {:answer/id #uuid "bf7dc056-edde-5f96-a671-5ccf85ff5755" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- \\frac{64}{5},- \\frac{99}{5})" :db/id #edb/ref 17592186509324} {:answer/id #uuid "f8dcd307-0ccd-537f-902c-16a48c2e11dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,-11)" :db/id #edb/ref 17592186509342}] :answer-field/correct {:answer/id #uuid "35155a6e-f543-56cc-895d-88462084d35c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,-3)" :db/id #edb/ref 17592186509277} :answer-field/id #uuid "76d0f030-a9e9-5940-9a6d-793769aabcc4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186509300}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3775b5ec-0d42-5ee6-ba36-8700f462d97a" :question/problem "Find the solution $(x, y)$ to the following system of equations using the elimination method:\n$$\n\\left\\{\\begin{aligned}-x+y&=-7\\\\x-6y&=22\\end{aligned}\\right.\n$$\n\n*Hint: Eliminate the variable $y$.*" :question/worked-solution "Notice that the $y$-coefficient in the first equation is $1$, while in the second equation it is $-6$.\n\nIf we multiply the first equation by $6$, then the $y$-coefficient will become $6$, which will cancel with the coefficient of $-6$ in the second equation.\n\n$$\n\\{ \\left(-x+y=-7\\right)\\cdot (6); x-6y=22\n$$\n\nNow, when we add the two equations, the variable $y$ will be eliminated:\n\n$$\n\\begin{aligned}\n-6x+6y&=-42 \\\\\nx-6y&=22 \\\\\n(-6x+x)&=(-42+22) \\\\\n-5x&=-20 \\\\\nx&=4\n\\end{aligned}\n$$\n\nSo, the solution must have $x = 4$. However, we still need to find $y$. To do this, we substitute $x = 4$ back into one of the equations. Let's choose the first equation:\n\n$$\n\\begin{aligned}\n-x+y&=-7 \\\\\n-1(4)+y&=-7 \\\\\n-4+y&=-7 \\\\\ny&=-3\n\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is\n\n$$\nx = 4, \\,y = -3\n$$\n\nwhich can be expressed as $(4,-3)$."} {:db/id #edb/ref 17592186509288 :knowledge-point/_questions [{:db/id #edb/ref 17592186192657 :knowledge-point/id #uuid "238f847f-5009-5183-b9bd-b8e136f0ba4d" :knowledge-point/title "Solving a System of Equations by Eliminating the Second Variable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050190 :topic/title "Solving Systems of Linear Equations Using Elimination: One Transformation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26cfe277-3842-5747-9ee0-6c4247fead55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,3)" :db/id #edb/ref 17592186509273} {:answer/id #uuid "450b54a2-ea5c-555a-b4d6-fe9b7a919372" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,27)" :db/id #edb/ref 17592186509283} {:answer/id #uuid "97dffbe1-1bb5-5124-8577-4fb6de014f06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- \\frac{23}{13},\\frac{264}{13})" :db/id #edb/ref 17592186509313} {:answer/id #uuid "a2934f92-f656-5bd6-8747-1b6db11bc275" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,-3)" :db/id #edb/ref 17592186509316} {:answer/id #uuid "f434a981-e2a2-536d-8559-c0efa231bcb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- \\frac{68}{13},\\frac{399}{13})" :db/id #edb/ref 17592186509340}] :answer-field/correct {:answer/id #uuid "26cfe277-3842-5747-9ee0-6c4247fead55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,3)" :db/id #edb/ref 17592186509273} :answer-field/id #uuid "0b38b033-45ad-5b3e-b165-1a07d9c9cdc8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186509261}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "575d3d25-ee48-560a-beb0-60eb637f5795" :question/problem "Find the solution $(x, y)$ to the following system of equations using the elimination method:\n$$\n\\left\\{\\begin{aligned}-x+4y&=8\\\\3x+y&=15\\end{aligned}\\right.\n$$\n\n*Hint: Eliminate the variable $y$.*" :question/worked-solution "Notice that the $y$-coefficient in the first equation is $4$, while in the second equation it is $1$.\n\nIf we multiply the second equation by $-4$, then the $y$-coefficient will become $-4$, which will cancel with the coefficient of $4$ in the first equation.\n\n$$\n\\{ -x+4y=8; \\left(3x+y=15\\right)\\cdot (-4)\n$$\n\nNow, when we add the two equations, the variable $y$ will be eliminated:\n\n$$\n\\begin{aligned}\n-x+4y&=8 \\\\\n-12x-4y&=-60 \\\\\n(-x-12x)&=(8-60) \\\\\n-13x&=-52 \\\\\nx&=4\n\\end{aligned}\n$$\n\nSo, the solution must have $x = 4$. However, we still need to find $y$. To do this, we substitute $x = 4$ back into one of the equations. Let's choose the second equation:\n\n$$\n\\begin{aligned}\n3x+y&=15 \\\\\n3(4)+y&=15 \\\\\n12+y&=15 \\\\\ny&=3\n\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is\n\n$$\nx = 4, \\,y = 3\n$$\n\nwhich can be expressed as $(4,3)$."} {:db/id #edb/ref 17592186509302 :knowledge-point/_questions [{:db/id #edb/ref 17592186192657 :knowledge-point/id #uuid "238f847f-5009-5183-b9bd-b8e136f0ba4d" :knowledge-point/title "Solving a System of Equations by Eliminating the Second Variable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050190 :topic/title "Solving Systems of Linear Equations Using Elimination: One Transformation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13e27713-0c32-5160-bf48-8794b4ef56ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-2)" :db/id #edb/ref 17592186509265} {:answer/id #uuid "37d9b91c-a905-57ce-81a0-85f4eccb157f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- \\frac{1}{2},- \\frac{11}{4})" :db/id #edb/ref 17592186509279} {:answer/id #uuid "82de173e-ffef-54ef-bc13-55db11bad3d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,- \\frac{1}{2})" :db/id #edb/ref 17592186509306} {:answer/id #uuid "c1fbed6e-fb34-5ad3-8ef9-483b59c4fa39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-3)" :db/id #edb/ref 17592186509325} {:answer/id #uuid "e6a705a0-e0c3-5f06-aaae-681a63958822" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,6)" :db/id #edb/ref 17592186509337}] :answer-field/correct {:answer/id #uuid "c1fbed6e-fb34-5ad3-8ef9-483b59c4fa39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-3)" :db/id #edb/ref 17592186509325} :answer-field/id #uuid "b7e82569-1864-5896-a52b-68af45977480" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186509322}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "78207f23-12ee-53c5-9f78-9395f0921474" :question/problem "Find the solution $(x, y)$ to the following system of equations using the elimination method:\n$$\n\\left\\{\\begin{aligned}x-2y&=5\\\\7x-6y&=11\\end{aligned}\\right.\n$$\n\n*Hint: Eliminate the variable $y$.*" :question/worked-solution "Notice that the $y$-coefficient in the first equation is $-2$, while in the second equation it is $-6$.\n\nIf we multiply the first equation by $-3$, then the $y$-coefficient will become $6$, which will cancel with the coefficient of $-6$ in the second equation.\n\n$$\n\\{ \\left(x-2y=5\\right)\\cdot (-3); 7x-6y=11\n$$\n\nNow, when we add the two equations, the variable $y$ will be eliminated:\n\n$$\n\\begin{aligned}\n-3x+6y&=-15 \\\\\n7x-6y&=11 \\\\\n(-3x+7x)&=(-15+11) \\\\\n4x&=-4 \\\\\nx&=-1\n\\end{aligned}\n$$\n\nSo, the solution must have $x = -1$. However, we still need to find $y$. To do this, we substitute $x = -1$ back into one of the equations. Let's choose the first equation:\n\n$$\n\\begin{aligned}\nx-2y&=5 \\\\\n1(-1)-2y&=5 \\\\\n-1-2y&=5 \\\\\n-2y&=6 \\\\\ny&=-3\n\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is\n\n$$\nx = -1, \\,y = -3\n$$\n\nwhich can be expressed as $(-1,-3)$."} {:db/id #edb/ref 17592186509308 :knowledge-point/_questions [{:db/id #edb/ref 17592186192657 :knowledge-point/id #uuid "238f847f-5009-5183-b9bd-b8e136f0ba4d" :knowledge-point/title "Solving a System of Equations by Eliminating the Second Variable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050190 :topic/title "Solving Systems of Linear Equations Using Elimination: One Transformation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30dff6f0-44a2-569f-9cf5-16833973d9d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- \\frac{48}{43},- \\frac{895}{86})" :db/id #edb/ref 17592186509276} {:answer/id #uuid "5445dbb7-2643-5c0f-a09e-cd8ccf6fd047" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,3)" :db/id #edb/ref 17592186509286} {:answer/id #uuid "6ba4ae51-6c73-5240-afd2-12a95ee94548" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-10)" :db/id #edb/ref 17592186509297} {:answer/id #uuid "77ffeb13-0d3e-595c-929a-d62967cf28a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-3)" :db/id #edb/ref 17592186509301} {:answer/id #uuid "cd313717-399a-59fe-9882-55714ce7fdb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- \\frac{113}{43},- \\frac{675}{43})" :db/id #edb/ref 17592186509331}] :answer-field/correct {:answer/id #uuid "77ffeb13-0d3e-595c-929a-d62967cf28a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-3)" :db/id #edb/ref 17592186509301} :answer-field/id #uuid "b210daf5-f7c9-544f-a57c-87c7b7a3a074" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186509320}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "888444ab-20f1-5ac7-85e7-9089399fd1bb" :question/problem "Find the solution $(x, y)$ to the following system of equations using the elimination method:\n$$\n\\left\\{\\begin{aligned}x+12y&=-35\\\\-7x+2y&=-13\\end{aligned}\\right.\n$$\n\n*Hint: Eliminate the variable $y$.*" :question/worked-solution "Notice that the $y$-coefficient in the first equation is $12$, while in the second equation it is $2$.\n\nIf we multiply the second equation by $-6$, then the $y$-coefficient will become $-12$, which will cancel with the coefficient of $12$ in the first equation.\n\n$$\n\\{ x+12y=-35; \\left(-7x+2y=-13\\right)\\cdot (-6)\n$$\n\nNow, when we add the two equations, the variable $y$ will be eliminated:\n\n$$\n\\begin{aligned}\nx+12y&=-35 \\\\\n42x-12y&=78 \\\\\n(x+42x)&=(-35+78) \\\\\n43x&=43 \\\\\nx&=1\n\\end{aligned}\n$$\n\nSo, the solution must have $x = 1$. However, we still need to find $y$. To do this, we substitute $x = 1$ back into one of the equations. Let's choose the second equation:\n\n$$\n\\begin{aligned}\n-7x+2y&=-13 \\\\\n-7(1)+2y&=-13 \\\\\n-7+2y&=-13 \\\\\n2y&=-6 \\\\\ny&=-3\n\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is\n\n$$\nx = 1, \\,y = -3\n$$\n\nwhich can be expressed as $(1,-3)$."} {:db/id #edb/ref 17592186509310 :knowledge-point/_questions [{:db/id #edb/ref 17592186192657 :knowledge-point/id #uuid "238f847f-5009-5183-b9bd-b8e136f0ba4d" :knowledge-point/title "Solving a System of Equations by Eliminating the Second Variable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050190 :topic/title "Solving Systems of Linear Equations Using Elimination: One Transformation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c580255-e760-5f33-8c6a-2550a573a799" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-22,52)" :db/id #edb/ref 17592186509262} {:answer/id #uuid "57ef6484-bebb-5270-9134-2a94851e1343" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,2)" :db/id #edb/ref 17592186509289} {:answer/id #uuid "65e68218-6593-5454-a9fc-d17eedb52630" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- \\frac{10}{11},- \\frac{8}{11})" :db/id #edb/ref 17592186509295} {:answer/id #uuid "d7b0f169-c30c-552b-b0d7-efdfc48e9c64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-8)" :db/id #edb/ref 17592186509335} {:answer/id #uuid "eadf7382-2d55-5dc8-a450-064d2a4cf6fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-4)" :db/id #edb/ref 17592186509338}] :answer-field/correct {:answer/id #uuid "57ef6484-bebb-5270-9134-2a94851e1343" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,2)" :db/id #edb/ref 17592186509289} :answer-field/id #uuid "2658620e-2fcd-55d0-9ddc-b610c83e058d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186509272}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "90d0118c-789c-54fc-9fd4-a48e58b92b30" :question/problem "Find the solution $(x, y)$ to the following system of equations using the elimination method:\n$$\n\\left\\{\\begin{aligned}-5x-2y&=6\\\\3x+10y&=14\\end{aligned}\\right.\n$$\n\n*Hint: Eliminate the variable $y$.*" :question/worked-solution "Notice that the $y$-coefficient in the first equation is $-2$, while in the second equation it is $10$.\n\nIf we multiply the first equation by $5$, then the $y$-coefficient will become $-10$, which will cancel with the coefficient of $10$ in the second equation.\n\n$$\n\\{ \\left(-5x-2y=6\\right)\\cdot (5); 3x+10y=14\n$$\n\nNow, when we add the two equations, the variable $y$ will be eliminated:\n\n$$\n\\begin{aligned}\n-25x-10y&=30 \\\\\n3x+10y&=14 \\\\\n(-25x+3x)&=(30+14) \\\\\n-22x&=44 \\\\\nx&=-2\n\\end{aligned}\n$$\n\nSo, the solution must have $x = -2$. However, we still need to find $y$. To do this, we substitute $x = -2$ back into one of the equations. Let's choose the first equation:\n\n$$\n\\begin{aligned}\n-5x-2y&=6 \\\\\n-5(-2)-2y&=6 \\\\\n10-2y&=6 \\\\\n-2y&=-4 \\\\\ny&=2\n\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is\n\n$$\nx = -2, \\,y = 2\n$$\n\nwhich can be expressed as $(-2,2)$."} {:db/id #edb/ref 17592186509318 :knowledge-point/_questions [{:db/id #edb/ref 17592186192657 :knowledge-point/id #uuid "238f847f-5009-5183-b9bd-b8e136f0ba4d" :knowledge-point/title "Solving a System of Equations by Eliminating the Second Variable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050190 :topic/title "Solving Systems of Linear Equations Using Elimination: One Transformation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d2421c4-3e95-5a88-8c94-267fc39c0f35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,2)" :db/id #edb/ref 17592186509298} {:answer/id #uuid "7135885d-50ad-52a2-b1d8-046d4c8b8464" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,0)" :db/id #edb/ref 17592186509299} {:answer/id #uuid "7935b5f6-9317-5d13-a182-f177d4cf51e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\frac{1}{2})" :db/id #edb/ref 17592186509303} {:answer/id #uuid "7ac1beda-ed4c-5a56-9a2c-7d43cc5905f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,1)" :db/id #edb/ref 17592186509304} {:answer/id #uuid "b920b780-bd99-5c37-9e3d-f93a43c3c601" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- \\frac{1}{2},\\frac{3}{4})" :db/id #edb/ref 17592186509323}] :answer-field/correct {:answer/id #uuid "7ac1beda-ed4c-5a56-9a2c-7d43cc5905f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,1)" :db/id #edb/ref 17592186509304} :answer-field/id #uuid "c3a96850-9a06-5e2c-8ce5-899e594c0915" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186509326}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ad8b1c30-588c-535a-9132-16c79af9dfe2" :question/problem "Find the solution $(x, y)$ to the following system of equations using the elimination method:\n$$\n\\left\\{\\begin{aligned}5x+4y&=-1\\\\x+2y&=1\\end{aligned}\\right.\n$$\n\n*Hint: Eliminate the variable $y$.*" :question/worked-solution "Notice that the $y$-coefficient in the first equation is $4$, while in the second equation it is $2$.\n\nIf we multiply the second equation by $-2$, then the $y$-coefficient will become $-4$, which will cancel with the coefficient of $4$ in the first equation.\n\n$$\n\\{ 5x+4y=-1; \\left(x+2y=1\\right)\\cdot (-2)\n$$\n\nNow, when we add the two equations, the variable $y$ will be eliminated:\n\n$$\n\\begin{aligned}\n5x+4y&=-1 \\\\\n-2x-4y&=-2 \\\\\n(5x-2x)&=(-1-2) \\\\\n3x&=-3 \\\\\nx&=-1\n\\end{aligned}\n$$\n\nSo, the solution must have $x = -1$. However, we still need to find $y$. To do this, we substitute $x = -1$ back into one of the equations. Let's choose the second equation:\n\n$$\n\\begin{aligned}\nx+2y&=1 \\\\\n1(-1)+2y&=1 \\\\\n-1+2y&=1 \\\\\n2y&=2 \\\\\ny&=1\n\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is\n\n$$\nx = -1, \\,y = 1\n$$\n\nwhich can be expressed as $(-1,1)$."} {:db/id #edb/ref 17592186509328 :knowledge-point/_questions [{:db/id #edb/ref 17592186192657 :knowledge-point/id #uuid "238f847f-5009-5183-b9bd-b8e136f0ba4d" :knowledge-point/title "Solving a System of Equations by Eliminating the Second Variable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050190 :topic/title "Solving Systems of Linear Equations Using Elimination: One Transformation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66300ce6-b475-5d0f-b089-ac8eec2807a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186509296}] :answer-field/correct {:answer/id #uuid "66300ce6-b475-5d0f-b089-ac8eec2807a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186509296} :answer-field/id #uuid "4fec54cb-9c85-5252-8582-cea05545c3ba" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186509285} {:answer-field/choices [{:answer/id #uuid "5709927f-d51f-5749-a92a-072b5998a2f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186509287}] :answer-field/correct {:answer/id #uuid "5709927f-d51f-5749-a92a-072b5998a2f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186509287} :answer-field/id #uuid "c3de5a92-faa1-5773-9a97-9f5b9fa3c657" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186509327}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c4b00c48-3459-54dd-a97b-4752b54d2e62" :question/problem "Consider the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}5x+8y&=-12\\\\-7x-2y&=-20\\end{aligned}\\right.\n$$\n\nFind the solution $(x, y)$ to this system by eliminating the variable $y$.\n\nThe solution is $($ {{field-1}} $,$ {{field-2}} $)$." :question/worked-solution "Notice that the $y$-coefficient in the first equation is $8$, while in the second equation it is $-2$.\n\nIf we multiply the second equation by $4$, then the $y$-coefficient will become $-8$, which will cancel with the coefficient of $8$ in the first equation.\n\n$$\n\\{ 5x+8y=-12; \\left(-7x-2y=-20\\right)\\cdot (4)\n$$\n\nNow, when we add the two equations, the variable $y$ will be eliminated:\n\n$$\n\\begin{aligned}\n5x+8y&=-12 \\\\\n-28x-8y&=-80 \\\\\n(5x-28x)&=(-12-80) \\\\\n-23x&=-92 \\\\\nx&=4\n\\end{aligned}\n$$\n\nSo, the solution must have $x = 4$. However, we still need to find $y$. To do this, we substitute $x = 4$ back into one of the equations. Let's choose the second equation:\n\n$$\n\\begin{aligned}\n-7x-2y&=-20 \\\\\n-7(4)-2y&=-20 \\\\\n-28-2y&=-20 \\\\\n-2y&=8 \\\\\ny&=-4\n\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is\n\n$$\nx = 4, \\,y = -4\n$$\n\nwhich can be expressed as $(4,-4)$."} {:db/id #edb/ref 17592186509333 :knowledge-point/_questions [{:db/id #edb/ref 17592186192657 :knowledge-point/id #uuid "238f847f-5009-5183-b9bd-b8e136f0ba4d" :knowledge-point/title "Solving a System of Equations by Eliminating the Second Variable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050190 :topic/title "Solving Systems of Linear Equations Using Elimination: One Transformation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b4363e1-914f-5143-818c-f9a250cf4675" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{9}{19},- \\frac{265}{57})" :db/id #edb/ref 17592186509280} {:answer/id #uuid "58d587da-c716-5846-9cf4-4ad93c3d7829" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5,3)" :db/id #edb/ref 17592186509291} {:answer/id #uuid "93e6532a-ea86-5e9b-b388-cca7bcfcdbde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5,-1)" :db/id #edb/ref 17592186509312} {:answer/id #uuid "b17056e7-740c-572d-a1a8-6081d649e85d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- \\frac{95}{3},\\frac{151}{9})" :db/id #edb/ref 17592186509319} {:answer/id #uuid "d05f6b87-d487-5741-a054-888fc5a7888a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5,- \\frac{23}{3})" :db/id #edb/ref 17592186509332}] :answer-field/correct {:answer/id #uuid "93e6532a-ea86-5e9b-b388-cca7bcfcdbde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5,-1)" :db/id #edb/ref 17592186509312} :answer-field/id #uuid "07e1e4bf-ace0-570f-9bd6-71262f095a75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186509260}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d5c3f388-7843-5364-910c-9e97bb540c6d" :question/problem "Find the solution $(x, y)$ to the following system of equations using the elimination method:\n$$\n\\left\\{\\begin{aligned}-2x-3y&=13\\\\5x-21y&=-4\\end{aligned}\\right.\n$$\n\n*Hint: Eliminate the variable $y$.*" :question/worked-solution "Notice that the $y$-coefficient in the first equation is $-3$, while in the second equation it is $-21$.\n\nIf we multiply the first equation by $-7$, then the $y$-coefficient will become $21$, which will cancel with the coefficient of $-21$ in the second equation.\n\n$$\n\\{ \\left(-2x-3y=13\\right)\\cdot (-7); 5x-21y=-4\n$$\n\nNow, when we add the two equations, the variable $y$ will be eliminated:\n\n$$\n\\begin{aligned}\n14x+21y&=-91 \\\\\n5x-21y&=-4 \\\\\n(14x+5x)&=(-91-4) \\\\\n19x&=-95 \\\\\nx&=-5\n\\end{aligned}\n$$\n\nSo, the solution must have $x = -5$. However, we still need to find $y$. To do this, we substitute $x = -5$ back into one of the equations. Let's choose the first equation:\n\n$$\n\\begin{aligned}\n-2x-3y&=13 \\\\\n-2(-5)-3y&=13 \\\\\n10-3y&=13 \\\\\n-3y&=3 \\\\\ny&=-1\n\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is\n\n$$\nx = -5, \\,y = -1\n$$\n\nwhich can be expressed as $(-5,-1)$."} {:db/id #edb/ref 17592186509339 :knowledge-point/_questions [{:db/id #edb/ref 17592186192657 :knowledge-point/id #uuid "238f847f-5009-5183-b9bd-b8e136f0ba4d" :knowledge-point/title "Solving a System of Equations by Eliminating the Second Variable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050190 :topic/title "Solving Systems of Linear Equations Using Elimination: One Transformation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ecbbb5e-3ed2-528e-830c-64e987e989da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-9)" :db/id #edb/ref 17592186509281} {:answer/id #uuid "42e7ebb4-26b8-5fd9-b9bf-6edb7cf93ed3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-5)" :db/id #edb/ref 17592186509282} {:answer/id #uuid "843072f9-f614-5e55-8bf0-12fd95bdb012" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(9,-1)" :db/id #edb/ref 17592186509307} {:answer/id #uuid "991361f4-364a-57db-97a8-04a5f7037455" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,15)" :db/id #edb/ref 17592186509314} {:answer/id #uuid "ad644440-f651-5dad-b438-815e63a116ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,- \\frac{29}{3})" :db/id #edb/ref 17592186509317}] :answer-field/correct {:answer/id #uuid "42e7ebb4-26b8-5fd9-b9bf-6edb7cf93ed3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-5)" :db/id #edb/ref 17592186509282} :answer-field/id #uuid "5bccdb9c-e6cc-546c-bc1f-af909a73f4f9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186509293}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ef7f3552-0ad8-5545-8673-2b2894d40ad4" :question/problem "Find the solution $(x, y)$ to the following system of equations using the elimination method:\n$$\n\\left\\{\\begin{aligned}-x+6y&=-33\\\\2x-3y&=21\\end{aligned}\\right.\n$$\n\n*Hint: Eliminate the variable $y$.*" :question/worked-solution "Notice that the $y$-coefficient in the first equation is $6$, while in the second equation it is $-3$.\n\nIf we multiply the second equation by $2$, then the $y$-coefficient will become $-6$, which will cancel with the coefficient of $6$ in the first equation.\n\n$$\n\\{ -x+6y=-33; \\left(2x-3y=21\\right)\\cdot (2)\n$$\n\nNow, when we add the two equations, the variable $y$ will be eliminated:\n\n$$\n\\begin{aligned}\n-x+6y&=-33 \\\\\n4x-6y&=42 \\\\\n(-x+4x)&=(-33+42) \\\\\n3x&=9 \\\\\nx&=3\n\\end{aligned}\n$$\n\nSo, the solution must have $x = 3$. However, we still need to find $y$. To do this, we substitute $x = 3$ back into one of the equations. Let's choose the second equation:\n\n$$\n\\begin{aligned}\n2x-3y&=21 \\\\\n2(3)-3y&=21 \\\\\n6-3y&=21 \\\\\n-3y&=15 \\\\\ny&=-5\n\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is\n\n$$\nx = 3, \\,y = -5\n$$\n\nwhich can be expressed as $(3,-5)$."} {:db/id #edb/ref 17592186509344 :knowledge-point/_questions [{:db/id #edb/ref 17592186192657 :knowledge-point/id #uuid "238f847f-5009-5183-b9bd-b8e136f0ba4d" :knowledge-point/title "Solving a System of Equations by Eliminating the Second Variable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050190 :topic/title "Solving Systems of Linear Equations Using Elimination: One Transformation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28d9b9f6-af1e-5d04-81f6-d3e14d15ba37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{33}{5},- \\frac{166}{15})" :db/id #edb/ref 17592186509274} {:answer/id #uuid "4dee1735-757a-5a7e-8abc-3d08ac98a01a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- \\frac{19}{33},\\frac{562}{99})" :db/id #edb/ref 17592186509284} {:answer/id #uuid "581c1cfe-6f4b-5f91-ad28-ceabe0e592f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,2)" :db/id #edb/ref 17592186509290} {:answer/id #uuid "61a29bde-d4a9-528b-90d5-e13febae164b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-6)" :db/id #edb/ref 17592186509294} {:answer/id #uuid "b681415e-0e9c-5a64-970d-72037254e2cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,\\frac{20}{3})" :db/id #edb/ref 17592186509321}] :answer-field/correct {:answer/id #uuid "581c1cfe-6f4b-5f91-ad28-ceabe0e592f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,2)" :db/id #edb/ref 17592186509290} :answer-field/id #uuid "8275be3d-f06e-52aa-9799-9ef432738ad0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186509305}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fe868340-7a35-5fed-a08d-ce25cbc1fbb9" :question/problem "Find the solution $(x, y)$ to the following system of equations using the elimination method:\n$$\n\\left\\{\\begin{aligned}2x+15y&=32\\\\-7x-3y&=-13\\end{aligned}\\right.\n$$\n\n*Hint: Eliminate the variable $y$.*" :question/worked-solution "Notice that the $y$-coefficient in the first equation is $15$, while in the second equation it is $-3$.\n\nIf we multiply the second equation by $5$, then the $y$-coefficient will become $-15$, which will cancel with the coefficient of $15$ in the first equation.\n\n$$\n\\{ 2x+15y=32; \\left(-7x-3y=-13\\right)\\cdot (5)\n$$\n\nNow, when we add the two equations, the variable $y$ will be eliminated:\n\n$$\n\\begin{aligned}\n2x+15y&=32 \\\\\n-35x-15y&=-65 \\\\\n(2x-35x)&=(32-65) \\\\\n-33x&=-33 \\\\\nx&=1\n\\end{aligned}\n$$\n\nSo, the solution must have $x = 1$. However, we still need to find $y$. To do this, we substitute $x = 1$ back into one of the equations. Let's choose the second equation:\n\n$$\n\\begin{aligned}\n-7x-3y&=-13 \\\\\n-7(1)-3y&=-13 \\\\\n-7-3y&=-13 \\\\\n-3y&=-6 \\\\\ny&=2\n\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is\n\n$$\nx = 1, \\,y = 2\n$$\n\nwhich can be expressed as $(1,2)$."} {:db/id #edb/ref 17592186529261 :knowledge-point/_questions [{:db/id #edb/ref 17592186073776 :knowledge-point/id #uuid "a24fb4f3-6e3c-5c45-b31e-85b7ce290eda" :knowledge-point/title "Finding the Number of Solutions to a System" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ee3752b-c151-5d7c-b459-269e7a440470" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529275} {:answer/id #uuid "ad343ca9-8ee8-59ee-8492-d87f4e5767a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529312} {:answer/id #uuid "afaa3c2f-68a9-5e46-b525-4af2bb7fbccd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529314}] :answer-field/correct {:answer/id #uuid "ad343ca9-8ee8-59ee-8492-d87f4e5767a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529312} :answer-field/id #uuid "431a38a6-e58c-5853-ad1f-a6fc6bb01e65" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186529269}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "17e3609b-1396-5685-843a-74d27fdadf0f" :question/problem "Consider the following system of equations:\n\n$\\{-2x + y = 6; x - 2y = 6$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nNotice that if we multiply the second equation by $2$, then we will get a $2x$ term that can cancel with the $-2x$ term in the first equation:\n\n$$\n\\{-2x + y = 6; x - 2y = 6 \\mid \\mid \\cdot (2)\n$$\n\nWhen we add the two equations, the $x$ terms cancel, and we can solve for $y$:\n\n$$\n\\begin{aligned}\n-2x + y &= 6 \\\\\n2x - 4y &= 12 \\\\\n-3y &= (6 + 12) \\\\\n-3y &= 18 \\\\\ny &= -6\n\\end{aligned}\n$$\n\nSubstituting into the first equation gives:\n\n$$\n\\begin{aligned}\n-2x + (1)(-6) &= 6 \\\\\n-2x &= 12 \\\\\nx &= -6\n\\end{aligned}\n$$\n\nThe system has *a single solution*, $(-6,-6)$."} {:db/id #edb/ref 17592186529263 :knowledge-point/_questions [{:db/id #edb/ref 17592186073776 :knowledge-point/id #uuid "a24fb4f3-6e3c-5c45-b31e-85b7ce290eda" :knowledge-point/title "Finding the Number of Solutions to a System" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71a19f9f-c97f-5b22-a3fb-3ddd84649033" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529285} {:answer/id #uuid "7968a19d-81e4-508f-8ec6-11e1b7db0381" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529288} {:answer/id #uuid "cd558f16-0c95-5532-85ce-16a34dea6a67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529319}] :answer-field/correct {:answer/id #uuid "7968a19d-81e4-508f-8ec6-11e1b7db0381" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529288} :answer-field/id #uuid "a88aecce-0e48-579b-8ac8-fffb289b1a69" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186529308}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "22c76199-015b-5355-8da5-51b3e4eb6386" :question/problem "Consider the following system of equations:\n\n$\\{y + 2x + 4 = 0; 4y - 4x + 9 = 0$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nFirst, rearrange each equation to put the variable terms on the left and the constant on the right:\n\n$$\n\\begin{aligned}\n2x + y &= -4 \\\\\n-4x + 4y &= -9\n\\end{aligned}\n$$\n\nNotice that if we multiply the first equation by $2$, then we will get a $4x$ term that can cancel with the $-4x$ term in the second equation:\n\n$$\n\\{2x + y = -4 \\mid \\mid \\cdot (2); -4x + 4y = -9\n$$\n\nWhen we add the two equations, the $x$ terms cancel, and we can solve for $y$:\n\n$$\n\\begin{aligned}\n4x + 2y &= -8 \\\\\n-4x + 4y &= -9 \\\\\n6y &= (-8 - 9) \\\\\n6y &= -17 \\\\\ny &= - \\frac{17}{6}\n\\end{aligned}\n$$\n\nSubstituting into the first equation gives:\n\n$$\n\\begin{aligned}\n2x + (1)(- \\frac{17}{6}) &= -4 \\\\\n2x &= - \\frac{7}{6} \\\\\nx &= - \\frac{7}{12}\n\\end{aligned}\n$$\n\nThe system has *a single solution*, $(- \\frac{7}{12},- \\frac{17}{6})$."} {:db/id #edb/ref 17592186529265 :knowledge-point/_questions [{:db/id #edb/ref 17592186073776 :knowledge-point/id #uuid "a24fb4f3-6e3c-5c45-b31e-85b7ce290eda" :knowledge-point/title "Finding the Number of Solutions to a System" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "344db828-cf79-52e5-a777-8ab84b874966" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529268} {:answer/id #uuid "95396471-ccc2-5ee9-a8d6-43bc15e844c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529298} {:answer/id #uuid "dcdd0cde-b36f-54e5-a018-7db85e9b5a1f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529324}] :answer-field/correct {:answer/id #uuid "344db828-cf79-52e5-a777-8ab84b874966" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529268} :answer-field/id #uuid "65b4752f-c56d-5617-8e96-0a2d7a4fd12a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186529281}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "27a6ba63-3c85-5feb-bfac-b122a5e9f9a3" :question/problem "Consider the following system of equations:\n\n$\\{-4x + 4y = -9; 2x - y = -4$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nNotice that if we multiply the second equation by $2$, then we will get a $4x$ term that can cancel with the $-4x$ term in the first equation:\n\n$$\n\\{-4x + 4y = -9; 2x - y = -4 \\mid \\mid \\cdot (2)\n$$\n\nWhen we add the two equations, the $x$ terms cancel, and we can solve for $y$:\n\n$$\n\\begin{aligned}\n-4x + 4y &= -9 \\\\\n4x - 2y &= -8 \\\\\n2y &= (-9 - 8) \\\\\n2y &= -17 \\\\\ny &= - \\frac{17}{2}\n\\end{aligned}\n$$\n\nSubstituting into the first equation gives:\n\n$$\n\\begin{aligned}\n-4x + (4)(- \\frac{17}{2}) &= -9 \\\\\n-4x &= 25 \\\\\nx &= - \\frac{25}{4}\n\\end{aligned}\n$$\n\nThe system has *a single solution*, $(- \\frac{25}{4},- \\frac{17}{2})$."} {:db/id #edb/ref 17592186529266 :knowledge-point/_questions [{:db/id #edb/ref 17592186073776 :knowledge-point/id #uuid "a24fb4f3-6e3c-5c45-b31e-85b7ce290eda" :knowledge-point/title "Finding the Number of Solutions to a System" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fbdb8ad-267a-57e1-90cb-804824fd158a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529259} {:answer/id #uuid "31e0880c-27b5-5a13-87e6-3705af860da9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529267} {:answer/id #uuid "8c8210fd-75fb-5771-887f-af1bb8ec8244" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529295}] :answer-field/correct {:answer/id #uuid "8c8210fd-75fb-5771-887f-af1bb8ec8244" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529295} :answer-field/id #uuid "6093ddec-b3cd-5a0b-8a78-bde2db784aa4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186529278}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "31a5b8b3-2787-5aca-9212-729c0bca425f" :question/problem "Consider the following system of equations:\n\n$\\{y + 2x + 2 = 0; 4y + 8x + 8 = 0$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nFirst, rearrange each equation to put the variable terms on the left and the constant on the right:\n\n$$\n\\begin{aligned}\n2x + y &= -2 \\\\\n8x + 4y &= -8\n\\end{aligned}\n$$\n\nNotice that if we multiply the first equation by $-4$, then we will get a $-8x$ term that can cancel with the $8x$ term in the second equation:\n\n$$\n\\{2x + y = -2 \\mid \\mid \\cdot (-4); 8x + 4y = -8\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n-8x - 4y &= 8 \\\\\n8x + 4y &= -8 \\\\\n0 &= (8 - 8) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nThe statement $0=0$ is *always true*. Therefore, we conclude that the system has *infinitely many solutions*."} {:db/id #edb/ref 17592186529271 :knowledge-point/_questions [{:db/id #edb/ref 17592186073776 :knowledge-point/id #uuid "a24fb4f3-6e3c-5c45-b31e-85b7ce290eda" :knowledge-point/title "Finding the Number of Solutions to a System" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "193a9776-9522-59e8-93fb-4b3bab86a5ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529262} {:answer/id #uuid "ac9317b7-c236-5932-99c1-b650c3ecfd60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529311} {:answer/id #uuid "ece64018-7584-599e-8625-2cc9d1912aa3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529327}] :answer-field/correct {:answer/id #uuid "ece64018-7584-599e-8625-2cc9d1912aa3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529327} :answer-field/id #uuid "e77cb455-ca55-5d77-ab3a-caef6fb910d6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186529326}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "45038183-ddb8-5749-92cf-2124aeefd6a9" :question/problem "Consider the following system of equations:\n\n$\\{2x + y = 2; 4x + 2y = 5$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nNotice that if we multiply the first equation by $-2$, then we will get a $-4x$ term that can cancel with the $4x$ term in the second equation:\n\n$$\n\\{2x + y = 2 \\mid \\mid \\cdot (-2); 4x + 2y = 5\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a false statement:\n\n$$\n\\begin{aligned}\n-4x - 2y &= -4 \\\\\n4x + 2y &= 5 \\\\\n0 &= (-4 + 5) \\\\\n0 &= 1\n\\end{aligned}\n$$\n\nThe statement $0=1$ is *always false*. Therefore, we conclude that the system has *no solutions*."} {:db/id #edb/ref 17592186529284 :knowledge-point/_questions [{:db/id #edb/ref 17592186073776 :knowledge-point/id #uuid "a24fb4f3-6e3c-5c45-b31e-85b7ce290eda" :knowledge-point/title "Finding the Number of Solutions to a System" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a6a9c04-4483-5b31-88cd-fdc0d4f8dfab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529273} {:answer/id #uuid "6532299d-7242-529d-b584-f2d02d122b29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529280} {:answer/id #uuid "a3bb91a8-f370-546d-8650-fc4b5ac0f2bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529304}] :answer-field/correct {:answer/id #uuid "a3bb91a8-f370-546d-8650-fc4b5ac0f2bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529304} :answer-field/id #uuid "571d0d37-8178-57f9-8598-a1a4ba418722" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186529277}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6df7ea41-de66-50d4-b68f-ac8978094097" :question/problem "Consider the following system of equations:\n\n$\\{y - 3x + 1 = 0; -3y - 6x - 8 = 0$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nFirst, rearrange each equation to put the variable terms on the left and the constant on the right:\n\n$$\n\\begin{aligned}\n-3x + y &= -1 \\\\\n-6x - 3y &= 8\n\\end{aligned}\n$$\n\nNotice that if we multiply the first equation by $-2$, then we will get a $6x$ term that can cancel with the $-6x$ term in the second equation:\n\n$$\n\\{-3x + y = -1 \\mid \\mid \\cdot (-2); -6x - 3y = 8\n$$\n\nWhen we add the two equations, the $x$ terms cancel, and we can solve for $y$:\n\n$$\n\\begin{aligned}\n6x - 2y &= 2 \\\\\n-6x - 3y &= 8 \\\\\n-5y &= (2 + 8) \\\\\n-5y &= 10 \\\\\ny &= -2\n\\end{aligned}\n$$\n\nSubstituting into the first equation gives:\n\n$$\n\\begin{aligned}\n-3x + (1)(-2) &= -1 \\\\\n-3x &= 1 \\\\\nx &= - \\frac{1}{3}\n\\end{aligned}\n$$\n\nThe system has *a single solution*, $(- \\frac{1}{3},-2)$."} {:db/id #edb/ref 17592186529290 :knowledge-point/_questions [{:db/id #edb/ref 17592186073776 :knowledge-point/id #uuid "a24fb4f3-6e3c-5c45-b31e-85b7ce290eda" :knowledge-point/title "Finding the Number of Solutions to a System" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46de5fcd-a47b-5970-9703-3a33b936c273" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529272} {:answer/id #uuid "9f4a900e-af83-5010-a4eb-550d23e0386f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529302} {:answer/id #uuid "c4bc71c3-edaf-56da-873d-7ff9f6b2544c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529317}] :answer-field/correct {:answer/id #uuid "9f4a900e-af83-5010-a4eb-550d23e0386f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529302} :answer-field/id #uuid "defa217b-2cb1-5a93-8730-0a2de2c923fb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186529325}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7b1e2d9a-93ed-5edd-af89-794105a0828b" :question/problem "Consider the following system of equations:\n\n$\\{2x - 3y = 10; 2x - y = 6$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nNotice that if we multiply the first equation by $-1$, then we will get a $-2x$ term that can cancel with the $2x$ term in the second equation:\n\n$$\n\\{2x - 3y = 10 \\mid \\mid \\cdot (-1); 2x - y = 6\n$$\n\nWhen we add the two equations, the $x$ terms cancel, and we can solve for $y$:\n\n$$\n\\begin{aligned}\n-2x + 3y &= -10 \\\\\n2x - y &= 6 \\\\\n2y &= (-10 + 6) \\\\\n2y &= -4 \\\\\ny &= -2\n\\end{aligned}\n$$\n\nSubstituting into the first equation gives:\n\n$$\n\\begin{aligned}\n2x + (-3)(-2) &= 10 \\\\\n2x &= 4 \\\\\nx &= 2\n\\end{aligned}\n$$\n\nThe system has *a single solution*, $(2,-2)$."} {:db/id #edb/ref 17592186529293 :knowledge-point/_questions [{:db/id #edb/ref 17592186073776 :knowledge-point/id #uuid "a24fb4f3-6e3c-5c45-b31e-85b7ce290eda" :knowledge-point/title "Finding the Number of Solutions to a System" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d893df7-d857-5192-90ce-47a99d5c6bf8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529274} {:answer/id #uuid "60bc4533-01cd-595e-9372-f185d24aa9f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529279} {:answer/id #uuid "6ce6a4fc-25b3-542c-aed5-70e5fdd4a918" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529283}] :answer-field/correct {:answer/id #uuid "4d893df7-d857-5192-90ce-47a99d5c6bf8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529274} :answer-field/id #uuid "7aa9bc9c-c996-5d30-bb22-558885c83ec4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186529289}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "878a99ca-9540-5195-b258-8e98913442f4" :question/problem "Consider the following system of equations:\n\n$\\{2x - y = -2; 8x - 4y = -8$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nNotice that if we multiply the first equation by $-4$, then we will get a $-8x$ term that can cancel with the $8x$ term in the second equation:\n\n$$\n\\{2x - y = -2 \\mid \\mid \\cdot (-4); 8x - 4y = -8\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n-8x + 4y &= 8 \\\\\n8x - 4y &= -8 \\\\\n0 &= (8 - 8) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nThe statement $0=0$ is *always true*. Therefore, we conclude that the system has *infinitely many solutions*."} {:db/id #edb/ref 17592186529294 :knowledge-point/_questions [{:db/id #edb/ref 17592186073776 :knowledge-point/id #uuid "a24fb4f3-6e3c-5c45-b31e-85b7ce290eda" :knowledge-point/title "Finding the Number of Solutions to a System" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aedf24db-2200-5c34-82c8-69e05734e790" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529313} {:answer/id #uuid "d688773d-636f-5a54-b4ee-355c9f396330" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529321} {:answer/id #uuid "f2dee143-55db-5cf5-83a5-24cd943aae58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529329}] :answer-field/correct {:answer/id #uuid "f2dee143-55db-5cf5-83a5-24cd943aae58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529329} :answer-field/id #uuid "f5171cd4-7721-5fe2-926b-265c33c00b33" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186529330}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "88e09a62-e93a-583d-86c5-5caff22bdcbd" :question/problem "Consider the following system of equations:\n\n$\\{3x + y = 0; -3x + 5y = -2$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nNotice that if we multiply the first equation by $1$, then we will get a $3x$ term that can cancel with the $-3x$ term in the second equation:\n\n$$\n\\{3x + y = 0 \\mid \\mid \\cdot (1); -3x + 5y = -2\n$$\n\nWhen we add the two equations, the $x$ terms cancel, and we can solve for $y$:\n\n$$\n\\begin{aligned}\n3x + y &= 0 \\\\\n-3x + 5y &= -2 \\\\\n6y &= (0 - 2) \\\\\n6y &= -2 \\\\\ny &= - \\frac{1}{3}\n\\end{aligned}\n$$\n\nSubstituting into the first equation gives:\n\n$$\n\\begin{aligned}\n3x + (1)(- \\frac{1}{3}) &= 0 \\\\\n3x &= \\frac{1}{3} \\\\\nx &= \\frac{1}{9}\n\\end{aligned}\n$$\n\nThe system has *a single solution*, $(\\frac{1}{9},- \\frac{1}{3})$."} {:db/id #edb/ref 17592186529306 :knowledge-point/_questions [{:db/id #edb/ref 17592186073776 :knowledge-point/id #uuid "a24fb4f3-6e3c-5c45-b31e-85b7ce290eda" :knowledge-point/title "Finding the Number of Solutions to a System" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26412d41-7859-567a-8d0b-616fdfaae78b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529264} {:answer/id #uuid "7ebeb28b-d7e8-58ed-a1ac-c3da8dc6de13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529291} {:answer/id #uuid "ede703e4-312f-541c-9af9-a20919d7afce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529328}] :answer-field/correct {:answer/id #uuid "7ebeb28b-d7e8-58ed-a1ac-c3da8dc6de13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529291} :answer-field/id #uuid "43939bab-211c-5b1e-9dcd-127b5f8c732a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186529270}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a7d7084c-4c14-5312-a22d-dc6fe1986a2c" :question/problem "Consider the following system of equations:\n\n$\\{-3x - y = 8; 3x + y = -6$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nNotice that if we multiply the first equation by $1$, then we will get a $-3x$ term that can cancel with the $3x$ term in the second equation:\n\n$$\n\\{-3x - y = 8 \\mid \\mid \\cdot (1); 3x + y = -6\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a false statement:\n\n$$\n\\begin{aligned}\n-3x - y &= 8 \\\\\n3x + y &= -6 \\\\\n0 &= (8 - 6) \\\\\n0 &= 2\n\\end{aligned}\n$$\n\nThe statement $0=2$ is *always false*. Therefore, we conclude that the system has *no solutions*."} {:db/id #edb/ref 17592186529307 :knowledge-point/_questions [{:db/id #edb/ref 17592186073776 :knowledge-point/id #uuid "a24fb4f3-6e3c-5c45-b31e-85b7ce290eda" :knowledge-point/title "Finding the Number of Solutions to a System" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d5289c2-ae65-5854-8e71-5b033554cd5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529258} {:answer/id #uuid "81a01f27-1606-571b-a96b-5a5040320fbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529292} {:answer/id #uuid "9d492ab7-1bb8-5fc1-8c03-1d65e9d953d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529301}] :answer-field/correct {:answer/id #uuid "9d492ab7-1bb8-5fc1-8c03-1d65e9d953d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529301} :answer-field/id #uuid "a2ae9c90-b5af-556d-b9c0-2e84879f0db0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186529303}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a81cacd7-ddb8-5f18-91b0-0d7142c96649" :question/problem "Consider the following system of equations:\n\n$\\{y - 3x - 4 = 0; -2y + 12x + 10 = 0$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nFirst, rearrange each equation to put the variable terms on the left and the constant on the right:\n\n$$\n\\begin{aligned}\n-3x + y &= 4 \\\\\n12x - 2y &= -10\n\\end{aligned}\n$$\n\nNotice that if we multiply the first equation by $4$, then we will get a $-12x$ term that can cancel with the $12x$ term in the second equation:\n\n$$\n\\{-3x + y = 4 \\mid \\mid \\cdot (4); 12x - 2y = -10\n$$\n\nWhen we add the two equations, the $x$ terms cancel, and we can solve for $y$:\n\n$$\n\\begin{aligned}\n-12x + 4y &= 16 \\\\\n12x - 2y &= -10 \\\\\n2y &= (16 - 10) \\\\\n2y &= 6 \\\\\ny &= 3\n\\end{aligned}\n$$\n\nSubstituting into the first equation gives:\n\n$$\n\\begin{aligned}\n-3x + (1)(3) &= 4 \\\\\n-3x &= 1 \\\\\nx &= - \\frac{1}{3}\n\\end{aligned}\n$$\n\nThe system has *a single solution*, $(- \\frac{1}{3},3)$."} {:db/id #edb/ref 17592186529309 :knowledge-point/_questions [{:db/id #edb/ref 17592186073776 :knowledge-point/id #uuid "a24fb4f3-6e3c-5c45-b31e-85b7ce290eda" :knowledge-point/title "Finding the Number of Solutions to a System" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02e4adab-f965-574b-b1b2-5412f0ac4030" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529257} {:answer/id #uuid "174a23c4-66b4-574b-ab16-58c635103256" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529260} {:answer/id #uuid "dbf0dc60-cd74-50bb-bbf6-488567b34736" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529323}] :answer-field/correct {:answer/id #uuid "174a23c4-66b4-574b-ab16-58c635103256" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529260} :answer-field/id #uuid "da21e2ad-53b7-539d-8fc6-d73ab8480a65" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186529322}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a93a39cc-73b6-5e4b-80a4-1282a4d64974" :question/problem "Consider the following system of equations:\n\n$\\{y + 3x + 6 = 0; -4y - 12x - 26 = 0$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nFirst, rearrange each equation to put the variable terms on the left and the constant on the right:\n\n$$\n\\begin{aligned}\n3x + y &= -6 \\\\\n-12x - 4y &= 26\n\\end{aligned}\n$$\n\nNotice that if we multiply the first equation by $4$, then we will get a $12x$ term that can cancel with the $-12x$ term in the second equation:\n\n$$\n\\{3x + y = -6 \\mid \\mid \\cdot (4); -12x - 4y = 26\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a false statement:\n\n$$\n\\begin{aligned}\n12x + 4y &= -24 \\\\\n-12x - 4y &= 26 \\\\\n0 &= (-24 + 26) \\\\\n0 &= 2\n\\end{aligned}\n$$\n\nThe statement $0=2$ is *always false*. Therefore, we conclude that the system has *no solutions*."} {:db/id #edb/ref 17592186529316 :knowledge-point/_questions [{:db/id #edb/ref 17592186073776 :knowledge-point/id #uuid "a24fb4f3-6e3c-5c45-b31e-85b7ce290eda" :knowledge-point/title "Finding the Number of Solutions to a System" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72bba841-9529-5598-b921-f90b8dffbe5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529286} {:answer/id #uuid "b27078db-ea72-5bd8-9115-2ea5343e2f7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529315} {:answer/id #uuid "f96540d7-0eb1-5d77-a5ce-3fa81473a266" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529331}] :answer-field/correct {:answer/id #uuid "b27078db-ea72-5bd8-9115-2ea5343e2f7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529315} :answer-field/id #uuid "6c1fbec3-c232-5078-a580-2f08b5aa37e3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186529282}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c0b2af50-0676-5686-aa21-aed280aaa725" :question/problem "Consider the following system of equations:\n\n$\\{-x - 5y = -12; x - 3y = -2$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nNotice that if we multiply the first equation by $1$, then we will get a $-x$ term that can cancel with the $x$ term in the second equation:\n\n$$\n\\{-x - 5y = -12 \\mid \\mid \\cdot (1); x - 3y = -2\n$$\n\nWhen we add the two equations, the $x$ terms cancel, and we can solve for $y$:\n\n$$\n\\begin{aligned}\n-x - 5y &= -12 \\\\\nx - 3y &= -2 \\\\\n-8y &= (-12 - 2) \\\\\n-8y &= -14 \\\\\ny &= \\frac{7}{4}\n\\end{aligned}\n$$\n\nSubstituting into the first equation gives:\n\n$$\n\\begin{aligned}\n-x + (-5)(\\frac{7}{4}) &= -12 \\\\\n-x &= - \\frac{13}{4} \\\\\nx &= \\frac{13}{4}\n\\end{aligned}\n$$\n\nThe system has *a single solution*, $(\\frac{13}{4},\\frac{7}{4})$."} {:db/id #edb/ref 17592186529318 :knowledge-point/_questions [{:db/id #edb/ref 17592186073776 :knowledge-point/id #uuid "a24fb4f3-6e3c-5c45-b31e-85b7ce290eda" :knowledge-point/title "Finding the Number of Solutions to a System" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f5d6e30-8e43-5909-9e9a-3a9af82fd1e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529297} {:answer/id #uuid "9c1af611-f1dc-57a7-b4ff-1cd30b5d58d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529300} {:answer/id #uuid "a979b510-0d7a-5573-bce5-5f77d85dffa4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529310}] :answer-field/correct {:answer/id #uuid "8f5d6e30-8e43-5909-9e9a-3a9af82fd1e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529297} :answer-field/id #uuid "8eaf5b55-2fa9-5c35-a346-66798bb8f61b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186529296}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c5970b8b-793c-585b-9c66-c8937f9714fc" :question/problem "Consider the following system of equations:\n\n$\\{x - 3y = -6; 4x - y = -12$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nNotice that if we multiply the first equation by $-4$, then we will get a $-4x$ term that can cancel with the $4x$ term in the second equation:\n\n$$\n\\{x - 3y = -6 \\mid \\mid \\cdot (-4); 4x - y = -12\n$$\n\nWhen we add the two equations, the $x$ terms cancel, and we can solve for $y$:\n\n$$\n\\begin{aligned}\n-4x + 12y &= 24 \\\\\n4x - y &= -12 \\\\\n11y &= (24 - 12) \\\\\n11y &= 12 \\\\\ny &= \\frac{12}{11}\n\\end{aligned}\n$$\n\nSubstituting into the first equation gives:\n\n$$\n\\begin{aligned}\nx + (-3)(\\frac{12}{11}) &= -6 \\\\\nx &= - \\frac{30}{11} \\\\\nx &= - \\frac{30}{11}\n\\end{aligned}\n$$\n\nThe system has *a single solution*, $(- \\frac{30}{11},\\frac{12}{11})$."} {:db/id #edb/ref 17592186529320 :knowledge-point/_questions [{:db/id #edb/ref 17592186073776 :knowledge-point/id #uuid "a24fb4f3-6e3c-5c45-b31e-85b7ce290eda" :knowledge-point/title "Finding the Number of Solutions to a System" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fb0b299-f16e-54c2-a393-40d6eef9a51c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529276} {:answer/id #uuid "97b495fd-486c-5329-aea6-b7fef9362dc9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529299} {:answer/id #uuid "a66f4ab0-02ae-5f53-884d-c689e9f292e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529305}] :answer-field/correct {:answer/id #uuid "a66f4ab0-02ae-5f53-884d-c689e9f292e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529305} :answer-field/id #uuid "766ff9b6-bfc6-59ad-af1f-7918abd24f91" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186529287}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d4bc3484-819e-515d-b935-6bb887858fab" :question/problem "Consider the following system of equations:\n\n$\\{2x - y = 4; 2x - y = 4$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nNotice that if we multiply the first equation by $-1$, then we will get a $-2x$ term that can cancel with the $2x$ term in the second equation:\n\n$$\n\\{2x - y = 4 \\mid \\mid \\cdot (-1); 2x - y = 4\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n-2x + y &= -4 \\\\\n2x - y &= 4 \\\\\n0 &= (-4 + 4) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nThe statement $0=0$ is *always true*. Therefore, we conclude that the system has *infinitely many solutions*."} {:db/id #edb/ref 17592186542434 :knowledge-point/_questions [{:db/id #edb/ref 17592186073778 :knowledge-point/id #uuid "50351666-c691-510f-863c-168c61f9980b" :knowledge-point/title "Finding the General Solution to a System With Infinitely Many Intersection Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "296b4bc1-fdc9-57c7-8838-c40039d81743" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -4u + 8)" :db/id #edb/ref 17592186542454} {:answer/id #uuid "511c3e07-7b86-5d35-b593-e086d056c9e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -\\frac{1}{4}u + 2)" :db/id #edb/ref 17592186542467} {:answer/id #uuid "72f94d33-8b49-509e-9f3b-feef2915a2d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, 8)" :db/id #edb/ref 17592186542474} {:answer/id #uuid "993d12f6-8426-5581-93dc-e143dd73cada" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, 4u + 8)" :db/id #edb/ref 17592186542483} {:answer/id #uuid "d647aaba-1ddd-551d-acf3-4af820d6199d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -4u - 8)" :db/id #edb/ref 17592186542497}] :answer-field/correct {:answer/id #uuid "296b4bc1-fdc9-57c7-8838-c40039d81743" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -4u + 8)" :db/id #edb/ref 17592186542454} :answer-field/id #uuid "a496eb60-5280-58e8-963e-50a6d3c4762a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542486}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "088c2bc7-791c-5d33-989e-2db1686f3a99" :question/problem "Find all points of intersection of the lines $4x + y = 8$ and $-8x - 2y =-16$." :question/worked-solution "The points of intersection of the lines correspond to the solutions of the following system:\n\n$$\n\\left\\{\\begin{aligned}4x + y &=8 \\\\ -8x - 2y &=-16\\end{aligned}\\right.\n$$\n\nWe will solve the system using elimination. Notice that if we multiply the first equation by $2$, then we will get a $8x$ term that can cancel with the $-8x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}4x + y &=8 && \\mid \\mid \\cdot (2) \\\\ -8x - 2y &=-16\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n8x + 2y &= 16 \\\\\n-8x - 2y &= -16 \\\\\n0 &= (16 - 16) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nBecause we obtained a true statement, we conclude that there are infinitely many solutions to the system. Therefore, the lines have infinitely many intersection points.\n\nWe want to find an expression that represents every solution to the system. Any value of $x$ can be chosen, and we can find the corresponding $y$-coordinate for each $x$-coordinate by solving one of the lines for $y$, as follows:\n\n$$\n\\begin{aligned}\n4x + y &= 8 \\\\\ny &= 8 - 4x \\\\\ny &= \\frac{8 - 4x}{1} \\\\\ny &= 8 - 4x\n\\end{aligned}\n$$\n\nLet $u=x$ be the free coordinate.\n\nTherefore, the points of intersection are\n\n$$\n\\left(u,8 - 4u \\right)\n$$\n\nwhere $u$ is any number."} {:db/id #edb/ref 17592186542435 :knowledge-point/_questions [{:db/id #edb/ref 17592186073778 :knowledge-point/id #uuid "50351666-c691-510f-863c-168c61f9980b" :knowledge-point/title "Finding the General Solution to a System With Infinitely Many Intersection Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76fe33fa-ce38-5b2f-ae1b-8a6fb1ff5121" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, \\frac{1}{4}u + \\frac{3}{4})" :db/id #edb/ref 17592186542475} {:answer/id #uuid "c99c9047-694a-52fb-90a1-920055039ded" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, \\frac{1}{4}u - \\frac{3}{4})" :db/id #edb/ref 17592186542494} {:answer/id #uuid "ca2b29a2-d8c3-5c8b-ab33-30360a9a3463" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -\\frac{1}{4}u - \\frac{3}{4})" :db/id #edb/ref 17592186542495} {:answer/id #uuid "e3aad1d2-6e42-5eec-9dca-2cec7a5ae0b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, 4u + 3)" :db/id #edb/ref 17592186542503} {:answer/id #uuid "ff7fd8bf-f7d2-584f-a1df-b2f38182412f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -\\frac{3}{4})" :db/id #edb/ref 17592186542511}] :answer-field/correct {:answer/id #uuid "c99c9047-694a-52fb-90a1-920055039ded" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, \\frac{1}{4}u - \\frac{3}{4})" :db/id #edb/ref 17592186542494} :answer-field/id #uuid "0bf547af-6a9e-5a7b-a100-571509ee17b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542436}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0b630dc7-b870-5e2b-85ac-37faee98683d" :question/problem "Find all points of intersection of the lines $x - 4y = 3$ and $-4x + 16y =-12$." :question/worked-solution "The points of intersection of the lines correspond to the solutions of the following system:\n\n$$\n\\left\\{\\begin{aligned}x - 4y &=3 \\\\ -4x + 16y &=-12\\end{aligned}\\right.\n$$\n\nWe will solve the system using elimination. Notice that if we multiply the first equation by $4$, then we will get a $4x$ term that can cancel with the $-4x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}x - 4y &=3 && \\mid \\mid \\cdot (4) \\\\ -4x + 16y &=-12\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n4x - 16y &= 12 \\\\\n-4x + 16y &= -12 \\\\\n0 &= (12 - 12) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nBecause we obtained a true statement, we conclude that there are infinitely many solutions to the system. Therefore, the lines have infinitely many intersection points.\n\nWe want to find an expression that represents every solution to the system. Any value of $x$ can be chosen, and we can find the corresponding $y$-coordinate for each $x$-coordinate by solving one of the lines for $y$, as follows:\n\n$$\n\\begin{aligned}\nx - 4y &= 3 \\\\\n-4y &= 3 - x \\\\\ny &= \\frac{3 - x}{-4} \\\\\ny &= -\\frac{3}{4} + \\frac{1}{4}x\n\\end{aligned}\n$$\n\nLet $u=x$ be the free coordinate.\n\nTherefore, the points of intersection are\n\n$$\n\\left(u,-\\frac{3}{4} + \\frac{1}{4}u \\right)\n$$\n\nwhere $u$ is any number."} {:db/id #edb/ref 17592186542442 :knowledge-point/_questions [{:db/id #edb/ref 17592186073778 :knowledge-point/id #uuid "50351666-c691-510f-863c-168c61f9980b" :knowledge-point/title "Finding the General Solution to a System With Infinitely Many Intersection Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a28e7ec-e71a-5f77-bd2b-aee856b5039c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(t, 2t + 10)" :db/id #edb/ref 17592186542444} {:answer/id #uuid "1bbc4b58-5af2-531c-9f2a-e95c4507960c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(t, \\frac{1}{2}t - 5)" :db/id #edb/ref 17592186542446} {:answer/id #uuid "2528686b-8db2-507f-9663-1012eeb1fbf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(t, -5)" :db/id #edb/ref 17592186542453} {:answer/id #uuid "6ae1c305-4510-5421-8776-69299ea2148b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(t, -\\frac{1}{2}t - 5)" :db/id #edb/ref 17592186542473} {:answer/id #uuid "ea2d669d-5e96-546b-9cbb-0faab3e8ff37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(t, \\frac{1}{2}t + 5)" :db/id #edb/ref 17592186542504}] :answer-field/correct {:answer/id #uuid "1bbc4b58-5af2-531c-9f2a-e95c4507960c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(t, \\frac{1}{2}t - 5)" :db/id #edb/ref 17592186542446} :answer-field/id #uuid "0f8a0b2e-30d5-55be-9faa-704ff5f10ec6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542440}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "111bc200-5458-59e4-8bff-0e4766f93526" :question/problem "Find all points of intersection of the lines $x - 2y = 10$ and $3x - 6y = 30$." :question/worked-solution "The points of intersection of the lines correspond to the solutions of the following system:\n\n$$\n\\left\\{\\begin{aligned}x - 2y &=10 \\\\ 3x - 6y &=30\\end{aligned}\\right.\n$$\n\nWe will solve the system using elimination. Notice that if we multiply the first equation by $-3$, then we will get a $-3x$ term that can cancel with the $3x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}x - 2y &=10 && \\mid \\mid \\cdot (-3) \\\\ 3x - 6y &=30\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n-3x + 6y &= -30 \\\\\n3x - 6y &= 30 \\\\\n0 &= (-30 + 30) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nBecause we obtained a true statement, we conclude that there are infinitely many solutions to the system. Therefore, the lines have infinitely many intersection points.\n\nWe want to find an expression that represents every solution to the system. Any value of $x$ can be chosen, and we can find the corresponding $y$-coordinate for each $x$-coordinate by solving one of the lines for $y$, as follows:\n\n$$\n\\begin{aligned}\nx - 2y &= 10 \\\\\n-2y &= 10 - x \\\\\ny &= \\frac{10 - x}{-2} \\\\\ny &= -5 + \\frac{1}{2}x\n\\end{aligned}\n$$\n\nLet $t=x$ be the free coordinate.\n\nTherefore, the points of intersection are\n\n$$\n\\left(t,-5 + \\frac{1}{2}t \\right)\n$$\n\nwhere $t$ is any number."} {:db/id #edb/ref 17592186542448 :knowledge-point/_questions [{:db/id #edb/ref 17592186073778 :knowledge-point/id #uuid "50351666-c691-510f-863c-168c61f9980b" :knowledge-point/title "Finding the General Solution to a System With Infinitely Many Intersection Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "216e4d60-197f-5cc4-a6a9-1f0aa4798fd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -1)" :db/id #edb/ref 17592186542451} {:answer/id #uuid "677f2479-49ce-5f74-a164-ff8f5c291ff1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -2u - 1)" :db/id #edb/ref 17592186542472} {:answer/id #uuid "925e9f49-23ce-555d-bfa2-ceaec62717c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, 2u + 1)" :db/id #edb/ref 17592186542481} {:answer/id #uuid "b93fa3dc-f26f-535d-b424-a60e27978200" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, 2u - 1)" :db/id #edb/ref 17592186542490} {:answer/id #uuid "f9ce12fe-1da9-5977-a390-7992e5b701d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, \\frac{1}{2}u + \\frac{1}{2})" :db/id #edb/ref 17592186542508}] :answer-field/correct {:answer/id #uuid "b93fa3dc-f26f-535d-b424-a60e27978200" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, 2u - 1)" :db/id #edb/ref 17592186542490} :answer-field/id #uuid "db9b9d32-7ef3-5e9b-8814-93028e12c1b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542499}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1dff70b5-3044-54d1-b535-83ffa052215f" :question/problem "Find all points of intersection of the lines $2x - y = 1$ and $-4x + 2y =-2$." :question/worked-solution "The points of intersection of the lines correspond to the solutions of the following system:\n\n$$\n\\left\\{\\begin{aligned}2x - y &=1 \\\\ -4x + 2y &=-2\\end{aligned}\\right.\n$$\n\nWe will solve the system using elimination. Notice that if we multiply the first equation by $2$, then we will get a $4x$ term that can cancel with the $-4x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}2x - y &=1 && \\mid \\mid \\cdot (2) \\\\ -4x + 2y &=-2\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n4x - 2y &= 2 \\\\\n-4x + 2y &= -2 \\\\\n0 &= (2 - 2) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nBecause we obtained a true statement, we conclude that there are infinitely many solutions to the system. Therefore, the lines have infinitely many intersection points.\n\nWe want to find an expression that represents every solution to the system. Any value of $x$ can be chosen, and we can find the corresponding $y$-coordinate for each $x$-coordinate by solving one of the lines for $y$, as follows:\n\n$$\n\\begin{aligned}\n2x - y &= 1 \\\\\n-y &= 1 - 2x \\\\\ny &= \\frac{1 - 2x}{-1} \\\\\ny &= -1 + 2x\n\\end{aligned}\n$$\n\nLet $u=x$ be the free coordinate.\n\nTherefore, the points of intersection are\n\n$$\n\\left(u,-1 + 2u \\right)\n$$\n\nwhere $u$ is any number."} {:db/id #edb/ref 17592186542452 :knowledge-point/_questions [{:db/id #edb/ref 17592186073778 :knowledge-point/id #uuid "50351666-c691-510f-863c-168c61f9980b" :knowledge-point/title "Finding the General Solution to a System With Infinitely Many Intersection Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "329c8c6c-64c9-53b9-abcb-a88c8eeeb32e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2t + 6" :db/id #edb/ref 17592186542458}] :answer-field/correct {:answer/id #uuid "329c8c6c-64c9-53b9-abcb-a88c8eeeb32e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2t + 6" :db/id #edb/ref 17592186542458} :answer-field/id #uuid "d774ba4e-5e04-5b25-ac80-8bb3704ee4df" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186542498}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "23da70bf-d870-5a7b-895c-27d6ebda3437" :question/problem "Describe the points that lie on the intersection of the lines $2x - y =-6$ and $6x - 3y =-18$. Express your answer in terms of $t$ only.\n\nThe intersection points are $(t$,\n{{field-1}}\n$)$, where $t$ is any number." :question/worked-solution "The points of intersection of the lines correspond to the solutions of the following system:\n\n$$\n\\left\\{\\begin{aligned}2x - y &=-6 \\\\ 6x - 3y &=-18\\end{aligned}\\right.\n$$\n\nWe will solve the system using elimination. Notice that if we multiply the first equation by $-3$, then we will get a $-6x$ term that can cancel with the $6x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}2x - y &=-6 && \\mid \\mid \\cdot (-3) \\\\ 6x - 3y &=-18\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n-6x + 3y &= 18 \\\\\n6x - 3y &= -18 \\\\\n0 &= (18 - 18) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nBecause we obtained a true statement, we conclude that there are infinitely many solutions to the system. Therefore, the lines have infinitely many intersection points.\n\nWe want to find an expression that represents every solution to the system. Any value of $x$ can be chosen, and we can find the corresponding $y$-coordinate for each $x$-coordinate by solving one of the lines for $y$, as follows:\n\n$$\n\\begin{aligned}\n2x - y &= -6 \\\\\n-y &= -6 - 2x \\\\\ny &= \\frac{-6 - 2x}{-1} \\\\\ny &= 6 + 2x\n\\end{aligned}\n$$\n\nLet $t=x$ be the free coordinate.\n\nTherefore, the points of intersection are\n\n$$\n\\left(t,6 + 2t \\right)\n$$\n\nwhere $t$ is any number."} {:db/id #edb/ref 17592186542462 :knowledge-point/_questions [{:db/id #edb/ref 17592186073778 :knowledge-point/id #uuid "50351666-c691-510f-863c-168c61f9980b" :knowledge-point/title "Finding the General Solution to a System With Infinitely Many Intersection Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b794602-b4c5-54ab-8bfc-db1e61594521" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x + \\frac{11}{2}" :db/id #edb/ref 17592186542479}] :answer-field/correct {:answer/id #uuid "8b794602-b4c5-54ab-8bfc-db1e61594521" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x + \\frac{11}{2}" :db/id #edb/ref 17592186542479} :answer-field/id #uuid "337c5621-421b-56d4-95de-5c351f0f1ad9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186542460}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3e38b0b3-85f1-537d-9bdc-738a5616e813" :question/problem "Describe the points that lie on the intersection of the lines $4x - 2y =-11$ and $8x - 4y =-22$. Express your answer in terms of $x$ only.\n\nThe intersection points are $(x$,\n{{field-1}}\n$)$, where $x$ is any number." :question/worked-solution "The points of intersection of the lines correspond to the solutions of the following system:\n\n$$\n\\left\\{\\begin{aligned}4x - 2y &=-11 \\\\ 8x - 4y &=-22\\end{aligned}\\right.\n$$\n\nWe will solve the system using elimination. Notice that if we multiply the first equation by $-2$, then we will get a $-8x$ term that can cancel with the $8x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}4x - 2y &=-11 && \\mid \\mid \\cdot (-2) \\\\ 8x - 4y &=-22\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n-8x + 4y &= 22 \\\\\n8x - 4y &= -22 \\\\\n0 &= (22 - 22) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nBecause we obtained a true statement, we conclude that there are infinitely many solutions to the system. Therefore, the lines have infinitely many intersection points.\n\nWe want to find an expression that represents every solution to the system. Any value of $x$ can be chosen, and we can find the corresponding $y$-coordinate for each $x$-coordinate by solving one of the lines for $y$, as follows:\n\n$$\n\\begin{aligned}\n4x - 2y &= -11 \\\\\n-2y &= -11 - 4x \\\\\ny &= \\frac{-11 - 4x}{-2} \\\\\ny &= \\frac{11}{2} + 2x\n\\end{aligned}\n$$\n\nTherefore, the points of intersection are\n\n$$\n\\left(x,\\frac{11}{2} + 2x \\right)\n$$\n\nwhere $x$ is any number."} {:db/id #edb/ref 17592186542465 :knowledge-point/_questions [{:db/id #edb/ref 17592186073778 :knowledge-point/id #uuid "50351666-c691-510f-863c-168c61f9980b" :knowledge-point/title "Finding the General Solution to a System With Infinitely Many Intersection Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1265d20a-0e86-57c1-9549-b3dffb34e245" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{5}x - \\frac{6}{5}" :db/id #edb/ref 17592186542443}] :answer-field/correct {:answer/id #uuid "1265d20a-0e86-57c1-9549-b3dffb34e245" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{5}x - \\frac{6}{5}" :db/id #edb/ref 17592186542443} :answer-field/id #uuid "0eef6127-aaa5-5be2-ac0e-d2adcd5bbbc7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186542439}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "48520d96-a4e1-575b-9ec9-8c8c3ed1fafc" :question/problem "Describe the points that lie on the intersection of the lines $-12x + 5y =-6$ and $24x - 10y = 12$. Express your answer in terms of $x$ only.\n\nThe intersection points are $(x$,\n{{field-1}}\n$)$, where $x$ is any number." :question/worked-solution "The points of intersection of the lines correspond to the solutions of the following system:\n\n$$\n\\left\\{\\begin{aligned}-12x + 5y &=-6 \\\\ 24x - 10y &=12\\end{aligned}\\right.\n$$\n\nWe will solve the system using elimination. Notice that if we multiply the first equation by $2$, then we will get a $-24x$ term that can cancel with the $24x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}-12x + 5y &=-6 && \\mid \\mid \\cdot (2) \\\\ 24x - 10y &=12\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n-24x + 10y &= -12 \\\\\n24x - 10y &= 12 \\\\\n0 &= (-12 + 12) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nBecause we obtained a true statement, we conclude that there are infinitely many solutions to the system. Therefore, the lines have infinitely many intersection points.\n\nWe want to find an expression that represents every solution to the system. Any value of $x$ can be chosen, and we can find the corresponding $y$-coordinate for each $x$-coordinate by solving one of the lines for $y$, as follows:\n\n$$\n\\begin{aligned}\n-12x + 5y &= -6 \\\\\n5y &= -6 + 12x \\\\\ny &= \\frac{-6 + 12x}{5} \\\\\ny &= -\\frac{6}{5} + \\frac{12}{5}x\n\\end{aligned}\n$$\n\nTherefore, the points of intersection are\n\n$$\n\\left(x,-\\frac{6}{5} + \\frac{12}{5}x \\right)\n$$\n\nwhere $x$ is any number."} {:db/id #edb/ref 17592186542470 :knowledge-point/_questions [{:db/id #edb/ref 17592186073778 :knowledge-point/id #uuid "50351666-c691-510f-863c-168c61f9980b" :knowledge-point/title "Finding the General Solution to a System With Infinitely Many Intersection Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4830ac95-7dc9-5c52-9bdb-fa5c81554b07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -4u + 4)" :db/id #edb/ref 17592186542464} {:answer/id #uuid "59e2aa79-4c55-547b-90bf-a161e58917b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -\\frac{1}{4}u - 1)" :db/id #edb/ref 17592186542469} {:answer/id #uuid "ae8e8497-f8a2-5256-b0c3-49b354163e46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, \\frac{1}{4}u + 1)" :db/id #edb/ref 17592186542487} {:answer/id #uuid "c6c78b75-34eb-5180-b93a-45a32364f55c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -\\frac{1}{4}u + 1)" :db/id #edb/ref 17592186542493} {:answer/id #uuid "e238b8ec-01f6-516b-b4d3-05d0921577b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, 1)" :db/id #edb/ref 17592186542501}] :answer-field/correct {:answer/id #uuid "c6c78b75-34eb-5180-b93a-45a32364f55c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -\\frac{1}{4}u + 1)" :db/id #edb/ref 17592186542493} :answer-field/id #uuid "1ade77da-f05d-59b2-a201-6a199f319be8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542445}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5cb1d607-78ca-599f-a42f-6cb360fcbf56" :question/problem "Find all points of intersection of the lines $-x - 4y =-4$ and $2x + 8y = 8$." :question/worked-solution "The points of intersection of the lines correspond to the solutions of the following system:\n\n$$\n\\left\\{\\begin{aligned}-x - 4y &=-4 \\\\ 2x + 8y &=8\\end{aligned}\\right.\n$$\n\nWe will solve the system using elimination. Notice that if we multiply the first equation by $2$, then we will get a $-2x$ term that can cancel with the $2x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}-x - 4y &=-4 && \\mid \\mid \\cdot (2) \\\\ 2x + 8y &=8\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n-2x - 8y &= -8 \\\\\n2x + 8y &= 8 \\\\\n0 &= (-8 + 8) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nBecause we obtained a true statement, we conclude that there are infinitely many solutions to the system. Therefore, the lines have infinitely many intersection points.\n\nWe want to find an expression that represents every solution to the system. Any value of $x$ can be chosen, and we can find the corresponding $y$-coordinate for each $x$-coordinate by solving one of the lines for $y$, as follows:\n\n$$\n\\begin{aligned}\n-x - 4y &= -4 \\\\\n-4y &= -4 + x \\\\\ny &= \\frac{-4 + x}{-4} \\\\\ny &= 1 - \\frac{1}{4}x\n\\end{aligned}\n$$\n\nLet $u=x$ be the free coordinate.\n\nTherefore, the points of intersection are\n\n$$\n\\left(u,1 - \\frac{1}{4}u \\right)\n$$\n\nwhere $u$ is any number."} {:db/id #edb/ref 17592186542476 :knowledge-point/_questions [{:db/id #edb/ref 17592186073778 :knowledge-point/id #uuid "50351666-c691-510f-863c-168c61f9980b" :knowledge-point/title "Finding the General Solution to a System With Infinitely Many Intersection Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32ec9eaf-8a8c-5485-9397-f4080cccdb42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x, \\frac{2}{7}x - \\frac{6}{7})" :db/id #edb/ref 17592186542459} {:answer/id #uuid "3dc42961-0c2f-541f-bb32-0b326bb279c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x, \\frac{7}{2}x + 3)" :db/id #edb/ref 17592186542461} {:answer/id #uuid "9ab9055c-41fa-52d4-98cc-67b4d8dd46ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x, 3)" :db/id #edb/ref 17592186542484} {:answer/id #uuid "e29a0d02-5cca-5ff8-bf75-9db725841961" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x, \\frac{7}{2}x - 3)" :db/id #edb/ref 17592186542502} {:answer/id #uuid "f097021f-ff70-5357-a6ad-89cefc4a73f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x, -\\frac{7}{2}x + 3)" :db/id #edb/ref 17592186542506}] :answer-field/correct {:answer/id #uuid "3dc42961-0c2f-541f-bb32-0b326bb279c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x, \\frac{7}{2}x + 3)" :db/id #edb/ref 17592186542461} :answer-field/id #uuid "ffc4aaed-af07-5113-8443-30d9a263ac17" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542512}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7ab21255-f04c-59e1-a7a8-fd7625364758" :question/problem "Find all points of intersection of the lines $-7x + 2y = 6$ and $-21x + 6y = 18$." :question/worked-solution "The points of intersection of the lines correspond to the solutions of the following system:\n\n$$\n\\left\\{\\begin{aligned}-7x + 2y &=6 \\\\ -21x + 6y &=18\\end{aligned}\\right.\n$$\n\nWe will solve the system using elimination. Notice that if we multiply the first equation by $-3$, then we will get a $21x$ term that can cancel with the $-21x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}-7x + 2y &=6 && \\mid \\mid \\cdot (-3) \\\\ -21x + 6y &=18\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n21x - 6y &= -18 \\\\\n-21x + 6y &= 18 \\\\\n0 &= (-18 + 18) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nBecause we obtained a true statement, we conclude that there are infinitely many solutions to the system. Therefore, the lines have infinitely many intersection points.\n\nWe want to find an expression that represents every solution to the system. Any value of $x$ can be chosen, and we can find the corresponding $y$-coordinate for each $x$-coordinate by solving one of the lines for $y$, as follows:\n\n$$\n\\begin{aligned}\n-7x + 2y &= 6 \\\\\n2y &= 6 + 7x \\\\\ny &= \\frac{6 + 7x}{2} \\\\\ny &= 3 + \\frac{7}{2}x\n\\end{aligned}\n$$\n\nTherefore, the points of intersection are\n\n$$\n\\left(x,3 + \\frac{7}{2}x \\right)\n$$\n\nwhere $x$ is any number."} {:db/id #edb/ref 17592186542477 :knowledge-point/_questions [{:db/id #edb/ref 17592186073778 :knowledge-point/id #uuid "50351666-c691-510f-863c-168c61f9980b" :knowledge-point/title "Finding the General Solution to a System With Infinitely Many Intersection Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0473f996-4e92-58c5-bd48-4ace42741c79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{3}t + \\frac{10}{3}" :db/id #edb/ref 17592186542433}] :answer-field/correct {:answer/id #uuid "0473f996-4e92-58c5-bd48-4ace42741c79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{3}t + \\frac{10}{3}" :db/id #edb/ref 17592186542433} :answer-field/id #uuid "2e20b028-6414-53a2-a73b-b3e227d7d3fa" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186542456}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7cd05dfa-1d47-5a9e-9f5f-9a75d2347390" :question/problem "Describe the points that lie on the intersection of the lines $7x + 3y = 10$ and $21x + 9y = 30$. Express your answer in terms of $t$ only.\n\nThe intersection points are $(t$,\n{{field-1}}\n$)$, where $t$ is any number." :question/worked-solution "The points of intersection of the lines correspond to the solutions of the following system:\n\n$$\n\\left\\{\\begin{aligned}7x + 3y &=10 \\\\ 21x + 9y &=30\\end{aligned}\\right.\n$$\n\nWe will solve the system using elimination. Notice that if we multiply the first equation by $-3$, then we will get a $-21x$ term that can cancel with the $21x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}7x + 3y &=10 && \\mid \\mid \\cdot (-3) \\\\ 21x + 9y &=30\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n-21x - 9y &= -30 \\\\\n21x + 9y &= 30 \\\\\n0 &= (-30 + 30) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nBecause we obtained a true statement, we conclude that there are infinitely many solutions to the system. Therefore, the lines have infinitely many intersection points.\n\nWe want to find an expression that represents every solution to the system. Any value of $x$ can be chosen, and we can find the corresponding $y$-coordinate for each $x$-coordinate by solving one of the lines for $y$, as follows:\n\n$$\n\\begin{aligned}\n7x + 3y &= 10 \\\\\n3y &= 10 - 7x \\\\\ny &= \\frac{10 - 7x}{3} \\\\\ny &= \\frac{10}{3} - \\frac{7}{3}x\n\\end{aligned}\n$$\n\nLet $t=x$ be the free coordinate.\n\nTherefore, the points of intersection are\n\n$$\n\\left(t,\\frac{10}{3} - \\frac{7}{3}t \\right)\n$$\n\nwhere $t$ is any number."} {:db/id #edb/ref 17592186542491 :knowledge-point/_questions [{:db/id #edb/ref 17592186073778 :knowledge-point/id #uuid "50351666-c691-510f-863c-168c61f9980b" :knowledge-point/title "Finding the General Solution to a System With Infinitely Many Intersection Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fa567d4-0454-5e1f-a013-55cfb13bce47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, \\frac{8}{5}u - \\frac{9}{5})" :db/id #edb/ref 17592186542449} {:answer/id #uuid "5496138f-4940-59c9-8cfa-4bf807aed2e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -\\frac{9}{5})" :db/id #edb/ref 17592186542468} {:answer/id #uuid "65af1755-d621-5206-b9fe-ee7a32a7810b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, \\frac{5}{8}u + \\frac{9}{8})" :db/id #edb/ref 17592186542471} {:answer/id #uuid "b130be71-e990-5ee1-afcd-2de31bdb9cb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, \\frac{8}{5}u + \\frac{9}{5})" :db/id #edb/ref 17592186542488} {:answer/id #uuid "dfe07f49-e72f-5982-8433-a4f48f9fa695" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -\\frac{8}{5}u - \\frac{9}{5})" :db/id #edb/ref 17592186542500}] :answer-field/correct {:answer/id #uuid "1fa567d4-0454-5e1f-a013-55cfb13bce47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, \\frac{8}{5}u - \\frac{9}{5})" :db/id #edb/ref 17592186542449} :answer-field/id #uuid "a2f7f9e0-a02a-57ec-baf6-911d39f91d52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542485}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b9708e75-cf57-54fa-8a86-d6a41661f004" :question/problem "Find all points of intersection of the lines $-8x + 5y =-9$ and $16x - 10y = 18$." :question/worked-solution "The points of intersection of the lines correspond to the solutions of the following system:\n\n$$\n\\left\\{\\begin{aligned}-8x + 5y &=-9 \\\\ 16x - 10y &=18\\end{aligned}\\right.\n$$\n\nWe will solve the system using elimination. Notice that if we multiply the first equation by $2$, then we will get a $-16x$ term that can cancel with the $16x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}-8x + 5y &=-9 && \\mid \\mid \\cdot (2) \\\\ 16x - 10y &=18\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n-16x + 10y &= -18 \\\\\n16x - 10y &= 18 \\\\\n0 &= (-18 + 18) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nBecause we obtained a true statement, we conclude that there are infinitely many solutions to the system. Therefore, the lines have infinitely many intersection points.\n\nWe want to find an expression that represents every solution to the system. Any value of $x$ can be chosen, and we can find the corresponding $y$-coordinate for each $x$-coordinate by solving one of the lines for $y$, as follows:\n\n$$\n\\begin{aligned}\n-8x + 5y &= -9 \\\\\n5y &= -9 + 8x \\\\\ny &= \\frac{-9 + 8x}{5} \\\\\ny &= -\\frac{9}{5} + \\frac{8}{5}x\n\\end{aligned}\n$$\n\nLet $u=x$ be the free coordinate.\n\nTherefore, the points of intersection are\n\n$$\n\\left(u,-\\frac{9}{5} + \\frac{8}{5}u \\right)\n$$\n\nwhere $u$ is any number."} {:db/id #edb/ref 17592186542505 :knowledge-point/_questions [{:db/id #edb/ref 17592186073778 :knowledge-point/id #uuid "50351666-c691-510f-863c-168c61f9980b" :knowledge-point/title "Finding the General Solution to a System With Infinitely Many Intersection Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c60e70b-96f8-5431-90cd-a6ae562c2fa4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x, \\frac{1}{6}x + \\frac{2}{3})" :db/id #edb/ref 17592186542437} {:answer/id #uuid "0e35757a-2c57-5eb8-9b8e-33ffed7823b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x, 6x - 4)" :db/id #edb/ref 17592186542438} {:answer/id #uuid "1cef499e-0ec5-53e4-97d9-a3772813f69a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x, 6x + 4)" :db/id #edb/ref 17592186542447} {:answer/id #uuid "4320905f-2597-5dbe-b58d-bb716941c26e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x, -6x - 4)" :db/id #edb/ref 17592186542463} {:answer/id #uuid "49b76269-cc41-593b-a5e2-31e2fd0a943a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x, -4)" :db/id #edb/ref 17592186542466}] :answer-field/correct {:answer/id #uuid "0e35757a-2c57-5eb8-9b8e-33ffed7823b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x, 6x - 4)" :db/id #edb/ref 17592186542438} :answer-field/id #uuid "10860ce5-13d5-5537-a83d-c826703c2441" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542441}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ef3faa80-f6ae-5cf6-8c47-c5a225be4ccd" :question/problem "Find all points of intersection of the lines $6x - y = 4$ and $-24x + 4y =-16$." :question/worked-solution "The points of intersection of the lines correspond to the solutions of the following system:\n\n$$\n\\left\\{\\begin{aligned}6x - y &=4 \\\\ -24x + 4y &=-16\\end{aligned}\\right.\n$$\n\nWe will solve the system using elimination. Notice that if we multiply the first equation by $4$, then we will get a $24x$ term that can cancel with the $-24x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}6x - y &=4 && \\mid \\mid \\cdot (4) \\\\ -24x + 4y &=-16\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n24x - 4y &= 16 \\\\\n-24x + 4y &= -16 \\\\\n0 &= (16 - 16) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nBecause we obtained a true statement, we conclude that there are infinitely many solutions to the system. Therefore, the lines have infinitely many intersection points.\n\nWe want to find an expression that represents every solution to the system. Any value of $x$ can be chosen, and we can find the corresponding $y$-coordinate for each $x$-coordinate by solving one of the lines for $y$, as follows:\n\n$$\n\\begin{aligned}\n6x - y &= 4 \\\\\n-y &= 4 - 6x \\\\\ny &= \\frac{4 - 6x}{-1} \\\\\ny &= -4 + 6x\n\\end{aligned}\n$$\n\nTherefore, the points of intersection are\n\n$$\n\\left(x,-4 + 6x \\right)\n$$\n\nwhere $x$ is any number."} {:db/id #edb/ref 17592186542507 :knowledge-point/_questions [{:db/id #edb/ref 17592186073778 :knowledge-point/id #uuid "50351666-c691-510f-863c-168c61f9980b" :knowledge-point/title "Finding the General Solution to a System With Infinitely Many Intersection Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cac595a2-a76f-5528-90a3-5b43bb6b6c75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{2}t + 5" :db/id #edb/ref 17592186542496}] :answer-field/correct {:answer/id #uuid "cac595a2-a76f-5528-90a3-5b43bb6b6c75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{2}t + 5" :db/id #edb/ref 17592186542496} :answer-field/id #uuid "0052794e-29d0-5a14-847c-4f8656980f5a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186542432}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f2d5e6d3-70ba-56f0-872c-ec4406eeabb5" :question/problem "Describe the points that lie on the intersection of the lines $7x + 2y = 10$ and $21x + 6y = 30$. Express your answer in terms of $t$ only.\n\nThe intersection points are $(t$,\n{{field-1}}\n$)$, where $t$ is any number." :question/worked-solution "The points of intersection of the lines correspond to the solutions of the following system:\n\n$$\n\\left\\{\\begin{aligned}7x + 2y &=10 \\\\ 21x + 6y &=30\\end{aligned}\\right.\n$$\n\nWe will solve the system using elimination. Notice that if we multiply the first equation by $-3$, then we will get a $-21x$ term that can cancel with the $21x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}7x + 2y &=10 && \\mid \\mid \\cdot (-3) \\\\ 21x + 6y &=30\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n-21x - 6y &= -30 \\\\\n21x + 6y &= 30 \\\\\n0 &= (-30 + 30) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nBecause we obtained a true statement, we conclude that there are infinitely many solutions to the system. Therefore, the lines have infinitely many intersection points.\n\nWe want to find an expression that represents every solution to the system. Any value of $x$ can be chosen, and we can find the corresponding $y$-coordinate for each $x$-coordinate by solving one of the lines for $y$, as follows:\n\n$$\n\\begin{aligned}\n7x + 2y &= 10 \\\\\n2y &= 10 - 7x \\\\\ny &= \\frac{10 - 7x}{2} \\\\\ny &= 5 - \\frac{7}{2}x\n\\end{aligned}\n$$\n\nLet $t=x$ be the free coordinate.\n\nTherefore, the points of intersection are\n\n$$\n\\left(t,5 - \\frac{7}{2}t \\right)\n$$\n\nwhere $t$ is any number."} {:db/id #edb/ref 17592186542509 :knowledge-point/_questions [{:db/id #edb/ref 17592186073778 :knowledge-point/id #uuid "50351666-c691-510f-863c-168c61f9980b" :knowledge-point/title "Finding the General Solution to a System With Infinitely Many Intersection Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e93e99b-7e76-59cd-a8bf-9d5a1e879a40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3t + 4" :db/id #edb/ref 17592186542457}] :answer-field/correct {:answer/id #uuid "2e93e99b-7e76-59cd-a8bf-9d5a1e879a40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3t + 4" :db/id #edb/ref 17592186542457} :answer-field/id #uuid "8f52dab6-f84a-51c1-bb5e-7609d7d43d80" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186542480}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fd33d3a8-634b-5300-83fe-512c3febb665" :question/problem "Describe the points that lie on the intersection of the lines $-3x - y =-4$ and $12x + 4y = 16$. Express your answer in terms of $t$ only.\n\nThe intersection points are $(t$,\n{{field-1}}\n$)$, where $t$ is any number." :question/worked-solution "The points of intersection of the lines correspond to the solutions of the following system:\n\n$$\n\\left\\{\\begin{aligned}-3x - y &=-4 \\\\ 12x + 4y &=16\\end{aligned}\\right.\n$$\n\nWe will solve the system using elimination. Notice that if we multiply the first equation by $4$, then we will get a $-12x$ term that can cancel with the $12x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}-3x - y &=-4 && \\mid \\mid \\cdot (4) \\\\ 12x + 4y &=16\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n-12x - 4y &= -16 \\\\\n12x + 4y &= 16 \\\\\n0 &= (-16 + 16) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nBecause we obtained a true statement, we conclude that there are infinitely many solutions to the system. Therefore, the lines have infinitely many intersection points.\n\nWe want to find an expression that represents every solution to the system. Any value of $x$ can be chosen, and we can find the corresponding $y$-coordinate for each $x$-coordinate by solving one of the lines for $y$, as follows:\n\n$$\n\\begin{aligned}\n-3x - y &= -4 \\\\\n-y &= -4 + 3x \\\\\ny &= \\frac{-4 + 3x}{-1} \\\\\ny &= 4 - 3x\n\\end{aligned}\n$$\n\nLet $t=x$ be the free coordinate.\n\nTherefore, the points of intersection are\n\n$$\n\\left(t,4 - 3t \\right)\n$$\n\nwhere $t$ is any number."} {:db/id #edb/ref 17592186542510 :knowledge-point/_questions [{:db/id #edb/ref 17592186073778 :knowledge-point/id #uuid "50351666-c691-510f-863c-168c61f9980b" :knowledge-point/title "Finding the General Solution to a System With Infinitely Many Intersection Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186050240 :topic/title "Systems of Equations With No Solutions and Infinitely Many Solutions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20d56e4e-14df-5e76-8811-2258751260f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -\\frac{7}{5}u - \\frac{4}{5})" :db/id #edb/ref 17592186542450} {:answer/id #uuid "2b767e80-1eaf-555b-9465-6842cf1181fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -\\frac{7}{5}u + \\frac{4}{5})" :db/id #edb/ref 17592186542455} {:answer/id #uuid "7fdd62e8-0db4-5e13-9558-c017d95ac564" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, \\frac{4}{5})" :db/id #edb/ref 17592186542478} {:answer/id #uuid "b6ea97ea-40ff-582c-b6e3-88f89d97fe8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, \\frac{7}{5}u + \\frac{4}{5})" :db/id #edb/ref 17592186542489} {:answer/id #uuid "c600e11f-1d2c-53ce-a422-159dac0d2e97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -\\frac{5}{7}u + \\frac{4}{7})" :db/id #edb/ref 17592186542492}] :answer-field/correct {:answer/id #uuid "2b767e80-1eaf-555b-9465-6842cf1181fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u, -\\frac{7}{5}u + \\frac{4}{5})" :db/id #edb/ref 17592186542455} :answer-field/id #uuid "986fd8e2-7152-5f37-bea8-d024be1e25a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542482}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fec9f06c-a4db-563f-96a3-164f1364ae78" :question/problem "Find all points of intersection of the lines $7x + 5y = 4$ and $-14x - 10y =-8$." :question/worked-solution "The points of intersection of the lines correspond to the solutions of the following system:\n\n$$\n\\left\\{\\begin{aligned}7x + 5y &=4 \\\\ -14x - 10y &=-8\\end{aligned}\\right.\n$$\n\nWe will solve the system using elimination. Notice that if we multiply the first equation by $2$, then we will get a $14x$ term that can cancel with the $-14x$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}7x + 5y &=4 && \\mid \\mid \\cdot (2) \\\\ -14x - 10y &=-8\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n14x + 10y &= 8 \\\\\n-14x - 10y &= -8 \\\\\n0 &= (8 - 8) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nBecause we obtained a true statement, we conclude that there are infinitely many solutions to the system. Therefore, the lines have infinitely many intersection points.\n\nWe want to find an expression that represents every solution to the system. Any value of $x$ can be chosen, and we can find the corresponding $y$-coordinate for each $x$-coordinate by solving one of the lines for $y$, as follows:\n\n$$\n\\begin{aligned}\n7x + 5y &= 4 \\\\\n5y &= 4 - 7x \\\\\ny &= \\frac{4 - 7x}{5} \\\\\ny &= \\frac{4}{5} - \\frac{7}{5}x\n\\end{aligned}\n$$\n\nLet $u=x$ be the free coordinate.\n\nTherefore, the points of intersection are\n\n$$\n\\left(u,\\frac{4}{5} - \\frac{7}{5}u \\right)\n$$\n\nwhere $u$ is any number."}]
