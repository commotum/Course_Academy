              ":answer/value": "false"
            },
            {
              ":answer/id": "dfb5f084-6166-59fd-9d9a-37bf182794ac",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "944a05cb-3594-5076-85af-180645648063"
          ]
        },
        {
          ":answer-field/id": "c8a82409-aba7-5483-af9e-92ee6c104125",
          ":answer-field/key": "II",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "4da8c150-6d34-54dd-a52a-1163ffc3402a",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "f5b2623b-cb4e-5c21-9f4d-908cdb87dee8",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
            }
          ],
          ":answer-field/correct": [
