        },
        {
          ":answer-field/id": "c7091ca7-0640-5d00-a785-1b8e9ca327ff",
          ":answer-field/key": "III",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "a55c173a-83d8-56a5-8a87-fe6af538ab7b",
