            },
            {
              ":answer/id": "6685fe83-70bc-5633-97d0-535b16be6a9c",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "266b3c05-ed21-5991-aca5-44895f2a9183"
          ]
        },
        {
          ":answer-field/id": "2b183a40-cc75-5f46-a1ea-556c9e34fe22",
          ":answer-field/key": "II",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "c632cf1d-6964-5221-add9-d6624beefc28",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "97eb95fb-f3f7-5e04-b151-e99f6a3a3483",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
            }
          ],
          ":answer-field/correct": [
