    "question": {
      ":question/id": "d9a36ccf-34b0-5fbd-bfcc-974e5dc7bcea",
      ":question/problem": "Which of the following statements are true regarding the function $y=\\operatorname{csc}⁡x?$\n\nSelect all that apply.\n\n- **I.** The domain of the function is all positive real numbers.\n- **II.** $x=\\frac{7\\pi }{2}$ is a vertical asymptote of the function.\n- **III.** $\\operatorname{csc}⁡(x+4\\pi )=\\operatorname{csc}⁡(x-4\\pi ).$",
      ":question/answer-fields": [
        {
          ":answer-field/id": "738cbe5e-1471-53a7-b4b6-0deb1dc600b7",
          ":answer-field/key": "I",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "a60fec4c-6574-596c-8cea-f5bd4e4d3d46",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "610d1059-385b-5d7f-bb8b-d58654177fdc",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "a60fec4c-6574-596c-8cea-f5bd4e4d3d46"
          ]
        },
        {
          ":answer-field/id": "01901ab2-f980-5578-a1f8-ecdc4dc82180",
          ":answer-field/key": "II",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "2ad4a871-f2e4-533d-8c42-ad235478e85f",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "dec48525-0d49-5344-9a2c-aab7c7566529",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "2ad4a871-f2e4-533d-8c42-ad235478e85f"
          ]
        },
        {
          ":answer-field/id": "041760a8-fff5-58a5-a138-0d86cf79a968",
          ":answer-field/key": "III",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "e89d74ac-065e-555f-a7f6-b794c557fedc",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "298a6f93-bf52-5dbb-83f6-9465ee7d2522",
