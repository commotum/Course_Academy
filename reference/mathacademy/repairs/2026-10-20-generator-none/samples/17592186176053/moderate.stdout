          ]
        },
        {
          ":answer-field/id": "791fd97a-4ff6-5bd6-a957-c65380238b06",
          ":answer-field/key": "None of the above",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "9df58a48-171d-560f-870d-4af4199f3d5f",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "ee0d2c14-bbe2-5b95-be84-693baa3dac37",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
