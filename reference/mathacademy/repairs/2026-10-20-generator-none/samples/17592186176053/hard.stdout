        {
          ":answer-field/id": "f3314789-6bbb-5795-8735-6c6f93d6a99c",
          ":answer-field/key": "None of the above",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "6cd05b81-a887-5614-9937-2920fc7d3f59",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "a40324cb-7492-51ab-ad42-0943d8f24b2c",
