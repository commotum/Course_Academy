          ]
        },
        {
          ":answer-field/id": "53b8a7e8-7b3e-5c57-b063-c73f0853ef36",
          ":answer-field/key": "III",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "49863bbf-8cc1-5295-8fb6-1c2c008ea22d",
