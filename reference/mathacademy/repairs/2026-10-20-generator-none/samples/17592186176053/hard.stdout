        {
          ":answer-field/id": "e21d6d3e-3b3b-538b-b91e-4ce8f6a94dd8",
          ":answer-field/key": "III",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "a402232e-819a-5629-923e-5063172ab471",
