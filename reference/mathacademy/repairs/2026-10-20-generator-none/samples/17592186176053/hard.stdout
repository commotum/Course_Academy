          ]
        },
        {
          ":answer-field/id": "240da9af-9002-5443-9ae6-db64f9b58922",
          ":answer-field/key": "II",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "5a26457e-f1bc-57d1-a58c-262b08dfa8af",
