          ]
        },
        {
          ":answer-field/id": "36ae1ca7-ace2-50d1-b5da-32255de0efff",
          ":answer-field/key": "III",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "a754236c-006f-50c1-96af-d21244e42612",
