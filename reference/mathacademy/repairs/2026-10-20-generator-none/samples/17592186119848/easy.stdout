              ":answer/value": "$B$ and $C$ only"
            },
            {
              ":answer/id": "cfd30646-9b1f-5dbb-881e-152454d3ad37",
              ":answer/type": ":answer.type/text",
              ":answer/value": "$A$ and $C$ only"
            },
            {
