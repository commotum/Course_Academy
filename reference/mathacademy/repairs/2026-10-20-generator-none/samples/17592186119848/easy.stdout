              ":answer/id": "78e53cc1-7d52-5482-b8ac-2cd4946734e5",
              ":answer/type": ":answer.type/math",
              ":answer/value": "D=\\begin{bmatrix}1 & -1 & 0 & -2 & 2 \\\\ 0 & 2 & 1 & -1 & 0 \\\\ 0 & 0 & 3 & 0 & 1\\end{bmatrix}"
            },
            {
              ":answer/id": "b01bc069-1234-52df-a136-8a1991dba041",
              ":answer/type": ":answer.type/math",
              ":answer/value": "A=\\begin{bmatrix}-4 & 3 & -1 \\\\ 0 & 2 & -3 \\\\ 0 & 0 & -2\\end{bmatrix}"
            },
            {
              ":answer/id": "c943a037-8656-5d94-a1f1-16cb9577179d",
              ":answer/type": ":answer.type/math",
              ":answer/value": "C=\\begin{bmatrix}1 & 2 & -1 \\\\ 0 & 1 & -2 \\\\ 0 & 0 & 1 \\\\ 0 & 0 & 0\\end{bmatrix}"
            },
            {
              ":answer/id": "40ca3941-44be-51f9-90d3-3c5f0e947a23",
              ":answer/type": ":answer.type/math",
              ":answer/value": "E=\\begin{bmatrix}3 & -1 & 2 & 4 & 2 \\\\ 0 & 1 & 1 & 3 & -2 \\\\ 0 & 0 & -2 & 1 & 2 \\\\ 0 & 0 & 0 & 0 & 0\\end{bmatrix}"
            },
            {
              ":answer/id": "590a0ad0-5b41-5595-b1b6-4747202386fc",
              ":answer/type": ":answer.type/math",
              ":answer/value": "B=\\begin{bmatrix}-1 & 0 & 2 & 3 \\\\ 0 & 1 & 0 & -1 \\\\ 0 & 0 & 1 & 0 \\\\ 0 & 0 & 0 & 1\\end{bmatrix}"
