#{[17592186235391 {:db/id #edb/ref 17592186235391 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28f0c4bf-c884-5ffe-9bbb-fd66e54891c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{t}^{2}}{(2{t}^{2}+3)^{4}}" :db/id #edb/ref 17592186234608}] :answer-field/correct {:db/id #edb/ref 17592186234608} :answer-field/id #uuid "c19367e3-97ce-5783-bf46-3e1a0dadc9a0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186235212}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3c85a07f-1862-53e2-9986-87c4ee966897" :question/math-academy-id "q-132983" :question/problem "$\\int {y}^{′}(t)\\,\\text{d}t=\\operatorname{ln}⁡($\n\n                            \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        \n$)+\\,K,$\nwhere $K$ is an arbitrary constant." :question/worked-solution "In part 9, we found that\n\n$$\n-16\\int \\frac{t}{2{t}^{2}+3}\\,\\text{d}t=-4\\operatorname{ln}⁡(2{t}^{2}+3)+K.\n$$\n\nUsing the sum and constant multiple rules, we compute the sum of the integrals of each function in the partial sum decomposition of ${y}^{′}(t)$ found in part 8:\n\n$$\n\\begin{aligned}\\int {y}^{′}(t)\\,\\text{d}t & =\\int (\\frac{2}{t}-\\frac{16t}{2{t}^{2}+3})\\text{d}t \\\\  & =\\int \\frac{2}{t}\\,\\text{d}t-16\\int \\frac{t}{2{t}^{2}+3}\\,\\text{d}t \\\\  & =2\\operatorname{ln}⁡|t|-4\\operatorname{ln}⁡(2{t}^{2}+3)+K \\\\  & =\\operatorname{ln}⁡{t}^{2}-\\operatorname{ln}⁡((2{t}^{2}+3)^{4})+K \\\\  & =\\operatorname{ln}⁡\\left(\\frac{{t}^{2}}{(2{t}^{2}+3)^{4}}\\right)+K.\\end{aligned}\n$$" :step/_content [{:db/id #edb/ref 17592186235616 :multistep/_steps {:db/id #edb/ref 17592186235305 :multistep/context "A particle $P$ is moving along a curve in an $xy$-plane such that the $x$-coordinate of $P$ is given by\n\n$$\nx(t)=\\frac{2t}{(2{t}^{2}+3)^{2}},\\,t>0\n$$\n\nwhere $x$ is the distance of $P$ from the origin, measured in meters, and $t$ is measured in seconds." :multistep/first-step {:db/id #edb/ref 17592186235732} :multistep/id #uuid "cbb272f1-f5dc-5a8e-a5ad-90bddee2754a" :multistep/steps [{:db/id #edb/ref 17592186235586 :step/content {:db/id #edb/ref 17592186235384} :step/id #uuid "01dc8d52-2ae7-5911-afc7-c49662b4b596" :step/next {:db/id #edb/ref 17592186235762}} {:db/id #edb/ref 17592186235616 :step/content {:db/id #edb/ref 17592186235391} :step/id #uuid "29686a44-42f0-5647-a0ea-c233a9f3a573"} {:db/id #edb/ref 17592186235648 :step/content {:db/id #edb/ref 17592186235388} :step/id #uuid "4bc77df3-20f6-580a-a04a-5887403aae86" :step/next {:db/id #edb/ref 17592186235743}} {:db/id #edb/ref 17592186235674 :step/content {:db/id #edb/ref 17592186235386} :step/id #uuid "6f748901-34d8-5fe5-b396-65da16b93764" :step/next {:db/id #edb/ref 17592186235686}} {:db/id #edb/ref 17592186235686 :step/content {:db/id #edb/ref 17592186235387} :step/id #uuid "7d88e23b-5c31-5656-b3b0-9b92982733e8" :step/next {:db/id #edb/ref 17592186235648}} {:db/id #edb/ref 17592186235723 :step/content {:db/id #edb/ref 17592186235390} :step/id #uuid "ab744994-87f7-5099-bac2-49706fc2ba63" :step/next {:db/id #edb/ref 17592186235616}} {:db/id #edb/ref 17592186235732 :step/content {:db/id #edb/ref 17592186235382} :step/id #uuid "b721cbfc-ca6a-5758-b736-d995eaa6a3ae" :step/next {:db/id #edb/ref 17592186235777}} {:db/id #edb/ref 17592186235743 :step/content {:db/id #edb/ref 17592186235389} :step/id #uuid "c98220d8-639c-5178-adae-bfba15a28166" :step/next {:db/id #edb/ref 17592186235723}} {:db/id #edb/ref 17592186235762 :step/content {:db/id #edb/ref 17592186235385} :step/id #uuid "e14a647f-6504-5a8a-8c4e-9ea21ec34f96" :step/next {:db/id #edb/ref 17592186235674}} {:db/id #edb/ref 17592186235777 :step/content {:db/id #edb/ref 17592186235383} :step/id #uuid "ef53cf9f-fb49-5488-8597-598e2df1105f" :step/next {:db/id #edb/ref 17592186235586}}]} :step/content {:db/id #edb/ref 17592186235391} :step/id #uuid "29686a44-42f0-5647-a0ea-c233a9f3a573"}]}] [17592186235456 {:db/id #edb/ref 17592186235456 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49e6b660-e7fa-5392-b0f6-a50bdfd47004" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-2/x" :db/id #edb/ref 17592186234659}] :answer-field/correct {:db/id #edb/ref 17592186234659} :answer-field/id #uuid "78ba49d8-2db6-5100-8d54-7ea280ac61ec" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186235118}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "221f7f46-e501-5c4b-9474-541896c7450d" :question/math-academy-id "q-167635" :question/problem "Given that $A=2$ and $B=3,$\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        $\\int \\frac{f(x)}{{x}^{3}}\\,\\text{d}x=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        \n$+\\,C.$" :question/worked-solution "We found that $A=2$ and $B=3$ in steps 2 and 3, respectively. Hence, $f(x)={x}^{3}+2x.$ \n\nUsing the sum and constant factor rules and our result from step 4, we get\n\n$$\n\\begin{aligned}\\int \\frac{f(x)}{{x}^{3}}\\,\\text{d}x & =\\int \\frac{{x}^{3}+2x}{{x}^{3}}\\,\\text{d}x \\\\  & =\\int (1+\\frac{2}{{x}^{2}})\\,\\text{d}x \\\\  & =\\int 1\\,\\text{d}x+\\int \\frac{2}{{x}^{2}}\\,\\text{d}x \\\\  & =x-\\frac{2}{x}+C.\\end{aligned}\n$$" :step/_content [{:db/id #edb/ref 17592186235636 :multistep/_steps {:db/id #edb/ref 17592186235301 :multistep/context "Consider the functions $f(x)={x}^{B}+Ax,g(x)=B{e}^{x},$ and $h(x)=sin⁡x+1,$ where $A$ and $B$ are constants to be found." :multistep/first-step {:db/id #edb/ref 17592186235659} :multistep/id #uuid "8fd21532-89f6-5c25-a765-13883174e1e0" :multistep/steps [{:db/id #edb/ref 17592186235589 :step/content {:db/id #edb/ref 17592186235453} :step/id #uuid "06023932-8236-551e-8944-bf02e1c2d973" :step/next {:db/id #edb/ref 17592186235656}} {:db/id #edb/ref 17592186235636 :step/content {:db/id #edb/ref 17592186235456} :step/id #uuid "3df2343a-bbb7-5b34-aa08-c03d63c3a1bf" :step/next {:db/id #edb/ref 17592186235643}} {:db/id #edb/ref 17592186235643 :step/content {:db/id #edb/ref 17592186235457} :step/id #uuid "45bb2f18-2e9e-5b44-8e6d-835ab02f773e" :step/next {:db/id #edb/ref 17592186235730}} {:db/id #edb/ref 17592186235656 :step/content {:db/id #edb/ref 17592186235454} :step/id #uuid "5913bc92-a4b7-5aae-8c83-91eeba377481" :step/next {:db/id #edb/ref 17592186235747}} {:db/id #edb/ref 17592186235659 :step/content {:db/id #edb/ref 17592186235452} :step/id #uuid "5b1c7505-862b-5fd8-891f-db395428467e" :step/next {:db/id #edb/ref 17592186235589}} {:db/id #edb/ref 17592186235700 :step/content {:db/id #edb/ref 17592186235459} :step/id #uuid "9858bdd7-c68f-520a-814f-257f6c87fa70"} {:db/id #edb/ref 17592186235730 :step/content {:db/id #edb/ref 17592186235458} :step/id #uuid "b4e39b02-a0ee-5216-8f15-fc24fb6ca6c5" :step/next {:db/id #edb/ref 17592186235700}} {:db/id #edb/ref 17592186235747 :step/content {:db/id #edb/ref 17592186235455} :step/id #uuid "cc7fb253-09d5-5a21-9268-9ccb9408c367" :step/next {:db/id #edb/ref 17592186235636}}]} :step/content {:db/id #edb/ref 17592186235456} :step/id #uuid "3df2343a-bbb7-5b34-aa08-c03d63c3a1bf" :step/next {:db/id #edb/ref 17592186235643}}]}] [17592186541108 {:db/id #edb/ref 17592186541108 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c412eada-9cf7-59a5-905e-0f6c0063eb13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{t^3}{3}-2t" :db/id #edb/ref 17592186540856}] :answer-field/correct {:db/id #edb/ref 17592186540856} :answer-field/id #uuid "b1f591a2-abaf-568b-95d2-b28ddb7d4b0c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186541017}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "836e24be-b58e-500b-bb05-e9b2030ce5e6" :question/math-academy-id "q-133291" :question/problem "Find $y(t),$ the antiderivative of ${y}^{′}(t).$\n\n$y(t)=$\n{{field-1}}\n$+\\,C$" :question/worked-solution "We know that ${y}^{′}(t)={t}^{2}-2.$\n\nApplying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int {t}^{2}-2\\,\\text{d}t & =\\int {t}^{2}\\,\\text{d}t-\\int 2\\,\\text{d}t \\\\  & =\\int {t}^{2}\\,\\text{d}t-2\\int {t}^{0}\\,\\text{d}t \\\\  & =\\left(\\frac{{t}^{2+1}}{2+1}\\right)-2t+C \\\\  & =\\frac{1}{3}{t}^{3}-2t+C.\\end{aligned}\n$$" :step/_content [{:db/id #edb/ref 17592186541193 :multistep/_steps {:db/id #edb/ref 17592186541053 :multistep/context "An eagle flies along the parametric curve\n\n$$\nx=\\operatorname{arctan}⁡(\\frac{t}{5}),\\,y=y(t),\\,t>0,\n$$\n\nwhere $x$ and $y$ are measured in meters relative to its nest at the origin, and $t$ is measured in seconds. The functions ${x}^{′}(t)$ and ${y}^{′}(t)$ give the eagle's horizontal and vertical velocity, respectively." :multistep/first-step {:db/id #edb/ref 17592186541207} :multistep/id #uuid "b3bf487d-f311-547b-902e-6194ab2bcbfe" :multistep/steps [{:db/id #edb/ref 17592186541158 :step/content {:db/id #edb/ref 17592186541063} :step/id #uuid "0b6a8ccd-d70c-5f07-bd06-c1a67bb8c918" :step/next {:db/id #edb/ref 17592186541175}} {:db/id #edb/ref 17592186541159 :step/content {:db/id #edb/ref 17592186541058} :step/id #uuid "0e869152-61a2-5f4c-b677-eb10be0bff89" :step/next {:db/id #edb/ref 17592186541225}} {:db/id #edb/ref 17592186541165 :step/content {:db/id #edb/ref 17592186541100} :step/id #uuid "25ed461a-1ae1-5bcc-a645-a1adcac020ee" :step/next {:db/id #edb/ref 17592186541193}} {:db/id #edb/ref 17592186541175 :step/content {:db/id #edb/ref 17592186541151} :step/id #uuid "39c190e2-19cb-57ce-9a89-1a038703f741" :step/next {:db/id #edb/ref 17592186541218}} {:db/id #edb/ref 17592186541186 :step/content {:db/id #edb/ref 17592186541112} :step/id #uuid "5cd9358c-320d-5663-953d-407f8219b7ce" :step/next {:db/id #edb/ref 17592186541159}} {:db/id #edb/ref 17592186541193 :step/content {:db/id #edb/ref 17592186541108} :step/id #uuid "780c444c-203b-507b-affb-974182c4ecb1" :step/next {:db/id #edb/ref 17592186541158}} {:db/id #edb/ref 17592186541207 :step/content {:db/id #edb/ref 17592186541096} :step/id #uuid "9e4e6674-5e6f-501b-bec3-9bdb487d5059" :step/next {:db/id #edb/ref 17592186541186}} {:db/id #edb/ref 17592186541218 :step/content {:db/id #edb/ref 17592186541128} :step/id #uuid "c41b1b6f-713f-5c06-8fe9-5de055592653"} {:db/id #edb/ref 17592186541223 :step/content {:db/id #edb/ref 17592186541148} :step/id #uuid "e6e7506e-0ef6-58fd-a0a5-b890fb1061ce" :step/next {:db/id #edb/ref 17592186541165}} {:db/id #edb/ref 17592186541225 :step/content {:db/id #edb/ref 17592186541078} :step/id #uuid "eb5ce766-c910-5578-addb-d9c3fe513f7c" :step/next {:db/id #edb/ref 17592186541223}}]} :step/content {:db/id #edb/ref 17592186541108} :step/id #uuid "780c444c-203b-507b-affb-974182c4ecb1" :step/next {:db/id #edb/ref 17592186541158}}]}] [17592186581701 {:db/id #edb/ref 17592186581701 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "425088a0-8b6d-555a-87b1-28f844922b38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-\\frac{2}{x}" :db/id #edb/ref 17592186581142}] :answer-field/correct {:db/id #edb/ref 17592186581142} :answer-field/id #uuid "6867512d-b53b-53db-a5a5-f341bd835d41" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186581553}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8913b80e-2bcb-5364-9080-3c746725b920" :question/math-academy-id "q-167587" :question/problem "Given that $A=3$ and $B=2,$\n\n$\\int \\frac{f(x)}{{x}^{3}}\\,\\text{d}x=$\n{{field-1}}\n$+\\,C.$" :question/worked-solution "We found that $A=3$ and $B=2$ in steps 2 and 3, respectively. Hence, $f(x)={x}^{3}+2x.$ \n\nUsing the sum and constant factor rules and our result from step 4, we get\n\n$$\n\\begin{aligned}\\int \\frac{f(x)}{{x}^{3}}\\,\\text{d}x & =\\int \\frac{{x}^{3}+2x}{{x}^{3}}\\,\\text{d}x \\\\  & =\\int (1+\\frac{2}{{x}^{2}})\\,\\text{d}x \\\\  & =\\int \\,\\text{d}x+\\int \\frac{2}{{x}^{2}}\\,\\text{d}x \\\\  & =x-\\frac{2}{x}+C.\\end{aligned}\n$$" :step/_content [{:db/id #edb/ref 17592186581783 :multistep/_steps {:db/id #edb/ref 17592186581638 :multistep/context "Consider the functions $f(x)={x}^{A}+Bx,g(x)=A{e}^{x},$ and $h(x)=\\operatorname{sin}⁡x+2,$ where $A$ and $B$ are constants to be found." :multistep/first-step {:db/id #edb/ref 17592186581792} :multistep/id #uuid "c23f7a6e-cbaa-5fb7-aaf2-6238c225b397" :multistep/steps [{:db/id #edb/ref 17592186581748 :step/content {:db/id #edb/ref 17592186581731} :step/id #uuid "026db3f0-fcfa-5246-8fc0-1c4b5751f042" :step/next {:db/id #edb/ref 17592186581780}} {:db/id #edb/ref 17592186581750 :step/content {:db/id #edb/ref 17592186581684} :step/id #uuid "0cda85cc-99a7-5b70-a2e9-e9f084656cc3" :step/next {:db/id #edb/ref 17592186581748}} {:db/id #edb/ref 17592186581776 :step/content {:db/id #edb/ref 17592186581729} :step/id #uuid "84b4e24f-fcda-5fa8-a961-da4f5f047d57" :step/next {:db/id #edb/ref 17592186581789}} {:db/id #edb/ref 17592186581780 :step/content {:db/id #edb/ref 17592186581723} :step/id #uuid "a6db9696-ad2f-5a4c-a7b9-6465f5e5934a"} {:db/id #edb/ref 17592186581783 :step/content {:db/id #edb/ref 17592186581701} :step/id #uuid "b526b5b6-baff-5720-a6d8-406972200426" :step/next {:db/id #edb/ref 17592186581750}} {:db/id #edb/ref 17592186581787 :step/content {:db/id #edb/ref 17592186581640} :step/id #uuid "cf6f3cdf-5d7c-5d10-ae90-6b89c1f675f5" :step/next {:db/id #edb/ref 17592186581776}} {:db/id #edb/ref 17592186581789 :step/content {:db/id #edb/ref 17592186581718} :step/id #uuid "d9d04f3a-6bfb-5924-ad54-5731a61d71dc" :step/next {:db/id #edb/ref 17592186581783}} {:db/id #edb/ref 17592186581792 :step/content {:db/id #edb/ref 17592186581724} :step/id #uuid "eb784615-b954-5b9f-bbdf-0955ea5ad082" :step/next {:db/id #edb/ref 17592186581787}}]} :step/content {:db/id #edb/ref 17592186581701} :step/id #uuid "b526b5b6-baff-5720-a6d8-406972200426" :step/next {:db/id #edb/ref 17592186581750}}]}] [17592186585714 {:db/id #edb/ref 17592186585714 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8db33716-add6-5f35-bf02-1d51985de66c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+\\frac{4}{x}" :db/id #edb/ref 17592186585431}] :answer-field/correct {:db/id #edb/ref 17592186585431} :answer-field/id #uuid "095f41d4-028c-5d7c-986c-c74e9a83226f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186585594}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "002408ea-9be6-53e5-9b20-0951e4cd4bad" :question/math-academy-id "q-167617" :question/problem "Given that $A=2$ and $B=4,$\n\n$\\int \\frac{f(x)}{{x}^{2}}\\,\\text{d}x=$\n{{field-1}}\n$+\\,C.$" :question/worked-solution "We found that $A=2$ and $B=4$ in steps 2 and 3, respectively. Hence, $f(x)=2{x}^{2}-4.$  \n\nUsing the sum and constant factor rules and our result from step 4, we get\n\n$$\n\\begin{aligned}\\int \\frac{f(x)}{{x}^{2}}\\,\\text{d}x & =\\int \\frac{2{x}^{2}-4}{{x}^{2}}\\,\\text{d}x \\\\  & =\\int (2-\\frac{4}{{x}^{2}})\\,\\text{d}x \\\\  & =\\int 2\\,\\text{d}x-\\int \\frac{4}{{x}^{2}}\\,\\text{d}x \\\\  & =2x+\\frac{4}{x}+C.\\end{aligned}\n$$" :step/_content [{:db/id #edb/ref 17592186585864 :multistep/_steps {:db/id #edb/ref 17592186585713 :multistep/context "Consider the functions $f(x)=2{x}^{A}-B,g(x)=A{e}^{x},$ and $h(x)=\\operatorname{cos}⁡x+1,$ where $A$ and $B$ are constants to be found." :multistep/first-step {:db/id #edb/ref 17592186585840} :multistep/id #uuid "65636e3c-ba71-595d-8fca-e2e645b391f9" :multistep/steps [{:db/id #edb/ref 17592186585818 :step/content {:db/id #edb/ref 17592186585745} :step/id #uuid "042d4a3c-8fce-5faf-8f58-1abf13a41039" :step/next {:db/id #edb/ref 17592186585831}} {:db/id #edb/ref 17592186585831 :step/content {:db/id #edb/ref 17592186585809} :step/id #uuid "48f7ce6e-e680-5880-91a4-35b54439255c" :step/next {:db/id #edb/ref 17592186585856}} {:db/id #edb/ref 17592186585837 :step/content {:db/id #edb/ref 17592186585731} :step/id #uuid "7e60f784-a06e-545c-ad90-99bfdd878205" :step/next {:db/id #edb/ref 17592186585838}} {:db/id #edb/ref 17592186585838 :step/content {:db/id #edb/ref 17592186585772} :step/id #uuid "80f76d32-2bf4-5cfa-8487-5f00239f02c9" :step/next {:db/id #edb/ref 17592186585864}} {:db/id #edb/ref 17592186585840 :step/content {:db/id #edb/ref 17592186585738} :step/id #uuid "838ffef3-334d-5953-8fd3-8548b7ad0679" :step/next {:db/id #edb/ref 17592186585855}} {:db/id #edb/ref 17592186585855 :step/content {:db/id #edb/ref 17592186585744} :step/id #uuid "e31372f9-420a-59e8-acd7-8b3b9b7691bc" :step/next {:db/id #edb/ref 17592186585837}} {:db/id #edb/ref 17592186585856 :step/content {:db/id #edb/ref 17592186585727} :step/id #uuid "e42c1fab-3e86-5520-8b62-542eed0d678a"} {:db/id #edb/ref 17592186585864 :step/content {:db/id #edb/ref 17592186585714} :step/id #uuid "fbf8dd52-f4ce-5cd3-9d19-ca33c44829dd" :step/next {:db/id #edb/ref 17592186585818}}]} :step/content {:db/id #edb/ref 17592186585714} :step/id #uuid "fbf8dd52-f4ce-5cd3-9d19-ca33c44829dd" :step/next {:db/id #edb/ref 17592186585818}}]}] [17592186594690 {:db/id #edb/ref 17592186594690 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eaf90b86-ed00-521f-866e-457741256953" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{t}{(t^2+3)^2}" :db/id #edb/ref 17592186594566}] :answer-field/correct {:db/id #edb/ref 17592186594566} :answer-field/id #uuid "c3de83bc-b404-5457-8f8e-eb85acb80364" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186594644}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6cc6368e-df43-5cbe-829c-1d64f41be4a6" :question/math-academy-id "q-132779" :question/problem "$\\int {y}^{′}(t)\\,\\text{d}t=\\operatorname{ln}⁡(${{field-1}}\n$)+\\,K,$\nwhere $K$ is an arbitrary constant." :question/worked-solution "In part 9, we found that\n\n$$\n-4\\int \\frac{t}{{t}^{2}+3}\\,\\text{d}t=-2\\operatorname{ln}⁡({t}^{2}+3)+K.\n$$\n\nUsing the sum and constant multiple rules, we compute the sum of the integrals of each function in the partial sum decomposition of ${y}^{′}(t)$ found in part 8:\n\n$$\n\\begin{aligned}\\int {y}^{′}(t)\\,\\text{d}t & =\\int (\\frac{1}{t}-\\frac{4t}{{t}^{2}+1})\\text{d}t \\\\  & =\\int \\frac{1}{t}\\,\\text{d}t-4\\int \\frac{t}{{t}^{2}+3}\\,\\text{d}t \\\\  & =\\operatorname{ln}⁡|t|-2\\operatorname{ln}⁡({t}^{2}+3)+K \\\\  & =\\operatorname{ln}⁡t-\\operatorname{ln}⁡(({t}^{2}+3)^{2})+K \\\\  & =\\operatorname{ln}⁡\\left(\\frac{t}{({t}^{2}+3)^{2}}\\right)+K.\\end{aligned}\n$$" :step/_content [{:db/id #edb/ref 17592186594799 :multistep/_steps {:db/id #edb/ref 17592186594664 :multistep/context "A particle $P$ is moving along a curve in an $xy$-plane such that the $x$-coordinate of $P$ is given by\n\n$$\nx(t)=\\frac{t}{({t}^{2}+3)^{2}},\\,t>0\n$$\n\nwhere $x$ is the distance of $P$ from the origin, measured in meters, and $t$ is measured in seconds." :multistep/first-step {:db/id #edb/ref 17592186594743} :multistep/id #uuid "cda1fd0e-ac68-5a35-9383-0f5598e0801a" :multistep/steps [{:db/id #edb/ref 17592186594743 :step/content {:db/id #edb/ref 17592186594665} :step/id #uuid "20d0338e-6c99-560a-9f28-36ead8792c28" :step/next {:db/id #edb/ref 17592186594754}} {:db/id #edb/ref 17592186594754 :step/content {:db/id #edb/ref 17592186594680} :step/id #uuid "4e825905-2af8-534d-be57-86148ab7ab0c" :step/next {:db/id #edb/ref 17592186594782}} {:db/id #edb/ref 17592186594756 :step/content {:db/id #edb/ref 17592186594693} :step/id #uuid "56f9d5b3-131a-5dab-a77f-a594bb29509e" :step/next {:db/id #edb/ref 17592186594791}} {:db/id #edb/ref 17592186594761 :step/content {:db/id #edb/ref 17592186594720} :step/id #uuid "637d9130-bf54-5029-bf2f-4661e357d79f" :step/next {:db/id #edb/ref 17592186594756}} {:db/id #edb/ref 17592186594763 :step/content {:db/id #edb/ref 17592186594682} :step/id #uuid "6cb6d9b6-6fa8-500c-aa26-eb513a541877" :step/next {:db/id #edb/ref 17592186594761}} {:db/id #edb/ref 17592186594780 :step/content {:db/id #edb/ref 17592186594728} :step/id #uuid "a23e8b64-aa0c-527c-b649-abac84d05030" :step/next {:db/id #edb/ref 17592186594763}} {:db/id #edb/ref 17592186594782 :step/content {:db/id #edb/ref 17592186594697} :step/id #uuid "ab1e8fef-df1a-5eb7-be58-125af0e1290f" :step/next {:db/id #edb/ref 17592186594780}} {:db/id #edb/ref 17592186594783 :step/content {:db/id #edb/ref 17592186594705} :step/id #uuid "af9e3dc0-60ea-5d3d-a1ca-8efd596fc0f5" :step/next {:db/id #edb/ref 17592186594799}} {:db/id #edb/ref 17592186594791 :step/content {:db/id #edb/ref 17592186594722} :step/id #uuid "d04f5e2a-be70-571b-83f3-82a9663f3818" :step/next {:db/id #edb/ref 17592186594783}} {:db/id #edb/ref 17592186594799 :step/content {:db/id #edb/ref 17592186594690} :step/id #uuid "dcac2414-e8c1-5d28-ad8f-c80378c8a59b"}]} :step/content {:db/id #edb/ref 17592186594690} :step/id #uuid "dcac2414-e8c1-5d28-ad8f-c80378c8a59b"}]}] [17592186601926 {:db/id #edb/ref 17592186601926 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d0cfd63a-4b5a-533e-a2be-e7bf4a561271" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{t}}{(t^2+1)^{3/2}}" :db/id #edb/ref 17592186601770}] :answer-field/correct {:db/id #edb/ref 17592186601770} :answer-field/id #uuid "e0fb97d3-41c9-50ca-834c-975b2638d484" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186601879}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a588b6ca-ca51-5122-a816-0bdade4e8a44" :question/math-academy-id "q-133003" :question/problem "$\\int {y}^{′}(t)\\,\\text{d}t=\\operatorname{ln}⁡(${{field-1}}\n$)+\\,K,$\nwhere $K$ is an arbitrary constant." :question/worked-solution "In part 9, we found that\n\n$$\n-3\\int \\frac{t}{{t}^{2}+1}\\,\\text{d}t=-\\frac{3}{2}\\operatorname{ln}⁡({t}^{2}+1)+K.\n$$\n\nUsing the sum and constant multiple rules, we compute the sum of the integrals of each function in the partial sum decomposition of ${y}^{′}(t)$ found in part 8:\n\n$$\n\\begin{aligned}\\int {y}^{′}(t)\\,\\text{d}t & =\\int (\\frac{1}{2t}-\\frac{3t}{{t}^{2}+1})\\text{d}t \\\\  & =\\frac{1}{2}\\int \\frac{1}{t}\\,\\text{d}t-3\\int \\frac{t}{{t}^{2}+1}\\,\\text{d}t \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|t|-\\frac{3}{2}\\operatorname{ln}⁡({t}^{2}+1)+K \\\\  & =\\operatorname{ln}⁡(\\sqrt{t})-\\operatorname{ln}⁡(\\sqrt{({t}^{2}+1)^{3}})+K \\\\  & =\\operatorname{ln}⁡\\left(\\frac{\\sqrt{t}}{\\sqrt{({t}^{2}+1)^{3}}}\\right)+K \\\\  & =\\operatorname{ln}⁡(\\sqrt{\\frac{t}{({t}^{2}+1)^{3}}})+K.\\end{aligned}\n$$" :step/_content [{:db/id #edb/ref 17592186602022 :multistep/_steps {:db/id #edb/ref 17592186601892 :multistep/context "A particle $P$ is moving along a curve in an $xy$-plane such that the $x$-coordinate of $P$ is given by\n\n$$\nx(t)=\\frac{3t}{({t}^{2}+1)^{3}},\\,t>0\n$$\n\nwhere $x$ is the distance of $P$ from the origin, measured in meters, and $t$ is measured in seconds." :multistep/first-step {:db/id #edb/ref 17592186601972} :multistep/id #uuid "a3bb6abd-7c7c-5aed-acb5-3ed09c221aa1" :multistep/steps [{:db/id #edb/ref 17592186601971 :step/content {:db/id #edb/ref 17592186601949} :step/id #uuid "39191ebb-fe2b-5523-a595-65289edb264d" :step/next {:db/id #edb/ref 17592186602002}} {:db/id #edb/ref 17592186601972 :step/content {:db/id #edb/ref 17592186601935} :step/id #uuid "3a564dc4-eff1-5aa9-9b50-6ccd895b8292" :step/next {:db/id #edb/ref 17592186602003}} {:db/id #edb/ref 17592186601973 :step/content {:db/id #edb/ref 17592186601914} :step/id #uuid "42b1123f-d292-5e13-8aec-86789f6538f5" :step/next {:db/id #edb/ref 17592186601974}} {:db/id #edb/ref 17592186601974 :step/content {:db/id #edb/ref 17592186601923} :step/id #uuid "48f802f5-2dec-542b-b39b-b8c76a191ea2" :step/next {:db/id #edb/ref 17592186602026}} {:db/id #edb/ref 17592186602002 :step/content {:db/id #edb/ref 17592186601918} :step/id #uuid "a158fd12-45cd-503b-9f4e-e9c8b873188c" :step/next {:db/id #edb/ref 17592186602022}} {:db/id #edb/ref 17592186602003 :step/content {:db/id #edb/ref 17592186601919} :step/id #uuid "a42d100c-909d-5628-b51f-1e963f8a6cae" :step/next {:db/id #edb/ref 17592186602024}} {:db/id #edb/ref 17592186602014 :step/content {:db/id #edb/ref 17592186601905} :step/id #uuid "c2ab1b57-eff3-52c4-9917-72cbfa2d0088" :step/next {:db/id #edb/ref 17592186601971}} {:db/id #edb/ref 17592186602022 :step/content {:db/id #edb/ref 17592186601926} :step/id #uuid "ddbc6ff2-6380-5dd8-9f4e-cdefba050ea5"} {:db/id #edb/ref 17592186602024 :step/content {:db/id #edb/ref 17592186601929} :step/id #uuid "e57d6f85-27af-5627-839d-377d9f6bf256" :step/next {:db/id #edb/ref 17592186601973}} {:db/id #edb/ref 17592186602026 :step/content {:db/id #edb/ref 17592186601927} :step/id #uuid "ea389613-7716-5540-879d-9eccac89d302" :step/next {:db/id #edb/ref 1759