[7]{x^{13}}}$."} {:db/id #edb/ref 17592186233644 :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8f7dc381-ff4a-5ab2-9c80-1b180b43d77b" :question/math-academy-id "q-2252" :question/problem "Find the antiderivative of $2{x}^{2}-x+\\frac{1}{2}.$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (2{x}^{2}-x+\\frac{1}{2})\\,\\text{d}x & =2\\int {x}^{2}\\,\\text{d}x-\\int x\\,\\text{d}x+\\int \\frac{1}{2}\\,\\text{d}x \\\\  & =2\\left(\\frac{{x}^{3}}{3}\\right)-\\left(\\frac{{x}^{2}}{2}\\right)+\\left(\\frac{x}{2}\\right)+C \\\\  & =\\frac{2{x}^{3}}{3}-\\frac{{x}^{2}}{2}+\\frac{x}{2}+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234106 :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b6c1d13e-58bd-57d8-918b-0a1bebf09fb1" :question/math-academy-id "q-49173" :question/problem "$\\int {(1+5{x}^{2})}^{2}\\,\\text{d}x=$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int {(1+5{x}^{2})}^{2}\\,\\text{d}x & =\\int (1+10{x}^{2}+25{x}^{4})\\,\\text{d}x \\\\  & =25\\int {x}^{4}\\,\\text{d}x+10\\int {x}^{2}\\,\\text{d}x+\\int 1\\,\\text{d}x \\\\  & =25\\left(\\frac{{x}^{5}}{5}\\right)+10\\left(\\frac{{x}^{3}}{3}\\right)+(x)+C \\\\  & =5{x}^{5}+\\frac{10{x}^{3}}{3}+x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250124 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4d74b89-75a1-56f3-b6b6-828088510585" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt[3]{x}}+\\frac{{x}^{4}}{4}+\\frac{1}{x}+C" :db/id #edb/ref 17592186249171} {:answer/id #uuid "de570091-257b-5378-a03a-2502b905ef6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt[3]{x}}+\\frac{{x}^{2}}{4}+\\frac{1}{{x}^{3}}+C" :db/id #edb/ref 17592186249396} {:answer/id #uuid "e77f388d-8a73-59ce-8f66-bc9a394fa477" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt[3]{{x}^{4}}}+\\frac{{x}^{2}}{2}+\\frac{1}{x}+C" :db/id #edb/ref 17592186249466} {:answer/id #uuid "f18e54e2-bbf7-5c09-a529-02ac0e448d1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{x}^{3}}}{3}+4{x}^{4}+\\frac{x}{2}+C" :db/id #edb/ref 17592186249545} {:answer/id #uuid "f8f381b4-0b8f-5cfb-8192-5f7af284e5dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{x}+\\frac{{x}^{4}}{4}-\\frac{x}{4}+C" :db/id #edb/ref 17592186249595}] :answer-field/correct {:answer/id #uuid "c4d74b89-75a1-56f3-b6b6-828088510585" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt[3]{x}}+\\frac{{x}^{4}}{4}+\\frac{1}{x}+C" :db/id #edb/ref 17592186249171} :answer-field/id #uuid "bb1b4399-41fb-5b60-b839-8a80147e6a2e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249996}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e132caee-594d-5f81-b6a1-2e2a44a2d5f6" :question/math-academy-id "q-113848" :question/problem "Find the antiderivative of \n$\\frac{1}{\\sqrt[3]{{x}^{4}}}+{x}^{3}-\\frac{1}{{x}^{2}}.$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (\\frac{1}{\\sqrt[3]{{x}^{4}}}+{x}^{3}-\\frac{1}{{x}^{2}})\\,\\text{d}x & =\\int {x}^{-4/3}\\,\\text{d}x+\\int {x}^{3}\\,\\text{d}x-\\int {x}^{-2}\\,\\text{d}x \\\\  & =\\frac{{x}^{-4/3+1}}{(-\\frac{4}{3}+1)}+\\frac{{x}^{3+1}}{(3+1)}-\\frac{{x}^{-2+1}}{(-2+1)}+C \\\\  & =\\frac{{x}^{-1/3}}{\\left(-\\frac{1}{3}\\right)}+\\frac{{x}^{4}}{4}-\\frac{{x}^{-1}}{(-1)}+C \\\\  & =-\\frac{3}{\\sqrt[3]{x}}+\\frac{{x}^{4}}{4}+\\frac{1}{x}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186567046 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37dd99bc-3607-581f-978c-a71b67914c2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[5]{{x}^{9}}-2{x}^{2}-\\frac{2}{3{x}^{3}}+C" :db/id #edb/ref 17592186566477} {:answer/id #uuid "9126a86d-bcfd-5fec-9571-5503eba42ee5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt[5]{{x}^{9}}}{9}-\\frac{{x}^{2}}{2}-\\frac{2}{3{x}^{3}}+C" :db/id #edb/ref 17592186566648} {:answer/id #uuid "a5d265ad-a1a6-58b0-b6d6-e96a59278366" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{5\\sqrt[5]{{x}^{9}}}-\\frac{2}{x}-\\frac{6}{{x}^{3}}+C" :db/id #edb/ref 17592186566688} {:answer/id #uuid "dafdca6c-9141-5612-9f79-f5c98e819afc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{\\sqrt[5]{{x}^{4}}}-\\frac{2}{{x}^{2}}-\\frac{6}{{x}^{4}}+C" :db/id #edb/ref 17592186566803} {:answer/id #uuid "f64dcd14-9eac-5db3-bba6-758aa5bc23bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt[5]{{x}^{4}}}{4}-\\frac{1}{2x}-\\frac{2}{3{x}^{6}}+C" :db/id #edb/ref 17592186566857}] :answer-field/correct {:answer/id #uuid "9126a86d-bcfd-5fec-9571-5503eba42ee5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt[5]{{x}^{9}}}{9}-\\frac{{x}^{2}}{2}-\\frac{2}{3{x}^{3}}+C" :db/id #edb/ref 17592186566648} :answer-field/id #uuid "e1056adf-eded-5bde-8128-44705a2baad4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186566981}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "676d4494-4f46-573f-a890-2a8daa607201" :question/math-academy-id "q-113850" :question/problem "Find the antiderivative of \n$\\sqrt[5]{{x}^{4}}-x+\\frac{2}{{x}^{4}}.$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (\\sqrt[5]{{x}^{4}}-x+\\frac{2}{{x}^{4}})\\,\\text{d}x & =\\int {x}^{4/5}\\,\\text{d}x-\\int x\\,\\text{d}x+2\\int {x}^{-4}\\,\\text{d}x \\\\  & =\\frac{{x}^{4/5+1}}{(\\frac{4}{5}+1)}-\\frac{{x}^{1+1}}{(1+1)}+2\\cdot \\frac{{x}^{-4+1}}{(-4+1)}+C \\\\  & =\\frac{{x}^{9/5}}{\\left(\\frac{9}{5}\\right)}-\\frac{{x}^{2}}{2}+2\\cdot \\frac{{x}^{-3}}{(-3)}+C \\\\  & =\\frac{5\\sqrt[5]{{x}^{9}}}{9}-\\frac{{x}^{2}}{2}-\\frac{2}{3{x}^{3}}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186671010 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "183f0e67-9f9e-5a65-aadf-a4bd2d8c9702" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3x^{4}}{2}-\\frac{4}{x^{5}}-\\frac{5}{\\sqrt[5]{x}}+C" :db/id #edb/ref 17592186671014} {:answer/id #uuid "427e78cf-f9bf-5988-8bf3-c1e8d657ed24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3x^{4}}{4}-\\frac{4}{x^{5}}-\\frac{5}{\\sqrt[5]{x}}+C" :db/id #edb/ref 17592186671018} {:answer/id #uuid "61d7c6dd-7f78-5df4-b99a-2a9a196d0eb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3x^{4}}{4}+\\frac{4}{5x^{5}}-\\frac{5}{\\sqrt[5]{x}}+C" :db/id #edb/ref 17592186671024} {:answer/id #uuid "83bda2a9-0e97-505b-8d64-55cc6c68264a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3x^{4}}{2}-\\frac{4}{x^{5}}+\\frac{25}{\\sqrt[5]{x}}+C" :db/id #edb/ref 17592186671025} {:answer/id #uuid "9c172a14-5b61-55f3-b463-ddd35f75a506" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3x^{4}}{4}+\\frac{4}{5x^{5}}+\\frac{25}{\\sqrt[5]{x}}+C" :db/id #edb/ref 17592186671029}] :answer-field/correct {:answer/id #uuid "61d7c6dd-7f78-5df4-b99a-2a9a196d0eb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3x^{4}}{4}+\\frac{4}{5x^{5}}-\\frac{5}{\\sqrt[5]{x}}+C" :db/id #edb/ref 17592186671024} :answer-field/id #uuid "082c53aa-9037-5f6d-a94c-2dd53b9d5139" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671011}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "028aa697-e6c4-5a0e-b03d-def9695eb209" :question/problem "Find the antiderivative of\n$-3x^{3}-\\frac{4}{x^{6}}+\\frac{1}{\\sqrt[5]{x^{6}}}.$ For real $x\\ne 0$." :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}& \\int\\left(-3x^{3}-\\frac{4}{x^{6}}+\\frac{1}{\\sqrt[5]{x^{6}}}\\right)\\,\\mathrm{d}x\\\\ &= \\int\\left(-3x^{3}-4x^{-6}+x^{\\frac{-6}{5}}\\right)\\,\\mathrm{d}x\\\\ &= -3\\int x^{3}\\,\\mathrm{d}x-4\\int x^{-6}\\,\\mathrm{d}x+\\int x^{\\frac{-6}{5}}\\,\\mathrm{d}x\\\\ &= -3\\left(\\frac{x^{3+1}}{(3+1)}\\right)-4\\left(\\frac{x^{-6+1}}{(-6+1)}\\right)\\\\ &\\quad +\\left(\\frac{x^{\\frac{-6}{5}+1}}{(\\frac{-6}{5}+1)}\\right)+C\\\\ &= -\\frac{3x^{4}}{4}+\\frac{4}{5x^{5}}-\\frac{5}{\\sqrt[5]{x}}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186671012 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "890b50df-241b-5b4f-9df5-aa96000d95d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{42}{\\sqrt[7]{x^{15}}}-\\frac{1}{4x^{4}}+\\frac{3x^{8}}{7}+C" :db/id #edb/ref 17592186671026} {:answer/id #uuid "8ff4abb2-d739-5206-9a76-cad17736caa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{42}{\\sqrt[7]{x}}-\\frac{1}{4x^{5}}+\\frac{3x^{8}}{7}+C" :db/id #edb/ref 17592186671027} {:answer/id #uuid "9cf31199-f10e-56b2-a2c9-e45b77728ad4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{42}{\\sqrt[7]{x}}-\\frac{1}{4x^{4}}+\\frac{3x^{8}}{8}+C" :db/id #edb/ref 17592186671030} {:answer/id #uuid "c073f955-67ff-5a29-b461-35e9524a9203" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{42}{\\sqrt[7]{x}}-\\frac{1}{4x^{5}}+\\frac{3x^{8}}{8}+C" :db/id #edb/ref 17592186671035} {:answer/id #uuid "faefdad3-fda3-5db3-8593-70d8ae260a01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{42}{\\sqrt[7]{x^{15}}}-\\frac{1}{4x^{5}}+\\frac{3x^{8}}{7}+C" :db/id #edb/ref 17592186671043}] :answer-field/correct {:answer/id #uuid "9cf31199-f10e-56b2-a2c9-e45b77728ad4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{42}{\\sqrt[7]{x}}-\\frac{1}{4x^{4}}+\\frac{3x^{8}}{8}+C" :db/id #edb/ref 17592186671030} :answer-field/id #uuid "344c6f14-8c17-5b8b-bfbf-247750622cee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671016}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0bade6c7-cd43-5d21-823b-4952e19f42d7" :question/problem "Find the antiderivative of\n$-\\frac{6}{\\sqrt[7]{x^{8}}}+\\frac{1}{x^{5}}+3x^{7}.$ For real $x\\ne 0$." :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}& \\int\\left(-\\frac{6}{\\sqrt[7]{x^{8}}}+\\frac{1}{x^{5}}+3x^{7}\\right)\\,\\mathrm{d}x\\\\ &= \\int\\left(-6x^{\\frac{-8}{7}}+x^{-5}+3x^{7}\\right)\\,\\mathrm{d}x\\\\ &= -6\\int x^{\\frac{-8}{7}}\\,\\mathrm{d}x+\\int x^{-5}\\,\\mathrm{d}x+3\\int x^{7}\\,\\mathrm{d}x\\\\ &= -6\\left(\\frac{x^{\\frac{-8}{7}+1}}{(\\frac{-8}{7}+1)}\\right)+\\left(\\frac{x^{-5+1}}{(-5+1)}\\right)\\\\ &\\quad +3\\left(\\frac{x^{7+1}}{(7+1)}\\right)+C\\\\ &= \\frac{42}{\\sqrt[7]{x}}-\\frac{1}{4x^{4}}+\\frac{3x^{8}}{8}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186671017 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f1e9927-93b2-583b-9d94-b83a2fafc7db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{x}+\\frac{3x^{4}}{2}+\\frac{12\\sqrt[3]{x^{5}}}{5}+C" :db/id #edb/ref 17592186671023} {:answer/id #uuid "9ad435ba-c8ba-50c2-b5b3-e5b4219e660e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6}{x}+\\frac{3x^{4}}{2}+\\frac{12}{5\\sqrt[3]{x}}+C" :db/id #edb/ref 17592186671028} {:answer/id #uuid "be2c096e-451f-52f5-a1a1-954febf897cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6}{x}+\\frac{3x^{4}}{2}+\\frac{12\\sqrt[3]{x^{5}}}{5}+C" :db/id #edb/ref 17592186671034} {:answer/id #uuid "cae73af8-2404-5b99-bead-4ce52e4304e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{x}+\\frac{6x^{4}}{5}+\\frac{12}{5\\sqrt[3]{x}}+C" :db/id #edb/ref 17592186671037} {:answer/id #uuid "cfc99332-9b17-5d58-8af7-2a7308dc6928" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{x}+\\frac{6x^{4}}{5}+\\frac{12\\sqrt[3]{x^{5}}}{5}+C" :db/id #edb/ref 17592186671038}] :answer-field/correct {:answer/id #uuid "be2c096e-451f-52f5-a1a1-954febf897cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6}{x}+\\frac{3x^{4}}{2}+\\frac{12\\sqrt[3]{x^{5}}}{5}+C" :db/id #edb/ref 17592186671034} :answer-field/id #uuid "ec585ac1-4fe5-537f-8aa6-ac15a56ee933" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671040}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3891daa6-faa4-55c6-9997-ac86fba9a9f0" :question/problem "Find the antiderivative of\n$\\frac{6}{x^{2}}+6x^{3}+4\\sqrt[3]{x^{2}}.$ For real $x\\ne 0$." :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}& \\int\\left(\\frac{6}{x^{2}}+6x^{3}+4\\sqrt[3]{x^{2}}\\right)\\,\\mathrm{d}x\\\\ &= \\int\\left(6x^{-2}+6x^{3}+4x^{\\frac{2}{3}}\\right)\\,\\mathrm{d}x\\\\ &= 6\\int x^{-2}\\,\\mathrm{d}x+6\\int x^{3}\\,\\mathrm{d}x+4\\int x^{\\frac{2}{3}}\\,\\mathrm{d}x\\\\ &= 6\\left(\\frac{x^{-2+1}}{(-2+1)}\\right)+6\\left(\\frac{x^{3+1}}{(3+1)}\\right)\\\\ &\\quad +4\\left(\\frac{x^{\\frac{2}{3}+1}}{(\\frac{2}{3}+1)}\\right)+C\\\\ &= -\\frac{6}{x}+\\frac{3x^{4}}{2}+\\frac{12\\sqrt[3]{x^{5}}}{5}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186671036 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01cafb24-a1d3-52bf-8f9d-12c3134619f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x^{6}}{7}-\\frac{1}{3x^{3}}+\\frac{42}{\\sqrt[7]{x}}+C" :db/id #edb/ref 17592186671009} {:answer/id #uuid "48985b06-1af2-5faa-b044-20977de06c7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{6}}{3}-\\frac{1}{3x^{3}}+\\frac{42}{\\sqrt[7]{x^{15}}}+C" :db/id #edb/ref 17592186671019} {:answer/id #uuid "4ab25325-4150-524c-9b62-51299c24dabe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{6}}{3}-\\frac{1}{3x^{3}}+\\frac{42}{\\sqrt[7]{x}}+C" :db/id #edb/ref 17592186671020} {:answer/id #uuid "5b99ecf4-da2e-5859-ad4f-f9152cc5a57a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x^{6}}{7}-\\frac{1}{3x^{5}}+\\frac{42}{\\sqrt[7]{x^{15}}}+C" :db/id #edb/ref 17592186671022} {:answer/id #uuid "ee462ba7-e5d4-540e-8626-d94445e86e38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x^{6}}{7}-\\frac{1}{3x^{5}}+\\frac{42}{\\sqrt[7]{x}}+C" :db/id #edb/ref 17592186671041}] :answer-field/correct {:answer/id #uuid "4ab25325-4150-524c-9b62-51299c24dabe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{6}}{3}-\\frac{1}{3x^{3}}+\\frac{42}{\\sqrt[7]{x}}+C" :db/id #edb/ref 17592186671020} :answer-field/id #uuid "4c63ed41-ff98-562b-9155-b0554d9bc05e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671021}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c7b48c65-5e5b-586a-af84-38b8bafff23c" :question/problem "Find the antiderivative of\n$2x^{5}+\\frac{1}{x^{4}}-\\frac{6}{\\sqrt[7]{x^{8}}}.$ For real $x\\ne 0$." :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}& \\int\\left(2x^{5}+\\frac{1}{x^{4}}-\\frac{6}{\\sqrt[7]{x^{8}}}\\right)\\,\\mathrm{d}x\\\\ &= \\int\\left(2x^{5}+x^{-4}-6x^{\\frac{-8}{7}}\\right)\\,\\mathrm{d}x\\\\ &= 2\\int x^{5}\\,\\mathrm{d}x+\\int x^{-4}\\,\\mathrm{d}x-6\\int x^{\\frac{-8}{7}}\\,\\mathrm{d}x\\\\ &= 2\\left(\\frac{x^{5+1}}{(5+1)}\\right)+\\left(\\frac{x^{-4+1}}{(-4+1)}\\right)\\\\ &\\quad -6\\left(\\frac{x^{\\frac{-8}{7}+1}}{(\\frac{-8}{7}+1)}\\right)+C\\\\ &= \\frac{x^{6}}{3}-\\frac{1}{3x^{3}}+\\frac{42}{\\sqrt[7]{x}}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186671042 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e7b2b6a-34b4-5d4a-b3aa-0efa636c0588" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{35}{\\sqrt[7]{x}}+\\frac{4}{x}+\\frac{4x^{5}}{5}+C" :db/id #edb/ref 17592186671013} {:answer/id #uuid "319d2248-2ed0-56eb-9111-9417cab477d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{35}{6\\sqrt[7]{x}}+\\frac{4}{x}+\\frac{8x^{5}}{5}+C" :db/id #edb/ref 17592186671015} {:answer/id #uuid "a04f6a87-da6c-565b-b1ba-854831a2cbd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{35}{\\sqrt[7]{x}}+\\frac{8}{x}+\\frac{8x^{5}}{5}+C" :db/id #edb/ref 17592186671031} {:answer/id #uuid "accba725-f75c-53a5-bdd6-67102eb3cbe6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{35}{6\\sqrt[7]{x}}+\\frac{4}{x}+\\frac{4x^{5}}{5}+C" :db/id #edb/ref 17592186671033} {:answer/id #uuid "ea42f4c2-e9cb-59f7-b5a9-d14f9efacf8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{35}{6\\sqrt[7]{x}}+\\frac{8}{x}+\\frac{8x^{5}}{5}+C" :db/id #edb/ref 17592186671039}] :answer-field/correct {:answer/id #uuid "0e7b2b6a-34b4-5d4a-b3aa-0efa636c0588" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{35}{\\sqrt[7]{x}}+\\frac{4}{x}+\\frac{4x^{5}}{5}+C" :db/id #edb/ref 17592186671013} :answer-field/id #uuid "a3fae9bb-8131-5df6-aad0-a2b85876eb60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671032}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f708cae3-deab-525d-82c5-7fe0627c8526" :question/problem "Find the antiderivative of\n$\\frac{5}{\\sqrt[7]{x^{8}}}-\\frac{4}{x^{2}}+4x^{4}.$ For real $x\\ne 0$." :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}& \\int\\left(\\frac{5}{\\sqrt[7]{x^{8}}}-\\frac{4}{x^{2}}+4x^{4}\\right)\\,\\mathrm{d}x\\\\ &= \\int\\left(5x^{\\frac{-8}{7}}-4x^{-2}+4x^{4}\\right)\\,\\mathrm{d}x\\\\ &= 5\\int x^{\\frac{-8}{7}}\\,\\mathrm{d}x-4\\int x^{-2}\\,\\mathrm{d}x+4\\int x^{4}\\,\\mathrm{d}x\\\\ &= 5\\left(\\frac{x^{\\frac{-8}{7}+1}}{(\\frac{-8}{7}+1)}\\right)-4\\left(\\frac{x^{-2+1}}{(-2+1)}\\right)\\\\ &\\quad +4\\left(\\frac{x^{4+1}}{(4+1)}\\right)+C\\\\ &= -\\frac{35}{\\sqrt[7]{x}}+\\frac{4}{x}+\\frac{4x^{5}}{5}+C.\\end{aligned}\n$$"}] :knowledge-point/title "Integrating Sums of Power Functions"}]}
