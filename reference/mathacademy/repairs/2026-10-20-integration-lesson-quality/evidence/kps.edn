#{[17592186184153 {:db/id #edb/ref 17592186184153 :knowledge-point/canonical-example {:db/id #edb/ref 17592186184057 :question/id #uuid "e4a94ca8-82ee-5776-a46d-b735d4ab60fb" :question/math-academy-id "e-371" :question/problem "Find the integral of $x^2 + 1.$" :question/worked-solution "Applying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int {x}^{2}+1\\,\\text{d}x & =\\int {x}^{2}\\,\\text{d}x+\\int 1\\,\\text{d}x \\\\  & =\\int {x}^{2}\\,\\text{d}x+\\int {x}^{0}\\,\\text{d}x \\\\  & =\\left(\\frac{{x}^{2+1}}{2+1}\\right)+x+C \\\\  & =\\frac{1}{3}{x}^{3}+x+C\\end{aligned}\n$$"} :knowledge-point/id #uuid "0db9b1c3-1e31-53f6-9fc2-1c611e2f9398" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049481}] :knowledge-point/question-generator {:db/id #edb/ref 17592186671073 :question-generator/id #uuid "2bf98aa3-ce30-5edd-a921-9a5264876ab0" :question-generator/script "generators/74/74aa54e20d62122bb901c8d6cef162bd0e42d6a05779b250b34fd5bcab5dcbf2/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186184549 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "874a75be-05b5-5213-a317-ac84d079a6f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{x^{3}}}{3} - 3x + C" :db/id #edb/ref 17592186181463} {:answer/id #uuid "b4254b4e-b369-5812-943b-4e67411913f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt[3]{x^{2}}}{2} - 3x" :db/id #edb/ref 17592186181464} {:answer/id #uuid "b8145e65-a4e6-55ed-84fd-bcbca085060c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x\\sqrt{x^{3}}}{2} - 3x + C" :db/id #edb/ref 17592186181465} {:answer/id #uuid "1f4f8890-7502-5e8c-90d6-f4aba9048241" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x\\sqrt[3]{x}}{3} + 3 + C" :db/id #edb/ref 17592186181466} {:answer/