db/id "answer-23cc018e-8ddd-51b5-8e96-cb9bc6b3c33d" :answer/id #uuid "23cc018e-8ddd-51b5-8e96-cb9bc6b3c33d" :answer/type :answer.type/math :answer/value "-3t+\\frac{6}{t}" :db/ensure :answer/validate} {:db/id "field-b056a03e-98bc-5fe9-a077-f828bb5d38f5" :answer-field/id #uuid "b056a03e-98bc-5fe9-a077-f828bb5d38f5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/choices ["answer-23cc018e-8ddd-51b5-8e96-cb9bc6b3c33d"] :answer-field/correct "answer-23cc018e-8ddd-51b5-8e96-cb9bc6b3c33d" :db/ensure :answer-field/validate} {:db/id "question-dfce6b77-8fb2-50ed-b415-ae0bec11b920" :question/id #uuid "dfce6b77-8fb2-50ed-b415-ae0bec11b920" :question/problem "Find the antiderivative:\n\n$\\displaystyle\\int \\frac{-3t^{3}-6t}{t^{3}}\\,\\mathrm{d}t=$\n{{field-1}}\n$+C$. Assume $t\\ne0$." :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $\\int t^p\\,\\mathrm{d}t=t^{p+1}/(p+1)+C$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int \\frac{-3t^{3}-6t}{t^{3}}\\,\\mathrm{d}t\\\\ &= \\int\\left(-3-\\frac{6}{t^{2}}\\right)\\,\\mathrm{d}t\\\\ &= -3\\int t^{0}\\,\\mathrm{d}t-6\\int t^{-2}\\,\\mathrm{d}t\\\\ &= -3\\left(\\frac{t^{1}}{1}\\right)-6\\left(\\frac{t^{-1}}{-1}\\right)+C\\\\ &= -3t+\\frac{6}{t}+C\\end{aligned}\n$$\n\nThe constant $C$ is already supplied outside the blank." :question/difficulty :question.difficulty/moderate :question/answer-fields ["field-b056a03e-98bc-5fe9-a077-f828bb5d38f5"] :db/ensure :question/validate} [:db/add 17592186184154 :knowledge-point/questions "question-dfce6b77-8fb2-50ed-b415-ae0bec11b920"] {:db/id "answer-fceec542-6546-51ec-b140-2d4712565ead" :answer/id #uuid "fceec542-6546-51ec-b140-2d4712565ead" :answer/type :answer.type/math :answer/value "\\frac{4\\sqrt{t^{5}}}{5}-2\\sqrt{t^{3}}+C" :db/ensure :answer/validate} {:db/id "answer-cf0ab17f-9adc-5d16-9376-69cd98bec0d1" :answer/id #uuid "cf0ab17f-9adc-5d16-9376-69cd98bec0d1" :answer/type :answer.type/ma