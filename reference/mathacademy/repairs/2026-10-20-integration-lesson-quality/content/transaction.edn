m{d}t\\\\ &= 4\\left(\\frac{t^{\\frac{5}{2}}}{\\frac{5}{2}}\\right)-2\\left(\\frac{t^{\\frac{3}{2}}}{\\frac{3}{2}}\\right)+C\\\\ &= \\frac{8\\sqrt{t^{5}}}{5}-\\frac{4\\sqrt{t^{3}}}{3}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["field-6e68bbd0-9d0d-57cb-8e25-f5b1b09a495e"] :db/ensure :question/validate} [:db/add 17592186184154 :knowledge-point/questions "question-5241f2d4-1d07-53bc-8e5b-a082d3e91f49"] {:db/id "answer-e89919f0-57d3-539f-8997-ae60e9705480" :answer/id #uuid "e89919f0-57d3-539f-8997-ae60e9705480" :answer/type :answer.type/math :answer/value "-\\frac{y^{4}}{4}-\\frac{2}{y}+C" :db/ensure :answer/validate} {:db/id "answer-8eebfe58-ff4d-5c8c-b6a8-2f095dfb403b" :answer/id #uuid "8eebfe58-ff4d-5c8c-b6a8-2f095dfb403b" :answer/type :answer.type/math :answer/value "-\\frac{y^{4}}{4}-\\frac{3}{y}+C" :db/ensure :answer/validate} {:db/id "answer-ae578435-9edd-53b8-bd2d-817f1a383bf9" :answer/id #uuid "ae578435-9edd-53b8-bd2d-817f1a383bf9" :answer/type :answer.type/math :answer/value "-\\frac{5y^{4}}{4}-\\frac{5}{y}+C" :db/ensure :answer/validate} {:db/id "answer-f3205476-4745-5d57-b898-cf65a514825f" :answer/id #uuid "f3205476-4745-5d57-b898-cf65a514825f" :answer/type :answer.type/math :answer/value "-\\frac{5y^{4}}{4}-\\frac{3}{y}+C" :db/ensure :answer/validate} {:db/id "answer-475a837e-b25f-521c-a4d4-3724a981611b" :answer/id #uuid "475a837e-b25f-521c-a4d4-3724a981611b" :answer/type :answer.type/math :answer/value "-\\frac{y^{4}}{2}-\\frac{5}{y}+C" :db/ensure :answer/validate} {:db/id "field-fbb08c7b-8a03-5203-a28d-c9908e61aa99" :answer-field/id #uuid "fbb08c7b-8a03-5203-a28d-c9908e61aa99" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["answer-e89919f0-57d3-539f-8997-ae60e9705480" "answer-8eebfe58-ff4d-5c8c-b6a8-2f095dfb403b" "answer-ae578435-9edd-53b8-bd2d-817f1a383bf9" "answer-f3205476-4745-5d57-b898-cf65a514825f" "answer-475a837e-b25f-521c-a4d4-3724a981611b"] :a