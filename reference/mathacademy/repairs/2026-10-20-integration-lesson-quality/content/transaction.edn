5d6f-ae8c-fbd7b24e32cc" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/choices ["answer-d9e7a3d4-2eaa-5c0c-b79e-bbb854b967f8"] :answer-field/correct "answer-d9e7a3d4-2eaa-5c0c-b79e-bbb854b967f8" :db/ensure :answer-field/validate} {:db/id "question-15374ade-be7d-56c6-9f1a-1fc3902b8289" :question/id #uuid "15374ade-be7d-56c6-9f1a-1fc3902b8289" :question/problem "Find the antiderivative:\n\n$\\displaystyle\\int \\frac{-4t^{2}+6}{t^{2}}\\,\\mathrm{d}t=$\n{{field-1}}\n$+C$. Assume $t\\ne0$." :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $\\int t^p\\,\\mathrm{d}t=t^{p+1}/(p+1)+C$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int \\frac{-4t^{2}+6}{t^{2}}\\,\\mathrm{d}t\\\\ &= \\int\\left(-4+\\frac{6}{t^{2}}\\right)\\,\\mathrm{d}t\\\\ &= -4\\int t^{0}\\,\\mathrm{d}t+6\\int t^{-2}\\,\\mathrm{d}t\\\\ &= -4\\left(\\frac{t^{1}}{1}\\right)+6\\left(\\frac{t^{-1}}{-1}\\right)+C\\\\ &= -4t-\\frac{6}{t}+C\\end{aligned}\n$$\n\nThe constant $C$ is already supplied outside the blank." :question/difficulty :question.difficulty/moderate :question/answer-fields ["field-e35fb1fe-a3f5-5d6f-ae8c-fbd7b24e32cc"] :db/ensure :question/validate} [:db/add 17592186184154 :knowledge-point/questions "question-15374ade-be7d-56c6-9f1a-1fc3902b8289"] [:db/cas 17592186670978 :question/retired nil true] [:db/cas 17592186670986 :question/retired nil true] [:db/cas 17592186670987 :question/retired nil true] [:db/cas 17592186670991 :question/retired nil true] [:db/cas 17592186670998 :question/retired nil true] [:db/ensure 17592186184154 :knowledge-point/validate] {:db/id "new-generator-17592186184155" :question-generator/id #uuid "40682b3a-6416-5537-b34d-388ad012ce9b" :question-generator/script "generators/4f/4f81abd9945ce23495c53bf796d33b55e84553e3bb3a30799d4a194131f1304e/generator.py"} [:db/cas 17592186184155 :knowledge-point/question-generator 17592186671044 "new-generator-17592186184155"] [:db/cas 17