b-f131-5357-a68a-f9c57d76df0c" :db/ensure :answer-field/validate} {:db/id "question-9bd10796-f3b1-5e70-8aec-1213f51f7042" :question/id #uuid "9bd10796-f3b1-5e70-8aec-1213f51f7042" :question/problem "Find the antiderivative:\n\n$\\displaystyle\\int -\\sqrt[4]{y}-y^{2}\\,\\mathrm{d}y=$\n{{field-1}}\n$+C$. Assume $y>0$." :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $\\int y^p\\,\\mathrm{d}y=y^{p+1}/(p+1)+C$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int -\\sqrt[4]{y}-y^{2}\\,\\mathrm{d}y\\\\ &= \\int\\left(-y^{\\frac{1}{4}}-y^{2}\\right)\\,\\mathrm{d}y\\\\ &= -\\int y^{\\frac{1}{4}}\\,\\mathrm{d}y-\\int y^{2}\\,\\mathrm{d}y\\\\ &= -\\left(\\frac{y^{\\frac{5}{4}}}{\\frac{5}{4}}\\right)-\\left(\\frac{y^{3}}{3}\\right)+C\\\\ &= -\\frac{4\\sqrt[4]{y^{5}}}{5}-\\frac{y^{3}}{3}+C\\end{aligned}\n$$\n\nThe constant $C$ is already supplied outside the blank." :question/difficulty :question.difficulty/hard :question/answer-fields ["field-2c268f5b-3612-51e6-bc9f-33c1abc72139"] :db/ensure :question/validate} [:db/add 17592186184153 :knowledge-point/questions "question-9bd10796-f3b1-5e70-8aec-1213f51f7042"] {:db/id "answer-16cbf031-ee8c-52cd-8a67-c5aea1d059b4" :answer/id #uuid "16cbf031-ee8c-52cd-8a67-c5aea1d059b4" :answer/type :answer.type/math :answer/value "\\frac{x^{5}}{5}+\\frac{4\\sqrt[4]{x^{5}}}{5}" :db/ensure :answer/validate} {:db/id "field-9f7d5053-5e8c-5528-b4af-1de337ea1944" :answer-field/id #uuid "9f7d5053-5e8c-5528-b4af-1de337ea1944" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/choices ["answer-16cbf031-ee8c-52cd-8a67-c5aea1d059b4"] :answer-field/correct "answer-16cbf031-ee8c-52cd-8a67-c5aea1d059b4" :db/ensure :answer-field/validate} {:db/id "question-2d53fad8-6be4-5f61-b97a-358bb1ede010" :question/id #uuid "2d53fad8-6be4-5f61-b97a-358bb1ede010" :question/problem "Find the antiderivative:\n\n$\\displaystyle\\int x^{4}+\\sqrt[4]{x}\\,\\mathrm{d}x=$\n{{field-1}}\n$+C$. Assume $x>0$." :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $\\int x^p\\,\\mathrm{d}x=x^{p+1}/(p+1)+C$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int x^{4}+\\sqrt[4]{x}\\,\\mathrm{d}x\\\\ &= \\int\\left(x^{4}+x^{\\frac{1}{4}}\\right)\\,\\mathrm{d}x\\\\ &= \\int x^{4}\\,\\mathrm{d}x+\\int x^{\\frac{1}{4}}\\,\\mathrm{d}x\\\\ &= \\left(\\frac{x^{5}}{5}\\right)+\\left(\\frac{x^{\\frac{5}{4}}}{\\frac{5}{4}}\\right)+C\\\\ &= \\frac{x^{5}}{5}+\\frac{4\\sqrt[4]{x^{5}}}{5}+C\\end{aligned}\n$$\n\nThe constant $C$ is already supplied outside the blank." :question/difficulty :question.difficulty/hard :question/answer-fields ["field-9f7d5053-5e8c-5528-b4af-1de337ea1944"] :db/ensure :question/validate} [:db/add 17592186184153 :knowledge-point/questions "question-2d53fad8-6be4-5f61-b97a-358bb1ede010"] {:db/id "answer-9efd7a2e-8395-52d9-a285-02c1147fc742" :answer/id #uuid "9efd7a2e-8395-52d9-a285-02c1147fc742" :answer/type :answer.type/math :answer/value "-\\frac{4\\sqrt[4]{x^{5}}}{5}-\\frac{x^{6}}{6}" :db/ensure :answer/validate} {:db/id "field-eeb94853-bd1d-5f61-9820-db479de88a73" :answer-field/id #uuid "eeb94853-bd1d-5f61-9820-db479de88a73" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/choices ["answer-9efd7a2e-8395-52d9-a285-02c1147fc742"] :answer-field/correct "answer-9efd7a2e-8395-52d9-a285-02c1147fc742" :db/ensure :answer-field/validate} {:db/id "question-3c7bf230-bb15-5c91-9b5d-59d6bbb6cba9" :question/id #uuid "3c7bf230-bb15-5c91-9b5d-59d6bbb6cba9" :question/problem "Find the antiderivative:\n\n$\\displaystyle\\int -\\sqrt[4]{x}-x^{5}\\,\\mathrm{d}x=$\n{{field-1}}\n$+C$. Assume $x>0$." :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $\\int x^p\\,\\mathrm{d}x=x^{p+1}/(p+1)+C$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int -\\sqrt[4]{x}-x^{5}\\,\\mathrm{d}x\\\\ &= \\int\\left(-x^{\\frac{1}{4