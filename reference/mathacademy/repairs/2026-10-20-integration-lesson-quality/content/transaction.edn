}\\right)-\\left(\\frac{t^{6}}{6}\\right)-4\\left(\\frac{t^{-3}}{-3}\\right)+C\\\\ &= -\\frac{7\\sqrt[7]{t^{12}}}{2}-\\frac{t^{6}}{6}+\\frac{4}{3t^{3}}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["field-70dc9d3f-c198-5f8c-9303-e25f8fe7daa8"] :db/ensure :question/validate} [:db/add 17592186184155 :knowledge-point/questions "question-7f07f7e3-50a5-5fcd-9095-66ebe0a82b9b"] {:db/id "answer-02bba3bd-a35f-5e91-b0d1-05a2f9726e1c" :answer/id #uuid "02bba3bd-a35f-5e91-b0d1-05a2f9726e1c" :answer/type :answer.type/math :answer/value "-\\frac{30}{\\sqrt[5]{t}}+\\frac{1}{t}+t^{5}+C" :db/ensure :answer/validate} {:db/id "answer-41d84ee9-b7ef-51bf-aff9-f954fc945a25" :answer/id #uuid "41d84ee9-b7ef-51bf-aff9-f954fc945a25" :answer/type :answer.type/math :answer/value "-\\frac{5}{\\sqrt[5]{t}}+\\frac{3}{t}+t^{5}+C" :db/ensure :answer/validate} {:db/id "answer-b7b2fb85-1a3f-528c-8bf6-25698aaa1097" :answer/id #uuid "b7b2fb85-1a3f-528c-8bf6-25698aaa1097" :answer/type :answer.type/math :answer/value "-\\frac{25}{\\sqrt[5]{t}}+\\frac{2}{t}+\\frac{2t^{5}}{5}+C" :db/ensure :answer/validate} {:db/id "answer-f37d23aa-c5a0-5318-94d6-661ebca9e781" :answer/id #uuid "f37d23aa-c5a0-5318-94d6-661ebca9e781" :answer/type :answer.type/math :answer/value "-\\frac{20}{\\sqrt[5]{t}}+\\frac{5}{t}+\\frac{4t^{5}}{5}+C" :db/ensure :answer/validate} {:db/id "answer-e20adc7b-12a2-58de-bd12-4a91fa1e15da" :answer/id #uuid "e20adc7b-12a2-58de-bd12-4a91fa1e15da" :answer/type :answer.type/math :answer/value "-\\frac{10}{\\sqrt[5]{t}}+\\frac{4}{t}+\\frac{6t^{5}}{5}+C" :db/ensure :answer/validate} {:db/id "field-d088ee88-76b3-53f6-9405-8ddf91d2cfa6" :answer-field/id #uuid "d088ee88-76b3-53f6-9405-8ddf91d2cfa6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["answer-02bba3bd-a35f-5e91-b0d1-05a2f9726e1c" "answer-41d84ee9-b7ef-51bf-aff9-f954fc945a25" "answer-b7b2fb85-1a3f-528c-8bf6-25698aaa1097" "answer-f37d23aa-c5a0-5318-9