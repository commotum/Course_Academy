-4eed-5154-bbe4-b8f67249eb92" :answer/type :answer.type/math :answer/value "x-\\frac{1}{7\\sqrt{x}}+C" :db/ensure :answer/validate} {:db/id "field-c56218cb-a14c-5b2b-bc7c-545644cceb18" :answer-field/id #uuid "c56218cb-a14c-5b2b-bc7c-545644cceb18" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["answer-948826a3-637b-557d-8b49-44ce8cba9898" "answer-9770dc89-2d46-54da-82e3-bfdb01ffe88e" "answer-b8005439-c9db-55dc-96a1-6312cdb72689" "answer-c8710973-a333-5d9e-9aae-f34b64113282" "answer-4bf7694d-4eed-5154-bbe4-b8f67249eb92"] :answer-field/correct "answer-9770dc89-2d46-54da-82e3-bfdb01ffe88e" :db/ensure :answer-field/validate} {:db/id "question-b1e8086a-2c48-594b-92ec-d3a3283ff1e1" :question/id #uuid "b1e8086a-2c48-594b-92ec-d3a3283ff1e1" :question/problem "Calculate $\\displaystyle\\int 1+\\frac{1}{\\sqrt{x^{3}}}\\,\\mathrm{d}x$. Assume $x>0$." :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $\\int x^p\\,\\mathrm{d}x=x^{p+1}/(p+1)+C$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int 1+\\frac{1}{\\sqrt{x^{3}}}\\,\\mathrm{d}x\\\\ &= \\int\\left(1+\\frac{1}{x^{\\frac{3}{2}}}\\right)\\,\\mathrm{d}x\\\\ &= \\int x^{0}\\,\\mathrm{d}x+\\int x^{-\\frac{3}{2}}\\,\\mathrm{d}x\\\\ &= \\left(\\frac{x^{1}}{1}\\right)+\\left(\\frac{x^{-\\frac{1}{2}}}{-\\frac{1}{2}}\\right)+C\\\\ &= x-\\frac{2}{\\sqrt{x}}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["field-c56218cb-a14c-5b2b-bc7c-545644cceb18"] :db/ensure :question/validate} [:db/add 17592186184153 :knowledge-point/questions "question-b1e8086a-2c48-594b-92ec-d3a3283ff1e1"] {:db/id "answer-bb02e8e2-e7b2-5f74-ba68-e2b5d8aac091" :answer/id #uuid "bb02e8e2-e7b2-5f74-ba68-e2b5d8aac091" :answer/type :answer.type/math :answer/value "\\frac{t^{7}}{7}-2t" :db/ensure :answer/validate} {:db/id "field-0ff4770c-9334-576f-987a-2411905b216e" :answer-field/id #uuid "0ff4770c-9334-576f-987a-2411905b216e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/choices ["answer-bb02e8e2-e7b2-5f74-ba68-e2b5d8aac091"] :answer-field/correct "answer-bb02e8e2-e7b2-5f74-ba68-e2b5d8aac091" :db/ensure :answer-field/validate} {:db/id "question-cd03c39d-36ff-57e6-8cc7-8339f387c296" :question/id #uuid "cd03c39d-36ff-57e6-8cc7-8339f387c296" :question/problem "Find the antiderivative:\n\n$\\displaystyle\\int t^{6}-2\\,\\mathrm{d}t=$\n{{field-1}}\n$+C$." :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $\\int t^p\\,\\mathrm{d}t=t^{p+1}/(p+1)+C$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int t^{6}-2\\,\\mathrm{d}t\\\\ &= \\int\\left(t^{6}-2\\right)\\,\\mathrm{d}t\\\\ &= \\int t^{6}\\,\\mathrm{d}t-2\\int t^{0}\\,\\mathrm{d}t\\\\ &= \\left(\\frac{t^{7}}{7}\\right)-2\\left(\\frac{t^{1}}{1}\\right)+C\\\\ &= \\frac{t^{7}}{7}-2t+C\\end{aligned}\n$$\n\nThe constant $C$ is already supplied outside the blank." :question/difficulty :question.difficulty/moderate :question/answer-fields ["field-0ff4770c-9334-576f-987a-2411905b216e"] :db/ensure :question/validate} [:db/add 17592186184153 :knowledge-point/questions "question-cd03c39d-36ff-57e6-8cc7-8339f387c296"] {:db/id "answer-cee45ab3-b6a7-55bd-81d7-91cc0f754b44" :answer/id #uuid "cee45ab3-b6a7-55bd-81d7-91cc0f754b44" :answer/type :answer.type/math :answer/value "4t-\\frac{t^{7}}{7}" :db/ensure :answer/validate} {:db/id "field-6da02c21-1f30-53c9-880d-0cfa7b47976c" :answer-field/id #uuid "6da02c21-1f30-53c9-880d-0cfa7b47976c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/choices ["answer-cee45ab3-b6a7-55bd-81d7-91cc0f754b44"] :answer-field/correct "answer-cee45ab3-b6a7-55bd-81d7-91cc0f754b44" :db/ensure :answer-field/validate} {:db/id "question-9214c456-0ded-5e8a-9e44-d24503d0acbe" :question/id #uuid "9214c456-0ded-5e8a-9e44-d24503d0acbe" :question/problem "Find the antiderivative:\n\n$\\displaystyle\\int 4-t^{6}\\,\\mathrm{d}t=$\n{{field-1}}\n$+C$." :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $\\int t^p\\,\\mathrm{d}t=t^{p+1}/(p+1)+C$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int 4-t^{6}\\,\\mathrm{d}t\\\\ &= \\int\\left(4-t^{6}\\right)\\,\\mathrm{d}t\\\\ &= 4\\int t^{0}\\,\\mathrm{d}t-\\int t^{6}\\,\\mathrm{d}t\\\\ &= 4\\left(\\frac{t^{1}}{1}\\right)-\\left(\\frac{t^{7}}{7}\\right)+C\\\\ &= 4t-\\frac{t^{7}}{7}+C\\end{aligned}\n$$\n\nThe constant $C$ is already supplied outside the blank." :question/difficulty :question.difficulty/moderate :question/answer-fields ["field-6da02c21-1f30-53c9-880d-0cfa7b47976c"] :db/ensure :question/validate} [:db/add 17592186184153 :knowledge-point/questions "question-9214c456-0ded-5e8a-9e44-d24503d0acbe"] {:db/id "answer-6eda08b9-529e-5f8a-a014-7e9ac76178b7" :answer/id #uuid "6eda08b9-529e-5f8a-a014-7e9ac76178b7" :answer/type :answer.type/math :answer/value "-4y-\\frac{4}{7\\sqrt{y}}+C" :db/ensure :answer/validate} {:db/id "answer-2d20d2d9-20db-5af8-9c24-0b2e8284a720" :answer/id #uuid "2d20d2d9-20db-5af8-9c24-0b2e8284a720" :answer/type :answer.type/math :answer/value "-4y-\\frac{2}{\\sqrt{y}}+C" :db/ensure :answer/validate} {:db/id "answer-e9b2a0c1-02b0-5988-8684-bb269fd1280c" :answer/id #uuid "e9b2a0c1-02b0-5988-8684-bb269fd1280c" :answer/type :answer.type/math :answer/value "-4y-\\frac{8}{\\sqrt{y}}+C" :db/ensure :answer/validate} {:db/id "answer-cf23446f-5660-5912-91d0-9e2509d3bfb8" :answer/id #uuid "cf23446f-5660-5912-91d0-9e2509d3bfb8" :answer/type :answer.type/math :answer/value "-4y-\\frac{3}{\\sqrt{y}}+C" :db/ensure :answer/validate} {:db/id "answer-bd1a38e2-847f-5bd5-890b-b7e9e0e5982e" :answer/id #uuid "bd1a38e2-847f-5bd5-890b-b7e9e0e5982e" :answer/type :answer.type/math :answer/value "-4y-\\frac{6}{11\\sqrt{y}}+C" :db/ensure :answer/validate} {:db/id "field-f1b15a85-8c1e-54d0-960f-1bade617bdcd" :answer-field/id #uuid "f1b15a85-8c1e-54d0-960