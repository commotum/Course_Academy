1}"] [17592186285279 :answer/value "{R}_{2}↔{R}_{1}"] [17592186285632 :answer/value "{R}_{2}↔{R}_{3}"] [17592186286086 :answer/value "{R}_{2}:={R}_{2}+(-1){R}_{1}"] [17592186287988 :question/problem "Given \n$$\nD=\\begin{bmatrix}1 & 3 & -1 \\\\ 0 & 4 & 3 \\\\ 3 & 2 & 2\\end{bmatrix}\n$$,\n which of the following elementary row operations makes ${a}_{31}=0?$"] [17592186287988 :question/worked-solution "Of the given options, we consider the row operation \n\n$$\n{R}_{3}:={R}_{3}+(-3){R}_{1}.\n$$\n\nApplying the above row operation, we obtain the following:\n\n$$\n\\begin{aligned}D & =\\begin{bmatrix}1 & 3 & -1 \\\\ 0 & 4 & 3 \\\\ 3 & 2 & 2\\end{bmatrix}\\,{R}_{3}:={R}_{3}+(-3)\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & -1 \\\\ 0 & 4 & 3 \\\\ 0 & -7 & 5\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nTherefore, the required row operation is\n\n$$\n{R}_{3}:={R}_{3}+(-3){R}_{1}.\n$$"] [17592186285473 :answer/value "{R}_{3}:={R}_{3}+(-2){R}_{1}"] [17592186285644 :answer/value "{R}_{3}:={R}_{3}+\\frac{1}{2}{R}_{1}"] [17592186285983 :answer/value "{R}_{3}↔{R}_{1}"] [17592186286112 :answer/value "{R}_{3}:={R}_{3}+(-3){R}_{1}"] [17592186286535 :answer/value "{R}_{3}:=\\frac{1}{3}{R}_{3}"] [17592186341880 :question/problem "Given that\n$$\nC=\\begin{bmatrix}2 & \\,-4 & \\,\\,-2 \\\\ 0 & \\,-1 & \\,4 \\\\ 2 & \\,2 & \\,1\\end{bmatrix}\n$$,\nwhich of the following elementary row operations makes ${a}_{33}=0?$"] [17592186341880 :question/worked-solution "Of the given options, we consider the row operation    \n\n$$\n{R}_{3}:={R}_{3}+\\frac{1}{2}{R}_{1}.\n$$\n\nApplying the above row operation, we obtain the following:\n\n$$\n\\begin{aligned}C & =\\begin{bmatrix}2 & \\,-4 & \\,\\,-2 \\\\ 0 & \\,-1 & \\,4 \\\\ 2 & \\,2 & \\,1\\end{bmatrix}\\,{R}_{3}:={R}_{3}+\\frac{1}{2}\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}2 & \\,-4 & \\,\\,-2 \\\\ 0 & \\,-1 & \\,4 \\\\ 3 & \\,0 & \\,0\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{3}:={R}_{3}+\\frac{1}{2}{R}_{1}.\n$$"] [17592186339145 :answer/value "{R}_{3}:={R}_{3}+(-2){R}_{1}"] [17592186339744 :answer/value "{R}_{3}:=(-1){R}_{3}"] [17592186339953 :answer/value "{R}_{3}:={R}_{3}+\\frac{1}{2}{R}_{1}"] [17592186340431 :answer/value "{R}_{3}:={R}_{3}+{R}_{1}"] [17592186341327 :answer/value "{R}_{3}↔{R}_{2}"] [17592186341881 :question/problem "Given that\n$$\nS=\\begin{bmatrix}1 & -1 & 1 \\\\ 3 & 2 & 1 \\\\ 1 & 1 & 3\\end{bmatrix}\n$$,\nwhich of the following elementary row operations makes ${a}_{33}=0?$"] [17592186341881 :question/worked-solution "Of the given options, we consider the row operation \n\n$$\n{R}_{3}:={R}_{3}-3{R}_{1}={R}_{3}+(-3)\\cdot {R}_{1}\n$$\n\nApplying the above row operation, we obtain the following:\n\n$$\n\\begin{aligned}S & =\\begin{bmatrix}1 & -1 & 1 \\\\ 3 & 2 & 1 \\\\ 1 & 1 & 3\\end{bmatrix}\\,{R}_{3}:={R}_{3}+(-3)\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 1 \\\\ 3 & 2 & 1 \\\\ -2 & 4 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the required row operation is \n\n$$\n{R}_{3}:={R}_{3}+(-3)\\cdot {R}_{1}\n$$\n\nor simply\n\n$$\n{R}_{3}:={R}_{3}-3{R}_{1}.\n$$"] [17592186339741 :answer/value "{R}_{3}:={R}_{3}-3{R}_{1}"] [17592186340019 :answer/value "{R}_{3}↔{R}_{1}"] [17592186340032 :answer/value "{R}_{3}↔{R}_{2}"] [17592186340112 :answer/value "{R}_{3}:={R}_{3}-2{R}_{2}"] [17592186340508 :answer/value "{R}_{3}:=\\frac{1}{3}{R}_{3}"] [17592186060941 :tutorial/content "Consider the following system of linear equations and its respective **augmented matrix**:\n\n$$\n\\left\\{\\begin{aligned}2x+6y &=-2 \\\\ 3x-y &=2\\end{aligned}\\right.\n$$\n\n$$\nM =\n\t\\left[\n\t\\begin{array}{cc|c}2 & 6 & -2 \\\\ 3 & -1 & 2\\end{array}\n\t\\right]\n$$\n\nIf we can convert the augmented matrix $M$ to row echelon form, then we can solve the system using back substitution.\n\nThe procedure for reducing $M$ to row echelon form using elementary row operations is called **Gaussian elimination**. To perform Gaussian elimination on a $2 \\times 2$ matrix, we use the following procedure.\n\n**Step 1:** Consider the entry $a_{11}=2$ of the coefficient matrix. This entry is called a **pivot element**. We want to make this entry equal to $1$. So, the first elementary row operation will be \n\n$$\nR_1 := \\dfrac{1}{2}R_1\n$$\n\nand we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}2 & 6 & -2 \\\\ 3 & -1 & 2\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & -1 \\\\ 3 & -1 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\n**Step 2:** Consider the entry $a_{21}=3$ below the first pivot element. We want to make this entry equal to $0$. So, the second elementary row operation will be \n\n$$\nR_2 :=R_2+(-3)R_1\n$$\n\nand we have\n\n$$\n\\begin{aligned} & ∼\\left[\\begin{array}{cc|c}{\\color{red}1} & 3 & -1 \\\\ {\\color{blue}3} & -1 & 2\\end{array}\\right] & {R}_{2}:={R}_{2}+({\\color{blue}-3}){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}{\\color{red}1} & 3 & -1 \\\\ {\\color{blue}0} & -10 & 5\\end{array}\\right].\\end{aligned}\n$$\n\n**Step 3:** Finally, consider the entry $a_{22}=-10$. This entry is the second pivot element, and we would like to make it equal to $1$. So, the third elementary row operation will be \n\n$$\nR_2 :=\\dfrac{1}{-10}R_2\n$$\n\nand we get $M$ in row echelon form:\n\n$$\n\\begin{aligned} & ∼\\left[\\begin{array}{cc|c}1 & 3 & -1 \\\\ 0 & {\\color{red}-10} & 5\\end{array}\\right] & {R}_{2}:=\\frac{1}{{\\color{red}-10}}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 3 & -1 \\\\ 0 & {\\color{red}1} & -\\frac{1}{2}\\end{array}\\right].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}x+3y &=-1 \\\\ y &=-\\frac{1}{2},\\end{aligned}\\right.\n$$\n\nand we can apply back substitution. The final equation $y=-\\dfrac{1}{2}$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx+3 \\left( -\\dfrac{1}{2} \\right) = -1 \n\t\\qquad\\Rightarrow\\qquad\n\tx=\\dfrac{1}{2}.\n$$\n\nTherefore, the solution is $x=\\dfrac{1}{2}$ and $y=-\\dfrac{1}{2}.$ Or, in vector form, $\\left< \\dfrac{1}{2}, -\\dfrac{1}{2} \\right>.$"] [17592186059584 :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=\n  \\left[\\begin{array}{cc|c}1 & 2 & 0 \\\\ 3 & -2 & -8\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then solve the linear system represented by the matrix."] [17592186059584 :question/worked-solution "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}1 & 2 & 0 \\\\ 3 & -2 & -8\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 2 & 0 \\\\ 0 & -8 & -8\\end{array}\\right] & {R}_{2} & :=-\\frac{1}{8}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 2 & 0 \\\\ 0 & 1 & 1\\end{array}\\right].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}x+2y &=0 \\\\ y &=1,\\end{aligned}\\right.\n$$\n\nand we can apply back substitution. The final equation $y=1$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx+2(1)=0 \n\t\\quad\\Rightarrow\\quad\n\tx=-2.\n$$\n\nTherefore, the solution is $x=-2$ and $y=1.$ Or, in vector form, $\\left<  -2,1 \\right>.$"] [17592186059965 :question/problem "Consider the augmented matrix $M$ given by\n$$\nM = \\left[\\begin{array}{cc|c}3 & -9 & -21 \\\\ 1 & 1 & 5\\end{array}\\right]\n$$.\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form."] [17592186056150 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -3 & -7 \\\\ 0 & 1 & 3\\end{array}\\right]"] [17592186056151 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -3 & -7 \\\\ 0 & 1 & 2\\end{array}\\right]"] [17592186056152 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -9 & -5 \\\\ 0 & 1 & 3\\end{array}\\right]"] [17592186056153 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -3 & -7 \\\\ 0 & 1 & 1\\end{array}\\right]"] [17592186056154 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -9 & -1 \\\\ 0 & 1 & 1\\end{array}\\right]"] [17592186059978 :question/problem "Consider the augmented matrix $M$ given by\n$$\nM = \\left[\\begin{array}{cc|c}1 & 4 & 3 \\\\ 2 & 9 & 5\\end{array}\\right]\n$$.\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then solve the linear system represented by the matrix."] [17592186056227 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 4 & 1 \\\\ 0 & 1 & -1\\end{array}\\right]\n$$,\n$x = 1$ and $y =-1$"] [17592186056228 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 4 & 2 \\\\ 0 & 1 & -1\\end{array}\\right]\n$$,\n$x = 1$ and $y =-1$"] [17592186056229 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 4 & 3 \\\\ 0 & 1 & 1\\end{array}\\right]\n$$,\n$x = 7$ and $y =-1$"] [17592186056230 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 4 & 3 \\\\ 0 & 1 & -1\\end{array}\\right]\n$$,\n$x = 7$ and $y =-1$"] [17592186056231 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 4 & 1 \\\\ 0 & 1 & 1\\end{array}\\right]\n$$,\n$x =-3$ and $y = 1$"] [17592186237988 :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=\\left[\\begin{array}{cc|c}2 & 3 & 7 \\\\ 3 & -2 & 4\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form."] [17592186237988 :question/worked-solution "Reducing $M$ to row echelon form using the standard algorithm for Gaussian elimination, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}2 & 3 & 7 \\\\ 3 & -2 & 4\\end{array}\\right] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{3}{2} & \\frac{7}{2} \\\\ 3 & -2 & 4\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{3}{2} & \\frac{7}{2} \\\\ 0 & -\\frac{13}{2} & -\\frac{13}{2}\\end{array}\\right] & {R}_{2} & :=-\\frac{2}{13}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{3}{2} & \\frac{7}{2} \\\\ 0 & 1 & 1\\end{array}\\right].\\end{aligned}\n$$"] [17592186235879 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -5 & -3 \\\\ 0 & 1 & 5\\end{array}\\right]"] [17592186235912 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{3}{2} & \\frac{7}{2} \\\\ 0 & 1 & 2\\end{array}\\right]"] [17592186236215 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{3}{2} & \\frac{7}{2} \\\\ 0 & 1 & 1\\end{array}\\right]"] [17592186236421 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 5 & -3 \\\\ 0 & 1 & 1\\end{array}\\right]"] [17592186237357 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{7}{2} & \\frac{3}{2} \\\\ 0 & 1 & 1\\end{array}\\right]"] [17592186241137 :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & 1 & 8 \\\\ -1 & -2 & 3\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then solve the linear system represented by the matrix."] [17592186241137 :question/worked-solution "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}1 & 1 & 8 \\\\ -1 & -2 & 3\\end{array}\\right] & {R}_{2} & :={R}_{2}+1\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 1 & 8 \\\\ 0 & -1 & 11\\end{array}\\right] & {R}_{2} & :=-1\\cdot {R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 1 & 8 \\\\ 0 & 1 & -11\\end{array}\\right].\\end{aligned}\n$$\n\nThe system is now\n\n$$\n\\left\\{\\begin{aligned}x+y &=8 \\\\ y &=-11,\\end{aligned}\\right.\n$$\n\nand we can apply back substitution. The final equation $y=-11$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx+(-11)=8\\,⇒\\,x=8+11=19.\n$$\n\nTherefore, the solution is $x=19$ and $y=-11.$"] [17592186238272 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 8 \\\\ 0 & 1 & 14\\end{array}\\right],\n$$\n$\\,x=13$ and $y=14$"] [17592186238893 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 8 \\\\ 0 & 1 & 13\\end{array}\\right],\n$$\n$\\,x=11$ and $y=13$"] [17592186239691 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 8 \\\\ 0 & 1 & -11\\end{array}\\right],\n$$\n$\\,x=19$ and $y=-11$"] [17592186239803 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 8 \\\\ 0 & 1 & -16\\end{array}\\right],\n$$\n$\\,x=17$ and $y=-16$"] [17592186240071 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 8 \\\\ 0 & 1 & 11\\end{array}\\right],\n$$\n$\\,x=10$ and $y=11$"] [17592186241149 :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=\\left[\\begin{array}{cc|c}-1 & 2 & 1 \\\\ 5 & 6 & 8\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form."] [17592186241149 :question/worked-solution "Reducing $M$ to row echelon form using the standard algorithm for Gaussian elimination, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}-1 & 2 & 1 \\\\ 5 & 6 & 8\\end{array}\\right] & {R}_{1} & :=-1\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & -1 \\\\ 5 & 6 & 8\\end{array}\\right] & {R}_{2} & :={R}_{2}-5\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & -1 \\\\ 0 & 16 & 13\\end{array}\\right] & {R}_{2} & :=\\frac{1}{16}\\cdot {R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & -1 \\\\ 0 & 1 & \\frac{13}{16}\\end{array}\\right].\\end{aligned}\n$$"] [17592186238587 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -2 & -1 \\\\ 0 & 1 & \\frac{11}{16}\\end{array}\\right]"] [17592186238598 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -2 & -1 \\\\ 0 & 1 & \\frac{13}{16}\\end{array}\\right]"] [17592186239014 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -2 & -1 \\\\ 0 & 1 & \\frac{15}{16}\\end{array}\\right]"] [17592186239668 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -2 & -1 \\\\ 0 & 1 & \\frac{17}{16}\\end{array}\\right]"] [17592186240258 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -2 & -1 \\\\ 0 & 1 & \\frac{9}{16}\\end{array}\\right]"] [17592186266010 :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & 7 & -2 \\\\ 2 & 10 & 0\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then solve the linear system represented by the matrix."] [17592186266010 :question/worked-solution "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}1 & 7 & -2 \\\\ 2 & 10 & 0\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 7 & -2 \\\\ 0 & -4 & 4\\end{array}\\right] & {R}_{2} & :=-\\frac{1}{4}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 7 & -2 \\\\ 0 & 1 & -1\\end{array}\\right].\\end{aligned}\n$$\n\nThe system is now\n\n$$\n\\left\\{\\begin{aligned}x+7y &=-2 \\\\ y &=-1,\\end{aligned}\\right.\n$$\n\nand we can apply back substitution. The final equation $y=-1$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx+7(-1)=-2\\,⇒\\,x=-2+7=5.\n$$\n\nTherefore, the solution is $x=5$ and $y=-1.$"] [17592186263066 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 7 & -1 \\\\ 0 & 1 & -2\\end{array}\\right],\n$$ $\\,x=12$ and $y=-2$"] [17592186263833 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 7 & -2 \\\\ 0 & 1 & -1\\end{array}\\right],\n$$ $\\,x=13$ and $y=-1$"] [17592186263915 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 7 & -1 \\\\ 0 & 1 & 1\\end{array}\\right],\n$$ $\\,x=15$ and $y=1$"] [17592186263968 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 7 & -2 \\\\ 0 & 1 & -1\\end{array}\\right],\n$$ $\\,x=5$ and $y=-1$"] [17592186264512 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 7 & -1 \\\\ 0 & 1 & 2\\end{array}\\right],\n$$ $\\,x=12$ and $y=2$"] [17592186287991 :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=\\left[\\begin{array}{cc|c}3 & -6 & 10 \\\\ 2 & -3 & 5\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then solve the linear system represented by the matrix."] [17592186287991 :question/worked-solution "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}3 & -6 & 10 \\\\ 2 & -3 & 5\\end{array}\\right] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & \\frac{10}{3} \\\\ 2 & -3 & 5\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & \\frac{10}{3} \\\\ 0 & 1 & -\\frac{5}{3}\\end{array}\\right].\\end{aligned}\n$$\n\nThe system is now\n\n$$\n\\left\\{\\begin{aligned}x-2y &=\\frac{10}{3} \\\\ y &=-\\frac{5}{3},\\end{aligned}\\right.\n$$\n\nand we can apply back substitution. The final equation $y=-\\frac{5}{3}$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx-2(-\\frac{5}{3})=\\frac{10}{3}\\,⇒\\,x=\\frac{10}{3}-\\frac{10}{3}=0.\n$$\n\nThus, the solution is $x=0$ and $y=-\\frac{5}{3}.$"] [17592186285062 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 2 & 4 \\\\ 0 & 1 & -3\\end{array}\\right],\n$$\n$\\,x=0$ and $y=\\frac{5}{3}$"] [17592186285447 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & -4 \\\\ 0 & 1 & \\frac{1}{3}\\end{array}\\right],\n$$\n$\\,x=-\\frac{5}{3}$ and $y=\\frac{1}{3}$"] [17592186285793 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & \\frac{10}{3} \\\\ 0 & 1 & -3\\end{array}\\right],\n$$\n$\\,x=-\\frac{8}{3}$ and $y=-3$"] [17592186286805 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & \\frac{10}{3} \\\\ 0 & 1 & -\\frac{5}{3}\\end{array}\\right],\n$$\n$\\,x=0$ and $y=-\\frac{5}{3}$"] [17592186286892 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & \\frac{10}{3} \\\\ 0 & 1 & \\frac{5}{3}\\end{array}\\right],\n$$\n$\\,x=\\frac{20}{3}$ and $y=\\frac{5}{3}$"] [17592186287992 :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=\\left[\\begin{array}{cc|c}2 & -6 & -9 \\\\ 1 & -2 & -4\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then solve the linear system represented by the matrix."] [17592186287992 :question/worked-solution "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}2 & -6 & -9 \\\\ 1 & -2 & -4\\end{array}\\right] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -3 & -\\frac{9}{2} \\\\ 1 & -2 & -4\\end{array}\\right] & {R}_{2} & :={R}_{2}-{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -3 & -\\frac{9}{2} \\\\ 0 & 1 & \\frac{1}{2}\\end{array}\\right].\\end{aligned}\n$$\n\nThe system is now\n\n$$\n\\left\\{\\begin{aligned}x-3y &=-\\frac{9}{2} \\\\ y &=\\frac{1}{2}\\end{aligned}\\right.\n$$\n\nand we can apply back substitution. The final equation $y=\\frac{1}{2}$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx-3(\\frac{1}{2})=-\\frac{9}{2}\\,⇒\\,x=-\\frac{9}{2}+\\frac{3}{2}=-3.\n$$\n\nThus, the solution is $x=-3$ and $y=\\frac{1}{2}.$"] [17592186285289 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 3 & -\\frac{9}{2} \\\\ 0 & 1 & -\\frac{17}{2}\\end{array}\\right],\n$$\n$\\,x=-1$ and $y=-\\frac{17}{2}$"] [17592186286019 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -3 & -\\frac{9}{2} \\\\ 0 & 1 & \\frac{1}{2}\\end{array}\\right],\n$$\n$\\,x=-3$ and $y=\\frac{1}{2}$"] [17592186286626 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -3 & \\frac{9}{2} \\\\ 0 & 1 & -\\frac{1}{2}\\end{array}\\right],\n$$\n$\\,x=3$ and $y=-\\frac{1}{2}$"] [17592186286761 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & -5 \\\\ 0 & 1 & \\frac{17}{2}\\end{array}\\right],\n$$\n$\\,x=\\frac{4}{2}$ and $y=\\frac{15}{2}$"] [17592186286951 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -3 & -3 \\\\ 0 & 1 & \\frac{9}{2}\\end{array}\\right],\n$$\n$\\,x=\\frac{1}{2}$ and $y=-\\frac{9}{2}$"] [17592186386127 :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=\\left[\\begin{array}{cc|c}3 & -2 & 4 \\\\ 6 & 4 & -8\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form."] [17592186386127 :question/worked-solution "Reducing $M$ to row echelon form using the standard algorithm for Gaussian elimination, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}3 & -2 & 4 \\\\ 6 & 4 & -8\\end{array}\\right] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 6 & 4 & -8\\end{array}\\right] & {R}_{2} & :={R}_{2}-6{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 8 & -16\\end{array}\\right] & {R}_{2} & :=\\frac{1}{8}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{array}\\right].\\end{aligned}\n$$"] [17592186386129 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{array}\\right]"] [17592186386130 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & 2\\end{array}\\right]"] [17592186386131 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 0 & 0 \\\\ 0 & 1 & -2\\end{array}\\right]"] [17592186386132 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -\\frac{4}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{array}\\right]"] [17592186386133 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -\\frac{4}{3} & \\frac{4}{3} \\\\ 0 & 1 & -1\\end{array}\\right]"] [17592186388195 :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=\\left[\\begin{array}{cc|c}2 & -8 & 6 \\\\ 3 & -7 & 4\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form."] [17592186388195 :question/worked-solution "Reducing $M$ to row echelon form using the standard algorithm for Gaussian elimination, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}2 & -8 & 6 \\\\ 3 & -7 & 4\\end{array}\\right] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -4 & 3 \\\\ 3 & -7 & 4\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -4 & 3 \\\\ 0 & 5 & -5\\end{array}\\right] & {R}_{2} & :=\\frac{1}{5}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -4 & 3 \\\\ 0 & 1 & -1\\end{array}\\right].\\end{aligned}\n$$"] [17592186388197 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -4 & 3 \\\\ 0 & 1 & 1\\end{array}\\right]"] [17592186388198 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -8 & 6 \\\\ 0 & 1 & -1\\end{array}\\right]"] [17592186388199 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 8 & -6 \\\\ 0 & 1 & 1\\end{array}\\right]"] [17592186388200 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -4 & 3 \\\\ 0 & 1 & -1\\end{array}\\right]"] [17592186388201 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 4 & -3 \\\\ 0 & 1 & -1\\end{array}\\right]"] [17592186528069 :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & 1 & 40 \\\\  -1 & -2 & 15\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then solve the linear system represented by the matrix."] [17592186528069 :question/worked-solution "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}1 & 1 & 40 \\\\  -1 & -2 & 15\\end{array}\\right] & {R}_{2} & :={R}_{2}+1\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 1 & 40 \\\\  0 & -1 & 55\\end{array}\\right] & {R}_{2} & :=-1\\cdot {R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 1 & 40 \\\\  0 & 1 & -55\\end{array}\\right].\\end{aligned}\n$$\n\nThe system is now\n\n$$\n\\left\\{\\begin{aligned}x+y &=40 \\\\ y &=-55,\\end{aligned}\\right.\n$$\n\nand we can apply back substitution. The final equation $y=-55$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx+(-55)=40\\,⇒\\,x=40+55=95.\n$$\n\nTherefore, the solution is $x=95$ and $y=-55.$"] [17592186528057 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 40 \\\\  0 & 1 & 70\\end{array}\\right],\n$$\n$\\,x=65$ and $y=70$"] [17592186528060 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 40 \\\\  0 & 1 & -80\\end{array}\\right],\n$$\n$\\,x=85$ and $y=-80$"] [17592186528064 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 40 \\\\  0 & 1 & 55\\end{array}\\right],\n$$\n$\\,x=50$ and $y=55$"] [17592186528066 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 40 \\\\  0 & 1 & 65\\end{array}\\right],\n$$\n$\\,x=55$ and $y=65$"] [17592186528067 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 40 \\\\  0 & 1 & -55\\end{array}\\right],\n$$\n$\\,x=95$ and $y=-55$"] [17592186528070 :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=\\left[\\begin{array}{cc|c}-1 & 2 & 3 \\\\  5 & 6 & 24\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form."] [17592186528070 :question/worked-solution "Reducing $M$ to row echelon form using the standard algorithm for Gaussian elimination, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}-1 & 2 & 3 \\\\  5 & 6 & 24\\end{array}\\right] & {R}_{1} & :=-1\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & -3 \\\\  5 & 6 & 24\\end{array}\\right] & {R}_{2} & :={R}_{2}-5\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & -3 \\\\  0 & 16 & 39\\end{array}\\right] & {R}_{2} & :=\\frac{1}{16}\\cdot {R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & -3 \\\\  0 & 1 & \\frac{39}{16}\\end{array}\\right].\\end{aligned}\n$$"] [17592186528052 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -2 & -3 \\\\  0 & 1 & \\frac{33}{16}\\end{array}\\right]"] [17592186528054 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -2 & -3 \\\\  0 & 1 & \\frac{51}{16}\\end{array}\\right]"] [17592186528056 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -2 & -3 \\\\  0 & 1 & \\frac{45}{16}\\end{array}\\right]"] [17592186528063 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -2 & -3 \\\\  0 & 1 & \\frac{39}{16}\\end{array}\\right]"] [17592186528065 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -2 & -3 \\\\  0 & 1 & \\frac{27}{16}\\end{array}\\right]"] [17592186528071 :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & 1 & 24 \\\\  -1 & -2 & 9\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then solve the linear system represented by the matrix."] [17592186528071 :question/worked-solution "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}1 & 1 & 24 \\\\  -1 & -2 & 9\\end{array}\\right] & {R}_{2} & :={R}_{2}+1\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 1 & 24 \\\\  0 & -1 & 33\\end{array}\\right] & {R}_{2} & :=-1\\cdot {R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 1 & 24 \\\\  0 & 1 & -33\\end{array}\\right].\\end{aligned}\n$$\n\nThe system is now\n\n$$\n\\left\\{\\begin{aligned}x+y &=24 \\\\ y &=-33,\\end{aligned}\\right.\n$$\n\nand we can apply back substitution. The final equation $y=-33$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx+(-33)=24\\,⇒\\,x=24+33=57.\n$$\n\nTherefore, the solution is $x=57$ and $y=-33.$"] [17592186528053 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 24 \\\\  0 & 1 & 33\\end{array}\\right],\n$$\n$\\,x=30$ and $y=33$"] [17592186528055 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 24 \\\\  0 & 1 & -33\\end{array}\\right],\n$$\n$\\,x=57$ and $y=-33$"] [17592186528058 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 24 \\\\  0 & 1 & -48\\end{array}\\right],\n$$\n$\\,x=51$ and $y=-48$"] [17592186528059 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 24 \\\\  0 & 1 & 42\\end{array}\\right],\n$$\n$\\,x=39$ and $y=42$"] [17592186528062 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 24 \\\\  0 & 1 & 39\\end{array}\\right],\n$$\n$\\,x=33$ and $y=39$"] [17592186060942 :tutorial/content "The row echelon form of a matrix is *not* unique. In the previous example, after the first row operation we arrived at \n\n$$\n\\left[\\begin{array}{cc|c}{\\color{red}1} & 3 & -1 \\\\ {\\color{blue}0} & {\\color{red}-10} & 5\\end{array}\\right].\n$$\n\nThis augmented matrix is already in row echelon form! However, it is always useful to do an extra step and obtain $1$'s along the main diagonal, like we did previously:\n\n$$\n\\left[\\begin{array}{cc|c}{\\color{red}1} & 3 & -1 \\\\ {\\color{blue}0} & {\\color{red}1} & -\\frac{1}{2}\\end{array}\\right]\n$$\n\nHaving $1$'s along the main diagonal makes the final back substitution process a little easier."] [17592186059585 :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}-x+5y &=5 \\\\ x-6y &=5.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system."] [17592186059585 :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\n\t\\left[\n\t\\begin{array}{cc|c}-1 & 5 & 5 \\\\ 1 & -6 & 5\\end{array}\n\t\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}-1 & 5 & 5 \\\\ 1 & -6 & 5\\end{array}\\right] & {R}_{1} & :=-{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -5 & -5 \\\\ 1 & -6 & 5\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -5 & -5 \\\\ 0 & -1 & 10\\end{array}\\right] & {R}_{2} & :=-{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -5 & -5 \\\\ 0 & 1 & -10\\end{array}\\right].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}x-5y &=-5 \\\\ y &=-10,\\end{aligned}\\right.\n$$\n\nand we can apply back substitution. The final equation $y=-10$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx-5(-10)=-5 \n\t\\quad\\Rightarrow\\quad\n\tx=-55.\n$$\n\nTherefore, the solution is $x=-55$ and $y=-10.$ Or, in vector form, $\\langle -55,-10 \\rangle.$"] [17592186059970 :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x-3y &=-8 \\\\ 2x+4y &=4.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system."] [17592186059970 :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & -3 & -8 \\\\ 2 & 4 & 4\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}1 & -3 & -8 \\\\ 2 & 4 & 4\\end{array}\\right] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -3 & -8 \\\\ 0 & 10 & 20\\end{array}\\right] & {R}_{2} & :=\\frac{1}{10}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -3 & -8 \\\\ 0 & 1 & 2\\end{array}\\right].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}x-3y &=-8 \\\\ y &=2,\\end{aligned}\\right.\n$$\n\nand we can apply back substitution. The final equation $y=2$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx-3(2)=-8\\,⇒\\,x=-2.\n$$\n\nTherefore, the solution is $x=-2$ and $y=2.$"] [17592186238787 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -3 & -8 \\\\ 0 & 1 & -2\\end{array}\\right],\n$$\n$\\,x=-4$ and $y=1$"] [17592186239148 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 0 & -8 \\\\ 0 & 1 & 2\\end{array}\\right],\n$$\n$\\,x=-8$ and $y=2$"] [17592186240208 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -3 & -8 \\\\ 0 & 1 & 2\\end{array}\\right],\n$$\n$\\,x=-2$ and $y=2$"] [17592186240213 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -3 & -8 \\\\ 0 & 1 & 1\\end{array}\\right],\n$$\n$\\,x=-4$ and $y=1$"] [17592186240309 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -3 & -8 \\\\ 0 & 1 & 5\\end{array}\\right],\n$$\n$\\,x=-2$ and $y=2$"] [17592186060205 :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+7y &=-5 \\\\ 7x+11y &=-4.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form."] [17592186060205 :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}2 & 7 & -5 \\\\ 7 & 11 & -4\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}2 & 7 & -5 \\\\ 7 & 11 & -4\\end{array}\\right] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{7}{2} & -\\frac{5}{2} \\\\ 7 & 11 & -4\\end{array}\\right] & {R}_{2} & :={R}_{2}-7{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{7}{2} & -\\frac{5}{2} \\\\ 0 & -\\frac{27}{2} & \\frac{27}{2}\\end{array}\\right] & {R}_{2} & :=-\\frac{2}{27}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{7}{2} & -\\frac{5}{2} \\\\ 0 & 1 & -1\\end{array}\\right].\\end{aligned}\n$$"] [17592186285671 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{7}{2} & -\\frac{5}{2} \\\\ 0 & 1 & -3\\end{array}\\right]"] [17592186286170 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 7 & -5 \\\\ 0 & 1 & -2\\end{array}\\right]"] [17592186286517 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{7}{2} & -\\frac{5}{2} \\\\ 0 & 1 & -1\\end{array}\\right]"] [17592186286718 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 7 & -5 \\\\ 0 & 1 & 0\\end{array}\\right]"] [17592186286971 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{7}{2} & -\\frac{5}{2} \\\\ 0 & 1 & 1\\end{array}\\right]"] [17592186287994 :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}3x+8y &=22 \\\\ 7x-5y &=4.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form."] [17592186287994 :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}3 & 8 & 22 \\\\ 7 & -5 & 4\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}3 & 8 & 22 \\\\ 7 & -5 & 4\\end{array}\\right] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{8}{3} & \\frac{22}{3} \\\\ 7 & -5 & 4\\end{array}\\right] & {R}_{2} & :={R}_{2}-7{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{8}{3} & \\frac{22}{3} \\\\ 0 & -\\frac{71}{3} & -\\frac{142}{3}\\end{array}\\right] & {R}_{2} & :=-\\frac{3}{71}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{8}{3} & \\frac{22}{3} \\\\ 0 & 1 & 2\\end{array}\\right].\\end{aligned}\n$$"] [17592186285038 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{8}{3} & \\frac{22}{3} \\\\ 0 & 1 & 0\\end{array}\\right]"] [17592186285438 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{8}{3} & \\frac{22}{3} \\\\ 0 & 1 & -1\\end{array}\\right]"] [17592186286195 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{8}{3} & \\frac{22}{3} \\\\ 0 & 1 & 3\\end{array}\\right]"] [17592186286223 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{8}{3} & \\frac{22}{3} \\\\ 0 & 1 & 2\\end{array}\\right]"] [17592186286571 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{8}{3} & \\frac{22}{3} \\\\ 0 & 1 & 1\\end{array}\\right]"] [17592186287995 :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x+\\frac{1}{3}y &=11 \\\\ 3x+\\frac{1}{5}y &=9.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system."] [17592186287995 :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & \\frac{1}{3} & 11 \\\\ 3 & \\frac{1}{5} & 9\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}1 & \\frac{1}{3} & 11 \\\\ 3 & \\frac{1}{5} & 9\\end{array}\\right] & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{1}{3} & 11 \\\\ 0 & -\\frac{4}{5} & -24\\end{array}\\right] & {R}_{2} & :=-\\frac{5}{4}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{1}{3} & 11 \\\\ 0 & 1 & 30\\end{array}\\right].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}x+\\frac{1}{3}y &=11 \\\\ y &=30,\\end{aligned}\\right.\n$$\n\nand we can apply back substitution. The final equation $y=30$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx+\\frac{1}{3}(30)=11\\,⇒\\,x=11-10=1.\n$$\n\nTherefore, the solution is $x=1$ and $y=30.$"] [17592186284851 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & \\frac{1}{3} & 11 \\\\ 0 & 1 & -3\\end{array}\\right],\n$$\n$\\,x=12$ and $y=-3$"] [17592186285992 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & \\frac{1}{3} & 11 \\\\ 0 & 1 & 6\\end{array}\\right],\n$$\n$\\,x=9$ and $y=6$"] [17592186286208 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & \\frac{1}{3} & 11 \\\\ 0 & 1 & 3\\end{array}\\right],\n$$\n$\\,x=10$ and $y=3$"] [17592186286934 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & \\frac{1}{3} & 11 \\\\ 0 & 1 & 30\\end{array}\\right],\n$$\n$\\,x=1$ and $y=30$"] [17592186286994 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & \\frac{1}{3} & 11 \\\\ 0 & 1 & 0\\end{array}\\right],\n$$\n$\\,x=11$ and $y=0$"] [17592186342013 :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}4x+12y &=-4 \\\\ 5x+11y &=3.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form."] [17592186342013 :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}4 & 12 & -4 \\\\ 5 & 11 & 3\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}4 & 12 & -4 \\\\ 5 & 11 & 3\\end{array}\\right] & {R}_{1} & :=\\frac{1}{4}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 3 & -1 \\\\ 5 & 11 & 3\\end{array}\\right] & {R}_{2} & :={R}_{2}-5{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 3 & -1 \\\\ 0 & -4 & 8\\end{array}\\right] & {R}_{2} & :=-\\frac{1}{4}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 3 & -1 \\\\ 0 & 1 & -2\\end{array}\\right].\\end{aligned}\n$$"] [17592186339149 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 3 & -1 \\\\ 0 & 1 & -2\\end{array}\\right]"] [17592186339677 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 3 & -1 \\\\ 0 & 1 & 1\\end{array}\\right]"] [17592186340461 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 3 & -1 \\\\ 0 & 1 & 2\\end{array}\\right]"] [17592186340499 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 3 & -1 \\\\ 0 & 1 & -1\\end{array}\\right]"] [17592186341077 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 3 & -1 \\\\ 0 & 1 & -4\\end{array}\\right]"] [17592186388202 :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}3x+5y &=-6 \\\\ -6x-6y &=10.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form."] [17592186388202 :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}3 & 5 & -6 \\\\ -6 & -6 & 10\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}3 & 5 & -6 \\\\ -6 & -6 & 10\\end{array}\\right] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{5}{3} & -2 \\\\ -6 & -6 & 10\\end{array}\\right] & {R}_{2} & :={R}_{2}+6{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{5}{3} & -2 \\\\ 0 & 4 & -2\\end{array}\\right] & {R}_{2} & :=\\frac{1}{4}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{5}{3} & -2 \\\\ 0 & 1 & -\\frac{1}{2}\\end{array}\\right].\\end{aligned}\n$$"] [17592186388204 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{5}{3} & 2 \\\\ 0 & 1 & \\frac{1}{2}\\end{array}\\right]"] [17592186388205 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 5 & -2 \\\\ 0 & 1 & -1\\end{array}\\right]"] [17592186388206 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{5}{3} & -1 \\\\ 0 & 1 & \\frac{1}{2}\\end{array}\\right]"] [17592186388207 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{5}{3} & -2 \\\\ 0 & 1 & -\\frac{1}{2}\\end{array}\\right]"] [17592186388208 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 3 & -2 \\\\ 0 & 1 & -2\\end{array}\\right]"] [17592186393299 :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}3x-2y &=4 \\\\ 2x-y &=2.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form."] [17592186393299 :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}3 & -2 & 4 \\\\ 2 & -1 & 2\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}3 & -2 & 4 \\\\ 2 & -1 & 2\\end{array}\\right] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 2 & -1 & 2\\end{array}\\right] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & \\frac{1}{3} & -\\frac{2}{3}\\end{array}\\right] & {R}_{2} & :=3{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{array}\\right].\\end{aligned}\n$$"] [17592186393301 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{array}\\right]"] [17592186393302 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -\\frac{3}{2}\\end{array}\\right]"] [17592186393303 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & 2\\end{array}\\right]"] [17592186393304 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & \\frac{3}{2}\\end{array}\\right]"] [17592186393305 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -3\\end{array}\\right]"] [17592186393306 :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-4y &=6 \\\\ 4x-7y &=10.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system."] [17592186393306 :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}2 & -4 & 6 \\\\ 4 & -7 & 10\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}2 & -4 & 6 \\\\ 4 & -7 & 10\\end{array}\\right] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ 4 & -7 & 10\\end{array}\\right] & {R}_{2} & :={R}_{2}-4{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ 0 & 1 & -2\\end{array}\\right].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}x-2y &=3 \\\\ y &=-2,\\end{aligned}\\right.\n$$\n\nand we can apply back substitution. The final equation $y=-2$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx-2(-2)=3\\,⇒\\,x=-1.\n$$\n\nThus, the solution is $x=-1$ and $y=-2.$"] [17592186393308 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ 0 & 1 & -1\\end{array}\\right],\n$$\n$\\,x=1$ and $y=-1$"] [17592186393309 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ 0 & 1 & -2\\end{array}\\right],\n$$\n$\\,x=-1$ and $y=-2$"] [17592186393310 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ 0 & 1 & -4\\end{array}\\right],\n$$\n$\\,x=-5$ and $y=-4$"] [17592186393311 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ 0 & 1 & 2\\end{array}\\right],\n$$\n$\\,x=7$ and $y=2$"] [17592186393312 :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ 0 & 1 & 4\\end{array}\\right],\n$$\n$\\,x=11$ and $y=4$"] [17592186393313 :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}5x-15y &=10 \\\\ 2x-4y &=4.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form."] [17592186393313 :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}5 & -15 & 10 \\\\ 2 & -4 & 4\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}5 & -15 & 10 \\\\ 2 & -4 & 4\\end{array}\\right] & {R}_{1} & :=\\frac{1}{5}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -3 & 2 \\\\ 2 & -4 & 4\\end{array}\\right] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -3 & 2 \\\\ 0 & 2 & 0\\end{array}\\right] & {R}_{2} & :=\\frac{1}{2}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -3 & 2 \\\\ 0 & 1 & 0\\end{array}\\right].\\end{aligned}\n$$"] [17592186393315 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ 0 & 1 & 4\\end{array}\\right]"] [17592186393316 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -3 & 2 \\\\ 0 & 1 & 0\\end{array}\\right]"] [17592186393317 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -3 & 2 \\\\ 0 & 1 & 4\\end{array}\\right]"] [17592186393318 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -3 & 2 \\\\ 0 & 1 & -1\\end{array}\\right]"] [17592186393319 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -3 & -2 \\\\ 0 & 1 & 1\\end{array}\\right]"] [17592186414018 :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-8y &=10 \\\\ 3x-7y &=5.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form."] [17592186414018 :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}2 & -8 & 10 \\\\ 3 & -7 & 5\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}2 & -8 & 10 \\\\ 3 & -7 & 5\\end{array}\\right] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -4 & 5 \\\\ 3 & -7 & 5\\end{array}\\right] & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -4 & 5 \\\\ 0 & 5 & -10\\end{array}\\right] & {R}_{2} & :=\\frac{1}{5}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -4 & 5 \\\\ 0 & 1 & -2\\end{array}\\right].\\end{aligned}\n$$"] [17592186414012 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -4 & 5 \\\\ 0 & 1 & 4\\end{array}\\right]"] [17592186414013 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -4 & 5 \\\\ 0 & 1 & -2\\end{array}\\right]"] [17592186414014 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -4 & 5 \\\\ 0 & 1 & 2\\end{array}\\right]"] [17592186414015 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -4 & 5 \\\\ 0 & 1 & -4\\end{array}\\right]"] [17592186414016 :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -4 & 5 \\\\ 0 & 1 & 1\\end{array}\\right]"] [17592186097840 :tutorial/content "Suppose we want to solve the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}x+2y+z &=1 \\\\ y-z &=2 \\\\ z &=3\\end{aligned}\\right.\n$$\n\nThe augmented matrix for this system can be written as \n\n$$\nM =\n\t\\left[\n\t\\begin{array}{ccc|c}{\\color{red}1} & 2 & 1 & 1 \\\\ {\\color{blue}0} & {\\color{red}1} & -1 & 2 \\\\ {\\color{blue}0} & {\\color{blue}0} & {\\color{red}1} & 3\\end{array}\n\t\\right].\n$$\n\nNotice that the matrix is in *row echelon form* (or REF). Whenever the augmented matrix is in row echelon form, we can solve the system using a method called **back substitution**.\n\nBack substitution involves\n\n- starting with the lowest equation (which is already solved for one variable),\n\n- substituting the result into the next-lowest equation to find the solution for another variable, and\n\n- continuing to substitute the result into the next-lowest equation until the values of all the variables have been found.\n\nHere, the third equation states that $z=3.$ Substituting this into the second equation, we get\n\n$$\ny -(3) = 2 \n\t\\qquad\\Longrightarrow\\qquad\n\ty = 5.\n$$\n\nNow, we substitute both $y=5$ and $z=3$ into the first equation to get\n\n$$\nx + 2(5) + (3) = 1\n\t\\qquad\\Longrightarrow\\qquad\n\tx = -12.\n$$\n\nTherefore, the solution is $x=-12,$ $y=5,$ and $z=3.$ We can write it in vector form, as follows:\n\n$$\n\\left\\langle -12,5,3 \\right\\rangle = \n\t\\begin{bmatrix}-12 \\\\ 5 \\\\ 3\\end{bmatrix}\n$$\n\n**Note:** The values $x=-12,$ $y=5,$ and $z=3$ together form *one* solution. We say that this system has *one* solution, *not* three solutions. A system with three solutions would have three different solution vectors, whereas here, we only have *one* solution vector."] [17592186096456 :question/problem "Solve the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}x+y+z &=3 \\\\ y+z &=2 \\\\ z &=2\\end{aligned}\\right.\n$$\n\n"] [17592186096456 :question/worked-solution "The third equation states that $z=2.$ Substituting this into the second equation, we get\n\n$$\ny+(2)=2 \n\t\\qquad\\Longrightarrow\\qquad\n\ty = 2-2 = 0.\n$$\n\nNow, we substitute both $z=2$ and $y=0$ into the first equation to get\n\n$$\nx+(0)+(2)=3\n\t\\qquad\\Longrightarrow\\qquad\n\tx = 3-2 = 1.\n$$\n\nTherefore, the solution is $x = 1,$ $y=0,$ and $z = 2.$ Or, in vector form, the solution is $\\langle 1,0,2 \\rangle.$"] [17592186097178 :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2}-{x}_{3} &=3 \\\\ {x}_{2}-{x}_{3} &=\\frac{1}{2} \\\\ {x}_{3} &=2\\end{aligned}\\right.\n$$"] [17592186097178 :question/worked-solution "The third equation states that ${x}_{3}=2.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}-(2)=\\frac{1}{2}\\,⟹\\,{x}_{2}=\\frac{1}{2}+2=\\frac{5}{2}.\n$$\n\nNow, we substitute ${x}_{2}=\\frac{5}{2}$ and ${x}_{3}=2$ into the first equation to get\n\n$$\n{x}_{1}+(\\frac{5}{2})-(2)=3\\,⟹\\,{x}_{1}=3+2-\\frac{5}{2}=\\frac{5}{2}.\n$$\n\nTherefore, the solution is ${x}_{1}=\\frac{5}{2}$, ${x}_{2}=\\frac{5}{2}$, and ${x}_{3}=2.$ In vector form, the solution can be written as $⟨\\frac{5}{2},\\frac{5}{2},2⟩.$"] [17592186285754 :answer/value "⟨\\frac{5}{2},1,\\frac{5}{2}⟩"] [17592186285832 :answer/value "⟨-\\frac{1}{2},\\frac{1}{2},2⟩"] [17592186286005 :answer/value "⟨\\frac{1}{2},\\frac{3}{2},2⟩"] [17592186286651 :answer/value "⟨\\frac{1}{2},2,-\\frac{3}{2}⟩"] [17592186286872 :answer/value "⟨\\frac{5}{2},\\frac{5}{2},2⟩"] [17592186097182 :question/problem "Solve the following system of equations:\n$\\left\\{\\begin{aligned}x_{1} + 3x_{2} - 2x_{3} &=-5 \\\\ x_{2} - x_{3} &=\\frac{3}{2} \\\\ x_{3} &=-4\\end{aligned}\\right.$"] [17592186095066 :answer/value "\\begin{bmatrix}-\\frac{13}{2} \\\\ -\\frac{1}{2} \\\\ -4\\end{bmatrix}"] [17592186095067 :answer/value "\\begin{bmatrix}\\frac{11}{2} \\\\ \\frac{5}{2} \\\\ -4\\end{bmatrix}"] [17592186095068 :answer/value "\\begin{bmatrix}-\\frac{11}{2} \\\\ -\\frac{5}{2} \\\\ -4\\end{bmatrix}"] [17592186095069 :answer/value "\\begin{bmatrix}-\\frac{17}{2} \\\\ -\\frac{1}{2} \\\\ -4\\end{bmatrix}"] [17592186095070 :answer/value "\\begin{bmatrix}-\\frac{15}{2} \\\\ -\\frac{1}{3} \\\\ -4\\end{bmatrix}"] [17592186237857 :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}x+y+z &=\\frac{1}{2} \\\\ y+z &=1 \\\\ z &=2\\end{aligned}\\right.\n$$"] [17592186237857 :question/worked-solution "The third equation states that  $z=2.$ Substituting this into the second equation, we get \n\n$$\ny+2=1\\,⟹\\,y=1-2=-1.\n$$\n\nNow, we substitute $z=2$ and $y=-1$into the first equation to get\n\n$$\nx+(-1)+(2)=\\frac{1}{2}\\,⟹\\,x=\\frac{1}{2}-2+1=-\\frac{1}{2}.\n$$\n\nTherefore, the solution is $x=-\\frac{1}{2}$, $y=-1$, and $z=2.$ In vector form, the solution can be written as $⟨-\\frac{1}{2},-1,2⟩.$"] [17592186235851 :answer/value "⟨-\\frac{3}{2},1,2⟩"] [17592186236461 :answer/value "⟨-\\frac{3}{2},-1,2⟩"] [17592186236998 :answer/value "⟨-\\frac{1}{2},-1,2⟩"] [17592186237293 :answer/value "⟨\\frac{3}{2},1,2⟩"] [17592186237311 :answer/value "⟨\\frac{1}{2},-1,2⟩"] [17592186237858 :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2}+{x}_{3} &=1 \\\\ {x}_{2}-{x}_{3} &=-1 \\\\ {x}_{3} &=3\\end{aligned}\\right.\n$$"] [17592186237858 :question/worked-solution "The third equation states that ${x}_{3}=3.$ Substitute this into the second equation to get\n\n$$\n{x}_{2}-(3)=-1\\,⟹\\,{x}_{2}=-1+3=2.\n$$\n\nNow, we substitute ${x}_{3}=3$ and ${x}_{2}=2$ into the first equation to get\n\n$$\n{x}_{1}-(2)+(3)=1\\,⟹\\,{x}_{1}=1-3+2=0.\n$$\n\nTherefore, the solution is ${x}_{1}=0$,  ${x}_{2}=2$, and ${x}_{3}=3.$ In vector form, the solution can be written as $⟨0,2,3⟩.$"] [17592186236236 :answer/value "⟨1,-3,2⟩"] [17592186236413 :answer/value "⟨0,2,3⟩"] [17592186236525 :answer/value "⟨1,-3,0⟩"] [17592186237405 :answer/value "⟨1,3,2⟩"] [17592186237432 :answer/value "⟨0,3,-2⟩"] [17592186237860 :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}x-y-z &=4 \\\\ y+2z &=2 \\\\ z &=\\frac{1}{2}\\end{aligned}\\right.\n$$"] [17592186237860 :question/worked-solution "he third equation states that  $z=\\frac{1}{2}.$ Substituting this into the second equation, we get\n\n$$\ny+2(\\frac{1}{2})=2\\,⟹\\,y=2-1=1.\n$$\n\nNow, we substitute $z=\\frac{1}{2}$ and $y=1$ into the first equation to get\n\n$$\nx-(1)-(\\frac{1}{2})=4\\,⟹\\,x=4+1+\\frac{1}{2}=\\frac{11}{2}.\n$$\n\nTherefore, the solution is $x=\\frac{11}{2}$,  $y=1$, and $z=\\frac{1}{2}.$  In vector form, the solution can be written as $⟨\\frac{11}{2},1,\\frac{1}{2}⟩.$"] [17592186236242 :answer/value "⟨\\frac{11}{2},1,\\frac{1}{2}⟩"] [17592186236315 :answer/value "⟨\\frac{9}{2},1,2⟩"] [17592186236415 :answer/value "⟨\\frac{9}{2},2,\\frac{1}{2}⟩"] [17592186236596 :answer/value "⟨1,\\frac{9}{2},-\\frac{1}{2}⟩"] [17592186237088 :answer/value "⟨\\frac{1}{2},-1,2⟩"] [17592186237861 :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2}+3{x}_{3} &=9 \\\\ {x}_{2}-3{x}_{3} &=2 \\\\ {x}_{3} &=\\frac{1}{3}\\end{aligned}\\right.\n$$"] [17592186237861 :question/worked-solution "The third equation states that  ${x}_{3}=\\frac{1}{3}.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}-3(\\frac{1}{3})=2\\,⟹\\,{x}_{2}=2+1=3.\n$$\n\nNow, we substitute ${x}_{3}=\\frac{1}{3}$ and ${x}_{2}=3$ into the first equation to get\n\n$$\n{x}_{1}-(3)+3(\\frac{1}{3})=9\\,⟹\\,{x}_{1}=9+3-1=11.\n$$\n\nTherefore, the solution is ${x}_{1}=11$, ${x}_{2}=3$, and ${x}_{3}=\\frac{1}{3}.$ In vector form, the solution can be written as $⟨11,3,\\frac{1}{3}⟩.$"] [17592186235859 :answer/value "⟨12,-3,\\frac{1}{3}⟩"] [17592186236299 :answer/value "⟨9,-3,\\frac{1}{3}⟩"] [17592186236494 :answer/value "⟨11,3,\\frac{1}{3}⟩"] [17592186236922 :answer/value "⟨9,2,\\frac{1}{3}⟩"] [17592186237139 :answer/value "⟨11,3,3⟩"] [17592186237863 :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}x-y-z &=3 \\\\ y-z &=2 \\\\ z &=1\\end{aligned}\\right.\n$$"] [17592186237863 :question/worked-solution "The third equation states that $z=1.$ Substituting this into the second equation, we get\n\n$$\ny-(1)=2\\,⟹\\,y=2+1=3.\n$$\n\nNow, we substitute $z=1$ and $y=3$ into the first equation to get\n\n$$\nx-(3)-(1)=3\\,⟹\\,x=3+4=7.\n$$\n\nThus, the solution is $x=7$,  $y=3$,  and $z=1.$ In vector form, the solution can be written as $⟨7,3,1⟩.$"] [17592186236034 :answer/value "⟨6,2,1⟩"] [17592186236234 :answer/value "⟨5,3,-1⟩"] [17592186236757 :answer/value "⟨7,3,1⟩"] [17592186236868 :answer/value "⟨5,2,0⟩"] [17592186236985 :answer/value "⟨7,-2,-1⟩"] [17592186265729 :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-2{x}_{2}+{x}_{3} &=2 \\\\ {x}_{2}+{x}_{3} &=-\\frac{1}{2} \\\\ {x}_{3} &=-1\\end{aligned}\\right.\n$$"] [17592186265729 :question/worked-solution "The third equation states that ${x}_{3}=-1.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}+(-1)=-\\frac{1}{2}\\,⟹\\,{x}_{2}=-\\frac{1}{2}+1=\\frac{1}{2}.\n$$\n\nNow, we substitute ${x}_{2}=\\frac{1}{2}$ and ${x}_{3}=-1$ into the first equation to get\n\n$$\n{x}_{1}-2(\\frac{1}{2})+(-1)=2\\,⟹\\,{x}_{1}=2+1+1=4.\n$$\n\nTherefore, the solution is ${x}_{1}=4$, ${x}_{2}=\\frac{1}{2}$, and ${x}_{3}=-1.$ In vector form, the solution can be written as $⟨4,\\frac{1}{2},-1⟩.$"] [17592186263657 :answer/value "⟨4,\\frac{1}{2},-1⟩"] [17592186263724 :answer/value "⟨2,\\frac{1}{2},-1⟩"] [17592186263896 :answer/value "⟨2,-\\frac{1}{2},-1⟩"] [17592186264544 :answer/value "⟨4,-\\frac{1}{2},-1⟩"] [17592186265173 :answer/value "⟨0,-\\frac{3}{2},-1⟩"] [17592186265730 :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}x+y-z &=2 \\\\ y-z &=\\frac{1}{2} \\\\ z &=3\\end{aligned}\\right.\n$$"] [17592186265730 :question/worked-solution "The third equation states that $z=3.$ Substituting this into the second equation, we get\n\n$$\ny-3=\\frac{1}{2}\\,⟹\\,y=\\frac{1}{2}+3=\\frac{7}{2}.\n$$\n\nNow, we substitute $y=\\frac{7}{2}$ and $z=3$ into the first equation to get\n\n$$\nx+\\frac{7}{2}-3=2\\,⟹\\,x=2-\\frac{7}{2}+3=\\frac{3}{2}.\n$$\n\nTherefore, the solution is $x=\\frac{3}{2}$, $y=\\frac{7}{2}$, and $z=3.$ In vector form, the solution can be written as\n$$\n\\begin{bmatrix}\\frac{3}{2} \\\\ \\frac{7}{2} \\\\ 3\\end{bmatrix}.\n$$"] [17592186263173 :answer/value "\\begin{bmatrix}\\frac{15}{2} \\\\ \\frac{5}{2} \\\\ 3\\end{bmatrix}"] [17592186263191 :answer/value "\\begin{bmatrix}\\frac{5}{2} \\\\ \\frac{5}{2