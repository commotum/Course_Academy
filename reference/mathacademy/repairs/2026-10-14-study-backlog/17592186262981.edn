{:db/id #edb/ref 17592186262981 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c239318-c519-564e-9b9a-e139f72f8f78" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186260411} {:answer/id #uuid "468b071c-0cb3-5c13-9682-0ab2aad7f341" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186260488} {:answer/id #uuid "5d51d084-098f-5c25-b542-7dd4cb9796d6" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186260677} {:answer/id #uuid "99080321-dcc6-5050-8ec8-d811be91b2fd" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186261202} {:answer/id #uuid "d758891e-4e28-5d10-8986-f3d38b3df342" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186261771}] :answer-field/correct {:db/id #edb/ref 17592186260677} :answer-field/id #uuid "2781fc89-e025-58de-9c74-16ba53c0ecca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262196}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "03af429b-e04f-5720-9b8e-95f1a130559b" :question/math-academy-id "q-129204" :question/problem "What is the sum of the leading entries of the $1$st, $2$nd, and $3$rd rows in the matrix $A,$ given below?\n\n$$\nA=\\begin{bmatrix}0 & -3 & 0 & 4 \\\\ 0 & 0 & 5 & 2 \\\\ 2 & -1 & 0 & 7 \\\\ 0 & 1 & 0 & 1\\end{bmatrix}\n$$" :question/worked-solution "The first non-zero entry of each row (from left to right) is the leading entry. \n\nTherefore, the leading entries of the $1$st, $2$nd, and $3$rd rows of $A$ are $-3$, $5$, and $2$, respectively.\n\n$$\nA=\\begin{bmatrix}0 & -3 & 0 & 4 \\\\ 0 & 0 & 5 & 2 \\\\ 2 & -1 & 0 & 7 \\\\ 0 & 1 & 0 & 1\\end{bmatrix}\n$$\n\nSo, the answer is $-3+5+2=4.$"}
