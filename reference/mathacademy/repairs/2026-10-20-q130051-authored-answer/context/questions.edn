#{[{:db/id #edb/ref 17592186166654 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166816 :knowledge-point/id #uuid "74510348-04f1-570b-b3f7-5fcb1ed1beef" :knowledge-point/title "Computing a Probability at a Point"}] :question/id #uuid "fba5b411-86fe-5d2f-85ee-87cfa1e96d83" :question/math-academy-id "e-8465" :question/problem "Given $X \\sim \\textrm{Po}(4)$, compute $P(X = 2)$, rounded to $4$ decimal places." :question/worked-solution "If $X \\sim \\textrm{Po}(\\lambda)$, then $X$ has the following probability mass function:\n\n$$\nf(x) = \\dfrac{\\lambda^x e^{-\\lambda}}{x!}\n$$\n\nHere, $X \\sim \\textrm{Po}(4)$, so the distribution of $X$ in this case is\n\n$$\nf(x) = \\dfrac{4^x e^{-4}}{x!}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nP(X = 2) &= f(2) \\\\\n&= \\frac{4^{2}e^{-4}}{2!} \\\\\n&\\approx 0.1465\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186670463 :knowledge-point/_questions [{:db/id #edb/ref 17592186166816 :knowledge-point/id #uuid "74510348-04f1-570b-b3f7-5fcb1ed1beef" :knowledge-point/title "Computing a Probability at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2df4c844-fa64-5ffb-bf2f-20d32f4045de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0501" :db/id #edb/ref 17592186670398} {:answer/id #uuid "3f12f7fe-2842-59fd-9972-d7eaaa457c98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0223" :db/id #edb/ref 17592186670403} {:answer/id #uuid "92041c52-6d1a-5884-a530-db5bd12d1433" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0216" :db/id #edb/ref 17592186670419} {:answer/id #uuid "c2063ee0-43c6-5e6e-814c-3d83f702e518" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1321" :db/id #edb/ref 17592186670427} {:answer/id #uuid "d51f2e3b-5862-59df-a943-5e2f59625754" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/mat