#{[{:db/id #edb/ref 17592186166654 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166816 :knowledge-point/id #uuid "74510348-04f1-570b-b3f7-5fcb1ed1beef" :knowledge-point/title "Computing a Probability at a Point"}] :question/id #uuid "fba5b411-86fe-5d2f-85ee-87cfa1e96d83" :question/math-academy-id "e-8465" :question/problem "Given $X \\sim \\textrm{Po}(4)$, compute $P(X = 2)$, rounded to $4$ decimal places." :question/worked-solution "If $X \\sim \\textrm{Po}(\\lambda)$, then $X$ has the following probability mass function:\n\n$$\nf(x) = \\dfrac{\\lambda^x e^{-\\lambda}}{x!}\n$$\n\nHere, $X \\sim \\textrm{Po}(4)$, so the distribution of $X$ in this case is\n\n$$\nf(x) = \\dfrac{4^x e^{-4}}{x!}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nP(X = 2) &= f(2) \\\\\n&= \\frac{4^{2}e^{-4}}{2!} \\\\\n&\\approx 0.1465\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186166655 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166817 :knowledge-point/id #uuid "540361c1-5d4e-5b88-a295-f606f5518f38" :knowledge-point/title "Computing a Probability Over a Bounded Interval: Lower Bound is Zero"}] :question/id #uuid "62d1e798-9a57-5657-9a6d-8fb70bff0ccd" :question/math-academy-id "e-8466" :question/problem "Given $X \\sim \\textrm{Po}(5)$, compute $P(X < 3)$, rounded to $4$ decimal places." :question/worked-solution "If $X \\sim \\textrm{Po}(\\lambda)$, then $X$ has the following probability mass function:\n\n$$\nf(x) = \\dfrac{\\lambda^x e^{-\\lambda}}{x!}\n$$\n\nHere, $X \\sim \\textrm{Po}(5)$, so the probability distribution of $X$ in this case is\n\n$$\nf(x) = \\dfrac{5^x e^{-5}}{x!}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nP(X < 3) &= P(X ∈ {0, 1, 2}) \\\\\n&= P(X = 0) + P(X = 1) + P(X = 2) \\\\\n&= f(0) + f(1) + f(2) \\\\\n&= \\frac{5^{0}e^{-5}}{0!} + \\frac{5^{1}e^{-5}}{1!} + \\frac{5^{2}e^{-5}}{2!} \\\\\n&\\approx 0.1247\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186166656 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166818 :knowledge-point/id #uuid "21835800-1a05-56c1-a5ee-b8c2e1df2273" :knowledge-point/title "Computing a Probability Over a Bounded Interval: Lower Bound is Not Zero"}] :question/id #uuid "c89b3081-38d7-5430-b912-82f84ef532ec" :question/math-academy-id "e-8467" :question/problem "Given $X \\sim \\textrm{Po}(3)$, compute $P(2 < X < 5)$, rounded to $4$ decimal places." :question/worked-solution "If $X \\sim \\textrm{Po}(\\lambda)$, then $X$ has the following probability mass function:\n\n$$\nf(x) = \\dfrac{\\lambda^x e^{-\\lambda}}{x!}\n$$\n\nHere, $X \\sim \\textrm{Po}(3)$, so the probability distribution of $X$ in this case is\n\n$$\nf(x) = \\dfrac{3^x e^{-3}}{x!}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nP(2 < X < 5) &= P(X ∈ {3, 4}) \\\\\n&= P(X = 3) + P(X = 4) \\\\\n&= f(3) + f(4) \\\\\n&= \\frac{3^{3}e^{-3}}{3!} + \\frac{3^{4}e^{-3}}{4!} \\\\\n&\\approx 0.3921\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186166657 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166819 :knowledge-point/id #uuid "e6219a2a-8c28-57c1-a4ad-0ede62529376" :knowledge-point/title "Computing a Probability Over an Unbounded Interval Using the Complement"}] :question/id #uuid "d1e693a2-073f-5f8c-98fd-3b89496521d5" :question/math-academy-id "e-8468" :question/problem "Given $X \\sim \\textrm{Po}(3)$, compute $P(X > 2)$, rounded to $4$ decimal places." :question/worked-solution "If $X \\sim \\textrm{Po}(\\lambda)$, then $X$ has the following probability mass function:\n\n$$\nf(x) = \\dfrac{\\lambda^x e^{-\\lambda}}{x!}\n$$\n\nHere, $X \\sim \\textrm{Po}(3)$, so the probability distribution of $X$ in this case is\n\n$$\nf(x) = \\dfrac{3^x e^{-3}}{x!}\n$$\n\nThere are infinitely many values of $X$ such that $X > 2$. However, we can simplify the computation by using the complement instead:\n\n$$\n\\begin{aligned}\nP(X > 2) &= 1 - P(X \\le 2)\n\\end{aligned}\n$$\n\nComputing the complement, we get\n\n$$\n\\begin{aligned}\nP(X \\le 2) &= P(X ∈ {0, 1, 2}) \\\\\n&= P(X = 0) + P(X = 1) + P(X = 2) \\\\\n&= f(0) + f(1) + f(2) \\\\\n&= \\frac{3^{0}e^{-3}}{0!} + \\frac{3^{1}e^{-3}}{1!} + \\frac{3^{2}e^{-3}}{2!} \\\\\n&\\approx 0.4232\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nP(X > 2) &= 1 - P(X \\le 2) \\\\\n&\\approx 1 - 0.4232 \\\\\n&= 0.5768\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186670576 :knowledge-point/_questions [{:db/id #edb/ref 17592186166816 :knowledge-point/id #uuid "74510348-04f1-570b-b3f7-5fcb1ed1beef" :knowledge-point/title "Computing a Probability at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dde700a-0e55-51d0-92f2-5c0a07c0e9d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1238" :db/id #edb/ref 17592186670571} {:answer/id #uuid "879db768-c381-5881-858d-0d6eb1fc601f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0538" :db/id #edb/ref 17592186670572} {:answer/id #uuid "b11bfe5e-7018-5a3c-b899-196857870f0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0738" :db/id #edb/ref 17592186670573} {:answer/id #uuid "d62040ab-94d8-5dde-852b-33a6c04b4cea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2014" :db/id #edb/ref 17592186670574} {:answer/id #uuid "fc0fc65d-c4fa-59e8-a527-50e58626c120" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0712" :db/id #edb/ref 17592186670575}] :answer-field/correct {:answer/id #uuid "b11bfe5e-7018-5a3c-b899-196857870f0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0738" :db/id #edb/ref 17592186670573} :answer-field/id #uuid "e0acaaa5-2cd5-585e-9e7b-5ecd5fab47c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186670577}] :question/id #uuid "79136801-f86f-533a-ba93-0b693465d2cb" :question/math-academy-id "q-130051" :question/problem "Given $X∼\\text{Po}(1.1),$ compute $P(X=3),$ rounded to $4$ decimal places." :question/worked-solution "If $X\\sim\\operatorname{Po}(\\lambda)$, then its probability mass function is\n\n$$\nf(x)=\\frac{\\lambda^x e^{-\\lambda}}{x!}.\n$$\n\nHere $\\lambda=1.1$, so\n\n$$\nf(x)=\\frac{1.1^x e^{-1.1}}{x!}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nP(X=3)&=f(3)\\\\\n&=\\frac{1.1^3e^{-1.1}}{3!}\\\\\n&\\approx 0.0738425664.\n\\end{aligned}\n$$\n\nRounded to four decimal places, the answer is $0.0738$."}]}
