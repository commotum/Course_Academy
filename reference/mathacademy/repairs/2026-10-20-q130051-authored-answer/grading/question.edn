#{[{:db/id #edb/ref 17592186670576 :knowledge-point/_questions [{:db/id #edb/ref 17592186166816 :knowledge-point/id #uuid "74510348-04f1-570b-b3f7-5fcb1ed1beef" :knowledge-point/title "Computing a Probability at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dde700a-0e55-51d0-92f2-5c0a07c0e9d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1238" :db/id #edb/ref 17592186670571} {:answer/id #uuid "879db768-c381-5881-858d-0d6eb1fc601f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0538" :db/id #edb/ref 17592186670572} {:answer/id #uuid "b11bfe5e-7018-5a3c-b899-196857870f0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0738" :db/id #edb/ref 17592186670573} {:answer/id #uuid "d62040ab-94d8-5dde-852b-33a6c04b4cea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2014" :db/id #edb/ref 17592186670574} {:answer/id #uuid "fc0fc65d-c4fa-59e8-a527-50e58626c120" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0712" :db/id #edb/ref 17592186670575}] :answer-field/correct {:answer/id #uuid "b11bfe5e-7018-5a3c-b899-196857870f0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0738" :db/id #edb/ref 17592186670573} :answer-field/id #uuid "e0acaaa5-2cd5-585e-9e7b-5ecd5fab47c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186670577}] :question/id #uuid "79136801-f86f-533a-ba93-0b693465d2cb" :question/math-academy-id "q-130051" :question/problem "Given $X∼\\text{Po}(1.1),$ compute $P(X=3),$ rounded to $4$ decimal places." :question/worked-solution "If $X\\sim\\operatorname{Po}(\\lambda)$, then its probability mass function is\n\n$$\nf(x)=\\frac{\\lambda^x e^{-\\lambda}}{x!}.\n$$\n\nHere $\\lambda=1.1$, so\n\n$$\nf(x)=\\frac{1.1^x e^{-1.1}}{x!}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nP(X=3)&=f(3)\\\\\n&=\\frac{1.1^3e^{-1.1}}{3!}\\\\\n&\\approx 0.0738425664.\n\\end{aligned}\n$$\n\nRounded to four decimal places, the answer is $0.0738$."} #edb/ref 17592186049358]}
