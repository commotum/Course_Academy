17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299483}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1a2a0ad5-fa96-5318-8c8b-b0ce250183f8" :question/math-academy-id "q-318606" :question/problem "Find $Nz$ if\n$N=\\begin{bmatrix}-8 & 1 & 2 \\\\ 3 & -6 & 5 \\\\ 4 & 2 & 7\\end{bmatrix}$\nand\n$z=\\begin{bmatrix}3 \\\\ -4 \\\\ 2\\end{bmatrix}.$\n\n|  |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n| $Nz=\\,\\,$ |  | {{field-2}} |  |\n|  |  | {{field-3}} |  |" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product:\n\n$$\n\\begin{aligned}Nz & =\\begin{bmatrix}-8 & 1 & 2 \\\\ 3 & -6 & 5 \\\\ 4 & 2 & 7\\end{bmatrix}\\begin{bmatrix}3 \\\\ -4 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\begin{aligned}(-8)\\cdot 3 & + & \\,\\,\\,\\,\\,\\,\\,1\\cdot (-4) & + & 2\\cdot 2 \\\\ 3\\cdot 3 & + & (-6)\\cdot (-4) & + & 5\\cdot 2 \\\\ 4\\cdot 3 & + & \\,\\,\\,\\,\\,\\,\\,2\\cdot (-4) & + & 7\\cdot 2\\end{aligned}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\begin{aligned}-24 & + & (-4) & + & 4 \\\\ 9 & + & \\,\\,\\,24 & + & 10 \\\\ 12 & + & (-8) & + & 14\\end{aligned}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-24 \\\\ 43 \\\\ 18\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299695 :knowledge-point/_questions [{:db/id #edb/ref 17592186100867 :knowledge-point/id #uuid "3beceaa9-f8b5-5b98-a4a3-2ececba067e0" :knowledge-point/title "Multiplying a 3x3 Matrix by a Column Vector" :topic/_knowledge-points [{:db/id #edb/ref 17592186050825 :topic/title "Multiplying a Matrix by a Column Vector"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8e7e8f5-84fb-5c87-976a-546106a837f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "46" :db/id #edb/ref 17592186298482}] :answer-field/correct {:answer/id #uuid "d8e7e8f5-84fb-5c87-976a-546106a837f4" :answer/type {:db/id #edb/ref 17592186