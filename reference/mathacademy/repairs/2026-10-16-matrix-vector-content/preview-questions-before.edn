egin{aligned}{a}^{2} & + & 0 & + & (-{a}^{2}) \\\\ {a}^{2} & + & 0 & + & (-{a}^{2}) \\\\ 0 & + & 0 & + & (-{a}^{2})\\end{aligned}\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 0 \\\\ -{a}^{2}\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299690 :knowledge-point/_questions [{:db/id #edb/ref 17592186100868 :knowledge-point/id #uuid "8451e22a-247e-51dd-8fb1-9ce9b212dc65" :knowledge-point/title "Multiplying a Matrix With Variable Entries by a Column Vector" :topic/_knowledge-points [{:db/id #edb/ref 17592186050825 :topic/title "Multiplying a Matrix by a Column Vector"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f775580-bd1b-5390-abe1-6a8b60bc1892" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298104}] :answer-field/correct {:answer/id #uuid "7f775580-bd1b-5390-abe1-6a8b60bc1892" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298104} :answer-field/id #uuid "3e171508-5fb8-5f4f-a3bf-f6d158daa1a7" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298851} {:answer-field/choices [{:answer/id #uuid "61aec282-a6bb-59cc-966b-37930d646322" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{b}^{2}" :db/id #edb/ref 17592186297967}] :answer-field/correct {:answer/id #uuid "61aec282-a6bb-59cc-966b-37930d646322" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{b}^{2}" :db/id #edb/ref 17592186297967} :answer-field/id #uuid "56360de5-23c1-5b08-9539-57daa80b33f9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298927} {:answer-field/choices [{:answer/id #uuid "70ca4ffe-45a8-589a-bcd3-8b9a340e9283" :answer/type {:db/id #edb/ref 17592186045498 :db/ident