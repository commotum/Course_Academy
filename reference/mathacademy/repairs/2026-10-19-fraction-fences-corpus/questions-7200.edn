}^{0}\\,(- 2 x^{2} y + 4 x y^{2} + 4 y^{3}) \\sqrt{(- 2 x + 2 y)^{2} + (2 x + 4 y)^{2} + 1}\\,\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186530699 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75d50c07-52e9-53af-ae4f-7c65062b2c45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{- x^{3} - x^{2} y + 2 x y^{2}}{\\sqrt{(- 2 x - y)^{2} + (- x + 4 y)^{2} + 1}}" :db/id #edb/ref 17592186530692} {:answer/id #uuid "8fa56657-0b7c-57cd-b3d4-53acf6a376c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- x^{3} - x^{2} y + 2 x y^{2}" :db/id #edb/ref 17592186530704} {:answer/id #uuid "a12c8347-2dc1-5d6b-8b0b-b2cf864f7062" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- x^{3} - x^{2} y + 2 x y^{2}) \\sqrt{(- 2 x - y)^{2} + (- x + 4 y)^{2} + 1}" :db/id #edb/ref 17592186530708} {:answer/id #uuid "bfea963c-7d6f-5d6a-839e-8c0a21277a95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- x^{3} - x^{2} y + 2 x y^{2}) ((- 2 x - y)^{2} + (- x + 4 y)^{2} + 1)" :db/id #edb/ref 17592186530716} {:answer/id #uuid "c205008f-927e-5b6e-87af-235f36a0af42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{(- 2 x - y)^{2} + (- x + 4 y)^{2}} (- x^{3} - x^{2} y + 2 x y^{2})" :db/id #edb/ref 17592186530717}] :answer-field/correct {:answer/id #uuid "a12c8347-2dc1-5d6b-8b0b-b2cf864f7062" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- x^{3} - x^{2} y + 2 x y^{2}) \\sqrt{(- 2 x - y)^{2} + (- x + 4 y)^{2} + 1}" :db/id #edb/ref 17592186530708} :answer-field/id #uuid "75785d57-a37f-567b-b726-adc808a7eda5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186530691}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "854069e0-c8d5-5b8c-a346-937c327ef16f" :question/problem "Consider the surface integral of the function $f(x,y,z)=x z,$ where the surface $S$ is defined by $z=- x^{2} - x y + 2 y^{2}$ for $-2\\le x\\le 0$ and $-1\\le y\\le 0.$\nThis surface integral can be written as a repeated integral, as shown below. \n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={\\int }_{-2}^{0}{\\int }_{-1}^{0}\\,\\boxed{}\\,\\,\\text{d}y\\,\\text{d}x\n$$\n\nWhat is the missing expression?" :question/worked-solution "For a surface $S$ defined by $z=g(x,y)$ with $(x,y)\\in D,$ the surface integral of a scalar function $f(x,y,z)$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A.\n$$\n\nFor the partial derivatives, we have\n\n$$\n\\frac{∂z}{∂x}=\\frac{∂}{∂x}(- x^{2} - x y + 2 y^{2})=- 2 x - y,\n$$\n\nand\n\n$$\n\\frac{∂z}{∂y}=\\frac{∂}{∂y}(- x^{2} - x y + 2 y^{2})=- x + 4 y.\n$$\n\nTherefore, the surface integral can be written as \n\n$$\n\\begin{aligned}{∬}_{S}f(x,y,z)\\,\\text{d}S & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+(- 2 x - y)^2+(- x + 4 y)^2}\\,\\text{d}A \\\\  & ={∬}_{D}\\,(x (- x^{2} - x y + 2 y^{2}))\\cdot (\\sqrt{(- 2 x - y)^{2} + (- x + 4 y)^{2} + 1})\\,\\text{d}A \\\\  & ={∬}_{D}\\,(- x^{3} - x^{2} y + 2 x y^{2})\\cdot (\\sqrt{(- 2 x - y)^{2} + (- x + 4 y)^{2} + 1})\\,\\text{d}A \\\\  & ={\\int }_{-2}^{0}{\\int }_{-1}^{0}\\,(- x^{3} - x^{2} y + 2 x y^{2}) \\sqrt{(- 2 x - y)^{2} + (- x + 4 y)^{2} + 1}\\,\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186530714 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50144386-43ca-57e8-a380-819e9700d02e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{(- 2 x - y)^{2} + (- x - 4 y)^{2}} (- x^{3} - x^{2} y - 2 x y^{2})" :d