2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+(4 x + y)^2+(x + 4 y)^2}\\,\\text{d}A \\\\  & ={∬}_{D}\\,(- 2 x (2 x^{2} + x y + 2 y^{2}))\\cdot (\\sqrt{(x + 4 y)^{2} + (4 x + y)^{2} + 1})\\,\\text{d}A \\\\  & ={∬}_{D}\\,(- 4 x^{3} - 2 x^{2} y - 4 x y^{2})\\cdot (\\sqrt{(x + 4 y)^{2} + (4 x + y)^{2} + 1})\\,\\text{d}A \\\\  & ={\\int }_{-2}^{-1}{\\int }_{0}^{1}\\,(- 4 x^{3} - 2 x^{2} y - 4 x y^{2}) \\sqrt{(x + 4 y)^{2} + (4 x + y)^{2} + 1}\\,\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186530695 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "158319bc-7d97-54a9-9c8c-00fa9f9f1131" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{- 2 x^{2} y + 4 x y^{2} + 4 y^{3}}{\\sqrt{(- 2 x + 2 y)^{2} + (2 x + 4 y)^{2} + 1}}" :db/id #edb/ref 17592186530664} {:answer/id #uuid "1f325e7a-fc7c-5e31-b18c-1ff7e58c9867" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- 2 x^{2} y + 4 x y^{2} + 4 y^{3}) ((- 2 x + 2 y)^{2} + (2 x + 4 y)^{2} + 1)" :db/id #edb/ref 17592186530669} {:answer/id #uuid "7b970496-f099-5df8-af2c-245bce78602c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 2 x^{2} y + 4 x y^{2} + 4 y^{3}" :db/id #edb/ref 17592186530694} {:answer/id #uuid "cdaf1f79-3b80-53cc-a7ff-ac2bee8a536a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{(- 2 x + 2 y)^{2} + (2 x + 4 y)^{2}} (- 2 x^{2} y + 4 x y^{2} + 4 y^{3})" :db/id #edb/ref 17592186530720} {:answer/id #uuid "ebefaff7-5fd7-553e-8174-a671c0226808" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- 2 x^{2} y + 4 x y^{2} + 4 y^{3}) \\sqrt{(- 2 x + 2 y)^{2} + (2 x + 4 y)^{2} + 1}" :db/id #edb/ref 17592186530729}] :answer-field/correct {:answer/id #uuid "ebefaff7-5fd7-553e-8174-a671c0226808" :answer/type {:db/id #edb/ref 17592186045498 :db/iden