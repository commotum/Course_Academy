/math} :answer/value "-1" :db/id #edb/ref 17592186274613}] :answer-field/correct {:answer/id #uuid "1fc0c999-23cd-5524-9da6-e53b356c1021" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186272667} :answer-field/id #uuid "33fc6641-fd7f-5c11-8ef6-f22d02c82fa3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274725}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "53588a2b-ad7c-5261-a3ca-c56ccdc03a42" :question/math-academy-id "q-149958" :question/problem "${lim}_{x\\to \\,-1/2}\\operatorname{tan}⁡(\\frac{1}{2}\\operatorname{arccos}⁡(x))=$" :question/worked-solution "![](images/9d/9dcc5a116c2a564547283783a7df7b1cd3a9ab3b76ac24dc2695c4cb367796d5.png)\n\nThe domain of $\\operatorname{arccos}⁡(x)$ is $x\\in [-1,1].$  \n\nNow, substituting $x=-\\frac{1}{2}$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,-1/2}\\operatorname{tan}⁡(\\frac{1}{2}\\operatorname{arccos}⁡(x)) & =\\operatorname{tan}⁡(\\frac{1}{2}\\operatorname{arccos}⁡(-\\frac{1}{2})) \\\\  & =\\operatorname{tan}⁡(\\frac{1}{2}\\cdot \\frac{2\\pi }{3}) \\\\  & =\\operatorname{tan}⁡(\\frac{\\pi }{3}) \\\\  & =\\sqrt{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184526 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c976821f-7963-5d8a-a26e-a2eb8811a5d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a = 3$ and $b = \\frac{π}{4}$" :db/id #edb/ref 17592186181333} {:answer/id #uuid "e5bcc9a9-e02d-5439-a772-eae44f0224a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a = 12$ and $b = π$" :db/id #edb/ref 17592186181334} {:answer/id #uuid "111116ea-fd6c-5428-863c-d679752773da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a =