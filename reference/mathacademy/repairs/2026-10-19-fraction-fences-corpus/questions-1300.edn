c{5}{2} )}} & x \\ge  0 , \\\\ 0 & \\text{otherwise}\\end{array} \\right.$ *where*\n$Γ(k) = \\displaystyle \\int_{0}^{∞}t^{k - 1}e^{-t}dt$\nis the gamma function.\n\n$M(t) =$\n{{field-1}}"} {:db/id #edb/ref 17592186176488 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f09e2b14-fc9e-5e7e-91fb-971867e6b30a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186175067} {:answer/id #uuid "fe88c386-2c4c-5185-8498-00c42fdbf43c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{81}" :db/id #edb/ref 17592186175068} {:answer/id #uuid "02397f5f-fd70-5544-9066-3965895f5952" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186175069} {:answer/id #uuid "70e5408e-e3ea-5ab0-9adf-85a367147f55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{17}{9}" :db/id #edb/ref 17592186175070} {:answer/id #uuid "7cb8e1ed-956d-52a5-b329-6513bcc4edc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{18}" :db/id #edb/ref 17592186175071}] :answer-field/correct {:answer/id #uuid "02397f5f-fd70-5544-9066-3965895f5952" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186175069} :answer-field/id #uuid "7871420e-7189-57c1-8e09-06273c4952cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186175066}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4f879269-f1bc-5470-bac8-9c8c52ea8a97" :question/math-academy-id "q-43275" :question/problem "${(\\frac{1}{9})}^{-2}=$" :question/worked-solution "We find the reciprocal of the base $(\\frac{1}{9}),$ and then raise that reciprocal to the same power but with the *opposite* sign $(+2),$ as follows:\n\n$$\n\\begin{aligned}{(\\frac{1}{9})}^{-2} & =(9)^{2} \\\\  & =9\\cdot 9 \\\\  & =81\\end{aligned}\n$$"} {:db/id #edb/ref 17592186176504 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5e5d0dd-37f3-5479-a5b8-93b9fc68cf2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v_{max} = 4m/s, t = 0s" :db/id #edb/ref 17592186175163} {:answer/id #uuid "2e1c1392-f604-5ed8-97ff-368c6f67ef3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v_{max} = 8m/s, t = 1s" :db/id #edb/ref 17592186175164} {:answer/id #uuid "37075f3d-a678-5beb-b2cc-d84d54203840" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v_{max} = 15m/s, t = 2s" :db/id #edb/ref 17592186175165} {:answer/id #uuid "64190c6e-a4df-50db-8eb8-922c7044d4c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v_{max} = 3m/s, t = 0s" :db/id #edb/ref 17592186175166} {:answer/id #uuid "68b379c5-dc0f-5212-8f00-c8d2be719f65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v_{max} = 6m/s, t = 1s" :db/id #edb/ref 17592186175167}] :answer-field/id #uuid "f3ab1e5e-16f1-5ba6-88a5-0953b9e8e307" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186175162} {:answer-field/choices [{:answer/id #uuid "5905bbab-f343-5609-8b0e-38652a6b3f1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{v}_{\\text{max}}=6\\,\\text{m}/\\text{s},\\,t=1\\,\\text{s}" :db/id #edb/ref 17592186366166} {:answer/id #uuid "fa68db26-bc83-5864-8550-ef8e0346e921" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{v}_{\\text{max}}=4\\,\\text{m}/\\text{s},\\,t=0\\,\\text{s}" :db/id #edb/ref 17592186366167} {:answer/id #uuid "9fd0d2eb-4483-5b6f-b5c6-2577f6da33f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{v}_{\\text{max}}=8\\,\\text{m}/\\text{s},\\,t=1\\,\\text{s}" :db/id #edb/ref 17592186366168} {:answer/id #uuid "ca92d80f-0f34-532a-aee8-98a4476c8c0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{v}_{\\text{max}}=3\\,\\text{m}/\\text{s},\\,t=0\\,\\text{s}" :db/id #edb/ref 17592186366169} {:answer/id #uuid "24cf4379-35c5-5006-9ca3-aca59fa1249a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{v}_{\\text{max}}=15\\,\\text{m}/\\text{s},\\,t=2\\,\\text{s}" :db/id #edb/ref 17592186366170}] :answer-field/correct {:answer/id #uuid "5905bbab-f343-5609-8b0e-38652a6b3f1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{v}_{\\text{max}}=6\\,\\text{m}/\\text{s},\\,t=1\\,\\text{s}" :db/id #edb/ref 17592186366166} :answer-field/id #uuid "3a52e5e5-5799-5706-b96a-0f62b512199d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366165}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9b920041-2237-57ab-bb83-307562d738dd" :question/math-academy-id "q-49951" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in $\\text{m}/{\\text{s}}^{2},$ given by the function $a(t)=3-3{t}^{2},$ where $t⩾0$ is the time in seconds. If the particle has velocity $v=2\\,\\text{m}/\\text{s}$ when $t=2\\,\\text{s},$ calculate the maximum velocity ${v}_{\\text{max}}$ of the particle and determine the time whan the particle reaches its maximum velocity." :question/worked-solution "The extrema of the velocity $v$ occur at the critical points of $v.$\n\nSince $\\frac{\\text{d}v}{\\text{d}t}=a(t),$ to find the times where $v$ is a maximum, we just need to solve $a(t)=0$ and test each solution using the first or second derivative test.\n\nSolving $a(t)=0$ gives\n\n$$\n\\begin{aligned}a(t) & =0 \\\\ 3-3{t}^{2} & =0 \\\\ 3(1-t)(1+t) & =0 \\\\ t & =\\pm 1.\\end{aligned}\n$$\n\nSince $t⩾0$, the extremum of the velocity function occurs when $t=1\\,\\text{s}.$\n\nWe now test the extreme value using the second derivative test. For this, we find the second derivative of $v(t)$ and evaluate it at $t=1:$\n\n$$\n\\begin{aligned}{v}^{″}(t) & =\\frac{{\\text{d}}^{2}v}{\\text{d}{t}^{2}} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{\\text{d}v}{\\text{d}t}) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(a(t)) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3-3{t}^{2}) \\\\  & =-6t \\\\ {v}^{″}(1) & =-6(1) \\\\  & =-6.\\end{aligned}\n$$\n\nSince ${v}^{″}(1)<0,$ we conclude that the velocity is maximized when $t=1\\,\\text{s}.$\n\nNow, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\text{d}t \\\\  & =\\int (3-3{t}^{2})\\text{d}t \\\\  & =3t-{t}^{3}+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(2)=2.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}3(2)-{2}^{3}+C & =2 \\\\ 6-8+C & =2\\,⟹\\,C=4.\\end{aligned}\n$$\n\nTherefore, the velocity $v$ of the particle at time $t$ is $v(t)=4+3t-{t}^{3}.$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{\\text{max}}=v(1)=4+3(1)-{1}^{3}=6\\,\\text{m}/\\text{s}\n$$"} {:db/id #edb/ref 17592186176510 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "814f7c9d-5e49-5f4e-b1de-405ba981c35c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186175199} {:answer/id #uuid "cdb8b45f-bf31-5954-9f4f-e885e74baf7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The series is divergent" :db/id #edb/ref 17592186175201} {:answer/id #uuid "5da6aadb-a542-5e5e-8757-2157556219f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186175202} {:answer/id #uuid "50ea6359-ff35-5d40-ae48-09e30c47874b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{4+\\pi }" :db/id #edb/ref 17592186538407} {:answer/id #uuid "aba32c7c-b27a-52b9-8eda-752f04c9f073" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186538635}] :answer-field/correct {:answer/id #uuid "814f7c9d-5e49-5f4e-b1de-405ba981c35c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186175199} :answer-field/id #uuid "c82a5a11-516b-565e-a445-ea24ede32e57" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186175198}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ad9b9f3f-7dff-5b1d-aff9-251f7b31c672" :question/math-academy-id "q-50935" :question/problem "What is the sum of the series $\\frac{\\pi }{4}-\\frac{(\\pi /4)^{3}}{3!}+\\frac{(\\pi /4)^{5}}{5!}-⋯+\\frac{(-1)^{n}(\\pi /4)^{2n+1}}{(2n+1)!}+⋯\\,?$" :question/worked-solution "We recognize that the series looks similar to the Maclaurin expansion for $f(x)=\\operatorname{sin}⁡x.$\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡x & =x-\\frac{{x}^{3}}{3!}+\\frac{{x}^{5}}{5!}-⋯+\\frac{(-1)^{n}{x}^{2n+1}}{(2n+1)!}+⋯\\end{aligned}\n$$\n\nSubstituting $x=\\frac{\\pi }{4}$ into our Maclaurin expansion gives\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\frac{\\pi }{4}) & =\\frac{\\pi }{4}-\\frac{(\\pi /4)^{3}}{3!}+\\frac{(\\pi /4)^{5}}{5!}-\\frac{(\\pi /4)^{7}}{7!}+⋯+\\frac{(-1)^{n}(\\pi /4)^{2n+1}}{(2n+1)!}+⋯ \\\\ \\frac{\\sqrt{2}}{2} & =\\frac{\\pi }{4}-\\frac{(\\pi /4)^{3}}{3!}+\\frac{(\\pi /4)^{5}}{5!}-\\frac{(\\pi /4)^{7}}{7!}+⋯+\\frac{(-1)^{n}(\\pi /4)^{2n+1}}{(2n+1)!}+⋯\\,.\\end{aligned}\n$$\n\nTherefore, the sum of the series is $\\frac{\\sqrt{2}}{2}.$"} {:db/id #edb/ref 17592186176566 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03b38fa5-e2f8-5372-a382-0d5bb64bbd9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t={e}^{-5/2},\\,v=-2{e}^{-5/2}" :db/id #edb/ref 17592186339152} {:answer/id #uuid "209d0a37-0a81-5483-8635-03397bb8470e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t={e}^{-1/2},\\,v=-2{e}^{-1/2}" :db/id #edb/ref 17592186339409} {:answer/id #uuid "87a01d45-b87c-5ccd-a67f-ee577703b877" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t={e}^{-3/2},\\,v=-{e}^{-3/2}" :db/id #edb/ref 17592186340342} {:answer/id #uuid "8fc8c54e-c65f-5299-b354-97972935b46f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t={e}^{-3/2},\\,v=-2{e}^{-3/2}" :db/id #edb/ref 17592186340420} {:answer/id #uuid "f4ad80d3-c28d-5792-a6c6-4a652003995d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t={e}^{-5/2},\\,v=-{e}^{-3/2}" :db/id #edb/ref 17592186341286}] :answer-field/correct {:answer/id #uuid "8fc8c54e-c65f-5299-b354-97972935b46f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t={e}^{-3/2},\\,v=-2{e}^{-3/2}" :db/id #edb/ref 17592186340420} :answer-field/id #uuid "f93c4972-1b9f-5864-8314-9e7c86c8f9bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341825}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f4d760c3-ed2b-5b02-959e-0a9b0b6ecac1" :question/math-academy-id "q-73334" :question/problem "A particle $P$ is traveling along the $x$-axis with displacement $s(t)$ from a fixed origin $O$ given by\n\n$$\ns(t)={t}^{2}\\operatorname{ln}⁡(t),\\,t\\ge 0.\n$$\n\nFind the time at which the acceleration is zero, and find the value of the velocity at this moment." :question/requires-calculator true :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}\\operatorname{ln}⁡(t)) \\\\  & =2t\\operatorname{ln}⁡(t)+t\\end{aligned}\n$$\n\n \n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t+2t\\operatorname{ln}⁡(t)) \\\\  & =2\\operatorname{ln}⁡(t)+3\\end{aligned}\n$$\n\nNext, we put $a=0$ to find the time when the acceleration is zero:\n\n$$\n\\begin{aligned}0 & =2\\operatorname{ln}⁡(t)+3 \\\\ 2\\operatorname{ln}⁡(t) & =-3 \\\\ \\operatorname{ln}⁡(t) & =-\\frac{3}{2} \\\\ t & ={e}^{-3/2}\\end{aligned}\n$$\n\nSo the acceleration is zero when $t={e}^{-3/2}.$ To find the velocity at this moment, we substitute this back into $v(t)$ to get\n\n$$\n\\begin{aligned}v({e}^{-3/2}) & =2({e}^{-3/2})\\operatorname{ln}⁡({e}^{-3/2})+{e}^{-3/2} \\\\  & =2{e}^{-3/2}(-\\frac{3}{2})+{e}^{-3/2} \\\\  & =-2{e}^{-3/2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186179470 :question/id #uuid "ee1eb84b-b9ac-51eb-bef4-2d73702d013a" :question/math-academy-id "e-13906" :question/problem "Solve the inequality $\\dfrac{3x-2k}{5} \\ge -1$ for the variable $x$." :question/worked-solution "We solve the inequality using the addition and multiplication principles, treating $k$ like any other number.\n\nFirst, we multiply both sides of the inequality by $5$ to eliminate the fraction:\n\n$$\n\\begin{bmatrix}\\frac{3x - 2k}{5} & \\ge - 1 \\\\ 5 \\cdot (\\frac{3x - 2k}{5}) & \\ge 5 \\cdot (-1) \\\\ 3x - 2k & \\ge - 5\\end{bmatrix}\n$$\n\nNow, we apply the addition principle, adding $2k$ to both sides of the inequality:\n\n$$\n\\begin{bmatrix}3x - 2k & \\ge - 5 \\\\ 3x - 2k + 2k & \\ge - 5 + 2k \\\\ 3x & \\ge - 5 + 2k \\\\ 3x & \\ge 2k - 5\\end{bmatrix}\n$$\n\nFinally, we apply the multiplication principle, dividing both sides of the inequality by $3{:}$\n\n$$\n\\begin{bmatrix}3x & \\ge 2k - 5 \\\\ \\frac{3x}{3} & \\ge \\frac{2k - 5}{3} \\\\ x & \\ge \\frac{2k - 5}{3}\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186179473 :question/id #uuid "b4567eb8-bc46-57b6-8c61-44f2350b7833" :question/math-academy-id "e-13911" :question/problem "Given that $k< 0$, solve the inequality $\\dfrac{kx +3}3 \\geq 2k$ for the variable $x$." :question/worked-solution "We solve the inequality using the addition and multiplication principles, treating $k$ like any other number.\n\nFirst, we multiply both sides of the inequality by $3$ to eliminate the fraction:\n\n$$\n\\begin{bmatrix}\\frac{kx + 3}{3} & \\ge 2k \\\\ 3 \\cdot (\\frac{kx + 3}{3}) & \\ge 3 \\cdot 2k \\\\ kx + 3 & \\ge 6k\\end{bmatrix}\n$$\n\nNow, we apply the addition principle, subtracting $3$ from both sides of the inequality:\n\n$$\n\\begin{bmatrix}kx + 3 & \\ge 6k \\\\ kx & \\ge 6k - 3\\end{bmatrix}\n$$\n\nThen, we divide by $k$. Since $k < 0$, we need to flip the inequality:\n\n$$\n\\begin{bmatrix}kx & \\ge 6k - 3 \\\\ \\frac{kx}{k} & \\le \\frac{6k - 3}{k} \\\\ x & \\le \\frac{6k - 3}{k}\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186179520 :question/id #uuid "214a6a58-aee6-59c4-b725-53d504d61e0c" :question/math-academy-id "e-5856" :question/problem "Which of the following is the graph of the function $y = \\dfrac{5}{x^2+4x-5}$?\n\n*(Note: Figures not drawn to scale)*\n\n![](images/a0/a0936b30d28e001a20d8a7ef1415cd75a4893f8579437f4e188a0b1c51a638eb.png)" :question/worked-solution "First, we denote\n\n$$\nf(x) = \\dfrac{5}{x^2+4x-5}\n$$\n\nTo determine the correct graph, we follow four steps:\n\n- **Step 1:** We find the $y$-intercept. To do this, we evaluate $f(0)$:\n$f(x)|= \\frac{5}{x^{2} + 4x - 5}; f(0)|= (5)/((0)^{2} + 4(0) - 5); f(0)|= \\frac{5}{-5}; f(0)|=-1$\nSo, the $y$-intercept is $(0,-1)$.\n- **Step 2:** We find the $x$-intercepts. To do this, we set the numerator equal to zero and solve for $x$.In this case, the numerator is a constant, and so there are no $x$-intercepts.\n- **Step 3:** We find the vertical asymptotes. To do this, we need to set the denominator equal to zero and solve for $x$:\n$x^{2} + 4x - 5|= 0; (x + 5)(x - 1)|= 0$\nTherefore, the vertical asymptotes are $x=-5$ and $x=1$.\n- **Step 4:** We find the horizontal asymptotes. To do this, we divide numerator and denominator by the dominant term in the denominator, which is $x^2$ in this case:\n$f(x)|= \\frac{5}{x^{2} + 4x - 5}; = ((\\frac{5}{x^{2}}))/((1 + \\frac{4}{x} - \\frac{5}{x^{2}}))$\nNow, as $\\mid x \\mid$ gets very large, $\\dfrac{5}{x^2}$ and $\\dfrac{4}{x}$ become very small. Therefore, as $\\mid x \\mid \\to\\infty$, we have\n$f(x) \\mid \\approx \\frac{0}{1 + 0 - 0} = 0$.\nSo, the horizontal asymptote is $y = 0$.\n\nFinally, among the options given, only graph I satisfies the above conditions:\n\n![](images/ab/abfae9da161b5c9368d0ff2729755c7c463a0a122b7be00e7b525339b8841dd2.png)"} {:db/id #edb/ref 17592186179525 :question/id #uuid "cd73b214-d887-5dbb-93f9-b71e16711a24" :question/math-academy-id "e-6304" :question/problem "Evaluate the integral of the function $f(x,y) = e^{x+y}$ along the line segment from $(0,3)$ to $(2,3).$" :question/worked-solution "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  = \\int\\limits_{t_a}^{t_b}  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t,\n$$\n\n \n\nwhere $C$ is the line segment from $(0,3)$ to $(2,3).$ \n\nThe position vectors of the endpoints of our line segment are $\\mathbf{a}=3\\,\\mathbf{j}$ and $\\mathbf{b}=2\\,\\mathbf{i}+3\\,\\mathbf{j}.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =3\\,j+t[(2\\,i+3\\,j)-3\\,j] \\\\  & =3\\,j+t(2\\,i) \\\\  & =2t\\,i+3\\,j\\end{aligned}\n$$\n\nwhere $0 \\le t \\le 1.$ Thus, we have that $x=2t$ and $y=3$ along the segment.\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2t)i+\\frac{\\text{d}}{\\text{d}t}(3)j \\\\  & =2\\,i \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{2}^{2}+{0}^{2}} \\\\  & =2\\end{aligned}\n$$\n\nNow, since $f(x,y) = e^{x+y},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & ={e}^{2t+3}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}{e}^{x+y}\\,\\text{d}s & ={\\int }_{0}^{1}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{2t+3}\\cdot 2\\cdot \\text{d}t \\\\  & =2{\\int }_{0}^{1}{e}^{2t+3}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=2t+3,$ $\\textrm d u=2\\,\\textrm d t$ as follows: \n\n$$\n\\begin{aligned}2{\\int }_{0}^{1}{e}^{2t+3}\\,\\text{d}t & ={\\int }_{3}^{5}{e}^{u}\\,\\text{d}u \\\\  & ={e}^{u}\\,{|}_{3}^{5} \\\\  & ={e}^{5}-{e}^{3} \\\\  & ={e}^{3}({e}^{2}-1)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186179526 :question/id #uuid "692dbdea-922d-568c-bc00-4972dd733ca9" :question/math-academy-id "e-6305" :question/problem "Find, as a definite integral, an expression for the line integral of the function $f(x,y) = 2x+y^2$ along the quarter-circle $x^2+y^2=4,$ traversed from the point $(0,2)$ to the point $(-2,0)$ in the second quadrant." :question/worked-solution "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t.\n$$\n\n \n\nThe curve $C$ is a quarter-circle of radius $2$ centered at $O,$ shown below. \n\n![](images/d0/d0ae53dd5d0932cbf834a166e851c227f75cb546b591a9fd43930ec06f0e9ddf.png)\n\nThe curve $C$ can be parametrized as \n\n$$\n\\mathbf{r}(t) = \\big\\langle 2\\cos{t}, \\: 2\\sin{t} \\big\\rangle, \\qquad \\dfrac{\\pi}{2} \\le t \\le \\pi.\n$$\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)j \\\\  & =-2\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-2\\operatorname{sin}⁡t)^{2}+(2\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{4({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =2\\end{aligned}\n$$\n\nNow, since $f(x,y) = 2x+y^2,$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =2(2\\operatorname{cos}⁡t)+(2\\operatorname{sin}⁡t)^{2} \\\\  & =4(\\operatorname{cos}⁡t+{sin}^{2}⁡t).\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}(2x+{y}^{2})\\,\\text{d}s & ={\\int }_{\\pi /2}^{\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{\\pi }4(\\operatorname{cos}⁡t+{sin}^{2}⁡t)\\cdot 2\\cdot \\text{d}t \\\\  & =8{\\int }_{\\pi /2}^{\\pi }(\\operatorname{cos}⁡t+{sin}^{2}⁡t)\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186179528 :question/id #uuid "0681419e-fc16-53ad-89b9-945fb616a391" :question/math-academy-id "e-6675" :question/problem "The half-life of bismuth-210 is $5.012$ days. How long does it take for a $1\\,280\\,\\textrm g$ sample of bismuth-210 to reduce to $5\\,\\textrm g?$" :question/worked-solution "The mass $M(t)$ of a radioactive substance at time $t$ can be modeled by the differential equation\n\n$$\nM'(t) = -kM(t), \\qquad M(0) = M_0.\n$$\n\nThe general solution to this equation is\n\n$$\nM(t) = M_0e^{-kt}.\n$$\n\nThe half-life $t_{1/2}$ is the time taken for the mass of the substance to reduce by one half and is given by\n\n$$\nt_{1/2} = \\dfrac{\\ln 2}{k}.\n$$\n\nThere are two methods that we can use to solve this problem. We describe each of them below.\n\n**Method 1**\n\nSince we know that $t_{1/2} = 5.012$ days we have\n\n$$\n5.012 = \\dfrac{\\ln 2}{k}\\quad\\Rightarrow\\quad k = \\dfrac{\\ln 2}{5.012}\n$$\n\nAlso, since $M_0 = 1\\,280\\,\\textrm g,$ we have the particular solution\n\n$$\nM(t) = 1\\,280 e^{-t\\ln 2/5.012}.\n$$\n\nWe wish to calculate the time $t$ such that $M(t) = 5\\,\\textrm g.$ So, we set up our equation as follows:\n\n$$\n5 = 1\\,280 e^{-t\\ln 2/5.012}\n$$\n\nSolving this equation for $t,$ we get\n\n$$\n\\begin{aligned}5 & =1\\,280{e}^{-t\\operatorname{ln}⁡2/5.012} \\\\ \\frac{5}{1\\,280} & ={e}^{-t\\operatorname{ln}⁡2/5.012} \\\\ \\frac{1}{256} & ={e}^{-t\\operatorname{ln}⁡2/5.012} \\\\ \\operatorname{ln}⁡(\\frac{1}{256}) & =\\operatorname{ln}⁡({e}^{-t\\operatorname{ln}⁡2/5.012}) \\\\ \\operatorname{ln}⁡1-\\operatorname{ln}⁡256 & =-\\frac{t\\operatorname{ln}⁡2}{5.012} \\\\ -\\operatorname{ln}⁡256 & =-\\frac{t\\operatorname{ln}⁡2}{5.012} \\\\ t & =\\frac{5.012\\cdot \\operatorname{ln}⁡256}{\\operatorname{ln}⁡2} \\\\ t & ≈40.\\end{aligned}\n$$\n\nTherefore, we conclude that it takes approximately $40$ days for the mass of the substance to reduce to $5\\,\\textrm g.$\n\n**Method 2**\n\nWe wish to calculate the time $t$ such that $M(t) = 5\\,\\textrm g.$ Notice that\n\n$$\n\\begin{aligned}\\frac{M(t)}{M(0)} & =\\frac{5\\,\\text{g}}{1\\,280\\,\\text{g}} \\\\  & =\\frac{1}{256} \\\\  & ={(\\frac{1}{2})}^{8},\\end{aligned}\n$$\n\nor equivalently\n\n$$\nM(t) =  \\left(\\dfrac{1}{2}\\right)^8\\cdot M(0).\n$$\n\nFrom this equation, we see that $8$ half-lives must have occurred for the mass to reduce from $1\\,280\\,\\textrm g$ to $5\\,\\textrm g.$ Hence,\n\n$$\nt = 8\\cdot t_{1/2} =8 \\cdot 5.012 \\approx 40.\n$$\n\nTherefore, we conclude that it takes approximately $40$ days for the mass of the substance to reduce to $5\\,\\textrm g.$"} {:db/id #edb/ref 17592186179540 :question/id #uuid "26f0aea2-1440-5e96-9013-8238214b4966" :question/math-academy-id "e-8065" :question/problem "Find the real solution to the equation $96x^5=3.$" :question/worked-solution "We can solve this equation by isolating the $x^5$ term and then taking the $5$th root of each side.\n\nFirst, let's isolate the $x^5$ term on the left-hand side:\n\n$$\n\\begin{aligned}96{x}^{5} & =3 \\\\ {x}^{5} & =\\frac{1}{32}\\end{aligned}\n$$\n\nNow, we take the $5$th root of each side and solve for $x.$ Since $n=5$ is odd, there is only one real solution to this equation:\n\n$$\n\\begin{aligned}{x}^{5} & =\\frac{1}{32} \\\\ \\sqrt[5]{{x}^{5}} & =\\sqrt[5]{\\frac{1}{32}} \\\\ x & =\\sqrt[5]{{(\\frac{1}{2})}^{5}} \\\\ x & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the solution is $x=\\dfrac12.$"} {:db/id #edb/ref 17592186179544 :question/id #uuid "e271e6e5-313b-53b2-94c1-c0a02209afa5" :question/math-academy-id "e-8470" :question/problem "Find the expression for the general term $a_n$ for $n\\geq 0$ of the sequence with the generating function $\\dfrac{6}{5-4x}$." :question/worked-solution "Let's rewrite the expression and expand it as a geometric series:\n\n$$\n\\begin{aligned}\n\\frac{6}{5 - 4x} &= \\frac{6}{5} \\cdot (1)/(1 - (\\frac{4}{5}x)) \\\\\n&= \\frac{6}{5}[1 + (\\frac{4}{5}x) + (\\frac{4}{5}x)^{2} + (\\frac{4}{5}x)^{3} + ⋯] \\\\\n&= \\frac{6}{5} + \\frac{6}{5}(\\frac{4}{5})x + \\frac{6}{5}(\\frac{4}{5})^{2}x^{2} + \\frac{6}{5}(\\frac{4}{5})^{3}x^{3} + ⋯\n\\end{aligned}\n$$\n\nTherefore, the general term $a_n$ of our sequence is\n\n$$\na_n = \\dfrac{6}{5}\\left(\\dfrac{4}{5}\\right)^n\n$$"} {:db/id #edb/ref 17592186179549 :question/id #uuid "7de054d4-8384-5aab-b2c4-a43b1f86a16c" :question/math-academy-id "e-8928" :question/problem "Given that $\\mathbf F(x,y) = \\left\\langle \\dfrac 1x, xy \\right \\rangle$ and $f(x,y) = \\dfrac 1{x},$ calculate $\\nabla \\cdot (f\\,\\mathbf F).$" :question/worked-solution "We will use the following identity:\n\n$$\n\\nabla \\cdot (f\\,\\mathbf F) = f\\, \\nabla \\cdot \\mathbf {F}+  \\mathbf F \\cdot \\nabla f\n$$\n\nFirst, we compute $\\nabla \\cdot \\mathbf {F}$ and $\\nabla f.$ We get\n\n$$\n\\begin{aligned}∇f & =⟨-\\frac{1}{{x}^{2}},0⟩, \\\\ ∇\\cdot F & =\\frac{∂}{∂x}(\\frac{1}{x})+\\frac{∂}{∂y}(xy)=-\\frac{1}{{x}^{2}}+x.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot (f\\,F) & =f\\,∇\\cdot F+F\\cdot ∇f \\\\  & =\\frac{1}{x}(-\\frac{1}{{x}^{2}}+x)+⟨\\frac{1}{x},xy⟩\\cdot ⟨-\\frac{1}{{x}^{2}},0⟩ \\\\  & =-\\frac{1}{{x}^{3}}+1-\\frac{1}{{x}^{3}} \\\\  & =1-\\frac{2}{{x}^{3}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186179565 :question/id #uuid "6071cbf5-80de-587f-ab24-ccd6e2f5ae57" :question/math-academy-id "e-9416" :question/problem "Monica pays $\\[math]3\\,500$ into an investment account at the beginning of every year. She earns an annual interest of $2\\%$, paid at the end of the year. To the nearest dollar, how much money will be in her investment account by the end of the $9$th year?" :question/worked-solution "Let $S_n$ be the value of Monica's investment at the end of the $n$th year.\n\n- At the end of the year $1$, Monica's investment will be worth\n$S_1 = \\[math]3\\,500\\cdot (1.02)$.\n- To calculate the value of the investment at the end of year $2$, we need to add $\\[/math]3\\,500$ to the balance at the end of year $1$, and then increase the entire amount by $2 \\%$. Therefore, at the end of the year $2$, Monica's investment will be worth\n$S_{2}|= (S_{1} + \\[math]3500) \\cdot (1.02); = (\\[/math]3500 \\cdot (1.02) + \\[math]3500) \\cdot (1.02); = \\[/math]3500 \\cdot (1.02)^{2} + \\[math]3500 \\cdot (1.02)$.\n- Similarly, at the end of the year $3$, Monica's investment will be worth\n$S_{3}|= (S_{2} + \\[/math]3500) \\cdot (1.02); = [(\\[math]3500 \\cdot (1.02)^{2} + \\[/math]3500 \\cdot (1.02)) + \\[math]3500] \\cdot (1.02); = \\[/math]3500 \\cdot (1.02)^{3} + \\[math]3500 \\cdot (1.02)^{2} + \\[/math]3500 \\cdot (1.02)$.\n- $\\quad \\vdots$\n- Continuing this process, we may deduce that by the end of the year $9$, Monica's investment will be worth\n$S_{9}|= \\[math]3500 \\cdot (1.02)^{9} + \\[/math]3500 \\cdot (1.02)^{8} + ⋯ + \\[math]3500 \\cdot (1.02); = \\[/math]3500 \\cdot (1.02) \\cdot [(1.02)^{8} + (1.03)^{7} + ⋯ + 1]$.\n\nNotice that the expression inside the square brackets is a geometric series with $a_1 = 1$, $r = 1.02$, and $N = 9$. Thus, after $9$ years, Monica's investment will be worth\n\n$$\n\\begin{aligned}\nS_{9} &= \\[math]3500 \\cdot (1.02) \\cdot ((a_{1}(1 - r^{N}))/(1 - r)) \\\\\n&= \\[/math]3570 \\cdot ((1 \\cdot (1 - 1.02^{9}))/(1 - 1.02)) \\\\\n&= \\[math]3570 \\cdot (\\frac{1 - 1.02^{9}}{1 - 1.02}) \\\\\n&\\approx \\[math]34824\n\\end{aligned}\n$$\n\nrounded to the nearest dollar."} {:db/id #edb/ref 17592186179567 :question/id #uuid "7d093e24-0b95-58ff-9c48-51640fe78730" :question/math-academy-id "e-9420" :question/problem "Harold pays $\\[math]2\\,500$ into an investment account at the beginning of every year. He earns an annual interest of $4\\%$, compounded continuously. To the nearest dollar, how much money will be in his investment account by the end of the $10$th year?" :question/worked-solution "Let $S_n$ be the value of Harold's investment at the end of the $n$th year.\n\n- The interest rate is $4\\%$ per year, compounded continuously. Therefore, at the end of year $1$, Harold's investment will be worth\n$S_1 = \\[math]2\\,500e^{0.04}$\n- To calculate the value of the investment at the end of year $2$, we need to add $\\[/math]2\\,500$ to the balance at the end of year $1$, and then increase the entire amount by $4\\%$, compounded continuously. Therefore, at the end of year $2$, Harold's investment will be worth\n$S_{2}|= (S_{1} + [math]2500)e^{0.04}; = (\\[/math]2500 \\cdot e^{0.04} + \\[math]2500) \\cdot e^{0.04}; = \\[/math]2500 \\cdot [e^{0.04}]^{2} + \\[math]2500 \\cdot e^{0.04}$.\n- $\\quad \\vdots$\n- Continuing this process, we may deduce that by the end of year $10$, Harold's investment will be worth\n$S_{10}|= \\[/math]2500 \\cdot [e^{0.04}]^{10} + \\[math]2500 \\cdot [e^{0.04}]^{9} + ⋯ + \\[/math]2500 \\cdot e^{0.04}; = \\[math]2500 \\cdot e^{0.04} \\cdot {[e^{0.04}]^{9} + [e^{0.03}]^{8} + ⋯ + [e^{0.04}] + 1}$\n\nNotice that the expression inside the curly braces is a geometric series with $a_1=1$, $r=e^{0.04}$, and $N=10$. Thus, after $10$ years, Harold's investment will be worth\n\n$$\n\\begin{aligned}\nS_{10} &= \\[/math]2500 \\cdot e^{0.04} \\cdot ((a_{1}(1 - r^{N}))/(1 - r)) \\\\\n&= \\[math]2500 \\cdot e^{0.04} \\cdot ((1 \\cdot (1 - [e^{0.04}]^{10}))/(1 - e^{0.04})) \\\\\n&= \\[/math]2500 \\cdot e^{0.04} \\cdot (\\frac{1 - [e^{0.04}]^{10}}{1 - e^{0.04}}) \\\\\n&\\approx \\[math]31358\n\\end{aligned}\n$$\n\nrounded to the nearest dollar."} {:db/id #edb/ref 17592186179569 :question/id #uuid "72ab907f-a6f4-5b83-8721-326d12573fcc" :question/math-academy-id "e-9431" :question/problem "![](images/69/69447f99f5d726fb86ec1eb34c7acea36be929a3d109280e1b46730c8837f4a3.png)\n\nWhich of the following could be the equation of the graph shown above?\n\n*(Note: Figure not drawn to scale)*\n\n1. $y = \\dfrac{x^2-2x}{(x^2-x)(x-2)}$\n2. $y = \\dfrac{2(x^2-x)}{x^2-1}$\n3. $y = \\dfrac{x^2-2x}{x^2-x}$\n4. $y = \\dfrac{x^3-2x^2}{x(x-1)(x-2)}$" :question/worked-solution "From the graph of the function, we note the following:\n\n- The function has only one vertical asymptote, $x = 1$. Therefore, the function's denominator must be zero at $x=1$, but the numerator should not be zero at this point. This allows us to discard the following option:\n$y = \\dfrac{2(x^2-x)}{x^2-1}$\n- The function has two open circles, at $x = 0$ and $x=2$. This means that $x = 0$ and $x=2$ are holes, and so the numerator and denominator are both zero at $x = 0$ and $x=2$. This allows us to discard the following option:\n$y = \\dfrac{x^2-2x}{x^2-x}$So, we're left with the following options:\n$y = \\dfrac{x^3-2x^2}{x(x-1)(x-2)}, \\qquad y = \\dfrac{x^2-2x}{(x^2-x)(x-2)}$\n- The function has a horizontal asymptote at $y = 0$. This means that $y \\to 0$ as $\\mid x \\mid \\to \\infty$. Note that for large $\\mid x \\mid$, we have\n$(x^{3} - 2x^{2})/(x(x - 1)(x - 2))|= (x^{2}(x - 2))/(x(x - 1)(x - 2)); = \\frac{x}{x - 1}; = ((\\frac{x}{x}))/((\\frac{x}{x} - \\frac{1}{x})); = (1)/((1 - \\frac{1}{x})); \\approx 1$.\nSo, we can discard the following option:\n$y = \\dfrac{x^3-2x^2}{x(x-1)(x-2)}$\n\nTherefore, among the given options, the only one that satisfies the above conditions is\n\n$$\ny = \\dfrac{x^2-2x}{(x^2-x)(x-2)}\n$$"} {:db/id #edb/ref 17592186179571 :question/id #uuid "4088c5c5-6f69-54f3-9029-3ba52f5b00d5" :question/math-academy-id "e-9435" :question/problem "![](images/2e/2e4e808d8264685f9b88c5b0052870174d8be3ed2a7195149d45552118186a49.png)\n\nBy setting $y = t$ where $t$ is a parameter, find a definite integral with respect to $t$ that is equivalent to the integral $\\displaystyle \\int \\limits_{C} \\dfrac{x}{y} \\, \\textrm ds,$ where $C$ is the arc of the parabola $x = y^2$ traversed between the points $(1,1)$ and $(9 , 3),$ as shown above." :question/worked-solution "Notice that the given curve is of the form $x = x(y).$ Therefore, by setting $y = t,$ we have \n\n$$\nx = x(t) = t^2.\n$$\n\n \n\nThis gives the following parametrization of the curve:\n\n$$\n\\mathbf{r}(t) = \\left\\langle t^2 , \\: t \\right\\rangle, \\qquad 1 \\leq t \\leq 3\n$$\n\nNote that the domain $1 \\leq t \\leq 3$ is defined by the $y$-coordinates of the endpoints on the path.\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get the following: \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =2t\\,i+j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{(2t)}^{2}+{1}^{2}} \\\\  & =\\sqrt{4{t}^{2}+1}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y) = \\dfrac{x}{y},$ then we obtain \n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{{t}^{2}}{t} \\\\  & =t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{x}{y}\\,\\text{d}s & ={\\int }_{1}^{3}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{1}^{3}t\\sqrt{4{t}^{2}+1}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186179572 :question/id #uuid "3fe61e6a-ce68-5f85-98f3-e4af5a39de5e" :question/math-academy-id "e-9438" :question/problem "Find, as a definite integral, an expression for the line integral of the function $f(x,y) = x^2-1,$ traversed once along the circle $C$ with equation $x^2 + y^2 = 1.$" :question/worked-solution "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t.\n$$\n\n \n\nThe curve $C$ is a circle of radius $1$ centered at $O.$ It can be parametrized as \n\n$$\n\\mathbf{r}(t) = \\big\\langle \\cos{t}, \\: \\sin{t} \\big\\rangle, \\qquad 0 \\le t \\lt 2\\pi.\n$$\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)j \\\\  & =-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{{sin}^{2}⁡t+{cos}^{2}⁡t} \\\\  & =1\\end{aligned}\n$$\n\nNow, since $f(x,y) = x^2-1,$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(\\operatorname{cos}⁡t)^{2}-1 \\\\  & ={cos}^{2}⁡t-1.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }({cos}^{2}⁡t-1)\\cdot 1\\cdot \\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }{cos}^{2}⁡t-1\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186179573 :question/id #uuid "5ebfa0d1-bf16-56d0-a58f-2b16720b7aad" :question/math-academy-id "e-9439" :question/problem "![](images/fd/fda8bfb0533b86dc4050d1b8e309e332996b26263b1052d3e251bf0a5c98e816.png)\n\nEvaluate the line integral $\\displaystyle\\int_\\limits{C}12xy\\:\\textrm{d}s,$ where the curve $C$ is the quarter-ellipse $4x^2+y^2=4$ traversed from the point $(0,2)$ to the point $(-1,0),$ as shown above." :question/worked-solution "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t.\n$$\n\n \n\nNote that we can write the equation of our ellipse in the form\n\n$$\nx^2 + \\dfrac{y^2}{2^2}  = 1.\n$$\n\nSo, the curve $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $1$ and $2,$ respectively. Therefore, it can be parametrized as \n\n$$\n\\mathbf{r}(t) = \\big\\langle \\cos{t}, \\: 2\\sin{t} \\big\\rangle, \\qquad \\dfrac{\\pi}{2} \\le t \\le \\pi.\n$$\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)j \\\\  & =-\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-\\operatorname{sin}⁡t)^{2}+(2\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{{sin}^{2}⁡t+4{cos}^{2}⁡t} \\\\  & =\\sqrt{3{cos}^{2}⁡t+({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\sqrt{1+3{cos}^{2}⁡t}\\end{aligned}\n$$\n\nNow, since $f(x,y) = 12xy$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =12\\cdot \\operatorname{cos}⁡t\\cdot 2\\operatorname{sin}⁡t=24\\operatorname{sin}⁡t\\,\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}12xy\\,\\text{d}s & ={\\int }_{\\pi /2}^{\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{\\pi }24\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\cdot \\sqrt{1+3{cos}^{2}⁡t}\\cdot \\text{d}t \\\\  & =24{\\int }_{\\pi /2}^{\\pi }\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\sqrt{1+3{cos}^{2}⁡t}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=1+3\\cos^2 {t},$ $\\textrm d u=-6\\sin t\\cos \n t\\,\\textrm d t$ as follows:\n\n$$\n\\begin{aligned}24{\\int }_{\\pi /2}^{\\pi }\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\sqrt{1+3{cos}^{2}⁡t}\\,\\text{d}t & =-4{\\int }_{1}^{4}\\sqrt{u}\\,\\text{d}u \\\\  & =-4\\cdot \\frac{2}{3}{u}^{3/2}{|}_{1}^{4} \\\\  & =-\\frac{8}{3}({4}^{3/2}-{1}^{3/2}) \\\\  & =-\\frac{8}{3}(8-1) \\\\  & =-\\frac{56}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186179578 :question/id #uuid "1990e97c-7244-5b6d-a5d5-69cd4b91ad21" :question/math-academy-id "e-9460" :question/problem "What expression is equivalent to $\\displaystyle \\int_\\limits{C} \\dfrac{x}{y} \\: \\textrm{d}s,$ where $C$ is the ellipse $x^2 + 16y^2 = 16,$ traversed once in the counterclockwise direction?" :question/worked-solution "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t.\n$$\n\n \n\nNote that we can write the equation of our ellipse in the form\n\n$$\n\\dfrac{x^2}{4^2} + \\dfrac{y^2}{1^2} = 1.\n$$\n\nSo, the curve $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $4$ and $1,$ respectively. Therefore, it can be parametrized as \n\n$$\n\\mathbf{r}(t) = \\left\\langle 4\\cos{t}, \\: \\sin{t} \\right\\rangle, \\qquad 0 \\le t \\lt 2\\pi.\n$$\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)j \\\\  & =-4\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-4\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{16{sin}^{2}⁡t+{cos}^{2}⁡t} \\\\  & =\\sqrt{15{sin}^{2}⁡t+({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\sqrt{15{sin}^{2}⁡t+1}\\end{aligned}\n$$\n\nNow, since $f(x,y) = \\dfrac{x}{y},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{4\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t}=4\\operatorname{cot}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{x}{y}\\,\\text{d}s & ={\\int }_{0}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }4\\operatorname{cot}⁡t\\sqrt{15{sin}^{2}⁡t+1}\\,\\text{d}t \\\\  & =4{\\int }_{0}^{2\\pi }\\operatorname{cot}⁡t\\sqrt{15{sin}^{2}⁡t+1}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186179579 :question/id #uuid "a4c10c26-84c5-5ec7-9468-93986e27f492" :question/math-academy-id "e-9462" :question/problem "Evaluate the line integral of the function $f(x,y) =x^2-2$ along the circle $C$ with equation $x^2 + y^2 = 4.$" :question/worked-solution "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t.\n$$\n\n \n\nThe curve $C$ is a circle of radius $2$ centered at $O.$ It can be parametrized as \n\n$$\n\\mathbf{r}(t) = \\big\\langle 2\\cos{t}, \\: 2\\sin{t} \\big\\rangle, \\qquad 0 \\le t \\le 2\\pi.\n$$\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)j \\\\  & =-2\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-2\\operatorname{sin}⁡t)^{2}+(2\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{4{sin}^{2}⁡t+4{cos}^{2}⁡t} \\\\  & =\\sqrt{4({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =2\\end{aligned}\n$$\n\nNow, since $f(x,y) = x^2-2,$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(2\\operatorname{cos}⁡t)^{2}-2 \\\\  & =4{cos}^{2}⁡t-2 \\\\  & =2(2{cos}^{2}⁡t-1) \\\\  & =2\\operatorname{cos}⁡2t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }2\\operatorname{cos}⁡2t\\cdot 2\\cdot \\text{d}t \\\\  & =4{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡2t\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=2t,$ $\\textrm d u=2\\,\\textrm d t$ as follows:\n\n$$\n\\begin{aligned}4{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡2t\\,\\text{d}t & =2{\\int }_{0}^{4\\pi }\\operatorname{cos}⁡u\\,\\text{d}u \\\\  & =2\\operatorname{sin}⁡u{|}_{0}^{4\\pi } \\\\  & =2(0-0) \\\\  & =0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186179580 :question/id #uuid "f025deb6-7c71-5d15-9966-52f7d5eeab80" :question/math-academy-id "e-9463" :question/problem "![](images/d0/d0cebdd804ff244d037e14df6ec33efb86b522644f7b4addc688e27fd6a57e95.png)\n\nEvaluate the line integral\n$\\displaystyle \\int\\limits_{C} y^3e^{-x} \\: \\textrm{d}s,$\nwhere $C$ is the section of the curve $x = \\ln{y}$ from $(0, 1)$ to $\\left(\\dfrac32\\ln 2 , 2\\sqrt{2}\\right),$ as shown above." :question/worked-solution "Notice that the given curve is of the form $x = x(y).$ Therefore, by setting $y=t,$ we have\n\n$$\nx = x(t) = \\ln{t}.\n$$\n\nThis gives the following parametrization of the curve:\n\n$$\n\\mathbf{r}(t) = \\left\\langle \\ln{t}, \\: t \\right\\rangle, \\qquad 1 \\leq t \\leq 2\\sqrt{2}\n$$\n\nNote that the domain $1 \\leq t \\leq 2\\sqrt{2}$ is defined by the $y$-coordinates of the endpoints on the path.\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get the following: \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =\\frac{1}{t}\\,i+j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{(\\frac{1}{t})}^{2}+{1}^{2}} \\\\  & =\\sqrt{\\frac{1}{{t}^{2}}+1} \\\\  & =\\sqrt{\\frac{{t}^{2}+1}{{t}^{2}}} \\\\  & =\\frac{\\sqrt{{t}^{2}+1}}{|t|} \\\\  & =\\frac{\\sqrt{{t}^{2}+1}}{t}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y) = y^3e^{-x},$ then we obtain \n\n$$\n\\begin{aligned}f(r(t)) & ={t}^{3}{e}^{-\\operatorname{ln}⁡t} \\\\  & ={t}^{3}\\cdot \\frac{1}{t} \\\\  & ={t}^{2}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}{y}^{3}{e}^{-x}\\,\\text{d}s & ={\\int }_{1}^{2\\sqrt{2}}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{1}^{2\\sqrt{2}}{t}^{2}\\cdot \\frac{\\sqrt{{t}^{2}+1}}{t}\\,\\text{d}t \\\\  & ={\\int }_{1}^{2\\sqrt{2}}t\\sqrt{{t}^{2}+1}\\,\\text{d}t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral using the substitution $u = t^2 + 1,$ $\\textrm{d}u = 2t \\, \\textrm{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2\\sqrt{2}}t\\sqrt{{t}^{2}+1}\\,\\text{d}t & ={\\int }_{2}^{9}\\sqrt{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot \\frac{2}{3}\\sqrt{{u}^{3}}\\,{|}_{2}^{9} \\\\  & =\\frac{1}{3}[\\sqrt{{9}^{3}}-\\sqrt{{2}^{3}}] \\\\  & =\\frac{27-2\\sqrt{2}}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186179586 :question/id #uuid "b7d08596-fbe4-5601-a58e-dac90715f7e7" :question/math-academy-id "e-9486" :question/problem "Find a definite integral that is equivalent to the line integral of the function $f(x,y) = x+\\sin{y},$ traversed along the line segment from $(1,0)$ to $(1,1).$" :question/worked-solution "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  =  \\int\\limits_{t_a}^{t_b}  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t,\n$$\n\n \n\nwhere $C$ is the line segment from $(1,0)$ to $(1,1).$ \n\nThe position vectors of the endpoints of our line segment are $\\mathbf{a}=\\mathbf{i}$ and $\\mathbf{b}=\\mathbf{i}+\\mathbf{j}.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =i+t[(i+j)-i] \\\\  & =i+t\\,j\\end{aligned}\n$$\n\nwhere $0 \\le t \\le 1.$ Thus, we have that $x=1$ and $y=t$ along the segment.\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(1)i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =0\\,i+j \\\\  & =j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{0}^{2}+{1}^{2}} \\\\  & =1\\end{aligned}\n$$\n\nNow, since $f(x,y) = x+\\sin{y}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =1+\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{1}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(1+\\operatorname{sin}⁡t)\\cdot 1\\cdot \\text{d}t \\\\  & ={\\int }_{0}^{1}(1+\\operatorname{sin}⁡t)\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186179587 :question/id #uuid "17ec17a0-11d7-57c1-9e7f-6893ab9e51e0" :question/math-academy-id "e-9487" :question/problem "Find the line integral of the function $f(x,y,z) = x^2+y-z,$ traversed along the line segment from $(0,1,-3)$ to $(-1,2,-2)?$" :question/worked-solution "We will use the formula\n\n$$\n\\int\\limits_C f(x,y,z) \\, \\textrm{d}s  =  \\int\\limits_{t_a}^{t_b}  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t,\n$$\n\n \n\nwhere $C$ is the line segment from $(0,1,-3)$ to $(-1,2,-2).$\n\nThe position vectors of the endpoints of our line segment are $\\mathbf{a}=\\mathbf{j}-3\\mathbf{k}$ and $\\mathbf{b}=-\\,\\mathbf{i}+2\\,\\mathbf{j}-2\\,\\mathbf{k}.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =(j-3k)+t[(-\\,i+2\\,j-2\\,k)-(j-3k)] \\\\  & =(j-3k)+t(-i+\\,j+k) \\\\  & =-t\\,i+(t+1)\\,j+(t-3)\\,k\\end{aligned}\n$$\n\nwhere $0 \\le t \\le 1.$ Thus, we have that $x=-t, y=t+1,$ and $z=t-3$ along the segment.\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(-t)i+\\frac{\\text{d}}{\\text{d}t}(t+1)j+\\frac{\\text{d}}{\\text{d}t}(t-3)k \\\\  & =-i+j+k \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}+{(\\frac{\\text{d}z}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-1)^{2}+{1}^{2}+{1}^{2}} \\\\  & =\\sqrt{3}\\end{aligned}\n$$\n\nNow, since $f(x,y) = x^2+y-z$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(-t)^{2}+(t+1)-(t-3) \\\\  & ={t}^{2}+4.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{1}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}({t}^{2}+4)\\cdot \\sqrt{3}\\cdot \\text{d}t \\\\  & =\\sqrt{3}{\\int }_{0}^{1}({t}^{2}+4)\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186179588 :question/id #uuid "239120b8-0553-5cff-aee1-f50253af11ae" :question/math-academy-id "e-9488" :question/problem "![](images/71/71df4fc7bd52fe5dd97c7e01502dec2ad68ae31fdf224cccd812c6b7318c70b7.png)\n\nFind, as a definite integral, an expression for the line integral of the function $\\displaystyle\\int_\\limits{C} 2xy \\:\\textrm{d}s,$ where the curve $C$ is the right half of the ellipse $9x^2 + 4y^2 = 36,$ shown above." :question/worked-solution "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t.\n$$\n\n \n\nNote that we can write the equation of our ellipse in the form\n\n$$\n\\dfrac{x^2}{2^2} + \\dfrac{y^2}{3^2} = 1.\n$$\n\nSo, the curve $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $2$ and $3,$ respectively. Therefore, it can be parametrized as \n\n$$\n\\mathbf{r}(t) = \\left\\langle 2\\cos{t}, \\: 3\\sin{t} \\right\\rangle, \\qquad -\\dfrac{\\pi}{2} \\le t \\le \\dfrac{\\pi}{2}.\n$$\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t)j \\\\  & =-2\\operatorname{sin}⁡t\\,i+3\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-2\\operatorname{sin}⁡t)^{2}+(3\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{4{sin}^{2}⁡t+9{cos}^{2}⁡t} \\\\  & =\\sqrt{5{cos}^{2}⁡t+4({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\sqrt{5{cos}^{2}⁡t+4}\\end{aligned}\n$$\n\nNow, since $f(x,y) = 2xy,$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =2(2\\operatorname{cos}⁡t)(3\\operatorname{sin}⁡t) \\\\  & =12\\operatorname{sin}⁡t\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}2xy\\,\\text{d}s & ={\\int }_{-\\pi /2}^{\\pi /2}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}12\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\sqrt{5{cos}^{2}⁡t+4}\\,\\text{d}t \\\\  & =12{\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\sqrt{5{cos}^{2}⁡t+4}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186179608 :question/id #uuid "337d9d7e-5488-5e6d-af34-e01d22d3d0b9" :question/math-academy-id "e-9574" :question/problem "![](images/6e/6eebbc5ae9f548f5b00de9a12d454fa788884bf73ad46a1065eab0d26330a921.png)\n\nThe curve $C$ is given by $y = \\dfrac14x^2$ from the point $\\left(0,0\\right)$ to the point $\\left(4,4\\right).$ Calculate the flux of the vector field $\\mathbf F(x,y) = -2\\,\\mathbf{i} + x\\,\\mathbf{j}$ through $C,$ measured with respect to the unit normal vector $\\mathbf n$ on $C,$ as shown above." :question/worked-solution "If $\\mathbf{F} = P\\,\\mathbf i + Q\\,\\mathbf j$ is a vector field and $C$ is a piecewise-smooth, simple curve, then the flux of $\\mathbf F$ across $C$ measured with respect to a unit normal vector $\\mathbf n$ on $C$ is given by\n\n$$\n\\int\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s = \\int\\limits_{C}P\\,\\textrm d y - Q\\,\\textrm d x.\n$$\n\nTo apply this formula, \n\n- the curve should be parameterized as $\\mathbf r(t)$ for $t\\in [a,b],$ and\n\n- the unit normal vector $\\mathbf n$ *must* be a $90^\\circ$ clockwise rotation of the unit tangent vector $\\mathbf T(t).$\n\nParameterizing the curve $C,$ we have\n\n$$\nx = t, \\qquad\ny = \\dfrac{t^2}{4},\n\\qquad\nt\\in \\left[0,4\\right].\n$$\n\n \n\nThis parameterization traverses the curve from the point $(0,0)$ to the point $(4,4).$ Therefore, $\\mathbf n$ is indeed a $90^\\circ$ clockwise rotation of $\\mathbf T,$ so we can apply the above formula for the flux. \n\n![](images/2b/2b94e24344f600fc02ec5ecac6c1e0ee4c6a5450132753a0a5ac5fceaa9aa1fc.png)\n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =-2, \\\\ Q(x,y) & =x=t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{{t}^{2}}{4})=\\frac{t}{2}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot n\\,\\text{d}s & ={\\int }_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{4}(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{4}(-2)\\cdot (\\frac{t}{2})-(t)\\cdot (1)\\,\\text{d}t \\\\  & ={\\int }_{0}^{4}-2t\\,\\text{d}t \\\\  & =-{t}^{2}{|}_{0}^{4} \\\\  & =-16-0 \\\\  & =-16\\end{aligned}\n$$"} {:db/id #edb/ref 17592186179609 :question/id #uuid "5f6de8db-7738-5df7-8cf8-8e37f6ab483f" :question/math-academy-id "e-96" :question/problem "Calculate $\\lim_\\limits{\\theta \\to 0} \\:\\dfrac{\\tan 2\\theta}{\\theta}$." :question/worked-solution "First, we can simplify the limit using trigonometric identities, as follows:\n\n$$\n\\begin{aligned}\nlim_(θ → 0)\\frac{\\tan 2θ}{θ} &= lim_(θ → 0)((\\frac{\\sin 2θ}{\\cos 2θ}))/(θ) \\\\\n&= lim_(θ → 0)(\\frac{\\sin 2θ}{θ} \\cdot \\frac{1}{\\cos 2θ}) \\\\\n&= lim_(θ → 0)\\frac{\\sin 2θ}{θ} \\cdot lim_(θ → 0)\\frac{1}{\\cos 2θ}\n\\end{aligned}\n$$\n\nLet's now evaluate the limits separately:\n\n- Consider the first limit. Notice that as $\\theta \\to 0$, both numerator and denominator approach $0$. So, if we attempt to evaluate the limit directly, we get\n$\\lim_\\limits{\\theta \\to 0}\\: \\dfrac{\\sin 2\\theta}{\\theta} = \\dfrac{0}{0}$,\nwhich is an indeterminate form. Instead, let's recall the following special limit:\n$\\lim_\\limits{x \\to 0}\\: \\dfrac{\\sin x}{x} =1$We rewrite the given limit using the algebra of limits, as follows:\n$lim_(θ → 0)\\frac{\\sin 2θ}{θ}|= lim_(θ → 0)(2 \\cdot \\frac{\\sin 2θ}{2θ}); = 2 \\cdot lim_(θ → 0)\\frac{\\sin2θ}{2θ}$Let $x = 2\\theta$. Then, since $x\\to0$ as $\\theta \\to 0$, we have\n$2 \\cdot \\lim_\\limits{\\theta \\to 0}\\: \\dfrac{\\sin \\color{blue}2\\theta}{\\color{blue}2\\theta} = 2 \\cdot \\lim_\\limits{x \\to 0}\\: \\dfrac{\\sin \\color{blue}x}{\\color{blue}x} = 2 \\cdot 1 =2$.\n- Consider the second limit. Evaluating it directly, we get\n$\\lim_\\limits{\\theta \\to 0} \\: \\dfrac{1}{\\cos 2\\theta} = \\dfrac{1}{\\cos 0} = \\dfrac11 = 1$.\n\nTherefore, we have\n\n$$\nlim_(θ → 0)\\frac{\\sin 2θ}{θ} \\cdot lim_(θ → 0)\\frac{1}{\\cos 2θ} = 2 \\cdot 1 = 2\n$$"} {:db/id #edb/ref 17592186179957 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "112fa180-a9ff-5a56-b2fe-80282d87c197" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186253821} {:answer/id #uuid "60cf1536-90f0-50e5-951e-3b49ab45ab85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186254535} {:answer/id #uuid "bc1a3b6b-ca8b-5902-8ca8-8bc8bf6be7a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186255352} {:answer/id #uuid "e0be5a81-a209-5ccd-96ce-0c6a965890c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186255666} {:answer/id #uuid "e86b4ea1-a0c8-561f-af0b-f93a91a9e5d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}-1}{2}" :db/id #edb/ref 17592186255711}] :answer-field/correct {:answer/id #uuid "60cf1536-90f0-50e5-951e-3b49ab45ab85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186254535} :answer-field/id #uuid "1f0a4ffd-5d50-5cdb-9c19-928ff9fa4767" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255974}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b79282b0-117d-50c1-87eb-8d6109e91a7d" :question/math-academy-id "q-122136" :question/problem "Evaluate the line integral of the function $f(x,y)={x}^{2}-{y}^{2}$ along the circle $C$ with equation ${x}^{2}+{y}^{2}=16.$" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nThe curve $C$ is a circle of radius $4$ centered at $O.$ It can be parametrized as \n\n$$\nr(t)=⟨4\\operatorname{cos}⁡t,\\,4\\operatorname{sin}⁡t⟩,\\,0\\le t\\le 2\\pi .\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{sin}⁡t)j \\\\  & =-4\\operatorname{sin}⁡t\\,i+4\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-4\\operatorname{sin}⁡t)^{2}+(4\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{16{sin}^{2}⁡t+16{cos}^{2}⁡t} \\\\  & =\\sqrt{16({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =4\\end{aligned}\n$$\n\nNow, since $f(x,y)={x}^{2}-{y}^{2},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(4\\operatorname{cos}⁡t)^{2}-(4\\operatorname{sin}⁡t)^{2} \\\\  & =16{cos}^{2}⁡t-16{sin}^{2}⁡t \\\\  & =16({cos}^{2}⁡t-{sin}^{2}⁡t) \\\\  & =16\\operatorname{cos}⁡(2t).\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }16\\operatorname{cos}⁡(2t)\\cdot 4\\cdot \\text{d}t \\\\  & =64{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡(2t)\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=2t,$ $\\text{d}u=2\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}64{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡(2t)\\,\\text{d}t & =32{\\int }_{0}^{4\\pi }\\operatorname{cos}⁡u\\,\\text{d}u \\\\  & =32\\operatorname{sin}⁡u{|}_{0}^{4\\pi } \\\\  & =32(0-0) \\\\  & =0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186179959 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c24c262-4398-5446-bc9d-27645b4f0cc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\displaystyle \\int_{0}^{2π}(2\\cos t + \\sin^{2} t)dt" :db/id #edb/ref 17592186177424} {:answer/id #uuid "a6c38c61-4b53-5b3b-9117-947ce6775169" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\displaystyle \\int_{0}^{2π}(\\cos t + 2\\sin^{2} t)dt" :db/id #edb/ref 17592186177425} {:answer/id #uuid "de07f689-6383-5efe-90dd-91b2b4623e80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\displaystyle \\int_{0}^{2π}(\\cos t + 2\\sin^{2} t)dt" :db/id #edb/ref 17592186177426} {:answer/id #uuid "0eaf656d-f304-5384-9efa-03f1f9909af8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\displaystyle \\int_{0}^{2π}(2\\cos t + \\sin^{2} t)dt" :db/id #edb/ref 17592186177427} {:answer/id #uuid "7ce387ae-f4c2-5ae9-a54a-6936b3b4fe44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\displaystyle \\int_{0}^{2π}(\\cos^{2} t + 2\\sin t)dt" :db/id #edb/ref 17592186177428}] :answer-field/id #uuid "8f90318c-819f-5544-b17a-bb82ed972697" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186177423} {:answer-field/choices [{:answer/id #uuid "493c72c7-d782-5717-bb31-6b0270646703" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{\\int }_{0}^{2\\pi }({cos}^{2}⁡t+2\\operatorname{sin}⁡t)\\,\\text{d}t" :db/id #edb/ref 17592186387176} {:answer/id #uuid "a9663772-7b34-5824-82d4-530f49fc606a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{2\\pi }(2\\operatorname{cos}⁡t+{sin}^{2}⁡t)\\,\\text{d}t" :db/id #edb/ref 17592186387177} {:answer/id #uuid "c397de39-3c94-523e-b199-d82ded805b9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{2\\pi }(\\operatorname{cos}⁡t+2{sin}^{2}⁡t)\\,\\text{d}t" :db/id #edb/ref 17592186387178} {:answer/id #uuid "9e22557f-8b13-5a8f-9cf2-c6c3704ac0bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{\\int }_{0}^{2\\pi }(2\\operatorname{cos}⁡t+{sin}^{2}⁡t)\\,\\text{d}t" :db/id #edb/ref 17592186387179} {:answer/id #uuid "dad10713-d816-5d20-9f77-54c2d84897ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{\\int }_{0}^{2\\pi }(\\operatorname{cos}⁡t+2{sin}^{2}⁡t)\\,\\text{d}t" :db/id #edb/ref 17592186387180}] :answer-field/correct {:answer/id #uuid "dad10713-d816-5d20-9f77-54c2d84897ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{\\int }_{0}^{2\\pi }(\\operatorname{cos}⁡t+2{sin}^{2}⁡t)\\,\\text{d}t" :db/id #edb/ref 17592186387180} :answer-field/id #uuid "a7ee2bd2-6018-5d27-a3ae-041cc035912b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387175}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c8f5c163-ed26-54b5-8aab-82f3a498034d" :question/math-academy-id "q-122263" :question/problem "Which of the following gives the line integral of the function $f(x,y)=x+{y}^{2},$ traversed once along the circle $C$ with equation ${x}^{2}+{y}^{2}=4?$" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nThe curve $C$ is a circle of radius $2$ centered at $O.$ It can be parametrized as \n\n$$\nr(t)=⟨2\\operatorname{cos}⁡t,\\,2\\operatorname{sin}⁡t⟩,\\,0\\le t<2\\pi .\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)j \\\\  & =-2\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-2\\operatorname{sin}⁡t)^{2}+(2\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{4{sin}^{2}⁡t+4{cos}^{2}⁡t} \\\\  & =\\sqrt{4({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =2\\end{aligned}\n$$\n\nNow, since $f(x,y)=x+{y}^{2},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =2\\operatorname{cos}⁡t+(2\\operatorname{sin}⁡t)^{2} \\\\  & =2\\operatorname{cos}⁡t+4{sin}^{2}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(2\\operatorname{cos}⁡t+4{sin}^{2}⁡t)\\cdot 2\\cdot \\text{d}t \\\\  & =4{\\int }_{0}^{2\\pi }(\\operatorname{cos}⁡t+2{sin}^{2}⁡t)\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186179962 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18621f5a-7133-571b-88ef-53eb0deed3c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{3\\pi /2}\\operatorname{tan}⁡t\\sqrt{15{sin}^{2}⁡t+1}\\,\\text{d}t" :db/id #edb/ref 17592186253880} {:answer/id #uuid "644bb80a-08b0-5a24-bfe8-6878fa59640a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{3\\pi /2}\\operatorname{cot}⁡t\\sqrt{5{sin}^{2}⁡t+3}\\,\\text{d}t" :db/id #edb/ref 17592186254569} {:answer/id #uuid "9c6a3057-6ace-5530-947c-d9f8b98ee510" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi /2}^{\\pi /2}4\\operatorname{cot}⁡t\\sqrt{{sin}^{2}⁡t+15}\\,\\text{d}t" :db/id #edb/ref 17592186255048} {:answer/id #uuid "a9e161d4-6bd1-5a00-a1f3-e07b0c70af01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{3\\pi /2}4\\operatorname{tan}⁡t\\sqrt{5{sin}^{2}⁡t+3}\\,\\text{d}t" :db/id #edb/ref 17592186255171} {:answer/id #uuid "aa1ba099-2805-5efa-92dd-2e4223b1218b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{tan}⁡t\\sqrt{15{sin}^{2}⁡t+1}\\,\\text{d}t" :db/id #edb/ref 17592186255173}] :answer-field/correct {:answer/id #uuid "18621f5a-7133-571b-88ef-53eb0deed3c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{3\\pi /2}\\operatorname{tan}⁡t\\sqrt{15{sin}^{2}⁡t+1}\\,\\text{d}t" :db/id #edb/ref 17592186253880} :answer-field/id #uuid "56c08944-18ef-5fdc-9330-4e14892bd61a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256089}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "939eabb6-2bce-5cdb-8479-d0b9ae63294a" :question/math-academy-id "q-122269" :question/problem "![](images/3b/3bf746cfb21805587a65c7beeac90e75464f630bab1fbf3453de69ca3e6639eb.png)\n\nWhich of the following gives the line integral ${\\int }_{C}\\frac{4y}{x}\\,\\text{d}s,$ where the curve $C$ is the left half of the ellipse ${x}^{2}+16{y}^{2}=16,$ shown above?" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nNote that we can write the equation of our ellipse in the form\n\n$$\n\\frac{{x}^{2}}{{4}^{2}}+{y}^{2}=1.\n$$\n\nSo, the curve $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $4$ and $1,$ respectively. Therefore, it can be parametrized as \n\n$$\nr(t)=⟨4\\operatorname{cos}⁡t,\\,\\operatorname{sin}⁡t⟩,\\,\\frac{\\pi }{2}\\le t\\le \\frac{3\\pi }{2}.\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)j \\\\  & =-4\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-4\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{16{sin}^{2}⁡t+{cos}^{2}⁡t} \\\\  & =\\sqrt{15{sin}^{2}⁡t+({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\sqrt{15{sin}^{2}⁡t+1}\\end{aligned}\n$$\n\nNow, since $f(x,y)=\\frac{4y}{x},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{4y}{x} \\\\  & =4\\cdot \\frac{\\operatorname{sin}⁡t}{(4\\operatorname{cos}⁡t)} \\\\  & =\\operatorname{tan}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{4y}{x}\\,\\text{d}s & ={\\int }_{\\pi /2}^{3\\pi /2}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{3\\pi /2}\\operatorname{tan}⁡t\\sqrt{15{sin}^{2}⁡t+1}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186179963 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "814fc6cf-8415-51dc-aa71-2b2dcbf81962" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{53}{4}" :db/id #edb/ref 17592186254814} {:answer/id #uuid "86f05304-f4c1-54b6-a4c5-000eafd2bbb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{47}{4}" :db/id #edb/ref 17592186254865} {:answer/id #uuid "b9b6b72a-eb09-5d1b-85c0-269d51d0e83c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{67}{4}" :db/id #edb/ref 17592186255324} {:answer/id #uuid "be619077-ef60-58f6-93be-483e6d9cbf83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{51}{4}" :db/id #edb/ref 17592186255369} {:answer/id #uuid "ccf2dc83-c0d2-5f55-bd25-8b17407e5e55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{61}{4}" :db/id #edb/ref 17592186255492}] :answer-field/correct {:answer/id #uuid "ccf2dc83-c0d2-5f55-bd25-8b17407e5e55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{61}{4}" :db/id #edb/ref 17592186255492} :answer-field/id #uuid "50ce09ca-94dc-54bf-a873-caeb486ff0fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256080}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9a72d2a3-84b0-5b95-afa8-d5133b8bf8f5" :question/math-academy-id "q-122271" :question/problem "Evaluate the line integral\n${\\int }_{C}\\frac{24x}{y}\\,\\text{d}s,$\nwhere $C$ is the arc of the parabola ${y}^{2}=8x$ from $(0,0)$ to $(\\frac{9}{8},3).$" :question/worked-solution "Notice that the given curve can be expressed in the form $x=x(y),$ as follows:\n\n$$\n{y}^{2}=8x\\,⟹\\,x=\\frac{{y}^{2}}{8}.\n$$\n\nTherefore, by setting $y=t,$ we have\n\n$$\nx=x(t)=\\frac{{t}^{2}}{8}.\n$$\n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=⟨\\frac{{t}^{2}}{8},\\,t⟩,\\,0\\le t\\le 3\n$$\n\nNote that the domain $0\\le t\\le 3$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{{t}^{2}}{8})i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =\\frac{t}{4}\\,i+j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{(\\frac{t}{4})}^{2}+{1}^{2}} \\\\  & =\\sqrt{\\frac{{t}^{2}}{16}+1} \\\\  & =\\frac{1}{4}\\sqrt{{t}^{2}+16}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=\\frac{24x}{y}$, then we obtain \n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{24x}{y} \\\\  & =\\frac{24\\cdot (\\frac{{t}^{2}}{8})}{t} \\\\  & =3t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{24x}{y}\\,\\text{d}s & ={\\int }_{0}^{3}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}3t\\cdot \\frac{1}{4}\\sqrt{{t}^{2}+16}\\cdot \\text{d}t \\\\  & =\\frac{3}{4}{\\int }_{0}^{3}t\\sqrt{{t}^{2}+16}\\,\\text{d}t.\\end{aligned}\n$$\n\nFinally, we solve this using the substitution $u={t}^{2}+16,$ $\\text{d}u=2t\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}\\frac{3}{4}{\\int }_{0}^{3}t\\sqrt{{t}^{2}+16}\\,\\text{d}t & =\\frac{3}{8}{\\int }_{16}^{25}\\sqrt{u}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\cdot {u}^{3/2}\\,{|}_{16}^{25} \\\\  & =\\frac{1}{4}({25}^{3/2}-{16}^{3/2}) \\\\  & =\\frac{1}{4}(125-64) \\\\  & =\\frac{61}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186179968 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03e7f000-2d2b-551e-80dd-e04e2acee2ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{\\int }_{3\\pi /2}^{2\\pi }\\operatorname{sin}⁡t\\,{e}^{4\\operatorname{cos}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186253701} {:answer/id #uuid "1dfb99c9-c4f2-5b3f-bd12-1c6c7092dd70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{\\int }_{3\\pi /2}^{2\\pi }\\operatorname{cos}⁡t\\,{e}^{4\\operatorname{sin}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186253922} {:answer/id #uuid "4821693d-3621-5434-a86b-7624d2be2de2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{\\int }_{\\pi /2}^{2\\pi }\\operatorname{cos}⁡t\\,{e}^{4\\operatorname{sin}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186254283} {:answer/id #uuid "8efd5e79-5f84-56f4-a89d-cbfaa679144d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{\\int }_{3\\pi /2}^{2\\pi }\\operatorname{sin}⁡t\\,{e}^{4\\operatorname{cos}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186254926} {:answer/id #uuid "f844b804-93be-5b90-bda6-d59e3a5be4b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{\\int }_{3\\pi /2}^{2\\pi }\\operatorname{cos}⁡t\\,{e}^{4\\operatorname{sin}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186255842}] :answer-field/correct {:answer/id #uuid "1dfb99c9-c4f2-5b3f-bd12-1c6c7092dd70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{\\int }_{3\\pi /2}^{2\\pi }\\operatorname{cos}⁡t\\,{e}^{4\\operatorname{sin}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186253922} :answer-field/id #uuid "72ee3597-1dd0-5de1-b56b-43f4da9ab07f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256130}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dcd58e0c-8630-5c7a-a6a1-6bb6a8bcb260" :question/math-academy-id "q-122440" :question/problem "Which of the following gives the line integral of the function $f(x,y)=x{e}^{y}$ along the quarter-circle ${x}^{2}+{y}^{2}=16,$ traversed from the point $(0,-4)$ to the point $(4,0)$ in the fourth quadrant?" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nThe curve $C$ is a part-circle of radius $4$ centered at $O,$ shown below. \n\n![](images/0b/0baaafbe9846ccef2c06a3b1a86eccac394344afc2dfd94bba2907ebb1cf2362.png)\n\nThe curve $C$ can be parametrized as \n\n$$\nr(t)=⟨4\\operatorname{cos}⁡t,\\,4\\operatorname{sin}⁡t⟩,\\,\\frac{3\\pi }{2}\\le t\\le 2\\pi .\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{sin}⁡t)j \\\\  & =-4\\operatorname{sin}⁡t\\,i+4\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-4\\operatorname{sin}⁡t)^{2}+(4\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{16{sin}^{2}⁡t+16{cos}^{2}⁡t} \\\\  & =\\sqrt{16({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =4\\end{aligned}\n$$\n\nNow, since $f(x,y)=x{e}^{y},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =4\\operatorname{cos}⁡t\\,{e}^{4\\operatorname{sin}⁡t}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}x{e}^{y}\\,\\text{d}s & ={\\int }_{3\\pi /2}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{3\\pi /2}^{2\\pi }4\\operatorname{cos}⁡t\\,{e}^{4\\operatorname{sin}⁡t}\\cdot 4\\cdot \\text{d}t \\\\  & =16{\\int }_{3\\pi /2}^{2\\pi }\\operatorname{cos}⁡t\\,{e}^{4\\operatorname{sin}⁡t}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186179973 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ba90d78-1161-52a4-93c0-d995aaaf7e51" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6c/6cf967e8a5d3bc7b2ac021414875f5221ef52790dfbdd6e214cccc7f0e8be2d2.png" :db/id #edb/ref 17592186387299} {:answer/id #uuid "bb982230-23d8-541a-a311-793fcd335e70" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4b/4be9586aaa886ccfe092f93c106a5f7233509c798c9a90ecfda0363173dc7afb.png" :db/id #edb/ref 17592186387300} {:answer/id #uuid "6f167c07-25dc-5f9e-956f-2fe0933e7ed6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/95/9593ba00b964194c1d91549fe38a1334a478ffd6b724534c4512a11d19d683aa.png" :db/id #edb/ref 17592186387301} {:answer/id #uuid "640a700e-3b7c-59e8-83e6-b88bdc953d51" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f8/f814f8c7e6d879cbe25e5108704e29464d0c39859371ee4fac3bfb3e72f90696.png" :db/id #edb/ref 17592186387302} {:answer/id #uuid "09b9b72e-d802-5315-b38d-ee456018cf2f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/26/26a5c0123d93231a800456e9f06f6ba7450861838c87d4d1b3ae77dab4cec6cf.png" :db/id #edb/ref 17592186387303}] :answer-field/correct {:answer/id #uuid "09b9b72e-d802-5315-b38d-ee456018cf2f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/26/26a5c0123d93231a800456e9f06f6ba7450861838c87d4d1b3ae77dab4cec6cf.png" :db/id #edb/ref 17592186387303} :answer-field/id #uuid "a7fe3fc1-2c7d-5b68-96b7-12857eae01aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387298}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fe3ebbef-9b0f-50cb-ab18-6df5f7b1d83c" :question/math-academy-id "q-122789" :question/problem "Which of the following diagrams represents the gradient vector field of the function $f(x,y)=\\frac{{x}^{3}-2{y}^{2}}{4}?$" :question/worked-solution "The gradient vector field of a function $f$ is given by $∇f.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\frac{{x}^{3}-2{y}^{2}}{4}) \\\\  & =\\frac{3}{4}{x}^{2} \\\\ {f}_{y}(x,y) & =\\frac{∂}{∂y}(\\frac{{x}^{3}-2{y}^{2}}{4}) \\\\  & =-y\\end{aligned}\n$$\n\nSo, the gradient vector field of $f(x,y)$ is\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{3}{4}{x}^{2}\\,i-y\\,j.\\end{aligned}\n$$\n\nNext, we have to sketch the vector field at the points $(-2,2),$ $(2,-3),$ and $(2,1).$\n\nTo sketch the vector field at the given points, we substitute their coordinates into the expression for $∇f.$\n\n$$\n\\begin{aligned}∇f(-2,2) & =\\frac{3}{4}\\cdot (-2)^{2}\\,i-2\\,j=3\\,i-2\\,j \\\\ ∇f(2,-3) & =\\frac{3}{4}\\cdot {2}^{2}\\,i-(-3)\\,j=3\\,i+3\\,j \\\\ ∇f(2,1) & =\\frac{3}{4}\\cdot {2}^{2}\\,i-\\,j=3\\,i-j\\end{aligned}\n$$\n\nNow, we draw the vectors starting at the corresponding points and obtain the following diagram:\n\n![](images/26/26a5c0123d93231a800456e9f06f6ba7450861838c87d4d1b3ae77dab4cec6cf.png)"} {:db/id #edb/ref 17592186179981 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c16fe8e-df28-5acf-80d4-30daf328aacf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}{\\int }_{0}^{1}({t}^{2}-t+2)\\text{d}t" :db/id #edb/ref 17592186253906} {:answer/id #uuid "5aca3d77-fbac-59a8-a8e8-f141fffb748d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{1}({t}^{2}+t-2)\\text{d}t" :db/id #edb/ref 17592186254472} {:answer/id #uuid "6641d652-1c79-5594-8a40-67438b550538" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}{\\int }_{0}^{1}(9{t}^{2}+t-2)\\text{d}t" :db/id #edb/ref 17592186254589} {:answer/id #uuid "b2a3d234-e957-5e8d-85be-bdebd0026797" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10{\\int }_{0}^{1}(9{t}^{2}+t-2)\\text{d}t" :db/id #edb/ref 17592186255242} {:answer/id #uuid "edb11fd3-821e-5d36-891b-095d0de53681" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}{\\int }_{0}^{1}({t}^{2}-t+2)\\text{d}t" :db/id #edb/ref 17592186255748}] :answer-field/correct {:answer/id #uuid "6641d652-1c79-5594-8a40-67438b550538" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}{\\int }_{0}^{1}(9{t}^{2}+t-2)\\text{d}t" :db/id #edb/ref 17592186254589} :answer-field/id #uuid "761e5ab1-caf4-5260-859c-054aab437559" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256139}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "09a46495-b2d7-513a-938f-504451202710" :question/math-academy-id "q-123127" :question/problem "Which of the following is equivalent to the line integral of the function $f(x,y)={x}^{2}-y,$ traversed along the line segment from $(0,2)$ to $(3,1)?$" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{t}_{a}}^{{t}_{b}}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t,\n$$\n\n \n\nwhere $C$ is the line segment from $(0,2)$ to $(3,1).$ \n\nThe position vectors of the endpoints of our line segment are $a=2\\,j$ and $b=3\\,i+j.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =2\\,j+t[(3\\,i+j)-2\\,j] \\\\  & =2\\,j+t(3\\,i-j) \\\\  & =3t\\,i+(2-t)\\,j\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$ Thus, we have that $x=3t$ and $y=2-t$ along the segment.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3t)i+\\frac{\\text{d}}{\\text{d}t}(2-t)j \\\\  & =3\\,i-j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{3}^{2}+(-1)^{2}} \\\\  & =\\sqrt{10}\\end{aligned}\n$$\n\nNow, since $f(x,y)={x}^{2}-y$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(3t)^{2}-(2-t) \\\\  & =9{t}^{2}+t-2.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{1}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(9{t}^{2}+t-2)\\cdot \\sqrt{10}\\cdot \\text{d}t \\\\  & =\\sqrt{10}{\\int }_{0}^{1}(9{t}^{2}+t-2)\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186179984 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22a10aec-2de8-522a-80d0-b6ac69c3fc36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{cos}⁡2t\\sqrt{{cos}^{2}⁡t+5}\\,\\text{d}t" :db/id #edb/ref 17592186257069} {:answer/id #uuid "245e377f-d794-5faa-80dc-046dd074c5d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }\\operatorname{cos}⁡2t\\sqrt{5{cos}^{2}⁡t+1}\\,\\text{d}t" :db/id #edb/ref 17592186257088} {:answer/id #uuid "59416cb9-04ed-59ee-bb6f-e3a4d50a609c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{cos}⁡2t\\sqrt{5{cos}^{2}⁡t+1}\\,\\text{d}t" :db/id #edb/ref 17592186257556} {:answer/id #uuid "922d00d6-8ac5-59b8-b6b0-c621f39534d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{sin}⁡2t\\sqrt{5{cos}^{2}⁡t+1}\\,\\text{d}t" :db/id #edb/ref 17592186258071} {:answer/id #uuid "aa428e1b-e786-5467-88b9-85fb757023e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{\\int }_{0}^{\\pi }\\operatorname{sin}⁡2t\\sqrt{{cos}^{2}⁡t+5}\\,\\text{d}t" :db/id #edb/ref 17592186258266}] :answer-field/correct {:answer/id #uuid "59416cb9-04ed-59ee-bb6f-e3a4d50a609c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{cos}⁡2t\\sqrt{5{cos}^{2}⁡t+1}\\,\\text{d}t" :db/id #edb/ref 17592186257556} :answer-field/id #uuid "f90be87a-aed6-507f-bb3d-7e829ec213e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259469}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4f83a1e2-579b-5a18-9def-ff09a4759ecd" :question/math-academy-id "q-123193" :question/problem "![](images/0b/0b0f3ae9a464812957c297c09ff3f65bfe5964bdac70298e72ec3dbde2325e72.png)\n\nWhich of the following gives the line integral ${\\int }_{C}(6{x}^{2}-{y}^{2})\\,\\text{d}s,$ where the curve $C$ is the right half of the ellipse $6{x}^{2}+{y}^{2}=6,$ shown above?" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nNote that we can write the equation of our ellipse in the form\n\n$$\n\\frac{{x}^{2}}{{1}^{2}}+\\frac{{y}^{2}}{(\\sqrt{6})^{2}}=1.\n$$\n\nSo, the curve $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $1$ and $\\sqrt{6},$ respectively. Therefore, it can be parametrized as \n\n$$\nr(t)=⟨\\operatorname{cos}⁡t,\\,\\sqrt{6}\\operatorname{sin}⁡t⟩,\\,-\\frac{\\pi }{2}\\le t\\le \\frac{\\pi }{2}.\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(\\sqrt{6}\\operatorname{sin}⁡t)j \\\\  & =-\\operatorname{sin}⁡t\\,i+\\sqrt{6}\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-\\operatorname{sin}⁡t)^{2}+(\\sqrt{6}\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{{sin}^{2}⁡t+6{cos}^{2}⁡t} \\\\  & =\\sqrt{5{cos}^{2}⁡t+({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\sqrt{5{cos}^{2}⁡t+1}\\end{aligned}\n$$\n\nNow, since $f(x,y)=6{x}^{2}-{y}^{2},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =6(\\operatorname{cos}⁡t)^{2}-(\\sqrt{6}\\operatorname{sin}⁡t)^{2} \\\\  & =6{cos}^{2}⁡t-6{sin}^{2}⁡t \\\\  & =6({cos}^{2}⁡t-{sin}^{2}⁡t) \\\\  & =6\\operatorname{cos}⁡2t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}(6{x}^{2}-{y}^{2})\\,\\text{d}s & ={\\int }_{-\\pi /2}^{\\pi /2}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}6\\operatorname{cos}⁡2t\\sqrt{5{cos}^{2}⁡t+1}\\,\\text{d}t \\\\  & =6{\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{cos}⁡2t\\sqrt{5{cos}^{2}⁡t+1}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186179986 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "711177e4-868e-5ac6-a2b1-961ab8f94f30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\operatorname{ln}⁡(2-t)\\,\\text{d}t" :db/id #edb/ref 17592186257775} {:answer/id #uuid "8860493e-bab1-52a0-9bf9-eb7d11745d38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\operatorname{ln}⁡(3-2t)\\,\\text{d}t" :db/id #edb/ref 17592186257977} {:answer/id #uuid "b78bc20f-293d-5acf-9926-a6d8bb185d88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}{\\int }_{0}^{1}\\operatorname{ln}⁡(3-2t)\\,\\text{d}t" :db/id #edb/ref 17592186258386} {:answer/id #uuid "db0fb6b5-5dcc-57a4-a8f1-684f9c0bb985" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\operatorname{ln}⁡(4-t)\\,\\text{d}t" :db/id #edb/ref 17592186258695} {:answer/id #uuid "f570bf13-b1d2-5f54-853f-bb075d272c17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}{\\int }_{0}^{1}\\operatorname{ln}⁡(4-t)\\,\\text{d}t" :db/id #edb/ref 17592186258924}] :answer-field/correct {:answer/id #uuid "db0fb6b5-5dcc-57a4-a8f1-684f9c0bb985" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\operatorname{ln}⁡(4-t)\\,\\text{d}t" :db/id #edb/ref 17592186258695} :answer-field/id #uuid "d19b03b6-7a81-55e6-a56b-0d4882ea6475" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259400}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9fb44c65-3cac-5280-b910-d92f6181f8ef" :question/math-academy-id "q-123269" :question/problem "Which of the following is equivalent to the line integral of the function $f(x,y)=\\operatorname{ln}⁡(x+y),$ traversed along the line segment from $(1,3)$ to $(0,3)?$" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{t}_{a}}^{{t}_{b}}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t,\n$$\n\n \n\nwhere $C$ is the line segment from $(1,3)$ to $(0,3).$ \n\nThe position vectors of the endpoints of our line segment are $a=i+3\\,j$ and $b=3\\,j.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =(i+3\\,j)+t[3\\,j-(i+3\\,j)] \\\\  & =(i+3\\,j)-t\\,i \\\\  & =(1-t)\\,i+3\\,j\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$ Thus, we have that $x=1-t$ and $y=3$ along the segment.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(1-t)i+\\frac{\\text{d}}{\\text{d}t}(3)j \\\\  & =-i \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-1)^{2}+{0}^{2}} \\\\  & =1\\end{aligned}\n$$\n\nNow, since $f(x,y)=\\operatorname{ln}⁡(x+y)$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\operatorname{ln}⁡((1-t)+3) \\\\  & =\\operatorname{ln}⁡(4-t).\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{1}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\operatorname{ln}⁡(4-t)\\cdot 1\\cdot \\text{d}t \\\\  & ={\\int }_{0}^{1}\\operatorname{ln}⁡(4-t)\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186180044 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82419925-9208-5fb7-aeb8-1c2b460f3d3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186177934} {:answer/id #uuid "ae358084-2a52-5121-a957-ccc00fc2b986" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186177935} {:answer/id #uuid "f3e72b9c-5d7c-5fc7-8742-f34b5d473a98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186177936} {:answer/id #uuid "02f393d9-a672-5d17-9a29-a1440878bd81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186177937} {:answer/id #uuid "5b31f798-8fdd-59fb-8d05-4698e80b7f6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186177938}] :answer-field/id #uuid "3893be01-8223-5deb-81ac-945c190891e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186177933}] :question/id #uuid "01c89c10-f3d0-5af6-a0bd-1594a28b8902" :question/math-academy-id "q-127981" :question/problem "Find the value of $\\frac{1}{8} \\div (-\\frac{1}{24})$."} {:db/id #edb/ref 17592186180045 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96f807c8-4c92-59d2-832e-9a8799cb416f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186177940} {:answer/id #uuid "216e665e-c853-524e-bfcb-53cf05ed91c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186177941} {:answer/id #uuid "45329cd5-f9c8-53ea-a696-3aaf0effb65e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{6}" :db/id #edb/ref 17592186177942} {:answer/id #uuid "4a829686-6b6d-50f8-a716-74a2521f4265" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186177943} {:answer/id #uuid "4ce695e1-07f5-5d7e-8be9-f2a59bd5d345" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186177944}] :answer-field/id #uuid "e7c97726-d313-53db-b8a1-6da384c91ef7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186177939}] :question/id #uuid "ac49f5b5-a998-54ba-b277-258063656b3d" :question/math-academy-id "q-127982" :question/problem "What is the value of $(-\\frac{5}{8}) \\div (-\\frac{3}{4})$?"} {:db/id #edb/ref 17592186180046 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9023dacb-eeda-56db-8d1b-6dee28e3d304" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{13}" :db/id #edb/ref 17592186177946} {:answer/id #uuid "f387802e-1ce6-57c0-bb69-e842a42b296a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{13}" :db/id #edb/ref 17592186177947} {:answer/id #uuid "f91c6dfe-5bb9-5582-a74c-754e1af88ea1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{65}" :db/id #edb/ref 17592186177948} {:answer/id #uuid "3ae13dcb-c4ed-59a5-ac12-4b1ed05c4d11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{65}" :db/id #edb/ref 17592186177949} {:answer/id #uuid "51b38409-acc7-5b85-85ff-3ef64661f723" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{13}" :db/id #edb/ref 17592186177950}] :answer-field/correct {:answer/id #uuid "f387802e-1ce6-57c0-bb69-e842a42b296a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{13}" :db/id #edb/ref 17592186177947} :answer-field/id #uuid "efdb995d-208b-57ad-82d7-1b0f09c33bf5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186177945}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "06dbdab8-c946-5c87-85a9-b4822fda3e4f" :question/math-academy-id "q-127984" :question/problem "Find the value of $(-\\frac{10}{13})÷5.$" :question/worked-solution "Dividing a negative number by a positive number gives a negative number. Hence, the result will be negative.\n\nTherefore, since \n\n$$\n\\frac{10}{13}÷5=\\frac{10}{13\\times 5}=\\frac{10}{65}=\\frac{2}{13},\n$$\n\nwe obtain\n\n$$\n(-\\frac{10}{13})÷5=-\\frac{2}{13}.\n$$"} {:db/id #edb/ref 17592186180047 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8b65fa1-1a3d-5d36-a338-50028cea3d91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186177952} {:answer/id #uuid "07e8dfa9-5b71-52db-bcea-1b6d7b2ec676" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186177953} {:answer/id #uuid "381f8fd7-83b9-5f43-a1c7-95a04321fdcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186177954} {:answer/id #uuid "5a305bed-b447-5413-bfa4-f39e14654e6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186177955} {:answer/id #uuid "6172cb80-6e07-5ba4-aac8-64c9afc315ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186177956}] :answer-field/id #uuid "7ea62459-de0e-5a39-b989-ef5b2ebbc34b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186177951}] :question/id #uuid "07fa4cc1-ea7c-549d-a545-29bfcb36c452" :question/math-academy-id "q-127985" :question/problem "What is the value of $(-10) \\div (-\\frac{2}{3})$?"} {:db/id #edb/ref 17592186180051 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5068094-5f6a-5e13-8616-721b619a581b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(-\\frac{1}{2})^{n} - 2(3)^{n}" :db/id #edb/ref 17592186177976} {:answer/id #uuid "054ab84f-e11c-598c-8d36-56dc5a5f2806" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2)^{n} - 2(3)^{n}" :db/id #edb/ref 17592186177977} {:answer/id #uuid "1162d7f5-b6be-5004-b01c-4e7df8075b06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(-2)^{n} - 2(3)^{n}" :db/id #edb/ref 17592186177978} {:answer/id #uuid "390c91f2-d99b-5acd-adcd-909e6f19fe84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(-\\frac{1}{2})^{n} + (3)^{n}" :db/id #edb/ref 17592186177979} {:answer/id #uuid "6399f591-37ce-5dc6-88a1-73b84d8172ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{1}{2})^{n} + 2(3)^{n}" :db/id #edb/ref 17592186177980}] :answer-field/id #uuid "a24db435-03b5-5115-a0f0-e9f11da1b620" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186177975}] :question/id #uuid "b18e61c8-ac15-50fb-9158-27e01573d320" :question/math-academy-id "q-128812" :question/problem "Find an expression for the general term $a_{n}$ for $n \\ge 0$ of the sequence with the generating function $\\frac{1}{x + 2} + \\frac{2}{3x - 1}$."} {:db/id #edb/ref 17592186180095 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14c7c168-82cc-5a17-8be8-9939e4bcb088" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,m/s" :db/id #edb/ref 17592186529621} {:answer/id #uuid "6b9db7eb-b9e6-55b2-9175-d64b7726f9d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}\\,m/s" :db/id #edb/ref 17592186529853} {:answer/id #uuid "b13777e2-0bb2-5afd-b6d7-72e4ed755e89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}\\,m/s" :db/id #edb/ref 17592186530020} {:answer/id #uuid "b1e2de47-0ac9-519b-8def-6431e35f2b9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,m/s" :db/id #edb/ref 17592186530025} {:answer/id #uuid "ca51b212-0699-54e5-80db-f12dc9105127" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}\\,m/s" :db/id #edb/ref 17592186530087}] :answer-field/correct {:answer/id #uuid "ca51b212-0699-54e5-80db-f12dc9105127" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}\\,m/s" :db/id #edb/ref 17592186530087} :answer-field/id #uuid "47f3bda1-6cae-501c-a999-3dbb1502d89d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186178239}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e70a7267-ff55-5f84-86c7-c840d8b569be" :question/math-academy-id "q-163491" :question/problem "A particle $P$ moves along the $x$-axis in the direction of increasing $x$ where $x\\ge 0.$ When the displacement of $P$ from the origin is $x\\,m,$ the velocity is $v\\,m/s,$ and the acceleration is $k(1-x)\\,{m/s}^{2},$ where $k$ is a positive constant. If $P$ has velocity $v=\\sqrt{6}\\,m/s$ at the origin and has velocity $v=3\\,m/s$ when its displacement is $\\frac{3}{2}\\,m,$ find the maximum velocity of the particle." :question/worked-solution "![](images/75/75ef4755be2965b674fc7a5440ff05bb3f37d70507941eb48eeae554fcb2d538.png)\n\nThe extrema of the velocity occur at the critical points of $v.$ Since the acceleration of the particle $P$ is $k(1-x)\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=k(1-x).\n$$\n\nTo find the moments where $v$ is a maximum, we need to solve $\\frac{\\text{d}v}{\\text{d}t}=0$ and test each solution using the first derivative test.\n\nSolving $\\frac{\\text{d}v}{\\text{d}t}=0$ gives\n\n$$\n\\begin{aligned}k(1-x) & =0 \\\\ 1-x & =0 \\\\ x & =1.\\end{aligned}\n$$\n\nHence, the extremum of the velocity function occurs when $x=1\\,m.$\n\nWe now test the extreme value using the first derivative test. We summarize the necessary information in a table, shown below.\n\n| $x$ | $(0,1)$ | $1$ | $(1,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $\\frac{1}{2}$ |  | $\\frac{3}{2}$ |\n| $\\frac{\\text{d}v}{\\text{d}t}$ | $\\frac{k}{2}>0$ | $0$ | $-\\frac{k}{2}<0$ |\n| $v$ | $↗$ | max | $↘$ |\n\nWe conclude that the velocity is maximized when $x=1\\,m.$\n\nNext, using the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our initial equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=k(1-x).\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int k(1-x)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=k(x-\\frac{1}{2}{x}^{2})+C.\n$$\n\nNow, since $v=\\sqrt{6}\\,{m/s}^{2}$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =k(\\frac{1}{2}{x}^{2}-x)+C \\\\ \\frac{1}{2}(\\sqrt{6})^{2} & =k(0-\\frac{1}{2}(0)^{2})+C \\\\ C & =3\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=k(x-\\frac{1}{2}{x}^{2})+3.\n$$\n\nAlso, since $v=3\\,{m/s}^{2}$ when $x=\\frac{3}{2}\\,m,$ we can find the value of the positive constant $k,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =k(x-\\frac{1}{2}{x}^{2})+3 \\\\ \\frac{1}{2}(3)^{2} & =k(\\frac{3}{2}-\\frac{1}{2}{(\\frac{3}{2})}^{2})+3 \\\\ \\frac{9}{2} & =\\frac{3}{8}k+3 \\\\ \\frac{3}{8}k & =\\frac{3}{2} \\\\ k & =4.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =4x-2{x}^{2}+3 \\\\ {v}^{2} & =8x-4{x}^{2}+6 \\\\ v & =\\pm \\sqrt{8x-4{x}^{2}+6}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing $x,$ we have that $v(x)>0,$ so we can disregard the negative square root. Therefore,\n\n$$\nv(x)=\\sqrt{8x-4{x}^{2}+6}.\n$$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{max}=v(1)=\\sqrt{8(1)-4(1)^{2}+6}=\\sqrt{10}\\,m/s.\n$$"} {:db/id #edb/ref 17592186180178 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05b58ef3-88cb-5f48-a5ad-2a8ebd9fe489" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-{e}^{2}" :db/id #edb/ref 17592186324024} {:answer/id #uuid "50d3ce4b-91e9-50e5-be2e-217bd0e8638d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{e}^{2}}-2" :db/id #edb/ref 17592186324634} {:answer/id #uuid "6291e7cd-d04f-52bd-8607-0fc13a433b0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}-1" :db/id #edb/ref 17592186324790} {:answer/id #uuid "7b429634-b6de-5be5-94db-a86b7b87bf65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{2}{e}" :db/id #edb/ref 17592186325007} {:answer/id #uuid "a83831c3-ae0d-5759-ae8b-eb2f48f47f33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{e}" :db/id #edb/ref 17592186325402}] :answer-field/correct {:answer/id #uuid "50d3ce4b-91e9-50e5-be2e-217bd0e8638d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{e}^{2}}-2" :db/id #edb/ref 17592186324634} :answer-field/id #uuid "e84998b8-8912-50f1-b594-a9f825576cb8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326640}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ce49b8d5-a7c7-525b-89a9-21901c00319a" :question/math-academy-id "q-40255" :question/problem "![](images/cb/cbd92b205693f1056e4dc2d0fc8154843e62b433b66d9b0ba8918d7f5bb3b8bf.png)\n\nEvaluate the line integral of the function $f(x,y)=x{e}^{y}$ along the circle $C$ with equation ${x}^{2}+{y}^{2}=4,$ traversed from the point $(-2,0)$ to the point $(0,-2),$ as shown above." :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nThe curve $C$ is a part-circle of radius $2$ centered at $O.$ It can be parametrized as \n\n$$\nr(t)=⟨2\\operatorname{cos}⁡t,\\,2\\operatorname{sin}⁡t⟩,\\,\\pi \\le t\\le \\frac{3\\pi }{2}.\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)j \\\\  & =-2\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-2\\operatorname{sin}⁡t)^{2}+(2\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{4{sin}^{2}⁡t+4{cos}^{2}⁡t} \\\\  & =\\sqrt{4({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =2\\end{aligned}\n$$\n\nNow, since $f(x,y)=x{e}^{y}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =2\\operatorname{cos}⁡t\\,{e}^{2\\operatorname{sin}⁡t}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{\\pi }^{3\\pi /2}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{\\pi }^{3\\pi /2}2\\operatorname{cos}⁡t\\,{e}^{2\\operatorname{sin}⁡t}\\cdot 2\\cdot \\text{d}t \\\\  & =2{\\int }_{\\pi }^{3\\pi /2}2\\operatorname{cos}⁡t\\,{e}^{2\\operatorname{sin}⁡t}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=2\\operatorname{sin}⁡t,$ $\\text{d}u=2\\operatorname{cos}⁡t\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}2{\\int }_{\\pi }^{3\\pi /2}2\\operatorname{cos}⁡t\\,{e}^{2\\operatorname{sin}⁡t}\\,\\text{d}t & =2{\\int }_{0}^{-2}{e}^{u}\\,\\text{d}u \\\\  & =2{e}^{u}{|}_{0}^{-2} \\\\  & =2{e}^{-2}-2{e}^{0} \\\\  & =\\frac{2}{{e}^{2}}-2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186180181 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1269fb37-f5f5-5f49-8256-65a8aa8aade1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186324137} {:answer/id #uuid "202d1e9c-c862-5c6c-ae37-26c7ec997456" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{3}" :db/id #edb/ref 17592186324237} {:answer/id #uuid "7ba52178-68df-5d08-aaf9-5d4c9645bdbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186325012} {:answer/id #uuid "a5a81ce8-7c24-5166-bd26-99041082a9f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{3}" :db/id #edb/ref 17592186325380} {:answer/id #uuid "c4f82ca1-73f0-575a-951c-3ca7fa8e19e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{3}" :db/id #edb/ref 17592186325668}] :answer-field/correct {:answer/id #uuid "1269fb37-f5f5-5f49-8256-65a8aa8aade1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186324137} :answer-field/id #uuid "de1ba936-f5f5-59fd-91b3-8a8a870fa20a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326625}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d6d33094-0194-5a44-b10e-00c00343eeb5" :question/math-academy-id "q-41145" :question/problem "![](images/78/78f8ca3e70afb8377748a18d7024ba297e330add59550a41a87025a0145b56bb.png)\n\nEvaluate the line integral ${\\int }_{C}9xy\\,\\text{d}s,$ where the curve $C$ is the quarter of the ellipse ${x}^{2}+4{y}^{2}=4$  traversed from the point $(2,0)$ to the point $(0,1).$" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nNote that we can write the equation of our ellipse in the form\n\n$$\n\\frac{{x}^{2}}{{2}^{2}}+{y}^{2}=1.\n$$\n\nSo, the curve $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $2$ and $1,$ respectively. Therefore, it can be parametrized as \n\n$$\nr(t)=⟨2\\operatorname{cos}⁡t,\\,\\operatorname{sin}⁡t⟩,\\,0\\le t\\le \\frac{\\pi }{2}.\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)j \\\\  & =-2\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-2\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{4{sin}^{2}⁡t+{cos}^{2}⁡t} \\\\  & =\\sqrt{3{sin}^{2}⁡t+({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\sqrt{1+3{sin}^{2}⁡t}\\end{aligned}\n$$\n\nNow, since $f(x,y)=9xy$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =9\\cdot 2\\operatorname{cos}⁡t\\cdot \\operatorname{sin}⁡t=18\\operatorname{sin}⁡t\\,\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}9xy\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}18\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\cdot \\sqrt{1+3{sin}^{2}⁡t}\\cdot \\text{d}t \\\\  & =18{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\sqrt{1+3{sin}^{2}⁡t}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=1+3{sin}^{2}⁡t,$ $\\text{d}u=6\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}18{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\sqrt{1+3{sin}^{2}⁡t}\\,\\text{d}t & =3{\\int }_{1}^{4}\\sqrt{u}\\,\\text{d}u \\\\  & =3\\cdot \\frac{2}{3}{u}^{3/2}{|}_{1}^{4} \\\\  & =2({4}^{3/2}-{1}^{3/2}) \\\\  & =2(8-1) \\\\  & =14\\end{aligned}\n$$"} {:db/id #edb/ref 17592186180193 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94d04608-e288-5781-9fe1-0a2327b3b493" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{15}" :db/id #edb/ref 17592186178703} {:answer/id #uuid "a82dc0b8-5f0c-566a-98e0-d176b8cde633" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186178704} {:answer/id #uuid "cafc40ff-7b30-521d-a6b7-6b2c4b4a951f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{15}{2}" :db/id #edb/ref 17592186178705} {:answer/id #uuid "06549d37-6513-5e2f-b419-335df596858a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{15}" :db/id #edb/ref 17592186178706} {:answer/id #uuid "64fa9e90-abec-5c9b-b9e9-dfa4b2e23124" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6}{5}" :db/id #edb/ref 17592186178707}] :answer-field/id #uuid "a71e9243-9037-5151-93a6-9d772833870b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186178702}] :question/id #uuid "44b26ea2-052f-5b8b-b45b-6ec2b20d49fa" :question/math-academy-id "q-43028" :question/problem "What is $(-\\frac{2}{5}) \\cdot (-\\frac{1}{3})$?"} {:db/id #edb/ref 17592186180194 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92fe86b5-bdf8-5ae2-9902-531c297a1a48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186178709} {:answer/id #uuid "be8c4c25-c189-5b18-8350-43daecd8e907" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186178710} {:answer/id #uuid "da67bed4-7007-540a-9ff1-1597117ea266" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{5}" :db/id #edb/ref 17592186178711} {:answer/id #uuid "48075fd9-3bc6-59bd-958d-f00b7f8f885a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{10}" :db/id #edb/ref 17592186178712} {:answer/id #uuid "6f336292-bac9-58ee-9b61-9aba8a60f462" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{6}" :db/id #edb/ref 17592186178713}] :answer-field/id #uuid "cfcd3af5-70e3-506c-bca4-f59552ba5b02" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186178708}] :question/id #uuid "691091a3-8ca5-5929-a98e-d4db45cbb50b" :question/math-academy-id "q-43029" :question/problem "What is $(-\\frac{1}{2}) \\cdot \\frac{5}{3}$?"} {:db/id #edb/ref 17592186180278 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84a68544-3dee-56d2-b4c7-eeed22d1e2cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2π" :db/id #edb/ref 17592186179213} {:answer/id #uuid "9b9036a3-920f-5615-bfeb-f807ba857652" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{π}" :db/id #edb/ref 17592186179214} {:answer/id #uuid "d94aea65-e2a6-5fe5-abd3-22496a932674" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{π}{2}" :db/id #edb/ref 17592186179215} {:answer/id #uuid "15c8a75a-7643-52b0-b284-d4374f9fef41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186179216} {:answer/id #uuid "173fb852-8a5c-5d4b-acb1-8126fdbffabc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2π}" :db/id #edb/ref 17592186179217}] :answer-field/id #uuid "6f151015-d188-52ae-99fa-d6c0a2bc7f89" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186179212}] :question/id #uuid "bd6e5c6e-c45a-513e-b007-721402a77203" :question/math-academy-id "q-76200" :question/problem "Evaluate the integral $\\displaystyle \\int_(C)\\sin (\\frac{πy}{4})ds$ along the line segment from $(1, 0, 1)$ to $(2, 2, 3)$."} {:db/id #edb/ref 17592186180305 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8578f029-4f65-50a8-9d44-09615f0568f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(2)^{n}" :db/id #edb/ref 17592186179375} {:answer/id #uuid "14e2915b-e0e5-5e79-b681-89eae09c7ef9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}(\\frac{1}{2})^{n}" :db/id #edb/ref 17592186179376} {:answer/id #uuid "1c02cc6f-1227-544e-b46c-e1a2f3fc796d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(\\frac{1}{4})^{n}" :db/id #edb/ref 17592186179377} {:answer/id #uuid "32eb409c-9a2c-5b49-a24a-8aa3e07fb450" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{2})^{n}" :db/id #edb/ref 17592186179378} {:answer/id #uuid "6e9bd2cd-5145-523a-b72b-d7f625c69ec6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(\\frac{1}{2})^{n}" :db/id #edb/ref 17592186179379}] :answer-field/id #uuid "bf837b0c-d8ea-5552-834f-ba16ff419a2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186179374}] :question/id #uuid "a13cc734-cb57-5f09-8f2c-741ef0a9ce01" :question/math-academy-id "q-97247" :question/problem "Find the expression for the general term $a_{n}$ for $n \\ge 0$ of the sequence with the generating function $\\frac{4}{2 - x}$."} {:db/id #edb/ref 17592186180306 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3c0ab00-8ab1-5441-b371-0516c270cd63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5(-\\frac{4}{3})^{n}" :db/id #edb/ref 17592186179381} {:answer/id #uuid "c659a0fe-e75c-5400-815a-6b893f96fe59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5(-\\frac{3}{4})^{n}" :db/id #edb/ref 17592186179382} {:answer/id #uuid "ced0dfc2-12a2-5de6-b447-31ecc978b7bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{3}{4})^{n}" :db/id #edb/ref 17592186179383} {:answer/id #uuid "ffddd4a3-daab-500b-9b3f-f3533f4a4e66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}(-\\frac{4}{3})^{n}" :db/id #edb/ref 17592186179384} {:answer/id #uuid "1531cab2-e1ac-5e21-b5b6-fde9933abe8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}(-\\frac{3}{4})^{n}" :db/id #edb/ref 17592186179385}] :answer-field/id #uuid "2c614954-5180-5903-9ee8-3aab04c26eba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186179380}] :question/id #uuid "8102d63e-138f-5ab6-a9d9-2f70552d0587" :question/math-academy-id "q-97259" :question/problem "Find the expression for the general term $a_{n}$ for $n \\ge 0$ of the sequence with the generating function $\\frac{20}{4 + 3x}$."} {:db/id #edb/ref 17592186183921 :question/id #uuid "563087c2-8d87-5b95-833d-f9892d9276a6" :question/math-academy-id "e-10535" :question/problem "Evaluate $\\lim_\\limits{x \\to 0} \\dfrac{\\arccos(x) -\\pi}{x-\\pi}.$" :question/worked-solution "Let's sketch the graph of $y=\\arccos(x){:}$\n\n![](images/9d/9dcc5a116c2a564547283783a7df7b1cd3a9ab3b76ac24dc2695c4cb367796d5.png)\n\nThe domain of $\\arccos(x)$ is $x \\in [-1,1].$  \n\nNow, substituting $x=0$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}(\\frac{\\operatorname{arccos}⁡(x)-\\pi }{x-\\pi }) & =\\frac{\\operatorname{arccos}⁡(0)-\\pi }{0-\\pi } \\\\  & =\\frac{(\\frac{\\pi }{2}-\\pi )}{(-\\pi )} \\\\  & =\\frac{(-\\frac{\\pi }{2})}{(-\\pi )} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186183923 :question/id #uuid "7ce46ca9-cfff-5e8b-89b9-a2a7b34921fd" :question/math-academy-id "e-10537" :question/problem "Compute the value of $\\lim_\\limits{x \\to \\, \\infty}\\cos\\left( \\dfrac{2}{3}\\arctan \\left(2x+1\\right)\\right).$" :question/worked-solution "First, let's sketch the graph of  $y =\\arctan \\left(2x+1\\right){:}$  \n\n![](images/06/06d01e3eb47f69e5172e0ba3c99708a05c79b12a48764fe29c50e94f93b73dd1.png)\n\nThe domain of   $\\arctan \\left(2x+1 \\right)$ is $(-\\infty,\\infty).$   \n\nAs $x$ increases to $\\infty,$ the graph tends to $y={\\color{blue}\\dfrac{\\pi}{2}}.$ Therefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,\\infty }\\operatorname{cos}⁡(\\frac{2}{3}\\operatorname{arctan}⁡(2x+1)) & =\\operatorname{cos}⁡(\\frac{2}{3}\\cdot (\\frac{\\pi }{2})) \\\\  & =\\operatorname{cos}⁡(\\frac{\\pi }{3}) \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186183948 :question/id #uuid "a99e8d2c-1934-57a9-9a6a-578ec9230f6f" :question/math-academy-id "e-14407" :question/problem "Evaluate the integral $\\displaystyle{\\int_{0}^{\\sqrt {\\ln 4}} 16xe^{-2x^2}\\, \\textrm{d}x}$." :question/worked-solution "Let's introduce the new variable $u=-2x^2.$ Differentiating gives\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=-4x\n\\qquad\\Longrightarrow\\qquad\n-4 \\, \\textrm{d}u=16x \\, \\textrm{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt {\\ln 4}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $-2\\ln 4$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡4}}16x{e}^{-2{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡4}}{e}^{-2{x}^{2}}\\cdot 16x\\,\\text{d}x \\\\  & ={\\int }_{0}^{-2\\operatorname{ln}⁡4}{e}^{u}\\cdot (-4\\,\\text{d}u) \\\\  & =-4{\\int }_{0}^{-2\\operatorname{ln}⁡4}{e}^{u}\\,\\text{d}u \\\\  & =-4{e}^{u}\\,{|}_{0}^{-2\\operatorname{ln}⁡4} \\\\  & =-4({e}^{-2\\operatorname{ln}⁡4}-{e}^{0}) \\\\  & =-4(\\frac{1}{16}-1) \\\\  & =4(\\frac{15}{16}) \\\\  & =\\frac{15}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186183961 :question/id #uuid "fc7c982c-7e5d-5187-9779-6952f32fe2bf" :question/math-academy-id "e-15019" :question/problem "Rewrite the expression \n\n$$\n\\left(x^2 + 7x + \\dfrac{49}{4}\\right) + 3\n$$\n\nas the sum of a perfect square and a constant." :question/worked-solution "First, we recall the following formula:\n\n$$\nx^2 + {\\color{red}{2}}{\\color{blue}{a}}x + a^2 = (x + {\\color{blue}{a}})^2\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}\n& {x}^{2}+7x+\\frac{49}{4} \\\\\n&= {x}^{2}+7x+{(\\frac{7}{2})}^{2} \\\\\n&= {x}^{2}+2\\cdot \\frac{7}{2}x+{(\\frac{7}{2})}^{2} \\\\\n&= {(x+\\frac{7}{2})}^{2}\n\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\n& ({x}^{2}+7x+\\frac{49}{4})+3 \\\\\n&= {(x+\\frac{7}{2})}^{2}+3.\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184051 :question/id #uuid "d30aa8b4-820f-5ed1-8878-c5566805e3cc" :question/math-academy-id "e-3491" :question/problem "Evaluate $\\sin^2\\left(150^\\circ\\right) + 2\\csc^2\\left(240^\\circ\\right)$." :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/d9/d93c490adbb5cdbc0e9a09b60eea9b82ab93be8e871e334423abc17ddd62955e.png)\n\n- Let's first consider the angle $150^\\circ$. From the unit circle, we see that the angle $150^\\circ$ corresponds to the point $\\left(-\\dfrac{\\sqrt{3}}{2}, \\dfrac{1}{2} \\right)$. Since the sine of the angle corresponds to the $y$-coordinate, we have $\\sin 150^\\circ = \\dfrac{1}{2}$.\n- Now, let's consider the angle $240^\\circ$. From the unit circle, we see that the angle $240^\\circ$ corresponds to the point $\\left(-\\dfrac{1}{2}, -\\dfrac{\\sqrt{3}}{2} \\right)$. Since the sine of the angle corresponds to the $y$-coordinate, we have $\\sin 240^\\circ = -\\dfrac{\\sqrt{3}}{2}$.\n\nUsing the fact that\n\n$$\n\\csc{\\theta} = \\dfrac{1}{\\sin\\theta}\n$$\n\nwe have\n\n$$\n\\begin{aligned}\n\\csc 240^{∘} &= \\frac{1}{\\sin 240^{∘}} \\\\\n&= (1)/((-\\frac{\\sqrt{3}}{2})) \\\\\n&=-\\frac{2}{\\sqrt{3}}\n\\end{aligned}\n$$\n\nFinally, we combine the results:\n\n$$\n\\begin{aligned}\n\\sin^{2} (150^{∘}) + 2\\csc^{2} (240^{∘}) &= (\\frac{1}{2})^{2} + 2(-\\frac{2}{\\sqrt{3}})^{2} \\\\\n&= \\frac{1}{4} + 2(\\frac{4}{3}) \\\\\n&= \\frac{1}{4} + \\frac{8}{3} \\\\\n&= \\frac{35}{12}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184052 :question/id #uuid "c049aaef-f59a-5113-b739-20cc7a6d802c" :question/math-academy-id "e-3520" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\sin u = \\dfrac{3}{4}, \\qquad \\cos u =  -\\dfrac{\\sqrt{7}}{4}, \\qquad \\cos v = \\dfrac{4}{5}.\n$$\n\nGiven that $v$ lies in the first quadrant, and\n\n$$\n\\sin\\left(u + v\\right) = \\dfrac{a- b\\sqrt 7}{20},\n$$\n\ncalculate the value of $a+b.$" :question/worked-solution "First, recall the sum formula for sine:\n\n$$\n\\sin(u+v) = \\sin u \\cos v+ \\cos u \\sin v\n$$\n\nWe know the values of $\\sin{u},$ $\\cos{u},$ and $\\cos{v}.$ To find the missing value of $\\sin{v},$ we can use the Pythagorean identity:\n\n$$\n\\sin^2 v + \\cos^2 v= 1 \\qquad\\Longrightarrow\\qquad \\sin^2 v = 1- \\cos^2 v\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{sin}^{2}⁡v & =1-{cos}^{2}⁡v \\\\  & =1-{(\\frac{4}{5})}^{2} \\\\  & =1-\\frac{{4}^{2}}{{5}^{2}} \\\\  & =1-\\frac{16}{25} \\\\  & =\\frac{25}{25}-\\frac{16}{25} \\\\  & =\\frac{25-16}{25} \\\\  & =\\frac{9}{25}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡v & =\\pm \\sqrt{\\frac{9}{25}} \\\\  & =\\pm \\frac{3}{5}.\\end{aligned}\n$$\n\nWe're given that $v$ lies in the first quadrant, where sine is positive. So, we disregard the negative value, and we have \n\n$$\n\\sin v= \\dfrac{3}{5}.\n$$\n\nWe can now apply the sum formula, as follows:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(u+v) & =\\operatorname{sin}⁡u\\operatorname{cos}⁡v+\\operatorname{cos}⁡u\\operatorname{sin}⁡v \\\\  & =(\\frac{3}{4})(\\frac{4}{5})+(-\\frac{\\sqrt{7}}{4})(\\frac{3}{5}) \\\\  & =\\frac{12}{20}-\\frac{3\\sqrt{7}}{20} \\\\  & =\\frac{12-3\\sqrt{7}}{20}\\end{aligned}\n$$\n\nFinally, $a=12, b=3,$ and $a+b = 15.$"} {:db/id #edb/ref 17592186184053 :question/id #uuid "5da3337e-31d2-5f2d-b236-60088b4bf64d" :question/math-academy-id "e-3524" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\sin u = -\\dfrac {4} {5}, \\qquad\n\\cos v = \\dfrac {15} {17}, \\qquad\n\\sin v = \\dfrac {8} {17}.\n$$\n\nGiven that $u$ lies in the third quadrant, find the value of $\\cos\\left(u + v\\right).$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\cos(u + v) = \\cos u \\cos v - \\sin u \\sin v\n$$\n\nWe know the values of $\\sin{u}$, $\\cos{v}$, and $\\sin{v}.$ To find the missing value of $\\cos{u,}$ we can use the Pythagorean identity:\n\n$$\n\\sin^2 u + \\cos^2 u= 1 \\qquad\\Longrightarrow\\qquad \\cos^2 u = 1- \\sin^2 u\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡u & =1-{sin}^{2}⁡u \\\\  & =1-{(-\\frac{4}{5})}^{2} \\\\  & =1-\\frac{{4}^{2}}{{5}^{2}} \\\\  & =1-\\frac{16}{25} \\\\  & =\\frac{25}{25}-\\frac{16}{25} \\\\  & =\\frac{9}{25}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡u & =\\pm \\sqrt{\\frac{9}{25}} \\\\  & =\\pm \\frac{3}{5}.\\end{aligned}\n$$\n\nWe're given that $u$ lies in the third quadrant, where cosine is negative. So, we disregard the positive value, and we have\n\n$$\n\\cos u= -\\dfrac{3}{5}.\n$$\n\nWe can now apply the sum formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(u+v) & =\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v \\\\  & =(-\\frac{3}{5})(\\frac{15}{17})-(-\\frac{4}{5})(\\frac{8}{17}) \\\\  & =-\\frac{45}{85}+\\frac{32}{85} \\\\  & =-\\frac{13}{85}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184054 :question/id #uuid "275efa61-04bc-5a06-80e0-e75069969c7b" :question/math-academy-id "e-3526" :question/problem "Suppose that for the angles $u$ and $v$, we have\n$\\sin u = -\\dfrac{2}{\\sqrt{5}}, \\qquad \\tan v = 4$.\nGiven that $u$ lies in the third quadrant, find the value of $\\tan\\left(u - v\\right)$." :question/worked-solution "First, we recall the difference formula for tangent:\n\n$$\n\\tan(u-v) = \\dfrac{\\tan u - \\tan v}{1+\\tan u \\tan v}\n$$\n\nWe need to find the value of $\\tan u$. To do that, we first find the value of $\\cos{u}$ using the Pythagorean identity:\n\n$$\n\\sin^2 u + \\cos^2 u= 1 \\qquad\\Longrightarrow\\qquad \\cos^2 u = 1- \\sin^2 u\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}\n\\cos^{2} u &= 1 - \\sin^{2} u \\\\\n&= 1 - (-\\frac{2}{\\sqrt{5}})^{2} \\\\\n&= 1 - (\\frac{2}{\\sqrt{5}})^{2} \\\\\n&= 1 - (2^{2})/((\\sqrt{5})^{2}) \\\\\n&= 1 - \\frac{4}{5} \\\\\n&= \\frac{5}{5} - \\frac{4}{5} \\\\\n&= \\frac{1}{5}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\cos u &= ± \\sqrt{\\frac{1}{5}} \\\\\n&= ± \\frac{1}{\\sqrt{5}}\n\\end{aligned}\n$$\n\nWe're given that $u$ lies in the third quadrant, where cosine is negative. So, we disregard the positive value, and we have\n\n$$\n\\cos u = -\\dfrac{1}{\\sqrt{5}}\n$$\n\nWe can now compute $\\tan u$:\n\n$$\n\\begin{aligned}\n\\tan u &= \\frac{\\sin u}{\\cos u} = ((-\\frac{2}{\\sqrt{5}}))/((-\\frac{1}{\\sqrt{5}})) = 2\n\\end{aligned}\n$$\n\nFinally, we use the difference formula for the tangent:\n\n$$\n\\begin{aligned}\n\\tan (u - v) &= \\frac{\\tan u - \\tan v}{1 + \\tan u\\tan v} \\\\\n&= \\frac{2 - 4}{1 + 2 \\cdot 4} \\\\\n&= ((-2))/(9) \\\\\n&=-\\frac{2}{9}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184057 :question/id #uuid "e4a94ca8-82ee-5776-a46d-b735d4ab60fb" :question/math-academy-id "e-371" :question/problem "Find the integral of $x^2 + 1.$" :question/worked-solution "Applying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int {x}^{2}+1\\,\\text{d}x & =\\int {x}^{2}\\,\\text{d}x+\\int 1\\,\\text{d}x \\\\  & =\\int {x}^{2}\\,\\text{d}x+\\int {x}^{0}\\,\\text{d}x \\\\  & =(\\frac{{x}^{2+1}}{2+1})+x+C \\\\  & =\\frac{1}{3}{x}^{3}+x+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184058 :question/id #uuid "ea7dadee-2b44-5e62-bef4-26fb0cb185ea" :question/math-academy-id "e-372" :question/problem "Calculate $\\displaystyle \\int 2 x^3 - x \\,\\textrm d x.$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int 2{x}^{3}-x\\,\\text{d}x & =2\\int {x}^{3}\\,\\text{d}x-\\int x\\,\\text{d}x \\\\  & =2(\\frac{{x}^{3+1}}{3+1})-(\\frac{{x}^{1+1}}{1+1})+C \\\\  & =2(\\frac{{x}^{4}}{4})-(\\frac{{x}^{2}}{2})+C \\\\  & =\\frac{{x}^{4}}{2}-\\frac{{x}^{2}}{2}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184059 :question/id #uuid "8f99b603-2fba-5a58-9966-b91d3a8a773e" :question/math-academy-id "e-373" :question/problem "Calculate $\\displaystyle \\int \\left( 5(\\sqrt{x})^{3} - 4 x^2 + 5\\right) \\,\\textrm d x.$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (5(\\sqrt{x})^{3}-4{x}^{2}+5)\\,\\text{d}x & =\\int (5{x}^{3/2}-4{x}^{2}+5)\\,\\text{d}x \\\\  & =5\\int {x}^{3/2}\\,\\text{d}x-4\\int {x}^{2}\\text{d}x+5\\int 1\\,\\text{d}x \\\\  & =5(\\frac{{x}^{5/2}}{\\frac{5}{2}})-4(\\frac{{x}^{3}}{3})+5(x)+C \\\\  & =5\\cdot \\frac{2}{5}{x}^{5/2}-\\frac{4}{3}{x}^{3}+5x+C \\\\  & =2\\sqrt{{x}^{5}}-\\frac{4}{3}{x}^{3}+5x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184077 :question/id #uuid "0903a1d0-559d-5ab5-a0f7-1270bac213a9" :question/math-academy-id "e-6014" :question/problem "The fourth roots of the number $z=\\cos\\left(\\dfrac{\\pi}{3}\\right)+\\textrm{i}\\sin\\left(\\dfrac{\\pi}{3}\\right)$ are as follows:\n$z_{0}^{1/4} = \\cos ϕ_{0} + \\textrm{i}\\sin ϕ_{0}; z_{1}^{1/4} = \\cos ϕ_{1} + \\textrm{i}\\sin ϕ_{1}; z_{2}^{1/4} = \\cos ϕ_{2} + \\textrm{i}\\sin ϕ_{2}; z_{3}^{1/4} = \\cos ϕ_{3} + \\textrm{i}\\sin ϕ_{3}$\nFind possible values of $\\phi_0$, $\\phi_1,\\phi_2$ and $\\phi_3$." :question/worked-solution "Any nonzero complex number $z$ has exactly $n$ distinct $n$th roots. Using de Moivre's theorem, we can write down these roots as\n\n$$\nz_{k}^{1/n} = \\sqrt[n]{r}\\left[\\cos\\left(\\dfrac{\\theta+2\\pi{k}}{n}\\right)+\\textrm{i}\\sin\\left(\\dfrac{\\theta+2\\pi{k}}{n}\\right)\\right]\n$$\n\nwhere\n\n$$\nr = \\mid z \\mid, \\qquad \\theta = \\arg(z), \\qquad k=0, 1, 2,..., n-1\n$$\n\nIn our case, we have\n\n$$\nr=1, \\qquad \\theta=\\dfrac{\\pi}{3}, \\qquad n=4\n$$\n\nSubstituting these values into the formula, we obtain\n\n$$\n\\begin{aligned}\nz_{k}^{1/4} &= \\sqrt[3]{1}[\\cos (\\frac{\\frac{π}{3} + 2π \\cdot k}{4}) + \\textrm{i}\\sin (\\frac{\\frac{π}{3} + 2π \\cdot k}{4})] \\\\\n&= [\\cos (\\frac{π}{12} + \\frac{2π \\cdot k}{4}) + \\textrm{i}\\sin (\\frac{π}{12} + \\frac{2π \\cdot k}{4})] \\\\\n&= [\\cos (\\frac{π}{12} + \\frac{π \\cdot k}{2}) + \\textrm{i}\\sin (\\frac{π}{12} + \\frac{π \\cdot k}{2})]\n\\end{aligned}\n$$\n\nFinally, setting $k=0, 1, 2,3$ gives the required roots:\n\n$$\n\\begin{aligned}\nk = 0: z_{0}^{1/4} &= [\\cos (\\frac{π}{12} + \\frac{π \\cdot 0}{2}) + \\textrm{i}\\sin (\\frac{π}{12} + \\frac{π \\cdot 0}{2})] \\\\\n&= \\cos (\\frac{π}{12}) + \\textrm{i}\\sin (\\frac{π}{12}) \\\\\nk = 1: z_{1}^{1/4} &= [\\cos (\\frac{π}{12} + \\frac{π \\cdot 1}{2}) + \\textrm{i}\\sin (\\frac{π}{12} + \\frac{π \\cdot 1}{2})] \\\\\n&= \\cos (\\frac{7π}{12}) + \\textrm{i}\\sin (\\frac{7π}{12}) \\\\\nk = 2: z_{2}^{1/4} &= [\\cos (\\frac{π}{12} + \\frac{π \\cdot 2}{2}) + \\textrm{i}\\sin (\\frac{π}{12} + \\frac{π \\cdot 2}{2})] \\\\\n&= \\cos (\\frac{13π}{12}) + \\textrm{i}\\sin (\\frac{13π}{12}) \\\\\nk = 3: z_{3}^{1/4} &= [\\cos (\\frac{π}{12} + \\frac{π \\cdot 3}{2}) + \\textrm{i}\\sin (\\frac{π}{12} + \\frac{π \\cdot 3}{2})] \\\\\n&= \\cos (\\frac{19π}{12}) + \\textrm{i}\\sin (\\frac{19π}{12})\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\phi_0 = \\dfrac{\\pi}{12}, \\qquad \\phi_1 = \\dfrac{7\\pi}{12}, \\qquad \\phi_2 = \\dfrac{13\\pi}{12}\\qquad \\phi_3 = \\dfrac{19\\pi}{12}\n$$"} {:db/id #edb/ref 17592186184078 :question/id #uuid "7dbb258d-fe71-5e7b-9501-c88ffdb6fe86" :question/math-academy-id "e-629" :question/problem "Find the equation of the tangent line to the polar curve $r = 1+2\\cos\\theta$ at $\\theta = \\dfrac{\\pi}{2},$ given that \n\n$$\n\\dfrac{\\textrm d y}{\\textrm d x} = -\\dfrac{\\cos\\theta  + 2\\cos(2\\theta)}{\\sin\\theta + 2\\sin(2\\theta)}.\n$$" :question/worked-solution "To find the equation of the tangent line to a polar curve at a point $P,$ we follow four steps:\n\n**Step 1**: Calculate the derivative $\\dfrac{\\textrm{d}y}{\\textrm{d}x}.$\n\nIn this case, we're given that\n\n$$\n\\dfrac{\\textrm d y}{\\textrm d x} = -\\dfrac{\\cos\\theta  + 2\\cos(2\\theta)}{\\sin\\theta + 2\\sin(2\\theta)}.\n$$\n\n**Step 2**: Find the slope of the tangent at $P.$\n\nThe slope of the tangent line is\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{\\theta =\\pi /2} \\\\  & =-\\frac{\\operatorname{cos}⁡(\\frac{\\pi }{2})+2\\operatorname{cos}⁡(\\pi )}{\\operatorname{sin}⁡(\\frac{\\pi }{2})+2\\operatorname{sin}⁡(\\pi )} \\\\  & =-\\frac{0+2(-1)}{1+2(0)} \\\\  & =2.\\end{aligned}\n$$\n\n**Step 3**: Find the Cartesian coordinates of $P.$\n\nWe compute the $xy$-coordinates of $P$ as follows:\n\n$$\n\\begin{aligned}{x}_{1} & =r\\operatorname{cos}⁡\\theta  \\\\  & =(1+2\\operatorname{cos}⁡\\theta )\\operatorname{cos}⁡\\theta  \\\\  & =(1+2\\operatorname{cos}⁡(\\frac{\\pi }{2}))\\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\  & =(1+2\\cdot 0)\\cdot 0 \\\\  & =0 \\\\ {y}_{1} & =r\\operatorname{sin}⁡\\theta  \\\\  & =(1+2\\operatorname{cos}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =(1+2\\operatorname{cos}⁡(\\frac{\\pi }{2}))\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\  & =(1+2\\cdot 0)\\cdot 1 \\\\  & =1\\cdot 1 \\\\  & =1\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(0,1).$\n\n**Step 4**: Using point-slope form, find the equation of the tangent.\n\nWe find the equation of the tangent as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =2(x-0) \\\\ y & =2x+1\\end{aligned}\n$$\n\n![](images/30/30b1aedfd6187ed1f936ef1faf25fcb8b99857103c656163a3e6897e5c6c5038.png)"} {:db/id #edb/ref 17592186184080 :question/id #uuid "f6c910a1-cd2c-5d9a-ad67-974aaba4a5b4" :question/math-academy-id "e-647" :question/problem "Does the sequence $a_n = \\dfrac {2 \\cdot (-3) ^ n}{5 ^ {n + 1}}$ for $n\\geq 1$ converge or diverge?\nIf it converges, what is its limit?" :question/worked-solution "Suppose we have a geometric sequence with the first term $a_1$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r| <           1,$ the sequence is convergent and converges to $0$\n\n- if $|r| > 1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to $a_1$\n\n- if $r = -1,$ the sequence is divergent\n\nFirst, we rewrite the sequence in the form $a_n = a \\cdot r^{n},$ as follows:\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{2\\cdot (-3)^{n}}{{5}^{n+1}} \\\\  & =\\frac{2\\cdot (-3)^{n}}{5\\cdot {5}^{n}} \\\\  & =\\frac{2}{5}\\cdot \\frac{(-3)^{n}}{{5}^{n}} \\\\  & =\\frac{2}{5}{(-\\frac{3}{5})}^{n}.\\end{aligned}\n$$\n\nWe can now see that this is the geometric sequence with $r=-\\dfrac{3}{5} .$ \n\nSince $|r| < 1,$ the sequence converges to $0.$"} {:db/id #edb/ref 17592186184083 :question/id #uuid "6e12005d-4652-532c-a715-3ab9d9ad3618" :question/math-academy-id "e-7139" :question/problem "Write the equation $2x^2 - 6x = 1$ in the form $(x+p)^2 = q,$ and hence solve the equation." :question/worked-solution "First, we divide out by the coefficient of the quadratic term, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}2{x}^{2}-6x & =1 \\\\ 2({x}^{2}-3x) & =1 \\\\ {x}^{2}-3x & =\\frac{1}{2} \\\\ {x}^{2}-2\\cdot \\frac{3}{2}\\cdot x & =\\frac{1}{2} \\\\ {x}^{2}-2\\cdot (\\frac{3}{2})\\cdot x+{(\\frac{3}{2})}^{2}-{(\\frac{3}{2})}^{2} & =\\frac{1}{2} \\\\ {(x-\\frac{3}{2})}^{2}-{(\\frac{3}{2})}^{2} & =\\frac{1}{2}\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}{(x-\\frac{3}{2})}^{2}-{(\\frac{3}{2})}^{2} & =\\frac{1}{2} \\\\ {(x-\\frac{3}{2})}^{2}-\\frac{9}{4} & =\\frac{2}{4} \\\\ {(x-\\frac{3}{2})}^{2} & =\\frac{11}{4}\\end{aligned}\n$$\n\nSo, $p=-\\dfrac32$ and $q=\\dfrac{11}{4}.$ Now, we solve the equation using the square root method:\n\n$$\n\\begin{aligned}\\sqrt{{(x-\\frac{3}{2})}^{2}} & =\\sqrt{\\frac{11}{4}} \\\\ |x-\\frac{3}{2}| & =\\frac{\\sqrt{11}}{2} \\\\ x-\\frac{3}{2} & =\\pm \\frac{\\sqrt{11}}{2} \\\\ x & =\\frac{3}{2}\\pm \\frac{\\sqrt{11}}{2} \\\\ x & =\\frac{3\\pm \\sqrt{11}}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184084 :question/id #uuid "9dfe0c3a-2c54-5270-ab0d-0d2dad09a199" :question/math-academy-id "e-7140" :question/problem "Write the equation $-2x^2+2x+1 = 0$ in the form $2(x+p)^2=q,$ and hence solve the equation." :question/worked-solution "First, we multiply the equation by $-1$:\n\n$$\n\\begin{aligned}(-1)\\cdot (-2{x}^{2}+2x+1) & =(-1)\\cdot 0 \\\\ 2{x}^{2}-2x-1 & =0\\end{aligned}\n$$\n\nNow, we move the constant term to the right-hand side, factor the coefficient of the quadratic term, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}2{x}^{2}-2x-1 & =0 \\\\ 2{x}^{2}-2x & =1 \\\\ 2({x}^{2}-x) & =1 \\\\ 2[{x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2}-{(\\frac{1}{2})}^{2}] & =1 \\\\ 2[{(x-\\frac{1}{2})}^{2}-\\frac{1}{4}] & =1\\end{aligned}\n$$\n\nNext, we expand the brackets, and write the equation in the required form:\n\n$$\n\\begin{aligned}2[{(x-\\frac{1}{2})}^{2}-\\frac{1}{4}] & =1 \\\\ 2{(x-\\frac{1}{2})}^{2}-\\frac{1}{2} & =1 \\\\ 2{(x-\\frac{1}{2})}^{2} & =\\frac{3}{2}\\end{aligned}\n$$\n\nTherefore, $p=-\\dfrac12$ and $q=\\dfrac32.$ We now solve the equation using the square root method:\n\n$$\n\\begin{aligned}2{(x-\\frac{1}{2})}^{2} & =\\frac{3}{2} \\\\ {(x-\\frac{1}{2})}^{2} & =\\frac{3}{4} \\\\ \\sqrt{{(x-\\frac{1}{2})}^{2}} & =\\sqrt{\\frac{3}{4}} \\\\ |x-\\frac{1}{2}| & =\\frac{\\sqrt{3}}{2} \\\\ x-\\frac{1}{2} & =\\pm \\frac{\\sqrt{3}}{2} \\\\ x & =\\frac{1}{2}\\pm \\frac{\\sqrt{3}}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184087 :question/id #uuid "05dec044-4b3b-5f42-88c5-b7ab323b0e97" :question/math-academy-id "e-743" :question/problem "Let $f(x) = \\sin{x}.$ Calculate the fourth-degree Taylor polynomial for $f(x)$ about $x=\\dfrac{\\pi}{2}.$" :question/worked-solution "The fourth-degree Taylor polynomial of $f(x)$ about $x=a$ is given by\n\n$$\nP_4(x) = f(a) + f'(a)(x-a) + \\dfrac{f''(a)}{2!}(x-a)^2 + \\dfrac{f'''(a)}{3!}(x-a)^3 + \\dfrac{f^{(4)}(a)}{4!}(x-a)^4.\n$$\n\nHere, we have $a=\\dfrac{\\pi}{2},$ so\n\n$$\n\\begin{aligned}{P}_{4}(x) & =f(\\frac{\\pi }{2})+{f}^{′}(\\frac{\\pi }{2})(x-\\frac{\\pi }{2})+\\frac{{f}^{″}(\\frac{\\pi }{2})}{2!}{(x-\\frac{\\pi }{2})}^{2} \\\\  & \\,\\,\\,\\,+\\frac{{f}^{‴}(\\frac{\\pi }{2})}{3!}{(x-\\frac{\\pi }{2})}^{3}+\\frac{{f}^{(4)}(\\frac{\\pi }{2})}{4!}{(x-\\frac{\\pi }{2})}^{4}.\\end{aligned}\n$$\n\nSo we need to work out $f\\left(\\dfrac{\\pi}{2}\\right),$ $f'\\left(\\dfrac{\\pi}{2}\\right),$ $f''\\left(\\dfrac{\\pi}{2}\\right),$ $f'''\\left(\\dfrac{\\pi}{2}\\right)$ and $f^{(4)}\\left(\\dfrac{\\pi}{2}\\right),$ as follows:\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{sin}⁡x & ⟹ &  & f(\\frac{\\pi }{2}) & =1 \\\\ {f}^{′}(x) & =\\operatorname{cos}⁡x & ⟹ &  & {f}^{′}(\\frac{\\pi }{2}) & =0 \\\\ {f}^{″}(x) & =-\\operatorname{sin}⁡x & ⟹ &  & {f}^{″}(\\frac{\\pi }{2}) & =-1 \\\\ {f}^{‴}(x) & =-\\operatorname{cos}⁡x & ⟹ &  & {f}^{‴}(\\frac{\\pi }{2}) & =0 \\\\ {f}^{(4)}(x) & =\\operatorname{sin}⁡x & ⟹ &  & {f}^{(4)}(\\frac{\\pi }{2}) & =1.\\end{aligned}\n$$\n\nTherefore, $P_4(x)$ is given by\n\n$$\n\\begin{aligned}{P}_{4}(x) & =1-\\frac{1}{2!}{(x-\\frac{\\pi }{2})}^{2}+\\frac{1}{4!}{(x-\\frac{\\pi }{2})}^{4} \\\\  & =1-\\frac{1}{2}{(x-\\frac{\\pi }{2})}^{2}+\\frac{1}{24}{(x-\\frac{\\pi }{2})}^{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184090 :question/id #uuid "e82fb0f9-372a-50ab-a6a5-c1dc8868a2d6" :question/math-academy-id "e-753" :question/problem "Use the first three terms of the Taylor expansion for $f(x) = \\sqrt x$ about $x=9$ to approximate the value of $\\sqrt{9.1}.$" :question/worked-solution "We use Taylor's theorem in the form\n\n$$\nf(x)\t= f(a) + f'(a)(x-a) + \\frac{f''(a)}{2!}(x-a)^2 +\\cdots,\n$$\n\nwith $a=9.$ \n\nCalculating the necessary derivatives, we get\n\n$$\n\\begin{aligned}f(x) & ={x}^{1/2} \\\\ f(9) & =3 \\\\ {f}^{′}(x) & =\\frac{1}{2}{x}^{-1/2} \\\\ {f}^{′}(9) & =\\frac{1}{6} \\\\ {f}^{″}(x) & =-\\frac{1}{4}{x}^{-3/2} \\\\ {f}^{″}(9) & =-\\frac{1}{108}.\\end{aligned}\n$$\n\nSo, the Taylor series is\n\n$$\n\\begin{aligned}\\sqrt{x} & =3+\\frac{1}{6}(x-9)+\\frac{1}{2}(-\\frac{1}{108})(x-9)^{2}+⋯ \\\\  & =3+\\frac{1}{6}(x-9)-\\frac{1}{216}(x-9)^{2}+⋯.\\end{aligned}\n$$\n\nWe substitute $x = 9.1$ into the above to approximate $\\sqrt{9.1}.$ We get\n\n$$\n\\begin{aligned}\\sqrt{9.1} & ≈3+\\frac{1}{6}(9.1-9)-\\frac{1}{216}(9.1-9)^{2} \\\\  & ≈3+\\frac{1}{6}(0.1)-\\frac{1}{216}(0.1)^{2} \\\\  & =3.016\\,620,\\end{aligned}\n$$\n\nto six decimal places. \n\n**Note:** The exact value of $\\sqrt{9.1}$ is $3.016\\,621$ to six decimal places. So, our approximation is very good!"} {:db/id #edb/ref 17592186184104 :question/id #uuid "ca98d9bd-337e-5982-9609-e3d0f4601575" :question/math-academy-id "e-9779" :question/problem "Find the first $3$ terms in ascending powers of $m$ of the binomial expansion of $\\left(1 - \\dfrac{4m}{3}\\right)^7.$" :question/worked-solution "The first $3$ terms of the binomial expansion for ${(1 + x)^n}$ are given by\n\n$$\n{(1 + x)}^n = 1 + nx + \\frac{{n(n - 1)}}{{2!}}{x^2}  +  \\cdots .\n$$\n\nBy substituting $x=-\\dfrac{4m}{3}$ and $n=7$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-\\frac{4m}{3})}^{7} & =1+7(-\\frac{4m}{3})+\\frac{7(7-1)}{2!}{(-\\frac{4m}{3})}^{2}+⋯ \\\\  & =1+7(-\\frac{4m}{3})+\\frac{7(6)}{2}{(-\\frac{4m}{3})}^{2}+⋯ \\\\  & =1+7(-\\frac{4m}{3})+\\frac{7(6)}{2}(\\frac{16{m}^{2}}{9})+⋯ \\\\  & =1-\\frac{28m}{3}+\\frac{112{m}^{2}}{3}+⋯.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184106 :question/id #uuid "b0506d9d-2495-505f-b61f-6c01607ad43f" :question/math-academy-id "e-9815" :question/problem "Evaluate $4\\cos^2 \\left(\\dfrac \\pi 6\\right) - \\sin \\left(\\dfrac \\pi 4\\right)$." :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\n- Let's first consider the angle $\\dfrac{\\pi}{6}$. From the unit circle, we see that the angle $\\dfrac{\\pi}{6}$ corresponds to the point $\\left(\\dfrac{\\sqrt{3}}{2}, \\dfrac{1}{2} \\right)$. Since the cosine of the angle corresponds to the $x$-coordinate, we have $\\cos\\left(\\dfrac {\\pi} {6}\\right) = \\dfrac{\\sqrt{3}}{2}$.\n- Now, let's consider the angle $\\dfrac \\pi 4$. From the unit circle, we see that the angle $\\dfrac \\pi 4$ corresponds to the point $\\left(\\dfrac{\\sqrt{2}}{2}, \\dfrac{\\sqrt{2}}{2} \\right)$. Since the sine of the angle corresponds to the $y$-coordinate, we have $\\sin\\left(\\dfrac {\\pi} {4}\\right) = \\dfrac{\\sqrt{2}}{2}$.\n\nFinally, we combine the results:\n\n$$\n\\begin{aligned}\n4\\cos^{2} (\\frac{π}{6}) - \\sin (\\frac{π}{4}) &= 4(\\frac{\\sqrt{3}}{2})^{2} - \\frac{\\sqrt{2}}{2} \\\\\n&= 3 - \\frac{\\sqrt{2}}{2}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184120 :question/id #uuid "59156f24-72a1-5642-ac66-f84002c87d0b" :question/math-academy-id "e-9955" :question/problem "![](images/fc/fc3ec38b91c71be3e9638dfa0127f1baab5d11d30e6156d863b36758f6751e7d.png)\n\nFind the equation of the **normal** line to the polar curve $r = 1 - 2\\cos\\theta$ at $\\theta = \\dfrac{3\\pi}{2},$ given that\n\n$$\ny'(\\theta)  = \\cos\\theta-2\\cos(2\\theta) , \\qquad\nx'(\\theta) = 2\\sin(2\\theta) - \\sin\\theta.\n$$" :question/worked-solution "To find the equation of the normal line to a polar curve at a point $P,$ we follow four steps:\n\n**Step 1**: Calculate the derivative $\\dfrac{\\textrm{d}y}{\\textrm{d}x}.$\n\nIn this case, we're given that\n\n$$\ny'(\\theta)  = \\cos\\theta-2\\cos(2\\theta) , \\qquad\nx'(\\theta) = 2\\sin(2\\theta) - \\sin\\theta.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & =\\frac{\\operatorname{cos}⁡\\theta -2\\operatorname{cos}⁡(2\\theta )}{2\\operatorname{sin}⁡(2\\theta )-\\operatorname{sin}⁡\\theta }\\end{aligned}\n$$\n\n**Step 2**: Find the slope of the tangent at $P.$\n\nThe slope of the tangent line is\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{\\theta =3\\pi /2} \\\\  & =\\frac{(\\operatorname{cos}⁡(\\frac{3\\pi }{2})-2\\operatorname{cos}⁡(2\\cdot \\frac{3\\pi }{2}))}{(2\\operatorname{sin}⁡(2\\cdot \\frac{3\\pi }{2})-\\operatorname{sin}⁡(\\frac{3\\pi }{2}))} \\\\  & =\\frac{(\\operatorname{cos}⁡(\\frac{3\\pi }{2})-2\\operatorname{cos}⁡(3\\pi ))}{(2\\operatorname{sin}⁡(3\\pi )-\\operatorname{sin}⁡(\\frac{3\\pi }{2}))} \\\\  & =\\frac{0-2(-1)}{0-(-1)} \\\\  & =\\frac{0+2}{0+1} \\\\  & =2.\\end{aligned}\n$$\n\n**Step 3**: Find the Cartesian coordinates of $P.$\n\nWe compute the $xy$-coordinates of $P$ as follows:\n\n$$\n\\begin{aligned}{x}_{1} & =r\\operatorname{cos}⁡\\theta  \\\\  & =(1-2\\operatorname{cos}⁡\\theta )\\operatorname{cos}⁡\\theta  \\\\  & =(1-2\\operatorname{cos}⁡(\\frac{3\\pi }{2}))\\operatorname{cos}⁡(\\frac{3\\pi }{2}) \\\\  & =(1-2\\cdot 0)\\cdot 0 \\\\  & =0 \\\\ {y}_{1} & =r\\operatorname{sin}⁡\\theta  \\\\  & =(1-2\\operatorname{cos}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =(1-2\\operatorname{cos}⁡(\\frac{3\\pi }{2}))\\operatorname{sin}⁡(\\frac{3\\pi }{2}) \\\\  & =(1-2\\cdot 0)\\cdot (-1) \\\\  & =1\\cdot (-1) \\\\  & =-1\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $\\left( 0, -1 \\right).$\n\n**Step 4**: Using point-slope form, find the equation of the normal.\n\nWe find the equation of the normal as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =-\\frac{1}{m}(x-{x}_{1}) \\\\ y-(-1) & =-\\frac{1}{2}\\cdot (x-0) \\\\ y+1 & =-\\frac{1}{2}x \\\\ y & =-\\frac{1}{2}x-1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184127 :question/id #uuid "c8e2b559-31ab-5b52-98b1-6a36dfefc505" :question/math-academy-id "e-9969" :question/problem "Solve the equation $\\log_2 (4x) - 2\\log_2\\left(x^2\\right) = 1$." :question/worked-solution "Notice that the logarithms share the same base.\n\nFirst, we apply the power rule to the first term to make the coefficient in front of each logarithm the same:\n\n$$\n\\begin{aligned}\n\\log_{2} (4x) - 2\\log_{2} (x^{2}) = 1 \\\\\n&= \\log_{2} (4x) - \\log_{2} ((x^{2})^{2}) = 1 \\\\\n\\log_{2} (4x) - \\log_{2} (x^{4}) &= 1\n\\end{aligned}\n$$\n\nNext, we combine the logarithms using the quotient rule. This gives\n\n$$\n\\begin{aligned}\n\\log_{2} (\\frac{4x}{x^{4}}) &= 1 \\\\\n\\log_{2} (\\frac{4}{x^{3}}) &= 1\n\\end{aligned}\n$$\n\nWriting this equation in its equivalent exponential form, we get\n\n$$\n\\begin{aligned}\n\\frac{4}{x^{3}} &= 2^{1} \\\\\n\\frac{4}{x^{3}} &= 2\n\\end{aligned}\n$$\n\nNow, we solve this rational equation for $x$ using the usual methods.\n\n$$\n{\\begin{array}{rl}\\displaystyle {\\displaystyle \\frac{4}{ {x}^{3}}} & \\displaystyle  = 2 \\\\ \\displaystyle {x}^{3} \\cdot  {\\displaystyle \\frac{4}{ {x}^{3}}} & \\displaystyle  = {x}^{3} \\cdot  2 \\\\ \\displaystyle \\cancel{ {x}^{3}} \\cdot  {\\displaystyle \\frac{4}{\\cancel{ {x}^{3}}}} & \\displaystyle  = 2 {x}^{3} \\\\ \\displaystyle 2 {x}^{3} & \\displaystyle  = 4 \\\\ \\displaystyle {x}^{3} & \\displaystyle  = 2 \\\\ \\displaystyle x & \\displaystyle  = \\sqrt[3]{2}\\end{array}}\n$$\n\nLet's now check for an extraneous solution by substituting back into the original equation:\n\nSubstituting\n\n$$\nx=\\sqrt[3]{2}\n$$\n\nback into the original equation, we get\n\n$$\n{\\begin{array}{rl}\\displaystyle {\\log }_{2}  ( 4 ( \\sqrt[3]{2} ) ) - 2 {\\log }_{2}  ( ( \\sqrt[3]{2} {)}^{2} ) & \\displaystyle  \\overset{?}{=} 1 \\\\ \\displaystyle {\\log }_{2}  ( 4 ( \\sqrt[3]{2} ) ) - {\\log }_{2}  {( ( \\sqrt[3]{2} {)}^{2} )}^{2} & \\displaystyle  \\overset{?}{=} 1 \\\\ \\displaystyle {\\log }_{2}  ( 4 ( \\sqrt[3]{2} ) ) - {\\log }_{2}  ( ( \\sqrt[3]{2} {)}^{4} ) & \\displaystyle  \\overset{?}{=} 1 \\\\ \\displaystyle {\\log }_{2}  ( 4 ( \\sqrt[3]{2} ) ) - {\\log }_{2}  ( 2 ( \\sqrt[3]{2} ) ) & \\displaystyle  \\overset{?}{=} 1 \\\\ \\displaystyle {\\log }_{2}  ( {\\displaystyle \\frac{4 \\sqrt[3]{2}}{2 \\sqrt[3]{2}}} ) & \\displaystyle  \\overset{?}{=} 1 \\\\ \\displaystyle {\\log }_{2}  ( {\\displaystyle \\frac{4 \\cancel{\\sqrt[3]{2}}}{2 \\cancel{\\sqrt[3]{2}}}} ) & \\displaystyle  \\overset{?}{=} 1 \\\\ \\displaystyle {\\log }_{2}  ( {\\displaystyle \\frac{4}{2}} ) & \\displaystyle  \\overset{?}{=} 1 \\\\ \\displaystyle {\\log }_{2}  ( 2 ) & \\displaystyle  \\overset{?}{=} 1 \\\\ \\displaystyle 1 & \\displaystyle  = 1. \\hspace{1em} {\\color{green}✓}\\end{array}}\n$$\n\nTherefore,\n\n$$\nx=\\sqrt[3]{2}\n$$\n\nis a valid solution."} {:db/id #edb/ref 17592186184128 :question/id #uuid "e62ac8e2-176a-51b0-a36e-b73cde9ac136" :question/math-academy-id "e-9971" :question/problem "Solve the equation $2\\log_3 (\\sqrt 2x) - \\log_3(x - 1) = \\log_3 (3x)$." :question/worked-solution "Notice that the logarithms share the same base.\n\nFirst, we apply the power rule to the *first* term to make the coefficient in front of each logarithm the same:\n\n$$\n\\begin{aligned}\n2\\log_{3} (\\sqrt{2}x) - \\log_{3} (x - 1) &= \\log_{3} (3x) \\\\\n\\log_{3} (\\sqrt{2}x)^{2} - \\log_{3} (x - 1) &= \\log_{3} (3x) \\\\\n\\log_{3} (2x^{2}) - \\log_{3} (x - 1) &= \\log_{3} (3x)\n\\end{aligned}\n$$\n\nNext, we combine the logarithms on the left-hand side using the quotient rule:\n\n$$\n\\begin{aligned}\n\\log_{3} (\\frac{2x^{2}}{x - 1}) &= \\log_{3} (3x)\n\\end{aligned}\n$$\n\nNow, we solve the equation for $x$ using the usual methods.\n\n$$\n{\\begin{array}{rl}\\displaystyle {\\displaystyle \\frac{2 {x}^{2}}{x - 1}} & \\displaystyle  = 3 x \\\\ \\displaystyle ( x - 1 ) \\cdot  {\\displaystyle \\frac{2 {x}^{2}}{x - 1}} & \\displaystyle  = ( x - 1 ) \\cdot  ( 3 x ) \\\\ \\displaystyle \\cancel{( x - 1 )} \\cdot  {\\displaystyle \\frac{2 {x}^{2}}{\\cancel{x - 1}}} & \\displaystyle  = ( x - 1 ) \\cdot  ( 3 x ) \\\\ \\displaystyle 2 {x}^{2} & \\displaystyle  = 3 {x}^{2} - 3 x \\\\ \\displaystyle {x}^{2} - 3 x & \\displaystyle  = 0 \\\\ \\displaystyle x ( x - 3 ) & \\displaystyle  = 0\\end{array}}\n$$\n\nSo, $x = 0$ and $x =3$.\n\nLet's now check for extraneous solutions by substituting them back into the original equation:\n\n- Substituting $x=0$ back into the original equation, we get\n$2\\log_{3} (\\sqrt{2} \\cdot 0) - \\log_{3} (0 - 1)|=^(?)\\log_{3} (3 \\cdot 0); 2\\log_{3} (0) - \\log_{3} (-1)|=^(?)\\log_{3} (0).\\cdot$\nThis statement is false because $\\log_3 (0)$ and $\\log_3 (-1)$ are undefined. Therefore, $x=0$ is not a valid solution.\n\n- Substituting $x=3$ back into the original equation, we get\n$2\\log_{3} (3\\sqrt{2}) - \\log_{3} (3 - 1)|=^(?)\\log_{3} (3 \\cdot 3); \\log_{3} (3\\sqrt{2})^{2} - \\log_{3} (2)|=^(?)\\log_{3} (9); \\log_{3} (18) - \\log_{3} (2)|=^(?)\\log_{3} (9); \\log_{3} (\\frac{18}{2})|=^(?)\\log_{3} (9); \\log_{3} (9)|= \\log_{3} (9).✓$\nTherefore, $x=3$ is a valid solution.\n\nTherefore, the correct answer is \"$x=3$ only\"."} {:db/id #edb/ref 17592186184132 :question/id #uuid "06df772e-eb43-55e8-9ede-3fc2f7ae291d" :question/math-academy-id "e-9984" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\cos u = \\dfrac{7}{25}, \\qquad \\sin v = \\dfrac{4}{5}, \\qquad \\cos v = \\dfrac {3} {5}.\n$$\n\nGiven that $u$ lies in the fourth quadrant, find the value of $\\sin(u-v).$" :question/worked-solution "First, recall the difference formula for sine:\n\n$$\n\\sin(u-v) = \\sin u \\cos v- \\cos u \\sin v\n$$\n\nWe know the values of $\\cos{u}$, $\\sin{v}$, and $\\cos{v}.$ To find the missing value of $\\sin{u}$, we can use the Pythagorean identity:\n\n$$\n\\sin^2 u + \\cos^2 u= 1 \\qquad\\Longrightarrow\\qquad \\sin^2 u = 1- \\cos^2 u\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{sin}^{2}⁡u & =1-{cos}^{2}⁡u \\\\  & =1-{(\\frac{7}{25})}^{2} \\\\  & =1-\\frac{{7}^{2}}{{25}^{2}} \\\\  & =1-\\frac{49}{625} \\\\  & =\\frac{625}{625}-\\frac{49}{625} \\\\  & =\\frac{576}{625}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡u & =\\pm \\sqrt{\\frac{576}{625}} \\\\  & =\\pm \\frac{24}{25}.\\end{aligned}\n$$\n\nWe're given that $u$ lies in the fourth quadrant, where sine is negative. So, we disregard the positive value, and we have \n\n$$\n\\sin u= -\\dfrac{24}{25}.\n$$\n\nWe can now apply the difference formula, as follows:\n\n$$\n\\begin{aligned}\n\t\t\\sin(u - v) \n\t\t\t&= \\sin u \\cos v - \\cos u \\sin v \\\\[5pt]\n\t\t\t&= \\left( -\\dfrac {24}{25} \\right)\\left(\\dfrac {3} {5}\\right)\n \t\t\t\t -  \\left(\\dfrac {7}{25}\\right) \\left( \\dfrac {4} {5}\\right) \\\\[5pt]\n\t\t\t\n \t\t\t&= -\\dfrac {72} {125} -  \\dfrac {28} {125} \\\\[5pt]\n\t\t\t&= -\\dfrac {100} {125}\\\\[5pt]\n\t\t\t&= -\\dfrac {4} {5}.\n\t\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184135 :question/id #uuid "8877f6b8-8914-5022-9ec6-d4e8e0d3d159" :question/math-academy-id "e-9992" :question/problem "Suppose that for the angles $u$ and $v,$ we have \n\n$$\n\\sin u = \\dfrac {4} {5}, \\qquad\n\\cos u = \\dfrac {3} {5}, \\qquad \n\\sin v = \\dfrac {9} {15}.\n$$\n\nGiven that $v$ lies in the first quadrant, find the value of $\\cos\\left(u - v\\right).$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\cos(u - v) = \\cos u \\cos v + \\sin u \\sin v\n$$\n\nWe know the values of $\\sin{u}$, $\\cos{u}$, and $\\sin{v}.$ To find the missing value of $\\cos{v,}$ we can use the Pythagorean identity:\n\n$$\n\\sin^2 v + \\cos^2 v= 1 \\qquad\\Longrightarrow\\qquad \\cos^2 v = 1- \\sin^2 v\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡v & =1-{sin}^{2}⁡v \\\\  & =1-{(\\frac{9}{15})}^{2} \\\\  & =1-\\frac{{9}^{2}}{{15}^{2}} \\\\  & =1-\\frac{81}{225} \\\\  & =\\frac{225}{225}-\\frac{81}{225} \\\\  & =\\frac{144}{225}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡v & =\\pm \\sqrt{\\frac{144}{225}} \\\\  & =\\pm \\frac{12}{15}.\\end{aligned}\n$$\n\nWe're given that $v$ lies in the first quadrant, where cosine is positive. So, we disregard the negative value, and we have\n\n$$\n\\cos v= \\dfrac{12}{15}.\n$$\n\nWe can now apply the difference formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(u-v) & =\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v \\\\  & =(\\frac{3}{5})(\\frac{12}{15})+(\\frac{4}{5})(\\frac{9}{15}) \\\\  & =\\frac{36}{75}+\\frac{36}{75} \\\\  & =\\frac{72}{75} \\\\  & =\\frac{24}{25}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184136 :question/id #uuid "fa5a0465-1208-5794-89e7-fb457105fd06" :question/math-academy-id "e-9994" :question/problem "Suppose that for the angles $u$ and $v$, we have\n$\\sin u = \\dfrac {4}{5}, \\qquad \\tan v = \\dfrac{1}{2}$.\nGiven that $u$ lies in the first quadrant, find the value of $\\tan\\left(u + v\\right)$." :question/worked-solution "First, we recall the sum formula for tangent:\n\n$$\n\\tan(u+v) = \\dfrac{\\tan{u}+\\tan{v}}{1-\\tan{u}\\tan{v}}\n$$\n\nWe need to find the value of $\\tan u$. To do that, we first find the value of $\\cos{u}$ using the Pythagorean identity:\n\n$$\n\\sin^2 u + \\cos^2 u= 1 \\qquad\\Longrightarrow\\qquad \\cos^2 u = 1- \\sin^2 u\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}\n\\cos^{2} u &= 1 - \\sin^{2} u \\\\\n&= 1 - (\\frac{4}{5})^{2} \\\\\n&= 1 - \\frac{4^{2}}{5^{2}} \\\\\n&= 1 - \\frac{16}{25} \\\\\n&= \\frac{25}{25} - \\frac{16}{25} \\\\\n&= \\frac{9}{25}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\cos u &= ± \\sqrt{\\frac{9}{25}} \\\\\n&= ± \\frac{3}{5}\n\\end{aligned}\n$$\n\nWe're given that $u$ lies in the first quadrant, where cosine is positive. So, we disregard the negative value, and we have\n\n$$\n\\cos u= \\dfrac{3}{5}\n$$\n\nWe can now compute $\\tan u$:\n\n$$\n\\begin{aligned}\n\\tan u &= \\frac{\\sin u}{\\cos u} = ((\\frac{4}{5}))/((\\frac{3}{5})) = \\frac{4}{3}\n\\end{aligned}\n$$\n\nFinally, we use the sum formula for the tangent:\n\n$$\n\\begin{aligned}\n\\tan (u + v) &= \\frac{\\tan u + \\tan v}{1 - \\tan u\\tan v} \\\\\n&= ((\\frac{4}{3} + \\frac{1}{2}))/((1 - \\frac{4}{3} \\cdot \\frac{1}{2})) \\\\\n&= ((\\frac{11}{6}))/((\\frac{1}{3})) \\\\\n&= \\frac{11}{2}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184437 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cb26523-cf9a-5e6f-a6df-561191311046" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x+\\sqrt{2}" :db/id #edb/ref 17592186541480} {:answer/id #uuid "6a904a99-9555-59da-b4b7-d0e6556359cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x" :db/id #edb/ref 17592186541636} {:answer/id #uuid "82b05dd1-ec82-5b6d-87ab-194bbf6fb236" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x-\\sqrt{2}" :db/id #edb/ref 17592186541686} {:answer/id #uuid "96221e88-2457-5022-8d30-9d942b87da36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\sqrt{2}x" :db/id #edb/ref 17592186541734} {:answer/id #uuid "c63bb719-501d-5899-9990-749d6453007b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x+\\sqrt{2}" :db/id #edb/ref 17592186541841}] :answer-field/correct {:answer/id #uuid "6a904a99-9555-59da-b4b7-d0e6556359cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x" :db/id #edb/ref 17592186541636} :answer-field/id #uuid "f400af5e-45e9-590f-bfe9-235c2c3163f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186180799}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ca4cdd59-0ef8-55a6-b3e4-91d9fcc40f65" :question/math-academy-id "q-103835" :question/problem "Find the equation of the **normal** line to the polar curve $r=\\operatorname{sin}⁡(2\\theta )$ at $\\theta =\\frac{3\\pi }{4},$ given that \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{3\\operatorname{sin}⁡(3\\theta )-\\operatorname{sin}⁡\\theta }{3\\operatorname{cos}⁡(3\\theta )+\\operatorname{cos}⁡\\theta }.\n$$" :question/requires-calculator true :question/worked-solution "To find the equation of the normal line to a polar curve at a point $P,$ we follow four steps:\n\n**Step 1**: Calculate the derivative $\\frac{\\text{d}y}{\\text{d}x}:$\n\nIn this case, we're given that\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{3\\operatorname{sin}⁡(3\\theta )-\\operatorname{sin}⁡\\theta }{3\\operatorname{cos}⁡(3\\theta )+\\operatorname{cos}⁡\\theta }.\n$$\n\n**Step 2**: Find the slope of the tangent at $P:$\n\nThe slope of the tangent line is\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{\\theta =3\\pi /4} \\\\  & =\\frac{(3\\operatorname{sin}⁡(\\frac{9\\pi }{4})-\\operatorname{sin}⁡(\\frac{3\\pi }{4}))}{(3\\operatorname{cos}⁡(\\frac{9\\pi }{4})+\\operatorname{cos}⁡(\\frac{3\\pi }{4}))} \\\\  & =\\frac{(\\frac{3\\sqrt{2}}{2}-\\frac{\\sqrt{2}}{2})}{(\\frac{3\\sqrt{2}}{2}+(-\\frac{\\sqrt{2}}{2}))} \\\\  & =\\frac{(\\frac{2\\sqrt{2}}{2})}{(\\frac{2\\sqrt{2}}{2})} \\\\  & =1.\\end{aligned}\n$$\n\n**Step 3**: Find the Cartesian coordinates of $P:$\n\nWe compute the $xy$-coordinates of $P$ as follows:\n\n$$\n\\begin{aligned}{x}_{1} & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡(2\\theta )\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡(\\frac{3\\pi }{2})\\operatorname{cos}⁡(\\frac{3\\pi }{4}) \\\\  & =(-1)\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{\\sqrt{2}}{2} \\\\ {y}_{1} & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡(2\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡(\\frac{3\\pi }{2})\\operatorname{sin}⁡(\\frac{3\\pi }{4}) \\\\  & =(-1)\\cdot (\\frac{\\sqrt{2}}{2}) \\\\  & =-\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(\\frac{\\sqrt{2}}{2},-\\frac{\\sqrt{2}}{2}).$\n\n**Step 4**: Using point-slope form, find the equation of the normal:\n\nWe find the equation of the normal as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =-\\frac{1}{m}(x-{x}_{1}) \\\\ y-(-\\frac{\\sqrt{2}}{2}) & =-1\\cdot (x-\\frac{\\sqrt{2}}{2}) \\\\ y+\\frac{\\sqrt{2}}{2} & =-x+\\frac{\\sqrt{2}}{2} \\\\ y & =-x\\end{aligned}\n$$\n\n![](images/31/3185d528869c760d55d5f01aebae58ef41c6c325c7a3cb56d67c401ecfb80b2b.png)"} {:db/id #edb/ref 17592186184453 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48d7c891-85d3-5f18-98e4-2c7a4c8db324" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186251161} {:answer/id #uuid "9eeb417b-418b-5dc9-baa8-c6446ee30e09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186251924} {:answer/id #uuid "b8a76c3f-b1bb-51e7-92c8-cf13cf7d4c6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186252177} {:answer/id #uuid "cf09de8d-51aa-5ea3-bc9a-c5def2f65da6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186252382} {:answer/id #uuid "eacca78c-6a14-5ec3-97c0-98ba3650b2f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186252608}] :answer-field/correct {:answer/id #uuid "b8a76c3f-b1bb-51e7-92c8-cf13cf7d4c6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186252177} :answer-field/id #uuid "f3fd2f76-ecce-5fba-aee2-6f5e6dff1202" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253234}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ba92bee5-a4eb-55dd-b31e-91c198d4e5df" :question/math-academy-id "q-119179" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\operatorname{sin}⁡u=-\\frac{\\sqrt{5}}{4},\\,\\operatorname{cos}⁡u=\\frac{\\sqrt{11}}{4},\\,\\operatorname{cos}⁡v=-\\frac{5}{6}.\n$$\n\nGiven that $v$ lies in the second quadrant, and\n\n$$\n\\operatorname{sin}⁡(u-v)=\\frac{a\\sqrt{5}-b}{24},\n$$\n\ncalculate the value of $a+b.$" :question/worked-solution "First, recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nWe know the values of $\\operatorname{sin}⁡u$, $\\operatorname{cos}⁡u$, and $\\operatorname{cos}⁡v.$ To find the missing value of $\\operatorname{sin}⁡v$, we can use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡v+{cos}^{2}⁡v=1\\,⟹\\,{sin}^{2}⁡v=1-{cos}^{2}⁡v\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{sin}^{2}⁡v & =1-{cos}^{2}⁡v \\\\  & =1-{(-\\frac{5}{6})}^{2} \\\\  & =1-{(\\frac{5}{6})}^{2} \\\\  & =1-\\frac{{5}^{2}}{{6}^{2}} \\\\  & =1-\\frac{25}{36} \\\\  & =\\frac{36}{36}-\\frac{25}{36} \\\\  & =\\frac{11}{36}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡v & =\\pm \\sqrt{\\frac{11}{36}} \\\\  & =\\pm \\frac{\\sqrt{11}}{6}.\\end{aligned}\n$$\n\nWe're given that $v$ lies in the second quadrant, where sine is positive. So, we disregard the negative value, and we have \n\n$$\n\\operatorname{sin}⁡v=\\frac{\\sqrt{11}}{6}.\n$$\n\nWe can now apply the difference formula, as follows:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(u-v) & =\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v \\\\  & =(-\\frac{\\sqrt{5}}{4})(-\\frac{5}{6})-(\\frac{\\sqrt{11}}{4})(\\frac{\\sqrt{11}}{6}) \\\\  & =\\frac{5\\sqrt{5}}{24}-\\frac{11}{24} \\\\  & =\\frac{5\\sqrt{5}-11}{24}\\end{aligned}\n$$\n\nFinally, $a=5,b=11,$ and $a+b=16.$"} {:db/id #edb/ref 17592186184473 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd6324d6-7c7a-53ba-a58e-596789b1e25b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a = 5$ and $b = \\frac{2π}{5}$" :db/id #edb/ref 17592186181016} {:answer/id #uuid "fea9005c-e522-52ed-946d-8eb2f6d697a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a = 15$ and $b = \\frac{2π}{5}$" :db/id #edb/ref 17592186181017} {:answer/id #uuid "29ee32df-241d-5dd0-a181-94151c031127" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a = 5$ and $b = \\frac{π}{5}$" :db/id #edb/ref 17592186181018} {:answer/id #uuid "4708e0ef-bfff-552f-871f-1e6f522cbdfc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a = 3$ and $b = \\frac{2π}{5}$" :db/id #edb/ref 17592186181019} {:answer/id #uuid "6aeee295-21bb-572a-8d30-634ce8c00de8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a = 3$ and $b = \\frac{π}{5}$" :db/id #edb/ref 17592186181020}] :answer-field/id #uuid "5e79d94e-c408-55eb-8840-1f9cb64fcf0f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186181015}] :question/id #uuid "73b72aa0-ad67-598c-998a-215c706bd4b6" :question/math-academy-id "q-138407" :question/problem "The complex $5$th roots of the number $z = \\cos (\\frac{5π}{3}) + \\textrm{i}\\sin (\\frac{5π}{3})$ are given by\n\n$z_{k}^{1/5} = \\cos (\\frac{π}{a} + b \\cdot k) + \\textrm{i}\\sin (\\frac{π}{a} + b \\cdot k)$,\n\nwhere $k = 0, 1, 2, 3, 4$. What are the values of $a$ and $b$?"} {:db/id #edb/ref 17592186184474 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8bb26b7a-10e6-51e2-83e2-8cfe64a14753" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a = 3$, $b = 6$, and $c = π$" :db/id #edb/ref 17592186181022} {:answer/id #uuid "ce34428a-01ce-577e-a608-14a6ec31548c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a = 3$, $b = 3$, and $c = \\frac{π}{2}$" :db/id #edb/ref 17592186181023} {:answer/id #uuid "f980f955-67a7-56ef-baf7-82aef49577b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a = 3$, $b = 6$, and $c = \\frac{π}{2}$" :db/id #edb/ref 17592186181024} {:answer/id #uuid "130174c5-a9d5-5d26-9fb6-e0409a4b8a13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a = 9$, $b = 6$, and $c = \\frac{π}{4}$" :db/id #edb/ref 17592186181025} {:answer/id #uuid "72c89646-756f-5164-83a4-8941fd318bf5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a = 9$, $b = 3$, and $c = \\frac{π}{4}$" :db/id #edb/ref 17592186181026}] :answer-field/id #uuid "ec42b012-9bf0-5719-b03d-976ad3ce8760" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186181021}] :question/id #uuid "c0849207-55bc-5fea-b968-5ba9945591a8" :question/math-academy-id "q-138447" :question/problem "The complex $4$th roots of the number $z = 81[\\cos (\\frac{2π}{3}) + \\textrm{i}\\sin (\\frac{2π}{3})]$ are given by\n\n$z_{k}^{1/4} = a[\\cos (\\frac{π}{b} + c \\cdot k) + \\textrm{i}\\sin (\\frac{π}{b} + c \\cdot k)]$,\n\nwhere $k = 0, 1, 2, 3$. What are the values of $a$, $b$, and $c$?"} {:db/id #edb/ref 17592186184478 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e115dce-6c4a-5990-acf3-bf492c96d488" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x + \\frac{5}{2})^{2} + 3" :db/id #edb/ref 17592186181046} {:answer/id #uuid "a70edb35-cbf2-5e18-b8aa-351303b13799" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x + 5)^{2} + 3" :db/id #edb/ref 17592186181047} {:answer/id #uuid "cc6b90df-1c57-524a-8734-19d8517fefc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x - 5)^{2} + 3" :db/id #edb/ref 17592186181048} {:answer/id #uuid "f1b669fc-c53e-5ece-bb04-bb4167ea84d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x - \\frac{5}{4})^{2} + 3" :db/id #edb/ref 17592186181049} {:answer/id #uuid "56ee1c11-8464-5689-b873-51dcd5a5583d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x - \\frac{5}{2})^{2} + 3" :db/id #edb/ref 17592186181050}] :answer-field/id #uuid "eb8c466d-4935-54e2-a0c5-07904d3f71b9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186181045}] :question/id #uuid "7fde105f-56e2-5383-a76a-5a8fb4028ec0" :question/math-academy-id "q-140191" :question/problem "Rewrite the expression\n$(x^{2} + 5x + (\\frac{5}{2})^{2}) + 3$\nas the sum of a perfect square and a constant."} {:db/id #edb/ref 17592186184483 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0710913b-7399-5b9e-a5a9-f4627344dd74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}-{(y-\\frac{5}{2})}^{2}" :db/id #edb/ref 17592186565688} {:answer/id #uuid "0d6b0b59-5f4d-58eb-aec7-42d212af1618" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}-{(y-\\frac{5}{2})}^{2}" :db/id #edb/ref 17592186565700} {:answer/id #uuid "6969fc79-b38b-551a-bfdf-07495efdaf43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{4}-{(y-\\frac{5}{2})}^{2}" :db/id #edb/ref 17592186565842} {:answer/id #uuid "91d492cf-1c56-56df-bd04-4aabaf69aec4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "31-{(y+\\frac{5}{2})}^{2}" :db/id #edb/ref 17592186565914} {:answer/id #uuid "fc78b4ea-4ddc-5ed1-8637-95f6e755fa4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{49}{4}-{(y+\\frac{5}{2})}^{2}" :db/id #edb/ref 17592186566095}] :answer-field/correct {:answer/id #uuid "0d6b0b59-5f4d-58eb-aec7-42d212af1618" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}-{(y-\\frac{5}{2})}^{2}" :db/id #edb/ref 17592186565700} :answer-field/id #uuid "322303e8-364d-5afe-acc4-d76d39051ab7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186181075}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8f29e3f2-9a97-5ae1-80ba-f81c4f7c0fb6" :question/math-academy-id "q-140331" :question/problem "Rewrite $-({y}^{2}-5y+6)$ by completing the square." :question/worked-solution "We begin by completing the square for the expression inside the parentheses:\n\n$$\n{y}^{2}-5y+6\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}-2\\cdot \\frac{5}{2}y+6\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{5}{2})}^{2}$, writing the constant term $6$ last:\n\n$$\n\\underbrace{{y}^{2}-2\\cdot \\frac{5}{2}y+{(\\frac{5}{2})}^{2}}-{(\\frac{5}{2})}^{2}+6\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(y-\\frac{5}{2})}^{2}-{(\\frac{5}{2})}^{2}+6\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(y-\\frac{5}{2})}^{2}-\\frac{1}{4}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-({y}^{2}-5y+6) & =-({(y-\\frac{5}{2})}^{2}-\\frac{1}{4}) \\\\  & =-{(y-\\frac{5}{2})}^{2}+\\frac{1}{4} \\\\  & =\\frac{1}{4}-{(y-\\frac{5}{2})}^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184484 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2441e55c-3656-5b9c-9444-a562a3ff3b87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z-\\frac{1}{3})}^{2}+10" :db/id #edb/ref 17592186269586} {:answer/id #uuid "4f3faa2d-7189-540c-8002-572e91da81bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z+\\frac{1}{3})}^{2}+5" :db/id #edb/ref 17592186269984} {:answer/id #uuid "82317f98-eb55-5a2a-84b7-c0fc441aa39a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z-\\frac{1}{3})}^{2}-8" :db/id #edb/ref 17592186270394} {:answer/id #uuid "ca440db9-063c-5ec8-89e2-7e47d8b1e800" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z+\\frac{1}{3})}^{2}+10" :db/id #edb/ref 17592186271044} {:answer/id #uuid "f37d3db7-779c-579c-a14f-a3675bd5b658" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z+\\frac{1}{3})}^{2}+8" :db/id #edb/ref 17592186271404}] :answer-field/correct {:answer/id #uuid "ca440db9-063c-5ec8-89e2-7e47d8b1e800" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z+\\frac{1}{3})}^{2}+10" :db/id #edb/ref 17592186271044} :answer-field/id #uuid "02be3ebb-ff12-5196-b096-96eac16ef254" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271509}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2495fc0b-8e76-56e1-bf72-c223c52c4fc2" :question/math-academy-id "q-140378" :question/problem "Rewrite $-9{z}^{2}-6z+9$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $-9$. So, we take out a factor of $-9$ from the entire expression:\n\n$$\n-9({z}^{2}+\\frac{2}{3}z-1)\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{z}^{2}+\\frac{2}{3}z-1\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{z}^{2}+2\\cdot \\frac{1}{3}\\cdot z-1\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{1}{3})}^{2}$, writing the constant term $1$ last:\n\n$$\n\\underbrace{{z}^{2}+2\\cdot \\frac{1}{3}\\cdot z+{(\\frac{1}{3})}^{2}}-{(\\frac{1}{3})}^{2}-1\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(z+\\frac{1}{3})}^{2}-{(\\frac{1}{3})}^{2}-1\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(z+\\frac{1}{3})}^{2}-\\frac{10}{9}.\n$$\n\nFinally, we substitute this result back into our original expression::\n\n$$\n\\begin{aligned}-9({z}^{2}+\\frac{2}{3}z-1) & =-9({(z+\\frac{1}{3})}^{2}-\\frac{10}{9}) \\\\  & =-9{(z+\\frac{1}{3})}^{2}+(-9)\\cdot (-\\frac{10}{9}) \\\\  & =-9{(z+\\frac{1}{3})}^{2}+10\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184485 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "057bf8b9-f4be-51c0-a4d1-d57b29da8233" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{4}-{(x+\\frac{1}{2})}^{2}" :db/id #edb/ref 17592186565683} {:answer/id #uuid "61f2ea1d-2d8b-55fa-8520-17155db3eebf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-{(x+2)}^{2}" :db/id #edb/ref 17592186565832} {:answer/id #uuid "ddfed3f5-06e5-5e82-b0a9-731fa897dd17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{4}-{(x-\\frac{1}{2})}^{2}" :db/id #edb/ref 17592186566038} {:answer/id #uuid "e4f36cd8-e603-55a8-9ec8-ae98cefb08df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}-{(x+\\frac{1}{2})}^{2}" :db/id #edb/ref 17592186566051} {:answer/id #uuid "ff8880bf-ffee-5976-8095-806532a97526" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{4}-{(x+\\frac{1}{2})}^{2}" :db/id #edb/ref 17592186566098}] :answer-field/correct {:answer/id #uuid "ff8880bf-ffee-5976-8095-806532a97526" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{4}-{(x+\\frac{1}{2})}^{2}" :db/id #edb/ref 17592186566098} :answer-field/id #uuid "8091fb4f-3520-5238-a1fe-8deaeb6d643a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186181087}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "67f49a8a-532a-55d5-814b-4932396dbbeb" :question/math-academy-id "q-140406" :question/problem "Rewrite $-{x}^{2}-x-3$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $-1$. So, we take out a factor of $-1$ from the entire expression:\n\n$$\n-({x}^{2}+x+3)\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{x}^{2}+x+3\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}+2\\cdot \\frac{1}{2}x+3\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{1}{2})}^{2}$, writing the constant term $3$ last:\n\n$$\n\\underbrace{{x}^{2}+2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2}}-{(\\frac{1}{2})}^{2}+3\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(x+\\frac{1}{2})}^{2}-{(\\frac{1}{2})}^{2}+3\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(x+\\frac{1}{2})}^{2}+\\frac{11}{4}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-{x}^{2}-x-3 & =-({(x+\\frac{1}{2})}^{2}+\\frac{11}{4}) \\\\  & =-{(x+\\frac{1}{2})}^{2}-\\frac{11}{4} \\\\  & =-\\frac{11}{4}-{(x+\\frac{1}{2})}^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184494 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81a2cf1f-1cab-5103-be39-d1bd169865af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0 < x \\le 9" :db/id #edb/ref 17592186181141} {:answer/id #uuid "d11e633c-7deb-5147-9e62-26c73903c2e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x \\ge 9" :db/id #edb/ref 17592186181142} {:answer/id #uuid "0f2664a2-b231-56ea-a8dd-56e9b3e7845c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "