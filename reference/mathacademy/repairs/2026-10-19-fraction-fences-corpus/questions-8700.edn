nt :answer.type/math} :answer/value "x=28" :db/id #edb/ref 17592186611385} {:answer/id #uuid "ed60b90d-ccd0-5561-a494-e15e293fbc35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{8}{7}" :db/id #edb/ref 17592186611439}] :answer-field/correct {:answer/id #uuid "4f34dd08-b8f1-552a-9dd3-71da6b27acec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=56" :db/id #edb/ref 17592186611183} :answer-field/id #uuid "41ef719c-5c3d-5be6-b7b0-38d276bbbcac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186611487}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8113bd4c-68c9-5649-bbcf-ed1a7a8e7562" :question/math-academy-id "q-79817" :question/problem "Find the solution of ${log}_{2}⁡(x)-{log}_{2}⁡(7)=3.$" :question/worked-solution "The logarithms share the same base, and so we can combine them using the quotient rule, as follows:\n\n$$\n\\begin{aligned}{log}_{2}⁡(x)-{log}_{2}⁡(7) & =3 \\\\ {log}_{2}⁡(\\frac{x}{7}) & =3\\end{aligned}\n$$\n\nNow, we solve the equation for $x$ using the usual methods.\n\n$$\n\\begin{aligned}{2}^{{log}_{2}⁡(x/7)} & ={2}^{3} \\\\ \\frac{x}{7} & =8 \\\\ x & =56\\end{aligned}\n$$"} {:db/id #edb/ref 17592186611605 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0adab855-d5ed-5bc9-9590-d5ec6dd8e465" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{42}" :db/id #edb/ref 17592186611088} {:answer/id #uuid "463a31fa-2101-55ba-b229-42923eb8bd08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{36}" :db/id #edb/ref 17592186611173} {:answer/id #uuid "657e43c3-4510-504a-927c-1a1d035ada51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 