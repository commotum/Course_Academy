ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\left(14{x}^{6}-\\frac{3}{\\sqrt{{x}^{5}}}\\right)" :db/id #edb/ref 17592186484410}] :answer-field/correct {:answer/id #uuid "4ae87d93-a20b-5f09-9770-bcb0613bac77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\left(14{x}^{6}-\\frac{3}{\\sqrt{{x}^{5}}}\\right)" :db/id #edb/ref 17592186484410} :answer-field/id #uuid "70de6406-7b4b-586b-a0ad-0e0af36610de" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186484414}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ddbcf5e6-626a-58ec-bb4c-7099d5a9a9bf" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=4\\left(\\frac{{x}^{8}}{4}+x-\\frac{4}{\\sqrt{x}}\\right).$\n\n$\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=$\n{{field-1}}" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(4\\left(\\frac{{x}^{8}}{4}+x-\\frac{4}{\\sqrt{x}}\\right)) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4\\left(\\frac{{x}^{8}}{4}+x-4{x}^{-1/2}\\right)) \\\\  & =4\\left(8\\cdot \\frac{{x}^{7}}{4}+1-(-\\frac{1}{2})\\cdot 4{x}^{-3/2}\\right) \\\\  & =4\\left(2{x}^{7}+1+2{x}^{-3/2}\\right).\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(4\\left(2{x}^{7}+1+2{x}^{-3/2}\\right)) \\\\  & =4\\left(7\\cdot 2{x}^{6}+0+(-\\frac{3}{2})\\cdot 2{x}^{-5/2}\\right) \\\\  & =4\\left(14{x}^{6}-3{x}^{-5/2}\\right) \\\\  & =4\\left(14{x}^{6}-\\frac{3}{\\sqrt{{x}^{5}}}\\right).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186484781 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27a0fde4-6c24-58e7-8907-6d8654047db1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\sqrt{(5x-50)^{3}}+C" :db/id #edb/ref 17592186484774} {:answer/id #uuid "395ccb33-f39e-5064-b2d3-f2afb52894fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{15}\\sqrt{(5x-50)^{3}}+C" :db/id #edb/ref 17592186484775} {:answer/id #uuid "5e1f2e80-7a1d-5bc0-972b-78c0f2b50e11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\sqrt{5x-50}+C" :db/id #edb/ref 17592186484777} {:answer/id #uuid "83ae88bd-f536-5748-bae2-ac5ea45c189e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\sqrt{5x-50}+C" :db/id #edb/ref 17592186484780} {:answer/id #uuid "f9f20b17-9941-5017-867c-b8aa88c58c62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\sqrt{(5x-50)^{3}}+C" :db/id #edb/ref 17592186484784}] :answer-field/correct {:answer/id #uuid "395ccb33-f39e-5064-b2d3-f2afb52894fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{15}\\sqrt{(5x-50)^{3}}+C" :db/id #edb/ref 17592186484775} :answer-field/id #uuid "c299197f-14a7-5515-95eb-0c4198b78e17" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186484783}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8b9ac773-a814-5857-b454-ae543e57ffe1" :question/problem "$\\int \\sqrt{5x-50}\\,\\text{d}x=$" :question/worked-solution "First, we rewrite the integral as\n\n$$\n\\int (5x-50)^{1/2}\\,\\text{d}x.\n$$\n\nNow, we let $u=5x-50.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\text{d}x=\\frac{1}{5}\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $x$ at the very end:\n\n$$\n\\begin{aligned}\\int (5x-50)^{1/2}\\,\\text{d}x & =\\int {u}^{1/2}\\cdot (\\frac{1}{5})\\,\\text{d}u \\\\  & =\\frac{1}{5}\\int {u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{5}\\cdot \\frac{2}{3}{u}^{3/2}+C \\\\  & =\\frac{2}{15}{u}^{3/2}+C \\\\  & =\\frac{2}{15}(5x-50)^{3/2}+C \\\\  & =\\frac{2}{15}\\sqrt{(5x-50)^{3}}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[\\frac{2}{15}\\sqrt{(5x-50)^{3}}+C] & =\\frac{2}{15}\\cdot \\frac{\\text{d}}{\\text{d}x}[\\sqrt{(5x-50)^{3}}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =\\frac{2}{15}\\cdot \\frac{\\text{d}}{\\text{d}x}[(5x-50)^{3/2}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =\\frac{2}{15}\\cdot \\frac{3}{2}(5x-50)^{1/2}\\cdot \\frac{\\text{d}}{\\text{d}x}(5x-50)+0 \\\\  & =\\frac{1}{5}(5x-50)^{1/2}\\cdot 5 \\\\  & =(5x-50)^{1/2} \\\\  & =\\sqrt{5x-50}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186484799 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd535f0f-13a3-59e8-aa98-e4bebe36408f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{2} x}{2} - \\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186484791}] :answer-field/correct {:answer/id #uuid "cd535f0f-13a3-59e8-aa98-e4bebe36408f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{2} x}{2} - \\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186484791} :answer-field/id #uuid "939e86f3-e069-59f1-87f9-c70b1bca8329" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186484795}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "30a0323d-00da-5727-8bed-8f4570018874" :question/problem "Find the equation of the tangent to the curve $y=\\cos{\\left(\\sin{\\left(x \\right)} + \\frac{3 \\pi}{4} \\right)}$ at the point $\\left(0,- \\frac{\\sqrt{2}}{2}\\right)$.\n\nWrite the right-hand side of the equation in terms of $x$.\n\n$y=$ {{field-1}}" :question/worked-solution "First, the slope of $y=f(x)$ at $x=0$ is given by $f'(0)$.\n\nWe calculate $f'(x)$ using the chain rule. First, express $f(x)$ as the composite function\n\n$$f=\\cos u,\\qquad u=\\sin{\\left(x \\right)} + \\frac{3 \\pi}{4}.$$\n\nDifferentiating gives\n\n$$\\frac{\\mathrm{d}f}{\\mathrm{d}u}=-\\sin u,\\qquad \\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\cos x.$$\n\nWe now apply the chain rule:\n\n$$f'(x)=\\frac{\\mathrm{d}f}{\\mathrm{d}u}\\cdot \\frac{\\mathrm{d}u}{\\mathrm{d}x}=-\\sin(\\sin{\\left(x \\right)} + \\frac{3 \\pi}{4})\\cos x.$$\n\nEvaluating at $x=0$ gives $f'(0)=-\\sin(\\frac{3 \\pi}{4})=- \\frac{\\sqrt{2}}{2}$.\n\nFinally, use the point-slope equation:\n\n$$y-\\left(- \\frac{\\sqrt{2}}{2}\\right)=\\left(- \\frac{\\sqrt{2}}{2}\\right)(x-0),\\qquad y=- \\frac{\\sqrt{2} x}{2} - \\frac{\\sqrt{2}}{2}.$$"} {:db/id #edb/ref 17592186484800 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a1c429d-91c5-5bb7-af02-633485681a8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{x}{2} + \\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186484788}] :answer-field/correct {:answer/id #uuid "6a1c429d-91c5-5bb7-af02-633485681a8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{x}{2} + \\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186484788} :answer-field/id #uuid "cf12cc56-7e9d-5f32-968f-6c8272d67936" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186484796}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "53218be1-6a3c-5560-9338-ef81bd9ab181" :question/problem "Find the equation of the tangent to the curve $y=\\cos{\\left(\\sin{\\left(x \\right)} + \\frac{\\pi}{6} \\right)}$ at the point $\\left(0,\\frac{\\sqrt{3}}{2}\\right)$.\n\nWrite the right-hand side of the equation in terms of $x$.\n\n$y=$ {{field-1}}" :question/worked-solution "First, the slope of $y=f(x)$ at $x=0$ is given by $f'(0)$.\n\nWe calculate $f'(x)$ using the chain rule. First, express $f(x)$ as the composite function\n\n$$f=\\cos u,\\qquad u=\\sin{\\left(x \\right)} + \\frac{\\pi}{6}.$$\n\nDifferentiating gives\n\n$$\\frac{\\mathrm{d}f}{\\mathrm{d}u}=-\\sin u,\\qquad \\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\cos x.$$\n\nWe now apply the chain rule:\n\n$$f'(x)=\\frac{\\mathrm{d}f}{\\mathrm{d}u}\\cdot \\frac{\\mathrm{d}u}{\\mathrm{d}x}=-\\sin(\\sin{\\left(x \\right)} + \\frac{\\pi}{6})\\cos x.$$\n\nEvaluating at $x=0$ gives $f'(0)=-\\sin(\\frac{\\pi}{6})=- \\frac{1}{2}$.\n\nFinally, use the point-slope equation:\n\n$$y-\\left(\\frac{\\sqrt{3}}{2}\\right)=\\left(- \\frac{1}{2}\\right)(x-0),\\qquad y=- \\frac{x}{2} + \\frac{\\sqrt{3}}{2}.$$"} {:db/id #edb/ref 17592186484801 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6bac1832-cbc0-5239-b224-d88d18d436fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{3} x}{2} + \\frac{1}{2}" :db/id #edb/ref 17592186484789}] :answer-field/correct {:answer/id #uuid "6bac1832-cbc0-5239-b224-d88d18d436fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{3} x}{2} + \\frac{1}{2}" :db/id #edb/ref 17592186484789} :answer-field/id #uuid "1c500a86-e1db-5337-a98a-9655641e4016" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186484793}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9c2a70b8-20d0-5b7c-a81b-d0ca3277e712" :question/problem "Find the equation of the tangent to the curve $y=\\cos{\\left(\