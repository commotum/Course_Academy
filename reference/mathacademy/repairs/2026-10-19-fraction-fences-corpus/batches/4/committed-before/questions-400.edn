/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186382390} {:answer/id #uuid "41d02635-e49d-571a-96b0-1ac0a22b8838" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186382391} {:answer/id #uuid "6d245bf1-3343-5515-adf6-f1ffb3caa8af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{9}" :db/id #edb/ref 17592186382392}] :answer-field/correct {:answer/id #uuid "6d245bf1-3343-5515-adf6-f1ffb3caa8af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{9}" :db/id #edb/ref 17592186382392} :answer-field/id #uuid "2cf99c29-b792-5f2e-8440-d3e8129e97bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382387}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0d39e98a-42b8-56d2-88b4-63d088086c8a" :question/math-academy-id "q-80473" :question/problem "Find ${g}_{xx}(x,y)+{g}_{yy}(x,y)$ at $(1,-1)$ given that ${g}_{x}(x,y)=\\frac{2}{2x-y}$ and ${g}_{y}(x,y)=-\\frac{1}{2x-y}.$" :question/worked-solution "To find ${g}_{xx}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{g}_{xx}(x,y) & =\\frac{∂}{∂x}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}(\\frac{2}{2x-y}) \\\\  & =-\\frac{4}{(2x-y)^{2}}\\end{aligned}\n$$\n\n \n\nTo find ${g}_{yy}(x,y)$ we differentiate the given first-order partial derivative ${g}_{y}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{g}_{yy}(x,y) & =\\frac{∂}{∂y}({g}_{y}(x,y)) \\\\  & =\\frac{∂}{∂y}(-\\frac{1}{2x-y}) \\\\  & =-\\frac{1}{(2x-y)^{2}}\\end{aligned}\n$$\n\n \n\nNext, we evaluate ${g}_{xx}(x,y)$ and ${g}_{yy}(x,y)$ at $(1,-1):$\n\n$$\n\\begin{aligned}{g}_{xx}(1,-1) & =-\\frac{4}{(2(1)-(-1))^{2}}=-\\frac{4}{9} \\\\ {g}_{yy}(1,-1) & =-\\frac{1}{(2(1)-(-1))^{2}}=-\\frac{1}{9}\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n{g}_{xx}(1,-1)+{g}_{yy}(1,-1)=-\\frac{4}{9}-\\frac{1}{9}=-\\frac{5}{9}.\n$$"} {:db/id #edb/ref 17592186382407 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8458ae4-fafc-5a98-ab45-1adea4f03cfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186382409} {:answer/id #uuid "9addff4c-74aa-5855-b730-fe68fa5f33b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186382410} {:answer/id #uuid "e32440d6-fac7-5caf-bfd7-7612653eb6a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "39" :db/id #edb/ref 17592186382411} {:answer/id #uuid "8f95079d-845f-5ed2-b0b9-f6e1b9a61490" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "31" :db/id #edb/ref 17592186382412} {:answer/id #uuid "e93d0ef7-1d27-53c3-becc-c9dfd0fe94fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "29" :db/id #edb/ref 17592186382413}] :answer-field/correct {:answer/id #uuid "9addff4c-74aa-5855-b730-fe68fa5f33b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186382410} :answer-field/id #uuid "dc0d3863-9fe2-5bb6-8578-90c9d149b878" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382408}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "66d9f9e9-c9db-5bd9-aeae-e3f4c6b82bbb" :question/math-academy-id "q-80642" :question/problem "Evaluate the double integral ${∬}_{R}\\frac{1+y{x}^{3}}{{x}^{3}}\\,\\text{d}A$,  where $R=[1,2]\\times [0,8].$" :question/worked-solution "Using the linearity property of double integrals, we get\n\n$$\n\\begin{aligned}{∬}_{R}\\frac{1+y{x}^{3}}{{x}^{3}}\\,\\text{d}A & ={∬}_{R}(\\frac{1}{{x}^{3}}+y)\\,\\text{d}A \\\\  & ={∬}_{R}\\frac{1}{{x}^{3}}\\,\\text{d}A+{∬}_{R}y\\text{ }\\text{d}A.\\end{aligned}\n$$\n\nThe function under the first integral is independent of $y.$ So, we have \n\n$$\n\\begin{aligned}{∬}_{R}\\frac{1}{{x}^{3}}\\,\\text{d}A & =(8-0){\\int }_{1}^{2}\\frac{1}{{x}^{3}}\\,\\text{d}x \\\\  & =8\\cdot (-\\frac{1}{2{x}^{2}}{|}_{1}^{2}) \\\\  & =8\\cdot (-\\frac{1}{8}-(-\\frac{1}{2})) \\\\  & =3.\\end{aligned}\n$$\n\nThe function under the second integral is independent of $x.$ So, we have \n\n$$\n\\begin{aligned}{∬}_{R}y\\text{ }\\text{d}A & =(2-1){\\int }_{0}^{8}y\\,\\text{d}y \\\\  & =\\frac{{y}^{2}}{2}{|}_{0}^{8} \\\\  & =\\frac{{8}^{2}}{2}-\\frac{{0}^{2}}{2} \\\\  & =32.\\end{aligned}\n$$\n\nFinally, combining our results, we obtain \n\n$$\n\\begin{aligned}{∬}_{R}\\frac{1+y{x}^{3}}{{x}^{3}}\\,\\text{d}A=3+32=35.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186382511 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a54aa16-21f5-5f81-b8d9-9c8589a92326" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}-(x-\\frac{\\pi }{4})-\\frac{2}{3}{(x-\\frac{\\pi }{4})}^{3}" :db/id #edb/ref 17592186382513} {:answer/id #uuid "8451675c-800a-5b38-af7f-f845f72a952f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}+(x-\\frac{\\pi }{4})-\\frac{2}{3}{(x-\\frac{\\pi }{4})}^{3}" :db/id #edb/ref 17592186382514} {:answer/id #uuid "f1efee63-0a68-5b62-ad91-dd5c82f22c52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}-(x-\\frac{\\pi }{4})+\\frac{2}{3}{(x-\\frac{\\pi }{4})}^{3}" :db/id #edb/ref 17592186382515} {:answer/id #uuid "232bbbda-748f-5578-9cc6-fc727fb87eab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}+(x-\\frac{\\pi }{4})+\\frac{2}{3}{(x-\\frac{\\pi }{4})}^{2}" :db/id #edb/ref 17592186382516} {:answer/id #uuid "2231f346-b50a-53b8-9083-24d0360230c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}-(x-\\frac{\\pi }{4})-2{(x-\\frac{\\pi }{4})}^{2}" :db/id #edb/ref 17592186382517}] :answer-field/correct {:answer/id #uuid "f1efee63-0a68-5b62-ad91-dd5c82f22c52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}-(x-\\frac{\\pi }{4})+\\frac{2}{3}{(x-\\frac{\\pi }{4})}^{3}" :db/id #edb/ref 17592186382515} :answer-field/id #uuid "d3ae09dd-0816-5af5-9718-1c8c514f2997" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382512}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7920d835-2043-581c-9bbe-89a9298e8e8b" :question/math-academy-id "q-8292" :question/problem "The third-degree Taylor polynomial of  ${cos}^{2}⁡x$ about $x=\\frac{\\pi }{4}$ is" :question/worked-solution "To find the third-degree Taylor polynomial about $x=\\frac{\\pi }{4},$ we plug $a=\\frac{\\pi }{4}$ into the general formula to give\n\n$$\n\\begin{aligned}{P}_{3}(x) & =f(\\frac{\\pi }{4})+{f}^{′}(\\frac{\\pi }{4})(x-\\frac{\\pi }{4})+{f}^{″}(\\frac{\\pi }{4})\\frac{1}{2!}{(x-\\frac{\\pi }{4})}^{2}+{f}^{‴}(\\frac{\\pi }{4})\\frac{1}{3!}{(x-\\frac{\\pi }{4})}^{3} \\\\  & =f(\\frac{\\pi }{4})+{f}^{′}(\\frac{\\pi }{4})(x-\\frac{\\pi }{4})+\\frac{1}{2}{f}^{″}(\\frac{\\pi }{4}){(x-\\frac{\\pi }{4})}^{2}+\\frac{1}{6}{f}^{‴}(\\frac{\\pi }{4}){(x-\\frac{\\pi }{4})}^{3}.\\end{aligned}\n$$\n\nWe need to compute $f(\\frac{\\pi }{4}),$ ${f}^{′}(\\frac{\\pi }{4}),$ ${f}^{″}(\\frac{\\pi }{4}),$ and ${f}^{‴}(\\frac{\\pi }{4}),$ as follows:\n\n$$\n\\begin{aligned}f(x) & ={cos}^{2}⁡x & ⟹ &  & f(\\frac{\\pi }{4}) & ={cos}^{2}⁡(\\frac{\\pi }{4})=\\frac{1}{2} \\\\ {f}^{′}(x) & =-\\operatorname{sin}⁡2x & ⟹ &  & {f}^{′}(\\frac{\\pi }{4}) & =-\\operatorname{sin}⁡(\\frac{\\pi }{2})=-1 \\\\ {f}^{″}(x) & =-2\\operatorname{cos}⁡2x & ⟹ &  & {f}^{″}(\\frac{\\pi }{4}) & =-2\\operatorname{cos}⁡(\\frac{\\pi }{2})=0 \\\\ {f}^{‴}(x) & =4\\operatorname{sin}⁡2x & ⟹ &  & {f}^{‴}(\\frac{\\pi }{4}) & =4\\operatorname{sin}⁡(\\frac{\\pi }{2})=4\\end{aligned}\n$$\n\nFinally, we plug the results for $f(\\frac{\\pi }{4}),$ ${f}^{′}(\\frac{\\pi }{4}),$ ${f}^{″}(\\frac{\\pi }{4}),$ and ${f}^{‴}(\\frac{\\pi }{4})$ into our third-degree Taylor polynomial. This gives\n\n$$\n\\begin{aligned}{P}_{3}(x) & =\\frac{1}{2}-(x-\\frac{\\pi }{4})+\\frac{0}{2}{(x-\\frac{\\pi }{4})}^{2}+\\frac{4}{6}{(x-\\frac{\\pi }{4})}^{3} \\\\  & =\\frac{1}{2}-(x-\\frac{\\pi }{4})+\\frac{2}{3}{(x-\\frac{\\pi }{4})}^{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186382531 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d72eb555-87d0-5526-9c70-b70568124685" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186382533} {:answer/id #uuid "bcc07cad-b67b-56d5-8534-d467d9c0a7c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{4}" :db/id #edb/ref 17592186382534} {:answer/id #uuid "406d7ee6-8dea-5d51-b3aa-c2b96136d66e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186382535} {:answer/id #uuid "654df0e0-61ef-53de-9102-da25f8f2903e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186382536} {:answer/id #uuid "1d735932-5b00-56e0-8bb9-acfa5c8b62f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{4}" :db/id #edb/ref 17592186382537}] :answer-field/correct {:answer/id #uuid "bcc07cad-b67b-56d5-8534-d467d9c0a7c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{4}" :db/id #edb/ref 17592186382534} :answer-field/id #uuid "84dc87f5-6f21-53e1-8126-534a0ac395b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382532}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2b6da3ac-314c-5482-b55b-207ba10d814b" :question/math-academy-id "q-84015" :question/problem "If $\\text{E}[X]=\\frac{1}{2}$ and $\\text{E}[{X}^{2}]=\\frac{7}{2},$ then what is $\\text{Var}[X]?$" :question/worked-solution "We can compute the variance of a discrete random variable $X$ using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nSubstituting the given values, we get\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\frac{7}{2}-{(\\frac{1}{2})}^{2} \\\\  & =\\frac{7}{2}-\\frac{1}{4} \\\\  & =\\frac{13}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186382538 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f1fb796-5d3e-5d41-b5b4-9e57ebad00d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}" :db/id #edb/ref 17592186382540} {:answer/id #uuid "893c6278-dffa-5818-b50e-6dbd553b366c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186382541} {:answer/id #uuid "f3b9fb3b-ee24-5fed-b13c-880e1f5aa132" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186382542} {:answer/id #uuid "e82c4947-d47c-5e51-8c63-28d3d2cd82fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186382543} {:answer/id #uuid "a6a03297-1a60-5679-8fb2-1f2c752a8bad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186382544}] :answer-field/correct {:answer/id #uuid "f3b9fb3b-ee24-5fed-b13c-880e1f5aa132" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186382542} :answer-field/id #uuid "849203cd-d345-54c0-bce6-21c5612fe03f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382539}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3d27a865-eca1-5c67-b7c3-03ae037dc9df" :question/math-academy-id "q-84273" :question/problem "Let $X$ be the score obtained on the roll of a fair five-sided die with sides labeled with numbers $1$ through $5.$ What is $\\text{SD}[X]?$" :question/worked-solution "The standard deviation of a random variable $X$ is defined as\n\n$$\n\\text{SD}[X]=\\sqrt{\\text{Var}[X]},\n$$\n\nwhere the variance can be computed using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nFirst, we need to compute the probability mass function $f(x).$ Here, there are $5$ possible outcomes ($1,2,3,4,5$) and each outcome has the same probability, so the probability mass function is as follows:\n\n| $x$ | $1$ | $2$ | $3$ | $4$ | $5$ |\n| --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{5}$ | $\\frac{1}{5}$ | $\\frac{1}{5}$ | $\\frac{1}{5}$ | $\\frac{1}{5}$ |\n\nNext, we compute $\\text{E}[X].$ Summing up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =1\\cdot f(1)+2\\cdot f(2)+3\\cdot f(3)+4\\cdot f(4)+5\\cdot f(5) \\\\  & =1(\\frac{1}{5})+2(\\frac{1}{5})+3(\\frac{1}{5})+4(\\frac{1}{5})+5(\\frac{1}{5}) \\\\  & =3.\\end{aligned}\n$$\n\nThen, we compute $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={1}^{2}\\cdot f(1)+{2}^{2}\\cdot f(2)+{3}^{2}\\cdot f(3)+{4}^{2}\\cdot f(4)+{5}^{2}\\cdot f(5) \\\\  & =1(\\frac{1}{5})+4(\\frac{1}{5})+9(\\frac{1}{5})+16(\\frac{1}{5})+25(\\frac{1}{5}) \\\\  & =11.\\end{aligned}\n$$\n\nSo, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =11-{(3)}^{2} \\\\  & =11-9 \\\\  & =2.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{SD}[X] & =\\sqrt{\\text{Var}[X]} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186382545 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "574ef0a4-5362-5546-8528-72a3217d2aad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{21}{2}}" :db/id #edb/ref 17592186382547} {:answer/id #uuid "07b47daa-fc1f-5086-a20f-83e41511e01e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{12}}{4}" :db/id #edb/ref 17592186382548} {:answer/id #uuid "0a4cb418-f3f6-530a-ae36-923b8c194f50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{12}}{2}" :db/id #edb/ref 17592186382549} {:answer/id #uuid "cf43027f-8a6a-5763-8acc-2265bc9bfdff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{21}}{4}" :db/id #edb/ref 17592186382550} {:answer/id #uuid "32fe41e1-7e11-55da-845b-3ef002d00098" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{21}}{2}" :db/id #edb/ref 17592186382551}] :answer-field/correct {:answer/id #uuid "32fe41e1-7e11-55da-845b-3ef002d00098" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{21}}{2}" :db/id #edb/ref 17592186382551} :answer-field/id #uuid "1f5a3ad6-5ebf-5d26-9d5a-a818ee43fb49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382546}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e2101e2d-c6fd-5f92-9d3e-76d611379a69" :question/math-academy-id "q-84296" :question/problem "Let $X$ be the score obtained on the roll of a fair eight-sided die with sides labeled with numbers $1$ through $8.$ What is $\\text{SD}[X]?$" :question/worked-solution "The standard deviation of a random variable $X$ is defined as\n\n$$\n\\text{SD}[X]=\\sqrt{\\text{Var}[X]},\n$$\n\nwhere the variance can be computed using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nFirst, we need to compute the probability mass function $f(x).$ Here, there are $8$ possible outcomes $(1,2,3,4,5,6,7,8)$ and each outcome has the same probability, so the probability mass function is as follows:\n\n| $x$ | $1$ | $2$ | $3$ | $4$ | $5$ | $6$ | $7$ | $8$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{8}$ | $\\frac{1}{8}$ | $\\frac{1}{8}$ | $\\frac{1}{8}$ | $\\frac{1}{8}$ | $\\frac{1}{8}$ | $\\frac{1}{8}$ | $\\frac{1}{8}$ |\n\nNext, we compute $\\text{E}[X].$ Summing up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =1\\cdot f(1)+2\\cdot f(2)+3\\cdot f(3)+4\\cdot f(4)+5\\cdot f(5)+6\\cdot f(6)+7\\cdot f(7)+8\\cdot f(8) \\\\  & =1(\\frac{1}{8})+2(\\frac{1}{8})+3(\\frac{1}{8})+4(\\frac{1}{8})+5(\\frac{1}{8})+6(\\frac{1}{8})+7(\\frac{1}{8})+8(\\frac{1}{8}) \\\\  & =\\frac{9}{2}.\\end{aligned}\n$$\n\nThen, we compute $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={1}^{2}\\cdot f(1)+{2}^{2}\\cdot f(2)+{3}^{2}\\cdot f(3)+{4}^{2}\\cdot f(4)+{5}^{2}\\cdot f(5)+{6}^{2}\\cdot f(6)+{7}^{2}\\cdot f(7)+{8}^{2}\\cdot f(8) \\\\  & =1(\\frac{1}{8})+4(\\frac{1}{8})+9(\\frac{1}{8})+16(\\frac{1}{8})+25(\\frac{1}{8})+36(\\frac{1}{8})+49(\\frac{1}{8})+64(\\frac{1}{8}) \\\\  & =\\frac{51}{2}.\\end{aligned}\n$$\n\nSo, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{51}{2}-{(\\frac{9}{2})}^{2} \\\\  & =\\frac{51}{2}-\\frac{81}{4} \\\\  & =\\frac{21}{4}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{SD}[X] & =\\sqrt{\\text{Var}[X]} \\\\  & =\\sqrt{\\frac{21}{4}} \\\\  & =\\frac{\\sqrt{21}}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186382668 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "320d9242-a62e-5c01-9167-d38710e9024c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471809} {:answer/id #uuid "362b3fdd-9f80-5650-bbde-24dd702199b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471810}] :answer-field/correct {:answer/id #uuid "362b3fdd-9f80-5650-bbde-24dd702199b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471810} :answer-field/id #uuid "dd6540a6-001f-53ab-803a-662d03037eca" :answer-field/key "${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472410} {:answer-field/choices [{:answer/id #uuid "e8138994-dcf1-5ca7-b1d2-22437449679c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471811} {:answer/id #uuid "2c4bef01-6686-5bbb-b4b9-e6d742a886ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471812}] :answer-field/correct {:answer/id #uuid "e8138994-dcf1-5ca7-b1d2-22437449679c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471811} :answer-field/id #uuid "7ac12782-25b8-5598-a320-1aba893cb274" :answer-field/key "${f}_{1}(t)⊥{f}_{3}(t)$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472411} {:answer-field/choices [{:answer/id #uuid "15dc53de-e750-5228-914a-e0782ec8491a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471813} {:answer/id #uuid "d9d30f76-9cdf-5b19-82fb-3fe455865e34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471814}] :answer-field/correct {:answer/id #uuid "15dc53de-e750-5228-914a-e0782ec8491a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471813} :answer-field/id #uuid "09f2dcce-48f9-5c4f-8b06-c72964cad539" :answer-field/key "$S=\\{{f}_{1}(t),{f}_{2}(t),{f}_{3}(t)\\}$ is an orthogonal set with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472412}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d0457d3f-7a7d-578e-b127-39bac9e28900" :question/math-academy-id "q-99863" :question/problem "Consider the following set of functions:\n\n$$\n{f}_{1}(t)=t,\\,{f}_{2}(t)=\\operatorname{cos}⁡(2t),\\,{f}_{3}(t)=\\operatorname{sin}⁡t\n$$\n\nGiven that the inner product in the vector space $C[-\\pi /2,\\pi /2]$ of continuous functions over $[-\\pi /2,\\pi /2]$ is defined as \n\n$$\n⟨f(t),g(t)⟩={\\int }_{-\\pi /2}^{\\pi /2}f(t)g(t)\\,\\text{d}t,\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Recall that a set of vectors in an inner product space is called orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement “${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the given inner product” is true. We have\n\n$$\n\\begin{aligned}⟨{f}_{1}(t),{f}_{2}(t)⟩=⟨t,\\operatorname{cos}⁡(2t)⟩={\\int }_{-\\pi /2}^{\\pi /2}t\\operatorname{cos}⁡(2t)\\,\\text{d}t.\\end{aligned}\n$$\n\nLet's use integration by parts. We denote\n\n$$\n\\begin{aligned}u=t & ⟹ & {u}^{′}=1, \\\\ {v}^{′}=\\operatorname{cos}⁡(2t) & ⟹ & v=\\int {v}^{′}\\,\\text{d}t=\\int \\operatorname{cos}⁡(2t)\\,\\text{d}t=\\frac{\\operatorname{sin}⁡(2t)}{2}.\\end{aligned}\n$$\n\nNow, applying the integration by parts formula, we obtain \n\n$$\n\\begin{aligned}{\\int }_{-\\pi /2}^{\\pi /2}t\\operatorname{cos}⁡(2t)\\,\\text{d}t & =uv{|}_{-\\pi /2}^{\\pi /2}-{\\int }_{-\\pi /2}^{\\pi /2}{u}^{′}v\\,\\text{d}t \\\\  & =(t\\frac{\\operatorname{sin}⁡(2t)}{2}){|}_{-\\pi /2}^{\\pi /2}-\\frac{1}{2}{\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{sin}⁡(2t)\\,\\text{d}t \\\\  & =(\\frac{\\pi }{2}\\cdot \\frac{\\operatorname{sin}⁡(\\pi )}{2}-(-\\frac{\\pi }{2})\\cdot \\frac{\\operatorname{sin}⁡(-\\pi )}{2})+\\frac{\\operatorname{cos}⁡(2t)}{4}{|}_{-\\pi /2}^{\\pi /2} \\\\  & =0+(\\frac{\\operatorname{cos}⁡(\\pi )}{4}-\\frac{\\operatorname{cos}⁡(-\\pi )}{4}) \\\\  & =0.\\end{aligned}\n$$\n\nThis means that ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the given inner product.\n\n- Statement “${f}_{1}(t)⊥{f}_{3}(t)$ with respect to the given inner product” is false. We have\n\n$$\n\\begin{aligned}⟨{f}_{1}(t),{f}_{3}(t)⟩=⟨t,\\operatorname{sin}⁡t⟩={\\int }_{-\\pi /2}^{\\pi /2}t\\operatorname{sin}⁡t\\,\\text{d}t.\\end{aligned}\n$$\n\nLet's use integration by parts. We denote\n\n$$\n\\begin{aligned}u=t & ⟹ & {u}^{′}=1, \\\\ {v}^{′}=\\operatorname{sin}⁡t & ⟹ & v=\\int {v}^{′}\\,\\text{d}t=\\int \\operatorname{sin}⁡t\\,\\text{d}t=-\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nNow, applying the integration by parts formula, we obtain \n\n$$\n\\begin{aligned}{\\int }_{-\\pi /2}^{\\pi /2}t\\operatorname{sin}⁡t\\,\\text{d}t & =uv{|}_{-\\pi /2}^{\\pi /2}-{\\int }_{-\\pi /2}^{\\pi /2}{u}^{′}v\\,\\text{d}t \\\\  & =(-t\\operatorname{cos}⁡t){|}_{-\\pi /2}^{\\pi /2}+{\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =(-\\frac{\\pi }{2}\\cdot \\operatorname{cos}⁡(\\frac{\\pi }{2})-(-(-\\frac{\\pi }{2})\\cdot \\operatorname{cos}⁡(-\\frac{\\pi }{2})))+\\operatorname{sin}⁡t{|}_{-\\pi /2}^{\\pi /2} \\\\  & =0+(\\operatorname{sin}⁡(\\frac{\\pi }{2})-\\operatorname{sin}⁡(-\\frac{\\pi }{2})) \\\\  & =1-(-1) \\\\  & =2\\ne 0.\\end{aligned}\n$$\n\nThis means that ${f}_{1}(t)⊥̸{f}_{3}(t)$ with respect to the given inner product.\n\n- Statement “$S=\\{{f}_{1}(t),{f}_{2}(t),{f}_{3}(t)\\}$ is an orthogonal set with respect to the given inner product” is false. Since ${f}_{1}(t)⊥̸{f}_{3}(t),$ the set $S$ is *not* orthogonal.\n\nTherefore, the correct answer is “${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the given inner product” only."} {:db/id #edb/ref 17592186382675 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bb3f792-8daa-5481-90a3-72c22e1e0cc1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471815} {:answer/id #uuid "37bf6595-efed-5e05-9eea-c39ccace55ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471816}] :answer-field/correct {:answer/id #uuid "3bb3f792-8daa-5481-90a3-72c22e1e0cc1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471815} :answer-field/id #uuid "ef3c0786-1837-57ae-b61a-5fcc2a1ae0da" :answer-field/key "${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472413} {:answer-field/choices [{:answer/id #uuid "82d9a59f-6071-55e9-ba83-81a93266ba78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471817} {:answer/id #uuid "7f4ccf74-dfd0-5457-ae1d-2f4b1376f55f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471818}] :answer-field/correct {:answer/id #uuid "7f4ccf74-dfd0-5457-ae1d-2f4b1376f55f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471818} :answer-field/id #uuid "b4772d99-ef37-508b-be2b-5bf2236274df" :answer-field/key "${f}_{2}(t)⊥{f}_{3}(t)$ with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472414} {:answer-field/choices [{:answer/id #uuid "983ffe32-ea8e-5549-a804-3f8a808db229" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471819} {:answer/id #uuid "9b9010c5-b935-59a9-aa88-3c4656c8a125" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471820}] :answer-field/correct {:answer/id #uuid "983ffe32-ea8e-5549-a804-3f8a808db229" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471819} :answer-field/id #uuid "9241636c-59e4-57aa-90d4-9f47ca3f6f1e" :answer-field/key "$S={{f}_{1}(t),{f}_{2}(t),{f}_{3}(t)}$ is an orthogonal set with respect to the given inner product" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472415}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "866dfd7d-0156-5915-b7a2-48bb304694df" :question/math-academy-id "q-99949" :question/problem "Consider the following set of functions:\n\n$$\n{f}_{1}(t)=\\operatorname{sin}⁡(2t),\\,{f}_{2}(t)=\\operatorname{sin}⁡t,\\,{f}_{3}(t)=\\operatorname{cos}⁡t\n$$\n\nGiven that the inner product in the vector space $C[-\\pi /2,\\pi /2]$ of continuous functions over $[-\\pi /2,\\pi /2]$ is defined as \n\n$$\n⟨f(t),g(t)⟩={\\int }_{-\\pi /2}^{\\pi /2}f(t)g(t)\\,\\text{d}t,\n$$\n\nwhich of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Recall that a set of vectors in an inner product space is called orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement “${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the given inner product” is false. We have\n\n$$\n\\begin{aligned}⟨{f}_{1}(t),{f}_{2}(t)⟩=⟨\\operatorname{sin}⁡(2t),\\operatorname{sin}⁡t⟩={\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{sin}⁡(2t)\\operatorname{sin}⁡t\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can evaluate this integral using the identity $\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ))$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{sin}⁡(2t)\\,\\operatorname{sin}⁡t\\,\\text{d}t & =\\frac{1}{2}{\\int }_{-\\pi /2}^{\\pi /2}(\\operatorname{cos}⁡(2t-t)-\\operatorname{cos}⁡(2t+t))\\,\\text{d}t \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /2}^{\\pi /2}(\\operatorname{cos}⁡t+\\operatorname{cos}⁡(3t))\\,\\text{d}t \\\\  & =\\frac{1}{2}(\\operatorname{sin}⁡t+\\frac{1}{3}\\operatorname{sin}⁡(3t)){|}_{-\\pi /2}^{\\pi /2} \\\\  & =\\frac{1}{2}(\\operatorname{sin}⁡(\\frac{\\pi }{2})+\\frac{1}{3}\\operatorname{sin}⁡(\\frac{\\pi }{2}))-\\frac{1}{2}(\\operatorname{sin}⁡(-\\frac{\\pi }{2})+\\frac{1}{3}\\operatorname{sin}⁡(-\\frac{\\pi }{2})) \\\\  & =\\frac{1}{2}\\cdot \\frac{4}{3}-\\frac{1}{2}\\cdot (-\\frac{4}{3}) \\\\  & =\\frac{4}{3}\\ne 0.\\end{aligned}\n$$\n\nThis means that ${f}_{1}(t)⊥̸{f}_{2}(t)$ with respect to the given inner product.\n\n- Statement “${f}_{2}(t)⊥{f}_{3}(t)$ with respect to the given inner product” is true. We have\n\n$$\n\\begin{aligned}⟨{f}_{2}(t),{f}_{3}(t)⟩=⟨\\operatorname{sin}⁡t,\\operatorname{cos}⁡t⟩={\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can evaluate this integral using the substitution $u=\\operatorname{sin}⁡t,$ differentiating we have $\\text{d}u=\\operatorname{cos}⁡t.$ Hence:\n\n$$\n\\begin{aligned}{\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{sin}⁡t\\,\\operatorname{cos}⁡t\\,\\text{d}t & =\\frac{1}{2}{sin}^{2}⁡t{|}_{-\\pi /2}^{\\pi /2} \\\\  & =\\frac{1}{2}({sin}^{2}⁡(\\frac{\\pi }{2})-{sin}^{2}⁡(-\\frac{\\pi }{2})) \\\\  & =\\frac{1}{2}(1-1) \\\\  & =0.\\end{aligned}\n$$\n\nThis means that ${f}_{2}(t)⊥{f}_{3}(t)$ with respect to the given inner product.\n\n- Statement “$S={{f}_{1}(t),{f}_{2}(t),{f}_{3}(t)}$ is an orthogonal set with respect to the given inner product” is false. Since ${f}_{1}(t)⊥̸{f}_{2}(t),$ the set $S$ is *not* orthogonal.\n\nTherefore, the correct answer is “${f}_{2}(t)⊥{f}_{3}(t)$ with respect to the given inner product” only."} {:db/id #edb/ref 17592186382881 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "713ee101-2a79-58d1-b713-6678cd074ba5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186382883} {:answer/id #uuid "67d302d6-b15c-5b01-b141-462574e129b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186382884} {:answer/id #uuid "e2b72884-f538-57f3-b9a0-a333760c107d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186382885} {:answer/id #uuid "bd0f2cae-d9e2-5cc4-a916-ab816a5a1103" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186382886} {:answer/id #uuid "b9664ae5-a397-5208-b164-0d09c636c70d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186382887}] :answer-field/correct {:answer/id #uuid "e2b72884-f538-57f3-b9a0-a333760c107d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186382885} :answer-field/id #uuid "78998dee-1a04-577f-aa38-b50d2e0d1c1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382882}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "84162c13-0400-58a1-8d2e-69976eb5fd62" :question/math-academy-id "q-109234" :question/problem "Compute $\\text{E}[-6X-1]$ if $\\text{E}[X]=-\\frac{3}{2}.$" :question/worked-solution "For any constants $a$ and $b$ and any random variable $X,$ we have\n\n$$\n\\text{E}[aX+b]=a\\text{E}[X]+b.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{E}[-6X-1] & =-6\\text{E}[X]-1 \\\\  & =-6(-\\frac{3}{2})-1 \\\\  & =8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186383006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8bec6eb-8e0a-5ce5-966f-3cfc2e175f0e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fd/fdcd6cebad2e9aef26daf2987b2890a1b05ceeab5f8e803b631cdb4a6a4598c4.png" :db/id #edb/ref 17592186383008} {:answer/id #uuid "eee84ab8-4f31-5f75-abfa-e9d0d3f0fc7d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d9/d91a13ce4ee54923d33ab5df7506ce8200d02f53695d85d186e0c9f5dc9345db.png" :db/id #edb/ref 17592186383009} {:answer/id #uuid "8f0f9738-4804-5496-8f1c-2a371d83d08f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/57/57ab7ae667788fe307f67df7078d91ee8c0e82f9703d1c59c439a790af9b2fbb.png" :db/id #edb/ref 17592186383010} {:answer/id #uuid "837b5ab1-a135-59d4-bd04-ec207c823e91" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/22/2215b79d50f88933aa2b83eb76251eb97a9f3491ffc86b0c5e0eba3debd80cdd.png" :db/id #edb/ref 17592186383011} {:answer/id #uuid "c6be86a5-a237-5718-8d27-339f9839dbc7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/94/94f8ffc9b7e98188d2a0429ada7f936df7816e9a04d42e97d3b57e6ab34cfe41.png" :db/id #edb/ref 17592186383012}] :answer-field/correct {:answer/id #uuid "f8bec6eb-8e0a-5ce5-966f-3cfc2e175f0e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fd/fdcd6cebad2e9aef26daf2987b2890a1b05ceeab5f8e803b631cdb4a6a4598c4.png" :db/id #edb/ref 17592186383008} :answer-field/id #uuid "f519e720-525e-5a35-9830-b680df8d1973" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383007}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1b63c956-bea1-5b1b-a3bb-61d243984ef7" :question/math-academy-id "q-122687" :question/problem "Which of the following diagrams represents the gradient vector field of the function $f(x,y)=\\frac{{x}^{2}-{y}^{2}}{2}?$" :question/worked-solution "The gradient vector field of a function $f$ is given by $∇f.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\frac{{x}^{2}-{y}^{2}}{2}) \\\\  & =x \\\\ {f}_{y}(x,y) & =\\frac{∂}{∂y}(\\frac{{x}^{2}-{y}^{2}}{2}) \\\\  & =-y\\end{aligned}\n$$\n\nSo, the gradient vector field of $f(x,y)$ is\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =x\\,i-y\\,j.\\end{aligned}\n$$\n\nNext, we have to sketch the vector field at the points $(-2,1),$ $(1,1),$ and $(2,-1).$\n\nTo sketch the vector field at the given points, we substitute their coordinates into the expression for $∇f.$\n\n$$\n\\begin{aligned}∇f(-2,1) & =(-2)\\,i-j=-2\\,i-j \\\\ ∇f(1,1) & =i-j \\\\ ∇f(2,-1) & =2\\,i-(-1)\\,j=2i+j\\end{aligned}\n$$\n\n \n\nNow, we draw the vectors starting at the corresponding points and obtain the following diagram:\n\n![](images/fd/fdcd6cebad2e9aef26daf2987b2890a1b05ceeab5f8e803b631cdb4a6a4598c4.png)"}]
