s of $u$ and evaluate it, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{3}{1-9{x}^{2}}\\,\\text{d}x & =3\\int \\frac{1}{1-(3x)^{2}}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{1-{u}^{2}}\\,\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\int \\frac{1}{1-{u}^{2}}\\,\\text{d}u \\\\  & =\\operatorname{artanh}⁡u+C \\\\  & =\\operatorname{artanh}⁡3x+C\\end{aligned}\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|3x|<1.$"} {:db/id #edb/ref 17592186360642 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c7abe6b-3c52-5f03-8039-44369717a52a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\operatorname{artanh}⁡\\left(\\frac{x}{3}\\right)+C" :db/id #edb/ref 17592186357998} {:answer/id #uuid "851c0451-33f4-59d8-9906-c2776070bb01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}\\operatorname{artanh}⁡\\left(\\frac{x}{9}\\right)+C" :db/id #edb/ref 17592186358922} {:answer/id #uuid "aedbc8f1-df8c-56cf-a98d-387788890e47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}\\operatorname{artanh}⁡\\left(\\frac{x}{3}\\right)+C" :db/id #edb/ref 17592186359273} {:answer/id #uuid "cd5ba55b-7d7c-5025-90a8-15bf54c1e69b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{artanh}⁡\\left(\\frac{x}{9}\\right)+C" :db/id #edb/ref 17592186359557} {:answer/id #uuid "feb80318-098c-5e81-b7c8-c5dd6afe4276" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{artanh}⁡\\left(\\frac{x}{3}\\right)+C" :db/id #edb/ref 17592186359993}] :answer-field/correct {:answer/id #uuid "aedbc8f1-df8c-56cf-a98d-387788890e47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}\\operatorname{artanh}⁡\\left(\\frac{x}{3}\\right)+C" :db/id #edb/ref 17592186359273} :answer-field/id #uuid "fe540910-122e-507b-8334-9095ef30d012" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360449}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a0231fda-6ee5-552f-8769-761c14f66200" :question/math-academy-id "q-95863" :question/problem "$\\int \\frac{5}{9-{x}^{2}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as\n\n$$\n\\int \\frac{5}{9-{x}^{2}}\\,\\text{d}x=\\frac{5}{9}\\int \\frac{1}{1-{\\left(\\frac{x}{3}\\right)}^{2}}\\,\\text{d}x.\n$$\n\nThis integral resembles the basic integral for the inverse hyperbolic tangent,\n\n$$\n\\int \\frac{1}{1-{u}^{2}}\\,\\text{d}u=\\operatorname{artanh}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\left(\\frac{x}{3}\\right)}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{3}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}x=3\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and compute it, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{5}{9-{x}^{2}}\\,\\text{d}x & =\\frac{5}{9}\\int \\frac{1}{1-{\\left(\\frac{x}{3}\\right)}^{2}}\\,\\text{d}x \\\\  & =\\frac{5}{9}\\int \\frac{1}{1-{u}^{2}}\\cdot 3\\,\\text{d}u \\\\  & =\\frac{5}{3}\\int \\frac{\\text{d}u}{1-{u}^{2}} \\\\  & =\\frac{5}{3}\\operatorname{artanh}⁡u+C \\\\  & =\\frac{5}{3}\\operatorname{artanh}⁡\\left(\\frac{x}{3}\\right)+C\\end{aligned}\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|\\frac{x}{3}|<1.$"} {:db/id #edb/ref 17592186360643 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "312f5867-85b1-5ebe-8d3e-6effce2fd58c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{artanh}⁡\\left(\\frac{x}{3}\\right)+C" :db/id #edb/ref 1759218