ht)}^{2}-1}}\\,\\text{d}x \\\\  & =\\frac{1}{5}\\int \\frac{1}{\\sqrt{{u}^{2}-1}}\\cdot 5\\,\\text{d}u \\\\  & =\\int \\frac{\\text{d}u}{\\sqrt{{u}^{2}-1}} \\\\  & =\\operatorname{arcosh}⁡u+C \\\\  & =\\operatorname{arcosh}⁡\\left(\\frac{x}{5}\\right)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186360637 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0300f055-15a9-5a42-a976-27588f91c073" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{2}\\operatorname{arcosh}⁡\\left(\\frac{x}{2\\sqrt{2}}\\right)+C" :db/id #edb/ref 17592186357783} {:answer/id #uuid "0360f24e-e488-55c5-93d9-d50dc2608aff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{arsinh}⁡\\left(\\frac{x}{2\\sqrt{2}}\\right)+C" :db/id #edb/ref 17592186357787} {:answer/id #uuid "78ecc646-f886-5071-88f2-cf869a45ffeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{arsinh}⁡\\left(\\frac{x}{2\\sqrt{2}}\\right)+C" :db/id #edb/ref 17592186358799} {:answer/id #uuid "d27df2a2-8f9e-5ed3-b5e5-840f1f946d6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{arcosh}⁡\\left(\\frac{x}{2\\sqrt{2}}\\right)+C" :db/id #edb/ref 17592186359592} {:answer/id #uuid "e0cd3acc-dca7-54ac-95df-7cbe9925a486" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{arcosh}⁡\\left(\\frac{x}{2\\sqrt{2}}\\right)+C" :db/id #edb/ref 17592186359726}] :answer-field/correct {:answer/id #uuid "d27df2a2-8f9e-5ed3-b5e5-840f1f946d6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{arcosh}⁡\\left(\\frac{x}{2\\sqrt{2}}\\right)+C" :db/id #edb/ref 17592186359592} :answer-field/id #uuid "581d1672-9e7e-59e8-a32d-1043f8af0665" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360131}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5778f0e7-c883-5ace-aff8-713fde050031" :question/math-academy-id "q-95854" :question/problem "$\\int \\frac{\\sqrt{2}}{\\sqrt{{x}^{2}-8}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as\n\n$$\n\\int \\frac{\\sqrt{2}}{\\sqrt{{x}^{2}-8}}\\,\\text{d}x=\\frac{\\sqrt{2}}{\\sqrt{8}}\\int \\frac{1}{\\sqrt{{\\left(\\frac{x}{\\sqrt{8}}\\right)}^{2}-1}}\\,\\text{d}x=\\frac{1}{2}\\int \\frac{1}{\\sqrt{{\\left(\\frac{x}{2\\sqrt{2}}\\right)}^{2}-1}}\\,\\text{d}x.\n$$\n\nThis integral resembles the basic integral for the inverse hyperbolic cosine,\n\n$$\n\\int \\frac{1}{\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\operatorname{arcosh}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\left(\\frac{x}{2\\sqrt{2}}\\right)}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{2\\sqrt{2}}.$ Differentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2\\sqrt{2}}\\,⟹\\,\\text{d}x=2\\sqrt{2}\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate it, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{\\sqrt{2}}{\\sqrt{{x}^{2}-8}}\\,\\text{d}x & =\\frac{1}{2}\\int \\frac{1}{\\sqrt{{\\left(\\frac{x}{2\\sqrt{2}}\\right)}^{2}-1}}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\frac{1}{\\sqrt{{u}^{2}-1}}\\cdot 2\\sqrt{2}\\,\\text{d}u \\\\  & =\\sqrt{2}\\int \\frac{\\text{d}u}{\\sqrt{{u}^{2}-1}} \\\\  & =\\sqrt{2}\\operatorname{arcosh}⁡u+C \\\\  & =\\sqrt{2}\\operatorname{arcosh}⁡\\left(\\frac{x}{2\\sqrt{2}}\\right)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186360638 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "079a1a12-34ee-5d55-b1da-493e6df38e38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\operatorname{arcosh}⁡\\left(\\frac{x}{7}\\right)+C" :db/id #edb/ref 17592186357818} {:answer/id #uuid "1819442e-2d66-5ce8-93d2-88ced3bef070" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49\\operatorname{arsinh}⁡\\left(\\frac{x}{7}\\right)+C" :db/id #edb/ref 17592186357962} {:answer/id #uuid "80f3ec49-a6ed-5490-8707-331d16f0a430" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arcosh}⁡\\left(\\frac{x}{7}\\right)+C" :db/id #edb/ref 17592186358878} {:answer/id #uuid "b50df938-ebae-57af-99bb-abb789a6ed56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49\\operatorname{arcosh}⁡\\left(\\frac{x}{7}\\right)+C" :db/id #edb/ref 17592186359329} {:answer/id #uuid "e30e62b8-67e0-574d-a070-2a93317e595d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arsinh}⁡\\left(\\frac{x}{7}\\right)+C" :db/id #edb/ref 17592186359760}] :answer-field/correct {:answer/id #uuid "079a1a12-34ee-5d55-b1da-493e6df38e38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\operatorname{arcosh}⁡\\left(\\frac{x}{7}\\right)+C" :db/id #edb/ref 17592186357818} :answer-field/id #uuid "77896b35-a634-5681-9c09-ef0ca072e3cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360189}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9b3cc50b-1482-54be-9ec6-f67d0af25756" :question/math-academy-id "q-95855" :question/problem "$\\int \\frac{7}{\\sqrt{{x}^{2}-49}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as\n\n$$\n\\int \\frac{7}{\\sqrt{{x}^{2}-49}}\\,\\text{d}x=\\int \\frac{1}{\\sqrt{{\\left(\\frac{x}{7}\\right)}^{2}-1}}\\,\\text{d}x.\n$$\n\nThis integral resembles the basic integral for the inverse hyperbolic cosine,\n\n$$\n\\int \\frac{1}{\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\operatorname{arcosh}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\left(\\frac{x}{7}\\right)}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{7}.$ Differentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{7}\\,⟹\\,\\text{d}x=7\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate it, as follows:\n\n$$\n\\begin{aligned}\\int \\frac{7}{\\sqrt{{x}^{2}-49}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{{\\left(\\frac{x}{7}\\right)}^{2}-1}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{{u}^{2}-1}}\\cdot 7\\,\\text{d}u \\\\  & =7\\int \\frac{\\text{d}u}{\\sqrt{{u}^{2}-1}} \\\\  & =7\\operatorname{arcosh}⁡u+C \\\\  & =7\\operatorname{arcosh}⁡\\left(\\frac{x}{7}\\right)+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186360639 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d3b2000-b6c1-50c8-8493-9b6f7c032407" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{artanh}⁡4x+C" :db/id #edb/ref 17592186357861} {:answer/id #uuid "2f445de7-9dad-578f-97fa-8dd71b15bd8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\operatorname{artanh}⁡4x+C" :db/id #edb/ref 17592186358172} {:answer/id #uuid "420172c9-d699-565a-87dd-08a9762ace37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\operatorname{artanh}⁡\\left(\\frac{x}{4}\\right)+C" :db/id #edb/ref 17592186358311} {:answer/id #uuid "b338fb37-93a2-5343-8eee-3f9ddeef1b56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{artanh}⁡\\left(\\frac{x}{3}\\right)+C" :db/id #edb/ref 17592186359314} {:answer/id #uuid "f7b30392-5763-53d9-af6a-5fbb45646ac1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{artanh}⁡4x+C" :db/id #edb/ref 17592186359945}] :answer-field/correct {:answer/id #uuid "0d3b2000-b6c1-50c8-8493-9b6f7c032407" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{artanh}⁡4x+C" :db/id #edb/ref 17592186357861} :answer-field/id #uuid "1e2f79ff-b205-5ce1-8230-a1ab74bf1adf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360045}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7533afb6-a59a-5b21-b238-07d91af9b37a" :question/math-academy-id "q-95858" :question/problem "$\\int \\frac{12}{1-16{x}^{2}}\\,\\text{d}x=$" :question/worked-solution "This integral resembles the basic integral for the inverse hyperbolic tangent,\n\n$$\n\\int \\frac{1}{1-{u}^{2}}\\,\\text{d}u=\\operatorname{artanh}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $16{x}^{2}=(4x)^{2}.$\n\nSo, let's substitute $u=4x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4\\,⟹\\,\\frac{1}{4}\\,\\text{d}u=\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate it, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{12}{1-16{x}^{2}}\\,\\text{d}x & =12\\int \\frac{1}{1-(4x)^{2}}\\,\\text{d}x \\\\  & =12\\int \\frac{1}{1-{u}^{2}}\\,\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =3\\int \\frac{1}{1-{u}^{2}}\\,\\text{d}u \\\\  & =3\\operatorname{artanh}⁡u+C \\\\  & =3\\operatorname{artanh}⁡4x+C\\end{aligned}\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|4x|<1.$"} {:db/id #edb/ref 17592186360640 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5efe981f-1da3-511a-8435-97d8f9401eed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{artanh}⁡3x+C" :db/id #edb/ref 17592186358579} {:answer/id #uuid "66509511-e48f-58ce-801e-919e743