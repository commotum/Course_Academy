e/math} :answer/value "-2" :db/id #edb/ref 17592186374706}] :answer-field/correct {:answer/id #uuid "12626573-6c84-5178-b8b2-1f93eba76ae0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186374704} :answer-field/id #uuid "a5b58903-bf80-58db-89a8-5b30631e410d" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186374703} {:answer-field/choices [{:answer/id #uuid "1682b7cb-18d2-5f0e-9ce8-960079cb2a2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186374708} {:answer/id #uuid "4783d337-fbd2-5808-9c30-f03620927e71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186374709} {:answer/id #uuid "d89fdbe7-33e7-5dc5-9dee-7d1d8f42d090" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186374710}] :answer-field/correct {:answer/id #uuid "1682b7cb-18d2-5f0e-9ce8-960079cb2a2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186374708} :answer-field/id #uuid "589a4a5b-cb5b-5d13-b725-73333b8bacd1" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186374707}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "66522298-df3c-59f8-aea2-27f48f44c2a6" :question/math-academy-id "q-333373" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=-(x+1)(y+3),\\,y(0)=-1\n$$\n\nWe wish to approximate the solution using the $2$-step Adams-Bashforth-Moulton method. Given that the step size is $Δx=1,$ and that one preliminary step has already been computed using the Runge-Kutta method, complete the next row of the table below.\n\n*Hint: The corrector equation of the two-step Adams-Bashforth-Moulton method is defined as*\n\n$$\nΔy=\\frac{1}{12}(5{y}_{p}^{′}+8{y}^{′}-{y}_{-1}^{′})\\cdot Δx\n$$\n\n*where ${y}_{p}$ denotes the predictor at the current step, and ${y}_{-1}^{′}$ is the estimated slope at the previous point.* \n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $Δ{y}_{p}$ | ${y}_{p}$ | ${y}_{p}^{′}$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $-1$ | $-2$ | $-$ | $-$ | $-$ | $-\\frac{3}{2}$ |\n| $1$ | $-\\frac{5}{2}$ | {{field-1}} | {{field-2}} | {{field-3}} | {{field-4}} | {{field-5}} |\n\nTherefore, $y(2)≈$\n  {{field-6}}." :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe $2$-Step Adams-Bashforth-Moulton (ABM2) method with step size $Δx$ is given by\n\n$$\n\\begin{aligned}\\text{Predictor} & : & Δ{y}_{p} & =\\frac{1}{2}(3{y}^{′}-{y}_{-1}^{′})\\cdot Δx, \\\\ \\text{Corrector} & : & Δy & =\\frac{1}{12}(5{y}_{p}^{′}+8{y}^{′}-{y}_{-1}^{′})\\cdot Δx,\\end{aligned}\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the estimated slope at the current point $(x,y),$\n\n- ${y}_{-1}^{′}=f({x}_{-1},{y}_{-1})$ is the estimated slope at the previous point (${x}_{-1},{y}_{-1}),$ and\n\n- ${y}_{p}^{′}=f({x}_{\\text{new}},{y}_{p})$ is the estimated slope at the predicted new point $({x}_{\\text{new}},{y}_{p})=(x+Δx,y+Δ{y}_{p}).$\n\nWe're told that the first step is calculated using the Runge-Kutta Method, resulting in \n\n$$\ny(1)≈-\\frac{5}{2}.\n$$\n\nNow, we'll continue from this point, using the $2$-step ABM method.\n\nFirst, we compute the value of ${y}^{′}$ according to the given rule:\n\n$$\n\\begin{aligned}{y}^{′} & =-(x+1)(y+3) \\\\  & =-(1+1)(-\\frac{5}{2}+3) \\\\  & =-1\\end{aligned}\n$$\n\nSo, we add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $Δ{y}_{p}$ | ${y}_{p}$ | ${y}_{p}^{′}$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $-1$ | $-2$ | $-$ | $-$ | $-$ | $-\\frac{3}{2}$ |\n| $1$ | $-\\frac{5}{2}$ | $-1$ |  |  |  |  |\n\nFrom the first row of the table, we see that the slope at the previous point $({x}_{-1},{y}_{-1})=(0,-1)$ is ${y}_{-1}^{′}=-2.$\n\nNext, we compute $Δ{y}_{p}$ using the predictor equation:\n\n$$\n\\begin{aligned}Δ{y}_{p} & =\\frac{1}{2}(3{y}^{′}-{y}_{-1}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}(3\\cdot (-1)-(-2))\\cdot 1 \\\\  & =-\\frac{1}{2}\\end{aligned}\n$$\n\nWe add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $Δ{y}_{p}$ | ${y}_{p}$ | ${y}_{p}^{′}$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $-1$ | $-2$ | $-$ | $-$ | $-$ | $-\\frac{3}{2}$ |\n| $1$ | $-\\frac{5}{2}$ | $-1$ | $-\\frac{1}{2}$ |  |  |  |\n\nSo, the coordinates of the predicted new point are\n\n$$\n\\begin{aligned}{x}_{\\text{new}} & =x+Δx=1+1=2, \\\\ {y}_{p} & =y+Δ{y}_{p}=-\\frac{5}{2}+\\left(-\\frac{1}{2}\\right)=-3.\\end{aligned}\n$$\n\nLet's add the second value to the table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $Δ{y}_{p}$ | ${y}_{p}$ | ${y}_{p}^{′}$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $-1$ | $-2$ | $-$ | $-$ | $-$ | $-\\frac{3}{2}$ |\n| $1$ | $-\\frac{5}{2}$ | $-1$ | $-\\frac{1}{2}$ | $-3$ |  |  |\n\nHence, the slope at this predicted point is\n\n$$\n\\begin{aligned}{y}_{p}^{′} & =-({x}_{\\text{new}}+1)({y}_{p}+3) \\\\  & =-(2+1)(-3+3) \\\\  & =0.\\end{aligned}\n$$\n\nWe can add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $Δ{y}_{p}$ | ${y}_{p}$ | ${y}_{p}^{′}$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $-1$ | $-2$ | $-$ | $-$ | $-$ | $-\\frac{3}{2}$ |\n| $1$ | $-\\frac{5}{2}$ | $-1$ | $-\\frac{1}{2}$ | $-3$ | $0$ |  |\n\nFinally, we compute $Δy$ using the corrector equation:\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{12}(5{y}_{p}^{′}+8{y}^{′}-{y}_{-1}^{′})\\cdot Δx \\\\  & =\\frac{1}{12}(5\\cdot 0+8\\cdot (-1)-(-2))\\cdot 1 \\\\  & =\\frac{1}{12}\\cdot (-6) \\\\  & =-\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the completed row is as given below.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $Δ{y}_{p}$ | ${y}_{p}$ | ${y}_{p}^{′}$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $-1$ | $-2$ | $-$ | $-$ | $-$ | $-\\frac{3}{2}$ |\n| $1$ | $-\\frac{5}{2}$ | $-1$ | $-\\frac{1}{2}$ | $-3$ | $0$ | $-\\frac{1}{2}$ |\n\nThe value of $x$ in the next row is ${x}_{\\text{new}}=2.$ To get the value of $y$ in the next row, we add $Δy$ to $y:$\n\n$$\n{y}_{\\text{new}}=y+Δy=-\\frac{5}{2}+\\left(-\\frac{1}{2}\\right)=-3\n$$\n\nAdding these results to our table gives the following:\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $Δ{y}_{p}$ | ${y}_{p}$ | ${y}_{p}^{′}$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $-1$ | $-2$ | $-$ | $-$ | $-$ | $-\\frac{3}{2}$ |\n| $1$ | $-\\frac{5}{2}$ | $-1$ | $-\\frac{1}{2}$ | $-3$ | $0$ | $-\\frac{1}{2}$ |\n| $2$ | $-3$ |  |  |  |  |  |\n\nTherefore, we conclude that $y(2)≈-3.$"} {:db/id #edb/ref 17592186374820 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "835ed941-71af-508b-b962-5bfd810b7918" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18{e}^{-t/20}" :db/id #edb/ref 17592186374822} {:answer/id #uuid "0468a81b-2239-5f53-84a9-7481ee0cfb4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18e^{-t/20}" :db/id #edb/ref 17592186501475}] :answer-field/correct {:answer/id #uuid "0468a81b-2239-5f53-84a9-7481ee0cfb4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18e^{-t/20}" :db/id #edb/ref 17592186501475} :answer-field/id #uuid "17c7259c-bd73-5489-8857-2aa304112761" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186374821}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bc17f053-4154-5b58-a673-a3b7c9595b38" :question/math-academy-id "q-336630" :question/problem "A tank initially holds $260\\,\\text{L}$ of a dye solution containing $18\\,\\text{kg}$ of dye.\nPure water is poured into the tank at a rate of $13\\,\\text{L/min},$ while the completely mixed solution leaves the tank at a rate of $13\\,\\text{L/min}.$\nFind an equation for the amount of dye $Q(t),$ in kilograms, in the tank $t$ minutes after the pure water is first added.\n\n$Q(t)=$\n{{field-1}}" :question/worked-solution "Since $Q$ is the amount of dye in the tank at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which dye enters the tank minus the rate at which dye leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{kg}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which dye enters the tank.\n\nFirst, note that pure water (i.e., a solution containing $0\\,\\text{kg/L}$ of dye) enters the tank at a rate of $13\\,\\text{L/min}.$ So, the rate at which the *dye* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0\\,\\frac{\\text{kg}}{\\text{L}})\\cdot (13\\,\\frac{\\text{L}}{\\text{min}}) \\\\  & =(0\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}})\\cdot (13\\,\\frac{\\cancel{\\text{L}}}{\\text{min}}) \\\\  & =0\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which dye exits the tank.\n\nNote that the rate of flow in equals the rate of flow out, so the volume of solution in the tank remains $260\\,\\text{L}.$\nThen, since $Q$ is the amount of dye in the tank, the *concentration* of the solution at time $t$ is\n\n$$\n\\frac{Q}{260}\\,\\frac{\\text{kg}}{\\text{L}}.\n$$\n\nTherefore, as the completely mixed solution leaves at a rate of $13\\,\\text{L/min},$ *dye* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(13\\,\\frac{\\text{L}}{\\text{min}})\\cdot (\\frac{Q}{260}\\,\\frac{\\text{kg}}{\\text{L}}) \\\\  & =(13\\,\\frac{\\cancel{\\text{L}}}{\\text{min}})\\cdot (\\frac{Q}{260}\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}}) \\\\  & =\\frac{13Q}{260}\\,\\frac{\\text{kg}}{\\text{min}} \\\\  & =\\frac{Q}{20}\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\ \\frac{dQ}{dt} & =0-\\frac{Q}{20} \\\\ \\frac{dQ}{dt} & =-\\frac{1}{20}\\,Q.\\end{aligned}\n$$\n\n**Step 4**: Integrate the equation.\n\nSeparating variables and integrating both sides with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{Q}\\cdot \\frac{dQ}{dt} & =-\\frac{1}{20} \\\\ \\int \\frac{1}{Q}\\cdot \\frac{dQ}{dt}dt & =\\int \\left(-\\frac{1}{20}\\right)\\,dt \\\\ \\int \\frac{1}{Q}\\cdot \\,dQ & =-\\frac{1}{20}\\int \\,dt \\\\ \\operatorname{ln}⁡|Q| & =-\\frac{t}{20}+C \\\\ |Q| & ={e}^{-t/20+C} \\\\ Q(t) & =A{e}^{-t/20},\\end{aligned}\n$$\n\nwhere $A=\\pm {e}^{C}$ is a constant of integration.\n\nWe're told that the tank initially contains $18\\,\\text{kg}$ of dye. So, we can apply the initial condition $Q(0)=18,$ and solve for $A:$\n\n$$\n\\begin{aligned}Q(0) & =18 \\\\ A{e}^{-0/20} & =18 \\\\ A & =18\\end{aligned}\n$$\n\nFinally, we obtain the following expression for $Q(t):$\n\n$$\nQ(t)=18{e}^{-t/20}\n$$"} {:db/id #edb/ref 17592186374823 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bf9c62e-c4f9-5e3c-8ed7-61d9f3e8d86a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9{e}^{-t/25}" :db/id #edb/ref 17592186374825}] :answer-field/correct {:answer/id #uuid "7bf9c62e-c4f9-5e3c-8ed7-61d9f3e8d86a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9{e}^{-t/25}" :db/id #edb/ref 17592186374825} :answer-field/id #uuid "28133954-7d6d-50c3-9942-b8e9c9a1182b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186374824}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4d568f5f-6232-5ee8-a10c-db439f4a3317" :question/math-academy-id "q-336631" :question/problem "A tank initially holds $375\\,\\text{L}$ of a dissolved contaminant solution containing $9\\,\\text{kg}$ of dissolved contaminant.\nPure water is poured into the tank at a rate of $15\\,\\text{L/min},$ while the completely mixed solution leaves the tank at a rate of $15\\,\\text{L/min}.$\nFind an equation for the amount of dissolved contaminant $Q(t),$ in kilograms, in the tank $t$ minutes after the pure water is first added.\n\n$Q(t)=$\n{{field-1}}" :question/worked-solution "Since $Q$ is the amount of dissolved contaminant in the tank at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which dissolved contaminant enters the tank minus the rate at which dissolved contaminant leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{kg}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which dissolved contaminant enters the tank.\n\nFirst, note that pure water (i.e., a solution containing $0\\,\\text{kg/L}$ of dissolved contaminant) enters the tank at a rate of $15\\,\\text{L/min}.$ So, the rate at which the *dissolved contaminant* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0\\,\\frac{\\text{kg}}{\\text{L}})\\cdot (15\\,\\frac{\\text{L}}{\\text{min}}) \\\\  & =(0\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}})\\cdot (15\\,\\frac{\\cancel{\\text{L}}}{\\text{min}}) \\\\  & =0\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which dissolved contaminant exits the tank.\n\nNote that the rate of flow in equals the rate of flow out, so the volume of solution in the tank remains $375\\,\\text{L}.$\nThen, since $Q$ is the amount of dissolved contaminant in the tank, the *concentration* of the solution at time $t$ is\n\n$$\n\\frac{Q}{375}\\,\\frac{\\text{kg}}{\\text{L}}.\n$$\n\nTherefore, as the completely mixed solution leaves at a rate of $15\\,\\text{L/min},$ *dissolved contaminant* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(15\\,\\frac{\\text{L}}{\\text{min}})\\cdot (\\frac{Q}{375}\\,\\frac{\\text{kg}}{\\text{L}}) \\\\  & =(15\\,\\frac{\\cancel{\\text{L}}}{\\text{min}})\\cdot (\\frac{Q}{375}\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}}) \\\\  & =\\frac{15Q}{375}\\,\\frac{\\text{kg}}{\\text{min}} \\\\  & =\\frac{Q}{25}\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\ \\frac{dQ}{dt} & =0-\\frac{Q}{25} \\\\ \\frac{dQ}{dt} & =-\\frac{1}{25}\\,Q.\\end{aligned}\n$$\n\n**Step 4**: Integrate the equation.\n\nSeparating variables and integrating both sides with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{Q}\\cdot \\frac{dQ}{dt} & =-\\frac{1}{25} \\\\ \\int \\frac{1}{Q}\\cdot \\frac{dQ}{dt}dt & =\\int \\left(-\\frac{1}{25}\\right)\\,dt \\\\ \\int \\frac{1}{Q}\\cdot \\,dQ & =-\\frac{1}{25}\\int \\,dt \\\\ \\operatorname{ln}⁡|Q| & =-\\frac{t}{25}+C \\\\ |Q| & ={e}^{-t/25+C} \\\\ Q(t) & =A{e}^{-t/25},\\end{aligned}\n$$\n\nwhere $A=\\pm {e}^{C}$ is a constant of integration.\n\nWe're told that the tank initially contains $9\\,\\text{kg}$ of dissolved contaminant. So, we can apply the initial condition $Q(0)=9,$ and solve for $A:$\n\n$$\n\\begin{aligned}Q(0) & =9 \\\\ A{e}^{-0/25} & =9 \\\\ A & =9\\end{aligned}\n$$\n\nFinally, we obtain the following expression for $Q(t):$\n\n$$\nQ(t)=9{e}^{-t/25}\n$$"} {:db/id #edb/ref 17592186374826 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "587ad7eb-e7ff-5449-a3e7-315421a5c0c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=20{\\left(\\frac{100}{100+t}\\right)}^{2}" :db/id #edb/ref 17592186374828} {:answer/id #uuid "95d74708-bfdc-53f7-9971-439077d9c125" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=2500{\\left(\\frac{10}{100+t}\\right)}^{2}" :db/id #edb/ref 17592186374829} {:answer/id #uuid "c1ca561d-2102-5596-b774-af92e2184dde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=25\\frac{100}{(100+t)^{2}}" :db/id #edb/ref 17592186374830} {:answer/id #uuid "28f84566-0022-5a52-aa79-a865a20593a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=25{\\left(\\frac{100}{100+t}\\right)}^{2}" :db/id #edb/ref 17592186374831} {:answer/id #uuid "64fc0482-ab86-5439-a2a9-8a2e97fe0fb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=20{\\left(\\frac{10}{100+t}\\right)}^{2}" :db/id #edb/ref 17592186374832}] :answer-field/correct {:answer/id #uuid "28f84566-0022-5a52-aa79-a865a20593a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=25{\\left(\\frac{100}{100+t}\\right)}^{2}" :db/id #edb/ref 17592186374831} :answer-field/id #uuid "e5507560-e644-5b06-9ffc-b163d1f6589b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374827}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e3c2a5b4-3b5e-50f6-abee-7b39dd34294c" :question/math-academy-id "q-336632" :question/problem "A tank initially holds $600\\,\\text{L}$ of a brine (salt-water) solution containing $25\\,\\text{kg}$ of salt.\nFresh water is poured into the tank at a rate of $18\\,\\text{L/min},$ while the completely mixed brine leaves the tank at a rate of $12\\,\\text{L/min}.$\nFind an equation for the amount of salt $Q(t),$ in kilograms, in the tank $t$ minutes after the fresh water is first added." :question/worked-solution "Since $Q$ is the amount of salt in the tank at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which salt enters the tank minus the rate at which salt leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{kg}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which salt enters the tank.\n\nFirst, note that fresh water (i.e., a brine solution containing $0\\,\\text{kg/L}$ of salt) enters the tank at a rate of $18\\,\\text{L/min}.$ So, the rate at which the *salt* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0\\,\\frac{\\text{kg}}{\\text{L}})\\cdot (18\\,\\frac{\\text{L}}{\\text{min}}) \\\\  & =(0\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}})\\cdot (18\\,\\frac{\\cancel{\\text{L}}}{\\text{min}}) \\\\  & =0\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which salt exits the tank.\n\nNow, to find the rate at which salt leaves the tank, we must first determine the volume of brine in the tank at time $t.$\n\n- The tank initially contains $600\\,\\text{L}$ of brine.\n\n- Fresh water enters the tank at a rate of $18\\,\\text{L/min}.$ So, after $t$ minutes, $18t\\,\\text{L}$ have entered the tank.\n\n- The completely mixed brine leaves the tank at a rate of $12\\,\\text{L/min}.$ So, after $t$ minutes, $12t\\,\\text{L}$ have left the tank.\n\nAs a result, the volume of brine in the tank after $t$ minutes is \n\n$$\n600+18t-12t=(600+6t)\\,\\text{L}.\n$$\n\nThen, since $Q$ is the amount of salt in the tank, the *concentration* of the brine at time $t$ is\n\n$$\n\\frac{Q}{600+6t}\\,\\frac{\\text{kg}}{\\text{L}}.\n$$\n\nTherefore, as the completely mixed brine leaves at a rate of $12\\,\\text{L/min},$ *salt* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(12\\,\\frac{\\text{L}}{\\text{min}})\\cdot (\\frac{Q}{600+6t}\\,\\frac{\\text{kg}}{\\text{L}}) \\\\  & =(12\\,\\frac{\\cancel{\\text{L}}}{\\text{min}})\\cdot (\\frac{Q}{600+6t}\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}}) \\\\  & =\\frac{12Q}{600+6t}\\,\\frac{\\text{kg}}{\\text{min}} \\\\  & =\\frac{2Q}{100+t}\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\ \\frac{dQ}{dt} & =0-\\frac{2Q}{100+t} \\\\ \\frac{dQ}{dt} & =-\\frac{2}{100+t}\\,Q.\\end{aligned}\n$$\n\n**Step 4**: Integrate the equation.\n\nSeparating variables and integrating both sides with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{Q}\\cdot \\frac{dQ}{dt} & =-\\frac{2}{100+t} \\\\ \\int \\frac{1}{Q}\\cdot \\frac{dQ}{dt}dt & =\\int \\left(-\\frac{2}{100+t}\\right)\\,dt \\\\ \\int \\frac{1}{Q}\\cdot \\,dQ & =-2\\int \\frac{1}{100+t}\\,dt \\\\ \\operatorname{ln}⁡|Q| & =-2\\operatorname{ln}⁡|100+t|+C \\\\ |Q| & ={e}^{-2\\operatorname{ln}⁡|100+t|+C} \\\\ Q(t) & =\\frac{A}{(100+t)^{2}},\\end{aligned}\n$$\n\nwhere $A=\\pm {e}^{C}$ is a constant of integration.\n\nWe're told that the tank initially contains $25\\,\\text{kg}$ of salt. So, we can apply the initial condition $Q(0)=25,$ and solve for $A:$\n\n$$\n\\begin{aligned}Q(0) & =25 \\\\ \\frac{A}{(100+0)^{2}} & =25 \\\\ A & =25\\cdot {100}^{2}\\end{aligned}\n$$\n\nFinally, we obtain the following expression for $Q(t):$\n\n$$\nQ(t)=25{\\left(\\frac{100}{100+t}\\right)}^{2}\n$$"} {:db/id #edb/ref 17592186374840 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22446d9b-f3b3-51d7-8eab-f813f126f966" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.43\\,\\text{lb}" :db/id #edb/ref 17592186374842} {:answer/id #uuid "fc791120-4af1-5df5-8a8b-8cf249933b52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7.54\\,\\text{lb}" :db/id #edb/ref 17592186374843} {:answer/id #uuid "2a979bc1-8055-5284-be10-31b92bc2fb71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.22\\,\\text{lb}" :db/id #edb/ref 17592186374844} {:answer/id #uuid "b2ab7b77-90c7-560a-a520-39ae98136e1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.08\\,\\text{lb}" :db/id #edb/ref 17592186374845} {:answer/id #uuid "5fb6f7cb-44c0-5462-90c0-5e816014480d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.70\\,\\text{lb}" :db/id #edb/ref 17592186374846}] :answer-field/correct {:answer/id #uuid "22446d9b-f3b3-51d7-8eab-f813f126f966" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.43\\,\\text{lb}" :db/id #edb/ref 17592186374842} :answer-field/id #uuid "cf9b1d72-7dcf-5756-8025-f1f5167127d2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374841}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a7733334-ec35-5062-9a3d-109d06df1cd7" :question/math-academy-id "q-336674" :question/problem "A wastewater holding basin initially holds $480\\,\\text{gal}$ of water containing $12\\,\\text{lb}$ of dissolved contaminants.\nClean water is pumped into the basin at a rate of $24\\,\\text{gal/min},$ while the completely mixed liquid leaves the basin at a rate of $18\\,\\text{gal/min}.$\nFind, rounded to two decimal places, the amount of contaminants in the basin $10$ minutes after the clean water pumping begins." :question/worked-solution "Let $Q$ be the amount of contaminants in the basin at time $t.$ Then, the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which contaminants enter the basin minus the rate at which contaminants leave the basin.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{lb}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which contaminants enter the basin.\n\nNote that clean water (i.e., water containing $0\\,\\text{lb/gal}$ of contaminants) enters the basin at a rate of $24\\,\\text{gal/min}.$ So, the rate at which the *contaminants* enter the basin is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0\\,\\frac{\\text{lb}}{\\text{gal}})\\cdot (24\\,\\frac{\\text{gal}}{\\text{min}}) \\\\  & =(0\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}})\\cdot (24\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}}) \\\\  & =0\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which contaminants exit the basin.\n\nTo find the rate at which contaminants leave the basin, we first determine the volume of wastewater in the basin at time $t.$\n\nThe basin initially contains $480\\,\\text{gal}$ of wastewater; water enters at $24\\,\\text{gal/min}$ and drains out at $18\\,\\text{gal/min}.$\nAs a result, the amount of wastewater in the basin after $t$ minutes is \n\n$$\n480+24t-18t=(480+6t)\\,\\text{gal}.\n$$\n\nSince $Q$ is the amount of contaminants in the basin, the *concentration* of the wastewater at time $t$ is\n\n$$\n\\frac{Q}{480+6t}\\,\\frac{\\text{lb}}{\\text{gal}}.\n$$\n\nTherefore, as the completely mixed liquid leaves at a rate of $18\\,\\text{gal/min},$ *contaminants* leave at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(18\\,\\frac{\\text{gal}}{\\text{min}})\\cdot (\\frac{Q}{480+6t}\\,\\frac{\\text{lb}}{\\text{gal}}) \\\\  & =(18\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}})\\cdot (\\frac{Q}{480+6t}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}}) \\\\  & =\\frac{18Q}{480+6t}\\,\\frac{\\text{lb}}{\\text{min}} \\\\  & =\\frac{3Q}{80+t}\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =0-\\frac{3Q}{80+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}=-\\frac{3}{80+t}\\,Q.\n$$\n\n**Step 4**: Integrate the equation.\n\nSeparating variables and integrating both sides with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{Q}\\cdot \\frac{dQ}{dt} & =-\\frac{3}{80+t} \\\\ \\int \\frac{1}{Q}\\cdot \\frac{dQ}{dt}dt & =\\int \\left(-\\frac{3}{80+t}\\right)\\,dt \\\\ \\int \\frac{1}{Q}\\cdot \\,dQ & =-3\\int \\frac{1}{80+t}\\,dt \\\\ \\operatorname{ln}⁡|Q| & =-3\\operatorname{ln}⁡|80+t|+C \\\\ |Q| & ={e}^{-3\\operatorname{ln}⁡|80+t|+C} \\\\ Q(t) & =\\frac{A}{(80+t)^{3}},\\end{aligned}\n$$\n\nwhere $A=\\pm {e}^{C}$ is a constant of integration.\n\nWe're told that the basin initially contains $12\\,\\text{lb}$ of contaminants. So, we can apply the initial condition $Q(0)=12,$ and solve for $A:$\n\n$$\n\\begin{aligned}Q(0) & =12 \\\\ \\frac{A}{(80+0)^{3}} & =12 \\\\ A & =12\\cdot {80}^{3}\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\nQ(t)=12{\\left(\\frac{80}{80+t}\\right)}^{3}\n$$\n\nFinally, the amount of contaminants in the basin $10$ minutes after the clean water is first pumped in is\n\n$$\nQ(12)=12{\\left(\\frac{80}{90}\\right)}^{3}≈8.43\\,\\text{lb},\n$$\n\nrounded to two decimal places."} {:db/id #edb/ref 17592186374847 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "330391ea-80fb-555c-8100-9cf56bac72be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32\\,\\text{lb}" :db/id #edb/ref 17592186374849} {:answer/id #uuid "5345a1b0-bd58-534b-b7e1-91989f0e42ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,\\text{lb}" :db/id #edb/ref 17592186374850} {:answer/id #uuid "ec22cd8b-9dd7-517c-8622-92daa295ef50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15\\,\\text{lb}" :db/id #edb/ref 17592186374851} {:answer/id #uuid "b3caacbd-86cd-5fc7-86f1-4bebadf1735e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12.5\\,\\text{lb}" :db/id #edb/ref 17592186374852} {:answer/id #uuid "47645fa8-cc54-5919-9b81-fbaad91413e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16.5\\,\\text{lb}" :db/id #edb/ref 17592186374853}] :answer-field/correct {:answer/id #uuid "b3caacbd-86cd-5fc7-86f1-4bebadf1735e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12.5\\,\\text{lb}" :db/id #edb/ref 17592186374852} :answer-field/id #uuid "94ee6f2e-5f4c-5a4b-80d2-dd6fa77ca97a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374848}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dcfe7bdc-5ce2-5316-9de6-7dc380d1901a" :question/math-academy-id "q-336726" :question/problem "A $240\\,\\text{gal}$-capacity tank initially holds $150\\,\\text{gal}$ of a brine (salt-water) solution containing $32\\,\\text{lb}$ of salt. Fresh water begins to flow into the tank at a rate of $3\\,\\text{gal/min},$ while the completely mixed brine flows out at a rate of $2\\,\\text{gal/min}.$ Find the amount of salt in the tank at the moment it begins to overflow." :question/worked-solution "Let $Q$ be the amount of salt in the tank at time $t.$ Then, the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which salt enters the tank minus the rate at which salt leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{lb}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which salt enters the tank.\n\nFirst, note that fresh water (i.e., a brine solution containing $0\\,\\text{lb/gal}$ of salt) enters the tank at a rate of $3\\,\\text{gal/min}.$ So, the rate at which the *salt* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0\\,\\frac{\\text{lb}}{\\text{gal}})\\cdot (3\\,\\frac{\\text{gal}}{\\text{min}}) \\\\  & =(0\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}})\\cdot (3\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}}) \\\\  & =0\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which salt exits the tank.\n\nTo find the rate at which salt leaves the tank, we must first determine the volume of brine in the tank at time $t.$\n\nThe tank initially contains $150\\,\\text{gal}$ of brine; fresh water enters at $3\\,\\text{gal/min},$ and mixed brine leaves at $2\\,\\text{gal/min}.$\nAs a result, the amount of brine in the tank after $t$ minutes is \n\n$$\nV(t)=150+3t-2t=(150+t)\\,\\text{gal}.\n$$\n\nNote that $V(t)$ is an increasing function, so the tank is filling.\n\nSince $Q$ is the amount of salt in the tank, the concentration of the brine at time $t$ is\n\n$$\n\\frac{Q}{150+t}\\,\\frac{\\text{lb}}{\\text{gal}}.\n$$\n\nTherefore, as the completely mixed brine leaves at a rate of $2\\,\\text{gal/min},$ *salt* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(2\\,\\frac{\\text{gal}}{\\text{min}})\\cdot (\\frac{Q}{150+t}\\,\\frac{\\text{lb}}{\\text{gal}}) \\\\  & =(2\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}})\\cdot (\\frac{Q}{150+t}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}}) \\\\  & =\\frac{2Q}{150+t}\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =0-\\frac{2Q}{150+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}=-\\frac{2}{150+t}\\,Q.\n$$\n\n**Step 4**: Integrate the equation\n\nSeparating variables and integrating both sides with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{Q}\\cdot \\frac{dQ}{dt} & =-\\frac{2}{150+t} \\\\ \\int \\frac{1}{Q}\\cdot \\frac{dQ}{dt}dt & =\\int \\left(-\\frac{2}{150+t}\\right)\\,dt \\\\ \\int \\frac{1}{Q}\\cdot \\,dQ & =-2\\int \\frac{1}{150+t}\\,dt \\\\ \\operatorname{ln}⁡|Q| & =-2(\\operatorname{ln}⁡|150+t|)+C \\\\ \\operatorname{ln}⁡|Q| & =\\operatorname{ln}⁡|(150+t)^{-2}|+C \\\\ |Q| & ={e}^{\\operatorname{ln}⁡|(150+t)^{-2}|+C} \\\\ Q(t) & =\\frac{A}{(150+t)^{2}},\\end{aligned}\n$$\n\nwhere $A=\\pm {e}^{C}$ is a constant of integration.\n\nWe're told that the tank initially contains $32\\,\\text{lb}$ of salt. So, we can apply the initial condition $Q(0)=32,$ and solve for $A:$\n\n$$\n\\begin{aligned}Q(0) & =32 \\\\ \\frac{A}{(150+0)^{2}} & =32 \\\\ A & =32(150)^{2}\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =\\frac{32(150)^{2}}{(150+t)^{2}} \\\\  & =32{\\left(\\frac{150}{150+t}\\right)}^{2}\\end{aligned}\n$$\n\nNow, let ${t}_{o}$ be the time when the tank begins to overflow. The tank has a capacity of $240\\,\\text{gal},$ so we can use the condition $V({t}_{o})=240$ to solve for ${t}_{o}:$\n\n$$\n\\begin{aligned}V({t}_{o}) & =240 \\\\ 150+{t}_{o} & =240 \\\\ {t}_{o} & =90\\,\\text{min}\\end{aligned}\n$$\n\nFinally, the amount of salt in the tank at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(90) & =32{\\left(\\frac{150}{150+90}\\right)}^{2} \\\\  & =32{\\left(\\frac{150}{240}\\right)}^{2} \\\\  & =32{\\left(\\frac{5}{8}\\right)}^{2} \\\\  & =12.5\\,\\text{lb}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186374854 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03d90ed3-593b-56eb-b15c-74fb96a264c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48\\,\\text{g}" :db/id #edb/ref 17592186374856} {:answer/id #uuid "23a41576-4255-58aa-aff3-24970b0750f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50\\,\\text{g}" :db/id #edb/ref 17592186374857} {:answer/id #uuid "162b2841-c921-5383-b411-667946024eb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "55\\,\\text{g}" :db/id #edb/ref 17592186374858} {:answer/id #uuid "a400a2ae-64d3-5df6-8b72-04dc312a8573" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60\\,\\text{g}" :db/id #edb/ref 17592186374859} {:answer/id #uuid "2c007732-c2d9-5745-a9ef-073e3655a986" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "52\\,\\text{g}" :db/id #edb/ref 17592186374860}] :answer-field/correct {:answer/id #uuid "23a41576-4255-58aa-aff3-24970b0750f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50\\,\\text{g}" :db/id #edb/ref 17592186374857} :answer-field/id #uuid "86cb9083-a221-51ed-ad2c-ae6d13e72d9a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374855}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "45ce4d33-a7f8-5fd0-bbf2-c53f0966bb82" :question/math-academy-id "q-336727" :question/problem "A $10\\,500\\,\\text{mL}$-capacity reactor initially holds $7\\,500\\,\\text{mL}$ of a chemical solution containing $98\\,\\text{g}$ of reactant. Pure solvent begins to flow into the reactor at a rate of $90\\,\\text{mL/s},$ while the completely mixed solution flows out at a rate of $60\\,\\text{mL/s}.$ Find the amount of reactant in the reactor at the moment it begins to overflow." :question/worked-solution "Let $Q$ be the amount of reactant in the reactor at time $t.$ Then, the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in seconds. This is equal to the rate at which reactant enters the reactor minus the rate at which reactant leaves the reactor.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{g}/\\text{s}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which reactant enters the reactor.\n\nFirst, note that pure solvent (i.e., a solution containing $0\\,\\text{g/mL}$ of reactant) enters the reactor at a rate of $90\\,\\text{mL/s}.$ So, the rate at which the *reactant* enters the reactor is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0\\,\\frac{\\text{g}}{\\text{mL}})\\cdot (90\\,\\frac{\\text{mL}}{\\text{s}}) \\\\  & =(0\\,\\frac{\\text{g}}{\\cancel{\\text{mL}}})\\cdot (90\\,\\frac{\\cancel{\\text{mL}}}{\\text{s}}) \\\\  & =0\\,\\frac{\\text{g}}{\\text{s}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which reactant exits the reactor.\n\nTo find the rate at which reactant leaves the reactor, we must first determine the volume of solution in the reactor at time $t.$\n\nThe reactor initially contains $7\\,500\\,\\text{mL}$ of solution; pure solvent enters at $90\\,\\text{mL/s},$ and mixed solution leaves at $60\\,\\text{mL/s}.$\nAs a result, the amount of solution in the reactor after $t$ seconds is \n\n$$\nV(t)=7\\,500+90t-60t=30(250+t)\\,\\text{mL}.\n$$\n\nNote that $V(t)$ is an increasing function, so the reactor is filling.\n\nSince $Q$ is the amount of reactant in the reactor, the concentration of the solution at time $t$ is\n\n$$\n\\frac{Q}{30(250+t)}\\,\\frac{\\text{g}}{\\text{mL}}.\n$$\n\nTherefore, as the completely mixed solution leaves at a rate of $60\\,\\text{mL/s},$ *reactant* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(60\\,\\frac{\\text{mL}}{\\text{s}})\\cdot (\\frac{Q}{30(250+t)}\\,\\frac{\\text{g}}{\\text{mL}}) \\\\  & =(60\\,\\frac{\\cancel{\\text{mL}}}{\\text{s}})\\cdot (\\frac{Q}{30(250+t)}\\,\\frac{\\text{g}}{\\cancel{\\text{mL}}}) \\\\  & =\\frac{2Q}{250+t}\\,\\frac{\\text{g}}{\\text{s}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =0-\\frac{2Q}{250+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}=-\\frac{2}{250+t}\\,Q.\n$$\n\n**Step 4**: Integrate the equation\n\nSeparating variables and integrating both sides with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{Q}\\cdot \\frac{dQ}{dt} & =-\\frac{2}{250+t} \\\\ \\int \\frac{1}{Q}\\cdot \\frac{dQ}{dt}dt & =\\int \\left(-\\frac{2}{250+t}\\right)\\,dt \\\\ \\int \\frac{1}{Q}\\cdot \\,dQ & =-2\\int \\frac{1}{250+t}\\,dt \\\\ \\operatorname{ln}⁡|Q| & =-2(\\operatorname{ln}⁡|250+t|)+C \\\\ \\operatorname{ln}⁡|Q| & =\\operatorname{ln}⁡|(250+t)^{-2}|+C \\\\ |Q| & ={e}^{\\operatorname{ln}⁡|(250+t)^{-2}|+C} \\\\ Q(t) & =\\frac{A}{(250+t)^{2}},\\end{aligned}\n$$\n\nwhere $A=\\pm {e}^{C}$ is a constant of integration.\n\nWe're told that the reactor initially contains $98\\,\\text{g}$ of reactant. So, we can apply the initial condition $Q(0)=98,$ and solve for $A:$\n\n$$\n\\begin{aligned}Q(0) & =98 \\\\ \\frac{A}{(250+0)^{2}} & =98 \\\\ A & =98(250)^{2}\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =\\frac{98(250)^{2}}{(250+t)^{2}} \\\\  & =98{\\left(\\frac{250}{250+t}\\right)}^{2}\\end{aligned}\n$$\n\nNow, let ${t}_{o}$ be the time when the reactor begins to overflow. The reactor has a capacity of $10\\,500\\,\\text{mL},$ so we can use the condition $V({t}_{o})=10\\,500$ to solve for ${t}_{o}:$\n\n$$\n\\begin{aligned}V({t}_{o}) & =10\\,500 \\\\ 30(250+{t}_{o}) & =10\\,500 \\\\ 250+{t}_{o} & =350 \\\\ {t}_{o} & =100\\,\\text{s}\\end{aligned}\n$$\n\nFinally, the amount of reactant in the reactor at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(100) & =98{\\left(\\frac{250}{250+100}\\right)}^{2} \\\\  & =98{\\left(\\frac{250}{350}\\right)}^{2} \\\\  & =98{\\left(\\frac{5}{7}\\right)}^{2} \\\\  & =50\\,\\text{g}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186374861 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7cb4e1cb-a4d9-5a79-8bad-83176cb4a640" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11.60\\,\\text{lb}" :db/id #edb/ref 17592186374863} {:answer/id #uuid "97b47761-bf18-5c2c-807b-5fbd6eecd397" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11.85\\,\\text{lb}" :db/id #edb/ref 17592186374864} {:answer/id #uuid "f9316b8e-3e20-5a4c-8d57-cf7e0b5d688e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12.46\\,\\text{lb}" :db/id #edb/ref 17592186374865} {:answer/id #uuid "8dde20d6-6676-5b10-94da-9eee8eb3183f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12.19\\,\\text{lb}" :db/id #edb/ref 17592186374866} {:answer/id #uuid "07f0a2a1-f819-5785-94c7-449359e5a659" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12.02\\,\\text{lb}" :db/id #edb/ref 17592186374867}] :answer-field/correct {:answer/id #uuid "07f0a2a1-f819-5785-94c7-449359e5a659" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12.02\\,\\text{lb}" :db/id #edb/ref 17592186374867} :answer-field/id #uuid "617c7a09-689e-563c-b4f9-daf6d3871ab7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374862}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a99a5d4e-3d03-5070-bc7f-206f5695b61b" :question/math-academy-id "q-336822" :question/problem "A $310\\,\\text{gal}$-capacity reactor initially holds $190\\,\\text{gal}$ of a chemical solution containing $32\\,\\text{lb}$ of reactant. Pure solvent begins to flow into the reactor at a rate of $6\\,\\text{gal/min},$ while the completely mixed solution flows out at a rate of $4\\,\\text{gal/min}.$ Find, rounded to two decimal places, the amount of reactant in the reactor at the moment it begins to overflow." :question/worked-solution "Let $Q$ be the amount of reactant in the reactor at time $t.$ Then, the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which reactant enters the reactor minus the rate at which reactant leaves the reactor.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{lb}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which reactant enters the reactor.\n\nFirst, note that pure solvent (i.e., a solution containing $0\\,\\text{lb/gal}$ of reactant) enters the reactor at a rate of $6\\,\\text{gal/min}.$ So, the rate at which the *reactant* enters the reactor is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0\\,\\frac{\\text{lb}}{\\text{gal}})\\cdot (6\\,\\frac{\\text{gal}}{\\text{min}}) \\\\  & =(0\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}})\\cdot (6\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}}) \\\\  & =0\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which reactant exits the reactor.\n\nTo find the rate at which reactant leaves the reactor, we must first determine the volume of solution in the reactor at time $t.$\n\nThe reactor initially contains $190\\,\\text{gal}$ of solution; pure solvent enters at $6\\,\\text{gal/min},$ and mixed solution leaves at $4\\,\\text{gal/min}.$\nAs a result, the amount of solution in the reactor after $t$ minutes is \n\n$$\nV(t)=190+6t-4t=2(95+t)\\,\\text{gal}.\n$$\n\nNote that $V(t)$ is an increasing function, so the reactor is filling.\n\nSince $Q$ is the amount of reactant in the reactor, the concentration of the solution at time $t$ is\n\n$$\n\\frac{Q}{2(95+t)}\\,\\frac{\\text{lb}}{\\text{gal}}.\n$$\n\nTherefore, as the completely mixed solution leaves at a rate of $4\\,\\text{gal/min},$ *reactant* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(4\\,\\frac{\\text{gal}}{\\text{min}})\\cdot (\\frac{Q}{2(95+t)}\\,\\frac{\\text{lb}}{\\text{gal}}) \\\\  & =(4\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}})\\cdot (\\frac{Q}{2(95+t)}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}}) \\\\  & =\\frac{2Q}{95+t}\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =0-\\frac{2Q}{95+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}=-\\frac{2}{95+t}\\,Q.\n$$\n\n**Step 4**: Integrate the equation\n\nSeparating variables and integrating both sides with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{Q}\\cdot \\frac{dQ}{dt} & =-\\frac{4}{190+2t} \\\\ \\int \\frac{1}{Q}\\cdot \\frac{dQ}{dt}dt & =\\int \\left(-\\frac{4}{190+2t}\\right)\\,dt \\\\ \\int \\frac{1}{Q}\\cdot \\,dQ & =-2\\int \\frac{1}{95+t}\\,dt \\\\ \\operatorname{ln}⁡|Q| & =-2(\\frac{1}{2}\\operatorname{ln}⁡|95+t|)+C \\\\ \\operatorname{ln}⁡|Q| & =-2\\operatorname{ln}⁡|95+t|+C \\\\ \\operatorname{ln}⁡|Q| & =\\operatorname{ln}⁡|(95+t)^{-2}|+C \\\\ |Q| & ={e}^{\\operatorname{ln}⁡|(95+t)^{-2}|+C} \\\\ Q(t) & =\\frac{A}{(95+t)^{2}},\\end{aligned}\n$$\n\nwhere $A=\\pm {e}^{C}$ is a constant of integration.\n\nWe're told that the reactor initially contains $32\\,\\text{lb}$ of reactant. So, we can apply the initial condition $Q(0)=32,$ and solve for $A:$\n\n$$\n\\begin{aligned}Q(0) & =32 \\\\ \\frac{A}{(95+0)^{2}} & =32 \\\\ A & =32(95)^{2}\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =\\frac{32(190)^{2}}{(95+t)^{2}} \\\\  & =32{\\left(\\frac{95}{95+t}\\right)}^{2}\\end{aligned}\n$$\n\nNow, let ${t}_{o}$ be the time when the reactor begins to overflow. The reactor has a capacity of $310\\,\\text{gal},$ so we can use the condition $V({t}_{o})=310$ to solve for ${t}_{o}:$\n\n$$\n\\begin{aligned}V({t}_{o}) & =310 \\\\ 190+2{t}_{o} & =310 \\\\ 2{t}_{o} & =120 \\\\ {t}_{o} & =60\\,\\text{min}\\end{aligned}\n$$\n\nFinally, the amount of reactant in the reactor at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(60) & =32{\\left(\\frac{95}{95+60}\\right)}^{2} \\\\  & =32{\\left(\\frac{95}{155}\\right)}^{2} \\\\  & ≈12.02\\,\\text{lb},\\end{aligned}\n$$\n\nrounded to two decimal places."} {:db/id #edb/ref 17592186374868 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89eecff6-8175-550d-ad43-2b9766bd7fa6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "67.49\\,\\text{g}" :db/id #edb/ref 17592186374870} {:answer/id #uuid "0ed6a48d-1428-52d9-a522-2bee31663016" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "65.75\\,\\text{g}" :db/id #edb/ref 17592186374871} {:answer/id #uuid "17ca700c-b4a3-5002-abdc-7f9a8e703bc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "63.98\\,\\text{g}" :db/id #edb/ref 17592186374872} {:answer/id #uuid "51f09e87-40c3-5d6f-9b67-9acbd58b27a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70.10\\,\\text{g}" :db/id #edb/ref 17592186374873} {:answer/id #uuid "5118b033-cfac-501e-bbca-b3f1d3ca44b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "61.42\\,\\text{g}" :db/id #edb/ref 17592186374874}] :answer-field/correct {:answer/id #uuid "0ed6a48d-1428-52d9-a522-2bee31663016" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "65.75\\,\\text{g}" :db/id #edb/ref 17592186374871} :answer-field/id #uuid "8cfba8ca-3fd1-51fd-9b05-5695d3defec3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374869}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "98bdf48f-bd8c-581b-9efb-c84bc03b4bb3" :question/math-academy-id "q-336826" :question/problem "A $9\\,500\\,\\text{mL}$-capacity vat initially holds $6\\,500\\,\\text{mL}$ of a sugar-water solution containing $300\\,\\text{g}$ of sugar. Pure water begins to flow into the vat at a rate of $100\\,\\text{mL/s},$ while the completely mixed sugar-water flows out at a rate of $80\\,\\text{mL/s}.$ Find, rounded to two decimal places, the amount of sugar in the vat at the moment it begins to overflow." :question/worked-solution "Let $Q$ be the amount of sugar in the vat at time $t.$ Then, the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in seconds. This is equal to the rate at which sugar enters the vat minus the rate at which sugar leaves the vat.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{g}/\\text{s}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which sugar enters the vat.\n\nFirst, note that pure water (i.e., a solution containing $0\\,\\text{g/mL}$ of sugar) enters the vat at a rate of $100\\,\\text{mL/s}.$ So, the rate at which the *sugar* enters the vat is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0\\,\\frac{\\text{g}}{\\text{mL}})\\cdot (100\\,\\frac{\\text{mL}}{\\text{s}}) \\\\  & =(0\\,\\frac{\\text{g}}{\\cancel{\\text{mL}}})\\cdot (100\\,\\frac{\\cancel{\\text{mL}}}{\\text{s}}) \\\\  & =0\\,\\frac{\\text{g}}{\\text{s}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which sugar exits the vat.\n\nTo find the rate at which sugar leaves the vat, we must first determine the volume of sugar-water in the vat at time $t.$\n\nThe vat initially contains $6\\,500\\,\\text{mL}$ of solution; pure water enters at $100\\,\\text{mL/s},$ and mixed solution leaves at $80\\,\\text{mL/s}.$\nAs a result, the amount of solution in the vat after $t$ seconds is \n\n$$\nV(t)=6\\,500+100t-80t=20(325+t)\\,\\text{mL}.\n$$\n\nNote that $V(t)$ is an increasing function, so the vat is filling.\n\nSince $Q$ is the amount of sugar in the vat, the concentration of the solution at time $t$ is\n\n$$\n\\frac{Q}{20(325+t)}\\,\\frac{\\text{g}}{\\text{mL}}.\n$$\n\nTherefore, as the completely mixed solution leaves at a rate of $80\\,\\text{mL/s},$ *sugar* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(80\\,\\frac{\\text{mL}}{\\text{s}})\\cdot (\\frac{Q}{20(325+t)}\\,\\frac{\\text{g}}{\\text{mL}}) \\\\  & =(80\\,\\frac{\\cancel{\\text{mL}}}{\\text{s}})\\cdot (\\frac{Q}{20(325+t)}\\,\\frac{\\text{g}}{\\cancel{\\text{mL}}}) \\\\  & =\\frac{4Q}{325+t}\\,\\frac{\\text{g}}{\\text{s}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =0-\\frac{4Q}{325+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}=-\\frac{4}{325+t}\\,Q.\n$$\n\n**Step 4**: Integrate the equation\n\nSeparating variables and integrating both sides with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{Q}\\cdot \\frac{dQ}{dt} & =-\\frac{4}{325+t} \\\\ \\int \\frac{1}{Q}\\cdot \\frac{dQ}{dt}dt & =\\int \\left(-\\frac{4}{325+t}\\right)\\,dt \\\\ \\int \\frac{1}{Q}\\cdot \\,dQ & =-4\\int \\frac{1}{325+t}\\,dt \\\\ \\operatorname{ln}⁡|Q| & =-4(\\operatorname{ln}⁡|325+t|)+C \\\\ \\operatorname{ln}⁡|Q| & =\\operatorname{ln}⁡|(325+t)^{-4}|+C \\\\ |Q| & ={e}^{\\operatorname{ln}⁡|(325+t)^{-4}|+C} \\\\ Q(t) & =\\frac{A}{(325+t)^{4}},\\end{aligned}\n$$\n\nwhere $A=\\pm {e}^{C}$ is a constant of integration.\n\nWe're told that the vat initially contains $300\\,\\text{g}$ of sugar. So, we can apply the initial condition $Q(0)=300,$ and solve for $A:$\n\n$$\n\\begin{aligned}Q(0) & =300 \\\\ \\frac{A}{(325+0)^{4}} & =300 \\\\ A & =300(325)^{4}\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =\\frac{300(325)^{4}}{(325+t)^{4}} \\\\  & =300{\\left(\\frac{325}{325+t}\\right)}^{4}\\end{aligned}\n$$\n\nNow, let ${t}_{o}$ be the time when the vat begins to overflow. The vat has a capacity of $9\\,500\\,\\text{mL},$ so we can use the condition $V({t}_{o})=9\\,500$ to solve for ${t}_{o}:$\n\n$$\n\\begin{aligned}V({t}_{o}) & =9\\,500 \\\\ 20(325+{t}_{o}) & =9\\,500 \\\\ 325+{t}_{o} & =475 \\\\ {t}_{o} & =150\\,\\text{s}\\end{aligned}\n$$\n\nFinally, the amount of sugar in the vat at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(150) & =300{\\left(\\frac{325}{325+150}\\right)}^{4} \\\\  & =300{\\left(\\frac{13}{19}\\right)}^{4} \\\\  & ≈65.75\\,\\text{g},\\end{aligned}\n$$\n\nrounded to two decimal places."} {:db/id #edb/ref 17592186374875 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "892db606-dc68-5a2b-87e0-a28731ddb6cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=-\\frac{x}{y}" :db/id #edb/ref 17592186374877} {:answer/id #uuid "42aaa8c8-f2a6-522d-8b1c-e8426a3e5508" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=\\frac{x}{y}" :db/id #edb/ref 17592186374878} {:answer/id #uuid "43830384-21b6-5804-9e1a-56c908a1bd06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=-\\frac{y}{x}" :db/id #edb/ref 17592186374879} {:answer/id #uuid "b2035ed7-ba64-520f-9730-bc1fa05c95d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=\\frac{y}{{x}^{2}}" :db/id #edb/ref 17592186374880} {:answer/id #uuid "686b55d7-ff12-5c61-9938-3d2f3657f2b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=\\frac{y}{x}" :db/id #edb/ref 17592186374881}] :answer-field/correct {:answer/id #uuid "686b55d7-ff12-5c61-9938-3d2f3657f2b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=\\frac{y}{x}" :db/id #edb/ref 17592186374881} :answer-field/id #uuid "1453cd82-44b1-5060-9500-9243905809f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374876}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c92ecfc3-f93a-50d9-90e9-67f1f523a0e0" :question/math-academy-id "q-337309" :question/problem "Determine the differential equation satisfied by the orthogonal trajectories of the family of curves ${x}^{2}+{y}^{2}=-3C,$ where $C\\ne 0$ is a parameter." :question/worked-solution "Orthogonal trajectories are families of curves that intersect another given family of curves at right angles. In other words, the tangent lines of curves from each family are perpendicular at every intersection point.\n\nLet's determine the slope of the family of curves given by ${x}^{2}+{y}^{2}=-3C.$ First, we implicitly differentiate with respect to $x$ and solve for the derivative of $y:$\n\n$$\n\\begin{aligned}\\frac{d}{dx}\\,({x}^{2}+{y}^{2}) & =\\frac{d}{dx}\\,(-3C) \\\\ 2x+2y{y}^{′} & =0 \\\\ 2y{y}^{′} & =-2x \\\\ {y}^{′} & =-\\frac{x}{y}\\end{aligned}\n$$\n\nNote that the parameter $C$ has already been eliminated.\n\nFor a curve to intersect this family orthogonally, its slope ${y}_{⊥}^{′}$ must be the negative reciprocal of the slope ${y}^{′}$ above. Hence,\n\n$$\n{y}_{⊥}^{′}=-\\frac{1}{{y}^{′}}=-\\frac{1}{\\left(-\\frac{x}{y}\\right)}=\\frac{y}{x}.\n$$\n\nTherefore, the orthogonal trajectories must satisfy\n\n$$\n\\frac{dy}{dx}=\\frac{y}{x}.\n$$\n\n**Note**: Since $C\\ne 0,$ the given family has $x\\ne 0$ and $y\\ne 0,$ so both ${y}^{′}$ and ${y}_{⊥}^{′}$ are well-defined."} {:db/id #edb/ref 17592186374882 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b7d7c47-ebe9-526c-af96-6ccd2a09c50d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=-\\frac{x}{y}" :db/id #edb/ref 17592186374884} {:answer/id #uuid "b470dd12-2a32-584e-8258-91a256b16ef1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=\\frac{x}{y}" :db/id #edb/ref 17592186374885} {:answer/id #uuid "44ee728c-a095-50db-ada8-69908704d150" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=-\\frac{y}{x}" :db/id #edb/ref 17592186374886} {:answer/id #uuid "8370c006-2559-5d7b-9836-b25487e91c21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=\\frac{{y}^{2}}{x}" :db/id #edb/ref 17592186374887} {:answer/id #uuid "5a8493b7-db04-5790-b2e7-6e3289b58a32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=\\frac{y}{x}" :db/id #edb/ref 17592186374888}] :answer-field/correct {:answer/id #uuid "1b7d7c47-ebe9-526c-af96-6ccd2a09c50d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=-\\frac{x}{y}" :db/id #edb/ref 17592186374884} :answer-field/id #uuid "b771a122-3d76-5ebf-816a-c5858ca422d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374883}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8ee2050b-6343-5391-af1d-62fa3677d5ac" :question/math-academy-id "q-337318" :question/problem "Determine the differential equation satisfied by the orthogonal trajectories of the family of curves ${y}^{2}=3C{x}^{2},$ where $C\\ne 0$ is a parameter, in terms of $x$ and $y$ only." :question/worked-solution "Orthogonal trajectories are families of curves that intersect another given family of curves at right angles. In other words, the tangent lines of curves from each family are perpendicular at every intersection point.\n\nLet's determine the slope of the family of curves given by ${y}^{2}=3C{x}^{2}.$ First, we implicitly differentiate with respect to $x$ and solve for the derivative of $y:$\n\n$$\n\\begin{aligned}\\frac{d}{dx}({y}^{2}) & =\\frac{d}{dx}(3C{x}^{2}) \\\\ 2y{y}^{′} & =6Cx \\\\ {y}^{′} & =\\frac{3Cx}{y}\\end{aligned}\n$$\n\nNow, we must eliminate $C.$ From the original family of curves equation, we have\n\n$$\n{y}^{2}=3C{x}^{2}\\,⟹\\,C=\\frac{{y}^{2}}{3{x}^{2}}.\n$$\n\nSubstituting this into our slope equation, we get\n\n$$\n{y}^{′}=\\frac{3\\left(\\frac{{y}^{2}}{3{x}^{2}}\\right)x}{y}=\\frac{y}{x}.\n$$\n\nFor a curve to intersect this family orthogonally, its slope ${y}_{⊥}^{′}$ must be the negative reciprocal of the slope ${y}^{′}$ above. Hence,\n\n$$\n{y}_{⊥}^{′}=-\\frac{1}{{y}^{′}}=-\\frac{1}{\\left(\\frac{y}{x}\\right)}=-\\frac{x}{y}.\n$$\n\nTherefore, the orthogonal trajectories must satisfy\n\n$$\n\\frac{dy}{dx}=-\\frac{x}{y}.\n$$\n\n**Note**: For the original family, since $C\\ne 0,$ we have $y\\ne 0$ whenever $x\\ne 0,$ hence, the slopes are well-defined. Otherwise, when $x=0,$ the curve forces $y=0,$ and the tangent slope is not defined."} {:db/id #edb/ref 17592186374889 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f439cf56-cadd-5440-9e4e-4cb1193e0b79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=\\frac{x}{2y}" :db/id #edb/ref 17592186374891} {:answer/id #uuid "6cd73af6-a6e1-539d-a010-2a13d927834b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=-\\frac{2x}{y}" :db/id #edb/ref 17592186374892} {:answer/id #uuid "6e2caae4-d1d1-56e3-ba73-717a0a9a2e43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=-\\frac{y}{2x}" :db/id #edb/ref 17592186374893} {:answer/id #uuid "2e9b6079-f9fd-51b8-b5ff-31df4c6dd3f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=\\frac{2x}{y}" :db/id #edb/ref 17592186374894} {:answer/id #uuid "b2122dfe-4ca3-58cb-9f80-d44f2dc84d71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=\\frac{y}{2x}" :db/id #edb/ref 17592186374895}] :answer-field/correct {:answer/id #uuid "2e9b6079-f9fd-51b8-b5ff-31df4c6dd3f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=\\frac{2x}{y}" :db/id #edb/ref 17592186374894} :answer-field/id #uuid "14d574f0-74bd-5e05-b29e-d5cd37a5199b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374890}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6d9a7bf7-c360-5b6d-8323-d7ffd06fced2" :question/math-academy-id "q-337322" :question/problem "Determine the differential equation satisfied by the orthogonal trajectories of the family of curves ${y}^{2}=-\\frac{4{C}^{2}}{x},$ where $C\\ne 0$ is a parameter, in terms of $x$ and $y$ only." :question/worked-solution "Orthogonal trajectories are families of curves that intersect another given family of curves at right angles. In other words, the tangent lines of curves from each family are perpendicular at every intersection point.\n\nLet's determine the slope of the family of curves given by ${y}^{2}=-\\frac{4{C}^{2}}{x}.$ First, we implicitly differentiate with respect to $x$ and solve for the derivative of $y:$\n\n$$\n\\begin{aligned}\\frac{d}{dx}({y}^{2}) & =\\frac{d}{dx}\\,\\left(-\\frac{4{C}^{2}}{x}\\right) \\\\ 2y{y}^{′} & =\\frac{4{C}^{2}}{{x}^{2}} \\\\ {y}^{′} & =\\frac{2{C}^{2}}{{x}^{2}y}\\end{aligned}\n$$\n\nNow, we must eliminate $C.$ From the original family of curves equation, we have\n\n$$\n{y}^{2}=-\\frac{4{C}^{2}}{x}\\,⟹\\,{C}^{2}=-\\frac{x{y}^{2}}{4}.\n$$\n\nSubstituting this into our slope equation, we get\n\n$$\n{y}^{′}=\\frac{2\\left(-\\frac{x{y}^{2}}{4}\\right)}{{x}^{2}y}=-\\frac{y}{2x}.\n$$\n\nFor a curve to intersect this family orthogonally, its slope ${y}_{⊥}^{′}$ must be the negative reciprocal of the slope ${y}^{′}$ above. Hence,\n\n$$\n{y}_{⊥}^{′}=-\\frac{1}{{y}^{′}}=-\\frac{1}{\\left(-\\frac{y}{2x}\\right)}=\\frac{2x}{y}.\n$$\n\nTherefore, the orthogonal trajectories must satisfy\n\n$$\n\\frac{dy}{dx}=\\frac{2x}{y}.\n$$\n\n**Note**: For the original family, since $C\\ne 0,$ we have $y\\ne 0$ whenever $x\\ne 0,$ hence, the slopes are well-defined. Otherwise, when $x=0,$ the curve is not defined."} {:db/id #edb/ref 17592186374896 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ec044b6-90fe-559a-a74c-8c1d516f1d3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=-\\frac{x}{y}" :db/id #edb/ref 17592186374898} {:answer/id #uuid "c7063a98-b14b-553b-9bfb-cf179c08a333" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=\\frac{x}{y}" :db/id #edb/ref 17592186374899} {:answer/id #uuid "1de77dd8-d543-5789-9a42-79d550c52e7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=-\\frac{y}{x}" :db/id #edb/ref 17592186374900} {:answer/id #uuid "90d12a8a-d619-544c-845e-eba3e402f696" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=\\frac{{y}^{2}}{x}" :db/id #edb/ref 17592186374901} {:answer/id #uuid "bf969a54-d43a-57cd-ae16-f37e51952fc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=\\frac{y}{x}" :db/id #edb/ref 17592186374902}] :answer-field/correct {:answer/id #uuid "c7063a98-b14b-553b-9bfb-cf179c08a333" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dx}=\\frac{x}{y}" :db/id #edb/ref 17592186374899} :answer-field/id #uuid "2e5a7bf9-7ed7-5f8d-ae5a-28a81c6b563d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374897}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8d4d5768-937a-5096-afaf-5a1645a9f0c8" :question/math-academy-id "q-337325" :question/problem "Determine the differential equation satisfied by the orthogonal trajectories of the family of curves ${y}^{2}=-\\frac{3C}{{x}^{2}},$ where $C\\ne 0$ is a parameter, in terms of $x$ and $y$ only." :question/worked-solution "Orthogonal trajectories are families of curves that intersect another given family of curves at right angles. In other words, the tangent lines of curves from each family are perpendicular at every intersection point.\n\nLet's determine the slope of the family of curves given by ${y}^{2}=-\\frac{3C}{{x}^{2}}.$ First, we implicitly differentiate with respect to $x$ and solve for the derivative of $y:$\n\n$$\n\\begin{aligned}\\frac{d}{dx}({y}^{2}) & =\\frac{d}{dx}\\,\\left(-\\frac{3C}{{x}^{2}}\\right) \\\\ 2y{y}^{′} & =\\frac{6C}{{x}^{3}} \\\\ {y}^{′} & =\\frac{3C}{{x}^{3}y}\\end{aligned}\n$$\n\nNow, we must eliminate $C.$ From the original family of curves equation, we have\n\n$$\n{y}^{2}=-\\frac{3C}{{x}^{2}}\\,⟹\\,C=-\\frac{{x}^{2}{y}^{2}}{3}.\n$$\n\nSubstituting this into our slope equation, we get\n\n$$\n{y}^{′}=\\frac{3\\left(-\\frac{{x}^{2}{y}^{2}}{3}\\right)}{{x}^{3}y}=-\\frac{y}{x}.\n$$\n\nFor a curve to intersect this family orthogonally, its slope ${y}_{⊥}^{′}$ must be the negative reciprocal of the slope ${y}^{′}$ above. Hence,\n\n$$\n{y}_{⊥}^{′}=-\\frac{1}{{y}^{′}}=-\\frac{1}{\\left(-\\frac{y}{x}\\right)}=\\frac{x}{y}.\n$$\n\nTherefore, the orthogonal trajectories must satisfy\n\n$$\n\\frac{dy}{dx}=\\frac{x}{y}.\n$$\n\n**Note**: For the original family, since $C\\ne 0,$ we have $y\\ne 0$ whenever $x\\ne 0,$ hence, the slopes are well-defined. Otherwise, when $x=0,$ the curve is not defined."} {:db/id #edb/ref 17592186374910 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "833addb7-0164-5f7c-bb34-29651996fbc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}y=K" :db/id #edb/ref 17592186374912} {:answer/id #uuid "bb7ee723-e1fc-538d-a9fe-fe42e7426afa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=Ky" :db/id #edb/ref 17592186374913} {:answer/id #uuid "75811765-47db-5662-b560-125a09e37856" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=K" :db/id #edb/ref 17592186374914} {:answer/id #uuid "e791fc1a-5891-5df4-bee0-fa25c7da72b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=Kx" :db/id #edb/ref 17592186374915} {:answer/id #uuid "1faceebb-b201-5935-b797-b0dcbc04a0d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "xy=K" :db/id #edb/ref 17592186374916}] :answer-field/correct {:answer/id #uuid "e791fc1a-5891-5df4-bee0-fa25c7da72b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=Kx" :db/id #edb/ref 17592186374915} :answer-field/id #uuid "ba512409-31cf-5e9d-99b6-4d1f84e3bf75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374911}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "20e84823-52da-5d8d-9751-7e5bcade7fd3" :question/math-academy-id "q-337569" :question/problem "Find the orthogonal trajectories of the family of curves ${x}^{2}+{y}^{2}=C,$ where $C$ and $K$ are parameters." :question/worked-solution "Orthogonal trajectories are families of curves that intersect another given family of curves at right angles. In other words, the tangent lines of curves from each family are perpendicular at every intersection point.\n\nLet's determine the slope of the family of curves given by ${x}^{2}+{y}^{2}=C.$ First, we implicitly differentiate with respect to $x$ and solve for the derivative of $y:$\n\n$$\n\\begin{aligned}\\frac{d}{dx}\\,({x}^{2}+{y}^{2}) & =\\frac{d}{dx}(C) \\\\ 2x+2y{y}^{′} & =0 \\\\ {y}^{′} & =-\\frac{x}{y}\\end{aligned}\n$$\n\nNote that the parameter $C$ has already been eliminated.\n\nFor a curve to intersect this family orthogonally, its slope ${y}_{⊥}^{′}$ must be the negative reciprocal of the slope ${y}^{′}$ above. Hence,\n\n$$\n{y}_{⊥}^{′}=-\\frac{1}{{y}^{′}}=-\\frac{1}{\\left(-\\frac{x}{y}\\right)}=\\frac{y}{x}.\n$$\n\nHence, the orthogonal trajectories must satisfy\n\n$$\n\\frac{dy}{dx}=\\frac{y}{x}.\n$$\n\nTo find the general solution, we separate the variables and integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{1}{y}\\cdot \\frac{dy}{dx} & =\\frac{1}{x} \\\\ \\int \\frac{1}{y}\\cdot \\frac{dy}{dx}\\,dx & =\\int \\frac{1}{x}\\,dx \\\\ \\int \\frac{1}{y}\\,dy & =\\int \\frac{1}{x}\\,dx \\\\ \\operatorname{ln}⁡|y| & =\\operatorname{ln}⁡|x|+{K}_{1} \\\\ \\operatorname{ln}⁡|y|-\\operatorname{ln}⁡|x| & ={K}_{1} \\\\ \\operatorname{ln}⁡|\\frac{y}{x}| & ={K}_{1} \\\\ \\frac{y}{x} & =K \\\\ y & =Kx\\end{aligned}\n$$\n\nNote that $K=\\pm {e}^{{K}_{1}}$ is a constant of integration.\n\nTherefore, the orthogonal trajectories of the family of curves ${x}^{2}+{y}^{2}=C,$ where $C$ is a parameter, are given by\n\n$$\ny=Kx,\n$$\n\nwhere $K$ is a parameter. Some curves from each family for specific parameter values are given in the diagram below.\n\n![](images/ca/ca980af3c5db940a9ab95567dfaa1a69ea8afb9f4f42f772bb446df67df129b8.png)\n\n**Note**: For the slopes ${y}^{′}$ and ${y}_{⊥}^{′},$ we divide by $y$ and $x,$ respectively. So, the orthogonal trajectories are only defined on the region $x,y\\ne 0.$"} {:db/id #edb/ref 17592186374917 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ffd8ebb-c265-553a-930f-4c55b4b9f184" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=Ky" :db/id #edb/ref 17592186374919} {:answer/id #uuid "e210cc25-c13f-5e25-9440-1c76880dc514" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=K" :db/id #edb/ref 17592186374920} {:answer/id #uuid "d062e833-85cc-5d6f-b2a9-8e7780d807a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=Kx" :db/id #edb/ref 17592186374921} {:answer/id #uuid "d23e1857-def3-5b34-be92-44a516f342f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "xy=K" :db/id #edb/ref 17592186374922} {:answer/id #uuid "97f12d19-6d42-5216-844d-fac39e4f2bb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{2}\\operatorname{ln}⁡|x|+K" :db/id #edb/ref 17592186374923}] :answer-field/correct {:answer/id #uuid "97f12d19-6d42-5216-844d-fac39e4f2bb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{2}\\operatorname{ln}⁡|x|+K" :db/id #edb/ref 17592186374923} :answer-field/id #uuid "4e59c1a4-b0c0-53ec-bffd-738ded8226df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374918}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "95e7abe8-3e12-5829-b71d-e930b03de0fe" :question/math-academy-id "q-337577" :question/problem "Find the orthogonal trajectories of the family of curves $y={x}^{2}+C,$ where $C$ and $K$ are parameters." :question/worked-solution "Orthogonal trajectories are families of curves that intersect another given family of curves at right angles. In other words, the tangent lines of curves from each family are perpendicular at every intersection point.\n\nLet's determine the slope of the family of curves given by $y={x}^{2}+C.$ First, we implicitly differentiate with respect to $x$ and solve for the derivative of $y:$\n\n$$\n\\begin{aligned}\\frac{d}{dx}(y) & =\\frac{d}{dx}\\,({x}^{2}+C) \\\\ {y}^{′} & =2x\\end{aligned}\n$$\n\nNote that the parameter $C$ has already been eliminated.\n\nFor a curve to intersect this family orthogonally, its slope ${y}_{⊥}^{′}$ must be the negative reciprocal of the slope ${y}^{′}$ above. Hence,\n\n$$\n{y}_{⊥}^{′}=-\\frac{1}{{y}^{′}}=-\\frac{1}{(2x)}=-\\frac{1}{2x}.\n$$\n\nHence, the orthogonal trajectories must satisfy\n\n$$\n\\frac{dy}{dx}=-\\frac{1}{2x}.\n$$\n\nTo find the general solution, we separate the variables and integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =-\\frac{1}{2x} \\\\ \\int \\frac{dy}{dx}\\,dx & =\\int \\left(-\\frac{1}{2x}\\right)\\,dx \\\\ \\int 1\\,dy & =-\\frac{1}{2}\\int \\frac{1}{x}\\,dx \\\\ y & =-\\frac{1}{2}\\operatorname{ln}⁡|x|+K\\end{aligned}\n$$\n\nNote that $K$ is a constant of integration.\n\nTherefore, the orthogonal trajectories of the family of curves $y={x}^{2}+C,$ where $C$ is a parameter, are given by\n\n$$\ny=-\\frac{1}{2}\\operatorname{ln}⁡|x|+K,\n$$\n\nwhere $K$ is a parameter. Some curves from each family for specific parameter values are given in the diagram below.\n\n![](images/37/37019d0c75ba56e28d3e2a592b806941b16005ddb906f4aa126547c0925bd14c.png)\n\n**Note**: For the slopes ${y}^{′}$ and ${y}_{⊥}^{′},$ we divide by $x$ when finding ${y}_{⊥}^{′}.$ So, the orthogonal trajectories are only defined on the region $x\\ne 0.$"} {:db/id #edb/ref 17592186374924 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f607760-f38e-5bf2-a1b4-0d34c34ea859" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}-2{x}^{2}=K" :db/id #edb/ref 17592186374926} {:answer/id #uuid "2ea651f5-4f21-5ab8-bf09-afef1ae55fca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}+Cx=K" :db/id #edb/ref 17592186374927} {:answer/id #uuid "f9b0da75-edae-5175-8a8e-f4eaa45c5472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{2}+K" :db/id #edb/ref 17592186374928} {:answer/id #uuid "8d745ed3-1b2b-5076-b4de-ea32211caf25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{y}^{2}+2{x}^{2}=K" :db/id #edb/ref 17592186374929} {:answer/id #uuid "9bbc2b8e-411f-5505-b619-5bd2cb1e86c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}+2{x}^{2}=K" :db/id #edb/ref 17592186374930}] :answer-field/correct {:answer/id #uuid "9bbc2b8e-411f-5505-b619-5bd2cb1e86c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}+2{x}^{2}=K" :db/id #edb/ref 17592186374930} :answer-field/id #uuid "080d2f6c-6aee-5b11-b159-6789b41fc162" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374925}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1112c629-7ea8-5085-813a-086cecee9fd0" :question/math-academy-id "q-337598" :question/problem "Find the orthogonal trajectories of the family of curves ${y}^{2}=Cx,$ where $C\\ne 0$ and $K$ are parameters." :question/worked-solution "Orthogonal trajectories are families of curves that intersect another given family of curves at right angles. In other words, the tangent lines of curves from each family are perpendicular at every intersection point.\n\nLet's determine the slope of the family of curves given by ${y}^{2}=Cx.$ First, we implicitly differentiate with respect to $x$ and solve for the derivative of $y:$\n\n$$\n\\begin{aligned}\\frac{d}{dx}({y}^{2}) & =\\frac{d}{dx}(Cx) \\\\ 2y{y}^{′} & =C \\\\ {y}^{′} & =\\frac{C}{2y}\\end{aligned}\n$$\n\nNow, we must eliminate $C.$ From the original family of curves equation, we have\n\n$$\n{y}^{2}=Cx\\,⟹\\,C=\\frac{{y}^{2}}{x}.\n$$\n\nSubstituting this into our slope equation, we get\n\n$$\n{y}^{′}=\\frac{\\left(\\frac{{y}^{2}}{x}\\right)}{2y}=\\frac{y}{2x}.\n$$\n\nFor a curve to intersect this family orthogonally, its slope ${y}_{⊥}^{′}$ must be the negative reciprocal of the slope ${y}^{′}$ above. Hence,\n\n$$\n{y}_{⊥}^{′}=-\\frac{1}{{y}^{′}}=-\\frac{1}{\\left(\\frac{y}{2x}\\right)}=-\\frac{2x}{y}.\n$$\n\nHence, the orthogonal trajectories must satisfy\n\n$$\n\\frac{dy}{dx}=-\\frac{2x}{y}.\n$$\n\nTo find the general solution, we separate the variables and integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}y\\cdot \\frac{dy}{dx} & =-2x \\\\ \\int y\\cdot \\frac{dy}{dx}\\,dx & =\\int (-2x)\\,dx \\\\ \\int y\\,dy & =-2\\int x\\,dx \\\\ \\frac{{y}^{2}}{2} & =-{x}^{2}+K \\\\ {y}^{2}+2{x}^{2} & =K\\end{aligned}\n$$\n\nNote that $K$ is a constant of integration.\n\nTherefore, the orthogonal trajectories of the family of curves ${y}^{2}=Cx,$ where $C$ is a parameter, are given by\n\n$$\n{y}^{2}+2{x}^{2}=K,\n$$\n\nwhere $K$ is a parameter. Some curves from each family for specific parameter values are given in the diagram below.\n\n![](images/03/039a42b728cad07b3e8f5dfd2f1607b36819e586f40e54e06d942679bb4ededa.png)\n\n**Note**: Since $C\\ne 0,$ we have $y\\ne 0$ on every curve in the family (except possibly at $x=0$), so slopes ${y}^{′}$ and ${}_{⊥}^{′}$ are well-defined away from $y=0.$"} {:db/id #edb/ref 17592186374993 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a615dd0-3f77-5dfd-b26b-39f0cde70998" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge -5" :db/id #edb/ref 17592186374995} {:answer/id #uuid "8f291ac4-6543-5679-93d1-65e628f4e1ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>5" :db/id #edb/ref 17592186374996} {:answer/id #uuid "c31043e3-2b67-5c50-b765-9054581ce030" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 5" :db/id #edb/ref 17592186374997} {:answer/id #uuid "f1ff7972-c57c-554b-8941-adb57964773a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 0" :db/id #edb/ref 17592186374998} {:answer/id #uuid "19bc009f-a48d-5f7c-919b-2e83f1d36c80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>-5" :db/id #edb/ref 17592186374999} {:answer/id #uuid "4f6bd806-3f16-506f-beea-59f026bce5bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>0" :db/id #edb/ref 17592186375000}] :answer-field/correct {:answer/id #uuid "8f291ac4-6543-5679-93d1-65e628f4e1ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>5" :db/id #edb/ref 17592186374996} :answer-field/id #uuid "9ebbcb18-2090-5c68-b6a4-04c751298594" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186374994} {:answer-field/choices [{:answer/id #uuid "3c52f968-3e9b-592a-b3ef-f342903dab7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{s}{{s}^{2}+25}" :db/id #edb/ref 17592186375002} {:answer/id #uuid "7a4f5c6c-e882-5e0f-897e-2e17ff4bda27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5s}{{s}^{2}-25}" :db/id #edb/ref 17592186375003} {:answer/id #uuid "890e4ab9-4f40-5bf0-bb86-49177abaae90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{s}{{s}^{2}-25}" :db/id #edb/ref 17592186375004} {:answer/id #uuid "e0bb0e97-035a-5499-84fc-66ceeac6ae0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{{s}^{2}-25}" :db/id #edb/ref 17592186375005} {:answer/id #uuid "138765c8-390e-53dc-a580-7516a0dc580b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{{s}^{2}+25}" :db/id #edb/ref 17592186375006}] :answer-field/correct {:answer/id #uuid "e0bb0e97-035a-5499-84fc-66ceeac6ae0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{{s}^{2}-25}" :db/id #edb/ref 17592186375005} :answer-field/id #uuid "7955e3ad-1f9d-50d6-9e96-71c3d2b43bbb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186375001}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3dbc92cb-1339-57fe-b1ef-0f6893134b4e" :question/math-academy-id "q-341125" :question/problem "Use the Laplace transform of $f(t)={e}^{kt}$ to find the Laplace transform of $\\operatorname{sinh}⁡(5t).$$\\,L{\\operatorname{sinh}⁡(5t)}=$ {{field-1}},\ndefined for {{field-2}}." :question/worked-solution "The linearity property of the Laplace transform states that for functions $f(t)$ and $g(t),$ we have\n\n$$\nL{\\alpha f(t)+\\beta g(t)}=\\alpha \\cdot L{f(t)}+\\beta \\cdot L{g(t)},\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants.\n\nFirst, recall that, by definition\n\n$$\n\\operatorname{sinh}⁡(5t)=\\frac{{e}^{5t}-{e}^{-5t}}{2}.\n$$\n\nTaking the Laplace transform and applying the linearity property, we have\n\n$$\n\\begin{aligned}L{\\operatorname{sinh}⁡(5t)} & =L{\\frac{{e}^{5t}-{e}^{-5t}}{2}} \\\\  & =L{\\frac{{e}^{5t}}{2}-\\frac{{e}^{-5t}}{2}} \\\\  & =L{\\frac{{e}^{5t}}{2}}-L{\\frac{{e}^{-5t}}{2}} \\\\  & =\\frac{1}{2}L{{e}^{5t}}-\\frac{1}{2}L{{e}^{-5t}}.\\end{aligned}\n$$\n\nNow, we recall that \n\n$$\nL{{e}^{kt}}=\\frac{1}{s-k},\\,s>k.\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{{e}^{5t}} & =\\frac{1}{s-5},\\,s>5 \\\\ L{{e}^{-5t}} & =\\frac{1}{s+5},\\,s>-5\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $\\operatorname{sinh}⁡(5t)$ is\n\n$$\n\\begin{aligned}L{\\operatorname{sinh}⁡(5t)} & =\\frac{1}{2}L{{e}^{5t}}-\\frac{1}{2}L{{e}^{-5t}} \\\\  & =\\frac{1}{2}\\cdot \\frac{1}{s-5}-\\frac{1}{2}\\cdot \\frac{1}{s+5} \\\\  & =\\frac{1}{2}(\\frac{1}{s-5}-\\frac{1}{s+5}) \\\\  & =\\frac{1}{2}\\left(\\frac{(s+5)-(s-5)}{(s-5)(s+5)}\\right) \\\\  & =\\frac{1}{2}\\left(\\frac{10}{{s}^{2}-25}\\right) \\\\  & =\\frac{5}{{s}^{2}-25}.\\end{aligned}\n$$\n\nFinally, since $L{{e}^{5t}}$ is defined for $s\\in (5,\\infty )$ and $L{{e}^{-5t}}$ is defined for $s\\in (-5,\\infty ),$ we have that $L{\\operatorname{sinh}⁡(5t)}$ is defined for\n\n$$\n(5,\\infty )\\cap (-5,\\infty )=(5,\\infty ),\n$$\n\nthat is, $s>5.$"} {:db/id #edb/ref 17592186375013 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60a7da25-3819-543c-8175-bafe62ae6511" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3}-1" :db/id #edb/ref 17592186375015}] :answer-field/correct {:answer/id #uuid "60a7da25-3819-543c-8175-bafe62ae6511" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3}-1" :db/id #edb/ref 17592186375015} :answer-field/id #uuid "a6f51352-3d01-53ca-8db3-11580f65199a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186375014}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "94c943de-bfb8-53f2-9b3d-3296f7b29f90" :question/math-academy-id "q-342670" :question/problem "Evaluate $tanh\\,\\left(\\frac{3}{2}\\right).$ **Do not round** your answer.\n\n$tanh\\,\\left(\\frac{3}{2}\\right)=$\n\n| {{field-1}} |\n| --- |\n| ${e}^{3}+1$ |" :question/worked-solution "The definition of $\\operatorname{tanh}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the second definition, we get\n\n$$\n\\begin{aligned}tanh\\,\\left(\\frac{3}{2}\\right) & =\\frac{{e}^{2(3/2)}-1}{{e}^{2(3/2)}+1} \\\\  & =\\frac{{e}^{3}-1}{{e}^{3}+1}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375016 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38ea6a32-82ac-510a-a99f-46d79071114f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186375018}] :answer-field/correct {:answer/id #uuid "38ea6a32-82ac-510a-a99f-46d79071114f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186375018} :answer-field/id #uuid "52301b94-6cf0-5a4d-ba7d-d8095c654386" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186375017}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "66feadb1-f43c-538a-a529-6b0decd87e96" :question/math-academy-id "q-343184" :question/problem "![](images/e0/e0c966c29904cd5b5bce39e8a6675f05b658c457fa58338f336b90ee50c9141b.png)\n\nA factory uses a rectangular mold with a fixed width of $18\\,\\text{in}$ and a fixed height of $10\\,\\text{in}.$ Liquid resin is poured in so that the resin fills the mold and the length increases as the front face moves. What is the rate of change of the length if the volume is increasing at a rate of $540\\,{\\text{in}}^{3}/\\text{min}?$\n\nThe length is increasing at a rate of\n{{field-1}}\n$\\text{in}/\\text{min}.$" :question/worked-solution "Let $x,y,z$ be the dimensions of the rectangular prism, let $V$ be its volume. We are given that \n\n$$\n\\begin{aligned}y & =18\\,\\text{in}, \\\\ z & =10\\,\\text{in}.\\end{aligned}\n$$\n\nAlso, we know that\n\n$$\n\\frac{\\text{d}V}{\\text{d}t}=540\\,{\\text{in}}^{3}/\\text{min}.\n$$\n\nWe would like to find $\\frac{\\text{d}x}{\\text{d}t}$ when $y=18\\,\\text{in}$ and $z=10\\,\\text{in}.$\n\nWe start with the formula for the volume of the rectangular prism:\n\n$$\nV=xyz\n$$\n\nSubstituting the known values, we get\n\n$$\nV=x(18)(10)=180x.\n$$\n\nNow, we differentiate with respect to time using the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(180x) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =180\\left(\\frac{\\text{d}x}{\\text{d}t}\\right).\\end{aligned}\n$$\n\nWe can now plug in the known value into the above expression. This gives\n\n$$\n\\begin{aligned}540 & =180\\left(\\frac{\\text{d}x}{\\text{d}t}\\right) \\\\ \\frac{\\text{d}x}{\\text{d}t} & =3\\,\\text{in}\\text{/min}.\\end{aligned}\n$$\n\nTherefore, the length is increasing at a rate of $3\\,\\text{in}/\\text{min}.$"} {:db/id #edb/ref 17592186375019 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3734ad21-abc6-5822-9aee-946efd1e29fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.05" :db/id #edb/ref 17592186375021}] :answer-field/correct {:answer/id #uuid "3734ad21-abc6-5822-9aee-946efd1e29fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.05" :db/id #edb/ref 17592186375021} :answer-field/id #uuid "bf326772-e01d-51f5-9d61-a18dbad87b7b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186375020}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5b126fc6-73e1-5b77-bb62-276262fc5ca6" :question/math-academy-id "q-343187" :question/problem "![](images/6e/6eb2c7621d7be454bb287325e97f2db47ddf6591d269b26df58ac65b8ee7ca5f.png)\n\nA rectangular fish tank is draining. The tank is $6\\,\\text{ft}$ long and $4\\,\\text{ft}$ wide. What is the rate of change of the water level if the volume is decreasing at a rate of $1.2\\,{\\text{ft}}^{3}/\\text{min}?$ Assume that the water level's rate of decrease is positive.\n\nThe water level is decreasing at a rate of\n{{field-1}}\n$\\text{ft}/\\text{min}.$" :question/worked-solution "Let $x,y,z$ be the dimensions of the rectangular prism, let $V$ be its volume. We are given that \n\n$$\n\\begin{aligned}x & =6\\,\\text{ft}, \\\\ y & =4\\,\\text{ft}.\\end{aligned}\n$$\n\nAlso, we know that\n\n$$\n\\frac{\\text{d}V}{\\text{d}t}=-1.2\\,{\\text{ft}}^{3}/\\text{min}.\n$$\n\nWe would like to find $\\frac{\\text{d}z}{\\text{d}t}$ when $x=6\\,\\text{ft}$ and $y=4\\,\\text{ft}.$\n\nWe start with the formula for the volume of the rectangular prism:\n\n$$\nV=xyz\n$$\n\nSubstituting the known values, we get\n\n$$\nV=(6)(4)z=24z.\n$$\n\nNow, we differentiate with respect to time using the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(24z) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =24\\left(\\frac{\\text{d}z}{\\text{d}t}\\right).\\end{aligned}\n$$\n\nWe can now plug in the known value into the above expression. This gives\n\n$$\n\\begin{aligned}-1.2 & =24\\left(\\frac{\\text{d}z}{\\text{d}t}\\right) \\\\ \\frac{\\text{d}z}{\\text{d}t} & =-0.05\\,\\text{ft}\\text{/h}.\\end{aligned}\n$$\n\nTherefore, the water level is decreasing at a rate of $0.05\\,\\text{ft}/\\text{min}.$"} {:db/id #edb/ref 17592186375025 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9387c868-c63f-5bf3-b005-dbb97af1df43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11.8" :db/id #edb/ref 17592186375027}] :answer-field/correct {:answer/id #uuid "9387c868-c63f-5bf3-b005-dbb97af1df43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11.8" :db/id #edb/ref 17592186375027} :answer-field/id #uuid "73936d24-8096-5da1-807d-53eace93737a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186375026}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6812daeb-0545-51ac-ad16-eba349aac5cb" :question/math-academy-id "q-343325" :question/problem "![](images/57/574730352afe4f78c83ae9755df8dbe362a3699000955d17d2d907fa3e842b98.png)\n\nA bar of soap wearing down with use gradually decreases in all its dimensions. Its height is decreasing at a rate of $0.05\\,\\text{cm/s},$ its width is decreasing at a rate of $0.1\\,\\text{cm/s},$ and its length is decreasing at a rate of $0.2\\,\\text{cm/s}.$ How fast is its volume changing when its dimensions are $12\\,\\text{cm}$ in length, $5\\,\\text{cm}$ in width, and $4\\,\\text{cm}$ in height? Assume that the rate of decrease of volume is positive.\n\nThe volume of the bar of soap is decreasing at a rate of\n{{field-1}}\n${\\text{cm}}^{3}\\text{/s}.$" :question/worked-solution "Let $L,$ $W,$ $H$ and $V$ be the length, the width, the height, and the volume of the box, respectively. We know that\n\n$$\n\\begin{aligned}L=12\\text{ cm},\\, & W=5\\text{ cm}, \\\\ H=4\\text{ cm},\\, & \\frac{\\text{d}L}{\\text{d}t}=-0.2\\text{ cm/s}, \\\\ \\frac{\\text{d}W}{\\text{d}t}=-0.1\\text{ cm/s},\\, & \\frac{\\text{d}H}{\\text{d}t}=-0.05\\text{ cm/s}.\\end{aligned}\n$$\n\nWe would like to find $\\frac{\\text{d}V}{\\text{d}t}.$\n\nThe relation between the four variables is given by the formula for the volume of a rectangular prism:\n\n$$\nV=LWH\n$$\n\nWe differentiate both sides of $V=LWH$ with respect to $t,$ using the product rule, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}V & =\\frac{\\text{d}}{\\text{d}t}(LWH) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =W\\cdot H\\left(\\frac{\\text{d}L}{\\text{d}t}\\right)+L\\cdot H\\left(\\frac{\\text{d}W}{\\text{d}t}\\right)+L\\cdot W\\left(\\frac{\\text{d}H}{\\text{d}t}\\right).\\end{aligned}\n$$\n\nFinally, we can plug in the known values and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}V}{\\text{d}t} & =(5)(4)(-0.2)+(12)(4)(-0.1)+(12)(5)(-0.05) \\\\  & =-11.8{\\text{ cm}}^{3}/\\text{s}.\\end{aligned}\n$$\n\nTherefore, the volume of the bar of soap is decreasing at a rate of $11.8{\\text{ cm}}^{3}/\\text{s}.$"} {:db/id #edb/ref 17592186375028 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b5eb1c8-01c9-5671-a035-b45ec2547eb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2400" :db/id #edb/ref 17592186375030}] :answer-field/correct {:answer/id #uuid "8b5eb1c8-01c9-5671-a035-b45ec2547eb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2400" :db/id #edb/ref 17592186375030} :answer-field/id #uuid "c83b4c80-e4d4-5493-b84f-95e022ee40b2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186375029}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "010f8799-9b1d-5084-ad88-8118957f7d57" :question/math-academy-id "q-343349" :question/problem "![](images/6e/6e41308fb734cdb42fe0d199a46e7db8edd25bd5d9ea5a3fabff0601a42dce51.png)\n\nA rectangular loaf of rising bread dough is squeezed between two rigid side panels that keep its width fixed at $60\\,\\text{mm}.$ The length of the loaf is decreasing by $2\\,\\text{mm}\\text{/s}$ and its height is increasing by $1\\,\\text{mm}\\text{/s}.$ How fast is its volume changing when its dimensions are $100\\,\\text{mm}$ in length and $30\\,\\text{mm}$ in height?\n\nThe volume is increasing at a rate of\n{{field-1}}\n${\\text{mm}}^{3}/\\text{s}.$" :question/worked-solution "We define the following variables:\n\n- let $L,$ $W,$ and $H$ be the length, width, and height of the bread loaf, respectively, and\n\n- let $V$ be the volume of the bread loaf.\n\nNote that $L,$ $H,$ and $V$ change with time, while $W$ is constant. \n\nWe are given that\n\n$$\n\\begin{aligned}L=100\\text{ mm},\\, & W=60\\text{ mm}, \\\\ H=30\\text{ mm},\\, & \\frac{\\text{d}L}{\\text{d}t}=-2\\text{ mm/s}, \\\\ \\frac{\\text{d}H}{\\text{d}t}=1\\text{ mm/s}\\end{aligned}\n$$\n\nWe would like to find $\\frac{\\text{d}V}{\\text{d}t}.$\n\nThe relation between the three time-dependent variables, $V,$ $H$ and $L,$ is given by the formula for the volume of bread loaf:\n\n$$\nV=LWH\n$$\n\nWe differentiate both sides of $V=LWH$ with respect to $t,$ treating $W$ as a constant, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}V & =\\frac{\\text{d}}{\\text{d}t}(LWH) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =W\\frac{\\text{d}}{\\text{d}t}(LH) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =W[L\\left(\\frac{\\text{d}H}{\\text{d}t}\\right)+H\\left(\\frac{\\text{d}L}{\\text{d}t}\\right)] \\\\ \\frac{\\text{d}V}{\\text{d}t} & =W\\cdot L\\left(\\frac{\\text{d}H}{\\text{d}t}\\right)+W\\cdot H\\left(\\frac{\\text{d}L}{\\text{d}t}\\right).\\end{aligned}\n$$\n\nFinally, we can plug in the known values and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}V}{\\text{d}t} & =(60)(100)(1)+(60)(30)(-2) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =6000-3600 \\\\ \\frac{\\text{d}V}{\\text{d}t} & =2400.\\end{aligned}\n$$\n\nTherefore, the volume of bread loaf is increasing at a rate of $2400\\,{\\text{mm}}^{3}\\text{/s}.$"} {:db/id #edb/ref 17592186375055 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2acba6b-85a0-5271-998e-5cb3d652c89e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186375057}] :answer-field/correct {:answer/id #uuid "e2acba6b-85a0-5271-998e-5cb3d652c89e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186375057} :answer-field/id #uuid "05225483-6672-597f-a26b-7bc809c08b7c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186375056}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a441f1e0-bba8-5858-84bf-38b79256c3c4" :question/math-academy-id "q-343451" :question/problem "$$\nF(x)=\\{\\begin{aligned}-4, & x\\in [-\\frac{\\pi }{2},0) \\\\ 2\\operatorname{sin}⁡x, & x\\in [0,\\frac{\\pi }{2})\\end{aligned}\n$$\n\nConsider the function $F(x)$ shown above. Find the value to which the Fourier series of the $\\pi $-periodic extension $f(x)$ of $F(x)$ converges when $x=\\frac{\\pi }{2}.$\n\nThe Fourier series converges to {{field-1}} when $x=\\frac{\\pi }{2}.$" :question/worked-solution "Suppose that $f(x)$ is a $2L$-periodic piecewise smooth function with the corresponding Fourier series\n\n$$\nS(x)=\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{L}x).\n$$\n\nThen, the series converges for all $x\\in R.$\n\n- If $f(x)$ is continuous at $x,$ then the series converges to the value of the function at this point:\n\n$$\nS(x)=f(x)\n$$\n\n- If $f(x)$ has a jump discontinuity at $x,$ then the series converges to the midpoint between the values of left- and right-sided limits of the function at this point:\n\n$$\nS(x)=\\frac{{f}^{-}(x)+{f}^{+}(x)}{2}\n$$\n\nwhere ${f}^{-}(x)$ and ${f}^{+}(x)$ are the left- and right-sided limits of the function at this point, respectively.\n\nNotice that the $\\pi $-periodic extension $f(x)$ of our function $F(x)$ is not continuous at $x=\\frac{\\pi }{2}.$ The one-sided limits at this point are the following:\n\n$$\n\\begin{aligned}{f}^{-}\\,\\left(\\frac{\\pi }{2}\\right) & ={lim}_{x\\to (\\pi /2)^{-}}f(x)=2\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)=2 \\\\ {f}^{+}\\,\\left(\\frac{\\pi }{2}\\right) & ={lim}_{x\\to (\\pi /2)^{+}}f(x)=-4\\end{aligned}\n$$\n\n \n\nTherefore, the Fourier series of $f(x)$ converges to \n\n$$\n\\frac{{f}^{-}\\,\\left(\\frac{\\pi }{2}\\right)+{f}^{+}\\,\\left(\\frac{\\pi }{2}\\right)}{2}=\\frac{2+(-4)}{2}=-1.\n$$"} {:db/id #edb/ref 17592186375058 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45779598-424d-5b7c-b0dc-1b9dbdc494f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}(t)+1" :db/id #edb/ref 17592186375060}] :answer-field/correct {:answer/id #uuid "45779598-424d-5b7c-b0dc-1b9dbdc494f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}(t)+1" :db/id #edb/ref 17592186375060} :answer-field/id #uuid "076095c7-fee4-5daa-9aa5-38104c357d45" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186375059}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1d07345a-3a0a-518b-82c7-108ea7e7359c" :question/math-academy-id "q-346863" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with velocity $v(t)={sec}^{2}⁡(t),$ where $t>0$ is the time. If the particle is at the position $x=2$ when $t=\\frac{\\pi }{4},$ calculate the position $x$ of the particle at time $t.$\n\n$x(t)=$\n{{field-1}}" :question/worked-solution "We start by integrating the velocity to get $x(t):$\n\n$$\n\\begin{aligned}x(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int {sec}^{2}⁡(t)\\,\\text{d}t \\\\  & =\\operatorname{tan}⁡(t)+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $x\\left(\\frac{\\pi }{4}\\right)=2.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}2 & =\\operatorname{tan}⁡\\left(\\frac{\\pi }{4}\\right)+C \\\\ 2 & =1+C \\\\ C & =1.\\end{aligned}\n$$\n\nTherefore, the position $x$ of the particle at time $t$ is \n\n$$\nx(t)=\\operatorname{tan}⁡(t)+1.\n$$"} {:db/id #edb/ref 17592186375103 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e43e2c3-5048-5e2e-a94a-bcb90d586202" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{0}^{1}{\\int }_{0}^{5}(2uv-{u}^{2}+{v}^{2})\\,du\\,dv" :db/id #edb/ref 17592186375105} {:answer/id #uuid "b13b11c1-2465-561f-a96b-19fa507beb2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}{\\int }_{0}^{1}{\\int }_{0}^{5}(2uv-3{v}^{2}+{u}^{2})\\,du\\,dv" :db/id #edb/ref 17592186375106} {:answer/id #uuid "f152898a-1a3f-57ba-8463-c69b4da0c17c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}{\\int }_{0}^{1}{\\int }_{0}^{5}(uv-{v}^{2}+3{u}^{2})\\,du\\,dv" :db/id #edb/ref 17592186375107} {:answer/id #uuid "3b55205c-68ca-554b-93eb-3fc21cfe0e99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}{\\int }_{0}^{1}{\\int }_{0}^{5}(uv-2{v}^{2}+{v}^{2})\\,du\\,dv" :db/id #edb/ref 17592186375108} {:answer/id #uuid "11837235-5be9-5816-bdf3-58b69896ee4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}{\\int }_{0}^{1}{\\int }_{0}^{5}(uv-5{v}^{2}-{u}^{2})\\,du\\,dv" :db/id #edb/ref 17592186375109}] :answer-field/correct {:answer/id #uuid "b13b11c1-2465-561f-a96b-19fa507beb2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}{\\int }_{0}^{1}{\\int }_{0}^{5}(2uv-3{v}^{2}+{u}^{2})\\,du\\,dv" :db/id #edb/ref 17592186375106} :answer-field/id #uuid "227ed5b3-0cfb-51b9-820b-b40696387d27" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375104}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "db1fee9d-f261-54f6-9563-ad9a8f609d1f" :question/math-academy-id "q-38369" :question/problem "Consider the region $D$ in the $xy$-plane, given by\n\n$$\nD=\\{(x,y)\\,:\\,0\\le 2x+y\\le 5,\\,0\\le y\\le 1\\}.\n$$\n\n  \n\nBy performing the change of variables $u=2x+y$ and $v=y,$ the integral \n\n$$\n{∬}_{D}(2xy+{x}^{2})\\,dx\\,dy\n$$\n\ncan be written in terms of $u$ and $v$ as" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\text{ }dx\\,dy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))|\\frac{∂(x,y)}{∂(u,v)}|du\\,dv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=2x+y,\\,v=y\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,0\\le u\\le 5,\\,0\\le v\\le 1\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & 1 \\\\ 0 & \\text{ }\\text{ }1\\end{vmatrix} \\\\  & =2.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=\\frac{1}{2}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\nIn this case, we first need to solve the transformation equations\n\n$$\nu=2x+y,\\,v=y\n$$\n\n \nfor $x$ and $y$, which gives\n\n$$\nx=\\frac{u-v}{2},\\,y=v.\n$$\n\n \n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}(2xy+{x}^{2})\\,dx\\,dy & ={∬}_{Δ}[2\\cdot \\frac{u-v}{2}\\cdot v+{\\left(\\frac{u-v}{2}\\right)}^{2}]|\\frac{∂(x,y)}{∂(u,v)}|\\text{d}u\\,\\text{d}v \\\\  & ={∬}_{Δ}(uv-{v}^{2}+\\frac{{u}^{2}-2uv+{v}^{2}}{4})\\frac{1}{2}\\,du\\,dv \\\\  & =\\frac{1}{8}{\\int }_{0}^{1}{\\int }_{0}^{5}(2uv-3{v}^{2}+{u}^{2})\\,du\\,dv.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375123 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e650b073-7e42-5a29-a5f0-49b40ec48ce8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}v\\operatorname{ln}⁡u" :db/id #edb/ref 17592186375125} {:answer/id #uuid "5769b11c-c825-5eeb-8948-b8c15db36333" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}v\\operatorname{ln}⁡u" :db/id #edb/ref 17592186375126} {:answer/id #uuid "e83ba63d-1a5b-5b95-80a3-c20f0bf16584" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u\\operatorname{ln}⁡v" :db/id #edb/ref 17592186375127} {:answer/id #uuid "2be95ca7-c78a-5b21-980c-e49c00d94791" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2u\\operatorname{ln}⁡v" :db/id #edb/ref 17592186375128} {:answer/id #uuid "976dc3c1-b29e-52db-a43c-419b89323c0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3v\\operatorname{ln}⁡u" :db/id #edb/ref 17592186375129}] :answer-field/correct {:answer/id #uuid "5769b11c-c825-5eeb-8948-b8c15db36333" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}v\\operatorname{ln}⁡u" :db/id #edb/ref 17592186375126} :answer-field/id #uuid "e86f996d-8724-5990-98a1-29212aad3144" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375124}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8c4bdde5-7a56-510d-ac15-d76aed6084be" :question/math-academy-id "q-39057" :question/problem "Consider the finite region $R$ in the $xyz$-space, given by \n\n$$\nR={(x,y,z)\\,:\\,1\\le {x}^{2}+y\\le 2,\\,-1\\le x\\le 1,\\,1\\le z\\le 4}.\n$$\n\n \n\nGiven the change of variables\n\n$$\nu={x}^{2}+y,\\,v=2x+z,\\,w=z,\n$$\n\nwhich of the following could be the missing part of the expression below?\n\n$$\n{∭}_{R}(2x+z)\\operatorname{ln}⁡({x}^{2}+y)\\,dV={\\int }_{1}^{2}{\\int }_{-1}^{6}{\\int }_{1}^{4}\\,dw\\,dv\\,du\n$$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v \\\\ w\\end{bmatrix}⟶\\begin{bmatrix}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo find the required integral, we can use the change of variables formula\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nwhere $\\frac{∂(x,y,z)}{∂(u,v,w)}$ is the Jacobian determinant corresponding to $T.$ \n\nNote that the change of variables\n\n$$\nu={x}^{2}+y,\\,v=2x+z,\\,w=z,\n$$\n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\\to \\begin{bmatrix}u(x,y,z) \\\\ v(x,y,z) \\\\ w(x,y,z)\\end{bmatrix}.\n$$\n\nTo find the required integral, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $R$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & ={(u,v,w)\\,:\\,1\\le u\\le 2,\\,-1\\le v\\le 6,\\,1\\le w\\le 4}.\\end{aligned}\n$$\n\n \n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$ \n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{vmatrix} \\\\  & =\\begin{vmatrix}2x & 1 & 0 \\\\ 2 & 0 & 1 \\\\ 0 & 0 & 1\\end{vmatrix} \\\\  & =-\\begin{vmatrix}2 & 1 \\\\ 0 & 1\\end{vmatrix} \\\\  & =-(2-0) \\\\  & =-2.\\end{aligned}\n$$\n\n \n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={\\left(\\frac{∂(u,v,w)}{∂(x,y,z)}\\right)}^{-1}=-\\frac{1}{2}.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}(2x+z)\\operatorname{ln}⁡({x}^{2}+y)\\,dV & ={∭}_{Δ}\\operatorname{sin}⁡u\\operatorname{cos}⁡v\\cdot |\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={∭}_{Δ}v\\operatorname{ln}⁡u\\cdot |-\\frac{1}{2}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={\\int }_{1}^{2}{\\int }_{-1}^{6}{\\int }_{1}^{4}\\,\\frac{1}{2}v\\operatorname{ln}⁡u\\,\\,dw\\,dv\\,du\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375214 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "422a9438-abe1-5c55-9ce6-48992d025b3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{31}{16}" :db/id #edb/ref 17592186375216} {:answer/id #uuid "55b2ef29-4c64-5208-b231-493dd0d99e42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{31}{32}" :db/id #edb/ref 17592186375217} {:answer/id #uuid "d38953c0-d8ac-5f78-b9aa-bbe42ba7fcb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{63}{64}" :db/id #edb/ref 17592186375218} {:answer/id #uuid "16513a0b-e2a2-51c9-93af-f7d244d5921b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{63}{32}" :db/id #edb/ref 17592186375219} {:answer/id #uuid "b581dad9-71c8-5464-8ccf-339c4aad013e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{63}{16}" :db/id #edb/ref 17592186375220}] :answer-field/correct {:answer/id #uuid "16513a0b-e2a2-51c9-93af-f7d244d5921b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{63}{32}" :db/id #edb/ref 17592186375219} :answer-field/id #uuid "36625350-cf95-5b46-804d-7df1ad8a967c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375215}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eea9417e-29cb-566f-8b4b-965dab594289" :question/math-academy-id "q-67141" :question/problem "Evaluate the geometric series ${\\sum }_{n=1}^{6}\\frac{1}{{2}^{n-1}}.$" :question/worked-solution "Notice that we can rewrite the series as follows:\n\n$$\n{\\sum }_{n=1}^{6}\\frac{1}{{2}^{n-1}}={\\sum }_{n=1}^{6}{\\left(\\frac{1}{2}\\right)}^{n-1}\n$$\n\nSince the above series is in the form ${\\sum }_{n=1}^{N}{a}_{1}{r}^{n-1},$ it is a geometric series. \n\nTo determine the sum, we use the formula for the sum ${S}_{N}$ of a geometric series.\n\n$$\n{S}_{N}={a}_{1}\\frac{(1-{r}^{N})}{1-r}\n$$\n\nIn this case, ${a}_{1}=1,$ $r=\\frac{1}{2}$ and $N=6.$ If we substitute these values into the above formula, we obtain the following:\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{6}\\frac{1}{{2}^{n-1}} & =1\\cdot \\frac{[1-{\\left(\\frac{1}{2}\\right)}^{6}]}{(1-\\frac{1}{2})} \\\\  & =\\frac{\\left(\\frac{63}{64}\\right)}{\\left(\\frac{1}{2}\\right)} \\\\  & =\\frac{63}{32}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375221 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad41d651-3be0-5db6-8319-017843ca96c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23.972" :db/id #edb/ref 17592186375223} {:answer/id #uuid "ff8f684a-6570-5f41-9112-e0a0d2d8edf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35.951" :db/id #edb/ref 17592186375224} {:answer/id #uuid "b611b28a-b3d5-586d-ae2a-0ddfb4db0a6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17.988" :db/id #edb/ref 17592186375225} {:answer/id #uuid "41b32af4-5012-5aa5-98f4-d2eb91bbcb40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17.049" :db/id #edb/ref 17592186375226} {:answer/id #uuid "016c6493-7992-5112-b334-33c9029f3d4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24.030" :db/id #edb/ref 17592186375227}] :answer-field/correct {:answer/id #uuid "ff8f684a-6570-5f41-9112-e0a0d2d8edf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35.951" :db/id #edb/ref 17592186375224} :answer-field/id #uuid "6f3d7078-bb33-5108-97c3-04fe446f1d0a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375222}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8fd9dda9-8f9c-5be8-b9a2-64b3fd691302" :question/math-academy-id "q-67149" :question/problem "Determine the value of the geometric series ${\\sum }_{n=0}^{5}8{\\left(\\frac{1}{3}\\right)}^{n-1}$ rounded to $3$ decimal places." :question/worked-solution "Since the given series is in the form $\\sum a{r}^{n-1},$ it is a geometric series. Notice that the index starts from $n=0$ instead of $n=1.$\n\nTo determine the sum, we use the formula for the sum ${S}_{N}$ of a geometric series.\n\n$$\n{S}_{N}={a}_{0}\\frac{(1-{r}^{N})}{1-r}\n$$\n\nIn this case, $r=\\frac{1}{3}.$ Also, note that $N=6,$ since there are $6$ terms in total.\n\nThe formula for the $n$th term of the series is\n\n$$\n{a}_{n}=8{\\left(\\frac{1}{3}\\right)}^{n-1},\n$$\n\nand so the first term ${a}_{0}$ is given by\n\n$$\n\\begin{aligned}{a}_{0} & =8{\\left(\\frac{1}{3}\\right)}^{0-1} \\\\  & =8{\\left(\\frac{1}{3}\\right)}^{-1} \\\\  & =8\\left(\\frac{3}{1}\\right) \\\\  & =24.\\end{aligned}\n$$\n\nIf we substitute ${a}_{0}=24,r=\\frac{1}{3}$ and $N=6$ into the formula for ${S}_{N}$, we obtain the following:\n\n$$\n\\begin{aligned}{S}_{6} & =24\\cdot \\frac{[1-{\\left(\\frac{1}{3}\\right)}^{6}]}{(1-\\frac{1}{3})} \\\\  & =24\\cdot \\frac{[1-{\\left(\\frac{1}{3}\\right)}^{6}]}{\\left(\\frac{2}{3}\\right)} \\\\  & =36\\cdot \\left(\\frac{728}{729}\\right) \\\\  & ≈35.951\\end{aligned}\n$$\n\nNote that the final answer has been rounded to three decimal places."} {:db/id #edb/ref 17592186375240 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e74e64f3-951a-56f6-942b-1a8b1e4d9ef7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186375242} {:answer/id #uuid "718d61ae-eb0f-5e17-9838-c30510f38774" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{9}" :db/id #edb/ref 17592186375243} {:answer/id #uuid "34a78b9a-d45a-5d3a-afae-f5256d6c28d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186375244} {:answer/id #uuid "bd479ca7-9b45-5b70-8c35-7d3d5868fb0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{49}{8}" :db/id #edb/ref 17592186375245} {:answer/id #uuid "c8c920ca-c80b-53f5-b4d8-a691b2d66eae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{343}{8}" :db/id #edb/ref 17592186375246}] :answer-field/correct {:answer/id #uuid "c8c920ca-c80b-53f5-b4d8-a691b2d66eae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{343}{8}" :db/id #edb/ref 17592186375246} :answer-field/id #uuid "332e93fa-094d-5b37-a81d-6792b8481d65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375241}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0d02ca8e-0073-596b-95a3-b3760537618d" :question/math-academy-id "q-67216" :question/problem "If $k(1+{\\left(\\frac{1}{7}\\right)}^{13})$ is the sum of the first $13$ terms of the geometric series $49-7+1-⋯,$ then $k=$" :question/worked-solution "Given a geometric series, the sum of the first $N$ terms is given by the formula\n\n$$\n{S}_{N}={a}_{1}\\frac{(1-{r}^{N})}{1-r},\n$$\n\nwhere ${a}_{1}$ is the first term of the series and $r$ is the common ratio.\n\nIn our case, ${a}_{1}=49.$ To find the value of $r,$ we find the ratio of the first two terms in the series:\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{-7}{49}=-\\frac{1}{7}\n$$\n\nIf we substitute ${a}_{1}=49,N=13$ and $r=-\\frac{1}{7}$ into our formula, we obtain:\n\n$$\n\\begin{aligned}{S}_{13} & =49\\cdot \\frac{(1-{\\left(-\\frac{1}{7}\\right)}^{13})}{(1-\\left(-\\frac{1}{7}\\right))} \\\\  & =49\\cdot \\frac{(1+{\\left(\\frac{1}{7}\\right)}^{13})}{(1+\\frac{1}{7})} \\\\  & =49\\cdot \\frac{(1+{\\left(\\frac{1}{7}\\right)}^{13})}{\\left(\\frac{8}{7}\\right)} \\\\  & =\\frac{49}{\\left(\\frac{8}{7}\\right)}\\cdot (1+{\\left(\\frac{1}{7}\\right)}^{13}) \\\\  & =\\frac{343}{8}\\cdot (1+{\\left(\\frac{1}{7}\\right)}^{13})\\end{aligned}\n$$\n\nNow, comparing the expression above with $k(1+{\\left(\\frac{1}{7}\\right)}^{13}),$ we obtain $k=\\frac{343}{8}.$"} {:db/id #edb/ref 17592186375247 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42646f71-0c4c-5d23-a5af-abdd43232727" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{5}3\\cdot {\\left(\\frac{1}{3}\\right)}^{n}" :db/id #edb/ref 17592186375249} {:answer/id #uuid "34276511-6372-58a2-8e4d-dcf21c95f17c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{5}\\frac{1}{2}\\cdot {\\left(\\frac{1}{3}\\right)}^{n}" :db/id #edb/ref 17592186375250} {:answer/id #uuid "28475846-130e-512d-ae62-55d708d3ab72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{5}\\frac{1}{3}\\cdot {\\left(\\frac{1}{2}\\right)}^{n}" :db/id #edb/ref 17592186375251} {:answer/id #uuid "5fd9023b-6438-5a2b-a59d-7bed56ab5c82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{5}\\frac{3}{2}\\cdot {\\left(\\frac{1}{3}\\right)}^{n}" :db/id #edb/ref 17592186375252} {:answer/id #uuid "acb989fe-eb26-5b30-a9d8-e53338d3173f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{5}\\frac{1}{2}\\cdot {\\left(\\frac{1}{6}\\right)}^{n}" :db/id #edb/ref 17592186375253}] :answer-field/correct {:answer/id #uuid "5fd9023b-6438-5a2b-a59d-7bed56ab5c82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{5}\\frac{3}{2}\\cdot {\\left(\\frac{1}{3}\\right)}^{n}" :db/id #edb/ref 17592186375252} :answer-field/id #uuid "c7de89df-8af0-5e14-8f27-0270552ac147" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375248}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8fef8761-7152-5796-ba84-dc23d9280957" :question/math-academy-id "q-67271" :question/problem "The geometric series $\\frac{1}{2}+\\frac{1}{6}+\\frac{1}{18}+\\frac{1}{54}+\\frac{1}{162}$ can be expressed using sigma notation as" :question/worked-solution "First, we must express the given series in the form\n\n$$\n{\\sum }_{n=1}^{N}{a}_{1}{r}^{n-1},\n$$\n\nwhere ${a}_{1}$ denotes the first term of the series, $r$ denotes the common ratio, and $N$ denotes the number of terms in the series. In this case, ${a}_{1}=\\frac{1}{2}$ and $N=5.$\n\nTo find $r,$ we calculate the ratio of the first two terms in the series:\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{\\left(\\frac{1}{6}\\right)}{\\left(\\frac{1}{2}\\right)}=\\frac{1}{3}\n$$\n\nHence, expressing the geometric series given in sigma notation, we obtain:\n\n$$\n\\frac{1}{2}+\\frac{1}{6}+\\frac{1}{18}+\\frac{1}{54}+\\frac{1}{162}={\\sum }_{n=1}^{5}\\frac{1}{2}\\cdot {\\left(\\frac{1}{3}\\right)}^{n-1}\\,\\,\n$$\n\nFinally, we can simplify the above series using the laws of exponents, as follows:\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{5}\\frac{1}{2}\\cdot {\\left(\\frac{1}{3}\\right)}^{n-1} & ={\\sum }_{n=1}^{5}\\frac{1}{2}\\cdot {\\left(\\frac{1}{3}\\right)}^{n}\\cdot {\\left(\\frac{1}{3}\\right)}^{-1} \\\\  & ={\\sum }_{n=1}^{5}\\frac{1}{2}\\cdot {\\left(\\frac{1}{3}\\right)}^{-1}\\cdot {\\left(\\frac{1}{3}\\right)}^{n} \\\\  & ={\\sum }_{n=1}^{5}\\frac{1}{2}\\cdot \\frac{3}{1}\\cdot {\\left(\\frac{1}{3}\\right)}^{n} \\\\  & ={\\sum }_{n=1}^{5}\\frac{3}{2}\\cdot {\\left(\\frac{1}{3}\\right)}^{n}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375261 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "caf1e3e7-dd69-5178-a43a-7d236a7ead4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{4}2\\cdot (-3)^{n-1}" :db/id #edb/ref 17592186375263} {:answer/id #uuid "840a6646-fa37-5956-a140-866602d6dfa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{4}\\left(-\\frac{1}{2}\\right)\\cdot (-3)^{n-1}" :db/id #edb/ref 17592186375264} {:answer/id #uuid "23fa5a66-de66-5989-8e3b-9c3a35d9b9ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{5}(-3)\\cdot (-2)^{n-1}" :db/id #edb/ref 17592186375265} {:answer/id #uuid "b04afb1f-a2b1-5948-952a-0f7de5cebee0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{5}5\\cdot (-2)^{n-1}" :db/id #edb/ref 17592186375266} {:answer/id #uuid "f4450bf5-fc33-502b-a584-559089025cd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{4}(-1)\\cdot (-3)^{n-1}" :db/id #edb/ref 17592186375267}] :answer-field/correct {:answer/id #uuid "f4450bf5-fc33-502b-a584-559089025cd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{4}(-1)\\cdot (-3)^{n-1}" :db/id #edb/ref 17592186375267} :answer-field/id #uuid "e8dbe4b3-35bb-5607-a797-91a680bdc0ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375262}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f59d3017-d458-58bb-b6ca-316e620937af" :question/math-academy-id "q-67286" :question/problem "The geometric series $-1+3-9+27$ can be expressed using sigma notation as" :question/worked-solution "We must express the given series in the form\n\n$$\n{\\sum }_{n=1}^{N}{a}_{1}{r}^{n-1},\n$$\n\nwhere ${a}_{1}$ denotes the first term of the series, $r$ denotes the common ratio, and $N$ denotes the number of terms in the series. In this case, ${a}_{1}=-1$ and $N=4.$\n\nTo find $r,$ we calculate the ratio of the first two terms in the series:\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{3}{-1}=-3\n$$\n\nTherefore, expressing the given geometric series in sigma notation, we obtain:\n\n$$\n\\begin{aligned}-1+3-9+27 & ={\\sum }_{n=1}^{4}(-1)\\cdot (-3)^{n-1}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375268 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dec5e78-cd7a-53b8-920b-36274cdfd470" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{32}\\left(-\\frac{2}{3}\\right){(-2)}^{n}" :db/id #edb/ref 17592186375270} {:answer/id #uuid "2ec8aedf-769b-5712-9222-b4e5bbad549e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{32}\\frac{3}{4}{(-2)}^{n}" :db/id #edb/ref 17592186375271} {:answer/id #uuid "35f4702b-a7ed-5f74-b599-75ffd1a41fa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{32}\\left(-\\frac{2}{3}\\right){(-4)}^{n}" :db/id #edb/ref 17592186375272} {:answer/id #uuid "87effe58-3e44-5d64-be9c-54b52e9519fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{32}\\frac{2}{3}{(-4)}^{n}" :db/id #edb/ref 17592186375273} {:answer/id #uuid "b90963dd-eb96-50a2-8b81-3a6fdbe2e2f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{32}\\left(-\\frac{3}{2}\\right){(-4)}^{n}" :db/id #edb/ref 17592186375274}] :answer-field/correct {:answer/id #uuid "b90963dd-eb96-50a2-8b81-3a6fdbe2e2f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{32}\\left(-\\frac{3}{2}\\right){(-4)}^{n}" :db/id #edb/ref 17592186375274} :answer-field/id #uuid "5b23abb7-858f-57e7-8eb7-d5bea7c7296f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375269}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "adf9325b-7be0-57c9-a785-785c14cc0507" :question/math-academy-id "q-67352" :question/problem "The first term of a geometric sequence is $6$ and the common ratio is $-4.$ Written in sigma notation, what is the sum of the first $32$ terms?" :question/worked-solution "First, we must express the series in the form\n\n$$\n{\\sum }_{n=1}^{N}{a}_{1}{r}^{n-1},\n$$\n\nwhere ${a}_{1}$ denotes the first term of the series, $r$ denotes the common ratio, and $N$ denotes the number of terms in the series. In this case, ${a}_{1}=6,$ $r=-4$ and $N=32.$\n\nExpressing the geometric series in sigma notation, we obtain:\n\n$$\n{S}_{32}={\\sum }_{n=1}^{32}6{(-4)}^{n-1}\\,\\,\n$$\n\nFinally, we can simplify the above using the laws of exponents, as follows:\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{32}6{(-4)}^{n-1} & ={\\sum }_{n=1}^{32}6{(-4)}^{n}{(-4)}^{-1} \\\\  & ={\\sum }_{n=1}^{32}6{(-4)}^{n}\\left(-\\frac{1}{4}\\right) \\\\  & ={\\sum }_{n=1}^{32}\\left(-\\frac{3}{2}\\right){(-4)}^{n}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375356 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d569601f-2e83-55e4-bf9b-33b39d85a49a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,364" :db/id #edb/ref 17592186375358} {:answer/id #uuid "c7306506-565b-5e9c-8591-725f360ad0c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,588" :db/id #edb/ref 17592186375359} {:answer/id #uuid "13139b6d-eb66-5f6a-a032-b922428b86db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,950" :db/id #edb/ref 17592186375360} {:answer/id #uuid "2b4de538-5c20-5388-9585-166ed79d3e28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,092" :db/id #edb/ref 17592186375361} {:answer/id #uuid "31da1535-19ee-5cea-afda-ff19f9f4ded5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,048" :db/id #edb/ref 17592186375362}] :answer-field/correct {:answer/id #uuid "2b4de538-5c20-5388-9585-166ed79d3e28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,092" :db/id #edb/ref 17592186375361} :answer-field/id #uuid "537635d0-453e-59fe-9d76-218026b478b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375357}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5f2d7da9-9fa4-5eec-8b06-94de7d4664b1" :question/math-academy-id "q-75460" :question/problem "Evaluate the series ${\\sum }_{n=1}^{6}\\frac{1}{5}(4)^{n}.$" :question/worked-solution "Since the given series is in the form ${\\sum }_{n=1}^{N}a{r}^{n},$ it is a geometric series. \n\nTo determine the sum, we use the formula for the sum ${S}_{N}$ of a geometric series.\n\n$$\n{S}_{N}={a}_{1}\\frac{(1-{r}^{N})}{1-r}\n$$\n\nIn this case, $r=4$ and $N=6.$ We need to figure out the value of ${a}_{1}.$\n\nThe formula for the $n$th term of the series is\n\n$$\n{a}_{n}=\\frac{1}{5}(4)^{n},\n$$\n\nand therefore we can calculate the first term ${a}_{1}$ as follows:\n\n$$\n\\begin{aligned}{a}_{1} & =\\frac{1}{5}(4)^{1}=\\frac{4}{5}\\end{aligned}\n$$\n\nIf we substitute ${a}_{1}=\\frac{4}{5},r=4$ and $N=6$ into the formula for ${S}_{N}$, we obtain the following:\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{6}\\frac{1}{5}(4)^{n} & =\\frac{4}{5}\\cdot \\frac{(1-{4}^{6})}{1-4} \\\\  & =\\frac{4}{5}\\left(\\frac{-4\\,095}{-3}\\right) \\\\  & =\\frac{4}{5}(1\\,365) \\\\  & =1\\,092.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375377 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f172a5b5-996d-506a-bf07-7fd31d503d25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\text{d}a+\\sqrt{5}\\,\\text{d}b" :db/id #edb/ref 17592186375379} {:answer/id #uuid "e589fa1b-f7a9-5032-b372-7c20d70d3e2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}\\,\\text{d}a+2\\,\\text{d}b" :db/id #edb/ref 17592186375380} {:answer/id #uuid "0a68bd48-074b-57ce-a486-1e877a951018" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\text{d}a+5\\,\\text{d}b" :db/id #edb/ref 17592186375381} {:answer/id #uuid "51678375-5ec7-5aa4-a2a6-d806fac421bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,\\text{d}a+8\\,\\text{d}b" :db/id #edb/ref 17592186375382} {:answer/id #uuid "2f960580-30d7-5427-afba-d3a0cbacbf2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{d}a+4\\,\\text{d}b" :db/id #edb/ref 17592186375383}] :answer-field/correct {:answer/id #uuid "2f960580-30d7-5427-afba-d3a0cbacbf2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{d}a+4\\,\\text{d}b" :db/id #edb/ref 17592186375383} :answer-field/id #uuid "4111c01f-9207-54e9-8850-d4e0f1991e91" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375378}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b1c3c795-7c5d-549b-81c7-5bd23b4b11f6" :question/math-academy-id "q-79744" :question/problem "Given a rectangle, find the differential $\\text{d}S$ for the area $S$ if the lengths of sides are $a=4$ and $b=5.$" :question/worked-solution "The area of the rectangle is $S=ab.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}S(a,b) & =\\left(\\frac{∂S}{∂a}\\right)\\,\\text{d}a+\\left(\\frac{∂S}{∂b}\\right)\\,\\text{d}b \\\\  & =b\\,\\text{d}a+a\\,\\text{d}b\\end{aligned}\n$$\n\nFor $a=4$ and $b=5,$ the differential is\n\n$$\n\\begin{aligned}\\text{d}S(4,5) & =5\\,\\text{d}a+4\\,\\text{d}b.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375384 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52b7f183-ac89-5adb-9509-67e6410e2eda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,\\text{d}r+40\\,\\text{d}l" :db/id #edb/ref 17592186375386} {:answer/id #uuid "3e9dd3ed-eaf8-543f-9cc9-8a1e7cc69c1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\pi \\,\\text{d}r+10\\pi \\,\\text{d}l" :db/id #edb/ref 17592186375387} {:answer/id #uuid "8ad85924-7918-597c-a6e9-8076e5041dd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,\\text{d}r+6\\,\\text{d}l" :db/id #edb/ref 17592186375388} {:answer/id #uuid "6c9e0aee-c171-578f-be62-2d9fa754d026" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40\\pi \\,\\text{d}r+12\\pi \\,\\text{d}l" :db/id #edb/ref 17592186375389} {:answer/id #uuid "61520cb3-6fa1-591d-aec4-9e23c7e259a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\pi \\,\\text{d}r+6\\pi \\,\\text{d}l" :db/id #edb/ref 17592186375390}] :answer-field/correct {:answer/id #uuid "61520cb3-6fa1-591d-aec4-9e23c7e259a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\pi \\,\\text{d}r+6\\pi \\,\\text{d}l" :db/id #edb/ref 17592186375390} :answer-field/id #uuid "894bb581-a8fd-5805-ac2d-24aef358fe0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375385}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ddfbfeb1-47d1-5e4a-929c-ad72e52c8b4d" :question/math-academy-id "q-79959" :question/problem "Given a right cone, find the differential $\\text{d}S$ for the lateral surface area $S$ of the right cone if the base radius is $r=6,$ and the slant height is $l=10.$" :question/worked-solution "The  lateral surface area of the right cone is $S=\\pi rl.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}S(rl) & =\\left(\\frac{∂S}{∂r}\\right)\\,\\text{d}r+\\left(\\frac{∂S}{∂l}\\right)\\,\\text{d}l \\\\  & =\\pi l\\,\\text{d}r+\\pi r\\,\\text{d}l\\end{aligned}\n$$\n\nFor $r=6,$ and $l=10,$  the differential is\n\n$$\n\\begin{aligned}\\text{d}S(6,10) & =10\\pi \\,\\text{d}r+6\\pi \\,\\text{d}l.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375495 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0881d141-176a-5207-829e-e7fcf9748ea2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{-1}^{1}(v-u)^{4}\\,du\\,dv" :db/id #edb/ref 17592186375497} {:answer/id #uuid "72802f78-8fa2-5be5-8cb9-94054dadb960" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{-1}^{1}({v}^{2}-{u}^{2})\\,du\\,dv" :db/id #edb/ref 17592186375498} {:answer/id #uuid "9d50078b-ccc0-5312-be32-aa00de941511" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{1}{\\int }_{-1}^{1}(v-u)^{2}\\,du\\,dv" :db/id #edb/ref 17592186375499} {:answer/id #uuid "ce22a068-82fa-5eda-a3a4-b436e880bc4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{1}{\\int }_{-1}^{1}({v}^{2}-{u}^{2})\\,du\\,dv" :db/id #edb/ref 17592186375500} {:answer/id #uuid "f22feb1c-862a-595f-aaba-980169e06dd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{0}^{1}{\\int }_{-1}^{1}(v-u)^{2}\\,du\\,dv" :db/id #edb/ref 17592186375501}] :answer-field/correct {:answer/id #uuid "72802f78-8fa2-5be5-8cb9-94054dadb960" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{-1}^{1}({v}^{2}-{u}^{2})\\,du\\,dv" :db/id #edb/ref 17592186375498} :answer-field/id #uuid "4b052ab4-b874-5259-8af3-5e39e362471e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375496}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ff0203f2-b0b4-5368-8eaf-f5cdf929fd73" :question/math-academy-id "q-82808" :question/problem "Consider the region $D$ in the $xy$-plane, given by\n\n$$\nD=\\{(x,y)\\,:\\,-1\\le y-x\\le 1,\\,0\\le x+y\\le 1\\}.\n$$\n\nBy performing the change of variables $u=y-x$ and $v=x+y,$ the integral\n\n$$\n{∬}_{D}8xy\\,dx\\,dy\n$$\n\ncan be written in terms of $u$ and $v$ as" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\text{ }dx\\,dy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))|\\frac{∂(x,y)}{∂(u,v)}|du\\,dv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=y-x,\\,v=x+y\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,-1\\le u\\le 1,\\,0\\le v\\le 1\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-1 & 1 \\\\ 1 & \\text{ }\\text{ }1\\end{vmatrix} \\\\  & =-2.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=-\\frac{1}{2}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\nIn this case, we first need to solve the transformation equations\n\n$$\nu=y-x,\\,v=x+y\n$$\n\n \nfor $x$ and $y$, which gives\n\n$$\nx=\\frac{v-u}{2},\\,y=\\frac{v+u}{2}.\n$$\n\n \n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}8xy\\,dx\\,dy & ={∬}_{Δ}8\\left(\\frac{v-u}{2}\\right)\\left(\\frac{v+u}{2}\\right)|\\frac{∂(x,y)}{∂(u,v)}|\\text{d}u\\,\\text{d}v \\\\  & ={∬}_{Δ}2({v}^{2}-{u}^{2})|\\frac{∂(x,y)}{∂(u,v)}|\\text{d}u\\,\\text{d}v \\\\  & ={∬}_{Δ}2({v}^{2}-{u}^{2})|-\\frac{1}{2}|\\text{d}u\\,\\text{d}v \\\\  & ={\\int }_{0}^{1}{\\int }_{-1}^{1}({v}^{2}-{u}^{2})\\,du\\,dv.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375502 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "661f11a2-58e2-5323-aed0-4c84d298b7a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{4}{\\int }_{0}^{2}{e}^{3u-2v}\\,du\\,dv" :db/id #edb/ref 17592186375504} {:answer/id #uuid "ac200449-dc33-5fa1-b080-2757eb77e01e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{4}{\\int }_{0}^{2}{e}^{2u-3v}\\,du\\,dv" :db/id #edb/ref 17592186375505} {:answer/id #uuid "32bc657c-6f00-59b6-8ae4-b48679d4067b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{4}{\\int }_{0}^{2}{e}^{2u-v}\\,du\\,dv" :db/id #edb/ref 17592186375506} {:answer/id #uuid "abd6ec5f-e42a-51e9-a175-fd591e2adebf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{4}{\\int }_{0}^{2}{e}^{u+v}\\,du\\,dv" :db/id #edb/ref 17592186375507} {:answer/id #uuid "624cfbb7-2e59-5fce-9fc2-e4f5ba306b77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{0}^{4}{\\int }_{0}^{2}{e}^{3u-2v}\\,du\\,dv" :db/id #edb/ref 17592186375508}] :answer-field/correct {:answer/id #uuid "ac200449-dc33-5fa1-b080-2757eb77e01e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{4}{\\int }_{0}^{2}{e}^{2u-3v}\\,du\\,dv" :db/id #edb/ref 17592186375505} :answer-field/id #uuid "50dace88-55f0-5aaf-a1fc-7d3cc1e32c2f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375503}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d437ff63-9f7b-5463-a5bf-dc3f2e150b31" :question/math-academy-id "q-82827" :question/problem "Consider the region $D$ in the $xy$-plane, given by\n\n$$\nD={(x,y)\\,:\\,0\\le 2x+5y\\le 2,\\,0\\le x+3y\\le 4}.\n$$\n\nBy performing the change of variables $u=2x+5y$ and $v=x+3y,$ the integral\n\n$$\n{∬}_{D}{e}^{x+y}\\,dx\\,dy\n$$\n\ncan be written in terms of $u$ and $v$ as" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\,dx\\,dy={∬}_{Δ}f(x(u,v),y(u,v))|\\frac{∂(x,y)}{∂(u,v)}|du\\,dv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=2x+5y,\\,v=x+3y\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & ={(u,v)\\,:\\,0\\le u\\le 2,\\,0\\le v\\le 4}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & 5 \\\\ 1 & \\text{ }\\text{ }3\\end{vmatrix} \\\\  & =1.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=1.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\nIn this case, we first need to solve the transformation equations\n\n$$\nu=2x+5y,\\,v=x+3y\n$$\n\n \nfor $x$ and $y$, which gives\n\n$$\nx=3u-5v,\\,y=2v-u.\n$$\n\n \n\nNow, performing the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}{e}^{x+y}\\,dx\\,dy & ={∬}_{Δ}{e}^{3u-5v+2v-u}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\,\\text{d}v \\\\  & ={∬}_{Δ}{e}^{2u-3v}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\,\\text{d}v \\\\  & ={∬}_{Δ}{e}^{2u-3v}\\cdot |1|\\,\\text{d}u\\,\\text{d}v \\\\  & ={\\int }_{0}^{4}{\\int }_{0}^{2}{e}^{2u-3v}\\,du\\,dv.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375509 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b519e50-b326-56a3-8360-01cf01bef0a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{\\int }_{-1}^{3}{\\int }_{-4}^{-1}{u}^{2}\\,dv\\,du" :db/id #edb/ref 17592186375511} {:answer/id #uuid "8717345d-af4e-5f8b-876a-46ab0b5392c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}{\\int }_{-1}^{3}{\\int }_{-4}^{-1}(u+v)^{2}\\,dv\\,du" :db/id #edb/ref 17592186375512} {:answer/id #uuid "de05559f-528d-50d8-9fa6-bf9cc362a558" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}{\\int }_{-1}^{3}{\\int }_{-4}^{-1}(u+v)^{2}\\,dv\\,du" :db/id #edb/ref 17592186375513} {:answer/id #uuid "4e4bc111-f102-5feb-91f1-f0edd3cc5425" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}{\\int }_{-1}^{3}{\\int }_{-4}^{-1}{u}^{2}\\,dv\\,du" :db/id #edb/ref 17592186375514} {:answer/id #uuid "8ecb057f-1869-565e-8e7e-c9b2d50df235" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}{\\int }_{-1}^{3}{\\int }_{-4}^{-1}{u}^{2}\\,dv\\,du" :db/id #edb/ref 17592186375515}] :answer-field/correct {:answer/id #uuid "4e4bc111-f102-5feb-91f1-f0edd3cc5425" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}{\\int }_{-1}^{3}{\\int }_{-4}^{-1}{u}^{2}\\,dv\\,du" :db/id #edb/ref 17592186375514} :answer-field/id #uuid "da395623-3256-578e-8977-74807708542d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375510}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cab9f14a-bb15-51f5-bbda-2778b7330c33" :question/math-academy-id "q-83647" :question/problem "Consider the region $D$ in the $xy$-plane, given by\n\n$$\nD=\\{(x,y)\\,:\\,-1\\le x+y\\le 3,\\,-4\\le y-x\\le -1\\}.\n$$\n\nBy performing the change of variables $u=x+y$ and $v=y-x,$ the integral\n\n$$\n{∬}_{D}3(x+y)^{2}\\,dx\\,dy\n$$\n\ncan be written in terms of $u$ and $v$ as" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\,dx\\,dy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))|\\frac{∂(x,y)}{∂(u,v)}|du\\,dv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=x+y,\\,v=y-x\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,-1\\le u\\le 3,\\,-4\\le v\\le -1\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & 1 \\\\ -1 & \\text{ }\\text{ }1\\end{vmatrix} \\\\  & =2.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=\\frac{1}{2}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}3(x+y)^{2}\\,dx\\,dy & ={∬}_{Δ}3{u}^{2}|\\frac{∂(x,y)}{∂(u,v)}|\\text{d}u\\,\\text{d}v \\\\  & ={∬}_{Δ}3{u}^{2}|\\frac{1}{2}|\\text{d}u\\,\\text{d}v \\\\  & =\\frac{3}{2}{\\int }_{-1}^{3}{\\int }_{-4}^{-1}{u}^{2}\\,dv\\,du.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375516 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44e18b50-5a34-5995-980b-2b315b3a6f0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186375518} {:answer/id #uuid "594f9a4a-d6e9-5df8-a308-2eb4cbda2ba5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186375519} {:answer/id #uuid "01cb4d30-859b-537e-bd09-5b716f143dff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186375520} {:answer/id #uuid "047a39d6-26a5-5925-9b60-74ca9ec1ef3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186375521} {:answer/id #uuid "88731088-8329-5a12-8959-6718187bcd65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186375522}] :answer-field/correct {:answer/id #uuid "047a39d6-26a5-5925-9b60-74ca9ec1ef3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186375521} :answer-field/id #uuid "83dc21d0-96ad-5f47-bb56-3352df831f55" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375517}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "03366686-a1a7-5aa1-bce5-fc561e685ebd" :question/math-academy-id "q-83651" :question/problem "Use a change of variables to evaluate the double integral \n\n$$\n{∬}_{D}x\\operatorname{sin}⁡(x+y)\\,dxdy,\n$$\n\nwhere $D={(x,y)\\,:\\,1\\le x\\le 3,\\,|x+y|\\le \\frac{\\pi }{2}}.$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\text{ }dxdy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))\\,|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find a suitable change of variables.\n\nThe inequalities that define the region $D,$\n\n$$\n1\\le x\\le 3,\\,-\\frac{\\pi }{2}\\le x+y\\le \\frac{\\pi }{2},\n$$\n\nsuggest that we use the change of variables \n\n$$\nu=x\\,\\text{and}\\,v=x+y.\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & ={(u,v)\\,:\\,1\\le u\\le 3,\\,-\\frac{\\pi }{2}\\le v\\le \\frac{\\pi }{2}}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & \\text{ }\\text{ }0 \\\\ 1 & 1\\end{vmatrix} \\\\  & =1.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=1.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Perform the change of variables, and evaluate the integral:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}x\\operatorname{sin}⁡(x+y)\\,\\text{d}x\\text{d}y & ={∬}_{Δ}u\\operatorname{sin}⁡v\\,|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}u\\operatorname{sin}⁡v\\,|1|\\,\\text{d}u\\text{d}v \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{sin}⁡v[{\\int }_{1}^{3}u\\,du]dv \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{sin}⁡v{[\\frac{{u}^{2}}{2}]}_{1}^{3}dv \\\\  & =4{\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{sin}⁡v\\,dv \\\\  & =4[-\\operatorname{cos}⁡v]_{-\\pi /2}^{\\pi /2} \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375544 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "463b2dfe-12dc-5d8b-b485-bbdc7bf1bfc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,{\\text{ cm}}^{2}\\text{/min}" :db/id #edb/ref 17592186375546} {:answer/id #uuid "a530aa11-ef3e-5bcd-8caf-52f9a0d11205" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20\\,{\\text{ cm}}^{2}\\text{/min}" :db/id #edb/ref 17592186375547} {:answer/id #uuid "fdb143ef-2ae2-5c0f-ad9f-f168411366e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,{\\text{ cm}}^{2}\\text{/min}" :db/id #edb/ref 17592186375548} {:answer/id #uuid "df3affe2-648f-55b4-a71c-2fce585166f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15\\,{\\text{ cm}}^{2}\\text{/min}" :db/id #edb/ref 17592186375549} {:answer/id #uuid "5406e375-01d7-556f-a3db-50d6681e14cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,{\\text{ cm}}^{2}\\text{/min}" :db/id #edb/ref 17592186375550}] :answer-field/correct {:answer/id #uuid "fdb143ef-2ae2-5c0f-ad9f-f168411366e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,{\\text{ cm}}^{2}\\text{/min}" :db/id #edb/ref 17592186375548} :answer-field/id #uuid "05433573-3744-5b22-9ee4-30694c12c8a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375545}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c144d86d-616b-51ad-b91f-c522e265b17b" :question/math-academy-id "q-86066" :question/problem "![](images/b2/b2158da0465250d14ce47909e7f1ef918c06c9721547a3533e1c65797cc9fab8.png)\n\nThe length of a rectangular prism is decreasing at a rate of $3\\,\\text{cm}\\text{/min},$ the width is increasing at a rate of $5\\,\\text{cm}\\text{/min},$ and the $5\\,\\text{cm}$ height does not change. How fast is the surface area of the rectangular prism decreasing when its dimensions are $3\\,\\text{cm}$ in length and $10\\,\\text{cm}$ in width?" :question/worked-solution "Let $x,y,z$ be the dimensions of the solid, and let $V$ be its volume. We are given that \n\n$$\n\\begin{aligned}x & =3\\,\\text{cm}, \\\\ y & =10\\,\\text{cm}, \\\\ z & =5\\,\\text{cm}, \\\\ \\frac{\\text{d}x}{\\text{d}t} & =-3\\,\\text{cm}\\text{/min}, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =5\\,\\text{cm}\\text{/min}.\\end{aligned}\n$$\n\nWe would like to find $\\frac{\\text{d}S}{\\text{d}t}.$\n\nWe want to find the rate of change of $S$ knowing the rate of change of $x$ and $y.$ So, we start with the formula for the surface area of the rectangular prism:\n\n$$\nS=2xz+2xy+2yz\n$$\n\nSince $z=5\\,\\text{cm}$ is not changing, we get\n\n$$\nS=10x+2xy+10y.\n$$\n\nNow, we differentiate with respect to time using the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}S}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(10x+2xy+10y) \\\\ \\frac{\\text{d}S}{\\text{d}t} & =(2x+10)\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)+(10+2y)\\left(\\frac{\\text{d}x}{\\text{d}t}\\right).\\end{aligned}\n$$\n\nWe can now plug in the known values into the above expression. This gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}S}{\\text{d}t} & =(2\\cdot 3+10)(5)+(10+2\\cdot 10)(-3) \\\\  & =80-90 \\\\  & =-10\\,{\\text{cm}}^{2}\\text{/min}.\\end{aligned}\n$$\n\nTherefore, the surface area of the rectangular prism is decreasing at a rate of $10\\,{\\text{cm}}^{2}/\\text{min}.$"} {:db/id #edb/ref 17592186375624 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b587af18-df81-5db4-88ae-e75eb49804be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}={\\left(\\frac{x}{2}\\right)}^{2}-1" :db/id #edb/ref 17592186375626} {:answer/id #uuid "42dbc938-1217-5910-be74-c7acaaa09ee3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}={\\left(\\frac{2}{x}\\right)}^{2}+1" :db/id #edb/ref 17592186375627} {:answer/id #uuid "d880a9fe-7ede-58b5-95dc-503280226675" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}={\\left(\\frac{x}{2}\\right)}^{2}+1" :db/id #edb/ref 17592186375628} {:answer/id #uuid "c09ce9e9-e44a-5f6f-a0ba-e4f831714695" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}={x}^{2}+2" :db/id #edb/ref 17592186375629} {:answer/id #uuid "394ebbf2-c2d3-501a-9d24-4f85814641c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=1-{\\left(\\frac{x}{2}\\right)}^{2}" :db/id #edb/ref 17592186375630}] :answer-field/correct {:answer/id #uuid "d880a9fe-7ede-58b5-95dc-503280226675" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}={\\left(\\frac{x}{2}\\right)}^{2}+1" :db/id #edb/ref 17592186375628} :answer-field/id #uuid "b5fabfe3-808f-535a-8196-05aa4185848e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375625}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8b4d7dbc-be4c-5d12-8115-af652723cf38" :question/math-academy-id "q-102677" :question/problem "Find the Cartesian equation of the curve defined parametrically as \n\n$$\nx=2\\operatorname{tan}⁡t,\\,\\,\\,y=\\operatorname{sec}⁡t,\\,t\\in (0,\\frac{\\pi }{2}).\n$$" :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=2\\operatorname{tan}⁡t\\, & ⇒\\,\\operatorname{tan}⁡t=\\frac{x}{2} \\\\ y=\\operatorname{sec}⁡t\\, & ⇒\\,\\operatorname{sec}⁡t=y\\end{aligned}\n$$\n\nDividing the Pythagorean identity ${sin}^{2}⁡t+{cos}^{2}⁡t=1$ by ${cos}^{2}⁡t$, we get\n\n$$\n\\begin{aligned}\\frac{{sin}^{2}⁡t}{{cos}^{2}⁡t}+\\frac{{cos}^{2}⁡t}{{cos}^{2}⁡t} & =\\frac{1}{{cos}^{2}⁡t} \\\\ {\\left(\\frac{\\operatorname{sin}⁡t}{\\operatorname{cos}⁡t}\\right)}^{2}+1 & ={\\left(\\frac{1}{\\operatorname{cos}⁡t}\\right)}^{2} \\\\ {tan}^{2}⁡t+1 & ={sec}^{2}⁡t.\\end{aligned}\n$$\n\nSubstituting $\\operatorname{tan}⁡t=\\frac{x}{2}$ and $\\operatorname{sec}⁡t=y$ into this formula, we get\n\n$$\n\\begin{aligned}{\\left(\\frac{x}{2}\\right)}^{2}+1={y}^{2}.\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is ${y}^{2}={\\left(\\frac{x}{2}\\right)}^{2}+1.$"} {:db/id #edb/ref 17592186375666 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0799cc9-e14e-5a2d-9286-73426eafb59e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={t}^{2},\\,\\,y=2t" :db/id #edb/ref 17592186375668} {:answer/id #uuid "acc7df8b-c756-5284-8e82-dae9d4013672" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=4t,\\,\\,y=4{t}^{2}" :db/id #edb/ref 17592186375669} {:answer/id #uuid "1ebb9a3d-eabd-5e3e-8ef8-1948c3b61a86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2{t}^{2},\\,\\,y=2t" :db/id #edb/ref 17592186375670} {:answer/id #uuid "aed9b685-c713-5ef8-ac89-8c9406390f53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2t,\\,\\,y={t}^{2}" :db/id #edb/ref 17592186375671} {:answer/id #uuid "6aea5343-c121-5e94-8764-0b2bbc36c581" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2t,\\,\\,y=2{t}^{2}" :db/id #edb/ref 17592186375672}] :answer-field/correct {:answer/id #uuid "aed9b685-c713-5ef8-ac89-8c9406390f53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2t,\\,\\,y={t}^{2}" :db/id #edb/ref 17592186375671} :answer-field/id #uuid "a303e60a-b1f5-596b-bbed-e541ec664174" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375667}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "855fb4bb-64dc-5358-8f76-342d961ee64f" :question/math-academy-id "q-106411" :question/problem "![](images/3f/3f1e86d5eebc6e36b4e4087dbdead613f45be89936651f529797c3faa331e99b.png)\n\nWhich of the following sets of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ generate the parabola shown above?" :question/worked-solution "The diagram shows that the parabola is vertical, has its vertex at $(0,0),$ and passes through the point $(6,9).$\n\nThe parametric equations of a vertical parabola  that has its vertex at $(0,0)$ are\n\n$$\nx=2pt,\\,y=p{t}^{2},\n$$\n\nwhere $p$ is constant.\n\nSince the parabola passes through $(6,9),$ we can substitute $x=6$ and $y=9$ into the standard parametric equations to obtain a system of equations. This gives\n\n$$\n\\left\\{\\begin{aligned}6 &=2pt \\\\ 9 &=p{t}^{2}.\\end{aligned}\\right.\n$$\n\nSolving the first equation for $t,$ we have\n\n$$\n\\begin{aligned}6 & =2pt \\\\ 3 & =pt \\\\ t & =\\frac{3}{p}.\\end{aligned}\n$$\n\nSubstituting this into the second equation and solving for $p,$ we get\n\n$$\n\\begin{aligned}9 & =p{\\left(\\frac{3}{p}\\right)}^{2} \\\\ 9 & =p\\cdot \\frac{9}{{p}^{2}} \\\\ 9 & =\\frac{9}{p} \\\\ p & =1.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx=2(1)t,\\,y=(1){t}^{2},\n$$\n\nwhich simplify to\n\n$$\nx=2t,\\,y={t}^{2}.\n$$"} {:db/id #edb/ref 17592186375673 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56929ae7-8267-56bb-bd8e-fbce73d8d772" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}{t}^{2},\\,\\,y=\\frac{1}{2}t" :db/id #edb/ref 17592186375675} {:answer/id #uuid "b3ca7528-dc7b-50ef-b046-eab1a289ab1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}{t}^{2},\\,\\,y=2t" :db/id #edb/ref 17592186375676} {:answer/id #uuid "c9493ea6-d33f-5c4f-84b2-c812441df81d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}{t}^{2},\\,\\,y=t" :db/id #edb/ref 17592186375677} {:answer/id #uuid "101ce319-ab20-5d8c-8a08-c008a02ebd5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2{t}^{2},\\,\\,y=4t" :db/id #edb/ref 17592186375678} {:answer/id #uuid "fdcd8930-a6c4-5099-bcb2-dd8030e79cd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={t}^{2},\\,\\,y=t" :db/id #edb/ref 17592186375679}] :answer-field/correct {:answer/id #uuid "c9493ea6-d33f-5c4f-84b2-c812441df81d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}{t}^{2},\\,\\,y=t" :db/id #edb/ref 17592186375677} :answer-field/id #uuid "7e971284-4599-5c77-9487-0d40be9f2ca4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375674}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "abc2c374-a8d6-547c-a2fc-d8046e852f7f" :question/math-academy-id "q-106419" :question/problem "Which of the following sets of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ generate the horizontal parabola given by the Cartesian equation ${y}^{2}=2x?$" :question/worked-solution "The parametric equations of a horizontal parabola ${y}^{2}=4px$ that has its vertex at $(0,0)$ are\n\n$$\nx=p{t}^{2},\\,y=2pt,\n$$\n\nwhere $p$ is constant.\n\nComparing the given Cartesian equation with the general case ${y}^{2}=4px$ and solving for $p,$ we get\n\n$$\n\\begin{aligned}4px & =2x \\\\ 4p & =2 \\\\ p & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx=\\left(\\frac{1}{2}\\right){t}^{2},\\,y=2\\left(\\frac{1}{2}\\right)t,\n$$\n\nwhich simplify to\n\n$$\nx=\\frac{1}{2}{t}^{2},\\,y=t.\n$$"} {:db/id #edb/ref 17592186375769 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ff3f417-3eb7-578f-abd5-834be46bc2fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186375771} {:answer/id #uuid "5e1f3322-cc54-50b1-bdd9-ecd36b711cc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(10,0)" :db/id #edb/ref 17592186375772} {:answer/id #uuid "3cf824d4-fe5b-5e61-a294-c20d75a16ae6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-\\frac{5}{2})" :db/id #edb/ref 17592186375773} {:answer/id #uuid "226b0174-c841-5a2b-b822-94c43761ed3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,10)" :db/id #edb/ref 17592186375774} {:answer/id #uuid "1cc0d7df-1601-5d99-89b2-1bbbd7a32a1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{5}{2},0)" :db/id #edb/ref 17592186375775}] :answer-field/correct {:answer/id #uuid "1ff3f417-3eb7-578f-abd5-834be46bc2fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186375771} :answer-field/id #uuid "cd21acd3-13d3-5d0c-a114-b1011bcbbd63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375770}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c713e377-21b9-5c8a-94ed-1ffbe3f427d0" :question/math-academy-id "q-115902" :question/problem "What are the coordinates of the vertex of the parabola ${x}^{2}=10y?$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at the origin is\n\n$$\n{x}^{2}=4py,\n$$\n\nwhere $p$ is a constant.\n\nWe can rewrite the given equation as \n\n$$\n{x}^{2}=4\\left(\\frac{5}{2}\\right)y.\n$$\n\nIt is now clear that our equation is of the standard type with $p=\\frac{5}{2}.$ Therefore, our parabola has its vertex at $(0,0).$"} {:db/id #edb/ref 17592186375776 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09e1b8b5-754b-5376-8f92-6a3301d9243b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186375778} {:answer/id #uuid "734836b1-9d3b-5662-aa2a-5c4d36562396" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-1)" :db/id #edb/ref 17592186375779} {:answer/id #uuid "e025c664-543f-5864-b5c3-d3c556a8b3bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\frac{1}{4})" :db/id #edb/ref 17592186375780} {:answer/id #uuid "d0c51382-9749-5d01-8bb2-48764e6fcb3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{1}{4},0)" :db/id #edb/ref 17592186375781} {:answer/id #uuid "387d226a-c49e-50ff-9915-699bdabbfecc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,0)" :db/id #edb/ref 17592186375782}] :answer-field/correct {:answer/id #uuid "09e1b8b5-754b-5376-8f92-6a3301d9243b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186375778} :answer-field/id #uuid "53efbc1a-2b16-57c6-b025-c50d06eff292" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375777}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d11f9ee6-944b-55a1-ba56-60ef10089957" :question/math-academy-id "q-115903" :question/problem "What are the coordinates of the vertex of the parabola ${x}^{2}=-y?$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at the origin is\n\n$$\n{x}^{2}=4py,\n$$\n\nwhere $p$ is a constant.\n\nWe can rewrite the given equation as \n\n$$\n{x}^{2}=4\\left(-\\frac{1}{4}\\right)y.\n$$\n\nIt is now clear that our equation is of the standard type with $p=-\\frac{1}{4}.$ Therefore, our parabola has its vertex at $(0,0).$"} {:db/id #edb/ref 17592186375818 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e8179dc-3fed-5f3f-84c9-45a6ccd7804d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{\\pi }^{2}}{2}" :db/id #edb/ref 17592186375820} {:answer/id #uuid "82d73cb8-e47a-5d28-8a64-a42adeb8a3cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\pi }^{2}" :db/id #edb/ref 17592186375821} {:answer/id #uuid "1d066b56-205b-5a8f-9270-1ad80916efd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{2}" :db/id #edb/ref 17592186375822} {:answer/id #uuid "e12b6e4b-b8e4-5b16-a705-fe2799706827" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{\\pi }^{2}}{4}" :db/id #edb/ref 17592186375823} {:answer/id #uuid "d8da77bd-b62e-5bdc-8ff1-b5a7bca83d1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\pi }^{2}" :db/id #edb/ref 17592186375824}] :answer-field/correct {:answer/id #uuid "d8da77bd-b62e-5bdc-8ff1-b5a7bca83d1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\pi }^{2}" :db/id #edb/ref 17592186375824} :answer-field/id #uuid "5ea1ff18-caf6-5b75-8df3-01bef44ceaad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375819}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c6c00986-d23a-55ec-b3c3-675d7475901f" :question/math-academy-id "q-125123" :question/problem "What is the coefficient of ${(x-\\frac{1}{3})}^{2}$ in the second-degree Taylor polynomial of $f(x)=\\operatorname{cos}⁡(2\\pi x)$ at $x=\\frac{1}{3}?$" :question/worked-solution "The second-degree Taylor polynomial of $f(x)$ about $x=\\frac{1}{3}$ is given by\n\n$$\n\\begin{aligned}{P}_{2}(x) & =f\\left(\\frac{1}{3}\\right)+{f}^{′}\\left(\\frac{1}{3}\\right)(x-\\frac{1}{3})+\\frac{{f}^{″}\\left(\\frac{1}{3}\\right)}{2}{(x-\\frac{1}{3})}^{2}.\\end{aligned}\n$$\n\nThe coefficient of ${(x-\\frac{1}{3})}^{2}$ in the above Taylor polynomial is \n\n$$\n\\frac{{f}^{″}\\left(\\frac{1}{3}\\right)}{2}.\n$$\n\nTo find this coefficient, we start by computing the second derivative ${f}^{″}(x):$ \n\n$$\n\\begin{aligned}f(x) & =\\operatorname{cos}⁡(2\\pi x) \\\\ {f}^{′}(x) & =-2\\pi \\operatorname{sin}⁡(2\\pi x) \\\\ {f}^{″}(x) & =-4{\\pi }^{2}\\operatorname{cos}⁡(2\\pi x)\\end{aligned}\n$$\n\nThen, we evaluate ${f}^{″}(x)$ at $x=\\frac{1}{3}.$ This gives\n\n$$\n{f}^{″}\\left(\\frac{1}{3}\\right)=-4{\\pi }^{2}\\operatorname{cos}⁡\\left(\\frac{2\\pi }{3}\\right)=-4{\\pi }^{2}\\cdot \\left(-\\frac{1}{2}\\right)=2{\\pi }^{2}.\n$$\n\nFinally, we determine the coefficient of ${(x-\\frac{1}{3})}^{2},$ as follows:\n\n$$\n\\begin{aligned}\\frac{{f}^{″}\\left(\\frac{1}{3}\\right)}{2} & =\\frac{2{\\pi }^{2}}{2}={\\pi }^{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375839 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "275da614-6d1c-5b8f-a6fc-8dbed418f9c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R(s,u)=⟨2,\\,1-u,\\,s⟩" :db/id #edb/ref 17592186375841} {:answer/id #uuid "559b7284-3569-5b64-8108-fcc11b53d182" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R(s,u)=⟨1,\\,1-2u,\\,s⟩" :db/id #edb/ref 17592186375842} {:answer/id #uuid "8c56aac5-8c54-5f60-8bab-1f7bebbb106d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R(s,u)=⟨2+s,\\,1,\\,u-1⟩" :db/id #edb/ref 17592186375843} {:answer/id #uuid "80e7c4a0-6258-5587-a7dd-4aecbf57ce65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R(s,u)=⟨2-u,\\,1,\\,1-s⟩" :db/id #edb/ref 17592186375844} {:answer/id #uuid "7bd145e7-8104-5746-9dec-ba3461cdc69f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R(s,u)=⟨u-2,\\,s-1,\\,u⟩" :db/id #edb/ref 17592186375845}] :answer-field/correct {:answer/id #uuid "275da614-6d1c-5b8f-a6fc-8dbed418f9c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R(s,u)=⟨2,\\,1-u,\\,s⟩" :db/id #edb/ref 17592186375841} :answer-field/id #uuid "19eadaab-818b-52b8-b6c2-db1c5e67db56" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375840}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b10f792e-96ca-5103-a14b-bd772751151f" :question/math-academy-id "q-127283" :question/problem "Find a parametric equation of the osculating plane for the curve  $r(t)$ at the point where $t=\\frac{\\pi }{2},$ given that\n\n$$\nr(t)=⟨2,\\,\\operatorname{sin}⁡t,\\,-\\operatorname{cos}⁡t⟩,\\,T\\left(\\frac{\\pi }{2}\\right)=⟨0,0,1⟩,\\,N\\left(\\frac{\\pi }{2}\\right)=⟨0,-1,0⟩.\n$$\n\nNote that $T$ and $N$ denote the unit tangent and principal normal, respectively." :question/worked-solution "The osculating plane passes through the point $P$, which is at the tip of the vector $r\\left(\\frac{\\pi }{2}\\right).$ The vectors $T(\\left(\\frac{\\pi }{2}\\right)$ and $N\\left(\\frac{\\pi }{2}\\right)$ are parallel to this plane. Therefore, a parametric equation for the plane can be written as\n\n$$\nR(s,u)=r\\left(\\frac{\\pi }{2}\\right)+s\\,T\\left(\\frac{\\pi }{2}\\right)+u\\,N\\left(\\frac{\\pi }{2}\\right),\\,s,u\\in (-\\infty ,\\infty ).\n$$\n\n \n\nWe have that\n\n$$\n\\begin{aligned}r\\left(\\frac{\\pi }{2}\\right) & =⟨2,\\,\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right),-\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right)⟩=⟨2,1,0⟩.\\end{aligned}\n$$\n\nHence, a parametric equation for the osculating plane at the point $(2,1,0)$ is given by\n\n$$\n\\begin{aligned}R(s,u) & =r\\left(\\frac{\\pi }{2}\\right)+s\\,T\\left(\\frac{\\pi }{2}\\right)+u\\,N\\left(\\frac{\\pi }{2}\\right) \\\\  & =⟨2,1,0⟩+s⟨0,0,1⟩+u⟨0,-1,0⟩ \\\\  & =⟨2,\\,1-u,\\,s⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375867 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1cb0c5a-9862-57eb-b57f-acb23890d677" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi -2" :db/id #edb/ref 17592186375869} {:answer/id #uuid "62e36acb-5f50-5c64-b175-8079a61023a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi -\\sqrt{2}}{2}" :db/id #edb/ref 17592186375870} {:answer/id #uuid "f6dbbdb6-befc-5ff1-81d4-cba020f3cb12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186375871} {:answer/id #uuid "13addc19-500d-5e0f-acbb-8b63b95f8faf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186375872} {:answer/id #uuid "8c2fae7f-e95c-5979-8992-c80d112c68aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi \\sqrt{2}}{4}" :db/id #edb/ref 17592186375873}] :answer-field/correct {:answer/id #uuid "8c2fae7f-e95c-5979-8992-c80d112c68aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi \\sqrt{2}}{4}" :db/id #edb/ref 17592186375873} :answer-field/id #uuid "6215ee61-981f-5e63-acd6-8f36d8ca0439" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375868}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c1f2ddde-40be-5a46-987b-92cfeb3c2c93" :question/math-academy-id "q-127321" :question/problem "Find the shortest distance between the origin and the osculating plane for the curve $r(t)$ at the point where $t=\\frac{\\pi }{2},$ given that\n\n$$\n\\begin{aligned}r(t) & =⟨2\\operatorname{sin}⁡t,\\,2\\operatorname{cos}⁡t,\\,-t⟩ \\\\ T(t) & =\\frac{1}{\\sqrt{2}}⟨\\operatorname{cos}⁡t,\\,-\\operatorname{sin}⁡t,-1⟩ \\\\ N(t) & =⟨-\\operatorname{sin}⁡t,-\\operatorname{cos}⁡t,0⟩.\\end{aligned}\n$$\n\nNote that $T$ and $N$ denote the unit tangent and principal normal, respectively." :question/worked-solution "First, notice that the unit tangent and the principal normal at the point where $t=\\frac{\\pi }{2}$ are\n\n$$\n\\begin{aligned}T\\left(\\frac{\\pi }{2}\\right) & =\\frac{1}{\\sqrt{2}}⟨\\operatorname{cos}⁡\\frac{\\pi }{2},\\,-\\operatorname{sin}⁡\\frac{\\pi }{2},-1⟩=\\frac{1}{\\sqrt{2}}⟨0,-1,-1⟩ \\\\ N\\left(\\frac{\\pi }{2}\\right) & =⟨-\\operatorname{sin}⁡\\frac{\\pi }{2},-\\operatorname{cos}⁡\\frac{\\pi }{2},0⟩=⟨-1,0,0⟩.\\end{aligned}\n$$\n\nAlso, the position vector of the point where $t=\\frac{\\pi }{2}$ is\n\n$$\np=r\\left(\\frac{\\pi }{2}\\right)=⟨2\\operatorname{sin}⁡\\frac{\\pi }{2},\\,2\\operatorname{cos}⁡\\frac{\\pi }{2},\\,-\\frac{\\pi }{2}⟩=⟨2,0,-\\frac{\\pi }{2}⟩.\n$$\n\nNow, we need to find a vector that's perpendicular to the osculating plane. To do that, we use the cross product of the unit tangent $T\\left(\\frac{\\pi }{2}\\right)$ and the principal normal $N\\left(\\frac{\\pi }{2}\\right):$\n\n$$\n\\begin{aligned}T\\left(\\frac{\\pi }{2}\\right)\\times N\\left(\\frac{\\pi }{2}\\right) & =\\frac{1}{\\sqrt{2}}⟨0,-1,-1⟩\\times ⟨-1,0,0⟩ \\\\  & =\\frac{1}{\\sqrt{2}}\\,\\left|\\begin{aligned}i & j & k \\\\ 0 & -1 & -1 \\\\ -1 & 0 & 0\\end{aligned}\\right| \\\\  & =\\frac{1}{\\sqrt{2}}[\\text{ }\\left|\\begin{aligned}-1 & -1 \\\\ 0 & 0\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{\\sqrt{2}}(j-k) \\\\  & =\\frac{1}{\\sqrt{2}}⟨0,1,-1⟩\\end{aligned}\n$$\n\nFinally, the shortest distance between our plane and the origin is given by\n\n$$\nd=\\frac{|(p-0)\\cdot n|}{‖n‖}=\\frac{|p\\cdot n|}{‖n‖}=|p\\cdot n|,\n$$\n\nsince $‖n‖=1.$ Therefore, we have\n\n$$\n\\begin{aligned}d & =|p\\cdot n| \\\\  & =|⟨2,0,-\\frac{\\pi }{2}⟩\\cdot \\frac{1}{\\sqrt{2}}⟨0,1,-1⟩| \\\\  & =\\frac{1}{\\sqrt{2}}|0+0+\\frac{\\pi }{2}| \\\\  & =\\frac{\\pi }{2\\sqrt{2}} \\\\  & =\\frac{\\pi \\sqrt{2}}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375923 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6da15c27-0ab0-56cd-8ef3-27f8c1c55a7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{t}}{\\sqrt{2}}" :db/id #edb/ref 17592186375925} {:answer/id #uuid "5fd2612d-5711-599a-a694-c2afac45f762" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{t}" :db/id #edb/ref 17592186375926} {:answer/id #uuid "c63764c7-24ed-559f-b365-20b4780612bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{{e}^{t}}" :db/id #edb/ref 17592186375927} {:answer/id #uuid "a55dd6d8-17f7-5ead-b3ba-94f6823a5462" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{t}}{2}" :db/id #edb/ref 17592186375928} {:answer/id #uuid "35aeb36f-92f3-56c9-80b5-a43746fc2a01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{e}^{t}}" :db/id #edb/ref 17592186375929}] :answer-field/correct {:answer/id #uuid "6da15c27-0ab0-56cd-8ef3-27f8c1c55a7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{t}}{\\sqrt{2}}" :db/id #edb/ref 17592186375925} :answer-field/id #uuid "4d564c3b-bc44-527d-b38b-8c6df86c4124" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375924}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fcaec574-ebde-5bb8-97c7-77da61871c71" :question/math-academy-id "q-131228" :question/problem "Find the curvature at an arbitrary point on the curve $r(t)$ given that its derivative ${r}^{′}(t)$ and the derivative of the corresponding unit tangent ${T}^{′}(t)$ are as follows: \n\n$$\n\\begin{aligned}{r}^{′}(t)=⟨\\frac{\\operatorname{cos}⁡t-\\operatorname{sin}⁡t}{{e}^{t}},\\,-\\frac{\\operatorname{cos}⁡t+\\operatorname{sin}⁡t}{{e}^{t}}⟩,\\,{T}^{′}(t)=\\frac{1}{\\sqrt{2}}⟨-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t,\\,\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩\\end{aligned}\n$$" :question/worked-solution "Since we are given both the derivative of the curve ${r}^{′}(t)$ and the derivative of the unit tangent ${T}^{′}(t)$, we will use the following formula for the curvature:\n\n$$\nκ(t)=\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}\n$$\n\nNow, we find the magnitudes of ${r}^{′}(t)$ and ${T}^{′}(t):$\n\n$$\n\\begin{aligned}‖{T}^{′}(t)‖ & =\\frac{1}{\\sqrt{2}}\\cdot \\sqrt{{(-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t)}^{2}+{(\\operatorname{sin}⁡t-\\operatorname{cos}⁡t)}^{2}} \\\\  & =\\frac{1}{\\sqrt{2}}\\cdot \\sqrt{{sin}^{2}⁡t+2\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{cos}^{2}⁡t+{sin}^{2}⁡t-2\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{cos}^{2}⁡t} \\\\  & =\\frac{1}{\\sqrt{2}}\\cdot \\sqrt{2({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\frac{1}{\\sqrt{2}}\\cdot \\sqrt{2} \\\\  & =1 \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\operatorname{cos}⁡t-\\operatorname{sin}⁡t}{{e}^{t}}\\right)}^{2}+{\\left(-\\frac{\\operatorname{cos}⁡t+\\operatorname{sin}⁡t}{{e}^{t}}\\right)}^{2}} \\\\  & =\\sqrt{\\frac{{cos}^{2}⁡t-2\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{sin}^{2}⁡t}{{e}^{2t}}+\\frac{{cos}^{2}⁡t+2\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{cos}^{2}⁡t}{{e}^{2t}}} \\\\  & =\\frac{1}{{e}^{t}}\\cdot \\sqrt{2({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\frac{\\sqrt{2}}{{e}^{t}}\\end{aligned}\n$$\n\nHence, the curvature is\n\n$$\n\\begin{aligned}κ(t) & =\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖} \\\\  & =\\frac{1}{\\left(\\frac{\\sqrt{2}}{{e}^{t}}\\right)} \\\\  & =\\frac{{e}^{t}}{\\sqrt{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186376552 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "114a6959-d574-5de7-8989-f4eee535ee32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186376554} {:answer/id #uuid "a575f88a-da0e-5c56-9a73-33bed9e944de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "=" :db/id #edb/ref 17592186376555} {:answer/id #uuid "3e128bb8-c726-5094-9b24-3e7a708d7e0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186376556}] :answer-field/correct {:answer/id #uuid "3e128bb8-c726-5094-9b24-3e7a708d7e0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186376556} :answer-field/id #uuid "3498dfaa-de46-5c8a-b515-f3e953cd5eae" :answer-field/key "field-7" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186376553} {:answer-field/choices [{:answer/id #uuid "bfed2b41-921c-5196-ae6d-7a5d01fd5318" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186376558} {:answer/id #uuid "b2844fcc-70c7-5f35-859b-59125d0a9ad7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186376559}] :answer-field/correct {:answer/id #uuid "bfed2b41-921c-5196-ae6d-7a5d01fd5318" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186376558} :answer-field/id #uuid "8efb30d8-b283-5656-b5a9-2ae69187073e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186376557} {:answer-field/choices [{:answer/id #uuid "d4a51911-ef81-571c-b08d-e55b39b29