592186402333} {:answer/id #uuid "2219bdb7-7b65-5c58-8ff5-e35d8409d539" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{4}" :db/id #edb/ref 17592186402334}] :answer-field/correct {:answer/id #uuid "d6e2473f-6d10-58cd-9c2d-75974fbf25c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186402333} :answer-field/id #uuid "e257c7be-72fa-5044-afd5-3c231c4d2101" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186402330} {:answer-field/choices [{:answer/id #uuid "8d961e8a-0a6f-54c1-8cde-ab0903529501" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "continuous" :db/id #edb/ref 17592186402336} {:answer/id #uuid "c6754a7b-081e-5d31-992c-2069f9dc057c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "discontinuous" :db/id #edb/ref 17592186402337}] :answer-field/correct {:answer/id #uuid "8d961e8a-0a6f-54c1-8cde-ab0903529501" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "continuous" :db/id #edb/ref 17592186402336} :answer-field/id #uuid "4b9f9176-6990-5c20-b84c-e134dd361960" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186402335}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9937b4b8-0233-5d12-b8c0-111d5bfd92fe" :question/math-academy-id "q-343445" :question/problem "$$\nF(x)=\\{\\begin{aligned}-4, & x\\in [-\\pi ,0] \\\\ 2, & x\\in (0,\\pi )\\end{aligned}\n$$\n\nConsider the function $F(x)$ shown above. The Fourier series of the $2\\pi $-periodic extension $f(x)$ of $F(x)$ is given by\n\n$$\nf(x)∼-1+{\\sum }_{n=1}^{\\infty }\\frac{12}{\\pi (2n-1)}sin\\,((2n-1)x).\n$$\n\nSelect the correct options in the reasoning below.\n\nAt $x=-\\frac{\\pi }{2},$ we have\n\n$$\nsin\\,((2n-1)\\cdot (-\\frac{\\pi }{2}))={{field-1}}.\n$$\n\nSince $f(x)$ is \n{{field-2}}\nat $x=-\\frac{\\pi }{2},$ the corresponding Fourier series converges to \n\n$$\nf(-\\frac{\\pi }{2})={{field-3}}.\n$$\n\nTherefore, we have \n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{2n-1}={{field-4}}.\n$$" :question/worked-solution "First, we rewrite our Fourier series as\n\n$$\nf(x)∼-1+\\frac{12}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot sin\\,((2n-1)x).\n$$\n\nNow, notice that at $x=-\\frac{\\pi }{2},$ we have\n\n$$\nsin\\,((2n-1)\\cdot (-\\frac{\\pi }{2}))=sin\\,(\\frac{\\pi }{2}-n\\pi )=(-1)^{n}.\n$$\n\nSince $f(x)$ is $\\text{continuous}$ at $x=-\\frac{\\pi }{2},$ the corresponding Fourier series converges to \n\n$$\nf(-\\frac{\\pi }{2})=-4.\n$$\n\n \n\nTherefore, we have \n\n$$\n\\begin{aligned}f(-\\frac{\\pi }{2}) & =-1+\\frac{12}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot sin\\,((2n-1)\\cdot (-\\frac{\\pi }{2})) \\\\ -4 & =-1+\\frac{12}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot (-1)^{n} \\\\ -3 & =\\frac{12}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{2n-1} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{2n-1} & =-\\frac{\\pi }{4} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{2n-1} & =\\frac{\\pi }{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186402338 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34e78128-47e4-5867-8d9d-3e3880cad539" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186402340} {:answer/id #uuid "98c90103-4a5a-5ee2-9a58-bde0723208bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186402341} {:answer/id #uuid "72d35535-c3d9-5627-8854-f43be0b19b2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186402342}] :