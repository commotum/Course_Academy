aaad6fdf-5307-581d-a51e-86eb719eaa00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "continuous" :db/id #edb/ref 17592186402314} :answer-field/id #uuid "eabd5536-e333-5913-8a91-953c55edab0a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186402313} {:answer-field/choices [{:answer/id #uuid "c8f13b00-9c43-5ce3-9ea2-b89ef353d34b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186402317} {:answer/id #uuid "5794e73f-ea5d-524c-bb11-82c1cf90b93c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186402318} {:answer/id #uuid "dc9629e5-251b-531d-8097-ef9b42974051" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186402319}] :answer-field/correct {:answer/id #uuid "dc9629e5-251b-531d-8097-ef9b42974051" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186402319} :answer-field/id #uuid "240e5c16-d6bd-5404-b856-e008054e31c9" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186402316}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3ea02f42-e1ec-509f-a6b0-19fd2f4064ef" :question/math-academy-id "q-343438" :question/problem "$$\nF(x)=\\{\\begin{aligned}-1, & x\\in [-4,0] \\\\ 3, & x\\in (0,4)\\end{aligned}\n$$\n\nConsider the function $F(x)$ shown above. The Fourier series of the $8$-periodic extension $f(x)$ of $F(x)$ is given by\n\n$$\nf(x)∼1+{\\sum }_{n=1}^{\\infty }\\frac{8}{\\pi (2n-1)}sin\\,(\\frac{(2n-1)\\pi x}{4}).\n$$\n\nSelect the correct options in the reasoning below.\n\nAt $x=-2,$ we have\n\n$$\nsin\\,(\\frac{(2n-1)\\pi \\cdot (-2)}{4})={{field-1}}.\n$$\n\nSince $f(x)$ is \n{{field-2}}\nat $x=-2,$ the corresponding Fourier series converges to \n\n$$\nf(-2)={{field-3}}.\n$$\n\nTherefore, we have \n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{2n-1}={{field-4}}.\n$$" :question/worked-solution "First, we rewrite our Fourier series as\n\n$$\nf(x)∼1+\\frac{8}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot sin\\,(\\frac{(2n-1)\\pi x}{4}).\n$$\n\nNow, notice that at $x=-2,$ we have\n\n$$\nsin\\,(\\frac{(2n-1)\\pi \\cdot (-2)}{4})=sin\\,(\\frac{\\pi }{2}-n\\pi )=(-1)^{n}.\n$$\n\nSince $f(x)$ is $\\text{continuous}$ at $x=-2,$ the corresponding Fourier series converges to \n\n$$\nf(-2)=-1.\n$$\n\n \n\nTherefore, we have \n\n$$\n\\begin{aligned}f(-2) & =1+\\frac{8}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot sin\\,(\\frac{(2n-1)\\pi \\cdot (-2)}{4}) \\\\ -1 & =1+\\frac{8}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot (-1)^{n} \\\\ -2 & =\\frac{8}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{2n-1} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{2n-1} & =-\\frac{\\pi }{4} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{2n-1} & =\\frac{\\pi }{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186402320 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59e944d4-7bfb-518e-9bee-2fdf150f8144" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1)^{n+1}" :db/id #edb/ref 17592186402322} {:answer/id #uuid "47de1570-9f8f-50d0-b18a-c75ae926d19e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186402323} {:answer/id #uuid "8dcea2a2-3096-50e6-a6b7-e9b80e1e8393" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186402324} {:answer/id #uuid "c33a2222-b813-50a8-a34a-21f9fa0adc40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1)^{n}" :db/id #edb/ref 17592186402325}] :answer-