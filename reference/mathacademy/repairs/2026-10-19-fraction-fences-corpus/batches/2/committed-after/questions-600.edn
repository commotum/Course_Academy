2})}^{2}\n\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\n& ({x}^{2}-11x+\\frac{121}{4})-10 \\\\\n&= {(x-\\frac{11}{2})}^{2}-10.\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290408 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c6a7ce45-8f89-5292-a9f7-83588fa540d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186289351}] :answer-field/correct {:answer/id #uuid "c6a7ce45-8f89-5292-a9f7-83588fa540d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186289351} :answer-field/id #uuid "7bfdb33f-3e5a-560d-b881-280805ddbed2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290003} {:answer-field/choices [{:answer/id #uuid "cdfeff32-20d1-5a8c-9bf3-84db4cf46043" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186289406}] :answer-field/correct {:answer/id #uuid "cdfeff32-20d1-5a8c-9bf3-84db4cf46043" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186289406} :answer-field/id #uuid "cc602a12-4abd-5560-9d31-a86b4eba380b" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290174}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "71bc1100-5cb2-564e-9a6b-89a542c6c7de" :question/math-academy-id "q-223639" :question/problem "Complete the square on the quadratic expression ${x}^{2}-11x+30.$\n\n${x}^{2}-11x+30=(x\\,\\,-$\n{{field-1}} $)^{2}-$\n{{field-2}}" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}-2\\cdot \\frac{11}{2}x+30\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${\\left(\\frac{11}{2}\\right)}^{2}$, writing the constant term $30$ last:\n\n$$\n\\underbrace{{x}^{2}-2\\cdot \\frac{11}{2}x+{\\left(\\frac{11}{2}\\right)}^{2}}-\\,{\\left(\\frac{11}{2}\\right)}^{2}+30\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(x-\\frac{11}{2})}^{2}-{\\left(\\frac{11}{2}\\right)}^{2}+30\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n{(x-\\frac{11}{2})}^{2}-\\frac{1}{4}.\n$$"} {:db/id #edb/ref 17592186290409 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3266af3-d507-5677-9cca-fe953b9f4291" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186289322}] :answer-field/correct {:answer/id #uuid "c3266af3-d507-5677-9cca-fe953b9f4291" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186289322} :answer-field/id #uuid "1d49c639-c1b4-5d1c-988b-463effd88b79" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289804} {:answer-field/choices [{:answer/id #uuid "b0a2a9da-d25b-54f5-866a-796316d4daa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186289201}] :answer-field/correct {:answer/id #uuid "b0a2a9da-d25b-54f5-866a-796316d4daa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186289201} :answer-field/id #uuid "ffba8f81-6bad-5095-8d2a-7a84517eadec" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290255}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b072df2c-3382-5adf-80f6-f89bc73cbee2" :question/math-academy-id "q-223640" :question/problem "Complete the square on the quadratic expression ${w}^{2}-3w+3.$\n\n${w}^{2}-3w+3=(w\\,\\,-$\n{{field-1}} $)^{2}+$\n{{field-2}}" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{w}^{2}-2\\cdot \\frac{3}{2}w+3\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${\\left(\\frac{3}{2}\\right)}^{2}$, writing the constant term $3$ last:\n\n$$\n\\underbrace{{w}^{2}-2\\cdot \\frac{3}{2}w+{\\left(\\frac{3}{2}\\right)}^{2}}-\\,{\\left(\\frac{3}{2}\\right)}^{2}+3\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(w-\\frac{3}{2})}^{2}-{\\left(\\frac{3}{2}\\right)}^{2}+3\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n{(w-\\frac{3}{2})}^{2}+\\frac{3}{4}.\n$$"} {:db/id #edb/ref 17592186290410 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0273afcf-1982-5569-8348-f10a8e77aad7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465881} {:answer/id #uuid "1526315c-74f6-5bb1-a15f-52ce2cf483f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465882}] :answer-field/correct {:answer/id #uuid "1526315c-74f6-5bb1-a15f-52ce2cf483f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465882} :answer-field/id #uuid "7a11075d-7e91-53e3-8287-8ac5fd97acb2" :answer-field/key "$x=\\frac{\\pi }{4}$ is a critical point of $f(x)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466784} {:answer-field/choices [{:answer/id #uuid "c496d87e-e47e-5f9d-8298-d6c0c32cca85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465883} {:answer/id #uuid "9b5f781a-5bc0-57ae-80e8-0675eb804587" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465884}] :answer-field/correct {:answer/id #uuid "9b5f781a-5bc0-57ae-80e8-0675eb804587" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465884} :answer-field/id #uuid "d88e12bf-9078-5424-8848-e2cb1e920461" :answer-field/key "${f}^{″}(\\frac{\\pi }{4})<0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466785} {:answer-field/choices [{:answer/id #uuid "c3910ecb-9299-5ff4-844f-6a07a3aa9e28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465885} {:answer/id #uuid "9fbca59f-a430-5c3d-8b2e-b5eb1ff6889e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465886}] :answer-field/correct {:answer/id #uuid "c3910ecb-9299-5ff4-844f-6a07a3aa9e28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465885} :answer-field/id #uuid "5770f9b6-676c-5c90-9086-6fea3b63ca67" :answer-field/key "$f(x)$ has a relative minimum at $x=\\frac{\\pi }{4}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466786}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "527ec064-c6b0-5d4a-ac97-7dea39646f9c" :question/math-academy-id "q-22495" :question/problem "For the function $f(x)=\\operatorname{sin}⁡x\\operatorname{cos}⁡x,$ which of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "We need to identify whether $x=\\frac{\\pi }{4}$ is a critical point. If it is, we then need to classify it using the second derivative test.\n\nFirst, we need to identify the critical points. Differentiating $f(x)=\\operatorname{sin}⁡x\\operatorname{cos}⁡x,$ we get\n\n$$\n{f}^{′}(x)=\\operatorname{cos}⁡x\\operatorname{cos}⁡x-\\operatorname{sin}⁡x\\operatorname{sin}⁡x={cos}^{2}⁡x-{sin}^{2}⁡x=\\operatorname{cos}⁡(2x),\n$$\n\nand solving ${f}^{′}(x)=0,$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(2x) & =0 \\\\ 2x & =\\frac{\\pi }{2}+n\\pi , \\\\ x & =\\frac{\\pi }{4}+\\frac{n\\pi }{2},\\end{aligned}\n$$\n\nwhere $n$ is an integer.\n\nSo we have critical points at $x=\\frac{\\pi }{4}+\\frac{n\\pi }{2}.$ We're interested in the critical point $x=\\frac{\\pi }{4}.$\n\nNext, we need to determine the sign of ${f}^{″}(x)$ at this critical point. Computing ${f}^{″}(x),$ we get\n\n$$\n{f}^{″}(x)=-2\\operatorname{sin}⁡(2x),\n$$\n\nand evaluating ${f}^{″}(x)$ at $x=\\frac{\\pi }{4}$, we get\n\n$$\n{f}^{″}\\left(\\frac{\\pi }{4}\\right)=-2\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4})=-2<0.\n$$\n\nThe second derivative is negative at $x=\\frac{\\pi }{4},$ so this critical point is a relative *maximum*. \n\nTherefore, comparing our results with the given statements, we conclude that:\n\n- $x=\\frac{\\pi }{4}$ is a critical point of $f(x)\\,✓$\n\n- ${f}^{″}\\left(\\frac{\\pi }{4}\\right)<0\\,✓$\n\n- $f(x)$ has a relative *maximum* at $x=\\frac{\\pi }{4}\\,\\times $\n\nTherefore, the correct answer is “$x=\\frac{\\pi }{4}$ is a critical point of $f(x)$”; ${f}^{″}\\left(\\frac{\\pi }{4}\\right)<0$ only."} {:db/id #edb/ref 17592186290415 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ca9a195-0a8a-57e4-ae63-b391e05c9bc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-1/2}" :db/id #edb/ref 17592186288681} {:answer/id #uuid "71312b58-9940-549d-a03b-597776358bae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{1/2}" :db/id #edb/ref 17592186288823} {:answer/id #uuid "7ea64904-8f89-59e7-83ed-3ddfd8e4ee33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-2/3}" :db/id #edb/ref 17592186288889} {:answer/id #uuid "8170a871-5318-5103-b25c-3e039e645ce7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2/3}" :db/id #edb/ref 17592186288904} {:answer/id #uuid "e778c9ff-06de-5743-8f90-7936c9e1e183" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)$ does not have any local maxima" :db/id #edb/ref 17592186289567}] :answer-field/correct {:answer/id #uuid "71312b58-9940-549d-a03b-597776358bae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{1/2}" :db/id #edb/ref 17592186288823} :answer-field/id #uuid "b14dad6f-ea22-5524-9d8a-04c5558c0903" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290122}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fb6c1b86-5d4f-57f2-b763-08a6b186b5d9" :question/math-academy-id "q-22504" :question/problem "For which value of $x$ does the function $f(x)=\\frac{\\operatorname{ln}⁡x}{{x}^{2}}$ defined for $x\\in (0,\\infty )$ have a local maximum?" :question/worked-solution "First, we find the stationary points. Differentiating $f(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\left(\\frac{1}{x}\\right)\\cdot {x}^{2}-\\operatorname{ln}⁡x\\cdot 2x}{{x}^{4}} \\\\  & =\\frac{x-2x\\operatorname{ln}⁡x}{{x}^{4}} \\\\  & =\\frac{1-2\\operatorname{ln}⁡x}{{x}^{3}}.\\end{aligned}\n$$\n\nSolving for ${f}^{′}(x)=0$ on $(0,\\infty )$ gives\n\n$$\n\\begin{aligned}\\frac{1-2\\operatorname{ln}⁡x}{{x}^{3}} & =0 \\\\ 1-2\\operatorname{ln}⁡x & =0 \\\\ \\operatorname{ln}⁡x & =\\frac{1}{2} \\\\ x & ={e}^{1/2}.\\end{aligned}\n$$\n\nSo $x={e}^{1/2}$ is a stationary point. Next, to determine whether this point is a local maximum or minimum, we use the first derivative test.\n\nLet's choose the test points $x={e}^{1/3},e$ and evaluate the first derivative at these points.\n\n$$\n\\begin{aligned}{f}^{′}({e}^{1/3}) & =\\frac{1-2\\operatorname{ln}⁡{e}^{1/3}}{{({e}^{1/3})}^{3}}=\\frac{1}{3e}>0 \\\\ {f}^{′}(e) & =\\frac{1-2\\operatorname{ln}⁡e}{{e}^{3}}=-\\frac{1}{{e}^{3}}<0\\end{aligned}\n$$\n\nWe summarize the information in a table, shown below.\n\n| $x$ | $(-\\infty ,{e}^{1/2})$ | ${e}^{1/2}$ | $({e}^{1/2},\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | ${e}^{1/3}$ |  | $e$ |\n| ${f}^{′}$ | $+$ | $0$ | $-$ |\n| $f$ | $↗$ | max | $↘$ |\n\nFinally, let's use the table above to classify the critical point.\n\n- At $x={e}^{1/2},$ the first derivative changes sign from positive to negative. Therefore, $x={e}^{1/2}$ is a local maximum.\n\nWe conclude that $f(x)$ has a local maximum at $x={e}^{1/2}.$"} {:db/id #edb/ref 17592186290427 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "efae998e-dc98-5b4b-ab4c-fc5995e8225f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450322} {:answer/id #uuid "f590a205-708b-5611-9105-ca206b5a0c41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450323}] :answer-field/correct {:answer/id #uuid "f590a205-708b-5611-9105-ca206b5a0c41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450323} :answer-field/id #uuid "4dcbac18-fb46-5ad0-9978-9ee853a593d3" :answer-field/key "The global maximum value is $\\frac{{e}^{2}}{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451115} {:answer-field/choices [{:answer/id #uuid "e6755131-f931-5ec0-be6b-249ba3d2433f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450324} {:answer/id #uuid "f53f5ec6-26c9-594b-a1c5-a57d8d135618" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450325}] :answer-field/correct {:answer/id #uuid "e6755131-f931-5ec0-be6b-249ba3d2433f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450324} :answer-field/id #uuid "d3ebb718-81c2-5711-9fd5-d99025583547" :answer-field/key "The global minimum value is $2\\sqrt{e}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451116} {:answer-field/choices [{:answer/id #uuid "96fe261b-8924-5702-a08e-d644aaad551a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450326} {:answer/id #uuid "a6882046-d109-5fb1-9023-719192f9eec6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450327}] :answer-field/correct {:answer/id #uuid "96fe261b-8924-5702-a08e-d644aaad551a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450326} :answer-field/id #uuid "88b0c550-4739-517c-9c4a-5a5b493dbbd4" :answer-field/key "The global minimum value is $4\\sqrt[4]{e}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451117}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d406ba45-2233-5b01-8129-dbf69421606e" :question/math-academy-id "q-22568" :question/problem "For the function $f(x)=\\frac{{e}^{x}}{x},$ defined on the interval $[\\frac{1}{2},2],$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's apply the candidates test step by step.\n\n**Step 1**: We find the critical points. Taking the derivative of $f(x)=\\frac{{e}^{x}}{x},$ we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{e}^{x}\\cdot x-{e}^{x}\\cdot 1}{{x}^{2}} \\\\  & =\\frac{{e}^{x}(x-1)}{{x}^{2}},\\end{aligned}\n$$\n\nand solving ${f}^{′}(x)=0,$ we get \n\n$$\n\\frac{{e}^{x}(x-1)}{{x}^{2}}=0\\,⟹\\,x=1.\n$$\n\nSo, the critical points are $x=1,$ and the endpoints $x=\\frac{1}{2},2$ (since the derivative is not defined at the endpoints).\n\n**Step 2**: We evaluate $f(x)$ at the critical points.\n\n$$\n\\begin{aligned}f\\left(\\frac{1}{2}\\right) & =\\frac{{e}^{1/2}}{\\left(\\frac{1}{2}\\right)}=2\\sqrt{e}≈3.3 \\\\ f(1) & =\\frac{{e}^{1}}{1}=e≈2.7 \\\\ f(2) & =\\frac{{e}^{2}}{2}≈3.7\\end{aligned}\n$$\n\n**Step 3**: We compare all of the values found in step $2.$\n\n- The greatest value is $f(2)=\\frac{{e}^{2}}{2},$ so the global maximum is $\\frac{{e}^{2}}{2}.$\n\n- The smallest value is $f(1)=e,$ so the global minimum is $e.$\n\nTherefore, the correct answer is “The global maximum value is $\\frac{{e}^{2}}{2}$” only.\n\n![](images/98/98156f05b9b6c71c7e5a5753d024d0851a0a779741545ba2d62d3d63af41e824.png)"} {:db/id #edb/ref 17592186290428 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ae09219-cbe3-51a4-9758-3e65ae3b38b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450328} {:answer/id #uuid "14505bd2-4eb0-50e0-a963-6166aebf979e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450329}] :answer-field/correct {:answer/id #uuid "8ae09219-cbe3-51a4-9758-3e65ae3b38b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450328} :answer-field/id #uuid "04e41be3-46ba-58c6-8275-abbe863624b1" :answer-field/key "${f}^{″}(-\\frac{\\pi }{4})>0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451118} {:answer-field/choices [{:answer/id #uuid "52711816-1b38-5181-9bf0-2a37817e64b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450330} {:answer/id #uuid "4c116a79-be72-57e6-9387-3a737501142f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450331}] :answer-field/correct {:answer/id #uuid "52711816-1b38-5181-9bf0-2a37817e64b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450330} :answer-field/id #uuid "231f1243-f3cb-5713-891e-8adf63d2c12a" :answer-field/key "$f(x)$ has a relative minimum at $x=-\\frac{\\pi }{4}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451119} {:answer-field/choices [{:answer/id #uuid "3fa6418e-de9d-5106-8fe9-35210131b70d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450332} {:answer/id #uuid "37bfcd8e-0e0b-51fc-9ec0-cf15499c42a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450333}] :answer-field/correct {:answer/id #uuid "37bfcd8e-0e0b-51fc-9ec0-cf15499c42a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450333} :answer-field/id #uuid "09ffd325-1efe-5648-92b7-a6d4a306ac5f" :answer-field/key "$f(x)$ has a relative maximum at $x=-\\frac{\\pi }{4}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451120}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fba230de-9f3b-5a09-b2a3-45ae981f92cf" :question/math-academy-id "q-22580" :question/problem "Consider the function $f(x)={e}^{-x}\\operatorname{cos}⁡x.$ Given that ${f}^{′}\\left(-\\frac{\\pi }{4}\\right)=0,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "We're given that $x=-\\frac{\\pi }{4}$ is a stationary point of $f(x).$ We will use the second derivative test to classify this stationary point.\n\nCalculating the first derivative for the function $f(x)={e}^{-x}\\operatorname{cos}⁡x,$ we get\n\n$$\n{f}^{′}(x)=-{e}^{-x}\\operatorname{cos}⁡x-{e}^{-x}\\operatorname{sin}⁡x=-{e}^{-x}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x).\n$$\n\nCalculating the second derivative, we get \n\n$$\n{f}^{″}(x)={e}^{-x}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)-{e}^{-x}(-\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)=2{e}^{-x}\\operatorname{sin}⁡x.\n$$\n\nSubstituting $x=-\\frac{\\pi }{4},$ we get\n\n$$\n\\begin{aligned}{f}^{″}\\left(-\\frac{\\pi }{4}\\right) & =2{e}^{\\pi /4}\\operatorname{sin}⁡\\left(-\\frac{\\pi }{4}\\right) \\\\  & =2{e}^{\\pi /4}\\left(-\\frac{\\sqrt{2}}{2}\\right) \\\\  & =-\\sqrt{2}{e}^{\\pi /4}<0.\\end{aligned}\n$$\n\nSince the second derivative is negative, we conclude that $f(x)$ has a relative maximum at $x=-\\frac{\\pi }{4}.$\n\nTherefore, the correct answer is “$f(x)$ has a relative maximum at $x=-\\frac{\\pi }{4}$” only."} {:db/id #edb/ref 17592186290433 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cd2f387-78f6-5f81-a0b2-74b893aa84f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450334} {:answer/id #uuid "b462afe8-7a82-5de1-94cb-63d544016b76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450335}] :answer-field/correct {:answer/id #uuid "3cd2f387-78f6-5f81-a0b2-74b893aa84f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450334} :answer-field/id #uuid "3f48a609-bd28-5c48-bda2-7f7456aa7e99" :answer-field/key "The global maximum value is $\\frac{\\pi }{2}+\\sqrt{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451121} {:answer-field/choices [{:answer/id #uuid "f59c79d5-8789-5c1b-938e-c7305ac7330d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450336} {:answer/id #uuid "255a66d3-f0de-5672-ba3d-426e7335a82b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450337}] :answer-field/correct {:answer/id #uuid "255a66d3-f0de-5672-ba3d-426e7335a82b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450337} :answer-field/id #uuid "9e4ecf85-8f6c-54ce-a92b-6f32afea6b97" :answer-field/key "The global maximum value is $\\frac{2\\pi }{3}+\\sqrt{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451122} {:answer-field/choices [{:answer/id #uuid "3b78c07e-35a8-5942-953e-27aba4fb2e4f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450338} {:answer/id #uuid "82c0972b-3386-575d-bf4f-037b95f13919" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450339}] :answer-field/correct {:answer/id #uuid "82c0972b-3386-575d-bf4f-037b95f13919" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450339} :answer-field/id #uuid "96d9c0d2-e100-53e1-b0b2-381b1cf18674" :answer-field/key "The global minimum value is $0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451123}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b73efa01-82ab-533b-98f8-7ad100b1bc59" :question/math-academy-id "q-22615" :question/problem "For the function $f(x)=x+2\\operatorname{sin}⁡x,$ defined on the closed interval $0\\le x\\le \\pi ,$ which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's apply the candidates test step by step.\n\n**Step 1**: We find the critical points. Taking the derivative of $f(x)=x+2\\operatorname{sin}⁡x,$ we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =1+2\\operatorname{cos}⁡x,\\end{aligned}\n$$\n\nand solving ${f}^{′}(x)=0,$ we get \n\n$$\n1+2\\operatorname{cos}⁡x=0\\,⟹\\,x=\\frac{2\\pi }{3}+2\\pi n,\\,\\,\\,\\frac{4\\pi }{3}+2\\pi n,\n$$\n\nwhere $n$ is an integer. We discard all solutions except $x=\\frac{2\\pi }{3}$ since it is the only value that belongs to the given interval.\n\nSo, the critical points are $x=\\frac{2\\pi }{3},$ and the endpoints $x=0,\\pi $ (since the derivative is not defined at the endpoints).\n\n**Step 2**: We evaluate $f(x)$ at the critical points.\n\n$$\n\\begin{aligned}f(0) & =0+2\\operatorname{sin}⁡(0)=0 \\\\ f\\left(\\frac{2\\pi }{3}\\right) & =\\frac{2\\pi }{3}+2\\operatorname{sin}⁡\\left(\\frac{2\\pi }{3}\\right)=\\frac{2\\pi }{3}+\\sqrt{3}≈3.8 \\\\ f(\\pi ) & =\\pi +2\\operatorname{sin}⁡(\\pi )=\\pi ≈3.1\\end{aligned}\n$$\n\n**Step 3**: We compare all of the values found in step $2.$\n\n- The greatest value is $f\\left(\\frac{2\\pi }{3}\\right)=\\frac{2\\pi }{3}+\\sqrt{3},$ so the global maximum is $\\frac{2\\pi }{3}+\\sqrt{3}.$\n\n- The smallest value is $f(0)=0,$ so the global minimum is $0.$\n\nTherefore, the correct answer is “The global maximum value is $\\frac{2\\pi }{3}+\\sqrt{3}$”; “The global minimum value is $0$” only.\n\n![](images/53/539dc4ccd2f1b20f521ae0f70bb5d95b8c5f9d1a006ff102baf43ac13ce19660.png)"} {:db/id #edb/ref 17592186290439 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d8cc66f-1f66-57e1-9429-a850bb2a1532" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e" :db/id #edb/ref 17592186288452} {:answer/id #uuid "644f2cfb-3c90-5f62-9bdd-8a9c09259168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-1}" :db/id #edb/ref 17592186288740} {:answer/id #uuid "73c6e116-cc93-5722-9adb-f6cb95c14c4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-e" :db/id #edb/ref 17592186288838} {:answer/id #uuid "d9581272-cf1b-5f4d-b09a-8f1621eec4c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)$ does not have any local maxima" :db/id #edb/ref 17592186289482} {:answer/id #uuid "f4efd756-1670-585a-9e8d-90aef6dedd8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186289647}] :answer-field/correct {:answer/id #uuid "f4efd756-1670-585a-9e8d-90aef6dedd8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186289647} :answer-field/id #uuid "44000a28-98b3-5967-b12b-15499669bf86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289881}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e0059b5-82bb-5804-9901-5b360e187e5c" :question/math-academy-id "q-22820" :question/problem "For which value of $x$ does the function $f(x)={e}^{-{x}^{2}/2}$ have a local maximum?" :question/worked-solution "First, we find the stationary points. Differentiating $f(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\left(-\\frac{1}{2}\\right)\\cdot (2x){e}^{-{x}^{2}/2}=-x{e}^{-{x}^{2}/2}.\\end{aligned}\n$$\n\nSolving for ${f}^{′}(x)=0$ gives\n\n$$\n\\begin{aligned}-x{e}^{-{x}^{2}/2} & =0 \\\\ x & =0.\\end{aligned}\n$$\n\nSo $x=0$ is a stationary point. Next, to determine whether this point is a local maximum or minimum, we use the first derivative test.\n\nLet's choose the test points $x=-1,1$ and evaluate the first derivative at these points.\n\n$$\n\\begin{aligned}{f}^{′}(-1) & =-(-1){e}^{-(-1)^{2}/2}={e}^{-1/2}>0 \\\\ {f}^{′}(1) & =-(1){e}^{-(1)^{2}/2}=-{e}^{-1/2}<0\\end{aligned}\n$$\n\nWe summarize the information in a table, shown below.\n\n| $x$ | $(-\\infty ,0)$ | $0$ | $(0,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $-1$ |  | $1$ |\n| ${f}^{′}$ | $+$ | $0$ | $-$ |\n| $f$ | $↗$ | max | $↘$ |\n\nFinally, let's use the table above to classify the critical point.\n\n- At $x=0,$ the first derivative changes sign from positive to negative. Therefore, $x=0$ is a local maximum.\n\nWe conclude that $f(x)$ has a local maximum at $x=0.$"} {:db/id #edb/ref 17592186290442 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e268375-538a-538a-80bc-2f086cffdbb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x}{1-\\operatorname{ln}⁡(2)\\,{2}^{y}}" :db/id #edb/ref 17592186288224} {:answer/id #uuid "793b6c32-8350-533d-bf9d-724d40064c5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{2}^{y}}{6x-\\operatorname{ln}⁡2\\,}" :db/id #edb/ref 17592186288865} {:answer/id #uuid "a3589f85-19fc-5bd4-ac3b-96bf622c2422" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x}{\\operatorname{ln}⁡(2)\\,{2}^{y}}" :db/id #edb/ref 17592186289122} {:answer/id #uuid "e0d85bbf-5174-563d-a666-9a94bd4cf6fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x}{{2}^{y}}" :db/id #edb/ref 17592186289532} {:answer/id #uuid "e27c90f5-ce7c-52d7-8488-fe25083eb2d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x}{1-{2}^{y}}" :db/id #edb/ref 17592186289540}] :answer-field/correct {:answer/id #uuid "1e268375-538a-538a-80bc-2f086cffdbb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x}{1-\\operatorname{ln}⁡(2)\\,{2}^{y}}" :db/id #edb/ref 17592186288224} :answer-field/id #uuid "3f58fa9b-a3f6-53aa-a4c8-4680d5988ce9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289871}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "623f14ca-5670-5819-81c3-5ed253df18c6" :question/math-academy-id "q-2289" :question/problem "Given that  $y-{2}^{y}=3{x}^{2},$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$ \n\n$$\n\\begin{aligned}\\begin{aligned}y-{2}^{y} & =3{x}^{2} \\\\ \\frac{\\text{d}}{\\text{d}x}(y-{2}^{y}) & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}x}(y)-\\frac{\\text{d}}{\\text{d}x}({2}^{y}) & =6x \\\\ (1-\\operatorname{ln}⁡(2){2}^{y})\\left(\\frac{\\text{d}y}{\\text{d}x}\\right) & =6x\\end{aligned}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}(1-\\operatorname{ln}⁡(2)\\,{2}^{y}) & =6x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{6x}{1-\\operatorname{ln}⁡(2)\\,{2}^{y}}\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290443 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "078c6f54-8a90-570d-b35c-a74273909664" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\operatorname{cot}⁡(3x)}{3y+1}" :db/id #edb/ref 17592186288093} {:answer/id #uuid "2246442e-020d-574a-8441-1430c141e7c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{cot}^{2}⁡(3x)}{2y+1}" :db/id #edb/ref 17592186288251} {:answer/id #uuid "a389ed33-85ab-5efc-b38c-37f637636ddc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{sec}^{2}⁡(3x)}{y+1}" :db/id #edb/ref 17592186289125} {:answer/id #uuid "b3b1f7f5-2930-5b7c-b842-100eb308f5ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{sec}^{2}⁡(3x)}{2y+1}" :db/id #edb/ref 17592186289219} {:answer/id #uuid "cb43772c-130c-57f1-8c10-6233e01d16ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\operatorname{cot}⁡(3x)}{y+1}" :db/id #edb/ref 17592186289379}] :answer-field/correct {:answer/id #uuid "b3b1f7f5-2930-5b7c-b842-100eb308f5ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{sec}^{2}⁡(3x)}{2y+1}" :db/id #edb/ref 17592186289219} :answer-field/id #uuid "0e55e3cc-8566-5ead-b496-998e3c5f2250" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289764}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "610d7896-a073-528d-972b-ac6b8950750a" :question/math-academy-id "q-2290" :question/problem "Given that $\\operatorname{tan}⁡(3x)-{y}^{2}=y,$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\begin{aligned}\\operatorname{tan}⁡(3x)-{y}^{2} & =y \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡(3x)-{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(y) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡(3x))-\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(y) \\\\ 3{sec}^{2}⁡(3x)-2y\\left(\\frac{\\text{d}y}{\\text{d}x}\\right) & =\\left(\\frac{\\text{d}y}{\\text{d}x}\\right)\\end{aligned}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}3{sec}^{2}⁡(3x) & =\\frac{\\text{d}y}{\\text{d}x}(2y+1) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{3{sec}^{2}⁡(3x)}{2y+1}\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290446 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48b18049-7583-596d-ad87-b5eddc046ccf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\pi \\,\\text{mm}\\text{/min}" :db/id #edb/ref 17592186288537} {:answer/id #uuid "4cd42cfd-ce66-5b08-82a1-b01663000347" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi \\,\\text{mm}\\text{/min}" :db/id #edb/ref 17592186288563} {:answer/id #uuid "8e27c1b9-c34e-5e1c-a3a5-e0dbe9f0f29b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi \\,\\text{mm}\\text{/min}" :db/id #edb/ref 17592186288983} {:answer/id #uuid "bc56ac2e-bc54-55ac-bf5c-46c030468f0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\text{mm}\\text{/min}" :db/id #edb/ref 17592186289275} {:answer/id #uuid "c10fd0ce-0285-5a11-a7ed-4e323765adbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5\\,\\text{mm}\\text{/min}" :db/id #edb/ref 17592186289308}] :answer-field/correct {:answer/id #uuid "48b18049-7583-596d-ad87-b5eddc046ccf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\pi \\,\\text{mm}\\text{/min}" :db/id #edb/ref 17592186288537} :answer-field/id #uuid "59c3ef38-4604-5614-bc60-f235e8aaea0a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289919}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f026249b-e7ad-5955-bed7-719a23da6a3a" :question/math-academy-id "q-22997" :question/problem "![](images/70/701c883ef9f721f9dad8fb59236fbbd297cfac3d3d8845a18d3493d788f8d8a8.png)\n\nPaint is leaking from a tank and is forming a circle on the floor. If the area of the circle is increasing at the rate of $12\\pi \\,{\\text{mm}}^{2}/\\text{min}$, how fast is the circumference of the circle increasing at the moment when the radius is $4\\,\\text{mm}?$" :question/worked-solution "In this situation, we want to find $\\frac{\\text{d}C}{\\text{d}t}$ at the moment when $r=4,$ and we are also told that  $\\frac{\\text{d}A}{\\text{d}t}=12\\pi .$\n\nTo start, let's set up an equation relating the area $A$ and the circumference $C$ of the circle. Since $C=2\\pi r$ and $A=\\pi {r}^{2},$ the relationship between $A$ and $C$ is\n\n$$\nA=\\pi {r}^{2}=\\pi {\\left(\\frac{C}{2\\pi }\\right)}^{2}=\\frac{{C}^{2}}{4\\pi }.\n$$\n\nDifferentiating this relationship with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(A) & =\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{{C}^{2}}{4\\pi }\\right) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}C}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}C}\\left(\\frac{{C}^{2}}{4\\pi }\\right) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}C}{\\text{d}t}\\cdot \\frac{C}{2\\pi }.\\end{aligned}\n$$\n\nWhen $r=4\\,\\text{mm},$ $C=2\\pi (4)=8\\pi \\text{ mm}.$ Hence, substituting $\\frac{\\text{d}A}{\\text{d}t}=12\\pi $ and $C=8\\pi $, and solving for $\\frac{\\text{d}A}{\\text{d}t}.$ We get\n\n$$\n\\begin{aligned}12\\pi  & =\\frac{\\text{d}C}{\\text{d}t}\\cdot \\frac{8\\pi }{2\\pi } \\\\ 12\\pi  & =\\frac{\\text{d}C}{\\text{d}t}\\cdot 4 \\\\ \\frac{\\text{d}C}{\\text{d}t} & =\\frac{12\\pi }{4} \\\\ \\frac{\\text{d}C}{\\text{d}t} & =3\\pi .\\end{aligned}\n$$\n\nWe conclude that the circumference is increasing at a rate of $3\\pi \\text{ mm/min}.$"} {:db/id #edb/ref 17592186290449 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02a71e23-0acc-56b3-954d-83821eac7e61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186288050} {:answer/id #uuid "44b4646f-0c19-57a3-bdf3-8ad3609e015a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{32}" :db/id #edb/ref 17592186288498} {:answer/id #uuid "7769db55-4f82-5ad4-abd8-f7f093ba576d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186288856} {:answer/id #uuid "bd830b0e-ef09-5fa8-8c16-55c6bc0ac78d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{15}}{4}" :db/id #edb/ref 17592186289280} {:answer/id #uuid "dc81901a-30cb-5088-a113-f77b69120c2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186289500}] :answer-field/correct {:answer/id #uuid "bd830b0e-ef09-5fa8-8c16-55c6bc0ac78d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{15}}{4}" :db/id #edb/ref 17592186289280} :answer-field/id #uuid "64e92ee8-c463-5350-91b5-0bace844e68b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289946}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "122300d6-48f4-52e5-9b3e-da4687523cb3" :question/math-academy-id "q-23216" :question/problem "The point $A$ is located in the first quadrant and lies on the unit circle. The $x$-coordinate of $A$ is $\\frac{1}{4}.$ What is the $y$-coordinate of $A?$" :question/worked-solution "Since the point $A$ lies on the unit circle, it must satisfy the Pythagorean theorem: \n\n$$\n{x}^{2}+{y}^{2}=1\n$$\n\nSubstituting $x=\\frac{1}{4}$ into the above and solving for $y$ gives,\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =1 \\\\ {\\left(\\frac{1}{4}\\right)}^{2}+{y}^{2} & =1 \\\\ \\frac{1}{16}+{y}^{2} & =1 \\\\ {y}^{2} & =1-\\frac{1}{16} \\\\ {y}^{2} & =\\frac{15}{16} \\\\ y & =\\sqrt{\\frac{15}{16}} \\\\ y & =\\pm \\frac{\\sqrt{15}}{4}.\\end{aligned}\n$$\n\nSince $A$ lies in the first quadrant, $y$ must be positive, so we select the positive answer. Therefore, our final answer is $y=\\frac{\\sqrt{15}}{4}.$"} {:db/id #edb/ref 17592186290450 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "041bb980-2220-5c0f-b904-f70291dc858b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\sqrt{29}}{12}" :db/id #edb/ref 17592186288059} {:answer/id #uuid "1bcd216a-5d96-580d-89a1-1300b816ea9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\sqrt{29}}{12}" :db/id #edb/ref 17592186288211} {:answer/id #uuid "6428772c-31cb-5d11-ad40-b384b65de264" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\sqrt{23}}{12}" :db/id #edb/ref 17592186288738} {:answer/id #uuid "a6ab4c14-8b8f-5d7f-941d-c5430187106a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\sqrt{23}}{12}" :db/id #edb/ref 17592186289135} {:answer/id #uuid "b4335ae8-54ab-5f8c-98b6-6b1f10f60c80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{7\\sqrt{33}}{12}" :db/id #edb/ref 17592186289224}] :answer-field/correct {:answer/id #uuid "6428772c-31cb-5d11-ad40-b384b65de264" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\sqrt{23}}{12}" :db/id #edb/ref 17592186288738} :answer-field/id #uuid "94cc4b6d-4396-5dd4-a8e0-bcf717fb1b6e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290063}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "808fb241-7b41-5e43-96f3-08a62164f95c" :question/math-academy-id "q-23289" :question/problem "![](images/89/8904a5ebafade54a46cee77a2e20cac255c888d257ef1c208b2def32d247f2cd.png)\n\nThe point $P$ is located on the unit circle, as shown above. The $y$-coordinate of $P$ is $\\frac{11}{12}.$ What is the $x$-coordinate of $P?$" :question/worked-solution "Since the point $P$ lies on the unit circle, it must satisfy the Pythagorean theorem: \n\n$$\n{x}^{2}+{y}^{2}=1\n$$\n\nSubstituting $y=\\frac{11}{12}$ into the above and solving for $x$ gives\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =1 \\\\ {x}^{2}+{\\left(\\frac{11}{12}\\right)}^{2} & =1 \\\\ {x}^{2}+\\left(\\frac{121}{144}\\right) & =1 \\\\ {x}^{2} & =1-\\frac{121}{144} \\\\ {x}^{2} & =\\frac{23}{144} \\\\ x & =\\pm \\sqrt{\\frac{23}{144}} \\\\ x & =\\pm \\frac{\\sqrt{23}}{12}.\\end{aligned}\n$$\n\nFinally, we select the negative answer since $x$ is negative in the second quadrant. So our final answer is $x=-\\frac{\\sqrt{23}}{12}.$"} {:db/id #edb/ref 17592186290451 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35c7e725-b76a-5ca3-8f68-81dde24e12fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "tan⁡\\theta =2\\sqrt{3}" :db/id #edb/ref 17592186288393} {:answer/id #uuid "47f9a517-21ec-5bde-9415-58fb02a4d95f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "tan⁡\\theta =\\sqrt{3}" :db/id #edb/ref 17592186288529} {:answer/id #uuid "67d96bb0-aef1-5c39-b7de-845d48da5707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "tan⁡\\theta =7\\sqrt{11}" :db/id #edb/ref 17592186288761} {:answer/id #uuid "ae74efb7-3f7b-5281-8d41-2f4067dc2059" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "tan⁡\\theta =-2\\sqrt{3}" :db/id #edb/ref 17592186289188} {:answer/id #uuid "e6308953-e63f-50f5-9353-0e539006938f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "tan⁡\\theta =-\\sqrt{3}" :db/id #edb/ref 17592186289559}] :answer-field/correct {:answer/id #uuid "47f9a517-21ec-5bde-9415-58fb02a4d95f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "tan⁡\\theta =\\sqrt{3}" :db/id #edb/ref 17592186288529} :answer-field/id #uuid "bd274261-7c8a-5928-bc7a-5397a25e3e31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290141}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0ca170ad-d931-5618-b051-e0ab68f9da15" :question/math-academy-id "q-23307" :question/problem "If $cos⁡\\theta =-\\frac{1}{2}$ and ${180}^{∘}<\\theta <{270}^{∘},$ then what is the value of $tan⁡\\theta ?$" :question/worked-solution "Let's sketch our angle $\\theta $ in the coordinate plane.\n\n![](images/78/7873579bb5dd1976330ec24f13b30dd384f916cf23bbf48aac4b2a522ee9548a.png)\n\nWe're given that $cos⁡\\theta =-\\frac{1}{2}.$ We can use the Pythagorean identity to find $sin⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ sin⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $cos⁡\\theta =-\\frac{1}{2}$ gives\n\n$$\n\\begin{aligned}sin⁡\\theta  & =\\pm \\sqrt{1-{\\left(-\\frac{1}{2}\\right)}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{1}{4}} \\\\  & =\\pm \\sqrt{\\frac{3}{4}} \\\\  & =\\pm \\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$\n\nWe select the negative answer since $sin⁡\\theta $ is negative in the third quadrant. So, $sin⁡\\theta =-\\frac{\\sqrt{3}}{2}.$\n\nFinally, knowing that $tan⁡\\theta =\\frac{sin⁡\\theta }{cos⁡\\theta },$ we have\n\n$$\ntan⁡\\theta =\\frac{\\left(-\\frac{\\sqrt{3}}{2}\\right)}{\\left(-\\frac{1}{2}\\right)}=\\sqrt{3}.\n$$"} {:db/id #edb/ref 17592186290454 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ab5f17a-ad0a-556d-a84f-44722fb0d6ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{5}x-6" :db/id #edb/ref 17592186288550} {:answer/id #uuid "5116bc05-fd69-5be0-a504-ed30dfd42624" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}x-2" :db/id #edb/ref 17592186288592} {:answer/id #uuid "59bee7f4-e83f-51b9-9cc9-d676591fbbd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-5x-5" :db/id #edb/ref 17592186288659} {:answer/id #uuid "9d16c0cb-3599-5030-a394-a78db74b8a59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5x+1" :db/id #edb/ref 17592186289091} {:answer/id #uuid "dfb85e27-3df2-5da0-b01b-d5dde1094b2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{5}{2}x+3" :db/id #edb/ref 17592186289527}] :answer-field/correct {:answer/id #uuid "4ab5f17a-ad0a-556d-a84f-44722fb0d6ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{5}x-6" :db/id #edb/ref 17592186288550} :answer-field/id #uuid "82f998a6-4d5e-5f76-b4d5-c1d6c09f0f7d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290020}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8f4b2fab-afe0-5fd3-a151-d84c2b56dabe" :question/math-academy-id "q-23378" :question/problem "Which of the following lines is perpendicular to $5x-y=7?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nTo find the slope of the given line $5x-y=7,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}5x-y & =7 \\\\ -y & =-5x+7 \\\\ y & =5x-7\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope of the given line is $5.$\n\nLooking at the answer choices, the line $y=-\\frac{1}{5}x-6$ has a slope of $-\\frac{1}{5}.$\n\nMultiplying the slopes together, we have\n\n$$\n5\\cdot \\left(-\\frac{1}{5}\\right)=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=-\\frac{1}{5}x-6$ is perpendicular to the given line."} {:db/id #edb/ref 17592186290455 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0720b1d3-b02d-51fb-aa2b-6c735a13c674" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{7}" :db/id #edb/ref 17592186288086} {:answer/id #uuid "3a35c247-c66a-50e1-8e3b-cdc85b3275a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{5}" :db/id #edb/ref 17592186288433} {:answer/id #uuid "63ea0fca-fb59-5bee-919c-60e7cac617cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{2}" :db/id #edb/ref 17592186288733} {:answer/id #uuid "bf83289b-9e2b-58b3-8f05-c2f3bc053721" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}}{2}" :db/id #edb/ref 17592186289296} {:answer/id #uuid "e39be6f6-f42a-54ab-9e07-f874403d2e84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186289543}] :answer-field/correct {:answer/id #uuid "e39be6f6-f42a-54ab-9e07-f874403d2e84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186289543} :answer-field/id #uuid "8f62278d-a9fd-5788-be4d-75f24b8a0bb3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290044}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "eada5d72-6d70-5c39-a9a3-abb525221d5d" :question/math-academy-id "q-23386" :question/problem "$\\operatorname{sin}⁡\\left(\\frac{2\\pi }{3}\\right)=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{2\\pi }{3}$ corresponds to the point $(-\\frac{1}{2},\\frac{\\sqrt{3}}{2}).$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}⁡\\left(\\frac{2\\pi }{3}\\right)=\\frac{\\sqrt{3}}{2}.$"} {:db/id #edb/ref 17592186290457 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "711d3ef5-78a9-5704-9497-965f7a2fad29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-3a+\\frac{27}{8}{a}^{2}" :db/id #edb/ref 17592186288821}] :answer-field/correct {:answer/id #uuid "711d3ef5-78a9-5704-9497-965f7a2fad29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-3a+\\frac{27}{8}{a}^{2}" :db/id #edb/ref 17592186288821} :answer-field/id #uuid "7efe9f72-13d1-59c4-8a43-d34a1085f9bf" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290007}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a495ff01-2ceb-5e8e-8461-144b7298fb64" :question/math-academy-id "q-234003" :question/problem "Find, in ascending powers of $a,$ the **first three terms** of the binomial expansion of ${(1-\\frac{3a}{4})}^{4}.$\n\n${(1-\\frac{3a}{4})}^{4}=$\n{{field-1}}$\\,+\\,⋯$" :question/worked-solution "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n{(1+x)}^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=-\\frac{3a}{4}$ and $n=4$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-\\frac{3a}{4})}^{4} & =1+4\\cdot \\left(-\\frac{3a}{4}\\right)+\\frac{4(4-1)}{2!}\\cdot {\\left(-\\frac{3a}{4}\\right)}^{2}+⋯ \\\\  & =1-3a+\\frac{4\\cdot 3}{2}\\cdot \\frac{9{a}^{2}}{16}+⋯ \\\\  & =1-3a+6\\cdot \\frac{9{a}^{2}}{16}+⋯ \\\\  & =1-3a+\\frac{27}{8}{a}^{2}+⋯.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290460 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1024e4c0-bbcd-5e61-84f8-3dff5e50f5d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{7}{3}x-3" :db/id #edb/ref 17592186288154} {:answer/id #uuid "297e02ff-5dc0-5fd3-8271-aee2c38fccd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{3}{4}x-3" :db/id #edb/ref 17592186288308} {:answer/id #uuid "6a24547b-b78e-5d0e-90b1-33cec5f86ea3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5x-3" :db/id #edb/ref 17592186288781} {:answer/id #uuid "c3fb0467-1a97-512a-aa0f-150efb576a10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2x-3" :db/id #edb/ref 17592186289326} {:answer/id #uuid "c4988bec-b2bd-5011-9ca7-75d333c159db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{4}{3}x-3" :db/id #edb/ref 17592186289332}] :answer-field/correct {:answer/id #uuid "297e02ff-5dc0-5fd3-8271-aee2c38fccd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{3}{4}x-3" :db/id #edb/ref 17592186288308} :answer-field/id #uuid "c865f6fa-cf35-513a-a3d6-3e960c11b6b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290166}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e6cef704-dc0c-5ab7-9bc9-e3a20f725642" :question/math-academy-id "q-23453" :question/problem "Find the equation of the line that passes through the point $(0,-3)$ and is perpendicular to the line passing through the points $(1,7)$ and $(-5,-1).$" :question/worked-solution "Perpendicular lines have slopes which are negative reciprocals of each other.\n\nFirst, let's find the slope ${m}_{1}$ of the line passing through the points $(1,7)$ and $(-5,-1):$\n\n$$\n\\begin{aligned}{m}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{-1-7}{-5-1} \\\\  & =\\frac{-8}{-6} \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$\n\nSince we want a perpendicular line, the slope $m$ of the line we're trying to find must satisfy\n\n$$\nm\\cdot \\left(\\frac{4}{3}\\right)=-1\\,⇒\\,m=-\\frac{3}{4}.\n$$\n\nWe know that the line passes through the point $(0,-3).$ Using point-slope form and simplifying, we obtain the equation of the line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-3) & =-\\frac{3}{4}(x-0) \\\\ y+3 & =-\\frac{3}{4}x \\\\ y & =-\\frac{3}{4}x-3\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290467 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "024b201d-1f92-50ed-86c4-924d997fdb4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{8}x+2" :db/id #edb/ref 17592186288044} {:answer/id #uuid "1a123798-3e82-5dfd-b1c8-8957afb9eb03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=8x+1" :db/id #edb/ref 17592186288199} {:answer/id #uuid "4ca8f36c-3736-5083-b8c0-1ea1a20e87e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{8}x+8" :db/id #edb/ref 17592186288562} {:answer/id #uuid "9798fd68-08ed-5dca-816e-719af4488d46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x+8" :db/id #edb/ref 17592186289050} {:answer/id #uuid "a2145085-fafd-584c-a16a-371243f7b8e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-8x+2" :db/id #edb/ref 17592186289114}] :answer-field/correct {:answer/id #uuid "4ca8f36c-3736-5083-b8c0-1ea1a20e87e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{8}x+8" :db/id #edb/ref 17592186288562} :answer-field/id #uuid "a1c789d9-59fc-5012-acd4-f57fa0ecbd80" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290089}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "10634cc5-0e61-5b63-a591-be33d692e732" :question/math-academy-id "q-23618" :question/problem "Which of the following lines is perpendicular to $8x-y=2?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nTo find the slope of the given line $8x-y=2,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}8x-y & =2 \\\\ -y & =-8x+2 \\\\ y & =8x-2\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope of the given line is $8.$\n\nLooking at the answer choices, the line $y=-\\frac{1}{8}x+8$ has a slope of $-\\frac{1}{8}.$\n\nMultiplying the slopes together, we have\n\n$$\n8\\cdot \\left(-\\frac{1}{8}\\right)=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=-\\frac{1}{8}x+8$ is perpendicular to the given line."} {:db/id #edb/ref 17592186290468 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b644ab2-4c21-5aeb-9032-26a79415192f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{3}" :db/id #edb/ref 17592186288444} {:answer/id #uuid "540e1587-3f3e-52a8-8424-5abf66ff30e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{3}x" :db/id #edb/ref 17592186288610} {:answer/id #uuid "70b1df14-3de9-50cb-8b16-2a2eec5b3954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3x" :db/id #edb/ref 17592186288816} {:answer/id #uuid "959ae715-31b5-5f44-931c-f40632872d6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3x+1" :db/id #edb/ref 17592186289030} {:answer/id #uuid "c2d44e35-06ab-5ae0-8bfd-256c7f07808a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{3}x-3" :db/id #edb/ref 17592186289319}] :answer-field/correct {:answer/id #uuid "70b1df14-3de9-50cb-8b16-2a2eec5b3954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3x" :db/id #edb/ref 17592186288816} :answer-field/id #uuid "990087b9-37dc-5d9d-b34d-123762544320" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290071}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d4eec6d2-1c29-5a4c-9b34-ea67f65dce06" :question/math-academy-id "q-23621" :question/problem "Which of the following lines is perpendicular to $x+3y=6?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nTo find the slope of the given line $x+3y=6,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}x+3y & =6 \\\\ 3y & =-x+6 \\\\ y & =-\\frac{1}{3}x+2\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope of the given line is $-\\frac{1}{3}.$\n\nLooking at the answer choices, the line $y=3x$ has a slope of $3.$\n\nMultiplying the slopes together, we have\n\n$$\n\\left(-\\frac{1}{3}\\right)\\cdot 3=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=3x$ is perpendicular to the given line."} {:db/id #edb/ref 17592186290498 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "701eb222-0215-5e1e-aeed-f86ef2b1e8b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{5}x-2" :db/id #edb/ref 17592186288811}] :answer-field/correct {:answer/id #uuid "701eb222-0215-5e1e-aeed-f86ef2b1e8b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{5}x-2" :db/id #edb/ref 17592186288811} :answer-field/id #uuid "57e36efb-7123-5c18-8518-75c3551a7b86" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289915}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7172ccc4-2a2a-5ae6-a89d-55424e3bf138" :question/math-academy-id "q-237224" :question/problem "What is the equation of the line that passes through the point $(0,-2)$ and is perpendicular to the line passing through the points $(-2,4)$ and $(4,-1)?$\n\n$y=$\n{{field-1}}" :question/worked-solution "Perpendicular lines have slopes that are negative reciprocals of each other.\n\nFirst, let's find the slope ${m}_{1}$ of the line passing through the points $(-2,4)$ and $(4,-1):$\n\n$$\n\\begin{aligned}{m}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{-1-4}{4-(-2)} \\\\  & =\\frac{-1-4}{4+2} \\\\  & =-\\frac{5}{6}\\end{aligned}\n$$\n\nSince we want a perpendicular line, the slope $m$ of the line we're trying to find must satisfy\n\n$$\nm\\cdot \\left(-\\frac{5}{6}\\right)=-1\\,⇒\\,m=\\frac{6}{5}.\n$$\n\nWe know that the line passes through the point $(0,-2).$ Using point-slope form and simplifying, we obtain the equation of the line in slope-intercept form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-2) & =\\frac{6}{5}(x-0) \\\\ y+2 & =\\frac{6}{5}x \\\\ y & =\\frac{6}{5}x-2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290499 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2deda78d-e190-5ac6-8f09-dfdafe1448fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{7}x-5" :db/id #edb/ref 17592186288341}] :answer-field/correct {:answer/id #uuid "2deda78d-e190-5ac6-8f09-dfdafe1448fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{7}x-5" :db/id #edb/ref 17592186288341} :answer-field/id #uuid "5fb2bc39-aed8-54cc-8f5c-a5e009a5e97a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289937}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "01d34255-de74-5cbb-862e-52884bec6cfd" :question/math-academy-id "q-237225" :question/problem "What is the equation of the line that passes through the point $(0,-5)$ and is perpendicular to the line passing through the points $(1,-3)$ and $(3,4)?$\n\n$y=$\n{{field-1}}" :question/worked-solution "Perpendicular lines have slopes that are negative reciprocals of each other.\n\nFirst, let's find the slope ${m}_{1}$ of the line passing through the points $(1,-3)$ and $(3,4):$\n\n$$\n\\begin{aligned}{m}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{4-(-3)}{3-1} \\\\  & =\\frac{4+3}{3-1} \\\\  & =\\frac{7}{2}\\end{aligned}\n$$\n\nSince we want a perpendicular line, the slope $m$ of the line we're trying to find must satisfy\n\n$$\nm\\cdot \\left(\\frac{7}{2}\\right)=-1\\,⇒\\,m=-\\frac{2}{7}.\n$$\n\nWe know that the line passes through the point $(0,-5).$ Using point-slope form and simplifying, we obtain the equation of the line in slope-intercept form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-5) & =-\\frac{2}{7}(x-0) \\\\ y+5 & =-\\frac{2}{7}x \\\\ y & =-\\frac{2}{7}x-5\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290504 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05923f64-0178-515d-b1c0-8a34f89bf2d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{(3-{x}^{2})}^{6}}{12}+C" :db/id #edb/ref 17592186288070} {:answer/id #uuid "33e66623-ff10-5d20-8993-f2536250f43c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{(3-{x}^{2})}^{6}}{6}+C" :db/id #edb/ref 17592186288373} {:answer/id #uuid "38e8f95c-0391-5a44-87d6-e145b0a88952" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{(3-{x}^{2})}^{5}}{5}+C" :db/id #edb/ref 17592186288422} {:answer/id #uuid "52abbeaf-48c8-5e31-8c3a-14d2a081d694" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{(3-{x}^{2})}^{6}}{4}+C" :db/id #edb/ref 17592186288606} {:answer/id #uuid "b0632e15-3fe5-52f8-9671-b43672893723" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{(3-{x}^{2})}^{6}}{6}+C" :db/id #edb/ref 17592186289198}] :answer-field/correct {:answer/id #uuid "05923f64-0178-515d-b1c0-8a34f89bf2d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{(3-{x}^{2})}^{6}}{12}+C" :db/id #edb/ref 17592186288070} :answer-field/id #uuid "fa27dea5-b8ee-51a6-a6c0-5aa2c0cfdffb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290248}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "46e8f3d6-924e-554c-9c9c-a93b6ef8fe0f" :question/math-academy-id "q-2379" :question/problem "$\\int x{(3-{x}^{2})}^{5}\\,\\text{d}x=$" :question/worked-solution "In this case, the $x$ that's outside the parentheses isn't quite the derivative of $(3-{x}^{2}).$ But the derivative is $-2x,$ so we're only out by a constant factor. \n\nSo we make the substitution\n\n$$\nu=3-{x}^{2}.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =-2x\\,⟹\\,\\left(-\\frac{1}{2}\\right)\\text{d}u=x\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int x{(3-{x}^{2})}^{5}\\,\\text{d}x & =\\int {(3-{x}^{2})}^{5}\\cdot x\\,\\text{d}x \\\\  & =\\int {u}^{5}\\cdot \\left(-\\frac{1}{2}\\right)\\text{d}u \\\\  & =-\\frac{1}{2}\\int {u}^{5}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}-\\frac{1}{2}\\int {u}^{5}\\,\\text{d}u & =-\\frac{1}{2}\\cdot \\frac{{u}^{6}}{6}+C \\\\  & =-\\frac{1}{12}{u}^{6}+C \\\\  & =-\\frac{1}{12}{(3-{x}^{2})}^{6}+C \\\\  & =-\\frac{{(3-{x}^{2})}^{6}}{12}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290518 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2029e990-e06c-5de3-bbb1-b0f88ba76514" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3(5{x}^{2}-4)^{3/2}}{2}+C" :db/id #edb/ref 17592186288239} {:answer/id #uuid "26e955b2-8d3d-529c-aa79-f141fc091ae9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(5{x}^{2}-4)^{3/2}}{3}+C" :db/id #edb/ref 17592186288288} {:answer/id #uuid "2df24f84-49a3-5635-8292-77d1429d86ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2(5{x}^{2}-4)^{3/2}}{3}+C" :db/id #edb/ref 17592186288342} {:answer/id #uuid "836b0c8d-6627-5e01-a339-6971dc4ede71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(5{x}^{2}-4)^{2/3}+C" :db/id #edb/ref 17592186288915} {:answer/id #uuid "b431a516-679a-55de-bc9a-2dca5dba0032" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(5{x}^{2}-4)^{2/3}}{2}+C" :db/id #edb/ref 17592186289223}] :answer-field/correct {:answer/id #uuid "26e955b2-8d3d-529c-aa79-f141fc091ae9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(5{x}^{2}-4)^{3/2}}{3}+C" :db/id #edb/ref 17592186288288} :answer-field/id #uuid "8489e6ea-2848-5483-8e22-602ea51d9d4b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290022}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f908f52d-efaa-5ed9-92ad-fd2900015e8a" :question/math-academy-id "q-2390" :question/problem "Calculate $\\int 10x\\sqrt{5{x}^{2}-4}\\,\\text{d}x.$" :question/worked-solution "We note that $10x$ is the derivative of the quantity in the square root. So we make a substitution\n\n$$\nu=5{x}^{2}-4.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =10x\\,⟹\\,\\text{d}u=10x\\,\\text{d}x,\\end{aligned}\n$$\n\nand rewriting our integral, we get\n\n$$\n\\begin{aligned}\\int 10x\\sqrt{5{x}^{2}-4}\\,\\text{d}x & =\\int \\sqrt{5{x}^{2}-4}\\,10x\\,\\text{d}x \\\\  & =\\int \\sqrt{u}\\,\\text{d}u \\\\  & =\\int {u}^{1/2}\\,\\text{d}u.\\end{aligned}\n$$\n\nWe can now solve the integral using the power rule:\n\n$$\n\\begin{aligned}\\int {u}^{1/2}\\,\\text{d}u & =\\frac{{u}^{3/2}}{\\left(\\frac{3}{2}\\right)}+C \\\\  & =\\frac{2{u}^{3/2}}{3}+C\\end{aligned}\n$$\n\nLastly, we substitute $u=5{x}^{2}-4$ back in the expression. So the final result is\n\n$$\n\\int 10x\\sqrt{5{x}^{2}-4}\\,\\text{d}x=\\frac{2(5{x}^{2}-4)^{3/2}}{3}+C.\n$$"} {:db/id #edb/ref 17592186290521 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25db7b46-2d5d-595a-8da7-747d2ddd12b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x\\operatorname{cos}⁡x+2x\\operatorname{sin}⁡x}{\\operatorname{sin}⁡x}" :db/id #edb/ref 17592186288282} {:answer/id #uuid "5d85a103-3ef8-59d4-8e84-637387fa0c40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{x}^{2}\\operatorname{sin}⁡x}{\\sqrt{\\operatorname{sin}⁡x}}-x\\sqrt{\\operatorname{sin}⁡x}" :db/id #edb/ref 17592186288686} {:answer/id #uuid "922058af-c9bd-5099-865a-eed92655f212" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{x}^{2}\\operatorname{sin}⁡x-8x\\operatorname{sin}⁡x}{\\sqrt{\\operatorname{sin}⁡x}}" :db/id #edb/ref 17592186289014} {:answer/id #uuid "99fc2ea7-0124-5d04-bc08-8eef810aff45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8x\\operatorname{sin}⁡x+2{x}^{2}\\operatorname{cos}⁡x}{\\sqrt{\\operatorname{sin}⁡x}}" :db/id #edb/ref 17592186289061} {:answer/id #uuid "b4a9b433-04de-5c42-b250-5744d10efff4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2{x}^{2}\\operatorname{cos}⁡x}{\\sqrt{\\operatorname{cos}⁡x}}+8x\\sqrt{\\operatorname{sin}⁡x}" :db/id #edb/ref 17592186289226}] :answer-field/correct {:answer/id #uuid "99fc2ea7-0124-5d04-bc08-8eef810aff45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8x\\operatorname{sin}⁡x+2{x}^{2}\\operatorname{cos}⁡x}{\\sqrt{\\operatorname{sin}⁡x}}" :db/id #edb/ref 17592186289061} :answer-field/id #uuid "04b0a0d1-3edc-5da1-b114-a49367e0bb38" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289737}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f5501845-7745-5f41-81f4-6fab62788d36" :question/math-academy-id "q-2401" :question/problem "Find ${y}^{′}$ for $y=4{x}^{2}\\sqrt{\\operatorname{sin}⁡x}.$" :question/worked-solution "This question requires the product rule. Let $u(x)=4{x}^{2}$ and $v(x)=\\sqrt{\\operatorname{sin}⁡x}.$ Then\n\n$$\n{u}^{′}(x)=8x,\\,{v}^{′}(x)=\\frac{\\operatorname{cos}⁡x}{2\\sqrt{\\operatorname{sin}⁡x}}.\n$$\n\nNote that we used the chain rule to differentiate $v.$\n\nNow, applying the product rule and simplifying, we have\n\n$$\n\\begin{aligned}{y}^{′}=\\frac{\\text{d}y}{\\text{d}x} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(8x)(\\sqrt{\\operatorname{sin}⁡x})+(4{x}^{2})\\left(\\frac{\\operatorname{cos}⁡x}{2\\sqrt{\\operatorname{sin}⁡x}}\\right) \\\\  & =8x\\sqrt{\\operatorname{sin}⁡x}+\\frac{2{x}^{2}\\operatorname{cos}⁡x}{\\sqrt{\\operatorname{sin}⁡x}} \\\\  & =\\frac{8x\\operatorname{sin}⁡x+2{x}^{2}\\operatorname{cos}⁡x}{\\sqrt{\\operatorname{sin}⁡x}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290522 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "018421ea-dca9-5daf-ab3a-c27696ce4249" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-2\\sqrt{\\operatorname{ln}⁡x}}{4{x}^{2}\\operatorname{ln}⁡x}" :db/id #edb/ref 17592186288034} {:answer/id #uuid "1e02db35-b595-59ea-973e-bd157371128c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-2\\operatorname{ln}⁡x}{\\sqrt{\\operatorname{ln}⁡x}}" :db/id #edb/ref 17592186288223} {:answer/id #uuid "5e5c0bc2-0072-5944-8dd3-fe8dcbae8938" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+2\\sqrt{\\operatorname{ln}⁡x}}{2{x}^{2}\\sqrt{\\operatorname{ln}⁡x}}" :db/id #edb/ref 17592186288693} {:answer/id #uuid "ac81cfb0-7259-5f57-9adb-04296e897ae4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-2\\operatorname{ln}⁡x}{4{x}^{2}\\sqrt{\\operatorname{ln}⁡x}}" :db/id #edb/ref 17592186289177} {:answer/id #uuid "cb7a7d1a-20e3-5bd6-9408-f184d8d4065a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡x-2}{\\sqrt{\\operatorname{ln}⁡x}}" :db/id #edb/ref 17592186289380}] :answer-field/correct {:answer/id #uuid "ac81cfb0-7259-5f57-9adb-04296e897ae4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-2\\operatorname{ln}⁡x}{4{x}^{2}\\sqrt{\\operatorname{ln}⁡x}}" :db/id #edb/ref 17592186289177} :answer-field/id #uuid "f45efbdd-39dd-5ca7-b621-baab9c7920f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290238}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c3d7d091-4a85-557a-b384-1cb4715f620a" :question/math-academy-id "q-2403" :question/problem "Find ${y}^{′}$ for $y=\\frac{\\sqrt{\\operatorname{ln}⁡x}}{2x}.$" :question/worked-solution "We use the quotient rule with the numerator $u(x)=\\sqrt{\\operatorname{ln}⁡x}$ and the denominator $v(x)=2x.$ \n\nDifferentiating $u(x)$ and $v(x),$ we have\n\n$$\n{u}^{′}(x)=\\frac{1}{2x\\sqrt{\\operatorname{ln}⁡x}},\\,{v}^{′}(x)=2.\n$$\n\nNote that we used the chain rule to differentiate $u.$\n\nNow, applying the quotient rule and simplifying, we have\n\n$$\n\\begin{aligned}\\begin{aligned}{y}^{′}=\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{\\left(\\frac{1}{2x\\sqrt{\\operatorname{ln}⁡x}}\\right)(2x)-(\\sqrt{\\operatorname{ln}⁡x})(2)}{(2x)^{2}} \\\\  & =\\frac{\\frac{1}{\\sqrt{\\operatorname{ln}⁡x}}-2\\sqrt{\\operatorname{ln}⁡x}}{4{x}^{2}} \\\\  & =\\frac{1-2\\operatorname{ln}⁡x}{4{x}^{2}\\sqrt{\\operatorname{ln}⁡x}}.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290525 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e325549-0ba2-58a4-9dd0-b7eeab733a2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\theta =\\frac{12\\sqrt{10}}{9}" :db/id #edb/ref 17592186288690} {:answer/id #uuid "711ceffb-4865-53d9-9611-f3a1decdf347" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\theta =-\\frac{12\\sqrt{10}}{9}" :db/id #edb/ref 17592186288820} {:answer/id #uuid "7898b32b-d4ed-51f2-9a35-5baa748788bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\theta =\\frac{4\\sqrt{3}}{9}" :db/id #edb/ref 17592186288861} {:answer/id #uuid "8539f05d-296c-57de-915f-aca8cd6f5c02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\theta =-\\frac{2\\sqrt{10}}{7}" :db/id #edb/ref 17592186288929} {:answer/id #uuid "f5ba1841-d71c-5d4d-b14b-60831a836195" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\theta =\\frac{2\\sqrt{10}}{7}" :db/id #edb/ref 17592186289653}] :answer-field/correct {:answer/id #uuid "f5ba1841-d71c-5d4d-b14b-60831a836195" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\theta =\\frac{2\\sqrt{10}}{7}" :db/id #edb/ref 17592186289653} :answer-field/id #uuid "5ba29cbe-ca92-58c4-8bd5-f5015788e1a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289924}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f537dceb-5fdb-5fdd-9eed-d90c522b7358" :question/math-academy-id "q-24069" :question/problem "If $\\operatorname{sin}⁡\\theta =\\frac{3}{7}$ and ${0}^{∘}<\\theta <{90}^{∘}$ then what is the value of $\\operatorname{cos}⁡\\theta ?$" :question/worked-solution "![](images/9d/9d9aa1e6ffac387c53c7a1b35217a51cd17db7242ddedec4ff72c229a73d5291.png)\n\nWe're given that $\\operatorname{sin}⁡\\theta =\\frac{3}{7}.$ We can use the Pythagorean identity to find $\\operatorname{cos}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ \\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{sin}⁡\\theta =\\frac{3}{7}$ gives\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{\\left(\\frac{3}{7}\\right)}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{9}{49}} \\\\  & =\\pm \\sqrt{\\frac{40}{49}} \\\\  & =\\pm \\frac{2\\sqrt{10}}{7}.\\end{aligned}\n$$\n\nWe select the positive answer since $\\operatorname{cos}⁡\\theta $ is positive in the first quadrant. So, $\\operatorname{cos}⁡\\theta =\\frac{2\\sqrt{10}}{7}.$"} {:db/id #edb/ref 17592186290526 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d58ece6-1540-5c87-93fc-70b63a7417e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡\\theta =\\frac{2\\sqrt{21}}{21}" :db/id #edb/ref 17592186288332} {:answer/id #uuid "4f6c7df7-d9d8-5ab3-b99c-78b469e993c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡\\theta =-\\frac{2\\sqrt{21}}{63}" :db/id #edb/ref 17592186288579} {:answer/id #uuid "af4e493c-6431-56a2-a2e5-28cd72bbc58e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡\\theta =\\frac{3\\sqrt{21}}{105}" :db/id #edb/ref 17592186289192} {:answer/id #uuid "bc120ac5-b066-5ea0-8867-330f58750505" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡\\theta =\\frac{2\\sqrt{21}}{63}" :db/id #edb/ref 17592186289273} {:answer/id #uuid "e2156236-2645-5e32-a437-798e4f4f8539" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡\\theta =-\\frac{2\\sqrt{21}}{21}" :db/id #edb/ref 17592186289538}] :answer-field/correct {:answer/id #uuid "e2156236-2645-5e32-a437-798e4f4f8539" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡\\theta =-\\frac{2\\sqrt{21}}{21}" :db/id #edb/ref 17592186289538} :answer-field/id #uuid "ddfbb993-eeda-5d36-ae6c-7be445e847ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290204}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cb825d4a-21ae-55df-8bd3-4e6fa7cb77e6" :question/math-academy-id "q-24072" :question/problem "If $\\operatorname{sin}⁡\\theta =\\frac{2}{5}$ and $\\frac{\\pi }{2}<\\theta <\\pi $ then what is the value of $\\operatorname{tan}⁡\\theta ?$" :question/worked-solution "Let's sketch our angle $\\theta $ in the coordinate plane.\n\n![](images/b8/b81b4602d221eb04aab76b0ed8853ab75a5c3cf93e76cc489344bc15133c4daf.png)\n\nWe're given that $\\operatorname{sin}⁡\\theta =\\frac{2}{5}.$ We can use the Pythagorean identity to find $\\operatorname{cos}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ \\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{sin}⁡\\theta =\\frac{2}{5}$ gives\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{\\left(\\frac{2}{5}\\right)}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{4}{25}} \\\\  & =\\pm \\sqrt{\\frac{21}{25}} \\\\  & =\\pm \\frac{\\sqrt{21}}{5}.\\end{aligned}\n$$\n\nWe select the negative answer since $\\operatorname{cos}⁡\\theta $ is negative in the second quadrant. So, $\\operatorname{cos}⁡\\theta =-\\frac{\\sqrt{21}}{5}.$\n\nFinally, knowing that $\\operatorname{tan}⁡\\theta =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta },$ we have\n\n$$\n\\operatorname{tan}⁡\\theta =\\frac{\\left(\\frac{2}{5}\\right)}{\\left(-\\frac{\\sqrt{21}}{5}\\right)}=-\\frac{2}{\\sqrt{21}}=-\\frac{2\\sqrt{21}}{21}.\n$$"} {:db/id #edb/ref 17592186290527 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ff4a424-0cef-5827-8c65-342739e67db3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cos⁡\\theta =\\frac{12}{13}" :db/id #edb/ref 17592186288148} {:answer/id #uuid "2366efa2-2630-5239-8896-1355bc1533d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cos⁡\\theta =-\\frac{12}{13}" :db/id #edb/ref 17592186288255} {:answer/id #uuid "33e7b36e-41fd-5047-aa7c-c6fbbf77c80f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cos⁡\\theta =\\frac{15}{17}" :db/id #edb/ref 17592186288374} {:answer/id #uuid "512ea8bf-0ec8-5a32-9816-ea662b2485cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cos⁡\\theta =\\frac{7}{9}" :db/id #edb/ref 17592186288593} {:answer/id #uuid "719ed65b-d208-5878-a2f7-2752e2d0dc6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cos⁡\\theta =-\\frac{15}{17}" :db/id #edb/ref 17592186288824}] :answer-field/correct {:answer/id #uuid "2366efa2-2630-5239-8896-1355bc1533d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cos⁡\\theta =-\\frac{12}{13}" :db/id #edb/ref 17592186288255} :answer-field/id #uuid "1026f54b-e5ff-52c0-9e4c-7c46c21df6a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289770}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2acc488c-8752-546a-8c14-2587df0cb445" :question/math-academy-id "q-24074" :question/problem "If $sin⁡\\theta =\\frac{5}{13}$ and $\\frac{\\pi }{2}<\\theta <\\pi $ then what is the value of $cos⁡\\theta ?$" :question/worked-solution "![](images/d6/d6ec4c0b71e64cd659bceea63a49f0ef09c44ee1c31353fd377963d7cdf3c3db.png)\n\nWe're given that $sin⁡\\theta =\\frac{5}{13}.$ We can use the Pythagorean identity to find $cos⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ cos⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $sin⁡\\theta =\\frac{5}{13}$ gives\n\n$$\n\\begin{aligned}cos⁡\\theta  & =\\pm \\sqrt{1-{\\left(\\frac{5}{13}\\right)}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{25}{169}} \\\\  & =\\pm \\sqrt{\\frac{144}{169}} \\\\  & =\\pm \\frac{12}{13}.\\end{aligned}\n$$\n\nWe select the negative answer since $cos⁡\\theta $ is negative in the second quadrant. So, $cos⁡\\theta =-\\frac{12}{13}.$"} {:db/id #edb/ref 17592186290533 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "242128e8-57da-54fb-a778-d64982e3e6ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{x}\\operatorname{ln}⁡x-4\\sqrt{x}+C" :db/id #edb/ref 17592186288262} {:answer/id #uuid "8732dcc6-9a65-5228-8229-e7f9458f8963" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{x}\\operatorname{ln}⁡x-4x\\sqrt{x}+C" :db/id #edb/ref 17592186288943} {:answer/id #uuid "889f5efc-1e6c-5ffa-8d2b-d94084d035af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{x}\\operatorname{ln}⁡x+6x\\sqrt{x}-4\\sqrt{x}+C" :db/id #edb/ref 17592186288953} {:answer/id #uuid "8df880a3-b748-5642-b025-5359fafb6420" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{x}\\operatorname{ln}⁡x-6x\\sqrt{x}-4\\sqrt{x}+C" :db/id #edb/ref 17592186288982} {:answer/id #uuid "c57150a9-253e-571e-87e1-bfd0226e459a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{x}\\operatorname{ln}⁡x-4\\sqrt{x}-6\\sqrt{x}+C" :db/id #edb/ref 17592186289340}] :answer-field/correct {:answer/id #uuid "242128e8-57da-54fb-a778-d64982e3e6ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{x}\\operatorname{ln}⁡x-4\\sqrt{x}+C" :db/id #edb/ref 17592186288262} :answer-field/id #uuid "0a814548-0ec5-5562-98ff-c76688520082" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289752}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ca4b3b9a-6ea7-5162-ab23-944642e8e7e5" :question/math-academy-id "q-2429" :question/problem "$\\int \\frac{\\operatorname{ln}⁡x}{\\sqrt{x}}\\,\\text{d}x=$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=\\frac{1}{\\sqrt{x}}\\, & ⟹\\,v=\\int \\frac{1}{\\sqrt{x}}\\,\\text{d}x=2\\sqrt{x}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{ln}⁡x}{\\sqrt{x}}\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡x(2\\sqrt{x})-\\int (2\\sqrt{x})\\left(\\frac{1}{x}\\right)\\,\\text{d}x \\\\  & =2\\sqrt{x}\\operatorname{ln}⁡(x)-2\\int \\frac{1}{\\sqrt{x}}\\,\\text{d}x \\\\  & =2\\sqrt{x}\\operatorname{ln}⁡(x)-4\\sqrt{x}+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant."} {:db/id #edb/ref 17592186290545 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "092b0c5b-0160-5a75-9372-1a1fdb751e1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186288101} {:answer/id #uuid "31abf215-be36-54ee-8b76-e49d4e9b492e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186288358} {:answer/id #uuid "3be41de6-97ad-5092-b695-0e4929346475" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186288446} {:answer/id #uuid "550de42c-4cff-54ea-8ee4-ee43e8d49952" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186288622} {:answer/id #uuid "735b1249-d927-5f24-ad57-ab6915632bff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186288836}] :answer-field/correct {:answer/id #uuid "3be41de6-97ad-5092-b695-0e4929346475" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186288446} :answer-field/id #uuid "90015ecb-38ee-5e28-845e-011957440a16" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290050}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2abb4fd3-0dbf-5cf1-b72d-0a77012faa09" :question/math-academy-id "q-24322" :question/problem "$\\frac{\\operatorname{sec}⁡\\theta -\\operatorname{cos}⁡\\theta }{3\\operatorname{tan}⁡\\theta \\operatorname{sin}⁡\\theta }=$" :question/worked-solution "First, we rewrite the expression using the definitions of $\\operatorname{sec}⁡\\theta $ and $\\operatorname{tan}⁡\\theta $:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sec}⁡\\theta -\\operatorname{cos}⁡\\theta }{3\\operatorname{tan}⁡\\theta \\operatorname{sin}⁡\\theta } & =\\frac{\\frac{1}{\\operatorname{cos}⁡\\theta }-\\operatorname{cos}⁡\\theta }{3\\left(\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }\\right)\\operatorname{sin}⁡\\theta }\\end{aligned}\n$$\n\nNext, we multiply the numerator and the denominator by $\\operatorname{cos}⁡\\theta $ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{cos}⁡\\theta \\cdot (\\frac{1}{\\operatorname{cos}⁡\\theta }-\\operatorname{cos}⁡\\theta )}{3\\operatorname{cos}⁡\\theta \\cdot \\left(\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }\\right)\\operatorname{sin}⁡\\theta } & =\\frac{\\operatorname{cos}⁡\\theta \\cdot \\frac{1}{\\operatorname{cos}⁡\\theta }-{cos}^{2}⁡\\theta }{3\\left(\\frac{\\operatorname{cos}⁡\\theta \\cdot {sin}^{2}⁡\\theta }{\\operatorname{cos}⁡\\theta }\\right)} \\\\  & =\\frac{\\cancel{\\operatorname{cos}⁡\\theta }\\cdot \\frac{1}{\\cancel{\\operatorname{cos}⁡\\theta }}-{cos}^{2}⁡\\theta }{3\\left(\\frac{\\cancel{\\operatorname{cos}⁡\\theta }\\cdot {sin}^{2}⁡\\theta }{\\cancel{\\operatorname{cos}⁡\\theta }}\\right)} \\\\  & =\\frac{1-{cos}^{2}⁡\\theta }{3{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nThen, we use $1-{cos}^{2}⁡\\theta ={sin}^{2}⁡\\theta $ to simplify the expression:\n\n$$\n\\begin{aligned}\\frac{1-{cos}^{2}⁡\\theta }{3{sin}^{2}⁡\\theta } & =\\frac{{sin}^{2}⁡\\theta }{3{sin}^{2}⁡\\theta } \\\\  & =\\frac{\\cancel{{sin}^{2}⁡\\theta }}{3\\cancel{{sin}^{2}⁡\\theta }} \\\\  & =\\frac{1}{3}\\end{aligned}\n$$\n\nTherefore, we conclude that:\n\n$$\n\\frac{\\operatorname{sec}⁡\\theta -\\operatorname{cos}⁡\\theta }{3\\operatorname{tan}⁡\\theta \\operatorname{sin}⁡\\theta }=\\frac{1}{3}\n$$"} {:db/id #edb/ref 17592186290546 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c6c484f-0d4c-5059-abdc-0a5388322664" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\left(\\frac{\\pi }{10}\\right)" :db/id #edb/ref 17592186288449} {:answer/id #uuid "905767c2-2f4f-53cd-a805-da5f17ade7e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡\\left(\\frac{\\pi }{5}\\right)" :db/id #edb/ref 17592186288998} {:answer/id #uuid "a2d3b909-fd08-568d-a4fd-3a367cf58a52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\left(\\frac{2\\pi }{5}\\right)" :db/id #edb/ref 17592186289118} {:answer/id #uuid "b27cd6d7-da62-5d7b-84c9-e5730cb22b5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\left(\\frac{4\\pi }{5}\\right)" :db/id #edb/ref 17592186289211} {:answer/id #uuid "e1c5c2bc-0b3f-5d28-8a4b-51fdecf0f8b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡\\left(\\frac{\\pi }{10}\\right)" :db/id #edb/ref 17592186289536}] :answer-field/correct {:answer/id #uuid "a2d3b909-fd08-568d-a4fd-3a367cf58a52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\left(\\frac{2\\pi }{5}\\right)" :db/id #edb/ref 17592186289118} :answer-field/id #uuid "f665bcbb-88dc-5ad6-8703-67a0c36bad75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290240}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a509f6a5-78b4-503c-a592-ded49f6e4644" :question/math-academy-id "q-24341" :question/problem "Express $1-2{sin}^{2}⁡\\left(\\frac{\\pi }{5}\\right)$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n1-2{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{5}$ into the above, we get\n\n$$\n\\begin{aligned}1-2{sin}^{2}⁡\\left(\\frac{\\pi }{5}\\right) & =\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{5}) \\\\  & =\\operatorname{cos}⁡\\left(\\frac{2\\pi }{5}\\right).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290547 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a02222e-7bac-556f-8a59-fb96cc7379fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1-\\frac{{x}^{2}}{4}" :db/id #edb/ref 17592186288430} {:answer/id #uuid "54e72178-1f7b-5214-9ba6-6c902e98a7d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3(1-\\frac{{x}^{2}}{2})" :db/id #edb/ref 17592186288618} {:answer/id #uuid "86ae557a-8091-5236-b106-cb6c715bfdf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3(1+\\frac{{x}^{2}}{4})" :db/id #edb/ref 17592186288940} {:answer/id #uuid "870e697f-06aa-529c-aeec-3d2b85541b6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2(1+\\frac{{x}^{2}}{4})" :db/id #edb/ref 17592186288942} {:answer/id #uuid "bd1d45d8-de11-5e5a-b944-94183a2a9ac0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1-\\frac{{x}^{2}}{2}" :db/id #edb/ref 17592186289279}] :answer-field/correct {:answer/id #uuid "54e72178-1f7b-5214-9ba6-6c902e98a7d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3(1-\\frac{{x}^{2}}{2})" :db/id #edb/ref 17592186288618} :answer-field/id #uuid "80f53a4c-1f61-543b-a7a8-834f7fc0d410" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290012}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "92fe000e-8b10-5f6c-a7a8-e9bb8ce2fa57" :question/math-academy-id "q-24378" :question/problem "Find the Cartesian equation of the curve defined parametrically as \n\n$$\nx=2\\operatorname{sin}⁡t,\\,\\,\\,y=3\\operatorname{cos}⁡2t,\\,t\\in [0,2\\pi ).\n$$" :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=2\\operatorname{sin}⁡t\\, & ⇒\\,\\operatorname{sin}⁡t=\\frac{x}{2} \\\\ y=3\\operatorname{cos}⁡2t\\, & ⇒\\,\\operatorname{cos}⁡2t=\\frac{y}{3}.\\end{aligned}\n$$\n\nNow, using double angle formula for cosine and the Pythagorean identity, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡2t & ={cos}^{2}⁡t-{sin}^{2}⁡t \\\\  & =(1-{sin}^{2}⁡t)-{sin}^{2}⁡t \\\\  & =1-2{sin}^{2}⁡t.\\end{aligned}\n$$\n\nSubstituting $\\operatorname{sin}⁡t=\\frac{x}{2}$ and $\\operatorname{cos}⁡2t=\\frac{y}{3}$ into this formula, we get\n\n$$\n\\begin{aligned}\\frac{y}{3} & =1-2{\\left(\\frac{x}{2}\\right)}^{2} \\\\ \\frac{y}{3} & =1-2\\left(\\frac{{x}^{2}}{4}\\right) \\\\ \\frac{y}{3} & =1-\\frac{{x}^{2}}{2} \\\\ y & =3(1-\\frac{{x}^{2}}{2}).\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $y=3(1-\\frac{{x}^{2}}{2}).$"} {:db/id #edb/ref 17592186290550 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43eca4f5-7e71-5c4d-b3d7-7641c44eb318" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\left(\\frac{\\pi }{5}\\right)" :db/id #edb/ref 17592186288495} {:answer/id #uuid "492ca887-fe22-579a-b5cb-0f29cfad327c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\left(\\frac{6\\pi }{5}\\right)" :db/id #edb/ref 17592186288539} {:answer/id #uuid "93678e0d-634c-5d71-b943-62299e286df9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\left(\\frac{3\\pi }{5}\\right)" :db/id #edb/ref 17592186289019} {:answer/id #uuid "c7df7cd8-b50b-55b6-b605-e2f558905842" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\left(\\frac{2\\pi }{5}\\right)" :db/id #edb/ref 17592186289355} {:answer/id #uuid "c878a2ea-30a4-57ca-8bad-92bcefc1de12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\left(\\frac{4\\pi }{5}\\right)" :db/id #edb/ref 17592186289360}] :answer-field/correct {:answer/id #uuid "492ca887-fe22-579a-b5cb-0f29cfad327c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\left(\\frac{6\\pi }{5}\\right)" :db/id #edb/ref 17592186288539} :answer-field/id #uuid "44b91e88-c247-552d-ac22-5e6fb9335e1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289882}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ccbcdf42-d0d6-5ef1-b1a3-dd2467d078f8" :question/math-academy-id "q-24499" :question/problem "Express ${cos}^{2}⁡\\left(\\frac{3\\pi }{5}\\right)-{sin}^{2}⁡\\left(\\frac{3\\pi }{5}\\right)$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n{cos}^{2}⁡x-{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x=\\left(\\frac{3\\pi }{5}\\right)$ into the above, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡\\left(\\frac{3\\pi }{5}\\right)-{sin}^{2}⁡\\left(\\frac{3\\pi }{5}\\right) & =\\operatorname{cos}⁡(2\\cdot \\frac{3\\pi }{5}) \\\\  & =\\operatorname{cos}⁡\\left(\\frac{6\\pi }{5}\\right).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290552 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ea4864c-b306-57e1-b44c-21b26487fe84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2(\\frac{{x}^{2}}{8}-1)" :db/id #edb/ref 17592186288575} {:answer/id #uuid "99103521-803c-5804-a165-119989cc93da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3(\\frac{{x}^{2}}{5}-1)" :db/id #edb/ref 17592186289057} {:answer/id #uuid "c1f66a3c-9003-56a0-98dc-04353efeac62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{{x}^{2}}{4}+1" :db/id #edb/ref 17592186289315} {:answer/id #uuid "c824007d-3cd4-55bb-995f-0ebfb53b60b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3{x}^{2}+8" :db/id #edb/ref 17592186289358} {:answer/id #uuid "e69d7548-01ac-54b0-b01f-7d230602a3d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1-\\frac{{x}^{2}}{8}" :db/id #edb/ref 17592186289563}] :answer-field/correct {:answer/id #uuid "4ea4864c-b306-57e1-b44c-21b26487fe84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2(\\frac{{x}^{2}}{8}-1)" :db/id #edb/ref 17592186288575} :answer-field/id #uuid "0da5f05f-ddec-577d-bb96-889893b10755" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289760}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "50632a56-05a3-5b2c-a470-4387daec2008" :question/math-academy-id "q-24574" :question/problem "Find the Cartesian equation of the curve defined parametrically as \n\n$$\nx=4\\operatorname{cos}⁡t,\\,\\,\\,y=2\\operatorname{cos}⁡2t,\\,t\\in [0,2\\pi ).\n$$" :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=4\\operatorname{cos}⁡t\\, & ⇒\\,\\operatorname{cos}⁡t=\\frac{x}{4} \\\\ y=2\\operatorname{cos}⁡2t\\, & ⇒\\,\\operatorname{cos}⁡2t=\\frac{y}{2}.\\end{aligned}\n$$\n\nNow, using double angle formula for cosine and the Pythagorean identity, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡2t & ={cos}^{2}⁡t-{sin}^{2}⁡t \\\\  & ={cos}^{2}⁡t-(1-{cos}^{2}⁡t) \\\\  & =2{cos}^{2}⁡t-1.\\end{aligned}\n$$\n\nSubstituting $\\operatorname{cos}⁡t=\\frac{x}{4}$ and $\\operatorname{cos}⁡2t=\\frac{y}{2}$ into this formula, we get\n\n$$\n\\begin{aligned}\\frac{y}{2} & =2{\\left(\\frac{x}{4}\\right)}^{2}-1 \\\\ \\frac{y}{2} & =2\\left(\\frac{{x}^{2}}{16}\\right)-1 \\\\ \\frac{y}{2} & =\\frac{{x}^{2}}{8}-1 \\\\ y & =2(\\frac{{x}^{2}}{8}-1).\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $y=2(\\frac{{x}^{2}}{8}-1).$"} {:db/id #edb/ref 17592186290553 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19c635f8-a836-5e71-b883-8a1bd5cf25e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{{x}^{2}}{9}-1" :db/id #edb/ref 17592186288196} {:answer/id #uuid "2bacbcf5-685c-51b1-88e0-85a788eecc31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1+\\frac{{x}^{2}}{6}" :db/id #edb/ref 17592186288318} {:answer/id #uuid "87cc2f4e-738c-52b7-abe2-f860d6aed289" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1-\\frac{{x}^{2}}{9}" :db/id #edb/ref 17592186288948} {:answer/id #uuid "9086facf-67d8-55b3-ba11-e7e20d058362" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=7(\\frac{{x}^{2}}{9}+1)" :db/id #edb/ref 17592186288999} {:answer/id #uuid "d34b06b8-fbc5-51ef-94d2-add58e6f047b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4(\\frac{2{x}^{2}}{9}-1)" :db/id #edb/ref 17592186289432}] :answer-field/correct {:answer/id #uuid "d34b06b8-fbc5-51ef-94d2-add58e6f047b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4(\\frac{2{x}^{2}}{9}-1)" :db/id #edb/ref 17592186289432} :answer-field/id #uuid "468c38a2-26d6-518c-b2b0-6ef0ade60949" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289886}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ca1f80dd-221f-5c68-b74a-e39a400a3763" :question/math-academy-id "q-24575" :question/problem "Find the Cartesian equation of the curve defined parametrically as \n\n$$\nx=-3\\operatorname{cos}⁡t,\\,\\,\\,y=4\\operatorname{cos}⁡2t,\\,t\\in [0,2\\pi ).\n$$" :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=-3\\operatorname{cos}⁡t\\, & ⇒\\,\\operatorname{cos}⁡t=-\\frac{x}{3} \\\\ y=4\\operatorname{cos}⁡2t\\, & ⇒\\,\\operatorname{cos}⁡2t=\\frac{y}{4}.\\end{aligned}\n$$\n\nNow, using double angle formula for cosine and the Pythagorean identity, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡2t & ={cos}^{2}⁡t-{sin}^{2}⁡t \\\\  & ={cos}^{2}⁡t-(1-{cos}^{2}⁡t) \\\\  & =2{cos}^{2}⁡t-1.\\end{aligned}\n$$\n\nSubstituting $\\operatorname{cos}⁡t=-\\frac{x}{3}$ and $\\operatorname{cos}⁡2t=\\frac{y}{4}$ into this formula, we get\n\n$$\n\\begin{aligned}\\frac{y}{4} & =2{\\left(-\\frac{x}{3}\\right)}^{2}-1 \\\\ \\frac{y}{4} & =\\frac{2{x}^{2}}{9}-1 \\\\ y & =4(\\frac{2{x}^{2}}{9}-1).\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $y=4(\\frac{2{x}^{2}}{9}-1).$"} {:db/id #edb/ref 17592186290554 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54369419-cb7a-53a4-ad10-1cef5f94f9d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-5+\\frac{5{x}^{2}}{18}" :db/id #edb/ref 17592186288612} {:answer/id #uuid "7e3315c5-e581-5704-8feb-0fa7e40d938b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1+\\frac{5{x}^{2}}{6}" :db/id #edb/ref 17592186288885} {:answer/id #uuid "af7ea6ab-b4ce-5db0-93b2-7941e17fe43e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5+{x}^{2}" :db/id #edb/ref 17592186289193} {:answer/id #uuid "e910a38f-f4e4-5977-9d9f-7ed4f36b6aae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-18+\\frac{{x}^{2}}{5}" :db/id #edb/ref 17592186289579} {:answer/id #uuid "f6b76b41-917c-54ab-ab82-87ce9743027a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{5}-{x}^{2}" :db/id #edb/ref 17592186289660}] :answer-field/correct {:answer/id #uuid "54369419-cb7a-53a4-ad10-1cef5f94f9d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-5+\\frac{5{x}^{2}}{18}" :db/id #edb/ref 17592186288612} :answer-field/id #uuid "85d607bd-1288-57e3-afbf-e5c537389a08" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290024}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fd03cb1f-af7d-59db-bf84-fa1a13cb0a30" :question/math-academy-id "q-24576" :question/problem "Find the Cartesian equation of the curve defined parametrically as \n\n$$\nx=6\\operatorname{sin}⁡t,\\,\\,\\,y=-5\\operatorname{cos}⁡2t,\\,t\\in [0,2\\pi ).\n$$" :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=6\\operatorname{sin}⁡t\\, & ⇒\\,\\operatorname{sin}⁡t=\\frac{x}{6} \\\\ y=-5\\operatorname{cos}⁡2t\\, & ⇒\\,\\operatorname{cos}⁡2t=-\\frac{y}{5}.\\end{aligned}\n$$\n\nNow, using double angle formula for cosine and the Pythagorean identity, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡2t & ={cos}^{2}⁡t-{sin}^{2}⁡t \\\\  & =(1-{sin}^{2}⁡t)-{sin}^{2}⁡t \\\\  & =1-2{sin}^{2}⁡t.\\end{aligned}\n$$\n\nSubstituting $\\operatorname{sin}⁡t=\\frac{x}{6}$ and $\\operatorname{cos}⁡2t=-\\frac{y}{5}$ into this formula, we get\n\n$$\n\\begin{aligned}-\\frac{y}{5} & =1-2{\\left(\\frac{x}{6}\\right)}^{2} \\\\ -\\frac{y}{5} & =1-2\\left(\\frac{{x}^{2}}{36}\\right) \\\\ -\\frac{y}{5} & =1-\\frac{{x}^{2}}{18} \\\\ y & =-5+\\frac{5{x}^{2}}{18}.\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $y=-5+\\frac{5{x}^{2}}{18}.$"} {:db/id #edb/ref 17592186290559 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "250cdf52-80dd-5fc2-af4b-70ef347a1cea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right)" :db/id #edb/ref 17592186288273} {:answer/id #uuid "3fd9b186-aadf-56c5-aa56-1a4655188af6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)" :db/id #edb/ref 17592186288467} {:answer/id #uuid "aa4e972a-a6ae-5ee9-939d-472e588fddcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)" :db/id #edb/ref 17592186289160} {:answer/id #uuid "dd44e3ed-170a-5c64-abc8-da906810e3b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right)" :db/id #edb/ref 17592186289505} {:answer/id #uuid "e97836dd-63c8-53a9-9a9c-9ddec55ceab1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)" :db/id #edb/ref 17592186289583}] :answer-field/correct {:answer/id #uuid "3fd9b186-aadf-56c5-aa56-1a4655188af6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)" :db/id #edb/ref 17592186288467} :answer-field/id #uuid "dd8d3d20-451b-5d5a-b8e5-ba16d376b2a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290201}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4270d786-b50e-5319-88f8-bca386712273" :question/math-academy-id "q-24645" :question/problem "$4\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}\\right)=$" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{8}$ into the above, we get\n\n$$\n2\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)=\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{8})\n$$\n\nwhich simplifies as\n\n$$\n2\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)=\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right).\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}4\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}\\right) & =2[2\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)]\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}\\right) \\\\  & =2\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}\\right)\\end{aligned}\n$$\n\nNow, using the double-angle formula once more with $x=\\frac{\\pi }{4}$, we can further simplify the above expression: \n\n$$\n\\begin{aligned}4\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}\\right) & =2\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}\\right) \\\\  & =\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4}) \\\\  & =\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290560 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c357368-fcee-57c4-bf91-a6420fe440cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\left(\\frac{\\pi }{3}\\right)" :db/id #edb/ref 17592186288213} {:answer/id #uuid "27f10174-6b5a-51a5-a3ff-b27f66395464" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{sin}⁡\\left(\\frac{\\pi }{6}\\right)" :db/id #edb/ref 17592186288298} {:answer/id #uuid "853e171a-cb9a-5680-8257-0e827c783b56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{sin}⁡\\left(\\frac{\\pi }{3}\\right)" :db/id #edb/ref 17592186288930} {:answer/id #uuid "cc2b8d46-c755-5546-ae37-7ed12f4842f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡\\left(\\frac{\\pi }{3}\\right)" :db/id #edb/ref 17592186289390} {:answer/id #uuid "e5710b37-6161-53d9-9349-b0d8e0d217e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡\\left(\\frac{\\pi }{6}\\right)" :db/id #edb/ref 17592186289552}] :answer-field/correct {:answer/id #uuid "cc2b8d46-c755-5546-ae37-7ed12f4842f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡\\left(\\frac{\\pi }{3}\\right)" :db/id #edb/ref 17592186289390} :answer-field/id #uuid "f984848b-f15f-5efc-b09a-0122e1e107ed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290247}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "feecaade-207a-51bf-96ee-61bce1de2e85" :question/math-academy-id "q-24647" :question/problem "Express $4\\operatorname{sin}⁡\\left(\\frac{\\pi }{6}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{6}\\right)$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{6}$ into the above, we get\n\n$$\n2\\operatorname{sin}⁡\\left(\\frac{\\pi }{6}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{6}\\right)=\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{6})=\\operatorname{sin}⁡\\left(\\frac{\\pi }{3}\\right).\n$$\n\nTherefore,\n\n$$\n4\\operatorname{sin}⁡\\left(\\frac{\\pi }{6}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{6}\\right)=2\\cdot 2\\operatorname{sin}⁡\\left(\\frac{\\pi }{6}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{6}\\right)=2\\operatorname{sin}⁡\\left(\\frac{\\pi }{3}\\right).\n$$"} {:db/id #edb/ref 17592186290562 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21623035-5d3b-54b0-b966-85086e882ee3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186288244} {:answer/id #uuid "327ce358-2120-579c-a825-a49f79276978" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{csc}⁡\\left(\\frac{\\pi }{5}\\right)" :db/id #edb/ref 17592186288362} {:answer/id #uuid "462fdeb4-069c-543e-84f4-6256b0c7292e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{sin}⁡\\left(\\frac{2\\pi }{5}\\right)" :db/id #edb/ref 17592186288512} {:answer/id #uuid "4691cd9d-d70d-5609-bda6-07f12d1b3808" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186288515} {:answer/id #uuid "6381d420-eb79-5f12-aa11-1fa09a350b57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡\\left(\\frac{4\\pi }{5}\\right)" :db/id #edb/ref 17592186288728}] :answer-field/correct {:answer/id #uuid "4691cd9d-d70d-5609-bda6-07f12d1b3808" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186288515} :answer-field/id #uuid "b3e9dae2-f4ee-56c2-b632-6441b7a7809a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290123}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f30309d1-f3e3-55ac-be8a-acbe0c0f980a" :question/math-academy-id "q-24650" :question/problem "$8\\,\\operatorname{sin}⁡\\left(\\frac{\\pi }{5}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{5}\\right)\\operatorname{csc}⁡\\left(\\frac{2\\pi }{5}\\right)=$" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{5}$ into the above, we get\n\n$$\n2\\operatorname{sin}⁡\\left(\\frac{\\pi }{5}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{5}\\right)=\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{5})=\\operatorname{sin}⁡\\left(\\frac{2\\pi }{5}\\right).\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}8\\,\\operatorname{sin}⁡\\left(\\frac{\\pi }{5}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{5}\\right)\\operatorname{csc}⁡\\left(\\frac{2\\pi }{5}\\right) & =4\\cdot [2\\operatorname{sin}⁡\\left(\\frac{\\pi }{5}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{5}\\right)]\\operatorname{csc}⁡\\left(\\frac{2\\pi }{5}\\right) \\\\  & =4\\operatorname{sin}⁡\\left(\\frac{2\\pi }{5}\\right)\\cdot \\frac{1}{\\operatorname{sin}⁡\\left(\\frac{2\\pi }{5}\\right)} \\\\  & =4\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290570 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06243b9e-99ec-5fe0-b352-c9da644d5c14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{60}^{∘}" :db/id #edb/ref 17592186288078} {:answer/id #uuid "75071b70-b69e-53c7-8ea6-0f13156ffd36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{45}^{∘}" :db/id #edb/ref 17592186288846} {:answer/id #uuid "778dbfd5-a636-56d4-b152-09647f0d1ed8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{180}^{∘}" :db/id #edb/ref 17592186288857} {:answer/id #uuid "9492bdd8-3b54-5377-8590-183fb4c9c03e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{90}^{∘}" :db/id #edb/ref 17592186289027} {:answer/id #uuid "ded74c05-1dab-56e7-be16-4b85aa43563b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{30}^{∘}" :db/id #edb/ref 17592186289518}] :answer-field/correct {:answer/id #uuid "ded74c05-1dab-56e7-be16-4b85aa43563b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{30}^{∘}" :db/id #edb/ref 17592186289518} :answer-field/id #uuid "207b0c9d-7032-538d-8d8a-ca684113097b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289811}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3afdea11-e4df-5ff6-be80-8dd151f3d450" :question/math-academy-id "q-24756" :question/problem "$\\operatorname{arcsin}⁡\\left(\\frac{1}{2}\\right)=$" :question/worked-solution "First, note that the range of $\\theta =\\operatorname{arcsin}⁡x$ is given by\n\n$$\n-{90}^{∘}\\le \\theta \\le {90}^{∘}.\n$$\n\nNote that the angle $\\theta $ spans the first and fourth quadrants.\n\nSince $\\frac{1}{2}$ is positive, our answer is an angle that lies in the first quadrant, where sine is positive.\n\n![](images/ca/ca39c4cde40b99fd40a11746a31398d82814268b2df706e3101ee88648c9e2d4.png)\n\nFrom the values in the first quadrant, we see that\n\n$$\n\\operatorname{sin}⁡({30}^{∘})=\\frac{1}{2}.\n$$\n\nTherefore,\n\n$$\n\\operatorname{arcsin}⁡\\left(\\frac{1}{2}\\right)={30}^{∘}.\n$$"} {:db/id #edb/ref 17592186290571 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1457922b-a636-59e1-bbee-7200f9bc666a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186288170} {:answer/id #uuid "356d7d38-5447-509f-8533-e4a1ef286801" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186288390} {:answer/id #uuid "561ae12f-7664-57d5-9c0e-0894798aaaf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186288628} {:answer/id #uuid "5624612b-7474-52a7-beef-adb1623638d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186288629} {:answer/id #uuid "6b8320e0-9890-5db7-9186-f94444844c4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186288791}] :answer-field/correct {:answer/id #uuid "5624612b-7474-52a7-beef-adb1623638d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186288629} :answer-field/id #uuid "6d90d0f7-393c-5329-8a00-95ced353bab1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289971}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a710f83e-0182-5b44-96f0-5ba7ee68c68b" :question/math-academy-id "q-24757" :question/problem "$\\operatorname{arctan}⁡(1)=$" :question/worked-solution "The range of $\\theta =\\operatorname{arctan}⁡x$ is given by\n\n$$\n-\\frac{\\pi }{2}<\\theta <\\frac{\\pi }{2}.\n$$\n\nNote that the angle $\\theta $ spans the first and fourth quadrants.\n\nSince $1$ is positive, our answer is an angle that lies in the first quadrant, where tangent is positive.\n\nFrom the special values of the trigonometric functions, we know that \n\n$$\n\\operatorname{tan}⁡\\left(\\frac{\\pi }{4}\\right)=1.\n$$\n\nSince $\\frac{\\pi }{4}$ is an angle in the first quadrant that lies within the range of $arctan,$ we conclude that\n\n$$\n\\operatorname{arctan}⁡(1)=\\frac{\\pi }{4}.\n$$"} {:db/id #edb/ref 17592186290574 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2502c69d-badc-5960-8742-8044f46c9a61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186288271} {:answer/id #uuid "5d035807-8c57-51d1-bf3b-428c8580e752" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2\\pi }{3}" :db/id #edb/ref 17592186288682} {:answer/id #uuid "618d2245-c78e-5162-bba8-48d51762dc3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{3}" :db/id #edb/ref 17592186288716} {:answer/id #uuid "a82cdb30-3d38-583e-a66f-871633ca0ff6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{6}" :db/id #edb/ref 17592186289145} {:answer/id #uuid "d05c15d8-3155-5eb0-bd70-aef7e27f165c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{6}" :db/id #edb/ref 17592186289418}] :answer-field/correct {:answer/id #uuid "a82cdb30-3d38-583e-a66f-871633ca0ff6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{6}" :db/id #edb/ref 17592186289145} :answer-field/id #uuid "2873d6aa-c4eb-5f16-901e-f5af044acefd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289824}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6dfab8f9-1856-571a-9716-248451182789" :question/math-academy-id "q-24764" :question/problem "$\\operatorname{arctan}⁡\\left(-\\frac{1}{\\sqrt{3}}\\right)=$" :question/worked-solution "The range of $\\theta =\\operatorname{arctan}⁡x$ is given by\n\n$$\n-\\frac{\\pi }{2}<\\theta <\\frac{\\pi }{2}.\n$$\n\nNote that the angle $\\theta $ spans the first and fourth quadrants.\n\nSince $-\\frac{1}{\\sqrt{3}}$ is negative, our answer is an angle that lies in the fourth quadrant, where the tangent is negative.\n\nFrom the special values of the trigonometric functions and the oddness of the tangent function, we know that \n\n$$\n\\operatorname{tan}⁡\\left(-\\frac{\\pi }{6}\\right)=-\\operatorname{tan}⁡\\left(\\frac{\\pi }{6}\\right)=-\\frac{1}{\\sqrt{3}}.\n$$\n\nSince $-\\frac{\\pi }{6}$ is an angle in the fourth quadrant that lies within the range of $arctan,$ we conclude that\n\n$$\n\\operatorname{arctan}⁡\\left(-\\frac{1}{\\sqrt{3}}\\right)=-\\frac{\\pi }{6}.\n$$"} {:db/id #edb/ref 17592186290576 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6931cbd8-8aec-59e8-9beb-4aedea7d2b08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186288773} {:answer/id #uuid "75d06901-1591-5a02-bd70-d0b5359fdc2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186288848} {:answer/id #uuid "aaed2909-cde1-5ba1-9b2f-148de0944131" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186289163} {:answer/id #uuid "c5938940-d658-5ae5-b42e-bafb832ed043" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{4}" :db/id #edb/ref 17592186289342} {:answer/id #uuid "ef4e0599-c81e-5b40-9345-cbe04ca22479" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186289607}] :answer-field/correct {:answer/id #uuid "c5938940-d658-5ae5-b42e-bafb832ed043" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{4}" :db/id #edb/ref 17592186289342} :answer-field/id #uuid "a9d1237f-fc45-51a4-903c-c80006523323" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290108}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c8b170de-4305-57f7-8f86-f2f06478c4e5" :question/math-academy-id "q-24781" :question/problem "Find the exact value of $\\frac{\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)}{\\operatorname{csc}⁡\\left(\\frac{\\pi }{8}\\right)}.$" :question/worked-solution "First, we note that:\n\n$$\n\\frac{\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)}{\\operatorname{csc}⁡\\left(\\frac{\\pi }{8}\\right)}=\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)\\cdot \\frac{1}{\\operatorname{csc}⁡\\left(\\frac{\\pi }{8}\\right)}=\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)\n$$\n\nNow, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{8}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right) & =\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{8}) \\\\  & =\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right) \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nHence, we obtain\n\n$$\n\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)=\\frac{\\sqrt{2}}{4}.\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)}{\\operatorname{csc}⁡\\left(\\frac{\\pi }{8}\\right)}=\\frac{\\sqrt{2}}{4}.\n$$"} {:db/id #edb/ref 17592186290577 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39c3ecbd-17ed-5b06-b654-653c3049502e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)" :db/id #edb/ref 17592186288427} {:answer/id #uuid "4c1c7922-d73e-55f5-a376-2d36947a8151" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{sec}⁡\\left(\\frac{\\pi }{4}\\right)" :db/id #edb/ref 17592186288559} {:answer/id #uuid "5af6a861-2ad4-55c6-9de1-23e3e121be7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sec}⁡\\left(\\frac{\\pi }{2}\\right)" :db/id #edb/ref 17592186288666} {:answer/id #uuid "640a6f06-222f-5050-8d99-73191247207c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)" :db/id #edb/ref 17592186288735} {:answer/id #uuid "6c6c9ed9-62d6-592d-8648-4a352af8d6c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right)" :db/id #edb/ref 17592186288797}] :answer-field/correct {:answer/id #uuid "640a6f06-222f-5050-8d99-73191247207c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)" :db/id #edb/ref 17592186288735} :answer-field/id #uuid "ef225602-1693-5ca7-8c43-67f2e54eda30" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290226}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "87e7afa8-1798-5127-a9ff-a08924db07de" :question/math-academy-id "q-24792" :question/problem "Find the exact value of $\\frac{\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{4}\\right)}.$" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{8}$ into the above, we get\n\n$$\n2\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)=\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{8})\n$$\n\nwhich simplifies as\n\n$$\n2\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)=\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right).\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{4}\\right)} & =\\frac{\\frac{1}{2}\\cdot 2\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{4}\\right)} \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}\\right)\\end{aligned}\n$$\n\nFinally, using the double-angle formula once more with $x=\\frac{\\pi }{4}$, we can further simplify the above expression: \n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{4}\\right)} & =\\frac{1}{2}\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}\\right) \\\\  & =\\frac{1}{4}\\cdot 2\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}\\right) \\\\  & =\\frac{1}{4}\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4}) \\\\  & =\\frac{1}{4}\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290578 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e3e8a72-d66c-5ec3-b40f-fb6c49116d9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡x}{x}+\\frac{arccotx}{1+{x}^{2}}" :db/id #edb/ref 17592186288134} {:answer/id #uuid "1bc58f79-67c9-5a07-82b8-37019e8fcf16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{arccotx}{x}-\\frac{\\operatorname{ln}⁡x}{1+{x}^{2}}" :db/id #edb/ref 17592186288210} {:answer/id #uuid "356f78a7-7f7f-5f9a-acab-fbad74f70904" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{arccotx}{x}+\\frac{\\operatorname{ln}⁡x}{1+{x}^{2}}" :db/id #edb/ref 17592186288391} {:answer/id #uuid "5b9cda91-25c7-507c-ae14-575d705818bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡x\\cdot arccotx}{x(1+{x}^{2})}" :db/id #edb/ref 17592186288670} {:answer/id #uuid "ffd2ac71-6b4c-5d57-94e6-568eed9deb7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡x}{x}-\\frac{arccotx}{1+{x}^{2}}" :db/id #edb/ref 17592186289726}] :answer-field/correct {:answer/id #uuid "1bc58f79-67c9-5a07-82b8-37019e8fcf16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{arccotx}{x}-\\frac{\\operatorname{ln}⁡x}{1+{x}^{2}}" :db/id #edb/ref 17592186288210} :answer-field/id #uuid "16ae30e1-e24b-51c6-ac9f-1b57607c624a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289785}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0452209a-6bf5-5ff9-86d8-fd513bd202d6" :question/math-academy-id "q-2483" :question/problem "Find ${y}^{′}$ for $y=\\operatorname{ln}⁡x\\cdot arccotx.$" :question/worked-solution "The formula for the derivative of $arccot$ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(arccotx)=-\\frac{1}{1+{x}^{2}}.\n$$\n\nUsing the product rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{y}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x\\cdot arccotx) \\\\  & =arccotx\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x)+\\operatorname{ln}⁡x\\cdot \\frac{\\text{d}}{\\text{d}x}(arccotx) \\\\  & =arccotx\\cdot \\frac{1}{x}+\\operatorname{ln}⁡x\\cdot \\left(-\\frac{1}{1+{x}^{2}}\\right) \\\\  & =\\frac{arccotx}{x}-\\frac{\\operatorname{ln}⁡x}{1+{x}^{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290579 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "111f643e-21fe-5850-a34c-7e75f866dffd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186288160} {:answer/id #uuid "5476c042-8711-54ab-b3d4-eadca3ea72e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2arccscx}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186288614} {:answer/id #uuid "6427fa83-3424-5638-881a-1b75c59158ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2arcsecx}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186288737} {:answer/id #uuid "8d34a562-2280-5df3-b021-0fc8376c8ba7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{arccscx-arcsecx}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186288975} {:answer/id #uuid "f32241a6-5d82-568c-bcfd-3f92960cb105" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{arccscx+arcsecx}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186289638}] :answer-field/correct {:answer/id #uuid "8d34a562-2280-5df3-b021-0fc8376c8ba7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{arccscx-arcsecx}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186288975} :answer-field/id #uuid "352c605b-c2ce-576c-94c4-6d4a6fa3df72" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289846}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fabb0dc5-fadf-5950-bf52-26606893c541" :question/math-academy-id "q-2484" :question/problem "Find ${f}^{′}(x)$ for $f(x)=arccscx\\cdot arcsecx$" :question/worked-solution "The formulae for the derivatives of $arccsc$ and $arcsec$ are\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(arccscx) & =-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}, \\\\ \\frac{\\text{d}}{\\text{d}x}(arcsecx) & =\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\\end{aligned}\n$$\n\nUsing the product rule and the formulae above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =arcsecx\\cdot \\frac{\\text{d}}{\\text{d}x}(arccscx)+arccscx\\cdot \\frac{\\text{d}}{\\text{d}x}(arcsecx) \\\\  & =arcsecx\\cdot \\left(-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\right)+arccscx\\cdot \\left(\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\right) \\\\  & =-\\frac{arcsecx}{|x|\\sqrt{{x}^{2}-1}}+\\frac{arccscx}{|x|\\sqrt{{x}^{2}-1}} \\\\  & =\\frac{arccscx-arcsecx}{|x|\\sqrt{{x}^{2}-1}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290586 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a8e08bb-1b37-5cf6-86db-c3ef539c1d7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\,\\operatorname{arccos}⁡\\left(\\frac{x}{3}\\right)+C" :db/id #edb/ref 17592186288202} {:answer/id #uuid "45dc7c37-051d-511b-9e8a-aec010663441" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arcsin}⁡\\left(\\frac{x}{3}\\right)+C" :db/id #edb/ref 17592186288507} {:answer/id #uuid "58113f3e-82c1-5ec1-9b67-5669fee9fd01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arccos}⁡({x}^{2})+C" :db/id #edb/ref 17592186288647} {:answer/id #uuid "978f50c6-52a3-5c94-9441-ace404075a2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\operatorname{arcsin}⁡({x}^{2})+C" :db/id #edb/ref 17592186289048} {:answer/id #uuid "99ed0e47-4a7c-5b89-9c0b-8ff18f3172b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\operatorname{arcsin}⁡\\left(\\frac{{x}^{2}}{9}\\right)+C" :db/id #edb/ref 17592186289060}] :answer-field/correct {:answer/id #uuid "45dc7c37-051d-511b-9e8a-aec010663441" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arcsin}⁡\\left(\\frac{x}{3}\\right)+C" :db/id #edb/ref 17592186288507} :answer-field/id #uuid "f07d43ea-d249-5835-9f11-f5ac2c8850b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290229}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2b7a5d31-b8c0-5e03-b3eb-62f1624001b3" :question/math-academy-id "q-2503" :question/problem "$\\int \\frac{1}{\\sqrt{9-{x}^{2}}}\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{9-{x}^{2}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{9\\cdot (1-{x}^{2}/9)}}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\int \\frac{1}{\\sqrt{1-{x}^{2}/9}}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\int \\frac{1}{\\sqrt{1-(x/3)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\n \n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${\\left(\\frac{x}{3}\\right)}^{2}.$  \n\nSo, let's substitute $u=\\frac{x}{3}.$ Differentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}x=3\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{\\sqrt{9-{x}^{2}}}\\,\\text{d}x & =\\frac{1}{3}\\int \\frac{1}{\\sqrt{1-(x/3)^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (3\\,\\text{d}u) \\\\  & =\\int \\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =\\operatorname{arcsin}⁡u+C \\\\  & =\\operatorname{arcsin}⁡\\left(\\frac{x}{3}\\right)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290605 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d0d1898c-e717-57a8-bf36-d19a58092141" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186289419}] :answer-field/correct {:answer/id #uuid "d0d1898c-e717-57a8-bf36-d19a58092141" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186289419} :answer-field/id #uuid "49e0d6b5-241f-50c4-9306-230e581423db" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289892}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fac637dd-f4f5-55ab-8f6b-f20076ebab30" :question/math-academy-id "q-250865" :question/problem "If the $10$th term of an arithmetic series is $-\\frac{1}{5}$ and the sum of the first $21$ terms is $0,$ then the first term of the series is ${a}_{1}=${{field-1}}." :question/worked-solution "We are given one term of the series. So, to find the first term, we use the formula for the sum of an arithmetic series in the form\n\n$$\n{S}_{N}=\\frac{N}{2}(2{a}_{1}+(N-1)d),\n$$\n\nwhere ${a}_{1}$ is the first term, $d$ is the common difference, and $N$ is the number of terms.\n\nSubstituting $N=21$ and ${S}_{N}=0$ into the formula for the sum of an arithmetic series, we have\n\n$$\n\\begin{aligned}{S}_{N} & =\\frac{N}{2}(2{a}_{1}+(N-1)d) \\\\ 0 & =\\frac{21}{2}(2{a}_{1}+(21-1)d) \\\\ 0 & =21(2{a}_{1}+20d) \\\\ 0 & =2{a}_{1}+20d.\\end{aligned}\n$$\n\nAlso, we can write an equation for the $10$th term of the arithmetic series and substitute in its known value:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\ {a}_{10} & ={a}_{1}+(10-1)d \\\\ -\\frac{1}{5} & ={a}_{1}+9d\\end{aligned}\n$$\n\nAs a result, we obtain the following system of equations:\n\n$$\n{\\begin{aligned}-\\frac{1}{5} & \\,\\,\\,=\\,{a}_{1}+9d \\\\ \\,0 & \\,\\,\\,=\\,2{a}_{1}+20d\\end{aligned}\n$$\n\nTo solve this system, we multiply the first equation by $-2$ and add the result to the second equation:\n\n$$\n\\begin{aligned}\\frac{2}{5} & =-2{a}_{1}-18d \\\\ 0 & =2{a}_{1}+20d \\\\ \\frac{2}{5} & =2d \\\\ d & =\\frac{1}{5}\\end{aligned}\n$$\n\nFinally, substituting $d=\\frac{1}{5}$ into the first equation, we obtain\n\n$$\n\\begin{aligned}-\\frac{1}{5} & ={a}_{1}+9d \\\\ -\\frac{1}{5} & ={a}_{1}+9\\left(\\frac{1}{5}\\right) \\\\ -\\frac{1}{5} & ={a}_{1}+\\frac{9}{5} \\\\ {a}_{1} & =-2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290608 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "347cace2-eabe-5ea6-b4b4-4fca70a5d64b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18}{7}" :db/id #edb/ref 17592186288380}] :answer-field/correct {:answer/id #uuid "347cace2-eabe-5ea6-b4b4-4fca70a5d64b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18}{7}" :db/id #edb/ref 17592186288380} :answer-field/id #uuid "1b567a3a-a93c-5a48-b8b0-5a0ea294d80d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289796} {:answer-field/choices [{:answer/id #uuid "4cf30b0e-a2df-55f4-beec-e431a50f90d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{144}{49}" :db/id #edb/ref 17592186288564}] :answer-field/correct {:answer/id #uuid "4cf30b0e-a2df-55f4-beec-e431a50f90d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{144}{49}" :db/id #edb/ref 17592186288564} :answer-field/id #uuid "8f76a156-daea-55f3-86b6-4c6eb80b0c62" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290046}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fb99a15e-115d-5df1-9518-38abfb7aa160" :question/math-academy-id "q-250994" :question/problem "${(1+\\frac{2b}{7})}^{9}=$$\\,1\\,+$\n{{field-1}}$b\\,+$\n{{field-2}}${b}^{2}+⋯$" :question/worked-solution "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=\\frac{2b}{7}$ and $n=9$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1+\\frac{2b}{7})}^{9} & =1+9\\cdot \\frac{2b}{7}+\\frac{9(9-1)}{2!}\\cdot {\\left(\\frac{2b}{7}\\right)}^{2}+⋯ \\\\  & =1+\\frac{18b}{7}+\\frac{9\\cdot 8}{2}\\cdot \\frac{4{b}^{2}}{49}+⋯ \\\\  & =1+\\frac{18b}{7}+36\\cdot \\frac{4{b}^{2}}{49}+⋯ \\\\  & =1+\\frac{18}{7}b+\\frac{144}{49}{b}^{2}+⋯.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290612 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "380428ad-922b-5f5c-a240-f1da24986718" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{8}{5}k+\\frac{28}{25}{k}^{2}" :db/id #edb/ref 17592186288413}] :answer-field/correct {:answer/id #uuid "380428ad-922b-5f5c-a240-f1da24986718" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{8}{5}k+\\frac{28}{25}{k}^{2}" :db/id #edb/ref 17592186288413} :answer-field/id #uuid "7a78b657-e4e7-56e5-ac61-ed61de873dd9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290000}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1045e310-07c6-5b1d-b17c-126be36532fa" :question/math-academy-id "q-251048" :question/problem "Find, in ascending powers of $k,$ the **first three terms** of the binomial expansion of ${(1-\\frac{k}{5})}^{8}.$\n\n${(1-\\frac{k}{5})}^{8}=$\n{{field-1}}$\\,+\\,⋯$" :question/worked-solution "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n{(1+x)}^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=-\\frac{k}{5}$ and $n=8$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-\\frac{k}{5})}^{8} & =1+8\\cdot \\left(-\\frac{k}{5}\\right)+\\frac{8(8-1)}{2!}\\cdot {\\left(-\\frac{k}{5}\\right)}^{2}+⋯ \\\\  & =1-\\frac{8k}{5}+\\frac{8\\cdot 7}{2}\\cdot \\frac{{k}^{2}}{25}+⋯ \\\\  & =1-\\frac{8k}{5}+28\\cdot \\frac{{k}^{2}}{25}+⋯ \\\\  & =1-\\frac{8}{5}k+\\frac{28}{25}{k}^{2}+⋯.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290619 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43b56206-e64e-533c-8093-5665ec86fc06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186288493}] :answer-field/correct {:answer/id #uuid "43b56206-e64e-533c-8093-5665ec86fc06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186288493} :answer-field/id #uuid "825fd07d-db60-54dd-ac34-43638f3f6367" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290016}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bda5ec7b-0d2e-5231-8e0a-d3b2202c02ed" :question/math-academy-id "q-251086" :question/problem "![](images/51/51e60c645aa6be034a8ef23d16a9ca7a815ca15fe815d7c3b03a866e693f3e5b.png)\n\nGiven that $\\operatorname{tan}⁡(m∠A)=\\frac{2}{3},$ the **exact** area of $△ABC$ shown above is{{field-1}} square units." :question/worked-solution "In this case, the area of the right triangle is\n\n$$\nA=\\frac{1}{2}BC\\cdot AC.\n$$\n\nWe are given that $\\operatorname{tan}⁡(m∠A)=\\frac{2}{3}.$ Notice that relative to $∠A,$ we have expressions for the lengths of the opposite side $\\overset{―}{BC}$ and adjacent side $\\overset{―}{AC}.$ Hence, we can use the tangent ratio to solve for $x:$\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡(m∠A) & =\\frac{BC}{AC} \\\\ \\frac{2}{3} & =\\frac{10x-1}{8x+2} \\\\ 2(8x+2) & =3(10x-1) \\\\ 16x+4 & =30x-3 \\\\ 14x & =7 \\\\ x & =\\frac{1}{2}\\end{aligned}\n$$\n\nSo, the side lengths are\n\n$$\n\\begin{aligned}BC & =10x-1=10\\left(\\frac{1}{2}\\right)-1=4, \\\\ AC & =8x+2=8\\left(\\frac{1}{2}\\right)+2=6.\\end{aligned}\n$$\n\nTherefore, the area of $△ABC$ is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}BC\\cdot AC \\\\  & =\\frac{1}{2}\\cdot 4\\cdot 6 \\\\  & =12.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290622 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25027a1f-8e24-5ae1-bc10-e65b1257f93d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186288270}] :answer-field/correct {:answer/id #uuid "25027a1f-8e24-5ae1-bc10-e65b1257f93d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186288270} :answer-field/id #uuid "f01596c5-246d-5ddc-a1a2-1876c0b15360" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290227}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "631e67df-da8d-5141-9930-394d0ee1d6b4" :question/math-academy-id "q-251089" :question/problem "![](images/25/251ca3005dd302ec1e7ba0c7d7c497e28fd4c16cc0e431cc3691bdd4fe65446a.png)\n\nGiven that $\\operatorname{tan}⁡(m∠B)=\\frac{1}{5},$ the **exact** area of $△ABC$ shown above is{{field-1}} square units." :question/worked-solution "In this case, the area of the right triangle is\n\n$$\nA=\\frac{1}{2}BC\\cdot AC.\n$$\n\nWe are given that $\\operatorname{tan}⁡(m∠B)=\\frac{1}{5}.$ Notice that relative to $∠B,$ we have expressions for the lengths of the opposite side $\\overset{―}{AC}$ and adjacent side $\\overset{―}{BC}.$ Hence, we can use the tangent ratio to solve for $x:$\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡(m∠B) & =\\frac{AC}{BC} \\\\ \\frac{1}{5} & =\\frac{6x-1}{15x} \\\\ 15x & =5(6x-1) \\\\ 15x & =30x-5 \\\\ 15x & =5 \\\\ x & =\\frac{1}{3}\\end{aligned}\n$$\n\nSo, the side lengths are\n\n$$\n\\begin{aligned}BC & =15x=15\\left(\\frac{1}{3}\\right)=5, \\\\ AC & =6x-1=6\\left(\\frac{1}{3}\\right)-1=1.\\end{aligned}\n$$\n\nTherefore, the area of $△ABC$ is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}BC\\cdot AC \\\\  & =\\frac{1}{2}\\cdot 5\\cdot 1 \\\\  & =\\frac{5}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290625 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa3adef7-ce45-58d8-b079-eb4a141067a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{256}" :db/id #edb/ref 17592186289159}] :answer-field/correct {:answer/id #uuid "aa3adef7-ce45-58d8-b079-eb4a141067a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{256}" :db/id #edb/ref 17592186289159} :answer-field/id #uuid "418c64f2-32cc-5b24-9254-49d0e98ed979" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289878}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b9941abe-85c0-5263-b386-0b79bf9902cc" :question/math-academy-id "q-251116" :question/problem "The coefficient of ${k}^{4}$ in the expansion of ${(1-\\frac{k}{4})}^{5}$ is{{field-1}}." :question/worked-solution "The binomial expansion for $(1+x)^{n}$ is given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nIn particular, the ${x}^{4}$ term is given by\n\n$$\n\\frac{n(n-1)(n-2)(n-3)}{4!}{x}^{4}.\n$$\n\nReplacing $x$ with $-\\frac{k}{4}$ and $n$ with $5$ in the above expression, we get\n\n$$\n\\begin{aligned}\\frac{5(5-1)(5-2)(5-3)}{4!}\\cdot {\\left(-\\frac{k}{4}\\right)}^{4} & =\\frac{5\\cdot 4\\cdot 3\\cdot 2}{24}\\cdot {\\left(-\\frac{1}{4}\\right)}^{4}\\cdot {k}^{4} \\\\  & =5\\cdot \\frac{1}{256}{k}^{4} \\\\  & =\\frac{5}{256}{k}^{4}.\\end{aligned}\n$$\n\nTherefore, the coefficient of ${k}^{4}$ is $\\frac{5}{256}.$"} {:db/id #edb/ref 17592186290626 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "731a8bbd-2094-505f-a597-6e80dbe06c31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{80}{27}" :db/id #edb/ref 17592186288834}] :answer-field/correct {:answer/id #uuid "731a8bbd-2094-505f-a597-6e80dbe06c31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{80}{27}" :db/id #edb/ref 17592186288834} :answer-field/id #uuid "1ff9c5df-d5ee-59d7-883a-de7ac580633d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289810}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6a42edac-f50e-5d66-b9ec-a7c3b405c01e" :question/math-academy-id "q-251119" :question/problem "The coefficient of ${u}^{4}$ in the expansion of ${(1+\\frac{2u}{3})}^{6}$ is{{field-1}}." :question/worked-solution "The binomial expansion for $(1+x)^{n}$ is given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nIn particular, the ${x}^{4}$ term is given by\n\n$$\n\\frac{n(n-1)(n-2)(n-3)}{4!}{x}^{4}.\n$$\n\nReplacing $x$ with $\\frac{2u}{3}$ and $n$ with $6$ in the above expression, we get\n\n$$\n\\begin{aligned}\\frac{6(6-1)(6-2)(6-3)}{4!}\\cdot {\\left(\\frac{2u}{3}\\right)}^{4} & =\\frac{6\\cdot 5\\cdot 4\\cdot 3}{24}\\cdot {\\left(\\frac{2}{3}\\right)}^{4}\\cdot {u}^{4} \\\\  & =15\\cdot \\frac{16}{81}{u}^{3} \\\\  & =\\frac{80}{27}{u}^{3}.\\end{aligned}\n$$\n\nTherefore, the coefficient of ${u}^{4}$ is $\\frac{80}{27}.$"} {:db/id #edb/ref 17592186292542 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4303ddd7-dd80-557e-94c5-24fbfb0ad1fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186290910} {:answer/id #uuid "48a923c6-cc3b-5089-9fce-e9f14180af2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186290932} {:answer/id #uuid "574e7a32-67e3-54e1-8b19-2b1ee067a26a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186290999} {:answer/id #uuid "7b147725-5652-5ce7-a2a7-7cd4069a7d2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186291152} {:answer/id #uuid "b38e70fb-c25c-5853-9965-02cf22dd4424" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186291415}] :answer-field/correct {:answer/id #uuid "574e7a32-67e3-54e1-8b19-2b1ee067a26a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186290999} :answer-field/id #uuid "09f7aae2-0668-546d-b86f-3c55db11ac96" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291772}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d2026ecc-ebf2-57c6-ab42-a50fb08ede36" :question/math-academy-id "q-2526" :question/problem "Consider the function $f(x)=\\operatorname{cos}⁡x+3x$ and the point $P(\\frac{\\pi }{2},\\frac{3\\pi }{2})$ that lies on $y=f(x).$ Given that $f(x)$ is invertible in the vicinity of $P,$ calculate ${({f}^{-1})}^{′}\\left(\\frac{3\\pi }{2}\\right).$" :question/worked-solution "We start by calculating the derivative of $f$ at the point $(\\frac{\\pi }{2},\\frac{3\\pi }{2}).$\n\n$$\n\\begin{aligned}\\begin{aligned}f(x) & =\\operatorname{cos}⁡x+3x \\\\ {f}^{′}(x) & =3-\\operatorname{sin}⁡x \\\\ {f}^{′}\\left(\\frac{\\pi }{2}\\right) & =2\\end{aligned}\\end{aligned}\n$$\n\nSince $(\\frac{\\pi }{2},\\frac{3\\pi }{2})$ lies on $y=f(x),$ we know that the corresponding point $(\\frac{3\\pi }{2},\\frac{\\pi }{2})$ lies on $y={f}^{-1}(x).$\n\nFurthermore, the slopes of the tangents to the two respective points are reciprocals. Therefore,\n\n$$\n\\begin{aligned}{({f}^{-1})}^{′}\\left(\\frac{3\\pi }{2}\\right) & =\\frac{1}{{f}^{′}({f}^{-1}\\left(\\frac{3\\pi }{2}\\right))} \\\\  & =\\frac{1}{{f}^{′}\\left(\\frac{\\pi }{2}\\right)} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292545 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52378cfc-0dd2-5bad-bfd6-171ba113ef4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186290983}] :answer-field/correct {:answer/id #uuid "52378cfc-0dd2-5bad-bfd6-171ba113ef4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186290983} :answer-field/id #uuid "4c205653-bf75-5cec-bc5b-791b78cd2ecc" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291975} {:answer-field/choices [{:answer/id #uuid "6b98c234-82a7-52e4-8660-adf687e02c41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186291097}] :answer-field/correct {:answer/id #uuid "6b98c234-82a7-52e4-8660-adf687e02c41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186291097} :answer-field/id #uuid "8232bcef-e69f-588b-b46b-ce7c5a4ab8cf" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292136} {:answer-field/choices [{:answer/id #uuid "f6af9bf9-8c4f-575c-8001-67ddc5fd61a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186291671}] :answer-field/correct {:answer/id #uuid "f6af9bf9-8c4f-575c-8001-67ddc5fd61a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186291671} :answer-field/id #uuid "9c49cec6-ebe8-5a63-9ab1-2fce82dd1e56" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/bla