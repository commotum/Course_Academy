{i}}{16}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\frac{20+48\\text{i}}{16} & =\\frac{20}{16}+\\frac{48}{16}\\text{i} \\\\  & =\\left(\\frac{5}{4}\\right)+(3)\\,\\text{i}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299525 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "959b2480-bd49-5abc-828f-6424d45e0eb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{8}" :db/id #edb/ref 17592186298198}] :answer-field/correct {:answer/id #uuid "959b2480-bd49-5abc-828f-6424d45e0eb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{8}" :db/id #edb/ref 17592186298198} :answer-field/id #uuid "7983fba1-cc38-51cf-aa9f-2a95c81d45e0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299052} {:answer-field/choices [{:answer/id #uuid "aade3aff-c6ac-5b21-8001-30535af17c81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{8}" :db/id #edb/ref 17592186298297}] :answer-field/correct {:answer/id #uuid "aade3aff-c6ac-5b21-8001-30535af17c81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{8}" :db/id #edb/ref 17592186298297} :answer-field/id #uuid "ca310e15-51ae-5e78-aad4-073693d4c9bf" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299314}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c5d5a4dc-cd55-5684-941d-7ef88ba8825b" :question/math-academy-id "q-316887" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{-9+7\\text{i}}{8\\text{i}}=($\n {{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "Here, the denominator is the imaginary number $8\\text{i}.$ Note that this can be written as $0+8\\text{i},$ so the conjugate is $0-8\\text{i},$ or simply $-8\\text{i}.$\n\nSo, we multiply both the numerator and the denominator by $-8\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{-9+7\\text{i}}{8\\text{i}} & =\\frac{-9+7\\text{i}}{8\\text{i}}\\cdot \\frac{-8\\text{i}}{-8\\text{i}} \\\\  & =\\frac{72\\text{i}-56{\\text{i}}^{2}}{-64{\\text{i}}^{2}} \\\\  & =\\frac{72\\text{i}-56(-1)}{-64(-1)} \\\\  & =\\frac{56+72\\text{i}}{64}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\frac{56+72\\text{i}}{64} & =\\frac{56}{64}+\\frac{72}{64}\\text{i} \\\\  & =\\left(\\frac{7}{8}\\right)+\\left(\\frac{9}{8}\\right)\\,\\text{i}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299526 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f1a33aa-2276-5faa-80f2-f623712273f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186298026}] :answer-field/correct {:answer/id #uuid "6f1a33aa-2276-5faa-80f2-f623712273f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186298026} :answer-field/id #uuid "887d4e7a-963e-54f3-b426-86ca9f39a67b" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299094} {:answer-field/choices [{:answer/id #uuid "1c5eacd9-bf83-5b6d-8479-55df901aa0a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{2}" :db/id #edb/ref 17592186297676}] :answer-field/correct {:answer/id #uuid "1c5eacd9-bf83-5b6d-8479-55df901aa0a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{2}" :db/id #edb/ref 17592186297676} :answer-field/id #uuid "c1dd680c-2bfa-57c4-8e91-75f62e01102b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299290}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6cdcc03d-9bc0-5aef-969c-114afb57f9f6" :question/math-academy-id "q-316888" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{-6-7\\text{i}}{2\\text{i}}=($\n{{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "Here, the denominator is the imaginary number $2\\text{i}.$ Note that this can be written as $0+2\\text{i},$ so the conjugate is $0-2\\text{i},$ or simply $-2\\text{i}.$\n\nSo, we multiply both the numerator and the denominator by $-2\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{-6-7\\text{i}}{2\\text{i}} & =\\frac{-6-7\\text{i}}{2\\text{i}}\\cdot \\frac{-2\\text{i}}{-2\\text{i}} \\\\  & =\\frac{12\\text{i}+14{\\text{i}}^{2}}{-4{\\text{i}}^{2}} \\\\  & =\\frac{12\\text{i}+14(-1)}{-4(-1)} \\\\  & =\\frac{-14+12\\text{i}}{4}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\frac{-14+12\\text{i}}{4} & =-\\frac{14}{4}+\\frac{12}{4}\\text{i} \\\\  & =\\left(-\\frac{7}{2}\\right)+(3)\\,\\text{i}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299527 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d54b03c6-2661-54b2-9f23-4b3ceefd45f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186298468}] :answer-field/correct {:answer/id #uuid "d54b03c6-2661-54b2-9f23-4b3ceefd45f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186298468} :answer-field/id #uuid "0dab98ed-207c-5e14-9dbe-732d9cb0d58e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298682} {:answer-field/choices [{:answer/id #uuid "efc21da9-1f85-5abb-8d0f-803b96265741" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{10}" :db/id #edb/ref 17592186298570}] :answer-field/correct {:answer/id #uuid "efc21da9-1f85-5abb-8d0f-803b96265741" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{10}" :db/id #edb/ref 17592186298570} :answer-field/id #uuid "6b9aa52e-d330-5b2f-8b30-ca6ecc18ef56" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298992}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7822b8b5-e9d2-5645-891c-e3cc1d2ee54a" :question/math-academy-id "q-316891" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{-5-9\\text{i}}{10\\text{i}}=($\n{{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "Here, the denominator is the imaginary number $10\\text{i}.$ Note that this can be written as $0+10\\text{i},$ so the conjugate is $0-10\\text{i},$ or simply $-10\\text{i}.$\n\nSo, we multiply both the numerator and the denominator by $-10\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{-5-9\\text{i}}{10\\text{i}} & =\\frac{-5-9\\text{i}}{10\\text{i}}\\cdot \\frac{-10\\text{i}}{-10\\text{i}} \\\\  & =\\frac{50\\text{i}+90{\\text{i}}^{2}}{-100{\\text{i}}^{2}} \\\\  & =\\frac{50\\text{i}+90(-1)}{-100(-1)} \\\\  & =\\frac{-90+50\\text{i}}{100}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\frac{-90+50\\text{i}}{100} & =-\\frac{90}{100}+\\frac{50}{100}\\text{i} \\\\  & =\\left(-\\frac{9}{10}\\right)+\\left(\\frac{1}{2}\\right)\\,\\text{i}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299528 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ccd14a42-c897-5311-8ea4-e6a64a34a910" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{28}{25}" :db/id #edb/ref 17592186298441}] :answer-field/correct {:answer/id #uuid "ccd14a42-c897-5311-8ea4-e6a64a34a910" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{28}{25}" :db/id #edb/ref 17592186298441} :answer-field/id #uuid "0bd7c1b6-3520-573f-a78a-be3806d978cf" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298676} {:answer-field/choices [{:answer/id #uuid "0cbaf04a-08f8-592e-9132-212c752dbae1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{25}" :db/id #edb/ref 17592186297613}] :answer-field/correct {:answer/id #uuid "0cbaf04a-08f8-592e-9132-212c752dbae1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{25}" :db/id #edb/ref 17592186297613} :answer-field/id #uuid "17d0f2f6-ddf8-5646-a723-9ddc6cd06626" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298724}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a0df5ab2-e3a9-51a6-90ae-3e454d5e41c0" :question/math-academy-id "q-316893" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{7}{3-4\\text{i}}=($\n{{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "The denominator is $3-4\\text{i}$ and its conjugate is $3+4\\text{i}.$ We multiply both the numerator and the denominator by $3+4\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{7}{3-4\\text{i}} & =\\frac{7}{3-4\\text{i}}\\cdot \\frac{3+4\\text{i}}{3+4\\text{i}} \\\\  & =\\frac{21+28\\text{i}}{9+12\\text{i}-12\\text{i}-16{\\text{i}}^{2}} \\\\  & =\\frac{21+28\\text{i}}{9-16(-1)} \\\\  & =\\frac{21+28\\text{i}}{25}.\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{21}{25}+\\frac{28}{25}\\text{i}=\\left(\\frac{21}{25}\\right)+\\left(\\frac{28}{25}\\right)\\,\\text{i}\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299529 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5abd447d-eb50-5bf8-a837-3645bf51bbfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{21}{13}" :db/id #edb/ref 17592186297934}] :answer-field/correct {:answer/id #uuid "5abd447d-eb50-5bf8-a837-3645bf51bbfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{21}{13}" :db/id #edb/ref 17592186297934} :answer-field/id #uuid "91d156a4-16b2-593e-be64-b4f1dbfb7c2d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299119} {:answer-field/choices [{:answer/id #uuid "61416d63-18fc-59ba-86c7-f8f0ba78678d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{13}" :db/id #edb/ref 17592186297964}] :answer-field/correct {:answer/id #uuid "61416d63-18fc-59ba-86c7-f8f0ba78678d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{13}" :db/id #edb/ref 17592186297964} :answer-field/id #uuid "987905b8-cc01-5a44-b026-c7de4f8bb9f1" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299141}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e670c179-3ce4-5739-9685-d9ed11fc889b" :question/math-academy-id "q-316896" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{7}{-3-2\\text{i}}=($\n{{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "The denominator is $-3-2\\text{i}$ and its conjugate is $-3+2\\text{i}.$ We multiply both the numerator and the denominator by $-3+2\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{7}{-3-2\\text{i}} & =\\frac{7}{-3-2\\text{i}}\\cdot \\frac{-3+2\\text{i}}{-3+2\\text{i}} \\\\  & =\\frac{7(-3+2\\text{i})}{(-3)^{2}-(2\\text{i})^{2}} \\\\  & =\\frac{-21+14\\text{i}}{9-(-4)} \\\\  & =\\frac{-21+14\\text{i}}{13}.\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{-21+14\\text{i}}{13}=\\left(-\\frac{21}{13}\\right)+\\left(\\frac{14}{13}\\right)\\,\\text{i}\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299530 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e85d64c8-31d2-5b22-bbce-cf181668b3ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{13}" :db/id #edb/ref 17592186298542}] :answer-field/correct {:answer/id #uuid "e85d64c8-31d2-5b22-bbce-cf181668b3ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{13}" :db/id #edb/ref 17592186298542} :answer-field/id #uuid "0dbd60d4-608b-5484-9b71-9e74a31a2421" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298683} {:answer-field/choices [{:answer/id #uuid "3c34e30b-ccfc-5483-8db9-f05fddd3e724" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{16}{13}" :db/id #edb/ref 17592186297790}] :answer-field/correct {:answer/id #uuid "3c34e30b-ccfc-5483-8db9-f05fddd3e724" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{16}{13}" :db/id #edb/ref 17592186297790} :answer-field/id #uuid "e745121b-0c1e-5085-94e3-27128650123a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299420}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1e0f218a-eb72-503e-b6ad-3bd1a87517fb" :question/math-academy-id "q-316904" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{5+2\\text{i}}{-2-3\\text{i}}=($\n{{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "The denominator is $-2-3\\text{i}$ and its conjugate is $-2+3\\text{i}.$ We multiply both the numerator and the denominator by $-2+3\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{5+2\\text{i}}{-2-3\\text{i}} & =\\frac{5+2\\text{i}}{-2-3\\text{i}}\\cdot \\frac{-2+3\\text{i}}{-2+3\\text{i}} \\\\  & =\\frac{(5+2\\text{i})(-2+3\\text{i})}{(-2)^{2}-(3\\text{i})^{2}} \\\\  & =\\frac{-10+15\\text{i}-4\\text{i}+6{\\text{i}}^{2}}{4-(-9)} \\\\  & =\\frac{-10+11\\text{i}+6(-1)}{13} \\\\  & =\\frac{-16+11\\text{i}}{13}.\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{-16+11\\text{i}}{13}=\\left(-\\frac{16}{13}\\right)+\\left(\\frac{11}{13}\\right)\\,\\text{i}\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299579 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eb47a05-41c7-5eca-ae67-a13bdd7efa56" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/28/28f40459196870b3458b35fb6de68bdba555350c9c7d0e39a067e62fbd628f5d.png" :db/id #edb/ref 17592186297621} {:answer/id #uuid "5f99b2cc-40d6-5bb1-9b8d-ec086d49247f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c0/c0014871af9ecd09b53f8c0bf03d38a26b7200c3004b3e71cb8a8376270f6f66.png" :db/id #edb/ref 17592186297955} {:answer/id #uuid "aa78daf2-6ef7-5085-88f2-31874e1dd9ff" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7a/7a47d0091b2abf6c361c71ac8601700135addbf6f588f31d44f2183ca4229941.png" :db/id #edb/ref 17592186298295} {:answer/id #uuid "ad1a4f6c-4e2a-5535-b53a-fecf35d9359e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f4/f41701c2788f0fdfd39c04a952798fe3b135303e7c75b6a1d192de486c97f261.png" :db/id #edb/ref 17592186298305} {:answer/id #uuid "d9ed0007-9649-5b86-a714-d326b8b19fa5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/25/2585bea4c102fdd732e6b677b09e9758fb5fac2affe408a6dc41cfa69c1154c3.png" :db/id #edb/ref 17592186298487}] :answer-field/correct {:answer/id #uuid "5f99b2cc-40d6-5bb1-9b8d-ec086d49247f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c0/c0014871af9ecd09b53f8c0bf03d38a26b7200c3004b3e71cb8a8376270f6f66.png" :db/id #edb/ref 17592186297955} :answer-field/id #uuid "89fc1caf-cb30-58db-b6c2-dcf48b28d7d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186299099}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f5a2bf88-da34-5e50-afc7-6bfeb2513dfb" :question/math-academy-id "q-317294" :question/problem "Which of the following is the graph of $y=-{\\left(\\frac{1}{5}\\right)}^{x}+4?$" :question/worked-solution "To plot the given function, we follow these steps:\n\n- We take the curve $y={\\left(\\frac{1}{5}\\right)}^{x}.$\n\n![](images/d6/d67114a9865ca54cdf14798e779cfa9c00e71598ba652d6fccdcf686f86e20ef.png)\n\n \n\n- Reflect it on the $x$-axis to give $y=-{\\left(\\frac{1}{5}\\right)}^{x}.$ The $y$-intercept moves from $(0,1)$ to $(0,-1)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/d6/d6dcae76f7fe89188ef449c817f7e7af48c25763077d1daee9626d2f26b1a78a.png)\n\n- Then, vertically shift it by $4$ units up to give $y=-{\\left(\\frac{1}{5}\\right)}^{x}+4.$ The point $(0,-1)$ moves to $(0,3)$ and the horizontal asymptote moves from $y=0$ to $y=4.$\n\n![](images/52/529dfc1ef1bc6f0ff58addca6cf27c5039a6cf18c5a307c06a153a3d56040ede.png)"} {:db/id #edb/ref 17592186299595 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "162becf1-1bd4-584f-967c-51eeb7d6032b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/de/defd4e44b6a4f65bdca693609e76936df5577963129262673866fbcd970b51af.png" :db/id #edb/ref 17592186297648} {:answer/id #uuid "781c642e-4551-52d5-8d96-d883025d7107" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/92/92db35f6bc5269d18e09e8c9c222bf267dbbdd7d3950ba18b98820b498645266.png" :db/id #edb/ref 17592186298076} {:answer/id #uuid "a1519311-806e-591f-9470-f390c48dda0a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/43/43780f30e916ba9c8e982007d106204ee9588864569274a155ad8f6e6c986a18.png" :db/id #edb/ref 17592186298264} {:answer/id #uuid "b32baeec-85ac-5077-8c1b-f49f91bfd359" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/38/3849144558185af70d482a7a5bf160fdc250d1ba06a63305b8e8ba00ab93329e.png" :db/id #edb/ref 17592186298332} {:answer/id #uuid "f07ad81d-1193-53fe-a9d9-7d954ee7e039" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/46/46939f65b7b39af0d3da7f7038a87c2b7d9591780371fd6b97cc08ba87af1c73.png" :db/id #edb/ref 17592186298571}] :answer-field/correct {:answer/id #uuid "a1519311-806e-591f-9470-f390c48dda0a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/43/43780f30e916ba9c8e982007d106204ee9588864569274a155ad8f6e6c986a18.png" :db/id #edb/ref 17592186298264} :answer-field/id #uuid "8ef482e3-66a8-5e09-80f2-e846dec14afe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186299111}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4221ea3f-4ea4-5360-8022-7beb92f1bc9e" :question/math-academy-id "q-317359" :question/problem "Which of the following is the graph of $y=-2{\\left(\\frac{1}{5}\\right)}^{x}-6?$" :question/worked-solution "To plot the given function, we follow these steps:\n\n- We take the curve $y=2{\\left(\\frac{1}{5}\\right)}^{x}.$\n\n![](images/9b/9b254387cd5a117e9dbc470b4f71d56399cb8cde9bb5b83b12f956b538383e61.png)\n\n- Reflect it on the $x$-axis to give $y=-2{\\left(\\frac{1}{5}\\right)}^{x}.$ The $y$-intercept moves from $(0,2)$ to $(0,-2)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/e4/e46a5ad8d2f51bc5112c960167879ff352e372bde573834d5394118448a8224c.png)\n\n- Then, vertically shift it by $6$ units down to give $y=-2{\\left(\\frac{1}{5}\\right)}^{x}-6.$ The point $(0,-2)$ moves to $(0,-8)$ and the horizontal asymptote moves from $y=0$ to $y=-6.$\n\n![](images/4a/4a360d7b90f2c2ea9b561ad53626682ed2b2b2f7459ab8c7bdafe8c02486c9c5.png)"} {:db/id #edb/ref 17592186299596 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d4b2714-199b-59fe-a41f-f7e979f3f9ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{10}" :db/id #edb/ref 17592186297616}] :answer-field/correct {:answer/id #uuid "0d4b2714-199b-59fe-a41f-f7e979f3f9ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{10}" :db/id #edb/ref 17592186297616} :answer-field/id #uuid "0ac069ea-97f0-5b28-aae8-5ec01ea01538" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298670}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e6ca014c-b5cb-5825-95b8-87e00a3142c6" :question/math-academy-id "q-317367" :question/problem "Calculate $det(D)$ given that\n$D=\\begin{bmatrix}\\frac{2}{5} & -3 \\\\ -\\frac{1}{2} & 2\\end{bmatrix}.$\n\n$det(D)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(D) & =|\\begin{aligned}\\frac{2}{5} & -3 \\\\ -\\frac{1}{2} & 2\\end{aligned}| \\\\  & =\\frac{2}{5}\\cdot 2-(-3)\\cdot \\left(-\\frac{1}{2}\\right) \\\\  & =\\frac{4}{5}-\\frac{3}{2} \\\\  & =-\\frac{7}{10}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299654 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11791b98-72e4-5dd2-9e23-564ef08d2cdb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b7/b7e9ab0e2d7f74be9a31bd24fee9b6594d52e6adcf308d2b3225d9666ad0ecf4.png" :db/id #edb/ref 17592186297631} {:answer/id #uuid "1a3e9709-4416-5fd2-ae07-37f46bc27fdd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d4/d43e43dc1b25b48797e5fa9de99b6ece6597d9d002a5df53620e8dcdc9190138.png" :db/id #edb/ref 1759