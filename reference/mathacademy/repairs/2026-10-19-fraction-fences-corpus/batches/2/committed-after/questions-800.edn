xt{i}}{25}=\\left(\\frac{24}{25}\\right)+\\left(-\\frac{32}{25}\\right)\\,\\text{i}\n$$"} {:db/id #edb/ref 17592186299518 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "daa91ad8-a6d7-5b38-a7d9-ed167da0b788" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{36}{25}" :db/id #edb/ref 17592186298490}] :answer-field/correct {:answer/id #uuid "daa91ad8-a6d7-5b38-a7d9-ed167da0b788" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{36}{25}" :db/id #edb/ref 17592186298490} :answer-field/id #uuid "2c91fdff-d30e-5a6b-8d90-286ee3bdc269" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298792} {:answer-field/choices [{:answer/id #uuid "e7b76737-a243-5d34-b320-c17e004a8fef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{48}{25}" :db/id #edb/ref 17592186298540}] :answer-field/correct {:answer/id #uuid "e7b76737-a243-5d34-b320-c17e004a8fef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{48}{25}" :db/id #edb/ref 17592186298540} :answer-field/id #uuid "47438fa0-84ed-5423-b77c-d1de527a509c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298878}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "de930b6d-d6c7-5f9c-b66a-76472097d31a" :question/math-academy-id "q-316870" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{12}{-4+3\\text{i}}=($\n{{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "The denominator is $-4+3\\text{i}$ and its conjugate is $-4-3\\text{i}.$ We multiply both the numerator and the denominator by $-4-3\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{12}{-4+3\\text{i}} & =\\frac{12}{-4+3\\text{i}}\\cdot \\frac{-4-3\\text{i}}{-4-3\\text{i}} \\\\  & =\\frac{12(-4-3\\text{i})}{(-4)^{2}-(3\\text{i})^{2}} \\\\  & =\\frac{-48-36\\text{i}}{16-(-9)} \\\\  & =\\frac{-48-36\\text{i}}{25}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{-48-36\\text{i}}{25}=\\left(-\\frac{48}{25}\\right)+\\left(-\\frac{36}{25}\\right)\\,\\text{i}\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299519 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c25021a-14e9-5373-b681-8e23616f8e53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{15}{13}" :db/id #edb/ref 17592186298018}] :answer-field/correct {:answer/id #uuid "6c25021a-14e9-5373-b681-8e23616f8e53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{15}{13}" :db/id #edb/ref 17592186298018} :answer-field/id #uuid "2cfba6bc-b3d0-5f3a-9ed7-0c3316bbefcd" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298794} {:answer-field/choices [{:answer/id #uuid "2b81e956-1531-52e8-b912-ed9521f49b36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{10}{13}" :db/id #edb/ref 17592186297733}] :answer-field/correct {:answer/id #uuid "2b81e956-1531-52e8-b912-ed9521f49b36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{10}{13}" :db/id #edb/ref 17592186297733} :answer-field/id #uuid "90532334-8b1b-5ad2-b44a-7004882c2172" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299115}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "32c702f0-97e4-5819-bf82-cfae9e8ebefb" :question/math-academy-id "q-316872" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{5}{-2+3\\text{i}}=($\n{{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "The denominator is $-2+3\\text{i}$ and its conjugate is $-2-3\\text{i}.$ We multiply both the numerator and the denominator by $-2-3\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{5}{-2+3\\text{i}} & =\\frac{5}{-2+3\\text{i}}\\cdot \\frac{-2-3\\text{i}}{-2-3\\text{i}} \\\\  & =\\frac{5(-2-3\\text{i})}{(-2)^{2}-(3\\text{i})^{2}} \\\\  & =\\frac{-10-15\\text{i}}{4-(-9)} \\\\  & =\\frac{-10-15\\text{i}}{13}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\frac{-10-15\\text{i}}{13}=\\left(-\\frac{10}{13}\\right)+\\left(-\\frac{15}{13}\\right)\\,\\text{i}\n$$"} {:db/id #edb/ref 17592186299520 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "664b470d-28ba-5425-a57f-21cbfbe6c293" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{13}" :db/id #edb/ref 17592186297988}] :answer-field/correct {:answer/id #uuid "664b470d-28ba-5425-a57f-21cbfbe6c293" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{13}" :db/id #edb/ref 17592186297988} :answer-field/id #uuid "28794ad7-9314-58fa-a882-51aa4ac7fbc5" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298773} {:answer-field/choices [{:answer/id #uuid "8a6d973e-1ce0-5cfa-8146-ba2aa13412db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8}{13}" :db/id #edb/ref 17592186298153}] :answer-field/correct {:answer/id #uuid "8a6d973e-1ce0-5cfa-8146-ba2aa13412db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8}{13}" :db/id #edb/ref 17592186298153} :answer-field/id #uuid "76d5dd62-7b3a-54ca-a6cf-c63113417c11" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299038}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1673da71-04da-5604-9f7b-e353f7fea521" :question/math-academy-id "q-316875" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{4}{-2-3\\text{i}}=($\n{{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "The denominator is $-2-3\\text{i}$ and its conjugate is $-2+3\\text{i}.$ We multiply both the numerator and the denominator by $-2+3\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{4}{-2-3\\text{i}} & =\\frac{4}{-2-3\\text{i}}\\cdot \\frac{-2+3\\text{i}}{-2+3\\text{i}} \\\\  & =\\frac{4(-2+3\\text{i})}{(-2)^{2}-(3\\text{i})^{2}} \\\\  & =\\frac{-8+12\\text{i}}{4-(-9)} \\\\  & =\\frac{-8+12\\text{i}}{13}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\frac{-8+12\\text{i}}{13}=\\left(-\\frac{8}{13}\\right)+\\left(\\frac{12}{13}\\right)\\,\\text{i}\n$$"} {:db/id #edb/ref 17592186299521 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ee7e173-9660-5838-8c1e-f9f857d04efe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186298252}] :answer-field/correct {:answer/id #uuid "9ee7e173-9660-5838-8c1e-f9f857d04efe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186298252} :answer-field/id #uuid "6c39a571-c179-56c1-b38d-7ec2a6f98b56" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298996} {:answer-field/choices [{:answer/id #uuid "c6e5fd0c-c1e0-532f-ade5-ab512e43cf03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186298422}] :answer-field/correct {:answer/id #uuid "c6e5fd0c-c1e0-532f-ade5-ab512e43cf03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186298422} :answer-field/id #uuid "f7da677a-222d-5e8b-9b1c-8cb8ef628b8c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299477}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4e97e54e-41af-5702-ad40-02a465fede8e" :question/math-academy-id "q-316880" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{3+2\\text{i}}{4\\text{i}}=($\n{{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "Here, the denominator is the imaginary number $4\\text{i}.$ Note that this can be written as $0+4\\text{i},$ so the conjugate is $0-4\\text{i},$ or simply $-4\\text{i}.$\n\nSo, we multiply both the numerator and the denominator by $-4\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{3+2\\text{i}}{4\\text{i}} & =\\frac{3+2\\text{i}}{4\\text{i}}\\cdot \\left(\\frac{-4\\text{i}}{-4\\text{i}}\\right) \\\\  & =\\frac{-12\\text{i}-8{\\text{i}}^{2}}{-16{\\text{i}}^{2}} \\\\  & =\\frac{-12\\text{i}-8(-1)}{-16(-1)} \\\\  & =\\frac{8-12\\text{i}}{16}.\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{8-12\\text{i}}{16} & =\\frac{8}{16}-\\frac{12}{16}\\text{i} \\\\  & =\\left(\\frac{1}{2}\\right)+\\left(-\\frac{3}{4}\\right)\\,\\text{i}\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299522 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95a39897-3e93-5e95-9e86-04a91f97f5b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186298199}] :answer-field/correct {:answer/id #uuid "95a39897-3e93-5e95-9e86-04a91f97f5b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186298199} :answer-field/id #uuid "44df5415-27f0-51fc-87b2-deb2ddc80318" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298873} {:answer-field/choices [{:answer/id #uuid "c5af3722-53ab-597b-9053-26261cbcf048" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{6}" :db/id #edb/ref 17592186298417}] :answer-field/correct {:answer/id #uuid "c5af3722-53ab-597b-9053-26261cbcf048" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{6}" :db/id #edb/ref 17592186298417} :answer-field/id #uuid "898e248c-8da0-5951-81d0-0f92480eb566" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299098}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "12677341-1463-5e87-9f29-dafe5d5a0f38" :question/math-academy-id "q-316883" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{9-5\\text{i}}{6\\text{i}}=($\n{{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "Here, the denominator is the imaginary number $6\\text{i}.$ Note that this can be written as $0+6\\text{i},$ so the conjugate is $0-6\\text{i},$ or simply $-6\\text{i}.$\n\nSo, we multiply both the numerator and the denominator by $-6\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{9-5\\text{i}}{6\\text{i}} & =\\frac{9-5\\text{i}}{6\\text{i}}\\cdot \\frac{-6\\text{i}}{-6\\text{i}} \\\\  & =\\frac{-54\\text{i}+30{\\text{i}}^{2}}{-36{\\text{i}}^{2}} \\\\  & =\\frac{-54\\text{i}+30(-1)}{-36(-1)} \\\\  & =\\frac{-30-54\\text{i}}{36}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\frac{-30-54\\text{i}}{36} & =-\\frac{30}{36}-\\frac{54}{36}\\text{i} \\\\  & =\\left(-\\frac{5}{6}\\right)+\\left(-\\frac{3}{2}\\right)\\,\\text{i}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299523 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ee54aca-18c7-58e2-82b0-928d8ba23049" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186297799}] :answer-field/correct {:answer/id #uuid "3ee54aca-18c7-58e2-82b0-928d8ba23049" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186297799} :answer-field/id #uuid "c96204d8-36ff-5015-aacb-a8bb3db533c7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299313} {:answer-field/choices [{:answer/id #uuid "623ea90c-97aa-56c9-964c-0cabdb7ec977" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186297971}] :answer-field/correct {:answer/id #uuid "623ea90c-97aa-56c9-964c-0cabdb7ec977" :answer/type {:db/