} {:answer-field/choices [{:answer/id #uuid "4c6cf545-8650-5aea-ba7d-cff18c9b3410" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{17}{3}" :db/id #edb/ref 17592186297866}] :answer-field/correct {:answer/id #uuid "4c6cf545-8650-5aea-ba7d-cff18c9b3410" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{17}{3}" :db/id #edb/ref 17592186297866} :answer-field/id #uuid "26566d49-0a0b-5bc0-ad10-d09b749aefe9" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298764} {:answer-field/choices [{:answer/id #uuid "090c7b05-eeb7-5ab9-b69a-58bdb4369c3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{19}{3}" :db/id #edb/ref 17592186297600}] :answer-field/correct {:answer/id #uuid "090c7b05-eeb7-5ab9-b69a-58bdb4369c3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{19}{3}" :db/id #edb/ref 17592186297600} :answer-field/id #uuid "72a8c699-cc7e-58a6-abee-7c25a2c65abb" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299025} {:answer-field/choices [{:answer/id #uuid "bf89769d-7de5-5324-b746-1a5710ddda0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{4}" :db/id #edb/ref 17592186298396}] :answer-field/correct {:answer/id #uuid "bf89769d-7de5-5324-b746-1a5710ddda0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{4}" :db/id #edb/ref 17592186298396} :answer-field/id #uuid "e08fbd9e-c298-5e87-b7ff-0275a0e79bd4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299400}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9aeb9fb1-11fc-52ad-8f0e-fdbd7fcf849e" :question/math-academy-id "q-318311" :question/problem "If $C=\\begin{bmatrix}\\frac{1}{2} & -\\frac{3}{4} \\\\ 2 & \\frac{1}{3}\\end{bmatrix}$\nand\n$D=\\begin{bmatrix}-3 & \\frac{5}{2} \\\\ 1 & 4\\end{bmatrix},$\nthen\n\n| $CD=\\,\\,$ |  | {{field-1}} | {{field-2}} |  | $\\,.$ |\n| --- | --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |  |" :question/worked-solution "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}CD & =\\begin{bmatrix}\\frac{1}{2} & -\\frac{3}{4} \\\\ 2 & \\frac{1}{3}\\end{bmatrix}\\begin{bmatrix}-3 & \\frac{5}{2} \\\\ 1 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{1}{2}\\cdot (-3)+\\left(-\\frac{3}{4}\\right)\\cdot 1\\, & \\,\\frac{1}{2}\\cdot \\frac{5}{2}+\\left(-\\frac{3}{4}\\right)\\cdot 4 \\\\ 2\\cdot (-3)+\\frac{1}{3}\\cdot 1\\, & \\,2\\cdot \\frac{5}{2}+\\frac{1}{3}\\cdot 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{3}{2}-\\frac{3}{4}\\, & \\,\\frac{5}{4}-3 \\\\ -6+\\frac{1}{3}\\, & \\,5+\\frac{4}{3}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{9}{4} & -\\frac{7}{4} \\\\ -\\frac{17}{3} & \\frac{19}{3}\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299701 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d1ca4d4-7351-58fd-97c2-4515882b9eff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{2}" :db/id #edb/ref 17592186298095}] :answer-field/correct {:answer/id #uuid "7d1ca4d4-7351-58fd-97c2-4515882b9eff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{2}" :db/id #edb/ref 17592186298095} :answer-field/id #uuid "1616ad67-70d1-5ebb-bb64-611f3e8271e0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298720}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f95bba43-9c68-572a-b72d-21ed2ae6f555" :question/math-academy-id "q-318964" :question/problem "Suppose $|\\,k\\,|=2\\sqrt{2}$ and the angle between vectors $k$ and $l$ is $\\theta ={120}^{∘}.$ Find the scalar projection of $k$ onto $l.$\n\n${\\text{comp}}_{l}\\,k=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{l}\\,k & =|\\,k\\,|\\operatorname{cos}⁡\\theta  \\\\  & =2\\sqrt{2}\\operatorname{cos}⁡({120}^{∘}) \\\\  & =2\\sqrt{2}\\cdot \\left(-\\frac{1}{2}\\right) \\\\  & =-\\sqrt{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299702 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74545791-26c1-5947-9c5b-b677dc493399" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186298054}] :answer-field/correct {:answer/id #uuid "74545791-26c1-5947-9c5b-b677dc493399" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186298054} :answer-field/id #uuid "ee6c562c-1cf7-5f43-b2d5-435bef859ba2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299441}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "503c449a-b9d1-5796-9d9e-bf3065bb8dec" :question/math-academy-id "q-318971" :question/problem "Suppose $|\\,r\\,|=10$ and the angle between vectors $r$ and $s$ is $\\theta =\\frac{2\\pi }{3}.$ Find the scalar projection of $r$ onto $s.$\n\n${\\text{comp}}_{s}\\,r=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{s}\\,r & =|\\,r\\,|\\operatorname{cos}⁡\\theta  \\\\  & =10cos\\,\\left(\\frac{2\\pi }{3}\\right) \\\\  & =10\\cdot \\left(-\\frac{1}{2}\\right) \\\\  & =-5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299703 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c5684a7-6510-556f-b323-b27961d61e18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{3}" :db/id #edb/ref 17592186297675}] :answer-field/correct {:answer/id #uuid "1c5684a7-6510-556f-b323-b27961d61e18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{3}" :db/id #edb/ref 17592186297675} :answer-field/id #uuid "4ac50c16-4972-5306-a766-6c8022e7162a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298886}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d0d7d073-069e-5803-942e-5e5c5ad68481" :question/math-academy-id "q-318972" :question/problem "Suppose $|\\,p\\,|=8$ and the angle between vectors $p$ and $q$ is $\\theta =\\frac{\\pi }{6}.$ Find the scalar projection of $p$ onto $q.$\n\n${\\text{comp}}_{q}\\,p=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =|\\,p\\,|\\operatorname{cos}⁡\\theta  \\\\  & =8cos\\,\\left(\\frac{\\pi }{6}\\right) \\\\  & =8\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =4\\sqrt{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299704 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e39c7bca-ae4b-503b-9c4a-c72c47f4989e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186298530}] :answer-field/correct {:answer/id #uuid "e39c7bca-ae4b-503b-9c4a-c72c47f4989e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186298530} :answer-field/id #uuid "c1d8a04d-078a-5212-83f2-c8e21cfb63c6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299289}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3704c26f-1804-5b27-a680-7d8f815d3672" :question/math-academy-id "q-318975" :question/problem "Suppose $|\\,t\\,|=\\sqrt{2}$ and the angle between vectors $t$ and $u$ is $\\theta =\\frac{3\\pi }{4}.$ Find the scalar projection of $t$ onto $u.$\n\n${\\text{comp}}_{u}\\,t=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{u}\\,t & =|\\,t\\,|\\operatorname{cos}⁡\\theta  \\\\  & =\\sqrt{2}cos\\,\\left(\\frac{3\\pi }{4}\\right) \\\\  & =\\sqrt{2}\\cdot \\left(-\\frac{\\sqrt{2}}{2}\\right) \\\\  & =-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299705 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12c94840-ea0a-5cb5-b3b6-df293a492727" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186297637}] :answer-field/correct {:answer/id #uuid "12c94840-ea0a-5cb5-b3b6-df293a492727" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186297637} :answer-field/id #uuid "0d6fc074-46b1-5281-a18e-e811903a7f24" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298681}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bbd01580-a282-5eb8-b608-20ac603d9781" :question/math-academy-id "q-318976" :question/problem "Suppose $|\\,r\\,|=3\\sqrt{3}$ and the angle between vectors $r$ and $s$ is $\\theta =\\frac{\\pi }{2}.$ Find the scalar projection of $r$ onto $s.$\n\n${\\text{comp}}_{s}\\,r=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we have\n\n$$\n\\begin{aligned}{\\text{comp}}_{s}\\,r & =|\\,r\\,|\\operatorname{cos}⁡\\theta  \\\\  & =3\\sqrt{3}cos\\,\\left(\\frac{\\pi }{2}\\right) \\\\  & =3\\sqrt{3}\\cdot 0 \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299768 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b15d823-5299-5f11-8964-489306e38373" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.60" :db/id #edb/ref 17592186298156}] :answer-field/correct {:answer/id #uuid "8b15d823-5299-5f11-8964-489306e38373" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.60" :db/id #edb/ref 17592186298156} :answer-field/id #uuid "df880d85-f2de-5046-a4ec-3c13075a93d8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299396}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a5f26b04-c224-5e5b-b7ec-b6e734fe3cb5" :question/math-academy-id "q-319492" :question/problem "Find, **in radians**, the argument of $z=-5+3\\text{i}.$ Round your final answer to **two decimal places**.\n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$\n\n$\\operatorname{arg}⁡(z)≈$\n{{field-1}}" :question/requires-calculator true :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](images/21/217fc7ba4c6a6c18d0be184a9d5cc7b0a682ed2bd0da6e284955040643bc2e03.png)\n\nThe complex number $z$ lies in the second quadrant of the complex plane. Hence $\\frac{\\pi }{2}<\\operatorname{arg}⁡(z)<\\pi .$\n\nIf $\\alpha $ is the angle that $z$ makes with the negative real axis, then\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡\\alpha  & =\\frac{3}{5} \\\\ \\alpha  & =arctan\\,\\left(\\frac{3}{5}\\right) \\\\  & =0.540\\,419…\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arg}⁡(z)=\\pi -0.540\\,419…≈2.60,\n$$\n\nrounded to $2$ decimal places."} {:db/id #edb/ref 17592186299769 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae38652c-2ec4-5294-bfa0-e1935f6c9b32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.51" :db/id #edb/ref 17592186298311}] :answer-field/correct {:answer/id #uuid "ae38652c-2ec4-5294-bfa0-e1935f6c9b32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.51" :db/id #edb/ref 17592186298311} :answer-field/id #uuid "fbb6c9cf-47c9-59b5-b61c-a18d9aef50e9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299487}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "19bf53c8-97d2-5dba-bc67-23661ef3ef49" :question/math-academy-id "q-319499" :question/problem "Find, **in radians**, the argument of $z=-11+8\\text{i}.$ Round your final answer to **two decimal places**.\n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$ \n\n$arg⁡(z)≈$\n{{field-1}}" :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](images/d3/d3b5558c0268843618c52c588ffcf1c8012189041b17d52fadd6fe74c3526700.png)\n\nThe complex number $z$ lies in the second quadrant of the complex plane. Hence $\\frac{\\pi }{2}<arg⁡(z)<\\pi .$ \n\nIf $\\alpha $ is the angle that $z$ makes with the negative real axis, then\n\n$$\n\\begin{aligned}tan⁡\\alpha  & =\\frac{8}{11} \\\\ \\alpha  & =arctan⁡\\left(\\frac{8}{11}\\right) \\\\  & =0.628\\text{ }796\\text{ }…\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =arg⁡(z)=\\pi -0.628\\text{ }796\\text{ }…≈2.51,\n$$\n\nrounded to $2$ decimal places."} {:db/id #edb/ref 17592186299773 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc701588-10c4-5d4e-9543-08d3d2ae94c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.84" :db/id #edb/ref 17592186298496}] :answer-field/correct {:answer/id #uuid "dc701588-10c4-5d4e-9543-08d3d2ae94c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.84" :db/id #edb/ref 17592186298496} :answer-field/id #uuid "4d3b7e38-0b54-59dc-9f13-4a0765a858b8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298896}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1e12c374-884a-5b4a-b66b-2ae8579d07d0" :question/math-academy-id "q-319512" :question/problem "Find, **in radians**, the argument of $z=-6-5\\text{i}.$ Round your final answer to **two decimal places**.\n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$\n\n$\\operatorname{arg}⁡(z)≈$\n{{field-1}}" :question/requires-calculator true :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](images/93/93018ffa3e41f787cf32e4fa9735be8f5c6f9da360361434076cbfaecce51259.png)\n\nThe complex number $z$ lies in the third quadrant of the complex plane. Hence $\\pi <\\operatorname{arg}⁡(z)<\\frac{3\\pi }{2}.$ \n\nIf $\\alpha $ is the angle that $z$ makes with the negative real axis, then\n\n$$\n\\alpha =arctan\\,\\left(\\frac{5}{6}\\right)=0.694\\,738…\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arg}⁡(z)=\\pi +0.694\\,738…≈3.84,\n$$\n\nrounded to $2$ decimal places."} {:db/id #edb/ref 17592186299774 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d16c0be-59cf-52e9-8bdb-920c6cac59ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.70" :db/id #edb/ref 17592186297615}] :answer-field/correct {:answer/id #uuid "0d16c0be-59cf-52e9-8bdb-920c6cac59ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.70" :db/id #edb/ref 17592186297615} :answer-field/id #uuid "df60367e-d76b-5d80-9d6f-56f689210ad0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299394}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3a7750e6-1212-56c5-8da7-d5e6f9776240" :question/math-academy-id "q-319517" :question/problem "Find, **in radians**, the argument of $z=-8-5\\text{i}.$ Round your final answer to **two decimal places**.\n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$ \n\n$arg⁡(z)≈$\n{{field-1}}" :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](images/c5/c598c3b872cd2c4b3af08d8b2dbaf6a79512fe382473320feb526f31e5ece246.png)\n\nThe complex number $z$ lies in the third quadrant of the complex plane. Hence $\\pi <arg⁡(z)<\\frac{3\\pi }{2}.$ \n\nIf $\\alpha $ is the angle that $z$ makes with the negative real axis, then\n\n$$\n\\alpha =arctan\\,\\left(\\frac{5}{8}\\right)=0.558\\,599…\n$$\n\nTherefore,\n\n$$\n\\theta =arg⁡(z)=\\pi +0.558\\,599…≈3.70,\n$$\n\nrounded to $2$ decimal places."} {:db/id #edb/ref 17592186299775 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d8d7c10-dd12-5903-af0e-c687a3bccf1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.64" :db/id #edb/ref 17592186298024}] :answer-field/correct {:answer/id #uuid "6d8d7c10-dd12-5903-af0e-c687a3bccf1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.64" :db/id #edb/ref 17592186298024} :answer-field/id #uuid "c156e4b9-7c3e-5f5b-a864-47e9e4fe256f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299287}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "36d80563-8d54-5785-b9e6-542151d14e83" :question/math-academy-id "q-319519" :question/problem "Find, **in radians**, the argument of $z=-11-6\\text{i}.$ Round your final answer to **two decimal places**.\n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$ \n\n$arg⁡(z)≈$\n{{field-1}}" :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](images/ab/ab2f3a9137c05ca19507e44d2bb2ef4b369c762189019265d8fe3bad34822fe7.png)\n\nThe complex number $z$ lies in the third quadrant of the complex plane. Hence $\\pi <arg⁡(z)<\\frac{3\\pi }{2}.$ \n\nIf $\\alpha $ is the angle that $z$ makes with the negative real axis, then\n\n$$\n\\alpha =arctan\\,\\left(\\frac{6}{11}\\right)=0.499\\,346…\n$$\n\nTherefore,\n\n$$\n\\theta =arg⁡(z)=\\pi +0.499\\,346…≈3.64,\n$$\n\nrounded to $2$ decimal places."} {:db/id #edb/ref 17592186299779 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b99653d1-9906-5c8c-b3cf-ef75662558a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.34" :db/id #edb/ref 17592186298360}] :answer-field/correct {:answer/id #uuid "b99653d1-9906-5c8c-b3cf-ef75662558a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.34" :db/id #edb/ref 17592186298360} :answer-field/id #uuid "1162fc23-32c9-529d-a242-487de940e14e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298700}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dae3d16d-fc3e-5ce1-9aad-53c052f42d7b" :question/math-academy-id "q-319562" :question/problem "Find, **in radians**, the argument of $z=8-11\\text{i}.$ Round your final answer to **two decimal places**.\n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$ \n\n$arg⁡(z)≈$\n{{field-1}}" :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](images/16/16408e6add22c687e3d2cf865908011602bfa87878fcbc3387c4ad3d22180e47.png)\n\nThe complex number $z$ lies in the fourth quadrant of the complex plane. Hence $\\frac{3\\pi }{2}<arg⁡(z)<2\\pi .$ \n\nIf $\\alpha $ is the angle that $z$ makes with the positive real axis, then\n\n$$\n\\alpha =arctan⁡\\left(\\frac{11}{8}\\right)=0.942\\,000…\n$$\n\nTherefore,\n\n$$\n\\theta =arg⁡(z)=2\\pi -0.942\\,000≈5.34,\n$$\n\nrounded to $2$ decimal places."} {:db/id #edb/ref 17592186299780 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1ed74be-5bd1-5cfb-83ae-8da1c46abddc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11\\pi }{6}" :db/id #edb/ref 17592186298461} {:answer/id #uuid "bf73cf84-e656-5869-bd56-89d900a17b12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11\\pi}{6}" :db/id #edb/ref 17592186544495}] :answer-field/correct {:answer/id #uuid "bf73cf84-e656-5869-bd56-89d900a17b12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11\\pi}{6}" :db/id #edb/ref 17592186544495} :answer-field/id #uuid "664bc144-8adc-5276-97ef-e29bdce72ee9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298983}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e5b42c0b-e569-59e6-b7d2-a632bdfada48" :question/math-academy-id "q-319581" :question/problem "Find, **in radians**, the **exact value** of the argument of $z=8\\sqrt{3}-8\\text{i}.$\n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$ \n\n$\\operatorname{arg}⁡(z)=$\n{{field-1}}" :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](images/78/78399e67e0ba69c1d7848a41aa5d4a5f8040fc578aab30a99f7e19ac86ece179.png)\n\nThe complex number $z$ lies in the fourth quadrant of the complex plane. Hence $\\frac{3\\pi }{2}<\\operatorname{arg}⁡(z)<2\\pi .$ \n\nIf $\\alpha $ is the angle that $z$ makes with the positive real axis, then\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡\\alpha  & =\\frac{8}{8\\sqrt{3}} \\\\ \\alpha  & =arctan\\,\\left(\\frac{1}{\\sqrt{3}}\\right) \\\\  & =\\frac{\\pi }{6}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arg}⁡(z)=2\\pi -\\frac{\\pi }{6}=\\frac{11\\pi }{6}.\n$$"}]
