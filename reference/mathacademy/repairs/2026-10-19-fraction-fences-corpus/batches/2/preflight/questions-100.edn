3-1}{(x)}^{1}+(\\frac{3}{2}){(5)}^{3-2}{(x)}^{2}+⋯ \\\\  & =1{(5)}^{3}+3{(5)}^{2}{(x)}^{1}+3{(5)}^{1}{(x)}^{2}+⋯ \\\\  & =125+75x+15{x}^{2}+⋯.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269095 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4aecc576-32e8-5d61-a0c6-f70768e03e4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "243-81x-27{x}^{2}+⋯" :db/id #edb/ref 17592186266809} {:answer/id #uuid "88a30fb7-1f79-5d01-ac19-8c7af8c0036f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "243-405x+27{x}^{2}+⋯" :db/id #edb/ref 17592186267356} {:answer/id #uuid "96ebafec-4d42-5484-97b8-e0927b98bbda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "243-81x+270{x}^{2}+⋯" :db/id #edb/ref 17592186267492} {:answer/id #uuid "ba2c4420-8b12-583c-83ec-073b4e41b450" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81-405x-270{x}^{2}+⋯" :db/id #edb/ref 17592186267813} {:answer/id #uuid "bfe458b3-a26e-585f-b00c-c23d5ba13877" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "243-405x+270{x}^{2}+⋯" :db/id #edb/ref 17592186267863}] :answer-field/correct {:answer/id #uuid "bfe458b3-a26e-585f-b00c-c23d5ba13877" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "243-405x+270{x}^{2}+⋯" :db/id #edb/ref 17592186267863} :answer-field/id #uuid "3946ed6c-e0e0-554f-8d70-ba8729032217" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268497}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "91a346d9-29c0-5c6c-b6c8-79b5f0d321bb" :question/math-academy-id "q-136006" :question/problem "$(3-x)^{5}=$" :question/worked-solution "The binomial theorem states that for any positive integer $n,$ we have\n\n \n\n$$\n(a+b)^{n}=(\\frac{n}{0}){a}^{n}{b}^{0}+(\\frac{n}{1}){a}^{n-1}{b}^{1}+(\\frac{n}{2}){a}^{n-2}{b}^{2}+⋯+(\\frac{n}{n}){a}^{0}{b}^{n}.\n$$\n\nIn the case of $(3-x)^{5},$ we have  $a=3,$ $b=-x,$ $n=5.$ \n\nTherefore, the first three terms of $(3-x)^{5}$ are as follows:\n\n$$\n\\begin{aligned}{(3-x)}^{5} & =(\\frac{5}{0}){(3)}^{5}{(-x)}^{0}+(\\frac{5}{1}){(3)}^{5-1}{(-x)}^{1}+(\\frac{5}{2}){(3)}^{5-2}{(-x)}^{2}+⋯ \\\\  & =1{(3)}^{5}+5{(3)}^{4}{(-x)}^{1}+10{(3)}^{3}{(-x)}^{2}+⋯ \\\\  & =243-405x+270{x}^{2}+⋯.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269096 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17f8c8f1-5a15-5f94-8cb7-e3789bf1af59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "125-25x-5{x}^{2}+⋯" :db/id #edb/ref 17592186266342} {:answer/id #uuid "36a06821-b93c-57be-a1eb-900cea0251e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "125-75x+3{x}^{2}+⋯" :db/id #edb/ref 17592186266614} {:answer/id #uuid "3f56077d-6c0a-5c98-9703-89a04a9ec422" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "125-25x+15{x}^{2}+⋯" :db/id #edb/ref 17592186266715} {:answer/id #uuid "9db91806-017c-5b9f-9919-cbb591234113" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "125-75x+15{x}^{2}+⋯" :db/id #edb/ref 17592186267565} {:answer/id #uuid "b4c2a395-7b44-53fd-a19b-f835706ebcb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "125+75x-5{x}^{2}+⋯" :db/id #edb/ref 17592186267759}] :answer-field/correct {:answer/id #uuid "9db91806-017c-5b9f-9919-cbb591234113" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "125-75x+15{x}^{2}+⋯" :db/id #edb/ref 17592186267565} :answer-field/id #uuid "2ae16681-000c-575e-9eb7-75fa3e2bf4d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.