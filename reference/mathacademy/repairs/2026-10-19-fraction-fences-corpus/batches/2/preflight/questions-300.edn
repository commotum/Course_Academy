wer.type/math} :answer/value "{lim}_{h\\to 0}[\\frac{1}{h}(\\frac{{x}^{2}}{(y+h+2)^{3}}-\\frac{{x}^{2}}{(y+2)^{3}})]" :db/id #edb/ref 17592186276738} :answer-field/id #uuid "a188f0c3-15f8-5c12-aa43-1dce2bcf1a25" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278010}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "31a26b77-cde2-5225-9c1c-15176a7705f8" :question/math-academy-id "q-159589" :question/problem "Given that $f(x,y)=\\frac{{x}^{2}}{(y+2)^{3}},$ then $\\frac{∂f}{∂y}=$" :question/worked-solution "The derivative of $f$ with respect to $y$ is given by the limit \n\n$$\n\\frac{∂f}{∂y}={lim}_{h\\to 0}(\\frac{f(x,y+h)-f(x,y)}{h}).\n$$\n\nSince $f(x)=\\frac{{x}^{2}}{(y+2)^{3}},$  we have that \n\n$$\nf(x,y+h)=\\frac{{x}^{2}}{(y+h+2)^{3}}.\n$$\n\nTherefore,\n\n$$\n\\frac{∂f}{∂y}={lim}_{h\\to 0}[\\frac{1}{h}(\\frac{{x}^{2}}{(y+h+2)^{3}}-\\frac{{x}^{2}}{(y+2)^{3}})].\n$$"} {:db/id #edb/ref 17592186278233 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "249ebeac-e510-559d-a04e-8e2375a2831c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{{3}^{xyh}-{3}^{xy}}{h})" :db/id #edb/ref 17592186275806} {:answer/id #uuid "4c0ac94f-8e99-53ac-8de2-0c4f79ea8d3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{{3}^{xy+h}-{3}^{xy}}{h})" :db/id #edb/ref 17592186276146} {:answer/id #uuid "98310189-0e48-5672-8231-757b76da0ac1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{{3}^{x(y+h)}-{3}^{xy}}{h})" :db/id #edb/ref 17592186276845} {:answer/id #uuid "ab929482-7885-5340-ac99-508b3d867148" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{{3}^{x(y-h)}+{3}^{xy}}{h})" :db/id #edb/ref 17592186277019} {:answer/id #uuid "f822d8e0-bdc3-5436-a10f-0e2f3829e6db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{{3}^{xy-h}+{3}^{xy}}{h})" :db/id #edb/ref 17592186277646}] :answer-field/correct {:answer/id #uuid "98310189-0e48-5672-8231-757b76da0ac1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{{3}^{x(y+h)}-{3}^{xy}}{h})" :db/id #edb/ref 17592186276845} :answer-field/id #uuid "b234f6ec-b3e8-5cd0-a075-9cdfd38eace2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278035}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "96b9d7fd-e6bd-5861-b4a2-0c2b1d143000" :question/math-academy-id "q-159593" :question/problem "Given that $f(x,y)={3}^{xy},$ then $\\frac{∂f}{∂y}=$" :question/worked-solution "The derivative of $f$ with respect to $y$ is given by the limit \n\n$$\n\\frac{∂f}{∂y}={lim}_{h\\to 0}(\\frac{f(x,y+h)-f(x,y)}{h}).\n$$\n\nSince $f(x)={3}^{xy},$  we have that \n\n$$\nf(x,y+h)={3}^{x(y+h)}.\n$$\n\nTherefore,\n\n$$\n\\frac{∂f}{∂y}={lim}_{h\\to 0}(\\frac{{3}^{x(y+h)}-{3}^{xy}}{h}).\n$$"} {:db/id #edb/ref 17592186278234 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a7ffcb1-b787-5688-a29a-b14cbb4f5d13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{\\sqrt[3]{{x}^{2}-yh}+\\sqrt[3]{{x}^{2}-y}}{h})" :db/id #edb/ref 17592186275865} {:answer/id #uuid "387f4d00-3ca9-5bc5-88ef-bdb211870301" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{h\\sqrt[3]{{x}^{2}-y}-\\sqrt[3]{{x}^{2}-y}}{h})" :db/id #edb/ref 17592186275977} {:answer/id #uuid "60dd8e6e-8fb3-5403-b935-b1d6062ef077" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{\\sqrt[3]{{x}^{2}-(y-h)}+\\sqrt[3]{{x}^{2}-y}}{h})" :db/id #edb/ref 17592186276350} {:answer/id #uuid "b8904d3e-ea3f-58de-a7d5-6645fe9d0a85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{\\sqrt[3]{{x}^{2}-yh}-\\sqrt[3]{{x}^{2}-y}}{h})" :db/id #edb/ref 17592186277113} {:answer/id #uuid "e436179e-0aae-5046-8432-58d235c36750" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{\\sqrt[3]{{x}^{2}-(y+h)}-\\sqrt[3]{{x}^{2}-y}}{h})" :db/id #edb/ref 17592186277469}] :answer-field/correct {:answer/id #uuid "e436179e-0aae-5046-8432-58d235c36750" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{\\sqrt[3]{{x}^{2}-(y+h)}-\\sqrt[3]{{x}^{2}-y}}{h})" :db/id #edb/ref 17592186277469} :answer-field/id #uuid "8be9e607-3ca8-5c79-b594-28cdaa505ea7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277975}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "53daed36-1f31-5b2b-8966-96a4d35c598d" :question/math-academy-id "q-159594" :question/problem "Given that $f(x,y)=\\sqrt[3]{{x}^{2}-y},$ then $\\frac{∂f}{∂y}=$" :question/worked-solution "The derivative of $f$ with respect to $y$ is given by the limit \n\n$$\n\\frac{∂f}{∂y}={lim}_{h\\to 0}(\\frac{f(x,y+h)-f(x,y)}{h}).\n$$\n\nSince $f(x)=\\sqrt[3]{{x}^{2}-y},$  we have that \n\n$$\nf(x,y+h)=\\sqrt[3]{{x}^{2}-(y+h)}.\n$$\n\nTherefore,\n\n$$\n\\frac{∂f}{∂y}={lim}_{h\\to 0}(\\frac{\\sqrt[3]{{x}^{2}-(y+h)}-\\sqrt[3]{{x}^{2}-y}}{h}).\n$$"} {:db/id #edb/ref 17592186278235 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45268c40-f590-50a8-ba1a-21b858fce141" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186276088} {:answer/id #uuid "6951a819-e923-55cf-bd46-3c7b08d10b89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3-e" :db/id #edb/ref 17592186276422} {:answer/id #uuid "87075966-f8e5-53bf-a25f-6d732f4d7578" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3e" :db/id #edb/ref 17592186276690} {:answer/id #uuid "ab0146c6-98b7-5f6f-8fc2-b635a9e8a5db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186277013} {:answer/id #uuid "c59e102d-a80d-5341-bb04-c1b2868dc317" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+e" :db/id #edb/ref 17592186277235}] :answer-field/correct {:answer/id #uuid "6951a819-e923-55cf-bd46-3c7b08d10b89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3-e" :db/id #edb/ref 17592186276422} :answer-field/id #uuid "b3c719af-bf0c-5f78-a3a9-113baf55c4f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278039}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ff776960-64d0-5d6e-aeb2-a63fd457dce4" :question/math-academy-id "q-159597" :question/problem "For the function $f(x,y)={x}^{3}\\operatorname{ln}⁡y-2y\\sqrt{x},$ evaluate $\\frac{∂f}{∂x}$ at the point $(1,e).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{3}\\operatorname{ln}⁡y-2y\\sqrt{x}) \\\\  & =\\frac{∂}{∂x}({x}^{3}\\operatorname{ln}⁡y)-\\frac{∂}{∂x}(2y\\sqrt{x}) \\\\  & =\\operatorname{ln}⁡y\\cdot \\frac{∂}{∂x}({x}^{3})-2y\\cdot \\frac{∂}{∂x}(\\sqrt{x}) \\\\  & =\\operatorname{ln}⁡y\\cdot (3{x}^{2})-2y\\cdot (\\frac{1}{2\\sqrt{x}}) \\\\  & =3{x}^{2}\\operatorname{ln}⁡y-\\frac{y}{\\sqrt{x}}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(1,e):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(1,e)} & =3\\cdot {1}^{2}\\cdot \\operatorname{ln}⁡e-\\frac{e}{\\sqrt{1}} \\\\  & =3-e\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278236 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32674586-4e3a-5879-b109-f0eb8a8c0450" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}+1" :db/id #edb/ref 17592186275924} {:answer/id #uuid "3bd21982-4f35-584b-905b-d8f52b1c2efd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e+1" :db/id #edb/ref 17592186276001} {:answer/id #uuid "a7c2cdb1-d291-595f-9c08-8200c680205a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e+1" :db/id #edb/ref 17592186276990} {:answer/id #uuid "cfe844ab-c3d2-5244-a7bf-3826f1851815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}e+1" :db/id #edb/ref 17592186277319} {:answer/id #uuid "edeb7583-0cc3-58db-a0ea-b3a8684a62fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186277568}] :answer-field/correct {:answer/id #uuid "3bd21982-4f35-584b-905b-d8f52b1c2efd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e+1" :db/id #edb/ref 17592186276001} :answer-field/id #uuid "64f03706-d8ba-5c00-9d36-3018e3c877be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277905}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4d7d1dc5-2124-525b-9cc9-fe9b2cf1012d" :question/math-academy-id "q-159599" :question/problem "For the function $f(x,y)={e}^{x}\\operatorname{ln}⁡y+{x}^{7}y,$ evaluate $\\frac{∂f}{∂y}$ at the point $(1,\\frac{1}{2}).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}({e}^{x}\\operatorname{ln}⁡y+{x}^{7}y) \\\\  & =\\frac{∂}{∂y}({e}^{x}\\operatorname{ln}⁡y)+\\frac{∂}{∂y}({x}^{7}y) \\\\  & ={e}^{x}\\cdot \\frac{∂}{∂y}(\\operatorname{ln}⁡y)+{x}^{7}\\cdot \\frac{∂}{∂y}(y) \\\\  & ={e}^{x}\\cdot (\\frac{1}{y})+{x}^{7}\\cdot (1) \\\\  & =\\frac{{e}^{x}}{y}+{x}^{7}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(1,\\frac{1}{2}):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(1,1/2)} & =\\frac{{e}^{1}}{(\\frac{1}{2})}+{1}^{7} \\\\  & =2e+1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278238 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0081d662-2a76-5db6-a085-ab046b4fb0d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186275484} {:answer/id #uuid "2307c0e9-79a7-5b71-94fb-81d1846549c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186275789} {:answer/id #uuid "24ba32c9-8d5c-5863-b6a3-b590ddbbf12f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186275808} {:answer/id #uuid "2bdb0760-9291-5b88-884e-ce3f76c09234" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186275876} {:answer/id #uuid "cfdca77f-9773-5630-851d-65b8078cfedf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186277318}] :answer-field/correct {:answer/id #uuid "0081d662-2a76-5db6-a085-ab046b4fb0d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186275484} :answer-field/id #uuid "370efeef-a1d5-51c2-8154-bfdd43bcb49d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277810}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "761131e3-fd5c-5281-9b00-7e9bad552026" :question/math-academy-id "q-159607" :question/problem "For the function $f(x,y)=x\\operatorname{sec}⁡y+{x}^{4}y,$ evaluate ${f}_{y}(\\sqrt{2},\\frac{\\pi }{4}).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}(x\\operatorname{sec}⁡y+{x}^{4}y) \\\\  & =\\frac{∂}{∂y}(x\\operatorname{sec}⁡y)+\\frac{∂}{∂y}({x}^{4}y) \\\\  & =x\\cdot \\frac{∂}{∂y}(\\operatorname{sec}⁡y)+{x}^{4}\\cdot \\frac{∂}{∂y}(y) \\\\  & =x\\cdot (\\operatorname{sec}⁡y\\operatorname{tan}⁡y)+{x}^{4}\\cdot (1) \\\\  & =x\\operatorname{sec}⁡y\\operatorname{tan}⁡y+{x}^{4}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(\\sqrt{2},\\frac{\\pi }{4}):$\n\n$$\n\\begin{aligned}{f}_{y}(\\sqrt{2},\\frac{\\pi }{4}) & =\\sqrt{2}\\cdot \\operatorname{sec}⁡(\\frac{\\pi }{4})\\cdot \\operatorname{tan}⁡(\\frac{\\pi }{4})+{(\\sqrt{2})}^{4} \\\\  & =\\sqrt{2}\\cdot \\sqrt{2}\\cdot 1+4 \\\\  & =6\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278240 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fb6e91c-e353-5113-a18f-0395e4a6e343" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{{y}^{2}}+\\frac{2}{{x}^{3}}" :db/id #edb/ref 17592186276032} {:answer/id #uuid "4118aa52-6cf2-5999-9929-8a5819037289" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{y}+\\frac{2y}{{x}^{3}}" :db/id #edb/ref 17592186276047} {:answer/id #uuid "68a80167-5ca4-5b8a-9c46-29004434201b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{y}+\\frac{2y}{{x}^{3}}" :db/id #edb/ref 17592186276416} {:answer/id #uuid "ebaecd0a-b971-5e92-b62d-28ceae190dc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x}{{y}^{2}}-\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186277539} {:answer/id #uuid "f0a09a6f-356b-5b97-85dc-4fbfa42ac95a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{y}-\\frac{y}{{x}^{2}}" :db/id #edb/ref 17592186277589}] :answer-field/correct {:answer/id #uuid "68a80167-5ca4-5b8a-9c46-29004434201b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{y}+\\frac{2y}{{x}^{3}}" :db/id #edb/ref 17592186276416} :answer-field/id #uuid "e473ea39-99a3-5f5a-9eb6-13ee0b150617" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278125}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "198d06c9-ec80-5c14-815c-c9ec68f7a2d2" :question/math-academy-id "q-159616" :question/problem "Find $\\frac{∂f}{∂x}$ given that $f(x,y)=\\frac{x}{y}-\\frac{y}{{x}^{2}}.$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants.\n\nAdditionally, we use the constant multiple rule for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\frac{x}{y}-\\frac{y}{{x}^{2}}) \\\\  & =\\frac{∂}{∂x}(\\frac{x}{y})-\\frac{∂}{∂x}(\\frac{y}{{x}^{2}}) \\\\  & =\\frac{1}{y}\\cdot \\frac{∂}{∂x}(x)-y\\cdot \\frac{∂}{∂x}(\\frac{1}{{x}^{2}}) \\\\  & =\\frac{1}{y}\\cdot (1)-y\\cdot (-\\frac{2}{{x}^{3}}) \\\\  & =\\frac{1}{y}+\\frac{2y}{{x}^{3}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278245 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28d0f78d-518d-58c8-8c0b-81173c0184aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi +1" :db/id #edb/ref 17592186275847} {:answer/id #uuid "87e360c8-9939-5436-951b-6294befe5b85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi " :db/id #edb/ref 17592186276706} {:answer/id #uuid "b2eb3a7e-c309-596e-bc28-cb1b69bf6690" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi +2" :db/id #edb/ref 17592186277079} {:answer/id #uuid "b5e642e7-633d-5cd9-a804-aa02d2102aa6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi +\\frac{\\pi }{2}" :db/id #edb/ref 17592186277097} {:answer/id #uuid "e08c2618-3181-5d40-a286-0a8436c4dcbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi +2" :db/id #edb/ref 17592186277439}] :answer-field/correct {:answer/id #uuid "e08c2618-3181-5d40-a286-0a8436c4dcbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi +2" :db/id #edb/ref 17592186277439} :answer-field/id #uuid "dde4342f-9533-561d-aa12-ff6ee3bf5a50" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278116}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2942efcf-e503-5d5c-b252-e682ffa52f18" :question/math-academy-id "q-159660" :question/problem "For the function $f(x,y)={x}^{2}{y}^{2}-\\operatorname{cos}⁡(xy),$ evaluate ${f}_{x}(\\frac{\\pi }{4},2).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nFirst, we use the sum rule:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}({x}^{2}{y}^{2}-\\operatorname{cos}⁡(xy)) \\\\  & =\\frac{∂}{∂x}({x}^{2}{y}^{2})-\\frac{∂}{∂x}(\\operatorname{cos}⁡(xy))\\end{aligned}\n$$\n\n \n\nNow, we use the chain and constant multiple rules:\n\n$$\n\\begin{aligned}\\frac{∂}{∂x}({x}^{2}{y}^{2})-\\frac{∂}{∂x}(\\operatorname{cos}⁡(xy)) & =\\frac{∂}{∂x}({x}^{2}{y}^{2})+\\operatorname{sin}⁡(xy)\\cdot \\frac{∂}{∂x}(xy) \\\\  & ={y}^{2}\\cdot \\frac{∂}{∂x}({x}^{2})+\\operatorname{sin}⁡(xy)\\cdot y\\cdot \\frac{∂}{∂x}(x) \\\\  & ={y}^{2}\\cdot (2x)+\\operatorname{sin}⁡(xy)\\cdot y\\cdot (1) \\\\  & =2x{y}^{2}+y\\operatorname{sin}⁡(xy)\\end{aligned}\n$$\n\n \n\nFinally, we evaluate the partial derivative at the point $(\\frac{\\pi }{4},2):$ \n\n$$\n\\begin{aligned}{f}_{x}(\\frac{\\pi }{4},2) & =2\\cdot \\frac{\\pi }{4}\\cdot {2}^{2}+2\\cdot \\operatorname{sin}⁡(\\frac{\\pi }{4}\\cdot 2) \\\\  & =2\\pi +2\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\  & =2\\pi +2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278246 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "124ba60a-ec47-5dd9-97fc-d33ccf7d0e0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186275645} {:answer/id #uuid "5aa03d48-f644-5066-b304-d3fc3f4f62eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\pi " :db/id #edb/ref 17592186276292} {:answer/id #uuid "5c6c70be-1878-50b5-989f-a8ed0e5f587f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186276303} {:answer/id #uuid "a0b747a7-3b88-5c3b-b25b-53403f09d052" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186276925} {:answer/id #uuid "ec320ce3-f38d-5b16-8a80-a7b57185a46a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{2}" :db/id #edb/ref 17592186277549}] :answer-field/correct {:answer/id #uuid "124ba60a-ec47-5dd9-97fc-d33ccf7d0e0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186275645} :answer-field/id #uuid "9d4deb5e-7cf6-55ae-b93a-f09121cdee49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278004}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "95a36042-f58f-5fde-b6a7-7ca45f1d6809" :question/math-academy-id "q-159700" :question/problem "For the function $f(x,y)=\\frac{x+y}{\\operatorname{sin}⁡y},$ evaluate $\\frac{∂f}{∂y}$ at the point $(\\pi ,\\frac{\\pi }{2}).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nFirst, we use the quotient rule:\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(\\frac{x+y}{\\operatorname{sin}⁡y}) & =\\frac{\\frac{∂}{∂y}(x+y)\\cdot \\operatorname{sin}⁡y-(x+y)\\cdot \\frac{∂}{∂y}(\\operatorname{sin}⁡y)}{{sin}^{2}⁡y} \\\\  & =\\frac{1\\cdot \\operatorname{sin}⁡y-(x+y)\\cdot \\operatorname{cos}⁡y}{{sin}^{2}⁡y} \\\\  & =\\frac{\\operatorname{sin}⁡y-(x+y)\\operatorname{cos}⁡y}{{sin}^{2}⁡y}\\end{aligned}\n$$\n\n \n\nFinally, we evaluate the partial derivative at the point $(\\pi ,\\frac{\\pi }{2}):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(\\pi ,\\pi /2)} & =\\frac{\\operatorname{sin}⁡(\\frac{\\pi }{2})-(\\pi +\\frac{\\pi }{2})\\operatorname{cos}⁡(\\frac{\\pi }{2})}{{sin}^{2}⁡(\\frac{\\pi }{2})} \\\\  & =\\frac{1-0}{{1}^{2}} \\\\  & =1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278247 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8543754a-baf7-532f-9aaa-3f6e2f377989" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186276670} {:answer/id #uuid "872098d7-2da8-563d-9dbe-aa0ef1581439" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186276693} {:answer/id #uuid "9f76ba1c-fbca-5e67-ba0f-95af73b7592a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186276912} {:answer/id #uuid "f00a4060-bf7f-5ccd-83cc-feaade45b7ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186277585} {:answer/id #uuid "f0139e5c-4ac7-5bda-a049-12fd07049209" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186277586}] :answer-field/correct {:answer/id #uuid "f00a4060-bf7f-5ccd-83cc-feaade45b7ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186277585} :answer-field/id #uuid "8b4f281e-3538-5167-b8db-a9dda1fcb94e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277972}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8c6d2d99-f435-50ff-85c3-a966d3aa1af6" :question/math-academy-id "q-159709" :question/problem "For the function $f(x,y)=\\frac{x}{y+\\operatorname{sin}⁡x},$ evaluate $\\frac{∂f}{∂x}$ at the point $(0,2).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nFirst, we use the quotient rule:\n\n$$\n\\begin{aligned}\\frac{∂}{∂x}(\\frac{x}{y+\\operatorname{sin}⁡x}) & =\\frac{\\frac{∂}{∂x}(x)\\cdot (y+\\operatorname{sin}⁡x)-x\\cdot \\frac{∂}{∂x}(y+\\operatorname{sin}⁡x)}{(y+\\operatorname{sin}⁡x)^{2}} \\\\  & =\\frac{1\\cdot (y+\\operatorname{sin}⁡x)-x\\cdot \\operatorname{cos}⁡x}{(y+\\operatorname{sin}⁡x)^{2}} \\\\  & =\\frac{y+\\operatorname{sin}⁡x-x\\operatorname{cos}⁡x}{(y+\\operatorname{sin}⁡x)^{2}}\\end{aligned}\n$$\n\n \n\nFinally, we evaluate the partial derivative at the point $(0,2):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(0,2)} & =\\frac{2+\\operatorname{sin}⁡0-0\\operatorname{cos}⁡0}{(2+\\operatorname{sin}⁡0)^{2}} \\\\  & =\\frac{2+0}{(2+0)^{2}} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278248 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a420460-c7c1-505e-8ad4-c9bb108a6ff2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3y" :db/id #edb/ref 17592186275860} {:answer/id #uuid "5f9d3b68-4176-5fa0-9407-0ed4c3eb41a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x" :db/id #edb/ref 17592186276332} {:answer/id #uuid "883a161b-2779-571d-bfa4-409b6a959feb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4y-3x" :db/id #edb/ref 17592186276708} {:answer/id #uuid "b96f1c91-267d-539d-9fa8-52a5e328fc12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+5y" :db/id #edb/ref 17592186277120} {:answer/id #uuid "dfef293c-ea14-5c29-b5c4-17120a6c650d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-y" :db/id #edb/ref 17592186277434}] :answer-field/correct {:answer/id #uuid "b96f1c91-267d-539d-9fa8-52a5e328fc12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+5y" :db/id #edb/ref 17592186277120} :answer-field/id #uuid "af4b38e9-c4a5-5254-be14-837fef119079" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278029}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c75dffc7-c60f-5338-92f4-7c0c6ff2bb72" :question/math-academy-id "q-159713" :question/problem "Consider the function $f(x,y)=\\frac{3x+y}{\\sqrt{x+y}}.$ The partial derivative of $f$ with respect to $x$ is given by\n\n$$\n\\frac{∂f}{∂x}=\\frac{h(x,y)}{2(x+y)\\sqrt{x+y}}.\n$$\n\nFind the function $h(x,y).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nUsing the quotient and chain rules, we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\frac{3x+y}{\\sqrt{x+y}}) \\\\  & =\\frac{\\frac{∂}{∂x}(3x+y)\\cdot \\sqrt{x+y}-(3x+y)\\cdot \\frac{∂}{∂x}(\\sqrt{x+y})}{{(\\sqrt{x+y})}^{2}} \\\\  & =\\frac{(3\\cdot \\sqrt{x+y}-(3x+y)\\cdot \\frac{1}{2\\sqrt{x+y}}\\cdot \\frac{∂}{∂x}(x+y))}{{(\\sqrt{x+y})}^{2}} \\\\  & =\\frac{(3\\cdot \\sqrt{x+y}-(3x+y)\\cdot \\frac{1}{2\\sqrt{x+y}}\\cdot 1)}{{(\\sqrt{x+y})}^{2}} \\\\  & =\\frac{(\\frac{6(x+y)-(3x+y)}{2\\sqrt{x+y}})}{x+y} \\\\  & =\\frac{3x+5y}{2(x+y)\\sqrt{x+y}}\\end{aligned}\n$$\n\n \n\nTherefore, we conclude that\n\n$$\nh(x,y)=3x+5y.\n$$"} {:db/id #edb/ref 17592186278249 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1071740e-9558-5e73-b52c-d383864bf497" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-y" :db/id #edb/ref 17592186275622} {:answer/id #uuid "9e058e90-be98-5313-a164-e37b5eaec24f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-x{y}^{2}" :db/id #edb/ref 17592186276896} {:answer/id #uuid "b028380b-a597-535a-bd93-8b4c6734b700" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-xy" :db/id #edb/ref 17592186277053} {:answer/id #uuid "bb6cb830-da03-564b-9a88-50ef70b7374f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3+{x}^{2}y" :db/id #edb/ref 17592186277142} {:answer/id #uuid "e1d0d589-d5cc-550b-974e-b4afdfaebb22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+xy" :db/id #edb/ref 17592186277451}] :answer-field/correct {:answer/id #uuid "9e058e90-be98-5313-a164-e37b5eaec24f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-x{y}^{2}" :db/id #edb/ref 17592186276896} :answer-field/id #uuid "75024153-b4e7-530d-be37-6a2d7adf8ab7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277934}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ad571fe8-149e-54b6-a89f-66ae79db7481" :question/math-academy-id "q-159714" :question/problem "Consider the function $f(x,y)=\\frac{2x{y}^{2}-1}{{x}^{2}y}.$ The partial derivative of $f$ with respect to $x$ is given by\n\n$$\n\\frac{∂f}{∂x}=\\frac{2h(x,y)}{{x}^{3}y}.\n$$\n\nFind the function $h(x,y).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nUsing the quotient rule, we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\frac{2x{y}^{2}-1}{{x}^{2}y}) \\\\  & =\\frac{\\frac{∂}{∂x}(2x{y}^{2}-1)\\cdot {x}^{2}y-(2x{y}^{2}-1)\\cdot \\frac{∂}{∂x}({x}^{2}y)}{({x}^{2}y)^{2}} \\\\  & =\\frac{2{y}^{2}\\cdot {x}^{2}y-(2x{y}^{2}-1)\\cdot 2xy}{{x}^{4}{y}^{2}} \\\\  & =\\frac{2{x}^{2}{y}^{3}-4{x}^{2}{y}^{3}+2xy}{{x}^{4}{y}^{2}} \\\\  & =\\frac{2xy-2{x}^{2}{y}^{3}}{{x}^{4}{y}^{2}} \\\\  & =\\frac{2xy(1-x{y}^{2})}{{x}^{4}{y}^{2}} \\\\  & =\\frac{2(1-x{y}^{2})}{{x}^{3}y}\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\nh(x,y)=1-x{y}^{2}.\n$$"} {:db/id #edb/ref 17592186278251 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69e44334-00de-5702-83e5-16a7570d043c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(2x+y)" :db/id #edb/ref 17592186276427} {:answer/id #uuid "8aac973e-8257-545d-b095-ab149936e003" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3+{x}^{2}{y}^{2}" :db/id #edb/ref 17592186276733} {:answer/id #uuid "b7cf2fa9-6053-5c4d-852e-474c37939e76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2xy(1-y)" :db/id #edb/ref 17592186277108} {:answer/id #uuid "dd338f07-9cf2-51fd-a11c-32c271645616" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2xy(1+x)" :db/id #edb/ref 17592186277414} {:answer/id #uuid "f9b315c7-d154-5db9-8a29-731dc66826e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-x{y}^{2}" :db/id #edb/ref 17592186277662}] :answer-field/correct {:answer/id #uuid "dd338f07-9cf2-51fd-a11c-32c271645616" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2xy(1+x)" :db/id #edb/ref 17592186277414} :answer-field/id #uuid "4c3c66f0-c7ef-59da-9462-dd34d39d1caf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277846}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "485c686b-8a53-5bf0-8bc4-72a915a1ba56" :question/math-academy-id "q-159723" :question/problem "Consider the function $f(x,y)=\\frac{{x}^{2}+{y}^{2}}{x-{y}^{2}}.$ The partial derivative of $f$ with respect to $y$ is given by\n\n$$\n\\frac{∂f}{∂y}=\\frac{h(x,y)}{{(x-{y}^{2})}^{2}}.\n$$\n\nFind the function $h(x,y).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nUsing the quotient rule, we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(\\frac{{x}^{2}+{y}^{2}}{x-{y}^{2}}) \\\\  & =\\frac{\\frac{∂}{∂y}({x}^{2}+{y}^{2})\\cdot (x-{y}^{2})-({x}^{2}+{y}^{2})\\cdot \\frac{∂}{∂y}(x-{y}^{2})}{{(x-{y}^{2})}^{2}} \\\\  & =\\frac{2y\\cdot (x-{y}^{2})-({x}^{2}+{y}^{2})\\cdot (-2y)}{{(x-{y}^{2})}^{2}} \\\\  & =\\frac{2xy-2{y}^{3}+2{x}^{2}y+2{y}^{3}}{{(x-{y}^{2})}^{2}} \\\\  & =\\frac{2xy+2{x}^{2}y}{{(x-{y}^{2})}^{2}} \\\\  & =\\frac{2xy(1+x)}{{(x-{y}^{2})}^{2}}\\end{aligned}\n$$\n\n \n\nTherefore, we conclude that\n\n$$\nh(x,y)=2xy(1+x).\n$$"} {:db/id #edb/ref 17592186278288 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27184dd5-9306-5151-ba71-71c0184555b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186275833} {:answer/id #uuid "921684d8-1a85-53da-b8a7-23bd356d4d8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186276799} {:answer/id #uuid "a6b6ecd9-7efa-5fbf-99f4-87cf3cf2fc2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186276980} {:answer/id #uuid "a9f4d180-9148-56f8-af89-c87393729376" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186277007} {:answer/id #uuid "bc4ef6cf-c02f-531a-934f-84c5afac9290" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186277153}] :answer-field/correct {:answer/id #uuid "921684d8-1a85-53da-b8a7-23bd356d4d8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186276799} :answer-field/id #uuid "3f823688-c59b-5a64-9e51-9b7c368087e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277821}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2b1f8f7b-fd82-5c84-a276-7fa2fd9b071a" :question/math-academy-id "q-160383" :question/problem "For the transformation $T,$ defined as \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}uv \\\\ \\frac{v}{u}\\end{bmatrix}\n$$\n\n \n\ncompute the value of the Jacobian determinant at the point where $\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix}.$" :question/worked-solution "Given a transformation \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix},\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix}.\\end{aligned}\n$$\n\nHere, we have $x=uv$ and $y=\\frac{v}{u}.$ \n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =v & \\,\\frac{∂x}{∂v} & =u \\\\ \\frac{∂y}{∂u} & =-\\frac{v}{{u}^{2}} & \\,\\frac{∂y}{∂v} & =\\frac{1}{u}\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\  & =\\begin{vmatrix}v & u \\\\ -\\frac{v}{{u}^{2}}\\, & \\frac{1}{u}\\end{vmatrix} \\\\  & =v\\cdot \\frac{1}{u}\\text{ }-u\\cdot (-\\frac{v}{{u}^{2}}) \\\\  & =\\frac{2v}{u}.\\end{aligned}\n$$\n\nFinally, when $\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix},$ the value of our Jacobian determinant is\n\n$$\n{\\frac{∂(x,y)}{∂(u,v)}|}_{(-2,3)}=\\frac{2(3)}{-2}=-3.\n$$"} {:db/id #edb/ref 17592186278291 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b2ac211-6ede-500a-9363-0c90ed1326ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186275729} {:answer/id #uuid "241de261-1031-55ca-a058-00911568c512" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186275796} {:answer/id #uuid "54f35b13-d77e-5a66-b2b8-4f7e13bf0284" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186276233} {:answer/id #uuid "b3da8c48-0f97-556c-90bd-47b71461d13c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186277086} {:answer/id #uuid "c49fcad0-5cc2-5449-8be5-a58c6c177d96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186277224}] :answer-field/correct {:answer/id #uuid "1b2ac211-6ede-500a-9363-0c90ed1326ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186275729} :answer-field/id #uuid "795a7cef-1005-511a-9200-2ed1ac91ad82" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277938}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2443aa6d-e746-5170-93b3-e30684a9a33b" :question/math-academy-id "q-160402" :question/problem "For the transformation $T,$ defined as\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}{e}^{u-v} \\\\ \\operatorname{ln}⁡(uv)\\end{bmatrix}.\n$$\n\ncompute the value of the Jacobian determinant at the point where $\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.$" :question/worked-solution "Given a transformation \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix},\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix}.\\end{aligned}\n$$\n\nHere, we have $x(u,v)={e}^{u-v}$ and $y(u,v)=\\operatorname{ln}⁡(uv).$  \n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & ={e}^{u-v} & \\,\\frac{∂x}{∂v} & =-{e}^{u-v} \\\\ \\frac{∂y}{∂u} & =\\frac{1}{u} & \\,\\frac{∂y}{∂v} & =\\frac{1}{v}\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\  & =\\begin{vmatrix}{e}^{u-v} & -{e}^{u-v} \\\\ \\frac{1}{u} & \\frac{1}{v}\\end{vmatrix} \\\\  & ={e}^{u-v}\\cdot (\\frac{1}{v})-(-{e}^{u-v})\\cdot \\frac{1}{u} \\\\  & =\\frac{{e}^{u-v}}{v}+\\frac{{e}^{u-v}}{u}.\\end{aligned}\n$$\n\nFinally, when $\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix},$ the value of our Jacobian determinant is\n\n$$\n{\\frac{∂(x,y)}{∂(u,v)}|}_{(1,1)}=\\frac{{e}^{(1)-(1)}}{(1)}+\\frac{{e}^{(1)-(1)}}{(1)}=2.\n$$"} {:db/id #edb/ref 17592186278292 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c4a3210-10ef-5b25-901e-ab593d9722a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186275737} {:answer/id #uuid "97420ee7-fdf5-5150-958a-35de289cfc75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{u+v}" :db/id #edb/ref 17592186276836} {:answer/id #uuid "e66d3a94-2dd5-54c7-b4bb-4f280703014c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186277489} {:answer/id #uuid "fd4e4f14-3265-58a7-acfe-48a134dd8de1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{u+v}(u-v)}{vu}" :db/id #edb/ref 17592186277697} {:answer/id #uuid "fd6c8ca7-ffb6-520e-b5af-e3963f09a153" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{u+v}}{vu}" :db/id #edb/ref 17592186277699}] :answer-field/correct {:answer/id #uuid "fd4e4f14-3265-58a7-acfe-48a134dd8de1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{u+v}(u-v)}{vu}" :db/id #edb/ref 17592186277697} :answer-field/id #uuid "beae5e95-9df5-5eed-ba44-7362dc1d3cb1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278063}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9c12a73a-3560-5ca0-8c93-5fcc98faad4d" :question/math-academy-id "q-160403" :question/problem "Find the Jacobian determinant of the transformation $T(\\begin{bmatrix}u \\\\ v\\end{bmatrix})=\\begin{bmatrix}{e}^{u+v} \\\\ \\operatorname{ln}⁡(uv)\\end{bmatrix}.$" :question/worked-solution "Given a transformation \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix},\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix}.\\end{aligned}\n$$\n\nHere, we have $x(u,v)={e}^{u+v}$ and $y(u,v)=\\operatorname{ln}⁡(uv).$  \n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & ={e}^{u+v} & \\,\\frac{∂x}{∂v} & ={e}^{u+v} \\\\ \\frac{∂y}{∂u} & =\\frac{1}{u} & \\,\\frac{∂y}{∂v} & =\\frac{1}{v}\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\  & =\\begin{vmatrix}{e}^{u+v} & {e}^{u+v} \\\\ \\frac{1}{u} & \\frac{1}{v}\\end{vmatrix} \\\\  & ={e}^{u+v}\\cdot (\\frac{1}{v})-{e}^{u+v}\\cdot (\\frac{1}{u}) \\\\  & =\\frac{{e}^{u+v}}{v}-\\frac{{e}^{u+v}}{u} \\\\  & =\\frac{{e}^{u+v}(u-v)}{vu}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278294 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10fbd1fd-81d6-5ab9-9a42-0df9f96eda22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465285} {:answer/id #uuid "1395580a-0ad4-5646-9291-c0acb3fea193" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465286}] :answer-field/correct {:answer/id #uuid "10fbd1fd-81d6-5ab9-9a42-0df9f96eda22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465285} :answer-field/id #uuid "84ac4b21-d3c8-5ac0-b070-d7d504bcc850" :answer-field/key "$y=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466486} {:answer-field/choices [{:answer/id #uuid "ccfd9b16-57d1-5331-8023-5fa2705b3253" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465287} {:answer/id #uuid "047f3772-89f4-5fce-a998-333acb699eb9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465288}] :answer-field/correct {:answer/id #uuid "ccfd9b16-57d1-5331-8023-5fa2705b3253" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465287} :answer-field/id #uuid "7b2cdc27-e594-5f5c-81a3-b5b4ae2af15d" :answer-field/key "$y=\\frac{\\pi }{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466487} {:answer-field/choices [{:answer/id #uuid "e1f86228-76ce-5ad6-8dba-2e38cc396dd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465289} {:answer/id #uuid "f3293a37-b3c5-57c9-8cd2-7bebc9961197" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465290}] :answer-field/correct {:answer/id #uuid "f3293a37-b3c5-57c9-8cd2-7bebc9961197" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465290} :answer-field/id #uuid "bf6eadc1-e12f-5563-a5fe-c1f034620e4e" :answer-field/key "$y=\\pi $" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466488}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c7b0ec58-a026-543f-8622-101c6f9cdc96" :question/math-academy-id "q-160419" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}t}+y=\\operatorname{sin}⁡y+\\pi .$ Which of the following is an equilibrium solution of this equation?\n\nSelect all that apply." :question/worked-solution "Given an autonomous differential equation ${y}^{′}(t)=f(y),$ if there exists a constant $c$ such that $f(c)=0,$ then $y=c$ is an equilibrium solution of the equation.\n\nFirst, we write the given equation as\n\n$$\n\\frac{\\text{d}y}{\\text{d}t}=\\operatorname{sin}⁡y-y+\\pi ,\n$$\n\nand we get that $f(y)=\\operatorname{sin}⁡y-y+\\pi .$\n\nNow, let's check each proposed solution by substituting them into $f(y).$\n\n- $y=0$ is *not* an equilibrium point. We have $f(0)=\\operatorname{sin}⁡(0)-0+\\pi =\\pi \\ne 0.$ $\\,\\times $\n\n- $y=\\frac{\\pi }{2}$ is *not* an equilibrium point. We have $f(\\frac{\\pi }{2})=\\operatorname{sin}⁡(\\frac{\\pi }{2})-\\frac{\\pi }{2}+\\pi =1+\\frac{\\pi }{2}\\ne 0.$ $\\,\\times $\n\n- $y=\\pi $ is an equilibrium point. We have $f(\\pi )=\\operatorname{sin}⁡(\\pi )-\\pi +\\pi =0-\\pi +\\pi =0.$$\\,✓$\n\nTherefore, the correct answer is $y=\\pi $ only."} {:db/id #edb/ref 17592186278300 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "201b5adb-fe9e-56a4-a103-cfa7fd40fca9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186275775} {:answer/id #uuid "6b7b2609-013a-5fdd-ad02-4411dd975fa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186276441} {:answer/id #uuid "7c015757-c6cd-5661-8772-840f2ddff2cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186276607} {:answer/id #uuid "803b5ba9-187d-5e4c-a266-d33068d508bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186276640} {:answer/id #uuid "af79779a-7d08-51aa-a7a1-413703ca604d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186277048}] :answer-field/correct {:answer/id #uuid "af79779a-7d08-51aa-a7a1-413703ca604d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186277048} :answer-field/id #uuid "ed0e005f-2ede-5db6-90a3-c44e813e721d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278140}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4f68c62f-9f11-5647-83b4-1238f13388b9" :question/math-academy-id "q-160440" :question/problem "For the transformation $T,$ defined as\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}\\operatorname{cos}⁡u \\\\ \\operatorname{sin}⁡v\\end{bmatrix}\n$$\n\ncompute the value of the Jacobian determinant at the point where $\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}\\pi /6 \\\\ 0\\end{bmatrix}.$" :question/worked-solution "Given a transformation \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix},\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix}.\\end{aligned}\n$$\n\nHere, we have $x(u,v)=\\operatorname{cos}⁡u$ and $y(u,v)=\\operatorname{sin}⁡v.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =-\\operatorname{sin}⁡u & \\,\\frac{∂x}{∂v} & =0 \\\\ \\frac{∂y}{∂u} & =0 & \\,\\frac{∂y}{∂v} & =\\operatorname{cos}⁡v\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-\\operatorname{sin}⁡u & 0 \\\\ 0 & \\operatorname{cos}⁡v\\end{vmatrix} \\\\  & =(-\\operatorname{sin}⁡u)\\cdot \\operatorname{cos}⁡v-0\\cdot 0 \\\\  & =-\\operatorname{sin}⁡u\\operatorname{cos}⁡v.\\end{aligned}\n$$\n\nFinally, when $\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}\\pi /6 \\\\ 0\\end{bmatrix},$ the value of our Jacobian determinant is\n\n$$\n{\\frac{∂(x,y)}{∂(u,v)}|}_{(\\frac{\\pi }{6},0)}=-\\operatorname{sin}⁡(\\frac{\\pi }{6})\\operatorname{cos}⁡(0)=-\\frac{1}{2}.\n$$"} {:db/id #edb/ref 17592186278312 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e8316c3-945b-5d09-a275-e0c583f57a17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186275895} {:answer/id #uuid "d0b7c50f-b475-5cd3-a478-644d87193dc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186277324} {:answer/id #uuid "dbb6f0a5-bfd6-5a0f-aea6-85ae01e06079" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{8}" :db/id #edb/ref 17592186277401} {:answer/id #uuid "e1fd723e-649c-5294-ae81-2a842e9e6b1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186277455} {:answer/id #uuid "e3ad5de4-55a8-578b-8fc5-a8a2b67c0b42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}" :db/id #edb/ref 17592186277465}] :answer-field/correct {:answer/id #uuid "e3ad5de4-55a8-578b-8fc5-a8a2b67c0b42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}" :db/id #edb/ref 17592186277465} :answer-field/id #uuid "0c2b48aa-f3d5-54e7-9a9a-986efee1cf0f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277748}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1615e71e-cacf-55f4-8706-f141063daf67" :question/math-academy-id "q-160479" :question/problem "Consider the transformation $T:(u,v)\\to (x(u,v),y(u,v)).$ The inverse transformation ${T}^{-1}(x,y)\\to (u(x,y),v(x,y))$ is given by\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}x-2y \\\\ 3x+4y\\end{bmatrix}.\n$$\n\nFind the Jacobian determinant of $T.$" :question/worked-solution "Given a transformation \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix},\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix}.\\end{aligned}\n$$\n\nIn this case, we're only given ${T}^{-1}.$ So, we compute the Jacobian determinant of $T$ as follows:\n\n- First, we compute $\\frac{∂(u,v)}{∂(x,y)},$ the Jacobian determinant of ${T}^{-1}.$\n\n- Then, we will compute the Jacobian determinant of $T$ using the relation\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}.\n$$\n\nHere, we have $u(x,y)=x-2y$ and $v(x,y)=3x+4y.$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂u}{∂x} & =1 & \\,\\frac{∂u}{∂y} & =-2 \\\\ \\frac{∂v}{∂x} & =3 & \\,\\frac{∂v}{∂y} & =4\\end{aligned}\n$$\n\nTherefore, the Jacobian determinant of ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & -2 \\\\ 3 & 4\\end{vmatrix} \\\\  & =1\\cdot 4-(-2)\\cdot 3 \\\\  & =10.\\end{aligned}\n$$\n\nFinally, we take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & ={(\\frac{∂(u,v)}{∂(x,y)})}^{-1} \\\\  & =\\frac{1}{10}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278313 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15f34e11-6208-5bd6-83d3-fb8f70484d52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186275683} {:answer/id #uuid "4ed05521-a389-5e3e-8ad1-0d982b3149dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186276180} {:answer/id #uuid "5eff542f-2be2-5e3f-97b9-5d179c03100d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186276327} {:answer/id #uuid "85bc8a32-6d26-5cda-87d2-f7f9c4c17889" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186276676} {:answer/id #uuid "ed4db293-b0be-5e3d-a7a4-81722a810570" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186277560}] :answer-field/correct {:answer/id #uuid "4ed05521-a389-5e3e-8ad1-0d982b3149dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186276180} :answer-field/id #uuid "46fd785d-27e6-529a-8718-6d1dcb72fc65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277838}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c6f65d80-7792-570e-9406-106101c7a70c" :question/math-academy-id "q-160563" :question/problem "Consider the transformation $T:(u,v)\\to (x(u,v),y(u,v)).$ The inverse transformation ${T}^{-1}(x,y)\\to (u(x,y),v(x,y))$ is given by\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}2x-6y \\\\ x+3y\\end{bmatrix}.\n$$\n\nFind the Jacobian determinant of $T.$" :question/worked-solution "Given a transformation \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix},\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix}.\\end{aligned}\n$$\n\nIn this case, we're only given ${T}^{-1}.$ So, we compute the Jacobian determinant of $T$ as follows:\n\n- First, we compute $\\frac{∂(u,v)}{∂(x,y)},$ the Jacobian determinant of ${T}^{-1}.$\n\n- Then, we will compute the Jacobian determinant of $T$ using the relation\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}.\n$$\n\nHere, we have $u(x,y)=2x+-y$ and $v(x,y)=x+3y.$ \n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂u}{∂x} & =2 & \\,\\frac{∂u}{∂y} & =-6 \\\\ \\frac{∂v}{∂x} & =1 & \\,\\frac{∂v}{∂y} & =3\\end{aligned}\n$$\n\nTherefore, the Jacobian determinant of ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & -6 \\\\ 1 & 3\\end{vmatrix} \\\\  & =2\\cdot 3-(-6)\\cdot 1 \\\\  & =12.\\end{aligned}\n$$\n\nFinally, we take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & ={(\\frac{∂(u,v)}{∂(x,y)})}^{-1} \\\\  & =\\frac{1}{12}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278314 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b7b11e3-ec58-5e4e-af9c-4b27fe57afa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186275572} {:answer/id #uuid "1b48c506-a496-56c6-9f38-211be2533d9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186275730} {:answer/id #uuid "877b2e30-bb6d-567a-a22b-1e9d08ebe6b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186276699} {:answer/id #uuid "c92b975d-bcee-5cb4-8f7c-c5b62dcd4759" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186277263} {:answer/id #uuid "d27bbf8b-f7d8-58e5-a38d-897bd7f54bb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{10}" :db/id #edb/ref 17592186277335}] :answer-field/correct {:answer/id #uuid "d27bbf8b-f7d8-58e5-a38d-897bd7f54bb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{10}" :db/id #edb/ref 17592186277335} :answer-field/id #uuid "9b872a64-713f-5527-a8d1-f8a1304b926e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278002}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ed8207bc-4d78-5a97-b503-5177675ffb34" :question/math-academy-id "q-160581" :question/problem "Consider the transformation $T:(u,v)\\to (x(u,v),y(u,v)).$ The inverse transformation ${T}^{-1}(x,y)\\to (u(x,y),v(x,y))$ is given by\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}-x+7y \\\\ x+3y\\end{bmatrix}.\n$$\n\nFind the Jacobian determinant of $T.$" :question/worked-solution "Given a transformation \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix},\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix}.\\end{aligned}\n$$\n\nIn this case, we're only given ${T}^{-1}.$ So, we compute the Jacobian determinant of $T$ as follows:\n\n- First, we compute $\\frac{∂(u,v)}{∂(x,y)},$ the Jacobian determinant of ${T}^{-1}.$\n\n- Then, we will compute the Jacobian determinant of $T$ using the relation\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}.\n$$\n\nHere, we have $u(x,y)=-x+7y$ and $v(x,y)=3x-y.$ \n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂u}{∂x} & =-1 & \\,\\frac{∂u}{∂y} & =7 \\\\ \\frac{∂v}{∂x} & =1 & \\,\\frac{∂v}{∂y} & =3\\end{aligned}\n$$\n\nTherefore, the Jacobian determinant of ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-1 & 7 \\\\ 1 & 3\\end{vmatrix} \\\\  & =(-1)\\cdot 3-7\\cdot 1 \\\\  & =-10.\\end{aligned}\n$$\n\n \n\nFinally, we take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & ={(\\frac{∂(u,v)}{∂(x,y)})}^{-1} \\\\  & =-\\frac{1}{10}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278315 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4969b933-9252-5d6c-99a3-2d0800a47ff5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{u}{v}" :db/id #edb/ref 17592186276127} {:answer/id #uuid "770127d5-5c20-5966-b228-70cc5f941617" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{v}" :db/id #edb/ref 17592186276551} {:answer/id #uuid "b84e8d31-b0f2-5bc7-b250-aae11f693050" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2uv}" :db/id #edb/ref 17592186277111} {:answer/id #uuid "c7cce8a1-986b-5e0d-9d7a-5c50318cedd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4v" :db/id #edb/ref 17592186277250} {:answer/id #uuid "d9290ebb-9e9d-5d8a-8ec2-a3ee34d8fd40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{v}{u}" :db/id #edb/ref 17592186277385}] :answer-field/correct {:answer/id #uuid "b84e8d31-b0f2-5bc7-b250-aae11f693050" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2uv}" :db/id #edb/ref 17592186277111} :answer-field/id #uuid "94528d39-40c7-5d22-bbd3-10b2d8db0c92" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277987}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1077730f-94dd-5875-b9c2-642bfe60bb08" :question/math-academy-id "q-160582" :question/problem "Consider all non-critical points of the transformation $T:(u,v)\\to (x(u,v),y(u,v)).$ The inverse transformation ${T}^{-1}(x,y)\\to (u(x,y),v(x,y))$ is given by\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}{e}^{xy} \\\\ \\frac{y}{x}\\end{bmatrix}.\n$$\n\nFind the Jacobian determinant of $T$ in terms of $u$ and $v.$" :question/worked-solution "Given a transformation \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix},\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix}.\\end{aligned}\n$$\n\nIn this case, we're only given ${T}^{-1}.$ So, we compute the Jacobian determinant of $T$ as follows:\n\n- First, we compute $\\frac{∂(u,v)}{∂(x,y)},$ the Jacobian determinant of ${T}^{-1}.$\n\n- Then, we will compute the Jacobian determinant of $T$ using the relation\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}.\n$$\n\nHere, we have $u(x,y)={e}^{xy}$ and $v(x,y)=\\frac{y}{x}.$ \n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂u}{∂x} & =y{e}^{xy} & \\,\\frac{∂u}{∂y} & =x{e}^{xy} \\\\ \\frac{∂v}{∂x} & =-\\frac{y}{{x}^{2}} & \\,\\frac{∂v}{∂y} & =\\frac{1}{x}\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}y{e}^{xy} & x{e}^{xy} \\\\ -\\frac{y}{{x}^{2}} & \\frac{1}{x}\\end{vmatrix} \\\\  & =y{e}^{xy}\\cdot \\frac{1}{x}-x{e}^{xy}\\cdot (-\\frac{y}{{x}^{2}}) \\\\  & =\\frac{2y{e}^{xy}}{x} \\\\  & =2\\cdot {e}^{xy}\\cdot \\frac{y}{x} \\\\  & =2uv.\\end{aligned}\n$$\n\n \n\nFinally, we take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & ={(\\frac{∂(u,v)}{∂(x,y)})}^{-1} \\\\  & =\\frac{1}{2uv}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278316 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2141fe03-5609-506c-ae00-264723dbff1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{v}" :db/id #edb/ref 17592186275778} {:answer/id #uuid "60c950bb-e6b5-566d-a83e-c5ddb2dd1bf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2u" :db/id #edb/ref 17592186276346} {:answer/id #uuid "90a0356c-7c2b-5475-809e-f584e2ea2afa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2u}" :db/id #edb/ref 17592186276788} {:answer/id #uuid "9e509876-60c7-502b-a36b-eb375b31d6f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2uv" :db/id #edb/ref 17592186276900} {:answer/id #uuid "c0e144d9-a262-5093-84e5-e89abb2f6f04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2v}" :db/id #edb/ref 17592186277192}] :answer-field/correct {:answer/id #uuid "c0e144d9-a262-5093-84e5-e89abb2f6f04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2v}" :db/id #edb/ref 17592186277192} :answer-field/id #uuid "e88fdffa-ff8d-5cae-a661-8b8827ff078f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278133}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bcef19dc-e0d9-5a18-86b4-519865d6c64e" :question/math-academy-id "q-160599" :question/problem "Consider all non-critical points of the transformation $T:(u,v)\\to (x(u,v),y(u,v)).$ The inverse transformation ${T}^{-1}(x,y)\\to (u(x,y),v(x,y))$ is given by\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}xy \\\\ \\frac{x}{y}\\end{bmatrix}.\n$$\n\nFind the Jacobian determinant of $T$ in terms of $u$ and $v.$" :question/worked-solution "Given a transformation \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix},\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix}.\\end{aligned}\n$$\n\nIn this case, we're only given ${T}^{-1}.$ So, we compute the Jacobian determinant of $T$ as follows:\n\n- First, we compute $\\frac{∂(u,v)}{∂(x,y)},$ the Jacobian determinant of ${T}^{-1}.$\n\n- Then, we will compute the Jacobian determinant of $T$ using the relation\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}.\n$$\n\n \nHere, we have $u(x,y)=xy$ and $v(x,y)=\\frac{x}{y}.$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂u}{∂x} & =y & \\,\\frac{∂u}{∂y} & =x \\\\ \\frac{∂v}{∂x} & =\\frac{1}{y} & \\,\\frac{∂v}{∂y} & =-\\frac{x}{{y}^{2}}\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}y & x \\\\ \\frac{1}{y} & -\\frac{x}{{y}^{2}}\\end{vmatrix} \\\\  & =y\\cdot (-\\frac{x}{{y}^{2}})-x\\cdot \\frac{1}{y} \\\\  & =-\\frac{2x}{y} \\\\  & =-2v.\\end{aligned}\n$$\n\nFinally, we take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & ={(\\frac{∂(u,v)}{∂(x,y)})}^{-1} \\\\  & =-\\frac{1}{2v}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278319 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c7985e0-0857-5804-a91d-6874ee7f39a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An arc of a right-opening parabola, traversed from $(0,0)$ to $(1,2).$" :db/id #edb/ref 17592186275582} {:answer/id #uuid "34415490-023d-5c18-bba7-038451023e67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An arc of an upward-opening parabola, traversed from $(2,1)$ to $(1,0).$" :db/id #edb/ref 17592186275941} {:answer/id #uuid "6e076705-7458-5ed0-8526-2a222bbe61f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An arc of an upward-opening parabola, traversed from $(0,0)$ to $(1,2).$" :db/id #edb/ref 17592186276461} {:answer/id #uuid "d588ca3a-96a4-544f-90a5-ba156834c738" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An arc of a right-opening parabola, traversed from $(1,2)$ to $(0,0).$" :db/id #edb/ref 17592186277358} {:answer/id #uuid "f885127e-36b3-5abe-b21f-1dd3b715c6b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An arc of an upward-opening parabola, traversed from  $(1,0)$ to $(2,1).$" :db/id #edb/ref 17592186277650}] :answer-field/correct {:answer/id #uuid "0c7985e0-0857-5804-a91d-6874ee7f39a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An arc of a right-opening parabola, traversed from $(0,0)$ to $(1,2).$" :db/id #edb/ref 17592186275582} :answer-field/id #uuid "eefec963-55e6-5c35-9531-076352440923" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278147}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "235488a1-420f-5270-8713-f985503b0b2d" :question/math-academy-id "q-160607" :question/problem "![](images/33/33e48fa5bdbb034bcf489e038ccf80fc5f67baabeccacc1b7abd741183ebf05d.png)\n\nConsider the square region $Δ$ in the $uv$-plane, given by\n\n$$\nΔ={(u,v)\\,:\\,0\\le u\\le 1,\\,0\\le v\\le 1},\n$$\n\nand the transformation $T,$ given by\n\n$$\nT:(u,v)\\to (x(u,v),y(u,v)),\n$$\n\nwhere \n\n$$\nx=u(u+v),\\,y=\\frac{2u}{v+1}.\n$$\n\nWhich of the following is the image of the side ${S}_{1}$ under the action of $T?$" :question/worked-solution "To map the entire region $Δ$ onto the $xy$-plane, we consider the transformation of each side. However, in this case, we consider only the side ${S}_{1}.$\n\nFor the side ${S}_{1},$ we have $v=0$ and $0\\le u\\le 1.$ Substituting $v=0$ into our transformation equations, we obtain \n\n$$\n\\begin{aligned}(x,y) & =T(u,v) \\\\  & =(u(u+v),\\,\\frac{2u}{v+1}) \\\\  & =(u(u+0),\\,\\frac{2u}{0+1}) \\\\  & =({u}^{2},\\,2u).\\end{aligned}\n$$\n\nSo, the image of ${S}_{1}$ can be parametrized by\n\n$$\nx={u}^{2},\\,y=2u,\\,0\\le u\\le 1.\n$$\n\n \n\nWriting this in the usual notation, we have\n\n$$\nx(t)={t}^{2},\\,y(t)=2t,\\,0\\le t\\le 1.\n$$\n\nThese are parametric equations of a parabolic arc. Notice that if we eliminate $t$ from the equations, we get\n\n$$\nx={(\\frac{y}{2})}^{2}\\,⇒\\,{y}^{2}=4x\n$$\n\nwhich is a right-opening parabola whose vertex is at $(0,0).$\n\nMoreover, the endpoints of ${S}_{1}$ are mapped to the $xy$-plane as follows:\n\n$$\n\\begin{aligned} & T:(0,0)\\to (0(0+0),\\,\\frac{2(0)}{0+1})=(0,0) \\\\  & T:(1,0)\\to (1(1+0),\\,\\frac{2(1)}{0+1})=(1,2)\\end{aligned}\n$$\n\nTherefore, the image of ${S}_{1}$ is an arc of a right-opening parabola, traversed from $(0,0)$ to $(1,2).$\n\n![](images/4f/4fc3c209e83fc1d6b4c9258cdb739fb0a73db797791cf8fcca2e51a7592d54f8.png)"} {:db/id #edb/ref 17592186278334 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "017818b3-7eb5-5983-b993-b94ed7bc4f60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i+j+k" :db/id #edb/ref 17592186275487} {:answer/id #uuid "0baeaf9e-f5d2-51a6-9bd4-e6ff547469a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i-j+k" :db/id #edb/ref 17592186275573} {:answer/id #uuid "57b95886-7b45-5b76-b146-573d86c52385" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-i-j-k" :db/id #edb/ref 17592186276262} {:answer/id #uuid "7535ebcf-b155-5788-a9e1-0ed34ae0f4eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-i-j+k" :db/id #edb/ref 17592186276539} {:answer/id #uuid "eba0b132-4904-5bf2-8beb-830155e49f3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i+j-k" :db/id #edb/ref 17592186277537}] :answer-field/correct {:answer/id #uuid "eba0b132-4904-5bf2-8beb-830155e49f3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i+j-k" :db/id #edb/ref 17592186277537} :answer-field/id #uuid "453f511c-3883-5354-9c37-af56c3a1aaec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277833}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7b01d56e-0cd6-5466-b9de-28d868176a07" :question/math-academy-id "q-160769" :question/problem "What is the value of \n $f(s)=\\operatorname{tan}⁡s\\,i+\\operatorname{cot}⁡s\\,j-\\,k$ at $s=\\frac{\\pi }{4}?$" :question/worked-solution "To evaluate, we substitute at $s=\\frac{\\pi }{4}$  into the function, as follows:\n\n$$\n\\begin{aligned}f(\\frac{\\pi }{4}) & =\\operatorname{tan}⁡(\\frac{\\pi }{4})\\,i+\\operatorname{cot}⁡(\\frac{\\pi }{4})\\,j-k \\\\  & =1\\,i+1\\,j-k \\\\  & =i+j-k\\end{aligned}\n$$\n\nSo, the value of  $f(s)$ at $s=\\frac{\\pi }{4}$  is $i+j-k.$"} {:db/id #edb/ref 17592186278343 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05747987-80b7-52ae-9065-16cc143cf892" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d9/d951dd353ee85920ecaf73724defb0f8a9f902810f3ce333da54fee96ca2eba1.png" :db/id #edb/ref 17592186275524} {:answer/id #uuid "c4cae1c9-8f27-504a-9c95-a58191e1763f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a3/a31fe0c820f7d69c3a6c7bb64c3deac3b0be917f1edea273feac2353edb2df58.png" :db/id #edb/ref 17592186277226} {:answer/id #uuid "c6107c8f-abc7-5bbe-b68c-156e9946b92c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5b/5bb9d3386eab3293e8319d7604b13e4a530f8311610ba8f0aba8f70e11aa32b0.png" :db/id #edb/ref 17592186277241} {:answer/id #uuid "d67f4f1a-22c5-50d0-b43e-cc07a19afa3c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2f/2fbee04fdedee3c2ef0b0f0da2022909ff8d9c2bea7e16b158517afe8fc35c43.png" :db/id #edb/ref 17592186277365} {:answer/id #uuid "f3504b2f-53c5-55e7-b444-e9c7d095860a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f8/f8e51d08054d568fc7caad893e7c82421e032c45b962399fd02d5c90bbe83e7f.png" :db/id #edb/ref 17592186277610}] :answer-field/correct {:answer/id #uuid "d67f4f1a-22c5-50d0-b43e-cc07a19afa3c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2f/2fbee04fdedee3c2ef0b0f0da2022909ff8d9c2bea7e16b158517afe8fc35c43.png" :db/id #edb/ref 17592186277365} :answer-field/id #uuid "094348c1-3da3-54ef-b5e1-68de2fd7b4c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277741}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d06b5b15-7a3e-5904-b5c5-3cae4271a2e8" :question/math-academy-id "q-160910" :question/problem "![](images/ad/ad0e3ddbeb228e3fdeeb09823493fb54a4a7f930c25ecd3b69b71dcf77e1d923.png)\n\nConsider the rectangular region $Δ$ in the $uv$-plane, given by\n\n$$\nΔ={(u,v)\\,:\\,1\\le u\\le 3,\\,\\,\\frac{\\pi }{6}\\le v\\le \\frac{3\\pi }{7}},\n$$\n\nand the transformation $T,$ given by\n\n$$\nT:(u,v)\\to (u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v).\n$$\n\nFind the image of $Δ$ under the action of $T.$" :question/worked-solution "To map the entire region $Δ$ onto the $xy$-plane, we transform each side of $Δ$ separately:\n\n- Consider the image of the bottom side, where we have $v=\\frac{\\pi }{6}$ and $1\\le u\\le 3.$ \n\nSubstituting $v=\\frac{\\pi }{6}$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y)=(u\\operatorname{cos}⁡(\\frac{\\pi }{6}),\\,u\\operatorname{sin}⁡(\\frac{\\pi }{6})).\\end{aligned}\n$$\n\nThis line segment makes an angle of $\\frac{\\pi }{6}$ with the positive $x$-axis in the $xy$-plane. Moreover, this segment lies on a line that passes through the origin, and its endpoints lie on the circles of radii $1$ and $3$ centered at $O.$\n\n- Consider the image of the top side, where we have $v=\\frac{3\\pi }{7}$ and $1\\le u\\le 3.$ \n\nSubstituting $v=\\frac{3\\pi }{7}$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y)=(u\\operatorname{cos}⁡(\\frac{3\\pi }{7}),\\,u\\operatorname{sin}⁡(\\frac{3\\pi }{7})).\\end{aligned}\n$$\n\nThis line segment makes an angle of $\\frac{3\\pi }{7}$ with the positive $x$-axis in the $xy$-plane. Moreover, this segment lies on a line that passes through the origin, and its endpoints lie on the circles of radii $1$ and $3$ centered at $O.$\n\n- Consider the image of the left side, where we have $u=1$ and $\\frac{\\pi }{6}\\le v\\le \\frac{3\\pi }{7}.$ \n\nSubstituting $u=1$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y)=(\\operatorname{cos}⁡v,\\,\\operatorname{sin}⁡v).\\end{aligned}\n$$\n\nThis is an arc of the circle of radius $1$ centered at the origin in the $xy$-plane. The arc lies in the first quadrant between the polar rays $\\theta =\\frac{\\pi }{6}$ and $\\theta =\\frac{3\\pi }{7}.$\n\n- Consider the image of the right side, where we have $u=3$ and $\\frac{\\pi }{6}\\le v\\le \\frac{3\\pi }{7}.$ \n\nSubstituting $u=3$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y)=(3\\operatorname{cos}⁡v,\\,3\\operatorname{sin}⁡v).\\end{aligned}\n$$\n\nThis is an arc of the circle of radius $3$ centered at the origin in the $xy$-plane. The arc lies in the first quadrant between the polar rays $\\theta =\\frac{\\pi }{6}$ and $\\theta =\\frac{3\\pi }{7}.$\n\nTherefore, the image $D$ of $Δ$ under the action of $T$ is the region that is enclosed between \n\n- two circles with polar equations $r=1$ and $r=3,$ and\n\n- two rays with polar equations $\\theta =\\frac{\\pi }{6}$ and $\\theta =\\frac{3\\pi }{7},$\n\nas shown in the diagram below.\n\n![](images/2f/2fbee04fdedee3c2ef0b0f0da2022909ff8d9c2bea7e16b158517afe8fc35c43.png)"} {:db/id #edb/ref 17592186278344 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "121a9eee-f06d-5c31-b803-574ca8ff0d91" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/39/39ba02dcd51d54bf28a84e19786d763c201858979c45f65a11069b7ba4d0584d.png" :db/id #edb/ref 17592186275641} {:answer/id #uuid "236695f1-93f1-5355-8854-dd3673ec110b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/07/0799c923b5e7061f8a6ec1faf9ed8b73038dfe4c1b63607a8e037d66d6ce88fd.png" :db/id #edb/ref 17592186275791} {:answer/id #uuid "4e728a54-7547-5708-838f-f3754fc2ad67" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/25/25ec9c36f1e6637a0034cdae142977b4a4b5c3237471ef93f4bf55c6f4ea86b7.png" :db/id #edb/ref 17592186276172} {:answer/id #uuid "6589c629-8015-54c0-992a-6de54e9fc089" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/52/5263c0c82be5ab6b0290e5017943c7c2584d3bd23783c5420e38af2df618f9b0.png" :db/id #edb/ref 17592186276388} {:answer/id #uuid "88b3cf04-1b74-59c1-8925-34f0ae5cd098" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5a/5adf324eba50123bd9a6dc3f27be38a7db0b4835bac8479e705f696abcf404b4.png" :db/id #edb/ref 17592186276711}] :answer-field/correct {:answer/id #uuid "121a9eee-f06d-5c31-b803-574ca8ff0d91" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/39/39ba02dcd51d54bf28a84e19786d763c201858979c45f65a11069b7ba4d0584d.png" :db/id #edb/ref 17592186275641} :answer-field/id #uuid "685aec8b-f5ad-57e6-a7ef-205ccbdc098d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277909}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "105c355c-8c9b-5cb0-b7b0-305140e2d0b5" :question/math-academy-id "q-160914" :question/problem "![](images/36/3621e70552c3891f43521e74704d5db3f276f9928669390d688cca1bc3449217.png)\n\nConsider the rectangular region $Δ$ in the $uv$-plane, given by\n\n$$\nΔ=\\{(u,v)\\,:\\,1\\le u\\le \\sqrt{3},\\,\\,\\frac{6\\pi }{5}\\le v\\le \\frac{4\\pi }{3}\\},\n$$\n\nand the transformation $T,$ given by\n\n$$\nT:(u,v)\\to (u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v).\n$$\n\nFind the image of $Δ$ under the action of $T.$" :question/worked-solution "To map the entire region $Δ$ onto the $xy$-plane, we transform each side of $Δ$ separately:\n\n- Consider the image of the bottom side, where we have $v=\\frac{6\\pi }{5}$ and $1\\le u\\le \\sqrt{3}.$ \n\nSubstituting $v=\\frac{6\\pi }{5}$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y)=(u\\operatorname{cos}⁡(\\frac{6\\pi }{5}),\\,u\\operatorname{sin}⁡(\\frac{6\\pi }{5})).\\end{aligned}\n$$\n\nThis line segment makes an angle of $\\frac{6\\pi }{5}$ with the positive $x$-axis in the $xy$-plane. Moreover, this segment lies on a line that passes through the origin, and its endpoints lie on the circles of radii $1$ and $\\sqrt{3}$ centered at $O.$\n\n- Consider the image of the top side, where we have $v=\\frac{4\\pi }{3}$ and $1\\le u\\le \\sqrt{3}.$ \n\nSubstituting $v=\\frac{4\\pi }{3}$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y)=(u\\operatorname{cos}⁡(\\frac{4\\pi }{3}),\\,u\\operatorname{sin}⁡(\\frac{4\\pi }{3})).\\end{aligned}\n$$\n\nThis line segment makes an angle of $\\frac{4\\pi }{3}$ with the positive $x$-axis in the $xy$-plane. Moreover, this segment lies on a line that passes through the origin, and its endpoints lie on the circles of radii $1$ and $\\sqrt{3}$ centered at $O.$\n\n- Consider the image of the left side, where we have $u=1$ and $\\frac{6\\pi }{5}\\le v\\le \\frac{4\\pi }{3}.$ \n\nSubstituting $u=1$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y)=(\\operatorname{cos}⁡v,\\,\\operatorname{sin}⁡v).\\end{aligned}\n$$\n\nThis is an arc of the circle of radius $1$ centered at the origin in the $xy$-plane. The arc lies in the first quadrant between the polar rays $\\theta =\\frac{6\\pi }{5}$ and $\\theta =\\frac{4\\pi }{3}.$\n\n- Consider the image of the right side, where we have $u=\\sqrt{3}$ and $\\frac{6\\pi }{5}\\le v\\le \\frac{4\\pi }{3}.$ \n\nSubstituting $u=\\sqrt{3}$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y)=(\\sqrt{3}\\operatorname{cos}⁡v,\\,\\sqrt{3}\\operatorname{sin}⁡v).\\end{aligned}\n$$\n\nThis is an arc of the circle of radius $\\sqrt{3}$ centered at the origin in the $xy$-plane. The arc lies in the first quadrant between the polar rays $\\theta =\\frac{6\\pi }{5}$ and $\\theta =\\frac{4\\pi }{3}.$\n\nTherefore, the image $D$ of $Δ$ under the action of $T$ is the region that is enclosed between \n\n- two circles with polar equations $r=1$ and $r=\\sqrt{3},$ and\n\n- two rays with polar equations $\\theta =\\frac{6\\pi }{5}$ and $\\theta =\\frac{4\\pi }{3},$\n\nas shown in the diagram below.\n\n![](images/c8/c8ad4cf64e9ea17b225373d8ed238c8588c0b6f45577d2ca15b22ede5e34d7d8.png)"} {:db/id #edb/ref 17592186278345 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1313dcb9-789f-52c3-a390-bf401c7faaaf" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2e/2eb8b5f7ee3fe1b85960f1d6c87a2aabf58aae6f97394b2c7145cc98b39708dc.png" :db/id #edb/ref 17592186275652} {:answer/id #uuid "814d65b2-5d38-5263-8c18-7ac197ebae2d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2e/2e8246c7764ee6a059da534fa078f3d3c7caebfbc55554be2da63002da2007bc.png" :db/id #edb/ref 17592186276643} {:answer/id #uuid "d9773844-06e5-5a9a-83d3-ef24b5bca0fb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a0/a0beb4e2dfd69e902b927915771985d9e8180ec7910993c3485cc85002956d1e.png" :db/id #edb/ref 17592186277386} {:answer/id #uuid "dd1cfb4e-7f09-57b2-a8aa-c2a14ef59c49" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1c/1c9d7de1e895affd9f75deda09fe4b3243ea39a04b47198309e0b52c6197b2f8.png" :db/id #edb/ref 17592186277412} {:answer/id #uuid "e46013f2-875c-5239-9c25-469122032ba7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/37/37bccae9033e5eac9a48f8d3d570d69d1a382f26646617665c75f32a9ac7ab4e.png" :db/id #edb/ref 17592186277473}] :answer-field/correct {:answer/id #uuid "d9773844-06e5-5a9a-83d3-ef24b5bca0fb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a0/a0beb4e2dfd69e902b927915771985d9e8180ec7910993c3485cc85002956d1e.png" :db/id #edb/ref 17592186277386} :answer-field/id #uuid "31ef5b68-ee3e-596e-99c2-fb71f74c0fee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277804}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1bfb95ad-c905-51fe-8cac-7a80399c1f9c" :question/math-academy-id "q-160925" :question/problem "![](images/c8/c86259b973101d17d732f4ac8c29a1b61de9fadfc67424a2ab6d28a2ceaa9a01.png)\n\nConsider the rectangular region $Δ$ in the $uv$-plane, given by\n\n$$\nΔ=\\{(u,v)\\,:\\,\\sqrt{2}\\le u\\le 4,\\,\\,\\frac{7\\pi }{6}\\le v\\le \\frac{9\\pi }{5}\\},\n$$\n\nand the transformation $T,$ given by\n\n$$\nT:(u,v)\\to (u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v).\n$$\n\nFind the image of $Δ$ under the action of $T.$" :question/worked-solution "To map the entire region $Δ$ onto the $xy$-plane, we transform each side of $Δ$ separately:\n\n- Consider the image of the bottom side, where we have $v=\\frac{7\\pi }{6}$ and $\\sqrt{2}\\le u\\le 4.$ \n\nSubstituting $v=\\frac{7\\pi }{6}$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y)=(u\\operatorname{cos}⁡(\\frac{7\\pi }{6}),\\,u\\operatorname{sin}⁡(\\frac{7\\pi }{6})).\\end{aligned}\n$$\n\nThis line segment makes an angle of $\\frac{7\\pi }{6}$ with the positive $x$-axis in the $xy$-plane. Moreover, this segment lies on a line that passes through the origin, and its endpoints lie on the circles of radii $\\sqrt{2}$ and $4$ centered at $O.$\n\n- Consider the image of the top side, where we have $v=\\frac{9\\pi }{5}$ and $\\sqrt{2}\\le u\\le 4.$ \n\nSubstituting $v=\\frac{9\\pi }{5}$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y)=(u\\operatorname{cos}⁡(\\frac{9\\pi }{5}),\\,u\\operatorname{sin}⁡(\\frac{9\\pi }{5})).\\end{aligned}\n$$\n\nThis line segment makes an angle of $\\frac{9\\pi }{5}$ with the positive $x$-axis in the $xy$-plane. Moreover, this segment lies on a line that passes through the origin, and its endpoints lie on the circles of radii $\\sqrt{2}$ and $4$ centered at $O.$\n\n- Consider the image of the left side, where we have $u=\\sqrt{2}$ and $\\frac{7\\pi }{6}\\le v\\le \\frac{9\\pi }{5}.$ \n\nSubstituting $u=\\sqrt{2}$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y)=(\\sqrt{2}\\operatorname{cos}⁡v,\\,\\sqrt{2}\\operatorname{sin}⁡v).\\end{aligned}\n$$\n\nThis is an arc of the circle of radius $\\sqrt{2}$ centered at the origin in the $xy$-plane. The arc lies in the first quadrant between the polar rays $\\theta =\\frac{7\\pi }{6}$ and $\\theta =\\frac{9\\pi }{5}.$\n\n- Consider the image of the right side, where we have $u=4$ and $\\frac{7\\pi }{6}\\le v\\le \\frac{9\\pi }{5}.$ \n\nSubstituting $u=4$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y)=(4\\operatorname{cos}⁡v,\\,4\\operatorname{sin}⁡v).\\end{aligned}\n$$\n\nThis is an arc of the circle of radius $4$ centered at the origin in the $xy$-plane. The arc lies in the first quadrant between the polar rays $\\theta =\\frac{7\\pi }{6}$ and $\\theta =\\frac{9\\pi }{5}.$\n\nTherefore, the image $D$ of $Δ$ under the action of $T$ is the region that is enclosed between \n\n- two circles with polar equations $r=\\sqrt{2}$ and $r=4,$ and\n\n- two rays with polar equations $\\theta =\\frac{7\\pi }{6}$ and $\\theta =\\frac{9\\pi }{5},$\n\nas shown in the diagram below.\n\n![](images/a0/a0beb4e2dfd69e902b927915771985d9e8180ec7910993c3485cc85002956d1e.png)"} {:db/id #edb/ref 17592186278351 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fdd1c39-66d8-5f61-b299-ab1278eef22f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/13/13810a874a27ea2db773ed90fa02f5b1b833d90372b38a3273f416b30d9a1a1f.png" :db/id #edb/ref 17592186275770} {:answer/id #uuid "3c1db914-4a3b-567d-9004-9871a995b025" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d3/d329b641155ad693c515ed4d8229f8bd7dbd9d0aab8442e9f65391316d5aa7a3.png" :db/id #edb/ref 17592186276003} {:answer/id #uuid "46942c75-8495-50b8-9294-5fc54ade1f68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The image is the empty set" :db/id #edb/ref 17592186276102} {:answer/id #uuid "5e2e281c-1956-541a-acc6-967b6de81c97" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/de/deafbae15e6d30f175122d3662397f05398d31579b80520648accaf1fff93e85.png" :db/id #edb/ref 17592186276317} {:answer/id #uuid "81a53031-c557-57d2-8e30-24920e8620f9" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cb/cbcba98cd11ce740be941848d0d9d4524c8cbc58d6de7aee0cfb2f7421c457db.png" :db/id #edb/ref 17592186276645}] :answer-field/correct {:answer/id #uuid "3c1db914-4a3b-567d-9004-9871a995b025" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d3/d329b641155ad693c515ed4d8229f8bd7dbd9d0aab8442e9f65391316d5aa7a3.png" :db/id #edb/ref 17592186276003} :answer-field/id #uuid "56af4b0d-dbe5-5968-a3ec-fbb544ad8284" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277878}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a3b231b2-8f67-5351-80e4-0c74d7566eae" :question/math-academy-id "q-161026" :question/problem "![](images/70/708bf4df2d45383b0dd367f5bfe3dc9e260a17cfefe0566e2b6d37dec98af2ef.png)\n\nConsider the square region $Δ$ in the $uv$-plane, given by\n\n$$\nΔ=\\{(u,v)\\,:\\,0\\le u\\le 3,\\,\\,\\frac{5\\pi }{9}\\le v\\le \\frac{5\\pi }{6}\\},\n$$\n\nand the transformation $T,$ given by\n\n$$\nT:(u,v)\\to (u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v).\n$$\n\nWhich of the following could be the image of the top side of $Δ$ under the action of $T?$" :question/worked-solution "To map the entire region $Δ$ onto the $xy$-plane, we consider the transformation of each side. However, in this case, we consider only the top side.\n\nFor the top side, we have $v=\\frac{5\\pi }{6}$ and $0\\le u\\le 3.$ \n\nSubstituting $v=\\frac{5\\pi }{6}$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y) & =T(u,v) \\\\  & =(u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v) \\\\  & =(u\\operatorname{cos}⁡(\\frac{5\\pi }{6}),\\,u\\operatorname{sin}⁡(\\frac{5\\pi }{6})),\\,0\\le u\\le 3.\\end{aligned}\n$$\n\nThis is a parametric equation of the line segment that makes an angle of $\\frac{5\\pi }{6}$ with the positive $x$-axis, where one endpoint is the point $O,$ while the other endpoint lies on the circle of radius $3$ centered at $O,$ as shown below.\n\n![](images/d3/d329b641155ad693c515ed4d8229f8bd7dbd9d0aab8442e9f65391316d5aa7a3.png)"} {:db/id #edb/ref 17592186278352 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "584874cf-45f7-5bee-ad4c-cff9dd61fafe" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2d/2d95ce1c0b844b49000b05ef44ef0da8b516740804a8e6bd275a1f9ca15b2ed0.png" :db/id #edb/ref 17592186276269} {:answer/id #uuid "7d3dfe37-6205-5422-b918-e6d81b4ee49d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/48/48eb6a022826e8f4e1246201e4ad190fff9bb6afdf7b2146d89010e76478a4bf.png" :db/id #edb/ref 17592186276619} {:answer/id #uuid "878dfa7e-92cb-5c8c-b42e-c3016b96b8bf" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a6/a63ab6b0cb9e525901e8173ae54afb89530ae96342975731b76e51b2a51d752e.png" :db/id #edb/ref 17592186276700} {:answer/id #uuid "a2283404-74f4-597b-8d72-caae8132ba82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The image is the empty set" :db/id #edb/ref 17592186276938} {:answer/id #uuid "dba6cfae-b425-5d87-a3c3-aeb9c7548d39" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/53/539932b6d0bc70809848bf1690df34dc56ebb569dc4877c231bd08e8698c5764.png" :db/id #edb/ref 17592186277399}] :answer-field/correct {:answer/id #uuid "7d3dfe37-6205-5422-b918-e6d81b4ee49d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/48/48eb6a022826e8f4e1246201e4ad190fff9bb6afdf7b2146d89010e76478a4bf.png" :db/id #edb/ref 17592186276619} :answer-field/id #uuid "b8c400c5-8573-5465-a3ff-27207f2d93f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278053}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e82f4301-a070-5bc8-9a49-2d57b54ecb56" :question/math-academy-id "q-161028" :question/problem "![](images/aa/aa62dda1abb7bc6bca1b2e6cdf356b52946820912ec6318e5901273a546ee96a.png)\n\nConsider the square region $Δ$ in the $uv$-plane, given by\n\n$$\nΔ=\\{(u,v)\\,:\\,0\\le u\\le 4,\\,\\,\\frac{3\\pi }{4}\\le v\\le \\frac{7\\pi }{6}\\},\n$$\n\nand the transformation $T,$ given by\n\n$$\nT:(u,v)\\to (u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v).\n$$\n\nWhich of the following could be the image of the bottom side of $Δ$ under the action of $T?$" :question/worked-solution "To map the entire region $Δ$ onto the $xy$-plane, we consider the transformation of each side. However, in this case, we consider only the bottom side.\n\nFor the bottom side, we have $v=\\frac{3\\pi }{4}$ and $0\\le u\\le 4.$ \n\nSubstituting $v=\\frac{3\\pi }{4}$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y) & =T(u,v) \\\\  & =(u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v) \\\\  & =(u\\operatorname{cos}⁡(\\frac{3\\pi }{4}),\\,u\\operatorname{sin}⁡(\\frac{3\\pi }{4})),\\,0\\le u\\le 4.\\end{aligned}\n$$\n\nThis is a parametric equation of the line segment that makes an angle of $\\frac{3\\pi }{4}$ with the positive $x$-axis, where one endpoint is the point $O,$ while the other endpoint lies on the circle of radius $4$ centered at $O,$ as shown below.\n\n![](images/48/48eb6a022826e8f4e1246201e4ad190fff9bb6afdf7b2146d89010e76478a4bf.png)"} {:db/id #edb/ref 17592186278355 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3096bf79-13cb-5594-8ff3-0aacf795dbf7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465363} {:answer/id #uuid "393ffa03-6956-52c3-9c56-83c0666a5be8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465364}] :answer-field/correct {:answer/id #uuid "3096bf79-13cb-5594-8ff3-0aacf795dbf7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465363} :answer-field/id #uuid "d865425f-0ed5-5b50-8ef9-b8868f1ed1a5" :answer-field/key "The image makes the angle of $\\frac{10\\pi }{9}$ with the positive $x$-axis." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466525} {:answer-field/choices [{:answer/id #uuid "313850ab-cf0e-5be1-adef-f98bf156970b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465365} {:answer/id #uuid "13a93521-b1c0-56cd-89e3-b6c1a0c7b8ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465366}] :answer-field/correct {:answer/id #uuid "13a93521-b1c0-56cd-89e3-b6c1a0c7b8ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465366} :answer-field/id #uuid "fd71148f-4e73-5e2a-8879-b803cc673e59" :answer-field/key "The image makes the angle of $\\frac{4\\pi }{3}$ with the positive $x$-axis." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466526} {:answer-field/choices [{:answer/id #uuid "8d8d6a03-31ff-5539-a052-c4af98a1c661" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465367} {:answer/id #uuid "c1b94c56-f71d-5f8c-82f5-974795670e84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465368}] :answer-field/correct {:answer/id #uuid "8d8d6a03-31ff-5539-a052-c4af98a1c661" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465367} :answer-field/id #uuid "f410ff3f-f43f-507a-8637-7fcae02b4d22" :answer-field/key "The endpoints of the image lie on the circles of radii $\\sqrt{2}$ and $2$ centered at $O.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466527}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4b7f9af3-cd62-5b44-9828-72b23454ff87" :question/math-academy-id "q-161032" :question/problem "![](images/16/16d74107dbbf12749766cd9cea7e38d16e28a59efb997bd224aed73c7830324e.png)\n\nConsider the square region $Δ$ in the $uv$-plane, given by\n\n$$\nΔ=\\{(u,v)\\,:\\,2\\le u\\le 4,\\,\\,\\frac{10\\pi }{9}\\le v\\le \\frac{4\\pi }{3}\\},\n$$\n\nand the transformation $T,$ given by\n\n$$\nT:(u,v)\\to (u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v).\n$$\n\nThe image of the top side of $Δ$ under the action of $T$ is a line segment. Which of the following statements are true regarding the image?\n\nSelect all that apply." :question/worked-solution "To map the entire region $Δ$ onto the $xy$-plane, we consider the transformation of each side. However, in this case, we consider only the top side.\n\nFor the top side, we have $v=\\frac{4\\pi }{3}$ and $2\\le u\\le 4.$ \n\nSubstituting $v=\\frac{4\\pi }{3}$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y) & =T(u,v) \\\\  & =(u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v) \\\\  & =(u\\operatorname{cos}⁡(\\frac{4\\pi }{3}),\\,u\\operatorname{sin}⁡(\\frac{4\\pi }{3})),\\,2\\le u\\le 4.\\end{aligned}\n$$\n\nThis is a parametric equation of the line segment shown below.\n\n![](images/bf/bfe75ef6b4ea9ddd72be6501f95fd89dd1e80fb2aed691c3c22b158514141cc1.png)\n\n \n\nNote that the line that this segment lies on passes through the origin. \n\nWith that in mind, let's examine our statements.\n\n- Statement “The image makes the angle of $\\frac{10\\pi }{9}$ with the positive $x$-axis” is false, while statement “The image makes the angle of $\\frac{4\\pi }{3}$ with the positive $x$-axis” is true. The slope of the line is\n\n$$\nk=\\frac{\\operatorname{sin}⁡(\\frac{4\\pi }{3})}{\\operatorname{cos}⁡(\\frac{4\\pi }{3})}=\\operatorname{tan}⁡(\\frac{4\\pi }{3}).\n$$\n\nAs a result, our line makes an angle of $\\frac{4\\pi }{3}$ radians with the positive $x$-axis.\n\n- Statement “The endpoints of the image lie on the circles of radii $\\sqrt{2}$ and $2$ centered at $O.$” is false.\n\n- When $u=2,$ we obtain the point \n$(2\\operatorname{cos}⁡(\\frac{4\\pi }{3}),\\,2\\operatorname{sin}⁡(\\frac{4\\pi }{3})),$\nwhose distance to the origin is $2.$\n\n- When $u=4,$ we obtain the point \n$(4\\operatorname{cos}⁡(\\frac{4\\pi }{3}),\\,4\\operatorname{sin}⁡(\\frac{4\\pi }{3})),$\nwhose distance to the origin is $4.$\n\nSo, the endpoints of the line segment lie on the circles of radii $2$ and $4.$\n\nTherefore, the correct answer is “The image makes the angle of $\\frac{4\\pi }{3}$ with the positive $x$-axis” only."} {:db/id #edb/ref 17592186278356 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e9d7f9d-83aa-5312-b9f9-936431142ca4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465369} {:answer/id #uuid "0ac8bfb2-2b9e-55b8-bb40-8f8acd30ba03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465370}] :answer-field/correct {:answer/id #uuid "3e9d7f9d-83aa-5312-b9f9-936431142ca4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465369} :answer-field/id #uuid "3c3a02a3-a8fc-5d7d-a6a6-ce9f21391422" :answer-field/key "The image makes the angle of $0$ with the positive $x$-axis." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466528} {:answer-field/choices [{:answer/id #uuid "a7781f3c-7002-5af8-8927-9ec981d328c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465371} {:answer/id #uuid "a99cc1de-6948-5f01-b0c0-9f08fcb47a6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465372}] :answer-field/correct {:answer/id #uuid "a99cc1de-6948-5f01-b0c0-9f08fcb47a6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465372} :answer-field/id #uuid "bcb1bd5d-92e5-55ab-9836-46ae0a7485ce" :answer-field/key "The image makes the angle of $\\frac{3\\pi }{4}$ with the positive $x$-axis." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466529} {:answer-field/choices [{:answer/id #uuid "7401365f-e9ac-59db-a5a4-772ee4d7ef48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465373} {:answer/id #uuid "cd23ead9-89df-5865-9f9e-b85c6d699f6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465374}] :answer-field/correct {:answer/id #uuid "7401365f-e9ac-59db-a5a4-772ee4d7ef48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465373} :answer-field/id #uuid "789e9739-d69d-5715-b272-2c686ab19b73" :answer-field/key "One endpoint of the image is the origin $O$ of the $xy$-plane, and the other endpoint lies on the circle of radius $5$ centered at $O.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466530}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "35901d5d-b737-59bd-bd22-20c686ac3fe1" :question/math-academy-id "q-161035" :question/problem "![](images/8a/8afe0884ccf1e62ffdfef6cab4626bc59b3138aa5cd26f855980c88971753447.png)\n\nConsider the square region $Δ$ in the $uv$-plane, given by\n\n$$\nΔ={(u,v)\\,:\\,0\\le u\\le \\sqrt{5},\\,\\,0\\le v\\le \\frac{3\\pi }{4}},\n$$\n\nand the transformation $T,$ given by\n\n$$\nT:(u,v)\\to (u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v).\n$$\n\nThe image of the top side of $Δ$ under the action of $T$ is a line segment. Which of the following statements are true regarding the image?\n\nSelect all that apply.\n\nIf none apply, leave all boxes unchecked." :question/worked-solution "To map the entire region $Δ$ onto the $xy$-plane, we consider the transformation of each side. However, in this case, we consider only the top side.\n\nFor the top side, we have $v=\\frac{3\\pi }{4}$ and $0\\le u\\le \\sqrt{5}.$ \n\nSubstituting $v=\\frac{3\\pi }{4}$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y) & =T(u,v) \\\\  & =(u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v) \\\\  & =(u\\operatorname{cos}⁡(\\frac{3\\pi }{4}),\\,u\\operatorname{sin}⁡(\\frac{3\\pi }{4})),\\,0\\le u\\le \\sqrt{5}.\\end{aligned}\n$$\n\nThis is a parametric equation of the line segment shown below.\n\n![](images/b8/b836799bc512db70d2ce5fcfe70db2af3b2572d584d317fa5ed515b363a11ddc.png)\n\n \n\nNote that the line that this segment lies on passes through the origin. \n\nWith that in mind, let's examine our statements.\n\n- Statement “The image makes the angle of $0$ with the positive $x$-axis” is false, while statement “The image makes the angle of $\\frac{3\\pi }{4}$ with the positive $x$-axis” is true. The slope of the line is\n\n$$\nk=\\frac{\\operatorname{sin}⁡(\\frac{3\\pi }{4})}{\\operatorname{cos}⁡(\\frac{3\\pi }{4})}=\\operatorname{tan}⁡(\\frac{3\\pi }{4}).\n$$\n\nAs a result, our line makes an angle of $\\frac{3\\pi }{4}$ radians with the positive $x$-axis.\n\n- Statement “One endpoint of the image is the origin $O$ of the $xy$-plane, and the other endpoint lies on the circle of radius $5$ centered at $O.$” is false.\n\n- When $u=0,$ we obtain the point $(0,\\,0),$ which is the origin $O$ of the $xy$-plane.\n\n- When $u=\\sqrt{5},$ we obtain the point \n$(\\sqrt{5}\\operatorname{cos}⁡(\\frac{3\\pi }{4}),\\,\\sqrt{5}\\operatorname{sin}⁡(\\frac{3\\pi }{4})),$\nwhose distance to $O$ is $\\sqrt{5}.$\n\nSo, one endpoint of the segment is the origin $O$ of the $xy$-plane, while the other endpoint lies in the circle with radius $\\sqrt{5}$ centered at $O.$\n\nTherefore, the correct answer is “The image makes the angle of $\\frac{3\\pi }{4}$ with the positive $x$-axis” only."} {:db/id #edb/ref 17592186278374 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1395d175-7d1f-53b0-a292-a6d896cb7078" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{2}({r}^{2}\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186275659} {:answer/id #uuid "34ba6316-25bc-5c60-8cd0-fefb9a09fcd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{1}^{2}(2{r}^{2}\\operatorname{sin}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186275949} {:answer/id #uuid "43e22192-319a-513d-a28f-5db2ed854a17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{1}^{2}(\\frac{{r}^{2}\\operatorname{sin}⁡\\theta }{2})\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186276077} {:answer/id #uuid "7b94d82f-c6ee-525c-b64f-d572bc15262c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{1}^{2}{r}^{3}\\operatorname{sin}⁡2\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186276600} {:answer/id #uuid "e1dc77eb-167e-5632-829d-ad58f36473c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}{\\int }_{0}^{\\pi }({r}^{2}\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186277452}] :answer-field/correct {:answer/id #uuid "7b94d82f-c6ee-525c-b64f-d572bc15262c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{1}^{2}{r}^{3}\\operatorname{sin}⁡2\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186276600} :answer-field/id #uuid "fa5eff7c-3120-504b-a38a-efaff47fe6cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278167}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d548092f-8e97-501c-97b5-1d5ab43c5b4d" :question/math-academy-id "q-161079" :question/problem "![](images/4d/4da25a7fcce468774aafcf2c1dbf7b4ef65089194d0330b1159d18a9a8f4bfe9.png)\n\nThe region $D$ in the plane is enclosed between two circles centered at $O$ of radii $1$ and $2,$ as shown above. What is\n${∬}_{D}2xy\\,\\text{d}A$\nexpressed in polar coordinates?" :question/worked-solution "We will use the change of variables formula in the form \n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nThe region $D$ represents a portion of the washer enclosed between the circles of radii $1$ and $2$ centered at the origin. In polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ={(r,\\theta )\\,:\\,1\\le r\\le 2,\\,0\\le \\theta \\le 2\\pi }.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∬}_{D}2xy\\,\\text{ }dA & ={∬}_{Δ}2(r\\operatorname{cos}⁡\\theta \\cdot r\\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{1}^{2}{r}^{2}(2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{1}^{2}{r}^{3}\\operatorname{sin}⁡2\\theta \\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278375 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ac160c0-9e31-53a2-8e67-6a875cc69c83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{4}\\frac{1}{(x+1)^{4}}\\sqrt{1+\\frac{x}{x+1}}\\,\\text{d}x" :db/id #edb/ref 17592186275726} {:answer/id #uuid "4321ec57-3aa3-5435-bef9-7196ceb02e4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{4}\\frac{1}{(x+1)^{2}}\\sqrt{1+\\frac{x}{x+1}}\\,\\text{d}x" :db/id #edb/ref 17592186276073} {:answer/id #uuid "432e387d-bcda-51fe-936c-0efd0034da26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{4}\\frac{1}{x+1}\\sqrt{1+\\frac{x}{(x+1)^{2}}}\\,\\text{d}x" :db/id #edb/ref 17592186276074} {:answer/id #uuid "50b08d4f-b9f3-5da2-9255-56d9e80228dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{4}\\frac{x}{x+1}\\sqrt{1+\\frac{1}{(x+1)^{4}}}\\,\\text{d}x" :db/id #edb/ref 17592186276197} {:answer/id #uuid "767527c1-5b06-5f0f-af49-a862e51ad660" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{4}\\frac{x}{x+1}\\sqrt{1+\\frac{1}{(x+1)^{2}}}\\,\\text{d}x" :db/id #edb/ref 17592186276547}] :answer-field/correct {:answer/id #uuid "50b08d4f-b9f3-5da2-9255-56d9e80228dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{4}\\frac{x}{x+1}\\sqrt{1+\\frac{1}{(x+1)^{4}}}\\,\\text{d}x" :db/id #edb/ref 17592186276197} :answer-field/id #uuid "977aba5e-30b2-5f02-a704-7229f7441b6d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277994}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cbbd01ee-4c13-59a2-bf89-170f124c5003" :question/math-academy-id "q-161093" :question/problem "Use a fundamental vector product to determine which of the following integrals gives the surface area generated when the curve $y=\\frac{x}{x+1}$ is rotated by $2\\pi $ radians about the $x$-axis for $x\\in [0,4].$" :question/worked-solution "Notice that $y=\\frac{x}{x+1}\\ge 0$ for all $x\\in [0,4].$ The parametrization of our surface of revolution is\n\n$$\n\\begin{aligned}r=⟨x,\\,f(x)\\operatorname{cos}⁡\\theta ,\\,f(x)\\operatorname{sin}⁡\\theta ⟩,\\,(x,\\theta )\\in D\\end{aligned}\n$$\n\nwhere $f(x)=\\frac{x}{x+1},$ and\n\n$$\nD={(x,\\theta )\\,:\\,0\\le x\\le 4,\\,0\\le \\theta \\le 2\\pi }.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{x}^{′} & =⟨\\frac{∂x}{∂x},\\,\\frac{∂y}{∂x},\\,\\frac{∂z}{∂x}⟩=⟨1,\\,{f}^{′}\\operatorname{cos}⁡\\theta ,\\,{f}^{′}\\operatorname{sin}⁡\\theta ⟩ \\\\ {r}_{\\theta }^{′} & =⟨\\frac{∂x}{∂\\theta },\\,\\frac{∂y}{∂\\theta },\\,\\frac{∂z}{∂\\theta }⟩=⟨0,\\,-f\\operatorname{sin}⁡\\theta ,\\,f\\operatorname{cos}⁡\\theta ⟩\\end{aligned}\n$$\n\nNext, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{x}^{′}\\times {r}_{\\theta }^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & {f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{aligned}| \\\\  & =⟨|\\begin{aligned}{f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{aligned}|,\\,-|\\begin{aligned}1 & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & f\\operatorname{cos}⁡\\theta \\end{aligned}|,\\,|\\begin{aligned}1 & {f}^{′}\\operatorname{cos}⁡\\theta  \\\\ 0 & -f\\operatorname{sin}⁡\\theta \\end{aligned}|⟩ \\\\  & =⟨f{f}^{′}{cos}^{2}⁡\\theta +f{f}^{′}{sin}^{2}⁡\\theta ,\\,-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨f{f}^{′},\\,-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ⟩\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}‖{r}_{x}^{′}\\times {r}_{\\theta }^{′}‖ & =\\sqrt{(f{f}^{′})^{2}+(-f\\operatorname{cos}⁡\\theta )^{2}+(-f\\operatorname{sin}⁡\\theta )^{2}} \\\\  & =\\sqrt{{f}^{2}({f}^{′})^{2}+{f}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )} \\\\  & =\\sqrt{{f}^{2}({f}^{′})^{2}+{f}^{2}} \\\\  & =f\\sqrt{1+({f}^{′})^{2}}.\\end{aligned}\n$$\n\nTherefore, the surface area is\n\n$$\n\\begin{aligned}A & ={∬}_{S}\\,\\text{d}S \\\\  & ={∬}_{D}‖{r}_{x}^{′}\\times {r}_{\\theta }^{′}‖\\,\\text{d}x\\,\\text{d}\\theta  \\\\  & ={∬}_{D}f\\sqrt{1+({f}^{′})^{2}}\\,\\,\\text{d}x\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{4}f\\sqrt{1+({f}^{′})^{2}}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta \\,\\text{d}x \\\\  & ={\\int }_{0}^{4}f\\sqrt{1+({f}^{′})^{2}}\\cdot \\theta \\,{|}_{0}^{2\\pi }\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{4}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nSince $f(x)=\\frac{x}{x+1},$ we obtain ${f}^{′}(x)=\\frac{1}{(x+1)^{2}}.$ So, finally, we conclude that our expression for the surface area is\n\n$$\n\\begin{aligned}2\\pi {\\int }_{0}^{4}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}x & =2\\pi {\\int }_{0}^{4}\\frac{x}{x+1}\\sqrt{1+{(\\frac{1}{(x+1)^{2}})}^{2}}\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{4}\\frac{x}{x+1}\\sqrt{1+\\frac{1}{(x+1)^{4}}}\\,\\text{d}x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278378 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1504b562-ea07-5020-baa3-bce4b8c73fa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{1}^{5}\\frac{1}{{z}^{2}}\\sqrt{1+\\frac{4}{{z}^{6}}}\\,\\text{d}z" :db/id #edb/ref 17592186275675} {:answer/id #uuid "1f9511a3-47fe-51ed-b124-e1105e4f0c92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{1}^{5}\\frac{1}{{z}^{2}}\\sqrt{1+\\frac{2}{{z}^{3}}}\\,\\text{d}z" :db/id #edb/ref 17592186275766} {:answer/id #uuid "8ba037df-7fdf-5532-a494-ac03592db52b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{1}^{5}\\frac{1}{{z}^{4}}\\sqrt{1+\\frac{2}{{z}^{3}}}\\,\\text{d}z" :db/id #edb/ref 17592186276747} {:answer/id #uuid "b5e00aa8-6165-5f31-8310-6e1e1a406117" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{1}^{5}\\frac{1}{{z}^{4}}\\sqrt{1+\\frac{4}{{z}^{6}}}\\,\\text{d}z" :db/id #edb/ref 17592186277096} {:answer/id #uuid "f908b8f9-5e49-5941-bd3e-e05f0081a353" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{1}^{5}\\frac{1}{{z}^{4}}\\sqrt{1-\\frac{1}{{z}^{3}}}\\,\\text{d}z" :db/id #edb/ref 17592186277656}] :answer-field/correct {:answer/id #uuid "1504b562-ea07-5020-baa3-bce4b8c73fa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{1}^{5}\\frac{1}{{z}^{2}}\\sqrt{1+\\frac{4}{{z}^{6}}}\\,\\text{d}z" :db/id #edb/ref 17592186275675} :answer-field/id #uuid "11ef57f9-a018-5ee8-a2b1-622897978c22" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277759}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8a98dcae-fa38-562f-8676-270d1756205a" :question/math-academy-id "q-161099" :question/problem "Use a fundamental vector product to determine which of the following integrals gives the surface area generated when the curve $y=\\frac{1}{{z}^{2}}$ is rotated by $2\\pi $ radians about the $z$-axis for $z\\in [1,5].$" :question/worked-solution "Notice that $y=\\frac{1}{{z}^{2}}\\ge 0$ for all $z\\in [1,5].$ The parametrization of our surface of revolution is\n\n$$\n\\begin{aligned}r=⟨f(z)\\operatorname{cos}⁡\\theta ,\\,f(z)\\operatorname{sin}⁡\\theta ,\\,z⟩,\\,(z,\\theta )\\in D\\end{aligned}\n$$\n\nwhere $f(z)=\\frac{1}{{z}^{2}},$ and\n\n$$\nD={(z,\\theta )\\,:\\,1\\le z\\le 5,\\,0\\le \\theta \\le 2\\pi }.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{z}^{′} & =⟨\\frac{∂x}{∂z},\\,\\frac{∂y}{∂z},\\,\\frac{∂z}{∂z}⟩=⟨{f}^{′}\\operatorname{cos}⁡\\theta ,\\,{f}^{′}\\operatorname{sin}⁡\\theta ,\\,1⟩ \\\\ {r}_{\\theta }^{′} & =⟨\\frac{∂x}{∂\\theta },\\,\\frac{∂y}{∂\\theta },\\,\\frac{∂z}{∂\\theta }⟩=⟨-f\\operatorname{sin}⁡\\theta ,\\,f(y)\\operatorname{cos}⁡\\theta ,\\,0⟩\\end{aligned}\n$$\n\nNext, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{z}^{′}\\times {r}_{\\theta }^{′} & =|\\begin{aligned}i & j & k \\\\ {f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  & 1 \\\\ -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta  & 0\\end{aligned}| \\\\  & =⟨|\\begin{aligned}{f}^{′}\\operatorname{sin}⁡\\theta  & 1 \\\\ f\\operatorname{cos}⁡\\theta  & 0\\end{aligned}|,\\,-|\\begin{aligned}{f}^{′}\\operatorname{cos}⁡\\theta  & 1 \\\\ -f\\operatorname{sin}⁡\\theta  & 0\\end{aligned}|,\\,|\\begin{aligned}{f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{aligned}|⟩ \\\\  & =⟨-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ,\\,{f}^{′}f{cos}^{2}⁡\\theta +{f}^{′}f{sin}^{2}⁡\\theta ⟩ \\\\  & =⟨-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ,\\,{f}^{′}f⟩.\\end{aligned}\n$$\n\n  \n\nand\n\n$$\n\\begin{aligned}‖{r}_{z}^{′}\\times {r}_{\\theta }^{′}‖ & =\\sqrt{(-f\\operatorname{cos}⁡\\theta )^{2}+(-f\\operatorname{sin}⁡\\theta )^{2}+({f}^{′}f)^{2}} \\\\  & =\\sqrt{{f}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+{f}^{2}({f}^{′})^{2}} \\\\  & =\\sqrt{{f}^{2}+{f}^{2}({f}^{′})^{2}} \\\\  & =f\\sqrt{1+({f}^{′})^{2}}.\\end{aligned}\n$$\n\nTherefore, the surface area is\n\n$$\n\\begin{aligned}A & ={∬}_{S}\\,\\text{d}S \\\\  & ={∬}_{D}‖{r}_{z}^{′}\\times {r}_{\\theta }^{′}‖\\text{d}z\\,\\text{d}\\theta  \\\\  & ={∬}_{D}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}z\\,\\text{d}\\theta  \\\\  & ={\\int }_{1}^{5}f\\sqrt{1+({f}^{′})^{2}}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta \\,\\text{d}z \\\\  & ={\\int }_{1}^{5}f\\sqrt{1+({f}^{′})^{2}}\\cdot \\theta \\,{|}_{0}^{2\\pi }\\,\\text{d}z \\\\  & =2\\pi {\\int }_{1}^{5}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}z.\\end{aligned}\n$$\n\nSince $f(z)=\\frac{1}{{z}^{2}},$ we obtain ${f}^{′}(z)=-\\frac{2}{{z}^{3}}.$ So, finally, we conclude that our expression for the surface area is\n\n$$\n\\begin{aligned}2\\pi {\\int }_{1}^{5}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}z & =2\\pi {\\int }_{1}^{5}\\frac{1}{{z}^{2}}\\sqrt{1+{(-\\frac{2}{{z}^{3}})}^{2}}\\,\\text{d}z \\\\  & =2\\pi {\\int }_{1}^{5}\\frac{1}{{z}^{2}}\\sqrt{1+\\frac{4}{{z}^{6}}}\\,\\text{d}z.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278381 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2410c5d2-ad7f-56ab-b8c6-a7aad16f515d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.5\\,\\text{cm}" :db/id #edb/ref 17592186275794} {:answer/id #uuid "3514b170-e1eb-53a5-9e81-17de317fd7f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.5\\,\\text{cm}" :db/id #edb/ref 17592186275950} {:answer/id #uuid "5fb8bc3d-ff67-57f3-ae8b-552e2e72e1a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{cm}" :db/id #edb/ref 17592186276333} {:answer/id #uuid "c02fcd5b-0741-5682-8bdc-226b818d2249" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\text{cm}" :db/id #edb/ref 17592186277183} {:answer/id #uuid "e8422d6a-5c26-57c8-91a3-e854994c2b26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\text{cm}" :db/id #edb/ref 17592186277509}] :answer-field/correct {:answer/id #uuid "c02fcd5b-0741-5682-8bdc-226b818d2249" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\text{cm}" :db/id #edb/ref 17592186277183} :answer-field/id #uuid "54bd7b28-8ea6-5b14-9542-32ed882c403b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277870}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1a46e83d-b704-567c-8d00-1886b9f6bc9b" :question/math-academy-id "q-161107" :question/problem "![](images/ef/ef8379b21526455a723369fda4360e2d7d3ef3cf54ce7d7767df7bd160a169f4.png)\n\nThe area of ​​the triangle $△ABC$ is $5\\sqrt{3}\\,{\\text{cm}}^{2}.$ Find $AC.$" :question/worked-solution "The formula for the area of the triangle is \n\n$$\nA=\\frac{1}{2}bc\\operatorname{sin}⁡A,\n$$\n\nwhere $∠A$ is between the sides of lengths $b$ and $c.$ \n\nHere\n\n$$\n\\begin{aligned}c & =AB=5\\text{ cm}, \\\\ b & =AC, \\\\ m∠A & ={60}^{∘}.\\end{aligned}\n$$\n\nSince \n\n$$\n\\operatorname{sin}⁡{60}^{∘}=\\frac{\\sqrt{3}}{2},\n$$\n\nwe can calculate $b=AC,$ as follows:\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot b\\cdot c\\cdot \\operatorname{sin}⁡A \\\\ 5\\sqrt{3} & =\\frac{1}{2}\\cdot b\\cdot 5\\cdot \\operatorname{sin}⁡{60}^{∘} \\\\ 5\\sqrt{3} & =\\frac{1}{2}\\cdot b\\cdot 5\\cdot (\\frac{\\sqrt{3}}{2}) \\\\ 5\\sqrt{3} & =\\frac{5\\sqrt{3}\\,b}{4} \\\\ \\cancel{5\\sqrt{3}} & =\\frac{\\cancel{5\\sqrt{3}}\\,b}{4} \\\\ 1 & =\\frac{b}{4} \\\\ b & =4\\text{ cm}.\\end{aligned}\n$$\n\nWe conclude that $AC=4\\,\\text{cm}.$"} {:db/id #edb/ref 17592186278383 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a92871f-5bd5-581e-ac06-dbd13021c053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,\\text{cm}" :db/id #edb/ref 17592186275724} {:answer/id #uuid "299f96e2-93fa-5d8f-ab41-fc313dbd3222" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7.5\\,\\text{cm}" :db/id #edb/ref 17592186275854} {:answer/id #uuid "4f831c2c-96bc-514e-94a8-9c7ae9a2e9a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\text{cm}" :db/id #edb/ref 17592186276188} {:answer/id #uuid "7bb62d91-e7c1-5a0b-9594-0da656f39663" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.5\\,\\text{cm}" :db/id #edb/ref 17592186276601} {:answer/id #uuid "a89eff61-0284-58bc-8453-86df1e739eb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,\\text{cm}" :db/id #edb/ref 17592186276998}] :answer-field/correct {:answer/id #uuid "1a92871f-5bd5-581e-ac06-dbd13021c053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,\\text{cm}" :db/id #edb/ref 17592186275724} :answer-field/id #uuid "e821e218-a2a4-5efe-86d2-0f9a4556c28f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278132}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "43fd23a0-08b8-58ee-b7e6-43240cfa05d7" :question/math-academy-id "q-161109" :question/problem "![](images/b9/b95571772af958b4f7b7dcdbba630b78e029c838340dc272809a6c7915dc9c90.png)\n\nThe area of ​​the triangle $△ABC$ is $\\frac{21\\sqrt{2}}{2}{\\text{ cm}}^{2}.$ Find $AC.$" :question/worked-solution "The formula for the area of the triangle is \n\n$$\nA=\\frac{1}{2}bc\\operatorname{sin}⁡A,\n$$\n\nwhere $∠A$ is between the sides of lengths $b$ and $c.$ \n\nHere\n\n$$\n\\begin{aligned}c & =AB=6\\text{ cm}, \\\\ b & =AC, \\\\ m∠A & ={45}^{∘}.\\end{aligned}\n$$\n\nSince \n\n$$\n\\operatorname{sin}⁡{45}^{∘}=\\frac{\\sqrt{2}}{2},\n$$\n\nwe can calculate $b=AC,$ as follows:\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot b\\cdot c\\cdot \\operatorname{sin}⁡A \\\\ \\frac{21\\sqrt{2}}{2} & =\\frac{1}{2}\\cdot b\\cdot 6\\cdot \\operatorname{sin}⁡{45}^{∘} \\\\ \\frac{21\\sqrt{2}}{2} & =\\frac{1}{2}\\cdot b\\cdot 6\\cdot (\\frac{\\sqrt{2}}{2}) \\\\ \\frac{21\\sqrt{2}}{2} & =\\frac{3\\sqrt{2}\\,b}{2} \\\\ \\frac{21\\cancel{\\sqrt{2}}}{\\cancel{2}} & =\\frac{3\\cancel{\\sqrt{2}}\\,b}{\\cancel{2}} \\\\ 3b & =21 \\\\ b & =7\\text{ cm}.\\end{aligned}\n$$\n\nWe conclude that $AC=7\\,\\text{cm}.$"} {:db/id #edb/ref 17592186278390 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45948700-503f-551b-bdea-87109566160f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+4{x}^{2}+16{y}^{2}" :db/id #edb/ref 17592186276090} {:answer/id #uuid "4ab93a6e-5eac-5228-b299-b866a1ad303c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+2{x}^{2}+8{y}^{2}" :db/id #edb/ref 17592186276135} {:answer/id #uuid "6e807a78-b474-5a7f-8440-4f35e51cb60e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{1+4{x}^{2}+8{y}^{2}}" :db/id #edb/ref 17592186276468} {:answer/id #uuid "81b78249-6d6c-5a58-8ea3-ac7673969a7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{1+2{x}^{2}+4{y}^{2}}" :db/id #edb/ref 17592186276646} {:answer/id #uuid "ecdcb59c-b7f0-5394-8e00-a4e1644424c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{1+4{x}^{2}+16{y}^{2}}" :db/id #edb/ref 17592186277554}] :answer-field/correct {:answer/id #uuid "ecdcb59c-b7f0-5394-8e00-a4e1644424c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{1+4{x}^{2}+16{y}^{2}}" :db/id #edb/ref 17592186277554} :answer-field/id #uuid "69336c1f-3dc5-5f03-92c4-84bacf0d2e8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277910}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "128c01a3-ffea-59eb-9892-8068500c0400" :question/math-academy-id "q-161126" :question/problem "$$\n{∬}_{D}\\boxed{}\\,\\text{d}A,\\,D=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le 1\\}\n$$\n\nThe integral above gives the surface area of $z={x}^{2}+2{y}^{2}$ for $0\\le x\\le 1$ and $0\\le y\\le 1.$ What is the missing expression?" :question/worked-solution "For a surface $S$ defined by $z=f(x,y)$ with $(x,y)\\in D,$ the surface area of $S$ is given by\n\n$$\n{∬}_{S}\\,\\text{d}S={∬}_{D}\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A.\n$$\n\nIn this case, our surface is given by\n\n$$\nz={x}^{2}+2{y}^{2},\\,0\\le x\\le 1,\\,0\\le y\\le 1.\n$$\n\nNow, since\n\n$$\n\\begin{aligned}\\frac{∂z}{∂x} & =\\frac{∂}{∂x}({x}^{2}+2{y}^{2})=2x, \\\\ \\frac{∂z}{∂y} & =\\frac{∂}{∂y}({x}^{2}+2{y}^{2})=4y,\\end{aligned}\n$$\n\nthe surface area is given by\n\n$$\n\\begin{aligned}{∬}_{S}\\,\\text{d}S & ={∬}_{D}\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+(2x)^{2}+(4y)^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+4{x}^{2}+16{y}^{2}}\\,\\text{d}A.\\end{aligned}\n$$\n\nTherefore, the correct answer is $\\sqrt{1+4{x}^{2}+16{y}^{2}}.$"} {:db/id #edb/ref 17592186278392 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ad4c485-991a-5037-b69d-883685454737" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+36{x}^{4}{y}^{2}" :db/id #edb/ref 17592186275727} {:answer/id #uuid "870ff709-7130-5f4a-824d-3df0deccd82e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{1-3{x}^{2}+2y}" :db/id #edb/ref 17592186276691} {:answer/id #uuid "b05684f5-deb4-54a0-b913-186656656d6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{1+9{x}^{4}+4{y}^{2}}" :db/id #edb/ref 17592186277055} {:answer/id #uuid "b76e9e2d-b3d1-5d08-a8a9-414b1e3a6f7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-3{x}^{2}+2y" :db/id #edb/ref 17592186277106} {:answer/id #uuid "e2342e6a-26fb-5edd-a09d-f48dbbcb61cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{1+36{x}^{4}{y}^{2}}" :db/id #edb/ref 17592186277457}] :answer-field/correct {:answer/id #uuid "b05684f5-deb4-54a0-b913-186656656d6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{1+9{x}^{4}+4{y}^{2}}" :db/id #edb/ref 17592186277055} :answer-field/id #uuid "89ba9dfd-f03d-578b-831f-8a7946d17b7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277970}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b62215b7-0e69-5d45-8968-8bb0a1bc12ef" :question/math-academy-id "q-161131" :question/problem "$$\n{∬}_{D}\\boxed{}\\,\\text{d}A,\\,D=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le 2\\}\n$$\n\nThe integral above gives the surface area of $z={y}^{2}-{x}^{3}$ for $0\\le x\\le 1$ and $0\\le y\\le 2.$ What is the missing expression?" :question/worked-solution "For a surface $S$ defined by $z=f(x,y)$ with $(x,y)\\in D,$ the surface area of $S$ is given by\n\n$$\n{∬}_{S}\\,\\text{d}S={∬}_{D}\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A.\n$$\n\nIn this case, our surface is given by\n\n$$\nz={y}^{2}-{x}^{3},\\,0\\le x\\le 1,\\,0\\le y\\le 2.\n$$\n\nNow, since\n\n$$\n\\begin{aligned}\\frac{∂z}{∂x} & =\\frac{∂}{∂x}({y}^{2}-{x}^{3})=-3{x}^{2}, \\\\ \\frac{∂z}{∂y} & =\\frac{∂}{∂y}({y}^{2}-{x}^{3})=2y,\\end{aligned}\n$$\n\nthe surface area is given by\n\n$$\n\\begin{aligned}{∬}_{S}\\,\\text{d}S & ={∬}_{D}\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+{(-3{x}^{2})}^{2}+{(2y)}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+9{x}^{4}+4{y}^{2}}\\,\\text{d}A.\\end{aligned}\n$$\n\nTherefore, the correct answer is $\\sqrt{1+9{x}^{4}+4{y}^{2}}.$"}]
