5{x}^{-1/5}+C \\\\  & =-\\frac{5}{{x}^{1/5}}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186502954 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34391ca3-ad98-50ce-8e1e-44cb8eade4a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}x^{-4/5} + C" :db/id #edb/ref 17592186502886} {:answer/id #uuid "401ae6af-30db-5402-a6f2-7d26f4d47d36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{5}x^{-14/5} + C" :db/id #edb/ref 17592186502897} {:answer/id #uuid "5b7281c4-4d4b-5557-8aaa-96752cd38280" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}x^{-9/5} + C" :db/id #edb/ref 17592186502910} {:answer/id #uuid "c4952ea7-4ee5-5ad8-9fff-3d99d83b3d92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{5}x^{-4/5} + C" :db/id #edb/ref 17592186502947} {:answer/id #uuid "ccdc31d2-bc17-5147-b336-7e1539023d9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}x^{-4/5} + C" :db/id #edb/ref 17592186502949}] :answer-field/correct {:answer/id #uuid "ccdc31d2-bc17-5147-b336-7e1539023d9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}x^{-4/5} + C" :db/id #edb/ref 17592186502949} :answer-field/id #uuid "71958d00-8def-5201-b349-02ba63662a31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502918}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "de2aa536-e15f-5af4-b511-e0e4c9d378a1" :question/problem "Given that $f(x)=\\frac{1}{{x}^{9/5}}$ and that ${F}^{'}(x)=f(x)$, calculate $F(x).$ Assume $x>0$." :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nNote that $\\frac{1}{{x}^{9/5}}={x}^{-9/5}.$ So, we can use the power rule with $n=-\\frac{9}{5}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{-9/5}\\,\\text{d}x \\\\  & =\\frac{{x}^{-9/5+1}}{(-\\frac{9}{5}+1)}+C \\\\  & =\\frac{{x}^{-4/5}}{\\left(-\\frac{4}{5}\\right)}+C \\\\  & =-\\frac{5}{4}{x}^{-4/5}+C \\\\  & =-\\frac{5}{4{x}^{4/5}}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503661 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55a6fcca-aad9-5ad1-a121-fdaf665d5aad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186503145} {:answer/id #uuid "d92f70d4-3067-5353-97b7-e64c25a54de0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186503415} {:answer/id #uuid "dcb302e9-c203-5981-98a6-1abb4868178a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186503427} {:answer/id #uuid "e0db71b8-ad73-5cce-b817-b4e5c4f03d39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186503441} {:answer/id #uuid "ecb895ed-3b69-53d2-9ba7-f858762d5ad6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186503466}] :answer-field/correct {:answer/id #uuid "dcb302e9-c203-5981-98a6-1abb4868178a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186503427} :answer-field/id #uuid "fbaaab81-294e-5a37-9fb1-b73c2d58a5c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503643}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1a235d31-7002-5190-8de9-b78ca920ac5f" :question/math-academy-id "q-67425" :question/problem "Solve the equation $-\\frac{3}{x}=\\frac{9}{3x-1}.$" :question/worked-solution "First, we note that\n\n- $x=0$ cannot be a solution since this would make the denominator on the left-hand side zero\n\n- $x=\\frac{1}{3}$ cannot be a solution since this would make the denominator on the right-hand side zero\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n-\\frac{x}{3}=\\frac{3x-1}{9}\n$$\n\nNext, we write both fractions using the least common denominator $9.$ The above equation becomes\n\n$$\n-\\frac{3x}{9}=\\frac{3x-1}{9}.\n$$\n\nWe can now solve this equation with the addition and the multiplication principles:\n\n$$\n\\begin{aligned}(-9)\\cdot \\frac{3x}{-9} & =(-9)\\cdot \\frac{3x-1}{9} \\\\ 3x & =(-1)\\cdot (3x-1) \\\\ 3x & =1-3x \\\\ 3x+3x & =1-3x+3x \\\\ 6x & =1 \\\\ \\left(\\frac{1}{6}\\right)\\cdot 6x & =\\left(\\frac{1}{6}\\right)\\cdot 1 \\\\ x & =\\frac{1}{6}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503663 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4825a0cb-b3fb-5323-8a58-511f26bf6c7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2(y-2)}{x+1}" :db/id #edb/ref 17592186503116} {:answer/id #uuid "6c6a63f8-ed2d-5275-9398-6d460d70e710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4(x+1)}{y-2}" :db/id #edb/ref 17592186503196} {:answer/id #uuid "7dfcca81-3430-5271-8cd0-80e5d2035124" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y-2}{4(x+1)}" :db/id #edb/ref 17592186503241} {:answer/id #uuid "c5c781b7-f9f3-553f-b0be-cf3d3b1d44f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x+1}{4(y-2)}" :db/id #edb/ref 17592186503376} {:answer/id #uuid "f7b72652-cf0b-559e-99bc-226911189b88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+1}{2(y-2)}" :db/id #edb/ref 17592186503487}] :answer-field/correct {:answer/id #uuid "c5c781b7-f9f3-553f-b0be-cf3d3b1d44f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x+1}{4(y-2)}" :db/id #edb/ref 17592186503376} :answer-field/id #uuid "88db5750-a4d8-5c4f-b26f-ef8a62130a02" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503582}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1e5b95a8-8914-5efe-a3ab-4b5dce1c8cbe" :question/math-academy-id "q-127521" :question/problem "![](images/e7/e74f96531b57a877b043ac4302adae6beef90dc24d64efc8e1a24b563e4738b7.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the ellipse shown above." :question/worked-solution "Since our ellipse is centered at $(-1,2)$ and has semiaxes $4$ and $2,$ its equation is given by\n\n$$\n\\frac{(x-(-1))^{2}}{{4}^{2}}+\\frac{(y-2)^{2}}{{2}^{2}}=1\\,⟹\\,\\frac{(x+1)^{2}}{16}+\\frac{(y-2)^{2}}{4}=1.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{(x+1)^{2}}{16}+\\frac{(y-2)^{2}}{4}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{(x+1)^{2}}{16}\\right)+\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{(y-2)^{2}}{4}\\right) & =0 \\\\ \\frac{2(x+1)}{16}+\\frac{2(y-2)}{4}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ \\frac{y-2}{2}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x+1}{8} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x+1}{4(y-2)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503669 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c9a8d86-2ffd-5e45-8af5-dbc5542af39b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\operatorname{ln}⁡\\left(\\frac{1}{2}\\right)" :db/id #edb/ref 17592186503012} {:answer/id #uuid "90c9d555-99b8-53e3-88c7-b225b4935425" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\operatorname{ln}⁡\\left(\\frac{3}{2}\\right)" :db/id #edb/ref 17592186503269} {:answer/id #uuid "b0cc92cf-53cb-5cf1-a4fe-3b86e44133f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\operatorname{ln}⁡\\left(\\frac{3}{4}\\right)" :db/id #edb/ref 17592186503339} {:answer/id #uuid "d9a928d8-001f-5b4e-b2db-218ec5e4289a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\operatorname{ln}⁡\\left(\\frac{1}{2}\\right),\\,x=\\operatorname{ln}⁡2" :db/id #edb/ref 17592186503417} {:answer/id #uuid "fbdd1915-0f33-5496-97c5-b477aee6adf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\operatorname{ln}⁡2" :db/id #edb/ref 17592186503503}] :answer-field/correct {:answer/id #uuid "0c9a8d86-2ffd-5e45-8af5-dbc5542af39b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\operatorname{ln}⁡\\left(\\frac{1}{2}\\right)" :db/id #edb/ref 17592186503012} :answer-field/id #uuid "9a59f508-2043-5fd3-9b05-0601035dc322" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503591}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "28cd517a-376e-5db1-863f-bc38045c2ab7" :question/math-academy-id "q-138921" :question/problem "Find the real solution to the equation $4\\operatorname{sinh}⁡x=-3.$" :question/worked-solution "The definition of $\\operatorname{sinh}⁡x$ is\n\n$$\n\\operatorname{sinh}⁡x=\\frac{1}{2}({e}^{x}-{e}^{-x}).\n$$\n\nSubstituting the above definition into the equation $4\\operatorname{sinh}⁡x=-3,$ we get\n\n$$\n\\begin{aligned}4\\cdot (\\frac{1}{2}({e}^{x}-{e}^{-x})) & =-3 \\\\ 2({e}^{x}-{e}^{-x}) & =-3 \\\\ 2{e}^{x}-2{e}^{-x} & =-3.\\end{aligned}\n$$\n\nNext, we multiply both sides of the equation by ${e}^{x},$ and simplify:\n\n$$\n\\begin{aligned}{e}^{x}\\cdot (2{e}^{x}-2{e}^{-x}) & ={e}^{x}\\cdot (-3) \\\\ 2{e}^{2x}-2 & =-3{e}^{x} \\\\ 2{e}^{2x}+3{e}^{x}-2 & =0\\end{aligned}\n$$\n\nThis is a quadratic equation in ${e}^{x}$ that we can factor as follows:\n\n$$\n\\begin{aligned}(2{e}^{x}-1)({e}^{x}+2) & =0\\end{aligned}\n$$\n\nBy the zero-product property, we have to solve two equations:\n\n$$\n2{e}^{x}-1=0,\\,{e}^{x}+2=0\n$$\n\nSolving the two equations above for $x,$ we get:\n\n$$\n\\begin{aligned}2{e}^{x}-1 & =0 &  & \\, & {e}^{x}+2 & =0 \\\\ {e}^{x} & =\\frac{1}{2} &  & \\, & {e}^{x} & =-2 \\\\ x & =\\operatorname{ln}⁡\\left(\\frac{1}{2}\\right) &  & \\, & \\end{aligned}\n$$\n\nThere are no real values of $x$ for which ${e}^{x}=-2.$ Therefore, $x=\\operatorname{ln}⁡\\left(\\frac{1}{2}\\right)$ is the only real solution to the equation."} {:db/id #edb/ref 17592186503684 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05d3d307-80c5-5100-8287-638a2bdecc60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186502991} {:answer/id #uuid "0cd1f877-23e8-59f2-a2aa-0744c5e7dd70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186503013} {:answer/id #uuid "33f90d44-4628-5b5e-b9c2-d33e90471828" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186503075} {:answer/id #uuid "5ef03d2c-7e33-54bd-ac16-3e50ecf310c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186503166} {:answer/id #uuid "ebd6e3e2-7e5b-5a15-8a25-1e78f2e97115" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186503463}] :answer-field/correct {:answer/id #uuid "ebd6e3e2-7e5b-5a15-8a25-1e78f2e97115" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186503463} :answer-field/id #uuid "44ae6554-557c-5337-b681-7691c583fdd1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503541}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "528cc092-636b-5bd7-9846-07908de9113d" :question/math-academy-id "q-67416" :question/problem "Solve the equation $\\frac{2}{x-2}=4.$" :question/worked-solution "First, we note that $x=2$ cannot be a solution since this would make the denominator on the left-hand side zero.\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n\\frac{x-2}{2}=\\frac{1}{4}\n$$\n\nWe can now solve this equation using the multiplication and the addition principles:\n\n$$\n\\begin{aligned}(2)\\cdot \\left(\\frac{x-2}{2}\\right) & =2\\cdot \\left(\\frac{1}{4}\\right) \\\\ (\\cancel{2})\\cdot \\left(\\frac{x-2}{\\cancel{2}}\\right) & =\\frac{2}{4} \\\\ x-2 & =\\frac{1}{2} \\\\ x-2+2 & =\\frac{1}{2}+2 \\\\ x & =\\frac{5}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503687 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4bc45995-cc23-5f2f-95dc-adb53fd70390" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{e}" :db/id #edb/ref 17592186503122} {:answer/id #uuid "7d02c22e-415b-580d-b404-ffc0a846300a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{9}" :db/id #edb/ref 17592186503238} {:answer/id #uuid "9b48a15c-7746-52d0-ab31-148949b28472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e}{3}" :db/id #edb/ref 17592186503291} {:answer/id #uuid "a689aded-b802-5144-9786-711cd58ea390" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-3}" :db/id #edb/ref 17592186503317} {:answer/id #uuid "b1c13605-3b15-5441-9ad6-991d71ce870e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3}" :db/id #edb/ref 17592186503342}] :answer-field/correct {:answer/id #uuid "b1c13605-3b15-5441-9ad6-991d71ce870e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3}" :db/id #edb/ref 17592186503342} :answer-field/id #uuid "c41454b8-a54a-5924-9bf1-be03ac5b4d5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503612}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "55d1a1bd-c8eb-5ee7-88d6-a44ae7dc2c96" :question/math-academy-id "q-118710" :question/problem "Evaluate ${lim}_{x\\to \\infty }{\\left(\\frac{x}{x-1}\\right)}^{3x-3}.$" :question/worked-solution "Notice that as $x\\to \\infty ,$ \n\n- the expression inside the parentheses approaches $1,$ while\n\n- the exponent approaches $\\infty .$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n{lim}_{x\\to \\infty }{\\left(\\frac{x}{x-1}\\right)}^{3x-3}={1}^{\\infty },\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n{lim}_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}=e\n$$\n\nWe rewrite the given limit as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }{\\left(\\frac{x}{x-1}\\right)}^{3x-3} & ={lim}_{x\\to \\infty }{\\left(\\frac{(x-1)+1}{x-1}\\right)}^{3x-3} \\\\  & ={lim}_{x\\to \\infty }{(1+\\frac{1}{x-1})}^{3(x-1)}\\end{aligned}\n$$\n\nLet $x-1=n.$ Therefore, since $n\\to \\infty $ as $x\\to \\infty ,$ we rewrite the limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }{\\left(\\frac{x}{x-1}\\right)}^{3x-3} & ={lim}_{x\\to \\infty }{(1+\\frac{1}{x-1})}^{3(x-1)} \\\\  & ={lim}_{n\\to \\infty }{(1+\\frac{1}{n})}^{3n} \\\\  & ={lim}_{n\\to \\infty }{[{(1+\\frac{1}{n})}^{n}]}^{3} \\\\  & ={[{lim}_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}]}^{3} \\\\  & ={e}^{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503706 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30bc81e6-8fff-54e2-ac15-49e3fb530116" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186503070} {:answer/id #uuid "7ff51bff-7de4-5253-9d95-cedff81705fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186503245} {:answer/id #uuid "8d0aa041-1831-5a03-87fe-4c02c07d7e82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186503266} {:answer/id #uuid "a0dc91f3-4ee3-57a4-8547-157373bab8fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186503304} {:answer/id #uuid "d8fd723a-f248-5a39-96ba-76e1a1a6935a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186503413}] :answer-field/correct {:answer/id #uuid "7ff51bff-7de4-5253-9d95-cedff81705fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186503245} :answer-field/id #uuid "7c930558-3f13-59ed-984d-aa81dfac2ac2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503571}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7e3eaae0-125c-585a-90f2-bbc8b4da35cd" :question/math-academy-id "q-106354" :question/problem "Solve the equation $\\frac{1}{x+5}=\\frac{3}{2x+12}.$" :question/worked-solution "First, we note that\n\n- $x=-5$ cannot be a solution since this would make the denominator on the left-hand side zero\n\n- $x=-6$ cannot be a solution since this would make the denominator on the right-hand side zero\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n\\frac{x+5}{1}=\\frac{2x+12}{3}\n$$\n\nNext, we write both fractions using the least common denominator, $3.$ We get\n\n$$\n\\frac{3x+15}{3}=\\frac{2x+12}{3}.\n$$\n\nWe can now solve this equation with the addition and the multiplication principles:\n\n$$\n\\begin{aligned}3\\cdot \\left(\\frac{3x+15}{3}\\right) & =3\\cdot \\left(\\frac{2x+12}{3}\\right) \\\\ 3x+15 & =2x+12 \\\\ 3x-2x & =12-15 \\\\ x & =-3\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503715 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62c728d8-29c1-5f90-a9bc-17eae1a900d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186503171} {:answer/id #uuid "7733ee4f-eef5-5fd6-a757-f34e447b3828" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186503219} {:answer/id #uuid "80d7c6b7-28c9-5bea-bee5-7bb87f769d99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186503246} {:answer/id #uuid "c044e13e-665f-594c-8087-19c0c493d990" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186503366} {:answer/id #uuid "da440c13-f203-5583-aa96-40df058f74cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186503418}] :answer-field/correct {:answer/id #uuid "62c728d8-29c1-5f90-a9bc-17eae1a900d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186503171} :answer-field/id #uuid "d1354d1c-de34-5200-8c22-d682a6a448d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503621}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9423a212-cd5b-5be8-a581-5c447b673232" :question/math-academy-id "q-67407" :question/problem "Solve the equation $\\frac{4}{5}=\\frac{4}{3x}.$" :question/worked-solution "First, we note that $x=0$ cannot be a solution since this would make the denominator on the right-hand side zero.\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n\\frac{5}{4}=\\frac{3x}{4}\n$$\n\nWe can now solve this equation using the multiplication principle:\n\n$$\n\\begin{aligned}\\frac{5}{4} & =\\frac{3x}{4} \\\\ 4\\cdot \\frac{5}{4} & =4\\cdot \\frac{3x}{4} \\\\ \\cancel{4}\\cdot \\frac{5}{\\cancel{4}} & =\\cancel{4}\\cdot \\frac{3x}{\\cancel{4}} \\\\ 5 & =3x \\\\ \\left(\\frac{1}{3}\\right)\\cdot 5 & =\\left(\\frac{1}{3}\\right)\\cdot (3x) \\\\ \\frac{5}{3} & =\\cancel{\\frac{1}{3}}\\cdot (\\cancel{3}x) \\\\ \\frac{5}{3} & =x\\end{aligned}\n$$\n\nWe conclude that the solution is $x=\\frac{5}{3}.$"} {:db/id #edb/ref 17592186503717 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be416ad7-fa5c-5f2a-8f8e-5c23bca4c530" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{\\frac{2k}{3}}-1" :db/id #edb/ref 17592186503362}] :answer-field/correct {:answer/id #uuid "be416ad7-fa5c-5f2a-8f8e-5c23bca4c530" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{\\frac{2k}{3}}-1" :db/id #edb/ref 17592186503362} :answer-field/id #uuid "e28fb333-812f-5331-bf83-e683ff5050d2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186503628}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "957cf846-05af-527e-b9b5-8a808e2c175e" :question/math-academy-id "q-342677" :question/problem "Simplify $tanh\\,\\left(\\frac{k}{3}\\right)$ in terms of $e$ using the definition of the hyperbolic tangent.\n\n$tanh\\,\\left(\\frac{k}{3}\\right)=$\n\n| {{field-1}} |\n| --- |\n| ${e}^{2k/3}+1$ |" :question/worked-solution "The definition of $\\operatorname{tanh}⁡x$ is\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the second definition, we get\n\n$$\n\\begin{aligned}tanh\\,\\left(\\frac{k}{3}\\right) & =\\frac{{e}^{2(k/3)}-1}{{e}^{2(k/3)}+1} \\\\  & =\\frac{{e}^{2k/3}-1}{{e}^{2k/3}+1}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503718 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07554fcf-2e2c-5e04-b659-229769d5a42f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{z}^{2}-1}{{z}^{2}}" :db/id #edb/ref 17592186502996} {:answer/id #uuid "59dc9393-aba4-55f1-a33b-edbc6a5c7c71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{z}^{4}-1}{2{z}^{2}}" :db/id #edb/ref 17592186503154} {:answer/id #uuid "c9ac03e5-f4b2-5887-ba43-a82100a8936e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{z}^{4}+1}{2{z}^{2}}" :db/id #edb/ref 17592186503384} {:answer/id #uuid "cef8d180-cb9e-5d9e-bd31-7ec2446df85d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{z}^{2}-1}{4{z}^{2}}" :db/id #edb/ref 17592186503395} {:answer/id #uuid "ed0f0085-d2a8-5d8d-9d1f-f807dca76f30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{z}^{2}+1}{{z}^{2}}" :db/id #edb/ref 17592186503467}] :answer-field/correct {:answer/id #uuid "59dc9393-aba4-55f1-a33b-edbc6a5c7c71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{z}^{4}-1}{2{z}^{2}}" :db/id #edb/ref 17592186503154} :answer-field/id #uuid "1c5c7ef5-8ca5-5c12-9d79-8a62b31c25ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503531}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "958048ce-f9d1-5782-ad7f-1bcc0753619d" :question/math-academy-id "q-95492" :question/problem "Given that $z>0,$ which of the following is equivalent to $\\operatorname{sinh}⁡(2\\operatorname{ln}⁡z)?$" :question/worked-solution "The definition of $\\operatorname{sinh}⁡x$ is \n\n$$\n\\operatorname{sinh}⁡x=\\frac{1}{2}({e}^{x}-{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sinh}⁡(2\\operatorname{ln}⁡z) & =\\frac{1}{2}({e}^{2\\operatorname{ln}⁡z}-{e}^{-2\\operatorname{ln}⁡z}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡{z}^{2}}-{e}^{\\operatorname{ln}⁡{z}^{-2}}) \\\\  & =\\frac{1}{2}({z}^{2}-{z}^{-2}) \\\\  & =\\frac{1}{2}({z}^{2}-\\frac{1}{{z}^{2}}) \\\\  & =\\frac{1}{2}\\left(\\frac{{z}^{4}-1}{{z}^{2}}\\right) \\\\  & =\\frac{{z}^{4}-1}{2{z}^{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503719 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17d5d01a-8c9a-52fd-8938-cc2f51a738d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\left(e^{-\\frac{3x}{4}}+e^{\\frac{3x}{4}}\\right)" :db/id #edb/ref 17592186503030}] :answer-field/correct {:answer/id #uuid "17d5d01a-8c9a-52fd-8938-cc2f51a738d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\left(e^{-\\frac{3x}{4}}+e^{\\frac{3x}{4}}\\right)" :db/id #edb/ref 17592186503030} :answer-field/id #uuid "4e34ca8a-375e-57fa-86d3-0c1d705c1138" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186503544}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "98232048-0528-5aa4-8a77-d211e3369a57" :question/math-academy-id "q-300746" :question/problem "Express $\\operatorname{cosh}⁡\\left(-\\frac{3x}{4}\\right)$ in terms of $e$ using the definition of the hyperbolic cosine.\n\n$\\operatorname{cosh}⁡\\left(-\\frac{3x}{4}\\right)=$\n{{field-1}}" :question/worked-solution "The definition of $\\operatorname{cosh}⁡x$ is\n\n$$\n\\operatorname{cosh}⁡x=\\frac{1}{2}({e}^{x}+{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡\\left(-\\frac{3x}{4}\\right) & =\\frac{1}{2}({e}^{-3x/4}+{e}^{-(-3x/4)}) \\\\  & =\\frac{1}{2}({e}^{-3x/4}+{e}^{3x/4}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503737 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71d7d57f-eadd-59fa-9fed-90fc5e33c3bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{-3/2}" :db/id #edb/ref 17592186503212}] :answer-field/correct {:answer/id #uuid "71d7d57f-eadd-59fa-9fed-90fc5e33c3bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{-3/2}" :db/id #edb/ref 17592186503212} :answer-field/id #uuid "50e1d1c8-31e4-5631-aa5f-e93437d60a0a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186503545}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "be80c98f-2a34-525c-9b0c-3079917fdbf6" :question/math-academy-id "q-342759" :question/problem "Evaluate $sinh\\,\\left(\\frac{3}{2}\\right).$ **Do not round** your answer.\n\n$\\operatorname{sinh}⁡\\left(\\frac{3}{2}\\right)=\\frac{1}{2}({e}^{3/2}\\,-$ {{field-1}} $)$" :question/worked-solution "The definition of $\\operatorname{sinh}⁡x$ is \n\n$$\n\\operatorname{sinh}⁡x=\\frac{1}{2}({e}^{x}-{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}sinh\\,\\left(\\frac{3}{2}\\right) & =\\frac{1}{2}({e}^{3/2}-{e}^{-3/2}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503740 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12c051ac-16d1-53b0-af08-3845e1f80fcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186503020} {:answer/id #uuid "716a5576-1477-5d48-9fac-ce2b26ac1535" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=9" :db/id #edb/ref 17592186503210} {:answer/id #uuid "c22ddc25-362a-57ac-b9a3-be8479d6a75e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{3}{2}" :db/id #edb/ref 17592186503371} {:answer/id #uuid "d43bf7b4-779c-5786-81da-db083c00f923" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1" :db/id #edb/ref 17592186503403} {:answer/id #uuid "fe457f6b-9fd9-5669-9e55-7cc5d248f357" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186503507}] :answer-field/correct {:answer/id #uuid "12c051ac-16d1-53b0-af08-3845e1f80fcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186503020} :answer-field/id #uuid "8358f70b-40f4-51c5-ad82-e863f6db2422" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503579}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c664e1c1-92ad-575b-bafc-9b1ddd2a888d" :question/math-academy-id "q-35762" :question/problem "Find the horizontal asymptote of the function $f(x)=\\frac{9}{{x}^{2}-6}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{9}{{x}^{2}-6} \\\\  & ={lim}_{x\\to \\infty }\\frac{\\left(\\frac{9}{{x}^{2}}\\right)}{(\\frac{{x}^{2}}{{x}^{2}}-\\frac{6}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{\\left(\\frac{9}{{x}^{2}}\\right)}{(1-\\frac{6}{{x}^{2}})} \\\\  & =\\frac{0}{1-0} \\\\  & =0.\\end{aligned}\n$$\n\n \n\nTherefore, the horizontal asymptote of $f(x)$ is $y=0.$"} {:db/id #edb/ref 17592186503745 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b600bcd-5006-5baf-9dca-4aab5033031d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{32}+\\frac{25y}{8}+125{y}^{2}" :db/id #edb/ref 17592186503008} {:answer/id #uuid "4c839c43-5c26-510d-85ac-e2e3c39a216c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{32}+\\frac{25y}{4}+145{y}^{2}" :db/id #edb/ref 17592186503128} {:answer/id #uuid "4fb998d5-d716-53e2-a50b-72e1271eb277" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{32}+\\frac{25y}{8}-100{y}^{2}" :db/id #edb/ref 17592186503133} {:answer/id #uuid "5135b701-cd58-5dde-8d9b-989995318cb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{32}+\\frac{25y}{4}+100{y}^{2}" :db/id #edb/ref 17592186503136} {:answer/id #uuid "9799692b-0119-5014-ae4f-3ef5e9145c63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{32}+\\frac{25y}{8}+145{y}^{2}" :db/id #edb/ref 17592186503281}] :answer-field/correct {:answer/id #uuid "0b600bcd-5006-5baf-9dca-4aab5033031d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{32}+\\frac{25y}{8}+125{y}^{2}" :db/id #edb/ref 17592186503008} :answer-field/id #uuid "ef1b5443-9d42-51aa-ac69-73ecc6958d74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503635}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d6a9fa51-d96f-5308-9675-af7e9df7f105" :question/math-academy-id "q-3563" :question/problem "Find, in ascending powers of $y,$ the first three terms of the binomial expansion of ${(10y+\\frac{1}{2})}^{5}.$" :question/worked-solution "First, let's compare our expression with the binomial\n\n$$\n(a+b)^{n}.\n$$\n\nHere we have that $n=5,$ $a=10y,$ and $b=\\frac{1}{2}.$ So, the exponents of the binomial expansion must follow the pattern\n\n$$\n{a}^{5}{b}^{0},\\,{a}^{4}{b}^{1},\\,{a}^{3}{b}^{2},\\,{a}^{2}{b}^{3},\\,{a}^{1}{b}^{4},\\,{a}^{0}{b}^{5}.\n$$\n\nThe $5$th row in Pascal's Triangle is $(1,5,10,10,5,1).$ Therefore,\n\n$$\n\\begin{aligned}{(10y+\\frac{1}{2})}^{5} & =1{a}^{5}+5{a}^{4}b+10{a}^{3}{b}^{2}+10{a}^{2}{b}^{3}+5a{b}^{4}+1{b}^{5} \\\\  & =1(10y)^{5}{\\left(\\frac{1}{2}\\right)}^{0}+5(10y)^{4}{\\left(\\frac{1}{2}\\right)}^{1}+10(10y)^{3}{\\left(\\frac{1}{2}\\right)}^{2} \\\\  & \\,+10(10y)^{2}{\\left(\\frac{1}{2}\\right)}^{3}+5(10y)^{1}{\\left(\\frac{1}{2}\\right)}^{4}+1(10y)^{0}{\\left(\\frac{1}{2}\\right)}^{5} \\\\  & =1(100\\,000{y}^{5})(1)+5(10\\,000{y}^{4})\\left(\\frac{1}{2}\\right)+10(1\\,000{y}^{3})\\left(\\frac{1}{4}\\right) \\\\  & \\,+10(100{y}^{2})\\left(\\frac{1}{8}\\right)+5(10y)\\left(\\frac{1}{16}\\right)+1(1)\\left(\\frac{1}{32}\\right) \\\\  & =100\\,000{y}^{5}+\\frac{50\\,000{y}^{4}}{2}+\\frac{10\\,000{y}^{3}}{4}+\\frac{1\\,000{y}^{2}}{8}+\\frac{50y}{16}+\\frac{1}{32} \\\\  & =100\\,000{y}^{5}+25\\,000{y}^{4}+2\\,500{y}^{3}+125{y}^{2}+\\frac{25y}{8}+\\frac{1}{32}.\\end{aligned}\n$$\n\nFinally, in ascending powers of $y$, the first three terms are\n\n$$\n\\frac{1}{32}+\\frac{25y}{8}+125{y}^{2}.\n$$"} {:db/id #edb/ref 17592186503752 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a3886a5-1d7a-5ca7-8738-12d8ef255d94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+\\sqrt{e}}{1-\\sqrt{e}}" :db/id #edb/ref 17592186503120} {:answer/id #uuid "79feb6a3-fd63-5722-bf1a-1b17b2a99447" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186503231} {:answer/id #uuid "993d1f00-a0df-5f47-8016-9bb479cdc26d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+e}{1-e}" :db/id #edb/ref 17592186503285} {:answer/id #uuid "c8cb142d-3a7c-5922-acfe-51b1201c66ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-e}{1+e}" :db/id #edb/ref 17592186503380} {:answer/id #uuid "d3b2a103-ca01-59e5-8aa6-8e7ebc6ce6cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-\\sqrt{e}}{1+\\sqrt{e}}" :db/id #edb/ref 17592186503401}] :answer-field/correct {:answer/id #uuid "c8cb142d-3a7c-5922-acfe-51b1201c66ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-e}{1+e}" :db/id #edb/ref 17592186503380} :answer-field/id #uuid "3878f530-02bd-58fa-8a92-0929a7b051c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503538}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ea77914f-6e86-5cb0-a566-942e82f36dc8" :question/math-academy-id "q-95601" :question/problem "$\\operatorname{tanh}⁡\\left(-\\frac{1}{2}\\right)=$" :question/worked-solution "The definition of $\\operatorname{tanh}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the third definition, we get\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡\\left(-\\frac{1}{2}\\right) & =\\frac{1-{e}^{-2(-1/2)}}{1+{e}^{-2(-1/2)}} \\\\  & =\\frac{1-e}{1+e}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503848 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d6ad986-0c26-5cd6-9cd3-04a7be56d694" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{6}}{7}+C" :db/id #edb/ref 17592186503846} {:answer/id #uuid "4ec8b324-f032-547f-97d9-6c73f80f4440" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{7}+C" :db/id #edb/ref 17592186503850} {:answer/id #uuid "7fe67df0-46d1-5acd-abf6-e732a8688e8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{8}+C" :db/id #edb/ref 17592186503855} {:answer/id #uuid "b8b1f0d3-bec7-598d-ba2e-a3f438f06ce3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7x^{7}+C" :db/id #edb/ref 17592186503868} {:answer/id #uuid "fa59a2a3-a8ed-5b0b-abda-91a9bba04e9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{7}}{7}+C" :db/id #edb/ref 17592186503875}] :answer-field/correct {:answer/id #uuid "fa59a2a3-a8ed-5b0b-abda-91a9bba04e9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{7}}{7}+C" :db/id #edb/ref 17592186503875} :answer-field/id #uuid "b67f2104-8e47-50cd-b752-fad1aa17e5ed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503867}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4194dc2e-82ad-5109-91f4-d383eed4b18e" :question/problem "Calculate $\\int {x}^{6}\\,\\text{d}x.$" :question/worked-solution "We apply the power rule with $n=6$, and we get\n\n$$\n\\int {x}^{6}\\,\\text{d}x=\\frac{{x}^{6+1}}{6+1}+C=\\frac{{x}^{7}}{7}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{7}}{7}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{7}}{7}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{7}\\frac{\\text{d}}{\\text{d}x}({x}^{7})+0 \\\\ &= \\frac{1}{7}\\cdot 7{x}^{6} \\\\ &= {x}^{6}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503851 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b9bd22-8b41-542b-82ba-62e400af4a02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{8} + C" :db/id #edb/ref 17592186503842} {:answer/id #uuid "0b7b7de0-eaf8-57d9-8475-c23f72194dd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8x^{8}" :db/id #edb/ref 17592186503844} {:answer/id #uuid "a5bb73e6-3ec8-51dd-ad3b-1cd6d6243b7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8 + C" :db/id #edb/ref 17592186503862} {:answer/id #uuid "b52194ac-60ec-5ec7-