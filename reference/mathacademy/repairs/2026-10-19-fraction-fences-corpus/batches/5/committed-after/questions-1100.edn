c{\\sqrt{2}}{2} & \\frac{2}{5} & - \\sqrt{2} \\\\ \\frac{\\sqrt{2}}{2} & \\frac{4}{5} & \\frac{3 \\sqrt{2}}{2} \\\\ - \\frac{3 \\sqrt{2}}{4} & \\frac{2}{5} & - \\frac{\\sqrt{2}}{2}\\end{aligned}| \\\\  & =\\left(- \\frac{\\sqrt{2}}{2}\\right)|\\begin{aligned}\\frac{4}{5} & \\frac{3 \\sqrt{2}}{2} \\\\ \\frac{2}{5} & - \\frac{\\sqrt{2}}{2}\\end{aligned}|+\\left(- \\frac{2}{5}\\right)|\\begin{aligned}\\frac{\\sqrt{2}}{2} & \\frac{3 \\sqrt{2}}{2} \\\\ - \\frac{3 \\sqrt{2}}{4} & - \\frac{\\sqrt{2}}{2}\\end{aligned}|+(- \\sqrt{2})|\\begin{aligned}\\frac{\\sqrt{2}}{2} & \\frac{4}{5} \\\\ - \\frac{3 \\sqrt{2}}{4} & \\frac{2}{5}\\end{aligned}| \\\\  & =\\left(- \\frac{\\sqrt{2}}{2}\\right)(- \\frac{2 \\sqrt{2}}{5}- \\frac{3 \\sqrt{2}}{5})+\\left(- \\frac{2}{5}\\right)(- \\frac{1}{2}+\\frac{9}{4})+(- \\sqrt{2})(\\frac{\\sqrt{2}}{5}+\\frac{3 \\sqrt{2}}{5}) \\\\  & =\\left(- \\frac{\\sqrt{2}}{2}\\right)\\cdot (- \\sqrt{2})+\\left(- \\frac{2}{5}\\right)\\cdot \\frac{7}{4}+(- \\sqrt{2})\\cdot \\frac{4 \\sqrt{2}}{5} \\\\  & =1- \\frac{7}{10}- \\frac{8}{5} \\\\  & =- \\frac{13}{10}\\end{aligned}\n$$\n\nSince $det(R)=- \\frac{13}{10}\\ne 0$, the matrix is **not** singular. \n\nTherefore, only statement “$R$ is **not** a singular matrix” is true."} {:db/id #edb/ref 17592186529220 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f10ee21-6b89-5e0f-a04a-e49bcfa4c907" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529218} {:answer/id #uuid "fe16b8a0-13d3-5554-8edd-ff60470da1a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529255}] :answer-field/correct {:answer/id #uuid "fe16b8a0-13d3-5554-8edd-ff60470da1a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529255} :answer-field/id #uuid "283cd5ed-404d-513a-8b29-74966f63a5de" :answer-field/key "$D$ is **no