 :answer-field.type/select} :db/id #edb/ref 17592186522584} {:answer-field/choices [{:answer/id #uuid "33ddc21f-7e7b-50ee-9358-1aa4cfe9ea84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1)^{n}" :db/id #edb/ref 17592186522135} {:answer/id #uuid "c4a5d271-a082-52cc-b59c-a8d7a6852f6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1)^{n+1}" :db/id #edb/ref 17592186522430} {:answer/id #uuid "dd21a3dd-c95f-569a-b81d-f3400fccdd77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186522480} {:answer/id #uuid "ef289e17-8821-5fba-bd64-4b54b677eb1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186522530}] :answer-field/correct {:answer/id #uuid "dd21a3dd-c95f-569a-b81d-f3400fccdd77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186522480} :answer-field/id #uuid "ccf42bc2-7de5-54af-91ad-b973a99aeb58" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186522654} {:answer-field/choices [{:answer/id #uuid "66779975-74ee-50cf-a35c-645d398b77e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1)^{n}" :db/id #edb/ref 17592186522231} {:answer/id #uuid "b5aa77fe-dec0-5160-8a2e-1b65c8cb3c51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186522392} {:answer/id #uuid "c18abbb0-d30b-551c-9178-0ec9bf716e5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1)^{n+1}" :db/id #edb/ref 17592186522421} {:answer/id #uuid "e69ac2ef-dd0e-5e72-9a1f-61bf0d3b2e89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186522513}] :answer-field/correct {:answer/id #uuid "c18abbb0-d30b-551c-9178-0ec9bf716e5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1)^{n+1}" :db/id #edb/ref 17592186522421} :answer-field/id #uuid "d1467dc5-08ea-5550-9843-e23f5fff69d8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186522659}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b0fd3313-c314-58d3-a500-207bbe04cd58" :question/math-academy-id "q-343403" :question/problem "Consider the function $F(x)=x$ defined on $x\\in [-\\pi ,\\pi ).$ The Fourier series of the $2\\pi $-periodic extension $f(x)$ of $F(x)$ is given by\n\n$$\nf(x)∼2{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{n}\\operatorname{sin}⁡(nx).\n$$\n\nSelect the correct options in the reasoning below.\n\nAt $x=\\frac{\\pi }{2},$ we have\n\n$$\n\\operatorname{sin}⁡((2n-1)\\cdot \\frac{\\pi }{2})={{field-1}}.\n$$\n\nand\n\n$$\n\\operatorname{sin}⁡(2n\\cdot \\frac{\\pi }{2})={{field-2}}.\n$$\n\nSince $f(x)$ is \n{{field-3}}\nat $x=\\frac{\\pi }{2},$ the corresponding Fourier series converges to \n\n$$\nf(\\frac{\\pi }{2})={{field-4}}.\n$$\n\nTherefore, we have \n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{2n-1}={{field-5}}.\n$$" :question/worked-solution "First, we separate the Fourier series into its odd and even terms as follows:\n\n$$\nf(x)∼2{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot \\operatorname{sin}⁡((2n-1)x)-2{\\sum }_{n=1}^{\\infty }\\frac{1}{2n}\\cdot \\operatorname{sin}⁡(2nx).\n$$\n\nNow, notice that at $x=\\frac{\\pi }{2},$ we have\n\n$$\n\\operatorname{sin}⁡((2n-1)\\cdot \\frac{\\pi }{2})=(-1)^{n+1}.\n$$\n\nand\n\n$$\n\\operatorname{sin}⁡(2n\\cdot \\frac{\\pi }{2})=0.\n$$\n\nSince $f(x)$ is $\\text{continuous}$ at $x=\\frac{\\pi }{2},$ the corresponding Fourier series converges to \n\n$$\nf(\\frac{\\pi }{2})=\\frac{\\pi }{2}.\n$$\n\n \n\nTherefore, we have \n\n$$\n\\begin{aligned}f(\\frac{\\pi }{2}) & =2{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{n}\\cdot \\operatorname{sin}⁡(n\\cdot \\frac{\\pi }{2}) \\\\ \\frac{\\pi }{2} & =2{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot \\operatorname{sin}⁡((2n-1)\\cdot \\frac{\\pi }{2})-2{\\sum }_{n=1}^{\\infty }\\frac{1}{2n}\\cdot \\operatorname{sin}⁡(2n\\cdot \\frac{\\pi }{2}) \\\\ \\frac{\\pi }{2} & =2{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot (-1)^{n+1}-2{\\sum }_{n=1}^{\\infty }\\frac{1}{2n}\\cdot 0 \\\\ \\frac{\\pi }{4} & ={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{2n-1} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{2n-1} & =\\frac{\\pi }{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186522772 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4331b15a-72a2-5d98-9fc3-899e4d9a04fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{in}/\\text{min}" :db/id #edb/ref 17592186522166} {:answer/id #uuid "9832c67a-2d5f-5d3a-8360-50943f6ba6d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,\\text{in}/\\text{min}" :db/id #edb/ref 17592186522331} {:answer/id #uuid "dd65f9e7-be1f-50f3-829c-d1434e73e451" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\text{in}/\\text{min}" :db/id #edb/ref 17592186522481} {:answer/id #uuid "e9c3fe14-8f54-52bd-bfdb-9a39b3520805" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\text{in}/\\text{min}" :db/id #edb/ref 17592186522518} {:answer/id #uuid "f48115a9-c89d-51fa-b46a-7491efcdf077" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\text{in}/\\text{min}" :db/id #edb/ref 17592186522538}] :answer-field/correct {:answer/id #uuid "f48115a9-c89d-51fa-b46a-7491efcdf077" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\text{in}/\\text{min}" :db/id #edb/ref 17592186522538} :answer-field/id #uuid "94705966-f953-5894-bfa7-9571835bf295" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522632}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b3878760-f553-50af-9094-65f6b89b14da" :question/math-academy-id "q-116266" :question/problem "![](images/00/0060643c716e8f9c6d0420c419ba1d6efd7c3dc986279feb4ceae9f860dfb313.png)\n\nThe length of the rectangular prism shown above is increasing, while the $4\\,\\text{in}$ width and the $6\\,\\text{in}$ height don't change. What is the rate of change of the length of the rectangular prism if the volume is increasing at a rate of $72\\,{\\text{in}}^{3}/\\text{min}?$" :question/worked-solution "Let $x,y,z$ be the dimensions of the rectangular prism, let $V$ be its volume. We are given that \n\n$$\n\\begin{aligned}y & =4\\,\\text{in}, \\\\ z & =6\\,\\text{in}.\\end{aligned}\n$$\n\nAlso, we know that\n\n$$\n\\frac{\\text{d}V}{\\text{d}t}=72\\,{\\text{in}}^{3}/\\text{min}.\n$$\n\nWe would like to find $\\frac{\\text{d}x}{\\text{d}t}$ when $y=4\\,\\text{in}$ and $z=6\\,\\text{in}.$\n\nWe start with the formula for the volume of the rectangular prism:\n\n$$\nV=xyz\n$$\n\nSubstituting the known values, we get\n\n$$\nV=x(4)(6)=24x.\n$$\n\nNow, we differentiate with respect to time using the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(24x) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =24(\\frac{\\text{d}x}{\\text{d}t}).\\end{aligned}\n$$\n\nWe can now plug in the known value into the above expression. This gives\n\n$$\n\\begin{aligned}72 & =24(\\frac{\\text{d}x}{\\text{d}t}) \\\\ \\frac{\\text{d}x}{\\text{d}t} & =3\\,\\text{in}\\text{/min}.\\end{aligned}\n$$\n\nTherefore, the length of the rectangular prism is increasing at a rate of $3\\,\\text{in}/\\text{min}.$"} {:db/id #edb/ref 17592186522773 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4abc7cc7-9bf0-5283-ac11-c319f0ec887d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\pi " :db/id #edb/ref 17592186522177} {:answer/id #uuid "536ec464-0d2e-5e55-96c8-16aa8608d42f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40\\pi " :db/id #edb/ref 17592186522196} {:answer/id #uuid "a41c6868-e157-5d04-aa9d-c014ea5af847" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\pi " :db/id #edb/ref 17592186522362} {:answer/id #uuid "cf955368-f43e-5c39-80d9-5e7d42b2bb5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45\\pi " :db/id #edb/ref 17592186522450} {:answer/id #uuid "e4fa379f-90cd-5d9e-a43b-59665a54aa60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\pi " :db/id #edb/ref 17592186522507}] :answer-field/correct {:answer/id #uuid "e4fa379f-90cd-5d9e-a43b-59665a54aa60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\pi " :db/id #edb/ref 17592186522507} :answer-field/id #uuid "7b56249b-a83f-5c37-9b6c-4f290fe42129" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522618}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b48192d6-2f48-593d-8172-2cd990c8dfc7" :question/math-academy-id "q-107863" :question/problem "$\\frac{8}{3}\\sqrt{\\pi }\\,Γ(\\frac{7}{2})+\\frac{4}{3}\\sqrt{\\pi }\\,Γ(\\frac{5}{2})=$" :question/worked-solution "To evaluate the gamma function at multiples of one-half, we use the following recursive formula:\n\n$$\nΓ(z+1)=zΓ(z),\\,Γ(\\frac{1}{2})=\\sqrt{\\pi }\n$$\n\nSo, we have the following:\n\n$$\nΓ(\\frac{5}{2})=\\frac{3}{2}Γ(\\frac{3}{2})=\\frac{3}{2}\\cdot \\frac{1}{2}Γ(\\frac{1}{2})=\\frac{3}{2}\\cdot \\frac{1}{2}\\sqrt{\\pi }=\\frac{3}{4}\\sqrt{\\pi },\n$$\n\n$$\n\\begin{aligned}Γ(\\frac{7}{2})=\\frac{5}{2}Γ(\\frac{5}{2})=\\frac{5}{2}\\cdot \\frac{3}{4}\\sqrt{\\pi }=\\frac{15}{8}\\sqrt{\\pi }\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{8}{3}\\sqrt{\\pi }\\,Γ(\\frac{7}{2})+\\frac{4}{3}\\sqrt{\\pi }\\,Γ(\\frac{5}{2})=\\frac{8}{3}\\sqrt{\\pi }\\cdot \\frac{15}{8}\\sqrt{\\pi }+\\frac{4}{3}\\sqrt{\\pi }\\cdot \\frac{3}{4}\\sqrt{\\pi }=6\\pi .\n$$"} {:db/id #edb/ref 17592186522777 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2302b82a-2c66-54dd-be0b-bf5ba7bc64a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{32}" :db/id #edb/ref 17592186522098} {:answer/id #uuid "319eef43-8c9a-5fd5-add1-64fefb55b710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186522129} {:answer/id #uuid "c0a12033-1a6e-5a88-af17-bb4f55993e4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186522417} {:answer/id #uuid "dd9fba62-ac84-588c-b69a-9b024d5ca676" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186522482} {:answer/id #uuid "e1a07ac1-07d6-51e7-8687-9b55e361c2b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id #edb/ref 17592186522497}] :answer-field/correct {:answer/id #uuid "c0a12033-1a6e-5a88-af17-bb4f55993e4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186522417} :answer-field/id #uuid "23aae750-eafd-52bf-8e1a-92d37cd03934" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522569}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bc51ccb0-0438-5418-a3d9-157e172ac1ec" :question/math-academy-id "q-99685" :question/problem "$-\\frac{1}{2}\\operatorname{ln}⁡(\\frac{1}{{e}^{5}})=$" :question/worked-solution "First, we rewrite $\\frac{1}{{e}^{5}}$ as a power of $e$ (the base of the natural logarithm) as follows:\n\n$$\n\\frac{1}{{e}^{5}}={e}^{-5}\n$$\n\nTherefore, we have:\n\n$$\n-\\frac{1}{2}\\operatorname{ln}⁡(\\frac{1}{{e}^{5}})=-\\frac{1}{2}\\operatorname{ln}⁡({e}^{-5})\n$$\n\nThe natural logarithm reverses the action of the exponent. The principle is:\n\n$$\n\\operatorname{ln}⁡({e}^{x})=x\n$$\n\nIn our case, we have $x=-5.$ Therefore:\n\n$$\n-\\frac{1}{2}\\operatorname{ln}⁡({e}^{-5})=-\\frac{1}{2}\\cdot (-5)=\\frac{5}{2}\n$$"} {:db/id #edb/ref 17592186522780 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dbc4c08-f008-5e72-b85a-8f2b4179ee34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186522152} {:answer/id #uuid "4cfefb36-0c70-50b6-aa6a-4945530149e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186522185} {:answer/id #uuid "97e3dd6a-5cc0-5fa9-95f1-4e769dfdd8a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186522330} {:answer/id #uuid "c921974f-fc45-5558-acc3-f2310130ec21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186522438} {:answer/id #uuid "ec8b09ec-156b-5830-8ce7-eac0fbd892c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186522524}] :answer-field/correct {:answer/id #uuid "97e3dd6a-5cc0-5fa9-95f1-4e769dfdd8a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186522330} :answer-field/id #uuid "e00110c2-7288-57e8-9508-75b52e302e96" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522666}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c40cfd48-e992-514e-93b1-f5d1aa09838d" :question/math-academy-id "q-162128" :question/problem "Use the change of variables \n\n$$\nu=2x+y,\\,v=3x+2z,\\,w=z\n$$\n\nto evaluate the triple integral\n\n$$\n{∭}_{R}\\frac{12}{1+(3x+2z)^{2}}\\,dV,\n$$\n\nwhere the region $R$ is given by\n\n$$\nR=\\{(x,y,z)\\,:\\,\\frac{1}{\\pi }\\le 2x+y\\le \\frac{2}{\\pi },\\,\\,0\\le 3x+2z\\le 1,\\,\\,0\\le z\\le 2\\}.\n$$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]⟶[\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nwhere $\\frac{∂(x,y,z)}{∂(u,v,w)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=2x+y,\\,v=3x+2z,\\,w=z\n$$\n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\\to [\\begin{aligned}u(x,y,z) \\\\ v(x,y,z) \\\\ w(x,y,z)\\end{aligned}].\n$$\n\nTo compute the required integral, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $R$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v,w)\\,:\\,\\frac{1}{\\pi }\\le u\\le \\frac{2}{\\pi },\\,0\\le v\\le 1,\\,0\\le w\\le 2\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 1 & 0 \\\\ 3 & 0 & 2 \\\\ 0 & 0 & 1\\end{aligned}| \\\\  & =1(-1)^{3+3}|\\begin{aligned}2 & 1 \\\\ 3 & 0\\end{aligned}| \\\\  & =0-3 \\\\  & =-3.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=-\\frac{1}{3}.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}\\frac{12}{1+(3x+2z)^{2}}\\,dV & ={∭}_{Δ}\\frac{12}{1+{v}^{2}}\\cdot |-\\frac{1}{3}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={∭}_{Δ}\\frac{4}{(1+{v}^{2})}\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={\\int }_{1/\\pi }^{2/\\pi }{\\int }_{0}^{1}{\\int }_{0}^{2}\\frac{4}{(1+{v}^{2})}\\,dw\\,dv\\,du \\\\  & ={\\int }_{1/\\pi }^{2/\\pi }\\,du\\cdot {\\int }_{0}^{1}\\frac{4}{(1+{v}^{2})}\\,dv\\cdot {\\int }_{0}^{2}dw \\\\  & =[u]_{1/\\pi }^{2/\\pi }\\cdot {[4\\operatorname{arctan}⁡v]}_{v=0}^{v=1}\\cdot [w]_{w=0}^{w=2} \\\\  & =(\\frac{2}{\\pi }-\\frac{1}{\\pi })\\cdot (4\\cdot \\frac{\\pi }{4}-0)\\cdot (2-0) \\\\  & =2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186522791 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2394e902-5877-5810-8394-10ee68af9948" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186522099} {:answer/id #uuid "340065a2-9812-543e-996f-7f17091e976f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186522136} {:answer/id #uuid "7b0a9111-8e94-5364-bc20-efc06aaf2f75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186522260} {:answer/id #uuid "eb6d1d0b-251e-586b-a73a-66b5615b60f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186522522} {:answer/id #uuid "feea11ca-e2b0-5234-8225-36492bbaedf5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186522555}] :answer-field/correct {:answer/id #uuid "2394e902-5877-5810-8394-10ee68af9948" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186522099} :answer-field/id #uuid "bae3461d-fd61-5c28-bb95-fe22bb6cd076" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522650}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dd794f4b-e202-5786-ad78-bc211e098112" :question/math-academy-id "q-112486" :question/problem "For which of the following polynomials is $(5x+4)$ a factor?\n\nI. $f(x)=5{x}^{3}+4{x}^{2}$\n\nII. $g(x)=15{x}^{2}+25x+4$\n\nIII. $h(x)=4{x}^{3}+5{x}^{2}$" :question/worked-solution "According to the factor theorem, $(ax-b)$ is a factor of the polynomial $p(x)$ if and only if the root $x=\\frac{b}{a}$ is also root of $p(x).$ \n\nHere, we are considering $(5x+4).$ The root of this expression can be found by setting the expression equal to $0$ and solving:\n\n$$\n\\begin{aligned}5x+4 & =0 \\\\ 5x & =-4 \\\\ x & =-\\frac{4}{5}\\end{aligned}\n$$\n\nAccording to the factor theorem, then, $(5x+4)$ is a factor of $p(x)$ if $x=-\\frac{4}{5}$ is a root of $p(x).$\n\nNow we will check if $x=-\\frac{4}{5}$ is a root of the polynomials $f,$ $g$ and $h.$\n\n- Evaluating $x=-\\frac{4}{5}$ at $f(x),$ we get\n\n$$\n\\begin{aligned}f(-\\frac{4}{5}) & =5{(-\\frac{4}{5})}^{3}+4{(-\\frac{4}{5})}^{2} \\\\  & =5(-\\frac{64}{125})+4(\\frac{16}{25}) \\\\  & =-\\frac{64}{25}+\\frac{64}{25} \\\\  & =0.\\end{aligned}\n$$\n\nConsequently, by the factor theorem, we conclude that $(5x+4)$ is indeed a factor of $f(x).$\n\n- Now, evaluating $x=-\\frac{4}{5}$ at $g(x),$ we get\n\n$$\n\\begin{aligned}g(-\\frac{4}{5}) & =15{(-\\frac{4}{5})}^{2}+25(-\\frac{4}{5})+4 \\\\  & =15(\\frac{16}{25})-20+4 \\\\  & =\\frac{48}{5}-16 \\\\  & =-\\frac{32}{5}\\ne 0.\\end{aligned}\n$$\n\nSo, by the factor theorem, $(5x+4)$ is not a factor of $g(x).$\n\n- Finally, evaluating $x=-\\frac{4}{5}$ at $h(x),$ we get\n\n$$\n\\begin{aligned}h(-\\frac{4}{5}) & =4{(-\\frac{4}{5})}^{3}+5{(-\\frac{4}{5})}^{2} \\\\  & =4(-\\frac{64}{125})+5(\\frac{16}{25}) \\\\  & =-\\frac{256}{125}+\\frac{16}{5} \\\\  & =\\frac{144}{125}\\ne 0.\\end{aligned}\n$$\n\nSo, by the factor theorem, $(5x+4)$ is not a factor of $g(x).$\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186522792 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c4bd551-965b-5c88-811a-93ad01e05d86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{5}" :db/id #edb/ref 17592186522184}] :answer-field/correct {:answer/id #uuid "4c4bd551-965b-5c88-811a-93ad01e05d86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{5}" :db/id #edb/ref 17592186522184} :answer-field/id #uuid "89f2717d-a35e-5e3f-aba4-917081b91c68" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186522627}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "deaa15dc-da8f-5e37-b1fc-ea24a0a7f029" :question/math-academy-id "q-343191" :question/problem "![](images/69/69b4b3c2488cf394df687d7446ab5a49bab037de936402f02d43196f71dddf09.png)\n\nTwo glass plates are held a constant distance apart, forming a growing sheet of laminated glass resin. As rollers pull the plates apart, the length is increasing by $2\\,\\text{cm}\\text{/min},$ while the $1\\,\\text{cm}$ thickness does not change. If resin is injected so that the volume of the sheet is increasing at a rate of $32\\,{\\text{cm}}^{3}\\text{/min},$  how fast is its width changing when its dimensions are $10\\,\\text{cm}$ in length and $4\\,\\text{cm}$ in width?\n\nThe width is increasing at a rate of\n{{field-1}}\n$\\text{cm}/\\text{min}.$" :question/worked-solution "Let $x,y,z$ be the dimensions of the solid, and let $V$ be its volume. We are given that \n\n$$\n\\begin{aligned}x & =10\\,\\text{cm}, \\\\ y & =4\\,\\text{cm}, \\\\ z & =1\\,\\text{cm}.\\end{aligned}\n$$\n\nAlso, we know that\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =2\\,\\text{cm}\\text{/min}, \\\\ \\frac{\\text{d}V}{\\text{d}t} & =32\\,{\\text{cm}}^{3}\\text{/min}.\\end{aligned}\n$$\n\nWe would like to find $\\frac{\\text{d}y}{\\text{d}t}$ when $x=10\\,\\text{cm},$ $y=4\\,\\text{cm}$ and $z=1\\,\\text{cm}.$\n\nWe start with the formula for the volume of the rectangular prism:\n\n$$\nV=xyz\n$$\n\nSince $z$ is not changing and $z=1,$ we get\n\n$$\nV=xy.\n$$\n\nNow, we differentiate with respect to time using the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(xy) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =x(\\frac{\\text{d}y}{\\text{d}t})+y(\\frac{\\text{d}x}{\\text{d}t}).\\end{aligned}\n$$\n\nWe can now plug in the known values into the above expression. This gives\n\n$$\n\\begin{aligned}32 & =10(\\frac{\\text{d}y}{\\text{d}t})+4(2) \\\\ 32 & =10(\\frac{\\text{d}y}{\\text{d}t})+8 \\\\ 24 & =10(\\frac{\\text{d}y}{\\text{d}t}) \\\\ \\frac{\\text{d}y}{\\text{d}t} & =2.4\\,\\text{cm}\\text{/min}.\\end{aligned}\n$$\n\nTherefore, the width of the solid is increasing at a rate of $2.4\\,\\text{cm}/\\text{min}$ at the moment when $x=10\\,\\text{cm},$ $y=4\\,\\text{cm}$ and $z=1\\,\\text{cm}.$"} {:db/id #edb/ref 17592186522793 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a4f7c24-e0b9-5bf3-9e4d-a25f296ccb48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(2n+1)\\pi }{10}" :db/id #edb/ref 17592186522144} {:answer/id #uuid "67ff3321-c036-5b29-9dad-55a412690dac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n\\pi }{20}" :db/id #edb/ref 17592186522232} {:answer/id #uuid "6df027d0-2009-5803-b6ab-84d40381f957" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(2n-1)\\pi }{10}" :db/id #edb/ref 17592186522243} {:answer/id #uuid "d7c85d4a-dd82-53d1-bf3d-6b0ac4ea8760" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(2n+1)\\pi }{20}" :db/id #edb/ref 17592186522465} {:answer/id #uuid "d996cdfc-0e79-5226-8c9a-877b887a3bf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n\\pi }{10}" :db/id #edb/ref 17592186522471}] :answer-field/correct {:answer/id #uuid "d7c85d4a-dd82-53d1-bf3d-6b0ac4ea8760" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(2n+1)\\pi }{20}" :db/id #edb/ref 17592186522465} :answer-field/id #uuid "332d2f8f-47d7-550b-9380-93ef85d9ab1c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186522581} {:answer-field/choices [{:answer/id #uuid "1d235ca0-01c3-55ec-8fcb-222232223b0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{B}_{n}\\operatorname{cos}⁡({\\lambda }_{n}x)" :db/id #edb/ref 17592186522084} {:answer/id #uuid "41cc2c8c-3160-5bbd-8cc4-960e5fbda21e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{B}_{n}\\operatorname{sin}⁡(5{\\lambda }_{n}x)" :db/id #edb/ref 17592186522162} {:answer/id #uuid "5389d731-66ed-5d65-93ef-3a80e24757d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{B}_{n}\\operatorname{sin}⁡(\\frac{{\\lambda }_{n}x}{5})" :db/id #edb/ref 17592186522197} {:answer/id #uuid "9caaa3b1-2fd7-5093-989a-4a1ad46a3f24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{B}_{n}\\operatorname{sin}⁡({\\lambda }_{n}x)" :db/id #edb/ref 17592186522339} {:answer/id #uuid "a998a8d9-6a09-5d04-acb0-872ca47788d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{B}_{n}\\operatorname{cos}⁡(5{\\lambda }_{n}x)" :db/id #edb/ref 17592186522375} {:answer/id #uuid "fed8e2de-30fd-518a-ac16-176c89ef2fc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{B}_{n}\\operatorname{cos}⁡(\\frac{5{\\lambda }_{n}x}{2})" :db/id #edb/ref 17592186522554}] :answer-field/correct {:answer/id #uuid "41cc2c8c-3160-5bbd-8cc4-960e5fbda21e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{B}_{n}\\operatorname{sin}⁡(5{\\lambda }_{n}x)" :db/id #edb/ref 17592186522162} :answer-field/id #uuid "f2b1e7ca-994b-5508-b638-3a8f99c45170" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186522678}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e119a1c3-3fb4-5a0d-b097-eb9b2cba2dd5" :question/math-academy-id "q-338911" :question/problem "Consider the boundary value problem\n\n$$\n{y}^{″}+25{\\lambda }^{2}y=0,\\,y(0)=0,\\,{y}^{′}(2)=0,\\,0\\le x\\le 2,\\,\\lambda \\ge 0.\n$$\n\nFind the parameter values corresponding to the eigenvalues and the associated eigenfunctions of this problem.\n\n$\\,$ The eigenvalues correspond to the parameter values ${\\lambda }_{n}=$ {{field-1}}, where $n\\in N.$\n\n$\\,$ The eigenfunctions are ${y}_{n}(x)=$ {{field-2}}, where ${B}_{n}\\in R.$" :question/worked-solution "We consider the cases $\\lambda =0$ and $\\lambda \\ne 0$ separately, since they correspond to different solutions. \n\n**Case 1**: First, we consider $\\lambda =0.$ \n\nSetting $\\lambda =0$ gives the equation\n\n$$\n{y}^{″}=0.\n$$\n\nIntegrating this equation gives\n\n$$\ny=Ax+B.\n$$\n\nApplying the conditions $y(0)=0$ and ${y}^{′}(2)=0$ yields the trivial solution $y≡0.$ Since the zero solution is not an eigenfunction, $\\lambda =0$ does not correspond to an eigenvalue.\n\n**Case 2**: Next, we consider $\\lambda >0.$\n\nTo find the fundamental solutions, we set $y={e}^{mx}.$ The auxiliary equation is\n\n$$\n\\begin{aligned}{m}^{2}+25{\\lambda }^{2} & =0.\\end{aligned}\n$$\n\nSo, we have $m=\\pm 5\\text{i}\\lambda .$ So, the fundamental solutions are \n\n$$\n{y}_{1}(x)=\\operatorname{cos}⁡(5\\lambda x),\\,{y}_{2}(x)=\\operatorname{sin}⁡(5\\lambda x)\n$$\n\nand the general solution is\n\n$$\ny=A\\operatorname{cos}⁡(5\\lambda x)+B\\operatorname{sin}⁡(5\\lambda x).\n$$\n\nApplying the boundary condition $y(0)=0$ yields\n\n$$\nA\\operatorname{cos}⁡(0)+B\\operatorname{sin}⁡(0)=0\n$$\n\nwhich gives $A=0.$ So, we have\n\n$$\ny=B\\operatorname{sin}⁡(5\\lambda x).\n$$\n\nDifferentiating gives\n\n$$\n{y}^{′}=5B\\lambda \\operatorname{cos}⁡(5\\lambda x).\n$$\n\nApplying the boundary condition ${y}^{′}(2)=0$ yields\n\n$$\n5B\\lambda \\operatorname{cos}⁡(10\\lambda )=0.\n$$\n\nFor nontrivial solutions, we require \n\n$$\n10\\lambda =\\frac{\\pi }{2}+n\\pi =\\frac{(2n+1)\\pi }{2}\n$$\n\nfor $n\\in N.$ This gives the parameter values corresponding to the eigenvalues:\n\n$$\n{\\lambda }_{n}=\\frac{(2n+1)\\pi }{20}.\n$$\n\nThe corresponding eigenfunctions are \n\n$$\n{y}_{n}(x)={B}_{n}\\operatorname{sin}⁡(5{\\lambda }_{n}x),\\,{B}_{n}\\in R.\n$$"} {:db/id #edb/ref 17592186522806 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08b0f249-4156-5456-83fc-ea5f028e4459" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186522033}] :answer-field/correct {:answer/id #uuid "08b0f249-4156-5456-83fc-ea5f028e4459" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186522033} :answer-field/id #uuid "309df97e-fe05-56dc-8a9c-33f5a7cc5b96" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186522579} {:answer-field/choices [{:answer/id #uuid "1f5b811f-6d2c-50c9-a9f1-7afe2b2f75a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186522089}] :answer-field/correct {:answer/id #uuid "1f5b811f-6d2c-50c9-a9f1-7afe2b2f75a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186522089} :answer-field/id #uuid "5081ce70-78db-5736-8383-df428ff21f68" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186522601}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f39faa87-98f1-5160-9f77-61fba20bbf35" :question/math-academy-id "q-133020" :question/problem "Let $a=-\\frac{4}{5}.$ For what values of $k$ does the intermediate value theorem guarantee that $f(x)=k$ has a solution on the interval $x\\in [-5,-4]?$\n\n$k\\,\\in \\,[$\n{{field-1}}\n$,\\,$\n{{field-2}}\n$]$" :question/worked-solution "In part 2, we found that the function $f(x)$ is continuous on $[-5,-4]$ when $a=-\\frac{4}{5}.$ \n\nTherefore, the intermediate value theorem guarantees that $f(x)=k$ has a solution for each value of $k$ between $f(-5)$ and $f(-4).$\n\nSince \n\n$$\n\\begin{aligned}f(-5) & =(-5)^{2}+3(-5) \\\\  & =25-15 \\\\  & =10\\end{aligned}\n$$\n\nand \n\n$$\nf(-4)=-5\\cdot (-\\frac{4}{5})=4,\n$$\n\nwe must have \n\n$$\nk\\in [4,10].\n$$"} {:db/id #edb/ref 17592186522807 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08668600-cdfa-52f8-ab7a-d4a36c8ad7e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{15}" :db/id #edb/ref 17592186522032} {:answer/id #uuid "1ffc0230-8021-5fb9-97c8-3bdfd65c4744" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{23}" :db/id #edb/ref 17592186522091} {:answer/id #uuid "aa044da1-85a9-511d-b5d4-f73842833f10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{23}" :db/id #edb/ref 17592186522376} {:answer/id #uuid "b9fdd295-7d5b-5a27-b880-407ff1f5f955" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{15}" :db/id #edb/ref 17592186522403} {:answer/id #uuid "dcd04df4-f6d0-543d-b41f-3f62636bc031" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{16}" :db/id #edb/ref 17592186522478}] :answer-field/correct {:answer/id #uuid "aa044da1-85a9-511d-b5d4-f73842833f10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{23}" :db/id #edb/ref 17592186522376} :answer-field/id #uuid "ed19dedc-ec19-5969-a25e-5d950eb640c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522676}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f5454beb-e917-5a8e-86e1-4e0232e2e094" :question/math-academy-id "q-170681" :question/problem "Two groups of high school students are competing in a math contest. Group $A$ consists of $5$ girls and $3$ boys, while Group $B$ consists of $2$ girls and $4$ boys. For the first challenge, one group is randomly selected, and one student is randomly selected from that group. If the selected student is a girl, what is the probability that she is from Group $B?$" :question/worked-solution "Let $B$ be the event that Group $B$ is selected, and let $G$ be the event that a randomly selected student is a girl. Then, we require $P(B|G),$ which we can compute using Bayes' theorem.\n\n$$\nP(B|G)=\\frac{P(G|B)P(B)}{P(G)}=\\frac{P(G|B)P(B)}{P(G|B)P(B)+P(G|{B}^{′})P({B}^{′})}\n$$\n\nNote that ${B}^{′}$ is the event that Group A is selected.\n\nFrom the problem statement, we have the following:\n\n- Since Group $A$ consists of $5$ girls and $3$ boys and Group $B$ consists of $2$ girls and $4$ boys, we have\n\n$$\nP(G|B)=\\frac{2}{6}=\\frac{1}{3},\\,P(G|{B}^{′})=\\frac{5}{8}.\n$$\n\n- Since the group is selected at random, we have\n\n$$\nP(B)=P({B}^{′})=\\frac{1}{2}.\n$$\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(B|G) & =\\frac{P(G|B)P(B)}{P(G|B)P(B)+P(G|{B}^{′})P({B}^{′})} \\\\  & =\\frac{(\\frac{1}{3}\\cdot \\frac{1}{2})}{(\\frac{1}{3}\\cdot \\frac{1}{2}+\\frac{5}{8}\\cdot \\frac{1}{2})} \\\\  & =\\frac{(\\frac{1}{6})}{(\\frac{1}{6}+\\frac{5}{16})} \\\\  & =\\frac{(\\frac{1}{6})}{(\\frac{23}{48})} \\\\  & =\\frac{8}{23}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186522809 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "167c9635-d107-553c-80f2-728998f64f44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{1}^{2}{\\int }_{2}^{4}{\\int }_{0}^{v}\\frac{\\operatorname{sinh}⁡u}{2}\\,dw\\,dv\\,du" :db/id #edb/ref 17592186522065} {:answer/id #uuid "208798f3-1213-54c2-9110-17dc3e4b81b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{1}^{2}{\\int }_{2}^{4}{\\int }_{0}^{uv}2v\\operatorname{sinh}⁡u\\,dw\\,dv\\,du" :db/id #edb/ref 17592186522093} {:answer/id #uuid "41084583-9221-587e-a746-0339cfa254c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{1}^{2}{\\int }_{2}^{4}{\\int }_{0}^{1}\\frac{\\operatorname{sinh}⁡u}{2}\\,dw\\,dv\\,du" :db/id #edb/ref 17592186522161} {:answer/id #uuid "8c6d471a-064f-5e70-bfd7-077a3c169ff3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{1}^{2}{\\int }_{2}^{4}{\\int }_{0}^{uv}2v\\operatorname{sinh}⁡uv\\,dw\\,dv\\,du" :db/id #edb/ref 17592186522305} {:answer/id #uuid "f6cc9b29-5be4-54fe-8424-7c6e39a3e9a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{1}^{2}{\\int }_{2}^{4}{\\int }_{0}^{v}\\frac{u\\operatorname{sinh}⁡u}{2}\\,dw\\,dv\\,du" :db/id #edb/ref 17592186522542}] :answer-field/correct {:answer/id #uuid "41084583-9221-587e-a746-0339cfa254c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{1}^{2}{\\int }_{2}^{4}{\\int }_{0}^{1}\\frac{\\operatorname{sinh}⁡u}{2}\\,dw\\,dv\\,du" :db/id #edb/ref 17592186522161} :answer-field/id #uuid "4072ebe9-e356-5a8b-bdd6-bdedd4bc5d7f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522591}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f849acac-b165-56ce-af0c-ee1d4893cc84" :question/math-academy-id "q-39056" :question/problem "Consider the finite region $R$ in the $xyz$-space, given by\n\n$$\nR=\\{(x,y,z)\\,:\\,1\\le {x}^{2}-{y}^{2}\\le 2,\\,2\\le x+y\\le 4,\\,0\\le z\\le 1\\}.\n$$\n\nBy performing the change of variables\n\n$$\nu={x}^{2}-{y}^{2},\\,v=x+y,\\,w=z,\n$$\n\nthe triple integral\n\n$$\n{∭}_{R}(x+y)\\operatorname{sinh}⁡({x}^{2}-{y}^{2})\\,dV\n$$\n\ncan be written in terms of $u,$ $v,$ and $w$ as" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]⟶[\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo find the required integral, we can use the change of variables formula\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nwhere $\\frac{∂(x,y,z)}{∂(u,v,w)}$ is the Jacobian determinant corresponding to $T.$ \n\nNote that the change of variables\n\n$$\nu={x}^{2}-{y}^{2},\\,v=x+y,\\,w=z,\n$$\n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\\to [\\begin{aligned}u(x,y,z) \\\\ v(x,y,z) \\\\ w(x,y,z)\\end{aligned}].\n$$\n\nTo find the required integral, we proceed in four steps: \n\n**Step 1**: Find $Δ,$ which is the image of $R$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v,w)\\,:\\,1\\le u\\le 2,\\,2\\le v\\le 4,\\,0\\le w\\le 1\\}.\\end{aligned}\n$$\n\n \n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{aligned}| \\\\  & =|\\begin{aligned}2x & -2y & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}| \\\\  & =1|\\begin{aligned}2x & -2y \\\\ 1 & 1\\end{aligned}| \\\\  & =2x+2y \\\\  & =2(x+y) \\\\  & =2v\\end{aligned}\n$$\n\n \n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=\\frac{1}{2v}.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$ \n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}(x+y)\\operatorname{sinh}⁡({x}^{2}-{y}^{2})\\,dV & ={∭}_{Δ}v\\operatorname{sinh}⁡u\\cdot |\\frac{1}{2v}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={∭}_{Δ}\\frac{\\operatorname{sinh}⁡u}{2}\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={\\int }_{1}^{2}{\\int }_{2}^{4}{\\int }_{0}^{1}\\frac{\\operatorname{sinh}⁡u}{2}\\,dw\\,dv\\,du\\end{aligned}\n$$"} {:db/id #edb/ref 17592186523015 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0532a3d5-8ee1-550f-b0bf-c235d929f9f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25\\pi}{12}" :db/id #edb/ref 17592186523018}] :answer-field/correct {:answer/id #uuid "0532a3d5-8ee1-550f-b0bf-c235d929f9f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25\\pi}{12}" :db/id #edb/ref 17592186523018} :answer-field/id #uuid "02d2a19b-0275-5b3e-a499-333cc75b2412" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523017} {:answer-field/choices [{:answer/id #uuid "7a169120-7df4-5f55-beae-de78fbf968d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{19\\pi}{12}" :db/id #edb/ref 17592186523050}] :answer-field/correct {:answer/id #uuid "7a169120-7df4-5f55-beae-de78fbf968d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{19\\pi}{12}" :db/id #edb/ref 17592186523050} :answer-field/id #uuid "6b168f6f-49e1-5695-9ee4-29603fc3f97a" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523044} {:answer-field/choices [{:answer/id #uuid "4087d16f-41ff-55cd-8c2e-08b69a6826be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13\\pi}{12}" :db/id #edb/ref 17592186523038}] :answer-field/correct {:answer/id #uuid "4087d16f-41ff-55cd-8c2e-08b69a6826be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13\\pi}{12}" :db/id #edb/ref 17592186523038} :answer-field/id #uuid "781b488a-edfc-5c44-84c9-4de420c90a9f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523049} {:answer-field/choices [{:answer/id #uuid "c01f4bfb-77a4-54f6-98c5-f72c64b9a004" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7\\pi}{12}" :db/id #edb/ref 17592186523072}] :answer-field/correct {:answer/id #uuid "c01f4bfb-77a4-54f6-98c5-f72c64b9a004" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7\\pi}{12}" :db/id #edb/ref 17592186523072} :answer-field/id #uuid "a0931c90-812a-5983-b711-8c99d2ced8b7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523058}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "01b49672-000e-56a4-a472-53c03786af3d" :question/problem "A curve is defined by the parametric equations\n\n$$\nx=4\\cos(2t-\\frac{2\\pi}{3})+8,\\,y=4\\sin(2t-\\frac{2\\pi}{3})-9,\\,\\frac{\\pi}{2}\\le t<\\frac{5\\pi}{2}.\n$$\n\nDetermine the values of $t$ at which the normal to the curve is vertical. Give exact answers in ascending order.\n\n$t=$\n{{field-1}}, $t=$\n{{field-2}}, $t=$\n{{field-3}}, $t=$\n{{field-4}}." :question/worked-solution "The normal is vertical if the tangent is horizontal. Therefore, we require ${y}^{′}(t)=0$ while ${x}^{′}(t)\\ne 0.$\n\nSo, we first find the derivatives of $x$ and $y:$\n\n$$\n{x}^{′}(t)=-8\\sin(2t-\\frac{2\\pi}{3}),\\,{y}^{′}(t)=8\\cos(2t-\\frac{2\\pi}{3})\n$$\n\nSolving ${y}^{′}(t)=0$ gives\n\n$$\n8\\cos(2t-\\frac{2\\pi}{3})=0\\,⟹\\,t=\\frac{7\\pi}{12}, \\frac{13\\pi}{12}, \\frac{19\\pi}{12}, \\frac{25\\pi}{12}.\n$$\n\nNow, we note that\n\n$$\n\\begin{aligned}{x}^{′}(\\frac{7\\pi}{12}) & =-8\\ne 0, \\\\ {x}^{′}(\\frac{13\\pi}{12}) & =8\\ne 0, \\\\ {x}^{′}(\\frac{19\\pi}{12}) & =-8\\ne 0, \\\\ {x}^{′}(\\frac{25\\pi}{12}) & =8\\ne 0,\\end{aligned}\n$$\n\nwhich confirms that the normal to the curve is indeed vertical when $t=\\frac{7\\pi}{12}, \\frac{13\\pi}{12}, \\frac{19\\pi}{12}, \\frac{25\\pi}{12}.$"} {:db/id #edb/ref 17592186523022 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76780c4b-7c67-5172-a923-404203abac6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-\\frac{1}{8}" :db/id #edb/ref 17592186523048} {:answer/id #uuid "960e68b7-6cec-5c3c-a30f-2031649d16a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{1}{8\\pi}" :db/id #edb/ref 17592186523054} {:answer/id #uuid "a958f4f8-a66f-5de3-aa01-d9ebb099e2d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{\\pi}{8}" :db/id #edb/ref 17592186523062} {:answer/id #uuid "eb798864-0ac9-51b0-9c7f-b01a49eef0ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=8" :db/id #edb/ref 17592186523085} {:answer/id #uuid "ec200bf0-4f46-584b-a692-00c1810a50f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{1}{8}" :db/id #edb/ref 17592186523086}] :answer-field/correct {:answer/id #uuid "ec200bf0-4f46-584b-a692-00c1810a50f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{1}{8}" :db/id #edb/ref 17592186523086} :answer-field/id #uuid "25fc8402-d761-5db0-9a28-00207fa0223e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523031}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0c0cf3c7-a877-56af-bcc4-84567b0dae9c" :question/problem "A curve is defined by the parametric equations\n\n$$\nx=\\operatorname{ln}⁡(\\pi t)-8t,\\,y={e}^{1t},\\,0<t<\\infty .\n$$\n\nDetermine the value of the parameter $t$ at which the normal line to the curve is horizontal." :question/worked-solution "The normal line is horizontal when the tangent line to the curve is vertical. Therefore, we require ${x}^{′}(t)=0$ while ${y}^{′}(t)\\ne 0.$\n\nSo, we first find the derivatives of $x$ and $y:$\n\n$$\n{x}^{′}(t)=\\frac{1}{t}-8,\\,{y}^{′}(t)=1{e}^{1t}\n$$\n\nSolving ${x}^{′}(t)=0$ gives\n\n$$\n\\frac{1}{t}-8=0\\,⟹\\,t=\\frac{1}{8}.\n$$\n\nNow, we note that\n\n$$\n{y}^{′}(\\frac{1}{8})=1{e}^{1\\times (1/8)}=e^{\\frac{1}{8}}\\ne 0,\\,\\,\n$$\n\nwhich confirms that the normal to the curve is indeed horizontal when $t=\\frac{1}{8}.$"} {:db/id #edb/ref 17592186523025 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "025a69e7-e144-5e44-be3d-307e07729fe4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17\\pi}{8}" :db/id #edb/ref 17592186523016}] :answer-field/correct {:answer/id #uuid "025a69e7-e144-5e44-be3d-307e07729fe4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17\\pi}{8}" :db/id #edb/ref 17592186523016} :answer-field/id #uuid "9f620562-bc36-5065-97f2-e05de27b5688" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523056} {:answer-field/choices [{:answer/id #uuid "b7a04206-b140-5d42-bde5-4231171751d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13\\pi}{8}" :db/id #edb/ref 17592186523067}] :answer-field/correct {:answer/id #uuid "b7a04206-b140-5d42-bde5-4231171751d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13\\pi}{8}" :db/id #edb/ref 17