 & =-6\\ne 0, \\\\ {x}^{′}(\\frac{5\\pi }{3}) & =6\\ne 0,\\end{aligned}\n$$\n\nwhich confirms that the normal to the curve is indeed vertical when $t=\\frac{2\\pi }{3}$ and $t=\\frac{5\\pi }{3}.$"} {:db/id #edb/ref 17592186523223 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13eb88b0-c538-59f5-a87f-9f0c62715e7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-\\frac{4}{3},\\,-\\frac{1}{3},\\,-1⟩" :db/id #edb/ref 17592186523194} {:answer/id #uuid "24f1dbef-5fc8-59db-bec0-0a9c8a04f080" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{2 \\sqrt{26}}{13},\\,\\frac{\\sqrt{26}}{26},\\,\\frac{3 \\sqrt{26}}{26}⟩" :db/id #edb/ref 17592186523198} {:answer/id #uuid "8267fe08-c361-5516-bb08-f2287927df19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-\\frac{\\sqrt{11}}{11},\\,-\\frac{\\sqrt{11}}{11},\\,-\\frac{3 \\sqrt{11}}{11}⟩" :db/id #edb/ref 17592186523214} {:answer/id #uuid "c20caa2a-1e3e-5e4e-8c04-1a085e20bfe5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-\\frac{2 \\sqrt{26}}{13},\\,-\\frac{\\sqrt{26}}{26},\\,-\\frac{3 \\sqrt{26}}{26}⟩" :db/id #edb/ref 17592186523224} {:answer/id #uuid "e89ef417-189c-5198-b034-c7b157620d77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-\\frac{6}{13},\\,-\\frac{3}{26},\\,-\\frac{9}{26}⟩" :db/id #edb/ref 17592186523231}] :answer-field/correct {:answer/id #uuid "c20caa2a-1e3e-5e4e-8c04-1a085e20bfe5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-\\frac{2 \\sqrt{26}}{13},\\,-\\frac{\\sqrt{26}}{26},\\,-\\frac{3 \\sqrt{26}}{26}⟩" :db/id #edb/ref 17592186523224} :answer-field/id #uuid "13f6643a-75d9-50a2-a3fb-88100e3589a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523195}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b1292b8d-2b01-5533-896d-f2505b0485b1" :question/problem "In what unit direction does the function $f(x,y,z)=\\ln (x^{4}y^{1}z^{3})$ decrease most rapidly at the point $(3,3,3)$?" :question/worked-solution "At a given point, a function $f(x,y,z)$ decreases most rapidly in the direction opposite to that of its gradient.\n\nSo, we compute $∇f(x,y,z)$ and evaluate it at the point $(3,3,3):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =⟨\\frac{∂}{∂x}(\\ln (x^{4}y^{1}z^{3})),\\,\\frac{∂}{∂y}(\\ln (x^{4}y^{1}z^{3})),\\,\\frac{∂}{∂z}(\\ln (x^{4}y^{1}z^{3}))⟩ \\\\ & =⟨\\frac{1}{x^{4}y^{1}z^{3}}\\cdot 4x^{3}y^{1}z^{3},\\,\\frac{1}{x^{4}y^{1}z^{3}}\\cdot x^{4}y^{0}z^{3},\\,\\frac{1}{x^{4}y^{1}z^{3}}\\cdot 3x^{4}y^{1}z^{2}⟩ \\\\ & =⟨\\frac{4}{x},\\,\\frac{1}{y},\\,\\frac{3}{z}⟩ \\\\ ∇f(3,3,3) & =⟨\\frac{4}{3},\\,\\frac{1}{3},\\,\\frac{3}{3}⟩ \\\\ & =⟨\\frac{4}{3},\\,\\frac{1}{3},\\,1⟩\\end{aligned}\n$$\n\nThe corresponding unit direction is\n\n$$\n\\begin{aligned}u & =-\\frac{∇f(3,3,3)}{‖∇f(3,3,3)‖} \\\\ & =\\frac{-1}{\\sqrt{(\\frac{4}{3})^{2}+(\\frac{1}{3})^{2}+(1)^{2}}}⟨\\frac{4}{3},\\,\\frac{1}{3},\\,1⟩ \\\\ & =⟨-\\frac{2 \\sqrt{26}}{13},\\,-\\frac{\\sqrt{26}}{26},\\,-\\frac{3 \\sqrt{26}}{26}⟩\\end{aligned}\n$$\n\nTherefore, the function decreases most rapidly in the unit direction of $⟨-\\frac{2 \\sqrt{26}}{13},\\,-\\frac{\\sqrt{26}}{26},\\,-\\frac{3 \\sqrt{26}}{26}⟩.$"} {:db/id #edb/ref 17592186523226 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1be8f1ac-37b5-58a3-955f-0739f5c4af3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-\\frac{5 \\sqrt{43}}{43},\\,-\\frac{3 \\sqrt{43}}{43},\\,-\\frac{3 \\sqrt{43}}{43}⟩" :db/id #edb/ref 17592186523196} {:answer/id #uuid "24903325-fc0a-5ecb-8f57-b0303e5a47b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{15}{43},\\,\\frac{9}{43},\\,\\frac{9}{43}⟩" :db/id #edb/ref 17592186523197} {:answer/id #uuid "568e7e09-9ada-5d4d-832e-c907e2ae3641" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{\\sqrt{19}}{19},\\,\\frac{3 \\sqrt{19}}{19},\\,\\frac{3 \\sqrt{19}}{19}⟩" :db/id #edb/ref 17592186523208} {:answer/id #uuid "58d7dd0e-16b3-5cb7-ae74-c242f146528e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{5 \\sqrt{43}}{43},\\,\\frac{3 \\sqrt{43}}{43},\\,\\frac{3 \\sqrt{43}}{43}⟩" :db/id #edb/ref 17592186523209} {:answer/id #uuid "8b2f65ba-0cc3-5296-bb1b-f4544ca841ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{5}{3},\\,1,\\,1⟩" :db/id #edb/ref 17592186523215}] :answer-field/correct {:answer/id #uuid "58d7dd0e-16b3-5cb7-ae74-c242f146528e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{5 \\sqrt{43}}{43},\\,\\frac{3 \\sqrt{43}}{43},\\,\\frac{3 \\sqrt{43}}{43}⟩" :db/id #edb/ref 17592186523209} :answer-field/id #uuid "8c843ff1-9a50-5ae1-8952-8cb69c4ce0ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523217}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d24d013a-ecfd-5200-be0e-2480338379cf" :question/problem "In what unit direction does the function $f(x,y,z)=\\ln (x^{5}y^{2}z^{2})$ increase most rapidly at the point $(3,2,2)$?" :question/worked-solution "At a given point, a function $f(x,y,z)$ increases most rapidly in the direction of its gradient.\n\nSo, we compute $∇f(x,y,z)$ and evaluate it at the point $(3,2,2):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =⟨\\frac{∂}{∂x}(\\ln (x^{5}y^{2}z^{2})),\\,\\frac{∂}{∂y}(\\ln (x^{5}y^{2}z^{2})),\\,\\frac{∂}{∂z}(\\ln (x^{5}y^{2}z^{2}))⟩ \\\\ & =⟨\\frac{1}{x^{5}y^{2}z^{2}}\\cdot 5x^{4}y^{2}z^{2},\\,\\frac{1}{x^{5}y^{2}z^{2}}\\cdot 2x^{5}y^{1}z^{2},\\,\\frac{1}{x^{5}y^{2}z^{2}}\\cdot 2x^{5}y^{2}z^{1}⟩ \\\\ & =⟨\\frac{5}{x},\\,\\frac{2}{y},\\,\\frac{2}{z}⟩ \\\\ ∇f(3,2,2) & =⟨\\frac{5}{3},\\,\\frac{2}{2},\\,\\frac{2}{2}⟩ \\\\ & =⟨\\frac{5}{3},\\,1,\\,1⟩\\end{aligned}\n$$\n\nThe corresponding unit direction is\n\n$$\n\\begin{aligned}u & =\\frac{∇f(3,2,2)}{‖∇f(3,2,2)‖} \\\\ & =\\frac{1}{\\sqrt{(\\frac{5}{3})^{2}+(1)^{2}+(1)^{2}}}⟨\\frac{5}{3},\\,1,\\,1⟩ \\\\ & =⟨\\frac{5 \\sqrt{43}}{43},\\,\\frac{3 \\sqrt{43}}{43},\\,\\frac{3 \\sqrt{43}}{43}⟩\\end{aligned}\n$$\n\nTherefore, the function increases most rapidly in the unit direction of $⟨\\frac{5 \\sqrt{43}}{43},\\,\\frac{3 \\sqrt{43}}{43},\\,\\frac{3 \\sqrt{43}}{43}⟩.$"} {:db/id #edb/ref 17592186523931 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32c27343-2ffe-5ef0-95ae-6705c24c596c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64\\,\\text{m/s}" :db/id #edb/ref 17592186523360} {:answer/id #uuid "7195e49e-14d0-5d15-b093-d2bc20c75842" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60\\,\\text{m/s}" :db/id #edb/ref 17592186523488} {:answer/id #uuid "86eef243-02da-54f6-8ff5-46912fa718e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80\\,\\text{m/s}" :db/id #edb/ref 17592186523537} {:answer/id #uuid "9adf3a93-53a6-5212-9c75-fbcceecb6e8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "54\\,\\text{m/s}" :db/id #edb/ref 17592186523577} {:answer/id #uuid "be8f074c-4255-5799-bd18-aae998046419" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72\\,\\text{m/s}" :db/id #edb/ref 17592186523653}] :answer-field/correct {:answer/id #uuid "7195e49e-14d0-5d15-b093-d2bc20c75842" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60\\,\\text{m/s}" :db/id #edb/ref 17592186523488} :answer-field/id #uuid "0708b89d-7f7a-5637-8493-1ca6f099288c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523793}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "14bd2170-88ec-5846-a2ce-ea9d86c753dc" :question/math-academy-id "q-86335" :question/problem "![](images/ce/ce513880934a99b289c22f734e8a455c3534bddd911968cd06b7fe88f65441aa.png)\n\nA hot air balloon $B$ is flying horizontally to the observer $O$ at a constant height of $300\\,\\text{m}$ above the ground. The angle of elevation $\\theta $ made by the balloon and an observer is increasing at a rate of $0.05$ radians per second. What is the speed of the balloon when $\\theta =\\frac{\\pi }{6}?$" :question/worked-solution "![](images/81/813a4a253bdac3c44fe66da2728ad01bf3f1db2e0612093ce8f6a81b60e50161.png)\n\nIn the figure, $y$ is the altitude of the hot air balloon, and $x$ is the horizontal distance between the balloon and the observer. The quantity $y=300\\,\\text{m}$ does not change with time because the hot air balloon stays at a constant altitude.\n\nWe wish to calculate $\\frac{\\text{d}x}{\\text{d}t}.$ To do this, let's start by setting up a relation between $x$ and $y.$ Relative to the angle $\\theta ,$ the sides $x$ and $y$ are the adjacent and opposite, respectively. So, we have\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡\\theta  & =\\frac{y}{x} \\\\ \\operatorname{tan}⁡\\theta  & =\\frac{300}{x} \\\\ x & =300\\operatorname{cot}⁡\\theta .\\end{aligned}\n$$\n\nNow, we differentiate both sides of the equation with respect to $t$ using implicit differentiation, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(x) & =\\frac{\\text{d}}{\\text{d}t}(300\\operatorname{cot}⁡\\theta ) \\\\ \\frac{\\text{d}x}{\\text{d}t} & =-300{csc}^{2}⁡\\theta \\cdot \\frac{\\text{d}\\theta }{\\text{d}t}.\\end{aligned}\n$$\n\nFrom the given information, we have $\\frac{\\text{d}\\theta }{\\text{d}t}=0.05$ and $\\theta =\\frac{\\pi }{6}.$ Substituting these values into the above, we reach\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =-300{csc}^{2}⁡(\\frac{\\pi }{6})(0.05) \\\\ \\frac{\\text{d}x}{\\text{d}t} & =-300(2)^{2}(0.05) \\\\ \\frac{\\text{d}x}{\\text{d}t} & =-60.\\end{aligned}\n$$\n\nTherefore, the speed of the hot air balloon is $60\\,\\text{m/s}.$"} {:db/id #edb/ref 17592186523950 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d240067-2b7d-5da0-8ced-35c460f862bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}x+\\frac{7}{3}" :db/id #edb/ref 17592186523545}] :answer-field/correct {:answer/id #uuid "8d240067-2b7d-5da0-8ced-35c460f862bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}x+\\frac{7}{3}" :db/id #edb/ref 17592186523545} :answer-field/id #uuid "134b35bc-2fdc-55d1-875e-ea8fc777f10d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523802} {:answer-field/choices [{:answer/id #uuid "f31d8396-8c45-5a1c-8211-0e6b56b99240" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186523760}] :answer-field/correct {:answer/id #uuid "f31d8396-8c45-5a1c-8211-0e6b56b99240" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186523760} :answer-field/id #uuid "249d3757-eb22-5461-8905-b54111d72bd7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523806}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4a3e6aca-bc4b-546e-bf1b-908fe05212b5" :question/math-academy-id "q-167071" :question/problem "Find the $y$-intercept of $\\overset{↔}{AB},$ and express the equation of this line in slope-intercept form.\n\nThe $y$-intercept of the line is $b\\,=\\,$\n{{field-1}}\n\nThe equation is $y\\,=\\,$\n{{field-2}}" :question/worked-solution "We will write the equation of the line in the slope-intercept form \n\n$$\ny=mx+b.\n$$\n\nAs we found previously, the slope is $m=-\\frac{1}{3}.$\n\nSubstituting $m=-\\frac{1}{3}$ into the slope-intercept form above, we get\n\n$$\ny=-\\frac{1}{3}x+b.\n$$\n\nWe now need to find the $y$-intercept $b.$ We can find this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(4,1):$\n\n$$\n\\begin{aligned}y & =-\\frac{1}{3}x+b \\\\ 1 & =-(\\frac{1}{3})(4)+b \\\\ 1 & =-\\frac{4}{3}+b \\\\ 1+\\frac{4}{3} & =b \\\\ b & =\\frac{7}{3}\\end{aligned}\n$$\n\nTherefore, the equation of the line is \n\n$$\ny=-\\frac{1}{3}x+\\frac{7}{3}.\n$$"} {:db/id #edb/ref 17592186523956 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1493380f-c708-5ae2-ad63-0ba124cacc49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2\\,\\text{rad/s}" :db/id #edb/ref 17592186523297} {:answer/id #uuid "368ef356-d80b-56d6-b93f-d58e6e4b200b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.02\\,\\text{rad/s}" :db/id #edb/ref 17592186523370} {:answer/id #uuid "69614c5f-1731-5732-8a72-f2c31ba8aa90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1\\,\\text{rad/s}" :db/id #edb/ref 17592186523471} {:answer/id #uuid "9bbc4914-cd92-5ba6-9302-86b96db75dc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.25\\,\\text{rad/s}" :db/id #edb/ref 17592186523579} {:answer/id #uuid "dddb86d6-5fec-56b1-9fda-ca96845e548d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.05\\,\\text{rad/s}" :db/id #edb/ref 17592186523719}] :answer-field/correct {:answer/id #uuid "dddb86d6-5fec-56b1-9fda-ca96845e548d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.05\\,\\text{rad/s}" :db/id #edb/ref 17592186523719} :answer-field/id #uuid "d828883d-a3eb-5584-b5bd-f62f8f377e78" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523895}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "579cea6b-f87a-550f-8093-6a43bd1625a5" :question/math-academy-id "q-86352" :question/problem "![](images/8f/8f4638863dbc6bdfbff00d20d2153bb73eb7779719bbc7235d730539cb92329e.png)\n\nAngela observes that a drone is flying horizontally at a constant height of $5\\,\\text{m}$ above the ground. If the drone is flying in the opposite direction from Angela's location at a speed of $1\\,\\text{m/s},$ determine the rate at which the angle of elevation $\\theta $ decreases at the moment when $\\theta =\\frac{\\pi }{6}.$" :question/worked-solution "![](images/80/80b92831e73b31464fad3adeb1b2e3d9eed0a0df29e8f30b21bddd5f45bde230.png)\n\nIn the figure, $y$ is the drone's altitude, and $x$ is the horizontal distance between the drone and Angela. The quantity $y=5\\,\\text{m}$ does not change with time because the altitude of the drone is constant.\n\nWe wish to calculate $\\frac{\\text{d}\\theta }{\\text{d}t}.$ To do this, let's start by setting up a relation between $x$ and $y.$ Relative to the angle $\\theta ,$ the sides $x$ and $y$ are the adjacent and opposite, respectively. So, we have\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡\\theta  & =\\frac{y}{x} \\\\ \\operatorname{tan}⁡\\theta  & =\\frac{5}{x} \\\\ x & =5\\operatorname{cot}⁡\\theta .\\end{aligned}\n$$\n\nNow, we differentiate both sides of the equation with respect to $t$ using implicit differentiation, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(x) & =\\frac{\\text{d}}{\\text{d}t}(5\\operatorname{cot}⁡\\theta ) \\\\ \\frac{\\text{d}x}{\\text{d}t} & =-5{csc}^{2}⁡\\theta \\cdot \\frac{\\text{d}\\theta }{\\text{d}t}.\\end{aligned}\n$$\n\nFrom the given information, we have $\\frac{\\text{d}x}{\\text{d}t}=1$ and $\\theta =\\frac{\\pi }{6}.$ Substituting this into the above, we reach\n\n$$\n\\begin{aligned}1 & =-5{csc}^{2}⁡(\\frac{\\pi }{6})\\cdot \\frac{\\text{d}\\theta }{\\text{d}t} \\\\ 1 & =-5(2)^{2}\\cdot \\frac{\\text{d}\\theta }{\\text{d}t} \\\\ 1 & =-20\\cdot \\frac{\\text{d}\\theta }{\\text{d}t} \\\\ \\frac{\\text{d}\\theta }{\\text{d}t} & =-0.05.\\end{aligned}\n$$\n\nTherefore, the angle of elevation is *decreasing* at a rate of $0.05$ radians per second."} {:db/id #edb/ref 17592186523966 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0249d478-3dcc-5311-b2c6-8d70031c6a4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5\\pi }\\,\\text{cm/s}" :db/id #edb/ref 17592186523255} {:answer/id #uuid "119c72b2-8cca-5163-9ca8-2e6e7e6248ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{9}\\,\\text{cm/s}" :db/id #edb/ref 17592186523292} {:answer/id #uuid "27554380-74ae-59cc-9a00-1703f6d7f6b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{5\\pi }\\,\\text{cm/s}" :db/id #edb/ref 17592186523333} {:answer/id #uuid "b50bac0d-ca11-5f45-b354-8530b1736b79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{9\\pi }\\,\\text{cm/s}" :db/id #edb/ref 17592186523635} {:answer/id #uuid "c45c9a72-add8-5a9c-905f-a2e2391214d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3\\pi }\\,\\text{cm/s}" :db/id #edb/ref 17592186523665}] :answer-field/correct {:answer/id #uuid "b50bac0d-ca11-5f45-b354-8530b1736b79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{9\\pi }\\,\\text{cm/s}" :db/id #edb/ref 17592186523635} :answer-field/id #uuid "12d04c6e-e4aa-5010-b471-aea192835835" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523801}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "734a1589-9b26-5ca8-b559-8254d0411564" :question/math-academy-id "q-2840" :question/problem "![](images/77/7732722fc875e8cf13482394990baa0b5f8306a8151fca934491bb12dd181d9e.png)\n\nA  $10\\,\\text{cm}$ tall funnel containing water is being drained at a constant rate of  $10\\,{\\text{cm}}^{3}\\text{/s}.$ The mouth of the funnel is $12\\,\\text{cm}$ in diameter. How fast is the water level dropping when there is $15\\pi \\,{\\text{cm}}^{3}$ of water remaining in the funnel?" :question/worked-solution "First, let's consider the dimensions of the funnel. Let's call $H=10\\,\\text{cm}$ the height of the funnel, and $R=\\frac{12}{2}=6\\,\\text{cm}$ its radius at the top. These quantities are fixed and do not change with time.\n\nNow, let's consider the water level. We call $h$ the water level's height and $r$ the radius of the cone formed by the water. Both of these quantities, and the water volume $v,$ change with time. In particular, we know that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-10\\,{\\text{cm}}^{3}/\\text{s},\n$$\n\nand we want to find $\\frac{\\text{d}h}{\\text{d}t}$ when $v=15\\pi \\,{\\text{cm}}^{3}.$\n\nWe need to find a relation between $h$ and the variable for which we know the rate of change, which is $v.$ This is given by the formula for the volume of a cone:\n\n$$\nv=\\frac{1}{3}\\pi {r}^{2}h\n$$\n\nBefore we differentiate the equation with respect to time, note that $r$ also appears in the formula. So, we need to simplify the formula by writing $r$ in terms of $h.$\n\nNote that the cones formed by the funnel and the water must be similar. Therefore, we must have\n\n$$\n\\begin{aligned}\\frac{r}{h} & =\\frac{R}{H} \\\\ \\frac{r}{h} & =\\frac{6}{10} \\\\ r & =\\frac{3h}{5}.\\end{aligned}\n$$\n\nTherefore, we can write the volume formula as\n\n$$\n\\begin{aligned}v & =\\frac{1}{3}\\pi {r}^{2}h \\\\  & =\\frac{1}{3}\\pi {(\\frac{3h}{5})}^{2}h \\\\  & =\\frac{3}{25}\\pi {h}^{3}.\\end{aligned}\n$$\n\nNow that we have an equation relating $v$ and $h,$ we differentiate with respect to time using the chain rule:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}v & =\\frac{\\text{d}}{\\text{d}t}(\\frac{3}{25}\\pi {h}^{3}) \\\\ \\frac{\\text{d}v}{\\text{d}t} & =\\frac{9}{25}\\pi {h}^{2}\\frac{\\text{d}h}{\\text{d}t}.\\end{aligned}\n$$\n\nWe want to find the rate at which the level of water in the funnel is changing when $v=15\\pi \\,{\\text{cm}}^{3}.$ We can compute the value of $h$ at this moment as follows:\n\n$$\n\\begin{aligned}15\\pi  & =\\frac{3}{25}\\pi {h}^{3} \\\\ {h}^{3} & =125 \\\\ h & =5\\,\\text{cm}.\\end{aligned}\n$$\n\nFinally, we plug in the known values into the formula for $\\frac{\\text{d}v}{\\text{d}t}$, and we get\n\n$$\n\\begin{aligned}-10 & =\\frac{9}{25}\\pi ({5}^{2})\\frac{\\text{d}h}{\\text{d}t} \\\\ -10 & =9\\pi \\frac{\\text{d}h}{\\text{d}t} \\\\ \\frac{\\text{d}h}{\\text{d}t} & =-\\frac{10}{9\\pi }\\,\\text{cm}/\\text{s}.\\end{aligned}\n$$\n\nTherefore, the water level is decreasing at a rate of $\\frac{10}{9\\pi }\\,\\text{cm}/\\text{s}.$"} {:db/id #edb/ref 17592186523968 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dab41013-31c6-5b8c-b810-4bf4de38c3b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi" :db/id #edb/ref 17592186523711}] :answer-field/correct {:answer/id #uuid "dab41013-31c6-5b8c-b810-4bf4de38c3b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi" :db/id #edb/ref 17592186523711} :answer-field/id #uuid "6d0b2151-e0e8-5527-9aa9-647f2c498e2c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523844}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "748701f6-8780-55dc-bf9a-808d48cf28f4" :question/math-academy-id "q-344973" :question/problem "The height of a cone is increasing at a rate of $4\\,\\text{in}/\\text{s}.$ The diameter of the cone is always $4$ times its height. Find the rate of the cone's volume increase when height is $\\frac{1}{2}\\,\\text{in}.$ Do not round the answer.\n\nThe volume is increasing at a rate of\n{{field-1}} ${\\text{in}}^{3}/\\text{s}.$" :question/worked-solution "Let's call $h$ the height of the cone and $r$ the radius of its base. Both of these quantities, as well as the volume $v,$ change with time. In particular, we know that\n\n$$\n\\frac{\\text{d}h}{\\text{d}t}=4\\,\\text{in}\\text{/s},\n$$\n\nand we need to find $\\frac{\\text{d}v}{\\text{d}t}$ when $h=\\frac{1}{2}\\,\\text{in}.$\n\nWe need to find a relation between $v$ and the variable for which we know the rate of change, which is $h.$ This is given by the formula for the volume of a cone:\n\n$$\nv=\\frac{1}{3}\\pi {r}^{2}h\n$$\n\nBefore we differentiate the equation with respect to time, note that $r$ also appears in the formula. So, we need to simplify the formula by writing $r$ in terms of $h.$\n\nWe're told that the diameter is $4$ times the height. So, we have\n\n$$\n\\begin{aligned}d & =4h \\\\ 2r & =4h \\\\ r & =2h.\\end{aligned}\n$$\n\nTherefore, we can write the volume formula as\n\n$$\nv=\\frac{1}{3}\\pi {(2h)}^{2}\\cdot h=\\frac{4}{3}\\pi {h}^{3}.\n$$\n\nNow that we have an equation relating just $v$ and $h,$ we differentiate with respect to time using the chain rule. This gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}v & =\\frac{\\text{d}}{\\text{d}t}(\\frac{4}{3}\\pi {h}^{3}) \\\\ \\frac{\\text{d}v}{\\text{d}t} & =4\\pi {h}^{2}\\frac{\\text{d}h}{\\text{d}t}.\\end{aligned}\n$$\n\nFinally, substituting the known values, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}v}{\\text{d}t} & =4\\pi {(\\frac{1}{2})}^{2}(4) \\\\ \\frac{\\text{d}v}{\\text{d}t} & =4\\pi \\,{\\text{in}}^{3}/\\text{s}.\\end{aligned}\n$$\n\nThus, the cone's volume is increasing at a rate of $4\\pi \\,{\\text{in}}^{3}/\\text{s}.$"} {:db/id #edb/ref 17592186523970 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0df0f97f-4f39-5b1c-b10c-447e782fc12f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186523284} {:answer/id #uuid "6dae38db-68cf-5488-8070-c06480732642" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186523477} {:answer/id #uuid "81b9bb21-5627-5934-b71d-4ea33aa8e42b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-17" :db/id #edb/ref 17592186523530} {:answer/id #uuid "c53b0336-4b5b-5bc7-a56d-5493c7cb1d3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-35" :db/id #edb/ref 17592186523668} {:answer/id #uuid "f64ac374-af28-5718-ae03-405b4bfb5794" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186523768}] :answer-field/correct {:answer/id #uuid "0df0f97f-4f39-5b1c-b10c-447e782fc12f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186523284} :answer-field/id #uuid "6769aa7f-4e0f-5ed2-acb1-f447e8594699" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523840}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "77bfba8d-0add-517b-b669-b916e6dff897" :question/math-academy-id "q-47412" :question/problem "The equation of the normal line to the curve $y=\\frac{3}{{x}^{3}}$ at the point $(1,3)$ is given by $x+py=q$ where $p$ and $q$ are constants. Find the value of $p-q.$" :question/worked-solution "Let $f(x)=\\frac{3}{{x}^{3}}.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{3}{{x}^{3}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{-3}) \\\\  & =-9{x}^{-4} \\\\  & =-\\frac{9}{{x}^{4}}\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(1,3):$\n\n$$\n\\begin{aligned}m={f}^{′}(1)=-\\frac{9}{(1)^{4}}=-9\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=\\frac{1}{9}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-(3) & =\\frac{1}{9}(x-1) \\\\ 9y-27 & =x-1 \\\\ x-9y & =-26.\\end{aligned}\n$$\n\nTherefore, $p-q=-9-(-26)=17.$"} {:db/id #edb/ref 17592186523973 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0258576c-2f5d-548e-804e-389c4853daef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186523256}] :answer-field/correct {:answer/id #uuid "0258576c-2f5d-548e-804e-389c4853daef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186523256} :answer-field/id #uuid "e388d934-e923-52d0-a739-f7b5c411547b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523905}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7cce7dd9-a52f-5429-96fd-d564ac81f3b8" :question/math-academy-id "q-314057" :question/problem "The volume of a cone is increasing at a rate of $\\frac{3}{4}\\pi \\,{\\text{m}}^{3}\\text{/s}.$ The diameter of the cone is always one third of its height.  Find the rate of the cone's height increase when the  height is $6\\,\\text{m}.$ Do not round the answer.\n\nThe height is increasing at a rate of\n{{field-1}} $\\text{ m/s}.$" :question/worked-solution "Let's call $h$ the height of the cone and $r$ the radius of its base. Both of these quantities, as well as the volume $v,$ change with time. In particular, we know that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{3}{4}\\pi \\,{\\text{m}}^{3}\\text{/s},\n$$\n\nand we need to find $\\frac{\\text{d}h}{\\text{d}t}$ when $h=6\\,\\text{m}.$\n\nWe need to find a relation between $h$ and the variable for which we know the rate of change, which is $v.$ This is given by the formula for the volume of a cone:\n\n$$\nv=\\frac{1}{3}\\pi {r}^{2}h\n$$\n\nBefore we differentiate the equation with respect to time, note that $r$ also appears in the formula. So, we need to simplify the formula by writing $r$ in terms of $h.$\n\nWe're told that the diameter is one third of the height. So, we have\n\n$$\n\\begin{aligned}d & =\\frac{1}{3}h \\\\ 2r & =\\frac{1}{3}h \\\\ r & =\\frac{1}{6}h.\\end{aligned}\n$$\n\nTherefore, we can write the volume formula as\n\n$$\nv=\\frac{1}{3}\\pi {(\\frac{1}{6}h)}^{2}h=\\frac{1}{108}\\pi {h}^{3}.\n$$\n\nNow that we have an equation relating $v$ and $h,$ we differentiate with respect to time using the chain rule. This gives\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{1}{36}\\pi {h}^{2}(\\frac{\\text{d}h}{\\text{d}t}).\n$$\n\nFinally, substituting the known values and solving for $\\frac{\\text{d}h}{\\text{d}t},$ we get\n\n$$\n\\begin{aligned}\\frac{3}{4}\\pi  & =\\frac{1}{36}\\pi (6)^{2}(\\frac{\\text{d}h}{\\text{d}t}) \\\\ \\frac{\\text{d}h}{\\text{d}t} & =\\frac{3}{4}.\\end{aligned}\n$$\n\nThus, the cone's height is increasing at a rate of $\\frac{3}{4}\\text{ m/s}.$"} {:db/id #edb/ref 17592186523974 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69fb2899-b036-54ad-a324-ab7b25c590cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,\\text{cm}/\\text{min}" :db/id #edb/ref 17592186523473} {:answer/id #uuid "80795005-7359-5d8c-8f47-fa8cce93244e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5\\,\\text{cm}/\\text{min}" :db/id #edb/ref 17592186523528} {:answer/id #uuid "8b4c38d6-9e86-5118-af92-02f7b458a6e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\text{cm}/\\text{min}" :db/id #edb/ref 17592186523542} {:answer/id #uuid "9e13c728-dd08-55eb-9f0d-ac9fa0d1a989" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.5\\,\\text{cm}/\\text{min}" :db/id #edb/ref 17592186523584} {:answer/id #uuid "b8f8255a-7a62-5923-8d18-5d266361f1cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.25\\,\\text{cm}/\\text{min}" :db/id #edb/ref 17592186523643}] :answer-field/correct {:answer/id #uuid "8b4c38d6-9e86-5118-af92-02f7b458a6e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\text{cm}/\\text{min}" :db/id #edb/ref 17592186523542} :answer-field/id #uuid "beb4e4f6-e48c-5e57-a5a4-043092d6909c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523885}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7d9fecf0-f483-51c1-b6ab-f1ee3ed71254" :question/math-academy-id "q-51396" :question/problem "![](images/86/8676d9a562d254a1194502c5a45368d5345f81aee3a066c28acc87cb1f33812c.png)\n\nThe height of an ice cream cone is $12\\,\\text{cm}$ and the radius at the top of the cone is $2\\,\\text{cm}.$ Ice cream is leaking from a small hole at the bottom at a rate of $2\\pi \\,{\\text{cm}}^{3}/\\text{min}.$ If the ice cream level is $6\\,\\text{cm}$ at a particular moment, how fast is the ice cream level decreasing at that moment?" :question/worked-solution "First, let's consider the dimensions of the cone. Let's call $H=12\\,\\text{cm}$ the height of the cone, and $R=2\\,\\text{cm}$ its radius at the top. These quantities are fixed and do not change with time.\n\nNow, let's consider the ice cream level. We call $h$ the height of the ice cream in the cone and $r$ the radius of the ice cream top surface. Both of these quantities, and the ice cream volume $v,$ change with time. In particular, we know that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-2\\pi \\,{\\text{cm}}^{3}/\\text{min},\n$$\n\nand we want to find the rate of change of the ice cream level $\\frac{\\text{d}h}{\\text{d}t}$ when $h=6\\,\\text{cm}.$\n\nWe need to find a relation between $v$ and the variable for which we know the rate of change, which is $h.$ This is given by the formula for the volume of the ice cream:\n\n$$\nv=\\frac{1}{3}\\pi {r}^{2}h\n$$\n\nBefore we differentiate the equation with respect to time, note that $r$ also appears in the formula. So, we need to simplify the formula by writing $r$ in terms of $h.$\n\nNote that the cone and the ice cream part of the cone must be similar. Therefore, we have\n\n$$\n\\begin{aligned}\\frac{r}{h} & =\\frac{R}{H} \\\\ \\frac{r}{h} & =\\frac{2}{12} \\\\ r & =\\frac{h}{6}\\,.\\end{aligned}\n$$\n\nTherefore, we can write the volume formula as\n\n$$\n\\begin{aligned}v & =\\frac{1}{3}\\pi {(\\frac{h}{6})}^{2}h \\\\  & =\\frac{1}{108}\\pi {h}^{3}\\,.\\end{aligned}\n$$\n\nNow that we have an equation relating $v$ and $h,$ we differentiate with respect to time using the chain rule:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}v & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{108}\\pi {h}^{3}) \\\\ \\frac{\\text{d}v}{\\text{d}t} & =\\frac{1}{36}\\pi {h}^{2}\\frac{\\text{d}h}{\\text{d}t}\\end{aligned}\n$$\n\nWe want to find the rate of change of the ice cream level in the cone when $h=6\\,\\text{cm}.$ We can compute the value of $h$ at this moment as follows:\n\n$$\n\\begin{aligned}-2\\pi  & =\\frac{1}{36}\\pi ({6}^{2})\\frac{\\text{d}h}{\\text{d}t} \\\\ \\frac{\\text{d}h}{\\text{d}t} & =-2\\,\\text{cm/min}.\\end{aligned}\n$$\n\nTherefore, the height of the ice cream is decreasing at a rate of $2\\,\\text{cm/min}.$"} {:db/id #edb/ref 17592186523976 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c15fca13-90c5-5a81-bbbf-80c06db848a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30\\pi" :db/id #edb/ref 17592186523658}] :answer-field/correct {:answer/id #uuid "c15fca13-90c5-5a81-bbbf-80c06db848a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30\\pi" :db/id #edb/ref 17592186523658} :answer-field/id #uuid "d870faa5-187d-5160-bfd1-02d58f3d6875" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523896}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "82671b33-6326-52d6-9a89-56b07cb04dfe" :question/math-academy-id "q-343159" :question/problem "![](images/55/55e96238e8263a1744c117bad09d1b11947f70a8bf1b837c52af18cf2e244ab7.png)\n\nA park ranger $P$ stands $900\\,\\text{ft}$ away from the base of a lookout tower $T$ to track a drone $D$ that is ascending vertically. The angle of elevation $\\theta $ formed by the ranger and the drone is increasing at a rate of $\\frac{\\pi }{60}$ radians per second. At what rate is the drone gaining altitude at the moment when $\\theta ={45}^{∘}?$ Do not round the answer.\n\nThe drone’s altitude is increasing at a rate of\n{{field-1}}\n$\\text{ft/s}.$" :question/worked-solution "![](images/d3/d30d2927efb6e85c408ba113499e043f72d726267e114e853690ac788c3946b1.png)\n\n \n\nIn the figure, $x$ is the distance between the ranger and the drone's takeoff position, and $y$ is the altitude of the drone. The quantity $x=900\\,\\text{ft}$ does not change with time because the distance between the ranger and the takeoff position is fixed.\n\nWe wish to calculate $\\frac{\\text{d}y}{\\text{d}t}.$ To do this, let's start by setting up a relation between $x$ and $y.$ Relative to the angle $\\theta ,$ the sides $x$ and $y$ are the adjacent and opposite, respectively. So, we have\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡\\theta  & =\\frac{y}{x} \\\\ \\operatorname{tan}⁡\\theta  & =\\frac{y}{900} \\\\ y & =900\\operatorname{tan}⁡\\theta .\\end{aligned}\n$$\n\nNow, we differentiate both sides of the equation with respect to $t$ using implicit differentiation, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(y) & =\\frac{\\text{d}}{\\text{d}t}(900\\operatorname{tan}⁡\\theta ) \\\\ \\frac{\\text{d}y}{\\text{d}t} & =900{sec}^{2}⁡\\theta \\cdot \\frac{\\text{d}\\theta }{\\text{d}t}.\\end{aligned}\n$$\n\nFrom the given information, we have $\\frac{\\text{d}\\theta }{\\text{d}t}=\\frac{\\pi }{60}$ and $\\theta ={45}^{∘}.$ Substituting these values into the above, we reach\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =900{sec}^{2}⁡({45}^{∘})(\\frac{\\pi }{60}) \\\\ \\frac{\\text{d}y}{\\text{d}t} & =900{(\\sqrt{2})}^{2}(\\frac{\\pi }{60}) \\\\ \\frac{\\text{d}y}{\\text{d}t} & =30\\pi .\\end{aligned}\n$$\n\nTherefore, the drone's altitude is increasing at a rate of $30\\pi \\,\\text{ft/s}.$"} {:db/id #edb/ref 17592186523977 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00e67d9a-a462-5f7e-b2cd-0ba68c332cb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\pi }\\,\\text{cm/s}" :db/id #edb/ref 17592186523251} {:answer/id #uuid "468e364f-adb7-5316-81c4-30d5f46d5a70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi \\,\\text{cm}\\text{/s}" :db/id #edb/ref 17592186523399} {:answer/id #uuid "c7163626-4b88-545e-8c81-82995ff45ea0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi \\,\\text{cm}\\text{/s}" :db/id #edb/ref 17592186523672} {:answer/id #uuid "d10f03ec-49e1-57de-bfcd-f75d2f7decf7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{\\pi }\\,\\text{cm}\\text{/s}" :db/id #edb/ref 17592186523693} {:answer/id #uuid "d6781a0a-396a-5cdc-9fb4-752741391dc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\pi }\\,\\text{cm}\\text{/s}" :db/id #edb/ref 17592186523705}] :answer-field/correct {:answer/id #uuid "00e67d9a-a462-5f7e-b2cd-0ba68c332cb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\pi }\\,\\text{cm/s}" :db/id #edb/ref 17592186523251} :answer-field/id #uuid "0403bdc2-182d-5f43-a2bb-37b77dc8facc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523792}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "829ceea0-b4f0-5bef-b797-d4b161d8e247" :question/math-academy-id "q-2558" :question/problem "![](images/a9/a9c0d78ce05859db77dcc1e5198596a1a02c798c607ba9c4ff78e6fe1362b113.png)\n\nThe height of a conical cup is $6\\text{ cm}$ and the opening radius is $2\\text{ cm}.$ Water leaks out of the bottom at the rate of $2\\,{\\text{cm}}^{3}\\text{/s}.$ If the water level is $3\\,\\text{cm}$ at a particular moment, how fast is the water level decreasing at that moment?" :question/worked-solution "First, let's consider the dimensions of the cup. Let's call $H=6\\,\\text{cm}$ the height of the cup, and $R=2\\,\\text{cm}$ its radius at the top. These quantities are fixed and do not change with time.\n\nNow, let's consider the water level. We call $h$ the water level's height and $r$ the radius of the cone formed by the water. Both of these quantities, and the water volume $v,$ change with time. In particular, we know that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-2\\,{\\text{cm}}^{3}/\\text{s},\n$$\n\nand we want to find $\\frac{\\text{d}v}{\\text{d}t}$ when $h=3\\,\\text{cm}.$\n\nWe need to find a relation between $h$ and the variable for which we know the rate of change, which is $v.$ This is given by the formula for the volume of a cone:\n\n$$\nv=\\frac{1}{3}\\pi {r}^{2}h\n$$\n\nBefore we differentiate the equation with respect to time, note that $r$ also appears in the formula. So, we need to simplify the formula by writing $r$ in terms of $h.$\n\nNote that the cones formed by the cup and the water must be similar. Therefore, we must have\n\n$$\n\\begin{aligned}\\frac{r}{h} & =\\frac{R}{H} \\\\ \\frac{r}{h} & =\\frac{2}{6} \\\\ r & =\\frac{h}{3}.\\end{aligned}\n$$\n\nTherefore, we can write the volume formula as\n\n$$\n\\begin{aligned}v & =\\frac{1}{3}\\pi {r}^{2}h \\\\  & =\\frac{1}{3}\\pi {(\\frac{h}{3})}^{2}h \\\\  & =\\frac{1}{27}\\pi {h}^{3}.\\end{aligned}\n$$\n\nNow that we have an equation relating $v$ and $h,$ we differentiate with respect to time using the chain rule:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}v & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{27}\\pi {h}^{3}) \\\\ \\frac{\\text{d}v}{\\text{d}t} & =\\frac{1}{9}\\pi {h}^{2}\\frac{\\text{d}h}{\\text{d}t}.\\end{aligned}\n$$\n\nFinally, we plug in the known values, and we get\n\n$$\n\\begin{aligned}-2 & =\\frac{1}{9}\\pi ({3}^{2})\\frac{\\text{d}h}{\\text{d}t} \\\\ -2 & =\\pi \\frac{\\text{d}h}{\\text{d}t} \\\\ \\frac{\\text{d}h}{\\text{d}t} & =-\\frac{2}{\\pi }\\,\\text{cm}/\\text{s}.\\end{aligned}\n$$\n\nTherefore, the water level is decreasing at a rate of $\\frac{2}{\\pi }\\,\\text{cm/s}.$"} {:db/id #edb/ref 17592186523998 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa70caeb-2f25-52b2-8b3f-fb7c469344cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\pi" :db/id #edb/ref 17592186523778}] :answer-field/correct {:answer/id #uuid "fa70caeb-2f25-52b2-8b3f-fb7c469344cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\pi" :db/id #edb/ref 17592186523778} :answer-field/id #uuid "feafb06a-b02a-5dd2-94bc-ae63b61d224f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523919}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a8aac6cd-427e-5b7e-aea2-44c84e419786" :question/math-academy-id "q-344979" :question/problem "The height of a cone is decreasing at a rate of $6\\,\\text{cm}/\\text{s}.$ The diameter of the cone is always $4$ times its height. Find the rate of the cone's volume decrease when the height is $\\frac{1}{2}\\,\\text{cm}.$ Do not round the answer. \n\n*Hint*: Assume that the rate of decrease is positive.\n\nThe volume is decreasing at a rate of\n{{field-1}} ${\\text{cm}}^{3}/\\text{s}.$" :question/worked-solution "Let's call $h$ the height of the cone and $r$ the radius of its base. Both of these quantities, as well as the volume $v,$ change with time. In particular, we know that\n\n$$\n\\frac{\\text{d}h}{\\text{d}t}=-6\\,\\text{cm}/\\text{s},\n$$\n\nand we need to find $\\frac{\\text{d}v}{\\text{d}t}$ when $h=\\frac{1}{2}\\,\\text{cm}.$\n\nWe need to find a relation between $v$ and the variable for which we know the rate of change, which is $h.$ This is given by the formula for the volume of a cone:\n\n$$\nv=\\frac{1}{3}\\pi {r}^{2}h\n$$\n\nBefore we differentiate the equation with respect to time, note that $r$ also appears in the formula. So, we need to simplify the formula by writing $r$ in terms of $h.$\n\nWe're told that the diameter is $4$ times the height. So, we have\n\n$$\n\\begin{aligned}d & =4h \\\\ 2r & =4h \\\\ r & =2h.\\end{aligned}\n$$\n\nTherefore, we can write the volume formula as\n\n$$\nv=\\frac{1}{3}\\pi {(2h)}^{2}\\cdot h=\\frac{4}{3}\\pi {h}^{3}.\n$$\n\nNow that we have an equation relating just $v$ and $h,$ we differentiate with respect to time using the chain rule. This gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}v & =\\frac{\\text{d}}{\\text{d}t}(\\frac{4}{3}\\pi {h}^{3}) \\\\ \\frac{\\text{d}v}{\\text{d}t} & =4\\pi {h}^{2}\\frac{\\text{d}h}{\\text{d}t}.\\end{aligned}\n$$\n\nFinally, substituting the known values, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}v}{\\text{d}t} & =4\\pi {(\\frac{1}{2})}^{2}(-6) \\\\ \\frac{\\text{d}v}{\\text{d}t} & =-6\\pi \\,{\\text{cm}}^{3}/\\text{s}.\\end{aligned}\n$$\n\nThus, the cone's volume is decreasing at a rate of $6\\pi \\,{\\text{cm}}^{3}/\\text{s}.$"} {:db/id #edb/ref 17592186524000 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3325c758-6521-5b3c-b952-88a1c7f3a5c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "96\\pi {\\text{ in}}^{3}\\text{/h}" :db/id #edb/ref 17592186523361} {:answer/id #uuid "34f99a8a-1aff-5e48-8263-1c14bb296f09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60\\pi {\\text{ in}}^{3}\\text{/h}" :db/id #edb/ref 17592186523364} {:answer/id #uuid "5e041c4f-bd1d-58b3-a192-9214f42c132b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30\\pi {\\text{ in}}^{3}\\text{/h}" :db/id #edb/ref 17592186523445} {:answer/id #uuid "8026da22-c9eb-5c97-bc44-dd272fdbe3e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "54\\pi {\\text{ in}}^{3}\\text{/h}" :db/id #edb/ref 17592186523526} {:answer/id #uuid "e72d9225-9845-59c5-9e04-07e4b8235685" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40\\pi {\\text{ in}}^{3}\\text{/h}" :db/id #edb/ref 17592186523741}] :answer-field/correct {:answer/id #uuid "5e041c4f-bd1d-58b3-a192-9214f42c132b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30\\pi {\\text{ in}}^{3}\\text{/h}" :db/id #edb/ref 17592186523445} :answer-field/id #uuid "60ec6a45-4404-5e20-a3cb-94bf7320ffb4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523837}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a9bed4a9-ed2b-5603-85e6-df6b8285a648" :question/math-academy-id "q-2858" :question/problem "![](images/51/51ee41eea6dfef1292c68a13a438f43c327639e01452e29998bbe513ac3838ba.png)\n\nA container has the shape of a right circular cone. The height of the container is $20\\,\\text{in}$ and the diameter at the top of the container is $10\\,\\text{in}.$ Water in the container is evaporating so that its depth, $h$, is decreasing at a constant rate of $\\frac{10}{3}\\,\\text{in/h}.$ At what rate is the volume of water decreasing when the water depth is $12\\,\\text{in}?$" :question/worked-solution "First, let's consider the dimensions of the container. Let's call $H=20\\,\\text{in}$ the height of the conical container, and $R=\\frac{10}{2}=5\\,\\text{in}$ its radius at the top. These quantities are fixed and do not change with time.\n\nNow, let's consider the water level. We call $h$ the height of the water and $r$ the radius of the cone formed by the water. Both of these quantities, and the water volume $v,$ change with time. In particular, we know that\n\n$$\n\\frac{\\text{d}h}{\\text{d}t}=-\\frac{10}{3}\\,\\text{in}/\\text{h},\n$$\n\nand we want to know $\\frac{\\text{d}v}{\\text{d}t}$ when $h=12\\,\\text{in}.$\n\nWe need to find a relation between $v$ and the variable for which we know the rate of change, which is $h.$ This is given by the formula for the volume of a cone:\n\n$$\nv=\\frac{1}{3}\\pi {r}^{2}h\n$$\n\nBefore we differentiate the equation with respect to time, note that $r$ also appears in the formula. So, we need to simplify the formula by writing $r$ in terms of $h.$\n\nNote that the cones formed by the container and the water must be similar. Therefore, we have\n\n$$\n\\begin{aligned}\\frac{r}{h} & =\\frac{R}{H} \\\\ \\frac{r}{h} & =\\frac{5}{20} \\\\ r & =\\frac{h}{4}.\\end{aligned}\n$$\n\nTherefore, we can write the volume formula as\n\n$$\n\\begin{aligned}v & =\\frac{1}{3}\\pi {(\\frac{h}{4})}^{2}h \\\\ v & =\\frac{1}{48}\\pi {h}^{3}.\\end{aligned}\n$$\n\nNow that we have an equation relating $v$ and $h,$ we differentiate with respect to time using the chain rule:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}v & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{48}\\pi {h}^{3}) \\\\ \\frac{\\text{d}v}{\\text{d}t} & =\\frac{1}{16}\\pi {h}^{2}\\frac{\\text{d}h}{\\text{d}t}\\end{aligned}\n$$\n\nWe want to find the rate at which the volume of water in the container is changing when $h=12\\,\\text{in}.$ So,\n\n$$\n\\begin{aligned}\\frac{\\text{d}v}{\\text{d}t} & =\\frac{1}{16}\\pi (12)^{2}(-\\frac{10}{3}) \\\\ \\frac{\\text{d}v}{\\text{d}t} & =-30\\pi \\,{\\text{in}}^{3}/\\text{h}.\\end{aligned}\n$$\n\nTherefore, the volume of water is decreasing at a rate of $30\\pi \\,{\\text{in}}^{3}/\\text{h}.$"} {:db/id #edb/ref 17592186524006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "229bed8d-b5d3-58ef-a06f-be1e52de4063" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{14}\\,\\text{in}/\\text{h}" :db/id #edb/ref 17592186523320} {:answer/id #uuid "93180942-662e-521d-95f4-59f18fd03a19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{14}\\,\\text{in}/\\text{h}" :db/id #edb/ref 17592186523563} {:answer/id #uuid "a21f0c1b-6a7d-5506-8dce-b92d689a2837" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{14}\\,\\text{in}/\\text{h}" :db/id #edb/ref 17592186523594} {:answer/id #uuid "b18d3479-01df-5337-bbb1-e4fa31aead16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{49}\\,\\text{in}/\\text{h}" :db/id #edb/ref 17592186523629} {:answer/id #uuid "fceac06e-7b17-533f-bd12-c185f7837e53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{7}\\,\\text{in}/\\text{h}" :db/id #edb/ref 17592186523784}] :answer-field/correct {:answer/id #uuid "93180942-662e-521d-95f4-59f18fd03a19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{14}\\,\\text{in}/\\text{h}" :db/id #edb/ref 17592186523563} :answer-field/id #uuid "2d2e2d58-67fb-57e4-aef4-64ca1ad57e53" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523812}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "babb3260-0ebb-5378-81f6-fb356d66422e" :question/math-academy-id "q-121579" :question/problem "The volume of a cone is decreasing at a rate of $14\\pi \\,{\\text{in}}^{3}/\\text{h}.$ The radius of the cone is always $7$ times its height. At what rate is the height of the cone decreasing when its height is $2\\,\\text{in}?$" :question/worked-solution "Let's call $h$ the height of the cone and $r$ the radius of its base. Both of these quantities, as well as the volume $v,$ change with time. In particular, we know that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-14\\pi \\,{\\text{in}}^{3}/\\text{h},\n$$\n\nand we need to find $\\frac{\\text{d}h}{\\text{d}t}$ when $h=2\\,\\text{in}.$\n\nWe need to find a relation between $v$ and the variable for which we know the rate of change, which is $h.$ This is given by the formula for the volume of a cone:\n\n$$\nv=\\frac{1}{3}\\pi {r}^{2}h\n$$\n\nBefore we differentiate the equation with respect to time, note that $r$ also appears in the formula. So, we need to simplify the formula by writing $r$ in terms of $h.$\n\nWe're told that the radius of the cone is $7$ times its height. So, we have\n\n$$\n\\begin{aligned}r & =7h.\\end{aligned}\n$$\n\nTherefore, we can write the volume formula as\n\n$$\nv=\\frac{1}{3}\\pi (7h)^{2}\\cdot h=\\frac{49}{3}\\pi {h}^{3}.\n$$\n\nNow that we have an equation relating just $v$ and $h,$ we differentiate with respect to time using the chain rule. This gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}v}{\\text{d}t} & =49\\pi {h}^{2}(\\frac{\\text{d}h}{\\text{d}t}).\\end{aligned}\n$$\n\nFinally, substituting the known values and solving for $\\frac{\\text{d}h}{\\text{d}t},$ we get\n\n$$\n\\begin{aligned}-14\\pi  & =49\\pi (2)^{2}(\\frac{\\text{d}h}{\\text{d}t}) \\\\ \\frac{\\text{d}h}{\\text{d}t} & =-\\frac{1}{14}\\,\\text{in/h}.\\end{aligned}\n$$\n\nTherefore, the height of the cone is decreasing at a rate of $\\frac{1}{14}\\,\\text{in}/\\text{h}.$"} {:db/id #edb/ref 17592186524010 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "363dfa66-499c-5d2c-a96a-6760e5b32e6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+2" :db/id #edb/ref 17592186523369}] :answer-field/correct {:answer/id #uuid "363dfa66-499c-5d2c-a96a-6760e5b32e6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+2" :db/id #edb/ref 17592186523369} :answer-field/id #uuid "4d80dd15-54e7-5576-9c18-bbe7d5170a37" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523829}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c73684cd-cbd4-53ce-a02e-b8f120478413" :question/math-academy-id "q-167076" :question/problem "Write the equation of the line that passes through the point $(2,8)$ and is perpendicular to $\\overset{↔}{AB}.$\n\nThe slope-intercept form of the equation is $y\\,=\\,$\n{{field-1}}" :question/worked-solution "Perpendicular lines have slopes that are negative reciprocals of each other. Therefore, since $\\overset{↔}{AB}$ has the slope $m=-\\frac{1}{3},$ our perpendicular line must have a slope of \n\n$$\n{m}_{1}=-\\frac{1}{m}=-\\frac{1}{(-\\frac{1}{3})}=3.\n$$\n\nSo, our perpendicular line has the slope ${m}_{1}=3$ and passes through the point $({x}_{1},{y}_{1})=(2,8).$ \n\nFinally, using point-slope form and simplifying, we obtain the following equation:\n\n$$\n\\begin{aligned}y-{y}_{1} & ={m}_{1}(x-{x}_{1}) \\\\ y-8 & =3(x-2) \\\\ y-8 & =3x-6 \\\\ y & =3x+2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186524012 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a4af37e-6b2f-57b0-a6f0-ff63aa93a160" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186523376} {:answer/id #uuid "3b6dcd76-9c75-5cab-a7e3-98ec9a075e7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186523378} {:answer/id #uuid "8e9d1766-796c-5f7e-b81b-0f2e720704a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{9}" :db/id #edb/ref 17592186523551} {:answer/id #uuid "f09476ea-f87a-5f66-921f-9f3fefea5c34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186523757} {:answer/id #uuid "fbd47810-d0f2-5cff-a8e5-e4945ca20335" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186523781}] :answer-field/correct {:answer/id #uuid "8e9d1766-796c-5f7e-b81b-0f2e720704a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{9}" :db/id #edb/ref 17592186523551} :answer-field/id #uuid "7c700890-f7ec-5058-9334-5a60b70722d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523850}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ccfa4d84-7836-5556-9446-f447928d0c91" :question/math-academy-id "q-103539" :question/problem "Find the slope of the normal line to the curve $y=\\frac{1}{4{x}^{2}}+\\frac{x}{2}$ at the point $(-\\frac{1}{2},\\frac{3}{4}).$" :question/worked-solution "Let $f(x)=\\frac{1}{4{x}^{2}}+\\frac{x}{2}.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{4{x}^{2}}+\\frac{x}{2}) \\\\  & =-\\frac{1}{2}{x}^{-3}+\\frac{1}{2}.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(-\\frac{1}{2}),$ which gives\n\n$$\n\\begin{aligned}{f}^{′}(-\\frac{1}{2})=-\\frac{1}{2}\\cdot {(-\\frac{1}{2})}^{-3}+\\frac{1}{2}=\\frac{9}{2}.\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{2}{9}.\n$$"} {:db/id #edb/ref 17592186524018 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "056a5d91-b8d1-5034-8b2c-8042c880a87f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi \\,\\text{in}/\\text{s}" :db/id #edb/ref 17592186523264} {:answer/id #uuid "7bf8fedf-c4d0-57a1-b87f-123455f19838" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4\\pi }\\,\\text{in}/\\text{s}" :db/id #edb/ref 17592186523512} {:answer/id #uuid "7c443a45-9404-54f4-93dd-6d71dc7f3bdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\pi }\\,\\text{in}/\\text{s}" :db/id #edb/ref 17592186523514} {:answer/id #uuid "83cce91b-baa0-5b4c-a9d5-d79bc959c759" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2\\pi }\\,\\text{in}/\\text{s}" :db/id #edb/ref 17592186523533} {:answer/id #uuid "b13b97bc-d673-581c-880d-84a73ebfe6a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi \\,\\text{in}/\\text{s}" :db/id #edb/ref 17592186523627}] :answer-field/correct {:answer/id #uuid "7c443a45-9404-54f4-93dd-6d71dc7f3bdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\pi }\\,\\text{in}/\\text{s}" :db/id #edb/ref 17592186523514} :answer-field/id #uuid "3a4767cd-3a6a-5b55-9fbe-f78b2bfcbb23" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523816}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d9e85e6a-5a02-52f7-ba3c-489084bc4a6f" :question/math-academy-id "q-85828" :question/problem "The volume of a cone is decreasing at a rate of $72\\,{\\text{in}}^{3}/\\text{s}.$ The radius of the cone is always equal to its height. At what rate is the height of the cone decreasing when its height is $6\\,\\text{in}?$" :question/worked-solution "Let's call $h$ the height of the cone and $r$ the radius of its base. Both of these quantities, as well as the volume $v,$ change with time. In particular, we know that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-72\\,{\\text{in}}^{3}/\\text{s},\n$$\n\nand we need to find $\\frac{\\text{d}h}{\\text{d}t}$ when $h=6\\,\\text{in}.$\n\nWe need to find a relation between $v$ and the variable for which we know the rate of change, which is $h.$ This is given by the formula for the volume of a cone:\n\n$$\nv=\\frac{1}{3}\\pi {r}^{2}h\n$$\n\nBefore we differentiate the equation with respect to time, note that $r$ also appears in the formula. So, we need to simplify the formula by writing $r$ in terms of $h.$\n\nWe're told that the radius of the cone is equal to its height. So, we have\n\n$$\n\\begin{aligned}r & =h.\\end{aligned}\n$$\n\nTherefore, we can write the volume formula as\n\n$$\nv=\\frac{1}{3}\\pi (h)^{2}\\cdot h=\\frac{1}{3}\\pi {h}^{3}.\n$$\n\nNow that we have an equation relating just $v$ and $h,$ we differentiate with respect to time using the chain rule. This gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}v}{\\text{d}t} & =\\pi {h}^{2}(\\frac{\\text{d}h}{\\text{d}t}).\\end{aligned}\n$$\n\nFinally, substituting the known values and solving for $\\frac{\\text{d}h}{\\text{d}t},$ we get\n\n$$\n\\begin{aligned}-72 & =\\pi (6)^{2}(\\frac{\\text{d}h}{\\text{d}t}) \\\\ \\frac{\\text{d}h}{\\text{d}t} & =-\\frac{2}{\\pi }\\,\\text{in/s}.\\end{aligned}\n$$\n\nTherefore, the height of the cone is decreasing at a rate of $\\frac{2}{\\pi }\\,\\text{in}/\\text{s}.$"} {:db/id #edb/ref 17592186524020 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a7f5af7-8937-5cd1-bd31-facbaffaf5a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.87\\,\\text{cm}/\\text{min}" :db/id #edb/ref 17592186523437} {:answer/id #uuid "67fb0ca3-d14d-5634-a340-353b7218f4cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.31\\,\\text{cm}/\\text{min}" :db/id #edb/ref 17592186523468} {:answer/id #uuid "9de73f60-a26b-5029-90f2-6c89c972694e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.14\\,\\text{cm}/\\text{min}" :db/id #edb/ref 17592186523583} {:answer/id #uuid "c184ced2-0b13-56b9-9636-16ecaf5ff14f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.45\\,\\text{cm}/\\text{min}" :db/id #edb/ref 17592186523659} {:answer/id #uuid "eca9e441-c13f-5522-8094-775e21954936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.94\\,\\text{cm}/\\text{min}" :db/id #edb/ref 17592186523749}] :answer-field/correct {:answer/id #uuid "eca9e441-c13f-5522-8094-775e21954936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.94\\,\\text{cm}/\\text{min}" :db/id #edb/ref 17592186523749} :answer-field/id #uuid "10f169f1-1b8d-5c6c-9710-963782923595" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523799}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e05d5196-22d0-5390-9d3c-413318bc7364" :question/math-academy-id "q-121673" :question/problem "![](images/cf/cf9fda11d138a5227307070d52fc0a27ce9decc35c91efbb026b89d4507f2ce7.png)\n\nA beverage is pumped into a conical dispenser at a constant rate of  $19.6\\pi \\,{\\text{cm}}^{3}\\text{/min}.$ The mouth of the tank is $70\\,\\text{cm}$ in diameter and the height of the tank is $40\\,\\text{cm}.$ How fast is the beverage level increasing when the volume of the beverage in the dispenser is $12.25\\pi \\,{\\text{cm}}^{3}?$ Round your answer to two decimal places." :question/worked-solution "First, let's consider the dimensions of the tank. Let's call $H=40\\,\\text{cm}$ the height of the tank, and $R=\\frac{70}{2}=35\\,\\text{cm}$ its radius at the top. These quantities are fixed and do not change with time.\n\nNow, let's consider the solution level. We call $h$ the solution level's height and $r$ the radius of the cone formed by the solution. Both of these quantities, and the solution volume $v,$ change with time. In particular, we know that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=19.6\\pi \\,{\\text{cm}}^{3}/\\text{min},\n$$\n\nand we want to find $\\frac{\\text{d}h}{\\text{d}t}$ when $v=12.25\\pi \\,{\\text{cm}}^{3}.$\n\nWe need to find a relation between $h$ and the variable for which we know the rate of change, which is $v.$ This is given by the formula for the volume of a cone:\n\n$$\nv=\\frac{1}{3}\\pi {r}^{2}h\n$$\n\nBefore we differentiate the equation with respect to time, note that $r$ also appears in the formula. So, we need to simplify the formula by writing $r$ in terms of $h.$\n\nNote that the cones formed by the tank and the solution must be similar. Therefore, we must have\n\n$$\n\\begin{aligned}\\frac{r}{h} & =\\frac{R}{H} \\\\ \\frac{r}{h} & =\\frac{35}{40} \\\\ r & =\\frac{7h}{8}.\\end{aligned}\n$$\n\nTherefore, we can write the volume formula as\n\n$$\n\\begin{aligned}v & =\\frac{1}{3}\\pi {r}^{2}h \\\\  & =\\frac{1}{3}\\pi {(\\frac{7h}{8})}^{2}h \\\\  & =\\frac{49}{192}\\pi {h}^{3}.\\end{aligned}\n$$\n\nNow that we have an equation relating $v$ and $h,$ we differentiate with respect to time using the chain rule:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}v & =\\frac{\\text{d}}{\\text{d}t}(\\frac{49}{192}\\pi {h}^{3}) \\\\ \\frac{\\text{d}v}{\\text{d}t} & =\\frac{49}{64}\\pi {h}^{2}\\frac{\\text{d}h}{\\text{d}t}.\\end{aligned}\n$$\n\nWe want to find the rate at which the level of the beverage in the dispenser is changing when $v=12.25\\pi \\,{\\text{cm}}^{3}.$ We can compute the value of $h$ at this moment as follows:\n\n$$\n\\begin{aligned}12.25\\pi  & =\\frac{49}{192}\\pi {h}^{3} \\\\ {h}^{3} & =48 \\\\ h & =2\\sqrt[3]{6}\\,\\text{cm}.\\end{aligned}\n$$\n\nFinally, we plug in the known values into the formula for $\\frac{\\text{d}v}{\\text{d}t}$, and we get\n\n$$\n\\begin{aligned}19.6\\pi  & =\\frac{49}{64}\\pi (2\\sqrt[3]{6})^{2}\\frac{\\text{d}h}{\\text{d}t} \\\\ 19.6\\pi  & =\\frac{49\\sqrt[3]{36}}{16}\\pi \\frac{\\text{d}h}{\\text{d}t} \\\\ \\frac{\\text{d}h}{\\text{d}t} & ≈1.94\\,\\text{cm}/\\text{min}\\end{aligned}\n$$\n\nrounded to two decimal places.\n\nTherefore, the solution level is increasing at a rate of approximately $1.94\\,\\text{cm}/\\text{min}.$"} {:db/id #edb/ref 17592186524023 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c7c0f8d-b4b8-5c06-9ffe-1250080e6409" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186523313}] :answer-field/correct {:answer/id #uuid "1c7c0f8d-b4b8-5c06-9ffe-1250080e6409" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186523313} :answer-field/id #uuid "5cf71d78-57d0-513b-a028-613da517c54d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523835}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e4ae8f6c-f256-5ee8-80b1-72f1337deae2" :question/math-academy-id "q-346239" :question/problem "![](images/01/01d6575ff056e7f99075597547583b4c648fbe6ad462d38a5d5fd76b8c73a564.png)\n\nA conical container has a height of $8\\,\\text{cm},$ and the radius at the bottom of the container is $4\\,\\text{cm}.$ Batter is being poured into the container. If the level of the batter in the container is increasing at a rate of $\\frac{4}{\\pi }\\,\\text{cm/s}$, find the rate at which the volume of the batter is increasing when the radius of the batter surface is $\\frac{3}{2}\\,\\text{cm}.$ Do not round the answer.\n\nThe volume of batter is increasing at a rate of\n{{field-1}} ${\\text{cm}}^{3}/\\text{s}.$" :question/worked-solution "First, let's consider the dimensions of the container. Let's call $H=8\\,\\text{cm}$ the height of the conical container, and $R=4\\,\\text{cm}$ its radius at the bottom. These quantities are fixed and do not change with time.\n\nNow, let's consider the batter level. We call $h$ the distance from the top of the container to the batter surface, $r$ the radius of the cone at the surface of the batter, and $v$ the volume of the empty space in the container. All of these quantities change with time. In particular, we are given\n\n$$\n\\frac{\\text{d}h}{\\text{d}t}=-\\frac{4}{\\pi }\\,\\text{cm}/\\text{s},\n$$\n\nwhich is negative because the distance from the top of the container to the batter surface decreases as we pour the batter into the container.\n\nWe want to know $\\frac{\\text{d}v}{\\text{d}t}$ when $r=\\frac{3}{2}\\,\\text{cm}.$\n\nWe need to find a relation between $v$ and the variable for which we know the rate of change, which is $h.$ This is given by the formula for the volume of a cone:\n\n$$\nv=\\frac{1}{3}\\pi {r}^{2}h.\n$$\n\nBefore we differentiate the equation with respect to time, note that $r$ also appears in the formula. So, we need to simplify the formula by writing $r$ in terms of $h.$\n\nNote that the cones formed by the container and the batter must be similar. Therefore, we have\n\n$$\n\\begin{aligned}\\frac{r}{h} & =\\frac{R}{H} \\\\ \\frac{r}{h} & =\\frac{4}{8} \\\\ r & =\\frac{h}{2}.\\end{aligned}\n$$\n\nTherefore, we can write the volume formula as\n\n$$\n\\begin{aligned}v & =\\frac{1}{3}\\pi {(\\frac{h}{2})}^{2}h \\\\ v & =\\frac{1}{12}\\pi {h}^{3}.\\end{aligned}\n$$\n\nNow that we have an equation relating $v$ and $h,$ we differentiate with respect to time using the chain rule:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}v & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{12}\\pi {h}^{3}) \\\\ \\frac{\\text{d}v}{\\text{d}t} & =\\frac{1}{4}\\pi {h}^{2}\\frac{\\text{d}h}{\\text{d}t}.\\end{aligned}\n$$\n\nWe want to know $\\frac{\\text{d}v}{\\text{d}t}$ when $r=\\frac{3}{2}\\,\\text{cm}.$ We can compute the value of $h$ at this moment as follows:\n\n$$\n\\begin{aligned}\\frac{3}{2} & =\\frac{h}{2} \\\\ h & =3\\,\\text{cm}.\\end{aligned}\n$$\n\nFinally, substituting the known values, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}v}{\\text{d}t} & =\\frac{1}{4}\\pi (3)^{2}(-\\frac{4}{\\pi }) \\\\ \\frac{\\text{d}v}{\\text{d}t} & =-9\\,{\\text{cm}}^{3}/\\text{s}.\\end{aligned}\n$$\n\nTherefore, the volume of batter is increasing at a rate of $9\\,{\\text{cm}}^{3}/\\text{s}.$"} {:db/id #edb/ref 17592186524027 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "023efee2-ebd9-53fc-8796-286eca083d4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36\\,\\text{m/s}" :db/id #edb/ref 17592186523254} {:answer/id #uuid "2f3a66d2-ada2-57e6-bc94-a83355eb8c99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\sqrt{3}\\,\\text{m/s}" :db/id #edb/ref 17592186523351} {:answer/id #uuid "4919ab2f-fbd2-574b-9eda-ce5259c7401d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\text{m/s}" :db/id #edb/ref 17592186523404} {:answer/id #uuid "9828920c-e8c5-59e0-8330-a343e0ffcdf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,\\text{m/s}" :db/id #edb/ref 17592186523571} {:answer/id #uuid "dc4333fa-407f-57e6-8e89-7c8e98ab48ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18\\sqrt{3}\\,\\text{m/s}" :db/id #edb/ref 17592186523712}] :answer-field/correct {:answer/id #uuid "2f3a66d2-ada2-57e6-bc94-a83355eb8c99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\sqrt{3}\\,\\text{m/s}" :db/id #edb/ref 17592186523351} :answer-field/id #uuid "ce76d2c6-da78-53ff-8c24-134a2e050d9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523893}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e817aceb-adb1-5216-bfe1-e48f45d3b767" :question/math-academy-id "q-53196" :question/problem "![](images/d4/d486581ea48bc96adc1269fbf40d1d71a547e92977f71e3a74336a147ef9b222.png)\n\nA potato $P$ is fired from a cannon $C$ at an angle of $\\frac{\\pi }{6}$ radians from the horizontal. The horizontal distance the projectile travels increases at a rate of $18\\,\\text{m}/\\text{s}.$ If the angle of elevation does not change, what is the speed of the potato?" :question/worked-solution "![](images/8b/8b5af04f58fe65b46adaae47d97b857d1e8765122a811179cf25ba22733e6415.png)\n\nLet $x$ be the horizontal distance from the potato to the cannon and $z$ be the actual distance between them, as shown above.\n\nWe want to find $\\frac{\\text{d}z}{\\text{d}t}.$ To do this, let's start by setting up a relation between $x$ and $z.$ Relative to the angle $\\theta =\\frac{\\pi }{6},$ the sides $x$ and $z$ are the adjacent and hypotenuse, respectively. So, we have\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\frac{\\pi }{6}) & =\\frac{x}{z} \\\\ \\frac{\\sqrt{3}}{2} & =\\frac{x}{z} \\\\ z & =\\frac{2\\sqrt{3}}{3}x.\\end{aligned}\n$$\n\nNow, we differentiate both sides of the equation with respect to $t$ using implicit differentiation, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(z) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{2\\sqrt{3}}{3}x) \\\\ \\frac{\\text{d}z}{\\text{d}t} & =\\frac{2\\sqrt{3}}{3}\\frac{\\text{d}x}{\\text{d}t}.\\end{aligned}\n$$\n\nWe know that $\\frac{\\text{d}z}{\\text{d}t}=18\\,\\text{m}/\\text{s}.$ Substituting this into the above gives\n\n$$\n\\frac{\\text{d}z}{\\text{d}t}=\\frac{2\\sqrt{3}}{3}\\cdot 18=12\\sqrt{3}.\n$$\n\nTherefore, the speed of the potato is $12\\sqrt{3}\\,\\text{m/s}.$"} {:db/id #edb/ref 17592186524028 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31679908-2281-5375-8e4f-ab234176aa59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi \\,\\text{m/s}" :db/id #edb/ref 17592186523356} {:answer/id #uuid "5aae7333-f8d9-59d1-980d-c32006c2344a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\pi \\,\\text{m/s}" :db/id #edb/ref 17592186523438} {:answer/id #uuid "7f3a5aba-80e0-512f-9adf-de9315810712" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\pi \\,\\text{m/s}" :db/id #edb/ref 17592186523523} {:answer/id #uuid "a505aa4e-e343-59d5-ac42-7ab4c259cfad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi \\,\\text{m/s}" :db/id #edb/ref 17592186523601} {:answer/id #uuid "a859c172-a2a7-57b0-955b-6cfdff5733c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi \\,\\text{m/s}" :db/id #edb/ref 17592186523608}] :answer-field/correct {:answer/id #uuid "a859c172-a2a7-57b0-955b-6cfdff5733c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi \\,\\text{m/s}" :db/id #edb/ref 17592186523608} :answer-field/id #uuid "c764bd62-dac9-5c30-b3ea-6e5444aa2fdd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523888}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e9479f5b-c4df-5efe-97d6-27688a7060c1" :question/math-academy-id "q-83678" :question/problem "![](images/6a/6a37ae024b0472dfc38ecff01b898d8d3ed2384d90acf432d747efee1568520e.png)\n\nA car $C$ drives toward a $108\\,\\text{m}$ high building $B$ following a straight path. The angle of elevation $\\theta $ made by the car and the top of the building $T$ is increasing at a rate of $\\frac{\\pi }{36}$ radians per second. What is the speed of the car when $\\theta =\\frac{\\pi }{3}?$" :question/worked-solution "![](images/f2/f28ca3385d2179984c29d27a06926806e445c1dbab2cfa5f9fd6857149b632bb.png)\n\n  \n\nIn the figure, $x$ is the distance between the car and the building, and $y$ is the building's height. The quantity $y=108$ meters does not change with time because the building's height is fixed.\n\nWe wish to calculate $\\frac{\\text{d}x}{\\text{d}t}.$\nTo do this, let's start by setting up a relation between $x$ and $y.$ Relative to the angle $\\theta ,$ the sides $x$ and $y$ are the adjacent and opposite, respectively. So, we have\n\n$$\n\\begin{aligned}\\operatorname{cot}⁡\\theta  & =\\frac{x}{y} \\\\ \\operatorname{cot}⁡\\theta  & =\\frac{x}{108} \\\\ x & =108\\operatorname{cot}⁡\\theta .\\end{aligned}\n$$\n\nNow, we differentiate both sides of the equation with respect to $t$ using implicit differentiation, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(x) & =\\frac{\\text{d}}{\\text{d}t}(108\\operatorname{cot}⁡\\theta ) \\\\ \\frac{\\text{d}x}{\\text{d}t} & =(-108{csc}^{2}⁡\\theta )\\frac{\\text{d}\\theta }{\\text{d}t}.\\end{aligned}\n$$\n\nFrom the given information, we have $\\frac{\\text{d}\\theta }{\\text{d}t}=\\frac{\\pi }{36}$ and $\\theta =\\frac{\\pi }{3}.$ Substituting these values into the above, we reach\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =(-108{csc}^{2}⁡(\\frac{\\pi }{3}))\\frac{\\pi }{36} \\\\ \\frac{\\text{d}x}{\\text{d}t} & =-108{(\\frac{2\\sqrt{3}}{3})}^{2}\\frac{\\pi }{36} \\\\ \\frac{\\text{d}x}{\\text{d}t} & =-3\\pi (\\frac{4}{3}) \\\\ \\frac{\\text{d}x}{\\text{d}t} & =-4\\pi .\\end{aligned}\n$$\n\nTherefore, the speed of the car is $4\\pi \\,\\text{m/s}.$"} {:db/id #edb/ref 17592186524031 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6951626e-b13c-5bfd-b94e-4811c1c0288e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{40}" :db/id #edb/ref 17592186523470}] :answer-field/correct {:answer/id #uuid "6951626e-b13c-5bfd-b94e-4811c1c0288e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{40}" :db/id #edb/ref 17592186523470} :answer-field/id #uuid "ea67d905-4e13-5fb0-9a4b-c810c57cacc6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523910}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "edce8cb0-3424-5fe2-ac49-b2f607c023b1" :question/math-academy-id "q-343202" :question/problem "![](images/30/305398b239bbc784fb5e5a1ec7ef2020a19a033dcda150e84f9c4a2a72a96adf.png)\n\nA lifeguard $L$ is watching a weather balloon $W$ rise vertically from a point $S$ on the beach. The point $S$ is $10\\,\\text{m}$ away from the lifeguard. If the balloon is rising at a constant speed of $1\\,\\text{m/s},$ determine the rate at which the angle of elevation $\\theta $ formed by the lifeguard and the balloon is increasing at the moment when $\\theta =\\frac{\\pi }{6}.$ Do not round the answer.\n\nThe angle of elevation is increasing at a rate of\n{{field-1}}\n$\\text{rad/s}.$" :question/worked-solution "![](images/b4/b4b48ffa8202e15042190b98b8fc11bb02bc06547abcfbfba87b1433e5161d9b.png)\n\n  \n\nIn the figure, $x$ is the horizontal distance between the lifeguard and the point on the beach directly beneath the balloon, and $y$ is the balloon's height. The quantity $x=10\\,\\text{m}$ does not change with time because the lifeguard does not move.\n\nWe wish to calculate $\\frac{\\text{d}\\theta }{\\text{d}t}$ when $\\theta =\\frac{\\pi }{6}.$\nTo do this, let's start by setting up a relation between $x$ and $y.$ Relative to the angle $\\theta ,$ the sides $x$ and $y$ are the adjacent and opposite, respectively. So, we have\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡\\theta  & =\\frac{y}{x} \\\\ \\operatorname{tan}⁡\\theta  & =\\frac{y}{10} \\\\ y & =10\\operatorname{tan}⁡\\theta .\\end{aligned}\n$$\n\nNow, we differentiate both sides of the equation with respect to $t$ using implicit differentiation, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(y) & =\\frac{\\text{d}}{\\text{d}t}(10\\operatorname{tan}⁡\\theta ) \\\\ \\frac{\\text{d}y}{\\text{d}t} & =10{sec}^{2}⁡\\theta \\cdot \\frac{\\text{d}\\theta }{\\text{d}t}.\\end{aligned}\n$$\n\nFrom the given information, we have $\\frac{\\text{d}y}{\\text{d}t}=1$ and $\\theta =\\frac{\\pi }{6}.$ Substituting these values into the above, we reach\n\n$$\n\\begin{aligned}1 & =10{sec}^{2}⁡(\\frac{\\pi }{6})\\cdot \\frac{\\text{d}\\theta }{\\text{d}t} \\\\ 1 & =10{(\\frac{2}{\\sqrt{3}})}^{2}\\cdot \\frac{\\text{d}\\theta }{\\text{d}t} \\\\ 1 & =10\\cdot \\frac{4}{3}\\cdot \\frac{\\text{d}\\theta }{\\text{d}t} \\\\ 1 & =\\frac{40}{3}\\cdot \\frac{\\text{d}\\theta }{\\text{d}t} \\\\ \\frac{\\text{d}\\theta }{\\text{d}t} & =\\frac{3}{40}.\\end{aligned}\n$$\n\nTherefore, the angle of elevation is increasing at a rate of $\\frac{3}{40}\\,\\text{rad/s}.$"} {:db/id #edb/ref 17592186524035 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00eef7cd-53a9-593e-a267-c9da06c25bea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{7}" :db/id #edb/ref 17592186523252} {:answer/id #uuid "1bbec767-e533-5c10-9e12-149088192f95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186523309} {:answer/id #uuid "76154324-9a81-5b0d-a958-23841c6c7f0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{9}" :db/id #edb/ref 17592186523495} {:answer/id #uuid "dcdebc50-1a9d-5401-81bd-abe973d6d489" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{9}" :db/id #edb/ref 17592186523716} {:answer/id #uuid "f24d6aa3-5802-57f1-bbdd-fb4785ed51d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186523758}] :answer-field/correct {:answer/id #uuid "1bbec767-e533-5c10-9e12-149088192f95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186523309} :answer-field/id #uuid "7693271f-4341-5f7a-9e8f-486b996d263b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523848}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f162fba1-f09f-5af9-a84b-e3875292cc2e" :question/math-academy-id "q-128441" :question/problem "What is $0÷(-\\frac{9}{7}).$" :question/worked-solution "Zero divided by any number (other than zero) equals zero. Therefore, \n\n$$\n0÷(-\\frac{9}{7})=0.\n$$"} {:db/id #edb/ref 17592186524177 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6179bfd3-ad1a-57d5-9e85-07e8de87a9e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{2 x y^{3} z - y z^{3}}{x y z})\\,i+(\\frac{3 x^{2} y^{2} z - x z^{3}}{x y z})\\,j+(\\frac{x^{2} y^{3} - 3 x y z^{2}}{x y z})\\,k" :db/id #edb/ref 17592186524158} {:answer/id #uuid "6544e835-303b-5d55-9ff4-bf9b2ff7f858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- \\frac{x^{2} y^{3} z - x y z^{3}}{x^{2} y z})\\,i+(- \\frac{x^{2} y^{3} z - x y z^{3}}{x y^{2} z})\\,j+(- \\frac{x^{2} y^{3} z - x y z^{3}}{x y z^{2}})\\,k" :db/id #edb/ref 17592186524159} {:answer/id #uuid "6f4a1fb2-b6f5-56ce-8ca2-8933d289d531" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2 x y)\\,i+(y^{2})\\,j+(- 2 z)\\,k" :db/id #edb/ref 17592186524163} {:answer/id #uuid "e45afc2c-89cc-5d31-a291-04df0e43e302" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y^{2})\\,i+(2 x y)\\,j+(- 2 z)\\,k" :db/id #edb/ref 17592186524190} {:answer/id #uuid "fe10362b-4bcf-503f-8c49-8dc2e3a0aca8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{2 x y^{3} z - y z^{3}}{x y z} + \\frac{x^{2} y^{3} z - x y z^{3}}{x^{2} y z})\\,i+(\\frac{3 x^{2} y^{2} z - x z^{3}}{x y z} + \\frac{x^{2} y^{3} z - x y z^{3}}{x y^{2} z})\\,j+(\\frac{x^{2} y^{3} - 3 x y z^{2}}{x y z} + \\frac{x^{2} y^{3} z - x y z^{3}}{x y z^{2}})\\,k" :db/id #edb/ref 17592186524195}] :answer-field/correct {:answer/id #uuid "e45afc2c-89cc-5d31-a291-04df0e43e302" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y^{2})\\,i+(2 x y)\\,j+(- 2 z)\\,k" :db/id #edb/ref 17592186524190} :answer-field/id #uuid "28bf2288-62d0-5f23-9d2d-c0fb16e9c57f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524147}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "af2e4ace-5861-5b18-b355-92218c8fda1e" :question/problem "Find the gradient of the product $f(x,y,z)g(x,y,z),$ given that $f(x,y,z)=x^{2} y^{3} z - x y z^{3}$ and $g(x,y,z)=\\frac{1}{x y z}.$" :question/worked-solution "The gradient of the product of two functions $f(x,y,z)$ and $g(x,y,z)$ is given by\n\n$$\n∇[fg]=g∇f+f∇g.\n$$\n\nNow, we calculate the partial derivatives of $f(x,y,z):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(x^{2} y^{3} z - x y z^{3})=2 x y^{3} z - y z^{3} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(x^{2} y^{3} z - x y z^{3})=3 x^{2} y^{2} z - x z^{3} \\\\ \\frac{∂f}{∂z} & =\\frac{∂}{∂z}(x^{2} y^{3} z - x y z^{3})=x^{2} y^{3} - 3 x y z^{2}\\end{aligned}\n$$\n\nHence,\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂f}{∂x}i+\\frac{∂f}{∂y}j+\\frac{∂f}{∂z}k=(2 x y^{3} z - y z^{3})\\,i+(3 x^{2} y^{2} z - x z^{3})\\,j+(x^{2} y^{3} - 3 x y z^{2})\\,k\\end{aligned}\n$$\n\nNow, we calculate the partial derivatives of $g(x,y,z):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(\\frac{1}{x y z})=- \\frac{1}{x^{2} y z} \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(\\frac{1}{x y z})=- \\frac{1}{x y^{2} z} \\\\ \\frac{∂g}{∂z} & =\\frac{∂}{∂z}(\\frac{1}{x y z})=- \\frac{1}{x y z^{2}}\\end{aligned}\n$$\n\nHence,\n\n$$\n\\begin{aligned}∇g(x,y,z) & =\\frac{∂g}{∂x}i+\\frac{∂g}{∂y}j+\\frac{∂g}{∂z}k=(- \\frac{1}{x^{2} y z})\\,i+(- \\frac{1}{x y^{2} z})\\,j+(- \\frac{1}{x y z^{2}})\\,k\\end{aligned}\n$$\n\nUsing the product rule, we obtain\n\n$$\n\\begin{aligned}∇[f(x,y,z)g(x,y,z)] & =g(x,y,z)∇f(x,y,z)+f(x,y,z)∇g(x,y,z) \\\\  & =(\\frac{1}{x y z})((2 x y^{3} z - y z^{3})\\,i+(3 x^{2} y^{2} z - x z^{3})\\,j+(x^{2} y^{3} - 3 x y z^{2})\\,k)+(x^{2} y^{3} z - x y z^{3})((- \\frac{1}{x^{2} y z})\\,i+(- \\frac{1}{x y^{2} z})\\,j+(- \\frac{1}{x y z^{2}})\\,k) \\\\  & =(\\frac{1}{x y z})(2 x y^{3} z - y z^{3})i+(\\frac{1}{x y z})(3 x^{2} y^{2} z - x z^{3})j+(\\frac{1}{x y z})(x^{2} y^{3} - 3 x y z^{2})k+(x^{2} y^{3} z - x y z^{3})(- \\frac{1}{x^{2} y z})i+(x^{2} y^{3} z - x y z^{3})(- \\frac{1}{x y^{2} z})j+(x^{2} y^{3} z - x y z^{3})(- \\frac{1}{x y z^{2}})k \\\\  & =(2 y^{2} - \\frac{z^{2}}{x})i+(3 x y - \\frac{z^{2}}{y})j+(\\frac{x y^{2}}{z} - 3 z)k+(- y^{2} + \\frac{z^{2}}{x})i+(- x y + \\frac{z^{2}}{y})j+(- \\frac{x y^{2}}{z} + z)k \\\\  & =(y^{2})\\,i+(2 x y)\\,j+(- 2 z)\\,k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186524966 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "075ff70c-8adb-53e9-8868-dac30ec95b33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=4" :db/id #edb/ref 17592186524395} {:answer/id #uuid "11f6e6ae-3c6c-50c6-99cc-458271767c9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=2" :db/id #edb/ref 17592186524412} {:answer/id #uuid "a69c5953-f455-53cf-a745-4db7c010554c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=1" :db/id #edb/ref 17592186524646} {:answer/id #uuid "dbf1af4e-c02d-5acb-a898-ed1acac8e812" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=3" :db/id #edb/ref 17592186524755}] :answer-field/correct {:answer/id #uuid "dbf1af4e-c02d-5acb-a898-ed1acac8e812" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=3" :db/id #edb/ref 17592186524755} :answer-field/id #uuid "65f9587c-2102-51c3-9018-cf73e669ee77" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186524882} {:answer-field/choices [{:answer/id #uuid "4e2b8556-b100-5f8e-bc9f-9cd87c21cb7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x}{27\\pi }\\operatorname{cos}⁡(\\frac{3\\pi x}{2})" :db/id #edb/ref 17592186524513} {:answer/id #uuid "72385776-67d2-5118-b12a-b9ffbb9a1976" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{18\\pi }\\operatorname{sin}⁡(\\frac{3\\pi x}{2})" :db/id #edb/ref 17592186524565} {:answer/id #uuid "92909ea3-1683-5e8f-b3a3-8b2af56ef7af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{27\\pi }\\operatorname{sin}⁡(\\frac{3\\pi x}{2})" :db/id #edb/ref 17592186524612} {:answer/id #uuid "e88ad1ac-4369-5a83-8114-9aecaa890952" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{54\\pi }\\operatorname{sin}⁡(\\frac{3\\pi x}{2})" :db/id #edb/ref 17592186524791}] :answer-field/correct {:answer/id #uuid "92909ea3-1683-5e8f-b3a3-8b2af56ef7af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{27\\pi }\\operatorname{sin}⁡(\\frac{3\\pi x}{2})" :db/id #edb/ref 17592186524612} :answer-field/id #uuid "b41532f6-c5f8-55db-9dde-0e3b62dd91b0" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186524919}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1741c2e1-8000-5ded-a8b9-94a357d2c64a" :question/math-academy-id "q-343887" :question/problem "Consider the differential equation ${y}^{″}+\\frac{9{\\pi }^{2}}{4}y=f(x),$ where the $4$-periodic forcing function is given by \n\n$$\nf(x)∼2+{\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{2}}\\operatorname{cos}⁡(\\frac{n\\pi x}{2}).\n$$\n\nSelect the correct options in the reasoning below regarding the resonant component of a particular solution of the equation.\n\nThe natural frequency of the system matches the frequency of the {{field-1}} harmonic of the forcing function. \n\nConsequently, the particular solution contains a resonant term of the form\n\n$$\n{y}_{{p}_{3}}={{field-2}}.\n$$" :question/worked-solution "We begin by identifying resonance. The differential equation \n\n$$\n{y}^{″}+\\frac{9{\\pi }^{2}}{4}y=f(x)\n$$\n\nhas a natural frequency of \n\n$$\n\\omega =\\sqrt{\\frac{9{\\pi }^{2}}{4}}=\\frac{3\\pi }{2}.\n$$\n\nThe frequencies of the forcing harmonics for a $4$-periodic function $(L=2)$ are \n\n$$\n{\\omega }_{n}=\\frac{n\\pi }{2}.\n$$\n\nFor $n=3$, we have ${\\omega }_{3}=\\frac{3\\pi }{2}.$ Since ${\\omega }_{3}=\\omega ,$ the $n=3$ harmonic of the forcing function causes resonance.\n\nFor the $n=3$ harmonic, the forcing term is \n\n$$\n{f}_{3}(x)=\\frac{1}{9}\\operatorname{cos}⁡(\\frac{3\\pi x}{2}).\n$$\n\nBecause this frequency matches the natural frequency, we assume a particular solution of the form\n\n$$\n{y}_{{p}_{3}}=x(A\\operatorname{cos}⁡(\\frac{3\\pi x}{2})+B\\operatorname{sin}⁡(\\frac{3\\pi x}{2})).\n$$\n\nNow, we compute the derivatives:\n\n$$\n\\begin{aligned}{y}_{{p}_{3}}^{′} & =(A\\operatorname{cos}⁡(\\frac{3\\pi x}{2})+B\\operatorname{sin}⁡(\\frac{3\\pi x}{2}))+x(-\\frac{3\\pi }{2}A\\operatorname{sin}⁡(\\frac{3\\pi x}{2})+\\frac{3\\pi }{2}B\\operatorname{cos}⁡(\\frac{3\\pi x}{2})) \\\\ {y}_{{p}_{3}}^{″} & =-3\\pi A\\operatorname{sin}⁡(\\frac{3\\pi x}{2})+3\\pi B\\operatorname{cos}⁡(\\frac{3\\pi x}{2})-\\frac{9{\\pi }^{2}}{4}x(A\\operatorname{cos}⁡(\\frac{3\\pi x}{2})+B\\operatorname{sin}⁡(\\frac{3\\pi x}{2}))\\end{aligned}\n$$\n\nNext, we substitute the expressions for ${y}_{{p}_{3}}^{″}$ and ${y}_{{p}_{3}}$ into the equation ${y}^{″}+\\frac{9{\\pi }^{2}}{4}y=\\frac{1}{9}\\operatorname{cos}⁡(\\frac{3\\pi x}{2}):$\n\n$$\n[-3\\pi A\\operatorname{sin}⁡(\\frac{3\\pi x}{2})+3\\pi B\\operatorname{cos}⁡(\\frac{3\\pi x}{2})-\\frac{9{\\pi }^{2}}{4}{y}_{{p}_{3}}]+\\frac{9{\\pi }^{2}}{4}{y}_{{p}_{3}}=\\frac{1}{9}\\operatorname{cos}⁡(\\frac{3\\pi x}{2})\n$$\n\nThe resonant terms involving $x$ cancel out, leaving\n\n$$\n-3\\pi A\\operatorname{sin}⁡(\\frac{3\\pi x}{2})+3\\pi B\\operatorname{cos}⁡(\\frac{3\\pi x}{2})=\\frac{1}{9}\\operatorname{cos}⁡(\\frac{3\\pi x}{2}).\n$$\n\nNow, equating the sine and cosine coefficients, we obtain:\n\n$$\n\\{\\begin{aligned}-3\\pi A=0 \\\\ 3\\pi B=\\frac{1}{9}\\end{aligned}\\,⇒\\,\\{\\begin{aligned}A=0 \\\\ B=\\frac{1}{27\\pi }\\end{aligned}\n$$\n\nTherefore, the resonant component of a particular solution is\n\n$$\n{y}_{{p}_{3}}=\\frac{x}{27\\pi }\\operatorname{sin}⁡(\\frac{3\\pi x}{2}).\n$$"} {:db/id #edb/ref 17592186524971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "344d0e42-cd70-5ad8-90fc-7db764816086" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186524478} {:answer/id #uuid "86854eda-5a8f-50ea-94b0-dd55b64266ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186524590} {:answer/id #uuid "ce713a1f-b2ec-53d9-97c8-17515419704d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186524724} {:answer/id #uuid "ed1a145b-0c0c-558c-963e-71228c0de2a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186524800}] :answer-field/correct {:answer/id #uuid "86854eda-5a8f-50ea-94b0-dd55b64266ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186524590} :answer-field/id #uuid "04a2bae6-aeac-5a01-8bbe-2da7affb6702" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186524842} {:answer-field/choices [{:answer/id #uuid "05e74e00-5bf0-5bcb-9c73-5ac12785eb89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{20(-1)^{n}}{{n}^{3}\\pi ({n}^{2}{\\pi }^{2}+40)}" :db/id #edb/ref 17592186524390} {:answer/id #uuid "20391762-3990-5977-9275-05105acc9764" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{20(-1)^{n}}{{n}^{2}\\pi ({n}^{2}{\\pi }^{2}+40)}" :db/id #edb/ref 17592186524440} {:answer/id #uuid "96006c5e-26f2-501a-82c3-1c733fab3f3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5(-1)^{n}}{{n}^{3}\\pi ({n}^{2}{\\pi }^{2}+40)}" :db/id #edb/ref 17592186524620} {:answer/id #uuid "ae2ce446-0043-5cc6-9d9f-038477aa3b6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{20(-1)^{n}}{{n}^{3}\\pi ({n}^{2}{\\pi }^{2}+40)}" :db/id #edb/ref 17592186524662}] :answer-field/correct {:answer/id #uuid "ae2ce446-0043-5cc6-9d9f-038477aa3b6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{20(-1)^{n}}{{n}^{3}\\pi ({n}^{2}{\\pi }^{2}+40)}" :db/id #edb/ref 17592186524662} :answer-field/id #uuid "3b8556e9-1a54-5d0b-a5a5-5efa77eeb553" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186524866}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "234b7e73-d01a-5fb8-b7f2-7b7733987672" :question/math-academy-id "q-343886" :question/problem "Select the missing parts in a particular solution of the differential equation ${y}^{″}-10y=f(x),$ where the Fourier series of the $4$-periodic forcing function is given by\n\n$$\nf(x)∼10+{\\sum }_{n=1}^{\\infty }\\frac{5(-1)^{n+1}}{{n}^{3}\\pi }\\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$\n\n*Hint: You may assume that all the cosine coefficients in the Fourier series of the particular solution are equal to zero.*\n\nThe Fourier series of a particular solution is\n\n$$\n{y}_{p}∼{{field-1}}+{\\sum }_{n=1}^{\\infty }\\,{{field-2}}\\cdot \\operatorname{sin}⁡(\\frac{n\\pi x}{2})\n$$" :question/worked-solution "We assume that a solution of our equation has the following Fourier series:\n\n$$\n{y}_{p}∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$\n\nNow, we compute the derivatives:\n\n$$\n\\begin{aligned}{y}_{p}^{′} & ∼\\frac{\\text{d}}{\\text{d}x}(\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{2}))∼{\\sum }_{n=1}^{\\infty }\\frac{{b}_{n}n\\pi }{2}\\operatorname{cos}⁡(\\frac{n\\pi x}{2}) \\\\ {y}_{p}^{″} & ∼\\frac{\\text{d}}{\\text{d}x}({\\sum }_{n=1}^{\\infty }\\frac{{b}_{n}n\\pi }{2}\\operatorname{cos}⁡(\\frac{n\\pi x}{2}))∼{\\sum }_{n=1}^{\\infty }-\\frac{{b}_{n}{n}^{2}{\\pi }^{2}}{4}\\operatorname{sin}⁡(\\frac{n\\pi x}{2})\\end{aligned}\n$$\n\nNext, we substitute the expressions for ${y}_{p}^{″}$ and ${y}_{p}$ into the equation and have\n\n$$\n{\\sum }_{n=1}^{\\infty }-\\frac{{b}_{n}{n}^{2}{\\pi }^{2}}{4}\\operatorname{sin}⁡(\\frac{n\\pi x}{2})-10(\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{2}))=10+{\\sum }_{n=1}^{\\infty }\\frac{5(-1)^{n+1}}{{n}^{3}\\pi }\\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$\n\nRearranging the terms, we get \n\n$$\n-10\\cdot \\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{b}_{n}(-\\frac{{n}^{2}{\\pi }^{2}}{4}-10)\\operatorname{sin}⁡(\\frac{n\\pi x}{2})=10+{\\sum }_{n=1}^{\\infty }\\frac{5(-1)^{n+1}}{{n}^{3}\\pi }\\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$\n\nNow, equating the free terms and sine coefficients, we obtain:\n\n$$\n\\{\\begin{aligned}-10\\cdot \\frac{{a}_{0}}{2}=10 \\\\ {b}_{n}(-\\frac{{n}^{2}{\\pi }^{2}}{4}-10)=\\frac{5(-1)^{n+1}}{{n}^{3}\\pi }\\end{aligned}\\,⇒\\,\\{\\begin{aligned}\\frac{{a}_{0}}{2}=-1 \\\\ {b}_{n}=\\frac{20(-1)^{n}}{{n}^{3}\\pi ({n}^{2}{\\pi }^{2}+40)}\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n{y}_{p}∼-1+{\\sum }_{n=1}^{\\infty }\\,\\frac{20(-1)^{n}}{{n}^{3}\\pi ({n}^{2}{\\pi }^{2}+40)}\\cdot \\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$"} {:db/id #edb/ref 17592186524976 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39c346e6-1707-5c7d-ba00-77662529622f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{1-{x}^{2}}" :db/id #edb/ref 17592186524486}] :answer-field/correct {:answer/id #uuid "39c346e6-1707-5c7d-ba00-77662529622f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{1-{x}^{2}}" :db/id #edb/ref 17592186524486} :answer-field/id #uuid "584b1c26-caed-504f-b964-753688b3a2ed" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186524876}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3337e5e0-9e46-58ca-9b60-fe0a52d9614e" :question/math-academy-id "q-341550" :question/problem "$$\n\nIf $f(x)=\\frac{\\operatorname{arcoth}⁡(x)}{\\sqrt{x}},$ calculate ${f}^{′}(x).$\n\n${f}^{′}(x)=\\frac{1}{\\sqrt{x}}($ \n{{field-1}} $-\\frac{\\operatorname{arcoth}⁡x}{2x})$" :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=\\operatorname{arcoth}⁡(x)$ and $v(x)=\\sqrt{x}.$\n\nTherefore, we apply the product rule as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{{[v(x)]}^{2}} \\\\  & =\\frac{{(\\operatorname{arcoth}⁡x)}^{′}\\cdot \\sqrt{x}-\\operatorname{arcoth}⁡x\\cdot {(\\sqrt{x})}^{′}}{{(\\sqrt{x})}^{2}} \\\\  & =\\frac{{(\\operatorname{arcoth}⁡x)}^{′}\\cdot \\sqrt{x}}{x}-\\frac{\\operatorname{arcoth}⁡x\\cdot {(\\sqrt{x})}^{′}}{x} \\\\  & =(\\frac{1}{1-{x}^{2}})\\cdot \\frac{\\sqrt{x}}{x}-\\frac{\\operatorname{arcoth}⁡x}{x}\\cdot \\frac{1}{2\\sqrt{x}} \\\\  & =(\\frac{1}{1-{x}^{2}})\\cdot \\frac{1}{\\sqrt{x}}-\\frac{\\operatorname{arcoth}⁡x}{2x}\\cdot \\frac{1}{\\sqrt{x}} \\\\  & =\\frac{1}{\\sqrt{x}}(\\frac{1}{1-{x}^{2}}-\\frac{\\operatorname{arcoth}⁡x}{2x}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186524978 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03a5abe1-8a17-5f77-aca0-0fecc6ce44b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{(5y-2)^2}{15}" :db/id #edb/ref 17592186524382}] :answer-field/correct {:answer/id #uuid "03a5abe1-8a17-5f77-aca0-0fecc6ce44b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{(5y-2)^2}{15}" :db/id #edb/ref 17592186524382} :answer-field/id #uuid "78ee6ce2-448a-5e5a-a2ca-c421a7bb8463" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186524894}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "35035d93-2432-5072-a261-b3e11d036f56" :question/math-academy-id "q-166151" :question/problem "Given that $x=\\frac{3}{5y-2},$ write $\\frac{\\text{d}y}{\\text{d}x}$ in terms of $y.$\n\n$\\frac{\\text{d}y}{\\text{d}x}\\,=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x=\\frac{3}{5y-2}$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(\\frac{3}{5y-2}) \\\\  & =3\\frac{\\text{d}}{\\text{d}y}((5y-2)^{-1}) \\\\  & =-3(5y-2)^{-2}\\cdot 5 \\\\  & =-\\frac{15}{(5y-2)^{2}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=-\\frac{1}{15}(5y-2)^{2}.\n$$"} {:db/id #edb/ref 17592186524983 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc8d190d-9c67-5acd-8583-f14a36220ea6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186524684}] :answer-field/correct {:answer/id #uuid "bc8d190d-9c67-5acd-8583-f14a36220ea6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186524684} :answer-field/id #uuid "f05471f2-c115-5266-86b4-2c4bebd70c45" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186524945}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "45936e93-e188-5489-9cc9-795dad15e0d6" :question/math-academy-id "q-342792" :question/problem "The slope of the tangent to the curve $y=\\sqrt{3{x}^{2}+2x}$ at the point where $x=-1$ is{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nWe use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=3{x}^{2}+2x.$ Then $y=\\sqrt{u}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2\\sqrt{u}},\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6x+2.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot (6x+2) \\\\  & =\\frac{6x+2}{2\\sqrt{3{x}^{2}+2x}}.\\end{aligned}\n$$\n\nFinally, substituting $x=-1,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=-1} & ={(\\frac{6x+2}{2\\sqrt{3{x}^{2}+2x}})|}_{x=-1} \\\\  & =\\frac{6(-1)+2}{2\\sqrt{3(-1)^{2}+2(-1)}} \\\\  & =\\frac{-4}{2\\sqrt{1}} \\\\  & =-2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186524986 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b29336a1-2d9f-50d2-a125-62f689031329" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\ln x}{x\\sqrt{1-x^2}}" :db/id #edb/ref 17592186524670}] :answer-field/correct {:answer/id #uuid "b29336a1-2d9f-50d2-a125-62f689031329" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\ln x}{x\\sqrt{1-x^2}}" :db/id #edb/ref 17592186524670} :answer-field/id #uuid "3d13f910-7112-5195-9bff-e3f1ef20780b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186524867}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "54c54e62-4a18-5ab6-878d-ec4e2ae2aaa7" :question/math-academy-id "q-341554" :question/problem "$$\n\nIf $f(x)=\\operatorname{ln}⁡x\\,\\operatorname{arsech}⁡x,$ calculate ${f}^{′}(x).$\n\n${f}^{′}(x)=\\frac{\\operatorname{arsech}⁡x}{x}\\,-$ \n{{field-1}}" :question/worked-solution "In this case, the expression for $f(x)$ is a product $u(x)\\cdot v(x)$ with $u(x)=\\operatorname{ln}⁡x$ and $v(x)=\\operatorname{arsech}⁡x.$\n\nTherefore, we apply the product rule as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={(\\operatorname{ln}⁡x)}^{′}\\cdot \\operatorname{arsech}⁡x+\\operatorname{ln}⁡x\\cdot {(\\operatorname{arsech}⁡x)}^{′} \\\\  & =\\frac{1}{x}\\cdot \\operatorname{arsech}⁡x\\,+\\,\\operatorname{ln}⁡x\\cdot (-\\frac{1}{x\\sqrt{1-{x}^{2}}}) \\\\  & =\\frac{\\operatorname{arsech}⁡x}{x}-\\frac{\\operatorname{ln}⁡x}{x\\sqrt{1-{x}^{2}}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186524995 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f89f754-b00e-5b7c-b63f-401fe4f471d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186524409} {:answer/id #uuid "694234a6-597f-5e61-b5bf-84fc5b6aa6e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186524554} {:answer/id #uuid "6c3f9669-23d7-5243-84e9-d09de434a07d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{18}" :db/id #edb/ref 17592186524557} {:answer/id #uuid "a7c0d009-d03a-5fb2-a0bd-6539af2c96d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{18}" :db/id #edb/ref 17592186524651} {:answer/id #uuid "ba99982b-5521-5081-812d-09016da48ec3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186524679}] :answer-field/correct {:answer/id #uuid "ba99982b-5521-5081-812d-09016da48ec3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186524679} :answer-field/id #uuid "11562c89-3fe2-5b73-bf46-55642d35bb9e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524847}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "75c2a299-1223-5668-b631-6cae0200f484" :question/math-academy-id "q-170687" :question/problem "In an online poker tournament, the maximum loss is $10$ dollars, and the maximum win is $8$ dollars. Assuming that a player's earnings are uniformly distributed between $-10$ and $8,$ what is the probability that a randomly chosen player loses between $2$ and $8$ dollars?" :question/worked-solution "Let $X$ represent the earnings of a randomly chosen player. From the problem statement, we know that $X∼U[-10,8],$ and we wish to compute $P(-8\\le X\\le -2).$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{b-a}, & a\\le x\\le b \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nSo, for our random variable $X∼U[-10,8],$ we have the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{18}, & -10\\le x\\le 8 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(-8\\le X\\le -2) & ={\\int }_{-8}^{-2}f(x)\\,\\text{d}x \\\\  & ={\\int }_{-8}^{-2}\\frac{1}{18}\\,\\text{d}x \\\\  & ={\\frac{x}{18}|}_{-8}^{-2} \\\\  & =-\\frac{2}{18}-(-\\frac{8}{18}) \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186525007 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01fd6b21-4e7c-562e-8083-7e0e34e7e8c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}⁡x\\sqrt{1-{ln}^{2}⁡x}}" :db/id #edb/ref 17592186524380} {:answer/id #uuid "9e0a76b4-f502-5e5f-ac2c-3c8acd63b518" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{x\\operatorname{ln}⁡x\\sqrt{1-\\operatorname{ln}⁡x}}" :db/id #edb/ref 17592186524635} {:answer/id #uuid "dd9737e3-0ec2-5ba3-add4-cec93d9b1ee2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{x\\operatorname{ln}⁡x\\sqrt{1-{ln}^{2}⁡x}}" :db/id #edb/ref 17592186524758} {:answer/id #uuid "e46fb9aa-b37c-53cd-95f3-b44d1c1a0d19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{x\\sqrt{1-{ln}^{2}⁡x}}" :db/id #edb/ref 17592186524782} {:answer/id #uuid "ea555f5f-939f-58bb-b8b4-8d5821bb15da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}⁡x\\sqrt{1-\\operatorname{ln}⁡x}}" :db/id #edb/ref 17592186524794}] :answer-field/correct {:answer/id #uuid "dd9737e3-0ec2-5ba3-add4-cec93d9b1ee2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{x\\operatorname{ln}⁡x\\sqrt{1-{ln}^{2}⁡x}}" :db/id #edb/ref 17592186524758} :answer-field/id #uuid "f4cb0872-1c1c-5be2-826b-83e8a8aaf2ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524948}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8af41eb0-cd12-5003-8c4d-9b2fa7191b55" :question/math-academy-id "q-95528" :question/problem "$$\n\nIf $y=-\\operatorname{arsech}⁡(\\operatorname{ln}⁡x),$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic secant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡x)=-\\frac{1}{x\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-\\operatorname{arsech}⁡(\\operatorname{ln}⁡x)) \\\\  & =-(-\\frac{1}{\\operatorname{ln}⁡x\\sqrt{1-{ln}^{2}⁡x}})\\cdot (\\operatorname{ln}⁡x)^{′} \\\\  & =\\frac{1}{\\operatorname{ln}⁡x\\sqrt{1-{ln}^{2}⁡x}}\\cdot \\frac{1}{x} \\\\  & =\\frac{1}{x\\operatorname{ln}⁡x\\sqrt{1-{ln}^{2}⁡x}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186525015 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "154fd44c-1903-5cec-bc2f-cfb042f862e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x}{\\sqrt{1+{x}^{2}}\\operatorname{arcoth}⁡x}" :db/id #edb/ref 17592186524421} {:answer/id #uuid "2e708ed0-211d-5ee2-b1e8-74d164752177" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x}{(1-{x}^{2}){arcoth}^{2}⁡x}" :db/id #edb/ref 17592186524467} {:answer/id #uuid "5d2dd98c-0888-5e14-a9da-7bfa796c8fcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{sin}⁡x}{(1-{x}^{2}){arcoth}^{2}⁡x}" :db/id #edb/ref 17592186524538} {:answer/id #uuid "68314971-85df-5e1a-bb8d-30df1853ed17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{sin}^{2}⁡x}{\\sqrt{1+{x}^{2}}{arcoth}^{2}⁡x}" :db/id #edb/ref 17592186524552} {:answer/id #uuid "9d4b0471-37b3-54f6-a468-ae5368af1054" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{cos}^{2}⁡x}{(1-{x}^{2})\\operatorname{arcoth}⁡x}" :db/id #edb/ref 17592186524633}] :answer-field/correct {:answer/id #uuid "5d2dd98c-0888-5e14-a9da-7bfa796c8fcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{sin}⁡x}{(1-{x}^{2}){arcoth}^{2}⁡x}" :db/id #edb/ref 17592186524538} :answer-field/id #uuid "61946e48-e92a-5775-b260-b027052600f7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524881}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9939cec3-a9a6-5501-8d65-e82136850623" :question/math-academy-id "q-95558" :question/problem "$$\n\nIf $f(x)=\\frac{\\operatorname{sin}⁡x}{\\operatorname{arcoth}⁡x},$ then ${f}^{′}(x)=\\frac{\\operatorname{cos}⁡x}{\\operatorname{arcoth}⁡x}+g(x).$ What is $g(x)?$" :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=\\operatorname{sin}⁡x$ and $v(x)=\\operatorname{arcoth}⁡x.$\n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(\\operatorname{sin}⁡x)^{′}\\cdot \\operatorname{arcoth}⁡x-\\operatorname{sin}⁡x\\cdot (\\operatorname{arcoth}⁡x)^{′}}{{arcoth}^{2}⁡x} \\\\  & =\\frac{(\\operatorname{sin}⁡x)^{′}\\cdot \\operatorname{arcoth}⁡x}{{arcoth}^{2}⁡x}-\\frac{\\operatorname{sin}⁡x\\cdot (\\operatorname{arcoth}⁡x)^{′}}{{arcoth}^{2}⁡x} \\\\  & =\\frac{(\\operatorname{sin}⁡x)^{′}}{\\operatorname{arcoth}⁡x}-\\frac{\\operatorname{sin}⁡x\\cdot (\\operatorname{arcoth}⁡x)^{′}}{{arcoth}^{2}⁡x} \\\\  & =\\frac{\\operatorname{cos}⁡x}{\\operatorname{arcoth}⁡x}-\\frac{\\operatorname{sin}⁡x}{{arcoth}^{2}⁡x}\\cdot (\\frac{1}{1-{x}^{2}}) \\\\  & =\\frac{\\operatorname{cos}⁡x}{\\operatorname{arcoth}⁡x}+\\underbrace{(-\\frac{\\operatorname{sin}⁡x}{(1-{x}^{2}){arcoth}^{2}⁡x})}_{g(x)}.\\end{aligned}\n$$\n\nTherefore, $g(x)=-\\frac{\\operatorname{sin}⁡x}{(1-{x}^{2}){arcoth}^{2}⁡x}.$"} {:db/id #edb/ref 17592186525016 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e4cc218-73fe-5998-8ccf-bc16f3b90e09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8(-1)^{n}}{{n}^{3}\\pi ({n}^{2}{\\pi }^{2}+20)}" :db/id #edb/ref 17592186524514} {:answer/id #uuid "b9355ba0-889c-5450-99e3-818ab0a4f2f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8(-1)^{n}}{{n}^{2}{\\pi }^{2}({n}^{2}{\\pi }^{2}+20)}" :db/id #edb/ref 17592186524676} {:answer/id #uuid "d0a1ae82-6bda-5f83-b1fc-96118fbd6f97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8(-1)^{n}}{{n}^{3}\\pi ({n}^{2}{\\pi }^{2}+20)}" :db/id #edb/ref 17592186524728} {:answer/id #uuid "e570c1cd-6353-5178-af72-bcd3aab8e4d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2(-1)^{n}}{{n}^{3}\\pi ({n}^{2}{\\pi }^{2}+20)}" :db/id #edb/ref 17592186524783}] :answer-field/correct {:answer/id #uuid "4e4cc218-73fe-5998-8ccf-bc16f3b90e09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8(-1)^{n}}{{n}^{3}\\pi ({n}^{2}{\\pi }^{2}+20)}" :db/id #edb/ref 17592186524514} :answer-field/id #uuid "8f9455a9-07ca-5997-b4ca-16fa2b6ab07c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186524903} {:answer-field/choices [{:answer/id #uuid "35c42206-68dd-51fc-99b6-ae210d259dac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186524482} {:answer/id #uuid "3b2f4c1a-00a1-55c0-9e44-6bcc54f3f7de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186524488} {:answer/id #uuid "8c0a8364-45bf-574e-bb9d-0ac0a859448d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186524603} {:answer/id #uuid "cf0bdb29-be00-5a7a-ae5b-f5917ddd3a3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186524725}] :answer-field/correct {:answer/id #uuid "35c42206-68dd-51fc-99b6-ae210d259dac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186524482} :answer-field/id #uuid "e37207bf-0563-5832-ad30-c6a23c3c930c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186524938}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9b306e59-ac03-5a23-8563-3ae450882f03" :question/math-academy-id "q-343882" :question/problem "Select the missing parts in a particular solution of the differential equation ${y}^{″}-5y=f(x),$ where the Fourier series of the $4$-periodic forcing function is given by\n\n$$\nf(x)∼5+{\\sum }_{n=1}^{\\infty }\\frac{2(-1)^{n}}{{n}^{3}\\pi }\\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$\n\n*Hint: You may assume that all the cosine coefficients in the Fourier series of the particular solution are equal to zero.*\n\nThe Fourier series of a particular solution is\n\n$$\n{y}_{p}∼{{field-1}}+{\\sum }_{n=1}^{\\infty }\\,{{field-2}}\\cdot \\operatorname{sin}⁡(\\frac{n\\pi x}{2})\n$$" :question/worked-solution "We assume that a solution of our equation has the following Fourier series:\n\n$$\n{y}_{p}∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$\n\nNow, we compute the derivatives:\n\n$$\n\\begin{aligned}{y}_{p}^{′} & ∼\\frac{\\text{d}}{\\text{d}x}(\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{2}))∼{\\sum }_{n=1}^{\\infty }\\frac{{b}_{n}n\\pi }{2}\\operatorname{cos}⁡(\\frac{n\\pi x}{2}) \\\\ {y}_{p}^{″} & ∼\\frac{\\text{d}}{\\text{d}x}({\\sum }_{n=1}^{\\infty }\\frac{{b}_{n}n\\pi }{2}\\operatorname{cos}⁡(\\frac{n\\pi x}{2}))∼{\\sum }_{n=1}^{\\infty }-\\frac{{b}_{n}{n}^{2}{\\pi }^{2}}{4}\\operatorname{sin}⁡(\\frac{n\\pi x}{2})\\end{aligned}\n$$\n\nNext, we substitute the expressions for ${y}_{p}^{″}$ and ${y}_{p}$ into the equation and have\n\n$$\n{\\sum }_{n=1}^{\\infty }-\\frac{{b}_{n}{n}^{2}{\\pi }^{2}}{4}\\operatorname{sin}⁡(\\frac{n\\pi x}{2})-5(\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{2}))=5+{\\sum }_{n=1}^{\\infty }\\frac{2(-1)^{n}}{{n}^{3}\\pi }\\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$\n\nRearranging the terms, we get \n\n$$\n-5\\cdot \\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{b}_{n}(-\\frac{{n}^{2}{\\pi }^{2}}{4}-5)\\operatorname{sin}⁡(\\frac{n\\pi x}{2})=5+{\\sum }_{n=1}^{\\infty }\\frac{2(-1)^{n}}{{n}^{3}\\pi }\\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$\n\nNow, equating the free terms and sine coefficients, we obtain:\n\n$$\n\\{\\begin{aligned}-5\\cdot \\frac{{a}_{0}}{2}=5 \\\\ {b}_{n}(-\\frac{{n}^{2}{\\pi }^{2}}{4}-5)=\\frac{2(-1)^{n}}{{n}^{3}\\pi }\\end{aligned}\\,⇒\\,\\{\\begin{aligned}\\frac{{a}_{0}}{2}=-1 \\\\ {b}_{n}=-\\frac{8(-1)^{n}}{{n}^{3}\\pi ({n}^{2}{\\pi }^{2}+20)}\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n{y}_{p}∼-1+{\\sum }_{n=1}^{\\infty }\\,-\\frac{8(-1)^{n}}{{n}^{3}\\pi ({n}^{2}{\\pi }^{2}+20)}\\cdot \\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$"} {:db/id #edb/ref 17592186525019 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02f4fc9d-566b-5d57-ab60-fabca700ef9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}}{1-{e}^{-2x}}" :db/id #edb/ref 17592186524381} {:answer/id #uuid "0e7a943d-54c5-5b0f-baea-e089dd6d6ed8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-3x}}{1-{e}^{-2x}}" :db/id #edb/ref 17592186524408} {:answer/id #uuid "1a96d37e-924f-570a-97eb-c47aad22e94a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-{e}^{-2x}}{1-{e}^{-2x}}" :db/id #edb/ref 17592186524431} {:answer/id #uuid "6c93b3da-a9ec-50eb-83e6-da32af5214d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+{e}^{-x}}{1-{e}^{-2x}}" :db/id #edb/ref 17592186524558} {:answer/id #uuid "9963e428-bc98-5d5a-8bdf-bbf100df5e3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-2x}}{1-{e}^{-x}}" :db/id #edb/ref 17592186524627}] :answer-field/correct {:answer/id #uuid "0e7a943d-54c5-5b0f-baea-e089dd6d6ed8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-3x}}{1-{e}^{-2x}}" :db/id #edb/ref 17592186524408} :answer-field/id #uuid "204adb77-c138-51ef-abaa-2ad33fd463d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524853}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9ebac606-d705-5196-a808-5592aaa317af" :question/math-academy-id "q-95544" :question/problem "$$\n\nIf $y={e}^{-x}-\\operatorname{arcoth}⁡{e}^{-x},$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic cotangent function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcoth}⁡x)=\\frac{1}{1-{x}^{2}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({e}^{-x}-\\operatorname{arcoth}⁡{e}^{-x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({e}^{-x})-\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcoth}⁡{e}^{-x}) \\\\  & =-{e}^{-x}-\\frac{1}{1-({e}^{-x})^{2}}\\cdot ({e}^{-x})^{′} \\\\  & =-{e}^{-x}-\\frac{1}{1-{e}^{-2x}}\\cdot (-{e}^{-x}) \\\\  & =\\frac{{e}^{-x}}{1-{e}^{-2x}}-{e}^{-x} \\\\  & ={e}^{-x}(\\frac{1}{1-{e}^{-2x}}-1) \\\\  & ={e}^{-x}(\\frac{{e}^{-2x}}{1-{e}^{-2x}}) \\\\  & =\\frac{{e}^{-3x}}{1-{e}^{-2x}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186525026 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "121480c5-f561-5438-8bde-1acc56bc6ff3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6}{|3x-1|\\sqrt{3{x}^{2}-2x+1}}" :db/id #edb/ref 17592186524413} {:answer/id #uuid "19520b3d-6125-58b2-9903-4c322a050cc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{|3x-1|\\sqrt{9{x}^{2}-6x+2}}" :db/id #edb/ref 17592186524428} {:answer/id #uuid "3cf94dd4-3101-57df-8fb6-af244a85af6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{18}{|3x-1|\\sqrt{3{x}^{2}-2x+1}}" :db/id #edb/ref 17592186524496} {:answer/id #uuid "7609ee66-97eb-5813-aafc-fc892436fd47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{18}{|3x-1|\\sqrt{9{x}^{2}-6x+2}}" :db/id #edb/ref 17592186524570} {:answer/id #uuid "9773a4e4-9e61-52c8-8ddc-223abc70cb19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18}{|3x-1|\\sqrt{9{x}^{2}-6x+2}}" :db/id #edb/ref 17592186524623}] :answer-field/correct {:answer/id #uuid "7609ee66-97eb-5813-aafc-fc892436fd47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{18}{|3x-1|\\sqrt{9{x}^{2}-6x+2}}" :db/id #edb/ref 17592186524570} :answer-field/id #uuid "aadc444a-ce5f-537d-823a-1f9066caed79" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524913}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "aa97bd1f-f2ce-5f6f-ba26-21c15fc2c29a" :question/math-academy-id "q-95520" :question/problem "$$\n\nIf $y=6\\operatorname{arcsch}⁡(3x-1),$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡x)=-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-6\\operatorname{arcsch}⁡(3x-1)) \\\\  & =6\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡(3x-1)) \\\\  & =6\\cdot (-\\frac{1}{|3x-1|\\sqrt{1+(3x-1)^{2}}})\\cdot (3x-1)^{′} \\\\  & =-6\\cdot \\frac{1}{|3x-1|\\sqrt{1+9{x}^{2}-6x+1}}\\cdot 3 \\\\  & =-\\frac{18}{|3x-1|\\sqrt{9{x}^{2}-6x+2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186525036 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "580baff0-5127-514b-bc2e-6c81d289eac9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{(x-3)\\sqrt{{x}^{2}-6x+8}}" :db/id #edb/ref 17592186524533} {:answer/id #uuid "8917544d-559b-577c-8ba8-1430a960ff36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{(x-3)^{2}\\sqrt{{x}^{2}-6x+8}}" :db/id #edb/ref 17592186524597} {:answer/id #uuid "a4bb3106-2e47-50d0-84fc-a8d09d82a983" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{(x-3)\\sqrt{-{x}^{2}+6x-8}}" :db/id #edb/ref 17592186524644} {:answer/id #uuid "cb4343a1-3927-5329-9b12-c84f24e0a18a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{(x-3)\\sqrt{-{x}^{2}+6x-8}}" :db/id #edb/ref 17592186524718} {:answer/id #uuid "d1ff5ad7-503f-5dfb-a830-f4530ad208c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-3}{\\sqrt{-{x}^{2}+6x-8}}" :db/id #edb/ref 17592186524730}] :answer-field/correct {:answer/id #uuid "cb4343a1-3927-5329-9b12-c84f24e0a18a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{(x-3)\\sqrt{-{x}^{2}+6x-8}}" :db/id #edb/ref 17592186524718} :answer-field/id #uuid "3199a6b3-9ebf-5ee0-ab91-18ad9a99a784" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524861}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bd478fb8-ad97-5721-be1e-e2165b917cab" :question/math-academy-id "q-95524" :question/problem "$$\n\nIf $y=-\\operatorname{arsech}⁡(x-3),$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic secant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡x)=-\\frac{1}{x\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-\\operatorname{arsech}⁡(x-3)) \\\\  & =-(-\\frac{1}{(x-3)\\sqrt{1-(x-3)^{2}}})\\cdot (x-3)^{′} \\\\  & =\\frac{1}{(x-3)\\sqrt{1-{x}^{2}+6x-9}}\\cdot 1 \\\\  & =\\frac{1}{(x-3)\\sqrt{-{x}^{2}+6x-8}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186525046 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cba90753-0239-53f3-8288-4708dc4bd2d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6x+23" :db/id #edb/ref 17592186524719}] :answer-field/correct {:answer/id #uuid "cba90753-0239-53f3-8288-4708dc4bd2d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6x+23" :db/id #edb/ref 17592186524719} :answer-field/id #uuid "618796c9-d723-5e11-9f71-2d4878c12e36" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186524880}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d79473d6-bc2e-50df-aa4f-f2c7866c75c4" :question/math-academy-id "q-237034" :question/problem "Find the equation of the line that passes through the point $(4,-1)$ and is perpendicular to the line passing through the points $(2,3)$ and $(-4,2).$\n\n$y=$\n{{field-1}}" :question/worked-solution "Perpendicular lines have slopes that are negative reciprocals of each other.\n\nFirst, let's find the slope ${m}_{1}$ of the line passing through the points $(2,3)$ and $(-4,2):$\n\n$$\n\\begin{aligned}{m}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{2-3}{-4-2} \\\\  & =\\frac{(-1)}{(-6)} \\\\  & =\\frac{1}{6}\\end{aligned}\n$$\n\nSince we want a perpendicular line, the slope $m$ of the line we're trying to find must satisfy\n\n$$\nm\\cdot (\\frac{1}{6})=-1\\,⇒\\,m=-6.\n$$\n\nWe know that the line passes through the point $(4,-1).$ Using point-slope form and simplifying, we obtain the equation of the line in slope-intercept form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-1) & =-6(x-4) \\\\ y+1 & =-6x+24 \\\\ y & =-6x+23\\end{aligned}\n$$"} {:db/id #edb/ref 17592186525057 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07099b62-b5de-5c35-89a0-02da7d237dd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{2}+1}(1-\\frac{2x}{\\sqrt{{x}^{4}+2{x}^{2}+2}})" :db/id #edb/ref 17592186524394} {:answer/id #uuid "109c4078-1dc2-5f49-97cd-be914eaf3edf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{2}+1}(1+\\frac{2x}{\\sqrt{{x}^{4}+2{x}^{2}+2}})" :db/id #edb/ref 17592186524411} {:answer/id #uuid "92f271ed-bbcd-5ac7-8f4f-93ee8ccc4ce9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{2}+1}(1+\\frac{x}{\\sqrt{{x}^{4}+2}})" :db/id #edb/ref 17592186524614} {:answer/id #uuid "99e51ccf-d968-5c52-81a9-7aa43ff31aac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{2}+1}(1-\\frac{x}{\\sqrt{{x}^{4}+2{x}^{2}+2}})" :db/id #edb/ref 17592186524629} {:answer/id #uuid "c136c3e1-1248-5b47-b929-510459d6c30b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{2}+1}(1-\\frac{2x}{\\sqrt{{x}^{4}+2}})" :db/id #edb/ref 17592186524691}] :answer-field/correct {:answer/id #uuid "07099b62-b5de-5c35-89a0-02da7d237dd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{2}+1}(1-\\frac{2x}{\\sqrt{{x}^{4}+2{x}^{2}+2}})" :db/id #edb/ref 17592186524394} :answer-field/id #uuid "7230352a-4cad-516b-aa5e-9529af383602" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524892}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ee2856c4-f82b-5153-9418-e0c2792ce17b" :question/math-academy-id "q-95519" :question/problem "$$\n\nIf $y=\\operatorname{arctan}⁡x+\\operatorname{arcsch}⁡({x}^{2}+1),$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡x)=-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}⁡x+\\operatorname{arcsch}⁡({x}^{2}+1)) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}⁡x)+\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡({x}^{2}+1)) \\\\  & =\\frac{1}{{x}^{2}+1}+(-\\frac{1}{|{x}^{2}+1|\\sqrt{1+({x}^{2}+1)^{2}}})\\cdot ({x}^{2}+1)^{′} \\\\  & =\\frac{1}{{x}^{2}+1}-\\frac{1}{({x}^{2}+1)\\sqrt{1+{x}^{4}+2{x}^{2}+1}}\\cdot 2x \\\\  & =\\frac{1}{{x}^{2}+1}(1-\\frac{2x}{\\sqrt{{x}^{4}+2{x}^{2}+2}}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186525983 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3be7eede-e167-5c13-8ad5-b830a9988ca9" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c7/c77d3beef366f78cf33737aee3670bdfc33dead94343fbd0b9751877e05fc274.png" :db/id #edb/ref 17592186525353} {:answer/id #uuid "8bdddc54-3fca-52c9-80a6-920a1e42293e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0d/0dd517f92e04807a46b4522b619122f589605c773f1c0bfe8d2d0007790e0537.png" :db/id #edb/ref 17592186525556} {:answer/id #uuid "8e5f0ec4-3d24-5bf6-96de-a92982414f2b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/92/92e4d04bbd20d88b8dfd8635075bd056ca0efa54a0b740707f4d060b5db99979.png" :db/id #edb/ref 17592186525565} {:answer/id #uuid "ed21c795-4fd0-5f81-8abc-5b67ee80523b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0a/0a7f6fe01fb5471dd52b03cfed96c036c0222f8bd04cc76a5cd43fe1694cfaff.png" :db/id #edb/ref 17592186525795} {:answer/id #uuid "f8a4b029-7e35-5889-a503-7e8558e6a122" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ac/acfaeb0485a725175f5453acd322ee7ec7ef0bbc9ce38af2364a3c2b4fed1017.png" :db/id #edb/ref 17592186525823}] :answer-field/correct {:answer/id #uuid "3be7eede-e167-5c13-8ad5-b830a9988ca9" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c7/c77d3beef366f78cf33737aee3670bdfc33dead94343fbd0b9751877e05fc274.png" :db/id #edb/ref 17592186525353} :answer-field/id #uuid "fe0f43fe-17e5-5ba1-8867-16d28df1dad5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525980}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "00f70d95-0a5c-50e2-bf6d-4e4f4b73ad51" :question/math-academy-id "q-87172" :question/problem "![](images/a8/a820aee214e9b47f35964e31e11a45b30d909c04bfd8b81a8ea0dc70055c2094.png)\n\nThe diagram above shows the function $y=f(x).$ Which of the following gives the graph of $y=f(\\frac{1}{2}x-\\frac{1}{2})?$" :question/worked-solution "To perform transformations of functions with multiple operations, we must remember the following rule:\n\n1\\. First, we perform the transformations *inside* the argument of $f.$ We first carry out horizontal stretches, followed by horizontal translations.\n\n2\\. Then, we perform the transformations *outside* the argument of $f.$ We first carry out vertical stretches, followed by vertical translations.\n\nFirst, let's factor out the coefficient next to the $x$ inside the parentheses:\n\n$$\n\\begin{aligned}y & =f(\\frac{1}{2}x-\\frac{1}{2})=f(\\frac{1}{2}(x-1))\\end{aligned}\n$$\n\nTo plot $y=f(\\frac{1}{2}(x-1)),$ we apply the following steps:\n\n- Take the curve $y=f(x).$\n\n- Stretch it by a scale factor of $\\frac{1}{(\\frac{1}{2})}=2$ parallel to the $x$-axis to get the graph of $y=f(\\frac{1}{2}x).$\n\n![](images/ef/efac5abdc5ec66c794f01c53d14b10f51ff527699eae40d2f6d5802f7b51a15e.png)\n\n- Then, translate it right by $1$ unit to get the graph of $y=f(\\frac{1}{2}(x-1)).$\n\n![](images/76/76182965d505e8c87d15b65569c6a67f9e6e0baedbbf18ece2ff59feb85efd69.png)"} {:db/id #edb/ref 17592186525986 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41a6c98c-df20-52e9-b020-5b29c2031ff2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{x}{2})-\\frac{x}{2}+C" :db/id #edb/ref 17592186525369} {:answer/id #uuid "5f74a86d-e3cc-5dbf-bdd7-a4113fc9ffda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡(\\frac{x}{4})-\\frac{x}{4}+C" :db/id #edb/ref 17592186525448} {:answer/id #uuid "8bc4bc64-d436-586c-8553-f98dd5c6afbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{x}{4})+\\frac{x}{4}+C" :db/id #edb/ref 17592186525555} {:answer/id #uuid "8dd11786-9c3e-599a-8f4c-3162daf243f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{sin}⁡(\\frac{x}{2})+2x+C" :db/id #edb/ref 17592186525560} {:answer/id #uuid "f633a7e0-a621-5680-81e8-02a8418234da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{x}{2})-x+C" :db/id #edb/ref 17592186525818}] :answer-field/correct {:answer/id #uuid "41a6c98c-df20-52e9-b020-5b29c2031ff2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{x}{2})-\\frac{x}{2}+C" :db/id #edb/ref 17592186525369} :answer-field/id #uuid "ffb0e851-b32c-55d6-a987-0e041012f9ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525982}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0dd7b4b0-db82-575a-9dad-d6a7735e5596" :question/math-academy-id "q-114700" :question/problem "$\\int [{cos}^{2}⁡(\\frac{x}{4})-1]\\text{d}x=$" :question/worked-solution "Here, we use the double-angle formula for cosine that involves the ${cos}^{2}⁡\\theta $ term, given by\n\n$$\n\\operatorname{cos}⁡2\\theta =2{cos}^{2}⁡\\theta -1.\n$$\n\n \n\nRearranging, we have\n\n$$\n{cos}^{2}⁡\\theta =\\frac{1}{2}(\\operatorname{cos}⁡2\\theta +1).\n$$\n\nLetting $\\theta =\\frac{x}{4},$ we have\n\n$$\n{cos}^{2}⁡(\\frac{x}{4})=\\frac{1}{2}[\\operatorname{cos}⁡(\\frac{x}{2})+1].\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}\\int [{cos}^{2}⁡(\\frac{x}{4})-1]\\text{d}x & =\\int [\\frac{1}{2}[\\operatorname{cos}⁡(\\frac{x}{2})+1]-1]\\text{d}x \\\\  & =\\int [\\frac{1}{2}\\operatorname{cos}⁡(\\frac{x}{2})+\\frac{1}{2}-1]\\text{d}x \\\\  & =\\int [\\frac{1}{2}\\operatorname{cos}⁡(\\frac{x}{2})-\\frac{1}{2}]\\text{d}x \\\\  & =\\frac{1}{2}[2\\operatorname{sin}⁡(\\frac{x}{2})]-\\frac{1}{2}x+C \\\\  & =\\operatorname{sin}⁡(\\frac{x}{2})-\\frac{x}{2}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186525987 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ee6f530-d95e-57a0-af25-c2a599a4fca0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/85/8576e182b199885a0c93efa40ed28cd50f20fee03fb3cb9094ddf9f636b28942.png" :db/id #edb/ref 17592186525406} {:answer/id #uuid "54b9772e-234b-5fb8-925d-81356e243b51" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9f/9fe0db9b8576acb8bd7f89222fc177d07e115cc4a52b1bb0d1ec406868ceaa20.png" :db/id #edb/ref 17592186525427} {:answer/id #uuid "565f0b0d-5cbf-5a11-9d31-f10f9dc7380c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/da/da0530d2c06dd94716ea79bbfe2923fc5fad5a4d6a6da3dd435be84920f8a692.png" :db/id #edb/ref 17592186525429} {:answer/id #uuid "ce56a25c-7a51-579f-8de2-52dda9ab57ed" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/30/300a6358abf734bc3960fe39e4c28fd9b1174697faa6f5db44fa2c516974d04d.png" :db/id #edb/ref 17592186525718} {:answer/id #uuid "d55e78a9-2a3d-5ee5-9e4e-cfda58276a32" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/22/227777072e65f93aaac50a82e63378663de1c71da4ffd1f8ea86869628d1da16.png" :db/id #edb/ref 17592186525737}] :answer-field/correct {:answer/id #uuid "d55e78a9-2a3d-5ee5-9e4e-cfda58276a32" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/22/227777072e65f93aaac50a82e63378663de1c71da4ffd1f8ea86869628d1da16.png" :db/id #edb/ref 17592186525737} :answer-field/id #uuid "fb181ae6-2f97-5c23-bf32-d7b7ada1a42f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525977}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0e7bd953-d64f-5fc1-9cc8-824abcf9bec9" :question/math-academy-id "q-87529" :question/problem "![](images/98/98ae486b18ff78601faf8a99f5310df982a73f0403ecf43186eef947b847bed4.png)\n\nThe diagram above shows the function $y=f(x).$ Which of the following gives the graph of $y=\\frac{1}{2}f(\\frac{1}{4}(x-1))-8?$" :question/worked-solution "To perform transformations of functions with multiple operations, we must remember the following rule:\n\n1\\. First, we perform the transformations *inside* the argument of $f.$ We first carry out horizontal stretches, followed by horizontal translations.\n\n2\\. Then, we perform the transformations *outside* the argument of $f.$ We first carry out vertical stretches, followed by vertical translations.\n\nTo plot $y=\\frac{1}{2}f(\\frac{1}{4}(x-1))-8,$ we apply the following steps:\n\n- Take the curve $y=f(x).$\n\n- Stretch it by a scale factor of $\\frac{1}{(\\frac{1}{4})}=4$ parallel to the $x$-axis to get the graph of $y=f(\\frac{1}{4}x).$\n\n![](images/b6/b6b847be6f77123d3baec5f3541caf2a151039e35a5aad68b0228508d84dbc88.png)\n\n- Then, translate it right by $1$ unit to get the graph of $y=f(\\frac{1}{4}(x-1)).$\n\n![](images/8d/8da2b9a2d31c082c069a066709afd5346c702c75a96b840d1c6ee5d9f940bf8f.png)\n\n- Then, stretch it by a scale factor of $\\frac{1}{2}$ parallel to the $y$-axis to get the graph of $y=\\frac{1}{2}f(\\frac{1}{4}(x-1)).$\n\n![](images/fd/fd1ee07f396bf7561dc93cf4eb5f4098bb0c465c6f4b4a83328751d7e9a65dfa.png)\n\n- Finally, translate it down by $8$ units to get the graph of $y=\\frac{1}{2}f(\\frac{1}{4}(x-1))-8.$\n\n![](images/b9/b9f282fc14207257835dbf9ce368d07e68cb207a04875a64cccfe07f31ef5d32.png)"} {:db/id #edb/ref 17592186525990 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2714853-7020-594c-83a2-daf04d42e112" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^2}{\\sqrt{1-4x^2}}" :db/id #edb/ref 17592186525812}] :answer-field/correct {:answer/id #uuid "f2714853-7020-594c-83a2-daf04d42e112" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^2}{\\sqrt{1-4x^2}}" :db/id #edb/ref 17592186525812} :answer-field/id #uuid "69ac6f6a-864a-510b-ab52-fe182c5c37c0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186525895}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "198c9de8-ff94-5b1b-9df3-bdbe404e2b21" :question/math-academy-id "q-341557" :question/problem "$$\n\nIf $f(x)={x}^{3}\\,\\operatorname{arsech}⁡(2x),$ calculate ${f}^{′}(x).$\n\n${f}^{′}(x)=3{x}^{2}\\operatorname{arsech}⁡(2x)\\,-$ \n{{field-1}}" :question/worked-solution "In this case, the expression for $f(x)$ is a product $u(x)\\cdot v(x)$ with $u(x)={x}^{3}$ and $v(x)=\\operatorname{arsech}⁡(2x).$\n\nTherefore, we apply the product rule as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={({x}^{3})}^{′}\\cdot \\operatorname{arsech}⁡(2x)+{x}^{3}\\cdot {[\\operatorname{arsech}⁡(2x)]}^{′} \\\\  & =3{x}^{2}\\cdot \\operatorname{arsech}⁡(2x)\\,+\\,{x}^{3}\\cdot [-\\frac{(2x)^{′}}{2x\\sqrt{1-(2x)^{2}}}] \\\\  & =3{x}^{2}\\operatorname{arsech}⁡(2x)+{x}^{3}\\cdot (-\\frac{2}{2x\\sqrt{1-4{x}^{2}}}) \\\\  & =3{x}^{2}\\operatorname{arsech}⁡(2x)-\\frac{{x}^{2}}{\\sqrt{1-4{x}^{2}}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186525992 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b77fb03-0e8f-5bdb-a62a-cd454390d957" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/af/af606e33e00156f567f5fea87a0c6d5730775fd9f05bfda5f0498d294384f2d1.png" :db/id #edb/ref 17592186525395} {:answer/id #uuid "5a94c15a-4b22-523c-9d8b-faa505cf7c3e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e8/e84cdb5e51258a1aba0022f46dc031e5aeff6ef06c186cee8efcac28d5177bc4.png" :db/id #edb/ref 17592186525438} {:answer/id #uuid "78e22db9-65e0-53cb-bb23-cbfbac8e5374" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/82/82881c772ec725bee0e8aaa6f34b698fa2be53236118b690aeb95a4ae987997b.png" :db/id #edb/ref 17592186525508} {:answer/id #uuid "b8623f0e-89e5-5b96-aa54-9cb4bcd7a2f7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5a/5a7557a85cb5f7ffaedc4bc921dee30f0d7e6535a351ba604158644f957e4763.png" :db/id #edb/ref 17592186525679} {:answer/id #uuid "c5dc7aab-2ca5-594f-b5ef-b2cdef887dcf" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/78/78c24be2e92e30723ccfcdc6916c820abe154f0857ded659b0f01d0c42ab08b5.png" :db/id #edb/ref 17592186525707}] :answer-field/correct {:answer/id #uuid "78e22db9-65e0-53cb-bb23-cbfbac8e5374" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/82/82881c772ec725bee0e8aaa6f34b698fa2be53236118b690aeb95a4ae987997b.png" :db/id #edb/ref 17592186525508} :answer-field/id #uuid "fb83dba9-f3a4-5912-b412-abeb30854374" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525978}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1ccf6e6d-aaeb-5896-b8d7-bc61aff893e6" :question/math-academy-id "q-87144" :question/problem "![](images/41/41cd1216273c3157628ffb6879f50bc41dbed5490b310f5247914b2d47e6500c.png)\n\nThe diagram above shows the function $y=f(x).$ Which of the following gives the graph of $y=4f(\\frac{1}{3}x)?$" :question/worked-solution "To perform transformations of functions with multiple operations, we must remember the following rule:\n\n1\\. First, we perform the transformations *inside* the argument of $f.$ We first carry out horizontal stretches, followed by horizontal translations.\n\n2\\. Then, we perform the transformations *outside* the argument of $f.$ We first carry out vertical stretches, followed by vertical translations.\n\nTo plot $y=4f(\\frac{1}{3}x),$ we apply the following steps:\n\n- Take the curve $y=f(x).$\n\n- Stretch it by a scale factor of $\\frac{1}{(\\frac{1}{3})}=3$ parallel to the $x$-axis to get the graph of $y=f(\\frac{1}{3}x).$\n\n![](images/a4/a4ac07da53b80c9ce828e9adca5efc41635d2ca4d56b97340aafa09c824bf956.png)\n\n- Then, stretch it by a scale factor of $4$ parallel to the $y$-axis to get the graph of $y=4f(\\frac{1}{3}x).$\n\n![](images/28/28fc05b5ed03768282704609a1d4c05e5c579e75bca0bd5c9f4776c460fe8ae1.png)"} {:db/id #edb/ref 17592186525996 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "006306fb-d1f5-5084-bc23-6f171183965a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{11}}{2}" :db/id #edb/ref 17592186525209} {:answer/id #uuid "4ee5f784-7760-5fc1-a06d-4af99980535d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10}}{4}" :db/id #edb/ref 17592186525405} {:answer/id #uuid "901ba962-b8ce-529a-97dc-8257c3970528" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{4}" :db/id #edb/ref 17592186525570} {:answer/id #uuid "e67b22cc-e319-5d6c-84b8-c400c13c7b46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186525777} {:answer/id #uuid "fc9fcd07-adf8-57e0-a429-dc973055ba61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186525832}] :answer-field/correct {:answer/id #uuid "006306fb-d1f5-5084-bc23-6f171183965a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{11}}{2}" :db/id #edb/ref 17592186525209} :answer-field/id #uuid "9a9194b8-ac65-503a-b901-f89939619d07" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525924}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2a9deff8-468e-536e-b35a-37a221ceafcf" :question/math-academy-id "q-18503" :question/problem "![](images/40/400427aa7dd8446124c44355959792d8e818e3118ee60ebb315c26a4b74375f1.png)\n\nWhat is the least distance between the curve $y=\\sqrt{x+1}$ and the point $(2,0)?$" :question/worked-solution "Let us consider the *squared* distance $S$ between $(2,0)$ and a general point $P(x,y)$:\n\n$$\n\\begin{aligned}S & =(x-2)^{2}+(y-0)^{2}\\end{aligned}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{x+1}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S & =(x-2)^{2}+(y)^{2} \\\\  & =(x-2)^{2}+(\\sqrt{x+1})^{2} \\\\  & =(x-2)^{2}+x+1 \\\\  & ={x}^{2}-4x+4+x+1 \\\\  & ={x}^{2}-3x+5.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=2x-3 & =0 \\\\ 2x & =3 \\\\ x & =\\frac{3}{2}\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(x)=2>0.$ Therefore, $x=\\frac{3}{2}$ is a minimum of $S.$\n\nSince $S$ gives the squared distance between the two points, the actual distance $d$ between the two points when $x=\\frac{3}{2}$ is given by\n\n$$\nd=\\sqrt{S(\\frac{3}{2})}.\n$$\n\nComputing this quantity, we get\n\n$$\n\\begin{aligned}d & =\\sqrt{S(\\frac{3}{2})} \\\\  & =\\sqrt{{(\\frac{3}{2})}^{2}-3(\\frac{3}{2})+5} \\\\  & =\\sqrt{\\frac{11}{4}} \\\\  & =\\frac{\\sqrt{11}}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186526008 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fa4d90f-a918-5ed3-b385-36da02a383b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{x}+\\sqrt{5}\\,{x}^{\\sqrt{5}-1}" :db/id #edb/ref 17592186525317} {:answer/id #uuid "3d33eb11-3dd6-47e9-8b6a-3bca8b61e2ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186576453} {:answer/id #uuid "45020e57-35fb-42f8-8b20-acd1b2b7ddda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{x}" :db/id #edb/ref 17592186576454} {:answer/id #uuid "faf0099d-2a91-4f76-986b-4f1970d04dcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{x}+" :db/id #edb/ref 17592186576455} {:answer/id #uuid "edc651c6-40c6-4b23-b2e9-58f1bc8554b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{x}+s" :db/id #edb/ref 17592186576456} {:answer/id #uuid "bfdccc7f-442c-46ec-9f1b-81289d9e09d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{x}+\\sqrt5" :db/id #edb/ref 17592186576457} {:answer/id #uuid "3712fe24-6820-4a26-8939-516fd36ce77e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{x}+\\sqrt5x" :db/id #edb/ref 17592186576458} {:answer/id #uuid "10354f53-aeb2-48f1-a392-a7aa21b1a47f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{x}+\\sqrt5x^{\\left(\\right)}" :db/id #edb/ref 17592186576459} {:answer/id #uuid "b3106a52-5c00-495b-a9e6-01c54b2975d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{x}+\\sqrt5x^{\\left(\\sqrt{\\placeholder{}}\\right)}" :db/id #edb/ref 17592186576460} {:answer/id #uuid "e287659d-3d27-4534-837c-556fc6628ac7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{x}+\\sqrt5x^{\\left(\\sqrt5\\right)}" :db/id #edb/ref 17592186576461} {:answer/id #uuid "a93b31b3-5383-4788-acbe-1693c464e593" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{x}+\\sqrt5x^{\\left(\\sqrt5-\\right)}" :db/id #edb/ref 17592186576462} {:answer/id #uuid "b6c1a197-944e-42ba-9959-c0fe16d9b9e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{x}+\\sqrt5x^{\\left(\\sqrt5-1\\right)}" :db/id #edb/ref 17592186576463}] :answer-field/correct {:answer/id #uuid "2fa4d90f-a918-5ed3-b385-36da02a383b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{x}+\\sqrt{5}\\,{x}^{\\sqrt{5}-1}" :db/id #edb/ref 17592186525317} :answer-field/id #uuid "d43d0069-7eca-5550-b958-b760fbd1e40e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186525951}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3937eb65-3904-5741-a603-d6263de51574" :question/math-academy-id "q-339969" :question/problem "Given that $y=4\\operatorname{ln}⁡x+{x}^{\\sqrt{5}}+7$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$ \n{{field-1}}" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(4\\operatorname{ln}⁡x+3{x}^{\\sqrt{5}}+7) \\\\  & =4(\\frac{1}{x})+(\\sqrt{5}\\,{x}^{\\sqrt{5}-1}) \\\\  & =\\frac{4}{x}+\\sqrt{5}\\,{x}^{\\sqrt{5}-1}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186526014 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3be6398b-72ea-5680-8cab-aa7da8cbf075" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4x}" :db/id #edb/ref 17592186525352} {:answer/id #uuid "7b7d9e39-128e-5483-b6bb-f240e6bc751e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4x}" :db/id #edb/ref 17592186525513} {:answer/id #uuid "7f778359-dbac-5e42-9c14-e4ed66dfc4f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{x}" :db/id #edb/ref 17592186525521} {:answer/id #uuid "85cd2de0-1d1e-5a84-9740-a8680df5a642" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{x}" :db/id #edb/ref 17592186525546} {:answer/id #uuid "f1e22649-5794-5e1c-9be5-cb8a4f5f5c28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{x}" :db/id #edb/ref 17592186525807}] :answer-field/correct {:answer/id #uuid "7b7d9e39-128e-5483-b6bb-f240e6bc751e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4x}" :db/id #edb/ref 17592186525513} :answer-field/id #uuid "3fce1adb-76f0-545b-a5e4-be69ad432788" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525879}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4890c920-695d-52f8-8b20-5f7886a5c8be" :question/math-academy-id "q-70887" :question/problem "Given that $y=\\frac{\\operatorname{ln}⁡x}{4}$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "The derivative of the natural logarithm is the reciprocal function:\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x)=\\frac{1}{x}\n$$\n\nWe apply our formula and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\operatorname{ln}⁡x}{4}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{4}\\,\\operatorname{ln}⁡x) \\\\  & =\\frac{1}{4}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x) \\\\  & =\\frac{1}{4}\\cdot \\frac{1}{x} \\\\  & =\\frac{1}{4x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186526023 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d5894a6-585a-5378-980a-d0b4918ebe65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "117.8" :db/id #edb/ref 17592186525272} {:answer/id #uuid "1dc91232-f4fd-5500-9e9c-3f3b79bc8f90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-115" :db/id #edb/ref 17592186525273} {:answer/id #uuid "38a35c11-0877-5b8c-8deb-7cbd4ec8050c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "111.2" :db/id #edb/ref 17592186525346} {:answer/id #uuid "6b131fa6-da3e-5c2b-95f6-b968ac6bd127" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-112.6" :db/id #edb/ref 17592186525481} {:answer/id #uuid "f510ed19-8259-5a62-be17-1779046fc096" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-118.4" :db/id #edb/ref 17592186525816}] :answer-field/correct {:answer/id #uuid "6b131fa6-da3e-5c2b-95f6-b968ac6bd127" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-112.6" :db/id #edb/ref 17592186525481} :answer-field/id #uuid "131d7498-714e-5616-b341-5ffc1f680236" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525854}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5d776d5a-a6fa-564f-99d4-3a36bad98246" :question/math-academy-id "q-159949" :question/problem "Suppose ${X}_{1},{X}_{2},…,{X}_{14}$ is an I.I.D random sample with ${X}_{i}∼N(\\theta ,{1}^{2}),$ where $\\theta $ is an unknown mean. For a particular sample ${x}_{1},{x}_{2},…,{x}_{14},$ you're given that \n\n$$\n{\\sum }_{i=1}^{14}{x}_{i}=26.8,\\,{\\sum }_{i=1}^{14}{x}_{i}^{2}=264.8.\n$$\n\nGiven that the log-likelihood function of the sample is\n\n$$\nl(\\theta )=-7\\operatorname{ln}⁡(2\\pi )+a+b\\theta +c{\\theta }^{2},\n$$\n\nwhat is the value of $a+b+c?$\n\n*Hint: The probability density function for a normal random variable with mean $\\theta $ and standard deviation $1$ is given by* \n\n$$\nf(x)=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i};\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i};\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=14$ independent normal random variables with unknown mean $\\theta $ and variance ${\\sigma }^{2}=1,$ for which the probability density function is\n\n$$\nf(x,\\theta )=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$\n\nNext, we write down the log-density function:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡f(x,\\theta ) & =\\operatorname{ln}⁡(\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2}) \\\\  & =\\operatorname{ln}⁡(\\frac{1}{\\sqrt{2\\pi }})+\\operatorname{ln}⁡({e}^{-(x-\\theta )^{2}/2}) \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{(x-\\theta )^{2}}{2}.\\end{aligned}\n$$\n\nNow, we can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}(-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{({x}_{i}-\\theta )^{2}}{2}) \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-{\\sum }_{i=1}^{n}\\frac{({x}_{i}-\\theta )^{2}}{2} \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}({\\sum }_{i=1}^{n}{x}_{i}^{2}-2\\theta {\\sum }_{i=1}^{n}{x}_{i}+n{\\theta }^{2})\\end{aligned}\n$$\n\nWe are told that ${\\sum }_{i=1}^{14}{x}_{i}=26.8,$ ${\\sum }_{i=1}^{14}{x}_{i}^{2}=264.8,$ and $n=14.$ Therefore, \n\n$$\n\\begin{aligned}l(\\theta ) & =-\\frac{14}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}(264.8-2\\theta \\cdot 26.8+14{\\theta }^{2}) \\\\  & =-7\\operatorname{ln}⁡(2\\pi )+(-132.4)+26.8\\theta +(-7){\\theta }^{2}.\\end{aligned}\n$$\n\nFinally, \n\n$$\na+b+c=(-132.4)+26.8+(-7)=-112.6.\n$$"} {:db/id #edb/ref 17592186526027 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d0502bf-4b7b-56bd-8f60-e6aa2b4b7732" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{{e}^{x}\\sqrt{1+{e}^{2x}}}" :db/id #edb/ref 17592186525516} {:answer/id #uuid "9c744cb0-6b47-5126-beaa-1ffdb2fe62d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{\\sqrt{1+{e}^{2x}}}" :db/id #edb/ref 17592186525603} {:answer/id #uuid "b27f2561-56c9-5fb2-a134-f7c789829f29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4{e}^{x}}{\\sqrt{1+{e}^{2x}}}" :db/id #edb/ref 17592186525663} {:answer/id #uuid "c21ad8f6-9fc1-5677-b4dd-5a3533961f50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{\\sqrt{1+{e}^{2x}}}" :db/id #edb/ref 17592186525699} {:answer/id #uuid "d04f1fd6-e00c-5a6b-88a6-8306fd6e0fb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{e}^{x}}{\\sqrt{1+{e}^{2x}}}" :db/id #edb/ref 17592186525723}] :answer-field/correct {:answer/id #uuid "9c744cb0-6b47-5126-beaa-1ffdb2fe62d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{\\sqrt{1+{e}^{2x}}}" :db/id #edb/ref 17592186525603} :answer-field/id #uuid "26881df5-9845-5126-b23c-a867fbea3cd8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525865}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "61b524cd-3bec-51a5-bff2-353476be186c" :question/math-academy-id "q-95514" :question/problem "$$\n\nIf $y=-4\\operatorname{arcsch}⁡{e}^{x},$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡x)=-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-4\\operatorname{arcsch}⁡{e}^{x}) \\\\  & =-4\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡{e}^{x}) \\\\  & =-4\\cdot (-\\frac{1}{|{e}^{x}|\\sqrt{1+{({e}^{x})}^{2}}})\\cdot ({e}^{x})^{′} \\\\  & =4\\cdot \\frac{1}{{e}^{x}\\cdot \\sqrt{1+{e}^{2x}}}\\cdot {e}^{x} \\\\  & =\\frac{4}{\\sqrt{1+{e}^{2x}}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186526034 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b737d1d-48cd-5a7e-b7bb-f5db76229dd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{3}}{12}+3\\pi" :db/id #edb/ref 17592186525263}] :answer-field/correct {:answer/id #uuid "1b737d1d-48cd-5a7e-b7bb-f5db76229dd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{3}}{12}+3\\pi" :db/id #edb/ref 17592186525263} :answer-field/id #uuid "3fb31870-9443-5984-b41f-efc5c4e135b0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186525878}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6c56b3c3-015d-5836-a8b0-fb20b975ad9b" :question/math-academy-id "q-347204" :question/problem "![](images/c9/c91e196377aad64db49224cb5e38c1c8336171649708ec78b9cb80ebe6803128.png)\n\nFind the area $A$ of the region in the $xy$-plane that is bounded by the curve $y=-3{cos}^{2}⁡x+3{sin}^{2}⁡x+{x}^{2}+3,$ the $x$-axis and the lines $x=-\\frac{\\pi }{2}$ and $x=\\frac{\\pi }{2},$ as shown above. Do not round the answer.\n\n$A=$\n{{field-1}}" :question/worked-solution "The area of the region is given by\n\n$$\nA={\\int }_{-\\pi /2}^{\\pi /2}(-3{cos}^{2}⁡x+3{sin}^{2}⁡x+{x}^{2}+3)\\,\\text{d}x.\n$$\n\nTo calculate this integral, we use the double-angle formula for cosine:\n\n$$\n\\operatorname{cos}⁡2x={cos}^{2}⁡x-{sin}^{2}⁡x\n$$\n\nWe can rewrite the above formula as\n\n$$\n-3\\operatorname{cos}⁡2x=-3{cos}^{2}⁡x+3{sin}^{2}⁡x.\n$$\n\nHence, the area of the region is\n\n$$\n\\begin{aligned}A & ={\\int }_{-\\pi /2}^{\\pi /2}(-3{cos}^{2}⁡x+3{sin}^{2}⁡x+{x}^{2}+3)\\,\\text{d}x \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}(-3\\operatorname{cos}⁡2x+{x}^{2}+3)\\,\\text{d}x \\\\  & =(-\\frac{3}{2}\\operatorname{sin}⁡2x+\\frac{{x}^{3}}{3}+3x)\\,{|}_{-\\pi /2}^{\\pi /2} \\\\  & =[-\\frac{3}{2}\\operatorname{sin}⁡\\pi +\\frac{(\\pi /2)^{3}}{3}+3\\cdot \\frac{\\pi }{2}]-[-\\frac{3}{2}\\operatorname{sin}⁡(-\\pi )+\\frac{(-\\pi /2)^{3}}{3}+3(-\\frac{\\pi }{2})] \\\\  & =(\\frac{{\\pi }^{3}}{24}+\\frac{3\\pi }{2})-(-\\frac{{\\pi }^{3}}{24}-\\frac{3\\pi }{2}) \\\\  & =\\frac{{\\pi }^{3}}{12}+3\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186526043 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "055775d2-7fd3-50eb-9230-67b0fc5a747b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f3/f3595ce54cbe2d4aca680041411a4c50660500872316ddcc42bfffcd331c146f.png" :db/id #edb/ref 17592186525218} {:answer/id #uuid "212e684a-b560-5ddc-b66f-3ad6c40f2c21" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f0/f0f6a7ad80414e94449720bf20002ec15db2dd4a2be5ed6d7f3a7539f44a5b32.png" :db/id #edb/ref 17592186525281} {:answer/id #uuid "69bebd39-0ae6-537c-af79-f261f005cc67" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3d/3d37eb91b7b38f6b2835143f92809d736680ade4ac412c65d857e754d2acc7bd.png" :db/id #edb/ref 17592186525475} {:answer/id #uuid "8150ddc7-9640-5cdf-bd03-3906e72e93c6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/be/be3a906eb96b15dc74834349fed17c871e318e394b957bc7b3ddd21e54ae97e2.png" :db/id #edb/ref 17592186525531} {:answer/id #uuid "b9e9672f-da43-510c-a655-02c7da12b03a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/01/011808bc67eb52a3d40613db08dc34609d564224932919b77fcdee9f3de7a2e0.png" :db/id #edb/ref 17592186525685}] :answer-field/correct {:answer/id #uuid "69bebd39-0ae6-537c-af79-f261f005cc67" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3d/3d37eb91b7b38f6b2835143f92809d736680ade4ac412c65d857e754d2acc7bd.png" :db/id #edb/ref 17592186525475} :answer-field/id #uuid "70fbafa4-c6b5-5ea5-9fe0-c4f951b14d3c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525899}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "78476838-2c24-583d-9617-bd1c106f54aa" :question/math-academy-id "q-87483" :question/problem "![](images/60/601301adb254953bec91e126b2ff377864211ba047c741148e005c11682954c2.png)\n\nThe diagram above shows the function $y=f(x).$ Which of the following gives the graph of $y=\\frac{1}{4}f(\\frac{1}{3}x-1)+2?$" :question/worked-solution "To perform transformations of functions with multiple operations, we must remember the following rule:\n\n1\\. First, we perform the transformations *inside* the argument of $f.$ We first carry out horizontal stretches, followed by horizontal translations.\n\n2\\. Then, we perform the transformations *outside* the argument of $f.$ We first carry out vertical stretches, followed by vertical translations.\n\nFirst, let's factor out the coefficient next to the $x$ inside the function:\n\n$$\ny=\\frac{1}{4}f(\\frac{1}{3}x-1)+2=\\frac{1}{4}f(\\frac{1}{3}(x-3))+2\n$$\n\nTo plot $y=\\frac{1}{4}f(\\frac{1}{3}(x-3))+2,$ we apply the following steps:\n\n- Take the curve $y=f(x).$\n\n- Stretch it by a scale factor of $\\frac{1}{(\\frac{1}{3})}=3$ parallel to the $x$-axis to get the graph of $y=f(\\frac{1}{3}x).$\n\n![](images/b8/b85eed09d973abb632eb92a3a9f2abb7a2c9aa09061778d9df22eac5d59ee86e.png)\n\n- Then, translate it right by $3$ units to get the graph of $y=f(\\frac{1}{3}(x-3)).$\n\n![](images/d0/d03aa20f465906c8cbcc65a1f42b208d7f0071732d47598158fc1c81ee6222ef.png)\n\n- Then, stretch it by a scale factor of $\\frac{1}{4}$ parallel to the $y$-axis to get the graph of $y=\\frac{1}{4}f(\\frac{1}{3}(x-3)).$\n\n![](images/d2/d2ccc316205b537c9a457b81b9fb3ba88e63602bd0aaebc90f7cedfef05863cd.png)\n\n- Finally, translate it up by $2$ units to get the graph of $y=\\frac{1}{4}f(\\frac{1}{3}(x-3))+2.$\n\n![](images/b3/b3e358c3c3d2371b5c0af932857bf34065a079d223a0d1fdfcbd09cab32a8506.png)"} {:db/id #edb/ref 17592186526044 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f0ceca7-f868-55ca-ad65-7c8acc7b366a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186525364} {:answer/id #uuid "53f09751-bead-5467-a0b4-c22d394e989f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186525424} {:answer/id #uuid "a5b6598a-e055-5352-92a9-e8cc9416b314" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186525625} {:answer/id #uuid "fbb5a3f7-499e-591c-8e53-00ea9d85f8e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186525830} {:answer/id #uuid "fe99a76b-d948-50a7-8b29-d415a966079c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186525839}] :answer-field/correct {:answer/id #uuid "a5b6598a-e055-5352-92a9-e8cc9416b314" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186525625} :answer-field/id #uuid "332503ea-2f3b-5293-9831-cd53bab54fef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525872}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7941b15a-2aa3-5ad8-bfe5-4cdf148e4806" :question/math-academy-id "q-20073" :question/problem "![](images/c2/c2ba745f9f5f495ae177be1c93926fc74dffab6e69b3035cda2e7ed273f4dd05.png)\n\nWhat is the least distance between the curve $y=\\sqrt{x}+1$ and the point $(1,1)?$" :question/worked-solution "Let us consider the *squared* distance $S$ between $(1,1)$ and a general point $P(x,y)$:\n\n$$\n\\begin{aligned}S & =(x-1)^{2}+(y-1)^{2}\\end{aligned}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{x}+1.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S & =(x-1)^{2}+(y-1)^{2} \\\\  & =(x-1)^{2}+(\\sqrt{x}+1-1)^{2} \\\\  & =(x-1)^{2}+(\\sqrt{x})^{2} \\\\  & =(x-1)^{2}+x \\\\  & ={x}^{2}-2x+1+x \\\\  & ={x}^{2}-x+1.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=2x-1 & =0 \\\\ 2x & =1 \\\\ x & =\\frac{1}{2}\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(x)=2>0.$ Therefore, $x=\\frac{1}{2}$ is a minimum of $S.$\n\nSince $S$ gives the squared distance between the two points, the actual distance $d$ between the two points when $x=\\frac{1}{2}$ is given by\n\n$$\nd=\\sqrt{S(\\frac{1}{2})}.\n$$\n\nComputing this quantity, we get\n\n$$\n\\begin{aligned}d & =\\sqrt{S(\\frac{1}{2})} \\\\  & =\\sqrt{{(\\frac{1}{2})}^{2}-(\\frac{1}{2})+1} \\\\  & =\\sqrt{\\frac{3}{4}} \\\\  & =\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186526048 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8caffdc-7547-5a6e-a21b-aebd9ee316b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\pi" :db/id #edb/ref 17592186525633}] :answer-field/correct {:answer/id #uuid "a8caffdc-7547-5a6e-a21b-aebd9ee316b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\pi" :db/id #edb/ref 17592186525633} :answer-field/id #uuid "4a8bb75e-79be-5239-bdbe-829119163778" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186525882}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "85abb599-4be2-577d-9d0b-59402cc7e2bf" :question/math-academy-id "q-348918" :question/problem "![](images/28/28be65f566e93427105af6c87c46fa51f1a473363247f35a4aa481b93dc70090.png)\n\nA region in the $xy$-plane is bounded by the curve $y=6{sin}^{2}\\,(\\frac{x}{2}),$ the $x$-axis and the lines $x=\\frac{\\pi }{2}$ and $x=\\frac{5\\pi }{2}.$ The area of the region is\n\n$A=$\n{{field-1}}" :question/worked-solution "The area of the region bounded by the curve $y=6{sin}^{2}\\,(\\frac{x}{2}),$ the $x$-axis and the lines $x=\\frac{\\pi }{2}$ and $x=\\frac{5\\pi }{2}$ is \n\n$$\nA={\\int }_{\\pi /2}^{5\\pi /2}6{sin}^{2}\\,(\\frac{x}{2})\\,\\text{d}x.\n$$\n\nLet's recall the double-angle formula for cosine that involves the ${sin}^{2}$ term: \n\n$$\n\\operatorname{cos}⁡2\\theta =1-2{sin}^{2}⁡\\theta .\n$$\n\nWe can rearrange the above formula as\n\n$$\n\\frac{1}{2}(1-\\operatorname{cos}⁡2\\theta )={sin}^{2}⁡\\theta .\n$$\n\nLetting $\\theta =\\frac{x}{2},$ we have\n\n$$\n\\frac{1}{2}(1-\\operatorname{cos}⁡(x))={sin}^{2}\\,(\\frac{x}{2}).\n$$\n\nWe can now integrate as follows:\n\n$$\n\\begin{aligned}A & ={\\int }_{\\pi /2}^{5\\pi /2}6{sin}^{2}\\,(\\frac{x}{2})\\,\\text{d}x \\\\  & =6{\\int }_{\\pi /2}^{5\\pi /2}\\frac{1}{2}(1-\\operatorname{cos}⁡x)\\,\\text{d}x \\\\  & =3{\\int }_{\\pi /2}^{5\\pi /2}(1-\\operatorname{cos}⁡x)\\,\\text{d}x \\\\  & =3{(x-\\operatorname{sin}⁡x)|}_{\\pi /2}^{5\\pi /2} \\\\  & =3[(\\frac{5\\pi }{2}-\\operatorname{sin}⁡(\\frac{5\\pi }{2}))-(\\frac{\\pi }{2}-\\operatorname{sin}⁡(\\frac{\\pi }{2}))] \\\\  & =3[(\\frac{5\\pi }{2}-1)-(\\frac{\\pi }{2}-1)] \\\\  & =3(2\\pi ) \\\\  & =6\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186526052 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10ba17d2-20f2-532f-b2b8-01ad170b8ab3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f7/f7a231424813a4f7354349a9dcdb37f5f19d2d92514913450df9b49bd6fdad4d.png" :db/id #edb/ref 17592186525243} {:answer/id #uuid "606cf5af-4cac-5999-8c27-56e8457d1ffb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/27/27361a5a07750036a53052685245b07221b3b2d09e96bddb7a3259812364e710.png" :db/id #edb/ref 17592186525451} {:answer/id #uuid "c85a34f4-e759-5b15-b999-81a1c967aa5d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6b/6b0ebe20fba6691d8fc748e02dfbb2364f4314541d40be07214f1e2679e7617e.png" :db/id #edb/ref 17592186525710} {:answer/id #uuid "e3865444-5e48-5eff-b610-a04ed7daa0a6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ed/edaeb379b1807e8db385f3cdde1b92dd57b0596ca8d3bfed35b73f6d64a70bbf.png" :db/id #edb/ref 17592186525768} {:answer/id #uuid "fc35bcd5-4d13-514f-88ab-240d8dae3db7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3f/3f35b3d8c9325746a5c0832f416592a05ec705a8e5b174459d840132801f60c4.png" :db/id #edb/ref 17592186525831}] :answer-field/correct {:answer/id #uuid "e3865444-5e48-5eff-b610-a04ed7daa0a6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ed/edaeb379b1807e8db385f3cdde1b92dd57b0596ca8d3bfed35b73f6d64a70bbf.png" :db/id #edb/ref 17592186525768} :answer-field/id #uuid "4caabcd8-d675-5a22-887c-29b39f35e2d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525883}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8caa20be-200b-5ed3-94a3-d69e22805151" :question/math-academy-id "q-112621" :question/problem "![](images/b2/b2c3640581329789441015f744b3dd4fc06f5178a9044a844eefc1b8616f4ea4.png)\n\nThe diagram above shows the function $y=f(x).$ Which of the following gives the graph of $y=f(\\frac{1}{4}(x-3))?$" :question/worked-solution "To perform transformations of functions with multiple operations, we must remember the following rule:\n\n1\\. First, we perform the transformations *inside* the argument of $f.$ We first carry out horizontal stretches, followed by horizontal translations.\n\n2\\. Then, we perform the transformations *outside* the argument of $f.$ We first carry out vertical stretches, followed by vertical translations.\n\nTo plot $y=f(\\frac{1}{4}(x-3)),$ we apply the following steps:\n\n- Take the curve $y=f(x).$\n\n- Stretch it by a scale factor of $\\frac{1}{(\\frac{1}{4})}=4$ parallel to the $x$-axis to get the graph of $y=f(\\frac{1}{4}x).$\n\n![](images/8a/8a427e6cf526ce00e227e5ffeae3a21bab23fe17d1f427c8419fe3c894a761b5.png)\n\n- Then, translate it right by $3$ units to get the graph of $y=f(\\frac{1}{4}(x-3)).$\n\n![](images/cd/cdaaa955e3848d06106737098260b218752aa2a82a7aa060435ff311ced57f34.png)"} {:db/id #edb/ref 17592186526065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ad0b6a5-098c-594c-94c0-b01a3d56c227" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3.65" :db/id #edb/ref 17592186525512} {:answer/id #uuid "92cb029c-2e0e-58e9-a991-e4b7a62dc7d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3.85" :db/id #edb/ref 17592186525576} {:answer/id #uuid "d1e2a988-f449-5bd2-b1ac-257bb17dc719" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.9" :db/id #edb/ref 17592186525729} {:answer/id #uuid "ddbd0104-0775-5e7a-9449-d441ee1dd8a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.35" :db/id #edb/ref 17592186525755} {:answer/id #uuid "e653b8b9-6ffe-5e07-9219-9ad99825ec93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3.4" :db/id #edb/ref 17592186525774}] :answer-field/correct {:answer/id #uuid "7ad0b6a5-098c-594c-94c0-b01a3d56c227" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3.65" :db/id #edb/ref 17592186525512} :answer-field/id #uuid "c198272d-0f95-5188-850b-39d8ecf53871" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525941}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a72b9dd5-5d41-5e15-9611-0fb245235173" :question/math-academy-id "q-159959" :question/problem "Suppose ${X}_{1},{X}_{2},{X}_{3}$ is an I.I.D random sample with ${X}_{i}∼N(\\theta ,{1}^{2}),$ where $\\theta $ is an unknown mean. The log-likelihood function of the sample $2.5,\\,0.2,\\,-1.1$ is\n\n$$\nl(\\theta )=-1.5\\operatorname{ln}⁡(2\\pi )+a+b\\theta +c{\\theta }^{2}\n$$\n\nWhat is the value of $a+b+c?$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i};\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i};\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=3$ independent normal random variables with unknown mean $\\theta $ and variance ${\\sigma }^{2}=1,$ for which the probability density function is\n\n$$\nf(x,\\theta )=\\frac{1}{\\sigma \\sqrt{2\\pi }}{e}^{-\\frac{1}{2}{(\\frac{x-\\theta }{\\sigma })}^{2}}=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$\n\nNext, we write down the log-density function:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡f(x,\\theta ) & =\\operatorname{ln}⁡(\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2}) \\\\  & =\\operatorname{ln}⁡(\\frac{1}{\\sqrt{2\\pi }})+\\operatorname{ln}⁡({e}^{-(x-\\theta )^{2}/2}) \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{(x-\\theta )^{2}}{2}.\\end{aligned}\n$$\n\nNow, we can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}(-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{({x}_{i}-\\theta )^{2}}{2}) \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-{\\sum }_{i=1}^{n}\\frac{({x}_{i}-\\theta )^{2}}{2} \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}({\\sum }_{i=1}^{n}{x}_{i}^{2}-2\\theta {\\sum }_{i=1}^{n}{x}_{i}+n{\\theta }^{2})\\end{aligned}\n$$\n\nFor our sample, we have that\n\n$$\n\\begin{aligned}S & ={\\sum }_{i=1}^{n}{x}_{i} \\\\  & =2.5+0.2+(-1.1) \\\\  & =1.6 \\\\ C & ={\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =(2.5)^{2}+(0.2)^{2}+(-1.1)^{2} \\\\  & =7.5\\end{aligned}\n$$\n\nand $n=3.$ Therefore,  \n\n$$\n\\begin{aligned}l(\\theta ) & =-\\frac{3}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}(7.5-2\\theta \\cdot (1.6)+3{\\theta }^{2}) \\\\  & =-1.5\\operatorname{ln}⁡(2\\pi )+(-3.75)+(1.6)\\theta +(-1.5){\\theta }^{2}.\\end{aligned}\n$$\n\nFinally, \n\n$$\na+b+c=-3.75+(1.6)+(-1.5)=-3.65.\n$$"} {:db/id #edb/ref 17592186526068 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c37ca8aa-0613-5e1f-9137-f76eabfd3b55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{1-(3x-2)^2}}" :db/id #edb/ref 17592186525702}] :answer-field/correct {:answer/id #uuid "c37ca8aa-0613-5e1f-9137-f76eabfd3b55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{1-(3x-2)^2}}" :db/id #edb/ref 17592186525702} :answer-field/id #uuid "640512e5-7436-50c7-aa28-fc64598aa17a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186525893}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ada52c09-5dae-5593-aecd-e855669a9070" :question/math-academy-id "q-313244" :question/problem "$$\n\nIf $y=\\operatorname{ln}⁡(3x-2)-\\operatorname{arsech}⁡(3x-2),$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=\\frac{3}{3x-2}(1\\,+$\n{{field-1}}$)$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic secant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡x)=-\\frac{1}{x\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(3x-2)-\\operatorname{arsech}⁡(3x-2)) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(3x-2))\\,-\\,\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡(3x-2)) \\\\  & =\\frac{3}{3x-2}-(-\\frac{1}{(3x-2)\\sqrt{1-(3x-2)^{2}}})\\cdot (3x-2)^{′} \\\\  & =\\frac{3}{3x-2}\\,+\\,\\frac{1}{(3x-2)\\sqrt{1-(3x-2)^{2}}}\\cdot 3 \\\\  & =\\frac{3}{3x-2}(1+\\frac{1}{\\sqrt{\\,1-(3x-2)^{2}\\,}}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186526076 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f03e200-f459-5f54-91af-c0316f151882" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40.93" :db/id #edb/ref 17592186525237} {:answer/id #uuid "2cbc8dc4-a28d-5d75-b595-1ff52453fe44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-41.43" :db/id #edb/ref 17592186525311} {:answer/id #uuid "8f499e9c-2722-5b53-a436-8a79c8e22bd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-45.44" :db/id #edb/ref 17592186525567} {:answer/id #uuid "9e6790c7-0760-5f1f-9923-f4cc21141e24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "47.14" :db/id #edb/ref 17592186525608} {:answer/id #uuid "bdff6e45-6d14-52f6-9ef8-48fc08a6c75e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-48.93" :db/id #edb/ref 17592186525694}] :answer-field/correct {:answer/id #uuid "2cbc8dc4-a28d-5d75-b595-1ff52453fe44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-41.43" :db/id #edb/ref 17592186525311} :answer-field/id #uuid "abf413ab-f439-5034-a9fc-a671901ce187" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525932}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bf364950-64c1-5b8d-a6e8-f3296448f536" :question/math-academy-id "q-159946" :question/problem "Suppose ${X}_{1},{X}_{2},…,{X}_{12}$ is an I.I.D random sample with ${X}_{i}∼N(\\theta ,{1}^{2}),$ where $\\theta $ is an unknown mean. For a particular sample ${x}_{1},{x}_{2},…,{x}_{12},$ you're given that \n\n$$\n{\\sum }_{i=1}^{12}{x}_{i}=40,\\,{\\sum }_{i=1}^{12}{x}_{i}^{2}=150.86.\n$$\n\nGiven that the log-likelihood function of the sample is\n\n$$\nl(\\theta )=-6\\operatorname{ln}⁡(2\\pi )+a+b\\theta +c{\\theta }^{2},\n$$\n\nwhat is the value of $a+b+c?$\n\n*Hint: The probability density function for a normal random variable with mean $\\theta $ and standard deviation $1$ is given by* \n\n$$\nf(x)=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i};\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i};\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=12$ independent normal random variables with unknown mean $\\theta $ and variance ${\\sigma }^{2}=1,$ for which the probability density function is\n\n$$\nf(x,\\theta )=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$\n\nNext, we write down the log-density function:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡f(x,\\theta ) & =\\operatorname{ln}⁡(\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2}) \\\\  & =\\operatorname{ln}⁡(\\frac{1}{\\sqrt{2\\pi }})+\\operatorname{ln}⁡({e}^{-(x-\\theta )^{2}/2}) \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{(x-\\theta )^{2}}{2}.\\end{aligned}\n$$\n\nNow, we can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}(-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{({x}_{i}-\\theta )^{2}}{2}) \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-{\\sum }_{i=1}^{n}\\frac{({x}_{i}-\\theta )^{2}}{2} \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}({\\sum }_{i=1}^{n}{x}_{i}^{2}-2\\theta {\\sum }_{i=1}^{n}{x}_{i}+n{\\theta }^{2})\\end{aligned}\n$$\n\nWe are told that ${\\sum }_{i=1}^{12}{x}_{i}=40,$ ${\\sum }_{i=1}^{12}{x}_{i}^{2}=150.86,$ and $n=12.$ Therefore, \n\n$$\n\\begin{aligned}l(\\theta ) & =-\\frac{12}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}(150.86-2\\theta \\cdot 40+12{\\theta }^{2}) \\\\  & =-6\\operatorname{ln}⁡(2\\pi )+(-75.43)+40\\theta +(-6){\\theta }^{2}.\\end{aligned}\n$$\n\nFinally, \n\n$$\na+b+c=(-75.43)+40+(-6)=-41.43.\n$$"} {:db/id #edb/ref 17592186526084 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c4aac3a-edbd-57ca-940b-81a54ff89341" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186525443}] :answer-field/correct {:answer/id #uuid "5c4aac3a-edbd-57ca-940b-81a54ff89341" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186525443} :answer-field/id #uuid "a3103677-824b-5b24-a53b-8724b60d9376" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186525928}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d653dfc3-332e-578a-824c-24d06ec11b4f" :question/math-academy-id "q-341944" :question/problem "Find the slope $m$ of the tangent line to the curve $y={(\\frac{2}{x})}^{{x}^{2}}$ at $x=2.$\n\n$m=$\n{{field-1}}" :question/worked-solution "The slope of the tangent to the curve at $x=2$ equals the function's derivative at the corresponding point.\n\nWe have the function \n\n$$\ny={(\\frac{2}{x})}^{{x}^{2}}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡({(\\frac{2}{x})}^{{x}^{2}}) \\\\ \\operatorname{ln}⁡y & ={x}^{2}\\,\\operatorname{ln}⁡(\\frac{2}{x})\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}\\,\\operatorname{ln}⁡(\\frac{2}{x})) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =({x}^{2})^{′}\\cdot (\\operatorname{ln}⁡(\\frac{2}{x}))+({x}^{2})\\cdot {(\\operatorname{ln}⁡(\\frac{2}{x}))}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =2x\\cdot \\operatorname{ln}⁡(\\frac{2}{x})+{x}^{2}\\cdot (-\\frac{1}{x}) \\\\ \\frac{{y}^{′}}{y} & =2x\\operatorname{ln}⁡(\\frac{2}{x})-x \\\\ \\frac{{y}^{′}}{y} & =x(2\\operatorname{ln}⁡(\\frac{2}{x})-1)\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =xy(2\\operatorname{ln}⁡(\\frac{2}{x})-1)\\end{aligned}\n$$\n\nFinally, we substitute $y={(\\frac{2}{x})}^{{x}^{2}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =x{(\\frac{2}{x})}^{{x}^{2}}(2\\operatorname{ln}⁡(\\frac{2}{x})-1)\\end{aligned}\n$$\n\nTherefore, the slope of $y={(\\frac{2}{x})}^{{x}^{2}}$ at $x=2$ is\n\n$$\n\\begin{aligned}m={y}^{′}{|}_{x=2} & =(2){(\\frac{2}{2})}^{(2)^{2}}(2\\operatorname{ln}⁡(\\frac{2}{2})-1) \\\\  & =2(2\\operatorname{ln}⁡(1)-1) \\\\  & =-2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186526094 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cbcbe41-0ec2-507f-b713-b0a22ebf25be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-46.8" :db/id #edb/ref 17592186525232} {:answer/id #uuid "18d01814-974d-57f1-bae6-fc57d9703528" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "44.1" :db/id #edb/ref 17592186525256} {:answer/id #uuid "4b6cbd50-cadd-58bc-b6d8-24ab0ca5678b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-45.5" :db/id #edb/ref 17592186525394} {:answer/id #uuid "8b889d32-017a-5881-9bfb-7de05958c82e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-42.0" :db/id #edb/ref 17592186525553} {:answer/id #uuid "fd2e10fc-7183-59ec-a31c-a3543cf568bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "43.4" :db/id #edb/ref 17592186525834}] :answer-field/correct {:answer/id #uuid "4b6cbd50-cadd-58bc-b6d8-24ab0ca5678b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-45.5" :db/id #edb/ref 17592186525394} :answer-field/id #uuid "939abb92-670e-59cb-a71d-b99cbb16a598" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525920}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ed6e56e9-08e5-56f5-aaed-8bc6f1c64b9a" :question/math-academy-id "q-159957" :question/problem "Suppose ${X}_{1},{X}_{2},…,{X}_{10}$ is an I.I.D random sample with ${X}_{i}∼N(\\theta ,{1}^{2}),$ where $\\theta $ is an unknown mean. For a particular sample ${x}_{1},{x}_{2},…,{x}_{10},$ you're given that \n\n$$\n{\\sum }_{i=1}^{10}{x}_{i}=39.4,\\,{\\sum }_{i=1}^{10}{x}_{i}^{2}=159.8.\n$$\n\n \nGiven that the log-likelihood function of the sample is\n\n$$\nl(\\theta )=-5\\operatorname{ln}⁡(2\\pi )+a+b\\theta +c{\\theta }^{2},\n$$\n\nwhat is the value of $a+b+c?$\n\n*Hint: The probability density function for a normal random variable with mean $\\theta $ and standard deviation $1$ is given by* \n\n$$\nf(x)=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i};\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i};\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=10$ independent normal random variables with unknown mean $\\theta $ and variance ${\\sigma }^{2}=1,$ for which the probability density function is\n\n$$\nf(x,\\theta )=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$\n\nNext, we write down the log-density function:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡f(x,\\theta ) & =\\operatorname{ln}⁡(\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2}) \\\\  & =\\operatorname{ln}⁡(\\frac{1}{\\sqrt{2\\pi }})+\\operatorname{ln}⁡({e}^{-(x-\\theta )^{2}/2}) \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{(x-\\theta )^{2}}{2}.\\end{aligned}\n$$\n\nNow, we can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}(-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{({x}_{i}-\\theta )^{2}}{2}) \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-{\\sum }_{i=1}^{n}\\frac{({x}_{i}-\\theta )^{2}}{2} \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}({\\sum }_{i=1}^{n}{x}_{i}^{2}-2\\theta {\\sum }_{i=1}^{n}{x}_{i}+n{\\theta }^{2})\\end{aligned}\n$$\n\nWe are told that ${\\sum }_{i=1}^{10}{x}_{i}=39.4,$ ${\\sum }_{i=1}^{10}{x}_{i}^{2}=159.8,$ and $n=10.$ Therefore, \n\n$$\n\\begin{aligned}l(\\theta ) & =-\\frac{10}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}(159.8-2\\theta \\cdot 39.4+10{\\theta }^{2}) \\\\  & =-5\\operatorname{ln}⁡(2\\pi )+(-79.9)+39.4\\theta +(-5){\\theta }^{2}.\\end{aligned}\n$$\n\nFinally, \n\n$$\na+b+c=(-79.9)+39.4+(-5)=-45.5.\n$$"} {:db/id #edb/ref 17592186526098 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b8cbbfa-0513-54a9-9d49-2cc903fb24c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7.5" :db/id #edb/ref 17592186525351} {:answer/id #uuid "5b817416-7bee-53d6-880c-88f15c1f4a7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7.3" :db/id #edb/ref 17592186525439} {:answer/id #uuid "719d881d-0eec-5fa6-8eba-9657fa379b5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7.7" :db/id #edb/ref 17592186525493} {:answer/id #uuid "b79c3683-0e2b-564a-a127-6988653a841f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7.1" :db/id #edb/ref 17592186525677} {:answer/id #uuid "cde26b50-374c-52a6-a8bb-fd5d777ad336" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7.9" :db/id #edb/ref 17592186525717}] :answer-field/correct {:answer/id #uuid "719d881d-0eec-5fa6-8eba-9657fa379b5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7.7" :db/id #edb/ref 17592186525493} :answer-field/id #uuid "4fa74bc1-cbda-547d-ad3a-17b839fe05e3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525886}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f4dba462-88c8-55e1-ad6f-09af7f02eff1" :question/math-academy-id "q-159962" :question/problem "Suppose ${X}_{1},{X}_{2},{X}_{3},{X}_{4},{X}_{5}$ is an I.I.D random sample with ${X}_{i}∼N(\\theta ,{1}^{2}),$ where $\\theta $ is an unknown mean. The log-likelihood function of the sample $-1.1,\\,0.7,\\,-0.5,\\,-0.7,\\,-1.4$ is\n\n$$\nl(\\theta )=-2.5\\operatorname{ln}⁡(2\\pi )+a+b\\theta +c{\\theta }^{2}\n$$\n\nWhat is the value of $a+b+c?$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i};\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i};\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=5$ independent normal random variables with unknown mean $\\theta $ and variance ${\\sigma }^{2}=1,$ for which the probability density function is\n\n$$\nf(x,\\theta )=\\frac{1}{\\sigma \\sqrt{2\\pi }}{e}^{-\\frac{1}{2}{(\\frac{x-\\theta }{\\sigma })}^{2}}=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$\n\nNext, we write down the log-density function:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡f(x,\\theta ) & =\\operatorname{ln}⁡(\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2}) \\\\  & =\\operatorname{ln}⁡(\\frac{1}{\\sqrt{2\\pi }})+\\operatorname{ln}⁡({e}^{-(x-\\theta )^{2}/2}) \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{(x-\\theta )^{2}}{2}.\\end{aligned}\n$$\n\nNow, we can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}(-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{({x}_{i}-\\theta )^{2}}{2}) \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-{\\sum }_{i=1}^{n}\\frac{({x}_{i}-\\theta )^{2}}{2} \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}({\\sum }_{i=1}^{n}{x}_{i}^{2}-2\\theta {\\sum }_{i=1}^{n}{x}_{i}+n{\\theta }^{2})\\end{aligned}\n$$\n\nFor our sample, we have that\n\n$$\n\\begin{aligned}S & ={\\sum }_{i=1}^{n}{x}_{i} \\\\  & =(-1.1)+0.7+(-0.5)+(-0.7)+(-1.4) \\\\  & =-3 \\\\ C & ={\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =(-1.1)^{2}+(0.7)^{2}+(-0.5)^{2}+(-0.7)^{2}+(-1.4)^{2} \\\\  & =4.4\\end{aligned}\n$$\n\nand $n=5.$ Therefore,  \n\n$$\n\\begin{aligned}l(\\theta ) & =-\\frac{5}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}(4.4-2\\theta \\cdot (-3)+5{\\theta }^{2}) \\\\  & =-2.5\\operatorname{ln}⁡(2\\pi )+(-2.2)+(-3)\\theta +(-2.5){\\theta }^{2}.\\end{aligned}\n$$\n\nFinally, \n\n$$\na+b+c=-2.2+(-3)+(-2.5)=-7.7.\n$$"} {:db/id #edb/ref 17592186526161 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0700e7b2-6f89-569b-80c9-76966b0a03ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{3 r^{2} \\sin^{2}{\\left(\\theta \\right)}}{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 3 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}} - \\frac{8 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}}{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 3 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}}" :db/id #edb/ref 17592186526158} {:answer/id #uuid "256ad1f0-227d-5ab3-8708-6eb324b90aaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{- 3 \\sin^{2}{\\left(\\theta \\right)} - 6 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 3 \\cos^{2}{\\left(\\theta \\right)}}{\\sin^{2}{\\left(\\theta \\right)} + 3 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 \\cos^{2}{\\left(\\theta \\right)}}" :db/id #edb/ref 17592186526169} {:answer/id #uuid "4bd87932-9556-54c2-bf44-b10dfc62190f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{- 3 \\sin^{2}{\\left(\\theta \\right)} - 6 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 3 \\cos^{2}{\\left(\\theta \\right)}}{\\sin^{2}{\\left(\\theta \\right)} + 3 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 \\cos^{2}{\\left(\\theta \\right)}}" :db/id #edb/ref 17592186526177} {:answer/id #uuid "570475a5-8df7-5112-9b0d-b5f4696e1d3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}}{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 3 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}} + \\frac{3 r^{2} \\cos^{2}{\\left(\\theta \\right)}}{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 3 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}}" :db/id #edb/ref 17592186526178} {:answer/id #uuid "7c39e04f-c6b9-5a8b-8c78-12f97819a641" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{- 3 \\sin^{2}{\\left(\\theta \\right)} - 6 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 3 \\cos^{2}{\\left(\\theta \\right)}}{r \\left(\\sin^{2}{\\left(\\theta \\right)} + 3 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 \\cos^{2}{\\left(\\theta \\right)}\\right)}" :db/id #edb/ref 17592186526188}] :answer-field/correct {:answer/id #uuid "256ad1f0-227d-5ab3-8708-6eb324b90aaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{- 3 \\sin^{2}{\\left(\\theta \\right)} - 6 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 3 \\cos^{2}{\\left(\\theta \\right)}}{\\sin^{2}{\\left(\\theta \\right)} + 3 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 \\cos^{2}{\\left(\\theta \\right)}}" :db/id #edb/ref 17592186526169} :answer-field/id #uuid "176d5247-bf57-548e-a7ea-4712f6f68f4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186526163}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "16f3dbcc-22a8-51d5-90f3-bbe17bd367b9" :question/problem "Given that $g(x,y)=\\ln{\\left(4 x^{2} + 3 x y + y^{2} \\right)},$ find $\\frac{∂g}{∂\\theta},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta)$ are the corresponding plane polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $g(x,y)$ with two independent variables $r$ and $\\theta,$ where $x=r\\cos\\theta$ and $y=r\\sin\\theta,$ we have\n\n$$\n\\begin{aligned}\\frac{∂g}{∂\\theta} & =\\frac{∂g}{∂x}\\cdot \\frac{∂x}{∂\\theta}+\\frac{∂g}{∂y}\\cdot \\frac{∂y}{∂\\theta} \\\\  & =(\\frac{∂g}{∂x})(- r \\sin{\\left(\\theta \\right)})+(\\frac{∂g}{∂y})(r \\cos{\\left(\\theta \\right)})\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $g$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x}=\\frac{8 x + 3 y}{4 x^{2} + 3 x y + y^{2}},\\,\\frac{∂g}{∂y}=\\frac{3 x + 2 y}{4 x^{2} + 3 x y + y^{2}}\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta,$ we get\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{3 r \\sin{\\left(\\theta \\right)} + 8 r \\cos{\\left(\\theta \\right)}}{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 3 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}}, \\\\ \\frac{∂g}{∂y} & =\\frac{2 r \\sin{\\left(\\theta \\right)} + 3 r \\cos{\\left(\\theta \\right)}}{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 3 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}}.\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂g}{∂\\theta} & =(\\frac{3 r \\sin{\\left(\\theta \\right)} + 8 r \\cos{\\left(\\theta \\right)}}{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 3 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}})(- r \\sin{\\left(\\theta \\right)})+(\\frac{2 r \\sin{\\left(\\theta \\right)} + 3 r \\cos{\\left(\\theta \\right)}}{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 3 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}})(r \\cos{\\left(\\theta \\right)}) \\\\  & =(- \\frac{3 r^{2} \\sin^{2}{\\left(\\theta \\right)}}{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 3 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}} - \\frac{8 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}}{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 3 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}})+(\\frac{2 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}}{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 3 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}} + \\frac{3 r^{2} \\cos^{2}{\\left(\\theta \\right)}}{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 3 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}}) \\\\  & =\\frac{- 3 \\sin^{2}{\\left(\\theta \\right)} - 6 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 3 \\cos^{2}{\\left(\\theta \\right)}}{\\sin^{2}{\\left(\\theta \\right)} + 3 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 \\cos^{2}{\\left(\\theta \\right)}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186526166 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17302592-36a5-57f1-a971-a7a300109c99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- r^{3} \\sin^{3}{\\left(\\theta \\right)} - 4 r^{3} \\sin^{2}{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 2 r^{3} \\sin{\\left(\\theta \\right)} \\cos^{2}{\\left(\\theta \\right)} + 2 r^{3} \\cos^{3}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526162} {:answer/id #uuid "60b9d017-5f42-5d24-9e66-9619fcf8db6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r^{3} \\sin^{3}{\\left(\\theta \\right)} + 4 r^{3} \\sin^{2}{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r^{3} \\sin{\\left(\\theta \\right)} \\cos^{2}{\\left(\\theta \\right)} - 2 r^{3} \\cos^{3}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526180} {:answer/id #uuid "60fdd167-0846-56cf-b69c-e98695bcdd09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{r^{3} \\sin^{3}{\\left(\\theta \\right)} + 4 r^{3} \\sin^{2}{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r^{3} \\sin{\\left(\\theta \\right)} \\cos^{2}{\\left(\\theta \\right)} - 2 r^{3} \\cos^{3}{\\left(\\theta \\right)}}{r}" :db/id #edb/ref 17592186526181} {:answer/id #uuid "6b4cd983-7e49-585a-9573-13bb478061d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r^{3} \\sin^{3}{\\left(\\theta \\right)} + 4 r^{3} \\sin^{2}{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526182} {:answer/id #uuid "a0103f84-e7be-50b2-aa2c-67c7e38b703f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 2 r^{3} \\sin{\\left(\\theta \\right)} \\cos^{2}{\\left(\\theta \\right)} - 2 r^{3} \\cos^{3}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526200}] :answer-field/correct {:answer/id #uuid "60b9d017-5f42-5d24-9e66-9619fcf8db6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r^{3} \\sin^{3}{\\left(\\theta \\right)} + 4 r^{3} \\sin^{2}{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r^{3} \\sin{\\left(\\theta \\right)} \\cos^{2}{\\left(\\theta \\right)} - 2 r^{3} \\cos^{3}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526180} :answer-field/id #uuid "89b86388-a8f9-541f-8e1f-d5aece2596e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186526193}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1f34d303-adce-5e96-8e3e-a46bddba0d7c" :question/problem "Given that $w(x,y)=- 2 x^{2} y - x y^{2},$ find $\\frac{∂w}{∂\\theta},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta)$ are the corresponding plane polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $w(x,y)$ with two independent variables $r$ and $\\theta,$ where $x=r\\cos\\theta$ and $y=r\\sin\\theta,$ we have\n\n$$\n\\begin{aligned}\\frac{∂w}{∂\\theta} & =\\frac{∂w}{∂x}\\cdot \\frac{∂x}{∂\\theta}+\\frac{∂w}{∂y}\\cdot \\frac{∂y}{∂\\theta} \\\\  & =(\\frac{∂w}{∂x})(- r \\sin{\\left(\\theta \\right)})+(\\frac{∂w}{∂y})(r \\cos{\\left(\\theta \\right)})\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $w$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂w}{∂x}=- 4 x y - y^{2},\\,\\frac{∂w}{∂y}=- 2 x^{2} - 2 x y\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta,$ we get\n\n$$\n\\begin{aligned}\\frac{∂w}{∂x} & =- r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}, \\\\ \\frac{∂w}{∂y} & =- 2 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r^{2} \\cos^{2}{\\left(\\theta \\right)}.\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂w}{∂\\theta} & =(- r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)})(- r \\sin{\\left(\\theta \\right)})+(- 2 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r^{2} \\cos^{2}{\\left(\\theta \\right)})(r \\cos{\\left(\\theta \\right)}) \\\\  & =(r^{3} \\sin^{3}{\\left(\\theta \\right)} + 4 r^{3} \\sin^{2}{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)})+(- 2 r^{3} \\sin{\\left(\\theta \\right)} \\cos^{2}{\\left(\\theta \\right)} - 2 r^{3} \\cos^{3}{\\left(\\theta \\right)}) \\\\  & =r^{3} \\sin^{3}{\\left(\\theta \\right)} + 4 r^{3} \\sin^{2}{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r^{3} \\sin{\\left(\\theta \\right)} \\cos^{2}{\\left(\\theta \\right)} - 2 r^{3} \\cos^{3}{\\left(\\theta \\right)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186526174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0146a63c-62c6-560b-8bf6-e87a875aba94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 4 r \\sin^{2}{\\left(\\theta \\right)} + 2 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 2 r \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526156} {:answer/id #uuid "74e7bddb-101d-5b9e-87f1-113de332564d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4 r \\sin^{2}{\\left(\\theta \\right)} - 2 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r \\cos^{2}{\\left(\\theta \\right)}}{r}" :db/id #edb/ref 17592186526185} {:answer/id #uuid "7b6a11b6-329f-51a9-a974-6ec14d3a4bf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 r \\sin^{2}{\\left(\\theta \\right)} - 2 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526187} {:answer/id #uuid "b9a65f47-d085-5450-a793-ff1778432351" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 r \\sin^{2}{\\left(\\theta \\right)} - r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526210} {:answer/id #uuid "e639b67f-fbb5-5ca1-ac05-e9a89950e83c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526220}] :answer-field/correct {:answer/id #uuid "7b6a11b6-329f-51a9-a974-6ec14d3a4bf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 r \\sin^{2}{\\left(\\theta \\right)} - 2 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526187} :answer-field/id #uuid "24ce3f6b-1cff-5e54-951c-3d66da20a412" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186526167}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3a1713ce-41c1-5e43-88ce-84d20bba3e8d" :question/problem "Given that $g(x,y)=- x^{2} - x y + 2 y^{2},$ find $\\frac{∂g}{∂r},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta)$ are the corresponding plane polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $g(x,y)$ with two independent variables $r$ and $\\theta,$ where $x=r\\cos\\theta$ and $y=r\\sin\\theta,$ we have\n\n$$\n\\begin{aligned}\\frac{∂g}{∂r} & =\\frac{∂g}{∂x}\\cdot \\frac{∂x}{∂r}+\\frac{∂g}{∂y}\\cdot \\frac{∂y}{∂r} \\\\  & =(\\frac{∂g}{∂x})(\\cos{\\left(\\theta \\right)})+(\\frac{∂g}{∂y})(\\sin{\\left(\\theta \\right)})\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $g$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x}=- 2 x - y,\\,\\frac{∂g}{∂y}=- x + 4 y\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta,$ we get\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =- r \\sin{\\left(\\theta \\right)} - 2 r \\cos{\\left(\\theta \\right)}, \\\\ \\frac{∂g}{∂y} & =4 r \\sin{\\left(\\theta \\right)} - r \\cos{\\left(\\theta \\right)}.\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂g}{∂r} & =(- r \\sin{\\left(\\theta \\right)} - 2 r \\cos{\\left(\\theta \\right)})(\\cos{\\left(\\theta \\right)})+(4 r \\sin{\\left(\\theta \\right)} - r \\cos{\\left(\\theta \\right)})(\\sin{\\left(\\theta \\right)}) \\\\  & =(- r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r \\cos^{2}{\\left(\\theta \\right)})+(4 r \\sin^{2}{\\left(\\theta \\right)} - r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}) \\\\  & =4 r \\sin^{2}{\\left(\\theta \\right)} - 2 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r \\cos^{2}{\\left(\\theta \\right)}\\end{aligned}\n$$"}]
