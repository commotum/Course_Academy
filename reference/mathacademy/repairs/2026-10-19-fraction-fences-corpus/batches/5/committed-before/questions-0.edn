field-1}}." :question/worked-solution "To work out ${(-\\frac{9}{7})}^{2},$ we multiply $-\\frac{9}{7}$ by itself:\n\n$$\n\\begin{aligned}{(-\\frac{9}{7})}^{2} &= (-\\frac{9}{7})\\cdot (-\\frac{9}{7}) \\\\ &= \\frac{9\\cdot 9}{7\\cdot 7} \\\\ &= \\frac{81}{49}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186443079 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ea65150-bd2b-5bdf-a7ab-a51b52c79e58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186443005}] :answer-field/correct {:answer/id #uuid "3ea65150-bd2b-5bdf-a7ab-a51b52c79e58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186443005} :answer-field/id #uuid "a80481f5-39ce-5ee2-b253-1792bec0a57d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186443068}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5df64b77-ebca-5b73-8314-1b0b4f096670" :question/math-academy-id "q-185190" :question/problem "Expressed as an improper fraction or mixed number, ${(\\frac{3}{2})}^{2}=${{field-1}}." :question/worked-solution "To work out ${(\\frac{3}{2})}^{2},$ we multiply $\\frac{3}{2}$ by itself:\n\n$$\n{(\\frac{3}{2})}^{2}=\\frac{3}{2}\\cdot \\frac{3}{2}=\\frac{9}{4}\n$$"} {:db/id #edb/ref 17592186443081 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a5f45b0-7cff-5b5e-ac32-823e982d8ce7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{16}" :db/id #edb/ref 17592186443020}] :answer-field/correct {:answer/id #uuid "7a5f45b0-7cff-5b5e-ac32-823e982d8ce7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{16}" :db/id #edb/ref 17592186443020} :answer-field/id #uuid "08d5d653-07e3-59f1-8358-9ff8a31