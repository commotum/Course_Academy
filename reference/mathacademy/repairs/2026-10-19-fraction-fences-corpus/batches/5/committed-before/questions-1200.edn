5})\\,\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186530730 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0971b17f-ad93-5580-ba93-06499fcf447c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{- x^{4} y - 2 x^{3} y^{2} - x^{3} - 5 x^{2} y^{3} - x^{2} y - 4 x y^{4} - 2 x y^{2} - 4 y^{5}}{\\sqrt{(- 2 x - y)^{2} + (- x - 4 y)^{2} + 1}}" :db/id #edb/ref 17592186530662} {:answer/id #uuid "38ad9d64-f81a-517e-bcc1-525559a3b57c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- x^{4} y - 2 x^{3} y^{2} - x^{3} - 5 x^{2} y^{3} - x^{2} y - 4 x y^{4} - 2 x y^{2} - 4 y^{5}" :db/id #edb/ref 17592186530673} {:answer/id #uuid "5577374c-9175-5d96-b828-750b11a1ab5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "((- 2 x - y)^{2} + (- x - 4 y)^{2} + 1) (- x^{4} y - 2 x^{3} y^{2} - x^{3} - 5 x^{2} y^{3} - x^{2} y - 4 x y^{4} - 2 x y^{2} - 4 y^{5})" :db/id #edb/ref 17592186530681} {:answer/id #uuid "6003ca0b-ab58-5fff-98ff-ea1e81db9a3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{(- 2 x - y)^{2} + (- x - 4 y)^{2} + 1} (- x^{4} y - 2 x^{3} y^{2} - x^{3} - 5 x^{2} y^{3} - x^{2} y - 4 x y^{4} - 2 x y^{2} - 4 y^{5})" :db/id #edb/ref 17592186530683} {:answer/id #uuid "830a976c-b3ce-5e8d-8736-350e19f0c350" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{(- 2 x - y)^{2} + (- x - 4 y)^{2}} (- x^{4} y - 2 x^{3} y^{2} - x^{3} - 5 x^{2} y^{3} - x^{2} y - 4 x y^{4} - 2 x y^{2} - 4 y^{5})" :db/id #edb/ref 17592186530696}] :answer-field/correct {:answer/id #uuid "6003ca0b-ab58-5fff-98ff-ea1e81db9a3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{(- 2 x - y)^{2} + (- x - 4 y)^{2} + 1} (- x^{4} y - 2 x^{3} y^{2} - x^{3} - 5 x^{2} y^{3} - x^{2} y - 4 x y^{4} - 2 x y^{2} - 4 y^{5})" :db/id #edb/ref 17592186530683} :answer-field/id #uuid "ac334596-122b-50f2-8faa-8cb8533f02fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186530709}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ecb5a482-f12b-5c94-b1f5-89166467160b" :question/problem "Consider the surface integral of the function $f(x,y,z)=x z - y z^{2},$ where the surface $S$ is defined by $z=- x^{2} - x y - 2 y^{2}$ for $0\\le x\\le 1$ and $0\\le y\\le 1.$\nThis surface integral can be written as a repeated integral, as shown below. \n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={\\int }_{0}^{1}{\\int }_{0}^{1}\\,\\boxed{}\\,\\,\\text{d}y\\,\\text{d}x\n$$\n\nWhat is the missing expression?" :question/worked-solution "For a surface $S$ defined by $z=g(x,y)$ with $(x,y)\\in D,$ the surface integral of a scalar function $f(x,y,z)$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A.\n$$\n\nFor the partial derivatives, we have\n\n$$\n\\frac{∂z}{∂x}=\\frac{∂}{∂x}(- x^{2} - x y - 2 y^{2})=- 2 x - y,\n$$\n\nand\n\n$$\n\\frac{∂z}{∂y}=\\frac{∂}{∂y}(- x^{2} - x y - 2 y^{2})=- x - 4 y.\n$$\n\nTherefore, the surface integral can be written as \n\n$$\n\\begin{aligned}{∬}_{S}f(x,y,z)\\,\\text{d}S & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+(- 2 x - y)^2+(- x - 4 y)^2}\\,\\text{d}A \\\\  & ={∬}_{D}\\,(x (- x^{2} - x y - 2 y^{2}) - y (- x^{2} - x y - 2 y^{2})^{2})\\cdot (\\sqrt{(- 2 x - y)^{2} + (- x - 4 y)^{2} + 1})\\,\\text{d}A \\\\  & ={∬}_{D}\\,(- x^{4} y - 2 x^{3} y^{2} - x^{3} - 5 x^{2} y^{3} - x^{2} y - 4 x y^{4} - 2 x y^{2} - 4 y^{5})\\cdot (\\sqrt{(- 2 x - y)^{2} + (- x - 4 y)^{2} + 1})\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}\\,\\sqrt{(- 2 x - y)^{2} + (- x - 4 y)^{2} + 1} (- x^{4} y - 2 x^{3} y^{2} - x^{3} - 5 x^{2} y^{3} - x^{2} y - 4 x y^{4} - 2 x y^{2} - 4 y^{5})\\,\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186530731 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5139932b-8773-5680-9333-a8f817ea0415" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{(- 2 x - y)^{2} + (- x + 4 y)^{2} + 1} (- x^{4} y - 2 x^{3} y^{2} - x^{3} + 3 x^{2} y^{3} - x^{2} y + 4 x y^{4} + 2 x y^{2} - 4 y^{5})" :db/id #edb/ref 17592186530680} {:answer/id #uuid "7051c9ca-c216-50f7-9a04-70f21573e85a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{- x^{4} y - 2 x^{3} y^{2} - x^{3} + 3 x^{2} y^{3} - x^{2} y + 4 x y^{4} + 2 x y^{2} - 4 y^{5}}{\\sqrt{(- 2 x - y)^{2} + (- x + 4 y)^{2} + 1}}" :db/id #edb/ref 17592186530689} {:answer/id #uuid "8a47fcda-a2c3-538c-9034-7edc39cb003d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{(- 2 x - y)^{2} + (- x + 4 y)^{2}} (- x^{4} y - 2 x^{3} y^{2} - x^{3} + 3 x^{2} y^{3} - x^{2} y + 4 x y^{4} + 2 x y^{2} - 4 y^{5})" :db/id #edb/ref 17592186530700} {:answer/id #uuid "9bfe9e8f-7b95-5bfc-8aa0-7e420233a965" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "((- 2 x - y)^{2} + (- x + 4 y)^{2} + 1) (- x^{4} y - 2 x^{3} y^{2} - x^{3} + 3 x^{2} y^{3} - x^{2} y + 4 x y^{4} + 2 x y^{2} - 4 y^{5})" :db/id #edb/ref 17592186530706} {:answer/id #uuid "d1e60cda-923c-5121-8b8a-421e33ef4a68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- x^{4} y - 2 x^{3} y^{2} - x^{3} + 3 x^{2} y^{3} - x^{2} y + 4 x y^{4} + 2 x y^{2} - 4 y^{5}" :db/id #edb/ref 17592186530721}] :answer-field/correct {:answer/id #uuid "5139932b-8773-5680-9333-a8f817ea0415" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{(- 2 x - y)^{2} + (- x + 4 y)^{2} + 1} (- x^{4} y - 2 x^{3} y^{2} - x^{3} + 3 x^{2} y^{3} - x^{2} y + 4 x y^{4} + 2 x y^{2} - 4 y^{5})" :db/id #edb/ref 17592186530680} :answer-field/id #uuid "b52cf128-56f0-5e9d-a4ef-92e522375e53" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186530710}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f013a55f-b50b-519d-a1ee-bdf3c4905ad2" :question/problem "Consider the surface integral of the function $f(x,y,z)=x z - y z^{2},$ where the surface $S$ is defined by $z=- x^{2} - x y + 2 y^{2}$ for $0\\le x\\le 2$ and $-1\\le y\\le 0.$\nThis surface integral can be written as a repeated integral, as shown below. \n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={\\int }_{0}^{2}{\\int }_{-1}^{0}\\,\\boxed{}\\,\\,\\text{d}y\\,\\text{d}x\n$$\n\nWhat is the missing expression?" :question/worked-solution "For a surface $S$ defined by $z=g(x,y)$ with $(x,y)\\in D,$ the surface integral of a scalar function $f(x,y,z)$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A.\n$$\n\nFor the partial derivatives, we have\n\n$$\n\\frac{∂z}{∂x}=\\frac{∂}{∂x}(- x^{2} - x y + 2 y^{2})=- 2 x - y,\n$$\n\nand\n\n$$\n\\frac{∂z}{∂y}=\\frac{∂}{∂y}(- x^{2} - x y + 2 y^{2})=- x + 4 y.\n$$\n\nTherefore, the surface integral can be written as \n\n$$\n\\begin{aligned}{∬}_{S}f(x,y,z)\\,\\text{d}S & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+(- 2 x - y)^2+(- x + 4 y)^2}\\,\\text{d}A \\\\  & ={∬}_{D}\\,(x (- x^{2} - x y + 2 y^{2}) - y (- x^{2} - x y + 2 y^{2})^{2})\\cdot (\\sqrt{(- 2 x - y)^{2} + (- x + 4 y)^{2} + 1})\\,\\text{d}A \\\\  & ={∬}_{D}\\,(- x^{4} y - 2 x^{3} y^{2} - x^{3} + 3 x^{2} y^{3} - x^{2} y + 4 x y^{4} + 2 x y^{2} - 4 y^{5})\\cdot (\\sqrt{(- 2 x - y)^{2} + (- x + 4 y)^{2} + 1})\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{-1}^{0}\\,\\sqrt{(- 2 x - y)^{2} + (- x + 4 y)^{2} + 1} (- x^{4} y - 2 x^{3} y^{2} - x^{3} + 3 x^{2} y^{3} - x^{2} y + 4 x y^{4} + 2 x y^{2} - 4 y^{5})\\,\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186530732 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "135b727b-90a5-58f3-b28d-73bc883b71d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2 x^{3} - 2 x^{2} y - 2 x y^{2}) \\sqrt{(- 4 x + 2 y)^{2} + (2 x + 4 y)^{2} + 1}" :db/id #edb/ref 17592186530663} {:answer/id #uuid "1b855307-7285-5bec-af0e-c68f5677735c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 x^{3} - 2 x^{2} y - 2 x y^{2}" :db/id #edb/ref 17592186530668} {:answer/id #uuid "6d953e63-3844-5dda-bebb-b265d30d5e52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{(- 4 x + 2 y)^{2} + (2 x + 4 y)^{2}} (2 x^{3} - 2 x^{2} y - 2 x y^{2})" :db/id #edb/ref 17592186530686} {:answer/id #uuid "7897076e-28dc-5d0e-b8bb-01136fb78143" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2 x^{3} - 2 x^{2} y - 2 x y^{2}) ((- 4 x + 2 y)^{2} + (2 x + 4 y)^{2} + 1)" :db/id #edb/ref 17592186530693} {:answer/id #uuid "e5cf50ea-4319-5a4f-ba19-0ba8b226670e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 x^{3} - 2 x^{2} y - 2 x y^{2}}{\\sqrt{(- 4 x + 2 y)^{2} + (2 x + 4 y)^{2} + 1}}" :db/id #edb/ref 17592186530724}] :answer-field/correct {:answer/id #uuid "135b727b-90a5-58f3-b28d-73bc883b71d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2 x^{3} - 2 x^{2} y - 2 x y^{2}) \\sqrt{(- 4 x + 2 y)^{2} + (2 x + 4 y)^{2} + 1}" :db/id #edb/ref 17592186530663} :answer-field/id #uuid "172c374d-031f-5a6c-9d2b-39412dfe32ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186530666}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f47f306f-a5eb-5b1d-8c05-eca24441fbf6" :question/problem "Consider the surface integral of the function $f(x,y,z)=- x z,$ where the surface $S$ is defined by $z=- 2 x^{2} + 2 x y + 2 y^{2}$ for $0\\le x\\le 2$ and $0\\le y\\le 1.$\nThis surface integral can be written as a repeated integral, as shown below. \n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={\\int }_{0}^{2}{\\int }_{0}^{1}\\,\\boxed{}\\,\\,\\text{d}y\\,\\text{d}x\n$$\n\nWhat is the missing expression?" :question/worked-solution "For a surface $S$ defined by $z=g(x,y)$ with $(x,y)\\in D,$ the surface integral of a scalar function $f(x,y,z)$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A.\n$$\n\nFor the partial derivatives, we have\n\n$$\n\\frac{∂z}{∂x}=\\frac{∂}{∂x}(- 2 x^{2} + 2 x y + 2 y^{2})=- 4 x + 2 y,\n$$\n\nand\n\n$$\n\\frac{∂z}{∂y}=\\frac{∂}{∂y}(- 2 x^{2} + 2 x y + 2 y^{2})=2 x + 4 y.\n$$\n\nTherefore, the surface integral can be written as \n\n$$\n\\begin{aligned}{∬}_{S}f(x,y,z)\\,\\text{d}S & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+(- 4 x + 2 y)^2+(2 x + 4 y)^2}\\,\\text{d}A \\\\  & ={∬}_{D}\\,(- x (- 2 x^{2} + 2 x y + 2 y^{2}))\\cdot (\\sqrt{(- 4 x + 2 y)^{2} + (2 x + 4 y)^{2} + 1})\\,\\text{d}A \\\\  & ={∬}_{D}\\,(2 x^{3} - 2 x^{2} y - 2 x y^{2})\\cdot (\\sqrt{(- 4 x + 2 y)^{2} + (2 x + 4 y)^{2} + 1})\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}\\,(2 x^{3} - 2 x^{2} y - 2 x y^{2}) \\sqrt{(- 4 x + 2 y)^{2} + (2 x + 4 y)^{2} + 1}\\,\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186531565 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "138e119b-9f29-5728-b024-f296e1407436" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3+{ln}^{2}⁡2}}{\\operatorname{ln}⁡2}({3}^{\\pi }-1)" :db/id #edb/ref 17592186530898} {:answer/id #uuid "4c63f797-f964-543b-8948-8fa3ef071043" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{\\operatorname{ln}⁡3}({3}^{\\pi }+1)" :db/id #edb/ref 17592186531027} {:answer/id #uuid "6b6ad79e-00af-5e1d-b171-f99e8a87b59c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡3}{\\sqrt{1+\\operatorname{ln}⁡3}}({3}^{\\pi }-1)" :db/id #edb/ref 17592186531103} {:answer/id #uuid "a24f9d67-8d4f-5f04-a33c-d625d9ff53b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}({3}^{\\pi }-1)" :db/id #edb/ref 17592186531215} {:answer/id #uuid "ee47508c-c5ac-50f6-8486-05ab49b69007" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{1+{ln}^{2}⁡3}}{\\operatorname{ln}⁡3}({3}^{\\pi }-1)" :db/id #edb/ref 17592186531346}] :answer-field/correct {:answer/id #uuid "ee47508c-c5ac-50f6-8486-05ab49b69007" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{1+{ln}^{2}⁡3}}{\\operatorname{ln}⁡3}({3}^{\\pi }-1)" :db/id #edb/ref 17592186531346} :answer-field/id #uuid "770387f5-8ab3-56b6-9ab8-582f315d1f1c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186531469}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1bd5daf3-8ee2-5ee2-ae53-b882ce969a04" :question/math-academy-id "q-9541" :question/problem "Find the arc length of the polar curve $r={3}^{\\theta }$ for $0\\le \\theta \\le \\pi .$" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r={3}^{\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }={3}^{\\theta }\\operatorname{ln}⁡3.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{({3}^{\\theta })}^{2}+{({3}^{\\theta }\\operatorname{ln}⁡3)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{3}^{2\\theta }+{3}^{2\\theta }{ln}^{2}⁡3}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{(1+{ln}^{2}⁡3){3}^{2\\theta }}\\,\\text{d}\\theta  \\\\  & =\\sqrt{1+{ln}^{2}⁡3}{\\int }_{0}^{\\pi }{3}^{\\theta }\\,\\text{d}\\theta  \\\\  & =\\sqrt{1+{ln}^{2}⁡3}\\cdot \\frac{1}{\\operatorname{ln}⁡3}\\cdot {3}^{\\theta }{|}_{0}^{\\pi } \\\\  & =\\sqrt{1+{ln}^{2}⁡3}\\cdot \\frac{1}{\\operatorname{ln}⁡3}\\cdot ({3}^{\\pi }-{3}^{0}) \\\\  & =\\frac{\\sqrt{1+{ln}^{2}⁡3}}{\\operatorname{ln}⁡3}({3}^{\\pi }-1).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186531574 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0db6ee6f-edbb-5e5c-b2d1-764a2ea9a097" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{150}" :db/id #edb/ref 17592186530889}] :answer-field/correct {:answer/id #uuid "0db6ee6f-edbb-5e5c-b2d1-764a2ea9a097" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{150}" :db/id #edb/ref 17592186530889} :answer-field/id #uuid "d7d44499-1aa4-52d0-a15f-ec7d8581275c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186531529}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2d1d4e63-93d8-5dc2-a21f-3d16bb6f6063" :question/math-academy-id "q-352098" :question/problem "![](images/7d/7d6ef1d9a58af96b51152ce354ec85c616921187ed467273e8c41c4fe93fc19c.png)\n\nConsider the region bounded by the curve $x={y}^{2}-5{y}^{4}$ and the $y$-axis (shown in the picture). Using the shell method, calculate the volume of the solid generated when that region is rotated about the $x$-axis. Do not round the answer.\n\n$V=$\n{{field-1}}" :question/worked-solution "First, we determine the points where the curve intersects the $y$-axis by solving the following equation for $y:$\n\n$$\n\\begin{aligned}{y}^{2}-5{y}^{4} & =0 \\\\ {y}^{2}(1-5{y}^{2}) & =0 \\\\ y & =0\\,\\text{or}\\,{y}^{2}=\\frac{1}{5} \\\\ y & =0\\,\\text{or}\\,y=\\frac{1}{\\sqrt{5}}\\end{aligned}\n$$\n\nThe solutions are $y=0$ and $y=\\frac{1}{\\sqrt{5}}.$ So, we need to integrate from $y=0$ to $y=\\frac{1}{\\sqrt{5}}.$ \n\nUsing the shell method, the volume of the solid can be found as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{c}^{d}yf(y)\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{1/\\sqrt{5}}y({y}^{2}-5{y}^{4})\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{1/\\sqrt{5}}({y}^{3}-5{y}^{5})\\,\\text{d}y \\\\  & =2\\pi ({\\int }_{0}^{1/\\sqrt{5}}{y}^{3}\\,\\text{d}y-5{\\int }_{0}^{1/\\sqrt{5}}{y}^{5}\\,\\text{d}y) \\\\  & =2\\pi (\\frac{1}{4}{y}^{4}\\,{|}_{0}^{1/\\sqrt{5}}-\\frac{5}{6}{y}^{6}\\,{|}_{0}^{1/\\sqrt{5}}\\,) \\\\  & =2\\pi (\\frac{1}{4}(\\frac{1}{25}-0)-\\frac{5}{6}(\\frac{1}{125}-0)) \\\\  & =2\\pi (\\frac{1}{100}-\\frac{1}{150}) \\\\  & =2\\pi (\\frac{1}{300}) \\\\  & =\\frac{\\pi }{150}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186531575 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "731aa6f4-9b42-511b-99eb-f375784ef6ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{-3t}" :db/id #edb/ref 17592186531119}] :answer-field/correct {:answer/id #uuid "731aa6f4-9b42-511b-99eb-f375784ef6ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{-3t}" :db/id #edb/ref 17592186531119} :answer-field/id #uuid "6c17466c-b8ca-50c3-9f75-a6a53610a6c3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186531464} {:answer-field/choices [{:answer/id #uuid "26d00d5e-9f6b-5691-9183-ca640417b15f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186530951}] :answer-field/correct {:answer/id #uuid "26d00d5e-9f6b-5691-9183-ca640417b15f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186530951} :answer-field/id #uuid "79975f54-a6ab-5d67-8f15-fd4af267d146" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186531472}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e73d348-8d9b-5a9f-8dbf-5305290f7f53" :question/math-academy-id "q-332913" :question/problem "Consider the following inhomogeneous system of linear differential equations:\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & -2 \\\\ 2 & 0\\end{aligned}]x(t)+{e}^{-3t}[\\begin{aligned}1 \\\\ 5\\end{aligned}].\n$$\n\nThe complementary solution to this system is given by\n\n$$\n{x}_{c}(t)={c}_{1}[\\begin{aligned}\\operatorname{cos}⁡(2t) \\\\ \\operatorname{sin}⁡(2t)\\end{aligned}]+{c}_{2}[\\begin{aligned}-\\operatorname{sin}⁡(2t) \\\\ \\operatorname{cos}⁡(2t)\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThen, the general solution of the system is\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$x(t)={x}_{c}(t)+$ {{field-1}} $\\cdot \\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">$-1$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Recall that the general solution of an inhomogeneous system can be written as \n\n$$\nx(t)={x}_{c}(t)+{x}_{p}(t)\n$$\n\nwhere ${x}_{c}(t)$ is the complementary solution (solution of the corresponding homogeneous system) and ${x}_{p}(t)$ is a particular solution.\n\nThe forcing term\n\n$$\n{e}^{-3t}[\\begin{aligned}1 \\\\ 5\\end{aligned}]\n$$\n\nof the inhomogeneous system of ODEs is exponential. Therefore, we assume that the particular solution is also exponential, i.e.\n\n$$\n{x}_{p}(t)={e}^{-3t}[\\begin{aligned}a \\\\ b\\end{aligned}],\n$$\n\nwhere $a,b$  are constants that are to be determined. \n\nCalculating the derivative of ${x}_{p}$ with respect to $t$ gives\n\n$$\n{x}_{p}^{′}(t)=-3{e}^{-3t}[\\begin{aligned}a \\\\ b\\end{aligned}].\n$$\n\nTo find the unknown constants, we substitute ${x}_{p}$ and ${x}_{p}^{′}$ into our system:\n\n$$\n\\begin{aligned}-3{e}^{-3t}[\\begin{aligned}a \\\\ b\\end{aligned}] & =[\\begin{aligned}0 & -2 \\\\ 2 & 0\\end{aligned}]\\cdot {e}^{-3t}[\\begin{aligned}a \\\\ b\\end{aligned}]+{e}^{-3t}[\\begin{aligned}1 \\\\ 5\\end{aligned}] \\\\ -3[\\begin{aligned}a \\\\ b\\end{aligned}] & =[\\begin{aligned}0 & -2 \\\\ 2 & 0\\end{aligned}]\\cdot [\\begin{aligned}a \\\\ b\\end{aligned}]+[\\begin{aligned}1 \\\\ 5\\end{aligned}] \\\\ [\\begin{aligned}-3a \\\\ -3b\\end{aligned}] & =[\\begin{aligned}-2b \\\\ 2a\\end{aligned}]+[\\begin{aligned}1 \\\\ 5\\end{aligned}] \\\\ [\\begin{aligned}-3a \\\\ -3b\\end{aligned}] & =[\\begin{aligned}-2b+1 \\\\ 2a+5\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\{\\begin{aligned}-2b+1=-3a \\\\ 2a+5=-3b\\end{aligned}\n$$\n\nFrom the first equation, we get \n\n$$\n-2b+1=-3a\\,⇒\\,a=\\frac{2b-1}{3}.\n$$\n\n \nSubstituting this into the second equation and solving for $b,$ we have\n\n$$\n2(\\frac{2b-1}{3})+5=-3b\\,⇒\\,4b-2+15=-9b\\,⇒\\,b=-1.\n$$\n\nSo,\n\n$$\na=\\frac{2(-1)-1}{3}=\\frac{-2-1}{3}=-1.\n$$\n\nTherefore, the particular solution is\n\n$$\n{x}_{p}(t)={e}^{-3t}[\\begin{aligned}-1 \\\\ -1\\end{aligned}].\n$$"} {:db/id #edb/ref 17592186531587 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37b64633-9200-5ac4-9020-49356273a990" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\pi {\\int }_{0}^{\\pi /2}{cos}^{3}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186530986} {:answer/id #uuid "4fab1f17-f040-5e8d-ba53-5a0cfda68a34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\pi {\\int }_{0}^{\\pi /2}{sin}^{4}⁡t\\operatorname{cos}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186531036} {:answer/id #uuid "693cf72a-54a9-5ffe-b86a-e3d60d8e9126" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\pi {\\int }_{0}^{\\pi /2}{sin}^{3}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186531097} {:answer/id #uuid "a8cf6697-f373-540e-8e34-c5fc49f71fef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{\\pi /2}{sin}^{4}⁡t{cos}^{4}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186531230} {:answer/id #uuid "bb77564e-76df-5e96-b697-013fee021596" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{\\pi /2}{cos}^{4}⁡t\\operatorname{sin}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186531261}] :answer-field/correct {:answer/id #uuid "4fab1f17-f040-5e8d-ba53-5a0cfda68a34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\pi {\\int }_{0}^{\\pi /2}{sin}^{4}⁡t\\operatorname{cos}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186531036} :answer-field/id #uuid "632462c4-14ed-5c49-b96d-6314fe36a641" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186531458}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "42788b85-30ff-5f36-a9fd-86e424b97617" :question/math-academy-id "q-138980" :question/problem "Consider the curve defined parametrically as \n\n$$\nx={cos}^{3}⁡t,\\,y={sin}^{3}⁡t,\\,t\\in [0,\\frac{\\pi }{2}].\n$$\n\nWhat integral gives the surface area generated when this curve is rotated $2\\pi $ radians about the $x$-axis?" :question/worked-solution "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $x$-axis using the formula\n\n$$\nS=\\int 2\\pi y\\,\\text{d}s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\text{d}s=\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}y\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nWe are told that the limits of integration are from ${t}_{1}=0$ to ${t}_{2}=\\frac{\\pi }{2}.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({cos}^{3}⁡t)=-3\\operatorname{sin}⁡t{cos}^{2}⁡t \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({sin}^{3}⁡t)=3{sin}^{2}⁡t\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}y\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi /2}{sin}^{3}⁡t\\sqrt{{(-3\\operatorname{sin}⁡t{cos}^{2}⁡t)}^{2}+{(3{sin}^{2}⁡t\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi /2}{sin}^{3}⁡t\\sqrt{9{sin}^{2}⁡t{cos}^{4}⁡t+9{sin}^{4}⁡t{cos}^{2}⁡t}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi /2}{sin}^{3}⁡t\\sqrt{9{sin}^{2}⁡t{cos}^{2}⁡t({cos}^{2}⁡t+{sin}^{2}⁡t)}\\,\\text{d}t.\\end{aligned}\n$$\n\nNow, using the identity ${sin}^{2}⁡t+{cos}^{2}⁡t=1,$ we can rewrite our integral as follows:\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{0}^{\\pi /2}{sin}^{3}⁡t\\sqrt{9{sin}^{2}⁡t{cos}^{2}⁡t({cos}^{2}⁡t+{sin}^{2}⁡t)}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi /2}{sin}^{3}⁡t\\sqrt{(3\\operatorname{sin}⁡t\\operatorname{cos}⁡t)^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi /2}{sin}^{3}⁡t\\cdot |3\\operatorname{sin}⁡t\\operatorname{cos}⁡t|\\,\\text{d}t \\\\  & =6\\pi {\\int }_{0}^{\\pi /2}{sin}^{3}⁡t\\cdot \\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =6\\pi {\\int }_{0}^{\\pi /2}{sin}^{4}⁡t\\operatorname{cos}⁡t\\,\\text{d}t\\end{aligned}\n$$"} {:db/id #edb/ref 17592186531606 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ebc83588-25b8-5ff4-bfc0-bce39c4a0f4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{10}(e^{\\pi}-1)" :db/id #edb/ref 17592186531337}] :answer-field/correct {:answer/id #uuid "ebc83588-25b8-5ff4-bfc0-bce39c4a0f4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{10}(e^{\\pi}-1)" :db/id #edb/ref 17592186531337} :answer-field/id #uuid "0d00646e-dd97-589c-8e21-634590dfdfc6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186531395}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6ddfe515-d085-541a-8dab-b3a5ab40f555" :question/math-academy-id "q-353601" :question/problem "![](images/ec/ec0b88ec00ef7e7061af0b08761eb73f05a5f669208babacbd4eb86736019230.png)\n\nFind the arc length $L$ of the polar curve $r=6{e}^{3\\theta }$ for $0\\le \\theta \\le \\frac{\\pi }{3}$ (shown in blue in the diagram above). Do not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=6{e}^{3\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=18{e}^{3\\theta }.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{{(6{e}^{3\\theta })}^{2}+{(18{e}^{3\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{36{e}^{6\\theta }+324{e}^{6\\theta }}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{360{e}^{6\\theta }}\\,\\text{d}\\theta  \\\\  & =6\\sqrt{10}{\\int }_{0}^{\\pi /3}{e}^{3\\theta }\\,\\text{d}\\theta  \\\\  & =6\\sqrt{10}{[\\frac{1}{3}{e}^{3\\theta }]}_{0}^{\\pi /3} \\\\  & =2\\sqrt{10}{[{e}^{3\\theta }]}_{0}^{\\pi /3} \\\\  & =2\\sqrt{10}({e}^{\\pi }-{e}^{0}) \\\\  & =2\\sqrt{10}({e}^{\\pi }-1).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186531612 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e920f28-4383-54cc-9cc9-d78d86338f95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi}{160}" :db/id #edb/ref 17592186530967}] :answer-field/correct {:answer/id #uuid "2e920f28-4383-54cc-9cc9-d78d86338f95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi}{160}" :db/id #edb/ref 17592186530967} :answer-field/id #uuid "2c795d78-7949-57ee-a8d5-8e5d26c90629" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186531421}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7e282fab-f673-50f6-9e1f-aaa485da50b0" :question/math-academy-id "q-352100" :question/problem "![](images/69/69dbf7a007980f1f1a9c2531ad398237e22d28f329afc619e05b8372afe970d4.png)\n\nConsider the region bounded by the curve $x={y}^{2}-2{y}^{3}$ and the $y$-axis (shown in the picture). Using the shell method, calculate the volume of the solid generated when that region is rotated about the $x$-axis. Do not round the answer.\n\n$V=$\n{{field-1}}" :question/worked-solution "First, we determine the points where the curve intersects the $y$-axis by solving the following equation for $y:$\n\n$$\n\\begin{aligned}{y}^{2}-2{y}^{3} & =0 \\\\ {y}^{2}(1-2y) & =0 \\\\ y & =0\\,\\text{or}\\,1-2y=0 \\\\ y & =0\\,\\text{or}\\,y=\\frac{1}{2}\\end{aligned}\n$$\n\nThe solutions are $y=0$ and $y=\\frac{1}{2}.$ So, we need to integrate from $y=0$ to $y=\\frac{1}{2}.$ \n\nUsing the shell method, the volume of the solid can be found as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{c}^{d}yf(y)\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{1/2}y({y}^{2}-2{y}^{3})\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{1/2}({y}^{3}-2{y}^{4})\\,\\text{d}y \\\\  & =2\\pi ({\\int }_{0}^{1/2}{y}^{3}\\,\\text{d}y-2{\\int }_{0}^{1/2}{y}^{4}\\,\\text{d}y) \\\\  & =2\\pi (\\frac{1}{4}{y}^{4}\\,{|}_{0}^{1/2}-\\frac{2}{5}{y}^{5}\\,{|}_{0}^{1/2}\\,) \\\\  & =2\\pi (\\frac{1}{4}(\\frac{1}{16}-0)-\\frac{2}{5}(\\frac{1}{32}-0)) \\\\  & =2\\pi (\\frac{1}{64}-\\frac{1}{80}) \\\\  & =2\\pi (\\frac{1}{320}) \\\\  & =\\frac{\\pi }{160}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186531626 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15a09810-6e1e-5a7f-a496-a308672d8fe3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{-2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186530902} {:answer/id #uuid "70d61664-e8b3-5d91-831f-2ef5a133d2af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{2-\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186531115} {:answer/id #uuid "75c79860-2158-5faa-be6a-5b9aa2eb7054" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{1-\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186531123} {:answer/id #uuid "931cc387-4c8e-5435-8982-a4705188d119" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{1-2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186531181} {:answer/id #uuid "ad39fb78-7dc8-5c7f-b6cd-c9732f59d8ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{2-2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186531238}] :answer-field/correct {:answer/id #uuid "ad39fb78-7dc8-5c7f-b6cd-c9732f59d8ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{2-2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186531238} :answer-field/id #uuid "452ad711-f8a6-5c7b-b980-01feac5bbbde" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186531443}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a1c1460f-c5a2-5e99-b7f7-17db73e707c6" :question/math-academy-id "q-103828" :question/problem "Which of the following gives the arc length of the polar curve $r=1-\\operatorname{sin}⁡\\theta $ for $0\\le \\theta \\le \\frac{\\pi }{4}?$" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=1-\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=-\\operatorname{cos}⁡\\theta .\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{(1-\\operatorname{sin}⁡\\theta )^{2}+(-\\operatorname{cos}⁡\\theta )^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{(1-2\\operatorname{sin}⁡\\theta +{sin}^{2}⁡\\theta )+{cos}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{1-2\\operatorname{sin}⁡\\theta +1}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{2-2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta \\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186531628 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "901a723b-e6e5-572f-9b48-3f4f2a4dea43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi" :db/id #edb/ref 17592186531175}] :answer-field/correct {:answer/id #uuid "901a723b-e6e5-572f-9b48-3f4f2a4dea43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi" :db/id #edb/ref 17592186531175} :answer-field/id #uuid "3487b8fc-2024-52a0-8191-9d6c368ac790" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186531427}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a9290c4e-ece3-5a58-aecc-bb62b4894116" :question/math-academy-id "q-353582" :question/problem "![](images/83/83813bff1ff86036e2773d9476150de619688daec9cae2623a555a43290cace3.png)\n\nFind the arc length $L$ of the polar curve $r=3\\operatorname{sin}⁡\\theta $ for $\\frac{\\pi }{2}\\le \\theta \\le \\frac{5\\pi }{6}$ (shown in blue in the diagram above). Do not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=3\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=3\\operatorname{cos}⁡\\theta .\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{5\\pi /6}\\sqrt{{(3\\operatorname{sin}⁡\\theta )}^{2}+{(3\\operatorname{cos}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{5\\pi /6}\\sqrt{9{sin}^{2}⁡\\theta +9{cos}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{5\\pi /6}\\sqrt{9}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{5\\pi /6}3\\,\\text{d}\\theta  \\\\  & =3\\theta \\,{|}_{\\pi /2}^{5\\pi /6} \\\\  & =3(\\frac{5\\pi }{6}-\\frac{\\pi }{2}) \\\\  & =\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186531644 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ce61a52-02f8-52e3-833d-f0a747be827a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2}{\\sqrt{1+\\operatorname{ln}⁡2}}({2}^{\\pi /2}-1)" :db/id #edb/ref 17592186530920} {:answer/id #uuid "25efba17-6780-5d23-af19-6462827fe365" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{1+{ln}^{2}⁡2}}{\\operatorname{ln}⁡2}({2}^{\\pi /2}-1)" :db/id #edb/ref 17592186530950} {:answer/id #uuid "44549959-713e-5a87-987f-4262b4d5d3c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2}{\\sqrt{2}}({2}^{\\pi /2}-1)" :db/id #edb/ref 17592186531009} {:answer/id #uuid "ca7da443-446d-582f-b934-dcaf57f4a7d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{\\operatorname{ln}⁡2}({2}^{\\pi /2}-1)" :db/id #edb/ref 17592186531287} {:answer/id #uuid "d25fbccb-dafe-5557-83e3-f260cee1b53a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}({2}^{\\pi /2}-1)" :db/id #edb/ref 17592186531298}] :answer-field/correct {:answer/id #uuid "25efba17-6780-5d23-af19-6462827fe365" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{1+{ln}^{2}⁡2}}{\\operatorname{ln}⁡2}({2}^{\\pi /2}-1)" :db/id #edb/ref 17592186530950} :answer-field/id #uuid "2a4caf7b-52fc-5e88-b891-82cc9a3a2cf7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186531417}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "da080066-6980-5e46-a310-b96dc7f7120c" :question/math-academy-id "q-9540" :question/problem "![](images/c1/c1bf9d989f1fbaeda90325b924f2c9285cd4e37e1948ba63256258b0a84c7e44.png)\n\nFind the arc length of the polar curve $r={2}^{\\theta }$ for $0\\le \\theta \\le \\frac{\\pi }{2}$ (shown in blue in the diagram above)." :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r={2}^{\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }={2}^{\\theta }\\operatorname{ln}⁡2.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{({2}^{\\theta })}^{2}+{({2}^{\\theta }\\operatorname{ln}⁡2)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{2}^{2\\theta }+{2}^{2\\theta }{ln}^{2}⁡2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{(1+{ln}^{2}⁡2){2}^{2\\theta }}\\,\\text{d}\\theta  \\\\  & =\\sqrt{1+{ln}^{2}⁡2}{\\int }_{0}^{\\pi /2}{2}^{\\theta }\\,\\text{d}\\theta  \\\\  & =\\sqrt{1+{ln}^{2}⁡2}\\cdot \\frac{1}{\\operatorname{ln}⁡2}\\cdot {2}^{\\theta }{|}_{0}^{\\pi /2} \\\\  & =\\sqrt{1+{ln}^{2}⁡2}\\cdot \\frac{1}{\\operatorname{ln}⁡2}\\cdot ({2}^{\\pi /2}-{2}^{0}) \\\\  & =\\frac{\\sqrt{1+{ln}^{2}⁡2}}{\\operatorname{ln}⁡2}({2}^{\\pi /2}-1).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186531731 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65e5c3f0-5773-5bbd-a23a-3a43d1fc086e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{7}{4}" :db/id #edb/ref 17592186531761} {:answer/id #uuid "6b202fc5-7a82-5091-9da5-936069a8528b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{727}{4}" :db/id #edb/ref 17592186531763} {:answer/id #uuid "9e2a14ab-0cce-5725-9c80-5f9d2f8d0921" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "182" :db/id #edb/ref 17592186531782} {:answer/id #uuid "bf400e9b-bb0b-5054-8ef9-7e5f7d9ae05b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "197" :db/id #edb/ref 17592186531789} {:answer/id #uuid "f958d464-4ab0-5f12-8833-fb278b8eb146" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{713}{4}" :db/id #edb/ref 17592186531799}] :answer-field/correct {:answer/id #uuid "f958d464-4ab0-5f12-8833-fb278b8eb146" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{713}{4}" :db/id #edb/ref 17592186531799} :answer-field/id #uuid "3c8c9430-d63b-5c40-bd47-a82c98a21776" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186531746}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "01c658f5-4f30-5b39-9d41-0213df71f8bb" :question/problem "A surface $S$ is defined by $z=f(x,y).$ The curve $C$ is the intersection of $S$ with the plane $x=3.$ Given that the point $P(3,-4,6)$ lies on $C,$ and that $f_y = \\dfrac{5x}y - 5x^2y+2\\cos(\\pi y)$, find the slope of the tangent to $C$ at $