 (- x^{2} - x y + 2 y^{2}))\\cdot (\\sqrt{(- 2 x - y)^{2} + (- x + 4 y)^{2} + 1})\\,\\text{d}A \\\\  & ={∬}_{D}\\,(- x^{3} - x^{2} y + 2 x y^{2})\\cdot (\\sqrt{(- 2 x - y)^{2} + (- x + 4 y)^{2} + 1})\\,\\text{d}A \\\\  & ={\\int }_{-2}^{0}{\\int }_{-1}^{0}\\,(- x^{3} - x^{2} y + 2 x y^{2}) \\sqrt{(- 2 x - y)^{2} + (- x + 4 y)^{2} + 1}\\,\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186530714 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50144386-43ca-57e8-a380-819e9700d02e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{(- 2 x - y)^{2} + (- x - 4 y)^{2}} (- x^{3} - x^{2} y - 2 x y^{2})" :db/id #edb/ref 17592186530679} {:answer/id #uuid "6f9a00e3-e49c-53e0-9c1b-2823d6c4695e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- x^{3} - x^{2} y - 2 x y^{2}) ((- 2 x - y)^{2} + (- x - 4 y)^{2} + 1)" :db/id #edb/ref 17592186530687} {:answer/id #uuid "702fbeab-7203-599b-b3b5-1e7708171852" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- x^{3} - x^{2} y - 2 x y^{2}) \\sqrt{(- 2 x - y)^{2} + (- x - 4 y)^{2} + 1}" :db/id #edb/ref 17592186530688} {:answer/id #uuid "beb53448-1283-5da0-ab26-eb9fad1b3dce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- x^{3} - x^{2} y - 2 x y^{2}" :db/id #edb/ref 17592186530715} {:answer/id #uuid "dcf9e14e-4ddc-550e-b646-01ee533add68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{- x^{3} - x^{2} y - 2 x y^{2}}{\\sqrt{(- 2 x - y)^{2} + (- x - 4 y)^{2} + 1}}" :db/id #edb/ref 17592186530723}] :answer-field/correct {:answer/id #uuid "702fbeab-7203-599b-b3b5-1e7708171852" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- x^{3} - x^{2} y - 2 x y^{2}) \\sqrt{(- 2 x - y)^{2} + (- x - 4 y)^{2} + 1}" :db/id #edb/ref 17592186530688} :answer-field/id #