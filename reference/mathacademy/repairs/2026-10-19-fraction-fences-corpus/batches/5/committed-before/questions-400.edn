b/ident :answer.type/math} :answer/value "-\\frac{5}{3}\\operatorname{ln}⁡(K|3x+6|)" :db/id #edb/ref 17592186491389} {:answer/id #uuid "938dd7b6-6b46-5343-bfa2-fcbfd6a86831" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}\\operatorname{ln}⁡(K|3x+6|)" :db/id #edb/ref 17592186491399} {:answer/id #uuid "b08d9aca-d6ca-58d6-8855-ca54e1bf14cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡(K|3x+6|)" :db/id #edb/ref 17592186491400}] :answer-field/correct {:answer/id #uuid "3b8025c0-ef83-5f75-a0d8-f8420d212fbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}\\operatorname{ln}⁡(K|3x+6|)" :db/id #edb/ref 17592186491386} :answer-field/id #uuid "0efe3063-4e18-5d21-9ae8-4bb41f3b6a1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491381}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "71f9aed2-ae1d-5853-b1d1-1e76be4a49fc" :question/problem "Calculate $\\int \\frac{5}{3x+6}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=3x+6.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{5}{3x+6}\\,\\text{d}x & =5\\int \\frac{1}{3x+6}\\,\\text{d}x \\\\  & =5\\int \\frac{1}{u}\\cdot (\\frac{1}{3})\\,\\text{d}u \\\\  & =\\frac{5}{3}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{5}{3}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{5}{3}\\operatorname{ln}⁡|3x+6|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=\\frac{5}{3}\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}\\frac{5}{3}\\operatorname{ln}⁡|3x+6|+C & =\\frac{5}{3}\\operatorname{ln}⁡|3x+6|+\\frac{5}{3}\\operatorname{ln}⁡K \\\\  & =\\frac{5}{3}(\\operatorname{ln}⁡|3x+6|+\\operatorname{ln}⁡K) \\\\  & =\\frac{5}{3}\\operatorname{ln}⁡(K|3x+6|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{5}{3x+6}\\,\\text{d}x=\\frac{5}{3}\\operatorname{ln}⁡(K|3x+6|).\n$$"} {:db/id #edb/ref 17592186491396 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36df3f42-9acc-59cd-9e5b-d067fde6233e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(K|3-4x|)" :db/id #edb/ref 17592186491384} {:answer/id #uuid "84692a86-4be4-5c48-a755-005930c3b402" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}\\operatorname{ln}⁡(K|3-4x|)" :db/id #edb/ref 17592186491397} {:answer/id #uuid "c68d87e6-c50a-56a4-a9a2-6b416918908b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡(K|3-4x|)" :db/id #edb/ref 17592186491401} {:answer/id #uuid "f10479be-37f6-55c9-9c2d-8dbee457b99a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(K|3-4x|)" :db/id #edb/ref 17592186491405} {:answer/id #uuid "fd7dcafd-2ed2-5588-8f0c-3f475682d35d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\operatorname{ln}⁡(K|3-4x|)" :db/id #edb/ref 17592186491406}] :answer-field/correct {:answer/id #uuid "84692a86-4be4-5c48-a755-005930c3b402" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}\\operatorname{ln}⁡(K|3-4x|)" :db/id #edb/ref 17592186491397} :answer-field/id #uuid "cce4b3ec-222e-51ba-8ae8-114a9fa9d3d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491402}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7b296cf1-22cc-51dc-9bbc-7095846c4fed" :question/problem "Calculate $\\int \\frac{1}{3-4x}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=3-4x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-4\\,⟹\\,\\text{d}x=-\\frac{1}{4}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{3-4x}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot (-\\frac{1}{4})\\,\\text{d}u \\\\  & =-\\frac{1}{4}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{1}{4}\\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{1}{4}\\operatorname{ln}⁡|3-4x|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=-\\frac{1}{4}\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}-\\frac{1}{4}\\operatorname{ln}⁡|3-4x|+C & =-\\frac{1}{4}\\operatorname{ln}⁡|3-4x|-\\frac{1}{4}\\operatorname{ln}⁡K \\\\  & =-\\frac{1}{4}(\\operatorname{ln}⁡|3-4x|+\\operatorname{ln}⁡K) \\\\  & =-\\frac{1}{4}\\operatorname{ln}⁡(K|3-4x|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{3-4x}\\text{d}x=-\\frac{1}{4}\\operatorname{ln}⁡(K|3-4x|).\n$$"} {:db/id #edb/ref 17592186491403 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e90047e-f55c-52b5-b46c-93db0257557e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\operatorname{ln}⁡(K|5-5x|)" :db/id #edb/ref 17592186491379} {:answer/id #uuid "13d0d069-d025-565b-a9ec-455ab0bce8a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}\\operatorname{ln}⁡(\\frac{K}{|5-5x|})" :db/id #edb/ref 17592186491382} {:answer/id #uuid "3b32f0fe-afd1-5f2f-bd1e-9943f2d38376" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6}{5}\\operatorname{ln}⁡(K|5-5x|)" :db/id #edb/ref 17592186491385} {:answer/id #uuid "521d6737-f622-5a95-8205-2c2c5f2e0873" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{10}\\operatorname{ln}⁡(K|5-5x|)" :db/id #edb/ref 17592186491390} {:answer/id #uuid "604a9ab2-ffa7-55cc-8e05-8521cfeb2098" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{5}\\operatorname{ln}⁡(K|5-5x|)" :db/id #edb/ref 17592186491393}] :answer-field/correct {:answer/id #uuid "3b32f0fe-afd1-5f2f-bd1e-9943f2d38376" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6}{5}\\operatorname{ln}⁡(K|5-5x|)" :db/id #edb/ref 17592186491385} :answer-field/id #uuid "4b8ae8f2-247f-5d06-abb6-af657a1cd8b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491388}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d9f41743-b83b-587e-a674-fcd409f35761" :question/problem "Calculate $\\int \\frac{6}{5-5x}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=5-5x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-5\\,⟹\\,\\text{d}x=-\\frac{1}{5}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{6}{5-5x}\\,\\text{d}x & =6\\int \\frac{1}{5-5x}\\,\\text{d}x \\\\  & =6\\int \\frac{1}{u}\\cdot (-\\frac{1}{5})\\,\\text{d}u \\\\  & =-\\frac{6}{5}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{6}{5}\\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{6}{5}\\operatorname{ln}⁡|5-5x|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=-\\frac{6}{5}\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}-\\frac{6}{5}\\operatorname{ln}⁡|5-5x|+C & =-\\frac{6}{5}\\operatorname{ln}⁡|5-5x|-\\frac{6}{5}\\operatorname{ln}⁡K \\\\  & =-\\frac{6}{5}(\\operatorname{ln}⁡|5-5x|+\\operatorname{ln}⁡K) \\\\  & =-\\frac{6}{5}\\operatorname{ln}⁡(K|5-5x|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{6}{5-5x}\\,\\text{d}x=-\\frac{6}{5}\\operatorname{ln}⁡(K|5-5x|).\n$$"} {:db/id #edb/ref 17592186491404 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ed309e1-7fed-5611-88ea-d3f7f560e643" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|6x+2|)" :db/id #edb/ref 17592186491380} {:answer/id #uuid "2d5ba678-fb47-535d-94c1-f60655b4d9d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\operatorname{ln}⁡(K|6x+2|)" :db/id #edb/ref 17592186491383} {:answer/id #uuid "593e3a6a-f60c-5f0d-9379-e7310c6ecf8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(\\frac{|6x+2|}{K})" :db/id #edb/ref 17592186491391} {:answer/id #uuid "5e575092-4b7d-5a7a-b65e-eccaca74bbfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡(K|6x+2|)" :db/id #edb/ref 17592186491392} {:answer/id #uuid "792e0c84-eee3-5f47-9343-9bd165f08572" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{K}{6}\\operatorname{ln}⁡(|6x+2|)" :db/id #edb/ref 17592186491395}] :answer-field/correct {:answer/id #uuid "2d5ba678-fb47-535d-94c1-f60655b4d9d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\operatorname{ln}⁡(K|6x+2|)" :db/id #edb/ref 17592186491383} :answer-field/id #uuid "85668fa6-214c-50d9-8486-30cba7ace9ed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491398}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e5cc660e-d261-5bf0-a86d-22509ddcb061" :question/problem "Calculate $\\int \\frac{1}{6x+2}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=6x+2.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6\\,⟹\\,\\text{d}x=\\frac{1}{6}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{6x+2}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot \\frac{1}{6}\\,\\text{d}u \\\\  & =\\frac{1}{6}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{6}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{6}\\operatorname{ln}⁡|6x+2|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=\\frac{1}{6}\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}\\frac{1}{6}\\operatorname{ln}⁡|6x+2|+C & =\\frac{1}{6}\\operatorname{ln}⁡|6x+2|+\\frac{1}{6}\\operatorname{ln}⁡K \\\\  & =\\frac{1}{6}(\\operatorname{ln}⁡|6x+2|+\\operatorname{ln}⁡K) \\\\  & =\\frac{1}{6}\\operatorname{ln}⁡(K|6x+2|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{6x+2}\\,\\text{d}x=\\frac{1}{6}\\operatorname{ln}⁡(K|6x+2|).\n$$"} {:db/id #edb/ref 17592186491983 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b2bbcb8-c26d-5006-a73c-bbb060d2cd36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186491568} {:answer/id #uuid "aba8c641-4582-5c5c-96f9-0d22c8330b28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186491753} {:answer/id #uuid "d6091ef9-6288-59c1-9465-7c82caaeb2be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186491819} {:answer/id #uuid "ebb91197-701b-57ed-96ae-159bf0a24d7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186491858} {:answer/id #uuid "edc9ced6-e6c7-5f1d-be8e-a811c81b1ee0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186491862}] :answer-field/correct {:answer/id #uuid "3b2bbcb8-c26d-5006-a73c-bbb060d2cd36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186491568} :answer-field/id #uuid "2c5a083c-f900-50bb-ab0f-b4084bf566f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491899}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "018796a4-bd8d-5016-90ff-54138b129ff5" :question/math-academy-id "q-160875" :question/problem "Using the change of variables \n\n$$\nu=2y-x,\\,v=y-x,\n$$\n\ncalculate the area of the finite region $D$ in the first quadrant bounded by the lines\n\n$$\ny=1+\\frac{x}{2},\\,y=-1+\\frac{x}{2},\\,y=x-1,\\,y=x-2.\n$$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$  \n\nNote that the changes of variables\n\n$$\nu=2y-x,\\,v=y-x\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required area, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nWe substitute $u=2y-x$ into the equations of the first and second lines:\n\n$$\n\\begin{aligned} & y=1+\\frac{x}{2} & ⟹\\, & 2y-x=2 & ⟹\\, & u=2 \\\\  & y=-1+\\frac{x}{2} & ⟹\\, & 2y-x=-2 & ⟹\\, & u=-2\\end{aligned}\n$$\n\nAnd we substitute $v=y-x$ into the equations of the third and fourth lines:\n\n$$\n\\begin{aligned} & y=x-1 & ⟹\\, & y-x=-1 & ⟹\\, & v=-1 \\\\  & y=x-2 & ⟹\\, & y-x=-2 & ⟹\\, & v=-2\\end{aligned}\n$$\n\nTherefore, our domain in the $uv$-plane is the following rectangle:\n\n$$\nΔ=\\{(u,v)\\,:\\,-2\\le u\\le 2,\\,-2\\le v\\le -1\\}\n$$\n\n![](images/e9/e9ad855bcb5133e9a51d990ea25d0e23c8da88c59e15825f3ea1bfc47335dc33.png)\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-1 & 2 \\\\ -1 & \\text{ }\\text{ }1\\end{vmatrix} \\\\  & =1.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}=1.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|1|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}\\,\\text{d}u\\text{d}v \\\\  & =\\text{Area}(Δ) \\\\  & =4\\cdot 1 \\\\  & =4\\end{aligned}\n$$"} {:db/id #edb/ref 17592186491993 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "059db5fe-4cc3-54a1-81e3-0414e4815adc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186491461} {:answer/id #uuid "2986cb5f-c1ed-50c3-8db9-d15e99c3946a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186491539} {:answer/id #uuid "31cc9859-a239-5a5d-b7da-9bb9d1419d34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186491553} {:answer/id #uuid "3d8a5ea6-1e80-5839-b6f0-5b028efd7cc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186491573} {:answer/id #uuid "478b922b-06ad-5ebb-92ad-7e5c3604f039" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186491588}] :answer-field/correct {:answer/id #uuid "3d8a5ea6-1e80-5839-b6f0-5b028efd7cc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186491573} :answer-field/id #uuid "71a832b8-f7c1-5834-aad6-10f8986faaf6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491926}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "148dd598-80e8-5dbb-9901-ed29d38f654f" :question/math-academy-id "q-160846" :question/problem "Use a change of variables to calculate the area of the finite region $D$ bounded by the following lines.\n\n$$\ny=2x-1,\\,y=2x-3,\\,x=2y+1,\\,x=2y+4\n$$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nWe'll assume this transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv,\n$$\n\n  \n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required area, we proceed in five steps:\n\n**Step 1**: Find a suitable change of variables.\n\nNotice that we can rewrite the equations of our curves as follows:\n\n$$\n2x-y=1,\\,2x-y=3,\\,x-2y=1,\\,x-2y=4\n$$\n\nThis suggests the following change of variables:\n\n$$\nu=2x-y,\\,v=x-2y\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nWe substitute $u=2x-y$ into the equations of the first and second curves:\n\n$$\n\\begin{aligned} & 2x-y=1\\,⟹\\,u=1 \\\\  & 2x-y=3\\,⟹\\,u=3\\end{aligned}\n$$\n\nAnd we substitute $v=x-2y$ into the equations of the third and fourth curves:\n\n$$\n\\begin{aligned} & x-2y=1\\,⟹\\,v=1 \\\\  & x-2y=4\\,⟹\\,v=4\\end{aligned}\n$$\n\nTherefore, our domain in the $uv$-plane is the following rectangle:\n\n$$\nΔ=\\{(u,v)\\,:\\,1\\le u\\le 3,\\,1\\le v\\le 4\\}\n$$\n\n![](images/87/877dee1177d97f3c0df572e766d47cf31cec941d1770f72f5835433b386d5067.png)\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & -1 \\\\ 1 & -2\\end{vmatrix} \\\\  & =-4+1 \\\\  & =-3.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}=-\\frac{1}{3}.\n$$\n\nNote that $\\frac{∂(u,v)}{∂(x,y)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|-\\frac{1}{3}|\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{3}{∬}_{Δ}\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{1}^{3}\\,\\text{d}u{\\int }_{1}^{4}\\,\\text{d}v \\\\  & =\\frac{1}{3}\\cdot (3-1)\\cdot (4-1) \\\\  & =2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186491995 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2704d9bd-c674-57e4-8db7-da57113e6141" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186491535} {:answer/id #uuid "a01f91d3-c2ad-5069-8a76-47da4c8b38b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186491738} {:answer/id #uuid "a5bfbf0b-4072-5ba5-a96b-076aaa163007" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186491742} {:answer/id #uuid "afce08c0-f3d3-511e-9b16-29b005f793ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186491761} {:answer/id #uuid "dd32bf3f-4ab3-582a-ad98-c9be76c0ba3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186491830}] :answer-field/correct {:answer/id #uuid "a01f91d3-c2ad-5069-8a76-47da4c8b38b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186491738} :answer-field/id #uuid "97563c8f-2987-55f3-a83b-6c7371d8e9d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491941}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "19c4c415-ad3c-5e8f-ba67-3b530b8c6971" :question/math-academy-id "q-160853" :question/problem "Use a change of variables to calculate the area of the finite region $D$ bounded by the following lines.\n\n$$\n2y=3x-2,\\,2y=3x-7,\\,2x=3y+1,\\,2x=3y+4\n$$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nWe'll assume this transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv,\n$$\n\n  \n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required area, we proceed in five steps:\n\n**Step 1**: Find a suitable change of variables.\n\nNotice that we can rewrite the equations of our curves as follows:\n\n$$\n3x-2y=2,\\,3x-2y=7,\\,2x-3y=1,\\,2x-3y=4\n$$\n\nThis suggests the following change of variables:\n\n$$\nu=3x-2y,\\,v=2x-3y\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nWe substitute $u=3x-2y$ into the equations of the first and second curves:\n\n$$\n\\begin{aligned} & 3x-2y=2\\,⟹\\,u=2 \\\\  & 3x-2y=7\\,⟹\\,u=7\\end{aligned}\n$$\n\nAnd we substitute $v=2x-3y$ into the equations of the third and fourth curves:\n\n$$\n\\begin{aligned} & 2x-3y=1\\,⟹\\,v=1 \\\\  & 2x-3y=4\\,⟹\\,v=4\\end{aligned}\n$$\n\nTherefore, our domain in the $uv$-plane is the following rectangle:\n\n$$\nΔ=\\{(u,v)\\,:\\,2\\le u\\le 7,\\,1\\le v\\le 4\\}\n$$\n\n![](images/83/83798f4e941010a24a548d9403b7085fa8e4b8cca8dcb7c0ebc6670d4afbf517.png)\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}3 & -2 \\\\ 2 & -3\\end{vmatrix} \\\\  & =-9+4 \\\\  & =-5.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}=-\\frac{1}{5}.\n$$\n\nNote that $\\frac{∂(u,v)}{∂(x,y)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|-\\frac{1}{5}|\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{5}{∬}_{Δ}\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{5}{\\int }_{2}^{7}\\,\\text{d}u{\\int }_{1}^{4}\\,\\text{d}v \\\\  & =\\frac{1}{5}\\cdot (7-2)\\cdot (4-1) \\\\  & =3\\end{aligned}\n$$"} {:db/id #edb/ref 17592186491996 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03f427ed-2d2a-5dfa-8945-d1b3f1c00922" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186491456} {:answer/id #uuid "3d405b8d-b749-5fcf-9281-fe13658b158d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186491572} {:answer/id #uuid "947befcc-fa3a-58ec-8c95-d53e4ad8cc01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3" :db/id #edb/ref 17592186491708} {:answer/id #uuid "c853fb0b-11f2-5a9b-a138-764447d95351" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186491794} {:answer/id #uuid "c9995f65-1329-5eb2-aafe-12e03a218173" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186491797}] :answer-field/correct {:answer/id #uuid "c9995f65-1329-5eb2-aafe-12e03a218173" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186491797} :answer-field/id #uuid "e3443c26-bcc5-576e-a59c-ebc351a5027e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491974}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "19d01b49-3d16-5ae7-a700-51548665fd4c" :question/math-academy-id "q-160893" :question/problem "Using the change of variables\n\n$$\nu=\\frac{y}{{x}^{2}},\\,v=\\frac{{y}^{2}}{x},\n$$\n\ncalculate the area of the finite region $D$ in the first quadrant bounded by the curves\n\n$$\ny={x}^{2},\\,y=3{x}^{2},\\,x={y}^{2},\\,x=\\frac{{y}^{2}}{4}.\n$$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$  \n\nNote that the changes of variables\n\n$$\nu=\\frac{y}{{x}^{2}},\\,v=\\frac{{y}^{2}}{x}\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required area, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nWe substitute $u=\\frac{y}{{x}^{2}}$ into the equations of the first and second curves:\n\n$$\n\\begin{aligned} & y={x}^{2} & ⟹\\, & \\frac{y}{{x}^{2}}=1 & ⟹\\, & u=1 \\\\  & y=3{x}^{2} & ⟹\\, & \\frac{y}{{x}^{2}}=3 & ⟹\\, & u=3\\end{aligned}\n$$\n\nAnd we substitute $v=\\frac{{y}^{2}}{x}$ into the equations of the third and fourth curves:\n\n$$\n\\begin{aligned} & x={y}^{2} & ⟹\\, & \\frac{{y}^{2}}{x}=1 & ⟹\\, & v=1 \\\\  & x=\\frac{{y}^{2}}{4} & ⟹\\, & \\frac{{y}^{2}}{x}=4 & ⟹\\, & v=4\\end{aligned}\n$$\n\nTherefore, our domain in the $uv$-plane is the following rectangle:\n\n$$\nΔ=\\{(u,v)\\,:\\,1\\le u\\le 3,\\,1\\le v\\le 4\\}\n$$\n\n![](images/26/26eaba24af54a40f59f92148c145285ba4097ce765aee8cfc9a6241ff88b9498.png)\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-\\frac{2y}{{x}^{3}} & \\frac{1}{{x}^{2}} \\\\ -\\frac{{y}^{2}}{{x}^{2}} & \\text{ }\\text{ }\\frac{2y}{x}\\end{vmatrix} \\\\  & =-\\frac{3{y}^{2}}{{x}^{4}}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}=-\\frac{{x}^{4}}{3{y}^{2}}=-\\frac{1}{3{u}^{2}}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|-\\frac{1}{3{u}^{2}}|\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{1}^{3}{\\int }_{1}^{4}\\frac{1}{{u}^{2}}\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{1}^{3}\\frac{1}{{u}^{2}}\\,\\text{d}u{\\int }_{1}^{4}\\,\\text{d}v \\\\  & =\\frac{1}{3}\\cdot (-\\frac{1}{3}+1)\\cdot (4-1) \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186492005 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05ddffe9-4947-5d4a-841c-e28e064e4cc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186491462}] :answer-field/correct {:answer/id #uuid "05ddffe9-4947-5d4a-841c-e28e064e4cc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186491462} :answer-field/id #uuid "8eab90f6-8104-52b0-a6e8-bb42dffbc15f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186491938} {:answer-field/choices [{:answer/id #uuid "be1a0803-b6a6-5853-b14e-c386f57e1c7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186491780}] :answer-field/correct {:answer/id #uuid "be1a0803-b6a6-5853-b14e-c386f57e1c7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186491780} :answer-field/id #uuid "9c18f250-6379-5b1b-b0d6-c80a2aaf1a4c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186491945}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2c65fb38-ffb7-5f87-a162-80bfea9cae28" :question/math-academy-id "q-177589" :question/problem "Consider the line that has a slope of $\\frac{5}{2}$ and passes through the point $(6,7).$ What are the coordinates of the $y$-intercept?\n\nThe coordinates of the $y$-intercept are\n$($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" :question/worked-solution "Given that $m=\\frac{5}{2}$, we substitute the coordinates of the given point into the equation in slope-intercept form:\n\n$$\n\\begin{aligned}y & =mx+b \\\\ (7) & =(\\frac{5}{2})(6)+b \\\\ 7 & =15+b \\\\ -8 & =b \\\\ b & =-8.\\end{aligned}\n$$\n\nTherefore, the coordinates of the $y$-intercept are $(0,-8).$"} {:db/id #edb/ref 17592186492010 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14163be2-82b4-5e4d-94d8-e34ff6f47a8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8}{9}" :db/id #edb/ref 17592186491494} {:answer/id #uuid "5c1bef39-ab41-57db-84a4-a5efcb0eea38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186491623} {:answer/id #uuid "6dc73bc2-dd0f-5a2c-bc11-e5f9536c648c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-17" :db/id #edb/ref 17592186491651} {:answer/id #uuid "70d51575-b302-510a-8b46-be8452cd25cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186491658} {:answer/id #uuid "94efd0c7-d391-5b80-8bc1-222c2588b844" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186491710}] :answer-field/correct {:answer/id #uuid "94efd0c7-d391-5b80-8bc1-222c2588b844" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186491710} :answer-field/id #uuid "0c6dba06-c9bd-5ba6-bbe8-30a47b79b7c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491891}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "48481581-ae0e-5785-8535-25cf6844d8e6" :question/math-academy-id "q-3243" :question/problem "Find the $y$-intercept of the line that passes through the point $(-6,8)$ and has a slope of $\\frac{3}{2}.$" :question/worked-solution "Since the line passes through the point $(-6,8)$ and its slope is $\\frac{3}{2}$, we substitute $x=-6$, $y=8,$ and $m=\\frac{3}{2}$ into the equation in slope-intercept form:\n\n$$\n\\begin{aligned}y & =mx+b \\\\ (8) & =(\\frac{3}{2})(-6)+b \\\\ 8 & =-\\frac{18}{2}+b \\\\ 8 & =-9+b \\\\ 17 & =b \\\\ b & =17\\end{aligned}\n$$\n\nSo, the $y$-intercept is $b=17.$"} {:db/id #edb/ref 17592186492015 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26ffbc26-848e-5d04-abcc-6404b93bc783" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{2}}{3}" :db/id #edb/ref 17592186491534} {:answer/id #uuid "51513ac6-c10d-5428-81d7-fc0f9ff5e5a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186491608} {:answer/id #uuid "8d66c296-5953-5fbe-8ee0-08a430a0fe71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186491694} {:answer/id #uuid "ab6be4c3-4f0a-5a3d-9787-10ec2aa91cac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186491751} {:answer/id #uuid "df621dfa-555c-59a4-b00c-5eb1cda1d6b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186491834}] :answer-field/correct {:answer/id #uuid "26ffbc26-848e-5d04-abcc-6404b93bc783" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{2}}{3}" :db/id #edb/ref 17592186491534} :answer-field/id #uuid "9c1d39b3-e468-5801-801a-6497da6d4261" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491946}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "57f9fe20-2df7-5d01-bf45-354e1e66779e" :question/math-academy-id "q-38132" :question/problem "Using the change of variables \n\n$$\nu=x+2y,\\,v=x,\n$$\n\ncalculate the area of the finite region $D$ bounded by the curve $(x+2y)^{2}-x-1=0$ and the line $x=1.$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$  \n\nNote that the changes of variables\n\n$$\nu=x+2y,\\,v=x\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required area, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nSubstituting $x+2y=u$ and $x=v$ into the equation of the first curve, we get\n\n$$\n\\begin{aligned}(x+2y)^{2}-x-1=0\\,⟹\\,{u}^{2}-v-1=0\\,⟹\\,v={u}^{2}-1,\\end{aligned}\n$$\n\nwhile substituting $x=v$ into the equation of the second curve, we obtain\n\n$$\n\\begin{aligned}x=1\\,⟹\\,v=1.\\end{aligned}\n$$\n\nTo find the intersections of the curves in the $uv$-plane, we solve the following system:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}v &={u}^{2}-1 \\\\ v &=1\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}u &=\\pm \\sqrt{2} \\\\ v &=1.\\end{aligned}\\right.\\end{aligned}\n$$\n\nSo, the intersection points are $(\\pm \\sqrt{2},1).$\n\nTherefore, our domain in the $uv$-plane has the type I representation\n\n$$\nΔ=\\{(u,v)\\,:\\,-\\sqrt{2}\\le u\\le \\sqrt{2},\\,{u}^{2}-1\\le v\\le 1\\}.\n$$\n\n![](images/0c/0c598c1c0d09fb26175cad17106bc4529165da619f35a5882ead0ba133d05c2c.png)\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & 2 \\\\ 1 & 0\\end{vmatrix} \\\\  & =-2.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}={(-2)}^{-1}=-\\frac{1}{2}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|-\\frac{1}{2}|\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{-\\sqrt{2}}^{\\sqrt{2}}[{\\int }_{{u}^{2}-1}^{1}\\,dv]du \\\\  & =\\frac{1}{2}{\\int }_{-\\sqrt{2}}^{\\sqrt{2}}[v]_{{u}^{2}-1}^{1}\\,du \\\\  & =\\frac{1}{2}{\\int }_{-\\sqrt{2}}^{\\sqrt{2}}(1-({u}^{2}-1))du \\\\  & =\\frac{1}{2}{\\int }_{-\\sqrt{2}}^{\\sqrt{2}}(2-{u}^{2})du \\\\  & =\\frac{1}{2}{[2u-\\frac{{u}^{3}}{3}]}_{-\\sqrt{2}}^{\\sqrt{2}} \\\\  & =\\frac{1}{2}((2\\sqrt{2}-\\frac{2\\sqrt{2}}{3})-(-2\\sqrt{2}+\\frac{2\\sqrt{2}}{3})) \\\\  & =2\\sqrt{2}-\\frac{2\\sqrt{2}}{3} \\\\  & =\\frac{4\\sqrt{2}}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186492046 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ab7dbdf-cdeb-5d59-b993-8e3c334667e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{z}^{6}+12y{z}^{2}-\\frac{6{y}^{2}}{{z}^{2}}" :db/id #edb/ref 17592186491567} {:answer/id #uuid "7f51ea30-b85b-5aaa-8db2-5c054cbf097c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{z}^{6}+6y{z}^{2}-\\frac{24{y}^{2}}{{z}^{2}}" :db/id #edb/ref 17592186491677} {:answer/id #uuid "9c65c1ea-1534-5429-9fa5-eb19d6c92c34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{z}^{6}+6y{z}^{2}-\\frac{6{y}^{2}}{{z}^{2}}" :db/id #edb/ref 17592186491724} {:answer/id #uuid "f225180b-2833-5feb-9ee4-590d742c0ead" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{z}^{6}+12y{z}^{2}-\\frac{24{y}^{2}}{{z}^{2}}" :db/id #edb/ref 17592186491868} {:answer/id #uuid "f70054c3-f419-516b-9432-262356961613" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{z}^{6}+6y{z}^{2}-\\frac{12{y}^{2}}{{z}^{2}}" :db/id #edb/ref 17592186491876}] :answer-field/correct {:answer/id #uuid "f70054c3-f419-516b-9432-262356961613" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{z}^{6}+6y{z}^{2}-\\frac{12{y}^{2}}{{z}^{2}}" :db/id #edb/ref 17592186491876} :answer-field/id #uuid "6dfe3b1d-64a2-5aa6-947a-b91c6e82fc88" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491923}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ac49f7f6-9f77-5cda-ac3b-cdee9bcbb73f" :question/math-academy-id "q-12892" :question/problem "Find, in ascending powers of $y$ and descending powers of $z,$ the first three terms of the binomial expansion of ${(\\frac{2y}{{z}^{2}}-{z}^{2})}^{3}.$" :question/worked-solution "First, let's compare our expression with the binomial\n\n$$\n(a+b)^{n}.\n$$\n\nHere we have that $n=3,$ $a=\\frac{2y}{{z}^{2}},$ and $b=-{z}^{2}.$ So, the exponents of the binomial expansion must follow the pattern\n\n$$\n{a}^{3}{b}^{0},\\,{a}^{2}{b}^{1},\\,{a}^{1}{b}^{2},\\,{a}^{0}{b}^{3}.\n$$\n\nThe $3$rd row in Pascal's Triangle is $(1,3,3,1).$ Therefore,\n\n$$\n\\begin{aligned}{(\\frac{2y}{{z}^{2}}-{z}^{2})}^{3} & =1{a}^{3}+3{a}^{2}b+3a{b}^{2}+1{b}^{3} \\\\  & =1{(\\frac{2y}{{z}^{2}})}^{3}{(-{z}^{2})}^{0}+3{(\\frac{2y}{{z}^{2}})}^{2}{(-{z}^{2})}^{1} \\\\  & \\,+3{(\\frac{2y}{{z}^{2}})}^{1}{(-{z}^{2})}^{2}+1{(\\frac{2y}{{z}^{2}})}^{0}{(-{z}^{2})}^{3} \\\\  & =1(\\frac{8{y}^{3}}{{z}^{6}})(1)+3(\\frac{4{y}^{2}}{{z}^{4}})(-{z}^{2}) \\\\  & \\,+3(\\frac{2y}{{z}^{2}})({z}^{4})+1(1)(-{z}^{6}) \\\\  & =\\frac{8{y}^{3}}{{z}^{6}}-\\frac{12{y}^{2}{z}^{2}}{{z}^{4}}+\\frac{6y{z}^{4}}{{z}^{2}}-{z}^{6} \\\\  & =\\frac{8{y}^{3}}{{z}^{6}}-\\frac{12{y}^{2}}{{z}^{2}}+6y{z}^{2}-{z}^{6}.\\end{aligned}\n$$\n\nWe rewrite the binomial expansion in ascending powers of $y$ and descending powers of $z$ as follows:\n\n$$\n{(\\frac{2y}{{z}^{2}}-{z}^{2})}^{3}=-{z}^{6}+6y{z}^{2}-\\frac{12{y}^{2}}{{z}^{2}}+\\frac{8{y}^{3}}{{z}^{6}}\n$$\n\nFinally, in ascending powers of $y$ and descending powers of $z,$ the first three terms are\n\n$$\n-{z}^{6}+6y{z}^{2}-\\frac{12{y}^{2}}{{z}^{2}}.\n$$"} {:db/id #edb/ref 17592186492052 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06c981d0-879c-5395-961f-18d30c7ee1c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186491467} {:answer/id #uuid "30ccc38c-3c4b-51d7-a8be-015493817d8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186491550} {:answer/id #uuid "ca9407b6-9b59-518b-866e-5aec8e95de1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{\\sqrt{33}}" :db/id #edb/ref 17592186491798} {:answer/id #uuid "cbceddc2-2b0f-51bf-9732-a4901abca037" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2\\sqrt{6}}" :db/id #edb/ref 17592186491799} {:answer/id #uuid "f4c914c6-693e-5352-8b50-6792d0a0a2ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2\\sqrt{6}}" :db/id #edb/ref 17592186491872}] :answer-field/correct {:answer/id #uuid "06c981d0-879c-5395-961f-18d30c7ee1c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186491467} :answer-field/id #uuid "49d0d86a-f951-5330-9b83-6ded6a5ca5d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491911}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c0a58b0a-c208-5232-9cb9-1df706de5400" :question/math-academy-id "q-34618" :question/problem "Find the radius of curvature for the curve $r(t)$ at the point $r(0)$ if the curve and the derivative ${T}^{′}(t)$ of the corresponding unit tangent vector are given by\n\n$$\nr(t)=⟨2{e}^{t},\\,{e}^{2t},\\,t⟩,\\,{T}^{′}(t)=\\frac{2}{(2{e}^{2t}+1)^{2}}⟨{e}^{2t}-2{e}^{3t},\\,2{e}^{2t},\\,-2{e}^{2t}⟩\\,.\n$$" :question/worked-solution "Since we are given both the curve $r(t)$ and the derivative ${T}^{′}(t)$ of the unit tangent, we will use the following formula for the radius of curvature:\n\n$$\nR(t)=\\frac{1}{κ(t)}=\\frac{‖{r}^{′}(t)‖}{‖{T}^{′}(t)‖}\n$$\n\nFirst, we find ${r}^{′}(t)$, ${r}^{′}(0),$ and $‖{r}^{′}(0)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2{e}^{t}),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{2t}),\\,\\frac{\\text{d}}{\\text{d}t}(t)⟩ \\\\  & =⟨2{e}^{t},\\,2{e}^{2t},\\,1⟩ \\\\ {r}^{′}(0) & =⟨2{e}^{0},\\,2{e}^{0},\\,1⟩ \\\\  & =⟨2,\\,2,\\,1⟩ \\\\ ‖{r}^{′}(0)‖ & =\\sqrt{{2}^{2}+{2}^{2}+{1}^{2}}=\\sqrt{9}=3\\end{aligned}\n$$\n\nNext, we evaluate ${T}^{′}(0)$ and find its magnitude:\n\n$$\n\\begin{aligned}{T}^{′}(0) & =\\frac{2}{(2{e}^{0}+1)^{2}}⟨{e}^{0}-2{e}^{0},\\,2{e}^{0},\\,-2{e}^{0}⟩ \\\\  & =\\frac{2}{9}⟨-1,\\,2,\\,-2⟩ \\\\ ‖{T}^{′}(0)‖ & =\\frac{2}{9}\\sqrt{{1}^{2}+{2}^{2}+(-2)^{2}}=\\frac{2}{9}\\sqrt{9}=\\frac{2\\cdot 3}{9}=\\frac{2}{3}\\end{aligned}\n$$\n\nFinally, the radius of curvature at $r(0)$ is\n\n$$\n\\begin{aligned}R(0) & =\\frac{‖{r}^{′}(0)‖}{‖{T}^{′}(0)‖}=\\frac{3}{(\\frac{2}{3})}=\\frac{3\\cdot 3}{2}=\\frac{9}{2}\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186492055 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1060224c-d0b3-5776-a766-96b15404205d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(2,0)$ and the radius is $2$" :db/id #edb/ref 17592186491485} {:answer/id #uuid "28349558-5db2-5c09-8b29-f853f31f0913" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(2,0)$ and the radius is $4$" :db/id #edb/ref 17592186491537} {:answer/id #uuid "31280857-9970-5bf7-888c-fc39c357541b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(2,2)$ and the radius is $\\sqrt{2}$" :db/id #edb/ref 17592186491551} {:answer/id #uuid "5611b291-95d5-535d-999e-5155c671c2b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(-2,0)$ and the radius is $2$" :db/id #edb/ref 17592186491619} {:answer/id #uuid "910409ee-6695-5f67-a309-77a3fe4d5eb9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(0,2)$ and the radius is $2$" :db/id #edb/ref 17592186491701}] :answer-field/correct {:answer/id #uuid "1060224c-d0b3-5776-a766-96b15404205d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(2,0)$ and the radius is $2$" :db/id #edb/ref 17592186491485} :answer-field/id #uuid "7fa7d73e-6b11-5043-84cc-72ac6b11b133" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491930}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cb82f4d9-80ff-57cb-8e48-0da61beda250" :question/math-academy-id "q-97585" :question/problem "Find the center and radius of the osculating circle to the curve $r(t)$ at the point $P(2,2)$ where $t=2$, given that $‖{r}^{′}(2)‖=1,$ and the unit tangent vector to the curve is\n\n$$\nT(t)=⟨\\frac{\\sqrt{4t-{t}^{2}}}{2},\\,\\frac{2-t}{2}⟩.\n$$" :question/worked-solution "Since we are given both the value of $‖{r}^{′}(2)‖$ and the unit tangent $T(t)$, we will use the following formula for the radius of curvature:\n\n$$\nR(t)=\\frac{1}{κ(t)}=\\frac{‖{r}^{′}(t)‖}{‖{T}^{′}(t)‖}\n$$\n\nNotice that $r(2)=⟨2,2⟩,$ since the point $P(2,2)$ is at the tip of $r(2).$ \n\nNow, we find ${T}^{′}(t),$ ${T}^{′}(2)$ and $‖{T}^{′}(2)‖:$\n\n$$\n\\begin{aligned}{T}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\frac{\\sqrt{4t-{t}^{2}}}{2}),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{2-t}{2})⟩ \\\\  & =⟨\\frac{2-t}{2\\sqrt{4t-{t}^{2}}},\\,-\\frac{1}{2}⟩ \\\\ {T}^{′}(2) & =⟨\\frac{2-2}{2\\sqrt{4(2)-{2}^{2}}},\\,-\\frac{1}{2}⟩=⟨0,\\,-\\frac{1}{2}⟩ \\\\ ‖{T}^{′}(2)‖ & =\\sqrt{{0}^{2}+{(\\frac{1}{2})}^{2}}=\\frac{1}{2}\\end{aligned}\n$$\n\nHence, the radius of curvature is\n\n$$\n\\begin{aligned}R(2) & =\\frac{‖{r}^{′}(2)‖}{‖{T}^{′}(2)‖}=\\frac{1}{(\\frac{1}{2})}=2.\\end{aligned}\n$$\n\nNext, we find the principal normal vector at $t=2$ as\n\n$$\n\\begin{aligned}N(2) & =\\frac{{T}^{′}(2)}{‖{T}^{′}(2)‖}=\\frac{1}{(\\frac{1}{2})}⟨0,\\,-\\frac{1}{2}⟩=⟨0,-1⟩.\\end{aligned}\n$$\n\nFinally, the center of the osculating circle is given by\n\n$$\n\\begin{aligned}r(2)+R(2)N(2) & =⟨2,2⟩+2⟨0,-1⟩=⟨2,0⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186492060 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e9418b6-f97a-56c0-a5f8-cb663c2070de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186491482} {:answer/id #uuid "1e609f4f-6be3-5c74-b9cf-1200ed558b19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8}{5}" :db/id #edb/ref 17592186491517} {:answer/id #uuid "234a9c24-6945-5264-98b6-b6c065eb22c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{5}" :db/id #edb/ref 17592186491527} {:answer/id #uuid "74cdbe9e-bfc8-55b1-addc-c01619e14194" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186491661} {:answer/id #uuid "ba55a64c-3c7e-522a-800b-186dd45e7f5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{5}" :db/id #edb/ref 17592186491774}] :answer-field/correct {:answer/id #uuid "0e9418b6-f97a-56c0-a5f8-cb663c2070de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186491482} :answer-field/id #uuid "462ba4b0-a9c1-5d72-894e-ca9fc93df274" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491908}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cfee0347-870f-5cb0-bd74-a4488b93243b" :question/math-academy-id "q-83944" :question/problem "Using the change of variables \n\n$$\nu=x-y,\\,v=y,\n$$\n\ncalculate the area of the finite region $D$ bounded by the curve $y+(x-y)^{4}=3$ and the line $y=2.$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$  \n\nNote that the changes of variables\n\n$$\nu=x-y,\\,v=y\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required area, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nSubstituting $x-y=u$ and $y=v$ into the equation of the first curve, we get\n\n$$\n\\begin{aligned}y+(x-y)^{4}=3\\,⟹\\,v+{u}^{4}=3\\,⟹\\,v=3-{u}^{4},\\end{aligned}\n$$\n\nwhile substituting $y=v$ into the equation of the second curve, we obtain\n\n$$\n\\begin{aligned}y=2\\,⟹\\,v=2.\\end{aligned}\n$$\n\nTo find the intersections of the curves in the $uv$-plane, we solve the following system:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}v &=3-{u}^{4} \\\\ v &=2\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}u &=\\pm 1 \\\\ v &=2.\\end{aligned}\\right.\\end{aligned}\n$$\n\nSo, the intersection points are $(\\pm 1,2).$\n\nTherefore, our domain in the $uv$-plane has the type I representation\n\n$$\nΔ=\\{(u,v)\\,:\\,-1\\le u\\le 1,\\,2\\le v\\le 3-{u}^{4}\\}.\n$$\n\n![](images/81/81ff220903cbe53cebf5e8f8b704e2a316be6092e1f14e527a7321e8f61bffb8.png)\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & -1 \\\\ 0 & 1\\end{vmatrix} \\\\  & =1.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}=(1)^{-1}=1.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|1|\\text{d}u\\text{d}v \\\\  & ={\\int }_{-1}^{1}[{\\int }_{2}^{3-{u}^{4}}\\,dv]du \\\\  & ={\\int }_{-1}^{1}[v]_{2}^{3-{u}^{4}}\\,du \\\\  & ={\\int }_{-1}^{1}((3-{u}^{4})-2)\\,du \\\\  & ={\\int }_{-1}^{1}(1-{u}^{4}))\\,du \\\\  & ={[u-\\frac{{u}^{5}}{5}]}_{-1}^{1} \\\\  & =2-\\frac{2}{5} \\\\  & =\\frac{8}{5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186492063 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ab4b08a-d977-567f-a04e-d43ed9d2d0a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186491542} {:answer/id #uuid "94243889-413b-535c-af6b-ce9f8dfb1709" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186491706} {:answer/id #uuid "b4ac3fa8-e528-579d-ad93-0c93644320df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186491767} {:answer/id #uuid "e10f8c74-4f85-5c66-896d-c5e8857bd026" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3" :db/id #edb/ref 17592186491836} {:answer/id #uuid "ff3ff714-7cca-5ae3-9331-6463299a095b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186491885}] :answer-field/correct {:answer/id #uuid "2ab4b08a-d977-567f-a04e-d43ed9d2d0a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186491542} :answer-field/id #uuid "9fcb4a03-8da4-5422-b391-06e26dc1be4c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491950}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dcce5a2c-ee13-5e17-858d-468f144adb26" :question/math-academy-id "q-160892" :question/problem "Using the change of variables\n\n$$\nu=\\frac{{x}^{2}}{y},\\,v=xy,\n$$\n\ncalculate the area of the finite region $D$ in the first quadrant bounded by the curves\n\n$$\ny={x}^{2},\\,y=\\frac{{x}^{2}}{3},\\,y=\\frac{2}{x},\\,y=\\frac{4}{x}.\n$$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$  \n\nNote that the changes of variables\n\n$$\nu=\\frac{{x}^{2}}{y},\\,v=xy\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required area, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nWe substitute $u=\\frac{{x}^{2}}{y}$ into the equations of the first and second curves:\n\n$$\n\\begin{aligned} & y={x}^{2} & ⟹\\, & \\frac{{x}^{2}}{y}=1 & ⟹\\, & u=1 \\\\  & y=\\frac{{x}^{2}}{3} & ⟹\\, & \\frac{{x}^{2}}{y}=3 & ⟹\\, & u=3\\end{aligned}\n$$\n\nAnd we substitute $v=xy$ into the equations of the third and fourth curves:\n\n$$\n\\begin{aligned} & y=\\frac{2}{x} & ⟹\\, & xy=2 & ⟹\\, & v=2 \\\\  & y=\\frac{4}{x} & ⟹\\, & xy=4 & ⟹\\, & v=4\\end{aligned}\n$$\n\nTherefore, our domain in the $uv$-plane is the following rectangle:\n\n$$\nΔ=\\{(u,v)\\,:\\,1\\le u\\le 3,\\,2\\le v\\le 4\\}\n$$\n\n![](images/12/1207d8cdb8afd7c55d712caca043edfe9f0d0395343a6cbd329cf5861ec3bce7.png)\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}\\frac{2x}{y} & -\\frac{{x}^{2}}{{y}^{2}} \\\\ y & \\text{ }\\text{ }x\\end{vmatrix} \\\\  & =\\frac{3{x}^{2}}{y}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}=\\frac{y}{3{x}^{2}}=\\frac{1}{3u}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|\\frac{1}{3u}|\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{1}^{3}{\\int }_{2}^{4}\\frac{1}{u}\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{1}^{3}\\frac{1}{u}\\,\\text{d}u{\\int }_{2}^{4}\\,\\text{d}v \\\\  & =\\frac{1}{3}\\cdot (\\operatorname{ln}⁡3-\\operatorname{ln}⁡1)\\cdot (4-2) \\\\  & =\\frac{2}{3}\\operatorname{ln}⁡3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186492847 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1443b175-b2e6-58e7-9266-46bb002bf1d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186492252} {:answer/id #uuid "731bab39-0cc7-53b5-8a98-4114c8993795" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186492446} {:answer/id #uuid "8aefa18a-70e2-59eb-a0e8-c4294cece2a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186492493} {:answer/id #uuid "92f9cac9-b592-5ea1-b5f0-997e20fedd02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186492503} {:answer/id #uuid "ffe75c90-a8f8-5625-9747-315993606532" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186492704}] :answer-field/correct {:answer/id #uuid "8aefa18a-70e2-59eb-a0e8-c4294cece2a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186492493} :answer-field/id #uuid "9c481d0c-6bec-5a2b-817b-51131184fbf0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492765}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "33d92120-f62e-56e8-8525-dfbf23370577" :question/math-academy-id "q-143978" :question/problem "In a hardware store, there are three boxes containing light bulbs. Box $A$ contains $15$ bulbs, of which $2$ are defective, and box $B$ contains $10$ bulbs, of which $1$ is defective. A box is selected at random, and a bulb is randomly chosen from the box. If the probability that the selected bulb is defective is $\\frac{2}{15},$ what is the probability that a randomly selected bulb from box $C$ is defective?" :question/worked-solution "Let $D$ be the event of selecting a defective bulb at random from one of the three boxes, and   \n\n- let $A$ be the event that the bulb is from box $A,$\n\n- let $B$ be the event that the bulb is  from box $B$\n\n- let $C$ be the event that the bulb is from box $C.$\n\nThen the disjoint union $A⊔B⊔C$ covers the entire sample space. \n\nTo calculate the probability of selecting a defective bulb, we can use the law of total probability: \n\n$$\n\\begin{aligned}P(D) & =P(D\\cap A)+P(D\\cap B)+P(D\\cap C) \\\\  & =P(D|A)P(A)+P(D|B)P(B)+P(D|C)P(C)\\end{aligned}\n$$\n\nLet's go through the problem statement and translate each piece of information into mathematical notation. \n\n- Since a box is chosen at random, we have\n\n$$\nP(A)=P(B)=P(C)=\\frac{1}{3}.\n$$\n\n- Since there are $2$ defective bulbs out of $15$  in box $A$ and  $1$ defective bulb out of $10$ in box $B,$  we have \n\n$$\nP(D|A)=\\frac{2}{15},\\,P(D|B)=\\frac{1}{10}.\n$$\n\n- Since the probability that a randomly selected bulb is defective is $\\frac{2}{15},$ we have\n\n$$\nP(D)=\\frac{2}{15}.\n$$\n\nSubstituting the above information into the law of total probability and solving for $P(D|C),$ we get\n\n$$\n\\begin{aligned}P(D) & =P(D|A)P(A)+P(D|B)P(B)+P(D|C)P(C) \\\\ \\frac{2}{15} & =(\\frac{2}{15})(\\frac{1}{3})+(\\frac{1}{10})(\\frac{1}{3})+P(D|C)(\\frac{1}{3}) \\\\ \\frac{2}{15} & =\\frac{2}{45}+\\frac{1}{30}+\\frac{1}{3}P(D|C) \\\\ \\frac{1}{3}P(D|C) & =\\frac{1}{18} \\\\ P(D|C) & =\\frac{1}{6}\\end{aligned}\n$$\n\nTherefore, the probability that a randomly selected bulb from box $C$ is defective is $\\frac{1}{6}.$"} {:db/id #edb/ref 17592186492864 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0137f30f-c4b4-5de7-a5d4-72a46531a94a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(-\\frac{1}{2})}^{-6}" :db/id #edb/ref 17592186492223} {:answer/id #uuid "2de5131b-c579-5eaa-8ba7-20dc25d1c1f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(-\\frac{1}{2})}^{27}" :db/id #edb/ref 17592186492314} {:answer/id #uuid "7786ba85-2127-524c-a767-d60d6b2bb87b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(-\\frac{1}{2})}^{12}" :db/id #edb/ref 17592186492457} {:answer/id #uuid "e7a8a223-535c-57ef-a2ba-3a749b82f533" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{1}{4})}^{27}" :db/id #edb/ref 17592186492667} {:answer/id #uuid "f7005e97-3703-5539-b3b9-a37a76aeb8c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{1}{4})}^{12}" :db/id #edb/ref 17592186492693}] :answer-field/correct {:answer/id #uuid "7786ba85-2127-524c-a767-d60d6b2bb87b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(-\\frac{1}{2})}^{12}" :db/id #edb/ref 17592186492457} :answer-field/id #uuid "f006c033-0938-5041-a9f8-751ae8378869" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492809}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5e868859-21b4-5f20-9f22-0cddcbf3cad1" :question/math-academy-id "q-68298" :question/problem "${(-\\frac{1}{2})}^{3}\\times {(-\\frac{1}{2})}^{9}=$" :question/worked-solution "To multiply powers of the same base, we add the exponents:\n\n$$\n{(-\\frac{1}{2})}^{3}\\times {(-\\frac{1}{2})}^{9}={(-\\frac{1}{2})}^{3+9}={(-\\frac{1}{2})}^{12}\n$$"} {:db/id #edb/ref 17592186492897 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d988b357-b43a-58eb-bbe9-becb7fce6217" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{64}{9}" :db/id #edb/ref 17592186492645}] :answer-field/correct {:answer/id #uuid "d988b357-b43a-58eb-bbe9-becb7fce6217" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{64}{9}" :db/id #edb/ref 17592186492645} :answer-field/id #uuid "5e0ef91f-d81a-563a-9329-dff79e2beb86" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186492742}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b192b645-98ae-5323-9ecd-f711bb8584a4" :question/math-academy-id "q-166825" :question/problem "Expressed as an improper fraction, Catherine has$\\,${{field-1}}\n$\\,$liters of alcohol." :question/worked-solution "The exact amount of alcohol is ${(\\frac{8}{3})}^{2}$ liters.\n\nWriting ${(\\frac{8}{3})}^{2}$ with multiplication signs, we get\n\n$$\n\\begin{aligned}{(\\frac{8}{3})}^{2} & =\\underbrace{\\frac{8}{3}\\times \\frac{8}{3}}_{2\\text{ times}} \\\\  & =\\frac{8\\times 8}{3\\times 3} \\\\  & =\\frac{64}{9}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{(\\frac{8}{3})}^{2}=\\frac{64}{9}.\n$$"} {:db/id #edb/ref 17592186492926 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "168bd404-2959-5371-bc5c-7fbba3473aa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1+\\sqrt{6}" :db/id #edb/ref 17592186492259}] :answer-field/correct {:answer/id #uuid "168bd404-2959-5371-bc5c-7fbba3473aa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1+\\sqrt{6}" :db/id #edb/ref 17592186492259} :answer-field/id #uuid "34e53936-bbb9-5fb0-9b7e-e35958cdf4b9" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186492726} {:answer-field/choices [{:answer/id #uuid "46bda047-ac5b-540d-b339-64ed2abef508" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1-\\sqrt{6}" :db/id #edb/ref 17592186492357}] :answer-field/correct {:answer/id #uuid "46bda047-ac5b-540d-b339-64ed2abef508" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1-\\sqrt{6}" :db/id #edb/ref 17592186492357} :answer-field/id #uuid "b06a318c-820e-5ff0-97ca-8c71655f9348" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186492775}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f822983e-1d14-50b6-989d-68e7f1c76860" :question/math-academy-id "q-240667" :question/problem "![](images/ac/ac9ee9825678ad3ba815204c39ac2fe4ea85972cc60458251fcc9e9fdb4ba0f7.png)\n\n**From left to right**, the **exact values** of the $x$-intercepts of the parabola shown above are{{field-1}}and{{field-2}}." :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(-1,3)$ and passes through the point $(-2,\\frac{5}{2}).$\n\nThe general standard equation of an up- or down-opening parabola with vertex $(h,k)$ is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nSubstituting $(h,k)=(-1,3)$ into the above gives\n\n$$\n\\begin{aligned}(x+1)^{2} & =4p(y-3).\\end{aligned}\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(-2,\\frac{5}{2}),$ we substitute $x=-2$ and $y=\\frac{5}{2}$ into the equation and get\n\n$$\n\\begin{aligned}(-2+1)^{2} & =4p(\\frac{5}{2}-3) \\\\ (-1)^{2} & =4p(-\\frac{1}{2}) \\\\ 1 & =-2p \\\\ p & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(x+1)^{2} & =-2(y-3).\\end{aligned}\n$$\n\nWhen the parabola intersects the $x$-axis, we must have $y=0.$ So, we substitute $y=0$ into the equation of the parabola and solve for $x:$\n\n$$\n\\begin{aligned}(x+1)^{2} & =-2(0-3) \\\\ (x+1)^{2} & =6 \\\\ x+1 & =\\pm \\sqrt{6} \\\\ x & =-1\\pm \\sqrt{6}\\end{aligned}\n$$\n\nTherefore, from left to right, the $x$-intercepts are $-1-\\sqrt{6}$ and $-1+\\sqrt{6}.$"} {:db/id #edb/ref 17592186492928 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d6f31a7-12c7-533a-a616-32df997a304f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186492237}] :answer-field/correct {:answer/id #uuid "0d6f31a7-12c7-533a-a616-32df997a304f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186492237} :answer-field/id #uuid "6377b71b-3301-54ad-85e4-81211618a817" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186492747} {:answer-field/choices [{:answer/id #uuid "1d14f365-3431-51a2-85f1-fb6aa4f3083e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186492273}] :answer-field/correct {:answer/id #uuid "1d14f365-3431-51a2-85f1-fb6aa4f3083e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186492273} :answer-field/id #uuid "d11afbdb-9351-5d55-af3d-0ebc6b7799e3" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186492790}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fdc8ed74-44a5-549d-abf7-39e6c995f550" :question/math-academy-id "q-251773" :question/problem "![](images/75/7515041ccdceb8d13e4e718bda12af7535cfbb4a37b0180b04f88a08db4947b2.png)\n\n**From left to right**, the values of the $x$-intercepts of the parabola shown above are{{field-1}}\nand \n{{field-2}}." :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(3,-1)$ and passes through the point $(0,\\frac{5}{4}).$\n\nThe general standard equation of an up- or down-opening parabola with vertex $(h,k)$ is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nSubstituting $(h,k)=(3,-1)$ into the above gives\n\n$$\n\\begin{aligned}(x-3)^{2} & =4p(y+1).\\end{aligned}\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(0,\\frac{5}{4}),$ we substitute $x=0$ and $y=\\frac{5}{4}$ into the equation and get\n\n$$\n\\begin{aligned}(0-3)^{2} & =4p(\\frac{5}{4}+1) \\\\ 9 & =4p(\\frac{9}{4}) \\\\ p & =1.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(x-3)^{2} & =4(y+1).\\end{aligned}\n$$\n\nWhen the parabola intersects the $x$-axis, we must have $y=0.$ So, we substitute $y=0$ into the equation of the parabola and solve for $x:$\n\n$$\n\\begin{aligned}(x-3)^{2} & =4(0+1) \\\\ (x-3)^{2} & =4 \\\\ x-3 & =\\pm \\sqrt{4} \\\\ x & =\\pm 2+3\\end{aligned}\n$$\n\nTherefore, from left to right, the $x$-intercepts are $1$  and $5.$"} {:db/id #edb/ref 17592186493316 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "028288df-333f-57f2-9e25-7548b283399c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,0)" :db/id #edb/ref 17592186493307} {:answer/id #uuid "30a55d4b-f895-53a5-a364-ce5fddbb6ae1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,0)" :db/id #edb/ref 17592186493310} {:answer/id #uuid "59d2a5db-49a2-566c-afa9-b7bdaafa25da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{376}{25},0)" :db/id #edb/ref 17592186493313} {:answer/id #uuid "66291432-b739-52c2-992c-c3d5906e8d52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(376,0)" :db/id #edb/ref 17592186493314} {:answer/id #uuid "cb3d8d25-8bfa-5e2a-b032-69c3782c0eb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(25,0)" :db/id #edb/ref 17592186493322}] :answer-field/correct {:answer/id #uuid "66291432-b739-52c2-992c-c3d5906e8d52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(376,0)" :db/id #edb/ref 17592186493314} :answer-field/id #uuid "40ab1d54-64ea-58e4-9d91-d527f34b3bee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493312}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7e3f1a4a-bfde-54af-80e2-4cc4e890e6fc" :question/problem "Find where the normal line to the curve $f(x)=10 x^{2} + 5 x$ at the point $(1,15)$ intersects the $x$-axis." :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}f'(x)=\\frac{\\mathrm{d}}{\\mathrm{d}x}(10 x^{2} + 5 x)=20 x + 5.\\end{aligned}\n$$\n\nSo the slope of the tangent line is\n\n$$\nm=f'(1)=25=25,\n$$\n\nand therefore the slope of the normal line is\n\n$$\nm'=-\\frac{1}{m}=-\\frac{1}{(25)}=- \\frac{1}{25}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-(15)&=- \\frac{1}{25}(x-(1))\\\\y&=- \\frac{1}{25}x-(- \\frac{1}{25})+(15)\\\\y&=- \\frac{1}{25}x+\\frac{376}{25}.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $x$-axis by setting $y=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}- \\frac{1}{25}x+\\frac{376}{25}&=0\\\\x&=376.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the $x$-axis at $(376,0).$"} {:db/id #edb/ref 17592186493318 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4079920d-ee6c-5086-9aa8-97eb49b915c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-599" :db/id #edb/ref 17592186493311}] :answer-field/correct {:answer/id #uuid "4079920d-ee6c-5086-9aa8-97eb49b915c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-599" :db/id #edb/ref 17592186493311} :answer-field/id #uuid "24d2eda6-5f52-58d1-8821-c19db30c5bf9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493309} {:answer-field/choices [{:answer/id #uuid "ba9c2120-ea78-56ae-b7da-fc8f913f4ff6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186493320}] :answer-field/correct {:answer/id #uuid "ba9c2120-ea78-56ae-b7da-fc8f913f4ff6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186493320} :answer-field/id #uuid "a11eaf98-7e1d-530f-93f1-50c6c3aa85a7" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493319}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9c1268dd-9a0b-5590-983e-596506fe3286" :question/problem "Find where the normal line to the curve $y=\\frac{20}{x}+10$ at the point $(1,30)$ intersects the $x$-axis.\n\nThe normal line intersects the $x$-axis at\n$($\n{{field-1}}$,$\n{{field-2}} $).$" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}f'(x)&=\\frac{\\mathrm{d}}{\\mathrm{d}x}(\\frac{20}{x}+10)\\\\&=\\frac{\\mathrm{d}}{\\mathrm{d}x}(10 + \\frac{20}{x})\\\\&=-20x^{-2}\\\\&=- \\frac{20}{x^{2}}.\\end{aligned}\n$$\n\nSo the slope of the tangent line is\n\n$$\nm=f'(1)=-20=-20,\n$$\n\nand therefore the slope of the normal line is\n\n$$\nm'=-\\frac{1}{m}=-\\frac{1}{(-20)}=\\frac{1}{20}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-(30)&=\\frac{1}{20}(x-(1))\\\\y&=\\frac{1}{20}x-(\\frac{1}{20})+(30)\\\\y&=\\frac{1}{20}x+\\frac{599}{20}.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $x$-axis by setting $y=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}\\frac{1}{20}x+\\frac{599}{20}&=0\\\\x&=-599.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the  $x$-axis at $(-599,0).$"} {:db/id #edb/ref 17592186493343 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7da44a5d-35ed-5356-acb1-747326fd7e62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- e^{6}" :db/id #edb/ref 17592186493347} {:answer/id #uuid "5899971b-fb4c-4982-a90e-99923b6cd70f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-e^6" :db/id #edb/ref 17592186577405}] :answer-field/correct {:answer/id #uuid "7da44a5d-35ed-5356-acb1-747326fd7e62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- e^{6}" :db/id #edb/ref 17592186493347} :answer-field/id #uuid "bfb8d739-6087-5cb0-989a-1441bdf28bf6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493362}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "602e8cc0-02ef-5eee-abee-b6d55a9699a0" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=4y,\\,y(- \\frac{3}{2})=-1.\n$$\n\nYou're given that $y=A{e}^{4x}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=A{e}^{4x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(- \\frac{3}{2})=-1.$\n\nSubstituting the initial condition $y(- \\frac{3}{2})=-1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{e}^{4x} \\\\ -1 & =A{e}^{4\\cdot (- \\frac{3}{2})} \\\\ -1 & =A{e}^{-6} \\\\ \\frac{-1}{{e}^{-6}} & =A \\\\ A & =\\frac{-1}{{e}^{-6}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493353 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61ba7b7d-5f48-5e29-965c-04ab9aa08574" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^{2}}{3}" :db/id #edb/ref 17592186493345}] :answer-field/correct {:answer/id #uuid "61ba7b7d-5f48-5e29-965c-04ab9aa08574" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^{2}}{3}" :db/id #edb/ref 17592186493345} :answer-field/id #uuid "b0151b1c-1e8e-5b0e-a19d-1ee0bcc76c89" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493358}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8c629d7f-f88e-5741-a882-820e35768d0a" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-4y,\\,y(\\frac{1}{2})=\\frac{1}{3}.\n$$\n\nYou're given that $y=A{e}^{-4x}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=A{e}^{-4x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(\\frac{1}{2})=\\frac{1}{3}.$\n\nSubstituting the initial condition $y(\\frac{1}{2})=\\frac{1}{3}$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{e}^{-4x} \\\\ \\frac{1}{3} & =A{e}^{-4\\cdot \\frac{1}{2}} \\\\ \\frac{1}{3} & =A{e}^{-2} \\\\ \\frac{\\frac{1}{3}}{{e}^{-2}} & =A \\\\ A & =\\frac{\\frac{1}{3}}{{e}^{-2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493355 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82bc69d2-5af8-5703-b435-2396b81f7637" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^{\\frac{3}{2}}}{3}" :db/id #edb/ref 17592186493348} {:answer/id #uuid "a1b6b0df-de04-42ac-aa0d-e31817bf10ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^{\\frac32}}{3}" :db/id #edb/ref 17592186577403}] :answer-field/correct {:answer/id #uuid "82bc69d2-5af8-5703-b435-2396b81f7637" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^{\\frac{3}{2}}}{3}" :db/id #edb/ref 17592186493348} :answer-field/id #uuid "e78f8914-c568-5d01-8afc-57d32ce156cc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493363}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a76133ad-ea1c-5ff4-8da8-4b052e2debb0" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=3y,\\qquad y(- \\frac{1}{2})=\\frac{1}{3}.\n$$\n\nYou're given that $y=A{e}^{3x}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=A{e}^{3x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(- \\frac{1}{2})=\\frac{1}{3}.$\n\nSubstituting the initial condition $y(- \\frac{1}{2})=\\frac{1}{3}$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{e}^{3x} \\\\ \\frac{1}{3} & =A{e}^{3\\cdot (- \\frac{1}{2})} \\\\ \\frac{1}{3} & =A{e}^{- \\frac{3}{2}} \\\\ \\frac{\\frac{1}{3}}{{e}^{- \\frac{3}{2}}} & =A \\\\ A & =\\frac{\\frac{1}{3}}{{e}^{- \\frac{3}{2}}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493364 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bbf7abd5-bfb9-5aba-b550-2a9cc3191d8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{- \\frac{9}{2}}" :db/id #edb/ref 17592186493361}] :answer-field/correct {:answer/id #uuid "bbf7abd5-bfb9-5aba-b550-2a9cc3191d8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{- \\frac{9}{2}}" :db/id #edb/ref 17592186493361} :answer-field/id #uuid "54305a96-48f3-5ac5-87e2-b0b6556ff912" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493342}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eded91b2-b55d-56c3-bb62-6b902c3a464d" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=3y,\\,y(\\frac{3}{2})=1.\n$$\n\nYou're given that $y=A{e}^{3x}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=A{e}^{3x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(\\frac{3}{2})=1.$\n\nSubstituting the initial condition $y(\\frac{3}{2})=1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{e}^{3x} \\\\ 1 & =A{e}^{3\\cdot \\frac{3}{2}} \\\\ 1 & =A{e}^{\\frac{9}{2}} \\\\ \\frac{1}{{e}^{\\frac{9}{2}}} & =A \\\\ A & =\\frac{1}{{e}^{\\frac{9}{2}}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493365 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "403d95ef-a3ea-56f1-82e2-7d2f7984f37f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 e^{6}" :db/id #edb/ref 17592186493340}] :answer-field/correct {:answer/id #uuid "403d95ef-a3ea-56f1-82e2-7d2f7984f37f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 e^{6}" :db/id #edb/ref 17592186493340} :answer-field/id #uuid "857b5124-dc03-509b-99e1-e4e90f0a3036" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493349}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ef863447-fa5f-590c-8056-4768c8c0285e" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-4y,\\,y(\\frac{3}{2})=3.\n$$\n\nYou're given that $y=A{e}^{-4x}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=A{e}^{-4x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(\\frac{3}{2})=3.$\n\nSubstituting the initial condition $y(\\frac{3}{2})=3$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{e}^{-4x} \\\\ 3 & =A{e}^{-4\\cdot \\frac{3}{2}} \\\\ 3 & =A{e}^{-6} \\\\ \\frac{3}{{e}^{-6}} & =A \\\\ A & =\\frac{3}{{e}^{-6}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493892 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cbd15cf-50e0-5f6c-a023-66b7777a5ea1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186493467}] :answer-field/correct {:answer/id #uuid "2cbd15cf-50e0-5f6c-a023-66b7777a5ea1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186493467} :answer-field/id #uuid "77156935-a293-5f77-b17e-01ad81fabeda" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493837}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "03b02208-a47d-5484-9a1d-0e9d1a5e06da" :question/math-academy-id "q-186156" :question/problem "Evaluate the following:\n\n$\\sqrt[3]{\\frac{125}{8}}=$\n{{field-1}}" :question/worked-solution "First, notice that the numbers $125$ and $8$ are both perfect cubes. \n\nSo, to determine the value of $\\sqrt[3]{\\frac{125}{8}},$ we express $\\frac{125}{8}$ as a perfect cube:\n\n$$\n\\begin{aligned}\\sqrt[3]{\\frac{125}{8}} &= \\sqrt[3]{\\frac{{5}^{3}}{{2}^{3}}} \\\\ &= \\sqrt[3]{\\frac{5\\cdot 5\\cdot 5}{2\\cdot 2\\cdot 2}} \\\\ &= \\sqrt[3]{\\frac{5}{2}\\cdot \\frac{5}{2}\\cdot \\frac{5}{2}} \\\\ &= \\sqrt[3]{{(\\frac{5}{2})}^{3}} \\\\ &= \\frac{5}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493898 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f57cbe6e-ad50-582d-89c2-10cdef51ceda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14.01" :db/id #edb/ref 17592186493788}] :answer-field/correct {:answer/id #uuid "f57cbe6e-ad50-582d-89c2-10cdef51ceda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14.01" :db/id #edb/ref 17592186493788} :answer-field/id #uuid "8c01aeff-128f-59ee-875c-e17680c52732" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493846}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1b9f0001-1223-5b0c-bd32-5cd32bc54dbc" :question/math-academy-id "q-325131" :question/problem "The weekly exercise time for a community is normally distributed with a mean of $\\mu $ minutes and a standard deviation of $30$ minutes. Additionally, $60%$ of people exercise between $0.9\\mu $ minutes and $1.1\\mu $ minutes each week. Find the percentage of people who exercise less than $220$ minutes per week. **Round your answer to two decimal places.**\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $p$ | $\\,0.75\\,$ | $\\,0.80\\,$ | $\\,0.85\\,$ | $\\,0.90\\,$ | $\\,0.95\\,$ |\n| --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,0.6745\\,$ | $\\,0.8416\\,$ | $\\,1.0364\\,$ | $\\,1.2816\\,$ | $\\,1.6449\\,$ |\n\n$$\n\n$$\n\n*In addition, you're given the following table of values for $p=Φ(z)$*.\n\n| $z$ | $\\,0.07\\,$ | $\\,0.08\\,$ | $\\,0.09\\,$ |\n| --- | --- | --- | --- |\n| $\\,-1.2\\,$ | $\\,0.1020\\,$ | $\\,0.1003\\,$ | $\\,0.0985\\,$ |\n| $\\,-1.1\\,$ | $\\,0.1210\\,$ | $\\,0.1190\\,$ | $\\,0.1170\\,$ |\n| $\\,-1.0\\,$ | $\\,0.1423\\,$ | $\\,0.1401\\,$ | $\\,0.1379\\,$ |\n\nApproximately\n{{field-1}}$%$ of the people exercise less than $220$ minutes per week." :question/worked-solution "Let $X$ represent the weekly exercise time of a randomly selected person. Then we have $X∼N(\\mu ,{30}^{2}),$ and we want to find $P(X<220).$ But first, we need to find the mean $\\mu .$ \n\nWe know that $P(0.9\\mu <X<1.1\\mu )=0.60.$ First, we convert this to a cumulative probability:\n\n$$\n\\begin{aligned}P(0.9\\mu <X<1.1\\mu ) & =0.60 \\\\ 2P(\\mu <X<1.1\\mu ) & =0.60 \\\\ P(\\mu <X<1.1\\mu ) & =0.30 \\\\ P(X<\\mu )+P(\\mu <X<1.1\\mu ) & =0.5+0.30 \\\\ P(X<1.1\\mu ) & =0.80\\end{aligned}\n$$\n\nNext, we convert $X$ to a standard normal random variable by $z$-scoring. We get\n\n$$\n\\begin{aligned}P(X<1.1\\mu ) & =0.80 \\\\ P(Z<\\frac{0.1\\mu }{30}) & =0.80 \\\\ Φ(\\frac{0.1\\mu }{30}) & =0.80 \\\\ \\frac{0.1\\mu }{30} & ={Φ}^{-1}(0.80).\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.80)=0.8416.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{0.1\\mu }{30} & =0.8416 \\\\ 0.1\\mu  & =25.248 \\\\ \\mu  & =\\frac{25.248}{0.1} \\\\  & ≈252.48.\\end{aligned}\n$$\n\nFinally, we can solve for $P(X<220)$ as follows:\n\n$$\n\\begin{aligned}P(X<220) & =P(Z<\\frac{220-252.48}{30}) \\\\  & ≈P(Z<-1.08) \\\\  & =Φ(-1.08) \\\\  & =0.1401 \\\\  & ≈14.01%\\end{aligned}\n$$\n\nTherefore, approximately $14.01%$ of the people exercise less than $220$ minutes per week."} {:db/id #edb/ref 17592186493899 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f0e3978-3b5e-5638-9311-f13888ad9b43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.5%" :db/id #edb/ref 17592186493469} {:answer/id #uuid "87afa8e3-be2d-5fe5-9004-6f754bddfb6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.0%" :db/id #edb/ref 17592186493603} {:answer/id #uuid "9ee59e46-909a-577c-8aa1-de2ccae7ced6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.8%" :db/id #edb/ref 17592186493640} {:answer/id #uuid "acddec27-a38b-590b-a933-a99f67c9b55a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.3%" :db/id #edb/ref 17592186493663} {:answer/id #uuid "ea700cff-a6a3-5424-8a11-9d55e191fcfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.9%" :db/id #edb/ref 17592186493766}] :answer-field/correct {:answer/id #uuid "2f0e3978-3b5e-5638-9311-f13888ad9b43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.5%" :db/id #edb/ref 17592186493469} :answer-field/id #uuid "cc6a12d1-cfbc-5af0-9418-2c899316c53c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493876}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1e826c15-fd0c-50c0-b8b3-b16460ce62c6" :question/math-academy-id "q-95073" :question/problem "A group of students took a test and got an average score of $81.$ Additionally, $5%$ of the students scored greater than $91.$ Assuming that the students' scores are normally distributed, find the percent of students with a score lower than $70,$ rounded to $1$ decimal place.\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $p$ | $\\,0.900\\,$ | $\\,0.950\\,$ | $\\,0.975\\,$ | $\\,0.990\\,$ | $\\,0.995\\,$ | $\\,0.999\\,$ | $\\,0.9995\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,1.2816\\,$ | $\\,1.6449\\,$ | $\\,1.9600\\,$ | $\\,2.3263\\,$ | $\\,2.5758\\,$ | $\\,3.0902\\,$ | $\\,3.2905\\,$ |\n\n$$\n\n$$\n\n*In addition, you're given the following table of values for $p=Φ(z)$*.\n\n| $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ |\n| --- | --- | --- | --- |\n| $\\,-1.9\\,$ | $\\,0.0287\\,$ | $\\,0.0281\\,$ | $\\,0.0274\\,$ |\n| $\\,-1.8\\,$ | $\\,0.0359\\,$ | $\\,0.0351\\,$ | $\\,0.0344\\,$ |\n| $\\,-1.7\\,$ | $\\,0.0446\\,$ | $\\,0.0436\\,$ | $\\,0.0427\\,$ |" :question/worked-solution "Let $X$ represent the grade obtained by a student. Then we have $X∼N(81,{\\sigma }^{2}),$ and we want to find $P(X<70).$ But first, we need to find the standard deviation $\\sigma .$ \n\nWe know that $P(X>91)=0.05.$ First, we convert this to a cumulative probability:\n\n$$\n\\begin{aligned}P(X\\le 91) & =1-P(X>91) \\\\  & =1-0.05 \\\\  & =0.95\\end{aligned}\n$$\n\nNext, we convert $X$ to a standard normal random variable by $z$-scoring. We get\n\n$$\n\\begin{aligned}P(X\\le 91) & =0.95 \\\\ P(Z\\le \\frac{91-81}{\\sigma }) & =0.95 \\\\ Φ(\\frac{10}{\\sigma }) & =0.95 \\\\ \\frac{10}{\\sigma } & ={Φ}^{-1}(0.95)\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.95)≈1.6449.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{10}{\\sigma } & =1.6449 \\\\ \\frac{1}{\\sigma } & =0.16449 \\\\ \\sigma  & =\\frac{1}{0.16449} \\\\  & ≈6.0794.\\end{aligned}\n$$\n\nFinally, we can solve for $P(X<70)$ as follows:\n\n$$\n\\begin{aligned}P(X<70) & =P(X\\le 70) \\\\  & =P(Z\\le \\frac{70-81}{6.0794}) \\\\  & ≈P(Z\\le -1.81) \\\\  & =Φ(-1.81) \\\\  & =0.0351 \\\\  & ≈3.5%\\end{aligned}\n$$\n\nTherefore, approximately $3.5%$ of the students scored lower than $70.$"} {:db/id #edb/ref 17592186493917 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04822258-26f6-53c8-944e-465c474e11aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24.2%" :db/id #edb/ref 17592186493396} {:answer/id #uuid "3c7dcc06-7bd8-5a37-9726-5c0772337fd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23.9%" :db/id #edb/ref 17592186493495} {:answer/id #uuid "3da7662f-51f3-5819-88a6-da0d21cda61b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26.9%" :db/id #edb/ref 17592186493496} {:answer/id #uuid "55290d0d-b20c-5db9-a359-89cdf3c54ecf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20.6%" :db/id #edb/ref 17592186493522} {:answer/id #uuid "8afaceac-1ebe-56aa-94bf-2f83f4de4163" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27.1%" :db/id #edb/ref 17592186493608}] :answer-field/correct {:answer/id #uuid "04822258-26f6-53c8-944e-465c474e11aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24.2%" :db/id #edb/ref 17592186493396} :answer-field/id #uuid "553ac2e3-4992-5bf9-a927-8dd39d781081" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493823}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4286abc9-bbfc-5418-a3f8-c44338b9b405" :question/math-academy-id "q-133055" :question/problem "The output voltage of a particular model of laptop AC adapters is $19$ volts on average. However, $1%$ of adapters have a voltage greater than $20$ volts. Assuming that the output voltage is normally distributed, find the percent of AC adapters with a voltage greater than $19.3$ volts, rounded to $1$ decimal place.\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $p$ | $\\,0.900\\,$ | $\\,0.950\\,$ | $\\,0.975\\,$ | $\\,0.990\\,$ | $\\,0.995\\,$ | $\\,0.999\\,$ | $\\,0.9995\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,1.2816\\,$ | $\\,1.6449\\,$ | $\\,1.9600\\,$ | $\\,2.3263\\,$ | $\\,2.5758\\,$ | $\\,3.0902\\,$ | $\\,3.2905\\,$ |\n\n$$\n\n$$\n\n*In addition, you're given the following table of values for $p=Φ(z)$*.\n\n| $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ |\n| --- | --- | --- | --- |\n| $\\,0.6\\,$ | $\\,0.7257\\,$ | $\\,0.7291\\,$ | $\\,0.7324\\,$ |\n| $\\,0.7\\,$ | $\\,0.7580\\,$ | $\\,0.7611\\,$ | $\\,0.7642\\,$ |\n| $\\,0.8\\,$ | $\\,0.7881\\,$ | $\\,0.7910\\,$ | $\\,0.7939\\,$ |" :question/worked-solution "Let $X$ represent the output voltage of a randomly selected AC adapter. Then we have $X∼N(19,{\\sigma }^{2}),$ and we want to find $P(X>19.3).$ But first, we need to find the standard deviation $\\sigma .$ \n\nWe know that $P(X>20)=0.01.$ First, we convert this to a cumulative probability:\n\n$$\n\\begin{aligned}P(X\\le 20) & =1-P(X>20) \\\\  & =1-0.01 \\\\  & =0.99\\end{aligned}\n$$\n\nNext, we convert $X$ to a standard normal random variable by $z$-scoring. We get\n\n$$\n\\begin{aligned}P(X\\le 20) & =0.99 \\\\ P(Z\\le \\frac{20-19}{\\sigma }) & =0.99 \\\\ Φ(\\frac{1}{\\sigma }) & =0.99 \\\\ \\frac{1}{\\sigma } & ={Φ}^{-1}(0.99)\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.99)≈2.3263.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{1}{\\sigma } & =2.3263 \\\\ \\sigma  & =\\frac{1}{2.32639} \\\\  & ≈0.42985.\\end{aligned}\n$$\n\nFinally, we can solve for $P(X>19.3)$ as follows:\n\n$$\n\\begin{aligned}P(X>19.3) & =1-P(X\\le 19.3) \\\\  & =1-P(Z\\le \\frac{19.3-19}{0.42985}) \\\\  & ≈1-P(Z\\le 0.70) \\\\  & =1-Φ(0.70) \\\\  & =1-0.7580 \\\\  & ≈24.2%\\end{aligned}\n$$\n\nTherefore, approximately $24.2%$ of AC adapters have a voltage greater than $19.3$ volts."} {:db/id #edb/ref 17592186493919 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1be8b56-e0bc-581a-9ccb-692511badae8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{19}{8}" :db/id #edb/ref 17592186493679}] :answer-field/correct {:answer/id #uuid "b1be8b56-e0bc-581a-9ccb-692511badae8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{19}{8}" :db/id #edb/ref 17592186493679} :answer-field/id #uuid "f5f4070c-c95c-5ed1-901f-4528153978ca" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493886}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "43534459-b512-57ce-a24a-a07661c93918" :question/math-academy-id "q-352679" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{3/2}\\frac{3{x}^{2}{tan}^{2}⁡x}{{sec}^{2}⁡x-1}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we select the identity that contains a ${tan}^{2}⁡x$ term. So, we can use the identity \n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x.\n$$\n\nRearranging the above identity gives\n\n$$\n{sec}^{2}⁡x-1={tan}^{2}⁡x.\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{3/2}\\frac{3{x}^{2}{tan}^{2}⁡x}{{sec}^{2}⁡x-1}\\,\\text{d}x & ={\\int }_{1}^{3/2}\\frac{3{x}^{2}{tan}^{2}⁡x}{{tan}^{2}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{1}^{3/2}3{x}^{2}\\,\\text{d}x \\\\  & ={x}^{3}\\,{|}_{1}^{3/2} \\\\  & ={(\\frac{3}{2})}^{\\,3}-{1}^{3} \\\\  & =\\frac{27}{8}-1 \\\\  & =\\frac{19}{8}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493923 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "126577ac-3152-598b-9fe4-040ffdbae6e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186493423} {:answer/id #uuid "4ef2a3c3-778f-5c55-8969-0e9611df5e89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186493518} {:answer/id #uuid "79e1cfa8-b203-5b99-beca-b7ab609085ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186493576} {:answer/id #uuid "a9f98c30-eef0-520b-8077-2c5bc53b8e99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186493657} {:answer/id #uuid "e985e777-05bb-502e-8fdf-908a7f9d009f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186493764}] :answer-field/correct {:answer/id #uuid "4ef2a3c3-778f-5c55-8969-0e9611df5e89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186493518} :answer-field/id #uuid "c5176422-5204-53ed-afa1-9ce312f9aff4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493874}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4d8f93db-ca73-5128-94a3-1e0c56cdcf95" :question/math-academy-id "q-162894" :question/problem "Use the method of Lagrange multipliers to find the maximum value of the function $f(x,y,z)=x+2y+3z$ on the intersection of the plane $x-y-z=0$ and the cylinder $4{x}^{2}+{y}^{2}=1.$" :question/worked-solution "We need to find the maximum value of \n\n$$\nf(x,y,z)=x+2y+3z\n$$\n\nsubject to the constraints \n\n$$\ng(x,y,z)=x-y-z=0,\\,h(x,y,z)=4{x}^{2}+{y}^{2}=1.\n$$\n\nSince $f(x,y,z)$ is continuous and the constraint is closed and bounded, $f(x,y,z)$ reaches a global maximum and a global minimum on the constraint. \n\nTherefore, by the method of Lagrange multipliers, we must solve the following system:\n\n$$\n\\left\\{\\begin{aligned}∇f(x,y,z) &=\\lambda ∇g(x,y,z)+\\mu ∇h(x,y,z) \\\\ g(x,y,z) &=0 \\\\ h(x,y,z) &=1\\end{aligned}\\right.\n$$\n\nWe start by expanding the first equation:\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\lambda ∇g(x,y,z)+\\mu ∇h(x,y,z) \\\\ ⟨{f}_{x},{f}_{y},{f}_{z}⟩ & =\\lambda ⟨{g}_{x},{g}_{y},{g}_{z}⟩+\\mu ⟨{h}_{x},{h}_{y},{h}_{z}⟩ \\\\ ⟨1,2,3⟩ & =\\lambda ⟨1,-1,-1⟩+\\mu ⟨8x,2y,0⟩\\end{aligned}\n$$\n\n \n\nTherefore, we have the following system:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}1 &=\\lambda +8\\mu x \\\\ 2 &=-\\lambda +2\\mu y \\\\ 3 &=-\\lambda\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}x &=\\frac{1}{2\\mu } \\\\ y &=-\\frac{1}{2\\mu } \\\\ \\lambda &=-3\\end{aligned}\\right.\\end{aligned}\n$$\n\nNotice that $\\mu $ can't be zero since this leads to a contradiction.\n\nNext, we substitute our expressions for $x$ and $y$ into the second constraint:\n\n$$\n\\begin{aligned}4{x}^{2}+{y}^{2} & =1 \\\\ \\frac{1}{{\\mu }^{2}}+\\frac{1}{4{\\mu }^{2}} & =1 \\\\ \\frac{5}{4{\\mu }^{2}} & =1 \\\\ {\\mu }^{2} & =\\frac{5}{4} \\\\ \\mu  & =\\pm \\frac{\\sqrt{5}}{2}\\end{aligned}\n$$\n\nAs a result, \n\n$$\nx=\\pm \\frac{1}{\\sqrt{5}},\\,y=∓\\frac{1}{\\sqrt{5}}.\n$$\n\nFinally, we substitute $x$ and $y$ into the first constraint:\n\n- If $x=\\frac{1}{\\sqrt{5}}$ and $y=-\\frac{1}{\\sqrt{5}},$ we have\n\n$$\n\\begin{aligned}x-y-z & =0 \\\\ \\frac{1}{\\sqrt{5}}-(-\\frac{1}{\\sqrt{5}})-z & =0 \\\\ z & =\\frac{2}{\\sqrt{5}}.\\end{aligned}\n$$\n\n- If $x=-\\frac{1}{\\sqrt{5}}$ and $y=\\frac{1}{\\sqrt{5}},$ we have\n\n$$\n\\begin{aligned}x-y-z & =0 \\\\ -\\frac{1}{\\sqrt{5}}-(\\frac{1}{\\sqrt{5}})-z & =0 \\\\ z & =-\\frac{2}{\\sqrt{5}}.\\end{aligned}\n$$\n\nTherefore, $f$ has possible extreme values at the points\n\n$$\n(\\frac{1}{\\sqrt{5}},-\\frac{1}{\\sqrt{5}},\\frac{2}{\\sqrt{5}}),\\,(-\\frac{1}{\\sqrt{5}},\\frac{1}{\\sqrt{5}},-\\frac{2}{\\sqrt{5}})\n$$\n\nWe evaluate $f$ at each of these points. These are given in the following table:\n\n| $(x,y,z)$ | $(\\frac{1}{\\sqrt{5}},-\\frac{1}{\\sqrt{5}},\\frac{2}{\\sqrt{5}})$ | $(-\\frac{1}{\\sqrt{5}},\\frac{1}{\\sqrt{5}},-\\frac{2}{\\sqrt{5}})$ |\n| --- | --- | --- |\n| $f(x,y,z)$ | $\\sqrt{5}$ | $-\\sqrt{5}$ |\n\nTherefore, the function reaches a maximum value at $(\\frac{1}{\\sqrt{5}},-\\frac{1}{\\sqrt{5}},\\frac{2}{\\sqrt{5}}),$ and its   maximum value is $\\sqrt{5}.$"} {:db/id #edb/ref 17592186493945 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa5916f5-b95b-5530-9d9f-19d0168e2209" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186493658}] :answer-field/correct {:answer/id #uuid "aa5916f5-b95b-5530-9d9f-19d0168e2209" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186493658} :answer-field/id #uuid "f90a68c7-dc57-5362-b958-0dc11f3f0c40" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493888}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "aafcb24f-fde2-52b2-b44a-c7d7fddbc683" :question/math-academy-id "q-186155" :question/problem "Evaluate the following:\n\n$\\sqrt[3]{\\frac{27}{8}}=$\n{{field-1}}" :question/worked-solution "First, notice that the numbers $27$ and $8$ are both perfect cubes. \n\nSo, to determine the value of $\\sqrt[3]{\\frac{27}{8}},$ we express $\\frac{27}{8}$ as a perfect cube:\n\n$$\n\\begin{aligned}\\sqrt[3]{\\frac{27}{8}} &= \\sqrt[3]{\\frac{{3}^{3}}{{2}^{3}}} \\\\ &= \\sqrt[3]{\\frac{3\\cdot 3\\cdot 3}{2\\cdot 2\\cdot 2}} \\\\ &= \\sqrt[3]{\\frac{3}{2}\\cdot \\frac{3}{2}\\cdot \\frac{3}{2}} \\\\ &= \\sqrt[3]{{(\\frac{3}{2})}^{3}} \\\\ &= \\frac{3}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493956 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b6b5fe5-29d1-5793-a274-fa3b5699e913" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3({e}^{-1/2}-{e}^{-2})\\operatorname{ln}⁡2" :db/id #edb/ref 17592186493410} {:answer/id #uuid "17dcff5e-6574-5e2e-be4c-22c67c1a31d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e}{8}" :db/id #edb/ref 17592186493432} {:answer/id #uuid "702b0bc2-ac10-5437-9f18-9fa877532a9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-1}-{e}^{-2}}{4}" :db/id #edb/ref 17592186493554} {:answer/id #uuid "857734df-e10d-5568-a049-4e87b8b5c0d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{e}^{2}" :db/id #edb/ref 17592186493601} {:answer/id #uuid "e162164d-9035-55fa-9f1c-b47ea0bae241" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({e}^{2}-e)\\operatorname{ln}⁡2" :db/id #edb/ref 17592186493747}] :answer-field/correct {:answer/id #uuid "0b6b5fe5-29d1-5793-a274-fa3b5699e913" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3({e}^{-1/2}-{e}^{-2})\\operatorname{ln}⁡2" :db/id #edb/ref 17592186493410} :answer-field/id #uuid "15ea503e-c96f-567a-8f89-cf26cc3e1193" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493808}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c5c02db8-6f5e-5ac6-a24e-9e9016b1082e" :question/math-academy-id "q-160899" :question/problem "Using the change of variables $u=\\frac{y}{x}$ and $v=xy,$ evaluate the double integral\n\n$$\n{∬}_{D}{e}^{-xy/2}\\,dx\\,dy,\n$$\n\nwhere $D=\\{(x,y)\\,:\\,\\frac{x}{4}\\le y\\le 2x,\\,1\\le xy\\le 4\\}.$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\,dx\\,dy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))|\\frac{∂(x,y)}{∂(u,v)}|du\\,dv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=\\frac{y}{x},\\,v=xy\n$$\n\n \ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,\\frac{1}{4}\\le u\\le 2,\\,1\\le v\\le 4\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-\\frac{y}{{x}^{2}} & \\frac{1}{x} \\\\ y & \\text{ }\\text{ }x\\end{vmatrix} \\\\  & =-\\frac{2y}{x}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}=\\frac{1}{(-\\frac{2y}{x})}=-\\frac{1}{2u}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}{e}^{-xy/2}\\,dx\\,dy & ={∬}_{Δ}{e}^{-v/2}|\\frac{∂(x,y)}{∂(u,v)}|\\text{d}u\\,\\text{d}v \\\\  & ={∬}_{Δ}{e}^{-v/2}\\cdot |-\\frac{1}{2u}|\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{1}^{4}{\\int }_{1/4}^{2}\\frac{{e}^{-v/2}}{u}\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{1}^{4}{e}^{-v/2}[{\\int }_{1/4}^{2}\\frac{1}{u}\\,\\text{d}u]\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{1}^{4}{e}^{-v/2}[\\operatorname{ln}⁡|u|\\,{|}_{1/4}^{2}]du \\\\  & =\\frac{1}{2}{\\int }_{1}^{4}{e}^{-v/2}[\\operatorname{ln}⁡2-\\operatorname{ln}⁡\\frac{1}{4}]\\,du \\\\  & =\\frac{3\\operatorname{ln}⁡2}{2}{\\int }_{1}^{4}{e}^{-v/2}\\,du \\\\  & =\\frac{3\\operatorname{ln}⁡2}{2}\\cdot {[-2{e}^{-v/2}]}_{1}^{4} \\\\  & =-3\\operatorname{ln}⁡2\\cdot ({e}^{-2}-{e}^{-1/2}) \\\\  & =3({e}^{-1/2}-{e}^{-2})\\operatorname{ln}⁡2.\\end{aligned}\n$$"}]
