{\\text{d}x}(- 16 \\cos{\\left(x \\right)} + \\frac{8}{x^{2}}) \\\\ &= (16 \\sin{\\left(x \\right)})+(- \\frac{16}{x^{3}}) \\\\ &= 16 \\sin{\\left(x \\right)} - \\frac{16}{x^{3}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186489491 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39359cea-c70f-5460-a00b-b3252b77490d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "44" :db/id #edb/ref 17592186489468} {:answer/id #uuid "3ba991d8-77cd-5adf-a4be-6a604604dc7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186489469} {:answer/id #uuid "6631f744-56ce-5b33-810f-f48c092b445f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186489474} {:answer/id #uuid "68bb25f2-417c-5380-9161-3ad0df79a70e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186489476} {:answer/id #uuid "81381787-644f-59de-aa98-b2a079bbc729" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{168}{5}" :db/id #edb/ref 17592186489480}] :answer-field/correct {:answer/id #uuid "6631f744-56ce-5b33-810f-f48c092b445f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186489474} :answer-field/id #uuid "c590b228-1737-55da-8acb-b2ae441356b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186489489}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ddd31c3c-768d-5290-8e36-3f5b830ff739" :question/problem "What is the slope of the tangent line to the curve $y=16 x - 40 \\cos{\\left(x \\right)}$ at the point $x=\\frac{\\pi}{6}$?" :question/worked-solution "The slope is the derivative evaluated at $x=\\frac{\\pi}{6}.$\n\nWe know that $\\frac{\\text{d}}{\\text{d}x}(\\sin x)=\\cos x,$ and that $\\frac{\\text{d}}{\\text{d}x}(\\cos x)=-\\sin x.$ Applying these formulas and the sum and constant multiple rules, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} &= \\frac{\\text{d}}{\\text{d}x}(16 x - 40 \\cos{\\left(x \\right)}) \\\\ &= (40 \\sin{\\left(x \\right)})+(16) \\\\ &= 40 \\sin{\\left(x \\right)} + 16.\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi}{6},$ we get\n\n$$\ny^{\\prime}(\\frac{\\pi}{6})=16+40\\sin(\\frac{\\pi}{6})=16+40\\left(\\frac{1}{2}\\right)=36.\n$$\n\nTherefore, the slope is $36.$"} {:db/id #edb/ref 17592186489493 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c3cfd04-7aa6-5774-ba14-f010e7a101cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27}{2}" :db/id #edb/ref 17592186489477} {:answer/id #uuid "8ed07005-38e6-5e5d-a622-d2cfd6049750" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{21}{2}" :db/id #edb/ref 17592186489483} {:answer/id #uuid "ad3e4c2a-e530-5c7e-b4a1-ac5402e2de1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27}{4}" :db/id #edb/ref 17592186489485} {:answer/id #uuid "bf467ae4-1e01-5b03-972f-3946b7761d12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{33}{2}" :db/id #edb/ref 17592186489488} {:answer/id #uuid "f4deb1ae-1bcf-532a-b1e2-248371cdc02d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{63}{5}" :db/id #edb/ref 17592186489495}] :answer-field/correct {:answer/id #uuid "6c3cfd04-7aa6-5774-ba14-f010e7a101cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27}{2}" :db/id #edb/ref 17592186489477} :answer-field/id #uuid "aae48b1d-52dc-57a0-8231-48c0aaf2bf33" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186489484}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e697136f-ba37-5c15-b682-60c32dbf1e52" :question/problem "What is the slope of the tangent line to the curve $y=6 x - 15 \\cos{\\left(x \\right)}$ at the point $x=\\frac{\\pi}{6}$?" :question/worked-solution "The slope is the derivative evaluated at $x=\\frac{\\pi}{6}.$\n\nWe know that $\\frac{\\text{d}}{\\text{d}x}(\\sin x)=\\cos x,$ and that $\\frac{\\text{d}}{\\text{d}x}(\\cos x)=-\\sin x.$ Applying these formulas and the sum and constant multiple rules, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} &= \\frac{\\text{d}}{\\text{d}x}(6 x - 15 \\cos{\\left(x \\right)}) \\\\ &= (15 \\sin{\\left(x \\right)})+(6) \\\\ &= 15 \\sin{\\left(x \\right)} + 6.\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi}{6},$ we get\n\n$$\ny^{\\prime}(\\frac{\\pi}{6})=6+15\\sin(\\frac{\\pi}{6})=6+15\\left(\\frac{1}{2}\\right)=\\frac{27}{2}.\n$$\n\nTherefore, the slope is $\\frac{27}{2}.$"} {:db/id #edb/ref 17592186490212 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "405b937b-2494-589a-941f-c2c89bb59b81" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/44/4459ec44cd710a0ba13e9d22796311cb251cc58f8e41c4212a00260e45bbcd2c.png" :db/id #edb/ref 17592186489663} {:answer/id #uuid "4f3ef020-6dd5-5ced-a63e-ffae9ca42093" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a9/a9b8e953a6d1277056331aa46a3d3a6bf59ae0dd8dad66d14c8a5f2a409316ce.png" :db/id #edb/ref 17592186489704} {:answer/id #uuid "595622b7-555e-511d-b8fb-61467363fd56" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b8/b8be3b86eb85760320298c272e31dd76fa2fea5fd6acf2931831f1c0e3d73787.png" :db/id #edb/ref 17592186489732} {:answer/id #uuid "87b8b871-e4f1-5444-8738-aa304484251c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/57/5725e9ce0bd4f2995d478f2a74d7b65f778157058a41ef0229637b40bb865b11.png" :db/id #edb/ref 17592186489823} {:answer/id #uuid "d25de580-d351-551b-9837-3c4daaa24a24" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1c/1c0270805f90797c9add194054ea5bbef76207b5ce9c9659227c069e999369f3.png" :db/id #edb/ref 17592186489980}] :answer-field/correct {:answer/id #uuid "4f3ef020-6dd5-5ced-a63e-ffae9ca42093" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a9/a9b8e953a6d1277056331aa46a3d3a6bf59ae0dd8dad66d14c8a5f2a409316ce.png" :db/id #edb/ref 17592186489704} :answer-field/id #uuid "b9111900-5b3b-528e-bee1-da24812f7bc8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490174}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "03021383-b99c-5e38-823a-268b5d1215a6" :question/math-academy-id "q-162160" :question/problem "Which of the following represents the streamlines of the vector field $F(x,y)=(\\frac{1}{y-{x}^{2}})i+(\\frac{2x}{y-{x}^{2}})j$ over the domain $D=\\{(x,y)\\in {R}^{2}\\,:\\,y>{x}^{2}\\}.$" :question/worked-solution "The streamlines of a vector field are the level curves of its stream function and are tangential to the vector field at every point. \n\nIf $F$ represents the velocity field of a fluid flow, then they show the path traced out by a massless particle as it moves with the flow.\n\nA vector field $F=P\\,i+Q\\,j$ with a simply connected domain $D⊆{R}^{2}$ has a stream function $ψ(x,y)$ if and only if\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=0.\n$$\n\nNote that \n\n$$\nF(x,y)=(\\frac{1}{y-{x}^{2}})i+(\\frac{2x}{y-{x}^{2}})j\n$$\n\n is a vector field with simply connected domain $D,$ where $P(x,y)=\\frac{1}{y-{x}^{2}}$ and $Q(x,y)=\\frac{2x}{y-{x}^{2}}.$ Computing the partial derivatives, we have\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=\\frac{2x}{(y-{x}^{2})^{2}},\\,\\frac{∂Q}{∂y} & =-\\frac{2x}{(y-{x}^{2})^{2}}.\\end{aligned}\n$$\n\nHence, $F$ has a stream function, since\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=\\frac{2x}{(y-{x}^{2})^{2}}+(-\\frac{2x}{(y-{x}^{2})^{2}})=0.\n$$\n\nNext, we find a stream function. A function $ψ(x,y)$ is a stream function of the vector field $F=P\\,i+Q\\,j$ if \n\n$$\nP=\\frac{∂ψ}{∂y},\\,Q=-\\frac{∂ψ}{∂x}.\n$$\n\nIn our case, we have\n\n$$\n\\frac{∂ψ}{∂y}=\\frac{1}{y-{x}^{2}},\\,\\frac{∂ψ}{∂x}=-\\frac{2x}{y-{x}^{2}}.\n$$\n\nIntegrating these equations, we obtain the following:\n\n$$\nψ(x,y)=\\operatorname{ln}⁡(y-{x}^{2})+f(x),\\,ψ(x,y)=\\operatorname{ln}⁡(y-{x}^{2})+g(y)\n$$\n\nwhere $f$ and $g$ are arbitrary functions. Finally, setting $f=g=0,$ we have\n\n$$\nψ(x,y)=\\operatorname{ln}⁡(y-{x}^{2}).\n$$\n\nFinally, we find the level curves of the stream function $ψ(x,y)=\\operatorname{ln}⁡(y-{x}^{2})$ given by the equations $ψ(x,y)=c.$\n\nNotice that the range of $ψ(x,y)$ is $(-\\infty ,\\infty ).$ So, we will consider level curves for any value of $c.$ So, we have:\n\n$$\n\\begin{aligned}ψ(x,y) & =c \\\\ \\operatorname{ln}⁡(y-{x}^{2}) & =c \\\\ y-{x}^{2} & ={e}^{c} \\\\ y & ={x}^{2}+{e}^{c}\\end{aligned}\n$$\n\nThe equation above gives us a family of parabolas with the vertex at $(0,{e}^{c}).$ Therefore, the correct graph (along with the vector field $F$) is as follows:\n\n![](images/ed/edc12146ffad4dc46ed6d57b3dfdc9a08ca92fb601ef5e08ed9ccef3a1c1da4c.png)"} {:db/id #edb/ref 17592186490214 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30f0c895-ef08-58e6-9075-734c56d0693f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0156" :db/id #edb/ref 17592186489624}] :answer-field/correct {:answer/id #uuid "30f0c895-ef08-58e6-9075-734c56d0693f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0156" :db/id #edb/ref 17592186489624} :answer-field/id #uuid "97d7b59f-a2d2-58e3-a418-18885daa2bc6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186490158}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "04c3981e-56b1-51ed-b49e-4d2d764aacc9" :question/math-academy-id "q-335508" :question/problem "Given $X∼\\text{Geom}(\\frac{7}{8}),$ compute $P(X\\ge 3)$ round to $4$ decimal places.\n\n$P(X\\ge 3)≈$\n{{field-1}}" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(\\frac{7}{8}),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(\\frac{1}{8})}^{x-1}(\\frac{7}{8}), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nThere are infinitely many values of $X$ such that $X\\ge 3.$ However, we can simplify the computation by using the complement instead:\n\n$$\nP(X\\ge 3)=1-P(X<3)\n$$\n\nComputing the complement, we get\n\n$$\n\\begin{aligned}P(X<3) & =P(X\\in \\{1,2\\}) \\\\  & =P(X=1)+P(X=2) \\\\  & =f(1)+f(2) \\\\  & ={(\\frac{1}{8})}^{0}(\\frac{7}{8})+{(\\frac{1}{8})}^{1}(\\frac{7}{8}) \\\\  & =0.984375.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X\\ge 3) & =1-P(X<3) \\\\  & =1-0.984375 \\\\  & ≈0.0156.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490215 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f4f0d37-31fa-580f-a61f-73b377587e0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2041" :db/id #edb/ref 17592186489549} {:answer/id #uuid "57493273-713c-5bd8-9c9d-be6b143d9126" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9184" :db/id #edb/ref 17592186489722} {:answer/id #uuid "65c9f129-b21a-5d19-8e36-b0303bd7567e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.7959" :db/id #edb/ref 17592186489755} {:answer/id #uuid "c75df401-1338-550f-9685-bdbf40c3f545" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0816" :db/id #edb/ref 17592186489945} {:answer/id #uuid "cbf65f81-805f-53f1-bb8a-3704c0abd456" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1837" :db/id #edb/ref 17592186489965}] :answer-field/correct {:answer/id #uuid "c75df401-1338-550f-9685-bdbf40c3f545" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0816" :db/id #edb/ref 17592186489945} :answer-field/id #uuid "5526fa50-a4a2-58c4-84bf-0839d0ec3ffd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490125}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "075d366c-d06a-5f72-a1db-49d33772eb88" :question/math-academy-id "q-130234" :question/problem "Given $X∼\\text{Geom}(\\frac{5}{7}),$ compute $P(X\\ge 3)$ rounded to $4$ decimal places." :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(\\frac{5}{7}),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(\\frac{2}{7})}^{x-1}(\\frac{5}{7}), & x=1,2,3… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nThere are infinitely many values of $X$ such that $X\\ge 3.$ However, we can simplify the computation by using the complement instead:\n\n$$\n\\begin{aligned}P(X\\ge 3) & =1-P(X<3)\\end{aligned}\n$$\n\nComputing the complement, we get\n\n$$\n\\begin{aligned}P(X<3) & =P(X\\in \\{1,2\\}) \\\\  & =P(X=1)+P(X=2) \\\\  & =f(1)+f(2) \\\\  & ={(\\frac{2}{7})}^{0}(\\frac{5}{7})+{(\\frac{2}{7})}^{1}(\\frac{5}{7}) \\\\  & ≈0.9184.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X\\ge 3) & =1-P(X<3) \\\\  & ≈1-0.9184 \\\\  & =0.0816.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490221 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10e66bfe-083b-5be0-9583-02c2dd9dbc3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sup(A)=\\frac{13}{3}\\in A" :db/id #edb/ref 17592186489555} {:answer/id #uuid "89293f7d-7259-5ca0-9d47-f57a27be0b52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sup(A)=5\\in A" :db/id #edb/ref 17592186489831} {:answer/id #uuid "c65bb871-f69d-5809-a2e7-c05b75873a6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$sup(A)$ does not exist" :db/id #edb/ref 17592186489944} {:answer/id #uuid "d622005e-b5a8-5b3b-b564-16897d776f36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sup(A)=5\\notin A" :db/id #edb/ref 17592186489989} {:answer/id #uuid "df7f2a2d-61f7-56a7-bec1-7262e75f747b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sup(A)=\\frac{13}{3}\\notin A" :db/id #edb/ref 17592186490001}] :answer-field/correct {:answer/id #uuid "d622005e-b5a8-5b3b-b564-16897d776f36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sup(A)=5\\notin A" :db/id #edb/ref 17592186489989} :answer-field/id #uuid "236e608b-8ac0-548b-a7ea-fa7e8de10892" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186490090}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2472238f-de89-5651-9808-c29025aa1081" :question/math-academy-id "q-253514" :question/problem "Consider the following set.\n\n$$\nA=\\{5-{(\\frac{2}{3})}^{n}\\,:\\,n\\in N\\}\n$$\n\nFor this set, we have {{field-1}}." :question/worked-solution "The supremum of a set $A$ is the smallest upper bound of $A.$\n\nTo find the supremum of this set, we must find the set containing **all** upper bounds of $A$ (i.e., the set of upper bounds) and take the minimum of this set.\n\nThe elements of $A$ are all the terms of the sequence ${a}_{n},$ given by\n\n$$\n{a}_{n}=5-{(\\frac{2}{3})}^{n},\\,n\\in N=\\{1,2,3,4,…\\}.\n$$\n\nLet's draw some points of our sequence on the real line:\n\n![](images/1e/1ea2ed214496ed38ae605e9ac64bebd781a0d5529561fce44d98cca6839d6fbb.png)\n\nWe see that ${a}_{n}$ is increasing and converges to $5.$ \n\nSo, in our case, we have that\n\n- any number in the set $x\\ge 5$ is an upper bound of $A,$\n\n- any number in the set $x<5$ is **not** an upper bound of $A.$ In other words, we can always find a sufficiently large $n$ so that $5-{(\\frac{2}{3})}^{n}$ is greater than $x$ for any $x<5.$\n\nTherefore, $[5,\\infty )$ is the set of upper bounds of $A,$ and \n\n$$\nsup(A)=min[5,\\infty )=5.\n$$\n\nNotice that $5$ is *not* the maximum of $A$ (the set $A$ has no maximum). Therefore, we conclude that\n\n$$\nsup(A)=5\\notin A.\n$$"} {:db/id #edb/ref 17592186490224 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "545f6b34-8b08-5486-9f0e-2cc84dac10e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186489714} {:answer/id #uuid "5923c943-f43e-5441-819c-fc4c38287552" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186489731} {:answer/id #uuid "7575186d-b230-5c3f-951f-24397f6e911d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186489787} {:answer/id #uuid "b71f29a1-8d1a-5479-ac04-69c1694fac07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186489917} {:answer/id #uuid "c44f6e25-54af-5112-a2ff-488411a644f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186489938}] :answer-field/correct {:answer/id #uuid "b71f29a1-8d1a-5479-ac04-69c1694fac07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186489917} :answer-field/id #uuid "7a5fd354-5df8-5dcc-bf17-82ac638ded50" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490142}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "27f65119-9cfd-5858-830b-dc487011110a" :question/math-academy-id "q-69345" :question/problem "Calculate $\\frac{5}{8}\\times 3-(8-10)^{-3}.$" :question/worked-solution "To evaluate the given expression, we use PEMDAS.\n\nFirst, we compute the expression inside the parentheses:\n\n$$\n\\frac{5}{8}\\times 3-(8-10)^{-3}=\\frac{5}{8}\\times 3-(-2)^{-3}\n$$\n\nNext, notice that $(-2)^{-3}=\\frac{1}{(-2)^{3}}=-\\frac{1}{8}.$ So, we obtain:\n\n$$\n\\begin{aligned}\\frac{5}{8}\\times 3-(-2)^{-3} &= \\frac{5}{8}\\times 3-(-\\frac{1}{8}) \\\\ &= \\frac{5}{8}\\times \\frac{3}{1}+\\frac{1}{8} \\\\ &= \\frac{5\\times 3}{8\\times 1}+\\frac{1}{8} \\\\ &= \\frac{15}{8}+\\frac{1}{8} \\\\ &= \\frac{15+1}{8} \\\\ &= \\frac{16}{8} \\\\ &= 2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490243 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e780059-1688-570a-b234-233305003b4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9610" :db/id #edb/ref 17592186489836}] :answer-field/correct {:answer/id #uuid "8e780059-1688-570a-b234-233305003b4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9610" :db/id #edb/ref 17592186489836} :answer-field/id #uuid "fdcc3e6a-dcfa-5751-a590-4c15ac84e072" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186490208}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "458360eb-fd03-5244-aa64-17cd1909b422" :question/math-academy-id "q-335471" :question/problem "Given $X∼\\text{Geom}(\\frac{5}{9}),$ compute $P(X<5).$ Round your final answer to $4$ decimal places.\n\n$P(X<5)≈$\n{{field-1}}" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(\\frac{5}{9}),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(\\frac{4}{9})}^{x-1}(\\frac{5}{9}), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X<5) & =P(X\\in \\{1,2,3,4\\}) \\\\  & =P(X=1)+P(X=2)+P(X=3)+P(X=4) \\\\  & =f(1)+f(2)+f(3)+f(4) \\\\  & ={(\\frac{4}{9})}^{0}(\\frac{5}{9})+{(\\frac{4}{9})}^{1}(\\frac{5}{9})+{(\\frac{4}{9})}^{2}(\\frac{5}{9})+{(\\frac{4}{9})}^{3}(\\frac{5}{9}) \\\\  & ≈0.9610.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490249 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b95860c-921b-57fb-b5ec-46baec795536" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.813" :db/id #edb/ref 17592186489540}] :answer-field/correct {:answer/id #uuid "0b95860c-921b-57fb-b5ec-46baec795536" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.813" :db/id #edb/ref 17592186489540} :answer-field/id #uuid "b9607223-8ad8-5973-98c0-43e17bad1ef9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186490175}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "510156d7-b5c0-5e8b-8cd5-32b7f7e0537d" :question/math-academy-id "q-331503" :question/problem "A fair coin is flipped $5$ times. Rounded to $3$ decimal places, what is the probability that the coin lands on heads at most $3$ times?\n\nRounded to $3$ decimal places, the probability is\n{{field-1}}." :question/worked-solution "Let the random variable $X$ be equal to the number of times the coin lands on heads.\n\nHere, we have the following information:\n\n- There are $n=5$ flips.\n\n- The probability of landing heads is $p=\\frac{1}{2}.$\n\nSo, $X$ follows a binomial distribution, where $X∼B(5,\\frac{1}{2}).$\n\nThe number of successes of a binomial random variable has the probability mass function\n\n$$\nP(X=x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x},\n$$\n\nwhere $n$ is the number of experiments, and $p$ is the probability of success on each experiment.\n\nSubstituting the above information into the formula for the probability mass function, we get\n\n$$\n\\begin{aligned}P(X=x) & =(\\genfrac{}{}{0pt}{}{5}{x}){(\\frac{1}{2})}^{x}{(1-\\frac{1}{2})}^{5-x} \\\\  & =(\\genfrac{}{}{0pt}{}{5}{x}){(\\frac{1}{2})}^{x}{(\\frac{1}{2})}^{5-x}.\\end{aligned}\n$$\n\nWe want to find the probability that at most $3$ of the $5$ flips are heads. So, we compute\n\n$$\n\\begin{aligned}P(X\\le 3) & =P(X=0)+P(X=1)+P(X=2)+P(X=3) \\\\  & =(\\genfrac{}{}{0pt}{}{5}{0}){(\\frac{1}{2})}^{0}{(\\frac{1}{2})}^{5}+(\\genfrac{}{}{0pt}{}{5}{1}){(\\frac{1}{2})}^{1}{(\\frac{1}{2})}^{4} \\\\  & \\,+(\\genfrac{}{}{0pt}{}{5}{2}){(\\frac{1}{2})}^{2}{(\\frac{1}{2})}^{3}+(\\genfrac{}{}{0pt}{}{5}{3}){(\\frac{1}{2})}^{3}{(\\frac{1}{2})}^{2} \\\\  & =(1+5+10+10)\\cdot {(\\frac{1}{2})}^{5} \\\\  & =26\\cdot \\frac{1}{32} \\\\  & =0.813,\\end{aligned}\n$$\n\nrounded to $3$ decimal places."} {:db/id #edb/ref 17592186490255 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03707761-65ce-5e18-9eca-bdcf476813eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1905" :db/id #edb/ref 17592186489522} {:answer/id #uuid "3ed878e3-0f93-5c46-9db6-c4306f74717d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1815" :db/id #edb/ref 17592186489657} {:answer/id #uuid "a307a07e-5741-55da-9a6e-1697fa3280b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1871" :db/id #edb/ref 17592186489877} {:answer/id #uuid "ac5e747c-e311-5a20-b8ad-96d90a15c10b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1999" :db/id #edb/ref 17592186489893} {:answer/id #uuid "b91dbe80-c8a5-59f3-ada3-cd2a7a39106b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2087" :db/id #edb/ref 17592186489922}] :answer-field/correct {:answer/id #uuid "ac5e747c-e311-5a20-b8ad-96d90a15c10b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1999" :db/id #edb/ref 17592186489893} :answer-field/id #uuid "492d4a9f-68c9-53ae-b5eb-ce8b350b7da0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490115}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5e3a6ede-352d-5bbc-898c-f52f077d9252" :question/math-academy-id "q-97154" :question/problem "Given that $X∼\\text{Geom}(\\frac{1}{7}),$ compute $P(5\\le X<8)$ rounded to $4$ decimal places." :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(\\frac{1}{7}),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(\\frac{6}{7})}^{x-1}(\\frac{1}{7}), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(5\\le X<8) & =P(X\\in \\{5,6,7\\}) \\\\  & =P(X=5)+P(X=6)+P(X=7) \\\\  & =f(5)+f(6)+f(7) \\\\  & ={(\\frac{6}{7})}^{4}(\\frac{1}{7})+{(\\frac{6}{7})}^{5}(\\frac{1}{7})+{(\\frac{6}{7})}^{6}(\\frac{1}{7}) \\\\  & ≈0.1999.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490258 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59077802-2ece-52ce-8fdb-8f6f3735b72f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186489730} {:answer/id #uuid "da84991b-fcac-5426-a689-60bfacfa87a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186489996} {:answer/id #uuid "df6c29bc-d773-5ece-9a45-14b4359b35cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{6\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186489999} {:answer/id #uuid "eed896f0-f769-50fb-a53d-7bc14aff6cc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186490029} {:answer/id #uuid "f14b3a35-0151-5e3a-b9bf-83c572725766" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186490032}] :answer-field/correct {:answer/id #uuid "f14b3a35-0151-5e3a-b9bf-83c572725766" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186490032} :answer-field/id #uuid "a108c977-d111-5123-bfa0-9f9dd2b6376b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490166}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "633f13a2-1c12-5a0e-ade7-b4d04e14c842" :question/math-academy-id "q-13844" :question/problem "What is the value of ${\\int }_{1}^{2}\\frac{3}{2x{ln}^{2}⁡(4x)}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(4x).$ Then we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4x}\\cdot 4=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $2$ |\n| --- | --- | --- |\n| $u$ | $\\operatorname{ln}⁡4$ | $\\operatorname{ln}⁡8$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}\\frac{3}{2x{ln}^{2}⁡(4x)}\\,\\text{d}x & =\\frac{3}{2}{\\int }_{1}^{2}\\frac{1}{(\\operatorname{ln}⁡(4x))^{2}}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{3}{2}{\\int }_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡8}\\frac{1}{{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{3}{2}\\cdot {(-{u}^{-1})|}_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡8} \\\\  & =-\\frac{3}{2}\\cdot {(\\frac{1}{u})|}_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡8} \\\\  & =-\\frac{3}{2}(\\frac{1}{\\operatorname{ln}⁡8}-\\frac{1}{\\operatorname{ln}⁡4}) \\\\  & =-\\frac{3}{2}(\\frac{1}{\\operatorname{ln}⁡{2}^{3}}-\\frac{1}{\\operatorname{ln}⁡{2}^{2}}) \\\\  & =-\\frac{3}{2}(\\frac{1}{3\\operatorname{ln}⁡2}-\\frac{1}{2\\operatorname{ln}⁡2}) \\\\  & =-\\frac{3}{2}(-\\frac{1}{6\\operatorname{ln}⁡2}) \\\\  & =\\frac{1}{4\\operatorname{ln}⁡2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490272 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec06b592-8251-5caa-8800-efc045e64f99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{64}{625}" :db/id #edb/ref 17592186490025}] :answer-field/correct {:answer/id #uuid "ec06b592-8251-5caa-8800-efc045e64f99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{64}{625}" :db/id #edb/ref 17592186490025} :answer-field/id #uuid "0beb1338-f5b7-5c64-8a8e-35f279844e52" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186490077}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8633e974-6d10-58b7-b01c-e86dcc646ae6" :question/math-academy-id "q-331515" :question/problem "Given $X∼\\text{Geom}(\\frac{1}{5}),$ compute the **exact** value of $P(X=4).$\n\n$P(X=4)=$\n{{field-1}}" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(\\frac{1}{5}),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(\\frac{4}{5})}^{x-1}(\\frac{1}{5}), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}P(X=4) & =f(4) \\\\  & ={(\\frac{4}{5})}^{3}(\\frac{1}{5}) \\\\  & =\\frac{64}{625}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490274 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06d5ee62-aa42-5f01-b4a5-ab74deed7fec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0632" :db/id #edb/ref 17592186489531} {:answer/id #uuid "1a06965d-e607-5ac2-8527-8aaf4db45332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0764" :db/id #edb/ref 17592186489572} {:answer/id #uuid "396ef0a9-9da4-597c-a198-387695bd64a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0583" :db/id #edb/ref 17592186489643} {:answer/id #uuid "c470e502-58aa-5ad8-9844-68f75a95a94a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0423" :db/id #edb/ref 17592186489941} {:answer/id #uuid "c57a8780-ca2e-5b63-8e36-e20cefc4f686" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0299" :db/id #edb/ref 17592186489942}] :answer-field/correct {:answer/id #uuid "1a06965d-e607-5ac2-8527-8aaf4db45332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0764" :db/id #edb/ref 17592186489572} :answer-field/id #uuid "cf820629-906a-5c04-b58a-8d824afc8c32" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490182}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "89650cb6-ad4a-5818-b55e-8a9dde9d78b4" :question/math-academy-id "q-97164" :question/problem "Given that $X∼\\text{Geom}(\\frac{5}{12}),$ compute $P(4<X<7)$ rounded to $4$ decimal places." :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(\\frac{5}{12}),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(\\frac{7}{12})}^{x-1}(\\frac{5}{12}), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(4<X<7) & =P(X\\in \\{5,6\\}) \\\\  & =P(X=5)+P(X=6) \\\\  & =f(5)+f(6) \\\\  & ={(\\frac{7}{12})}^{4}(\\frac{5}{12})+{(\\frac{7}{12})}^{5}(\\frac{5}{12}) \\\\  & ≈0.0764.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490282 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f663968-9914-51d2-a0d5-0de18327bcb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-5{x}^{4}" :db/id #edb/ref 17592186489659} {:answer/id #uuid "aa8be593-a930-5092-b401-4276e53f4bb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-\\frac{5{x}^{4}}{2}" :db/id #edb/ref 17592186489890} {:answer/id #uuid "aab4c61d-684a-5773-b4d6-164888798bb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x}{2}-5{x}^{4}" :db/id #edb/ref 17592186489891} {:answer/id #uuid "c9c56fc1-b117-576b-81a6-2f4abdab9754" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3x}{2}-\\frac{5{x}^{4}}{2}" :db/id #edb/ref 17592186489955} {:answer/id #uuid "f6bfd523-eab9-5a44-b230-8dd48c8d9b55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x+5{x}^{4}" :db/id #edb/ref 17592186490049}] :answer-field/correct {:answer/id #uuid "3f663968-9914-51d2-a0d5-0de18327bcb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-5{x}^{4}" :db/id #edb/ref 17592186489659} :answer-field/id #uuid "cc8bf450-8384-5183-8fd7-ee109eb1c278" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490181}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a0223a5d-a1d6-5c40-af63-e8dfd73551f8" :question/math-academy-id "q-111117" :question/problem "$\\frac{x}{2}(6-10{x}^{3})=$" :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}\\frac{x}{2}(6-10{x}^{3}) &= (\\frac{x}{2})(6)+(\\frac{x}{2})(-10{x}^{3}) \\\\ &= (\\frac{1}{2}x)(6)+(\\frac{1}{2}x)(-10{x}^{3}) \\\\ &= (\\frac{1}{2}\\cdot 6)x+(\\frac{1}{2}\\cdot (-10))(x\\cdot {x}^{3}) \\\\ &= (3)x+(-5)({x}^{1+3}) \\\\ &= 3x-5{x}^{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490286 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d65759d-e36d-5045-acc5-db2984da989f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}+{x}^{2}" :db/id #edb/ref 17592186489544} {:answer/id #uuid "174ed3f2-66bc-5124-aa00-570861734082" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}+\\frac{1}{3}{x}^{2}+{x}^{2}" :db/id #edb/ref 17592186489567} {:answer/id #uuid "84c7c962-da54-5750-9444-176e8e186f3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}+\\frac{2}{3}{x}^{2}+{x}^{4}" :db/id #edb/ref 17592186489819} {:answer/id #uuid "ea56582c-7d40-5467-bb1c-047ef74db56a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}+{x}^{4}" :db/id #edb/ref 17592186490023} {:answer/id #uuid "f2c7773c-a23f-5f60-a9f6-ea4c2e71ce2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}+\\frac{2}{3}{x}^{2}+{x}^{2}" :db/id #edb/ref 17592186490037}] :answer-field/correct {:answer/id #uuid "84c7c962-da54-5750-9444-176e8e186f3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}+\\frac{2}{3}{x}^{2}+{x}^{4}" :db/id #edb/ref 17592186489819} :answer-field/id #uuid "1248bc9c-da8e-5444-ae7b-ffd4127ab86f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490084}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a62d676a-9c38-5dd1-a066-72e04e4e8a97" :question/math-academy-id "q-33095" :question/problem "${(\\frac{1}{3}+{x}^{2})}^{2}=$" :question/worked-solution "We will use the following formula:\n\n$$\n(a+b)^{2}={a}^{2}+2ab+{b}^{2}\n$$\n\nSubstituting $a=\\frac{1}{3}$ and $b={x}^{2},$ we have\n\n$$\n\\begin{aligned}{(\\frac{1}{3}+{x}^{2})}^{2} &= {(\\frac{1}{3})}^{2}+2(\\frac{1}{3})({x}^{2})+{({x}^{2})}^{2} \\\\ &= \\frac{1}{9}+\\frac{2}{3}{x}^{2}+{x}^{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490290 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f9115f7-c967-552e-babd-64a7c492372a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186489621} {:answer/id #uuid "375f59e1-b6c5-51a0-ad58-23511b54c59d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186489638} {:answer/id #uuid "3c97f35c-4480-5e3e-a894-f3effca05b9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186489651} {:answer/id #uuid "5959bb5d-4929-5707-80e3-51ab7b1c379f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186489733} {:answer/id #uuid "cc31709a-e3d1-56b4-9a97-dea545336cc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186489966}] :answer-field/correct {:answer/id #uuid "3c97f35c-4480-5e3e-a894-f3effca05b9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186489651} :answer-field/id #uuid "59271587-d957-593c-984d-f14328120bc0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490127}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "abc95782-56f0-5602-a797-77bbd8bc8d07" :question/math-academy-id "q-160382" :question/problem "For the transformation $T,$ defined as\n\n$$\nT(\\begin{bmatrix}u \\\\ v\\end{bmatrix})⟶\\begin{bmatrix}uv \\\\ \\operatorname{ln}⁡(\\frac{u}{v})\\end{bmatrix}\n$$\n\n  \n\ncompute the value of the Jacobian determinant at the point where $\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}.$" :question/worked-solution "Given a transformation \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix},\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix}.\\end{aligned}\n$$\n\nHere, we have $x=uv$ and $y=\\operatorname{ln}⁡(\\frac{u}{v}).$ \n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =v & \\,\\frac{∂x}{∂v} & =u \\\\ \\frac{∂y}{∂u} & =\\frac{1}{u} & \\,\\frac{∂y}{∂v} & =-\\frac{1}{v}\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\  & =\\begin{vmatrix}v & u \\\\ \\frac{1}{u} & -\\frac{1}{v}\\end{vmatrix} \\\\  & =v\\cdot (-\\frac{1}{v})-u\\cdot \\frac{1}{u} \\\\  & =-2.\\end{aligned}\n$$\n\nFinally, when $\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix},$ the value of our Jacobian determinant is\n\n$$\n{\\frac{∂(x,y)}{∂(u,v)}|}_{(1,3)}=-2.\n$$"} {:db/id #edb/ref 17592186490302 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b76c2ecd-bfe3-572f-9e1c-e2783e3ff672" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{255}{256}" :db/id #edb/ref 17592186489919}] :answer-field/correct {:answer/id #uuid "b76c2ecd-bfe3-572f-9e1c-e2783e3ff672" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{255}{256}" :db/id #edb/ref 17592186489919} :answer-field/id #uuid "374164b9-fa8d-5f84-b049-4c4079513c6a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186490105}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c5de4d6c-cfeb-57f1-bb0f-e9ef45447169" :question/math-academy-id "q-335472" :question/problem "Given $X∼\\text{Geom}(\\frac{3}{4}),$ compute the **exact** value of $P(X<5).$\n\n$P(X<5)=$\n{{field-1}}" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(\\frac{3}{4}),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(\\frac{1}{4})}^{x-1}(\\frac{3}{4}), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X<5) & =P(X\\in \\{1,2,3,4\\}) \\\\  & =P(X=1)+P(X=2)+P(X=3)+P(X=4) \\\\  & =f(1)+f(2)+f(3)+f(4) \\\\  & ={(\\frac{1}{4})}^{0}(\\frac{3}{4})+{(\\frac{1}{4})}^{1}(\\frac{3}{4})+{(\\frac{1}{4})}^{2}(\\frac{3}{4})+{(\\frac{1}{4})}^{3}(\\frac{3}{4}) \\\\  & =\\frac{255}{256}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490305 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c40c928-474e-5fcd-96e6-d0ce3aef77a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "256" :db/id #edb/ref 17592186489692} {:answer/id #uuid "68e74ddf-5b48-58b7-a653-55ecc87fcc23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{64}" :db/id #edb/ref 17592186489766} {:answer/id #uuid "9d3ad9ee-c476-5e5a-a69b-52fd8a0b2b1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{256}" :db/id #edb/ref 17592186489865} {:answer/id #uuid "b94c40cc-5cbd-5681-955d-1efa9075e827" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186489923} {:answer/id #uuid "caa97124-d2a3-5455-acf8-11d5f0b9b929" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186489957}] :answer-field/correct {:answer/id #uuid "4c40c928-474e-5fcd-96e6-d0ce3aef77a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "256" :db/id #edb/ref 17592186489692} :answer-field/id #uuid "d9514d09-69aa-5aee-8c9d-3e1f675180bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490188}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d02b196c-7964-5a35-ad18-39ecb861ac94" :question/math-academy-id "q-100388" :question/problem "${({(\\frac{1}{2})}^{2})}^{-4}=$" :question/worked-solution "To raise a power to another power, we simply multiply the exponents:\n\n$$\n{({(\\frac{1}{2})}^{2})}^{-4}={(\\frac{1}{2})}^{2\\cdot (-4)}={(\\frac{1}{2})}^{-8}\n$$\n\nTo evaluate ${(\\frac{1}{2})}^{-8},$ we find the reciprocal of the base $\\frac{1}{2}$ and then raise that reciprocal to the same power but with the opposite sign:\n\n$$\n{(\\frac{1}{2})}^{-8}={2}^{8}=256\n$$"} {:db/id #edb/ref 17592186490310 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07837112-8580-50b9-aa46-6f6bfd4a1983" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0156" :db/id #edb/ref 17592186489534}] :answer-field/correct {:answer/id #uuid "07837112-8580-50b9-aa46-6f6bfd4a1983" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0156" :db/id #edb/ref 17592186489534} :answer-field/id #uuid "1548ad33-92ee-5cc7-a272-b792c434a1c4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186490086}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "da4631ee-615f-5d28-ba69-71a6d6cc3214" :question/math-academy-id "q-332366" :question/problem "Given $X∼\\text{Geom}(\\frac{1}{2}),$ compute $P(X=6).$  Round your final answer to $4$ decimal places.\n\n$P(X=6)≈$\n{{field-1}}" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(\\frac{1}{2}),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(\\frac{1}{2})}^{x-1}(\\frac{1}{2}), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X=6) & =f(6) \\\\  & ={(\\frac{1}{2})}^{5}(\\frac{1}{2}) \\\\  & ≈0.0156.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490319 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9663b4c1-0d09-501b-85ec-b12bc71c403b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2436}{15625}" :db/id #edb/ref 17592186489851}] :answer-field/correct {:answer/id #uuid "9663b4c1-0d09-501b-85ec-b12bc71c403b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2436}{15625}" :db/id #edb/ref 17592186489851} :answer-field/id #uuid "7f07629a-b94e-5918-a076-295a6afd6ca9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186490147}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ebe82800-a8b2-58e9-ab4c-047410ac5d4f" :question/math-academy-id "q-332934" :question/problem "Given $X∼\\text{Geom}(\\frac{3}{5}),$ compute the **exact** value of $P(3\\le X\\le 6).$\n\n$P(3\\le X\\le 6)=$\n{{field-1}}" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(\\frac{3}{5}),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(\\frac{2}{5})}^{x-1}(\\frac{3}{5}), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(3\\le X\\le 6) & =P(X\\in \\{3,4,5,6\\}) \\\\  & =P(X=3)+P(X=4)+P(X=5)+P(X=6) \\\\  & =f(3)+f(4)+f(5)+f(6) \\\\  & ={(\\frac{2}{5})}^{2}(\\frac{3}{5})+{(\\frac{2}{5})}^{3}(\\frac{3}{5})+{(\\frac{2}{5})}^{4}(\\frac{3}{5})+{(\\frac{2}{5})}^{5}(\\frac{3}{5}) \\\\  & =\\frac{2436}{15625}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490321 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c6a9f60-c08f-5467-a283-a5c875e998cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡(\\frac{3}{2})" :db/id #edb/ref 17592186489583} {:answer/id #uuid "311cb6a0-4004-536b-aff8-04d49cb5cc24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186489625} {:answer/id #uuid "abe6da9b-8429-54a3-ba90-b2deefe451bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3}" :db/id #edb/ref 17592186489892} {:answer/id #uuid "f50f90e5-5553-5d0c-bfdb-c4fbba7c5236" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡3" :db/id #edb/ref 17592186490044} {:answer/id #uuid "fc4aa3c7-4608-5feb-8e43-09317d7d8264" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3" :db/id #edb/ref 17592186490064}] :answer-field/correct {:answer/id #uuid "f50f90e5-5553-5d0c-bfdb-c4fbba7c5236" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡3" :db/id #edb/ref 17592186490044} :answer-field/id #uuid "b8df4958-daa0-55e3-96a1-d8edb4b2bd89" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490173}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ee507cc2-c5c1-5dca-b8f8-28391520da63" :question/math-academy-id "q-49552" :question/problem "What is the value of ${\\int }_{e/4}^{{e}^{3}/4}\\frac{3}{x\\operatorname{ln}⁡(4x)}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡4x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4x}\\cdot 4=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e/4$ | ${e}^{3}/4$ |\n| --- | --- | --- |\n| $u$ | $1$ | $3$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{e/4}^{{e}^{3}/4}\\frac{3}{x\\operatorname{ln}⁡(4x)}\\,\\text{d}x & =3{\\int }_{e/4}^{{e}^{3}/4}\\frac{1}{\\operatorname{ln}⁡(4x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =3{\\int }_{1}^{3}\\frac{1}{u}\\cdot \\text{d}u \\\\  & =3(\\operatorname{ln}⁡|u|){|}_{1}^{3} \\\\  & =3(\\operatorname{ln}⁡3-\\operatorname{ln}⁡1) \\\\  & =3\\operatorname{ln}⁡3\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490323 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "033c65a9-0b6e-5617-bdf6-d1c79c11ea62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{64}" :db/id #edb/ref 17592186489521} {:answer/id #uuid "1988de02-4c76-594d-8656-c6c044ffadbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{16}" :db/id #edb/ref 17592186489570} {:answer/id #uuid "2dcd0755-ff5f-51d8-a229-166b71f1ef18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{64}" :db/id #edb/ref 17592186489616} {:answer/id #uuid "dff4f121-9d79-55a3-91b8-351004a0cd79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186490002} {:answer/id #uuid "f1f01b94-5019-585f-8fe7-9ef5261221ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{64}" :db/id #edb/ref 17592186490035}] :answer-field/correct {:answer/id #uuid "033c65a9-0b6e-5617-bdf6-d1c79c11ea62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{64}" :db/id #edb/ref 17592186489521} :answer-field/id #uuid "5dbf1190-a21a-5af1-a02b-35bdfc87730d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490131}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f5dba093-2258-5290-b7aa-4504e51efcbb" :question/math-academy-id "q-97131" :question/problem "Given $X∼\\text{Geom}(\\frac{1}{4}),$ compute $P(X=3).$" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(\\frac{1}{4}),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(\\frac{3}{4})}^{x-1}(\\frac{1}{4}), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X=3) & =f(3) \\\\  & ={(\\frac{3}{4})}^{2}(\\frac{1}{4}) \\\\  & =\\frac{9}{64}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490400 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0138bb0d-e12b-5e32-a749-2cfff28eaf2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x - 12 + 12 \\log{\\left(24 \\right)}" :db/id #edb/ref 17592186490398} {:answer/id #uuid "275a4506-33ca-5ecb-9e05-16f411b46fa5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x + 12" :db/id #edb/ref 17592186490401} {:answer/id #uuid "3555aad0-2803-578b-8e25-d9b747f8b523" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2 x - 6 - \\log{\\left(24 \\right)}" :db/id #edb/ref 17592186490402} {:answer/id #uuid "3dd44058-54a0-5bdc-983f-368f2dce91f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x - 12" :db/id #edb/ref 17592186490403} {:answer/id #uuid "c5fc4c0b-607c-52ce-b3d7-ef8c8cda9424" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2 x - 24 + 12 \\log{\\left(24 \\right)}" :db/id #edb/ref 17592186490409}] :answer-field/correct {:answer/id #uuid "0138bb0d-e12b-5e32-a749-2cfff28eaf2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x - 12 + 12 \\log{\\left(24 \\right)}" :db/id #edb/ref 17592186490398} :answer-field/id #uuid "e1834955-e1dd-5a91-87ec-5c78df81b919" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490410}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "23758b8b-9bec-5ac3-b6e8-fa4ac19c5bfc" :question/problem "Find the equation of the tangent to the curve $f(x)=12\\ln(2 x)$ at the point $(12,12 \\log{\\left(24 \\right)}).$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$ f=12\\ln u,\\,u=2 x.$$\n\nDifferentiating gives\n\n$$\\frac{\\text{d}f}{\\text{d}u}=\\frac{12}{u},\\,\\frac{\\text{d}u}{\\text{d}x}=2.$$\n\nWe now apply the chain rule, and we get\n\n$$\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=\\frac{\\text{d}f}{\\text{d}u}\\cdot\\frac{\\text{d}u}{\\text{d}x} \\\\ &=\\frac{12}{u}\\cdot(2) \\\\ &=\\frac{12}{2 x}\\cdot(2) \\\\ &=\\frac{12}{x}.\\end{aligned}$$\n\nTherefore, the slope $m$ of the tangent line at the point where $x=12$ is\n\n$$m=\\left.(\\frac{12}{x})\\right|_{x=12}=1.$$\n\nHence, the slope of the tangent line at the point $(12,12 \\log{\\left(24 \\right)})$ is $m=1.$ Now, we find the equation of the tangent at that point:\n\n$$\\begin{aligned}y-y_1 &=m(x-x_1) \\\\ y-(12 \\log{\\left(24 \\right)}) &=(1)(x-(12)) \\\\ y &=x - 12 + 12 \\log{\\left(24 \\right)}.\\end{aligned}$$"} {:db/id #edb/ref 17592186490408 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40aabc0b-b390-5fc8-8a17-fa253d00fd29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=20 - x" :db/id #edb/ref 17592186490404} {:answer/id #uuid "5c851fbf-5bc3-5bab-9824-5e928627f9e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x + 20" :db/id #edb/ref 17592186490405} {:answer/id #uuid "8d1e19b6-d29f-5051-8f57-9843249b4051" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=- x" :db/id #edb/ref 17592186490406} {:answer/id #uuid "9abb9e9c-f409-58e8-935e-f307b1499f93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2 x" :db/id #edb/ref 17592186490407} {:answer/id #uuid "e9997b57-24a6-57d1-bc84-325fbe4a7757" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x - 20" :db/id #edb/ref 17592186490411}] :answer-field/correct {:answer/id #uuid "40aabc0b-b390-5fc8-8a17-fa253d00fd29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=20 - x" :db/id #edb/ref 17592186490404} :answer-field/id #uuid "1555d689-e950-59fb-a3d5-8e0733c3c608" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490399}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9e9f5055-f5c3-5e44-823d-b027109ff59f" :question/problem "Find the equation of the tangent to the curve $f(x)=\\ln(21 - x)$ at the point $(20,0).$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$ f=\\ln u,\\,u=21 - x.$$\n\nDifferentiating gives\n\n$$\\frac{\\text{d}f}{\\text{d}u}=\\frac{1}{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-1.$$\n\nWe now apply the chain rule, and we get\n\n$$\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=\\frac{\\text{d}f}{\\text{d}u}\\cdot\\frac{\\text{d}u}{\\text{d}x} \\\\ &=\\frac{1}{u}\\cdot(-1) \\\\ &=\\frac{1}{21 - x}\\cdot(-1) \\\\ &=\\frac{1}{x - 21}.\\end{aligned}$$\n\nTherefore, the slope $m$ of the tangent line at the point where $x=20$ is\n\n$$m=\\left.(\\frac{1}{x - 21})\\right|_{x=20}=-1.$$\n\nHence, the slope of the tangent line at the point $(20,0)$ is $m=-1.$ Now, we find the equation of the tangent at that point:\n\n$$\\begin{aligned}y-y_1 &=m(x-x_1) \\\\ y-(0) &=(-1)(x-(20)) \\\\ y &=20 - x.\\end{aligned}$$"} {:db/id #edb/ref 17592186490425 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aaf162d-5ca8-52c8-940b-b581f50b49be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5\\tanh (\\frac{5x}{4}) + C" :db/id #edb/ref 17592186490417} {:answer/id #uuid "1bfa550c-25bb-53a3-a3ae-4537f367c39d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}\\tanh (\\frac{4x}{5}) + C" :db/id #edb/ref 17592186490419} {:answer/id #uuid "3e9dcc3c-5b33-5a29-9ca6-c6dd8074ee93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}\\tanh^{2} (\\frac{4x}{5}) + C" :db/id #edb/ref 17592186490427} {:answer/id #uuid "a4a5c8e8-59d5-53ee-9aaa-e292b15986f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}\\csch^{2} (\\frac{4x}{5}) + C" :db/id #edb/ref 17592186490459} {:answer/id #uuid "d6baf139-0216-57c5-8f75-c6bffa001d6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}\\tanh (\\frac{4x}{5})\\sech (\\frac{4x}{5}) + C" :db/id #edb/ref 17592186490473}] :answer-field/correct {:answer/id #uuid "1bfa550c-25bb-53a3-a3ae-4537f367c39d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}\\tanh (\\frac{4x}{5}) + C" :db/id #edb/ref 17592186490419} :answer-field/id #uuid "6f3f11ba-dde6-53fc-b6bc-2639bc537204" :answer-fie