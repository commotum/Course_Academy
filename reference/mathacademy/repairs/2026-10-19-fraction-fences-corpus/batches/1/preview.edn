fty }[\\operatorname{arctan}⁡(\\frac{a}{\\sqrt{3}})].\\end{aligned}\n$$\n\nNow, recall the end behavior of the function $y=\\operatorname{arctan}⁡(\\frac{x}{\\sqrt{3}}),$ shown in the graph below:\n\n- ${lim}_{x\\to -\\infty }[\\operatorname{arctan}⁡(\\frac{x}{\\sqrt{3}})]=-\\frac{\\pi }{2}$\n\n- ${lim}_{x\\to \\infty }[\\operatorname{arctan}⁡(\\frac{x}{\\sqrt{3}})]=\\frac{\\pi }{2}$\n\n![](images/11/11c74897fe914599a78c5997767bad83d13ddfb1e35ee66622d8880743688bad.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{1}\\frac{1}{{u}^{2}+3}\\,\\text{d}u & =\\frac{\\pi }{6\\sqrt{3}}-\\frac{1}{\\sqrt{3}}\\cdot {lim}_{a\\to -\\infty }[\\operatorname{arctan}⁡(\\frac{a}{\\sqrt{3}})] \\\\  & =\\frac{\\pi }{6\\sqrt{3}}-\\frac{1}{\\sqrt{3}}\\cdot (-\\frac{\\pi }{2}) \\\\  & =\\frac{2\\pi }{3\\sqrt{3}}.\\end{aligned}\n$$" 13194139538225 17592186576411 false] [17592186253551 1074 "First, let's recall the following result:\n\n$$\n\\int \\frac{1}{{k}^{2}+{x}^{2}}\\,\\text{d}x=\\frac{1}{k}\\operatorname{arctan}⁡\\left(\\frac{x}{k}\\right)+C\n$$\n\nWe proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{1}\\frac{1}{{u}^{2}+3}\\,\\text{d}u & ={lim}_{a\\to -\\infty }{\\int }_{a}^{1}\\frac{1}{{u}^{2}+3}\\,\\text{d}u \\\\  & ={lim}_{a\\to -\\infty }{\\int }_{a}^{1}\\frac{1}{{u}^{2}+{(\\sqrt{3})}^{2}}\\,\\text{d}u \\\\  & ={lim}_{a\\to -\\infty }{[\\frac{1}{\\sqrt{3}}\\cdot \\operatorname{arctan}⁡\\left(\\frac{u}{\\sqrt{3}}\\right)]}_{a}^{1} \\\\  & =\\frac{1}{\\sqrt{3}}\\cdot {lim}_{a\\to -\\infty }[\\operatorname{arctan}⁡\\left(\\frac{1}{\\sqrt{3}}\\right)-\\operatorname{arctan}⁡\\left(\\frac{a}{\\sqrt{3}}\\right)] \\\\  & =\\frac{1}{\\sqrt{3}}\\cdot {lim}_{a\\to -\\infty }[\\frac{\\pi }{6}-\\operatorname{arctan}⁡\\left(\\frac{a}{\\sqrt{3}}\\right)] \\\\  & =\\frac{\\pi }{6\\sqrt{3}}-\\frac{1}{\\sqrt{3}}\\cd