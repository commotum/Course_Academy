}{4}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186256397 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fc04807-b343-515b-9c43-7382684abb13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cos}⁡(\\frac{\\pi }{8})" :db/id #edb/ref 17592186253811} {:answer/id #uuid "474a2bcd-a05b-55df-819f-946a0389240f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cos}⁡(\\frac{\\pi }{4})" :db/id #edb/ref 17592186254275} {:answer/id #uuid "765c96ab-63cf-5369-9efe-a918084b0992" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{cos}⁡(\\frac{\\pi }{4})" :db/id #edb/ref 17592186254714} {:answer/id #uuid "7dd5a3a3-2244-571c-a76f-0674c6cff271" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{cos}⁡(\\frac{\\pi }{8})" :db/id #edb/ref 17592186254785} {:answer/id #uuid "9a878f24-4030-5bee-92fd-e58cdacc282e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\operatorname{cos}⁡(\\frac{\\pi }{4})" :db/id #edb/ref 17592186255034}] :answer-field/correct {:answer/id #uuid "765c96ab-63cf-5369-9efe-a918084b0992" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{cos}⁡(\\frac{\\pi }{4})" :db/id #edb/ref 17592186254714} :answer-field/id #uuid "38cdbaa8-adb7-5d1c-a1c4-ebe21d0fa1d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256024}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6564bb9b-39cf-5d47-ba17-b3f0f77c4c7a" :question/math-academy-id "q-120358" :question/problem "Express $3-6{sin}^{2}⁡(\\frac{\\pi }{8})$ as a single trigonometric ratio." :question/worked-solution "Our expression can be factored as follows:\n\n$$\n3(1-2{sin}^{2}⁡(\\frac{\\pi }{8}))\n$$\n\nNow, let's recall the double-angle formula for cosine:\n\n$$\n1-2{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{8}$ into the above, we get\n\n$$\n\\begin{aligned}1-2{sin}^{2}⁡(\\frac{\\pi }{8}) & =\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{8})=\\operatorname{cos}⁡(\\frac{\\pi }{4}).\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}3(1-2{sin}^{2}⁡(\\frac{\\pi }{8})) & =3\\operatorname{cos}⁡(\\frac{\\pi }{4}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186256399 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0778ee07-8e08-5767-b5b5-39fa9f5bd3b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186253726} {:answer/id #uuid "3141858b-3546-56b0-a225-f1d26fc10b70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186254099} {:answer/id #uuid "50e838be-c2e5-56cd-bd3f-42e1ef0167bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186254372} {:answer/id #uuid "7bc93bfa-7e8d-5884-82ed-7bd2edacb355" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186254772} {:answer/id #uuid "e9177016-3d33-5bdf-b43c-ff255bcb6f8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186255717}] :answer-field/correct {:answer/id #uuid "50e838be-c2e5-56cd-bd3f-42e1ef0167bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186254372} :answer-field/id #uuid "32edd36e-c1e8-57b1-927a-22604b1325fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256011}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "908ae38c-0e5f-5da6-8253-8eb427ca6c40" :question/math-academy-id "q-120367" :question/problem "Find the exact value of ${cos}^{2}⁡(\\frac{3\\pi }{8})-{sin}^{2}⁡(\\frac{3\\pi }{8}).$" :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n{cos}^{2}⁡x-{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x=\\frac{3\\pi }{8}$ into the above, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡(\\frac{3\\pi }{8})-{sin}^{2}⁡(\\frac{3\\pi }{8}) & =\\operatorname{cos}⁡(2\\cdot \\frac{3\\pi }{8}) \\\\  & =\\operatorname{cos}⁡(\\frac{3\\pi }{4}) \\\\  & =-\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186256407 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a155516-d839-587a-bed9-42b9a2e072c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6\\sqrt{3},-6)" :db/id #edb/ref 17592186253747} {:answer/id #uuid "1129da34-d7d1-5e9f-8843-f5403e6bf93a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\sqrt{3},-2\\sqrt{3})" :db/id #edb/ref 17592186253820} {:answer/id #uuid "12c049a4-b3f5-57ad-8839-06ff45915613" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{3},-6)" :db/id #edb/ref 17592186253833} {:answer/id #uuid "4009cc1a-951f-501b-bdc2-6e69fb5a6357" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4\\sqrt{3},-\\sqrt{3})" :db/id #edb/ref 17592186254222} {:answer/id #uuid "a9834412-7636-54d2-8673-12769dbe9d79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6,-6)" :db/id #edb/ref 17592186255166}] :answer-field/correct {:answer/id #uuid "0a155516-d839-587a-bed9-42b9a2e072c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6\\sqrt{3},-6)" :db/id #edb/ref 17592186253747} :answer-field/id #uuid "e4d936aa-147e-55d6-93f2-fbed67c48196" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256328}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b0e5e2dd-de81-57dc-8848-06ae6eac4cea" :question/math-academy-id "q-120455" :question/problem "The point $A$ has polar coordinates $(r,\\frac{5\\pi }{6})$ and the point $B$ has polar coordinates $({r}^{2},\\frac{11\\pi }{6}).$ Find the Cartesian coordinates of $B$ given that the Cartesian coordinates of $A$ are $(-3,\\sqrt{3}).$" :question/worked-solution "First, we use the Cartesian coordinates of $A$ to find $r,$ the distance between $A$ and the origin:\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-3)^{2}+(\\sqrt{3})^{2}} \\\\  & =\\sqrt{12}\\end{aligned}\n$$\n\nConsequently, the polar coordinates of $B$ are\n\n$$\n((\\sqrt{12})^{2},\\frac{11\\pi }{6})=(12,\\frac{11\\pi }{6}).\n$$\n\n \n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =12\\operatorname{cos}⁡(\\frac{11\\pi }{6}) \\\\  & =12(\\frac{\\sqrt{3}}{2}) \\\\  & =6\\sqrt{3}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =12\\operatorname{sin}⁡(\\frac{11\\pi }{6}) \\\\  & =12(-\\frac{1}{2}) \\\\  & =-6\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(6\\sqrt{3},-6).$"} {:db/id #edb/ref 17592186256408 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33b5ead7-4261-5181-bae9-8edc851a01fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7.3" :db/id #edb/ref 17592186254116} {:answer/id #uuid "53c8fd3b-2fd0-5b9a-bac3-5049e7f07722" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.6" :db/id #edb/ref 17592186254400} {:answer/id #uuid "6f17da58-1b39-5035-8664-3b88056d92f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.2" :db/id #edb/ref 17592186254656} {:answer/id #uuid "8be118cd-881d-5ff8-8a55-84e1e1df7e31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.7" :db/id #edb/ref 17592186254905} {:answer/id #uuid "95701b13-51f4-5588-a847-64a93ea10cc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.2" :db/id #edb/ref 17592186254986}] :answer-field/correct {:answer/id #uuid "53c8fd3b-2fd0-5b9a-bac3-5049e7f07722" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.6" :db/id #edb/ref 17592186254400} :answer-field/id #uuid "76309cc7-4194-5ebe-adb7-704c2a92dd3b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256140}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ff4d5343-cd4d-538f-a96e-adc01ab24678" :question/math-academy-id "q-120456" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $3\\operatorname{sec}⁡x+2\\sqrt{5}=-\\sqrt{5}$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2},$ rounded to one decimal place?" :question/worked-solution "We first simplify the given equation.\n\n$$\n\\begin{aligned}3\\operatorname{sec}⁡x+2\\sqrt{5} & =-\\sqrt{5} \\\\ 3\\operatorname{sec}⁡x & =-3\\sqrt{5} \\\\ \\operatorname{sec}⁡x & =-\\sqrt{5}.\\end{aligned}\n$$\n\nRecall that $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{cos}⁡x=\\frac{1}{(-\\sqrt{5})}=-\\frac{\\sqrt{5}}{5}.\n$$\n\nFirst, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arccos}⁡(-\\frac{\\sqrt{5}}{5})=2.034\\,443…≈2.034\\,4.\\end{aligned}\n$$\n\nSince $2.034\\,4$ lies inside the required domain, our first solution is ${x}_{1}=2.034\\,4.$\n\nOur first solution lies in the second quadrant and has a reference angle of ${\\theta }_{R}=1.107\\,2.$ Since $\\operatorname{cos}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}=1.107\\,2.$\n\n![](images/f6/f659a13a5a4c9ae998c33b398b777decc8a5603fd18b5579ddebc897ea3dafca.png)\n\nSince the second solution ${x}_{2}$ lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi +{\\theta }_{R} \\\\  & =\\pi +1.107\\,2 \\\\  & =4.248\\,7\\end{aligned}\n$$\n\nFinally, \n\n$$\n{x}_{1}\\cdot {x}_{2}=2.034\\,4\\cdot 4.248\\,7≈8.6,\n$$\n\nrounded to one decimal place."} {:db/id #edb/ref 17592186256409 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15a02ee7-0c84-56f1-bbf0-ebb90394da60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-2\\sqrt{3})" :db/id #edb/ref 17592186253859} {:answer/id #uuid "39bbabdf-ded0-54de-9bce-39f8a04d806d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-4)" :db/id #edb/ref 17592186254176} {:answer/id #uuid "6f9d34e5-3a45-5295-96d7-05130d5b7bc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,0)" :db/id #edb/ref 17592186254659} {:answer/id #uuid "7a7d44b2-7e30-57fa-9135-30c7aad08a99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\sqrt{3},-2)" :db/id #edb/ref 17592186254758} {:answer/id #uuid "c869f985-2a3d-5a8b-ba06-6ea45dcdacab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,3)" :db/id #edb/ref 17592186255454}] :answer-field/correct {:answer/id #uuid "39bbabdf-ded0-54de-9bce-39f8a04d806d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-4)" :db/id #edb/ref 17592186254176} :answer-field/id #uuid "8600f656-d47f-52c4-96f7-5d633c8eeb59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256169}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6d3f790c-6d1a-5380-94bb-56056dda53c1" :question/math-academy-id "q-120468" :question/problem "The point $A$ has polar coordinates $(2,\\theta )$ and the point $B$ has polar coordinates $(4,\\theta +\\frac{\\pi }{3}).$ Find the Cartesian coordinates of $B$ given that the Cartesian coordinates of $A$ are $(-\\sqrt{3},-1).$" :question/worked-solution "First, we use the Cartesian coordinates of $A$ to find its reference angle ${\\theta }_{R}:$\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡(\\frac{-1}{-\\sqrt{3}}) \\\\  & =\\operatorname{arctan}⁡(1/\\sqrt{3}) \\\\  & =\\frac{\\pi }{6}.\\end{aligned}\n$$\n\nSince the point $A$ lies in the third quadrant, we have $\\theta =\\pi +{\\theta }_{R}=\\frac{7\\pi }{6}.$ Consequently, the polar coordinates of $B$ are\n\n$$\n(4,\\frac{7\\pi }{6}+\\frac{\\pi }{3})=(4,\\frac{3\\pi }{2}).\n$$\n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =4\\cdot \\operatorname{cos}⁡(\\frac{3\\pi }{2}) \\\\  & =0\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =4\\cdot \\operatorname{sin}⁡(\\frac{3\\pi }{2}) \\\\  & =-4\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(0,-4).$"} {:db/id #edb/ref 17592186256420 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2091764e-429a-5c3f-a877-70cb4a1c05b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,126" :db/id #edb/ref 17592186253955} {:answer/id #uuid "5bb917f6-05fa-559d-9086-4a8152b03f56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,123" :db/id #edb/ref 17592186254481} {:answer/id #uuid "6fd4c83e-ed85-5c69-bbb6-94d92f459325" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,986" :db/id #edb/ref 17592186254661} {:answer/id #uuid "834f6f97-baa8-53fd-be18-800964bc53ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,567" :db/id #edb/ref 17592186254840} {:answer/id #uuid "b473192c-7fc3-5109-824f-7d0c04f782d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,874" :db/id #edb/ref 17592186255260}] :answer-field/correct {:answer/id #uuid "2091764e-429a-5c3f-a877-70cb4a1c05b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,126" :db/id #edb/ref 17592186253955} :answer-field/id #uuid "92f7d3b1-deed-5195-8f0e-90908fbf484b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256189}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c0bd99b-6e40-58e5-9873-3f39651f2371" :question/math-academy-id "q-120548" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{csc}⁡x=3$ for ${0}^{∘}\\le x<{360}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2},$ rounded to the nearest integer?" :question/worked-solution "Recall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=\\frac{1}{3}.\n$$\n\nNow, we find the principal value:\n\n$$\nx=\\operatorname{arcsin}⁡(\\frac{1}{3})=(19.471\\,2…)^{∘}≈{19.471}^{∘}\n$$\n\nSince ${19.471}^{∘}$ lies inside the given domain, our first solution is ${x}_{1}={19.471}^{∘}.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}={19.471}^{∘}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has a reference angle ${\\theta }_{R}={19.471}^{∘}.$\n\n![](images/05/05f0e5d6558c90bf467284d6b0ef17e7cfb546873bcf978e3d0cd8872c1f4436.png)\n\nSince the second solution ${x}_{2}$ lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}-{\\theta }_{R} \\\\  & ={180}^{∘}-{19.471}^{∘} \\\\  & ={160.529}^{∘}\\end{aligned}\n$$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}≈19.471\\cdot 160.529=3\\,126\n$$\n\nrounded to the nearest integer."} {:db/id #edb/ref 17592186256421 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cb20bf3-5fcc-5103-81c7-45679cfd13d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "68\\,547" :db/id #edb/ref 17592186254327} {:answer/id #uuid "4dd8c947-2e75-5db2-8498-25f9353661d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "65\\,571" :db/id #edb/ref 17592186254339} {:answer/id #uuid "89531541-f8fa-5cb2-9c9a-21a06b57f507" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70\\,266" :db/id #edb/ref 17592186254888} {:answer/id #uuid "9c4f9730-a0bc-5c79-b27b-15e188939449" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "62\\,236" :db/id #edb/ref 17592186255046} {:answer/id #uuid "be7c19ab-b673-5993-85ac-e8571be79fc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "76\\,234" :db/id #edb/ref 17592186255370}] :answer-field/correct {:answer/id #uuid "89531541-f8fa-5cb2-9c9a-21a06b57f507" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70\\,266" :db/id #edb/ref 17592186254888} :answer-field/id #uuid "99890995-05f4-5a18-8718-75daa7049119" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256202}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c30ff67b-fcaa-5191-a317-8a809ace1593" :question/math-academy-id "q-120554" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{csc}⁡x=-\\frac{8}{5}$ for ${0}^{∘}\\le x<{360}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2},$ rounded to the nearest integer?" :question/worked-solution "Recall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=-\\frac{5}{8}.\n$$\n\nNow, we find the principal value:\n\n$$\nx=\\operatorname{arcsin}⁡(-\\frac{5}{8})=(-38.682\\,1…)^{∘}≈-{38.682}^{∘}\n$$\n\nThis value is outside the required domain. To get a value inside the range, we add ${360}^{∘}.$\n\n$$\n{x}_{1}=-{38.682}^{∘}+{360}^{∘}={321.318}^{∘}\n$$\n\nSo, our first solution is ${x}_{1}={321.318}^{∘}.$\n\nOur first solution lies in the fourth quadrant and has a reference angle of ${\\theta }_{R}={38.682}^{∘}.$ Since $\\operatorname{sin}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}={38.682}^{∘}.$\n\n![](images/f4/f4ddf01db733d5ee2e73a4b8abb0bec84d9ee2f7be0fea03e99c112456be1c14.png)\n\nSince the second solution ${x}_{2}$ lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}+{\\theta }_{R} \\\\  & ={180}^{∘}+{38.682}^{∘} \\\\  & ={218.682}^{∘}\\end{aligned}\n$$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=321.318\\cdot 218.682≈70\\,266\n$$\n\nrounded to the nearest integer."} {:db/id #edb/ref 17592186256422 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02ff9959-ca10-5d50-995e-9e7fc0a2ad71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21.6" :db/id #edb/ref 17592186253691} {:answer/id #uuid "1e6614a7-5303-5a86-b8cd-80177e3f6c89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18.3" :db/id #edb/ref 17592186253927} {:answer/id #uuid "cf956aba-0090-5814-94bf-4c8327470726" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19.5" :db/id #edb/ref 17592186255518} {:answer/id #uuid "de82359d-710c-5888-a2ae-b5acf0631f1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22.4" :db/id #edb/ref 17592186255645} {:answer/id #uuid "fc2b8802-7b55-5d8a-a56d-40851bbbb9e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20.2" :db/id #edb/ref 17592186255886}] :answer-field/correct {:answer/id #uuid "fc2b8802-7b55-5d8a-a56d-40851bbbb9e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20.2" :db/id #edb/ref 17592186255886} :answer-field/id #uuid "dad99ebe-2b05-56c4-9d59-745b53b7613f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256311}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "18ab8ec6-b553-56a9-a2fc-b97b7ef3fec1" :question/math-academy-id "q-120556" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{csc}⁡x=-6$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2},$ rounded to one decimal place?" :question/worked-solution "Recall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=-\\frac{1}{6}.\n$$\n\nNow, we find the principal value:\n\n$$\nx=\\operatorname{arcsin}⁡(-\\frac{1}{6})=-0.167\\,448…≈-0.167\\,4\n$$\n\nThis value is outside the required domain. To get a value inside the range, we add $2\\pi .$\n\n$$\n{x}_{1}=-0.167\\,4+2\\pi =6.115\\,785…≈6.115\\,8\n$$\n\nOur first solution lies in the fourth quadrant and has a reference angle of ${\\theta }_{R}=0.167\\,4.$ Since $\\operatorname{sin}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}=0.167\\,4.$\n\n![](images/f6/f6f08d799cd2d2e80494d94cc3b18a61f73227b88b25d79c926d65e161d4ce3a.png)\n\nSince the second solution ${x}_{2}$ lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi +{\\theta }_{R} \\\\  & =\\pi +0.167\\,4 \\\\  & ≈3.309\\,0\\end{aligned}\n$$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=6.115\\,8\\cdot 3.309\\,0=20.2\n$$\n\nrounded to one decimal place."} {:db/id #edb/ref 17592186256423 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5da02127-9e0f-517d-b833-10a14ea966be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,3\\sqrt{3})" :db/id #edb/ref 17592186254500} {:answer/id #uuid "872e2a4f-200b-5af7-8500-67bf6abe3f22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,3)" :db/id #edb/ref 17592186254867} {:answer/id #uuid "aa36bbb1-b88c-5b72-bb8b-94823eb95074" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3\\sqrt{2},\\sqrt{3})" :db/id #edb/ref 17592186255175} {:answer/id #uuid "d7f185a7-e803-56ef-9e38-6ce29b1a5f8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3\\sqrt{2},3)" :db/id #edb/ref 17592186255586} {:answer/id #uuid "e8f56308-c9ed-5d20-99cf-9b1ba40c9435" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{2},3\\sqrt{3})" :db/id #edb/ref 17592186255716}] :answer-field/correct {:answer/id #uuid "5da02127-9e0f-517d-b833-10a14ea966be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,3\\sqrt{3})" :db/id #edb/ref 17592186254500} :answer-field/id #uuid "562137bc-c0ee-5964-b8f9-1d239f29ef6c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256088}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ec6a7f4f-9f9a-5a0c-bdce-ef6083c2204a" :question/math-academy-id "q-120593" :question/problem "![](images/48/48517c5d3fa340bed1cc7b5493f0099a72afa79d9e0690b79695afe018c8a05c.png)\n\nThe diagram above shows a circle of radius $r$ centered at the origin. If the polar coordinates of the point $A$ are $(6,\\frac{\\pi }{6})$ and $m∠AOB=\\frac{\\pi }{2},$ what are the Cartesian coordinates of $B?$" :question/worked-solution "First, since $A$ has polar coordinates $(6,\\frac{\\pi }{6}),$ we must have $r=6.$ Also, since the points $A$ and $B$ both lie on a circle of radius $6,$ the $r$-coordinate of $B$ must also be $6.$ \n\nNotice that one must traverse the circle counterclockwise to move from the point $A$ to point $B.$ Since the $\\theta $-coordinate of $A$ is $\\frac{\\pi }{6},$ the $\\theta $-coordinate of $B$ must be\n\n$$\n{\\theta }_{B}=\\frac{\\pi }{6}+\\frac{\\pi }{2}=\\frac{2\\pi }{3}.\n$$\n\nSo, the polar coordinates of $B$ are $(6,\\frac{2\\pi }{3})$ \n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =6\\operatorname{cos}⁡(\\frac{2\\pi }{3}) \\\\  & =6(-\\frac{1}{2}) \\\\  & =-3\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =6\\operatorname{sin}⁡(\\frac{2\\pi }{3}) \\\\  & =6(\\frac{\\sqrt{3}}{2}) \\\\  & =3\\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(-3,3\\sqrt{3}).$"} {:db/id #edb/ref 17592186256424 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b0831bf-55aa-510a-918a-90cd99cdc701" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,2)" :db/id #edb/ref 17592186254315} {:answer/id #uuid "54a4837d-2402-5b85-885b-20b64294842f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\sqrt{3},2\\sqrt{3})" :db/id #edb/ref 17592186254408} {:answer/id #uuid "7962a6c2-849e-5bfd-90f7-16eb630fa284" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\sqrt{3},-2)" :db/id #edb/ref 17592186254745} {:answer/id #uuid "87c149ae-d2b4-5a7d-8b6f-ca93c28e9563" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2\\sqrt{3},2)" :db/id #edb/ref 17592186254874} {:answer/id #uuid "f870bd85-6f4b-5e70-909a-8712db2320fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,2\\sqrt{3})" :db/id #edb/ref 17592186255845}] :answer-field/correct {:answer/id #uuid "f870bd85-6f4b-5e70-909a-8712db2320fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,2\\sqrt{3})" :db/id #edb/ref 17592186255845} :answer-field/id #uuid "da62c4ed-dbe1-5f2f-b50d-04b6985ed206" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256309}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0eb03380-bb2e-5373-833c-3b08aac5da8c" :question/math-academy-id "q-120595" :question/problem "![](images/5f/5ff0219f3f76441dbffc770ce0b8f2481cca8c46b8aa832ab7893d472f3026ae.png)\n\nThe diagram above shows a circle of radius $r$ centered at the origin. If the polar coordinates of the point $A$ are $(4,\\frac{5\\pi }{6})$ and $m∠AOB=\\frac{\\pi }{6},$ what are the Cartesian coordinates of $B?$" :question/worked-solution "First, since $A$ has polar coordinates $(4,\\frac{5\\pi }{6}),$ we must have $r=4.$ Also, since the points $A$ and $B$ both lie on a circle of radius $4,$ the $r$-coordinate of $B$ must also be $4.$\n\nNotice that one must traverse the circle clockwise to move from the point $A$ to point $B.$ Since the $\\theta $-coordinate of $A$ is $\\frac{5\\pi }{6},$ the $\\theta $-coordinate of $B$ must be\n\n$$\n{\\theta }_{B}=\\frac{5\\pi }{6}-\\frac{\\pi }{6}=\\frac{2\\pi }{3}.\n$$\n\nSo, the polar coordinates of $B$ are $(4,\\frac{2\\pi }{3})$ \n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =4\\operatorname{cos}⁡(\\frac{2\\pi }{3}) \\\\  & =4\\cdot (-\\frac{1}{2}) \\\\  & =-2\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =4\\operatorname{sin}⁡(\\frac{2\\pi }{3}) \\\\  & =4\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =2\\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(-2,2\\sqrt{3}).$"} {:db/id #edb/ref 17592186256425 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0484ad77-2f99-5c81-a6cb-a1158be44d88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-2)" :db/id #edb/ref 17592186253704} {:answer/id #uuid "15246ab6-3ecb-5633-9b4e-b73f8ed07f54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4\\sqrt{2},-4)" :db/id #edb/ref 17592186253853} {:answer/id #uuid "31095a2e-0934-55af-abe5-a2f05014f85f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,-4)" :db/id #edb/ref 17592186254098} {:answer/id #uuid "3f307f37-58c4-56a4-a6dd-e9b99b686e71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,4\\sqrt{2})" :db/id #edb/ref 17592186254213} {:answer/id #uuid "e1629e74-354a-56e5-bbe5-bfd524f9a56f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-2\\sqrt{2})" :db/id #edb/ref 17592186255670}] :answer-field/correct {:answer/id #uuid "31095a2e-0934-55af-abe5-a2f05014f85f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,-4)" :db/id #edb/ref 17592186254098} :answer-field/id #uuid "e62cfd60-2bdd-5ae1-8632-0391624de18c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256330}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4cadc848-bed5-5538-a431-ac83515fffa4" :question/math-academy-id "q-120597" :question/problem "![](images/fd/fd38e4bed4f11f07f2c6901a74c7543655f5ff8a95b8b049e54ff4ff4dd409ee.png)\n\nThe diagram above shows a circle of radius $r$ centered at the origin. If the polar coordinates of the point $A$ are $(4\\sqrt{2},{150}^{∘})$ and $m∠AOB={165}^{∘},$ what are the Cartesian coordinates of $B?$" :question/worked-solution "First, since $A$ has polar coordinates $(4\\sqrt{2},{150}^{∘}),$ we must have $r=4\\sqrt{2}.$ Also, since the points $A$ and $B$ both lie on a circle of radius $4\\sqrt{2},$ the $r$-coordinate of $B$ must also be $4\\sqrt{2}.$  \n\nNotice that one must traverse the circle counterclockwise to move from the point $A$ to point $B.$ Since the $\\theta $-coordinate of $A$ is ${150}^{∘},$ the $\\theta $-coordinate of $B$ must be\n\n$$\n{\\theta }_{B}={150}^{∘}+{165}^{∘}={315}^{∘}.\n$$\n\nSo, the polar coordinates of $B$ are $(4\\sqrt{2},{315}^{∘})$\n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =4\\sqrt{2}\\operatorname{cos}⁡({315}^{∘}) \\\\  & =4\\sqrt{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =4\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =4\\sqrt{2}\\operatorname{sin}⁡({315}^{∘}) \\\\  & =4\\sqrt{2}(-\\frac{\\sqrt{2}}{2}) \\\\  & =-4\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(4,-4).$"} {:db/id #edb/ref 17592186256426 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9724a5f6-c9f4-536a-a17b-5425407b9c7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,1)" :db/id #edb/ref 17592186255002} {:answer/id #uuid "ea54590c-b0df-5003-9417-4c09af7236b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{2},\\sqrt{2})" :db/id #edb/ref 17592186255723} {:answer/id #uuid "eb87a981-771e-5056-8d37-a93f3b1e2bef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,2)" :db/id #edb/ref 17592186255730} {:answer/id #uuid "feab8e4b-ee4c-5116-8ef8-f1f48cf2bd2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{2},2)" :db/id #edb/ref 17592186255909} {:answer/id #uuid "ff088a24-bea8-531d-8f92-d5dff5c8b72a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,\\sqrt{2})" :db/id #edb/ref 17592186255913}] :answer-field/correct {:answer/id #uuid "ea54590c-b0df-5003-9417-4c09af7236b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{2},\\sqrt{2})" :db/id #edb/ref 17592186255723} :answer-field/id #uuid "47c6223c-72f8-56bd-b93f-b161db175405" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256059}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1f77f386-bd94-517d-b58d-73799834bcb9" :question/math-academy-id "q-120598" :question/problem "![](images/47/475bda1ee758774ec9b07ec12a0ed92e56c4b571fd39f6e1ecca439278106ea6.png)\n\nThe diagram above shows a circle of radius $r$ centered at the origin. If the polar coordinates of the point $A$ are $(2,{240}^{∘})$ and $m∠AOB={195}^{∘},$ what are the Cartesian coordinates of $B?$" :question/worked-solution "First, since $A$ has polar coordinates $(2,{240}^{∘}),$ we must have $r=2.$ Also, since the points $A$ and $B$ both lie on a circle of radius $2,$ the $r$-coordinate of $B$ must also be $2.$\n\nNotice that one must traverse the circle clockwise to move from the point $A$ to point $B.$ Since the $\\theta $-coordinate of $A$ is ${240}^{∘},$ the $\\theta $-coordinate of $B$ must be\n\n$$\n{\\theta }_{B}={240}^{∘}-{195}^{∘}={45}^{∘}.\n$$\n\nSo, the polar coordinates of $B$ are $(2,{45}^{∘})$\n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =2\\operatorname{cos}⁡({45}^{∘}) \\\\  & =2(\\frac{\\sqrt{2}}{2}) \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{sin}⁡({45}^{∘}) \\\\  & =2\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(\\sqrt{2},\\sqrt{2}).$"} {:db/id #edb/ref 17592186256431 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35b00e56-99c0-5706-aec6-79ab05598dda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7{\\pi }^{2}}{36}" :db/id #edb/ref 17592186254130} {:answer/id #uuid "6079de38-3285-57e6-8b59-3cc5bad9ac43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{\\pi }^{2}}{16}" :db/id #edb/ref 17592186254532} {:answer/id #uuid "ab45b7be-44e4-53d7-a2f2-be9280280603" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{\\pi }^{2}}{9}" :db/id #edb/ref 17592186255186} {:answer/id #uuid "ece76c8a-f554-5422-b4e9-f3ba3739514d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{36}" :db/id #edb/ref 17592186255739} {:answer/id #uuid "ee9d5d58-cce1-5e5c-b181-7a32a338888c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{9}" :db/id #edb/ref 17592186255758}] :answer-field/correct {:answer/id #uuid "35b00e56-99c0-5706-aec6-79ab05598dda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7{\\pi }^{2}}{36}" :db/id #edb/ref 17592186254130} :answer-field/id #uuid "da9be1bf-8d9a-5b46-ad0f-b45329449304" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256310}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8f20dda6-3a55-548a-ac2e-a4d15dbbe959" :question/math-academy-id "q-120620" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{cot}⁡x=\\frac{3}{\\sqrt{3}}$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "Recall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{tan}⁡x=\\frac{\\sqrt{3}}{3}.\n$$\n\nFirst, we find the principal value:\n\n$$\n\\begin{aligned}x=\\text{arctan}(\\frac{\\sqrt{3}}{3})=\\frac{\\pi }{6}\\end{aligned}\n$$\n\nSince $\\frac{\\pi }{6}$ lies inside the given domain, our first solution is ${x}_{1}=\\frac{\\pi }{6}.$\n\nTo generate more solutions, we add integer multiples of $\\pi .$ Hence,\n\n$$\n{x}_{2}=\\pi +x=\\pi +\\frac{\\pi }{6}=\\frac{7\\pi }{6}.\n$$\n\nSo, the solutions are ${x}_{1}=\\frac{\\pi }{6},\\frac{7\\pi }{6}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{\\pi }{6}\\cdot \\frac{7\\pi }{6}=\\frac{7{\\pi }^{2}}{36}.\n$$"} {:db/id #edb/ref 17592186256432 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2533049f-d0b6-55bf-9490-7bc9eca47b05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "37\\,563" :db/id #edb/ref 17592186254002} {:answer/id #uuid "3543b0d2-1ed1-5145-82a0-e37c8e888b64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "33\\,126" :db/id #edb/ref 17592186254126} {:answer/id #uuid "5defef99-6ec3-5fd8-a91e-5d3849a1091a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "44\\,278" :db/id #edb/ref 17592186254504} {:answer/id #uuid "9d2faedb-f95d-57b2-a718-041767b1455e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "43\\,245" :db/id #edb/ref 17592186255051} {:answer/id #uuid "dac8d116-50f3-540c-bc08-46c92ec8ff41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35\\,986" :db/id #edb/ref 17592186255613}] :answer-field/correct {:answer/id #uuid "2533049f-d0b6-55bf-9490-7bc9eca47b05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "37\\,563" :db/id #edb/ref 17592186254002} :answer-field/id #uuid "4ce788e7-18a1-56ff-9042-919e8aee21d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256070}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "168b3003-ea4a-5b92-b974-1dea82577827" :question/math-academy-id "q-120626" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation  $\\operatorname{cot}⁡x=-\\frac{2}{3}$ for ${0}^{∘}\\le x<{360}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2},$ rounded to the nearest integer?" :question/worked-solution "Recall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{tan}⁡x=-\\frac{3}{2}.\n$$\n\nNow, we find the principal value:\n\n$$\n\\begin{aligned}x=\\text{arctan}(-\\frac{3}{2})=-(56.309\\,9…)^{∘}≈-{56.310}^{∘}\\end{aligned}\n$$\n\nSince $-{56.310}^{∘}$ lies outside the given domain, it is not a solution.\n\nTo generate more solutions, we add integer multiples of ${180}^{∘}.$ Hence,\n\n$$\n{x}_{1}={180}^{∘}+x={180}^{∘}-{56.310}^{∘}={123.690}^{∘},\\,\\,{x}_{2}={360}^{∘}+x={360}^{∘}-{56.310}^{∘}={303.690}^{∘}.\n$$\n\nFinally, the numerical value of ${x}_{1}\\cdot {x}_{2}$ is\n\n$$\n123.690\\cdot 303.690≈37\\,563\n$$\n\nrounded to the nearest integer."} {:db/id #edb/ref 17592186256433 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32f633d2-ac2f-521a-9a1e-70e7839c56a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.5" :db/id #edb/ref 17592186254111} {:answer/id #uuid "8ad7ac66-1ea0-5a71-8600-368aaef995f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2.1" :db/id #edb/ref 17592186254897} {:answer/id #uuid "8d6bc622-ea86-5c50-bfc6-8d8e67fb651b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1.2" :db/id #edb/ref 17592186254918} {:answer/id #uuid "947f827a-620b-5deb-a17e-14682da17b8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1.8" :db/id #edb/ref 17592186254973} {:answer/id #uuid "94def4e9-5e70-55c6-ad4f-ef99974fe7e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.7" :db/id #edb/ref 17592186254982}] :answer-field/correct {:answer/id #uuid "94def4e9-5e70-55c6-ad4f-ef99974fe7e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.7" :db/id #edb/ref 17592186254982} :answer-field/id #uuid "61af2815-af60-5b41-a0ab-3da747a6728d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256104}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "af693eb4-5360-5ef3-9011-7331f6a3311c" :question/math-academy-id "q-120630" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $4(\\operatorname{cot}⁡x+1)=3\\operatorname{cot}⁡x$ for $-\\pi <x<\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2},$ rounded to one decimal place?" :question/worked-solution "First, we rearrange the equation and isolate $\\operatorname{cot}⁡x:$\n\n$$\n\\begin{aligned}4(\\operatorname{cot}⁡x+1) & =3\\operatorname{cot}⁡x \\\\ 4\\operatorname{cot}⁡x+4 & =3\\operatorname{cot}⁡x \\\\ \\operatorname{cot}⁡x & =-4\\end{aligned}\n$$\n\nRecall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{tan}⁡x=-\\frac{1}{4}.\n$$\n\nNow, we find the principal value:\n\n$$\nx=\\operatorname{arctan}⁡(-\\frac{1}{4})=-0.244\\,978≈-0.245\\,0\n$$\n\nSince $-0.245\\,0$ lies inside the given domain, our first solution is ${x}_{1}=-0.245\\,0.$\n\nTo generate more solutions, we add and subtract integer multiples of $\\pi .$ Hence,\n\n$$\n\\begin{aligned}{x}_{2}=\\pi +x=\\pi -0.245\\,0≈2.896\\,6.\\end{aligned}\n$$\n\nSo, the solutions are $x=-0.245\\,0,2.896\\,6.$\n\nFinally, the value of ${x}_{1}\\cdot {x}_{2}$ is \n\n$$\n(-0.245\\,0)\\cdot 2.896\\,6≈-0.7\n$$\n\nrounded to one decimal place."} {:db/id #edb/ref 17592186256434 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0563d615-ffa2-5a2e-a34a-325a3b3cd4b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡x" :db/id #edb/ref 17592186253709} {:answer/id #uuid "4c3a13ca-0c91-59ed-aa40-aec07d5043d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡x+1" :db/id #edb/ref 17592186254324} {:answer/id #uuid "79b3ea54-b3ba-5165-91dc-a1dbc40be7c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cot}^{2}⁡x" :db/id #edb/ref 17592186254747} {:answer/id #uuid "7b13a578-e470-566f-813b-75474312fb7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-{cot}^{2}⁡x" :db/id #edb/ref 17592186254763} {:answer/id #uuid "a2fe877d-f681-58d7-ad42-7a9c39a14713" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-\\operatorname{cot}⁡x" :db/id #edb/ref 17592186255107}] :answer-field/correct {:answer/id #uuid "79b3ea54-b3ba-5165-91dc-a1dbc40be7c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cot}^{2}⁡x" :db/id #edb/ref 17592186254747} :answer-field/id #uuid "460c587f-198c-589f-9fc8-f74bfbf671fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256051}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "93375bd6-9a3b-584f-abb5-493a4e9eddf0" :question/math-academy-id "q-120631" :question/problem "$\\frac{1}{(1-{cos}^{2}⁡x)(1+{tan}^{2}⁡x)}=$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta \n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}\\frac{1}{(1-{cos}^{2}⁡x)(1+{tan}^{2}⁡x)} & =\\frac{1}{(1-{cos}^{2}⁡x)\\cdot ({sec}^{2}⁡x)}\\end{aligned}\n$$\n\n \n\nNext, we recall the following identities:\n\n$$\n1-{cos}^{2}⁡x={sin}^{2}⁡x,\\,\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x},\\,\\operatorname{tan}⁡\\theta =\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x},\\,\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}\n$$\n\n \n\nUsing the above identities, we can further simplify our expression as follows:\n\n$$\n\\begin{aligned}\\frac{1}{(1-{cos}^{2}⁡x)\\cdot ({sec}^{2}⁡x)} & =\\frac{1}{({sin}^{2}⁡x\\cdot \\frac{1}{{cos}^{2}⁡x})} \\\\  & =\\frac{1}{(\\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x})} \\\\  & =\\frac{1}{{(\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x})}^{2}} \\\\  & =\\frac{1}{{tan}^{2}⁡x} \\\\  & ={cot}^{2}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{1}{(1-{cos}^{2}⁡x)(1+{tan}^{2}⁡x)}={cot}^{2}⁡x.\n$$"} {:db/id #edb/ref 17592186256436 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0363b5db-f250-5552-bbaa-5a009d817b8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\,346" :db/id #edb/ref 17592186253696} {:answer/id #uuid "2d589ba5-8252-57a6-838b-597f1dea79a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\,124" :db/id #edb/ref 17592186254073} {:answer/id #uuid "52f31a24-609d-5d87-93c3-b324ea500330" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7\\,897" :db/id #edb/ref 17592186254394} {:answer/id #uuid "766819d8-3b84-5e8a-bce3-7e16a10c45f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7\\,235" :db/id #edb/ref 17592186254715} {:answer/id #uuid "acae6d9a-2140-55c9-b1d1-8d68bdd9d3fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\,929" :db/id #edb/ref 17592186255192}] :answer-field/correct {:answer/id #uuid "acae6d9a-2140-55c9-b1d1-8d68bdd9d3fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\,929" :db/id #edb/ref 17592186255192} :answer-field/id #uuid "26469997-7204-56ca-8c80-b52d358626d2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255988}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d6ff29e5-2a44-5e92-bb27-e38c871a4f7c" :question/math-academy-id "q-120635" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $3-4\\operatorname{cot}⁡x=-2\\operatorname{cot}⁡x$ for $-{180}^{∘}<x<{180}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2},$ rounded to the nearest integer?" :question/requires-calculator true :question/worked-solution "First, we rearrange the equation and isolate $\\operatorname{cot}⁡x:$\n\n$$\n\\begin{aligned}3-4\\operatorname{cot}⁡x & =-2\\operatorname{cot}⁡x \\\\ -2\\operatorname{cot}⁡x & =-3 \\\\ \\operatorname{cot}⁡x & =\\frac{3}{2}\\end{aligned}\n$$\n\nRecall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{tan}⁡x=\\frac{2}{3}.\n$$\n\nNow, we find the principal value:\n\n$$\n\\begin{aligned}x=\\text{arctan}(\\frac{2}{3})=(33.690\\,0…)^{∘}≈{33.690}^{∘}\\end{aligned}\n$$\n\nSince ${33.690}^{∘}$ lies inside the given domain, our first solution is ${x}_{1}={33.690}^{∘}.$\n\nTo generate more solutions, we add and subtract integer multiples of ${180}^{∘}.$ Hence,\n\n$$\n\\begin{aligned}{x}_{2}=-{180}^{∘}+{33.690}^{∘}=-{146.310}^{∘}.\\end{aligned}\n$$\n\nSo, the solutions are $x=-{146.310}^{∘},\\,{33.690}^{∘}.$\n\nFinally, the numerical value of ${x}_{1}\\cdot {x}_{2}$ is \n\n$$\n(-146.310)\\cdot 33.690≈-4\\,929\n$$\n\nrounded to the nearest integer."} {:db/id #edb/ref 17592186256450 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3959de01-495d-544d-9125-44db1e7db8e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{cot}⁡x" :db/id #edb/ref 17592186254171} {:answer/id #uuid "77f842c4-7d54-5c19-b720-bb9d73585d7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cot}^{2}⁡x-1" :db/id #edb/ref 17592186254730} {:answer/id #uuid "af23b77f-bd4a-5f78-9caa-a4980a60efcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡x" :db/id #edb/ref 17592186255210} {:answer/id #uuid "df9c3e1e-05fa-505d-99c4-64e78d20d579" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cot}^{2}⁡x" :db/id #edb/ref 17592186255655} {:answer/id #uuid "eeb4522b-0809-53f0-aa52-1dc2ba32a95f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cot}⁡x" :db/id #edb/ref 17592186255759}] :answer-field/correct {:answer/id #uuid "df9c3e1e-05fa-505d-99c4-64e78d20d579" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cot}^{2}⁡x" :db/id #edb/ref 17592186255655} :answer-field/id #uuid "7f1db88f-e765-5456-a536-941d43bf50d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256160}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ba60b74f-b26e-513b-8666-50189177373f" :question/math-academy-id "q-120667" :question/problem "Which of the following is equivalent to $\\frac{{sec}^{2}⁡x}{{sec}^{4}⁡x-{tan}^{2}⁡x-1}?$" :question/worked-solution "First, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡x={sec}^{2}⁡x \\\\  & (2) & {tan}^{2}⁡x={sec}^{2}⁡x-1 \\\\  & (3) & {sec}^{2}⁡x-{tan}^{2}⁡x=1\\end{aligned}\n$$\n\nTherefore, we can rewrite our expression using $(1),$ as follows:\n\n$$\n\\begin{aligned}\\frac{{sec}^{2}⁡x}{{sec}^{4}⁡x-{tan}^{2}⁡x-1} & =\\frac{{sec}^{2}⁡x}{{sec}^{4}⁡x-({tan}^{2}⁡x+1)} \\\\  & =\\frac{{sec}^{2}⁡x}{{sec}^{4}⁡x-{sec}^{2}⁡x}\\end{aligned}\n$$\n\nFinally, we can further simplify our expression, as follows:\n\n$$\n\\begin{aligned}\\frac{{sec}^{2}⁡x}{{sec}^{4}⁡x-{sec}^{2}⁡x} & =\\frac{{sec}^{2}⁡x}{{sec}^{2}⁡x({sec}^{2}⁡x-1)} \\\\  & =\\frac{\\cancel{{sec}^{2}⁡x}}{\\cancel{{sec}^{2}⁡x}({sec}^{2}⁡x-1)} \\\\  & =\\frac{1}{{sec}^{2}⁡x-1} \\\\  & =\\frac{1}{(1+{tan}^{2}⁡x)-1} \\\\  & =\\frac{1}{{tan}^{2}⁡x} \\\\  & ={(\\frac{1}{\\operatorname{tan}⁡x})}^{2} \\\\  & ={cot}^{2}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{{sec}^{2}⁡x}{{sec}^{4}⁡x-{tan}^{2}⁡x-1}={cot}^{2}⁡x.\n$$"} {:db/id #edb/ref 17592186256452 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17f00b72-9daa-5a34-a8b3-6a2e5fa1dff2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta =\\frac{6\\pi }{5}" :db/id #edb/ref 17592186253878} {:answer/id #uuid "86521eb5-22cc-53a1-b524-b9ff1c2e311a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta =\\frac{5\\pi }{4}" :db/id #edb/ref 17592186254859} {:answer/id #uuid "9a84e848-6840-5e58-bc55-0334ef160334" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta =\\frac{5\\pi }{8}" :db/id #edb/ref 17592186255033} {:answer/id #uuid "ad70fad3-8d19-5e8f-8a88-ee9f19172dd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta =\\frac{7\\pi }{6}" :db/id #edb/ref 17592186255199} {:answer/id #uuid "afd98217-57eb-5e73-ad53-c1c9d3a58fb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta =\\frac{4\\pi }{3}" :db/id #edb/ref 17592186255216}] :answer-field/correct {:answer/id #uuid "ad70fad3-8d19-5e8f-8a88-ee9f19172dd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta =\\frac{7\\pi }{6}" :db/id #edb/ref 17592186255199} :answer-field/id #uuid "7360892e-3cc3-5430-8827-7517c29afa89" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256131}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6e7c36f9-b648-5bd3-b641-575b95a2bb92" :question/math-academy-id "q-120704" :question/problem "![](images/03/03814c00b9e29f8a05507616ed08e3fe3daa484336e461012dc6c80799efc9e0.png)\n\nGiven that the ray above passes through the point with Cartesian coordinates $(-\\sqrt{6},-\\sqrt{2})$, find the polar equation of the ray." :question/worked-solution "First, we find the reference angle associated with the point:\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\operatorname{arctan}⁡|\\frac{-\\sqrt{2}}{-\\sqrt{6}}| \\\\  & =\\operatorname{arctan}⁡(\\frac{1}{\\sqrt{3}}) \\\\  & =\\operatorname{arctan}⁡(\\frac{\\sqrt{3}}{3}) \\\\  & =\\frac{\\pi }{6}\\end{aligned}\n$$\n\nNow, notice that the ray lies in the third quadrant. So, we find the angle in the third quadrant that has a reference angle ${\\theta }_{R}=\\frac{\\pi }{6},$ as follows:\n\n$$\n\\begin{aligned}\\theta  & =\\pi +{\\theta }_{R} \\\\  & =\\pi +\\frac{\\pi }{6} \\\\  & =\\frac{7\\pi }{6}\\end{aligned}\n$$\n\nTherefore, the polar equation of the ray is \n\n$$\n\\theta =\\frac{7\\pi }{6}.\n$$"} {:db/id #edb/ref 17592186256453 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38385263-8c7d-5a47-b122-6cab2e4d8c16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta =\\operatorname{arctan}⁡(\\frac{5}{4})" :db/id #edb/ref 17592186254155} {:answer/id #uuid "66ff2c1d-e225-5a47-9e1d-7ad6f170dbdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta =\\operatorname{arctan}⁡(\\frac{4}{5})" :db/id #edb/ref 17592186254601} {:answer/id #uuid "b146eb47-08c0-5df4-8585-6fe236f32a5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta =\\operatorname{arctan}⁡(\\frac{3}{5})" :db/id #edb/ref 17592186255227} {:answer/id #uuid "ce349e59-1f40-54a7-8fc3-a0b5b90d4731" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta =\\operatorname{arctan}⁡(\\frac{3}{4})" :db/id #edb/ref 17592186255502} {:answer/id #uuid "fa46fe98-e520-5a7e-a96a-3e9f7d0a3b16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta =\\operatorname{arctan}⁡(\\frac{9}{5})" :db/id #edb/ref 17592186255865}] :answer-field/correct {:answer/id #uuid "38385263-8c7d-5a47-b122-6cab2e4d8c16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta =\\operatorname{arctan}⁡(\\frac{5}{4})" :db/id #edb/ref 17592186254155} :answer-field/id #uuid "742e72f7-2f5b-5d46-8b71-dc3e2b901000" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256134}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9ce22da1-26fe-5f91-a6ca-3a7a3af85710" :question/math-academy-id "q-120708" :question/problem "![](images/c3/c3d93c8d7d04af6783ef9149e15b5c1a59d1abb2744459004619a5ea2ef029e7.png)\n\nGiven that the ray above passes through the point with Cartesian coordinates $(4,5)$, find the polar equation of the ray." :question/worked-solution "The angles that the ray makes with the positive $x$-axis is\n\n$$\n\\begin{aligned}\\theta  & =\\operatorname{arctan}⁡(\\frac{y}{x}) \\\\  & =\\operatorname{arctan}⁡(\\frac{5}{4}).\\end{aligned}\n$$\n\nTherefore, since the ray lies in the first quadrant, its polar equation is\n\n$$\n\\theta =\\operatorname{arctan}⁡(\\frac{5}{4}).\n$$"} {:db/id #edb/ref 17592186256455 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e6d12e2-e094-56bb-aad7-4875408f1a4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-6\\sqrt{3},-6)" :db/id #edb/ref 17592186253794} {:answer/id #uuid "30cf8320-5fd5-5b11-82e3-deaed3de2914" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-12\\sqrt{3},-12)" :db/id #edb/ref 17592186254096} {:answer/id #uuid "5e5579c2-3d6f-5c86-bb18-f4835d982390" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-6\\sqrt{2},-8)" :db/id #edb/ref 17592186254508} {:answer/id #uuid "7b5c3da8-df30-5fe1-bff4-b1a94f639b67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4\\sqrt{3},-4)" :db/id #edb/ref 17592186254767} {:answer/id #uuid "df0dcfd3-b874-5c42-adc8-6f258f9c28bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-8\\sqrt{3},-8)" :db/id #edb/ref 17592186255650}] :answer-field/correct {:answer/id #uuid "0e6d12e2-e094-56bb-aad7-4875408f1a4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-6\\sqrt{3},-6)" :db/id #edb/ref 17592186253794} :answer-field/id #uuid "504a5f08-c553-5514-84d8-de8398b03057" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256079}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cae813d1-464d-5870-965e-a7cef5a78bcf" :question/math-academy-id "q-120719" :question/problem "![](images/3b/3b1318b156281c7bc8724f988545d9f5c9fab2bda4ed88c387f051dbe5bece1e.png)\n\nThe polar curve $r=12$ and the ray $\\theta =\\frac{7\\pi }{6}$ intersect at the point $P,$ as shown above. What are the Cartesian coordinates of $P?$" :question/worked-solution "The polar coordinates of $P$ are $(r,\\theta )=(12,\\frac{7\\pi }{6}).$ We can convert the polar coordinates of $P$ to Cartesian coordinates, as follows:\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =12\\operatorname{cos}⁡(\\frac{7\\pi }{6}) \\\\  & =12\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-6\\sqrt{3} \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =12\\operatorname{sin}⁡(\\frac{7\\pi }{6}) \\\\  & =12\\cdot (-\\frac{1}{2}) \\\\  & =-6\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-6\\sqrt{3},-6).$"} {:db/id #edb/ref 17592186256456 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "360b765e-646b-59d9-adc1-df9b55505df2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3\\sqrt{3},3\\sqrt{3})" :db/id #edb/ref 17592186254135} {:answer/id #uuid "3a274dbe-d7e0-5997-87c4-48fdf117ab34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3\\sqrt{3},-3\\sqrt{3})" :db/id #edb/ref 17592186254180} {:answer/id #uuid "5ddd65bb-cf72-5eaa-9ec1-a5a92ccb364b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3\\sqrt{2},-3\\sqrt{2})" :db/id #edb/ref 17592186254503} {:answer/id #uuid "9c665223-d2a4-535f-bc34-385f9e66c907" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3\\sqrt{3},-3)" :db/id #edb/ref 17592186255047} {:answer/id #uuid "ad1f6739-215f-599d-9c71-03f7e2f22489" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,3)" :db/id #edb/ref 17592186255197}] :answer-field/correct {:answer/id #uuid "9c665223-d2a4-535f-bc34-385f9e66c907" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3\\sqrt{3},-3)" :db/id #edb/ref 17592186255047} :answer-field/id #uuid "ee510403-ea9d-5191-8444-7c6bc30e1ec9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256344}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2a3d0adf-9db5-5f2f-961d-9ca6ad8715dc" :question/math-academy-id "q-120725" :question/problem "![](images/d8/d8bbcd878edaef5d3f5b92d106a071444f20c72f3d419689d15644a4842a2d45.png)\n\nThe polar curve $r=6$ and the ray $\\theta =\\frac{11\\pi }{6}$ intersect at the point $P,$ as shown above. What are the Cartesian coordinates of $P?$" :question/worked-solution "The polar coordinates of $P$ are $(r,\\theta )=(6,\\frac{11\\pi }{6}).$ We can convert the polar coordinates of $P$ to Cartesian coordinates, as follows:\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =6\\operatorname{cos}⁡(\\frac{11\\pi }{6}) \\\\  & =6\\cdot (\\frac{\\sqrt{3}}{2}) \\\\  & =3\\sqrt{3} \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =6\\operatorname{sin}⁡(\\frac{11\\pi }{6}) \\\\  & =6\\cdot (-\\frac{1}{2}) \\\\  & =-3\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(3\\sqrt{3},-3).$"} {:db/id #edb/ref 17592186256457 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d192d78-6f26-5187-b095-cf67018cab8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4\\sqrt{2},4\\sqrt{2})" :db/id #edb/ref 17592186253780} {:answer/id #uuid "4ffe23d0-094a-5983-b93a-35b11afeeb46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4\\sqrt{2},4)" :db/id #edb/ref 17592186254366} {:answer/id #uuid "79ccd6e4-ba49-5e57-b5cc-94d6e57c6959" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,2)" :db/id #edb/ref 17592186254749} {:answer/id #uuid "b902deb8-591f-53eb-8ca4-563c8cf00b86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\sqrt{8},\\sqrt{8})" :db/id #edb/ref 17592186255312} {:answer/id #uuid "e3b4694c-ff29-559c-ab3f-a56121c5b38d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,4\\sqrt{2})" :db/id #edb/ref 17592186255687}] :answer-field/correct {:answer/id #uuid "0d192d78-6f26-5187-b095-cf67018cab8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4\\sqrt{2},4\\sqrt{2})" :db/id #edb/ref 17592186253780} :answer-field/id #uuid "4ac0dadd-ca80-5e29-8f53-278afb7d998f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256064}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "834a1b13-c35f-5b17-9f85-5c501c941a9d" :question/math-academy-id "q-120730" :question/problem "![](images/84/84b17449880281367f50da89c39a7bcb1348c3a589aec74d9dec24eadb614ce7.png)\n\nThe polar curve $r=8$ and the ray $\\theta =\\frac{3\\pi }{4}$ intersect at the point $P,$ as shown above. What are the Cartesian coordinates of $P?$" :question/worked-solution "The polar coordinates of $P$ are $(r,\\theta )=(8,\\frac{3\\pi }{4}).$ We can convert the polar coordinates of $P$ to Cartesian coordinates, as follows:\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =8\\operatorname{cos}⁡(\\frac{3\\pi }{4}) \\\\  & =8\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =-4\\sqrt{2} \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =8\\operatorname{sin}⁡(\\frac{3\\pi }{4}) \\\\  & =8\\cdot (\\frac{\\sqrt{2}}{2}) \\\\  & =4\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-4\\sqrt{2},4\\sqrt{2}).$"} {:db/id #edb/ref 17592186256459 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "742d9c7f-d4ee-56e4-91a5-257220e81235" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186254697} {:answer/id #uuid "77fef0cd-a14d-513e-a983-57f641d81912" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186254731} {:answer/id #uuid "be8416e5-45aa-50f0-ad1e-e88defc465b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186255371} {:answer/id #uuid "cde2b163-41b2-5e57-b80d-41b421c63e78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}-1" :db/id #edb/ref 17592186255499} {:answer/id #uuid "d8d5128f-097e-53b2-b6f7-370f46fe6294" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186255592}] :answer-field/correct {:answer/id #uuid "be8416e5-45aa-50f0-ad1e-e88defc465b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186255371} :answer-field/id #uuid "8e160d2d-13f1-551b-bfa1-abe0c5a5a564" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256183}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "38924e39-789b-5c5e-b0d2-35b2ccc7c0f1" :question/math-academy-id "q-120752" :question/problem "Compute the arc length of $y=\\sqrt{1-{x}^{2}}$ for $x\\in [\\frac{\\sqrt{2}}{2},1].$" :question/worked-solution "The arc length of a curve $y=f(x)$ between $x=a$ and $x=b$ can be found using the formula\n\n$$\nL={\\int }_{a}^{b}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=\\sqrt{1-{x}^{2}},$ $a=\\frac{\\sqrt{2}}{2}$ and $b=1.$\n\nFirst, we find the derivative of $f(x):$\n\n$$\n{f}^{′}(x)=-\\frac{x}{\\sqrt{1-{x}^{2}}}\n$$\n\nNow, let's compute $\\sqrt{1+[{f}^{′}(x)]^{2}}:$\n\n$$\n\\begin{aligned}\\sqrt{1+[{f}^{′}(x)]^{2}} & =\\sqrt{1+{(-\\frac{x}{\\sqrt{1-{x}^{2}}})}^{2}} \\\\  & =\\sqrt{1+\\frac{{x}^{2}}{1-{x}^{2}}} \\\\  & =\\sqrt{\\frac{1-{x}^{2}+{x}^{2}}{1-{x}^{2}}} \\\\  & =\\sqrt{\\frac{1}{1-{x}^{2}}} \\\\  & =\\frac{1}{\\sqrt{1-{x}^{2}}}\\end{aligned}\n$$\n\nSubstituting $\\sqrt{1+[{f}^{′}(x)]^{2}}=\\frac{1}{\\sqrt{1-{x}^{2}}}$ to the formula for the arc length, we get\n\n$$\n\\begin{aligned}L & ={\\int }_{\\sqrt{2}/2}^{1}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x \\\\  & ={\\int }_{\\sqrt{2}/2}^{1}\\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =(\\operatorname{arcsin}⁡x){|}_{\\sqrt{2}/2}^{1} \\\\  & =\\frac{\\pi }{2}-\\frac{\\pi }{4} \\\\  & =\\frac{\\pi }{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186256463 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01457f0f-a114-52b0-8b99-dee62a99298a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45}^{∘}+n\\cdot {360}^{∘},\\,x={315}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186253678} {:answer/id #uuid "39ee2c07-1e95-56ac-b29f-2d31814338ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={120}^{∘}+n\\cdot {360}^{∘},\\,x={240}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186254179} {:answer/id #uuid "521095f0-b468-5460-9697-086df948f5bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={60}^{∘}+n\\cdot {360}^{∘},\\,x={300}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186254384} {:answer/id #uuid "c0dea304-43bd-5722-b88c-ba6c94f87993" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={150}^{∘}+n\\cdot {360}^{∘},\\,x={210}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186255389} {:answer/id #uuid "cbcc9c58-d321-5486-b9e1-4ca234472367" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={30}^{∘}+n\\cdot {360}^{∘},\\,x={330}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186255480}] :answer-field/correct {:answer/id #uuid "01457f0f-a114-52b0-8b99-dee62a99298a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45}^{∘}+n\\cdot {360}^{∘},\\,x={315}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186253678} :answer-field/id #uuid "a776a03b-bf9d-569f-a094-dda88cdd9e58" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256231}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b2a17c10-d59a-5539-82f1-c464939b55af" :question/math-academy-id "q-120762" :question/problem "In degrees, what is the general solution to the equation $\\operatorname{cos}⁡x=\\frac{\\sqrt{2}}{2}?$ Assume that $n$ is an integer." :question/worked-solution "First, we find the principal value:\n\n$$\n{x}_{1}=\\operatorname{arccos}⁡(\\frac{\\sqrt{2}}{2})={45}^{∘}\n$$\n\nOur first solution lies in the $1$st quadrant and has a reference angle of ${\\theta }_{R}={45}^{∘}.$ Since $\\operatorname{cos}⁡x>0,$ the second solution must lie in the fourth quadrant, and it also has ${\\theta }_{R}={45}^{∘}.$\n\n![](images/c7/c722d4fa2b77011e4df5b086c19bb09943446941484cfaf87559ca39a52183bc.png)\n\nSince the second solution ${x}_{2}$  lies in the $4$th quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={360}^{∘}-{\\theta }_{R} \\\\  & ={360}^{∘}-{45}^{∘} \\\\  & ={315}^{∘}\\end{aligned}\n$$\n\nTherefore, the general solution for the given equation is\n\n$$\nx={45}^{∘}+n\\cdot {360}^{∘},\\,x={315}^{∘}+n\\cdot {360}^{∘}.\n$$"} {:db/id #edb/ref 17592186256464 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "262ff4e6-a9cb-586e-aef9-1831207eccdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={120}^{∘}+n\\cdot {360}^{∘},\\,x={240}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186254009} {:answer/id #uuid "29a74d4f-5c6c-5497-89af-f226a941733c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={225}^{∘}+n\\cdot {360}^{∘},\\,x={315}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186254041} {:answer/id #uuid "e75b5d2e-e6fc-514a-84f7-fa88a7894918" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={210}^{∘}+n\\cdot {360}^{∘},\\,x={330}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186255704} {:answer/id #uuid "f287fff5-eb1b-52c8-96e1-1551f43b7d45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={60}^{∘}+n\\cdot {360}^{∘},\\,x={120}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186255790} {:answer/id #uuid "ff01b234-84e2-5156-9d64-5ec70e3f6943" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={30}^{∘}+n\\cdot {360}^{∘},\\,x={210}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186255912}] :answer-field/correct {:answer/id #uuid "e75b5d2e-e6fc-514a-84f7-fa88a7894918" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={210}^{∘}+n\\cdot {360}^{∘},\\,x={330}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186255704} :answer-field/id #uuid "4367d5ea-00ac-5321-aff2-931579d91b71" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256049}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3388ffa2-ee03-590b-be7c-ff4c9b15895e" :question/math-academy-id "q-120767" :question/problem "In degrees, what is the general solution to the equation $\\operatorname{sin}⁡x=-\\frac{1}{2}?$  Assume that $n$ is an integer." :question/worked-solution "First, we find the principal value:\n\n$$\n{x}_{1}=\\operatorname{arcsin}⁡(-\\frac{1}{2})=-{30}^{∘}\n$$\n\nOur first solution lies in the $4$th quadrant and has a reference angle of ${\\theta }_{R}={30}^{∘}.$ Since $\\operatorname{sin}⁡x<0,$ the second solution must lie in the third quadrant, and it also has ${\\theta }_{R}={30}^{∘}.$\n\n![](images/b3/b3c523e882baf0b3a105e10131091e40de686b4c1483f46e7bdc235e30743a6d.png)\n\nSince the second solution ${x}_{2}$  lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}+{\\theta }_{R} \\\\  & ={180}^{∘}+{30}^{∘} \\\\  & ={210}^{∘}\\end{aligned}\n$$\n\nTherefore, the general solution for the given equation is\n\n$$\nx=-{30}^{∘}+n\\cdot {360}^{∘},\\,x={210}^{∘}+n\\cdot {360}^{∘}.\n$$\n\nWriting this as $x={\\theta }^{∘}+n\\cdot {360}^{∘},$ where $\\theta \\in [0,360),$ we get\n\n$$\nx={210}^{∘}+n\\cdot {360}^{∘},\\,x={330}^{∘}+n\\cdot {360}^{∘}.\n$$"} {:db/id #edb/ref 17592186256465 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e43c895-6027-5cd9-9531-b87e49246459" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{6}+2n\\pi ,\\,x=\\frac{5\\pi }{6}+2n\\pi " :db/id #edb/ref 17592186253793} {:answer/id #uuid "1f44fb9c-996a-5031-9466-77d33cafff38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{3}+2n\\pi ,\\,x=\\frac{4\\pi }{3}+2n\\pi " :db/id #edb/ref 17592186253942} {:answer/id #uuid "78089320-37af-59db-ad4c-cbdf0b14c2e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{3}+2n\\pi ,\\,x=\\frac{2\\pi }{3}+2n\\pi " :db/id #edb/ref 17592186254732} {:answer/id #uuid "f199d7d2-b656-500b-b205-701c1444dbad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{4}+2n\\pi ,\\,x=\\frac{3\\pi }{4}+2n\\pi " :db/id #edb/ref 17592186255780} {:answer/id #uuid "fcec6c04-971e-5821-b58b-21c7ccfb8873" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{4}+2n\\pi ,\\,x=\\frac{5\\pi }{4}+2n\\pi " :db/id #edb/ref 17592186255892}] :answer-field/correct {:answer/id #uuid "f199d7d2-b656-500b-b205-701c1444dbad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{4}+2n\\pi ,\\,x=\\frac{3\\pi }{4}+2n\\pi " :db/id #edb/ref 17592186255780} :answer-field/id #uuid "a7caaf7c-63ba-5300-b937-e172c9f59ffb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256233}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dbeced00-09aa-5843-8bf0-6c51146e3b55" :question/math-academy-id "q-120771" :question/problem "What is the general solution to the equation $\\operatorname{csc}⁡x=\\sqrt{2}?$ Assume that $n$ is an integer." :question/worked-solution "Recall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=\\frac{\\sqrt{2}}{2}.\n$$\n\nNow, we find the principal value:\n\n$$\n{x}_{1}=\\text{arcsin}(\\frac{\\sqrt{2}}{2})=\\frac{\\pi }{4}\n$$\n\nOur first solution lies in the $1$st quadrant and has a reference angle of ${\\theta }_{R}=\\frac{\\pi }{4}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has ${\\theta }_{R}=\\frac{\\pi }{4}.$\n\n![](images/26/269d503189ab1027c3d8028542ef0c6a0e2f146aef0f7916691428866ce1b894.png)\n\nSince the second solution ${x}_{2}$  lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi -{\\theta }_{R} \\\\  & =\\pi -\\frac{\\pi }{4} \\\\  & =\\frac{3\\pi }{4}\\end{aligned}\n$$\n\nTherefore, the general solution to the given equation is\n\n$$\nx=\\frac{\\pi }{4}+2n\\pi ,\\,x=\\frac{3\\pi }{4}+2n\\pi .\n$$"} {:db/id #edb/ref 17592186256466 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08a21451-3b1f-5fd4-8ff9-e95f67f8b196" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={60}^{∘}+n\\cdot {360}^{∘},\\,x={240}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186253733} {:answer/id #uuid "27b00b37-ffa7-5a88-a989-593a10b4d3f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45}^{∘}+n\\cdot {360}^{∘},\\,x={315}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186254022} {:answer/id #uuid "880654f6-2472-55ad-a232-ff6c6a65d66c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={30}^{∘}+n\\cdot {360}^{∘},\\,x={300}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186254877} {:answer/id #uuid "99644de1-6732-540d-8402-8d05e1a4a274" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={60}^{∘}+n\\cdot {360}^{∘},\\,x={300}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186255025} {:answer/id #uuid "bb24f840-6162-53d7-8ddc-1e6cc7dd0a2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45}^{∘}+n\\cdot {360}^{∘},\\,x={135}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186255337}] :answer-field/correct {:answer/id #uuid "27b00b37-ffa7-5a88-a989-593a10b4d3f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45}^{∘}+n\\cdot {360}^{∘},\\,x={315}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186254022} :answer-field/id #uuid "8dace18b-8e74-52ad-834c-ac0e5ca38b77" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256182}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "14deb52a-082f-591b-aca6-b8367b0307e4" :question/math-academy-id "q-120772" :question/problem "In degrees, what is the general solution to the equation $\\operatorname{sec}⁡x=\\sqrt{2}?$ Assume that $n$ is an integer." :question/worked-solution "Recall that $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{cos}⁡x=\\frac{\\sqrt{2}}{2}.\n$$\n\nNow, we find the principal value:\n\n$$\n{x}_{1}=\\text{arccos}(\\frac{\\sqrt{2}}{2})={45}^{∘}\n$$\n\nOur first solution lies in the $1$st quadrant and has a reference angle of ${\\theta }_{R}={45}^{∘}.$ Since $\\operatorname{cos}⁡x>0,$ the second solution must lie in the fourth quadrant, and it also has ${\\theta }_{R}={45}^{∘}.$\n\n![](images/c7/c722d4fa2b77011e4df5b086c19bb09943446941484cfaf87559ca39a52183bc.png)\n\nSince the second solution ${x}_{2}$  lies in the $4$th quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={360}^{∘}-{\\theta }_{R} \\\\  & ={360}^{∘}-{45}^{∘} \\\\  & ={315}^{∘}\\end{aligned}\n$$\n\nTherefore, the general solution to the given equation is\n\n$$\nx={45}^{∘}+n\\cdot {360}^{∘},\\,x={315}^{∘}+n\\cdot {360}^{∘}.\n$$"} {:db/id #edb/ref 17592186256467 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23898c9a-9be7-5c98-9a28-aec46a21b2a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{6}+2n\\pi ,\\,x=\\frac{11\\pi }{6}+2n\\pi " :db/id #edb/ref 17592186253989} {:answer/id #uuid "69a7df4b-2635-5fdd-9b8a-76251cc5931c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{3}+2n\\pi ,\\,x=\\frac{2\\pi }{3}+2n\\pi " :db/id #edb/ref 17592186254619} {:answer/id #uuid "7884ba77-f32e-56a0-b6af-dc0a02ddeb7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{3}+2n\\pi ,\\,x=\\frac{7\\pi }{6}+2n\\pi " :db/id #edb/ref 17592186254735} {:answer/id #uuid "a659b77a-825c-5273-b699-e985b51ec953" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{6}+2n\\pi ,\\,x=\\frac{7\\pi }{6}+2n\\pi " :db/id #edb/ref 17592186255134} {:answer/id #uuid "b182bb11-dc55-572f-b9ce-bb635933c158" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{7\\pi }{6}+2n\\pi ,\\,x=\\frac{11\\pi }{6}+2n\\pi " :db/id #edb/ref 17592186255231}] :answer-field/correct {:answer/id #uuid "b182bb11-dc55-572f-b9ce-bb635933c158" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{7\\pi }{6}+2n\\pi ,\\,x=\\frac{11\\pi }{6}+2n\\pi " :db/id #edb/ref 17592186255231} :answer-field/id #uuid "02960155-4247-502d-88b1-217cdc1fd203" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255922}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6f6e626a-7316-545f-b95c-1ee669a112e6" :question/math-academy-id "q-120777" :question/problem "What is the general solution to the equation $5\\operatorname{csc}⁡x+10=0?$ Assume that $n$ is an integer." :question/worked-solution "First, we rearrange the equation and isolate $\\operatorname{csc}⁡x:$\n\n$$\n\\begin{aligned}5\\operatorname{csc}⁡x+10 & =0 \\\\ 5\\operatorname{csc}⁡x & =-10 \\\\ \\operatorname{csc}⁡x & =-2\\end{aligned}\n$$\n\nRecall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=-\\frac{1}{2}.\n$$\n\nNow, we find the principal value:\n\n$$\n{x}_{1}=\\text{arcsin}(-\\frac{1}{2})=-\\frac{\\pi }{6}\n$$\n\nOur first solution lies in the $4$th quadrant and has a reference angle of ${\\theta }_{R}=\\frac{\\pi }{6}.$ Since $\\operatorname{sin}⁡x<0,$ the second solution must lie in the third quadrant, and it also has ${\\theta }_{R}=\\frac{\\pi }{6}.$\n\n![](images/85/85b7b73fa793153cfedb2ffdb6825edd0845f93dbb472404862a78476a56fc35.png)\n\nSince the second solution ${x}_{2}$  lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi +{\\theta }_{R} \\\\  & =\\pi +\\frac{\\pi }{6} \\\\  & =\\frac{7\\pi }{6}\\end{aligned}\n$$\n\nTherefore, the general solution to the given equation is\n\n$$\nx=-\\frac{\\pi }{6}+2n\\pi ,\\,x=\\frac{7\\pi }{6}+2n\\pi .\n$$\n\nWriting this as $x=\\theta +2n\\pi ,$ where $\\theta \\in [0,2\\pi ),$ we get\n\n$$\nx=\\frac{7\\pi }{6}+2n\\pi ,\\,x=\\frac{11\\pi }{6}+2n\\pi .\n$$"} {:db/id #edb/ref 17592186256468 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02e27451-1c93-5939-a2aa-3ad5c9f224d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{7\\pi }{6}+n\\pi " :db/id #edb/ref 17592186253689} {:answer/id #uuid "30717d72-cb50-585d-851e-60f14a0b4511" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{5\\pi }{6}+n\\pi " :db/id #edb/ref 17592186254095} {:answer/id #uuid "521cc7bf-20a7-57c9-8c21-bdb3841f5227" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{4\\pi }{3}+n\\pi " :db/id #edb/ref 17592186254385} {:answer/id #uuid "64b5019a-5776-596d-a112-a4958d9feb0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\pi }{6}+n\\pi " :db/id #edb/ref 17592186254574} {:answer/id #uuid "ed14bb3c-d140-54cd-ba45-9419f18b4a9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{2\\pi }{3}+n\\pi " :db/id #edb/ref 17592186255742}] :answer-field/correct {:answer/id #uuid "64b5019a-5776-596d-a112-a4958d9feb0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\pi }{6}+n\\pi " :db/id #edb/ref 17592186254574} :answer-field/id #uuid "c9eeed47-fcc7-52c7-8d0d-8d13e6f5b0d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256280}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "994feea1-4e21-534e-9a72-c1ddab9354dc" :question/math-academy-id "q-120782" :question/problem "Find the general solution to the equation $\\operatorname{cot}⁡x=-\\sqrt{3}.$ Assume that $n$ is an integer." :question/worked-solution "Recall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\begin{aligned}\\frac{1}{\\operatorname{tan}⁡x} & =-\\sqrt{3} \\\\ \\operatorname{tan}⁡x & =-\\frac{\\sqrt{3}}{3}.\\end{aligned}\n$$\n\nNow, we find the principal value:\n\n$$\n{x}_{1}=\\operatorname{arctan}⁡(-\\frac{\\sqrt{3}}{3})=-\\frac{\\pi }{6}\n$$\n\nThe tangent function has a period of $\\pi .$  Hence, the general solution for the given equation is\n\n$$\nx=-\\frac{\\pi }{6}+n\\pi .\n$$"} {:db/id #edb/ref 17592186256469 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c3f52fa-f712-547e-b7e9-8883666d103d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{2\\pi }{3}+2n\\pi ,\\,x=\\frac{4\\pi }{3}+2n\\pi " :db/id #edb/ref 17592186254192} {:answer/id #uuid "6d3bdf21-d532-5758-9777-70e0a16f60f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{3}+2n\\pi ,\\,x=\\frac{5\\pi }{3}+2n\\pi " :db/id #edb/ref 17592186254640} {:answer/id #uuid "734157b5-f9f6-5024-8f73-41bedcebe61a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{2\\pi }{3}+2n\\pi ,\\,x=\\frac{5\\pi }{3}+2n\\pi " :db/id #edb/ref 17592186254690} {:answer/id #uuid "b77b2c38-7655-5e1b-b458-9b0b235d13c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{5\\pi }{6}+2n\\pi ,\\,x=\\frac{7\\pi }{6}+2n\\pi " :db/id #edb/ref 17592186255298} {:answer/id #uuid "df520c3f-5af9-5035-8d7a-0510efb4723e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{6}+2n\\pi ,\\,x=\\frac{11\\pi }{6}+2n\\pi " :db/id #edb/ref 17592186255653}] :answer-field/correct {:answer/id #uuid "3c3f52fa-f712-547e-b7e9-8883666d103d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{2\\pi }{3}+2n\\pi ,\\,x=\\frac{4\\pi }{3}+2n\\pi " :db/id #edb/ref 17592186254192} :answer-field/id #uuid "bb1dfdb7-e589-5196-954d-6a116e4569a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256254}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b6e12aa1-2e93-5d2f-b460-31a769deb627" :question/math-academy-id "q-120789" :question/problem "![](images/81/8197d1111bbd4c3b8908bc12cbc58561ffd23fe06d9f9fa99f9ab815ed78733f.png)\n\nThe graph shows a portion of the curve $y=\\operatorname{cos}⁡x$ and $y=-\\frac{1}{2}.$ Which of the following generates the $x$-values of all of their points of intersection? Assume that $n$ is an integer." :question/worked-solution "At the intersection points, the $y$-values are the same for both graphs. This gives the equation $\\operatorname{cos}⁡x=-\\frac{1}{2}.$ \n\nFirst, we find the principal value:\n\n$$\n{x}_{1}=\\operatorname{arccos}⁡(-\\frac{1}{2})=\\frac{2\\pi }{3}\n$$\n\nOur first solution lies in the $2$nd quadrant and has a reference angle of ${\\theta }_{R}=\\frac{\\pi }{3}.$ Since $\\operatorname{cos}⁡x<0,$ the second solution must lie in the third quadrant, and it also has ${\\theta }_{R}=\\frac{\\pi }{3}.$\n\n![](images/ba/ba34bf96662682ec433c3ade0bf3f118638212101a0729fe95bbae05aee8bf1e.png)\n\nSince the second solution ${x}_{2}$  lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi +{\\theta }_{R} \\\\  & =\\pi +\\frac{\\pi }{3} \\\\  & =\\frac{4\\pi }{3}\\end{aligned}\n$$\n\nHence, the general solution for the given equation is \n\n$$\nx=\\frac{2\\pi }{3}+2n\\pi ,\\,x=\\frac{4\\pi }{3}+2n\\pi .\n$$"} {:db/id #edb/ref 17592186256470 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3537f515-3bc2-5ee9-b74a-7b6117d62fb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{3}+2n\\pi ,\\,x=\\frac{4\\pi }{3}+2n\\pi " :db/id #edb/ref 17592186254124} {:answer/id #uuid "589598c3-94bd-53bf-a8ad-8383e0d8f56b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\pi }{6}+2n\\pi ,\\,x=\\frac{5\\pi }{6}+2n\\pi " :db/id #edb/ref 17592186254448} {:answer/id #uuid "5a2290fb-1490-5d91-a046-66f9998ea530" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\pi }{6}+2n\\pi ,\\,x=\\frac{7\\pi }{6}+2n\\pi " :db/id #edb/ref 17592186254459} {:answer/id #uuid "9de0bcaf-1e33-5ab1-b203-8bdeb5aa6b3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\pi }{3}+2n\\pi ,\\,x=\\frac{4\\pi }{3}+2n\\pi " :db/id #edb/ref 17592186255058} {:answer/id #uuid "f29b1923-390b-5bee-bcdb-91330f30e4cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{3}+2n\\pi ,\\,x=\\frac{2\\pi }{3}+2n\\pi " :db/id #edb/ref 17592186255792}] :answer-field/correct {:answer/id #uuid "9de0bcaf-1e33-5ab1-b203-8bdeb5aa6b3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\pi }{3}+2n\\pi ,\\,x=\\frac{4\\pi }{3}+2n\\pi " :db/id #edb/ref 17592186255058} :answer-field/id #uuid "3b0c85ba-13b3-59c5-8828-16430dcf5750" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256030}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "96e27304-f86a-5e06-b358-08529dbd60ec" :question/math-academy-id "q-120791" :question/problem "![](images/c2/c27398934832fba39571fb74c9fa2f9ef80d5ff8ea27136f5353a67ea2cd9ae6.png)\n\nThe graph shows a portion of the curve $y=\\operatorname{sin}⁡x$ and the line $y=-\\frac{\\sqrt{3}}{2}.$ Which of the following generates the $x$-values of all of their points of intersection? Assume that $n$ is an integer." :question/worked-solution "At the intersection points, the $y$-values are the same for both graphs. This gives the equation $\\operatorname{sin}⁡x=-\\frac{\\sqrt{3}}{2}.$ \n\nFirst, we find the principal value:\n\n$$\n{x}_{1}=\\operatorname{arcsin}⁡(-\\frac{\\sqrt{3}}{2})=-\\frac{\\pi }{3}.\n$$\n\nOur first solution lies in the $4$th quadrant and has a reference angle of ${\\theta }_{R}=\\frac{\\pi }{3}.$ Since $\\operatorname{sin}⁡x<0,$ the second solution must lie in the third quadrant, and it also has ${\\theta }_{R}=\\frac{\\pi }{3}.$\n\n![](images/c7/c78678fade9fd2a60003a0ab2cac0299ef1e7df9f6633b1fc6a97422e13dfc4d.png)\n\nSince the second solution ${x}_{2}$  lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi +{\\theta }_{R} \\\\  & =\\pi +\\frac{\\pi }{3} \\\\  & =\\frac{4\\pi }{3}.\\end{aligned}\n$$\n\nHence, the general solution for the given equation is\n\n$$\nx=-\\frac{\\pi }{3}+2n\\pi ,\\,x=\\frac{4\\pi }{3}+2n\\pi .\n$$"} {:db/id #edb/ref 17592186256472 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03f6f627-2f5f-5347-9503-ff016a5b6080" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x+1" :db/id #edb/ref 17592186253702} {:answer/id #uuid "0dc1c20c-56c7-5e18-9f59-20d43cd28e89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{cos}^{2}⁡x" :db/id #edb/ref 17592186253786} {:answer/id #uuid "314c66e0-d6ef-5926-95cd-7d162c322e96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186254100} {:answer/id #uuid "391480c9-2b7d-5c4c-af59-42877898e593" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cos}^{2}⁡x" :db/id #edb/ref 17592186254165} {:answer/id #uuid "7a7a2ee0-bb9d-53c4-bd98-ed75d405853a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x-1" :db/id #edb/ref 17592186254757}] :answer-field/correct {:answer/id #uuid "391480c9-2b7d-5c4c-af59-42877898e593" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cos}^{2}⁡x" :db/id #edb/ref 17592186254165} :answer-field/id #uuid "77493d8d-47a6-584a-b0bf-26e515610f6a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256141}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "93b7d709-aec4-5e7c-b981-7907596e3508" :question/math-academy-id "q-120807" :question/problem "Which of the following is equivalent to $\\frac{1}{{tan}^{2}⁡x{sec}^{2}⁡x-{tan}^{4}⁡x+1}?$" :question/worked-solution "First, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡x={sec}^{2}⁡x \\\\  & (2) & {tan}^{2}⁡x={sec}^{2}⁡x-1 \\\\  & (3) & {sec}^{2}⁡x-{tan}^{2}⁡x=1\\end{aligned}\n$$\n\nTherefore, we can rewrite our expression using $(3),$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{{tan}^{2}⁡x{sec}^{2}⁡x-{tan}^{4}⁡x+1} & =\\frac{1}{{tan}^{2}⁡x({sec}^{2}⁡x-{tan}^{2}⁡x)+1} \\\\  & =\\frac{1}{{tan}^{2}⁡x\\cdot 1+1} \\\\  & =\\frac{1}{{tan}^{2}⁡x+1}\\end{aligned}\n$$\n\nFinally, we can use $(1),$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{{tan}^{2}⁡x+1} & =\\frac{1}{{sec}^{2}⁡x} \\\\  & ={(\\frac{1}{\\operatorname{sec}⁡x})}^{2} \\\\  & ={cos}^{2}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{1}{{tan}^{2}⁡x{sec}^{2}⁡x-{tan}^{4}⁡x+1}={cos}^{2}⁡x.\n$$"} {:db/id #edb/ref 17592186256475 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17690be4-b25c-5beb-9716-e56a0cc5d636" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{v}_{\\text{max}}=80\\,\\text{m}/\\text{s},\\,t=4\\,\\text{s}" :db/id #edb/ref 17592186253872} {:answer/id #uuid "581f75d2-589c-5447-bd8c-6b7137016186" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{v}_{\\text{max}}=22\\,\\text{m}/\\text{s},\\,t=1\\,\\text{s}" :db/id #edb/ref 17592186254444} {:answer/id #uuid "a1fb5fbb-f0b4-5606-a0c7-28fbda5ae298" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{v}_{\\text{max}}=44\\,\\text{m}/\\text{s},\\,t=2\\,\\text{s}" :db/id #edb/ref 17592186255099} {:answer/id #uuid "da376527-da9d-5843-a97d-7252518c421e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{v}_{\\text{max}}=64\\,\\text{m}/\\text{s},\\,t=4\\,\\text{s}" :db/id #edb/ref 17592186255606} {:answer/id #uuid "ed695890-07ef-5a05-ab86-b6163678dcdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{v}_{\\text{max}}=144\\,\\text{m}/\\text{s},\\,t=4\\,\\text{s}" :db/id #edb/ref 17592186255744}] :answer-field/correct {:answer/id #uuid "17690be4-b25c-5beb-9716-e56a0cc5d636" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{v}_{\\text{max}}=80\\,\\text{m}/\\text{s},\\,t=4\\,\\text{s}" :db/id #edb/ref 17592186253872} :answer-field/id #uuid "da1b9f18-eb01-54e9-8cd4-f8000e1f2f7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256307}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c82954a1-ea49-5379-ae30-0facbbb1d022" :question/math-academy-id "q-120817" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in $\\text{m}/{\\text{s}}^{2},$ given by the function $a(t)=16t-{t}^{3},$ where $t>0$ is the time  in seconds. If the particle has velocity $v=44\\,\\text{m}/\\text{s}$ when $t=2\\,\\text{s},$ calculate the maximum velocity ${v}_{\\text{max}}$ of the particle and determine the time when the particle reaches its maximum velocity." :question/worked-solution "The extrema of the velocity $v$ occur at the critical points of $v.$\n\nSince $\\frac{\\text{d}v}{\\text{d}t}=a(t),$ to find the times where $v$ is a maximum, we just need to solve $a(t)=0$ and test each solution using the first or second derivative test.\n\nSolving $a(t)=0$ gives\n\n$$\n\\begin{aligned}a(t) & =0 \\\\ 16t-{t}^{3} & =0 \\\\ t(16-{t}^{2}) & =0 \\\\ t(4-t)(4+t) & =0 \\\\ t & =0,\\pm 4.\\end{aligned}\n$$\n\nSince $t>0$, the extremum of the velocity function occurs when $t=4\\,\\text{s}.$\n\nWe now test the extreme value using the second derivative test. For this, we find the second derivative of $v(t)$ and evaluate it at $t=4:$\n\n$$\n\\begin{aligned}{v}^{″}(t) & =\\frac{{\\text{d}}^{2}v}{\\text{d}{t}^{2}} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{\\text{d}v}{\\text{d}t}) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(a(t)) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(16t-{t}^{3}) \\\\  & =16-3{t}^{2} \\\\ {v}^{″}(4) & =16-3(4)^{2} \\\\  & =-32\\end{aligned}\n$$\n\nSince ${v}^{″}(4)<0,$ we conclude that the velocity is maximized when $t=4\\,\\text{s}.$\n\nNow, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\text{d}t \\\\  & =\\int (16t-{t}^{3})\\text{d}t \\\\  & =8{t}^{2}-\\frac{1}{4}{t}^{4}+C\\end{aligned}\n$$\n\nTo determine $C,$ we use the fact that $v(2)=44.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}8(2)^{2}-\\frac{1}{4}(2)^{4}+C & =44 \\\\ 32-4+C & =44\\,⟹\\,C=16.\\end{aligned}\n$$\n\nTherefore, the velocity $v$ of the particle at time $t$ is $v(t)=16+8{t}^{2}-\\frac{1}{4}{t}^{4}.$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{\\text{max}}=v(4)=16+8(4)^{2}-\\frac{1}{4}(4)^{4}=80\\,\\text{m}/\\text{s}\n$$"} {:db/id #edb/ref 17592186256476 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f638f4-f86a-515f-9f34-79bab5aed9d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={28}^{∘},{132}^{∘}" :db/id #edb/ref 17592186253720} {:answer/id #uuid "224f6339-4d6f-5e84-b12e-6e6df9f718ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={52}^{∘},{138}^{∘}" :db/id #edb/ref 17592186253977} {:answer/id #uuid "8a43384c-d861-5f3a-b84c-c613ddd7827e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={32}^{∘},{128}^{∘}" :db/id #edb/ref 17592186254892} {:answer/id #uuid "a13e94d6-c61b-5c3f-aae3-300caad1d7da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={42}^{∘},{158}^{∘}" :db/id #edb/ref 17592186255089} {:answer/id #uuid "d940938c-d2de-57cd-9c70-133a3360d2a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={42}^{∘},{138}^{∘}" :db/id #edb/ref 17592186255594}] :answer-field/correct {:answer/id #uuid "d940938c-d2de-57cd-9c70-133a3360d2a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={42}^{∘},{138}^{∘}" :db/id #edb/ref 17592186255594} :answer-field/id #uuid "7908722b-df99-5603-8d9c-625d78a85041" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256143}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "722c6645-d9eb-5787-9276-c39131ce1533" :question/math-academy-id "q-120828" :question/problem "Calculate, in degrees, rounded to the nearest integer, the solutions to the equation $\\operatorname{sin}⁡x=\\frac{2}{3}$ for ${0}^{∘}\\le x<{360}^{∘}.$" :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arcsin}⁡(\\frac{2}{3})=41.810{…}^{∘}≈{41.81}^{∘}\\end{aligned}\n$$\n\nSince ${41.81}^{∘}$ lies inside the range, our first solution is ${x}_{1}={41.81}^{∘}.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}={41.81}^{∘}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has a reference angle ${\\theta }_{R}={41.81}^{∘}.$\n\n![](images/bc/bc0c031fe6ccbb40dc77474582b301456f537ee2a649ba2d5b3bca9b1240618f.png)\n\nSince the second solution ${x}_{2}$ lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}-{\\theta }_{R} \\\\  & ={180}^{∘}-{41.81}^{∘} \\\\  & ={138.19}^{∘}\\end{aligned}\n$$\n\nSo, the solutions (rounded to the nearest integer) are $x={42}^{∘},{138}^{∘}.$"} {:db/id #edb/ref 17592186256477 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b61a2ae1-ee3d-5931-8104-7431daf3fbd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.1" :db/id #edb/ref 17592186255278} {:answer/id #uuid "d7d6942d-c4ce-59fe-a81c-9e712408e803" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.2" :db/id #edb/ref 17592186255583} {:answer/id #uuid "f01f3ade-148c-5bda-b50d-78962c4f929b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.1" :db/id #edb/ref 17592186255770} {:answer/id #uuid "f0f85607-4457-541f-8c91-e132c7a1f1d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.1" :db/id #edb/ref 17592186255775} {:answer/id #uuid "fc4be72f-ad11-5633-b69f-da0f3d50b458" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.3" :db/id #edb/ref 17592186255887}] :answer-field/correct {:answer/id #uuid "b61a2ae1-ee3d-5931-8104-7431daf3fbd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.1" :db/id #edb/ref 17592186255278} :answer-field/id #uuid "d69ba282-a24e-5c43-95f7-4b12c407de32" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256301}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f839a0a0-2182-5a96-8bd7-233e711db5a4" :question/math-academy-id "q-120831" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions of the equation $\\operatorname{sin}⁡x=\\frac{2}{5}$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2},$ rounded to $1$ decimal place?" :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arcsin}⁡(\\frac{2}{5})=0.411\\,516…≈0.411\\,5\\end{aligned}\n$$\n\nSince $0.411\\,5$ lies inside the given domain, our first solution is ${x}_{1}=0.411\\,5.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}=0.411\\,5.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has a reference angle ${\\theta }_{R}=0.411\\,5.$\n\n![](images/ab/ab3de51a23485b1776e014768b0775315694cd1147eb2772f71323d4d097dee2.png)\n\nSince the second solution ${x}_{2}$ lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi -{\\theta }_{R} \\\\  & =\\pi -0.411\\,5 \\\\  & ≈2.730\\,1\\end{aligned}\n$$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}≈0.411\\,5\\cdot 2.730\\,1≈1.1,\n$$\n\nrounded to $1$ decimal place."} {:db/id #edb/ref 17592186256478 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "464e7f61-ecbe-5d92-a768-bdba96ba66de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={41}^{∘},{139}^{∘}" :db/id #edb/ref 17592186254263} {:answer/id #uuid "69d72443-b15d-5420-872d-20cf241c18f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={59}^{∘},{121}^{∘}" :db/id #edb/ref 17592186254622} {:answer/id #uuid "7e19217d-64a1-5640-bcbd-4834c9ad3d04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={33}^{∘},{147}^{∘}" :db/id #edb/ref 17592186254788} {:answer/id #uuid "9b2bbeef-4a86-5df0-80c1-4741f9633531" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={49}^{∘},{131}^{∘}" :db/id #edb/ref 17592186255037} {:answer/id #uuid "f21259fd-d614-5577-a3a5-f9fb03962578" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={39}^{∘},{141}^{∘}" :db/id #edb/ref 17592186255785}] :answer-field/correct {:answer/id #uuid "f21259fd-d614-5577-a3a5-f9fb03962578" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={39}^{∘},{141}^{∘}" :db/id #edb/ref 17592186255785} :answer-field/id #uuid "9540c28b-d25c-5852-ad5d-ea5925808fa0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256196}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5d378f08-b29e-5a1d-8989-f385e5bd482e" :question/math-academy-id "q-120835" :question/problem "Calculate, in degrees, rounded to the nearest integer, the solutions to the equation $\\operatorname{sin}⁡x=\\frac{5}{8}$ for ${0}^{∘}\\le x<{360}^{∘}.$" :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arcsin}⁡(\\frac{5}{8})=38.682{…}^{∘}≈{38.68}^{∘}\\end{aligned}\n$$\n\nSince ${38.68}^{∘}$ lies inside the range, our first solution is ${x}_{1}={38.68}^{∘}.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}={38.68}^{∘}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has a reference angle ${\\theta }_{R}={38.68}^{∘}.$\n\n![](images/12/12b17e3994be5e45af3aca185b22618dd0ec7288fba18a4131387783323247a0.png)\n\nSince the second solution ${x}_{2}$ lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}-{\\theta }_{R} \\\\  & ={180}^{∘}-{38.68}^{∘} \\\\  & ={141.32}^{∘}\\end{aligned}\n$$\n\nSo, the solutions (rounded to the nearest integer) are $x={39}^{∘},{141}^{∘}.$"}]
