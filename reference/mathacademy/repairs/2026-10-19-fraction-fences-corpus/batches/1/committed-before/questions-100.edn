field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186177945}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "06dbdab8-c946-5c87-85a9-b4822fda3e4f" :question/math-academy-id "q-127984" :question/problem "Find the value of $(-\\frac{10}{13})÷5.$" :question/worked-solution "Dividing a negative number by a positive number gives a negative number. Hence, the result will be negative.\n\nTherefore, since \n\n$$\n\\frac{10}{13}÷5=\\frac{10}{13\\times 5}=\\frac{10}{65}=\\frac{2}{13},\n$$\n\nwe obtain\n\n$$\n(-\\frac{10}{13})÷5=-\\frac{2}{13}.\n$$"} {:db/id #edb/ref 17592186180047 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8b65fa1-1a3d-5d36-a338-50028cea3d91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186177952} {:answer/id #uuid "07e8dfa9-5b71-52db-bcea-1b6d7b2ec676" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186177953} {:answer/id #uuid "381f8fd7-83b9-5f43-a1c7-95a04321fdcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186177954} {:answer/id #uuid "5a305bed-b447-5413-bfa4-f39e14654e6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186177955} {:answer/id #uuid "6172cb80-6e07-5ba4-aac8-64c9afc315ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186177956}] :answer-field/id #uuid "7ea62459-de0e-5a39-b989-ef5b2ebbc34b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186177951}] :question/id #uuid "07fa4cc1-ea7c-549d-a545-29bfcb36c452" :question/math-academy-id "q-127985" :question/problem "What is the value of $(-10) \\div (-\\frac{2}{3})$?"} {:db/id #edb/ref 17592186180051 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5068094-5f6a-5e13-8616-721b619a581b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(-\\frac{1}{2})^{n} - 2(3)^{n}" :db/id #edb/ref 17592186177976} {:answer/id #uuid "054ab84f-e11c-598c-8d36-56dc5a5f2806" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2)^{n} - 2(3)^{n}" :db/id #edb/ref 17592186177977} {:answer/id #uuid "1162d7f5-b6be-5004-b01c-4e7df8075b06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(-2)^{n} - 2(3)^{n}" :db/id #edb/ref 17592186177978} {:answer/id #uuid "390c91f2-d99b-5acd-adcd-909e6f19fe84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(-\\frac{1}{2})^{n} + (3)^{n}" :db/id #edb/ref 17592186177979} {:answer/id #uuid "6399f591-37ce-5dc6-88a1-73b84d8172ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{1}{2})^{n} + 2(3)^{n}" :db/id #edb/ref 17592186177980}] :answer-field/id #uuid "a24db435-03b5-5115-a0f0-e9f11da1b620" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186177975}] :question/id #uuid "b18e61c8-ac15-50fb-9158-27e01573d320" :question/math-academy-id "q-128812" :question/problem "Find an expression for the general term $a_{n}$ for $n \\ge 0$ of the sequence with the generating function $\\frac{1}{x + 2} + \\frac{2}{3x - 1}$."} {:db/id #edb/ref 17592186180095 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14c7c168-82cc-5a17-8be8-9939e4bcb088" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,m/s" :db/id #edb/ref 17592186529621} {:answer/id #uuid "6b9db7eb-b9e6-55b2-9175-d64b7726f9d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}\\,m/s" :db/id #edb/ref 17592186529853} {:answer/id #uuid "b13777e2-0bb2-5afd-b6d7-72e4ed755e89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}\\,m/s" :db/id #edb/ref 17592186530020} {:answer/id #uuid "b1e2de47-0ac9-519b-8def-6431e35f2b9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,m/s" :db/id #edb/ref 17592186530025} {:answer/id #uuid "ca51b212-0699-54e5-80db-f12dc9105127" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}\\,m/s" :db/id #edb/ref 17592186530087}] :answer-field/correct {:answer/id #uuid "ca51b212-0699-54e5-80db-f12dc9105127" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}\\,m/s" :db/id #edb/ref 17592186530087} :answer-field/id #uuid "47f3bda1-6cae-501c-a999-3dbb1502d89d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186178239}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e70a7267-ff55-5f84-86c7-c840d8b569be" :question/math-academy-id "q-163491" :question/problem "A particle $P$ moves along the $x$-axis in the direction of increasing $x$ where $x\\ge 0.$ When the displacement of $P$ from the origin is $x\\,m,$ the velocity is $v\\,m/s,$ and the acceleration is $k(1-x)\\,{m/s}^{2},$ where $k$ is a positive constant. If $P$ has velocity $v=\\sqrt{6}\\,m/s$ at the origin and has velocity $v=3\\,m/s$ when its displacement is $\\frac{3}{2}\\,m,$ find the maximum velocity of the particle." :question/worked-solution "![](images/75/75ef4755be2965b674fc7a5440ff05bb3f37d70507941eb48eeae554fcb2d538.png)\n\nThe extrema of the velocity occur at the critical points of $v.$ Since the acceleration of the particle $P$ is $k(1-x)\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=k(1-x).\n$$\n\nTo find the moments where $v$ is a maximum, we need to solve $\\frac{\\text{d}v}{\\text{d}t}=0$ and test each solution using the first derivative test.\n\nSolving $\\frac{\\text{d}v}{\\text{d}t}=0$ gives\n\n$$\n\\begin{aligned}k(1-x) & =0 \\\\ 1-x & =0 \\\\ x & =1.\\end{aligned}\n$$\n\nHence, the extremum of the velocity function occurs when $x=1\\,m.$\n\nWe now test the extreme value using the first derivative test. We summarize the necessary information in a table, shown below.\n\n| $x$ | $(0,1)$ | $1$ | $(1,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $\\frac{1}{2}$ |  | $\\frac{3}{2}$ |\n| $\\frac{\\text{d}v}{\\text{d}t}$ | $\\frac{k}{2}>0$ | $0$ | $-\\frac{k}{2}<0$ |\n| $v$ | $↗$ | max | $↘$ |\n\nWe conclude that the velocity is maximized when $x=1\\,m.$\n\nNext, using the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our initial equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=k(1-x).\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int k(1-x)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=k(x-\\frac{1}{2}{x}^{2})+C.\n$$\n\nNow, since $v=\\sqrt{6}\\,{m/s}^{2}$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =k(\\frac{1}{2}{x}^{2}-x)+C \\\\ \\frac{1}{2}(\\sqrt{6})^{2} & =k(0-\\frac{1}{2}(0)^{2})+C \\\\ C & =3\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=k(x-\\frac{1}{2}{x}^{2})+3.\n$$\n\nAlso, since $v=3\\,{m/s}^{2}$ when $x=\\frac{3}{2}\\,m,$ we can find the value of the positive constant $k,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =k(x-\\frac{1}{2}{x}^{2})+3 \\\\ \\frac{1}{2}(3)^{2} & =k(\\frac{3}{2}-\\frac{1}{2}{(\\frac{3}{2})}^{2})+3 \\\\ \\frac{9}{2} & =\\frac{3}{8}k+3 \\\\ \\frac{3}{8}k & =\\frac{3}{2} \\\\ k & =4.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =4x-2{x}^{2}+3 \\\\ {v}^{2} & =8x-4{x}^{2}+6 \\\\ v & =\\pm \\sqrt{8x-4{x}^{2}+6}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing $x,$ we have that $v(x)>0,$ so we can disregard the negative square root. Therefore,\n\n$$\nv(x)=\\sqrt{8x-4{x}^{2}+6}.\n$$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{max}=v(1)=\\sqrt{8(1)-4(1)^{2}+6}=\\sqrt{10}\\,m/s.\n$$"} {:db/id #edb/ref 17592186180178 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05b58ef3-88cb-5f48-a5ad-2a8ebd9fe489" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-{e}^{2}" :db/id #edb/ref 17592186324024} {:answer/id #uuid "50d3ce4b-91e9-50e5-be2e-217bd0e8638d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{e}^{2}}-2" :db/id #edb/ref 17592186324634} {:answer/id #uuid "6291e7cd-d04f-52bd-8607-0fc13a433b0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}-1" :db/id #edb/ref 17592186324790} {:answer/id #uuid "7b429634-b6de-5be5-94db-a86b7b87bf65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{2}{e}" :db/id #edb/ref 17592186325007} {:answer/id #uuid "a83831c3-ae0d-5759-ae8b-eb2f48f47f33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{e}" :db/id #edb/ref 17592186325402}] :answer-field/correct {:answer/id #uuid "50d3ce4b-91e9-50e5-be2e-217bd0e8638d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{e}^{2}}-2" :db/id #edb/ref 17592186324634} :answer-field/id #uuid "e84998b8-8912-50f1-b594-a9f825576cb8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326640}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ce49b8d5-a7c7-525b-89a9-21901c00319a" :question/math-academy-id "q-40255" :question/problem "![](images/cb/cbd92b205693f1056e4dc2d0fc8154843e62b433b66d9b0ba8918d7f5bb3b8bf.png)\n\nEvaluate the line integral of the function $f(x,y)=x{e}^{y}$ along the circle $C$ with equation ${x}^{2}+{y}^{2}=4,$ traversed from the point $(-2,0)$ to the point $(0,-2),$ as shown above." :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nThe curve $C$ is a part-circle of radius $2$ centered at $O.$ It can be parametrized as \n\n$$\nr(t)=⟨2\\operatorname{cos}⁡t,\\,2\\operatorname{sin}⁡t⟩,\\,\\pi \\le t\\le \\frac{3\\pi }{2}.\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)j \\\\  & =-2\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-2\\operatorname{sin}⁡t)^{2}+(2\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{4{sin}^{2}⁡t+4{cos}^{2}⁡t} \\\\  & =\\sqrt{4({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =2\\end{aligned}\n$$\n\nNow, since $f(x,y)=x{e}^{y}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =2\\operatorname{cos}⁡t\\,{e}^{2\\operatorname{sin}⁡t}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{\\pi }^{3\\pi /2}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{\\pi }^{3\\pi /2}2\\operatorname{cos}⁡t\\,{e}^{2\\operatorname{sin}⁡t}\\cdot 2\\cdot \\text{d}t \\\\  & =2{\\int }_{\\pi }^{3\\pi /2}2\\operatorname{cos}⁡t\\,{e}^{2\\operatorname{sin}⁡t}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=2\\operatorname{sin}⁡t,$ $\\text{d}u=2\\operatorname{cos}⁡t\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}2{\\int }_{\\pi }^{3\\pi /2}2\\operatorname{cos}⁡t\\,{e}^{2\\operatorname{sin}⁡t}\\,\\text{d}t & =2{\\int }_{0}^{-2}{e}^{u}\\,\\text{d}u \\\\  & =2{e}^{u}{|}_{0}^{-2} \\\\  & =2{e}^{-2}-2{e}^{0} \\\\  & =\\frac{2}{{e}^{2}}-2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186180181 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1269fb37-f5f5-5f49-8256-65a8aa8aade1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186324137} {:answer/id #uuid "202d1e9c-c862-5c6c-ae37-26c7ec997456" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{3}" :db/id #edb/ref 17592186324237} {:answer/id #uuid "7ba52178-68df-5d08-aaf9-5d4c9645bdbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186325012} {:answer/id #uuid "a5a81ce8-7c24-5166-bd26-99041082a9f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{3}" :db/id #edb/ref 17592186325380} {:answer/id #uuid "c4f82ca1-73f0-575a-951c-3ca7fa8e19e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{3}" :db/id #edb/ref 17592186325668}] :answer-field/correct {:answer/id #uuid "1269fb37-f5f5-5f49-8256-65a8aa8aade1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186324137} :answer-field/id #uuid "de1ba936-f5f5-59fd-91b3-8a8a870fa20a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326625}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d6d33094-0194-5a44-b10e-00c00343eeb5" :question/math-academy-id "q-41145" :question/problem "![](images/78/78f8ca3e70afb8377748a18d7024ba297e330add59550a41a87025a0145b56bb.png)\n\nEvaluate the line integral ${\\int }_{C}9xy\\,\\text{d}s,$ where the curve $C$ is the quarter of the ellipse ${x}^{2}+4{y}^{2}=4$  traversed from the point $(2,0)$ to the point $(0,1).$" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nNote that we can write the equation of our ellipse in the form\n\n$$\n\\frac{{x}^{2}}{{2}^{2}}+{y}^{2}=1.\n$$\n\nSo, the curve $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $2$ and $1,$ respectively. Therefore, it can be parametrized as \n\n$$\nr(t)=⟨2\\operatorname{cos}⁡t,\\,\\operatorname{sin}⁡t⟩,\\,0\\le t\\le \\frac{\\pi }{2}.\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)j \\\\  & =-2\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-2\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{4{sin}^{2}⁡t+{cos}^{2}⁡t} \\\\  & =\\sqrt{3{sin}^{2}⁡t+({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\sqrt{1+3{sin}^{2}⁡t}\\end{aligned}\n$$\n\nNow, since $f(x,y)=9xy$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =9\\cdot 2\\operatorname{cos}⁡t\\cdot \\operatorname{sin}⁡t=18\\operatorname{sin}⁡t\\,\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}9xy\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}18\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\cdot \\sqrt{1+3{sin}^{2}⁡t}\\cdot \\text{d}t \\\\  & =18{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\sqrt{1+3{sin}^{2}⁡t}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=1+3{sin}^{2}⁡t,$ $\\text{d}u=6\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}18{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\sqrt{1+3{sin}^{2}⁡t}\\,\\text{d}t & =3{\\int }_{1}^{4}\\sqrt{u}\\,\\text{d}u \\\\  & =3\\cdot \\frac{2}{3}{u}^{3/2}{|}_{1}^{4} \\\\  & =2({4}^{3/2}-{1}^{3/2}) \\\\  & =2(8-1) \\\\  & =14\\end{aligned}\n$$"} {:db/id #edb/ref 17592186180193 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94d04608-e288-5781-9fe1-0a2327b3b493" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{15}" :db/id #edb/ref 17592186178703} {:answer/id #uuid "a82dc0b8-5f0c-566a-98e0-d176b8cde633" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186178704} {:answer/id #uuid "cafc40ff-7b30-521d-a6b7-6b2c4b4a951f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{15}{2}" :db/id #edb/ref 17592186178705} {:answer/id #uuid "06549d37-6513-5e2f-b419-335df596858a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{15}" :db/id #edb/ref 17592186178706} {:answer/id #uuid "64fa9e90-abec-5c9b-b9e9-dfa4b2e23124" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6}{5}" :db/id #edb/ref 17592186178707}] :answer-field/id #uuid "a71e9243-9037-5151-93a6-9d772833870b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186178702}] :question/id #uuid "44b26ea2-052f-5b8b-b45b-6ec2b20d49fa" :question/math-academy-id "q-43028" :question/problem "What is $(-\\frac{2}{5}) \\cdot (-\\frac{1}{3})$?"} {:db/id #edb/ref 17592186180194 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92fe86b5-bdf8-5ae2-9902-531c297a1a48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186178709} {:answer/id #uuid "be8c4c25-c189-5b18-8350-43daecd8e907" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186178710} {:answer/id #uuid "da67bed4-7007-540a-9ff1-1597117ea266" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{5}" :db/id #edb/ref 17592186178711} {:answer/id #uuid "48075fd9-3bc6-59bd-958d-f00b7f8f885a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{10}" :db/id #edb/ref 17592186178712} {:answer/id #uuid "6f336292-bac9-58ee-9b61-9aba8a60f462" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{6}" :db/id #edb/ref 17592186178713}] :answer-field/id #uuid "cfcd3af5-70e3-506c-bca4-f59552ba5b02" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186178708}] :question/id #uuid "691091a3-8ca5-5929-a98e-d4db45cbb50b" :question/math-academy-id "q-43029" :question/problem "What is $(-\\frac{1}{2}) \\cdot \\frac{5}{3}$?"} {:db/id #edb/ref 17592186180278 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84a68544-3dee-56d2-b4c7-eeed22d1e2cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2π" :db/id #edb/ref 17592186179213} {:answer/id #uuid "9b9036a3-920f-5615-bfeb-f807ba857652" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{π}" :db/id #edb/ref 17592186179214} {:answer/id #uuid "d94aea65-e2a6-5fe5-abd3-22496a932674" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{π}{2}" :db/id #edb/ref 17592186179215} {:answer/id #uuid "15c8a75a-7643-52b0-b284-d4374f9fef41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186179216} {:answer/id #uuid "173fb852-8a5c-5d4b-acb1-8126fdbffabc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2π}" :db/id #edb/ref 17592186179217}] :answer-field/id #uuid "6f151015-d188-52ae-99fa-d6c0a2bc7f89" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186179212}] :question/id #uuid "bd6e5c6e-c45a-513e-b007-721402a77203" :question/math-academy-id "q-76200" :question/problem "Evaluate the integral $\\displaystyle \\int_(C)\\sin (\\frac{πy}{4})ds$ along the line segment from $(1, 0, 1)$ to $(2, 2, 3)$."} {:db/id #edb/ref 17592186180305 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8578f029-4f65-50a8-9d44-09615f0568f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(2)^{n}" :db/id #edb/ref 17592186179375} {:answer/id #uuid "14e2915b-e0e5-5e79-b681-89eae09c7ef9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}(\\frac{1}{2})^{n}" :db/id #edb/ref 17592186179376} {:answer/id #uuid "1c02cc6f-1227-544e-b46c-e1a2f3fc796d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(\\frac{1}{4})^{n}" :db/id #edb/ref 17592186179377} {:answer/id #uuid "32eb409c-9a2c-5b49-a24a-8aa3e07fb450" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{2})^{n}" :db/id #edb/ref 17592186179378} {:answer/id #uuid "6e9bd2cd-5145-523a-b72b-d7f625c69ec6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(\\frac{1}{2})^{n}" :db/id #edb/ref 17592186179379}] :answer-field/id #uuid "bf837b0c-d8ea-5552-834f-ba16ff419a2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186179374}] :question/id #uuid "a13cc734-cb57-5f09-8f2c-741ef0a9ce01" :question/math-academy-id "q-97247" :question/problem "Find the expression for the general term $a_{n}$ for $n \\ge 0$ of the sequence with the generating function $\\frac{4}{2 - x}$."} {:db/id #edb/ref 17592186180306 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3c0ab00-8ab1-5441-b371-0516c270cd63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5(-\\frac{4}{3})^{n}" :db/id #edb/ref 17592186179381} {:answer/id #uuid "c659a0fe-e75c-5400-815a-6b893f96fe59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5(-\\frac{3}{4})^{n}" :db/id #edb/ref 17592186179382} {:answer/id #uuid "ced0dfc2-12a2-5de6-b447-31ecc978b7bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{3}{4})^{n}" :db/id #edb/ref 17592186179383} {:answer/id #uuid "ffddd4a3-daab-500b-9b3f-f3533f4a4e66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}(-\\frac{4}{3})^{n}" :db/id #edb/ref 17592186179384} {:answer/id #uuid "1531cab2-e1ac-5e21-b5b6-fde9933abe8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}(-\\frac{3}{4})^{n}" :db/id #edb/ref 17592186179385}] :answer-field/id #uuid "2c614954-5180-5903-9ee8-3aab04c26eba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186179380}] :question/id #uuid "8102d63e-138f-5ab6-a9d9-2f70552d0587" :question/math-academy-id "q-97259" :question/problem "Find the expression for the general term $a_{n}$ for $n \\ge 0$ of the sequence with the generating function $\\frac{20}{4 + 3x}$."} {:db/id #edb/ref 17592186183921 :question/id #uuid "563087c2-8d87-5b95-833d-f9892d9276a6" :question/math-academy-id "e-10535" :question/problem "Evaluate $\\lim_\\limits{x \\to 0} \\dfrac{\\arccos(x) -\\pi}{x-\\pi}.$" :question/worked-solution "Let's sketch the graph of $y=\\arccos(x){:}$\n\n![](images/9d/9dcc5a116c2a564547283783a7df7b1cd3a9ab3b76ac24dc2695c4cb367796d5.png)\n\nThe domain of $\\arccos(x)$ is $x \\in [-1,1].$  \n\nNow, substituting $x=0$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}(\\frac{\\operatorname{arccos}⁡(x)-\\pi }{x-\\pi }) & =\\frac{\\operatorname{arccos}⁡(0)-\\pi }{0-\\pi } \\\\  & =\\frac{(\\frac{\\pi }{2}-\\pi )}{(-\\pi )} \\\\  & =\\frac{(-\\frac{\\pi }{2})}{(-\\pi )} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186183923 :question/id #uuid "7ce46ca9-cfff-5e8b-89b9-a2a7b34921fd" :question/math-academy-id "e-10537" :question/problem "Compute the value of $\\lim_\\limits{x \\to \\, \\infty}\\cos\\left( \\dfrac{2}{3}\\arctan \\left(2x+1\\right)\\right).$" :question/worked-solution "First, let's sketch the graph of  $y =\\arctan \\left(2x+1\\right){:}$  \n\n![](images/06/06d01e3eb47f69e5172e0ba3c99708a05c79b12a48764fe29c50e94f93b73dd1.png)\n\nThe domain of   $\\arctan \\left(2x+1 \\right)$ is $(-\\infty,\\infty).$   \n\nAs $x$ increases to $\\infty,$ the graph tends to $y={\\color{blue}\\dfrac{\\pi}{2}}.$ Therefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,\\infty }\\operatorname{cos}⁡(\\frac{2}{3}\\operatorname{arctan}⁡(2x+1)) & =\\operatorname{cos}⁡(\\frac{2}{3}\\cdot (\\frac{\\pi }{2})) \\\\  & =\\operatorname{cos}⁡(\\frac{\\pi }{3}) \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186183948 :question/id #uuid "a99e8d2c-1934-57a9-9a6a-578ec9230f6f" :question/math-academy-id "e-14407" :question/problem "Evaluate the integral $\\displaystyle{\\int_{0}^{\\sqrt {\\ln 4}} 16xe^{-2x^2}\\, \\textrm{d}x}$." :question/worked-solution "Let's introduce the new variable $u=-2x^2.$ Differentiating gives\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=-4x\n\\qquad\\Longrightarrow\\qquad\n-4 \\, \\textrm{d}u=16x \\, \\textrm{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt {\\ln 4}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $-2\\ln 4$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡4}}16x{e}^{-2{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡4}}{e}^{-2{x}^{2}}\\cdot 16x\\,\\text{d}x \\\\  & ={\\int }_{0}^{-2\\operatorname{ln}⁡4}{e}^{u}\\cdot (-4\\,\\text{d}u) \\\\  & =-4{\\int }_{0}^{-2\\operatorname{ln}⁡4}{e}^{u}\\,\\text{d}u \\\\  & =-4{e}^{u}\\,{|}_{0}^{-2\\operatorname{ln}⁡4} \\\\  & =-4({e}^{-2\\operatorname{ln}⁡4}-{e}^{0}) \\\\  & =-4(\\frac{1}{16}-1) \\\\  & =4(\\frac{15}{16}) \\\\  & =\\frac{15}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186183961 :question/id #uuid "fc7c982c-7e5d-5187-9779-6952f32fe2bf" :question/math-academy-id "e-15019" :question/problem "Rewrite the expression \n\n$$\n\\left(x^2 + 7x + \\dfrac{49}{4}\\right) + 3\n$$\n\nas the sum of a perfect square and a constant." :question/worked-solution "First, we recall the following formula:\n\n$$\nx^2 + {\\color{red}{2}}{\\color{blue}{a}}x + a^2 = (x + {\\color{blue}{a}})^2\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}\n& {x}^{2}+7x+\\frac{49}{4} \\\\\n&= {x}^{2}+7x+{(\\frac{7}{2})}^{2} \\\\\n&= {x}^{2}+2\\cdot \\frac{7}{2}x+{(\\frac{7}{2})}^{2} \\\\\n&= {(x+\\frac{7}{2})}^{2}\n\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\n& ({x}^{2}+7x+\\frac{49}{4})+3 \\\\\n&= {(x+\\frac{7}{2})}^{2}+3.\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184051 :question/id #uuid "d30aa8b4-820f-5ed1-8878-c5566805e3cc" :question/math-academy-id "e-3491" :question/problem "Evaluate $\\sin^2\\left(150^\\circ\\right) + 2\\csc^2\\left(240^\\circ\\right)$." :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/d9/d93c490adbb5cdbc0e9a09b60eea9b82ab93be8e871e334423abc17ddd62955e.png)\n\n- Let's first consider the angle $150^\\circ$. From the unit circle, we see that the angle $150^\\circ$ corresponds to the point $\\left(-\\dfrac{\\sqrt{3}}{2}, \\dfrac{1}{2} \\right)$. Since the sine of the angle corresponds to the $y$-coordinate, we have $\\sin 150^\\circ = \\dfrac{1}{2}$.\n- Now, let's consider the angle $240^\\circ$. From the unit circle, we see that the angle $240^\\circ$ corresponds to the point $\\left(-\\dfrac{1}{2}, -\\dfrac{\\sqrt{3}}{2} \\right)$. Since the sine of the angle corresponds to the $y$-coordinate, we have $\\sin 240^\\circ = -\\dfrac{\\sqrt{3}}{2}$.\n\nUsing the fact that\n\n$$\n\\csc{\\theta} = \\dfrac{1}{\\sin\\theta}\n$$\n\nwe have\n\n$$\n\\begin{aligned}\n\\csc 240^{∘} &= \\frac{1}{\\sin 240^{∘}} \\\\\n&= (1)/((-\\frac{\\sqrt{3}}{2})) \\\\\n&=-\\frac{2}{\\sqrt{3}}\n\\end{aligned}\n$$\n\nFinally, we combine the results:\n\n$$\n\\begin{aligned}\n\\sin^{2} (150^{∘}) + 2\\csc^{2} (240^{∘}) &= (\\frac{1}{2})^{2} + 2(-\\frac{2}{\\sqrt{3}})^{2} \\\\\n&= \\frac{1}{4} + 2(\\frac{4}{3}) \\\\\n&= \\frac{1}{4} + \\frac{8}{3} \\\\\n&= \\frac{35}{12}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184052 :question/id #uuid "c049aaef-f59a-5113-b739-20cc7a6d802c" :question/math-academy-id "e-3520" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\sin u = \\dfrac{3}{4}, \\qquad \\cos u =  -\\dfrac{\\sqrt{7}}{4}, \\qquad \\cos v = \\dfrac{4}{5}.\n$$\n\nGiven that $v$ lies in the first quadrant, and\n\n$$\n\\sin\\left(u + v\\right) = \\dfrac{a- b\\sqrt 7}{20},\n$$\n\ncalculate the value of $a+b.$" :question/worked-solution "First, recall the sum formula for sine:\n\n$$\n\\sin(u+v) = \\sin u \\cos v+ \\cos u \\sin v\n$$\n\nWe know the values of $\\sin{u},$ $\\cos{u},$ and $\\cos{v}.$ To find the missing value of $\\sin{v},$ we can use the Pythagorean identity:\n\n$$\n\\sin^2 v + \\cos^2 v= 1 \\qquad\\Longrightarrow\\qquad \\sin^2 v = 1- \\cos^2 v\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{sin}^{2}⁡v & =1-{cos}^{2}⁡v \\\\  & =1-{(\\frac{4}{5})}^{2} \\\\  & =1-\\frac{{4}^{2}}{{5}^{2}} \\\\  & =1-\\frac{16}{25} \\\\  & =\\frac{25}{25}-\\frac{16}{25} \\\\  & =\\frac{25-16}{25} \\\\  & =\\frac{9}{25}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡v & =\\pm \\sqrt{\\frac{9}{25}} \\\\  & =\\pm \\frac{3}{5}.\\end{aligned}\n$$\n\nWe're given that $v$ lies in the first quadrant, where sine is positive. So, we disregard the negative value, and we have \n\n$$\n\\sin v= \\dfrac{3}{5}.\n$$\n\nWe can now apply the sum formula, as follows:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(u+v) & =\\operatorname{sin}⁡u\\operatorname{cos}⁡v+\\operatorname{cos}⁡u\\operatorname{sin}⁡v \\\\  & =(\\frac{3}{4})(\\frac{4}{5})+(-\\frac{\\sqrt{7}}{4})(\\frac{3}{5}) \\\\  & =\\frac{12}{20}-\\frac{3\\sqrt{7}}{20} \\\\  & =\\frac{12-3\\sqrt{7}}{20}\\end{aligned}\n$$\n\nFinally, $a=12, b=3,$ and $a+b = 15.$"} {:db/id #edb/ref 17592186184053 :question/id #uuid "5da3337e-31d2-5f2d-b236-60088b4bf64d" :question/math-academy-id "e-3524" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\sin u = -\\dfrac {4} {5}, \\qquad\n\\cos v = \\dfrac {15} {17}, \\qquad\n\\sin v = \\dfrac {8} {17}.\n$$\n\nGiven that $u$ lies in the third quadrant, find the value of $\\cos\\left(u + v\\right).$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\cos(u + v) = \\cos u \\cos v - \\sin u \\sin v\n$$\n\nWe know the values of $\\sin{u}$, $\\cos{v}$, and $\\sin{v}.$ To find the missing value of $\\cos{u,}$ we can use the Pythagorean identity:\n\n$$\n\\sin^2 u + \\cos^2 u= 1 \\qquad\\Longrightarrow\\qquad \\cos^2 u = 1- \\sin^2 u\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡u & =1-{sin}^{2}⁡u \\\\  & =1-{(-\\frac{4}{5})}^{2} \\\\  & =1-\\frac{{4}^{2}}{{5}^{2}} \\\\  & =1-\\frac{16}{25} \\\\  & =\\frac{25}{25}-\\frac{16}{25} \\\\  & =\\frac{9}{25}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡u & =\\pm \\sqrt{\\frac{9}{25}} \\\\  & =\\pm \\frac{3}{5}.\\end{aligned}\n$$\n\nWe're given that $u$ lies in the third quadrant, where cosine is negative. So, we disregard the positive value, and we have\n\n$$\n\\cos u= -\\dfrac{3}{5}.\n$$\n\nWe can now apply the sum formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(u+v) & =\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v \\\\  & =(-\\frac{3}{5})(\\frac{15}{17})-(-\\frac{4}{5})(\\frac{8}{17}) \\\\  & =-\\frac{45}{85}+\\frac{32}{85} \\\\  & =-\\frac{13}{85}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184054 :question/id #uuid "275efa61-04bc-5a06-80e0-e75069969c7b" :question/math-academy-id "e-3526" :question/problem "Suppose that for the angles $u$ and $v$, we have\n$\\sin u = -\\dfrac{2}{\\sqrt{5}}, \\qquad \\tan v = 4$.\nGiven that $u$ lies in the third quadrant, find the value of $\\tan\\left(u - v\\right)$." :question/worked-solution "First, we recall the difference formula for tangent:\n\n$$\n\\tan(u-v) = \\dfrac{\\tan u - \\tan v}{1+\\tan u \\tan v}\n$$\n\nWe need to find the value of $\\tan u$. To do that, we first find the value of $\\cos{u}$ using the Pythagorean identity:\n\n$$\n\\sin^2 u + \\cos^2 u= 1 \\qquad\\Longrightarrow\\qquad \\cos^2 u = 1- \\sin^2 u\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}\n\\cos^{2} u &= 1 - \\sin^{2} u \\\\\n&= 1 - (-\\frac{2}{\\sqrt{5}})^{2} \\\\\n&= 1 - (\\frac{2}{\\sqrt{5}})^{2} \\\\\n&= 1 - (2^{2})/((\\sqrt{5})^{2}) \\\\\n&= 1 - \\frac{4}{5} \\\\\n&= \\frac{5}{5} - \\frac{4}{5} \\\\\n&= \\frac{1}{5}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\cos u &= ± \\sqrt{\\frac{1}{5}} \\\\\n&= ± \\frac{1}{\\sqrt{5}}\n\\end{aligned}\n$$\n\nWe're given that $u$ lies in the third quadrant, where cosine is negative. So, we disregard the positive value, and we have\n\n$$\n\\cos u = -\\dfrac{1}{\\sqrt{5}}\n$$\n\nWe can now compute $\\tan u$:\n\n$$\n\\begin{aligned}\n\\tan u &= \\frac{\\sin u}{\\cos u} = ((-\\frac{2}{\\sqrt{5}}))/((-\\frac{1}{\\sqrt{5}})) = 2\n\\end{aligned}\n$$\n\nFinally, we use the difference formula for the tangent:\n\n$$\n\\begin{aligned}\n\\tan (u - v) &= \\frac{\\tan u - \\tan v}{1 + \\tan u\\tan v} \\\\\n&= \\frac{2 - 4}{1 + 2 \\cdot 4} \\\\\n&= ((-2))/(9) \\\\\n&=-\\frac{2}{9}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184057 :question/id #uuid "e4a94ca8-82ee-5776-a46d-b735d4ab60fb" :question/math-academy-id "e-371" :question/problem "Find the integral of $x^2 + 1.$" :question/worked-solution "Applying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int {x}^{2}+1\\,\\text{d}x & =\\int {x}^{2}\\,\\text{d}x+\\int 1\\,\\text{d}x \\\\  & =\\int {x}^{2}\\,\\text{d}x+\\int {x}^{0}\\,\\text{d}x \\\\  & =(\\frac{{x}^{2+1}}{2+1})+x+C \\\\  & =\\frac{1}{3}{x}^{3}+x+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184058 :question/id #uuid "ea7dadee-2b44-5e62-bef4-26fb0cb185ea" :question/math-academy-id "e-372" :question/problem "Calculate $\\displaystyle \\int 2 x^3 - x \\,\\textrm d x.$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int 2{x}^{3}-x\\,\\text{d}x & =2\\int {x}^{3}\\,\\text{d}x-\\int x\\,\\text{d}x \\\\  & =2(\\frac{{x}^{3+1}}{3+1})-(\\frac{{x}^{1+1}}{1+1})+C \\\\  & =2(\\frac{{x}^{4}}{4})-(\\frac{{x}^{2}}{2})+C \\\\  & =\\frac{{x}^{4}}{2}-\\frac{{x}^{2}}{2}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184059 :question/id #uuid "8f99b603-2fba-5a58-9966-b91d3a8a773e" :question/math-academy-id "e-373" :question/problem "Calculate $\\displaystyle \\int \\left( 5(\\sqrt{x})^{3} - 4 x^2 + 5\\right) \\,\\textrm d x.$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (5(\\sqrt{x})^{3}-4{x}^{2}+5)\\,\\text{d}x & =\\int (5{x}^{3/2}-4{x}^{2}+5)\\,\\text{d}x \\\\  & =5\\int {x}^{3/2}\\,\\text{d}x-4\\int {x}^{2}\\text{d}x+5\\int 1\\,\\text{d}x \\\\  & =5(\\frac{{x}^{5/2}}{\\frac{5}{2}})-4(\\frac{{x}^{3}}{3})+5(x)+C \\\\  & =5\\cdot \\frac{2}{5}{x}^{5/2}-\\frac{4}{3}{x}^{3}+5x+C \\\\  & =2\\sqrt{{x}^{5}}-\\frac{4}{3}{x}^{3}+5x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184077 :question/id #uuid "0903a1d0-559d-5ab5-a0f7-1270bac213a9" :question/math-academy-id "e-6014" :question/problem "The fourth roots of the number $z=\\cos\\left(\\dfrac{\\pi}{3}\\right)+\\textrm{i}\\sin\\left(\\dfrac{\\pi}{3}\\right)$ are as follows:\n$z_{0}^{1/4} = \\cos ϕ_{0} + \\textrm{i}\\sin ϕ_{0}; z_{1}^{1/4} = \\cos ϕ_{1} + \\textrm{i}\\sin ϕ_{1}; z_{2}^{1/4} = \\cos ϕ_{2} + \\textrm{i}\\sin ϕ_{2}; z_{3}^{1/4} = \\cos ϕ_{3} + \\textrm{i}\\sin ϕ_{3}$\nFind possible values of $\\phi_0$, $\\phi_1,\\phi_2$ and $\\phi_3$." :question/worked-solution "Any nonzero complex number $z$ has exactly $n$ distinct $n$th roots. Using de Moivre's theorem, we can write down these roots as\n\n$$\nz_{k}^{1/n} = \\sqrt[n]{r}\\left[\\cos\\left(\\dfrac{\\theta+2\\pi{k}}{n}\\right)+\\textrm{i}\\sin\\left(\\dfrac{\\theta+2\\pi{k}}{n}\\right)\\right]\n$$\n\nwhere\n\n$$\nr = \\mid z \\mid, \\qquad \\theta = \\arg(z), \\qquad k=0, 1, 2,..., n-1\n$$\n\nIn our case, we have\n\n$$\nr=1, \\qquad \\theta=\\dfrac{\\pi}{3}, \\qquad n=4\n$$\n\nSubstituting these values into the formula, we obtain\n\n$$\n\\begin{aligned}\nz_{k}^{1/4} &= \\sqrt[3]{1}[\\cos (\\frac{\\frac{π}{3} + 2π \\cdot k}{4}) + \\textrm{i}\\sin (\\frac{\\frac{π}{3} + 2π \\cdot k}{4})] \\\\\n&= [\\cos (\\frac{π}{12} + \\frac{2π \\cdot k}{4}) + \\textrm{i}\\sin (\\frac{π}{12} + \\frac{2π \\cdot k}{4})] \\\\\n&= [\\cos (\\frac{π}{12} + \\frac{π \\cdot k}{2}) + \\textrm{i}\\sin (\\frac{π}{12} + \\frac{π \\cdot k}{2})]\n\\end{aligned}\n$$\n\nFinally, setting $k=0, 1, 2,3$ gives the required roots:\n\n$$\n\\begin{aligned}\nk = 0: z_{0}^{1/4} &= [\\cos (\\frac{π}{12} + \\frac{π \\cdot 0}{2}) + \\textrm{i}\\sin (\\frac{π}{12} + \\frac{π \\cdot 0}{2})] \\\\\n&= \\cos (\\frac{π}{12}) + \\textrm{i}\\sin (\\frac{π}{12}) \\\\\nk = 1: z_{1}^{1/4} &= [\\cos (\\frac{π}{12} + \\frac{π \\cdot 1}{2}) + \\textrm{i}\\sin (\\frac{π}{12} + \\frac{π \\cdot 1}{2})] \\\\\n&= \\cos (\\frac{7π}{12}) + \\textrm{i}\\sin (\\frac{7π}{12}) \\\\\nk = 2: z_{2}^{1/4} &= [\\cos (\\frac{π}{12} + \\frac{π \\cdot 2}{2}) + \\textrm{i}\\sin (\\frac{π}{12} + \\frac{π \\cdot 2}{2})] \\\\\n&= \\cos (\\frac{13π}{12}) + \\textrm{i}\\sin (\\frac{13π}{12}) \\\\\nk = 3: z_{3}^{1/4} &= [\\cos (\\frac{π}{12} + \\frac{π \\cdot 3}{2}) + \\textrm{i}\\sin (\\frac{π}{12} + \\frac{π \\cdot 3}{2})] \\\\\n&= \\cos (\\frac{19π}{12}) + \\textrm{i}\\sin (\\frac{19π}{12})\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\phi_0 = \\dfrac{\\pi}{12}, \\qquad \\phi_1 = \\dfrac{7\\pi}{12}, \\qquad \\phi_2 = \\dfrac{13\\pi}{12}\\qquad \\phi_3 = \\dfrac{19\\pi}{12}\n$$"} {:db/id #edb/ref 17592186184078 :question/id #uuid "7dbb258d-fe71-5e7b-9501-c88ffdb6fe86" :question/math-academy-id "e-629" :question/problem "Find the equation of the tangent line to the polar curve $r = 1+2\\cos\\theta$ at $\\theta = \\dfrac{\\pi}{2},$ given that \n\n$$\n\\dfrac{\\textrm d y}{\\textrm d x} = -\\dfrac{\\cos\\theta  + 2\\cos(2\\theta)}{\\sin\\theta + 2\\sin(2\\theta)}.\n$$" :question/worked-solution "To find the equation of the tangent line to a polar curve at a point $P,$ we follow four steps:\n\n**Step 1**: Calculate the derivative $\\dfrac{\\textrm{d}y}{\\textrm{d}x}.$\n\nIn this case, we're given that\n\n$$\n\\dfrac{\\textrm d y}{\\textrm d x} = -\\dfrac{\\cos\\theta  + 2\\cos(2\\theta)}{\\sin\\theta + 2\\sin(2\\theta)}.\n$$\n\n**Step 2**: Find the slope of the tangent at $P.$\n\nThe slope of the tangent line is\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{\\theta =\\pi /2} \\\\  & =-\\frac{\\operatorname{cos}⁡(\\frac{\\pi }{2})+2\\operatorname{cos}⁡(\\pi )}{\\operatorname{sin}⁡(\\frac{\\pi }{2})+2\\operatorname{sin}⁡(\\pi )} \\\\  & =-\\frac{0+2(-1)}{1+2(0)} \\\\  & =2.\\end{aligned}\n$$\n\n**Step 3**: Find the Cartesian coordinates of $P.$\n\nWe compute the $xy$-coordinates of $P$ as follows:\n\n$$\n\\begin{aligned}{x}_{1} & =r\\operatorname{cos}⁡\\theta  \\\\  & =(1+2\\operatorname{cos}⁡\\theta )\\operatorname{cos}⁡\\theta  \\\\  & =(1+2\\operatorname{cos}⁡(\\frac{\\pi }{2}))\\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\  & =(1+2\\cdot 0)\\cdot 0 \\\\  & =0 \\\\ {y}_{1} & =r\\operatorname{sin}⁡\\theta  \\\\  & =(1+2\\operatorname{cos}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =(1+2\\operatorname{cos}⁡(\\frac{\\pi }{2}))\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\  & =(1+2\\cdot 0)\\cdot 1 \\\\  & =1\\cdot 1 \\\\  & =1\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(0,1).$\n\n**Step 4**: Using point-slope form, find the equation of the tangent.\n\nWe find the equation of the tangent as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =2(x-0) \\\\ y & =2x+1\\end{aligned}\n$$\n\n![](images/30/30b1aedfd6187ed1f936ef1faf25fcb8b99857103c656163a3e6897e5c6c5038.png)"} {:db/id #edb/ref 17592186184080 :question/id #uuid "f6c910a1-cd2c-5d9a-ad67-974aaba4a5b4" :question/math-academy-id "e-647" :question/problem "Does the sequence $a_n = \\dfrac {2 \\cdot (-3) ^ n}{5 ^ {n + 1}}$ for $n\\geq 1$ converge or diverge?\nIf it converges, what is its limit?" :question/worked-solution "Suppose we have a geometric sequence with the first term $a_1$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r| <           1,$ the sequence is convergent and converges to $0$\n\n- if $|r| > 1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to $a_1$\n\n- if $r = -1,$ the sequence is divergent\n\nFirst, we rewrite the sequence in the form $a_n = a \\cdot r^{n},$ as follows:\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{2\\cdot (-3)^{n}}{{5}^{n+1}} \\\\  & =\\frac{2\\cdot (-3)^{n}}{5\\cdot {5}^{n}} \\\\  & =\\frac{2}{5}\\cdot \\frac{(-3)^{n}}{{5}^{n}} \\\\  & =\\frac{2}{5}{(-\\frac{3}{5})}^{n}.\\end{aligned}\n$$\n\nWe can now see that this is the geometric sequence with $r=-\\dfrac{3}{5} .$ \n\nSince $|r| < 1,$ the sequence converges to $0.$"} {:db/id #edb/ref 17592186184083 :question/id #uuid "6e12005d-4652-532c-a715-3ab9d9ad3618" :question/math-academy-id "e-7139" :question/problem "Write the equation $2x^2 - 6x = 1$ in the form $(x+p)^2 = q,$ and hence solve the equation." :question/worked-solution "First, we divide out by the coefficient of the quadratic term, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}2{x}^{2}-6x & =1 \\\\ 2({x}^{2}-3x) & =1 \\\\ {x}^{2}-3x & =\\frac{1}{2} \\\\ {x}^{2}-2\\cdot \\frac{3}{2}\\cdot x & =\\frac{1}{2} \\\\ {x}^{2}-2\\cdot (\\frac{3}{2})\\cdot x+{(\\frac{3}{2})}^{2}-{(\\frac{3}{2})}^{2} & =\\frac{1}{2} \\\\ {(x-\\frac{3}{2})}^{2}-{(\\frac{3}{2})}^{2} & =\\frac{1}{2}\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}{(x-\\frac{3}{2})}^{2}-{(\\frac{3}{2})}^{2} & =\\frac{1}{2} \\\\ {(x-\\frac{3}{2})}^{2}-\\frac{9}{4} & =\\frac{2}{4} \\\\ {(x-\\frac{3}{2})}^{2} & =\\frac{11}{4}\\end{aligned}\n$$\n\nSo, $p=-\\dfrac32$ and $q=\\dfrac{11}{4}.$ Now, we solve the equation using the square root method:\n\n$$\n\\begin{aligned}\\sqrt{{(x-\\frac{3}{2})}^{2}} & =\\sqrt{\\frac{11}{4}} \\\\ |x-\\frac{3}{2}| & =\\frac{\\sqrt{11}}{2} \\\\ x-\\frac{3}{2} & =\\pm \\frac{\\sqrt{11}}{2} \\\\ x & =\\frac{3}{2}\\pm \\frac{\\sqrt{11}}{2} \\\\ x & =\\frac{3\\pm \\sqrt{11}}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184084 :question/id #uuid "9dfe0c3a-2c54-5270-ab0d-0d2dad09a199" :question/math-academy-id "e-7140" :question/problem "Write the equation $-2x^2+2x+1 = 0$ in the form $2(x+p)^2=q,$ and hence solve the equation." :question/worked-solution "First, we multiply the equation by $-1$:\n\n$$\n\\begin{aligned}(-1)\\cdot (-2{x}^{2}+2x+1) & =(-1)\\cdot 0 \\\\ 2{x}^{2}-2x-1 & =0\\end{aligned}\n$$\n\nNow, we move the constant term to the right-hand side, factor the coefficient of the quadratic term, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}2{x}^{2}-2x-1 & =0 \\\\ 2{x}^{2}-2x & =1 \\\\ 2({x}^{2}-x) & =1 \\\\ 2[{x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2}-{(\\frac{1}{2})}^{2}] & =1 \\\\ 2[{(x-\\frac{1}{2})}^{2}-\\frac{1}{4}] & =1\\end{aligned}\n$$\n\nNext, we expand the brackets, and write the equation in the required form:\n\n$$\n\\begin{aligned}2[{(x-\\frac{1}{2})}^{2}-\\frac{1}{4}] & =1 \\\\ 2{(x-\\frac{1}{2})}^{2}-\\frac{1}{2} & =1 \\\\ 2{(x-\\frac{1}{2})}^{2} & =\\frac{3}{2}\\end{aligned}\n$$\n\nTherefore, $p=-\\dfrac12$ and $q=\\dfrac32.$ We now solve the equation using the square root method:\n\n$$\n\\begin{aligned}2{(x-\\frac{1}{2})}^{2} & =\\frac{3}{2} \\\\ {(x-\\frac{1}{2})}^{2} & =\\frac{3}{4} \\\\ \\sqrt{{(x-\\frac{1}{2})}^{2}} & =\\sqrt{\\frac{3}{4}} \\\\ |x-\\frac{1}{2}| & =\\frac{\\sqrt{3}}{2} \\\\ x-\\frac{1}{2} & =\\pm \\frac{\\sqrt{3}}{2} \\\\ x & =\\frac{1}{2}\\pm \\frac{\\sqrt{3}}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184087 :question/id #uuid "05dec044-4b3b-5f42-88c5-b7ab323b0e97" :question/math-academy-id "e-743" :question/problem "Let $f(x) = \\sin{x}.$ Calculate the fourth-degree Taylor polynomial for $f(x)$ about $x=\\dfrac{\\pi}{2}.$" :question/worked-solution "The fourth-degree Taylor polynomial of $f(x)$ about $x=a$ is given by\n\n$$\nP_4(x) = f(a) + f'(a)(x-a) + \\dfrac{f''(a)}{2!}(x-a)^2 + \\dfrac{f'''(a)}{3!}(x-a)^3 + \\dfrac{f^{(4)}(a)}{4!}(x-a)^4.\n$$\n\nHere, we have $a=\\dfrac{\\pi}{2},$ so\n\n$$\n\\begin{aligned}{P}_{4}(x) & =f(\\frac{\\pi }{2})+{f}^{′}(\\frac{\\pi }{2})(x-\\frac{\\pi }{2})+\\frac{{f}^{″}(\\frac{\\pi }{2})}{2!}{(x-\\frac{\\pi }{2})}^{2} \\\\  & \\,\\,\\,\\,+\\frac{{f}^{‴}(\\frac{\\pi }{2})}{3!}{(x-\\frac{\\pi }{2})}^{3}+\\frac{{f}^{(4)}(\\frac{\\pi }{2})}{4!}{(x-\\frac{\\pi }{2})}^{4}.\\end{aligned}\n$$\n\nSo we need to work out $f\\left(\\dfrac{\\pi}{2}\\right),$ $f'\\left(\\dfrac{\\pi}{2}\\right),$ $f''\\left(\\dfrac{\\pi}{2}\\right),$ $f'''\\left(\\dfrac{\\pi}{2}\\right)$ and $f^{(4)}\\left(\\dfrac{\\pi}{2}\\right),$ as follows:\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{sin}⁡x & ⟹ &  & f(\\frac{\\pi }{2}) & =1 \\\\ {f}^{′}(x) & =\\operatorname{cos}⁡x & ⟹ &  & {f}^{′}(\\frac{\\pi }{2}) & =0 \\\\ {f}^{″}(x) & =-\\operatorname{sin}⁡x & ⟹ &  & {f}^{″}(\\frac{\\pi }{2}) & =-1 \\\\ {f}^{‴}(x) & =-\\operatorname{cos}⁡x & ⟹ &  & {f}^{‴}(\\frac{\\pi }{2}) & =0 \\\\ {f}^{(4)}(x) & =\\operatorname{sin}⁡x & ⟹ &  & {f}^{(4)}(\\frac{\\pi }{2}) & =1.\\end{aligned}\n$$\n\nTherefore, $P_4(x)$ is given by\n\n$$\n\\begin{aligned}{P}_{4}(x) & =1-\\frac{1}{2!}{(x-\\frac{\\pi }{2})}^{2}+\\frac{1}{4!}{(x-\\frac{\\pi }{2})}^{4} \\\\  & =1-\\frac{1}{2}{(x-\\frac{\\pi }{2})}^{2}+\\frac{1}{24}{(x-\\frac{\\pi }{2})}^{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184090 :question/id #uuid "e82fb0f9-372a-50ab-a6a5-c1dc8868a2d6" :question/math-academy-id "e-753" :question/problem "Use the first three terms of the Taylor expansion for $f(x) = \\sqrt x$ about $x=9$ to approximate the value of $\\sqrt{9.1}.$" :question/worked-solution "We use Taylor's theorem in the form\n\n$$\nf(x)\t= f(a) + f'(a)(x-a) + \\frac{f''(a)}{2!}(x-a)^2 +\\cdots,\n$$\n\nwith $a=9.$ \n\nCalculating the necessary derivatives, we get\n\n$$\n\\begin{aligned}f(x) & ={x}^{1/2} \\\\ f(9) & =3 \\\\ {f}^{′}(x) & =\\frac{1}{2}{x}^{-1/2} \\\\ {f}^{′}(9) & =\\frac{1}{6} \\\\ {f}^{″}(x) & =-\\frac{1}{4}{x}^{-3/2} \\\\ {f}^{″}(9) & =-\\frac{1}{108}.\\end{aligned}\n$$\n\nSo, the Taylor series is\n\n$$\n\\begin{aligned}\\sqrt{x} & =3+\\frac{1}{6}(x-9)+\\frac{1}{2}(-\\frac{1}{108})(x-9)^{2}+⋯ \\\\  & =3+\\frac{1}{6}(x-9)-\\frac{1}{216}(x-9)^{2}+⋯.\\end{aligned}\n$$\n\nWe substitute $x = 9.1$ into the above to approximate $\\sqrt{9.1}.$ We get\n\n$$\n\\begin{aligned}\\sqrt{9.1} & ≈3+\\frac{1}{6}(9.1-9)-\\frac{1}{216}(9.1-9)^{2} \\\\  & ≈3+\\frac{1}{6}(0.1)-\\frac{1}{216}(0.1)^{2} \\\\  & =3.016\\,620,\\end{aligned}\n$$\n\nto six decimal places. \n\n**Note:** The exact value of $\\sqrt{9.1}$ is $3.016\\,621$ to six decimal places. So, our approximation is very good!"} {:db/id #edb/ref 17592186184104 :question/id #uuid "ca98d9bd-337e-5982-9609-e3d0f4601575" :question/math-academy-id "e-9779" :question/problem "Find the first $3$ terms in ascending powers of $m$ of the binomial expansion of $\\left(1 - \\dfrac{4m}{3}\\right)^7.$" :question/worked-solution "The first $3$ terms of the binomial expansion for ${(1 + x)^n}$ are given by\n\n$$\n{(1 + x)}^n = 1 + nx + \\frac{{n(n - 1)}}{{2!}}{x^2}  +  \\cdots .\n$$\n\nBy substituting $x=-\\dfrac{4m}{3}$ and $n=7$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-\\frac{4m}{3})}^{7} & =1+7(-\\frac{4m}{3})+\\frac{7(7-1)}{2!}{(-\\frac{4m}{3})}^{2}+⋯ \\\\  & =1+7(-\\frac{4m}{3})+\\frac{7(6)}{2}{(-\\frac{4m}{3})}^{2}+⋯ \\\\  & =1+7(-\\frac{4m}{3})+\\frac{7(6)}{2}(\\frac{16{m}^{2}}{9})+⋯ \\\\  & =1-\\frac{28m}{3}+\\frac{112{m}^{2}}{3}+⋯.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184106 :question/id #uuid "b0506d9d-2495-505f-b61f-6c01607ad43f" :question/math-academy-id "e-9815" :question/problem "Evaluate $4\\cos^2 \\left(\\dfrac \\pi 6\\right) - \\sin \\left(\\dfrac \\pi 4\\right)$." :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\n- Let's first consider the angle $\\dfrac{\\pi}{6}$. From the unit circle, we see that the angle $\\dfrac{\\pi}{6}$ corresponds to the point $\\left(\\dfrac{\\sqrt{3}}{2}, \\dfrac{1}{2} \\right)$. Since the cosine of the angle corresponds to the $x$-coordinate, we have $\\cos\\left(\\dfrac {\\pi} {6}\\right) = \\dfrac{\\sqrt{3}}{2}$.\n- Now, let's consider the angle $\\dfrac \\pi 4$. From the unit circle, we see that the angle $\\dfrac \\pi 4$ corresponds to the point $\\left(\\dfrac{\\sqrt{2}}{2}, \\dfrac{\\sqrt{2}}{2} \\right)$. Since the sine of the angle corresponds to the $y$-coordinate, we have $\\sin\\left(\\dfrac {\\pi} {4}\\right) = \\dfrac{\\sqrt{2}}{2}$.\n\nFinally, we combine the results:\n\n$$\n\\begin{aligned}\n4\\cos^{2} (\\frac{π}{6}) - \\sin (\\frac{π}{4}) &= 4(\\frac{\\sqrt{3}}{2})^{2} - \\frac{\\sqrt{2}}{2} \\\\\n&= 3 - \\frac{\\sqrt{2}}{2}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184120 :question/id #uuid "59156f24-72a1-5642-ac66-f84002c87d0b" :question/math-academy-id "e-9955" :question/problem "![](images/fc/fc3ec38b91c71be3e9638dfa0127f1baab5d11d30e6156d863b36758f6751e7d.png)\n\nFind the equation of the **normal** line to the polar curve $r = 1 - 2\\cos\\theta$ at $\\theta = \\dfrac{3\\pi}{2},$ given that\n\n$$\ny'(\\theta)  = \\cos\\theta-2\\cos(2\\theta) , \\qquad\nx'(\\theta) = 2\\sin(2\\theta) - \\sin\\theta.\n$$" :question/worked-solution "To find the equation of the normal line to a polar curve at a point $P,$ we follow four steps:\n\n**Step 1**: Calculate the derivative $\\dfrac{\\textrm{d}y}{\\textrm{d}x}.$\n\nIn this case, we're given that\n\n$$\ny'(\\theta)  = \\cos\\theta-2\\cos(2\\theta) , \\qquad\nx'(\\theta) = 2\\sin(2\\theta) - \\sin\\theta.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & =\\frac{\\operatorname{cos}⁡\\theta -2\\operatorname{cos}⁡(2\\theta )}{2\\operatorname{sin}⁡(2\\theta )-\\operatorname{sin}⁡\\theta }\\end{aligned}\n$$\n\n**Step 2**: Find the slope of the tangent at $P.$\n\nThe slope of the tangent line is\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{\\theta =3\\pi /2} \\\\  & =\\frac{(\\operatorname{cos}⁡(\\frac{3\\pi }{2})-2\\operatorname{cos}⁡(2\\cdot \\frac{3\\pi }{2}))}{(2\\operatorname{sin}⁡(2\\cdot \\frac{3\\pi }{2})-\\operatorname{sin}⁡(\\frac{3\\pi }{2}))} \\\\  & =\\frac{(\\operatorname{cos}⁡(\\frac{3\\pi }{2})-2\\operatorname{cos}⁡(3\\pi ))}{(2\\operatorname{sin}⁡(3\\pi )-\\operatorname{sin}⁡(\\frac{3\\pi }{2}))} \\\\  & =\\frac{0-2(-1)}{0-(-1)} \\\\  & =\\frac{0+2}{0+1} \\\\  & =2.\\end{aligned}\n$$\n\n**Step 3**: Find the Cartesian coordinates of $P.$\n\nWe compute the $xy$-coordinates of $P$ as follows:\n\n$$\n\\begin{aligned}{x}_{1} & =r\\operatorname{cos}⁡\\theta  \\\\  & =(1-2\\operatorname{cos}⁡\\theta )\\operatorname{cos}⁡\\theta  \\\\  & =(1-2\\operatorname{cos}⁡(\\frac{3\\pi }{2}))\\operatorname{cos}⁡(\\frac{3\\pi }{2}) \\\\  & =(1-2\\cdot 0)\\cdot 0 \\\\  & =0 \\\\ {y}_{1} & =r\\operatorname{sin}⁡\\theta  \\\\  & =(1-2\\operatorname{cos}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =(1-2\\operatorname{cos}⁡(\\frac{3\\pi }{2}))\\operatorname{sin}⁡(\\frac{3\\pi }{2}) \\\\  & =(1-2\\cdot 0)\\cdot (-1) \\\\  & =1\\cdot (-1) \\\\  & =-1\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $\\left( 0, -1 \\right).$\n\n**Step 4**: Using point-slope form, find the equation of the normal.\n\nWe find the equation of the normal as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =-\\frac{1}{m}(x-{x}_{1}) \\\\ y-(-1) & =-\\frac{1}{2}\\cdot (x-0) \\\\ y+1 & =-\\frac{1}{2}x \\\\ y & =-\\frac{1}{2}x-1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184127 :question/id #uuid "c8e2b559-31ab-5b52-98b1-6a36dfefc505" :question/math-academy-id "e-9969" :question/problem "Solve the equation $\\log_2 (4x) - 2\\log_2\\left(x^2\\right) = 1$." :question/worked-solution "Notice that the logarithms share the same base.\n\nFirst, we apply the power rule to the first term to make the coefficient in front of each logarithm the same:\n\n$$\n\\begin{aligned}\n\\log_{2} (4x) - 2\\log_{2} (x^{2}) = 1 \\\\\n&= \\log_{2} (4x) - \\log_{2} ((x^{2})^{2}) = 1 \\\\\n\\log_{2} (4x) - \\log_{2} (x^{4}) &= 1\n\\end{aligned}\n$$\n\nNext, we combine the logarithms using the quotient rule. This gives\n\n$$\n\\begin{aligned}\n\\log_{2} (\\frac{4x}{x^{4}}) &= 1 \\\\\n\\log_{2} (\\frac{4}{x^{3}}) &= 1\n\\end{aligned}\n$$\n\nWriting this equation in its equivalent exponential form, we get\n\n$$\n\\begin{aligned}\n\\frac{4}{x^{3}} &= 2^{1} \\\\\n\\frac{4}{x^{3}} &= 2\n\\end{aligned}\n$$\n\nNow, we solve this rational equation for $x$ using the usual methods.\n\n$$\n{\\begin{array}{rl}\\displaystyle {\\displaystyle \\frac{4}{ {x}^{3}}} & \\displaystyle  = 2 \\\\ \\displaystyle {x}^{3} \\cdot  {\\displaystyle \\frac{4}{ {x}^{3}}} & \\displaystyle  = {x}^{3} \\cdot  2 \\\\ \\displaystyle \\cancel{ {x}^{3}} \\cdot  {\\displaystyle \\frac{4}{\\cancel{ {x}^{3}}}} & \\displaystyle  = 2 {x}^{3} \\\\ \\displaystyle 2 {x}^{3} & \\displaystyle  = 4 \\\\ \\displaystyle {x}^{3} & \\displaystyle  = 2 \\\\ \\displaystyle x & \\displaystyle  = \\sqrt[3]{2}\\end{array}}\n$$\n\nLet's now check for an extraneous solution by substituting back into the original equation:\n\nSubstituting\n\n$$\nx=\\sqrt[3]{2}\n$$\n\nback into the original equation, we get\n\n$$\n{\\begin{array}{rl}\\displaystyle {\\log }_{2}  ( 4 ( \\sqrt[3]{2} ) ) - 2 {\\log }_{2}  ( ( \\sqrt[3]{2} {)}^{2} ) & \\displaystyle  \\overset{?}{=} 1 \\\\ \\displaystyle {\\log }_{2}  ( 4 ( \\sqrt[3]{2} ) ) - {\\log }_{2}  {( ( \\sqrt[3]{2} {)}^{2} )}^{2} & \\displaystyle  \\overset{?}{=} 1 \\\\ \\displaystyle {\\log }_{2}  ( 4 ( \\sqrt[3]{2} ) ) - {\\log }_{2}  ( ( \\sqrt[3]{2} {)}^{4} ) & \\displaystyle  \\overset{?}{=} 1 \\\\ \\displaystyle {\\log }_{2}  ( 4 ( \\sqrt[3]{2} ) ) - {\\log }_{2}  ( 2 ( \\sqrt[3]{2} ) ) & \\displaystyle  \\overset{?}{=} 1 \\\\ \\displaystyle {\\log }_{2}  ( {\\displaystyle \\frac{4 \\sqrt[3]{2}}{2 \\sqrt[3]{2}}} ) & \\displaystyle  \\overset{?}{=} 1 \\\\ \\displaystyle {\\log }_{2}  ( {\\displaystyle \\frac{4 \\cancel{\\sqrt[3]{2}}}{2 \\cancel{\\sqrt[3]{2}}}} ) & \\displaystyle  \\overset{?}{=} 1 \\\\ \\displaystyle {\\log }_{2}  ( {\\displaystyle \\frac{4}{2}} ) & \\displaystyle  \\overset{?}{=} 1 \\\\ \\displaystyle {\\log }_{2}  ( 2 ) & \\displaystyle  \\overset{?}{=} 1 \\\\ \\displaystyle 1 & \\displaystyle  = 1. \\hspace{1em} {\\color{green}✓}\\end{array}}\n$$\n\nTherefore,\n\n$$\nx=\\sqrt[3]{2}\n$$\n\nis a valid solution."} {:db/id #edb/ref 17592186184128 :question/id #uuid "e62ac8e2-176a-51b0-a36e-b73cde9ac136" :question/math-academy-id "e-9971" :question/problem "Solve the equation $2\\log_3 (\\sqrt 2x) - \\log_3(x - 1) = \\log_3 (3x)$." :question/worked-solution "Notice that the logarithms share the same base.\n\nFirst, we apply the power rule to the *first* term to make the coefficient in front of each logarithm the same:\n\n$$\n\\begin{aligned}\n2\\log_{3} (\\sqrt{2}x) - \\log_{3} (x - 1) &= \\log_{3} (3x) \\\\\n\\log_{3} (\\sqrt{2}x)^{2} - \\log_{3} (x - 1) &= \\log_{3} (3x) \\\\\n\\log_{3} (2x^{2}) - \\log_{3} (x - 1) &= \\log_{3} (3x)\n\\end{aligned}\n$$\n\nNext, we combine the logarithms on the left-hand side using the quotient rule:\n\n$$\n\\begin{aligned}\n\\log_{3} (\\frac{2x^{2}}{x - 1}) &= \\log_{3} (3x)\n\\end{aligned}\n$$\n\nNow, we solve the equation for $x$ using the usual methods.\n\n$$\n{\\begin{array}{rl}\\displaystyle {\\displaystyle \\frac{2 {x}^{2}}{x - 1}} & \\displaystyle  = 3 x \\\\ \\displaystyle ( x - 1 ) \\cdot  {\\displaystyle \\frac{2 {x}^{2}}{x - 1}} & \\displaystyle  = ( x - 1 ) \\cdot  ( 3 x ) \\\\ \\displaystyle \\cancel{( x - 1 )} \\cdot  {\\displaystyle \\frac{2 {x}^{2}}{\\cancel{x - 1}}} & \\displaystyle  = ( x - 1 ) \\cdot  ( 3 x ) \\\\ \\displaystyle 2 {x}^{2} & \\displaystyle  = 3 {x}^{2} - 3 x \\\\ \\displaystyle {x}^{2} - 3 x & \\displaystyle  = 0 \\\\ \\displaystyle x ( x - 3 ) & \\displaystyle  = 0\\end{array}}\n$$\n\nSo, $x = 0$ and $x =3$.\n\nLet's now check for extraneous solutions by substituting them back into the original equation:\n\n- Substituting $x=0$ back into the original equation, we get\n$2\\log_{3} (\\sqrt{2} \\cdot 0) - \\log_{3} (0 - 1)|=^(?)\\log_{3} (3 \\cdot 0); 2\\log_{3} (0) - \\log_{3} (-1)|=^(?)\\log_{3} (0).\\cdot$\nThis statement is false because $\\log_3 (0)$ and $\\log_3 (-1)$ are undefined. Therefore, $x=0$ is not a valid solution.\n\n- Substituting $x=3$ back into the original equation, we get\n$2\\log_{3} (3\\sqrt{2}) - \\log_{3} (3 - 1)|=^(?)\\log_{3} (3 \\cdot 3); \\log_{3} (3\\sqrt{2})^{2} - \\log_{3} (2)|=^(?)\\log_{3} (9); \\log_{3} (18) - \\log_{3} (2)|=^(?)\\log_{3} (9); \\log_{3} (\\frac{18}{2})|=^(?)\\log_{3} (9); \\log_{3} (9)|= \\log_{3} (9).✓$\nTherefore, $x=3$ is a valid solution.\n\nTherefore, the correct answer is \"$x=3$ only\"."} {:db/id #edb/ref 17592186184132 :question/id #uuid "06df772e-eb43-55e8-9ede-3fc2f7ae291d" :question/math-academy-id "e-9984" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\cos u = \\dfrac{7}{25}, \\qquad \\sin v = \\dfrac{4}{5}, \\qquad \\cos v = \\dfrac {3} {5}.\n$$\n\nGiven that $u$ lies in the fourth quadrant, find the value of $\\sin(u-v).$" :question/worked-solution "First, recall the difference formula for sine:\n\n$$\n\\sin(u-v) = \\sin u \\cos v- \\cos u \\sin v\n$$\n\nWe know the values of $\\cos{u}$, $\\sin{v}$, and $\\cos{v}.$ To find the missing value of $\\sin{u}$, we can use the Pythagorean identity:\n\n$$\n\\sin^2 u + \\cos^2 u= 1 \\qquad\\Longrightarrow\\qquad \\sin^2 u = 1- \\cos^2 u\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{sin}^{2}⁡u & =1-{cos}^{2}⁡u \\\\  & =1-{(\\frac{7}{25})}^{2} \\\\  & =1-\\frac{{7}^{2}}{{25}^{2}} \\\\  & =1-\\frac{49}{625} \\\\  & =\\frac{625}{625}-\\frac{49}{625} \\\\  & =\\frac{576}{625}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡u & =\\pm \\sqrt{\\frac{576}{625}} \\\\  & =\\pm \\frac{24}{25}.\\end{aligned}\n$$\n\nWe're given that $u$ lies in the fourth quadrant, where sine is negative. So, we disregard the positive value, and we have \n\n$$\n\\sin u= -\\dfrac{24}{25}.\n$$\n\nWe can now apply the difference formula, as follows:\n\n$$\n\\begin{aligned}\n\t\t\\sin(u - v) \n\t\t\t&= \\sin u \\cos v - \\cos u \\sin v \\\\[5pt]\n\t\t\t&= \\left( -\\dfrac {24}{25} \\right)\\left(\\dfrac {3} {5}\\right)\n \t\t\t\t -  \\left(\\dfrac {7}{25}\\right) \\left( \\dfrac {4} {5}\\right) \\\\[5pt]\n\t\t\t\n \t\t\t&= -\\dfrac {72} {125} -  \\dfrac {28} {125} \\\\[5pt]\n\t\t\t&= -\\dfrac {100} {125}\\\\[5pt]\n\t\t\t&= -\\dfrac {4} {5}.\n\t\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184135 :question/id #uuid "8877f6b8-8914-5022-9ec6-d4e8e0d3d159" :question/math-academy-id "e-9992" :question/problem "Suppose that for the angles $u$ and $v,$ we have \n\n$$\n\\sin u = \\dfrac {4} {5}, \\qquad\n\\cos u = \\dfrac {3} {5}, \\qquad \n\\sin v = \\dfrac {9} {15}.\n$$\n\nGiven that $v$ lies in the first quadrant, find the value of $\\cos\\left(u - v\\right).$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\cos(u - v) = \\cos u \\cos v + \\sin u \\sin v\n$$\n\nWe know the values of $\\sin{u}$, $\\cos{u}$, and $\\sin{v}.$ To find the missing value of $\\cos{v,}$ we can use the Pythagorean identity:\n\n$$\n\\sin^2 v + \\cos^2 v= 1 \\qquad\\Longrightarrow\\qquad \\cos^2 v = 1- \\sin^2 v\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡v & =1-{sin}^{2}⁡v \\\\  & =1-{(\\frac{9}{15})}^{2} \\\\  & =1-\\frac{{9}^{2}}{{15}^{2}} \\\\  & =1-\\frac{81}{225} \\\\  & =\\frac{225}{225}-\\frac{81}{225} \\\\  & =\\frac{144}{225}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡v & =\\pm \\sqrt{\\frac{144}{225}} \\\\  & =\\pm \\frac{12}{15}.\\end{aligned}\n$$\n\nWe're given that $v$ lies in the first quadrant, where cosine is positive. So, we disregard the negative value, and we have\n\n$$\n\\cos v= \\dfrac{12}{15}.\n$$\n\nWe can now apply the difference formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(u-v) & =\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v \\\\  & =(\\frac{3}{5})(\\frac{12}{15})+(\\frac{4}{5})(\\frac{9}{15}) \\\\  & =\\frac{36}{75}+\\frac{36}{75} \\\\  & =\\frac{72}{75} \\\\  & =\\frac{24}{25}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184136 :question/id #uuid "fa5a0465-1208-5794-89e7-fb457105fd06" :question/math-academy-id "e-9994" :question/problem "Suppose that for the angles $u$ and $v$, we have\n$\\sin u = \\dfrac {4}{5}, \\qquad \\tan v = \\dfrac{1}{2}$.\nGiven that $u$ lies in the first quadrant, find the value of $\\tan\\left(u + v\\right)$." :question/worked-solution "First, we recall the sum formula for tangent:\n\n$$\n\\tan(u+v) = \\dfrac{\\tan{u}+\\tan{v}}{1-\\tan{u}\\tan{v}}\n$$\n\nWe need to find the value of $\\tan u$. To do that, we first find the value of $\\cos{u}$ using the Pythagorean identity:\n\n$$\n\\sin^2 u + \\cos^2 u= 1 \\qquad\\Longrightarrow\\qquad \\cos^2 u = 1- \\sin^2 u\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}\n\\cos^{2} u &= 1 - \\sin^{2} u \\\\\n&= 1 - (\\frac{4}{5})^{2} \\\\\n&= 1 - \\frac{4^{2}}{5^{2}} \\\\\n&= 1 - \\frac{16}{25} \\\\\n&= \\frac{25}{25} - \\frac{16}{25} \\\\\n&= \\frac{9}{25}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\cos u &= ± \\sqrt{\\frac{9}{25}} \\\\\n&= ± \\frac{3}{5}\n\\end{aligned}\n$$\n\nWe're given that $u$ lies in the first quadrant, where cosine is positive. So, we disregard the negative value, and we have\n\n$$\n\\cos u= \\dfrac{3}{5}\n$$\n\nWe can now compute $\\tan u$:\n\n$$\n\\begin{aligned}\n\\tan u &= \\frac{\\sin u}{\\cos u} = ((\\frac{4}{5}))/((\\frac{3}{5})) = \\frac{4}{3}\n\\end{aligned}\n$$\n\nFinally, we use the sum formula for the tangent:\n\n$$\n\\begin{aligned}\n\\tan (u + v) &= \\frac{\\tan u + \\tan v}{1 - \\tan u\\tan v} \\\\\n&= ((\\frac{4}{3} + \\frac{1}{2}))/((1 - \\frac{4}{3} \\cdot \\frac{1}{2})) \\\\\n&= ((\\frac{11}{6}))/((\\frac{1}{3})) \\\\\n&= \\frac{11}{2}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184437 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cb26523-cf9a-5e6f-a6df-561191311046" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x+\\sqrt{2}" :db/id #edb/ref 17592186541480} {:answer/id #uuid "6a904a99-9555-59da-b4b7-d0e6556359cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x" :db/id #edb/ref 17592186541636} {:answer/id #uuid "82b05dd1-ec82-5b6d-87ab-194bbf6fb236" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x-\\sqrt{2}" :db/id #edb/ref 17592186541686} {:answer/id #uuid "96221e88-2457-5022-8d30-9d942b87da36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\sqrt{2}x" :db/id #edb/ref 17592186541734} {:answer/id #uuid "c63bb719-501d-5899-9990-749d6453007b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x+\\sqrt{2}" :db/id #edb/ref 17592186541841}] :answer-field/correct {:answer/id #uuid "6a904a99-9555-59da-b4b7-d0e6556359cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x" :db/id #edb/ref 17592186541636} :answer-field/id #uuid "f400af5e-45e9-590f-bfe9-235c2c3163f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186180799}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ca4cdd59-0ef8-55a6-b3e4-91d9fcc40f65" :question/math-academy-id "q-103835" :question/problem "Find the equation of the **normal** line to the polar curve $r=\\operatorname{sin}⁡(2\\theta )$ at $\\theta =\\frac{3\\pi }{4},$ given that \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{3\\operatorname{sin}⁡(3\\theta )-\\operatorname{sin}⁡\\theta }{3\\operatorname{cos}⁡(3\\theta )+\\operatorname{cos}⁡\\theta }.\n$$" :question/requires-calculator true :question/worked-solution "To find the equation of the normal line to a polar curve at a point $P,$ we follow four steps:\n\n**Step 1**: Calculate the derivative $\\frac{\\text{d}y}{\\text{d}x}:$\n\nIn this case, we're given that\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{3\\operatorname{sin}⁡(3\\theta )-\\operatorname{sin}⁡\\theta }{3\\operatorname{cos}⁡(3\\theta )+\\operatorname{cos}⁡\\theta }.\n$$\n\n**Step 2**: Find the slope of the tangent at $P:$\n\nThe slope of the tangent line is\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{\\theta =3\\pi /4} \\\\  & =\\frac{(3\\operatorname{sin}⁡(\\frac{9\\pi }{4})-\\operatorname{sin}⁡(\\frac{3\\pi }{4}))}{(3\\operatorname{cos}⁡(\\frac{9\\pi }{4})+\\operatorname{cos}⁡(\\frac{3\\pi }{4}))} \\\\  & =\\frac{(\\frac{3\\sqrt{2}}{2}-\\frac{\\sqrt{2}}{2})}{(\\frac{3\\sqrt{2}}{2}+(-\\frac{\\sqrt{2}}{2}))} \\\\  & =\\frac{(\\frac{2\\sqrt{2}}{2})}{(\\frac{2\\sqrt{2}}{2})} \\\\  & =1.\\end{aligned}\n$$\n\n**Step 3**: Find the Cartesian coordinates of $P:$\n\nWe compute the $xy$-coordinates of $P$ as follows:\n\n$$\n\\begin{aligned}{x}_{1} & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡(2\\theta )\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡(\\frac{3\\pi }{2})\\operatorname{cos}⁡(\\frac{3\\pi }{4}) \\\\  & =(-1)\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{\\sqrt{2}}{2} \\\\ {y}_{1} & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡(2\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡(\\frac{3\\pi }{2})\\operatorname{sin}⁡(\\frac{3\\pi }{4}) \\\\  & =(-1)\\cdot (\\frac{\\sqrt{2}}{2}) \\\\  & =-\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(\\frac{\\sqrt{2}}{2},-\\frac{\\sqrt{2}}{2}).$\n\n**Step 4**: Using point-slope form, find the equation of the normal:\n\nWe find the equation of the normal as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =-\\frac{1}{m}(x-{x}_{1}) \\\\ y-(-\\frac{\\sqrt{2}}{2}) & =-1\\cdot (x-\\frac{\\sqrt{2}}{2}) \\\\ y+\\frac{\\sqrt{2}}{2} & =-x+\\frac{\\sqrt{2}}{2} \\\\ y & =-x\\end{aligned}\n$$\n\n![](images/31/3185d528869c760d55d5f01aebae58ef41c6c325c7a3cb56d67c401ecfb80b2b.png)"} {:db/id #edb/ref 17592186184453 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48d7c891-85d3-5f18-98e4-2c7a4c8db324" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186251161} {:answer/id #uuid "9eeb417b-418b-5dc9-baa8-c6446ee30e09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186251924} {:answer/id #uuid "b8a76c3f-b1bb-51e7-92c8-cf13cf7d4c6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186252177} {:answer/id #uuid "cf09de8d-51aa-5ea3-bc9a-c5def2f65da6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186252382} {:answer/id #uuid "eacca78c-6a14-5ec3-97c0-98ba3650b2f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186252608}] :answer-field/correct {:answer/id #uuid "b8a76c3f-b1bb-51e7-92c8-cf13cf7d4c6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186252177} :answer-field/id #uuid "f3fd2f76-ecce-5fba-aee2-6f5e6dff1202" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253234}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ba92bee5-a4eb-55dd-b31e-91c198d4e5df" :question/math-academy-id "q-119179" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\operatorname{sin}⁡u=-\\frac{\\sqrt{5}}{4},\\,\\operatorname{cos}⁡u=\\frac{\\sqrt{11}}{4},\\,\\operatorname{cos}⁡v=-\\frac{5}{6}.\n$$\n\nGiven that $v$ lies in the second quadrant, and\n\n$$\n\\operatorname{sin}⁡(u-v)=\\frac{a\\sqrt{5}-b}{24},\n$$\n\ncalculate the value of $a+b.$" :question/worked-solution "First, recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nWe know the values of $\\operatorname{sin}⁡u$, $\\operatorname{cos}⁡u$, and $\\operatorname{cos}⁡v.$ To find the missing value of $\\operatorname{sin}⁡v$, we can use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡v+{cos}^{2}⁡v=1\\,⟹\\,{sin}^{2}⁡v=1-{cos}^{2}⁡v\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{sin}^{2}⁡v & =1-{cos}^{2}⁡v \\\\  & =1-{(-\\frac{5}{6})}^{2} \\\\  & =1-{(\\frac{5}{6})}^{2} \\\\  & =1-\\frac{{5}^{2}}{{6}^{2}} \\\\  & =1-\\frac{25}{36} \\\\  & =\\frac{36}{36}-\\frac{25}{36} \\\\  & =\\frac{11}{36}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡v & =\\pm \\sqrt{\\frac{11}{36}} \\\\  & =\\pm \\frac{\\sqrt{11}}{6}.\\end{aligned}\n$$\n\nWe're given that $v$ lies in the second quadrant, where sine is positive. So, we disregard the negative value, and we have \n\n$$\n\\operatorname{sin}⁡v=\\frac{\\sqrt{11}}{6}.\n$$\n\nWe can now apply the difference formula, as follows:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(u-v) & =\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v \\\\  & =(-\\frac{\\sqrt{5}}{4})(-\\frac{5}{6})-(\\frac{\\sqrt{11}}{4})(\\frac{\\sqrt{11}}{6}) \\\\  & =\\frac{5\\sqrt{5}}{24}-\\frac{11}{24} \\\\  & =\\frac{5\\sqrt{5}-11}{24}\\end{aligned}\n$$\n\nFinally, $a=5,b=11,$ and $a+b=16.$"} {:db/id #edb/ref 17592186184473 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd6324d6-7c7a-53ba-a58e-596789b1e25b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a = 5$ and $b = \\frac{2π}{5}$" :db/id #edb/ref 17592186181016} {:answer/id #uuid "fea9005c-e522-52ed-946d-8eb2f6d697a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a = 15$ and $b = \\frac{2π}{5}$" :db/id #edb/ref 17592186181017} {:answer/id #uuid "29ee32df-241d-5dd0-a181-94151c031127" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a = 5$ and $b = \\frac{π}{5}$" :db/id #edb/ref 17592186181018} {:answer/id #uuid "4708e0ef-bfff-552f-871f-1e6f522cbdfc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a = 3$ and $b = \\frac{2π}{5}$" :db/id #edb/ref 17592186181019} {:answer/id #uuid "6aeee295-21bb-572a-8d30-634ce8c00de8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a = 3$ and $b = \\frac{π}{5}$" :db/id #edb/ref 17592186181020}] :answer-field/id #uuid "5e79d94e-c408-55eb-8840-1f9cb64fcf0f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186181015}] :question/id #uuid "73b72aa0-ad67-598c-998a-215c706bd4b6" :question/math-academy-id "q-138407" :question/problem "The complex $5$th roots of the number $z = \\cos (\\frac{5π}{3}) + \\textrm{i}\\sin (\\frac{5π}{3})$ are given by\n\n$z_{k}^{1/5} = \\cos (\\frac{π}{a} + b \\cdot k) + \\textrm{i}\\sin (\\frac{π}{a} + b \\cdot k)$,\n\nwhere $k = 0, 1, 2, 3, 4$. What are the values of $a$ and $b$?"} {:db/id #edb/ref 17592186184474 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8bb26b7a-10e6-51e2-83e2-8cfe64a14753" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a = 3$, $b = 6$, and $c = π$" :db/id #edb/ref 17592186181022} {:answer/id #uuid "ce34428a-01ce-577e-a608-14a6ec31548c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a = 3$, $b = 3$, and $c = \\frac{π}{2}$" :db/id #edb/ref 17592186181023} {:answer/id #uuid "f980f955-67a7-56ef-baf7-82aef49577b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a = 3$, $b = 6$, and $c = \\frac{π}{2}$" :db/id #edb/ref 17592186181024} {:answer/id #uuid "130174c5-a9d5-5d26-9fb6-e0409a4b8a13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a = 9$, $b = 6$, and $c = \\frac{π}{4}$" :db/id #edb/ref 17592186181025} {:answer/id #uuid "72c89646-756f-5164-83a4-8941fd318bf5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a = 9$, $b = 3$, and $c = \\frac{π}{4}$" :db/id #edb/ref 17592186181026}] :answer-field/id #uuid "ec42b012-9bf0-5719-b03d-976ad3ce8760" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186181021}] :question/id #uuid "c0849207-55bc-5fea-b968-5ba9945591a8" :question/math-academy-id "q-138447" :question/problem "The complex $4$th roots of the number $z = 81[\\cos (\\frac{2π}{3}) + \\textrm{i}\\sin (\\frac{2π}{3})]$ are given by\n\n$z_{k}^{1/4} = a[\\cos (\\frac{π}{b} + c \\cdot k) + \\textrm{i}\\sin (\\frac{π}{b} + c \\cdot k)]$,\n\nwhere $k = 0, 1, 2, 3$. What are the values of $a$, $b$, and $c$?"} {:db/id #edb/ref 17592186184478 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e115dce-6c4a-5990-acf3-bf492c96d488" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x + \\frac{5}{2})^{2} + 3" :db/id #edb/ref 17592186181046} {:answer/id #uuid "a70edb35-cbf2-5e18-b8aa-351303b13799" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x + 5)^{2} + 3" :db/id #edb/ref 17592186181047} {:answer/id #uuid "cc6b90df-1c57-524a-8734-19d8517fefc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x - 5)^{2} + 3" :db/id #edb/ref 17592186181048} {:answer/id #uuid "f1b669fc-c53e-5ece-bb04-bb4167ea84d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x - \\frac{5}{4})^{2} + 3" :db/id #edb/ref 17592186181049} {:answer/id #uuid "56ee1c11-8464-5689-b873-51dcd5a5583d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x - \\frac{5}{2})^{2} + 3" :db/id #edb/ref 17592186181050}] :answer-field/id #uuid "eb8c466d-4935-54e2-a0c5-07904d3f71b9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186181045}] :question/id #uuid "7fde105f-56e2-5383-a76a-5a8fb4028ec0" :question/math-academy-id "q-140191" :question/problem "Rewrite the expression\n$(x^{2} + 5x + (\\frac{5}{2})^{2}) + 3$\nas the sum of a perfect square and a constant."} {:db/id #edb/ref 17592186184483 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0710913b-7399-5b9e-a5a9-f4627344dd74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}-{(y-\\frac{5}{2})}^{2}" :db/id #edb/ref 17592186565688} {:answer/id #uuid "0d6b0b59-5f4d-58eb-aec7-42d212af1618" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}-{(y-\\frac{5}{2})}^{2}" :db/id #edb/ref 17592186565700} {:answer/id #uuid "6969fc79-b38b-551a-bfdf-07495efdaf43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{4}-{(y-\\frac{5}{2})}^{2}" :db/id #edb/ref 17592186565842} {:answer/id #uuid "91d492cf-1c56-56df-bd04-4aabaf69aec4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "31-{(y+\\frac{5}{2})}^{2}" :db/id #edb/ref 17592186565914} {:answer/id #uuid "fc78b4ea-4ddc-5ed1-8637-95f6e755fa4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{49}{4}-{(y+\\frac{5}{2})}^{2}" :db/id #edb/ref 17592186566095}] :answer-field/correct {:answer/id #uuid "0d6b0b59-5f4d-58eb-aec7-42d212af1618" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}-{(y-\\frac{5}{2})}^{2}" :db/id #edb/ref 17592186565700} :answer-field/id #uuid "322303e8-364d-5afe-acc4-d76d39051ab7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186181075}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8f29e3f2-9a97-5ae1-80ba-f81c4f7c0fb6" :question/math-academy-id "q-140331" :question/problem "Rewrite $-({y}^{2}-5y+6)$ by completing the square." :question/worked-solution "We begin by completing the square for the expression inside the parentheses:\n\n$$\n{y}^{2}-5y+6\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}-2\\cdot \\frac{5}{2}y+6\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{5}{2})}^{2}$, writing the constant term $6$ last:\n\n$$\n\\underbrace{{y}^{2}-2\\cdot \\frac{5}{2}y+{(\\frac{5}{2})}^{2}}-{(\\frac{5}{2})}^{2}+6\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(y-\\frac{5}{2})}^{2}-{(\\frac{5}{2})}^{2}+6\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(y-\\frac{5}{2})}^{2}-\\frac{1}{4}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-({y}^{2}-5y+6) & =-({(y-\\frac{5}{2})}^{2}-\\frac{1}{4}) \\\\  & =-{(y-\\frac{5}{2})}^{2}+\\frac{1}{4} \\\\  & =\\frac{1}{4}-{(y-\\frac{5}{2})}^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184484 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2441e55c-3656-5b9c-9444-a562a3ff3b87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z-\\frac{1}{3})}^{2}+10" :db/id #edb/ref 17592186269586} {:answer/id #uuid "4f3faa2d-7189-540c-8002-572e91da81bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z+\\frac{1}{3})}^{2}+5" :db/id #edb/ref 17592186269984} {:answer/id #uuid "82317f98-eb55-5a2a-84b7-c0fc441aa39a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z-\\frac{1}{3})}^{2}-8" :db/id #edb/ref 17592186270394} {:answer/id #uuid "ca440db9-063c-5ec8-89e2-7e47d8b1e800" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z+\\frac{1}{3})}^{2}+10" :db/id #edb/ref 17592186271044} {:answer/id #uuid "f37d3db7-779c-579c-a14f-a3675bd5b658" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z+\\frac{1}{3})}^{2}+8" :db/id #edb/ref 17592186271404}] :answer-field/correct {:answer/id #uuid "ca440db9-063c-5ec8-89e2-7e47d8b1e800" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z+\\frac{1}{3})}^{2}+10" :db/id #edb/ref 17592186271044} :answer-field/id #uuid "02be3ebb-ff12-5196-b096-96eac16ef254" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271509}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2495fc0b-8e76-56e1-bf72-c223c52c4fc2" :question/math-academy-id "q-140378" :question/problem "Rewrite $-9{z}^{2}-6z+9$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $-9$. So, we take out a factor of $-9$ from the entire expression:\n\n$$\n-9({z}^{2}+\\frac{2}{3}z-1)\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{z}^{2}+\\frac{2}{3}z-1\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{z}^{2}+2\\cdot \\frac{1}{3}\\cdot z-1\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{1}{3})}^{2}$, writing the constant term $1$ last:\n\n$$\n\\underbrace{{z}^{2}+2\\cdot \\frac{1}{3}\\cdot z+{(\\frac{1}{3})}^{2}}-{(\\frac{1}{3})}^{2}-1\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(z+\\frac{1}{3})}^{2}-{(\\frac{1}{3})}^{2}-1\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(z+\\frac{1}{3})}^{2}-\\frac{10}{9}.\n$$\n\nFinally, we substitute this result back into our original expression::\n\n$$\n\\begin{aligned}-9({z}^{2}+\\frac{2}{3}z-1) & =-9({(z+\\frac{1}{3})}^{2}-\\frac{10}{9}) \\\\  & =-9{(z+\\frac{1}{3})}^{2}+(-9)\\cdot (-\\frac{10}{9}) \\\\  & =-9{(z+\\frac{1}{3})}^{2}+10\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184485 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "057bf8b9-f4be-51c0-a4d1-d57b29da8233" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{4}-{(x+\\frac{1}{2})}^{2}" :db/id #edb/ref 17592186565683} {:answer/id #uuid "61f2ea1d-2d8b-55fa-8520-17155db3eebf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-{(x+2)}^{2}" :db/id #edb/ref 17592186565832} {:answer/id #uuid "ddfed3f5-06e5-5e82-b0a9-731fa897dd17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{4}-{(x-\\frac{1}{2})}^{2}" :db/id #edb/ref 17592186566038} {:answer/id #uuid "e4f36cd8-e603-55a8-9ec8-ae98cefb08df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}-{(x+\\frac{1}{2})}^{2}" :db/id #edb/ref 17592186566051} {:answer/id #uuid "ff8880bf-ffee-5976-8095-806532a97526" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{4}-{(x+\\frac{1}{2})}^{2}" :db/id #edb/ref 17592186566098}] :answer-field/correct {:answer/id #uuid "ff8880bf-ffee-5976-8095-806532a97526" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{4}-{(x+\\frac{1}{2})}^{2}" :db/id #edb/ref 17592186566098} :answer-field/id #uuid "8091fb4f-3520-5238-a1fe-8deaeb6d643a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186181087}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "67f49a8a-532a-55d5-814b-4932396dbbeb" :question/math-academy-id "q-140406" :question/problem "Rewrite $-{x}^{2}-x-3$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $-1$. So, we take out a factor of $-1$ from the entire expression:\n\n$$\n-({x}^{2}+x+3)\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{x}^{2}+x+3\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}+2\\cdot \\frac{1}{2}x+3\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{1}{2})}^{2}$, writing the constant term $3$ last:\n\n$$\n\\underbrace{{x}^{2}+2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2}}-{(\\frac{1}{2})}^{2}+3\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(x+\\frac{1}{2})}^{2}-{(\\frac{1}{2})}^{2}+3\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(x+\\frac{1}{2})}^{2}+\\frac{11}{4}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-{x}^{2}-x-3 & =-({(x+\\frac{1}{2})}^{2}+\\frac{11}{4}) \\\\  & =-{(x+\\frac{1}{2})}^{2}-\\frac{11}{4} \\\\  & =-\\frac{11}{4}-{(x+\\frac{1}{2})}^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184494 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81a2cf1f-1cab-5103-be39-d1bd169865af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0 < x \\le 9" :db/id #edb/ref 17592186181141} {:answer/id #uuid "d11e633c-7deb-5147-9e62-26c73903c2e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x \\ge 9" :db/id #edb/ref 17592186181142} {:answer/id #uuid "0f2664a2-b231-56ea-a8dd-56e9b3e7845c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0 < x \\le 3" :db/id #edb/ref 17592186181143} {:answer/id #uuid "4e93622b-ebbb-5f9d-bbd9-4b3e83750659" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0 < x \\le \\sqrt{3}" :db/id #edb/ref 17592186181144} {:answer/id #uuid "70568d43-679b-5e34-9373-57aa2d9c4a2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x \\ge 3" :db/id #edb/ref 17592186181145}] :answer-field/id #uuid "2f71c126-f7c4-5751-9dc7-130d9c2ea723" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186181140}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c7053d3e-ecd7-597a-9cf1-c9a8c9478d23" :question/math-academy-id "q-141267" :question/problem "Consider the sequence $a_{n} = x(\\frac{x^{2}}{9})^{n}$, where $x$ is a positive real number and $n \\ge 1$. What are the values of $x$ for which the sequence converges?"} {:db/id #edb/ref 17592186184519 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fc0c999-23cd-5524-9da6-e53b356c1021" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186272667} {:answer/id #uuid "28e4e68f-7f86-51a5-acb6-ca743aa3d7c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186272750} {:answer/id #uuid "4cb994cd-8c47-576d-91a9-e34b5cda5702" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186273033} {:answer/id #uuid "a194c1c2-e3d5-500f-96cb-962402383114" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186273787} {:answer/id #uuid "fd3ef270-06b0-55fe-8c9c-3c5aa9cc96ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186274613}] :answer-field/correct {:answer/id #uuid "1fc0c999-23cd-5524-9da6-e53b356c1021" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186272667} :answer-field/id #uuid "33fc6641-fd7f-5c11-8ef6-f22d02c82fa3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274725}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "53588a2b-ad7c-5261-a3ca-c56ccdc03a42" :question/math-academy-id "q-149958" :question/problem "${lim}_{x\\to \\,-1/2}\\operatorname{tan}⁡(\\frac{1}{2}\\operatorname{arccos}⁡(x))=$" :question/worked-solution "![](images/9d/9dcc5a116c2a564547283783a7df7b1cd3a9ab3b76ac24dc2695c4cb367796d5.png)\n\nThe domain of $\\operatorname{arccos}⁡(x)$ is $x\\in [-1,1].$  \n\nNow, substituting $x=-\\frac{1}{2}$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,-1/2}\\operatorname{tan}⁡(\\frac{1}{2}\\operatorname{arccos}⁡(x)) & =\\operatorname{tan}⁡(\\frac{1}{2}\\operatorname{arccos}⁡(-\\frac{1}{2})) \\\\  & =\\operatorname{tan}⁡(\\frac{1}{2}\\cdot \\frac{2\\pi }{3}) \\\\  & =\\operatorname{tan}⁡(\\frac{\\pi }{3}) \\\\  & =\\sqrt{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184526 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c976821f-7963-5d8a-a26e-a2eb8811a5d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a = 3$ and $b = \\frac{π}{4}$" :db/id #edb/ref 17592186181333} {:answer/id #uuid "e5bcc9a9-e02d-5439-a772-eae44f0224a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a = 12$ and $b = π$" :db/id #edb/ref 17592186181334} {:answer/id #uuid "111116ea-fd6c-5428-863c-d679752773da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a = 12$ and $b = \\frac{π}{2}$" :db/id #edb/ref 17592186181335} {:answer/id #