92186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{(s-4)^{3}}" :db/id #edb/ref 17592186313718}] :answer-field/correct {:answer/id #uuid "10a2fcf9-6565-509c-bb83-ffdb9ae55c3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{(s-4)^{3}}" :db/id #edb/ref 17592186312093} :answer-field/id #uuid "4b52e14e-387a-5e7e-a8ad-de32a1a9ab96" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314224}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f3fd3086-f746-5979-a170-4c67285d4998" :question/math-academy-id "q-340844" :question/problem "Suppose we wish to calculate the Laplace transform $L{{t}^{2}{e}^{4t}}$ using the smoothness property. Select the correct options in the reasoning below.Let $f(t)={e}^{4t}$ and $F(s)=L{f(t)}.$ By the smoothness property of Laplace transforms, we have\n\n$$\nL{{t}^{2}f(t)}={{field-1}}.\n$$\n\nWe have that\n\n$$\n{F}^{″}(s)={{field-2}}.\n$$\n\nTherefore,\n\n$$\nL{{t}^{2}{e}^{4t}}={{field-3}},\\,s>4.\n$$" :question/worked-solution "If a function $f(t)$ is piecewise continuous on $[0,\\infty )$ and has exponential order $a,$ then its Laplace transform\n\n$$\nF(s)=L{f(t)}\n$$\n\nexists for every real $s>a,$ and $F$ is infinitely differentiable in this region of convergence. Moreover, for each integer $n\\ge 0$ and every such $s,$ we have\n\n$$\nL{{t}^{n}f(t)}=(-1)^{n}{F}^{(n)}(s).\n$$\n\nIn particular, for $n=2,$ we have\n\n$$\nL{{t}^{2}f(t)}={F}^{″}(s).\n$$\n\nWe have that $f(t)={e}^{4t}.$ Therefore, for $s>4,$ we have\n\n$$\nF(s)=\\frac{1}{s-4}.\n$$\n\nDifferentiating with respect to $s,$ we have\n\n$$\n\\begin{aligned}{F}^{′}(s) & =\\frac{\\text{d}}{\\text{d}s}(\\frac{1}{s-4}) \\\\  & =\\frac{\\text{d}}{\\text{d}s}((s-4)^{-1}) \\\\  & =-(s-4)^{-2} \\\\ {F}^{″}(s) & =\\frac{\\text{d}}{\\text{d}s}(-(s-4)^{-2}) \\\\  & =2(s-4)^{-3} \\\\  & =\\frac{2}{(s-4)^{3}}.\\end{aligned}\n$$\n\nTherefore, by the smoothness property,\n\n$$\n\\begin{aligned}L{{t}^{2}{e}^{4t}}={F}^{″}(s)=\\frac{2}{(s-4)^{3}},\\,s>4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186222021 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "658bdf84-4d9f-5b61-bc88-16da368f3e7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{F}^{″}(s)" :db/id #edb/ref 17592186312776} {:answer/id #uuid "69634cf7-0de5-53e9-8247-f7cfdae827c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{s}^{2}{F}^{′}(s)" :db/id #edb/ref 17592186312802} {:answer/id #uuid "6f976f94-792e-50cb-b7a8-483061b24e0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{s}^{2}{F}^{″}(s)" :db/id #edb/ref 17592186312853} {:answer/id #uuid "75f51f18-7118-5054-a82e-696161b48f9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{s}^{2}{F}^{″}(s)" :db/id #edb/ref 17592186312916} {:answer/id #uuid "ce6d96c9-a50b-5b1c-9fe3-7cc9c499ce5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{F}^{″}(s)" :db/id #edb/ref 17592186313586}] :answer-field/correct {:answer/id #uuid "658bdf84-4d9f-5b61-bc88-16da368f3e7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{F}^{″}(s)" :db/id #edb/ref 17592186312776} :answer-field/id #uuid "0add6fbb-4f9a-5172-b6c4-bc9d20890331" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314043} {:answer-field/choices [{:answer/id #uuid "1643357a-506e-5213-861a-b8a1be4507a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{24{s}^{2}-128}{({s}^{2}+16)^{3}}" :db/id #edb/ref 17592186312128} {:answer/id #uuid "4555ec7a-006b-51e0-a19a-26d8e923183a" :answer/type {:db/id #edb/ref 175