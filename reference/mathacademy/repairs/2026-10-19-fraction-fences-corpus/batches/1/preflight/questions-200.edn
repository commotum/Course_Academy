id "1bdba1a4-572b-5ff5-98ad-ba8d4cb42573" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186330196} {:answer/id #uuid "272adadc-dc60-5df6-b12a-607b5737505f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{2}" :db/id #edb/ref 17592186330296} {:answer/id #uuid "9907c739-9ee7-5ae0-a552-1008c61ffa45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The integral diverges" :db/id #edb/ref 17592186331317} {:answer/id #uuid "ab81ca8d-9891-5577-a8bc-ca291c0278e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186331470}] :answer-field/correct {:answer/id #uuid "ab81ca8d-9891-5577-a8bc-ca291c0278e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186331470} :answer-field/id #uuid "f19ed891-559a-5317-88f9-73b293b6effe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332627}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f451acc7-5bcc-5cdc-a9bd-08b863789689" :question/math-academy-id "q-6037" :question/problem "Evaluate the integral ${\\int }_{0}^{\\infty }\\frac{2}{{z}^{2}+9}\\,\\text{d}z.$" :question/worked-solution "First, let's recall the following result:\n\n$$\n\\int \\frac{1}{{k}^{2}+{x}^{2}}\\,\\text{d}x=\\frac{1}{k}\\operatorname{arctan}⁡(\\frac{x}{k})+C\n$$\n\nWe proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{2}{{z}^{2}+9}\\,\\text{d}z & =2\\cdot {lim}_{a\\to \\infty }{\\int }_{0}^{a}\\frac{1}{{z}^{2}+9}\\,\\text{d}z \\\\  & =2\\cdot {lim}_{a\\to \\infty }{\\int }_{0}^{a}\\frac{1}{{z}^{2}+{3}^{2}}\\,\\text{d}z \\\\  & =2\\cdot {lim}_{a\\to \\infty }{[\\frac{1}{3}\\operatorname{arctan}⁡(\\frac{z}{3})]}_{0}^{a} \\\\  & =\\frac{2}{3}\\cdot {lim}_{a\\to \\infty }(\\operatorname{arctan}⁡(\\frac{a}{3})-\\operatorname{arctan}⁡0) \\\\  & =\\frac{2}{3}\\cdot {lim}_{a\\to \\infty }[\\operatorname{arctan}⁡(\\frac{a}{3})]\\end{aligned}\n$$\n\nNow, recall the end behavior of the function $y=\\operatorname{arctan}⁡(\\frac{x}{3}),$ shown in the graph below:\n\n- ${lim}_{x\\to -\\infty }[\\operatorname{arctan}⁡(\\frac{x}{3})]=-\\frac{\\pi }{2}$\n\n- ${lim}_{x\\to \\infty }[\\operatorname{arctan}⁡(\\frac{x}{3})]=\\frac{\\pi }{2}$\n\n![](images/24/2465f099a94aa966dbf33eb89aa00973e692fa97c887a9b79baff8260f5d31cd.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{2}{{z}^{2}+9}\\,\\text{d}z & =\\frac{2}{3}\\cdot {lim}_{a\\to \\infty }[\\operatorname{arctan}⁡(\\frac{a}{3})] \\\\  & =\\frac{2}{3}\\cdot \\frac{\\pi }{2} \\\\  & =\\frac{\\pi }{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186193372 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5987358-dd71-5e7d-9fee-ca36d6adb75f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\tan (\\frac{π}{3})" :db/id #edb/ref 17592186192160} {:answer/id #uuid "ec26f385-0d96-5acc-9cdc-ba256d1b0b39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\tan (\\frac{π}{4})" :db/id #edb/ref 17592186192161} {:answer/id #uuid "4d191606-0d9a-55bf-9510-b7d2344c06a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\tan (\\frac{π}{6})" :db/id #edb/ref 17592186192162} {:answer/id #uuid "783b2c11-7204-5ec7-b4d0-801806440c73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\tan (\\frac{π}{3})" :db/id #edb/ref 17592186192163} {:answer/id #uuid "7dbbfa36-88fa-