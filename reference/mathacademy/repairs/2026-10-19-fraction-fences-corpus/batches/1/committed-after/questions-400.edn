b-9492-557a-ad44-08522dcba0d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "continuous" :db/id #edb/ref 17592186447595} :answer-field/id #uuid "ef7b60fb-4d25-5d6e-aabc-ba323132e09c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186447625} {:answer-field/choices [{:answer/id #uuid "049f5769-5fd9-5a84-b0cd-5f4a4a5f43f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14(-1)^{n}}{n}" :db/id #edb/ref 17592186447483} {:answer/id #uuid "6552293c-ef9b-5d65-a476-a37433b05e66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14(-1)^{n+1}}{n}" :db/id #edb/ref 17592186447532} {:answer/id #uuid "86e73d39-0624-56f2-a8d1-76729f74462b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14(-1)^{n}}{{n}^{2}}" :db/id #edb/ref 17592186447550} {:answer/id #uuid "99e364a6-757e-5bd5-8586-8ffbdfd41393" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14(-1)^{n+1}}{{n}^{2}}" :db/id #edb/ref 17592186447561}] :answer-field/correct {:answer/id #uuid "6552293c-ef9b-5d65-a476-a37433b05e66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14(-1)^{n+1}}{n}" :db/id #edb/ref 17592186447532} :answer-field/id #uuid "f55713f6-e85d-551a-86cb-466027170f89" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186447626}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b5d5810a-d922-539c-8f81-743a41d8a84a" :question/math-academy-id "q-343315" :question/problem "Let $f(x)$ be the $2\\pi $-periodic extension of the function $F(x)=\\frac{7}{2}{x}^{2}+3$ defined on $[-\\pi ,\\pi ).$ Select the correct options in the reasoning below, showing the derivation of the Fourier series of the $2\\pi $-periodic extension of $G(x)=7x$ from the corresponding Fourier series of $f(x).$\n\nThe Fourier series of $f(x)$ is given by\n\n$$\n\\frac{7}{2}{x}^{2}+3∼3+\\frac{7{\\pi }^{2}}{6}+{\\sum }_{n=1}^{\\infty }\\frac{14(-1)^{n}}{{n}^{2}}{{field-1}}.\n$$\n\nSince $f$ is \n{{field-2}}\nand\n{{field-3}}\non $R,$ we may differentiate its Fourier series term-by-term to get\n\n$$\n7x∼{\\sum }_{n=1}^{\\infty }{{field-4}}\\cdot {{field-5}}.\n$$" :question/worked-solution "First, notice that $F(x)$ is an even function. So, the Fourier series of its $2L$-periodic extension has the form\n\n$$\n\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡\\left(\\frac{n\\pi x}{L}\\right).\n$$\n\nIn our case, $L=\\pi $ and we are already given the coefficients ${a}_{0}$ and ${a}_{n}$ for $n\\ge 1.$ Thus, the Fourier series of $f(x)$ is given by\n\n$$\nf(x)∼3+\\frac{7{\\pi }^{2}}{6}+{\\sum }_{n=1}^{\\infty }\\frac{14(-1)^{n}}{{n}^{2}}\\operatorname{cos}⁡(nx).\n$$\n\nNow, notice that \n\n- the function $F$ is continuously differentiable on $(-\\pi ,\\pi ),$\n\n- continuous on $[-\\pi ,\\pi ),$ and\n\n- satisfies $F(-\\pi )=F(\\pi ),$ if we extend the value at $x=\\pi $ using the formula $F(x)=\\frac{7}{2}{x}^{2}+3.$\n\nTherefore, the $2\\pi $-periodic extension $f$ is $\\text{continuous}$ and $\\text{piecewise smooth}$ on $R,$ so we may differentiate its Fourier series term-by-term:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{7}{2}{x}^{2}+3) & ∼\\frac{\\text{d}}{\\text{d}x}(3+\\frac{7{\\pi }^{2}}{6})+{\\sum }_{n=1}^{\\infty }\\frac{\\text{d}}{\\text{d}x}(\\frac{14(-1)^{n}}{{n}^{2}}\\operatorname{cos}⁡(nx)) \\\\ 7x & ∼0+{\\sum }_{n=1}^{\\infty }\\frac{14(-1)^{n}}{{n}^{2}}\\cdot (-n\\operatorname{sin}⁡(nx)) \\\\ 7x & ∼{\\sum }_{n=1}^{\\infty }\\frac{-14(-1)^{n}}{n}\\operatorname{sin}⁡(nx) \\\\ 7x & ∼{\\sum }_{n=1}^{\\infty }\\,\\frac{14(-1)^{n+1}}{n}\\cdot \\operatorname{sin}⁡(nx)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186222037 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eac6c01-7323-5cfa-8a28-9ee89e883eb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(-1)^{n}}{n{\\pi }^{2}(4+n\\pi )}" :db/id #edb/ref 17592186315206} {:answer/id #uuid "182aace0-6eea-5683-b022-6752de8edb23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9(-1)^{n}}{{n}^{2}{\\pi }^{2}(16-{n}^{2})}" :db/id #edb/ref 17592186315259} {:answer/id #uuid "5bf9ea5e-bf43-5329-942f-18c9414f5dd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3(-1)^{n}}{16+{n}^{2}{\\pi }^{2}}" :db/id #edb/ref 17592186315643} {:answer/id #uuid "979d240d-8a78-5e5e-98eb-afae4adb2c29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9(-1)^{n}}{{n}^{2}\\pi (144-{n}^{2}{\\pi }^{2})}" :db/id #edb/ref 17592186315963}] :answer-field/correct {:answer/id #uuid "979d240d-8a78-5e5e-98eb-afae4adb2c29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9(-1)^{n}}{{n}^{2}\\pi (144-{n}^{2}{\\pi }^{2})}" :db/id #edb/ref 17592186315963} :answer-field/id #uuid "0aa9decd-5701-5de4-9020-d2ec143f0d30" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316576}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d2c6150b-3687-5b67-8114-c6babfa1ec19" :question/math-academy-id "q-343373" :question/problem "Select the missing parts in a particular solution of the differential equation ${y}^{″}+16y=f(x),$ where the Fourier series of the $6$-periodic forcing function is given by\n\n$$\nf(x)∼{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{2}\\pi }\\operatorname{sin}⁡\\left(\\frac{n\\pi x}{3}\\right).\n$$\n\n*Hint: You may assume that the free term and all the cosine coefficients in the Fourier series of the particular solution are equal to zero.*\n\nThe Fourier series of a particular solution is\n\n$$\n{y}_{p}∼{\\sum }_{n=1}^{\\infty }\\,{{field-1}}\\cdot \\operatorname{sin}⁡\\left(\\frac{n\\pi x}{3}\\right)\n$$" :question/worked-solution "We assume that a solution of our equation has the following Fourier series:\n\n$$\n{y}_{p}∼{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡\\left(\\frac{n\\pi x}{3}\\right).\n$$\n\nNow, we compute the derivatives:\n\n$$\n\\begin{aligned}{y}_{p}^{′} & ∼\\frac{\\text{d}}{\\text{d}x}({\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡\\left(\\frac{n\\pi x}{3}\\right))∼{\\sum }_{n=1}^{\\infty }\\frac{{b}_{n}n\\pi }{3}\\operatorname{cos}⁡\\left(\\frac{n\\pi x}{3}\\right) \\\\ {y}_{p}^{″} & ∼\\frac{\\text{d}}{\\text{d}x}({\\sum }_{n=1}^{\\infty }\\frac{{b}_{n}n\\pi }{3}\\operatorname{cos}⁡\\left(\\frac{n\\pi x}{3}\\right))∼{\\sum }_{n=1}^{\\infty }-\\frac{{b}_{n}{n}^{2}{\\pi }^{2}}{9}\\operatorname{sin}⁡\\left(\\frac{n\\pi x}{3}\\right)\\end{aligned}\n$$\n\nNext, we substitute the expressions for ${y}_{p}^{″}$ and ${y}_{p}$ into the equation:\n\n$$\n{\\sum }_{n=1}^{\\infty }-\\frac{{b}_{n}{n}^{2}{\\pi }^{2}}{9}\\operatorname{sin}⁡\\left(\\frac{n\\pi x}{3}\\right)+16({\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡\\left(\\frac{n\\pi x}{3}\\right))={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{2}\\pi }\\operatorname{sin}⁡\\left(\\frac{n\\pi x}{3}\\right).\n$$\n\nRearranging the terms to find a common denominator:\n\n$$\n{\\sum }_{n=1}^{\\infty }{b}_{n}(16-\\frac{{n}^{2}{\\pi }^{2}}{9})\\operatorname{sin}⁡\\left(\\frac{n\\pi x}{3}\\right)={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{2}\\pi }\\operatorname{sin}⁡\\left(\\frac{n\\pi x}{3}\\right)\n$$\n\n$$\n{\\sum }_{n=1}^{\\infty }{b}_{n}\\left(\\frac{144-{n}^{2}{\\pi }^{2}}{9}\\right)\\operatorname{sin}⁡\\left(\\frac{n\\pi x}{3}\\right)={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{2}\\pi }\\operatorname{sin}⁡\\left(\\frac{n\\pi x}{3}\\right).\n$$\n\nNow, equating the sine coefficients:\n\n$$\n\\frac{{b}_{n}(144-{n}^{2}{\\pi }^{2})}{9}=\\frac{(-1)^{n}}{{n}^{2}\\pi }\\,⇒\\,{b}_{n}=\\frac{9(-1)^{n}}{{n}^{2}\\pi (144-{n}^{2}{\\pi }^{2})}.\n$$\n\nTherefore, our particular solution is\n\n$$\n{y}_{p}∼{\\sum }_{n=1}^{\\infty }\\,\\frac{9(-1)^{n}}{{n}^{2}\\pi (144-{n}^{2}{\\pi }^{2})}\\cdot \\operatorname{sin}⁡\\left(\\frac{n\\pi x}{3}\\right).\n$$"} {:db/id #edb/ref 17592186222038 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4817ea5-c1f7-547f-9917-fdd4c1930e4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\left(\\frac{n\\pi x}{2}\\right)" :db/id #edb/ref 17592186316139} {:answer/id #uuid "e2de7b78-6248-5197-b0d0-d24b15c605ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\left(\\frac{n\\pi x}{2}\\right)" :db/id #edb/ref 17592186316376} {:answer/id #uuid "e39a3f48-7f97-55da-b06f-2dd831b7858b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1-\\operatorname{sin}⁡\\left(\\frac{n\\pi x}{2}\\right))" :db/id #edb/ref 17592186316378} {:answer/id #uuid "e8932200-fa03-5233-bf3d-aa0ad11900c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1-\\operatorname{cos}⁡\\left(\\frac{n\\pi x}{2}\\right))" :db/id #edb/ref 17592186316409}] :answer-field/correct {:answer/id #uuid "b4817ea5-c1f7-547f-9917-fdd4c1930e4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\left(\\frac{n\\pi x}{2}\\right)" :db/id #edb/ref 17592186316139} :answer-field/id #uuid "2f1681a0-d882-5d7f-aacd-ca07d25bedd3" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316659} {:answer-field/choices [{:answer/id #uuid "8a6d5