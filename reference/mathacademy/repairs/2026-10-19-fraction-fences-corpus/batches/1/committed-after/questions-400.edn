3 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186226333}] :question/id #uuid "35f7eb66-6d3f-52d4-9d9e-3320588c43aa" :question/math-academy-id "q-277407" :question/problem "Which expression is equivalent to $(\\left(\\frac{14}{x - 5}\\right))/(7x - 35)$, where $x \\ne 5$?"} {:db/id #edb/ref 17592186229532 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c50e73d7-7801-5b0a-b0be-d236fc4ec181" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(\\frac{3}{2}\\right)^{x^{2}}" :db/id #edb/ref 17592186227566} {:answer/id #uuid "c8ea8103-f7d8-5a42-90a1-1534b8078a6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(\\frac{3}{2}\\right)^{x/2}" :db/id #edb/ref 17592186227567} {:answer/id #uuid "f6aed431-0861-57ab-b91c-50c92bc80692" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(\\frac{3}{2}\\right)^{x + 2}" :db/id #edb/ref 17592186227568} {:answer/id #uuid "43e69552-0111-5fe8-ae50-54f05b1481b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(\\frac{3}{2}\\right)^{2x}" :db/id #edb/ref 17592186227569} {:answer/id #uuid "772149f0-3847-52ca-9556-e67da07d9f8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(\\frac{3}{2}\\right)^{x - 2}" :db/id #edb/ref 17592186227570}] :answer-field/id #uuid "114affe6-dddb-5dc5-b52a-6cf808afddde" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186227565}] :question/id #uuid "0d024037-35dd-54aa-ae9e-91d70b63b5cf" :question/math-academy-id "q-325206" :question/problem "Which of the following expressions is equivalent to $\\frac{9}{4}\\left(\\frac{3}{2}\\right)^{x}$?"} {:db/id #edb/ref 17592186229533 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd623ee0-2de0-553c-bac4-c63a9a48cb