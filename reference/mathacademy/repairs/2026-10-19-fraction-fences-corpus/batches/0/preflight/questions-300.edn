0edce064-be3a-5ac2-9b21-78d97cf50fb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=3\\sqrt{2}\\,{\\text{e}}^{\\pi \\text{i}/6}" :db/id #edb/ref 17592186336173} {:answer/id #uuid "2ca021e7-a322-541a-9d46-d6d3ccd3464d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\,{\\text{e}}^{5\\pi \\text{i}/6}" :db/id #edb/ref 17592186336456} {:answer/id #uuid "31cfa8cf-b461-585f-941c-c9672b5e5767" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{3}\\,{\\text{e}}^{\\pi \\text{i}/3}" :db/id #edb/ref 17592186336505} {:answer/id #uuid "7f94ec5f-7644-5c28-a01c-f94c5686aa26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=3\\,{\\text{e}}^{3\\pi \\text{i}/4}" :db/id #edb/ref 17592186337189} {:answer/id #uuid "c3c1f315-63f4-56cc-a5b7-e4d7e5a2e035" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\,{\\text{e}}^{2\\pi \\text{i}/3}" :db/id #edb/ref 17592186337769}] :answer-field/correct {:answer/id #uuid "c3c1f315-63f4-56cc-a5b7-e4d7e5a2e035" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\,{\\text{e}}^{2\\pi \\text{i}/3}" :db/id #edb/ref 17592186337769} :answer-field/id #uuid "ecf80001-5828-5e43-9337-da9b757b7e67" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338689}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "145945c1-66ab-5fe7-89d2-3b7864c48fb7" :question/math-academy-id "q-71978" :question/problem "![](images/c5/c5d36b72e7e2ff6754152a559d64bf3610708c9a2d3790c859bc9abacc9220b6.png)\n\nWrite the complex number $z$, shown on the Argand diagram above, in exponential form." :question/requires-calculator true :question/worked-solution "The complex number shown in the Argand diagram can be written as\n\n$$\n\\begin{aligned}z & =x+\\text{i}y \\\\  & =-1+\\sqrt{3}\\,\\text{i}.\\end{aligned}\n$$\n\nTo write it in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-1)^{2}+{(\\sqrt{3})}^{2}} \\\\  & =\\sqrt{4} \\\\  & =2\\end{aligned}\n$$\n\nNow, since $z$ lies in the second quadrant, we can find the angle $\\theta $ as\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\pi -|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =\\pi -|\\operatorname{arctan}⁡(-\\sqrt{3})| \\\\  & =\\pi -\\frac{\\pi }{3} \\\\  & =\\frac{2\\pi }{3}.\\end{aligned}\n$$\n\nFinally, substituting $r=2$ and $\\theta =\\frac{2\\pi }{3}$ into $z=r{e}^{\\text{i}\\theta },$ we get\n\n$$\nz=2\\,{\\text{e}}^{2\\pi \\text{i}/3}.\n$$"} {:db/id #edb/ref 17592186088288 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "011bbc61-c232-51d7-aa80-e2a14f1ec697" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\,{\\text{e}}^{5\\pi \\text{i}/6}" :db/id #edb/ref 17592186336041} {:answer/id #uuid "03c0b59f-389e-539b-8f40-ac6fd034671f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\,{\\text{e}}^{2\\pi \\text{i}/3}" :db/id #edb/ref 17592186336066} {:answer/id #uuid "3950ba21-5a48-5041-b9a1-577ecfe3e331" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{2}\\,{\\text{e}}^{5\\pi \\text{i}/6}" :db/id #edb/ref 17592186336571} {:answer/id #uuid "41d60a2b-519a-5b04-ac9f-2557863d9b8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{2}\\,{\\text{e}}^{2\\pi \\text{i}/3}" :db/id #edb/ref 17592186336651} {:answer/id #uuid "dde328b7-249e-5a6e-891a-1effb7de79b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{2}\\,{\\text{e}}^{3\\pi \\text{i}/4}" :db/id #edb/ref 17592186337962}] :answer-field/correct {:answer/id #uuid "dde328b7-249e-5a6e-891a-1effb7de79b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{2}\\,{\\text{e}}^{3\\pi \\text{i}/4}" :db/id #edb/ref 17592186337962} :answer-field/id #uuid "b45acc85-4fb5-566e-b3bd-6dbff8a0533d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338608}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8d71971a-ef79-5e9d-a922-8354775291f8" :question/math-academy-id "q-71983" :question/problem "Write the complex number $z=-1+\\text{i}$ in exponential form." :question/requires-calculator true :question/worked-solution "To write our complex number in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-1)^{2}+{(1)}^{2}} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nNow, since $z$ lies in the second quadrant, we can find the angle $\\theta $ as\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\pi -|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =\\pi -|\\operatorname{arctan}⁡(-1)| \\\\  & =\\pi -\\frac{\\pi }{4} \\\\  & =\\frac{3\\pi }{4}.\\end{aligned}\n$$\n\nFinally, substituting $r=\\sqrt{2}$ and $\\theta =\\frac{3\\pi }{4}$ into $z=r{e}^{\\text{i}\\theta },$ we get \n\n$$\nz=\\sqrt{2}\\,{\\text{e}}^{3\\pi \\text{i}/4}.\n$$"} {:db/id #edb/ref 17592186088323 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f245cc5-cf66-5e23-941f-5ed3c61f8519" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{x}^{2}}{7}+\\frac{{y}^{2}}{2}=1" :db/id #edb/ref 17592186342368} {:answer/id #uuid "2aaf0f54-99ea-5f51-b032-c17b629e54df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{9}=1" :db/id #edb/ref 17592186342595} {:answer/id #uuid "b0519dd2-e0e8-5e54-915c-ce7ec5a247b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9{x}^{2}}{24}+\\frac{{y}^{2}}{2}=1" :db/id #edb/ref 17592186343788} {:answer/id #uuid "f625dd86-0749-5723-adf5-e39041ad4f8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{x}^{2}}{49}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186344405} {:answer/id #uuid "fb39f685-9e2f-50ea-ae5a-250fc73349a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186344448}] :answer-field/correct {:answer/id #uuid "f625dd86-0749-5723-adf5-e39041ad4f8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{x}^{2}}{49}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186344405} :answer-field/id #uuid "65e8416d-99db-5904-9535-5182a7fbb499" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344665}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0f8eff0d-f84c-5907-a2c9-a5a7eb91d57f" :question/math-academy-id "q-7603" :question/problem "![](images/8a/8ac809353e7834d328d645fafb5c02e17386ba087e778a841865ef6313893e79.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=\\frac{7}{2}$ and the vertical radius has length $b=2.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{3.5}^{2}}+\\frac{{y}^{2}}{{2}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{(\\frac{7}{2})}^{2}}+\\frac{{y}^{2}}{4} & =1 \\\\ \\frac{{x}^{2}}{(\\frac{{7}^{2}}{{2}^{2}})}+\\frac{{y}^{2}}{4} & =1 \\\\ \\frac{{x}^{2}}{(\\frac{49}{4})}+\\frac{{y}^{2}}{4} & =1 \\\\ \\frac{4{x}^{2}}{49}+\\frac{{y}^{2}}{4} & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186088399 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c6610b5-0bba-5fec-97c7-f4f18756194a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ln (\\frac{1 + 3x}{1 - x}) = 4x - 4x^{2} + \\frac{26}{3}x^{3} - ⋯" :db/id #edb/ref 17592186087048} {:answer/id #uuid "3abe3b6b-7582-51dc-8b12-f562c3aefee1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ln (\\frac{1 + 3x}{1 - x}) = 2x - 5x^{2} + \\frac{28}{3}x^{3} - ⋯" :db/id #edb/ref 17592186087049} {:answer/id #uuid "519eefd9-623f-5498-bdbe-61c2fc5d53d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ln (\\frac{1 + 3x}{1 - x}) = 4x - 4x^{2} + \\frac{28}{3}x^{3} - ⋯" :db/id #edb/ref 17592186087050} {:answer/id #uuid "5a31a4ed-eff2-5125-8eac-d2983c29d00e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ln (\\frac{1 + 3x}{1 - x}) = 2x - 5x^{2} + \\frac{26}{3}x^{3} - ⋯" :db/id #edb/ref 17592186087051} {:answer/id #uuid "6fec755f-af2f-53d3-83ec-e2f594150756" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ln (\\frac{1 + 3x}{1 - x}) = 4x - 5x^{2} + \\frac{26}{3}x^{3} - ⋯" :db/id #edb/ref 17592186087052}] :answer-field/id #uuid "ee7a1175-b130-5add-aac5-708424a54521" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186087047}] :question/id #uuid "8a041f96-cc51-550c