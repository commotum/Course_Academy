id "a6ea08e6-1bef-5ee9-8f14-f173d322f2e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086190}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3d0d0e96-a523-5322-8133-5394507a5dd3" :question/math-academy-id "q-66604" :question/problem "Given that $-4{e}^{z}+7=5,$ then $z=$" :question/requires-calculator true :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}-4{e}^{z}+7 & =5 \\\\ -4{e}^{z} & =-2 \\\\ {e}^{z} & =\\frac{1}{2}\\end{aligned}\n$$\n\nThen, we find the natural logarithm $(ln)$ of both sides of the equation and solve for $z:$\n\n$$\n\\begin{aligned}{e}^{z} & =\\frac{1}{2} \\\\ \\operatorname{ln}⁡({e}^{z}) & =\\operatorname{ln}⁡(\\frac{1}{2}) \\\\ z & =-\\operatorname{ln}⁡(2)\\end{aligned}\n$$\n\nTherefore, the solution is $z=-\\operatorname{ln}⁡(2).$"} {:db/id #edb/ref 17592186088257 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c9027d9-45a0-58ef-8ac2-343fdc09daa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186086197} {:answer/id #uuid "fb6e7296-1899-50d8-b2f3-0f014e56d907" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{e}" :db/id #edb/ref 17592186086198} {:answer/id #uuid "193764c2-765c-570f-a840-c7d67bdfb9b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-e^{2}" :db/id #edb/ref 17592186086199} {:answer/id #uuid "5b156380-5ebb-5e51-bf16-aafc60a82992" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186086200} {:answer/id #uuid "797c76cb-f1c7-53be-bc0b-209dc4fc1a8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "