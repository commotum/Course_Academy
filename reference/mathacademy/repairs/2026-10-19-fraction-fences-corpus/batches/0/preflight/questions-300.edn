type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z = \\sqrt{3} + \\frac{1}{2}\\textrm{i}" :db/id #edb/ref 17592186087120} {:answer/id #uuid "c4e53a55-4016-5661-b667-851ba11f3e27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z = 1 + \\sqrt{3}\\textrm{i}" :db/id #edb/ref 17592186087121} {:answer/id #uuid "c5e5ff2f-a757-5518-8f01-58059934e75a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z = \\frac{1}{2} + \\frac{1}{2}\\textrm{i}" :db/id #edb/ref 17592186087122} {:answer/id #uuid "cc0eb011-9a49-5dff-9167-e488ab8eb23a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z = \\sqrt{3} + \\textrm{i}" :db/id #edb/ref 17592186087123} {:answer/id #uuid "176e3082-2783-5428-b1b4-68202d30cf79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z = \\frac{\\sqrt{3}}{2} + \\frac{\\sqrt{3}}{2}\\textrm{i}" :db/id #edb/ref 17592186087124}] :answer-field/id #uuid "bc61498b-3a23-5c26-ac17-df7cf01dcf4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186087119}] :question/id #uuid "17e21899-e4f9-5d28-b168-a2073b3f3d0c" :question/math-academy-id "q-8268" :question/problem "Express $z = 2(\\cos (\\frac{π}{3}) + \\textrm{i}\\sin (\\frac{π}{3}))$ in the form $z = x + \\textrm{i}y$."}]
