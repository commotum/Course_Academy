db/id #edb/ref 17592186099597}] :question/id #uuid "b5d0490d-cba9-54cd-a2d9-b7361361416e" :question/math-academy-id "q-41749" :question/problem "$6cis(\\frac{π}{4}) =$\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true} {:db/id #edb/ref 17592186101440 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f2d497f-046e-5ff8-9cc4-36ed95644117" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No such $k$ exists" :db/id #edb/ref 17592186099802} {:answer/id #uuid "0c60f8f4-7300-5616-8f6e-c3d7dff732be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 5" :db/id #edb/ref 17592186510803} {:answer/id #uuid "a78a608b-de9f-5aa1-a04e-3fd289b0efef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 2" :db/id #edb/ref 17592186511137} {:answer/id #uuid "c6e5d373-36bb-58f3-a752-14e6513fd5a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 3" :db/id #edb/ref 17592186511193} {:answer/id #uuid "e27fce12-ba0e-569d-9f95-ba338484dfd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 1" :db/id #edb/ref 17592186511253}] :answer-field/correct {:answer/id #uuid "e27fce12-ba0e-569d-9f95-ba338484dfd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 1" :db/id #edb/ref 17592186511253} :answer-field/id #uuid "81d7abef-1e5f-5e7e-a713-da16f17f6fd9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186099801}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ab43e107-00fc-5630-8abd-2dc86272117f" :question/math-academy-id "q-48743" :question/problem "Let $g(x)$ be the function defined below. For what values of $k$ is $g(x)$ continuous at $x=-2?$\n\n$$\ng(x)=\\{\\begin{aligned}\\frac{{x}^{2}+5x+6}{kx+2k}, & x\\ne -2 \\\\ k, & x=-2\\end{aligned}\n$$" :question/worked-solution "First, we factor the numerator and denominator and cancel any common factors:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}+5x+6}{kx+2k} & =\\frac{(x+3)(x+2)}{k(x+2)} \\\\  & =\\frac{(x+3)\\cancel{(x+2)}}{k\\cancel{(x+2)}} \\\\  & =\\frac{x+3}{k}.\\end{aligned}\n$$\n\nWe then can compute the limit at $x=-2,$ and we get\n\n$$\n{lim}_{x\\to -2}g(x)={lim}_{x\\to -2}(\\frac{x+3}{k})=\\frac{1}{k}.\n$$\n\nFor $g(x)$ to be continuous at $x=-2,$ we must have\n\n$$\n\\begin{aligned}g(-2) & ={lim}_{x\\to -2}g(x) \\\\ k & =\\frac{1}{k} \\\\ {k}^{2} & =1 \\\\ k & =\\pm 1.\\end{aligned}\n$$\n\nTherefore, for the function to be continuous at $x=-2,$ we need $k=\\pm 1.$"} {:db/id #edb/ref 17592186101442 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32bb9385-2e12-5272-a62e-7d322f0c0aec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186327376} {:answer/id #uuid "5e4c6fb8-1d6a-5d01-87cb-cc2ae9db526c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186327764} {:answer/id #uuid "61f5b08e-b4f8-5cd7-9366-887df6c9c695" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186327790} {:answer/id #uuid "d5dac1be-d0a9-5355-b292-386fa99e59b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186328805} {:answer/id #uuid "f54e32a5-58a3-5982-876f-705094203b21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186329078}] :answer-field/correct {:answer/id #uuid "5e4c6fb8-1d6a-5d01-87cb-cc2ae9db526c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186327764} :answer-field/id #uuid "154ce75e-a9a9-555e-96c7-1de5d9741872" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329220}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3cd961da-21ad-5bfd-88cf-d61e5f8fe86e" :question/math-academy-id "q-48844" :question/problem "For the functions $f(x)$ and $g(x),$ you are given the following data:\n\n$$\nf(0)=2,\\,{f}^{′}(0)=2,\\,g(0)=1,\\,{g}^{′}(0)=2\n$$\n\nCompute $\\frac{\\text{d}}{\\text{d}x}(\\frac{f(x)}{g(x)})$ at $x=0.$" :question/worked-solution "Using the quotient rule, we get\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{f(x)}{g(x)})=\\frac{{f}^{′}(x)g(x)-f(x){g}^{′}(x)}{(g(x))^{2}}.\n$$\n\nAt the point where $x=0$, this gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}}{\\text{d}x}(\\frac{f(x)}{g(x)})|}_{x=0} & =\\frac{{f}^{′}(0)g(0)-f(0){g}^{′}(0)}{{g}^{2}(0)} \\\\  & =\\frac{2\\cdot 1-2\\cdot 2}{{1}^{2}} \\\\  & =-2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186101452 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1911069-1c55-5932-b891-074fa38d0681" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186099874} {:answer/id #uuid "b51f2b52-e938-50e1-90fa-bb6448bdc3fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ln (\\frac{1}{5})" :db/id #edb/ref 17592186099875} {:answer/id #uuid "d779e443-9211-5d9f-983d-aa5869c4abba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\ln (\\frac{3}{2})" :db/id #edb/ref 17592186099876} {:answer/id #uuid "101f63ee-048f-5071-864e-f39dff0809ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186099877} {:answer/id #uuid "1ec3c643-d894-5c5f-a8f2-0ca4531cfaae" :answer/type {:db/id #edb/ref 17592186045498 :db/ide