rac{1+2x}{x})}^{2},\\,x\\ne 0" :db/id #edb/ref 17592186272749} {:answer/id #uuid "8a657071-1650-5d6c-b5c4-92125994bb16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1-2x}{x})}^{2},\\,x\\ne 0" :db/id #edb/ref 17592186273580} {:answer/id #uuid "94ae029c-717d-594a-94b3-99e945ac9df3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{-1-2x}{x})}^{2},\\,x\\ne 0" :db/id #edb/ref 17592186273683} {:answer/id #uuid "e5c8491d-ffbc-5e21-af51-3dd2104b993d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1+2x}{x})}^{2},\\,x\\ne 0" :db/id #edb/ref 17592186274417} {:answer/id #uuid "f9e82ab8-5078-5eff-8d80-7c402c1a0adc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-{(\\frac{-1+2x}{x})}^{2},\\,x\\ne 0" :db/id #edb/ref 17592186274577}] :answer-field/correct {:answer/id #uuid "e5c8491d-ffbc-5e21-af51-3dd2104b993d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1+2x}{x})}^{2},\\,x\\ne 0" :db/id #edb/ref 17592186274417} :answer-field/id #uuid "67afa213-144b-5939-9e4e-014024f2077a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274813}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5acf88e6-b052-5b29-9849-a312529836f0" :question/math-academy-id "q-15678" :question/problem "Find the Cartesian equation of the curve defined parametrically by\n\n$$\nx=\\frac{1}{t-2},\\,\\,\\,y={t}^{2},\\,t\\ne 2.\n$$" :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x & =\\frac{1}{t-2} \\\\ x(t-2) & =1 \\\\ t-2 & =\\frac{1}{x} \\\\ t & =\\frac{1}{x}+2 \\\\ t & =\\frac{1+2x}{x}\\end{aligned}\n$$\n\nNow substituting $t=\\frac{1+2x}{x}$ into our expression for $y={t}^{2},$ we get\n\n$$\n\\begin{aligned}y & ={(\\frac{1+2x}{x})}^{2}\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $y={(\\frac{1+2x}{x})}^{2}.$\n\nFinally, since $t\\ne 2$ and $x=\\frac{1}{t-2},$ we must have $x\\ne 0.$\n\nSo, the complete Cartesian equation is\n\n$$\ny={(\\frac{1+2x}{x})}^{2},\\,x\\ne 0.\n$$"} {:db/id #edb/ref 17592186101208 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11e05f86-8f81-5b3b-8cbf-09bc7298eb8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{x+1}{2})}^{2}+{(\\frac{y-4}{5})}^{2}=1" :db/id #edb/ref 17592186272549} {:answer/id #uuid "41070dd5-9a71-5c9d-9d49-0625efd1a709" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{x-1}{2})}^{2}+{(\\frac{y+4}{5})}^{2}=1" :db/id #edb/ref 17592186272941} {:answer/id #uuid "9c93177b-838f-57ab-b798-85239c0d52fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{x+4}{5})}^{2}+{(\\frac{y-1}{2})}^{2}=1" :db/id #edb/ref 17592186273743} {:answer/id #uuid "a3cb9f8c-23b7-50ba-90d6-f90b45e32f80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{x+4}{5})}^{2}+{(\\frac{y+1}{2})}^{2}=1" :db/id #edb/ref 17592186273799} {:answer/id #uuid "cbde9ca8-dffe-5a3f-aa7f-4f8da9c67b9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{x-1}{2})}^{2}+{(\\frac{y-4}{5})}^{2}=1" :db/id #edb/ref 17592186274161}] :answer-field/correct {:answer/id #uuid "11e05f86-8f81-5b3b-8cbf-09bc7298eb8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{x+1}{2})}^{2}+{(\\frac{y-4}{5})}^{2}=1" :db/id #edb/ref 17592186272549} :answer-field/id #uuid "0c253336-332a-5d61-90d0-7dcad87c9060" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274655}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "20bf63df-5014-5d31-baeb-e6e95f136242" :question/math-academy-id "q-15751" :question/problem "Find the Cartesian equation of the curve defined parametrically as \n\n$$\nx=2\\operatorname{sin}⁡t-1,\\,\\,\\,y=5\\operatorname{cos}⁡t+4,\\,t\\in [0,2\\pi ).\n$$" :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=2\\operatorname{sin}⁡t-1\\, & ⇒\\,\\operatorname{sin}⁡t=\\frac{x+1}{2} \\\\ y=5\\operatorname{cos}⁡t+4\\, & ⇒\\,\\operatorname{cos}⁡t=\\frac{y-4}{5}.\\end{aligned}\n$$\n\nUsing the Pythagorean identity ${sin}^{2}⁡t+{cos}^{2}⁡t=1$, we get\n\n$$\n\\begin{aligned}{(\\frac{x+1}{2})}^{2}+{(\\frac{y-4}{5})}^{2}=1.\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is ${(\\frac{x+1}{2})}^{2}+{(\\frac{y-4}{5})}^{2}=1.$"} {:db/id #edb/ref 17592186101209 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d7810ca-e33f-5d3f-8f99-cc35e16c36f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{y}{2})}^{2}-{(\\frac{x}{3})}^{2}=2\\pi " :db/id #edb/ref 17592186272648} {:answer/id #uuid "8e37f2c5-9169-53fe-b71d-d0dfd5d3531e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{(\\frac{y}{3})}^{2}+{(\\frac{x}{2})}^{2}=1" :db/id #edb/ref 17592186273615} {:answer/id #uuid "c4037945-4011-53b4-b0b4-00e87ba49959" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=6" :db/id #edb/ref 17592186274088} {:answer/id #uuid "e44ee7b9-47c6-5cb0-a376-c176b5ec298d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{y}{3})}^{2}+{(\\frac{x}{2})}^{2}=1" :db/id #edb/ref 17592186274406} {:answer/id #uuid "ebf8aa37-6b95-5381-b808-fe4e44945127" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{y}{2})}^{2}-{(\\frac{x}{3})}^{2}=1" :db/id #edb/ref 17592186274471}] :answer-field/correct {:answer/id #uuid "e44ee7b9-47c6-5cb0-a376-c176b5ec298d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{y}{3})}^{2}+{(\\frac{x}{2})}^{2}=1" :db/id #edb/ref 17592186274406} :answer-field/id #uuid "070cfa41-26cd-55dc-a980-842b8db620c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274648}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0582dce7-ef1a-5cfc-9ee5-447a325b4a34" :question/math-academy-id "q-15752" :question/problem "Find the Cartesian equation of the curve defined parametrically as\n\n$$\nx=2\\operatorname{cos}⁡t,\\,\\,\\,y=3\\operatorname{sin}⁡t,\\,t\\in [0,2\\pi ).\n$$" :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=2\\operatorname{cos}⁡t\\, & ⇒\\,\\operatorname{cos}⁡t=\\frac{x}{2} \\\\ y=3\\operatorname{sin}⁡t\\, & ⇒\\,\\operatorname{sin}⁡t=\\frac{y}{3}.\\end{aligned}\n$$\n\nUsing the Pythagorean identity ${sin}^{2}⁡t+{cos}^{2}⁡t=1,$ we get\n\n$$\n\\begin{aligned}{(\\frac{y}{3})}^{2}+{(\\frac{x}{2})}^{2}=1.\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is ${(\\frac{y}{3})}^{2}+{(\\frac{x}{2})}^{2}=1.$"} {:db/id #edb/ref 17592186101249 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54844146-c495-5d54-aee8-2c02423622c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{x+C}{1+{x}^{2}}" :db/id #edb/ref 17592186282407} {:answer/id #uuid "6c70491b-9e31-58f2-8846-1ca0f570c49f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt{\\frac{x+C}{1+x}}" :db/id #edb/ref 17592186282618} {:answer/id #uuid "af3cb523-1896-57b8-89bf-966bc7a8f93e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt{\\frac{2x+C}{2+{x}^{2}}}" :db/id #edb/ref 17592186283201} {:answer/id #uuid "f032f75a-3596-5032-b985-3f411665629b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{2x}{C-{x}^{2}}" :db/id #edb/ref 17592186283786} {:answer/id #uuid "f56ca620-fd7e-553b-bb5d-a2561c0b9208" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt{\\frac{x+C}{1+{x}^{2}}}" :db/id #edb/ref 17592186283836}] :answer-field/correct {:answer/id #uuid "f56ca620-fd7e-553b-bb5d-a2561c0b9208" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt{\\frac{x+C}{1+{x}^{2}}}" :db/id #edb/ref 17592186283836} :answer-field/id #uuid "55c78ed1-dcc5-50fb-afbe-af311de2c467" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284077}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2d210aec-e526-5356-8a8f-2d0e99d8b980" :question/math-academy-id "q-17546" :question/problem "Find the general solution to the following equation. \n\n$$\n2(1+{x}^{2})\\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{y}-2xy\\,,\\,y>0\n$$\n\n*Hint: You may wish to make use of the substitution $z={y}^{2}.$*" :question/worked-solution "First, we make the substitution\n\n$$\nz={y}^{2}\\,⟹\\,y={z}^{1/2}\\,.\n$$\n\nDifferentiating $y(x)$ using the chain rule, we get \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{2{z}^{1/2}}\\,\\frac{\\text{d}z}{\\text{d}x}.\n$$\n\nConsequently, the original differential equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}\\frac{(1+{x}^{2})}{{z}^{1/2}}\\,\\frac{\\text{d}z}{\\text{d}x} & =\\frac{1}{{z}^{1/2}}-2x{z}^{1/2} \\\\ (1+{x}^{2})\\,\\frac{\\text{d}z}{\\text{d}x} & =1-2xz\\end{aligned}\n$$\n\nThis differential equation is linear, so we can use the method of integrating factors. First, we write the above equation in standard form:\n\n$$\n\\begin{aligned}(1+{x}^{2})\\,\\frac{\\text{d}z}{\\text{d}x} & =1-2xz \\\\ \\frac{\\text{d}z}{\\text{d}x} & =\\frac{1}{1+{x}^{2}}-\\frac{2xz}{1+{x}^{2}} \\\\ \\frac{\\text{d}z}{\\text{d}x}+\\frac{2x}{1+{x}^{2}}\\,z & =\\frac{1}{1+{x}^{2}}\\end{aligned}\n$$\n\nThe above equation is in the standard form\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}+P(x)z=Q(x)\n$$\n\nwith\n\n$$\nP(x)=\\frac{2x}{1+{x}^{2}},\\,Q(x)=\\frac{1}{1+{x}^{2}}\\,.\n$$\n\nWe then compute an integrating factor:\n\n$$\n\\begin{aligned}I(x) & ={e}^{\\int P(x)dx} \\\\  & ={e}^{\\int 2x/(1+{x}^{2})dx} \\\\  & ={e}^{\\operatorname{ln}⁡(1+{x}^{2})} \\\\  & =1+{x}^{2}\\end{aligned}\n$$\n\nMultiplying both sides of the equation in standard form by $I(x)=1+{x}^{2}$ yields\n\n$$\n\\begin{aligned}(1+{x}^{2})\\cdot (\\frac{\\text{d}z}{\\text{d}x}+\\frac{2x}{1+{x}^{2}}\\,z) & =(1+{x}^{2})\\cdot (\\frac{1}{1+{x}^{2}}) \\\\ (1+{x}^{2})\\cdot \\frac{\\text{d}z}{\\text{d}x}+2xz & =1 \\\\ \\frac{\\text{d}}{\\text{d}x}[z(1+{x}^{2})] & =1\\,.\\end{aligned}\n$$\n\nNow, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}[z(1+{x}^{2})]\\,\\text{d}x & =\\int 1\\,\\text{d}x \\\\ z(1+{x}^{2}) & =x+C \\\\ z & =\\frac{x+C}{1+{x}^{2}}\\end{aligned}\n$$\n\nFinally, we determine $y(x)$ by writing $z={y}^{2}.$ This results in\n\n$$\n\\begin{aligned}{y}^{2} & =\\frac{x+C}{1+{x}^{2}} \\\\ y & =\\sqrt{\\frac{x+C}{1+{x}^{2}}},\\end{aligned}\n$$\n\nwhere in the last step we used that $y>0.$"} {:db/id #edb/ref 17592186101279 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1812698a-baa5-5c04-bbe5-0eaab253aef4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48\\pi \\,{mm}^{2}" :db/id #edb/ref 17592186509732} {:answer/id #uuid "39604b6a-d37e-5b93-b3dd-8a6382ccd526" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36\\pi \\,{mm}^{2}" :db/id #edb/ref 17592186509811} {:answer/id #uuid "3f3c1da7-84f5-5398-886d-21fd3f98354d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49\\pi \\,{mm}^{2}" :db/id #edb/ref 17592186509823} {:answer/id #uuid "b4088f69-4254-5878-a7c1-d3dc65b31298" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "44\\pi \\,{mm}^{2}" :db/id #edb/ref 17592186510075} {:answer/id #uuid "f9db4585-c2cb-517d-a138-24946d17f8e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45\\pi \\,{mm}^{2}" :db/id #edb/ref 17592186510221}] :answer-field/correct {:answer/id #uuid "1812698a-baa5-5c04-bbe5-0eaab253aef4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48\\pi \\,{mm}^{2}" :db/id #edb/ref 17592186509732} :answer-field/id #uuid "ae5cdce9-4bc0-5a63-9f3a-1ec87a9fb050" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186098995}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1317ed44-314d-54c1-9f68-756c95a13928" :question/math-academy-id "q-18447" :question/problem "We wish to construct a cylindrical can with a base but no lid. Our cylinder must have an exact volume of $64\\pi \\,{mm}^{3}.$ What is the smallest possible surface area of the cylinder?" :question/requires-calculator true :question/worked-solution "First, let's draw a picture of a cylinder. Let $r$ be the radius, and $h$ the height.\n\n![](images/ce/cec96bdd2335ff5635d11c4ea6016257b35bd5450778a70ecc1f5e0156ccfe9e.png)\n\nWe wish to minimize the surface area\n\n$$\nS=2\\pi rh+\\pi {r}^{2}.\n$$\n\nWe know that the volume is fixed at $64\\pi \\,{mm}^{3},$ so we also have the constraint condition\n\n$$\n64\\pi =\\pi {r}^{2}h.\n$$\n\nNow, by making $h$ the subject of the constraint equation, we have that\n\n$$\nh=\\frac{64}{{r}^{2}}.\n$$\n\nPlugging the above into our expression for $S,$ we obtain\n\n$$\n\\begin{aligned}S(r) & =2\\pi r(\\frac{64}{{r}^{2}})+\\pi {r}^{2} \\\\  & =\\frac{128\\pi }{r}+\\pi {r}^{2}.\\end{aligned}\n$$\n\nWe want to minimize $S,$ so we need to differentiate $S$ and set the derivative equal to zero. The derivative is \n\n$$\n{S}^{′}(r)=-\\frac{128\\pi }{{r}^{2}}+2\\pi r.\n$$\n\nSetting the derivative equal to zero and solving for $r$ gives a stationary point, as follows:\n\n$$\n\\begin{aligned}{S}^{′}(r) & =0 \\\\ -\\frac{128\\pi }{{r}^{2}}+2\\pi r & =0 \\\\ 2\\pi r & =\\frac{128\\pi }{{r}^{2}} \\\\ 2\\pi {r}^{3} & =128\\pi  \\\\ {r}^{3} & =64 \\\\ r & =\\sqrt[3]{64} \\\\ r & =4\\,\\text{mm}\\end{aligned}\n$$\n\nUsing a calculator, we can verify that if $r<4$ then ${S}^{′}(r)<0,$ and if $r>4$ then ${S}^{′}(r)>0,$ which means that the stationary point $r=4$ is indeed a minimum of $S(r).$\n\nSo the cylinder with the smallest surface area has radius $r=4\\,\\text{mm}.$\n\nFinally, to find the smallest surface area, we substitute $r=4\\,\\text{mm}$ into the equation for the surface area $S:$\n\n$$\n\\begin{aligned}S(4) & =\\frac{128\\pi }{4}+\\pi (4)^{2} \\\\  & =32\\pi +16\\pi  \\\\  & =48\\pi \\,{\\text{mm}}^{2}\\end{aligned}\n$$\n\nTherefore, the smallest possible surface area of the cylinder is $S=48\\pi \\,{\\text{mm}}^{2}.$"} {:db/id #edb/ref 17592186101281 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0622008c-5afc-5a3c-973b-fcf2bc192692" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "112" :db/id #edb/ref 17592186284837} {:answer/id #uuid "465b1ec7-351b-5f7f-bc42-ffdbe08dc8de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186285433} {:answer/id #uuid "a6624b05-6001-5b48-b9c4-09e2e7597f25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186286307} {:answer/id #uuid "eb20aa09-f3fa-5150-94b2-780d75954494" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186286940} {:answer/id #uuid "fe0ef431-d7f9-52f6-8361-18e3c9d0b9d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186287113}] :answer-field/correct {:answer/id #uuid "465b1ec7-351b-5f7f-bc42-ffdbe08dc8de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186285433} :answer-field/id #uuid "a6c0e83c-a3ab-5514-b4fc-6b920103f41d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287483}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cfee74aa-803f-5479-96f1-16dab36aa6d6" :question/math-academy-id "q-18627" :question/problem "The coefficient of ${x}^{7}y$ in the expansion of ${(x+2y)}^{8}$ is" :question/requires-calculator true :question/worked-solution "The binomial theorem states that for any positive integer $n,$ we have\n\n \n\n$$\n(a+b)^{n}=(\\frac{n}{0}){a}^{n}{b}^{0}+(\\frac{n}{1}){a}^{n-1}{b}^{1}+(\\frac{n}{2}){a}^{n-2}{b}^{2}+⋯+(\\frac{n}{n}){a}^{0}{b}^{n}.\n$$\n\nIn the case of ${(x+2y)}^{8},$ we have $a=x,$ $b=2y,$ and $n=8.$ Therefore,\n\n$$\n\\begin{aligned}{(x+2y)}^{8}=(\\frac{8}{0}){x}^{8}(2y)^{0}+(\\frac{8}{1}){x}^{8-1}(2y)^{1}+(\\frac{8}{2}){x}^{8-2}(2y)^{2}+⋯+(\\frac{8}{8}){x}^{8-8}(2y)^{8}.\\end{aligned}\n$$\n\nFrom here, we see that the ${x}^{7}y$ term must be\n\n$$\n(\\frac{8}{1}){x}^{8-1}(2y)^{1}.\n$$\n\nSimplifying this term, we get\n\n$$\n\\begin{aligned}(\\frac{8}{1}){x}^{8-1}(2y)^{1} & =8{x}^{7}\\cdot (2y) \\\\  & =16{x}^{7}y.\\end{aligned}\n$$\n\nTherefore, the coefficient of ${x}^{7}y$ is $16.$"} {:db/id #edb/ref 17592186101293 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4505e470-dd79-5944-a4cb-ae3569c62d43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{6}+12{x}^{5}y+30{x}^{4}{y}^{2}+…" :db/id #edb/ref 17592186285417} {:answer/id #uuid "5e5461ca-d7c4-509d-a12c-48be1ec64657" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{6}-12{x}^{5}y+60{x}^{4}{y}^{2}+…" :db/id #edb/ref 17592186285653} {:answer/id #uuid "819df16b-6146-5c12-8e57-80c0811d2829" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{6}+12{x}^{5}y+1024{x}^{4}{y}^{2}+…" :db/id #edb/ref 17592186285978} {:answer/id #uuid "dc6f3dba-6c48-5e26-9f30-83b662107319" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{6}-12{x}^{5}y+80{x}^{4}{y}^{2}+…" :db/id #edb/ref 17592186286794} {:answer/id #uuid "e7d17dce-fbe0-5e9c-8bf3-8c5ff1d21ae6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{6}-12{x}^{5}y+24{x}^{4}{y}^{2}+…" :db/id #edb/ref 17592186286911}] :answer-field/correct {:answer/id #uuid "5e5461ca-d7c4-509d-a12c-48be1ec64657" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{6}-12{x}^{5}y+60{x}^{4}{y}^{2}+…" :db/id #edb/ref 17592186285653} :answer-field/id #uuid "f2f75b7f-0ec9-5bba-bf3a-023d2cd38da6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287645}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a56f6ef0-1192-5a7e-9865-0f892330f196" :question/math-academy-id "q-19353" :question/problem "${(x-2y)}^{6}=$" :question/worked-solution "The binomial theorem states that for any positive integer $n,$ we have\n\n \n\n$$\n(a+b)^{n}=(\\frac{n}{0}){a}^{n}{b}^{0}+(\\frac{n}{1}){a}^{n-1}{b}^{1}+(\\frac{n}{2}){a}^{n-2}{b}^{2}+…+(\\frac{n}{n}){a}^{0}{b}^{n}.\n$$\n\nIn the case of ${(x-2y)}^{6},$ we have  $a=x,$ $b=-2y,$ $n=6.$ \n\nTherefore, the first three terms of ${(x-2y)}^{6}$ are as follows:\n\n$$\n\\begin{aligned}(x-2y)^{6} & =(\\frac{6}{0})(x)^{6}(-2y)^{0}+(\\frac{6}{1})(x)^{6-1}(-2y)^{1}+(\\frac{6}{2})(x)^{6-2}(-2y)^{2}+… \\\\  & =1(x)^{6}+6(x)^{5}(-2y)+15(x)^{4}(4{y}^{2})+… \\\\  & ={x}^{6}-12{x}^{5}y+60{x}^{4}{y}^{2}+…\\end{aligned}\n$$"} {:db/id #edb/ref 17592186101297 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00ad7b38-011b-5bbc-ad6f-119764a28f5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\operatorname{ln}⁡({e}^{4x}-\\frac{1}{4})" :db/id #edb/ref 17592186284794} {:answer/id #uuid "5cd60163-91c2-5f68-b12b-44f98e6c673c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\operatorname{ln}⁡({e}^{4x}+5)" :db/id #edb/ref 17592186285640} {:answer/id #uuid "60978d4b-4f9a-549a-a78c-7b2ab10d8ff1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\operatorname{ln}⁡(\\frac{{e}^{4x}}{4}+C)" :db/id #edb/ref 17592186285674} {:answer/id #uuid "675c44fb-e5b5-5cc4-a665-61ee54152b6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\operatorname{ln}⁡(\\frac{{e}^{4x}+4{e}^{5}-1}{4})" :db/id #edb/ref 17592186285732} {:answer/id #uuid "dd44c23d-4f4e-5432-b33e-dff52c07b119" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\operatorname{ln}⁡(\\frac{{e}^{4x}}{4}+{e}^{5}+\\frac{1}{4})" :db/id #edb/ref 17592186286799}] :answer-field/correct {:answer/id #uuid "675c44fb-e5b5-5cc4-a665-61ee54152b6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\operatorname{ln}⁡(\\frac{{e}^{4x}+4{e}^{5}-1}{4})" :db/id #edb/ref 17592186285732} :answer-field/id #uuid "af959d06-569d-5cc3-8e3f-fadee181c763" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287510}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e844aafc-6198-5e85-8b96-36f86924e412" :question/math-academy-id "q-20071" :question/problem "Find the particular solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}={e}^{4x-y}$ that satisfies $y(0)=5.$" :question/worked-solution "We first find the general solution and then apply the given initial condition to find a particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={e}^{4x-y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & ={e}^{4x}\\cdot {e}^{-y} \\\\ {e}^{y}\\,\\frac{\\text{d}y}{\\text{d}x} & ={e}^{4x} \\\\ \\int {e}^{y}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int {e}^{4x}\\,\\text{d}x \\\\ \\int {e}^{y}\\,\\text{d}y & =\\int {e}^{4x}\\,\\text{d}x \\\\ {e}^{y} & =\\frac{{e}^{4x}}{4}+C\\,.\\end{aligned}\n$$\n\nApplying the natural logarithm to both sides, we find the general solution:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({e}^{y}) & =\\operatorname{ln}⁡(\\frac{{e}^{4x}}{4}+C) \\\\ y & =\\operatorname{ln}⁡(\\frac{{e}^{4x}}{4}+C)\\end{aligned}\n$$\n\nWe now apply the condition $y(0)=5$ to find $C:$\n\n$$\n\\begin{aligned}y(0) & =5 \\\\ \\operatorname{ln}⁡(\\frac{{e}^{4\\cdot 0}}{4}+C) & =5 \\\\ \\operatorname{ln}⁡(\\frac{1}{4}+C) & =5 \\\\ \\frac{1}{4}+C & ={e}^{5} \\\\ C & =\\frac{4{e}^{5}-1}{4}\\end{aligned}\n$$\n\nThus the particular solution of $\\frac{\\text{d}y}{\\text{d}x}={e}^{4x-y}$ that satisfies the condition $y(0)=5$ is\n\n$$\ny=\\operatorname{ln}⁡(\\frac{{e}^{4x}+4{e}^{5}-1}{4}).\n$$"} {:db/id #edb/ref 17592186101362 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c895c8d-699b-530d-a589-88fc0a6943f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45}^{∘}+n\\cdot {360}^{∘},\\,\\,x={135}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186295336} {:answer/id #uuid "197730a9-baff-5534-9077-65fe0d84ed6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45}^{∘}+n\\cdot {180}^{∘}" :db/id #edb/ref 17592186295417} {:answer/id #uuid "87074840-a19d-5778-b2ce-7cf21e34749a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={135}^{∘}+n\\cdot {180}^{∘}" :db/id #edb/ref 17592186295993} {:answer/id #uuid "acd0b5a7-28f8-59f1-a223-dfd21ad70676" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45}^{∘}+n\\cdot {360}^{∘},\\,\\,x={315}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186296178} {:answer/id #uuid "eef75443-1691-5b6e-8bfa-7cc5888d446e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={135}^{∘}+n\\cdot {360}^{∘},\\,\\,x={225}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186296536}] :answer-field/correct {:answer/id #uuid "0c895c8d-699b-530d-a589-88fc0a6943f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45}^{∘}+n\\cdot {360}^{∘},\\,\\,x={135}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186295336} :answer-field/id #uuid "b641db49-0507-5499-a87b-cd90e6072e21" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297013}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a9ba9ec8-f4a0-5e57-a91a-9ba206468825" :question/math-academy-id "q-30100" :question/problem "In degrees, what is the general solution to the equation $\\sqrt{2}\\operatorname{csc}⁡x=2?$ Assume that $n$ is an integer." :question/worked-solution "First, we rearrange the equation and isolate $\\operatorname{csc}⁡x:$\n\n$$\n\\begin{aligned}\\sqrt{2}\\operatorname{csc}⁡x & =2 \\\\ \\operatorname{csc}⁡x & =\\sqrt{2}\\end{aligned}\n$$\n\nRecall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=\\frac{1}{\\sqrt{2}}=\\frac{\\sqrt{2}}{2}.\n$$\n\nNow, we find the principal value:\n\n$$\n{x}_{1}=\\text{arcsin}(\\frac{\\sqrt{2}}{2})={45}^{∘}\n$$\n\nOur first solution lies in the $1$st quadrant and has a reference angle of ${\\theta }_{R}={45}^{∘}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has ${\\theta }_{R}={45}^{∘}.$\n\n![](images/97/978eaf470ef3b61ff7839471ed4ac46f320922b4d30f7f95566095124d0526d7.png)\n\nSince the second solution ${x}_{2}$  lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}-{\\theta }_{R} \\\\  & ={180}^{∘}-{45}^{∘} \\\\  & ={135}^{∘}\\end{aligned}\n$$\n\nTherefore, the general solution to the given equation is\n\n$$\nx={45}^{∘}+n\\cdot {360}^{∘},\\,x={135}^{∘}+n\\cdot {360}^{∘}.\n$$"} {:db/id #edb/ref 17592186101365 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a02b2ac-0bce-55b0-91e4-8c22b954741f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\pi }" :db/id #edb/ref 17592186295318} {:answer/id #uuid "235f22ad-40d0-5845-a702-3d539029c35e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\pi }" :db/id #edb/ref 17592186295459} {:answer/id #uuid "4c89d98a-c3be-5c94-8287-153667e67982" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{\\pi }" :db/id #edb/ref 17592186295703} {:answer/id #uuid "bef48e4e-af97-5f81-86d0-5aaaffa9feb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296275} {:answer/id #uuid "d5db9937-d0be-5753-ac50-7bc02f351e36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2\\pi }" :db/id #edb/ref 17592186296391}] :answer-field/correct {:answer/id #uuid "0a02b2ac-0bce-55b0-91e4-8c22b954741f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\pi }" :db/id #edb/ref 17592186295318} :answer-field/id #uuid "4b70c271-15d7-5977-b27f-aeaabb026c4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296778}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "32d27667-c963-519c-a8ec-24392218b2f3" :question/math-academy-id "q-30752" :question/problem "What is the average value of $h(x)=\\operatorname{sin}⁡2x$ on the interval $[\\frac{\\pi }{4},\\frac{\\pi }{2}]?$" :question/requires-calculator true :question/worked-solution "Applying the average value formula, we find that the average value of the function is\n\n$$\n\\begin{aligned}{h}_{\\text{avg}} & =\\frac{1}{b-a}\\,{\\int }_{a}^{b}h(x)\\,\\text{d}x \\\\  & =\\frac{1}{(\\frac{\\pi }{2}-\\frac{\\pi }{4})}\\,{\\int }_{\\pi /4}^{\\pi /2}\\operatorname{sin}⁡2x\\,\\text{d}x \\\\  & =\\frac{4}{\\pi }\\,{\\int }_{\\pi /4}^{\\pi /2}\\operatorname{sin}⁡2x\\,\\text{d}x \\\\  & =\\frac{4}{\\pi }{(\\frac{1}{2})(-\\operatorname{cos}⁡(2x))|}_{\\pi /4}^{\\pi /2} \\\\  & =-\\frac{2}{\\pi }[\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{2})-\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{4})] \\\\  & =-\\frac{2}{\\pi }[\\operatorname{cos}⁡(\\pi )-\\operatorname{cos}⁡(\\frac{\\pi }{2})] \\\\  & =-\\frac{2}{\\pi }(-1-0) \\\\  & =\\frac{2}{\\pi }.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186101382 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf8dc591-611a-57ee-be7a-ab3ca993e1f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186316290}] :answer-field/correct {:answer/id #uuid "cf8dc591-611a-57ee-be7a-ab3ca993e1f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186316290} :answer-field/id #uuid "0797688b-a333-5870-9127-fbbdc148f9ae" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316567}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0c9992f2-7c1f-5f91-a855-c99990d2066a" :question/math-academy-id "q-344692" :question/problem "Find the **exact** value of $c$ that satisfies the mean value theorem for integrals for $f(x)={x}^{3}-3x+2$ on the interval $[-1,1].$\n\n$c=$\n{{field-1}}" :question/worked-solution "Applying the mean value theorem for the integrals, we have\n\n$$\n\\begin{aligned}(b-a)f(c) & ={\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\ f(c) & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\ f(c) & =\\frac{1}{1-(-1)}{\\int }_{-1}^{1}({x}^{3}-3x+2)\\text{d}x \\\\  & ={\\frac{1}{2}\\cdot (\\frac{1}{4}{x}^{4}-\\frac{3}{2}{x}^{2}+2x)|}_{-1}^{1} \\\\  & =\\frac{1}{2}[(\\frac{1}{4}\\cdot (1)^{4}-\\frac{3}{2}(1)^{2}+2\\cdot 1)-(\\frac{1}{4}\\cdot (-1)^{4}-\\frac{3}{2}(-1)^{2}+2\\cdot (-1))] \\\\  & =\\frac{1}{2}[(\\frac{1}{4}-\\frac{3}{2}+2)-(\\frac{1}{4}-\\frac{3}{2}-2)] \\\\  & =\\frac{1}{2}(\\frac{3}{4}-(-\\frac{13}{4})) \\\\  & =\\frac{1}{2}(4) \\\\  & =2.\\end{aligned}\n$$\n\nNow, we use the expression for $f(x)$ to solve for the value of $c:$\n\n$$\n\\begin{aligned}f(c) & =2 \\\\ {c}^{3}-3c+2 & =2 \\\\ {c}^{3}-3c & =0 \\\\ c({c}^{2}-3) & =0 \\\\ c & =0\\,\\text{or}\\,c=\\pm \\sqrt{3}\\end{aligned}\n$$\n\nHowever, since $c\\in [-1,1],$ we take only $c=0.$"} {:db/id #edb/ref 17592186101403 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae6e5fa3-592d-5fd4-814c-88e9418d891a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2cis(\\frac{π}{4})" :db/id #edb/ref 17592186099580} {:answer/id #uuid "db79cabf-1cda-513c-abf2-f88ba38a0a6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2cis(\\frac{7π}{4})" :db/id #edb/ref 17592186099581} {:answer/id #uuid "4298e3fa-f5a5-5229-8414-11e8e8fdfc88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2cis(\\frac{5π}{4})" :db/id #edb/ref 17592186099582} {:answer/id #uuid "55cea33b-06bd-5b8e-8dd5-1344aac53f42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}cis(\\frac{5π}{4})" :db/id #edb/ref 17592186099583} {:answer/id #uuid "73b75871-0753-54ee-910f-3d8e2a256d85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}cis(\\frac{π}{4})" :db/id #edb/ref 17592186099584}] :answer-field/id #uuid "530ea27f-7176-5d28-b54b-895a53f6931d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186099579}] :question/id #uuid "1ec14e56-1928-54c0-9653-29f7aaaff19a" :question/math-academy-id "q-41743" :question/problem "What is $\\sqrt{2} - \\sqrt{2}\\textrm{i}$?"} {:db/id #edb/ref 17592186101404 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1a3d9d3-e9e7-5442-a211-c88bc8e2647b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4cis(\\frac{π}{3})" :db/id #edb/ref 17592186099586} {:answer/id #uuid "05986258-56e7-5c84-b9c0-9ffcb26a05c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8cis(\\frac{2π}{3})" :db/id #edb/ref 17592186099587} {:answer/id #uuid "084864c1-355e-5deb-8e74-2daa9ec31f3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}cis(\\frac{π}{3})" :db/id #edb/ref 17592186099588} {:answer/id #uuid "11102d40-2f55-59bf-8cf8-f29433c668a6