on/answer-fields [{:answer-field/choices [{:answer/id #uuid "af65f090-8155-5ca3-8a2d-6aa09bbe2000" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\ln (\\frac{xy^{2}}{\\sqrt{z}})" :db/id #edb/ref 17592186051297} {:answer/id #uuid "d6d17041-0ddf-5747-8edc-26ed1b529261" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ln (\\frac{x^{3}y^{2}}{\\sqrt{z}})" :db/id #edb/ref 17592186051298} {:answer/id #uuid "e0999d56-072c-59d9-8567-0e88b0dc8a16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ln (\\frac{6xy}{\\sqrt{z}})" :db/id #edb/ref 17592186051299} {:answer/id #uuid "ff3d92ce-379a-518a-ae75-1fee35ce9aea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "xy^{2} - \\sqrt{z}" :db/id #edb/ref 17592186051300} {:answer/id #uuid "033256c6-8b75-57bb-a6d8-52c5eb545b04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ln (\\frac{x^{3}}{\\sqrt{y^{2}z}})" :db/id #edb/ref 17592186051301}] :answer-field/id #uuid "eb59bb47-4df4-5edc-8c20-046b059e78ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186051296}] :question/id #uuid "3e2b66a0-666e-508e-a538-22e2d9fb9285" :question/math-academy-id "q-1111" :question/problem "Express $3\\ln (x) + 2\\ln (y) - \\frac{1}{2}\\ln (z)$ as a single logarithm."} {:db/id #edb/ref 17592186055021 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "249f7541-1a8a-52ec-9e0c-a25f296e0698" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 8" :db/id #edb/ref 17592186536338} {:answer/id #uuid "55632b59-8ff0-5f33-bd84-759756febdc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 6" :db/id #edb/ref 17592186536432} {:answer/id #uuid "99888988-7d3e-5baa-ab4a-decbb3967954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 8" :db/id #edb/ref 17592186536529} {:answer/id #uuid "ba590d86-ddb8-598a-a220-46efedf147bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge -8" :db/id #edb/ref 17592186536579} {:answer/id #uuid "e10696b4-01d9-5bd2-8740-a24555a84567" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le -8" :db/id #edb/ref 17592186536632}] :answer-field/correct {:answer/id #uuid "ba590d86-ddb8-598a-a220-46efedf147bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge -8" :db/id #edb/ref 17592186536579} :answer-field/id #uuid "512b237b-81e0-5620-86e4-6c38ec6c9bc9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186051656}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "05f33d89-cfbf-5ef4-9277-aa93cd1c185b" :question/math-academy-id "q-153984" :question/problem "Solve the inequality $-\\frac{x}{2}\\le 4.$" :question/worked-solution "The variable $x$ is being *divided* by $2.$ To isolate $x$ and remove the negative sign, we *multiply* by $-2.$ \n\nRemember, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-\\frac{x}{2}\\,\\, & \\le \\,\\,4 \\\\ (-2)\\cdot (-\\frac{x}{2})\\,\\, & \\ge \\,\\,(-2)\\cdot 4 \\\\ (-2)\\cdot (-\\frac{x}{2})\\,\\, & \\ge \\,\\,-8\\end{aligned}\n$$\n\nSince two negative numbers multiply to give a positive number, we first cancel the negatives:\n\n$$\n\\begin{aligned}(-2)\\cdot (-\\frac{x}{2}) & \\ge -8 \\\\ (\\cancel{-}2)\\cdot (\\cancel{-}\\frac{x}{2}) & \\ge -8 \\\\ 2\\cdot \\frac{x}{2} & \\ge -8\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $2$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}2\\cdot \\frac{x}{2} & \\ge -8 \\\\ \\frac{2x}{2} & \\ge -8 \\\\ \\frac{\\cancel{2}x}{\\cancel{2}} & \\ge -8 \\\\ x & \\ge -8\\end{aligned}\n$$\n\nTherefore, the solution is $x\\ge -8.$"} {:db/id #edb/ref 17592186055023 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d49bfa7-1f01-5706-a0d7-e212b240aefa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le -36" :db/id #edb/ref 17592186488501} {:answer/id #uuid "2c309931-42a9-5cfe-b8c7-ab31de9c391e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge -36" :db/id #edb/ref 17592186488564} {:answer/id #uuid "70e73623-91bd-50c1-b2a5-5488adf5f0f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 36" :db/id #edb/ref 17592186488696} {:answer/id #uuid "b31cdb4f-cbb5-581f-bd40-300852926061" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge -18" :db/id #edb/ref 17592186488828} {:answer/id #uuid "d7aca673-1ac9-5202-859a-b0c90a3cce98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 36" :db/id #edb/ref 17592186488916}] :answer-field/correct {:answer/id #uuid "2c309931-42a9-5cfe-b8c7-ab31de9c391e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge -36" :db/id #edb/ref 17592186488564} :answer-field/id #uuid "8b247723-10a2-59dd-a722-3e6fa2bf5abb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186051668}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d0eabfed-9153-5a03-9ac2-bd2dd6f86cff" :question/math-academy-id "q-153986" :question/problem "Solve the inequality $9\\ge -\\frac{x}{4}.$" :question/worked-solution "The variable $x$ is being *divided* by $4.$ To isolate $x$ and remove the negative sign, we *multiply* by $-4$ \n\nRemember, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}9\\,\\, & \\ge \\,\\,-\\frac{x}{4} \\\\ (-4)\\cdot 9\\,\\, & \\le \\,\\,(-4)\\cdot (-\\frac{x}{4}) \\\\ -36\\,\\, & \\le \\,\\,(-4)\\cdot (-\\frac{x}{4})\\end{aligned}\n$$\n\nSince two negative numbers multiply to give a positive number, we first cancel the negatives:\n\n$$\n\\begin{aligned}-36\\,\\, & \\le (-4)\\cdot (-\\frac{x}{4}) \\\\ -36 & \\le (\\cancel{-}4)\\cdot (\\cancel{-}\\frac{x}{4}) \\\\ -36 & \\le 4\\cdot \\frac{x}{4}\\end{aligned}\n$$\n\nNow, we can cancel the common factor $4$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}-36 & \\le 4\\cdot \\frac{x}{4} \\\\ -36 & \\le \\frac{4x}{4} \\\\ -36 & \\le \\frac{\\cancel{4}x}{\\cancel{4}} \\\\ -36 & \\le x\\end{aligned}\n$$\n\nFinally, we rewrite the inequality with the variable on the left-hand side:\n\n$$\nx\\ge -36\n$$\n\nTherefore, the solution is $x\\ge -36.$"} {:db/id #edb/ref 17592186055090 :question/answer-fields [{:answer-field/id #uuid "f9a72e32-6aca-5e4a-a3d4-acd6b378c41c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186051989}] :question/id #uuid "4be79a7e-5904-5fdd-bfea-4ed692886ffd" :question/math-academy-id "q-184057" :question/problem "$((-3)^{2} + (-2)^{4}) \\cdot (-\\frac{1}{5}) =$ {{field-1}}"} {:db/id #edb/ref 17592186055141 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2546fc47-8c07-5115-814a-8146ced978bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y(2-\\operatorname{ln}⁡(y))}{x}" :db/id #edb/ref 17592186288277} {:answer/id #uuid "57345f82-5b97-5af2-9839-7422717d4919" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2y-\\operatorname{ln}⁡(y)}{x}" :db/id #edb/ref 17592186288637} {:answer/id #uuid "9ac550bb-b62f-5d41-baea-cefe6d3362bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x(2y-\\operatorname{ln}⁡(y))}{y}" :db/id #edb/ref 17592186289068} {:answer/id #uuid "a92bd509-6c75-5566-9d6e-1bebc673246a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x(2-\\operatorname{ln}⁡(y))}{y}" :db/id #edb/ref 17592186289154} {:answer/id #uuid "d60b15ff-b4e3-5119-9aa2-888ab48baa08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2-y\\operatorname{ln}⁡(y)}{xy}" :db/id #edb/ref 17592186289453}] :answer-field/correct {:answer/id #uuid "2546fc47-8c07-5115-814a-8146ced978bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y(2-\\operatorname{ln}⁡(y))}{x}" :db/id #edb/ref 17592186288277} :answer-field/id #uuid "07b645f0-053d-5f85-973d-6e01d88e18b9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289743}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3f5ae45c-0d29-593f-abd0-85c3a45aaf13" :question/math-academy-id "q-2287" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $x\\operatorname{ln}⁡(y)=2x.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\nNote that to differentiate the $x\\operatorname{ln}⁡y$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}\\begin{aligned}x\\operatorname{ln}⁡(y) & =2x \\\\ \\frac{\\text{d}}{\\text{d}x}(x\\operatorname{ln}⁡(y)) & =\\frac{\\text{d}}{\\text{d}x}(2x) \\\\ [(x)(\\frac{1}{y}\\cdot \\frac{\\text{dy}}{\\text{d}x})+(1)(\\operatorname{ln}⁡(y))] & =2\\end{aligned}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{x}{y}(\\frac{\\text{d}y}{\\text{d}x})+\\operatorname{ln}⁡(y) & =2 \\\\ \\frac{x}{y}(\\frac{\\text{d}y}{\\text{d}x}) & =2-\\operatorname{ln}⁡(y) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{y(2-\\operatorname{ln}⁡(y))}{x}\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186055179 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6831d18-43ec-5dd7-b0d7-b96de99de3d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{10}{3}" :db/id #edb/ref 17592186052371} {:answer/id #uuid "e8799bb3-58d5-50d8-99ec-06232fb5986f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{3}" :db/id #edb/ref 17592186052372} {:answer/id #uuid "ff6b8afa-5a1c-569d-bf7b-19d0f2a18923" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{20}{5}" :db/id #edb/ref 17592186052373} {:answer/id #uuid "3d27a309-0bbf-5fcd-9a6b-c774eac2658f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186052374} {:answer/id #uuid "65763377-79b8-5e41-b68f-947b8ca32f35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{20}{3}" :db/id #edb/ref 17592186052375}] :answer-field/correct {:answer/id #uuid "65763377-79b8-5e41-b68f-947b8ca32f35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{20}{3}" :db/id #edb/ref 17592186052375} :answer-field/id #uuid "8ad4a929-789a-52ff-93db-ed9f973cda83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186052370}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b53aeb0c-2291-515b-8b32-fdcd601499c7" :question/math-academy-id "q-2540" :question/problem "If $\\frac{x}{5}+2=\\frac{2}{3}$, then $x=$" :question/worked-solution "First, we apply the addition principle, subtracting $2$ from both sides of the equation:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{x}{5}+2 & =\\frac{2}{3} \\\\ \\frac{x}{5}+2-2 & =\\frac{2}{3}-2 \\\\ \\frac{x}{5}+0 & =\\frac{2}{3}-\\frac{6}{3} \\\\ \\frac{x}{5} & =-\\frac{4}{3}\\end{aligned}\\end{aligned}\n$$\n\nThen, we apply the multiplication principle, multiplying both sides of the equation by $5:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{x}{5} & =-\\frac{4}{3} \\\\ \\cancel{5}\\cdot \\frac{x}{\\cancel{5}} & =5\\cdot (-\\frac{4}{3}) \\\\ x & =-\\frac{20}{3}\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186055252 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2aaa916-a1f2-5a60-9a45-d8d24134d648" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The equation has no real solution" :db/id #edb/ref 17592186052753} {:answer/id #uuid "0ef944fe-b546-5c3c-bb66-e324e8c66a3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2" :db/id #edb/ref 17592186547348} {:answer/id #uuid "8610145b-97d5-54e0-93c8-3885eba86069" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-4" :db/id #edb/ref 17592186547604} {:answer/id #uuid "9b5ca04f-34a5-587c-b744-86213c713a80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{3}" :db/id #edb/ref 17592186547657} {:answer/id #uuid "a8fb8a27-2cb4-5bca-b2c7-af9e02db982d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{2}{3}" :db/id #edb/ref 17592186547688}] :answer-field/correct {:answer/id #uuid "a8fb8a27-2cb4-5bca-b2c7-af9e02db982d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{2}{3}" :db/id #edb/ref 17592186547688} :answer-field/id #uuid "6db1ca0c-24ea-50bb-aa50-3a7d8e46c64f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186052749}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e98c0c0b-7009-559f-859a-1e49b934344f" :question/math-academy-id "q-39821" :question/problem "Solve $\\sqrt{2-3x}=2.$" :question/worked-solution "Squaring both sides of the equation, we get\n\n$$\n\\begin{aligned}\\sqrt{2-3x} & =2 \\\\ {(\\sqrt{2-3x})}^{2} & ={2}^{2} \\\\ 2-3x & =4 \\\\ 3x & =-2 \\\\ x & =-\\frac{2}{3}.\\end{aligned}\n$$\n\nLet's check the result by plugging it into the original equation:\n\n$$\n\\begin{aligned}\\sqrt{2-3(-\\frac{2}{3})} & \\overset{?}{=}2 \\\\ \\sqrt{2-\\cancel{3}(-\\frac{2}{\\cancel{3}})} & \\overset{?}{=}2 \\\\ \\sqrt{2-(-2)} & \\overset{?}{=}2 \\\\ \\sqrt{2+2} & \\overset{?}{=}2 \\\\ \\sqrt{4} & \\overset{?}{=}2 \\\\ 2 & =2\\,\\,✓\\end{aligned}\n$$\n\nThe value $x=-\\frac{2}{3}$ satisfies the original equation, so we can accept it as a solution.\n\nTherefore, the solution to $\\sqrt{2-3x}=2$  is $x=-\\frac{2}{3}.$"} {:db/id #edb/ref 17592186055275 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "745105fd-229b-5e6f-ae8b-71fea9c217e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(-\\frac{2}{3})}^{4}" :db/id #edb/ref 17592186475610} {:answer/id #uuid "bee6716e-b700-549b-8677-746084d632a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(-\\frac{3}{2})}^{4}" :db/id #edb/ref 17592186475732} {:answer/id #uuid "d0e04115-2836-5f04-ba3d-8b76ed0dbce9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\times (-\\frac{2}{3})" :db/id #edb/ref 17592186475756} {:answer/id #uuid "d188df72-cda6-547b-bb15-98f82fd40b4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(-\\frac{2}{3})}^{1}" :db/id #edb/ref 17592186475760} {:answ