/id #uuid "6055b3d5-b381-57d8-89cf-b4f9ed481d72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\ln (x + \\sqrt{x^{2} + 1})" :db/id #edb/ref 17592186091791}] :answer-field/id #uuid "55562c11-e0fd-548c-a886-91f5d35d0e91" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186091786}] :question/id #uuid "b23dfa08-e01c-5e06-8af2-1c29da9bf4a8" :question/math-academy-id "q-9625" :question/problem "Using the definition of the hyperbolic sine, calculate $f^{-1}(x)$ given that $f(x) = \\sinh \\left(\\frac{x}{2}\\right)$."} {:db/id #edb/ref 17592186092933 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "879c89c3-5171-583a-9343-e8513c0d4e31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = 0" :db/id #edb/ref 17592186091799} {:answer/id #uuid "ad494ba7-45eb-5726-b0a7-c1897bdd6d02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = 2\\ln 2" :db/id #edb/ref 17592186091800} {:answer/id #uuid "c6d4e056-7218-5fc7-b6cb-a9b258ab73cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = \\ln 2" :db/id #edb/ref 17592186091801} {:answer/id #uuid "0466ff63-c225-52a0-ad07-3a117e153092" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = \\ln \\left(\\frac{1}{2}\\right)" :db/id #edb/ref 17592186091802} {:answer/id #uuid "46dd08cc-7f94-5739-92f9-4f0c8f35c0e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = 2\\ln 3" :db/id #edb/ref 17592186091803}] :answer-field/id #uuid "44812e58-6355-5787-8405-9079c4a920d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186091798}] :question/id #uuid "e0cbef21-3288-5851-a7ab-b07add8c1058" :question/math-academy-id "q-9673" :question/problem "Find the real solution to the equation $2\\cosh x + 3\\sinh x = 2$."} {:db/id #edb/ref 17592186092934 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "832d7519-0519-55e6-9765-db7af5246723" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = \\ln \\left(\\frac{1}{3}\\right), x = \\ln 2" :db/id #edb/ref 17592186091805} {:answer/id #uuid "a8a5b183-9423-5dc9-b30a-3782e2ebd51a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = \\ln \\left(\\frac{1}{2}\\right), x = \\ln 3" :db/id #edb/ref 17592186091806} {:answer/id #uuid "efc611a4-32a4-5b97-9268-1c49e3eb4e6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = \\ln \\left(\\frac{1}{4}\\right), x = \\ln \\left(\\frac{1}{5}\\right)" :db/id #edb/ref 17592186091807} {:answer/id #uuid "f3e1003f-af00-528f-bff4-7c8af221c6d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = \\ln \\left(\\frac{1}{2}\\right), x = \\ln 2" :db/id #edb/ref 17592186091808} {:answer/id #uuid "25854173-bd25-5b66-8da2-0c2284a8540e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = \\ln 4, x = \\ln 5" :db/id #edb/ref 17592186091809}] :answer-field/id #uuid "3d982398-182d-5c16-a947-acb2ea5f30c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186091804}] :question/id #uuid "deb5ee5c-a8a4-57c6-87b6-20304b0b37a7" :question/math-academy-id "q-9679" :question/problem "Find the real solutions to the equation $4\\cosh x = 5$."} {:db/id #edb/ref 17592186096380 :question/id #uuid "fdf149d5-0139-5291-ab72-c070fb6a4a6e" :question/math-academy-id "e-10901" :question/problem "Given that $r=\\sin\\theta$ for $\\theta = \\theta(t),$ and that $\\dfrac{\\textrm d r}{\\textrm d t}=\\sqrt{2}$ at the point where $\\theta=\\dfrac{\\pi}{4},$ find $\\dfrac{\\textrm d \\theta}{\\textrm d t}.$" :question/worked-solution "Differentiating the given relation with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}r & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{\\text{d}}{\\text{d}t}(r) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡\\theta ) \\\\ \\frac{\\text{d}r}{\\text{d}t} & =\\frac{\\text{d}\\theta }{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{sin}⁡\\theta ) \\\\ \\frac{\\text{d}r}{\\text{d}t} & =\\frac{\\text{d}\\theta }{\\text{d}t}\\cdot \\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nNow we can substitute the given information $\\dfrac{\\textrm d r}{\\textrm d t}=\\sqrt{2}$ and $\\theta=\\dfrac{\\pi}{4},$ and solve for $\\dfrac{\\textrm d \\theta}{\\textrm d t}.$ We get\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}t} & =\\frac{\\text{d}\\theta }{\\text{d}t}\\cdot \\operatorname{cos}⁡\\theta  \\\\ \\sqrt{2} & =\\frac{\\text{d}\\theta }{\\text{d}t}\\cdot \\operatorname{cos}⁡\\left(\\frac{\\pi }{4}\\right) \\\\ \\sqrt{2} & =\\frac{\\text{d}\\theta }{\\text{d}t}\\cdot \\frac{\\sqrt{2}}{2} \\\\ \\frac{\\text{d}\\theta }{\\text{d}t} & =\\sqrt{2}\\cdot \\frac{2}{\\sqrt{2}} \\\\ \\frac{\\text{d}\\theta }{\\text{d}t} & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186096389 :question/id #uuid "ff844be7-7d1e-5a1f-a4d6-1d4313f5fd2d" :question/math-academy-id "e-14006" :question/problem "Find the solution to the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}5a+\\frac{3b}{2} &=2 \\\\ \\frac{4a}{3}+2b &=0\\end{aligned}\\right.\n$$" :question/worked-solution "To get rid of the fractions, we multiply the first equation by $2$ and the second equation by $3,$ as follows:\n\n$$\n\\left\\{\\begin{aligned}5a+\\frac{3b}{2} &=2 && |\\,\\times 2 \\\\ \\frac{4a}{3}+2b &=0 && |\\,\\times 3\\end{aligned}\\right.\n$$\n\nWe will use the elimination method to solve the system. Notice that if we multiply the first equation by $-2,$ then we will get a $-6b$ term that can cancel with the $6b$ term in the second equation:\n\n$$\n\\left\\{\\begin{aligned}10a+3b &=4 && |\\,\\times (-2) \\\\ 4a+6b &=0 && \\end{aligned}\\right.\n$$\n\nAdding the two equations eliminates the $b$-variable, and allows us to solve for $a\\mathbin{:}$\n\n$$\n\\begin{aligned}-20a-\\cancel{6b} & =-8 \\\\ 4a+\\cancel{6b} & =0 \\\\ (-20a+4a) & =(-8+0) \\\\ -16a & =-8 \\\\ a & =\\frac{-8}{-16} \\\\ a & =\\frac{1}{2}\\end{aligned}\n$$\n\nFinally, we can substitute $a=\\dfrac{1}{2}$ into the equation $4a+6b=0$ to solve for $b\\mathbin{:}$\n\n$$\n\\begin{aligned}4a+6b & =0 \\\\ 4\\left(\\frac{1}{2}\\right)+6b & =0 \\\\ 2+6b & =0 \\\\ 6b & =-2 \\\\ b & =-\\frac{2}{6} \\\\ b & =-\\frac{1}{3}\\end{aligned}\n$$\n\nThus, the solution to the system of equations is $a = \\dfrac{1}{2}, \\,b =-\\dfrac{1}{3}.$"} {:db/id #edb/ref 17592186096391 :question/id #uuid "a83c1301-18cf-5622-8a4a-73f9d18e36b8" :question/math-academy-id "e-14260" :question/problem "The formula $M(t)=128 \\cdot \\left(\\dfrac{1}{4} \\right)^{t}$ gives the mass (in grams) of a radioactive calcium isotope after $t$ years.\nWhat mass of isotope remains after $3$ years?" :question/worked-solution "To get the mass of the isotope after $3$ years, we evaluate the function at $t=3.$ Substituting $t=3$ into the function $M(t)$ gives\n\n$$\n\\begin{aligned}M & =128{\\left(\\frac{1}{4}\\right)}^{t} \\\\  & =128{\\left(\\frac{1}{4}\\right)}^{3} \\\\  & =128\\cdot \\frac{{1}^{3}}{{4}^{3}} \\\\  & =128\\cdot \\frac{1}{64} \\\\  & =\\frac{128}{64} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, after $3$ years, there will be $2$ grams of isotope remaining."} {:db/id #edb/ref 17592186096392 :question/id #uuid "ca8cd4d6-8136-59bb-a033-6ba9ae8c06ed" :question/math-academy-id "e-14262" :question/problem "Solve for $C$ given that $y(t) = C \\cdot \\left(\\dfrac{1}{2}\\right)^{t}$ and $y(5)=1.$" :question/worked-solution "We substitute $t=5$ and $y(t)=1$ into the expression for $y(t),$ and get\n\n$$\n\\begin{aligned}1 & =C\\cdot {\\left(\\frac{1}{2}\\right)}^{5} \\\\ 1 & =C\\cdot \\frac{{1}^{5}}{{2}^{5}} \\\\ 1 & =C\\cdot \\frac{1}{32} \\\\ 1\\cdot 32 & =C \\\\ 32 & =C.\\end{aligned}\n$$\n\nTherefore, $C=32.$"} {:db/id #edb/ref 17592186096408 :question/id #uuid "557b1b6e-c54a-5fa9-85e1-3cea346c3bd3" :question/math-academy-id "e-3543" :question/problem "Write $3\\sin x-2\\cos x$ in the form $R\\sin(x-\\phi)$ with $\\phi \\in \\left( 0, \\dfrac{\\pi}{2} \\right)$. Round $\\phi$ to $3$ decimal places." :question/worked-solution "The difference formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x-ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ-\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x-R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n3 \\sin x - 2 \\cos x    = R\\sin(x-\\phi) ,\n$$\n\nwe get the following identity:\n\n$$\n3 \\sin x - 2 \\cos x   = (R \\cos \\phi ) \\sin x - (R \\sin \\phi )\\cos x\n$$\n\nEquating the coefficients of $\\sin x$ and $\\cos x,$ we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}R\\operatorname{cos}⁡ϕ &=3 \\\\ R\\operatorname{sin}⁡ϕ &=2\\end{aligned}\\right.\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{2}{3} \\\\ \\operatorname{tan}⁡ϕ & =\\frac{2}{3} \\\\ ϕ & =\\operatorname{arctan}⁡\\left(\\frac{2}{3}\\right) \\\\  & ≈0.588\\,\\text{rad}\\end{aligned}\n$$\n\nrounded to three decimal places.\n\nNow, we find the amplitude $R.$ Squaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{cos}⁡ϕ)}^{2}+{(R\\operatorname{sin}⁡ϕ)}^{2} & =(3)^{2}+(2)^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =9+4 \\\\ {R}^{2} & =13 \\\\ R & =\\sqrt{13}.\\end{aligned}\n$$\n\nNote that we only considered the positive root, since $R>0.$\n\nFinally, we can write the initial expression in amplitude-phase form as follows:\n\n$$\n3\\sin(x)-2\\cos(x) \\approx \\sqrt{13} \\sin \\left(x - 0.588 \\right)\n$$"}]
