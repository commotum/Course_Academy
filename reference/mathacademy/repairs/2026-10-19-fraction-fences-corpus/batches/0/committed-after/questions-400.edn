er-field/choices [{:answer/id #uuid "bbead542-d753-5b46-9d05-7809a93bcff0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\ln \\left(\\frac{7 - u}{7 + u}\\right)" :db/id #edb/ref 17592186091757} {:answer/id #uuid "241d998d-54b4-5b77-9039-44d506437224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\ln \\left(\\frac{7u + 1}{7u - 1}\\right)" :db/id #edb/ref 17592186091758} {:answer/id #uuid "498638b3-a272-5a26-a609-7e707dc7024b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\ln \\left(\\frac{u + 7}{u - 7}\\right)" :db/id #edb/ref 17592186091759} {:answer/id #uuid "4f88bbbe-0992-50b1-a850-a6b97af484db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\ln \\left(\\frac{u - 7}{u + 7}\\right)" :db/id #edb/ref 17592186091760} {:answer/id #uuid "651ee9c6-3503-52d5-8bc1-553eb636d13d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\ln \\left(\\frac{u + 7}{7 - u}\\right)" :db/id #edb/ref 17592186091761}] :answer-field/id #uuid "d374882f-4778-551b-b1fe-f816c5440eac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186091756}] :question/id #uuid "502fc288-40d5-53a0-89bc-4f72b012ddda" :question/math-academy-id "q-95620" :question/problem "Given that $u ∈ (-7, 7)$, which of the following is equivalent to $artanh \\left(-\\frac{u}{7}\\right)$?"} {:db/id #edb/ref 17592186092929 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83208a45-1944-502a-be7d-8ac652ff6834" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\ln 2" :db/id #edb/ref 17592186091775} {:answer/id #uuid "970438ba-6445-5a1a-9e2c-4f8d68b26e6f" :answer/type {:db/id #edb/ref 17592186045498 :db/id