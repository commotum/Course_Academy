 {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186062713}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6c3cdbb7-2f20-5471-9a71-577081e6a156" :question/math-academy-id "q-43479" :question/problem "$\\frac{3}{\\left(\\frac{7}{3}\\right)}=$" :question/worked-solution "First, remember that a fraction represents a division:\n\n$$\n\\begin{aligned}\\frac{3}{\\left(\\frac{7}{3}\\right)}=3÷\\frac{7}{3}\\end{aligned}\n$$\n\nNow, recall that $3=\\frac{3}{1}$ and dividing by $\\frac{7}{3}$ is the same as multiplying by its reciprocal $\\frac{3}{7}.$ We can use these facts to simplify the fraction above:  \n\n$$\n\\begin{aligned}3÷\\frac{7}{3} &= \\frac{3}{1}\\times \\frac{3}{7} \\\\ &= \\frac{3\\times 3}{1\\times 7} \\\\ &= \\frac{9}{7}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{3}{\\left(\\frac{7}{3}\\right)}=\\frac{9}{7}.\n$$"} {:db/id #edb/ref 17592186064777 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f37700ab-e240-588d-ae75-9ea2ef7b6b2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186062720} {:answer/id #uuid "086fe724-048b-56da-946a-2b75d4df6cf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16}{5}" :db/id #edb/ref 17592186062721} {:answer/id #uuid "09e9167f-64a5-59ce-b693-e90173c764d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186062722} {:answer/id #uuid "1c42f820-3c55-5a76-9d21-d2761b8cecef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186062723} {:answer/id #uuid "4bb0596b-8e40-5e37-a70e-ab1a3a3a0dc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{16}" :db/id #edb/ref 17592186062724}] :answer-field/id #uuid "