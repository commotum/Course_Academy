d.type/checkbox} :db/id #edb/ref 17592186477568} {:answer-field/choices [{:answer/id #uuid "a0a3ef07-c7ae-5f79-a278-96cf3a6afeb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477199} {:answer/id #uuid "7cf09ba6-a8e3-5984-a169-e863ad9ec44b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477200}] :answer-field/correct {:answer/id #uuid "a0a3ef07-c7ae-5f79-a278-96cf3a6afeb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477199} :answer-field/id #uuid "b487b83d-f170-53d4-a600-612f5bb14a90" :answer-field/key "The global minimum value is $e-2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477569} {:answer-field/choices [{:answer/id #uuid "7075c86b-5a37-5b8a-9198-9df0fae9f1ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477201} {:answer/id #uuid "28638f72-40f2-5e2a-b417-e7841b921eda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477202}] :answer-field/correct {:answer/id #uuid "28638f72-40f2-5e2a-b417-e7841b921eda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477202} :answer-field/id #uuid "d89d5c80-1038-555d-85ba-6e8abe9bb00b" :answer-field/key "The global minimum value is $2-2\\operatorname{ln}⁡2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477570}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "542cb4a0-6380-5eaf-91e8-44f9300f10c9" :question/math-academy-id "q-22428" :question/problem "For the function $f(x)=x-2\\operatorname{ln}⁡x,$ defined on the closed interval $\\frac{1}{2}\\le x\\le e,$ which of the following statements are true?\n\nSelect all that apply." :question/requires-calculator true :question/worked-solution "Let's apply the candidates test step by step.\n\n**Step 1**: We find the critical points. Taking the derivative of $f(x)=x-2\\operatorname{ln}⁡x,$ we get\n\n$$\n{f}^{′}(x)=1-\\frac{2}{x},\n$$\n\nand solving ${f}^{′}(x)=0,$ we get \n\n$$\n1-\\frac{2}{x}=0\\,⟹\\,x=2.\n$$\n\nSo, the critical points are $x=2,$ and the endpoints $x=\\frac{1}{2},e$ (since the derivative is not defined at the endpoints).\n\n**Step 2**: We evaluate $f(x)$ at the critical points.\n\n$$\n\\begin{aligned}f\\left(\\frac{1}{2}\\right) & =\\frac{1}{2}-2\\operatorname{ln}⁡\\left(\\frac{1}{2}\\right)=\\frac{1}{2}+2\\operatorname{ln}⁡2≈1.9 \\\\ f(2) & =2-2\\operatorname{ln}⁡2≈0.6 \\\\ f(e) & =e-2\\operatorname{ln}⁡e=e-2≈0.7\\end{aligned}\n$$\n\n**Step 3**: We compare all of the values found in step $2.$\n\n- The greatest value is $f\\left(\\frac{1}{2}\\right)=\\frac{1}{2}+2\\operatorname{ln}⁡2,$ so the global maximum is $\\frac{1}{2}+2\\operatorname{ln}⁡2.$\n\n- The smallest value is $f(2)=2-2\\operatorname{ln}⁡2,$ so the global minimum is $2-2\\operatorname{ln}⁡2.$\n\nTherefore, the correct answer is, “The global maximum value is $\\frac{1}{2}+2\\operatorname{ln}⁡2$”; “The global minimum value is $2-2\\operatorname{ln}⁡2$” only.\n\n![](images/6c/6cc3ee476c8c5dc9e27051c990b184318147caffd2177b760074172fe5c667f6.png)"} {:db/id #edb/ref 17592186064630 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "920d4d13-754e-5214-bfce-fdc94f31a710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A(t) = 30 + 7t^{2}" :db/id #edb/ref 17592186061838} {:answer/id #uuid "f1a84dfd-88e4-59fb-8f17-248b886f7c12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A(t) = 60 + \\frac{7t^{2}}{2}" :db/id #edb/ref 17592186061839} {:answer/id #uuid "31896d01-19c7-5b08-9a93-15ac42601af4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A(t) = 60 + 4t + \\frac{7t^{2}}{2}" :db/id #edb/ref 17592186061840} {:answer/id #uuid "51e82019-b203-51f6-9c82-fd7ab7ea1c28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A(t) = 30 + 3t + 7t^{2}" :db/id #edb/ref 17592186061841} {:answer/id #uuid "63c79325-f9d2-5988-a06f-fbada2bdc0f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A(t) = 60 + 3t + \\frac{7t^{2}}{2}" :db/id #edb/ref 17592186061842}] :answer-field/id #uuid "6ba875f6-005a-52f0-8758-0845772dde06" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186061837} {:answer-field/choices [{:answer/id #uuid "7a0bfd6f-0393-52a3-adcb-570965c3ef8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A(t)=60+4t+\\frac{7{t}^{2}}{2}" :db/id #edb/ref 17592186376970} {:answer/id #uuid "9cb888a1-a8a8-5a6b-8d50-4f1d641be19a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A(t)=30+7{t}^{2}" :db/id #edb/ref 17592186376971} {:answer/id #uuid "ab293ea6-5e6f-5daa-a0db-3ada6cc01667" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A(t)=30+3t+7{t}^{2}" :db/id #edb/ref 17592186376972} {:answer/id #uuid "08b72c7a-9786-5919-aeee-8b02a61b5765" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A(t)=60+3t+\\frac{7{t}^{2}}{2}" :db/id #edb/ref 17592186376973} {:answer/id #uuid "7666b1f9-f65b-597f-94dc-c60206cc4f38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A(t)=60+\\frac{7{t}^{2}}{2}" :db/id #edb/ref 17592186376974}] :answer-field/correct {:answer/id #uuid "7666b1f9-f65b-597f-94dc-c60206cc4f38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A(t)=60+\\frac{7{t}^{2}}{2}" :db/id #edb/ref 17592186376974} :answer-field/id #uuid "4cf45d3a-61ac-50ff-b181-ea7017af6346" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186376969}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2244b049-87e6-5f96-ad15-413c07cd239d" :question/math-academy-id "q-2368" :question/problem "Cars are entering a traffic jam at a rate of $7t$ cars per minute. If at time $t=0$ there are $60$ cars in the traffic jam, write an expression for $A(t),$ the total number of cars caught up in the traffic jam at time $t,$ where $t$ is the time measured in minutes." :question/requires-calculator true :question/worked-solution "Let $f(t)=7t$ be the rate at which the cars enter the traffic jam, and let $A(T)$ be the total number of cars in the traffic jam after $T$ minutes.\n\nUsing our formula for the accumulation of change, we have\n\n$$\nA(T)=A(0)+{\\int }_{0}^{T}f(t)\\,\\text{d}t.\n$$\n\nSubstituting the known information and carrying out the necessary integration gives\n\n$$\n\\begin{aligned}A(T) & =A(0)+{\\int }_{0}^{T}f(t)\\,\\text{d}t \\\\  & =60+{\\int }_{0}^{T}7t\\,\\text{d}t \\\\  & ={60+\\left(\\frac{7{t}^{2}}{2}\\right)|}_{0}^{T} \\\\  & =60+\\frac{7{T}^{2}}{2}.\\end{aligned}\n$$\n\nFinally, let's rewrite our final answer in terms of the original variable $t.$ We have\n\n$$\nA(t)=60+\\frac{7{t}^{2}}{2}.\n$$"} {:db/id #edb/ref 17592186064708 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93901f5c-277d-51ed-a24c-3450d156bf1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186062306} {:answer/id #uuid "abebb26e-b1a5-51a5-be19-0ffecaaa776f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186062307