 "6b7347c5-9c24-53ba-ae9d-867009e5aca2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332398}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5f71f24a-4751-5945-a98f-4a541dbf6232" :question/math-academy-id "q-49275" :question/problem "Calculate $\\int \\frac{{tan}^{2}⁡x}{8{sin}^{2}⁡x}\\,\\text{d}x.$" :question/worked-solution "We can write the integral as\n\n$$\n\\int \\frac{{tan}^{2}⁡x}{8{sin}^{2}⁡x}\\,\\text{d}x=\\frac{1}{8}\\int {tan}^{2}⁡x\\cdot \\frac{1}{{sin}^{2}⁡x}\\,\\text{d}x.\n$$\n\nWe then use the fact that $\\operatorname{tan}⁡x=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}$ and $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}.$ Therefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{{tan}^{2}⁡x}{8{sin}^{2}⁡x}\\,\\text{d}x & =\\frac{1}{8}\\int {tan}^{2}⁡x\\cdot \\frac{1}{{sin}^{2}⁡x}\\,\\text{d}x \\\\  & =\\frac{1}{8}\\int {\\left(\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\right)}^{2}\\cdot \\frac{1}{{sin}^{2}⁡x}\\,\\text{d}x \\\\  & =\\frac{1}{8}\\int \\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x}\\cdot \\frac{1}{{sin}^{2}⁡x}\\,\\text{d}x \\\\  & =\\frac{1}{8}\\int \\frac{1}{{cos}^{2}⁡x}\\,\\text{d}x \\\\  & =\\frac{1}{8}\\int {\\left(\\frac{1}{\\operatorname{cos}⁡x}\\right)}^{2}\\text{d}x \\\\  & =\\frac{1}{8}\\int {sec}^{2}⁡x\\,\\text{d}x \\\\  & =\\frac{1}{8}\\operatorname{tan}⁡x+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064863 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5d52e52-f1a2-59dc-bf82-d2da6e8ffe27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4 + \\ln 2" :db/id #edb/ref 17592186063235} {:answer/id #uuid "34622a40-e686-5ad8-b66c-563de60b5734" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 + \\ln 4" :db/id #edb/ref 17592186063236} {:answer