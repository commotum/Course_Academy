/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}\\tanh \\left(\\frac{2x}{5}\\right)sech \\left(\\frac{2x}{5}\\right) + C" :db/id #edb/ref 17592186165503} {:answer/id #uuid "227afb1e-6eca-5bb2-a3d1-ef8393dd4fe9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}\\tanh \\left(\\frac{2x}{5}\\right) + C" :db/id #edb/ref 17592186165504} {:answer/id #uuid "748b12b0-adef-55ab-b72c-4e206023529f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5\\tanh \\left(\\frac{5x}{2}\\right) + C" :db/id #edb/ref 17592186165505}] :answer-field/id #uuid "c876c1e5-5c64-5eb8-9427-add64a01cbf2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165500}] :question/id #uuid "cf5a74bd-f5d8-5f29-8b73-d0a5a5b3d563" :question/math-academy-id "q-95534" :question/problem "Calculate the integral $\\intsech^{2} \\left(\\frac{2x}{5}\\right)dx$."} {:db/id #edb/ref 17592186167388 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8063afd-cce4-5f74-8b83-ed3718477fe7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ln \\left(\\frac{2}{3}\\right)" :db/id #edb/ref 17592186165537} {:answer/id #uuid "d8be87a3-a5b1-5bc3-a6f3-2795511c39cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ln 4" :db/id #edb/ref 17592186165538} {:answer/id #uuid "e1092a83-a319-5239-960f-77cc3317bd0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\ln \\left(\\frac{4}{5}\\right)" :db/id #edb/ref 17592186165539} {:answer/id #uuid "244e914d-507d-5932-8738-e54884b4cd79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ln \\left(\\frac{5}{4}\\right)" :db/id #edb/ref 17592186165540} {:answer/id #uuid "5f294880-361d-558c-b01a-1c