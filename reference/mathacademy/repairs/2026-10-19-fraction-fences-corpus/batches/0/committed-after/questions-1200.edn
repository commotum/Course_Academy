3b-5336-80a3-305b2a62ee6b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165656}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "73150534-b7bb-5cf7-bc82-812c547a0e7e" :question/math-academy-id "q-95837" :question/problem "Calculate $\\int \\frac{{coth}^{2}⁡x}{{sinh}^{2}⁡x+1}\\,\\text{d}x.$" :question/worked-solution "First, we find the hyperbolic identity that corresponds to the Pythagorean identity \n\n$$\n{cos}^{2}⁡x+{sin}^{2}⁡x=1.\n$$\n\nUsing Osborn's rule, we get the hyperbolic Pythagorean identity\n\n$$\n{cosh}^{2}⁡x-{sinh}^{2}⁡x=1.\n$$\n\nAdditionally, we have\n\n$$\n\\operatorname{coth}⁡x=\\frac{\\operatorname{cosh}⁡x}{\\operatorname{sinh}⁡x}.\n$$\n\nUsing the above, we rewrite the denominator and calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int \\frac{{coth}^{2}⁡x}{{sinh}^{2}⁡x+1}\\,\\text{d}x & =\\int \\frac{{coth}^{2}⁡x}{{cosh}^{2}⁡x-1+1}\\text{d}x \\\\  & =\\int \\frac{{coth}^{2}⁡x}{{cosh}^{2}⁡x}\\,\\text{d}x \\\\  & =\\int \\frac{\\left(\\frac{{cosh}^{2}⁡x}{{sinh}^{2}⁡x}\\right)}{{cosh}^{2}⁡x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{{sinh}^{2}⁡x}\\,\\text{d}x \\\\  & =\\int {csch}^{2}⁡x\\,\\text{d}x \\\\  & =-\\operatorname{coth}⁡x+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186167419 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d3ae801-57c5-5791-9c38-7c7bf1661954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sinh}⁡1-1" :db/id #edb/ref 17592186537251} {:answer/id #uuid "89fa846f-c2dc-59c0-bbf7-8bcd7e2a6c99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sinh}⁡1-1" :db/id #edb/ref 17592186537492} {:answer/id #uuid "9872ca05-e4a0-5b63-a020-31c95419fd24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sinh}⁡1-1" :db/id #edb/ref 17592186537518} {:answer/id #uuid "c4e43ea6-56f9-53d9-be2b-45a9e8207c49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sinh}⁡1+1" :db/id #edb/ref 17592186537609} {:answer/id #uuid "d34fba1f-7a19-51e8-9fc1-a8d8f2c1ef38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sinh}⁡1+\\frac{1}{2}" :db/id #edb/ref 17592186537645}] :answer-field/correct {:answer/id #uuid "c4e43ea6-56f9-53d9-be2b-45a9e8207c49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sinh}⁡1+1" :db/id #edb/ref 17592186537609} :answer-field/id #uuid "e609e883-1558-50e2-a2ac-f01133148f75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165722}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f84738b9-eab0-5de7-ad81-984eef57a947" :question/math-academy-id "q-95874" :question/problem "${\\int }_{0}^{1}({cosh}^{2}⁡\\left(\\frac{x}{2}\\right)+{sinh}^{2}⁡\\left(\\frac{x}{2}\\right)+2x)\\,\\text{d}x=$" :question/worked-solution "First, we find the hyperbolic identity that corresponds to the following double-angle formula for cosine: \n\n$$\n\\operatorname{cos}⁡2\\theta ={cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta .\n$$\n\nUsing Osborn's rule, we get the following double-angle formula for the hyperbolic cosine:\n\n$$\n\\operatorname{cosh}⁡2\\theta ={cosh}^{2}⁡\\theta +{sinh}^{2}⁡\\theta .\n$$\n\nLetting $\\theta =\\frac{x}{2},$ we get\n\n$$\n\\operatorname{cosh}⁡x={cosh}^{2}⁡\\left(\\frac{x}{2}\\right)+{sinh}^{2}⁡\\left(\\frac{x}{2}\\right).\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}({cosh}^{2}⁡\\left(\\frac{x}{2}\\right)+{sinh}^{2}⁡\\left(\\frac{x}{2}\\right)+2x)\\,\\text{d}x & ={\\int }_{0}^{1}(\\operatorname{cosh}⁡x+2x)\\,\\text{d}x \\\\  & ={(\\operatorname{sinh}⁡x+{x}^{2})|}_{0}^{1} \\\\  & =[\\operatorname{sinh}⁡1+{1}^{2}]-[\\operatorname{sinh}⁡0+{0}^{2}] \\\\  & =\\operatorname{sinh}⁡1+1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186167423 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cc2b533-3957-5d81-8ade-4b73fc761014" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\ln 3}{8}" :db/id #edb/ref 17592186165747} {:answer/id #uuid "9f068152-5f6f-5494-a04d-61bc926fb5b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186165748} {:answer/id #uuid "b8e4f4f2-6061-5b85-9acc-927ffd786c83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\ln 3}{3}" :db/id #edb/ref 17592186165749} {:answer/id #uuid "e3d87dd1-5687-5ca0-84e0-6027a5bf971a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186165750} {:answer/id #uuid "6c415bed-5374-5d79-8577-a94aa57a9279" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186165751}] :answer-field/id #uuid "48e8f269-7985-5500-94b1-33292e498412" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165746}] :question/id #uuid "12e461d1-2df9-50e0-87ff-2785e98ed21c" :question/math-academy-id "q-95881" :question/problem "Evaluate $\\displaystyle \\int_{0}^{\\ln 3}(4\\sinh^{2} \\left(\\frac{x}{2}\\right) + 2)dx$."} {:db/id #edb/ref 17592186167434 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11c72aed-2f1d-591b-bc3b-b752ede408b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}\\operatorname{arsech}⁡\\left(\\frac{3x-1}{3}\\right)+C" :db/id #edb/ref 17592186538274} {:answer/id #uuid "29890455-6ae9-5148-b652-040930f8a666" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{18}\\operatorname{arcsch}⁡\\left(\\frac{3x-1}{3}\\right)+C" :db/id #edb/ref 17592186538320} {:answer/id #uuid "7d57b259-4c0c-5d0c-aafc-42e8ea0a1ab3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{18}\\operatorname{arcsch}⁡(3x-1)+C" :db/id #edb/ref 17592186538518} {:answer/id #uuid "a93b94ff-8a35-57fb-9c5d-28f6c673d961" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{9}\\operatorname{arcsch}⁡(3x-1)+C" :db/id #edb/ref 17592186538632} {:answer/id #uuid "adc66bf6-9610-5424-b2cc-2f08ea59b274" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{18}\\operatorname{arsech}⁡\\left(\\frac{3x-1}{3}\\right)+C" :db/id #edb/ref 17592186538641}] :answer-field/correct {:answer/id #uuid "29890455-6ae9-5148-b652-040930f8a666" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{18}\\operatorname{arcsch}⁡\\left(\\frac{3x-1}{3}\\right)+C" :db/id #edb/ref 17592186538320} :answer-field/id #uuid "0868a8f4-18a1-5876-a50c-b8b68ef0f30e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165812}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "277cde94-a375-546d-bd1f-19d53d382abd" :question/math-academy-id "q-95975" :question/problem "Calculate $\\int \\frac{\\text{d}x}{|6x-2|\\sqrt{9+(3x-1)^{2}}}.$" :question/worked-solution "First, we note that\n\n$$\n\\int \\frac{\\text{d}x}{|6x-2|\\sqrt{9+(3x-1)^{2}}}=\\int \\frac{\\text{d}x}{6|x-\\frac{1}{3}|\\sqrt{9+9{(x-\\frac{1}{3})}^{2}}}=\\frac{1}{18}\\int \\frac{1}{|x-\\frac{1}{3}|\\sqrt{1+{(x-\\frac{1}{3})}^{2}}}\\text{d}x.\n$$\n\nLet $u=x-\\frac{1}{3}.$ Then, we have \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{18}\\int \\frac{1}{|x-\\frac{1}{3}|\\sqrt{1+{(x-\\frac{1}{3})}^{2}}}\\text{d}x & =\\frac{1}{18}\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\text{d}u \\\\  & =-\\frac{1}{18}\\operatorname{arcsch}⁡u+C \\\\  & =-\\frac{1}{18}\\operatorname{arcsch}⁡(x-\\frac{1}{3})+C \\\\  & =-\\frac{1}{18}\\operatorname{arcsch}⁡\\left(\\frac{3x-1}{3}\\right)+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186167437 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1700c4a5-52d0-5037-8796-caf2ee62ae0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{arcoth}⁡\\left(\\frac{x+4}{3}\\right)+C" :db/id #edb/ref 17592186538283} {:answer/id #uuid "3611fbe1-57c9-53e2-8603-e04f4f8be16d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{arcoth}⁡(x+4)+C" :db/id #edb/ref 17592186538342} {:answer/id #uuid "588606f2-b50e-582f-b36f-92ef91f044f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{arcoth}⁡\\left(\\frac{x+4}{3}\\right)+C" :db/id #edb/ref 17592186538421} {:answer/id #uuid "65595378-37db-5a80-bfa3-54226b604247" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{9}\\operatorname{arcoth}⁡\\left(\\frac{x+4}{3}\\right)+C" :db/id #edb/ref 17592186538458} {:answer/id #uuid "7b2b86f9-de8e-5b00-a2c6-4eb089bfc6de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{arcoth}⁡\\left(\\frac{x+4}{3}\\right)+C" :db/id #edb/ref 17592186538516}] :answer-field/correct {:answer/id #uuid "1700c4a5-52d0-5037-8796-caf2ee62ae0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{arcoth}⁡\\left(\\frac{x+4}{3}\\right)+C" :db/id #edb/ref 17592186538283} :answer-field/id #uuid "e3ad98b8-75f7-532b-b3de-b7d223439b8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165830}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2d619ef2-7b28-5e2f-b9a5-764feebd0f07" :question/math-academy-id "q-95978" :question/problem "Calculate $\\int \\frac{1}{9-(x+4)^{2}}\\,\\text{d}x=$" :question/worked-solution "First, we note that\n\n$$\n\\int \\frac{1}{9-(x+4)^{2}}\\,\\text{d}x=\\int \\frac{1}{9-9(\\frac{1}{9}(x+4)^{2})}\\,\\text{d}x=\\frac{1}{9}\\int \\frac{1}{1-{(\\frac{1}{3}(x+4))}^{2}}\\,\\text{d}x.\n$$\n\nLet $u=\\frac{1}{3}(x+4).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}x=3\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{9}\\int \\frac{1}{1-{(\\frac{1}{3}(x+4))}^{2}}\\,\\text{d}x & =\\frac{1}{9}\\int \\frac{1}{1-{u}^{2}}\\,\\cdot 3\\,\\text{d}u \\\\  & =\\frac{3}{9}\\cdot \\operatorname{arcoth}⁡u+C \\\\  & =\\frac{1}{3}\\operatorname{arcoth}⁡\\left(\\frac{x+4}{3}\\right)+C.\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|\\frac{x+4}{3}|>1.$"} {:db/id #edb/ref 17592186167438 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fbf49c6-7dc7-5262-b85d-d6fa879d4450" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{arcoth}⁡\\left(\\frac{x+2}{\\sqrt{5}}\\right)+C" :db/id #edb/ref 17592186538270} {:answer/id #uuid "808b6e4f-b16c-570c-99c7-b1e3de33c4a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}\\operatorname{arcoth}⁡\\left(\\frac{x+2}{\\sqrt{5}}\\right)+C" :db/id #edb/ref 17592186538526} {:answer/id #uuid "b51af6ea-46da-5bba-a5c9-65a857bf09c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{arcoth}⁡\\left(\\frac{x+2}{5}\\right)+C" :db/id #edb/ref 17592186538654} {:answer/id #uuid "bbf230ca-7c00-5a91-b46e-ec016a126ff3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5}\\operatorname{arcoth}⁡\\left(\\frac{x+2}{5}\\right)+C" :db/id #edb/ref 17592186538675} {:answer/id #uuid "c50775eb-d6ce-5b1a-9822-5f69ba8712d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{5}}{5}\\operatorname{arcoth}⁡\\left(\\frac{x+2}{5}\\right)+C" :db/id #edb/ref 17592186538690}] :answer-field/correct {:answer/id #uuid "808b6e4f-b16c-570c-99c7-b1e3de33c4a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}\\operatorname{arcoth}⁡\\left(\\frac{x+2}{\\sqrt{5}}\\right)+C" :db/id #edb/ref 17592186538526} :answer-field/id #uuid "ef67831c-26a5-58b1-b680-ba64dc4472e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165836}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "51eaef16-8f72-5d8b-80be-64ea8ef24070" :question/math-academy-id "q-95979" :question/problem "$\\int \\frac{1}{1-4x-{x}^{2}}\\text{d}x=$" :question/worked-solution "First, we complete the square for the denominator:\n\n$$\n\\begin{aligned}1-4x-{x}^{2} & =-({x}^{2}+4x-1) \\\\  & =-({x}^{2}+2\\cdot 2x+{2}^{2}-{2}^{2}-1) \\\\  & =-((x+2)^{2}-5) \\\\  & =5-(x+2)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the denominator of our integral, we get\n\n$$\n\\int \\frac{1}{1-4x-{x}^{2}}\\text{d}x=\\int \\frac{1}{5-(x+2)^{2}}\\text{d}x=\\frac{1}{5}\\int \\frac{1}{1-{(\\frac{1}{\\sqrt{5}}(x+2))}^{2}}\\text{d}x.\n$$\n\nLet $u=\\frac{1}{\\sqrt{5}}(x+2).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{\\sqrt{5}}\\,⟹\\,\\text{d}x=\\sqrt{5}\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{5}\\int \\frac{1}{1-{(\\frac{1}{\\sqrt{5}}(x+2))}^{2}}\\text{d}x & =\\frac{1}{5}\\int \\frac{1}{1-{u}^{2}}\\cdot \\sqrt{5}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{5}}{5}\\int \\frac{1}{1-{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{5}}{5}\\cdot \\operatorname{arcoth}⁡u+C \\\\  & =\\frac{\\sqrt{5}}{5}\\cdot \\operatorname{arcoth}⁡(\\frac{1}{\\sqrt{5}}(x+2))+C \\\\  & =\\frac{\\sqrt{5}}{5}\\operatorname{arcoth}⁡\\left(\\frac{x+2}{\\sqrt{5}}\\right)+C.\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|\\frac{x+2}{\\sqrt{5}}|>1.$"} {:db/id #edb/ref 17592186167447 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01827a4b-f2fe-54dc-88a4-5990d389839c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arcosh} \\left(\\frac{x - 2}{3}\\right) + C" :db/id #edb/ref 17592186165891} {:answer/id #uuid "4a5eab12-c87e-5716-98b2-b60b38647e56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arsinh} \\left(\\frac{x - 2}{3}\\right) + C" :db/id #edb/ref 17592186165892} {:answer/id #uuid "6911028f-3e31-5d95-bd70-a4534b9c4bd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arsinh} \\left(\\frac{x - 3}{2}\\right) + C" :db/id #edb/ref 17592186165893} {:answer/id #uuid "75c07914-0def-5ca3-86b6-1c5483173a9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arcosh} (x - 3) + C" :db/id #edb/ref 17592186165894} {:answer/id #uuid "76155b74-9248-564c-93ab-95f88e661f34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arsinh} \\left(\\frac{x - 3}{2}\\right) + C" :db/id #edb/ref 17592186165895}] :answer-field/id #uuid "ffed0f57-4e4a-5c68-a3ab-f2aaab09b53d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165890}] :question/id #uuid "2b704f88-3434-51ec-979f-0b294315821f" :question/math-academy-id "q-96062" :question/problem "What is $\\displaystyle \\int\\frac{dx}{\\sqrt{x^{2} - 6x + 13}}$?"} {:db/id #edb/ref 17592186167462 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5deaf69-a15d-5398-8a6a-506429aa1089" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}(arcoth 2 - arcoth \\left(\\frac{3}{2}\\right))" :db/id #edb/ref 17592186165981} {:answer/id #uuid "d62bbb44-574b-5966-8738-d73b4f7b3b67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{7}arcoth 2" :db/id #edb/ref 17592186165982} {:answer/id #uuid "244aa91b-b954-531e-a3ef-aa1c868f9be9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(arcoth 6 - arcoth 4)" :db/id #edb/ref 17592186165983} {:answer/id #uuid "2d758a53-e76a-52ac-a848-52e2a2d3a63e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}arcoth 6" :db/id #edb/ref 17592186165984} {:answer/id #uuid "5813d9fe-8197-5969-a470-8ef67e50545b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "arcoth 2 - arcoth \\left(\\frac{3}{2}\\right)" :db/id #edb/ref 17592186165985}] :answer-field/id #uuid "cc00d782-89f9-59b2-a9c8-0cae7635d381" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165980}] :question/id #uuid "c297bcab-a09f-5cd5-b9e9-197146ab6e71" :question/math-academy-id "q-96219" :question/problem "Evaluate the integral $\\displaystyle \\int_{3/10}^{2/5}\\frac{2}{1 - 25x^{2}}dx$."} {:db/id #edb/ref 17592186167498 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bba9888-420b-5177-9749-b2a2df95fa99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}⟨1,\\,2\\sqrt{2}\\operatorname{sin}⁡t,\\,-2\\sqrt{2}\\operatorname{cos}⁡t⟩" :db/id #edb/ref 17592186357850} {:answer/id #uuid "5321b4d9-3b60-50aa-86d2-67d71264b404" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}⟨2,\\,\\sqrt{2}\\operatorname{sin}⁡t,\\,-\\sqrt{2}\\operatorname{cos}⁡t⟩" :db/id #edb/ref 17592186358469} {:answer/id #uuid "6169e31e-bcf7-5263-9af6-da6e185aa542" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}⟨1,\\,-2\\operatorname{sin}⁡t,\\,\\sqrt{2}\\operatorname{cos}⁡t⟩" :db/id #edb/ref 17592186358599} {:answer/id #uuid "96846c65-c6eb-5c00-b01c-0fde168b7d5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{3}}⟨1,\\,\\sqrt{2}\\operatorname{sin}⁡t,\\,-\\sqrt{2}\\operatorname{cos}⁡t⟩" :db/id #edb/ref 17592186359068} {:answer/id #uuid "d7aee3fc-9b7d-5c2c-938d-0b42025a181c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}⟨1,\\,\\operatorname{sin}⁡t,\\,\\operatorname{cos}⁡t⟩" :db/id #edb/ref 17592186359640}] :answer-field/correct {:answer/id #uuid "0bba9888-420b-5177-9749-b2a2df95fa99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}⟨1,\\,2\\sqrt{2}\\operatorname{sin}⁡t,\\,-2\\sqrt{2}\\operatorname{cos}⁡t⟩" :db/id #edb/ref 17592186357850} :answer-field/id #uuid "cc6b7c4a-1590-5bf4-bd80-56a591de4f1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360346}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "553afed7-053a-5b06-8cb8-cd7b8f67d1b0" :question/math-academy-id "q-96959" :question/problem "Find the binormal vector to the curve $r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{3}⟨2\\sqrt{2},-\\operatorname{sin}⁡t,\\operatorname{cos}⁡t⟩.\\end{aligned}\n$$\n\nNote that $T$ denotes the unit tangent vector." :question/worked-solution "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t),\n$$\n\nwhere the principal normal vector $N(t)$ is given by\n\n$$\nN(t)=\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}.\n$$\n\nFirst, we find the principal normal $N(t).$ To do this, we calculate ${T}^{′}(t)$ and its magnitude as follows:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{1}{3}⟨\\frac{\\text{d}}{\\text{d}t}(2\\sqrt{2}),\\,\\frac{\\text{d}}{\\text{d}t}(-\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)⟩ \\\\  & =\\frac{1}{3}⟨0,\\,-\\operatorname{cos}⁡t,\\,-\\operatorname{sin}⁡t⟩ \\\\ ‖{T}^{′}(t)‖ & =\\frac{1}{3}\\sqrt{(0)^{2}+{(-\\operatorname{cos}⁡t)}^{2}+{(-\\operatorname{sin}⁡t)}^{2}} \\\\  & =\\frac{1}{3}\\sqrt{{cos}^{2}⁡t+{sin}^{2}⁡t} \\\\  & =\\frac{1}{3}\\end{aligned}\n$$\n\nNow, we normalize ${T}^{′}(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}=\\frac{\\frac{1}{3}⟨0,\\,-\\operatorname{cos}⁡t,\\,-\\operatorname{sin}⁡t⟩}{\\left(\\frac{1}{3}\\right)}=⟨0,\\,-\\operatorname{cos}⁡t,\\,-\\operatorname{sin}⁡t⟩\\end{aligned}\n$$\n\nFinally, we calculate the binormal vector, as follows:\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{3}⟨2\\sqrt{2},-\\operatorname{sin}⁡t,\\operatorname{cos}⁡t⟩\\times ⟨0,\\,-\\operatorname{cos}⁡t,\\,-\\operatorname{sin}⁡t⟩ \\\\  & =\\frac{1}{3}\\left|\\begin{aligned}i & j & k \\\\ 2\\sqrt{2} & -\\operatorname{sin}⁡t & \\operatorname{cos}⁡t \\\\ 0 & -\\operatorname{cos}⁡t & -\\operatorname{sin}⁡t\\end{aligned}\\right| \\\\  & =\\frac{1}{3}[\\text{ }\\left|\\begin{aligned}-\\operatorname{sin}⁡t & \\operatorname{cos}⁡t \\\\ -\\operatorname{cos}⁡t & -\\operatorname{sin}⁡t\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}2\\sqrt{2} & \\operatorname{cos}⁡t \\\\ 0 & -\\operatorname{sin}⁡t\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}2\\sqrt{2} & -\\operatorname{sin}⁡t \\\\ 0 & -\\operatorname{cos}⁡t\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{3}⟨({sin}^{2}⁡t-(-{cos}^{2}⁡t)),-(-2\\sqrt{2}\\operatorname{sin}⁡t-0),(-2\\sqrt{2}\\operatorname{cos}⁡t-0)⟩ \\\\  & =\\frac{1}{3}⟨1,\\,2\\sqrt{2}\\operatorname{sin}⁡t,\\,-2\\sqrt{2}\\operatorname{cos}⁡t⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186167500 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c65c5ca-2f77-5945-a6de-1ae2c2dadd91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0875" :db/id #edb/ref 17592186166209} {:answer/id #uuid "3383b8ba-e314-5ad7-b225-5a47b8db46ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1254" :db/id #edb/ref 17592186166210} {:answer/id #uuid "3f1fd357-85ef-5b17-bf2e-5d192470943e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0988" :db/id #edb/ref 17592186166211} {:answer/id #uuid "641ca748-55a9-5f69-8cf0-154fd2ed9c1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0744" :db/id #edb/ref 17592186166212} {:answer/id #uuid "7da45e13-faaf-558a-87b8-23c1766c0ecb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1150" :db/id #edb/ref 17592186166213}] :answer-field/id #uuid "fcfbb9f1-9937-5ca7-9814-cb0ab48d990e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186166208}] :question/id #uuid "fd22bd50-3053-5bbd-8a3d-74094a6646e4" :question/math-academy-id "q-97124" :question/problem "Given $X∼Geom\\left(\\frac{1}{3}\\right)$, compute $P(X = 4)$. Round your final answer to $4$ decimal places.\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true} {:db/id #edb/ref 17592186