ca-6fd8f3ee858e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4(\\frac{1}{x}+\\frac{1}{\\sqrt{1+{x}^{8}}})" :db/id #edb/ref 17592186524790}] :answer-field/correct {:answer/id #uuid "7f39a794-3765-568c-9788-0c0859104a83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{x}(1-\\frac{1}{\\sqrt{1+{x}^{8}}})" :db/id #edb/ref 17592186524582} :answer-field/id #uuid "3d047628-3fed-5c7b-8f40-ea09ee24e00d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165476}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e1ed5664-2642-587f-b8dc-ece93bd79695" :question/math-academy-id "q-95517" :question/problem "$$\n\nIf $y=4\\operatorname{ln}⁡x+\\operatorname{arcsch}⁡{x}^{4},$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡x)=-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(4\\operatorname{ln}⁡x+\\operatorname{arcsch}⁡{x}^{4}) \\\\  & =4\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x)+\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡{x}^{4}) \\\\  & =\\frac{4}{x}+\\left(-\\frac{1}{|{x}^{4}|\\sqrt{1+({x}^{4})^{2}}}\\right)\\cdot ({x}^{4})^{′} \\\\  & =\\frac{4}{x}-\\frac{1}{{x}^{4}\\sqrt{1+{x}^{8}}}\\cdot 4{x}^{3} \\\\  & =\\frac{4}{x}-\\frac{4}{x\\sqrt{1+{x}^{8}}} \\\\  & =\\frac{4}{x}(1-\\frac{1}{\\sqrt{1+{x}^{8}}}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186167381 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8618ff9d-154d-5486-998d-c46e86fb8652" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer