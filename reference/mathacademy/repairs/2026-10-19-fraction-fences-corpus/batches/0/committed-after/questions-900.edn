ac{1}{8}" :db/id #edb/ref 17592186128489} {:answer/id #uuid "407c25e7-90a1-56d1-8040-5798ada774a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186128490}] :answer-field/id #uuid "d2891177-b1e0-5e56-b84c-403cb70fcc7e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186128485}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5cbb173a-9b62-5ad0-93a2-7271e0aded45" :question/math-academy-id "q-69350" :question/problem "Calculate $\\left(\\frac{5}{8}\\right)^{0} \\cdot (3.5 - 1.5)^{-3}$."} {:db/id #edb/ref 17592186129861 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09569d84-5e32-5d0c-a130-f90cd8008d9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{3},2,-2)" :db/id #edb/ref 17592186339208} {:answer/id #uuid "289bc9d0-998e-57b3-8be6-90403fa7f126" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\sqrt{3},2,-2)" :db/id #edb/ref 17592186339483} {:answer/id #uuid "51208cc7-e531-5b93-acfa-c4e34206d6bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2\\sqrt{3},2,-2)" :db/id #edb/ref 17592186339871} {:answer/id #uuid "60273737-acd9-5933-8f22-d2ef3c24544b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\sqrt{3},-2,-2)" :db/id #edb/ref 17592186339985} {:answer/id #uuid "d47ca682-2173-5daa-9ab3-bb6679be2eaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{3},-1,-2)" :db/id #edb/ref 17592186341006}] :answer-field/correct {:answer/id #uuid "289bc9d0-998e-57b3-8be6-90403fa7f126" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\sqrt{3},2,-2)" :db/id #edb/ref 17592186339483} :answer-field/id #uuid "8291dbb3-a09f-5fcb-8dbd-4d4a865dbe63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341609}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9488b877-c882-5d34-aa2e-ac2ac1e3228c" :question/math-academy-id "q-74299" :question/problem "The point $P$ has cylindrical polar coordinates $(4,\\frac{\\pi }{6},-2).$ Find the Cartesian coordinates of $P.$" :question/worked-solution "If $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z\n$$\n\nCalculating $x$, we get\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =4\\operatorname{cos}⁡\\left(\\frac{\\pi }{6}\\right) \\\\  & =4\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =2\\sqrt{3}.\\end{aligned}\n$$\n\nCalculating $y$, we get\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =4\\operatorname{sin}⁡\\left(\\frac{\\pi }{6}\\right) \\\\  & =4\\cdot \\frac{1}{2} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(2\\sqrt{3},2,-2).$"} {:db/id #edb/ref 17592186129866 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dd77e7a-7884-5f72-a829-ab1c7a15fe2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\sqrt{2},\\frac{\\pi }{4},\\frac{\\pi }{4})" :db/id #edb/ref 17592186339681} {:answer/id #uuid "7a2c6962-0927-55c2-8e6c-10b614a2e5ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,\\frac{7\\pi }{4},-\\frac{\\pi }{4})" :db/id #edb/ref 17592186340220} {:answer/id #uuid "c2970a35-4b9e-5358-8270-2fab52cde2b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\sqrt{2},\\frac{3\\pi }{4},\\frac{\\pi }{4})" :db/id #edb/ref 17592186340861} {:answer/id #uuid "f55929e4-ba9b-55ca-990c-3846b7a45193" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,\\frac{7\\pi }{4},\\frac{\\pi }{4})" :db/id #edb/ref 17592186341293} {:answer/id #uuid "fa3ca820-1a0a-5a97-b6d6-17d352e29349" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-\\frac{7\\pi }{4},\\frac{\\pi }{4})" :db/id #edb/ref 17592186341338}] :answer-field/correct {:answer/id #uuid "f55929e4-ba9b-55ca-990c-3846b7a45193" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,\\frac{7\\pi }{4},\\frac{\\pi }{4})" :db/id #edb/ref 17592186341293} :answer-field/id #uuid "da8085e8-6521-57e5-96c7-5727f8dddc6b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341765}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f8ecc8a0-b267-5e1b-b503-03f75182ab5b" :question/math-academy-id "q-74341" :question/problem "The point $A$ has Cartesian coordinates $(1,-1,\\sqrt{2}).$ What are the spherical polar coordinates of $A?$" :question/worked-solution "If $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nFrom the above equations, we can express $\\rho $, $\\theta $, and $ϕ$ in terms of $x$, $y$, and $z$ as follows:\n\n$$\n\\rho =\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}},\\,\\operatorname{tan}⁡\\theta =\\frac{y}{x},\\,\\operatorname{cos}⁡ϕ=\\frac{z}{\\rho }\n$$\n\nFirst, we find $\\rho :$\n\n$$\n\\begin{aligned}\\rho  & =\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}} \\\\  & =\\sqrt{{1}^{2}+(-1)^{2}+(\\sqrt{2})^{2}} \\\\  & =\\sqrt{1+1+2} \\\\  & =\\sqrt{4} \\\\  & =2\\end{aligned}\n$$\n\nNow, $(x,y)=(1,-1)$ lies in the fourth quadrant. So to find $\\theta ,$ we first need to find the reference angle ${\\theta }_{R}:$ \n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\operatorname{arctan}⁡|\\frac{-1}{1}| \\\\  & =\\operatorname{arctan}⁡(1) \\\\  & =\\frac{\\pi }{4}\\end{aligned}\n$$\n\nNext, we subtract the reference angle from $2\\pi $ to get $\\theta :$\n\n$$\n\\begin{aligned}\\theta  & =2\\pi -{\\theta }_{R} \\\\  & =2\\pi -\\frac{\\pi }{4} \\\\  & =\\frac{7\\pi }{4}\\end{aligned}\n$$\n\nFinally, for $ϕ$, we obtain\n\n$$\n\\begin{aligned}ϕ & =\\operatorname{arccos}⁡\\left(\\frac{z}{\\rho }\\right) \\\\  & =\\operatorname{arccos}⁡\\left(\\frac{\\sqrt{2}}{2}\\right) \\\\  & =\\frac{\\pi }{4}.\\end{aligned}\n$$\n\nTherefore, the spherical coordinates of $A$ are $(2,\\frac{7\\pi }{4},\\frac{\\pi }{4}).$"} {:db/id #edb/ref 17592186129867 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0980b705-bd0a-5772-b420-835db8230451" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\sqrt{2},2.034,2.230)" :db/id #edb/ref 17592186339209} {:answer/id #uuid "2f8cf849-0181-57df-8fbc-0f2ec1f1ef9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{2},0.769,2.034)" :db/id #edb/ref 17592186339544} {:answer/id #uuid "4a25c8b1-0b5b-5ffa-b144-8813d5d0ab8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{2},2.034,0.769)" :db/id #edb/ref 17592186339795} {:answer/id #uuid "6fc4bd90-9d56-58c6-b132-82214d5665b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\sqrt{2},2.034,1.251)" :db/id #edb/ref 17592186340120} {:answer/id #uuid "debf36b4-860c-5a82-af31-6ea857f9689d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{2},1.251,2.457)" :db/id #edb/ref 17592186341108}] :answer-field/correct {:answer/id #uuid "0980b705-bd0a-5772-b420-835db8230451" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\sqrt{2},2.034,2.230)" :db/id #edb/ref 17592186339209} :answer-field/id #uuid "ba4a3be7-db32-5235-a759-18d8a056bbea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341704}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e01b0b14-fb55-55cd-afc5-3b1a6375987e" :question/math-academy-id "q-74342" :question/problem "The point $B$ has Cartesian coordinates $(-1,2,-\\sqrt{3}).$ What are the spherical polar coordinates $(\\rho ,\\theta ,ϕ)$ of $B?$ Express $\\theta $ and $ϕ$ in radians rounded to three decimal places." :question/worked-solution "If $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nFrom the above equations, we can express $\\rho $, $\\theta $, and $ϕ$ in terms of $x$, $y$, and $z$ as follows:\n\n$$\n\\rho =\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}},\\,\\operatorname{tan}⁡\\theta =\\frac{y}{x},\\,\\operatorname{cos}⁡ϕ=\\frac{z}{\\rho }\n$$\n\nFirst, we find $\\rho :$\n\n$$\n\\begin{aligned}\\rho  & =\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}} \\\\  & =\\sqrt{(-1)^{2}+{2}^{2}+(\\sqrt{3})^{2}} \\\\  & =\\sqrt{1+4+3} \\\\  & =\\sqrt{8} \\\\  & =2\\sqrt{2}\\end{aligned}\n$$\n\nNow, $(x,y)=(-1,2)$ lies in the second quadrant. So to find $\\theta $, we first need to find the reference angle ${\\theta }_{R}:$\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\operatorname{arctan}⁡|\\frac{2}{-1}| \\\\  & =\\operatorname{arctan}⁡(2) \\\\  & ≈1.107\\,149\\end{aligned}\n$$\n\nNext, we subtract the reference angle from $\\pi $ to get $\\theta :$\n\n$$\n\\begin{aligned}\\theta  & =\\pi -{\\theta }_{R} \\\\  & ≈\\pi -1.107\\,149 \\\\  & ≈2.034\\end{aligned}\n$$\n\nFinally, for $ϕ$, we obtain\n\n$$\n\\begin{aligned}ϕ & =\\operatorname{arccos}⁡\\left(\\frac{z}{\\rho }\\right) \\\\  & =\\operatorname{arccos}⁡\\left(\\frac{-\\sqrt{3}}{2\\sqrt{2}}\\right) \\\\  & =\\operatorname{arccos}⁡(-\\sqrt{\\frac{3}{8}}) \\\\  & ≈2.230.\\end{aligned}\n$$\n\nTherefore, the spherical coordinates of $B$ are $(\\sqrt{5},2.034,2.230).$"} {:db/id #edb/ref 17592186129878 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fcf7e1f1-fcf9-543c-97ee-b919265bfc35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}" :db/id #edb/ref 17592186373306} {:answer/id #uuid "c5bf893e-8435-5b7e-b5c4-19722cff781d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{20}" :db/id #edb/ref 17592186373307} {:answer/id #uuid "4deced36-0d95-50f5-af94-23b1383c8b33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186373308} {:answer/id #uuid "3395c3cb-8544-536c-a34a-982908787158" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186373309} {:answer/id #uuid "55a5789a-60d9-53af-abe8-31a45948a5e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186373310}] :answer-field/correct {:answer/id #uuid "c5bf893e-8435-5b7e-b5c4-19722cff781d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{20}" :db/id #edb/ref 17592186373307} :answer-field/id #uuid "a50d9972-aaca-5f8a-98d1-1ba9d85277f9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373305}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5371e22a-fae1-5a1c-87b6-2b32ed156fc8" :question/math-academy-id "q-82874" :question/problem "Using the change of variables \n\n$$\nu=x+y,\\,v=x-y,\n$$\n\ncalculate the area of the finite region $D$ bounded by the curve $(x+y)^{4}-x+y=0$ and  the line $y=0.$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\to \\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$  \n\nNote that the changes of variables\n\n$$\nu=x+y,\\,v=x-y\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\nTo compute the required area, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nSubstituting $x+y=u$ and $x-y=v$ into the equation of the first curve, we get\n\n$$\n\\begin{aligned}(x+y)^{4}-x+y=0\\,⟹\\,(x+y)^{4}-(x-y)=0\\,⟹\\,v={u}^{4},\\end{aligned}\n$$\n\nNow, \n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}x+y &=u \\\\ x-y &=v\\end{aligned}\\right.\\,⟹\\,y=\\frac{u-v}{2}.\\end{aligned}\n$$\n\nSubstituting this value into the equation of the given line yields:\n\n$$\n\\begin{aligned}y=0\\, & ⟹\\,\\frac{u-v}{2}=0\\,⟹\\,v=u\\end{aligned}\n$$\n\n \n\nTo find the intersections of the curves in the $uv$-plane, we solve the following system:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}v &={u}^{4} \\\\ v &=u\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}{u}^{3}(u-1) &=0 \\\\ v &=u.\\end{aligned}\\right.\\end{aligned}\n$$\n\n \n\nSo, the intersection points are $(0,0)$ and $(1,1).$\n\nTherefore, our domain in the $uv$-plane has the type I representation\n\n$$\nΔ=\\{(u,v)\\,:\\,0\\le u\\le 1,\\,{u}^{4}\\le v\\le u\\}.\n$$\n\n![](images/1e/1ed905e319e689d3fc7955a30f58e0f3ae2e7a751c27b80201d2b43f58b4206c.png)\n\n \n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & 1 \\\\ 1 & -1\\end{vmatrix} \\\\  & =-2.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=(-2)^{-1}=-\\frac{1}{2}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|-\\frac{1}{2}|\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{0}^{1}[{\\int }_{{u}^{4}}^{u}\\,dv]du \\\\  & =\\frac{1}{2}{\\int }_{0}^{1}[v]_{{u}^{4}}^{u}\\,du \\\\  & =\\frac{1}{2}{\\int }_{0}^{1}(u-{u}^{4})du \\\\  & =\\frac{1}{2}{[\\frac{{u}^{2}}{2}-\\frac{{u}^{5}}{5}]}_{0}^{1} \\\\  & =\\frac{1}{2}(\\frac{1}{2}-\\frac{1}{5}) \\\\  & =\\frac{1}{2}\\left(\\frac{3}{10}\\right) \\\\  & =\\frac{3}{20}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186129884 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e43f0bf-6626-5307-a064-a72be2e80a70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.6" :db/id #edb/ref 17592186348856} {:answer/id #uuid "98cd6778-156a-541d-8e22-df64bec870e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186349815} {:answer/id #uuid "9bf92353-21bf-51c5-8337-6fef75f61aaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.8" :db/id #edb/ref 17592186349836} {:answer/id #uuid "c21447d6-9c20-50ba-9608-5c974f5d9781" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.7" :db/id #edb/ref 17592186350169} {:answer/id #uuid "d0818283-dcbb-59bd-84f5-15236241b86c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.4" :db/id #edb/ref 17592186350280}] :answer-field/correct {:answer/id #uuid "c21447d6-9c20-50ba-9608-5c974f5d9781" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.7" :db/id #edb/ref 17592186350169} :answer-field/id #uuid "3ac4354d-99af-5654-a4d2-0d3920502f14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350808}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "33a751a7-7f9e-5b67-a685-e5ad79051983" :question/math-academy-id "q-83623" :question/problem "Given that the discrete random variable $Y$ has the cumulative distribution function $F(y)$ shown in the table below, compute $P(\\frac{1}{2}\\le Y\\le \\frac{3}{2}).$\n\n| $y$ | $0$ | $\\frac{1}{2}$ | $1$ | $\\frac{3}{2}$ | $2$ |\n| --- | --- | --- | --- | --- | --- |\n| $F(y)$ | $0.1$ | $0.2$ | $0.4$ | $0.8$ | $1.0$ |" :question/worked-solution "The cumulative distribution function of a discrete random variable $Y$ is a function $F(y)$ such that\n\n$$\nF(y)=P(Y\\le y).\n$$\n\nTo compute the probability of a random variable $Y$ over an interval, we can use the rule\n\n$$\nP(a<Y\\le b)=F(b)-F(a).\n$$\n\nHere, we want to compute $P(\\frac{1}{2}\\le Y\\le \\frac{3}{2}).$ However, this interval is stated in the form $a\\le Y\\le b,$ not $a<Y\\le b.$\n\nSo first, we must convert the interval $\\frac{1}{2}\\le Y\\le \\frac{3}{2}$ to the form $a<Y\\le b.$ Looking at the given possible values of $Y,$ we see that $\\frac{1}{2}\\le Y$ is equivalent to $0<Y.$ Therefore,\n\n$$\n\\begin{aligned}P(\\frac{1}{2}\\le Y\\le \\frac{3}{2}) & =P(0<Y\\le \\frac{3}{2}) \\\\  & =F\\left(\\frac{3}{2}\\right)-F(0) \\\\  & =0.8-0.1 \\\\  & =0.7.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186129887 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd51e610-6f03-5601-be97-90a082867f32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{20}" :db/id #edb/ref 17592186128804} {:answer/id #uuid "115c217e-8e0a-5c5b-8302-ae521adc07f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{15}" :db/id #edb/ref 17592186128805} {:answer/id #uuid "232b05d7-2819-5154-96f7-710edeff9ff6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}" :db/id #edb/ref 17592186128806} {:answer/id #uuid "4505c771-cef0-508f-89e7-d4849ae94ee6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186128807} {:answer/id #uuid "6325e896-5085-50b5-ab25-23a0ebf6535e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186128808}] :answer-field/correct {:answer/id #uuid "cd51e610-6f03-5601-be97-90a082867f32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{20}" :db/id #edb/ref 17592186128804} :answer-field/id #uuid "d8292c76-a1e0-5537-aaa6-9b5b73963ff1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186128803}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "929376bc-8d45-5684-ae94-b99b8cb09d33" :question/math-academy-id "q-83968" :question/problem "![](images/fd/fd1a5a140c3a2d430312d6f6ceeb21d6b7282119c8ec53365553ff845d8c64d5.png)\n\nEvaluate the double integral ${∬}_{D}x\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}A,$ where the region $D$ is the semicircle shown above." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFirst, notice that the region $D$ represents a portion of the disk of radius $\\frac{1}{2}$ centered at \n$(0,-\\frac{1}{2}).$\n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n\\left\\{\\begin{aligned}x &=r\\operatorname{cos}⁡\\theta \\\\ y &=r\\operatorname{sin}⁡\\theta\\end{aligned}\\right.\n$$\n\nWith that in mind, let's now write the $x=\\sqrt{-{y}^{2}-y}$ in polar coordinates:\n\n$$\n\\begin{aligned}x & =\\sqrt{-{y}^{2}-y} \\\\ {x}^{2} & =-{y}^{2}-y \\\\ {x}^{2}+{y}^{2} & =-y \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2} & =-r\\operatorname{sin}⁡\\theta  \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta ) & =-r\\operatorname{sin}⁡\\theta  \\\\ {r}^{2} & =-r\\operatorname{sin}⁡\\theta  \\\\ {r}^{2}+r\\operatorname{sin}⁡\\theta  & =0 \\\\ r(r+\\operatorname{sin}⁡\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=-\\operatorname{sin}⁡\\theta .$\n\nTherefore, in polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le -\\operatorname{sin}⁡\\theta ,\\,-\\frac{\\pi }{2}\\le \\theta \\le 0\\}.\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}x\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}A & ={∬}_{Δ}(r\\operatorname{cos}⁡\\theta )\\sqrt{(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}\\operatorname{cos}⁡\\theta {\\int }_{0}^{-\\operatorname{sin}⁡\\theta }{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}\\operatorname{cos}⁡\\theta [\\frac{{r}^{4}}{4}]_{0}^{-\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =\\frac{1}{4}{\\int }_{-\\pi /2}^{0}\\operatorname{cos}⁡\\theta ((-\\operatorname{sin}⁡\\theta )^{4}-{0}^{4})\\,\\text{d}\\theta  \\\\  & =\\frac{1}{4}{\\int }_{-\\pi /2}^{0}\\operatorname{cos}⁡\\theta {sin}^{4}⁡\\theta \\,\\text{d}\\theta  \\\\  & =\\frac{1}{4}{[\\frac{{sin}^{5}⁡\\theta }{5}]}_{-\\pi /2}^{0} \\\\  & =\\frac{1}{20}({sin}^{5}⁡0-{sin}^{5}⁡\\left(-\\frac{\\pi }{2}\\right)) \\\\  & =\\frac{1}{20}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186133476 :question/id #uuid "295afdb2-2e90-5f1a-8830-d3886d99fbad" :question/math-academy-id "e-11349" :question/problem "Evaluate the mixed integral\n\n$$\n\\displaystyle \\iint\\limits_D \\left[ \\int_{0}^{z} \\dfrac{\\cos (2y)}{1-y} \\,\\textrm{d}x \\right] \\textrm{d}A\n$$\n\nwhere the region $D$ in the $yz$-plane is given by\n\n$$\nD = \\left\\{ (y,z) \\, : \\, 0 \\leq y \\leq \\dfrac{\\pi}{6}, \\: 0 \\leq z \\leq 2\\sqrt{1-y} \\right\\}.\n$$" :question/worked-solution "First, we evaluate the inner integral with respect to $x,$ treating $y$ and $z$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{0}^{z}\\frac{\\operatorname{cos}⁡(2y)}{1-y}\\,\\text{d}x]\\,\\text{d}A & ={∬}_{D}\\frac{\\operatorname{cos}⁡(2y)}{1-y}[x]_{x=0}^{x=z}\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{\\operatorname{cos}⁡(2y)}{1-y}(z-0)\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{z\\operatorname{cos}⁡(2y)}{1-y}\\,\\text{d}A\\end{aligned}\n$$\n\nNext, we evaluate the double integral:\n\n$$\n\\begin{aligned}{∬}_{D}\\frac{z\\operatorname{cos}⁡(2y)}{1-y}\\,\\text{d}A & ={\\int }_{0}^{\\pi /6}{\\int }_{0}^{2\\sqrt{1-y}}\\frac{z\\operatorname{cos}⁡(2y)}{1-y}\\,\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\pi /6}\\frac{\\operatorname{cos}⁡(2y)}{1-y}{[\\frac{{z}^{2}}{2}]}_{z=0}^{z=2\\sqrt{1-y}}\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\pi /6}\\frac{\\operatorname{cos}⁡(2y)}{1-y}(\\frac{4(1-y)}{2}-0)\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\pi /6}2\\operatorname{cos}⁡(2y)\\,\\text{d}y \\\\  & =[\\operatorname{sin}⁡(2y)]_{y=0}^{y=\\pi /6} \\\\  & =\\operatorname{sin}⁡\\left(\\frac{\\pi }{3}\\right)-\\operatorname{sin}⁡(0) \\\\  & =\\frac{\\sqrt{3}}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186133502 :question/id #uuid "9e145904-a9bf-59fc-9070-339b0e133de9" :question/math-academy-id "e-12830" :question/problem "Which of the following numbers are surds?\n\n$$\n\\sqrt[3]{2},\\qquad \\sqrt[3]{\\dfrac{1}{27}},\\qquad \\sqrt[3]{11}\n$$" :question/worked-solution "A surd is a number containing a radical symbol $\\sqrt{\\phantom{0}}$ that cannot be written as a positive or negative whole number or fraction.\n\nSurds can be square roots $\\sqrt{\\phantom{0}}$, cube roots $\\sqrt[3]{\\phantom{0}},$ or higher roots such as $\\sqrt[4]{\\phantom{0}}, \\sqrt[5]{\\phantom{0}},\\ldots,$ etc.\n\nWith that in mind, let's look at each number in turn.\n\n- $\\sqrt[3]{2}$ is a surd. Using a calculator, we find that $\\sqrt[3]{2} = 1.259\\,921\\,\\ldots$\n\n- $\\sqrt[3]{\\dfrac{1}{27}}$ is **NOT** a surd. Since $1$ and $27$ are perfect cubes, we can get rid of the cube root symbol $(\\sqrt[3]{\\phantom{0}})$ and obtain a regular fraction.\n\n$$\n\\begin{aligned}\\sqrt[3]{\\frac{1}{27}} & =\\sqrt[3]{\\frac{{1}^{3}}{{3}^{3}}} \\\\  & =\\sqrt[3]{\\frac{1\\cdot 1\\cdot 1}{3\\cdot 3\\cdot 3}} \\\\  & =\\sqrt[3]{\\frac{1}{3}\\cdot \\frac{1}{3}\\cdot \\frac{1}{3}} \\\\  & =\\sqrt[3]{{\\left(\\frac{1}{3}\\right)}^{3}} \\\\  & =\\frac{1}{3}\\end{aligned}\n$$\n\n- $\\sqrt[3]{11}$ is a surd. Using a calculator, we find that $\\sqrt[3]{11} = 2.223\\,980\\,\\ldots$\n\nTherefore, the correct answer is: $\\sqrt[3]{2}$ and $\\sqrt[3]{11}$ only."} {:db/id #edb/ref 17592186133513 :question/id #uuid "5468caae-f88a-59d2-98ab-7941bf7cd81a" :question/math-academy-id "e-13251" :question/problem "Find the value of $\\dfrac{3}{5}$ cubed." :question/worked-solution "To work out $\\left(\\dfrac{3}{5}\\right)^3,$ we multiply $\\dfrac{3}{5}$ by itself and then multiply the result by $\\dfrac{3}{5}$ again:\n\n$$\n\\begin{aligned}{\\left(\\frac{3}{5}\\right)}^{3} & =\\frac{3}{5}\\cdot \\frac{3}{5}\\cdot \\frac{3}{5} \\\\  & =\\frac{3\\cdot 3\\cdot 3}{5\\cdot 5\\cdot 5} \\\\  & =\\frac{27}{125}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186133515 :question/id #uuid "12b5f86f-9e86-5c1b-8773-38e2b69a6417" :question/math-academy-id "e-13357" :question/problem "Which of the following numbers are surds?\n\n$$\n\\sqrt{\\dfrac{5}{12}}, \\qquad \\sqrt{\\dfrac{64}{81}}, \\qquad \\sqrt{\\dfrac{10}{7}}\n$$" :question/worked-solution "A surd is a number containing a radical symbol $\\sqrt{\\phantom{0}}$ that cannot be written as a positive or negative whole number or fraction.\n\nWith that in mind, let's look at each number in turn.\n\n- $\\sqrt{\\dfrac{5}{12}}$ is a surd. Using a calculator, we find that $\\sqrt{\\dfrac{5}{12}} = 0.645\\,497\\,\\ldots$\n\n- $\\sqrt{\\dfrac{64}{81}}$ is **NOT** a surd. Since $64$ and $81$ are perfect squares, we can get rid of the square root symbol $(\\sqrt{\\phantom{0}})$ and obtain a regular fraction.\n\n$$\n\\begin{aligned}\\sqrt{\\frac{64}{81}} & =\\sqrt{\\frac{{8}^{2}}{{9}^{2}}} \\\\  & =\\sqrt{\\frac{8\\cdot 8}{9\\cdot 9}} \\\\  & =\\sqrt{\\frac{8}{9}\\cdot \\frac{8}{9}} \\\\  & =\\sqrt{{\\left(\\frac{8}{9}\\right)}^{2}} \\\\  & =\\frac{8}{9}\\end{aligned}\n$$\n\n- $\\sqrt{\\dfrac{10}{7}}$ is a surd. Using a calculator, we find that $\\sqrt{\\dfrac{10}{7}} = 1.195\\,228\\,\\ldots$\n\nTherefore, the correct answer is: $\\sqrt{\\dfrac{5}{12}}$ and $\\sqrt{\\dfrac{10}{7}}$ only."} {:db/id #edb/ref 17592186133536 :question/id #uuid "5537647b-d722-5000-8445-b2743cc1f1f8" :question/math-academy-id "e-1512" :question/problem "The formula for the $n$th term of a geometric sequence is $f(n) =\\dfrac{6}{(-2)^n}$ for $n\\geq 1.$  What is the recursive formula for this sequence?" :question/worked-solution "The recursive formula for a geometric sequence is\n\n$$\nf(n+1) = r \\cdot f(n).\n$$\n\nTo complete the formula, we must determine the common ratio $r$ and state the first term $a_1.$ The first two terms are\n\n$$\n\\begin{aligned}f(1) & =\\frac{6}{(-2)^{1}}=\\frac{6}{(-2)}=-3, \\\\ f(2) & =\\frac{6}{(-2)^{2}}=\\frac{6}{4}=\\frac{3}{2}.\\end{aligned}\n$$\n\nHence, the common ratio is\n\n$$\n\\begin{aligned}r=\\frac{f(2)}{f(1)}=\\frac{\\left(\\frac{3}{2}\\right)}{(-3)}=-\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the recursive formula for the geometric sequence is\n\n$$\nf(n+1) = -\\dfrac{1}{2} f(n), \\qquad f(1) = -3, \\qquad n \\geq 1.\n$$"} {:db/id #edb/ref 17592186133551 :question/id #uuid "5027a265-fd62-574b-b6fa-2bacf9de7304" :question/math-academy-id "e-4238" :question/problem "What is the explicit formula for the $n$th term of the sequence\n\n$$\nf(n+1) =-\\dfrac{f(n)}{3},\\, \\quad f(1) = {\\color{blue}9},\\, \\quad n\\geq 1?\n$$" :question/worked-solution "First, let's rewrite our recursive formula as follows:\n\n$$\n\\begin{aligned}f(n+1)=-\\frac{f(n)}{3}=-\\frac{1}{3}f(n)\\end{aligned}\n$$\n\nThe explicit formula for the $n$th term of a geometric sequence is\n\n$$\nf(n) =f(1) \\cdot r^{n-1}, \\quad n \\geq 1.\n$$\n\nSo, we must determine the first term $f(1)$ and the common ratio $r.$\n\nWe are given that the first term is $f(1)=9.$ To find the common ratio, we compare the given sequence with the general recursive formula for a geometric sequence:\n\n$$\nf(n+1) = {\\color{red}r} \\cdot f(n)\n$$\n\n \n\nFrom the above, we see that $r = -\\dfrac{1}{3}.$\n\nSubstituting $f(1) = 9$ and $r = -\\dfrac{1}{3}$ into the formula for the $n$th term, we obtain\n\n$$\n\\begin{aligned}\nf(n) &= f(1) \\cdot r^{n-1}\t\\\\[5pt]\n&= 9 \\cdot \\left( -\\dfrac{1}{3}\\right)^{n-1}.\n\\end{aligned}\n$$\n\nWe can simplify further by manipulating the exponents as follows:\n\n$$\n\\begin{aligned}f(n) & =9\\cdot {\\left(-\\frac{1}{3}\\right)}^{n-1} \\\\  & =9\\cdot {\\left(-\\frac{1}{3}\\right)}^{-1}\\cdot {\\left(-\\frac{1}{3}\\right)}^{n} \\\\  & =9\\cdot \\left(-\\frac{3}{1}\\right)\\cdot {\\left(-\\frac{1}{3}\\right)}^{n} \\\\  & =-27\\cdot \\frac{1}{(-3)^{n}} \\\\  & =-\\frac{27}{(-3)^{n}}\\end{aligned}\n$$\n\nTherefore, the formula for the $n$th term is\n\n$$\nf(n)=-\\dfrac{27}{(-3)^n} ,\\quad n\\geq 1.\n$$"} {:db/id #edb/ref 17592186133561 :question/id #uuid "04f489ae-768f-5e8e-bed6-0a88f481c54c" :question/math-academy-id "e-5391" :question/problem "![](images/1e/1e1362c20f9e20bb22d049d8b218d786a5254603ab4cc36d90b5866095a8897c.png)\n\nGiven that the ray above passes through the point with Cartesian coordinates $(6,-2\\sqrt{3})$, find the polar equation of the ray." :question/worked-solution "First, we find the reference angle associated with the point:\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\operatorname{arctan}⁡|\\frac{-2\\sqrt{3}}{6}| \\\\  & =\\operatorname{arctan}⁡\\left(\\frac{\\sqrt{3}}{3}\\right) \\\\  & =\\frac{\\pi }{6}\\end{aligned}\n$$\n\nNow, notice that the ray lies in the fourth quadrant. So, we find the angle in the fourth quadrant that has a reference angle $\\theta_R = \\dfrac{\\pi}{6},$ as follows:\n\n$$\n\\begin{aligned}\\theta  & =2\\pi -{\\theta }_{R} \\\\  & =2\\pi -\\frac{\\pi }{6} \\\\  & =\\frac{11\\pi }{6}.\\end{aligned}\n$$\n\nTherefore, the polar equation of the ray is \n\n$$\n\\theta = \\dfrac{11\\pi}{6}.\n$$"} {:db/id #edb/ref 17592186133562 :question/id #uuid "e2c565be-0152-5088-8c4f-e66374cf2fb9" :question/math-academy-id "e-5392" :question/problem "The polar curve $r=7$ and the ray $\\theta=\\dfrac{4\\pi}{3}$ intersect at the point $P,$ as shown above. What are the Cartesian coordinates of $P?$\n\n![](images/72/728f7aad12a4f127cc002bc38c46fa87ba70d6ecd79ef311a0154014b649a0ce.png)" :question/worked-solution "The polar coordinates of $P$ are $(r, \\theta) = \\left(7, \\dfrac{4\\pi}{3}\\right).$ We can convert the polar coordinates of $P$ to Cartesian coordinates, as follows:\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =7\\operatorname{cos}⁡\\left(\\frac{4\\pi }{3}\\right) \\\\  & =7\\cdot \\left(-\\frac{1}{2}\\right) \\\\  & =-\\frac{7}{2} \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =7\\operatorname{sin}⁡\\left(\\frac{4\\pi }{3}\\right) \\\\  & =7\\cdot \\left(-\\frac{\\sqrt{3}}{2}\\right) \\\\  & =-\\frac{7\\sqrt{3}}{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $\\left(-\\dfrac 72, -\\dfrac{7\\sqrt 3}2\\right).$"} {:db/id #edb/ref 17592186133587 :question/id #uuid "bbb751a9-ef0d-58cf-b788-18594dd67337" :question/math-academy-id "e-5560" :question/problem "For the vector ![](images/c3/c32c8627f43b93123b110207a136416c9b498a9b0fbab9adc671e039839f098c.svg) which of the following statements are true?\n\n- $\\mathbf{u}$ is orthogonal to the set ![](images/62/621d5f7a19f100f4c7089900b4ef61851bb23ad580127a03c0050bdb295e1802.svg)\n\n- $\\mathbf{u}$ is orthogonal to the set ![](images/5e/5e3fe028385135bd1e744ae7ee0e0d6ed319bf5fc145ae70bee0b30991008964.svg)" :question/worked-solution "Let's denote the vectors of $H$ and $V$ as $\\{\\mathbf{h}_1,\\mathbf{h}_2\\}$ and $\\{\\mathbf{v}_1,\\mathbf{v}_2\\}$ respectively.  \n\nNow, we have to compute the dot product between $\\mathbf{u}$ and the vectors in each set. \n\n- For the set $H\\mathbin{:}$\n\n$$\n\\begin{aligned}u\\cdot {h}_{1} & =3\\cdot 2+2\\cdot (-6)+6\\cdot 1=0,\\,✓ \\\\ u\\cdot {h}_{2} & =3\\cdot 2+2\\cdot (-3)+6\\cdot (-1)=-6\\ne 0\\,\\times \\end{aligned}\n$$\n\nSo $\\mathbf u \\perp \\mathbf h_1$ but $\\mathbf u \\not\\perp \\mathbf h_2.$ Because $\\mathbf u$ is not orthogonal to every vector in $H,$ we have $\\mathbf{u}\\not \\perp H.$\n\n- For the set $V\\mathbin{:}$\n\n$$\n\\begin{aligned}u\\cdot {v}_{1} & =3\\cdot 1+2\\cdot (-1)+6\\cdot \\left(-\\frac{1}{6}\\right)=0\\,✓ \\\\ u\\cdot {v}_{2} & =3\\cdot (-2)+2\\cdot 3+6\\cdot 0=0\\,✓\\end{aligned}\n$$\n\nSo $\\mathbf u \\perp \\mathbf v_1$ and $\\mathbf u \\perp \\mathbf v_2.$ Because $\\mathbf u$ is orthogonal to every vector in $V,$ we have $\\mathbf{u}\\perp V.$"} {:db/id #edb/ref 17592186133595 :question/id #uuid "89a4773c-f6bb-577d-8743-5d0a46c1da6d" :question/math-academy-id "e-5573" :question/problem "Consider the vector $\\mathbf{x}$ and the subspace $S=\\textrm{Span}\\{ \\mathbf{a}_1,\\mathbf{a}_2 \\},$ where\n![](images/36/3693f5fe916109a80a0d7782f7d21781953a7f854cedf82568d353d7e9d23681.svg)\n\nFind the orthogonal projection of $\\mathbf{x}$ onto the subspace $S$ given that the set $\\{\\mathbf{a}_1,\\mathbf{a}_2\\}$ is orthogonal." :question/worked-solution "Since the set $\\{\\mathbf{a}_1,\\mathbf{a}_2\\}$ is orthogonal, the orthogonal projection of $\\mathbf{x}$ onto the subspace $S$ is given by\n\n$$\n\\textrm{proj}_{S}\\,\\mathbf{x} \n= \\textrm{proj}_{\\mathbf{a}_1}\\mathbf{x} + \\textrm{proj}_{\\mathbf{a}_2}\\mathbf{x}.\n$$\n\nSo, we first find the orthogonal projections of $\\mathbf{x}$ onto $\\textrm{Span}\\{\\mathbf{a}_1\\}$ and $\\textrm{Span}\\{\\mathbf{a}_2\\}\\mathbin{:}$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{2\\cdot 1+3\\cdot 1+(-2)\\cdot 1}{{1}^{2}+{1}^{2}+{1}^{2}}{a}_{1}=1\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix} \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{2\\cdot (-2)+3\\cdot 1+(-2)\\cdot 1}{(-2)^{2}+{1}^{2}+{1}^{2}}{a}_{2}=-\\frac{1}{2}\\begin{bmatrix}-2 \\\\ 1 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x \\\\  & =\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix}+\\left(-\\frac{1}{2}\\right)\\begin{bmatrix}-2 \\\\ 1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ \\frac{1}{2} \\\\ \\frac{1}{2}\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186133597 :question/id #uuid "b8bbe0e1-8bf1-5b3a-a77e-6350ea77e83f" :question/math-academy-id "e-5575" :question/problem "Verify whether the vectors $\\mathbf{a}_1, \\mathbf{a}_2, \\mathbf{a}_3$ are linearly independent, and find the orthogonal projection of $\\mathbf{x}$ onto the subspace spanned by the vectors $\\{ \\mathbf{a}_1, \\mathbf{a}_2, \\mathbf{a}_3 \\},$ where\n![](images/e1/e11a1239e429520c575fed6ac0c9af383ba8ce58b6df8616218998a58c63748c.svg)" :question/worked-solution "First, we verify whether $\\mathbf{a}_1, \\mathbf{a}_2, \\mathbf{a}_3$ are linearly independent. So, we start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}4 & 1 & 1 \\\\ 3 & 1 & 2 \\\\ 1 & 1 & 4\\end{bmatrix} &  & \\begin{aligned}{R}_{3}↔{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 1 & 4 \\\\ 3 & 1 & 2 \\\\ 4 & 1 & 1\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-3){R}_{1} \\\\ {R}_{3}:={R}_{3}+(-4){R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 1 & 4 \\\\ 0 & -2 & -10 \\\\ 0 & -3 & -15\\end{bmatrix} &  & \\begin{aligned}{R}_{3}:={R}_{3}+\\left(-\\frac{3}{2}\\right){R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 1 & 4 \\\\ 0 & -2 & -10 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nIn the reduced matrix above, the pivot columns correspond to the linearly independent vectors $\\mathbf{a}_1$ and $\\mathbf{a}_2$ that form the basis of our span.\n\nNow, the orthogonal projection of $\\mathbf{x}$ onto the subspace spanned by the linearly independent columns of a matrix $A$ is given by\n\n$$\n\\textrm{proj}_{S} \\: \\mathbf{x} = A(A^T\\!A)^{-1}\\!A^T\\,\\mathbf{x}.\n$$\n\nIn our case, we have\n![](images/78/7885074c85f490a410f26a1b4d7836134b13a36923b99d31e3b670b8c1dd75f5.svg)\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =\\begin{bmatrix}4 & 1 \\\\ 3 & 1 \\\\ 1 & 1\\end{bmatrix}\\cdot {(\\begin{bmatrix}4 & 3 & 1 \\\\ 1 & 1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}4 & 1 \\\\ 3 & 1 \\\\ 1 & 1\\end{bmatrix})}^{-1}\\cdot \\begin{bmatrix}4 & 3 & 1 \\\\ 1 & 1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}5 \\\\ -1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 1 \\\\ 3 & 1 \\\\ 1 & 1\\end{bmatrix}\\cdot {\\begin{bmatrix}26 & 8 \\\\ 8 & 3\\end{bmatrix}}^{-1}\\cdot \\begin{bmatrix}18 \\\\ 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 1 \\\\ 3 & 1 \\\\ 1 & 1\\end{bmatrix}\\cdot \\frac{1}{14}\\begin{bmatrix}3 & -8 \\\\ -8 & 26\\end{bmatrix}\\cdot \\begin{bmatrix}18 \\\\ 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 1 \\\\ 3 & 1 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ 2 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186133605 :question/id #uuid "683556db-c65d-5279-ac14-7dfaa496db0a" :question/math-academy-id "e-5584" :question/problem "Consider the following vectors:\n\n![](images/26/26a4907b9698a976361fbf6396c09a56edc417f177e512a82f6fb1495624f98b.png)\n\nSuppose that $V = \\textrm{Span}\\{\\mathbf a_1, \\mathbf a_2, \\mathbf a_3\\}.$ Given that $\\mathcal B = \\{\\mathbf a_1, \\mathbf a_2, \\mathbf b\\}$ is an orthogonal basis for $V, \\mathbf{a}_1 \\perp \\mathbf{a}_2,$ and that $\\mathcal B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $\\dfrac{c}{a}?$" :question/worked-solution "Since the first two vectors are already orthogonal, we proceed to find an orthogonal basis using the Gram-Schmidt process, as follows:\n\n**Step 1**: We set ![](images/ea/ea56a2ffc9a7f267e5de0cace94d505050e7df7ade72986b0b8e5ae6c91e7385.png)\n\n**Step 2**: We set ![](images/a8/a87589c86b41d3fd44e6346b300a103c16301bb6cde410084a794b5430b3599a.png)\n\n**Step 3**. Next, we find $\\mathbf{v}_3$ using the formula\n\n$$\n\\begin{aligned}{v}_{3} & ={a}_{3}-{\\text{proj}}_{{v}_{1}}\\,{a}_{3}-{\\text{proj}}_{{v}_{2}}\\,{a}_{3} \\\\  & ={a}_{3}-\\frac{{a}_{3}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}-\\frac{{a}_{3}\\cdot {v}_{2}}{{v}_{2}\\cdot {v}_{2}}{v}_{2}.\\end{aligned}\n$$\n\nApplying the formula for $\\mathbf{v}_3$ in our case gives\n\n$$\n\\begin{aligned}{v}_{3} & =\\begin{bmatrix}-1 \\\\ 0 \\\\ -2 \\\\ 1\\end{bmatrix}-\\left(-\\frac{2}{4}\\right)\\begin{bmatrix}1 \\\\ 1 \\\\ 1 \\\\ 1\\end{bmatrix}-\\frac{0}{4}\\begin{bmatrix}1 \\\\ 1 \\\\ -1 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ 0 \\\\ -2 \\\\ 1\\end{bmatrix}+\\frac{1}{2}\\begin{bmatrix}1 \\\\ 1 \\\\ 1 \\\\ 1\\end{bmatrix}-0\\begin{bmatrix}1 \\\\ 1 \\\\ -1 \\\\ -1\\end{bmatrix} \\\\  & =\\frac{1}{2}(2\\begin{bmatrix}-1 \\\\ 0 \\\\ -2 \\\\ 1\\end{bmatrix}+\\begin{bmatrix}1 \\\\ 1 \\\\ 1 \\\\ 1\\end{bmatrix}) \\\\  & =\\begin{bmatrix}-\\frac{1}{2} \\\\ \\frac{1}{2} \\\\ -\\frac{3}{2} \\\\ \\frac{3}{2}\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, $a=-\\dfrac 1 2,$ $c=-\\dfrac 3 2,$ and $\\dfrac{c}{a} = \\dfrac{\\left(-\\dfrac 3 2\\right)}{\\left(-\\dfrac 1 2\\right)} = 3.$"} {:db/id #edb/ref 17592186133606 :question/id #uuid "87d88110-e10d-553c-983d-6c22d3f19895" :question/math-academy-id "e-5585" :question/problem "![](images/1e/1e6a41f2d6f834b7f9b8c937d19a4f47d45ee6bf2705d783e9a254e8478df15d.png)\n\nSuppose that $V = \\textrm{Span}\\{\\mathbf a_1, \\mathbf a_2, \\mathbf a_3\\}.$ Given that $\\mathcal B$ is an orthogonal basis for $V,$ and that $\\mathcal B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $\\dfrac{b}{c}?$" :question/worked-solution "We find an orthogonal basis $\\mathcal B$ of $V$ using the Gram-Schmidt process, as follows:\n\n**Step 1.** We set ![](images/3f/3f7fd351c90e195ff46d0fdec20b2bda8a5a784c17a97700238fab0b19ebe836.png)\n\n**Step 2.** We find the vector $\\mathbf{v}_2$ orthogonal to $\\text{Span}\\{\\mathbf{v}_1\\}$ using the usual formula:\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-{\\text{proj}}_{{v}_{1}}{a}_{2} \\\\  & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1} \\\\  & =\\begin{bmatrix}1 \\\\ 2 \\\\ 2\\end{bmatrix}-\\frac{3}{3}\\begin{bmatrix}-1 \\\\ 1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ 1 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\n**Step 3.** We find the vector $\\mathbf{v}_3$ orthogonal to $\\textrm{Span}\\{\\mathbf{v}_1,\\mathbf{v}_2 \\}$ using the usual formula:\n\n$$\n\\begin{aligned}{v}_{3} & ={a}_{3}-{\\text{proj}}_{{v}_{1}}\\,{a}_{3}-{\\text{proj}}_{{v}_{2}}\\,{a}_{3} \\\\  & ={a}_{3}-\\frac{{a}_{3}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}-\\frac{{a}_{3}\\cdot {v}_{2}}{{v}_{2}\\cdot {v}_{2}}{v}_{2} \\\\  & =\\begin{bmatrix}2 \\\\ 1 \\\\ -2\\end{bmatrix}-\\left(-\\frac{3}{3}\\right)\\begin{bmatrix}-1 \\\\ 1 \\\\ 1\\end{bmatrix}-\\frac{3}{6}\\begin{bmatrix}2 \\\\ 1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ 1 \\\\ -2\\end{bmatrix}+\\begin{bmatrix}-1 \\\\ 1 \\\\ 1\\end{bmatrix}-\\frac{1}{2}\\begin{bmatrix}2 \\\\ 1 \\\\ 1\\end{bmatrix} \\\\  & =\\frac{1}{2}(2\\begin{bmatrix}2 \\\\ 1 \\\\ -2\\end{bmatrix}+2\\begin{bmatrix}-1 \\\\ 1 \\\\ 1\\end{bmatrix}-\\begin{bmatrix}2 \\\\ 1 \\\\ 1\\end{bmatrix}) \\\\  & =\\begin{bmatrix}0 \\\\ \\frac{3}{2} \\\\ -\\frac{3}{2}\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, $b=\\dfrac 3 2,$ $c=-\\dfrac 3 2,$ and $\\dfrac{b}{c} = \\dfrac{\\left(\\dfrac 3 2\\right)}{\\left(-\\dfrac 3 2\\right)}=-1.$"} {:db/id #edb/ref 17592186133642 :question/id #uuid "132af6fa-454c-596c-a057-dfe531792102" :question/math-academy-id "e-6283" :question/problem "Evaluate the line integral of $f(x,y,z) = \\dfrac{x}{yz}$ along the curve parametrized by $\\mathbf{r}(t) = t^2\\, \\mathbf{i} + t \\,\\mathbf{j} + 1 \\,\\mathbf{k}$ for $t \\in [0,\\sqrt 2].$" :question/worked-solution "To calculate the line integral, we will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t.\n$$\n\n \n\nSince $\\mathbf{r}(t) =t^2\\, \\mathbf{i} + t \\,\\mathbf{j} + 1 \\,\\mathbf{k},$ then along the curve we have $x = t^2,$ $y = t,$ and $z=1.$  \n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}(t)\\,j+\\frac{\\text{d}}{\\text{d}t}(1)\\,k \\\\  & =2t\\,i+1\\,j+0\\,k \\\\  & =2t\\,i+j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}z}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(2t)^{2}+{1}^{2}+{0}^{2}} \\\\  & =\\sqrt{4{t}^{2}+1}\\end{aligned}\n$$\n\nNow, since $f(x,y,z) = \\dfrac{x}{yz},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{{t}^{2}}{t\\cdot 1}=t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{\\sqrt{2}}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\sqrt{2}}t\\sqrt{4{t}^{2}+1}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u= 4t^2+1,$ $\\textrm d u=8t\\,\\textrm d t$ as follows: \n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{2}}t\\sqrt{4{t}^{2}+1}\\,\\text{d}t & ={\\int }_{1}^{9}\\frac{1}{8}{u}^{1/2}\\text{d}u \\\\  & =\\frac{1}{8}\\cdot \\frac{2}{3}{u}^{3/2}{|}_{1}^{9} \\\\  & =\\frac{1}{12}[{9}^{3/2}-{1}^{3/2}] \\\\  & =\\frac{1}{12}[27-1] \\\\  & =\\frac{1}{12}\\cdot 26 \\\\  & =\\frac{13}{6}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186133644 :question/id #uuid "f07dd3d3-606f-520f-a95e-04303aa32f24" :question/math-academy-id "e-6307" :question/problem "Find an integral that is equivalent to $\\displaystyle\\int\\limits_C xy^3 \\, \\textrm{d}s,$ where $C$ is the curve parametrized by $\\mathbf r(t)= \\left \\langle \\cos t, \\sin t \\right\\rangle$ for $t \\in \\left(0, \\dfrac{\\pi}{2}\\right).$" :question/worked-solution "![](images/f5/f53d78debfec5f8c50e0f3a5947d2a36126e18c073d7b0cc4c59d506753059b3.png)\n\nThe path of integration is shown above. We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t.\n$$\n\n \n\nHere, we have $f(x,y) =  xy^3$. Along the path, we have $x=\\cos t$ and $y=\\sin t,$ and so we get\n\n$$\n\\begin{aligned}f(r(t)) & =f(\\operatorname{cos}⁡t,\\operatorname{sin}⁡t) \\\\  & =\\operatorname{cos}⁡t\\cdot (\\operatorname{sin}⁡t)^{3} \\\\  & ={sin}^{3}⁡t\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)j \\\\  & =-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{{(-\\operatorname{sin}⁡t)}^{2}+{(\\operatorname{cos}⁡t)}^{2}} \\\\  & =\\sqrt{{sin}^{2}⁡t+{cos}^{2}⁡t} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}x{y}^{3}\\,\\text{d}s & ={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}{sin}^{3}⁡t\\operatorname{cos}⁡t\\cdot 1\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}{sin}^{3}⁡t\\operatorname{cos}⁡t\\,\\text{d}t.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\int\\limits_C xy^3 \\, \\textrm{d}s = \\int^{\\pi/2}_{0} \\sin^3 t \\cos t \\, \\textrm{d}t .\n$$"} {:db/id #edb/ref 17592186133645 :question/id #uuid "8bf6a863-9b9f-5877-84bc-3e11d71261c9" :question/math-academy-id "e-6308" :question/problem "Evaluate the integral $\\displaystyle\\int\\limits_{C}xy\\,\\textrm{d}s,$ where $C$ is the curve parametrized by $\\mathbf{r}(t) = 3t\\,\\mathbf{i}+4t\\,\\mathbf{j}\\,$ for $0\\leq t\\leq 1.$" :question/worked-solution "To calculate the line integral, we will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t.\n$$\n\n \n\nSince $\\mathbf{r}(t) = 3t\\,\\mathbf{i}+4t\\,\\mathbf{j},$ then along the curve we have $x=3t$ and $y=4t.$\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3t)i+\\frac{\\text{d}}{\\text{d}t}(4t)j \\\\  & =3\\,i+4\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{{3}^{2}+{4}^{2}} \\\\  & =\\sqrt{{5}^{2}} \\\\  & =5\\end{aligned}\n$$\n\nNow, if $f(x,y) =xy,$ then we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =3t\\cdot 4t \\\\  & =12{t}^{2}.\\end{aligned}\n$$\n\n \n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}xy\\,\\text{d}s & ={\\int }_{0}^{1}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}12{t}^{2}\\cdot 5\\,\\text{d}t \\\\  & =60{\\int }_{0}^{1}{t}^{2}\\,\\text{d}t \\\\  & =60{[\\frac{{t}^{3}}{3}]}_{0}^{1} \\\\  & =20{[{t}^{3}]}_{0}^{1} \\\\  & =20.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186133685 :question/id #uuid "f084687c-bbe3-5506-b803-ae2c7e450a8b" :question/math-academy-id "e-8582" :question/problem "Let $V=\\mathcal{C}\\left[0,2\\pi\\right]$ be the vector space of all functions that are continuous on $\\left[0,2\\pi\\right],$ equipped with the inner product \n\n$$\n\\langle f(t),g(t) \\rangle = \\displaystyle\\int_{0}^{2\\pi} f(t) g(t) \\, \\textrm{d}t.\n$$\n\nGiven the functions $f(t) = \\cos t$ and $g(t)=\\sin 2t,$ which of the following statements are true?\n\nI. $\\langle f(t), g(t) \\rangle = 0$\n\nII. $\\langle f(t), g(t) \\rangle = \\dfrac{\\pi}{2}$\n\nIII. $f(t) \\perp g(t)$ with respect to the inner product $\\langle \\cdot, \\cdot \\rangle$ in $V$\n\n*Hint: You may wish to make use of the identity* $\\sin\\alpha\\cos\\beta=\\dfrac12(\\sin(\\alpha-\\beta)+\\sin(\\alpha+\\beta)).$" :question/worked-solution "We need to evaluate\n\n$$\n\\langle f(t), g(t) \\rangle  =  \\int_{0}^{2\\pi}\\cos{t} \\sin2t \\,\\textrm{d}t.\n$$\n\nWe can evaluate this integral using the given identity, as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2\\pi }\\operatorname{sin}⁡2t\\,\\operatorname{cos}⁡t\\,\\text{d}t & =\\frac{1}{2}{\\int }_{0}^{2\\pi }(\\operatorname{sin}⁡(2t-t)+\\operatorname{sin}⁡(2t+t))\\,\\text{d}t \\\\  & =\\frac{1}{2}{\\int }_{0}^{2\\pi }(\\operatorname{sin}⁡t+\\operatorname{sin}⁡3t)\\,\\text{d}t \\\\  & =\\frac{1}{2}(-\\operatorname{cos}⁡t-\\frac{\\operatorname{cos}⁡3t}{3}){|}_{0}^{2\\pi } \\\\  & =\\frac{1}{2}[-\\operatorname{cos}⁡(2\\pi )-\\frac{\\operatorname{cos}⁡(6\\pi )}{3}]-\\frac{1}{2}[-\\operatorname{cos}⁡0-\\frac{\\operatorname{cos}⁡0}{3}] \\\\  & =\\frac{1}{2}[-1-\\frac{1}{3}]-\\frac{1}{2}[-1-\\frac{1}{3}] \\\\  & =\\frac{1}{2}\\cdot \\left(-\\frac{4}{3}\\right)-\\frac{1}{2}\\cdot \\left(-\\frac{4}{3}\\right) \\\\  & =-\\frac{2}{3}+\\frac{2}{3} \\\\  & =0\\end{aligned}\n$$\n\nLet's now examine the statements:\n\n- Statement I is true, while statement II is false.\n\n- Statement III is true. Since the inner product is zero, our vectors are orthogonal.\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186133709 :question/id #uuid "e45bef0c-86ba-5030-bb0c-274df22673f5" :question/math-academy-id "e-9521" :question/problem "Evaluate $\\displaystyle \\int_C \\left(x^2 + y^2\\right)\\,\\textrm d y,$ where $C$ is the path along the upper-right quarter of the circle $x^2 + y^2 = 4,$ traversed from the point $(2,0)$ to the point $(0,2),$ as shown below.\n\n![](images/8f/8fc3a36829c9780c34e13f253d607c3849bfd3ef1399a77a79a3dd3d30ef7140.png)" :question/worked-solution "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}y = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\dfrac{\\text{d}y}{\\text{d}t} \\, \\textrm{d}t.\n$$\n\nThe curve $C$ is a quarter of a circle of radius $2$ centered at $O.$ It can be parameterized as \n\n$$\n\\mathbf{r}(t) = \\big\\langle 2\\cos{t}, \\: 2\\sin{t} \\big\\rangle, \\qquad 0 \\le t \\le \\dfrac{\\pi}{2}.\n$$\n\nComputing $\\dfrac{\\textrm{d}y}{\\textrm{d}t},$ we get the following:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)=2\\operatorname{cos}⁡t\\end{aligned}\n$$\n\nNow, since $f(x,y) = x^2 + y^2$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(2\\operatorname{cos}⁡t)^{2}+(2\\operatorname{sin}⁡t)^{2} \\\\  & =4({cos}^{2}⁡t+{sin}^{2}⁡t) \\\\  & =4.\\end{aligned}\n$$\n\nWe can now evaluate the integral:\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}y & ={\\int }_{0}^{\\pi /2}f(r(t))\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}4\\cdot (2\\operatorname{cos}⁡t)\\cdot \\text{d}t \\\\  & =8{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =8\\operatorname{sin}⁡t\\,{|}_{0}^{\\pi /2} \\\\  & =8\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)-8\\operatorname{sin}⁡0 \\\\  & =8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186134084 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "099c51d1-91fb-55ee-987f-bff891e71b2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186256866} {:answer/id #uuid "36c1045e-ca0b-598a-af18-e80132339c9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186257262} {:answer/id #uuid "86d6990c-bef3-51f4-9954-5afedefe853c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186257965} {:answer/id #uuid "889b3465-0076-578d-8931-4a15986da352" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186257979} {:answer/id #uuid "fd053697-39b2-5e77-9cf0-6997020d6328" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186258994}] :answer-field/correct {:answer/id #uuid "86d6990c-bef3-51f4-9954-5afedefe853c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186257965} :answer-field/id #uuid "a94ee333-488f-593d-8e2c-fc868b0959b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259329}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cb08f302-8cb5-5978-acbb-0bba1cddced3" :question/math-academy-id "q-124123" :question/problem "![](images/84/8417d2d62e9213ec3f92108495107fc982dc399e52cca8982e01516457f5692a.png)\n\nEvaluate ${\\int }_{C}\\frac{2y}{x}\\,\\text{d}y,$ where $C$ is the path along the upper-right quarter of the ellipse $9{x}^{2}+4{y}^{2}=36,$ traversed from the point $(2,0)$ to the point $(0,3),$ as shown above." :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}y={\\int }_{a}^{b}f(r(t))\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t.\n$$\n\nNote that we can write the equation of our ellipse in the form\n\n$$\n\\frac{{x}^{2}}{{2}^{2}}+\\frac{{y}^{2}}{{3}^{2}}=1.\n$$\n\nSo, the curve $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $2$ and $3,$ respectively. Therefore, it can be parametrized as \n\n$$\nr(t)=⟨2\\operatorname{cos}⁡t,\\,3\\operatorname{sin}⁡t⟩,\\,0\\le t\\le \\frac{\\pi }{2}.\n$$\n\nComputing $\\frac{\\text{d}y}{\\text{d}t},$ we get the following:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t)=3\\operatorname{cos}⁡t\\end{aligned}\n$$\n\nNow, since $f(x,y)=\\frac{2y}{x}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{2\\cdot 3\\operatorname{sin}⁡t}{2\\operatorname{cos}⁡t} \\\\  & =3\\operatorname{tan}⁡t.\\end{aligned}\n$$\n\nWe can now evaluate the integral:\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}y & ={\\int }_{0}^{\\pi /2}f(r(t))\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}(3\\operatorname{tan}⁡t)\\cdot (3\\operatorname{cos}⁡t)\\cdot \\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}9\\operatorname{sin}⁡t\\,\\text{d}t \\\\  & =-9\\operatorname{cos}⁡t\\,{|}_{0}^{\\pi /2} \\\\  & =(-9\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right))-(-9\\operatorname{cos}⁡(0)) \\\\  & =9.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186134101 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aeb67126-f2b3-5385-ae58-f6aa47dd1135" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "55" :db/id #edb/ref 17592186369394} {:answer/id #uuid "6a1f51d1-849c-5c40-98ed-fc855b6f7397" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186369395} {:answer/id #uuid "1cbc2426-d8bc-5d9e-b636-6dd81e32cf26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "138" :db/id #edb/ref 17592186369396} {:answer/id #uuid "ee3e82f7-ed7f-5766-8b2b-b24890ff949c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186369397} {:answer/id #uuid "5ba0ac0c-d2ca-5864-b0a8-1497f9993024" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "169" :db/id #edb/ref 17592186369398}] :answer-field/correct {:answer/id #uuid "1cbc2426-d8bc-5d9e-b636-6dd81e32cf26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "138" :db/id #edb/ref 17592186369396} :answer-field/id #uuid "83851aef-4707-5c37-b41d-06a411ef4f5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369393}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "23de2113-f2a7-50b0-94a3-c0894b2b5ab4" :question/math-academy-id "q-126645" :question/problem "![](images/6b/6bda5a10df8a1ec081db97e7aa52755796f1d50be5447e3e64f55986116ada6e.png)\n\nCalculate \n${∮}_{∂D}x{y}^{2}\\,dx+({x}^{2}y+x{y}^{2})\\,dy,$\nwhere $D$ is the region shown above." :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nGreen's theorem can be extended to include regions containing holes. In such cases, we can apply Green's theorem in the same way as before.\n\nWe have that $P(x,y)=x{y}^{2}$ and $Q(x,y)={x}^{2}y+x{y}^{2}.$ Therefore,\n\n$$\n\\frac{∂P}{∂y}=2xy,\\,\\frac{∂Q}{∂x}=2xy+{y}^{2}.\n$$\n\nTherefore, applying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{∂D}x{y}^{2}\\,dx+({x}^{2}y+x{y}^{2})\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}(2xy+{y}^{2})-2xy\\,\\text{d}A \\\\  & ={∬}_{D}{y}^{2}\\,\\text{d}A.\\end{aligned}\n$$\n\nThe region $D$ can be represented in Cartesian coordinates as ${Δ}_{1}∖{Δ}_{2},$ where\n\n- ${Δ}_{1}=\\{(x,y)\\,:\\,-4\\le x\\le 4,-3\\le y\\le 3\\}$ is the region enclosed by the outer curve, and\n\n- ${Δ}_{2}=\\{(x,y)\\,:\\,0\\le x\\le 2,-1\\le y\\le 2\\}$ is the region enclosed by the inner curve.\n\nTherefore, our double integral becomes\n\n$$\n\\begin{aligned}{∬}_{D}{y}^{2}\\,\\text{d}A & ={∬}_{{Δ}_{1}}{y}^{2}\\,\\text{d}A-{∬}_{{Δ}_{2}}{y}^{2}\\,\\text{d}A \\\\  & ={\\int }_{-3}^{3}{\\int }_{-4}^{4}{y}^{2}\\,\\text{d}x\\,\\text{d}y-{\\int }_{-1}^{2}{\\int }_{0}^{2}{y}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{-4}^{4}\\,\\text{d}x{\\int }_{-3}^{3}{y}^{2}\\,\\text{d}y-{\\int }_{0}^{2}\\,\\text{d}x{\\int }_{-1}^{2}{y}^{2}\\,\\text{d}y \\\\  & =x\\,{|}_{-4}^{4}\\cdot \\frac{{y}^{3}}{3}\\,{|}_{-3}^{3}-x\\,{|}_{0}^{2}\\cdot \\frac{{y}^{3}}{3}{|}_{-1}^{2} \\\\  & =(4-(-4))\\cdot (9-(-9))-(2-0)\\cdot (\\frac{8}{3}-\\left(-\\frac{1}{3}\\right)) \\\\  & =8\\cdot 18-2\\cdot 3 \\\\  & =138.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186134140 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "305d1aaf-bbea-5c5f-a549-96aeb913edda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186279014} {:answer/id #uuid "7052a4ed-9911-5fd7-bc04-95f5aa7e4565" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186279610} {:answer/id #uuid "774d71e4-5b4e-524f-b577-edc0dd3ee10b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186279657} {:answer/id #uuid "ca898aae-6598-59af-88de-b8842924f741" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186280367} {:answer/id #uuid "cd52ceb4-0135-536f-8588-e294bafcb89b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186280401}] :answer-field/correct {:answer/id #uuid "cd52ceb4-0135-536f-8588-e294bafcb89b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186280401} :answer-field/id #uuid "f6048b0a-8782-5f08-a33d-6088d1e77789" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281271}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b54a2292-f496-593a-8f3d-c0762d77f082" :question/math-academy-id "q-162606" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=0,$ $x=2,$ $y=0,$ $y=1,$ $z=0,$ $z=\\frac{\\pi }{2}.$ Given that the surface $S$ is positively (outward) oriented and $F={x}^{2}\\operatorname{cos}⁡z\\,i+\\operatorname{sin}⁡z\\,j+(x+y)\\,k,$ find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}({x}^{2}\\operatorname{cos}⁡z)+\\frac{∂}{∂y}(\\operatorname{sin}⁡z)+\\frac{∂}{∂z}(x+y) \\\\  & =2x\\operatorname{cos}⁡z+0+0 \\\\  & =2x\\operatorname{cos}⁡z.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}2x\\operatorname{cos}⁡z\\,\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}{\\int }_{0}^{\\pi /2}2x\\operatorname{cos}⁡z\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}2x\\,\\text{d}x\\cdot {\\int }_{0}^{1}\\text{d}y\\cdot {\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡z\\,\\text{d}z \\\\  & =[{x}^{2}]_{x=0}^{x=2}\\cdot (1-0)\\cdot [\\operatorname{sin}⁡z]_{z=0}^{z=\\pi /2} \\\\  & =({2}^{2}-{0}^{2})\\cdot 1\\cdot (\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)-\\operatorname{sin}⁡0) \\\\  & =4\\cdot 1\\cdot 1 \\\\  & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186134193 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44b6551a-3fd7-5fc8-b776-155d7f42341e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186321689} {:answer/id #uuid "481e33e3-c704-521d-be35-4336e9e7bafb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186321714} {:answer/id #uuid "4f512c51-d026-5336-9280-75aeb2ef260f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186321768} {:answer/id #uuid "8076af1e-0cff-5bf9-b91a-db9180b146bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186322159} {:answer/id #uuid "ab0447bf-78d4-5413-b5da-eaeda4aa826d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186322490}] :answer-field/correct {:answer/id #uuid "44b6551a-3fd7-5fc8-b776-155d7f42341e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186321689} :answer-field/id #uuid "be362aea-3f36-5fc4-9815-88138f880b78" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323541}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1b47314b-c252-595b-b8b8-d7b952718a63" :question/math-academy-id "q-37863" :question/problem "Calculate ${∬}_{D}\\operatorname{sin}⁡(x+y)\\,dA,\\,$ where $D={(x,y)\\,:\\,0\\le x\\le \\frac{\\pi }{2},\\,0\\le y\\le x}.$" :question/worked-solution "The integral is defined over the type I region $D={(x,y)\\,:\\,0\\le x\\le \\frac{\\pi }{2},\\,0\\le y\\le x}.$ \n\nSo, we can express the integral, as follows:\n\n$$\n\\begin{aligned}{∬}_{D}\\operatorname{sin}⁡(x+y)\\,dA & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{x}\\operatorname{sin}⁡(x+y)\\,dy\\,dx\\end{aligned}\n$$\n\nFirst, we evaluate the inner integral by integrating with respect to $y$, treating $x$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}{\\int }_{0}^{x}\\operatorname{sin}⁡(x+y)\\,dy\\,dx & ={\\int }_{0}^{\\pi /2}[{\\int }_{0}^{x}\\operatorname{sin}⁡(x+y)\\,dy]\\,dx \\\\  & ={\\int }_{0}^{\\pi /2}[-\\operatorname{cos}⁡(x+y)]_{0}^{x}\\,dx \\\\  & ={\\int }_{0}^{\\pi /2}(-\\operatorname{cos}⁡(2x)+\\operatorname{cos}⁡x)\\,dx\\end{aligned}\n$$\n\nThen, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}(-\\operatorname{cos}⁡(2x)+\\operatorname{cos}⁡x)\\,dx & ={[-\\frac{1}{2}\\operatorname{sin}⁡(2x)+\\operatorname{sin}⁡x]}_{0}^{\\pi /2} \\\\  & =-\\frac{1}{2}\\operatorname{sin}⁡\\pi +\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)-0 \\\\  & =1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186134196 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1435c15c-cee2-5d63-99e5-950ff63fbcbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186321311} {:answer/id #uuid "36470a66-3fc0-52e3-8595-d34b998f8b45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186321561} {:answer/id #uuid "43603675-9305-525e-a36a-4ac8b0c1f71a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186321678} {:answer/id #uuid "517e72de-c47e-5705-a920-d0a098c5aa68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186321788} {:answer/id #uuid "cbe849ce-750d-523c-9c5c-cdf9f8962247" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186322730}] :answer-field/correct {:answer/id #uuid "cbe849ce-750d-523c-9c5c-cdf9f8962247" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186322730} :answer-field/id #uuid "1cd2908f-886b-5e6a-b664-20111c79418b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323225}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8f095d13-dd7c-5406-aa62-9362d833b9d3" :question/math-academy-id "q-37995" :question/problem "Calculate ${\\int }_{0}^{\\sqrt[3]{\\pi /2}}{\\int }_{0}^{{y}^{2}}\\operatorname{sin}⁡{y}^{3}\\,dx\\,dy.$" :question/worked-solution "The integral is defined over a type II region.\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt[3]{\\pi /2}}{\\int }_{0}^{{y}^{2}}\\operatorname{sin}⁡{y}^{3}\\,dx\\,dy & ={\\int }_{0}^{\\sqrt[3]{\\pi /2}}\\operatorname{sin}⁡{y}^{3}[{\\int }_{0}^{{y}^{2}}dx]dy \\\\  & ={\\int }_{0}^{\\sqrt[3]{\\pi /2}}\\operatorname{sin}⁡{y}^{3}[x]_{0}^{{y}^{2}}\\,dy \\\\  & ={\\int }_{0}^{\\sqrt[3]{\\pi /2}}\\operatorname{sin}⁡{y}^{3}({y}^{2}-0)\\,dy \\\\  & ={\\int }_{0}^{\\sqrt[3]{\\pi /2}}{y}^{2}\\operatorname{sin}⁡{y}^{3}\\,dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt[3]{\\pi /2}}{y}^{2}\\operatorname{sin}⁡{y}^{3}\\,dy & ={[-\\frac{\\operatorname{cos}⁡{y}^{3}}{3}]}_{0}^{\\sqrt[3]{\\pi /2}} \\\\  & =-\\frac{1}{3}(\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right)-\\operatorname{cos}⁡(0)) \\\\  & =-\\frac{1}{3}(0-1) \\\\  & =\\frac{1}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186134201 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "133eafdf-8b1b-5f1e-970a-ff8b46c6c703" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186324142} {:answer/id #uuid "4c334839-5b30-57fb-987f-491ba05009bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186324595} {:answer/id #uuid "6f51e605-f913-5a44-9e67-faf1f088436f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186324886} {:answer/id #uuid "e31ec296-1126-5c08-9cea-da8982c72d20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186325967} {:answer/id #uuid "fe1135b3-8015-51a5-93d8-9fb4ab3c77bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186326212}] :answer-field/correct {:answer/id #uuid "fe1135b3-8015-51a5-93d8-9fb4ab3c77bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186326212} :answer-field/id #uuid "9db5292a-83c4-57af-ab9d-6fd9b12906d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326504}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "687f42ad-4d31-5616-a543-616339685f35" :question/math-academy-id "q-39205" :question/problem "If $u=\\begin{bmatrix}-1 \\\\ -3 \\\\ -2 \\\\ 1\\end{bmatrix}\\,,$ $v=\\begin{bmatrix}-3 \\\\ -1 \\\\ -2 \\\\ 2\\end{bmatrix}\\,,$ and $u\\cdot u=15,$ then $\\frac{u\\cdot (\\frac{1}{2}u)}{u\\cdot (\\frac{3}{4}v)}=$" :question/worked-solution "We will use the fact that the dot product is linear.\n\nTo quickly compute the numerator $u\\cdot (\\frac{1}{2}u),$ we multiply $u\\cdot u$ by $\\frac{1}{2}.$ Doing this, we get\n\n$$\n\\begin{aligned}u\\cdot (\\frac{1}{2}u) & =\\frac{1}{2}(u\\cdot u) \\\\  & =\\frac{1}{2}\\cdot 15 \\\\  & =\\frac{15}{2}.\\end{aligned}\n$$\n\nTo quickly compute the denominator $u\\cdot (\\frac{3}{4}v),$ we compute $u\\cdot v$ first and then multiply the result by $\\frac{3}{4}.$ Doing this, we get\n\n$$\n\\begin{aligned}u\\cdot (\\frac{3}{4}v) & =\\frac{3}{4}(u\\cdot v) \\\\  & =\\frac{3}{4}({u}_{1}\\cdot {v}_{1}+{u}_{2}\\cdot {v}_{2}+{u}_{3}\\cdot {v}_{3}+{u}_{4}\\cdot {v}_{4}) \\\\  & =\\frac{3}{4}((-1)\\cdot (-3)+(-3)\\cdot (-1)+(-2)\\cdot (-2)+1\\cdot 2) \\\\  & =\\frac{3}{4}(3+3+4+2) \\\\  & =\\frac{3}{4}\\cdot 12 \\\\  & =9.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{u\\cdot (\\frac{1}{2}u)}{u\\cdot (\\frac{3}{4}v)} & =\\frac{\\left(\\frac{15}{2}\\right)}{9}=\\frac{5}{6}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186134273 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "696c86b7-7406-5db3-98b7-9adf58c194d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{32.98}^{∘}" :db/id #edb/ref 17592186324851} {:answer/id #uuid "9cb47094-4577-5387-92f8-951e09d5710a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{29.38}^{∘}" :db/id #edb/ref 17592186325301} {:answer/id #uuid "c33f7087-8e51-5047-b9d1-8c5802522073" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{38.29}^{∘}" :db/id #edb/ref 17592186325651} {:answer/id #uuid "cb0b5594-9536-54a7-941d-e6d284d758ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{23.98}^{∘}" :db/id #edb/ref 17592186325729} {:answer/id #uuid "d4dd22da-cce6-53da-9f53-c722100d1b9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{83.29}^{∘}" :db/id #edb/ref 17592186325822}] :answer-field/correct {:answer/id #uuid "696c86b7-7406-5db3-98b7-9adf58c194d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{32.98}^{∘}" :db/id #edb/ref 17592186324851} :answer-field/id #uuid "79853d7e-c61a-5dd2-b3c1-de684e30352a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326438}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "961a93f3-4659-59c1-955c-0c479788bf13" :question/math-academy-id "q-40223" :question/problem "Consider the vector $x$ and the subspace $S=\\text{Span}{{a}_{1},{a}_{2}}$ where\n\n$$\n{a}_{1}=\\begin{bmatrix}0 \\\\ 1 \\\\ -1\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}1 \\\\ 2 \\\\ 2\\end{bmatrix},\\,\\,x=\\begin{bmatrix}1 \\\\ 1 \\\\ -1\\end{bmatrix}.\n$$\n\nFind the acute angle between $x$ and the subspace $S$ given that the set ${{a}_{1},{a}_{2}}$ is orthogonal.   Round the answer to $2$ decimal places." :question/requires-calculator true :question/worked-solution "Since the set ${{a}_{1},{a}_{2}}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}}$ and $\\text{Span}{{a}_{2}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{1\\cdot 0+1\\cdot 1+(-1)\\cdot (-1)}{{0}^{2}+{1}^{2}+{(-1)}^{2}}{a}_{1}=\\begin{bmatrix}0 \\\\ 1 \\\\ -1\\end{bmatrix} \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{1\\cdot 1+1\\cdot 2+(-1)\\cdot 2}{{1}^{2}+{2}^{2}+{2}^{2}}{a}_{2}=\\frac{1}{9}\\begin{bmatrix}1 \\\\ 2 \\\\ 2\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x \\\\  & =\\begin{bmatrix}0 \\\\ 1 \\\\ -1\\end{bmatrix}+\\frac{1}{9}\\begin{bmatrix}1 \\\\ 2 \\\\ 2\\end{bmatrix} \\\\  & =\\frac{1}{9}(\\begin{bmatrix}0 \\\\ 9 \\\\ -9\\end{bmatrix}+\\begin{bmatrix}1 \\\\ 2 \\\\ 2\\end{bmatrix}) \\\\  & =\\frac{1}{9}\\begin{bmatrix}1 \\\\ 11 \\\\ -7\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x$ or any other non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ So, to make calculations easier, we can find the angle between the vectors\n\n$\\,$ $x=\\begin{bmatrix}1 \\\\ 1 \\\\ -1\\end{bmatrix}\\,$ and $\\,9\\,{\\text{proj}}_{S}x=\\begin{bmatrix}1 \\\\ 11 \\\\ -7\\end{bmatrix}.$\n\nComputing the cosine using the dot product, we obtain \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{1\\cdot 1+1\\cdot 11+(-1)\\cdot (-7)}{\\sqrt{{1}^{2}+{1}^{2}+(-1)^{2}}\\sqrt{{1}^{2}+{11}^{2}+(-7)^{2}}} \\\\  & =\\frac{19}{\\sqrt{3}\\sqrt{171}} \\\\  & =\\frac{19}{\\sqrt{3}\\cdot 3\\sqrt{19}} \\\\  & =\\frac{\\sqrt{57}}{9}.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡\\left(\\frac{\\sqrt{57}}{9}\\right)≈{32.98}^{∘},\n$$\n\nwhich is already an acute angle."} {:db/id #edb/ref 17592186134276 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e006fbf-73db-5714-80d3-da70e1961752" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{\\int }_{0}^{\\sqrt{2}}t\\sqrt{4{t}^{2}+1}\\,\\text{d}t." :db/id #edb/ref 17592186324338} {:answer/id #uuid "4454bda2-b710-5b8e-962a-af8f72db9bed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\sqrt{2}}t\\sqrt{2{t}^{2}+1}\\,\\text{d}t." :db/id #edb/ref 17592186324524} {:answer/id #uuid "969d3d60-bae9-5b94-bb58-6e2e78279810" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}{\\int }_{0}^{\\sqrt{2}}t\\sqrt{2{t}^{2}-1}\\,\\text{d}t." :db/id #edb/ref 17592186325255} {:answer/id #uuid "dc88ce8a-6d69-5cce-ae62-6e652a14c027" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{\\int }_{0}^{\\sqrt{2}}t\\sqrt{8{t}^{2}+1}\\,\\text{d}t." :db/id #edb/ref 17592186325896} {:answer/id #uuid "e1fc0716-e381-59ad-99c7-f5348e2706dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{\\sqrt{2}}t\\sqrt{4{t}^{2}+1}\\,\\text{d}t." :db/id #edb/ref 17592186325951}] :answer-field/correct {:answer/id #uuid "2e006fbf-73db-5714-80d3-da70e1961752" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{\\int }_{0}^{\\sqrt{2}}t\\sqrt{4{t}^{2}+1}\\,\\text{d}t." :db/id #edb/ref 17592186324338} :answer-field/id #uuid "aa3112f0-f6c4-537c-b0c9-7b639ee76cae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326527}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "13f50e74-e351-581a-98f5-c8e27aa5380d" :question/math-academy-id "q-40253" :question/problem "Which of the following is equivalent to ${\\int }_{C}f(x,y)\\,\\text{d}s,$ where $f(x,y)=\\sqrt{2}(x-y)$ and the curve $C$ is parametrized \n by $r(t)=⟨{t}^{2}+t,\\,{t}^{2}-t⟩$ for $t\\in [0,\\sqrt{2}]?$" :question/worked-solution "Since $r(t)=⟨{t}^{2}+t,\\,{t}^{2}-t⟩,$ then along the curve we have $x={t}^{2}+t,$ and $y={t}^{2}-t.$ \n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+t)i+\\frac{\\text{d}}{\\text{d}t}({t}^{2}-t)j \\\\  & =(2t+1)\\,i+(2t-1)\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}} \\\\  & =\\sqrt{(2t+1)^{2}+(2t-1)^{2}} \\\\  & =\\sqrt{4{t}^{2}+4t+1+4{t}^{2}-4t+1} \\\\  & =\\sqrt{8{t}^{2}+2} \\\\  & =\\sqrt{2}\\sqrt{4{t}^{2}+1}\\end{aligned}\n$$\n\n \n\nNow, since $f(x,y)=\\sqrt{2}(x-y)$, we obtain \n\n$$\n\\begin{aligned}f(r(t)) & =\\sqrt{2}[({t}^{2}+t)-({t}^{2}-t)] \\\\  & =2\\sqrt{2}t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{\\sqrt{2}}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\sqrt{2}}2\\sqrt{2}t\\cdot \\sqrt{2}\\sqrt{4{t}^{2}+1}\\cdot \\text{d}t \\\\  & =4{\\int }_{0}^{\\sqrt{2}}t\\sqrt{4{t}^{2}+1}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186134295 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "053a0d78-9998-5fa8-81c1-ec3b9c782255" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{7}" :db/id #edb/ref 17592186324019} {:answer/id #uuid "0577844d-244c-534d-967e-17ab50a051e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{7}" :db/id #edb/ref 17592186324020} {:answer/id #uuid "753a1396-682b-5494-880d-ba48084a59d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186324945} {:answer/id #uuid "8b78e9f8-9cbc-5a87-b530-264026f5e808" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{5}" :db/id #edb/ref 17592186325157} {:answer/id #uuid "a76bae24-1ac5-56f9-9322-b4ead379bc13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186325398}] :answer-field/correct {:answer/id #uuid "753a1396-682b-5494-880d-ba48084a59d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186324945} :answer-field/id #uuid "39b54509-46fd-5e0e-8f3d-4326afae4b03" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326316}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "706daa06-6654-51cd-8ce5-90b88ebad445" :question/math-academy-id "q-40559" :question/problem "Find the acute angle between the vectors $v=\\begin{bmatrix}3 \\\\ -\\sqrt{5} \\\\ 7 \\\\ 1\\end{bmatrix}$ and $w=\\begin{bmatrix}-1 \\\\ 1 \\\\ 5 \\\\ \\sqrt{5}\\end{bmatrix}.$" :question/requires-calculator true :question/worked-solution "Using the formula\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{v\\cdot w}{‖v‖\\,‖w‖},\n$$\n\nwe have the following:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{3\\cdot (-1)+(-\\sqrt{5})\\cdot 1+7\\cdot 5+1\\cdot \\sqrt{5}}{\\sqrt{{3}^{2}+(-\\sqrt{5})^{2}+{7}^{2}+{1}^{2}}\\,\\sqrt{(-1)^{2}+{1}^{2}+{5}^{2}+(\\sqrt{5})^{2}}} \\\\  & =\\frac{32}{\\sqrt{64}\\cdot \\sqrt{32}} \\\\  & =\\frac{\\sqrt{32}}{8} \\\\  & =\\frac{4\\sqrt{2}}{8} \\\\  & =\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡\\left(\\frac{\\sqrt{2}}{2}\\right)=\\frac{\\pi }{4}.\n$$"} {:db/id #edb/ref 17592186134300 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96be9367-3974-5e43-9065-674c96f9d52e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{5}" :db/id #edb/ref 17592186373039} {:answer/id #uuid "43cb05da-18c7-523d-91ac-2ba4f915beee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186373040} {:answer/id #uuid "35fff824-80db-5d3d-a944-43b3f274b775" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186373041} {:answer/id #uuid "f72442e8-cc3d-5b0d-8121-a36f5f6f77c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{5}" :db/id #edb/ref 17592186373042} {:answer/id #uuid "a143909a-1c57-5867-ab51-079e67a44a3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186373043}] :answer-field/correct {:answer/id #uuid "a143909a-1c57-5867-ab51-079e67a44a3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186373043} :answer-field/id #uuid "06a5bcdf-7363-5a46-9be0-a09ed9a92fa0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373038}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2c213b52-b119-57bd-9ee2-819532e6eca1" :question/math-academy-id "q-40604" :question/problem "Consider the vector $x$ and the subspace $S=\\text{Span}\\{v,w\\},$ where\n\n$$\nv=\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix},\\,w=\\begin{bmatrix}2 \\\\ -1 \\\\ -1\\end{bmatrix},\\,\\,x=\\begin{bmatrix}3 \\\\ 3 \\\\ 0\\end{bmatrix}.\n$$\n\nFind the acute angle between $x$ and the subspace $S$ given that the set $\\{v,w\\}$ is orthogonal." :question/requires-calculator true :question/worked-solution "Since the set $\\{v,w\\}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{v}x+{\\text{proj}}_{w}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}\\{v\\}$ and $\\text{Span}\\{w\\}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{v}\\,x & =\\frac{x\\cdot v}{v\\cdot v}v=\\frac{3\\cdot 1+3\\cdot 1+0\\cdot 1}{{1}^{2}+{1}^{2}+{1}^{2}}v=2\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}2 \\\\ 2 \\\\ 2\\end{bmatrix} \\\\ {\\text{proj}}_{w}\\,x & =\\frac{x\\cdot w}{w\\cdot w}w=\\frac{3\\cdot 2+3\\cdot (-1)+0\\cdot (-1)}{{2}^{2}+(-1)^{2}+(-1)^{2}}w=\\frac{1}{2}\\begin{bmatrix}2 \\\\ -1 \\\\ -1\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x \\\\  & =\\begin{bmatrix}2 \\\\ 2 \\\\ 2\\end{bmatrix}+\\frac{1}{2}\\begin{bmatrix}2 \\\\ -1 \\\\ -1\\end{bmatrix} \\\\  & =\\frac{1}{2}(2\\begin{bmatrix}2 \\\\ 2 \\\\ 2\\end{bmatrix}+\\begin{bmatrix}2 \\\\ -1 \\\\ -1\\end{bmatrix}) \\\\  & =\\frac{3}{2}\\begin{bmatrix}2 \\\\ 1 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x$ or any other non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ So, to make calculations easier, we can find the angle between the vectors\n\n$\\,$ $x=\\begin{bmatrix}3 \\\\ 3 \\\\ 0\\end{bmatrix}\\,$ and $\\,\\frac{2}{3}{\\text{proj}}_{S}x=\\begin{bmatrix}2 \\\\ 1 \\\\ 1\\end{bmatrix}.$\n\nComputing the cosine using the dot product, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{3\\cdot 2+3\\cdot 1+0\\cdot 1}{\\sqrt{{3}^{2}+{3}^{2}+{0}^{2}}\\sqrt{{2}^{2}+{1}^{2}+{1}^{2}}} \\\\  & =\\frac{9}{\\sqrt{18}\\sqrt{6}} \\\\  & =\\frac{9}{6\\sqrt{3}} \\\\  & =\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡\\left(\\frac{\\sqrt{3}}{2}\\right)=\\frac{\\pi }{6},\n$$\n\nwhich is already an acute angle."} {:db/id #edb/ref 17592186134312 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02a9e964-e971-5a63-8ddf-d35611c16d45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186323997} {:answer/id #uuid "3b6569f2-157f-59bd-b487-d77abba9f8d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186324450} {:answer/id #uuid "4ee6004c-940f-594a-9082-a66d246e0808" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186324618} {:answer/id #uuid "7e307e2d-eb04-5931-a49e-da669978c621" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186325033} {:answer/id #uuid "c2a72c2b-2e25-5ac5-9983-7b64eb42b19a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186325644}] :answer-field/correct {:answer/id #uuid "4ee6004c-940f-594a-9082-a66d246e0808" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186324618} :answer-field/id #uuid "67bfe10d-3e1e-5ac4-80e9-14d87bdcdeaa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326398}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5fc90254-ed2d-508a-b704-d310ff8d6596" :question/math-academy-id "q-40741" :question/problem "$$\nA=\\begin{bmatrix}3 & 2 \\\\ -1 & 1 \\\\ 0 & 2\\end{bmatrix},\\,B=\\{\\begin{bmatrix}3 \\\\ -1 \\\\ 0\\end{bmatrix},\\begin{bmatrix}a \\\\ b \\\\ c\\end{bmatrix}\\}\n$$\n\nConsider the subspace $\\text{Col}(A)$ and an orthogonal basis $B$ of $\\text{Col}(A),$ where $A$ and $B$ are given above. Given that $B$ is derived from $\\text{Col}(A)$ using the Gram-Schmidt process, what is the value of $\\frac{b}{a}?$" :question/worked-solution "Recall that $\\text{Col}(A)$ is the span of the columns of $A.$ \n\nFirst, let's denote\n\n$\\,$ ${a}_{1}=\\begin{bmatrix}3 \\\\ -1 \\\\ 0\\end{bmatrix}\\,$ and $\\,{a}_{2}=\\begin{bmatrix}2 \\\\ 1 \\\\ 2\\end{bmatrix}.$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}3 \\\\ -1 \\\\ 0\\end{bmatrix}.$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{2\\cdot 3+1\\cdot (-1)+2\\cdot 0}{{3}^{2}+(-1)^{2}+{0}^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}2 \\\\ 1 \\\\ 2\\end{bmatrix}-\\frac{1}{2}\\begin{bmatrix}3 \\\\ -1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{1}{2} \\\\ \\frac{3}{2} \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, $B=\\{{v}_{1},{v}_{2}\\}=\\{\\begin{bmatrix}3 \\\\ -1 \\\\ 0\\end{bmatrix},\\begin{bmatrix}\\frac{1}{2} \\\\ \\frac{3}{2} \\\\ 2\\end{bmatrix}\\}$ is an orthogonal basis for $\\text{Col}(A).$\n\nFinally, $a=\\frac{1}{2},$ $b=\\frac{3}{2},$ and  \n\n$$\n\\frac{b}{a}=\\frac{\\left(\\frac{3}{2}\\right)}{\\left(\\frac{1}{2}\\right)}=3.\n$$"} {:db/id #edb/ref 17592186134313 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b624c1f-1b60-5dd8-abfe-9da6e52411e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186324584} {:answer/id #uuid "a9ec8179-b01b-532c-9f91-b749c43140de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186325418} {:answer/id #uuid "ae563ac0-939c-5f03-81d5-1227b82b6c96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186325451} {:answer/id #uuid "cfdfdf8a-301b-54ee-90d3-09abc853ed90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186325780} {:answer/id #uuid "f54c57fe-d338-5ec8-9e93-8cfbee220971" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186326128}] :answer-field/correct {:answer/id #uuid "4b624c1f-1b60-5dd8-abfe-9da6e52411e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186324584} :answer-field/id #uuid "1c392514-ee84-536d-8e3c-8929a75a1a4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326273}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "731d0e77-652d-5ad5-8b5e-6cbd6ab44a82" :question/math-academy-id "q-40772" :question/problem "$$\nA=\\begin{bmatrix}-1 & 1 & 2 \\\\ 1 & 3 & -1 \\\\ -1 & 1 & 2 \\\\ -1 & 1 & 1\\end{bmatrix},\\,B={\\begin{bmatrix}-1 \\\\ 1 \\\\ -1 \\\\ -1\\end{bmatrix},\\begin{bmatrix}1 \\\\ 3 \\\\ 1 \\\\ 1\\end{bmatrix},\\begin{bmatrix}a \\\\ b \\\\ c \\\\ d\\end{bmatrix}}\n$$\n\nConsider the subspace $V=\\text{Col}(A)$ spanned by the columns ${a}_{1},{a}_{2},{a}_{3}$ of the matrix $A$ and an orthogonal basis $B$ of $\\text{Col}(A),$ shown above. Given that ${a}_{1}⊥{a}_{2},$ and that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $\\frac{a}{d}?$" :question/worked-solution "Since the first two vectors are already orthogonal, we proceed to find an orthogonal basis using the Gram-Schmidt process, as follows:\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}-1 \\\\ 1 \\\\ -1 \\\\ -1\\end{bmatrix}.$\n\n**Step 2**: We set ${v}_{2}={a}_{2}=\\begin{bmatrix}1 \\\\ 3 \\\\ 1 \\\\ 1\\end{bmatrix}.$\n\n**Step 3**. Next, we find ${v}_{3}$ using the formula\n\n$$\n\\begin{aligned}{v}_{3} & ={a}_{3}-{\\text{proj}}_{{v}_{1}}\\,{a}_{3}-{\\text{proj}}_{{v}_{2}}\\,{a}_{3} \\\\  & ={a}_{3}-\\frac{{a}_{3}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}-\\frac{{a}_{3}\\cdot {v}_{2}}{{v}_{2}\\cdot {v}_{2}}{v}_{2}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{3}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{3} & =\\begin{bmatrix}2 \\\\ -1 \\\\ 2 \\\\ 1\\end{bmatrix}-\\left(-\\frac{6}{4}\\right)\\begin{bmatrix}-1 \\\\ 1 \\\\ -1 \\\\ -1\\end{bmatrix}-\\frac{2}{12}\\begin{bmatrix}1 \\\\ 3 \\\\ 1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ -1 \\\\ 2 \\\\ 1\\end{bmatrix}+\\frac{3}{2}\\begin{bmatrix}-1 \\\\ 1 \\\\ -1 \\\\ -1\\end{bmatrix}-\\frac{1}{6}\\begin{bmatrix}1 \\\\ 3 \\\\ 1 \\\\ 1\\end{bmatrix} \\\\  & =\\frac{1}{6}(6\\begin{bmatrix}2 \\\\ -1 \\\\ 2 \\\\ 1\\end{bmatrix}+9\\begin{bmatrix}-1 \\\\ 1 \\\\ -1 \\\\ -1\\end{bmatrix}-\\begin{bmatrix}1 \\\\ 3 \\\\ 1 \\\\ 1\\end{bmatrix}) \\\\  & =\\begin{bmatrix}\\frac{1}{3} \\\\ 0 \\\\ \\frac{1}{3} \\\\ -\\frac{2}{3}\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, \n\n$$\n\\frac{a}{d}=\\frac{\\left(\\frac{1}{3}\\right)}{\\left(-\\frac{2}{3}\\right)}=-\\frac{1}{2}.\n$$"} {:db/id #edb/ref 17592186134314 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "282a29c7-1fd0-5be8-a8e7-2705d754060e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{2}" :db/id #edb/ref 17592186324292} {:answer/id #uuid "5fe23b62-20b1-5358-8a78-9c59ccfacc59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186324773} {:answer/id #uuid "86b639a0-d97d-5d64-bfe8-8b59aa2132bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186325118} {:answer/id #uuid "9a756353-0a2d-5737-9d09-92f4829ded99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{6}" :db/id #edb/ref 17592186325286} {:answer/id #uuid "d7b0d041-9d02-590d-9bdf-e957a0d66b56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{3}" :db/id #edb/ref 17592186325850}] :answer-field/correct {:answer/id #uuid "d7b0d041-9d02-590d-9bdf-e957a0d66b56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{3}" :db/id #edb/ref 17592186325850} :answer-field/id #uuid "4a69a7b5-d2ef-563a-9898-1e53f5a7c3b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326340}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f3f2a11e-deca-5786-9145-b4ada15e34fd" :question/math-academy-id "q-40774" :question/problem "$$\n{a}_{1}=\\begin{bmatrix}-1 \\\\ 1 \\\\ 1 \\\\ -1\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-1 \\\\ -3 \\\\ 1 \\\\ -1\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}2 \\\\ 1 \\\\ -1 \\\\ 2\\end{bmatrix},\\,B={\\begin{bmatrix}| \\\\ \\frac{{a}_{1}}{‖{a}_{1}‖} \\\\ |\\end{bmatrix}\\,,\\begin{bmatrix}| \\\\ \\frac{{a}_{2}}{‖{a}_{2}‖} \\\\ |\\end{bmatrix}\\,,\\begin{bmatrix}a \\\\ b \\\\ c \\\\ d\\end{bmatrix}}\n$$\n\nSuppose that $V=\\text{Span}{{a}_{1},{a}_{2},{a}_{3}}.$ Given that $B$ is an **orthonormal** basis for $V,{a}_{1}⊥{a}_{2},$ and that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $|\\,c\\,|?$" :question/worked-solution "Since the first two vectors are already orthogonal, we proceed to find an orthogonal basis using the Gram-Schmidt process, as follows:\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}-1 \\\\ 1 \\\\ 1 \\\\ -1\\end{bmatrix}.$\n\n**Step 2**: We set ${v}_{2}={a}_{2}=\\begin{bmatrix}-1 \\\\ -3 \\\\ 1 \\\\ -1\\end{bmatrix}.$\n\n**Step 3**. Next, we find ${v}_{3}$ using the formula\n\n$$\n\\begin{aligned}{v}_{3} & ={a}_{3}-{\\text{proj}}_{{v}_{1}}\\,{a}_{3}-{\\text{proj}}_{{v}_{2}}\\,{a}_{3} \\\\  & ={a}_{3}-\\frac{{a}_{3}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}-\\frac{{a}_{3}\\cdot {v}_{2}}{{v}_{2}\\cdot {v}_{2}}{v}_{2}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{3}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{3} & =\\begin{bmatrix}2 \\\\ 1 \\\\ -1 \\\\ 2\\end{bmatrix}-\\left(-\\frac{4}{4}\\right)\\begin{bmatrix}-1 \\\\ 1 \\\\ 1 \\\\ -1\\end{bmatrix}-\\left(-\\frac{8}{12}\\right)\\begin{bmatrix}-1 \\\\ -3 \\\\ 1 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ 1 \\\\ -1 \\\\ 2\\end{bmatrix}+\\begin{bmatrix}-1 \\\\ 1 \\\\ 1 \\\\ -1\\end{bmatrix}+\\frac{2}{3}\\begin{bmatrix}-1 \\\\ -3 \\\\ 1 \\\\ -1\\end{bmatrix} \\\\  & =\\frac{1}{3}(3\\begin{bmatrix}2 \\\\ 1 \\\\ -1 \\\\ 2\\end{bmatrix}+3\\begin{bmatrix}-1 \\\\ 1 \\\\ 1 \\\\ -1\\end{bmatrix}+2\\begin{bmatrix}-1 \\\\ -3 \\\\ 1 \\\\ -1\\end{bmatrix}) \\\\  & =\\frac{1}{3}\\begin{bmatrix}1 \\\\ 0 \\\\ 2 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we normalize ${v}_{3}$ dividing it by $‖{v}_{3}‖=\\frac{\\sqrt{6}}{3}:$\n\n$$\n\\begin{aligned}{u}_{3} & =\\frac{{v}_{3}}{‖{v}_{3}‖}=\\frac{1}{\\left(\\frac{\\sqrt{6}}{3}\\right)}\\cdot \\frac{1}{3}\\begin{bmatrix}1 \\\\ 0 \\\\ 2 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}\\frac{\\sqrt{6}}{6} \\\\ 0 \\\\ \\frac{\\sqrt{6}}{3} \\\\ \\frac{\\sqrt{6}}{6}\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, $|\\,c\\,|=\\frac{\\sqrt{6}}{3}.$"} {:db/id #edb/ref 17592186134317 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14065a4a-71ff-5466-9c12-277111399dfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186324152} {:answer/id #uuid "72bd1289-c0f5-5b37-bbe7-c8db2a9ba532" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{6}" :db/id #edb/ref 17592186324924} {:answer/id #uuid "c966d38f-084c-5b47-a343-de22588d2e0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186325719} {:answer/id #uuid "de19db4f-60da-5fae-aef6-10e79b2ee654" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186325908} {:answer/id #uuid "f3740363-a851-5fc6-8f09-61c9b59d8f85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186326115}] :answer-field/correct {:answer/id #uuid "f3740363-a851-5fc6-8f09-61c9b59d8f85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186326115} :answer-field/id #uuid "d3fdb597-eccb-5cf8-a1ef-571cb870dd05" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326606}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a8cba0e7-20f4-5963-a764-e829d0b2fd3f" :question/math-academy-id "q-40817" :question/problem "$$\nA=\\begin{bmatrix}2 & 2 & -4 \\\\ -2 & 1 & -2 \\\\ -2 & 1 & 4 \\\\ 2 & 0 & -2\\end{bmatrix},\\,B={\\begin{bmatrix}| \\\\ \\frac{{a}_{1}}{‖{a}_{1}‖} \\\\ |\\end{bmatrix}\\,,\\begin{bmatrix}| \\\\ \\frac{{a}_{2}}{‖{a}_{2}‖} \\\\ |\\end{bmatrix}\\,,\\begin{bmatrix}a \\\\ b \\\\ c \\\\ d\\end{bmatrix}}\n$$\n\nConsider the subspace $V=\\text{Col}(A)$ spanned by the columns ${a}_{1},{a}_{2},{a}_{3}$ of the matrix $A,$ and an **orthonormal** basis $B$ of $\\text{Col}(A),$ shown above. Given that ${a}_{1}⊥{a}_{2},$ and that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $|\\,c\\,|?$" :question/worked-solution "Since the first two vectors are already orthogonal, we proceed to find an orthogonal basis using the Gram-Schmidt process.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}2 \\\\ -2 \\\\ -2 \\\\ 2\\end{bmatrix}.$\n\n**Step 2**: We set ${v}_{2}={a}_{2}=\\begin{bmatrix}2 \\\\ 1 \\\\ 1 \\\\ 0\\end{bmatrix}.$\n\n**Step 3**. Next, we find ${v}_{3}$ using the formula\n\n$$\n\\begin{aligned}{v}_{3} & ={a}_{3}-{\\text{proj}}_{{v}_{1}}\\,{a}_{3}-{\\text{proj}}_{{v}_{2}}\\,{a}_{3} \\\\  & ={a}_{3}-\\frac{{a}_{3}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}-\\frac{{a}_{3}\\cdot {v}_{2}}{{v}_{2}\\cdot {v}_{2}}{v}_{2}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{3}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{3} & =\\begin{bmatrix}-4 \\\\ -2 \\\\ 4 \\\\ -2\\end{bmatrix}-\\left(-\\frac{16}{16}\\right)\\begin{bmatrix}2 \\\\ -2 \\\\ -2 \\\\ 2\\end{bmatrix}-\\left(-\\frac{6}{6}\\right)\\begin{bmatrix}2 \\\\ 1 \\\\ 1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4 \\\\ -2 \\\\ 4 \\\\ -2\\end{bmatrix}+\\begin{bmatrix}2 \\\\ -2 \\\\ -2 \\\\ 2\\end{bmatrix}+\\begin{bmatrix}2 \\\\ 1 \\\\ 1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ -3 \\\\ 3 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we normalize ${v}_{3}$ dividing it by $‖{v}_{3}‖=3\\sqrt{2}:$\n\n$$\n\\begin{aligned}{u}_{3} & =\\frac{{v}_{3}}{‖{v}_{3}‖}=\\frac{1}{3\\sqrt{2}}\\begin{bmatrix}0 \\\\ -3 \\\\ 3 \\\\ 0\\end{bmatrix}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}0 \\\\ -1 \\\\ 1 \\\\ 0\\end{bmatrix}=\\begin{bmatrix}0 \\\\ -\\frac{\\sqrt{2}}{2} \\\\ \\frac{\\sqrt{2}}{2} \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, $|\\,c\\,|=\\frac{\\sqrt{2}}{2}.$"} {:db/id #edb/ref 17592186134324 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fbcea61a-f7c5-5e90-95bf-e30e97fb1c5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186392397} {:answer/id #uuid "87a540ed-333f-527d-82f8-aa109a53d564" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186392398} {:answer/id #uuid "10193a27-2949-56aa-bfb7-aac130ca8727" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186392399} {:answer/id #uuid "2ce7f102-17d8-5df4-8505-ab11eafbcb85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{6}" :db/id #edb/ref 17592186392400} {:answer/id #uuid "5f83a4ce-78d8-5078-bb57-e6fcb33b7384" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt{3}" :db/id #edb/ref 17592186392401}] :answer-field/correct {:answer/id #uuid "10193a27-2949-56aa-bfb7-aac130ca8727" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186392399} :answer-field/id #uuid "ac78dc7d-8434-5df2-894a-caad12e5602a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392396}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "77f48d85-1f2c-59c8-b53a-85db3bc9d5a4" :question/math-academy-id "q-40838" :question/problem "$$\n\\overbrace{\\begin{bmatrix}-1 & 3 \\\\ 1 & -3 \\\\ 2 & -3\\end{bmatrix}}^{A}=\\overbrace{\\begin{bmatrix}{q}_{11} & {q}_{12} \\\\ {q}_{21} & {q}_{22} \\\\ {q}_{31} & {q}_{32}\\end{bmatrix}}^{Q}\\overbrace{\\begin{bmatrix}{r}_{11} & {r}_{12} \\\\ 0 & {r}_{22}\\end{bmatrix}}^{R}.\n$$\n\nConsider the QR factorization of the matrix $A$ shown above. Given that the columns ${q}_{1},{q}_{2}$ of $Q$ were obtained from the columns of $A$ using the Gram-Schmidt process, find  the value of ${q}_{22}\\cdot {r}_{12}.$" :question/worked-solution "Let ${a}_{1},{a}_{2}$ be the columns of $A.$\n\nFirst, we find an orthonormal basis of $\\text{Col}(A)=\\text{Span}\\{{a}_{1},{a}_{2}\\}$ using the Gram-Schmidt process.\n\n**Step 1**. We set ${v}_{1}={a}_{1}=\\begin{bmatrix}-1 \\\\ 1 \\\\ 2\\end{bmatrix}.$\n\n**Step 2**. We find the vector ${v}_{2}$ orthogonal to $\\text{Span}\\{{v}_{1}\\}$ using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-{\\text{proj}}_{{v}_{1}}{a}_{2} \\\\  & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1} \\\\  & =\\begin{bmatrix}3 \\\\ -3 \\\\ -3\\end{bmatrix}-\\left(-\\frac{12}{6}\\right)\\begin{bmatrix}-1 \\\\ 1 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ -3 \\\\ -3\\end{bmatrix}+2\\begin{bmatrix}-1 \\\\ 1 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nNext, we normalize ${v}_{1}$ and ${v}_{2}:$\n\n$$\n\\begin{aligned}{q}_{1} & =\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{6}}\\begin{bmatrix}-1 \\\\ 1 \\\\ 2\\end{bmatrix} \\\\ {q}_{2} & =\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{3}}\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$\n\nNext, we compute $R:$\n\n$$\n\\begin{aligned}R & ={Q}^{T}\\,A \\\\  & =\\begin{bmatrix}-\\frac{1}{\\sqrt{6}} & \\frac{1}{\\sqrt{6}} & \\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{3}} & -\\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{3}}\\end{bmatrix}\\begin{bmatrix}-1 & 3 \\\\ 1 & -3 \\\\ 2 & -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\sqrt{6} & -2\\sqrt{6} \\\\ 0 & \\sqrt{3}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we obtain the following QR factorization of $A:$\n\n$$\n\\overbrace{\\begin{bmatrix}-1 & 3 \\\\ 1 & -3 \\\\ 2 & -3\\end{bmatrix}}^{A}=\\overbrace{\\begin{bmatrix}-\\frac{1}{\\sqrt{6}} & \\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{6}} & -\\frac{1}{\\sqrt{3}} \\\\ \\frac{2}{\\sqrt{6}} & \\frac{1}{\\sqrt{3}}\\end{bmatrix}}^{Q}\\overbrace{\\begin{bmatrix}\\sqrt{6} & -2\\sqrt{6} \\\\ 0 & \\sqrt{3}\\end{bmatrix}}^{R}.\n$$\n\nFinally, ${q}_{22}\\cdot {r}_{12}=\\left(-\\frac{1}{\\sqrt{3}}\\right)\\cdot (-2\\sqrt{6})=2\\sqrt{2}.$"} {:db/id #edb/ref 17592186134325 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c0a2eeec-d409-5ca7-8836-a3d25261cadd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186131990} {:answer/id #uuid "d7957aea-c376-5087-a422-04cb0e2bbb1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186131991} {:answer/id #uuid "0d3fd9d2-a0e5-5ba0-9dda-d50e4f655c0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186131992} {:answer/id #uuid "18bbc620-9ee1-5aed-b0fa-c2de42c2c4ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186131993} {:answer/id #uuid "30437a8b-21ab-58fb-93da-4aacfdc01b0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186131994}] :answer-field/id #uuid "e55561d4-e43a-55c5-ae32-bb55dfa8f0c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186131989}] :question/id #uuid "ce1d4652-f9f7-5dc5-afd3-a06f20b33070" :question/math-academy-id "q-40842" :question/problem "What is $\\left(\\frac{1}{3}\\right)^{2}$?"} {:db/id #edb/ref 17592186134326 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "145087dc-06f8-558a-b8f8-2208b84355c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186364160} {:answer/id #uuid "ff44fb5d-5784-50a2-8670-9d33e2a5aacc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186364161} {:answer/id #uuid "b69119fb-822b-5880-80ae-95eff4fed6cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186364162} {:answer/id #uuid "2e7ca4a4-511e-50ee-bf48-b7280e7b04b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186364163} {:answer/id #uuid "6986252e-a34a-52a9-8eb9-deea8952c9f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186364164}] :answer-field/correct {:answer/id #uuid "2e7ca4a4-511e-50ee-bf48-b7280e7b04b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186364163} :answer-field/id #uuid "14335add-728c-5e2f-bb76-9b14164c8f1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364159}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ba99e80b-ab29-52f3-91a8-3caa3a6f75d7" :question/math-academy-id "q-40845" :question/problem "$$\n\\overbrace{\\begin{bmatrix}-2 & 1 \\\\ 1 & -5 \\\\ 2 & -1\\end{bmatrix}}^{A}=\\overbrace{\\begin{bmatrix}{q}_{11} & {q}_{12} \\\\ {q}_{21} & {q}_{22} \\\\ {q}_{31} & {q}_{32}\\end{bmatrix}}^{Q}\\overbrace{\\begin{bmatrix}{r}_{11} & {r}_{12} \\\\ 0 & {r}_{22}\\end{bmatrix}}^{R}.\n$$\n\nConsider the QR factorization of the matrix $A$ shown above. Given that the columns ${q}_{1},{q}_{2}$ of $Q$ were obtained from the columns of $A$ using the Gram-Schmidt process, find  the value of ${q}_{12}\\cdot {r}_{12}.$" :question/worked-solution "Let ${a}_{1},{a}_{2}$ be the columns of $A.$\n\nFirst, we find an orthonormal basis of $\\text{Col}(A)=\\text{Span}\\{{a}_{1},{a}_{2}\\}$ using the Gram-Schmidt process.\n\n**Step 1**. We set ${v}_{1}={a}_{1}=\\begin{bmatrix}-2 \\\\ 1 \\\\ 2\\end{bmatrix}.$\n\n**Step 2**. We We find the vector ${v}_{2}$ orthogonal to $\\text{Span}\\{{v}_{1}\\}$ using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-{\\text{proj}}_{{v}_{1}}\\,{a}_{2} \\\\  & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1} \\\\  & =\\begin{bmatrix}1 \\\\ -5 \\\\ -1\\end{bmatrix}-\\left(-\\frac{9}{9}\\right)\\begin{bmatrix}-2 \\\\ 1 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ -5 \\\\ -1\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ 1 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ -4 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nNext, we normalize ${v}_{1}$ and ${v}_{2}:$\n\n$$\n\\begin{aligned}{q}_{1} & =\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{3}\\begin{bmatrix}-2 \\\\ 1 \\\\ 2\\end{bmatrix} \\\\ {q}_{2} & =\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{3\\sqrt{2}}\\begin{bmatrix}-1 \\\\ -4 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$\n\nNext, we compute $R:$\n\n$$\n\\begin{aligned}R & ={Q}^{T}\\,A \\\\  & =\\begin{bmatrix}-\\frac{2}{3} & \\frac{1}{3} & \\frac{2}{3} \\\\ -\\frac{1}{3\\sqrt{2}} & -\\frac{4}{3\\sqrt{2}} & \\frac{1}{3\\sqrt{2}}\\end{bmatrix}\\begin{bmatrix}-2 & 1 \\\\ 1 & -5 \\\\ 2 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & -3 \\\\ 0 & 3\\sqrt{2}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we obtain the following QR factorization of $A:$\n\n$$\n\\overbrace{\\begin{bmatrix}-2 & 1 \\\\ 1 & -5 \\\\ 2 & -1\\end{bmatrix}}^{A}=\\overbrace{\\begin{bmatrix}-\\frac{2}{3} & -\\frac{1}{3\\sqrt{2}} \\\\ \\frac{1}{3} & -\\frac{4}{3\\sqrt{2}} \\\\ \\frac{2}{3} & \\frac{1}{3\\sqrt{2}}\\end{bmatrix}}^{Q}\\overbrace{\\begin{bmatrix}3 & -3 \\\\ 0 & 3\\sqrt{2}\\end{bmatrix}}^{R}.\n$$\n\nFinally, ${q}_{12}\\cdot {r}_{12}=\\left(-\\frac{1}{3\\sqrt{2}}\\right)\\cdot (-3)=\\frac{1}{\\sqrt{2}}.$"} {:db/id #edb/ref 17592186134340 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dd96ba1-2b4a-52b0-ae56-d48afc1ad438" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4\\sqrt{3},4\\sqrt{3})" :db/id #edb/ref 17592186324095} {:answer/id #uuid "2ed05277-6e18-5e15-8940-2ac1cc7e711a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4\\sqrt{3},4\\sqrt{2})" :db/id #edb/ref 17592186324343} {:answer/id #uuid "45a4f7ba-02b2-575e-9878-19dffb79d143" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,4\\sqrt{3})" :db/id #edb/ref 17592186324534} {:answer/id #uuid "5ba9dd42-5731-5299-842c-9b4b8a43aecc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,4\\sqrt{2})" :db/id #edb/ref 17592186324727} {:answer/id #uuid "eedf37c4-e836-577f-8644-c79747d63f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4\\sqrt{3},4)" :db/id #edb/ref 17592186326080}] :answer-field/correct {:answer/id #uuid "eedf37c4-e836-577f-8644-c79747d63f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4\\sqrt{3},4)" :db/id #edb/ref 17592186326080} :answer-field/id #uuid "c09b660e-acc3-5ec3-9d23-f8cb222700d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326568}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d7c864f9-8a06-59dd-91e8-789300497ddc" :question/math-academy-id "q-41263" :question/problem "![](images/34/34b473c8e212297d8cb434fe0a2dd9872cfa2fda924ac3a4d528bc1318af8c5f.png)\n\nThe polar curve $r=8$ and the ray $\\theta =\\frac{5\\pi }{6}$ intersect at the point $P,$ as shown above. What are the Cartesian coordinates of $P?$" :question/worked-solution "The polar coordinates of $P$ are $(r,\\theta )=(8,\\frac{5\\pi }{6}).$ We can convert the polar coordinates of $P$ to Cartesian coordinates, as follows:\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =8\\operatorname{cos}⁡\\left(\\frac{5\\pi }{6}\\right) \\\\  & =8\\cdot \\left(-\\frac{\\sqrt{3}}{2}\\right) \\\\  & =-4\\sqrt{3} \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =8\\operatorname{sin}⁡\\left(\\frac{5\\pi }{6}\\right) \\\\  & =8\\cdot \\left(\\frac{1}{2}\\right) \\\\  & =4\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-4\\sqrt{3},4).$"} {:db/id #edb/ref 17592186134347 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80f0d345-ee8c-5753-ac10-803b3e676d47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186132122} {:answer/id #uuid "a7e5b6c9-ee87-56f4-b0b3-7773d048fea7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186132123} {:answer/id #uuid "188e95b5-8a42-59e3-b83d-565cacdc0f24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{27}" :db/id #edb/ref 17592186132124} {:answer/id #uuid "40fedaa8-18fd-5fc7-8747-3e612b617f0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186132125} {:answer/id #uuid "49838cf3-91dc-591c-82eb-b0896a94ee70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186132126}] :answer-field/id #uuid "9e230848-d966-5120-aa4a-a58d30839e45" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186132121}] :question/id #uuid "dd4327c7-c1f3-5d79-806a-b91ccf5d469c" :question/math-academy-id "q-41370" :question/problem "What is $\\left(\\frac{1}{3}\\right)^{3}$?"} {:db/id #edb/ref 17592186134360 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d7f0473-c0dc-54fb-9bbf-ec5366834148" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186325308} {:answer/id #uuid "b1de6a3f-66ae-5f4b-8340-aa674fe9147e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186325490} {:answer/id #uuid "bd49565d-8785-5f68-9858-a6034fa3a25c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186325596} {:answer/id #uuid "c556c529-90cf-5b8b-b429-d0d222e763cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186325672} {:answer/id #uuid "db28e0f4-85a8-56b7-9021-0028768c6214" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186325880}] :answer-field/correct {:answer/id #uuid "bd49565d-8785-5f68-9858-a6034fa3a25c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186325596} :answer-field/id #uuid "96a8e753-54f6-55ba-b755-4473f49f0ee9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326490}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5c16d625-a7c1-5fba-8406-299ee4b4a692" :question/math-academy-id "q-41627" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=\\begin{bmatrix}-1 \\\\ 1 \\\\ 1 \\\\ -1\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-1 \\\\ -3 \\\\ -1 \\\\ -3\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}5 \\\\ 5 \\\\ 5 \\\\ 5\\end{bmatrix},\\,b=\\begin{bmatrix}a \\\\ b \\\\ c \\\\ d\\end{bmatrix}\n$$\n\nSuppose that $V=\\text{Span}{{a}_{1},{a}_{2},{a}_{3}}.$ Given that $B={{a}_{1},{a}_{2},b}$ is an orthogonal basis for $V,{a}_{1}⊥{a}_{2},$ and that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $\\frac{a}{c}?$" :question/worked-solution "Since the first two vectors are already orthogonal, we proceed to find an orthogonal basis using the Gram-Schmidt process, as follows:\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}-1 \\\\ 1 \\\\ 1 \\\\ -1\\end{bmatrix}.$\n\n**Step 2**: We set ${v}_{2}={a}_{2}=\\begin{bmatrix}-1 \\\\ -3 \\\\ -1 \\\\ -3\\end{bmatrix}.$\n\n**Step 3**. Next, we find ${v}_{3}$ using the formula\n\n$$\n\\begin{aligned}{v}_{3} & ={a}_{3}-{\\text{proj}}_{{v}_{1}}\\,{a}_{3}-{\\text{proj}}_{{v}_{2}}\\,{a}_{3} \\\\  & ={a}_{3}-\\frac{{a}_{3}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}-\\frac{{a}_{3}\\cdot {v}_{2}}{{v}_{2}\\cdot {v}_{2}}{v}_{2}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{3}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{3} & =\\begin{bmatrix}5 \\\\ 5 \\\\ 5 \\\\ 5\\end{bmatrix}-\\left(\\frac{0}{4}\\right)\\begin{bmatrix}-1 \\\\ 1 \\\\ 1 \\\\ -1\\end{bmatrix}-\\left(-\\frac{40}{20}\\right)\\begin{bmatrix}-1 \\\\ -3 \\\\ -1 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 \\\\ 5 \\\\ 5 \\\\ 5\\end{bmatrix}-0\\begin{bmatrix}-1 \\\\ 1 \\\\ 1 \\\\ -1\\end{bmatrix}+2\\begin{bmatrix}-1 \\\\ -3 \\\\ -1 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ -1 \\\\ 3 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, $a=3,$ $c=3,$ and $\\frac{a}{c}=\\frac{3}{3}=1.$"} {:db/id #edb/ref 17592186134361 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "050a2002-78df-55b3-a5c3-863f76bf58b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186324018} {:answer/id #uuid "6d374e8a-4ca9-53b9-a2a1-cb1525ce52bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186324874} {:answer/id #uuid "94210575-f3b8-54dd-a783-5b61aeb2a445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186325233} {:answer/id #uuid "d7939c85-17f6-5695-8f25-5bd7cae94a09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186325848} {:answer/id #uuid "e2aa1ead-40e6-51a1-91f2-50ee515d0de7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186325957}] :answer-field/correct {:answer/id #uuid "050a2002-78df-55b3-a5c3-863f76bf58b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186324018} :answer-field/id #uuid "e30d28b6-2dc3-5260-a54a-2e9a1be8a7ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326632}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3577af99-cf20-56a3-b945-c4bb7e010e01" :question/math-academy-id "q-41631" :question/problem "$$\nA=\\begin{bmatrix}1 & 4 & 3 \\\\ 0 & 1 & -1 \\\\ 1 & -2 & -1 \\\\ 0 & 1 & -1\\end{bmatrix},\\,B={\\begin{bmatrix}| \\\\ {v}_{1} \\\\ |\\end{bmatrix}\\,,\\begin{bmatrix}| \\\\ {v}_{2} \\\\ |\\end{bmatrix}\\,,\\begin{bmatrix}a \\\\ b \\\\ c \\\\ d\\end{bmatrix}}\n$$\n\nConsider the subspace $V=\\text{Col}(A)$ spanned by the columns ${a}_{1},{a}_{2},{a}_{3}$ of the matrix $A,$ and an orthogonal basis $B$ of $\\text{Col}(A),$ shown above. Given that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $\\frac{d}{a}?$" :question/worked-solution "We proceed to find an orthogonal basis $B$ of $\\text{Col}(A)$ using the Gram-Schmidt process, as follows:\n\n**Step 1.** We set ${v}_{1}={a}_{1}=\\begin{bmatrix}1 \\\\ 0 \\\\ 1 \\\\ 0\\end{bmatrix}.$\n\n**Step 2.** We find the vector ${v}_{2}$ orthogonal to $\\text{Span}{{v}_{1}}$ using the usual formula:\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-{\\text{proj}}_{{v}_{1}}{a}_{2} \\\\  & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1} \\\\  & =\\begin{bmatrix}4 \\\\ 1 \\\\ -2 \\\\ 1\\end{bmatrix}-\\frac{2}{2}\\begin{bmatrix}1 \\\\ 0 \\\\ 1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 \\\\ 1 \\\\ -2 \\\\ 1\\end{bmatrix}-\\begin{bmatrix}1 \\\\ 0 \\\\ 1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ 1 \\\\ -3 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\n**Step 3.** We find the vector ${v}_{3}$ orthogonal to $\\text{Span}{{v}_{1},{v}_{2}}$ using the usual formula:\n\n$$\n\\begin{aligned}{v}_{3} & ={a}_{3}-{\\text{proj}}_{{v}_{1}}\\,{a}_{3}-{\\text{proj}}_{{v}_{2}}\\,{a}_{3} \\\\  & ={a}_{3}-\\frac{{a}_{3}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}-\\frac{{a}_{3}\\cdot {v}_{2}}{{v}_{2}\\cdot {v}_{2}}{v}_{2} \\\\  & =\\begin{bmatrix}3 \\\\ -1 \\\\ -1 \\\\ -1\\end{bmatrix}-\\frac{2}{2}\\begin{bmatrix}1 \\\\ 0 \\\\ 1 \\\\ 0\\end{bmatrix}-\\frac{10}{20}\\begin{bmatrix}3 \\\\ 1 \\\\ -3 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ -1 \\\\ -1 \\\\ -1\\end{bmatrix}-\\begin{bmatrix}1 \\\\ 0 \\\\ 1 \\\\ 0\\end{bmatrix}-\\frac{1}{2}\\begin{bmatrix}3 \\\\ 1 \\\\ -3 \\\\ 1\\end{bmatrix} \\\\  & =\\frac{1}{2}(2\\begin{bmatrix}3 \\\\ -1 \\\\ -1 \\\\ -1\\end{bmatrix}-2\\begin{bmatrix}1 \\\\ 0 \\\\ 1 \\\\ 0\\end{bmatrix}-\\begin{bmatrix}3 \\\\ 1 \\\\ -3 \\\\ 1\\end{bmatrix}) \\\\  & =\\begin{bmatrix}\\frac{1}{2} \\\\ -\\frac{3}{2} \\\\ -\\frac{1}{2} \\\\ -\\frac{3}{2}\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, \n\n$$\n\\frac{d}{a}=\\frac{\\left(-\\frac{3}{2}\\right)}{\\left(\\frac{1}{2}\\right)}=-3.\n$$"} {:db/id #edb/ref 17592186134383 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c0ef6f5-0cc5-52c3-a504-38e6ca879a7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{9}" :db/id #edb/ref 17592186132338} {:answer/id #uuid "98037f44-8796-5ce8-bd73-48fa74918727" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{27}" :db/id #edb/ref 17592186132339} {:answer/id #uuid "bde3a713-36a5-5dbd-9afa-1a9e075f9918" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{27}" :db/id #edb/ref 17592186132340} {:answer/id #uuid "0a0944d6-362b-5f24-84f8-3c27fb2b21a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{27}" :db/id #edb/ref 17592186132341} {:answer/id #uuid "342c4c3f-c925-5707-a805-d7b876cd2d6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{9}" :db/id #edb/ref 17592186132342}] :answer-field/id #uuid "14205f42-70b3-5ba9-a0f0-a16e7584e3df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186132337}] :question/id #uuid "e9fd181c-266c-50df-bb50-773830d9e40b" :question/math-academy-id "q-42253" :question/problem "What is $\\left(\\frac{2}{3}\\right)^{3}$?"} {:db/id #edb/ref 17592186134403 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b168093-06ee-59d2-a609-623e2ec4e449" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\pi }" :db/id #edb/ref 17592186327451} {:answer/id #uuid "4588a6ee-dc15-5f53-86b2-b586c559c781" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186327542} {:answer/id #uuid "4f67b91c-0f60-548d-8a33-48f8a99a74b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{3\\pi }{2}}" :db/id #edb/ref 17592186327627} {:answer/id #uuid "59ccd062-fdab-5575-acd3-736c657f5624" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{\\pi }" :db/id #edb/ref 17592186327721} {:answer/id #uuid "ebca9d1f-42e9-5b29-8145-61126df47e3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{\\pi }{2}}" :db/id #edb/ref 17592186328998}] :answer-field/correct {:answer/id #uuid "ebca9d1f-42e9-5b29-8145-61126df47e3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{\\pi }{2}}" :db/id #edb/ref 17592186328998} :answer-field/id #uuid "9fca567e-a930-5cf5-8fe9-bab4358653b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329451}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f27dcc08-cb74-544e-b846-2c5aa548a3f7" :question/math-academy-id "q-42734" :question/problem "Let $V=C[\\pi ,2\\pi ]$ be the vector space of all functions that are continuous on $[\\pi ,2\\pi ],$ equipped with the inner product \n\n$$\n⟨x(t),y(t)⟩={\\int }_{\\pi }^{2\\pi }x(t)y(t)\\,\\text{d}t.\n$$\n\nCalculate the norm of the vector $f(t)=\\operatorname{cos}⁡t.$" :question/worked-solution "The norm of a vector $f(t)$ with respect to an inner product $⟨\\cdot ,\\cdot ⟩$ is defined as\n\n$$\n‖f(t)‖=\\sqrt{⟨f(t),f(t)⟩}.\n$$\n\nComputing the inner product using our definition, we get\n\n$$\n\\begin{aligned}⟨f(t),f(t)⟩ & ={\\int }_{\\pi }^{2\\pi }(f(t))^{2}\\,\\text{d}t \\\\  & ={\\int }_{\\pi }^{2\\pi }\\,{cos}^{2}⁡t\\,\\text{d}t \\\\  & ={\\int }_{\\pi }^{2\\pi }\\left(\\frac{1+\\operatorname{cos}⁡2t}{2}\\right)\\,\\text{d}t \\\\  & ={\\int }_{\\pi }^{2\\pi }(\\frac{1}{2}+\\frac{\\operatorname{cos}⁡2t}{2})\\,\\text{d}t \\\\  & =(\\frac{t}{2}+\\frac{\\operatorname{sin}⁡2t}{4}){|}_{\\pi }^{2\\pi } \\\\  & =(\\frac{2\\pi }{2}+\\frac{\\operatorname{sin}⁡4\\pi }{4})-(\\frac{\\pi }{2}+\\frac{\\operatorname{sin}⁡2\\pi }{4}) \\\\  & =(\\pi +0)-(\\frac{\\pi }{2}+0) \\\\  & =\\frac{\\pi }{2}.\\end{aligned}\n$$\n\nNote that we made use of the trigonometric identity \n\n$$\n{cos}^{2}⁡t=\\frac{1+\\operatorname{cos}⁡2t}{2}.\n$$\n\nFinally then,\n\n$$\n\\begin{aligned}‖f(t)‖ & =\\sqrt{\\frac{\\pi }{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186134509 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8536c628-8b6e-548b-8d23-4c9057678c0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{125}" :db/id #edb/ref 17592186133093} {:answer/id #uuid "ef8b5f1b-a767-50a8-a5ae-cfa35a90b28c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186133094} {:answer/id #uuid "3c3f6e3c-3d68-5a18-8944-ef6e47f2e1ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{125}" :db/id #edb/ref 17592186133095} {:answer/id #uuid "5e12b1a3-9680-5544-aa6e-1185faebe327" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{25}" :db/id #edb/ref 17592186133096} {:answer/id #uuid "7cd5aa75-3d14-5c5c-87ee-3953607513aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{25}" :db/id #edb/ref 17592186133097}] :answer-field/id #uuid "ce3e6d81-4d6c-5b0a-86e0-a494790f9358" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186133092}] :question/id #uuid "e78dd22e-6535-514a-9020-7853b60f7758" :question/math-academy-id "q-75516" :question/problem "What is $\\left(\\frac{2}{5}\\right)^{2}$?"}]
