^{3}}" :db/id #edb/ref 17592186312244} {:answer/id #uuid "36626cb6-ee85-53ba-9bcf-6d72e6bd1cc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18{s}^{2}+432}{({s}^{2}-36)^{3}}" :db/id #edb/ref 17592186312414} {:answer/id #uuid "3b9feaf8-1885-5c39-a81b-7fde37ec2d54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{18{s}^{2}+432}{({s}^{2}-36)^{3}}" :db/id #edb/ref 17592186312458} {:answer/id #uuid "7d7ff30e-73bc-53f8-9f06-c6a6d42689ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{36{s}^{2}+432}{({s}^{2}-36)^{3}}" :db/id #edb/ref 17592186312980}] :answer-field/correct {:answer/id #uuid "7d7ff30e-73bc-53f8-9f06-c6a6d42689ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{36{s}^{2}+432}{({s}^{2}-36)^{3}}" :db/id #edb/ref 17592186312980} :answer-field/id #uuid "d6b6f1c6-19d8-551a-bf01-42f858a85635" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314603} {:answer-field/choices [{:answer/id #uuid "2c9ffc09-ab81-5da6-a831-835f57a9321d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{36{s}^{3}+432s}{({s}^{2}-36)^{3}}" :db/id #edb/ref 17592186312322} {:answer/id #uuid "413bcbae-a85a-5eaa-8705-d343e2f5da61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{36{s}^{2}+432}{({s}^{2}-36)^{3}}" :db/id #edb/ref 17592186312497} {:answer/id #uuid "a7b52b73-617e-5326-99e5-1f5494896711" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{36{s}^{3}+432s}{({s}^{2}-36)^{3}}" :db/id #edb/ref 17592186313289} {:answer/id #uuid "e9d17872-cb3c-50ee-97ae-094410cbb6f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{36{s}^{2}+432}{({s}^{2}-36)^{3}}" :db/id #edb/ref 17592186313835}] :answer-field/correct {:answer/id #uuid "e9d17872-cb3c-50ee-97ae-094410cbb6f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{36{s}^{2}+432}{({s}^{2}-36)^{3}}" :db/id #edb/ref 17592186313835} :answer-field/id #uuid "df80eaf6-429b-51e3-83e6-8d4d13a00fd1" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314628}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "458ca544-ac0f-54e4-b380-7e20f0b953dd" :question/math-academy-id "q-341222" :question/problem "Suppose we wish to calculate the Laplace transform \n\n$$\nL{{t}^{2}\\operatorname{sinh}⁡(-6t)}.\n$$\n\nSelect the correct options in the reasoning below. You may make use of the following results:\n\n$$\nL{\\operatorname{sinh}⁡\\omega t}=\\frac{\\omega }{{s}^{2}-{\\omega }^{2}},\\,s>\\omega .\n$$\n\nLet $f(t)=\\operatorname{sinh}⁡(-6t)$ and $F(s)=L{f(t)}.$ By the smoothness property of Laplace transforms, we have\n\n$$\nL{{t}^{2}f(t)}={{field-1}}.\n$$\n\nUsing $\\operatorname{sinh}⁡(-6t)=-\\operatorname{sinh}⁡6t,$ the Laplace transform of $f(t)$ is\n\n$$\nF(s)=L{f(t)}={{field-2}},\\,s>6.\n$$\n\nWe have that\n\n$$\n{F}^{″}(s)={{field-3}}.\n$$\n\nTherefore,\n\n$$\nL{{t}^{2}\\operatorname{sinh}⁡(-6t)}={{field-4}},\\,s>6.\n$$" :question/worked-solution "If a function $f(t)$ is piecewise continuous on $[0,\\infty )$ and has exponential order $a,$ then its Laplace transform\n\n$$\nF(s)=L{f(t)}\n$$\n\nexists for every real $s>a,$ and $F$ is infinitely differentiable in this region of convergence. Moreover, for each integer $n\\ge 0$ and every such $s,$ we have\n\n$$\nL{{t}^{n}f(t)}=(-1)^{n}{F}^{(n)}(s).\n$$\n\nIn particular, for $n=2,$ we have\n\n$$\nL{{t}^{2}f(t)}={F}^{″}(s).\n$$\n\nWe have that\n\n$$\nf(t)=\\operatorname{sinh}⁡(-6t)=-\\operatorname{sinh}⁡6t.\n$$\n\nUsing the given result with $\\omega =6,$ the Laplace transform of $\\operatorname{sinh}⁡6t$ is $\\frac{6}{{s}^{2}-36},$ so\n\n$$\nF(s)=-\\frac{6}{{s}^{2}-36},\\,s>6.\n$$\n\nDifferentiating with respect to $s,$ we have\n\n$$\n\\begin{aligned}{F}^{′}(s) & =\\frac{\\text{d}}{\\text{d}s}(-\\frac{6}{{s}^{2}-36}) \\\\  & =-\\frac{\\text{d}}{\\text{d}s}(6({s}^{2}-36)^{-1}) \\\\  & =-(-6({s}^{2}-36)^{-2}\\cdot 2s) \\\\  & =\\frac{12s}{({s}^{2}-36)^{2}} \\\\ {F}^{″}(s) & =\\frac{\\text{d}}{\\text{d}s}(\\frac{12s}{({s}^{2}-36)^{2}}) \\\\  & =12\\cdot \\frac{\\text{d}}{\\text{d}s}(\\frac{s}{({s}^{2}-36)^{2}}) \\\\  & =12\\cdot (\\frac{(s)^{′}\\cdot ({s}^{2}-36)^{2}-s\\cdot {(({s}^{2}-36)^{2})}^{′}}{({s}^{2}-36)^{4}}) \\\\  & =12\\cdot (\\frac{({s}^{2}-36)^{2}-s\\cdot 2({s}^{2}-36)\\cdot 2s}{({s}^{2}-36)^{4}}) \\\\  & =12\\cdot (\\frac{({s}^{2}-36)^{2}-4{s}^{2}({s}^{2}-36)}{({s}^{2}-36)^{4}}) \\\\  & =12\\cdot (\\frac{{s}^{2}-36-4{s}^{2}}{({s}^{2}-36)^{3}}) \\\\  & =12\\cdot (\\frac{-3{s}^{2}-36}{({s}^{2}-36)^{3}}) \\\\  & =-\\frac{36{s}^{2}+432}{({s}^{2}-36)^{3}}.\\end{aligned}\n$$\n\nNote that we used the quotient rule to find ${F}^{″}(s).$\n\nTherefore, by the smoothness property,\n\n$$\n\\begin{aligned}L{{t}^{2}\\operatorname{sinh}⁡(-6t)}={F}^{″}(s)=-\\frac{36{s}^{2}+432}{({s}^{2}-36)^{3}},\\,s>6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186315068 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7fa4792b-5b15-527a-992e-0d96170ab1aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450530} {:answer/id #uuid "f9461d03-b412-574d-9841-bce08dceb69a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450531}] :answer-field/correct {:answer/id #uuid "f9461d03-b412-574d-9841-bce08dceb69a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450531} :answer-field/id #uuid "7a1e573c-09ca-594f-a9ba-3b2660311b38" :answer-field/key "$f(x+\\frac{\\pi }{2})=f(x)$ for all $x\\in R$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451219} {:answer-field/choices [{:answer/id #uuid "d83cac8f-f51f-527a-b720-44ad32045870" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450532} {:answer/id #uuid "333f0aac-7943-517c-87c6-fb5685a1c0fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450533}] :answer-field/correct {:answer/id #uuid "d83cac8f-f51f-527a-b720-44ad32045870" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450532} :answer-field/id #uuid "611505c9-97d8-564c-8e0d-e557fa6b701e" :answer-field/key "$f(x)=F(x)$ for all $x\\in R$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451220} {:answer-field/choices [{:answer/id #uuid "01e9805a-d060-5fce-8210-0537d29aaf51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450534} {:answer/id #uuid "7605eb1c-ab43-5593-8185-dd779575eaf5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450535}] :answer-field/correct {:answer/id #uuid "7605eb1c-ab43-5593-8185-dd779575eaf5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450535} :answer-field/id #uuid "d1ba82cd-be54-5931-a8f3-844d7c5db9bc" :answer-field/key "$f(x+\\frac{\\pi }{2})=f(x-\\frac{\\pi }{2})$ for all $x\\in R$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451221}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ea143c38-1de5-5608-b272-c1150223e597" :question/math-academy-id "q-341232" :question/problem "Let $F(x)=\\operatorname{sin}⁡(2x)$ for $x\\in R.$ Suppose $f(x)$ is the $\\frac{\\pi }{2}$-periodic extension of $F(x)$ from $x\\in [0,\\frac{\\pi }{2})$ to $x\\in R.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Since $f$ is the $\\pi /2$-periodic extension of $F,$ we have  \n\n- $f(x+\\frac{\\pi }{2})=f(x)$ for all $x\\in R,$ and\n\n- $f(x)=F(x)$ for all $x\\in [0,\\frac{\\pi }{2}).$\n\nWith that in mind, we examine each statement in turn.\n\n- Statement “$f(x+\\frac{\\pi }{2})=f(x)$ for all $x\\in R$” is true. This is exactly the definition of $\\frac{\\pi }{2}$-periodicity:\n\n$$\nf(x+\\frac{\\pi }{2})=f(x)\n$$\n\nfor all $x\\in R.$\n\n- Statement “$f(x)=F(x)$ for all $x\\in R$” is false. For example, take $x=\\frac{3\\pi }{4}.$ Using the periodicity of $f(x):$\n\n$$\n\\begin{aligned}f(\\frac{3\\pi }{4})=f(\\frac{\\pi }{4}+\\frac{\\pi }{2})=f(\\frac{\\pi }{4})=F(\\frac{\\pi }{4})=\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4})=1,\\end{aligned}\n$$\n\nwhile\n\n$$\n\\begin{aligned}F(\\frac{3\\pi }{4})=\\operatorname{sin}⁡(2\\cdot \\frac{3\\pi }{4})=\\operatorname{sin}⁡(\\frac{3\\pi }{2})=-1.\\end{aligned}\n$$\n\nHence, $f(x)\\ne F(x)$ for $x=\\frac{3\\pi }{4}.$\n\n- Statement “$f(x+\\frac{\\pi }{2})=f(x-\\frac{\\pi }{2})$ for all $x\\in R$” is true. Since $f$ is $\\frac{\\pi }{2}$-periodic, any shift by a multiple of its period returns the same value:\n\n$$\n\\begin{aligned}f(x+\\frac{\\pi }{2})=f(x)\\,\\text{and}\\,f(x-\\frac{\\pi }{2})=f((x-\\frac{\\pi }{2})+\\frac{\\pi }{2})=f(x).\\end{aligned}\n$$\n\nSince both sides equal $f(x),$ the statement is true for all $x\\in R.$\n\nTherefore, the correct answer is “$f(x+\\frac{\\pi }{2})=f(x)$ for all $x\\in R$”; “$f(x+\\frac{\\pi }{2})=f(x-\\frac{\\pi }{2})$ for all $x\\in R$” only."} {:db/id #edb/ref 17592186315069 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e69687f-8c03-5c9a-8e81-2feebdb84cc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450536} {:answer/id #uuid "c4734c66-b830-5012-9fb4-cfa4985ad9fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450537}] :answer-field/correct {:answer/id #uuid "c4734c66-b830-5012-9fb4-cfa4985ad9fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450537} :answer-field/id #uuid "476d4817-0c5c-5c10-bc1d-2482d72d4c55" :answer-field/key "$f(x+4\\pi )=f(x)$ for all $x\\in R$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451222} {:answer-field/choices [{:answer/id #uuid "2d93f9e6-a8cb-54ef-ba01-0f9b1655833f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450538} {:answer/id #uuid "556f5d27-0aa0-5d57-a7b0-29269a93cd55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450539}] :answer-field/correct {:answer/id #uuid "2d93f9e6-a8cb-54ef-ba01-0f9b1655833f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450538} :answer-field/id #uuid "955c3f26-0647-5690-bdcf-926edd101436" :answer-field/key "$f(x)=F(x)$ for all $x\\in R$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451223} {:answer-field/choices [{:answer/id #uuid "ea24cc05-96b2-58c0-adce-93dd4750e88e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450540} {:answer/id #uuid "7a41e6fe-ab8d-5f68-b3fc-c4be05e1b48e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450541}] :answer-field/correct {:answer/id #uuid "7a41e6fe-ab8d-5f68-b3fc-c4be05e1b48e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450541} :answer-field/id #uuid "92cf34f6-8dc7-5f8c-a110-8a694be94a2f" :answer-field/key "$f(x+2\\pi )=f(x)$ for all $x\\in R$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451224}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "47637532-5815-59ac-9760-d5eb87953b75" :question/math-academy-id "q-341237" :question/problem "Let $F(x)=cos\\,(\\frac{x}{2})$ for $x\\in R.$ Suppose $f(x)$ is the $2\\pi $-periodic extension of $F(x)$ from $x\\in [0,2\\pi )$ to $x\\in R.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Since $f$ is the $2\\pi $-periodic extension of $F,$ we have  \n\n- $f(x+2\\pi )=f(x)$ for all $x\\in R,$ and\n\n- $f(x)=F(x)$ for all $x\\in [0,2\\pi ).$\n\nWith that in mind, we examine each statement in turn.\n\n- Statement “$f(x+4\\pi )=f(x)$ for all $x\\in R$” is true. We have\n\n$$\nf(x+4\\pi )=f((x+2\\pi )+2\\pi )=f(x+2\\pi )=f(x)\n$$\n\nfor all $x\\in R.$\n\n- Statement “$f(x)=F(x)$ for all $x\\in R$” is false. For example, take $x=2\\pi .$ Then,\n\n$$\n\\begin{aligned}f(2\\pi ) & =f(0+2\\pi )=f(0)=F(0)=\\operatorname{cos}⁡(0)=1,\\end{aligned}\n$$\n\nwhile\n\n$$\nF(2\\pi )=\\operatorname{cos}⁡(\\pi )=-1.\n$$\n\nHence, $f(x)\\ne F(x)$ for $x=2\\pi .$\n\n- Statement “$f(x+2\\pi )=f(x)$ for all $x\\in R$” is true. This is exactly the definition of $2\\pi $-periodicity: \n\n$$\nf(x+2\\pi )=f(x)\n$$\n\nfor all $x\\in R.$\n\nTherefore, the correct answer is “$f(x+4\\pi )=f(x)$ for all $x\\in R$”; “$f(x+2\\pi )=f(x)$ for all $x\\in R$” only."} {:db/id #edb/ref 17592186315080 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27402392-ef7b-543e-a95c-51569128931d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{\\pi }(\\sqrt{2}-2)" :db/id #edb/ref 17592186312273} {:answer/id #uuid "b2388473-f7b4-5371-bdaf-2f5d22ad6092" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4(\\sqrt{2}-2)}{\\pi}" :db/id #edb/ref 17592186513999}] :answer-field/correct {:answer/id #uuid "b2388473-f7b4-5371-bdaf-2f5d22ad6092" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4(\\sqrt{2}-2)}{\\pi}" :db/id #edb/ref 17592186513999} :answer-field/id #uuid "f63f2945-3857-5e6d-882c-11e5148b361f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314680}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "86b3942b-d5fe-58b1-8280-9f2a9124377a" :question/math-academy-id "q-341283" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=-\\operatorname{sin}⁡(\\frac{x}{4})$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" :question/worked-solution "For our Fourier cosine series, the constant term is given by\n\n$$\n{a}_{0}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-\\operatorname{sin}⁡(\\frac{x}{4})$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }-\\operatorname{sin}⁡(\\frac{x}{4})\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{[4\\operatorname{cos}⁡(\\frac{x}{4})]}_{0}^{\\pi } \\\\  & =\\frac{2}{\\pi }(4\\operatorname{cos}⁡(\\frac{\\pi }{4})-4\\operatorname{cos}⁡(0)) \\\\  & =\\frac{2}{\\pi }(4\\cdot \\frac{\\sqrt{2}}{2}-4) \\\\  & =\\frac{4}{\\pi }(\\sqrt{2}-2).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186315081 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70a30cec-1c74-58b6-a352-b55dbaad5ff0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6(\\sqrt{3}-2)}{\\pi }" :db/id #edb/ref 17592186312860} {:answer/id #uuid "6291bc20-b33b-51a2-81f3-8c4774fb834c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6(\\sqrt{3}-2)}{\\pi}" :db/id #edb/ref 17592186420177}] :answer-field/correct {:answer/id #uuid "6291bc20-b33b-51a2-81f3-8c4774fb834c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6(\\sqrt{3}-2)}{\\pi}" :db/id #edb/ref 17592186420177} :answer-field/id #uuid "850f065e-3ad8-58f4-8d41-45b829bfc32b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314364}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a1a98a94-1685-5290-8055-415073e9036d" :question/math-academy-id "q-341285" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=-\\operatorname{sin}⁡(\\frac{x}{6})$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" :question/worked-solution "For our Fourier cosine series, the constant term is given by\n\n$$\n{a}_{0}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-\\operatorname{sin}⁡(\\frac{x}{6})$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }-\\operatorname{sin}⁡(\\frac{x}{6})\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{[6\\operatorname{cos}⁡(\\frac{x}{6})]}_{0}^{\\pi } \\\\  & =\\frac{2}{\\pi }(6\\operatorname{cos}⁡(\\frac{\\pi }{6})-6\\operatorname{cos}⁡(0)) \\\\  & =\\frac{2}{\\pi }(6\\cdot \\frac{\\sqrt{3}}{2}-6) \\\\  & =\\frac{6(\\sqrt{3}-2)}{\\pi }.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186315090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "abb73e80-e963-5c19-b293-cd17110e5f3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-3s}}{s}" :db/id #edb/ref 17592186313321}] :answer-field/correct {:answer/id #uuid "abb73e80-e963-5c19-b293-cd17110e5f3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-3s}}{s}" :db/id #edb/ref 17592186313321} :answer-field/id #uuid "22a45e29-d2af-5275-a0b0-c40eb9d5a6e3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314099} {:answer-field/choices [{:answer/id #uuid "849d38a3-ffa8-596e-8341-2c43de043d90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186313039}] :answer-field/correct {:answer/id #uuid "849d38a3-ffa8-596e-8341-2c43de043d90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186313039} :answer-field/id #uuid "7e45259c-a45d-5e7c-b47d-2c04e878ab64" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314344} {:answer-field/choices [{:answer/id #uuid "5ac97744-f5cd-5f41-a0de-cb29bbe9817d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186312697}] :answer-field/correct {:answer/id #uuid "5ac97744-f5cd-5f41-a0de-cb29bbe9817d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186312697} :answer-field/id #uuid "b9d647e4-d66d-54c7-aca9-90ce3e255ed4" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314518}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9db19fd8-5680-5d48-9d86-5812bc3bb368" :question/math-academy-id "q-341390" :question/problem "Use the definition of Laplace transforms to calculate $F(s)=L{f(t)},$ where $f(t)=u(t-3)$ and $u$ is the unit step function.\n\n$F(s)=L{f(t)}=$\n{{field-1}},\nvalid for $s\\,$\n{{field-2}}{{field-3}}." :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nRecall that the unit step function is defined as\n\n$$\n\\begin{aligned}u(t)={\\begin{aligned}0,\\, & t<0 \\\\ 1,\\, & t\\ge 0.\\end{aligned}\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\n\\begin{aligned}u(t-3)={\\begin{aligned}0,\\, & t<3 \\\\ 1,\\, & t\\ge 3\\end{aligned}\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }u(t-3){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}0\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{3}^{\\infty }1\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{3}^{\\infty }{e}^{-st}\\,\\text{d}t.\\end{aligned}\n$$\n\nNote that this improper integral diverges if $s\\le 0.$\n\nFor $s>0,$ we calculate this integral as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{3}^{\\infty }{e}^{-st}\\,\\text{d}t \\\\  & ={lim}_{a\\to \\infty }{\\int }_{3}^{a}{e}^{-st}\\,\\text{d}t \\\\  & ={lim}_{a\\to \\infty }{(-\\frac{{e}^{-st}}{s})|}_{3}^{a} \\\\  & =-\\frac{1}{s}\\cdot {lim}_{a\\to \\infty }({e}^{-sa}-{e}^{-3s}) \\\\  & =-\\frac{1}{s}(0-{e}^{-3s}) \\\\  & =\\frac{{e}^{-3s}}{s}\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $f(t)$ is\n\n$$\nL{f(t)}=\\frac{{e}^{-3s}}{s},\\,s>0.\n$$"} {:db/id #edb/ref 17592186315100 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3af1f70d-33f0-5cfc-b5f6-a92c6f53e642" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>3" :db/id #edb/ref 17592186312452} {:answer/id #uuid "5fe96b2b-df0f-5b5f-8c09-6b1116377e59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>0" :db/id #edb/ref 17592186312741} {:answer/id #uuid "6d9f1e2d-c177-5de2-af8c-5df8f1d54fc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 3" :db/id #edb/ref 17592186312838} {:answer/id #uuid "b9a9acc0-efc5-585e-a33a-b532b5c308f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 5" :db/id #edb/ref 17592186313422} {:answer/id #uuid "f2ea64c7-6120-5077-895b-bcf68786e49f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 0" :db/id #edb/ref 17592186313920} {:answer/id #uuid "f6fe74c0-5d40-528d-82a8-b00b5b7874d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>5" :db/id #edb/ref 17592186313949}] :answer-field/correct {:answer/id #uuid "3af1f70d-33f0-5cfc-b5f6-a92c6f53e642" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>3" :db/id #edb/ref 17592186312452} :answer-field/id #uuid "86ad3687-d00c-546b-9001-c9b9e3edb7ad" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314367} {:answer-field/choices [{:answer/id #uuid "a6841173-2455-5244-bbec-85414eabc4c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{s}-\\frac{3{e}^{-5s}}{s}+\\frac{{e}^{5(3-s)}}{s-3}" :db/id #edb/ref 17592186313281} {:answer/id #uuid "c27407bf-c794-57d7-8508-1c96df79cae5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{s}-\\frac{3{e}^{-5s}}{s}+\\frac{{e}^{5(3-s)}}{s+3}" :db/id #edb/ref 17592186313497} {:answer/id #uuid "e1ac9dc4-6042-5869-9b86-e593a5060278" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{s}+\\frac{{e}^{-5s}}{s}+\\frac{{e}^{5(3-s)}}{s-3}" :db/id #edb/ref 17592186313751} {:answer/id #uuid "e9d1b8bc-f1b4-5858-bece-8bc740d6a4c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{s}-\\frac{3{e}^{-5s}}{s}+\\frac{{e}^{5(s-3)}}{s-3}" :db/id #edb/ref 17592186313836}] :answer-field/correct {:answer/id #uuid "a6841173-2455-5244-bbec-85414eabc4c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{s}-\\frac{3{e}^{-5s}}{s}+\\frac{{e}^{5(3-s)}}{s-3}" :db/id #edb/ref 17592186313281} :answer-field/id #uuid "db344fa5-42cc-561f-be5a-472e4d16cbdd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314619}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dd8bfbcf-088b-5c81-bfda-8fc9e642ff98" :question/math-academy-id "q-341451" :question/problem "Use the definition of Laplace transforms to calculate $F(s)=L{f(t)},$ where $f(t)$ is given by \n\n$$\nf(t)={\\begin{aligned}3,\\, & t\\le 5 \\\\ {e}^{3t}\\, & t>5.\\end{aligned}\n$$\n\n$\\,F(s)=L{f(t)}=$ {{field-1}},\nvalid for {{field-2}}." :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\nf(t)={\\begin{aligned}3,\\, & t\\le 5 \\\\ {e}^{3t}\\, & t>5\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{5}3\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{5}^{\\infty }{e}^{3t}\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{5}3\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{5}^{\\infty }{e}^{3t-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{5}3{e}^{-st}\\,\\text{d}t+{\\int }_{5}^{\\infty }{e}^{(3-s)t}\\,\\text{d}t.\\end{aligned}\n$$\n\nNote that the improper integral diverges if $s\\le 3.$\n\nFor $s>3,$ we calculate our Laplace transform as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{5}3{e}^{-st}\\,\\text{d}t+{\\int }_{5}^{\\infty }{e}^{(3-s)t}\\,\\text{d}t \\\\  & =-\\frac{3}{s}{[{e}^{-st}]}_{0}^{5}+{\\int }_{5}^{\\infty }{e}^{(3-s)t}\\,\\text{d}t \\\\  & =\\frac{3}{s}-\\frac{3{e}^{-5s}}{s}+{lim}_{a\\to \\infty }{\\int }_{5}^{a}{e}^{(3-s)t}\\,\\text{d}t \\\\  & =\\frac{3}{s}-\\frac{3{e}^{-5s}}{s}+{lim}_{a\\to \\infty }{(\\frac{{e}^{(3-s)t}}{3-s})|}_{5}^{a} \\\\  & =\\frac{3}{s}-\\frac{3{e}^{-5s}}{s}+\\frac{1}{3-s}\\cdot {lim}_{a\\to \\infty }({e}^{(3-s)a}-{e}^{5(3-s)}) \\\\  & =\\frac{3}{s}-\\frac{3{e}^{-5s}}{s}+\\frac{1}{3-s}\\cdot (0-{e}^{5(3-s)}) \\\\  & =\\frac{3}{s}-\\frac{3{e}^{-5s}}{s}+\\frac{{e}^{5(3-s)}}{s-3}\\end{aligned}\n$$\n\nvalid for $s>3.$"} {:db/id #edb/ref 17592186315101 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "177ee81c-577d-564a-8210-07afa1b06be6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{2(3-s)}-1}{s-3}-\\frac{2{e}^{-2s}}{s}" :db/id #edb/ref 17592186312140} {:answer/id #uuid "2f01a372-dd3b-50bc-b8fe-217767f087ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{2(3-s)}-1}{3-s}+\\frac{2{e}^{-2s}}{s}" :db/id #edb/ref 17592186312348} {:answer/id #uuid "4e932ab6-02eb-5105-aab4-56e5003699ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{2(s-3)}}{s-3}+\\frac{2{e}^{-2s}}{s}" :db/id #edb/ref 17592186312613} {:answer/id #uuid "ff2fab78-ed88-5e81-86d8-9891c8b692da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{2(3-s)}}{s-3}+\\frac{2{e}^{-2s}}{s}" :db/id #edb/ref 17592186314010}] :answer-field/correct {:answer/id #uuid "2f01a372-dd3b-50bc-b8fe-217767f087ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{2(3-s)}-1}{3-s}+\\frac{2{e}^{-2s}}{s}" :db/id #edb/ref 17592186312348} :answer-field/id #uuid "449dd274-4bb5-575f-9ac2-93be8596b522" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314199} {:answer-field/choices [{:answer/id #uuid "07cb2353-2c63-5801-a5b1-6dd28e62428c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>3" :db/id #edb/ref 17592186312028} {:answer/id #uuid "5d13da47-28dd-502f-928e-3103fbdfc4cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 2" :db/id #edb/ref 17592186312720} {:answer/id #uuid "7286e117-dd84-5d7e-b6ad-702579064641" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 0" :db/id #edb/ref 17592186312876} {:answer/id #uuid "7e6a33b5-c41a-5a38-a971-4113fa73ef7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>2" :db/id #edb/ref 17592186312990} {:answer/id #uuid "b18dc8b8-8dd0-5f97-9daa-552dd57c90ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>0" :db/id #edb/ref 17592186313352} {:answer/id #uuid "dcb206fa-e222-5d87-b0f9-23f2342d9778" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 3" :db/id #edb/ref 17592186313712}] :answer-field/correct {:answer/id #uuid "b18dc8b8-8dd0-5f97-9daa-552dd57c90ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>0" :db/id #edb/ref 17592186313352} :answer-field/id #uuid "e5120007-0b95-54f8-90a9-c8d747cc88d2" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314639}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0dfe2c1a-430d-5eed-bc5d-17ce89a52f56" :question/math-academy-id "q-341464" :question/problem "Use the definition of Laplace transforms to calculate $F(s)=L{f(t)},$ where $f(t)$ is given by \n\n$$\nf(t)={\\begin{aligned}{e}^{3t},\\, & t\\le 2 \\\\ 2\\, & t>2.\\end{aligned}\n$$\n\n$\\,F(s)=L{f(t)}=$ {{field-1}},\nvalid for {{field-2}}." :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\nf(t)={\\begin{aligned}{e}^{3t},\\, & t\\le 2 \\\\ 2\\, & t>2\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}{e}^{3t}\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{2}^{\\infty }2\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}{e}^{3t-st}\\,\\text{d}t+{\\int }_{2}^{\\infty }2{e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}{e}^{(3-s)t}\\,\\text{d}t+{\\int }_{2}^{\\infty }2{e}^{-st}\\,\\text{d}t.\\end{aligned}\n$$\n\nNote that the improper integral diverges if $s\\le 0.$\n\nFor $s>0,$ we calculate our Laplace transform as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{2}{e}^{(3-s)t}\\,\\text{d}t+{\\int }_{2}^{\\infty }2{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{1}{3-s}{[{e}^{(3-s)t}]}_{0}^{2}+{\\int }_{2}^{\\infty }2{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{{e}^{2(3-s)}-1}{3-s}+{lim}_{a\\to \\infty }{\\int }_{2}^{a}2{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{{e}^{2(3-s)}-1}{3-s}+{lim}_{a\\to \\infty }{(\\frac{-2{e}^{-st}}{s})|}_{2}^{a} \\\\  & =\\frac{{e}^{2(3-s)}-1}{3-s}-\\frac{2}{s}\\cdot {lim}_{a\\to \\infty }({e}^{-as}-{e}^{-2s}) \\\\  & =\\frac{{e}^{2(3-s)}-1}{3-s}-\\frac{2}{s}\\cdot (0-{e}^{-2s}) \\\\  & =\\frac{{e}^{2(3-s)}-1}{3-s}+\\frac{2{e}^{-2s}}{s}\\end{aligned}\n$$\n\nvalid for $s>0.$"} {:db/id #edb/ref 17592186315102 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "577931d6-4cb7-58ad-a2e4-59172c086ddc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{(5-s)}-1}{5-s}+\\frac{{e}^{-s}}{s}" :db/id #edb/ref 17592186312677} {:answer/id #uuid "69434016-4709-563b-95a3-e2bd84a3e6e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{(s-5)}}{s-5}+\\frac{{e}^{-s}}{s}" :db/id #edb/ref 17592186312798} {:answer/id #uuid "6c6b3a83-9825-5fb0-8af0-5d81770d63bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{(5-s)}}{s-5}+\\frac{{e}^{-s}}{s}" :db/id #edb/ref 17592186312825} {:answer/id #uuid "a1927e8e-1a6c-5957-afdb-a68c56dc4c09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{(5-s)}-1}{s-5}-\\frac{{e}^{-s}}{s}" :db/id #edb/ref 17592186313245}] :answer-field/correct {:answer/id #uuid "577931d6-4cb7-58ad-a2e4-59172c086ddc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{(5-s)}-1}{5-s}+\\frac{{e}^{-s}}{s}" :db/id #edb/ref 17592186312677} :answer-field/id #uuid "773b8e29-b5de-5558-9620-507da1f535d0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314327} {:answer-field/choices [{:answer/id #uuid "39de7a29-2808-5fd4-9e63-e7366a44d0c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>5" :db/id #edb/ref 17592186312447} {:answer/id #uuid "4594515a-b0d2-5623-9c2f-7c2819236722" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 5" :db/id #edb/ref 17592186312542} {:answer/id #uuid "54bf94b1-797f-561d-a98e-a80d49698e27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 1" :db/id #edb/ref 17592186312657} {:answer/id #uuid "92cdef45-4527-5cc5-96ae-f47647a3b379" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>1" :db/id #edb/ref 17592186313154} {:answer/id #uuid "e28e37d8-aaf8-59c5-8d6e-01f5215780f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>0" :db/id #edb/ref 17592186313761} {:answer/id #uuid "f0511318-744d-585e-b6ab-276783b5c946" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 0" :db/id #edb/ref 17592186313901}] :answer-field/correct {:answer/id #uuid "e28e37d8-aaf8-59c5-8d6e-01f5215780f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>0" :db/id #edb/ref 17592186313761} :answer-field/id #uuid "aa82ceba-cca7-5401-9143-a6893194b75b" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314468}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2ac112a6-5f62-58cf-9bd0-a4369a549356" :question/math-academy-id "q-341465" :question/problem "Use the definition of Laplace transforms to calculate $F(s)=L{f(t)},$ where $f(t)$ is given by \n\n$$\nf(t)={\\begin{aligned}{e}^{5t},\\, & t\\le 1 \\\\ 1\\, & t>1.\\end{aligned}\n$$\n\n$\\,F(s)=L{f(t)}=$ {{field-1}},\nvalid for {{field-2}}." :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\nf(t)={\\begin{aligned}{e}^{5t},\\, & t\\le 1 \\\\ 1\\, & t>1\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{5t}\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{1}^{\\infty }1\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{5t-st}\\,\\text{d}t+{\\int }_{1}^{\\infty }{e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{(5-s)t}\\,\\text{d}t+{\\int }_{1}^{\\infty }{e}^{-st}\\,\\text{d}t.\\end{aligned}\n$$\n\nNote that the improper integral diverges if $s\\le 0.$\n\nFor $s>0,$ we calculate our Laplace transform as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{1}{e}^{(5-s)t}\\,\\text{d}t+{\\int }_{1}^{\\infty }{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{1}{5-s}{[{e}^{(5-s)t}]}_{0}^{1}+{\\int }_{1}^{\\infty }{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{{e}^{(5-s)}-1}{5-s}+{lim}_{a\\to \\infty }{\\int }_{1}^{a}{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{{e}^{(5-s)}-1}{5-s}+{lim}_{a\\to \\infty }{(\\frac{-{e}^{-st}}{s})|}_{1}^{a} \\\\  & =\\frac{{e}^{(5-s)}-1}{5-s}-\\frac{1}{s}\\cdot {lim}_{a\\to \\infty }({e}^{-as}-{e}^{-s}) \\\\  & =\\frac{{e}^{(5-s)}-1}{5-s}-\\frac{1}{s}\\cdot (0-{e}^{-s}) \\\\  & =\\frac{{e}^{(5-s)}-1}{5-s}+\\frac{{e}^{-s}}{s}\\end{aligned}\n$$\n\nvalid for $s>0.$"} {:db/id #edb/ref 17592186315103 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fa923fd-e972-5347-a45c-b9c236f38cb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 1" :db/id #edb/ref 17592186312088} {:answer/id #uuid "1e1b3e65-34bf-5356-b109-4b8e10e5b725" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>0" :db/id #edb/ref 17592186312198} {:answer/id #uuid "966027aa-4cea-5c2f-9087-c55de857deb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>4" :db/id #edb/ref 17592186313175} {:answer/id #uuid "bd28ae8d-e8fa-5116-9794-49db3460b863" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 0" :db/id #edb/ref 17592186313453} {:answer/id #uuid "cad53332-9c09-54bc-aa91-0b4b15467215" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>1" :db/id #edb/ref 17592186313559} {:answer/id #uuid "e1f27e9c-a174-55a5-9b5a-56c94e0265f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 4" :db/id #edb/ref 17592186313754}] :answer-field/correct {:answer/id #uuid "1e1b3e65-34bf-5356-b109-4b8e10e5b725" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>0" :db/id #edb/ref 17592186312198} :answer-field/id #uuid "23ccb899-a0e2-5002-bd20-4244162e93f6" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314103} {:answer-field/choices [{:answer/id #uuid "56afe28f-37ed-5c8b-939d-793a5d7d6b6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{4(1-s)}}{s-1}+\\frac{2{e}^{-4s}}{s}" :db/id #edb/ref 17592186312674} {:answer/id #uuid "a3815aa4-76ef-5c95-943e-084bec443878" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{4(1-s)}-1}{s-1}-\\frac{2{e}^{-4s}}{s}" :db/id #edb/ref 17592186313262} {:answer/id #uuid "b69b54be-138b-5bdb-bb30-e47b2cfcaf7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{4(1-s)}-1}{1-s}+\\frac{2{e}^{-4s}}{s}" :db/id #edb/ref 17592186313394} {:answer/id #uuid "d02a5a8d-7c3b-5ee7-9b52-a38c2682f679" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{4(s-1)}}{s-1}+\\frac{2{e}^{-4s}}{s}" :db/id #edb/ref 17592186313602}] :answer-field/correct {:answer/id #uuid "b69b54be-138b-5bdb-bb30-e47b2cfcaf7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{4(1-s)}-1}{1-s}+\\frac{2{e}^{-4s}}{s}" :db/id #edb/ref 17592186313394} :answer-field/id #uuid "492cbc28-f726-5021-815c-7bdf5be37107" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314218}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1f908bc8-b43e-5b98-b171-3b917989fec9" :question/math-academy-id "q-341466" :question/problem "Use the definition of Laplace transforms to calculate $F(s)=L{f(t)},$ where $f(t)$ is given by \n\n$$\nf(t)={\\begin{aligned}{e}^{t},\\, & t\\le 4 \\\\ 2\\, & t>4.\\end{aligned}\n$$\n\n$\\,F(s)=L{f(t)}=$ {{field-1}},\nvalid for {{field-2}}." :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\nf(t)={\\begin{aligned}{e}^{t},\\, & t\\le 4 \\\\ 2\\, & t>4\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{4}{e}^{t}\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{4}^{\\infty }2\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{4}{e}^{t-st}\\,\\text{d}t+{\\int }_{4}^{\\infty }2{e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{4}{e}^{(1-s)t}\\,\\text{d}t+{\\int }_{4}^{\\infty }2{e}^{-st}\\,\\text{d}t.\\end{aligned}\n$$\n\nNote that the improper integral diverges if $s\\le 0.$\n\nFor $s>0,$ we calculate our Laplace transform as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{4}{e}^{(1-s)t}\\,\\text{d}t+{\\int }_{4}^{\\infty }2{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{1}{1-s}{[{e}^{(1-s)t}]}_{0}^{4}+{\\int }_{4}^{\\infty }2{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{{e}^{4(1-s)}-1}{1-s}+{lim}_{a\\to \\infty }{\\int }_{4}^{a}2{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{{e}^{4(1-s)}-1}{1-s}+{lim}_{a\\to \\infty }{(\\frac{-2{e}^{-st}}{s})|}_{4}^{a} \\\\  & =\\frac{{e}^{4(1-s)}-1}{1-s}-\\frac{2}{s}\\cdot {lim}_{a\\to \\infty }({e}^{-as}-{e}^{-4s}) \\\\  & =\\frac{{e}^{4(1-s)}-1}{1-s}-\\frac{2}{s}\\cdot (0-{e}^{-4s}) \\\\  & =\\frac{{e}^{4(1-s)}-1}{1-s}+\\frac{2{e}^{-4s}}{s}\\end{aligned}\n$$\n\nvalid for $s>0.$"} {:db/id #edb/ref 17592186315104 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "290f52b2-20e6-5905-988c-748802b627d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186312286}] :answer-field/correct {:answer/id #uuid "290f52b2-20e6-5905-988c-748802b627d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186312286} :answer-field/id #uuid "c222c8e2-34bd-53c8-8877-54fd0121599e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314556}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9a67f2b8-f03c-57a0-a261-901981830dca" :question/math-academy-id "q-341468" :question/problem "The values of functions $h(t)$ and $z(t)$ and their derivatives at $t=4$ are given in the table below.\n\n| $t$ | $h(t)$ | $z(t)$ | ${h}^{′}(t)$ | ${z}^{′}(t)$ |\n| --- | --- | --- | --- | --- |\n| $4$ | $1$ | $-2$ | $3$ | $1$ |\n\nIf $f(t)=\\frac{2h(t)-5}{1-z(t)},$ compute ${f}^{′}(4).$ Do not round the answer.\n\n${f}^{′}(4)=$\n{{field-1}}" :question/worked-solution "The quotient rule states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}(\\frac{u}{v})=\\frac{{u}^{′}v-u{v}^{′}}{{v}^{2}}.\n$$\n\nLet $u=2h(t)-5$ and $v=1-z(t).$ Differentiating each, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}t}=2{h}^{′}(t)\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}t}=-{z}^{′}(t).\n$$\n\nSubstituting into the quotient rule gives\n\n$$\n{f}^{′}(t)=\\frac{2{h}^{′}(t)(1-z(t))-(2h(t)-5)(-{z}^{′}(t))}{(1-z(t))^{2}}.\n$$\n\nAt $t=4,$ this gives\n\n$$\n\\begin{aligned}{f}^{′}(4) & =\\frac{2{h}^{′}(4)(1-z(4))-(2h(4)-5)(-{z}^{′}(4))}{(1-z(4))^{2}} \\\\  & =\\frac{2(3)(1-(-2))-(2(1)-5)(-1)}{(1-(-2))^{2}} \\\\  & =\\frac{2(3)(3)-(-3)(-1)}{(3)^{2}} \\\\  & =\\frac{18-3}{9} \\\\  & =\\frac{15}{9} \\\\  & =\\frac{5}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186315105 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b03c39a-d66f-509d-aa96-c01febc0a8b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>1" :db/id #edb/ref 17592186312174} {:answer/id #uuid "23ce276c-a9be-5285-bc2f-9845fe922be0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge -3" :db/id #edb/ref 17592186312240} {:answer/id #uuid "45b69667-ae8b-5608-a75f-137c919a8643" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>0" :db/id #edb/ref 17592186312545} {:answer/id #uuid "5c5b6022-8075-5b3f-a8a4-5a8175006cb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>-3" :db/id #edb/ref 17592186312712} {:answer/id #uuid "9c4f06bf-ae3b-5f51-8664-8fbd41b26aa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 0" :db/id #edb/ref 17592186313213} {:answer/id #uuid "d481a022-70b0-5abc-95c5-3c9643a3b858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 1" :db/id #edb/ref 17592186313649}] :answer-field/correct {:answer/id #uuid "45b69667-ae8b-5608-a75f-137c919a8643" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>0" :db/id #edb/ref 17592186312545} :answer-field/id #uuid "0d68bc5f-babd-5729-b187-91c49d57c0af" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314050} {:answer-field/choices [{:answer/id #uuid "0dac4e39-fe64-592b-b123-ffa83935210e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{(3+s)}}{s+3}+\\frac{4{e}^{-s}}{s}" :db/id #edb/ref 17592186312073} {:answer/id #uuid "49b1a34e-4f54-521a-938a-3f4fcf66a727" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-(3+s)}-1}{s+3}-\\frac{4{e}^{-s}}{s}" :db/id #edb/ref 17592186312571} {:answer/id #uuid "6e2d16f4-8495-5f9c-b906-2811f641820f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-(3+s)}}{s+3}+\\frac{4{e}^{-s}}{s}" :db/id #edb/ref 17592186312843} {:answer/id #uuid "a2c16455-9df2-5b54-9874-0b208ea1b9ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-{e}^{-(3+s)}}{3+s}+\\frac{4{e}^{-s}}{s}" :db/id #edb/ref 17592186313254}] :answer-field/correct {:answer/id #uuid "a2c16455-9df2-5b54-9874-0b208ea1b9ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-{e}^{-(3+s)}}{3+s}+\\frac{4{e}^{-s}}{s}" :db/id #edb/ref 17592186313254} :answer-field/id #uuid "20a7de68-5385-5701-a7ba-f5141a58a397" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314097}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3a39794a-3f3c-5f7a-adcb-d68165de84a1" :question/math-academy-id "q-341481" :question/problem "Use the definition of Laplace transforms to calculate $F(s)=L{f(t)},$ where $f(t)$ is given by \n\n$$\nf(t)={\\begin{aligned}{e}^{-3t},\\, & t\\le 1 \\\\ 4\\, & t>1.\\end{aligned}\n$$\n\n$\\,F(s)=L{f(t)}=$ {{field-1}},\nvalid for {{field-2}}." :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\nf(t)={\\begin{aligned}{e}^{-3t},\\, & t\\le 1 \\\\ 4\\, & t>1\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{-3t}\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{1}^{\\infty }4\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{-3t-st}\\,\\text{d}t+{\\int }_{1}^{\\infty }4\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{-(3+s)t}\\,\\text{d}t+{\\int }_{1}^{\\infty }4{e}^{-st}\\,\\text{d}t.\\end{aligned}\n$$\n\nNote that the improper integral diverges if $s\\le 0.$\n\nFor $s>0,$ we calculate our Laplace transform as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{1}{e}^{-(3+s)t}\\,\\text{d}t+{\\int }_{1}^{\\infty }4{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{1}{-(3+s)}{[{e}^{-(3+s)t}]}_{0}^{1}+{\\int }_{1}^{\\infty }4{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{1-{e}^{-(3+s)}}{3+s}+{lim}_{a\\to \\infty }{\\int }_{1}^{a}4{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{1-{e}^{-(3+s)}}{3+s}+{lim}_{a\\to \\infty }{(\\frac{-4{e}^{-st}}{s})|}_{1}^{a} \\\\  & =\\frac{1-{e}^{-(3+s)}}{3+s}-\\frac{4}{s}\\cdot {lim}_{a\\to \\infty }({e}^{-as}-{e}^{-s}) \\\\  & =\\frac{1-{e}^{-(3+s)}}{3+s}-\\frac{4}{s}\\cdot (0-{e}^{-s}) \\\\  & =\\frac{1-{e}^{-(3+s)}}{3+s}+\\frac{4{e}^{-s}}{s}\\end{aligned}\n$$\n\nvalid for $s>0.$"} {:db/id #edb/ref 17592186315106 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fec0518-6db1-5a1a-87fd-0be56c14ec24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.73" :db/id #edb/ref 17592186312357}] :answer-field/correct {:answer/id #uuid "2fec0518-6db1-5a1a-87fd-0be56c14ec24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.73" :db/id #edb/ref 17592186312357} :answer-field/id #uuid "ac09dbc9-4c7f-5daf-a0d0-d838c2f1ffb0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314474}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e50cad91-21d9-539e-b085-381c16d9469f" :question/math-academy-id "q-341492" :question/problem "The data below is taken from the table of values of the cumulative distribution function $Φ(z)$ for the standard normal distribution. Given that $X∼N(1.5,{\\sigma }^{2})$ and $P(X<2)=0.5910,$ use the table value to find ${\\sigma }^{2},$ rounded to $2$ decimal places.\n\n| $z$ | $\\,0.02\\,$ | $\\,0.03\\,$ | $\\,0.04\\,$ |\n| --- | --- | --- | --- |\n| $\\,0.1\\,$ | $\\,0.5478\\,$ | $\\,0.5517\\,$ | $\\,0.5557\\,$ |\n| $\\,0.2\\,$ | $\\,0.5871\\,$ | $\\,0.5910\\,$ | $\\,0.5948\\,$ |\n| $\\,0.3\\,$ | $\\,0.6255\\,$ | $\\,0.6293\\,$ | $\\,0.6331\\,$ |\n\n${\\sigma }^{2}≈$\n{{field-1}}" :question/worked-solution "First, we convert the given probability into a cumulative probability:\n\n$$\n\\begin{aligned}P(X<2)=0.5910\\,⇒\\,P(X\\le 2)=0.5910\\end{aligned}\n$$\n\nThen, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(X\\le 2) & =0.5910 \\\\ P\\,(Z\\le \\frac{2-1.5}{\\sigma }) & =0.5910 \\\\ Φ\\,(\\frac{0.5}{\\sigma }) & =0.5910 \\\\ \\frac{0.5}{\\sigma } & ={Φ}^{-1}(0.5910)\\end{aligned}\n$$\n\nAccording to the table, we have\n\n$$\nΦ(0.23)=0.5910\\,⇒\\,{Φ}^{-1}(0.5910)=0.23.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{0.5}{\\sigma } & =0.23 \\\\ \\sigma  & =\\frac{0.5}{0.23} \\\\ \\sigma  & ≈2.173\\,91,\\end{aligned}\n$$\n\nrounded to $5$ decimal places.\n\nFinally,\n\n$$\n\\begin{aligned}{\\sigma }^{2}=(2.173\\,91)^{2}≈4.73.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186315107 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7cb390c-e572-53a0-b9de-83c29e711d66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{x}}+3{sec}^{2}x" :db/id #edb/ref 17592186313955}] :answer-field/correct {:answer/id #uuid "f7cb390c-e572-53a0-b9de-83c29e711d66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{x}}+3{sec}^{2}x" :db/id #edb/ref 17592186313955} :answer-field/id #uuid "980400c0-8e83-5892-8b48-98f7e9a9af2a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314422}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d99ea33e-6fab-5224-901c-7ede7395140b" :question/math-academy-id "q-341495" :question/problem "Find ${f}^{′}(x)$ if $f(x)=4\\sqrt{x}+3tan⁡x.$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x.$ Applying these formulas, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4\\sqrt{x}+3tan⁡x) \\\\  & =4\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})+3\\frac{\\text{d}}{\\text{d}x}(tan⁡x) \\\\  & =4(\\frac{1}{2\\sqrt{x}})+3({sec}^{2}⁡x) \\\\  & =\\frac{2}{\\sqrt{x}}+3{sec}^{2}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186315109 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b99e4117-0aad-50da-a0ea-7f1605f6f881" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4+10{y}^{4}" :db/id #edb/ref 17592186313421}] :answer-field/correct {:answer/id #uuid "b99e4117-0aad-50da-a0ea-7f1605f6f881" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4+10{y}^{4}" :db/id #edb/ref 17592186313421} :answer-field/id #uuid "a13b0fcc-1e2e-571c-b6df-a879bcbc6ca8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314443}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aed30416-75f3-525a-aed4-35612b1daf20" :question/math-academy-id "q-341608" :question/problem "Given that $x=-\\frac{2}{{y}^{2}}+5{y}^{2},$ express $\\frac{\\text{d}y}{\\text{d}x}$ as a function of $y.$\n\n| $\\text{d}y$ | $=$ | ${y}^{3}$ |\n| --- | --- | --- |\n| $\\text{d}x$ |  | {{field-1}} |" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(-\\frac{2}{{y}^{2}}+5{y}^{2}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(-2{y}^{-1}+5{y}^{2}) \\\\  & =-2\\frac{\\text{d}}{\\text{d}y}({y}^{-2})+5\\frac{\\text{d}}{\\text{d}y}({y}^{2}) \\\\  & =-2(-2{y}^{-3})+5(2y) \\\\  & =\\frac{4}{{y}^{3}}+10y \\\\  & =\\frac{4+10{y}^{4}}{{y}^{3}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{{y}^{3}}{4+10{y}^{4}}.\n$$"} {:db/id #edb/ref 17592186317157 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c50f4870-1fee-5fbb-88c9-7019bf10dac5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{13}" :db/id #edb/ref 17592186316226}] :answer-field/correct {:answer/id #uuid "c50f4870-1fee-5fbb-88c9-7019bf10dac5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{13}" :db/id #edb/ref 17592186316226} :answer-field/id #uuid "93b3e742-b588-5f94-8536-ec336cad03a4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316886}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7b5bef75-1150-511d-bcb8-1729f4fd0d44" :question/math-academy-id "q-341634" :question/problem "If $x=4{y}^{4}-3y,$ find $\\frac{\\text{d}y}{\\text{d}x}$ at the point $(1,1).$\n\n$\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(1,1)}=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(4{y}^{4}-3y) \\\\  & =4\\frac{\\text{d}}{\\text{d}y}({y}^{4})-3\\frac{\\text{d}}{\\text{d}y}(y) \\\\  & =4(4{y}^{3})-3 \\\\  & =16{y}^{3}-3\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{1}{16{y}^{3}-3}.\n$$\n\nFinally, substituting the point $(1,1),$ we find\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(1,1)} & =\\frac{1}{16({1}^{3})-3}=\\frac{1}{13}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317159 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73b6a40d-d5af-574c-9c82-43dd1d924703" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{28}" :db/id #edb/ref 17592186315775}] :answer-field/correct {:answer/id #uuid "73b6a40d-d5af-574c-9c82-43dd1d924703" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{28}" :db/id #edb/ref 17592186315775} :answer-field/id #uuid "46fe6899-9adb-5c7a-a8ac-f8ecb1ec928b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316706}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "138e10f7-a58f-5db5-81ae-1e29e1a9812e" :question/math-academy-id "q-341636" :question/problem "If $x=2{y}^{3}+{y}^{2},$ find $\\frac{\\text{d}y}{\\text{d}x}$ at the point $(20,2).$\n\n$\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(20,2)}=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(2{y}^{3}+{y}^{2}) \\\\  & =2\\frac{\\text{d}}{\\text{d}y}({y}^{3})+\\frac{\\text{d}}{\\text{d}y}({y}^{2}) \\\\  & =2(3{y}^{2})+2y \\\\  & =6{y}^{2}+2y\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{1}{6{y}^{2}+2y}.\n$$\n\nFinally, substituting the point $(20,2),$ we find\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(20,2)} & =\\frac{1}{6({2}^{2})+2(2)}=\\frac{1}{28}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317164 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c7ba7c05-abae-54c2-8308-798505248b1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.30" :db/id #edb/ref 17592186316247}] :answer-field/correct {:answer/id #uuid "c7ba7c05-abae-54c2-8308-798505248b1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.30" :db/id #edb/ref 17592186316247} :answer-field/id #uuid "b87f1c6e-c8d2-5b9d-b0ea-9f20d81972ab" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316979}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f9f19fd2-6f5a-5fbb-8759-a811885f9345" :question/math-academy-id "q-341651" :question/problem "The data below is taken from the table of values of the cumulative distribution function $Φ(z)$ for the standard normal distribution. Given that $X∼N(-1,{\\sigma }^{2})$ and $P(X>1)=0.0618,$ use the table to find $\\sigma ,$ rounded to $2$ decimal places.\n\n| $z$ | $\\,0.04\\,$ | $\\,0.05\\,$ | $\\,0.06\\,$ |\n| --- | --- | --- | --- |\n| $\\,1.4\\,$ | $\\,0.9251\\,$ | $\\,0.9265\\,$ | $\\,0.9279\\,$ |\n| $\\,1.5\\,$ | $\\,0.9382\\,$ | $\\,0.9394\\,$ | $\\,0.9406\\,$ |\n| $\\,1.6\\,$ | $\\,0.9495\\,$ | $\\,0.9505\\,$ | $\\,0.9515\\,$ |\n\n$\\sigma ≈$\n{{field-1}}" :question/worked-solution "First, we convert the given probability into a cumulative probability using the complement:\n\n$$\n\\begin{aligned}P(X\\le 1) & =1-P(X>1) \\\\  & =1-0.0618 \\\\  & =0.9382\\end{aligned}\n$$\n\nThen, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(X\\le 1) & =0.9382 \\\\ P\\,(Z\\le \\frac{1-(-1)}{\\sigma }) & =0.9382 \\\\ Φ\\,(\\frac{2}{\\sigma }) & =0.9382 \\\\ \\frac{2}{\\sigma } & ={Φ}^{-1}(0.9382)\\end{aligned}\n$$\n\nAccording to the table, we have\n\n$$\nΦ(1.54)=0.9382\\,⇒\\,{Φ}^{-1}(0.9382)=1.54.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{2}{\\sigma } & =1.54 \\\\ \\sigma  & =\\frac{2}{1.54} \\\\ \\sigma  & ≈1.30,\\end{aligned}\n$$\n\nrounded to $2$ decimal places."} {:db/id #edb/ref 17592186317165 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66a8e441-b6b2-591b-944b-3cfddb0ac398" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186315690}] :answer-field/correct {:answer/id #uuid "66a8e441-b6b2-591b-944b-3cfddb0ac398" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186315690} :answer-field/id #uuid "d2534596-9656-56a2-a31c-8adf543ca897" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317042}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4a054739-7d5f-59e4-b190-1f466818f897" :question/math-academy-id "q-341655" :question/problem "The data below is taken from the table of values of the cumulative distribution function $Φ(z)$ for the standard normal distribution. Given that $X∼N(3,{\\sigma }^{2})$ and $P(X\\ge 1)=0.8413,$ use the table to find $\\sigma .$\n\n| $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ |\n| --- | --- | --- | --- |\n| $\\,-1.0\\,$ | $\\,0.1587\\,$ | $\\,0.1562\\,$ | $\\,0.1539\\,$ |\n| $\\,-0.9\\,$ | $\\,0.1841\\,$ | $\\,0.1814\\,$ | $\\,0.1788\\,$ |\n| $\\,-0.8\\,$ | $\\,0.2119\\,$ | $\\,0.2090\\,$ | $\\,0.2061\\,$ |\n\n$\\sigma =$\n{{field-1}}" :question/worked-solution "First, we convert the given probability into a cumulative probability using the complement:\n\n$$\n\\begin{aligned}P(X\\le 1) & =P(X<1) \\\\  & =1-P(X\\ge 1) \\\\  & =1-0.8413 \\\\  & =0.1587\\end{aligned}\n$$\n\nThen, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(X\\le 1) & =0.1587 \\\\ P\\,(Z\\le \\frac{1-3}{\\sigma }) & =0.1587 \\\\ Φ\\,(-\\frac{2}{\\sigma }) & =0.1587 \\\\ -\\frac{2}{\\sigma } & ={Φ}^{-1}(0.1587)\\end{aligned}\n$$\n\nAccording to the table, we have\n\n$$\nΦ(-1.00)=0.1587\\,⇒\\,{Φ}^{-1}(0.1587)=-1.00.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}-\\frac{2}{\\sigma } & =-1 \\\\ \\sigma  & =\\frac{2}{1} \\\\ \\sigma  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317173 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04625262-02e3-5735-baa9-8341f10fe02c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186315140}] :answer-field/correct {:answer/id #uuid "04625262-02e3-5735-baa9-8341f10fe02c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186315140} :answer-field/id #uuid "ccfdc307-43ba-59d0-bfef-8dec92c5a903" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317031}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0a20dd68-509a-5704-9c10-a08b87646850" :question/math-academy-id "q-341745" :question/problem "If $x={y}^{4}-\\frac{3}{y},$ find $\\frac{\\text{d}y}{\\text{d}x}$ at the point $(4,-1).$\n\n$\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(4,-1)}=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}({y}^{4}-\\frac{3}{y}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}({y}^{4})-3\\frac{\\text{d}}{\\text{d}y}({y}^{-1}) \\\\  & =4{y}^{3}-3(-{y}^{-2}) \\\\  & =4{y}^{3}+3{y}^{-2} \\\\  & =4{y}^{3}+\\frac{3}{{y}^{2}} \\\\  & =\\frac{4{y}^{5}+3}{{y}^{2}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{{y}^{2}}{4{y}^{5}+3}.\n$$\n\nFinally, substituting the point $(4,-1),$ we find\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(4,-1)} & =\\frac{(-1)^{2}}{4(-1)^{5}+3}=-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6bc8dbd-b2e6-5cdf-a87f-15c55de69984" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186316317}] :answer-field/correct {:answer/id #uuid "d6bc8dbd-b2e6-5cdf-a87f-15c55de69984" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186316317} :answer-field/id #uuid "150499da-4d4c-5a7a-a641-6e789fc3eda1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316595}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cedc590a-5ca0-5fc5-bd76-db896782c449" :question/math-academy-id "q-341751" :question/problem "If $x=-\\frac{16}{\\sqrt[3]{y}}+13,$ find $\\frac{\\text{d}y}{\\text{d}x}$ at the point $(5,8).$\n\n$\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(5,8)}=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(-\\frac{16}{\\sqrt[3]{y}}+13) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(-16{y}^{-1/3}+13) \\\\  & =-16\\frac{\\text{d}}{\\text{d}y}({y}^{-1/3})+\\frac{\\text{d}}{\\text{d}y}(13) \\\\  & =-16(-\\frac{1}{3}{y}^{-4/3})+0 \\\\  & =\\frac{16}{3}{y}^{-4/3} \\\\  & =\\frac{16}{3{(\\sqrt[3]{y})}^{4}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{3{(\\sqrt[3]{y})}^{4}}{16}.\n$$\n\nFinally, substituting the point $(5,8),$ we find\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(5,8)} & =\\frac{3{(\\sqrt[3]{8})}^{4}}{16} \\\\  & =\\frac{3(16)}{16} \\\\  & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317175 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5940053-6ffd-56dc-91ae-1c3e0c96776a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186316147}] :answer-field/correct {:answer/id #uuid "b5940053-6ffd-56dc-91ae-1c3e0c96776a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186316147} :answer-field/id #uuid "fa18cac4-b60b-5b97-ba75-3318b18e72b7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317135}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3fca9bbb-c820-579a-91ba-addcd4437f36" :question/math-academy-id "q-341757" :question/problem "If $x=-\\frac{12}{\\sqrt{y}}-2y\\sqrt{y},$ find $\\frac{\\text{d}y}{\\text{d}x}$ at the point $(-14,1).$\n\n$\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(-14,1)}=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(-\\frac{12}{\\sqrt{y}}-2y\\sqrt{y}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(-12{y}^{-1/2}-2y\\cdot {y}^{1/2}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(-12{y}^{-1/2}-2{y}^{3/2}) \\\\  & =-12\\frac{\\text{d}}{\\text{d}y}({y}^{-1/2})-2\\frac{\\text{d}}{\\text{d}y}({y}^{3/2}) \\\\  & =-12(-\\frac{1}{2}){y}^{-3/2}-2\\cdot \\frac{3}{2}{y}^{1/2} \\\\  & =6{y}^{-3/2}-3{y}^{1/2} \\\\  & =\\frac{6}{y\\sqrt{y}}-3\\sqrt{y} \\\\  & =\\frac{6-3{y}^{2}}{y\\sqrt{y}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{y\\sqrt{y}}{6-3{y}^{2}}.\n$$\n\nFinally, substituting the point $(-14,1),$ we find\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(-14,1)} & =\\frac{1\\sqrt{1}}{6-3(1)^{2}} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317178 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "264561c5-9799-51c9-a009-d1202a71c2b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186315334}] :answer-field/correct {:answer/id #uuid "264561c5-9799-51c9-a009-d1202a71c2b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186315334} :answer-field/id #uuid "79eafde2-60a3-502c-bcb3-a8d0d2d51c6e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316837}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e12f9894-53cb-5435-b393-ea7e08594626" :question/math-academy-id "q-341789" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(n\\pi x)+{b}_{n}\\operatorname{sin}⁡(n\\pi x)\n$$\n\nLet $F(x)=6{x}^{2}+5x+1$ for $x\\in [-1,1).$ The Fourier series of the $2$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the constant term is given by\n\n$$\n{a}_{0}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\,\\text{d}x.\n$$\n\nIn our case, $L=1$ and $f(x)=6{x}^{2}+5x+1$ for $x\\in [-1,1).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{1}{\\int }_{-1}^{1}(6{x}^{2}+5x+1)\\,\\text{d}x \\\\  & ={[2{x}^{3}+\\frac{5}{2}{x}^{2}+x]}_{-1}^{1} \\\\  & =(2+\\frac{5}{2}+1)-((-2)+\\frac{5}{2}+(-1)) \\\\  & =\\frac{11}{2}-(-\\frac{1}{2}) \\\\  & =6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317183 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4265357-1f5a-572b-b951-6c8731bedf0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186316044}] :answer-field/correct {:answer/id #uuid "a4265357-1f5a-572b-b951-6c8731bedf0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186316044} :answer-field/id #uuid "01b8be81-ed30-5c06-b89b-3ae37ec6ccee" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316550}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "04d16541-33c4-5168-abf0-25ac42f61efd" :question/math-academy-id "q-341825" :question/problem "Calculate the instantaneous rate of change of the function $f(x)=\\operatorname{tan}⁡x-{x}^{2}$ when $x=0.$\n\n${f}^{′}(0)=$\n{{field-1}}" :question/worked-solution "The instantaneous rate of change when $x=0$ is given by the value of the derivative ${f}^{′}(x)$ at $x=0.$ \n\nFirst, we compute the derivative, using the fact that $\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡x)={sec}^{2}⁡x$ and $\\frac{\\text{d}}{\\text{d}x}({x}^{2})=2x.$ We get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡x-{x}^{2}) \\\\  & ={sec}^{2}⁡x-2x.\\end{aligned}\n$$\n\nEvaluating at $x=0,$ we get\n\n$$\n\\begin{aligned}{f}^{′}(0) & ={sec}^{2}⁡(0)-2\\cdot 0 \\\\  & ={(\\frac{1}{\\operatorname{cos}⁡(0)})}^{2}-0 \\\\  & ={(\\frac{1}{1})}^{2} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change is $1.$"} {:db/id #edb/ref 17592186317186 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dfdc63a9-81e1-5712-aacb-47ce364408eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186316359}] :answer-field/correct {:answer/id #uuid "dfdc63a9-81e1-5712-aacb-47ce364408eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186316359} :answer-field/id #uuid "ffea591d-4a5e-53f6-9c48-f7ec134caf67" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317156}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e12d099b-7b80-5e58-a8d0-f694cba87a2b" :question/math-academy-id "q-341870" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n}{3}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n}{3}x)\n$$\n\nLet $F(x)=-3x+1$ for $x\\in [-3\\pi ,3\\pi ).$ The Fourier series of the $6\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${a}_{4}.$\n\n${a}_{4}=$ {{field-1}}" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the cosine coefficients are given by\n\n$$\n{a}_{n}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)\\,\\text{d}x.\n$$\n\nIn our case, $L=3\\pi $ and $f(x)=-3x+1$ for $x\\in [-3\\pi ,3\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{4} & =\\frac{1}{3\\pi }{\\int }_{-\\pi }^{\\pi }(-3x+1)\\operatorname{cos}⁡(\\frac{4\\pi }{3\\pi }x)\\,\\text{d}x \\\\  & =\\frac{1}{3\\pi }{\\int }_{-\\pi }^{\\pi }(-3x+1)\\operatorname{cos}⁡(\\frac{4}{3}x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=-3x+1\\, & ⇒\\,{u}^{′}=-3 \\\\ {v}^{′}=\\operatorname{cos}⁡(\\frac{4}{3}x)\\, & ⇒\\,v=\\frac{3}{4}\\operatorname{sin}⁡(\\frac{4}{3}x)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{4} & =\\frac{1}{3\\pi }(uv\\,{|}_{-3\\pi }^{3\\pi }-{\\int }_{-3\\pi }^{3\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{1}{3\\pi }(\\frac{3}{4}{[(-3x+1)\\operatorname{sin}⁡(\\frac{4}{3}x)]}_{-3\\pi }^{3\\pi }-{\\int }_{-3\\pi }^{3\\pi }\\frac{3}{4}\\operatorname{sin}⁡(\\frac{4}{3}x)\\cdot (-3)\\,\\text{d}x) \\\\  & =\\frac{1}{3\\pi }(\\frac{3}{4}[(-9\\pi +1)\\operatorname{sin}⁡(4\\pi )-(9\\pi +1)\\operatorname{sin}⁡(-4\\pi )]+\\frac{9}{4}{\\int }_{-3\\pi }^{3\\pi }\\operatorname{sin}⁡(\\frac{4}{3}x)\\,\\text{d}x) \\\\  & =\\frac{1}{\\pi }(\\frac{1}{4}\\cdot 0+\\frac{9}{4}\\cdot (-\\frac{3}{4}){[\\operatorname{cos}⁡(\\frac{4}{3}x)]}_{-3\\pi }^{3\\pi }) \\\\  & =\\frac{1}{\\pi }(-\\frac{27}{16}[\\operatorname{cos}⁡(4\\pi )-\\operatorname{cos}⁡(-4\\pi )]) \\\\  & =-\\frac{27}{16\\pi }(1-1) \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317187 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28f6f736-4009-5b4f-8058-a10414188390" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186315353}] :answer-field/correct {:answer/id #uuid "28f6f736-4009-5b4f-8058-a10414188390" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186315353} :answer-field/id #uuid "52e5c64b-d713-5876-b513-033b01dba8b2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316740}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0a97764f-f130-5df7-bef4-c5372f6f59c9" :question/math-academy-id "q-341915" :question/problem "Find the slope $m$ of the tangent at the point $(16,\\,4)$ for the curve $\\sqrt{x}+\\sqrt{y}=6.$\n\n$m=$\n{{field-1}}" :question/worked-solution "To find the slope at a point, we use implicit differentiation to calculate the derivative of the curve, assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}+\\sqrt{y}) & =\\frac{\\text{d}}{\\text{d}x}(6) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{1/2}+{y}^{1/2}) & =\\frac{\\text{d}}{\\text{d}x}(6) \\\\ \\frac{1}{2}{x}^{-1/2}+\\frac{1}{2}{y}^{-1/2}(\\frac{\\text{d}y}{\\text{d}x}) & =0 \\\\ \\frac{1}{2}{y}^{-1/2}(\\frac{\\text{d}y}{\\text{d}x}) & =-\\frac{1}{2}{x}^{-1/2} \\\\ \\frac{1}{2\\sqrt{y}}(\\frac{\\text{d}y}{\\text{d}x}) & =-\\frac{1}{2\\sqrt{x}} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{\\sqrt{y}}{\\sqrt{x}}\\end{aligned}\n$$\n\nThe slope of the tangent at the point $(16,\\,4)$ is then given by\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{(16,\\,4)} \\\\  & ={(-\\frac{\\sqrt{y}}{\\sqrt{x}})|}_{(16,\\,4)} \\\\  & =-\\frac{\\sqrt{4}}{\\sqrt{16}} \\\\  & =-\\frac{2}{4} \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317188 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ae7cae9-79ff-5f39-85da-df94153947dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186315719}] :answer-field/correct {:answer/id #uuid "6ae7cae9-79ff-5f39-85da-df94153947dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186315719} :answer-field/id #uuid "0fd4eb5e-7bd4-5910-bd71-b6d0c5d615da" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316585}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "be11712d-8184-5176-b182-3e96ce7e8e3b" :question/math-academy-id "q-341918" :question/problem "Find the slope $m$ of the tangent at the point $(9,\\,4)$ for the curve $\\sqrt{x}-\\sqrt{y}=1.$\n\n$m=$\n{{field-1}}" :question/worked-solution "To find the slope at a point, we use implicit differentiation to calculate the derivative of the curve, assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}-\\sqrt{y}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{1/2}-{y}^{1/2}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{1}{2}{x}^{-1/2}-\\frac{1}{2}{y}^{-1/2}(\\frac{\\text{d}y}{\\text{d}x}) & =0 \\\\ -\\frac{1}{2}{y}^{-1/2}(\\frac{\\text{d}y}{\\text{d}x}) & =-\\frac{1}{2}{x}^{-1/2} \\\\ -\\frac{1}{2\\sqrt{y}}(\\frac{\\text{d}y}{\\text{d}x}) & =-\\frac{1}{2\\sqrt{x}} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\sqrt{y}}{\\sqrt{x}}\\end{aligned}\n$$\n\nThe slope of the tangent at the point $(9,\\,4)$ is then given by\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{(9,\\,4)} \\\\  & ={(\\frac{\\sqrt{y}}{\\sqrt{x}})|}_{(9,\\,4)} \\\\  & =\\frac{\\sqrt{4}}{\\sqrt{9}} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317190 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80592157-1fdb-5e01-851d-d4d9a2def852" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.43" :db/id #edb/ref 17592186315824}] :answer-field/correct {:answer/id #uuid "80592157-1fdb-5e01-851d-d4d9a2def852" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.43" :db/id #edb/ref 17592186315824} :answer-field/id #uuid "86d59564-fbce-500f-9999-d29e15a7f0fc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316858}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "171aa441-28c9-56ed-921a-96a0833a165c" :question/math-academy-id "q-341991" :question/problem "The data below is taken from the table of values of the cumulative distribution function $Φ(z)$ for the standard normal distribution. Given that $X∼N(0,{\\sigma }^{2})$ is a normal random variable with $P(-2<X<2)=0.6578,$ find ${\\sigma }^{2}$ rounded to $2$ decimal places.\n\n| $z$ | $\\,0.04\\,$ | $\\,0.05\\,$ | $\\,0.06\\,$ |\n| --- | --- | --- | --- |\n| $\\,0.8\\,$ | $\\,0.7995\\,$ | $\\,0.8023\\,$ | $\\,0.8051\\,$ |\n| $\\,0.9\\,$ | $\\,0.8264\\,$ | $\\,0.8289\\,$ | $\\,0.8315\\,$ |\n| $\\,1.0\\,$ | $\\,0.8508\\,$ | $\\,0.8531\\,$ | $\\,0.8554\\,$ |\n\n${\\sigma }^{2}≈$\n{{field-1}}" :question/worked-solution "First, we find the cumulative probability using symmetry:\n\n$$\n\\begin{aligned}P(-2<X<2) & =0.6578 \\\\ 2P(0<X<2) & =0.6578 \\\\ P(0<X<2) & =0.3289 \\\\ P(X<2)-P(X<0) & =0.3289 \\\\ P(X<2)-0.5 & =0.3289 \\\\ P(X<2) & =0.8289 \\\\ P(X\\le 2) & =0.8289\\end{aligned}\n$$\n\nThen, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(X\\le 2) & =0.8289 \\\\ P\\,(Z\\le \\frac{2-0}{\\sigma }) & =0.8289 \\\\ Φ\\,(\\frac{2}{\\sigma }) & =0.8289 \\\\ \\frac{2}{\\sigma } & ={Φ}^{-1}(0.8289)\\end{aligned}\n$$\n\nAccording to the table, we have\n\n$$\nΦ(0.95)=0.8289\\,⇒\\,{Φ}^{-1}(0.8289)=0.95.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{2}{\\sigma } & =0.95 \\\\ \\sigma  & =\\frac{2}{0.95} \\\\ \\sigma  & ≈2.105\\,26.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =(2.105\\,26)^{2} \\\\  & ≈4.43\\end{aligned}\n$$\n\nrounded to $2$ decimal places."} {:db/id #edb/ref 17592186317194 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62132428-191b-5bdb-8047-c131604498ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186315668}] :answer-field/correct {:answer/id #uuid "62132428-191b-5bdb-8047-c131604498ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186315668} :answer-field/id #uuid "686733a1-a011-561c-9118-65ee67b8331e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316798}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6e084cbe-6414-54d1-af07-4d96798fc98c" :question/math-academy-id "q-342004" :question/problem "The function $f(x)$ is defined as\n\n$$\nf(x)={\\begin{aligned}-x+4, & x<1, \\\\ 2x-3, & x\\ge 1.\\end{aligned}\n$$\n\nThen,\n\n${\\int }_{-3}^{4}f(x)\\,\\text{d}x=$\n{{field-1}}." :question/worked-solution "By the additive property of the definite integral, we have\n\n$$\n\\begin{aligned}{\\int }_{-3}^{4}f(x)\\,\\text{d}x & ={\\int }_{-3}^{1}(-x+4)\\,\\text{d}x\\,+\\,{\\int }_{1}^{4}(2x-3)\\,\\text{d}x \\\\  & =(-\\frac{{x}^{2}}{2}+4x){|}_{-3}^{1}+({x}^{2}-3x){|}_{1}^{4} \\\\  & =[\\,-\\frac{{1}^{2}}{2}+4\\cdot 1-(-\\frac{(-3)^{2}}{2}+4(-3))]+\\,[{4}^{2}-3\\cdot 4-({1}^{2}-3\\cdot 1)] \\\\  & =[-\\frac{1}{2}+4-(-\\frac{9}{2}-12)]+[16-12-(1-3)] \\\\  & =[\\frac{7}{2}-(-\\frac{33}{2})]+6 \\\\  & =\\frac{40}{2}+6 \\\\  & =20+6 \\\\  & =26.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317196 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a34cf8c-f9f9-5082-8ee4-5a43a6a7eef9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186315543}] :answer-field/correct {:answer/id #uuid "4a34cf8c-f9f9-5082-8ee4-5a43a6a7eef9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186315543} :answer-field/id #uuid "bc25a7bd-5f8b-5142-bd15-2ca2aaac680c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316990}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0c8d2b0d-3143-5cce-8ab8-84982116a634" :question/math-academy-id "q-342011" :question/problem "The function $f(x)$ is defined as\n\n$$\nf(x)={\\begin{aligned}{x}^{2}, & x<1, \\\\ -2x+3, & x\\ge 1.\\end{aligned}\n$$\n\nThen,\n\n${\\int }_{-1}^{3}f(x)\\,\\text{d}x=$\n{{field-1}}." :question/worked-solution "By the additive property of the definite integral, we have\n\n$$\n\\begin{aligned}{\\int }_{-1}^{3}f(x)\\,\\text{d}x & ={\\int }_{-1}^{1}{x}^{2}\\,\\text{d}x\\,+\\,{\\int }_{1}^{3}(-2x+3)\\,\\text{d}x \\\\  & =(\\frac{{x}^{3}}{3}){|}_{-1}^{1}\\,+\\,(-{x}^{2}+3x){|}_{1}^{3} \\\\  & =[\\frac{1}{3}(1)^{3}-(\\frac{1}{3}(-1)^{3})]\\,+\\,[-{3}^{2}+3(3)-(-{1}^{2}+3(1))] \\\\  & =[\\frac{1}{3}-(-\\frac{1}{3})]\\,+\\,[0-2] \\\\  & =\\frac{2}{3}-2 \\\\  & =-\\frac{4}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317200 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "318eb2a8-8c99-528a-b650-3ef675903063" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}x+\\frac{3}{2}" :db/id #edb/ref 17592186315404}] :answer-field/correct {:answer/id #uuid "318eb2a8-8c99-528a-b650-3ef675903063" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}x+\\frac{3}{2}" :db/id #edb/ref 17592186315404} :answer-field/id #uuid "22d4f768-7f1c-5457-b769-1e7a1c0d47c9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316628}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "36c42cd0-1bd6-5da5-bcdd-62163c6c7278" :question/math-academy-id "q-342049" :question/problem "Given a curve $x=2y-\\frac{6}{y},$ what is the equation of the tangent to the curve at the point $(4,3)?$\n\n$y=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(2y-\\frac{6}{y}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(2y-6{y}^{-1}) \\\\  & =2\\frac{\\text{d}}{\\text{d}y}(y)-6\\frac{\\text{d}}{\\text{d}y}({y}^{-1}) \\\\  & =2(1)-6(-{y}^{-2}) \\\\  & =2+6{y}^{-2} \\\\  & =2+\\frac{6}{{y}^{2}} \\\\  & =\\frac{2{y}^{2}+6}{{y}^{2}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{{y}^{2}}{2{y}^{2}+6}.\n$$\n\nThe slope of the tangent to the curve at the point $(4,3)$ is\n\n$$\n\\begin{aligned}m & =\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(4,3)} \\\\  & =\\frac{{3}^{2}}{2(3)^{2}+6} \\\\  & =\\frac{9}{24} \\\\  & =\\frac{3}{8}\\end{aligned}\n$$\n\nUsing the point-slope formula for a tangent line, we get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-3 & =\\frac{3}{8}\\cdot (x-4) \\\\ y & =\\frac{3}{8}x-\\frac{3}{2}+3 \\\\ y & =\\frac{3}{8}x+\\frac{3}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317201 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f682182f-4187-5c58-b891-e436d925ac71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{7}x+\\frac{11}{7}" :db/id #edb/ref 17592186316494}] :answer-field/correct {:answer/id #uuid "f682182f-4187-5c58-b891-e436d925ac71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{7}x+\\frac{11}{7}" :db/id #edb/ref 17592186316494} :answer-field/id #uuid "a8095d7c-7888-58df-bb91-75240c8b1c76" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316937}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "97a8acd9-41d2-5ef2-85c4-307d0b8faeeb" :question/math-academy-id "q-342050" :question/problem "Given a curve $x=-\\frac{5}{y}+{y}^{2},$ what is the equation of the tangent to the curve at the point $(-4,1)?$\n\n$y=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(-\\frac{5}{y}+{y}^{2}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(-5{y}^{-1}+{y}^{2}) \\\\  & =-5\\frac{\\text{d}}{\\text{d}y}({y}^{-1})+\\frac{\\text{d}}{\\text{d}y}({y}^{2}) \\\\  & =-5(-{y}^{-2})+2y \\\\  & =2y+5{y}^{-2} \\\\  & =2y+\\frac{5}{{y}^{2}} \\\\  & =\\frac{2{y}^{3}+5}{{y}^{2}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{{y}^{2}}{2{y}^{3}+5}.\n$$\n\nThe slope of the tangent to the curve at the point $(-4,1)$ is\n\n$$\n\\begin{aligned}m & =\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(-4,1)} \\\\  & =\\frac{{1}^{2}}{2(1)^{3}+5} \\\\  & =\\frac{1}{2+5} \\\\  & =\\frac{1}{7}.\\end{aligned}\n$$\n\nUsing the point-slope formula for a tangent line, we get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =\\frac{1}{7}\\cdot (x-(-4)) \\\\ y & =\\frac{1}{7}x+\\frac{4}{7}+1 \\\\ y & =\\frac{1}{7}x+\\frac{11}{7}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317202 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "048414bf-f733-539d-a4a7-a58005a57223" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x+5" :db/id #edb/ref 17592186315141}] :answer-field/correct {:answer/id #uuid "048414bf-f733-539d-a4a7-a58005a57223" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x+5" :db/id #edb/ref 17592186315141} :answer-field/id #uuid "6a335d03-53e7-5c61-b38b-7609a4dda2b1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316802}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0c69ac0b-f1e2-5b4c-9ce4-6a862192ecf5" :question/math-academy-id "q-342061" :question/problem "Given a curve $x=6\\sqrt{y}-2{y}^{2},$ what is the equation of the tangent to the curve at the point $(4,1)?$\n\n$y=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(6\\sqrt{y}-2{y}^{2}) \\\\  & =6\\frac{\\text{d}}{\\text{d}y}(\\sqrt{y})-2\\frac{\\text{d}}{\\text{d}y}({y}^{2}) \\\\  & =6\\frac{\\text{d}}{\\text{d}y}({y}^{1/2})-2(2y) \\\\  & =6\\cdot \\frac{1}{2}{y}^{-1/2}-4y \\\\  & =3{y}^{-1/2}-4y \\\\  & =\\frac{3}{\\sqrt{y}}-4y \\\\  & =\\frac{3-4y\\sqrt{y}}{\\sqrt{y}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{\\sqrt{y}}{3-4y\\sqrt{y}}.\n$$\n\nThe slope of the tangent to the curve at the point $(4,1)$ is\n\n$$\n\\begin{aligned}m & =\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(4,1)} \\\\  & =\\frac{\\sqrt{1}}{3-4(1)\\sqrt{1}} \\\\  & =\\frac{1}{3-4} \\\\  & =-1.\\end{aligned}\n$$\n\nUsing the point-slope formula for a tangent line, we get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =-(x-4) \\\\ y & =-x+4+1 \\\\ y & =-x+5.\\end{aligned}\n$$"}]
