42ce-59d5-5839-85d3-c4e505bc822a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1)^{n+1}" :db/id #edb/ref 17592186315995}] :answer-field/correct {:answer/id #uuid "4f8df8b2-20ed-52bb-9e87-9be21ab82a03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186315571} :answer-field/id #uuid "c245d06f-5900-5a46-89d5-dbf08d5da9c0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186317007}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e47b2683-e120-52c6-81fc-c52d398d6446" :question/math-academy-id "q-343421" :question/problem "Consider the function $F(x)=|\\operatorname{sin}⁡(\\frac{x}{2})|$ defined on $x\\in [-\\pi ,\\pi ).$ The Fourier series of the $2\\pi $-periodic extension $f(x)$ of $F(x)$ is given by\n\n$$\nf(x)∼\\frac{2}{\\pi }-{\\sum }_{n=1}^{\\infty }\\frac{4}{\\pi (4{n}^{2}-1)}\\operatorname{cos}⁡(nx).\n$$\n\nSelect the correct options in the reasoning below.\n\nAt $x=0,$ we have\n\n$$\n\\operatorname{cos}⁡(n\\cdot 0)={{field-1}}.\n$$\n\nSince $f(x)$ is \n{{field-2}}\nat $x=0,$ the corresponding Fourier series converges to \n\n$$\nf(0)={{field-3}}.\n$$\n\nTherefore, we have \n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{1}{4{n}^{2}-1}={{field-4}}.\n$$" :question/worked-solution "First, we rewrite our Fourier series as\n\n$$\nf(x)∼\\frac{2}{\\pi }-\\frac{4}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{4{n}^{2}-1}\\cdot \\operatorname{cos}⁡(nx).\n$$\n\nNow, notice that at $x=0,$ we have\n\n$$\n\\operatorname{cos}⁡(n\\cdot 0)=\\operatorname{cos}⁡(0)=1.\n$$\n\nSince $f(x)$ is $\\text{continuous}$ at $x=0,$ the corresponding Fourier series converges to \n\n$$\nf(0)=|\\operatorname{sin}⁡(\\frac{0}{2})|=0.\n$$\n\n \n\nTherefore, we have \n\n$$\n\\begin{aligned}f(0) & =\\frac{2}{\\pi }-\\frac{4}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{4{n}^{2}-1}\\cdot \\operatorname{cos}⁡(n\\cdot 0) \\\\ 0 & =\\frac{2}{\\pi }-\\frac{4}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{4{n}^{2}-1}\\cdot 1 \\\\ -\\frac{2}{\\pi } & =-\\frac{4}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{4{n}^{2}-1} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{1}{4{n}^{2}-1} & =\\frac{1}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317401 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02ef83eb-7903-5ed1-889b-def0c697eddb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1)^{n+1}" :db/id #edb/ref 17592186315133} {:answer/id #uuid "27e8af18-0de0-586a-9eba-abc08ba0860f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186315346} {:answer/id #uuid "39b7289a-e50b-58ae-adf6-ed3e51b77d40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186315449} {:answer/id #uuid "da376413-1d3f-5fc1-a97f-75c417a4de92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1)^{n}" :db/id #edb/ref 17592186316335}] :answer-field/correct {:answer/id #uuid "02ef83eb-7903-5ed1-889b-def0c697eddb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1)^{n+1}" :db/id #edb/ref 17592186315133} :answer-field/id #uuid "7464d8a5-08db-527e-ae6f-a39637e25763" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316824} {:answer-field/choices [{:answer/id #uuid "25ed0276-2c2c-590f-8cf3-8e9560a9382e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186315332} {:answer/id #uuid "3c0beb9b-15d0-5e7d-be81-a2261768c844" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186315464} {:answer/id #uuid "83f4701d-d