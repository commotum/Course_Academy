e0c043d-5eae-5ed2-9603-09298bc4c93a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{n\\pi x}{3})" :db/id #edb/ref 17592186316281}] :answer-field/correct {:answer/id #uuid "ce0c043d-5eae-5ed2-9603-09298bc4c93a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{n\\pi x}{3})" :db/id #edb/ref 17592186316281} :answer-field/id #uuid "44be650e-57e3-5e7f-a1b5-535d0664b43b" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316702} {:answer-field/choices [{:answer/id #uuid "320a4b1e-355e-5064-94c6-57b1e59ff223" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{108(-1)^{n}}{{n}^{2}{\\pi }^{2}}" :db/id #edb/ref 17592186315409} {:answer/id #uuid "c8c7643d-6d9a-5e78-bd24-b6d113d550e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{36(-1)^{n}}{n\\pi }" :db/id #edb/ref 17592186316250} {:answer/id #uuid "cf74292f-2bae-52c3-8212-e06bff086ed0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{108(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}" :db/id #edb/ref 17592186316289} {:answer/id #uuid "dcb0dae4-982c-5cc7-a4a5-d9e12288703f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{36(-1)^{n+1}}{n\\pi }" :db/id #edb/ref 17592186316345}] :answer-field/correct {:answer/id #uuid "c8c7643d-6d9a-5e78-bd24-b6d113d550e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{36(-1)^{n}}{n\\pi }" :db/id #edb/ref 17592186316250} :answer-field/id #uuid "6098084d-9179-514b-8288-f653800985ea" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316774}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7127629f-cc39-5e9d-b607-fa5f8e083997" :question/math-academy-id "q-342963" :question/problem "Let $f(x)$ be the $6$-periodic extension of the function $F(x)=-3{x}^{2}+1$ defined on $[-3,3).$  Select the correct options in the reasoning below, showing the derivation of the Fourier series of the $6$-periodic extension of $G(x)=-6x$ from the corresponding Fourier series of $f(x).$The Fourier series of $f(x)$ is given by\n\n$$\n-3{x}^{2}+1∼-8+{\\sum }_{n=1}^{\\infty }\\frac{108(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}{{field-1}}.\n$$\n\nSince $f$ is \n{{field-2}}\nand\n{{field-3}}\non $R,$ we may differentiate its Fourier series term-by-term to get\n\n$$\n-6x∼{\\sum }_{n=1}^{\\infty }{{field-4}}\\cdot {{field-5}}.\n$$" :question/worked-solution "First, notice that $F(x)$ is an even function. So, the Fourier series of its $2L$-periodic extension has the form\n\n$$\n\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{L}).\n$$\n\nIn our case, $L=3$ and we are already given the coefficients ${a}_{0}$ and ${a}_{n}$ for $n\\ge 1.$ Thus, the Fourier series of $f(x)$ is given by\n\n$$\nf(x)∼-8+{\\sum }_{n=1}^{\\infty }\\frac{108(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}\\operatorname{cos}⁡(\\frac{n\\pi x}{3}).\n$$\n\nNow, notice that \n\n- the function $F$ is continuously differentiable on $(-3,3),$\n\n- continuous on $[-3,3),$ and\n\n- satisfies $F(-3)=F(3),$ if we extend the value at $x=3$ using the formula $F(x)=-3{x}^{2}+1.$\n\nTherefore, the $6$-periodic extension $f$ is $\\text{continuous}$ and $\\text{piecewise smooth}$ on $R,$ so we may differentiate its Fourier series term-by-term:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(-3{x}^{2}+1) & ∼\\frac{\\text{d}}{\\text{d}x}(-8)+{\\sum }_{n=1}^{\\infty }\\frac{\\text{d}}{\\text{d}x}(\\frac{108(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}\\operatorname{cos}⁡(\\frac{n\\pi x}{3})) \\\\ -6x & ∼0+{\\sum }_{n=1}^{\\infty }\\frac{108(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}\\cdot (-\\frac{n\\pi }{3}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})) \\\\ -6x & ∼{\\sum }_{n=1}^{\\infty }\\frac{-36(-1)^{n+1}}{n\\pi }\\operatorname{sin}⁡(\\frac{n\\pi x}{3}) \\\\ -6x & ∼{\\sum }_{n=1}^{\\infty }\\,\\frac{36(-1)^{n}}{n\\pi }\\cdot \\operatorname{sin}⁡(\\frac{n\\pi x}{3})\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317347 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "164f3127-7671-5404-8953-09e0fea76c35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2\\sqrt{{x}^{3}}}-5\\operatorname{cos}x" :db/id #edb/ref 17592186315247}] :answer-field/correct {:answer/id #uuid "164f3127-7671-5404-8953-09e0fea76c35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2\\sqrt{{x}^{3}}}-5\\operatorname{cos}x" :db/id #edb/ref 17592186315247} :answer-field/id #uuid "4ead05b7-6e52-5257-883b-117555657e43" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316729}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b404face-8b9a-5dc3-b331-958133c51335" :question/math-academy-id "q-342966" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=6\\sqrt{x}+5\\operatorname{cos}⁡x.$\n\n$\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=$ \n{{field-1}}" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(6\\sqrt{x}+5\\operatorname{cos}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(6{x}^{1/2}+5\\operatorname{cos}⁡x) \\\\  & =(\\frac{1}{2})\\cdot 6{x}^{-1/2}+5(-\\operatorname{sin}⁡x) \\\\  & =3{x}^{-1/2}-5\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{-1/2}-5\\operatorname{sin}⁡x) \\\\  & =(-\\frac{1}{2})\\cdot 3{x}^{-3/2}-5\\operatorname{cos}⁡x \\\\  & =-\\frac{3}{2\\sqrt{{x}^{3}}}-5\\operatorname{cos}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317350 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8fe7667-e950-5506-a92f-8a4180c90ce0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186316165}] :answer-field/correct {:answer/id #uuid "b8fe7667-e950-5506-a92f-8a4180c90ce0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186316165} :answer-field/id #uuid "8ef2349f-f4a8-5a93-9bcd-f881264f9bb4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316872}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "63f7bfdc-41d8-518f-af80-7426cf484c38" :question/math-academy-id "q-343050" :question/problem "Calculate ${f}^{′}(x)$ for $f(x)=\\operatorname{cos}⁡x+4\\operatorname{arccos}⁡x.$\n\n${f}^{′}(x)=-\\operatorname{sin}⁡x-\\,$\n{{field-1}}" :question/worked-solution "The formula for the derivative of arccosine is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}⁡x)=-\\frac{1}{\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the formula above, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡x+4\\operatorname{arccos}⁡x) \\\\  & =-\\operatorname{sin}⁡x+4\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}⁡x) \\\\  & =-\\operatorname{sin}⁡x+4(-\\frac{1}{\\sqrt{1-{x}^{2}}}) \\\\  & =-\\operatorname{sin}⁡x-\\frac{4}{\\sqrt{1-{x}^{2}}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317351 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06463bd0-01bc-506d-b971-571a5402c049" :answer/type {:db/id #edb/ref 1