^{2},\\,4\\le xy\\le 5\\}.$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\,dx\\,dy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))|\\frac{∂(x,y)}{∂(u,v)}|du\\,dv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=\\frac{y}{{x}^{2}},\\,v=xy\n$$\n\n \ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y\\end{aligned}]\\to [\\begin{aligned}u(x,y) \\\\ v(x,y)\\end{aligned}].\n$$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,1\\le u\\le 4,\\,4\\le v\\le 5\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{aligned}| \\\\  & =|\\begin{aligned}-\\frac{2y}{{x}^{3}} & \\frac{1}{{x}^{2}} \\\\ y & \\text{ }\\text{ }x\\end{aligned}| \\\\  & =-\\frac{3y}{{x}^{2}}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}=\\frac{1}{(-\\frac{3y}{{x}^{2}})}=-\\frac{1}{3u}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}(xy)^{2}\\,dx\\,dy & ={∬}_{Δ}{v}^{2}|\\frac{∂(x,y)}{∂(u,v)}|\\text{d}u\\,\\text{d}v \\\\  & ={∬}_{Δ}{v}^{2}\\cdot |\\frac{1}{3u}|\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{4}^{5}{\\int }_{1}^{4}\\frac{{v}^{2}}{u}\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{4}^{5}{v}^{2}[{\\int }_{1}^{4}\\frac{1}{u}\\,\\text{d}u]\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{4}^{5}{v}^{2}[\\operatorname{ln}⁡|u|\\,{|}_{1}^{4}]dv \\\\  & =\\frac{1}{3}{\\int }_{4}^{5}{v}^{2}(\\operatorname{ln}⁡4-\\operatorname{ln}⁡1)\\,dv \\\\  & =\\frac{2\\operatorname{ln}⁡2}{3}{\\int }_{4}^{5}{v}^{2}\\,dv \\\\  & =\\frac{2\\operatorname{ln}⁡2}{3}\\cdot \\frac{1}{3}{v}^{3}\\,{|}_{4}^{5} \\\\  & =\\frac{2\\operatorname{ln}⁡2}{9}\\cdot (125-64) \\\\  & =\\frac{122\\operatorname{ln}⁡2}{9}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186539371 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49693d90-a88f-5cc1-8d9c-4cdbfd34c316" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "203 \\ln{\\left(2 \\right)}" :db/id #edb/ref 17592186539364} {:answer/id #uuid "5ce3c7dc-caf4-59c6-bc90-66911b31b855" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 52 \\ln{\\left(2 \\right)}" :db/id #edb/ref 17592186539370} {:answer/id #uuid "66c4bff9-f18e-5a0a-ae8c-565ea3df5f96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 \\ln{\\left(2 \\right)}" :db/id #edb/ref 17592186539372} {:answer/id #uuid "8b1f244f-0b28-5817-86a7-3ca216955106" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "52 \\ln{\\left(2 \\right)}" :db/id #edb/ref 17592186539378} {:answer/id #uuid "f6dbc465-6dd3-5c31-801d-8e21abfc3c96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "156 \\ln{\\left(2 \\right)}" :db/id #edb/ref 17592186539390}] :answer-field/correct {:answer/id #uuid "8b1f244f-0b28-5817-86a7-3ca216955106" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "52 \\ln{\\left(2 \\right)}" :db/id #edb/ref 17592186539378} :answer-field/id #uuid "189e4d5c-7d67-5000-8ba2-67a9c86a5254" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539360}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5fc233a3-016d-5c4e-a242-9f02a02751f2" :question/problem "Using the change of variables $u=\\frac{y}{{x}^{2}}$ and $v=xy,$ evaluate the double integral\n\n$$\n{∬}_{D}(xy)^{2}\\,dx\\,dy,\n$$\n\nwhere $D=\\{(x,y)\\,:\\,{x}^{2}\\le y\\le 16{x}^{2},\\,2\\le xy\\le 5\\}.$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\,dx\\,dy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))|\\frac{∂(x,y)}{∂(u,v)}|du\\,dv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=\\frac{y}{{x}^{2}},\\,v=xy\n$$\n\n \ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y\\end{aligned}]\\to [\\begin{aligned}u(x,y) \\\\ v(x,y)\\end{aligned}].\n$$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,1\\le u\\le 16,\\,2\\le v\\le 5\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{aligned}| \\\\  & =|\\begin{aligned}-\\frac{2y}{{x}^{3}} & \\frac{1}{{x}^{2}} \\\\ y & \\text{ }\\text{ }x\\end{aligned}| \\\\  & =-\\frac{3y}{{x}^{2}}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}=\\frac{1}{(-\\frac{3y}{{x}^{2}})}=-\\frac{1}{3u}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}(xy)^{2}\\,dx\\,dy & ={∬}_{Δ}{v}^{2}|\\frac{∂(x,y)}{∂(u,v)}|\\text{d}u\\,\\text{d}v \\\\  & ={∬}_{Δ}{v}^{2}\\cdot |\\frac{1}{3u}|\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{2}^{5}{\\int }_{1}^{16}\\frac{{v}^{2}}{u}\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{2}^{5}{v}^{2}[{\\int }_{1}^{16}\\frac{1}{u}\\,\\text{d}u]\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{2}^{5}{v}^{2}[\\operatorname{ln}⁡|u|\\,{|}_{1}^{16}]dv \\\\  & =\\frac{1}{3}{\\int }_{2}^{5}{v}^{2}(\\operatorname{ln}⁡16-\\operatorname{ln}⁡1)\\,dv \\\\  & =\\frac{2\\operatorname{ln}⁡4}{3}{\\int }_{2}^{5}{v}^{2}\\,dv \\\\  & =\\frac{2\\operatorname{ln}⁡4}{3}\\cdot \\frac{1}{3}{v}^{3}\\,{|}_{2}^{5} \\\\  & =\\frac{2\\operatorname{ln}⁡4}{9}\\cdot (125-8) \\\\  & =26\\operatorname{ln}⁡4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186539379 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "088d3881-6f26-5c1e-8b70-605ffcbe6a13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4 \\ln{\\left(3 \\right)}}{3}" :db/id #edb/ref 17592186539357} {:answer/id #uuid "13d60485-67ff-563a-a2f9-a27075387c5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/