}⁡(\\frac{2\\pi }{3})-2\\operatorname{cos}⁡(2\\cdot \\frac{2\\pi }{3})}{2\\operatorname{sin}⁡(2\\cdot \\frac{2\\pi }{3})-\\operatorname{sin}⁡(\\frac{2\\pi }{3})} \\\\  & =\\frac{\\operatorname{cos}⁡(\\frac{2\\pi }{3})-2\\operatorname{cos}⁡(\\frac{4\\pi }{3})}{2\\operatorname{sin}⁡(\\frac{4\\pi }{3})-\\operatorname{sin}⁡(\\frac{2\\pi }{3})} \\\\  & =\\frac{-\\frac{1}{2}-2\\cdot (-\\frac{1}{2})}{2\\cdot (-\\frac{\\sqrt{3}}{2})-\\frac{\\sqrt{3}}{2}} \\\\  & =\\frac{(\\frac{1}{2})}{(-\\frac{3\\sqrt{3}}{2})} \\\\  & =-\\frac{1}{3\\sqrt{3}}.\\end{aligned}\n$$\n\n**Step 3**: Find the Cartesian coordinates of $P:$\n\nWe compute the $xy$-coordinates of $P$ as follows:\n\n$$\n\\begin{aligned}{x}_{1} & =r\\operatorname{cos}⁡\\theta  \\\\  & =(1-2\\operatorname{cos}⁡\\theta )\\operatorname{cos}⁡\\theta  \\\\  & =(1-2\\operatorname{cos}⁡(\\frac{2\\pi }{3}))\\operatorname{cos}⁡(\\frac{2\\pi }{3}) \\\\  & =(1-2(-\\frac{1}{2}))(-\\frac{1}{2}) \\\\  & =-1 \\\\ {y}_{1} & =r\\operatorname{sin}⁡\\theta  \\\\  & =(1-2\\operatorname{cos}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =(1-2\\operatorname{cos}⁡(\\frac{2\\pi }{3}))\\operatorname{sin}⁡(\\frac{2\\pi }{3}) \\\\  & =(1-2(-\\frac{1}{2}))\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(-1,\\sqrt{3}).$\n\n**Step 4**: Using point-slope form, find the equation of the normal:\n\nWe find the equation of the normal as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =-\\frac{1}{m}(x-{x}_{1}) \\\\ y-\\sqrt{3} & =3\\sqrt{3}\\cdot (x-(-1)) \\\\ y-\\sqrt{3} & =3\\sqrt{3}x+3\\sqrt{3} \\\\ y & =3\\sqrt{3}x+4\\sqrt{3}\\end{aligned}\n$$\n\n![](images/ba/ba0b04158944bd15aeea3220d4aa63321dd39c423a4f6646ba59c299fa8ef736.png)" 13194139538230 17592186576411 false] [17592186542205 1074 "To find the equation of the normal line to a polar curve at a point $P,$ we follow four steps:\n\n**Step 1**: Calculate the derivative $\\frac{\\text{d}y}{\\text{d}x}:$\n\nIn this case, we're given that\n\n$$\n{y}^