xt{d}y}{\\text{d}x}|}_{\\theta =\\pi /6} \\\\  & =\\operatorname{tan}⁡(2\\cdot \\frac{\\pi }{6}) \\\\  & =\\operatorname{tan}⁡(\\frac{\\pi }{3}) \\\\  & =\\sqrt{3}.\\end{aligned}\n$$\n\n**Step 3**: Find the Cartesian coordinates of $P:$\n\nWe compute the $xy$-coordinates of $P$ as follows:\n\n$$\n\\begin{aligned}{x}_{1} & =r\\operatorname{cos}⁡\\theta  \\\\  & =4\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta  \\\\  & =4\\operatorname{sin}⁡(\\frac{\\pi }{6})\\operatorname{cos}⁡(\\frac{\\pi }{6}) \\\\  & =4\\cdot \\frac{1}{2}\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\sqrt{3} \\\\ {y}_{1} & =r\\operatorname{sin}⁡\\theta  \\\\  & =4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡\\theta  \\\\  & =4\\operatorname{sin}⁡(\\frac{\\pi }{6})\\operatorname{sin}⁡(\\frac{\\pi }{6}) \\\\  & =4\\cdot \\frac{1}{2}\\cdot \\frac{1}{2} \\\\  & =1\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(\\sqrt{3},1).$\n\n**Step 4**: Using point-slope form, find the equation of the normal:\n\nWe find the equation of the normal as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =-\\frac{1}{m}(x-{x}_{1}) \\\\ y-1 & =-\\frac{1}{\\sqrt{3}}(x-\\sqrt{3}) \\\\ y-1 & =-\\frac{1}{\\sqrt{3}}x+1 \\\\ y & =-\\frac{1}{\\sqrt{3}}\\,x+2\\end{aligned}\n$$\n\n![](images/b2/b2485a1b1386468904947c52ff3f52997f72597da84384ae41d246f386a39232.png)" 13194139538230 17592186576411 false] [17592186542144 1074 "To find the equation of the normal line to a polar curve at a point $P,$ we follow four steps:\n\n**Step 1**: Calculate the derivative $\\frac{\\text{d}y}{\\text{d}x}:$\n\nIn this case, we're given that\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\operatorname{tan}⁡(2\\theta ).\n$$\n\n**Step 2**: Find the slope of the tangent at $P:$\n\nThe slope of the tangent line is\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{\\theta =\\pi /6} \\\\  & =\\operatorname{tan}⁡(2\\cdot \\frac{\\pi }{6}) \\\\  & =\\operatorname{tan}⁡\\left(\\frac{\\pi }{3}\\right) \\\\  & =\\sqrt{3}.\\end{aligned}\n$$\n\n**Step 3**: Find the Cartesian coordinates of $P:$\n\nWe compute the $xy$-coordinates of $P$ as follows:\n\n$$\n\\begin{aligned}{x}_{1} & =r\\operatorname{cos}⁡\\theta  \\\\  & =4\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta  \\\\  & =4\\operatorname{sin}⁡\\left(\\frac{\\pi }{6}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{6}\\right) \\\\  & =4\\cdot \\frac{1}{2}\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\sqrt{3} \\\\ {y}_{1} & =r\\operatorname{sin}⁡\\theta  \\\\  & =4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡\\theta  \\\\  & =4\\operatorname{sin}⁡\\left(\\frac{\\pi }{6}\\right)\\operatorname{sin}⁡\\left(\\frac{\\pi }{6}\\right) \\\\  & =4\\cdot \\frac{1}{2}\\cdot \\frac{1}{2} \\\\  & =1\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(\\sqrt{3},1).$\n\n**Step 4**: Using point-slope form, find the equation of the normal:\n\nWe find the equation of the normal as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =-\\frac{1}{m}(x-{x}_{1}) \\\\ y-1 & =-\\frac{1}{\\sqrt{3}}(x-\\sqrt{3}) \\\\ y-1 & =-\\frac{1}{\\sqrt{3}}x+1 \\\\ y & =-\\frac{1}{\\sqrt{3}}\\,x+2\\end{aligned}\n$$\n\n![](images/b2/b2485a1b1386468904947c52ff3f52997f72597da84384ae41d246f386a39232.png)" 13194139538230 17592186576411 true] [17592186542151 1074 "First, let's swap the left and right-hand sides so that the variable is on the left-hand side.\n\n$$\n-\\frac{m}{3}=\\frac{1}{15}\n$$\n\nThen, we remove the negative sign from the variable. To do this, we multiply both sides of the equation by $-1.$\n\n$$\n\\begin{aligned}-\\frac{m}{3} & =\\frac{1}{15} \\\\ (-1)\\cdot (-\\frac{m}{3}) & =(-1)\\cdot \\frac{1}{15} \\\\ \\frac{m}{3} & =-\\frac{1}{15}\\end{aligned}\n$$\n\nIn the equation above, $m$ is being divided by $3.$ To isolate $m$, we can perform the opposite operation, which is *multiplying* by $3.$ So, we multiply both sides of the equation by $3$ and simplify.\n\n$$\n\\begin{aligned}\\frac{m}{3} & =-\\frac{1}{15} \\\\ 3\\cdot \\frac{m}{3} & =3\\cdot (-\\frac{1}{15}) \\\\ \\frac{3m}{