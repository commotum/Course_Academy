6)^{2}-(0)^{2}\\right) \\\\ &=2 \\sqrt{26}\\left(36-0\\right) \\\\ &=72 \\sqrt{26}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186542613 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d630ca6-fd28-58ed-995a-8da968fd5ba9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8 \\sqrt{10}" :db/id #edb/ref 17592186542560} {:answer/id #uuid "4c0613bc-32a4-53a2-a943-9e50b992e369" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16 \\sqrt{10}" :db/id #edb/ref 17592186542567} {:answer/id #uuid "5fa57f44-2642-593c-a3e7-ef6c93fe59eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 16 \\sqrt{10}" :db/id #edb/ref 17592186542570} {:answer/id #uuid "867db4e2-70dd-5f07-8dc4-522fdb1b0abe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186542578} {:answer/id #uuid "b4af4815-a8ff-5192-b441-27ae750e4043" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "160" :db/id #edb/ref 17592186542587}] :answer-field/correct {:answer/id #uuid "4c0613bc-32a4-53a2-a943-9e50b992e369" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16 \\sqrt{10}" :db/id #edb/ref 17592186542567} :answer-field/id #uuid "7d7d77a5-ca55-5835-beb8-b8509e3fef56" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542601}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fa2eae58-23f0-53d8-954b-616c559e82a9" :question/problem "Evaluate the integral of the function $f(x,y)=2 x$ along the line $y=3 x,$ $\\,0\\le x\\le 4.$" :question/worked-solution "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y=y(t)=3 t.$ This gives the following parametrization of the curve:\n\n$$\n\\mathbf r(t)=\\langle t,3 t\\rangle,\\qquad 0\\le t\\le 4\n$$\n\nComputing $\\mathbf r^{\\prime}(t)$ and $\\|\\mathbf r^{\\prime}(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}\\mathbf r^{\\prime}(t)&=\\frac{\\mathrm dx}{\\mathrm dt}\\mathbf i+\\frac{\\mathrm dy}{\\mathrm dt}\\mathbf j \\\\ &=\\frac{\\mathrm d}{\\mathrm dt}(t)\\mathbf i+\\frac{\\mathrm d}{\\mathrm dt}(3 t)\\mathbf j \\\\ &=\\mathbf i+(3)\\mathbf j \\\\ \\|\\mathbf r^{\\prime}(t)\\|&=\\sqrt{\\left(\\frac{\\mathrm dx}{\\mathrm dt}\\right)^2+\\left(\\frac{\\mathrm dy}{\\mathrm dt}\\right)^2} \\\\ &=\\sqrt{1^2+(3)^2} \\\\ &=\\sqrt{10}\\end{aligned}\n$$\n\nNow, since $f(x,y)=2 x$, we obtain\n\n$$\n\\begin{aligned}f(r(t))&=2 t\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f(x,y)\\,\\mathrm ds&=\\int_{0}^{4}f(r(t))\\|\\mathbf r^{\\prime}(t)\\|\\,\\mathrm dt \\\\ &=\\int_{0}^{4}(2 t)(\\sqrt{10})\\,\\mathrm dt \\\\ &=\\left[\\sqrt{10} t^{2}\\right]_{0}^{4} \\\\ &=\\sqrt{10}\\left((4)^{2}-(0)^{2}\\right) \\\\ &=\\sqrt{10}\\left(16-0\\right) \\\\ &=16 \\sqrt{10}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543469 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5351d84c-4882-5054-a0c1-cbc0e962e2cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186542864}] :answer-field/correct {:answer/id #uuid "5351d84c-4882-5054-a0c1-cbc0e962e2cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186542864} :answer-field/id #uuid "6bbb16c8-6341-55ff-b300-2282e814f399" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186543358}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0054ec1e-580f-564e-8493-248291e1368b" :question/math-academy-id "q-281742" :question/problem "If the polar curve $r=k\\operatorname{cos}⁡\\theta ,$ where $k$ is a constant, passes through the point $A$ with Cartesian coordinates $(-3,\\sqrt{3}),$  then $k=${{field-1}}." :question/worked-solution "First, we find the polar coordinates of the point $A.$ The distance from $A$ to the origin is\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{(-3)}^{2}+{(\\sqrt{3})}^{2}} \\\\  & =2\\sqrt{3}.\\end{aligned}\n$$\n\nNow, since $A$ lies in the second quadrant, we get\n\n$$\n\\begin{aligned}\\theta  & =\\pi -\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\pi -\\operatorname{arctan}⁡|\\frac{\\sqrt{3}}{-3}| \\\\  & =\\pi -\\frac{\\pi }{6} \\\\  & =\\frac{5\\pi }{6}.\\end{aligned}\n$$\n\nSo, the polar coordinates of $A$ are $(r,\\theta )=(2\\sqrt{3},\\frac{5\\pi }{6}).$ \n\nTo find the value of $k$, we substitute the polar coordinates of the point $A$ into the polar equation of the curve:\n\n$$\n\\begin{aligned}2\\sqrt{3} & =k\\operatorname{cos}⁡\\theta  \\\\ 2\\sqrt{3} & =k\\operatorname{cos}⁡\\left(\\frac{5\\pi }{6}\\right) \\\\ 2\\sqrt{3} & =k\\left(-\\frac{\\sqrt{3}}{2}\\right) \\\\ k & =-4\\end{aligned}\n$$\n\nTherefore, the equation of the curve is $r=-4\\operatorname{cos}⁡\\theta ,$ as shown below.\n\n![](images/de/def95f29f6397b0f6eab20afb6327d8f3f99fdc52fbeac0b0c2af8b228d060a9.png)"} {:db/id #edb/ref 17592186543479 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18804b67-878e-56f2-a908-9dd72d5c6203" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{2}⁡\\left(\\frac{7}{5}\\right)" :db/id #edb/ref 17592186542701} {:answer/id #uuid "74910754-3a09-5360-8578-a6e630ecceac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{2}⁡(2)" :db/id #edb/ref 17592186542945} {:answer/id #uuid "846f084c-4d8e-5b3c-94e0-bd4bc2d3d3de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{log}⁡(35)" :db/id #edb/ref 17592186542995} {:answer/id #uuid "9eff8071-7a7a-58ad-9478-1815b1968cb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{log}⁡(2)" :db/id #edb/ref 17592186543063} {:answer/id #uuid "b99e14c7-a03d-57b7-b791-a59cc36431e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{2}⁡(35)" :db/id #edb/ref 17592186543125}] :answer-field/correct {:answer/id #uuid "18804b67-878e-56f2-a908-9dd72d5c6203" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{2}⁡\\left(\\frac{7}{5}\\right)" :db/id #edb/ref 17592186542701} :answer-field/id #uuid "92823537-f145-578d-8121-413772b2c835" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543389}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "15c5c76c-d78d-5592-bdec-a5d9824a4594" :question/math-academy-id "q-66765" :question/problem "Express ${log}_{2}⁡(7)-{log}_{2}⁡(5)$ as a single logarithm." :question/worked-solution "First, let's recall the quotient rule for logarithms:\n\n$$\n{log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)\n$$\n\nUsing the quotient rule for logarithms, the given expression can be rewritten as:\n\n$$\n{log}_{2}⁡(7)-{log}_{2}⁡(5)={log}_{2}⁡\\left(\\frac{7}{5}\\right)\n$$"} {:db/id #edb/ref 17592186543483 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fdf82a0-2583-54a3-bd7d-1ee3403c2774" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{3}⁡(y)-{log}_{3}⁡(x)" :db/id #edb/ref 17592186542727} {:answer/id #uuid "31ee8031-ab23-5347-a954-5922df481593" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{3}⁡(x)\\cdot {log}_{3}⁡(y)" :db/id #edb/ref 17592186542772} {:answer/id #uuid "7f80c10e-5297-5c3f-976a-b2a1b6bb66bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{log}_{3}⁡(x)}{{log}_{3}⁡(y)}" :db/id #edb/ref 17592186542983} {:answer/id #uuid "b25d0d08-c661-51ef-9ff7-c14e5da09762" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{3}⁡(x)+{log}_{3}⁡(y)" :db/id #edb/ref 17592186543104} {:answer/id #uuid "ecc6e0b1-d90c-5f5b-9ef7-e7b55fb39ddf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{3}⁡(x)-{log}_{3}⁡(y)" :db/id #edb/ref 17592186543239}] :answer-field/correct {:answer/id #uuid "ecc6e0b1-d90c-5f5b-9ef7-e7b55fb39ddf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{3}⁡(x)-{log}_{3}⁡(y)" :db/id #edb/ref 17592186543239} :answer-field/id #uuid "058dd5c5-0df5-5561-a280-d0460c220852" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543294}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "20936b5f-864e-5ae6-90f1-dfba78a6f020" :question/math-academy-id "q-47257" :question/problem "${log}_{3}⁡\\left(\\frac{x}{y}\\right)=$" :question/worked-solution "First, let's recall the quotient rule for logarithms:\n\n$$\n{log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)\n$$\n\nUsing the quotient rule for logarithms, we obtain:\n\n$$\n\\begin{aligned}{log}_{3}⁡\\left(\\frac{x}{y}\\right) & ={log}_{3}⁡(x)-{log}_{3}⁡(y)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543487 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "190687e3-a7f2-5a29-8dc7-a0bea5da56e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{log}⁡(3y)-2\\operatorname{log}⁡(x)" :db/id #edb/ref 17592186542705} {:answer/id #uuid "7581ab19-811f-5e47-b443-b607c614c0b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{log}⁡(3y)-\\frac{1}{2}\\operatorname{log}⁡(x)" :db/id #edb/ref 17592186542948} {:answer/id #uuid "78a1a98e-88c2-5374-88b4-1257de2627c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{log}⁡(3y)+\\frac{1}{2}\\operatorname{log}⁡(x)" :db/id #edb/ref 17592186542960} {:answer/id #uuid "ad34430e-a9d9-513c-8d4f-f1869c33c3a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{log}⁡(3y)+2\\operatorname{log}⁡(x)" :db/id #edb/ref 17592186543095} {:answer/id #uuid "e87adda8-665d-5091-a708-f9408a979f13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{log}⁡(y)-\\frac{1}{2}\\operatorname{log}⁡(x)" :db/id #edb/ref 17592186543232}] :answer-field/correct {:answer/id #uuid "7581ab19-811f-5e47-b443-b607c614c0b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{log}⁡(3y)-\\frac{1}{2}\\operatorname{log}⁡(x)" :db/id #edb/ref 17592186542948} :answer-field/id #uuid "f6b9d0a5-0953-5666-a839-4b5670a6fac3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543465}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2c8cf324-472b-5836-8692-8d44663200a5" :question/math-academy-id "q-1101" :question/problem "$\\operatorname{log}⁡\\left(\\frac{3y}{\\sqrt{x}}\\right)=$" :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the quotient rule and then the power rule for logarithms, we obtain\n\n$$\n\\begin{aligned}\\operatorname{log}⁡\\left(\\frac{3y}{\\sqrt{x}}\\right) & =\\operatorname{log}⁡(3y)-\\operatorname{log}⁡(\\sqrt{x}) \\\\  & =\\operatorname{log}⁡(3y)-\\operatorname{log}⁡({x}^{1/2}) \\\\  & =\\operatorname{log}⁡(3y)-\\frac{1}{2}\\operatorname{log}⁡(x).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543489 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bf6bafc-4476-5a9e-af7f-e7e2638c73cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186542756}] :answer-field/correct {:answer/id #uuid "2bf6bafc-4476-5a9e-af7f-e7e2638c73cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186542756} :answer-field/id #uuid "9cf19871-6dd2-593d-bf3f-f7ad27ac4fd0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186543398}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2e8e220e-5d02-535f-8203-20819203c421" :question/math-academy-id "q-281737" :question/problem "If the polar curve $r=k\\operatorname{cos}⁡\\theta ,$ where $k$ is a constant, passes through the point $A$ with Cartesian coordinates $(-3,-3),$  then $k=${{field-1}}." :question/worked-solution "First, we find the polar coordinates of the point $A.$ The distance from $A$ to the origin is\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{(3)}^{2}+{(3)}^{2}} \\\\  & =3\\sqrt{2}.\\end{aligned}\n$$\n\nNow, since $A$ lies in the third quadrant, we get\n\n$$\n\\begin{aligned}\\theta  & =\\pi +\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\pi +\\operatorname{arctan}⁡|\\frac{-3}{-3}| \\\\  & =\\pi +\\frac{\\pi }{4} \\\\  & =\\frac{5\\pi }{4}.\\end{aligned}\n$$\n\nSo, the polar coordinates of $A$ are $(r,\\theta )=(3\\sqrt{2},\\frac{5\\pi }{4}).$ \n\nTo find the value of $k$, we substitute the polar coordinates of the point $A$ into the polar equation of the curve:\n\n$$\n\\begin{aligned}r & =k\\operatorname{cos}⁡\\theta  \\\\ 3\\sqrt{2} & =k\\operatorname{cos}⁡\\left(\\frac{5\\pi }{4}\\right) \\\\ 3\\sqrt{2} & =k\\left(-\\frac{1}{\\sqrt{2}}\\right) \\\\ k & =-6\\end{aligned}\n$$\n\nTherefore, the equation of the curve is $r=-6\\operatorname{cos}⁡\\theta ,$ as shown below.\n\n![](images/72/72cb94d6ed11f7502e7810d7d201ba71e594ed97a7a3eadd789732ca3dcb8968.png)"} {:db/id #edb/ref 17592186543490 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c14bd25-60b1-5db9-a5b5-db353df1d229" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4" :db/id #edb/ref 17592186542757} {:answer/id #uuid "6a19ff45-4f16-58c5-a481-27c3e6c6c4b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2" :db/id #edb/ref 17592186542925} {:answer/id #uuid "780d7c64-0c00-5d57-b7ce-66b2f26ef78a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-1" :db/id #edb/ref 17592186542957} {:answer/id #uuid "9d1f2a50-d198-5902-817a-d0db539435f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{4}" :db/id #edb/ref 17592186543053} {:answer/id #uuid "9ed9741b-2e78-58ae-b8cc-62e01e46a889" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1" :db/id #edb/ref 17592186543060}] :answer-field/correct {:answer/id #uuid "780d7c64-0c00-5d57-b7ce-66b2f26ef78a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-1" :db/id #edb/ref 17592186542957} :answer-field/id #uuid "cd01a93c-d6e2-540b-8c0d-44c14937bd8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543444}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3044149e-5bfc-5de0-b490-60c442d8ed07" :question/math-academy-id "q-45533" :question/problem "What is the solution to  $2\\cdot {8}^{y}=\\frac{1}{4}?$" :question/worked-solution "First, we isolate the term with the variable exponent by dividing both sides by $2$:\n\n$$\n\\begin{aligned}2\\cdot {8}^{y} & =\\frac{1}{4} \\\\ \\frac{2\\cdot {8}^{y}}{2} & =\\frac{\\left(\\frac{1}{4}\\right)}{2} \\\\ {8}^{y} & =\\frac{1}{8}\\end{aligned}\n$$\n\nNow, we rewrite $\\frac{1}{8}$ as ${8}^{-1}$ to get:\n\n$$\n\\begin{aligned}{8}^{y} & =\\frac{1}{8} \\\\ {8}^{y} & ={8}^{-1}\\end{aligned}\n$$\n\nFinally, since both sides of the equation share the same base $(8)$, we equate the exponents:\n\n$$\n\\begin{aligned}{8}^{y} & ={8}^{-1} \\\\ y & =-1\\end{aligned}\n$$\n\nTherefore, the solution is $y=-1.$"} {:db/id #edb/ref 17592186543491 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cece677-9803-52b0-b907-23768dbe2ac7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{log}_{2}⁡(x)+\\frac{1}{2}{log}_{2}⁡(y)+{log}_{2}⁡(z)" :db/id #edb/ref 17592186542667} {:answer/id #uuid "6929a7d0-50d3-5bd8-b005-5eaf6c8afc89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{log}_{2}⁡(x)+2{log}_{2}⁡(y)-{log}_{2}⁡(z)" :db/id #edb/ref 17592186542922} {:answer/id #uuid "6a89e1fb-1817-5ee7-bb66-dae6fa7f2260" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{log}_{2}⁡(x)-\\frac{1}{2}{log}_{2}⁡(y)-{log}_{2}⁡(z)" :db/id #edb/ref 17592186542928} {:answer/id #uuid "ec14ff8e-fb9a-5ae2-9974-b0a7e6bb510d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{log}_{2}⁡(x)-2{log}_{2}⁡(y)-{log}_{2}⁡(z)" :db/id #edb/ref 17592186543236} {:answer/id #uuid "fb088d0f-9bbb-51fc-8107-4545e4127621" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{log}_{2}⁡(x)-2{log}_{2}⁡(y)+{log}_{2}⁡(z)" :db/id #edb/ref 17592186543281}] :answer-field/correct {:answer/id #uuid "6929a7d0-50d3-5bd8-b005-5eaf6c8afc89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{log}_{2}⁡(x)+2{log}_{2}⁡(y)-{log}_{2}⁡(z)" :db/id #edb/ref 17592186542922} :answer-field/id #uuid "b2475f77-a3bc-521f-922f-608b63eb6022" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543423}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "34847574-efca-5670-8924-e70a3bcc31ce" :question/math-academy-id "q-66923" :question/problem "${log}_{2}⁡\\left(\\frac{\\sqrt{x}{y}^{2}}{z}\\right)=$" :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the quotient rule for logarithms, we get\n\n$$\n{log}_{2}⁡\\left(\\frac{\\sqrt{x}{y}^{2}}{z}\\right)={log}_{2}⁡(\\sqrt{x}{y}^{2})-{log}_{2}⁡(z).\n$$\n\nNow, using the product rule for logarithms, we obtain\n\n$$\n{log}_{2}⁡(\\sqrt{x}{y}^{2})-{log}_{2}⁡(z)={log}_{2}⁡(\\sqrt{x})+{log}_{2}⁡({y}^{2})-{log}_{2}⁡(z).\n$$\n\nFinally, using the power rule for logarithms, we have\n\n$$\n\\begin{aligned}{log}_{2}⁡(\\sqrt{x})+{log}_{2}⁡({y}^{2})-{log}_{2}⁡(z) & ={log}_{2}⁡({x}^{1/2})+{log}_{2}⁡({y}^{2})-{log}_{2}⁡(z) \\\\  & =\\frac{1}{2}{log}_{2}⁡(x)+2{log}_{2}⁡(y)-{log}_{2}⁡(z).\\end{aligned}\n$$\n\nTherefore\n\n$$\n{log}_{2}⁡\\left(\\frac{\\sqrt{x}{y}^{2}}{z}\\right)=\\frac{1}{2}{log}_{2}⁡(x)+2{log}_{2}⁡(y)-{log}_{2}⁡(z).\n$$"} {:db/id #edb/ref 17592186543496 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dbd9de5-ffb6-5a92-af24-1a190f516d4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "52.5" :db/id #edb/ref 17592186542760} {:answer/id #uuid "42f17b6e-adee-5418-8a80-24659c92c3a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-57.3" :db/id #edb/ref 17592186542820} {:answer/id #uuid "48337ab4-cd65-553e-b93c-57c20fa8194e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-55.1" :db/id #edb/ref 17592186542836} {:answer/id #uuid "a31bea97-b4ca-5c19-a543-03494bd16286" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "53.8" :db/id #edb/ref 17592186543071} {:answer/id #uuid "ebf9a326-b0aa-5098-aa51-d8aa62a227d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-51.4" :db/id #edb/ref 17592186543235}] :answer-field/correct {:answer/id #uuid "48337ab4-cd65-553e-b93c-57c20fa8194e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-55.1" :db/id #edb/ref 17592186542836} :answer-field/id #uuid "689ba3cb-114a-56ff-8abb-81f20075f5f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543355}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "47a49d65-e85d-5b9b-a8c6-e21bc37526ef" :question/math-academy-id "q-159947" :question/problem "Suppose ${X}_{1},{X}_{2},…,{X}_{10}$ is an I.I.D random sample with ${X}_{i}∼N(\\theta ,{1}^{2}),$ where $\\theta $ is an unknown mean. For a particular sample ${x}_{1},{x}_{2},…,{x}_{10},$ you're given that \n\n$$\n{\\sum }_{i=1}^{10}{x}_{i}=41.2,\\,{\\sum }_{i=1}^{10}{x}_{i}^{2}=182.6.\n$$\n\n \nGiven that the log-likelihood function of the sample is\n\n$$\nl(\\theta )=-5\\operatorname{ln}⁡(2\\pi )+a+b\\theta +c{\\theta }^{2},\n$$\n\nwhat is the value of $a+b+c?$\n\n*Hint: The probability density function for a normal random variable with mean $\\theta $ and standard deviation $1$ is given by* \n\n$$\nf(x)=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i};\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i};\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=10$ independent normal random variables with unknown mean $\\theta $ and variance ${\\sigma }^{2}=1,$ for which the probability density function is\n\n$$\nf(x,\\theta )=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$\n\nNext, we write down the log-density function:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡f(x,\\theta ) & =\\operatorname{ln}⁡(\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2}) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{1}{\\sqrt{2\\pi }}\\right)+\\operatorname{ln}⁡({e}^{-(x-\\theta )^{2}/2}) \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{(x-\\theta )^{2}}{2}.\\end{aligned}\n$$\n\nNow, we can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}(-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{({x}_{i}-\\theta )^{2}}{2}) \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-{\\sum }_{i=1}^{n}\\frac{({x}_{i}-\\theta )^{2}}{2} \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}({\\sum }_{i=1}^{n}{x}_{i}^{2}-2\\theta {\\sum }_{i=1}^{n}{x}_{i}+n{\\theta }^{2})\\end{aligned}\n$$\n\nWe are told that ${\\sum }_{i=1}^{10}{x}_{i}=41.2,$ ${\\sum }_{i=1}^{10}{x}_{i}^{2}=182.6,$ and $n=10.$ Therefore, \n\n$$\n\\begin{aligned}l(\\theta ) & =-\\frac{10}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}(182.6-2\\theta \\cdot 41.2+10{\\theta }^{2}) \\\\  & =-5\\operatorname{ln}⁡(2\\pi )+(-91.3)+41.2\\theta +(-5){\\theta }^{2}.\\end{aligned}\n$$\n\nFinally, \n\n$$\na+b+c=(-91.3)+41.2+(-5)=-55.1.\n$$"} {:db/id #edb/ref 17592186543498 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08538244-0a29-5cc7-b86c-0a8d7eb92a45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡\\left(\\frac{{x}^{2}}{y}\\right)" :db/id #edb/ref 17592186542656} {:answer/id #uuid "5d51face-45fc-5f92-aa4c-e940cfa9f9a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡\\left(\\frac{x}{y}\\right)" :db/id #edb/ref 17592186542890} {:answer/id #uuid "69b0b1b4-2068-59f6-8caa-0232583e7632" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡\\left(\\frac{{x}^{4}}{{y}^{2}}\\right)" :db/id #edb/ref 17592186542924} {:answer/id #uuid "bd225b51-2569-5aab-a898-96374e23410e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡\\left(\\frac{{y}^{4}}{{x}^{2}}\\right)" :db/id #edb/ref 17592186543135} {:answer/id #uuid "e5bfefa4-4a1a-5bbe-945c-432a0e867b73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡\\left(\\frac{{y}^{2}}{x}\\right)" :db/id #edb/ref 17592186543224}] :answer-field/correct {:answer/id #uuid "69b0b1b4-2068-59f6-8caa-0232583e7632" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡\\left(\\frac{{x}^{4}}{{y}^{2}}\\right)" :db/id #edb/ref 17592186542924} :answer-field/id #uuid "4f6009af-c9fb-5d51-99cd-1ba483beaabc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543339}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "49c1090f-0d14-5ccb-9c30-a8b9c4fffd87" :question/math-academy-id "q-79403" :question/problem "Express $4\\operatorname{ln}⁡(x)-2\\operatorname{ln}⁡(y)$ as a single logarithm." :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the power rule and then the quotient rule for logarithms, we obtain\n\n$$\n\\begin{aligned}4\\operatorname{ln}⁡(x)-2\\operatorname{ln}⁡(y) & =\\operatorname{ln}⁡({x}^{4})-\\operatorname{ln}⁡({y}^{2}) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{{x}^{4}}{{y}^{2}}\\right).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543502 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "166addb8-c2f1-5d2d-9873-0a17afec2f1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e+\\operatorname{ln}⁡(x)+\\operatorname{ln}⁡(5)" :db/id #edb/ref 17592186542695} {:answer/id #uuid "276974b1-5543-5e63-b8c1-928234d07545" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+\\operatorname{ln}⁡(x-5)" :db/id #edb/ref 17592186542742} {:answer/id #uuid "61e1ae29-15b8-582a-aa4f-7bb4c3defafc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{ln}⁡(x)+\\frac{5}{e}" :db/id #edb/ref 17592186542905} {:answer/id #uuid "7c5cb179-ffca-5fe5-89e3-4dc4c59454a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+\\operatorname{ln}⁡(x)-\\operatorname{ln}⁡(5)" :db/id #edb/ref 17592186542973} {:answer/id #uuid "88f6512a-e755-51b7-8dea-3427afc1e864" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e-\\operatorname{ln}⁡(x)-5" :db/id #edb/ref 17592186543001}] :answer-field/correct {:answer/id #uuid "7c5cb179-ffca-5fe5-89e3-4dc4c59454a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+\\operatorname{ln}⁡(x)-\\operatorname{ln}⁡(5)" :db/id #edb/ref 17592186542973} :answer-field/id #uuid "2ee605d5-badf-5ba4-afaa-ea809cbe4caf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543320}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4d345e50-4921-588f-ae74-039f20e6e137" :question/math-academy-id "q-100242" :question/problem "$\\operatorname{ln}⁡\\left(\\frac{ex}{5}\\right)=$" :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the quotient rule and then the product rule for logarithms, we have\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡\\left(\\frac{ex}{5}\\right) & =\\operatorname{ln}⁡(ex)-\\operatorname{ln}⁡(5) \\\\  & =\\operatorname{ln}⁡(e)+\\operatorname{ln}⁡(x)-\\operatorname{ln}⁡(5) \\\\  & =1+\\operatorname{ln}⁡(x)-\\operatorname{ln}⁡(5).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543504 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "011df462-573f-5d1e-a6c9-530e8e4108d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "400" :db/id #edb/ref 17592186542638} {:answer/id #uuid "32606e7b-b40b-50e3-a1d1-5d1910806be4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "370" :db/id #edb/ref 17592186542774} {:answer/id #uuid "78fc0312-8634-566a-bd85-e6da768f8465" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "440" :db/id #edb/ref 17592186542961} {:answer/id #uuid "90057f88-a3e0-5ac7-8640-ecf0b41f4d06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "430" :db/id #edb/ref 17592186543016} {:answer/id #uuid "be134ae9-dcf1-5a55-b9fd-d851e56132fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "390" :db/id #edb/ref 17592186543137}] :answer-field/correct {:answer/id #uuid "011df462-573f-5d1e-a6c9-530e8e4108d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "400" :db/id #edb/ref 17592186542638} :answer-field/id #uuid "e903e461-23e0-5fcd-b90c-a7d9090e44fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543457}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "597abfab-9fa0-5884-9650-9d3a1ca7b418" :question/math-academy-id "q-121513" :question/problem "Consider the equation $\\operatorname{cos}⁡\\left(\\frac{3x}{2}\\right)=-\\frac{1}{2}$ for ${0}^{∘}\\le x<{360}^{∘}.$ If the solutions ${x}_{1},{x}_{2}$ and ${x}_{3}$ are written in ascending order,  what is the numerical value of ${x}_{1}+{x}_{3}?$" :question/worked-solution "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is given by\n\n$$\n\\begin{aligned}\\frac{3x}{2} & ={120}^{∘}+n\\cdot {360}^{∘}, & \\, & \\, & \\frac{3x}{2} & ={240}^{∘}+n\\cdot {360}^{∘}.\\end{aligned}\n$$\n\nSolving our two equations for $x$ gives:\n\n$$\n\\begin{aligned}3x & ={240}^{∘}+n\\cdot {720}^{∘} & \\, & \\, & 3x & ={480}^{∘}+n\\cdot {720}^{∘} \\\\ x & =\\frac{{240}^{∘}}{3}+\\frac{n\\cdot {720}^{∘}}{3} & \\, & \\, & x & =\\frac{{480}^{∘}}{3}+\\frac{n\\cdot {720}^{∘}}{3} \\\\ x & ={80}^{∘}+n\\cdot {240}^{∘} & \\, & \\, & x & ={160}^{∘}+n\\cdot {240}^{∘}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain ${0}^{∘}\\le x<{360}^{∘}.$\n\n- Setting $n=0$ gives $x={80}^{∘}$ and $x={160}^{∘}$\n\n- Setting $n=1$ gives $x={320}^{∘}$ and $x={400}^{∘}.$ We reject the solution ${400}^{∘}$ since it lies outside the domain of interest.\n\nAll other values of $n$ generate solutions outside the domain ${0}^{∘}\\le x<{360}^{∘}.$ So, the solutions ${x}_{1},{x}_{2}$ and ${x}_{3}$ (written in ascending order) are\n\n$$\nx={80}^{∘},\\,{160}^{∘},\\,{320}^{∘}\n$$\n\nFinally, since ${x}_{1}={80}^{∘}$ and ${x}_{3}={320}^{∘},$ the numerical value of ${x}_{1}\\text{ }+{x}_{3}$ is $80+320=400.$"} {:db/id #edb/ref 17592186543505 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f7bf1e4-9398-55b3-bd2b-8515162867e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4.14" :db/id #edb/ref 17592186542897} {:answer/id #uuid "94e0befa-4705-51e9-9630-de948e992209" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.18" :db/id #edb/ref 17592186543030} {:answer/id #uuid "a8ba97b2-62e5-5ad9-99a5-29d92dd18008" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.54" :db/id #edb/ref 17592186543086} {:answer/id #uuid "e5189590-8a2a-5040-af84-68d2107b8f6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4.39" :db/id #edb/ref 17592186543222} {:answer/id #uuid "f57a279b-4104-5ca5-8808-72ea4b362832" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4.99" :db/id #edb/ref 17592186543269}] :answer-field/correct {:answer/id #uuid "e5189590-8a2a-5040-af84-68d2107b8f6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4.39" :db/id #edb/ref 17592186543222} :answer-field/id #uuid "32c3ae4e-5559-5bc7-8d50-9bcf40432395" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543321}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5c4c55fe-2946-5795-a8c6-76c349270710" :question/math-academy-id "q-159960" :question/problem "Suppose ${X}_{1},{X}_{2},{X}_{3}$ is an I.I.D random sample with ${X}_{i}∼N(\\theta ,{1}^{2}),$ where $\\theta $ is an unknown mean. The log-likelihood function of the sample $0.5,\\,-0.8,\\,-1.3$ is\n\n$$\nl(\\theta )=-1.5\\operatorname{ln}⁡(2\\pi )+a+b\\theta +c{\\theta }^{2}\n$$\n\nWhat is the value of $a+b+c?$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i};\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i};\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=3$ independent normal random variables with unknown mean $\\theta $ and variance ${\\sigma }^{2}=1,$ for which the probability density function is\n\n$$\nf(x,\\theta )=\\frac{1}{\\sigma \\sqrt{2\\pi }}{e}^{-\\frac{1}{2}{\\left(\\frac{x-\\theta }{\\sigma }\\right)}^{2}}=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$\n\nNext, we write down the log-density function:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡f(x,\\theta ) & =\\operatorname{ln}⁡(\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2}) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{1}{\\sqrt{2\\pi }}\\right)+\\operatorname{ln}⁡({e}^{-(x-\\theta )^{2}/2}) \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{(x-\\theta )^{2}}{2}.\\end{aligned}\n$$\n\nNow, we can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}(-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{({x}_{i}-\\theta )^{2}}{2}) \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-{\\sum }_{i=1}^{n}\\frac{({x}_{i}-\\theta )^{2}}{2} \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}({\\sum }_{i=1}^{n}{x}_{i}^{2}-2\\theta {\\sum }_{i=1}^{n}{x}_{i}+n{\\theta }^{2})\\end{aligned}\n$$\n\nFor our sample, we have that\n\n$$\n\\begin{aligned}S & ={\\sum }_{i=1}^{n}{x}_{i} \\\\  & =0.5+(-0.8)+(-1.3) \\\\  & =-1.6 \\\\ C & ={\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =(0.5)^{2}+(-0.8)^{2}+(-1.3)^{2} \\\\  & =2.58\\end{aligned}\n$$\n\nand $n=3.$ Therefore,  \n\n$$\n\\begin{aligned}l(\\theta ) & =-\\frac{3}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}(2.58-2\\theta \\cdot (-1.6)+3{\\theta }^{2}) \\\\  & =-1.5\\operatorname{ln}⁡(2\\pi )+(-1.29)+(-1.6)\\theta +(-1.5){\\theta }^{2}.\\end{aligned}\n$$\n\nFinally, \n\n$$\na+b+c=-1.29+(-1.6)+(-1.5)=-4.39.\n$$"} {:db/id #edb/ref 17592186543508 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02678531-9c49-5d43-ac23-ff708b70c36a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186542643} {:answer/id #uuid "61ecb54f-4cf4-55d8-87f1-9831a5a2ebfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186542908} {:answer/id #uuid "998509c8-dbe2-5773-9816-4eebd147b0d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186543041} {:answer/id #uuid "cf7c9130-467b-5bbc-adb8-bda779f897f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186543176} {:answer/id #uuid "f056c49a-e227-56b9-82af-8dff44909eb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt{3}" :db/id #edb/ref 17592186543253}] :answer-field/correct {:answer/id #uuid "cf7c9130-467b-5bbc-adb8-bda779f897f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186543176} :answer-field/id #uuid "73fea5df-076e-5c43-b1fe-9e9657547c19" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543365}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5fff1012-20ae-54c4-8327-06d77bbed9eb" :question/math-academy-id "q-121522" :question/problem "The polar curve $r=k\\operatorname{cos}⁡\\theta ,$ where $k$ is a constant, passes through the point $A$ with Cartesian coordinates $(-\\frac{9}{2},-\\frac{3\\sqrt{3}}{2}).$ What is the value of $k?$" :question/worked-solution "First, we find the polar coordinates of the point $A.$ The distance from $A$ to the origin is\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{\\left(-\\frac{9}{2}\\right)}^{2}+{\\left(-\\frac{3\\sqrt{3}}{2}\\right)}^{2}} \\\\  & =\\sqrt{\\frac{81}{4}+\\frac{27}{4}} \\\\  & =\\sqrt{27} \\\\  & =3\\sqrt{3}.\\end{aligned}\n$$\n\nNow, since $A$ lies in the third quadrant, we get\n\n$$\n\\begin{aligned}\\theta  & =\\pi +\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\pi +\\operatorname{arctan}⁡|\\frac{-\\frac{3\\sqrt{3}}{2}}{-\\frac{9}{2}}| \\\\  & =\\pi +\\operatorname{arctan}⁡\\frac{\\sqrt{3}}{3} \\\\  & =\\frac{7\\pi }{6}.\\end{aligned}\n$$\n\nSo, the polar coordinates of $A$ are $(r,\\theta )=(3\\sqrt{3},\\frac{7\\pi }{6}).$  \n\nTo find the value of $k$, we substitute the polar coordinates of the point $A$ into the polar equation of the curve:\n\n$$\n\\begin{aligned}r & =k\\operatorname{cos}⁡\\theta  \\\\ 3\\sqrt{3} & =k\\operatorname{cos}⁡\\left(\\frac{7\\pi }{6}\\right) \\\\ 3\\sqrt{3} & =k\\left(-\\frac{\\sqrt{3}}{2}\\right) \\\\ k & =-6\\end{aligned}\n$$\n\n \n\nTherefore, the equation of the curve is $r=-6\\operatorname{cos}⁡\\theta ,$ as shown below.\n\n![](images/99/999a34650676174083aa479669eecca0c837dc8e5f1397a81a8949d8f9dc9de1.png)"} {:db/id #edb/ref 17592186543510 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e71254c-e0c3-52aa-adb5-692437b5a10e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n}{14}" :db/id #edb/ref 17592186542670} {:answer/id #uuid "17c609b3-a070-57e3-b76f-89aea6bb093e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n}{7}" :db/id #edb/ref 17592186542700} {:answer/id #uuid "1b77aee6-038f-5fb6-8e37-86b0bbba4aba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7n\\pi }{2}" :db/id #edb/ref 17592186542711} {:answer/id #uuid "a65b53c3-6b83-58ec-ab00-d0e3e1f10487" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n\\pi }{7}" :db/id #edb/ref 17592186543076} {:answer/id #uuid "f0ba5cbd-77f0-51e1-853b-981e94517aea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n\\pi }{14}" :db/id #edb/ref 17592186543257}] :answer-field/correct {:answer/id #uuid "f0ba5cbd-77f0-51e1-853b-981e94517aea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n\\pi }{14}" :db/id #edb/ref 17592186543257} :answer-field/id #uuid "9c89b6fc-2543-5375-ab12-8c5c3b4ded4d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186543396} {:answer-field/choices [{:answer/id #uuid "4aa47990-58f3-5096-8b77-8c4ac5b32a12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{B}_{n}\\operatorname{cos}⁡(7{\\lambda }_{n}x)" :db/id #edb/ref 17592186542846} {:answer/id #uuid "809028e1-3f32-54af-9337-604142d70915" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{B}_{n}\\operatorname{sin}⁡(7{\\lambda }_{n}x)" :db/id #edb/ref 17592186542985} {:answer/id #uuid "9c089454-6485-5a34-8c18-f408f079ca03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{B}_{n}\\operatorname{cos}⁡({\\lambda }_{n}x)" :db/id #edb/ref 17592186543049} {:answer/id #uuid "b1218580-144b-5528-875c-a87a479b27f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{B}_{n}\\operatorname{cos}⁡\\left(\\frac{{\\lambda }_{n}x}{7}\\right)" :db/id #edb/ref 17592186543102} {:answer/id #uuid "bd81cd0e-c825-53fe-8a34-c3d587ddcf8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{B}_{n}\\operatorname{sin}⁡\\left(\\frac{7{\\lambda }_{n}x}{2}\\right)" :db/id #edb/ref 17592186543136} {:answer/id #uuid "d1d5e092-eb0f-57a1-9f9e-03c7c474790a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{B}_{n}\\operatorname{sin}⁡({\\lambda }_{n}x)" :db/id #edb/ref 17592186543181}] :answer-field/correct {:answer/id #uuid "4aa47990-58f3-5096-8b77-8c4ac5b32a12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{B}_{n}\\operatorname{cos}⁡(7{\\lambda }_{n}x)" :db/id #edb/ref 17592186542846} :answer-field/id #uuid "9f0c0ee2-17d3-59de-a732-734f1a510b76" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186543402}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "648c7fb6-34ca-53e3-ba2b-a6cf79213062" :question/math-academy-id "q-338913" :question/problem "Consider the boundary value problem\n\n$$\n{y}^{″}+49{\\lambda }^{2}y=0,\\,{y}^{′}(0)={y}^{′}(2)=0,\\,0\\le x\\le 2,\\,\\lambda \\ge 0.\n$$\n\nFind the parameter values corresponding to the eigenvalues and the associated eigenfunctions of this problem.\n\n$\\,$ The eigenvalues correspond to the parameter values ${\\lambda }_{n}=$ {{field-1}}, where $n\\in N.$\n\n$\\,$ The eigenfunctions are ${y}_{n}(x)=$ {{field-2}}, where ${B}_{n}\\in R.$" :question/worked-solution "We consider the cases $\\lambda =0$ and $\\lambda \\ne 0$ separately, since they correspond to different solutions. \n\n**Case 1**: First, we consider $\\lambda =0.$ \n\nSetting $\\lambda =0$ gives the equation\n\n$$\n{y}^{″}=0.\n$$\n\nIntegrating this equation gives\n\n$$\ny=Ax+B.\n$$\n\nApplying the conditions ${y}^{′}(0)={y}^{′}(2)=0$ yields $A=0.$ Thus, we have a nontrivial solution, so $\\lambda =0$ is a parameter corresponding to the eigenvalue.\n\n**Case 2**: Next, we consider $\\lambda >0.$\n\nTo find the fundamental solutions, we set $y={e}^{mx}.$ The auxiliary equation is\n\n$$\n\\begin{aligned}{m}^{2}+49{\\lambda }^{2} & =0.\\end{aligned}\n$$\n\nSo, we have $m=\\pm 7\\text{i}\\lambda .$ So, the fundamental solutions are \n\n$$\n{y}_{1}(x)=\\operatorname{cos}⁡(7\\lambda x),\\,{y}_{2}(x)=\\operatorname{sin}⁡(7\\lambda x)\n$$\n\nand the general solution is\n\n$$\ny=A\\operatorname{cos}⁡(7\\lambda x)+B\\operatorname{sin}⁡(7\\lambda x).\n$$\n\nDifferentiating gives\n\n$$\n{y}^{′}=-7A\\lambda \\operatorname{sin}⁡(7\\lambda x)+7B\\lambda \\operatorname{cos}⁡(7\\lambda x).\n$$\n\nApplying the boundary condition ${y}^{′}(0)=0$ yields\n\n$$\n-7A\\lambda \\operatorname{sin}⁡(0)+7B\\lambda \\operatorname{cos}⁡(0)=0\n$$\n\nwhich gives $B=0.$ So, we have\n\n$$\ny=A\\operatorname{cos}⁡(7\\lambda x).\n$$\n\nApplying the boundary condition ${y}^{′}(2)=0$ yields\n\n$$\n-7A\\lambda \\operatorname{sin}⁡(14\\lambda )=0.\n$$\n\nFor nontrivial solutions, we require \n\n$$\n14\\lambda =n\\pi \n$$\n\nfor $n\\in N.$ This gives the parameter values corresponding to the eigenvalues:\n\n$$\n{\\lambda }_{n}=\\frac{n\\pi }{14}.\n$$\n\nThe corresponding eigenfunctions are \n\n$$\n{y}_{n}(x)={B}_{n}\\operatorname{cos}⁡(7{\\lambda }_{n}x),\\,{B}_{n}\\in R.\n$$"} {:db/id #edb/ref 17592186543514 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a2284e9-4930-533e-bba1-f292b232ff69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\operatorname{ln}⁡(4)" :db/id #edb/ref 17592186542708} {:answer/id #uuid "2b33e9f2-06d0-52b1-a7b7-b07f7a75beeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(24)" :db/id #edb/ref 17592186542754} {:answer/id #uuid "67971526-2da3-573b-889f-1f6897fcc514" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\operatorname{ln}⁡(51)" :db/id #edb/ref 17592186542919} {:answer/id #uuid "b676aa76-e411-5e72-8f33-6c2b1d560616" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(51)" :db/id #edb/ref 17592186543113} {:answer/id #uuid "beb71651-a15a-5287-b002-925ef99ff434" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\operatorname{ln}⁡(17)" :db/id #edb/ref 17592186543141}] :answer-field/correct {:answer/id #uuid "1a2284e9-4930-533e-bba1-f292b232ff69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\operatorname{ln}⁡(4)" :db/id #edb/ref 17592186542708} :answer-field/id #uuid "575fce98-8f44-5a96-9baa-f92440382dd4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543343}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "692975c7-d71f-5bff-afaa-3fff34d21e62" :question/math-academy-id "q-99953" :question/problem "Express $6\\operatorname{ln}⁡(68)-6\\operatorname{ln}⁡(17)$ as a single logarithm." :question/worked-solution "First, let's recall the quotient rule for natural logarithms:\n\n$$\n\\operatorname{ln}⁡(a)-\\operatorname{ln}⁡(b)=\\operatorname{ln}⁡\\left(\\frac{a}{b}\\right)\n$$\n\nIf we factor the given expression and use the quotient rule for logarithms, we get:\n\n$$\n\\begin{aligned}6\\operatorname{ln}⁡(68)-6\\operatorname{ln}⁡(17) & =6(\\operatorname{ln}⁡(68)-\\operatorname{ln}⁡(17)) \\\\  & =6\\operatorname{ln}⁡\\left(\\frac{68}{17}\\right) \\\\  & =6\\operatorname{ln}⁡(4)\\end{aligned}\n$$\n\nTherefore:\n\n$$\n6\\operatorname{ln}⁡(68)-6\\operatorname{ln}⁡(17)=6\\operatorname{ln}⁡(4)\n$$"} {:db/id #edb/ref 17592186543516 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3def5748-f5f8-53b5-b6ea-8e14945dfed5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{9}+z)(\\frac{1}{9}+\\frac{z}{9}+{z}^{2})" :db/id #edb/ref 17592186542809} {:answer/id #uuid "62a351de-d274-575d-b200-5387096347ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{3}+z)(\\frac{1}{3}-\\frac{z}{2}+{z}^{2})" :db/id #edb/ref 17592186542910} {:answer/id #uuid "93a145b7-2cd7-59b3-8ff3-26e918720c2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{9}-z)(\\frac{1}{3}-\\frac{z}{9}+{z}^{2})" :db/id #edb/ref 17592186543026} {:answer/id #uuid "bb2085ff-c8a6-5372-acca-6f59e8fca692" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{3}-z)(\\frac{1}{9}+\\frac{z}{3}+{z}^{2})" :db/id #edb/ref 17592186543132} {:answer/id #uuid "f1b9f62d-cf08-5a64-aeb7-1cab2092352e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{3}+z)(\\frac{1}{9}-\\frac{z}{3}+{z}^{2})" :db/id #edb/ref 17592186543260}] :answer-field/correct {:answer/id #uuid "f1b9f62d-cf08-5a64-aeb7-1cab2092352e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{3}+z)(\\frac{1}{9}-\\frac{z}{3}+{z}^{2})" :db/id #edb/ref 17592186543260} :answer-field/id #uuid "b77b7c3f-41cf-5d84-b905-19ea7c30c507" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543427}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "733ab756-eb23-5365-83ae-dfce071139ee" :question/math-academy-id "q-3600" :question/problem "Factor $\\frac{1}{27}+{z}^{3}.$" :question/worked-solution "The sum of cubes formula is given by\n\n$$\n{a}^{3}+{b}^{3}=(a+b)({a}^{2}-ab+{b}^{2}).\n$$\n\nNotice that we can write our expression as a sum of cubes, as follows:\n\n$$\n\\frac{1}{27}+{z}^{3}={\\left(\\frac{1}{3}\\right)}^{3}+{z}^{3}\n$$\n\nNow, we factor our expression using the sum of cubes formula:\n\n$$\n\\begin{aligned}\\frac{1}{27}+{z}^{3} & ={\\left(\\frac{1}{3}\\right)}^{3}+{z}^{3} \\\\  & =(\\frac{1}{3}+z)({\\left(\\frac{1}{3}\\right)}^{2}-\\frac{1}{3}\\cdot z+{z}^{2}) \\\\  & =(\\frac{1}{3}+z)(\\frac{1}{9}-\\frac{z}{3}+{z}^{2})\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543519 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0269a173-54ba-5ccf-a6e0-995965a165aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z\\operatorname{ln}⁡(6)-\\operatorname{ln}⁡(13)" :db/id #edb/ref 17592186542644} {:answer/id #uuid "4e543ebb-1b6e-57d7-a4cc-de52b91accec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(13)-6\\operatorname{ln}⁡(z)" :db/id #edb/ref 17592186542852} {:answer/id #uuid "71ac5314-1262-522d-bc00-0042ccd70e85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\operatorname{ln}⁡(z-13)" :db/id #edb/ref 17592186542940} {:answer/id #uuid "ba338d13-209f-57cf-bc5e-38caaf642b94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\operatorname{ln}⁡(z)-\\operatorname{ln}⁡(13)" :db/id #edb/ref 17592186543127} {:answer/id #uuid "e1f1b615-0943-5954-af8a-c55ae24c583b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13\\operatorname{ln}⁡(6)-\\operatorname{ln}⁡(z)" :db/id #edb/ref 17592186543215}] :answer-field/correct {:answer/id #uuid "ba338d13-209f-57cf-bc5e-38caaf642b94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\operatorname{ln}⁡(z)-\\operatorname{ln}⁡(13)" :db/id #edb/ref 17592186543127} :answer-field/id #uuid "b0f4d0f6-7f8a-58c2-8e17-d618255d36d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543422}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7a291781-59c8-57ab-aafe-d8f0841ec267" :question/math-academy-id "q-47198" :question/problem "$\\operatorname{ln}⁡\\left(\\frac{{z}^{6}}{13}\\right)=$" :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the quotient quotient and then the power rule for logarithms, we obtain\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡\\left(\\frac{{z}^{6}}{13}\\right) & =\\operatorname{ln}⁡({z}^{6})-\\operatorname{ln}⁡(13) \\\\  & =6\\operatorname{ln}⁡(z)-\\operatorname{ln}⁡(13).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543523 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06a88805-1323-5ff5-8f48-42543b26f532" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8(\\frac{1}{{t}^{2}}-5)(\\frac{1}{{t}^{4}}+\\frac{5}{{t}^{2}}+25)" :db/id #edb/ref 17592186542653} {:answer/id #uuid "42f98072-159d-5073-bea3-fc772168038c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8(\\frac{1}{{t}^{2}}+5)(\\frac{1}{{t}^{2}}-\\frac{1}{{t}^{2}}+5)" :db/id #edb/ref 17592186542821} {:answer/id #uuid "4903b99d-0682-5a79-8fb4-e2b4b7c0f41f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8(\\frac{1}{t}+5)(\\frac{1}{{t}^{4}}-\\frac{5}{{t}^{2}}+25)" :db/id #edb/ref 17592186542839} {:answer/id #uuid "50b5e943-9ca0-5aed-9175-6b9302edbbc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8(\\frac{1}{t}-5)(\\frac{1}{{t}^{2}}+\\frac{1}{{t}^{2}}+5)" :db/id #edb/ref 17592186542860} {:answer/id #uuid "ee53056d-d85d-50b2-b983-34612d0e6c4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8(\\frac{1}{{t}^{2}}-5)(\\frac{1}{{t}^{4}}-\\frac{1}{{t}^{2}}+5)" :db/id #edb/ref 17592186543247}] :answer-field/correct {:answer/id #uuid "06a88805-1323-5ff5-8f48-42543b26f532" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8(\\frac{1}{{t}^{2}}-5)(\\frac{1}{{t}^{4}}+\\frac{5}{{t}^{2}}+25)" :db/id #edb/ref 17592186542653} :answer-field/id #uuid "7b298728-bbf2-5c29-9156-fbe40121077d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543375}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "82176286-a684-5858-a421-cc4a4b4187bd" :question/math-academy-id "q-69640" :question/problem "Factor $\\frac{8}{{t}^{6}}-1000.$" :question/worked-solution "The difference of cubes formula is given by\n\n$$\n{a}^{3}-{b}^{3}=(a-b)({a}^{2}+ab+{b}^{2}).\n$$\n\nNotice that all of the terms have a common factor of $8.$ To simplify the computation, we can factor out the $8,$ as follows:\n\n$$\n\\frac{8}{{t}^{6}}-1000=8(\\frac{1}{{t}^{6}}-125)\n$$\n\nThe expression in parentheses can be written as a difference of cubes:\n\n$$\n8(\\frac{1}{{t}^{6}}-125)=8({\\left(\\frac{1}{{t}^{2}}\\right)}^{3}-{5}^{3})\n$$\n\nNow, we factor the expression in parentheses using the difference of cubes formula:\n\n$$\n\\begin{aligned}\\frac{8}{{t}^{6}}-1000 & =8({\\left(\\frac{1}{{t}^{2}}\\right)}^{3}-{5}^{3}) \\\\  & =8(\\frac{1}{{t}^{2}}-5)({\\left(\\frac{1}{{t}^{2}}\\right)}^{2}+\\frac{1}{{t}^{2}}\\cdot 5+{5}^{2}) \\\\  & =8(\\frac{1}{{t}^{2}}-5)(\\frac{1}{{t}^{4}}+\\frac{5}{{t}^{2}}+25)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543524 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "986de02b-222a-5a6d-891b-6e5b891ef90a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186543037} {:answer/id #uuid "9eef2f87-e855-5d53-80f4-202dbca3fd5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186543061} {:answer/id #uuid "a677f03a-acb9-5439-be1f-b1eb7dee2b3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186543078} {:answer/id #uuid "b67ada9d-787b-5291-af4f-7eef69f5678d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186543114} {:answer/id #uuid "e80ede49-5f0c-5bd8-a8bd-3022152fe7f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186543231}] :answer-field/correct {:answer/id #uuid "b67ada9d-787b-5291-af4f-7eef69f5678d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186543114} :answer-field/id #uuid "2cd04507-0815-5cf4-b8b9-c2671207a55b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543319}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "841f3191-5c7e-5e47-b725-127033cb9a73" :question/math-academy-id "q-79453" :question/problem "If ${log}_{5}⁡(x)=3$ and ${log}_{5}⁡(y)=2$, then ${log}_{5}⁡({x}^{2}{y}^{3})=$" :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nNote that ${log}_{5}⁡({x}^{2}{y}^{3})$ can be rewritten using the product and power rules as follows:\n\n$$\n\\begin{aligned}{log}_{5}⁡({x}^{2}{y}^{3}) & ={log}_{5}⁡({x}^{2})+{log}_{5}⁡({y}^{3}) \\\\  & =2{log}_{5}⁡(x)+3{log}_{5}⁡(y)\\end{aligned}\n$$\n\nNow, since ${log}_{5}⁡(x)=3$ and ${log}_{5}⁡(y)=2$, we conclude that\n\n$$\n2{log}_{5}⁡(x)+3{log}_{5}⁡(y)=2\\cdot 3+3\\cdot 2=12.\n$$\n\nHence\n\n$$\n{log}_{5}⁡({x}^{2}{y}^{3})=12.\n$$"} {:db/id #edb/ref 17592186543526 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "170013cd-1ce2-5957-923e-754a4df4bd3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{3}⁡(5)+{log}_{3}⁡(x)-9" :db/id #edb/ref 17592186542699} {:answer/id #uuid "390b5693-f1ca-5a29-a8de-7aacb1098e9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{3}⁡(5)+{log}_{3}⁡(x)+3" :db/id #edb/ref 17592186542790} {:answer/id #uuid "3c27c541-3a63-5fc4-ab19-bafc688b3c69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{3}⁡(5)+{log}_{3}⁡(x)-3" :db/id #edb/ref 17592186542803} {:answer/id #uuid "6173b34d-e283-50ae-9765-c9f0bdcdfe52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{3}⁡(5)-{log}_{3}⁡(x)+3" :db/id #edb/ref 17592186542904} {:answer/id #uuid "8e12ed65-2a4a-5809-a1a7-871496b64eeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{3}⁡(5)-{log}_{3}⁡(x)-9" :db/id #edb/ref 17592186543012}] :answer-field/correct {:answer/id #uuid "3c27c541-3a63-5fc4-ab19-bafc688b3c69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{3}⁡(5)+{log}_{3}⁡(x)-3" :db/id #edb/ref 17592186542803} :answer-field/id #uuid "9f77377e-ee2a-59ef-bb46-445ff072d429" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543403}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8b91269e-ac3e-5858-87ab-575f9e7b0df8" :question/math-academy-id "q-66781" :question/problem "${log}_{3}⁡\\left(\\frac{5x}{27}\\right)=$" :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the quotient rule and then the product rule for logarithms, we have\n\n$$\n\\begin{aligned}{log}_{3}⁡\\left(\\frac{5x}{27}\\right) & ={log}_{3}⁡(5x)-{log}_{3}⁡(27) \\\\  & ={log}_{3}⁡(5)+{log}_{3}⁡(x)-{log}_{3}⁡({3}^{3}) \\\\  & ={log}_{3}⁡(5)+{log}_{3}⁡(x)-3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543531 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fb557ae-9a47-526e-ae26-b4f9d80275d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7k" :db/id #edb/ref 17592186542726} {:answer/id #uuid "a31007c0-bb7e-5195-b1fe-bac89c68dbbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k+12" :db/id #edb/ref 17592186543070} {:answer/id #uuid "cff918bc-b5d0-5906-8d66-bbe4168f3474" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k-12" :db/id #edb/ref 17592186543178} {:answer/id #uuid "daad00e3-599f-5edb-abd8-30682e338221" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k+7" :db/id #edb/ref 17592186543199} {:answer/id #uuid "de2a4dff-046b-5136-b0e7-22b11eceaca1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12k" :db/id #edb/ref 17592186543205}] :answer-field/correct {:answer/id #uuid "a31007c0-bb7e-5195-b1fe-bac89c68dbbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k+12" :db/id #edb/ref 17592186543070} :answer-field/id #uuid "3aab8c1f-76ff-5a2c-9c46-d7294b8c857e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543330}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9796dfce-fb6b-57bd-b442-e9278daaaa20" :question/math-academy-id "q-98925" :question/problem "If ${log}_{2}⁡(x)=k$ and ${log}_{2}⁡(y)=4$, then ${log}_{2}⁡(x{y}^{3})=$" :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nNote that ${log}_{2}⁡(x{y}^{3})$ can be rewritten using the product and power rules as follows:\n\n$$\n\\begin{aligned}{log}_{2}⁡(x{y}^{3}) & ={log}_{2}⁡(x)+{log}_{2}⁡({y}^{3}) \\\\  & ={log}_{2}⁡(x)+3{log}_{2}⁡(y)\\end{aligned}\n$$\n\nNow, since ${log}_{2}⁡(x)=k$ and ${log}_{2}⁡(y)=4,$ we conclude that\n\n$$\n\\begin{aligned}{log}_{2}⁡(x)+3{log}_{2}⁡(y) & =k+3\\cdot 4 \\\\  & =k+12.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{log}_{2}⁡(x{y}^{3})=k+12.\n$$"} {:db/id #edb/ref 17592186543532 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ab9f307-2949-509c-aa21-cb7f2f79269e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{p}{q}" :db/id #edb/ref 17592186542798} {:answer/id #uuid "475b221e-4c3d-508a-8794-b0910728ee87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p-q" :db/id #edb/ref 17592186542833} {:answer/id #uuid "5a7458a8-57c1-50ff-a7eb-323cf41e0146" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q" :db/id #edb/ref 17592186542886} {:answer/id #uuid "8fadf0d1-ce58-5388-bbca-029241c7ef65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{q}{p}" :db/id #edb/ref 17592186543014} {:answer/id #uuid "d4e5be19-84e6-54b6-a352-1c0c4517f128" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q-p" :db/id #edb/ref 17592186543190}] :answer-field/correct {:answer/id #uuid "475b221e-4c3d-508a-8794-b0910728ee87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p-q" :db/id #edb/ref 17592186542833} :answer-field/id #uuid "2842ede1-7316-5852-8316-724915e58cee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543317}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "99f3a3dc-a29b-56b3-b6b2-eb00c09e4e97" :question/math-academy-id "q-24442" :question/problem "If $\\operatorname{log}⁡(2)=p$ and $\\operatorname{log}⁡(y)=q$, then $\\operatorname{log}⁡\\left(\\frac{2}{y}\\right)=$" :question/worked-solution "First, let's recall the quotient rule for common logarithms:\n\n$$\n\\operatorname{log}⁡(a)-\\operatorname{log}⁡(b)=\\operatorname{log}⁡\\left(\\frac{a}{b}\\right)\n$$\n\nUsing the quotient rule for common logarithms, we have:\n\n$$\n\\begin{aligned}\\operatorname{log}⁡\\left(\\frac{2}{y}\\right) & =\\operatorname{log}⁡(2)-\\operatorname{log}⁡(y) \\\\  & =p-q\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543541 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1de3d2cd-60aa-59f4-9c1c-0d3d70e7064b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{x}-{y}^{5}" :db/id #edb/ref 17592186542718} {:answer/id #uuid "3adf2bc5-273b-5e81-9d24-ceeca3bf0302" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{5}⁡(\\sqrt{x})" :db/id #edb/ref 17592186542800} {:answer/id #uuid "6a2fdb68-0b95-5c0e-94b2-81028526e2ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{5}⁡\\left(\\frac{\\sqrt{x}}{5y}\\right)" :db/id #edb/ref 17592186542927} {:answer/id #uuid "896cc279-0ed5-5375-8db2-e1b363fec667" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{x}-1" :db/id #edb/ref 17592186543003} {:answer/id #uuid "b7267a79-3839-5f21-b62c-09c9545b4060" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{5}⁡\\left(\\frac{\\sqrt{x}}{{y}^{5}}\\right)" :db/id #edb/ref 17592186543117}] :answer-field/correct {:answer/id #uuid "b7267a79-3839-5f21-b62c-09c9545b4060" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{5}⁡\\left(\\frac{\\sqrt{x}}{{y}^{5}}\\right)" :db/id #edb/ref 17592186543117} :answer-field/id #uuid "3df2d483-a123-580b-8ed7-a2a425df48f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543332}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a8ef19a1-f2fa-5f29-a4ae-a1f3f6bb227d" :question/math-academy-id "q-1110" :question/problem "Express $\\frac{1}{2}{log}_{5}⁡(x)-5{log}_{5}⁡(y)$ as a single logarithm." :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the power rule and then the quotient rule for logarithms, we obtain\n\n$$\n\\begin{aligned}\\frac{1}{2}{log}_{5}⁡(x)-5{log}_{5}⁡(y) & ={log}_{5}⁡({x}^{1/2})-{log}_{5}⁡({y}^{5}) \\\\  & ={log}_{5}⁡(\\sqrt{x})-{log}_{5}⁡({y}^{5}) \\\\  & ={log}_{5}⁡\\left(\\frac{\\sqrt{x}}{{y}^{5}}\\right).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543544 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47698303-8d61-5840-8827-86edae5c0ca9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3.1" :db/id #edb/ref 17592186542834} {:answer/id #uuid "48989a49-93e8-5124-b600-ec90d999d72c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.3" :db/id #edb/ref 17592186542838} {:answer/id #uuid "7eef2b9f-e7ca-51a3-b197-a936d17dd502" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3.7" :db/id #edb/ref 17592186542981} {:answer/id #uuid "cc28b179-5541-543f-9559-8ecc8381e121" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3.5" :db/id #edb/ref 17592186543171} {:answer/id #uuid "e5647be5-c113-5d6c-87be-376b749ccd3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.9" :db/id #edb/ref 17592186543223}] :answer-field/correct {:answer/id #uuid "7eef2b9f-e7ca-51a3-b197-a936d17dd502" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3.7" :db/id #edb/ref 17592186542981} :answer-field/id #uuid "2253fa4d-3bff-5c5d-817e-be26b444097e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543313}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "aaf34c24-70f2-59f0-ad3e-3eb728abaa5d" :question/math-academy-id "q-159961" :question/problem "Suppose ${X}_{1},{X}_{2},{X}_{3},{X}_{4},{X}_{5}$ is an I.I.D random sample with ${X}_{i}∼N(\\theta ,{1}^{2}),$ where $\\theta $ is an unknown mean. The log-likelihood function of the sample $0.7,\\,0.6,\\,-0.5,\\,1.7,\\,-1.1$ is\n\n$$\nl(\\theta )=-2.5\\operatorname{ln}⁡(2\\pi )+a+b\\theta +c{\\theta }^{2}\n$$\n\nWhat is the value of $a+b+c?$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i};\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i};\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=5$ independent normal random variables with unknown mean $\\theta $ and variance ${\\sigma }^{2}=1,$ for which the probability density function is\n\n$$\nf(x,\\theta )=\\frac{1}{\\sigma \\sqrt{2\\pi }}{e}^{-\\frac{1}{2}{\\left(\\frac{x-\\theta }{\\sigma }\\right)}^{2}}=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$\n\nNext, we write down the log-density function:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡f(x,\\theta ) & =\\operatorname{ln}⁡(\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2}) \\\\  & =\\operatorname{ln}⁡\\left(\\frac{1}{\\sqrt{2\\pi }}\\right)+\\operatorname{ln}⁡({e}^{-(x-\\theta )^{2}/2}) \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{(x-\\theta )^{2}}{2}.\\end{aligned}\n$$\n\nNow, we can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}(-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{({x}_{i}-\\theta )^{2}}{2}) \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-{\\sum }_{i=1}^{n}\\frac{({x}_{i}-\\theta )^{2}}{2} \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}({\\sum }_{i=1}^{n}{x}_{i}^{2}-2\\theta {\\sum }_{i=1}^{n}{x}_{i}+n{\\theta }^{2})\\end{aligned}\n$$\n\nFor our sample, we have that\n\n$$\n\\begin{aligned}S & ={\\sum }_{i=1}^{n}{x}_{i} \\\\  & =0.7+0.6+(-0.5)+1.7+(-1.1) \\\\  & =1.4 \\\\ C & ={\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =(0.7)^{2}+(0.6)^{2}+(-0.5)^{2}+(1.7)^{2}+(-1.1)^{2} \\\\  & =5.2\\end{aligned}\n$$\n\nand $n=5.$ Therefore,  \n\n$$\n\\begin{aligned}l(\\theta ) & =-\\frac{5}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}(5.2-2\\theta \\cdot (1.4)+5{\\theta }^{2}) \\\\  & =-2.5\\operatorname{ln}⁡(2\\pi )+(-2.6)+(1.4)\\theta +(-2.5){\\theta }^{2}.\\end{aligned}\n$$\n\nFinally, \n\n$$\na+b+c=-2.6+(1.4)+(-2.5)=-3.7.\n$$"} {:db/id #edb/ref 17592186543547 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06386582-1858-5b59-a352-479a8fbec1ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k-m" :db/id #edb/ref 17592186542651} {:answer/id #uuid "a7595e68-63e0-55b4-9190-55fd9ad8ee38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k+m" :db/id #edb/ref 17592186543080} {:answer/id #uuid "c8679008-38bf-5c0c-91af-6a3638018d35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{k}{m}" :db/id #edb/ref 17592186543162} {:answer/id #uuid "e5e08e8d-ec38-59a8-94ea-46959cbfc389" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "km" :db/id #edb/ref 17592186543225} {:answer/id #uuid "ed27e2cf-d889-5413-8f07-fe2a732afd99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "m-k" :db/id #edb/ref 17592186543243}] :answer-field/correct {:answer/id #uuid "06386582-1858-5b59-a352-479a8fbec1ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k-m" :db/id #edb/ref 17592186542651} :answer-field/id #uuid "54df9ca0-9526-59ba-8d0c-624262e20b11" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543342}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ada9c1dd-522d-5138-9cfe-44ee7af19872" :question/math-academy-id "q-108201" :question/problem "If $\\operatorname{log}⁡(y)=k$ and $\\operatorname{log}⁡\\left(\\frac{y}{x}\\right)=m$, then $\\operatorname{log}⁡(x)=$" :question/worked-solution "First, let's recall the quotient rule for logarithms:\n\n$$\n{log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)\n$$\n\nUsing the quotient rule for logarithms, we have\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(x) & =\\operatorname{log}⁡\\left(\\frac{y}{\\left(\\frac{y}{x}\\right)}\\right) \\\\  & =\\operatorname{log}⁡(y)-\\operatorname{log}⁡\\left(\\frac{y}{x}\\right) \\\\  & =k-m.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543549 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "312ee280-346c-51be-9a5b-40f3ad5f100e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{2}⁡(7t)" :db/id #edb/ref 17592186542770} {:answer/id #uuid "5543e5e9-fa34-55a2-963c-46317805891c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{2}⁡\\left(\\frac{{t}^{7}}{2}\\right)" :db/id #edb/ref 17592186542869} {:answer/id #uuid "61eaa231-d53f-5412-a297-547a805089db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{2}⁡\\left(\\frac{7t}{2}\\right)" :db/id #edb/ref 17592186542907} {:answer/id #uuid "ce45adcc-4013-5eaa-828b-6c4c5f9aefd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{2}⁡(t+7)" :db/id #edb/ref 17592186543175} {:answer/id #uuid "f7a71173-deae-5155-8154-2b2bf6b3687d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{2}⁡({t}^{7})" :db/id #edb/ref 17592186543275}] :answer-field/correct {:answer/id #uuid "f7a71173-deae-5155-8154-2b2bf6b3687d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{2}⁡({t}^{7})" :db/id #edb/ref 17592186543275} :answer-field/id #uuid "eba2b04a-58b1-5797-a2dc-057b2fcfd9dd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543458}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b071d322-d430-5f91-b157-0d44ee6fac29" :question/math-academy-id "q-100019" :question/problem "$7{log}_{2}⁡t=$" :question/worked-solution "First, let's recall the power rule for logarithms:\n\n$$\n\\operatorname{log}⁡({c}^{m})=m\\operatorname{log}⁡(c)\n$$\n\nUsing the power rule for logarithms, we obtain\n\n$$\n7{log}_{2}⁡t={log}_{2}⁡({t}^{7}).\n$$"} {:db/id #edb/ref 17592186543552 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07fd8dbf-8464-5213-809c-abf7fe832f06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186542654} {:answer/id #uuid "3c779408-7831-5160-b0c8-60656efd484a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186542806} {:answer/id #uuid "9a82f221-b74d-53a8-8503-dd83640fa112" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186543045} {:answer/id #uuid "a4b697a9-1b21-56af-8f8c-9f4c93fcecf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\sqrt{3}" :db/id #edb/ref 17592186543073} {:answer/id #uuid "ac2ba49b-f75f-5551-9a43-d83d73aeffba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186543094}] :answer-field/correct {:answer/id #uuid "9a82f221-b74d-53a8-8503-dd83640fa112" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186543045} :answer-field/id #uuid "949b8458-1c9d-5893-a395-0d0724748af6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543391}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b69fb899-dda9-520e-9df1-5f655ac32f35" :question/math-academy-id "q-121354" :question/problem "The polar curve $r=k\\operatorname{cos}⁡\\theta ,$ where $k$ is a constant, passes through the point $A$ with Cartesian coordinates $(-1,\\sqrt{3}).$ What is the value of $k?$" :question/worked-solution "First, we find the polar coordinates of the point $A.$ The distance from $A$ to the origin is\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-1)^{2}+{(\\sqrt{3})}^{2}} \\\\  & =2.\\end{aligned}\n$$\n\nNow, since $A$ lies in the second quadrant, we get\n\n$$\n\\begin{aligned}\\theta  & =\\pi -\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\pi -\\operatorname{arctan}⁡|-\\frac{\\sqrt{3}}{1}| \\\\  & =\\pi -\\frac{\\pi }{3} \\\\  & =\\frac{2\\pi }{3}.\\end{aligned}\n$$\n\nSo, the polar coordinates of $A$ are $(r,\\theta )=(2,\\frac{2\\pi }{3}).$ \n\nTo find the value of $k$, we substitute the polar coordinates of the point $A$ into the polar equation of the curve:\n\n$$\n\\begin{aligned}r & =k\\operatorname{cos}⁡\\theta  \\\\ 2 & =k\\operatorname{cos}⁡\\left(\\frac{2\\pi }{3}\\right) \\\\ 2 & =k\\left(-\\frac{1}{2}\\right) \\\\ k & =-4\\end{aligned}\n$$\n\nTherefore, the equation of the curve is $r=-4\\operatorname{cos}⁡\\theta ,$ as shown below.\n\n![](images/f8/f85ddaa01b6f2232627375ec622232a245c6e7e21fb9e294cd0801fd45433d73.png)"} {:db/id #edb/ref 17592186543556 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24d2769f-5f35-5619-a06a-6da4d0cd9d06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{24{\\pi }^{2}}{45}" :db/id #edb/ref 17592186542734} {:answer/id #uuid "3adfe199-8aa8-54b5-af09-00ff18169df0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11{\\pi }^{2}}{15}" :db/id #edb/ref 17592186542801} {:answer/id #uuid "66f3e329-d6ad-5cda-b6ea-849f556393e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8{\\pi }^{2}}{15}" :db/id #edb/ref 17592186542916} {:answer/id #uuid "9cd4b999-29de-5078-b62a-6736401df8ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17{\\pi }^{2}}{45}" :db/id #edb/ref 17592186543052} {:answer/id #uuid "b72530e6-e6de-50bd-a6e2-1633d11cef2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11{\\pi }^{2}}{45}" :db/id #edb/ref 17592186543116}] :answer-field/correct {:answer/id #uuid "9cd4b999-29de-5078-b62a-6736401df8ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17{\\pi }^{2}}{45}" :db/id #edb/ref 17592186543052} :answer-field/id #uuid "babdd4ab-5b3d-5b5f-8892-4e5632d1283f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543430}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c08c7d82-b9b5-59ff-a4f6-2f1eac5d7e57" :question/math-academy-id "q-121537" :question/problem "Consider the equation $2\\sqrt{3}\\operatorname{cos}⁡\\left(\\frac{5x}{2}\\right)+3=0$ for $0\\le x<2\\pi .$ If the solutions ${x}_{1},{x}_{2},{x}_{3},{x}_{4}$ and ${x}_{5}$ are written in ascending order, what is the value of ${x}_{1}\\cdot {x}_{3}?$" :question/worked-solution "First, we rearrange the equation, as follows:\n\n$$\n\\begin{aligned}2\\sqrt{3}\\operatorname{cos}⁡\\left(\\frac{5x}{2}\\right)+3 & =0 \\\\ 2\\sqrt{3}\\operatorname{cos}⁡\\left(\\frac{5x}{2}\\right) & =-3 \\\\ \\operatorname{cos}⁡\\left(\\frac{5x}{2}\\right) & =-\\frac{3}{2\\sqrt{3}} \\\\ \\operatorname{cos}⁡\\left(\\frac{5x}{2}\\right) & =-\\frac{\\sqrt{3}}{2}\\end{aligned}\n$$\n\nWe will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is\n\n$$\n\\begin{aligned}\\frac{5x}{2} & =\\frac{5\\pi }{6}+2n\\pi , & \\, & \\, & \\frac{5x}{2} & =\\frac{7\\pi }{6}+2n\\pi .\\end{aligned}\n$$\n\nSolving the two equations above for $x$ gives:\n\n$$\n\\begin{aligned}5x & =\\frac{5\\pi }{3}+4n\\pi  & \\, & \\, & 5x & =\\frac{7\\pi }{3}+4n\\pi  \\\\ x & =\\frac{\\pi }{3}+\\frac{4n\\pi }{5} & \\, & \\, & x & =\\frac{7\\pi }{15}+\\frac{4n\\pi }{5} \\\\ x & =\\frac{(12n+5)\\pi }{15} & \\, & \\, & x & =\\frac{(12n+7)\\pi }{15}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0\\le x<2\\pi .$\n\n- Setting $n=0$ gives $x=\\frac{\\pi }{3}$ and $x=\\frac{7\\pi }{15}$\n\n- Setting $n=1$ gives $x=\\frac{17\\pi }{15}$  and $x=\\frac{19\\pi }{15}.$\n\n- Setting $n=2$ gives $x=\\frac{29\\pi }{15}$  and $x=\\frac{31\\pi }{15}.$ We reject the solution $\\frac{31\\pi }{15}$ since it lies outside the domain of interest.\n\nAll other values of $n$ generate solutions outside the domain $0\\le x<2\\pi .$ So, the solutions ${x}_{1},{x}_{2},{x}_{3},{x}_{4},{x}_{5}$ (written in ascending order) are\n\n$$\nx=\\frac{\\pi }{3},\\,\\frac{7\\pi }{15},\\,\\frac{17\\pi }{15},\\,\\frac{19\\pi }{15},\\,\\frac{29\\pi }{15}.\n$$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{3}=\\frac{\\pi }{3}\\cdot \\frac{17\\pi }{15}=\\frac{17{\\pi }^{2}}{45}.\n$$"} {:db/id #edb/ref 17592186543573 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10851533-4282-5b80-bae7-98d8fc92685d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{log}_{3}⁡(x)+3{log}_{3}⁡(y)-\\frac{1}{2}{log}_{3}⁡(z)" :db/id #edb/ref 17592186542678} {:answer/id #uuid "290b87bb-8570-5cb4-83b9-b6d2e59941cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{log}_{3}⁡(x)+3{log}_{3}⁡(y)+\\frac{1}{2}{log}_{3}⁡(z)" :db/id #edb/ref 17592186542749} {:answer/id #uuid "599a54dc-6c33-56a6-8830-1ae45124f78d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{3}⁡(x)-{log}_{3}⁡(y)-\\frac{1}{2}{log}_{3}⁡(z)" :db/id #edb/ref 17592186542884} {:answer/id #uuid "84635862-dc5f-5a84-88a5-ebc9a5b22bda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{log}_{3}⁡(x)+{log}_{3}⁡(y)-\\frac{1}{2}{log}_{3}⁡(z)" :db/id #edb/ref 17592186542994} {:answer/id #uuid "91fec59e-a5fa-5664-9d8b-2381d008fe09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{3}⁡(x)+{log}_{3}⁡(y)+\\frac{1}{2}{log}_{3}⁡(z)" :db/id #edb/ref 17592186543022}] :answer-field/correct {:answer/id #uuid "10851533-4282-5b80-bae7-98d8fc92685d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{log}_{3}⁡(x)+3{log}_{3}⁡(y)-\\frac{1}{2}{log}_{3}⁡(z)" :db/id #edb/ref 17592186542678} :answer-field/id #uuid "3ccb3dbb-60a9-5fb3-a5b6-44c5f5ad437b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543331}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e3b649a8-d282-53b7-b8c8-e883fd47c0b9" :question/math-academy-id "q-79406" :question/problem "${log}_{3}⁡\\left(\\frac{{x}^{2}{y}^{3}}{\\sqrt{z}}\\right)=$" :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the quotient rule for logarithms, we get:\n\n$$\n{log}_{3}⁡\\left(\\frac{{x}^{2}{y}^{3}}{\\sqrt{z}}\\right)={log}_{3}⁡({x}^{2}{y}^{3})-{log}_{3}⁡(\\sqrt{z})\n$$\n\nNow, using the product rule for logarithms, we obtain\n\n$$\n{log}_{3}⁡({x}^{2}{y}^{3})-{log}_{3}⁡(\\sqrt{z})={log}_{3}⁡({x}^{2})+{log}_{3}⁡({y}^{3})-{log}_{3}⁡(\\sqrt{z}).\n$$\n\nFinally, using the power rule for logarithms, we have\n\n$$\n{log}_{3}⁡({x}^{2})+{log}_{3}⁡({y}^{3})-{log}_{3}⁡(\\sqrt{z})=2{log}_{3}⁡(x)+3{log}_{3}⁡(y)-\\frac{1}{2}{log}_{3}⁡(z).\n$$\n\nTherefore\n\n$$\n{log}_{3}⁡\\left(\\frac{{x}^{2}{y}^{3}}{\\sqrt{z}}\\right)=2{log}_{3}⁡(x)+3{log}_{3}⁡(y)-\\frac{1}{2}{log}_{3}⁡(z).\n$$"} {:db/id #edb/ref 17592186543576 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c75f4c4b-c7a0-59c5-8797-cff98d56b03c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186543159}] :answer-field/correct {:answer/id #uuid "c75f4c4b-c7a0-59c5-8797-cff98d56b03c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186543159} :answer-field/id #uuid "a12b2c7e-438f-5baa-bede-06e74205a643" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186543404}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e6d790e0-5c33-5dec-949d-78146efef13a" :question/math-academy-id "q-250840" :question/problem "Given that $\\frac{x}{4}$, $x$, and $64$ are the first three terms of a geometric sequence, find $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "The first three terms are as follows:\n\n$$\n\\begin{aligned}{a}_{1}=\\frac{x}{4},\\,{a}_{2}=x,\\,{a}_{3}=64.\\end{aligned}\n$$\n\nThe common ratio of the first two terms is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{2}}{{a}_{1}}=\\frac{x}{\\left(\\frac{x}{4}\\right)}=x\\cdot \\frac{4}{x}=4.\\end{aligned}\n$$\n\nOn the other hand, the common ratio of the second and third terms is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{3}}{{a}_{2}}=\\frac{64}{x}.\\end{aligned}\n$$\n\nSo, by equating the values for $r$ and solving for $x,$ we conclude that\n\n$$\n\\begin{aligned}4 & =\\frac{64}{x} \\\\ 4x & =64 \\\\ x & =\\frac{64}{4} \\\\ x & =16.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543577 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e893e4b-1f92-52ad-ad87-c504cbe090a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{4}⁡\\left(\\frac{\\sqrt[3]{x}}{y}\\right)" :db/id #edb/ref 17592186542671} {:answer/id #uuid "57aa5928-9fe8-571f-bec1-84a8858c534f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{4}⁡\\left(\\frac{3x}{y}\\right)" :db/id #edb/ref 17592186542879} {:answer/id #uuid "5db0ca0e-d6da-543d-94a6-0b0616316cbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{4}⁡\\left(\\frac{x}{3y}\\right)" :db/id #edb/ref 17592186542891} {:answer/id #uuid "c76a97fc-fdf4-5ad6-8243-95edbdc9a876" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{4}⁡(\\sqrt[3]{x}y)" :db/id #edb/ref 17592186543160} {:answer/id #uuid "ecfa35ae-3197-55c3-8180-1535e0873fbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{4}⁡\\left(\\frac{{x}^{3}}{y}\\right)" :db/id #edb/ref 17592186543240}] :answer-field/correct {:answer/id #uuid "0e893e4b-1f92-52ad-ad87-c504cbe090a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{4}⁡\\left(\\frac{\\sqrt[3]{x}}{y}\\right)" :db/id #edb/ref 17592186542671} :answer-field/id #uuid "bb4f622f-2866-535c-a540-b48bd6d1ad52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543431}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e70f2288-3b25-5d12-a8c5-361a6e66e0f3" :question/math-academy-id "q-100243" :question/problem "Express $\\frac{1}{3}{log}_{4}⁡(x)-{log}_{4}⁡(y)$ as a single logarithm." :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡\\left(\\frac{a}{b}\\right)$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the power rule and then the quotient rule for logarithms, we obtain\n\n$$\n\\begin{aligned}\\frac{1}{3}{log}_{4}⁡(x)-{log}_{4}⁡(y) & ={log}_{4}⁡({x}^{1/3})-{log}_{4}⁡(y) \\\\  & ={log}_{4}⁡(\\sqrt[3]{x})-{log}_{4}⁡(y) \\\\  & ={log}_{4}⁡\\left(\\frac{\\sqrt[3]{x}}{y}\\right).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543812 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "576b4a58-c183-5275-bda2-05fe1ba9c5fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{59}{6}" :db/id #edb/ref 17592186543815} {:answer/id #uuid "7ff2ff02-02b1-5751-b12a-7e9ef64a27e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{97}{6}" :db/id #edb/ref 17592186543820} {:answer/id #uuid "857a4020-99d9-5010-bea5-959744696366" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{59}{6}" :db/id #edb/ref 17592186543821} {:answer/id #uuid "a3810977-df2d-5104-b3e0-f2a4d0401184" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{6}" :db/id #edb/ref 17592186543827} {:answer/id #uuid "f91c3520-3e82-5867-91f7-0be0499e3c49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186543838}] :answer-field/correct {:answer/id #uuid "857a4020-99d9-5010-bea5-959744696366" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{59}{6}" :db/id #edb/ref 17592186543821} :answer-field/id #uuid "4ab8a066-f63f-5bc4-a451-8cc061d5437d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543813}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2a13fd10-2736-5163-8e91-3a139268a2d1" :question/problem "![](images/5e/5e11606627f4b91c977670cf9f919aff8b659cb5b4776cf3d04bb561b50b79fb.png)\n\nSuppose that $F$ is a vector field on ${R}^{2}$ defined over the region $D$ above. Given that \n\n$$\n{∮}_{{C}_{1}}F\\cdot \\text{d}r=- \\frac{17}{2},\\,{∮}_{{C}_{2}}F\\cdot \\text{d}r=- \\frac{19}{3},\\,{∮}_{{C}_{3}}F\\cdot \\text{d}r=\\frac{23}{3},\n$$\n\nwhere ${C}_{1},$ ${C}_{2},$ and ${C}_{3}$ are oriented clockwise, calculate the value of ${∮}_{∂D}F\\cdot \\text{d}r.$" :question/worked-solution "To calculate the total circulation of a vector field over the boundary of a region containing holes, we add together the circulations over each *positively oriented* boundary.\n\nRemember that:\n\n- the positive direction is *counterclockwise* for the *outer* curve ${C}_{1}$ (because the region $D$ is always on the left as we traverse ${C}_{1}$ counterclockwise), and\n\n- the positive direction is *clockwise* for the *inner* curves ${C}_{2}$ and ${C}_{3}$ (because the region $D$ is always on the left as we traverse ${C}_{2}$ and ${C}_{3}$ clockwise).\n\nThe diagram below shows the positive orientations of all three curves.\n\n![](images/fa/fa1022d2a1718627898289abdd4d3035a6e06230eea16d0e46832675b2e37def.png)\n\nNotice that the positive orientation of the outer curve ${C}_{1}$ is opposite that of ${C}_{1}$ as stated in the question.\n\nTherefore, we have\n\n$$\n\\begin{aligned}{∮}_{∂D}F\\cdot \\text{d}r & =-{∮}_{{C}_{1}}F\\cdot \\text{d}r+{∮}_{{C}_{2}}F\\cdot \\text{d}r+{∮}_{{C}_{3}}F\\cdot \\text{d}r \\\\  & =-\\left(- \\frac{17}{2}\\right)+\\left(- \\frac{19}{3}\\right)+\\frac{23}{3} \\\\  & =\\frac{-(-51)+(-38)+46}{6} \\\\  & =\\frac{59}{6}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543825 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02fb5c25-2a44-5658-8d3a-94fee2cfc5f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186543806} {:answer/id #uuid "08456781-dc15-5446-8a0d-a30462b07db6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{37}{3}" :db/id #edb/ref 17592186543809} {:answer/id #uuid "5aa28b88-1b4c-5f38-a927-2f0a3b55f78c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{1}{3}" :db/id #edb/ref 17592186543817} {:answer/id #uuid "73ed4b27-596d-5370-95af-6d3edadf7860" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{20}{3}" :db/id #edb/ref 17592186543818} {:answer/id #uuid "950d0158-2f90-5533-a993-2f44cea84fca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{58}{3}" :db/id #edb/ref 17592186543822}] :answer-field/correct {:answer/id #uuid "5aa28b88-1b4c-5f38-a927-2f0a3b55f78c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{1}{3}" :db/id #edb/ref 17592186543817} :answer-field/id #uuid "10013332-1268-5bf0-abb7-b697ec1223bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543811}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9be43ff2-1cbd-5518-ad47-108fe13ce12b" :question/problem "![](images/5e/5e11606627f4b91c977670cf9f919aff8b659cb5b4776cf3d04bb561b50b79fb.png)\n\nSuppose that $F$ is a vector field on ${R}^{2}$ defined over the region $D$ above. Given that \n\n$$\n{∮}_{{C}_{1}}F\\cdot \\text{d}r=\\frac{19}{3},\\,{∮}_{{C}_{2}}F\\cdot \\text{d}r=- \\frac{7}{2},\\,{∮}_{{C}_{3}}F\\cdot \\text{d}r=\\frac{19}{2},\n$$\n\nwhere ${C}_{1},$ ${C}_{2},$ and ${C}_{3}$ are oriented clockwise, calculate the value of ${∮}_{∂D}F\\cdot \\text{d}r.$" :question/worked-solution "To calculate the total circulation of a vector field over the boundary of a region containing holes, we add together the circulations over each *positively oriented* boundary.\n\nRemember that:\n\n- the positive direction is *counterclockwise* for the *outer* curve ${C}_{1}$ (because the region $D$ is always on the left as we traverse ${C}_{1}$ counterclockwise), and\n\n- the positive direction is *clockwise* for the *inner* curves ${C}_{2}$ and ${C}_{3}$ (because the region $D$ is always on the left as we traverse ${C}_{2}$ and ${C}_{3}$ clockwise).\n\nThe diagram below shows the positive orientations of all three curves.\n\n![](images/fa/fa1022d2a1718627898289abdd4d3035a6e06230eea16d0e46832675b2e37def.png)\n\nNotice that the positive orientation of the outer curve ${C}_{1}$ is opposite that of ${C}_{1}$ as stated in the question.\n\nTherefore, we have\n\n$$\n\\begin{aligned}{∮}_{∂D}F\\cdot \\text{d}r & =-{∮}_{{C}_{1}}F\\cdot \\text{d}r+{∮}_{{C}_{2}}F\\cdot \\text{d}r+{∮}_{{C}_{3}}F\\cdot \\text{d}r \\\\  & =-\\frac{19}{3}+\\left(- \\frac{7}{2}\\right)+\\frac{19}{2} \\\\  & =\\frac{-38+(-21)+57}{6} \\\\  & =- \\frac{1}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186543832 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "545c9291-08a2-5911-a792-6f15761476b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{121}{6}" :db/id #edb/ref 17592186543814} {:answer/id #uuid "7a00a83b-01e3-57a2-a8d3-f075c520f92d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{121}{6}" :db/id #edb/ref 17592186543819} {:answer/id #uuid "a7c85235-d1f2-5afc-ad26-668d508f8d3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{41}{3}" :db/id #edb/ref 17592186543828} {:answer/id #uuid "f84a1e97-fe94-5bb5-9e84-50b64ebd8913" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{89}{6}" :db/id #edb/ref 17592186543