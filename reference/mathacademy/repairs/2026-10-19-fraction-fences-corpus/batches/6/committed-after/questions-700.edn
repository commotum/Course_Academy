ac{2π}{3}\\right) \\\\  & =5\\sqrt{3}\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\frac{15}{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-\\frac{5\\sqrt{3}}{2},\\frac{15}{2}).$"} {:db/id #edb/ref 17592186564636 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83edfaff-4222-5e9e-a519-228b47973acc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186564622}] :answer-field/correct {:answer/id #uuid "83edfaff-4222-5e9e-a519-228b47973acc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186564622} :answer-field/id #uuid "d6834b98-d3c2-5dd4-be0b-fef3999f298b" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186564645} {:answer-field/choices [{:answer/id #uuid "5b4b65ac-05e7-5888-8be4-c434115530bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186564613}] :answer-field/correct {:answer/id #uuid "5b4b65ac-05e7-5888-8be4-c434115530bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186564613} :answer-field/id #uuid "fb46acc9-7536-549f-8767-afd199ad67aa" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186564652}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b868a554-dcd1-5408-a2ec-e25b8176933b" :question/problem "If the distance from a point $P$ to the origin is $1,$ and that $P$ makes an angle of ${240}^{∘}$ with the positive $x$-axis, then the Cartesian coordinates of $P$ are$\\,(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "We notice that the point $P$ is described