d #uuid "4a1309c7-75bf-5265-b6ea-e57718dfa706" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "periodic" :db/id #edb/ref 17592186581152} {:answer/id #uuid "c2ad6e48-88ee-5251-8ed8-888706e62598" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "piecewise continuous" :db/id #edb/ref 17592186581380} {:answer/id #uuid "f939b2ff-9465-574b-9faf-994ac1758cc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "even" :db/id #edb/ref 17592186581491}] :answer-field/correct {:answer/id #uuid "c2ad6e48-88ee-5251-8ed8-888706e62598" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "piecewise continuous" :db/id #edb/ref 17592186581380} :answer-field/id #uuid "8ce8d7c1-d8ae-5b68-8390-c2198e30d6f8" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186581576} {:answer-field/choices [{:answer/id #uuid "0361f822-46d6-502b-b733-c67373e9a909" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{20(-1)^{n}}{{n}^{2}{\\pi }^{2}}" :db/id #edb/ref 17592186581018} {:answer/id #uuid "078931bd-a671-5418-9416-241a94e26433" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{20(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}" :db/id #edb/ref 17592186581026} {:answer/id #uuid "3580ec03-1ac9-5aa3-a10d-d0406902ad66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10(-1)^{n}}{n\\pi }" :db/id #edb/ref 17592186581117} {:answer/id #uuid "a8416396-2dde-5756-8359-ff08fa7b435f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10(-1)^{n+1}}{n\\pi }" :db/id #edb/ref 17592186581333}] :answer-field/correct {:answer/id #uuid "078931bd-a671-5418-9416-241a94e26433" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{20(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}" :db/id #edb/ref 17592186581026} :answer-field/id #uuid "c0b14a0d-814a-58cf-9e41-fe1c1617854c" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186581600}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "290b1a71-81b2-5c9b-ab51-48b39186fee6" :question/math-academy-id "q-343347" :question/problem "Let $f(x)$ be the $4$-periodic extension of the function $F(x)=\\frac{5}{2}x$ defined on $[-2,2).$ Select the correct options in the reasoning below, showing the derivation of a series converging to the $4$-periodic extension of \n\n$$\nG(x)=\\frac{5}{4}{x}^{2}={\\int }_{0}^{x}f(t)\\,\\text{d}t\n$$\n\nfrom the corresponding Fourier series of $f(x).$\n\nThe Fourier series of $f(x)$ is given by\n\n$$\n\\frac{5}{2}x∼{\\sum }_{n=1}^{\\infty }\\frac{10(-1)^{n+1}}{n\\pi }{{field-1}}.\n$$\n\nSince $f$ is \n{{field-2}} \non $R,$ we may integrate its Fourier series term-by-term to get\n\n$$\n\\frac{5}{4}{x}^{2}∼{\\sum }_{n=1}^{\\infty }{{field-3}}\\cdot {{field-4}}.\n$$" :question/worked-solution "First, notice that $F(x)$ is an odd function. So, the Fourier series of its $2L$-periodic extension has the form\n\n$$\n{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{L}).\n$$\n\nIn our case, $L=2$ and we are already given the coefficients ${b}_{n}$ for $n\\ge 1.$ Thus, the Fourier series of $f(x)$ is given by\n\n$$\nf(x)∼{\\sum }_{n=1}^{\\infty }\\frac{10(-1)^{n+1}}{n\\pi }\\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$\n\nNow, notice that the function $F$ is continuous on $(-2,2).$ \nTherefore, the $4$-periodic extension $f$ is $\\text{piecewise continuous}$ on $R,$ so we may integrate its Fourier series term-by-term:\n\n$$\n\\begin{aligned}{\\int }_{0}^{x}\\frac{5}{2}t\\,\\text{d}t & ∼{\\sum }_{n=1}^{\\infty }{\\int }_{0}^{x}\\frac{10(-1)^{n+1}}{n\\pi }\\operatorname{sin}⁡(\\frac{n\\pi t}{2})\\,\\text{d}t \\\\ {[\\frac{5}{4}{t}^{2}]}_{0}^{x} & ∼{\\sum }_{n=1}^{\\infty }\\frac{10(-1)^{n+1}}{n\\pi }\\cdot [-\\frac{2}{n\\pi }\\operatorname{cos}⁡(\\frac{n\\pi t}{2})]_{0}^{x} \\\\ \\frac{5}{4}{x}^{2} & ∼{\\sum }_{n=1}^{\\infty }\\,\\frac{20(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}\\cdot (1-\\operatorname{cos}⁡(\\frac{n\\pi x}{2}))\\end{aligned}\n$$"} {:db/id #edb/ref 17592186581672 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "338c0b94-4f4a-53b1-8323-14c7e18e1734" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186581108} {:answer/id #uuid "48763197-af56-5ae4-8e1f-7e8c48fe69ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186581148} {:answer/id #uuid "68fbd6b6-b5f7-5f08-8e32-9d489f57e8a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186581207} {:answer/id #uuid "bb8bada1-e1ba-5e46-be4a-fcedeaa49f24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186581369} {:answer/id #uuid "c937c9e6-a895-537d-a929-bdec313b1ffe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186581399}] :answer-field/correct {:answer/id #uuid "68fbd6b6-b5f7-5f08-8e32-9d489f57e8a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186581207} :answer-field/id #uuid "4bef1dc8-6541-5678-9235-576392b6112c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186581542}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3d03c4e4-409e-5a6c-9134-c1048c2f9aa9" :question/math-academy-id "q-65538" :question/problem "![](images/cd/cdfb6c65d0b2fb24d6f3928e15abbf0f112e488e749893c4e7d1a5bc4b42ec71.png)\n\nThe graph above shows the function $y=\\operatorname{cot}⁡(Bx)+2,$ where $B$ is a constant. What is the value of $B?$" :question/worked-solution "We can calculate the period $T$ by computing the difference in the $x$-values between two consecutive asymptotes. Therefore,\n\n$$\nT=\\frac{3\\pi }{4}.\n$$\n\nThe formula for the period $T$ of the function $y=A\\operatorname{cot}⁡(Bx+C)+D$ is given by \n\n$$\nT=\\frac{\\pi }{B}.\n$$\n\nApplying the formula of the period, we get\n\n$$\n\\frac{3\\pi }{4}=\\frac{\\pi }{B}\\,⟹\\,B=\\frac{\\pi }{(\\frac{3\\pi }{4})}=\\frac{4}{3}.\n$$\n\nFinally, the equation of the curve is\n\n$$\ny=\\operatorname{cot}⁡(\\frac{4x}{3})+2.\n$$"} {:db/id #edb/ref 17592186581677 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bcd2c0e5-e7a2-5773-b9c4-6980e4b217e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186581371}] :answer-field/correct {:answer/id #uuid "bcd2c0e5-e7a2-5773-b9c4-6980e4b217e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186581371} :answer-field/id #uuid "fc7a075a-30b1-5e46-985d-a663748dd8fc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186581636}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "53c80345-f0e9-5d99-83f6-c8df617065d7" :question/math-academy-id "q-345203" :question/problem "A manufacturer wishes to build a cylindrical tank with a base and a lid. The tank must have an exact volume of $162\\pi \\,{ft}^{3}.$\nTo make the tank, the manufacturer uses two materials:\n\n- a metal sheet that costs $\\$4$ per ${ft}^{2}$ for the lateral surface,\n\n- a metal sheet that costs $\\$1.50$ per ${ft}^{2}$ for the base and lid.\n\nWhat is the radius $r$ of the tank that gives the smallest possible manufacturing cost? Do not round the answer.\n\n$r=$\n{{field-1}} $\\text{ft}$" :question/worked-solution "First, let's draw a picture of a cylinder. Let $r$ be the radius, and $h$ the height.\n\n![](images/b7/b75c35fbf4f40092529a4cef6855b0332ae2461e1c1bb9562d307480b7ff9a63.png)\n\nWe wish to minimize the manufacturing cost. We can express the manufacturing cost $C$ in terms of $r$ and $h$ as follows:\n\n$$\n\\begin{aligned}C & =(2\\pi rh)\\cdot 4+(2\\pi {r}^{2})\\cdot 1.5 \\\\  & =8\\pi rh+3\\pi {r}^{2}\\end{aligned}\n$$\n\nWe know that the volume is fixed at $162\\pi \\,{\\text{ft}}^{3},$ so we also have the constraint condition\n\n$$\n162\\pi =\\pi {r}^{2}h.\n$$\n\nNow, by making $h$ the subject of the constraint equation, we have that\n\n$$\nh=\\frac{162}{{r}^{2}}.\n$$\n\nPlugging the above into our expression for $C,$ we obtain\n\n$$\n\\begin{aligned}C(r) & =8\\pi r(\\frac{162}{{r}^{2}})+3\\pi {r}^{2} \\\\  & =\\frac{1296\\pi }{r}+3\\pi {r}^{2}.\\end{aligned}\n$$\n\nWe want to minimize $C,$ so we need to differentiate $C$ and set the derivative equal to zero. The derivative is \n\n$$\n{C}^{′}(r)=-\\frac{1296\\pi }{{r}^{2}}+6\\pi r.\n$$\n\n \n\nSetting the derivative equal to zero and solving for $r$ gives a stationary point, as follows:\n\n$$\n\\begin{aligned}{C}^{′}(r) & =0 \\\\ -\\frac{1296\\pi }{{r}^{2}}+6\\pi r & =0 \\\\ 6\\pi r & =\\frac{1296\\pi }{{r}^{2}} \\\\ 6\\pi {r}^{3} & =1296\\pi  \\\\ {r}^{3} & =216 \\\\ r & =\\sqrt[3]{216} \\\\  & =6\\end{aligned}\n$$\n\nUsing a calculator, we can verify that if $r<6$ then ${C}^{′}(r)<0,$ and if $r>6$ then ${C}^{′}(r)>0,$ which means that the stationary point $r=6$ is indeed a minimum of $C(r).$\n\nTherefore, the tank with the smallest manufacturing cost has radius $r=6\\,\\text{ft}.$"} {:db/id #edb/ref 17592186581678 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58b86245-ce76-58df-a278-293edafeab31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{3}}" :db/id #edb/ref 17592186581184} {:answer/id #uuid "737397b7-5151-5b08-927a-d3418f41c447" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186581224} {:answer/id #uuid "8858db59-3829-5423-8d4b-02f22572a675" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186581262} {:answer/id #uuid "894565b0-6444-56ee-b687-9aa087d0fe9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186581265} {:answer/id #uuid "8d551fe3-882c-5a08-a749-2068949ddfe3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{3}}" :db/id #edb/ref 17592186581271}] :answer-field/correct {:answer/id #uuid "8858db59-3829-5423-8d4b-02f22572a675" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186581262} :answer-field/id #uuid "4c946144-b19b-5726-bab8-86ae20f0d4a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186581543}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "55f20d1d-e71c-58fc-883e-3fc926f209bd" :question/math-academy-id "q-64935" :question/problem "$\\operatorname{tan}⁡(\\frac{5\\pi }{4})=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{5\\pi }{4}$ corresponds to the point $(-\\frac{\\sqrt{2}}{2},-\\frac{\\sqrt{2}}{2}).$\n\n- Since the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}⁡(\\frac{5\\pi }{4})=-\\frac{\\sqrt{2}}{2}.$\n\n- Since the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}⁡(\\frac{5\\pi }{4})=-\\frac{\\sqrt{2}}{2}.$\n\nTherefore, using the fact that $\\operatorname{tan}⁡\\theta =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta },$ we have\n\n$$\n\\operatorname{tan}⁡(\\frac{5\\pi }{4})=\\frac{\\operatorname{sin}⁡(\\frac{5\\pi }{4})}{\\operatorname{cos}⁡(\\frac{5\\pi }{4})}=\\frac{(-\\frac{\\sqrt{2}}{2})}{(-\\frac{\\sqrt{2}}{2})}=1.\n$$"} {:db/id #edb/ref 17592186581681 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e1ba380-1ed1-5658-8eca-fb53e6edc0cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{48}" :db/id #edb/ref 17592186581065} {:answer/id #uuid "20b2425e-5cb3-539f-aa03-9fddcdb76854" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186581068} {:answer/id #uuid "57846172-7ccc-5606-a4eb-76a43bc93be2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16}{9}" :db/id #edb/ref 17592186581178} {:answer/id #uuid "888e4beb-b73b-5ef4-975d-d3d656fe01af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{9}" :db/id #edb/ref 17592186581263} {:answer/id #uuid "fc12ad82-9f91-56a5-88eb-baadc1786972" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{51}" :db/id #edb/ref 17592186581497}] :answer-field/correct {:answer/id #uuid "1e1ba380-1ed1-5658-8eca-fb53e6edc0cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{48}" :db/id #edb/ref 17592186581065} :answer-field/id #uuid "792ef969-2718-5f5b-951d-bf43cbc24888" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186581568}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5bf58e62-fb33-5cad-aca4-6dac3bc7e21a" :question/math-academy-id "q-90557" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]=\\frac{5}{4},$ compute $\\text{Var}[X].$\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{5}{{x}^{6}},\\, & x\\ge 1, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{1}^{\\infty }{x}^{2}\\cdot \\frac{5}{{x}^{6}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{5}{{x}^{4}}\\,\\text{d}x \\\\  & ={-\\frac{5}{3{x}^{3}}|}_{1}^{\\infty } \\\\  & =\\frac{5}{3}\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{5}{3}-{(\\frac{5}{4})}^{2} \\\\  & =\\frac{5}{48}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186581682 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12c07097-a8ad-58e3-81a2-b3bd102e0ea0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{3}" :db/id #edb/ref 17592186581044} {:answer/id #uuid "35f7fa00-6398-5f16-a737-014c7ccbb609" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{3}" :db/id #edb/ref 17592186581118} {:answer/id #uuid "7570db14-b21d-5bc5-afe9-2ff7be781e1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186581228} {:answer/id #uuid "7f462303-9a2b-575a-bdac-7093da1b773e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8}{3}" :db/id #edb/ref 17592186581244} {:answer/id #uuid "f1aa584f-4951-5d6f-b4f5-a7eaee207485" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186581476}] :answer-field/correct {:answer/id #uuid "7f462303-9a2b-575a-bdac-7093da1b773e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8}{3}" :db/id #edb/ref 17592186581244} :answer-field/id #uuid "44fa185a-5b28-50cb-92b0-78cfca22e38a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186581538}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5e9f6dc7-f768-5950-9b11-2022d886dadb" :question/math-academy-id "q-65717" :question/problem "![](images/04/04eda8326b920778ec2cab1f9d816bfbc248f61c1cce25c96df7d91556e7c661.png)\n\nThe graph above shows the function $y=\\operatorname{csc}⁡(Bx)+D,$ where $B$ and $D$ are constants. What is $B+D?$" :question/worked-solution "The period $T$ of the function is $6\\pi .$\n\nThe formula for the period $T$ of the function $y=A\\operatorname{csc}⁡(Bx+C)+D$ is given by \n\n$$\nT=\\frac{2\\pi }{B}\n$$\n\nApplying the formula of the period, we get:\n\n$$\n6\\pi =\\frac{2\\pi }{B}\\,⟹\\,B=\\frac{2\\pi }{6\\pi }=\\frac{1}{3}\n$$\n\nThe parameter $D$ represents the vertical shift of the cosecant function. Since the local minimum of cosecant is $y=1$, we see that the function has been translated by $3$ units **down**. Hence, $D=-3.$\n\nTherefore, $B+D=\\frac{1}{3}-3=-\\frac{8}{3}.$\n\nFinally, the equation of the curve is:\n\n$$\ny=\\operatorname{csc}⁡(\\frac{x}{3})-3\n$$"} {:db/id #edb/ref 17592186581686 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4691368-4384-5f90-bd58-770657f398eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186581355} {:answer/id #uuid "c4214537-282b-579b-8e5f-63b80c67a335" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186581383} {:answer/id #uuid "c96acaa9-061f-5fe8-a5e6-3edbef00d0e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186581400} {:answer/id #uuid "d35af77e-313e-5bff-a680-e6e88838f4af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186581421} {:answer/id #uuid "eb065623-d9b5-5725-80a4-cbf4801b3a8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186581464}] :answer-field/correct {:answer/id #uuid "eb065623-d9b5-5725-80a4-cbf4801b3a8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186581464} :answer-field/id #uuid "541a84d7-f21d-5ce4-b6d5-630f5d15dc52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186581545}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "69061500-9c1d-53f6-9695-822e827818dc" :question/math-academy-id "q-118164" :question/problem "![](images/10/1033e74f2e2521964e7c58183cc1964c3eb505c2cdabde253afba521e249d1f8.png)\n\nThe graph above shows the function $y=\\operatorname{sec}⁡(\\frac{3x}{4})+D,$ where $D$ is a constant. What is the value of $D?$" :question/worked-solution "The constant $D$ represents a vertical shift of the function $y=\\operatorname{sec}⁡(\\frac{3x}{4}).$\n\nSince the local minimum of secant is $y=1,$ from the graph we see that the given curve is shifted **up** by $4-1=3$ units. So, the equation of the curve is\n\n$$\ny=\\operatorname{sec}⁡(\\frac{3x}{4})+3.\n$$\n\nTherefore, $D=3.$"} {:db/id #edb/ref 17592186581688 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55c3470b-69fe-5c85-84e8-c8feef37ea15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186581174} {:answer/id #uuid "67be038c-e3a8-5639-bd64-942a808eba09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186581205} {:answer/id #uuid "8b582eda-0c4b-5f24-a2f0-9ff532466904" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186581267} {:answer/id #uuid "e36bb105-a8b8-5a38-953a-5156bcb43da0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186581441} {:answer/id #uuid "e45776b3-a9f5-53f5-8d16-ed2121161b97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186581445}] :answer-field/correct {:answer/id #uuid "67be038c-e3a8-5639-bd64-942a808eba09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186581205} :answer-field/id #uuid "bb3df0ab-8802-5e68-96da-9122ea9248a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186581596}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6b298a52-2f73-5db1-8ccf-5add19d7cc62" :question/math-academy-id "q-118195" :question/problem "![](images/c7/c7bd77e8ba912c5ca36f66843d216b928c25222b7b2384190cf03563040f59b6.png)\n\nThe graph above shows the function $y=\\operatorname{csc}⁡(Bx)+\\frac{1}{2},$ where $B$ is a constant. What is the value of $B?$" :question/worked-solution "The period $T$ of the function is\n\n$$\nT=\\frac{\\pi }{2}-(-\\frac{\\pi }{2})=\\pi .\n$$\n\nThe formula for the period $T$ of the function $y=A\\operatorname{csc}⁡(Bx+C)+D$ is given by \n\n$$\nT=\\frac{2\\pi }{B}.\n$$\n\nApplying the formula of the period, we get\n\n$$\n\\pi =\\frac{2\\pi }{B}\\,⟹\\,B=\\frac{2\\pi }{\\pi }=2.\n$$\n\nFinally, the equation of the curve is\n\n$$\ny=\\operatorname{csc}⁡(2x)+\\frac{1}{2}.\n$$"} {:db/id #edb/ref 17592186581691 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a25b1bd-5533-5c1a-b5b6-fe3f1a4a9f34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186581153} {:answer/id #uuid "65aa704e-0920-520a-b596-ab962b304e1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186581203} {:answer/id #uuid "70d6ce5f-7a34-51b7-bd39-be7553df9a92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186581219} {:answer/id #uuid "83f7c7be-0d31-509d-99f7-d0e1f95d1a0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186581250} {:answer/id #uuid "eff95a7a-d02f-5a36-9d02-4d81ff7d907c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186581474}] :answer-field/correct {:answer/id #uuid "70d6ce5f-7a34-51b7-bd39-be7553df9a92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186581219} :answer-field/id #uuid "7054f5a6-500c-5ef7-9788-f7eb947cad64" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186581558}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "72f4603b-2137-504b-82e1-8c9b9e0565cc" :question/math-academy-id "q-117756" :question/problem "![](images/48/481d200ccc2668779f02794c8299934e6706a41b9060365ada1395e6df1b6def.png)\n\nThe graph above shows the function $y=\\operatorname{tan}⁡(\\frac{5x}{2})+D,$ where $D$ is a constant. What is the value of $D?$" :question/worked-solution "The constant $D$ represents a vertical shift of the function $y=\\operatorname{tan}⁡(\\frac{5x}{2}).$\n\nFrom the graph, we see that the given curve is a tangent function that's been shifted **up** by $\\frac{4}{3}$ units. So, the equation of the curve is\n\n$$\ny=\\operatorname{tan}⁡(\\frac{5x}{2})+\\frac{4}{3}.\n$$\n\nTherefore, $D=\\frac{4}{3}.$"} {:db/id #edb/ref 17592186581692 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54d88039-7df7-50d7-81a9-6c2e73d10536" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186581172} {:answer/id #uuid "635f8b75-366e-5b1d-863f-346f4312e0d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186581197} {:answer/id #uuid "6c222504-848b-5d22-b8b8-ca0b23501a12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186581214} {:answer/id #uuid "8d13afc2-112c-5b2b-b3e5-f07c88529195" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186581269} {:answer/id #uuid "e2cb9b1a-9e2d-5aa6-9ce0-b91521e06f44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186581439}] :answer-field/correct {:answer/id #uuid "8d13afc2-112c-5b2b-b3e5-f07c88529195" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186581269} :answer-field/id #uuid "6be2468c-cb0a-5682-b22d-e3c4ae7e4681" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186581556}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "75c9b761-c595-57d5-bbe3-bbe825b0a8e9" :question/math-academy-id "q-65720" :question/problem "![](images/6b/6b0a2cad97efd4d7cbdddfa24850cf83ab7d3994c8b3f3d6795c31242f5d955e.png)\n\nThe graph above shows the function $y=\\operatorname{sec}⁡(Bx)+D,$ where $B$ and $D$ are constants. What is $B+D?$" :question/worked-solution "The period $T$ of the function is \n\n$$\n3\\pi -(-\\pi )=4\\pi .\n$$\n\nThe formula for the period $T$ of the function $y=A\\operatorname{sec}⁡(Bx+C)+D$ is given by \n\n$$\nT=\\frac{2\\pi }{B}.\n$$\n\nApplying the formula of the period, we get:\n\n$$\n4\\pi =\\frac{2\\pi }{B}\\,⟹\\,B=\\frac{2\\pi }{4\\pi }=\\frac{1}{2}\n$$\n\nThe parameter $D$ represents the vertical shift of the secant function. Since the local minimum of secant is $y=1$, we see that the function has been translated by $2$ units **up**. Hence, $D=2.$\n\nTherefore, $B+D=\\frac{1}{2}+2=\\frac{5}{2}.$\n\nFinally, the equation of the curve is:\n\n$$\ny=\\operatorname{sec}⁡(\\frac{x}{2})+2\n$$"} {:db/id #edb/ref 17592186581694 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2622e464-3dff-5477-8605-02e70bffa083" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{52}{3\\ln 3}" :db/id #edb/ref 17592186581079}] :answer-field/correct {:answer/id #uuid "2622e464-3dff-5477-8605-02e70bffa083" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{52}{3\\ln 3}" :db/id #edb/ref 17592186581079} :answer-field/id #uuid "bcd438ee-dce3-5d31-b12a-2590c896eb26" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186581597}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7af4733f-66c2-5243-8fa1-4d5f71535cdf" :question/math-academy-id "q-349627" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{2}2\\cdot {3}^{6-3x}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=6-3x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-3\\,⟹\\,-\\frac{1}{3}\\,\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $1$ | $2$ |\n| --- | --- | --- |\n| $u$ | $3$ | $0$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}2\\cdot {3}^{6-3x}\\,\\text{d}x & ={\\int }_{3}^{0}2\\cdot {3}^{u}(-\\frac{1}{3})\\text{d}u \\\\  & =-\\frac{2}{3}{\\int }_{3}^{0}{3}^{u}\\,\\text{d}u \\\\  & =-\\frac{2}{3}(\\frac{{3}^{u}}{\\operatorname{ln}⁡3}){|}_{3}^{0} \\\\  & =-\\frac{2}{3\\operatorname{ln}⁡3}({3}^{0}-{3}^{3}) \\\\  & =-\\frac{2}{3\\operatorname{ln}⁡3}(1-27) \\\\  & =\\frac{52}{3\\operatorname{ln}⁡3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186581703 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30fd3312-84e5-5ad5-a10f-d03426cf999b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186581104} {:answer/id #uuid "31f9aec3-3896-59e2-bdc4-9dfc2b3dc916" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186581105} {:answer/id #uuid "39a54499-79a9-56b7-bd16-347bff2e16cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186581124} {:answer/id #uuid "4ee7845c-02af-532b-8662-510acfca6112" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186581164} {:answer/id #uuid "68b080f8-df0b-5fef-9cbf-60ac1b4ee67a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186581206}] :answer-field/correct {:answer/id #uuid "30fd3312-84e5-5ad5-a10f-d03426cf999b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186581104} :answer-field/id #uuid "7d1008ca-1e3d-550b-b0ba-d8459d8a746e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186581570}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8e77c853-0f98-527c-9a3c-3514493a0ffc" :question/math-academy-id "q-65671" :question/problem "![](images/e9/e90471633ae015ce56a6493d19b4835e38cb3df8d71b989bfe7b8281eaaec286.png)\n\nThe graph above shows the function $y=\\operatorname{csc}⁡(Bx)+3,$ where $B$ is a constant. What is the value of $B?$" :question/worked-solution "The period $T$ of the function is:\n\n$$\nT=\\frac{5\\pi }{2}-0=\\frac{5\\pi }{2}.\n$$\n\nThe formula for the period $T$ of the function $y=A\\operatorname{csc}⁡(Bx+C)+D$ is given by \n\n$$\nT=\\frac{2\\pi }{B}.\n$$\n\nApplying the formula of the period, we get:\n\n$$\n\\frac{5\\pi }{2}=\\frac{2\\pi }{B}\\,⟹\\,B=\\frac{2\\pi }{(\\frac{5\\pi }{2})}=\\frac{4}{5}\n$$\n\nFinally, the equation of the curve is:\n\n$$\ny=\\operatorname{csc}⁡(\\frac{4}{5}x)+3\n$$"} {:db/id #edb/ref 17592186581710 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bc9274d-2453-59de-9374-593056c5f0db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{60(-1)^{n+1}}{n\\pi }" :db/id #edb/ref 17592186581031} {:answer/id #uuid "0dc99f13-3f43-5357-ae7d-44cad469294a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{60(-1)^{n}}{n\\pi }" :db/id #edb/ref 17592186581035} {:answer/id #uuid "b18fca8c-d04b-57db-8805-63886500b542" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{180(-1)^{n+1}}{{n}^