[{:db/id #edb/ref 17592186578152 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63c522d2-4612-59ce-9ad5-4548baa95ce2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{2}(\\frac{1}{4}) = 16" :db/id #edb/ref 17592186578136} {:answer/id #uuid "99a7301f-f67f-5efe-9bab-877899c9168e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{16}(2) = \\frac{1}{4}" :db/id #edb/ref 17592186578144} {:answer/id #uuid "b5ecf327-6d41-5b20-a247-c7a8e56b14f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{\\frac{1}{4}}(2) = 16" :db/id #edb/ref 17592186578147} {:answer/id #uuid "da32acf1-f672-5aa1-b420-050992f76220" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{16}(\\frac{1}{4}) = 2" :db/id #edb/ref 17592186578154} {:answer/id #uuid "dd564f1f-31f9-5f10-9a1f-6af3cb94a84e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{2}(16) = \\frac{1}{4}" :db/id #edb/ref 17592186578155}] :answer-field/correct {:answer/id #uuid "99a7301f-f67f-5efe-9bab-877899c9168e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{16}(2) = \\frac{1}{4}" :db/id #edb/ref 17592186578144} :answer-field/id #uuid "5b5f1479-fa4c-52fa-aae4-519a232a528f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578133}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d5ae6c39-8693-553b-8e20-55441e09af49" :question/problem "$\\sqrt[4]{16} = 2$ is equivalent to" :question/worked-solution "Notice that the given equation can be written using exponents as follows:\n\n$$\n16^{1/4} = 2\n$$\n\nThe logarithm of $a$ with base $b$ is defined as follows:\n\n$a=b^x$ is equivalent to $\\log_b(a)=x$\n\nIf we compare $16^{1/4} = 2$ with $a=b^x$, we get $a=2$, $b=16$, and $x=\\frac{1}{4}$.\n\nTherefore, the equation $\\sqrt[4]{16} = 2$ is equivalent to $\\log_{16}(2) = \\frac{1}{4}$."} {:db/id #edb/ref 17592186578159 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "794b1256-0632-5b3a-b63d-f2fb2d41c4db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{\\frac{1}{2}}(2) = 4" :db/id #edb/ref 17592186578138} {:answer/id #uuid "abd9f5d2-089e-514d-abfa-09f1186ee2fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{2}(4) = \\frac{1}{2}" :db/id #edb/ref 17592186578145} {:answer/id #uuid "af57efff-9710-572d-bd32-5adc89ec2b28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{\\frac{1}{2}}(4) = 2" :db/id #edb/ref 17592186578146} {:answer/id #uuid "c9d02272-d636-59f1-b7dc-13ce97b6b349" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{4}(\\frac{1}{2}) = 2" :db/id #edb/ref 17592186578149} {:answer/id #uuid "e944426a-20a5-5c44-aa56-3a497c8214b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{4}(2) = \\frac{1}{2}" :db/id #edb/ref 17592186578156}] :answer-field/correct {:answer/id #uuid "e944426a-20a5-5c44-aa56-3a497c8214b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{4}(2) = \\frac{1}{2}" :db/id #edb/ref 17592186578156} :answer-field/id #uuid "29fd7311-bfb6-572d-a1c8-1a566d7f4202" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578128}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fd867eb5-198e-5f11-80c2-685d3d0d3cae" :question/problem "$\\sqrt{4} = 2$ is equivalent to" :question/worked-solution "Notice that the given equation can be written using exponents as follows:\n\n$$\n4^{1/2} = 2\n$$\n\nThe logarithm of $a$ with base $b$ is defined as follows:\n\n$a=b^x$ is equivalent to $\\log_b(a)=x$\n\nIf we compare $4^{1/2} = 2$ with $a=b^x$, we get $a=2$, $b=4$, and $x=\\frac{1}{2}$.\n\nTherefore, the equation $\\sqrt{4} = 2$ is equivalent to $\\log_{4}(2) = \\frac{1}{2}$."} {:db/id #edb/ref 17592186578795 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87c35db5-2008-5dbd-afde-054aac1ff46a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡\\theta =-\\frac{3}{4}" :db/id #edb/ref 17592186578485} {:answer/id #uuid "89528332-60a7-50a6-aae0-62197a6a399c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡\\theta =-\\frac{5}{7}" :db/id #edb/ref 17592186578488} {:answer/id #uuid "cdd757c7-3b04-5a03-a710-bf666e048b29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡\\theta =\\frac{3}{5}" :db/id #edb/ref 17592186578595} {:answer/id #uuid "cea07d9b-f74a-524a-b08f-3e3aadb27338" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡\\theta =-\\frac{4}{7}" :db/id #edb/ref 17592186578596} {:answer/id #uuid "d0657123-7a09-5b4d-b51a-03a6d7445550" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡\\theta =\\frac{2}{5}" :db/id #edb/ref 17592186578598}] :answer-field/correct {:answer/id #uuid "87c35db5-2008-5dbd-afde-054aac1ff46a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡\\theta =-\\frac{3}{4}" :db/id #edb/ref 17592186578485} :answer-field/id #uuid "0f7fcedc-c163-5f81-978f-4e684776d889" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578687}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0d53e0c0-130a-597e-9eae-4500f595f886" :question/math-academy-id "q-85639" :question/problem "![](images/c2/c27074480ce1627c5f5c54596b9adaea1800bcd657a7a392c71be86b27949424.png)\n\nThe diagram above shows the unit circle. Given that $\\operatorname{sin}⁡\\theta =\\frac{4}{5},$ what is the value of $\\operatorname{cot}⁡\\theta ?$" :question/worked-solution "![](images/57/574143239dacf6a0eb11307826c62db531384aa03b9c0f4bade4d77c66499c23.png)\n\nWe can use the Pythagorean identity to find $\\operatorname{cos}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ \\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{sin}⁡\\theta =\\frac{4}{5}$ gives\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{4}{5})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{16}{25}} \\\\  & =\\pm \\sqrt{\\frac{9}{25}} \\\\  & =\\pm \\frac{3}{5}.\\end{aligned}\n$$\n\nWe select the negative answer since $\\operatorname{cos}⁡\\theta$ is negative in the second quadrant. So, $\\operatorname{cos}⁡\\theta =-\\frac{3}{5}.$\n\nFinally, knowing that $\\operatorname{cot}⁡\\theta =\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta },$ we have\n\n$$\n\\operatorname{cot}⁡\\theta =\\frac{(-\\frac{3}{5})}{(\\frac{4}{5})}=-\\frac{3}{4}.\n$$"} {:db/id #edb/ref 17592186578800 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02586119-71be-5aa8-b399-e820d3f3c609" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186578276} {:answer/id #uuid "9f328edd-5cef-5843-b812-5017a9d8679d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186578523} {:answer/id #uuid "a56dc459-8849-5b41-915a-0ec8333886c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186578531} {:answer/id #uuid "a899ebb2-c6bf-5cff-b840-d5e06befd72a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186578540} {:answer/id #uuid "cb513520-510e-5fbc-ae91-42c36c608b89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186578588}] :answer-field/correct {:answer/id #uuid "a56dc459-8849-5b41-915a-0ec8333886c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186578531} :answer-field/id #uuid "83fb8046-36a6-54cd-bf21-1210cc3f4ccf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578736}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "17db8653-72df-5afe-a4b6-7065bd849c60" :question/math-academy-id "q-103144" :question/problem "Find the value of $\\operatorname{cot}⁡(\\frac{9\\pi }{2}).$" :question/worked-solution "First, we find an angle that's coterminal with $\\frac{9\\pi }{2}$ that lies in the range $[0,2\\pi ).$\n\n$$\n\\begin{aligned}\\frac{9\\pi }{2}-2\\pi  & =\\frac{5\\pi }{2} \\\\ \\frac{5\\pi }{2}-2\\pi  & =\\frac{\\pi }{2}\\,✓\\end{aligned}\n$$\n\nTherefore, $\\operatorname{cot}⁡(\\frac{\\pi }{2})=\\operatorname{cot}⁡(\\frac{9\\pi }{2}).$\n\nThe angle ${90}^{∘}$ is a quadrantal angle. Let's draw out the quadrantal angles on the unit circle.\n\n![](images/79/792a778286533d589a3410223aaf197b07e64ea77566042d7bb8ac13fbad9768.png)\n\nFrom the unit circle, we see that the angle $\\frac{\\pi }{2}$ corresponds to the point $(0,1).$\n\n- Since the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}⁡(\\frac{\\pi }{2})=0.$\n\n- Since the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}⁡(\\frac{\\pi }{2})=1.$\n\nTherefore, using the fact that $\\operatorname{cot}⁡\\theta =\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta },$ we have\n\n$$\n\\operatorname{cot}⁡(\\frac{\\pi }{2})=\\frac{\\operatorname{cos}⁡(\\frac{\\pi }{2})}{\\operatorname{sin}⁡(\\frac{\\pi }{2})}=\\frac{0}{1}=0.\n$$\n\nTherefore, $\\operatorname{cot}⁡(\\frac{9\\pi }{2})=0.$"} {:db/id #edb/ref 17592186578802 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "389a5696-c840-56e0-8558-733de5240472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186578361} {:answer/id #uuid "4017febd-50d6-5503-af7a-ff948aace873" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{4}" :db/id #edb/ref 17592186578378} {:answer/id #uuid "98cc3f2f-f840-5de8-acdb-83f201a4880d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186578515} {:answer/id #uuid "aaab6afb-3ab3-5a9f-849c-a2ad0e12fb8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{7}" :db/id #edb/ref 17592186578543} {:answer/id #uuid "f37683f8-f240-5221-9235-386d2ba6e331" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186578662}] :answer-field/correct {:answer/id #uuid "389a5696-c840-56e0-8558-733de5240472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186578361} :answer-field/id #uuid "ce157c42-a9a4-5ec7-af0b-682ed5561091" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578768}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "20010f38-3e5e-5e3e-a89d-c3c51d40861a" :question/math-academy-id "q-20989" :question/problem "![](images/0b/0bd043f0ff9b6cc575d7912776bd0aaa41dc161b32304115cf6c8dedba86f81a.png)\n\nFor the parametric curve (shown above)\n\n$$\nx=3\\operatorname{sin}⁡2t,\\,y=4\\operatorname{cos}⁡2t,\\,0\\le t<2\\pi ,\n$$\n\n find the derivative $\\frac{dy}{dx}$ at the point $P$ on the curve where $t=\\frac{\\pi }{8}.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=6\\operatorname{cos}⁡2t,\\,{y}^{′}(t)=-8\\operatorname{sin}⁡2t.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{-8\\operatorname{sin}⁡2t}{6\\operatorname{cos}⁡2t}=-\\frac{4}{3}\\operatorname{tan}⁡2t.\n$$\n\nAt the point where $t=\\frac{\\pi }{8}$ we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =-\\,\\frac{4}{3}\\cdot \\operatorname{tan}⁡(2\\cdot \\frac{\\pi }{8}) \\\\  & =-\\,\\frac{4}{3}\\cdot \\operatorname{tan}⁡(\\frac{\\pi }{4}) \\\\  & =-\\,\\frac{4}{3}\\cdot 1 \\\\  & =-\\,\\frac{4}{3}\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186578803 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52305d0f-2d94-5433-b04b-fbcb2e2da01d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡\\theta =-\\frac{\\sqrt{17}}{8}" :db/id #edb/ref 17592186578401} {:answer/id #uuid "a4770bae-6ba8-5802-bd0c-756997c15415" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡\\theta =\\frac{\\sqrt{17}}{8}" :db/id #edb/ref 17592186578529} {:answer/id #uuid "c2449dff-2ed5-55e8-bb8a-7583e96127a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡\\theta =-\\frac{2\\sqrt{13}}{3}" :db/id #edb/ref 17592186578573} {:answer/id #uuid "c5dcec46-aaea-508d-b487-98620556bbc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡\\theta =-\\frac{\\sqrt{15}}{4}" :db/id #edb/ref 17592186578577} {:answer/id #uuid "fd782cf0-d10b-509b-a11e-abbbc730bc24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡\\theta =\\frac{\\sqrt{15}}{4}" :db/id #edb/ref 17592186578680}] :answer-field/correct {:answer/id #uuid "52305d0f-2d94-5433-b04b-fbcb2e2da01d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡\\theta =-\\frac{\\sqrt{17}}{8}" :db/id #edb/ref 17592186578401} :answer-field/id #uuid "f8549c61-6952-565e-a79d-86243d8c0224" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578782}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2086b542-4ce0-5886-ad07-2a2bb6e42c3a" :question/math-academy-id "q-124968" :question/problem "![](images/df/df379135e9123fe9f0c3a1e03fce4898f153e321c3bd33229f3bd1c68b6249cc.png)\n\nThe diagram above shows the unit circle. Given that $\\operatorname{cos}⁡\\theta =\\frac{8}{9},$ what is the value of $\\operatorname{tan}⁡\\theta ?$" :question/worked-solution "![](images/1c/1cb6ef37aaaf228273ee44de5c6fb07a59f4e6f334702b2be1425b5988705855.png)\n\nWe can use the Pythagorean identity to find $\\operatorname{sin}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ \\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{cos}⁡\\theta =\\frac{8}{9}$ gives\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{8}{9})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{64}{81}} \\\\  & =\\pm \\sqrt{\\frac{17}{81}} \\\\  & =\\pm \\frac{\\sqrt{17}}{9}.\\end{aligned}\n$$\n\nWe select the negative answer since $\\operatorname{sin}⁡\\theta$ is negative in the fourth quadrant. So, $\\operatorname{sin}⁡\\theta =-\\frac{\\sqrt{17}}{9}.$\n\nFinally, knowing that $\\operatorname{tan}⁡\\theta =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta },$ we have\n\n$$\n\\operatorname{tan}⁡\\theta =\\frac{(-\\frac{\\sqrt{17}}{9})}{(\\frac{8}{9})}=-\\frac{\\sqrt{17}}{8}.\n$$"} {:db/id #edb/ref 17592186578804 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16e9c511-8886-5f56-8ee7-6556baca60f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186578309} {:answer/id #uuid "2ef85eba-7368-57c1-8685-8d542b3d4d4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\,\\frac{1}{\\pi +1}" :db/id #edb/ref 17592186578345} {:answer/id #uuid "9f3946a4-4840-5c17-bc49-b6cd5ef2faaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\,\\frac{1}{3\\pi +1}" :db/id #edb/ref 17592186578524} {:answer/id #uuid "e0c0fa7e-1c3b-5c73-8f6c-dd538719b8ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186578631} {:answer/id #uuid "f30dcc98-6482-51c6-8828-44cf84a10887" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\,\\frac{3}{\\pi }" :db/id #edb/ref 17592186578659}] :answer-field/correct {:answer/id #uuid "e0c0fa7e-1c3b-5c73-8f6c-dd538719b8ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186578631} :answer-field/id #uuid "3bfbeb97-b5a7-5edb-811c-c6fd832edf47" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578710}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "21abfc2b-1c65-57da-8fcf-53cc0cb791f0" :question/math-academy-id "q-6840" :question/problem "For the parametric curve \n\n$$\nx=t\\operatorname{sin}⁡t,\\,y=3\\operatorname{cos}⁡t,\\,-\\infty <t<\\infty ,\n$$\n\n find the derivative $\\frac{dy}{dx}$ at the point $P$ on the curve where $t=\\frac{\\pi }{2}.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=t\\operatorname{cos}⁡t+\\operatorname{sin}⁡t,\\,{y}^{′}(t)=-3\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{-3\\operatorname{sin}⁡t}{t\\operatorname{cos}⁡t+\\operatorname{sin}⁡t}=-\\frac{3}{t\\operatorname{cot}⁡t+1}.\n$$\n\nAt the point where $t=\\frac{\\pi }{2}$ we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =-\\,\\frac{3}{(\\frac{\\pi }{2})\\operatorname{cot}⁡\\frac{\\pi }{2}+1} \\\\  & =-\\,\\frac{3}{(\\frac{\\pi }{2})\\cdot 0+1} \\\\  & =-\\,3\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186578812 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10346f23-0101-5358-9519-35c89dd53f72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186578299} {:answer/id #uuid "390c3982-5f08-5df4-9419-1af7d9155284" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}+1" :db/id #edb/ref 17592186578362} {:answer/id #uuid "527341ed-fd05-5c3e-a2b4-4b5180a375a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186578402} {:answer/id #uuid "d3125639-78db-54c6-9919-bde775ed99dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186578601} {:answer/id #uuid "fe0bc71c-fb20-51d7-bf89-57a0e9d0fd4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186578681}] :answer-field/correct {:answer/id #uuid "390c3982-5f08-5df4-9419-1af7d9155284" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}+1" :db/id #edb/ref 17592186578362} :answer-field/id #uuid "cb3cc15d-02b4-568e-9ece-4c12ccf4570a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578766}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2b78c4ee-f2f9-5e8b-ac11-248a23933307" :question/math-academy-id "q-1674" :question/problem "$\\operatorname{sec}⁡(\\frac{\\pi }{4})+\\operatorname{cot}⁡(\\frac{\\pi }{4})=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nLet's consider the angle $\\frac{\\pi }{4}.$ From the unit circle, we see that the angle $\\frac{\\pi }{4}$ corresponds to the point $(\\frac{\\sqrt{2}}{2},\\frac{\\sqrt{2}}{2}).$ Since the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}⁡(\\frac{\\pi }{4})=\\frac{\\sqrt{2}}{2}.$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}⁡(\\frac{\\pi }{4})=\\frac{\\sqrt{2}}{2}.$ \n\nUsing the fact that $\\operatorname{sec}⁡\\theta =\\frac{1}{\\operatorname{cos}⁡\\theta }$ and $\\operatorname{cot}⁡\\theta =\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta },$ we have\n\n$$\n\\begin{aligned}\\operatorname{sec}⁡(\\frac{\\pi }{4}) & =\\frac{1}{\\operatorname{cos}⁡(\\frac{\\pi }{4})}=\\frac{1}{(\\frac{\\sqrt{2}}{2})}=\\sqrt{2}, \\\\ \\operatorname{cot}⁡(\\frac{\\pi }{4}) & =\\frac{\\operatorname{cos}⁡(\\frac{\\pi }{4})}{\\operatorname{sin}⁡(\\frac{\\pi }{4})}=\\frac{(\\frac{\\sqrt{2}}{2})}{(\\frac{\\sqrt{2}}{2})}=1.\\end{aligned}\n$$\n\nFinally, we combine the results:\n\n$$\n\\operatorname{sec}⁡(\\frac{\\pi }{4})+\\operatorname{cot}⁡(\\frac{\\pi }{4})=\\sqrt{2}+1.\n$$"} {:db/id #edb/ref 17592186578815 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47721bcb-3d8f-5a12-bcc0-33a4f7d37a4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\theta =-\\frac{1}{4}" :db/id #edb/ref 17592186578388} {:answer/id #uuid "60678c6c-34f6-521e-974a-d64948890b74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\theta =-\\frac{3}{4}" :db/id #edb/ref 17592186578430} {:answer/id #uuid "92360fb5-afe5-5be2-afa8-7466435ca264" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\theta =\\frac{1}{4}" :db/id #edb/ref 17592186578507} {:answer/id #uuid "a8ad6c0e-f793-5edd-90c4-0ee7b8553e5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\theta =\\frac{3}{4}" :db/id #edb/ref 17592186578541} {:answer/id #uuid "d5e88346-21b3-5083-aad1-974d8b1176d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\theta =\\frac{4}{9}" :db/id #edb/ref 17592186578606}] :answer-field/correct {:answer/id #uuid "60678c6c-34f6-521e-974a-d64948890b74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\theta =-\\frac{3}{4}" :db/id #edb/ref 17592186578430} :answer-field/id #uuid "23045511-0482-5a00-b7af-8abfa60c5680" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578699}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "336f4f03-57a6-57dc-92a1-f56dac8b2445" :question/math-academy-id "q-124833" :question/problem "![](images/97/978383201236edb0e33057b15f0521b4547bac94a7913abba604ef1e176dc8b3.png)\n\nThe diagram above shows the unit circle. Given that $\\operatorname{sin}⁡\\theta =\\frac{\\sqrt{7}}{4},$ what is the value of $\\operatorname{cos}⁡\\theta ?$" :question/worked-solution "![](images/8b/8b37120c20c5b9c6f07337add093d2e582d70f6f5ba2fc1b417b1ed562920173.png)\n\nWe can use the Pythagorean identity to find $\\operatorname{cos}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ \\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{sin}⁡\\theta =\\frac{\\sqrt{7}}{4}$ gives\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{\\sqrt{7}}{4})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{7}{16}} \\\\  & =\\pm \\sqrt{\\frac{9}{16}} \\\\  & =\\pm \\frac{3}{4}.\\end{aligned}\n$$\n\nWe select the negative answer since $\\operatorname{cos}⁡\\theta$ is negative in the second quadrant. So, $\\operatorname{cos}⁡\\theta =-\\frac{3}{4}.$"} {:db/id #edb/ref 17592186578818 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f2b35f3-d886-5c54-a151-e8d5934eab23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{3\\sqrt{6}}{5}" :db/id #edb/ref 17592186578347} {:answer/id #uuid "60643ae6-c1c1-54cb-b6a5-b7b4b55166dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{2}{7}" :db/id #edb/ref 17592186578429} {:answer/id #uuid "63e5c95a-8586-50f1-b629-8de35c055a04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{2}{7}" :db/id #edb/ref 17592186578435} {:answer/id #uuid "8bac3b6b-cbce-58bf-9b70-ee9502dfbc6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{2\\sqrt{6}}{7}" :db/id #edb/ref 17592186578493} {:answer/id #uuid "db6a37ce-de59-5b67-9bef-6c00c0d8b028" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{2\\sqrt{6}}{7}" :db/id #edb/ref 17592186578620}] :answer-field/correct {:answer/id #uuid "db6a37ce-de59-5b67-9bef-6c00c0d8b028" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{2\\sqrt{6}}{7}" :db/id #edb/ref 17592186578620} :answer-field/id #uuid "0988bf43-8be2-598d-b9b8-92f8fe65a777" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578685}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "37f818fc-6d32-5594-93f9-04ec549a0621" :question/math-academy-id "q-124810" :question/problem "The point $P$ is located in the second quadrant and lies on the unit circle. The $y$-coordinate of $P$ is $\\frac{5}{7}.$ What is the $x$-coordinate of $P?$" :question/worked-solution "Since the point $P$ lies on the unit circle, it must satisfy the Pythagorean theorem: \n\n$$\n{x}^{2}+{y}^{2}=1\n$$\n\nSubstituting $y=\\frac{5}{7}$ into the above and solving for $x$ gives\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =1 \\\\ {x}^{2}+{(\\frac{5}{7})}^{2} & =1 \\\\ {x}^{2}+(\\frac{25}{49}) & =1 \\\\ {x}^{2} & =1-\\frac{25}{49} \\\\ {x}^{2} & =\\frac{24}{49} \\\\ x & =\\pm \\sqrt{\\frac{24}{49}} \\\\ x & =\\pm \\frac{2\\sqrt{6}}{7}.\\end{aligned}\n$$\n\nFinally, we select the negative answer since $x$ is negative in the second quadrant. So our final answer is $x=-\\frac{2\\sqrt{6}}{7}.$"} {:db/id #edb/ref 17592186578832 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0938a141-d12b-51e1-9998-a7cc436edc0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(x+1)+\\frac{1}{x+1}" :db/id #edb/ref 17592186578288} {:answer/id #uuid "27fa3f4c-12dc-5dbf-874a-1e6639271800" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\operatorname{ln}⁡(x+1)+\\frac{x}{x+1}" :db/id #edb/ref 17592186578336} {:answer/id #uuid "45b25f33-bf7f-5def-955e-d497d26f5e74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(x+1)+(x+1)" :db/id #edb/ref 17592186578384} {:answer/id #uuid "47dee097-bdf3-5c60-8d1d-d16d58555770" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(x+1)+\\frac{x}{x+1}" :db/id #edb/ref 17592186578389} {:answer/id #uuid "c9028022-51bc-53f4-aee2-72790be92141" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\operatorname{ln}⁡(x+1)+\\frac{1}{x+1}" :db/id #edb/ref 17592186578585}] :answer-field/correct {:answer/id #uuid "47dee097-bdf3-5c60-8d1d-d16d58555770" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(x+1)+\\frac{x}{x+1}" :db/id #edb/ref 17592186578389} :answer-field/id #uuid "0ef58acd-fd9a-5753-af67-91bee6f1e34f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578686}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "661f8f17-e856-564e-ad3f-b602958b65c7" :question/math-academy-id "q-11938" :question/problem "Given that $y=x\\operatorname{ln}⁡(x+1)$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "This question requires the product rule. Let $u(x)=x$ and $v(x)=\\operatorname{ln}⁡(x+1).$ Then\n\n$$\n{u}^{′}(x)=1,\\,{v}^{′}(x)=\\frac{1}{x+1}.\n$$\n\nNote that we used the chain rule to differentiate $v.$\n\nNow, applying the product rule and simplifying, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(1)(\\operatorname{ln}⁡(x+1))+(x)(\\frac{1}{x+1}) \\\\  & =\\operatorname{ln}⁡(x+1)+\\frac{x}{x+1}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186578833 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01c722ff-e1b8-5a52-af6d-46d7d47770f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{csc}⁡2" :db/id #edb/ref 17592186578275} {:answer/id #uuid "638ce517-cf18-5e4a-9cb3-d4f7d60d0039" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡3(4-3\\operatorname{csc}⁡3\\operatorname{cot}⁡3)" :db/id #edb/ref 17592186578434} {:answer/id #uuid "771e64c9-e943-52fe-945f-1eea480889b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{csc}^{2}⁡2\\operatorname{cot}⁡2)" :db/id #edb/ref 17592186578459} {:answer/id #uuid "b5d1c180-4dd3-51bf-b383-ca38bfcc7a07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡2(4+3\\operatorname{csc}⁡2\\operatorname{cot}⁡2)" :db/id #edb/ref 17592186578555} {:answer/id #uuid "f2c9181f-174f-587d-914d-0780f3a3d35a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡2(4-3\\operatorname{cot}⁡2)" :db/id #edb/ref 17592186578658}] :answer-field/correct {:answer/id #uuid "f2c9181f-174f-587d-914d-0780f3a3d35a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡2(4-3\\operatorname{cot}⁡2)" :db/id #edb/ref 17592186578658} :answer-field/id #uuid "c3ecdc8b-e818-5576-b257-904854acad1b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578763}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6650c0b4-dbaf-54fa-bdff-16ce8ac264e7" :question/math-academy-id "q-31359" :question/problem "Find the slope of $f(x)={x}^{4}\\operatorname{csc}⁡(3x-1)$ at $x=1.$" :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}f}{\\text{d}x}$ at that point.\n\nThis question requires the product rule. Let $u(x)={x}^{4}$ and $v(x)=\\operatorname{csc}⁡(3x-1).$ Then\n\n$$\n{u}^{′}(x)=4{x}^{3},\\,{v}^{′}(x)=-3\\operatorname{csc}⁡(3x-1)\\operatorname{cot}⁡(3x-1).\n$$\n\nNote that we used the chain rule to differentiate $v.$\n\nNow, applying the product rule and simplifying, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(4{x}^{3})(\\operatorname{csc}⁡(3x-1))+({x}^{4})(-3\\operatorname{csc}⁡(3x-1)\\operatorname{cot}⁡(3x-1)) \\\\  & =4{x}^{3}\\operatorname{csc}⁡(3x-1)-3{x}^{4}\\operatorname{csc}⁡(3x-1)\\operatorname{cot}⁡(3x-1) \\\\  & ={x}^{3}\\operatorname{csc}⁡(3x-1)(4-3x\\operatorname{cot}⁡(3x-1)).\\end{aligned}\n$$\n\nTherefore, the slope at $x=1$ is\n\n$$\n\\begin{aligned}{(\\frac{\\text{d}f}{\\text{d}x})|}_{x=1} & =(1)^{3}\\operatorname{csc}⁡(3(1)-1)(4-3(1)\\operatorname{cot}⁡(3(1)-1)) \\\\  & =\\operatorname{csc}⁡2(4-3\\operatorname{cot}⁡2).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186578835 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17209926-bbeb-5eac-83bc-49f7341ac4e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[9,\\infty )" :db/id #edb/ref 17592186578310} {:answer/id #uuid "7621c886-17c5-53da-ad1b-817216429049" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-9,\\infty )" :db/id #edb/ref 17592186578458} {:answer/id #uuid "9a4b7c93-b462-5bc0-ba7c-435803992578" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,\\frac{9}{2}]" :db/id #edb/ref 17592186578517} {:answer/id #uuid "c1176870-903e-5a26-ab27-2b891f377850" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,-9]" :db/id #edb/ref 17592186578572} {:answer/id #uuid "da77021a-bceb-532a-a073-05a140340109" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,9]" :db/id #edb/ref 17592186578618}] :answer-field/correct {:answer/id #uuid "da77021a-bceb-532a-a073-05a140340109" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,9]" :db/id #edb/ref 17592186578618} :answer-field/id #uuid "27f1f3fe-7cc9-517f-8e81-f601638bcf50" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578702}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "696aa9f5-c58d-5b74-b314-032b710e1070" :question/math-academy-id "q-52485" :question/problem "What is the range of the function $f(x)=-4(x+1)(x-2)?$" :question/worked-solution "The given parabola is written in factored form,\n\n$$\ny=a(x-{x}_{1})(x-{x}_{2}),\n$$\n\nwith $a=-4<0.$ \n\nBecause the leading coefficient is negative, the parabola opens downward. Consequently, there is no minimum output, and the vertex corresponds to the maximum output.\n\nThe two roots of the parabola are ${x}_{1}=-1$ and ${x}_{2}=2,$ and we can find the $x$-coordinate of the vertex by taking the average of the roots:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2}=\\frac{-1+2}{2}=\\frac{1}{2}\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{1}{2}$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & =-4(x+1)(x-2) \\\\  & =-4(\\frac{1}{2}+1)(\\frac{1}{2}-2) \\\\  & =-4\\cdot \\frac{3}{2}\\cdot (-\\frac{3}{2}) \\\\  & =9\\end{aligned}\n$$\n\nTherefore, the vertex is $(\\frac{1}{2},9),$ and the range of the function is $(-\\infty ,9].$\n\n![](images/b4/b45df69ab8780eabce5b57a30cf7448a011361e18e28989249e1eca439b17028.png)"} {:db/id #edb/ref 17592186578842 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c712774a-c1bc-5ca0-b374-7906f054c294" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sin^2 x}" :db/id #edb/ref 17592186578579}] :answer-field/correct {:answer/id #uuid "c712774a-c1bc-5ca0-b374-7906f054c294" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sin^2 x}" :db/id #edb/ref 17592186578579} :answer-field/id #uuid "4a3b451a-2a50-5d61-ab5a-17f181f52c94" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186578715}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7a7e1449-9e66-5cab-bc6e-62dcc6353f1c" :question/math-academy-id "q-167318" :question/problem "$\\frac{\\text{d}}{\\text{d}x}(\\frac{f}{\\operatorname{sin}⁡x})\\,=${{field-1}}" :question/worked-solution "Recall that $f(x)=2\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x.$\n\nWe apply the quotient rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{f}{\\operatorname{sin}⁡x}) & =\\frac{{f}^{′}(x)\\cdot (\\operatorname{sin}⁡x)-f(x)\\cdot (\\operatorname{sin}⁡x)^{′}}{(\\operatorname{sin}⁡x)^{2}} \\\\  & =\\frac{(2\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x)^{′}\\cdot (\\operatorname{sin}⁡x)-(2\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x)\\cdot (\\operatorname{sin}⁡x)^{′}}{{sin}^{2}⁡x} \\\\  & =\\frac{(2\\operatorname{cos}⁡x-3\\operatorname{sin}⁡x)\\cdot \\operatorname{sin}⁡x-(2\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x)\\cdot \\operatorname{cos}⁡x}{{sin}^{2}⁡x} \\\\  & =\\frac{\\cancel{2\\operatorname{cos}⁡x\\operatorname{sin}⁡x}-3{sin}^{2}⁡x\\cancel{-2\\operatorname{sin}⁡x\\operatorname{cos}⁡x}-3{cos}^{2}⁡x}{{sin}^{2}⁡x} \\\\  & =\\frac{-3({sin}^{2}⁡x+{cos}^{2}⁡x)}{{sin}^{2}⁡x} \\\\  & =-\\frac{3}{{sin}^{2}⁡x}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186578850 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "78ad4bc9-fbbe-5928-a45e-a9dc5017529d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186578461} {:answer/id #uuid "8e2d373f-505c-5335-8e64-76b8eb295d80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186578501} {:answer/id #uuid "be71c86d-3b9c-534c-a34b-4b6da4e2d78b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186578567} {:answer/id #uuid "cc9e04a0-d2bc-5da6-a08f-b95e6df71427" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186578590} {:answer/id #uuid "d9b50275-efc4-5f5a-9e1f-741741a7800e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186578615}] :answer-field/correct {:answer/id #uuid "be71c86d-3b9c-534c-a34b-4b6da4e2d78b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186578567} :answer-field/id #uuid "3aaa1f21-66b6-5f2f-a870-f2d386417dc9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578709}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8613cddf-5858-574b-9d8b-91be11b8ce7b" :question/math-academy-id "q-85510" :question/problem "Find the value of $\\operatorname{sin}⁡(\\frac{11\\pi }{2}).$" :question/worked-solution "First, we find an angle that's coterminal with $\\frac{11\\pi }{2}$ that lies in the range $[0,2\\pi ).$\n\n$$\n\\begin{aligned}\\frac{11\\pi }{2}-2\\pi  & =\\frac{7\\pi }{2} \\\\ \\frac{7\\pi }{2}-2\\pi  & =\\frac{3\\pi }{2}\\,✓\\end{aligned}\n$$\n\nTherefore, $\\operatorname{sin}⁡(\\frac{11\\pi }{2})=\\operatorname{sin}⁡(\\frac{3\\pi }{2}).$\n\nThe angle $(\\frac{3\\pi }{2})$ is a quadrantal angle. Let's draw out the quadrantal angles on the unit circle.\n\n![](images/79/792a778286533d589a3410223aaf197b07e64ea77566042d7bb8ac13fbad9768.png)\n\nFrom the unit circle, we see that the angle $(\\frac{3\\pi }{2})$ corresponds to the point $(0,-1).$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}⁡(\\frac{3\\pi }{2})=-1.$\n\nTherefore, $\\operatorname{sin}⁡(\\frac{11\\pi }{2})=-1.$"} {:db/id #edb/ref 17592186578851 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b36b6ec-2ed2-535b-929e-96d949ec8f93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(1+\\sqrt{3})" :db/id #edb/ref 17592186578319} {:answer/id #uuid "85ae0a1c-5407-5808-8ae2-0a514f5e6977" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(1-\\sqrt{3})" :db/id #edb/ref 17592186578483} {:answer/id #uuid "ace82a22-a4b8-5727-b37e-68b063a01e13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}-\\sqrt{2})" :db/id #edb/ref 17592186578546} {:answer/id #uuid "b6d97b67-6984-5b57-80bd-aef4f53cf8f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(\\sqrt{3}-\\sqrt{2})" :db/id #edb/ref 17592186578556} {:answer/id #uuid "f9059780-fd11-5593-89b8-51a4b864da31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(1-\\sqrt{3})" :db/id #edb/ref 17592186578673}] :answer-field/correct {:answer/id #uuid "85ae0a1c-5407-5808-8ae2-0a514f5e6977" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(1-\\sqrt{3})" :db/id #edb/ref 17592186578483} :answer-field/id #uuid "163d3cfe-3b9f-5c14-845a-4878ab9e6246" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578693}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "86805245-e211-580c-80b0-1f9e6a9db43f" :question/math-academy-id "q-23470" :question/problem "${sin}^{2}⁡({315}^{∘})+\\operatorname{cos}⁡{150}^{∘}=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/d9/d93c490adbb5cdbc0e9a09b60eea9b82ab93be8e871e334423abc17ddd62955e.png)\n\nLet's first consider the angle ${315}^{∘}.$  From the unit circle, we see that the angle ${315}^{∘}$ corresponds to the point $(\\frac{\\sqrt{2}}{2},-\\frac{\\sqrt{2}}{2}).$ Since the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}⁡{315}^{∘}=-\\frac{\\sqrt{2}}{2}.$ \n\nNow, let's consider the angle ${150}^{∘}.$  From the unit circle, we see that the angle ${150}^{∘}$ corresponds to the point $(-\\frac{\\sqrt{3}}{2},\\frac{1}{2}).$ Since the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}⁡{150}^{∘}=-\\frac{\\sqrt{3}}{2}.$\n\nFinally, we combine the results:\n\n$$\n\\begin{aligned}{sin}^{2}⁡({315}^{∘})+\\operatorname{cos}⁡{150}^{∘} & ={(-\\frac{\\sqrt{2}}{2})}^{2}+(-\\frac{\\sqrt{3}}{2}) \\\\  & =\\frac{1}{2}-\\frac{\\sqrt{3}}{2} \\\\  & =\\frac{1}{2}(1-\\sqrt{3}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186578855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31db1cd7-0388-50c2-b462-7f35cbf65e87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186578351}] :answer-field/correct {:answer/id #uuid "31db1cd7-0388-50c2-b462-7f35cbf65e87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186578351} :answer-field/id #uuid "13f920a3-0d4a-551a-8220-e772169b0aaf" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186578692} {:answer-field/choices [{:answer/id #uuid "8c4f249c-80a1-5293-abb1-c40a523ef755" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186578495}] :answer-field/correct {:answer/id #uuid "8c4f249c-80a1-5293-abb1-c40a523ef755" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186578495} :answer-field/id #uuid "44e647b3-cb17-50f5-a019-b6672e2e8687" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186578711}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "921e549a-bfee-5f3e-b0ea-16a68e62a19c" :question/math-academy-id "q-222090" :question/problem "What are the coordinates of the vertex of the parabola $y=-4{x}^{2}-20x-15?$\n\nThe coordinates of the vertex are\n$($\n{{field-1}}\n,\n{{field-2}}\n$).$" :question/worked-solution "The parabola's vertex lies on the symmetry axis, so we will start by computing the axis of symmetry. \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=-4$ and $b=-20$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{(-20)}{2(-4)} \\\\  & =-\\frac{(-20)}{(-8)} \\\\  & =-\\frac{5}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=-\\frac{5}{2}.$ This also represents the $x$-coordinate of the vertex. To find the $y$-coordinate of the vertex, we substitute $x=-\\frac{5}{2}$ into the original equation:\n\n$$\n\\begin{aligned}y & =-4{x}^{2}-20x-15 \\\\  & =-4{(-\\frac{5}{2})}^{2}-20(-\\frac{5}{2})-15 \\\\  & =-25+50-15 \\\\  & =10\\end{aligned}\n$$\n\nTherefore, the vertex is at $(-\\frac{5}{2},10).$"} {:db/id #edb/ref 17592186578860 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02aa900c-d37d-5d89-95d0-ff442793be6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4\\sqrt{3}}{3}" :db/id #edb/ref 17592186578278} {:answer/id #uuid "761a9162-fdb6-5757-9e66-1974a28d9610" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186578457} {:answer/id #uuid "85791f91-326d-58bf-b867-2b69dc9dc09f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186578482} {:answer/id #uuid "93284549-4c49-5b55-b41e-6f6cb9ae87d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{3}}{3}" :db/id #edb/ref 17592186578509} {:answer/id #uuid "ae068e8a-8f67-5fdf-a3d7-d7161393d1dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186578547}] :answer-field/correct {:answer/id #uuid "93284549-4c49-5b55-b41e-6f6cb9ae87d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{3}}{3}" :db/id #edb/ref 17592186578509} :answer-field/id #uuid "995363a3-cf64-5509-8e5f-6562ae68b350" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578746}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b1057e3e-c482-59e9-af27-f85b622c7e5f" :question/math-academy-id "q-23236" :question/problem "If $\\theta =\\frac{\\pi }{3}$, then $\\operatorname{cot}⁡(2\\theta +\\frac{\\pi }{2})+\\operatorname{tan}⁡(2\\theta +\\frac{\\pi }{2})=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nLet's first find the value of angle $2\\theta +\\frac{\\pi }{2}$ where $\\theta =\\frac{\\pi }{3}.$\n\n$$\n2\\theta +\\frac{\\pi }{2}=2(\\frac{\\pi }{3})+\\frac{\\pi }{2}=\\frac{7\\pi }{6}.\n$$\n\nFrom the unit circle, we see that the angle $\\frac{7\\pi }{6}$ corresponds to the point $(-\\frac{\\sqrt{3}}{2},-\\frac{1}{2}).$ Since the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}⁡(\\frac{7\\pi }{6})=-\\frac{\\sqrt{3}}{2}.$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}⁡(\\frac{7\\pi }{6})=-\\frac{1}{2}.$ \n\nUsing the fact that $\\operatorname{cot}⁡\\theta =\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }$ and $\\operatorname{tan}⁡\\theta =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }$ we have\n\n$$\n\\begin{aligned}\\operatorname{cot}⁡(\\frac{7\\pi }{6}) & =\\frac{\\operatorname{cos}⁡(\\frac{7\\pi }{6})}{\\operatorname{sin}⁡(\\frac{7\\pi }{6})}=\\frac{(-\\frac{\\sqrt{3}}{2})}{(-\\frac{1}{2})}=\\sqrt{3}, \\\\ \\operatorname{tan}⁡(\\frac{7\\pi }{6}) & =\\frac{\\operatorname{sin}⁡(\\frac{7\\pi }{6})}{\\operatorname{cos}⁡(\\frac{7\\pi }{6})}=\\frac{(-\\frac{1}{2})}{(-\\frac{\\sqrt{3}}{2})}=\\frac{\\sqrt{3}}{3}.\\end{aligned}\n$$\n\nFinally, we combine the results:\n\n$$\n\\operatorname{cot}⁡(2\\theta +\\frac{\\pi }{2})+\\operatorname{tan}⁡(2\\theta +\\frac{\\pi }{2})=\\operatorname{cot}⁡(\\frac{7\\pi }{6})+\\operatorname{tan}⁡(\\frac{7\\pi }{6})=\\sqrt{3}+\\frac{\\sqrt{3}}{3}=\\frac{4\\sqrt{3}}{3}.\n$$"} {:db/id #edb/ref 17592186578873 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9f8b02c-3c71-509f-93de-e4a3c2bb07cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186578646}] :answer-field/correct {:answer/id #uuid "e9f8b02c-3c71-509f-93de-e4a3c2bb07cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186578646} :answer-field/id #uuid "8b9a1810-6a6d-5eb5-883e-8d03107298a3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186578741}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "df476431-ab3a-5147-98f8-ef5f1e16d04c" :question/math-academy-id "q-353353" :question/problem "![](images/85/853358cc3207d3f2738ecc3bd2ee6391d62b1a51735c43e16f37a2b83414800e.png)\n\nFor the parametric curve \n\n$$\nx=\\operatorname{ln}⁡(3t+1),\\,y=t{e}^{t},\\,-\\frac{1}{3}<t<\\infty ,\n$$\n\nshown above, calculate the slope $m$ of the tangent to the curve at the point where $t=0.$ Do not round the answer.\n\n$m=$ \n{{field-1}}" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=\\frac{3}{3t+1},\\,{y}^{′}(t)=(t+1){e}^{t}.\n$$\n\n \n\nSo, we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{(t+1){e}^{t}}{(\\frac{3}{3t+1})} \\\\  & =\\frac{(t+1)(3t+1){e}^{t}}{3}.\\end{aligned}\n$$\n\nTherefore, when $t=0,$ the slope $m$ of the tangent to the curve is\n\n$$\n\\begin{aligned}m=\\frac{dy}{dx}\\,{|}_{t\\,=\\,0} & =\\frac{(0+1)(0+1){e}^{0}}{3} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186578874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14008af2-533f-5df0-8073-9df0dea9eabf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186578302} {:answer/id #uuid "27daefe3-4f08-546a-b49a-e8753adc9acd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186578334} {:answer/id #uuid "37a43cc4-1a56-5ea6-a470-f77306833ee2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186578359} {:answer/id #uuid "682f8f89-939f-5fdf-acb3-361f9eca56c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186578443} {:answer/id #uuid "e3a43da8-b5ab-5aec-b64f-9fe03bede5d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186578638}] :answer-field/correct {:answer/id #uuid "14008af2-533f-5df0-8073-9df0dea9eabf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186578302} :answer-field/id #uuid "1891b75c-a445-57bf-8516-60c344d13f59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578696}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e8ddd7db-0156-5251-bf50-65888b2a7901" :question/math-academy-id "q-103159" :question/problem "$\\operatorname{cos}⁡(-\\frac{3\\pi }{2})=$" :question/worked-solution "First, we find an angle that's coterminal with $-\\frac{3\\pi }{2}$ that lies in the range $[0,2\\pi ).$\n\n$$\n\\begin{aligned}-\\frac{3\\pi }{2}+2\\pi  & =\\frac{\\pi }{2}\\,✓\\end{aligned}\n$$\n\nTherefore, $\\operatorname{cos}⁡(-\\frac{3\\pi }{2})=\\operatorname{cos}⁡(\\frac{\\pi }{2}).$\n\nThe angle $\\frac{\\pi }{2}$ is a quadrantal angle. Let's draw out the quadrantal angles on the unit circle.\n\n![](images/79/792a778286533d589a3410223aaf197b07e64ea77566042d7bb8ac13fbad9768.png)\n\nFrom the unit circle, we see that the angle $\\frac{\\pi }{2}$ corresponds to the point $(0,1).$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}⁡(\\frac{\\pi }{2})=0.$\n\nTherefore, $\\operatorname{cos}⁡(-\\frac{3\\pi }{2})=0.$"} {:db/id #edb/ref 17592186578876 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d5cbe55-beb8-55d8-b3d7-1b0220ae60dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8x}{27\\pi }\\operatorname{cos}⁡(\\frac{3\\pi x}{2})" :db/id #edb/ref 17592186578370} {:answer/id #uuid "3ddbd52d-d970-5293-adcd-958e5e7719b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4x}{27\\pi }\\operatorname{cos}⁡(\\frac{3\\pi x}{2})" :db/id #edb/ref 17592186578371} {:answer/id #uuid "c3be416c-5de9-5416-9071-8b9539a10c79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{16x}{27\\pi }\\operatorname{cos}⁡(\\frac{3\\pi x}{2})" :db/id #edb/ref 17592186578576} {:answer/id #uuid "d76ab2b6-88a5-5b3a-a528-1ec41b175396" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8x}{27\\pi }\\operatorname{sin}⁡(\\frac{3\\pi x}{2})" :db/id #edb/ref 17592186578607}] :answer-field/correct {:answer/id #uuid "3d5cbe55-beb8-55d8-b3d7-1b0220ae60dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8x}{27\\pi }\\operatorname{cos}⁡(\\frac{3\\pi x}{2})" :db/id #edb/ref 17592186578370} :answer-field/id #uuid "24a1b253-dea2-5722-80f3-4ed1534482dc" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186578700} {:answer-field/choices [{:answer/id #uuid "46ab8f72-a107-5264-917d-17e7a0db3bc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=1" :db/id #edb/ref 17592186578386} {:answer/id #uuid "8e2eb7fd-63ac-5bde-a164-58af1a7b608b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=4" :db/id #edb/ref 17592186578502} {:answer/id #uuid "a65673dc-f1f0-522a-bafe-68ef7278ee0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=2" :db/id #edb/ref 17592186578535} {:answer/id #uuid "e3410172-077c-5b4c-b1c5-73dcfaebadb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=3" :db/id #edb/ref 17592186578637}] :answer-field/correct {:answer/id #uuid "e3410172-077c-5b4c-b1c5-73dcfaebadb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=3" :db/id #edb/ref 17592186578637} :answer-field/id #uuid "a9e19625-804c-5b01-89fe-15a44c087d3b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186578755}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ede3a234-3946-5f25-9a03-9a90ef1ab597" :question/math-academy-id "q-343912" :question/problem "Consider the differential equation ${y}^{″}+\\frac{9{\\pi }^{2}}{4}y=f(x),$ where the $4$-periodic forcing function is given by \n\n$$\nf(x)∼3+{\\sum }_{n=1}^{\\infty }\\frac{8}{{n}^{2}}\\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$\n\nSelect the correct options in the reasoning below regarding the resonant component of a particular solution of the equation.\n\nThe natural frequency of the system matches the frequency of the {{field-1}} harmonic of the forcing function. \n\nConsequently, the particular solution contains a resonant term of the form\n\n$$\n{y}_{{p}_{3}}={{field-2}}.\n$$" :question/worked-solution "We begin by identifying resonance. The differential equation \n\n$$\n{y}^{″}+\\frac{9{\\pi }^{2}}{4}y=f(x)\n$$\n\nhas a natural frequency of \n\n$$\n\\omega =\\sqrt{\\frac{9{\\pi }^{2}}{4}}=\\frac{3\\pi }{2}.\n$$\n\nThe frequencies of the forcing harmonics for a $4$-periodic function $(L=2)$ are \n\n$$\n{\\omega }_{n}=\\frac{n\\pi }{2}.\n$$\n\nFor $n=3$, we have ${\\omega }_{3}=\\frac{3\\pi }{2}.$ Since ${\\omega }_{3}=\\omega ,$ the $n=3$ harmonic of the forcing function causes resonance.\n\nFor the $n=3$ harmonic, the forcing term is \n\n$$\n{f}_{3}(x)=\\frac{8}{9}\\operatorname{sin}⁡(\\frac{3\\pi x}{2}).\n$$\n\nBecause this frequency matches the natural frequency, we assume a particular solution of the form\n\n$$\n{y}_{{p}_{3}}=x(A\\operatorname{cos}⁡(\\frac{3\\pi x}{2})+B\\operatorname{sin}⁡(\\frac{3\\pi x}{2})).\n$$\n\nNow, we compute the derivatives:\n\n$$\n\\begin{aligned}{y}_{{p}_{3}}^{′} & =(A\\operatorname{cos}⁡(\\frac{3\\pi x}{2})+B\\operatorname{sin}⁡(\\frac{3\\pi x}{2}))+x(-\\frac{3\\pi }{2}A\\operatorname{sin}⁡(\\frac{3\\pi x}{2})+\\frac{3\\pi }{2}B\\operatorname{cos}⁡(\\frac{3\\pi x}{2})) \\\\ {y}_{{p}_{3}}^{″} & =-3\\pi A\\operatorname{sin}⁡(\\frac{3\\pi x}{2})+3\\pi B\\operatorname{cos}⁡(\\frac{3\\pi x}{2})-\\frac{9{\\pi }^{2}}{4}x(A\\operatorname{cos}⁡(\\frac{3\\pi x}{2})+B\\operatorname{sin}⁡(\\frac{3\\pi x}{2}))\\end{aligned}\n$$\n\nNext, we substitute the expressions for ${y}_{{p}_{3}}^{″}$ and ${y}_{{p}_{3}}$ into the equation ${y}^{″}+\\frac{9{\\pi }^{2}}{4}y=\\frac{8}{9}\\operatorname{sin}⁡(\\frac{3\\pi x}{2}):$\n\n$$\n[-3\\pi A\\operatorname{sin}⁡(\\frac{3\\pi x}{2})+3\\pi B\\operatorname{cos}⁡(\\frac{3\\pi x}{2})-\\frac{9{\\pi }^{2}}{4}{y}_{{p}_{3}}]+\\frac{9{\\pi }^{2}}{4}{y}_{{p}_{3}}=\\frac{8}{9}\\operatorname{sin}⁡(\\frac{3\\pi x}{2})\n$$\n\nThe resonant terms involving $x$ cancel out, leaving\n\n$$\n-3\\pi A\\operatorname{sin}⁡(\\frac{3\\pi x}{2})+3\\pi B\\operatorname{cos}⁡(\\frac{3\\pi x}{2})=\\frac{8}{9}\\operatorname{sin}⁡(\\frac{3\\pi x}{2}).\n$$\n\nNow, equating the sine and cosine coefficients, we obtain:\n\n$$\n\\left\\{\\begin{aligned}-3\\pi A &=\\frac{8}{9} \\\\ 3\\pi B &=0\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}A &=-\\frac{8}{27\\pi } \\\\ B &=0\\end{aligned}\\right.\n$$\n\nTherefore, the resonant component of a particular solution is\n\n$$\n{y}_{{p}_{3}}=-\\frac{8x}{27\\pi }\\operatorname{cos}⁡(\\frac{3\\pi x}{2}).\n$$"} {:db/id #edb/ref 17592186578877 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0825b7a7-74a7-5935-86cd-1b0bba712bd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186578285} {:answer/id #uuid "5348801e-a631-5d23-93d5-012769dd8d19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186578403} {:answer/id #uuid "600a5309-7bc1-513f-8449-5d85d2a64fd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{2}" :db/id #edb/ref 17592186578428} {:answer/id #uuid "b432d866-9d8e-5893-a7c9-658ab974d99b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186578554} {:answer/id #uuid "d843b8af-69d9-5879-a337-8dde5a272ce0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186578610}] :answer-field/correct {:answer/id #uuid "b432d866-9d8e-5893-a7c9-658ab974d99b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186578554} :answer-field/id #uuid "940ee680-1c54-57c6-9fe1-a296cc68c0ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578743}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ef5ed0c9-8fa3-5025-804c-fe51ae9e2b6d" :question/math-academy-id "q-15477" :question/problem "For the parametric curve \n\n$$\nx={sec}^{2}⁡t,\\,y={csc}^{3}⁡t,\\,0<t<\\frac{\\pi }{2},\n$$\n\ncalculate the slope of the tangent to the curve at the point where $t=\\frac{\\pi }{4}.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=2{sec}^{2}⁡t\\operatorname{tan}⁡t,\\,{y}^{′}(t)=-3{csc}^{3}⁡t\\operatorname{cot}⁡t.\n$$\n\n \n\nSo we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{-3{csc}^{3}⁡t\\operatorname{cot}⁡t}{2{sec}^{2}⁡t\\operatorname{tan}⁡t} \\\\  & =-3{csc}^{3}⁡t\\operatorname{cot}⁡t(\\frac{{cos}^{2}⁡t\\operatorname{cot}⁡t}{2}) \\\\  & =-\\frac{3}{2}\\,{csc}^{3}⁡t{cot}^{2}⁡t{cos}^{2}⁡t \\\\  & =-\\frac{3}{2}(\\frac{1}{{sin}^{3}⁡t})(\\frac{{cos}^{2}⁡t}{{sin}^{2}⁡t}){cos}^{2}⁡t \\\\  & =-\\frac{3}{2}(\\frac{{cos}^{4}⁡t}{{sin}^{5}⁡t}) \\\\  & =-\\frac{3}{2}\\,\\operatorname{csc}⁡t{cot}^{4}⁡t\\,.\\end{aligned}\n$$\n\nTherefore, when $t=\\frac{\\pi }{4},$ the slope of the tangent to the curve is\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =-\\frac{3}{2}\\,\\operatorname{csc}⁡(\\frac{\\pi }{4}){cot}^{4}⁡(\\frac{\\pi }{4}) \\\\  & =-\\frac{3}{2}\\cdot \\sqrt{2}\\cdot 1 \\\\  & =-\\frac{3}{\\sqrt{2}}\\, \\\\  & =-\\frac{3\\sqrt{2}}{2}\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186578880 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1211556a-5bf1-58e2-84e7-7950e4319711" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\sqrt{3}}{4}" :db/id #edb/ref 17592186578301} {:answer/id #uuid "15a1e317-123e-5b9f-bb99-33f0a7ca6264" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\sqrt{6}}{5}" :db/id #edb/ref 17592186578303} {:answer/id #uuid "4f32522d-6848-5f81-b69c-a543a910c74c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\sqrt{6}}{5}" :db/id #edb/ref 17592186578398} {:answer/id #uuid "5eabf2f9-9a99-5893-adc9-74960dc5a0ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{4}{5}" :db/id #edb/ref 17592186578425} {:answer/id #uuid "84a5612c-a50c-5501-ad80-806d183376a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{4}{5}" :db/id #edb/ref 17592186578481}] :answer-field/correct {:answer/id #uuid "84a5612c-a50c-5501-ad80-806d183376a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{4}{5}" :db/id #edb/ref 17592186578481} :answer-field/id #uuid "6379ebf1-b8d0-5e84-b58f-943367259fab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578726}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f7944f41-be32-59e2-8b16-d3d6e85a0689" :question/math-academy-id "q-85638" :question/problem "The point $P$ is located in the third quadrant and lies on the unit circle. The $y$-coordinate of $P$ is $-\\frac{3}{5}.$ What is the $x$-coordinate of $P?$" :question/worked-solution "Since the point $P$ lies on the unit circle, it must satisfy the Pythagorean theorem: \n\n$$\n{x}^{2}+{y}^{2}=1\n$$\n\nSubstituting $y=-\\frac{3}{5}$ into the above and solving for $x$ gives\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =1 \\\\ {x}^{2}+{(-\\frac{3}{5})}^{2} & =1 \\\\ {x}^{2}+(\\frac{9}{25}) & =1 \\\\ {x}^{2} & =1-\\frac{9}{25} \\\\ {x}^{2} & =\\frac{16}{25} \\\\ x & =\\pm \\sqrt{\\frac{16}{25}} \\\\ x & =\\pm \\frac{4}{5}.\\end{aligned}\n$$\n\nFinally, we select the negative answer since $x$ is negative in the third quadrant. So our final answer is $x=-\\frac{4}{5}.$"} {:db/id #edb/ref 17592186579489 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38f72694-f51d-52ef-9284-7e1aa9a2b93f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{5}" :db/id #edb/ref 17592186579077}] :answer-field/correct {:answer/id #uuid "38f72694-f51d-52ef-9284-7e1aa9a2b93f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{5}" :db/id #edb/ref 17592186579077} :answer-field/id #uuid "294f90db-e9c2-5694-b51f-cd1454cd8c1d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186579411}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "02a9a6a7-bf2d-5419-bf68-2d0fb932dc93" :question/math-academy-id "q-223674" :question/problem "The axis of symmetry of the parabola $y=-(5x+2)(x-6)$ is $x=${{field-1}}." :question/worked-solution "From the equation $y=-(5x+2)(x-6),$ we find that the roots of the parabola are ${x}_{1}=-\\frac{2}{5}$ and ${x}_{2}=6.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(-\\frac{2}{5}+6)}{2} \\\\  & =\\frac{(-\\frac{2}{5}+\\frac{30}{5})}{2} \\\\  & =\\frac{(\\frac{28}{5})}{2} \\\\  & =\\frac{14}{5}\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=\\frac{14}{5}.$"} {:db/id #edb/ref 17592186579493 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "165b5780-9442-5349-8b73-00d7e75626b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186579005} {:answer/id #uuid "89a434e7-1e55-544e-813a-7f3db861daed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186579206} {:answer/id #uuid "beb1a873-2a94-548e-95d6-bf94cf79b543" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186579297} {:answer/id #uuid "f2c06aae-4f93-5284-a80a-e1ec60c51441" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186579382} {:answer/id #uuid "f316960e-822c-5be0-a815-0d51822ea143" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186579383}] :answer-field/correct {:answer/id #uuid "f316960e-822c-5be0-a815-0d51822ea143" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186579383} :answer-field/id #uuid "30beceb0-84c9-5497-96c5-d7d36f453dcd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186579414}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0c33414b-3ca3-59b7-b0ab-40bd082f7bf3" :question/math-academy-id "q-118797" :question/problem "A right triangle has legs of length $\\frac{\\sqrt{20}}{3}$ and $\\frac{4}{3}.$ Calculate the length of its hypotenuse." :question/worked-solution "Let $a=\\frac{\\sqrt{20}}{3},$ $b=\\frac{4}{3},$ and $c$ be the length of the hypotenuse. According to the Pythagorean theorem, we obtain\n\n$$\n\\begin{aligned}{c}^{2} & ={a}^{2}+{b}^{2} \\\\ c & =\\sqrt{{a}^{2}+{b}^{2}}.\\end{aligned}\n$$\n\nSubstituting in the values for $a$ and $b$ gives us\n\n$$\n\\begin{aligned}c & =\\sqrt{{(\\frac{\\sqrt{20}}{3})}^{2}+{(\\frac{4}{3})}^{2}} \\\\  & =\\sqrt{\\frac{20}{9}+\\frac{16}{9}} \\\\  & =\\sqrt{\\frac{36}{9}} \\\\  & =\\sqrt{4} \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186579499 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18ad6078-b88f-5380-b29c-8c20cdec4c59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,\\frac{3}{2})" :db/id #edb/ref 17592186579010} {:answer/id #uuid "39f60501-4a58-5ac7-a65e-5cd9504e7474" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,1)" :db/id #edb/ref 17592186579078} {:answer/id #uuid "47917957-1abc-575f-a20d-0d4d851c8658" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,1)" :db/id #edb/ref 17592186579099} {:answer/id #uuid "65850566-e29c-54a5-bc75-0b0d4fbe9062" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,\\frac{1}{2})" :db/id #edb/ref 17592186579144} {:answer/id #uuid "919dc9ed-cfe4-57c4-98df-5189faade881" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,\\frac{3}{2})" :db/id #edb/ref 17592186579221}] :answer-field/correct {:answer/id #uuid "47917957-1abc-575f-a20d-0d4d851c8658" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,1)" :db/id #edb/ref 17592186579099} :answer-field/id #uuid "7dc9adc6-da08-5035-9d61-f7479a64c3cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186579442}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1ed53337-f202-58d0-a176-4f7c1b9ce4ab" :question/math-academy-id "q-130899" :question/problem "Find a point that satisfies the mean value theorem for $f(x,y)={x}^{2}+xy-3{y}^{2}$ on the line segment $\\overset{―}{AB},$ where the position vectors of $A$ and $B$ are $a=⟨0,0⟩$ and $b=⟨4,2⟩,$ respectively." :question/worked-solution "The mean value theorem states that if $f(x,y)$ is differentiable at each point on the line segment $\\overset{―}{AB},$ then there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that\n\n$$\nf(b)-f(a)=∇f(c)·(b-a).\n$$\n\nNotice that the function $f(x,y)={x}^{2}+xy-3{y}^{2}$ is differentiable at each point on the line segment $\\overset{―}{AB}.$ So, we can apply the mean value theorem.\n\nSubstituting $a=⟨0,0⟩$ and $b=⟨4,2⟩$ into the above expression, we get\n\n$$\n\\begin{aligned}f(4,2)-f(0,0) & =∇f(c)\\cdot (⟨4,2⟩-⟨0,0⟩) \\\\ {4}^{2}+4(2)-3(2)^{2}-0 & =∇f(c)\\cdot ⟨4,2⟩ \\\\ 12 & =∇f(c)\\cdot ⟨4,2⟩.\\end{aligned}\n$$\n\nComputing $∇f$ and evaluating at $c=⟨{c}_{1},{c}_{2}⟩,$ we get \n\n$$\n\\begin{aligned}∇f & =⟨2x+y,x-6y⟩, \\\\ ∇f(c) & =⟨2{c}_{1}+{c}_{2},{c}_{1}-6{c}_{2}⟩.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}12 & =∇f⟨c⟩\\cdot ⟨4,2⟩ \\\\ 12 & =⟨2{c}_{1}+{c}_{2},{c}_{1}-6{c}_{2}⟩\\cdot ⟨4,2⟩ \\\\ 12 & =4(2{c}_{1}+{c}_{2})+2({c}_{1}-6{c}_{2}) \\\\ 12 & =10{c}_{1}-8{c}_{2} \\\\ 6 & =5{c}_{1}-4{c}_{2}.\\end{aligned}\n$$\n\nNow, we use the fact that $C$ lies on $\\overset{―}{AB}.$ So, let's first find the equation of the line.\n\n$$\n\\begin{aligned}\\frac{y-{y}_{a}}{{y}_{b}-{y}_{a}} & =\\frac{x-{x}_{a}}{{x}_{b}-{x}_{a}} \\\\ \\frac{y-0}{2-0} & =\\frac{x-0}{4-0} \\\\ \\frac{y}{2} & =\\frac{x}{4} \\\\ y & =\\frac{x}{2}.\\end{aligned}\n$$\n\nSince $c=⟨{c}_{1},{c}_{2}⟩$ satisfies the equation of the line, we have\n\n$$\n\\begin{aligned}{c}_{2} & =\\frac{{c}_{1}}{2}.\\end{aligned}\n$$\n\nSubstituting the above into the equation $5{c}_{1}-4{c}_{2}=6,$ we get \n\n$$\n\\begin{aligned}5{c}_{1}-4(\\frac{{c}_{1}}{2}) & =6 \\\\ 5{c}_{1}-2{c}_{1} & =6 \\\\ 3{c}_{1} & =6 \\\\ {c}_{1} & =2.\\end{aligned}\n$$\n\nFinally, we find ${c}_{2}=\\frac{{c}_{1}}{2}=1.$ So, the point $C$ that satisfies the mean value theorem is $(2,1).$"} {:db/id #edb/ref 17592186579505 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f226985-9e2e-5f56-98d7-bbe1f9ce77e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186578988} {:answer/id #uuid "a88f4c6d-b8d1-5a3e-85e1-ee856e58285e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186579257} {:answer/id #uuid "b2b2f450-4b43-5f99-befa-31742c8cf3d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186579273} {:answer/id #uuid "e700c7f0-be9d-5450-8804-46e62b82640e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186579351} {:answer/id #uuid "fd2432d4-99f4-52e2-89df-6e374faa1309" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186579393}] :answer-field/correct {:answer/id #uuid "fd2432d4-99f4-52e2-89df-6e374faa1309" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186579393} :answer-field/id #uuid "ef90af97-5201-51bf-901a-91196afc1e6a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186579481}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2fe3a351-f352-5be0-93b8-6d5db4f32297" :question/math-academy-id "q-123658" :question/problem "$\\operatorname{sec}⁡(-{300}^{∘})=$" :question/worked-solution "First, we find an angle that's coterminal with $-{300}^{∘}$ that lies in the range $[{0}^{∘},{360}^{∘}).$\n\n$$\n-{300}^{∘}+{360}^{∘}={60}^{∘}\\,✓\n$$\n\nTherefore, $\\operatorname{sec}⁡(-{300}^{∘})=\\operatorname{sec}⁡({60}^{∘}).$\n\nLet's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/d9/d93c490adbb5cdbc0e9a09b60eea9b82ab93be8e871e334423abc17ddd62955e.png)\n\nFrom the unit circle, we see that the angle ${60}^{∘}$ corresponds to the point $(\\frac{1}{2},\\frac{\\sqrt{3}}{2}).$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}⁡({60}^{∘})=\\frac{1}{2}.$\n\nTherefore, using the fact that $\\operatorname{sec}⁡\\theta =\\frac{1}{\\operatorname{cos}⁡\\theta },$ we have\n\n$$\n\\operatorname{sec}⁡({60}^{∘})=\\frac{1}{\\operatorname{cos}⁡({60}^{∘})}=\\frac{1}{(\\frac{1}{2})}=2.\n$$\n\n \n\nTherefore, $\\operatorname{sec}⁡(-{300}^{∘})=2.$"} {:db/id #edb/ref 17592186579509 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c4be090-32a2-507f-81d9-31e8f0255492" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{1/49}⁡(\\frac{1}{7})=-2" :db/id #edb/ref 17592186579082} {:answer/id #uuid "4ccf37c6-8541-5705-8721-96e5f5f39777" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{1/7}⁡(2)=-49" :db/id #edb/ref 17592186579105} {:answer/id #uuid "5576f023-1fa4-5dfd-82dc-88103b7025f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{49}⁡(\\frac{1}{7})=-2" :db/id #edb/ref 17592186579117} {:answer/id #uuid "abb39a68-2a49-51fd-85db-b217a707f0da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{1/7}⁡(49)=-2" :db/id #edb/ref 17592186579264} {:answer/id #uuid "dc77b116-61a4-59fb-978e-e2f4f7567c5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{2}⁡(49)=\\frac{1}{7}" :db/id #edb/ref 17592186579335}] :answer-field/correct {:answer/id #uuid "abb39a68-2a49-51fd-85db-b217a707f0da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{1/7}⁡(49)=-2" :db/id #edb/ref 17592186579264} :answer-field/id #uuid "0096bd54-d4da-5ffb-a10b-6461c6d4ffbc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186579399}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3d652a81-ab7a-514a-969a-6e1c713f1003" :question/math-academy-id "q-99456" :question/problem "${(\\frac{1}{7})}^{-2}=49$ can be expressed as" :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n$a={b}^{x}$ is equivalent to ${log}_{b}⁡a=x$\n\nIf we compare ${(\\frac{1}{7})}^{-2}=49$ with $a={b}^{x},$ we get $a=49,b=\\frac{1}{7}$ and $x=-2.$  \n\nTherefore, the given equation can be expressed as ${log}_{1/7}⁡(49)=-2.$"} {:db/id #edb/ref 17592186579517 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3458b8e0-6025-506a-9b90-83a87e1eb5dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{3}" :db/id #edb/ref 17592186579066} {:answer/id #uuid "87de6df6-a8ce-5658-943f-9010d213853e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{6}" :db/id #edb/ref 17592186579203} {:answer/id #uuid "8dc95180-1e74-5957-a310-ecabcd293f68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1" :db/id #edb/ref 17592186579216} {:answer/id #uuid "a9a0359b-7017-5065-9517-429d0bfca6f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=1" :db/id #edb/ref 17592186579260} {:answer/id #uuid "cc95fe6d-1797-5643-b52c-84ddbf522487" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{1}{3}" :db/id #edb/ref 17592186579316}] :answer-field/correct {:answer/id #uuid "a9a0359b-7017-5065-9517-429d0bfca6f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=1" :db/id #edb/ref 17592186579260} :answer-field/id #uuid "12cd225e-59fc-5a10-ac48-e16436043f1e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186579403}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4ae3a735-6039-5ae0-a592-be9a89fdd607" :question/math-academy-id "q-84904" :question/problem "Find the axis of symmetry of the parabola $y=-(3x-8)(3x+2).$" :question/worked-solution "From the equation $y=-(3x-8)(3x+2),$ we find that the roots of the parabola are ${x}_{1}=\\frac{8}{3}$ and ${x}_{2}=-\\frac{2}{3}.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(\\frac{8}{3}-\\frac{2}{3})}{2} \\\\  & =\\frac{(\\frac{6}{3})}{2} \\\\  & =1\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=1.$"} {:db/id #edb/ref 17592186579536 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25ba1d20-6ac9-5b8f-aa0c-6026cd28f9e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt{3}" :db/id #edb/ref 17592186579029} {:answer/id #uuid "27a4226b-eed2-512e-8709-2326b4e919ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186579035} {:answer/id #uuid "cf807ddf-c4a4-52b4-992d-01a21cbd4939" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\sqrt{3}" :db/id #edb/ref 17592186579319} {:answer/id #uuid "d86269a0-d5b2-5c79-944d-dcac097bca04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186579330} {:answer/id #uuid "ef81af81-3f83-5d4e-9475-41bb2afbf175" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186579370}] :answer-field/correct {:answer/id #uuid "cf807ddf-c4a4-52b4-992d-01a21cbd4939" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\sqrt{3}" :db/id #edb/ref 17592186579319} :answer-field/id #uuid "46ce9f1c-8319-5d3a-a9bd-7b32759cfc72" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186579420}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8f0a7cc5-025c-5f3d-b13c-013da7976c41" :question/math-academy-id "q-123673" :question/problem "Find the value of $6\\operatorname{cos}⁡{870}^{∘}.$" :question/worked-solution "First, we find an angle that's coterminal with ${870}^{∘}$ that lies in the range $[0,{360}^{∘}).$\n\n$$\n\\begin{aligned}{870}^{∘}-{360}^{∘} & ={510}^{∘} \\\\ {510}^{∘}-{320}^{∘} & ={150}^{∘}\\,✓\\end{aligned}\n$$\n\nTherefore, $\\operatorname{cos}⁡{870}^{∘}=\\operatorname{cos}⁡{150}^{∘}.$\n\nLet's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/d9/d93c490adbb5cdbc0e9a09b60eea9b82ab93be8e871e334423abc17ddd62955e.png)\n\nFrom the unit circle, we see that the angle ${150}^{∘}$ corresponds to the point $(-\\frac{\\sqrt{3}}{2},\\frac{1}{2}).$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}⁡{150}^{∘}=-\\frac{\\sqrt{3}}{2}.$\n\nTherefore $\\operatorname{cos}⁡{870}^{∘}=-\\frac{\\sqrt{3}}{2}.$\n\nFinally,\n\n$$\n6\\operatorname{cos}⁡{870}^{∘}=6(-\\frac{\\sqrt{3}}{2})=-3\\sqrt{3}.\n$$"} {:db/id #edb/ref 17592186579537 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14455493-8d92-5151-bdab-bc10fadf2eb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt{3}" :db/id #edb/ref 17592186578999} {:answer/id #uuid "343b75b7-b92f-5a35-b80f-11c7280482ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\sqrt{2}" :db/id #edb/ref 17592186579063} {:answer/id #uuid "8fd4bb8d-11a5-5f5e-b162-54a41b80f4f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{3}" :db/id #edb/ref 17592186579220} {:answer/id #uuid "a7ba4153-1bfa-573e-8a4b-97009f76fa18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt{2}" :db/id #edb/ref 17592186579254} {:answer/id #uuid "ace670a6-afae-5081-80f6-60fefa14d520" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186579265}] :answer-field/correct {:answer/id #uuid "a7ba4153-1bfa-573e-8a4b-97009f76fa18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt{2}" :db/id #edb/ref 17592186579254} :answer-field/id #uuid "72062e97-e13a-500b-b6f7-64a5d2c829e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186579439}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "947f58ae-d814-594b-bac5-39606db5e45f" :question/math-academy-id "q-89755" :question/problem "Find the value of $4\\operatorname{sin}⁡({945}^{∘}).$" :question/worked-solution "First, we find an angle that's coterminal with ${945}^{∘}$ that lies in the range $[0,{360}^{∘}).$\n\n$$\n\\begin{aligned}{945}^{∘}-{360}^{∘} & ={585}^{∘} \\\\ {585}^{∘}-{360}^{∘} & ={225}^{∘}\\,✓\\end{aligned}\n$$\n\nTherefore, $\\operatorname{sin}⁡({945}^{∘})=\\operatorname{sin}⁡({225}^{∘}).$\n\nLet's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/ca/ca39c4cde40b99fd40a11746a31398d82814268b2df706e3101ee88648c9e2d4.png)\n\nFrom the unit circle, we see that the angle ${225}^{∘}$ corresponds to the point $(-\\frac{\\sqrt{2}}{2},-\\frac{\\sqrt{2}}{2}).$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}⁡({225}^{∘})=-\\frac{\\sqrt{2}}{2}.$\n\nTherefore $\\operatorname{sin}⁡({945}^{∘})=-\\frac{\\sqrt{2}}{2}.$\n\nFinally,\n\n$$\n4\\operatorname{sin}⁡({945}^{∘})=4\\cdot (-\\frac{\\sqrt{2}}{2})=-2\\sqrt{2}.\n$$"} {:db/id #edb/ref 17592186579542 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cbb2bf4-498c-58c2-be5e-8a696c94568a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186579047} {:answer/id #uuid "77b1e2de-4d1b-51c4-9e54-d5d762b5713c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\sqrt{3}" :db/id #edb/ref 17592186579167} {:answer/id #uuid "7d7c6832-4ce6-5c98-99cd-b9fc0727276b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt{2}" :db/id #edb/ref 17592186579181} {:answer/id #uuid "85aefb4d-694f-5b72-85a3-d0cafeb15460" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186579199} {:answer/id #uuid "ea42e0e8-8e6e-50cb-a231-c57815edb359" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186579362}] :answer-field/correct {:answer/id #uuid "77b1e2de-4d1b-51c4-9e54-d5d762b5713c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\sqrt{3}" :db/id #edb/ref 17592186579167} :answer-field/id #uuid "704db9fd-b847-51df-8430-8607508a4e88" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186579438}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9bce6c5a-0643-548e-b425-54109cb350ba" :question/math-academy-id "q-42332" :question/problem "The polar curve $r=k\\operatorname{sin}⁡\\theta ,$ where $k$ is a constant, passes through the point $A$ with Cartesian coordinates $(3,-3\\sqrt{3}).$ What is the value of $k?$" :question/worked-solution "First, we find the polar coordinates of the point $A.$ The distance from $A$ to the origin is\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{3}^{2}+{(-3\\sqrt{3})}^{2}} \\\\  & =\\sqrt{9+27} \\\\  & =\\sqrt{36} \\\\  & =6.\\end{aligned}\n$$\n\nNow, since $A$ lies in the fourth quadrant, we get\n\n$$\n\\begin{aligned}\\theta  & =2\\pi -\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =2\\pi -\\operatorname{arctan}⁡|\\frac{(-3\\sqrt{3})}{3}| \\\\  & =2\\pi -\\operatorname{arctan}⁡|-\\sqrt{3}| \\\\  & =\\frac{5\\pi }{3}.\\end{aligned}\n$$\n\nSo, the polar coordinates of $A$ are $(r,\\theta )=(6,\\frac{5\\pi }{3}).$\n\nTo find the value of $k$, we substitute the polar coordinates of the point $A$ into the polar equation of the curve:\n\n$$\n\\begin{aligned}r & =k\\operatorname{sin}⁡\\theta  \\\\ 6 & =k\\operatorname{sin}⁡(\\frac{5\\pi }{3}) \\\\ 6 & =k(-\\frac{\\sqrt{3}}{2}) \\\\ k & =-4\\sqrt{3}.\\end{aligned}\n$$\n\nTherefore, the equation of the curve is $r=-4\\sqrt{3}\\operatorname{sin}⁡\\theta ,$ as shown below.\n\n![](images/69/69d814c075c7e8a940fe4900f5601052835ab999e68e43fabe1dd34eaf5709b2.png)"} {:db/id #edb/ref 17592186579543 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid 