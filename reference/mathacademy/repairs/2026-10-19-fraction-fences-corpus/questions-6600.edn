sqrt{AH^2+BH^2} \\\\\n&= \\sqrt{(1)^2+(\\frac{3}{2})^2} \\\\\n&= \\sqrt{1+\\frac{9}{4}} \\\\\n&= \\frac{\\sqrt{13}}{2}\n\\end{aligned}\n$$\n\nHence, the magnitude of $m+n$ is $\\frac{\\sqrt{13}}{2}$. Consequently, the unit vector is\n\n$$\n\\begin{aligned}\nu &= \\frac{1}{|m+n|}\\cdot (m+n) \\\\\n&= \\frac{2 \\sqrt{13}}{13}(m+n)\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186502385 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f51b159-ea75-5a59-8717-0c45b2ed7ce1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 \\sqrt{37}}{37}c" :db/id #edb/ref 17592186502328} {:answer/id #uuid "141f8e46-00b6-5edb-9b87-b7642576a28c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{37}}{2}c" :db/id #edb/ref 17592186502331} {:answer/id #uuid "30240caf-a126-530f-b211-a9a6f26c71f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4 \\sqrt{37}}{37}c" :db/id #edb/ref 17592186502343} {:answer/id #uuid "37821061-f4a7-54a6-ac8e-8ecd87c7dbe6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{37}c" :db/id #edb/ref 17592186502347} {:answer/id #uuid "8c256041-15e9-5b30-a73c-055ffa53fb81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2c" :db/id #edb/ref 17592186502373}] :answer-field/correct {:answer/id #uuid "0f51b159-ea75-5a59-8717-0c45b2ed7ce1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 \\sqrt{37}}{37}c" :db/id #edb/ref 17592186502328} :answer-field/id #uuid "ba5ce94e-e328-592b-a1b0-2e3209c0ac18" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502396}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "add307e1-eba2-5029-b8ba-35bea556d853" :question/problem "![](images/1d/1dbd27c1b4987c7b6196da934b586f93062d5e9a77144a0c9defb3f8db9adf17.png)\n\nConsider the picture shown above. Find a unit vector that is parallel to $c$. Choose the unit vector in the same direction." :question/worked-solution "![](images/e8/e81324960632400a3af894d472f054a9e5035dc77ccf8ce87b6720d5af2d5b2f.png)\n\nIn $\\bigtriangleup AHB$ we have $\\angle AHB=90^\\circ$, $AH=0.5$ and $BH=3$. So, the Pythagorean theorem gives\n\n$$\n\\begin{aligned}\nAB &= \\sqrt{AH^2+BH^2} \\\\\n&= \\sqrt{(\\frac{1}{2})^2+(3)^2} \\\\\n&= \\sqrt{\\frac{1}{4}+9} \\\\\n&= \\frac{\\sqrt{37}}{2}\n\\end{aligned}\n$$\n\nHence, the magnitude of $c$ is $\\frac{\\sqrt{37}}{2}$. Consequently, the unit vector is\n\n$$\n\\begin{aligned}\nu &= \\frac{1}{|c|}\\cdot c \\\\\n&= \\frac{2 \\sqrt{37}}{37}c\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186502393 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "175716d6-f724-5abd-89ff-3f8a07a173f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{58}}{29}c" :db/id #edb/ref 17592186502335} {:answer/id #uuid "8cf6d763-5cbb-5d44-af46-95fc5c977990" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{58}}{2}c" :db/id #edb/ref 17592186502374} {:answer/id #uuid "98aad0d9-ad4d-522e-a5cb-612dcdbbe2f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{29}c" :db/id #edb/ref 17592186502379} {:answer/id #uuid "c09c9bc4-ee4e-591d-9d2a-f36c3683dbc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}c" :db/id #edb/ref 17592186502403} {:answer/id #uuid "cd88d19e-3d47-5bbd-adb4-9b532799655f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 \\sqrt{58}}{29}c" :db/id #edb/ref 17592186502409}] :answer-field/correct {:answer/id #uuid "175716d6-f724-5abd-89ff-3f8a07a173f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{58}}{29}c" :db/id #edb/ref 17592186502335} :answer-field/id #uuid "cead1b10-d18a-5709-b0b2-535c451e4c12" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502411}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b3b0065f-ddd8-5f3f-97d3-2bf3c18a2472" :question/problem "![](images/da/daa0c47f022b83ba8fe6cd059f7a2971ee92082c9b315f813c93df806b743377.png)\n\nConsider the picture shown above. Find a unit vector that is parallel to $c$. Choose the unit vector in the same direction." :question/worked-solution "![](images/ac/ac6e9bcd576c30cd721babe0d12a31cd9a3ba0d4905ad3b02e32d1dd8ca012c9.png)\n\nIn $\\bigtriangleup AHB$ we have $\\angle AHB=90^\\circ$, $AH=1.5$ and $BH=3.5$. So, the Pythagorean theorem gives\n\n$$\n\\begin{aligned}\nAB &= \\sqrt{AH^2+BH^2} \\\\\n&= \\sqrt{(\\frac{3}{2})^2+(\\frac{7}{2})^2} \\\\\n&= \\sqrt{\\frac{9}{4}+\\frac{49}{4}} \\\\\n&= \\frac{\\sqrt{58}}{2}\n\\end{aligned}\n$$\n\nHence, the magnitude of $c$ is $\\frac{\\sqrt{58}}{2}$. Consequently, the unit vector is\n\n$$\n\\begin{aligned}\nu &= \\frac{1}{|c|}\\cdot c \\\\\n&= \\frac{\\sqrt{58}}{29}c\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186502397 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28bdd9c3-4ba9-5e07-bbc2-23008ea90296" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4 \\sqrt{73}}{73}c" :db/id #edb/ref 17592186502341} {:answer/id #uuid "9410c1d1-61fd-54cf-a43b-724d7c529549" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 \\sqrt{73}}{73}c" :db/id #edb/ref 17592186502377} {:answer/id #uuid "c956c0e0-4412-5745-a727-d23da3c13826" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{73}}{2}c" :db/id #edb/ref 17592186502406} {:answer/id #uuid "ca8ceac9-cf04-5c79-81aa-b287c52dda0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}c" :db/id #edb/ref 17592186502407} {:answer/id #uuid "fd2b09bd-3bb2-5403-ac20-8ab81b1bee5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{73}c" :db/id #edb/ref 17592186502427}] :answer-field/correct {:answer/id #uuid "9410c1d1-61fd-54cf-a43b-724d7c529549" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 \\sqrt{73}}{73}c" :db/id #edb/ref 17592186502377} :answer-field/id #uuid "fc923f7d-f440-514d-b4d4-6f5c3c87c511" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502426}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "baa6d129-80bc-5fdf-803e-edf7f11daa38" :question/problem "![](images/02/02112c027add54e9bc7412151f3bd04c31d33e51eb1f96aded05b59e2489950e.png)\n\nConsider the picture shown above. Find a unit vector that is parallel to $c$. Choose the unit vector in the same direction." :question/worked-solution "![](images/d4/d4f6e1f602a4bf57830c11f0814f2fb7d6d1c2304421a32284f6bfb5a92690b5.png)\n\nIn $\\bigtriangleup AHB$ we have $\\angle AHB=90^\\circ$, $AH=4$ and $BH=1.5$. So, the Pythagorean theorem gives\n\n$$\n\\begin{aligned}\nAB &= \\sqrt{AH^2+BH^2} \\\\\n&= \\sqrt{(4)^2+(\\frac{3}{2})^2} \\\\\n&= \\sqrt{16+\\frac{9}{4}} \\\\\n&= \\frac{\\sqrt{73}}{2}\n\\end{aligned}\n$$\n\nHence, the magnitude of $c$ is $\\frac{\\sqrt{73}}{2}$. Consequently, the unit vector is\n\n$$\n\\begin{aligned}\nu &= \\frac{1}{|c|}\\cdot c \\\\\n&= \\frac{2 \\sqrt{73}}{73}c\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186502399 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1466a4c6-98a6-5c4f-ae70-75f167118229" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{9}(m+n)" :db/id #edb/ref 17592186502333} {:answer/id #uuid "643d241c-b09e-5d13-be8a-2f780530c24f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{53}(m+n)" :db/id #edb/ref 17592186502361} {:answer/id #uuid "aa33eb03-a7ce-5a51-a4de-b374da32635c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{106}}{2}(m+n)" :db/id #edb/ref 17592186502382} {:answer/id #uuid "b1e4d2ac-8630-5990-b322-df632250a0ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 \\sqrt{106}}{53}(m+n)" :db/id #edb/ref 17592186502389} {:answer/id #uuid "ed10a18f-9c1f-56ec-b6f6-99a8b4f36321" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{106}}{53}(m+n)" :db/id #edb/ref 17592186502424}] :answer-field/correct {:answer/id #uuid "ed10a18f-9c1f-56ec-b6f6-99a8b4f36321" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{106}}{53}(m+n)" :db/id #edb/ref 17592186502424} :answer-field/id #uuid "e0b0da6b-7675-58cf-9104-1d77abf27492" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502419}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "be9bc2f6-f852-5ff9-bd62-113bf0a7214a" :question/problem "![](images/13/1313a6787b3d2da5ddf917ad9cad72791bc465a265dd73cac8fe9c806afc74ec.png)\n\nConsider the picture shown above. Find a unit vector that is parallel to $m+n$. Choose the unit vector in the same direction." :question/worked-solution "First, we have to find $m+n$. According to the triangle law of addition, the resultant $m+n$ goes from the tail of $m$ to the head of $n$:\n\n![](images/fe/fe7fb47997949a3bbf0699ee771a1a05f8c8d7c6558140719d7f7a00316fc231.png)\n\nIn $\\bigtriangleup AHB$ we have $\\angle AHB=90^\\circ$, $AH=4.5$ and $BH=2.5$. So, the Pythagorean theorem gives\n\n$$\n\\begin{aligned}\nAB &= \\sqrt{AH^2+BH^2} \\\\\n&= \\sqrt{(\\frac{9}{2})^2+(\\frac{5}{2})^2} \\\\\n&= \\sqrt{\\frac{81}{4}+\\frac{25}{4}} \\\\\n&= \\frac{\\sqrt{106}}{2}\n\\end{aligned}\n$$\n\nHence, the magnitude of $m+n$ is $\\frac{\\sqrt{106}}{2}$. Consequently, the unit vector is\n\n$$\n\\begin{aligned}\nu &= \\frac{1}{|m+n|}\\cdot (m+n) \\\\\n&= \\frac{\\sqrt{106}}{53}(m+n)\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186502401 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01c33297-8862-52ba-ae7e-117f940f7825" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}(m+n)" :db/id #edb/ref 17592186502324} {:answer/id #uuid "096e92bc-d7ac-5de6-9efd-fe57622569d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{25}(m+n)" :db/id #edb/ref 17592186502327} {:answer/id #uuid "704b4538-66a1-56b4-a0be-0ab16e96992f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}(m+n)" :db/id #edb/ref 17592186502364} {:answer/id #uuid "80148278-4eda-5d27-bc27-3f70e1ec97b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}(m+n)" :db/id #edb/ref 17592186502370} {:answer/id #uuid "9fcd5af2-48b9-5a76-bea9-fec8bca5c287" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}(m+n)" :db/id #edb/ref 17592186502381}] :answer-field/correct {:answer/id #uuid "9fcd5af2-48b9-5a76-bea9-fec8bca5c287" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}(m+n)" :db/id #edb/ref 17592186502381} :answer-field/id #uuid "905b6f66-d160-5425-bc77-656eb54786d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502375}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c065984c-41d2-5c1b-a564-9053a81a79d9" :question/problem "![](images/92/92fcd6bef2b85d707fbe936c7aaa4870b64c158ca12f614123c0957dfa2a0efe.png)\n\nConsider the picture shown above. Find a unit vector that is parallel to $m+n$. Choose the unit vector in the same direction." :question/worked-solution "First, we have to find $m+n$. According to the triangle law of addition, the resultant $m+n$ goes from the tail of $m$ to the head of $n$:\n\n![](images/39/39cc72f1b5da145c6c475c0759ab8df4bead1a136edadfae7c1e17291db451b1.png)\n\nIn $\\bigtriangleup AHB$ we have $\\angle AHB=90^\\circ$, $AH=1.5$ and $BH=2$. So, the Pythagorean theorem gives\n\n$$\n\\begin{aligned}\nAB &= \\sqrt{AH^2+BH^2} \\\\\n&= \\sqrt{(\\frac{3}{2})^2+(2)^2} \\\\\n&= \\sqrt{\\frac{9}{4}+4} \\\\\n&= \\frac{5}{2}\n\\end{aligned}\n$$\n\nHence, the magnitude of $m+n$ is $\\frac{5}{2}$. Consequently, the unit vector is\n\n$$\n\\begin{aligned}\nu &= \\frac{1}{|m+n|}\\cdot (m+n) \\\\\n&= \\frac{2}{5}(m+n)\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186502872 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00e03f87-24cd-5a1f-85f6-21fa74293d0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{9}x^{-16/9} + C" :db/id #edb/ref 17592186502861} {:answer/id #uuid "04c21815-61ed-534e-ad04-3d35a62aa2bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}x^{2/9} + C" :db/id #edb/ref 17592186502862} {:answer/id #uuid "24baf7d8-b08d-52e8-aacf-0f682f6c25f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{9}x^{2/9} + C" :db/id #edb/ref 17592186502877} {:answer/id #uuid "a8a05915-00e3-5287-9df3-ec5051320330" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}x^{-7/9} + C" :db/id #edb/ref 17592186502937} {:answer/id #uuid "d1cf8368-4008-5f0c-b393-98dc8c2b3340" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{2}x^{2/9} + C" :db/id #edb/ref 17592186502951}] :answer-field/correct {:answer/id #uuid "04c21815-61ed-534e-ad04-3d35a62aa2bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}x^{2/9} + C" :db/id #edb/ref 17592186502862} :answer-field/id #uuid "23d96cda-06e3-5949-b59a-136c6439133a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502875}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1ea9e5d9-602f-5599-818f-aa6b87eda7f7" :question/problem "Given that $f(x)={x}^{-7/9}$ and that ${F}^{'}(x)=f(x)$, calculate $F(x).$ Assume $x>0$." :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe can use the power rule with $n=-\\frac{7}{9}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{-7/9}\\,\\text{d}x \\\\  & =\\frac{{x}^{-7/9+1}}{(-\\frac{7}{9}+1)}+C \\\\  & =\\frac{{x}^{2/9}}{(\\frac{2}{9})}+C \\\\  & =\\frac{9}{2}{x}^{2/9}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186502879 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ca6ae77-d4eb-5628-bf2d-2ad81668a6fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{7}x^{3/7} + C" :db/id #edb/ref 17592186502893} {:answer/id #uuid "4c8ee872-c2aa-5ac4-be85-d82e9c4ef936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{7}x^{-11/7} + C" :db/id #edb/ref 17592186502907} {:answer/id #uuid "727e1873-0bcc-5e7f-8015-b4f278888e83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}x^{-4/7} + C" :db/id #edb/ref 17592186502919} {:answer/id #uuid "c398c1d7-925b-5ee5-a8fa-61cab36aa511" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{3}x^{3/7} + C" :db/id #edb/ref 17592186502946} {:answer/id #uuid "fa18ec9f-eb7c-5a17-b374-3ab9b1f1d7cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}x^{3/7} + C" :db/id #edb/ref 17592186502961}] :answer-field/correct {:answer/id #uuid "fa18ec9f-eb7c-5a17-b374-3ab9b1f1d7cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}x^{3/7} + C" :db/id #edb/ref 17592186502961} :answer-field/id #uuid "42e84933-a55b-529f-9a48-2720e2d4ea8a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502903}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2838d5a7-98fc-5b74-838a-12c9f0c1d487" :question/problem "Given that $f(x)={x}^{-4/7}$ and that ${F}^{'}(x)=f(x)$, calculate $F(x).$ Assume $x>0$." :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe can use the power rule with $n=-\\frac{4}{7}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{-4/7}\\,\\text{d}x \\\\  & =\\frac{{x}^{-4/7+1}}{(-\\frac{4}{7}+1)}+C \\\\  & =\\frac{{x}^{3/7}}{(\\frac{3}{7})}+C \\\\  & =\\frac{7}{3}{x}^{3/7}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186502891 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12095852-ce4c-5c59-b9b1-192364d03345" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}x^{-1/4} + C" :db/id #edb/ref 17592186502866} {:answer/id #uuid "80af63e6-f7fb-5178-9c4a-d96bedf2c287" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}x^{-5/4} + C" :db/id #edb/ref 17592186502922} {:answer/id #uuid "b6d97a02-3bcb-5f85-9497-a9db944bdb62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}x^{3/4} + C" :db/id #edb/ref 17592186502942} {:answer/id #uuid "e0d65c81-82ee-5c39-9813-d7adc6117dbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3}x^{3/4} + C" :db/id #edb/ref 17592186502955} {:answer/id #uuid "e9b9e661-3c29-5b89-b031-ae16b8d1203b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}x^{3/4} + C" :db/id #edb/ref 17592186502957}] :answer-field/correct {:answer/id #uuid "e9b9e661-3c29-5b89-b031-ae16b8d1203b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}x^{3/4} + C" :db/id #edb/ref 17592186502957} :answer-field/id #uuid "10312bb4-8cd0-5e43-95e8-b8afad9283e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502865}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3a5e9787-8ef9-5e19-99e9-70e48a27adcf" :question/problem "Given that $f(x)={x}^{-1/4}$ and that ${F}^{'}(x)=f(x)$, calculate $F(x).$ Assume $x>0$." :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe can use the power rule with $n=-\\frac{1}{4}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{-1/4}\\,\\text{d}x \\\\  & =\\frac{{x}^{-1/4+1}}{(-\\frac{1}{4}+1)}+C \\\\  & =\\frac{{x}^{3/4}}{(\\frac{3}{4})}+C \\\\  & =\\frac{4}{3}{x}^{3/4}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186502900 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d738aac-dbe8-544c-8e1d-2595eca3d13b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x^{-1/4} + C" :db/id #edb/ref 17592186502880} {:answer/id #uuid "6a447127-79f8-57b4-9456-cc1dc920e3af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4x^{-5/4} + C" :db/id #edb/ref 17592186502913} {:answer/id #uuid "907f822e-c090-559b-9aba-2e8311fdac55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}x^{-9/4} + C" :db/id #edb/ref 17592186502929} {:answer/id #uuid "a06d15c6-bae0-59f6-910b-7f074de70fef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}x^{-1/4} + C" :db/id #edb/ref 17592186502935} {:answer/id #uuid "c035fb66-b8a0-5b74-85ee-dba3437624aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4x^{-1/4} + C" :db/id #edb/ref 17592186502945}] :answer-field/correct {:answer/id #uuid "c035fb66-b8a0-5b74-85ee-dba3437624aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4x^{-1/4} + C" :db/id #edb/ref 17592186502945} :answer-field/id #uuid "fc2d6790-5efe-5373-be98-3094e21928cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502963}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "40665566-8355-550d-acf0-8fd3e706266d" :question/problem "Given that $f(x)=\\frac{1}{{x}^{5/4}}$ and that ${F}^{'}(x)=f(x)$, calculate $F(x).$ Assume $x>0$." :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nNote that $\\frac{1}{{x}^{5/4}}={x}^{-5/4}.$ So, we can use the power rule with $n=-\\frac{5}{4}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{-5/4}\\,\\text{d}x \\\\  & =\\frac{{x}^{-5/4+1}}{(-\\frac{5}{4}+1)}+C \\\\  & =\\frac{{x}^{-1/4}}{(-\\frac{1}{4})}+C \\\\  & =-4{x}^{-1/4}+C \\\\  & =-\\frac{4}{{x}^{1/4}}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186502914 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0079a791-7df9-5dd7-bdf0-9fde624e2bc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{7}x^{5/7} + C" :db/id #edb/ref 17592186502860} {:answer/id #uuid "337d5a89-e1d3-5a29-83bb-5d3c21780cb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{5}x^{-2/7} + C" :db/id #edb/ref 17592186502884} {:answer/id #uuid "369f6c33-6557-5d15-9e0e-5f461bceaa53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{7}x^{-9/7} + C" :db/id #edb/ref 17592186502888} {:answer/id #uuid "384fd8fa-5c2e-5502-b800-d8f574d73937" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{5}x^{5/7} + C" :db/id #edb/ref 17592186502890} {:answer/id #uuid "b2d5023d-868a-5e5b-8467-7a19e219606f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{5}x