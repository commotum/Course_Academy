/math} :answer/value "-\\frac{5}{3}x^{-8/5} + C" :db/id #edb/ref 17592186502867} {:answer/id #uuid "16537613-9cc7-5cb0-93b0-7503cdac3395" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{3}x^{-3/5} + C" :db/id #edb/ref 17592186502868} {:answer/id #uuid "3d2dd136-0894-52fa-aaf0-fb2dc0ac21a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8}{5}x^{-13/5} + C" :db/id #edb/ref 17592186502894} {:answer/id #uuid "718ee9a6-017b-59f0-8c6e-948645ffc5f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8}{5}x^{-3/5} + C" :db/id #edb/ref 17592186502917} {:answer/id #uuid "ee7bf801-e0b2-5094-bcb2-972f291cbd49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}x^{-3/5} + C" :db/id #edb/ref 17592186502958}] :answer-field/correct {:answer/id #uuid "16537613-9cc7-5cb0-93b0-7503cdac3395" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{3}x^{-3/5} + C" :db/id #edb/ref 17592186502868} :answer-field/id #uuid "9de62160-8b1a-5cc7-89d0-103a6a2a4141" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502933}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7db6e951-901a-5fa3-9344-ecedb4022de8" :question/problem "Given that $f(x)=\\frac{1}{{x}^{8/5}}$ and that ${F}^{'}(x)=f(x)$, calculate $F(x).$ Assume $x>0$." :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nNote that $\\frac{1}{{x}^{8/5}}={x}^{-8/5}.$ So, we can use the power rule with $n=-\\frac{8}{5}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{-8/5}\\,\\text{d}x \\\\  & =\\frac{{x}^{-8/5+1}}{(-\\frac{8}{5}+1)}+C \\\\  & =\\frac{{x}^{-3/5}}{(-\\frac{3}{5})}+C \\\\  & =-\\frac{5}{3}{x}^{-3/5}+C \\\\  & =-\\frac{5}{3{x}^{3/5}}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186502927 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "226b2f3f-2db8-5997-b937-8e623b198b43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x^{-1/5} + C" :db/id #edb/ref 17592186502874} {:answer/id #uuid "343827b0-544c-50a0-9c05-84886ec4f608" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5x^{-1/5} + C" :db/id #edb/ref 17592186502885} {:answer/id #uuid "4235fe68-65b7-5e1e-8085-4b69c66d66c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5x^{-6/5} + C" :db/id #edb/ref 17592186502902} {:answer/id #uuid "638899e9-e5e6-56ef-b39c-a5c6ac140c7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6}{5}x^{-11/5} + C" :db/id #edb/ref 17592186502911} {:answer/id #uuid "f6be96f2-f588-5691-8f93-a2cb3d17caa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6}{5}x^{-1/5} + C" :db/id #edb/ref 17592186502960}] :answer-field/correct {:answer/id #uuid "343827b0-544c-50a0-9c05-84886ec4f608" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5x^{-1/5} + C" :db/id #edb/ref 17592186502885} :answer-field/id #uuid "6f2d2ada-563b-5a0b-805f-7e51d4ac3934" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502915}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8c4c3de5-5797-5a42-a678-da4fa4e6e5be" :question/problem "Given that $f(x)=\\frac{1}{{x}^{6/5}}$ and that ${F}^{'}(x)=f(x)$, calculate $F(x).$ Assume $x>0$." :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nNote that $\\frac{1}{{x}^{6/5}}={x}^{-6/5}.$ So, we can use the power rule with $n=-\\frac{6}{5}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{-6/5}\\,\\text{d}x \\\\  & =\\frac{{x}^{-6/5+1}}{(-\\frac{6}{5}+1)}+C \\\\  & =\\frac{{x}^{-1/5}}{(-\\frac{1}{5})}+C \\\\  & =-5{x}^{-1/5}+C \\\\  & =-\\frac{5}{{x}^{1/5}}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186502954 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34391ca3-ad98-50ce-8e1e-44cb8eade4a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}x^{-4/5} + C" :db/id #edb/ref 17592186502886} {:answer/id #uuid "401ae6af-30db-5402-a6f2-7d26f4d47d36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{5}x^{-14/5} + C" :db/id #edb/ref 17592186502897} {:answer/id #uuid "5b7281c4-4d4b-5557-8aaa-96752cd38280" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}x^{-9/5} + C" :db/id #edb/ref 17592186502910} {:answer/id #uuid "c4952ea7-4ee5-5ad8-9fff-3d99d83b3d92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{5}x^{-4/5} + C" :db/id #edb/ref 17592186502947} {:answer/id #uuid "ccdc31d2-bc17-5147-b336-7e1539023d9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}x^{-4/5} + C" :db/id #edb/ref 17592186502949}] :answer-field/correct {:answer/id #uuid "ccdc31d2-bc17-5147-b336-7e1539023d9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}x^{-4/5} + C" :db/id #edb/ref 17592186502949} :answer-field/id #uuid "71958d00-8def-5201-b349-02ba63662a31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502918}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "de2aa536-e15f-5af4-b511-e0e4c9d378a1" :question/problem "Given that $f(x)=\\frac{1}{{x}^{9/5}}$ and that ${F}^{'}(x)=f(x)$, calculate $F(x).$ Assume $x>0$." :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nNote that $\\frac{1}{{x}^{9/5}}={x}^{-9/5}.$ So, we can use the power rule with $n=-\\frac{9}{5}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{-9/5}\\,\\text{d}x \\\\  & =\\frac{{x}^{-9/5+1}}{(-\\frac{9}{5}+1)}+C \\\\  & =\\frac{{x}^{-4/5}}{(-\\frac{4}{5})}+C \\\\  & =-\\frac{5}{4}{x}^{-4/5}+C \\\\  & =-\\frac{5}{4{x}^{4/5}}+C.\\end{aligned}\n$$"}]
