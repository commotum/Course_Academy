x + 3 y + z})\\,\\mathbf j+(- \\frac{x y z}{\\left(2 x + 3 y + z\\right)^{2}} + \\frac{x y}{2 x + 3 y + z})\\,\\mathbf k \\\\ ∇g(-2,-3,-3) & =(\\frac{(-16)(9)-(-18)(2)}{(-16)^2})\\,\\mathbf i+(\\frac{(-16)(6)-(-18)(3)}{(-16)^2})\\,\\mathbf j+(\\frac{(-16)(6)-(-18)(1)}{(-16)^2})\\,\\mathbf k \\\\  & =(- \\frac{27}{64})\\,\\mathbf i+(- \\frac{21}{128})\\,\\mathbf j+(- \\frac{39}{128})\\,\\mathbf k \\\\  & =(- \\frac{27}{64})\\,\\mathbf i+(- \\frac{21}{128})\\,\\mathbf j+(- \\frac{39}{128})\\,\\mathbf k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186551568 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81d55087-53de-5def-b995-b769126d00f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- \\frac{1}{6})\\,\\mathbf i+(\\frac{5}{6})\\,\\mathbf j+(\\frac{5}{6})\\,\\mathbf k" :db/id #edb/ref 17592186551563} {:answer/id #uuid "8d95b908-a2f2-59f4-aaca-fa9ce8ef8b04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-6)\\,\\mathbf i+(30)\\,\\mathbf j+(30)\\,\\mathbf k" :db/id #edb/ref 17592186551569} {:answer/id #uuid "d5d497b4-435f-5624-a8cc-86c18fe21fbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- \\frac{1}{2})\\,\\mathbf i+(\\frac{1}{3})\\,\\mathbf j+(- \\frac{1}{6})\\,\\mathbf k" :db/id #edb/ref 17592186551587} {:answer/id #uuid "df4d1565-00b7-563a-8e03-f75c2a4a977d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{5}{6})\\,\\mathbf i+(\\frac{1}{6})\\,\\mathbf j+(\\frac{7}{6})\\,\\mathbf k" :db/id #edb/ref 17592186551589} {:answer/id #uuid "e47b5c86-36b9-58a9-bb61-fa06357f423b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{3})\\,\\mathbf i+(\\frac{1}{2})\\,\\mathbf j+(1)\\,\\mathbf k" :db/id #edb/ref 17592186551591}] :answer-field/correct {:answer/id #uuid "81d55087-53de-5def-b995-b769126d00f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- \\frac{1}{6})\\,\\mathbf i+(\\frac{5}{6})\\,\\mathbf j+(\\frac{5}{6})\\,\\mathbf k" :db/id #edb/ref 17592186551563} :answer-field/id #uuid "8215a9cc-2670-5708-bd8e-57a5e6c7615b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551564}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8b44dc16-f32d-574a-a1bc-0e76d52e0a5c" :question/problem "Evaluate $∇g(x,y,z)$ at the point $(3,2,1)$ if $g(x,y,z)=\\frac{x y z}{3 x - 2 y + z}.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\frac{x y z}{3 x - 2 y + z}) \\\\  & =\\frac{(3 x - 2 y + z)(y z)-(x y z)(3)}{(3 x - 2 y + z)^2} \\\\  & =- \\frac{y z \\left(2 y - z\\right)}{\\left(3 x - 2 y + z\\right)^{2}} \\\\ {g}_{y}(x,y,z) & =\\frac{∂}{∂y}(\\frac{x y z}{3 x - 2 y + z}) \\\\  & =\\frac{(3 x - 2 y + z)(x z)-(x y z)(-2)}{(3 x - 2 y + z)^2} \\\\  & =\\frac{x z \\left(3 x + z\\right)}{\\left(3 x - 2 y + z\\right)^{2}} \\\\ {g}_{z}(x,y,z) & =\\frac{∂}{∂z}(\\frac{x y z}{3 x - 2 y + z}) \\\\  & =\\frac{(3 x - 2 y + z)(x y)-(x y z)(1)}{(3 x - 2 y + z)^2} \\\\  & =\\frac{x y \\left(3 x - 2 y\\right)}{\\left(3 x - 2 y + z\\right)^{2}}\\end{aligned}\n$$\n\nTherefore, the gradient is\n\n$$\n\\begin{aligned}∇g(x,y,z) & ={g}_{x}(x,y,z)\\,\\mathbf i+{g}_{y}(x,y,z)\\,\\mathbf j+{g}_{z}(x,y,z)\\,\\mathbf k \\\\  & =(- \\frac{3 x y z}{\\left(3 x - 2 y + z\\right)^{2}} + \\frac{y z}{3 x - 2 y + z})\\,\\mathbf i+(\\frac{2 x y z}{\\left(3 x - 2 y + z\\right)^{2}} + \\frac{x z}{3 x - 2 y + z})\\,\\mathbf j+(- \\frac{x y z}{\\left(3 x - 2 y + z\\right)^{2}} + \\frac{x y}{3 x - 2 y + z})\\,\\mathbf k \\\\ ∇g(3,2,1) & =(\\frac{(6)(2)-(6)(3)}{(6)^2})\\,\\mathbf i+(\\frac{(6)(3)-(6)(-2)}{(6)^2})\\,\\mathbf j+(\\frac{(6)(6)-(6)(1)}{(6)^2})\\,\\mathbf k \\\\  & =(- \\frac{1}{6})\\,\\mathbf i+(\\frac{5}{6})\\,\\mathbf j+(\\frac{5}{6})\\,\\mathbf k \\\\  & =(- \\frac{1}{6})\\,\\mathbf i+(\\frac{5}{6})\\,\\mathbf j+(\\frac{5}{6})\\,\\mathbf k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186552406 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ad87764-6044-5767-902d-f845c340fce7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-3$ or $12$" :db/id #edb/ref 17592186551881} {:answer/id #uuid "7236c074-3016-5112-a3b9-0ad8989ea929" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-12$ or $-3$" :db/id #edb/ref 17592186551936} {:answer/id #uuid "9133a202-35d2-56e1-8e7d-2d811e679fd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-18$ or $3$" :db/id #edb/ref 17592186552019} {:answer/id #uuid "b0458107-3a29-5b00-817a-03a49afcbbfc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$12$ or $18$" :db/id #edb/ref 17592186552090} {:answer/id #uuid "e42a61a8-e821-58ec-be90-1c90c3e1e586" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ or $18$" :db/id #edb/ref 17592186552193}] :answer-field/correct {:answer/id #uuid "5ad87764-6044-5767-902d-f845c340fce7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-3$ or $12$" :db/id #edb/ref 17592186551881} :answer-field/id #uuid "e7cd6986-58f2-5df8-9623-61bd4f8f7c74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552386}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0fd09d79-cd92-571a-b908-4f0df92196ae" :question/math-academy-id "q-154703" :question/problem "If $|3-\\frac{2}{3}y|=5,$ then $y=$" :question/worked-solution "Either the positive or negative of the expression inside the absolute value must be equal to the right-hand side of the equation.\n\nSo, we set up the two corresponding equations and solve them independently:\n\n- If $|3-\\frac{2}{3}y|=3-\\frac{2}{3}y,$ we obtain:\n\n$$\n\\begin{aligned}|3-\\frac{2}{3}y| & =5 \\\\ 3-\\frac{2}{3}y & =5 \\\\ -\\frac{2}{3}y & =2\\end{aligned}\n$$\n\nMultiplying both sides of the equation by $-\\frac{3}{2}$ gives\n\n$$\n\\begin{aligned}-\\frac{2}{3}y & =2 \\\\ (-\\frac{3}{2})\\cdot (-\\frac{2}{3}y) & =(-\\frac{3}{2})\\cdot (2) \\\\ (\\cancel{-\\frac{3}{2}})\\cdot (\\cancel{-\\frac{2}{3}}y) & =-\\frac{6}{2} \\\\ y & =-3.\\end{aligned}\n$$\n\n- If $|3-\\frac{2}{3}y|=-(3-\\frac{2}{3}y),$ we obtain:\n\n$$\n\\begin{aligned}|3-\\frac{2}{3}y| & =5 \\\\ -(3-\\frac{2}{3}y) & =5 \\\\ -3+\\frac{2}{3}y & =5 \\\\ \\frac{2}{3}y & =8\\end{aligned}\n$$\n\nMultiplying both sides of the equation by $\\frac{3}{2}$ gives\n\n$$\n\\begin{aligned}\\frac{2}{3}y & =8 \\\\ (\\frac{3}{2})\\cdot (\\frac{2}{3}y) & =(\\frac{3}{2})\\cdot (8) \\\\ (\\cancel{\\frac{3}{2}})\\cdot (\\cancel{\\frac{2}{3}}y) & =\\frac{24}{2} \\\\ y & =12.\\end{aligned}\n$$\n\nTherefore, the solutions are $y=-3$ and $y=12.$"} {:db/id #edb/ref 17592186552407 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96a9999f-2cfe-5e9a-9d15-879182a3d07c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186552028}] :answer-field/correct {:answer/id #uuid "96a9999f-2cfe-5e9a-9d15-879182a3d07c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186552028} :answer-field/id #uuid "3710dd2a-0992-5c4b-b6c5-20c3ea7c9d8f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186552283} {:answer-field/choices [{:answer/id #uuid "39ef944c-140e-545c-9889-fb5a89c666b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186551804}] :answer-field/correct {:answer/id #uuid "39ef944c-140e-545c-9889-fb5a89c666b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186551804} :answer-field/id #uuid "43029c72-41de-531d-9dff-6296500d2b7a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186552292}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1059df0b-e279-5183-9a0b-f6c9c0f186a7" :question/math-academy-id "q-325842" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\operatorname{sin}⁡u=\\frac{7}{25},\\,\\operatorname{cos}⁡u=\\frac{24}{25},\\,\\operatorname{cos}⁡v=\\frac{\\sqrt{3}}{2}.\n$$\n\nGiven that both $u$ and $v$ lie in the first quadrant, then\n\n| $\\operatorname{cos}⁡(u-v)$ | $=$ | {{field-1}} $\\sqrt{3}\\,+\\,$ {{field-2}} |\n| --- | --- | --- |\n|  |  | $50$ |" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nWe know the values of $\\operatorname{sin}⁡u$, $\\operatorname{cos}⁡u$, and $\\operatorname{cos}⁡v.$ To find the missing value of $\\operatorname{sin}⁡v,$ we can use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡v+{cos}^{2}⁡v=1\\,⟹\\,{sin}^{2}⁡v=1-{cos}^{2}⁡v\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{sin}^{2}⁡v & =1-{cos}^{2}⁡v \\\\  & =1-{(\\frac{\\sqrt{3}}{2})}^{2} \\\\  & =1-\\frac{(\\sqrt{3})^{2}}{{2}^{2}} \\\\  & =1-\\frac{3}{4} \\\\  & =\\frac{4}{4}-\\frac{3}{4} \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡v & =\\pm \\sqrt{\\frac{1}{4}} \\\\  & =\\pm \\frac{1}{2}.\\end{aligned}\n$$\n\nSince $v$ lies in the first quadrant, where sine is positive, we take\n\n$$\n\\operatorname{sin}⁡v=\\frac{1}{2}.\n$$\n\nWe can now apply the difference formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(u-v) & =\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v \\\\  & =(\\frac{24}{25})(\\frac{\\sqrt{3}}{2})+(\\frac{7}{25})(\\frac{1}{2}) \\\\  & =\\frac{24\\sqrt{3}}{50}+\\frac{7}{50} \\\\  & =\\frac{24\\sqrt{3}+7}{50}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186552416 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4692ff53-10f8-5d92-a62c-7ea8c8eb0b75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186551838} {:answer/id #uuid "85e69bf9-0ffa-5440-9692-3b79b4593ab1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186551986} {:answer/id #uuid "9f2fef72-fcfd-58d8-bc85-22f6495c4ede" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186552050} {:answer/id #uuid "a82aa644-63bf-5607-827a-5038ebc9e460" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186552067} {:answer/id #uuid "d741e5c8-f214-5380-b086-fc6bdd2df65d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186552172}] :answer-field/correct {:answer/id #uuid "9f2fef72-fcfd-58d8-bc85-22f6495c4ede" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186552050} :answer-field/id #uuid "4db31d4f-92dd-5a4c-a9aa-c0b389b1913c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552296}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1ed725f0-66d2-5a2d-ad80-26e42df0423f" :question/math-academy-id "q-119581" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\operatorname{cos}⁡u=\\frac{5}{13},\\,\\operatorname{sin}⁡v=-\\frac{\\sqrt{3}}{2},\\,\\operatorname{cos}⁡v=-\\frac{1}{2}.\n$$\n\nGiven that $u$ lies in the first quadrant, and\n\n$$\n\\operatorname{cos}⁡(u+v)=\\frac{a\\sqrt{3}-b}{26},\n$$\n\ncalculate the value of $a+b.$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nWe know the values of $\\operatorname{cos}⁡u,$ $\\operatorname{sin}⁡v,$ and $\\operatorname{cos}⁡v.$ To find the missing value of $\\operatorname{sin}⁡u,$ we can use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡u+{cos}^{2}⁡u=1\\,⟹\\,{sin}^{2}⁡u=1-{cos}^{2}⁡u\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{sin}^{2}⁡u & =1-{cos}^{2}⁡u \\\\  & =1-{(\\frac{5}{13})}^{2} \\\\  & =1-\\frac{{5}^{2}}{{13}^{2}} \\\\  & =1-\\frac{25}{169} \\\\  & =\\frac{169}{169}-\\frac{25}{169} \\\\  & =\\frac{144}{169}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡u & =\\pm \\sqrt{\\frac{144}{169}} \\\\  & =\\pm \\frac{12}{13}.\\end{aligned}\n$$\n\nWe're given that $u$ lies in the first quadrant, where sine is positive. So, we disregard the negative value, and we have \n\n$$\n\\operatorname{sin}⁡u=\\frac{12}{13}.\n$$\n\nWe can now apply the sum formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(u+v) & =\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v \\\\  & =(\\frac{5}{13})(-\\frac{1}{2})-(\\frac{12}{13})(-\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{5}{26}+\\frac{12\\sqrt{3}}{26} \\\\  & =\\frac{12\\sqrt{3}-5}{26}\\end{aligned}\n$$\n\nFinally, $a=12,b=5,$ and $a+b=17.$"} {:db/id #edb/ref 17592186552417 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "196dbf90-694f-56e1-bd9a-bacffff31ed3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}1,\\, & 0<y<1 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186551718} {:answer/id #uuid "4ca12552-8ad4-5d6a-8884-8f4afde5830a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}5,\\, & 0<y<0.2 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186551849} {:answer/id #uuid "52cef4e5-3e19-5e35-bee0-384a657d1c16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}0.5y,\\, & 0<y<2 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186551858} {:answer/id #uuid "a623ad96-993c-5f91-994d-d43006007fb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}2y,\\, & 0<y<1 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186552064} {:answer/id #uuid "d7e7845f-1c6b-5825-bbe7-1626dc1077e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}0.5,\\, & 0<y<2 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186552175}] :answer-field/correct {:answer/id #uuid "196dbf90-694f-56e1-bd9a-bacffff31ed3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}1,\\, & 0<y<1 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186551718} :answer-field/id #uuid "8bffd42c-4c16-5c26-a4d3-ff06e8bcf1b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552337}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1f799a56-7472-58ef-998d-84e22fb88853" :question/math-academy-id "q-110126" :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}5{x}^{4},\\, & 0<x<1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nIf $Y=1-{X}^{5},$ then what is the probability density function of $Y?$" :question/worked-solution "To compute the probability density function of a random variable $Y,$ where $Y=u(X)$ is a continuous, strictly monotonic function of a continuous random variable $X,$ we follow two steps:\n\n- First, we find an expression for ${F}_{Y}$ terms of ${F}_{X},$ where ${F}_{Y}$ and ${F}_{X}$ are the cumulative distribution functions of $Y$ and $X,$ respectively.\n\n- Then, we differentiate ${F}_{Y}$ to get the probability density function ${f}_{Y}.$\n\nBefore we start, note that $Y=1-{X}^{5}$ is a strictly decreasing function of $X.$ Moreover, for $0<x<1,$ we have $0<y<1.$\n\n![](images/05/05534475aecc1d0ebad2234f1259d1b6fd1c6183e47ad763f17c87c5fdb06afb.png)\n\nNow, using the definition of the cumulative distribution of $Y,$ for $0<y<1,$ we have\n\n$$\n\\begin{aligned}{F}_{Y}(y) & =P(Y\\le y) \\\\  & =P(1-{X}^{5}\\le y) \\\\  & =P(-{X}^{5}\\le y-1) \\\\  & =P(X\\ge (1-y)^{1/5}) \\\\  & =1-{F}_{X}((1-y)^{1/5})\\end{aligned}\n$$\n\nTo compute the PDF ${f}_{Y}(y)$ for $0<y<1,$ we differentiate ${F}_{Y}$ with respect to $y$ using the chain rule. This gives\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={F}_{Y}^{′}(y) \\\\  & =0-(-\\frac{1}{5(1-y)^{4/5}})\\cdot {F}_{X}^{′}((1-y)^{1/5}) \\\\  & =\\frac{1}{5(1-y)^{4/5}}\\cdot {f}_{X}((1-y)^{1/5}).\\end{aligned}\n$$\n\nApplying the definition of ${f}_{X},$ we finally arrive at\n\n$$\n\\begin{aligned}{f}_{Y}(y) & =\\frac{1}{5(1-y)^{4/5}}\\cdot {f}_{X}((1-y)^{1/5}) \\\\  & =\\frac{1}{5(1-y)^{4/5}}\\cdot 5{((1-y)^{1/5})}^{4} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the full expression for the PDF of $Y$ is\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}1,\\, & 0<y<1 \\\\ 0,\\, & \\text{otherwise}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186552419 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "354f21b2-96ab-5d34-8629-17b1cd8d23d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186551791} {:answer/id #uuid "5ee3cf3b-86e3-5e57-83f5-b5451cd4c7b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186551893} {:answer/id #uuid "800e78fd-bc77-5f21-8b03-8b51fc29c534" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186551970} {:answer/id #uuid "c3ccdf0e-7384-5c78-bdab-6715b3b614a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186552133} {:answer/id #uuid "f270c863-ecf9-5d37-bac9-47ebceb975b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186552232}] :answer-field/correct {:answer/id #uuid "354f21b2-96ab-5d34-8629-17b1cd8d23d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186551791} :answer-field/id #uuid "3231d9e1-5db0-532b-9d06-68eafedeb402" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552279}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "226b9b94-926b-577f-834a-35ff659d1159" :question/math-academy-id "q-102338" :question/problem "Given the orthogonal basis $B$ of ${R}^{2}$ and the vector $x$ below, find the value of $15{x}_{2},$ where ${x}_{2}$ is the second component of $[x]_{B}.$\n\n$$\nB=\\{[\\begin{aligned}-3 \\\\ 4\\end{aligned}],[\\begin{aligned}4 \\\\ 3\\end{aligned}]\\},\\,x=[\\begin{aligned}10 \\\\ -15\\end{aligned}]\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2}.$ \n\nSince $B$ is an orthogonal basis, we have that $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$, where ${x}_{i}=\\frac{x\\cdot {q}_{i}}{{q}_{i}\\cdot {q}_{i}}.$ Computing ${x}_{2},$ we obtain \n\n$$\n\\begin{aligned}{x}_{2} & =\\frac{x\\cdot {q}_{2}}{{q}_{2}\\cdot {q}_{2}} \\\\  & =\\frac{10\\cdot 4+(-15)\\cdot 3}{{4}^{2}+{3}^{2}} \\\\  & =\\frac{40-45}{25} \\\\  & =\\frac{-5}{25} \\\\  & =-\\frac{1}{5}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n15{x}_{2}=15\\cdot (-\\frac{1}{5})=-3.\n$$"} {:db/id #edb/ref 17592186552427 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14aab469-1f71-5582-a61c-34ca084d5f6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186551707} {:answer/id #uuid "216e442c-c072-5728-a705-afb102d6fbea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186551739} {:answer/id #uuid "285237b4-7d17-5283-a8ae-a41635f56b71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186551757} {:answer/id #uuid "295f06f2-f22f-5444-b217-5a8a03ad09ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186551759} {:answer/id #uuid "a3d3096c-e5b3-55c4-80ea-469e433551fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186552060}] :answer-field/correct {:answer/id #uuid "a3d3096c-e5b3-55c4-80ea-469e433551fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186552060} :answer-field/id #uuid "831aaab2-d476-5739-b94e-9e3263993fc7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552330}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3f0420a1-666b-5191-842f-3d2bdb44e681" :question/math-academy-id "q-141440" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\operatorname{cos}⁡v=\\frac{\\sqrt{2}}{3},\\,\\operatorname{sin}⁡v=\\frac{\\sqrt{7}}{3},\\,\\operatorname{sin}⁡u=-\\frac{5}{13}.\n$$\n\nGiven that $u$ lies in the third quadrant, and\n\n$$\n\\operatorname{cos}⁡(u+v)=\\frac{a\\sqrt{7}-b\\sqrt{2}}{39},\n$$\n\ncalculate the value of $a+b.$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nWe know the values of $\\operatorname{cos}⁡v,$ $\\operatorname{sin}⁡v,$ and $\\operatorname{sin}⁡u.$ To find the missing value of $\\operatorname{cos}⁡u,$ we can use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡u+{cos}^{2}⁡u=1\\,⟹\\,{cos}^{2}⁡u=1-{sin}^{2}⁡u\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡u & =1-{sin}^{2}⁡u \\\\  & =1-{(-\\frac{5}{13})}^{2} \\\\  & =1-\\frac{{5}^{2}}{{13}^{2}} \\\\  & =1-\\frac{25}{169} \\\\  & =\\frac{169}{169}-\\frac{25}{169} \\\\  & =\\frac{144}{169}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡u & =\\pm \\sqrt{\\frac{144}{169}} \\\\  & =\\pm \\frac{12}{13}.\\end{aligned}\n$$\n\nWe're given that $u$ lies in the third quadrant, where cosine is negative. So, we disregard the positive value, and we have\n\n$$\n\\operatorname{cos}⁡u=-\\frac{12}{13}.\n$$\n\nWe can now apply the sum formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(u+v) & =\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v \\\\  & =(-\\frac{12}{13})(\\frac{\\sqrt{2}}{3})-(-\\frac{5}{13})(\\frac{\\sqrt{7}}{3}) \\\\  & =-\\frac{12\\sqrt{2}}{39}+\\frac{5\\sqrt{7}}{39} \\\\  & =\\frac{5\\sqrt{7}-12\\sqrt{2}}{39}\\end{aligned}\n$$\n\nFinally, $a=5,b=12,$ and $a+b=17.$"} {:db/id #edb/ref 17592186552429 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e66c7b2-03cf-5b40-acd9-587dadb9ac9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186551818} {:answer/id #uuid "6ddca841-e0d9-56b3-8b19-47941defcf69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186551925} {:answer/id #uuid "8d53cd2a-8bc8-5203-a4b8-0c7848792908" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186552009} {:answer/id #uuid "b87397f3-ec91-5023-b6e1-c9d09c5dfccf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186552110} {:answer/id #uuid "bfd58ea1-aff0-5d22-8f67-8c8bb8e6db07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186552125}] :answer-field/correct {:answer/id #uuid "6ddca841-e0d9-56b3-8b19-47941defcf69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186551925} :answer-field/id #uuid "afbfba15-89cd-5f8b-8d11-e527ad3d57cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552358}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "43bdc32f-8f5e-5fac-84f7-776394b1cc9e" :question/math-academy-id "q-119592" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\operatorname{sin}⁡u=\\frac{3}{4},\\,\\operatorname{cos}⁡u=-\\frac{\\sqrt{7}}{4},\\,\\operatorname{cos}⁡v=\\frac{\\sqrt{2}}{2}.\n$$\n\nGiven that $v$ lies in the first quadrant, and\n\n$$\n\\operatorname{cos}⁡(u-v)=\\frac{a\\sqrt{2}-b\\sqrt{14}}{8},\n$$\n\ncalculate the value of $a+b.$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nWe know the values of $\\operatorname{sin}⁡u$, $\\operatorname{cos}⁡u$, and $\\operatorname{cos}⁡v.$ To find the missing value of $\\operatorname{sin}⁡v,$ we can use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡v+{cos}^{2}⁡v=1\\,⟹\\,{sin}^{2}⁡v=1-{cos}^{2}⁡v\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{sin}^{2}⁡v & =1-{cos}^{2}⁡v \\\\  & =1-{(\\frac{\\sqrt{2}}{2})}^{2} \\\\  & =1-\\frac{(\\sqrt{2})^{2}}{{2}^{2}} \\\\  & =1-\\frac{2}{4} \\\\  & =1-\\frac{1}{2} \\\\  & =\\frac{2}{2}-\\frac{1}{2} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡v & =\\pm \\sqrt{\\frac{1}{2}} \\\\  & =\\pm \\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nWe're given that $v$ lies in the first quadrant, where sine is positive. So, we disregard the negative value, and we have \n\n$$\n\\operatorname{sin}⁡v=\\frac{\\sqrt{2}}{2}.\n$$\n\nWe can now apply the difference formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(u-v) & =\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v \\\\  & =(-\\frac{\\sqrt{7}}{4})(\\frac{\\sqrt{2}}{2})+(\\frac{3}{4})(\\frac{\\sqrt{2}}{2}) \\\\  & =-\\frac{\\sqrt{14}}{8}+\\frac{3\\sqrt{2}}{8} \\\\  & =\\frac{3\\sqrt{2}-1\\sqrt{14}}{8}\\end{aligned}\n$$\n\nFinally, $a=3,b=1,$ and $a+b=4.$"} {:db/id #edb/ref 17592186552433 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a31093c-3bc1-5604-8b68-60bb29456071" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}21 \\\\ 25\\end{aligned}]" :db/id #edb/ref 17592186551690} {:answer/id #uuid "1c236ae5-4aa5-5314-b3d7-d9f14364f42d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}62 \\\\ 45\\end{aligned}]" :db/id #edb/ref 17592186551725} {:answer/id #uuid "55bb8ae9-83ab-5bd6-b3fa-7323cb3b3ab7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}62 & 45\\end{aligned}]" :db/id #edb/ref 17592186551870} {:answer/id #uuid "b3b3471b-58e2-538a-96d3-b94d24b16af3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}15 \\\\ 31\\end{aligned}]" :db/id #edb/ref 17592186552101} {:answer/id #uuid "f9195545-d1e3-513f-91e6-f5228e90b375" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}15 & 31\\end{aligned}]" :db/id #edb/ref 17592186552246}] :answer-field/correct {:answer/id #uuid "1c236ae5-4aa5-5314-b3d7-d9f14364f42d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}62 \\\\ 45\\end{aligned}]" :db/id #edb/ref 17592186551725} :answer-field/id #uuid "560cd508-cebe-5335-8021-8a9e70cdc673" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552304}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "47594296-da7d-5903-b008-c5f5265a8817" :question/math-academy-id "q-269489" :question/problem "Consider the function $L:{R}^{2}\\to R$ defined by $L(x)={(\\frac{1}{2}Ax-b)}^{T}(\\frac{1}{2}Ax-b)$ where \n\n$$\nA=[\\begin{aligned}2 & 1 \\\\ 4 & 3\\end{aligned}],\\,b=[\\begin{aligned}5 \\\\ 3\\end{aligned}].\n$$\n\nWhat is ${∇}_{x}L(x)$ at $x=[\\begin{aligned}7 \\\\ 2\\end{aligned}]?$" :question/worked-solution "We can solve this problem by applying the chain rule for gradients.\n\nLet $y=\\frac{1}{2}Ax-b.$ Then, $L(x)={y}^{T}y,$ and\n\n$$\n{∇}_{x}L={(\\frac{\\text{d}L}{\\text{d}x})}^{T}={(\\frac{\\text{d}y}{\\text{d}x})}^{T}\\cdot {(\\frac{\\text{d}L}{\\text{d}y})}^{T}.\n$$\n\nNow, since \n\n$$\n\\frac{\\text{d}}{\\text{d}y}({y}^{T}y)=2{y}^{T}\\,\\text{and}\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}Ax-b)=\\frac{1}{2}A,\n$$\n\nwe have that \n\n$$\n\\begin{aligned}{∇}_{x}L & ={(\\frac{\\text{d}y}{\\text{d}x})}^{T}\\cdot {(\\frac{\\text{d}L}{\\text{d}y})}^{T} \\\\  & ={(\\frac{1}{2}A)}^{T}\\cdot 2y.\\end{aligned}\n$$\n\nEvaluating at $x=[\\begin{aligned}7 \\\\ 2\\end{aligned}]$, we get\n\n$$\n\\begin{aligned}{∇}_{x}L & ={(\\frac{1}{2}A)}^{T}\\cdot 2y \\\\  & ={A}^{T}(\\frac{1}{2}Ax-b) \\\\  & ={[\\begin{aligned}2 & 1 \\\\ 4 & 3\\end{aligned}]}^{T}(\\frac{1}{2}\\cdot [\\begin{aligned}2 & 1 \\\\ 4 & 3\\end{aligned}]\\cdot [\\begin{aligned}7 \\\\ 2\\end{aligned}]-[\\begin{aligned}5 \\\\ 3\\end{aligned}]) \\\\  & =[\\begin{aligned}2 & 4 \\\\ 1 & 3\\end{aligned}](\\frac{1}{2}\\cdot [\\begin{aligned}16 \\\\ 34\\end{aligned}]-[\\begin{aligned}5 \\\\ 3\\end{aligned}]) \\\\  & =[\\begin{aligned}2 & 4 \\\\ 1 & 3\\end{aligned}]([\\begin{aligned}8 \\\\ 17\\end{aligned}]-[\\begin{aligned}5 \\\\ 3\\end{aligned}]) \\\\  & =[\\begin{aligned}2 & 4 \\\\ 1 & 3\\end{aligned}][\\begin{aligned}3 \\\\ 14\\end{aligned}] \\\\  & =[\\begin{aligned}62 \\\\ 45\\end{aligned}].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186552438 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13e18065-a00c-590c-bd30-b3697aef1703" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186551704} {:answer/id #uuid "321078fd-ddc7-5fa9-8ffd-02d0df3acd41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186551784} {:answer/id #uuid "367fba42-a7e2-593f-bdf2-3db31fe9789a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186551796} {:answer/id #uuid "5b80064a-5abe-5355-884e-5d229396f3a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186551885} {:answer/id #uuid "c88bd8a5-d479-58a6-8d0c-28fb55f5c168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186552143}] :answer-field/correct {:answer/id #uuid "c88bd8a5-d479-58a6-8d0c-28fb55f5c168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186552143} :answer-field/id #uuid "77b4248f-fe82-5a6e-b664-fd773a876604" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552322}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "50ab1b1c-89b6-5bde-a50d-34d9fce11246" :question/math-academy-id "q-141443" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\operatorname{cos}⁡u=-\\frac{\\sqrt{15}}{4},\\,\\operatorname{sin}⁡u=\\frac{1}{4},\\,\\operatorname{sin}⁡v=-\\frac{2\\sqrt{5}}{5}.\n$$\n\nGiven that $v$ lies in the third quadrant, and\n\n$$\n\\operatorname{cos}⁡(u+v)=\\frac{a\\sqrt{3}+b\\sqrt{5}}{20},\n$$\n\ncalculate the value of $a+b.$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nWe know the values of $\\operatorname{cos}⁡u,$ $\\operatorname{sin}⁡u,$ and $\\operatorname{sin}⁡v.$ To find the missing value of $\\operatorname{cos}⁡v,$ we can use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡v+{cos}^{2}⁡v=1\\,⟹\\,{cos}^{2}⁡v=1-{sin}^{2}⁡v\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡v & =1-{sin}^{2}⁡v \\\\  & =1-{(\\frac{2\\sqrt{5}}{5})}^{2} \\\\  & =1-\\frac{(2\\sqrt{5})^{2}}{{5}^{2}} \\\\  & =1-\\frac{20}{25} \\\\  & =\\frac{25}{25}-\\frac{20}{25} \\\\  & =\\frac{5}{25}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡v & =\\pm \\sqrt{\\frac{5}{25}} \\\\  & =\\pm \\frac{\\sqrt{5}}{5}.\\end{aligned}\n$$\n\nWe're given that $v$ lies in the third quadrant, where cosine is negative. So, we disregard the positive value, and we have\n\n$$\n\\operatorname{cos}⁡v=-\\frac{\\sqrt{5}}{5}.\n$$\n\nWe can now apply the sum formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(u+v) & =\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v \\\\  & =(-\\frac{\\sqrt{15}}{4})(-\\frac{\\sqrt{5}}{5})-(\\frac{1}{4})(-\\frac{2\\sqrt{5}}{5}) \\\\  & =\\frac{5\\sqrt{3}}{20}+\\frac{2\\sqrt{5}}{20} \\\\  & =\\frac{5\\sqrt{3}+2\\sqrt{5}}{20}\\end{aligned}\n$$\n\nFinally, $a=5,b=2,$ and $a+b=7.$"} {:db/id #edb/ref 17592186552442 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e87a69a-83da-50aa-90f7-3e2c57996375" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n)=\\frac{87}{{6}^{n}},\\,n\\ge 1" :db/id #edb/ref 17592186551730} {:answer/id #uuid "4c8a985f-6cf4-5d99-a382-0c90a98f52a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n)=\\frac{6}{{78}^{n}},\\,n\\ge 1" :db/id #edb/ref 17592186551848} {:answer/id #uuid "6db750dc-fe88-55f5-8fc6-6406faf86ca2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n)=\\frac{78}{{13}^{n}},\\,n\\ge 1" :db/id #edb/ref 17592186551924} {:answer/id #uuid "9bee3c06-979d-5760-b511-9139eafe8ac6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n)=\\frac{6}{{13}^{n}},\\,n\\ge 1" :db/id #edb/ref 17592186552043} {:answer/id #uuid "ca0cfecd-0318-5e34-9d02-cc04ef5ef74e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n)=\\frac{78}{{6}^{n}},\\,n\\ge 1" :db/id #edb/ref 17592186552148}] :answer-field/correct {:answer/id #uuid "ca0cfecd-0318-5e34-9d02-cc04ef5ef74e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n)=\\frac{78}{{6}^{n}},\\,n\\ge 1" :db/id #edb/ref 17592186552148} :answer-field/id #uuid "ed7fe9ae-7173-5401-b140-6234f32b66d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552391}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5e4e0f75-9894-567b-a1a8-c012ad934066" :question/math-academy-id "q-73268" :question/problem "What is the explicit formula for the $n$th term of the geometric sequence given by\n\n$$\nf(n+1)=\\frac{f(n)}{6},\\,\\,f(1)=13,\\,\\,n\\ge 1?\n$$" :question/worked-solution "First, let's rewrite our recursive formula, as follows:\n\n$$\n\\begin{aligned}f(n+1)=\\frac{f(n)}{6}=\\frac{1}{6}f(n)\\end{aligned}\n$$\n\nThe explicit formula for the $n$th term of a geometric sequence is\n\n$$\nf(n)=f(1)\\cdot {r}^{n-1},\\,n\\ge 1.\n$$\n\nSo, we must determine the first term $f(1)$ and the common ratio $r.$\n\nWe are given that the first term is $f(1)=13.$ To find the common ratio, we compare the given sequence with the general recursive formula for a geometric sequence:\n\n$$\nf(n+1)=r\\cdot f(n)\n$$\n\n \n\nFrom the above, we see that $r=\\frac{1}{6}.$\n\nSubstituting $f(1)=13$ and $r=\\frac{1}{6}$ into the formula for the $n$th term, we obtain\n\n$$\n\\begin{aligned}f(n) & =f(1)\\cdot {r}^{n-1} \\\\  & =13\\cdot {(\\frac{1}{6})}^{n-1}.\\end{aligned}\n$$\n\nWe can simplify further by manipulating the exponents as follows:\n\n$$\n\\begin{aligned}f(n) & =13\\cdot {(\\frac{1}{6})}^{n-1} \\\\  & =13\\cdot {(\\frac{1}{6})}^{-1}\\cdot {(\\frac{1}{6})}^{n} \\\\  & =13\\cdot \\frac{6}{1}\\cdot {(\\frac{1}{6})}^{n} \\\\  & =78\\cdot \\frac{1}{{6}^{n}} \\\\  & =\\frac{78}{{6}^{n}}\\end{aligned}\n$$\n\nTherefore, the formula for the $n$th term is\n\n$$\nf(n)=\\frac{78}{{6}^{n}},\\,n\\ge 1.\n$$"} {:db/id #edb/ref 17592186552460 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7fd779df-49e5-5e25-be2d-c22bba641aa2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186551969} {:answer/id #uuid "8b795d79-1d06-5f11-b31e-dc17f7053fbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186552006} {:answer/id #uuid "936f28df-a16a-538a-be6a-eec59f948467" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186552022} {:answer/id #uuid "e76101c8-badb-5987-9480-28be10e44a22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186552205} {:answer/id #uuid "f696b631-7dc2-5a31-af20-dff99b948f2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186552240}] :answer-field/correct {:answer/id #uuid "8b795d79-1d06-5f11-b31e-dc17f7053fbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186552006} :answer-field/id #uuid "de040dcd-65e4-5530-8e4b-808b33262dec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552383}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "77e70b3f-8704-511e-87c9-d67cfcbe9ec9" :question/math-academy-id "q-141441" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\operatorname{cos}⁡u=\\frac{5}{7},\\,\\operatorname{sin}⁡u=-\\frac{2\\sqrt{6}}{7},\\,\\operatorname{cos}⁡v=-\\frac{1}{2}.\n$$\n\nGiven that $v$ lies in the third quadrant, and\n\n$$\n\\operatorname{cos}⁡(u+v)=-\\frac{a\\sqrt{2}+b}{14},\n$$\n\ncalculate the value of $a+b.$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nWe know the values of $\\operatorname{cos}⁡u,$ $\\operatorname{sin}⁡u,$ and $\\operatorname{cos}⁡v.$ To find the missing value of $\\operatorname{sin}⁡v,$ we can use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡v+{cos}^{2}⁡v=1\\,⟹\\,{sin}^{2}⁡v=1-{cos}^{2}⁡v\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{sin}^{2}⁡v & =1-{cos}^{2}⁡v \\\\  & =1-{(-\\frac{1}{2})}^{2} \\\\  & =1-\\frac{1}{{2}^{2}} \\\\  & =1-\\frac{1}{4} \\\\  & =\\frac{4}{4}-\\frac{1}{4} \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡v & =\\pm \\sqrt{\\frac{3}{4}} \\\\  & =\\pm \\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$\n\nWe're given that $v$ lies in the third quadrant, where sine is negative. So, we disregard the positive value, and we have\n\n$$\n\\operatorname{sin}⁡v=-\\frac{\\sqrt{3}}{2}.\n$$\n\nWe can now apply the sum formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(u+v) & =\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v \\\\  & =(\\frac{5}{7})(-\\frac{1}{2})-(-\\frac{2\\sqrt{6}}{7})(-\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{5}{14}-\\frac{6\\sqrt{2}}{14} \\\\  & =-\\frac{6\\sqrt{2}+5}{14}\\end{aligned}\n$$\n\nFinally, $a=6,b=5,$ and $a+b=11.$"} {:db/id #edb/ref 17592186552467 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b7bf6b1-d530-59ea-9dc8-7b99db3d0094" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{4y}{3}, & \\,2<y<4 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186551692} {:answer/id #uuid "165a73fa-f469-5a44-86ef-009948eb5611" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{y\\operatorname{ln}⁡2}, & \\,1<y<2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186551713} {:answer/id #uuid "1fc1534a-6a01-51a4-9c6e-4184dd7e0bcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{y}{6}, & \\,1<y<2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186551733} {:answer/id #uuid "b5dc456d-f743-5286-851a-c035feeffac9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{y}{6}, & \\,2<y<4 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186552105} {:answer/id #uuid "d167a7a8-34d5-59c3-b949-f001717e3bd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{y}{3}, & \\,2<y<4 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186552162}] :answer-field/correct {:answer/id #uuid "b5dc456d-f743-5286-851a-c035feeffac9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}\\frac{y}{6}, & \\,2<y<4 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186552105} :answer-field/id #uuid "69f2e9ff-fa41-50ab-a63c-2d1d1f490067" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552315}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8460a557-83b6-5efd-a8a5-c94e63881b6d" :question/math-academy-id "q-151985" :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{2x}{3},\\, & 1<x<2 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}\n$$\n\nIf $Y=2X,$ then what is the probability density function of $Y?$" :question/worked-solution "To compute the probability density function of a random variable $Y,$ where $Y=u(X)$ is a continuous, strictly monotonic function of a continuous random variable $X,$ we follow two steps:\n\n- First, we find an expression for ${F}_{Y}$ in terms of ${F}_{X},$ where ${F}_{Y}$ and ${F}_{X}$ are the cumulative distribution functions of $Y$ and $X,$ respectively.\n\n- Then, we differentiate ${F}_{Y}$ to get the probability density function ${f}_{Y}.$\n\nBefore we start, note that $Y=2X$ is a strictly increasing function of $X.$  Moreover, for $1<x<2,$ we have $2<y<4.$\n\n![](images/60/60342277a025cb26cebab2ac534fad4aa1b49fc2285571c303c4e829eb464606.png)\n\nNow, using the definition of the cumulative distribution of $Y,$ for $2<y<4,$ we have\n\n$$\n\\begin{aligned}{F}_{Y}(y) & =P(Y\\le y) \\\\  & =P(2X\\le y) \\\\  & =P(X\\le \\frac{y}{2}) \\\\  & ={F}_{X}(\\frac{y}{2})\\end{aligned}\n$$\n\nTo compute the PDF ${f}_{Y}(y)$ for $2<y<4,$ we differentiate ${F}_{Y}$ with respect to $y$ using the chain rule. This gives\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={F}_{Y}^{′}(y) \\\\  & =\\frac{1}{2}\\cdot {F}_{X}^{′}(\\frac{y}{2}) \\\\  & =\\frac{1}{2}\\cdot {f}_{X}(\\frac{y}{2}).\\end{aligned}\n$$\n\nApplying the definition of ${f}_{X},$ we finally arrive at\n\n$$\n\\begin{aligned}{f}_{Y}(y) & =\\frac{1}{2}\\cdot {f}_{X}(\\frac{y}{2}) \\\\  & =\\frac{1}{2}\\cdot \\frac{2(\\frac{y}{2})}{3} \\\\  & =\\frac{y}{6}.\\end{aligned}\n$$\n\nTherefore, the full expression for the PDF of $Y$ is\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{y}{6}, & \\,2<y<4 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186552476 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30da5234-4042-5fab-bc17-28a88bfb9de4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-26 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186551781} {:answer/id #uuid "37e4fbe8-c0f7-58ed-9b71-06218e634007" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}28 & -16\\end{aligned}]" :db/id #edb/ref 17592186551799} {:answer/id #uuid "868cbcd3-651b-5e03-a865-b0dfaf92d893" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}13 \\\\ 32\\end{aligned}]" :db/id #edb/ref 17592186551989} {:answer/id #uuid "d0501560-e02a-5299-a647-3098cd11d592" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}52 \\\\ -8\\end{aligned}]" :db/id #edb/ref 17592186552158} {:answer/id #uuid "d8c321cc-baeb-5602-885c-ed6669f5d604" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & 7\\end{aligned}]" :db/id #edb/ref 17592186552178}] :answer-field/correct {:answer/id #uuid "d0501560-e02a-5299-a647-3098cd11d592" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}52 \\\\ -8\\end{aligned}]" :db/id #edb/ref 17592186552158} :answer-field/id #uuid "6730a75f-f272-5493-a8bf-085f7b4def46" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552312}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9669b6bb-a27d-584f-935a-b35adacb11c6" :question/math-academy-id "q-269476" :question/problem "Consider the function $L:{R}^{2}\\to R$ defined by $L(x)=(Ax-b)^{T}(Ax-b)$ where \n\n$$\nA=[\\begin{aligned}1 & 2 \\\\ 4 & 0\\end{aligned}],\\,b=[\\begin{aligned}3 \\\\ 5\\end{aligned}].\n$$\n\nWhat is ${∇}_{x}L(x)$ at $x=[\\begin{aligned}3 \\\\ -1\\end{aligned}]?$" :question/worked-solution "We can solve this problem by applying the chain rule for gradients.\n\nLet $y=Ax-b.$ Then, $L(x)={y}^{T}y,$ and\n\n$$\n{∇}_{x}L={(\\frac{\\text{d}L}{\\text{d}x})}^{T}={(\\frac{\\text{d}y}{\\text{d}x})}^{T}\\cdot {(\\frac{\\text{d}L}{\\text{d}y})}^{T}.\n$$\n\nNow, since \n\n$$\n\\frac{\\text{d}}{\\text{d}y}({y}^{T}y)=2{y}^{T}\\,\\text{and}\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}}{\\text{d}x}(Ax-b)=A,\n$$\n\nwe have that \n\n$$\n\\begin{aligned}{∇}_{x}L & ={(\\frac{\\text{d}y}{\\text{d}x})}^{T}\\cdot {(\\frac{\\text{d}L}{\\text{d}y})}^{T} \\\\  & ={A}^{T}\\cdot 2y.\\end{aligned}\n$$\n\nEvaluating at $x=[\\begin{aligned}3 \\\\ -1\\end{aligned}]$, we get\n\n$$\n\\begin{aligned}{∇}_{x}L & ={A}^{T}\\cdot 2y \\\\  & =2\\cdot {A}^{T}(Ax-b) \\\\  & =2\\cdot {[\\begin{aligned}1 & 2 \\\\ 4 & 0\\end{aligned}]}^{T}([\\begin{aligned}1 & 2 \\\\ 4 & 0\\end{aligned}]\\cdot [\\begin{aligned}3 \\\\ -1\\end{aligned}]-[\\begin{aligned}3 \\\\ 5\\end{aligned}]) \\\\  & =2\\cdot [\\begin{aligned}1 & 4 \\\\ 2 & 0\\end{aligned}]([\\begin{aligned}1 \\\\ 12\\end{aligned}]-[\\begin{aligned}3 \\\\ 5\\end{aligned}]) \\\\  & =[\\begin{aligned}2 & 8 \\\\ 4 & 0\\end{aligned}][\\begin{aligned}-2 \\\\ 7\\end{aligned}] \\\\  & =[\\begin{aligned}52 \\\\ -8\\end{aligned}].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186552478 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01664bcb-25bc-5604-ac5b-7905582c2b36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4-6\\sqrt{2}}{15}" :db/id #edb/ref 17592186551667} {:answer/id #uuid "2b869f32-d6ca-57fc-b45e-d252c7e98fbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3+8\\sqrt{2}}{15}" :db/id #edb/ref 17592186551766} {:answer/id #uuid "41b89c7d-25df-5525-b5cb-ba7faba112c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11\\sqrt{2}}{15}" :db/id #edb/ref 17592186551822} {:answer/id #uuid "53b3b239-af76-5af9-8ec7-54d956c4236a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3-8\\sqrt{2}}{15}" :db/id #edb/ref 17592186551862} {:answer/id #uuid "d5703300-df93-5e24-bec4-819d88120806" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4+6\\sqrt{2}}{15}" :db/id #edb/ref 17592186552168}] :answer-field/correct {:answer/id #uuid "2b869f32-d6ca-57fc-b45e-d252c7e98fbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3+8\\sqrt{2}}{15}" :db/id #edb/ref 17592186551766} :answer-field/id #uuid "a3e78b0b-13cf-51a9-87c2-6116b81037d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552348}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "97e789b8-dcb1-527a-b969-3a0ccc1e1111" :question/math-academy-id "q-143842" :question/problem "Suppose that for the angles $u$ and $v,$ we have \n\n$$\n\\operatorname{sin}⁡u=\\frac{4}{5},\\,\\operatorname{cos}⁡u=\\frac{3}{5},\\,\\operatorname{sin}⁡v=\\frac{2\\sqrt{2}}{3}.\n$$\n\nGiven that $v$ lies in the first quadrant, find the value of $\\operatorname{cos}⁡(u-v).$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nWe know the values of $\\operatorname{sin}⁡u$, $\\operatorname{cos}⁡u$, and $\\operatorname{sin}⁡v.$ To find the missing value of $\\operatorname{cos}⁡v,$ we can use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡v+{cos}^{2}⁡v=1\\,⟹\\,{cos}^{2}⁡v=1-{sin}^{2}⁡v\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡v & =1-{sin}^{2}⁡v \\\\  & =1-{(\\frac{2\\sqrt{2}}{3})}^{2} \\\\  & =1-\\frac{{2}^{2}(\\sqrt{2})^{2}}{{3}^{2}} \\\\  & =1-\\frac{8}{9} \\\\  & =\\frac{9}{9}-\\frac{8}{9} \\\\  & =\\frac{1}{9}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡v & =\\pm \\sqrt{\\frac{1}{9}} \\\\  & =\\pm \\frac{1}{3}.\\end{aligned}\n$$\n\nWe're given that $v$ lies in the first quadrant, where cosine is positive. So, we disregard the negative value, and we have\n\n$$\n\\operatorname{cos}⁡v=\\frac{1}{3}.\n$$\n\nWe can now apply the difference formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(u-v) & =\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v \\\\  & =(\\frac{3}{5})(\\frac{1}{3})+(\\frac{4}{5})(\\frac{2\\sqrt{2}}{3}) \\\\  & =\\frac{1}{5}+\\frac{8\\sqrt{2}}{15} \\\\  & =\\frac{3}{15}+\\frac{8\\sqrt{2}}{15} \\\\  & =\\frac{3+8\\sqrt{2}}{15}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186552479 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4060772b-3de8-5534-b56c-8b7a37476bf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=\\frac{7}{{3}^{n}},\\,n\\ge 1" :db/id #edb/ref 17592186551821} {:answer/id #uuid "53b52c4e-fecf-5906-b0d1-f38305a89134" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=3\\cdot {7}^{n},\\,n\\ge 1" :db/id #edb/ref 17592186551863} {:answer/id #uuid "63d5d4e3-2de8-53a3-8ffc-a054da079d86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=\\frac{1}{7}\\cdot {3}^{n},\\,n\\ge 1" :db/id #edb/ref 17592186551901} {:answer/id #uuid "b2bb07b2-92a7-55ae-ba89-d2cfd3c82595" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=\\frac{3}{{7}^{n}},\\,n\\ge 1" :db/id #edb/ref 17592186552099} {:answer/id #uuid "c94b2131-8119-57cb-89b4-783c4f703e5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=\\frac{21}{{7}^{n}},\\,n\\ge 1" :db/id #edb/ref 17592186552145}] :answer-field/correct {:answer/id #uuid "c94b2131-8119-57cb-89b4-783c4f703e5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=\\frac{21}{{7}^{n}},\\,n\\ge 1" :db/id #edb/ref 17592186552145} :answer-field/id #uuid "723b6e58-02ae-5c02-8cb3-0f391e390f10" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552320}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "98925317-9d30-5e69-bd45-e05c5755cffe" :question/math-academy-id "q-44987" :question/problem "What is the explicit formula for the $n$th term of the geometric sequence given by\n\n$$\n{a}_{n+1}=\\frac{{a}_{n}}{7},\\,\\,{a}_{1}=3,\\,\\,n\\ge 1?\n$$" :question/worked-solution "The explicit formula for the $n$th term of a geometric sequence is\n\n$$\n{a}_{n}={a}_{1}\\cdot {r}^{n-1},\\,n\\ge 1.\n$$\n\nSo, we must determine the first term ${a}_{1}$ and the common ratio $r.$\n\nWe are given that the first term is ${a}_{1}=3.$ To find the common ratio, we compare the given sequence with the general recursive formula for a geometric sequence:\n\n$$\n{a}_{n+1}=r\\cdot {a}_{n}\n$$\n\n \n\nFrom the above, we see that $r=\\frac{1}{7}.$\n\nSubstituting ${a}_{1}=3$ and $r=\\frac{1}{7}$ into the formula for the $n$th term, we obtain\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}\\cdot {r}^{n-1} \\\\  & =3\\cdot {(\\frac{1}{7})}^{n-1}.\\end{aligned}\n$$\n\nWe can simplify further by manipulating the exponents as follows:\n\n$$\n\\begin{aligned}{a}_{n} & =3\\cdot {(\\frac{1}{7})}^{n-1} \\\\  & =3\\cdot {(\\frac{1}{7})}^{-1}\\cdot {(\\frac{1}{7})}^{n} \\\\  & =3\\cdot 7\\cdot (\\frac{{1}^{n}}{{7}^{n}}) \\\\  & =21\\cdot \\frac{1}{{7}^{n}} \\\\  & =\\frac{21}{{7}^{n}}\\end{aligned}\n$$\n\nTherefore, the formula for the $n$th term is\n\n$$\n{a}_{n}=\\frac{21}{{7}^{n}},\\,n\\ge 1.\n$$"} {:db/id #edb/ref 17592186552480 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03e7e8d4-1f2c-5731-9bb1-e3ca505e33e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=-\\frac{16}{5}\\cdot {(\\frac{1}{4})}^{n},\\,n\\ge 1" :db/id #edb/ref 17592186551671} {:answer/id #uuid "3396d8a5-3041-5b5a-9e47-d23a76bcc657" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=\\frac{16}{5}\\cdot {(-\\frac{1}{4})}^{n},\\,n\\ge 1" :db/id #edb/ref 17592186551788} {:answer/id #uuid "4c334bbd-0f7b-5f52-a4a2-f06688b4334a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=\\frac{4}{5}\\cdot {(-\\frac{1}{4})}^{n},\\,n\\ge 1" :db/id #edb/ref 17592186551846} {:answer/id #uuid "7582d12c-3842-52cf-9c33-8825aa815a9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=-\\frac{4}{5}\\cdot {(\\frac{1}{4})}^{n},\\,n\\ge 1" :db/id #edb/ref 17592186551942} {:answer/id #uuid "84778c37-5699-5591-895f-445665b6e0ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=\\frac{16}{5}\\cdot {(\\frac{1}{4})}^{n},\\,n\\ge 1" :db/id #edb/ref 17592186551983}] :answer-field/correct {:answer/id #uuid "03e7e8d4-1f2c-5731-9bb1-e3ca505e33e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=-\\frac{16}{5}\\cdot {(\\frac{1}{4})}^{n},\\,n\\ge 1" :db/id #edb/ref 17592186551671} :answer-field/id #uuid "36e03764-6444-5a97-a79c-a332453344e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552282}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9a2f8eb3-e0d7-5d85-8fb5-62ab15cba80d" :question/math-academy-id "q-101752" :question/problem "What is the explicit formula for the $n$th term of the geometric sequence given by\n\n$$\n{a}_{n+1}=\\frac{{a}_{n}}{4},\\,\\,{a}_{1}=-\\frac{4}{5},\\,\\,n\\ge 1?\n$$" :question/worked-solution "The explicit formula for the $n$th term of a geometric sequence is\n\n$$\n{a}_{n}={a}_{1}\\cdot {r}^{n-1},\\,n\\ge 1.\n$$\n\nSo, we must determine the first term ${a}_{1}$ and the common ratio $r.$\n\nWe are given that the first term is ${a}_{1}=-\\frac{4}{5}.$ To find the common ratio, we compare the given sequence with the general recursive formula for a geometric sequence:\n\n$$\n{a}_{n+1}=r\\cdot {a}_{n}\n$$\n\n \n\nFrom the above, we see that $r=\\frac{1}{4}.$\n\nSubstituting ${a}_{1}=-\\frac{4}{5}$ and $r=\\frac{1}{4}$ into the formula for the $n$th term, we obtain\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}\\cdot {r}^{n-1} \\\\  & =-\\frac{4}{5}\\cdot {(\\frac{1}{4})}^{n-1}.\\end{aligned}\n$$\n\nWe can simplify further by manipulating the exponents as follows:\n\n$$\n\\begin{aligned}{a}_{n} & =-\\frac{4}{5}\\cdot {(\\frac{1}{4})}^{n-1} \\\\  & =-\\frac{4}{5}\\cdot {(\\frac{1}{4})}^{-1}\\cdot {(\\frac{1}{4})}^{n} \\\\  & =-\\frac{4}{5}\\cdot \\frac{4}{1}\\cdot {(\\frac{1}{4})}^{n} \\\\  & =-\\frac{4\\cdot 4}{5\\cdot 1}\\cdot {(\\frac{1}{4})}^{n} \\\\  & =-\\frac{16}{5}\\cdot {(\\frac{1}{4})}^{n}\\end{aligned}\n$$\n\nTherefore, the formula for the $n$th term is\n\n$$\n{a}_{n}=-\\frac{16}{5}\\cdot {(\\frac{1}{4})}^{n},\\,n\\ge 1.\n$$"} {:db/id #edb/ref 17592186552481 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee7a38c5-9093-561e-b5af-54b8e86b60c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{17\\sqrt{2}}{26}" :db/id #edb/ref 17592186552222}] :answer-field/correct {:answer/id #uuid "ee7a38c5-9093-561e-b5af-54b8e86b60c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{17\\sqrt{2}}{26}" :db/id #edb/ref 17592186552222} :answer-field/id #uuid "b69a755b-9199-59fe-b15b-6dc54413bd48" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186552361}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9e4e39a8-9ee3-514c-8a99-c8c4e6788313" :question/math-academy-id "q-325885" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\operatorname{sin}⁡u=\\frac{5}{13},\\,\\operatorname{cos}⁡v=\\frac{\\sqrt{2}}{2},\\,\\operatorname{sin}⁡v=\\frac{\\sqrt{2}}{2}.\n$$\n\nGiven that $u$ lies in the second quadrant, then $\\operatorname{cos}⁡(u+v)=${{field-1}}." :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nWe know the values of $\\operatorname{sin}⁡u$, $\\operatorname{cos}⁡v$, and $\\operatorname{sin}⁡v.$ To find the missing value of $\\operatorname{cos}⁡u$, we can use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡u+{cos}^{2}⁡u=1\\,⟹\\,{cos}^{2}⁡u=1-{sin}^{2}⁡u\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡u & =1-{sin}^{2}⁡u \\\\  & =1-{(\\frac{5}{13})}^{2} \\\\  & =1-\\frac{{5}^{2}}{{13}^{2}} \\\\  & =1-\\frac{25}{169} \\\\  & =\\frac{169}{169}-\\frac{25}{169} \\\\  & =\\frac{144}{169}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡u & =\\pm \\sqrt{\\frac{144}{169}} \\\\  & =\\pm \\frac{12}{13}.\\end{aligned}\n$$\n\nWe're given that $u$ lies in the second quadrant, where cosine is negative. So, we disregard the positive value, and we have\n\n$$\n\\operatorname{cos}⁡u=-\\frac{12}{13}.\n$$\n\nWe can now apply the sum formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(u+v) & =\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v \\\\  & =(-\\frac{12}{13})(\\frac{\\sqrt{2}}{2})-(\\frac{5}{13})(\\frac{\\sqrt{2}}{2}) \\\\  & =-\\frac{12\\sqrt{2}}{26}-\\frac{5\\sqrt{2}}{26} \\\\  & =-\\frac{17\\sqrt{2}}{26}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186552483 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c48d543-2d3c-51bb-a7bf-0270b3661c4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n)=\\frac{2}{{6}^{n}},\\,n\\ge 1" :db/id #edb/ref 17592186551847} {:answer/id #uuid "9b8329a8-9240-5aad-b604-d9ff98436aa2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n)={24}^{n},\\,n\\ge 1" :db/id #edb/ref 17592186552041} {:answer/id #uuid "cc85700b-91d3-5f37-a0fd-d0b78d1f06ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n)=\\frac{2}{{24}^{n}},\\,n\\ge 1" :db/id #edb/ref 17592186552154} {:answer/id #uuid "e5c2c41c-0f75-5fa4-a688-22bb4ee3f293" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n)=\\frac{4}{{6}^{n}},\\,n\\ge 1" :db/id #edb/ref 17592186552199} {:answer/id #uuid "e877ea80-a0f4-50cc-b19e-fc100855d57b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n)=\\frac{24}{{6}^{n}},\\,n\\ge 1" :db/id #edb/ref 17592186552207}] :answer-field/correct {:answer/id #uuid "e877ea80-a0f4-50cc-b19e-fc100855d57b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n)=\\frac{24}{{6}^{n}},\\,n\\ge 1" :db/id #edb/ref 17592186552207} :answer-field/id #uuid "6d6b8a21-70e2-5b57-a0a2-6cb7c4f3a1b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552318}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a040fd0d-33b9-5cd2-ba84-4a64f3c5606d" :question/math-academy-id "q-109880" :question/problem "What is the explicit formula for the $n$th term of the geometric sequence given by\n\n$$\nf(n+1)=\\frac{f(n)}{6},\\,\\,f(1)=4,\\,\\,n\\ge 1?\n$$" :question/worked-solution "First, let's rewrite our recursive formula, as follows:\n\n$$\n\\begin{aligned}f(n+1)=\\frac{f(n)}{6}=\\frac{1}{6}f(n)\\end{aligned}\n$$\n\nThe explicit formula for the $n$th term of a geometric sequence is\n\n$$\nf(n)=f(1)\\cdot {r}^{n-1},\\,n\\ge 1.\n$$\n\nSo, we must determine the first term $f(1)$ and the common ratio $r.$\n\nWe are given that the first term is $f(1)=4.$ To find the common ratio, we compare the given sequence with the general recursive formula for a geometric sequence:\n\n$$\nf(n+1)=r\\cdot f(n)\n$$\n\n \n\nFrom the above, we see that $r=\\frac{1}{6}.$\n\nSubstituting $f(1)=4$ and $r=\\frac{1}{6}$ into the formula for the $n$th term, we obtain\n\n$$\n\\begin{aligned}f(n) & =f(1)\\cdot {r}^{n-1} \\\\  & =4\\cdot {(\\frac{1}{6})}^{n-1}.\\end{aligned}\n$$\n\nWe can simplify further by manipulating the exponents as follows:\n\n$$\n\\begin{aligned}f(n) & =4\\cdot {(\\frac{1}{6})}^{n-1} \\\\  & =4\\cdot {(\\frac{1}{6})}^{-1}\\cdot {(\\frac{1}{6})}^{n} \\\\  & =4\\cdot \\frac{6}{1}\\cdot {(\\frac{1}{6})}^{n} \\\\  & =24\\cdot \\frac{1}{{6}^{n}} \\\\  & =\\frac{24}{{6}^{n}}\\end{aligned}\n$$\n\nTherefore, the formula for the $n$th term is\n\n$$\nf(n)=\\frac{24}{{6}^{n}},\\,n\\ge 1.\n$$"} {:db/id #edb/ref 17592186552504 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d42fa31-693c-5e63-8b30-f714f163cf61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\pi " :db/id #edb/ref 17592186551774} {:answer/id #uuid "5a97f892-a6ec-5102-a2f8-b11ba307ea5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64\\pi " :db/id #edb/ref 17592186551880} {:answer/id #uuid "788d4fd5-7983-5bde-ac02-62cb31dfdb02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\pi " :db/id #edb/ref 17592186551948} {:answer/id #uuid "7bd545ee-d36f-5cc5-9368-52d6c0d580da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32\\pi " :db/id #edb/ref 17592186551960} {:answer/id #uuid "ceda2cc6-35df-59c0-b345-80992bffb35d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186552157}] :answer-field/correct {:answer/id #uuid "7bd545ee-d36f-5cc5-9368-52d6c0d580da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32\\pi " :db/id #edb/ref 17592186551960} :answer-field/id #uuid "b1fc0cd0-57f3-5df9-9d82-31c607584763" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552360}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c696854b-d1cc-50f5-8398-3fba96da4739" :question/math-academy-id "q-127063" :question/problem "Calculate the flux of the vector field $F(x,y)=xi+\\frac{1}{4}\\,j$ across the closed curve $C$ given by $r(t)=4\\operatorname{cos}⁡t\\,i+8\\operatorname{sin}⁡t\\,j$ for $t\\in [0,2\\pi ).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ \n\nAlong the curve $C,$ we have\n\n$$\nx=4\\operatorname{cos}⁡t,\\,y=8\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =x=4\\operatorname{cos}⁡t, \\\\ Q(x,y) & =\\frac{1}{4}.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t)=-4\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(8\\operatorname{sin}⁡t)=8\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral using the double-angle formula for cosine, as follows:\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(4\\operatorname{cos}⁡t)\\cdot (8\\operatorname{cos}⁡t)-(\\frac{1}{4})\\cdot (-4\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }32{cos}^{2}⁡t+\\operatorname{sin}⁡t\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }32(\\frac{\\operatorname{cos}⁡(2t)+1}{2})+\\operatorname{sin}⁡t\\,\\text{d}t \\\\  & =(8\\operatorname{sin}⁡(2t)+16t-\\operatorname{cos}⁡t){|}_{0}^{2\\pi } \\\\  & =(0+32\\pi -1)-(0-1) \\\\  & =32\\pi \\end{aligned}\n$$"} {:db/id #edb/ref 17592186552508 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09a3bc49-b244-599b-b0ff-1cbd8f81ac70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n+1)=-\\frac{1}{2}f(n),\\,f(1)=\\frac{3}{4},\\,n\\ge 1" :db/id #edb/ref 17592186551687} {:answer/id #uuid "325d1297-2972-550e-b88d-db16dc9819fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n+1)=\\frac{1}{2}f(n),\\,f(1)=\\frac{3}{2},\\,n\\ge 1" :db/id #edb/ref 17592186551785} {:answer/id #uuid "3bc4548f-c1f5-5340-802b-4754d9b73c29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n+1)=\\frac{1}{2}f(n),\\,f(1)=-\\frac{3}{2},\\,n\\ge 1" :db/id #edb/ref 17592186551812} {:answer/id #uuid "e3e204ed-7f08-5596-a06e-74bc1aaea2ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n+1)=-\\frac{1}{2}f(n),\\,f(1)=\\frac{3}{2},\\,n\\ge 1" :db/id #edb/ref 17592186552192} {:answer/id #uuid "ec092f6f-dfdb-527f-a5bf-640a0c4dff59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n+1)=\\frac{3}{4}f(n),\\,f(1)=-\\frac{2}{3},\\,n\\ge 1" :db/id #edb/ref 17592186552216}] :answer-field/correct {:answer/id #uuid "e3e204ed-7f08-5596-a06e-74bc1aaea2ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n+1)=-\\frac{1}{2}f(n),\\,f(1)=\\frac{3}{2},\\,n\\ge 1" :db/id #edb/ref 17592186552192} :answer-field/id #uuid "eff995c5-b742-5fa7-b249-c06283c96fda" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552393}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cfd63bcb-672d-5a91-b2cf-d24e8a457ef0" :question/math-academy-id "q-109868" :question/problem "The formula for the $n$th term of a geometric sequence is $f(n)=\\frac{6}{(-2)^{n+1}}$ for $n\\ge 1.$  What is the recursive formula for this sequence?" :question/worked-solution "The recursive formula for a geometric sequence is\n\n$$\nf(n+1)=r\\cdot f(n).\n$$\n\nTo complete the formula, we must determine the common ratio $r$ and state the first term $f(1).$ The first two terms are\n\n$$\n\\begin{aligned}f(1) & =\\frac{6}{(-2)^{1+1}}=\\frac{6}{4}=\\frac{3}{2}, \\\\ f(2) & =\\frac{6}{(-2)^{2+1}}=\\frac{6}{(-8)}=-\\frac{3}{4}.\\end{aligned}\n$$\n\nHence, the common ratio is\n\n$$\n\\begin{aligned}r & =\\frac{f(2)}{f(1)}=\\frac{(-\\frac{3}{4})}{(\\frac{3}{2})}=-\\frac{6}{12}=-\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the recursive formula for the geometric sequence is\n\n$$\n\\begin{aligned}f(n+1) & =-\\frac{1}{2}f(n),\\,f(1)=\\frac{3}{2},\\,n\\ge 1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186552522 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53f11dd5-3815-523d-8b4f-218a0c887321" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}1,\\, & 0<y<1 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186551865} {:answer/id #uuid "76d37b1f-0cae-52e4-bbc9-ab6fd6b7061a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}{e}^{y},\\, & y<0 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186551946} {:answer/id #uuid "7a5a5e16-2b43-5e40-8cb3-9fe6c9bc2a8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}1,\\, & -1<y<0 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186551954} {:answer/id #uuid "e933345b-51e3-5f41-b177-21de967b42a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}{e}^{-y},\\, & y>0 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186552210} {:answer/id #uuid "ee37ca3b-30b3-5807-a624-f62ac29989e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}2x,\\, & 0<y<1 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186552221}] :answer-field/correct {:answer/id #uuid "53f11dd5-3815-523d-8b4f-218a0c887321" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}_{Y}(y)=\\{\\begin{aligned}1,\\, & 0<y<1 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}" :db/id #edb/ref 17592186551865} :answer-field/id #uuid "ea541e01-5fa9-5c1a-9bd5-70920b6a9e22" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552390}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f3a2a8f5-8f7b-5578-9df3-f4e28dce2d10" :question/math-academy-id "q-110130" :question/problem "Let $X$ be a continuous random variable with the following probability density function:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{1}{{x}^{2}},\\, & x>1 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}\n$$\n\nIf $Y=\\frac{1}{X},$ then what is the probability density function of $Y?$" :question/worked-solution "To compute the probability density function of a random variable $Y,$ where $Y=u(X)$ is a continuous, strictly monotonic function of a continuous random variable $X,$ we follow two steps:\n\n- First, we find an expression for ${F}_{Y}$ terms of ${F}_{X},$ where ${F}_{Y}$ and ${F}_{X}$ are the cumulative distribution functions of $Y$ and $X,$ respectively.\n\n- Then, we differentiate ${F}_{Y}$ to get the probability density function ${f}_{Y}.$\n\nBefore we start, note that the possible values of $X$ are $x\\in (1,\\infty ),$ and $Y=\\frac{1}{X}$ is a strictly decreasing function of $X$ when $X>1.$\n Moreover, for $x>1,$ we have $0<y<1.$\n\n![](images/16/16f3dc78752c8cfcb6b6968e3d57bb3639a4205e2a32dfd569c8c2ca3c29a589.png)\n\nNow, using the definition of the cumulative distribution of $Y,$ for $0<y<1,$ we have\n\n$$\n\\begin{aligned}{F}_{Y}(y) & =P(Y\\le y) \\\\  & =P(\\frac{1}{X}\\le y) \\\\  & =P(X\\ge \\frac{1}{y}) \\\\  & =1-{F}_{X}(\\frac{1}{y})\\end{aligned}\n$$\n\nTo compute the PDF ${f}_{Y}(y)$ for $0<y<1,$ we differentiate ${F}_{Y}$ with respect to $y$ using the chain rule. This gives\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={F}_{Y}^{′}(y) \\\\  & =0-(-\\frac{1}{{y}^{2}})\\cdot {F}_{X}^{′}(\\frac{1}{y}) \\\\  & =\\frac{1}{{y}^{2}}\\cdot {f}_{X}(\\frac{1}{y}).\\end{aligned}\n$$\n\nApplying the definition of ${f}_{X},$ we finally arrive at\n\n$$\n\\begin{aligned}{f}_{Y}(y) & =\\frac{1}{{y}^{2}}\\cdot {f}_{X}(\\frac{1}{y}) \\\\  & =\\frac{1}{{y}^{2}}\\cdot \\frac{1}{{(\\frac{1}{y})}^{2}} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the full expression for the PDF of $Y$ is\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}1,\\, & 0<y<1 \\\\ 0,\\, & \\text{otherwise}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186552782 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "281698df-9249-5da9-9368-9b2f93cd8848" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}2 t \\left(2 - 3 t^{3}\\right)^{2}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552791} {:answer/id #uuid "455025c2-db51-556e-a3e6-9fa4b4a79dac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}t \\left(4 - 6 t^{3}\\right) \\sqrt{81 t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552799} {:answer/id #uuid "4c1ecf92-1397-5d44-97e4-f143aa9d8c69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}2 t \\left(2 - 3 t^{3}\\right)^{2} \\sqrt{9 t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552801} {:answer/id #uuid "4f811054-64ac-515c-b215-4b187de7bc5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}2 \\left(2 - 3 t^{3}\\right)^{2} \\sqrt{81 t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552805} {:answer/id #uuid "a60d9d4a-69db-5a5f-9245-b3924cba5128" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}2 t \\left(2 - 3 t^{3}\\right)^{2} \\sqrt{81 t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552830}] :answer-field/correct {:answer/id #uuid "a60d9d4a-69db-5a5f-9245-b3924cba5128" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}2 t \\left(2 - 3 t^{3}\\right)^{2} \\sqrt{81 t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552830} :answer-field/id #uuid "0763297f-2785-5418-b00d-ee5ade6a337c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552781}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "10654151-77bf-5b54-8ad8-7a9ddd7ea1a1" :question/problem "Which of the following is equivalent to the integral $\\int_C 2 x^{2} y\\,\\mathrm{d}s$\n\nwhere $C$ is the section of the curve $x=2 - 3 y^{3}$ traversed between the points $(2,0)$ and $(-79,3)$.\n\n*Hint: Use the parameter $y=t.$*" :question/worked-solution "Notice that the given curve is of the form $x=x(y).$ Therefore, by setting $y=t,$ we have \n\n$$\nx=x(t)=2 - 3 t^{3}.\n$$\n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=\\langle 2 - 3 t^{3},\\,t\\rangle,\\quad 0\\le t\\le 3\n$$\n\nNote that the domain $0\\le t\\le 3$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}r^{\\prime}(t)&=\\frac{\\mathrm{d}x}{\\mathrm{d}t}i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}j \\\\ &=\\frac{\\mathrm{d}}{\\mathrm{d}t}(2 - 3 t^{3})i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t)j \\\\ &=(- 9 t^{2})i+j \\\\ \\|r^{\\prime}(t)\\|&=\\sqrt{(\\frac{\\mathrm{d}x}{\\mathrm{d}t})^2+(\\frac{\\mathrm{d}y}{\\mathrm{d}t})^2} \\\\ &=\\sqrt{(- 9 t^{2})^2+1^2} \\\\ &=\\sqrt{81 t^{4} + 1}\\end{aligned}\n$$\n\nNow, if $f(x,y)=2 x^{2} y,$ then we obtain\n\n$$\n\\begin{aligned}f(r(t))&=2\\left(2 - 3 t^{3}\\right)^{2}t^{1} \\\\ &=2 t \\left(2 - 3 t^{3}\\right)^{2}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C 2 x^{2} y\\,\\mathrm{d}s&=\\int_{0}^{3}f(r(t))\\|r^{\\prime}(t)\\|\\,\\mathrm{d}t \\\\ &=\\int_{0}^{3}(2 t \\left(2 - 3 t^{3}\\right)^{2})\\cdot \\sqrt{81 t^{4} + 1}\\,\\mathrm{d}t \\\\ &=\\int_{0}^{3}2 t \\left(2 - 3 t^{3}\\right)^{2} \\sqrt{81 t^{4} + 1}\\,\\mathrm{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186552800 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2275c2b9-bd7c-5d72-90c8-7b26275f195e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12 t^{5}" :db/id #edb/ref 17592186552788} {:answer/id #uuid "36e310df-bff1-5173-9e88-7181749cd810" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3 t^{5}}{64}" :db/id #edb/ref 17592186552795} {:answer/id #uuid "77b420d0-67c2-528a-91a7-5fcbbe514595" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 t^{2}" :db/id #edb/ref 17592186552812} {:answer/id #uuid "7aee2490-8ebd-5fff-aeba-dd54ccd94877" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 t^{5}" :db/id #edb/ref 17592186552814} {:answer/id #uuid "ac98de36-83ed-5aef-b75d-338dc0b2dbdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "768 t^{5}" :db/id #edb/ref 17592186552832}] :answer-field/correct {:answer/id #uuid "7aee2490-8ebd-5fff-aeba-dd54ccd94877" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 t^{5}" :db/id #edb/ref 17592186552814} :answer-field/id #uuid "e31bb3e8-a091-5beb-bbef-ce8a5745dea3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552843}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4996d341-4274-5583-88ff-0f580b30aea8" :question/problem "Consider the line integral\n\n$$\n\\int_C 48 x^{2} y^{3}\\,\\mathrm{d}s=\\frac{\\sqrt{17}}{4}\\int_{1}^{2}\\boxed{}\\,\\mathrm{d}t\n$$\n\nwhere $C$ is the segment of the line $4x=y$ traversed between the points $(\\frac{1}{4},1)$ and $(\\frac{1}{2},2)$. Which of the following is the missing expression under the integral on the right?\n\n*Hint: Use the parameter $y=t.$*" :question/worked-solution "Notice that the given curve can be expressed in the form $x=x(y),$ as follows:\n\n$$\n4x=y\\,\\Longrightarrow\\,x=\\frac{y}{4}\n$$\n\nTherefore, by setting $y=t,$ we have \n\n$$\nx=x(t)=\\frac{t}{4}.\n$$\n\n \n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=\\langle\\frac{t}{4},\\,t\\rangle,\\quad 1\\le t\\le 2\n$$\n\nNote that the domain $1\\le t\\le 2$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}r^{\\prime}(t)&=\\frac{\\mathrm{d}x}{\\mathrm{d}t}i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}j \\\\ &=\\frac{\\mathrm{d}}{\\mathrm{d}t}(\\frac{t}{4})i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t)j \\\\ &=(\\frac{1}{4})i+j \\\\ \\|r^{\\prime}(t)\\|&=\\sqrt{(\\frac{\\mathrm{d}x}{\\mathrm{d}t})^2+(\\frac{\\mathrm{d}y}{\\mathrm{d}t})^2} \\\\ &=\\sqrt{(\\frac{1}{4})^2+1^2} \\\\ &=\\sqrt{\\frac{1}{16}+1} \\\\ &=\\sqrt{\\frac{17}{16}} \\\\ &=\\frac{\\sqrt{17}}{4}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=48 x^{2} y^{3},$ then we obtain \n\n$$\n\\begin{aligned}f(r(t))&=48\\left(\\frac{t}{4}\\right)^2t^{3} \\\\ &=48\\left(\\frac{t^2}{16}\\right)t^{3} \\\\ &=3 t^{5}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}\\int_C 48 x^{2} y^{3}\\,\\mathrm{d}s&=\\int_{1}^{2}f(r(t))\\|r^{\\prime}(t)\\|\\,\\mathrm{d}t \\\\ &=\\int_{1}^{2}(3 t^{5})\\cdot \\frac{\\sqrt{17}}{4}\\,\\mathrm{d}t \\\\ &=\\frac{\\sqrt{17}}{4}\\int_{1}^{2}3 t^{5}\\,\\mathrm{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186552818 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23197b07-5a7b-53de-9d9e-c615db2ae1e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}t^{2} \\left(2 t^{3} - 8\\right) \\sqrt{9 t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552789} {:answer/id #uuid "2df87d88-57a2-5c89-9a85-320711d02d09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}2 t^{2} \\left(t^{3} - 4\\right)^{2} \\sqrt{t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552793} {:answer/id #uuid "7b0929a7-5013-5e55-aa1e-ae864b350074" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}2 t^{2} \\left(t^{3} - 4\\right)^{2}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552815} {:answer/id #uuid "d080d482-7b0f-5090-b506-abea27a84bad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}2 \\left(t^{3} - 4\\right)^{2} \\sqrt{9 t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552839} {:answer/id #uuid "ed952ab0-5dec-52bf-9c72-9b41ef3af6ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}2 t^{2} \\left(t^{3} - 4\\right)^{2} \\sqrt{9 t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552847}] :answer-field/correct {:answer/id #uuid "ed952ab0-5dec-52bf-9c72-9b41ef3af6ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}2 t^{2} \\left(t^{3} - 4\\right)^{2} \\sqrt{9 t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552847} :answer-field/id #uuid "c85e1c25-dace-5d43-9b45-c16fb0df76d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552838}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7ed925b2-2bfc-5cd1-979d-0167eb4f42c0" :question/problem "Which of the following is equivalent to the integral $\\int_C 2 x^{2} y^{2}\\,\\mathrm{d}s$\n\nwhere $C$ is the section of the curve $x=y^{3} - 4$ traversed between the points $(-4,0)$ and $(23,3)$.\n\n*Hint: Use the parameter $y=t.$*" :question/worked-solution "Notice that the given curve is of the form $x=x(y).$ Therefore, by setting $y=t,$ we have \n\n$$\nx=x(t)=t^{3} - 4.\n$$\n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=\\langle t^{3} - 4,\\,t\\rangle,\\quad 0\\le t\\le 3\n$$\n\nNote that the domain $0\\le t\\le 3$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}r^{\\prime}(t)&=\\frac{\\mathrm{d}x}{\\mathrm{d}t}i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}j \\\\ &=\\frac{\\mathrm{d}}{\\mathrm{d}t}(t^{3} - 4)i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t)j \\\\ &=(3 t^{2})i+j \\\\ \\|r^{\\prime}(t)\\|&=\\sqrt{(\\frac{\\mathrm{d}x}{\\mathrm{d}t})^2+(\\frac{\\mathrm{d}y}{\\mathrm{d}t})^2} \\\\ &=\\sqrt{(3 t^{2})^2+1^2} \\\\ &=\\sqrt{9 t^{4} + 1}\\end{aligned}\n$$\n\nNow, if $f(x,y)=2 x^{2} y^{2},$ then we obtain\n\n$$\n\\begin{aligned}f(r(t))&=2\\left(t^{3} - 4\\right)^{2}t^{2} \\\\ &=2 t^{2} \\left(t^{3} - 4\\right)^{2}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C 2 x^{2} y^{2}\\,\\mathrm{d}s&=\\int_{0}^{3}f(r(t))\\|r^{\\prime}(t)\\|\\,\\mathrm{d}t \\\\ &=\\int_{0}^{3}(2 t^{2} \\left(t^{3} - 4\\right)^{2})\\cdot \\sqrt{9 t^{4} + 1}\\,\\mathrm{d}t \\\\ &=\\int_{0}^{3}2 t^{2} \\left(t^{3} - 4\\right)^{2} \\sqrt{9 t^{4} + 1}\\,\\mathrm{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186552819 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ce1b2b9-3b87-52e0-a1f6-172a88bf7b1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 t^{3} \\left(2 - 2 t\\right)^{2}" :db/id #edb/ref 17592186552802} {:answer/id #uuid "680810eb-e33e-5d7a-ac2d-3e3d2bcc7f23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 \\left(2 t + 2\\right)^{2}" :db/id #edb/ref 17592186552809} {:answer/id #uuid "b7a2acf9-a41f-5160-8dc1-756db6ef76d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16 t^{5}" :db/id #edb/ref 17592186552834} {:answer/id #uuid "e0c023e8-5a47-5179-b7eb-afe7ce12e7ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 t^{3} \\left(2 t + 2\\right)^{2}" :db/id #edb/ref 17592186552842} {:answer/id #uuid "f3bd6f10-f9f4-538e-913c-d22618c6f106" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 t^{2} \\left(2 t + 2\\right)^{3}" :db/id #edb/ref 17592186552848}] :answer-field/correct {:answer/id #uuid "e0c023e8-5a47-5179-b7eb-afe7ce12e7ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 t^{3} \\left(2 t + 2\\right)^{2}" :db/id #edb/ref 17592186552842} :answer-field/id #uuid "4ecb885d-e56e-5e60-9407-9e9e3fa26bfa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552803}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "86be1e77-b581-5d25-9650-3cc553d658e6" :question/problem "Consider the line integral\n\n$$\n\\int_C 4 x^{2} y^{3}\\,\\mathrm{d}s=\\sqrt{5}\\int_{2}^{4}\\boxed{}\\,\\mathrm{d}t\n$$\n\nwhere $C$ is the segment of the line $x=2 y + 2$ traversed between the points $(6,2)$ and $(10,4)$. Which of the following is the missing expression under the integral on the right?\n\n*Hint: Use the parameter $y=t.$*" :question/worked-solution "Notice that the given curve is of the form $x=x(y).$ Therefore, by setting $y=t,$ we have \n\n$$\nx=x(t)=2 t + 2.\n$$\n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=\\langle 2 t + 2,\\,t\\rangle,\\quad 2\\le t\\le 4\n$$\n\nNote that the domain $2\\le t\\le 4$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}r^{\\prime}(t)&=\\frac{\\mathrm{d}x}{\\mathrm{d}t}i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}j \\\\ &=\\frac{\\mathrm{d}}{\\mathrm{d}t}(2 t + 2)i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t)j \\\\ &=(2)i+j \\\\ \\|r^{\\prime}(t)\\|&=\\sqrt{(\\frac{\\mathrm{d}x}{\\mathrm{d}t})^2+(\\frac{\\mathrm{d}y}{\\mathrm{d}t})^2} \\\\ &=\\sqrt{(2)^2+1^2} \\\\ &=\\sqrt{5}\\end{aligned}\n$$\n\nNow, if $f(x,y)=4 x^{2} y^{3},$ then we obtain\n\n$$\n\\begin{aligned}f(r(t))&=4\\left(2 t + 2\\right)^{2}t^{3} \\\\ &=4 t^{3} \\left(2 t + 2\\right)^{2}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C 4 x^{2} y^{3}\\,\\mathrm{d}s&=\\int_{2}^{4}f(r(t))\\|r^{\\prime}(t)\\|\\,\\mathrm{d}t \\\\ &=\\int_{2}^{4}(4 t^{3} \\left(2 t + 2\\right)^{2})\\cdot \\sqrt{5}\\,\\mathrm{d}t \\\\ &=\\sqrt{5}\\int_{2}^{4}4 t^{3} \\left(2 t + 2\\right)^{2}\\,\\mathrm{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186552826 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0260f071-3897-545d-bb02-440d61d15330" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 - 5 t" :db/id #edb/ref 17592186552779} {:answer/id #uuid "17052b32-b23e-5b70-b603-b912587c5543" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 - t" :db/id #edb/ref 17592186552785} {:answer/id #uuid "19c6da5f-d3b5-56f5-94b4-f6ad26195c2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7 t - 8" :db/id #edb/ref 17592186552787} {:answer/id #uuid "87c31bd7-b6ca-5532-b4da-aad42b84c763" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 - 3 t" :db/id #edb/ref 17592186552820} {:answer/id #uuid "d7fb372a-4d60-5b14-bc9e-3501041766f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 5 t" :db/id #edb/ref 17592186552840}] :answer-field/correct {:answer/id #uuid "0260f071-3897-545d-bb02-440d61d15330" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 - 5 t" :db/id #edb/ref 17592186552779} :answer-field/id #uuid "6ee0746c-4281-5a79-87b4-bd2fbd506c40" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552810}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "99c0214e-a2d8-5339-8aee-c36838439a0d" :question/problem "Consider the line integral\n\n$$\n\\int_C x - 2 y\\,\\mathrm{d}s=\\sqrt{10}\\int_{0}^{4}\\boxed{}\\,\\mathrm{d}t\n$$\n\nwhere $C$ is the segment of the line $\\frac{x}{4}=1 - \\frac{3 y}{4}$ traversed between the points $(4,0)$ and $(-8,4)$. Which of the following is the missing expression under the integral on the right?\n\n*Hint: Use the parameter $y=t.$*" :question/worked-solution "Notice that the given curve can be expressed in the form $x=x(y),$ as follows:\n\n$$\n\\frac{x}{4}=1 - \\frac{3 y}{4}\\,\\Longrightarrow\\,x=4 - 3 y\n$$\n\nTherefore, by setting $y=t,$ we have \n\n$$\nx=x(t)=4 - 3 t.\n$$\n\n \n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=\\langle 4 - 3 t,\\,t\\rangle,\\quad 0\\le t\\le 4\n$$\n\nNote that the domain $0\\le t\\le 4$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}r^{\\prime}(t)&=\\frac{\\mathrm{d}x}{\\mathrm{d}t}i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}j \\\\ &=\\frac{\\mathrm{d}}{\\mathrm{d}t}(4 - 3 t)i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t)j \\\\ &=(-3)i+j \\\\ \\|r^{\\prime}(t)\\|&=\\sqrt{(\\frac{\\mathrm{d}x}{\\mathrm{d}t})^2+(\\frac{\\mathrm{d}y}{\\mathrm{d}t})^2} \\\\ &=\\sqrt{(-3)^2+1^2} \\\\ &=\\sqrt{9+1} \\\\ &=\\sqrt{10}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=x - 2 y,$ then we obtain \n\n$$\n\\begin{aligned}f(r(t))&=1\\left(4 - 3 t\\right)-2t \\\\ &=4 - 5 t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}\\int_C x - 2 y\\,\\mathrm{d}s&=\\int_{0}^{4}f(r(t))\\|r^{\\prime}(t)\\|\\,\\mathrm{d}t \\\\ &=\\int_{0}^{4}(4 - 5 t)\\cdot \\sqrt{10}\\,\\mathrm{d}t \\\\ &=\\sqrt{10}\\int_{0}^{4}(4 - 5 t)\\,\\mathrm{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186552827 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "417a2e2c-c99e-5b7e-89a5-04fd8801fb79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{3}2 t^{2} \\left(2 t^{2} + 3\\right)^{2} \\sqrt{16 t^{2} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552798} {:answer/id #uuid "7a3d15a8-46f5-5bf1-811c-a4f19b6a7124" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{3}t^{2} \\left(4 t^{2} + 6\\right) \\sqrt{16 t^{2} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552813} {:answer/id #uuid "7dc7687e-5dff-5e5e-97a9-d31743837c06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{3}2 \\left(2 t^{2} + 3\\right)^{2} \\sqrt{16 t^{2} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552816} {:answer/id #uuid "c023fc4c-620c-5620-a1bb-9b3840ec1fc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{3}2 t^{2} \\left(2 t^{2} + 3\\right)^{2} \\sqrt{4 t^{2} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552836} {:answer/id #uuid "ed840fbf-dc53-5f4f-83cf-efc910b3cde0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{3}2 t^{2} \\left(2 t^{2} + 3\\right)^{2}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552846}] :answer-field/correct {:answer/id #uuid "417a2e2c-c99e-5b7e-89a5-04fd8801fb79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{3}2 t^{2} \\left(2 t^{2} + 3\\right)^{2} \\sqrt{16 t^{2} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552798} :answer-field/id #uuid "1224e6c3-08af-592f-b40f-08f63238075d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552783}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9eafb873-c81e-5383-b266-5700676268cc" :question/problem "Which of the following is equivalent to the integral $\\int_C 2 x^{2} y^{2}\\,\\mathrm{d}s$\n\nwhere $C$ is the section of the curve $x=2 y^{2} + 3$ traversed between the points $(5,1)$ and $(21,3)$.\n\n*Hint: Use the parameter $y=t.$*" :question/worked-solution "Notice that the given curve is of the form $x=x(y).$ Therefore, by setting $y=t,$ we have \n\n$$\nx=x(t)=2 t^{2} + 3.\n$$\n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=\\langle 2 t^{2} + 3,\\,t\\rangle,\\quad 1\\le t\\le 3\n$$\n\nNote that the domain $1\\le t\\le 3$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}r^{\\prime}(t)&=\\frac{\\mathrm{d}x}{\\mathrm{d}t}i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}j \\\\ &=\\frac{\\mathrm{d}}{\\mathrm{d}t}(2 t^{2} + 3)i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t)j \\\\ &=(4 t)i+j \\\\ \\|r^{\\prime}(t)\\|&=\\sqrt{(\\frac{\\mathrm{d}x}{\\mathrm{d}t})^2+(\\frac{\\mathrm{d}y}{\\mathrm{d}t})^2} \\\\ &=\\sqrt{(4 t)^2+1^2} \\\\ &=\\sqrt{16 t^{2} + 1}\\end{aligned}\n$$\n\nNow, if $f(x,y)=2 x^{2} y^{2},$ then we obtain\n\n$$\n\\begin{aligned}f(r(t))&=2\\left(2 t^{2} + 3\\right)^{2}t^{2} \\\\ &=2 t^{2} \\left(2 t^{2} + 3\\right)^{2}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C 2 x^{2} y^{2}\\,\\mathrm{d}s&=\\int_{1}^{3}f(r(t))\\|r^{\\prime}(t)\\|\\,\\mathrm{d}t \\\\ &=\\int_{1}^{3}(2 t^{2} \\left(2 t^{2} + 3\\right)^{2})\\cdot \\sqrt{16 t^{2} + 1}\\,\\mathrm{d}t \\\\ &=\\int_{1}^{3}2 t^{2} \\left(2 t^{2} + 3\\right)^{2} \\sqrt{16 t^{2} + 1}\\,\\mathrm{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186552831 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05820e9b-5d3f-5f00-8ab1-5cb728ad058c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{e^{2}}t \\sqrt{t^{2} + 9}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552780} {:answer/id #uuid "3912c436-323c-5514-82b7-0a551fe02d0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{e^{2}}t^{5} \\sqrt{t^{2} + 9}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552796} {:answer/id #uuid "5534bb00-f895-5c7c-97e6-684d212578d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{6}t^{4} \\sqrt{t^{2} + 9}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552806} {:answer/id #uuid "a0a0976d-6042-5f97-9145-cb3e806a614e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{e^{2}}\\sqrt{10} t^{5}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552828} {:answer/id #uuid "c7400a6a-8f3d-57bb-bce2-f39b5a9cf40c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{e^{2}}t^{4} \\sqrt{t^{2} + 9}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552837}] :answer-field/correct {:answer/id #uuid "c7400a6a-8f3d-57bb-bce2-f39b5a9cf40c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{e^{2}}t^{4} \\sqrt{t^{2} + 9}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552837} :answer-field/id #uuid "2ae4cf2f-2882-5737-907d-832d0c62119c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552792}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aa8602a5-ab99-5ec1-a115-7e29b5ef7be8" :question/problem "Which of the following is equivalent to the integral $\\int_C y^{2} e^{x}\\,\\mathrm{d}s$\n\nwhere $C$ is the section of the curve $x=3 \\ln{\\left(y \\right)}$ traversed between the points $(0,1)$ and $(6,e^{2})$.\n\n*Hint: Use the parameter $y=t.$*" :question/worked-solution "Notice that the given curve is of the form $x=x(y).$ Therefore, by setting $y=t,$ we have \n\n$$\nx=x(t)=3 \\ln{\\left(t \\right)}.\n$$\n\n \n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=\\langle 3 \\ln{\\left(t \\right)},\\,t\\rangle,\\quad 1\\le t\\le e^{2}\n$$\n\nNote that the domain $1\\le t\\le e^{2}$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}r^{\\prime}(t)&=\\frac{\\mathrm{d}x}{\\mathrm{d}t}i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}j \\\\ &=\\frac{\\mathrm{d}}{\\mathrm{d}t}(3 \\ln{\\left(t \\right)})i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t)j \\\\ &=(\\frac{3}{t})i+j \\\\ \\|r^{\\prime}(t)\\|&=\\sqrt{(\\frac{\\mathrm{d}x}{\\mathrm{d}t})^2+(\\frac{\\mathrm{d}y}{\\mathrm{d}t})^2} \\\\ &=\\sqrt{(\\frac{3}{t})^2+1^2} \\\\ &=\\sqrt{\\frac{9}{t^2}+1} \\\\ &=\\sqrt{\\frac{t^{2} + 9}{t^2}} \\\\ &=\\frac{\\sqrt{t^{2} + 9}}{|t|} \\\\ &=\\frac{\\sqrt{t^{2} + 9}}{t}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=y^{2} e^{x},$ then we obtain \n\n$$\n\\begin{aligned}f(r(t))&=1\\left(e^{3\\ln t}\\right)t^{2} \\\\ &=1\\left(t^{3}\\right)t^{2} \\\\ &=t^{5}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}\\int_C y^{2} e^{x}\\,\\mathrm{d}s&=\\int_{1}^{e^{2}}f(r(t))\\|r^{\\prime}(t)\\|\\,\\mathrm{d}t \\\\ &=\\int_{1}^{e^{2}}(t^{5})\\cdot \\sqrt{1 + \\frac{9}{t^{2}}}\\,\\mathrm{d}t \\\\ &=\\int_{1}^{e^{2}}t^{4} \\sqrt{t^{2} + 9}\\,\\mathrm{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186552833 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18e8e6cf-6f2d-52c7-9466-9bfe3b894881" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{4}4 \\left(2 t^{3} + 2\\right)^{2} \\sqrt{36 t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552786} {:answer/id #uuid "65b7db08-9576-514c-8058-8a41c58bbf69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{4}4 t \\left(2 t^{3} + 2\\right)^{2}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552807} {:answer/id #uuid "8d8131b6-7baf-5780-9fa9-322bc7065bf7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{4}t \\left(8 t^{3} + 8\\right) \\sqrt{36 t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552821} {:answer/id #uuid "8fba40cf-cdeb-5e12-8408-18012db7f78f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{4}4 t \\left(2 t^{3} + 2\\right)^{2} \\sqrt{36 t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552824} {:answer/id #uuid "9370dc17-2d30-55db-b451-380c43d516d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{4}4 t \\left(2 t^{3} + 2\\right)^{2} \\sqrt{4 t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552825}] :answer-field/correct {:answer/id #uuid "8fba40cf-cdeb-5e12-8408-18012db7f78f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{4}4 t \\left(2 t^{3} + 2\\right)^{2} \\sqrt{36 t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552824} :answer-field/id #uuid "26a99906-0888-518b-a404-298ec7ba3467" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552790}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "add2d24a-5255-5b7c-82c3-e44bf8b960be" :question/problem "Which of the following is equivalent to the integral $\\int_C 4 x^{2} y\\,\\mathrm{d}s$\n\nwhere $C$ is the section of the curve $x=2 y^{3} + 2$ traversed between the points $(4,1)$ and $(130,4)$.\n\n*Hint: Use the parameter $y=t.$*" :question/worked-solution "Notice that the given curve is of the form $x=x(y).$ Therefore, by setting $y=t,$ we have \n\n$$\nx=x(t)=2 t^{3} + 2.\n$$\n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=\\langle 2 t^{3} + 2,\\,t\\rangle,\\quad 1\\le t\\le 4\n$$\n\nNote that the domain $1\\le t\\le 4$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}r^{\\prime}(t)&=\\frac{\\mathrm{d}x}{\\mathrm{d}t}i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}j \\\\ &=\\frac{\\mathrm{d}}{\\mathrm{d}t}(2 t^{3} + 2)i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t)j \\\\ &=(6 t^{2})i+j \\\\ \\|r^{\\prime}(t)\\|&=\\sqrt{(\\frac{\\mathrm{d}x}{\\mathrm{d}t})^2+(\\frac{\\mathrm{d}y}{\\mathrm{d}t})^2} \\\\ &=\\sqrt{(6 t^{2})^2+1^2} \\\\ &=\\sqrt{36 t^{4} + 1}\\end{aligned}\n$$\n\nNow, if $f(x,y)=4 x^{2} y,$ then we obtain\n\n$$\n\\begin{aligned}f(r(t))&=4\\left(2 t^{3} + 2\\right)^{2}t^{1} \\\\ &=4 t \\left(2 t^{3} + 2\\right)^{2}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C 4 x^{2} y\\,\\mathrm{d}s&=\\int_{1}^{4}f(r(t))\\|r^{\\prime}(t)\\|\\,\\mathrm{d}t \\\\ &=\\int_{1}^{4}(4 t \\left(2 t^{3} + 2\\right)^{2})\\cdot \\sqrt{36 t^{4} + 1}\\,\\mathrm{d}t \\\\ &=\\int_{1}^{4}4 t \\left(2 t^{3} + 2\\right)^{2} \\sqrt{36 t^{4} + 1}\\,\\mathrm{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186552841 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "124cbff1-5e98-5d16-ab1f-cc5dd9bcb262" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{e^{2}}4 t^{2} \\sqrt{t^{2} + 4}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552784} {:answer/id #uuid "73be819e-c547-5ed8-8ad1-7fbb722f68d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{4}4 t^{2} \\sqrt{t^{2} + 4}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552811} {:answer/id #uuid "8d8d803f-dbce-540f-ae8b-e4bb8ad0e1e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{e^{2}}4 \\sqrt{t^{2} + 4}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552822} {:answer/id #uuid "b95ec9fe-f64a-57bc-b94e-843559920235" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{e^{2}}4 t^{3} \\sqrt{t^{2} + 4}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552835} {:answer/id #uuid "e4084919-f343-5591-a6f6-3cbf2ccd120c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{e^{2}}4 \\sqrt{5} t^{3}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552844}] :answer-field/correct {:answer/id #uuid "124cbff1-5e98-5d16-ab1f-cc5dd9bcb262" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{e^{2}}4 t^{2} \\sqrt{t^{2} + 4}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552784} :answer-field/id #uuid "2ec0c910-12f6-5049-8da0-f391acb979fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552794}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "da6a50f8-dbf0-5c57-9f91-2fc2ad40dfd3" :question/problem "Which of the following is equivalent to the integral $\\int_C 4 y e^{x}\\,\\mathrm{d}s$\n\nwhere $C$ is the section of the curve $\\frac{x}{2}=\\ln y$ traversed between the points $(0,1)$ and $(4,e^{2})$.\n\n*Hint: Use the parameter $y=t.$*" :question/worked-solution "Notice that the given curve can be expressed in the form $x=x(y),$ as follows:\n\n$$\n\\frac{x}{2}=\\ln y\\,\\Longrightarrow\\,x=2 \\ln{\\left(y \\right)}\n$$\n\nTherefore, by setting $y=t,$ we have \n\n$$\nx=x(t)=2 \\ln{\\left(t \\right)}.\n$$\n\n \n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=\\langle 2 \\ln{\\left(t \\right)},\\,t\\rangle,\\quad 1\\le t\\le e^{2}\n$$\n\nNote that the domain $1\\le t\\le e^{2}$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}r^{\\prime}(t)&=\\frac{\\mathrm{d}x}{\\mathrm{d}t}i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}j \\\\ &=\\frac{\\mathrm{d}}{\\mathrm{d}t}(2 \\ln{\\left(t \\right)})i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t)j \\\\ &=(\\frac{2}{t})i+j \\\\ \\|r^{\\prime}(t)\\|&=\\sqrt{(\\frac{\\mathrm{d}x}{\\mathrm{d}t})^2+(\\frac{\\mathrm{d}y}{\\mathrm{d}t})^2} \\\\ &=\\sqrt{(\\frac{2}{t})^2+1^2} \\\\ &=\\sqrt{\\frac{4}{t^2}+1} \\\\ &=\\frac{1}{t}\\sqrt{t^{2} + 4}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=4 y e^{x}$, then we obtain \n\n$$\n\\begin{aligned}f(r(t))&=4 y e^{x} \\\\ &=4\\cdot t^{1}e^{2\\ln t} \\\\ &=4\\cdot t^{1}\\left(t^{2}\\right) \\\\ &=4 t^{3}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}\\int_C 4 y e^{x}\\,\\mathrm{d}s&=\\int_{1}^{e^{2}}f(r(t))\\|r^{\\prime}(t)\\|\\,\\mathrm{d}t \\\\ &=\\int_{1}^{e^{2}}(4 t^{3})\\cdot \\sqrt{1 + \\frac{4}{t^{2}}}\\,\\mathrm{d}t \\\\ &=\\int_{1}^{e^{2}}4 t^{2} \\sqrt{t^{2} + 4}\\,\\mathrm{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186552845 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e8e17dd-b1fd-5b63-9132-ad3a7dd6d991" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}5 t \\left(3 - 3 t^{3}\\right)^{2} \\sqrt{9 t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552797} {:answer/id #uuid "4f69e9c5-3b56-564c-bca3-98cc70036ce6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}t \\left(15 - 15 t^{3}\\right) \\sqrt{81 t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552804} {:answer/id #uuid "66347383-a7b3-50bf-9101-6c7215d0630b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}5 t \\left(3 - 3 t^{3}\\right)^{2}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552808} {:answer/id #uuid "8f161683-83c0-50bf-a17a-f24ed9e6c9f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}5 t \\left(3 - 3 t^{3}\\right)^{2} \\sqrt{81 t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552823} {:answer/id #uuid "a4ca4202-33f0-5ef5-aa09-f8e692b0f39e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}5 \\left(3 - 3 t^{3}\\right)^{2} \\sqrt{81 t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552829}] :answer-field/correct {:answer/id #uuid "8f161683-83c0-50bf-a17a-f24ed9e6c9f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{3}5 t \\left(3 - 3 t^{3}\\right)^{2} \\sqrt{81 t^{4} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186552823} :answer-field/id #uuid "7eb5ae6c-eb61-510c-8183-96be18ef2c0c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552817}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e43f4bf4-b216-5205-b149-df3643df4708" :question/problem "Which of the following is equivalent to the integral $\\int_C 5 x^{2} y\\,\\mathrm{d}s$\n\nwhere $C$ is the section of the curve $x=3 - 3 y^{3}$ traversed between the points $(3,0)$ and $(-78,3)$.\n\n*Hint: Use the parameter $y=t.$*" :question/worked-solution "Notice that the given curve is of the form $x=x(y).$ Therefore, by setting $y=t,$ we have \n\n$$\nx=x(t)=3 - 3 t^{3}.\n$$\n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=\\langle 3 - 3 t^{3},\\,t\\rangle,\\quad 0\\le t\\le 3\n$$\n\nNote that the domain $0\\le t\\le 3$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}r^{\\prime}(t)&=\\frac{\\mathrm{d}x}{\\mathrm{d}t}i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}j \\\\ &=\\frac{\\mathrm{d}}{\\mathrm{d}t}(3 - 3 t^{3})i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t)j \\\\ &=(- 9 t^{2})i+j \\\\ \\|r^{\\prime}(t)\\|&=\\sqrt{(\\frac{\\mathrm{d}x}{\\mathrm{d}t})^2+(\\frac{\\mathrm{d}y}{\\mathrm{d}t})^2} \\\\ &=\\sqrt{(- 9 t^{2})^2+1^2} \\\\ &=\\sqrt{81 t^{4} + 1}\\end{aligned}\n$$\n\nNow, if $f(x,y)=5 x^{2} y,$ then we obtain\n\n$$\n\\begin{aligned}f(r(t))&=5\\left(3 - 3 t^{3}\\right)^{2}t^{1} \\\\ &=5 t \\left(3 - 3 t^{3}\\right)^{2}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C 5 x^{2} y\\,\\mathrm{d}s&=\\int_{0}^{3}f(r(t))\\|r^{\\prime}(t)\\|\\,\\mathrm{d}t \\\\ &=\\int_{0}^{3}(5 t \\left(3 - 3 t^{3}\\right)^{2})\\cdot \\sqrt{81 t^{4} + 1}\\,\\mathrm{d}t \\\\ &=\\int_{0}^{3}5 t \\left(3 - 3 t^{3}\\right)^{2} \\sqrt{81 t^{4} + 1}\\,\\mathrm{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186553505 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d53a8c66-6804-52ec-8840-edd3d4929673" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{4}" :db/id #edb/ref 17592186553296}] :answer-field/correct {:answer/id #uuid "d53a8c66-6804-52ec-8840-edd3d4929673" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{4}" :db/id #edb/ref 17592186553296} :answer-field/id #uuid "95531b96-24f8-5a49-ac02-3bfee0bf2b70" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186553446}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "248312e6-be46-5549-b1e3-5f70f146c665" :question/math-academy-id "q-346363" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{\\pi /12}^{\\pi /8}3{csc}^{2}⁡(4x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "If we let $u=4x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4\\,⟹\\,\\text{d}x=\\frac{1}{4}\\,\\text{d}u.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $\\pi /12$ | $\\pi /8$ |\n| --- | --- | --- |\n| $u$ | $\\pi /3$ | $\\pi /2$ |\n\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{\\pi /12}^{\\pi /8}3{csc}^{2}⁡(4x)\\,\\text{d}x & ={\\int }_{\\pi /3}^{\\pi /2}3{csc}^{2}⁡(u)\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =\\frac{3}{4}{\\int }_{\\pi /3}^{\\pi /2}{csc}^{2}⁡(u)\\,\\text{d}u \\\\  & =\\frac{3}{4}(-\\operatorname{cot}⁡(u))\\,{|}_{\\pi /3}^{\\pi /2} \\\\  & =\\frac{3}{4}(-\\operatorname{cot}⁡(\\frac{\\pi }{2})+\\operatorname{cot}⁡(\\frac{\\pi }{3})) \\\\  & =\\frac{3}{4}(0+\\frac{\\sqrt{3}}{3}) \\\\  & =\\frac{\\sqrt{3}}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186553513 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e0a5b34-4019-5f4a-8375-4303ad8f7b4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "h=2\\sqrt{2}\\,\\text{cm}" :db/id #edb/ref 17592186552955} {:answer/id #uuid "471c5dea-7288-5a56-958f-067580d15baa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "h=2\\,\\text{cm}" :db/id #edb/ref 17592186553014} {:answer/id #uuid "a93496e4-97c1-5afd-84fd-e7f7ad97ced5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "h=4\\sqrt{2}\\,\\text{cm}" :db/id #edb/ref 17592186553207} {:answer/id #uuid "d4225406-8293-59b3-af72-40ed3480b4c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "h=4\\,\\text{cm}" :db/id #edb/ref 17592186553294} {:answer/id #uuid "faba3d5c-7a0d-5929-a968-a619158547ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "h=6\\,\\text{cm}" :db/id #edb/ref 17592186553365}] :answer-field/correct {:answer/id #uuid "d4225406-8293-59b3-af72-40ed3480b4c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "h=4\\,\\text{cm}" :db/id #edb/ref 17592186553294} :answer-field/id #uuid "7eef6173-ab6c-5870-82d9-2a456dd3ae17" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553435}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "32c3dd6f-214e-5de8-b074-37738b30996f" :question/math-academy-id "q-32475" :question/problem "Calculate the height $h$ of a cylinder given that its volume is $16\\pi \\,{\\text{cm}}^{3}$ and the ratio of its height to its radius is $2.$" :question/worked-solution "Using the fact that  the ratio of the height $h$ to the radius of the base $r$ is $2,$ we have that\n\n$$\n\\begin{aligned}\\frac{h}{r} & =2 \\\\ r & =\\frac{h}{2}\\end{aligned}\n$$\n\nThe volume of a cylinder with radius $r$ and height $h$ is given by\n\n$$\n\\begin{aligned}V=\\pi {r}^{2}h.\\end{aligned}\n$$\n\nSubstituting $V=16\\pi {\\text{ cm}}^{3}$ and $r=\\frac{h}{2}$ into the formula, we find the value of $h:$\n\n$$\n\\begin{aligned}V & =\\pi {r}^{2}h \\\\ 16\\pi  & =\\pi {(\\frac{h}{2})}^{2}\\cdot h \\\\ 16 & =\\frac{{h}^{3}}{4} \\\\ {h}^{3} & =64 \\\\ h & =4\\,\\text{cm}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186553515 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f27cc60-4ad8-593e-9ef5-5d362258831b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27}{{n}^{4}}{\\sum }_{j=0}^{n-1}\\,(j-2)^{3}" :db/id #edb/ref 17592186552888} {:answer/id #uuid "1b99b866-cfcd-5ab3-97e9-6c269fcfe9fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{81}{{n}^{2}}{\\sum }_{j=0}^{n-1}\\,{j}^{3}" :db/id #edb/ref 17592186552915} {:answer/id #uuid "265541b8-e6de-5a62-ba09-d145d5094973" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{{n}^{2}}{\\sum }_{j=0}^{n-1}\\,{j}^{3}" :db/id #edb/ref 17592186552935} {:answer/id #uuid "93fd0fdd-bb74-5b4c-9cce-c52e5835da23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{81}{{n}^{4}}{\\sum }_{j=0}^{n-1}\\,{j}^{3}" :db/id #edb/ref 17592186553167} {:answer/id #uuid "dfa60640-75f4-50e0-8054-4fd539a3b520" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27}{{n}^{3}}{\\sum }_{j=0}^{n-1}\\,{j}^{3}" :db/id #edb/ref 17592186553312}] :answer-field/correct {:answer/id #uuid "93fd0fdd-bb74-5b4c-9cce-c52e5835da23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{81}{{n}^{4}}{\\sum }_{j=0}^{n-1}\\,{j}^{3}" :db/id #edb/ref 17592186553167} :answer-field/id #uuid "5c5920c5-4b86-5a6d-b9f0-0d98e11b6c2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553418}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "37c41f7c-c697-50e0-8b4c-374dcc3f004e" :question/math-academy-id "q-73165" :question/problem "The area under the curve $y=(x+2)^{3}$ between $x=-2$ and $x=1$ and the $x$-axis is approximated by a left Riemann sum using $n$ subintervals of equal length. What is the expression for the Riemann sum in sigma notation?" :question/worked-solution "The left Riemann sum for $y=f(x)$ with a regular step size in sigma notation is\n\n$$\n{\\sum }_{j=0}^{n-1}f({x}_{j})Δx,\n$$\n\nwhere $n$ is the number of subintervals,   ${x}_{j}=a+jΔx$, and  $Δx=\\frac{b-a}{n}.$ \n\nThe endpoints indicate that $a=-2$ and $b=1,$ so the step size is\n\n$$\nΔx=\\frac{1-(-2)}{n}=\\frac{3}{n}.\n$$\n\nTherefore, using sigma notation, the left Riemann sum can be expressed as\n\n$$\n\\begin{aligned}{\\sum }_{j=0}^{n-1}f({x}_{j})Δx & ={\\sum }_{j=0}^{n-1}f(a+jΔx)Δx \\\\  & ={\\sum }_{j=0}^{n-1}f(-2+j\\cdot \\frac{3}{n})\\cdot \\frac{3}{n} \\\\  & ={\\sum }_{j=0}^{n-1}f(-2+\\frac{3j}{n})\\cdot \\frac{3}{n} \\\\  & ={\\sum }_{j=0}^{n-1}{(-2+\\frac{3j}{n}+2)}^{3}\\cdot \\frac{3}{n} \\\\  & ={\\sum }_{j=0}^{n-1}\\frac{3}{n}{(\\frac{3j}{n})}^{3} \\\\  & ={\\sum }_{j=0}^{n-1}\\frac{3}{n}\\cdot \\frac{27{j}^{3}}{{n}^{3}} \\\\  & =\\frac{81}{{n}^{4}}{\\sum }_{j=0}^{n-1}\\,{j}^{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186553521 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9af70380-e503-50b8-8456-a4d26ba605ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{2x+1}+\\frac{1}{\\sqrt{-x(x+1)}}" :db/id #edb/ref 17592186553182} {:answer/id #uuid "a95d1f7e-3ad0-5e4e-bba3-859fd658d6d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{2x+1}(1-\\frac{1}{\\sqrt{-x(x+1)}})" :db/id #edb/ref 17592186553208} {:answer/id #uuid "aa65b81f-556d-5759-8d4a-d96a8f580eb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{2x+1}-\\frac{1}{2\\sqrt{-x(x+1)}}" :db/id #edb/ref 17592186553213} {:answer/id #uuid "ad6f8b25-d391-5520-b35a-d57fb931c15e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{2x+1}(1+\\frac{1}{2\\sqrt{-x(x+1)}})" :db/id #edb/ref 17592186553216} {:answer/id #uuid "c5520221-3ee7-520d-9922-76e4e5d7251d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{2x+1}(1+\\frac{2}{\\sqrt{-x(x+1)}})" :db/id #edb/ref 17592186553259}] :answer-field/correct {:answer/id #uuid "ad6f8b25-d391-5520-b35a-d57fb931c15e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{2x+1}(1+\\frac{1}{2\\sqrt{-x(x+1)}})" :db/id #edb/ref 17592186553216} :answer-field/id #uuid "f6f2ed98-5841-5a83-8d7d-7fd91c809d2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553485}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5339fa9a-9297-5700-9672-1deb7e152857" :question/math-academy-id "q-95527" :question/problem "$$\n\nIf $y=\\operatorname{ln}⁡(2x+1)-\\operatorname{arsech}⁡(2x+1),$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic secant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡x)=-\\frac{1}{x\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(2x+1)-\\operatorname{arsech}⁡(2x+1)) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(2x+1))-\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡(2x+1)) \\\\  & =\\frac{2}{2x+1}-(-\\frac{1}{(2x+1)\\sqrt{1-(2x+1)^{2}}})\\cdot (2x+1)^{′} \\\\  & =\\frac{2}{2x+1}+\\frac{1}{(2x+1)\\sqrt{1-4{x}^{2}-4x-1}}\\cdot 2 \\\\  & =\\frac{2}{2x+1}+\\frac{2}{(2x+1)\\sqrt{-4{x}^{2}-4x}} \\\\  & =\\frac{2}{2x+1}(1+\\frac{1}{\\sqrt{-4x(x+1)}}) \\\\  & =\\frac{2}{2x+1}(1+\\frac{1}{2\\sqrt{-x(x+1)}}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186553524 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16806124-955c-5a66-b53a-1bee733918ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}x+\\frac{1}{6}{x}^{2}+\\frac{1}{16}{x}^{3}" :db/id #edb/ref 17592186552907} {:answer/id #uuid "99b39c3d-5a4b-5d5c-a484-9f196d28568e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{1}{2}x+\\frac{3}{16}{x}^{2}" :db/id #edb/ref 17592186553181} {:answer/id #uuid "ae4a8dfb-5ac3-5a88-bd8f-2e4bb8ba342e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+\\frac{1}{4}x+\\frac{5}{32}{x}^{2}" :db/id #edb/ref 17592186553218} {:answer/id #uuid "c5c2f18f-3f70-59e1-90ec-f0215820a629" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{1}{4}{x}^{2}+\\frac{5}{16}{x}^{4}" :db/id #edb/ref 17592186553260} {:answer/id #uuid "f7312685-0f5e-5d45-bc1e-7c19be890f56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+\\frac{1}{4}x+\\frac{3}{16}{x}^{2}" :db/id #edb/ref 17592186553359}] :answer-field/correct {:answer/id #uuid "ae4a8dfb-5ac3-5a88-bd8f-2e4bb8ba342e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+\\frac{1}{4}x+\\frac{5}{32}{x}^{2}" :db/id #edb/ref 17592186553218} :answer-field/id #uuid "9dc64f2c-cfc9-5565-be92-0803a7ce5d1e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553452}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "59ed9909-43a7-5d70-8d5b-9f3220bf2775" :question/math-academy-id "q-12438" :question/problem "The second-degree Taylor polynomial of $f(x)=\\frac{1}{\\sqrt[4]{1-x}}$ about $x=0$ is" :question/worked-solution "To find the second-degree Taylor polynomial about $x=0,$ we plug $a=0$ into the general formula to give\n\n$$\n{P}_{2}(x)=f(0)+{f}^{′}(0)(x-0)+\\frac{1}{2}{f}^{″}(0)(x-0)^{2}.\n$$\n\nSo, we need to work out $f(0),$ ${f}^{′}(0),$ and ${f}^{″}(0):$ \n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{\\sqrt[4]{1-x}}=(1-x)^{-1/4} & ⟹ &  & f(0) & =1 \\\\ {f}^{′}(x) & =\\frac{1}{4}(1-x)^{-5/4} & ⟹ &  & {f}^{′}(0) & =\\frac{1}{4} \\\\ {f}^{″}(x) & =\\frac{5}{16}(1-x)^{-9/4} & ⟹ &  & {f}^{″}(0) & =\\frac{5}{16}\\end{aligned}\n$$\n\nWe now plug the results for $f(0),$ ${f}^{′}(0),$ and ${f}^{″}(0)$ into our second-degree Taylor polynomial. This gives\n\n$$\n\\begin{aligned}{P}_{2}(x) & =1+(\\frac{1}{4})\\cdot x+(\\frac{5}{16})\\cdot \\frac{1}{2}{x}^{2} \\\\  & =1+\\frac{1}{4}x+\\frac{5}{32}{x}^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186553527 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63425058-6c08-5e95-8aaa-fe0ae9451531" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x}{\\sqrt{1+{x}^{2}}}" :db/id #edb/ref 17592186553080}] :answer-field/correct {:answer/id #uuid "63425058-6c08-5e95-8aaa-fe0ae9451531" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x}{\\sqrt{1+{x}^{2}}}" :db/id #edb/ref 17592186553080} :answer-field/id #uuid "8af448d4-fd7c-5f68-b3a3-6e5b346e24e2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186553439}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "606f9c6c-5c1e-593b-8109-6427fb98d820" :question/math-academy-id "q-341553" :question/problem "$$\n\nIf $f(x)=\\operatorname{sin}⁡x\\,\\operatorname{arcsch}⁡x,$ calculate ${f}^{′}(x).$\n\n${f}^{′}(x)=\\operatorname{cos}⁡x\\cdot \\operatorname{arcsch}⁡x\\,-\\frac{1}{|x|}\\cdot $ \n{{field-1}}" :question/worked-solution "In this case, the expression for $f(x)$ is a product $u(x)\\cdot v(x)$ with $u(x)=\\operatorname{sin}⁡x$ and $v(x)=\\operatorname{arcsch}⁡x.$\n\nTherefore, we apply the product rule as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={(\\operatorname{sin}⁡x)}^{′}\\cdot \\operatorname{arcsch}⁡x+\\operatorname{sin}⁡x\\cdot {(\\operatorname{arcsch}⁡x)}^{′} \\\\  & =\\operatorname{cos}⁡x\\cdot \\operatorname{arcsch}⁡x\\,+\\,\\operatorname{sin}⁡x\\cdot (-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}) \\\\  & =\\operatorname{cos}⁡x\\cdot \\operatorname{arcsch}⁡x-\\frac{1}{|x|}\\cdot \\frac{\\operatorname{sin}⁡x}{\\sqrt{1+{x}^{2}}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186553533 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f15eefe-3a94-52eb-b0db-fbe7b7e8c5e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{j=0}^{n-1}\\,\\operatorname{sin}⁡(\\frac{3j+3}{n})" :db/id #edb/ref 17592186552926} {:answer/id #uuid "494d84f7-e321-5bbf-9260-a5d994e6bad2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{j=1}^{n-1}\\,\\frac{3}{n}\\operatorname{sin}⁡(\\frac{j}{n}+3)" :db/id #edb/ref 17592186553021} {:answer/id #uuid "637e03eb-1b6f-575b-8c6c-dcc21ef08a1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{j=0}^{n}\\,\\frac{3}{n}\\operatorname{sin}⁡(\\frac{3j}{n})" :db/id #edb/ref 17592186553081} {:answer/id #uuid "903605f0-bbb6-51e7-b29a-abff3e1d83c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{j=0}^{n-1}\\,\\frac{3}{n}\\operatorname{sin}⁡(\\frac{3j}{n})" :db/id #edb/ref 17592186553155} {:answer/id #uuid "9b0d2c49-0687-55c5-88d3-59452dabce7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{j=1}^{n}\\,\\frac{3}{n}\\operatorname{sin}⁡(\\frac{j}{n})" :db/id #edb/ref 17592186553183}] :answer-field/correct {:answer/id #uuid "903605f0-bbb6-51e7-b29a-abff3e1d83c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{j=0}^{n-1}\\,\\frac{3}{n}\\operatorname{sin}⁡(\\frac{3j}{n})" :db/id #edb/ref 17592186553155} :answer-field/id #uuid "0287ad59-5a09-5d14-b668-9a96a7a6d0a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553376}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6c6f0b11-13a1-5912-b416-72a57173178b" :question/math-academy-id "q-116625" :question/problem "The area under the curve $y=\\operatorname{sin}⁡(x+3)$ between $x=-3$ and $x=0$ and the $x$-axis is approximated by a left Riemann sum using $n$ subintervals of equal length. What is the expression for the Riemann sum in sigma notation?" :question/worked-solution "The left Riemann sum for $y=f(x)$ with a regular step size in sigma notation is\n\n$$\n{\\sum }_{j=0}^{n-1}f({x}_{j})Δx,\n$$\n\nwhere $n$ is the number of subintervals, ${x}_{j}=a+jΔx$, and  $Δx=\\frac{b-a}{n}.$ \n\nThe endpoints indicate that $a=-3$ and $b=0,$ so the step size is\n\n$$\nΔx=\\frac{0-(-3)}{n}=\\frac{3}{n}.\n$$\n\nTherefore, using sigma notation, the left Riemann sum can be expressed as\n\n$$\n\\begin{aligned}{\\sum }_{j=0}^{n-1}f({x}_{k})Δx & ={\\sum }_{j=0}^{n-1}f(a+jΔx)Δx \\\\  & ={\\sum }_{j=0}^{n-1}f(-3+j\\cdot \\frac{3}{n})\\cdot \\frac{3}{n} \\\\  & ={\\sum }_{j=0}^{n-1}f(-3+\\frac{3j}{n})\\cdot \\frac{3}{n} \\\\  & ={\\sum }_{j=0}^{n-1}\\,\\frac{3}{n}\\cdot \\operatorname{sin}⁡(-3+\\frac{3j}{n}+3) \\\\  & ={\\sum }_{j=0}^{n-1}\\,\\frac{3}{n}\\operatorname{sin}⁡(\\frac{3j}{n}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186553553 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1abb5c2a-f907-5ec8-8eaa-045849906fd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{33}" :db/id #edb/ref 17592186552913} {:answer/id #uuid "23f1850b-9cf1-5ba9-958d-6192a230eab4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{33}{4}" :db/id #edb/ref 17592186552932} {:answer/id #uuid "68099384-0fa4-5c9d-b726-604bfb900ce3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{44}{3}" :db/id #edb/ref 17592186553087} {:answer/id #uuid "6fd4d1ee-f3c3-561f-b1b0-76bd0e228df6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186553097} {:answer/id #uuid "8a90a5e9-09f1-5cfd-a38d-7c4b2dd144a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{3}" :db/id #edb/ref 17592186553147}] :answer-field/correct {:answer/id #uuid "68099384-0fa4-5c9d-b726-604bfb900ce3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{44}{3}" :db/id #edb/ref 17592186553087} :answer-field/id #uuid "202889fe-fbdf-5866-9db5-d7e0eb76934f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553387}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "97290040-c817-56ab-b0de-389c63e1806d" :question/math-academy-id "q-99763" :question/problem "$\\frac{11}{(\\frac{3}{4})}=$" :question/worked-solution "First, remember that a fraction represents a division:\n\n$$\n\\begin{aligned}\\frac{11}{(\\frac{3}{4})}=11÷\\frac{3}{4}\\end{aligned}\n$$\n\nNow, recall that $11=\\frac{11}{1}$ and dividing by $\\frac{3}{4}$ is the same as multiplying by its reciprocal $\\frac{4}{3}.$ We can use these facts to simplify the fraction above: \n\n$$\n\\begin{aligned}11÷\\frac{3}{4} &= \\frac{11}{1}\\times \\frac{4}{3} \\\\ &= \\frac{11\\times 4}{1\\times 3} \\\\ &= \\frac{44}{3}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{11}{(\\frac{3}{4})}=\\frac{44}{3}.\n$$"} {:db/id #edb/ref 17592186553566 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0578ff56-9fb7-5619-a9b1-ed8f2ede6282" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+2}{1-x^2}" :db/id #edb/ref 17592186552874}] :answer-field/correct {:answer/id #uuid "0578ff56-9fb7-5619-a9b1-ed8f2ede6282" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+2}{1-x^2}" :db/id #edb/ref 17592186552874} :answer-field/id #uuid "586bfc89-c55e-5fa0-a3a8-3b72520ea9db" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186553416}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b39ee0b2-d875-5c07-89bc-5a93b5408c42" :question/math-academy-id "q-341558" :question/problem "$$\n\nIf $f(x)=(x+2)\\,\\operatorname{arcoth}⁡x,$ calculate ${f}^{′}(x).$\n\n${f}^{′}(x)=\\operatorname{arcoth}⁡x\\,+$ \n{{field-1}}" :question/worked-solution "In this case, the expression for $f(x)$ is a product $u(x)\\cdot v(x)$ with $u(x)=x+2$ and $v(x)=\\operatorname{arcoth}⁡x.$\n\nTherefore, we apply the product rule as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={(x+2)}^{′}\\cdot \\operatorname{arcoth}⁡x+(x+2)\\cdot {(\\operatorname{arcoth}⁡x)}^{′} \\\\  & =1\\cdot \\operatorname{arcoth}⁡x\\,+\\,(x+2)\\cdot (\\frac{1}{1-{x}^{2}}) \\\\  & =\\operatorname{arcoth}⁡x+\\frac{x+2}{1-{x}^{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186553583 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34a0c68b-e9f8-549e-842e-b401217d6da3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{i=0}^{3}\\frac{1}{2}\\operatorname{sin}⁡(\\frac{i\\pi }{4})" :db/id #edb/ref 17592186552968} {:answer/id #uuid "761a9645-004c-5d1a-a018-4e98c7126007" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{i=1}^{4}\\frac{1}{2}\\operatorname{sin}⁡(\\frac{i\\pi }{4})" :db/id #edb/ref 17592186553106} {:answer/id #uuid "ca16e453-591e-50ca-b9b0-9c6c804546b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{i=1}^{4}\\frac{1}{2}\\operatorname{sin}⁡(\\frac{i\\pi }{2})" :db/id #edb/ref 17592186553272} {:answer/id #uuid "dec5872d-a8a0-52d9-b1df-f39709699d7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{i=0}^{3}\\operatorname{sin}⁡(\\frac{i\\pi }{4})" :db/id #edb/ref 17592186553311} {:answer/id #uuid "f70e4a83-804d-5d8d-a2bf-8321912f101c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{i=1}^{4}[-\\operatorname{sin}⁡(\\frac{i\\pi }{4})]" :db/id #edb/ref 17592186553357}] :answer-field/correct {:answer/id #uuid "761a9645-004c-5d1a-a018-4e98c7126007" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{i=1}^{4}\\frac{1}{2}\\operatorname{sin}⁡(\\frac{i\\pi }{4})" :db/id #edb/ref 17592186553106} :answer-field/id #uuid "80c578ea-f1c8-5e3b-b6d6-b57c333da3a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553437}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e4c3e43e-fe55-559b-8cc6-a202da2850e8" :question/math-academy-id "q-49330" :question/problem "The area under the curve $y=\\operatorname{sin}⁡(\\frac{\\pi x}{2})$ between $x=0$ and $x=2$ and the $x$-axis is approximated by a right Riemann sum using $4$ subintervals of equal length. What is the expression for the Riemann sum in sigma notation?" :question/worked-solution "The right Riemann sum for $y=f(x)$ with a regular step size in sigma notation is\n\n$$\n{\\sum }_{i=1}^{n}f({x}_{i})Δx,\n$$\n\nwhere ${x}_{i}=a+iΔx$ with $Δx=\\frac{b-a}{n}.$ \n\nWe're told that there are $n=4$ subintervals. The endpoints indicate that $a=0$ and $b=2.$ So, the step size is\n\n$$\nΔx=\\frac{2-0}{4}=\\frac{2}{4}=\\frac{1}{2}.\n$$\n\nTherefore, using sigma notation, the right Riemann sum can be expressed as\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{n}f({x}_{i})Δx & ={\\sum }_{i=1}^{n}f(a+iΔx)Δx \\\\  & ={\\sum }_{i=1}^{4}f(0+i\\cdot \\frac{1}{2})\\cdot \\frac{1}{2} \\\\  & ={\\sum }_{i=1}^{4}f(\\frac{i}{2})\\cdot \\frac{1}{2} \\\\  & ={\\sum }_{i=1}^{4}\\frac{1}{2}\\operatorname{sin}⁡(\\frac{i\\pi }{4}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186554553 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a6c53df-03c3-5272-b79f-e92b2df68cc8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6b/6b4dec42ca9c8a54be8aa13f611907e5c7e3e4bce5e177c2cc5970bc2cf69735.png" :db/id #edb/ref 17592186553974} {:answer/id #uuid "41d3f9e0-0839-5481-977d-ea32ab572300" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/88/88b831093808dba6820a2f8faeb3770ecf50f66ef56a0ef34887622eee639a30.png" :db/id #edb/ref 17592186553989} {:answer/id #uuid "6f1cbf10-0914-558c-a35e-1b176c12da6d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/83/839406ead3c7deda0ec0f783c01e1c99aca8877a7ba0ecfdb03f7adb883706fb.png" :db/id #edb/ref 17592186554089} {:answer/id #uuid "8901eefd-bfc8-5877-be0f-8a92a3ab82dc" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/17/175b02e0003de363b989f13f7ad4082ea6d87b56f8cc616605328ba775db5be2.png" :db/id #edb/ref 17592186554156} {:answer/id #uuid "db644941-4b47-5d57-9948-d42917f87daa" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/58/587a9e679f9d446c8ae57ec93fadcb69ed423fd4803abd2150cd845ac1dc9558.png" :db/id #edb/ref 17592186554348}] :answer-field/correct {:answer/id #uuid "8901eefd-bfc8-5877-be0f-8a92a3ab82dc" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/17/175b02e0003de363b989f13f7ad4082ea6d87b56f8cc616605328ba775db5be2.png" :db/id #edb/ref 17592186554156} :answer-field/id #uuid "94669996-364b-5fcd-ac9d-e6a8be125a40" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554491}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "269fb630-a40e-5592-b4e3-251a076c8d27" :question/math-academy-id "q-17782" :question/problem "![](images/ef/efc577f386353b4120dec733e5e6a627ad2412744dce4d71deba2b500a1edec2.png)\n\nThe diagram above shows the function $y=f(x).$ Which of the following gives the graph of $y=-f(\\frac{1}{2}x-1)?$" :question/worked-solution "To perform transformations of functions with multiple operations, we must remember the following rule:\n\n1\\. First, we perform the transformations *inside* the argument of $f.$ We first carry out horizontal stretches and reflections, followed by horizontal translations.\n\n2\\. Then, we perform the transformations *outside* the argument of $f.$ We first carry out vertical stretches and reflections, followed by vertical translations.\n\nFirst, let's factor out the coefficient next to the $x$ inside the function:\n\n$$\ny=-f(\\frac{1}{2}(x-2))\n$$\n\nTo plot $y=-f(\\frac{1}{2}(x-2)),$ we apply the following steps: \n\n- Take the curve $y=f(x).$\n\n- Stretch it by a scale factor of $\\frac{1}{(\\frac{1}{2})}=2$ parallel to the $x$-axis to get the graph of $y=f(\\frac{1}{2}x).$\n\n![](images/28/2891d009bd6f5d026ca47afe90f3ec4d6fafc654b7212392b325f76fe43f806e.png)\n\n \n\n- Then, translate the result by $2$ units to the right to get the graph of $y=f(\\frac{1}{2}(x-2)).$\n\n![](images/ab/ab1f210741e01139618dc2fa1347cf1591cb90ca4f67906b89ebc7df29d77f32.png)\n\n- Finally, reflect the result across the $x$-axis to get the graph of $y=-f(\\frac{1}{2}(x-2)).$\n\n![](images/e5/e5552a14dc62407e02bb8f5e633ae194a95d313bce04abb3186b56ce83ec2974.png)"} {:db/id #edb/ref 17592186554562 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d948b64-117c-579e-b644-ff48d5689b18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{7}=-\\frac{1}{2\\,187}" :db/id #edb/ref 17592186553899} {:answer/id #uuid "414e8dd7-f46d-5b69-b647-2ab2091b8a06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{7}=\\frac{1}{2\\,187}" :db/id #edb/ref 17592186553987} {:answer/id #uuid "66e2c5cc-c66f-5b95-bdf4-64edd8104ed2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{7}=-3" :db/id #edb/ref 17592186554073} {:answer/id #uuid "a4b8e80e-0266-5cc0-9779-10e7d69bf61b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{7}=-\\frac{1}{3}" :db/id #edb/ref 17592186554231} {:answer/id #uuid "c88fe9b9-712f-5caa-8196-19c17631b170" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{7}=2\\,187" :db/id #edb/ref 17592186554311}] :answer-field/correct {:answer/id #uuid "0d948b64-117c-579e-b644-ff48d5689b18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{7}=-\\frac{1}{2\\,187}" :db/id #edb/ref 17592186553899} :answer-field/id #uuid "baf33f80-cdc5-56ca-aedb-5cb060109b06" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554506}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3805f218-eb22-5e05-bae4-085089844c85" :question/math-academy-id "q-67512" :question/problem "Find the equation for the common ratio $r$ of the geometric sequence whose $4$th term is $27$ and whose $11$th term is $-\\frac{1}{81}.$" :question/worked-solution "The formula for the $n$th term of a geometric sequence is given by\n\n$$\n{a}_{n}={a}_{1}{r}^{n-1}.\n$$\n\nApplying this formula with $n=11$ and $n=4,$ respectively, we have\n\n$$\n\\begin{aligned}{a}_{4} & ={a}_{1}{r}^{4-1}={a}_{1}{r}^{3}, \\\\ {a}_{11} & ={a}_{1}{r}^{11-1}={a}_{1}{r}^{10}.\\end{aligned}\n$$\n\nGiven that ${a}_{4}=27$ and ${a}_{11}=-\\frac{1}{81},$ we obtain the following system of equations:\n\n$$\n\\{\\begin{aligned}{a}_{1}{r}^{3}=27 \\\\ {a}_{1}{r}^{10}=-\\frac{1}{81}\\end{aligned}\n$$\n\nFinally, by dividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{{a}_{1}{r}^{10}}{{a}_{1}{r}^{3}} & =\\frac{(-\\frac{1}{81})}{27} \\\\ \\frac{\\cancel{\\,{a}_{1}\\,}{r}^{10}}{\\cancel{\\,{a}_{1}\\,}{r}^{3}} & =\\frac{(-\\frac{1}{81})}{27} \\\\ \\frac{{r}^{10}}{{r}^{3}} & =-\\frac{1}{2\\,187} \\\\ {r}^{7} & =-\\frac{1}{2\\,187}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186554567 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e72f358-8b3c-5fa0-a87f-b5c3e703b4d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186553923} {:answer/id #uuid "22b7211e-dd6c-5a3e-88e8-d3edd2915633" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0$" :db/id #edb/ref 17592186553929} {:answer/id #uuid "6d1afbe3-f463-50af-b060-99529ce98d35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $\\frac{2}{3}$" :db/id #edb/ref 17592186554083} {:answer/id #uuid "909b2006-2b10-5c79-9d1c-af317380a62c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $2$" :db/id #edb/ref 17592186554182} {:answer/id #uuid "9c753113-557c-5b1c-8957-36be50789e48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $\\frac{4}{3}$" :db/id #edb/ref 17592186554212}] :answer-field/correct {:answer/id #uuid "22b7211e-dd6c-5a3e-88e8-d3edd2915633" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0$" :db/id #edb/ref 17592186553929} :answer-field/id #uuid "5521173e-4fd0-569c-b113-b91da149682d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554462}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "41a5c3bd-58e0-5924-89f4-127ab078d31e" :question/math-academy-id "q-141408" :question/problem "Does the sequence ${a}_{n}=2{(\\frac{2}{3})}^{n}$ for $n\\ge 1$ \nconverge or diverge? If it converges, what is its limit?" :question/worked-solution "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nThe given sequence ${a}_{n}=2{(\\frac{2}{3})}^{n}$ is a geometric sequence with the common ratio $r=\\frac{2}{3}.$ \n\nSince $|r|<1,$ the sequence converges to $0.$"} {:db/id #edb/ref 17592186554568 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14580d19-87db-5577-b886-dede88420678" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{10}\\,\\text{rad/s}" :db/id #edb/ref 17592186553909} {:answer/id #uuid "1d5b4088-b923-5d8d-b898-9ef038b7221e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{20}\\,\\text{rad/s}" :db/id #edb/ref 17592186553921} {:answer/id #uuid "78790129-6ad3-5b94-a1fd-e8e6c328e78d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\,\\text{rad/s}" :db/id #edb/ref 17592186554111} {:answer/id #uuid "9212d90c-2509-5164-b39b-daaf88c41146" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\,\\text{rad/s}" :db/id #edb/ref 17592186554190} {:answer/id #uuid "f407d38e-a26b-5b5c-8e63-0d3d2b384765" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\sqrt{2}\\,\\text{rad/s}" :db/id #edb/ref 17592186554396}] :answer-field/correct {:answer/id #uuid "1d5b4088-b923-5d8d-b898-9ef038b7221e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{20}\\,\\text{rad/s}" :db/id #edb/ref 17592186553921} :answer-field/id #uuid "5096af22-5b72-55f8-89a3-f7336942ca60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554459}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4220ee9a-71ec-56c9-a4ec-d0480b90a44d" :question/math-academy-id "q-53199" :question/problem "![](images/06/06f965498f6415c08b32c5ae30235a8eec65d6dd67cd1f349e80bcbe88bd5495.png)\n\nA boy $B$ is flying a kite $K$ with a $20\\,\\text{m}$ length of string. If the kite is rising vertically at a constant speed of $1\\,\\text{m/s},$ at what rate is the angle of elevation $\\theta $ increasing when $\\theta ={45}^{∘}?$" :question/worked-solution "![](images/23/236144ff93bd22f5c4460c31e20216c45d6f8ac85dc945321dadecc093f379e0.png)\n\nIn the figure, $y$ is the kite's height, and $z$ is the distance between the boy and the kite. The quantity $z=20$ meters does not change with time because the string's length doesn't change.\n\nWe wish to calculate $\\frac{\\text{d}\\theta }{\\text{d}t}.$\nTo do this, let's start by setting up a relation between $y$ and $z.$ Relative to the angle $\\theta ,$ the sides $y$ and $z$ are the opposite and hypotenuse, respectively. So, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta  & =\\frac{y}{z} \\\\ \\operatorname{sin}⁡\\theta  & =\\frac{y}{20} \\\\ y & =20\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nNow, we differentiate both sides of the equation with respect to $t$ using implicit differentiation, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(y) & =\\frac{\\text{d}}{\\text{d}t}(20\\operatorname{sin}⁡\\theta ) \\\\ \\frac{\\text{d}y}{\\text{d}t} & =(20\\operatorname{cos}⁡\\theta )\\frac{\\text{d}\\theta }{\\text{d}t}.\\end{aligned}\n$$\n\nConverting the given information from degrees to radians, we have $\\frac{\\text{d}y}{\\text{d}t}=1$ and $\\theta ={45}^{∘}\\cdot \\frac{\\pi }{{180}^{∘}}=\\frac{\\pi }{4}.$ Substituting this into the above, we reach\n\n$$\n\\begin{aligned}1 & =(20\\operatorname{cos}⁡(\\frac{\\pi }{4}))\\frac{\\text{d}\\theta }{\\text{d}t} \\\\ \\frac{1}{20} & =(\\frac{\\sqrt{2}}{2})\\frac{\\text{d}\\theta }{\\text{d}t} \\\\ \\frac{\\text{d}\\theta }{\\text{d}t} & =\\frac{\\sqrt{2}}{20}.\\end{aligned}\n$$\n\nTherefore, the angle of elevation is increasing at a rate of $\\frac{\\sqrt{2}}{20}$ radians per second."} {:db/id #edb/ref 17592186554574 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7703407d-8788-52d9-8d23-7c0dd469068b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186554108} {:answer/id #uuid "a7281cf1-df65-5001-bdd3-ab6876280750" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186554239} {:answer/id #uuid "bd204788-03a2-5b3d-ac8e-82ebffa05caf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186554278} {:answer/id #uuid "c4208108-7b91-5e37-9f02-765baf72fbe9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186554296} {:answer/id #uuid "e264fdd1-c875-5ee0-914c-54600fb544c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186554360}] :answer-field/correct {:answer/id #uuid "a7281cf1-df65-5001-bdd3-ab6876280750" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186554239} :answer-field/id #uuid "5932e5d0-9d0c-54be-9a78-8ee0938071e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554464}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5964ffcf-bc61-5cdb-8ce3-fe3d629e8c05" :question/math-academy-id "q-340513" :question/problem "Let $F(x)=\\operatorname{sin}⁡x$ for $x\\in R.$ Suppose $f(x)$ is the $2\\pi $-periodic extension of $F(x)$ from $x\\in [0,2\\pi )$ to $x\\in R.$ Which of the following statements are true?\n\nI. $f(x+2\\pi )=f(x)$ for all $x\\in R$\n\nII. $f(x)=F(x)$ for all $x\\in R$\n\nIII. $f(x+\\pi )=f(x)$ for all $x\\in R$" :question/worked-solution "Since $f$ is the $2\\pi $-periodic extension of $F,$ we have \n\n- $f(x+2\\pi )=f(x)$ for all $x\\in R,$ and\n\n- $f(x)=F(x)$ for all $x\\in [0,2\\pi ).$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. This is exactly the definition of $2\\pi $-periodicity:\n\n$$\nf(x+2\\pi )=f(x)\n$$\n\nfor all $x\\in R.$\n\n- Statement II is true. Notice that $F$ itself is $2\\pi $-periodic, because for any $x\\in R,$ we have\n\n$$\n\\begin{aligned}F(x+2\\pi )=\\operatorname{sin}⁡(x+2\\pi )=\\operatorname{sin}⁡(x)=F(x).\\end{aligned}\n$$\n\nSince $F$ already satisfies the periodicity rule, the $2\\pi $-periodic extension agrees with $F$ everywhere, so $f(x)=F(x)$ for all $x\\in R.$\n\n- Statement III is false. For example, take $x=\\frac{\\pi }{2}.$ Then,\n\n$$\n\\begin{aligned}f(\\frac{\\pi }{2}+\\pi )=f(\\frac{3\\pi }{2})=F(\\frac{3\\pi }{2})=-1,\\end{aligned}\n$$\n\nwhile\n\n$$\n\\begin{aligned}f(\\frac{\\pi }{2})=F(\\frac{\\pi }{2})=1.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I only\"."} {:db/id #edb/ref 17592186554576 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80386a1f-1c68-542d-97ab-e6ec02fe80f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\sqrt[3]{(x+2)^{2}}" :db/id #edb/ref 17592186554125} {:answer/id #uuid "9eb339eb-1cc4-5d35-9e83-6c06760cd1fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{(3x+6)^{2}}" :db/id #edb/ref 17592186554219} {:answer/id #uuid "c88b7035-072c-5214-bd55-1804a6aa0ae7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{(3x+6)^{4}}" :db/id #edb/ref 17592186554310} {:answer/id #uuid "e2ae8cb1-1ad1-519a-a9ae-fc0f9b33b01f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{3x+6}" :db/id #edb/ref 17592186554361} {:answer/id #uuid "ec4a59e0-949a-5cc8-91d2-09ecb393925e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt[3]{(x+2)^{4}}" :db/id #edb/ref 17592186554386}] :answer-field/correct {:answer/id #uuid "c88b7035-072c-5214-bd55-1804a6aa0ae7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{(3x+6)^{4}}" :db/id #edb/ref 17592186554310} :answer-field/id #uuid "8c497ffd-4cca-50b5-a7fc-dc93d720ea25" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554487}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5c789989-28b9-52e0-ac72-a0f8b7d66a60" :question/math-academy-id "q-138860" :question/problem "Consider the function $y=\\sqrt[3]{\\frac{({x}^{2}+2)^{6}}{3x+6}}.$ The derivative of this function is given by\n\n$$\n{y}^{′}=\\frac{({x}^{2}+2)(11{x}^{2}+24x-2)}{g(x)}.\n$$\n\nFind the function $g(x).$" :question/worked-solution "Our function can be written as\n\n$$\n\\begin{aligned}y & =\\sqrt[3]{\\frac{({x}^{2}+2)^{6}}{3x+6}} \\\\  & =\\frac{\\sqrt[3]{({x}^{2}+2)^{6}}}{\\sqrt[3]{3x+6}} \\\\  & =\\frac{({x}^{2}+2)^{6/3}}{(3x+6)^{1/3}} \\\\  & =\\frac{({x}^{2}+2)^{2}}{(3x+6)^{1/3}}.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{({x}^{2}+2)^{2}}{(3x+6)^{1/3}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+2)^{2})-\\operatorname{ln}⁡((3x+6)^{1/3}) \\\\ \\operatorname{ln}⁡y & =2\\operatorname{ln}⁡({x}^{2}+2)-\\frac{1}{3}\\operatorname{ln}⁡(3x+6)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(2\\operatorname{ln}⁡({x}^{2}+2)-\\frac{1}{3}\\operatorname{ln}⁡(3x+6)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =2\\cdot \\frac{1}{{x}^{2}+2}\\cdot 2x-\\frac{1}{3}\\cdot \\frac{1}{3x+6}\\cdot 3 \\\\ \\frac{{y}^{′}}{y} & =\\frac{4x}{{x}^{2}+2}-\\frac{1}{3x+6}\\end{aligned}\n$$\n\n \n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{4x}{{x}^{2}+2}-\\frac{1}{3x+6})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\sqrt[3]{\\frac{({x}^{2}+2)^{6}}{3x+6}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\sqrt[3]{\\frac{({x}^{2}+2)^{6}}{3x+6}}(\\frac{4x}{{x}^{2}+2}-\\frac{1}{3x+6}) \\\\  & =\\sqrt[3]{\\frac{({x}^{2}+2)^{6}}{3x+6}}(\\frac{4x(3x+6)-({x}^{2}+2)}{({x}^{2}+2)(3x+6)}) \\\\  & =\\sqrt[3]{\\frac{({x}^{2}+2)^{6}}{3x+6}}(\\frac{11{x}^{2}+24x-2}{({x}^{2}+2)(3x+6)}) \\\\  & =\\frac{({x}^{2}+2)(11{x}^{2}+24x-2)}{\\sqrt[3]{(3x-6)^{4}}}\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\ng(x)=\\sqrt[3]{(3x-6)^{4}}.\n$$"} {:db/id #edb/ref 17592186554588 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4748909d-6528-5bed-ac92-aa61a9379c63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186554004} {:answer/id #uuid "4d1289eb-910a-5785-b6b0-3fd7998b0a0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186554018} {:answer/id #uuid "5685f6f8-da97-57f5-82fe-f48a3267d960" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186554037} {:answer/id #uuid "a499d257-2f0a-5c4a-b368-feeb1f43f5c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186554230} {:answer/id #uuid "a9d91c8e-478d-51eb-a6d6-2618550a13c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186554249}] :answer-field/correct {:answer/id #uuid "a499d257-2f0a-5c4a-b368-feeb1f43f5c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186554230} :answer-field/id #uuid "1e4ad903-4e09-5e2b-9085-556ef9945de6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554445}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7794f339-0fd4-50d9-a0ab-1ce4d82318cb" :question/math-academy-id "q-64032" :question/problem "Find the common ratio of the geometric sequence whose second term is $48$ and whose fifth term is $6.$" :question/worked-solution "To find the common ratio $r$ of a geometric sequence given two terms ${a}_{m}$ and ${a}_{n},$ we use the formula\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}.\n$$\n\nIn this case, we're given ${a}_{5}=6$ and ${a}_{2}=48.$ Substituting $n=5$ and $m=2$ into the formula, we have\n\n$$\n\\begin{aligned}{r}^{5-2} & =\\frac{{a}_{5}}{{a}_{2}} \\\\ {r}^{3} & =\\frac{6}{48} \\\\ {r}^{3} & =\\frac{1}{8}.\\end{aligned}\n$$\n\nFinally, by solving the equation for $r,$ we get\n\n$$\n\\begin{aligned}{r}^{3} & =\\frac{1}{8} \\\\ {r}^{3} & ={(\\frac{1}{2})}^{3} \\\\ r & =\\frac{1}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186554601 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56ac1be1-fce4-5b14-a773-c0df14c2a9b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $2$" :db/id #edb/ref 17592186554039} {:answer/id #uuid "6417f28a-8f7f-5ecc-be6c-7c8da2415e24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $\\frac{1}{2}$" :db/id #edb/ref 17592186554064} {:answer/id #uuid "8301edff-e58a-593a-be70-3f68ef33e5f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186554133} {:answer/id #uuid "8435d0e8-40cd-5cd4-89d6-083368872674" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0.$" :db/id #edb/ref 17592186554139} {:answer/id #uuid "8f866f3c-7689-5311-b7e1-0b559c9e9370" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $4$" :db/id #edb/ref 17592186554176}] :answer-field/correct {:answer/id #uuid "8435d0e8-40cd-5cd4-89d6-083368872674" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0.$" :db/id #edb/ref 17592186554139} :answer-field/id #uuid "dbf8a36f-7f35-538f-b598-e5154c361dd2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554523}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8f0ee2b9-8191-5f49-b4c7-7195eb067ecb" :question/math-academy-id "q-141404" :question/problem "Does the sequence ${a}_{n}=4{(\\frac{1}{2})}^{n-1}$ for $n\\ge 1$ \nconverge or diverge? If it converges, what is its limit?" :question/worked-solution "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nThe given sequence ${a}_{n}=4{(\\frac{1}{2})}^{n-1}$ is a geometric sequence with the common ratio $r=\\frac{1}{2}.$ \n\nSince $|r|<1,$ the sequence converges to $0.$"} {:db/id #edb/ref 17592186554602 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00514e84-3144-5df4-82c2-33eb39ce62b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16\\sqrt{2}\\pi }{3}" :db/id #edb/ref 17592186553865} {:answer/id #uuid "8db89be6-e547-5fa5-9888-b55fe82c1cef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{2}(4-\\sqrt{2})" :db/id #edb/ref 17592186554170} {:answer/id #uuid "9273e530-04e8-5996-b68a-1f42eb0f608e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16\\pi }{3}(2-\\sqrt{2})" :db/id #edb/ref 17592186554192} {:answer/id #uuid "e88ae27f-5535-584b-9730-b1ae58287e87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8\\pi }{3}(8-\\sqrt{2})" :db/id #edb/ref 17592186554372} {:answer/id #uuid "e892a90b-d1ba-521a-b1de-129de62c0978" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16\\pi }{3}(4-\\sqrt{2})" :db/id #edb/ref 17592186554373}] :answer-field/correct {:answer/id #uuid "e892a90b-d1ba-521a-b1de-129de62c0978" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16\\pi }{3}(4-\\sqrt{2})" :db/id #edb/ref 17592186554373} :answer-field/id #uuid "c5e8aa5a-ac76-5fe7-8cbb-d1e2111d6174" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554511}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8fe28743-a486-54a9-8fdd-bcbf858bcbbf" :question/math-academy-id "q-139035" :question/problem "Consider the curve defined parametrically as \n\n$$\nx=2{e}^{t/2},\\,y={e}^{t},\\,t\\in [0,\\operatorname{ln}⁡3].\n$$\n\nCalculate the surface area generated when this curve is rotated $2\\pi $ radians about the $y$-axis." :question/worked-solution "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\text{d}s=\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nWe are told that the limits of integration are from ${t}_{1}=0$ to ${t}_{2}=\\operatorname{ln}⁡3.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2{e}^{t/2})={e}^{t/2} \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\operatorname{ln}⁡3}2{e}^{t/2}\\sqrt{{({e}^{t/2})}^{2}+{({e}^{t})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\operatorname{ln}⁡3}2{e}^{t/2}\\sqrt{{e}^{t}+{e}^{2t}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\operatorname{ln}⁡3}2{e}^{t/2}\\sqrt{{e}^{t}(1+{e}^{t})}\\,\\text{d}t \\\\  & =4\\pi {\\int }_{0}^{\\operatorname{ln}⁡3}{e}^{t/2}\\cdot {e}^{t/2}\\sqrt{1+{e}^{t}}\\,\\text{d}t \\\\  & =4\\pi {\\int }_{0}^{\\operatorname{ln}⁡3}{e}^{t}\\sqrt{1+{e}^{t}}\\,\\text{d}t\\end{aligned}\n$$\n\nWe evaluate the last integral using the substitution $u=1+{e}^{t}.$ Then, $\\text{d}u={e}^{t}\\,\\text{d}t.$ We also need to compute new limits, given below.\n\n| **$t$** | $0$ | $\\operatorname{ln}⁡3$ |\n| --- | --- | --- |\n| $u$ | $2$ | $4$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}S & =4\\pi {\\int }_{0}^{\\operatorname{ln}⁡3}{e}^{t}\\sqrt{1+{e}^{t}}\\,\\text{d}t \\\\  & =4\\pi {\\int }_{2}^{4}\\sqrt{u}\\,\\text{d}u \\\\  & =4\\pi {\\int }_{2}^{4}{u}^{1/2}\\,\\text{d}u \\\\  & =4\\pi \\cdot {\\frac{2{u}^{3/2}}{3}|}_{2}^{4} \\\\  & =\\frac{8\\pi }{3}({4}^{3/2}-{2}^{3/2}) \\\\  & =\\frac{8\\pi }{3}(8-2\\sqrt{2}) \\\\  & =\\frac{16\\pi }{3}(4-\\sqrt{2}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186554612 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "172dbd89-674a-5726-9630-7750a809157b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186553913} {:answer/id #uuid "a6329dad-6c6c-5def-8fa9-b82fbf186adf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186554235} {:answer/id #uuid "cb86a186-51eb-54d5-a27b-6e2065c66032" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186554318} {:answer/id #uuid "f4430166-3747-5209-944a-ba1d986e72e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186554397} {:answer/id #uuid "fae193f4-9c23-5527-acbb-523664fd50e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186554409}] :answer-field/correct {:answer/id #uuid "fae193f4-9c23-5527-acbb-523664fd50e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186554409} :answer-field/id #uuid "bdd707aa-f658-5dc0-88e8-2cc1aff0bd8c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554507}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a5c77383-51aa-56e3-a7b4-492c5c358798" :question/math-academy-id "q-64033" :question/problem "Find the common ratio of the geometric sequence whose fourth term is $135$ and whose seventh term is $5.$" :question/worked-solution "To find the common ratio $r$ of a geometric sequence given two terms ${a}_{m}$ and ${a}_{n},$ we use the formula \n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}.\n$$\n\nIn this case, we're given ${a}_{7}=5$ and ${a}_{4}=135.$ Substituting $n=7$ and $m=4$ into the formula, we have\n\n$$\n\\begin{aligned}{r}^{7-4} & =\\frac{{a}_{7}}{{a}_{4}} \\\\ {r}^{3} & =\\frac{5}{135} \\\\ {r}^{3} & =\\frac{1}{27}.\\end{aligned}\n$$\n\nFinally, by solving the equation for $r,$ we get\n\n$$\n\\begin{aligned}{r}^{3} & =\\frac{1}{27} \\\\ {r}^{3} & ={(\\frac{1}{3})}^{3} \\\\ r & =\\frac{1}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186554622 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0acd652e-3691-5e84-bd19-a5ecf963137a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186553891}] :answer-field/correct {:answer/id #uuid "0acd652e-3691-5e84-bd19-a5ecf963137a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186553891} :answer-field/id #uuid "b1bfd8d1-d406-5259-8076-e675c9f53bf2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186554499}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d00df18b-1c5e-50a7-89f5-e1bc96838901" :question/math-academy-id "q-314883" :question/problem "![](images/7d/7de8ecd3d178cf07377aef5ca96ce28f638700e6284d151e3578ba11ed87327a.png)\n\nEthan notices a drone descending. He estimates that the distance between his location and the point on the ground directly beneath the drone is $150\\,\\text{ft}.$ If the angle of elevation $\\theta $ between him and the drone decreases at a rate of $0.1\\,\\text{rad/s},$ at what rate is its altitude decreasing when $\\theta =\\frac{\\pi }{3}?$ Assume that the rate of decreasing altitude is **positive** and do not round the answer.\n\nThe drone's altitude is decreasing at a rate of\n{{field-1}}\n$\\text{ft/s}.$" :question/worked-solution "![](images/50/5024a642ac27698d848577165b08e3158d3248d50c064a79432fcad6e2df90d5.png)\n\nIn the figure, $y$ is the drone’s altitude, and $x$ is the distance between Ethan and the shadow. The quantity $x=150\\,\\text{ft}$ does not change with time because the distance between Ethan and the shadow is fixed.\n\nWe wish to calculate $\\frac{\\text{d}y}{\\text{d}t}.$ To do this, let's start by setting up a relation between $x$ and $y.$ Relative to the angle $\\theta ,$ the sides $x$ and $y$ are the adjacent and opposite, respectively. So, we have\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡\\theta  & =\\frac{y}{x} \\\\ \\operatorname{tan}⁡\\theta  & =\\frac{y}{150} \\\\ y & =150\\operatorname{tan}⁡\\theta .\\end{aligned}\n$$\n\nNow, we differentiate both sides of the equation with respect to $t$ using implicit differentiation, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(y) & =\\frac{\\text{d}}{\\text{d}t}(150\\operatorname{tan}⁡\\theta ) \\\\ \\frac{\\text{d}y}{\\text{d}t} & =150{sec}^{2}⁡\\theta \\cdot \\frac{\\text{d}\\theta }{\\text{d}t}\\end{aligned}\n$$\n\nFrom the given information, we have $\\frac{\\text{d}\\theta }{\\text{d}t}=-0.1$ (negative because the angle is decreasing) and $\\theta =\\frac{\\pi }{3}.$ Substituting these values into the above, we reach\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =150{sec}^{2}⁡(\\frac{\\pi }{3})(-0.1) \\\\ \\frac{\\text{d}y}{\\text{d}t} & =150(4)(-0.1) \\\\ \\frac{\\text{d}y}{\\text{d}t} & =-60.\\end{aligned}\n$$\n\nTherefore, the drone's altitude is decreasing at a rate of $60\\,\\text{ft/s}.$"} {:db/id #edb/ref 17592186554643 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06c9dab7-2e99-5365-b6f9-2f92a770a384" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0e/0e49310e5441552232d841954e95fe3b38015b27565050fbd384d54b35a56bfc.png" :db/id #edb/ref 17592186553883} {:answer/id #uuid "11d75bbb-77b6-5e55-baef-b5f3c412881a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8f/8f8f679798bf48d8543522dfc3c77c25de4ebfd55618c17ea033549caea2f40a.png" :db/id #edb/ref 17592186553906} {:answer/id #uuid "56a351e4-0067-508f-9e5a-e7e8908908cd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3d/3d4a416592d9fe3683f6b39bb99ebef44d3f0b36c37b50f86c9dac5fa8aa862f.png" :db/id #edb/ref 17592186554038} {:answer/id #uuid "89c6681c-3b74-5712-ac28-f5586469ed52" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d2/d2dad7c3e898a680e07eba09d822733619f1158f9877136ba11078e90cbf75c2.png" :db/id #edb/ref 17592186554159} {:answer/id #uuid "e204c221-f408-5b2f-b387-49819b320673" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/eb/eb85e0857a24ae273e7e768c51e80c08461be095e502e45c2c83e7340bf725b2.png" :db/id #edb/ref 17592186554358}] :answer-field/correct {:answer/id #uuid "06c9dab7-2e99-5365-b6f9-2f92a770a384" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0e/0e49310e5441552232d841954e95fe3b38015b27565050fbd384d54b35a56bfc.png" :db/id #edb/ref 17592186553883} :answer-field/id #uuid "16b058af-5b74-55ea-8310-41c6fb4502e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554441}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f73ff2c0-b98a-5833-8e43-d855656798f9" :question/math-academy-id "q-114069" :question/problem "![](images/93/938babc27340209a1a5477fb3184abbf155f409c520c76995c4e234f99691347.png)\n\nThe diagram above shows the function $y=f(x).$ Which of the following gives the graph of $y=-f(\\frac{x}{3})?$" :question/worked-solution "To perform transformations of functions with multiple operations, we must remember the following rule:\n\n1\\. First, we perform the transformations *inside* the argument of $f.$ We first carry out horizontal stretches and reflections, followed by horizontal translations.\n\n2\\. Then, we perform the transformations *outside* the argument of $f.$ We first carry out vertical stretches and reflections, followed by vertical translations.\n\nTo plot $y=-f(\\frac{x}{3}),$ we apply the following steps:\n\n- Take the curve $y=f(x).$\n\n- Stretch it by a scale factor of $\\frac{1}{(\\frac{1}{3})}=3$ parallel to the $x$-axis to get the graph of $y=f(\\frac{x}{3}).$\n\n![](images/f0/f0b289d42620a275eeb90d4bdbe265ca92ea4264de70ecc11e5f661a84149628.png)\n\n- Then, reflect the result across the $x$-axis to get the graph of $y=-f(\\frac{x}{3}).$\n\n![](images/59/597ba19a0c993ea597ecd091df02d97e974364125c79780df04aef365442abb6.png)"} {:db/id #edb/ref 17592186554837 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b9b48b0-d97f-58e4-9020-b27a2d4f3d6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{\\sqrt{8}}" :db/id #edb/ref 17592186554819} {:answer/id #uuid "8bb04077-d22e-5117-b194-0f0acf1d352d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{30}+2\\sqrt{6}}{\\sqrt{80}}" :db/id #edb/ref 17592186554831} {:answer/id #uuid "9e5683dd-3b44-569f-9184-b9a9dd913da0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-(\\frac{\\sqrt{30}-2\\sqrt{6}}{\\sqrt{80}})" :db/id #edb/ref 17592186554832} {:answer/id #uuid "a38f036c-5867-564b-8d07-e1b6b83b524f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{\\sqrt{8}}-\\frac{\\sqrt{3}}{10}" :db/id #edb/ref 17592186554834} {:answer/id #uuid "e97936bc-ddbb-5b82-994c-9bbad040900c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{30}-2\\sqrt{6}}{\\sqrt{80}}" :db/id #edb/ref 17592186554847}] :answer-field/correct {:answer/id #uuid "e97936bc-ddbb-5b82-994c-9bbad040900c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{30}-2\\sqrt{6}}{\\sqrt{80}}" :db/id #edb/ref 17592186554847} :answer-field/id #uuid "db09d6ae-d98a-5518-8809-069b4c1aee1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554843}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b3e4b28c-e8a8-5cbb-89ef-d351d2bc4c04" :question/problem "Let $a=⟨-\\sqrt{3},-\\sqrt{6},1⟩$ and $b=⟨-1,1,\\sqrt{6}⟩.$ Find ${\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b.$" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{(-\\sqrt{3})(-1)+(-\\sqrt{6})(1)+(1)(\\sqrt{6})}{\\sqrt{(-1)^{2}+{1}^{2}+(\\sqrt{6})^{2}}} \\\\  & =\\frac{\\sqrt{3}-\\sqrt{6}+\\sqrt{6}}{\\sqrt{8}} \\\\  & =\\frac{\\sqrt{3}}{\\sqrt{8}}.\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{a}\\,b & =\\frac{b\\cdot a}{|\\,a\\,|} \\\\  & =\\frac{{b}_{x}{a}_{x}+{b}_{y}{a}_{y}+{b}_{z}{a}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}} \\\\  & =\\frac{\\sqrt{3}}{\\sqrt{(-\\sqrt{3})^{2}+(-\\sqrt{6})^{2}+{1}^{2}}} \\\\  & =\\frac{\\sqrt{3}}{\\sqrt{10}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b & =\\frac{\\sqrt{3}}{\\sqrt{8}}-\\frac{\\sqrt{3}}{\\sqrt{10}} \\\\  & =\\frac{\\sqrt{30}-2\\sqrt{6}}{\\sqrt{80}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186554839 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3008eecb-dd1f-56ce-9019-7b10e3694893" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{2}}{\\sqrt{10}}" :db/id #edb/ref 17592186554822} {:answer/id #uuid "3dbe5db7-75f9-5a77-b537-b1a09cc57e51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{2}}{\\sqrt{10}}+\\frac{2\\sqrt{2}}{20}" :db/id #edb/ref 17592186554824} {:answer/id #uuid "46374ed0-5dc9-5f91-a8d1-bd7992f47ffb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{10}-4\\sqrt{5}}{\\sqrt{200}}" :db/id #edb/ref 17592186554826} {:answer/id #uuid "d309d8da-6af7-57bb-b7ea-1d4bce7cb08a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{10}+4\\sqrt{5}}{\\sqrt{200}}" :db/id #edb/ref 17592186554840} {:answer/id #uuid "f0b4caf3-f064-58e4-810d-38b21051f146" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-(\\frac{4\\sqrt{10}+4\\sqrt{5}}{\\sqrt{200}})" :db/id #edb/ref 17592186554849}] :answer-field/correct {:answer/id #uuid "d309d8da-6af7-57bb-b7ea-1d4bce7cb08a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{10}+4\\sqrt{5}}{\\sqrt{200}}" :db/id #edb/ref 17592186554840} :answer-field/id #uuid "ab1bd42b-9b4a-500f-a3fe-01ffe62acb76" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554836}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d2188174-52cd-511b-87a0-828e4b888f06" :question/problem "Let $a=⟨-1,-\\sqrt{3},4⟩$ and $b=⟨-\\sqrt{2},\\sqrt{6},\\sqrt{2}⟩.$ Find ${\\text{comp}}_{b}\\,a+{\\text{comp}}_{a}\\,b.$" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{(-1)(-\\sqrt{2})+(-\\sqrt{3})(\\sqrt{6})+(4)(\\sqrt{2})}{\\sqrt{(-\\sqrt{2})^{2}+(\\sqrt{6})^{2}+(\\sqrt{2})^{2}}} \\\\  & =\\frac{\\sqrt{2}-3\\sqrt{2}+4\\sqrt{2}}{\\sqrt{10}} \\\\  & =\\frac{2\\sqrt{2}}{\\sqrt{10}}.\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{a}\\,b & =\\frac{b\\cdot a}{|\\,a\\,|} \\\\  & =\\frac{{b}_{x}{a}_{x}+{b}_{y}{a}_{y}+{b}_{z}{a}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}} \\\\  & =\\frac{2\\sqrt{2}}{\\sqrt{(-1)^{2}+(-\\sqrt{3})^{2}+{4}^{2}}} \\\\  & =\\frac{2\\sqrt{2}}{\\sqrt{20}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a+{\\text{comp}}_{a}\\,b & =\\frac{2\\sqrt{2}}{\\sqrt{10}}+\\frac{2\\sqrt{2}}{\\sqrt{20}} \\\\  & =\\frac{4\\sqrt{10}+4\\sqrt{5}}{\\sqrt{200}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186554842 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2256bc8f-16a5-5763-9ff1-4dffbeae3f17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-\\sqrt{15}-1}{\\sqrt{8}}" :db/id #edb/ref 17592186554821} {:answer/id #uuid "31ba76c7-5b61-52e2-8626-7c128445a699" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{15}\\left(-\\sqrt{15}-1\\right)-(2\\sqrt{2}\\left(-\\sqrt{15}-1\\right))}{\\sqrt{120}}" :db/id #edb/ref 17592186554823} {:answer/id #uuid "c624c424-e407-59d8-b6d8-5d60cf147b8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{15}\\left(-\\sqrt{15}-1\\right)+(2\\sqrt{2}\\left(-\\sqrt{15}-1\\right))}{\\sqrt{120}}" :db/id #edb/ref 17592186554838} {:answer/id #uuid "d311c211-ba0b-574c-b6f7-1faff00bc1fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-(\\frac{\\sqrt{15}\\left(-\\sqrt{15}-1\\right)-(2\\sqrt{2}\\left(-\\sqrt{15}-1\\right))}{\\sqrt{120}})" :db/id #edb/ref 17592186554841} {:answer/id #uuid "ef54b90c-8daf-5b9c-bdc2-f56a5c5c5ed1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-\\sqrt{15}-1}{\\sqrt{8}}-(\\frac{-\\sqrt{15}-1}{15})" :db/id #edb/ref 17592186554848}] :answer-field/correct {:answer/id #uuid "31ba76c7-5b61-52e2-8626-7c128445a699" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{15}\\left(-\\sqrt{15}-1\\right)-(2\\sqrt{2}\\left(-\\sqrt{15}-1\\right))}{\\sqrt{120}}" :db/id #edb/ref 17592186554823} :answer-field/id #uuid "4f521ab9-1ddd-5450-85ba-9420283060bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554828}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d9750954-2644-5f46-9bc3-7cd5fcb4219c" :question/problem "Let $a=⟨3,\\sqrt{5},1⟩$ and $b=⟨-1,-\\sqrt{3},2⟩.$ Find ${\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b.$" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{(3)(-1)+(\\sqrt{5})(-\\sqrt{3})+(1)(2)}{\\sqrt{(-1)^{2}+(-\\sqrt{3})^{2}+{2}^{2}}} \\\\  & =\\frac{-3-\\sqrt{15}+2}{\\sqrt{8}} \\\\  & =\\frac{-\\sqrt{15}-1}{\\sqrt{8}}.\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{a}\\,b & =\\frac{b\\cdot a}{|\\,a\\,|} \\\\  & =\\frac{{b}_{x}{a}_{x}+{b}_{y}{a}_{y}+{b}_{z}{a}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}} \\\\  & =\\frac{-\\sqrt{15}-1}{\\sqrt{{3}^{2}+(\\sqrt{5})^{2}+{1}^{2}}} \\\\  & =\\frac{-\\sqrt{15}-1}{\\sqrt{15}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b & =-\\frac{1+\\sqrt{15}}{\\sqrt{8}}-(-\\frac{1+\\sqrt{15}}{\\sqrt{15}}) \\\\  & =\\frac{\\sqrt{15}\\left(-\\sqrt{15}-1\\right)-(2\\sqrt{2}\\left(-\\sqrt{15}-1\\right))}{\\sqrt{120}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186554844 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fea03f7-25d3-517e-9cc2-81572e335e71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}\\left(-6-3\\sqrt{3}\\right)+(\\sqrt{31}\\left(-6-3\\sqrt{3}\\right))}{\\sqrt{558}}" :db/id #edb/ref 17592186554825} {:answer/id #uuid "5ef9a9d5-a739-56b2-9661-ac1056cf1fc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-6-3\\sqrt{3}}{\\sqrt{31}}" :db/id #edb/ref 17592186554829} {:answer/id #uuid "7531ab09-81e4-58af-afd3-fb322d27c79f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}\\left(-6-3\\sqrt{3}\\right)-(\\sqrt{31}\\left(-6-3\\sqrt{3}\\right))}{\\sqrt{558}}" :db/id #edb/ref 17592186554830} {:answer/id #uuid "a18083e1-382f-5d93-afe5-ff52c2b3cc00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-(\\frac{3\\sqrt{2}\\left(-6-3\\sqrt{3}\\right)-(\\sqrt{31}\\left(-6-3\\sqrt{3}\\right))}{\\sqrt{558}})" :db/id #edb/ref 17592186554833} {:answer/id #uuid "e10defb3-8236-5ae1-b347-1f178892fd43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-6-3\\sqrt{3}}{\\sqrt{31}}-(\\frac{-6-3\\sqrt{3}}{18})" :db/id #edb/ref 17592186554845}] :answer-field/correct {:answer/id #uuid "7531ab09-81e4-58af-afd3-fb322d27c79f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}\\left(-6-3\\sqrt{3}\\right)-(\\sqrt{31}\\left(-6-3\\sqrt{3}\\right))}{\\sqrt{558}}" :db/id #edb/ref 17592186554830} :answer-field/id #uuid "1f3ed2bb-7c5c-5d4f-8584-c6f1cbf01e87" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554820}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "de71841a-f8e7-51cc-a207-4dfd1f658c74" :question/problem "Let $a=⟨\\sqrt{3},3,-\\sqrt{6}⟩$ and $b=⟨-3,-4,-\\sqrt{6}⟩.$ Find ${\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b.$" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{(\\sqrt{3})(-3)+(3)(-4)+(-\\sqrt{6})(-\\sqrt{6})}{\\sqrt{(-3)^{2}+(-4)^{2}+(-\\sqrt{6})^{2}}} \\\\  & =\\frac{-3\\sqrt{3}-12+6}{\\sqrt{31}} \\\\  & =\\frac{-6-3\\sqrt{3}}{\\sqrt{31}}.\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{a}\\,b & =\\frac{b\\cdot a}{|\\,a\\,|} \\\\  & =\\frac{{b}_{x}{a}_{x}+{b}_{y}{a}_{y}+{b}_{z}{a}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}} \\\\  & =\\frac{-6-3\\sqrt{3}}{\\sqrt{(\\sqrt{3})^{2}+{3}^{2}+(-\\sqrt{6})^{2}}} \\\\  & =\\frac{-6-3\\sqrt{3}}{\\sqrt{18}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b & =-\\frac{3\\sqrt{3}+6}{\\sqrt{31}}-(-\\frac{3\\sqrt{3}+6}{\\sqrt{18}}) \\\\  & =\\frac{3\\sqrt{2}\\left(-6-3\\sqrt{3}\\right)-(\\sqrt{31}\\left(-6-3\\sqrt{3}\\right))}{\\sqrt{558}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186554939 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a869629-3129-5a48-b814-3ca9009f93a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(- \\frac{3}{2},\\frac{1}{2})$ and radius is $75$" :db/id #edb/ref 17592186554929} {:answer/id #uuid "5363a872-00c2-59dc-9aef-c1861b33c441" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(\\frac{3}{2},- \\frac{1}{2})$ and radius is $5 \\sqrt{3}$" :db/id #edb/ref 17592186554933} {:answer/id #uuid "694d2ebd-518e-56b2-91e5-b162c47dfcdc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(- \\frac{3}{2},- \\frac{1}{2})$ and radius is $5 \\sqrt{3}$" :db/id #edb/ref 17592186554942} {:answer/id #uuid "7039e8d1-5a0b-5709-9a54-16e8324253c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(- \\frac{3}{2},\\frac{1}{2})$ and radius is $5 \\sqrt{3}$" :db/id #edb/ref 17592186554945} {:answer/id #uuid "7a590015-345d-55cf-902a-d501711e512c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(\\frac{3}{2},\\frac{1}{2})$ and radius is $5 \\sqrt{3}$" :db/id #edb/ref 17592186554948}] :answer-field/correct {:answer/id #uuid "7039e8d1-5a0b-5709-9a54-16e8324253c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(- \\frac{3}{2},\\frac{1}{2})$ and radius is $5 \\sqrt{3}$" :db/id #edb/ref 17592186554945} :answer-field/id #uuid "c5c87030-ce63-5b8f-a2fb-928bbcbfc368" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554969}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "61a667fa-1c17-504b-b910-d39cb45f95f5" :question/problem "What is the center and radius of the circle with equation $(x+\\frac{3}{2})^{2}+(y-\\frac{1}{2})^{2}=75?$" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nLet's compare the general equation to our equation side-by-side as follows:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x+\\frac{3}{2})^{2}+(y-\\frac{1}{2})^{2} & =75 \\\\ (x-(- \\frac{3}{2}))^{2}+(y-\\frac{1}{2})^{2} & =(5 \\sqrt{3})^{2}.\\end{aligned}\n$$\n\nThe radius is the positive square root of the right-hand side:\n\n$$\nr=\\sqrt{75}=\\sqrt{25\\cdot 3}=5 \\sqrt{3}.\n$$\n\nWe see that $a=- \\frac{3}{2},$ $b=\\frac{1}{2},$ and $r=5 \\sqrt{3}.$ \n\nTherefore, the circle is centered at $(- \\frac{3}{2},\\frac{1}{2})$ and its radius is $5 \\sqrt{3}.$"} {:db/id #edb/ref 17592186554941 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14bf130e-5183-5004-9744-fe22eba9aa52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(- \\frac{9}{2},\\frac{1}{3})$ and radius is $2 \\sqrt{3}$" :db/id #edb/ref 17592186554921} {:answer/id #uuid "5a3b6c09-e3df-5465-b189-6b05b4e444b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(- \\frac{9}{2},- \\frac{1}{3})$ and radius is $2 \\sqrt{3}$" :db/id #edb/ref 17592186554934} {:answer/id #uuid "5c664509-2dac-5ad9-95fa-1d73576ad5c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(- \\frac{9}{2},- \\frac{1}{3})$ and radius is $12$" :db/id #edb/ref 17592186554937} {:answer/id #uuid "c54cdb2d-ed97-56f8-bc85-c3ce69c7f983" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(\\frac{9}{2},- \\frac{1}{3})$ and radius is $2 \\sqrt{3}$" :db/id #edb/ref 17592186554968} {:answer/id #uuid "ec7cfa1e-3234-5e46-afc4-96a4b