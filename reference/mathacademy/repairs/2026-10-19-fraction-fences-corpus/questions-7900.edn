064b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-\\frac{23}{4})^{2}+(y+\\frac{23}{4})^{2}=\\frac{49}{9}" :db/id #edb/ref 17592186561491}] :answer-field/correct {:answer/id #uuid "21491fe1-52b1-5fa0-984a-ad99812f6f66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+\\frac{23}{4})^{2}+(y-\\frac{23}{4})^{2}=\\frac{49}{9}" :db/id #edb/ref 17592186561463} :answer-field/id #uuid "b569dcde-cf05-5b71-bc26-e9ed093d7995" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186561509}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b082143f-fddd-5417-b4df-aa176af1c158" :question/problem "![](images/89/89028234a6c156daa99692fe091bcbcb9eaefbe87ed34a4144eac333574763a1.png)\n\nWhat is the equation of the circle given above?" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nFrom the picture, we see that our circle is centered at $C(- \\frac{23}{4},\\frac{23}{4})$ and the radius of the circle is $r=\\frac{7}{3}.$ Therefore, the equation of the circle is\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x-(- \\frac{23}{4}))^{2}+(y-\\frac{23}{4})^{2} & =(\\frac{7}{3})^{2} \\\\ (x+\\frac{23}{4})^{2}+(y-\\frac{23}{4})^{2} & =\\frac{49}{9}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186561516 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ffa8ad3-16b7-5008-8c9d-488aa121797c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-1)^{2}+(y-5)^{2}=\\frac{81}{4}" :db/id #edb/ref 17592186561468} {:answer/id #uuid "4b812960-ff22-5b0d-bda0-c5fc0a7dcb1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-1)^{2}+(y-5)^{2}=\\frac{9}{2}" :db/id #edb/ref 17592186561475} {:answer/id #uuid "7123d6b4-e157-5c75-a9d2-c01edbc338af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+1)^{2}+(y+5)^{2}=\\frac{81}{4}" :db/id #edb/ref 17592186561485} {:answer/id #uuid "95fb5d52-26e1-547b-ad4a-bf700723fd65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+1)^{2}+(y-5)^{2}=\\frac{81}{4}" :db/id #edb/ref 17592186561502} {:answer/id #uuid "cda75105-984c-5302-8bdf-26bdc89b2bbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-1)^{2}+(y+5)^{2}=\\frac{81}{4}" :db/id #edb/ref 17592186561515}] :answer-field/correct {:answer/id #uuid "2ffa8ad3-16b7-5008-8c9d-488aa121797c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-1)^{2}+(y-5)^{2}=\\frac{81}{4}" :db/id #edb/ref 17592186561468} :answer-field/id #uuid "9228ed8d-daa2-585e-8fa3-73f0855cc2a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186561501}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d2beabf7-e8c8-507c-bb34-ceb969b62d91" :question/problem "![](images/0d/0de50141c687bd36fc592bfdaa0d755c8838da9a81c81188ebfc6b408320405b.png)\n\nWhat is the equation of the circle given above?" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nFrom the picture, we see that our circle is centered at $C(1,5)$ and the radius of the circle is $r=\\frac{9}{2}.$ Therefore, the equation of the circle is\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x-1)^{2}+(y-5)^{2} & =(\\frac{9}{2})^{2} \\\\ (x-1)^{2}+(y-5)^{2} & =\\frac{81}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186562433 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e7b951f-d98e-5a68-8472-6e057c0ab5a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186561628}] :answer-field/correct {:answer/id #uuid "0e7b951f-d98e-5a68-8472-6e057c0ab5a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186561628} :answer-field/id #uuid "32456fdc-62d9-5dbb-a411-ba3d281fd124" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186562252} {:answer-field/choices [{:answer/id #uuid "f672b119-050a-5608-9c83-4c9132443e95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186562194}] :answer-field/correct {:answer/id #uuid "f672b119-050a-5608-9c83-4c9132443e95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186562194} :answer-field/id #uuid "34f645a6-64ef-5792-b6c7-1a4f744bf319" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186562253} {:answer-field/choices [{:answer/id #uuid "e333e92e-a591-5e20-9ca0-01be53fe0055" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186562141}] :answer-field/correct {:answer/id #uuid "e333e92e-a591-5e20-9ca0-01be53fe0055" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186562141} :answer-field/id #uuid "ab8fbdbc-05a9-5707-ab78-71fcfbb42736" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186562332} {:answer-field/choices [{:answer/id #uuid "2725edec-e9e4-5fb5-993b-32b7e209acd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186561687}] :answer-field/correct {:answer/id #uuid "2725edec-e9e4-5fb5-993b-32b7e209acd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186561687} :answer-field/id #uuid "d0bee359-1a75-5e2f-8f5b-e36a4511f781" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186562354}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4de28170-b86e-539e-8022-1a0054f8d5b3" :question/math-academy-id "q-253260" :question/problem "Let ${J}_{n}(\\lambda )$ denote an $n\\times n$ Jordan block with $\\lambda $ on the main diagonal. Fill in the missing entries in the matrix below.\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\operatorname{sin}⁡(3{J}_{2}(\\frac{\\pi }{6}))=\\,\\,$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Given a function $f$ and a Jordan block ${J}_{n}(\\lambda ),$ we have\n\n$$\nf({J}_{n}(\\lambda ))=[\\begin{aligned}f(\\lambda ) & {f}^{′}(\\lambda ) & \\frac{{f}^{″}(\\lambda )}{2!} & ⋯ & \\frac{{f}^{(n-1)}(\\lambda )}{(n-1)!} \\\\ 0 & f(\\lambda ) & {f}^{′}(\\lambda ) & ⋯ & \\frac{{f}^{(n-2)}(\\lambda )}{(n-2)!} \\\\ ⋮ & ⋱ & ⋱ & ⋱ & ⋮ \\\\ 0 & ⋯ & 0 & f(\\lambda ) & {f}^{′}(\\lambda ) \\\\ 0 & ⋯ & ⋯ & 0 & f(\\lambda )\\end{aligned}].\n$$\n\nIn this case, we have $f(x)=\\operatorname{sin}⁡3x,$ $n=2,$ and $\\lambda =\\frac{\\pi }{6}.$\n\nSince $n=2,$ we need to compute the first $2-1=1$ derivative of $f:$\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{sin}⁡3x \\\\ {f}^{′}(x) & =3\\operatorname{cos}⁡3x\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f({J}_{2}(\\frac{\\pi }{6})) & =[\\begin{aligned}f(\\frac{\\pi }{6}) & {f}^{′}(\\frac{\\pi }{6}) \\\\ 0 & f(\\frac{\\pi }{6})\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{sin}⁡(\\frac{\\pi }{2}) & 3\\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\ 0 & \\operatorname{sin}⁡(\\frac{\\pi }{2})\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186562447 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7740ff6c-f994-55ad-a058-c084db22a725" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186561877}] :answer-field/correct {:answer/id #uuid "7740ff6c-f994-55ad-a058-c084db22a725" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186561877} :answer-field/id #uuid "ec63b2c8-7a90-5b2e-aad9-f70f82165d1c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186562373}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7987b888-d840-5cef-9095-39b390eecef3" :question/math-academy-id "q-300758" :question/problem "If $p(x)=-2{x}^{4}$ and $q(x)=-\\frac{8}{{x}^{6}},$ then\n\n${lim}_{x\\to \\infty }\\frac{p(x)}{q(x)}=$\n{{field-1}}." :question/worked-solution "First, we divide the two functions, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{p(x)}{q(x)} & ={lim}_{x\\to \\infty }\\frac{(-2{x}^{4})}{(-\\frac{8}{{x}^{6}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{{x}^{10}}{4} \\\\  & ={lim}_{x\\to \\infty }(\\frac{1}{4}\\cdot {x}^{10}) \\\\  & =\\frac{1}{4}\\cdot {lim}_{x\\to \\infty }{x}^{10}\\end{aligned}\n$$\n\nThe graph $y={x}^{10}$ looks similar to an upward parabola, so\n\n$$\n{lim}_{x\\to \\infty }{x}^{10}=\\infty .\n$$\n\nMultiplication by the positive constant $\\frac{1}{4}$ does not affect the limit at infinity So, we have\n\n$$\n\\begin{aligned}\\frac{1}{4}\\cdot {lim}_{x\\to \\infty }{x}^{10}={lim}_{x\\to \\infty }({x}^{10})=\\infty .\\end{aligned}\n$$"}]
