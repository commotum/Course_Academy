 sides of lengths $b$ and $c.$ \n\nHere\n\n$$\n\\begin{aligned}c & =AB=\\frac{22}{3}\\text{ cm} \\\\ b & =AC \\\\ m∠A & ={120}^{∘}.\\end{aligned}\n$$\n\nSince \n\n$$\n\\operatorname{sin}⁡{120}^{∘}=\\frac{\\sqrt{3}}{2},\n$$\n\nwe can calculate $b=AC,$ as follows:\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot b\\cdot c\\cdot \\operatorname{sin}⁡A \\\\ \\frac{121\\sqrt{3}}{18} & =\\frac{1}{2}\\cdot b\\cdot \\frac{22}{3}\\cdot \\operatorname{sin}⁡{120}^{∘} \\\\ \\frac{121\\sqrt{3}}{18} & =\\frac{1}{2}\\cdot b\\cdot \\frac{22}{3}\\cdot (\\frac{\\sqrt{3}}{2}) \\\\ \\frac{121\\sqrt{3}}{18} & =\\frac{11\\sqrt{3}}{6}b \\\\ b & =\\frac{\\frac{121\\sqrt{3}}{18}}{\\frac{11\\sqrt{3}}{6}} \\\\ b & =\\frac{11}{3}\\text{ cm}.\\end{aligned}\n$$\n\nWe conclude that $AC=\\frac{11}{3}\\,\\text{cm}.$"} {:db/id #edb/ref 17592186556396 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09a81808-f3a7-51b7-a275-f77c8ce4630c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{37}{4}" :db/id #edb/ref 17592186556354}] :answer-field/correct {:answer/id #uuid "09a81808-f3a7-51b7-a275-f77c8ce4630c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{37}{4}" :db/id #edb/ref 17592186556354} :answer-field/id #uuid "5da2ced1-509c-5f9a-a1eb-9a312a6150a3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186556368}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d3e9f084-c5c8-5e5d-a8cd-0b8a1cdc4b6a" :question/problem "![](images/3d/3dc502507d431d52979ff26a01089d61793a9487989d9203fd2f4f9246ecb1e3.png)\n\nThe area of the triangle $△ABC$ is $\\frac{111\\sqrt{2}}{32}\\,\\text{cm}^{2}.$ Then, $AC=${{field-1}} $\\text{cm}.$" :question/worked-solution "The formula for the area of the triangle is \n\n$$\nA=\\frac{1}{2}bc\\operatorname{sin}⁡A,\n$$\n\nwhere $∠A$ is between the sides of lengths $b$ and $c.$ \n\nHere\n\n$$\n\\begin{aligned}c & =AB=\\frac{3}{2}\\text{ cm} \\\\ b & =AC \\\\ m∠A & ={45}^{∘}.\\end{aligned}\n$$\n\nSince \n\n$$\n\\operatorname{sin}⁡{45}^{∘}=\\frac{\\sqrt{2}}{2},\n$$\n\nwe can calculate $b=AC,$ as follows:\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot b\\cdot c\\cdot \\operatorname{sin}⁡A \\\\ \\frac{111\\sqrt{2}}{32} & =\\frac{1}{2}\\cdot b\\cdot \\frac{3}{2}\\cdot \\operatorname{sin}⁡{45}^{∘} \\\\ \\frac{111\\sqrt{2}}{32} & =\\frac{1}{2}\\cdot b\\cdot \\frac{3}{2}\\cdot (\\frac{\\sqrt{2}}{2}) \\\\ \\frac{111\\sqrt{2}}{32} & =\\frac{3\\sqrt{2}}{8}b \\\\ b & =\\frac{\\frac{111\\sqrt{2}}{32}}{\\frac{3\\sqrt{2}}{8}} \\\\ b & =\\frac{37}{4}\\text{ cm}.\\end{aligned}\n$$\n\nWe conclude that $AC=\\frac{37}{4}\\,\\text{cm}.$"} {:db/id #edb/ref 17592186556400 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "189e4e81-e91b-541e-a713-a659dc893ccc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{3}\\,\\text{mm}" :db/id #edb/ref 17592186556357} {:answer/id #uuid "397621df-9258-5f5c-b429-ac0df048eae2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{17}\\,\\text{mm}" :db/id #edb/ref 17592186556361} {:answer/id #uuid "56329264-d12e-5e0e-a820-46d1266fc01d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}\\,\\text{mm}" :db/id #edb/ref 17592186556365} {:answer/id #uuid "9031717b-9f69-57af-8df6-781065968f5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1445}{27}\\,\\text{mm}" :db/id #edb/ref 17592186556377} {:answer/id #uuid "9197fd42-c5ad-5145-ad0f-670e27d991b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}\\,\\text{mm}" :db/id #edb/ref 17592186556378}] :answer-field/correct {:answer/id #uuid "56329264-d12e-5e0e-a820-46d1266fc01d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}\\,\\text{mm}" :db/id #edb/ref 17592186556365} :answer-field/id #uuid "e0c61827-39ef-5b85-8a67-6d3bc7f90cb7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186556397}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e783bc5b-9008-5bdd-9a47-991be242d917" :question/problem "![](images/77/7783777fcc75d7c12a8eaed0f703bc6a864e805fc8c814860a899e3737f71480.png)\n\nThe area of the triangle $△ABC$ is $\\frac{85\\sqrt{2}}{36}\\,\\text{mm}^{2}.$ Find $AC.$" :question/worked-solution "The formula for the area of the triangle is \n\n$$\nA=\\frac{1}{2}bc\\operatorname{sin}⁡A,\n$$\n\nwhere $∠A$ is between the sides of lengths $b$ and $c.$ \n\nHere\n\n$$\n\\begin{aligned}c & =AB=\\frac{17}{3}\\text{ mm} \\\\ b & =AC \\\\ m∠A & ={45}^{∘}.\\end{aligned}\n$$\n\nSince \n\n$$\n\\operatorname{sin}⁡{45}^{∘}=\\frac{\\sqrt{2}}{2},\n$$\n\nwe can calculate $b=AC,$ as follows:\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot b\\cdot c\\cdot \\operatorname{sin}⁡A \\\\ \\frac{85\\sqrt{2}}{36} & =\\frac{1}{2}\\cdot b\\cdot \\frac{17}{3}\\cdot \\operatorname{sin}⁡{45}^{∘} \\\\ \\frac{85\\sqrt{2}}{36} & =\\frac{1}{2}\\cdot b\\cdot \\frac{17}{3}\\cdot (\\frac{\\sqrt{2}}{2}) \\\\ \\frac{85\\sqrt{2}}{36} & =\\frac{17\\sqrt{2}}{12}b \\\\ b & =\\frac{\\frac{85\\sqrt{2}}{36}}{\\frac{17\\sqrt{2}}{12}} \\\\ b & =\\frac{5}{3}\\text{ mm}.\\end{aligned}\n$$\n\nWe conclude that $AC=\\frac{5}{3}\\,\\text{mm}.$"} {:db/id #edb/ref 17592186556401 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e808f9d-31be-5a13-9482-c882618b4d13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{7}\\,\\text{cm}" :db/id #edb/ref 17592186556363} {:answer/id #uuid "6464c1a3-5522-5202-84e1-c5893469dea5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,\\text{cm}" :db/id #edb/ref 17592186556369} {:answer/id #uuid "6eeeca4d-7e83-52c4-ab5b-afef0a041e6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{cm}" :db/id #edb/ref 17592186556370} {:answer/id #uuid "8f4a94f6-3016-5f60-9d0c-0d9b1512ddce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "245\\,\\text{cm}" :db/id #edb/ref 17592186556376} {:answer/id #uuid "bd849935-03e9-5534-b8df-54ec95c858b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}\\,\\text{cm}" :db/id #edb/ref 17592186556392}] :answer-field/correct {:answer/id #uuid "6eeeca4d-7e83-52c4-ab5b-afef0a041e6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{cm}" :db/id #edb/ref 17592186556370} :answer-field/id #uuid "b93faa7e-caa0-5f1e-8af9-0757c496ba0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186556387}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e802d20f-bb4d-5898-ad8c-4cb88bfe1ea8" :question/problem "![](images/6a/6a2da5468750823c21e259f6aa40a0c93342a2bebcc38a1292aa43686ca618fa.png)\n\nThe area of the triangle $△ABC$ is $\\frac{35}{4}\\,\\text{cm}^{2}.$ Use $\\sin30^{\\circ}=\\frac{1}{2}.$ Find $AC.$" :question/worked-solution "The formula for the area of the triangle is \n\n$$\nA=\\frac{1}{2}bc\\operatorname{sin}⁡A,\n$$\n\nwhere $∠A$ is between the sides of lengths $b$ and $c.$ \n\nHere\n\n$$\n\\begin{aligned}c & =AB=7\\text{ cm} \\\\ b & =AC \\\\ m∠A & ={30}^{∘}.\\end{aligned}\n$$\n\nSince \n\n$$\n\\operatorname{sin}⁡{30}^{∘}=\\frac{1}{2},\n$$\n\nwe can calculate $b=AC,$ as follows:\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot b\\cdot c\\cdot \\operatorname{sin}⁡A \\\\ \\frac{35}{4} & =\\frac{1}{2}\\cdot b\\cdot 7\\cdot \\operatorname{sin}⁡{30}^{∘} \\\\ \\frac{35}{4} & =\\frac{1}{2}\\cdot b\\cdot 7\\cdot (\\frac{1}{2}) \\\\ \\frac{35}{4} & =\\frac{7}{4}b \\\\ b & =\\frac{\\frac{35}{4}}{\\frac{7}{4}} \\\\ b & =5\\text{ cm}.\\end{aligned}\n$$\n\nWe conclude that $AC=5\\,\\text{cm}.$"} {:db/id #edb/ref 17592186557215 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a8b33db-e437-5653-925f-1fa9cfe52297" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11\\pi }{12}" :db/id #edb/ref 17592186556488} {:answer/id #uuid "6a4c00d2-5098-54c4-bfb3-fb1e4e39a687" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{10}" :db/id #edb/ref 17592186556678} {:answer/id #uuid "991cbc71-8163-5cad-9451-b64c49988e86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7\\pi }{12}" :db/id #edb/ref 17592186556798} {:answer/id #uuid "c1b5b62d-cb0a-5d58-aa38-44da5f8d23e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7\\pi }{30}" :db/id #edb/ref 17592186556898} {:answer/id #uuid "d3da23ec-8498-546a-b90f-b15aaef5d70d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17\\pi }{15}" :db/id #edb/ref 17592186556941}] :answer-field/correct {:answer/id #uuid "6a4c00d2-5098-54c4-bfb3-fb1e4e39a687" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{10}" :db/id #edb/ref 17592186556678} :answer-field/id #uuid "3b8240cb-eb83-5b67-93ee-5d39ead36d05" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557099}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1d2ad0a0-cc2c-5c3a-a170-bcfe4847272e" :question/math-academy-id "q-11480" :question/problem "Consider the finite region bounded by the curve $y={x}^{2}-{x}^{3}$ and the $x$-axis. Calculate the volume of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis." :question/worked-solution "First, we determine the points where the curve intersects the $x$-axis by solving the following equation for $x:$\n\n$$\n\\begin{aligned}{x}^{2}-{x}^{3} & =0 \\\\ {x}^{2}(1-x) & =0\\end{aligned}\n$$\n\nThe solutions are  $x=0$ and  $x=1.$ So, we need to integrate from $x=0$ to $x=1.$ \n\nUsing the shell method, the volume of the solid can be found as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x\\,f(x)\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{1}x({x}^{2}-{x}^{3})\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{1}({x}^{3}-{x}^{4})\\text{d}x \\\\  & ={2\\pi (\\frac{{x}^{4}}{4}\\text{ }-\\frac{{x}^{5}}{5})|}_{0}^{1} \\\\  & =2\\pi [(\\frac{1}{4}-\\frac{1}{5})-0] \\\\  & =2\\pi (\\frac{1}{20}) \\\\  & =\\frac{\\pi }{10}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186557217 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29951222-87d7-548a-9a5e-144857424fb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186556519} {:answer/id #uuid "46324b89-8e6d-58d2-acb1-a3d8251446db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186556585} {:answer/id #uuid "9ff11515-d97e-5995-80f0-2ad0af75b6ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186556820} {:answer/id #uuid "b92f6a22-272b-56d9-abd2-b059ce0496cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186556882} {:answer/id #uuid "e276d83b-7cf3-5d6b-86cd-b9f78e932f09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186556990}] :answer-field/correct {:answer/id #uuid "9ff11515-d97e-5995-80f0-2ad0af75b6ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186556820} :answer-field/id #uuid "50488e0d-3249-550c-8d98-bec9f2011aab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557111}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "228ddf28-6449-527a-a0f3-502e03cb4eba" :question/math-academy-id "q-18525" :question/problem "![](images/f9/f9738ccf12d8b9e8f3ed84870371972767e67a624f31fe5782f39679253965c4.png)\n\nThe graph above shows $y=k{(\\frac{1}{3})}^{x}.$ What is the value of $k?$" :question/worked-solution "To plot the graph of $y=k{(\\frac{1}{3})}^{x},$ we take the graph of $y={(\\frac{1}{3})}^{x}$ and stretch it vertically by a scale factor of  $k.$ Under the action of this transformation, the $y$-intercept is mapped from $(0,1)$ to $(0,k).$\n\nComparing the point $(0,4)$ on the graph to $(0,k),$ we see that we must have $k=4.$"} {:db/id #edb/ref 17592186557222 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50ba80ef-f04e-50df-b6d3-a54349425c28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbola with semiaxes $5$ and $4$" :db/id #edb/ref 17592186556614} {:answer/id #uuid "99191248-3fa5-597a-8b54-a603b1f3f7cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipse with semiaxes $\\frac{1}{5}$ and $\\frac{1}{\\sqrt{2}}$" :db/id #edb/ref 17592186556797} {:answer/id #uuid "a1e84b15-e7c8-5fd4-aa6e-1f803de91be4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A single point" :db/id #edb/ref 17592186556826} {:answer/id #uuid "da3da08e-ab18-5b95-a7d3-b32ef06eaf72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A parabola" :db/id #edb/ref 17592186556972} {:answer/id #uuid "dc4ed344-c362-572c-a34e-eb57da043aa3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbola with semiaxes $2$ and $\\frac{1}{2}$" :db/id #edb/ref 17592186556977}] :answer-field/correct {:answer/id #uuid "a1e84b15-e7c8-5fd4-aa6e-1f803de91be4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A single point" :db/id #edb/ref 17592186556826} :answer-field/id #uuid "2872dfa0-d71b-51c3-93f9-e6e87fc08e6e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557091}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "27762923-ddbc-55ca-b261-ca5c61feb064" :question/math-academy-id "q-95396" :question/problem "Consider the change of variables given by the matrix equation\n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}],\n$$\n\nand the curve $C,$ defined as\n\n$$\nC:\\,24{x}_{1}^{2}+4{x}_{1}{x}_{2}+21{x}_{2}^{2}-\\sqrt{5}{x}_{1}+2\\sqrt{5}{x}_{2}=-\\frac{5}{16}.\n$$\n\n \n\nGiven that the change of variables above reduces $Q(x)=24{x}_{1}^{2}+4{x}_{1}{x}_{2}+21{x}_{2}^{2}$ to its canonical (diagonal) form $25{y}_{1}^{2}+20{y}_{2}^{2},$ what type of a quadratic curve is defined by $C?$" :question/worked-solution "First, we note the following:\n\n$$\nC:\\,\\underbrace{24{x}_{1}^{2}+4{x}_{1}{x}_{2}+21{x}_{2}^{2}}_{Q(x)}-\\sqrt{5}{x}_{1}+2\\sqrt{5}{x}_{2}=-\\frac{5}{16}\n$$\n\nLet's write the given change of variables explicitly:\n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]\\,⟹\\,\\{\\begin{aligned}{x}_{1}=\\frac{2}{\\sqrt{5}}{y}_{1}-\\frac{1}{\\sqrt{5}}{y}_{2} \\\\ {x}_{2}=\\frac{1}{\\sqrt{5}}{y}_{1}+\\frac{2}{\\sqrt{5}}{y}_{2},\\end{aligned}\n$$\n\nWe know that the given change of variables reduces $Q(x)$ to its canonical form. Therefore, performing the change of variables on $C,$ we obtain\n\n$$\n\\begin{aligned}24{x}_{1}^{2}+4{x}_{1}{x}_{2}+21{x}_{2}^{2}-\\sqrt{5}{x}_{1}+2\\sqrt{5}{x}_{2} & =-\\frac{5}{16} \\\\ 25{y}_{1}^{2}+20{y}_{2}^{2}-\\sqrt{5}(\\frac{2}{\\sqrt{5}}{y}_{1}-\\frac{1}{\\sqrt{5}}{y}_{2})+2\\sqrt{5}(\\frac{1}{\\sqrt{5}}{y}_{1}+\\frac{2}{\\sqrt{5}}{y}_{2}) & =-\\frac{5}{16} \\\\ 25{y}_{1}^{2}+20{y}_{2}^{2}+5{y}_{2} & =-\\frac{5}{16} \\\\ 5{y}_{1}^{2}+4{y}_{2}^{2}+{y}_{2} & =-\\frac{1}{16}\\end{aligned}\n$$\n\nNow, we complete the square for the variable ${y}_{2}:$\n\n$$\n\\begin{aligned}5{y}_{1}^{2}+4{y}_{2}^{2}+{y}_{2} & =-\\frac{1}{16} \\\\ 5{y}_{1}^{2}+4({y}_{2}^{2}+\\frac{1}{4}{y}_{2}) & =-\\frac{1}{16} \\\\ 5{y}_{1}^{2}+4({y}_{2}^{2}+\\frac{1}{4}{y}_{2}+\\frac{1}{64}-\\frac{1}{64}) & =-\\frac{1}{16} \\\\ 5{y}_{1}^{2}+4({y}_{2}^{2}+\\frac{1}{4}{y}_{2}+\\frac{1}{64})-\\frac{4}{64} & =-\\frac{1}{16} \\\\ 5{y}_{1}^{2}+4({y}_{2}+\\frac{1}{8})^{2}-\\frac{1}{16} & =-\\frac{1}{16} \\\\ 5{y}_{1}^{2}+4({y}_{2}+\\frac{1}{8})^{2} & =0\\end{aligned}\n$$\n\nFinally, performing the change of variables\n\n$$\n\\{\\begin{aligned}{z}_{1}={y}_{1}, \\\\ {z}_{2}={y}_{2}+\\frac{1}{8},\\end{aligned}\n$$\n\nwe get the following:\n\n$$\n\\begin{aligned}5{z}_{1}^{2}+4{z}_{2}^{2} & =0 \\\\ \\frac{{z}_{1}^{2}}{\\frac{1}{5}}+\\frac{{z}_{2}^{2}}{\\frac{1}{4}} & =0 \\\\ \\frac{{z}_{1}^{2}}{(\\frac{1}{\\sqrt{5}})^{2}}+\\frac{{z}_{2}^{2}}{(\\frac{1}{2})^{2}} & =0\\end{aligned}\n$$\n\n \n\nA sum of squares is equal to zero if and only if each summand is zero, so the given quadratic equation represents a single point."} {:db/id #edb/ref 17592186557230 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5126c3d8-978f-582d-85b3-1b273093c176" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡y\\sqrt{1+{sin}^{2}⁡y}\\,\\text{d}y" :db/id #edb/ref 17592186556615} {:answer/id #uuid "8ba1a2b2-1160-53df-9d34-b83861b916c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡y\\sqrt{1+{cos}^{2}⁡y}\\,\\text{d}y" :db/id #edb/ref 17592186556764} {:answer/id #uuid "b59b2a2c-fb0b-5db0-9b18-977f28ffedf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{\\pi /3}y\\sqrt{1+{sec}^{2}⁡y}\\,\\text{d}y" :db/id #edb/ref 17592186556874} {:answer/id #uuid "d151476d-b4bb-5405-af19-fe054e71c98a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{\\pi /3}y\\sqrt{1+{cos}^{2}⁡y}\\,\\text{d}y" :db/id #edb/ref 17592186556935} {:answer/id #uuid "d70bd935-3591-5e22-b322-ce29e2d33415" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{\\pi /3}y\\sqrt{1+{sin}^{2}⁡y}\\,\\text{d}y" :db/id #edb/ref 17592186556957}] :answer-field/correct {:answer/id #uuid "d151476d-b4bb-5405-af19-fe054e71c98a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{\\pi /3}y\\sqrt{1+{cos}^{2}⁡y}\\,\\text{d}y" :db/id #edb/ref 17592186556935} :answer-field/id #uuid "64fdecf4-7be9-5050-b772-01b00e36fa6a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557125}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "325cb3ef-db56-5f90-98ae-212e45702d0f" :question/math-academy-id "q-109145" :question/problem "Consider the arc of the curve $x=\\operatorname{sin}⁡y$ that lies between $y=0$ and $y=\\frac{\\pi }{3}.$ What integral gives the surface area generated when this arc is rotated $2\\pi $ radians about the $x$-axis?" :question/worked-solution "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $x$-axis using the formula\n\n$$\nS=\\int 2\\pi y\\,\\text{d}s.\n$$\n\nSince we're given a curve in the form $x=f(y),$ we have \n\n$$\n\\text{d}s=\\sqrt{1+{(\\frac{\\text{d}x}{\\text{d}y})}^{2}}\\,\\text{d}y.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{y}_{1}}^{{y}_{2}}y\\sqrt{1+{(\\frac{\\text{d}x}{\\text{d}y})}^{2}}\\,\\text{d}y.\n$$\n\nWe are told that the limits of integration are from ${y}_{1}=0$ to ${y}_{2}=\\frac{\\pi }{3}.$ \n\nComputing the derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(\\operatorname{sin}⁡y)=\\operatorname{cos}⁡y.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{y}_{1}}^{{y}_{2}}y\\sqrt{1+{(\\frac{\\text{d}x}{\\text{d}y})}^{2}}\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{\\pi /3}y\\sqrt{1+{cos}^{2}⁡y}\\,\\text{d}y.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186557244 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19c4c61c-51ad-50d2-aac0-fb3d0ca8ba37" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/37/374572e9b9313502b6d806d37b095320496dc65d4e6383ea509b3ec30bc1aa85.png" :db/id #edb/ref 17592186556485} {:answer/id #uuid "1bb02bbf-e4db-51d2-820e-c820cd6c3132" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a3/a31cc9740f5db8ae825021de611c67b8114c3a5bffb13aca95b973b3718e8bd5.png" :db/id #edb/ref 17592186556493} {:answer/id #uuid "2307cbd4-8b2c-507e-9d61-ab458dea3b70" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bf/bfe6c167ff292ffd0b84926308734dc23888de3ba3cda5018d2c8fd24ec3436e.png" :db/id #edb/ref 17592186556509} {:answer/id #uuid "cbaf05ab-28d2-5ec9-bcfe-eb752c46cfe4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/76/76d3aa6e8e8dd2ccdad2784f664ba915efceef5573e71a389ab72f1e36aba106.png" :db/id #edb/ref 17592186556919} {:answer/id #uuid "d5cc661e-81a0-5227-89bf-6972cafbeab5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/da/dad79e84e25ce963588ee32b0da65a21c2fd70faad464b2ec2d3ce1a09c60ed9.png" :db/id #edb/ref 17592186556949}] :answer-field/correct {:answer/id #uuid "19c4c61c-51ad-50d2-aac0-fb3d0ca8ba37" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/37/374572e9b9313502b6d806d37b095320496dc65d4e6383ea509b3ec30bc1aa85.png" :db/id #edb/ref 17592186556485} :answer-field/id #uuid "e4b796fd-2386-5360-a29c-d6f97f457e1b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557193}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "487e5162-7f53-555d-bd23-288509fce232" :question/math-academy-id "q-27526" :question/problem "Which of the following is the graph of $y=\\frac{1}{2}{(\\frac{1}{8})}^{x}?$" :question/worked-solution "First we plot the graph of $y={(\\frac{1}{8})}^{x}:$\n\n![](images/f5/f5d15cae5283eb02d555bee57f399dd00c58ec319413ca5817b1edba1ac69fb9.png)\n\nThen, we scale this graph by a factor of $\\frac{1}{2}.$ The $y$-intercept becomes $(0,\\frac{1}{2}),$ and the resulting graph is as follows:\n\n![](images/1b/1b8e997035826ffcb6969c5bbdda46e256234fb5720f45aa281719be631929d4.png)"} {:db/id #edb/ref 17592186557247 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a55d4c8-ba65-5de7-84a2-4ee94b361461" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186556487} {:answer/id #uuid "6294613e-6b1e-58a0-a797-a8bc314e0e5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186556655} {:answer/id #uuid "82e69121-ee24-55ee-be9b-a4fee20e1b36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186556734} {:answer/id #uuid "92f08831-eeff-53f3-8e72-199165e34fe2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{2}" :db/id #edb/ref 17592186556784} {:answer/id #uuid "b6059bbc-7cd6-5c6e-a838-7b79406bffd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186556879}] :answer-field/correct {:answer/id #uuid "b6059bbc-7cd6-5c6e-a838-7b79406bffd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186556879} :answer-field/id #uuid "44515a13-3042-5dad-a7e1-fc7dbbca7de6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557102}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4c02183d-b4b3-51bb-97f0-443673f54a1a" :question/math-academy-id "q-32571" :question/problem "Given that\n$A=[\\begin{aligned}1 & 5 & -7 \\\\ 0 & 2 & -4 \\\\ 0 & -3 & 5\\end{aligned}]$\nhas the LU decomposition $A=LU,$ then ${l}_{32}\\cdot {u}_{33}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 5 & -7 \\\\ 0 & 2 & -4 \\\\ 0 & -3 & 5\\end{aligned}] & {R}_{3} & :={R}_{3}+(\\frac{3}{2}){R}_{2} & ⟺ & \\,\\overbrace{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & \\frac{3}{2} & 1\\end{aligned}]}^{{E}_{1}}\\cdot A \\\\  & ∼[\\begin{aligned}1 & 5 & -7 \\\\ 0 & 2 & -4 \\\\ 0 & 0 & -1\\end{aligned}] \\\\  & =U.\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & \\frac{3}{2} & 1\\end{aligned}]}^{-1}U \\\\ A & =\\underbrace{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -\\frac{3}{2} & 1\\end{aligned}]}_{L}\\underbrace{[\\begin{aligned}1 & 5 & -7 \\\\ 0 & 2 & -4 \\\\ 0 & 0 & -1\\end{aligned}].}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{32}=-\\frac{3}{2},{u}_{33}=-1,$ and ${l}_{32}\\cdot {u}_{33}=\\frac{3}{2}.$"} {:db/id #edb/ref 17592186557249 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00c374ab-6913-5cd0-a99e-c528c2de09a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.595,\\,0.212,\\,1.146" :db/id #edb/ref 17592186556428} {:answer/id #uuid "5992f636-bbef-5d92-8070-1748eaa01d5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1.093,\\,-0.442,\\,0.856" :db/id #edb/ref 17592186556635} {:answer/id #uuid "68357845-bce6-554e-84b7-a271aaeb70aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.372,\\,1.804,\\,2.765" :db/id #edb/ref 17592186556675} {:answer/id #uuid "db138c8d-b21c-5164-89b9-248159a62bb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2.156,\\,-1.045,\\,-0.504" :db/id #edb/ref 17592186556975} {:answer/id #uuid "dd78e176-69d9-5cad-a0f6-feffa2678056" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.431,\\,1.984,\\,2.598" :db/id #edb/ref 17592186556980}] :answer-field/correct {:answer/id #uuid "00c374ab-6913-5cd0-a99e-c528c2de09a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.595,\\,0.212,\\,1.146" :db/id #edb/ref 17592186556428} :answer-field/id #uuid "b9cabec7-d001-59f7-b4e5-a424a8d1286e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557168}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4e37507d-c5f2-5123-ae55-8166bf59d6ea" :question/math-academy-id "q-147601" :question/problem "Suppose the following random sample was drawn from the uniform distribution $U[0,1].$ \n\n$$\n0.321,\\,0.567,\\,0.804\n$$\n\nUse these numbers to generate three random numbers that follow a probability distribution with the CDF $F(x),$ given by\n\n$$\nF(x)=\\frac{2}{\\pi }\\operatorname{arctan}⁡({e}^{x}),\\,x\\in (-\\infty ,\\infty ).\n$$\n\nRound your answers to $3$ decimal places." :question/worked-solution "Let the random variable $Y∼U[0,1]$ be uniformly distributed. Suppose that the function $F(x)$ is a cumulative distribution function, where $F(a)=0,F(b)=1,$ and $F$ is strictly monotonic on $a<x<b.$ Then, the random variable $X,$ given by\n\n$$\nX={F}^{-1}(Y)\n$$\n\nis a continuous random variable with the cumulative distribution function $F(x).$\n\nSo, we need to find the inverse of $y=F(x).$ To do this, we solve the following equation for $x,$ taking into account that $0\\le y\\le 1:$\n\n$$\n\\begin{aligned}y & =\\frac{2}{\\pi }\\operatorname{arctan}⁡({e}^{x}) \\\\ \\frac{y\\pi }{2} & =\\operatorname{arctan}⁡({e}^{x}) \\\\ {e}^{x} & =\\operatorname{tan}⁡(\\frac{y\\pi }{2}) \\\\ x & =\\operatorname{ln}⁡(\\operatorname{tan}⁡(\\frac{y\\pi }{2}))\\end{aligned}\n$$\n\nNow, we substitute the numbers drawn from $U[0,1]$ into the above equation:\n\n- For $y=0.321,$ we get $x=\\operatorname{ln}⁡(\\operatorname{tan}⁡(\\frac{0.321\\pi }{2}))≈-0.595$\n\n- For $y=0.567,$ we get $x=\\operatorname{ln}⁡(\\operatorname{tan}⁡(\\frac{0.567\\pi }{2}))≈0.212$\n\n- For $y=0.804,$ we get $x=\\operatorname{ln}⁡(\\operatorname{tan}⁡(\\frac{0.804\\pi }{2}))≈1.146$"} {:db/id #edb/ref 17592186557256 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16a51d10-6bf8-56cf-a684-b246769cc4f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi}{162}" :db/id #edb/ref 17592186556476}] :answer-field/correct {:answer/id #uuid "16a51d10-6bf8-56cf-a684-b246769cc4f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi}{162}" :db/id #edb/ref 17592186556476} :answer-field/id #uuid "3835d0c7-1e03-5584-bbd2-249f76f9390e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186557098}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "64dd5dee-1a80-5aec-aff5-ee2daf8b8dbf" :question/math-academy-id "q-352256" :question/problem "Consider the finite region bounded by the curve $y=x-3{x}^{2}$ and the $x$-axis. Calculate the volume $V$ of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis. Do not round the answer.\n\n$V=$\n{{field-1}}" :question/worked-solution "First, we determine the points where the curve intersects the $x$-axis by solving the following equation for $x:$\n\n$$\n\\begin{aligned}x-3{x}^{2} & =0 \\\\ x(1-3x) & =0\\end{aligned}\n$$\n\nThe solutions are $x=0$ and $x=\\frac{1}{3}.$ So, we need to integrate from $x=0$ to $x=\\frac{1}{3}.$  \n\nUsing the shell method, the volume of the solid can be found as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x\\,f(x)\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{1/3}x(x-3{x}^{2})\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{1/3}({x}^{2}-3{x}^{3})\\text{d}x \\\\  & =2\\pi {(\\frac{{x}^{3}}{3}-\\frac{3{x}^{4}}{4})|}_{0}^{1/3} \\\\  & =2\\pi [(\\frac{1}{3\\cdot {3}^{3}}-\\frac{3}{4\\cdot {3}^{4}})-0] \\\\  & =2\\pi (\\frac{1}{324}) \\\\  & =\\frac{\\pi }{162}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186557259 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49385517-eeac-5b31-adab-df094762881b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186556593} {:answer/id #uuid "604e0e8a-a825-50c3-a298-9ae13e709a27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186556648} {:answer/id #uuid "9404be8d-cb6c-53b2-8a36-eb362e775360" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186556786} {:answer/id #uuid "95cb350d-4388-53ea-9992-f43b19639582" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186556791} {:answer/id #uuid "9b3dc5f8-2374-5afe-8f07-96ed5f7a5da8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186556807}] :answer-field/correct {:answer/id #uuid "49385517-eeac-5b31-adab-df094762881b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186556593} :answer-field/id #uuid "add9725c-6d77-5248-a0ae-02fe439fa683" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557163}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "67f07fb8-cc06-5cda-9a1f-cc029f68242d" :question/math-academy-id "q-107288" :question/problem "Find the slope of the tangent to the curve $y=\\sqrt{2x+1}$ at the point where $x=4.$" :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nWe use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=2x+1.$ Then $y=\\sqrt{u}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2\\sqrt{u}}\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot 2 \\\\  & =\\frac{1}{\\sqrt{2x+1}}.\\end{aligned}\n$$\n\nFinally, substituting $x=4,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=4} & ={(\\frac{1}{\\sqrt{2x+1}})|}_{x=4} \\\\  & =\\frac{1}{\\sqrt{2(4)+1}} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186557274 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07fc5f99-a190-51ee-a465-407870427a03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186556446} {:answer/id #uuid "0d85cf57-8864-563b-ae5e-647e27df0d77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186556456} {:answer/id #uuid "32d134c8-4a8d-5f2b-af8c-f2e3bee5e218" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186556538} {:answer/id #uuid "92901f09-a91d-52b4-9ebd-c14bdcccca1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186556783} {:answer/id #uuid "e2e66db7-a715-5d0c-bf46-a2f73cc9a7b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186556991}] :answer-field/correct {:answer/id #uuid "e2e66db7-a715-5d0c-bf46-a2f73cc9a7b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186556991} :answer-field/id #uuid "e543d592-57e7-5835-bf9e-672426221161" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557194}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7b028485-bf8e-559e-a7ed-a6b72baad9fb" :question/math-academy-id "q-73407" :question/problem "Given that a geometric sequence has \n${a}_{1}=896$, ${a}_{4}=112$ and ${a}_{k}=14$, what is the value of $k?$" :question/worked-solution "First, we need to find the common ratio. We are told that ${a}_{1}=896$ and ${a}_{4}=112,$ so we can find the common ratio using a formula, as follows:\n\n$$\n\\begin{aligned}{r}^{n-m} & =\\frac{{a}_{n}}{{a}_{m}} \\\\ {r}^{4-1} & =\\frac{{a}_{4}}{{a}_{1}} \\\\ {r}^{4-1} & =\\frac{112}{896} \\\\ {r}^{3} & =\\frac{1}{8} \\\\ {r}^{3} & ={(\\frac{1}{2})}^{3} \\\\ r & =\\frac{1}{2}\\end{aligned}\n$$\n\nNow that we know the common ratio is $r=\\frac{1}{2}$, we can use the same formula to solve for the value of $k$ such that ${a}_{k}=14:$\n\n$$\n\\begin{aligned}{r}^{n-m} & =\\frac{{a}_{n}}{{a}_{m}} \\\\ {r}^{k-4} & =\\frac{{a}_{k}}{{a}_{4}} \\\\ {(\\frac{1}{2})}^{k-4} & =\\frac{14}{112} \\\\ {(\\frac{1}{2})}^{k-4} & =\\frac{1}{8} \\\\ {(\\frac{1}{2})}^{k-4} & ={(\\frac{1}{2})}^{3} \\\\ k-4 & =3 \\\\ k & =7\\end{aligned}\n$$"} {:db/id #edb/ref 17592186557283 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1274a3e1-55b9-552d-b003-12310c1f94da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{1}{5} & 1 & 0 \\\\ 0 & -\\frac{3}{2} & 1\\end{aligned}]" :db/id #edb/ref 17592186556469} {:answer/id #uuid "420e7c72-67c3-54bb-8ebc-2aa8890493a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{1}{5} & 1 & 0 \\\\ 0 & \\frac{3}{2} & 1\\end{aligned}]" :db/id #edb/ref 17592186556577} {:answer/id #uuid "65290f11-7840-570f-a534-0fa4fca0ae31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{1}{5} & 1 & 0 \\\\ 0 & -\\frac{3}{2} & 1\\end{aligned}]" :db/id #edb/ref 17592186556664} {:answer/id #uuid "7f46a36f-9fe5-5805-871e-6936924e326a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{1}{5} & 1 & 0 \\\\ 0 & \\frac{3}{2} & 1\\end{aligned}]" :db/id #edb/ref 17592186556722} {:answer/id #uuid "c548e49e-a7cd-5be9-b97c-4c57df80a6e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{1}{5} & 1 & 0 \\\\ 0 & -\\frac{1}{2} & 1\\end{aligned}]" :db/id #edb/ref 17592186556905}] :answer-field/correct {:answer/id #uuid "65290f11-7840-570f-a534-0fa4fca0ae31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{1}{5} & 1 & 0 \\\\ 0 & -\\frac{3}{2} & 1\\end{aligned}]" :db/id #edb/ref 17592186556664} :answer-field/id #uuid "9220e030-d050-59e1-aeee-1e7f3bb39fe6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557150}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9735b81a-0c65-5842-9564-1b88b92db55e" :question/math-academy-id "q-32723" :question/problem "Given that\n$M=[\\begin{aligned}5 & 10 & 0 \\\\ 1 & 0 & -2 \\\\ 0 & 3 & -3\\end{aligned}]$\nhas the LU decomposition $M=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $M$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $M$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}5 & 10 & 0 \\\\ 1 & 0 & -2 \\\\ 0 & 3 & -3\\end{aligned}] & {R}_{2} & :={R}_{2}+(-\\frac{1}{5}){R}_{1} & ⟺ & \\,\\overbrace{[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{1}{5} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{{E}_{1}}\\cdot M \\\\  & ∼[\\begin{aligned}5 & 10 & 0 \\\\ 0 & -2 & -2 \\\\ 0 & 3 & -3\\end{aligned}] & {R}_{3} & :={R}_{3}+(\\frac{3}{2}){R}_{2} & ⟺ & \\,\\overbrace{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & \\frac{3}{2} & 1\\end{aligned}]}^{{E}_{2}}\\cdot {E}_{1}\\cdot M \\\\  & ∼[\\begin{aligned}5 & 10 & 0 \\\\ 0 & -2 & -2 \\\\ 0 & 0 & -6\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}M=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}M & =U \\\\ {E}_{1}M & ={E}_{2}^{-1}U \\\\ M & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ M & ={[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{1}{5} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & \\frac{3}{2} & 1\\end{aligned}]}^{-1}U \\\\ M & =([\\begin{aligned}1 & 0 & 0 \\\\ \\frac{1}{5} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -\\frac{3}{2} & 1\\end{aligned}])U \\\\ M & =\\underbrace{[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{1}{5} & 1 & 0 \\\\ 0 & -\\frac{3}{2} & 1\\end{aligned}]}_{L}\\underbrace{[\\begin{aligned}5 & 10 & 0 \\\\ 0 & -2 & -2 \\\\ 0 & 0 & -6\\end{aligned}]}_{U}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186557303 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cd9eaf3-ed30-5541-af86-8a86b83910ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0$ and $\\frac{1}{7}$" :db/id #edb/ref 17592186556496} {:answer/id #uuid "2e59e379-49a8-54d1-a572-f41f95712c03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)$ has no roots" :db/id #edb/ref 17592186556529} {:answer/id #uuid "6e2ccad8-734d-582e-b7c7-0ed5544f1b87" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{1}{7}$ and $\\frac{1}{3}$" :db/id #edb/ref 17592186556683} {:answer/id #uuid "8790a791-e8bb-5896-87ed-e82e9ab0674d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186556749} {:answer/id #uuid "956e4771-73f0-5b6f-980d-af1813caa099" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-4$ and $-\\frac{1}{9}$" :db/id #edb/ref 17592186556789}] :answer-field/correct {:answer/id #uuid "8790a791-e8bb-5896-87ed-e82e9ab0674d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186556749} :answer-field/id #uuid "e84544a2-76c0-5219-9d3a-4068e68e816b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557195}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c306bf08-706c-5a8c-b907-b249d9ec68eb" :question/math-academy-id "q-37888" :question/problem "![](images/ef/ef42744182deb0d83704b13fba2324b92df197151c3566de01bb75a202e836cc.png)\n\nWhat are the roots of the function $f(x)$ defined by the mapping diagram shown above?" :question/worked-solution "The roots of the function are the values of $x$ such that $f(x)=0.$ In the given mapping diagram, we see that $f(\\frac{1}{3})=0.$\n\nTherefore, the only root of the function is $x=\\frac{1}{3}.$"} {:db/id #edb/ref 17592186557311 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e914b0d-41ca-50e1-920b-daa562691bf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\pi " :db/id #edb/ref 17592186556570} {:answer/id #uuid "772b2fe0-64e6-5c8e-a51d-7d63a2be61f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186556701} {:answer/id #uuid "bacbe449-5ccd-5971-8f8e-92d50f996dba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\pi " :db/id #edb/ref 17592186556886} {:answer/id #uuid "d807f0fc-fb4a-570e-8af5-96a9583d0e92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi " :db/id #edb/ref 17592186556964} {:answer/id #uuid "f181cf37-c4e6-5144-a534-9ebcde59a058" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186557025}] :answer-field/correct {:answer/id #uuid "bacbe449-5ccd-5971-8f8e-92d50f996dba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\pi " :db/id #edb/ref 17592186556886} :answer-field/id #uuid "54638d73-c9f4-5d31-93a7-16d80e13c507" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557113}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cbe7ea72-e04a-55e6-a4f7-365b15606888" :question/math-academy-id "q-109257" :question/problem "Consider the arc of the curve $y=\\sqrt{4-{x}^{2}}$ that lies between the lines $x=-1$ and $x=1.$ Calculate the surface area generated when this arc is rotated $2\\pi $ radians about the $x$-axis." :question/worked-solution "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $x$-axis using the formula\n\n$$\nS=\\int 2\\pi y\\,\\text{d}s.\n$$\n\nSince we're given a curve in the form $y=f(x),$ we have \n\n$$\n\\text{d}s=\\sqrt{1+{(\\frac{\\text{d}y}{\\text{d}x})}^{2}}\\,\\text{d}x.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{x}_{1}}^{{x}_{2}}y\\sqrt{1+{(\\frac{\\text{d}y}{\\text{d}x})}^{2}}\\,\\text{d}x.\n$$\n\nWe are told that the limits of integration are from ${x}_{1}=-1$ to ${x}_{2}=1.$ \n\nComputing the derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{4-{x}^{2}})=-\\frac{x}{\\sqrt{4-{x}^{2}}}\\,⇒\\,{(\\frac{\\text{d}y}{\\text{d}x})}^{2}=\\frac{{x}^{2}}{4-{x}^{2}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{x}_{1}}^{{x}_{2}}y\\sqrt{1+{(\\frac{\\text{d}y}{\\text{d}x})}^{2}}\\,\\text{d}x \\\\  & =2\\pi {\\int }_{-1}^{1}\\sqrt{4-{x}^{2}}\\sqrt{1+\\frac{{x}^{2}}{4-{x}^{2}}}\\,\\text{d}x \\\\  & =2\\pi {\\int }_{-1}^{1}\\sqrt{4-{x}^{2}}\\sqrt{\\frac{4}{4-{x}^{2}}}\\,\\text{d}x \\\\  & =2\\pi {\\int }_{-1}^{1}2\\,\\text{d}x \\\\  & =4\\pi x\\,{|}_{-1}^{1} \\\\  & =4\\pi [1-(-1)] \\\\  & =8\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186557313 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b81fbca-a77f-5477-8743-e223ca70c61d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.164,\\,0.915,\\,2.717" :db/id #edb/ref 17592186556522} {:answer/id #uuid "508e3d35-7d7b-5100-b5d1-8da0c88726c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3.983,\\,-2.021,\\,-1.673" :db/id #edb/ref 17592186556613} {:answer/id #uuid "88e93c2b-5a1b-5de7-a0d7-7a2abc878221" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.105,\\,0.876,\\,1.392" :db/id #edb/ref 17592186556752} {:answer/id #uuid "c18dea57-6ee4-588f-8bb8-36b1138d9007" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2.203,\\,-1.754,\\,0.650" :db/id #edb/ref 17592186556896} {:answer/id #uuid "d9721a66-9348-50b8-a97b-da234d7ecc8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.802,\\,-0.456,\\,1.034" :db/id #edb/ref 17592186556968}] :answer-field/correct {:answer/id #uuid "2b81fbca-a77f-5477-8743-e223ca70c61d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.164,\\,0.915,\\,2.717" :db/id #edb/ref 17592186556522} :answer-field/id #uuid "5b52405c-a88b-5363-9895-3267fa25f577" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557117}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d55d9f6d-31b7-5824-bc8b-1fe8f38e31d7" :question/math-academy-id "q-147600" :question/problem "Suppose the following random sample was drawn from the uniform distribution $U[0,1].$ \n\n$$\n0.459,\\,0.714,\\,0.938\n$$\n\nUse these numbers to generate three random numbers that follow a probability distribution with the CDF $F(x),$ given by\n\n$$\nF(x)=\\frac{1}{1+{e}^{-x}},\\,x\\in (-\\infty ,\\infty ).\n$$\n\nRound your answers to $3$ decimal places." :question/worked-solution "Let the random variable $Y∼U[0,1]$ be uniformly distributed. Suppose that the function $F(x)$ is a cumulative distribution function, where $F(a)=0,F(b)=1,$ and $F$ is strictly monotonic on $a<x<b.$ Then, the random variable $X,$ given by\n\n$$\nX={F}^{-1}(Y)\n$$\n\nis a continuous random variable with the cumulative distribution function $F(x).$\n\nSo, we need to find the inverse of $y=F(x).$ To do this, we solve for the following equation for $x,$ taking into account that $0\\le y\\le 1:$\n\n$$\n\\begin{aligned}y & =\\frac{1}{1+{e}^{-x}} \\\\ 1+{e}^{-x} & =\\frac{1}{y} \\\\ {e}^{-x} & =\\frac{1-y}{y} \\\\ -x & =\\operatorname{ln}⁡(\\frac{1-y}{y}) \\\\ x & =-\\operatorname{ln}⁡(\\frac{1-y}{y})\\end{aligned}\n$$\n\nNow, we substitute the numbers drawn from $U[0,1]$ into the above equation:\n\n- For $y=0.459,$ we get $x=-\\operatorname{ln}⁡(\\frac{1-0.459}{0.459})≈-0.164$\n\n- For $y=0.714,$ we get $x=-\\operatorname{ln}⁡(\\frac{1-0.714}{0.714})≈0.915$\n\n- For $y=0.938,$ we get $x=-\\operatorname{ln}⁡(\\frac{1-0.938}{0.938})≈2.717$"} {:db/id #edb/ref 17592186557330 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c580589-f052-5d9b-a6c6-7fbb1e3611bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A single point" :db/id #edb/ref 17592186556454} {:answer/id #uuid "3a943015-36f4-5c0a-95ff-665bc2f267cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A parabola" :db/id #edb/ref 17592186556556} {:answer/id #uuid "5232f5b8-0b2a-5331-a3c6-6bdf904e28d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A circle of radius $1$" :db/id #edb/ref 17592186556617} {:answer/id #uuid "80046462-96bc-5593-af9e-f1048b0a9e3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipse with semiaxes $1$ and $2$" :db/id #edb/ref 17592186556724} {:answer/id #uuid "91de276f-566d-5d21-823b-f4eec78a0be4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A pair of parallel lines" :db/id #edb/ref 17592186556781}] :answer-field/correct {:answer/id #uuid "5232f5b8-0b2a-5331-a3c6-6bdf904e28d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A circle of radius $1$" :db/id #edb/ref 17592186556617} :answer-field/id #uuid "7d11b4fd-cfd0-5513-851a-592175c62665" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557138}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f72287c6-b1eb-590a-839e-db294cf79f90" :question/math-academy-id "q-96091" :question/problem "What type of quadratic curve is defined by the following equation?\n\n$$\n2{x}_{1}^{2}+2{x}_{2}^{2}-2{x}_{1}=\\frac{3}{2}\n$$" :question/worked-solution "First, we complete the squares for the variable ${x}_{1}:$\n\n$$\n\\begin{aligned}2{x}_{1}^{2}+2{x}_{2}^{2}-2{x}_{1} & =\\frac{3}{2} \\\\ 2({x}_{1}^{2}-{x}_{1})+2{x}_{2}^{2} & =\\frac{3}{2} \\\\ 2({x}_{1}^{2}-{x}_{1}+{(\\frac{1}{2})}^{2}-{(\\frac{1}{2})}^{2})+2{x}_{2}^{2} & =\\frac{3}{2} \\\\ 2{({x}_{1}-\\frac{1}{2})}^{2}-2{(\\frac{1}{2})}^{2}+2{x}_{2}^{2} & =\\frac{3}{2} \\\\ 2{({x}_{1}-\\frac{1}{2})}^{2}-\\frac{1}{2}+2{x}_{2}^{2} & =\\frac{3}{2} \\\\ 2{({x}_{1}-\\frac{1}{2})}^{2}+2{x}_{2}^{2} & =2 \\\\ {({x}_{1}-\\frac{1}{2})}^{2}+{x}_{2}^{2} & =1\\end{aligned}\n$$\n\nNow, performing the change of variables\n\n$$\n\\{\\begin{aligned}{y}_{1}={x}_{1}-\\frac{1}{2}, \\\\ {y}_{2}={x}_{2},\\end{aligned}\n$$\n\nwe get the following:\n\n$$\n\\begin{aligned}{y}_{1}^{2}+{y}_{2}^{2} & =1\\end{aligned}\n$$\n\n \n\nThis represents a circle of radius $1.$"} {:db/id #edb/ref 17592186557447 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4bc03413-e383-5579-b76c-092cfdf0ba2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}\\operatorname{ln}⁡\\frac{5}{4}" :db/id #edb/ref 17592186557459} {:answer/id #uuid "9cf1d1bd-cd3b-5362-a201-96e2f8d65215" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186557477} {:answer/id #uuid "c8dd696a-a439-5722-8165-12e98bab773e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡\\frac{5}{4}" :db/id #edb/ref 17592186557484} {:answer/id #uuid "cf207c00-d6db-5ca5-ae88-332c78997858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡5" :db/id #edb/ref 17592186557486} {:answer/id #uuid "f0551450-197d-58b1-8016-b5ae5d19fb42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡\\frac{5}{4}" :db/id #edb/ref 17592186557494}] :answer-field/correct {:answer/id #uuid "c8dd696a-a439-5722-8165-12e98bab773e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡\\frac{5}{4}" :db/id #edb/ref 17592186557484} :answer-field/id #uuid "b06b705a-a49e-57b4-8e75-93b51d1cd651" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557479}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "122c57cf-cfe9-5e24-b30b-49b9810a796b" :question/problem "Use a change of variables to calculate the area of the finite region $D$ in the first quadrant bounded by the following curves and lines.\n$y = \\frac{3}{x}, y = \\frac{7}{x}, y = 4x, y = 5x$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}]\n$$\n\nWe'll assume this transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv,\n$$\n\n  \n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required area, we proceed in five steps:\n\n**Step 1**: Find a suitable change of variables.\n\nNotice that we can rewrite the equations of our curves as follows:\n\n$$\nxy=3,\\,xy=7,\\,\\frac{y}{x}=4,\\,\\frac{y}{x}=5\n$$\n\nThis suggests the following change of variables:\n\n$$\nu=xy,\\,v=\\frac{y}{x}\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y\\end{aligned}]\\to [\\begin{aligned}u(x,y) \\\\ v(x,y)\\end{aligned}].\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nWe substitute $u=xy$ into the equations of the first and second curves:\n\n$$\n\\begin{aligned} & xy=3\\,⟹\\,u=3 \\\\  & xy=7\\,⟹\\,u=7\\end{aligned}\n$$\n\nAnd we substitute $v=\\frac{y}{x}$ into the equations of the third and fourth curves:\n\n$$\n\\begin{aligned} & \\frac{y}{x}=4\\,⟹\\,v=4 \\\\  & \\frac{y}{x}=5\\,⟹\\,v=5\\end{aligned}\n$$\n\nTherefore, our domain in the $uv$-plane is the following rectangle:\n\n$$\nΔ=\\{(u,v)\\,:\\,3\\le u\\le 7,\\,4\\le v\\le 5\\}\n$$\n\n![](images/3d/3dc524083463c8c370ff1f79d68093f0d3f2c2fe1ceb5cd47824782e35a0bac9.png)\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{aligned}| \\\\  & =|\\begin{aligned}y & x \\\\ -\\frac{y}{x^2} & \\frac{1}{x}\\end{aligned}| \\\\  & =\\frac{y}{x}+\\frac{y}{x} \\\\  & =2v.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}=\\frac{1}{2v}.\n$$\n\nNote that $\\frac{∂(u,v)}{∂(x,y)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}\\frac{1}{2v}\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{3}^{7}\\,\\text{d}u{\\int }_{4}^{5}\\frac{1}{v}\\,\\text{d}v \\\\  & =\\frac{1}{2}\\cdot (7-3)\\cdot (\\operatorname{ln}⁡5-\\operatorname{ln}⁡4) \\\\  & =2\\operatorname{ln}⁡\\frac{5}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186557450 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7679f101-3932-576a-bb5f-e5c4e0d8f328" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186557469} {:answer/id #uuid "b146b24c-8adf-51d6-9b4a-ace2765fa126" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186557481} {:answer/id #uuid "b8309c86-ea8f-5023-84d6-cc1e1d1ff7de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186557483} {:answer/id #uuid "d5935ed1-7de1-54f7-8776-fa2897e513ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186557488} {:answer/id #uuid "fe94daf5-1f4e-5c5e-a0ad-b319ec84510e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186557500}] :answer-field/correct {:answer/id #uuid "d5935ed1-7de1-54f7-8776-fa2897e513ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186557488} :answer-field/id #uuid "7b4bdfb4-f617-5835-a9b7-bf4aa30c0245" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557471}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1e54c2fb-3e60-532d-b51f-b6a974c7d6cf" :question/problem "Use a change of variables to calculate the area of the finite region $D$ in the first quadrant bounded by the following curves and lines.\n$y = \\frac{2}{x}, y = \\frac{5}{x}, y = 2x, y = 3x$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}]\n$$\n\nWe'll assume this transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv,\n$$\n\n  \n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required area, we proceed in five steps:\n\n**Step 1**: Find a suitable change of variables.\n\nNotice that we can rewrite the equations of our curves as follows:\n\n$$\nxy=2,\\,xy=5,\\,\\frac{y}{x}=2,\\,\\frac{y}{x}=3\n$$\n\nThis suggests the following change of variables:\n\n$$\nu=xy,\\,v=\\frac{y}{x}\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y\\end{aligned}]\\to [\\begin{aligned}u(x,y) \\\\ v(x,y)\\end{aligned}].\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nWe substitute $u=xy$ into the equations of the first and second curves:\n\n$$\n\\begin{aligned} & xy=2\\,⟹\\,u=2 \\\\  & xy=5\\,⟹\\,u=5\\end{aligned}\n$$\n\nAnd we substitute $v=\\frac{y}{x}$ into the equations of the third and fourth curves:\n\n$$\n\\begin{aligned} & \\frac{y}{x}=2\\,⟹\\,v=2 \\\\  & \\frac{y}{x}=3\\,⟹\\,v=3\\end{aligned}\n$$\n\nTherefore, our domain in the $uv$-plane is the following rectangle:\n\n$$\nΔ=\\{(u,v)\\,:\\,2\\le u\\le 5,\\,2\\le v\\le 3\\}\n$$\n\n![](images/2c/2cdd0431c256b72ded23c14fac4098b518a46603d46d5dfd238c54b3a46c66db.png)\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{aligned}| \\\\  & =|\\begin{aligned}y & x \\\\ -\\frac{y}{x^2} & \\frac{1}{x}\\end{aligned}| \\\\  & =\\frac{y}{x}+\\frac{y}{x} \\\\  & =2v.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}=\\frac{1}{2v}.\n$$\n\nNote that $\\frac{∂(u,v)}{∂(x,y)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}\\frac{1}{2v}\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{2}^{5}\\,\\text{d}u{\\int }_{2}^{3}\\frac{1}{v}\\,\\text{d}v \\\\  & =\\frac{1}{2}\\cdot (5-2)\\cdot (\\operatorname{ln}⁡3-\\operatorname{ln}⁡2) \\\\  & =\\frac{3}{2}\\operatorname{ln}⁡\\frac{3}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186557452 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73eb65d7-09df-500e-9d56-1a66efa416ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186557468} {:answer/id #uuid "7c271fcc-050b-5bd7-bb0a-bd7e59bd8013" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186557472} {:answer/id #uuid "abbdfe07-8aed-512d-9ff0-01181e26a377" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186557478} {:answer/id #uuid "ee8c388f-4bcc-5ca9-9c82-9cdfdfa398e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3" :db/id #edb/ref 17592186557492} {:answer/id #uuid "fb51af7c-e436-58e4-828c-830ac59f2a0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186557498}] :answer-field/correct {:answer/id #uuid "7c271fcc-050b-5bd7-bb0a-bd7e59bd8013" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186557472} :answer-field/id #uuid "fe81a033-5b30-59ce-b828-9ec0ad8c66db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557499}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "21d697ec-a429-5e49-b479-9da388eda962" :question/problem "Use a change of variables to calculate the area of the finite region $D$ in the first quadrant bounded by the following curves and lines.\n\n$$\ny=\\frac{2}{x},\\,y=\\frac{5}{x},\\,x=2{y}^{2},\\,x=3{y}^{2}\n$$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}]\n$$\n\nWe'll assume this transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv,\n$$\n\n  \n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required area, we proceed in five steps:\n\n**Step 1**: Find a suitable change of variables.\n\nNotice that we can rewrite the equations of our curves as follows:\n\n$$\nxy=2,\\,xy=5,\\,\\frac{x}{{y}^{2}}=2,\\,\\frac{x}{{y}^{2}}=3\n$$\n\nThis suggests the following change of variables:\n\n$$\nu=xy,\\,v=\\frac{x}{{y}^{2}}\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y\\end{aligned}]\\to [\\begin{aligned}u(x,y) \\\\ v(x,y)\\end{aligned}].\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nWe substitute $u=xy$ into the equations of the first and second curves:\n\n$$\n\\begin{aligned} & xy=2\\,⟹\\,u=2 \\\\  & xy=5\\,⟹\\,u=5\\end{aligned}\n$$\n\nAnd we substitute $v=\\frac{x}{{y}^{2}}$ into the equations of the third and fourth curves:\n\n$$\n\\begin{aligned} & \\frac{x}{{y}^{2}}=2\\,⟹\\,v=2 \\\\  & \\frac{x}{{y}^{2}}=3\\,⟹\\,v=3\\end{aligned}\n$$\n\nTherefore, our domain in the $uv$-plane is the following rectangle:\n\n$$\nΔ=\\{(u,v)\\,:\\,2\\le u\\le 5,\\,2\\le v\\le 3\\}\n$$\n\n![](images/2c/2cdd0431c256b72ded23c14fac4098b518a46603d46d5dfd238c54b3a46c66db.png)\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{aligned}| \\\\  & =|\\begin{aligned}y & x \\\\ \\frac{1}{{y}^{2}} & -\\frac{2x}{{y}^{3}}\\end{aligned}| \\\\  & =-\\frac{2x}{{y}^{2}}-\\frac{x}{{y}^{2}} \\\\  & =-\\frac{3x}{{y}^{2}} \\\\  & =-3v.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}=-\\frac{1}{3v}.\n$$\n\nNote that $\\frac{∂(u,v)}{∂(x,y)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|-\\frac{1}{3v}|\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{3}{∬}_{Δ}\\frac{1}{v}\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{2}^{5}\\,\\text{d}u{\\int }_{2}^{3}\\frac{1}{v}\\,\\text{d}v \\\\  & =\\frac{1}{3}\\cdot (5-2)\\cdot (\\operatorname{ln}⁡3-\\operatorname{ln}⁡2) \\\\  & =\\operatorname{ln}⁡\\frac{3}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186557458 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bde0c95-87d9-5021-b422-7d119cac0a2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡\\frac{4}{3}" :db/id #edb/ref 17592186557446} {:answer/id #uuid "2a6c0a49-01f3-50ea-b745-5a7c5cfa9970" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186557455} {:answer/id #uuid "2e012937-cb75-5afb-b9ca-7b669b2673ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\operatorname{ln}⁡4" :db/id #edb/ref 17592186557456} {:answer/id #uuid "603d58c2-77dc-53d3-835f-ca352ce1e392" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}\\operatorname{ln}⁡\\frac{4}{3}" :db/id #edb/ref 17592186557462} {:answer/id #uuid "ec567be1-2042-5aa0-a72f-b2a7a1771cbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\operatorname{ln}⁡\\frac{4}{3}" :db/id #edb/ref 17592186557491}] :answer-field/correct {:answer/id #uuid "ec567be1-2042-5aa0-a72f-b2a7a1771cbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\operatorname{ln}⁡\\frac{4}{3}" :db/id #edb/ref 17592186557491} :answer-field/id #uuid "690d18f9-3146-524d-a5a2-208e9362d1d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557465}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "42a708f1-2e3f-5710-8d8f-00feeafdf2b2" :question/problem "Use a change of variables to calculate the area of the finite region $D$ in the first quadrant bounded by the following curves and lines.\n$y = \\frac{1}{x}, y = \\frac{4}{x}, y = 3x, y = 4x$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}]\n$$\n\nWe'll assume this transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv,\n$$\n\n  \n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required area, we proceed in five steps:\n\n**Step 1**: Find a suitable change of variables.\n\nNotice that we can rewrite the equations of our curves as follows:\n\n$$\nxy=1,\\,xy=4,\\,\\frac{y}{x}=3,\\,\\frac{y}{x}=4\n$$\n\nThis suggests the following change of variables:\n\n$$\nu=xy,\\,v=\\frac{y}{x}\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y\\end{aligned}]\\to [\\begin{aligned}u(x,y) \\\\ v(x,y)\\end{aligned}].\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nWe substitute $u=xy$ into the equations of the first and second curves:\n\n$$\n\\begin{aligned} & xy=1\\,⟹\\,u=1 \\\\  & xy=4\\,⟹\\,u=4\\end{aligned}\n$$\n\nAnd we substitute $v=\\frac{y}{x}$ into the equations of the third and fourth curves:\n\n$$\n\\begin{aligned} & \\frac{y}{x}=3\\,⟹\\,v=3 \\\\  & \\frac{y}{x}=4\\,⟹\\,v=4\\end{aligned}\n$$\n\nTherefore, our domain in the $uv$-plane is the following rectangle:\n\n$$\nΔ=\\{(u,v)\\,:\\,1\\le u\\le 4,\\,3\\le v\\le 4\\}\n$$\n\n![](images/88/88750e49134feaa087b1f48ddee12faeb30ca8a31dd3b5bebb989f4c7c891ae7.png)\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{aligned}| \\\\  & =|\\begin{aligned}y & x \\\\ -\\frac{y}{x^2} & \\frac{1}{x}\\end{aligned}| \\\\  & =\\frac{y}{x}+\\frac{y}{x} \\\\  & =2v.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}=\\frac{1}{2v}.\n$$\n\nNote that $\\frac{∂(u,v)}{∂(x,y)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}\\frac{1}{2v}\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{1}^{4}\\,\\text{d}u{\\int }_{3}^{4}\\frac{1}{v}\\,\\text{d}v \\\\  & =\\frac{1}{2}\\cdot (4-1)\\cdot (\\operatorname{ln}⁡4-\\operatorname{ln}⁡3) \\\\  & =\\frac{3}{2}\\operatorname{ln}⁡\\frac{4}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186557460 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "210c7817-face-512a-bd86-a64b17d52373" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\operatorname{ln}⁡\\frac{7}{4}" :db/id #edb/ref 17592186557451} {:answer/id #uuid "254ec97c-0212-583c-b49e-6a869eb1d355" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186557453} {:answer/id #uuid "69982d7e-1d88-5550-9f63-20d44a587a81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡\\frac{7}{4}" :db/id #edb/ref 17592186557466} {:answer/id #uuid "cdcb6add-4b39-5487-9f4a-cb645e09e337" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡\\frac{7}{4}" :db/id #edb/ref 17592186557485} {:answer/id #uuid "f95423eb-63d2-501d-87fa-8c0d6bc4a077" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\operatorname{ln}⁡\\frac{7}{4}" :db/id #edb/ref 17592186557497}] :answer-field/correct {:answer/id #uuid "cdcb6add-4b39-5487-9f4a-cb645e09e337" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡\\frac{7}{4}" :db/id #edb/ref 17592186557485} :answer-field/id #uuid "2a292981-3f43-5a33-b54f-0f6a73d0854d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557454}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5805f5a4-c211-580d-a915-dc2770c526f8" :question/problem "Use a change of variables to calculate the area of the finite region $D$ in the first quadrant bounded by the following curves and lines.\n\n$$\ny=\\frac{4}{{x}^{2}},\\,y=\\frac{7}{{x}^{2}},\\,y=\\frac{4}{x},\\,y=\\frac{8}{x}\n$$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}]\n$$\n\nWe'll assume this transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv,\n$$\n\n  \n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required area, we proceed in five steps:\n\n**Step 1**: Find a suitable change of variables.\n\nNotice that we can rewrite the equations of our curves as follows:\n\n$$\n{x}^{2}y=4,\\,{x}^{2}y=7,\\,xy=4,\\,xy=8\n$$\n\nThis suggests the following change of variables:\n\n$$\nu={x}^{2}y,\\,v=xy\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y\\end{aligned}]\\to [\\begin{aligned}u(x,y) \\\\ v(x,y)\\end{aligned}].\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nWe substitute $u={x}^{2}y$ into the equations of the first and second curves:\n\n$$\n\\begin{aligned} & {x}^{2}y=4\\,⟹\\,u=4 \\\\  & {x}^{2}y=7\\,⟹\\,u=7\\end{aligned}\n$$\n\nAnd we substitute $v=xy$ into the equations of the third and fourth curves:\n\n$$\n\\begin{aligned} & xy=4\\,⟹\\,v=4 \\\\  & xy=8\\,⟹\\,v=8\\end{aligned}\n$$\n\nTherefore, our domain in the $uv$-plane is the following rectangle:\n\n$$\nΔ=\\{(u,v)\\,:\\,4\\le u\\le 7,\\,4\\le v\\le 8\\}\n$$\n\n![](images/47/475635e9575bd2f30069f2ee5f3b29bd6d7bf47db0cb6d5a96f981e36b8117c6.png)\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{aligned}| \\\\  & =|\\begin{aligned}2xy & {x}^{2} \\\\ y & x\\end{aligned}| \\\\  & =2{x}^{2}y-{x}^{2}y \\\\  & =u.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}=\\frac{1}{u}.\n$$\n\nNote that $\\frac{∂(u,v)}{∂(x,y)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|\\frac{1}{u}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}\\frac{1}{u}\\,\\text{d}u\\text{d}v \\\\  & ={\\int }_{4}^{7}\\frac{1}{u}\\,\\text{d}u{\\int }_{4}^{8}\\,\\text{d}v \\\\  & =(\\operatorname{ln}⁡7-\\operatorname{ln}⁡4)\\cdot (8-4) \\\\  & =4\\operatorname{ln}⁡\\frac{7}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186557470 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "615769bf-cd9e-5b6c-bdf0-52ec2d404c73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :an