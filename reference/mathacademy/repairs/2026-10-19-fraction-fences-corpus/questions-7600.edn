i }{3}) \\\\  & =\\frac{19}{3}\\cdot (-\\frac{1}{2}) \\\\  & =-\\frac{19}{6}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186544055 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "025b96a9-fd3c-5e9b-af50-2eede6f0de28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3\\sqrt{6}}{8}" :db/id #edb/ref 17592186544014} {:answer/id #uuid "42c48696-2e71-5f50-be40-a4e29348c5a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}}{8}" :db/id #edb/ref 17592186544027} {:answer/id #uuid "b5c46d77-31d5-59c7-bdd0-8d3efac6744d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}}{4}" :db/id #edb/ref 17592186544045} {:answer/id #uuid "c9f1390d-33db-59ee-bdda-27ef9c779d1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186544050} {:answer/id #uuid "f9644df6-609d-5092-ba27-53c85a68d464" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{6}}{8}" :db/id #edb/ref 17592186544064}] :answer-field/correct {:answer/id #uuid "025b96a9-fd3c-5e9b-af50-2eede6f0de28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3\\sqrt{6}}{8}" :db/id #edb/ref 17592186544014} :answer-field/id #uuid "c113ca18-6b05-5e8f-850c-b3873ed3519f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186544048}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d41ac9e9-9c5b-5d22-9909-8a38ad72197b" :question/problem "Suppose $|\\,a\\,|=\\frac{3\\sqrt{2}}{4}$ and the angle between vectors $a$ and $b$ is $\\theta ={150}^{∘}.$ Find the scalar projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =\\frac{3\\sqrt{2}}{4}\\operatorname{cos}⁡({150}^{∘}) \\\\  & =\\frac{3\\sqrt{2}}{4}\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{3\\sqrt{6}}{8}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186544065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c02b906-ae20-50c8-bed5-3bb797391ce4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3\\sqrt{3}}{8}" :db/id #edb/ref 17592186544023}] :answer-field/correct {:answer/id #uuid "2c02b906-ae20-50c8-bed5-3bb797391ce4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3\\sqrt{3}}{8}" :db/id #edb/ref 17592186544023} :answer-field/id #uuid "cb898007-433e-563f-888f-d36152226b68" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186544053}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fba4bbe3-b689-56be-8219-e32d77251473" :question/problem "Suppose $|\\,a\\,|=\\frac{3}{4}$ and the angle between vectors $a$ and $b$ is $\\theta =\\frac{5\\pi }{6}.$ Find the scalar projection of $a$ onto $b.$\n\n${\\text{comp}}_{b}\\,a=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we have\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =\\frac{3}{4}cos\\,(\\frac{5\\pi }{6}) \\\\  & =\\frac{3}{4}\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{3\\sqrt{3}}{8}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186544782 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "406dddda-d7bc-5487-ac5d-0ec92eae17bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186544231}] :answer-field/correct {:answer/id #uuid "406dddda-d7bc-5487-ac5d-0ec92eae17bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186544231} :answer-field/id #uuid "978ca5a5-cf10-5fbd-84fe-abe606da7ae7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186544723}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "00bb583b-38c4-5b10-945e-a15928b12671" :question/math-academy-id "q-133228" :question/problem "Find the slope of the tangent line to the given polar curve at $\\theta =\\frac{\\pi }{3}.$\n\nSlope $=$\n{{field-1}}" :question/worked-solution "In parts 2 and 3, we found that\n\n$$\n{x}^{′}(\\theta )=6\\operatorname{cos}⁡(2\\theta ),\\,{y}^{′}(\\theta )=6\\operatorname{sin}⁡(2\\theta ).\n$$\n\nNow, to find $\\frac{\\text{d}y}{\\text{d}x},$ we use the rule\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )}.\n$$\n\nWe have\n\n$$\n\\begin{aligned}{x}^{′}(\\frac{\\pi }{3}) & =6\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{3}) \\\\  & =6\\operatorname{cos}⁡(\\frac{2\\pi }{3}) \\\\  & =6\\cdot (-\\frac{1}{2}) \\\\  & =-3.\\end{aligned}\n$$\n\n \n\nand \n\n$$\n\\begin{aligned}{y}^{′}(\\frac{\\pi }{3}) & =6\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{3}) \\\\  & =6\\operatorname{sin}⁡(\\frac{2\\pi }{3}) \\\\  & =6\\cdot (\\frac{\\sqrt{3}}{2}) \\\\  & =3\\sqrt{3}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{\\theta =\\pi /3} & =\\frac{{y}^{′}(\\frac{\\pi }{3})}{{x}^{′}(\\frac{\\pi }{3})} \\\\  & =\\frac{3\\sqrt{3}}{(-3)} \\\\  & =-\\sqrt{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186544814 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f147060-2e3d-530e-8605-1ba13a4114d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={log}_{5}⁡(3)" :db/id #edb/ref 17592186544364} {:answer/id #uuid "9dec9e09-3ab9-51d5-93f5-5553f7a2ae1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={log}_{5}⁡(\\frac{1}{3})" :db/id #edb/ref 17592186544429} {:answer/id #uuid "cd163f76-39be-503b-8e02-0fc0fc56c0ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={log}_{3}⁡(5)" :db/id #edb/ref 17592186544521} {:answer/id #uuid "d87bd39e-276b-5919-ae48-a488a12d6528" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{{log}_{3}⁡(5)}" :db/id #edb/ref 17592186544553} {:answer/id #uuid "f4426217-c85d-5fd5-a049-5d1b721018a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={log}_{3}⁡(\\frac{1}{5})" :db/id #edb/ref 17592186544617}] :answer-field/correct {:answer/id #uuid "cd163f76-39be-503b-8e02-0fc0fc56c0ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={log}_{3}⁡(5)" :db/id #edb/ref 17592186544521} :answer-field/id #uuid "479444fd-611e-5a03-bcad-55f19ebf647d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186544681}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4dbd2fd5-279c-5b4f-83af-6acbee35f908" :question/math-academy-id "q-66801" :question/problem "Find the exact solution of the equation ${3}^{x}=5.$" :question/worked-solution "We take ${log}_{3}$ of both sides of the equation:\n\n$$\n\\begin{aligned}{3}^{x} & =5 \\\\ {log}_{3}⁡({3}^{x}) & ={log}_{3}⁡(5)\\end{aligned}\n$$\n\nNow, we use the fact that ${log}_{b}⁡({b}^{c})=c$ to simplify the left-hand side. This gives:\n\n$$\nx={log}_{3}⁡(5)\n$$"} {:db/id #edb/ref 17592186544821 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fd65f66-345e-5e02-a44f-83cf02b3d0b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{3}x+9" :db/id #edb/ref 17592186544335}] :answer-field/correct {:answer/id #uuid "6fd65f66-345e-5e02-a44f-83cf02b3d0b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{3}x+9" :db/id #edb/ref 17592186544335} :answer-field/id #uuid "248fba5d-72db-5572-a2be-4b009978848e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186544666}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5bcca525-fc41-52cc-be8b-f245ac9162a9" :question/math-academy-id "q-133231" :question/problem "Find the equation of the tangent line to our polar curve at $\\theta =\\frac{\\pi }{3}.$\n\nThe tangent line is $y\\,=$\n{{field-1}}" :question/worked-solution "Previously, we found that the slope of the tangent line at $\\theta =\\frac{\\pi }{3}$ is\n\n$$\nm=-\\sqrt{3}.\n$$\n\nThe equation of the tangent is\n\n$$\ny-{y}_{0}=m(x-{x}_{0}),\n$$\n\nwhere $({x}_{0},{y}_{0})$ are the coordinates of the point on the curve that correspond to $\\theta =\\frac{\\pi }{3}.$ Let's work these out. \n\nIn part 1, we found that\n\n$\\,$ $x(\\theta )=3\\operatorname{sin}⁡(2\\theta )\\,$ and $\\,y(\\theta )=6{sin}^{2}⁡\\theta .$\n\nAs a result, we have\n\n$$\n\\begin{aligned}{x}_{0} & =3\\operatorname{sin}⁡(2\\theta ) \\\\  & =3\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{3}) \\\\  & =3\\operatorname{sin}⁡(\\frac{2\\pi }{3}) \\\\  & =3\\cdot (\\frac{\\sqrt{3}}{2}) \\\\  & =\\frac{3\\sqrt{3}}{2}, \\\\ {y}_{0} & =6{sin}^{2}⁡\\theta  \\\\  & =6{sin}^{2}⁡(\\frac{\\pi }{3}) \\\\  & =6{(\\frac{\\sqrt{3}}{2})}^{2} \\\\  & =\\frac{9}{2}.\\end{aligned}\n$$\n\nTherefore, $({x}_{0},{y}_{0})=(\\frac{3\\sqrt{3}}{2},\\frac{9}{2}).$ \n\nFinally, the equation of the tangent line is given by\n\n$$\n\\begin{aligned}y-{y}_{0} & =m(x-{x}_{0}) \\\\ y-\\frac{9}{2} & =-\\sqrt{3}(x-\\frac{3\\sqrt{3}}{2}) \\\\ y-\\frac{9}{2} & =-\\sqrt{3}x+\\frac{9}{2} \\\\ y & =-\\sqrt{3}x+9.\\end{aligned}\n$$\n\n![](images/b8/b8546c0b6c51577acf25587fc1ebfc88e15e5f3b9456a64c499d640851bb44d0.png)"} {:db/id #edb/ref 17592186544844 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e01582e-53ea-5a54-9f0c-d53b90245089" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.18" :db/id #edb/ref 17592186544227}] :answer-field/correct {:answer/id #uuid "3e01582e-53ea-5a54-9f0c-d53b90245089" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.18" :db/id #edb/ref 17592186544227} :answer-field/id #uuid "17a47526-4f69-5723-8a3e-3d9029c72ee7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186544662}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9165f710-3b4c-5eb0-a90d-63ff961aee99" :question/math-academy-id "q-319490" :question/problem "Find, **in radians**, the argument of $z=5+12\\text{i}.$ Round your final answer to **two decimal places**.\n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$ \n\n$\\operatorname{arg}⁡(z)≈$\n{{field-1}}" :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](images/c9/c94a6f3da0e2feb5421ad8652da0dde170d914ea4404a70c37a4112293fe810e.png)\n\nThe complex number $z$ lies in the first quadrant of the complex plane. Hence $0<\\operatorname{arg}⁡(z)<\\frac{\\pi }{2}.$\n\nTherefore,\n\n$$\n\\operatorname{arg}⁡(z)=arctan\\,(\\frac{12}{5})≈1.18,\n$$\n\nrounded to $2$ decimal places."} {:db/id #edb/ref 17592186544850 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69993dcc-284a-5552-b290-2efb22ae5263" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186544314} {:answer/id #uuid "92eaaa2e-7d8f-5f56-b19d-d506b27a8024" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186544409} {:answer/id #uuid "9c197951-1073-5f18-984d-9df842948758" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{8}" :db/id #edb/ref 17592186544424} {:answer/id #uuid "b14f2b58-5f26-54f6-970e-19775cadeaf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186544463} {:answer/id #uuid "d69a3208-7d65-5d95-b5a7-de518fff3019" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186544548}] :answer-field/correct {:answer/id #uuid "b14f2b58-5f26-54f6-970e-19775cadeaf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186544463} :answer-field/id #uuid "265d95ea-7f8d-5e15-8458-659dfbb603bf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186544668}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9880eb88-2023-5ce5-bda9-0c1fc8e76faf" :question/math-academy-id "q-74660" :question/problem "Find, in radians, the argument of $z=4+4\\text{i}.$ \n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$" :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](images/fe/fe0207214fb16ac0871e15f3be7c9fa33670a7df3617f5f9e0b92b45a09c76af.png)\n\nThe complex number $z$ lies in the first quadrant of the complex plane. Therefore $0<\\operatorname{arg}⁡(z)<\\frac{\\pi }{2}.$ Further,\n\n$$\n\\operatorname{arg}⁡(z)=\\operatorname{arctan}⁡(\\frac{4}{4})=\\operatorname{arctan}⁡(1)=\\frac{\\pi }{4}.\n$$"} {:db/id #edb/ref 17592186544858 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3965b942-4bfa-58af-87a2-5bee1c709bae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3\\cos^3(2\\theta)}" :db/id #edb/ref 17592186544211}] :answer-field/correct {:answer/id #uuid "3965b942-4bfa-58af-87a2-5bee1c709bae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3\\cos^3(2\\theta)}" :db/id #edb/ref 17592186544211} :answer-field/id #uuid "b75a3698-1ee7-50e3-b39c-ded471e1e2de" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186544740}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9dac1de0-3399-5e2c-82ff-248d3a51fed2" :question/math-academy-id "q-133230" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for our polar curve.\n\n$\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,=$\n{{field-1}}" :question/worked-solution "We will use the formula\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=\\frac{\\frac{d}{d\\theta }(\\frac{dy}{dx})}{(\\frac{dx}{d\\theta })}.\\end{aligned}\n$$\n\nPreviously, we've found that\n\n$\\,$ $\\frac{dx}{d\\theta }=6\\operatorname{cos}⁡(2\\theta )\\,$ and $\\,\\frac{\\text{d}y}{\\text{d}x}=\\operatorname{tan}⁡(2\\theta ).$ \n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{d}{d\\theta }(\\frac{dy}{dx}) & =\\frac{d}{d\\theta }(\\operatorname{tan}⁡(2\\theta )) \\\\  & ={sec}^{2}⁡(2\\theta )\\cdot 2 \\\\  & =2{sec}^{2}⁡(2\\theta ).\\end{aligned}\n$$\n\nFinally, substituting into our formula for the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{2{sec}^{2}⁡(2\\theta )}{6\\operatorname{cos}⁡(2\\theta )} \\\\  & =\\frac{1}{3}{sec}^{3}⁡(2\\theta ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186544870 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20de621f-e8f8-5627-bd64-6ba71b41077b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.55" :db/id #edb/ref 17592186544161}] :answer-field/correct {:answer/id #uuid "20de621f-e8f8-5627-bd64-6ba71b41077b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.55" :db/id #edb/ref 17592186544161} :answer-field/id #uuid "52688c42-4059-5864-ac3d-963accbc9ab7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186544689}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b96d4599-55b6-52a4-b5e9-744fec2eb4d7" :question/math-academy-id "q-319509" :question/problem "Find, **in radians**, the argument of $z=-7-3\\text{i}.$ Round your final answer to **two decimal places**.\n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$ \n\n$\\operatorname{arg}⁡(z)≈$\n{{field-1}}" :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](images/1d/1d131288e3d38767e1d82b68777e69667711e98665101093f3b7e544e9caea1e.png)\n\nThe complex number $z$ lies in the third quadrant of the complex plane. Hence $\\pi <\\operatorname{arg}⁡(z)<\\frac{3\\pi }{2}.$ \n\nIf $\\alpha $ is the angle that $z$ makes with the negative real axis, then\n\n$$\n\\alpha =arctan\\,(\\frac{3}{7})=0.404\\,892…\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arg}⁡(z)=\\pi +0.404\\,892…≈3.55,\n$$\n\nrounded to $2$ decimal places."} {:db/id #edb/ref 17592186544872 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac5709fe-0354-5d44-b05a-02a21b0da97c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.6065" :db/id #edb/ref 17592186544456} {:answer/id #uuid "d25214fe-4395-53a2-b548-fff04525e163" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.6605" :db/id #edb/ref 17592186544534} {:answer/id #uuid "dbff2e28-f33a-5f18-8f52-e274e4c55978" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.6665" :db/id #edb/ref 17592186544561} {:answer/id #uuid "e8872e6f-ba5a-570a-bbd3-ab8d4b6496ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.6153" :db/id #edb/ref 17592186544588} {:answer/id #uuid "fba8fc04-0fa8-577c-bd40-5fbcbbc648c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.6565" :db/id #edb/ref 17592186544637}] :answer-field/correct {:answer/id #uuid "ac5709fe-0354-5d44-b05a-02a21b0da97c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.6065" :db/id #edb/ref 17592186544456} :answer-field/id #uuid "d6c361c4-eefd-5311-9a84-4a9a4e2f34ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186544755}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bc8f4760-f931-5737-8a9c-5aab0b30c4bf" :question/math-academy-id "q-132558" :question/problem "The waiting time for one customer to be served at a cafeteria varies continuously, independently, and at a constant average rate of one person served every $4$  minutes. Determine the probability that the next person is served at least $2$ minutes after the previous one. Round your answer to $4$ decimal places." :question/worked-solution "Since the waiting time for one customer to be served at the cafeteria varies continuously, independently, and at a constant average rate, we can model the time until serving the next person as an exponential distribution.\n\nAn exponential random variable $X$ with rate $\\lambda $ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\lambda {e}^{-\\lambda x}, & x\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ be the time needed to serve the next person. The time needed to serve the next person can be modeled as an exponential random variable. Since one person is served every $4$ minutes on average, the rate is $\\lambda =\\frac{1}{4},$ and we can write \n\n$$\nX∼\\text{Exp}(\\frac{1}{4}).\n$$\n\n In this case, $X$ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{4}{e}^{-x/4}, & x\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nTherefore, the probability that the next person will be served at least $2$ minutes after the previous one is\n\n$$\n\\begin{aligned}P(X\\ge 2) & ={\\int }_{2}^{\\infty }f(x)\\,\\text{d}x \\\\  & ={\\int }_{2}^{\\infty }\\frac{1}{4}{e}^{-x/4}\\,\\text{d}x \\\\  & =-{e}^{-x/4}{|}_{2}^{\\infty } \\\\  & =-{e}^{-\\infty }+{e}^{-2/4} \\\\  & =0+{e}^{-1/2} \\\\  & ={e}^{-1/2} \\\\  & ≈0.6065.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186544879 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "003a02a8-0d57-518b-9d54-87c8ab14787c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.58" :db/id #edb/ref 17592186544087} {:answer/id #uuid "25ee0bd4-ea00-578f-a776-d6fe24e71b44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.68" :db/id #edb/ref 17592186544173} {:answer/id #uuid "29f70e3d-7fb0-550c-8527-ffe9105791c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.12" :db/id #edb/ref 17592186544183} {:answer/id #uuid "3c35a209-2e4f-5ab8-8e85-b2749b02bdc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.35" :db/id #edb/ref 17592186544220} {:answer/id #uuid "97c8c749-bb23-5bf5-acab-f511bce8e986" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.45" :db/id #edb/ref 17592186544415}] :answer-field/correct {:answer/id #uuid "25ee0bd4-ea00-578f-a776-d6fe24e71b44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.68" :db/id #edb/ref 17592186544173} :answer-field/id #uuid "f010bca9-60ae-5099-b94b-38fd64086818" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186544771}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cbe4274d-84e6-566b-a678-1dfe16c416af" :question/math-academy-id "q-8452" :question/problem "Find, in radians to two decimal places, the argument of $z=-5-3\\text{i}.$ \n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$" :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](images/95/9596107dc58d6acb67f1014ebc17e632dd03173aa975fa84b196588db873d8e5.png)\n\nThe complex number $z$ lies in the third quadrant of the complex plane. Therefore $\\pi <\\operatorname{arg}⁡(z)<\\frac{3\\pi }{2}.$ If $\\alpha $ is the angle that $z$ makes with the negative real axis, then\n\n$$\n\\begin{aligned}\\alpha =\\operatorname{arctan}⁡(\\frac{3}{5})≈0.540\\,42.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arg}⁡(z)≈\\pi +0.540\\,42≈3.68\n$$\n\nto two decimal places."} {:db/id #edb/ref 17592186544882 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "caa8381d-0308-5944-b790-50b787cd73b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.135" :db/id #edb/ref 17592186544516}] :answer-field/correct {:answer/id #uuid "caa8381d-0308-5944-b790-50b787cd73b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.135" :db/id #edb/ref 17592186544516} :answer-field/id #uuid "63853831-cd8f-5815-844b-593361f11ad4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186544696}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d44e0172-2699-5b95-8b6b-c9e2c6a8cdf3" :question/math-academy-id "q-254581" :question/problem "A customer support team resolves tickets continuously in time, independently, and at a constant average rate of $1$ ticket every $5$ minutes. If a ticket has been open for $20$ minutes already, what is the probability that it will remain unresolved for at least another $10$ minutes? Round your final answer to **three decimal places.**\n\nThe required probability is\n{{field-1}}." :question/worked-solution "Since the customer support team resolves tickets continuously in time, independently, and at a constant average rate, we can model the time until the next ticket is resolved using an exponential distribution.\n\nLet $X$ be the ticket resolving time, in minutes. Since the team resolves $1$ ticket every $5$ minutes on average, the rate is $\\lambda =\\frac{1}{5}$ tickets per minute, and we can write \n\n$$\nX∼\\text{Exp}(\\frac{1}{5}).\n$$\n\nRecall that exponential random variables have the memoryless property. So, given two positive real numbers $s,t,$ we have that\n\n$$\nP(X>s+t\\,|\\,X>s)=P(X>t)={e}^{-\\lambda t}.\n$$\n\nIn our case, we have $\\lambda =\\frac{1}{5},$ $s=20,$ and $t=10.$ \n\nSubstituting these values into the above formula, we get\n\n$$\n\\begin{aligned}P(X>20+10\\,|\\,X>20) & =P(X>10) \\\\  & ={e}^{-\\lambda t} \\\\  & ={e}^{-(1/5)\\cdot (10)} \\\\  & ={e}^{-2} \\\\  & ≈0.135.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186544889 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02f44278-1870-59da-b693-ab5e9edbb7b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1349" :db/id #edb/ref 17592186544092} {:answer/id #uuid "2fbb0c6a-76c4-5add-8d12-dd2f98f7de84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1990" :db/id #edb/ref 17592186544191} {:answer/id #uuid "59c37b7d-f2a8-5b03-96d5-27b94d5bddda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1909" :db/id #edb/ref 17592186544285} {:answer/id #uuid "e5302346-1455-507d-8c19-5af7fa10783e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1099" :db/id #edb/ref 17592186544580} {:answer/id #uuid "eee1f799-c2f5-5fbc-b0b8-69720cd98bfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1299" :db/id #edb/ref 17592186544606}] :answer-field/correct {:answer/id #uuid "e5302346-1455-507d-8c19-5af7fa10783e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1099" :db/id #edb/ref 17592186544580} :answer-field/id #uuid "74158e50-3525-5d26-bf97-113e74a7d386" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186544709}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e3898571-1060-5a54-af07-b5592b492d4f" :question/math-academy-id "q-132552" :question/problem "On a busy waterway, barges pass by a particular point continuously, independently, and at a constant average rate of one every $10$ minutes. Determine the probability that the next barge will pass between $5$ and $7$ minutes after the previous one. Round your answer to four decimal places." :question/worked-solution "Since barges pass continuously, independently, and at a constant average rate, we can model the time between two successive barges using an exponential distribution.\n\nAn exponential random variable $X$ with rate $\\lambda $ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\lambda {e}^{-\\lambda x}, & x\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ be the amount of time between two successive barges. Since a barge passes every $10$ minutes, the rate is $\\lambda =\\frac{1}{10}$ barges per minute.\n\nThe time interval between two successive barges can be modeled as an exponential random variable with rate $\\lambda =\\frac{1}{10},$ and we can write \n\n$$\nX∼\\text{Exp}(\\frac{1}{10}).\n$$\n\nSo, $X$ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{10}{e}^{-x/10}, & x\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nTherefore, the probability that the next barge will pass between $5$ and $7$ minutes after the previous one is\n\n$$\n\\begin{aligned}P(5<X<7) & ={\\int }_{5}^{7}f(x)\\,\\text{d}x \\\\  & ={\\int }_{5}^{7}\\frac{1}{10}{e}^{-x/10}\\,\\text{d}x \\\\  & =-{e}^{-x/10}{|}_{5}^{7} \\\\  & =-{e}^{-7/10}+{e}^{-5/10} \\\\  & ≈0.1099\\end{aligned}\n$$"} {:db/id #edb/ref 17592186544895 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99f15c2a-e5fc-5ca0-bb85-07dbfb14f2ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.487" :db/id #edb/ref 17592186544422}] :answer-field/correct {:answer/id #uuid "99f15c2a-e5fc-5ca0-bb85-07dbfb14f2ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.487" :db/id #edb/ref 17592186544422} :answer-field/id #uuid "d936cedc-6149-5dd3-984d-e6f7a43f2a04" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186544758}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f1e2b523-bf44-5c32-9b95-836b1e8d2e60" :question/math-academy-id "q-254609" :question/problem "While riding on a road, a cyclist encounters potholes continuously in time, independently, and at a constant average rate of $4$ potholes per hour. If the cyclist has not encountered any potholes in the past $30$ minutes, what is the probability that he will encounter a pothole in the next $10$ minutes? Round your final answer to **three decimal places.**\n\nThe required probability is\n{{field-1}}." :question/worked-solution "Since the cyclist encounters potholes continuously in time, independently, and at a constant average rate, we can model the time until the next pothole as an exponential distribution.\n\nLet $X$ be the time, in minutes, until the cyclist encounters the next pothole. Since the cyclist encounters, on average, $4$ potholes per hour (or $1$ pothole every $15$ minutes), the rate is $\\lambda =\\frac{1}{15}$ potholes per minute, and we can write \n\n$$\nX∼\\text{Exp}(\\frac{1}{15}).\n$$\n\nRecall that exponential random variables have the memoryless property. Therefore, given two positive real numbers $s,t,$ we have that\n\n$$\nP(X>s+t\\,|\\,X>s)=P(X>t)={e}^{-\\lambda t}.\n$$\n\nWe can compute the complementary conditional probability as follows:\n\n$$\nP(X\\le s+t\\,|\\,X>s)=1-P(X>s+t\\,|\\,X>s)=1-{e}^{-\\lambda t}\n$$\n\nIn our case, we have $\\lambda =\\frac{1}{15},$ $s=30,$ and $t=10.$ \n\nSubstituting these values into the above formula, we get\n\n$$\n\\begin{aligned}P(X\\le 30+10\\,|\\,X>30) & =P(X\\le 10) \\\\  & =1-{e}^{-\\lambda t} \\\\  & =1-{e}^{-(1/15)\\cdot (10)} \\\\  & =1-{e}^{-2/3} \\\\  & ≈0.487.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186545132 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a3fc09a-efc9-5c4c-ac65-bd75198800e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+\\frac{7}{2}}{y+\\frac{1}{2}}" :db/id #edb/ref 17592186545131} {:answer/id #uuid "7db5b616-54c4-5818-91bd-8636dfe89f9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2(x+\\frac{7}{2})}{y+\\frac{1}{2}}" :db/id #edb/ref 17592186545143} {:answer/id #uuid "8677d2a0-5832-5a14-aa54-22f821cce209" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x+\\frac{7}{2}}{y+\\frac{1}{2}}" :db/id #edb/ref 17592186545148} {:answer/id #uuid "a92aeace-c06b-57c2-b93a-99dd15e0cb20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x+\\frac{7}{2}}{2(y+\\frac{1}{2})}" :db/id #edb/ref 17592186545156} {:answer/id #uuid "bbb38e3c-a97d-5d21-b693-c4de60dd22b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{y+\\frac{1}{2}}{x+\\frac{7}{2}}" :db/id #edb/ref 17592186545165}] :answer-field/correct {:answer/id #uuid "8677d2a0-5832-5a14-aa54-22f821cce209" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x+\\frac{7}{2}}{y+\\frac{1}{2}}" :db/id #edb/ref 17592186545148} :answer-field/id #uuid "c3406e35-cfa3-57be-b127-de08e9b94e52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186545167}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4baaba62-d9ac-5b3e-89d5-fbd516aa665c" :question/problem "![](images/d4/d4ca74438b4c5e5eeae2ce46d7a86964d74adfb1e12df6029a41a04c0dea7e93.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the circle shown above." :question/worked-solution "Since our circle is centered at $(- \\frac{7}{2},- \\frac{1}{2})$ and has a radius of $\\frac{3}{2},$ its equation is given by\n\n$$\n(x-(- \\frac{7}{2}))^{2}+(y-(- \\frac{1}{2}))^{2}={\\frac{3}{2}}^{2}\\,⟹\\,(x+\\frac{7}{2})^{2}+(y+\\frac{1}{2})^{2}=\\frac{9}{4}.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}((x+\\frac{7}{2})^{2}+(y+\\frac{1}{2})^{2}) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{9}{4}) \\\\ \\frac{\\text{d}}{\\text{d}x}((x+\\frac{7}{2})^{2})+\\frac{\\text{d}}{\\text{d}x}((y+\\frac{1}{2})^{2}) & =0 \\\\ 2(x+\\frac{7}{2})+2(y+\\frac{1}{2})\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2(y+\\frac{1}{2})\\frac{\\text{d}y}{\\text{d}x} & =-2(x+\\frac{7}{2}) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x+\\frac{7}{2}}{y+\\frac{1}{2}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186545146 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03cc9736-1ad6-592a-aebb-e6c16d0d50e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x+\\frac{7}{2}}{y-\\frac{1}{2}}" :db/id #edb/ref 17592186545113} {:answer/id #uuid "1c75beaa-b238-5161-9628-8a764302e2cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+\\frac{7}{2}}{y-\\frac{1}{2}}" :db/id #edb/ref 17592186545117} {:answer/id #uuid "236ef634-16e5-560d-8f85-33280287b1dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2(x+\\frac{7}{2})}{y-\\frac{1}{2}}" :db/id #edb/ref 17592186545120} {:answer/id #uuid "6c3d80d9-4059-5ed3-acb0-dc16dbea0388" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{y-\\frac{1}{2}}{x+\\frac{7}{2}}" :db/id #edb/ref 17592186545140} {:answer/id #uuid "b6245221-7e9b-5bd2-b04e-69243f16c537" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x+\\frac{7}{2}}{2(y-\\frac{1}{2})}" :db/id #edb/ref 17592186545162}] :answer-field/correct {:answer/id #uuid "03cc9736-1ad6-592a-aebb-e6c16d0d50e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x+\\frac{7}{2}}{y-\\frac{1}{2}}" :db/id #edb/ref 17592186545113} :answer-field/id #uuid "b6ed4e09-8541-5487-a559-d5ce5f6c3312" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186545163}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "81a754d2-b653-5f5c-a94e-7ee027cc6ddf" :question/problem "![](images/3e/3ea6262a334d81630f0d8c1b35654c7d3c74745a344587be73b1852015ed3f47.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the circle shown above." :question/worked-solution "Since our circ