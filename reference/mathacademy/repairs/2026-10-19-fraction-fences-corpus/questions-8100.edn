[{:db/id #edb/ref 17592186567447 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "061cb6cc-3959-5b14-a981-3106b485c5eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i" :db/id #edb/ref 17592186567421} {:answer/id #uuid "3e51dd0e-8bba-5b42-b988-422251d36d75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(i+j)" :db/id #edb/ref 17592186567430} {:answer/id #uuid "58e6f7ff-07ca-5404-a2f8-04a18016cc0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-j" :db/id #edb/ref 17592186567435} {:answer/id #uuid "9c9ab139-6632-5ccc-9f6f-ba0573cb2c3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(i-j)" :db/id #edb/ref 17592186567441} {:answer/id #uuid "a337bb17-7b8c-5901-9a49-487470e0c389" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "j" :db/id #edb/ref 17592186567443}] :answer-field/correct {:answer/id #uuid "061cb6cc-3959-5b14-a981-3106b485c5eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i" :db/id #edb/ref 17592186567421} :answer-field/id #uuid "bcc9e5b3-fcfc-594a-bbf3-8c741fb6bf4b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186567448}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b488d0d8-0d5c-58db-a90e-48c42f1d42c6" :question/problem "Find a unit normal vector to the level curve of the function $f(x,y)=\\sqrt{{x}^{2}-{y}^{2}}$ that passes through the point where $(x,y)=(1,0).$" :question/worked-solution "A normal vector to the level curve that passes through the point where $(x,y)=(1,0)$, can be found by computing $∇f(1,0).$ \n\nSo, we first find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(1,0):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}(\\sqrt{{x}^{2}-{y}^{2}})\\,i \\\\ &\\quad +\\frac{∂}{∂y}(\\sqrt{{x}^{2}-{y}^{2}})\\,j \\\\  & =(\\frac{x}{\\sqrt{{x}^{2}-{y}^{2}}})\\,i+(-\\frac{y}{\\sqrt{{x}^{2}-{y}^{2}}})\\,j \\\\ ∇f(1,0) & =(\\frac{(1)}{\\sqrt{(1)^{2}-(0)^{2}}})\\,i \\\\ &\\quad +(-\\frac{(0)}{\\sqrt{(1)^{2}-(0)^{2}}})\\,j \\\\  & =\\frac{1}{\\sqrt{1}}\\,i-\\frac{0}{\\sqrt{1}}\\,j \\\\  & =i\\end{aligned}\n$$\n\nFinally, we normalize $∇f(1,0):$\n\n$$\n\\begin{aligned}\\frac{∇f(1,0)}{‖∇f(1,0)‖} & =\\frac{i}{\\sqrt{(1)^{2}+(0)^{2}}} \\\\  & =\\frac{i}{1} \\\\  & =i\\end{aligned}\n$$"} {:db/id #edb/ref 17592186567450 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "516067a1-6bca-5069-bbab-140935f51b38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\,i" :db/id #edb/ref 17592186567433} {:answer/id #uuid "86eaf185-0d45-569a-a7a0-8dff4d65f888" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\,j" :db/id #edb/ref 17592186567437} {:answer/id #uuid "8e50f7c7-1827-5994-b8f2-c35e30b7dddd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,j" :db/id #edb/ref 17592186567438} {:answer/id #uuid "9d56dc45-fddc-52b7-8158-e2e3313891b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "j" :db/id #edb/ref 17592186567442} {:answer/id #uuid "d514d19a-83e2-56dc-ae0c-76ff2bae7b4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i" :db/id #edb/ref 17592186567449}] :answer-field/correct {:answer/id #uuid "9d56dc45-fddc-52b7-8158-e2e3313891b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "j" :db/id #edb/ref 17592186567442} :answer-field/id #uuid "e4faeac1-9e8b-5c11-aec7-607387173f75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186567451}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "db955fef-1148-5a1c-a192-f4c8263ee71a" :question/problem "Find a unit normal vector to the level curve of the function $f(x,y)=\\operatorname{arctan}⁡(\\frac{y}{x})$ that passes through the point where $(x,y)=(4,0).$" :question/worked-solution "A normal vector to the level curve that passes through the point $(x,y)=(4,0)$ can be found by computing $∇f(4,0).$ \n\nSo, we first find the gradient and evaluate it at $(x,y)=(4,0):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(\\operatorname{arctan}⁡(\\frac{y}{x}))\\,i \\\\ &\\quad +\\frac{∂}{∂y}(\\operatorname{arctan}⁡(\\frac{y}{x}))\\,j \\\\  & =\\frac{(-\\frac{y}{{x}^{2}})}{1+{(\\frac{y}{x})}^{2}}\\,i+\\frac{(\\frac{1}{x})}{1+{(\\frac{y}{x})}^{2}}\\,j \\\\  & =(-\\frac{y}{{x}^{2}+{y}^{2}})\\,i+(\\frac{x}{{x}^{2}+{y}^{2}})\\,j \\\\ ∇f(4,0) & =(-\\frac{(0)}{(4)^{2}+(0)^{2}})\\,i \\\\ &\\quad +(\\frac{(4)}{(4)^{2}+(0)^{2}})\\,j \\\\  & =\\frac{0}{16}\\,i+\\frac{4}{16}\\,j \\\\  & =\\frac{1}{4}(j)\\end{aligned}\n$$\n\nFinally, we normalize $∇f(4,0):$\n\n$$\n\\begin{aligned}\\frac{∇f(4,0)}{‖∇f(4,0)‖} & =\\frac{\\frac{1}{4}(j)}{‖\\frac{1}{4}(j)‖} \\\\  & =\\frac{1}{(\\frac{1}{4}\\cdot\\sqrt{(0)^{2}+(1)^{2}})}\\cdot \\frac{1}{4}(j) \\\\  & =\\frac{1}{\\sqrt{1}}(j) \\\\  & =j\\end{aligned}\n$$"} {:db/id #edb/ref 17592186568226 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06b221b9-03f6-5ca6-beba-1508c338f7f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.1" :db/id #edb/ref 17592186568215} {:answer/id #uuid "1031a37d-3139-5e7e-bd91-9947b2ecd733" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.6" :db/id #edb/ref 17592186568216} {:answer/id #uuid "30ead38b-20c2-5594-a0fd-7b24e0a712e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.5" :db/id #edb/ref 17592186568221} {:answer/id #uuid "75ca8635-d921-55ac-bc68-e4b1e06608a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.4" :db/id #edb/ref 17592186568231} {:answer/id #uuid "e0feead4-55c2-5b19-8ac0-7aba1e372e4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.6" :db/id #edb/ref 17592186568247}] :answer-field/correct {:answer/id #uuid "06b221b9-03f6-5ca6-beba-1508c338f7f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.1" :db/id #edb/ref 17592186568215} :answer-field/id #uuid "6d697206-93f6-5a50-a668-a0f2fda200b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186568228}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4d3550f0-34e9-5b93-82ae-f29695f07079" :question/problem "Given that $x_{1}$ and $x_{2}$ are the solutions to the equation $\\tan^{2} x = \\frac{16}{81}$ for $0 \\le x < \\pi$, what is the value of $x_{1} \\cdot x_{2}$, rounded to one decimal place?\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true :question/worked-solution "Taking the square root of both sides of the equation, we have\n\n$$\n\\begin{aligned}\\tan^2 x &=\\frac{16}{81} \\\\ \\tan x &=\\pm \\frac{4}{9}\\end{aligned}\n$$\n\nSo, we have to solve the following two equations:\n\n$$\n\\tan x=-\\frac{4}{9}, \\qquad \\tan x=\\frac{4}{9}\n$$\n\nLet's solve each equation separately.\n\n- First, we solve $\\tan x=-\\frac{4}{9}$. The solution for $0\\le x<\\pi$ is $x=\\pi-\\arctan(\\frac{4}{9})$, or $x\\approx 2.723368$.\n- Then, we solve $\\tan x=\\frac{4}{9}$. The solution for $0\\le x<\\pi$ is $x=\\arctan(\\frac{4}{9})$, or $x\\approx 0.418224$.\n\nCombining all solutions from both equations in ascending order, we get\n\n$$\nx_1\\approx 0.418224,\\qquad x_2\\approx 2.723368\n$$\n\nFinally, using the unrounded values,\n\n$$\n\\begin{aligned}x_1\\cdot x_2 &=\\arctan(\\frac{4}{9})\\bigl(\\pi-\\arctan(\\frac{4}{9})\\bigr) \\\\ &\\approx 1.138979 \\\\ &\\approx 1.1\\end{aligned}\n$$\n\nrounded to one decimal place."} {:db/id #edb/ref 17592186568227 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cccb757-a52e-5e29-800e-cbef649558d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.7" :db/id #edb/ref 17592186568220} {:answer/id #uuid "3564fddc-70a9-5c5f-b4f5-a1734844e007" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.2" :db/id #edb/ref 17592186568222} {:answer/id #uuid "74b880c7-45d0-5e9d-98c3-380b410ec885" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.7" :db/id #edb/ref 17592186568230} {:answer/id #uuid "766a6175-39ae-51be-a5d5-6eb89fc57a00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.6" :db/id #edb/ref 17592186568232} {:answer/id #uuid "f7929a52-e616-5133-9ebf-6e0a41d60a8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5" :db/id #edb/ref 17592186568249}] :answer-field/correct {:answer/id #uuid "3564fddc-70a9-5c5f-b4f5-a1734844e007" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.2" :db/id #edb/ref 17592186568222} :answer-field/id #uuid "b857ab3e-cc46-5081-89ca-49ab8c46e4b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186568242}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5f0967de-0e0e-58c5-8767-e2c070bf7b46" :question/problem "Given that $x_{1}$ and $x_{2}$ are the solutions to the equation $\\tan^{2} x = \\frac{1}{4}$ for $0 \\le x < \\pi$, what is the value of $x_{1} \\cdot x_{2}$, rounded to one decimal place?\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true :question/worked-solution "Taking the square root of both sides of the equation, we have\n\n$$\n\\begin{aligned}\\tan^2 x &=\\frac{1}{4} \\\\ \\tan x &=\\pm \\frac{1}{2}\\end{aligned}\n$$\n\nSo, we have to solve the following two equations:\n\n$$\n\\tan x=-\\frac{1}{2}, \\qquad \\tan x=\\frac{1}{2}\n$$\n\nLet's solve each equation separately.\n\n- First, we solve $\\tan x=-\\frac{1}{2}$. The solution for $0\\le x<\\pi$ is $x=\\pi-\\arctan(\\frac{1}{2})$, or $x\\approx 2.677945$.\n- Then, we solve $\\tan x=\\frac{1}{2}$. The solution for $0\\le x<\\pi$ is $x=\\arctan(\\frac{1}{2})$, or $x\\approx 0.463648$.\n\nCombining all solutions from both equations in ascending order, we get\n\n$$\nx_1\\approx 0.463648,\\qquad x_2\\approx 2.677945\n$$\n\nFinally, using the unrounded values,\n\n$$\n\\begin{aligned}x_1\\cdot x_2 &=\\arctan(\\frac{1}{2})\\bigl(\\pi-\\arctan(\\frac{1}{2})\\bigr) \\\\ &\\approx 1.241623 \\\\ &\\approx 1.2\\end{aligned}\n$$\n\nrounded to one decimal place."} {:db/id #edb/ref 17592186568235 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22fb2869-c80b-57fa-bf3f-07702724e466" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.9" :db/id #edb/ref 17592186568219} {:answer/id #uuid "3c12e8ef-90d4-5a67-8a1c-23c0f390179c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.8" :db/id #edb/ref 17592186568224} {:answer/id #uuid "8753ea32-a232-5092-ab7b-4c131e40a820" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.4" :db/id #edb/ref 17592186568234} {:answer/id #uuid "bdb775ec-daab-554d-b749-e01f8d21f2b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.7" :db/id #edb/ref 17592186568243} {:answer/id #uuid "edaa2ef5-274e-51ec-bea4-87f7cd459519" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.9" :db/id #edb/ref 17592186568248}] :answer-field/correct {:answer/id #uuid "8753ea32-a232-5092-ab7b-4c131e40a820" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.4" :db/id #edb/ref 17592186568234} :answer-field/id #uuid "df90002f-c381-56eb-a835-f4b010898e44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186568246}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8c15c682-35d6-59cf-83a9-7b09d89e88ff" :question/problem "Given that $x_{1}$ and $x_{2}$ are the solutions to the equation $\\tan^{2} x = \\frac{81}{4}$ for $0 \\le x < \\pi$, what is the value of $x_{1} \\cdot x_{2}$, rounded to one decimal place?\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true :question/worked-solution "Taking the square root of both sides of the equation, we have\n\n$$\n\\begin{aligned}\\tan^2 x &=\\frac{81}{4} \\\\ \\tan x &=\\pm \\frac{9}{2}\\end{aligned}\n$$\n\nSo, we have to solve the following two equations:\n\n$$\n\\tan x=-\\frac{9}{2}, \\qquad \\tan x=\\frac{9}{2}\n$$\n\nLet's solve each equation separately.\n\n- First, we solve $\\tan x=-\\frac{9}{2}$. The solution for $0\\le x<\\pi$ is $x=\\pi-\\arctan(\\frac{9}{2})$, or $x\\approx 1.789465$.\n- Then, we solve $\\tan x=\\frac{9}{2}$. The solution for $0\\le x<\\pi$ is $x=\\arctan(\\frac{9}{2})$, or $x\\approx 1.352127$.\n\nCombining all solutions from both equations in ascending order, we get\n\n$$\nx_1\\approx 1.352127,\\qquad x_2\\approx 1.789465\n$$\n\nFinally, using the unrounded values,\n\n$$\n\\begin{aligned}x_1\\cdot x_2 &=\\arctan(\\frac{9}{2})\\bigl(\\pi-\\arctan(\\frac{9}{2})\\bigr) \\\\ &\\approx 2.419585 \\\\ &\\approx 2.4\\end{aligned}\n$$\n\nrounded to one decimal place."} {:db/id #edb/ref 17592186568238 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20cb51ce-d9d5-5ade-8df5-068dd693a317" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.7" :db/id #edb/ref 17592186568218} {:answer/id #uuid "48e177dd-ec6c-52ca-a96b-bb78f6f78599" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.6" :db/id #edb/ref 17592186568225} {:answer/id #uuid "a0ac1142-34e9-5a44-99d1-95b47f1d7196" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.8" :db/id #edb/ref 17592186568236} {:answer/id #uuid "ace1d1b1-821a-5e1e-82b7-42153aff7a1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.3" :db/id #edb/ref 17592186568239} {:answer/id #uuid "b672af62-e33e-512e-8b32-97287ca76dbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.8" :db/id #edb/ref 17592186568240}] :answer-field/correct {:answer/id #uuid "ace1d1b1-821a-5e1e-82b7-42153aff7a1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.3" :db/id #edb/ref 17592186568239} :answer-field/id #uuid "383bcf23-2533-5b79-9825-c9f32a85de3d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186568223}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a90d8ac2-fbf6-52cb-9152-6e2839b823ca" :question/problem "Given that $x_{1}$ and $x_{2}$ are the solutions to the equation $\\tan^{2} x = \\frac{64}{9}$ for $0 \\le x < \\pi$, what is the value of $x_{1} \\cdot x_{2}$, rounded to one decimal place?\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true :question/worked-solution "Taking the square root of both sides of the equation, we have\n\n$$\n\\begin{aligned}\\tan^2 x &=\\frac{64}{9} \\\\ \\tan x &=\\pm \\frac{8}{3}\\end{aligned}\n$$\n\nSo, we have to solve the following two equations:\n\n$$\n\\tan x=-\\frac{8}{3}, \\qquad \\tan x=\\frac{8}{3}\n$$\n\nLet's solve each equation separately.\n\n- First, we solve $\\tan x=-\\frac{8}{3}$. The solution for $0\\le x<\\pi$ is $x=\\pi-\\arctan(\\frac{8}{3})$, or $x\\approx 1.929567$.\n- Then, we solve $\\tan x=\\frac{8}{3}$. The solution for $0\\le x<\\pi$ is $x=\\arctan(\\frac{8}{3})$, or $x\\approx 1.212026$.\n\nCombining all solutions from both equations in ascending order, we get\n\n$$\nx_1\\approx 1.212026,\\qquad x_2\\approx 1.929567\n$$\n\nFinally, using the unrounded values,\n\n$$\n\\begin{aligned}x_1\\cdot x_2 &=\\arctan(\\frac{8}{3})\\bigl(\\pi-\\arctan(\\frac{8}{3})\\bigr) \\\\ &\\approx 2.338685 \\\\ &\\approx 2.3\\end{aligned}\n$$\n\nrounded to one decimal place."} {:db/id #edb/ref 17592186568245 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c496924-6993-585b-920c-4f2bd086a8b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.3" :db/id #edb/ref 17592186568217} {:answer/id #uuid "74554212-0cae-591c-b8f5-f2d84dab9d57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.1" :db/id #edb/ref 17592186568229} {:answer/id #uuid "7ce44376-3136-5698-bd44-283fbb93f51c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.8" :db/id #edb/ref 17592186568233} {:answer/id #uuid "a861cdfc-f538-59ee-9d8d-a168901f84fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.3" :db/id #edb/ref 17592186568237} {:answer/id #uuid "c003d69c-d6bd-5b9a-8764-31795bfcc2dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.2" :db/id #edb/ref 17592186568244}] :answer-field/correct {:answer/id #uuid "7ce44376-3136-5698-bd44-283fbb93f51c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.8" :db/id #edb/ref 17592186568233} :answer-field/id #uuid "b7a0541f-4b71-5e02-a12e-190a45bfc6d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186568241}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d3dec242-c170-5258-becc-1d630e0cfadf" :question/problem "Given that $x_{1}$ and $x_{2}$ are the solutions to the equation $\\tan^{2} x = \\frac{64}{81}$ for $0 \\le x < \\pi$, what is the value of $x_{1} \\cdot x_{2}$, rounded to one decimal place?\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true :question/worked-solution "Taking the square root of both sides of the equation, we have\n\n$$\n\\begin{aligned}\\tan^2 x &=\\frac{64}{81} \\\\ \\tan x &=\\pm \\frac{8}{9}\\end{aligned}\n$$\n\nSo, we have to solve the following two equations:\n\n$$\n\\tan x=-\\frac{8}{9}, \\qquad \\tan x=\\frac{8}{9}\n$$\n\nLet's solve each equation separately.\n\n- First, we solve $\\tan x=-\\frac{8}{9}$. The solution for $0\\le x<\\pi$ is $x=\\pi-\\arctan(\\frac{8}{9})$, or $x\\approx 2.414950$.\n- Then, we solve $\\tan x=\\frac{8}{9}$. The solution for $0\\le x<\\pi$ is $x=\\arctan(\\frac{8}{9})$, or $x\\approx 0.726642$.\n\nCombining all solutions from both equations in ascending order, we get\n\n$$\nx_1\\approx 0.726642,\\qquad x_2\\approx 2.414950\n$$\n\nFinally, using the unrounded values,\n\n$$\n\\begin{aligned}x_1\\cdot x_2 &=\\arctan(\\frac{8}{9})\\bigl(\\pi-\\arctan(\\frac{8}{9})\\bigr) \\\\ &\\approx 1.754805 \\\\ &\\approx 1.8\\end{aligned}\n$$\n\nrounded to one decimal place."} {:db/id #edb/ref 17592186569355 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "463e6283-fe84-591f-ab90-92bd3bf2ca2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{183}{4}" :db/id #edb/ref 17592186569359} {:answer/id #uuid "6c313c29-a9fa-50a3-a72f-f9f97ad5fd19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{195}{4}" :db/id #edb/ref 17592186569363} {:answer/id #uuid "735b965c-278e-506b-b743-6b4c5751059a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{187}{4}" :db/id #edb/ref 17592186569364} {:answer/id #uuid "8cdb34af-12c7-5473-9552-03124c9fd7fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{191}{4}" :db/id #edb/ref 17592186569368} {:answer/id #uuid "e2430b00-5c3d-545c-9a17-fff45ac0fc3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{199}{4}" :db/id #edb/ref 17592186569374}] :answer-field/correct {:answer/id #uuid "6c313c29-a9fa-50a3-a72f-f9f97ad5fd19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{195}{4}" :db/id #edb/ref 17592186569363} :answer-field/id #uuid "79552a87-0677-5913-828b-e13c00090e3f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569365}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3510f020-ef92-5354-86ff-374ac770636a" :question/problem "$$\n\\left\\{\\begin{aligned}\\frac{4}{7}x - 4y &=21 \\\\ \\frac{12}{7}x + 4y &=43\\end{aligned}\\right.\n$$\n\nThe solution to the given system of equations is $(x, y)$. What is the value of $\\frac{10}{7}x - 7y$?" :question/requires-calculator false :question/worked-solution "We will solve the system using the elimination method.\n\nNotice that if we multiply the second equation by $1$, then we will get a $4y$ term that can cancel with the $-4y$ term in the first equation:\n\n$$\n\\left\\{\\begin{aligned}\\frac{4}{7}x - 4y &=21 \\\\ \\frac{12}{7}x + 4y &=43 \\quad\\mid\\;\\cdot(1)\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, we obtain\n\n$$\n\\begin{aligned}\\frac{4}{7}x - 4y &= 21 \\\\ \\frac{12}{7}x + 4y &= 43 \\\\ (\\frac{4}{7} + \\frac{12}{7})x &= 64 \\\\ \\frac{16}{7}x &= 64 \\\\ x &= 28\\end{aligned}\n$$\n\nNow, substitute $x = 28$ into one of the original equations to solve for $y$. We'll use the second equation:\n\n$$\n\\begin{aligned}\\frac{12}{7}x + 4y &= 43 \\\\ \\frac{12}{7}(28) + 4y &= 43 \\\\ 48 + 4y &= 43 \\\\ 4y &= -5 \\\\ y &= -\\frac{5}{4}\\end{aligned}\n$$\n\nFinally, we compute $\\frac{10}{7}x - 7y$:\n\n$$\n\\begin{aligned}\\frac{10}{7}x - 7y &= \\frac{10}{7}(28) - 7(-\\frac{5}{4}) \\\\ &= 40 + \\frac{35}{4} \\\\ &= \\frac{160 + 35}{4} \\\\ &= \\frac{195}{4}\\end{aligned}\n$$\n\nHence, the value of $\\frac{10}{7}x - 7y$ is $\\frac{195}{4}$."} {:db/id #edb/ref 17592186569358 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cf76111-b39d-59c4-aac8-32ec7129f3c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186569349} {:answer/id #uuid "37a1d43a-4327-50ee-a106-5d8659e42e58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186569356} {:answer/id #uuid "4d62bdf1-95f4-537d-b3a4-4e2c0d2af737" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186569360} {:answer/id #uuid "c2c4275a-c738-5b78-afdd-1e48ed14aa59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186569370} {:answer/id #uuid "f2abac86-59bd-5280-b8ea-8655fdf535fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186569376}] :answer-field/correct {:answer/id #uuid "c2c4275a-c738-5b78-afdd-1e48ed14aa59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186569370} :answer-field/id #uuid "c814bf37-a436-58d5-ad34-3934aa979755" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569372}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3d3dcfc2-1724-5d2d-8d76-921e18cec113" :question/problem "$$\n\\left\\{\\begin{aligned}\\frac{5}{3}y + 4x &=-22 \\\\ \\frac{1}{6}y - 4x &=0\\end{aligned}\\right.\n$$\n\nThe solution to the given system of equations is $(x, y)$. What is the value of $\\frac{1}{6}y + 6x$?" :question/requires-calculator false :question/worked-solution "We will solve the system using the elimination method.\n\nNotice that if we multiply the second equation by $1$, then we will get a $-4x$ term that can cancel with the $4x$ term in the first equation:\n\n$$\n\\left\\{\\begin{aligned}\\frac{5}{3}y + 4x &=-22 \\\\ \\frac{1}{6}y - 4x &=0 \\quad\\mid\\;\\cdot(1)\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, we obtain\n\n$$\n\\begin{aligned}\\frac{5}{3}y + 4x &= -22 \\\\ \\frac{1}{6}y - 4x &= 0 \\\\ (\\frac{5}{3} + \\frac{1}{6})y &= -22 \\\\ \\frac{11}{6}y &= -22 \\\\ y &= -12\\end{aligned}\n$$\n\nNow, substitute $y = -12$ into one of the original equations to solve for $x$. We'll use the second equation:\n\n$$\n\\begin{aligned}\\frac{1}{6}y - 4x &= 0 \\\\ \\frac{1}{6}(-12) - 4x &= 0 \\\\ -2 - 4x &= 0 \\\\ -4x &= 2 \\\\ x &= -\\frac{1}{2}\\end{aligned}\n$$\n\nFinally, we compute $\\frac{1}{6}y + 6x$:\n\n$$\n\\begin{aligned}\\frac{1}{6}y + 6x &= \\frac{1}{6}(-12) + 6(-\\frac{1}{2}) \\\\ &= -2 - 3 \\\\ &= -5\\end{aligned}\n$$\n\nHence, the value of $\\frac{1}{6}y + 6x$ is $-5$."} {:db/id #edb/ref 17592186569361 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13ae9c99-2ad1-5f9c-a374-4dc5bd0c1ac9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "51" :db/id #edb/ref 17592186569351} {:answer/id #uuid "63e19ad0-ede0-5eab-92f3-f8c8a64b5dc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49" :db/id #edb/ref 17592186569362} {:answer/id #uuid "8b16075f-c179-5916-86c9-62d2d995ace4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186569367} {:answer/id #uuid "c62b87d5-83ca-5c09-8805-9e06d409860f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "47" :db/id #edb/ref 17592186569371} {:answer/id #uuid "e13b6f2c-2b40-531b-8f4d-19b70b293770" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "43" :db/id #edb/ref 17592186569373}] :answer-field/correct {:answer/id #uuid "e13b6f2c-2b40-531b-8f4d-19b70b293770" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "43" :db/id #edb/ref 17592186569373} :answer-field/id #uuid "2e1f7276-d007-5d0d-999b-2556abb43647" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569352}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "529b52a2-e8ec-5d9c-ae2f-4e0f1d414c59" :question/problem "$$\n\\left\\{\\begin{aligned}\\frac{3}{5}y + 2x &=11 \\\\ \\frac{1}{5}y - 2x &=-3\\end{aligned}\\right.\n$$\n\nThe solution to the given system of equations is $(x, y)$. What is the value of $\\frac{19}{5}y + 2x$?" :question/requires-calculator false :question/worked-solution "We will solve the system using the elimination method.\n\nNotice that if we multiply the second equation by $1$, then we will get a $-2x$ term that can cancel with the $2x$ term in the first equation:\n\n$$\n\\left\\{\\begin{aligned}\\frac{3}{5}y + 2x &=11 \\\\ \\frac{1}{5}y - 2x &=-3 \\quad\\mid\\;\\cdot(1)\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, we obtain\n\n$$\n\\begin{aligned}\\frac{3}{5}y + 2x &= 11 \\\\ \\frac{1}{5}y - 2x &= -3 \\\\ (\\frac{3}{5} + \\frac{1}{5})y &= 8 \\\\ \\frac{4}{5}y &= 8 \\\\ y &= 10\\end{aligned}\n$$\n\nNow, substitute $y = 10$ into one of the original equations to solve for $x$. We'll use the second equation:\n\n$$\n\\begin{aligned}\\frac{1}{5}y - 2x &= -3 \\\\ \\frac{1}{5}(10) - 2x &= -3 \\\\ 2 - 2x &= -3 \\\\ -2x &= -5 \\\\ x &= \\frac{5}{2}\\end{aligned}\n$$\n\nFinally, we compute $\\frac{19}{5}y + 2x$:\n\n$$\n\\begin{aligned}\\frac{19}{5}y + 2x &= \\frac{19}{5}(10) + 2(\\frac{5}{2}) \\\\ &= 38 + 5 \\\\ &= 43\\end{aligned}\n$$\n\nHence, the value of $\\frac{19}{5}y + 2x$ is $43$."} {:db/id #edb/ref 17592186569369 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c823551-26e2-5047-95b1-7935b5424578" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-53" :db/id #edb/ref 17592186569347} {:answer/id #uuid "2fc31954-58e3-5b2d-895e-355ade44f008" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-52" :db/id #edb/ref 17592186569353} {:answer/id #uuid "34de7ba9-40ed-5b42-adc6-395740ead635" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-54" :db/id #edb/ref 17592186569354} {:answer/id #uuid "eacf88d2-a7cb-553f-acb9-494acd95de4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-56" :db/id #edb/ref 17592186569375} {:answer/id #uuid "f99bdcdc-46ae-5005-bbfb-70cfdc1ea22d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-55" :db/id #edb/ref 17592186569377}] :answer-field/correct {:answer/id #uuid "f99bdcdc-46ae-5005-bbfb-70cfdc1ea22d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-55" :db/id #edb/ref 17592186569377} :answer-field/id #uuid "0cd1fabf-4b9e-54b9-bbe2-7e26a9c0ab68" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569348}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8ff2d47e-9829-5fb0-94d9-ffdd4e63facb" :question/problem "$$\n\\left\\{\\begin{aligned}\\frac{12}{7}x - 3y &=-46 \\\\ \\frac{4}{7}x + 3y &=-2\\end{aligned}\\right.\n$$\n\nThe solution to the given system of equations is $(x, y)$. What is the value of $\\frac{5}{7}x - 12y$?" :question/requires-calculator false :question/worked-solution "We will solve the system using the elimination method.\n\nNotice that if we multiply the second equation by $1$, then we will get a $3y$ term that can cancel with the $-3y$ term in the first equation:\n\n$$\n\\left\\{\\begin{aligned}\\frac{12}{7}x - 3y &=-46 \\\\ \\frac{4}{7}x + 3y &=-2 \\quad\\mid\\;\\cdot(1)\\end{aligned}\\right.\n$$\n\nWhen we add the two equations, we obtain\n\n$$\n\\begin{aligned}\\frac{12}{7}x - 3y &= -46 \\\\ \\frac{4}{7}x + 3y &= -2 \\\\ (\\frac{12}{7} + \\frac{4}{7})x &= -48 \\\\ \\frac{16}{7}x &= -48 \\\\ x &= -21\\end{aligned}\n$$\n\nNow, substitute $x = -21$ into one of the original equations to solve for $y$. We'll use the second equation:\n\n$$\n\\begin{aligned}\\frac{4}{7}x + 3y &= -2 \\\\ \\frac{4}{7}(-21) + 3y &= -2 \\\\ -12 + 3y &= -2 \\\\ 3y &= 10 \\\\ y &= \\frac{10}{3}\\end{aligned}\n$$\n\nFinally, we compute $\\frac{5}{7}x - 12y$:\n\n$$\n\\begin{aligned}\\frac{5}{7}x - 12y &= \\frac{5}{7}(-21) - 12(\\frac{10}{3}) \\\\ &= -15 - 40 \\\\ &= -55\\end{aligned}\n$$\n\nHence, the value of $\\frac{5}{7}x - 12y$ is $-55$."} {:db/id #edb/ref 17592186569954 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4188061c-4dfe-5f94-b792-4dca2da6c67e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186569532} {:answer/id #uuid "45c85e36-fafb-5cd0-bf93-acbfc1d73fee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186569539} {:answer/id #uuid "68868532-f794-5090-9203-a2b2d0d74f1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5" :db/id #edb/ref 17592186569606} {:answer/id #uuid "b59463e4-063b-5b43-ba22-7b25a136607c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186569732} {:answer/id #uuid "df928123-92fc-5c8f-ae4f-3bf6ff6d7789" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186569798}] :answer-field/correct {:answer/id #uuid "df928123-92fc-5c8f-ae4f-3bf6ff6d7789" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186569798} :answer-field/id #uuid "040b322c-582e-5726-82e2-05dc9e18e0aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569848}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0298a94b-23a5-5b8c-89b1-b11dd1bda638" :question/math-academy-id "q-89150" :question/problem "What is the expected value of one roll of a four-sided die?" :question/worked-solution "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nLet $X$ be the roll of a four-sided die. Then the support is $S=\\{1,2,3,4\\},$ and the corresponding probabilities are all $\\frac{1}{4}:$\n\n$$\nf(1)=f(2)=f(3)=f(4)=\\frac{1}{4}\n$$\n\nSumming up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =1\\cdot f(1)+2\\cdot f(2)++3\\cdot f(3)+4\\cdot f(4) \\\\  & =1(\\frac{1}{4})+2(\\frac{1}{4})+3(\\frac{1}{4})+4(\\frac{1}{4}) \\\\  & =\\frac{1}{4}+\\frac{2}{4}+\\frac{3}{4}+\\frac{4}{4} \\\\  & =\\frac{1+2+3+4}{4} \\\\  & =\\frac{10}{4} \\\\  & =2.5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186569958 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bec36d6-dfb7-5749-9664-f7f73dc25b79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-\\$10$" :db/id #edb/ref 17592186569485} {:answer/id #uuid "2e9bbeaf-98e6-558c-81d6-d0813fc9f4ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-\\$19$" :db/id #edb/ref 17592186569509} {:answer/id #uuid "59a5f4bc-a0cc-5d8a-b1c9-87ca178ebcf7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\$7$" :db/id #edb/ref 17592186569572} {:answer/id #uuid "8e4ee2a5-d371-5586-98ed-838864441766" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\$9$" :db/id #edb/ref 17592186569669} {:answer/id #uuid "b1e0eb6a-bd70-5f35-a14d-f4f095208cc4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-\\$8$" :db/id #edb/ref 17592186569722}] :answer-field/correct {:answer/id #uuid "b1e0eb6a-bd70-5f35-a14d-f4f095208cc4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-\\$8$" :db/id #edb/ref 17592186569722} :answer-field/id #uuid "53865da6-8e44-5bb9-8d40-4d2805caf8a7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569876}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "068e9bc7-6f46-5ac9-a057-d5f4aa9a8aeb" :question/math-academy-id "q-127818" :question/problem "One way to bet in roulette is to place $\\$1$ on a single number. If the ball lands on that number, the player wins $\\$35.$ If the ball lands on any of the other $37$ slots, the player doesn't win. What is the expected profit, rounded to the nearest dollar, for a player who plays one hundred games on number $12$ in a row?" :question/worked-solution "First of all, profit is revenue minus cost, or in our case, winnings minus cost. So, once we have found the expected winnings after one hundred games, we need to subtract $100\\cdot 1=100$ dollars to account for the price of playing.\n\nNow, let's find the expected winnings and summarize them in a table. If $W$ is the winnings (in dollars) on a single game, and $f(w)$ is the probability mass function for $W,$ then we have the following:\n\n| $f(w)$ | $\\frac{1}{38}$ | $\\frac{37}{38}$ |\n| --- | --- | --- |\n| $w$ | $35$ | $0$ |\n\nThe expected value of $W$ is given by\n\n$$\n\\begin{aligned}\\text{E}[W] & =35\\cdot f(35)+0\\cdot f(0) \\\\  & =35(\\frac{1}{38})+0(\\frac{37}{38}) \\\\  & =\\frac{35}{38} \\\\  & ≈0.92.\\end{aligned}\n$$\n\nThis represents the expected winnings for a single game. So, the expected winnings for $100$ games  on number $12$ is\n\n$$\n100\\cdot \\text{E}[W]=100\\cdot (0.92)=92.\n$$\n\nNow, subtracting the $100$ dollars paid to play, we get that the expected profit (in dollars) is\n\n$$\nE[p]=92-100=-8.\n$$"} {:db/id #edb/ref 17592186569964 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70f01508-769b-5ace-9917-5f7722cd7ce8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186569628} {:answer/id #uuid "846fb0c9-3ec1-54f5-b33c-0e023a6c3914" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186569662} {:answer/id #uuid "864177d3-700a-5680-a7ae-fe5e85113f8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186569665} {:answer/id #uuid "c63e937b-281c-584f-875d-739cf8a9c9da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186569758} {:answer/id #uuid "f0214696-0b2a-5443-87e4-6a0873c5d70e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186569822}] :answer-field/correct {:answer/id #uuid "846fb0c9-3ec1-54f5-b33c-0e023a6c3914" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186569662} :answer-field/id #uuid "fce87f54-6287-5426-bb0b-5253c4ba2656" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569953}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1355c292-a399-578d-8bac-2939b3befda0" :question/math-academy-id "q-145039" :question/problem "Consider the polar curve $r={cos}^{2}⁡\\theta$ for $\\theta \\in [0,\\pi ).$ Given that \n\n$$\n{x}^{′}(\\theta )=-3\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta ,\\,{y}^{′}(\\theta )=\\operatorname{cos}⁡\\theta ({cos}^{2}⁡\\theta -2{sin}^{2}⁡\\theta ),\n$$\n\nand ${y}^{′}(\\frac{\\pi }{2})=0,$ which of the following statements are true?\n\nI. ${x}^{′}(\\frac{\\pi }{2})=0$\n\nII. ${lim}_{\\theta \\to (\\pi /2)^{+}}\\frac{\\text{d}y}{\\text{d}x}=-\\infty$\n\nIII. The curve has a vertical tangent at $\\theta =\\frac{\\pi }{2}$" :question/worked-solution "For a given polar curve, there is a vertical tangent at $\\theta ={\\theta }_{0}$ if\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}({\\theta }_{0})}{{x}^{′}({\\theta }_{0})}\n$$\n\nis infinite. This means that\n\n$$\n{y}^{′}({\\theta }_{0})\\ne 0\\,\\text{and}\\,{x}^{′}({\\theta }_{0})=0.\n$$\n\nHowever, if the curve is continuous at ${\\theta }_{0}$ yet the derivative takes the indeterminate form $\\frac{0}{0}$ at this point, we say that the curve has a vertical tangent at this point if\n\n$$\n{lim}_{\\theta \\to {\\theta }_{0}^{-}}\\frac{\\text{d}y}{\\text{d}x}=\\pm \\infty \\,\\text{and}\\,{lim}_{\\theta \\to {\\theta }_{0}^{+}}\\frac{\\text{d}y}{\\text{d}x}=\\pm \\infty .\n$$\n\nIn this case, we're told that ${y}^{′}(\\frac{\\pi }{2})=0.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Substituting $\\theta =\\frac{\\pi }{2}$ into the expression for ${x}^{′}(\\theta ),$ we get\n\n$$\n\\begin{aligned}{x}^{′}(\\frac{\\pi }{2}) & =-3\\operatorname{sin}⁡(\\frac{\\pi }{2}){cos}^{2}⁡(\\frac{\\pi }{2}) \\\\  & =-3\\cdot 1\\cdot 0 \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is true. Computing the limit as $\\theta \\to {(\\frac{\\pi }{2})}^{+},$ we obtain\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (\\pi /2)^{+}}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to (\\pi /2)^{+}}\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & ={lim}_{\\theta \\to (\\pi /2)^{+}}(\\frac{\\operatorname{cos}⁡\\theta ({cos}^{2}⁡\\theta -2{sin}^{2}⁡\\theta )}{-3\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta }) \\\\  & ={lim}_{\\theta \\to (\\pi /2)^{+}}(\\frac{\\cancel{cos}\\theta ({cos}^{2}⁡\\theta -2{sin}^{2}⁡\\theta )}{-3\\operatorname{sin}⁡\\theta {cos}^{\\cancel{2}}⁡\\theta }) \\\\  & ={lim}_{\\theta \\to (\\pi /2)^{+}}(\\frac{{cos}^{2}⁡\\theta -2{sin}^{2}⁡\\theta }{-3\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta }) \\\\  & ={lim}_{\\theta \\to (\\pi /2)^{+}}(\\frac{{cos}^{2}⁡(\\frac{\\pi }{2})-2{sin}^{2}⁡(\\frac{\\pi }{2})}{-3\\operatorname{sin}⁡(\\frac{\\pi }{2})\\operatorname{cos}⁡(\\frac{\\pi }{2})}) \\\\  & =\\frac{0-2\\cdot 1}{-3\\cdot 1\\cdot {0}^{-}} \\\\  & =\\frac{-2}{{0}^{+}} \\\\  & =-\\infty .\\end{aligned}\n$$\n\n- Statement III is true. Using the calculations from part II, we have\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (\\pi /2)^{-}}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to (\\pi /2)^{-}}(\\frac{{cos}^{2}⁡(\\frac{\\pi }{2})-2{sin}^{2}⁡(\\frac{\\pi }{2})}{-3\\operatorname{sin}⁡(\\frac{\\pi }{2})\\operatorname{cos}⁡(\\frac{\\pi }{2})}) \\\\  & =\\frac{0-2\\cdot 1}{-3\\cdot 1\\cdot {0}^{+}} \\\\  & =\\frac{-2}{{0}^{-}} \\\\  & =\\infty .\\end{aligned}\n$$\n\nSince the limits of our derivative are both infinite, there is a vertical tangent to the curve at $\\theta =\\frac{\\pi }{2}.$\n\n![](images/50/50637a502a56fc242ba5d8e2fda59ddc899295d4b14f7ae692869536b95ef661.png)\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186569970 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f39199e8-353c-5632-85b5-146e5d346bc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186569826}] :answer-field/correct {:answer/id #uuid "f39199e8-353c-5632-85b5-146e5d346bc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186569826} :answer-field/id #uuid "4197adf1-104f-52af-a2fe-ce58ae6658aa" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186569869}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "267e0e90-b604-5e86-ad43-795951237ad2" :question/math-academy-id "q-337346" :question/problem "One way to bet in roulette is to place $\\$2$ on a single number. If the ball lands on that number, the player wins $\\$70.$ If the ball lands on any of the other $37$ slots, the player doesn't win. What is the expected profit, rounded to the nearest dollar, for a player who plays one hundred games on number $8$ in a row?\n\nThe expected profit in dollars is $E(p)=$\n{{field-1}}" :question/worked-solution "First of all, profit is revenue minus cost, or in our case, winnings minus cost. So, once we have found the expected winnings after one hundred games, we need to subtract $100\\cdot 2=200$ dollars to account for the price of playing.\n\nNow, let's find the expected winnings and summarize them in a table. If $W$ is the winnings (in dollars) on a single game, and $f(w)$ is the probability mass function for $W,$ then we have the following:\n\n| $f(w)$ | $\\frac{1}{38}$ | $\\frac{37}{38}$ |\n| --- | --- | --- |\n| $w$ | $70$ | $0$ |\n\nThe expected value of $W$ is given by\n\n$$\n\\begin{aligned}\\text{E}[W] & =70\\cdot f(70)+0\\cdot f(0) \\\\  & =70(\\frac{1}{38})+0(\\frac{37}{38}) \\\\  & =\\frac{70}{38} \\\\  & ≈1.84.\\end{aligned}\n$$\n\nThis represents the expected winnings for a single game. So, the expected winnings for $100$ games on number $8$ is\n\n$$\n100\\cdot \\text{E}[W]=100\\cdot (1.84)=184.\n$$\n\nNow, subtracting the $200$ dollars paid to play, we get that the expected profit (in dollars) is\n\n$$\nE[p]=184-200=-16.\n$$"} {:db/id #edb/ref 17592186569974 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e88955e-5bc1-5000-8512-3eeafc61d0f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186569587} {:answer/id #uuid "6238dcb6-e730-5761-a8fc-314e6a8b5732" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186569597} {:answer/id #uuid "751d8865-5818-58ec-a5f2-b7595be506a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186569638} {:answer/id #uuid "a54b68c4-6f83-5b6d-a8d5-c61dfd48387e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186569709} {:answer/id #uuid "bc748a1d-aa55-53b1-8727-38e8aeaf186e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186569744}] :answer-field/correct {:answer/id #uuid "6238dcb6-e730-5761-a8fc-314e6a8b5732" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186569597} :answer-field/id #uuid "d78da839-c447-5f6a-b9f4-52fee3e7c783" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569932}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "29efc143-8ef6-514b-b08b-b09cf3c6dccf" :question/math-academy-id "q-64861" :question/problem "Find the value of $\\operatorname{sin}⁡(\\frac{\\pi }{2}).$" :question/worked-solution "The angle $\\frac{\\pi }{2}$ is a quadrantal angle. Let's draw out the quadrantal angles on the unit circle.\n\n![](images/79/792a778286533d589a3410223aaf197b07e64ea77566042d7bb8ac13fbad9768.png)\n\nFrom the unit circle, we see that the angle $\\frac{\\pi }{2}$ corresponds to the point $(0,1).$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}⁡(\\frac{\\pi }{2})=1.$"} {:db/id #edb/ref 17592186569980 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05ee243d-a0f6-58ea-a3e3-0cc51073be09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{27.42}^{∘}" :db/id #edb/ref 17592186569454} {:answer/id #uuid "6fa4e6b5-7b61-5d05-8391-af677ab50fe6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{26.38}^{∘}" :db/id #edb/ref 17592186569624} {:answer/id #uuid "88480d0d-769a-530a-9275-5454a6d74513" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{23.62}^{∘}" :db/id #edb/ref 17592186569668} {:answer/id #uuid "9914af0e-f526-50f6-98f8-1152e4ec30ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{20.73}^{∘}" :db/id #edb/ref 17592186569688} {:answer/id #uuid "dcd7adc3-cc26-59cb-97d3-e0576be8c6d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{29.38}^{∘}" :db/id #edb/ref 17592186569791}] :answer-field/correct {:answer/id #uuid "6fa4e6b5-7b61-5d05-8391-af677ab50fe6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{26.38}^{∘}" :db/id #edb/ref 17592186569624} :answer-field/id #uuid "264c3506-720d-5be8-870e-eb9352af9f27" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569859}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "39fc3bcb-e781-5ee0-b172-9c69c7f5c440" :question/math-academy-id "q-201" :question/problem "A triangle has sides $a$, $b$, and $c.$ The sides $a$, $b$, and $c$ are of lengths  $9$, $12$, and $18$, respectively. What is the measure of the angle between the sides $b$ and $c?$ Round your answer to two decimal places." :question/worked-solution "The following triangle illustrates the information given.\n\n![](images/de/dede0326d992509dedf1c3a2854b47076ccc48ebf0e07705c8c12762d8ecdead.png)\n\nWe use the Law of Cosines to solve for angle $A:$\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡A & =\\frac{{b}^{2}+{c}^{2}-{a}^{2}}{2bc}.\\end{aligned}\n$$\n\n \n\nHere, we have\n\n$$\na=9,\\,b=12,\\,c=18.\n$$\n\nThis gives \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡A & =\\frac{{12}^{2}+{18}^{2}-{9}^{2}}{2(12)(18)} \\\\  & =\\frac{144+324-81}{432} \\\\  & =\\frac{387}{432}\\end{aligned}\n$$\n\n \nTherefore,\n\n$$\n\\begin{aligned}m∠F & =\\operatorname{arccos}⁡(\\frac{387}{432}) \\\\  & ={26.38}^{∘}\\end{aligned}\n$$\n\nrounded to two decimal places."} {:db/id #edb/ref 17592186569981 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fe0a563-e910-5a09-9b65-423c48c76310" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186569468} {:answer/id #uuid "4ede0597-e201-5e81-953f-0df38ea579f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186569556} {:answer/id #uuid "7a918a37-015b-582f-9559-4c91adb530ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186569645} {:answer/id #uuid "a2b00882-095d-51f2-92e9-ed2560cdc8b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186569701} {:answer/id #uuid "e7f0df0d-c797-5e92-9ea6-b642a07c5dd9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186569813}] :answer-field/correct {:answer/id #uuid "4ede0597-e201-5e81-953f-0df38ea579f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186569556} :answer-field/id #uuid "ca41ebba-af00-5d55-bf09-af4bba36416b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569926}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3f8bf9ef-a3d1-5fa9-97cc-d10fddcf1cd1" :question/math-academy-id "q-144911" :question/problem "Consider the polar curve $r=\\operatorname{sin}⁡\\theta {cos}^{3}⁡\\theta$ for $\\theta \\in [0,\\pi ).$ Given that \n\n$$\n{x}^{′}(\\theta )={cos}^{3}⁡\\theta \\,(5{cos}^{2}⁡\\theta -4),\\,{y}^{′}(\\theta )=\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta (5{cos}^{2}⁡\\theta -3),\n$$\n\nand ${x}^{′}(\\frac{\\pi }{2})=0,$ which of the following statements are true?\n\nI. ${y}^{′}(\\frac{\\pi }{2})=0$\n\nII. ${lim}_{\\theta \\to \\pi /2}\\frac{\\text{d}y}{\\text{d}x}=0$\n\nIII. The curve has a horizontal tangent at $\\theta =\\frac{\\pi }{2}$\n\n*Hint: It is not necessary to use L'Hopital's rule to evaluate the limit in part II.*" :question/worked-solution "When a polar curve is differentiable at a point ${\\theta }_{0}$, there is a horizontal tangent at ${\\theta }_{0}$ if\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}({\\theta }_{0})}{{x}^{′}({\\theta }_{0})}=0\n$$\n\nwhich is equivalent to\n\n$$\n{y}^{′}({\\theta }_{0})=0\\,\\text{and}\\,{x}^{′}({\\theta }_{0})\\ne 0.\n$$\n\nHowever, if the curve is continuous at ${\\theta }_{0}$ yet the derivative ${y}^{′}(x)$ takes the indeterminate form $\\frac{0}{0}$ at this point, we say that the curve has a horizontal tangent at this point if\n\n$$\n{lim}_{\\theta \\to {\\theta }_{0}}\\frac{\\text{d}y}{\\text{d}x}=0.\n$$\n\nIn this case, we're told that ${x}^{′}(\\frac{\\pi }{2})=0.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Substituting $\\theta =\\frac{\\pi }{2}$ into the expression for ${y}^{′}(\\theta ),$ we get\n\n$$\n\\begin{aligned}{y}^{′}(\\frac{\\pi }{2}) & =\\operatorname{sin}⁡(\\frac{\\pi }{2}){cos}^{2}⁡(\\frac{\\pi }{2})(5{cos}^{2}⁡(\\frac{\\pi }{2})-3) \\\\  & =1\\cdot 0\\cdot (5\\cdot 0-3) \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is false. Computing the limit as $\\theta \\to \\frac{\\pi }{2},$ we obtain\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to \\pi /2}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to \\pi /2}\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta \\,(5{cos}^{2}⁡\\theta -3)}{{cos}^{3}⁡\\theta \\,(5{cos}^{2}⁡\\theta -4)}) \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{\\operatorname{sin}⁡\\theta {\\cancel{cos}}^{2}\\theta \\,(5{cos}^{2}⁡\\theta -3)}{{cos}^{\\cancel{3}}⁡\\theta \\,(5{cos}^{2}⁡\\theta -4)}) \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{\\operatorname{sin}⁡\\theta \\,(5{cos}^{2}⁡\\theta -3)}{\\operatorname{cos}⁡\\theta \\,(5{cos}^{2}⁡\\theta -4)}) \\\\  & =\\frac{1\\cdot (5\\cdot 0-3)}{0\\cdot (5\\cdot 0-4)} \\\\  & =\\frac{-3}{0} \\\\  & \\ne 0.\\end{aligned}\n$$\n\n- Statement III is false. Since the limit in part II does *not* equal to $0,$ there curve does *not* have a horizontal tangent at $\\theta =\\frac{\\pi }{2}.$ In fact, it is a vertical tangent.\n\n![](images/d7/d7881ba860bcc32301a162eb200ea9075b06b63c780be74c14aedbcb1654eaaa.png)\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186569983 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3a5e633-756d-5e3a-8fa9-0ed6225a69ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186569705}] :answer-field/correct {:answer/id #uuid "a3a5e633-756d-5e3a-8fa9-0ed6225a69ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186569705} :answer-field/id #uuid "55e2ebfb-2990-504c-a3b7-16d650b15125" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186569877}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "41c4d9f2-fb24-5742-893b-e72bc5478b30" :question/math-academy-id "q-276300" :question/problem "A quality control manager at a warehouse inspects electronic boxes for defective items. The number of faulty items in each box was recorded and summarized below. If $X$ is the number of faulty items in a box, what is the expected value of $X?$\n\n| Number of Boxes | $13$ | $6$ | $4$ | $2$ |\n| --- | --- | --- | --- | --- |\n| Faulty Items | $0$ | $1$ | $2$ | $3$ |\n\n$\\text{E}[X]=$\n{{field-1}}" :question/worked-solution "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nWe're given the frequencies of the faulty items, so we can start by computing the corresponding probabilities. The total number of boxes is $13+6+4+2=25,$ so the corresponding probabilities are as follows:\n\n$$\n\\begin{aligned}P(X=0)=f(0) & =\\frac{13}{25} \\\\ P(X=1)=f(1) & =\\frac{6}{25} \\\\ P(X=2)=f(2) & =\\frac{4}{25} \\\\ P(X=3)=f(3) & =\\frac{2}{25}\\end{aligned}\n$$\n\nWe organize these results in the table below.\n\n| $x$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $\\frac{13}{25}$ | $\\frac{6}{25}$ | $\\frac{4}{25}$ | $\\frac{2}{25}$ |\n\nNow, summing up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =0\\cdot f(0)+1\\cdot f(1)+2\\cdot f(2)+3\\cdot f(3) \\\\  & =0(\\frac{13}{25})+1(\\frac{6}{25})+2(\\frac{4}{25})+3(\\frac{2}{25}) \\\\  & =\\frac{6}{25}+\\frac{8}{25}+\\frac{6}{25} \\\\  & =\\frac{6+8+6}{25} \\\\  & =\\frac{20}{25} \\\\  & =\\frac{4}{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186569984 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a977656-5bc0-52c2-8412-7159dca353b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186569523} {:answer/id #uuid "4727a762-fdee-5b8f-ab0a-5ac69d4cf5e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186569541} {:answer/id #uuid "6aeed908-a161-5da2-adf1-5808f16f101a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186569612} {:answer/id #uuid "71bfc73a-a14f-5c8b-a23c-4a17d56fd53e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186569630} {:answer/id #uuid "ccbdc6ea-8277-599f-9f2d-8846ff5d253b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186569768}] :answer-field/correct {:answer/id #uuid "ccbdc6ea-8277-599f-9f2d-8846ff5d253b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186569768} :answer-field/id #uuid "0d1259d7-7153-5c05-8443-bfcd08dbb965" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569850}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "42a89ddb-b42b-5afd-9218-01f794cbc72e" :question/math-academy-id "q-67501" :question/problem "Which of the three sequences below are geometric sequences?\n\nI. $\\frac{1}{4},\\,\\frac{1}{2},\\,2,\\,…$\n\nII. ${a}_{n+1}=\\frac{3}{2}{a}_{n},\\,{a}_{1}=-1,\\,n\\ge 1$\n\nIII. $1,\\,0.2,\\,0.03,\\,…$" :question/worked-solution "A sequence is geometric if there is a common ratio between its terms. Let's check each sequence in turn.\n\n- Sequence I is not a geometric sequence because not every pair of consecutive terms has the same ratio. To see this, we only need to go up to the third term:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}}=\\frac{(\\frac{1}{2})}{(\\frac{1}{4})} & =2 \\\\ \\frac{{a}_{3}}{{a}_{2}}=\\frac{2}{(\\frac{1}{2})} & =4\\end{aligned}\n$$\n\n- Sequence II is a geometric sequence. The recursive rule ${a}_{n+1}=\\frac{3}{2}{a}_{n}$ tells us that each term is $\\frac{3}{2}$ times the previous term, so the common ratio is $r=\\frac{3}{2}.$\n\n- Sequence III is not a geometric sequence because not every pair of consecutive terms has the same ratio. To see this, we only need to go up to the third term:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}}=\\frac{0.2}{1} & =0.2 \\\\ \\frac{{a}_{3}}{{a}_{2}}=\\frac{0.03}{0.2} & =0.15\\end{aligned}\n$$\n\nIn conclusion, only sequence II is a geometric sequence."} {:db/id #edb/ref 17592186569987 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "290464f7-629a-599f-9619-f15eb5786d1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.5" :db/id #edb/ref 17592186569498} {:answer/id #uuid "51e0957a-5bf2-56a2-93c7-c85dbc288c19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.5" :db/id #edb/ref 17592186569563} {:answer/id #uuid "5b73964e-ee01-5caf-b596-26a1127dfc1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186569576} {:answer/id #uuid "9d79ce2e-0688-5dfd-92d7-ae8f08fcc6bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186569694} {:answer/id #uuid "f7a0885c-49d2-5c12-bd6c-2ba68d197915" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186569831}] :answer-field/correct {:answer/id #uuid "5b73964e-ee01-5caf-b596-26a1127dfc1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186569576} :answer-field/id #uuid "850858f3-9f08-5b6d-b191-4d25dc883811" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569893}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "522d89ff-41d6-50ec-8d1b-a4ada325fbc8" :question/math-academy-id "q-83981" :question/problem "A stack contains four cards, where each card is labeled $1$, $4$, $6$, or $9.$ If one card is randomly drawn, what is its expected value?" :question/worked-solution "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nLet $X$ be the label on a randomly drawn card. Then the support is $S=\\{1,4,6,9\\},$ and the corresponding probabilities are all $\\frac{1}{4}:$\n\n$$\nf(1)=f(4)=f(6)=f(9)=\\frac{1}{4}\n$$\n\nSumming up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =1\\cdot f(1)+4\\cdot f(4)+6\\cdot f(6)+9\\cdot f(9) \\\\  & =1(\\frac{1}{4})+4(\\frac{1}{4})+6(\\frac{1}{4})+9(\\frac{1}{4}) \\\\  & =\\frac{1}{4}+\\frac{4}{4}+\\frac{6}{4}+\\frac{9}{4} \\\\  & =\\frac{1+4+6+9}{4} \\\\  & =\\frac{20}{4} \\\\  & =5\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186569988 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a55a640-5056-53aa-a01c-37549144e131" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{43}{32}" :db/id #edb/ref 17592186569544} {:answer/id #uuid "69532553-7c14-5c9e-8f67-52df69fbcb70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{19}{8}" :db/id #edb/ref 17592186569607} {:answer/id #uuid "a4821310-860e-5fda-9174-3a8a5f122a83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{53}{8}" :db/id #edb/ref 17592186569707} {:answer/id #uuid "ba42e326-790d-5ce1-a2d5-97a6580a41b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{43}{16}" :db/id #edb/ref 17592186569739} {:answer/id #uuid "ba66511f-5970-5a6f-9b8a-e517905c7f12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{43}{8}" :db/id #edb/ref 17592186569741}] :answer-field/correct {:answer/id #uuid "ba66511f-5970-5a6f-9b8a-e517905c7f12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{43}{8}" :db/id #edb/ref 17592186569741} :answer-field/id #uuid "57adae38-47d4-5119-8e1b-753ad3c2f4c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569879}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "53e1317a-3ae2-58ac-bb4d-59a740997145" :question/math-academy-id "q-127259" :question/problem "The rolls of an unfair octahedral die follow the probability mass function $f(x)$ as shown in the table below. What is the expected value of one roll of the die?\n\n| $x$ | $1$ | $2$ | $3$ | $4$ | $5$ | $6$ | $7$ | $8$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{8}$ | $\\frac{1}{16}$ | $\\frac{1}{16}$ | $\\frac{3}{32}$ | $\\frac{1}{8}$ | $\\frac{1}{32}$ | $\\frac{1}{4}$ | $\\frac{1}{4}$ |" :question/worked-solution "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nSumming up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =1\\cdot f(1)+2\\cdot f(2)+3\\cdot f(3)+4\\cdot f(4)+5\\cdot f(5)+6\\cdot f(6) \\\\  & =1(\\frac{1}{8})+2(\\frac{1}{16})+3(\\frac{1}{16})+4(\\frac{3}{32})+5(\\frac{1}{8})+6(\\frac{1}{32})+7(\\frac{1}{4})+8(\\frac{1}{4}) \\\\  & =\\frac{1}{8}+\\frac{2}{16}+\\frac{3}{16}+\\frac{12}{32}+\\frac{5}{8}+\\frac{6}{32}+\\frac{7}{4}+\\frac{8}{4} \\\\  & =\\frac{4}{32}+\\frac{4}{32}+\\frac{6}{32}+\\frac{12}{32}+\\frac{20}{32}+\\frac{6}{32}+\\frac{56}{32}+\\frac{64}{32} \\\\  & =\\frac{4+4+6+12+20+6+56+64}{32} \\\\  & =\\frac{172}{32} \\\\  & =\\frac{43}{8}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186569996 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08429320-9580-541b-a6d9-31a45aa346b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186569459} {:answer/id #uuid "42d752c4-1ced-5442-9d14-2e028d4482e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186569535} {:answer/id #uuid "5b0f6439-02a9-5ffc-b967-796d14fd99c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186569575} {:answer/id #uuid "a04922be-e134-5966-b10b-e756217fb61e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186569698} {:answer/id #uuid "b00a2584-97c8-50c5-81c4-5f4529530f60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186569719}] :answer-field/correct {:answer/id #uuid "08429320-9580-541b-a6d9-31a45aa346b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186569459} :answer-field/id #uuid "2ba2b05c-984d-5188-ba82-e7eff754bb83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569861}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5dc0c374-75b0-5038-a236-6349d3712634" :question/math-academy-id "q-23418" :question/problem "Find the value of $\\operatorname{sec}⁡(\\frac{\\pi }{2}).$" :question/worked-solution "The angle $\\frac{\\pi }{2}$ is a quadrantal angle. Let's draw out the quadrantal angles on the unit circle.\n\n![](images/79/792a778286533d589a3410223aaf197b07e64ea77566042d7bb8ac13fbad9768.png)\n\nFrom the unit circle, we see that the angle $\\frac{\\pi }{2}$ corresponds to the point $(0,1).$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}⁡(\\frac{\\pi }{2})=0.$\n\nTherefore, using the fact that $\\operatorname{sec}⁡\\theta =\\frac{1}{\\operatorname{cos}⁡\\theta },$ we have\n\n$$\n\\operatorname{sec}⁡(\\frac{\\pi }{2})=\\frac{1}{\\operatorname{cos}⁡(\\frac{\\pi }{2})}=\\frac{1}{0}.\n$$\n\nHowever, division by zero is undefined. Therefore, $\\operatorname{sec}⁡(\\frac{\\pi }{2})$ is undefined."} {:db/id #edb/ref 17592186569999 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee3a7f8d-4e6d-583c-9448-f641c8a25567" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{9}" :db/id #edb/ref 17592186569820}] :answer-field/correct {:answer/id #uuid "ee3a7f8d-4e6d-583c-9448-f641c8a25567" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{9}" :db/id #edb/ref 17592186569820} :answer-field/id #uuid "eff3eb79-2efb-59dd-8b16-b566385dd9e7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186569947}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6f220269-fce2-5308-a544-a882143be2b5" :question/math-academy-id "q-337038" :question/problem "The number of heads facing upward after tossing $3$ unfair coins follows the probability mass function $f(x)$ shown in the table below. What is the expected value of the number of heads facing upward after tossing the $3$ coins? Do not round the answer.\n\n| $x$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $\\frac{2}{9}$ | $\\frac{1}{3}$ | $\\frac{1}{9}$ | $\\frac{1}{3}$ |\n\n$\\text{E}[X]=$\n{{field-1}}" :question/worked-solution "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nSumming up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =0\\cdot f(0)+1\\cdot f(1)+2\\cdot f(2)+3\\cdot f(3) \\\\  & =0(\\frac{2}{9})+1(\\frac{1}{3})+2(\\frac{1}{9})+3(\\frac{1}{3}) \\\\  & =0+\\frac{1}{3}+\\frac{2}{9}+1 \\\\  & =0+\\frac{3}{9}+\\frac{2}{9}+\\frac{9}{9} \\\\  & =\\frac{0+3+2+9}{9} \\\\  & =\\frac{14}{9}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186570000 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ce3784e-cee7-5852-894c-71ed7ce007ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186569465} {:answer/id #uuid "5c751fdf-2bec-56e1-938d-e60711842729" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.4" :db/id #edb/ref 17592186569578} {:answer/id #uuid "6e02a023-2534-54ea-a95d-0e9b379d35c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.6" :db/id #edb/ref 17592186569619} {:answer/id #uuid "a90215ce-141d-5583-8efd-be89ae2f0bed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.8" :db/id #edb/ref 17592186569713} {:answer/id #uuid "ede15bcc-7345-509e-8ca3-6f297ed035d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186569818}] :answer-field/correct {:answer/id #uuid "5c751fdf-2bec-56e1-938d-e60711842729" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.4" :db/id #edb/ref 17592186569578} :answer-field/id #uuid "dd980177-3d4f-5c6d-a6cb-2c5b9aaa3857" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569935}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "700fffbb-cd63-5378-9077-32b4c2add6e6" :question/math-academy-id "q-84067" :question/problem "Several children were asked how many siblings they have. The number of siblings of each child was recorded below. If $X$ is the number of siblings of a randomly selected child, what is the expected value of $X?$\n\n| Number of siblings | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- |\n| Number of Children | $1$ | $5$ | $3$ | $1$ |" :question/worked-solution "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nWe're given the frequencies of the number of siblings, so we can start by computing the corresponding probabilities. The total number of children is $1+5+3+1=10,$ so the corresponding probabilities are as follows:\n\n$$\n\\begin{aligned}P(X=0)=f(0) & =\\frac{1}{10} \\\\ P(X=1)=f(1) & =\\frac{5}{10}=\\frac{1}{2} \\\\ P(X=2)=f(2) & =\\frac{3}{10} \\\\ P(X=3)=f(3) & =\\frac{1}{10}\\end{aligned}\n$$\n\nWe organize these results in the table below.\n\n| $x$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{10}$ | $\\frac{1}{2}$ | $\\frac{3}{10}$ | $\\frac{1}{10}$ |\n\nNow, summing up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =0\\cdot f(0)+1\\cdot f(1)+2\\cdot f(2)+3\\cdot f(3) \\\\  & =0(\\frac{1}{10})+1(\\frac{1}{2})+2(\\frac{3}{10})+3(\\frac{1}{10}) \\\\  & =0+\\frac{5}{10}+\\frac{6}{10}+\\frac{3}{10} \\\\  & =\\frac{0+5+6+3}{10} \\\\  & =\\frac{14}{10} \\\\  & =1.4\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186570006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53773b9d-b41d-57fa-9993-8ee73ebf788b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186569565} {:answer/id #uuid "64bcca0d-1370-5e1e-9384-b9fe6e5c2226" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186569599} {:answer/id #uuid "74903b10-b9c3-5982-a77c-38ecc70f9cf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186569636} {:answer/id #uuid "9ba3a52b-1145-5782-88c9-4be78cb79a7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186569691} {:answer/id #uuid "e4bf7c3d-ba90-54f4-a876-93efb8156cca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186569807}] :answer-field/correct {:answer/id #uuid "9ba3a52b-1145-5782-88c9-4be78cb79a7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186569691} :answer-field/id #uuid "e8f8080f-0b51-545f-9d71-93e2c857b6d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569943}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "857b63a1-09cd-5ba9-9404-4c37877c9864" :question/math-academy-id "q-79511" :question/problem "What is the $4$th term of the geometric sequence given below?\n\n$$\n{a}_{n+1}=-6{a}_{n},\\,{a}_{1}=\\frac{1}{36},\\,n\\ge 1\n$$" :question/worked-solution "We use the recursive formula to compute the terms of the sequence up to the $4$th term:\n\n$$\n\\begin{aligned}{a}_{1} & =\\frac{1}{36} \\\\ {a}_{2} & =-6{a}_{1}=-6(\\frac{1}{36})=-\\frac{1}{6} \\\\ {a}_{3} & =-6{a}_{2}=-6(-\\frac{1}{6})=1 \\\\ {a}_{4} & =-6{a}_{3}=-6(1)=-6\\end{aligned}\n$$\n\nTherefore, ${a}_{4}=-6.$"} {:db/id #edb/ref 17592186570012 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e15daab7-6b24-5c89-8928-f0f9fcd1b856" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186569803}] :answer-field/correct {:answer/id #uuid "e15daab7-6b24-5c89-8928-f0f9fcd1b856" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186569803} :answer-field/id #uuid "36c5b657-8ae8-52f1-9b50-9850b824e02a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186569866}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9cdf7c4f-4409-57f0-b1eb-dca5de834f65" :question/math-academy-id "q-276297" :question/problem "A fair spinner has six sides labeled with the numbers $-2,$ $-1,$ $0,$ $1,$ $2,$ and $3.$ If the spinner is spun, what is the expected value of the outcome?\n\n$\\text{E}[X]=$\n{{field-1}}" :question/worked-solution "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nLet $X$ be the outcome of the spinner. Then the support is $S=\\{-2,-1,0,1,2,3\\},$ and the corresponding probabilities are all $\\frac{1}{6}:$\n\n$$\nf(-2)=f(-1)=f(0)=f(1)=f(2)=f(3)=\\frac{1}{6}\n$$\n\nSumming up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =-2\\cdot f(-2)+(-1)\\cdot f(-1)+0\\cdot f(0)+1\\cdot f(1)+2\\cdot f(2)+3\\cdot f(3) \\\\  & =-2(\\frac{1}{6})+(-1)(\\frac{1}{6})+0(\\frac{1}{6})+1(\\frac{1}{6})+2(\\frac{1}{6})+3(\\frac{1}{6}) \\\\  & =-\\frac{2}{6}-\\frac{1}{6}+0+\\frac{1}{6}+\\frac{2}{6}+\\frac{3}{6} \\\\  & =\\frac{-2-1+0+1+2+3}{6} \\\\  & =\\frac{3}{6} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186570013 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "183e7e96-ee7e-5850-a1bf-75f30a215f0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{39.81}^{∘}" :db/id #edb/ref 17592186569480} {:answer/id #uuid "5a328bb2-83f5-57f5-b38d-f472331c7c17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{33.56}^{∘}" :db/id #edb/ref 17592186569573} {:answer/id #uuid "6c4ac95c-8556-5fbf-965a-0eb4c8e0345a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{36.44}^{∘}" :db/id #edb/ref 17592186569616} {:answer/id #uuid "84465da0-5d9b-563a-a817-64751d321a8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{44.26}^{∘}" :db/id #edb/ref 17592186569661} {:answer/id #uuid "fa7753a4-af15-5a0d-94f5-f6eecf8f7ddb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{28.18}^{∘}" :db/id #edb/ref 17592186569834}] :answer-field/correct {:answer/id #uuid "5a328bb2-83f5-57f5-b38d-f472331c7c17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{33.56}^{∘}" :db/id #edb/ref 17592186569573} :answer-field/id #uuid "5f77438e-6a65-5147-9492-745b947b2082" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569882}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9ede5978-9720-5b14-aefb-d172677e353f" :question/math-academy-id "q-14701" :question/problem "![](images/40/40ee0a065e8733bd1ab22c04af39b358da5106791af6b99017cef1d07c13abcd.png)\n\nFor the triangle above, find $m∠A$ in degrees to two decimal places." :question/worked-solution "We use the Law of Cosines to solve for angle $A:$\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡A &=\\frac{{b}^{2}+{c}^{2}-{a}^{2}}{2bc}.\\end{aligned}\n$$\n\nHere, we have\n\n$$\na=5,\\,b=8,\\,c=9.\n$$\n\nThis gives\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡A & =\\frac{{9}^{2}+{8}^{2}-{5}^{2}}{2(9)(8)} \\\\  & =\\frac{81+64-25}{144} \\\\  & =\\frac{120}{144} \\\\  & =\\frac{5}{6}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}m∠A & =\\operatorname{arccos}⁡(\\frac{5}{6}) \\\\  & ={33.56}^{∘}\\end{aligned}\n$$\n\nrounded to two decimal places."} {:db/id #edb/ref 17592186570016 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "742dc51a-8d96-560e-94d1-367169dd0392" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186569634} {:answer/id #uuid "c42187b6-4c29-5b59-b6f3-624ff226be39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186569750} {:answer/id #uuid "d8c3238c-1f70-547d-9e2f-c99ec90befda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186569784} {:answer/id #uuid "e1476574-57fd-5884-b17f-d8c6e1916591" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186569802} {:answer/id #uuid "fb85d25b-c824-57bd-a2e9-670821d95958" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186569839}] :answer-field/correct {:answer/id #uuid "742dc51a-8d96-560e-94d1-367169dd0392" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186569634} :answer-field/id #uuid "4b4c2f95-49e5-5e7b-9fbf-f50c23d0825b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569873}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a72cce3a-417b-593f-a3ca-475feb70703d" :question/math-academy-id "q-144906" :question/problem "Consider the polar curve $r=4{sin}^{2}⁡\\theta {cos}^{3}⁡\\theta$ for $\\theta \\in [0,\\pi ).$ Given that \n\n$$\n{x}^{′}(\\theta )=8\\operatorname{sin}⁡\\theta {cos}^{3}⁡\\theta \\,(3{cos}^{2}⁡\\theta -2),\\,{y}^{′}(\\theta )=3{sin}^{2}⁡(2\\theta )\\operatorname{cos}⁡(2\\theta ),\n$$\n\nand ${x}^{′}(\\frac{\\pi }{2})=0,$ which of the following statements are true?\n\nI. ${y}^{′}(\\frac{\\pi }{2})$ is undefined\n\nII. ${lim}_{\\theta \\to \\pi /2}\\frac{\\text{d}y}{\\text{d}x}=0$\n\nIII. The curve has a horizontal tangent at $\\theta =\\frac{\\pi }{2}$\n\n*Hint: It is not necessary to use L'Hopital's rule to evaluate the limit in part II.*" :question/worked-solution "When a polar curve is differentiable at a point ${\\theta }_{0}$, there is a horizontal tangent at ${\\theta }_{0}$ if\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}({\\theta }_{0})}{{x}^{′}({\\theta }_{0})}=0\n$$\n\nwhich is equivalent to\n\n$$\n{y}^{′}({\\theta }_{0})=0\\,\\text{and}\\,{x}^{′}({\\theta }_{0})\\ne 0.\n$$\n\nHowever, if the curve is continuous at ${\\theta }_{0}$ yet the derivative ${y}^{′}(x)$ takes the indeterminate form $\\frac{0}{0}$ at this point, we say that the curve has a horizontal tangent at this point if\n\n$$\n{lim}_{\\theta \\to {\\theta }_{0}}\\frac{\\text{d}y}{\\text{d}x}=0.\n$$\n\nIn this case, we're told that ${x}^{′}(\\frac{\\pi }{2})=0.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. Substituting $\\theta =\\frac{\\pi }{2}$ into the expression for ${y}^{′}(\\theta ),$ we get\n\n$$\n\\begin{aligned}{y}^{′}(\\frac{\\pi }{2}) & =3{sin}^{2}⁡(2\\cdot \\frac{\\pi }{2})\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{2}) \\\\  & =3\\operatorname{sin}⁡(\\pi )\\operatorname{cos}⁡(\\pi ) \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is false. Computing the limit as $\\theta \\to \\frac{\\pi }{2},$ we obtain\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to \\pi /2}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to \\pi /2}\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{3{sin}^{2}⁡(2\\theta )\\operatorname{cos}⁡(2\\theta )}{8\\operatorname{sin}⁡\\theta {cos}^{3}⁡\\theta \\,(3{cos}^{2}⁡\\theta -2)}) \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{12{sin}^{2}⁡(\\theta ){cos}^{2}⁡(\\theta )\\operatorname{cos}⁡(2\\theta )}{8\\operatorname{sin}⁡\\theta {cos}^{3}⁡\\theta \\,(3{cos}^{2}⁡\\theta -2)}) \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{12{sin}^{\\cancel{2}}⁡(\\theta ){\\cancel{cos}}^{2}(\\theta )\\operatorname{cos}⁡(2\\theta )}{8\\cancel{sin}\\theta {cos}^{\\cancel{3}}⁡\\theta \\,(3{cos}^{2}⁡\\theta -2)}) \\\\  & =\\frac{12\\operatorname{sin}⁡(\\theta )\\operatorname{cos}⁡(2\\theta )}{8\\operatorname{cos}⁡\\theta \\,(3{cos}^{2}⁡\\theta -2)} \\\\  & =\\frac{12\\operatorname{sin}⁡(\\frac{\\pi }{2})\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{2})}{8\\operatorname{cos}⁡(\\frac{\\pi }{2})(3{cos}^{2}⁡(\\frac{\\pi }{2})-2)} \\\\  & =\\frac{12\\cdot 1\\cdot (-1)}{0\\cdot (3\\cdot 0-2)} \\\\  & =\\frac{-12}{0} \\\\  & \\ne 0.\\end{aligned}\n$$\n\n- Statement III is false. Since the limit in part II does *not* equal to $0,$ there curve does *not* have a horizontal tangent at $\\theta =\\frac{\\pi }{2}.$ In fact, it is a vertical tangent.\n\n![](images/32/32a586a1fe160a6c3a2cfee3cfb78af3d596679cf40abedeb0b8d622a3cf736c.png)\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186570023 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f48698d2-8399-5591-8858-d21e6e33a4a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{2}" :db/id #edb/ref 17592186569827}] :answer-field/correct {:answer/id #uuid "f48698d2-8399-5591-8858-d21e6e33a4a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{2}" :db/id #edb/ref 17592186569827} :answer-field/id #uuid "e295c467-cba5-5269-8303-2482a80e3bd4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186569937}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ceddea1b-a5cb-5c22-91ab-6571fb7ef388" :question/math-academy-id "q-337204" :question/problem "A stack of cards has $2$ cards labeled with four and $6$ cards labeled with ten. If one card is randomly drawn from the stack, what is its expected value?\n\n$\\text{E}[X]=$\n{{field-1}}" :question/worked-solution "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nLet $X$ be the value labeled on a randomly drawn card. Then the support is $S=\\{4,10\\}.$\n\nIn the stack there are $2$ cards labeled with four and $6$ cards labeled with ten (eight cards in total), so the probabilities are as follows:\n\n$$\n\\begin{aligned}P(4) & =\\frac{2}{8}=\\frac{1}{4} \\\\ P(10) & =\\frac{6}{8}=\\frac{3}{4}\\end{aligned}\n$$\n\nSumming up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =4\\cdot f(4)+10\\cdot f(10) \\\\  & =4(\\frac{1}{4})+10(\\frac{3}{4}) \\\\  & =1+\\frac{15}{2} \\\\  & =\\frac{17}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186570027 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2225633-3982-500e-aceb-598ad2c9dd69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186569723} {:answer/id #uuid "d59e1f90-02b8-5b16-90e7-10a8e98457fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{3}}" :db/id #edb/ref 17592186569778} {:answer/id #uuid "da706140-bf28-56bb-9b3d-9c80fbbb5352" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186569787} {:answer/id #uuid "dbf553dd-432a-5db7-9330-1fe86b00d67e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2\\sqrt{3}}{3}" :db/id #edb/ref 17592186569790} {:answer/id #uuid "f93b95d6-53f4-5c55-b1c0-20f5b8ed7c69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{\\sqrt{2}}" :db/id #edb/ref 17592186569832}] :answer-field/correct {:answer/id #uuid "dbf553dd-432a-5db7-9330-1fe86b00d67e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2\\sqrt{3}}{3}" :db/id #edb/ref 17592186569790} :answer-field/id #uuid "9ad166a8-68f6-52e5-aeab-c9f3b40cf4fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569905}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d25800d2-aaa9-5069-8bc6-84b04968eef5" :question/math-academy-id "q-1696" :question/problem "$\\operatorname{sec}⁡(\\frac{7\\pi }{6})=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{7\\pi }{6}$ corresponds to the point $(-\\frac{\\sqrt{3}}{2},-\\frac{1}{2}).$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}⁡(\\frac{7\\pi }{6})=-\\frac{\\sqrt{3}}{2}.$\n\nTherefore, using the fact that $\\operatorname{sec}⁡\\theta =\\frac{1}{\\operatorname{cos}⁡\\theta },$ we have\n\n$$\n\\operatorname{sec}⁡(\\frac{7\\pi }{6})=\\frac{1}{\\operatorname{cos}⁡(\\frac{7\\pi }{6})}=-\\frac{2}{\\sqrt{3}}=-\\frac{2\\sqrt{3}}{3}.\n$$"} {:db/id #edb/ref 17592186570029 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a02737d-84cc-5b65-a38a-d8f95f1427b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.25" :db/id #edb/ref 17592186569500} {:answer/id #uuid "7566e7ed-5b8d-55f6-bcd8-3e0711ba276d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.75" :db/id #edb/ref 17592186569639} {:answer/id #uuid "93cd1bc1-ffd4-50f6-955c-6bee087d74b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186569675} {:answer/id #uuid "c5540b63-e212-55cb-b7a9-7c7a2846f551" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5" :db/id #edb/ref 17592186569755} {:answer/id #uuid "c95ceba2-efcb-54f1-bc4a-d6b2a95fef1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186569764}] :answer-field/correct {:answer/id #uuid "2a02737d-84cc-5b65-a38a-d8f95f1427b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.25" :db/id #edb/ref 17592186569500} :answer-field/id #uuid "618772c4-492e-57e3-9e76-dc9f3ada338c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569885}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d599b4ec-9437-5cdd-aa0b-91b4481a6586" :question/math-academy-id "q-89157" :question/problem "Several households were asked the number of children that lived there. The number of children in each was recorded below. If $X$ is the number of children that live at a randomly selected household, what is the expected value of $X?$\n\n| Number of Children | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- |\n| Number of Households | $6$ | $9$ | $6$ | $3$ |" :question/worked-solution "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nWe're given the frequencies of the number of childen, so we can start by computing the corresponding probabilities. The total number of households is $3+9+6+6=24,$ so the corresponding probabilities are as follows:\n\n$$\n\\begin{aligned}P(X=1)=f(1) & =\\frac{6}{24}=\\frac{1}{4} \\\\ P(X=2)=f(2) & =\\frac{9}{24}=\\frac{3}{8} \\\\ P(X=3)=f(3) & =\\frac{6}{24}=\\frac{1}{4} \\\\ P(X=4)=f(4) & =\\frac{3}{24}=\\frac{1}{8}\\end{aligned}\n$$\n\nWe organize these results in the table below.\n\n| $x$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{4}$ | $\\frac{3}{8}$ | $\\frac{1}{4}$ | $\\frac{1}{8}$ |\n\nNow, summing up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =1\\cdot f(1)+2\\cdot f(2)+3\\cdot f(3)+4\\cdot f(4) \\\\  & =1(\\frac{1}{4})+2(\\frac{3}{8})+3(\\frac{1}{4})+4(\\frac{1}{8}) \\\\  & =\\frac{1}{4}+\\frac{3}{4}+\\frac{3}{4}+\\frac{2}{4} \\\\  & =\\frac{1+3+3+2}{4} \\\\  & =\\frac{9}{4} \\\\  & =2.25.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186570030 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5762b6c1-c01c-597b-9835-929afcb6f899" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186569570} {:answer/id #uuid "6f459d6c-f88c-58f8-8c67-ce4a713307e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186569623} {:answer/id #uuid "78fc98f4-275f-5076-bbb7-8cc595a03416" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.5" :db/id #edb/ref 17592186569644} {:answer/id #uuid "ae1705d9-17cc-5143-b4de-f594d074c4ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.5" :db/id #edb/ref 17592186569717} {:answer/id #uuid "e9e43695-a50c-5db3-a1b5-0d7b31b148a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.5" :db/id #edb/ref 17592186569814}] :answer-field/correct {:answer/id #uuid "5762b6c1-c01c-597b-9835-929afcb6f899" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186569570} :answer-field/id #uuid "2ec163e0-26a6-57f4-be06-48ae685c5412" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569862}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d66ccea1-6118-5ac8-bad9-91d326fbbfdc" :question/math-academy-id "q-5775" :question/problem "What is the expected value of one roll of a seven-sided die?" :question/worked-solution "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nLet $X$ be the roll of a standard six-sided die. Then the support is $S=\\{1,2,3,4,5,6,7\\},$ and the corresponding probabilities are all $\\frac{1}{7}:$\n\n$$\nf(1)=f(2)=…=f(7)=\\frac{1}{7}\n$$\n\nSumming up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =1\\cdot f(1)+2\\cdot f(2)+…+7\\cdot f(7) \\\\  & =1(\\frac{1}{7})+2(\\frac{1}{7})+…+7(\\frac{1}{7}) \\\\  & =\\frac{1}{7}+\\frac{2}{7}+…+\\frac{7}{7} \\\\  & =\\frac{1+2+3+4+5+6+7}{7} \\\\  & =\\frac{28}{7} \\\\  & =4\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186570032 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2b4ec13-aabf-55f7-9a84-533146afb111" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{189}{40}" :db/id #edb/ref 17592186569726}] :answer-field/correct {:answer/id #uuid "b2b4ec13-aabf-55f7-9a84-533146afb111" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{189}{40}" :db/id #edb/ref 17592186569726} :answer-field/id #uuid "05e35378-f763-5683-b2ea-96d534b870bf" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186569849}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dc6b2040-54a4-56f7-9767-230b7779b10f" :question/math-academy-id "q-337188" :question/problem "The sum of the outcomes of one roll of two unfair four-sided dice follows the probability mass function $f(x)$ shown in the table below. What is the expected value of the sum of the outcomes for one roll of the two dice?\n\n| $f(x)$ | $\\frac{3}{40}$ | $\\frac{7}{40}$ | $\\frac{1}{5}$ | $\\frac{1}{4}$ | $\\frac{3}{20}$ | $\\frac{1}{10}$ | $\\frac{1}{20}$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $2$ | $3$ | $4$ | $5$ | $6$ | $7$ | $8$ |\n\n$\\text{E}[X]=$\n{{field-1}}" :question/worked-solution "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nSumming up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =2\\cdot f(2)+3\\cdot f(3)+4\\cdot f(4)+5\\cdot f(5) \\\\  & \\,\\,+6\\cdot f(6)+7\\cdot f(7)+8\\cdot f(8) \\\\  & =2(\\frac{3}{40})+3(\\frac{7}{40})+4(\\frac{1}{5})+5(\\frac{1}{4}) \\\\  & \\,\\,+6(\\frac{3}{20})+7(\\frac{1}{10})+8(\\frac{1}{20}) \\\\  & =\\frac{6}{40}+\\frac{21}{40}+\\frac{4}{5}+\\frac{5}{4}+\\frac{18}{20}+\\frac{7}{10}+\\frac{8}{20} \\\\  & =\\frac{6}{40}+\\frac{21}{40}+\\frac{32}{40}+\\frac{50}{40}+\\frac{36}{40}+\\frac{28}{40}+\\frac{16}{40} \\\\  & =\\frac{6+21+32+50+36+28+16}{40} \\\\  & =\\frac{189}{40} \\\\  & =4.725.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186570034 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ea8cba7-d03a-516f-a0c3-30fb8354dfdd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186569622} {:answer/id #uuid "86253246-2caa-5e0b-abae-547f561590f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186569664} {:answer/id #uuid "98428f30-5194-58f2-b856-5fc56747aac9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186569687} {:answer/id #uuid "d6757daa-1d29-5c10-947c-afd176f4f5d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186569779} {:answer/id #uuid "d952e124-7588-56a7-81b3-154bceef8a55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186569785}] :answer-field/correct {:answer/id #uuid "d952e124-7588-56a7-81b3-154bceef8a55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186569785} :answer-field/id #uuid "dc076be1-fa1d-5a8e-9f7b-f0d944a99952" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569934}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e2c0ab81-ce73-5f44-b936-e8bb7ee9594f" :question/math-academy-id "q-100794" :question/problem "What is the product of solutions of the equation $3{x}^{2}\\cdot {5}^{x}=11x\\cdot {5}^{x}+4\\cdot {5}^{x}?$" :question/worked-solution "First, we factor the equation:\n\n  \n\n$$\n\\begin{aligned}3{x}^{2}\\cdot {5}^{x} & =11x\\cdot {5}^{x}+4\\cdot {5}^{x} \\\\ 3{x}^{2}\\cdot {5}^{x}-11x\\cdot {5}^{x}-4\\cdot {5}^{x} & =0 \\\\ (3{x}^{2}-11x-4)\\cdot {5}^{x} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n3{x}^{2}-11x-4=0\\,\\text{and}\\,{5}^{x}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation $3{x}^{2}-11x-4=0$ can be factored as\n\n$$\n(3x+1)(x-4)=0,\n$$\n\nwhich leads to the solutions $x=-\\frac{1}{3},4.$\n\n- The equation ${5}^{x}=0$ has no solutions because ${5}^{x}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-\\frac{1}{3},4,$ and their product is $(-\\frac{1}{3})\\cdot 4=-\\frac{4}{3}.$"} {:db/id #edb/ref 17592186570042 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "313ec59c-5153-5bc7-8ccf-d7d49fff1f8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186569515} {:answer/id #uuid "5ffa960b-f359-54f3-bfe0-2df8dcedbd09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186569589} {:answer/id #uuid "70b0c1ec-d41a-509f-b845-f8b330322fdc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186569627} {:answer/id #uuid "b3ef2881-d27a-5bf5-a98e-41fea5f9b27b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186569729} {:answer/id #uuid "e136fdfa-26d6-5d9d-8c09-dcdc748b9749" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186569801}] :answer-field/correct {:answer/id #uuid "e136fdfa-26d6-5d9d-8c09-dcdc748b9749" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186569801} :answer-field/id #uuid "e16e2010-e951-50c2-8dc9-1ddcbae83f31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569936}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fcf32a74-971a-505b-b459-ef18eedf0a90" :question/math-academy-id "q-143715" :question/problem "Consider the polar curve $r={cos}^{2}⁡\\theta$ for $\\theta \\in [0,\\pi ).$ Given that \n\n$$\n{x}^{′}(\\theta )=-3\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta ,\\,{y}^{′}(\\theta )=\\operatorname{cos}⁡\\theta ({cos}^{2}⁡\\theta -2{sin}^{2}⁡\\theta ),\n$$\n\nand ${x}^{′}(\\frac{\\pi }{2})=0,$ which of the following statements are true?\n\nI. ${y}^{′}(\\frac{\\pi }{2})=0$\n\nII. ${lim}_{\\theta \\to \\pi /2}\\frac{\\text{d}y}{\\text{d}x}=0$\n\nIII. The curve has a horizontal tangent at $\\theta =\\frac{\\pi }{2}$\n\n*Hint: It is not necessary to use L'Hopital's rule to evaluate the limit in part II.*" :question/worked-solution "When a polar curve is differentiable at a point ${\\theta }_{0}$, there is a horizontal tangent at ${\\theta }_{0}$ if\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}({\\theta }_{0})}{{x}^{′}({\\theta }_{0})}=0\n$$\n\nwhich is equivalent to\n\n$$\n{y}^{′}({\\theta }_{0})=0\\,\\text{and}\\,{x}^{′}({\\theta }_{0})\\ne 0.\n$$\n\nHowever, if the curve is continuous at ${\\theta }_{0}$ yet the derivative ${y}^{′}(x)$ takes the indeterminate form $\\frac{0}{0}$ at this point, we say that the curve has a horizontal tangent at this point if\n\n$$\n{lim}_{\\theta \\to {\\theta }_{0}}\\frac{\\text{d}y}{\\text{d}x}=0.\n$$\n\nIn this case, we're told that ${x}^{′}(\\frac{\\pi }{2})=0.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Substituting $\\theta =\\frac{\\pi }{2}$ into the expression for ${y}^{′}(\\theta ),$ we get\n\n$$\n\\begin{aligned}{y}^{′}(\\frac{\\pi }{2}) & =\\operatorname{cos}⁡(\\frac{\\pi }{2})({cos}^{2}⁡(\\frac{\\pi }{2})-2{sin}^{2}⁡(\\frac{\\pi }{2})) \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is false. Computing the limit as $\\theta \\to \\frac{\\pi }{2},$ we obtain\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to \\pi /2}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to \\pi /2}\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{\\operatorname{cos}⁡\\theta ({cos}^{2}⁡\\theta -2{sin}^{2}⁡\\theta )}{-3\\operatorname{sin}⁡(\\theta ){cos}^{2}⁡(\\theta )}) \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{\\cancel{\\operatorname{cos}⁡\\theta }({cos}^{2}⁡\\theta -2{sin}^{2}⁡\\theta )}{-3\\operatorname{sin}⁡(\\theta ){cos}^{\\cancel{2}}⁡(\\theta )}) \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{{cos}^{2}⁡\\theta -2{sin}^{2}⁡\\theta }{-3\\operatorname{sin}⁡(\\theta )\\operatorname{cos}⁡(\\theta )}) \\\\  & =\\frac{0-2\\cdot 1}{-3\\cdot 1\\cdot 0} \\\\  & =\\frac{-2}{0} \\\\  & \\ne 0.\\end{aligned}\n$$\n\n- Statement III is false. Since the limit in part II does *not* equal to $0,$ there curve does *not* have a horizontal tangent at $\\theta =\\frac{\\pi }{2}.$ In fact, it is a vertical tangent.\n\n![](images/f4/f4609e6433a861ef255cbeeac60c8a316e5c14a89df45030e26e526e3a1253a4.png)\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186570704 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4000bf26-e332-5326-962b-83435ec584c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{10}{3}{\\,}^{∘}\\text{C}" :db/id #edb/ref 17592186570230} {:answer/id #uuid "405df5c1-8de4-558b-9aaf-0951a214d16d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{5}{\\,}^{∘}\\text{C}" :db/id #edb/ref 17592186570232} {:answer/id #uuid "441f4327-e461-55f6-a208-71db35e05411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{8}{\\,}^{∘}\\text{C}" :db/id #edb/ref 17592186570242} {:answer/id #uuid "68ece16d-ee10-5137-902b-6a2b5c84b877" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}{\\,}^{∘}\\text{C}" :db/id #edb/ref 17592186570308} {:answer/id #uuid "f2138d1e-854f-50fb-afce-07734ffed707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}{\\,}^{∘}\\text{C}" :db/id #edb/ref 17592186570551}] :answer-field/correct {:answer/id #uuid "68ece16d-ee10-5137-902b-6a2b5c84b877" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}{\\,}^{∘}\\text{C}" :db/id #edb/ref 17592186570308} :answer-field/id #uuid "765eabd7-3f07-54c5-b885-44c2b986b924" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186570632}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1692e268-919b-5ead-b3e6-7be50cf4ba12" :question/math-academy-id "q-357229" :question/problem "The temperature of a cold room decreases by $\\frac{3}{8}{\\,}^{∘}\\text{C}$ each minute for $\\frac{10}{3}$ minutes. What is the total change in temperature?" :question/worked-solution "The temperature decreases by $\\frac{3}{8}{\\,}^{∘}\\text{C}$ each minute.\n\nSince the temperature decreases, the change each minute is $-\\frac{3}{8}.$\n\nThe change occurs for $\\frac{10}{3}$ minutes, so the total change is\n\n$$\n\\frac{10}{3}\\times (-\\frac{3}{8}).\n$$\n\nEvaluating the product, we get\n\n$$\n\\frac{10}{3}\\times (-\\frac{3}{8})=-\\frac{10\\times 3}{3\\times 8}=-\\frac{10}{8}=-\\frac{5}{4}.\n$$\n\nTherefore, the total change in temperature is $-\\frac{5}{4}{\\,}^{∘}\\text{C}.$"} {:db/id #edb/ref 17592186570742 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47b44d8b-ac69-5abc-8c54-02ef7744ad3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186570252}] :answer-field/correct {:answer/id #uuid "47b44d8b-ac69-5abc-8c54-02ef7744ad3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186570252} :answer-field/id #uuid "7b17d67a-7d81-5cb0-bd55-92bce57573b5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186570634}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "75deedc5-439f-5c0b-9ed9-ea7f29313f69" :question/math-academy-id "q-341826" :question/problem "Calculate the instantaneous rate of change of the function $f(x)=4x-\\operatorname{tan}⁡x$ when $x=0.$\n\n${f}^{′}(0)=$\n{{field-1}}" :question/worked-solution "The instantaneous rate of change when $x=0$ is given by the value of the derivative ${f}^{′}(x)$ at $x=0.$ \n\nFirst, we compute the derivative, using the fact that $\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡x)={sec}^{2}⁡x$ and $\\frac{\\text{d}}{\\text{d}x}(4x)=4.$ We get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4x-\\operatorname{tan}⁡x) \\\\  & =4-{sec}^{2}⁡x.\\end{aligned}\n$$\n\nEvaluating at $x=0,$ we get\n\n$$\n\\begin{aligned}{f}^{′}(0) & =4-{sec}^{2}⁡(0) \\\\  & =4-{(\\frac{1}{\\operatorname{cos}⁡(0)})}^{2} \\\\  & =4-{(\\frac{1}{1})}^{2}=4-1 \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change is $3.$"} {:db/id #edb/ref 17592186570762 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4316991d-1d98-5261-b089-c06f2c337224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186570239}] :answer-field/correct {:answer/id #uuid "4316991d-1d98-5261-b089-c06f2c337224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186570239} :answer-field/id #uuid "847db2ec-c888-5238-a1ba-407a230ec903" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186570636}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9b9f5ad2-fc37-5cb1-8895-57f56e806362" :question/math-academy-id "q-341876" :question/problem "Calculate the instantaneous rate of change of the function $f(x)=6x-\\operatorname{tan}⁡x$ when $x=\\frac{\\pi }{3}.$\n\n${f}^{′}(\\frac{\\pi }{3})=$\n{{field-1}}" :question/worked-solution "The instantaneous rate of change when $x=\\frac{\\pi }{3}$ is given by the value of the derivative ${f}^{′}(x)$ at $x=\\frac{\\pi }{3}.$ \n\nFirst, we compute the derivative, using the fact that $\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡x)={sec}^{2}⁡x$ and $\\frac{\\text{d}}{\\text{d}x}(6x)=6.$ We get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(6x-\\operatorname{tan}⁡x) \\\\  & =6-{sec}^{2}⁡x.\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi }{3},$ we get\n\n$$\n\\begin{aligned}{f}^{′}(\\frac{\\pi }{3}) & =6-{sec}^{2}⁡(\\frac{\\pi }{3}) \\\\  & =6-{(\\frac{1}{\\operatorname{cos}⁡(\\frac{\\pi }{3})})}^{2} \\\\  & =6-{(\\frac{1}{1/2})}^{2} \\\\  & =6-4 \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change is $2.$"} {:db/id #edb/ref 17592186570788 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21ff553e-31bf-5462-bc96-18edbe3a3704" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{x}{2}-\\frac{{z}^{2}}{5})(\\frac{{x}^{2}}{4}+\\frac{x{z}^{2}}{10}+\\frac{{z}^{4}}{25})" :db/id #edb/ref 17592186570186} {:answer/id #uuid "2c70c2c2-3b0e-51d8-9462-0a96a3819823" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{x}{6}-\\frac{{z}^{2}}{5})(\\frac{{x}^{2}}{6}+\\frac{x{z}^{2}}{5}+\\frac{{z}^{4}}{5})" :db/id #edb/ref 17592186570199} {:answer/id #uuid "8a828d43-3631-5741-b430-d22059e6ceab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{x}{4}-\\frac{{z}^{2}}{10})(\\frac{{x}^{2}}{2}+\\frac{x{z}^{2}}{5}+\\frac{{z}^{4}}{25})" :db/id #edb/ref 17592186570369} {:answer/id #uuid "d71f1d20-7755-56b8-8c54-b7d4b6442d20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{x}{2}-\\frac{{z}^{2}}{5})(\\frac{{x}^{2}}{2}+\\frac{xz}{5}+\\frac{{z}^{4}}{25})" :db/id #edb/ref 17592186570500} {:answer/id #uuid "f5c141ba-a2f5-57ec-aefe-7eba43f333e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{x}{2}+\\frac{{z}^{2}}{5})(\\frac{{x}^{2}}{4}-\\frac{x{z}^{2}}{10}+\\frac{{z}^{4}}{5})" :db/id #edb/ref 17592186570559}] :answer-field/correct {:answer/id #uuid "21ff553e-31bf-5462-bc96-18edbe3a3704" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{x}{2}-\\frac{{z}^{2}}{5})(\\frac{{x}^{2}}{4}+\\frac{x{z}^{2}}{10}+\\frac{{z}^{4}}{25})" :db/id #edb/ref 17592186570186} :answer-field/id #uuid "3778dcd4-e5bf-5ca6-87ec-1602ea82538b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186570599}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f995ab76-e781-54a1-b26b-a28e8f4d92d3" :question/math-academy-id "q-37670" :question/problem "Factor the expression $\\frac{{x}^{3}}{8}-\\frac{{z}^{6}}{125}.$" :question/worked-solution "The difference of cubes formula is given by\n\n$$\n{a}^{3}-{b}^{3}=(a-b)({a}^{2}+ab+{b}^{2}).\n$$\n\nNotice that we can write our expression as a difference of cubes:\n\n$$\n\\frac{{x}^{3}}{8}-\\frac{{z}^{6}}{125}={(\\frac{x}{2})}^{3}-{(\\frac{{z}^{2}}{5})}^{3}\n$$\n\nNow, we factor the given expression using the difference of cubes formula:\n\n$$\n\\begin{aligned}\\frac{{x}^{3}}{8}-\\frac{{z}^{6}}{125} & ={(\\frac{x}{2})}^{3}-{(\\frac{{z}^{2}}{5})}^{3} \\\\  & =(\\frac{x}{2}-\\frac{{z}^{2}}{5})({(\\frac{x}{2})}^{2}+\\frac{x}{2}\\cdot \\frac{{z}^{2}}{5}+{(\\frac{{z}^{2}}{5})}^{2}) \\\\  & =(\\frac{x}{2}-\\frac{{z}^{2}}{5})(\\frac{{x}^{2}}{4}+\\frac{x{z}^{2}}{10}+\\frac{{z}^{4}}{25})\\end{aligned}\n$$"} {:db/id #edb/ref 17592186571385 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7864c3b-b764-56cd-a641-bd65ea7dd484" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sec^{2}(x)\\log(x)" :db/id #edb/ref 17592186571265}] :answer-field/correct {:answer/id #uuid "f7864c3b-b764-56cd-a641-bd65ea7dd484" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sec^{2}(x)\\log(x)" :db/id #edb/ref 17592186571265} :answer-field/id #uuid "0af8eb9f-fc24-5d73-ad75-f548e3ea3646" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186571289}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "303e2b76-22b6-55f6-abfa-1986d9ab5f9d" :question/math-academy-id "q-320820" :question/problem "Given that $f(x)=\\operatorname{tan}⁡(x)\\operatorname{log}⁡(x),$ find ${f}^{′}(x).$\n\n**Hint:** $\\operatorname{log}⁡(x)={log}_{10}⁡(x)$\n\n${f}^{′}(x)=$\n{{field-1}} $+\\,\\frac{\\operatorname{tan}⁡(x)}{x\\operatorname{ln}⁡(10)}$" :question/worked-solution "Here, we have the product of two functions $u(x)=\\operatorname{tan}⁡(x)$ and $v(x)=\\operatorname{log}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={(\\operatorname{tan}⁡(x))}^{′}\\operatorname{log}⁡(x)+\\operatorname{tan}⁡(x){(\\operatorname{log}⁡(x))}^{′} \\\\  & =({sec}^{2}⁡(x))(\\operatorname{log}⁡(x))+(\\operatorname{tan}⁡(x))(\\frac{1}{x\\operatorname{ln}⁡(10)}) \\\\  & ={sec}^{2}⁡(x)\\operatorname{log}⁡(x)+\\frac{\\operatorname{tan}⁡(x)}{x\\operatorname{ln}⁡(10)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186571450 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ddbe9744-04e5-5a13-898b-3293efe4160f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{2}+3}{x}" :db/id #edb/ref 17592186571233} {:answer/id #uuid "205ae525-2c88-43fd-ab44-a800dec93096" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x\\ln x+x+\\frac{3}{x}" :db/id #edb/ref 17592186576147}] :answer-field/correct {:answer/id #uuid "ddbe9744-04e5-5a13-898b-3293efe4160f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{2}+3}{x}" :db/id #edb/ref 17592186571233} :answer-field/id #uuid "b6a34341-fe46-5049-b63f-03fb79ef67af" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186571353}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f475b19b-1e35-517e-8f15-4fa3d740b6ba" :question/math-academy-id "q-320824" :question/problem "Given that $f(x)=({x}^{2}+3)\\operatorname{ln}⁡(x),$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=2x\\operatorname{ln}⁡(x)\\,+$\n{{field-1}}" :question/worked-solution "Here, we have the product of two functions $u(x)={x}^{2}+3$ and $v(x)=\\operatorname{ln}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={({x}^{2}+3)}^{′}\\operatorname{ln}⁡(x)+({x}^{2}+3){(\\operatorname{ln}⁡(x))}^{′} \\\\  & =(2x)(\\operatorname{ln}⁡(x))+({x}^{2}+3)(\\frac{1}{x}) \\\\  & =2x\\operatorname{ln}⁡(x)+\\frac{{x}^{2}+3}{x}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186572109 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a6a3e04-07dd-5e46-ac74-a50abff88f06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2m" :db/id #edb/ref 17592186571777} {:answer/id #uuid "9a640bc5-fe07-5407-ae3b-8c6cef3acf65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}m" :db/id #edb/ref 17592186571806} {:answer/id #uuid "b62dfa05-6c38-5ac9-b766-251c1de1c15f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{7}m" :db/id #edb/ref 17592186571858} {:answer/id #uuid "dfe39d07-065f-50d1-be1f-6581aaaea180" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{7}m" :db/id #edb/ref 17592186571940} {:answer/id #uuid "ee1f63f0-d8dc-5fec-a4d6-2f15fec3ad73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{2}m" :db/id #edb/ref 17592186571956}] :answer-field/correct {:answer/id #uuid "b62dfa05-6c38-5ac9-b766-251c1de1c15f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{7}m" :db/id #edb/ref 17592186571858} :answer-field/id #uuid "4718ed5c-b264-549b-898b-519d897a84b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572014}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0ea2b07d-a05f-5f3d-9418-d56ab52d7fcd" :question/math-academy-id "q-119791" :question/problem "The vector $m$ has magnitude $\\frac{7}{2}.$ Find a unit vector that is parallel to $m.$" :question/worked-solution "To obtain the unit vector that is parallel to $m$, we divide $m$ by its length:\n\n$$\nu=\\frac{m}{|\\,m\\,|}=\\frac{1}{(\\frac{7}{2})}m=\\frac{2}{7}m\n$$"} {:db/id #edb/ref 17592186572115 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c9cfa5d-41cf-5a5f-809a-d8c4f28a52d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{x}^{2}-{y}^{2}}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186571613} {:answer/id #uuid "3b282fe4-17b1-51f0-87d2-2c80732e1692" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}(x-y)}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186571646} {:answer/id #uuid "45e68316-8377-5cd4-b0c3-6d42603c3d6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y({x}^{2}-{y}^{2})}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186571664} {:answer/id #uuid "7335c6e8-a54d-57ce-8f8e-1b8b0ecbd51e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y(x-y)}{{x}^{2}+{y}^{2}}" :db/id #edb/ref 17592186571735} {:answer/id #uuid "a0adc39a-bbc3-5d01-87eb-8fe982090eda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}-{y}^{3}}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186571817}] :answer-field/correct {:answer/id #uuid "45e68316-8377-5cd4-b0c3-6d42603c3d6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y({x}^{2}-{y}^{2})}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186571664} :answer-field/id #uuid "413910e8-4c00-543b-b56d-b6c4c169bb1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572010}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "196e0964-4e1e-5145-bb69-08bef197b0a6" :question/math-academy-id "q-80399" :question/problem "For the function $f(x,y),$ calculate $\\frac{{∂}^{2}f}{∂x∂y}$ given that $\\frac{∂f}{∂y}=-\\frac{xy}{{x}^{2}+{y}^{2}}.$" :question/worked-solution "To find $\\frac{{∂}^{2}f}{∂x∂y}$ we differentiate the given first-order partial derivative $\\frac{∂f}{∂y}$ with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(\\frac{∂f}{∂y}) \\\\  & =\\frac{∂}{∂x}(-\\frac{xy}{{x}^{2}+{y}^{2}}) \\\\  & =-y\\cdot \\frac{∂}{∂x}(\\frac{x}{{x}^{2}+{y}^{2}}) \\\\  & =-y(\\frac{1}{{x}^{2}+{y}^{2}}-\\frac{2{x}^{2}}{({x}^{2}+{y}^{2})^{2}}) \\\\  & =-y(\\frac{({x}^{2}+{y}^{2})-2{x}^{2}}{({x}^{2}+{y}^{2})^{2}}) \\\\  & =\\frac{y({x}^{2}-{y}^{2})}{({x}^{2}+{y}^{2})^{2}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186572128 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e70770d-cb50-57ad-8704-19e1f2d7511b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{201}" :db/id #edb/ref 17592186571788}] :answer-field/correct {:answer/id #uuid "8e70770d-cb50-57ad-8704-19e1f2d7511b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{201}" :db/id #edb/ref 17592186571788} :answer-field/id #uuid "b2c77d03-16e4-5e98-9806-4ae53e282fdb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186572067}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4a16473f-5565-58aa-afbf-78ab6b462353" :question/math-academy-id "q-317060" :question/problem "![](images/29/29e3f8ef81b98c4073e934a59f59557d399d105991c2386c3178c3840bd6ac3a.png)\n\nGiven the diagram above, where $|a|=5\\sqrt{3}$ and $|b|=6,$ find the **exact** value of $|a+b|.$\n\n$|a+b|=$\n{{field-1}}" :question/worked-solution "We use the triangle law for adding the vectors $a$ and $b.$\n\n![](images/c5/c58fcaace0fd6b1161426357025da18aaccd182b7035db152221bdfddbe28226.png)\n\nUsing the law of cosines, we obtain\n\n$$\n\\begin{aligned}|a+b{|}^{2} & =|a{|}^{2}+|b{|}^{2}-2|a||b|\\operatorname{cos}⁡{150}^{∘} \\\\  & =(5\\sqrt{3})^{2}+{6}^{2}-2\\cdot (5\\sqrt{3})\\cdot 6\\cdot \\,(-\\frac{\\sqrt{3}}{2}) \\\\  & =75+36+90 \\\\  & =201.\\end{aligned}\n$$\n\nHence, we get\n\n$$\n|a+b|=\\sqrt{201}.\n$$"} {:db/id #edb/ref 17592186572133 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10a3543e-a251-579f-b8fc-7f9ba24706ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186571566} {:answer/id #uuid "1621b1c6-95e0-5b2c-bd45-64e852812aa9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186571579} {:answer/id #uuid "65daad1e-0611-5bd7-afbf-4fd9443314b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186571712} {:answer/id #uuid "adca5567-c435-5016-bb46-aa649ccb320e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186571836} {:answer/id #uuid "fb02bb4e-edfe-536a-8159-eeaa09da9182" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186571969}] :answer-field/correct {:answer/id #uuid "10a3543e-a251-579f-b8fc-7f9ba24706ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186571566} :answer-field/id #uuid "b35c0d69-6d83-53fa-b5c9-4ab6a701cd32" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572069}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "50efbd3d-db78-53ec-922c-e4529ac97e50" :question/math-academy-id "q-67426" :question/problem "Solve the equation $\\frac{6}{x-5}=\\frac{2}{x}.$" :question/worked-solution "First, we note that\n\n- $x=5$ cannot be a solution since this would make the denominator on the left-hand side zero\n\n- $x=0$ cannot be a solution since this would make the denominator on the right-hand side zero\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n\\frac{x-5}{6}=\\frac{x}{2}\n$$\n\nNext, we write both fractions using the least common denominator $6.$ The above equation becomes\n\n$$\n\\frac{x-5}{6}=\\frac{3x}{6}\n$$\n\nWe can now solve this equation with the addition and the multiplication principles:\n\n$$\n\\begin{aligned}6\\cdot \\frac{x-5}{6} & =6\\cdot \\frac{3x}{6} \\\\ x-5 & =3x \\\\ x-x-5 & =3x-x \\\\ -5 & =2x \\\\ (\\frac{1}{2})\\cdot (-5) & =(\\frac{1}{2})\\cdot (2x) \\\\ -\\frac{5}{2} & =x\\end{aligned}\n$$\n\nWe conclude that the solution is $x=-\\frac{5}{2}.$"} {:db/id #edb/ref 17592186572140 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02d9aa9f-a8d8-588f-a8e1-7af4482321a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x+y}{(x+y)^{3}}" :db/id #edb/ref 17592186571542} {:answer/id #uuid "38d35b85-1420-5ed0-bcb5-84ac515d0096" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-y}{(x+y)^{3}}" :db/id #edb/ref 17592186571640} {:answer/id #uuid "6eec6d7a-5739-579b-8ce4-3302fde90d20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2y}{(x+y)^{2}}" :db/id #edb/ref 17592186571729} {:answer/id #uuid "9d8ca974-1e0f-5659-9edb-422337954136" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-2y}{(x+y)^{3}}" :db/id #edb/ref 17592186571813} {:answer/id #uuid "d06ec930-b983-5940-87c6-87b93db3f3ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x}{(x+y)^{2}}" :db/id #edb/ref 17592186571912}] :answer-field/correct {:answer/id #uuid "38d35b85-1420-5ed0-bcb5-84ac515d0096" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-y}{(x+y)^{3}}" :db/id #edb/ref 17592186571640} :answer-field/id #uuid "cc261a92-2131-5add-b6f7-f635dbf455fe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572082}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "69504aad-b4b4-5456-a945-74b303c69a26" :question/math-academy-id "q-80476" :question/problem "Calculate ${f}_{yyx}(x,y)$ given that $f(x,y)=x\\operatorname{ln}⁡(x+y).$" :question/worked-solution "First, we find the first-order derivative ${g}_{y}(x,y):$ \n\n$$\n\\begin{aligned}{g}_{y}(x,y) & =\\frac{∂}{∂y}(x\\operatorname{ln}⁡(x+y)) \\\\  & =\\frac{x}{x+y}\\end{aligned}\n$$\n\nNext, we find ${g}_{yy}(x,y)$ by differentiating ${g}_{y}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{g}_{yy}(x,y) & =\\frac{∂}{∂y}({g}_{y}(x,y)) \\\\  & =\\frac{∂}{∂y}(\\frac{x}{x+y}) \\\\  & =-\\frac{x}{(x+y)^{2}}\\end{aligned}\n$$\n\nFinally, we find ${g}_{yyx}(x,y)$ by differentiating ${g}_{yy}(x,y)$ with respect to $x:$ \n\n$$\n\\begin{aligned}{g}_{yyx}(x,y) & =\\frac{∂}{∂x}({g}_{yy}(x,y)) \\\\  & =\\frac{∂}{∂x}(-\\frac{x}{(x+y)^{2}}) \\\\  & =-\\frac{1}{(x+y)^{2}}+\\frac{2x}{(x+y)^{3}} \\\\  & =\\frac{-(x+y)+2x}{(x+y)^{3}} \\\\  & =\\frac{x-y}{(x+y)^{3}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186572145 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06cb8fe9-6f5b-5cc6-ae8b-493a6f7671eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6{y}^{2}}{\\sqrt{(2x+{y}^{3})^{3}}}" :db/id #edb/ref 17592186571551} {:answer/id #uuid "1ce8408b-f8c1-5dcb-b699-4ee03ecb5eaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3{y}^{2}}{\\sqrt{(2x+{y}^{3})^{3}}}" :db/id #edb/ref 17592186571590} {:answer/id #uuid "8911b4be-7d40-5103-814f-582e57c8eb07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{y}^{2}}{4\\sqrt{(2x+{y}^{3})^{3}}}" :db/id #edb/ref 17592186571773} {:answer/id #uuid "a1d2fe16-14df-50b1-8437-e724a6c0f329" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3{y}^{2}}{2\\sqrt{(2x+{y}^{3})^{3}}}" :db/id #edb/ref 17592186571819} {:answer/id #uuid "fbb4b5bc-5916-5e16-8a60-de6f9ce34dc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{y}^{2}}{\\sqrt{(2x+{y}^{3})^{3}}}" :db/id #edb/ref 17592186571971}] :answer-field/correct {:answer/id #uuid "1ce8408b-f8c1-5dcb-b699-4ee03ecb5eaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3{y}^{2}}{\\sqrt{(2x+{y}^{3})^{3}}}" :db/id #edb/ref 17592186571590} :answer-field/id #uuid "6a175a7d-e72a-5161-bd20-55bcf4b8cce7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572030}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "79ed868a-e284-5768-82e1-d5ebe657fd93" :question/math-academy-id "q-132768" :question/problem "For the function $f(x,y),$ calculate $\\frac{{∂}^{2}f}{∂x∂y}$ given that $\\frac{∂f}{∂y}=\\frac{3{y}^{2}}{\\sqrt{2x+{y}^{3}}}.$" :question/worked-solution "To find $\\frac{{∂}^{2}f}{∂x∂y}$ we differentiate the given first-order partial derivative $\\frac{∂f}{∂y}$ with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(\\frac{∂f}{∂y}) \\\\  & =\\frac{∂}{∂x}(\\frac{3{y}^{2}}{\\sqrt{2x+{y}^{3}}}) \\\\  & =3{y}^{2}\\cdot \\frac{∂}{∂x}((2x+{y}^{3})^{-1/2}) \\\\  & =3{y}^{2}(-\\frac{1}{2}\\cdot (2x+{y}^{3})^{-3/2}\\cdot 2) \\\\  & =-\\frac{3{y}^{2}}{\\sqrt{(2x+{y}^{3})^{3}}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186572150 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2440da94-c49c-5b97-93a3-f1f305aaf546" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186571599} {:answer/id #uuid "4dfdfa0c-df5d-578c-9e5a-030e1e19fe81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186571679} {:answer/id #uuid "67441758-f1aa-545c-a9ad-7fa7f49bf8b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186571715} {:answer/id #uuid "fb5ed5a3-55f9-5465-8515-fdd310345cd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186571970} {:answer/id #uuid "fd4a6f37-6e13-59de-b1f0-4ae8dde2510a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186571976}] :answer-field/correct {:answer/id #uuid "2440da94-c49c-5b97-93a3-f1f305aaf546" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186571599} :answer-field/id #uuid "5afb038d-0b31-5d55-8f54-c760388f6c4b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572027}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "87ece511-fd94-56a1-8fa2-055336c9156b" :question/math-academy-id "q-48848" :question/problem "Find the slope of the tangent to the curve $y=\\sqrt{3{x}^{2}+24}$ at the point where $x=-2.$" :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nWe use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=3{x}^{2}+24.$ Then $y=\\sqrt{u}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2\\sqrt{u}}\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6x.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{2\\sqrt{u}}\\cdot 6x \\\\  & =\\frac{3x}{\\sqrt{3{x}^{2}+24}}.\\end{aligned}\n$$\n\nFinally, substituting  $x=-2,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=-2} & ={(\\frac{3x}{\\sqrt{3{x}^{2}+24}})|}_{x=-2} \\\\  & =\\frac{(-6)}{\\sqrt{3(-2)^{2}+24}} \\\\  & =-\\frac{6}{6} \\\\  & =-1\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186572159 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b3dbf76-1828-5ac3-95d4-ae11a90e9d96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{3}" :db/id #edb/ref 17592186571671} {:answer/id #uuid "6ae29c52-d0a4-57f9-b779-c3d0dd5e9cde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{3}" :db/id #edb/ref 17592186571719} {:answer/id #uuid "8d9a9678-e9d3-58bc-9368-2b227c8f92dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{19}{3}" :db/id #edb/ref 17592186571784} {:answer/id #uuid "a5a5870f-6363-5e60-9102-9a8718114824" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{3}" :db/id #edb/ref 17592186571826} {:answer/id #uuid "aa89a132-2370-5d8b-adb7-ea45dff6e069" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23}{3}" :db/id #edb/ref 17592186571830}] :answer-field/correct {:answer/id #uuid "8d9a9678-e9d3-58bc-9368-2b227c8f92dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{19}{3}" :db/id #edb/ref 17592186571784} :answer-field/id #uuid "a3df603d-e9b9-56c6-b6d3-afe5a79147ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572056}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9b0b4f87-d00c-5a8b-9552-578050192860" :question/math-academy-id "q-6452" :question/problem "Evaluate ${\\sum }_{n=1}^{4}\\frac{3n+2}{6}.$" :question/worked-solution "The sum takes integer values of $n$ from $1$ to $4.$ So, computing the terms for $n=1,2,3,4$ and then adding them, we get\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{4}\\frac{3n+2}{6} & =(\\frac{3(1)+2}{6})+(\\frac{3(2)+2}{6})+(\\frac{3(3)+2}{6})+(\\frac{3(4)+2}{6}) \\\\  & =(\\frac{3+2}{6})+(\\frac{6+2}{6})+(\\frac{9+2}{6})+(\\frac{12+2}{6}) \\\\  & =\\frac{5}{6}+\\frac{8}{6}+\\frac{11}{6}+\\frac{14}{6} \\\\  & =\\frac{5+8+11+14}{6} \\\\  & =\\frac{38}{6} \\\\  & =\\frac{\\cancel{2}\\cdot 19}{\\cancel{2}\\cdot 3} \\\\  & =\\frac{19}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186572162 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40192049-1ad7-5f4e-b2a8-58c39e7a85f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{e}^{y}}{{x}^{2}}" :db/id #edb/ref 17592186571657} {:answer/id #uuid "4e06912b-3663-515d-8658-d4c5b44d07ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{e}^{y}}{x}" :db/id #edb/ref 17592186571680} {:answer/id #uuid "a16b486c-2eb9-5f72-b953-4901b9683a7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{e}^{y}(2+x)}{{x}^{2}}" :db/id #edb/ref 17592186571818} {:answer/id #uuid "d4b81103-4ab3-58a2-8a58-a90f5518df3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2{e}^{y}}{{x}^{2}}" :db/id #edb/ref 17592186571919} {:answer/id #uuid "e54cd7a0-0d35-51ae-8812-156961cad30c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2{e}^{y}}{{x}^{3}}" :db/id #edb/ref 17592186571946}] :answer-field/correct {:answer/id #uuid "d4b81103-4ab3-58a2-8a58-a90f5518df3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2{e}^{y}}{{x}^{2}}" :db/id #edb/ref 17592186571919} :answer-field/id #uuid "d45fbfd8-efe1-53f1-aa72-d9abed6ecdf3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572085}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a0649915-d841-5c53-ae8a-97441f9599ac" :question/math-academy-id "q-132873" :question/problem "Find ${f}_{xy}(x,y)+{f}_{yx}(x,y)$ given that  ${f}_{x}(x,y)=-\\frac{{e}^{y}}{{x}^{2}}$ and ${f}_{y}(x,y)=\\frac{{e}^{y}}{x}.$" :question/worked-solution "To find ${f}_{xy}(x,y)$ we differentiate the given first-order partial derivative ${f}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(-\\frac{{e}^{y}}{{x}^{2}}) \\\\  & =-\\frac{{e}^{y}}{{x}^{2}}\\end{aligned}\n$$\n\nTo find ${f}_{yx}(x,y)$ we differentiate the given first-order partial derivative ${f}_{y}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{yx}(x,y) & =\\frac{∂}{∂x}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(\\frac{{e}^{y}}{x}) \\\\  & =-\\frac{{e}^{y}}{{x}^{2}}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y)+{f}_{yx}(x,y) & =-\\frac{{e}^{y}}{{x}^{2}}-\\frac{{e}^{y}}{{x}^{2}}=-\\frac{2{e}^{y}}{{x}^{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186572165 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d15c8e5-09a1-5c60-b3ea-77e8a25be021" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{16}" :db/id #edb/ref 17592186571677}] :answer-field/correct {:answer/id #uuid "4d15c8e5-09a1-5c60-b3ea-77e8a25be021" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{16}" :db/id #edb/ref 17592186571677} :answer-field/id #uuid "f4f62d70-89e9-5c8b-bb17-0a8ab8049b70" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186572098}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ad12bb7f-1602-5240-b7ed-1965d82aeb70" :question/math-academy-id "q-251038" :question/problem "Evaluate ${\\sum }_{a=1}^{3}a{(\\frac{1}{2})}^{a+1}=${{field-1}}" :question/worked-solution "The sum takes integer values of $a$ from $1$ to $3.$ So, computing the terms for $a=1,2,3$ and then adding them, we get\n\n$$\n\\begin{aligned}{\\sum }_{a=1}^{3}a{(\\frac{1}{2})}^{a+1} & =1{(\\frac{1}{2})}^{1+1}+2{(\\frac{1}{2})}^{2+1}+3{(\\frac{1}{2})}^{3+1} \\\\  & =1{(\\frac{1}{2})}^{2}+2{(\\frac{1}{2})}^{3}+3{(\\frac{1}{2})}^{4} \\\\  & =1\\cdot \\frac{1}{4}+2\\cdot \\frac{1}{8}+3\\cdot \\frac{1}{16} \\\\  & =\\frac{1}{4}+\\frac{2}{8}+\\frac{3}{16} \\\\  & =\\frac{(1\\cdot 4)+(2\\cdot 2)+3}{16} \\\\  & =\\frac{4+4+3}{16} \\\\  & =\\frac{11}{16}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186572168 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84d61063-c977-5de9-9ee9-751b5700caa9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186571767}] :answer-field/correct {:answer/id #uuid "84d61063-c977-5de9-9ee9-751b5700caa9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186571767} :answer-field/id #uuid "8d21a9e8-24d8-5f1d-b050-6be0b52be222" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186572046}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b3ded2ac-377c-5a79-a174-a4c453e1b17f" :question/math-academy-id "q-300982" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to -\\infty }\\frac{7}{4{(x-2)}^{3}}\\,=$\n {{field-1}}" :question/worked-solution "First, we rewrite our limit using the algebra of limits, as follows:\n\n$$\n{lim}_{x\\to -\\infty }\\frac{7}{4{(x-2)}^{3}}=\\frac{7}{4}\\cdot {lim}_{x\\to -\\infty }\\frac{1}{{(x-2)}^{3}}\n$$\n\nFor any non-constant polynomial $P(x),$ we have\n\n$$\n{lim}_{x\\to \\pm \\infty }(\\frac{1}{P(x)})=0.\n$$\n\nTherefore, since ${(x-2)}^{3}$ is a non-constant polynomial, we have\n\n$$\n{lim}_{x\\to -\\infty }\\frac{1}{(x-2)^{3}}=0.\n$$\n\nFinally, we can evaluate the original limit as follows:\n\n$$\n\\frac{7}{4}\\cdot {lim}_{x\\to -\\infty }\\frac{1}{{(x-2)}^{3}}=\\frac{7}{4}\\cdot 0=0\n$$"} {:db/id #edb/ref 17592186572172 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2011be0c-38a3-5056-adae-7b634e1eedc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186571594} {:answer/id #uuid "28c22842-c3ce-5a8a-ab8f-72781a08e807" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186571608} {:answer/id #uuid "31676b05-5ecf-5507-afe8-70e418952d68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186571621} {:answer/id #uuid "7fa15e1a-d450-5bdf-ab2e-7db7463df9ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186571758} {:answer/id #uuid "b0866692-8ed1-5f90-8e94-da9ca9c8496c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186571846}] :answer-field/correct {:answer/id #uuid "7fa15e1a-d450-5bdf-ab2e-7db7463df9ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186571758} :answer-field/id #uuid "07559b22-9501-5406-b1d4-af6af28cc58e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571986}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ba2fee1b-3766-585f-9ea4-855819a270ac" :question/math-academy-id "q-163546" :question/problem "A particle $P$ moves along the positive $x$-axis. When the displacement of $P$ from the origin is $x\\,m,$ the velocity is $v\\,m/s,$ the magnitude of the acceleration is $\\frac{k}{x+1}\\,{m/s}^{2},$ where $k$ is a positive constant, and the acceleration is directed toward $O.$ If $P$ has velocity $v=4\\,m/s$ at the origin and the particle is at rest when its displacement is $({e}^{4}-1)\\,m,$ find the value of $k.$" :question/worked-solution "![](images/e9/e938c4ba0e20c0714d1cd0ef62fb6596b37341b06d29de4e675981007610e12a.png)\n\nSince the acceleration of the particle $P$ has magnitude $\\frac{k}{x+1}\\,{m/s}^{2}$ and is directed *toward* $O,$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-\\frac{k}{x+1}.\n$$\n\nUsing the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=-\\frac{k}{x+1}.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int (-\\frac{k}{x+1})\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=-k\\operatorname{ln}⁡(x+1)+C.\n$$\n\nNow, since $v=4\\,m/s$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =-k\\operatorname{ln}⁡(x+1)+C \\\\ \\frac{1}{2}(4)^{2} & =-k\\operatorname{ln}⁡(0+1)+C \\\\ C & =8\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{1}{2}{v}^{2}=8-k\\operatorname{ln}⁡(x+1).\n$$\n\nFinally, since $v=0\\,m/s$ when $x=({e}^{4}-1)\\,m,$ we can find the value of the positive constant $k,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =8-k\\operatorname{ln}⁡(x+1) \\\\ \\frac{1}{2}(0)^{2} & =8-k\\operatorname{ln}⁡(({e}^{4}-1)+1) \\\\ k\\operatorname{ln}⁡({e}^{4}) & =8 \\\\ 4k & =8 \\\\ k & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186572176 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12d2a9ec-fb95-5d20-a726-63f5771b10f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186571570} {:answer/id #uuid "390cf7e7-f277-521d-acc2-2719c16d4347" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{31}" :db/id #edb/ref 17592186571641} {:answer/id #uuid "3f9d5909-94e6-5d98-bed0-36ed77f8c2ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{3}" :db/id #edb/ref 17592186571656} {:answer/id #uuid "845a2766-707b-53f6-be2f-35e563eda9f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{39}" :db/id #edb/ref 17592186571766} {:answer/id #uuid "9b9261ec-bdc7-547d-99c9-49c3876ad9c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{37}" :db/id #edb/ref 17592186571809}] :answer-field/correct {:answer/id #uuid "9b9261ec-bdc7-547d-99c9-49c3876ad9c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{37}" :db/id #edb/ref 17592186571809} :answer-field/id #uuid "b243cc54-a33f-576c-b54c-700231d1a2f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572065}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c6713e37-7e62-534f-9e1d-40cff7fc1ed3" :question/math-academy-id "q-11887" :question/problem "![](images/d1/d19c7802a136d6fd039c190acdda94e9e8603d58d2ba62864ea0e5522cbd6791.png)\n\nGiven the diagram above, where $|a|=3$ and $|b|=4$, find the value of $|a+b|.$" :question/worked-solution "We use the triangle law for adding the vectors $a$ and $b.$\n\n![](images/38/3858242481fec9cd3b3fef85fcbb4e6a17aff20128f47565807a253dba517585.png)\n\nUsing the law of cosines, we obtain:\n\n$$\n\\begin{aligned}{|a+b|}^{2} & ={|a|}^{2}+{|b|}^{2}-2|a||b|\\operatorname{cos}⁡({120}^{∘}) \\\\  & ={3}^{2}+{4}^{2}-2\\cdot 3\\cdot 4\\cdot (-\\frac{1}{2}) \\\\  & =9+16+12 \\\\  & =37\\end{aligned}\n$$\n\nHence, $|a+b|=\\sqrt{37}.$"} {:db/id #edb/ref 17592186572196 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "052d695c-75c2-537a-b2dd-d40fb706a504" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\overset{\\to }{UV}" :db/id #edb/ref 17592186571549} {:answer/id #uuid "2b72b380-5234-5f6a-925b-f6a08d294796" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{UV}" :db/id #edb/ref 17592186571611} {:answer/id #uuid "31d03316-8870-51ff-8acc-393b2704b5f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\overset{\\to }{UV}" :db/id #edb/ref 17592186571623} {:answer/id #uuid "4d4e311b-d223-5cb9-82e6-b49ae0b379b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\overset{\\to }{UV}" :db/id #edb/ref 17592186571678} {:answer/id #uuid "77bdcaf2-bbad-5bfa-a013-fc5cd78f7ea5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\overset{\\to }{UV}" :db/id #edb/ref 17592186571743}] :answer-field/correct {:answer/id #uuid "77bdcaf2-bbad-5bfa-a013-fc5cd78f7ea5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\overset{\\to }{UV}" :db/id #edb/ref 17592186571743} :answer-field/id #uuid "537d3cf5-0d6e-5a1b-96fe-52ba35118a33" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572020}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ec3ac6e6-c786-5106-a626-b9bded90e31e" :question/math-academy-id "q-119788" :question/problem "The vector $\\overset{\\to }{UV}$ has magnitude $\\frac{1}{3}.$ Which of the following is a unit vector that is parallel to $\\overset{\\to }{UV}?$" :question/worked-solution "To obtain the unit vector that is parallel to $\\overset{\\to }{UV},$ we divide $\\overset{\\to }{UV}$ by its length:\n\n$$\nu=\\frac{\\overset{\\to }{UV}}{|\\overset{\\to }{UV}|}=\\frac{1}{(\\frac{1}{3})}\\overset{\\to }{UV}=3\\overset{\\to }{UV}\n$$"} {:db/id #edb/ref 17592186572200 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd970ca4-531c-5efa-b2d5-8a2654d8cfb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186571977}] :answer-field/correct {:answer/id #uuid "fd970ca4-531c-5efa-b2d5-8a2654d8cfb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186571977} :answer-field/id #uuid "8d76b44d-6cd7-5750-b38b-774c366dedf2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186572047}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "facb659a-1d6a-50ad-a009-4e0f9aa3e331" :question/math-academy-id "q-334183" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to -\\infty }\\frac{-12}{9{(x+5)}^{4}}\\,=$\n {{field-1}}" :question/worked-solution "First, we rewrite our limit using the algebra of limits, as follows:\n\n$$\n{lim}_{x\\to -\\infty }\\frac{-12}{9{(x+5)}^{4}}=\\frac{-12}{9}\\cdot {lim}_{x\\to -\\infty }\\frac{1}{{(x+5)}^{4}}=-\\frac{4}{3}\\cdot {lim}_{x\\to -\\infty }\\frac{1}{{(x+5)}^{4}}\n$$\n\nFor any non-constant polynomial $P(x),$ we have\n\n$$\n{lim}_{x\\to \\pm \\infty }(\\frac{1}{P(x)})=0.\n$$\n\nTherefore, since ${(x+5)}^{4}$ is a non-constant polynomial, we have\n\n$$\n{lim}_{x\\to -\\infty }\\frac{1}{(x+5)^{4}}=0.\n$$\n\nFinally, we can evaluate the original limit as follows:\n\n$$\n-\\frac{4}{3}\\cdot {lim}_{x\\to -\\infty }\\frac{1}{{(x+5)}^{4}}=-\\frac{4}{3}\\cdot 0=0\n$$"} {:db/id #edb/ref 17592186573250 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11ddabc6-6948-5d05-984f-8724d78f9060" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186572845} {:answer/id #uuid "1ac77e93-6655-5cb9-83e2-8d0071ffa65a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186572853} {:answer/id #uuid "23691b4e-ef96-59e7-b343-43a0604ca109" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186572868} {:answer/id #uuid "7059fd79-bfc5-56de-bb09-06241fc81d5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186572964} {:answer/id #uuid "8bcb3571-4895-5ea8-a376-01f2897be6f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186573003}] :answer-field/correct {:answer/id #uuid "23691b4e-ef96-59e7-b343-43a0604ca109" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186572868} :answer-field/id #uuid "6c3ab6b7-6e70-535c-9a1b-8fc6113a3975" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573185}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "002cab17-2b93-5a94-bc24-04ae7b92f4f9" :question/math-academy-id "q-152871" :question/problem "${lim}_{x\\to \\,4}\\operatorname{sin}⁡(\\operatorname{arctan}⁡(\\frac{x}{4})+\\pi )=$" :question/worked-solution "First, let's sketch the graph of  $y=\\operatorname{arctan}⁡(\\frac{x}{4})+\\pi :$   \n\n![](images/42/42eb38a11d9d63e05c0078bae4c052566b3162571e8563f22cd52ae31bc6dbd7.png)\n\nThe domain of   $\\operatorname{arctan}⁡(\\frac{x}{4})+\\pi$ is $(-\\infty ,\\infty ).$  \n\nNow, substituting $x=4$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,4}\\operatorname{sin}⁡(\\operatorname{arctan}⁡(\\frac{x}{4})+\\pi ) & =\\operatorname{sin}⁡(\\operatorname{arctan}⁡(1)+\\pi ) \\\\  & =\\operatorname{sin}⁡(\\frac{\\pi }{4}+\\pi ) \\\\  & =\\operatorname{sin}⁡(\\frac{5\\pi }{4}) \\\\  & =-\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186573251 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d1327b1-2cbe-5b08-811b-7be6d5b707b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186572856} {:answer/id #uuid "5222b098-a197-50ea-8318-c0f68f812c9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186572919} {:answer/id #uuid "94e41152-84ae-580a-bd00-9b191abad725" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186573017} {:answer/id #uuid "c1265443-5be8-5777-968a-4182b947a1fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186573070} {:answer/id #uuid "edcc4ee6-05fd-5ebf-b244-ad7bff1272ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186573126}] :answer-field/correct {:answer/id #uuid "1d1327b1-2cbe-5b08-811b-7be6d5b707b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186572856} :answer-field/id #uuid "94c40397-9482-5a52-b940-12d808c2acb6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573205}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0032ce9b-c24d-5a4a-8814-0479ffd35234" :question/math-academy-id "q-80840" :question/problem "Suppose that a function $f(x,y,z)$ and all of its higher-order partial derivatives are continuous on an open set $U,$ and that\n\n$$\n{f}_{zx}(x,y,z)=-\\frac{2yz}{{x}^{2}+{y}^{2}},\\,{f}_{yz}(x,y,z)=\\frac{2xz}{{x}^{2}+{y}^{2}}.\n$$\n\n \n\nEvaluate the following expression at the point $(1,2,1):$\n\n$$\n{f}_{zyy}(x,y,z)+{f}_{xxz}(x,y,z)\n$$" :question/worked-solution "As the higher-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal. \n\nHence, we have\n\n$$\n\\begin{aligned}{f}_{zyy}(x,y,z) & ={f}_{yzy}(x,y,z) \\\\  & =\\frac{∂}{∂y}({f}_{yz}(x,y,z)) \\\\  & =\\frac{∂}{∂y}(\\frac{2xz}{{x}^{2}+{y}^{2}}) \\\\  & =-\\frac{4xyz}{({x}^{2}+{y}^{2})^{2}}.\\end{aligned}\n$$\n\nIn addition, we have\n\n$$\n\\begin{aligned}{f}_{xxz}(x,y,z) & ={f}_{zxx}(x,y,z) \\\\  & =\\frac{∂}{∂x}({f}_{zx}(x,y,z)) \\\\  & =\\frac{∂}{∂x}(-\\frac{2yz}{{x}^{2}+{y}^{2}}) \\\\  & =\\frac{4xyz}{({x}^{2}+{y}^{2})^{2}}.\\end{aligned}\n$$\n\nFrom the above, we get\n\n$$\n{f}_{zyy}(x,y,z)+{f}_{xxz}(x,y,z)=-\\frac{4xyz}{({x}^{2}+{y}^{2})^{2}}+\\frac{4xyz}{({x}^{2}+{y}^{2})^{2}}=0.\n$$\n\nFinally, \n\n$$\n{f}_{zyy}(1,2,1)+{f}_{xxz}(1,2,1)=0.\n$$"} {:db/id #edb/ref 17592186573253 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38a98641-2e38-578c-b3c5-17bb1f192700" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186572881} {:answer/id #uuid "5e7dce6a-3e36-598d-9a5e-9b0c2908e50b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186572932} {:answer/id #uuid "9b66ccb7-9147-50dc-a184-c4ff564b8209" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186573024} {:answer/id #uuid "9d4fd407-f836-5227-93e6-01c0887c14a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186573028} {:answer/id #uuid "e1e77c3b-5d54-5798-8bc6-98d8b4b1e688" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186573111}] :answer-field/correct {:answer/id #uuid "38a98641-2e38-578c-b3c5-17bb1f192700" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186572881} :answer-field/id #uuid "cd14762e-d61e-513a-9786-dfc287bdc4a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573226}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "070008c9-e913-5456-a5af-e255c5aba081" :question/math-academy-id "q-30824" :question/problem "${log}_{64}⁡(\\sqrt{8})=$" :question/worked-solution "We use the change of base formula:\n\n$$\n{log}_{a}⁡X=\\frac{{log}_{b}⁡X}{{log}_{b}⁡a}\n$$\n\nIn our case, $a=64$ and $X=\\sqrt{8}.$ Since both $a$ and $X$ can be presented as a power of $8,$ we set $b=8.$ So, we have:\n\n$$\n\\begin{aligned}{log}_{64}⁡(\\sqrt{8}) & =\\frac{{log}_{8}⁡(\\sqrt{8})}{{log}_{8}⁡(64)} \\\\  & =\\frac{{log}_{8}⁡({8}^{1/2})}{{log}_{8}⁡({8}^{2})} \\\\  & =\\frac{(\\frac{1}{2})}{2} \\\\  & =\\frac{1}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186573257 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66bba579-8ea0-5e5c-bd2d-e8e863cdd735" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186572949} {:answer/id #uuid "824adea5-acf8-5e06-8bab-443fe02ee9b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186572991} {:answer/id #uuid "8c3f00e8-0aa4-5703-a339-a7d82486ce71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186573005} {:answer/id #uuid "bd51a5c9-fd39-575f-ac7e-0441c9c8a065" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186573064} {:answer/id #uuid "c469cea9-c5ed-510d-9d4e-23fad7086af9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186573072}] :answer-field/correct {:answer/id #uuid "824adea5-acf8-5e06-8bab-443fe02ee9b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186572991} :answer-field/id #uuid "11c76a28-9fde-5aa9-9195-610b2d3249af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573154}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0b93f5e4-441e-52cb-bcd1-657f8b3f7ca5" :question/math-academy-id "q-48724" :question/problem "For the functions $f(x)$ and $g(x),$ you are given the following data:\n\n$$\nf(-2)=1,\\,{f}^{′}(-2)=-3,\\,g(-2)=2,\\,{g}^{′}(-2)=6\n$$\n\nCompute $\\frac{\\text{d}}{\\text{d}x}(\\frac{f(x)}{g(x)})$ at $x=-2.$" :question/worked-solution "Using the quotient rule, we get\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{f(x)}{g(x)})=\\frac{{f}^{′}(x)g(x)-f(x){g}^{′}(x)}{(g(x))^{2}}.\n$$\n\nAt the point where $x=-2$, this gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}}{\\text{d}x}(\\frac{f(x)}{g(x)})|}_{x=-2} & =\\frac{{f}^{′}(-2)g(-2)-f(-2){g}^{′}(-2)}{{g}^{2}(-2)} \\\\  & =\\frac{(-3)\\cdot 2-1\\cdot 6}{{2}^{2}} \\\\  & =-3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186573267 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66a0bcce-653d-592a-b615-921125e4877d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186572948} {:answer/id #uuid "76ba75fb-4bc9-5ff8-9ed9-b66c1d091c5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186572976} {:answer/id #uuid "95204e1c-0acb-54ed-a36a-670e3b50729d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186573019} {:answer/id #uuid "b82f8830-ef82-53f9-94fe-10a3b6669fdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186573058} {:answer/id #uuid "b870fa54-4d3f-51b4-81c7-fd2cf9755718" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186573059}] :answer-field/correct {:answer/id #uuid "66a0bcce-653d-592a-b615-921125e4877d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186572948} :answer-field/id #uuid "b211c988-c894-53a3-abe3-c7c0de871b39" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573213}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2e637b5f-6f34-5a1c-b2e1-f9ed9e9b050b" :question/math-academy-id "q-66885" :question/problem "${log}_{64}⁡(\\sqrt[3]{4})=$" :question/worked-solution "We use the change of base formula:\n\n$$\n{log}_{a}⁡X=\\frac{{log}_{b}⁡X}{{log}_{b}⁡a}\n$$\n\nIn our case, $a=64$ and $X=\\sqrt[3]{4}.$ Since both $a$ and $X$ can be presented as a power of $4,$ we set $b=4.$ So, we have:\n\n$$\n\\begin{aligned}{log}_{64}⁡(\\sqrt[3]{4}) & =\\frac{{log}_{4}⁡(\\sqrt[3]{4})}{{log}_{4}⁡(64)} \\\\  & =\\frac{{log}_{4}⁡({4}^{1/3})}{{log}_{4}⁡({4}^{3})} \\\\  & =\\frac{(\\frac{1}{3})}{3} \\\\  & =\\frac{1}{9}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186573268 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cab12af0-b59f-5bad-b4db-8eea41c70809" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186573080}] :answer-field/correct {:answer/id #uuid "cab12af0-b59f-5bad-b4db-8eea41c70809" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186573080} :answer-field/id #uuid "52153792-c358-5ad7-a1f9-bbbc25297261" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573180}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2f397079-49a9-58d1-bc93-fa23602eefa7" :question/math-academy-id "q-344566" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\,\\frac{1}{\\sqrt{3}}}cos\\,(\\operatorname{arctan}⁡(3x))=$\n{{field-1}}" :question/worked-solution "![](images/86/86c0cf22de78e3b773543680c2ace077f97b66ae822436d637c5444903e2330f.png)\n\nThe domain of $\\operatorname{arctan}⁡(3x)$ is $(-\\infty ,\\infty ).$\n\nNow, substituting $x=\\frac{1}{\\sqrt{3}}$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,\\frac{1}{\\sqrt{3}}}cos\\,(\\operatorname{arctan}⁡(3x)) & =cos\\,(arctan\\,(3\\cdot \\frac{1}{\\sqrt{3}})) \\\\  & =cos\\,(arctan\\,(\\sqrt{3})) \\\\  & =cos\\,(\\frac{\\pi }{3}) \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186573274 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f7d18b7-8669-51a0-8612-923a2719727c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{21.20}^{∘}" :db/id #edb/ref 17592186572858} {:answer/id #uuid "6437eb0c-5020-559e-bd70-319aee5ba937" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{17.89}^{∘}" :db/id #edb/ref 17592186572946} {:answer/id #uuid "c646cdc4-684d-54a1-8714-3eeef1e84d61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{18.19}^{∘}" :db/id #edb/ref 17592186573074} {:answer/id #uuid "c9b37447-949a-5c58-9208-515eaa569613" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{16.43}^{∘}" :db/id #edb/ref 17592186573078} {:answer/id #uuid "d4bc5f15-b8d5-57ea-919a-885ac1bd4741" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{20.36}^{∘}" :db/id #edb/ref 17592186573095}] :answer-field/correct {:answer/id #uuid "c646cdc4-684d-54a1-8714-3eeef1e84d61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{18.19}^{∘}" :db/id #edb/ref 17592186573074} :answer-field/id #uuid "fe46b4b1-2f2f-5fb3-9e1d-afbfc19fa446" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573248}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5021d5eb-c519-52ae-b30c-1049345fdc26" :question/math-academy-id "q-6423" :question/problem "A triangle has sides $m$, $n$, and $o.$ The sides $m$, $n$, and $o$ are of lengths  $2$, $5$, and $6$, respectively. What is the measure of the angle between the sides $n$ and $o?$ Round your answer to two decimal places." :question/worked-solution "The following triangle illustrates the information given.\n\n![](images/26/26f2041aec84bb0086e2f08c2ba3a19331895951782b7fda153858643a8a5dd4.png)\n\nWe use the Law of Cosines to solve for angle $M:$\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡M & =\\frac{{o}^{2}+{n}^{2}-{m}^{2}}{2no}.\\end{aligned}\n$$\n\n \nHere, we have\n\n$$\nm=2,\\,n=5,\\,o=6.\n$$\n\nThis gives \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡M & =\\frac{{6}^{2}+{5}^{2}-{2}^{2}}{2(5)(6)} \\\\  & =\\frac{36+25-4}{60} \\\\  & =\\frac{57}{60}.\\end{aligned}\n$$\n\n \nTherefore,\n\n$$\n\\begin{aligned}m∠M & =\\operatorname{arccos}⁡(\\frac{57}{60}) \\\\  & ={18.19}^{∘}\\end{aligned}\n$$\n\nrounded to two decimal places."} {:db/id #edb/ref 17592186573277 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59f38619-20b2-5322-be74-7ade54b5a4ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186572927} {:answer/id #uuid "69646748-f284-5f48-8b8c-5eab9d02207a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186572952} {:answer/id #uuid "921c084b-39dd-579f-a483-01d5fac78c2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186573013} {:answer/id #uuid "b2bd6575-c2b6-5ac7-a9ee-1355aa285156" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186573051} {:answer/id #uuid "b98f6385-ee75-53c7-8fb6-adbddd6958be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186573060}] :answer-field/correct {:answer/id #uuid "b2bd6575-c2b6-5ac7-a9ee-1355aa285156" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186573051} :answer-field/id #uuid "7f31fc24-9a16-583f-8c7d-7e52bda34673" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573195}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "59d8b4d6-365d-545b-a80d-dc97dcfbcac8" :question/math-academy-id "q-42997" :question/problem "Let $A,$ $B,$ and $C$ be square matrices. If $A=B\\cdot C,$  $|B|=9$ and $|{C}^{-1}|=-3$, find $|A|.$" :question/worked-solution "Given two $n\\times n$ matrices $M$ and $N,$ we have\n\n$$\ndet(MN)=det(M)\\cdot det(N).\n$$\n\nAlso, given an invertible $n\\times n$ matrix $M,$ we have\n\n$$\ndet({M}^{-1})=\\frac{1}{det(M)}.\n$$\n\nSince $|C|=\\frac{1}{|{C}^{-1}|}$, we get $|C|=-\\frac{1}{3}.$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}|A| & =|B|\\cdot |C| \\\\  & =9\\cdot (-\\frac{1}{3}) \\\\  & =-3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186573281 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "880a7533-d27a-5209-9676-048622c816b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186572999}] :answer-field/correct {:answer/id #uuid "880a7533-d27a-5209-9676-048622c816b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186572999} :answer-field/id #uuid "4a8fb50b-f581-55fc-8b2e-6ae22914031e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573176} {:answer-field/choices [{:answer/id #uuid "72d3c220-e470-557e-bcd0-a9f8849b3dc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{6}" :db/id #edb/ref 17592186572966}] :answer-field/correct {:answer/id #uuid "72d3c220-e470-557e-bcd0-a9f8849b3dc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{6}" :db/id #edb/ref 17592186572966} :answer-field/id #uuid "54dab796-cb41-55f7-82f8-49c26b926e11" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573181}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "64689025-90b1-5416-8d71-9bc463abeb1c" :question/math-academy-id "q-175584" :question/problem "$\\frac{7}{2}u+4w-\\frac{2}{3}u-w=${{field-1}}\n$u\\,+$\n{{field-2}}\n$w$" :question/worked-solution "We collect and combine the like terms, simplifying the coefficients as much as possible:\n\n$$\n\\begin{aligned}\\frac{7}{2}u+4w-\\frac{2}{3}u-w &= (\\frac{7}{2}u-\\frac{2}{3}u)+(4w-w) \\\\ &= (\\frac{7}{2}-\\frac{2}{3})u+(4-1)w \\\\ &= (\\frac{21}{6}-\\frac{4}{6})u+3w \\\\ &= (\\frac{21-4}{6})u+3w \\\\ &= \\frac{17}{6}\\,u+3\\,w\\end{aligned}\n$$"} {:db/id #edb/ref 17592186573282 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ff58db8-d3aa-5a86-9a2e-d31f49b75188" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5e" :db/id #edb/ref 17592186572899} {:answer/id #uuid "68492c09-b3b0-534b-b4ac-c01f2c0700c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{e}^{2}" :db/id #edb/ref 17592186572950} {:answer/id #uuid "81d458d2-90b1-5a94-9db8-718b9d6a3cb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{9}" :db/id #edb/ref 17592186572990} {:answer/id #uuid "8801afb1-04ef-5a19-83e4-2ad30cea2606" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186572998} {:answer/id #uuid "e2372e0b-2f40-5aea-92e5-d19c0b4ba47c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5e}{9}" :db/id #edb/ref 17592186573113}] :answer-field/correct {:answer/id #uuid "8801afb1-04ef-5a19-83e4-2ad30cea2606" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186572998} :answer-field/id #uuid "b80dda05-df9e-5706-9ab3-92f41f323fc8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573216}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "65401c01-5232-5bed-88ce-91552174b310" :question/math-academy-id "q-104450" :question/problem "For the functions $f(x)$ and $g(x),$ you are given the following data:\n\n$$\nf(-4)=2e,\\,{f}^{′}(-4)=-e,\\,g(-4)=-3e,\\,{g}^{′}(-4)=e\n$$\n\nCompute $\\frac{\\text{d}}{\\text{d}x}(\\frac{f(x)}{g(x)})$ at $x=-4.$" :question/worked-solution "Using the quotient rule, we get\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{f(x)}{g(x)})=\\frac{{f}^{′}(x)g(x)-f(x){g}^{′}(x)}{(g(x))^{2}}.\n$$\n\nAt the point where $x=-4,$ this gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}}{\\text{d}x}(\\frac{f(x)}{g(x)})|}_{x=-4} & =\\frac{{f}^{′}(-4)g(-4)-f(-4){g}^{′}(-4)}{{g}^{2}(-4)} \\\\  & =\\frac{-e\\cdot (-3e)-2e\\cdot e}{9{e}^{2}} \\\\  & =\\frac{1}{9}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186573284 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a3589f1-ac93-5952-859b-8f591ed12f8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨4,-3⟩" :db/id #edb/ref 17592186572852} {:answer/id #uuid "217df582-1766-5708-befa-cca7ca604227" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-4,6⟩" :db/id #edb/ref 17592186572864} {:answer/id #uuid "22a814b0-3197-565e-b644-6bb531bb40ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-4,-6⟩" :db/id #edb/ref 17592186572867} {:answer/id #uuid "b78a4790-38b5-51fd-90db-551fbc2d1b6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-4,3⟩" :db/id #edb/ref 17592186573057} {:answer/id #uuid "dc199364-014d-525d-b0f2-b1fef9e454e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨4,6⟩" :db/id #edb/ref 17592186573102}] :answer-field/correct {:answer/id #uuid "217df582-1766-5708-befa-cca7ca604227" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-4,6⟩" :db/id #edb/ref 17592186572864} :answer-field/id #uuid "37eefbb8-760d-5cd5-a2f6-73f262b42f48" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573170}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "71659674-1123-5b9b-95e7-0ead2ac9950c" :question/math-academy-id "q-1390" :question/problem "If $\\overset{\\to }{c}=⟨12,-18⟩$, then $-\\frac{1}{3}\\overset{\\to }{c}=$" :question/worked-solution "To compute $-\\frac{1}{3}\\overset{\\to }{c},$ we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}-\\frac{1}{3}\\overset{\\to }{c} & =-\\frac{1}{3}\\cdot ⟨12,-18⟩ \\\\  & =⟨(-\\frac{1}{3})\\cdot 12,(-\\frac{1}{3})\\cdot (-18)⟩ \\\\  & =⟨-4,6⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186573289 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "152b66f7-c7ce-598f-93d8-1e22b704f747" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-3{x}^{2}-20x+4" :db/id #edb/ref 17592186572846} {:answer/id #uuid "61dcae46-646f-5be7-9da2-a6de1d9ed25e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-4{x}^{2}-10x-2" :db/id #edb/ref 17592186572940} {:answer/id #uuid "7c7e4c5a-868b-5f38-b6a3-f41a6a7c3f5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-2{x}^{2}-10x+2" :db/id #edb/ref 17592186572983} {:answer/id #uuid "7cee9ed5-127b-5419-a740-825cde47b428" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-4{x}^{2}-10x+4" :db/id #edb/ref 17592186572984} {:answer/id #uuid "c9ae8832-8946-513b-bceb-30925dd4f2ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-3{x}^{2}-20x-4" :db/id #edb/ref 17592186573077}] :answer-field/correct {:answer/id #uuid "7c7e4c5a-868b-5f38-b6a3-f41a6a7c3f5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-2{x}^{2}-10x+2" :db/id #edb/ref 17592186572983} :answer-field/id #uuid "0e4c95de-4b57-5003-8261-a6e1c6a6bcc0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573152}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8db2f83d-f6c6-583a-9190-f65543a5bd2c" :question/math-academy-id "q-138836" :question/problem "Consider the function $y=\\frac{{e}^{{x}^{2}}}{({x}^{2}-2x-8)^{2}}.$ The derivative of this function is given by\n\n$$\n{y}^{′}=\\frac{2{e}^{{x}^{2}}g(x)}{({x}^{2}-2x-8)^{3}}.\n$$\n\nFind the function $g(x).$" :question/worked-solution "We have the function \n\n$$\ny=\\frac{{e}^{{x}^{2}}}{({x}^{2}-2x-8)^{2}}.\n$$\n\nFirst, we find the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{{e}^{{x}^{2}}}{({x}^{2}-2x-8)^{2}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({e}^{{x}^{2}})-\\operatorname{ln}⁡{({x}^{2}-2x-8)}^{2} \\\\ \\operatorname{ln}⁡y & ={x}^{2}-2\\operatorname{ln}⁡({x}^{2}-2x-8)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}-2\\operatorname{ln}⁡({x}^{2}-2x-8)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =2x-2\\cdot \\frac{1}{{x}^{2}-2x-8}\\cdot (2x-2) \\\\ \\frac{{y}^{′}}{y} & =2x-\\frac{4x-4}{{x}^{2}-2x-8}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(2x-\\frac{4x-4}{{x}^{2}-2x-8})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{{e}^{{x}^{2}}}{({x}^{2}-2x-8)^{2}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{{e}^{{x}^{2}}}{({x}^{2}-2x-8)^{2}}(2x-\\frac{4x-4}{{x}^{2}-2x-8}) \\\\  & =\\frac{{e}^{{x}^{2}}}{({x}^{2}-2x-8)^{2}}(\\frac{2x({x}^{2}-2x-8)-(4x-4)}{{x}^{2}-2x-8}) \\\\  & =\\frac{{e}^{{x}^{2}}}{({x}^{2}-2x-8)^{3}}(2x({x}^{2}-2x-8)-(4x-4)) \\\\  & =\\frac{{e}^{{x}^{2}}}{({x}^{2}-2x-8)^{3}}(2{x}^{3}-4{x}^{2}-16x-4x+4) \\\\  & =\\frac{2{e}^{{x}^{2}}({x}^{3}-2{x}^{2}-10x+2)}{({x}^{2}-2x-8)^{3}}\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\ng(x)={x}^{3}-2{x}^{2}-10x+2.\n$$"} {:db/id #edb/ref 17592186573290 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4245b790-1a22-59f1-b2b1-ec25d43743c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3({e}^{2}+1)" :db/id #edb/ref 17592186572902}] :answer-field/correct {:answer/id #uuid "4245b790-1a22-59f1-b2b1-ec25d43743c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3({e}^{2}+1)" :db/id #edb/ref 17592186572902} :answer-field/id #uuid "8946e118-e7e3-5ee7-9e3c-9199dfb40a0e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573199}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8f2aebee-176b-5447-94e6-cdb44a5559c2" :question/math-academy-id "q-351023" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{{e}^{2}}\\operatorname{ln}⁡({x}^{3})\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we write the integral as\n\n$$\n{\\int }_{1}^{{e}^{2}}\\operatorname{ln}⁡({x}^{3})\\,\\text{d}x={\\int }_{1}^{{e}^{2}}\\operatorname{ln}⁡({x}^{3})\\cdot 1\\cdot \\text{d}x.\n$$\n\n \n\nWe will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡({x}^{3})\\, & ⟹\\,{u}^{′}=\\frac{3}{x} \\\\ {v}^{′}=1\\, & ⟹\\,v=\\int 1\\cdot \\,dx=x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{{e}^{2}}\\operatorname{ln}⁡({x}^{3})\\,\\text{d}x & ={\\int }_{1}^{{e}^{2}}u{v}^{′}\\text{d}x \\\\  & =uv{|}_{1}^{{e}^{2}}-{\\int }_{1}^{{e}^{2}}v{u}^{′}\\text{d}x \\\\  & =\\operatorname{ln}⁡({x}^{3})\\,(x){|}_{1}^{{e}^{2}}-{\\int }_{1}^{{e}^{2}}x(\\frac{3}{x})\\,\\text{d}x \\\\  & =[\\operatorname{ln}⁡(({e}^{2})^{3})\\,({e}^{2})-\\operatorname{ln}⁡({1}^{3})\\,(1)]-3{\\int }_{1}^{{e}^{2}}\\text{d}x \\\\  & ={e}^{2}\\operatorname{ln}⁡({e}^{6})-3x{|}_{1}^{{e}^{2}} \\\\  & =6{e}^{2}-3({e}^{2}-1) \\\\  & =3({e}^{2}+1).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186573309 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21db6ee1-4f00-52f4-bdef-e6f8f76bdece" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi" :db/id #edb/ref 17592186572866} {:answer/id #uuid "393180ce-477f-5b4c-ade3-c57dfc5fc14e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi" :db/id #edb/ref 17592186572882} {:answer/id #uuid "764e658d-447d-5f2a-93a6-3aa41f77521f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186572975} {:answer/id #uuid "d0b25d82-2de9-525d-98e6-baf42b5cc386" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186573088} {:answer/id #uuid "d2d93958-0196-5461-ae0e-a6c55afcd4bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186573090}] :answer-field/correct {:answer/id #uuid "764e658d-447d-5f2a-93a6-3aa41f77521f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186572975} :answer-field/id #uuid "a9c57c23-5852-5310-9404-decf58de586e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573210}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d1c19cde-3b7d-5f98-929b-d663820d03f1" :question/math-academy-id "q-152866" :question/problem "What is the value of ${lim}_{x\\to \\,\\infty }2\\operatorname{arccos}⁡(\\frac{x-4}{2})?$" :question/worked-solution "First, let's sketch the graph of $y=\\operatorname{arccos}⁡(\\frac{x-4}{2}):$ \n\n![](images/ff/fffe2ba1124b8edd04902db5ad2b0945e5e04372ae0a0ed338c893f0ae417c58.png)\n\nThe domain of $\\operatorname{arccos}⁡(\\frac{x-4}{2})$ is $x\\in [2,6].$ This means that $\\operatorname{arccos}⁡(\\frac{x-4}{2})$ is undefined outside this interval.\n\nTherefore, ${lim}_{x\\to \\,\\infty }2\\operatorname{arccos}⁡(\\frac{x-4}{2})$ is undefined."} {:db/id #edb/ref 17592186573869 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "096a33d6-d118-5767-9aef-e8a314eac3cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{({x}^{2}+{y}^{2}+{z}^{2})^{1/2}}(x\\,i+y\\,j+z\\,k)" :db/id #edb/ref 17592186573435} {:answer/id #uuid "3070acd5-da6e-5912-9c2f-3fa61b9ecd1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{({x}^{2}+{y}^{2}+{z}^{2})^{3/2}}({x}^{2}\\,i+{y}^{2}\\,j+{z}^{2}\\,k)" :db/id #edb/ref 17592186573486} {:answer/id #uuid "bb0eed41-4001-5d69-afa8-86d50d932215" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{({x}^{2}+{y}^{2}+{z}^{2})^{1/2}}({x}^{2}\\,i+{y}^{2}\\,j+{z}^{2}\\,k)" :db/id #edb/ref 17592186573665} {:answer/id #uuid "df98d7d6-f700-5365-a939-7b86231547af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{({x}^{2}+{y}^{2}+{z}^{2})^{3/2}}(x\\,i+y\\,j+z\\,k)" :db/id #edb/ref 17592186573717} {:answer/id #uuid "fe18764d-76e8-51ba-bcfd-15ecbbf56867" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{({x}^{2}+{y}^{2}+{z}^{2})^{3/2}}(x\\,i+y\\,j+z\\,k)" :db/id #edb/ref 17592186573766}] :answer-field/correct {:answer/id #uuid "df98d7d6-f700-5365-a939-7b86231547af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{({x}^{2}+{y}^{2}+{z}^{2})^{3/2}}(x\\,i+y\\,j+z\\,k)" :db/id #edb/ref 17592186573717} :answer-field/id #uuid "ccf85ad2-68ea-542a-9e96-be9081261312" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573845}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0d01726f-52af-5592-8eb9-d6abaee05cc0" :question/math-academy-id "q-127950" :question/problem "Find $∇f(x,y,z),$  given that $f(x,y,z)=\\frac{1}{({x}^{2}+{y}^{2}+{z}^{2})^{1/2}}.$" :question/worked-solution "First, we find the partial derivatives: \n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}) \\\\  & =-\\frac{x}{({x}^{2}+{y}^{2}+{z}^{2})^{3/2}} \\\\ {f}_{y}(x,y,z) & =\\frac{∂}{∂y}(\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}) \\\\  & =-\\frac{y}{({x}^{2}+{y}^{2}+{z}^{2})^{3/2}} \\\\ {f}_{z}(x,y,z) & =\\frac{∂}{∂z}(\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}) \\\\  & =-\\frac{z}{({x}^{2}+{y}^{2}+{z}^{2})^{3/2}}.\\end{aligned}\n$$\n\nHence, the gradient is\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\text{ }i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =(-\\frac{x}{({x}^{2}+{y}^{2}+{z}^{2})^{3/2}})i+(-\\frac{y}{({x}^{2}+{y}^{2}+{z}^{2})^{3/2}})j+(-\\frac{z}{({x}^{2}+{y}^{2}+{z}^{2})^{3/2}})k \\\\  & =-\\frac{1}{({x}^{2}+{y}^{2}+{z}^{2})^{3/2}}(x\\,i+y\\,j+z\\,k)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186573884 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31ca1017-57c8-5ef7-81bf-c0e0cc05312b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{csc}^{2}⁡x}{3}" :db/id #edb/ref 17592186573488} {:answer/id #uuid "3e2b4496-dac0-5fac-821c-8e4a87a5a680" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{csc}⁡x}{3}" :db/id #edb/ref 17592186573499} {:answer/id #uuid "58eab979-5e52-573b-b85f-2b987d06d42c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{csc}^{2}⁡x}{6}" :db/id #edb/ref 17592186573537} {:answer/id #uuid "91d3d8a7-03f3-5511-8583-848757ecc77d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{csc}^{2}⁡x" :db/id #edb/ref 17592186573614} {:answer/id #uuid "bc921c14-4169-5d8d-9dc9-1252148fcc6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{csc}^{2}⁡x}{3}" :db/id #edb/ref 17592186573668}] :answer-field/correct {:answer/id #uuid "31ca1017-57c8-5ef7-81bf-c0e0cc05312b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{csc}^{2}⁡x}{3}" :db/id #edb/ref 17592186573488} :answer-field/id #uuid "17c99eca-6d45-5641-8c24-6f647f6d895f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573780}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4cc89078-03c5-53b0-908e-62267303049d" :question/math-academy-id "q-31285" :question/problem "Find ${f}^{′}(x)$ if $f(x)=\\frac{\\operatorname{cot}⁡x}{3}.$" :question/worked-solution "Here, we just take the constant out of the derivative and use the result for the derivative of $\\operatorname{cot}⁡x,$ as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\operatorname{cot}⁡x}{3}) \\\\  & =\\frac{1}{3}(-{csc}^{2}⁡x) \\\\  & =-\\frac{{csc}^{2}⁡x}{3}\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186573885 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08c2b08f-4b86-5a28-b207-246ddaeede47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186573433}] :answer-field/correct {:answer/id #uuid "08c2b08f-4b86-5a28-b207-246ddaeede47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186573433} :answer-field/id #uuid "fa757127-e918-5b58-b712-d77618d9d911" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573862}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "525be19b-f128-5226-ba8b-06889781710d" :question/math-academy-id "q-278085" :question/problem "The $3$rd term of a geometric sequence is $200$, and the common ratio is $\\frac{5}{4}.$ The first term of this sequence to exceed $8\\,000$ is the{{field-1}} th term." :question/worked-solution "Since we are given that ${a}_{3}=200$ and  $r=\\frac{5}{4}$, we can use the $n$th term formula to solve for ${a}_{1}$, as follows:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}\\cdot {r}^{n-1} \\\\ {a}_{3} & ={a}_{1}\\cdot {(\\frac{5}{4})}^{3-1} \\\\ 200 & ={a}_{1}\\cdot {(\\frac{5}{4})}^{2} \\\\ 200 & =\\frac{25}{16}{a}_{1} \\\\ {a}_{1} & =128\\end{aligned}\n$$\n\nSo, the $n$th term of the geometric sequence is\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}\\cdot {r}^{n-1} \\\\  & =128\\cdot {(\\frac{5}{4})}^{n-1}.\\end{aligned}\n$$\n\nWe want $n$th term to be greater than $8\\,000.$\nHence,\n\n$$\n\\begin{aligned}128\\cdot {(\\frac{4}{3})}^{n-1} & >8\\,000 \\\\ {(\\frac{5}{4})}^{n-1} & >62.5 \\\\ \\operatorname{log}⁡{(\\frac{5}{4})}^{n-1} & >\\operatorname{log}⁡(62.5) \\\\ (n-1)\\operatorname{log}⁡(\\frac{5}{4}) & >\\operatorname{log}⁡(62.5) \\\\ n-1 & >\\frac{\\operatorname{log}⁡(62.5)}{\\operatorname{log}⁡(\\frac{5}{4})} \\\\ n & >\\frac{\\operatorname{log}⁡(62.5)}{\\operatorname{log}⁡(\\frac{5}{4})}+1.\\end{aligned}\n$$\n\nEstimating the right-hand side using a calculator, we get\n\n$$\n\\frac{\\operatorname{log}⁡(62.5)}{\\operatorname{log}⁡(\\frac{5}{4})}+1≈19.531.\n$$\n\nTherefore, the $20$th term is the first term of the sequence that exceeds $8\\,000.$"} {:db/id #edb/ref 17592186573886 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "112020b7-c1dc-5924-8da3-4c37054614b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11\\pi \\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186573443} {:answer/id #uuid "5ae00c93-811e-560e-982d-32251eead325" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "176\\pi \\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186573541} {:answer/id #uuid "82290d27-80fe-55ac-96be-796ef54210d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "121\\pi \\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186573595} {:answer/id #uuid "e6eca556-36c6-53c2-9048-34279f043b10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "44\\pi \\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186573729} {:answer/id #uuid "ed9afd95-8543-5258-b9d4-d8e9d27ab3e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "484\\pi \\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186573738}] :answer-field/correct {:answer/id #uuid "82290d27-80fe-55ac-96be-796ef54210d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "121\\pi \\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186573595} :answer-field/id #uuid "149bb160-f7c7-5ff7-9c45-58f490d1c63e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573778}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "54bc8ffe-b872-5461-a4c1-81ec168d4213" :question/math-academy-id "q-13267" :question/problem "A sphere has a diameter of $11\\,\\text{cm}.$ Find the surface area of the sphere." :question/worked-solution "We can calculate the surface area of a sphere using the formula\n\n$$\nS=4\\pi {r}^{2},\n$$\n\nwhere $r$ is the radius of the sphere.\n\nSubstituting $r=\\frac{11}{2}\\,\\text{cm}$ into the formula, we obtain\n\n$$\nS=4\\pi {(\\frac{11}{2})}^{2}=121\\pi \\,{\\text{cm}}^{2}.\n$$"} {:db/id #edb/ref 17592186573887 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0a558a6-da45-59d3-bc0d-39cedb9594ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186573634}] :answer-field/correct {:answer/id #uuid "a0a558a6-da45-59d3-bc0d-39cedb9594ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186573634} :answer-field/id #uuid "8cac1aa5-f45b-54bd-a714-87c9a836435c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573825}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "59bb5b60-160e-59f4-91ef-a981e2cb8f1e" :question/math-academy-id "q-278075" :question/problem "What is the first term that is less than $0.000\\,4$ in the following geometric sequence?\n\n$$\n128,\\,16,\\,2,\\,\\frac{1}{4},\\,…\n$$\n\nThe first term that is less than $0.000\\,4$ is the\n{{field-1}}th term." :question/worked-solution "The first term of the sequence is ${a}_{1}=128$ and the common ratio is\n\n$$\nr=\\frac{16}{128}=\\frac{1}{8}.\n$$\n\nSo, the $n$th term of the sequence can be written as\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}\\cdot {r}^{n-1} \\\\  & =128{(\\frac{1}{8})}^{n-1}.\\end{aligned}\n$$\n\nWe want the $n$th term to be less than $0.000\\,4.$\nHence,\n\n$$\n\\begin{aligned}{a}_{n} & <0.000\\,4 \\\\ 128{(\\frac{1}{8})}^{n-1} & <0.000\\,4 \\\\ {(\\frac{1}{8})}^{n-1} & <\\frac{0.000\\,4}{128} \\\\ \\operatorname{log}⁡{(\\frac{1}{8})}^{n-1} & <\\operatorname{log}⁡(0.000\\,003\\,125) \\\\ (n-1)\\operatorname{log}⁡(\\frac{1}{8}) & <\\operatorname{log}⁡(0.000\\,003\\,125) \\\\ n-1 & >\\frac{\\operatorname{log}⁡(0.000\\,003\\,125)}{\\operatorname{log}⁡(\\frac{1}{8})} \\\\ n & >\\frac{\\operatorname{log}⁡(0.000\\,003\\,125)}{\\operatorname{log}⁡(\\frac{1}{8})}+1.\\end{aligned}\n$$\n\nNote that we reversed the inequality sign when divided by $\\operatorname{log}⁡(\\frac{1}{8})$ because $\\operatorname{log}⁡(\\frac{1}{8})$ is a negative number. \n\nEstimating the right-hand side using a calculator, we get\n\n$$\n\\frac{\\operatorname{log}⁡(0.000\\,003\\,125)}{\\operatorname{log}⁡(\\frac{1}{8})}+1≈7.096.\n$$\n\nTherefore, the $8$th term is the first term of the sequence that is less than $0.000\\,4.$"} {:db/id #edb/ref 17592186573892 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f9f2fc8-badb-5594-8c3a-ed2a49aecc2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n)=-\\frac{3}{2}n+\\frac{1}{2},\\,n\\ge 1" :db/id #edb/ref 17592186573483} {:answer/id #uuid "aa08630a-8958-53e1-8c29-46cc5544822a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n)=-\\frac{3}{2}n+2,\\,n\\ge 1" :db/id #edb/ref 17592186573645} {:answer/id #uuid "c98e8541-844d-564c-9d52-b70e2eab69ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n)=-\\frac{3}{4}n-\\frac{3}{2},\\,n\\ge 1" :db/id #edb/ref 17592186573688} {:answer/id #uuid "d416384f-a3cd-5fbf-8588-a55b76de1f09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n)=-\\frac{3}{4}n-2,\\,n\\ge 1" :db/id #edb/ref 17592186573704} {:answer/id #uuid "d939c8f0-f058-53f1-8e21-649440c7b894" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n)=-\\frac{3}{4}n-\\frac{1}{2},\\,n\\ge 1" :db/id #edb/ref 17592186573711}] :answer-field/correct {:answer/id #uuid "d939c8f0-f058-53f1-8e21-649440c7b894" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n)=-\\frac{3}{4}n-\\frac{1}{2},\\,n\\ge 1" :db/id #edb/ref 17592186573711} :answer-field/id #uuid "cdc27b07-45b8-5bb2-9278-1c5be0b7fdfb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573846}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "69a646b1-c870-5cd4-b54f-601f21d9c0db" :question/math-academy-id "q-45064" :question/problem "What is the explicit formula for the $n$th term of the sequence\n\n$$\nf(n+1)=f(n)-\\frac{3}{4},\\,\\,f(1)=-\\frac{5}{4},\\,\\,n\\ge 1?\n$$" :question/worked-solution "The explicit formula for the $n$th term of an arithmetic sequence (in function notation) is\n\n$$\nf(n)=f(1)+(n-1)d,\\,n\\ge 1,\n$$\n\nso we need to determine the first term $f(1)$ and the common difference $d.$\n\nWe are given that the first term is $f(1)=-\\frac{5}{4},$ and we can use the recursive rule to compute the second term, as follows:\n\n$$\n\\begin{aligned}f(2) & =f(1)-\\frac{3}{4} \\\\  & =-\\frac{5}{4}-\\frac{3}{4} \\\\  & =-2\\end{aligned}\n$$\n\nUsing the first and second terms, we can compute the common difference:\n\n$$\n\\begin{aligned}d & =f(2)-f(1) \\\\  & =-2-(-\\frac{5}{4}) \\\\  & =-\\frac{3}{4}\\end{aligned}\n$$\n\nNow, we substitute $f(1)=-\\frac{5}{4}$ and $d=-\\frac{3}{4}$ into the formula for the $n$th term:\n\n$$\n\\begin{aligned}f(n) & =f(1)+(n-1)d \\\\  & =-\\frac{5}{4}+(n-1)(-\\frac{3}{4}) \\\\  & =-\\frac{5}{4}-\\frac{3}{4}n+\\frac{3}{4} \\\\  & =-\\frac{3}{4}n-\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the formula for the $n$th term is\n\n$$\nf(n)=-\\frac{3}{4}n-\\frac{1}{2},\\,n\\ge 1.\n$$"} {:db/id #edb/ref 17592186573900 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f17b38c0-319c-5a6b-a4a9-b68ba9b75662" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4e^{\\pi/2}" :db/id #edb/ref 17592186573747}] :answer-field/correct {:answer/id #uuid "f17b38c0-319c-5a6b-a4a9-b68ba9b75662" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4e^{\\pi/2}" :db/id #edb/ref 17592186573747} :answer-field/id #uuid "f569b9ca-3244-52df-8874-0fe9df4d2496" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573861}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7ecca825-7d5a-5032-8595-2b767ed0d377" :question/math-academy-id "q-314291" :question/problem "Find the slope $m$ of $y=g(x)$ at $x=\\frac{\\pi }{2}$ if $g(x)=-4{e}^{x}\\operatorname{csc}⁡x+6.$\n\n$m=$\n{{field-1}}" :question/worked-solution "First, we calculate the derivative using the product rule and sum rule:\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}\\,(-4{e}^{x}\\operatorname{csc}⁡x+6) \\\\  & =\\frac{d}{dx}(-4{e}^{x})\\cdot \\operatorname{csc}⁡x+(-4{e}^{x})\\cdot \\frac{d}{dx}(\\operatorname{csc}⁡x)+\\frac{d}{dx}(6) \\\\  & =-4{e}^{x}\\operatorname{csc}⁡x+(-4{e}^{x})(-\\operatorname{csc}⁡x\\operatorname{cot}⁡x)+0 \\\\  & =-4{e}^{x}\\operatorname{csc}⁡x+4{e}^{x}\\operatorname{csc}⁡x\\operatorname{cot}⁡x \\\\  & =-4{e}^{x}\\operatorname{csc}⁡x(1-\\operatorname{cot}⁡x)\\end{aligned}\n$$\n\nNow, we substitute $x=\\frac{\\pi }{2}$ and evaluate the slope $m:$\n\n$$\n\\begin{aligned}m={g}^{′}(\\frac{\\pi }{2}) & =-4{e}^{\\pi /2}\\operatorname{csc}⁡(\\frac{\\pi }{2})(1-\\operatorname{cot}⁡(\\frac{\\pi }{2})) \\\\  & =-4{e}^{\\pi /2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186573906 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55d9002e-7527-50cc-b173-50109757113f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186573530}] :answer-field/correct {:answer/id #uuid "55d9002e-7527-50cc-b173-50109757113f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186573530} :answer-field/id #uuid "41e36901-ce9f-5fd2-ac48-592419a20007" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573798}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8cb20152-3f82-5426-99bf-afc35d2d2b76" :question/math-academy-id "q-278076" :question/problem "What is the first term that is less than $1$ in the following geometric sequence?\n\n$$\n125,\\,75,\\,45,\\,27,\\,…\n$$\n\nThe first term that is less than $1$ is the\n{{field-1}}th term." :question/worked-solution "The first term of the sequence is ${a}_{1}=125$ and the common ratio is\n\n$$\nr=\\frac{75}{125}=\\frac{3}{5}.\n$$\n\nSo, the $n$th term of the sequence can be written as\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}\\cdot {r}^{n-1} \\\\  & =125{(\\frac{3}{5})}^{n-1}.\\end{aligned}\n$$\n\nWe want the $n$th term to be less than $1.$\nHence,\n\n$$\n\\begin{aligned}{a}_{n} & <1 \\\\ 125{(\\frac{3}{5})}^{n-1} & <1 \\\\ {(\\frac{3}{5})}^{n-1} & <\\frac{1}{125} \\\\ \\operatorname{log}⁡{(\\frac{3}{5})}^{n-1} & <\\operatorname{log}⁡(0.008) \\\\ (n-1)\\operatorname{log}⁡(\\frac{3}{5}) & <\\operatorname{log}⁡(0.008) \\\\ n-1 & >\\frac{\\operatorname{log}⁡(0.008)}{\\operatorname{log}⁡(\\frac{3}{5})} \\\\ n & >\\frac{\\operatorname{log}⁡(0.008)}{\\operatorname{log}⁡(\\frac{3}{5})}+1.\\end{aligned}\n$$\n\nNote that we reversed the inequality sign when divided by $\\operatorname{log}⁡(\\frac{3}{5})$ because $\\operatorname{log}⁡(\\frac{3}{5})$ is a negative number. \n\nEstimating the right-hand side using a calculator, we get\n\n$$\n\\frac{\\operatorname{log}⁡(0.008)}{\\operatorname{log}⁡(\\frac{3}{5})}+1≈10.452.\n$$\n\nTherefore, the $11$th term is the first term of the sequence that is less than $1.$"} {:db/id #edb/ref 17592186573915 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1939f72d-64d6-54bc-bd4a-8b8702fde750" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "the $17$th term" :db/id #edb/ref 17592186573448} {:answer/id #uuid "6e861090-f70a-554c-874f-5299c3170e4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "the $16$th term" :db/id #edb/ref 17592186573559} {:answer/id #uuid "c758b9b0-3e71-524d-b24e-646ee983b547" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "the $14$th term" :db/id #edb/ref 17592186573681} {:answer/id #uuid "cccbc5f5-87bb-59f1-bad5-8c3a748710a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "the $15$th term" :db/id #edb/ref 17592186573693} {:answer/id #uuid "ed3d62c8-3dd0-5c05-859f-f145a44be51a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "the $18$th term" :db/id #edb/ref 17592186573737}] :answer-field/correct {:answer/id #uuid "6e861090-f70a-554c-874f-5299c3170e4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "the $16$th term" :db/id #edb/ref 17592186573559} :answer-field/id #uuid "f1ab172e-649a-555e-92e9-4be54273ab03" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573855}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b67cf463-2810-5439-8050-fefe332f47c4" :question/math-academy-id "q-39650" :question/problem "What is the first term that is less than $0.000\\,3$ in the following geometric sequence?\n\n$$\n125,\\,50,\\,20,\\,8,\\,…\n$$" :question/worked-solution "The first term of the sequence is ${a}_{1}=125$ and the common ratio is\n\n$$\nr=\\frac{50}{125}=\\frac{2}{5}.\n$$\n\nSo, the $n$th term of the sequence can be written as:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}\\cdot {r}^{n-1} \\\\  & =125{(\\frac{2}{5})}^{n-1}\\end{aligned}\n$$\n\nWe want the $n$th term to be less than $0.000\\,3.$\nHence:\n\n$$\n\\begin{aligned}{a}_{n} & <0.000\\,3 \\\\ 125{(\\frac{2}{5})}^{n-1} & <0.000\\,3 \\\\ {(\\frac{2}{5})}^{n-1} & <\\frac{0.000\\,3}{125} \\\\ \\operatorname{log}⁡{(\\frac{2}{5})}^{n-1} & <\\operatorname{log}⁡(0.000\\,002\\,4) \\\\ (n-1)\\operatorname{log}⁡(\\frac{2}{5}) & <\\operatorname{log}⁡(0.000\\,002\\,4) \\\\ n-1 & >\\frac{\\operatorname{log}⁡(0.000\\,002\\,4)}{\\operatorname{log}⁡(\\frac{2}{5})} \\\\ n & >\\frac{\\operatorname{log}⁡(0.000\\,002\\,4)}{\\operatorname{log}⁡(\\frac{2}{5})}+1\\end{aligned}\n$$\n\nNote that we reversed the inequality sign when divided by $\\operatorname{log}⁡(\\frac{2}{5})$ because $\\operatorname{log}⁡(\\frac{2}{5})$ is a negative number. \n\nEstimating the right-hand side using a calculator, we get:\n\n$$\n\\frac{\\operatorname{log}⁡(0.000\\,002\\,4)}{\\operatorname{log}⁡(\\frac{2}{5})}+1≈15.122\n$$\n\nTherefore, the $16$th term is the first term of the sequence that is less than $0.000\\,3.$"} {:db/id #edb/ref 17592186573920 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5056940e-4ed6-57c1-98d4-4fb3c997ca37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186573519} {:answer/id #uuid "51c16e8a-861d-5b18-8212-02c138fd98e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186573524} {:answer/id #uuid "594f4473-d5d3-5e62-ba23-fb73f10a2a45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186573539} {:answer/id #uuid "6f7db02d-2075-52b7-84d1-4b1556734474" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186573562} {:answer/id #uuid "c3378176-d404-5491-a008-d4a30c633beb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186573678}] :answer-field/correct {:answer/id #uuid "51c16e8a-861d-5b18-8212-02c138fd98e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186573524} :answer-field/id #uuid "b308e7df-567f-5cd4-b865-053b904c951e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573837}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c089daaf-37cc-52fb-a2a0-6074ff898dc3" :question/math-academy-id "q-105501" :question/problem "![](images/a8/a8345270e511644cfb019099b907ecadff056f7efbd396e84d4313f3c3ab5817.png)\n\nThe graphs of the functions $y=f(x)$ and $y=g(x)$ are given above. Find ${h}^{′}(3)$ where $h(x)=f(x)-2g(x).$" :question/worked-solution "The addition and constant multiple rules for derivatives give\n\n$$\n{h}^{′}(x)={f}^{′}(x)-2{g}^{′}(x).\n$$\n\nAs a result, we have that\n\n$$\n{h}^{′}(3)={f}^{′}(3)-2{g}^{′}(3).\n$$\n\nAlso, notice that $x=3$ corresponds to\n\n- the interval $x\\in (2,4)$ for the function $f,$ and\n\n- the interval $x\\in (0,4)$ for the function $g,$\n\nas shown below.\n\n![](images/09/09e4836acd54b814c1691c60003614d206fc2eee5cda6d7ad8d6222dd72d2d4f.png)\n\n- The slope of $y=f(x)$ is constant on $x\\in (2,4)$ and equals\n\n$$\n\\frac{Δf}{Δx}=\\frac{-2-2}{4-2}=-2.\n$$\n\nTherefore, ${f}^{′}(3)=-2.$\n\n- The slope of $y=g(x)$ is constant on $x\\in (0,4)$ and equals\n\n$$\n\\frac{Δg}{Δx}=\\frac{-2-0}{4-0}=-\\frac{1}{2}.\n$$\n\nTherefore, ${g}^{′}(3)=-\\frac{1}{2}.$\n\nFinally, we have\n\n$$\n\\begin{aligned}{h}^{′}(3) & ={f}^{′}(3)-2{g}^{′}(3) \\\\  & =-2-2\\cdot (-\\frac{1}{2}) \\\\  & =-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186573927 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74c07577-fe74-57ba-92fc-1b9280d85d7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{csc}⁡x\\operatorname{cot}⁡x-2\\operatorname{csc}⁡x}{{e}^{x}}" :db/id #edb/ref 17592186573572} {:answer/id #uuid "7d45dcf9-cbe1-5b7a-9d59-7c86fbbe2bf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{csc}⁡x\\operatorname{cot}⁡x+2\\operatorname{csc}⁡x}{{e}^{2x}}" :db/id #edb/ref 17592186573587} {:answer/id #uuid "9f6d0573-3d9b-5c60-8903-5e05b999e172" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{csc}⁡x\\operatorname{cot}⁡x-2\\operatorname{csc}⁡x-5}{{e}^{2x}}" :db/id #edb/ref 17592186573632} {:answer/id #uuid "b2eaad33-5562-59b1-ad3b-d8ad6f3fdf8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{csc}⁡x\\operatorname{cot}⁡x+2\\operatorname{csc}⁡x-5}{{e}^{x}}" :db/id #edb/ref 17592186573657} {:answer/id #uuid "f0c61ed6-c60f-5bd5-a4e4-5d7a2115c00f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{csc}⁡x\\operatorname{cot}⁡x+2\\operatorname{csc}⁡x-5}{{e}^{x}}" :db/id #edb/ref 17592186573745}] :answer-field/correct {:answer/id #uuid "f0c61ed6-c60f-5bd5-a4e4-5d7a2115c00f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{csc}⁡x\\operatorname{cot}⁡x+2\\operatorname{csc}⁡x-5}{{e}^{x}}" :db/id #edb/ref 17592186573745} :answer-field/id #uuid "dfaf8be5-c89e-56c8-8f96-19125ea0ec9f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573852}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cdd054fb-7789-52a0-9a24-44d711412a5f" :question/math-academy-id "q-104314" :question/problem "Find ${f}^{′}(x)$ if $f(x)=\\frac{5-2\\operatorname{csc}⁡x}{{e}^{x}}.$" :question/worked-solution "We calculate the derivative using the quotient rule, as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{5-2\\operatorname{csc}⁡x}{{e}^{x}}) \\\\  & =\\frac{(2\\operatorname{csc}⁡x\\operatorname{cot}⁡x){e}^{x}-(5-2\\operatorname{csc}⁡x){e}^{x}}{({e}^{x})^{2}} \\\\  & =\\frac{{e}^{x}(2\\operatorname{csc}⁡x\\operatorname{cot}⁡x-5+2\\operatorname{csc}⁡x)}{{e}^{2x}} \\\\  & =\\frac{2\\operatorname{csc}⁡x\\operatorname{cot}⁡x+2\\operatorname{csc}⁡x-5}{{e}^{x}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186573928 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e191e44-d94c-5870-b0c8-ced1667641d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}}}((x-y\\operatorname{arctan}⁡(\\frac{x}{y}))i+(y-x\\operatorname{arctan}⁡(\\frac{x}{y}))j)" :db/id #edb/ref 17592186573456} {:answer/id #uuid "6ab883f7-d2c5-5df8-91ea-93715df943d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}}}((y+x\\operatorname{arctan}⁡(\\frac{x}{y}))i+(y\\operatorname{arctan}⁡(\\frac{x}{y})-x)j)" :db/id #edb/ref 17592186573554} {:answer/id #uuid "8f2d08a1-9016-5fb7-8c20-20d22247482a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{{x}^{2}+{y}^{2}}((x-y\\operatorname{arctan}⁡(\\frac{x}{y}))i+(y-x\\operatorname{arctan}⁡(\\frac{x}{y}))j)" :db/id #edb/ref 17592186573607} {:answer/id #uuid "cd63465f-5f06-58e0-beae-c3c0a61fc922" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{{x}^{2}+{y}^{2}}((y-x\\operatorname{arctan}⁡(\\frac{x}{y}))i+(x+y\\operatorname{arctan}⁡(\\frac{x}{y}))j)" :db/id #edb/ref 17592186573695} {:answer/id #uuid "d1205bef-1a93-51b6-9180-985157270273" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}}}((y-x\\operatorname{arctan}⁡(\\frac{x}{y}))i+(x+y\\operatorname{arctan}⁡(\\frac{x}{y}))j)" :db/id #edb/ref 17592186573701}] :answer-field/correct {:answer/id #uuid "6ab883f7-d2c5-5df8-91ea-93715df943d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}}}((y+x\\operatorname{arctan}⁡(\\frac{x}{y}))i+(y\\operatorname{arctan}⁡(\\frac{x}{y})-x)j)" :db/id #edb/ref 17592186573554} :answer-field/id #uuid "78f99c31-3839-5c38-b360-b7a08fb69629" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573819}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ce288280-35f0-55c7-872a-791cfea323e8" :question/math-academy-id "q-128528" :question/problem "Find the gradient of the product $f(x,y)h(x,y),$ given that \n\n$$\n\\begin{aligned}f(x,y) & =\\operatorname{arctan}⁡(\\frac{x}{y}),\\, &  & ∇f(x,y)=\\frac{y}{{x}^{2}+{y}^{2}}\\,i-\\frac{x}{{x}^{2}+{y}^{2}}\\,j, &  &  \\\\ h(x,y) & =\\sqrt{{x}^{2}+{y}^{2}},\\, &  & ∇h(x,y)=\\frac{x}{\\sqrt{{x}^{2}+{y}^{2}}}\\,i+\\frac{y}{\\sqrt{{x}^{2}+{y}^{2}}}\\,j. &  & \\end{aligned}\n$$" :question/worked-solution "The gradient of the product of two functions $f(x,y)$ and $h(x,y)$ is given by\n\n$$\n∇[fh]=h∇f+f∇h.\n$$\n\nUsing the product rule, we obtain\n\n$$\n\\begin{aligned}∇[f(x,y)h(x,y)] & =h(x,y)∇f(x,y)+f(x,y)∇h(x,y) \\\\  & =\\sqrt{{x}^{2}+{y}^{2}}(\\frac{y}{{x}^{2}+{y}^{2}}\\,i-\\frac{x}{{x}^{2}+{y}^{2}}\\,j)+\\operatorname{arctan}⁡(\\frac{x}{y})(\\frac{x}{\\sqrt{{x}^{2}+{y}^{2}}}\\,i+\\frac{y}{\\sqrt{{x}^{2}+{y}^{2}}}\\,j) \\\\  & =\\frac{y\\sqrt{{x}^{2}+{y}^{2}}}{{x}^{2}+{y}^{2}}\\,i-\\frac{x\\sqrt{{x}^{2}+{y}^{2}}}{{x}^{2}+{y}^{2}}\\,j+\\frac{x\\operatorname{arctan}⁡(\\frac{x}{y})}{\\sqrt{{x}^{2}+{y}^{2}}}\\,i+\\frac{y\\operatorname{arctan}⁡(\\frac{x}{y})}{\\sqrt{{x}^{2}+{y}^{2}}}\\,j \\\\  & =\\frac{y}{\\sqrt{{x}^{2}+{y}^{2}}}\\,i-\\frac{x}{\\sqrt{{x}^{2}+{y}^{2}}}\\,j+\\frac{x\\operatorname{arctan}⁡(\\frac{x}{y})}{\\sqrt{{x}^{2}+{y}^{2}}}\\,i+\\frac{y\\operatorname{arctan}⁡(\\frac{x}{y})}{\\sqrt{{x}^{2}+{y}^{2}}}\\,j \\\\  & =\\frac{y+x\\operatorname{arctan}⁡(\\frac{x}{y})}{\\sqrt{{x}^{2}+{y}^{2}}}\\,i+\\frac{y\\operatorname{arctan}⁡(\\frac{x}{y})-x}{\\sqrt{{x}^{2}+{y}^{2}}}\\,j \\\\  & =\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}}}((y+x\\operatorname{arctan}⁡(\\frac{x}{y}))i+(y\\operatorname{arctan}⁡(\\frac{x}{y})-x)j).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186573931 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "022011de-7f19-5ce1-916b-c7ebb86d7571" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\pi \\,{\\text{in}}^{2}" :db/id #edb/ref 17592186573424} {:answer/id #uuid "881394f8-3bd3-500f-895d-a5578ce3ddf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\pi \\,{\\text{in}}^{2}" :db/id #edb/ref 17592186573599} {:answer/id #uuid "b08c11e4-bbc4-5e1f-8e8f-34083122aa5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\pi \\,{\\text{in}}^{2}" :db/id #edb/ref 17592186573654} {:answer/id #uuid "bac69540-9e9d-5b5b-9b52-1e8c447f2fea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27}{2}\\pi \\,{\\text{in}}^{2}" :db/id #edb/ref 17592186573664} {:answer/id #uuid "d46231fb-b6d7-59ad-b1f7-9ebad947a791" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\pi \\,{\\text{in}}^{2}" :db/id #edb/ref 17592186573705}] :answer-field/correct {:answer/id #uuid "022011de-7f19-5ce1-916b-c7ebb86d7571" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\pi \\,{\\text{in}}^{2}" :db/id #edb/ref 17592186573424} :answer-field/id #uuid "97beb415-0421-5ab8-b51b-bc4a99823288" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573827}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d4951800-9f16-50a9-8666-315cfa908dd9" :question/math-academy-id "q-108136" :question/problem "![](images/ca/ca021f8684431c29f48876fc2a079f9e23931862f37f8f0dd4b1c2f73a87169d.png)\n\nFind the surface area of the sphere above, given that its volume is $\\frac{9}{2}\\pi \\,{\\text{in}}^{3}.$" :question/worked-solution "We can find the volume of a sphere using the formula\n\n$$\nV=\\frac{4}{3}\\pi {r}^{3},\n$$\n\nwhere $r$ is the radius of the sphere.\n\nSubstituting $V=\\frac{9}{2}\\pi \\,{\\text{in}}^{3}$ into the formula, we can solve for $r$ as follows:\n\n$$\n\\begin{aligned}V & =\\frac{4}{3}\\pi {r}^{3} \\\\ \\frac{9}{2}\\pi  & =\\frac{4}{3}\\pi {r}^{3} \\\\ \\frac{9\\pi \\cdot 3}{2\\cdot 4\\pi } & ={r}^{3} \\\\ {r}^{3} & =\\frac{27}{8} \\\\  & =\\frac{{3}^{3}}{{2}^{3}} \\\\  & ={(\\frac{3}{2})}^{3} \\\\ r & =\\frac{3}{2}\\,\\text{in}\\end{aligned}\n$$\n\n \n\nFinally, the surface area of ​​the sphere can be found as follows:\n\n$$\n\\begin{aligned}S & =4\\pi {r}^{2} \\\\  & =4\\pi {(\\frac{3}{2})}^{2} \\\\  & =9\\pi \\,{\\text{in}}^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186573935 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5117e655-c6d3-59fa-a58b-c792581abb27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186573521}] :answer-field/correct {:answer/id #uuid "5117e655-c6d3-59fa-a58b-c792581abb27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186573521} :answer-field/id #uuid "4d601646-0a54-5c73-8308-0c6b5ed39be8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573801}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e0ccb719-0526-539f-8346-82d0473506ac" :question/math-academy-id "q-278084" :question/problem "The $4$th term of a geometric sequence is $192$, and the common ratio is $\\frac{4}{3}.$ The first term of this sequence to exceed $3\\,078$ is the{{field-1}} th term." :question/worked-solution "Since we are given that ${a}_{4}=192$ and  $r=\\frac{4}{3}$, we can use the $n$th term formula to solve for ${a}_{1}$, as follows:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}\\cdot {r}^{n-1} \\\\ {a}_{4} & ={a}_{1}\\cdot {(\\frac{4}{3})}^{4-1} \\\\ 192 & ={a}_{1}\\cdot {(\\frac{4}{3})}^{3} \\\\ 192 & =\\frac{64}{27}{a}_{1} \\\\ {a}_{1} & =81\\end{aligned}\n$$\n\nSo, the $n$th term of the geometric sequence is\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}\\cdot {r}^{n-1} \\\\  & =81\\cdot {(\\frac{4}{3})}^{n-1}.\\end{aligned}\n$$\n\nWe want $n$th term to be greater than $3\\,078.$\nHence,\n\n$$\n\\begin{aligned}81\\cdot {(\\frac{4}{3})}^{n-1} & >3\\,078 \\\\ {(\\frac{4}{3})}^{n-1} & >38 \\\\ \\operatorname{log}⁡{(\\frac{4}{3})}^{n-1} & >\\operatorname{log}⁡(38) \\\\ (n-1)\\operatorname{log}⁡(\\frac{4}{3}) & >\\operatorname{log}⁡(38) \\\\ n-1 & >\\frac{\\operatorname{log}⁡(38)}{\\operatorname{log}⁡(\\frac{4}{3})} \\\\ n & >\\frac{\\operatorname{log}⁡(38)}{\\operatorname{log}⁡(\\frac{4}{3})}+1.\\end{aligned}\n$$\n\nEstimating the right-hand side using a calculator, we get\n\n$$\n\\frac{\\operatorname{log}⁡(38)}{\\operatorname{log}⁡(\\frac{4}{3})}+1≈13.644.\n$$\n\nTherefore, the $14$th term is the first term of the sequence that exceeds $3\\,078.$"} {:db/id #edb/ref 17592186573936 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0edb8693-647d-59b4-b760-4e1b199e6824" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "the $16$th term" :db/id #edb/ref 17592186573440} {:answer/id #uuid "209399c3-a38a-5613-9a3a-1c6de859cd72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "the $13$th term" :db/id #edb/ref 17592186573459} {:answer/id #uuid "5b5413ab-bc06-5845-9a9d-5f8befa9750a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "the $15$th term" :db/id #edb/ref 17592186573542} {:answer/id #uuid "a0d3486e-bf73-59ce-9808-d924ea025065" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "the $11$th term" :db/id #edb/ref 17592186573635} {:answer/id #uuid "f7d1d824-5393-515b-b997-5c61c2e7069c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "the $14$th term" :db/id #edb/ref 17592186573760}] :answer-field/correct {:answer/id #uuid "f7d1d824-5393-515b-b997-5c61c2e7069c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "the $14$th term" :db/id #edb/ref 17592186573760} :answer-field/id #uuid "67ba2bb6-0524-5fd3-9617-ca3e6c50fb7d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573816}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e0f0f519-39b1-5bf5-a763-c3c4f5d95f00" :question/math-academy-id "q-39653" :question/problem "The $6$th term of a geometric sequence is $\\frac{1}{4}$, and the common ratio is $\\frac{1}{2}.$ What is the first term of this sequence to be less than\n$0.001\\,2?$" :question/worked-solution "Since we are given that ${a}_{6}=\\frac{1}{4}$ and  $r=\\frac{1}{2}$, we can use the $n$th term formula to solve for ${a}_{1}$, as follows:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}\\cdot {r}^{n-1} \\\\ {a}_{6} & ={a}_{1}\\cdot {(\\frac{1}{2})}^{6-1} \\\\ \\frac{1}{4} & ={a}_{1}\\cdot \\frac{1}{{2}^{5}} \\\\ \\frac{1}{4} & =\\frac{1}{32}{a}_{1} \\\\ {a}_{1} & =8\\end{aligned}\n$$\n\nSo the $n$th term of the geometric sequence is\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}\\cdot {r}^{n-1} \\\\  & =8\\cdot {(\\frac{1}{2})}^{n-1} \\\\  & ={2}^{3}\\cdot {2}^{1-n} \\\\  & ={2}^{4-n}.\\end{aligned}\n$$\n\nWe want the $n$th term to be less than $0.001\\,2.$\nHence:\n\n$$\n\\begin{aligned}{2}^{4-n} & <0.001\\,2 \\\\ \\operatorname{log}⁡(2)^{4-n} & <\\operatorname{log}⁡(0.001\\,2) \\\\ (4-n)\\operatorname{log}⁡(2) & <\\operatorname{log}⁡(0.001\\,2) \\\\ 4-n & <\\frac{\\operatorname{log}⁡(0.001\\,2)}{\\operatorname{log}⁡(2)} \\\\ -n & <\\frac{\\operatorname{log}⁡(0.001\\,2)}{\\operatorname{log}⁡(2)}-4 \\\\ n & >4-\\frac{\\operatorname{log}⁡(0.001\\,2)}{\\operatorname{log}⁡(2)}\\end{aligned}\n$$\n\nEstimating the right-hand side using a calculator, we get:\n\n$$\n4-\\frac{\\operatorname{log}⁡(0.001\\,2)}{\\operatorname{log}⁡(2)}≈13.703\n$$\n\nTherefore, the $14$th term is the first term of the sequence that is less than $0.001\\,2.$"} {:db/id #edb/ref 17592186573940 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e50b1bba-38d1-5105-8700-91d45010831f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186573726}] :answer-field/correct {:answer/id #uuid "e50b1bba-38d1-5105-8700-91d45010831f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186573726} :answer-field/id #uuid "169c3464-e1d8-5414-be39-fcd17c8d800f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573779}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ebe8e960-0d95-59ae-8282-f9852d97bd86" :question/math-academy-id "q-270990" :question/problem "What is the first term that is less than $0.000\\,000\\,5$ in the following geometric sequence?\n\n$$\n\\,\\,\\,\\,256,\\,64,\\,16,\\,4,\\,…\n$$\n\nThe first term that is less than $0.000\\,000\\,5$ is the\n{{field-1}}th term." :question/worked-solution "The first term of the sequence is ${a}_{1}=256$ and the common ratio is\n\n$$\nr=\\frac{64}{256}=\\frac{1}{4}.\n$$\n\nSo, the $n$th term of the sequence can be written as\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}\\cdot {r}^{n-1} \\\\  & =256\\cdot {(\\frac{1}{4})}^{n-1} \\\\  & ={4}^{4}\\cdot {4}^{1-n} \\\\  & ={4}^{5-n}.\\end{aligned}\n$$\n\nWe want the $n$th term to be less than $0.000\\,000\\,5.$\nHence,\n\n$$\n\\begin{aligned}{a}_{n} & <0.000\\,000\\,5 \\\\ {4}^{5-n} & <0.000\\,000\\,5 \\\\ \\operatorname{log}⁡({4}^{5-n}) & <\\operatorname{log}⁡(0.000\\,000\\,5) \\\\ (5-n)\\operatorname{log}⁡(4) & <\\operatorname{log}⁡(0.000\\,000\\,5) \\\\ 5-n & <\\frac{\\operatorname{log}⁡(0.000\\,000\\,5)}{\\operatorname{log}⁡(4)} \\\\ -n & <\\frac{\\operatorname{log}⁡(0.000\\,000\\,5)}{\\operatorname{log}⁡(4)}-5 \\\\ n & >5-\\frac{\\operatorname{log}⁡(0.000\\,000\\,5)}{\\operatorname{log}⁡(4)}.\\end{aligned}\n$$\n\nEstimating the right-hand side using a calculator, we get\n\n$$\n5-\\frac{\\operatorname{log}⁡(0.000\\,000\\,5)}{\\operatorname{log}⁡(4)}≈15.466.\n$$\n\nTherefore, the $16$th term is the first term of the sequence that is less than $0.000\\,000\\,5.$"} {:db/id #edb/ref 17592186573944 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07836247-f997-5dfb-b77d-a88bd5744dd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{(\\frac{1}{3})}^{x}}{\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186573432} {:answer/id #uuid "3c5b76da-5c79-5570-96fc-a1071399ac45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{(\\frac{1}{3})}^{x}}{3\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186573497} {:answer/id #uuid "8096f421-e949-50b4-8f19-80003343c718" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{(\\frac{1}{3})}^{x}+C" :db/id #edb/ref 17592186573592} {:answer/id #uuid "d2eb6285-99de-51bb-896a-d2849f05a9d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\operatorname{ln}⁡3{(\\frac{1}{3})}^{x}+C" :db/id #edb/ref 17592186573702} {:answer/id #uuid "ec976108-75b3-594d-8698-a417623ef1c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3{(\\frac{1}{3})}^{x}+C" :db/id #edb/ref 17592186573734}] :answer-field/correct {:answer/id #uuid "07836247-f997-5dfb-b77d-a88bd5744dd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{(\\frac{1}{3})}^{x}}{\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186573432} :answer-field/id #uuid "2cf68b31-cd10-5161-95fb-e446441e1ca2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573787}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f3a89c81-1f21-57c4-8472-9cb98515b280" :question/math-academy-id "q-71910" :question/problem "Calculate $\\int {(\\frac{1}{3})}^{x}\\,\\text{d}x.$" :question/worked-solution "To compute the integral of a general exponential function, we just need to divide by the natural logarithm of the base of the exponential function:\n\n$$\n\\begin{aligned}\\int {(\\frac{1}{3})}^{x}\\,\\text{d}x & =\\frac{{(\\frac{1}{3})}^{x}}{\\operatorname{ln}⁡(\\frac{1}{3})}+C\\end{aligned}\n$$\n\nUsing the laws of logarithms, we have that\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(\\frac{1}{3}) & =\\operatorname{ln}⁡1-\\operatorname{ln}⁡3 \\\\  & =0-\\operatorname{ln}⁡3 \\\\  & =-\\operatorname{ln}⁡3.\\end{aligned}\n$$\n\nSo, we can simplify our final answer as follows:\n\n$$\n\\begin{aligned}\\frac{{(\\frac{1}{3})}^{x}}{\\operatorname{ln}⁡(\\frac{1}{3})}+C &=-\\frac{{(\\frac{1}{3})}^{x}}{\\operatorname{ln}⁡3}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186574155 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3976ebf7-6b3d-5d75-bc82-0493a2367030" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186574149} {:answer/id #uuid "6012292f-ada4-5f1e-b15c-e205f29be411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186574153} {:answer/id #uuid "8e3213fa-3d2a-5d14-b02a-05a695f6d494" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186574159} {:answer/id #uuid "dc441c99-32fc-557b-a788-4a14865a545e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186574171} {:answer/id #uuid "ed7a1203-8644-5d58-939e-27692ee610af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186574176}] :answer-field/correct {:answer/id #uuid "3976ebf7-6b3d-5d75-bc82-0493a2367030" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186574149} :answer-field/id #uuid "0e4ca334-cd61-566b-a787-dfdfeea731e3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186574144}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6ef39187-2058-5690-ad0a-10e082846d22" :question/problem "What is the amplitude of $f(x) = \\frac{1}{4}\\cos x$?" :question/worked-solution "To plot the given curve, we follow these steps:\n\n- Start with the graph of $y=\\cos x$.\n- Then, shrink it parallel to the $y$-axis by a stretch factor of $\\frac{1}{4}$.\n\nThe resulting graph is shown below.\n\n![](images/22/226ee0669c60cb8b17cf7fadec4b0206051840643e092504a9d639857680d68f.png)\n\nFrom the graph, we see that the maximum value is $y_{\\max}=\\frac{1}{4}$ and the minimum value is $y_{\\min}=-\\frac{1}{4}$. Therefore, the amplitude is\n\n$$\n\\begin{aligned}\n\\mathrm{Amplitude} &= \\frac{y_{\\max}-y_{\\min}}{2} \\\\\n&= \\frac{\\frac{1}{4}-(-\\frac{1}{4})}{2} \\\\\n&= \\frac{\\frac{1}{4}+\\frac{1}{4}}{2} \\\\\n&= \\frac{\\frac{1}{2}}{2} \\\\\n&= \\frac{1}{4}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186575551 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "140b554f-cda0-547b-9903-50ee55410862" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-1,\\frac{1}{2})" :db/id #edb/ref 17592186574982} {:answer/id #uuid "6ae0a243-805e-5331-aeaf-9970f13c6bc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-\\frac{1}{2},1)" :db/id #edb/ref 17592186575140} {:answer/id #uuid "909b3046-2008-57b1-b5df-b71974be8bd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{2}{3},-1,\\frac{1}{4})" :db/id #edb/ref 17592186575198} {:answer/id #uuid "b219bccd-abfe-5f1e-9522-0fceb1758979" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{1}{2},-\\frac{1}{2},\\frac{1}{2})" :db/id #edb/ref 17592186575267} {:answer/id #uuid "bad99448-6cc8-5829-8b73-b4d8c01e4ab7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-2,0)" :db/id #edb/ref 17592186575282}] :answer-field/correct {:answer/id #uuid "140b554f-cda0-547b-9903-50ee55410862" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-1,\\frac{1}{2})" :db/id #edb/ref 17592186574982} :answer-field/id #uuid "1589433d-cfd2-5a34-998a-3aeb17064001" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575413}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6269cc62-3112-546a-8502-b50893c81d78" :question/math-academy-id "q-106587" :question/problem "Find a point that satisfies the mean value theorem for $f(x,y,z)={z}^{2}-{y}^{2}$ on the line segment $\\overset{―}{AB},$ where the position vectors of $A$ and $B$ are $a=⟨-2,0,1⟩$ and $b=⟨0,-2,0⟩,$ respectively." :question/worked-solution "The mean value theorem states that if $f(x,y,z)$ is differentiable at each point on the line segment $\\overset{―}{AB},$ then there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that\n\n$$\nf(b)-f(a)=∇f(c)·(b-a).\n$$\n\nNotice that $f(x,y,z)={z}^{2}-{y}^{2}$ is differentiable at each point on the line segment $\\overset{―}{AB}.$ So, we can apply the mean value theorem.\n\nSubstituting $a=⟨-2,0,1⟩$ and $b=⟨0,-2,0⟩$ into the above expression, we get\n\n$$\n\\begin{aligned}f(0,-2,0)-f(-2,0,1) & =∇f(c)\\cdot (⟨0,-2,0⟩-⟨-2,0,1⟩) \\\\ -4-1 & =∇f(c)\\cdot ⟨2,-2,-1⟩ \\\\ -5 & =∇f(c)\\cdot ⟨2,-2,-1⟩.\\end{aligned}\n$$\n\nComputing $∇f$ and evaluating at $c=⟨{c}_{1},{c}_{2},{c}_{3}⟩,$ we get \n\n$$\n\\begin{aligned}∇f & =⟨0,-2y,2z⟩ \\\\ ∇f(c) & =⟨0,-2{c}_{2},2{c}_{3}⟩.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}-5 & =∇f(c)\\cdot ⟨2,-2,-1⟩ \\\\ -5 & =⟨0,-2{c}_{2},2{c}_{3}⟩\\cdot ⟨2,-2,-1⟩ \\\\ -5 & =4{c}_{2}-2{c}_{3}.\\end{aligned}\n$$\n\nNow, we use the fact that $C$ lies on $\\overset{―}{AB}.$ So, let's first find the equation of the line.\n\n$$\n\\begin{aligned}\\frac{x-(-2)}{2} & =\\frac{y-0}{(-2)}=\\frac{z-1}{(-1)} \\\\ \\frac{x+2}{2} & =-\\frac{y}{2}=1-z\\end{aligned}\n$$\n\nParametrizing the line, we get\n\n$$\nx=2t-2,\\,y=-2t,\\,z=1-t,\\,0\\le t\\le 1.\n$$\n\nSince $c=⟨{c}_{1},{c}_{2},{c}_{3}⟩$ satisfies the equation of the line, we have\n\n$$\n{c}_{1}=2t-2,\\,{c}_{2}=-2t,\\,{c}_{3}=1-t.\n$$\n\nSubstituting the above in the equation $4{c}_{2}-2{c}_{3}=-5,$ we get\n\n$$\n\\begin{aligned}4(-2t)-2(1-t) & =-5 \\\\ -8t-2+2t & =-5 \\\\ -6t & =-3 \\\\ t & =\\frac{1}{2}.\\end{aligned}\n$$\n\nWe can now find the values of ${c}_{1},$ ${c}_{2},$ and ${c}_{3}.$ This gives\n\n$$\n\\begin{aligned}{c}_{1} & =2(\\frac{1}{2})-2=-1, \\\\ {c}_{2} & =-2(\\frac{1}{2})=-1, \\\\ {c}_{3} & =1-(\\frac{1}{2})=\\frac{1}{2}.\\end{aligned}\n$$\n\nFinally, the coordinates of $C$ are $(-1,-1,\\frac{1}{2}).$"} {:db/id #edb/ref 17592186575597 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16850524-a400-5f1a-93bb-271f14089db2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186574984} {:answer/id #uuid "4bf92b52-0c3d-5dbd-ba42-bfbacd464848" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186575079} {:answer/id #uuid "527c209a-b5e6-511e-8fdd-5aa7990f0dc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186575093} {:answer/id #uuid "9111cb01-85f7-57f5-863f-e240e866660b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186575200} {:answer/id #uuid "9e164b4d-5b5c-55c9-b47c-f00bb1a5bfc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186575223}] :answer-field/correct {:answer/id #uuid "9e164b4d-5b5c-55c9-b47c-f00bb1a5bfc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186575223} :answer-field/id #uuid "cd275e51-d3ee-5c23-a80e-981590060edc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575502}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bf906107-b91f-584f-aecf-00f5767c9a3e" :question/math-academy-id "q-48637" :question/problem "Find the slope of the tangent to the curve $y=\\operatorname{sin}⁡(2x)$ at the point where $(\\frac{\\pi }{8},\\frac{\\sqrt{2}}{2}).$" :question/worked-solution "The slope of $y=f(x)$ at $x=\\frac{\\pi }{8}$ is given by ${f}^{′}(\\frac{\\pi }{8}).$\n\nWe will calculate ${f}^{′}(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\n$$\ny=\\operatorname{sin}⁡u,\\,u=2x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\operatorname{cos}⁡u\\,\\text{and}\\,\\frac{\\text{d}u}{\\text{d}x}=2.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =(\\operatorname{cos}⁡u)\\cdot (2) \\\\  & =2\\operatorname{cos}⁡(2x).\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi }{8},$ we find\n\n$$\n\\begin{aligned}{f}^{′}(\\frac{\\pi }{8}) & =2\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{8}) \\\\  & =2\\operatorname{cos}⁡(\\frac{\\pi }{4}) \\\\  & =2\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =\\sqrt{2}\\,.\\end{aligned}\n$$\n\nTherefore, the slope of $y=f(x)$ at $x=\\frac{\\pi }{8}$ is $\\sqrt{2}.$"} {:db/id #edb/ref 17592186575598 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17d5a806-5dea-589a-8695-8f31e73197dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186574986} {:answer/id #uuid "8f531ae2-78a6-5fc5-abf6-8198a3c1c06e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186575194} {:answer/id #uuid "99ed28ff-d2ed-5e0a-b7cc-a3079795073c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186575211} {:answer/id #uuid "a3a3c79b-fcda-5522-aca0-3501669c47af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186575236} {:answer/id #uuid "f1382101-9cdb-5c96-ab81-524b5e88a48f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt{2}" :db/id #edb/ref 17592186575374}] :answer-field/correct {:answer/id #uuid "8f531ae2-78a6-5fc5-abf6-8198a3c1c06e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186575194} :answer-field/id #uuid "28c3ffce-0cd9-54f4-82ea-bc16d219a2b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575431}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c28249c8-4208-5ae9-84ae-7ac8fd4b32fa" :question/math-academy-id "q-48639" :question/problem "Find the slope of the tangent to the curve $y=\\operatorname{cot}⁡(2x)$ at the point $(\\frac{\\pi }{8},1).$" :question/worked-solution "First, the slope of $y=f(x)$ at $x=\\frac{\\pi }{8}$ is given by ${f}^{′}(\\frac{\\pi }{8}).$\n\nWe will calculate ${f}^{′}(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\n$$\nf=\\operatorname{cot}⁡u,\\,u=2x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=-{csc}^{2}⁡u\\,\\text{and}\\,\\frac{\\text{d}u}{\\text{d}x}=2.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-{csc}^{2}⁡u\\cdot (2) \\\\  & =-2{csc}^{2}⁡(2x).\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi }{8}$, we find \n\n$$\n\\begin{aligned}{f}^{′}(\\frac{\\pi }{8}) & =-2{csc}^{2}⁡(2\\cdot \\frac{\\pi }{8}) \\\\  & =-2{csc}^{2}⁡(\\frac{\\pi }{4}) \\\\  & =-2\\cdot {(\\sqrt{2})}^{2} \\\\  & =-4\\,.\\end{aligned}\n$$\n\nTherefore, the slope of $y=f(x)$ at $x=\\frac{\\pi }{8}$ is $-4.$"} {:db/id #edb/ref 17592186575600 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c481408a-4444-530b-b268-67fbe75e182d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186575296}] :answer-field/correct {:answer/id #uuid "c481408a-4444-530b-b268-67fbe75e182d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186575296} :answer-field/id #uuid "2627111a-37e8-5d2c-8a5b-4d5136c68472" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186575429} {:answer-field/choices [{:answer/id #uuid "8324fe7b-ac3f-57ba-80f6-ed595d15ca83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186575183}] :answer-field/correct {:answer/id #uuid "8324fe7b-ac3f-57ba-80f6-ed595d15ca83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186575183} :answer-field/id #uuid "2c8d376b-9f7b-5064-964a-ded341c098b6" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186575437} {:answer-field/choices [{:answer/id #uuid "354b471b-f02d-5a8f-b605-c9b1d7cfa995" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186575039}] :answer-field/correct {:answer/id #uuid "354b471b-f02d-5a8f-b605-c9b1d7cfa995" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186575039} :answer-field/id #uuid "54256760-b370-56e1-8f9d-274cd9ac9901" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186575455}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cc70b07d-530b-5e77-9200-c7de006703f0" :question/math-academy-id "q-348662" :question/problem "What is the value of $g(t)=⟨{3}^{\\,t-1},\\,{log}_{3}⁡({t}^{2}+2t),\\,{sec}^{2}\\,(\\frac{\\pi t}{4})-1⟩$ at $t=1?$\n\n$g(1)=⟨$\n{{field-1}} $,\\,$\n{{field-2}} $,\\,$\n{{field-3}} $⟩$" :question/worked-solution "To evaluate, we substitute $t=1$ into the function, as follows:\n\n$$\n\\begin{aligned}g(1) & =⟨{3}^{1-1},\\,{log}_{3}⁡({1}^{2}+2(1)),\\,{sec}^{2}\\,(\\frac{\\pi }{4})-1⟩ \\\\  & =⟨1,\\,{log}_{3}⁡(3),\\,{(\\sqrt{2})}^{2}-1⟩ \\\\  & =⟨1,\\,1,\\,1⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186575615 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30dfc837-d5c1-5761-8aca-09d8e183f2c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186575033}] :answer-field/correct {:answer/id #uuid "30dfc837-d5c1-5761-8aca-09d8e183f2c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186575033} :answer-field/id #uuid "b8dd47c6-0daf-57eb-b7fa-e36f8f40c1d7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186575487}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e8bf0613-dc2d-57fb-b4e9-45d51faad202" :question/math-academy-id "q-348682" :question/problem "Given that $r(t)=⟨cos\\,(\\frac{\\pi t}{2}),\\,\\frac{4}{t-1}⟩,$ what is $|r(3)|?$\n\n$|r(3)|=$\n{{field-1}}" :question/worked-solution "Evaluating the function at $t=3,$ we get\n\n$$\n\\begin{aligned}r(3) & =⟨cos\\,(\\frac{3\\pi }{2}),\\,\\frac{4}{3-1}⟩ \\\\  & =⟨0,\\,2⟩\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we obtain\n\n$$\n\\begin{aligned}|r(3)| & =\\sqrt{{0}^{2}+{2}^{2}} \\\\  & =\\sqrt{4} \\\\  & =2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186575620 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e550028-3605-535d-afc4-0b67b596e1d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186574997} {:answer/id #uuid "5dd5b5cd-005e-5343-bec2-584e99c95568" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186575117} {:answer/id #uuid "6969e4a1-4a1e-5a38-83f0-7effe12a76ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ -1 \\\\ \\frac{\\sqrt{2}}{2}\\end{bmatrix}" :db/id #edb/ref 17592186575136} {:answer/id #uuid "cef7cdb8-1750-586d-9b65-5c0a924fd3ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ \\sqrt{2} \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186575315} {:answer/id #uuid "f6712659-f7f2-5848-8213-91e6b729c7c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ \\frac{1}{2} \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186575385}] :answer-field/correct {:answer/id #uuid "1e550028-3605-535d-afc4-0b67b596e1d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186574997} :answer-field/id #uuid "760957fd-b385-5f58-b025-bc8ecf6a9ef0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575466}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f479be92-cf45-5de7-9956-484ec8fcce81" :question/math-academy-id "q-161508" :question/problem "What is the value of $f(t)=\\begin{bmatrix}\\operatorname{sin}⁡2t \\\\ \\operatorname{cos}⁡(2t+\\frac{\\pi }{2}) \\\\ \\operatorname{tan}⁡t\\end{bmatrix}$ at $t=\\frac{\\pi }{4}?$" :question/worked-solution "To evaluate, we substitute $t=\\frac{\\pi }{4}$ into the function, as follows:\n\n$$\n\\begin{aligned}f(\\frac{\\pi }{4}) & =\\begin{bmatrix}\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4}) \\\\ \\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{4}+\\frac{\\pi }{2}) \\\\ \\operatorname{tan}⁡(\\frac{\\pi }{4})\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\ \\operatorname{cos}⁡\\pi  \\\\ \\operatorname{tan}⁡(\\frac{\\pi }{4})\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$\n\nSo the value of $f(t)$ at $t=\\frac{\\pi }{4}$ is the vector $\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}.$"} {:db/id #edb/ref 17592186576631 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66d4dc85-0c41-531c-9cf8-a5ffad7c71ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{243}" :db/id #edb/ref 17592186576649} {:answer/id #uuid "71ef72f1-d031-5d75-b8b9-a759d1a963ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{12}" :db/id #edb/ref 17592186576651} {:answer/id #uuid "982452d6-e27b-5abf-89fd-2616fb222032" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{81}" :db/id #edb/ref 17592186576655} {:answer/id #uuid "d1dc9165-0876-511c-9fc6-22ae43c0a2ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{81}" :db/id #edb/ref 17592186576661} {:answer/id #uuid "e75bb6b7-0a9b-56de-97b3-2572ae4a7760" :answer/