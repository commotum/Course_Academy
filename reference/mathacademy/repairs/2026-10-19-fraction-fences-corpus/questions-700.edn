dde-b315d41984d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186108575}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "efa980a6-6790-54ec-92bb-d5c383a444ad" :question/math-academy-id "q-28968" :question/problem "Which of the following plots shows the graph of $y={(\\frac{3}{5})}^{x}?$" :question/worked-solution "The graph of $y={(\\frac{3}{5})}^{x}$ has a $y$-intercept at $(0,1),$ grows rapidly for $x<0,$ and approaches the asymptote $y=0$ for $x>0.$\n\nWhen $x=-1,$ we have $y=(0.6)^{-1}=\\frac{5}{3}.$ Therefore, another point on the graph is $(-1,\\frac{5}{3}).$ \n\nWe draw the graph through these points as follows:\n\n![](images/0c/0c5bf6531bf352da158771f92eaab5a3974ccd623d1bf29dbe3ecba287f61d5d.png)"} {:db/id #edb/ref 17592186111141 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56ff292a-1c17-5156-aba1-f261c31e00cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448522} {:answer/id #uuid "2702e235-df79-583c-be8b-cc789e4c0437" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448523}] :answer-field/correct {:answer/id #uuid "2702e235-df79-583c-be8b-cc789e4c0437" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448523} :answer-field/id #uuid "1ca8ca5c-339d-520c-8a6c-c24c9e010289" :answer-field/key "Its domain is $x\\in (-\\infty ,\\infty )$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449301} {:answer-field/choices [{:answer/id #uuid "b82ee7d0-3586-51c8-bcdc-71c7d14f7c6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448524} {:answer/id #uuid "ad9f38f3-74eb-55dd-a378-88c1a4bae592" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448525}] :answer-field/correct {:answer/id #uuid "ad9f38f3-74eb-55dd-a378-88c1a4bae592" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448525} :answer-field/id #uuid "0a962ac2-615f-5b43-8e90-6f7cdffa417c" :answer-field/key "Its range is $y\\in (0,\\infty )$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449302} {:answer-field/choices [{:answer/id #uuid "f282fc85-3dd6-5621-b801-4d02ab01d783" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448526} {:answer/id #uuid "18849f05-b80f-5d1a-8d47-1748279d5644" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448527}] :answer-field/correct {:answer/id #uuid "18849f05-b80f-5d1a-8d47-1748279d5644" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448527} :answer-field/id #uuid "18ba6ec7-aafe-5aa8-8d5f-6073db426a40" :answer-field/key "It is a decreasing function" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449303}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c4102b2c-f2ad-56ac-9dd6-7dd59719b972" :question/math-academy-id "q-28973" :question/problem "Which of the following statements are true in relation to the function $f(x)={(\\frac{2}{7})}^{x}?$\n\nSelect all that apply." :question/worked-solution "Let's start by recalling the graph of ${(\\frac{2}{7})}^{x}.$\n\n![](images/c1/c1bbffed32708d30355ed3592deae845d1a84cd1f1772ef1d0fae7ac39518295.png)\n\nLet's go through the statements one by one.\n\n- Statement “Its domain is $x\\in (-\\infty ,\\infty )$” is true. The function $f(x)={(\\frac{2}{7})}^{x}$ is defined for all input values $x.$\n\n- Statement “Its range is $y\\in (0,\\infty )$” is true. The set of possible outputs of $f(x)={(\\frac{2}{7})}^{x}$ consists of all the positive numbers.\n\n- Statement “It is a decreasing function” is true. For $x\\in (-\\infty ,\\infty ),$ the graph of $y=f(x)$ falls. Therefore, $y=f(x)$ is a decreasing function.\n\nIn conclusion, statements “Its domain is $x\\in (-\\infty ,\\infty )$”, “Its range is $y\\in (0,\\infty )$”, and “It is a decreasing function” are true."} {:db/id #edb/ref 17592186111145 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d15aba0-9dce-5544-8564-20b930b0f7cb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3d/3d031240dac44ea6a1b96d05cbdcded0e48bf0ef4b263d37d51010ae06dfb8a4.png" :db/id #edb/ref 17592186108606} {:answer/id #uuid "e8aaec1a-41e3-54c7-9103-190f5694394d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/aa/aa681bd97cb94bed394f52bd06bbdbbbb086756b4bf1c20eddabcdae9a191d7b.png" :db/id #edb/ref 17592186108607} {:answer/id #uuid "f3841aba-6e53-5425-9d7d-52c95d474feb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fb/fbcbee24c2460c6d8accef3d1819cbad4be24e05a0f83c7a82e3d0b8355781f3.png" :db/id #edb/ref 17592186108608} {:answer/id #uuid "160783e8-d7a4-5968-8984-a4041146e38e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/37/377302ce4b5d9cb95b37cccb8d45bc5db574abcfc3e1201f700526b9ac3d5493.png" :db/id #edb/ref 17592186108609} {:answer/id #uuid "63028a0d-492b-5be7-b2bd-767429f24d7c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/dc/dca7b2e9c9185d932f43d816c451d1fbb26de50d7721411e72b40cc23e168938.png" :db/id #edb/ref 17592186108610}] :answer-field/id #uuid "03c38c5b-cd33-581c-ba38-020e5e8bb701" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186108605}] :question/id #uuid "9b08cffd-2ec6-5929-9161-ce5fe49b8976" :question/math-academy-id "q-29359" :question/problem "Which of the following plots shows the graph of $f(x) = (\\frac{7}{2})^{x}$?"} {:db/id #edb/ref 17592186111158 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b2b084c-2030-569c-b3db-c1f0bb240497" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186108674} {:answer/id #uuid "a1178c63-4702-5bdc-9e41-c3046acb6f63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186108675} {:answer/id #uuid "d3dca092-57eb-5e07-8d0d-0d53376fcddf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}}{4}" :db/id #edb/ref 17592186108676} {:answer/id #uuid "ec1a8afd-47ad-5ee5-aef2-253b8da8405f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{4}" :db/id #edb/ref 17592186108677} {:answer/id #uuid "f8b6b5a3-b768-5bb1-8d7e-9d7a7b3b6af1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{7}}{4}" :db/id #edb/ref 17592186108678}] :answer-field/correct {:answer/id #uuid "8b2b084c-2030-569c-b3db-c1f0bb240497" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186108674} :answer-field/id #uuid "af420e31-aeb4-5e79-ae37-c4b53833e453" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186108673}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6d39d8f8-c6eb-55ec-8766-ad9675623f6e" :question/math-academy-id "q-37821" :question/problem "![](images/d5/d51a8e78f8b8c1f05e502bd98aed6a253799336765f1331d23e63ec637bcb448.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\frac{\\sqrt{7}}{4},$ use the Pythagorean identity to find $\\operatorname{sin}⁡\\theta .$" :question/worked-solution "![](images/43/438ce908c902696b480bf9791cae089be40f9e7b2552208e13e08405496b696c.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta \n$$\n\nWe're given that $x=\\frac{\\sqrt{7}}{4}$ at the point $P.$ Therefore, we have\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{\\sqrt{7}}{4}.\n$$\n\nWe can use the Pythagorean identity to find $\\operatorname{sin}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ \\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{cos}⁡\\theta =\\frac{\\sqrt{7}}{4}$ gives\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{\\sqrt{7}}{4})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{7}{16}} \\\\  & =\\pm \\sqrt{\\frac{9}{16}} \\\\  & =\\pm \\frac{3}{4}.\\end{aligned}\n$$\n\nFinally, we select the positive answer since $\\operatorname{sin}⁡\\theta $ is positive in the first quadrant. So our final answer is $\\operatorname{sin}⁡\\theta =\\frac{3}{4}.$"} {:db/id #edb/ref 17592186111184 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04aa8a38-9ecc-5e87-9899-fa2c52620615" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5x-4" :db/id #edb/ref 17592186326982} {:answer/id #uuid "2a0d4423-cdbd-59bc-9519-c02229ca242c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x+1" :db/id #edb/ref 17592186327296} {:answer/id #uuid "842c8b78-fb24-5dfb-9556-59ef1eff7a4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{5}x-6" :db/id #edb/ref 17592186328076} {:answer/id #uuid "8f307607-46e6-546c-b68f-66ba5c7a0d68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{5}x+15" :db/id #edb/ref 17592186328184} {:answer/id #uuid "b9b36271-f849-5b31-8979-398e7e127d62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-5x-1" :db/id #edb/ref 17592186328554}] :answer-field/correct {:answer/id #uuid "04aa8a38-9ecc-5e87-9899-fa2c52620615" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5x-4" :db/id #edb/ref 17592186326982} :answer-field/id #uuid "637a8d42-8d66-59a6-9b11-fb936c324619" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329359}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f8ebc497-48a2-5b22-a14f-221db06dd5d2" :question/math-academy-id "q-44404" :question/problem "Which of the following lines is perpendicular to $x+5y=10?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nTo find the slope of the given line $x+5y=10,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}x+5y & =10 \\\\ 5y & =-x+10 \\\\ y & =-\\frac{1}{5}x+2\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope of the given line is $-\\frac{1}{5}.$\n\nLooking at the answer choices, the line $y=5x-4$ has a slope of $5.$\n\nMultiplying the slopes together, we have\n\n$$\n(-\\frac{1}{5})\\cdot 5=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=5x-4$ is perpendicular to the given line."} {:db/id #edb/ref 17592186111185 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "025034f1-82cf-50bd-b217-59910f87c75a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3x+8" :db/id #edb/ref 17592186326958} {:answer/id #uuid "6d46dac1-4725-5672-8e65-18abeaab3525" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3x-1" :db/id #edb/ref 17592186327882} {:answer/id #uuid "925c77f0-5d4e-5125-88a3-7ce5f47a232a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{4}{5}x" :db/id #edb/ref 17592186328208} {:answer/id #uuid "c3dc36e2-5932-534f-9989-a306dcf23224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{3}x+3" :db/id #edb/ref 17592186328647} {:answer/id #uuid "fffad00a-4af1-5e79-90fb-855c5bcce62a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{3}x" :db/id #edb/ref 17592186329182}] :answer-field/correct {:answer/id #uuid "c3dc36e2-5932-534f-9989-a306dcf23224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{3}x+3" :db/id #edb/ref 17592186328647} :answer-field/id #uuid "0d54da50-b69e-52ba-a8a3-89d79a9cdec1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329204}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b7485dae-88b3-5eea-a431-272c46bd98d6" :question/math-academy-id "q-44514" :question/problem "Which of the following lines is perpendicular to $12x-4y=5?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nTo find the slope of the given line $12x-4y=5,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}12x-4y & =5 \\\\ -4y & =-12x+5 \\\\ y & =3x-\\frac{5}{4}\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope of the given line is $3.$\n\nLooking at the answer choices, the line $y=-\\frac{1}{3}x+3$ has a slope of $-\\frac{1}{3}.$\n\nMultiplying the slopes together, we have\n\n$$\n3\\cdot (-\\frac{1}{3})=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=-\\frac{1}{3}x+3$ is perpendicular to the given line."} {:db/id #edb/ref 17592186111216 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8683ec68-4e3b-5510-90a0-e465fc2aee94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\log_{5} (p) - \\log_{5} (q)" :db/id #edb/ref 17592186109022} {:answer/id #uuid "dffb4570-e873-5ac1-8f71-a138c6f1e6ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(\\log_{5} (p))/(\\log_{5} (q))" :db/id #edb/ref 17592186109023} {:answer/id #uuid "f6fa50ea-00c6-5037-9fc2-f8a2696ca8c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{5} (2p) - \\log_{5} (q)" :db/id #edb/ref 17592186109024} {:answer/id #uuid "5c498860-73df-556a-9699-7026660920f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{5} (2p) - \\log_{5} (2q)" :db/id #edb/ref 17592186109025} {:answer/id #uuid "7eeda3cf-b3a8-5aca-8868-daea5d864841" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\log_{5} (p) - 2\\log_{5} (q)" :db/id #edb/ref 17592186109026}] :answer-field/id #uuid "8540980b-3065-5813-aeab-305afc1de4f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186109021}] :question/id #uuid "64d0c1d6-d1d1-543e-953b-1850c41d8e50" :question/math-academy-id "q-47258" :question/problem "What is $2\\log_{5} (\\frac{p}{q})$?"} {:db/id #edb/ref 17592186111217 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f39b09f-5b91-5a99-a4f6-25704e2a1be6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e}{\\operatorname{ln}⁡(8)}" :db/id #edb/ref 17592186542674} {:answer/id #uuid "1eec112c-25aa-553b-a422-22de0d6e6956" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{\\operatorname{ln}⁡(8)}" :db/id #edb/ref 17592186542721} {:answer/id #uuid "3a5406f1-1640-5528-a165-80d0a562e9e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3-\\operatorname{ln}⁡(8)" :db/id #edb/ref 17592186542796} {:answer/id #uuid "95a46d5b-80ce-56e0-a375-64e93a2902db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e-\\operatorname{ln}⁡(8)" :db/id #edb/ref 17592186543033} {:answer/id #uuid "ac29cb58-7451-5eff-9f80-ed2ed2530c7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(8)-3" :db/id #edb/ref 17592186543093}] :answer-field/correct {:answer/id #uuid "3a5406f1-1640-5528-a165-80d0a562e9e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3-\\operatorname{ln}⁡(8)" :db/id #edb/ref 17592186542796} :answer-field/id #uuid "1171bfe8-4dba-5123-b25c-20e86f721ab8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186109027}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "46d440a6-1c70-56f2-8920-e5415a5e3165" :question/math-academy-id "q-47298" :question/problem "$\\operatorname{ln}⁡(\\frac{{e}^{3}}{8})=$" :question/worked-solution "First, let's recall the quotient rule for natural logarithms:\n\n$$\n\\operatorname{ln}⁡(a)-\\operatorname{ln}⁡(b)=\\operatorname{ln}⁡(\\frac{a}{b})\n$$\n\nUsing the quotient rule for natural logarithms, the given expression can be rewritten as:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(\\frac{{e}^{3}}{8}) & =\\operatorname{ln}⁡({e}^{3})-\\operatorname{ln}⁡(8) \\\\  & =3-\\operatorname{ln}⁡(8)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186111342 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f5011e1-5a24-51a6-a560-84948c0866a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{5}}{15}" :db/id #edb/ref 17592186333123} {:answer/id #uuid "1a630eb5-70c5-5ded-bed1-6c97af35f229" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{45}}{4}" :db/id #edb/ref 17592186333231} {:answer/id #uuid "72e4ea13-feef-5acf-9b9a-0e579d2765d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{5}}{2}" :db/id #edb/ref 17592186334027} {:answer/id #uuid "c360afef-02b3-5232-b951-ae761d89057d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{45}{4}" :db/id #edb/ref 17592186334684} {:answer/id #uuid "fc79cebb-683f-5ec6-b279-a40dd479a779" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186335208}] :answer-field/correct {:answer/id #uuid "72e4ea13-feef-5acf-9b9a-0e579d2765d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{5}}{2}" :db/id #edb/ref 17592186334027} :answer-field/id #uuid "3a1eb48a-b984-5dff-bbdc-6a2962f92e64" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335352}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0efeeff3-47fe-5165-905e-7ef041b1d387" :question/math-academy-id "q-65073" :question/problem "![](images/96/96b22799c75a4b19df4c6bddf8b63d11a7d0cab8a0cc481b8466a29eb1a2af15.png)\n\nThe diagram above shows the unit circle. Given that the $y$-coordinate of the point $P$ is $\\frac{3\\sqrt{5}}{7},$ use the Pythagorean identity to find $tan⁡\\theta .$" :question/worked-solution "![](images/21/21170c11aa5ff0ab39b86f94588e5e8a0fa178d0c34b9aa1774ee9f07a4d0812.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=cos⁡\\theta ,\\,y=sin⁡\\theta \n$$\n\nWe're given that $y=\\frac{3\\sqrt{5}}{7}$ at the point $P.$ Therefore, we have\n\n$$\nsin⁡\\theta =\\frac{3\\sqrt{5}}{7}.\n$$\n\nWe can use the Pythagorean identity to find $cos⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ cos⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $sin⁡\\theta =\\frac{3\\sqrt{5}}{7}$ gives\n\n$$\n\\begin{aligned}cos⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{3\\sqrt{5}}{7})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{45}{49}} \\\\  & =\\pm \\sqrt{\\frac{4}{49}} \\\\  & =\\pm \\frac{2}{7}.\\end{aligned}\n$$\n\nWe select the positive answer since $cos⁡\\theta $ is positive in the first quadrant. So, $cos⁡\\theta =\\frac{2}{7}.$\n\nFinally, knowing that $tan⁡\\theta =\\frac{sin⁡\\theta }{cos⁡\\theta },$ we have\n\n$$\ntan⁡\\theta =\\frac{(\\frac{3\\sqrt{5}}{7})}{(\\frac{2}{7})}=\\frac{3\\sqrt{5}}{2}.\n$$"} {:db/id #edb/ref 17592186111370 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ca4f8723-559a-576e-896f-c04862fc607f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = \\log_{5} (15)" :db/id #edb/ref 17592186109946} {:answer/id #uuid "1c1dbb2d-69dd-5dbb-88af-4d884a572321" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = \\log_{5} (\\frac{1}{15})" :db/id #edb/ref 17592186109947} {:answer/id #uuid "3659b40e-5a0c-53a6-9523-0025a1860dc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = \\log_{5} (\\frac{1}{3})" :db/id #edb/ref 17592186109948} {:answer/id #uuid "5a85980f-82ed-54cd-b847-5d4bb10648ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = \\log_{5} (3)" :db/id #edb/ref 17592186109949} {:answer/id #uuid "68cb3d0c-c21e-5cb1-b41c-016834544214" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = 5\\log_{5} (3)" :db/id #edb/ref 17592186109950}] :answer-field/id #uuid "c916e90e-2038-5685-aa96-f883c27c4155" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186109945}] :question/id #uuid "3e958238-ee2a-58d3-b257-eafe2e7f6b42" :question/math-academy-id "q-66805" :question/problem "Find the exact solution of the equation $5^{x} = 15$."} {:db/id #edb/ref 17592186111378 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83b5c118-9995-5971-a9a4-6880a9d36e76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5^{6}}{2^{3}}" :db/id #edb/ref 17592186109994} {:answer/id #uuid "bea3b05c-a68f-5848-8904-0e1af2258d74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2^{6}}{5^{3}}" :db/id #edb/ref 17592186109995} {:answer/id #uuid "08fb9f27-6d0a-54a6-9a9b-65e8c6cd1f51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2^{4}}{5^{6}}" :db/id #edb/ref 17592186109996} {:answer/id #uuid "3539aaef-1d2f-56f5-8201-07301520cf82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2^{3}}{5^{6}}" :db/id #edb/ref 17592186109997} {:answer/id #uuid "70ae06e2-0c47-58cf-bd59-2e8ae6260558" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5^{6}}" :db/id #edb/ref 17592186109998}] :answer-field/id #uuid "d0860ce4-e7f9-5c13-8ec5-e58c203f94ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186109993}] :question/id #uuid "4af0f1fc-bfd5-5a76-85db-a6b448259d1d" :question/math-academy-id "q-68961" :question/problem "What is $(\\frac{2}{5})^{6} \\cdot \\frac{1}{2^{3}}$?"} {:db/id #edb/ref 17592186111380 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41468d21-4c10-5a19-948e-44ada7c0a123" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{6}^{3}}{{4}^{6}}" :db/id #edb/ref 17592186501587} {:answer/id #uuid "7eba4019-7fbd-5be5-9b6f-4d896804f8bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{3}\\cdot {4}^{6}" :db/id #edb/ref 17592186501704} {:answer/id #uuid "91298573-6a3f-5b5b-86e7-0b49355cfd98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{{4}^{12}}" :db/id #edb/ref 17592186501742} {:answer/id #uuid "9dbea38b-7606-5fb6-b9c6-c107413a84d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{{4}^{6}}" :db/id #edb/ref 17592186501762} {:answer/id #uuid "d404240e-f93e-5c72-adcb-8512850b4fd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{6}^{3}}{{4}^{5}}" :db/id #edb/ref 17592186501886}] :answer-field/correct {:answer/id #uuid "41468d21-4c10-5a19-948e-44ada7c0a123" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{6}^{3}}{{4}^{6}}" :db/id #edb/ref 17592186501587} :answer-field/id #uuid "f75d50b2-6f5a-5bce-9e0b-522b9985c2e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186110005}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a4eaff0b-1470-58ee-9066-30ef9be58837" :question/math-academy-id "q-68964" :question/problem "${(\\frac{6}{{4}^{2}})}^{3}=$" :question/worked-solution "First, we apply the power of quotient rule for exponents:\n\n$$\n{(\\frac{6}{{4}^{2}})}^{3}=\\frac{{6}^{3}}{{({4}^{2})}^{3}}\n$$\n\nTo simplify the denominator, we use the power rule for exponents:\n\n$$\n\\begin{aligned}\\frac{{6}^{3}}{{({4}^{2})}^{3}} & =\\frac{{6}^{3}}{{4}^{2\\cdot 3}} \\\\  & =\\frac{{6}^{3}}{{4}^{6}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186111388 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ef77fa0-8d69-57f1-8556-ec1ebb5cb7ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186110054} {:answer/id #uuid "c615a9c1-fc35-5c34-ac2f-9e4f13a3ab5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5" :db/id #edb/ref 17592186110055} {:answer/id #uuid "e742aa10-af35-5168-8e21-f7b9751bc6e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186110056} {:answer/id #uuid "fdfc92bc-5eb0-5484-a697-943f2759c843" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186110057} {:answer/id #uuid "268da067-17a1-52b8-affd-1f1fc246a5a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186110058}] :answer-field/id #uuid "97422996-4b06-549e-a562-600613f989af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186110053}] :question/id #uuid "3cd54cc5-746b-5e8c-9ab4-f44ab69f0d19" :question/math-academy-id "q-7245" :question/problem "![](images/4e/4e1252628476b2eb3be050707f06b5034f533fdc82643ff604f774b3ed7f44b3.png)\n\nThe graph above shows $y = k(\\frac{1}{2})^{x}$. What is the value of $k$?"} {:db/id #edb/ref 17592186111390 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dc7ed7d-8822-50d6-adbe-ad3f4f94cc16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186336309} {:answer/id #uuid "2855b2b9-6a8b-51fc-bc86-192bc1d62f6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186336410} {:answer/id #uuid "62f307be-5f4b-5771-b9ee-77edd782e456" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186336922} {:answer/id #uuid "75294229-d638-5281-9b75-127f796a0330" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186337087} {:answer/id #uuid "a40c3d37-1f3e-56af-9259-897cf2fc43fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186337522}] :answer-field/correct {:answer/id #uuid "1dc7ed7d-8822-50d6-adbe-ad3f4f94cc16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186336309} :answer-field/id #uuid "dfe47395-e6a4-5174-8bac-b9841d8af59f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338671}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7ca56a13-e2a8-587b-a791-0b4526ed9f52" :question/math-academy-id "q-7249" :question/problem "![](images/db/db4c6694a3bc172aea8a47f1a828eac8235286b7ce6b7e327574790a6c31c270.png)\n\nThe graph above shows $y=k{(\\frac{1}{3})}^{x}.$ What is the value of $k?$" :question/worked-solution "To plot the graph of $y=k{(\\frac{1}{3})}^{x}$ we take the graph of $y={(\\frac{1}{3})}^{x}$ and stretch it vertically by a scale factor of  $k.$ Under the action of this transformation, the $y$-intercept is mapped from $(0,1)$ to $(0,k).$\n\nComparing the point $(0,3)$ on the graph to $(0,k),$ we see that we must have $k=3.$"} {:db/id #edb/ref 17592186111423 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0900ee31-7fc8-5a71-bfb0-567ce40867a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.24" :db/id #edb/ref 17592186418283} {:answer/id #uuid "2c678ed7-d187-5b4d-b65e-df460c846e37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.15" :db/id #edb/ref 17592186418286} {:answer/id #uuid "929c9f87-8068-54c6-a062-0aad2ba05db7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.50" :db/id #edb/ref 17592186418296} {:answer/id #uuid "c77996be-b841-5a9e-9afd-b3001a00c48c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.52" :db/id #edb/ref 17592186418298} {:answer/id #uuid "fa154a6e-7b02-5897-b84b-0b4cfd53f21b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.74" :db/id #edb/ref 17592186418305}] :answer-field/correct {:answer/id #uuid "fa154a6e-7b02-5897-b84b-0b4cfd53f21b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.74" :db/id #edb/ref 17592186418305} :answer-field/id #uuid "1b3114c1-4daa-5e9a-8186-cd37d952aa3f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186418307}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "02f6c3de-17f2-58af-afa6-5936538a62e2" :question/math-academy-id "q-94875" :question/problem "The data below is taken from the table of values of the cumulative distribution function $Φ(z)$ for the standard normal distribution. Given that $X∼N(\\mu ,{3}^{2})$ is a normal random variable with $P(-0.7\\mu <X<2.7\\mu )=0.3256,$ find $\\mu $ rounded to $2$ decimal places.\n\n| $z$ | $\\,0.01\\,$ | $\\,0.02\\,$ | $\\,0.03\\,$ |\n| --- | --- | --- | --- |\n| $\\,0.3\\,$ | $\\,0.6217\\,$ | $\\,0.6255\\,$ | $\\,0.6293\\,$ |\n| $\\,0.4\\,$ | $\\,0.6591\\,$ | $\\,0.6628\\,$ | $\\,0.6664\\,$ |\n| $\\,0.5\\,$ | $\\,0.6950\\,$ | $\\,0.6985\\,$ | $\\,0.7019\\,$ |\n\n*Hint: Note that the interval $-0.7\\mu <X<2.7\\mu $ is symmetric about the mean $\\mu .$*" :question/requires-calculator true :question/worked-solution "Note that we can write the given probability as\n\n$$\nP(\\mu -1.7\\mu <X<\\mu +1.7\\mu )=0.3256,\n$$\n\nwhich tells us that the interval $-0.7\\mu <X<2.7\\mu $ is symmetric about the mean $\\mu .$\n\nFirst, we find the cumulative probability using symmetry:\n\n$$\n\\begin{aligned}P(\\mu -1.7\\mu <X<\\mu +1.7\\mu ) & =0.3256 \\\\ 2P(\\mu <X<\\mu +1.7\\mu ) & =0.3256 \\\\ P(\\mu <X<\\mu +1.7\\mu ) & =0.1628 \\\\ P(X<\\mu +1.7\\mu )-P(X<\\mu ) & =0.1628 \\\\ P(X<\\mu +1.7\\mu )-0.5 & =0.1628 \\\\ P(X<\\mu +1.7\\mu ) & =0.6628 \\\\ P(X\\le \\mu +1.7\\mu ) & =0.6628 \\\\ P(X\\le 2.7\\mu ) & =0.6628\\end{aligned}\n$$\n\nThen, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(X\\le 2.7\\mu ) & =0.6628 \\\\ P(Z\\le \\frac{2.7\\mu -\\mu }{3}) & =0.6628 \\\\ Φ(\\frac{1.7\\mu }{3}) & =0.6628 \\\\ \\frac{1.7\\mu }{3} & ={Φ}^{-1}(0.6628)\\end{aligned}\n$$\n\nAccording to the table, we have\n\n$$\nΦ(0.42)=0.6628\\,⇒\\,{Φ}^{-1}(0.6628)=0.42.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{1.7\\mu }{3} & =0.42 \\\\ 1.7\\mu  & =1.26 \\\\ \\mu  & ≈0.741\\,18 \\\\ \\mu  & ≈0.74.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186111424 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09614e38-2770-5213-9318-36a80748d9ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186357834} {:answer/id #uuid "90efc447-1b2f-5d50-9008-d6b6e1c25c96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186359022} {:answer/id #uuid "b1551a49-1c84-511e-b24e-6abe7124f175" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "144" :db/id #edb/ref 17592186359290} {:answer/id #uuid "c15dbb1f-5fc8-546b-97f4-fa22c1184117" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "169" :db/id #edb/ref 17592186359448} {:answer/id #uuid "ffdeb5de-5bf4-5bdc-8f74-8c3da83c77bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "121" :db/id #edb/ref 17592186360001}] :answer-field/correct {:answer/id #uuid "b1551a49-1c84-511e-b24e-6abe7124f175" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "144" :db/id #edb/ref 17592186359290} :answer-field/id #uuid "dcd73f0a-0b27-5c86-9523-f9e20a7945d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360388}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0de7ef2c-c461-55a3-92ec-92284bc49b94" :question/math-academy-id "q-94892" :question/problem "The data below is taken from the table of values of the cumulative distribution function $Φ(z)$ for the standard normal distribution. Given that $X∼N(0,{\\sigma }^{2})$ is a normal random variable with $P(|X|<9)=0.5468,$ find ${\\sigma }^{2}.$ \n\n| $z$ | $\\,0.04\\,$ | $\\,0.05\\,$ | $\\,0.06\\,$ |\n| --- | --- | --- | --- |\n| $\\,0.7\\,$ | $\\,0.7704\\,$ | $\\,0.7734\\,$ | $\\,0.7764\\,$ |\n| $\\,0.8\\,$ | $\\,0.7995\\,$ | $\\,0.8023\\,$ | $\\,0.8051\\,$ |\n| $\\,0.9\\,$ | $\\,0.8264\\,$ | $\\,0.8289\\,$ | $\\,0.8315\\,$ |" :question/requires-calculator true :question/worked-solution "First, we express the given probability as\n\n$$\nP(|X|<9)=P(-9<X<9).\n$$\n\nThen, we find the cumulative probability using symmetry:\n\n$$\n\\begin{aligned}P(-9<X<9) & =0.5468 \\\\ 2P(0<X<9) & =0.5468 \\\\ P(0<X<9) & =0.2374 \\\\ P(X<9)-P(X<0) & =0.2734 \\\\ P(X<9)-0.5 & =0.2734 \\\\ P(X<9) & =0.7734 \\\\ P(X\\le 9) & =0.7734\\end{aligned}\n$$\n\nThen, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(X\\le 9) & =0.7734 \\\\ P(Z\\le \\frac{9-0}{\\sigma }) & =0.7734 \\\\ Φ(\\frac{9}{\\sigma }) & =0.7734 \\\\ \\frac{9}{\\sigma } & ={Φ}^{-1}(0.7734)\\end{aligned}\n$$\n\nAccording to the table, we have\n\n$$\nΦ(0.75)=0.7734\\,⇒\\,{Φ}^{-1}(0.7734)=0.75.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{9}{\\sigma } & =0.75 \\\\ \\sigma  & =\\frac{9}{0.75} \\\\ \\sigma  & =12.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =(12)^{2}=144.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186114945 :question/id #uuid "f1a8976c-86e9-5532-b796-03f399fbe58b" :question/math-academy-id "e-19" :question/problem "Find $\\lim_\\limits{x\\rightarrow (-1/2)} x^3$." :question/worked-solution "Substituting\n\n$$\nx=-\\dfrac{1}{2}\n$$\n\ndirectly into the limit, we find\n\n$$\n\\begin{aligned}\nlim_(x → (-1/2))x^{3} &= (-\\frac{1}{2})^{3} \\\\\n&=-\\frac{1}{2^{3}} \\\\\n&=-\\frac{1}{8}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186114947 :question/id #uuid "5adf056c-d122-54e6-b55f-5e85d39750c4" :question/math-academy-id "e-207" :question/problem "Calculate $\\dfrac {\\textrm{d}y}{\\textrm{d}x}$ if $y = 2 \\,\\textrm {arccot } x.$" :question/worked-solution "The formula for the derivative of $\\textrm{arccot}$ is\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\textrm {arccot } x) \t=  -\\dfrac 1 {1+x^2}.\n$$\n\nUsing the formula above, we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2\\,\\text{arccot }x) \\\\  & =2\\cdot \\frac{\\text{d}}{\\text{d}x}(\\text{arccot }x) \\\\  & =2\\cdot (-\\frac{1}{1+{x}^{2}}) \\\\  & =-\\frac{2}{1+{x}^{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186114951 :question/id #uuid "99db3f5c-5d6f-5e8e-a31c-a627ddd5c6dc" :question/math-academy-id "e-208" :question/problem "If $f(x) = \\dfrac{\\textrm{arcsec } x}{\\textrm{arccsc } x},$ calculate $f'(x).$" :question/worked-solution "Here, we let $u(x) = \\textrm{arcsec } x$ and $v(x) = \\textrm{arccsc } x$, and apply the quotient rule.\n\nWe use the formulae\n\n$$\nu'(x) =  \\dfrac 1 {|x| \\sqrt {x^2 - 1}}\t\\quad \\text{and} \\quad\tv'(x) = -\\dfrac 1 {|x| \\sqrt {x^2 - 1}}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\cdot \\text{arccsc }x-\\text{arcsec }x\\cdot (-\\frac{1}{|x|\\sqrt{{x}^{2}-1}})}{{\\text{arccsc }}^{2}x} \\\\  & =(\\frac{1}{|x|\\sqrt{{x}^{2}-1}})\\frac{\\text{arccsc }x+\\text{arcsec }x}{{\\text{arccsc }}^{2}x} \\\\  & =\\frac{\\text{arccsc }x+\\text{arcsec }x}{|x|\\sqrt{{x}^{2}-1}{\\text{ arccsc }}^{2}x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186114954 :question/id #uuid "fd6239d1-4fec-50b9-8018-f6e185c4e0d0" :question/math-academy-id "e-209" :question/problem "If $f(x) =3 x\\, \\textrm {arccsc }x,$ calculate $f'(x).$" :question/worked-solution "The formula for the derivative of $\\textrm{arccsc}$ is\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\textrm {arccsc } x) \t=  -\\dfrac 1 {|x| \\sqrt {x^2 - 1}} \\, .\n$$\n\nUsing the product rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(3x\\,\\text{arccsc }x) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}(x\\,\\text{arccsc }x) \\\\  & =3(x\\cdot \\frac{\\text{d}}{\\text{d}x}(\\text{arccsc }x)+\\text{arccsc }x\\cdot \\frac{\\text{d}}{\\text{d}x}(x)) \\\\  & =3x(-\\frac{1}{|x|\\sqrt{{x}^{2}-1}})+3\\,\\text{arccsc }x\\cdot 1 \\\\  & =-\\frac{3x}{|x|\\sqrt{{x}^{2}-1}}+3\\,\\text{arccsc }x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186114956 :question/id #uuid "38c9e8d8-871f-54b1-a8df-637f54430cc1" :question/math-academy-id "e-210" :question/problem "Find $f'(x)$ if $f(x) =2 \\, \\textrm {arccot } (x^2 + 5).$" :question/worked-solution "The formula for the derivative of $\\textrm{arccot}$ is\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\textrm {arccot } x) \t=  -\\dfrac 1 {1+x^2}.\n$$\n\nUsing the chain rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2\\,\\text{arccot }({x}^{2}+5)) \\\\  & =2\\cdot (-\\frac{1}{1+({x}^{2}+5)^{2}})\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{2}+5) \\\\  & =-\\frac{2}{1+({x}^{2}+5)^{2}}\\cdot 2x \\\\  & =-\\frac{4x}{1+({x}^{2}+5)^{2}} \\\\  & =-\\frac{4x}{{x}^{4}+10{x}^{2}+26}\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186114962 :question/id #uuid "a4777bc9-c65f-5da2-b962-96b38daa7518" :question/math-academy-id "e-21752" :question/problem "A reactor initially holds $300\\,\\textrm{gal}$ of a chemical solution containing $18\\,\\textrm{lb}$ of dissolved reactant.\nPure solvent is pumped into the reactor at a rate of $14\\,\\textrm{gal/min},$ while the completely mixed chemical solution leaves the reactor at a rate of $14\\,\\textrm{gal/min}.$\nFind, rounded to two decimal places, the amount of reactant in the reactor $25$ minutes after the solvent pumping begins." :question/worked-solution "Let $Q$ be the amount of reactant in the reactor at time $t.$ Then, the derivative \n\n$$\n\\dfrac{\\mathrm{d}Q}{\\mathrm{d}t}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which reactant enters the reactor minus the rate at which reactant leaves the reactor.\n\n$$\n\\dfrac{\\mathrm{d}Q}{\\mathrm{d}t} = Q'_{\\textrm{in}} - Q'_{\\textrm{out}}\n$$\n\nNote that the units of $\\dfrac{\\mathrm{d}Q}{\\mathrm{d}t}, Q'_{\\textrm{in}}$ and $Q'_{\\textrm{out}}$ are $\\textrm{lb}/\\textrm{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which reactant enters the reactor.\n\nNote that pure solvent (i.e., a solution containing $0\\,\\textrm{lb/gal}$ of reactant) enters the reactor at a rate of $14\\,\\textrm{gal/min}.$ So, the rate at which the *reactant* enters the reactor is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0\\,\\frac{\\text{lb}}{\\text{gal}})\\cdot (14\\,\\frac{\\text{gal}}{\\text{min}}) \\\\  & =(0\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}})\\cdot (14\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}}) \\\\  & =0\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which reactant exits the reactor.\n\nTo find the rate at which reactant leaves the reactor, we first determine the volume of solution in the reactor at time $t.$\n\nThe reactor initially contains $300\\,\\textrm{gal}$ of chemical solution; solvent enters at $14\\,\\textrm{gal/min}$ and drains out at $14\\,\\textrm{gal/min}.$\nAs a result, the amount of chemical solution in the reactor after $t$ minutes is \n\n$$\n300 + 14t - 14t = 300\\,\\textrm{gal}.\n$$\n\nSince $Q$ is the amount of reactant in the reactor, the *concentration* of the solution at time $t$ is\n\n$$\n\\dfrac{Q}{300}\\,\\dfrac{\\textrm{lb}}{\\textrm{gal}}.\n$$\n\nTherefore, as the completely mixed chemical solution leaves at a rate of $14\\,\\textrm{gal/min},$ *reactant* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(14\\,\\frac{\\text{gal}}{\\text{min}})\\cdot (\\frac{Q}{300}\\,\\frac{\\text{lb}}{\\text{gal}}) \\\\  & =(14\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}})\\cdot (\\frac{Q}{300}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}}) \\\\  & =\\frac{14Q}{300}\\,\\frac{\\text{lb}}{\\text{min}} \\\\  & =\\frac{7Q}{150}\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =0-\\frac{7Q}{150}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\dfrac{\\mathrm{d}Q}{\\mathrm{d}t} = -\\dfrac{7}{150}\\,Q.\n$$\n\n**Step 4**: Integrate the equation.\n\nSeparating variables and integrating both sides with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{Q}\\cdot \\frac{dQ}{dt} & =-\\frac{7}{150} \\\\ \\int \\frac{1}{Q}\\cdot \\frac{dQ}{dt}dt & =\\int (-\\frac{7}{150})\\,dt \\\\ \\int \\frac{1}{Q}\\cdot \\,dQ & =-\\frac{7}{150}\\int 1\\,dt \\\\ \\operatorname{ln}⁡|Q| & =-\\frac{7t}{150}+C \\\\ |Q| & ={e}^{-\\frac{7t}{150}+C} \\\\ Q(t) & =A{e}^{-7t/150},\\end{aligned}\n$$\n\nwhere $A = \\pm e^C$ is a constant of integration.\n\nWe're told that the reactor initially contains $18\\,\\textrm{lb}$ of reactant. So, we can apply the initial condition $Q(0) = 18,$ and solve for $A{:}$\n\n$$\n\\begin{aligned}Q(0) & =18 \\\\ A{e}^{-7\\cdot 0/150} & =18 \\\\ A & =18\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t){:}$\n\n$$\nQ(t) = 18e^{-7t/150}\n$$\n\nFinally, the amount of reactant in the reactor $25$ minutes after the solvent is first pumped in is\n\n$$\nQ(25) = 18e^{-175/150} \\approx 5.61\\,\\textrm{lb},\n$$\n\nrounded to two decimal places."} {:db/id #edb/ref 17592186114963 :question/id #uuid "7aa89a9d-8785-50a9-a517-201f7514136c" :question/math-academy-id "e-21755" :question/problem "A $12\\,000\\,\\textrm{mL}$-capacity tank initially holds $8\\,000\\,\\textrm{mL}$ of water containing $320\\,\\textrm{g}$ of dissolved contaminant. Clean water begins to flow into the tank at a rate of $100\\,\\textrm{mL/s},$ while the completely mixed water flows out at a rate of $60\\,\\textrm{mL/s}.$ Find, rounded to two decimal places, the amount of contaminant in the tank at the moment it begins to overflow." :question/worked-solution "Let $Q$ be the amount of contaminant in the tank at time $t.$ Then, the derivative \n\n$$\n\\dfrac{\\mathrm{d}Q}{\\mathrm{d}t}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in seconds. This is equal to the rate at which contaminant enters the tank minus the rate at which contaminant leaves the tank.\n\n$$\n\\dfrac{\\mathrm{d}Q}{\\mathrm{d}t} = Q'_{\\textrm{in}} - Q'_{\\textrm{out}}\n$$\n\nNote that the units of $\\dfrac{\\mathrm{d}Q}{\\mathrm{d}t}, Q'_{\\textrm{in}}$ and $Q'_{\\textrm{out}}$ are $\\textrm{g}/\\textrm{s}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which contaminant enters the tank.\n\nFirst, note that clean water (i.e., water containing $0\\,\\textrm{g/mL}$ of contaminant) enters the tank at a rate of $100\\,\\textrm{mL/s}.$ So, the rate at which the *contaminant* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0\\,\\frac{\\text{g}}{\\text{mL}})\\cdot (100\\,\\frac{\\text{mL}}{\\text{s}}) \\\\  & =(0\\,\\frac{\\text{g}}{\\cancel{\\text{mL}}})\\cdot (100\\,\\frac{\\cancel{\\text{mL}}}{\\text{s}}) \\\\  & =0\\,\\frac{\\text{g}}{\\text{s}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which contaminant exits the tank.\n\nTo find the rate at which contaminant leaves the tank, we must first determine the volume of water in the tank at time $t.$\n\nThe tank initially contains $8\\,000\\,\\textrm{mL}$ of water; clean water enters at $100\\,\\textrm{mL/s},$ and mixed water leaves at $60\\,\\textrm{mL/s}.$\nAs a result, the amount of water in the tank after $t$ seconds is \n\n$$\nV(t) = 8\\,000 + 100t - 60t = 40(200+t)\\,\\textrm{mL}.\n$$\n\nNote that $V(t)$ is an increasing function, so the tank is filling.\n\nSince $Q$ is the amount of contaminant in the tank, the concentration of the water at time $t$ is\n\n$$\n\\dfrac{Q}{40(200 + t)}\\,\\dfrac{\\textrm{g}}{\\textrm{mL}}.\n$$\n\nTherefore, as the completely mixed water leaves at a rate of $60\\,\\textrm{mL/s},$ *contaminant* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(60\\,\\frac{\\text{mL}}{\\text{s}})\\cdot (\\frac{Q}{40(200+t)}\\,\\frac{\\text{g}}{\\text{mL}}) \\\\  & =(60\\,\\frac{\\cancel{\\text{mL}}}{\\text{s}})\\cdot (\\frac{Q}{40(200+t)}\\,\\frac{\\text{g}}{\\cancel{\\text{mL}}}) \\\\  & =\\frac{3Q}{2(200+t)}\\,\\frac{\\text{g}}{\\text{s}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =0-\\frac{3Q}{2(200+t)}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\dfrac{\\mathrm{d}Q}{\\mathrm{d}t} = -\\dfrac{3}{2(200 + t)}\\,Q.\n$$\n\n**Step 4**: Integrate the equation\n\nSeparating variables and integrating both sides with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{Q}\\cdot \\frac{dQ}{dt} & =-\\frac{3}{2(200+t)} \\\\ \\int \\frac{1}{Q}\\cdot \\frac{dQ}{dt}dt & =\\int (-\\frac{3}{2(200+t)})\\,dt \\\\ \\int \\frac{1}{Q}\\cdot \\,dQ & =-\\frac{3}{2}\\int \\frac{1}{200+t}\\,dt \\\\ \\operatorname{ln}⁡|Q| & =-\\frac{3}{2}(\\operatorname{ln}⁡|200+t|)+C \\\\ \\operatorname{ln}⁡|Q| & =\\operatorname{ln}⁡|(200+t)^{-3/2}|+C \\\\ |Q| & ={e}^{\\operatorname{ln}⁡|(200+t)^{-3/2}|+C} \\\\ Q(t) & =\\frac{A}{(200+t)^{3/2}},\\end{aligned}\n$$\n\nwhere $A = \\pm e^C$ is a constant of integration.\n\nWe're told that the tank initially contains $320\\,\\textrm{g}$ of contaminant. So, we can apply the initial condition $Q(0) = 320,$ and solve for $A{:}$\n\n$$\n\\begin{aligned}Q(0) & =320 \\\\ \\frac{A}{(200+0)^{3/2}} & =320 \\\\ A & =320(200)^{3/2}\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t){:}$\n\n$$\n\\begin{aligned}Q(t) & =\\frac{320(200)^{3/2}}{(200+t)^{3/2}} \\\\  & =320{(\\frac{200}{200+t})}^{3/2}\\end{aligned}\n$$\n\nNow, let $t_o$ be the time when the tank begins to overflow. The tank has a capacity of $12\\,000\\,\\textrm{mL},$ so we can use the condition $V(t_o) = 12\\,000$ to solve for $t_o{:}$\n\n$$\n\\begin{aligned}V({t}_{o}) & =12\\,000 \\\\ 40(200+{t}_{o}) & =12\\,000 \\\\ 200+{t}_{o} & =300 \\\\ {t}_{o} & =100\\,\\text{s}\\end{aligned}\n$$\n\nFinally, the amount of contaminant in the tank at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(100) & =320{(\\frac{200}{200+100})}^{3/2} \\\\  & =320{(\\frac{2}{3})}^{3/2} \\\\  & ≈174.19\\,\\text{g}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186114966 :question/id #uuid "4e4541ff-5c48-5300-ac29-e48111fee506" :question/math-academy-id "e-2394" :question/problem "Calculate  $\\lim\\limits_{t \\to 0} \\mathbf{f}(t),$ given that \n\n$$\n\\mathbf f (t) = \\dfrac{1- e^{t}}{\\sin t} \\ \\mathbf {i}+ \\dfrac{\\sin t}{t+t^2} \\ \\mathbf {j} + \\dfrac{ e^{t} - e^{-t}}{\\sin t} \\ \\mathbf {k}.\n$$" :question/worked-solution "To find the limit of our vector function, we compute the limit of each component individually:\n\n$$\n\\lim_{t \\to 0}\\mathbf f(t) = \\left(\\lim_{t \\to 0} \\dfrac{1-e^t}{\\sin t}\\right)\\,\\mathbf i + \\left( \\lim_{t \\to 0} \\dfrac{\\sin t}{t+t^2}\\right)\\,\\mathbf j + \\left( \\lim_{t \\to 0} \\dfrac{e^t-e^{-t}}{\\sin t} \\right)\\,\\mathbf k\n$$\n\nNow, we find the limits one-by-one.\n\n- The first component can be found using L'Hopital's Rule:\n\n$$\n\\begin{aligned}{lim}_{t\\to 0}\\frac{1-{e}^{t}}{\\operatorname{sin}⁡t} & ={lim}_{t\\to 0}\\frac{{(1-{e}^{t})}^{′}}{{(\\operatorname{sin}⁡t)}^{′}} \\\\  & ={lim}_{t\\to 0}\\frac{-{e}^{t}}{\\operatorname{cos}⁡t} \\\\  & =\\frac{-{e}^{0}}{\\operatorname{cos}⁡0} \\\\  & =-\\frac{1}{1} \\\\  & =-1\\end{aligned}\n$$\n\n- The second component can be found using a special limit:\n\n$$\n\\begin{aligned}{lim}_{t\\to 0}\\frac{\\operatorname{sin}⁡t}{t+{t}^{2}} & ={lim}_{t\\to 0}\\frac{\\operatorname{sin}⁡t}{t(t+1)} \\\\  & =({lim}_{t\\to 0}\\frac{1}{t+1})\\cdot ({lim}_{t\\to 0}\\frac{\\operatorname{sin}⁡t}{t}) \\\\  & =(\\frac{1}{0+1})\\cdot 1 \\\\  & =1\\end{aligned}\n$$\n\n- The third component can be found using L'Hopital's Rule:\n\n$$\n\\begin{aligned}{lim}_{t\\to 0}\\frac{{e}^{t}-{e}^{-t}}{\\operatorname{sin}⁡t} & ={lim}_{t\\to 0}\\frac{{({e}^{t}-{e}^{-t})}^{′}}{(\\operatorname{sin}⁡t)^{′}} \\\\  & ={lim}_{t\\to 0}\\frac{{e}^{t}+{e}^{-t}}{\\operatorname{cos}⁡t} \\\\  & =\\frac{{e}^{0}+{e}^{-0}}{\\operatorname{cos}⁡0} \\\\  & =\\frac{1+1}{1} \\\\  & =2\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\lim\\limits_{t \\to 0}\\mathbf f(t) = -\\mathbf i + \\mathbf j +2\\,\\mathbf k.\n$$"} {:db/id #edb/ref 17592186114970 :question/id #uuid "ce098ff9-2ef1-5483-b057-b3fef12af16d" :question/math-academy-id "e-2477" :question/problem "Find the derivative of $\\mathbf f(t) + 2\\mathbf g(t)$ with respect to $t,$ where $\\mathbf f(t)$ and $\\mathbf g(t)$ are defined as follows:\n\n$$\n\\begin{aligned}f(t) & =(4{t}^{2}+9)\\,i-(\\frac{1}{t-2})\\,j+\\operatorname{cos}⁡2t\\,k \\\\ g(t) & =(4t-1)\\,i+{e}^{3t}\\,j+\\operatorname{cos}⁡2t\\,k\\end{aligned}\n$$" :question/worked-solution "Using the constant multiple rule and the sum rule, we have\n\n$$\n(\\mathbf f(t) + 2\\mathbf g(t))' = \\mathbf f'(t) + 2\\mathbf g'(t).\n$$\n\nNow, let's find the derivative of each function:\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(4{t}^{2}+9)\\,i+\\frac{\\text{d}}{\\text{d}t}(-\\frac{1}{t-2})\\,j+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡2t)\\,k \\\\  & =8t\\,i+\\frac{1}{(t-2)^{2}}\\,j-2\\operatorname{sin}⁡2t\\,k, \\\\ {g}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(4t-1)\\,i+\\frac{\\text{d}}{\\text{d}t}({e}^{3t})j+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡2t)k \\\\  & =4\\,i+3{e}^{3t}\\,j-2\\operatorname{sin}⁡2t\\,k.\\end{aligned}\n$$\n\n \n\nTherefore, we have\n\n$$\n\\begin{aligned}(f(t)+2g(t))^{′} & ={f}^{′}(t)+2{g}^{′}(t) \\\\  & =(8t\\,i+\\frac{1}{(t-2)^{2}}\\,j-2\\operatorname{sin}⁡2t\\,k)+2(4\\,i+3{e}^{3t}\\,j-2\\operatorname{sin}⁡2t\\,k) \\\\  & =8(t+1)\\,i+(\\frac{1}{(t-2)^{2}}+6{e}^{3t})\\,j-6\\operatorname{sin}⁡2t\\,k.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186114973 :question/id #uuid "228ae66f-9dad-5e6d-b405-9fbe62ecb7e9" :question/math-academy-id "e-2480" :question/problem "Find $\\dfrac{\\textrm d}{\\textrm dt} (\\mathbf f \\cdot \\mathbf g)(t),$ given the following functions $\\mathbf f(t)$ and $\\mathbf g(t)\\mathbin{:}$\n\n$$\n\\begin{aligned}f(t) & =\\sqrt{t}\\,i+{t}^{2}j \\\\ g(t) & =\\frac{1}{t}i+{e}^{t}j\\end{aligned}\n$$" :question/worked-solution "Using the dot product rule, we have\n\n$$\n\\dfrac{\\textrm d}{\\textrm dt}(\\mathbf{f} \\cdot \\mathbf{g})(t) = \\dfrac{\\textrm d}{\\textrm dt}(\\mathbf{f}(t)) \\cdot \\mathbf{g}(t) + \\mathbf{f}(t) \\cdot \\dfrac{\\textrm d}{\\textrm dt}(\\mathbf{g}(t))\n$$\n\nLet's now find the derivatives of each function:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}f(t) & =\\frac{\\text{d}}{\\text{d}t}(\\sqrt{t})i+\\frac{\\text{d}}{\\text{d}t}({t}^{2})j \\\\  & =\\frac{1}{2\\sqrt{t}}\\,i+2t\\,j, \\\\ \\frac{\\text{d}}{\\text{d}t}g(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t})i+\\frac{\\text{d}}{\\text{d}t}({e}^{t})j \\\\  & =-\\frac{1}{{t}^{2}}\\,i+{e}^{t}\\,j.\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\n\\dfrac{\\textrm d}{\\textrm dt} (\\mathbf f \\cdot \\mathbf g)(t)\n&= \\dfrac{\\textrm d}{\\textrm dt}(\\mathbf{f}(t)) \\cdot \\mathbf{g}(t) + \\mathbf{f}(t) \\cdot \\dfrac{\\textrm d}{\\textrm dt}(\\mathbf{g}(t)) \\\\[3pt]\n&= \\left(\\dfrac{1}{2\\sqrt{t}} \\,\\mathbf i +2t \\, \\mathbf j \\right) \\cdot \\left(\\dfrac{1}{t} \\,  \\mathbf i + e^t \\,  \\mathbf j \\right) +\n\\left(\\sqrt{t} \\,  \\mathbf i + t^2 \\,  \\mathbf j \\right) \\cdot \\left(-\\dfrac{1}{t^2}  \\, \\mathbf i + e^t \\, \\mathbf j  \\right) \\\\[3pt]\t\t \n&=\\dfrac{1}{2t\\sqrt{t}}  +2te^t    +  \\left(-\\dfrac{\\sqrt{t}}{t^2}\\right)    + t^2e^t \\\\[3pt]\n&=\\dfrac{\\sqrt{t}}{2t^2}  -  \\dfrac{\\sqrt{t}}{t^2} +2te^t   + t^2e^t  \\\\[3pt]\n&= -\\dfrac{\\sqrt{t}}{2t^2} +\\left(2t+t^2\\right)e^t.\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186114976 :question/id #uuid "d2650d6c-2bbf-5f1e-bed4-dbba454334cc" :question/math-academy-id "e-2485" :question/problem "Is the vector function $\\mathbf{f}(t) = \\left\\langle 2e^t, \\: \\dfrac{\\pi}{t-3}, \\: \\sqrt{t} \\right\\rangle$ differentiable with respect to $t$ on $t \\in [0, 2]?$" :question/worked-solution "The function is defined on $t \\in [0, 2].$ Remember that a function is differentiable on the interval $[0, 2]$ if and only if all of its component functions are differentiable on that interval.\n\nLet's now differentiate $\\mathbf f(t)$ to find $\\mathbf f'(t)\\mathbin{:}$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2{e}^{t}),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{\\pi }{t-3}),\\,\\frac{\\text{d}}{\\text{d}t}(\\sqrt{t})⟩ \\\\  & =⟨2{e}^{t},\\,-\\frac{\\pi }{(t-3)^{2}},\\,\\frac{1}{2\\sqrt{t}}⟩\\end{aligned}\n$$\n\nNotice that the third component of this vector, $\\dfrac{1}{2\\sqrt{t}}$ is undefined at $t = 0.$ Therefore, we conclude that the function $\\mathbf f(t)$ is **not** differentiable on $[0,2].$"} {:db/id #edb/ref 17592186115009 :question/id #uuid "62e4b12a-19ed-5316-a395-b67da1313687" :question/math-academy-id "e-3529" :question/problem "Given that $x_1$ and $x_2$ are the solutions to the equation $\\sec x={\\sqrt{2}}$ for $-180^\\circ \\leq  x <            180^\\circ,$ what is the numerical value of $x_1\\cdot x_2?$" :question/worked-solution "Recall that $\\sec x = \\dfrac{1}{\\cos x}.$ Therefore the given equation is equivalent to\n\n$$\n\\cos{x} = \\frac{1}{\\sqrt{2}}=\\dfrac{\\sqrt{2}}{2}.\n$$\n\nFirst, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arccos}⁡(\\frac{1}{\\sqrt{2}})={45}^{∘}\\end{aligned}\n$$\n\nSince $45^\\circ$ lies inside the required domain, our first solution is $x_1 = 45^\\circ.$\n\nOur first solution lies in the first quadrant and has a reference angle of $\\theta_R = 45^\\circ.$ Since $\\cos{x} > 0,$ the second solution must lie in the fourth quadrant, and it also has a reference angle $\\theta_R = 45^\\circ.$\n\n![](images/c7/c722d4fa2b77011e4df5b086c19bb09943446941484cfaf87559ca39a52183bc.png)\n\nA second solution $X$ lies in the $4$th quadrant, and we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}X & ={360}^{∘}-{\\theta }_{R} \\\\  & ={360}^{∘}-{45}^{∘} \\\\  & ={315}^{∘}\\end{aligned}\n$$\n\nHowever, this value is not in the required domain. To get the second solution $x_2$ that's within the given domain, we subtract $360^\\circ\\mathbin{:}$\n\n$$\nx_2 = 315^\\circ - 360^\\circ = -45^\\circ.\n$$\n\nSo, the solutions are $x=45^\\circ,-45^\\circ.$\n\nFinally,\n\n$$\nx_1\\cdot x_2 = 45\\cdot (-45)=-2\\,025.\n$$"} {:db/id #edb/ref 17592186115013 :question/id #uuid "b13213ea-be0a-5f1a-85fd-02b69556bd58" :question/math-academy-id "e-3537" :question/problem "Given that $x_1$ and $x_2$ are the solutions to the equation $3\\cot x + 3\\sqrt{3}=0$ for $0^\\circ \\leq x <  360^\\circ,$ what is the numerical value of $x_1\\cdot x_2?$" :question/worked-solution "First, we rearrange the equation to isolate $\\cot x\\mathbin{:}$\n\n$$\n\\begin{aligned}3\\operatorname{cot}⁡x+3\\sqrt{3} & =0 \\\\ 3\\operatorname{cot}⁡x & =-3\\sqrt{3} \\\\ \\operatorname{cot}⁡x & =-\\frac{3\\sqrt{3}}{3} \\\\ \\operatorname{cot}⁡x & =-\\sqrt{3}\\end{aligned}\n$$\n\nRecall that $\\cot{x}=\\dfrac{1}{\\tan{x}}.$ Therefore, the given equation is equivalent to\n\n$$\n\\tan{x} =-\\dfrac{1}{\\sqrt{3}}=-\\dfrac{\\sqrt{3}}{3}.\n$$\n\nNow, we find the principal value:\n\n$$\n\\begin{aligned}x & =\\operatorname{arctan}⁡(-\\frac{\\sqrt{3}}{3})=-{30}^{∘}\\end{aligned}\n$$\n\nSince $-30^\\circ$ lies outside the given domain, it is not a solution. However, we can generate solutions by adding integer multiples of $180^\\circ$ as follows:\n\n$$\n\\begin{aligned}{x}_{1} & =x+{180}^{∘} \\\\  & =-{30}^{∘}+{180}^{∘} \\\\  & ={150}^{∘} \\\\  \\\\ {x}_{2} & =x+{360}^{∘} \\\\  & =-{30}^{∘}+{360}^{∘} \\\\  & ={330}^{∘}\\end{aligned}\n$$\n\nSo, the solutions are $x=150^\\circ, 330^\\circ.$\n\nFinally, the numerical value of $x_1 \\cdot x_2$ is $150 \\cdot 330 = 49\\,500.$"} {:db/id #edb/ref 17592186115014 :question/id #uuid "a30eea56-2088-549f-a986-08d54117615b" :question/math-academy-id "e-3539" :question/problem "Given that $x_1$ and $x_2$ are the solutions to the equation $3\\cot x + 3\\sqrt{3}=0$ for $-180^\\circ <                      x <                      180^\\circ,$ what is the numerical value of $x_1\\cdot x_2?$" :question/worked-solution "First, we rearrange the equation and isolate $\\cot x\\mathbin{:}$\n\n$$\n\\begin{aligned}3\\operatorname{cot}⁡x+3\\sqrt{3} & =0 \\\\ 3\\operatorname{cot}⁡x & =-3\\sqrt{3} \\\\ \\operatorname{cot}⁡x & =-\\frac{3\\sqrt{3}}{3} \\\\ \\operatorname{cot}⁡x & =-\\sqrt{3}\\end{aligned}\n$$\n\nRecall that $\\cot{x}=\\dfrac{1}{\\tan{x}}.$ Therefore, the given equation is equivalent to\n\n$$\n\\tan{x} =-\\dfrac{1}{\\sqrt{3}}=-\\dfrac{\\sqrt{3}}{3}\n$$\n\nNow, we find the principal value:\n\n$$\n\\begin{aligned}x & =\\operatorname{arctan}⁡(-\\frac{\\sqrt{3}}{3})=-{30}^{∘}\\end{aligned}\n$$\n\nSince $-30^\\circ$ lies inside the given domain, our first solution is $x_1 =-30^\\circ .$\n\nTo generate more solutions, we add integer multiples of $180^\\circ$ as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={x}_{1}+{180}^{∘} \\\\  & =-{30}^{∘}+{180}^{∘} \\\\  & ={150}^{∘}\\end{aligned}\n$$\n\nSo, the solutions are $x= -30^\\circ, 150^\\circ .$\n\nFinally, the numerical value of $x_1\\cdot x_2$ is \n\n$$\n-30\\cdot(150) = -4\\,500.\n$$"} {:db/id #edb/ref 17592186115015 :question/id #uuid "e487c6cd-b5ce-5937-aaaa-ea37101b2ede" :question/math-academy-id "e-3602" :question/problem "Calculate $\\lim_\\limits{x\\to \\pi/8} \\left(1 + 2\\sin \\left(2x\\right) \\right)^2$." :question/worked-solution "Substituting\n\n$$\nx=\\dfrac{\\pi}{8}\n$$\n\ndirectly into the limit, we have\n\n$$\n\\begin{aligned}\nlim_(x → π/8)(1 + 2\\sin (2x))^{2} &= (1 + 2\\sin (2 \\cdot \\frac{π}{8}))^{2} \\\\\n&= (1 + 2\\sin (\\frac{π}{4}))^{2} \\\\\n&= (1 + 2 \\cdot \\frac{\\sqrt{2}}{2})^{2} \\\\\n&= (1 + \\sqrt{2})^{2} \\\\\n&= 1^{2} + 2 \\cdot 1 \\cdot \\sqrt{2} + (\\sqrt{2})^{2} \\\\\n&= 1 + 2\\sqrt{2} + 2 \\\\\n&= 3 + 2\\sqrt{2}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186115017 :question/id #uuid "8d8e5627-b2eb-5efc-8b9a-f16924bd7842" :question/math-academy-id "e-3606" :question/problem "Find $\\lim_\\limits{x \\to \\sqrt{\\pi}/2}\\tan\\left(2x^2-\\dfrac{\\pi}{4}\\right)$." :question/worked-solution "Substituting\n\n$$\nx=\\dfrac{\\sqrt \\pi}{2}\n$$\n\ndirectly into the limit, we have\n\n$$\n\\begin{aligned}\nlim_(x → \\sqrt{π}/2)\\tan (2x^{2} - \\frac{π}{4}) &= \\tan (2(\\frac{\\sqrt{π}}{2})^{2} - \\frac{π}{4}) \\\\\n&= \\tan (2(\\frac{π}{4}) - \\frac{π}{4}) \\\\\n&= \\tan (\\frac{π}{2} - \\frac{π}{4}) \\\\\n&= \\tan (\\frac{π}{4}) \\\\\n&= 1\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186115018 :question/id #uuid "9636e4d1-8481-5035-8393-27143a7a2be9" :question/math-academy-id "e-3607" :question/problem "Evaluate $\\lim_\\limits {x \\to (-\\pi/6)^{-}} \\tan\\left(x-\\dfrac\\pi 3 \\right)$." :question/worked-solution "First, let's try direct substitution:\n\n$$\n\\begin{aligned}\nlim_(x → (- π/6)^{-})\\tan (x - \\frac{π}{3}) &= lim_(x → (- π/6)^{-})(\\sin (x - \\frac{π}{3}))/(\\cos (x - \\frac{π}{3})) \\\\\n&= (\\sin (-\\frac{π}{6} - \\frac{π}{3}))/(\\cos (-\\frac{π}{6} - \\frac{π}{3})) \\\\\n&= (\\sin (-\\frac{π}{2}))/(\\cos (-\\frac{π}{2})) \\\\\n&= \\frac{-1}{0}\n\\end{aligned}\n$$\n\nwhich is not defined.\n\nTherefore, to find the limit, let's sketch the graph of\n\n$$\ny = \\tan\\left(x-\\dfrac\\pi 3 \\right)\n$$\n\n![](images/e2/e201daa486919eaba9f209334ef904a18415f14563da5c85e63047a2d149f3b3.png)\n\nWe see that as $x$ approaches\n\n$$\n-\\dfrac\\pi 6\n$$\n\nfrom the left, the values of\n\n$$\ny=\\tan\\left(x-\\dfrac\\pi 3 \\right)\n$$\n\nare positive and increase without bound. Therefore, we conclude that\n\n$$\n\\lim_\\limits {x \\to (-\\pi/6)^{-}} \\tan\\left(x-\\dfrac\\pi 3 \\right)= \\infty\n$$"} {:db/id #edb/ref 17592186115022 :question/id #uuid "83b8a6dd-c8c4-5537-ac88-289265752755" :question/math-academy-id "e-3648" :question/problem "Find the slope of $y=f(x)$ at $x=\\dfrac{\\pi}{4}$ if $f(x) = \\dfrac{-2\\cot x}{\\sin x}.$" :question/worked-solution "First, we calculate the derivative using the quotient rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{-2cot⁡x}{sin⁡x}) \\\\  & =\\frac{\\frac{\\text{d}}{\\text{d}x}(-2cot⁡x)\\cdot sin⁡x-(-2cot⁡x)\\cdot \\frac{\\text{d}}{\\text{d}x}(sin⁡x)}{{[sin⁡x]}^{2}} \\\\  & =\\frac{-2(-{csc}^{2}⁡x)\\cdot sin⁡x+2cot⁡x\\cdot (cos⁡x)}{{sin}^{2}⁡x} \\\\  & =\\frac{2csc⁡x+2cot⁡xcos⁡x}{{sin}^{2}⁡x}\\end{aligned}\n$$\n\nThen, we substitute $x=\\dfrac{\\pi}{4}$ in the derivative and get\n\n$$\n\\begin{aligned}{f}^{′}(\\frac{\\pi }{4}) & =\\frac{2csc⁡(\\frac{\\pi }{4})+2cot⁡(\\frac{\\pi }{4})cos⁡(\\frac{\\pi }{4})}{{sin}^{2}⁡(\\frac{\\pi }{4})} \\\\  & =\\frac{2\\cdot (\\sqrt{2})+2\\cdot (1)\\cdot (\\frac{\\sqrt{2}}{2})}{{(\\frac{\\sqrt{2}}{2})}^{2}} \\\\  & =\\frac{3\\sqrt{2}}{(\\frac{1}{2})} \\\\  & =6\\sqrt{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186115024 :question/id #uuid "c05abaf0-04ed-5bd5-a87c-a3a74f832bb2" :question/math-academy-id "e-3676" :question/problem "If $\\cos x + \\sin x = \\dfrac{\\sqrt{2}}{3}$ and $\\cos x - \\sin x = -\\dfrac{4}{3}$, find the value of $\\cos{2x}$." :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n\\cos{2x} = \\cos^2{x} - \\sin^2{x}\n$$\n\nWe are given the following system of equations:\n\n$$\n{\\left\\{  \\begin{array}{l}\\cos   x + \\sin   x = {\\displaystyle \\frac{\\sqrt{2}}{3}} \\\\ \\cos   x - \\sin   x = - {\\displaystyle \\frac{4}{3}}\\end{array} \\right. }\n$$\n\nMultiplying the two equations and using the double-angle formula for cosine, we get\n\n$$\n\\begin{aligned}\n(\\cos x + \\sin x)(\\cos x - \\sin x) &= (\\frac{\\sqrt{2}}{3}) \\cdot (-\\frac{4}{3}) \\\\\n\\cos^{2} x - \\sin^{2} x &= -\\frac{4\\sqrt{2}}{9} \\\\\n\\cos 2x &= -\\frac{4\\sqrt{2}}{9}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186115042 :question/id #uuid "088cff27-4c06-542c-876b-d3d2ed7b0504" :question/math-academy-id "e-4150" :question/problem "Solve the equation $\\ln (2x^2)=\\ln (3x).$" :question/worked-solution "Since the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(2{x}^{2}) & =\\operatorname{ln}⁡(3x) \\\\ 2{x}^{2} & =3x \\\\ 2{x}^{2}-3x & =0 \\\\ x(2x-3) & =0 \\\\ x & =0,\\,\\frac{3}{2}.\\end{aligned}\n$$\n\nLet's now check for extraneous solutions by substituting back into the original equation: \n\n- Substituting $x=0$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(2{x}^{2}) & \\overset{?}{=}\\operatorname{ln}⁡(3x) \\\\ \\operatorname{ln}⁡(2(0)^{2}) & \\overset{?}{=}\\operatorname{ln}⁡(3(0)) \\\\ \\operatorname{ln}⁡(0) & \\overset{?}{=}\\operatorname{ln}⁡(0)\\,\\times \\end{aligned}\n$$\n\nwhich is not valid because $\\ln \\left(0\\right)$ is undefined. Therefore, $x=0$ is not a valid solution.\n\n- Substituting $x=\\dfrac{3}{2}$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(2{x}^{2}) & \\overset{?}{=}\\operatorname{ln}⁡(3x) \\\\ \\operatorname{ln}⁡(2{(\\frac{3}{2})}^{2}) & \\overset{?}{=}\\operatorname{ln}⁡(3(\\frac{3}{2})) \\\\ \\operatorname{ln}⁡(\\frac{9}{2}) & =\\operatorname{ln}⁡(\\frac{9}{2}).\\,✓\\end{aligned}\n$$\n\nTherefore, $x=\\dfrac{3}{2}$ is a valid solution.\n\nTherefore, the only solution is $x =\\dfrac{3}{2}.$"} {:db/id #edb/ref 17592186115046 :question/id #uuid "d291f7fb-780c-510d-a706-9cc3a15177fb" :question/math-academy-id "e-4154" :question/problem "Find the solution to $\\log\\left(x \\right) - \\log \\left(2 \\right) = 1$." :question/worked-solution "The logarithms share the same base, so we can combine them using the quotient rule, as follows:\n\n$$\n\\begin{aligned}\n\\log (x) - \\log (2) &= 1 \\\\\n\\log (\\frac{x}{2}) &= 1\n\\end{aligned}\n$$\n\nNow, we solve the equation for $x$ using the usual methods.\n\n$$\n\\begin{aligned}\n10^{\\log (x/2)} &= 10^{1} \\\\\n\\frac{x}{2} &= 10 \\\\\nx &= 20\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186115047 :question/id #uuid "0347b53a-4f7c-587e-9232-aa9be2065576" :question/math-academy-id "e-416" :question/problem "Calculate $\\displaystyle \\int_{1}^{4} \\left(\\sqrt x - \\dfrac 2 {x^2}\\right) \\, \\textrm d x .$" :question/worked-solution "First, we rewrite the integral as\n\n$$\n\\int_1^4 \\left( \\sqrt x - \\dfrac 2 {x^2} \\right) \\, \\textrm dx = \\int_1^4 \\left( x^{1/2}-2x^{-2} \\right) \\, \\textrm dx.\n$$\n\n \n\nThen, we split the integral into the difference of two integrals and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}(\\sqrt{x}-\\frac{2}{{x}^{2}})\\,\\text{d}x & ={\\int }_{1}^{4}{x}^{1/2}\\,\\text{d}x-2{\\int }_{1}^{4}{x}^{-2}\\,\\text{d}x \\\\  & =\\frac{2}{3}{x}^{3/2}\\,{|}_{1}^{4}+2{x}^{-1}\\,{|}_{1}^{4} \\\\  & =\\frac{2}{3}({4}^{3/2}-{1}^{3/2})+2({4}^{-1}-{1}^{-1}) \\\\  & =\\frac{2}{3}(8-1)+2(\\frac{1}{4}-1) \\\\  & =\\frac{14}{3}+2\\cdot (-\\frac{3}{4}) \\\\  & =\\frac{14}{3}-\\frac{3}{2} \\\\  & =\\frac{19}{6}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186115049 :question/id #uuid "f0f39f69-9d92-56bb-90ac-b8dc7ba8cff9" :question/math-academy-id "e-4254" :question/problem "Evaluate $\\displaystyle\\lim_{x\\to-\\infty} -3\\left(\\dfrac 1 2\\right)^x.$" :question/worked-solution "First, we rewrite the limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }-3{(\\frac{1}{2})}^{x}=-3\\cdot {lim}_{x\\to -\\infty }{(\\frac{1}{2})}^{x}\\end{aligned}\n$$\n\nNext, we recall the graph of $y = \\left(\\dfrac 1 2\\right)^x.$\n\n![](images/07/074a330c55b63458fe94ed36b0c569ecfc6ce8fd839b8566f1dd589440c59c69.png)\n\nFrom the graph, we see that the function increases without bound as $x$ decreases. Therefore,\n\n$$\n\\lim_{x\\to-\\infty} \\left(\\dfrac 1 2\\right)^x = \\infty.\n$$\n\nHowever, the negative factor $-3$ changes the sign of the limit. Therefore, we conclude that\n\n$$\n-3\\cdot \\lim_{x\\to-\\infty} \\left(\\dfrac 1 2\\right)^x = -\\infty.\n$$"} {:db/id #edb/ref 17592186115050 :question/id #uuid "a3b5986b-17df-5d36-aa1f-6d7d0ef35c85" :question/math-academy-id "e-4260" :question/problem "Given that $x_1$ and $x_2$ are the solutions to the equation $\\sec x= 3$ for $0 \\leq x <                2\\pi,$ what is the value of $x_1\\cdot x_2,$ rounded to one decimal place?" :question/worked-solution "Recall that $\\sec x = \\dfrac{1}{\\cos x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\cos x = \\dfrac{1}{3}.\n$$\n\nFirst, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arccos}⁡(\\frac{1}{3})=1.230\\,959…≈1.231\\,0\\end{aligned}\n$$\n\nSince $1.231\\,0$ lies inside the specified domain, our first solution is $x_1 = 1.231\\,0.$\n\nOur first solution lies in the first quadrant and has a reference angle of $\\theta_R = 1.231\\,0.$ Since $\\cos{x} > 0,$ the second solution must lie in the fourth quadrant, and it also has a reference angle $\\theta_R = 1.231\\,0.$\n\n![](images/50/50df7e600a9350f2413da4060293116cccf770df200e55f6534d953d68df42ba.png)\n\nSince the second solution $x_2$ lies in the $4$th quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =2\\pi -{\\theta }_{R} \\\\  & =2\\pi -1.231\\,0 \\\\  & =5.052\\,2\\end{aligned}\n$$\n\nFinally,\n\n$$\nx_1\\cdot x_2 \\approx 1.231\\,0 \\cdot 5.052\\,2 \\approx 6.2\n$$\n\nrounded to one decimal place."} {:db/id #edb/ref 17592186115051 :question/id #uuid "5044ded5-04bb-57f8-935c-a4a9264d5055" :question/math-academy-id "e-4262" :question/problem "Find, in radians to $1$ decimal place, all of the solutions to the equation $\\dfrac{\\csc x}{5} -1 = 0$ for $0 \\leq x <              2\\pi.$" :question/worked-solution "First, we rearrange the equation, isolating $\\csc {x} \\mathbin{:}$\n\n$$\n\\begin{aligned}\\frac{\\operatorname{csc}⁡x}{5}-1 & =0 \\\\ \\frac{\\operatorname{csc}⁡x}{5} & =1 \\\\ \\operatorname{csc}⁡x & =5\\end{aligned}\n$$\n\nRecall that $\\csc{x} = \\dfrac{1}{\\sin{x}},$ therefore the given equation is equivalent to\n\n$$\n\\sin{x} = \\frac{1}{5}.\n$$\n\nNow, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arcsin}⁡(\\frac{1}{5})=0.201\\,357…≈0.201\\end{aligned}\n$$\n\nSince $0.201$ lies inside the given domain, our first solution is $x_1 = 0.201.$\n\nOur first solution lies in the first quadrant and has a reference angle of $\\theta_R = 0.201.$ Since $\\sin{x} > 0,$ the second solution must lie in the second quadrant, and it also has a reference angle $\\theta_R = 0.201.$\n\n![](images/8b/8bcd1ea412f9235a330f37ee9059a023d0ce9e03e2c38388875dc0c12afebc1e.png)\n\nSince the second solution $x_2$ lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi -{\\theta }_{R} \\\\  & =\\pi -0.201 \\\\  & ≈2.941\\end{aligned}\n$$\n\nSo, the solutions (rounded to one decimal place) are $x = 0.2, 2.9.$"} {:db/id #edb/ref 17592186115053 :question/id #uuid "bc14e14d-d58f-5556-af4d-4aa52f394e58" :question/math-academy-id "e-4266" :question/problem "Given that $x_1$ and $x_2$ are the solutions to the equation  $2\\cot x =9 - \\cot x$ for $0 \\leq x <                         2\\pi,$ what is the value of $x_1\\cdot x_2,$ rounded to one decimal place?" :question/worked-solution "First, we rearrange the equation to isolate $\\cot x\\mathbin{:}$\n\n$$\n\\begin{aligned}2\\operatorname{cot}⁡x & =9-\\operatorname{cot}⁡x \\\\ 3\\operatorname{cot}⁡x & =9 \\\\ \\operatorname{cot}⁡x & =3\\end{aligned}\n$$\n\nRecall that $\\cot{x}=\\dfrac{1}{\\tan{x}}.$ Therefore, the given equation is equivalent to\n\n$$\n\\tan{x} =\\dfrac{1}{3} .\n$$\n\nNow, we find the principal value:\n\n$$\n\\begin{aligned}x=\\text{arctan}(\\frac{1}{3})=0.321\\,750≈0.321\\,8\\end{aligned}\n$$\n\nSince $0.321\\,8$ lies inside the given domain, our first solution is $x_1 = 0.321\\,8.$\n\nTo generate more solutions, we add integer multiples of $\\pi,$ as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={x}_{1}+\\pi  \\\\  & =\\pi +0.321\\,8 \\\\  & =3.463\\,4\\end{aligned}\n$$\n\nFinally, the value of $x_1\\cdot x_2$ is\n\n$$\n0.321\\,8 \\cdot 3.463\\,4 \\approx 1.1\n$$\n\nrounded to one decimal place."} {:db/id #edb/ref 17592186115055 :question/id #uuid "dccfd244-648c-59a3-9cd0-b7c4c51ebddc" :question/math-academy-id "e-4356" :question/problem "The diagram below shows a sector of a circle of radius $2 \\, \\textrm{cm}$. Given that $m\\angle COD = \\dfrac{3\\pi}{4}$ radians, find the area of the sector $COD$.\n\n![](images/66/6662f2c72f0d8409d62d2a15d726e91b9fc2a357cd1252916f3d11cc8b9b690f.png)" :question/worked-solution "Here, we have the central angle\n\n$$\n\\theta = \\dfrac{3\\pi}{4}\n$$\n\nand radius\n\n$$\nr = 2 \\, \\textrm{cm}\n$$\n\nTo find the area of the sector, we use the formula\n\n$$\n\\mathcal{A} = \\dfrac{r^2 \\theta}{2}\n$$\n\nSubstituting the known values into this formula gives\n\n$$\n\\begin{aligned}\nA &= \\frac{r^{2}θ}{2} \\\\\n&= (2^{2} \\cdot (\\frac{3π}{4}))/(2) \\\\\n&= (4 \\cdot (\\frac{3π}{4}))/(2) \\\\\n&= \\frac{3π}{2}cm^{2}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186115069 :question/id #uuid "bfe24c48-c5eb-59ca-b34d-7e0540079c44" :question/math-academy-id "e-46" :question/problem "Compute $\\lim_\\limits{x \\to \\infty} -5 \\left(\\dfrac{1}{3}\\right)^{1+x}.$" :question/worked-solution "We can use the laws of exponents and the algebra of limits to rewrite the given limit as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }-5{(\\frac{1}{3})}^{1+x} & =-5{lim}_{x\\to \\infty }{(\\frac{1}{3})}^{1+x} \\\\  & =-5{lim}_{x\\to \\infty }{(\\frac{1}{3})}^{1}\\cdot {(\\frac{1}{3})}^{x} \\\\  & =-5{lim}_{x\\to \\infty }\\frac{1}{3}\\cdot {(\\frac{1}{3})}^{x} \\\\  & =-\\frac{5}{3}\\cdot {lim}_{x\\to \\infty }{(\\frac{1}{3})}^{x}\\end{aligned}\n$$\n\nNext, we recall the graph of $y = \\left(\\dfrac 1 3\\right)^x.$\n\n![](images/81/81be7f2983aeb647a8fa88e2caad8cea3c2052190222670838077e760a2e7fda.png)\n\nFrom the graph, we see that the function decreases to zero as $x$ increases. So\n\n$$\n\\lim_\\limits{x \\to \\infty}   \\left(\\dfrac{1}{3}\\right)^{x} = 0,\n$$\n\nand finally, we have\n\n$$\n-\\dfrac{5}{3}\\cdot \\lim_\\limits{x \\to \\infty}   \\left(\\dfrac{1}{3}\\right)^{x} = -\\dfrac 5 3\\cdot 0 = 0.\n$$"} {:db/id #edb/ref 17592186115120 :question/id #uuid "842fcabb-8ca9-5906-8f09-160e644e2520" :question/math-academy-id "e-5848" :question/problem "Given that $f(x) = \\dfrac{2x^3}{x^2-1}\\to a$ as $x \\rightarrow \\infty$, what is $a$?" :question/worked-solution "To find the end behavior of a rational function, we divide each term of the function by the dominant term in the denominator. Then, we find the function's end behavior by considering the end behavior of the individual terms.\n\nSince the highest power of $x$ in the denominator is $2$, the dominant term is $x^2$.\n\nNow, dividing each term by $x^2$, we get\n\n$$\n\\begin{aligned}\nf(x) &= \\frac{2x^{3}}{x^{2} - 1} \\\\\n&= ((\\frac{2x^{3}}{x^{2}}))/((\\frac{x^{2}}{x^{2}} - \\frac{1}{x^{2}})) \\\\\n&= (2x)/((1 - \\frac{1}{x^{2}}))\n\\end{aligned}\n$$\n\nAs $x$ approaches $\\infty$, the term\n\n$$\n\\dfrac{1}{x^2}\n$$\n\nbecomes very small, whereas $2x$ becomes very large. So, as $x$ approaches $+\\infty$, we have\n\n$$\n\\begin{aligned}\nf(x) &= \\frac{2x}{1 - \\frac{1}{x^{2}}} \\\\\n&\\approx \\frac{2x}{1 - 0} \\\\\n&= 2x\n\\end{aligned}\n$$\n\nTherefore, as $x \\rightarrow \\infty$, we get\n\n$$\nf(x)\\approx 2x\\to \\infty\n$$"} {:db/id #edb/ref 17592186115131 :question/id #uuid "11a6fd49-1685-527d-8c67-fd61d3c089b1" :question/math-academy-id "e-7611" :question/problem "Given that $\\sec{x} = \\dfrac{\\sqrt{6}}{2}$, find the exact value of $\\cos{2x}$." :question/worked-solution "First, notice that we can compute $\\cos{x}$, as follows:\n\n$$\n\\begin{aligned}\n\\cos x &= \\frac{1}{\\sec x} \\\\\n&= (1)/((\\frac{\\sqrt{6}}{2})) \\\\\n&= \\frac{2}{\\sqrt{6}} \\\\\n&= \\frac{\\sqrt{6}}{3}\n\\end{aligned}\n$$\n\nNow, since we know $\\cos{x}$, we use the following double-angle formula for cosine to compute $\\cos2x$:\n\n$$\n\\cos{2x}= 2\\cos^2{x}-1\n$$\n\nSubstituting\n\n$$\n\\cos x = \\dfrac{\\sqrt{6}}{3}\n$$\n\ninto the above, we get\n\n$$\n\\begin{aligned}\n\\cos 2x &= 2\\cos^{2} x - 1 \\\\\n&= 2(\\frac{\\sqrt{6}}{3})^{2} - 1 \\\\\n&= \\frac{4}{3} - 1 \\\\\n&= \\frac{1}{3}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186115139 :question/id #uuid "977cdc31-054e-5910-a649-e604dc4ce31f" :question/math-academy-id "e-8052" :question/problem "Find all of the real solutions to the equation $9x^4 = \\dfrac{1}{9}.$" :question/worked-solution "We can solve this equation by isolating the $x^4$ term and then taking the $4$th root of each side.\n\nFirst, let's isolate the $x^4$ term on the left-hand side:\n\n$$\n\\begin{aligned}9{x}^{4} & =\\frac{1}{9} \\\\ {x}^{4} & =\\frac{1}{81}\\end{aligned}\n$$\n\nNow, we take the $4$th root of each side and solve for $x.$ Since the exponent $(4)$ is even, we consider both the positive and negative solutions:\n\n$$\n\\begin{aligned}{x}^{4} & =\\frac{1}{81} \\\\ \\sqrt[4]{{x}^{4}} & =\\pm \\sqrt[4]{\\frac{1}{81}} \\\\ x & =\\pm \\sqrt[4]{{(\\frac{1}{3})}^{4}} \\\\ x & =\\pm \\frac{1}{3}\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\pm \\dfrac13.$"} {:db/id #edb/ref 17592186115531 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83d05e6b-994a-5931-90fb-0244e740694f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186285997} {:answer/id #uuid "b9702af1-9a01-5ff4-990f-2b8e8b2bf574" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\sqrt{2}+2" :db/id #edb/ref 17592186286475} {:answer/id #uuid "c916f7e2-e71d-5044-a1e6-83799fa5fc80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}+2" :db/id #edb/ref 17592186286622} {:answer/id #uuid "e5017828-3ef7-5857-8b3a-d98ae9e0243d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286882} {:answer/id #uuid "e79e42be-aa4f-50c1-a571-518a34f7f2ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\sqrt{2}+2" :db/id #edb/ref 17592186286908}] :answer-field/correct {:answer/id #uuid "e5017828-3ef7-5857-8b3a-d98ae9e0243d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286882} :answer-field/id #uuid "8379a3b1-8766-53c7-86da-7fc0c6df7e5d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287424}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "18111828-8d82-5c70-b695-6858b89927bd" :question/math-academy-id "q-1905" :question/problem "Find the slope of $y=f(x)$ at $x=\\frac{\\pi }{4}$ if $f(x)=2x-\\sqrt{2}sec⁡x.$" :question/worked-solution "First, we calculate the derivative using the sum rule:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2x-\\sqrt{2}sec⁡x) \\\\  & =2-\\sqrt{2}sec⁡xtan⁡x\\end{aligned}\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{4}$ in the derivative and get\n\n$$\n\\begin{aligned}{f}^{′}(\\frac{\\pi }{4}) & =2-\\sqrt{2}sec⁡(\\frac{\\pi }{4})tan⁡(\\frac{\\pi }{4}) \\\\  & =2-\\sqrt{2}(\\sqrt{2})(1) \\\\  & =2-2 \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186115570 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70ecdec2-39b7-5885-b408-d333222d7ce1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{179}}{5}" :db/id #edb/ref 17592186288817}] :answer-field/correct {:answer/id #uuid "70ecdec2-39b7-5885-b408-d333222d7ce1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{179}}{5}" :db/id #edb/ref 17592186288817} :answer-field/id #uuid "2d391c7f-e8e2-5b67-8174-0d0f404c0d60" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289834}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5710fea8-dfda-5618-84dc-c9d9011e12ae" :question/math-academy-id "q-246726" :question/problem "Compute the standard deviation $\\sigma $ of the following data set:\n\n$$\n-9,\\,-7,\\,1,\\,3,\\,4\n$$\n\nDo not round your answer.\n\n$\\sigma =$\n{{field-1}}" :question/requires-calculator true :question/worked-solution "The standard deviation of a data set ${x}_{1},{x}_{2},…,{x}_{n}$ is the square root of the variance:\n\n$$\n\\sigma =\\sqrt{{\\sigma }^{2}}=\\sqrt{\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})^{2}}=\\sqrt{\\,\\,\\,\\overset{―}{{x}^{2}}-{(\\overset{―}{x})}^{2}}\n$$\n\nFirst, let's compute $\\overset{―}{x}.$ There are $n=5$ points in our data set, so the mean is\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{5}\\cdot (-9-7+1+3+4) \\\\  & =\\frac{1}{5}\\cdot (-8) \\\\  & =-\\frac{8}{5}.\\end{aligned}\n$$\n\nNow, let's compute $\\overset{―}{{x}^{2}}.$ Computing the mean of the squares of the points in the data set, we get\n\n$$\n\\begin{aligned}\\overset{―}{{x}^{2}} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =\\frac{1}{5}\\cdot [(-9)^{2}+(-7)^{2}+{1}^{2}+{3}^{2}+{4}^{2}] \\\\  & =\\frac{1}{5}\\cdot [81+49+1+9+16] \\\\  & =\\frac{156}{5}.\\end{aligned}\n$$\n\nSo, the variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\overset{―}{{x}^{2}}-(\\overset{―}{x})^{2} \\\\  & =\\frac{156}{5}-{(-\\frac{8}{5})}^{2} \\\\  & =\\frac{156}{5}-\\frac{64}{25} \\\\  & =\\frac{780-64}{25} \\\\  & =\\frac{716}{25}.\\end{aligned}\n$$\n\nFinally, the standard deviation is\n\n$$\n\\begin{aligned}\\sigma  & =\\sqrt{{\\sigma }^{2}} \\\\  & =\\sqrt{\\frac{716}{25}} \\\\  & =\\frac{2\\sqrt{179}}{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186115654 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "214f33be-dd77-5c99-978a-69ed8f3e00a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No real solutions" :db/id #edb/ref 17592186112893} {:answer/id #uuid "5fab78db-230a-5484-967e-c80656989093" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2$ only" :db/id #edb/ref 17592186538442} {:answer/id #uuid "72363bff-e917-5f5a-8dae-8c8430b26d26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-\\frac{1}{2}$ and $x=2$" :db/id #edb/ref 17592186538488} {:answer/id #uuid "ca5402e8-2482-5ba6-ac79-a9aec1cbc11c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=0" :db/id #edb/ref 17592186538703} {:answer/id #uuid "e972a2a6-8440-546c-a253-3f8622a430a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-\\frac{1}{2}$ only" :db/id #edb/ref 17592186538764}] :answer-field/correct {:answer/id #uuid "5fab78db-230a-5484-967e-c80656989093" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2$ only" :db/id #edb/ref 17592186538442} :answer-field/id #uuid "a012673f-43e4-57ba-8170-5e5ff3cd8c03" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186112890}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "dbd430f4-5fdc-53a4-ae9b-7eaab93363e4" :question/math-academy-id "q-27742" :question/problem "Solve the equation $\\operatorname{ln}⁡(2{x}^{2}-2)=\\operatorname{ln}⁡(3x).$" :question/worked-solution "Since the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(2{x}^{2}-2) & =\\operatorname{ln}⁡(3x) \\\\ 2{x}^{2}-2 & =3x \\\\ 2{x}^{2}-3x-2 & =0 \\\\ (2x+1)(x-2) & =0 \\\\ x & =-\\frac{1}{2},2.\\end{aligned}\n$$\n\nLet's now check for extraneous solutions by substituting back into the original equation: \n\n- Substituting $x=\\frac{1}{2}$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(2{x}^{2}-2) & \\overset{?}{=}\\operatorname{ln}⁡(3x) \\\\ \\operatorname{ln}⁡(2\\cdot {(\\frac{1}{2})}^{2}-2) & \\overset{?}{=}\\operatorname{ln}⁡(3\\cdot (\\frac{1}{2})) \\\\ \\operatorname{ln}⁡(-\\frac{3}{2}) & \\overset{?}{=}\\operatorname{ln}⁡(\\frac{3}{2})\\,\\times \\end{aligned}\n$$\n\nwhich is not valid because $\\operatorname{ln}⁡(-\\frac{3}{2})$ is undefined. Therefore, $x=-\\frac{1}{2}$ is not a valid solution.\n\n- Substituting $x=2$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(2{x}^{2}-2) & \\overset{?}{=}\\operatorname{ln}⁡(3x) \\\\ \\operatorname{ln}⁡(2\\cdot {(2)}^{2}-2) & \\overset{?}{=}\\operatorname{ln}⁡(3\\cdot (2)) \\\\ \\operatorname{ln}⁡(6) & =\\operatorname{ln}⁡(6).\\,✓\\end{aligned}\n$$\n\nTherefore, $x=2$ is a valid solution.\n\nTherefore, the correct answer is \"$x=2$ only.\""} {:db/id #edb/ref 17592186115701 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1368cfff-7db3-5254-96f3-07c2d868775c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{9}" :db/id #edb/ref 17592186295373} {:answer/id #uuid "5d31a2e7-f845-5d6f-84d8-734c7f9fdf5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{\\pi }^{2}}{9}" :db/id #edb/ref 17592186295805} {:answer/id #uuid "6430dd94-cdd6-5b7c-a6ed-698e9ed44979" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{\\pi }^{2}}{3}" :db/id #edb/ref 17592186295838} {:answer/id #uuid "b6bfc3d8-2c65-5bf3-b9cc-a536405604d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{\\pi }^{2}}{9}" :db/id #edb/ref 17592186296226} {:answer/id #uuid "dc4268bd-fe81-503e-a2c7-155bbc6c537d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{3}" :db/id #edb/ref 17592186296436}] :answer-field/correct {:answer/id #uuid "5d31a2e7-f845-5d6f-84d8-734c7f9fdf5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{\\pi }^{2}}{9}" :db/id #edb/ref 17592186295805} :answer-field/id #uuid "52eff59e-5bce-5d06-bed1-69123a95aebf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296802}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "710ba61e-2523-50bc-83d0-e27883d20d99" :question/math-academy-id "q-29004" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{csc}⁡x=\\frac{2\\sqrt{3}}{3}$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" :question/requires-calculator true :question/worked-solution "Recall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=\\frac{3}{2\\sqrt{3}}=\\frac{\\sqrt{3}}{2}.\n$$\n\nFirst, we find the principal value:\n\n$$\nx=\\text{arcsin}(\\frac{\\sqrt{3}}{2})=\\frac{\\pi }{3}.\n$$\n\nSince $\\frac{\\pi }{3}$ lies inside the required domain, our first solution is ${x}_{1}=\\frac{\\pi }{3}.$\n\nOur first solution lies in the  first quadrant and has a reference angle of ${\\theta }_{R}=\\frac{\\pi }{3}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has a reference angle ${\\theta }_{R}=\\frac{\\pi }{3}.$\n\n![](images/4c/4cbf970747a9eddbcffe6fd3ba46d13c43e5f17ca56e52747c797229dbc74d48.png)\n\nSince the second solution ${x}_{2}$ lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi -{\\theta }_{R} \\\\  & =\\pi -\\frac{\\pi }{3} \\\\  & =\\frac{2\\pi }{3}\\end{aligned}\n$$\n\nSo, the solutions are $x=\\frac{\\pi }{3},\\frac{2\\pi }{3}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{\\pi }{3}\\cdot \\frac{2\\pi }{3}=\\frac{2{\\pi }^{2}}{9}.\n$$"} {:db/id #edb/ref 17592186115706 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61f6a603-e6c7-5f1a-8b29-cdfc0778cf7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,800" :db/id #edb/ref 17592186295829} {:answer/id #uuid "a60e222c-fe39-5c2a-a7ec-0459cfd900f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1\\,800" :db/id #edb/ref 17592186296142} {:answer/id #uuid "b780a719-33a5-51f6-ae01-470b57d64bf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\,600" :db/id #edb/ref 17592186296229} {:answer/id #uuid "bc1af863-f522-535b-a435-ecfa06aba4ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,600" :db/id #edb/ref 17592186296255} {:answer/id #uuid "ffa8f1d4-44ad-502a-a939-d3024011b2f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-900" :db/id #edb/ref 17592186296636}] :answer-field/correct {:answer/id #uuid "b780a719-33a5-51f6-ae01-470b57d64bf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\,600" :db/id #edb/ref 17592186296229} :answer-field/id #uuid "1c7d2f9b-39c5-5602-bab3-2c507ee78f3b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296687}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "08d793ca-18a4-5b84-a226-6c11cd4165db" :question/math-academy-id "q-29177" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{sec}⁡x=2$ for $-{180}^{∘}\\le x<{180}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2}?$" :question/requires-calculator true :question/worked-solution "Recall that $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{cos}⁡x=\\frac{1}{2}.\n$$\n\nFirst, we find the principal value:\n\n$$\nx=\\operatorname{arccos}⁡(\\frac{1}{2})={60}^{∘}\n$$\n\nSince ${60}^{∘}$ lies inside the required domain, our first solution is ${x}_{1}={60}^{∘}.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}={60}^{∘}.$ Since $\\operatorname{cos}⁡x>0,$ the second solution must lie in the fouth quadrant, and it also has a reference angle ${\\theta }_{R}={60}^{∘}.$\n\n![](images/9c/9c8adbb0a1594ae5bacfab7f1f92993c67659839599e10ab46d5cf98896e3ec7.png)\n\nA second solution $X$ lies in the $4$th quadrant, and we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}X & ={360}^{∘}-{\\theta }_{R} \\\\  & ={360}^{∘}-{60}^{∘} \\\\  & ={300}^{∘}\\end{aligned}\n$$\n\nHowever, this value is not in the required domain. To get the second solution ${x}_{2}$ that's within the given domain, we subtract ${360}^{∘}:$\n\n$$\n{x}_{2}={300}^{∘}-{360}^{∘}=-{60}^{∘}.\n$$\n\nSo, the solutions are $x={60}^{∘},-{60}^{∘}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=60\\cdot (-60)=-3\\,600.\n$$"} {:db/id #edb/ref 17592186115707 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88a2376c-dc19-5dd0-a77a-56366a05b81d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12000" :db/id #edb/ref 17592186113209} {:answer/id #uuid "c5a28036-b367-589e-9512-aab611b56f04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36000" :db/id #edb/ref 17592186113210} {:answer/id #uuid "d3998ecb-9d96-51bb-a80c-b98dba07a111" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18000" :db/id #edb/ref 17592186113211} {:answer/id #uuid "1afc57e2-95e9-5005-8244-a42d7d643df9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18000" :db/id #edb/ref 17592186113212} {:answer/id #uuid "64c56874-5776-54fe-a57b-179c6f752f5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12000" :db/id #edb/ref 17592186113213}] :answer-field/id #uuid "4e1aae67-1413-5c52-92c2-e130fc7ee0d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113208} {:answer-field/choices [{:answer/id #uuid "b0c131ae-15e2-51d9-b981-699dd3822a8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36\\,000" :db/id #edb/ref 17592186390580} {:answer/id #uuid "4abb149a-acd5-5b9b-b236-51b85d318980" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18\\,000" :db/id #edb/ref 17592186390581} {:answer/id #uuid "ea956b89-f42b-52b5-a970-4a7cbdfbbbcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12\\,000" :db/id #edb/ref 17592186390582} {:answer/id #uuid "b1c1bdc4-e73b-5851-82fe-a8e4df60d98d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18\\,000" :db/id #edb/ref 17592186390583} {:answer/id #uuid "ea082471-0a98-54a0-9c3f-4a9fcbd75fcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,000" :db/id #edb/ref 17592186390584}] :answer-field/correct {:answer/id #uuid "b1c1bdc4-e73b-5851-82fe-a8e4df60d98d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18\\,000" :db/id #edb/ref 17592186390583} :answer-field/id #uuid "974b5aa7-9854-5922-a33e-647715b7b09b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390579}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "20eb540b-84ee-5a09-81e9-e0f110dad1d7" :question/math-academy-id "q-29179" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{sec}⁡x=2$ for $-{360}^{∘}\\le x<{0}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2}?$" :question/requires-calculator true :question/worked-solution "Recall that $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{cos}⁡x=\\frac{1}{2}.\n$$\n\nFirst, we find the principal value:\n\n$$\nx=\\operatorname{arccos}⁡(\\frac{1}{2})={60}^{∘}\n$$\n\nNote that $x={60}^{∘}$ is not in the domain $-{360}^{∘}\\le x<{0}^{∘}.$ To get a solution within the required domain, we subtract ${360}^{∘}:$\n\n$$\n\\begin{aligned}{x}_{1} & ={60}^{∘}-{360}^{∘}=-{300}^{∘}\\end{aligned}\n$$\n\n \n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}={60}^{∘}.$ Since $\\operatorname{cos}⁡x>0,$ the second solution must lie in the fouth quadrant, and it also has a reference angle ${\\theta }_{R}={60}^{∘}.$\n\n![](images/9c/9c8adbb0a1594ae5bacfab7f1f92993c67659839599e10ab46d5cf98896e3ec7.png)\n\nA second solution $X$ lies in the $4$th quadrant, and we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}X & ={360}^{∘}-{\\theta }_{R} \\\\  & ={360}^{∘}-{60}^{∘} \\\\  & ={300}^{∘}\\end{aligned}\n$$\n\nNote that $X={300}^{∘}$ is not in the domain $-{360}^{∘}\\le x<{0}^{∘}.$ To get a solution within the required domain, we subtract ${360}^{∘}:$\n\n$$\n\\begin{aligned}{x}_{3} & ={300}^{∘}-{360}^{∘}=-{60}^{∘}\\end{aligned}\n$$\n\n \n\nTherefore, the solutions are $x=-{60}^{∘},-{300}^{∘}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=-60\\cdot (-300)=18\\,000\n$$"} {:db/id #edb/ref 17592186115708 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fc8fe60-09bf-544c-80ca-2daf32007aa2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,976" :db/id #edb/ref 17592186295359} {:answer/id #uuid "241573f5-78d9-52e6-a2b3-4cd166a01ad9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,936" :db/id #edb/ref 17592186295464} {:answer/id #uuid "35b06ffb-c8f7-5112-8153-a6e9df377a83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,956" :db/id #edb/ref 17592186295569} {:answer/id #uuid "36df85e6-2489-50bb-a9e6-85be9d63d9a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,916" :db/id #edb/ref 17592186295574} {:answer/id #uuid "c5af9510-3063-5ba7-9582-d93726d185b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,996" :db/id #edb/ref 17592186296309}] :answer-field/correct {:answer/id #uuid "c5af9510-3063-5ba7-9582-d93726d185b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,996" :db/id #edb/ref 17592186296309} :answer-field/id #uuid "4fc92730-fbaa-58ac-83b7-a5b1010973d2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296788}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2a1aca94-95fd-5220-bcc5-e0d2edb4ba00" :question/math-academy-id "q-29242" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation  $5\\operatorname{cot}⁡x=11+\\operatorname{cot}⁡x$ for ${0}^{∘}\\le x<{360}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2},$ rounded to the nearest integer?" :question/requires-calculator true :question/worked-solution "First, we rearrange the equation and isolate $\\operatorname{cot}⁡x$:\n\n$$\n\\begin{aligned}5\\operatorname{cot}⁡x & =11+\\operatorname{cot}⁡x \\\\ 4\\operatorname{cot}⁡x & =11 \\\\ \\operatorname{cot}⁡x & =\\frac{11}{4}\\end{aligned}\n$$\n\nRecall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{tan}⁡x=\\frac{4}{11}\n$$\n\nNow, we find the principal value:\n\n$$\n\\begin{aligned}x=\\text{arctan}(\\frac{4}{11})=(19.983\\,1…)^{∘}≈{19.983}^{∘}\\end{aligned}\n$$\n\nSince ${19.983}^{∘}$ lies inside the given domain, our first solution is ${x}_{1}={19.983}^{∘}.$\n\nTo generate more solutions, we add integer multiples of ${180}^{∘}.$ Hence,\n\n$$\n{x}_{2}={180}^{∘}+x={180}^{∘}+{19.983}^{∘}={199.983}^{∘}.\n$$\n\nFinally, the numerical value of ${x}_{1}\\cdot {x}_{2}$ is\n\n$$\n19.983\\cdot 199.983≈3\\,996\n$$\n\nrounded to the nearest integer."} {:db/id #edb/ref 17592186115710 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51617d79-3dc1-5533-bcf3-8350bcd23165" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/df/dfebb90e18fb6ed1f6743f399a4db6c0619c8d10c283e4132395eadffa9c1804.png" :db/id #edb/ref 17592186295735} {:answer/id #uuid "6c28d605-5500-5f93-8917-b653939f7c2c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4f/4f3a7481d5c892474f2c7f6eb41860da8bd33ae0ec397f915fdbf0cd58cb03e5.png" :db/id #edb/ref 17592186295867} {:answer/id #uuid "70bb9c74-c241-51cf-b905-0d535c23893a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5f/5f92926fad96fa2b2169a6706a534ae64c6565aece63a850652ce873d9a3f255.png" :db/id #edb/ref 17592186295885} {:answer/id #uuid "a8b9cfb2-9bd2-5b92-84c5-e1bfde302e50" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1e/1e281fddd01a740d89710380915c7e75eb709961072c3435795e0b6d88411df0.png" :db/id #edb/ref 17592186296153} {:answer/id #uuid "ac6cb63a-20b6-5069-b23a-4eaf443f2286" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/af/afa27f558403ddf800fe2bd2a92064cfd4a002c63aa3257a5846efd9e68119f6.png" :db/id #edb/ref 17592186296176}] :answer-field/correct {:answer/id #uuid "ac6cb63a-20b6-5069-b23a-4eaf443f2286" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/af/afa27f558403ddf800fe2bd2a92064cfd4a002c63aa3257a5846efd9e68119f6.png" :db/id #edb/ref 17592186296176} :answer-field/id #uuid "c10c6bbf-c4f0-534e-8771-b9e6433f60c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297032}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5f72261e-b4ae-549f-bbc4-928435fdb39e" :question/math-academy-id "q-29377" :question/problem "Which of the following is the graph of $y=-{(\\frac{1}{2})}^{x}+8?$" :question/worked-solution "To plot the given function, we follow these steps:\n\n- We take the curve $y={(\\frac{1}{2})}^{x}.$\n\n![](images/1a/1adec10c20862d7015466efc5ded1e966e959ac3f6141163afa26802b502d49e.png)\n\n \n\n- Reflect it on the $x$-axis to give $y=-{(\\frac{1}{2})}^{x}.$ The $y$-intercept moves from $(0,1)$ to $(0,-1)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/96/9651fab70ad189764143d92f89938cff1293a390bfca693c567bb33220ff859e.png)\n\n- Then, vertically shift it by $8$ units up to give $y=-{(\\frac{1}{2})}^{x}+8.$ The point $(0,-1)$ moves to $(0,7)$ and the horizontal asymptote moves from from $y=0$ to $y=8.$\n\n![](images/1d/1d41ded0d251b46ad6f137b6686e31bfdad299c62a1496e0782ada5d400780bf.png)"} {:db/id #edb/ref 17592186115715 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d0b50e1-fc42-5345-a5ab-a2ef511b800e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{\\pi }^{2}}{3}" :db/id #edb/ref 17592186295434} {:answer/id #uuid "308bc611-d9bb-5aae-bd96-1e4585b332cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{\\pi }^{2}}{12}" :db/id #edb/ref 17592186295546} {:answer/id #uuid "b1934988-55ca-5b6e-b2d8-ff3f78d4443b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11{\\pi }^{2}}{36}" :db/id #edb/ref 17592186296203} {:answer/id #uuid "e58c0981-c43b-5bbd-859e-2038b9c6d050" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5{\\pi }^{2}}{36}" :db/id #edb/ref 17592186296489} {:answer/id #uuid "fe2a6aa7-0f0f-5a0b-8dc0-a5ac33b65332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7{\\pi }^{2}}{36}" :db/id #edb/ref 17592186296619}] :answer-field/correct {:answer/id #uuid "e58c0981-c43b-5bbd-859e-2038b9c6d050" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5{\\pi }^{2}}{36}" :db/id #edb/ref 17592186296489} :answer-field/id #uuid "8f51b998-6fc6-5a27-b421-60685c1729ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296928}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "92bbda32-2fa5-5f1c-a9f9-c398f0ee3f0b" :question/math-academy-id "q-29637" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{cot}⁡x=\\sqrt{3}$ for $-\\pi <x<\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" :question/requires-calculator true :question/worked-solution "Recall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{tan}⁡x=\\frac{1}{\\sqrt{3}}=\\frac{\\sqrt{3}}{3}.\n$$\n\nFirst, we find the principal value:\n\n$$\nx=\\operatorname{arctan}⁡(\\frac{\\sqrt{3}}{3})=\\frac{\\pi }{6}\n$$\n\nSince $\\frac{\\pi }{6}$ lies inside the given domain, our first solution is ${x}_{1}=\\frac{\\pi }{6}.$\n\nTo generate more solutions, we add or subtract integer multiples of $\\pi .$ Hence,\n\n$$\n\\begin{aligned}{x}_{2} & ={x}_{1}-\\pi =\\frac{\\pi }{6}-\\pi =-\\frac{5\\pi }{6}.\\end{aligned}\n$$\n\nSo, the solutions are $x=-\\frac{5\\pi }{6},\\frac{\\pi }{6}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{\\pi }{6}\\cdot (-\\frac{5\\pi }{6})=-\\frac{5{\\pi }^{2}}{36}.\n$$"} {:db/id #edb/ref 17592186115729 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "efac5f38-d372-59b8-8528-cc74309ef972" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/31/318e8832debe249b366516ab592d70bab212f6bfcf8646d1513923d30b74394b.png" :db/id #edb/ref 17592186113341} {:answer/id #uuid "06da5072-c788-565b-9287-ae7716fc0c01" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d7/d7dd49a039d5c735d36d6f3a194687a13fe236c7d3d43cc2d42d64d99be7eb8b.png" :db/id #edb/ref 17592186113342} {:answer/id #uuid "1831a51d-d87e-564a-8295-24244111b7f1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2c/2c1d9f84ecd3a336dcc28321d566902a6b6509f7e27638861cf92eb7514ae78b.png" :db/id #edb/ref 17592186113343} {:answer/id #uuid "2ca48f68-9fb8-5276-89ef-49c8136687a6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/24/2436b661ae5ca922f0435f07492ff9deec753bdcfeec4f2a8cb986a720f103fc.png" :db/id #edb/ref 17592186113344} {:answer/id #uuid "47180fa4-fbb6-5ce0-830f-3fae6b31097d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/80/808beb68d38b7266d3db478f66311004b675d06c86a6f0af3836d8562bcae3dd.png" :db/id #edb/ref 17592186113345}] :answer-field/id #uuid "abae57ca-c5f8-5175-a0f8-a9718a086448" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113340}] :question/id #uuid "efb6186b-3639-510f-a13a-a2448bb1ec62" :question/math-academy-id "q-317331" :question/problem "Which of the following is the graph of $y =-3(\\frac{1}{2})^{x} + 5$?"} {:db/id #edb/ref 17592186115739 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "006c4d37-009e-5065-aa0e-e789bc12caf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4{x}^{3}}{|8-{x}^{4}|\\sqrt{(8-{x}^{4})^{2}-1}}" :db/id #edb/ref 17592186297551} {:answer/id #uuid "a3a34a37-aaa2-5b33-8413-e4f969d084a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{12{x}^{3}}{|8-{x}^{4}|\\sqrt{(8-{x}^{4})^{2}-1}}" :db/id #edb/ref 17592186298270} {:answer/id #uuid "bb221971-81aa-5b2d-a077-c6b670f32b1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8{x}^{3}}{|8-{x}^{4}|\\sqrt{(8-{x}^{4})^{2}-1}}" :db/id #edb/ref 17592186298367} {:answer/id #uuid "c0e98b1b-1585-5bcb-a6c7-f9e80aef1351" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{3}}{|8-{x}^{4}|\\sqrt{(8-{x}^{4})^{2}-1}}" :db/id #edb/ref 17592186298401} {:answer/id #uuid "cd44316a-87ed-548b-af75-38a85154bbc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12{x}^{3}}{|8-{x}^{4}|\\sqrt{(8-{x}^{4})^{2}-1}}" :db/id #edb/ref 17592186298447}] :answer-field/correct {:answer/id #uuid "bb221971-81aa-5b2d-a077-c6b670f32b1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8{x}^{3}}{|8-{x}^{4}|\\sqrt{(8-{x}^{4})^{2}-1}}" :db/id #edb/ref 17592186298367} :answer-field/id #uuid "b39d87eb-5482-5669-84b6-1f25fa680a00" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186299244}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c5f8a50f-d033-5259-86d9-bade982764d7" :question/math-academy-id "q-32000" :question/problem "Calculate ${f}^{′}(x)$ for $f(x)=2arccsc(8-{x}^{4}).$" :question/worked-solution "The formula for the derivative of $\\text{arccsc}$ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\text{arccsc}\\,x)=-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\n$$\n\nUsing the chain rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2arccsc(8-{x}^{4})) \\\\  & =2\\cdot \\frac{\\text{d}}{\\text{d}x}(arccsc(8-{x}^{4})) \\\\  & =2(-\\frac{1}{|8-{x}^{4}|\\sqrt{(8-{x}^{4})^{2}-1}})\\cdot \\frac{\\text{d}}{\\text{d}x}(8-{x}^{4}) \\\\  & =2(-\\frac{1}{|8-{x}^{4}|\\sqrt{(8-{x}^{4})^{2}-1}})\\cdot (-4{x}^{3}) \\\\  & =\\frac{8{x}^{3}}{|8-{x}^{4}|\\sqrt{(8-{x}^{4})^{2}-1}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186115757 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32f93cd8-2b18-5b9c-aa26-87db0d6e56ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨9,13,9⟩" :db/id #edb/ref 17592186563061} {:answer/id #uuid "37bbc342-deb2-5c62-b5f4-4c2ab96ccd4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨13,9,13⟩" :db/id #edb/ref 17592186563070} {:answer/id #uuid "4bbf07ed-8d8c-58e9-8f86-748f6bc62fb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨8,4,8⟩" :db/id #edb/ref 17592186563111} {:answer/id #uuid "662e9f3a-b518-5488-a346-0c63d5a3acbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨8,8,8⟩" :db/id #edb/ref 17592186563180} {:answer/id #uuid "c0e423a8-fc07-5848-a11c-d74f2340c97d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨5,5,5⟩" :db/id #edb/ref 17592186563369}] :answer-field/correct {:answer/id #uuid "37bbc342-deb2-5c62-b5f4-4c2ab96ccd4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨13,9,13⟩" :db/id #edb/ref 17592186563070} :answer-field/id #uuid "b2571b8d-0d26-528a-b57d-8d0b05516a9d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113508}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0780b7fe-8d13-5962-ac35-c60c83491b4a" :question/math-academy-id "q-32270" :question/problem "Find ${lim}_{t\\to 1}[5f(t)+2g(t)]$ given that $f(t)$ and $g(t)$ are defined as:\n\n$$\n\\begin{aligned}f(t) & =⟨{t}^{2},{t}^{3},\\frac{1}{{t}^{2}}⟩ \\\\ g(t) & =⟨5-{t}^{3},{t}^{2}-t+2,4⟩\\end{aligned}\n$$" :question/worked-solution "First, we find the limit of each function:\n\n$$\n\\begin{aligned}{lim}_{t\\to 1}f(t) & =⟨{lim}_{t\\to 1}({t}^{2}),\\,{lim}_{t\\to 1}({t}^{3}),\\,{lim}_{t\\to 1}(\\frac{1}{{t}^{2}})⟩ \\\\  & =⟨{1}^{2},{1}^{3},\\frac{1}{{1}^{2}}⟩ \\\\  & =⟨1,1,1⟩ \\\\ {lim}_{t\\to 1}g(t) & =⟨{lim}_{t\\to 1}(5-{t}^{3}),\\,{lim}_{t\\to 1}({t}^{2}-t+2),\\,{lim}_{t\\to 1}(4)⟩ \\\\  & =⟨5-{1}^{3},{1}^{2}-1+2,4⟩ \\\\  & =⟨4,2,4⟩\\end{aligned}\n$$\n\nNow, we use properties of limits to calculate the final result:\n\n$$\n\\begin{aligned}{lim}_{t\\to 1}[5f(t)+2g(t)] & ={lim}_{t\\to 1}5f(t)+{lim}_{t\\to 1}2g(t) \\\\  & =5{lim}_{t\\to 1}f(t)+2{lim}_{t\\to 1}g(t) \\\\  & =5⟨1,1,1⟩+2⟨4,2,4⟩ \\\\  & =⟨5,5,5⟩+⟨8,4,8⟩ \\\\  & =⟨13,9,13⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186115759 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c61cbc81-64a3-5a0e-b2b4-51f0e5c22c3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186113521} {:answer/id #uuid "ea9fecc2-e570-5090-90de-e3bb4487e406" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186113522} {:answer/id #uuid "2da9be63-1670-5830-8313-8546a9b933c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186113523} {:answer/id #uuid "2f76f4a3-528b-592d-82ee-a243380cb31d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186113524} {:answer/id #uuid "7506d646-9781-563c-851b-b6923974cad5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186113525}] :answer-field/correct {:answer/id #uuid "2da9be63-1670-5830-8313-8546a9b933c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186113523} :answer-field/id #uuid "22775fac-83c5-5ccc-8957-14d77e8ce237" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113520}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "23598e85-48e6-53c4-b73f-532f246bbf47" :question/math-academy-id "q-32274" :question/problem "Find the limit ${lim}_{t\\to \\pi }[f(t)\\cdot g(t)]$ given that $f(t)$ and $g(t)$ are defined as:\n\n$$\n\\begin{aligned}f(t)=[\\begin{aligned}\\operatorname{sin}⁡t \\\\ 1+\\operatorname{cos}⁡t \\\\ \\frac{4t}{\\pi }\\end{aligned}],\\,g(t)=[\\begin{aligned}\\operatorname{cos}⁡t \\\\ 2+\\operatorname{tan}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]\\end{aligned}\n$$" :question/worked-solution "First, we find the limit of each function:\n\n$$\n\\begin{aligned}{lim}_{t\\to \\pi }f(t) & =[\\begin{aligned}{lim}_{t\\to \\pi }\\,(\\operatorname{sin}⁡t) \\\\ {lim}_{t\\to \\pi }\\,(1+\\operatorname{cos}⁡t) \\\\ {lim}_{t\\to \\pi }\\,(\\frac{4t}{\\pi })\\end{aligned}]=[\\begin{aligned}\\operatorname{sin}⁡\\pi  \\\\ 1+\\operatorname{cos}⁡\\pi  \\\\ \\frac{4\\pi }{\\pi }\\end{aligned}]=[\\begin{aligned}0 \\\\ 0 \\\\ 4\\end{aligned}] \\\\ {lim}_{t\\to \\pi }g(t) & =[\\begin{aligned}{lim}_{t\\to \\pi }\\,(\\operatorname{cos}⁡t) \\\\ {lim}_{t\\to \\pi }\\,(2+\\operatorname{tan}⁡t) \\\\ {lim}_{t\\to \\pi }\\,(\\operatorname{cos}⁡t)\\end{aligned}]=[\\begin{aligned}\\operatorname{cos}⁡\\pi  \\\\ (2+\\operatorname{tan}⁡\\pi ) \\\\ \\operatorname{cos}⁡\\pi \\end{aligned}]=[\\begin{aligned}-1 \\\\ 2 \\\\ -1\\end{aligned}]\\end{aligned}\n$$\n\nNow, we use properties of limits to calculate the final result:\n\n$$\n\\begin{aligned}{lim}_{t\\to \\pi }[f(t)\\cdot g(t)] & ={lim}_{t\\to \\pi }f(t)\\cdot {lim}_{t\\to \\pi }g(t) \\\\  & =[\\begin{aligned}0 \\\\ 0 \\\\ 4\\end{aligned}]\\cdot [\\begin{aligned}-1 \\\\ 2 \\\\ -1\\end{aligned}] \\\\  & =0\\cdot (-1)+0\\cdot 2+4\\cdot (-1) \\\\  & =-4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186115770 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87085dfc-1eb2-55e6-b058-c8193dc6ee4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(t)$ and $h(t)$ only" :db/id #edb/ref 17592186113587} {:answer/id #uuid "8e7f84df-d3ea-5f0e-a2d1-76f61b5e2aa1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "All of them are differentiable on $(0, π)$" :db/id #edb/ref 17592186113588} {:answer/id #uuid "266f78fe-cf62-5647-baf7-ce8ad9c1ac76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(t)$ and $g(t)$ only" :db/id #edb/ref 17592186113589} {:answer/id #uuid "3f59ab61-4be9-50d5-bc50-b73332e351ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$g(t)$ and $h(t)$ only" :db/id #edb/ref 17592186113590} {:answer/id #uuid "570fdc35-3402-51d4-aa0b-09d5b5171559" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of them are differentiable on $(0, π)$" :db/id #edb/ref 17592186113591}] :answer-field/id #uuid "bae67170-5ab3-54b4-87a6-bfa00d56fca7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113586} {:answer-field/choices [{:answer/id #uuid "15ba69f7-a434-5ff4-969c-fa8fa69d9be0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(t)$ and $g(t)$ only" :db/id #edb/ref 17592186402043} {:answer/id #uuid "3264961f-a437-5289-bec4-efa2d5756979" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(t)$ and $h(t)$ only" :db/id #edb/ref 17592186402044} {:answer/id #uuid "f87b02d9-9e85-582c-84c5-09942dae9dd3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of them are differentiable on $(0,\\pi )$" :db/id #edb/ref 17592186402045} {:answer/id #uuid "fae54900-ccf7-5a50-91e3-eb3eccd28c4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "All of them are differentiable on $(0,\\pi )$" :db/id #edb/ref 17592186402046} {:answer/id #uuid "ff0a0f63-eca8-57ec-a462-c2093a71fe9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$g(t)$ and $h(t)$ only" :db/id #edb/ref 17592186402047}] :answer-field/correct {:answer/id #uuid "15ba69f7-a434-5ff4-969c-fa8fa69d9be0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(t)$ and $g(t)$ only" :db/id #edb/ref 17592186402043} :answer-field/id #uuid "0d70eb46-6632-54ee-b92a-5875a0ef49c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402042}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "11a6774d-821b-5df3-83c4-601fbb258758" :question/math-academy-id "q-32568" :question/problem "Which of the following vector-valued functions are differentiable with respect to $t$ on $t\\in (0,\\pi )?$\n\n$$\n\\begin{aligned}f(t) & =⟨\\operatorname{sin}⁡(2t),\\,\\operatorname{cos}⁡t,\\,2-\\operatorname{cos}⁡(2t)⟩ \\\\ g(t) & =⟨1+{t}^{2},\\,-t+2,\\,\\sqrt{t}⟩ \\\\ h(t) & =⟨\\frac{1}{t},\\,\\operatorname{tan}⁡t,\\,\\operatorname{cos}⁡t⟩\\end{aligned}\n$$" :question/worked-solution "All of these vector-valued functions are defined for all $t\\in (0,\\pi ).$ \n\nA function is differentiable on the interval $(0,\\pi )$ if and only if each of \n its component functions are differentiable on that interval.\n\nLet's now consider the functions one-by-one.\n\n- We differentiate $f(t)$ to find ${f}^{′}(t):$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(2t)),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(2-\\operatorname{cos}⁡(2t))⟩ \\\\  & =⟨2\\operatorname{cos}⁡(2t),\\,-\\operatorname{sin}⁡t,\\,2\\operatorname{sin}⁡(2t)⟩\\end{aligned}\n$$\n\nSince each component of ${f}^{′}(t)$ is defined for all  $t\\in (0,\\pi )$, we conclude that $f(t)$ is differentiable on this interval.\n\n- Next, we differentiate $g(t)$  to find ${g}^{′}(t):$\n\n$$\n\\begin{aligned}{g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(1+{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(-t+2),\\,\\frac{\\text{d}}{\\text{d}t}(\\sqrt{t})⟩ \\\\  & =⟨2t,\\,-1,\\,\\frac{1}{2\\sqrt{t}}⟩\\end{aligned}\n$$\n\nSince each component of ${g}^{′}(t)$ is defined for all $(0,\\pi )$, we have that   $g(t)$ is also differentiable on this interval.\n\n- Finally, we differentiate $h(t)$ to find ${h}^{′}(t):$\n\n$$\n\\begin{aligned}{h}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t}),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{tan}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)⟩ \\\\  & =⟨-\\frac{1}{{t}^{2}},\\,{sec}^{2}⁡t,\\,-\\operatorname{sin}⁡t⟩\\end{aligned}\n$$\n\nSince the second component of this vector, $\\operatorname{sec}⁡t$, is undefined at $t=\\frac{\\pi }{2}$,  we conclude that the function $h(t)$ is not differentiable on $(0,\\pi ).$\n\nTherefore, the answer is:\n\n$\\,$ $f(t)$ and $g(t)$ only"} {:db/id #edb/ref 17592186115774 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c0e55031-dfcb-58bc-8ad8-dcd2b37f1f2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,-\\sqrt{2},-11⟩" :db/id #edb/ref 17592186113611} {:answer/id #uuid "56467ebe-c7a2-586e-bb58-a5a7db3a157b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,-6,-9⟩" :db/id #edb/ref 17592186113614} {:answer/id #uuid "7cd4211b-e621-58bc-80fd-e9a6165b6884" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,6,11⟩" :db/id #edb/ref 17592186563219} {:answer/id #uuid "dead4f12-ca88-5ad3-a931-528e8d88c330" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-3,6+\\sqrt{2},11⟩" :db/id #edb/ref 17592186563433} {:answer/id #uuid "e79ae4b9-769d-5736-8cb4-dfec47ef6427" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,-6-\\sqrt{2},-11⟩" :db/id #edb/ref 17592186563462}] :answer-field/correct {:answer/id #uuid "e79ae4b9-769d-5736-8cb4-dfec47ef6427" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,-6-\\sqrt{2},-11⟩" :db/id #edb/ref 17592186563462} :answer-field/id #uuid "e10a875d-c5bb-5531-8b0a-fc52f08b4474" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113610}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "94647436-6c02-573c-afcc-f91bf56c72c9" :question/math-academy-id "q-32973" :question/problem "Find ${lim}_{t\\to 0}[3f(t)-g(t)]$ given that\n$f(t)$ and $g(t)$ are defined as:\n\n$$\n\\begin{aligned}f(t) & =⟨\\operatorname{cos}⁡t,{t}^{2}-2,\\frac{t-3}{{t}^{2}+1}⟩ \\\\ g(t) & =⟨\\operatorname{sin}⁡t,\\sqrt{t}+\\sqrt{2},2⟩\\end{aligned}\n$$" :question/worked-solution "First, we find the limit of each function:\n\n$$\n\\begin{aligned}{lim}_{t\\to 0}f(t) & =⟨{lim}_{t\\to 0}(\\operatorname{cos}⁡t),\\,{lim}_{t\\to 0}({t}^{2}-2),\\,{lim}_{t\\to 0}(\\frac{t-3}{{t}^{2}+1})⟩ \\\\  & =⟨\\operatorname{cos}⁡0,{0}^{2}-2,\\frac{0-3}{{0}^{2}+1}⟩ \\\\  & =⟨1,-2,-3⟩ \\\\ {lim}_{t\\to 0}g(t) & =⟨{lim}_{t\\to 0}(\\operatorname{sin}⁡t),\\,{lim}_{t\\to 0}(\\sqrt{t}+\\sqrt{2}),\\,{lim}_{t\\to 0}(2)⟩ \\\\  & =⟨\\operatorname{sin}⁡0,\\sqrt{0}+\\sqrt{2},2⟩ \\\\  & =⟨0,\\sqrt{2},2⟩\\end{aligned}\n$$\n\nNow, we use properties of limits to calculate the final result:\n\n$$\n\\begin{aligned}{lim}_{t\\to 0}[3f(t)-g(t)] & ={lim}_{t\\to 0}3f(t)-{lim}_{t\\to 0}g(t) \\\\  & =3{lim}_{t\\to 0}f(t)-{lim}_{t\\to 0}g(t) \\\\  & =3⟨1,-2,-3⟩-⟨0,\\sqrt{2},2⟩ \\\\  & =⟨3,-6,-9⟩-⟨0,\\sqrt{2},2⟩ \\\\  & =⟨3-0,-6-\\sqrt{2},-9-2⟩ \\\\  & =⟨3,-6-\\sqrt{2},-11⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186115791 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5689f169-0965-553d-bf8e-a087afa36fe6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20e^{-t/30}" :db/id #edb/ref 17592186501626}] :answer-field/correct {:answer/id #uuid "5689f169-0965-553d-bf8e-a087afa36fe6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20e^{-t/30}" :db/id #edb/ref 17592186501626} :answer-field/id #uuid "c7762cd8-8692-5ad4-968f-3c3e39a3e1f0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186113688}] :question/id #uuid "64193270-c02d-55f7-b1b5-b71007015ee2" :question/math-academy-id "q-335865" :question/problem "A tank initially holds $120\\,\\text{gal}$ of a brine (salt-water) solution containing $20\\,\\text{lb}$ of salt.\nFresh water is poured into the tank at a rate of $4\\,\\text{gal/min},$ while the completely mixed brine leaves the tank at a rate of $4\\,\\text{gal/min}.$\nFind an equation for the amount of salt $Q(t),$ in pounds, in the tank $t$ minutes after the fresh water is first added.\n\n$Q(t)=$\n{{field-1}}" :question/requires-calculator true :question/worked-solution "Since $Q$ is the amount of salt in the tank at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which salt enters the tank minus the rate at which salt leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{lb}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which salt enters the tank.\n\nFirst, note that fresh water (i.e., a brine solution containing $0\\,\\text{lb/gal}$ of salt) enters the tank at a rate of $4\\,\\text{gal/min}.$ So, the rate at which the *salt* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0\\,\\frac{\\text{lb}}{\\text{gal}})\\cdot (4\\,\\frac{\\text{gal}}{\\text{min}}) \\\\  & =(0\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}})\\cdot (4\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}}) \\\\  & =0\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which salt exits the tank.\n\nNote that the rate of flow in equals the rate of flow out, so the volume of water in the tank remains $120\\,\\text{gal}.$\nThen, since $Q$ is the amount of salt in the tank, the *concentration* of the brine at time $t$ is\n\n$$\n\\frac{Q}{120}\\,\\frac{\\text{lb}}{\\text{gal}}.\n$$\n\nTherefore, as the completely mixed brine leaves at a rate of $4\\,\\text{gal/min},$ *salt* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(4\\,\\frac{\\text{gal}}{\\text{min}})\\cdot (\\frac{Q}{120}\\,\\frac{\\text{lb}}{\\text{gal}}) \\\\  & =(4\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}})\\cdot (\\frac{Q}{120}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}}) \\\\  & =\\frac{4Q}{120}\\,\\frac{\\text{lb}}{\\text{min}} \\\\  & =\\frac{Q}{30}\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\ \\frac{dQ}{dt} & =0-\\frac{Q}{30} \\\\ \\frac{dQ}{dt} & =-\\frac{1}{30}\\,Q.\\end{aligned}\n$$\n\n**Step 4**: Integrate the equation.\n\nSeparating variables and integrating both sides with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{Q}\\cdot \\frac{dQ}{dt} & =-\\frac{1}{30} \\\\ \\int \\frac{1}{Q}\\cdot \\frac{dQ}{dt}dt & =\\int (-\\frac{1}{30})\\,dt \\\\ \\int \\frac{1}{Q}\\cdot \\,dQ & =-\\frac{1}{30}\\int \\,dt \\\\ \\operatorname{ln}⁡|Q| & =-\\frac{t}{30}+C \\\\ |Q| & ={e}^{-t/30+C} \\\\ Q(t) & =A{e}^{-t/30},\\end{aligned}\n$$\n\nwhere $A=\\pm {e}^{C}$ is a constant of integration.\n\nWe're told that the tank initially contains $20\\,\\text{lb}$ of salt. So, we can apply the initial condition $Q(0)=20,$ and solve for $A:$\n\n$$\n\\begin{aligned}Q(0) & =20 \\\\ A{e}^{-0/30} & =20 \\\\ A & =20\\end{aligned}\n$$\n\nFinally, we obtain the following expression for $Q(t):$\n\n$$\nQ(t)=20{e}^{-t/30}\n$$"} {:db/id #edb/ref 17592186115792 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a77f42f4-35f1-588f-b9f5-e7551327942c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.62kg" :db/id #edb/ref 17592186113690} {:answer/id #uuid "cbf733b2-f28b-5ae6-9940-1beff66d8f78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.21kg" :db/id #edb/ref 17592186113691} {:answer/id #uuid "fad460b6-90d5-5bf5-812f-333649961686" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.12kg" :db/id #edb/ref 17592186113692} {:answer/id #uuid "05e87ce2-e291-5c0e-84e3-1c8215c0e859" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.40kg" :db/id #edb/ref 17592186113693} {:answer/id #uuid "06548e47-f041-52bb-be97-aa1ac03af98c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.58kg" :db/id #edb/ref 17592186113694}] :answer-field/id #uuid "5bb11129-a05f-547b-9fcb-43b1ea592faf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113689} {:answer-field/choices [{:answer/id #uuid "f470831b-982b-5b1f-8c15-bcec6a3aecd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.40\\,\\text{kg}" :db/id #edb/ref 17592186374769} {:answer/id #uuid "9d841dbb-0112-562c-b4f3-4cecb29c7bff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.21\\,\\text{kg}" :db/id #edb/ref 17592186374770} {:answer/id #uuid "67a4a4cb-84c8-57fe-bc5e-b122c6d27bb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.12\\,\\text{kg}" :db/id #edb/ref 17592186374771} {:answer/id #uuid "ba2ad254-0816-5f5f-aec5-5121bc26c04d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.62\\,\\text{kg}" :db/id #edb/ref 17592186374772} {:answer/id #uuid "7fad770b-5c2d-5890-924e-7828f17f16ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.58\\,\\text{kg}" :db/id #edb/ref 17592186374773}] :answer-field/correct {:answer/id #uuid "f470831b-982b-5b1f-8c15-bcec6a3aecd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.40\\,\\text{kg}" :db/id #edb/ref 17592186374769} :answer-field/id #uuid "e53aad49-26f1-5495-98fc-9fc0447d0e5d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374768}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a890261f-fd08-52dd-bd73-34d6ecf2b91a" :question/math-academy-id "q-336401" :question/problem "A wastewater holding basin initially holds $450\\,\\text{L}$ of water containing $9\\,\\text{kg}$ of dissolved contaminants.\nClean water is pumped into the basin at a rate of $20\\,\\text{L/min},$ while the completely mixed liquid leaves the basin at a rate of $25\\,\\text{L/min}.$\nFind, rounded to two decimal places, the amount of contaminants in the basin $12$ minutes after the clean water pumping begins." :question/requires-calculator true :question/worked-solution "Let $Q$ be the amount of contaminants in the basin at time $t.$ Then, the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which contaminants enter the basin minus the rate at which contaminants leave the basin.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{kg}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which contaminants enter the basin.\n\nNote that clean water (i.e., water containing $0\\,\\text{kg/L}$ of contaminants) enters the basin at a rate of $20\\,\\text{L/min}.$ So, the rate at which the *contaminants* enter the basin is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0\\,\\frac{\\text{kg}}{\\text{L}})\\cdot (20\\,\\frac{\\text{L}}{\\text{min}}) \\\\  & =(0\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}})\\cdot (20\\,\\frac{\\cancel{\\text{L}}}{\\text{min}}) \\\\  & =0\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which contaminants exit the basin.\n\nTo find the rate at which contaminants leave the basin, we first determine the volume of wastewater in the basin at time $t.$\n\nThe basin initially contains $450\\,\\text{L}$ of wastewater; water enters at $20\\,\\text{L/min}$ and drains out at $25\\,\\text{L/min}.$\nAs a result, the amount of wastewater in the basin after $t$ minutes is \n\n$$\n450+20t-25t=(450-5t)\\,\\text{L}.\n$$\n\nSince $Q$ is the amount of contaminants in the basin, the *concentration* of the wastewater at time $t$ is\n\n$$\n\\frac{Q}{450-5t}\\,\\frac{\\text{kg}}{\\text{L}}.\n$$\n\nTherefore, as the completely mixed liquid leaves at a rate of $25\\,\\text{L/min},$ *contaminants* leave at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(25\\,\\frac{\\text{L}}{\\text{min}})\\cdot (\\frac{Q}{450-5t}\\,\\frac{\\text{kg}}{\\text{L}}) \\\\  & =(25\\,\\frac{\\cancel{\\text{L}}}{\\text{min}})\\cdot (\\frac{Q}{450-5t}\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}}) \\\\  & =\\frac{25Q}{450-5t}\\,\\frac{\\text{kg}}{\\text{min}} \\\\  & =\\frac{5Q}{90-t}\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =0-\\frac{5Q}{90-t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}=-\\frac{5}{90-t}\\,Q.\n$$\n\n**Step 4**: Integrate the equation.\n\nSeparating variables and integrating both sides with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{Q}\\cdot \\frac{dQ}{dt} & =-\\frac{5}{90-t} \\\\ \\int \\frac{1}{Q}\\cdot \\frac{dQ}{dt}dt & =\\int (-\\frac{5}{90-t})\\,dt \\\\ \\int \\frac{1}{Q}\\cdot \\,dQ & =-5\\int \\frac{1}{90-t}\\,dt \\\\ \\operatorname{ln}⁡|Q| & =-5(-\\operatorname{ln}⁡|90-t|)+C \\\\ \\operatorname{ln}⁡|Q| & =\\operatorname{ln}⁡|(90-t)^{5}|+C \\\\ |Q| & ={e}^{\\operatorname{ln}⁡|(90-t)^{5}|+C} \\\\ Q(t) & =A(90-t)^{5},\\end{aligned}\n$$\n\nwhere $A=\\pm {e}^{C}$ is a constant of integration.\n\nWe're told that the basin initially contains $9\\,\\text{kg}$ of contaminants. So, we can apply the initial condition $Q(0)=9,$ and solve for $A:$\n\n$$\n\\begin{aligned}Q(0) & =9 \\\\ A(90-0)^{5} & =9 \\\\ A & =\\frac{9}{{90}^{5}}\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =\\frac{9}{{90}^{5}}(90-t)^{5} \\\\  & =9{(\\frac{90-t}{90})}^{5} \\\\  & =9{(1-\\frac{t}{90})}^{5}\\end{aligned}\n$$\n\nFinally, the amount of contaminants in the basin $12$ minutes after the clean water is first pumped in is\n\n$$\nQ(12)=9{(1-\\frac{12}{90})}^{5}≈4.40\\,\\text{kg},\n$$\n\nrounded to two decimal places."} {:db/id #edb/ref 17592186115793 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c976b7a-3ff5-5927-ba0d-b085f9146139" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100\\,\\text{g}" :db/id #edb/ref 17592186374775} {:answer/id #uuid "fdd80501-68fe-5cf1-b205-347bb8c82c43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "85\\,\\text{g}" :db/id #edb/ref 17592186374776} {:answer/id #uuid "2e3ce3cd-cbeb-5761-acd5-4e01b6f728eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80\\,\\text{g}" :db/id #edb/ref 17592186374777} {:answer/id #uuid "ad0d45c5-18ff-5a0b-a685-60dfd26d7a00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90\\,\\text{g}" :db/id #edb/ref 17592186374778} {:answer/id #uuid "e0ba81d9-bfbb-5cf3-966f-9f628cc51d78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "82\\,\\text{g}" :db/id #edb/ref 17592186374779}] :answer-field/correct {:answer/id #uuid "2e3ce3cd-cbeb-5761-acd5-4e01b6f728eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80\\,\\text{g}" :db/id #edb/ref 17592186374777} :answer-field/id #uuid "25d457fb-82ff-5f69-8b22-551ddc28ab54" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374774}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3617a1e8-dceb-5727-a7bd-10880de46d8b" :question/math-academy-id "q-336422" :question/problem "A $9\\,000\\,\\text{mL}$-capacity tank initially holds $6\\,000\\,\\text{mL}$ of a brine (salt-water) solution containing $180\\,\\text{g}$ of salt. Fresh water begins to flow into the tank at a rate of $90\\,\\text{mL/s},$ while the completely mixed brine flows out at a rate of $60\\,\\text{mL/s}.$ Find the amount of salt in the tank at the moment it begins to overflow." :question/requires-calculator true :question/worked-solution "Let $Q$ be the amount of salt in the tank at time $t.$ Then, the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in seconds. This is equal to the rate at which salt enters the tank minus the rate at which salt leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{g}/\\text{s}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which salt enters the tank.\n\nFirst, note that fresh water (i.e., a brine solution containing $0\\,\\text{g/mL}$ of salt) enters the tank at a rate of $90\\,\\text{mL/s}.$ So, the rate at which the *salt* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0\\,\\frac{\\text{g}}{\\text{mL}})\\cdot (90\\,\\frac{\\text{mL}}{\\text{s}}) \\\\  & =(0\\,\\frac{\\text{g}}{\\cancel{\\text{mL}}})\\cdot (90\\,\\frac{\\cancel{\\text{mL}}}{\\text{s}}) \\\\  & =0\\,\\frac{\\text{g}}{\\text{s}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which salt exits the tank.\n\nTo find the rate at which salt leaves the tank, we must first determine the volume of brine in the tank at time $t.$\n\nThe tank initially contains $6\\,000\\,\\text{mL}$ of brine; fresh water enters at $90\\,\\text{mL/s},$ and mixed brine leaves at $60\\,\\text{mL/s}.$\nAs a result, the amount of brine in the tank after $t$ seconds is \n\n$$\nV(t)=6\\,000+90t-60t=30(200+t)\\,\\text{mL}.\n$$\n\nNote that $V(t)$ is an increasing function, so the tank is filling.\n\nSince $Q$ is the amount of salt in the tank, the concentration of the brine at time $t$ is\n\n$$\n\\frac{Q}{30(200+t)}\\,\\frac{\\text{g}}{\\text{mL}}.\n$$\n\nTherefore, as the completely mixed brine leaves at a rate of $60\\,\\text{mL/s},$ *salt* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(60\\,\\frac{\\text{mL}}{\\text{s}})\\cdot (\\frac{Q}{30(200+t)}\\,\\frac{\\text{g}}{\\text{mL}}) \\\\  & =(60\\,\\frac{\\cancel{\\text{mL}}}{\\text{s}})\\cdot (\\frac{Q}{30(200+t)}\\,\\frac{\\text{g}}{\\cancel{\\text{mL}}}) \\\\  & =\\frac{2Q}{200+t}\\,\\frac{\\text{g}}{\\text{s}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =0-\\frac{2Q}{200+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}=-\\frac{2}{200+t}\\,Q.\n$$\n\n**Step 4**: Integrate the equation\n\nSeparating variables and integrating both sides with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{Q}\\cdot \\frac{dQ}{dt} & =-\\frac{2}{200+t} \\\\ \\int \\frac{1}{Q}\\cdot \\frac{dQ}{dt}dt & =\\int (-\\frac{2}{200+t})\\,dt \\\\ \\int \\frac{1}{Q}\\cdot \\,dQ & =-2\\int \\frac{1}{200+t}\\,dt \\\\ \\operatorname{ln}⁡|Q| & =-2(\\operatorname{ln}⁡|200+t|)+C \\\\ \\operatorname{ln}⁡|Q| & =\\operatorname{ln}⁡|(200+t)^{-2}|+C \\\\ |Q| & ={e}^{\\operatorname{ln}⁡|(200+t)^{-2}|+C} \\\\ Q(t) & =\\frac{A}{(200+t)^{2}},\\end{aligned}\n$$\n\nwhere $A=\\pm {e}^{C}$ is a constant of integration.\n\nWe're told that the tank initially contains $180\\,\\text{g}$ of salt. So, we can apply the initial condition $Q(0)=180,$ and solve for $A:$\n\n$$\n\\begin{aligned}Q(0) & =180 \\\\ \\frac{A}{(200+0)^{2}} & =180 \\\\ A & =180(200)^{2}\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =\\frac{180(200)^{2}}{(200+t)^{2}} \\\\  & =180{(\\frac{200}{200+t})}^{2}\\end{aligned}\n$$\n\nNow, let ${t}_{o}$ be the time when the tank begins to overflow. The tank has a capacity of $9\\,000\\,\\text{mL},$ so we can use the condition $V({t}_{o})=9\\,000$ to solve for ${t}_{o}:$\n\n$$\n\\begin{aligned}V({t}_{o}) & =9\\,000 \\\\ 30(200+{t}_{o}) & =9\\,000 \\\\ 200+{t}_{o} & =300 \\\\ {t}_{o} & =100\\,\\text{s}\\end{aligned}\n$$\n\nFinally, the amount of salt in the tank at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(100) & =180{(\\frac{200}{200+100})}^{2} \\\\  & =180{(\\frac{2}{3})}^{2} \\\\  & =80\\,\\text{g}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186115796 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1625cbd3-6d04-52bf-ad57-d5116e771c6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "102\\,\\text{g}" :db/id #edb/ref 17592186546299} {:answer/id #uuid "6eccbf39-7b81-5f1c-9b9b-de95bddd15ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100\\,\\text{g}" :db/id #edb/ref 17592186546496} {:answer/id #uuid "81039cc6-be6e-5a3d-9d5d-380bf1e7265b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "105\\,\\text{g}" :db/id #edb/ref 17592186546539} {:answer/id #uuid "86f58fcb-92e0-5aca-9ded-ec1b4b86eec8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120\\,\\text{g}" :db/id #edb/ref 17592186546549} {:answer/id #uuid "ce095df2-3455-538e-9ce0-230be6f286f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "110\\,\\text{g}" :db/id #edb/ref 17592186546709}] :answer-field/correct {:answer/id #uuid "6eccbf39-7b81-5f1c-9b9b-de95bddd15ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100\\,\\text{g}" :db/id #edb/ref 17592186546496} :answer-field/id #uuid "3080d7ca-9550-5b7f-954e-2889ba64ecc6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113713}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a53b4e44-7f34-5742-ba72-ac1886cc69b9" :question/math-academy-id "q-336687" :question/problem "A $9\\,800\\,\\text{mL}$-capacity tank initially holds $7\\,000\\,\\text{mL}$ of a brine (salt-water) solution containing $196\\,\\text{g}$ of salt. Fresh water begins to flow into the tank at a rate of $105\\,\\text{mL/s},$ while the completely mixed brine flows out at a rate of $70\\,\\text{mL/s}.$ Find the amount of salt in the tank at the moment it begins to overflow." :question/requires-calculator true :question/worked-solution "Let $Q$ be the amount of salt in the tank at time $t.$ Then, the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in seconds. This is equal to the rate at which salt enters the tank minus the rate at which salt leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{g}/\\text{s}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which salt enters the tank.\n\nFirst, note that fresh water (i.e., a brine solution containing $0\\,\\text{g/mL}$ of salt) enters the tank at a rate of $105\\,\\text{mL/s}.$ So, the rate at which the *salt* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0\\,\\frac{\\text{g}}{\\text{mL}})\\cdot (105\\,\\frac{\\text{mL}}{\\text{s}}) \\\\  & =(0\\,\\frac{\\text{g}}{\\cancel{\\text{mL}}})\\cdot (105\\,\\frac{\\cancel{\\text{mL}}}{\\text{s}}) \\\\  & =0\\,\\frac{\\text{g}}{\\text{s}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which salt exits the tank.\n\nTo find the rate at which salt leaves the tank, we must first determine the volume of brine in the tank at time $t.$\n\nThe tank initially contains $7\\,000\\,\\text{mL}$ of brine; fresh water enters at $105\\,\\text{mL/s},$ and mixed brine leaves at $70\\,\\text{mL/s}.$\nAs a result, the amount of brine in the tank after $t$ seconds is \n\n$$\nV(t)=7\\,000+105t-70t=35(200+t)\\,\\text{mL}.\n$$\n\nNote that $V(t)$ is an increasing function, so the tank is filling.\n\nSince $Q$ is the amount of salt in the tank, the concentration of the brine at time $t$ is\n\n$$\n\\frac{Q}{35(200+t)}\\,\\frac{\\text{g}}{\\text{mL}}.\n$$\n\nTherefore, as the completely mixed brine leaves at a rate of $70\\,\\text{mL/s},$ *salt* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(70\\,\\frac{\\text{mL}}{\\text{s}})\\cdot (\\frac{Q}{35(200+t)}\\,\\frac{\\text{g}}{\\text{mL}}) \\\\  & =(70\\,\\frac{\\cancel{\\text{mL}}}{\\text{s}})\\cdot (\\frac{Q}{35(200+t)}\\,\\frac{\\text{g}}{\\cancel{\\text{mL}}}) \\\\  & =\\frac{2Q}{200+t}\\,\\frac{\\text{g}}{\\text{s}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =0-\\frac{2Q}{200+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}=-\\frac{2}{200+t}\\,Q.\n$$\n\n**Step 4**: Integrate the equation\n\nSeparating variables and integrating both sides with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{Q}\\cdot \\frac{dQ}{dt} & =-\\frac{2}{200+t} \\\\ \\int \\frac{1}{Q}\\cdot \\frac{dQ}{dt}dt & =\\int (-\\frac{2}{200+t})\\,dt \\\\ \\int \\frac{1}{Q}\\cdot \\,dQ & =-2\\int \\frac{1}{200+t}\\,dt \\\\ \\operatorname{ln}⁡|Q| & =-2(\\operatorname{ln}⁡|200+t|)+C \\\\ \\operatorname{ln}⁡|Q| & =\\operatorname{ln}⁡|(200+t)^{-2}|+C \\\\ |Q| & ={e}^{\\operatorname{ln}⁡|(200+t)^{-2}|+C} \\\\ Q(t) & =\\frac{A}{(200+t)^{2}},\\end{aligned}\n$$\n\nwhere $A=\\pm {e}^{C}$ is a constant of integration.\n\nWe're told that the tank initially contains $196\\,\\text{g}$ of salt. So, we can apply the initial condition $Q(0)=196,$ and solve for $A:$\n\n$$\n\\begin{aligned}Q(0) & =196 \\\\ \\frac{A}{(200+0)^{2}} & =196 \\\\ A & =196(200)^{2}\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =\\frac{196(200)^{2}}{(200+t)^{2}} \\\\  & =196{(\\frac{200}{200+t})}^{2}\\end{aligned}\n$$\n\nNow, let ${t}_{o}$ be the time when the tank begins to overflow. The tank has a capacity of $9\\,800\\,\\text{mL},$ so we can use the condition $V({t}_{o})=9\\,800$ to solve for ${t}_{o}:$\n\n$$\n\\begin{aligned}V({t}_{o}) & =9\\,800 \\\\ 35(200+{t}_{o}) & =9\\,800 \\\\ 200+{t}_{o} & =280 \\\\ {t}_{o} & =80\\,\\text{s}\\end{aligned}\n$$\n\nFinally, the amount of salt in the tank at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(80) & =196{(\\frac{200}{200+80})}^{2} \\\\  & =196{(\\frac{5}{7})}^{2} \\\\  & =100\\,\\text{g}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186115822 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "859e1f99-78f7-5944-8764-79ce7f2d5738" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186113870} {:answer/id #uuid "adc87d53-5bad-5617-8980-d4c48bc731bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186113871} {:answer/id #uuid "babbbea6-d7a6-51d8-b830-b3f3ad33b93d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186113872} {:answer/id #uuid "f93ed2ca-c815-53d4-8cf2-9cdb3e19a1fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186113873} {:answer/id #uuid "71524385-d65d-52cc-8095-f4