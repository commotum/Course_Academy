a9f6-1d0acb3e6aa1" :question/math-academy-id "q-27528" :question/problem "Which of the following is the graph of $y=2{(\\frac{1}{8})}^{x}?$" :question/worked-solution "First we plot the graph of $y={(\\frac{1}{8})}^{x}:$\n\n![](images/b2/b23108c36c016f3022dd3650bbd8bb70ebea27c19f8b8f62d439a4eebe7187f4.png)\n\nThen, we scale this graph by a factor of $2.$ The $y$-intercept becomes $(0,2),$ and the resulting graph is as follows:\n\n![](images/3d/3dcd10cdeec52258b04705865196a1d59269c298b3821b87f7b0afe7727f740b.png)"} {:db/id #edb/ref 17592186111139 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0a25c49-9707-562c-b3d1-5a1570a5361c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/37/372f7cdfd12886dcb962561e5805d6f348e2d11edb73cdc4ab10340160c84bb1.png" :db/id #edb/ref 17592186108570} {:answer/id #uuid "b34ec57c-0e96-5a7b-a976-395d99cf9811" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b2/b21cc5ca928799e137b7dff2a0a0db61532e74a4d9536191a128a52e0da0795d.png" :db/id #edb/ref 17592186108571} {:answer/id #uuid "b90fa8a4-e5cf-5165-8ead-fe12622837d2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8e/8e572351c551f5db6f3012bb852958bd8950093244a0e48784eb240b2abac7eb.png" :db/id #edb/ref 17592186108572} {:answer/id #uuid "cf26ee6d-8845-58ff-af9e-122df218bb63" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a3/a356cb614ef4c0b4994eb8f7b6a9532ee2ef5f2bf613106e1f3f4046ac404cc0.png" :db/id #edb/ref 17592186108573} {:answer/id #uuid "dcb79614-ef31-5c74-b673-2f53530829e9" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f4/f4fe502529fcbf62d51aa79541f3f3db8ce9996d9f270f6ff4932ec35053afcf.png" :db/id #edb/ref 17592186108574}] :answer-field/id #uuid "c1cbc3dc-072e-546b-b3dd-aa2e32d6b45e" :answer-field/key "selection" :answer-fie