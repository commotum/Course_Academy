b-7fde37ec2d54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{18{s}^{2}+432}{({s}^{2}-36)^{3}}" :db/id #edb/ref 17592186312458} {:answer/id #uuid "7d7ff30e-73bc-53f8-9f06-c6a6d42689ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{36{s}^{2}+432}{({s}^{2}-36)^{3}}" :db/id #edb/ref 17592186312980}] :answer-field/correct {:answer/id #uuid "7d7ff30e-73bc-53f8-9f06-c6a6d42689ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{36{s}^{2}+432}{({s}^{2}-36)^{3}}" :db/id #edb/ref 17592186312980} :answer-field/id #uuid "d6b6f1c6-19d8-551a-bf01-42f858a85635" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314603} {:answer-field/choices [{:answer/id #uuid "2c9ffc09-ab81-5da6-a831-835f57a9321d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{36{s}^{3}+432s}{({s}^{2}-36)^{3}}" :db/id #edb/ref 17592186312322} {:answer/id #uuid "413bcbae-a85a-5eaa-8705-d343e2f5da61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{36{s}^{2}+432}{({s}^{2}-36)^{3}}" :db/id #edb/ref 17592186312497} {:answer/id #uuid "a7b52b73-617e-5326-99e5-1f5494896711" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{36{s}^{3}+432s}{({s}^{2}-36)^{3}}" :db/id #edb/ref 17592186313289} {:answer/id #uuid "e9d17872-cb3c-50ee-97ae-094410cbb6f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{36{s}^{2}+432}{({s}^{2}-36)^{3}}" :db/id #edb/ref 17592186313835}] :answer-field/correct {:answer/id #uuid "e9d17872-cb3c-50ee-97ae-094410cbb6f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{36{s}^{2}+432}{({s}^{2}-36)^{3}}" :db/id #edb/ref 17592186313835} :answer-field/id #uuid "df80eaf6-429b-51e3-83e6-8d4d13a00fd1" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314628}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "458ca544-ac0f-54e4-b380-7e20f0b953dd" :question/math-academy-id "q-341222" :question/problem "Suppose we wish to calculate the Laplace transform \n\n$$\nL{{t}^{2}\\operatorname{sinh}⁡(-6t)}.\n$$\n\nSelect the correct options in the reasoning below. You may make use of the following results:\n\n$$\nL{\\operatorname{sinh}⁡\\omega t}=\\frac{\\omega }{{s}^{2}-{\\omega }^{2}},\\,s>\\omega .\n$$\n\nLet $f(t)=\\operatorname{sinh}⁡(-6t)$ and $F(s)=L{f(t)}.$ By the smoothness property of Laplace transforms, we have\n\n$$\nL{{t}^{2}f(t)}={{field-1}}.\n$$\n\nUsing $\\operatorname{sinh}⁡(-6t)=-\\operatorname{sinh}⁡6t,$ the Laplace transform of $f(t)$ is\n\n$$\nF(s)=L{f(t)}={{field-2}},\\,s>6.\n$$\n\nWe have that\n\n$$\n{F}^{″}(s)={{field-3}}.\n$$\n\nTherefore,\n\n$$\nL{{t}^{2}\\operatorname{sinh}⁡(-6t)}={{field-4}},\\,s>6.\n$$" :question/worked-solution "If a function $f(t)$ is piecewise continuous on $[0,\\infty )$ and has exponential order $a,$ then its Laplace transform\n\n$$\nF(s)=L{f(t)}\n$$\n\nexists for every real $s>a,$ and $F$ is infinitely differentiable in this region of convergence. Moreover, for each integer $n\\ge 0$ and every such $s,$ we have\n\n$$\nL{{t}^{n}f(t)}=(-1)^{n}{F}^{(n)}(s).\n$$\n\nIn particular, for $n=2,$ we have\n\n$$\nL{{t}^{2}f(t)}={F}^{″}(s).\n$$\n\nWe have that\n\n$$\nf(t)=\\operatorname{sinh}⁡(-6t)=-\\operatorname{sinh}⁡6t.\n$$\n\nUsing the given result with $\\omega =6,$ the Laplace transform of $\\operatorname{sinh}⁡6t$ is $\\frac{6}{{s}^{2}-36},$ so\n\n$$\nF(s)=-\\frac{6}{{s}^{2}-36},\\,s>6.\n$$\n\nDifferentiating with respect to $s,$ we have\n\n$$\n\\begin{aligned}{F}^{′}(s) & =\\frac{\\text{d}}{\\text{d}s}(-\\frac{6}{{s}^{2}-36}) \\\\  & =-\\frac{\\text{d}}{\\text{d}s}(6({s}^{2}-36)^{-1}) \\\\  & =-(-6({s}^{2}-36)^{-2}\\cdot 2s) \\\\  & =\\frac{12s}{({s}^{2}-36)^{2}} \\\\ {F}^{″}(s) & =\\frac{\\text{d}}{\\text{d}s}(\\frac{12s}{({s}^{2}-36)^{2}}) \\\\  & =12\\cdot \\frac{\\text{d}}{\\text{d}s}(\\frac{s}{({s}^{2}-36)^{2}}) \\\\  & =12\\cdot (\\frac{(s)^{′}\\cdot ({s}^{2}-36)^{2}-s\\cdot {(({s}^{2}-36)^{2})}^{′}}{({s}^{2}-36)^{4}}) \\\\  & =12\\cdot (\\frac{({s}^{2}-36)^{2}-s\\cdot 2({s}^{2}-36)\\cdot 2s}{({s}^{2}-36)^{4}}) \\\\  & =12\\cdot (\\frac{({s}^{2}-36)^{2}-4{s}^{2}({s}^{2}-36)}{({s}^{2}-36)^{4}}) \\\\  & =12\\cdot (\\frac{{s}^{2}-36-4{s}^{2}}{({s}^{2}-36)^{3}}) \\\\  & =12\\cdot (\\frac{-3{s}^{2}-36}{({s}^{2}-36)^{3}}) \\\\  & =-\\frac{36{s}^{2}+432}{({s}^{2}-36)^{3}}.\\end{aligned}\n$$\n\nNote that we used the quotient rule to find ${F}^{″}(s).$\n\nTherefore, by the smoothness property,\n\n$$\n\\begin{aligned}L{{t}^{2}\\operatorname{sinh}⁡(-6t)}={F}^{″}(s)=-\\frac{36{s}^{2}+432}{({s}^{2}-36)^{3}},\\,s>6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186315068 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7fa4792b-5b15-527a-992e-0d96170ab1aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450530} {:answer/id #uuid "f9461d03-b412-574d-9841-bce08dceb69a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450531}] :answer-field/correct {:answer/id #uuid "f9461d03-b412-574d-9841-bce08dceb69a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450531} :answer-field/id #uuid "7a1e573c-09ca-594f-a9ba-3b2660311b38" :answer-field/key "$f(x+\\frac{\\pi }{2})=f(x)$ for all $x\\in R$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451219} {:answer-field/choices [{:answer/id #uuid "d83cac8f-f51f-527a-b720-44ad32045870" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450532} {:answer/id #uuid "333f0aac-7943-517c-87c6-fb5685a1c0fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450533}] :answer-field/correct {:answer/id #uuid "d83cac8f-f51f-527a-b720-44ad32045870" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450532} :answer-field/id #uuid "611505c9-97d8-564c-8e0d-e557fa6b701e" :answer-field/key "$f(x)=F(x)$ for all $x\\in R$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451220} {:answer-field/choices [{:answer/id #uuid "01e9805a-d060-5fce-8210-0537d29aaf51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450534} {:answer/id #uuid "7605eb1c-ab43-5593-8185-dd779575eaf5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450535}] :answer-field/correct {:answer/id #uuid "7605eb1c-ab43-5593-8185-dd779575eaf5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450535} :answer-field/id #uuid "d1ba82cd-be54-5931-a8f3-844d7c5db9bc" :answer-field/key "$f(x+\\frac{\\pi }{2})=f(x-\\frac{\\pi }{2})$ for all $x\\in R$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451221}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ea143c38-1de5-5608-b272-c1150223e597" :question/math-academy-id "q-341232" :question/problem "Let $F(x)=\\operatorname{sin}⁡(2x)$ for $x\\in R.$ Suppose $f(x)$ is the $\\frac{\\pi }{2}$-periodic extension of $F(x)$ from $x\\in [0,\\frac{\\pi }{2})$ to $x\\in R.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Since $f$ is the $\\pi /2$-periodic extension of $F,$ we have  \n\n- $f(x+\\frac{\\pi }{2})=f(x)$ for all $x\\in R,$ and\n\n- $f(x)=F(x)$ for all $x\\in [0,\\frac{\\pi }{2}).$\n\nWith that in mind, we examine each statement in turn.\n\n- Statement “$f(x+\\frac{\\pi }{2})=f(x)$ for all $x\\in R$” is true. This is exactly the definition of $\\frac{\\pi }{2}$-periodicity:\n\n$$\nf(x+\\frac{\\pi }{2})=f(x)\n$$\n\nfor all $x\\in R.$\n\n- Statement “$f(x)=F(x)$ for all $x\\in R$” is false. For example, take $x=\\frac{3\\pi }{4}.$ Using the periodicity of $f(x):$\n\n$$\n\\begin{aligned}f(\\frac{3\\pi }{4})=f(\\frac{\\pi }{4}+\\frac{\\pi }{2})=f(\\frac{\\pi }{4})=F(\\frac{\\pi }{4})=\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4})=1,\\end{aligned}\n$$\n\nwhile\n\n$$\n\\begin{aligned}F(\\frac{3\\pi }{4})=\\operatorname{sin}⁡(2\\cdot \\frac{3\\pi }{4})=\\operatorname{sin}⁡(\\frac{3\\pi }{2})=-1.\\end{aligned}\n$$\n\nHence, $f(x)\\ne F(x)$ for $x=\\frac{3\\pi }{4}.$\n\n- Statement “$f(x+\\frac{\\pi }{2})=f(x-\\frac{\\pi }{2})$ for all $x\\in R$” is true. Since $f$ is $\\frac{\\pi }{2}$-periodic, any shift by a multiple of its period returns the same value:\n\n$$\n\\begin{aligned}f(x+\\frac{\\pi }{2})=f(x)\\,\\text{and}\\,f(x-\\frac{\\pi }{2})=f((x-\\frac{\\pi }{2})+\\frac{\\pi }{2})=f(x).\\end{aligned}\n$$\n\nSince both sides equal $f(x),$ the statement is true for all $x\\in R.$\n\nTherefore, the correct answer is “$f(x+\\frac{\\pi }{2})=f(x)$ for all $x\\in R$”; “$f(x+\\frac{\\pi }{2})=f(x-\\frac{\\pi }{2})$ for all $x\\in R$” only."} {:db/id #edb/ref 17592186315069 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e69687f-8c03-5c9a-8e81-2feebdb84cc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450536} {:answer/id #uuid "c4734c66-b830-5012-9fb4-cfa4985ad9fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450537}] :answer-field/correct {:answer/id #uuid "c4734c66-b830-5012-9fb4-cfa4985ad9fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450537} :answer-field/id #uuid "476d4817-0c5c-5c10-bc1d-2482d72d4c55" :answer-field/key "$f(x+4\\pi )=f(x)$ for all $x\\in R$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451222} {:answer-field/choices [{:answer/id #uuid "2d93f9e6-a8cb-54ef-ba01-0f9b1655833f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450538} {:answer/id #uuid "556f5d27-0aa0-5d57-a7b0-29269a93cd55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450539}] :answer-field/correct {:answer/id #uuid "2d93f9e6-a8cb-54ef-ba01-0f9b1655833f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450538} :answer-field/id #uuid "955c3f26-0647-5690-bdcf-926edd101436" :answer-field/key "$f(x)=F(x)$ for all $x\\in R$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451223} {:answer-field/choices [{:answer/id #uuid "ea24cc05-96b2-58c0-adce-93dd4750e88e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450540} {:answer/id #uuid "7a41e6fe-ab8d-5f68-b3fc-c4be05e1b48e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450541}] :answer-field/correct {:answer/id #uuid "7a41e6fe-ab8d-5f68-b3fc-c4be05e1b48e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450541} :answer-field/id #uuid "92cf34f6-8dc7-5f8c-a110-8a694be94a2f" :answer-field/key "$f(x+2\\pi )=f(x)$ for all $x\\in R$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451224}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "47637532-5815-59ac-9760-d5eb87953b75" :question/math-academy-id "q-341237" :question/problem "Let $F(x)=cos\\,(\\frac{x}{2})$ for $x\\in R.$ Suppose $f(x)$ is the $2\\pi $-periodic extension of $F(x)$ from $x\\in [0,2\\pi )$ to $x\\in R.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Since $f$ is the $2\\pi $-periodic extension of $F,$ we have  \n\n- $f(x+2\\pi )=f(x)$ for all $x\\in R,$ and\n\n- $f(x)=F(x)$ for all $x\\in [0,2\\pi ).$\n\nWith that in mind, we examine each statement in turn.\n\n- Statement “$f(x+4\\pi )=f(x)$ for all $x\\in R$” is true. We have\n\n$$\nf(x+4\\pi )=f((x+2\\pi )+2\\pi )=f(x+2\\pi )=f(x)\n$$\n\nfor all $x\\in R.$\n\n- Statement “$f(x)=F(x)$ for all $x\\in R$” is false. For example, take $x=2\\pi .$ Then,\n\n$$\n\\begin{aligned}f(2\\pi ) & =f(0+2\\pi )=f(0)=F(0)=\\operatorname{cos}⁡(0)=1,\\end{aligned}\n$$\n\nwhile\n\n$$\nF(2\\pi )=\\operatorname{cos}⁡(\\pi )=-1.\n$$\n\nHence, $f(x)\\ne F(x)$ for $x=2\\pi .$\n\n- Statement “$f(x+2\\pi )=f(x)$ for all $x\\in R$” is true. This is exactly the definition of $2\\pi $-periodicity: \n\n$$\nf(x+2\\pi )=f(x)\n$$\n\nfor all $x\\in R.$\n\nTherefore, the correct answer is “$f(x+4\\pi )=f(x)$ for all $x\\in R$”; “$f(x+2\\pi )=f(x)$ for all $x\\in R$” only."} {:db/id #edb/ref 17592186315080 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27402392-ef7b-543e-a95c-51569128931d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{\\pi }(\\sqrt{2}-2)" :db/id #edb/ref 17592186312273} {:answer/id #uuid "b2388473-f7b4-5371-bdaf-2f5d22ad6092" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4(\\sqrt{2}-2)}{\\pi}" :db/id #edb/ref 17592186513999}] :answer-field/correct {:answer/id #uuid "b2388473-f7b4-5371-bdaf-2f5d22ad6092" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4(\\sqrt{2}-2)}{\\pi}" :db/id #edb/ref 17592186513999} :answer-field/id #uuid "f63f2945-3857-5e6d-882c-11e5148b361f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314680}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "86b3942b-d5fe-58b1-8280-9f2a9124377a" :question/math-academy-id "q-341283" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=-\\operatorname{sin}⁡(\\frac{x}{4})$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" :question/worked-solution "For our Fourier cosine series, the constant term is given by\n\n$$\n{a}_{0}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-\\operatorname{sin}⁡(\\frac{x}{4})$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }-\\operatorname{sin}⁡(\\frac{x}{4})\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{[4\\operatorname{cos}⁡(\\frac{x}{4})]}_{0}^{\\pi } \\\\  & =\\frac{2}{\\pi }(4\\operatorname{cos}⁡(\\frac{\\pi }{4})-4\\operatorname{cos}⁡(0)) \\\\  & =\\frac{2}{\\pi }(4\\cdot \\frac{\\sqrt{2}}{2}-4) \\\\  & =\\frac{4}{\\pi }(\\sqrt{2}-2).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186315081 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70a30cec-1c74-58b6-a352-b55dbaad5ff0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6(\\sqrt{3}-2)}{\\pi }" :db/id #edb/ref 17592186312860} {:answer/id #uuid "6291bc20-b33b-51a2-81f3-8c4774fb834c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6(\\sqrt{3}-2)}{\\pi}" :db/id #edb/ref 17592186420177}] :answer-field/correct {:answer/id #uuid "6291bc20-b33b-51a2-81f3-8c4774fb834c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6(\\sqrt{3}-2)}{\\pi}" :db/id #edb/ref 17592186420177} :answer-field/id #uuid "850f065e-3ad8-58f4-8d41-45b829bfc32b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314364}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a1a98a94-1685-5290-8055-415073e9036d" :question/math-academy-id "q-341285" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=-\\operatorname{sin}⁡(\\frac{x}{6})$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" :question/worked-solution "For our Fourier cosine series, the constant term is given by\n\n$$\n{a}_{0}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-\\operatorname{sin}⁡(\\frac{x}{6})$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }-\\operatorname{sin}⁡(\\frac{x}{6})\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{[6\\operatorname{cos}⁡(\\frac{x}{6})]}_{0}^{\\pi } \\\\  & =\\frac{2}{\\pi }(6\\operatorname{cos}⁡(\\frac{\\pi }{6})-6\\operatorname{cos}⁡(0)) \\\\  & =\\frac{2}{\\pi }(6\\cdot \\frac{\\sqrt{3}}{2}-6) \\\\  & =\\frac{6(\\sqrt{3}-2)}{\\pi }.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186315090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "abb73e80-e963-5c19-b293-cd17110e5f3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-3s}}{s}" :db/id #edb/ref 17592186313321}] :answer-field/correct {:answer/id #uuid "abb73e80-e963-5c19-b293-cd17110e5f3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-3s}}{s}" :db/id #edb/ref 17592186313321} :answer-field/id #uuid "22a45e29-d2af-5275-a0b0-c40eb9d5a6e3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314099} {:answer-field/choices [{:answer/id #uuid "849d38a3-ffa8-596e-8341-2c43de043d90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186313039}] :answer-field/correct {:answer/id #uuid "849d38a3-ffa8-596e-8341-2c43de043d90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186313039} :answer-field/id #uuid "7e45259c-a45d-5e7c-b47d-2c04e878ab64" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314344} {:answer-field/choices [{:answer/id #uuid "5ac97744-f5cd-5f41-a0de-cb29bbe9817d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186312697}] :answer-field/correct {:answer/id #uuid "5ac97744-f5cd-5f41-a0de-cb29bbe9817d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186312697} :answer-field/id #uuid "b9d647e4-d66d-54c7-aca9-90ce3e255ed4" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314518}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9db19fd8-5680-5d48-9d86-5812bc3bb368" :question/math-academy-id "q-341390" :question/problem "Use the definition of Laplace transforms to calculate $F(s)=L{f(t)},$ where $f(t)=u(t-3)$ and $u$ is the unit step function.\n\n$F(s)=L{f(t)}=$\n{{field-1}},\nvalid for $s\\,$\n{{field-2}}{{field-3}}." :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nRecall that the unit step function is defined as\n\n$$\n\\begin{aligned}u(t)={\\begin{aligned}0,\\, & t<0 \\\\ 1,\\, & t\\ge 0.\\end{aligned}\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\n\\begin{aligned}u(t-3)={\\begin{aligned}0,\\, & t<3 \\\\ 1,\\, & t\\ge 3\\end{aligned}\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }u(t-3){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}0\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{3}^{\\infty }1\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{3}^{\\infty }{e}^{-st}\\,\\text{d}t.\\end{aligned}\n$$\n\nNote that this improper integral diverges if $s\\le 0.$\n\nFor $s>0,$ we calculate this integral as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{3}^{\\infty }{e}^{-st}\\,\\text{d}t \\\\  & ={lim}_{a\\to \\infty }{\\int }_{3}^{a}{e}^{-st}\\,\\text{d}t \\\\  & ={lim}_{a\\to \\infty }{(-\\frac{{e}^{-st}}{s})|}_{3}^{a} \\\\  & =-\\frac{1}{s}\\cdot {lim}_{a\\to \\infty }({e}^{-sa}-{e}^{-3s}) \\\\  & =-\\frac{1}{s}(0-{e}^{-3s}) \\\\  & =\\frac{{e}^{-3s}}{s}\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $f(t)$ is\n\n$$\nL{f(t)}=\\frac{{e}^{-3s}}{s},\\,s>0.\n$$"} {:db/id #edb/ref 17592186315100 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3af1f70d-33f0-5cfc-b5f6-a92c6f53e642" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>3" :db/id #edb/ref 17592186312452} {:answer/id #uuid "5fe96b2b-df0f-5b5f-8c09-6b1116