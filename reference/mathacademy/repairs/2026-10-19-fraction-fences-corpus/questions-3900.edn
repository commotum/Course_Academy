db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{n\\pi x}{3})" :db/id #edb/ref 17592186315351} :answer-field/id #uuid "c3026fce-a564-560d-a98f-f8c84ca4478f" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186317009} {:answer-field/choices [{:answer/id #uuid "61b4c586-dd65-581f-b72e-da973be223dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "piecewise linear" :db/id #edb/ref 17592186315664} {:answer/id #uuid "b4a765d5-f9bc-5b61-b6b0-ddc6438dc48c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "piecewise smooth" :db/id #edb/ref 17592186316140} {:answer/id #uuid "d8db2b4d-be1a-577e-9d71-586b8b3ff301" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "periodic" :db/id #edb/ref 17592186316326}] :answer-field/correct {:answer/id #uuid "b4a765d5-f9bc-5b61-b6b0-ddc6438dc48c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "piecewise smooth" :db/id #edb/ref 17592186316140} :answer-field/id #uuid "c367b66d-d706-58a4-8744-c9027f239869" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186317011} {:answer-field/choices [{:answer/id #uuid "779b25e7-e9f1-5970-81e6-c2457d778bb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{n\\pi x}{3})" :db/id #edb/ref 17592186315791} {:answer/id #uuid "bb973c70-a9f5-5ed1-9595-2ee7f36dd4eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{n\\pi x}{6})" :db/id #edb/ref 17592186316179} {:answer/id #uuid "dfc1e478-54e9-577d-b817-e82797475d03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{n\\pi x}{6})" :db/id #edb/ref 17592186316357} {:answer/id #uuid "ea83f06e-8df8-5e52-bb5b-19418d0ece66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{n\\pi x}{3})" :db/id #edb/ref 17592186316422}] :answer-field/correct {:answer/id #uuid "ea83f06e-8df8-5e52-bb5b-19418d0ece66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{n\\pi x}{3})" :db/id #edb/ref 17592186316422} :answer-field/id #uuid "d1a1345d-5208-544e-96f2-59511c4c5a07" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186317040}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ce2d6842-c273-5f28-8b8b-7bdf00107d27" :question/math-academy-id "q-343245" :question/problem "Let $f(x)$ be the $6$-periodic extension of the function $F(x)=-7{x}^{2}+4$ defined on $[-3,3).$ Select the correct options in the reasoning below, showing the derivation of the Fourier series of the $6$-periodic extension of $G(x)=-14x$ from the corresponding Fourier series of $f(x).$\n\nThe Fourier series of $f(x)$ is given by\n\n$$\n-7{x}^{2}+4∼-17+{\\sum }_{n=1}^{\\infty }\\frac{252(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}{{field-1}}.\n$$\n\nSince $f$ is \n{{field-2}}\nand\n{{field-3}}\non $R,$ we may differentiate its Fourier series term-by-term to get\n\n$$\n-14x∼{\\sum }_{n=1}^{\\infty }{{field-4}}\\cdot {{field-5}}.\n$$" :question/worked-solution "First, notice that $F(x)$ is an even function. So, the Fourier series of its $2L$-periodic extension has the form\n\n$$\n\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{L}).\n$$\n\nIn our case, $L=3$ and we are already given the coefficients ${a}_{0}$ and ${a}_{n}$ for $n\\ge 1.$ Thus, the Fourier series of $f(x)$ is given by\n\n$$\nf(x)∼-17+{\\sum }_{n=1}^{\\infty }\\frac{252(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}\\operatorname{cos}⁡(\\frac{n\\pi x}{3}).\n$$\n\nNow, notice that \n\n- the function $F$ is continuously differentiable on $(-3,3),$\n\n- continuous on $[-3,3),$ and\n\n- satisfies $F(-3)=F(3),$ if we extend the value at $x=3$ using the formula $F(x)=-7{x}^{2}+4.$\n\nTherefore, the $6$-periodic extension $f$ is $\\text{continuous}$ and $\\text{piecewise smooth}$ on $R,$ so we may differentiate its Fourier series term-by-term:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(-7{x}^{2}+4) & ∼\\frac{\\text{d}}{\\text{d}x}(-17)+{\\sum }_{n=1}^{\\infty }\\frac{\\text{d}}{\\text{d}x}(\\frac{252(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}\\operatorname{cos}⁡(\\frac{n\\pi x}{3})) \\\\ -14x & ∼0+{\\sum }_{n=1}^{\\infty }\\frac{252(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}\\cdot (-\\frac{n\\pi }{3}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})) \\\\ -14x & ∼{\\sum }_{n=1}^{\\infty }\\frac{-84(-1)^{n+1}}{n\\pi }\\operatorname{sin}⁡(\\frac{n\\pi x}{3}) \\\\ -14x & ∼{\\sum }_{n=1}^{\\infty }\\,\\frac{84(-1)^{n}}{n\\pi }\\cdot \\operatorname{sin}⁡(\\frac{n\\pi x}{3})\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317373 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0933967e-8a36-5c98-9978-af481d6e1c97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "odd" :db/id #edb/ref 17592186315163} {:answer/id #uuid "6668d210-3666-5a78-bdab-b36c77b23f20" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "even" :db/id #edb/ref 17592186315688} {:answer/id #uuid "c224d4a5-a69e-51bd-b87f-2a11fff0f518" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "continuous" :db/id #edb/ref 17592186316209}] :answer-field/correct {:answer/id #uuid "c224d4a5-a69e-51bd-b87f-2a11fff0f518" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "continuous" :db/id #edb/ref 17592186316209} :answer-field/id #uuid "206ee1d4-18b6-5317-b71a-60ab4bb59aa