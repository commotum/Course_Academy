-3}" :db/id #edb/ref 17592186313751} {:answer/id #uuid "e9d1b8bc-f1b4-5858-bece-8bc740d6a4c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{s}-\\frac{3{e}^{-5s}}{s}+\\frac{{e}^{5(s-3)}}{s-3}" :db/id #edb/ref 17592186313836}] :answer-field/correct {:answer/id #uuid "a6841173-2455-5244-bbec-85414eabc4c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{s}-\\frac{3{e}^{-5s}}{s}+\\frac{{e}^{5(3-s)}}{s-3}" :db/id #edb/ref 17592186313281} :answer-field/id #uuid "db344fa5-42cc-561f-be5a-472e4d16cbdd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314619}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dd8bfbcf-088b-5c81-bfda-8fc9e642ff98" :question/math-academy-id "q-341451" :question/problem "Use the definition of Laplace transforms to calculate $F(s)=L{f(t)},$ where $f(t)$ is given by \n\n$$\nf(t)={\\begin{aligned}3,\\, & t\\le 5 \\\\ {e}^{3t}\\, & t>5.\\end{aligned}\n$$\n\n$\\,F(s)=L{f(t)}=$ {{field-1}},\nvalid for {{field-2}}." :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\nf(t)={\\begin{aligned}3,\\, & t\\le 5 \\\\ {e}^{3t}\\, & t>5\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{5}3\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{5}^{\\infty }{e}^{3t}\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{5}3\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{5}^{\\infty }{e}^{3t-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{5}3{e}^{-st}\\,\\text{d}t+{\\int }_{5}^{\\infty }{e}^{(3-s)t}\\,\\text{d}t.\\end{aligned}\n$$\n\nNote that the improper integral diverges if $s\\le 3.$\n\nFor $s>3,$ we calculate our Laplace transform as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{5}3{e}^{-st}\\,\\text{d}t+{\\int }_{5}^{\\infty }{e}^{(3-s)t}\\,\\text{d}t \\\\  & =-\\frac{3}{s}{[{e}^{-st}]}_{0}^{5}+{\\int }_{5}^{\\infty }{e}^{(3-s)t}\\,\\text{d}t \\\\  & =\\frac{3}{s}-\\frac{3{e}^{-5s}}{s}+{lim}_{a\\to \\infty }{\\int }_{5}^{a}{e}^{(3-s)t}\\,\\text{d}t \\\\  & =\\frac{3}{s}-\\frac{3{e}^{-5s}}{s}+{lim}_{a\\to \\infty }{(\\frac{{e}^{(3-s)t}}{3-s})|}_{5}^{a} \\\\  & =\\frac{3}{s}-\\frac{3{e}^{-5s}}{s}+\\frac{1}{3-s}\\cdot {lim}_{a\\to \\infty }({e}^{(3-s)a}-{e}^{5(3-s)}) \\\\  & =\\frac{3}{s}-\\frac{3{e}^{-5s}}{s}+\\frac{1}{3-s}\\cdot (0-{e}^{5(3-s)}) \\\\  & =\\frac{3}{s}-\\frac{3{e}^{-5s}}{s}+\\frac{{e}^{5(3-s)}}{s-3}\\end{aligned}\n$$\n\nvalid for $s>3.$"} {:db/id #edb/ref 17592186315101 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "177ee81c-577d-564a-8210-07afa1b06be6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{2(3-s)}-1}{s-3}-\\frac{2{e}^{-2s}}{s}" :db/id #edb/ref 17592186312140} {:answer/id #uuid "2f01a372-dd3b-50bc-b8fe-217767f087ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{2(3-s)}-1}{3-s}+\\frac{2{e}^{-2s}}{s}" :db/id #edb/ref 17592186312348} {:answer/id #uuid "4e932ab6-02eb-5105-aab4-56e5003699ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{2(s-3)}}{s-3}+\\frac{2{e}^{-2s}}{s}" :db/id #edb/ref 17592186312613} {:answer/id #uuid "ff2fab78-ed88-5e81-86d8-9891c8b692da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{2(3-s)}}{s-3}+\\frac{2{e}^{-2s}}{s}" :db/id #edb/ref 17592186314010}] :answer-field/correct {:answer/id #uuid "2f01a372-dd3b-50bc-b8fe-217767f087ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{2(3-s)}-1}{3-s}+\\frac{2{e}^{-2s}}{s}" :db/id #edb/ref 17592186312348} :answer-field/id #uuid "449dd274-4bb5-575f-9ac2-93be8596b522" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314199} {:answer-field/choices [{:answer/id #uuid "07cb2353-2c63-5801-a5b1-6dd28e62428c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>3" :db/id #edb/ref 17592186312028} {:answer/id #uuid "5d13da47-28dd-502f-928e-3103fbdfc4cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 2" :db/id #edb/ref 17592186312720} {:answer/id #uuid "7286e117-dd84-5d7e-b6ad-702579064641" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 0" :db/id #edb/ref 17592186312876} {:answer/id #uuid "7e6a33b5-c41a-5a38-a971-4113fa73ef7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>2" :db/id #edb/ref 17592186312990} {:answer/id #uuid "b18dc8b8-8dd0-5f97-9daa-552dd57c90ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>0" :db/id #edb/ref 17592186313352} {:answer/id #uuid "dcb206fa-e222-5d87-b0f9-23f2342d9778" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 3" :db/id #edb/ref 17592186313712}] :answer-field/correct {:answer/id #uuid "b18dc8b8-8dd0-5f97-9daa-552dd57c90ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>0" :db/id #edb/ref 17592186313352} :answer-field/id #uuid "e5120007-0b95-54f8-90a9-c8d747cc88d2" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314639}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0dfe2c1a-430d-5eed-bc5d-17ce89a52f56" :question/math-academy-id "q-341464" :question/problem "Use the definition of Laplace transforms to calculate $F(s)=L{f(t)},$ where $f(t)$ is given by \n\n$$\nf(t)={\\begin{aligned}{e}^{3t},\\, & t\\le 2 \\\\ 2\\, & t>2.\\end{aligned}\n$$\n\n$\\,F(s)=L{f(t)}=$ {{field-1}},\nvalid for {{field-2}}." :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\nf(t)={\\begin{aligned}{e}^{3t},\\, & t\\le 2 \\\\ 2\\, & t>2\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}{e}^{3t}\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{2}^{\\infty }2\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}{e}^{3t-st}\\,\\text{d}t+{\\int }_{2}^{\\infty }2{e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}{e}^{(3-s)t}\\,\\text{d}t+{\\int }_{2}^{\\infty }2{e}^{-st}\\,\\text{d}t.\\end{aligned}\n$$\n\nNote that the improper integral diverges if $s\\le 0.$\n\nFor $s>0,$ we calculate our Laplace transform as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{2}{e}^{(3-s)t}\\,\\text{d}t+{\\int }_{2}^{\\infty }2{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{1}{3-s}{[{e}^{(3-s)t}]}_{0}^{2}+{\\int }_{2}^{\\infty }2{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{{e}^{2(3-s)}-1}{3-s}+{lim}_{a\\to \\infty }{\\int }_{2}^{a}2{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{{e}^{2(3-s)}-1}{3-s}+{lim}_{a\\to \\infty }{(\\frac{-2{e}^{-st}}{s})|}_{2}^{a} \\\\  & =\\frac{{e}^{2(3-s)}-1}{3-s}-\\frac{2}{s}\\cdot {lim}_{a\\to \\infty }({e}^{-as}-{e}^{-2s}) \\\\  & =\\frac{{e}^{2(3-s)}-1}{3-s}-\\frac{2}{s}\\cdot (0-{e}^{-2s}) \\\\  & =\\frac{{e}^{2(3-s)}-1}{3-s}+\\frac{2{e}^{-2s}}{s}\\end{aligned}\n$$\n\nvalid for $s>0.$"} {:db/id #edb/ref 17592186315102 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "577931d6-4cb7-58ad-a2e4-59172c086ddc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{(5-s)}-1}{5-s}+\\frac{{e}^{-s}}{s}" :db/id #edb/ref 17592186312677} {:answer/id #uuid "69434016-4709-563b-95a3-e2bd84a3e6e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{(s-5)}}{s-5}+\\frac{{e}^{-s}}{s}" :db/id #edb/ref 17592186312798} {:answer/id #uuid "6c6b3a83-9825-5fb0-8af0-5d81770d63bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{(5-s)}}{s-5}+\\frac{{e}^{-s}}{s}" :db/id #edb/ref 17592186312825} {:answer/id #uuid "a1927e8e-1a6c-5957-afdb-a68c56dc4c09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{(5-s)}-1}{s-5}-\\frac{{e}^{-s}}{s}" :db/id #edb/ref 17592186313245}] :answer-field/correct {:answer/id #uuid "577931d6-4cb7-58ad-a2e4-59172c086ddc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{(5-s)}-1}{5-s}+\\frac{{e}^{-s}}{s}" :db/id #edb/ref 17592186312677} :answer-field/id #uuid "773b8e29-b5de-5558-9620-507da1f535d0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314327} {:answer-field/choices [{:answer/id #uuid "39de7a29-2808-5fd4-9e63-e7366a44d0c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>5" :db/id #edb/ref 17592186312447} {:answer/id #uuid "4594515a-b0d2-5623-9c2f-7c2819236722" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 5" :db/id #edb/ref 17592186312542} {:answer/id #uuid "54bf94b1-797f-561d-a98e-a80d49698e27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 1" :db/id #edb/ref 17592186312657} {:answer/id #uuid "92cdef45-4527-5cc5-96ae-f47647a3b379" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>1" :db/id #edb/ref 17592186313154} {:answer/id #uuid "e28e37d8-aaf8-59c5-8d6e-01f5215780f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>0" :db/id #edb/ref 17592186313761} {:answer/id #uuid "f0511318-744d-585e-b6ab-276783b5c946" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 0" :db/id #edb/ref 17592186313901}] :answer-field/correct {:answer/id #uuid "e28e37d8-aaf8-59c5-8d6e-01f5215780f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>0" :db/id #edb/ref 17592186313761} :answer-field/id #uuid "aa82ceba-cca7-5401-9143-a6893194b75b" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314468}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2ac112a6-5f62-58cf-9bd0-a4369a549356" :question/math-academy-id "q-341465" :question/problem "Use the definition of Laplace transforms to calculate $F(s)=L{f(t)},$ where $f(t)$ is given by \n\n$$\nf(t)={\\begin{aligned}{e}^{5t},\\, & t\\le 1 \\\\ 1\\, & t>1.\\end{aligned}\n$$\n\n$\\,F(s)=L{f(t)}=$ {{field-1}},\nvalid for {{field-2}}." :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\nf(t)={\\begin{aligned}{e}^{5t},\\, & t\\le 1 \\\\ 1\\, & t>1\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{5t}\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{1}^{\\infty }1\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{5t-st}\\,\\text{d}t+{\\int }_{1}^{\\infty }{e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{(5-s)t}\\,\\text{d}t+{\\int }_{1}^{\\infty }{e}^{-st}\\,\\text{d}t.\\end{aligned}\n$$\n\nNote that the improper integral diverges if $s\\le 0.$\n\nFor $s>0,$ we calculate our Laplace transform as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{1}{e}^{(5-s)t}\\,\\text{d}t+{\\int }_{1}^{\\infty }{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{1}{5-s}{[{e}^{(5-s)t}]}_{0}^{1}+{\\int }_{1}^{\\infty }{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{{e}^{(5-s)}-1}{5-s}+{lim}_{a\\to \\infty }{\\int }_{1}^{a}{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{{e}^{(5-s)}-1}{5-s}+{lim}_{a\\to \\infty }{(\\frac{-{e}^{-st}}{s})|}_{1}^{a} \\\\  & =\\frac{{e}^{(5-s)}-1}{5-s}-\\frac{1}{s}\\cdot {lim}_{a\\to \\infty }({e}^{-as}-{e}^{-s}) \\\\  & =\\frac{{e}^{(5-s)}-1}{5-s}-\\frac{1}{s}\\cdot (0-{e}^{-s}) \\\\  & =\\frac{{e}^{(5-s)}-1}{5-s}+\\frac{{e}^{-s}}{s}\\end{aligned}\n$$\n\nvalid for $s>0.$"} {:db/id #edb/ref 17592186315103 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fa923fd-e972-5347-a45c-b9c236f38cb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 1" :db/id #edb/ref 17592186312088} {:answer/id #uuid "1e1b3e65-34bf-5356-b109-4b8e10e5b725" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>0" :db/id #edb/ref 17592186312198} {:answer/id #uuid "966027aa-4cea-5c2f-9087-c55de857deb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>4" :db/id #edb/ref 17592186313175} {:answer/id #uuid "bd28ae8d-e8fa-5116-9794-49db3460b863" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 0" :db/id #edb/ref 17592186313453} {:answer/id #uuid "cad53332-9c09-54bc-aa91-0b4b15467215" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>1" :db/id #edb/ref 17592186313559} {:answer/id #uuid "e1f27e9c-a174-55a5-9b5a-56c94e0265f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 4" :db/id #edb/ref 17592186313754}] :answer-field/correct {:answer/id #uuid "1e1b3e65-34bf-5356-b109-4b8e10e5b725" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>0" :db/id #edb/ref 17592186312198} :answer-field/id #uuid "23ccb899-a0e2-5002-bd20-4244162e93f6" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314103} {:answer-field/choices [{:answer/id #uuid "56afe28f-37ed-5c8b-939d-793a5d7d6b6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{4(1-s)}}{s-1}+\\frac{2{e}^{-4s}}{s}" :db/id #edb/ref 17592186312674} {:answer/id #uuid "a3815aa4-76ef-5c95-943e-084bec443878" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{4(1-s)}-1}{s-1}-\\frac{2{e}^{-4s}}{s}" :db/id #edb/ref 17592186313262} {:answer/id #uuid "b69b54be-138b-5bdb-bb30-e47b2cfcaf7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{4(1-s)}-1}{1-s}+\\frac{2{e}^{-4s}}{s}" :db/id #edb/ref 17592186313394} {:answer/id #uuid "d02a5a8d-7c3b-5ee7-9b52-a38c2682f679" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{4(s-1)}}{s-1}+\\frac{2{e}^{-4s}}{s}" :db/id #edb/ref 17592186313602}] :answer-field/correct {:answer/id #uuid "b69b54be-138b-5bdb-bb30-e47b2cfcaf7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{4(1-s)}-1}{1-s}+\\frac{2{e}^{-4s}}{s}" :db/id #edb/ref 17592186313394} :answer-field/id #uuid "492cbc28-f726-5021-815c-7bdf5be37107" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314218}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1f908bc8-b43e-5b98-b171-3b917989fec9" :question/math-academy-id "q-341466" :question/problem "Use the definition of Laplace transforms to calculate $F(s)=L{f(t)},$ where $f(t)$ is given by \n\n$$\nf(t)={\\begin{aligned}{e}^{t},\\, & t\\le 4 \\\\ 2\\, & t>4.\\end{aligned}\n$$\n\n$\\,F(s)=L{f(t)}=$ {{field-1}},\nvalid for {{field-2}}." :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\nf(t)={\\begin{aligned}{e}^{t},\\, & t\\le 4 \\\\ 2\\, & t>4\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{4}{e}^{t}\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{4}^{\\infty }2\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{4}{e}^{t-st}\\,\\text{d}t+{\\int }_{4}^{\\infty }2{e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{4}{e}^{(1-s)t}\\,\\text{d}t+{\\int }_{4}^{\\infty }2{e}^{-st}\\,\\text{d}t.\\end{aligned}\n$$\n\nNote that the improper integral diverges if $s\\le 0.$\n\nFor $s>0,$ we calculate our Laplace transform as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{4}{e}^{(1-s)t}\\,\\text{d}t+{\\int }_{4}^{\\infty }2{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{1}{1-s}{[{e}^{(1-s)t}]}_{0}^{4}+{\\int }_{4}^{\\infty }2{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{{e}^{4(1-s)}-1}{1-s}+{lim}_{a\\to \\infty }{\\int }_{4}^{a}2{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{{e}^{4(1-s)}-1}{1-s}+{lim}_{a\\to \\infty }{(\\frac{-2{e}^{-st}}{s})|}_{4}^{a} \\\\  & =\\frac{{e}^{4(1-s)}-1}{1-s}-\\frac{2}{s}\\cdot {lim}_{a\\to \\infty }({e}^{-as}-{e}^{-4s}) \\\\  & =\\frac{{e}^{4(1-s)}-1}{1-s}-\\frac{2}{s}\\cdot (0-{e}^{-4s}) \\\\  & =\\frac{{e}^{4(1-s)}-1}{1-s}+\\frac{2{e}^{-4s}}{s}\\end{aligned}\n$$\n\nvalid for $s>0.$"} {:db/id #edb/ref 17592186315104 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "290f52b2-20e6-5905-988c-748802b627d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186312286}] :answer-field/correct {:answer/id #uuid "290f52b2-20e6-5905-988c-748802b627d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186312286} :answer-field/id #uuid "c222c8e2-34bd-53c8-8877-54fd0121599e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314556}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9a67f2b8-f03c-57a0-a261-901981830dca" :question/math-academy-id "q-341468" :question/problem "The values of functions $h(t)$ and $z(t)$ and their derivatives at $t=4$ are given in the table below.\n\n| $t$ | $h(t)$ | $z(t)$ | ${h}^{′}(t)$ | ${z}^{′}(t)$ |\n| --- | --- | --- | --- | --- |\n| $4$ | $1$ | $-2$ | $3$ | $1$ |\n\nIf $f(t)=\\frac{2h(t)-5}{1-z(t)},$ compute ${f}^{′}(4).$ Do not round the answer.\n\n${f}^{′}(4)=$\n{{field-1}}" :question/worked-solution "The quotient rule states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}(\\frac{u}{v})=\\frac{{u}^{′}v-u{v}^{′}}{{v}^{2}}.\n$$\n\nLet $u=2h(t)-5$ and $v=1-z(t).$ Differentiating each, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}t}=2{h}^{′}(t)\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}t}=-{z}^{′}(t).\n$$\n\nSubstituting into the quotient rule gives\n\n$$\n{f}^{′}(t)=\\frac{2{h}^{′}(t)(1-z(t))-(2h(t)-5)(-{z}^{′}(t))}{(1-z(t))^{2}}.\n$$\n\nAt $t=4,$ this gives\n\n$$\n\\begin{aligned}{f}^{′}(4) & =\\frac{2{h}^{′}(4)(1-z(4))-(2h(4)-5)(-{z}^{′}(4))}{(1-z(4))^{2}} \\\\  & =\\frac{2(3)(1-(-2))-(2(1)-5)(-1)}{(1-(-2))^{2}} \\\\  & =\\frac{2(3)(3)-(-3)(-1)}{(3)^{2}} \\\\  & =\\frac{18-3}{9} \\\\  & =\\frac{15}{9} \\\\  & =\\frac{5}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186315105 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b03c39a-d66f-509d-aa96-c01febc0a8b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>1" :db/id #edb/ref 17592186312174} {:answer/id #uuid "23ce276c-a9be-5285-bc2f-9845fe922be0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge -3" :db/id #edb/ref 17592186312240} {:answer/id #uuid "45b69667-ae8b-5608-a75f-137c919a8643" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>0" :db/id #edb/ref 17592186312545} {:answer/id #uuid "5c5b6022-8075-5b3f-a8a4-5a8175006cb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>-3" :db/id #edb/ref 17592186312712} {:answer/id #uuid "9c4f06bf-ae3b-5f51-8664-8fbd41b26aa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 0" :db/id #edb/ref 17592186313213} {:answer/id #uuid "d481a022-70b0-5abc-95c5-3c9643a3b858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s\\ge 1" :db/id #edb/ref 17592186313649}] :answer-field/correct {:answer/id #uuid "45b69667-ae8b-5608-a75f-137c919a8643" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>0" :db/id #edb/ref 17592186312545} :answer-field/id #uuid "0d68bc5f-babd-5729-b187-91c49d57c0af" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314050} {:answer-field/choices [{:answer/id #uuid "0dac4e39-fe64-592b-b123-ffa83935210e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{(3+s)}}{s+3}+\\frac{4{e}^{-s}}{s}" :db/id #edb/ref 17592186312073} {:answer/id #uuid "49b1a34e-4f54-521a-938a-3f4fcf66a727" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-(3+s)}-1}{s+3}-\\frac{4{e}^{-s}}{s}" :db/id #edb/ref 17592186312571} {:answer/id #uuid "6e2d16f4-8495-5f9c-b906-2811f641820f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-(3+s)}}{s+3}+\\frac{4{e}^{-s}}{s}" :db/id #edb/ref 17592186312843} {:answer/id #uuid "a2c16455-9df2-5b54-9874-0b208ea1b9ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-{e}^{-(3+s)}}{3+s}+\\frac{4{e}^{-s}}{s}" :db/id #edb/ref 17592186313254}] :answer-field/correct {:answer/id #uuid "a2c16455-9df2-5b54-9874-0b208ea1b9ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-{e}^{-(3+s)}}{3+s}+\\frac{4{e}^{-s}}{s}" :db/id #edb/ref 17592186313254} :answer-field/id #uuid "20a7de68-5385-5701-a7ba-f5141a58a397" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314097}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3a39794a-3f3c-5f7a-adcb-d68165de84a1" :question/math-academy-id "q-341481" :question/problem "Use the definition of Laplace transforms to calculate $F(s)=L{f(t)},$ where $f(t)$ is given by \n\n$$\nf(t)={\\begin{aligned}{e}^{-3t},\\, & t\\le 1 \\\\ 4\\, & t>1.\\end{aligned}\n$$\n\n$\\,F(s)=L{f(t)}=$ {{field-1}},\nvalid for {{field-2}}." :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\nf(t)={\\begin{aligned}{e}^{-3t},\\, & t\\le 1 \\\\ 4\\, & t>1\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{-3t}\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{1}^{\\infty }4\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{-3t-st}\\,\\text{d}t+{\\int }_{1}^{\\infty }4\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{-(3+s)t}\\,\\text{d}t+{\\int }_{1}^{\\infty }4{e}^{-st}\\,\\text{d}t.\\end{aligned}\n$$\n\nNote that the improper integral diverges if $s\\le 0.$\n\nFor $s>0,$ we calculate our Laplace transform as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{1}{e}^{-(3+s)t}\\,\\text{d}t+{\\int }_{1}^{\\infty }4{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{1}{-(3+s)}{[{e}^{-(3+s)t}]}_{0}^{1}+{\\int }_{1}^{\\infty }4{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{1-{e}^{-(3+s)}}{3+s}+{lim}_{a\\to \\infty }{\\int }_{1}^{a}4{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{1-{e}^{-(3+s)}}{3+s}+{lim}_{a\\to \\infty }{(\\frac{-4{e}^{-st}}{s})|}_{1}^{a} \\\\  & =\\frac{1-{e}^{-(3+s)}}{3+s}-\\frac{4}{s}\\cdot {lim}_{a\\to \\infty }({e}^{-as}-{e}^{-s}) \\\\  & =\\frac{1-{e}^{-(3+s)}}{3+s}-\\frac{4}{s}\\cdot (0-{e}^{-s}) \\\\  & =\\frac{1-{e}^{-(3+s)}}{3+s}+\\frac{4{e}^{-s}}{s}\\end{aligned}\n$$\n\nvalid for $s>0.$"} {:db/id #edb/ref 17592186315106 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fec0518-6db1-5a1a-87fd-0be56c14ec24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.73" :db/id #edb/ref 17592186312357}] :answer-field/correct {:answer/id #uuid "2fec0518-6db1-5a1a-87fd-0be56c14ec24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.73" :db/id #edb/ref 17592186312357} :answer-field/id #uuid "ac09dbc9-4c7f-5daf-a0d0-d838c2f1ffb0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314474}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e50cad91-21d9-539e-b085-381c16d9469f" :question/math-academy-id "q-341492" :question/problem "The data below is taken from the table of values of the cumulative distribution function $Φ(z)$ for the standard normal distribution. Given that $X∼N(1.5,{\\sigma }^{2})$ and $P(X<2)=0.5910,$ use the table value to find ${\\sigma }^{2},$ rounded to $2$ decimal places.\n\n| $z$ | $\\,0.02\\,$ | $\\,0.03\\,$ | $\\,0.04\\,$ |\n| --- | --- | --- | --- |\n| $\\,0.1\\,$ | $\\,0.5478\\,$ | $\\,0.5517\\,$ | $\\,0.5557\\,$ |\n| $\\,0.2\\,$ | $\\,0.5871\\,$ | $\\,0.5910\\,$ | $\\,0.5948\\,$ |\n| $\\,0.3\\,$ | $\\,0.6255\\,$ | $\\,0.6293\\,$ | $\\,0.6331\\,$ |\n\n${\\sigma }^{2}≈$\n{{field-1}}" :question/worked-solution "First, we convert the given probability into a cumulative probability:\n\n$$\n\\begin{aligned}P(X<2)=0.5910\\,⇒\\,P(X\\le 2)=0.5910\\end{aligned}\n$$\n\nThen, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(X\\le 2) & =0.5910 \\\\ P\\,(Z\\le \\frac{2-1.5}{\\sigma }) & =0.5910 \\\\ Φ\\,(\\frac{0.5}{\\sigma }) & =0.5910 \\\\ \\frac{0.5}{\\sigma } & ={Φ}^{-1}(0.5910)\\end{aligned}\n$$\n\nAccording to the table, we have\n\n$$\nΦ(0.23)=0.5910\\,⇒\\,{Φ}^{-1}(0.5910)=0.23.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{0.5}{\\sigma } & =0.23 \\\\ \\sigma  & =\\frac{0.5}{0.23} \\\\ \\sigma  & ≈2.173\\,91,\\end{aligned}\n$$\n\nrounded to $5$ decimal places.\n\nFinally,\n\n$$\n\\begin{aligned}{\\sigma }^{2}=(2.173\\,91)^{2}≈4.73.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186315107 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7cb390c-e572-53a0-b9de-83c29e711d66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{x}}+3{sec}^{2}x" :db/id #edb/ref 17592186313955}] :answer-field/correct {:answer/id #uuid "f7cb390c-e572-53a0-b9de-83c29e711d66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{x}}+3{sec}^{2}x" :db/id #edb/ref 17592186313955} :answer-field/id #uuid "980400c0-8e83-5892-8b48-98f7e9a9af2a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314422}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d99ea33e-6fab-5224-901c-7ede7395140b" :question/math-academy-id "q-341495" :question/problem "Find ${f}^{′}(x)$ if $f(x)=4\\sqrt{x}+3tan⁡x.$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x.$ Applying these formulas, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4\\sqrt{x}+3tan⁡x) \\\\  & =4\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})+3\\frac{\\text{d}}{\\text{d}x}(tan⁡x) \\\\  & =4(\\frac{1}{2\\sqrt{x}})+3({sec}^{2}⁡x) \\\\  & =\\frac{2}{\\sqrt{x}}+3{sec}^{2}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186315109 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b99e4117-0aad-50da-a0ea-7f1605f6f881" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4+10{y}^{4}" :db/id #edb/ref 17592186313421}] :answer-field/correct {:answer/id #uuid "b99e4117-0aad-50da-a0ea-7f1605f6f881" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4+10{y}^{4}" :db/id #edb/ref 17592186313421} :answer-field/id #uuid "a13b0fcc-1e2e-571c-b6df-a879bcbc6ca8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314443}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aed30416-75f3-525a-aed4-35612b1daf20" :question/math-academy-id "q-341608" :question/problem "Given that $x=-\\frac{2}{{y}^{2}}+5{y}^{2},$ express $\\frac{\\text{d}y}{\\text{d}x}$ as a function of $y.$\n\n| $\\text{d}y$ | $=$ | ${y}^{3}$ |\n| --- | --- | --- |\n| $\\text{d}x$ |  | {{field-1}} |" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(-\\frac{2}{{y}^{2}}+5{y}^{2}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(-2{y}^{-1}+5{y}^{2}) \\\\  & =-2\\frac{\\text{d}}{\\text{d}y}({y}^{-2})+5\\frac{\\text{d}}{\\text{d}y}({y}^{2}) \\\\  & =-2(-2{y}^{-3})+5(2y) \\\\  & =\\frac{4}{{y}^{3}}+10y \\\\  & =\\frac{4+10{y}^{4}}{{y}^{3}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{{y}^{3}}{4+10{y}^{4}}.\n$$"} {:db/id #edb/ref 17592186317157 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c50f4870-1fee-5fbb-88c9-7019bf10dac5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{13}" :db/id #edb/ref 17592186316226}] :answer-field/correct {:answer/id #uuid "c50f4870-1fee-5fbb-88c9-7019bf10dac5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{13}" :db/id #edb/ref 17592186316226} :answer-field/id #uuid "93b3e742-b588-5f94-8536-ec336cad03a4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316886}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7b5bef75-1150-511d-bcb8-1729f4fd0d44" :question/math-academy-id "q-341634" :question/problem "If $x=4{y}^{4}-3y,$ find $\\frac{\\text{d}y}{\\text{d}x}$ at the point $(1,1).$\n\n$\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(1,1)}=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(4{y}^{4}-3y) \\\\  & =4\\frac{\\text{d}}{\\text{d}y}({y}^{4})-3\\frac{\\text{d}}{\\text{d}y}(y) \\\\  & =4(4{y}^{3})-3 \\\\  & =16{y}^{3}-3\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{1}{16{y}^{3}-3}.\n$$\n\nFinally, substituting the point $(1,1),$ we find\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(1,1)} & =\\frac{1}{16({1}^{3})-3}=\\frac{1}{13}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317159 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73b6a40d-d5af-574c-9c82-43dd1d924703" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{28}" :db/id #edb/ref 17592186315775}] :answer-field/correct {:answer/id #uuid "73b6a40d-d5af-574c-9c82-43dd1d924703" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{28}" :db/id #edb/ref 17592186315775} :answer-field/id #uuid "46fe6899-9adb-5c7a-a8ac-f8ecb1ec928b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316706}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "138e10f7-a58f-5db5-81ae-1e29e1a9812e" :question/math-academy-id "q-341636" :question/problem "If $x=2{y}^{3}+{y}^{2},$ find $\\frac{\\text{d}y}{\\text{d}x}$ at the point $(20,2).$\n\n$\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(20,2)}=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(2{y}^{3}+{y}^{2}) \\\\  & =2\\frac{\\text{d}}{\\text{d}y}({y}^{3})+\\frac{\\text{d}}{\\text{d}y}({y}^{2}) \\\\  & =2(3{y}^{2})+2y \\\\  & =6{y}^{2}+2y\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{1}{6{y}^{2}+2y}.\n$$\n\nFinally, substituting the point $(20,2),$ we find\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(20,2)} & =\\frac{1}{6({2}^{2})+2(2)}=\\frac{1}{28}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317164 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c7ba7c05-abae-54c2-8308-798505248b1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.30" :db/id #edb/ref 17592186316247}] :answer-field/correct {:answer/id #uuid "c7ba7c05-abae-54c2-8308-798505248b1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.30" :db/id #edb/ref 17592186316247} :answer-field/id #uuid "b87f1c6e-c8d2-5b9d-b0ea-9f20d81972ab" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316979}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f9f19fd2-6f5a-5fbb-8759-a811885f9345" :question/math-academy-id "q-341651" :question/problem "The data below is taken from the table of values of the cumulative distribution function $Φ(z)$ for the standard normal distribution. Given that $X∼N(-1,{\\sigma }^{2})$ and $P(X>1)=0.0618,$ use the table to find $\\sigma ,$ rounded to $2$ decimal places.\n\n| $z$ | $\\,0.04\\,$ | $\\,0.05\\,$ | $\\,0.06\\,$ |\n| --- | --- | --- | --- |\n| $\\,1.4\\,$ | $\\,0.9251\\,$ | $\\,0.9265\\,$ | $\\,0.9279\\,$ |\n| $\\,1.5\\,$ | $\\,0.9382\\,$ | $\\,0.9394\\,$ | $\\,0.9406\\,$ |\n| $\\,1.6\\,$ | $\\,0.9495\\,$ | $\\,0.9505\\,$ | $\\,0.9515\\,$ |\n\n$\\sigma ≈$\n{{field-1}}" :question/worked-solution "First, we convert the given probability into a cumulative probability using the complement:\n\n$$\n\\begin{aligned}P(X\\le 1) & =1-P(X>1) \\\\  & =1-0.0618 \\\\  & =0.9382\\end{aligned}\n$$\n\nThen, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(X\\le 1) & =0.9382 \\\\ P\\,(Z\\le \\frac{1-(-1)}{\\sigma }) & =0.9382 \\\\ Φ\\,(\\frac{2}{\\sigma }) & =0.9382 \\\\ \\frac{2}{\\sigma } & ={Φ}^{-1}(0.9382)\\end{aligned}\n$$\n\nAccording to the table, we have\n\n$$\nΦ(1.54)=0.9382\\,⇒\\,{Φ}^{-1}(0.9382)=1.54.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{2}{\\sigma } & =1.54 \\\\ \\sigma  & =\\frac{2}{1.54} \\\\ \\sigma  & ≈1.30,\\end{aligned}\n$$\n\nrounded to $2$ decimal places."} {:db/id #edb/ref 17592186317165 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66a8e441-b6b2-591b-944b-3cfddb0ac398" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186315690}] :answer-field/correct {:answer/id #uuid "66a8e441-b6b2-591b-944b-3cfddb0ac398" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186315690} :answer-field/id #uuid "d2534596-9656-56a2-a31c-8adf543ca897" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317042}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4a054739-7d5f-59e4-b190-1f466818f897" :question/math-academy-id "q-341655" :question/problem "The data below is taken from the table of values of the cumulative distribution function $Φ(z)$ for the standard normal distribution. Given that $X∼N(3,{\\sigma }^{2})$ and $P(X\\ge 1)=0.8413,$ use the table to find $\\sigma .$\n\n| $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ |\n| --- | --- | --- | --- |\n| $\\,-1.0\\,$ | $\\,0.1587\\,$ | $\\,0.1562\\,$ | $\\,0.1539\\,$ |\n| $\\,-0.9\\,$ | $\\,0.1841\\,$ | $\\,0.1814\\,$ | $\\,0.1788\\,$ |\n| $\\,-0.8\\,$ | $\\,0.2119\\,$ | $\\,0.2090\\,$ | $\\,0.2061\\,$ |\n\n$\\sigma =$\n{{field-1}}" :question/worked-solution "First, we convert the given probability into a cumulative probability using the complement:\n\n$$\n\\begin{aligned}P(X\\le 1) & =P(X<1) \\\\  & =1-P(X\\ge 1) \\\\  & =1-0.8413 \\\\  & =0.1587\\end{aligned}\n$$\n\nThen, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(X\\le 1) & =0.1587 \\\\ P\\,(Z\\le \\frac{1-3}{\\sigma }) & =0.1587 \\\\ Φ\\,(-\\frac{2}{\\sigma }) & =0.1587 \\\\ -\\frac{2}{\\sigma } & ={Φ}^{-1}(0.1587)\\end{aligned}\n$$\n\nAccording to the table, we have\n\n$$\nΦ(-1.00)=0.1587\\,⇒\\,{Φ}^{-1}(0.1587)=-1.00.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}-\\frac{2}{\\sigma } & =-1 \\\\ \\sigma  & =\\frac{2}{1} \\\\ \\sigma  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317173 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04625262-02e3-5735-baa9-8341f10fe02c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186315140}] :answer-field/correct {:answer/id #uuid "04625262-02e3-5735-baa9-8341f10fe02c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186315140} :answer-field/id #uuid "ccfdc307-43ba-59d0-bfef-8dec92c5a903" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317031}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0a20dd68-509a-5704-9c10-a08b87646850" :question/math-academy-id "q-341745" :question/problem "If $x={y}^{4}-\\frac{3}{y},$ find $\\frac{\\text{d}y}{\\text{d}x}$ at the point $(4,-1).$\n\n$\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(4,-1)}=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}({y}^{4}-\\frac{3}{y}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}({y}^{4})-3\\frac{\\text{d}}{\\text{d}y}({y}^{-1}) \\\\  & =4{y}^{3}-3(-{y}^{-2}) \\\\  & =4{y}^{3}+3{y}^{-2} \\\\  & =4{y}^{3}+\\frac{3}{{y}^{2}} \\\\  & =\\frac{4{y}^{5}+3}{{y}^{2}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{{y}^{2}}{4{y}^{5}+3}.\n$$\n\nFinally, substituting the point $(4,-1),$ we find\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(4,-1)} & =\\frac{(-1)^{2}}{4(-1)^{5}+3}=-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6bc8dbd-b2e6-5cdf-a87f-15c55de69984" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186316317}] :answer-field/correct {:answer/id #uuid "d6bc8dbd-b2e6-5cdf-a87f-15c55de69984" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186316317} :answer-field/id #uuid "150499da-4d4c-5a7a-a641-6e789fc3eda1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316595}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cedc590a-5ca0-5fc5-bd76-db896782c449" :question/math-academy-id "q-341751" :question/problem "If $x=-\\frac{16}{\\sqrt[3]{y}}+13,$ find $\\frac{\\text{d}y}{\\text{d}x}$ at the point $(5,8).$\n\n$\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(5,8)}=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(-\\frac{16}{\\sqrt[3]{y}}+13) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(-16{y}^{-1/3}+13) \\\\  & =-16\\frac{\\text{d}}{\\text{d}y}({y}^{-1/3})+\\frac{\\text{d}}{\\text{d}y}(13) \\\\  & =-16(-\\frac{1}{3}{y}^{-4/3})+0 \\\\  & =\\frac{16}{3}{y}^{-4/3} \\\\  & =\\frac{16}{3{(\\sqrt[3]{y})}^{4}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{3{(\\sqrt[3]{y})}^{4}}{16}.\n$$\n\nFinally, substituting the point $(5,8),$ we find\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(5,8)} & =\\frac{3{(\\sqrt[3]{8})}^{4}}{16} \\\\  & =\\frac{3(16)}{16} \\\\  & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317175 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5940053-6ffd-56dc-91ae-1c3e0c96776a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186316147}] :answer-field/correct {:answer/id #uuid "b5940053-6ffd-56dc-91ae-1c3e0c96776a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186316147} :answer-field/id #uuid "fa18cac4-b60b-5b97-ba75-3318b18e72b7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317135}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3fca9bbb-c820-579a-91ba-addcd4437f36" :question/math-academy-id "q-341757" :question/problem "If $x=-\\frac{12}{\\sqrt{y}}-2y\\sqrt{y},$ find $\\frac{\\text{d}y}{\\text{d}x}$ at the point $(-14,1).$\n\n$\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(-14,1)}=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(-\\frac{12}{\\sqrt{y}}-2y\\sqrt{y}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(-12{y}^{-1/2}-2y\\cdot {y}^{1/2}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(-12{y}^{-1/2}-2{y}^{3/2}) \\\\  & =-12\\frac{\\text{d}}{\\text{d}y}({y}^{-1/2})-2\\frac{\\text{d}}{\\text{d}y}({y}^{3/2}) \\\\  & =-12(-\\frac{1}{2}){y}^{-3/2}-2\\cdot \\frac{3}{2}{y}^{1/2} \\\\  & =6{y}^{-3/2}-3{y}^{1/2} \\\\  & =\\frac{6}{y\\sqrt{y}}-3\\sqrt{y} \\\\  & =\\frac{6-3{y}^{2}}{y\\sqrt{y}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{y\\sqrt{y}}{6-3{y}^{2}}.\n$$\n\nFinally, substituting the point $(-14,1),$ we find\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(-14,1)} & =\\frac{1\\sqrt{1}}{6-3(1)^{2}} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317178 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "264561c5-9799-51c9-a009-d1202a71c2b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186315334}] :answer-field/correct {:answer/id #uuid "264561c5-9799-51c9-a009-d1202a71c2b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186315334} :answer-field/id #uuid "79eafde2-60a3-502c-bcb3-a8d0d2d51c6e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316837}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e12f9894-53cb-5435-b393-ea7e08594626" :question/math-academy-id "q-341789" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(n\\pi x)+{b}_{n}\\operatorname{sin}⁡(n\\pi x)\n$$\n\nLet $F(x)=6{x}^{2}+5x+1$ for $x\\in [-1,1).$ The Fourier series of the $2$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the constant term is given by\n\n$$\n{a}_{0}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\,\\text{d}x.\n$$\n\nIn our case, $L=1$ and $f(x)=6{x}^{2}+5x+1$ for $x\\in [-1,1).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{1}{\\int }_{-1}^{1}(6{x}^{2}+5x+1)\\,\\text{d}x \\\\  & ={[2{x}^{3}+\\frac{5}{2}{x}^{2}+x]}_{-1}^{1} \\\\  & =(2+\\frac{5}{2}+1)-((-2)+\\frac{5}{2}+(-1)) \\\\  & =\\frac{11}{2}-(-\\frac{1}{2}) \\\\  & =6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317183 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4265357-1f5a-572b-b951-6c8731bedf0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186316044}] :answer-field/correct {:answer/id #uuid "a4265357-1f5a-572b-b951-6c8731bedf0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186316044} :answer-field/id #uuid "01b8be81-ed30-5c06-b89b-3ae37ec6ccee" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316550}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "04d16541-33c4-5168-abf0-25ac42f61efd" :question/math-academy-id "q-341825" :question/problem "Calculate the instantaneous rate of change of the function $f(x)=\\operatorname{tan}⁡x-{x}^{2}$ when $x=0.$\n\n${f}^{′}(0)=$\n{{field-1}}" :question/worked-solution "The instantaneous rate of change when $x=0$ is given by the value of the derivative ${f}^{′}(x)$ at $x=0.$ \n\nFirst, we compute the derivative, using the fact that $\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡x)={sec}^{2}⁡x$ and $\\frac{\\text{d}}{\\text{d}x}({x}^{2})=2x.$ We get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡x-{x}^{2}) \\\\  & ={sec}^{2}⁡x-2x.\\end{aligned}\n$$\n\nEvaluating at $x=0,$ we get\n\n$$\n\\begin{aligned}{f}^{′}(0) & ={sec}^{2}⁡(0)-2\\cdot 0 \\\\  & ={(\\frac{1}{\\operatorname{cos}⁡(0)})}^{2}-0 \\\\  & ={(\\frac{1}{1})}^{2} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change is $1.$"} {:db/id #edb/ref 17592186317186 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dfdc63a9-81e1-5712-aacb-47ce364408eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186316359}] :answer-field/correct {:answer/id #uuid "dfdc63a9-81e1-5712-aacb-47ce364408eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186316359} :answer-field/id #uuid "ffea591d-4a5e-53f6-9c48-f7ec134caf67" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317156}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e12d099b-7b80-5e58-a8d0-f694cba87a2b" :question/math-academy-id "q-341870" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n}{3}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n}{3}x)\n$$\n\nLet $F(x)=-3x+1$ for $x\\in [-3\\pi ,3\\pi ).$ The Fourier series of the $6\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${a}_{4}.$\n\n${a}_{4}=$ {{field-1}}" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the cosine coefficients are given by\n\n$$\n{a}_{n}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)\\,\\text{d}x.\n$$\n\nIn our case, $L=3\\pi $ and $f(x)=-3x+1$ for $x\\in [-3\\pi ,3\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{4} & =\\frac{1}{3\\pi }{\\int }_{-\\pi }^{\\pi }(-3x+1)\\operatorname{cos}⁡(\\frac{4\\pi }{3\\pi }x)\\,\\text{d}x \\\\  & =\\frac{1}{3\\pi }{\\int }_{-\\pi }^{\\pi }(-3x+1)\\operatorname{cos}⁡(\\frac{4}{3}x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=-3x+1\\, & ⇒\\,{u}^{′}=-3 \\\\ {v}^{′}=\\operatorname{cos}⁡(\\frac{4}{3}x)\\, & ⇒\\,v=\\frac{3}{4}\\operatorname{sin}⁡(\\frac{4}{3}x)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{4} & =\\frac{1}{3\\pi }(uv\\,{|}_{-3\\pi }^{3\\pi }-{\\int }_{-3\\pi }^{3\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{1}{3\\pi }(\\frac{3}{4}{[(-3x+1)\\operatorname{sin}⁡(\\frac{4}{3}x)]}_{-3\\pi }^{3\\pi }-{\\int }_{-3\\pi }^{3\\pi }\\frac{3}{4}\\operatorname{sin}⁡(\\frac{4}{3}x)\\cdot (-3)\\,\\text{d}x) \\\\  & =\\frac{1}{3\\pi }(\\frac{3}{4}[(-9\\pi +1)\\operatorname{sin}⁡(4\\pi )-(9\\pi +1)\\operatorname{sin}⁡(-4\\pi )]+\\frac{9}{4}{\\int }_{-3\\pi }^{3\\pi }\\operatorname{sin}⁡(\\frac{4}{3}x)\\,\\text{d}x) \\\\  & =\\frac{1}{\\pi }(\\frac{1}{4}\\cdot 0+\\frac{9}{4}\\cdot (-\\frac{3}{4}){[\\operatorname{cos}⁡(\\frac{4}{3}x)]}_{-3\\pi }^{3\\pi }) \\\\  & =\\frac{1}{\\pi }(-\\frac{27}{16}[\\operatorname{cos}⁡(4\\pi )-\\operatorname{cos}⁡(-4\\pi )]) \\\\  & =-\\frac{27}{16\\pi }(1-1) \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317187 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28f6f736-4009-5b4f-8058-a10414188390" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186315353}] :answer-field/correct {:answer/id #uuid "28f6f736-4009-5b4f-8058-a10414188390" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186315353} :answer-field/id #uuid "52e5c64b-d713-5876-b513-033b01dba8b2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316740}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0a97764f-f130-5df7-bef4-c5372f6f59c9" :question/math-academy-id "q-341915" :question/problem "Find the slope $m$ of the tangent at the point $(16,\\,4)$ for the curve $\\sqrt{x}+\\sqrt{y}=6.$\n\n$m=$\n{{field-1}}" :question/worked-solution "To find the slope at a point, we use implicit differentiation to calculate the derivative of the curve, assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}+\\sqrt{y}) & =\\frac{\\text{d}}{\\text{d}x}(6) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{1/2}+{y}^{1/2}) & =\\frac{\\text{d}}{\\text{d}x}(6) \\\\ \\frac{1}{2}{x}^{-1/2}+\\frac{1}{2}{y}^{-1/2}(\\frac{\\text{d}y}{\\text{d}x}) & =0 \\\\ \\frac{1}{2}{y}^{-1/2}(\\frac{\\text{d}y}{\\text{d}x}) & =-\\frac{1}{2}{x}^{-1/2} \\\\ \\frac{1}{2\\sqrt{y}}(\\frac{\\text{d}y}{\\text{d}x}) & =-\\frac{1}{2\\sqrt{x}} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{\\sqrt{y}}{\\sqrt{x}}\\end{aligned}\n$$\n\nThe slope of the tangent at the point $(16,\\,4)$ is then given by\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{(16,\\,4)} \\\\  & ={(-\\frac{\\sqrt{y}}{\\sqrt{x}})|}_{(16,\\,4)} \\\\  & =-\\frac{\\sqrt{4}}{\\sqrt{16}} \\\\  & =-\\frac{2}{4} \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317188 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ae7cae9-79ff-5f39-85da-df94153947dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186315719}] :answer-field/correct {:answer/id #uuid "6ae7cae9-79ff-5f39-85da-df94153947dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186315719} :answer-field/id #uuid "0fd4eb5e-7bd4-5910-bd71-b6d0c5d615da" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316585}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "be11712d-8184-5176-b182-3e96ce7e8e3b" :question/math-academy-id "q-341918" :question/problem "Find the slope $m$ of the tangent at the point $(9,\\,4)$ for the curve $\\sqrt{x}-\\sqrt{y}=1.$\n\n$m=$\n{{field-1}}" :question/worked-solution "To find the slope at a point, we use implicit differentiation to calculate the derivative of the curve, assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}-\\sqrt{y}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{1/2}-{y}^{1/2}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{1}{2}{x}^{-1/2}-\\frac{1}{2}{y}^{-1/2}(\\frac{\\text{d}y}{\\text{d}x}) & =0 \\\\ -\\frac{1}{2}{y}^{-1/2}(\\frac{\\text{d}y}{\\text{d}x}) & =-\\frac{1}{2}{x}^{-1/2} \\\\ -\\frac{1}{2\\sqrt{y}}(\\frac{\\text{d}y}{\\text{d}x}) & =-\\frac{1}{2\\sqrt{x}} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\sqrt{y}}{\\sqrt{x}}\\end{aligned}\n$$\n\nThe slope of the tangent at the point $(9,\\,4)$ is then given by\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{(9,\\,4)} \\\\  & ={(\\frac{\\sqrt{y}}{\\sqrt{x}})|}_{(9,\\,4)} \\\\  & =\\frac{\\sqrt{4}}{\\sqrt{9}} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317190 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80592157-1fdb-5e01-851d-d4d9a2def852" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.43" :db/id #edb/ref 17592186315824}] :answer-field/correct {:answer/id #uuid "80592157-1fdb-5e01-851d-d4d9a2def852" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.43" :db/id #edb/ref 17592186315824} :answer-field/id #uuid "86d59564-fbce-500f-9999-d29e15a7f0fc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316858}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "171aa441-28c9-56ed-921a-96a0833a165c" :question/math-academy-id "q-341991" :question/problem "The data below is taken from the table of values of the cumulative distribution function $Φ(z)$ for the standard normal distribution. Given that $X∼N(0,{\\sigma }^{2})$ is a normal random variable with $P(-2<X<2)=0.6578,$ find ${\\sigma }^{2}$ rounded to $2$ decimal places.\n\n| $z$ | $\\,0.04\\,$ | $\\,0.05\\,$ | $\\,0.06\\,$ |\n| --- | --- | --- | --- |\n| $\\,0.8\\,$ | $\\,0.7995\\,$ | $\\,0.8023\\,$ | $\\,0.8051\\,$ |\n| $\\,0.9\\,$ | $\\,0.8264\\,$ | $\\,0.8289\\,$ | $\\,0.8315\\,$ |\n| $\\,1.0\\,$ | $\\,0.8508\\,$ | $\\,0.8531\\,$ | $\\,0.8554\\,$ |\n\n${\\sigma }^{2}≈$\n{{field-1}}" :question/worked-solution "First, we find the cumulative probability using symmetry:\n\n$$\n\\begin{aligned}P(-2<X<2) & =0.6578 \\\\ 2P(0<X<2) & =0.6578 \\\\ P(0<X<2) & =0.3289 \\\\ P(X<2)-P(X<0) & =0.3289 \\\\ P(X<2)-0.5 & =0.3289 \\\\ P(X<2) & =0.8289 \\\\ P(X\\le 2) & =0.8289\\end{aligned}\n$$\n\nThen, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(X\\le 2) & =0.8289 \\\\ P\\,(Z\\le \\frac{2-0}{\\sigma }) & =0.8289 \\\\ Φ\\,(\\frac{2}{\\sigma }) & =0.8289 \\\\ \\frac{2}{\\sigma } & ={Φ}^{-1}(0.8289)\\end{aligned}\n$$\n\nAccording to the table, we have\n\n$$\nΦ(0.95)=0.8289\\,⇒\\,{Φ}^{-1}(0.8289)=0.95.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{2}{\\sigma } & =0.95 \\\\ \\sigma  & =\\frac{2}{0.95} \\\\ \\sigma  & ≈2.105\\,26.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =(2.105\\,26)^{2} \\\\  & ≈4.43\\end{aligned}\n$$\n\nrounded to $2$ decimal places."} {:db/id #edb/ref 17592186317194 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62132428-191b-5bdb-8047-c131604498ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186315668}] :answer-field/correct {:answer/id #uuid "62132428-191b-5bdb-8047-c131604498ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186315668} :answer-field/id #uuid "686733a1-a011-561c-9118-65ee67b8331e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316798}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6e084cbe-6414-54d1-af07-4d96798fc98c" :question/math-academy-id "q-342004" :question/problem "The function $f(x)$ is defined as\n\n$$\nf(x)={\\begin{aligned}-x+4, & x<1, \\\\ 2x-3, & x\\ge 1.\\end{aligned}\n$$\n\nThen,\n\n${\\int }_{-3}^{4}f(x)\\,\\text{d}x=$\n{{field-1}}." :question/worked-solution "By the additive property of the definite integral, we have\n\n$$\n\\begin{aligned}{\\int }_{-3}^{4}f(x)\\,\\text{d}x & ={\\int }_{-3}^{1}(-x+4)\\,\\text{d}x\\,+\\,{\\int }_{1}^{4}(2x-3)\\,\\text{d}x \\\\  & =(-\\frac{{x}^{2}}{2}+4x){|}_{-3}^{1}+({x}^{2}-3x){|}_{1}^{4} \\\\  & =[\\,-\\frac{{1}^{2}}{2}+4\\cdot 1-(-\\frac{(-3)^{2}}{2}+4(-3))]+\\,[{4}^{2}-3\\cdot 4-({1}^{2}-3\\cdot 1)] \\\\  & =[-\\frac{1}{2}+4-(-\\frac{9}{2}-12)]+[16-12-(1-3)] \\\\  & =[\\frac{7}{2}-(-\\frac{33}{2})]+6 \\\\  & =\\frac{40}{2}+6 \\\\  & =20+6 \\\\  & =26.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317196 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a34cf8c-f9f9-5082-8ee4-5a43a6a7eef9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186315543}] :answer-field/correct {:answer/id #uuid "4a34cf8c-f9f9-5082-8ee4-5a43a6a7eef9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186315543} :answer-field/id #uuid "bc25a7bd-5f8b-5142-bd15-2ca2aaac680c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316990}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0c8d2b0d-3143-5cce-8ab8-84982116a634" :question/math-academy-id "q-342011" :question/problem "The function $f(x)$ is defined as\n\n$$\nf(x)={\\begin{aligned}{x}^{2}, & x<1, \\\\ -2x+3, & x\\ge 1.\\end{aligned}\n$$\n\nThen,\n\n${\\int }_{-1}^{3}f(x)\\,\\text{d}x=$\n{{field-1}}." :question/worked-solution "By the additive property of the definite integral, we have\n\n$$\n\\begin{aligned}{\\int }_{-1}^{3}f(x)\\,\\text{d}x & ={\\int }_{-1}^{1}{x}^{2}\\,\\text{d}x\\,+\\,{\\int }_{1}^{3}(-2x+3)\\,\\text{d}x \\\\  & =(\\frac{{x}^{3}}{3}){|}_{-1}^{1}\\,+\\,(-{x}^{2}+3x){|}_{1}^{3} \\\\  & =[\\frac{1}{3}(1)^{3}-(\\frac{1}{3}(-1)^{3})]\\,+\\,[-{3}^{2}+3(3)-(-{1}^{2}+3(1))] \\\\  & =[\\frac{1}{3}-(-\\frac{1}{3})]\\,+\\,[0-2] \\\\  & =\\frac{2}{3}-2 \\\\  & =-\\frac{4}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317200 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "318eb2a8-8c99-528a-b650-3ef675903063" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}x+\\frac{3}{2}" :db/id #edb/ref 17592186315404}] :answer-field/correct {:answer/id #uuid "318eb2a8-8c99-528a-b650-3ef675903063" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}x+\\frac{3}{2}" :db/id #edb/ref 17592186315404} :answer-field/id #uuid "22d4f768-7f1c-5457-b769-1e7a1c0d47c9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316628}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "36c42cd0-1bd6-5da5-bcdd-62163c6c7278" :question/math-academy-id "q-342049" :question/problem "Given a curve $x=2y-\\frac{6}{y},$ what is the equation of the tangent to the curve at the point $(4,3)?$\n\n$y=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(2y-\\frac{6}{y}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(2y-6{y}^{-1}) \\\\  & =2\\frac{\\text{d}}{\\text{d}y}(y)-6\\frac{\\text{d}}{\\text{d}y}({y}^{-1}) \\\\  & =2(1)-6(-{y}^{-2}) \\\\  & =2+6{y}^{-2} \\\\  & =2+\\frac{6}{{y}^{2}} \\\\  & =\\frac{2{y}^{2}+6}{{y}^{2}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{{y}^{2}}{2{y}^{2}+6}.\n$$\n\nThe slope of the tangent to the curve at the point $(4,3)$ is\n\n$$\n\\begin{aligned}m & =\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(4,3)} \\\\  & =\\frac{{3}^{2}}{2(3)^{2}+6} \\\\  & =\\frac{9}{24} \\\\  & =\\frac{3}{8}\\end{aligned}\n$$\n\nUsing the point-slope formula for a tangent line, we get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-3 & =\\frac{3}{8}\\cdot (x-4) \\\\ y & =\\frac{3}{8}x-\\frac{3}{2}+3 \\\\ y & =\\frac{3}{8}x+\\frac{3}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317201 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f682182f-4187-5c58-b891-e436d925ac71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{7}x+\\frac{11}{7}" :db/id #edb/ref 17592186316494}] :answer-field/correct {:answer/id #uuid "f682182f-4187-5c58-b891-e436d925ac71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{7}x+\\frac{11}{7}" :db/id #edb/ref 17592186316494} :answer-field/id #uuid "a8095d7c-7888-58df-bb91-75240c8b1c76" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316937}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "97a8acd9-41d2-5ef2-85c4-307d0b8faeeb" :question/math-academy-id "q-342050" :question/problem "Given a curve $x=-\\frac{5}{y}+{y}^{2},$ what is the equation of the tangent to the curve at the point $(-4,1)?$\n\n$y=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(-\\frac{5}{y}+{y}^{2}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(-5{y}^{-1}+{y}^{2}) \\\\  & =-5\\frac{\\text{d}}{\\text{d}y}({y}^{-1})+\\frac{\\text{d}}{\\text{d}y}({y}^{2}) \\\\  & =-5(-{y}^{-2})+2y \\\\  & =2y+5{y}^{-2} \\\\  & =2y+\\frac{5}{{y}^{2}} \\\\  & =\\frac{2{y}^{3}+5}{{y}^{2}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{{y}^{2}}{2{y}^{3}+5}.\n$$\n\nThe slope of the tangent to the curve at the point $(-4,1)$ is\n\n$$\n\\begin{aligned}m & =\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(-4,1)} \\\\  & =\\frac{{1}^{2}}{2(1)^{3}+5} \\\\  & =\\frac{1}{2+5} \\\\  & =\\frac{1}{7}.\\end{aligned}\n$$\n\nUsing the point-slope formula for a tangent line, we get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =\\frac{1}{7}\\cdot (x-(-4)) \\\\ y & =\\frac{1}{7}x+\\frac{4}{7}+1 \\\\ y & =\\frac{1}{7}x+\\frac{11}{7}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317202 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "048414bf-f733-539d-a4a7-a58005a57223" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x+5" :db/id #edb/ref 17592186315141}] :answer-field/correct {:answer/id #uuid "048414bf-f733-539d-a4a7-a58005a57223" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x+5" :db/id #edb/ref 17592186315141} :answer-field/id #uuid "6a335d03-53e7-5c61-b38b-7609a4dda2b1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316802}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0c69ac0b-f1e2-5b4c-9ce4-6a862192ecf5" :question/math-academy-id "q-342061" :question/problem "Given a curve $x=6\\sqrt{y}-2{y}^{2},$ what is the equation of the tangent to the curve at the point $(4,1)?$\n\n$y=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(6\\sqrt{y}-2{y}^{2}) \\\\  & =6\\frac{\\text{d}}{\\text{d}y}(\\sqrt{y})-2\\frac{\\text{d}}{\\text{d}y}({y}^{2}) \\\\  & =6\\frac{\\text{d}}{\\text{d}y}({y}^{1/2})-2(2y) \\\\  & =6\\cdot \\frac{1}{2}{y}^{-1/2}-4y \\\\  & =3{y}^{-1/2}-4y \\\\  & =\\frac{3}{\\sqrt{y}}-4y \\\\  & =\\frac{3-4y\\sqrt{y}}{\\sqrt{y}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{\\sqrt{y}}{3-4y\\sqrt{y}}.\n$$\n\nThe slope of the tangent to the curve at the point $(4,1)$ is\n\n$$\n\\begin{aligned}m & =\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(4,1)} \\\\  & =\\frac{\\sqrt{1}}{3-4(1)\\sqrt{1}} \\\\  & =\\frac{1}{3-4} \\\\  & =-1.\\end{aligned}\n$$\n\nUsing the point-slope formula for a tangent line, we get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =-(x-4) \\\\ y & =-x+4+1 \\\\ y & =-x+5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317203 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27006cbc-09e8-5b56-9df1-8274709af358" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30.86" :db/id #edb/ref 17592186315339}] :answer-field/correct {:answer/id #uuid "27006cbc-09e8-5b56-9df1-8274709af358" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30.86" :db/id #edb/ref 17592186315339} :answer-field/id #uuid "53c19706-9609-54a6-857b-4d99fd74f3fa" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316741}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "797b642c-be56-5ed2-9827-fad42ffdc274" :question/math-academy-id "q-342070" :question/problem "The data below is taken from the table of values of the cumulative distribution function $Φ(z)$ for the standard normal distribution. Given that $X∼N(4,{\\sigma }^{2})$ is a normal random variable with $P(2<X<6)=0.2812,$ find ${\\sigma }^{2},$ rounded to $2$ decimal places.\n\n| $z$ | $\\,0.05\\,$ | $\\,0.06\\,$ | $\\,0.07\\,$ |\n| --- | --- | --- | --- |\n| $\\,0.3\\,$ | $\\,0.6368\\,$ | $\\,0.6406\\,$ | $\\,0.6443\\,$ |\n| $\\,0.4\\,$ | $\\,0.6736\\,$ | $\\,0.6772\\,$ | $\\,0.6808\\,$ |\n| $\\,0.5\\,$ | $\\,0.7088\\,$ | $\\,0.7123\\,$ | $\\,0.7157\\,$ |\n\n*Hint: Note that the interval $2<X<6$ is symmetric about the mean $\\mu =4.$*\n\n${\\sigma }^{2}≈$\n{{field-1}}" :question/worked-solution "First, we find the cumulative probability using symmetry:\n\n$$\n\\begin{aligned}P(2<X<6) & =0.2812 \\\\ 2P(4<X<6) & =0.2812 \\\\ P(4<X<6) & =0.1406 \\\\ P(X<6)-P(X<4) & =0.1406 \\\\ P(X<6)-0.5 & =0.1406 \\\\ P(X<6) & =0.6406 \\\\ P(X\\le 6) & =0.6406\\end{aligned}\n$$\n\nThen, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(X\\le 6) & =0.6406 \\\\ P(Z\\le \\frac{6-4}{\\sigma }) & =0.6406 \\\\ Φ(\\frac{2}{\\sigma }) & =0.6406 \\\\ \\frac{2}{\\sigma } & ={Φ}^{-1}(0.6406)\\end{aligned}\n$$\n\nAccording to the table, we have\n\n$$\nΦ(0.36)=0.6406\\,⇒\\,{Φ}^{-1}(0.6406)=0.36.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{2}{\\sigma } & =0.36 \\\\ \\sigma  & =\\frac{2}{0.36} \\\\ \\sigma  & ≈5.555\\,56.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{\\sigma }^{2}=(5.555\\,56)^{2}≈30.86\\end{aligned}\n$$\n\nrounded to $2$ decimal places."} {:db/id #edb/ref 17592186317208 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08ca81bd-a843-517f-a7ef-72a2701907bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$u$ does not lie on $Π$" :db/id #edb/ref 17592186315161} {:answer/id #uuid "31e52722-b368-5c85-8ea5-9c73d21f221f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186315408} {:answer/id #uuid "3a3a18e5-9318-5ff6-9f5d-5297ea2e47b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186315452} {:answer/id #uuid "43670fca-c17e-5839-b7bf-2ab9ba603b7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186315509} {:answer/id #uuid "8a0a632c-b0f2-53fa-9828-61b94974deed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186315888}] :answer-field/correct {:answer/id #uuid "43670fca-c17e-5839-b7bf-2ab9ba603b7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186315509} :answer-field/id #uuid "ed15606e-311e-585d-8930-70b904dd77b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186317109}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "725d2e8b-44d5-5b25-872e-7c29b876b698" :question/math-academy-id "q-34212" :question/problem "Determine if the vector $u$ lies on the plane $Π:r=sb+tc,$ $t,s\\in R$, where  $b=⟨1,7,-3⟩$, $c=⟨-8,10,-4⟩$, and  $u=⟨6,9,-4⟩.$ In the affirmative case, find the value of $s\\cdot t$ from the decomposition $u=sb+tc.$" :question/worked-solution "By definition, $u\\in Π$ if there exist $t$ and $s$ such that\n\n$$\n\\begin{aligned}sb+tc & =u \\\\ s\\begin{bmatrix}1 \\\\ 7 \\\\ -3\\end{bmatrix}+t\\begin{bmatrix}-8 \\\\ 10 \\\\ -4\\end{bmatrix} & =\\begin{bmatrix}6 \\\\ 9 \\\\ -4\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}s-8t &=6 \\\\ 7s+10t &=9 \\\\ -3s-4t &=-4\\end{aligned}\\right.\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}1 & -8 & 6 \\\\ 7 & 10 & 9 \\\\ -3 & -4 & -4\\end{bmatrix} & {R}_{2} & :={R}_{2}-7{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -8 & 6 \\\\ 0 & 66 & -33 \\\\ -3 & -4 & -4\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -8 & 6 \\\\ 0 & 66 & -33 \\\\ 0 & -28 & 14\\end{bmatrix} & {R}_{2} & :=\\frac{1}{66}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -8 & 6 \\\\ 0 & 1 & -\\frac{1}{2} \\\\ 0 & -28 & 14\\end{bmatrix} & {R}_{3} & :={R}_{3}+28{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -8 & 6 \\\\ 0 & 1 & -\\frac{1}{2} \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\left\\{\\begin{aligned}s-8t &=6 \\\\ t &=-\\frac{1}{2} \\\\ 0 &=0.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get\n\n$$\nt=-\\frac{1}{2}.\n$$\n\nSubstituting into the first equation, we get\n\n$$\n\\begin{aligned}s-8t & =6 \\\\ s-8(-\\frac{1}{2}) & =6 \\\\ s+4 & =6 \\\\ s & =2.\\end{aligned}\n$$\n\nSince we found a solution $s=2,\\,t=-\\frac{1}{2},$ we conclude that $u$ does indeed lie on the plane $Π.$ In fact, we have\n\n$$\nu=2b-\\frac{1}{2}c.\n$$\n\nFinally, $s\\cdot t=2\\cdot (-\\frac{1}{2})=-1.$"} {:db/id #edb/ref 17592186317209 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c738e013-6bee-5d20-8165-9462e1d14672" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186316244}] :answer-field/correct {:answer/id #uuid "c738e013-6bee-5d20-8165-9462e1d14672" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186316244} :answer-field/id #uuid "5ed24aab-6168-55f7-a286-25334a5d7c7b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316769}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "13ea0f25-f277-59ff-83e7-dfd6094636f5" :question/math-academy-id "q-342128" :question/problem "If $f(x)$ is continuous at $x=-\\frac{3}{5}$ and ${lim}_{x\\to {(-3/5)}^{-}}f(x)=7,$ then\n\n$f(-\\frac{3}{5})=$\n{{field-1}}." :question/worked-solution "We're told that $f(x)$ is continuous at $x=-\\frac{3}{5}.$ According to the definition of continuity, this means that ${lim}_{x\\to (-3/5)}f(x)$ exists, and\n\n$$\nf(-\\frac{3}{5})={lim}_{x\\to (-3/5)}f(x)={lim}_{x\\to {(-3/5)}^{-}}f(x)=7.\n$$"} {:db/id #edb/ref 17592186317210 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67ba581c-ebc6-55ea-99ee-e980b997d941" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186315698}] :answer-field/correct {:answer/id #uuid "67ba581c-ebc6-55ea-99ee-e980b997d941" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186315698} :answer-field/id #uuid "fea3ff45-b371-5b5e-8ab3-a1c221cf4178" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317154}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2cc6d36c-e26a-5fcd-bcb0-d88e0fe39c17" :question/math-academy-id "q-342153" :question/problem "Find the slope ${m}^{′}$ of the normal line to the curve $y=4-\\frac{1}{\\sqrt{x}}$ at the point $(\\frac{1}{4},2).$\n\n${m}^{′}=$\n{{field-1}}" :question/worked-solution "Let $f(x)=4-\\frac{1}{\\sqrt{x}}.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4-\\frac{1}{\\sqrt{x}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4-{x}^{-1/2}) \\\\  & =\\frac{1}{2\\sqrt{{x}^{3}}}.\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(\\frac{1}{4},2):$\n\n$$\nm={f}^{′}(\\frac{1}{4})=\\frac{1}{2\\sqrt{{x}^{3}}}=\\frac{1}{2\\sqrt{{(\\frac{1}{4})}^{3}}}=4\n$$\n\nTherefore, the slope ${m}^{′}$ of the normal line is\n\n$$\n\\begin{aligned}{m}^{′} & =-\\frac{1}{m} \\\\  & =-\\frac{1}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317214 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4eaf6866-59c7-5bcf-85b0-5e039d9cf80c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186315568}] :answer-field/correct {:answer/id #uuid "4eaf6866-59c7-5bcf-85b0-5e039d9cf80c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186315568} :answer-field/id #uuid "7ee849c8-86a4-5fad-acfb-56e96048a591" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316847} {:answer-field/choices [{:answer/id #uuid "901ca621-ed5f-5750-a913-063b18972900" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186315924}] :answer-field/correct {:answer/id #uuid "901ca621-ed5f-5750-a913-063b18972900" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186315924} :answer-field/id #uuid "b8a60e86-2a15-5a46-a72a-b8277699810a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316981}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "773759d8-9f76-5cef-8ffc-9fa90fd16743" :question/math-academy-id "q-342190" :question/problem "Find the equation of the normal line to the curve $y=\\frac{3}{2}\\sqrt[3]{x}$ at the point $(\\frac{1}{8},\\frac{3}{4}).$\n\n$8x\\,+$\n{{field-1}}$\\cdot \\,y\\,=$\n{{field-2}}" :question/worked-solution "Let $f(x)=\\frac{3}{2}\\sqrt[3]{x}.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{3}{2}\\sqrt[3]{x}) \\\\  & =\\frac{3}{2}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{1/3}) \\\\  & =\\frac{3}{2}\\cdot \\frac{1}{3}{x}^{-2/3} \\\\  & =\\frac{1}{2\\sqrt[3]{{x}^{2}}}\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(\\frac{1}{8},\\frac{3}{4}):$\n\n$$\nm={f}^{′}(\\frac{1}{8})=\\frac{1}{2\\sqrt[3]{{(\\frac{1}{8})}^{2}}}=2\n$$\n\nTherefore, the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{2}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-\\frac{3}{4} & =-\\frac{1}{2}(x-\\frac{1}{8}) \\\\ 16(y-\\frac{3}{4}) & =16\\cdot (-\\frac{1}{2})\\cdot (x-\\frac{1}{8}) \\\\ 16y-12 & =-8(x-\\frac{1}{8}) \\\\ 16y-12 & =-8x+1 \\\\ 8x+16\\cdot y & =13.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317220 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a6cd6b9-4e67-5504-9140-fbe9d5bb23d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-1/3}" :db/id #edb/ref 17592186315172}] :answer-field/correct {:answer/id #uuid "0a6cd6b9-4e67-5504-9140-fbe9d5bb23d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-1/3}" :db/id #edb/ref 17592186315172} :answer-field/id #uuid "bd530afa-c96d-58b5-8944-e683aab076a1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316991}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "870bd804-7c6c-5b8b-aa71-4f5256e17cea" :question/math-academy-id "q-342227" :question/problem "Evaluate $\\operatorname{cosh}⁡(\\frac{1}{3}).$ **Do not round** your answer.\n\n$\\operatorname{cosh}⁡(\\frac{1}{3})=\\frac{1}{2}({e}^{1/3}\\,+$ {{field-1}} $)$" :question/worked-solution "The definition of $\\operatorname{cosh}⁡x$ is\n\n$$\n\\operatorname{cosh}⁡x=\\frac{1}{2}({e}^{x}+{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡(\\frac{1}{3}) & =\\frac{1}{2}({e}^{1/3}+{e}^{-1/3}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317221 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70ae7c16-f617-5a07-9a94-06290a107038" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5/3" :db/id #edb/ref 17592186315753}] :answer-field/correct {:answer/id #uuid "70ae7c16-f617-5a07-9a94-06290a107038" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5/3" :db/id #edb/ref 17592186315753} :answer-field/id #uuid "b8fd179b-7b70-514b-b12d-26baef9b2e24" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316984}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4233b404-fc80-58bf-a431-9b66af37156a" :question/math-academy-id "q-342231" :question/problem "Evaluate $\\operatorname{cosh}⁡(\\operatorname{ln}⁡(1/3)).$ **Do not round** your answer.\n\n$\\operatorname{cosh}⁡(\\operatorname{ln}⁡(1/3))=$\n{{field-1}}" :question/worked-solution "The definition of $\\operatorname{cosh}⁡x$ is\n\n$$\n\\operatorname{cosh}⁡x=\\frac{1}{2}({e}^{x}+{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡(\\operatorname{ln}⁡(1/3)) & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡(1/3)}+{e}^{-\\operatorname{ln}⁡(1/3)}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡(1/3)}+{e}^{\\operatorname{ln}⁡(3)}) \\\\  & =\\frac{1}{2}(\\frac{1}{3}+3) \\\\  & =\\frac{1}{2}(\\frac{1+9}{3}) \\\\  & =\\frac{10}{6} \\\\  & =\\frac{5}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317239 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d997c12d-a03b-5296-a830-6db4be672df6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186316331}] :answer-field/correct {:answer/id #uuid "d997c12d-a03b-5296-a830-6db4be672df6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186316331} :answer-field/id #uuid "1f9fad05-4c08-5c4b-bf58-5859bb52824f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316620}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "45bf2a7e-b636-5c97-90c2-25563ca38da6" :question/math-academy-id "q-342311" :question/problem "Find the slope $m$ of the tangent at the point $(1,1)$ for the curve $2{y}^{3}+{x}^{2}{y}^{2}-{x}^{3}=2.$\n\n$m=$\n{{field-1}}" :question/worked-solution "To find the slope at a point, we use implicit differentiation to calculate the derivative of the curve, assuming that $y=y(x).$\n\nNote that to differentiate the ${x}^{2}{y}^{2}$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}2{y}^{3}+{x}^{2}{y}^{2}-{x}^{3} & =2 \\\\ \\frac{\\text{d}}{\\text{d}x}(2{y}^{3}+{x}^{2}{y}^{2}-{x}^{3}) & =\\frac{\\text{d}}{\\text{d}x}(2) \\\\ \\frac{\\text{d}}{\\text{d}x}(2{y}^{3})+\\frac{\\text{d}}{\\text{d}x}({x}^{2}{y}^{2})-\\frac{\\text{d}}{\\text{d}x}({x}^{3}) & =\\frac{\\text{d}}{\\text{d}x}(2) \\\\ 6{y}^{2}\\frac{\\text{d}y}{\\text{d}x}+[2x{y}^{2}+2{x}^{2}y\\frac{\\text{d}y}{\\text{d}x}]-3{x}^{2} & =0 \\\\ 6{y}^{2}\\frac{\\text{d}y}{\\text{d}x}+2x{y}^{2}+2{x}^{2}y\\frac{\\text{d}y}{\\text{d}x}-3{x}^{2} & =0 \\\\ (6{y}^{2}+2{x}^{2}y)\\frac{\\text{d}y}{\\text{d}x} & =3{x}^{2}-2x{y}^{2} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{3{x}^{2}-2x{y}^{2}}{6{y}^{2}+2{x}^{2}y}\\end{aligned}\n$$\n\nThe slope of the tangent at the point $(1,1)$ is then given by\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{(1,1)} \\\\  & ={(\\frac{3{x}^{2}-2x{y}^{2}}{6{y}^{2}+2{x}^{2}y})|}_{(1,1)} \\\\  & =\\frac{3(1)^{2}-2(1)(1)^{2}}{6(1)^{2}+2(1)^{2}(1)} \\\\  & =\\frac{1}{8}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317240 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39c48093-236c-529a-a8a5-bc47c821574a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186315450}] :answer-field/correct {:answer/id #uuid "39c48093-236c-529a-a8a5-bc47c821574a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186315450} :answer-field/id #uuid "0833a293-5ce1-5cef-ab4d-f3003c06003a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316569} {:answer-field/choices [{:answer/id #uuid "d876ff73-6c82-5b9c-ae49-36253a7b0032" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186316325}] :answer-field/correct {:answer/id #uuid "d876ff73-6c82-5b9c-ae49-36253a7b0032" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186316325} :answer-field/id #uuid "92c6806c-bbda-5418-b219-934b1a0e61f8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316882}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9e44cd61-adda-5320-9484-a3532ad9dce1" :question/math-academy-id "q-342321" :question/problem "The equation of a curve is ${x}^{2}+xy=6{y}^{2}.$ The normal line at the point $(2,1)$ intersects the $y$-axis at the point $P.$ What are the coordinates of $P?$\n\nThe coordinates of $P$ are $($\n{{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "First of all, we need to find the slope of the normal line at the point $(2,1).$ Remember that the slope of the normal line, ${m}^{′},$ is the negative reciprocal of the slope of the tangent line:\n\n$$\n{m}^{′}=-\\frac{1}{m}\n$$\n\nTo find the slope of the tangent line, we will calculate the derivative using implicit differentiation, assuming that $y=y(x).$\n\nNote that to differentiate the $xy$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}{x}^{2}+xy & =6{y}^{2} \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2}+xy) & =\\frac{\\text{d}}{\\text{d}x}(6{y}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}(xy) & =\\frac{\\text{d}}{\\text{d}x}(6{y}^{2}) \\\\ 2x+(y+x\\frac{\\text{d}y}{\\text{d}x}) & =12y\\frac{\\text{d}y}{\\text{d}x} \\\\ 2x+y+x\\frac{\\text{d}y}{\\text{d}x} & =12y\\frac{\\text{d}y}{\\text{d}x} \\\\ x\\frac{\\text{d}y}{\\text{d}x}-12y\\frac{\\text{d}y}{\\text{d}x} & =-2x-y \\\\ (x-12y)\\frac{\\text{d}y}{\\text{d}x} & =-2x-y \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{-2x-y}{x-12y}.\\end{aligned}\n$$\n\nSo, the slope of the tangent at the point $(2,1)$ is \n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{(2,\\,1)} \\\\  & ={(\\frac{-2x-y}{x-12y})|}_{(2,\\,1)} \\\\  & =\\frac{-2(2)-1}{2-12(1)} \\\\  & =\\frac{(-5)}{(-10)} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{(\\frac{1}{2})}=-2.\n$$\n\nWe can write the equation of the normal at the point $(2,1)$ as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & ={m}^{′}(x-{x}_{1}) \\\\ y-1 & =-2(x-2) \\\\ y-1 & =-2x+4 \\\\ y & =-2x+5\\end{aligned}\n$$\n\nNow, we just need to find where this normal line intersects the $y$-axis. At the point $P$ the $x$-coordinate is $0,$ so we set $x=0$ and solve for $y:$\n\n$$\n\\begin{aligned}y & =-2x+5 \\\\ y & =-2(0)+5 \\\\ y & =5\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(0,\\,5).$"} {:db/id #edb/ref 17592186317241 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27bf30c6-e7c4-5ec3-b883-0faeb6a3eb5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186315343}] :answer-field/correct {:answer/id #uuid "27bf30c6-e7c4-5ec3-b883-0faeb6a3eb5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186315343} :answer-field/id #uuid "552e72d4-92af-586a-ab5f-e83510ccaf06" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316744} {:answer-field/choices [{:answer/id #uuid "8f248050-bc2a-5707-92f0-c9a6e0f9c621" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186315920}] :answer-field/correct {:answer/id #uuid "8f248050-bc2a-5707-92f0-c9a6e0f9c621" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186315920} :answer-field/id #uuid "65e5fed4-d7ce-583b-afc4-57ba2adaf642" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316789}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cb9cd239-2bce-5b80-bfae-5a75f2ef2946" :question/math-academy-id "q-342325" :question/problem "The equation of a curve is $4{x}^{2}+9{y}^{2}=36.$ The tangent line at the point $(0,2)$ intersects the $y$-axis at the point $P.$ What are the coordinates of $P?$\n\nThe coordinates of $P$ are $($\n{{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "First of all, we need to find the slope of the tangent line at the point $(0,2).$ \n\nTo find the slope of the tangent line, we will calculate the derivative using implicit differentiation, assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(4{x}^{2}+9{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(36) \\\\ \\frac{\\text{d}}{\\text{d}x}(4{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(9{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(36) \\\\ 8x+18y\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 18y\\frac{\\text{d}y}{\\text{d}x} & =-8x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{8x}{18y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{4x}{9y}.\\end{aligned}\n$$\n\nSo, the slope of the tangent at the point $(0,2)$ is \n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{(0,\\,2)} \\\\  & ={(-\\frac{4x}{9y})|}_{(0,\\,2)} \\\\  & =-\\frac{4\\cdot 0}{9\\cdot 2} \\\\  & =0.\\end{aligned}\n$$\n\nWe can write the equation of the tangent line at the point $(0,2)$ as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-2 & =0(x-0) \\\\ y & =2\\end{aligned}\n$$\n\nNow, we just need to find where this tangent line intersects the $y$-axis. At the point $P$ the $x$-coordinate is $0,$ so we set $x=0$ and solve for $y:$\n\n$$\n\\begin{aligned}y & =2\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are\n\n$$\n(0,\\,2).\n$$"} {:db/id #edb/ref 17592186317248 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03c73c66-958f-5ae6-bd8a-99db605e90d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186315139}] :answer-field/correct {:answer/id #uuid "03c73c66-958f-5ae6-bd8a-99db605e90d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186315139} :answer-field/id #uuid "4184994e-4d69-5dc7-a131-80a1fe4b7e91" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316695} {:answer-field/choices [{:answer/id #uuid "008c957b-5932-51e6-82e7-283ff77f4652" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186315116}] :answer-field/correct {:answer/id #uuid "008c957b-5932-51e6-82e7-283ff77f4652" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186315116} :answer-field/id #uuid "dc33ff76-870c-56b9-8d86-2109f98f6537" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317070}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c5c6413c-46e6-5a5d-8df1-b86b59abbe4b" :question/math-academy-id "q-342377" :question/problem "Find where the tangent to the curve $y=\\frac{2}{x}+x$ at the point  $(2,3)$ intersects the $y$-axis.\n\nThe tangent intersects the $y$-axis at\n$($\n{{field-1}}$,$\n{{field-2}} $).$" :question/worked-solution "Let $f(x)=\\frac{2}{x}+x.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{x}+x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{x})+\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{-1})+\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =-2{x}^{-2}+1 \\\\  & =-\\frac{2}{{x}^{2}}+1.\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\n\\begin{aligned}m & ={f}^{′}(2) \\\\  & =-\\frac{2}{{2}^{2}}+1 \\\\  & =-\\frac{2}{4}+1 \\\\  & =-\\frac{1}{2}+1 \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-3 & =\\frac{1}{2}(x-2) \\\\ y & =\\frac{1}{2}x-1+3 \\\\ y & =\\frac{1}{2}x+2.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $y$-axis, we set $x=0$ and solve:\n\n$$\n\\begin{aligned}y & =\\frac{1}{2}(0)+2 \\\\ y & =2.\\end{aligned}\n$$\n\nTherefore, the point of intersection is $(0,2).$"} {:db/id #edb/ref 17592186317252 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e56bbcef-ca3b-59ed-ad87-9a69dc545ec6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186316388}] :answer-field/correct {:answer/id #uuid "e56bbcef-ca3b-59ed-ad87-9a69dc545ec6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186316388} :answer-field/id #uuid "b45e5e3a-6e0c-55e2-aa5c-80a5a35d6947" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316967} {:answer-field/choices [{:answer/id #uuid "53516b05-10ad-5e8a-b3c5-ada063505bf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186315595}] :answer-field/correct {:answer/id #uuid "53516b05-10ad-5e8a-b3c5-ada063505bf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186315595} :answer-field/id #uuid "eeb1fb59-755b-5372-84ae-0e78b8fd575f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317113}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fd3747ed-3ded-5af6-bc1a-40c4627f070b" :question/math-academy-id "q-342381" :question/problem "Find where the tangent to the curve $y=\\sqrt{x}+\\frac{6}{\\sqrt{x}}$ at the point  $(4,5)$ intersects the $y$-axis.\n\nThe tangent intersects the $y$-axis at\n$($\n{{field-1}}$,$\n{{field-2}} $).$" :question/worked-solution "Let $f(x)=\\sqrt{x}+\\frac{6}{\\sqrt{x}}.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}+\\frac{6}{\\sqrt{x}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})+6\\cdot \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{\\sqrt{x}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{1/2})+6\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{-1/2}) \\\\  & =\\frac{1}{2}{x}^{-1/2}+6\\cdot (-\\frac{1}{2}){x}^{-3/2} \\\\  & =\\frac{1}{2\\sqrt{x}}-\\frac{3}{\\sqrt{{x}^{3}}}.\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\n\\begin{aligned}m & ={f}^{′}(4) \\\\  & =\\frac{1}{2\\sqrt{4}}-\\frac{3}{\\sqrt{{4}^{3}}} \\\\  & =\\frac{1}{4}-\\frac{3}{8} \\\\  & =-\\frac{1}{8}.\\end{aligned}\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-5 & =-\\frac{1}{8}(x-4) \\\\ y & =-\\frac{1}{8}x+\\frac{1}{2}+5 \\\\ y & =-\\frac{1}{8}x+\\frac{11}{2}.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $y$-axis, we set $x=0$ and solve:\n\n$$\n\\begin{aligned}y & =-\\frac{1}{8}(0)+\\frac{11}{2} \\\\ y & =\\frac{11}{2}.\\end{aligned}\n$$\n\nTherefore, the point of intersection is $(0,\\frac{11}{2}).$"} {:db/id #edb/ref 17592186317254 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f5c20d41-435d-55d0-a172-c27f052bf5db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186316491}] :answer-field/correct {:answer/id #uuid "f5c20d41-435d-55d0-a172-c27f052bf5db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186316491} :answer-field/id #uuid "10d2e3ee-4d35-53d9-b4e2-090c4fa16f8a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316587} {:answer-field/choices [{:answer/id #uuid "1e056870-a5ab-500f-9df4-56cffb9cced3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186315292}] :answer-field/correct {:answer/id #uuid "1e056870-a5ab-500f-9df4-56cffb9cced3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186315292} :answer-field/id #uuid "48675c26-937f-5a4a-9678-5bc409152df1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316714}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "019eae01-b09f-5893-aaf7-0f3dd1c87dc4" :question/math-academy-id "q-342401" :question/problem "![](images/0c/0c89b1d28ce7692f54e0fbf32c1d99b091e24729c837883523d6150450decb17.png)\n\nThe equation $4{x}^{2}+{y}^{2}=20x$ represents an ellipse. The tangent line at the point $(4,4)$ on the ellipse intersects the $y$-axis at the point $P.$ What are the coordinates of $P?$\n\nThe coordinates of $P$ are $(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "First of all, we need to find the slope of the tangent line at the point $(4,4).$\n\nTo find the slope of the tangent line, we will calculate the derivative using implicit differentiation, assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(4{x}^{2}+{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(20x) \\\\ \\frac{\\text{d}}{\\text{d}x}(4{x}^{2})+\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(20x) \\\\ 8x+2y\\frac{\\text{d}y}{\\text{d}x} & =20 \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =20-8x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{20-8x}{2y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{10-4x}{y}.\\end{aligned}\n$$\n\nSo, the slope of the tangent at the point $(4,4)$ is\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{(4,\\,4)} \\\\  & ={(\\frac{10-4x}{y})|}_{(4,\\,4)} \\\\  & =\\frac{10-4\\cdot 4}{4} \\\\  & =\\frac{(-6)}{4} \\\\  & =-\\frac{3}{2}.\\end{aligned}\n$$\n\nWe can write the equation of the tangent at the point $(4,4)$ as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-4 & =-\\frac{3}{2}(x-4) \\\\ y & =-\\frac{3}{2}(x-4)+4 \\\\ y & =-\\frac{3}{2}x+10\\end{aligned}\n$$\n\nNow, we just need to find where this tangent line intersects the $y$-axis. At the point $P$ the $x$-coordinate is $0,$ so we set $x=0$ and solve for $y:$\n\n$$\n\\begin{aligned}y & =-\\frac{3}{2}x+10 \\\\ y & =-\\frac{3}{2}\\cdot 0+10 \\\\ y & =10\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(0,\\,10).$"} {:db/id #edb/ref 17592186317269 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a105631-7725-55bd-a788-28458095beef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Y(s)=\\frac{s}{{s}^{2}+9}" :db/id #edb/ref 17592186315167} {:answer/id #uuid "23fb930a-cd0d-58f2-bad1-6bffd01902be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Y(s)=\\frac{s-9}{{s}^{2}-9}" :db/id #edb/ref 17592186315320} {:answer/id #uuid "7413f44e-bca8-5be1-8890-6ccc3c560177" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Y(s)=\\frac{s+9}{{s}^{2}-9}" :db/id #edb/ref 17592186315776} {:answer/id #uuid "cfc30f21-6b92-5dbd-af22-5cb601aabe7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Y(s)=\\frac{s}{{s}^{2}-9}" :db/id #edb/ref 17592186316292} {:answer/id #uuid "fb024e5a-2fd7-521d-9eeb-03794f7bc18d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Y(s)=\\frac{s-9}{{s}^{2}+9}" :db/id #edb/ref 17592186316524}] :answer-field/correct {:answer/id #uuid "23fb930a-cd0d-58f2-bad1-6bffd01902be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Y(s)=\\frac{s-9}{{s}^{2}-9}" :db/id #edb/ref 17592186315320} :answer-field/id #uuid "0285f9d4-122f-5f0a-b43a-f5979bd4b202" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186316553}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "975ef431-15ea-578a-acac-078a5e05d498" :question/math-academy-id "q-342473" :question/problem "Find the Laplace transform $Y(s)=L{y(t)}$ for $s>3$ if \n\n$$\n{y}^{′}+y=-8\\operatorname{cosh}⁡3t,\\,y(0)=1.\n$$\n\nYou may make use of the following result:\n\n$$\nL{\\operatorname{cosh}⁡\\omega t}=\\frac{s}{{s}^{2}-{\\omega }^{2}},\\,s>|\\omega |.\n$$" :question/worked-solution "First, we take the Laplace transform of both sides and use the addition and scalar multiplication properties of the Laplace transform:\n\n$$\n\\begin{aligned}L{{y}^{′}+y} & =L{-8\\operatorname{cosh}⁡3t} \\\\ L{{y}^{′}}+L{y} & =-8L{\\operatorname{cosh}⁡3t}\\end{aligned}\n$$\n\nTo calculate $L{{y}^{′}},$ we use the formula for the Laplace transform of a derivative and the initial condition $y(0)=1:$\n\n$$\nL{{y}^{′}}=sL{y}-y(0)=sY(s)-1\n$$\n\nFrom the table of Laplace transforms, we have the following result:\n\n$$\nL{\\operatorname{cosh}⁡3t}=\\frac{s}{{s}^{2}-9},\\,s>3\n$$\n\nTherefore, we can solve for $Y(s):$\n\n$$\n\\begin{aligned}L{{y}^{′}}+L{y} & =-8L{\\operatorname{cosh}⁡3t} \\\\ (sY(s)-1)+Y(s) & =-8(\\frac{s}{{s}^{2}-9}) \\\\ sY(s)+Y(s) & =1-\\frac{8s}{{s}^{2}-9} \\\\ (s+1)Y(s) & =\\frac{{s}^{2}-8s-9}{{s}^{2}-9} \\\\ Y(s) & =\\frac{{s}^{2}-8s-9}{({s}^{2}-9)(s+1)}\\end{aligned}\n$$\n\nSince $s>3,$ we simplify as follows:\n\n$$\n\\begin{aligned}Y(s) & =\\frac{({s}^{2}-8s-9)}{({s}^{2}-9)(s+1)} \\\\ Y(s) & =\\frac{(s-9)(s+1)}{({s}^{2}-9)(s+1)} \\\\ Y(s) & =\\frac{s-9}{{s}^{2}-9}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317273 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41c91537-c8bb-5ae8-9883-50855ca49ca9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186315501}] :answer-field/correct {:answer/id #uuid "41c91537-c8bb-5ae8-9883-50855ca49ca9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186315501} :answer-field/id #uuid "6989c637-7d71-59ab-9be9-dd8aee348fa6" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316801} {:answer-field/choices [{:answer/id #uuid "0a6fd9cb-d9e4-58c5-a9db-de33ef15e528" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186315173}] :answer-field/correct {:answer/id #uuid "0a6fd9cb-d9e4-58c5-a9db-de33ef15e528" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186315173} :answer-field/id #uuid "f0bb43d8-6e16-595b-a856-77cccca933a9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317121}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "96578920-5978-5ccd-b815-b15c23dd1fbe" :question/math-academy-id "q-342526" :question/problem "![](images/d9/d997ec4e099fc8be5b34a51bdfd0e9511915c348671d9832ed640f0ec4360602.png)\n\nThe equation $4{x}^{2}+{y}^{2}=15y$ represents an ellipse. The normal line at the point $(3,3)$ on the ellipse intersects the $x$-axis at the point $P.$ What are the coordinates of $P?$\n\nThe coordinates of $P$ are $($\n{{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "First of all, we need to find the slope of the normal line at the point $(3,3).$ Remember that the slope of the normal line, ${m}^{′},$ is the negative reciprocal of the slope of the tangent line:\n\n$$\n{m}^{′}=-\\frac{1}{m}\n$$\n\nTo find the slope of the tangent line, we will calculate the derivative using implicit differentiation, assuming that $y=y(x).$\n\n$$\n\\begin{aligned}4{x}^{2}+{y}^{2} & =15y \\\\ \\frac{\\text{d}}{\\text{d}x}(4{x}^{2}+{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(15y) \\\\ \\frac{\\text{d}}{\\text{d}x}(4{x}^{2})+\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(15y) \\\\ 8x+2y\\frac{\\text{d}y}{\\text{d}x} & =15\\frac{\\text{d}y}{\\text{d}x} \\\\ 2y\\frac{\\text{d}y}{\\text{d}x}-15\\frac{\\text{d}y}{\\text{d}x} & =-8x \\\\ (2y-15)\\frac{\\text{d}y}{\\text{d}x} & =-8x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{8x}{2y-15}.\\end{aligned}\n$$\n\nSo, the slope of the tangent at the point $(3,3)$ is \n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{(3,\\,3)} \\\\  & ={(-\\frac{8x}{2y-15})|}_{(3,\\,3)} \\\\  & =-\\frac{8\\cdot 3}{2\\cdot 3-15} \\\\  & =-\\frac{24}{(-9)} \\\\  & =\\frac{8}{3}.\\end{aligned}\n$$\n\nTherefore, the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{(\\frac{8}{3})}=-\\frac{3}{8}.\n$$\n\nWe can write the equation of the normal line at the point $(3,3)$ as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & ={m}^{′}(x-{x}_{1}) \\\\ y-3 & =-\\frac{3}{8}(x-3) \\\\ y & =-\\frac{3}{8}x+\\frac{9}{8}+3 \\\\ y & =-\\frac{3}{8}x+\\frac{33}{8}\\end{aligned}\n$$\n\nNow, we just need to find where this normal line intersects the $x$-axis. At the point $P$ the $y$-coordinate is $0,$ so we set $y=0$ and solve for $x:$\n\n$$\n\\begin{aligned}y & =-\\frac{3}{8}x+\\frac{33}{8} \\\\ 0 & =-\\frac{3}{8}x+\\frac{33}{8} \\\\ \\frac{3}{8}x & =\\frac{33}{8} \\\\ x & =11\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(11,\\,0).$"} {:db/id #edb/ref 17592186317278 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a00c97a2-369f-5934-a429-cde334efb537" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}4" :db/id #edb/ref 17592186316019}] :answer-field/correct {:answer/id #uuid "a00c97a2-369f-5934-a429-cde334efb537" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}4" :db/id #edb/ref 17592186316019} :answer-field/id #uuid "e2e0e9f9-0005-5989-bf96-f5af5408d579" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317089}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4c8c7a88-6e10-5793-8076-5cf568ce9f31" :question/math-academy-id "q-342570" :question/problem "![](images/fe/feb02396a635c3f416b07383b03269e12fde738da3345aa6d6d9fe5350745746.png)\n\nThe figure above shows the graph of a function $y=f(x)$ and its inverse $y={f}^{-1}(x).$ The point $A$ has coordinates $(1,0.5)$ and lies on $y=f(x).$ The point $B$ has coordinates $(0.5,1)$ and lies on $y={f}^{-1}(x).$ If ${f}^{′}(1)=\\frac{1}{\\operatorname{ln}⁡4},$ what is $({f}^{-1})^{′}(0.5)?$\n\n$({f}^{-1})^{′}(0.5)=$\n{{field-1}}" :question/worked-solution "Since $B\\,(0.5,1)$ lies on ${f}^{-1},$ we have ${f}^{-1}(0.5)=1.$\nWe're also told that ${f}^{′}(1)=\\frac{1}{\\operatorname{ln}⁡4}.$\n\nThe formula for the derivative of the inverse function is\n\n$$\n({f}^{-1})^{′}(x)=\\frac{1}{{f}^{′}({f}^{-1}(x))}.\n$$\n\nEvaluating at $x=0.5,$ we have\n\n$$\n\\begin{aligned}\\begin{aligned}({f}^{-1})^{′}(0.5) & =\\frac{1}{{f}^{′}({f}^{-1}(0.5))} \\\\  & =\\frac{1}{{f}^{′}(1)} \\\\  & =\\frac{1}{(\\frac{1}{\\operatorname{ln}⁡4})} \\\\  & =\\operatorname{ln}⁡4.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317279 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a727020e-3159-566c-8e8f-8f839a731834" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186316058}] :answer-field/correct {:answer/id #uuid "a727020e-3159-566c-8e8f-8f839a731834" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186316058} :answer-field/id #uuid "d3a0bda9-6dcf-5f78-b6cf-086f16109842" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317047}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f2edf191-9bcb-50c6-bc5b-b3185f8280c9" :question/math-academy-id "q-342575" :question/problem "![](images/ce/ce948d3eade308a90ffa85a7c7a88a8c403a6620ffda7e6d24444d2abac0770c.png)\n\nThe figure above shows the graph of a piecewise linear function $y=f(x).$ The point $A$ has coordinates $(1,1)$ and lies on $y=f(x).$ Given that $(1,1)$ lies on $y={f}^{-1}(x),$ what is $({f}^{-1})^{′}(1)?$\n\n$({f}^{-1})^{′}(1)=$\n{{field-1}}" :question/worked-solution "Since $(1,1)$ lies on ${f}^{-1},$ we have ${f}^{-1}(1)=1.$ \nThe slope of the tangent to $f(x)$ for $x\\in [-2,4]$ is $\\frac{2}{3}$, hence, ${f}^{′}(1)=\\frac{2}{3}.$\n\nThe formula for the derivative of the inverse function is \n\n$$\n({f}^{-1})^{′}(x)=\\frac{1}{{f}^{′}({f}^{-1}(x))}.\n$$\n\nEvaluating at $x=1,$ we have\n\n$$\n\\begin{aligned}({f}^{-1})^{′}(1) & =\\frac{1}{{f}^{′}({f}^{-1}(1))} \\\\  & =\\frac{1}{{f}^{′}(1)} \\\\  & =\\frac{1}{(\\frac{2}{3})} \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317280 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f9f1bd8e-d359-543e-9bb2-44c475608628" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186316513}] :answer-field/correct {:answer/id #uuid "f9f1bd8e-d359-543e-9bb2-44c475608628" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186316513} :answer-field/id #uuid "ef142d2d-869a-505a-98f3-fe810201a4ae" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317114}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "11b19bb2-4705-5a35-a91c-74ec5215102a" :question/math-academy-id "q-342579" :question/problem "Consider the function $f(x)=\\frac{x-1}{{x}^{2}+1}$ and the point $P(1,0)$ that lies on $y=f(x).$ Given that $f(x)$ is invertible in the vicinity of $P,$ calculate ${({f}^{-1})}^{′}(0).$\n\n${({f}^{-1})}^{′}(0)=$\n{{field-1}}" :question/worked-solution "We start by calculating the derivative of $f$ at the point $(1,0).$\n\n$$\n\\begin{aligned}\\begin{aligned}f(x) & =\\frac{x-1}{{x}^{2}+1} \\\\ {f}^{′}(x) & =\\frac{(x-1)^{′}\\cdot ({x}^{2}+1)-(x-1)\\cdot {({x}^{2}+1)}^{′}}{{({x}^{2}+1)}^{2}} \\\\ {f}^{′}(x) & =\\frac{1\\cdot ({x}^{2}+1)-(x-1)\\cdot 2x}{{({x}^{2}+1)}^{2}} \\\\ {f}^{′}(x) & =\\frac{{x}^{2}+1-2{x}^{2}+2x}{{({x}^{2}+1)}^{2}} \\\\ {f}^{′}(x) & =\\frac{1+2x-{x}^{2}}{{({x}^{2}+1)}^{2}} \\\\ {f}^{′}(1) & =\\frac{1+2(1)-{1}^{2}}{{({1}^{2}+1)}^{2}} \\\\ {f}^{′}(1) & =\\frac{1}{2}.\\end{aligned}\\end{aligned}\n$$\n\nSince $(1,0)$ lies on $y=f(x),$ we know that the corresponding point $(0,1)$ lies on $y={f}^{-1}(x).$\n\nFurthermore, the slopes of the tangents to the two respective points are reciprocals. Therefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{({f}^{-1})}^{′}(0) & =\\frac{1}{{f}^{′}({f}^{-1}(0))} \\\\  & =\\frac{1}{{f}^{′}(1)} \\\\  & =\\frac{1}{(\\frac{1}{2})} \\\\  & =2.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317281 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "762e2abf-74fb-5255-bb53-82e92dfc170e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186315784}] :answer-field/correct {:answer/id #uuid "762e2abf-74fb-5255-bb53-82e92dfc170e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186315784} :answer-field/id #uuid "ad89b59f-afba-5515-8b38-e82177928cd7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316954}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "db483005-a4e5-5199-9df5-a86ac78101b5" :question/math-academy-id "q-342580" :question/problem "Consider the function $f(x)=3\\sqrt[3]{x}$ and the point $P(8,6)$ that lies on $y=f(x).$ Given that $f(x)$ is invertible in the vicinity of $P,$ calculate ${({f}^{-1})}^{′}(6).$\n\n${({f}^{-1})}^{′}(6)=$\n{{field-1}}" :question/worked-solution "We start by calculating the derivative of $f$ at the point $(8,6).$\n\n$$\n\\begin{aligned}\\begin{aligned}f(x) & =3\\sqrt[3]{x} \\\\ {f}^{′}(x) & =3\\cdot \\frac{1}{3}{x}^{-2/3} \\\\ {f}^{′}(x) & =\\frac{1}{\\sqrt[3]{{x}^{2}}} \\\\ {f}^{′}(8) & =\\frac{1}{\\sqrt[3]{{8}^{2}}} \\\\ {f}^{′}(8) & =\\frac{1}{4}.\\end{aligned}\\end{aligned}\n$$\n\nSince $(8,6)$ lies on $y=f(x),$ we know that the corresponding point $(6,8)$ lies on $y={f}^{-1}(x).$\n\nFurthermore, the slopes of the tangents to the two respective points are reciprocals. Therefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{({f}^{-1})}^{′}(6) & =\\frac{1}{{f}^{′}({f}^{-1}(6))} \\\\  & =\\frac{1}{{f}^{′}(8)} \\\\  & =\\frac{1}{(\\frac{1}{4})} \\\\  & =4.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317282 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c57e2b0-1ec5-5796-9747-e4ff82bd5581" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186315728}] :answer-field/correct {:answer/id #uuid "6c57e2b0-1ec5-5796-9747-e4ff82bd5581" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186315728} :answer-field/id #uuid "1dec83a8-4b01-531c-af13-d6b73a81f63a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316615}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "26ec795a-8d02-545c-bd63-a40b17a5e053" :question/math-academy-id "q-342581" :question/problem "Consider the function $f(x)=\\frac{1}{2}\\sqrt{x}$ and the point $P(4,1)$ that lies on $y=f(x).$ Given that $f(x)$ is invertible in the vicinity of $P,$ the slope of $y={f}^{-1}(x)$ at the point $(1,4)$ is$\\,${{field-1}}." :question/worked-solution "We start by calculating the derivative of $f$ at the point $(4,1).$\n\n$$\n\\begin{aligned}\\begin{aligned}f(x) & =\\frac{1}{2}\\sqrt{x} \\\\ {f}^{′}(x) & =\\frac{1}{2}\\cdot \\frac{1}{2}{x}^{-1/2} \\\\ {f}^{′}(x) & =\\frac{1}{4\\sqrt{x}} \\\\ {f}^{′}(4) & =\\frac{1}{4\\sqrt{4}} \\\\ {f}^{′}(4) & =\\frac{1}{8}.\\end{aligned}\\end{aligned}\n$$\n\nSince $(4,1)$ lies on $y=f(x),$ we know that the corresponding point $(1,4)$ lies on $y={f}^{-1}(x).$\n\nFurthermore, the slopes of the tangents to the two respective points are reciprocals. Therefore,\n\n$$\n\\begin{aligned}\\begin{aligned}({f}^{-1})^{′}(1) & =\\frac{1}{{f}^{′}({f}^{-1}(1))} \\\\  & =\\frac{1}{{f}^{′}(4)} \\\\  & =\\frac{1}{(\\frac{1}{8})} \\\\  & =8.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317284 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "304a723d-3566-569e-9ca2-d4132ac4e7de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186315390}] :answer-field/correct {:answer/id #uuid "304a723d-3566-569e-9ca2-d4132ac4e7de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186315390} :answer-field/id #uuid "600467cd-e097-59f7-a8a8-7ed056a91dba" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316771}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "92ca3690-4c8c-55b7-be9d-9370a5311a98" :question/math-academy-id "q-342583" :question/problem "Consider the function $f(x)=\\operatorname{tan}⁡x$ and the point $P(\\frac{\\pi }{4},1)$ that lies on $y=f(x).$ Given that $f(x)$ is invertible in the vicinity of $P,$ calculate ${({f}^{-1})}^{′}(1).$\n\n${({f}^{-1})}^{′}(1)=$\n{{field-1}}" :question/worked-solution "We start by calculating the derivative of $f$ at the point $(\\frac{\\pi }{4},1).$\n\n$$\n\\begin{aligned}\\begin{aligned}f(x) & =\\operatorname{tan}⁡x \\\\ {f}^{′}(x) & ={sec}^{2}⁡x \\\\ {f}^{′}(\\frac{\\pi }{4}) & ={sec}^{2}⁡(\\frac{\\pi }{4}) \\\\ {f}^{′}(\\frac{\\pi }{4}) & =2.\\end{aligned}\\end{aligned}\n$$\n\nSince $(\\frac{\\pi }{4},1)$ lies on $y=f(x),$ we know that the corresponding point $(1,\\frac{\\pi }{4})$ lies on $y={f}^{-1}(x).$\n\nFurthermore, the slopes of the tangents to the two respective points are reciprocals. Therefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{({f}^{-1})}^{′}(1) & =\\frac{1}{{f}^{′}({f}^{-1}(1))} \\\\  & =\\frac{1}{{f}^{′}(\\frac{\\pi }{4})} \\\\  & =\\frac{1}{2}.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317285 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35c47875-1ef5-501d-bbee-a417107b5d82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186315433}] :answer-field/correct {:answer/id #uuid "35c47875-1ef5-501d-bbee-a417107b5d82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186315433} :answer-field/id #uuid "a259aaa2-07f9-5836-91da-9db416d5277d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316924}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e562f9e3-80f6-5a8e-be6e-6fda00e93b68" :question/math-academy-id "q-342584" :question/problem "Consider the function $f(x)=\\sqrt{3}\\operatorname{sin}⁡x$ and the point $P(\\frac{\\pi }{6},\\frac{\\sqrt{3}}{2})$ that lies on $y=f(x).$ Given that $f(x)$ is invertible in the vicinity of $P,$ the slope of $y={f}^{-1}(x)$ at the point $(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{6})$ is$\\,${{field-1}}." :question/worked-solution "We start by calculating the derivative of $f$ at the point $(\\frac{\\pi }{6},\\frac{\\sqrt{3}}{2}).$\n\n$$\n\\begin{aligned}f(x) & =\\sqrt{3}\\operatorname{sin}⁡x \\\\ {f}^{′}(x) & =\\sqrt{3}\\operatorname{cos}⁡x \\\\ {f}^{′}(\\frac{\\pi }{6}) & =\\sqrt{3}\\cdot \\operatorname{cos}⁡(\\frac{\\pi }{6}) \\\\ {f}^{′}(\\frac{\\pi }{6}) & =\\sqrt{3}\\cdot \\frac{\\sqrt{3}}{2} \\\\ {f}^{′}(\\frac{\\pi }{6}) & =\\frac{3}{2}.\\end{aligned}\n$$\n\nSince $(\\frac{\\pi }{6},\\frac{\\sqrt{3}}{2})$ lies on $y=f(x),$ we know that the corresponding point $(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{6})$ lies on $y={f}^{-1}(x).$\n\nFurthermore, the slopes of the tangents to the two respective points are reciprocals. Therefore,\n\n$$\n\\begin{aligned}({f}^{-1})^{′}(\\frac{\\sqrt{3}}{2}) & =\\frac{1}{{f}^{′}({f}^{-1}(\\frac{\\sqrt{3}}{2}))} \\\\  & =\\frac{1}{{f}^{′}(\\frac{\\pi }{6})} \\\\  & =\\frac{1}{(\\frac{3}{2})} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317286 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e9a90bf-55c3-5b3a-b048-d5e208f00230" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e" :db/id #edb/ref 17592186315918}] :answer-field/correct {:answer/id #uuid "8e9a90bf-55c3-5b3a-b048-d5e208f00230" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e" :db/id #edb/ref 17592186315918} :answer-field/id #uuid "684cf05e-380d-5c40-a7a4-d95c7fb86fa6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316795}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eddd138b-b8bc-570d-b13d-ca41c49e9e70" :question/math-academy-id "q-342585" :question/problem "Consider the function $f(x)=\\operatorname{ln}⁡x$ and the point $P(e,1)$ that lies on $y=f(x).$ Given that $f(x)$ is invertible in the vicinity of $P,$ calculate ${({f}^{-1})}^{′}(1).$\n\n${({f}^{-1})}^{′}(1)=$\n{{field-1}}" :question/worked-solution "We start by calculating the derivative of $f$ at the point $(e,1).$\n\n$$\n\\begin{aligned}\\begin{aligned}f(x) & =\\operatorname{ln}⁡x \\\\ {f}^{′}(x) & =\\frac{1}{x} \\\\ {f}^{′}(e) & =\\frac{1}{e}.\\end{aligned}\\end{aligned}\n$$\n\nSince $(e,1)$ lies on $y=f(x),$ we know that the corresponding point $(1,e)$ lies on $y={f}^{-1}(x).$\n\nFurthermore, the slopes of the tangents to the two respective points are reciprocals. Therefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{({f}^{-1})}^{′}(1) & =\\frac{1}{{f}^{′}({f}^{-1}(1))} \\\\  & =\\frac{1}{{f}^{′}(e)} \\\\  & =\\frac{1}{(\\frac{1}{e})} \\\\  & =e.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317297 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95c44396-d108-50d0-bb89-36d5ca5f599f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186315948}] :answer-field/correct {:answer/id #uuid "95c44396-d108-50d0-bb89-36d5ca5f599f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186315948} :answer-field/id #uuid "397e650b-1d1d-53d9-b5c6-2b5763406e63" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316681}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7fcade81-b4f1-5d26-9590-daf109d84f11" :question/math-academy-id "q-342621" :question/problem "Consider the function $f(x)=x-\\sqrt{\\frac{x+1}{3}}.$ Given that $y=f(x)$ is invertible throughout its domain $x\\ge 1,$ determine $({f}^{-1})^{′}(1).$\n\n$({f}^{-1})^{′}(1)=$\n{{field-1}}" :question/worked-solution "To determine $({f}^{-1})^{′}(1),$ we use the following formula:\n\n$$\n{({f}^{-1})}^{′}(1)=\\frac{1}{{f}^{′}({f}^{-1}(1))}\n$$\n\nFirst, we calculate the value of ${f}^{-1}(1).$ To do this, we solve the equation ${f}^{-1}(1)=x.$ This gives\n\n$$\n\\begin{aligned}{f}^{-1}(1) & =x \\\\ f(x) & =1 \\\\ x-\\sqrt{\\frac{x+1}{3}} & =1 \\\\ \\sqrt{\\frac{x+1}{3}} & =x-1 \\\\ \\frac{x+1}{3} & =(x-1)^{2} \\\\ \\frac{x+1}{3} & ={x}^{2}-2x+1 \\\\ x+1 & =3({x}^{2}-2x+1) \\\\ x+1 & =3{x}^{2}-6x+3 \\\\ 3{x}^{2}-7x+2 & =0 \\\\ (3x-1)(x-2) & =0 \\\\ x & =\\frac{1}{3},2.\\end{aligned}\n$$\n\nSince the domain of $y=f(x)$ is $x\\ge 1,$ we have ${f}^{-1}(1)=2.$\n\nNow, we calculate ${f}^{′}(2),$ as follows:\n\n$$\n\\begin{aligned}f(x) & =x-\\sqrt{\\frac{x+1}{3}} \\\\ {f}^{′}(x) & =1-\\frac{1}{6\\sqrt{\\frac{x+1}{3}}} \\\\ {f}^{′}(2) & =1-\\frac{1}{6\\sqrt{\\frac{2+1}{3}}} \\\\ {f}^{′}(2) & =1-\\frac{1}{6\\sqrt{1}} \\\\ {f}^{′}(2) & =1-\\frac{1}{6} \\\\ {f}^{′}(2) & =\\frac{5}{6}\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}{({f}^{-1})}^{′}(1) & =\\frac{1}{{f}^{′}({f}^{-1}(1))} \\\\  & =\\frac{1}{{f}^{′}(2)} \\\\  & =\\frac{1}{(\\frac{5}{6})} \\\\  & =\\frac{6}{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317309 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6b5406d-acd5-51c1-8745-326ce80fe10a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-{e}^{3/2}" :db/id #edb/ref 17592186316155}] :answer-field/correct {:answer/id #uuid "b6b5406d-acd5-51c1-8745-326ce80fe10a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-{e}^{3/2}" :db/id #edb/ref 17592186316155} :answer-field/id #uuid "2c9a78dd-230f-5f69-9893-aad5634f6a67" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316649}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "04f9767b-c101-53fd-a28d-9a00078c88b2" :question/math-academy-id "q-342669" :question/problem "Evaluate $tanh\\,(-\\frac{3}{4}).$ **Do not round** your answer.\n\n$tanh\\,(-\\frac{3}{4})=$\n\n| {{field-1}} |\n| --- |\n| $1+{e}^{3/2}$ |" :question/worked-solution "The definition of $\\operatorname{tanh}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the third definition, we get\n\n$$\n\\begin{aligned}tanh\\,(-\\frac{3}{4}) & =\\frac{1-{e}^{-2(-3/4)}}{1+{e}^{-2(-3/4)}} \\\\  & =\\frac{1-{e}^{3/2}}{1+{e}^{3/2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317314 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8b71532-1488-535c-8b59-8f7973ce0715" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{8}" :db/id #edb/ref 17592186316411}] :answer-field/correct {:answer/id #uuid "e8b71532-1488-535c-8b59-8f7973ce0715" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{8}" :db/id #edb/ref 17592186316411} :answer-field/id #uuid "5f69b0ab-5955-53db-b009-8c0582376a86" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316770}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4aa4c921-dada-59cb-bb50-cb4450e9d902" :question/math-academy-id "q-342689" :question/problem "Evaluate $\\operatorname{sinh}⁡(\\operatorname{ln}⁡4).$ **Do not round** your answer.\n\n$\\operatorname{sinh}⁡(\\operatorname{ln}⁡4)=$\n{{field-1}}" :question/worked-solution "The definition of $\\operatorname{sinh}⁡x$ is \n\n$$\n\\operatorname{sinh}⁡x=\\frac{1}{2}({e}^{x}-{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sinh}⁡(\\operatorname{ln}⁡4) & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡4}-{e}^{-\\operatorname{ln}⁡4}) \\\\  & =\\frac{1}{2}(4-{4}^{-1}) \\\\  & =\\frac{1}{2}(4-\\frac{1}{4}) \\\\  & =\\frac{1}{2}(\\frac{15}{4}) \\\\  & =\\frac{15}{8}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317316 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21be9580-2335-54ac-8059-660a2e09e0d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186315304}] :answer-field/correct {:answer/id #uuid "21be9580-2335-54ac-8059-660a2e09e0d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186315304} :answer-field/id #uuid "c66056fd-b5e9-5140-97df-839aad6ea433" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317021}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f9bc16a4-340b-5d92-b113-ebdd1b46f211" :question/math-academy-id "q-342707" :question/problem "Given that $r=-4\\operatorname{sin}⁡\\theta $ for $\\theta =\\theta (t),$ and that $\\frac{\\text{d}r}{\\text{d}t}=\\frac{1}{3}$ at the point where $\\theta =\\frac{\\pi }{3},$ evaluate $\\frac{\\text{d}\\theta }{\\text{d}t}$ at that point.\n\n$\\frac{\\text{d}\\theta }{\\text{d}t}=$\n{{field-1}}" :question/worked-solution "Differentiating the given relation with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}r & =-4\\operatorname{sin}⁡\\theta  \\\\ \\frac{\\text{d}}{\\text{d}t}(r) & =\\frac{\\text{d}}{\\text{d}t}\\,(-4\\operatorname{sin}⁡\\theta ) \\\\ \\frac{\\text{d}r}{\\text{d}t} & =\\frac{\\text{d}\\theta }{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}\\theta }\\,(-4\\operatorname{sin}⁡\\theta ) \\\\ \\frac{\\text{d}r}{\\text{d}t} & =\\frac{\\text{d}\\theta }{\\text{d}t}\\cdot (-4\\operatorname{cos}⁡\\theta ).\\end{aligned}\n$$\n\nNow we can substitute the given information $\\frac{\\text{d}r}{\\text{d}t}=\\frac{1}{3}$ and $\\theta =\\frac{\\pi }{3},$ and solve for $\\frac{\\text{d}\\theta }{\\text{d}t}.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{3} & =\\frac{\\text{d}\\theta }{\\text{d}t}\\cdot [-4\\operatorname{cos}⁡(\\frac{\\pi }{3})] \\\\ \\frac{1}{3} & =\\frac{\\text{d}\\theta }{\\text{d}t}\\cdot (-2) \\\\ \\frac{\\text{d}\\theta }{\\text{d}t} & =-\\frac{1}{6}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317323 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "454031fb-d968-502a-ab3f-df93403f8653" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186315519} {:answer/id #uuid "816282ac-3dfc-57d5-9df3-d0079f794032" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186315831} {:answer/id #uuid "97669a6d-02b3-57ba-bba2-b6864e81902e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{25}" :db/id #edb/ref 17592186315961} {:answer/id #uuid "b1e3164f-859c-5ff3-924d-f64996d960a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{15}" :db/id #edb/ref 17592186316125} {:answer/id #uuid "b501f954-5954-54d1-a029-9d17e4f0ee33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{19}" :db/id #edb/ref 17592186316143}] :answer-field/correct {:answer/id #uuid "97669a6d-02b3-57ba-bba2-b6864e81902e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{25}" :db/id #edb/ref 17592186315961} :answer-field/id #uuid "13ffaa86-ca52-5a1a-ae7b-ae3a365017ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186316593}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3a5173f3-affb-5348-89f6-746440382607" :question/math-academy-id "q-34278" :question/problem "Consider the curve $r(s)$ parametrized by arc length $s.$ Find the curvature at the point where $s=5\\pi $, if the unit tangent vector of the curve is given by\n\n \n\n$$\nT(s)=\\frac{4}{5}\\,i-\\frac{3}{5}\\operatorname{sin}⁡(\\frac{3s}{5})\\,j+\\frac{3}{5}\\operatorname{cos}⁡(\\frac{3s}{5})\\,k.\n$$" :question/worked-solution "Since we are given that the curve $r(s)$ and its unit tangent vector $T(s)$ are parametrized by the arc length $s$, we will use the following formula for the curvature:\n\n$$\nκ(s)=‖{T}^{′}(s)‖\n$$\n\nNow, we differentiate $T(s)$ with respect to $s$ and evaluate it at $s=5\\pi $: \n\n$$\n\\begin{aligned}{T}^{′}(s) & =\\frac{\\text{d}}{\\text{d}s}(\\frac{4}{5})\\,i+\\frac{\\text{d}}{\\text{d}s}(-\\frac{3}{5}\\operatorname{sin}⁡(\\frac{3s}{5}))\\,j+\\frac{\\text{d}}{\\text{d}s}(\\frac{3}{5}\\operatorname{cos}⁡(\\frac{3s}{5}))\\,k \\\\  & =(0)\\,i-\\frac{9}{25}\\operatorname{cos}⁡(\\frac{3s}{5})\\,j-\\frac{9}{25}\\operatorname{sin}⁡(\\frac{3s}{5})\\,k \\\\ {T}^{′}(5\\pi ) & =-\\frac{9}{25}\\operatorname{cos}⁡(\\frac{3\\cdot (5\\pi )}{5})\\,j-\\frac{9}{25}\\operatorname{sin}⁡(\\frac{3\\cdot (5\\pi )}{5})\\,k \\\\  & =-\\frac{9}{25}\\operatorname{cos}⁡(3\\pi )\\,j-\\frac{9}{25}\\operatorname{sin}⁡(3\\pi )\\,k \\\\  & =-\\frac{9}{25}\\cdot (-1)\\,j-\\frac{9}{25}\\cdot (0)\\,k \\\\  & =\\frac{9}{25}\\,j\\end{aligned}\n$$\n\n \n\nFinally, we obtain the curvature:\n\n$$\n\\begin{aligned}κ(5\\pi ) & =‖{T}^{′}(5\\pi )‖ \\\\  & =\\frac{9}{25}\\sqrt{{(0)}^{2}+{(1)}^{2}+{(0)}^{2}} \\\\  & =\\frac{9}{25}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317326 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22c57943-65ff-5d5d-81f8-1002a59bb417" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{18}" :db/id #edb/ref 17592186315311}] :answer-field/correct {:answer/id #uuid "22c57943-65ff-5d5d-81f8-1002a59bb417" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{18}" :db/id #edb/ref 17592186315311} :answer-field/id #uuid "4e7bce52-e2d7-50a5-a44d-84c8a8cc1d7d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316728}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "febc6c25-71ff-51d9-b851-6f19e65ebcd1" :question/math-academy-id "q-342802" :question/problem "The slope of the tangent to the curve $y=\\frac{1}{\\sqrt{3{x}^{2}+12x}}$ at the point where $x=2$ is{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nWe use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=3{x}^{2}+12x.$ Then $y=\\frac{1}{\\sqrt{u}}={u}^{-1/2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-\\frac{1}{2}{u}^{-3/2}=-\\frac{1}{2\\sqrt{{u}^{3}}},\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6x+12.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{2\\sqrt{{u}^{3}}}\\cdot (6x+12) \\\\  & =-\\frac{6x+12}{2\\sqrt{(3{x}^{2}+12x{)}^{3}}}.\\end{aligned}\n$$\n\nFinally, substituting $x=2,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=2} & ={(-\\frac{6x+12}{2\\sqrt{(3{x}^{2}+12x{)}^{3}}})|}_{x=2} \\\\  & =-\\frac{6(2)+12}{2\\sqrt{(3(2{)}^{2}+12(2){)}^{3}}} \\\\  & =-\\frac{24}{2\\sqrt{{36}^{3}}} \\\\  & =-\\frac{1}{18}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317330 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bb86229-e35b-53e4-913f-4d749f83077c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{e}^{-2(t-\\pi /2)}-\\operatorname{cos}⁡(2t)+\\operatorname{sin}⁡(2t)" :db/id #edb/ref 17592186315182} {:answer/id #uuid "78409cec-7d3a-5018-8211-374354f871e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{e}^{-2(t-\\pi /2)}-\\operatorname{cos}⁡(2t)-\\operatorname{sin}⁡(2t)" :db/id #edb/ref 17592186315794} {:answer/id #uuid "7f0d4b84-a896-53a4-8a7d-99182c49f054" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-2(t-\\pi /2)}+\\operatorname{cos}⁡(2t)+\\operatorname{sin}⁡(2t)" :db/id #edb/ref 17592186315818} {:answer/id #uuid "d40d8afa-6705-55cf-8bfb-ebe80732cb6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-2(t-\\pi /2)}-\\operatorname{cos}⁡(2t)-\\operatorname{sin}⁡(2t)" :db/id #edb/ref 17592186316306} {:answer/id #uuid "ef79be0e-dda5-500a-ae0e-ddbb56647f04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-2(t-\\pi /2)}-\\operatorname{cos}⁡(2t)+\\operatorname{sin}⁡(2t)" :db/id #edb/ref 17592186316450}] :answer-field/correct {:answer/id #uuid "7f0d4b84-a896-53a4-8a7d-99182c49f054" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-2(t-\\pi /2)}+\\operatorname{cos}⁡(2t)+\\operatorname{sin}⁡(2t)" :db/id #edb/ref 17592186315818} :answer-field/id #uuid "73214da6-cfd5-55ae-9cfd-5d2071e6e2b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186316823}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "01fff398-2b6d-506d-9fb7-5344ae756247" :question/math-academy-id "q-342815" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}+2y={u}_{\\pi /2}(t)\\cdot cos\\,(2t-\\pi )\\,,\\,y(0)=-2,\n$$\n\nwhere ${u}_{\\pi /2}(t)=u\\,(t-\\frac{\\pi }{2})$ is the unit step function.\n\nYou're given that the Laplace transform $Y(s)=L{y(t)}$ is\n\n$$\nY(s)=-\\frac{2}{s+2}+\\frac{s\\,{e}^{-\\pi s/2}}{({s}^{2}+4)(s+2)}\n$$\n\nand that the solution to the initial value problem can be expressed as \n\n$$\ny(t)=-2{e}^{-2t}-\\frac{1}{4}u\\,(t-\\frac{\\pi }{2})\\cdot g(t).\n$$\n\nFind the function $g(t).$ \n\nHint: You may make use of the following results:\n\n$$\nL{\\operatorname{sin}⁡\\omega t}=\\frac{\\omega }{{s}^{2}+{\\omega }^{2}},\\,L{\\operatorname{cos}⁡\\omega t}=\\frac{s}{{s}^{2}+{\\omega }^{2}},\\,s>0.\n$$" :question/worked-solution "To find the function $g(t),$ we need to compute the inverse Laplace transform of the term containing the time delay in $Y(s).$\n\nWe focus on the term with the exponential ${e}^{-\\pi s/2}$ (which corresponds to the step function in the time domain) and identify the rational function part:\n\n$$\nF(s)=\\frac{s}{({s}^{2}+4)(s+2)}.\n$$\n\nWe'll solve this in three steps.\n\n**Step 1.** Partial fraction decomposition\n\nSince the denominator contains a linear factor $(s+2)$ and an irreducible quadratic factor $({s}^{2}+4),$ the decomposition takes the form\n\n$$\n\\frac{s}{({s}^{2}+4)(s+2)}=\\frac{A}{s+2}+\\frac{Bs+C}{{s}^{2}+4}.\n$$\n\nTo find the constants, we clear the denominators:\n\n$$\ns=A({s}^{2}+4)+(Bs+C)(s+2).\n$$\n\nNow, we find the constants $A,B,$ and $C.$\n\n- Setting $s=-2,$ we have\n\n$$\n-2=A((-2)^{2}+4)+0\\,⟹\\,8A=-2\\,⟹\\,A=-\\frac{1}{4}.\n$$\n\n- Comparing the coefficients of ${s}^{2},$ we have\n\n$$\n0=A+B\\,⟹\\,B=-A=\\frac{1}{4}.\n$$\n\n- Comparing the constant terms, we have\n\n$$\n0=4A+2C\\,⟹\\,0=4\\,(-\\frac{1}{4})+2C\\,⟹\\,C=\\frac{1}{2}.\n$$\n\nThus, we can rewrite $F(s)$ as\n\n$$\nF(s)=\\frac{1}{4}(-\\frac{1}{s+2}+\\frac{s}{{s}^{2}+4}+\\frac{2}{{s}^{2}+4}).\n$$\n\n**Step 2.** Finding the Inverse of the base function\n\nWe find the inverse transform $f(t)={L}^{-1}{F(s)}$ using standard transforms:\n\n$$\n\\begin{aligned}f(t) & =\\frac{1}{4}(-{L}^{-1}{\\frac{1}{s+2}}+{L}^{-1}{\\frac{s}{{s}^{2}+4}}+{L}^{-1}{\\frac{2}{{s}^{2}+4}}) \\\\  & =\\frac{1}{4}(-{e}^{-2t}+\\operatorname{cos}⁡(2t)+\\operatorname{sin}⁡(2t))\\end{aligned}\n$$\n\n**Step 3.** Applying the time-shifting property\n\nFinally, we address the ${e}^{-\\pi s/2}$ term. By the second shifting theorem, we have\n\n$$\n{e}^{-as}\\cdot F(s)=L{u(t-a)\\cdot f(t-a)}.\n$$\n\nTaking the inverse Laplace transform gives\n\n$$\n{L}^{-1}{{e}^{-as}F(s)}=u(t-a)\\cdot f(t-a).\n$$\n\nIn our case, $a=\\frac{\\pi }{2}.$ Therefore, we shift $f(t)$ by replacing every instance of $t$ with $(t-\\frac{\\pi }{2}):$\n\n$$\n\\begin{aligned}y(t) & =u\\,(t-\\frac{\\pi }{2})f\\,(t-\\frac{\\pi }{2}) \\\\  & =u\\,(t-\\frac{\\pi }{2})\\cdot \\frac{1}{4}[-{e}^{-2(t-\\pi /2)}+\\operatorname{cos}⁡(2\\,(t-\\frac{\\pi }{2}))+\\operatorname{sin}⁡(2\\,(t-\\frac{\\pi }{2}))].\\end{aligned}\n$$\n\nUsing the trigonometric identities $cos\\,(2\\,(t-\\frac{\\pi }{2}))=-\\operatorname{cos}⁡(2t)$ and $sin\\,(2\\,(t-\\frac{\\pi }{2}))=-\\operatorname{sin}⁡(2t),$ we simplify:\n\n$$\n\\begin{aligned}y(t) & =u\\,(t-\\frac{\\pi }{2})\\cdot \\frac{1}{4}(-{e}^{-2(t-\\pi /2)}-\\operatorname{cos}⁡(2t)-\\operatorname{sin}⁡(2t)) \\\\  & =-\\frac{1}{4}\\,u\\,(t-\\frac{\\pi }{2})({e}^{-2(t-\\pi /2)}+\\operatorname{cos}⁡(2t)+\\operatorname{sin}⁡(2t)).\\end{aligned}\n$$\n\nComparing this to the second term of the form given in the problem statement $y(t)=-2{e}^{-2t}-\\frac{1}{4}u\\,(t-\\frac{\\pi }{2})\\cdot g(t),$ we identify $g(t)$ as\n\n$$\ng(t)={e}^{-2(t-\\pi /2)}+\\operatorname{cos}⁡(2t)+\\operatorname{sin}⁡(2t).\n$$"} {:db/id #edb/ref 17592186317332 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aecdc34-d1fb-5aa0-9177-6df673e16d4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Y(s)=\\frac{s}{{s}^{2}+1}" :db/id #edb/ref 17592186315278} {:answer/id #uuid "40e6d4e7-1ae4-5e1d-a321-e91fa0798e20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Y(s)=\\frac{s+2}{({s}^{2}+1)(s-2)}" :db/id #edb/ref 17592186315493} {:answer/id #uuid "41083963-0989-5c87-a4a3-3fab55909628" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Y(s)=\\frac{1}{{s}^{2}+1}" :db/id #edb/ref 17592186315495} {:answer/id #uuid "da0b3612-c263-5a7f-90e8-63fe31b52606" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Y(s)=\\frac{s-2}{{s}^{2}+1}" :db/id #edb/ref 17592186316333} {:answer/id #uuid "df9e9bfc-e23e-5e6c-bf4f-e49b6bdb192e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Y(s)=\\frac{s+2}{{s}^{2}+1}" :db/id #edb/ref 17592186316356}] :answer-field/correct {:answer/id #uuid "df9e9bfc-e23e-5e6c-bf4f-e49b6bdb192e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Y(s)=\\frac{s+2}{{s}^{2}+1}" :db/id #edb/ref 17592186316356} :answer-field/id #uuid "2c430bcb-564b-50b2-9898-0fbfb5261a2f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186316648}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fa991e15-245e-5f09-a588-d0699cc46130" :question/math-academy-id "q-342871" :question/problem "Find the Laplace transform $Y(s)=L{y(t)}$ for $s>2$ if \n\n$$\n{y}^{′}-2y=-5\\operatorname{sin}⁡t,\\,y(0)=1.\n$$\n\nYou may make use of the following result:\n\n$$\nL{\\operatorname{sin}⁡\\omega t}=\\frac{\\omega }{{s}^{2}+{\\omega }^{2}},\\,s>0.\n$$" :question/worked-solution "First, we take the Laplace transform of both sides and use the addition and scalar multiplication properties of the Laplace transform:\n\n$$\n\\begin{aligned}L{{y}^{′}-2y} & =L{-5\\operatorname{sin}⁡t} \\\\ L{{y}^{′}}-2L{y} & =-5L{\\operatorname{sin}⁡t}\\end{aligned}\n$$\n\nTo calculate $L{{y}^{′}},$ we use the formula for the Laplace transform of a derivative and the initial condition $y(0)=1:$\n\n$$\nL{{y}^{′}}=sL{y}-y(0)=sY(s)-1\n$$\n\nFrom the table of Laplace transforms, we have the following result:\n\n$$\nL{\\operatorname{sin}⁡t}=\\frac{1}{{s}^{2}+1},\\,s>0\n$$\n\nTherefore, we can solve for $Y(s):$\n\n$$\n\\begin{aligned}L{{y}^{′}}-2L{y} & =-5L{\\operatorname{sin}⁡t} \\\\ (sY(s)-1)-2Y(s) & =-5(\\frac{1}{{s}^{2}+1}) \\\\ sY(s)-2Y(s) & =1-\\frac{5}{{s}^{2}+1} \\\\ (s-2)Y(s) & =\\frac{{s}^{2}-4}{{s}^{2}+1} \\\\ Y(s) & =\\frac{{s}^{2}-4}{({s}^{2}+1)(s-2)}\\end{aligned}\n$$\n\nSince $s>2,$ we simplify as follows:\n\n$$\n\\begin{aligned}Y(s) & =\\frac{(s-2)(s+2)}{({s}^{2}+1)(s-2)} \\\\ Y(s) & =\\frac{s+2}{{s}^{2}+1}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317334 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74e1d1f8-4b3b-5f18-a100-a8ccb58c59dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6-\\frac{8}{{x}^{3}}" :db/id #edb/ref 17592186315780}] :answer-field/correct {:answer/id #uuid "74e1d1f8-4b3b-5f18-a100-a8ccb58c59dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6-\\frac{8}{{x}^{3}}" :db/id #edb/ref 17592186315780} :answer-field/id #uuid "c6b14006-56d1-58f0-b9f3-8c1de5bea365" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317022}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dd8f94da-36ef-5137-94da-7eeaf5cded56" :question/math-academy-id "q-342877" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=\\frac{6{x}^{3}+2{x}^{2}-8}{2x}.$\n\n$\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=$ \n{{field-1}}" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{6{x}^{3}+2{x}^{2}-8}{2x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}+x-4{x}^{-1}) \\\\  & =6x+1+(-1)(-4{x}^{-2}) \\\\  & =6x+1+4{x}^{-2}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(6x+1+4{x}^{-2}) \\\\  & =6+0+(-2)(4{x}^{-3}) \\\\  & =6-\\frac{8}{{x}^{3}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317336 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d665e027-6ab2-5ec3-82b7-84f4dddc219b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-4{x}^{3}" :db/id #edb/ref 17592186316315}] :answer-field/correct {:answer/id #uuid "d665e027-6ab2-5ec3-82b7-84f4dddc219b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-4{x}^{3}" :db/id #edb/ref 17592186316315} :answer-field/id #uuid "e1297ade-d13c-5373-bff2-2ee35469ee63" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317084}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "49fe03e2-8c48-5c16-b76a-8505b327ec2d" :question/math-academy-id "q-342891" :question/problem "Given that $f(x)=\\frac{1}{\\sqrt{2{x}^{4}-{x}^{2}+5}},$ find ${f}^{′}(x).$\n\n$\\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{\\sqrt{(2{x}^{4}-{x}^{2}+5{)}^{3}}}($\n{{field-1}}\n$)$" :question/worked-solution "Let $g(x)=2{x}^{4}-{x}^{2}+5$ and $f(g(x))=\\frac{1}{\\sqrt{g(x)}}.$ \n\nDifferentiating, we have\n\n$$\n\\begin{aligned}{f}^{′}(g(x)) & ={(\\frac{1}{\\sqrt{g}})}^{′}=-\\frac{1}{2\\sqrt{{g}^{3}}}, \\\\ {g}^{′}(x) & =(2{x}^{4}-{x}^{2}+5{)}^{′}=8{x}^{3}-2x.\\end{aligned}\n$$\n\nThen, using the chain rule, \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={f}^{′}(g(x))\\cdot {g}^{′}(x) \\\\  & =-\\frac{1}{2\\sqrt{{g}^{3}}}\\cdot (8{x}^{3}-2x) \\\\  & =\\frac{1}{\\sqrt{(2{x}^{4}-{x}^{2}+5{)}^{3}}}(\\,x-4{x}^{3}\\,).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317344 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "565253a0-dd76-5878-a7a9-4d02c0c4fb2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{s}{(s+2)({s}^{2}+2)}" :db/id #edb/ref 17592186315612} {:answer/id #uuid "6127abfe-b3b5-53d1-80dc-adfc13213bcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{s+1}{(s+2)({s}^{2}+1)}" :db/id #edb/ref 17592186315661} {:answer/id #uuid "6c430fee-5cee-52c9-aa2c-21b95ea58ff4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-s}{(s+2)({s}^{2}+1)}" :db/id #edb/ref 17592186315727} {:answer/id #uuid "6dd27d68-4ff1-5483-b08a-a6cf002b0807" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{s-1}{(s+2)({s}^{2}+1)}" :db/id #edb/ref 17592186315741} {:answer/id #uuid "9fb0ca75-2725-5130-a280-b76152dbb5d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{(s+2)({s}^{2}+4)}" :db/id #edb/ref 17592186316015}] :answer-field/correct {:answer/id #uuid "6127abfe-b3b5-53d1-80dc-adfc13213bcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{s+1}{(s+2)({s}^{2}+1)}" :db/id #edb/ref 17592186315661} :answer-field/id #uuid "271ee920-82c3-5b6f-9a20-a71259ec1617" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316636} {:answer-field/choices [{:answer/id #uuid "1d82da8d-de3b-50ea-80e3-5b6f2e301096" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}{e}^{-2t}-\\frac{1}{5}\\operatorname{cos}⁡t-\\frac{3}{5}\\operatorname{sin}⁡t" :db/id #edb/ref 17592186315289} {:answer/id #uuid "3447534b-e198-50ea-ab41-3d0bda427511" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5}{e}^{-2t}-\\frac{1}{5}\\operatorname{cos}⁡t+\\frac{3}{5}\\operatorname{sin}⁡t" :db/id #edb/ref 17592186315425} {:answer/id #uuid "37e98731-46c9-5121-b094-d05fd40536d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5}{e}^{-2t}+\\frac{1}{5}\\operatorname{cos}⁡t+\\frac{3}{5}\\operatorname{sin}⁡t" :db/id #edb/ref 17592186315441} {:answer/id #uuid "daef66fb-4bf5-5c47-9422-2355ef5544b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-2t}-\\operatorname{cos}⁡t" :db/id #edb/ref 17592186316339}] :answer-field/correct {:answer/id #uuid "37e98731-46c9-5121-b094-d05fd40536d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5}{e}^{-2t}+\\frac{1}{5}\\operatorname{cos}⁡t+\\frac{3}{5}\\operatorname{sin}⁡t" :db/id #edb/ref 17592186315441} :answer-field/id #uuid "753a75d5-e5a7-57ac-9cdd-83a1b3c0d991" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316826} {:answer-field/choices [{:answer/id #uuid "23148239-08bb-571d-8ee4-d16856744176" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5(s+2)}+\\frac{s+3}{5({s}^{2}+1)}" :db/id #edb/ref 17592186315312} {:answer/id #uuid "2643860c-cbaf-5089-9e07-85dcc01bf2ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5(s+2)}-\\frac{s+3}{5({s}^{2}+1)}" :db/id #edb/ref 17592186315333} {:answer/id #uuid "59334acc-00f4-55d4-8893-99596de90306" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{s+2}-\\frac{s}{{s}^{2}+1}" :db/id #edb/ref 17592186315628} {:answer/id #uuid "adc67946-4de6-5ed2-b87e-0af0e29aaec0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5(s+2)}-\\frac{s+3}{5({s}^{2}+1)}" :db/id #edb/ref 17592186316099}] :answer-field/correct {:answer/id #uuid "23148239-08bb-571d-8ee4-d16856744176" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5(s+2)}+\\frac{s+3}{5({s}^{2}+1)}" :db/id #edb/ref 17592186315312} :answer-field/id #uuid "ec9bde2a-e15f-5b58-a398-7c211684b04f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186317108}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7c31d5d2-d84b-5f0f-a8dc-d915106eb0d2" :question/math-academy-id "q-342961" :question/problem "Consider the following initial value problem.\n\n$$\n\\frac{\\text{d}y}{\\text{d}t}+2y=\\operatorname{sin}⁡t+\\operatorname{cos}⁡t,\\,y(0)=0\n$$\n\nSelect the correct options in the reasoning below to find the solution using Laplace transforms. You may make use of the following results:\n\n$$\nL{\\operatorname{sin}⁡\\omega t}=\\frac{\\omega }{{s}^{2}+{\\omega }^{2}},\\,L{\\operatorname{cos}⁡\\omega t}=\\frac{s}{{s}^{2}+{\\omega }^{2}},\\,s>0.\n$$\n\nLet $Y(s)=L{y(t)}.$ Taking the Laplace transform of both sides of the equation and solving for $Y,$ we have\n\n$$\nY(s)={{field-1}}.\n$$\n\nThe partial fraction decomposition of $Y$ is\n\n$$\nY(s)={{field-2}}.\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny(t)={{field-3}}.\n$$" :question/worked-solution "First, we take the Laplace transform of both sides of the differential equation. Using the linearity property, we have\n\n$$\nL{{y}^{′}}+2L{y}=L{\\operatorname{sin}⁡t}+L{\\operatorname{cos}⁡t}.\n$$\n\nUsing the formula for the transform of a derivative $L{{y}^{′}}=sY(s)-y(0)$ and the standard trigonometric transforms\n\n$$\nL{\\operatorname{sin}⁡t}=\\frac{1}{{s}^{2}+1},\\,L{\\operatorname{cos}⁡t}=\\frac{s}{{s}^{2}+1},\n$$\n\nwe substitute the known values. Note that $y(0)=0:$\n\n$$\n\\begin{aligned}(sY(s)-0)+2Y(s) & =\\frac{1}{{s}^{2}+1}+\\frac{s}{{s}^{2}+1} \\\\ (s+2)Y(s) & =\\frac{s+1}{{s}^{2}+1}\\end{aligned}\n$$\n\nWe rearrange to solve for $Y(s).$ Dividing by $(s+2),$ we obtain\n\n$$\nY(s)=\\frac{s+1}{(s+2)({s}^{2}+1)}.\n$$\n\nNext, we perform a partial fraction decomposition. Since the denominator has a linear factor $(s+2)$ and an irreducible quadratic factor $({s}^{2}+1),$ we write\n\n$$\n\\frac{s+1}{(s+2)({s}^{2}+1)}=\\frac{A}{s+2}+\\frac{Bs+C}{{s}^{2}+1}.\n$$\n\nTo find the constants, we clear the denominators:\n\n$$\ns+1=A({s}^{2}+1)+(Bs+C)(s+2)\n$$\n\n- Setting $s=-2,$ we have\n \n\n$$\n-2+1=A((-2)^{2}+1)+0\\,⟹\\,-1=5A\\,⟹\\,A=-\\frac{1}{5}.\n$$\n\n- Comparing the coefficients of ${s}^{2},$ we have\n  \n\n$$\n0=A+B\\,⟹\\,0=-\\frac{1}{5}+B\\,⟹\\,B=\\frac{1}{5}.\n$$\n\n- Comparing the constant terms, we have\n \n\n$$\n1=A+2C\\,⟹\\,1=-\\frac{1}{5}+2C\\,⟹\\,C=\\frac{3}{5}.\n$$\n\nThus, the decomposition is\n\n$$\nY(s)=\\frac{(-\\frac{1}{5})}{s+2}+\\frac{(\\frac{1}{5}s+\\frac{3}{5})}{{s}^{2}+1}=-\\frac{1}{5(s+2)}+\\frac{s+3}{5({s}^{2}+1)}.\n$$\n\nFrom the table of Laplace transforms, we have:\n\n$$\n\\begin{aligned}{L}^{-1}{\\frac{1}{s+2}} & ={e}^{-2t} \\\\ {L}^{-1}{\\frac{s}{{s}^{2}+1}} & =\\operatorname{cos}⁡t \\\\ {L}^{-1}{\\frac{1}{{s}^{2}+1}} & =\\operatorname{sin}⁡t\\end{aligned}\n$$\n\nFinally, taking the inverse Laplace transform of $Y(s),$ we get\n\n$$\n\\begin{aligned}y(t) & =-\\frac{1}{5}{L}^{-1}{\\frac{1}{s+2}}+\\frac{1}{5}{L}^{-1}{\\frac{s}{{s}^{2}+1}}+\\frac{3}{5}{L}^{-1}{\\frac{1}{{s}^{2}+1}} \\\\ y(t) & =-\\frac{1}{5}{e}^{-2t}+\\frac{1}{5}\\operatorname{cos}⁡t+\\frac{3}{5}\\operatorname{sin}⁡t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317345 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00c15c0d-3f63-5626-8437-1d07dfb1c869" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{s-3}{(s+6)({s}^{2}+9)}" :db/id #edb/ref 17592186315118} {:answer/id #uuid "10b6cc8d-1ff6-5f5f-b9f2-bb50c04eb7d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{s}{(s+6)({s}^{2}+9)}" :db/id #edb/ref 17592186315220} {:answer/id #uuid "12ce8ffd-dca9-5cac-90ca-040567267891" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{s+3}{(s+6)({s}^{2}+9)}" :db/id #edb/ref 17592186315230} {:answer/id #uuid "486fb27f-8afc-53da-90dd-8a970092ad3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{(s+6)({s}^{2}+9)}" :db/id #edb/ref 17592186315536} {:answer/id #uuid "ed617c3f-60b8-5742-abec-ca9b550b9c6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3-s}{(s+6)({s}^{2}+9)}" :db/id #edb/ref 17592186316438}] :answer-field/correct {:answer/id #uuid "12ce8ffd-dca9-5cac-90ca-040567267891" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{s+3}{(s+6)({s}^{2}+9)}" :db/id #edb/ref 17592186315230} :answer-field/id #uuid "40d7fe7c-9b67-526d-84b0-aecc2edd4906" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316694} {:answer-field/choices [{:answer/id #uuid "70fc568e-cbff-5a63-b7d0-8052cbf0e641" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{15}{e}^{-6t}-\\frac{1}{15}\\operatorname{cos}⁡3t+\\frac{1}{5}\\operatorname{sin}⁡3t" :db/id #edb/ref 17592186315755} {:answer/id #uuid "8a872fca-500c-5209-a6ab-186145fb360d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{15}{e}^{-6t}-\\frac{1}{15}\\operatorname{cos}⁡3t-\\frac{1}{5}\\operatorname{sin}⁡3t" :db/id #edb/ref 17592186315891} {:answer/id #uuid "f8c809cd-7250-5385-8318-d7158b9c34a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{15}{e}^{-6t}+\\frac{1}{15}\\operatorname{cos}⁡3t+\\frac{1}{5}\\operatorname{sin}⁡3t" :db/id #edb/ref 17592186316507} {:answer/id #uuid "fda00ec7-5657-52db-b36a-adad840bf3cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-6t}-\\operatorname{cos}⁡3t" :db/id #edb/ref 17592186316537}] :answer-field/correct {:answer/id #uuid "f8c809cd-7250-5385-8318-d7158b9c34a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{15}{e}^{-6t}+\\frac{1}{15}\\operatorname{cos}⁡3t+\\frac{1}{5}\\operatorname{sin}⁡3t" :db/id #edb/ref 17592186316507} :answer-field/id #uuid "587ef0bf-9fa3-50bf-b0ed-b158d189ebfc" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316753} {:answer-field/choices [{:answer/id #uuid "0ec4a8c2-c836-5840-b694-20dd11459345" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{15(s+6)}+\\frac{s+9}{15({s}^{2}+9)}" :db/id #edb/ref 17592186315207} {:answer/id #uuid "4cf47adb-a4fd-59db-8eb2-1fe5160a7e92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{15(s+6)}-\\frac{s+9}{15({s}^{2}+9)}" :db/id #edb/ref 17592186315557} {:answer/id #uuid "6f76ae1b-28b0-5e1b-98a6-6ede16ec878c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{15(s+6)}-\\frac{s+9}{15({s}^{2}+9)}" :db/id #edb/ref 17592186315746} {:answer/id #uuid "bfd40d37-2bf4-50a7-9ad9-c6729c9cea65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{s+6}-\\frac{s}{{s}^{2}+9}" :db/id #edb/ref 17592186316200}] :answer-field/correct {:answer/id #uuid "0ec4a8c2-c836-5840-b694-20dd11459345" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{15(s+6)}+\\frac{s+9}{15({s}^{2}+9)}" :db/id #edb/ref 17592186315207} :answer-field/id #uuid "fb0527c8-5f53-50ec-9a08-80884046b33f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186317142}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3ad24855-aa70-5db4-b32a-41dc702fd75a" :question/math-academy-id "q-342962" :question/problem "Consider the following initial value problem.\n\n$$\n\\frac{\\text{d}y}{\\text{d}t}+6y=\\operatorname{sin}⁡3t+\\operatorname{cos}⁡3t,\\,y(0)=0\n$$\n\nSelect the correct options in the reasoning below to find the solution using Laplace transforms. You may make use of the following results:\n\n$$\nL{\\operatorname{sin}⁡\\omega t}=\\frac{\\omega }{{s}^{2}+{\\omega }^{2}},\\,L{\\operatorname{cos}⁡\\omega t}=\\frac{s}{{s}^{2}+{\\omega }^{2}},\\,s>0.\n$$\n\nLet $Y(s)=L{y(t)}.$ Taking the Laplace transform of both sides of the equation and solving for $Y,$ we have\n\n$$\nY(s)={{field-1}}.\n$$\n\nThe partial fraction decomposition of $Y$ is\n\n$$\nY(s)={{field-2}}.\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny(t)={{field-3}}.\n$$" :question/worked-solution "First, we take the Laplace transform of both sides of the differential equation. Using the linearity property, we have\n\n$$\nL{{y}^{′}}+6L{y}=L{\\operatorname{sin}⁡3t}+L{\\operatorname{cos}⁡3t}.\n$$\n\nUsing the formula for the transform of a derivative $L{{y}^{′}}=sY(s)-y(0)$ and the standard trigonometric transforms\n\n$$\nL{\\operatorname{sin}⁡3t}=\\frac{3}{{s}^{2}+9},\\,L{\\operatorname{cos}⁡3t}=\\frac{s}{{s}^{2}+9},\n$$\n\nwe substitute the known values. Note that $y(0)=0:$\n\n$$\n\\begin{aligned}(sY(s)-0)+6Y(s) & =\\frac{3}{{s}^{2}+9}+\\frac{s}{{s}^{2}+9} \\\\ (s+6)Y(s) & =\\frac{s+3}{{s}^{2}+9}\\end{aligned}\n$$\n\nWe rearrange to solve for $Y(s).$ Dividing by $(s+6),$ we obtain\n\n$$\nY(s)=\\frac{s+3}{(s+6)({s}^{2}+9)}.\n$$\n\nNext, we perform a partial fraction decomposition. Since the denominator has a linear factor $(s+6)$ and an irreducible quadratic factor $({s}^{2}+9),$ we write\n\n$$\n\\frac{s+3}{(s+6)({s}^{2}+9)}=\\frac{A}{s+6}+\\frac{Bs+C}{{s}^{2}+9}.\n$$\n\nTo find the constants, we clear the denominators:\n\n$$\ns+3=A({s}^{2}+9)+(Bs+C)(s+6)\n$$\n\n- Setting $s=-6,$ we have\n \n\n$$\n-6+3=A((-6)^{2}+9)+0\\,⟹\\,-3=45A\\,⟹\\,A=-\\frac{1}{15}.\n$$\n\n- Comparing the coefficients of ${s}^{2},$ we have\n  \n\n$$\n0=A+B\\,⟹\\,0=-\\frac{1}{15}+B\\,⟹\\,B=\\frac{1}{15}.\n$$\n\n- Comparing the constant terms, we have\n \n\n$$\n3=9A+6C\\,⟹\\,3=-\\frac{3}{5}+6C\\,⟹\\,C=\\frac{3}{5}.\n$$\n\nThus, the decomposition is\n\n$$\nY(s)=\\frac{(-\\frac{1}{15})}{s+6}+\\frac{(\\frac{1}{15}s+\\frac{3}{5})}{{s}^{2}+9}=-\\frac{1}{15(s+6)}+\\frac{s+9}{15({s}^{2}+9)}.\n$$\n\nFrom the table of Laplace transforms, we have:\n\n$$\n\\begin{aligned}{L}^{-1}{\\frac{1}{s+6}} & ={e}^{-6t} \\\\ {L}^{-1}{\\frac{s}{{s}^{2}+9}} & =\\operatorname{cos}⁡3t \\\\ {L}^{-1}{\\frac{3}{{s}^{2}+9}} & =\\operatorname{sin}⁡3t\\end{aligned}\n$$\n\nFinally, taking the inverse Laplace transform of $Y(s),$ we get\n\n$$\n\\begin{aligned}y(t) & =-\\frac{1}{15}{L}^{-1}{\\frac{1}{s+6}}+\\frac{1}{15}{L}^{-1}{\\frac{s}{{s}^{2}+9}}+\\frac{1}{5}{L}^{-1}{\\frac{3}{{s}^{2}+9}} \\\\ y(t) & =-\\frac{1}{15}{e}^{-6t}+\\frac{1}{15}\\operatorname{cos}⁡3t+\\frac{1}{5}\\operatorname{sin}⁡3t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317346 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0574318a-232d-5f69-9e15-68afe95d5fca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "continuous" :db/id #edb/ref 17592186315145} {:answer/id #uuid "18d299e5-b7a1-50bc-b7d9-f0bfdaad9949" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "odd" :db/id #edb/ref 17592186315263} {:answer/id #uuid "dd7cd4a5-0a7e-5edd-8d44-9fb5579397b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "piecewise smooth" :db/id #edb/ref 17592186316350} {:answer/id #uuid "e9a1af10-480d-5cfc-b7e3-de3c57cc075d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "even" :db/id #edb/ref 17592186316414}] :answer-field/correct {:answer/id #uuid "dd7cd4a5-0a7e-5edd-8d44-9fb5579397b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "piecewise smooth" :db/id #edb/ref 17592186316350} :answer-field/id #uuid "1757ae18-7f32-544c-baf6-28be3aedc3ed" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316598} {:answer-field/choices [{:answer/id #uuid "2c11f968-2e95-52b9-a2ab-522e32c43fe1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(nx)" :db/id #edb/ref 17592186315378} {:answer/id #uuid "70477c8b-d4b6-5b7f-a6f4-ca0c0ee50276" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{n\\pi x}{3})" :db/id #edb/ref 17592186315750} {:answer/id #uuid "7ec79c86-f689-5ef9-a38e-388e8c829a84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(3n\\pi x)" :db/id #edb/ref 17592186315816} {:answer/id #uuid "a3a21b35-cf30-5dec-9bec-bc167d074164" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{n\\pi x}{3})" :db/id #edb/ref 17592186316042} {:answer/id #uuid "ee5ac8ec-cfc7-547e-8c33-48c44cf8b7eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(nx)" :db/id #edb/ref 17592186316444} {:answer/id #uuid "f5c1eb2b-9266-5913-a75f-4b83e1959f24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "continuous" :db/id #edb/ref 17592186316490} {:answer/id #uuid "f64537eb-26b9-5725-bfd2-d4080e393b5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(3n\\pi x)" :db/id #edb/ref 17592186316493}] :answer-field/correct {:answer/id #uuid "f5c1eb2b-9266-5913-a75f-4b83e1959f24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "continuous" :db/id #edb/ref 17592186316490} :answer-field/id #uuid "2e63e251-8004-5902-bb34-58005f81b826" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316655} {:answer-field/choices [{:answer/id #uuid "2aad3b08-652d-5b65-8cb3-d59a84557b15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "piecewise linear" :db/id #edb/ref 17592186315365} {:answer/id #uuid "36fcec82-462e-57d6-b23c-fb5fa7856404" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "piecewise smooth" :db/id #edb/ref 17592186315438} {:answer/id #uuid "bf7166c7-695b-537b-98d6-d76d2f1212cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "periodic" :db/id #edb/ref 17592186316198}] :answer-field/correct {:answer/id #uuid "36fcec82-462e-57d6-b23c-fb5fa7856404" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "piecewise smooth" :db/id #edb/ref 17592186315438} :answer-field/id #uuid "37ff6bb1-6d34-5c6b-b439-33fee60af799" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316676} {:answer-field/choices [{:answer/id #uuid "cd5691f1-592b-5b69-a58c-920a167de7f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{n\\pi x}{3})" :db/id #edb/ref 17592186316279} {:answer/id #uuid "ce0c043d-5eae-5ed2-9603-09298bc4c93a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{n\\pi x}{3})" :db/id #edb/ref 17592186316281}] :answer-field/correct {:answer/id #uuid "ce0c043d-5eae-5ed2-9603-09298bc4c93a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{n\\pi x}{3})" :db/id #edb/ref 17592186316281} :answer-field/id #uuid "44be650e-57e3-5e7f-a1b5-535d0664b43b" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316702} {:answer-field/choices [{:answer/id #uuid "320a4b1e-355e-5064-94c6-57b1e59ff223" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{108(-1)^{n}}{{n}^{2}{\\pi }^{2}}" :db/id #edb/ref 17592186315409} {:answer/id #uuid "c8c7643d-6d9a-5e78-bd24-b6d113d550e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{36(-1)^{n}}{n\\pi }" :db/id #edb/ref 17592186316250} {:answer/id #uuid "cf74292f-2bae-52c3-8212-e06bff086ed0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{108(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}" :db/id #edb/ref 17592186316289} {:answer/id #uuid "dcb0dae4-982c-5cc7-a4a5-d9e12288703f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{36(-1)^{n+1}}{n\\pi }" :db/id #edb/ref 17592186316345}] :answer-field/correct {:answer/id #uuid "c8c7643d-6d9a-5e78-bd24-b6d113d550e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{36(-1)^{n}}{n\\pi }" :db/id #edb/ref 17592186316250} :answer-field/id #uuid "6098084d-9179-514b-8288-f653800985ea" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316774}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7127629f-cc39-5e9d-b607-fa5f8e083997" :question/math-academy-id "q-342963" :question/problem "Let $f(x)$ be the $6$-periodic extension of the function $F(x)=-3{x}^{2}+1$ defined on $[-3,3).$  Select the correct options in the reasoning below, showing the derivation of the Fourier series of the $6$-periodic extension of $G(x)=-6x$ from the corresponding Fourier series of $f(x).$The Fourier series of $f(x)$ is given by\n\n$$\n-3{x}^{2}+1∼-8+{\\sum }_{n=1}^{\\infty }\\frac{108(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}{{field-1}}.\n$$\n\nSince $f$ is \n{{field-2}}\nand\n{{field-3}}\non $R,$ we may differentiate its Fourier series term-by-term to get\n\n$$\n-6x∼{\\sum }_{n=1}^{\\infty }{{field-4}}\\cdot {{field-5}}.\n$$" :question/worked-solution "First, notice that $F(x)$ is an even function. So, the Fourier series of its $2L$-periodic extension has the form\n\n$$\n\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{L}).\n$$\n\nIn our case, $L=3$ and we are already given the coefficients ${a}_{0}$ and ${a}_{n}$ for $n\\ge 1.$ Thus, the Fourier series of $f(x)$ is given by\n\n$$\nf(x)∼-8+{\\sum }_{n=1}^{\\infty }\\frac{108(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}\\operatorname{cos}⁡(\\frac{n\\pi x}{3}).\n$$\n\nNow, notice that \n\n- the function $F$ is continuously differentiable on $(-3,3),$\n\n- continuous on $[-3,3),$ and\n\n- satisfies $F(-3)=F(3),$ if we extend the value at $x=3$ using the formula $F(x)=-3{x}^{2}+1.$\n\nTherefore, the $6$-periodic extension $f$ is $\\text{continuous}$ and $\\text{piecewise smooth}$ on $R,$ so we may differentiate its Fourier series term-by-term:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(-3{x}^{2}+1) & ∼\\frac{\\text{d}}{\\text{d}x}(-8)+{\\sum }_{n=1}^{\\infty }\\frac{\\text{d}}{\\text{d}x}(\\frac{108(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}\\operatorname{cos}⁡(\\frac{n\\pi x}{3})) \\\\ -6x & ∼0+{\\sum }_{n=1}^{\\infty }\\frac{108(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}\\cdot (-\\frac{n\\pi }{3}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})) \\\\ -6x & ∼{\\sum }_{n=1}^{\\infty }\\frac{-36(-1)^{n+1}}{n\\pi }\\operatorname{sin}⁡(\\frac{n\\pi x}{3}) \\\\ -6x & ∼{\\sum }_{n=1}^{\\infty }\\,\\frac{36(-1)^{n}}{n\\pi }\\cdot \\operatorname{sin}⁡(\\frac{n\\pi x}{3})\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317347 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "164f3127-7671-5404-8953-09e0fea76c35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2\\sqrt{{x}^{3}}}-5\\operatorname{cos}x" :db/id #edb/ref 17592186315247}] :answer-field/correct {:answer/id #uuid "164f3127-7671-5404-8953-09e0fea76c35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2\\sqrt{{x}^{3}}}-5\\operatorname{cos}x" :db/id #edb/ref 17592186315247} :answer-field/id #uuid "4ead05b7-6e52-5257-883b-117555657e43" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316729}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b404face-8b9a-5dc3-b331-958133c51335" :question/math-academy-id "q-342966" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=6\\sqrt{x}+5\\operatorname{cos}⁡x.$\n\n$\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=$ \n{{field-1}}" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(6\\sqrt{x}+5\\operatorname{cos}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(6{x}^{1/2}+5\\operatorname{cos}⁡x) \\\\  & =(\\frac{1}{2})\\cdot 6{x}^{-1/2}+5(-\\operatorname{sin}⁡x) \\\\  & =3{x}^{-1/2}-5\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{-1/2}-5\\operatorname{sin}⁡x) \\\\  & =(-\\frac{1}{2})\\cdot 3{x}^{-3/2}-5\\operatorname{cos}⁡x \\\\  & =-\\frac{3}{2\\sqrt{{x}^{3}}}-5\\operatorname{cos}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317350 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8fe7667-e950-5506-a92f-8a4180c90ce0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186316165}] :answer-field/correct {:answer/id #uuid "b8fe7667-e950-5506-a92f-8a4180c90ce0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186316165} :answer-field/id #uuid "8ef2349f-f4a8-5a93-9bcd-f881264f9bb4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316872}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "63f7bfdc-41d8-518f-af80-7426cf484c38" :question/math-academy-id "q-343050" :question/problem "Calculate ${f}^{′}(x)$ for $f(x)=\\operatorname{cos}⁡x+4\\operatorname{arccos}⁡x.$\n\n${f}^{′}(x)=-\\operatorname{sin}⁡x-\\,$\n{{field-1}}" :question/worked-solution "The formula for the derivative of arccosine is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}⁡x)=-\\frac{1}{\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the formula above, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡x+4\\operatorname{arccos}⁡x) \\\\  & =-\\operatorname{sin}⁡x+4\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}⁡x) \\\\  & =-\\operatorname{sin}⁡x+4(-\\frac{1}{\\sqrt{1-{x}^{2}}}) \\\\  & =-\\operatorname{sin}⁡x-\\frac{4}{\\sqrt{1-{x}^{2}}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317351 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06463bd0-01bc-506d-b971-571a5402c049" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-2{s}^{2}+3s-4}{(s+3)({s}^{2}+4)}" :db/id #edb/ref 17592186315149} {:answer/id #uuid "3d378b48-d3bc-5363-808c-a8f96b331cfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-2{s}^{2}-3s-4}{(s+3)({s}^{2}+4)}" :db/id #edb/ref 17592186315472} {:answer/id #uuid "468be561-283e-5524-ab82-120f224d4090" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-2{s}^{2}-3s-2}{(s+3)({s}^{2}+4)}" :db/id #edb/ref 17592186315528} {:answer/id #uuid "aeb3a790-2d23-5ed2-9168-927ea5c6a9db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{s}^{2}-3s-4}{(s+3)({s}^{2}+4)}" :db/id #edb/ref 17592186316111} {:answer/id #uuid "e15e04f9-a5c7-55b7-8438-6a0324072982" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-2{s}^{2}-3s-4}{(s+1)({s}^{2}+4)}" :db/id #edb/ref 17592186316368}] :answer-field/correct {:answer/id #uuid "3d378b48-d3bc-5363-808c-a8f96b331cfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-2{s}^{2}-3s-4}{(s+3)({s}^{2}+4)}" :db/id #edb/ref 17592186315472} :answer-field/id #uuid "1db3fd05-40f3-5f63-bac7-ad8d49bc4551" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316614} {:answer-field/choices [{:answer/id #uuid "0195b45c-ec57-547b-a34a-c6fb3730e265" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-3t}-\\operatorname{cos}⁡2t" :db/id #edb/ref 17592186315125} {:answer/id #uuid "85f8c86b-97a6-5594-83dd-cfdf53dd65e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{e}^{-3t}-\\operatorname{cos}⁡2t" :db/id #edb/ref 17592186315866} {:answer/id #uuid "e6b74c30-296a-55e4-9243-a94e5720eefb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{e}^{-3t}+\\operatorname{cos}⁡2t" :db/id #edb/ref 17592186316395} {:answer/id #uuid "f14c58f5-1028-5c49-9498-4fa870884bb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{e}^{-3t}-\\operatorname{sin}⁡2t" :db/id #edb/ref 17592186316461}] :answer-field/correct {:answer/id #uuid "85f8c86b-97a6-5594-83dd-cfdf53dd65e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{e}^{-3t}-\\operatorname{cos}⁡2t" :db/id #edb/ref 17592186315866} :answer-field/id #uuid "34e07b27-e561-5526-8490-7c4c7c666936" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316671} {:answer-field/choices [{:answer/id #uuid "0c42f52e-06bd-52e2-95d3-14aef2760932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{s+3}-\\frac{s}{{s}^{2}+4}" :db/id #edb/ref 17592186315190} {:answer/id #uuid "916b8837-a7c4-518a-8c62-6b08a8d8b906" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{s+3}-\\frac{s}{{s}^{2}+4}" :db/id #edb/ref 17592186315929} {:answer/id #uuid "b4da5379-6c12-542e-abc1-899c39aec7a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{s+3}+\\frac{s}{{s}^{2}+4}" :db/id #edb/ref 17592186316141} {:answer/id #uuid "ea796d2d-091a-5239-843e-5556c9bc8def" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{s+3}-\\frac{s}{{s}^{2}+4}" :db/id #edb/ref 17592186316421}] :answer-field/correct {:answer/id #uuid "ea796d2d-091a-5239-843e-5556c9bc8def" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{s+3}-\\frac{s}{{s}^{2}+4}" :db/id #edb/ref 17592186316421} :answer-field/id #uuid "c28a283a-279e-5531-8559-3c90d0e4d547" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186317008}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "60f30b7a-ba21-59d7-b0c6-278dc23eb425" :question/math-academy-id "q-343063" :question/problem "Consider the following initial value problem.\n\n$$\n\\frac{\\text{d}y}{\\text{d}t}+3y=2\\operatorname{sin}⁡2t-3\\operatorname{cos}⁡2t,\\,y(0)=-2\n$$\n\nSelect the correct options in the reasoning below to find the solution using Laplace transforms. You may make use of the following results:\n\n$$\nL{\\operatorname{sin}⁡\\omega t}=\\frac{\\omega }{{s}^{2}+{\\omega }^{2}},\\,L{\\operatorname{cos}⁡\\omega t}=\\frac{s}{{s}^{2}+{\\omega }^{2}},\\,s>0.\n$$\n\nLet $Y(s)=L{y(t)}.$ Taking the Laplace transform of both sides of the equation and solving for $Y,$ we have\n\n$$\nY(s)={{field-1}}.\n$$\n\nThe partial fraction decomposition of $Y$ is\n\n$$\nY(s)={{field-2}}.\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny(t)={{field-3}}.\n$$" :question/worked-solution "First, we take the Laplace transform of both sides of the differential equation. Using the linearity property, we have\n\n$$\nL{{y}^{′}}+3L{y}=2L{\\operatorname{sin}⁡2t}-3L{\\operatorname{cos}⁡2t}.\n$$\n\nUsing the formula for the transform of a derivative $L{{y}^{′}}=sY(s)-y(0)$ and the standard trigonometric transforms\n\n$$\nL{\\operatorname{sin}⁡2t}=\\frac{2}{{s}^{2}+4},\\,L{\\operatorname{cos}⁡2t}=\\frac{s}{{s}^{2}+4},\n$$\n\nwe substitute the known values. Note that $y(0)=-2:$\n\n$$\n\\begin{aligned}(sY(s)-(-2))+3Y(s) & =2(\\frac{2}{{s}^{2}+4})-3(\\frac{s}{{s}^{2}+4}) \\\\ (s+3)Y(s)+2 & =\\frac{4-3s}{{s}^{2}+4}\\end{aligned}\n$$\n\nWe rearrange to solve for $Y(s).$ First, subtract $2$ from the right-hand side and find a common denominator:\n\n$$\n\\begin{aligned}(s+3)Y(s) & =\\frac{4-3s}{{s}^{2}+4}-2 \\\\ (s+3)Y(s) & =\\frac{4-3s}{{s}^{2}+4}-\\frac{2({s}^{2}+4)}{{s}^{2}+4} \\\\ (s+3)Y(s) & =\\frac{-2{s}^{2}-3s-4}{{s}^{2}+4}\\end{aligned}\n$$\n\nDividing by $(s+3),$ we obtain\n\n$$\nY(s)=\\frac{-2{s}^{2}-3s-4}{(s+3)({s}^{2}+4)}.\n$$\n\nNext, we perform a partial fraction decomposition. Since the denominator has a linear factor $(s+3)$ and an irreducible quadratic factor $({s}^{2}+4),$ we write\n\n$$\n\\frac{-2{s}^{2}-3s-4}{(s+3)({s}^{2}+4)}=\\frac{A}{s+3}+\\frac{Bs+C}{{s}^{2}+4}.\n$$\n\nTo find the constants, we clear the denominators:\n\n$$\n-2{s}^{2}-3s-4=A({s}^{2}+4)+(Bs+C)(s+3)\n$$\n\n- Setting $s=-3,$ we have\n \n\n$$\n-2(-3)^{2}-3(-3)-4=A((-3)^{2}+4)+0\\,⟹\\,-13=13A\\,⟹\\,A=-1.\n$$\n\n- Comparing the coefficients of ${s}^{2},$ we have\n  \n\n$$\n-2=A+B\\,⟹\\,-2=-1+B\\,⟹\\,B=-1.\n$$\n\n- Comparing the constant terms, we have\n \n\n$$\n-4=4A+3C\\,⟹\\,-4=4(-1)+3C\\,⟹\\,C=0.\n$$\n\nThus, the decomposition is\n\n$$\nY(s)=-\\frac{1}{s+3}+\\frac{-s}{{s}^{2}+4}=-\\frac{1}{s+3}-\\frac{s}{{s}^{2}+4}.\n$$\n\nFrom the table of Laplace transforms, we have:\n\n$$\n\\begin{aligned}{L}^{-1}{\\frac{1}{s+3}} & ={e}^{-3t} \\\\ {L}^{-1}{\\frac{s}{{s}^{2}+4}} & =\\operatorname{cos}⁡2t\\end{aligned}\n$$\n\nFinally, taking the inverse Laplace transform of $Y(s),$ we get\n\n$$\n\\begin{aligned}y(t) & =-{L}^{-1}{\\frac{1}{s+3}}-{L}^{-1}{\\frac{s}{{s}^{2}+4}} \\\\ y(t) & =-{e}^{-3t}-\\operatorname{cos}⁡2t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317362 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ec5f87f-9270-584d-aa85-8ec2245ee243" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{10}^{t}" :db/id #edb/ref 17592186315569}] :answer-field/correct {:answer/id #uuid "4ec5f87f-9270-584d-aa85-8ec2245ee243" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{10}^{t}" :db/id #edb/ref 17592186315569} :answer-field/id #uuid "c24554c4-5641-57c6-a274-4ab338fde6ef" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317006}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "224166c5-b66f-5ed1-bc58-63e5ea30c6cd" :question/math-academy-id "q-343160" :question/problem "The number of views $V,$ in millions, of a viral video after $t$ days is modeled by $V(t)=\\frac{{10}^{t}}{\\operatorname{ln}⁡10}$ for $0\\le t\\le 6.$ What is the instantaneous rate of change of the number of views as a function of $t?$\n\nThe instantaneous rate of change is\n{{field-1}} views per day." :question/worked-solution "The instantaneous rate of change of the number of views is equal to ${V}^{′}(t).$ \n\nFirst, we take the derivative and get\n\n$$\n\\begin{aligned}{V}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{{10}^{t}}{\\operatorname{ln}⁡10}) \\\\  & =\\frac{{10}^{t}\\cdot \\operatorname{ln}⁡10}{\\operatorname{ln}⁡10} \\\\  & ={10}^{t}.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change of the number of views is ${10}^{t}.$"} {:db/id #edb/ref 17592186317367 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "352a4a98-711e-5daf-a9a7-cb6c59b4a6a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{2}" :db/id #edb/ref 17592186315428}] :answer-field/correct {:answer/id #uuid "352a4a98-711e-5daf-a9a7-cb6c59b4a6a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{2}" :db/id #edb/ref 17592186315428} :answer-field/id #uuid "fc7b5b25-9f87-565d-bb02-622c4b9fbc38" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317146}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d1c4a7f6-dfa8-527f-a427-71639bc74bac" :question/math-academy-id "q-343173" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\,\\infty }\\frac{7}{\\pi }(\\operatorname{arctan}⁡(6-x))=$\n{{field-1}}" :question/worked-solution "First, let's sketch the graph of $y=\\operatorname{arctan}⁡(6-x):$ \n\n![](images/04/04dd8257ef32291b930aa29f5bed4de2c41761692fd48d08ed2479f6cbd78659.png)\n\nThe domain of $\\operatorname{arctan}⁡(6-x)$ is $(-\\infty ,\\infty ).$ Moreover, from the graph, we see that\n\n$$\n{lim}_{x\\to \\infty }\\operatorname{arctan}⁡(6-x)=-\\frac{\\pi }{2}.\n$$\n\nTherefore,\n\n$$\n{lim}_{x\\to \\,\\infty }\\frac{7}{\\pi }(\\operatorname{arctan}⁡(6-x))=\\frac{7}{\\pi }\\cdot (-\\frac{\\pi }{2})=-\\frac{7}{2}.\n$$"} {:db/id #edb/ref 17592186317368 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d7baa51a-91a1-5787-bc67-a1f0ff0f3e11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186316322}] :answer-field/correct {:answer/id #uuid "d7baa51a-91a1-5787-bc67-a1f0ff0f3e11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186316322} :answer-field/id #uuid "8f9e6a31-e2dd-5d07-852e-47b2fce10fea" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316875}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fff73ba7-51c3-55f6-9993-4fc2cbedd36a" :question/math-academy-id "q-343215" :question/problem "Find the exact value of the slope $m$ of the tangent line to the curve $y=2\\operatorname{arccos}⁡(1+x)$ at $x=-1.$\n\n$m=$\n{{field-1}}" :question/worked-solution "The formula for the derivative of arccosine is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}⁡x)=-\\frac{1}{\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}[2\\operatorname{arccos}⁡(1+x)] \\\\  & =2(-\\frac{1}{\\sqrt{1-(1+x)^{2}}})\\cdot \\frac{\\text{d}}{\\text{d}x}(1+x) \\\\  & =-\\frac{2}{\\sqrt{1-(1+2x+{x}^{2})}} \\\\  & =-\\frac{2}{\\sqrt{-2x-{x}^{2}}}.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent line to the curve at $x=-1$ is\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{x=-1} \\\\  & =-\\frac{2}{\\sqrt{-2(-1)-(-1)^{2}}} \\\\  & =-2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317372 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "102c20a7-364b-5e1d-8e5b-1a8f7adb1463" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "even" :db/id #edb/ref 17592186315216} {:answer/id #uuid "8f4a5b80-b993-5acb-b1fc-0027ff1b76db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "continuous" :db/id #edb/ref 17592186315921} {:answer/id #uuid "9bfc4594-abfa-5c41-b497-cf307852b689" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "odd" :db/id #edb/ref 17592186315989}] :answer-field/correct {:answer/id #uuid "8f4a5b80-b993-5acb-b1fc-0027ff1b76db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "continuous" :db/id #edb/ref 17592186315921} :answer-field/id #uuid "5244a3bb-594f-53ba-b2ef-f72d466a2fc7" :answer-field/key "field-2" :answer-field/type {:db/id 