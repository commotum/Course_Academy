field.type/select} :db/id #edb/ref 17592186317002} {:answer-field/choices [{:answer/id #uuid "103a311b-6837-5aa1-b2e0-7d1ceba394e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186315217} {:answer/id #uuid "711120c9-6920-5a47-9c36-a481b0f8923f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{8}" :db/id #edb/ref 17592186315759} {:answer/id #uuid "c3328fd8-a582-53de-9cd2-efd19d1100c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{4}" :db/id #edb/ref 17592186316215} {:answer/id #uuid "e0a5aafe-207d-58af-a17d-6e2bb04ce27c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186316363}] :answer-field/correct {:answer/id #uuid "e0a5aafe-207d-58af-a17d-6e2bb04ce27c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186316363} :answer-field/id #uuid "ce9feec9-f3c6-5510-bc50-0395fa9771a9" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186317036}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0d801752-c780-5add-95cf-b3a0d0a59bd1" :question/math-academy-id "q-343429" :question/problem "$$\nF(x)=\\{\\begin{aligned}-1, & x\\in [-2,0] \\\\ 2, & x\\in (0,2)\\end{aligned}\n$$\n\nConsider the function $F(x)$ shown above. The Fourier series of the $4$-periodic extension $f(x)$ of $F(x)$ is given by\n\n$$\nf(x)∼\\frac{1}{2}+{\\sum }_{n=1}^{\\infty }\\frac{6}{\\pi (2n-1)}sin\\,(\\frac{(2n-1)\\pi x}{2}).\n$$\n\nSelect the correct options in the reasoning below.\n\nAt $x=1,$ we have\n\n$$\nsin\\,(\\frac{(2n-1)\\pi }{2})={{field-1}}.\n$$\n\nSince $f(x)$ is \n{{field-2}}\nat $x=1,$ the corresponding Fourier series converges to \n\n$$\nf(1)={{field-3}}.\n$$\n\nTherefore, we have \n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{2n-1}={{field-4}}.\n$$" :question/worked-solution "First, we rewrite our Fourier series as\n\n$$\nf(x)∼\\frac{1}{2}+\\frac{6}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot sin\\,(\\frac{(2n-1)\\pi x}{2}).\n$$\n\nNow, notice that at $x=1,$ we have\n\n$$\nsin\\,(\\frac{(2n-1)\\pi }{2})=sin\\,(-\\frac{\\pi }{2}+n\\pi )=(-1)^{n+1}.\n$$\n\nSince $f(x)$ is $\\text{continuous}$ at $x=1,$ the corresponding Fourier series converges to \n\n$$\nf(1)=2.\n$$\n\n \n\nTherefore, we have \n\n$$\n\\begin{aligned}f(1) & =\\frac{1}{2}+\\frac{6}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot sin\\,(\\frac{(2n-1)\\pi \\cdot 1}{2}) \\\\ 2 & =\\frac{1}{2}+\\frac{6}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot (-1)^{n+1} \\\\ \\frac{3}{2} & =\\frac{6}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{2n-1} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{2n-1} & =\\frac{\\pi }{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317402 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3303fe09-6ad0-505a-89d8-a19574971d07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186315415} {:answer/id #uuid "69514901-5c64-5d07-b95a-d45b7fa88118" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186315712} {:answer/id #uuid "a1035538-7e14-55b0-ac2d-8d7e5266d7f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186316026}] :answer-field/correct {:answer/id #uuid "a1035538-7e14-55b0-ac2d-8d7e5266d7f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186316026} :answer-field/id #uuid "1b0e268d-0a7c-5c87-942a-0d527b2e7230" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316610} {:answer-field/choices [{:answer/id #uuid "526509c1-9276-5c3d-8d48-c9645209f961" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186315588} {:answer/id #uuid "55ea1062-c9e1-5062-8d07-1555f9a98009" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{8}" :db/id #edb/ref 17592186315611} {:answer/id #uuid "b78b7f35-d5d7-5ae4-be39-18600507be7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{4}" :db/id #edb/ref 17592186316159} {:answer/id #uuid "ca0c938c-160a-52cd-8dd0-6140a987639e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186316255}] :answer-field/correct {:answer/id #uuid "526509c1-9276-5c3d-8d48-c9645209f961" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186315588} :answer-field/id #uuid "26f1fe62-5fe6-5d2f-a137-b4f3a4585631" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316633} {:answer-field/choices [{:answer/id #uuid "3b65ed1d-642e-56f2-bfbe-4ef0a45f2f92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "continuous" :db/id #edb/ref 17592186315459} {:answer/id #uuid "b855acb5-e97c-5841-8d72-85aa1b7718a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "discontinuous" :db/id #edb/ref 17592186316161}] :answer-field/correct {:answer/id #uuid "3b65ed1d-642e-56f2-bfbe-4ef0a45f2f92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "continuous" :db/id #edb/ref 17592186315459} :answer-field/id #uuid "32132a2d-5a62-506e-a3d9-84e46c8a7381" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316663} {:answer-field/choices [{:answer/id #uuid "0c35aee6-7694-50b8-99ff-38af1b21180b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186315189} {:answer/id #uuid "13531dbc-f785-5e13-9d29-9d280d8db742" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1)^{n+1}" :db/id #edb/ref 17592186315233} {:answer/id #uuid "4e9a9a9c-8530-5ab3-8a17-1e2278aba947" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1)^{n}" :db/id #edb/ref 17592186315567} {:answer/id #uuid "9666b55d-0e86-50aa-b086-53a192b7da15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186315952}] :answer-field/correct {:answer/id #uuid "4e9a9a9c-8530-5ab3-8a17-1e2278aba947" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1)^{n}" :db/id #edb/ref 17592186315567} :answer-field/id #uuid "4f23a1a7-b2fc-50dd-b7d3-dea39ae4eda7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316731}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0b3adfef-3238-5b0a-8f95-7aed0a3d3235" :question/math-academy-id "q-343443" :question/problem "$$\nF(x)=\\{\\begin{aligned}3, & x\\in [-\\pi ,0] \\\\ -5, & x\\in (0,\\pi )\\end{aligned}\n$$\n\nConsider the function $F(x)$ shown above. The Fourier series of the $2\\pi $-periodic extension $f(x)$ of $F(x)$ is given by\n\n$$\nf(x)∼-1-{\\sum }_{n=1}^{\\infty }\\frac{16}{\\pi (2n-1)}sin\\,((2n-1)x).\n$$\n\nSelect the correct options in the reasoning below.\n\nAt $x=-\\frac{\\pi }{2},$ we have\n\n$$\nsin\\,((2n-1)\\cdot (-\\frac{\\pi }{2}))={{field-1}}.\n$$\n\nSince $f(x)$ is \n{{field-2}}\nat $x=-\\frac{\\pi }{2},$ the corresponding Fourier series converges to \n\n$$\nf(-\\frac{\\pi }{2})={{field-3}}.\n$$\n\nTherefore, we have \n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{2n-1}={{field-4}}.\n$$" :question/worked-solution "First, we rewrite our Fourier series as\n\n$$\nf(x)∼-1-\\frac{16}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot sin\\,((2n-1)x).\n$$\n\nNow, notice that at $x=-\\frac{\\pi }{2},$ we have\n\n$$\nsin\\,((2n-1)\\cdot (-\\frac{\\pi }{2}))=sin\\,(\\frac{\\pi }{2}-n\\pi )=(-1)^{n}.\n$$\n\nSince $f(x)$ is $\\text{continuous}$ at $x=-\\frac{\\pi }{2},$ the corresponding Fourier series converges to \n\n$$\nf(-\\frac{\\pi }{2})=3.\n$$\n\n \n\nTherefore, we have \n\n$$\n\\begin{aligned}f(-\\frac{\\pi }{2}) & =-1-\\frac{16}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot sin\\,((2n-1)\\cdot (-\\frac{\\pi }{2})) \\\\ 3 & =-1-\\frac{16}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot (-1)^{n} \\\\ 4 & =-\\frac{16}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{2n-1} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{2n-1} & =-\\frac{\\pi }{4} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{2n-1} & =\\frac{\\pi }{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317407 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f45030f2-0041-5820-add0-2a3dfa9f4167" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{C}{2\\pi }" :db/id #edb/ref 17592186316481}] :answer-field/correct {:answer/id #uuid "f45030f2-0041-5820-add0-2a3dfa9f4167" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{C}{2\\pi }" :db/id #edb/ref 17592186316481} :answer-field/id #uuid "42e2bc2d-4552-549d-a247-cd72a77a9fdd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316699}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1381662a-cc6b-586a-8c7d-1d07a1ad3310" :question/math-academy-id "q-343491" :question/problem "![](images/c6/c63dfe563c07b143bdc7cc28ab4d1142bea8c455be31ce924fa310c5e4903305.png)\n\nThe area $A$ of the circular disk above is changing as the circle expands. The circumference and radius of the circle are $C$ and $r,$ respectively. \nFind the rate of change of the area of the circle with respect to its circumference.\n\nThe rate of change of the area of the circle with respect to its circumference $C$ is\n{{field-1}}." :question/worked-solution "The area of a circle is given by\n\n$$\nA=\\pi {r}^{2},\n$$\n\nwhere $r$ is the radius of the circle.\n\nWe know that $C=2\\pi r,$ so we can express the area $A$ as a function of the circumference $C$ by substituting $r=\\frac{C}{2\\pi }$ into the formula above. We get\n\n$$\nA=\\pi {r}^{2}=\\pi {(\\frac{C}{2\\pi })}^{2}=\\frac{{C}^{2}}{4\\pi }.\n$$\n\nTherefore, the rate of change of $A(C)$ with respect to $C$ is\n\n$$\n\\begin{aligned}{A}^{′}(C) & =\\frac{\\text{d}}{\\text{d}C}(\\frac{{C}^{2}}{4\\pi }) \\\\  & =\\frac{1}{4\\pi }\\frac{\\text{d}}{\\text{d}C}({C}^{2}) \\\\  & =\\frac{1}{4\\pi }(2C) \\\\  & =\\frac{C}{2\\pi }.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317412 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a36b37d-bc34-5c1e-abe5-aba0572d9529" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{\\pi }" :db/id #edb/ref 17592186315359}] :answer-field/correct {:answer/id #uuid "2a36b37d-bc34-5c1e-abe5-aba0572d9529" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{\\pi }" :db/id #edb/ref 17592186315359} :answer-field/id #uuid "4561e01a-704e-54aa-a836-dee4e008d320" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316704}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f1cf5087-7d07-5a4d-8585-5e5e761a770e" :question/math-academy-id "q-343546" :question/problem "Find the slope $m$ of the tangent line to the curve $f(x)=\\frac{\\operatorname{cos}⁡3x}{x}$ at $x=\\frac{\\pi }{2}.$\n\n$m=$\n{{field-1}}" :question/worked-solution "We use the quotient rule with the numerator $u(x)=\\operatorname{cos}⁡(3x)$ and the denominator $v(x)=x.$\n\nDifferentiating $u(x)$ and $v(x),$ we have\n\n$$\n{u}^{′}(x)=-3\\operatorname{sin}⁡(3x),\\,{v}^{′}(x)=1.\n$$\n\nNote that we used the chain rule to differentiate $u.$\n\nNow, applying the quotient rule and simplifying, we have\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(-3\\operatorname{sin}⁡(3x))(x)-(\\operatorname{cos}⁡(3x))(1)}{{x}^{2}} \\\\  & =\\frac{-3x\\operatorname{sin}⁡(3x)-\\operatorname{cos}⁡(3x)}{{x}^{2}}.\\end{aligned}\\end{aligned}\n$$\n\nTherefore, the slope at $x=\\frac{\\pi }{2}$ is\n\n$$\n\\begin{aligned}m & ={f}^{′}\\,(\\frac{\\pi }{2}) \\\\  & =\\frac{-3(\\frac{\\pi }{2})sin\\,(\\frac{3\\pi }{2})-cos\\,(\\frac{3\\pi }{2})}{{(\\frac{\\pi }{2})}^{2}} \\\\  & =\\frac{-3(\\frac{\\pi }{2})(-1)-0}{\\frac{{\\pi }^{2}}{4}} \\\\  & =\\frac{6}{\\pi }.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317413 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1ec7b37-0e0f-5b16-906d-eb3941525db8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186316029}] :answer-field/correct {:answer/id #uuid "a1ec7b37-0e0f-5b16-906d-eb3941525db8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186316029} :answer-field/id #uuid "d86e0bf2-a380-54e0-abb9-956e3c80ef20" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317059}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "517deff4-9d3f-5d53-8827-44c3d53aae87" :question/math-academy-id "q-343557" :question/problem "Consider the parabola ${y}^{2}-20x=0.$ Given that $x=x(t),$ $y=y(t),$ and that $\\frac{\\text{d}x}{\\text{d}t}=\\frac{3}{10}$ on the curve at the point $(5,10),$ find the value of  $\\frac{\\text{d}y}{\\text{d}t}$ at that point.\n\n$\\frac{\\text{d}y}{\\text{d}t}=$\n{{field-1}}" :question/worked-solution "Differentiating the given relation with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}{y}^{2}-20x & =0 \\\\ \\frac{\\text{d}}{\\text{d}t}({y}^{2}-20x) & =\\frac{\\text{d}}{\\text{d}t}(0) \\\\ \\frac{\\text{d}}{\\text{d}t}({y}^{2})-\\frac{\\text{d}}{\\text{d}t}(20x) & =0 \\\\ \\frac{\\text{d}y}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}y}({y}^{2})-\\frac{\\text{d}x}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}x}(20x) & =0 \\\\ \\frac{\\text{d}y}{\\text{d}t}\\cdot (2y)-\\frac{\\text{d}x}{\\text{d}t}\\cdot 20 & =0.\\end{aligned}\n$$\n\nNow, substituting the given information $\\frac{\\text{d}x}{\\text{d}t}=\\frac{3}{10},$ $x=5,$ and $y=10,$ and solving for $\\frac{\\text{d}y}{\\text{d}t},$ we get \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t}\\cdot (2y)-\\frac{\\text{d}x}{\\text{d}t}\\cdot 20 & =0 \\\\ \\frac{\\text{d}y}{\\text{d}t}\\cdot (2\\cdot 10)-(\\frac{3}{10})\\cdot 20 & =0 \\\\ 20\\cdot \\frac{\\text{d}y}{\\text{d}t}-6 & =0 \\\\ 20\\cdot \\frac{\\text{d}y}{\\text{d}t} & =6 \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{3}{10}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317420 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d4de519-7dc3-5a63-91dc-88fb097de927" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186315559}] :answer-field/correct {:answer/id #uuid "4d4de519-7dc3-5a63-91dc-88fb097de927" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186315559} :answer-field/id #uuid "80e5b3fd-f8d6-55a8-9a84-9bc4da788fc1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316851}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9c255544-1d5d-5734-8a75-e3f42b3984e9" :question/math-academy-id "q-343679" :question/problem "A particle of mass $0.8\\,\\text{kg}$ is attached to a massless spring. An external periodic force $F(t)=2cos\\,(\\frac{5}{2}t)\\,\\text{N}$ is applied to the particle.\n\nThe position of the particle is $y(t)$ (measured in meters), and $t>0$ is the time in seconds. If the particle moves with forced harmonic motion without damping and the system experiences resonance, what is the spring constant $k?$\n\n$k=$\n{{field-1}}${\\text{kg/s}}^{2}$" :question/worked-solution "The equation of motion for a particle of mass $m$ moving with forced harmonic motion without damping under the action of a spring with spring constant $k$ and external force $F(t)$ is given by\n\n$$\nm{y}^{″}=-ky+F(t).\n$$\n\nSubstituting our values for $m$ and $F(t)$ gives\n\n$$\n0.8{y}^{″}=-ky+2cos\\,(\\frac{5}{2}t).\n$$\n\nSimplifying and rearranging the above equation, we get\n\n$$\n{y}^{″}+\\frac{5k}{4}y=\\frac{5}{2}cos\\,(\\frac{5}{2}t).\n$$\n\nThe complementary solution ${y}_{c}$ here represents simple harmonic motion, and it can be written as\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t,\n$$\n\nwhere $A$ and $B$ are arbitrary constants of integration, and $\\omega $ is the system's internal frequency.\n\nIn our case,\n\n$$\n{\\omega }^{2}=\\frac{5k}{4}\\,⟹\\,k=\\frac{4}{5}{\\omega }^{2}.\n$$\n\nThe oscillator experiences resonance when the frequency of the external periodic force $f(t)=\\frac{5}{2}cos\\,(\\frac{5}{2}t),$ which is $\\frac{5}{2},$ is equal to the frequency of the complementary solution $\\omega .$\n\nTherefore,\n\n$$\nk=\\frac{4}{5}{\\omega }^{2}=\\frac{4}{5}\\cdot {(\\frac{5}{2})}^{2}=5\\,{\\text{kg/s}}^{2}.\n$$"} {:db/id #edb/ref 17592186317426 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "136b6bc8-8153-5df8-a7bb-b1c0b8f33d00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186315235}] :answer-field/correct {:answer/id #uuid "136b6bc8-8153-5df8-a7bb-b1c0b8f33d00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186315235} :answer-field/id #uuid "1eaebf75-d5e2-5d17-abf3-5de30e8eb341" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316617}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5563b807-3ce9-515c-a365-9e78582b198e" :question/math-academy-id "q-343738" :question/problem "$$\n\nConsider the curve $x\\operatorname{cos}⁡y=2.$ Given that $x=x(t),\\text{ }y=y(t),$ and that $\\frac{\\text{d}x}{\\text{d}t}=6$ on the curve at the point $(4,\\frac{\\pi }{3}),$ find the value of $\\frac{\\text{d}y}{\\text{d}t}$ at that point. Do not round the answer.\n\n$\\frac{\\text{d}y}{\\text{d}t}=$\n{{field-1}}" :question/worked-solution "Differentiating the given relation with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(x\\operatorname{cos}⁡y) & =\\frac{\\text{d}}{\\text{d}t}(2) \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot \\operatorname{cos}⁡y-x\\cdot \\operatorname{sin}⁡y\\cdot \\frac{\\text{d}y}{\\text{d}t} & =0.\\end{aligned}\n$$\n\nNow, substituting the given information $\\frac{\\text{d}x}{\\text{d}t}=6,$ $x=4,$ and $y=\\frac{\\pi }{3},$ and solving for $\\frac{\\text{d}y}{\\text{d}t},$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t}\\cdot \\operatorname{cos}⁡y-x\\cdot \\operatorname{sin}⁡y\\cdot \\frac{\\text{d}y}{\\text{d}t} & =0 \\\\ 6\\cdot \\operatorname{cos}⁡(\\frac{\\pi }{3})-4\\cdot \\operatorname{sin}⁡(\\frac{\\pi }{3})\\cdot \\frac{\\text{d}y}{\\text{d}t} & =0 \\\\ 6\\cdot \\frac{1}{2}-4\\cdot \\frac{\\sqrt{3}}{2}\\cdot \\frac{\\text{d}y}{\\text{d}t} & =0 \\\\ 3-2\\sqrt{3}\\cdot \\frac{\\text{d}y}{\\text{d}t} & =0 \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317443 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c374525-0d10-5050-a300-a79dcfbe1344" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186315379} {:answer/id #uuid "30db2edc-6f08-58d8-870f-a953379c323f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186315396} {:answer/id #uuid "68b802ec-a75e-510e-92f8-96b459e2052d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186315709} {:answer/id #uuid "fdcf3171-8f8f-58d3-b834-e5adb23c8e12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186316539}] :answer-field/correct {:answer/id #uuid "fdcf3171-8f8f-58d3-b834-e5adb23c8e12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186316539} :answer-field/id #uuid "18004c40-7610-5c60-8808-ea9e4b8d8d4b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316600} {:answer-field/choices [{:answer/id #uuid "26f91b7c-20bf-51fd-a393-6190c6c8e355" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{24}{{n}^{2}({n}^{2}{\\pi }^{2}+36)}" :db/id #edb/ref 17592186315338} {:answer/id #uuid "3890626f-6d86-591f-9835-41dc0785b07c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{n({n}^{2}{\\pi }^{2}+36)}" :db/id #edb/ref 17592186315443} {:answer/id #uuid "c23d6f0d-4068-5f82-916d-ff3b5f243150" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{{n}^{2}({n}^{2}{\\pi }^{2}+36)}" :db/id #edb/ref 17592186316211}] :answer-field/correct {:answer/id #uuid "3890626f-6d86-591f-9835-41dc0785b07c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{n({n}^{2}{\\pi }^{2}+36)}" :db/id #edb/ref 17592186315443} :answer-field/id #uuid "58145300-29fc-5a90-a84c-4bf31179dc08" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316750} {:answer-field/choices [{:answer/id #uuid "f0962404-85c9-5e1a-8305-8c121059d764" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{36}{{n}^{2}\\pi ({n}^{2}{\\pi }^{2}+36)}" :db/id #edb/ref 17592186316458} {:answer/id #uuid "f48b2e93-6f81-57a4-9d61-664c45eb47e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{72}{{n}^{2}\\pi ({n}^{2}{\\pi }^{2}+36)}" :db/id #edb/ref 17592186316483} {:answer/id #uuid "f95e153a-270c-5fbb-9ed6-cc3b5cab48dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{24}{n\\pi ({n}^{2}{\\pi }^{2}+36)}" :db/id #edb/ref 17592186316510}] :answer-field/correct {:answer/id #uuid "f48b2e93-6f81-57a4-9d61-664c45eb47e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{72}{{n}^{2}\\pi ({n}^{2}{\\pi }^{2}+36)}" :db/id #edb/ref 17592186316483} :answer-field/id #uuid "c413fdfb-1b7f-5850-8061-58d3e5250a37" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186317013}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ae77a2f6-2db6-5433-96eb-14517b11c7c7" :question/math-academy-id "q-343854" :question/problem "Select the missing parts in a particular solution of the differential equation ${y}^{′}-2y=f(x),$ where the Fourier series of the $6$-periodic forcing function is given by\n\n$$\nf(x)∼-2+{\\sum }_{n=1}^{\\infty }\\frac{4}{{n}^{2}\\pi }\\operatorname{cos}⁡(\\frac{n\\pi x}{3}).\n$$\n\nThe Fourier series of a particular solution is\n\n$$\n\\begin{aligned}{y}_{p}∼{{field-1}} & +{\\sum }_{n=1}^{\\infty }\\,{{field-2}}\\cdot \\operatorname{cos}⁡(\\frac{n\\pi x}{3}) \\\\  & +{\\sum }_{n=1}^{\\infty }\\,{{field-3}}\\cdot \\operatorname{sin}⁡(\\frac{n\\pi x}{3})\\end{aligned}\n$$" :question/worked-solution "We assume that a solution of our equation has the following Fourier series:\n\n$$\n{y}_{p}∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{3})+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{3}).\n$$\n\nNow, we compute the derivative:\n\n$$\n\\begin{aligned}{y}_{p}^{′} & ∼\\frac{\\text{d}}{\\text{d}x}(\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{3})+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})) \\\\  & ∼0+{\\sum }_{n=1}^{\\infty }{a}_{n}\\cdot (-\\frac{n\\pi }{3}\\operatorname{sin}⁡(\\frac{n\\pi x}{3}))+{b}_{n}\\cdot \\frac{n\\pi }{3}\\operatorname{cos}⁡(\\frac{n\\pi x}{3}) \\\\  & ∼{\\sum }_{n=1}^{\\infty }-\\frac{{a}_{n}n\\pi }{3}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})+\\frac{{b}_{n}n\\pi }{3}\\operatorname{cos}⁡(\\frac{n\\pi x}{3})\\end{aligned}\n$$\n\nNext, we substitute the expressions for ${y}_{p}^{′}$ and ${y}_{p}$ into the equation:\n\n$$\n\\begin{aligned} & ({\\sum }_{n=1}^{\\infty }-\\frac{{a}_{n}n\\pi }{3}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})+\\frac{{b}_{n}n\\pi }{3}\\operatorname{cos}⁡(\\frac{n\\pi x}{3})) \\\\  & \\,-2(\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{3})+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})) \\\\  & \\,\\,=-2+{\\sum }_{n=1}^{\\infty }\\frac{4}{{n}^{2}\\pi }\\operatorname{cos}⁡(\\frac{n\\pi x}{3})\\end{aligned}\n$$\n\nRearranging the terms, we get \n\n$$\n\\begin{aligned} & -2\\cdot \\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }(\\frac{{b}_{n}n\\pi }{3}-2{a}_{n})\\operatorname{cos}⁡(\\frac{n\\pi x}{3}) \\\\  & \\,\\,+{\\sum }_{n=1}^{\\infty }(-\\frac{{a}_{n}n\\pi }{3}-2{b}_{n})\\operatorname{sin}⁡(\\frac{n\\pi x}{3}) \\\\  & \\,\\,\\,\\,=-2+{\\sum }_{n=1}^{\\infty }\\frac{4}{{n}^{2}\\pi }\\operatorname{cos}⁡(\\frac{n\\pi x}{3}).\\end{aligned}\n$$\n\nNow, equating the free terms and the coefficients next to sines and cosines, we obtain the following system:\n\n$$\n\\left\\{\\begin{aligned}-2\\cdot \\frac{{a}_{0}}{2} &=-2 \\\\ \\frac{{b}_{n}n\\pi }{3}-2{a}_{n} &=\\frac{4}{{n}^{2}\\pi } \\\\ -\\frac{{a}_{n}n\\pi }{3}-2{b}_{n} &=0\\end{aligned}\\right.\n$$\n\nFrom the first equation, ${a}_{0}=2,$ which means the constant term is given by\n\n$$\n\\frac{{a}_{0}}{2}=1.\n$$\n\nNext, from the third equation, ${b}_{n}=-\\frac{{a}_{n}n\\pi }{6}.$ Substituting this into the third equation, gives\n\n$$\n(-\\frac{{a}_{n}n\\pi }{6})\\frac{n\\pi }{3}-2{a}_{n}=\\frac{4}{{n}^{2}\\pi }\\,⇒\\,{a}_{n}=-\\frac{72}{{n}^{2}\\pi ({n}^{2}{\\pi }^{2}+36)}.\n$$\n\nTherefore, for ${a}_{n}$ with $n\\ge 1,$ we have\n\n$$\n\\begin{aligned}{b}_{n} & =-\\frac{{a}_{n}n\\pi }{6} \\\\  & =-\\frac{n\\pi }{6}\\cdot (-\\frac{72}{{n}^{2}\\pi ({n}^{2}{\\pi }^{2}+36)}) \\\\  & =\\frac{12}{n({n}^{2}{\\pi }^{2}+36)}.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{y}_{p}∼1 & +{\\sum }_{n=1}^{\\infty }\\,-\\frac{72}{{n}^{2}\\pi ({n}^{2}{\\pi }^{2}+36)}\\cdot \\operatorname{cos}⁡(\\frac{n\\pi x}{3}) \\\\  & +{\\sum }_{n=1}^{\\infty }\\,\\frac{12}{n({n}^{2}{\\pi }^{2}+36)}\\cdot \\operatorname{sin}⁡(\\frac{n\\pi x}{3}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317447 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27e72c91-6260-57d4-8f2b-d360cd74d1b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4(-1)^{n}}{{n}^{2}\\pi (36-{n}^{2}{\\pi }^{2})}" :db/id #edb/ref 17592186315345} {:answer/id #uuid "ca0f4d4a-2783-5d38-996e-52ca4cc7173c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8(-1)^{n}}{{n}^{2}\\pi (36-{n}^{2}{\\pi }^{2})}" :db/id #edb/ref 17592186316256} {:answer/id #uuid "e004ee5f-c254-5252-8869-1073aea1cb7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8(-1)^{n}}{{n}^{2}\\pi (36-{n}^{2}{\\pi }^{2})}" :db/id #edb/ref 17592186316361} {:answer/id #uuid "fe8de36c-f73d-5178-bafa-3d6b6a68abaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8(-1)^{n}}{n\\pi (36-{n}^{2}{\\pi }^{2})}" :db/id #edb/ref 17592186316543}] :answer-field/correct {:answer/id #uuid "ca0f4d4a-2783-5d38-996e-52ca4cc7173c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8(-1)^{n}}{{n}^{2}\\pi (36-{n}^{2}{\\pi }^{2})}" :db/id #edb/ref 17592186316256} :answer-field/id #uuid "d50cf4cc-94a7-5eeb-8680-cbc2d70101de" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186317052}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3d266502-5760-5926-ac9e-cf2e92540f0b" :question/math-academy-id "q-343875" :question/problem "Select the missing parts in a particular solution of the differential equation ${y}^{″}+9y=f(x),$ where the Fourier series of the $4$-periodic forcing function is given by\n\n$$\nf(x)∼{\\sum }_{n=1}^{\\infty }\\frac{2(-1)^{n}}{{n}^{2}\\pi }\\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$\n\n*Hint: You may assume that the free term and all the cosine coefficients in the Fourier series of the particular solution are equal to zero.*\n\nThe Fourier series of a particular solution is\n\n$$\n{y}_{p}∼{\\sum }_{n=1}^{\\infty }\\,{{field-1}}\\cdot \\operatorname{sin}⁡(\\frac{n\\pi x}{2})\n$$" :question/worked-solution "We assume that a solution of our equation has the following Fourier series:\n\n$$\n{y}_{p}∼{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$\n\nNow, we compute the derivatives:\n\n$$\n\\begin{aligned}{y}_{p}^{′} & ∼\\frac{\\text{d}}{\\text{d}x}({\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{2}))∼{\\sum }_{n=1}^{\\infty }\\frac{{b}_{n}n\\pi }{2}\\operatorname{cos}⁡(\\frac{n\\pi x}{2}) \\\\ {y}_{p}^{″} & ∼\\frac{\\text{d}}{\\text{d}x}({\\sum }_{n=1}^{\\infty }\\frac{{b}_{n}n\\pi }{2}\\operatorname{cos}⁡(\\frac{n\\pi x}{2}))∼{\\sum }_{n=1}^{\\infty }-\\frac{{b}_{n}{n}^{2}{\\pi }^{2}}{4}\\operatorname{sin}⁡(\\frac{n\\pi x}{2})\\end{aligned}\n$$\n\nNext, we substitute the expressions for ${y}_{p}^{″}$ and ${y}_{p}$ into the equation:\n\n$$\n{\\sum }_{n=1}^{\\infty }-\\frac{{b}_{n}{n}^{2}{\\pi }^{2}}{4}\\operatorname{sin}⁡(\\frac{n\\pi x}{2})+9({\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{2}))={\\sum }_{n=1}^{\\infty }\\frac{2(-1)^{n}}{{n}^{2}\\pi }\\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$\n\nRearranging the terms to find a common denominator:\n\n$$\n{\\sum }_{n=1}^{\\infty }{b}_{n}(9-\\frac{{n}^{2}{\\pi }^{2}}{4})\\operatorname{sin}⁡(\\frac{n\\pi x}{2})={\\sum }_{n=1}^{\\infty }\\frac{2(-1)^{n}}{{n}^{2}\\pi }\\operatorname{sin}⁡(\\frac{n\\pi x}{2})\n$$\n\n$$\n{\\sum }_{n=1}^{\\infty }{b}_{n}(\\frac{36-{n}^{2}{\\pi }^{2}}{4})\\operatorname{sin}⁡(\\frac{n\\pi x}{2})={\\sum }_{n=1}^{\\infty }\\frac{2(-1)^{n}}{{n}^{2}\\pi }\\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$\n\nNow, equating the sine coefficients:\n\n$$\n\\frac{{b}_{n}(36-{n}^{2}{\\pi }^{2})}{4}=\\frac{2(-1)^{n}}{{n}^{2}\\pi }\\,⇒\\,{b}_{n}=\\frac{8(-1)^{n}}{{n}^{2}\\pi (36-{n}^{2}{\\pi }^{2})}.\n$$\n\nTherefore, our particular solution is\n\n$$\n{y}_{p}∼{\\sum }_{n=1}^{\\infty }\\,\\frac{8(-1)^{n}}{{n}^{2}\\pi (36-{n}^{2}{\\pi }^{2})}\\cdot \\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$"} {:db/id #edb/ref 17592186317448 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0646ce3b-5090-551d-9fb1-bf4ec6deb32f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186315150} {:answer/id #uuid "4da7a4cd-9b3c-5f25-984b-86a574f36a43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186315560} {:answer/id #uuid "842c68ff-d986-5b83-8ed4-916bda537f4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186315851} {:answer/id #uuid "91d7a856-b77f-50d1-88be-950876c5c0ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186315933}] :answer-field/correct {:answer/id #uuid "4da7a4cd-9b3c-5f25-984b-86a574f36a43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186315560} :answer-field/id #uuid "0aa5c5b2-3fbe-541c-8cfb-3a77ebfc14d8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316575} {:answer-field/choices [{:answer/id #uuid "32be831a-09d9-5501-b835-67a87d1101b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(-1)^{n}}{{n}^{3}\\pi ({n}^{2}{\\pi }^{2}+16)}" :db/id #edb/ref 17592186315413} {:answer/id #uuid "8554200b-b663-52a0-8e3d-3817e84aed0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8(-1)^{n}}{{n}^{3}\\pi ({n}^{2}{\\pi }^{2}+16)}" :db/id #edb/ref 17592186315860} {:answe