b841dee06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186374706}] :answer-field/correct {:answer/id #uuid "12626573-6c84-5178-b8b2-1f93eba76ae0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186374704} :answer-field/id #uuid "a5b58903-bf80-58db-89a8-5b30631e410d" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186374703} {:answer-field/choices [{:answer/id #uuid "1682b7cb-18d2-5f0e-9ce8-960079cb2a2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186374708} {:answer/id #uuid "4783d337-fbd2-5808-9c30-f03620927e71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186374709} {:answer/id #uuid "d89fdbe7-33e7-5dc5-9dee-7d1d8f42d090" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186374710}] :answer-field/correct {:answer/id #uuid "1682b7cb-18d2-5f0e-9ce8-960079cb2a2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186374708} :answer-field/id #uuid "589a4a5b-cb5b-5d13-b725-73333b8bacd1" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186374707}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "66522298-df3c-59f8-aea2-27f48f44c2a6" :question/math-academy-id "q-333373" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=-(x+1)(y+3),\\,y(0)=-1\n$$\n\nWe wish to approximate the solution using the $2$-step Adams-Bashforth-Moulton method. Given that the step size is $Δx=1,$ and that one preliminary step has already been computed using the Runge-Kutta method, complete the next row of the table below.\n\n*Hint: The corrector equation of the two-step Adams-Bashforth-Moulton method is defined as*\n\n$$\nΔy=\\frac{1}{12}(5{y}_{p}^{′}+8{y}^{′}-{y}_{-1}^{′})\\cdot Δx\n$$\n\n*where ${y}_{p}$ denotes the predictor at the current step, and ${y}_{-1}^{′}$ is the estimated slope at the previous point.* \n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $Δ{y}_{p}$ | ${y}_{p}$ | ${y}_{p}^{′}$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $-1$ | $-2$ | $-$ | $-$ | $-$ | $-\\frac{3}{2}$ |\n| $1$ | $-\\frac{5}{2}$ | {{field-1}} | {{field-2}} | {{field-3}} | {{field-4}} | {{field-5}} |\n\nTherefore, $y(2)≈$\n  {{field-6}}." :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe $2$-Step Adams-Bashforth-Moulton (ABM2) method with step size $Δx$ is given by\n\n$$\n\\begin{aligned}\\text{Predictor} & : & Δ{y}_{p} & =\\frac{1}{2}(3{y}^{′}-{y}_{-1}^{′})\\cdot Δx, \\\\ \\text{Corrector} & : & Δy & =\\frac{1}{12}(5{y}_{p}^{′}+8{y}^{′}-{y}_{-1}^{′})\\cdot Δx,\\end{aligned}\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the estimated slope at the current point $(x,y),$\n\n- ${y}_{-1}^{′}=f({x}_{-1},{y}_{-1})$ is the estimated slope at the previous point (${x}_{-1},{y}_{-1}),$ and\n\n- ${y}_{p}^{′}=f({x}_{\\text{new}},{y}_{p})$ is the estimated slope at the predicted new point $({x}_{\\text{new}},{y}_{p})=(x+Δx,y+Δ{y}_{p}).$\n\nWe're told that the first step is calculated using the Runge-Kutta Method, resulting in \n\n$$\ny(1)≈-\\frac{5}{2}.\n$$\n\nNow, we'll continue from this point, using the $2$-step ABM method.\n\nFirst, we compute the value of ${y}^{′}$ according to the given rule:\n\n$$\n\\begin{aligned}{y}^{′} & =-(x+1)(y+3) \\\\  & =-(1+1)(-\\frac{5}{2}+3) \\\\  & =-1\\end{aligned}\n$$\n\nSo, we add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $Δ{y}_{p}$ | ${y}_{p}$ | ${y}_{p}^{′}$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $-1$ | $-2$ | $-$ | $-$ | $-$ | $-\\frac{3}{2}$ |\n| $1$ | $-\\frac{5}{2}$ | $-1$ |  |  |  |  |\n\nFrom the first row of the table, we see that the slope at the previous point $({x}_{-1},{y}_{-1})=(0,-1)$ is ${y}_{-1}^{′}=-2.$\n\nNext, we compute $Δ{y}_{p}$ using the predictor equation:\n\n$$\n\\begin{aligned}Δ{y}_{p} & =\\frac{1}{2}(3{y}^{′}-{y}_{-1}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}(3\\cdot (-1)-(-2))\\cdot 1 \\\\  & =-\\frac{1}{2}\\end{aligned}\n$$\n\nWe add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $Δ{y}_{p}$ | ${y}_{p}$ | ${y}_{p}^{′}$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $-1$ | $-2$ | $-$ | $-$ | $-$ | $-\\frac{3}{2}$ |\n| $1$ | $-\\frac{5}{2}$ | $-1$ | $-\\frac{1}{2}$ |  |  |  |\n\nSo, the coordinates of the predicted new point are\n\n$$\n\\begin{aligned}{x}_{\\text{new}} & =x+Δx=1+1=2, \\\\ {y}_{p} & =y+Δ{y}_{p}=-\\frac{5}{2}+(-\\frac{1}{2})=-3.\\end{aligned}\n$$\n\nLet's add the second value to the table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $Δ{y}_{p}$ | ${y}_{p}$ | ${y}_{p}^{′}$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $-1$ | $-2$ | $-$ | $-$ | $-$ | $-\\frac{3}{2}$ |\n| $1$ | $-\\frac{5}{2}$ | $-1$ | $-\\frac{1}{2}$ | $-3$ |  |  |\n\nHence, the slope at this predicted point is\n\n$$\n\\begin{aligned}{y}_{p}^{′} & =-({x}_{\\text{new}}+1)({y}_{p}+3) \\\\  & =-(2+1)(-3+3) \\\\  & =0.\\end{aligned}\n$$\n\nWe can add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $Δ{y}_{p}$ | ${y}_{p}$ | ${y}_{p}^{′}$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $-1$ | $-2$ | $-$ | $-$ | $-$ | $-\\frac{3}{2}$ |\n| $1$ | $-\\frac{5}{2}$ | $-1$ | $-\\frac{1}{2}$ | $-3$ | $0$ |  |\n\nFinally, we compute $Δy$ using the corrector equation:\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{12}(5{y}_{p}^{′}+8{y}^{′}-{y}_{-1}^{′})\\cdot Δx \\\\  & =\\frac{1}{12}(5\\cdot 0+8\\cdot (-1)-(-2))\\cdot 1 \\\\  & =\\frac{1}{12}\\cdot (-6) \\\\  & =-\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the completed row is as given below.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $Δ{y}_{p}$ | ${y}_{p}$ | ${y}_{p}^{′}$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $-1$ | $-2$ | $-$ | $-$ | $-$ | $-\\frac{3}{2}$ |\n| $1$ | $-\\frac{5}{2}$ | $-1$ | $-\\frac{1}{2}$ | $-3$ | $0$ | $-\\frac{1}{2}$ |\n\nThe value of $x$ in the next row is ${x}_{\\text{new}}=2.$ To get the value of $y$ in the next row, we add $Δy$ to $y:$\n\n$$\n{y}_{\\text{new}}=y+Δy=-\\frac{5}{2}+(-\\frac{1}{2})=-3\n$$\n\nAdding these results to our table gives the following:\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $Δ{y}_{p}$ | ${y}_{p}$ | ${y}_{p}^{′}$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $-1$ | $-2$ | $-$ | $-$ | $-$ | $-\\frac{3}{2}$ |\n| $1$ | $-\\frac{5}{2}$ | $-1$ | $-\\frac{1}{2}$ | $-3$ | $0$ | $-\\frac{1}{2}$ |\n| $2$ | $-3$ |  |  |  |  |  |\n\nTherefore, we conclude that $y(2)≈-3.$"} {:db/id #edb/ref 17592186374820 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "835ed941-71af-508b-b962-5bfd810b7918" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18{e}^{-t/20}" :db/id #edb/ref 17592186374822} {:answer/id #uuid "0468a81b-2239-5f53-84a9-7481ee0cfb4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18e^{-t/20}" :db/id #edb/ref 17592186501475}] :answer-field/correct {:answer/id #uuid "0468a81b-2239-5f53-84a9-7481ee0cfb4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18e^{-t/20}" :db/id #edb/ref 17592186501475} :answer-field/id #uuid "17c7259c-bd73-5489-8857-2aa304112761" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186374821}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bc17f053-4154-5b58-a673-a3b7c9595b38" :question/math-academy-id "q-336630" :question/problem "A tank initially holds $260\\,\\text{L}$ of a dye solution containing $18\\,\\text{kg}$ of dye.\nPure water is poured into the tank at a rate of $13\\,\\text{L/min},$ while the completely mixed solution leaves the tank at a rate of $13\\,\\text{L/min}.$\nFind an equation for the amount of dye $Q(t),$ in kilograms, in the tank $t$ minutes after the pure water is first added.\n\n$Q(t)=$\n{{field-1}}" :question/worked-solution "Since $Q$ is the amount of dye in the tank at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which dye enters the tank minus the rate at which dye leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{kg}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which dye enters the tank.\n\nFirst, note that pure water (i.e., a solution containing $0\\,\\text{kg/L}$ of dye) enters the tank at a rate of $13\\,\\text{L/min}.$ So, the rate at which the *dye* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0\\,\\frac{\\text{kg}}{\\text{L}})\\cdot (13\\,\\frac{\\text{L}}{\\text{min}}) \\\\  & =(0\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}})\\cdot (13\\,\\frac{\\cancel{\\text{L}}}{\\text{min}}) \\\\  & =0\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which dye exits the tank.\n\nNote that the rate of flow in equals the rate of flow out, so the volume of solution in the tank remains $260\\,\\text{L}.$\nThen, since $Q$ is the amount of dye in the tank, the *concentration* of the solution at time $t$ is\n\n$$\n\\frac{Q}{260}\\,\\frac{\\text{kg}}{\\text{L}}.\n$$\n\nTherefore, as the completely mixed solution leaves at a rate of $13\\,\\text{L/min},$ *dye* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(13\\,\\frac{\\text{L}}{\\text{min}})\\cdot (\\frac{Q}{260}\\,\\frac{\\text{kg}}{\\text{L}}) \\\\  & =(13\\,\\frac{\\cancel{\\text{L}}}{\\text{min}})\\cdot (\\frac{Q}{260}\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}}) \\\\  & =\\frac{13Q}{260}\\,\\frac{\\text{kg}}{\\text{min}} \\\\  & =\\frac{Q}{20}\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\ \\frac{dQ}{dt} & =0-\\frac{Q}{20} \\\\ \\frac{dQ}{dt} & =-\\frac{1}{20}\\,Q.\\end{aligned}\n$$\n\n**Step 4**: Integrate the equation.\n\nSeparating variables and integrating both sides with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{Q}\\cdot \\frac{dQ}{dt} & =-\\frac{1}{20} \\\\ \\int \\frac{1}{Q}\\cdot \\frac{dQ}{dt}dt & =\\int (-\\frac{1}{20})\\,dt \\\\ \\int \\frac{1}{Q}\\cdot \\,dQ & =-\\frac{1}{20}\\int \\,dt \\\\ \\operatorname{ln}⁡|Q| & =-\\frac{t}{20}+C \\\\ |Q| & ={e}^{-t/20+C} \\\\ Q(t) & =A{e}^{-t/20},\\end{aligned}\n$$\n\nwhere $A=\\pm {e}^{C}$ is a constant of integration.\n\nWe're told that the tank initially contains $18\\,\\text{kg}$ of dye. So, we can apply the initial condition $Q(0)=18,$ and solve for $A:$\n\n$$\n\\begin{aligned}Q(0) & =18 \\\\ A{e}^{-0/20} & =18 \\\\ A & =18\\end{aligned}\n$$\n\nFinally, we obtain the following expression for $Q(t):$\n\n$$\nQ(t)=18{e}^{-t/20}\n$$"} {:db/id #edb/ref 17592186374823 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bf9c62e-c4f9-5e3c-8ed7-61d9f3e8d86a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9{e}^{-t/25}" :db/id #edb/ref 17592186374825}] :answer-field/correct {:answer/id #uuid "7bf9c62e-c4f9-5e3c-8ed7-61d9f3e8d86a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9{e}^{-t/25}" :db/id #edb/ref 17592186374825} :answer-field/id #uuid "28133954-7d6d-50c3-9942-b8e9c9a1182b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186374824}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4d568f5f-6232-5ee8-a10c-db439f4a3317" :question/math-academy-id "q-336631" :question/problem "A tank initially holds $375\\,\\text{L}$ of a dissolved contaminant solution containing $9\\,\\text{kg}$ of dissolved contaminant.\nPure water is poured into the tank at a rate of $15\\,\\text{L/min},$ while the completely mixed solution leaves the tank at a rate of $15\\,\\text{L/min}.$\nFind an equation for the amount of dissolved contaminant $Q(t),$ in kilograms, in the tank $t$ minutes after the pure water is first added.\n\n$Q(t)=$\n{{field-1}}" :question/worked-solution "Since $Q$ is the amount of dissolved contaminant in the tank at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which dissolved contaminant enters the tank minus the rate at which dissolved contaminant leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{kg}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which dissolved contaminant enters the tank.\n\nFirst, note that pure water (i.e., a solution containing $0\\,\\text{kg/L}$ of dissolved contaminant) enters the tank at a rate of $15\\,\\text{L/min}.$ So, the rate at which the *dissolved contaminant* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0\\,\\frac{\\text{kg}}{\\text{L}})\\cdot (15\\,\\frac{\\text{L}}{\\text{min}}) \\\\  & =(0\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}})\\cdot (15\\,\\frac{\\cancel{\\text{L}}}{\\text{min}}) \\\\  & =0\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which dissolved contaminant exits the tank.\n\nNote that the rate of flow in equals the rate of flow out, so the volume of solution in the tank remains $375\\,\\text{L}.$\nThen, since $Q$ is the amount of dissolved contaminant in the tank, the *concentration* of the solution at time $t$ is\n\n$$\n\\frac{Q}{375}\\,\\frac{\\text{kg}}{\\text{L}}.\n$$\n\nTherefore, as the completely mixed solution leaves at a rate of $15\\,\\text{L/min},$ *dissolved contaminant* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(15\\,\\frac{\\text{L}}{\\text{min}})\\cdot (\\frac{Q}{375}\\,\\frac{\\text{kg}}{\\text{L}}) \\\\  & =(15\\,\\frac{\\cancel{\\text{L}}}{\\text{min}})\\cdot (\\frac{Q}{375}\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}}) \\\\  & =\\frac{15Q}{375}\\,\\frac{\\text{kg}}{\\text{min}} \\\\  & =\\frac{Q}{25}\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\ \\frac{dQ}{dt} & =0-\\frac{Q}{25} \\\\ \\frac{dQ}{dt} & =-\\frac{1}{25}\\,Q.\\end{aligned}\n$$\n\n**Step 4**: Integrate the equation.\n\nSeparating variables and integrating both sides with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{Q}\\cdot \\frac{dQ}{dt} & =-\\frac{1}{25} \\\\ \\int \\frac{1}{Q}\\cdot \\frac{dQ}{dt}dt & =\\int (-\\frac{1}{25})\\,dt \\\\ \\int \\frac{1}{Q}\\cdot \\,dQ & =-\\frac{1}{25}\\int \\,dt \\\\ \\operatorname{ln}⁡|Q| & =-\\frac{t}{25}+C \\\\ |Q| & ={e}^{-t/25+C} \\\\ Q(t) & =A{e}^{-t/25},\\end{aligned}\n$$\n\nwhere $A=\\pm {e}^{C}$ is a constant of integration.\n\nWe're told that the tank initially contains $9\\,\\text{kg}$ of dissolved contaminant. So, we can apply the initial condition $Q(0)=9,$ and solve for $A:$\n\n$$\n\\begin{aligned}Q(0) & =9 \\\\ A{e}^{-0/25} & =9 \\\\ A & =9\\end{aligned}\n$$\n\nFinally, we obtain the following expression for $Q(t):$\n\n$$\nQ(t)=9{e}^{-t/25}\n$$"} {:db/id #edb/ref 17592186374826 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "587ad7eb-e7ff-5449-a3e7-315421a5c0c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=20{(\\frac{100}{100+t})}^{2}" :db/id #edb/ref 17592186374828} {:answer/id #uuid "95d74708-bfdc-53f7-9971-439077d9c125" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=2500{(\\frac{10}{100+t})}^{2}" :db/id #edb/ref 17592186374829} {:answer/id #uuid "c1ca561d-2102-5596-b774-af92e2184dde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=25\\frac{100}{(100+t)^{2}}" :db/id #edb/ref 17592186374830} {:answer/id #uuid "28f84566-0022-5a52-aa79-a865a20593a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=25{(\\frac{100}{100+t})}^{2}" :db/id #edb/ref 17592186374831} {:answer/id #uuid "64fc0482-ab86-5439-a2a9-8a2e97fe0fb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=20{(\\frac{10}{100+t})}^{2}" :db/id #edb/ref 17592186374832}] :answer-field/correct {:answer/id #uuid "28f84566-0022-5a52-aa79-a865a20593a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=25{(\\frac{100}{100+t})}^{2}" :db/id #edb/ref 17592186374831} :answer-field/id #uuid "e5507560-e644-5b06-9ffc-b163d1f6589b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374827}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e3c2a5b4-3b5e-50f6-abee-7b39dd34294c" :question/math-academy-id "q-336632" :question/problem "A tank initially holds $600\\,\\text{L}$ of a brine (salt-water) solution containing $25\\,\\text{kg}$ of salt.\nFresh water is poured into the tank at a rate of $18\\,\\text{L/min},$ while the completely mixed brine leaves the tank at a rate of $12\\,\\text{L/min}.$\nFind an equation for the amount of salt $Q(t),$ in kilograms, in the tank $t$ minutes after the fresh water is first added." :question/worked-solution "Since $Q$ is the amount of salt in the tank at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which salt enters the tank minus the rate at which salt leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{kg}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which salt enters the tank.\n\nFirst, note that fresh water (i.e., a brine solution containing $0\\,\\text{kg/L}$ of salt) enters the tank at a rate of $18\\,\\text{L/min}.$ So, the rate at which the *salt* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0\\,\\frac{\\text{kg}}{\\text{L}})\\cdot (18\\,\\frac{\\text{L}}{\\text{min}}) \\\\  & =(0\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}})\\cdot (18\\,\\frac{\\cancel{\\text{L}}}{\\text{min}}) \\\\  & =0\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which salt exits the tank.\n\nNow, to find the rate at which salt leaves the tank, we must first determine the volume of brine in the tank at time $t.$\n\n- The tank initially contains $600\\,\\text{L}$ of brine.\n\n- Fresh water enters the tank at a rate of $18\\,\\text{L/min}.$ So, after $t$ minutes, $18t\\,\\text{L}$ have entered the tank.\n\n- The completely mixed brine leaves the tank at a rate of $12\\,\\text{L/min}.$ So, after $t$ minutes, $12t\\,\\text{L}$ have left the tank.\n\nAs a result, the volume of brine in the tank after $t$ minutes is \n\n$$\n600+18t-12t=(600+6t)\\,\\text{L}.\n$$\n\nThen, since $Q$ is the amount of salt in the tank, the *concentration* of the brine at time $t$ is\n\n$$\n\\frac{Q}{600+6t}\\,\\frac{\\text{kg}}{\\text{L}}.\n$$\n\nTherefore, as the completely mixed brine leaves at a rate of $12\\,\\text{L/min},$ *salt* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(12\\,\\frac{\\text{L}}{\\text{min}})\\cdot (\\frac{Q}{600+6t}\\,\\frac{\\text{kg}}{\\text{L}}) \\\\  & =(12\\,\\frac{\\cancel{\\text{L}}}{\\text{min}})\\cdot (\\frac{Q}{600+6t}\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}}) \\\\  & =\\frac{12Q}{600+6t}\\,\\frac{\\text{kg}}{\\text{min}} \\\\  & =\\frac{2Q}{100+t}\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\ \\frac{dQ}{dt} & =0-\\frac{2Q}{100+t} \\\\ \\frac{dQ}{dt} & =-\\frac{2}{100+t}\\,Q.\\end{aligned}\n$$\n\n**Step 4**: Integrate the equation.\n\nSeparating variables and integrating both sides with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{Q}\\cdot \\frac{dQ}{dt} & =-\\frac{2}{100+t} \\\\ \\int \\frac{1}{Q}\\cdot \\frac{dQ}{dt}dt & =\\int (-\\frac{2}{100+t})\\,dt \\\\ \\int \\frac{1}{Q}\\cdot \\,dQ & =-2\\int \\frac{1}{100+t}\\,dt \\\\ \\operatorname{ln}⁡|Q| & =-2\\operatorname{ln}⁡|100+t|+C \\\\ |Q| & ={e}^{-2\\operatorname{ln}⁡|100+t|+C} \\\\ Q(t) & =\\frac{A}{(100+t)^{2}},\\end{aligned}\n$$\n\nwhere $A=\\pm {e}^{C}$ is a constant of integration.\n\nWe're told that the tank initially contains $25\\,\\text{kg}$ of salt. So, we can apply the initial condition $Q(0)=25,$ and solve for $A:$\n\n$$\n\\begin{aligned}Q(0) & =25 \\\\ \\frac{A}{(100+0)^{2}} & =25 \\\\ A & =25\\cdot {100}^{2}\\end{aligned}\n$$\n\nFinally, we obtain the following expression for $Q(t):$\n\n$$\nQ(t)=25{(\\frac{100}{100+t})}^{2}\n$$"} {:db/id #edb/ref 17592186374840 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22446d9b-f3b3-51d7-8eab-f813f126f966" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.43\\,\\text{lb}" :db/id #edb/ref 17592186374842} {:answer/id #uuid "fc791120-4af1-5df5-8a8b-8cf249933b52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7.54\\,\\text{lb}" :db/id #edb/ref 17592186374843} {:answer/id #uuid "2a979bc1-8055-5284-be10-31b92bc2fb71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.22\\,\\text{lb}" :db/id #edb/ref 17592186374844} {:answer/id #uuid "b2ab7b77-90c7-560a-a520-39ae98136e1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.08\\,\\text{lb}" :db/id #edb/ref 17592186374845} {:answer/id #uuid "5fb6f7cb-44c0-5462-90c0-5e816014480d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.70\\,\\text{lb}" :db/id #edb/ref 17592186374846}] :answer-field/correct {:answer/id #uuid "22446d9b-f3b3-51d7-8eab-f813f126f966" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.43\\,\\text{lb}" :db/id #edb/ref 17592186374842} :answer-field/id #uuid "cf9b1d72-7dcf-5756-8025-f1f5167127d2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374841}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a7733334-ec35-5062-9a3d-109d06df1cd7" :question/math-academy-id "q-336674" :question/problem "A wastewater holding basin initially holds $480\\,\\text{gal}$ of water containing $12\\,\\text{lb}$ of dissolved contaminants.\nClean water is pumped into the basin at a rate of $24\\,\\text{gal/min},$ while the completely mixed liquid leaves the basin at a rate of $18\\,\\text{gal/min}.$\nFind, rounded to two decimal places, the amount of contaminants in the basin $10$ minutes after the clean water pumping begins." :question/worked-solution "Let $Q$ be the amount of contaminants in the basin at time $t.$ Then, the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which contaminants enter the basin minus the rate at which contaminants leave the basin.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{lb}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which contaminants enter the basin.\n\nNote that clean water (i.e., water containing $0\\,\\text{lb/gal}$ of contaminants) enters the basin at a rate of $24\\,\\text{gal/min}.$ So, the rate at which the *contaminants* enter the basin is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0\\,\\frac{\\text{lb}}{\\text{gal}})\\cdot (24\\,\\frac{\\text{gal}}{\\text{min}}) \\\\  & =(0\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}})\\cdot (24\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}}) \\\\  & =0\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which contaminants exit the basin.\n\nTo find the rate at which contaminants leave the basin, we first determine the volume of wastewater in the basin at time $t.$\n\nThe basin initially contains $480\\,\\text{gal}$ of wastewater; water enters at $24\\,\\text{gal/min}$ and drains out at $18\\,\\text{gal/min}.$\nAs a result, the amount of wastewater in the basin after $t$ minutes is \n\n$$\n480+24t-18t=(480+6t)\\,\\text{gal}.\n$$\n\nSince $Q$ is the amount of contaminants in the basin, the *concentration* of the wastewater at time $t$ is\n\n$$\n\\frac{Q}{480+6t}\\,\\frac{\\text{lb}}{\\text{gal}}.\n$$\n\nTherefore, as the completely mixed liquid leaves at a rate of $18\\,\\text{gal/min},$ *contaminants* leave at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(18\\,\\frac{\\text{gal}}{\\text{min}})\\cdot (\\frac{Q}{480+6t}\\,\\frac{\\text{lb}}{\\text{gal}}) \\\\  & =(18\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}})\\cdot (\\frac{Q}{480+6t}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}}) \\\\  & =\\frac{18Q}{480+6t}\\,\\frac{\\text{lb}}{\\text{min}} \\\\  & =\\frac{3Q}{80+t}\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =0-\\frac{3Q}{80+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}=-\\frac{3}{80+t}\\,Q.\n$$\n\n**Step 4**: Integrate the equation.\n\nSeparating variables and integrating both sides with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{Q}\\cdot \\frac{dQ}{dt} & =-\\frac{3}{80+t} \\\\ \\int \\frac{1}{Q}\\cdot \\frac{dQ}{dt}dt & =\\int (-\\frac{3}{80+t})\\,dt \\\\ \\int \\frac{1}{Q}\\cdot \\,dQ & =-3\\int \\frac{1}{80+t}\\,dt \\\\ \\operatorname{ln}⁡|Q| & =-3\\operatorname{ln}⁡|80+t|+C \\\\ |Q| & ={e}^{-3\\operatorname{ln}⁡|80+t|+C} \\\\ Q(t) & =\\frac{A}{(80+t)^{3}},\\end{aligned}\n$$\n\nwhere $A=\\pm {e}^{C}$ is a constant of integration.\n\nWe're told that the basin initially contains $12\\,\\text{lb}$ of contaminants. So, we can apply the initial condition $Q(0)=12,$ and solve for $A:$\n\n$$\n\\begin{aligned}Q(0) & =12 \\\\ \\frac{A}{(80+0)^{3}} & =12 \\\\ A & =12\\cdot {80}^{3}\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\nQ(t)=12{(\\frac{80}{80+t})}^{3}\n$$\n\nFinally, the amount of contaminants in the basin $10$ minutes after the clean water is first pumped in is\n\n$$\nQ(12)=12{(\\frac{80}{90})}^{3}≈8.43\\,\\text{lb},\n$$\n\nrounded to two decimal places."}]
