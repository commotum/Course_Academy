{2} + 4}\\end{aligned}\n$$\n\nNow, since $f(x,y,z)=\\frac{4 y + 4 z}{x}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{(4)[(\\frac{3 t^{2}}{2})+(t^{2})]}{2 t} \\\\  & =\\frac{(10)t^2}{(2)t} \\\\  & =5 t\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s & ={\\int }_{\\sqrt{2}}^{2}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{\\sqrt{2}}^{2}(5 t)(\\sqrt{13 t^{2} + 4})\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=13 t^{2} + 4$, $\\text{d}u=(26 t)\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{\\sqrt{2}}^{2}5 t \\sqrt{13 t^{2} + 4}\\,\\text{d}t & ={\\int }_{30}^{56}\\sqrt{u}\\cdot \\frac{5}{26}\\,\\text{d}u \\\\  & =\\frac{5}{26}{\\int }_{30}^{56}u^{1/2}\\,\\text{d}u \\\\  & =\\frac{5}{26}\\cdot\\frac{2}{3}u^{3/2}\\big|_{30}^{56} \\\\  & =\\frac{5}{39}[(56)^{3/2}-(30)^{3/2}] \\\\  & =\\frac{5}{39}[(112 \\sqrt{14})-(30 \\sqrt{30})] \\\\  & =(\\frac{560 \\sqrt{14}}{39})-(\\frac{50 \\sqrt{30}}{13}) \\\\  & =- \\frac{50 \\sqrt{30}}{13} + \\frac{560 \\sqrt{14}}{39}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186536195 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a24a14e-7ef5-5ad1-a61b-3b0c903f1bbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{25 \\sqrt{30}}{13} + \\frac{215 \\sqrt{43}}{78}" :db/id #edb/ref 17592186536178} {:answer/id #uuid "32658cc0-fb41-54b1-adeb-b587a3ed9bd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 50 \\sqrt{30} + \\frac{215 \\sqrt{43}}{3}" :db/id #edb/ref 17592186536183} {:answer/id #uuid "52633d9b-e8c6-534c-a7d5-036ac4ee235e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186536190} {:answer/id #uuid "771125d9-54a3-59c0-aaa9-f0634bc33656" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{5 \\sqr