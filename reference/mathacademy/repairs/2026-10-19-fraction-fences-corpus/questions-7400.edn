^2+(2 t)^2+(3 t)^2} \\\\  & =\\sqrt{13 t^{2} + 4}\\end{aligned}\n$$\n\nNow, since $f(x,y,z)=\\frac{2 y + 2 z}{x}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{(2)[(t^{2})+(\\frac{3 t^{2}}{2})]}{2 t} \\\\  & =\\frac{(5)t^2}{(2)t} \\\\  & =\\frac{5 t}{2}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s & ={\\int }_{\\sqrt{2}}^{\\sqrt{3}}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{\\sqrt{2}}^{\\sqrt{3}}(\\frac{5 t}{2})(\\sqrt{13 t^{2} + 4})\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=13 t^{2} + 4$, $\\text{d}u=(26 t)\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{\\sqrt{2}}^{\\sqrt{3}}\\frac{5 t \\sqrt{13 t^{2} + 4}}{2}\\,\\text{d}t & ={\\int }_{30}^{43}\\sqrt{u}\\cdot \\frac{5}{52}\\,\\text{d}u \\\\  & =\\frac{5}{52}{\\int }_{30}^{43}u^{1/2}\\,\\text{d}u \\\\  & =\\frac{5}{52}\\cdot\\frac{2}{3}u^{3/2}\\big|_{30}^{43} \\\\  & =\\frac{5}{78}[(43)^{3/2}-(30)^{3/2}] \\\\  & =\\frac{5}{78}[(43 \\sqrt{43})-(30 \\sqrt{30})] \\\\  & =(\\frac{215 \\sqrt{43}}{78})-(\\frac{25 \\sqrt{30}}{13}) \\\\  & =- \\frac{25 \\sqrt{30}}{13} + \\frac{215 \\sqrt{43}}{78}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186536197 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5117585f-11b3-58c4-a2ed-93bfe6a37773" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186536189} {:answer/id #uuid "83e9d980-388d-545d-aea1-9c61f2ded7ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{125}{6} + \\frac{41 \\sqrt{41}}{6}" :db/id #edb/ref 17592186536204} {:answer/id #uuid "89459d10-f9bc-56f1-8dfa-8495b9630dd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{5}{2} + \\frac{\\sqrt{41}}{2}" :db/id #edb/ref 17592186536208} {:answer/id #uuid "8be88d4f-cace-5fd8-b578-2774c746c989" :answer/type {:db/id #edb/ref 17592186