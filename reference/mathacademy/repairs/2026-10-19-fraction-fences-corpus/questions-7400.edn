t}^{2}+1}\\cdot \\text{d}t\\right) \\\\    & =2\\left({\\int }_{2}^{\\frac{11}{2}}\\frac{t}{\\sqrt{4{t}^{2}+1}}\\text{d}t\\right).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186539172 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ddac435-f4c5-5790-a848-0d7fd8aecc12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{6}}10 t \\cos{\\left(2 t \\right)}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539131} {:answer/id #uuid "49e747ab-2e87-5b28-b3b1-52bfbfa14251" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{6}}5 \\sqrt{2} t \\cos{\\left(2 t \\right)}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539145} {:answer/id #uuid "4a119ce1-666c-589c-913e-71a12513c765" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{6}}\\frac{5 \\sqrt{2} t \\cos{\\left(2 t \\right)}}{2}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539146} {:answer/id #uuid "7f1d6599-ceb5-5eed-83dc-ed06fd4e1d46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{6}}5 \\sqrt{2} t\\,\\mathrm{d}t" :db/id #edb/ref 17592186539165} {:answer/id #uuid "804f7a7d-ca0c-5b72-99dd-1e2bd2065c4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{6}}5 t \\cos{\\left(2 t \\right)}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539166}] :answer-field/correct {:answer/id #uuid "49e747ab-2e87-5b28-b3b1-52bfbfa14251" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{6}}5 \\sqrt{2} t \\cos{\\left(2 t \\right)}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539145} :answer-field/id #uuid "e4985361-8dc5-544a-a26a-fb6bff95a3f9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539196}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "88d1c090-6bb7-523f-a9f3-d7ec7807cd7a" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}5\\left(z({x}^{2}-{y}^{2})\\right)\\,\\text{d}s,$ where the curve $C$ is parametrized by $r(t)=\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j\\,+t\\,k$ for $\\,0\\le t\\le \\frac{\\pi}{6}?$" :question/worked-solution "Since $r(t)=\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j\\,+t\\,k,$ then along the curve we have $x=\\operatorname{cos}⁡t,$ $y=\\operatorname{sin}⁡t,$ and $z=t.$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)j+\\frac{\\text{d}}{\\text{d}t}(t)k \\\\  & =-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j+k \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}+{(\\frac{\\text{d}z}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t)^{2}+{1}^{2}} \\\\  & =\\sqrt{{sin}^{2}⁡t+{cos}^{2}⁡t+1} \\\\  & =\\sqrt{1+1} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\n  \n\nNow, if $f(x,y,z)=5\\left(z({x}^{2}-{y}^{2})\\right)$, then we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =5\\left(t((\\operatorname{cos}⁡t)^{2}-(\\operatorname{sin}⁡t)^{2})\\right) \\\\    & =5\\left(t({cos}^{2}⁡t-{sin}^{2}⁡t)\\right) \\\\    & =5\\left(t\\operatorname{cos}⁡2t\\right).\\end{aligned}\n$$\n\nTherefore, we can write the integral as  \n\n$$\n\\begin{aligned}{\\int }_{C}5\\left(z({x}^{2}-{y}^{2})\\right)\\,\\text{d}s & ={\\int }_{0}^{\\frac{\\pi}{6}}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t  \\\\    & =5\\left({\\int }_{0}^{\\frac{\\pi}{6}}t\\operatorname{cos}⁡2t\\cdot \\sqrt{2}\\cdot \\text{d}t\\right) \\\\    & =5\\left(\\sqrt{2}{\\int }_{0}^{\\frac{\\pi}{6}}t\\operatorname{cos}⁡2t\\,\\text{d}t\\right).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186539174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04ec66b2-9271-5a86-bba6-39b76534dbf7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{1}{2}}^{\\frac{7}{3}}\\frac{5 t}{4 t^{2} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539124} {:answer/id #uuid "39eb83de-83c7-5476-b2e1-42b4fe358621" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{1}{2}}^{\\frac{7}{3}}5 t\\,\\mathrm{d}t" :db/id #edb/ref 17592186539140} {:answer/id #uuid "3a918622-26b5-5fae-b7b9-05af71744ab8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{1}{2}}^{\\frac{7}{3}}\\frac{5 t}{\\left(4 t^{2} + 1\\right)^{\\frac{3}{2}}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539141} {:answer/id #uuid "60aab06d-1253-59b6-b9bd-40fdc6f9eb1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{1}{2}}^{\\frac{7}{3}}\\frac{5 t}{\\sqrt{4 t^{2} + 1}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539156} {:answer/id #uuid "7b390292-66dd-5f10-a384-8ca7ed8cf17b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{1}{2}}^{\\frac{7}{3}}\\frac{5 t^{2}}{\\sqrt{4 t^{2} + 1}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539162}] :answer-field/correct {:answer/id #uuid "60aab06d-1253-59b6-b9bd-40fdc6f9eb1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{\\frac{1}{2}}^{\\frac{7}{3}}\\frac{5 t}{\\sqrt{4 t^{2} + 1}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539156} :answer-field/id #uuid "af41d808-87d0-52a5-979b-295e732e80de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539180}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a17cfaab-14e7-5c09-ade5-3176e170f53b" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}5\\left(\\frac{x}{4y+1}\\right)\\text{d}s,$ where the curve $C$ is parametrized by $r(t)=t\\,i+{t}^{2}\\,j\\,$ for $\\frac{1}{2}\\le t\\le \\frac{7}{3}?$" :question/worked-solution "Since $r(t)=t\\,i+{t}^{2}\\,j,$ then along the curve we have $x=t$ and $y={t}^{2}.$ \n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}({t}^{2})j \\\\  & =i+2tj \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{1}^{2}+(2t)^{2}} \\\\  & =\\sqrt{1+4{t}^{2}}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=5\\left(\\frac{x}{4y+1}\\right)$, then we obtain \n\n$$\n\\begin{aligned}f(r(t)) & =5\\left(\\frac{t}{4{t}^{2}+1}\\right).\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}5\\left(\\frac{x}{4y+1}\\right)\\text{d}s & ={\\int }_{\\frac{1}{2}}^{\\frac{7}{3}}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t  \\\\    & =5\\left({\\int }_{\\frac{1}{2}}^{\\frac{7}{3}}(\\frac{t}{4{t}^{2}+1})\\cdot \\sqrt{4{t}^{2}+1}\\cdot \\text{d}t\\right) \\\\    & =5\\left({\\int }_{\\frac{1}{2}}^{\\frac{7}{3}}\\frac{t}{\\sqrt{4{t}^{2}+1}}\\text{d}t\\right).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186539178 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6007b4c8-5fd7-5182-b9b1-b8ab65716cc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{5}{2}}\\sqrt{36 t^{2} + 5} \\left(- 6 t^{3} - 10 t^{2} + 16 t + 8\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539155} {:answer/id #uuid "c10d389c-0aa7-5b23-82b4-246c7ac9ce69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{5}{2}}- 2 \\left(36 t^{2} + 5\\right) \\left(3 t^{3} + 5 t^{2} - 8 t - 4\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539184} {:answer/id #uuid "d7c7ac66-9df2-5528-8428-8ab1dc9902f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{5}{2}}\\frac{2 \\left(- 3 t^{3} - 5 t^{2} + 8 t + 4\\right)}{\\sqrt{36 t^{2} + 5}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539190} {:answer/id #uuid "df5c3f33-dfe4-50f6-8249-42490daafec4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{5}{2}}- 6 t^{3} - 10 t^{2} + 16 t + 8\\,\\mathrm{d}t" :db/id #edb/ref 17592186539192} {:answer/id #uuid "f5a7e9b2-2d21-55ba-a040-b5b1c6d8da08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{5}{2}}2 \\sqrt{36 t^{2} + 5} \\left(- 3 t^{2} \\left(t + 3\\right) - 4 \\left(t + 1\\right)^{2}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539203}] :answer-field/correct {:answer/id #uuid "6007b4c8-5fd7-5182-b9b1-b8ab65716cc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{5}{2}}\\sqrt{36 t^{2} + 5} \\left(- 6 t^{3} - 10 t^{2} + 16 t + 8\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539155} :answer-field/id #uuid "66661945-6b6a-5b27-bb7a-9979aec89f63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539158}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a908ad08-fd2d-5338-a3b2-fa3636e47ff4" :question/problem "Which of the following is equivalent to $\\int_C - 2 x y + 2 z^{2}\\,\\mathrm{d}s,$ where the curve $C$ is parametrized by $r(t)=\\langle 3 t^{2}, t + 3, 2 t + 2\\rangle$ for $0\\le t\\le \\frac{5}{2}$?" :question/worked-solution "Since $r(t)=\\langle 3 t^{2}, t + 3, 2 t + 2\\rangle,$ then along the curve we have $x=3 t^{2}$, $y=t + 3$, $z=2 t + 2$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t)&=\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j+\\frac{\\mathrm{d}z}{\\mathrm{d}t}\\,k \\\\ &= \\frac{\\mathrm{d}}{\\mathrm{d}t}(3 t^{2})i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t + 3)j+\\frac{\\mathrm{d}}{\\mathrm{d}t}(2 t + 2)k \\\\ &= (6 t)\\,i+(1)\\,j+(2)\\,k \\\\ \\|r'(t)\\|&=\\sqrt{(\\frac{\\mathrm{d}x}{\\mathrm{d}t})^2+(\\frac{\\mathrm{d}y}{\\mathrm{d}t})^2+(\\frac{\\mathrm{d}z}{\\mathrm{d}t})^2} \\\\ &= \\sqrt{(6 t)^2+(1)^2+(2)^2} \\\\ &= \\sqrt{36 t^{2} + 5}\\end{aligned}\n$$\n\nNow, since $f(x,y,z)=- 2 x y + 2 z^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r(t))&=-2\\left((3 t^{2})(t + 3)-(2 t + 2)^2\\right) \\\\ &= -2\\left(3t^3+(9)t^2-\\left(4t^2+(8)t+4\\right)\\right) \\\\ &= - 6 t^{3} - 10 t^{2} + 16 t + 8.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f(x,y,z)\\,\\mathrm{d}s&=\\int_{0}^{\\frac{5}{2}} f(r(t))\\,\\|r'(t)\\|\\,\\mathrm{d}t \\\\ &= \\int_{0}^{\\frac{5}{2}}(- 6 t^{3} - 10 t^{2} + 16 t + 8)(\\sqrt{36 t^{2} + 5})\\,\\mathrm{d}t \\\\ &= \\int_{0}^{\\frac{5}{2}}\\sqrt{36 t^{2} + 5} \\left(- 6 t^{3} - 10 t^{2} + 16 t + 8\\right)\\,\\mathrm{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186539200 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27d55e55-4da0-5e7e-b523-3a71c34060d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{4}{3}}t\\,\\mathrm{d}t" :db/id #edb/ref 17592186539135} {:answer/id #uuid "7b5b324f-dc6f-5f53-96c6-b0679ba8cf94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{4}{3}}\\frac{t^{2}}{\\sqrt{4 t^{2} + 1}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539163} {:answer/id #uuid "8698b24c-571c-586d-9aa9-791ca92cca74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{4}{3}}\\frac{t}{\\left(4 t^{2} + 1\\right)^{\\frac{3}{2}}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539170} {:answer/id #uuid "b26b07de-bd8f-5b41-9dc8-2063df8ca6ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{4}{3}}\\frac{t}{4 t^{2} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539182} {:answer/id #uuid "d04b5623-2bff-542f-8d52-93366f70ddc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{4}{3}}\\frac{t}{\\sqrt{4 t^{2} + 1}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539188}] :answer-field/correct {:answer/id #uuid "d04b5623-2bff-542f-8d52-93366f70ddc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{4}{3}}\\frac{t}{\\sqrt{4 t^{2} + 1}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539188} :answer-field/id #uuid "06daf866-2151-53ab-a697-9d6282e0ae9a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539125}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f04c0a98-4a6c-5873-883f-948e18d8b72b" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}\\frac{x}{4y+1}\\text{d}s,$ where the curve $C$ is parametrized by $r(t)=t\\,i+{t}^{2}\\,j\\,$ for $1\\le t\\le \\frac{4}{3}?$" :question/worked-solution "Since $r(t)=t\\,i+{t}^{2}\\,j,$ then along the curve we have $x=t$ and $y={t}^{2}.$ \n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}({t}^{2})j \\\\  & =i+2tj \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{1}^{2}+(2t)^{2}} \\\\  & =\\sqrt{1+4{t}^{2}}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=\\frac{x}{4y+1}$, then we obtain \n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{t}{4{t}^{2}+1}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{x}{4y+1}\\text{d}s & ={\\int }_{1}^{\\frac{4}{3}}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{1}^{\\frac{4}{3}}(\\frac{t}{4{t}^{2}+1})\\cdot \\sqrt{4{t}^{2}+1}\\cdot \\text{d}t \\\\  & ={\\int }_{1}^{\\frac{4}{3}}\\frac{t}{\\sqrt{4{t}^{2}+1}}\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186539202 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0228b294-5832-5825-ad8a-3bc0a9bdbe23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{- \\frac{3}{2}}^{2}\\frac{2 \\sqrt{5} \\left(8 t^{3} + t - 2\\right)}{5}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539123} {:answer/id #uuid "0f75487c-a5f1-5e36-86b8-989567defbd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{- \\frac{3}{2}}^{2}80 t^{3} + 10 t - 20\\,\\mathrm{d}t" :db/id #edb/ref 17592186539126} {:answer/id #uuid "7dea96ab-5a7e-592e-944f-a693c36c797b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{- \\frac{3}{2}}^{2}16 t^{3} + 2 t - 4\\,\\mathrm{d}t" :db/id #edb/ref 17592186539164} {:answer/id #uuid "c6680a8a-cce7-55d0-b883-50e0e3ba2e83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{- \\frac{3}{2}}^{2}2 \\sqrt{5} \\left(8 t^{3} - t + 2\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539185} {:answer/id #uuid "f38f729c-48d5-5112-b120-4a7a2e085fed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\int_{- \\frac{3}{2}}^{2}2 \\sqrt{5} \\left(8 t^{3} + t - 2\\right)\\,\\mathrm{d}t$." :db/id #edb/ref 17592186539201}] :answer-field/correct {:answer/id #uuid "f38f729c-48d5-5112-b120-4a7a2e085fed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\int_{- \\frac{3}{2}}^{2}2 \\sqrt{5} \\left(8 t^{3} + t - 2\\right)\\,\\mathrm{d}t$." :db/id #edb/ref 17592186539201} :answer-field/id #uuid "b97f8f35-3ac8-510f-857f-73a5203bed44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539183}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f515b153-b2d5-5f07-b698-2b223e35049e" :question/problem "Which of the following is equivalent to the integral $\\displaystyle \\int_C2\\left((x^{3} - y)\\right)ds$, where the curve $C$ is parametrized by $r(t) = 2ti + (2 - t)j$ for $- \\frac{3}{2}\\le t\\le 2$?" :question/worked-solution "Since $r(t)=\\langle 2 t, 2 - t\\rangle,$ then along the curve we have $x=2 t$, $y=2 - t$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t)&=\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j \\\\ &= \\frac{\\mathrm{d}}{\\mathrm{d}t}(2 t)i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(2 - t)j \\\\ &= (2)\\,i+(-1)\\,j \\\\ \\|r'(t)\\|&=\\sqrt{(\\frac{\\mathrm{d}x}{\\mathrm{d}t})^2+(\\frac{\\mathrm{d}y}{\\mathrm{d}t})^2} \\\\ &= \\sqrt{(2)^2+(-1)^2} \\\\ &= \\sqrt{5}\\end{aligned}\n$$\n\nNow, since $f(x,y)=2 x^{3} - 2 y$, we obtain\n\n$$\n\\begin{aligned}f(r(t))&=2\\left((2 t)^3-(2 - t)\\right) \\\\ &= 2\\left(8t^3-2+t\\right) \\\\ &= 16 t^{3} + 2 t - 4.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f(x,y)\\,\\mathrm{d}s&=\\int_{- \\frac{3}{2}}^{2} f(r(t))\\,\\|r'(t)\\|\\,\\mathrm{d}t \\\\ &= \\int_{- \\frac{3}{2}}^{2}(16 t^{3} + 2 t - 4)(\\sqrt{5})\\,\\mathrm{d}t \\\\ &= \\int_{- \\frac{3}{2}}^{2}2 \\sqrt{5} \\left(8 t^{3} + t - 2\\right)\\,\\mathrm{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186539204 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30338bca-6ca0-51af-8f2f-96eb86969268" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{3}{2}}12 t^{3} + 3 t^{2} - 18 t - 27\\,\\mathrm{d}t" :db/id #edb/ref 17592186539137} {:answer/id #uuid "4a9fac12-ab2b-5bd8-ac50-2e5e3c1a9b49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{3}{2}}3 \\sqrt{16 t^{2} + 5} \\left(4 t^{3} + t^{2} - 6 t - 9\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539148} {:answer/id #uuid "5d90c9ff-4b45-5a51-ad47-6931f43284f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{3}{2}}3 \\sqrt{16 t^{2} + 5} \\left(2 t^{2} \\left(2 t + 1\\right) + \\left(t + 3\\right)^{2}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539154} {:answer/id #uuid "741d6ee7-19d1-5aef-a755-d8ed6ebfa877" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{3}{2}}\\frac{3 \\left(4 t^{3} + t^{2} - 6 t - 9\\right)}{\\sqrt{16 t^{2} + 5}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186539160} {:answer/id #uuid "a543efd7-e7a5-5a36-9b77-3946d717a988" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{3}{2}}3 \\left(16 t^{2} + 5\\right) \\left(4 t^{3} + t^{2} - 6 t - 9\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539176}] :answer-field/correct {:answer/id #uuid "4a9fac12-ab2b-5bd8-ac50-2e5e3c1a9b49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{1}^{\\frac{3}{2}}3 \\sqrt{16 t^{2} + 5} \\left(4 t^{3} + t^{2} - 6 t - 9\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186539148} :answer-field/id #uuid "4103d898-eeb8-573e-bb32-54b6347b1152" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539143}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fcd80b68-90ad-5381-82bb-4a395bb5f45b" :question/problem "Which of the following is equivalent to $\\int_C 3 x y - 3 z^{2}\\,\\mathrm{d}s,$ where the curve $C$ is parametrized by $r(t)=\\langle 2 t^{2}, 2 t + 1, t + 3\\rangle$ for $1\\le t\\le \\frac{3}{2}$?" :question/worked-solution "Since $r(t)=\\langle 2 t^{2}, 2 t + 1, t + 3\\rangle,$ then along the curve we have $x=2 t^{2}$, $y=2 t + 1$, $z=t + 3$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t)&=\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j+\\frac{\\mathrm{d}z}{\\mathrm{d}t}\\,k \\\\ &= \\frac{\\mathrm{d}}{\\mathrm{d}t}(2 t^{2})i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(2 t + 1)j+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t + 3)k \\\\ &= (4 t)\\,i+(2)\\,j+(1)\\,k \\\\ \\|r'(t)\\|&=\\sqrt{(\\frac{\\mathrm{d}x}{\\mathrm{d}t})^2+(\\frac{\\mathrm{d}y}{\\mathrm{d}t})^2+(\\frac{\\mathrm{d}z}{\\mathrm{d}t})^2} \\\\ &= \\sqrt{(4 t)^2+(2)^2+(1)^2} \\\\ &= \\sqrt{16 t^{2} + 5}\\end{aligned}\n$$\n\nNow, since $f(x,y,z)=3 x y - 3 z^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r(t))&=3\\left((2 t^{2})(2 t + 1)-(t + 3)^2\\right) \\\\ &= 3\\left(4t^3+(2)t^2-\\left(1t^2+(6)t+9\\right)\\right) \\\\ &= 12 t^{3} + 3 t^{2} - 18 t - 27.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f(x,y,z)\\,\\mathrm{d}s&=\\int_{1}^{\\frac{3}{2}} f(r(t))\\,\\|r'(t)\\|\\,\\mathrm{d}t \\\\ &= \\int_{1}^{\\frac{3}{2}}(12 t^{3} + 3 t^{2} - 18 t - 27)(\\sqrt{16 t^{2} + 5})\\,\\mathrm{d}t \\\\ &= \\int_{1}^{\\frac{3}{2}}3 \\sqrt{16 t^{2} + 5} \\left(4 t^{3} + t^{2} - 6 t - 9\\right)\\,\\mathrm{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186539208 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "411d88e5-d8e0-59e2-9232-75d02c67dc6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{3}{5} & \\frac{5}{4} & - \\frac{1}{2} \\\\ - \\frac{1}{4} & \\frac{5}{4} & - \\frac{2}{3}\\end{bmatrix}" :db/id #edb/ref 17592186539226} {:answer/id #uuid "6a95c24c-3950-52f9-95dc-6fd2562407a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\frac{9}{25} & - \\frac{3}{4} & \\frac{3}{10} \\\\ - \\frac{1}{4} & \\frac{5}{4} & - \\frac{2}{3}\\end{bmatrix}" :db/id #edb/ref 17592186539237} {:answer/id #uuid "71cd9849-777d-523c-9920-ab59ee979d28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{9}{25} & \\frac{3}{4} & - \\frac{3}{10} \\\\ - \\frac{3}{20} & \\frac{3}{4} & - \\frac{2}{5}\\end{bmatrix}" :db/id #edb/ref 17592186539238} {:answer/id #uuid "7740c74d-1463-597d-bf77-c2d951ee04de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{3}{5} & \\frac{5}{4} & - \\frac{1}{2} \\\\ \\frac{3}{20} & - \\frac{3}{4} & \\frac{2}{5}\\end{bmatrix}" :db/id #edb/ref 17592186539240} {:answer/id #uuid "adc7ef85-066e-57d2-bc6e-07c756c579dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\frac{9}{25} & - \\frac{3}{4} & \\frac{3}{10} \\\\ \\frac{3}{20} & - \\frac{3}{4} & \\frac{2}{5}\\end{bmatrix}" :db/id #edb/ref 17592186539254}] :answer-field/correct {:answer/id #uuid "adc7ef85-066e-57d2-bc6e-07c756c579dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\frac{9}{25} & - \\frac{3}{4} & \\frac{3}{10} \\\\ \\frac{3}{20} & - \\frac{3}{4} & \\frac{2}{5}\\end{bmatrix}" :db/id #edb/ref 17592186539254} :answer-field/id #uuid "2839558c-d69e-56b6-8b69-294e6e1bcbdd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539217}] :question/difficulty {:db/id #e