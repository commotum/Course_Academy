.type/image} :answer/value "images/0a/0a0a0e427d1617a030410cdb7ed110cf7d71b8d0869627ced4d90d012d016781.png" :db/id #edb/ref 17592186513438} {:answer/id #uuid "8ab306ce-ffd0-57b9-89e5-ee35f2602dc2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/04/04f8e402fe931c9eaddc08cc6ac1a710af2f3c85ca50f50e13c7cf273f001946.png" :db/id #edb/ref 17592186513452} {:answer/id #uuid "a92dd285-a412-59a5-881e-ad81ad2cb5da" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a2/a2f69bdd1658699e1df5325d34bda26457b756b5e29aa187ff6cd2b0c7b9abf5.png" :db/id #edb/ref 17592186513469}] :answer-field/correct {:answer/id #uuid "a92dd285-a412-59a5-881e-ad81ad2cb5da" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a2/a2f69bdd1658699e1df5325d34bda26457b756b5e29aa187ff6cd2b0c7b9abf5.png" :db/id #edb/ref 17592186513469} :answer-field/id #uuid "4ec284ce-e6f7-5943-bba6-5127bca6965c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186513440}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ee9152ac-2e4a-5d63-b83e-58f3c8911174" :question/problem "Which of the following is the graph of $y={(\\frac{3}{2})}^{x}-3?$" :question/worked-solution "First, we plot the graph of $y={(\\frac{3}{2})}^{x}:$\n\n![](images/d6/d648afa4906f2e2dc6661e3020e83eca28724dee7b46ddc61c36373584e8cb95.png)\n\nTo sketch the graph of $y={(\\frac{3}{2})}^{x}-3,$ we take the graph of $y={(\\frac{3}{2})}^{x}$ and shift it $3$ units down. The $y$-intercept moves from $(0,1)$ to $(0,-2),$ and the horizontal asymptote moves from $y=0$ to $y=-3.$\n\n![](images/57/57ad3064c37dad412554f92b4ec781c746df68bab3e02a584b123c20b71fade2.png)"} {:db/id #edb/ref 17592186514382 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35efc2f3-5a80-5c14-ac74-576bc64f637c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{3}⁡(\\frac{27}{125})=\\frac{5}{3}" :db/id #edb/ref 17592186513676} {:answer/id #uuid "4edddaae-0652-54d7-9e9e-760697b96951" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{3/5}⁡(\\frac{27}{125})=-3" :db/id #edb/ref 17592186513747} {:answer/id #uuid "a62f0c1d-b7ab-5121-a583-d8ea6867f60b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{3/5}⁡(3)=\\frac{27}{125}" :db/id #edb/ref 17592186513960} {:answer/id #uuid "aa0b430c-71e7-521b-9094-32d9db437933" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{5/3}⁡(3)=\\frac{27}{125}" :db/id #edb/ref 17592186513974} {:answer/id #uuid "d64ad2ea-d44d-5757-b9ab-7c102491d163" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{5/3}⁡(\\frac{27}{125})=-3" :db/id #edb/ref 17592186514092}] :answer-field/correct {:answer/id #uuid "d64ad2ea-d44d-5757-b9ab-7c102491d163" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{5/3}⁡(\\frac{27}{125})=-3" :db/id #edb/ref 17592186514092} :answer-field/id #uuid "e306a9cd-6875-5b02-81a9-110f46795dae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514330}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "277ed942-8515-5af5-8070-395ac017b6ed" :question/math-academy-id "q-108051" :question/problem "${(\\frac{5}{3})}^{-3}=\\frac{27}{125}$ can be expressed as" :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n$a={b}^{x}$ is equivalent to ${log}_{b}⁡a=x$\n\nIf we compare ${(\\frac{5}{3})}^{-3}=\\frac{27}{125}$ with $a={b}^{x},$ we get $a=\\frac{27}{125},b=\\frac{5}{3}$ and $x=-3.$\n\nTherefore, the given equation can be expressed as ${log}_{5/3}⁡(\\frac{27}{125})=-3.$"} {:db/id #edb/ref 17592186514383 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06eef846-65a9-5990-acd0-b045e13d1cf7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{x}^{3/2}+C" :db/id #edb/ref 17592186513548} {:answer/id #uuid "393f1a37-77c6-5bbd-a580-db9adc219b01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{-1/3}+C" :db/id #edb/ref 17592186513680} {:answer/id #uuid "68568d39-43ec-5afd-b396-0468db1f01fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}^{-1/2}+C" :db/id #edb/ref 17592186513812} {:answer/id #uuid "b0ca349d-23a9-53ce-9e6b-be88f7c8ec44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{1/2}+C" :db/id #edb/ref 17592186513996} {:answer/id #uuid "c14ac74e-1927-56c7-a26e-5732f3c912ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{-3/2}+C" :db/id #edb/ref 17592186514042}] :answer-field/correct {:answer/id #uuid "68568d39-43ec-5afd-b396-0468db1f01fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}^{-1/2}+C" :db/id #edb/ref 17592186513812} :answer-field/id #uuid "eae9e030-db6a-548d-840a-748c2245c7ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514337}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "28f4ccc6-88e6-5461-934d-fc36db9c8ad4" :question/math-academy-id "q-29993" :question/problem "Given that $f(x)=\\frac{1}{\\sqrt{{x}^{3}}}$ and that ${F}^{′}(x)=f(x)$, calculate $F(x).$" :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{′}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{′}(x) & =f(x) \\\\ \\int {F}^{′}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nNote that $\\frac{1}{\\sqrt{{x}^{3}}}={x}^{-3/2}.$ So, we can use the power rule with $n=-\\frac{3}{2}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int \\frac{1}{\\sqrt{{x}^{3}}}\\,\\text{d}x \\\\  & =\\int {x}^{-3/2}\\,\\text{d}x \\\\  & =\\frac{{x}^{-3/2+1}}{(-\\frac{3}{2}+1)}+C \\\\  & =\\frac{{x}^{-1/2}}{(-\\frac{1}{2})}+C \\\\  & =-2{x}^{-1/2}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514388 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09e343d0-9e3d-57b4-a7bc-fc9b2686c5b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{x}^{3/2}}{3}+C" :db/id #edb/ref 17592186513556} {:answer/id #uuid "4f2855e0-fb0a-5301-b062-4ac8a822906c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{3/2}}{2}+C" :db/id #edb/ref 17592186513749} {:answer/id #uuid "81cf656b-bd3c-5484-968b-6e7bc93c98ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{x}^{5/2}}{5}+C" :db/id #edb/ref 17592186513870} {:answer/id #uuid "b4fe22da-80f5-5f8c-9080-2147a668ed55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{1/2}}{2}+C" :db/id #edb/ref 17592186514005} {:answer/id #uuid "dec7850d-5fd9-5c84-b294-33569ce40c41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{x}^{1/2}}{3}+C" :db/id #edb/ref 17592186514117}] :answer-field/correct {:answer/id #uuid "09e343d0-9e3d-57b4-a7bc-fc9b2686c5b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{x}^{3/2}}{3}+C" :db/id #edb/ref 17592186513556} :answer-field/id #uuid "42f6efb1-acc1-594f-9863-9843b604f60e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514255}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "34621fcb-1a0d-5d3e-9880-09e09830a08f" :question/math-academy-id "q-2024" :question/problem "$\\int \\sqrt{x}\\,\\text{d}x=$" :question/worked-solution "We start by writing the root as a rational power, $\\sqrt{x}={x}^{1/2}.$ So, we can apply the power rule with $n=\\frac{1}{2}$ and get\n\n$$\n\\begin{aligned}\\int \\sqrt{x}\\,\\text{d}x & =\\int {x}^{1/2}\\,\\text{d}x \\\\  & =\\frac{{x}^{1/2+1}}{(\\frac{1}{2}+1)}+C \\\\  & =\\frac{{x}^{3/2}}{(\\frac{3}{2})}+C \\\\  & =\\frac{2{x}^{3/2}}{3}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{2{x}^{3/2}}{3}+C) &= \\frac{\\text{d}}{\\text{d}x}(\\frac{2{x}^{3/2}}{3})+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{2}{3}\\frac{\\text{d}}{\\text{d}x}({x}^{3/2})+0 \\\\ &= \\frac{2}{3}\\cdot \\frac{3}{2}{x}^{3/2-1} \\\\ &= {x}^{1/2}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514390 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "877168ac-4c34-57ba-a846-5362369f5757" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{5}{x}^{3/2}+C" :db/id #edb/ref 17592186513885} {:answer/id #uuid "943d70e7-e52b-597e-9871-44857a8a7ae4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{3}{x}^{5/2}+C" :db/id #edb/ref 17592186513915} {:answer/id #uuid "c6b24cd8-5808-5ff4-8dd5-6d0e70ccaa9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{5}{x}^{5/2}+C" :db/id #edb/ref 17592186514052} {:answer/id #uuid "e25dd75d-4458-58ea-a630-3ccbc3fecb7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{7}{x}^{3/2}+C" :db/id #edb/ref 17592186514125} {:answer/id #uuid "e355f008-e331-5495-83d3-a7df50fe8e9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}{x}^{5/2}+C" :db/id #edb/ref 17592186514130}] :answer-field/correct {:answer/id #uuid "e355f008-e331-5495-83d3-a7df50fe8e9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}{x}^{5/2}+C" :db/id #edb/ref 17592186514130} :answer-field/id #uuid "15bc8d9e-bde6-57af-844a-0b82646dbe35" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514224}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "37cc1eff-0240-5120-ba5e-14ada8bc6fca" :question/math-academy-id "q-29665" :question/problem "$\\int \\sqrt{{x}^{3}}\\,\\text{d}x=$" :question/worked-solution "We start by writing the root as a rational power, $\\sqrt{{x}^{3}}={x}^{3/2}.$ So, we can apply the power rule with $n=\\frac{3}{2}$ and get\n\n$$\n\\begin{aligned}\\int \\sqrt{{x}^{3}}\\,\\text{d}x & =\\int {x}^{3/2}\\,\\text{d}x \\\\  & =\\frac{{x}^{3/2+1}}{(\\frac{3}{2}+1)}+C \\\\  & =\\frac{{x}^{5/2}}{(\\frac{5}{2})}+C \\\\  & =\\frac{2{x}^{5/2}}{5}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{2{x}^{5/2}}{5}+C) &= \\frac{\\text{d}}{\\text{d}x}(\\frac{2{x}^{5/2}}{5})+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{2}{5}\\frac{\\text{d}}{\\text{d}x}({x}^{5/2})+0 \\\\ &= \\frac{2}{5}\\cdot \\frac{5}{2}{x}^{5/2-1} \\\\ &= {x}^{3/2}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514391 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25425771-e7b7-59e7-a21c-34da79a147e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{{x}^{1/2}}+C" :db/id #edb/ref 17592186513636} {:answer/id #uuid "46f4c2a1-30c4-58bc-a872-acf707c7f214" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}^{5/2}+C" :db/id #edb/ref 17592186513723} {:answer/id #uuid "bf5da9ff-937c-53a4-b1fa-cc6b757fbfad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{1/2}}+C" :db/id #edb/ref 17592186514037} {:answer/id #uuid "dae23439-686a-536f-8883-85442f6a6ebc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{1/2}+C" :db/id #edb/ref 17592186514104} {:answer/id #uuid "fd7a9df8-4ded-54ff-9dd7-df5316a89579" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2{x}^{5/2}}+C" :db/id #edb/ref 17592186514198}] :answer-field/correct {:answer/id #uuid "25425771-e7b7-59e7-a21c-34da79a147e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{{x}^{1/2}}+C" :db/id #edb/ref 17592186513636} :answer-field/id #uuid "a255f30f-2d4d-5a18-8010-7066f9da2d12" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514303}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3ce88619-593c-543d-be7b-78867655bb11" :question/math-academy-id "q-113703" :question/problem "Given that $f(x)=\\frac{1}{{x}^{3/2}}$ and that ${F}^{′}(x)=f(x)$, calculate $F(x).$" :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{′}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{′}(x) & =f(x) \\\\ \\int {F}^{′}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nNote that $\\frac{1}{{x}^{3/2}}={x}^{-3/2}.$ So, we can use the power rule with $n=-\\frac{3}{2}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{-3/2}\\,\\text{d}x \\\\  & =\\frac{{x}^{-3/2+1}}{(-\\frac{3}{2}+1)}+C \\\\  & =\\frac{{x}^{-1/2}}{(-\\frac{1}{2})}+C \\\\  & =-2{x}^{-1/2}+C \\\\  & =-\\frac{2}{{x}^{1/2}}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514392 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1036a5d2-4490-507d-98fa-001436fca0c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{1/3}⁡(1.587)≈4" :db/id #edb/ref 17592186513573} {:answer/id #uuid "11bc61a1-c5df-575f-a750-df7c1b87d279" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{4}⁡(1.587)≈\\frac{1}{3}" :db/id #edb/ref 17592186513578} {:answer/id #uuid "44f257e1-6c2d-5a7b-b95b-d1cc1c85a226" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{1.587}⁡(4)≈\\frac{1}{3}" :db/id #edb/ref 17592186513715} {:answer/id #uuid "80e8559d-f893-517b-8e0e-7cc3f3f01d21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{4}⁡(\\frac{1}{3})≈1.587" :db/id #edb/ref 17592186513868} {:answer/id #uuid "de29e40b-df70-5eef-a11c-b501cec6c718" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{1.587}⁡(\\frac{1}{3})≈4" :db/id #edb/ref 17592186514116}] :answer-field/correct {:answer/id #uuid "11bc61a1-c5df-575f-a750-df7c1b87d279" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{4}⁡(1.587)≈\\frac{1}{3}" :db/id #edb/ref 17592186513578} :answer-field/id #uuid "2d76220b-8379-56f0-b6f2-29c1efe40950" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514243}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3dd9e34f-3ee0-5a42-8a59-8773ae3a745a" :question/math-academy-id "q-66569" :question/problem "$\\sqrt[3]{4}≈1.587$ is equivalent to" :question/worked-solution "Notice that the given approximation can be written using exponents as follows:\n\n$$\n{4}^{1/3}≈1.587\n$$\n\nThe logarithm of $a$ with base $b$ is defined as follows:\n\n$a={b}^{x}$ is equivalent to ${log}_{b}⁡a=x$\n\nIf we compare ${4}^{1/3}≈1.587$ with $a={b}^{x},$ we get $a=1.587,b=4$ and $x=\\frac{1}{3}.$\n\nTherefore, the approximation $\\sqrt[3]{4}≈1.587$ is equivalent to ${log}_{4}⁡(1.587)≈\\frac{1}{3}.$"} {:db/id #edb/ref 17592186514399 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "602172b3-6445-5c63-91e9-d860394ce5a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186513790} {:answer/id #uuid "71a5e4f2-139f-523f-9c38-312f34b1bd6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186513834} {:answer/id #uuid "79827563-1b5d-5c99-902a-4ea904d05b4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt[3]{2}" :db/id #edb/ref 17592186513851} {:answer/id #uuid "b8839d8b-e0bd-5cb4-8bde-c168499e0d23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186514020} {:answer/id #uuid "f672a463-52c0-5b34-9a86-4f4728479311" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186514176}] :answer-field/correct {:answer/id #uuid "602172b3-6445-5c63-91e9-d860394ce5a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186513790} :answer-field/id #uuid "81cfc4b2-47d0-50ed-a06c-623ea25dae23" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514286}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "522ad648-b326-5d90-9d3d-5351c0a03cfc" :question/math-academy-id "q-100306" :question/problem "![](images/b1/b12ba04b803d58c6cacf4fc781db5c7032c3aedad80506c101bf084109ebd797.png)\n\nFind ${lim}_{x\\to -2}\\sqrt[3]{\\frac{4(f(x))^{3}-3{x}^{2}}{2}}$ for the function $f(x)$ plotted above." :question/worked-solution "From the graph, we get that ${lim}_{x\\to -2}f(x)=-1.$\n\nApplying the root rule, we have \n\n$$\n\\begin{aligned}{lim}_{x\\to -2}\\sqrt[3]{\\frac{4(f(x))^{3}-3{x}^{2}}{2}} & =\\sqrt[3]{{lim}_{x\\to -2}(\\frac{4(f(x))^{3}-3{x}^{2}}{2})} \\\\  & =\\sqrt[3]{\\frac{4\\cdot (-1)^{3}-3(-2)^{2}}{2}} \\\\  & =\\sqrt[3]{\\frac{-4-12}{2}} \\\\  & =\\sqrt[3]{-8} \\\\  & =-2\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514422 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f4e9c3e-c075-5ee8-b58c-ef68c609d2b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^x(\\cos x-\\sin x)}{8\\sin^2 x}" :db/id #edb/ref 17592186513862}] :answer-field/correct {:answer/id #uuid "7f4e9c3e-c075-5ee8-b58c-ef68c609d2b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^x(\\cos x-\\sin x)}{8\\sin^2 x}" :db/id #edb/ref 17592186513862} :answer-field/id #uuid "ba412a72-8abe-5840-811a-70be04c017e7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514310}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "709bef3c-1deb-5177-94a0-6a0cd6bca192" :question/math-academy-id "q-166075" :question/problem "$\\frac{\\text{d}}{\\text{d}x}(\\frac{f}{h})\\,=${{field-1}}" :question/worked-solution "Recall that $f(x)=\\frac{1}{2}{e}^{x}$ and $h(x)=-4\\operatorname{sin}⁡x.$\n\nWe apply the quotient rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{f}{h}) & =\\frac{{f}^{′}(x)\\cdot h(x)-f(x)\\cdot {h}^{′}(x)}{[h(x)]^{2}} \\\\  & =\\frac{{(\\frac{1}{2}{e}^{x})}^{′}\\cdot (-4\\operatorname{sin}⁡x)-(\\frac{1}{2}{e}^{x})\\cdot (-4\\operatorname{sin}⁡x)^{′}}{(-4\\operatorname{sin}⁡x)^{2}} \\\\  & =\\frac{(\\frac{1}{2}{e}^{x})\\cdot (-4\\operatorname{sin}⁡x)-(\\frac{1}{2}{e}^{x})\\cdot (-4\\operatorname{cos}⁡x)}{16{sin}^{2}⁡x} \\\\  & =\\frac{2{e}^{x}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)}{16{sin}^{2}⁡x} \\\\  & =\\frac{{e}^{x}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)}{8{sin}^{2}⁡x}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514428 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ddf04c2-71d3-54b1-9f4b-d9699e9cc552" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{12}}{13}+C" :db/id #edb/ref 17592186513693} {:answer/id #uuid "69f7fd71-6066-58ff-973d-5a24b0715dc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{14}}{14}+C" :db/id #edb/ref 17592186513816} {:answer/id #uuid "a01e6e97-6d87-5937-8e57-076aaa390207" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{12}}{12}+C" :db/id #edb/ref 17592186513942} {:answer/id #uuid "a8adc543-25c4-55be-8081-e8857819cce0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{14}+C" :db/id #edb/ref 17592186513971} {:answer/id #uuid "f56d5cb2-21a5-51fe-8738-17f8affe9a15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13{x}^{14}+C" :db/id #edb/ref 17592186514172}] :answer-field/correct {:answer/id #uuid "69f7fd71-6066-58ff-973d-5a24b0715dc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{14}}{14}+C" :db/id #edb/ref 17592186513816} :answer-field/id #uuid "c8fbc5ea-5d9e-52eb-88d3-b4d6971c6c74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514321}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c1117fb-96ed-5032-8c50-48772b44cf5c" :question/math-academy-id "q-113668" :question/problem "Calculate $F(x)$ given that $f(x)={x}^{13}$ and ${F}^{′}(x)=f(x).$" :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{′}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{′}(x) & =f(x) \\\\ \\int {F}^{′}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe apply the power rule with $n=13$, and we get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{13}\\,\\text{d}x \\\\  & =\\frac{{x}^{13+1}}{13+1}+C \\\\  & =\\frac{{x}^{14}}{14}+C.\\end{aligned}\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{14}}{14}+C) &= \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{14}}{14})+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{14}\\frac{\\text{d}}{\\text{d}x}({x}^{14})+0 \\\\ &= \\frac{1}{14}\\cdot 14\\,{x}^{13} \\\\ &= {x}^{13}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514440 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09eb58fc-db0a-591c-80dc-ab3b7bc520c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186513557} {:answer/id #uuid "22aa6597-ab52-5b75-99a4-6b7169a14c1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186513625} {:answer/id #uuid "5df8c413-c26f-5f42-ac67-136b2b31dc40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186513784} {:answer/id #uuid "9a9cd59c-78db-5f98-80ed-7eef9e41e3f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186513933} {:answer/id #uuid "e5b231a6-a623-5fb9-a9f6-14b416081d8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186514136}] :answer-field/correct {:answer/id #uuid "9a9cd59c-78db-5f98-80ed-7eef9e41e3f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186513933} :answer-field/id #uuid "14414f8e-6193-5fb6-baea-94b2b7d400fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514220}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9722b50e-b540-58f7-8d1d-e4a47908bdb3" :question/math-academy-id "q-105944" :question/problem "![](images/7d/7defdf7c31a164fdbe702c1f5e87567f5da868d7530143493f9713ff88de98bc.png)\n\nFind ${lim}_{x\\to \\,-\\frac{3}{2}}f(x)$ for the function above." :question/worked-solution "As $x$ approaches $-\\frac{3}{2},$ the value of $f(x)$ approaches $2.$ Consequently, \n\n$$\n{lim}_{x\\to \\,-\\frac{3}{2}}f(x)=2\\,.\n$$\n\nRemember, it does not matter that the actual value of $f(-\\frac{3}{2})$ is $0.$ All that matters is that as $x$ approaches $-\\frac{3}{2},$ the function $f(x)$ *looks like* it is getting closer and closer to $2.$"} {:db/id #edb/ref 17592186514446 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0387228b-625c-57a2-b9a5-65db0be7f989" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{5}+C" :db/id #edb/ref 17592186513537} {:answer/id #uuid "6b8e57bc-7acc-5bac-a92c-82592c8e49c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{4}}{4}+C" :db/id #edb/ref 17592186513823} {:answer/id #uuid "78df9ad8-f292-595e-872f-5f8ef18126cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{x}^{5}+C" :db/id #edb/ref 17592186513850} {:answer/id #uuid "aaf0e947-1093-5e50-a47b-29c991bd99cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{5}+C" :db/id #edb/ref 17592186513977} {:answer/id #uuid "b224165e-2200-5c30-be67-560f8a090e5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{4}}{5}+C" :db/id #edb/ref 17592186513998}] :answer-field/correct {:answer/id #uuid "aaf0e947-1093-5e50-a47b-29c991bd99cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{5}+C" :db/id #edb/ref 17592186513977} :answer-field/id #uuid "ee20556c-e250-51aa-b85c-fc28797d2901" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514340}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a4e1eabf-8b25-5ba2-8660-9b7cb6a5610c" :question/math-academy-id "q-29994" :question/problem "Calculate $F(x)$ given that $f(x)={x}^{4}$ and ${F}^{′}(x)=f(x).$" :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{′}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{′}(x) & =f(x) \\\\ \\int {F}^{′}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe apply the power rule with $n=4$, and we get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{4}\\,\\text{d}x \\\\  & =\\frac{{x}^{4+1}}{4+1}+C \\\\  & =\\frac{{x}^{5}}{5}+C.\\end{aligned}\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{5}}{5}+C) &= \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{5}}{5})+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{5}\\frac{\\text{d}}{\\text{d}x}({x}^{5})+0 \\\\ &= \\frac{1}{5}\\cdot 5{x}^{4} \\\\ &= {x}^{4}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514456 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c27e08e-7979-5085-966a-00121afa4123" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{3}⁡(\\frac{1}{27})=-3" :db/id #edb/ref 17592186513779} {:answer/id #uuid "5f7bb6ce-8cc7-571e-bcdb-5f8b2f8aa903" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{1/27}⁡(3)=-3" :db/id #edb/ref 17592186513789} {:answer/id #uuid "af149b16-2612-571f-b52c-5eeaf58f7db5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{1/3}⁡(\\frac{1}{27})=-3" :db/id #edb/ref 17592186513991} {:answer/id #uuid "e8435ee1-2262-52ef-a9f1-8810afdf0d86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{1/27}⁡(3)=-\\frac{1}{3}" :db/id #edb/ref 17592186514139} {:answer/id #uuid "eb25b335-5a1c-5de6-9dd1-8cde3debcc45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{3}⁡(3)=-\\frac{1}{27}" :db/id #edb/ref 17592186514146}] :answer-field/correct {:answer/id #uuid "5c27e08e-7979-5085-966a-00121afa4123" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{3}⁡(\\frac{1}{27})=-3" :db/id #edb/ref 17592186513779} :answer-field/id #uuid "fe35be8a-6cae-54e8-bb3f-35ee3a0741c6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514354}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bb68a7c2-cb48-5196-952e-fea6e54d1914" :question/math-academy-id "q-66572" :question/problem "${3}^{-3}=\\frac{1}{27}$ can be expressed as" :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n$a={b}^{x}$ is equivalent to ${log}_{b}⁡a=x$\n\nIf we compare ${3}^{-3}=\\frac{1}{27}$ with $a={b}^{x},$ we get $a=\\frac{1}{27},b=3$ and $x=-3.$\n\nTherefore, the given equation can be expressed as ${log}_{3}⁡(\\frac{1}{27})=-3.$"} {:db/id #edb/ref 17592186514459 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1271b9bb-4fdb-5546-ba5d-c1a6d89b1fad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{1.414}⁡(2)≈\\frac{1}{2}" :db/id #edb/ref 17592186513580} {:answer/id #uuid "333d8f38-b484-5b5c-869f-463a6bcb7de1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{2}⁡(1.414)≈\\frac{1}{2}" :db/id #edb/ref 17592186513670} {:answer/id #uuid "49d0c7ae-e60f-5aab-ae75-f8fed70ad7c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{1/2}⁡(2)≈1.414" :db/id #edb/ref 17592186513732} {:answer/id #uuid "4d05961b-3847-5b4d-a042-e9b4bdb8e4d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{1/2}⁡(1.414)≈2" :db/id #edb/ref 17592186513741} {:answer/id #uuid "8582ee23-38f4-5200-ad88-a59804769f78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{2}⁡(\\frac{1}{2})≈1.414" :db/id #edb/ref 17592186513880}] :answer-field/correct {:answer/id #uuid "333d8f38-b484-5b5c-869f-463a6bcb7de1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{2}⁡(1.414)≈\\frac{1}{2}" :db/id #edb/ref 17592186513670} :answer-field/id #uuid "c725419d-ab8e-5561-9557-352ac0cb53cd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514320}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "be53ea1d-fce1-50b2-b27f-f485b9e423e6" :question/math-academy-id "q-66504" :question/problem "$\\sqrt{2}≈1.414$ can be expressed as" :question/worked-solution "Notice that the given approximation can be written using exponents as follows:\n\n$$\n{2}^{1/2}≈1.412\n$$\n\nThe logarithm of $a$ with base $b$ is defined as follows:\n\n$a={b}^{x}$ is equivalent to ${log}_{b}⁡a=x$\n\nIf we compare ${2}^{1/2}≈1.412$ with $a={b}^{x},$ we get $a=1.412,b=2$ and $x=\\frac{1}{2}.$\n\nTherefore, the approximation $\\sqrt{2}≈1.414$ can be expressed as ${log}_{2}⁡(1.414)≈\\frac{1}{2}.$"} {:db/id #edb/ref 17592186514476 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10b3f0de-10ab-59f8-9482-ea6432ae1a1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{1/16}⁡16=0" :db/id #edb/ref 17592186513574} {:answer/id #uuid "130dd748-2866-5a43-a676-5219cb240dfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{1/16}⁡(\\frac{1}{16})=0" :db/id #edb/ref 17592186513582} {:answer/id #uuid "45709d79-2399-5b8b-aae1-30eedf29c6f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{16}⁡(\\frac{1}{16})=1" :db/id #edb/ref 17592186513717} {:answer/id #uuid "4eaaec78-93a2-5429-be99-8a6af0db45f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{16}⁡(\\frac{1}{16})=0" :db/id #edb/ref 17592186513745} {:answer/id #uuid "b60d526a-7477-5f97-a248-b96dfdb5a1a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{1/16}⁡(\\frac{1}{16})=1" :db/id #edb/ref 17592186514008}] :answer-field/correct {:answer/id #uuid "b60d526a-7477-5f97-a248-b96dfdb5a1a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{1/16}⁡(\\frac{1}{16})=1" :db/id #edb/ref 17592186514008} :answer-field/id #uuid "226d2ad1-67a7-50c4-9d80-2df4abf628bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514234}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f3941239-6e19-5b0b-909a-0a8f6dea7adb" :question/math-academy-id "q-108048" :question/problem "${(\\frac{1}{16})}^{1}=\\frac{1}{16}$ can be expressed as" :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n$a={b}^{x}$ is equivalent to ${log}_{b}⁡a=x$\n\nIf we compare ${(\\frac{1}{16})}^{1}=\\frac{1}{16}$ with $a={b}^{x},$ we get $a=\\frac{1}{16},b=\\frac{1}{16}$ and $x=1.$\n\nTherefore, the equation ${(\\frac{1}{16})}^{1}=\\frac{1}{16}$ is equivalent to ${log}_{1/16}⁡(\\frac{1}{16})=1.$\n\nNote that ${log}_{n}⁡n=1$ for any $n>0,n\\ne 1.$"} {:db/id #edb/ref 17592186514703 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3290ca22-85b1-5010-b252-fd71c7aaeaa6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2" :db/id #edb/ref 17592186514708} {:answer/id #uuid "533449c2-f420-5b88-93c9-668606f100be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{3}{4}x+1" :db/id #edb/ref 17592186514714} {:answer/id #uuid "7a2d2a22-b7a3-5f11-9168-09d82dd1b393" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{3}{4}x+12" :db/id #edb/ref 17592186514727} {:answer/id #uuid "ef1d6837-6555-55f5-a26a-23fd7d46c88d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{4}{3}x+8" :db/id #edb/ref 17592186514745} {:answer/id #uuid "fa38e448-943f-59dd-aaed-18fd0d1d6323" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{4}{3}x+7" :db/id #edb/ref 17592186514749}] :answer-field/correct {:answer/id #uuid "533449c2-f420-5b88-93c9-668606f100be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{3}{4}x+1" :db/id #edb/ref 17592186514714} :answer-field/id #uuid "d4281c2e-86be-55c1-96d9-104015e20715" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514740}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0ec45cd1-947a-5593-8393-8ebfcb09500c" :question/problem "Which of the following lines is perpendicular to $8x+6y=-19?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nTo find the slope of the given line $8x+6y=-19,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}8x+6y & =-19 \\\\ 6y & =-8x-19 \\\\ y & =-\\frac{8}{6}x-\\frac{19}{6} \\\\ y & =-\\frac{4}{3}x-\\frac{19}{6}\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope of the given line is $-\\frac{4}{3}.$\n\nLooking at the answer choices, the line $y=\\frac{3}{4}x+1$ has a slope of $\\frac{3}{4}.$\n\nMultiplying the slopes together, we have\n\n$$\n(-\\frac{4}{3})\\cdot \\frac{3}{4}=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=\\frac{3}{4}x+1$ is perpendicular to the given line."} {:db/id #edb/ref 17592186514709 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "292bccc8-cc74-5b90-a94d-04dcf6d106bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{2}{5}x-7" :db/id #edb/ref 17592186514706} {:answer/id #uuid "73013c21-639b-59c2-ba05-860a7ecc078e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{5}{2}x+2" :db/id #edb/ref 17592186514722} {:answer/id #uuid "75f23097-b39c-5c72-8b8d-cffc9e77360e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{5}{2}x+10" :db/id #edb/ref 17592186514723} {:answer/id #uuid "7c18ab6f-d2f9-5e5c-96b0-169fd2d6f50f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3" :db/id #edb/ref 17592186514728} {:answer/id #uuid "e0a52e4a-c2fb-5bac-a746-34c7134ba3be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{2}{5}x-7" :db/id #edb/ref 17592186514743}] :answer-field/correct {:answer/id #uuid "e0a52e4a-c2fb-5bac-a746-34c7134ba3be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{2}{5}x-7" :db/id #edb/ref 17592186514743} :answer-field/id #uuid "7a0739fb-3ca5-5923-bd1b-e8fe29b00f3e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514725}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "34924683-58db-5b74-a961-9f3350d7d885" :question/problem "Which of the following lines is perpendicular to $-5x+2y=4?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nTo find the slope of the given line $-5x+2y=4,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}-5x+2y & =4 \\\\ 2y & =5x+4 \\\\ y & =\\frac{5}{2}x+2\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope of the given line is $\\frac{5}{2}.$\n\nLooking at the answer choices, the line $y=-\\frac{2}{5}x-7$ has a slope of $-\\frac{2}{5}.$\n\nMultiplying the slopes together, we have\n\n$$\n\\frac{5}{2}\\cdot (-\\frac{2}{5})=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=-\\frac{2}{5}x-7$ is perpendicular to the given line."} {:db/id #edb/ref 17592186514712 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39e54c32-6480-5814-ba72-0bd08bfaa904" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{2}{3}x-5" :db/id #edb/ref 17592186514710} {:answer/id #uuid "91ff39b0-c9a1-58f5-aecc-fe27252242b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{3}{2}x-3" :db/id #edb/ref 17592186514732} {:answer/id #uuid "a599e0b0-5077-5685-