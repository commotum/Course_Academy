1}{4}" :db/id #edb/ref 17592186516075}] :answer-field/correct {:answer/id #uuid "7fa22ead-3f1c-5d4e-9c51-f864939d6d85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{19}{4}" :db/id #edb/ref 17592186516049} :answer-field/id #uuid "cf7bb7dd-1127-5307-b856-039fd95e6b5c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186516070}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e9e02e9e-ce80-5bf5-babb-813fa2a720df" :question/problem "If $\\tan x=-\\frac{1}{2},$ for some $x$, find the value of $\\left(-\\frac{1}{2}\\right)\\tan (x+5\\pi )-5.$" :question/worked-solution "The period of $y=\\tan x$ is $\\pi .$ Therefore, for any integer $n,$ we have\n\n$$\n\\tan x=\\tan (x+n\\pi ).\n$$\n\nSubstituting $n=5$ into the above gives\n\n$$\n\\begin{aligned}\\tan x=\\tan (x+5\\cdot \\pi )=\\tan (x+5\\pi ).\\end{aligned}\n$$\n\nSince $\\tan x=-\\frac{1}{2},$ we get that $\\tan (x+5\\pi )=-\\frac{1}{2}.$ Therefore\n\n$$\n\\left(-\\frac{1}{2}\\right)\\tan (x+5\\pi )-5=-\\frac{1}{2}(-\\frac{1}{2})-5=\\frac{1}{4}-5=-\\frac{19}{4}.\n$$"} {:db/id #edb/ref 17592186516793 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4330ae15-f6f7-57b1-809f-2e8698af44d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{125}" :db/id #edb/ref 17592186516246}] :answer-field/correct {:answer/id #uuid "4330ae15-f6f7-57b1-809f-2e8698af44d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{125}" :db/id #edb/ref 17592186516246} :answer-field/id #uuid "99dc7578-e9a5-5def-a6d4-42f491265aea" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186516727} {:answer-field/choices [{:answer/id #uuid "62333d8a-a547-57b1-ac3c-5c56714cd529" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5^{-3}" :db/id #edb/ref 17592186516326}] :answer-field/correct {:answer/id #uuid "62333d8a-a547-57b1-ac3c-5c56714cd529" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5^{-3}" :db/id #edb/ref 17592186516326} :answer-field/id #uuid "b81e3147-4f8f-5dc1-aa20-2dd74fcc8034" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186516736}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3a8971db-b741-5f69-8444-adec12e8e30e" :question/math-academy-id "q-252634" :question/problem "Express the equation ${log}_{5}⁡(\\frac{1}{125})=-3$ in exponential form. Write the exponential term on the left-hand side of the equation.\n\n{{field-1}}$=$\n{{field-2}}" :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n${log}_{b}⁡a=x$ is equivalent to $a={b}^{x}$\n\nIf we compare ${log}_{5}⁡(\\frac{1}{125})=-3$ with ${log}_{b}⁡a=x,$ we get $a=\\frac{1}{125},$ $b=5,$ and $x=-3.$\n\nTherefore, the given equation is equivalent to \n\n$$\n{5}^{-3}=\\frac{1}{125}.\n$$"} {:db/id #edb/ref 17592186516813 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e579e2a-cf55-5dc2-9631-36dd85e6533e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡(\\sqrt{5}\\pi x){\\sum }_{n=1}^{\\infty }\\frac{2\\sqrt{5}}{n{\\pi }^{3}(20-{n}^{2})}" :db/id #edb/ref 17592186516209} {:answer/id #uuid "69bd26b6-6e3c-5c38-a3bc-9ab6d641cd52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\sqrt{5}\\pi x){\\sum }_{n=1}^{\\infty }\\frac{10(-1)^{n}}{n{\\pi }^{2}(20-{n}^{2})}" :db/id #edb/ref 17592186516342} {:answer/id #uuid "987d4650-fafb-51a4-b9a2-850870587748" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡(\\sqrt{5}\\pi x){\\sum }_{n=1}^{\\infty }\\frac{2\\sqrt{5}(-1)^{n}}{n{\\pi }^{3}(20-{n}^{2})}" :db/id #edb/ref 17592186516427} {:answer/id #uuid "b57bb91e-bc6a-52e3-9e91-2b526a2371b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\sqrt{5}\\pi x){\\sum }_{n=1}^{\\infty }\\frac{20}{n{\\pi }^{2}(20-{n}^{2})}" :db/id #edb/ref 17592186516491}] :answer-field/correct {:answer/id #uuid "987d4650-fafb-51a4-b9a2-850870587748" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡(\\sqrt{5}\\pi x){\\sum }_{n=1}^{\\infty }\\frac{2\\sqrt{5}(-1)^{n}}{n{\\pi }^{3}(20-{n}^{2})}" :db/id #edb/ref 17592186516427} :answer-field/id #uuid "ca20e363-d96f-5c7c-870a-e0d6761fc82a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186516742}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6e09043a-2656-5006-b96f-e232ecdf95b0" :question/math-academy-id "q-344045" :question/problem "$$\n{y}^{″}+5{\\pi }^{2}y=f(x),\\,y(0)=0,\\,{y}^{′}(0)=0\n$$\n\nConsider the initial value problem above, where $f(x)$ is an odd, $4$-periodic function. Select the missing part in the solution of the IVP, where the second infinite sum on the right-hand side below represents a particular solution of the differential equation.\n\n$$\ny(x)∼{{field-1}}+{\\sum }_{n=1}^{\\infty }\\,\\frac{20(-1)^{n}}{{n}^{2}{\\pi }^{3}(20-{n}^{2})}\\operatorname{sin}⁡(\\frac{n\\pi x}{2})\n$$" :question/worked-solution "Recall that the general solution of a linear differential equation of the form ${y}^{″}+{\\omega }^{2}y=f(x)$ is given by $y={y}_{c}+{y}_{p},$ where ${y}_{c}$ is the solution to the homogeneous equation and ${y}_{p}$ is a particular solution.\n\nFirst, we address the particular solution ${y}_{p}.$ Since $f(x)$ is an odd function, its Fourier series consists only of sine terms. For a second-order equation with no ${y}^{′}$ (damping) term, the particular solution inherits this property and is also an odd function. This is represented by the term\n\n$$\n{y}_{p}(x)={\\sum }_{n=1}^{\\infty }\\frac{20(-1)^{n}}{{n}^{2}{\\pi }^{3}(20-{n}^{2})}\\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$\n\nNext, we find the homogeneous solution. The characteristic equation ${\\lambda }^{2}+5{\\pi }^{2}=0$ gives roots $\\lambda =\\pm \\sqrt{5}\\pi \\,\\text{i}.$ So, we have\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡(\\sqrt{5}\\pi x)+B\\operatorname{sin}⁡(\\sqrt{5}\\pi x).\n$$\n\nTo find the unknown constants, we apply the initial conditions. Using $y(0)=0:$\n\n$$\n\\begin{aligned}y(0) & =A\\operatorname{cos}⁡(0)+B\\operatorname{sin}⁡(0)+{y}_{p}(0) \\\\ 0 & =A(1)+0+0 \\\\ A & =0\\end{aligned}\n$$\n\nNote that ${y}_{p}(0)=0$ because the particular solution is a sine series.\n\nNext, we use the derivative condition ${y}^{′}(0)=0.$ First, we compute the derivative of the total solution (with $A=0$):\n\n$$\n{y}^{′}(x)∼B\\sqrt{5}\\pi \\operatorname{cos}⁡(\\sqrt{5}\\pi x)+{\\sum }_{n=1}^{\\infty }\\frac{10(-1)^{n}}{n{\\pi }^{2}(20-{n}^{2})}\\operatorname{cos}⁡(\\frac{n\\pi x}{2})\n$$\n\nApplying ${y}^{′}(0)=0$ and noting that $\\operatorname{cos}⁡(0)=1,$ we have\n\n$$\n\\begin{aligned}0 & =B\\sqrt{5}\\pi +{\\sum }_{n=1}^{\\infty }\\frac{10(-1)^{n}}{n{\\pi }^{2}(20-{n}^{2})} \\\\ B\\sqrt{5}\\pi  & =-{\\sum }_{n=1}^{\\infty }\\frac{10(-1)^{n}}{n{\\pi }^{2}(20-{n}^{2})} \\\\ B & =-\\frac{1}{\\sqrt{5}\\pi }{\\sum }_{n=1}^{\\infty }\\frac{10(-1)^{n}}{n{\\pi }^{2}(20-{n}^{2})} \\\\  & =-{\\sum }_{n=1}^{\\infty }\\frac{10(-1)^{n}}{n\\sqrt{5}{\\pi }^{3}(20-{n}^{2})} \\\\  & =-{\\sum }_{n=1}^{\\infty }\\frac{2\\sqrt{5}(-1)^{n}}{n{\\pi }^{3}(20-{n}^{2})}.\\end{aligned}\n$$\n\nSubstituting $B$ back into ${y}_{c}=B\\operatorname{sin}⁡(\\sqrt{5}\\pi x)$, we find the missing part:\n\n$$\ny(x)∼-\\operatorname{sin}⁡(\\sqrt{5}\\pi x){\\sum }_{n=1}^{\\infty }\\frac{2\\sqrt{5}(-1)^{n}}{n{\\pi }^{3}(20-{n}^{2})}+{\\sum }_{n=1}^{\\infty }\\,\\frac{20(-1)^{n}}{{n}^{2}{\\pi }^{3}(20-{n}^{2})}\\operatorname{sin}⁡(\\frac{n\\pi x}{2})\n$$"} {:db/id #edb/ref 17592186516814 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30d8cfe9-4b93-5f75-80a5-535b163dfe29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "85.3%" :db/id #edb/ref 17592186516214} {:answer/id #uuid "34d6d3c7-1689-5248-895a-b81d7cf970d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "87.5%" :db/id #edb/ref 17592186516223} {:answer/id #uuid "6466cbf3-e0e7-5e28-a7cc-3d9c12cae870" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "89.8%" :db/id #edb/ref 17592186516331} {:answer/id #uuid "66956326-a3a4-5914-80b0-99ab80e8cc5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "87.9%" :db/id #edb/ref 17592186516334} {:answer/id #uuid "b3cebdaf-ad45-5124-8538-17b343686fe2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "89.4%" :db/id #edb/ref 17592186516484}] :answer-field/correct {:answer/id #uuid "b3cebdaf-ad45-5124-8538-17b343686fe2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "89.4%" :db/id #edb/ref 17592186516484} :answer-field/id #uuid "d7a92c6e-2892-5988-ae79-425c23feccca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186516750}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7012a871-ceb2-5bf5-9d51-cddf37c78344" :question/math-academy-id "q-133054" :question/problem "The average volume of soda in cans is $12$ ounces. Additionally, in $3%$ of cans, the soda volume is less than $11.7$ ounces. Assuming the volume of soda is normally distributed, find the percentage of cans containing less than $12.2$ ounces of soda, rounded to $1$ decimal place.\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution.*\n\n| $p$ | $\\,0.01\\,$ | $\\,0.03\\,$ | $\\,0.05\\,$ | $\\,0.10\\,$ | $\\,0.15\\,$ | $\\,0.20\\,$ | $\\,0.25\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,-2.3263\\,$ | $\\,-1.8808\\,$ | $\\,-1.6449\\,$ | $\\,-1.2816\\,$ | $\\,-1.0364\\,$ | $\\,-0.8416\\,$ | $\\,-0.6745\\,$ |\n\n$$\n\n$$\n\n*In addition, you're given the following table of values for $p=Φ(z)$*.\n\n| $z$ | $\\,0.05\\,$ | $\\,0.06\\,$ | $\\,0.07\\,$ |\n| --- | --- | --- | --- |\n| $\\,1.0\\,$ | $\\,0.8531\\,$ | $\\,0.8554\\,$ | $\\,0.8577\\,$ |\n| $\\,1.1\\,$ | $\\,0.8749\\,$ | $\\,0.8770\\,$ | $\\,0.8790\\,$ |\n| $\\,1.2\\,$ | $\\,0.8944\\,$ | $\\,0.8962\\,$ | $\\,0.8980\\,$ |" :question/worked-solution "Let $X$ represent the volume of soda in a randomly selected can. Then we have $X∼N(12,{\\sigma }^{2}),$ and we want to find $P(X<12.2).$ But first, we need to find the standard deviation $\\sigma .$\n\nWe know that $P(X<11.7)=0.03.$ First, we convert $X$ to a standard normal random variable by $z$-scoring, we get\n\n$$\n\\begin{aligned}P(X<11.7) & =0.03 \\\\ P(Z\\le \\frac{11.7-12}{\\sigma }) & =0.03 \\\\ Φ(\\frac{-0.3}{\\sigma }) & =0.03 \\\\ \\frac{-0.3}{\\sigma } & ={Φ}^{-1}(0.03)\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.03)≈-1.8808.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{-0.3}{\\sigma } & =-1.8808 \\\\ \\frac{1}{\\sigma } & =6.26933 \\\\ \\sigma  & =\\frac{1}{6.26933} \\\\  & ≈0.1595.\\end{aligned}\n$$\n\n \n\nFinally, we can solve for $P(X<12.2)$ as follows:\n\n$$\n\\begin{aligned}P(X<12.2) & =P(X\\le 12.2) \\\\  & =P(Z\\le \\frac{12.2-12}{0.1595}) \\\\  & ≈P(Z\\le 1.25) \\\\  & =Φ(1.25) \\\\  & ≈89.4%\\end{aligned}\n$$\n\nTherefore, approximately $89.4%$  of soda cans contain less than $12.2$ ounces of soda."} {:db/id #edb/ref 17592186516819 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00db171e-86f4-578f-baa9-eeb4a13a294d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=0}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{12})" :db/id #edb/ref 17592186516113} {:answer/id #uuid "4c7a31b2-8edf-5725-b08a-4ca04a19f52d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=0}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{6})" :db/id #edb/ref 17592186516267} {:answer/id #uuid "8cc33023-61a9-57c1-b84d-42d2debd3175" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{12})" :db/id #edb/ref 17592186516405} {:answer/id #uuid "8eef8445-476b-5036-b260-03f7d53b7715" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{6})" :db/id #edb/ref 17592186516411}] :answer-field/correct {:answer/id #uuid "8eef8445-476b-5036-b260-03f7d53b7715" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{6})" :db/id #edb/ref 17592186516411} :answer-field/id #uuid "51585168-5999-52ac-a302-915344f4951e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186516681}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "784a3ecb-16b0-5fa6-bed2-991dfa6c8b60" :question/math-academy-id "q-344269" :question/problem "Consider the boundary value problem\n\n$$\n{y}^{″}+3y=f(x)\n$$\n\non $[-6,6]$, where $f$ is $12$-periodic and odd. Which Fourier-series form is appropriate for a particular solution ${y}_{p}?$\n\n$\\,$\n${y}_{p}(x)=$\n{{field-1}}" :question/worked-solution "Because $f$ is $12$-periodic on $[-6,6]$, we have $L=6$, so Fourier series on this interval use the basis \n\n$$\ncos\\,(\\frac{n\\pi x}{6})\\,\\text{and}\\,sin\\,(\\frac{n\\pi x}{6}).\n$$\n\nNext, since $f$ is odd, its Fourier series contains only sine terms. For a second-order equation with no ${y}^{′}$ (damping) term, the particular solution inherits this property and is also an odd function.\n\nTherefore, the appropriate form for ${y}_{p}$ is a sine series:\n\n$$\n{y}_{p}(x)={\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{6})\n$$"} {:db/id #edb/ref 17592186516844 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dac4121-cbe6-553e-bd16-6fab29fec507" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9{x}^{5}}{9-{x}^{12}}" :db/id #edb/ref 17592186516143} {:answer/id #uuid "380efcee-b3e5-51ba-b34a-0999cc8d3601" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{x}^{5}}{3-{x}^{12}}" :db/id #edb/ref 17592186516228} {:answer/id #uuid "4f793398-fc2c-5c69-a5eb-7e3e8a2143ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18{x}^{5}}{9-{x}^{12}}" :db/id #edb/ref 17592186516275} {:answer/id #uuid "d0e05fce-5995-5a9b-8200-cbf720d49a94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{5}}{9-{x}^{6}}" :db/id #edb/ref 17592186516554} {:answer/id #uuid "ffbcdb37-7a76-5a7a-b5f5-5c2b7570f9c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{5}}{3-{x}^{6}}" :db/id #edb/ref 17592186516648}] :answer-field/correct {:answer/id #uuid "0dac4121-cbe6-553e-bd16-6fab29fec507" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9{x}^{5}}{9-{x}^{12}}" :db/id #edb/ref 17592186516143} :answer-field/id #uuid "6744b580-35a3-5368-ab4c-1be0682aa649" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186516696}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bc18352d-fce3-5063-b58a-47ac19e5cf8d" :question/math-academy-id "q-95512" :question/problem "$$\n\nIf $y=\\frac{1}{2}\\operatorname{artanh}⁡(\\frac{{x}^{6}}{3}),$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic tangent function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{artanh}⁡x)=\\frac{1}{1-{x}^{2}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}\\operatorname{artanh}⁡(\\frac{{x}^{6}}{3})) \\\\  & =\\frac{1}{2}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{artanh}⁡(\\frac{{x}^{6}}{3})) \\\\  & =\\frac{1}{2}\\cdot \\frac{1}{1-{(\\frac{{x}^{6}}{3})}^{2}}\\cdot {(\\frac{{x}^{6}}{3})}^{′} \\\\  & =\\frac{1}{2}\\cdot \\frac{1}{(1-\\frac{{x}^{12}}{9})}\\cdot 2{x}^{5} \\\\  & =\\frac{9{x}^{5}}{9-{x}^{12}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186516849 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4dc213e-ad65-5a21-812e-d696846cae8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186516487}] :answer-field/correct {:answer/id #uuid "b4dc213e-ad65-5a21-812e-d696846cae8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186516487} :answer-field/id #uuid "29ade9f6-f749-5ec9-893d-33df04f83e39" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186516665}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c561c471-e505-55e6-9a2d-28f93bd6cab2" :question/math-academy-id "q-252619" :question/problem "If the equation ${log}_{1/4}⁡64=-3$ is equivalent to ${b}^{-3}=a,$  then $a=${{field-1}}." :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n${log}_{b}⁡a=x$ is equivalent to $a={b}^{x}$\n\nIf we compare ${log}_{1/4}⁡64=-3$ with ${log}_{b}⁡a=x,$ we get $a=64,$ $b=\\frac{1}{4},$ and $x=-3.$\n\nTherefore, the equation ${log}_{1/4}⁡64=-3$ is equivalent to ${(\\frac{1}{4})}^{-3}=64.$ Consequently, $a=64.$"} {:db/id #edb/ref 17592186516853 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16d48108-d2d6-587b-bfe3-2ffd1073736d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{\\sqrt{{x}^{2}+4}}" :db/id #edb/ref 17592186516156} {:answer/id #uuid "2606f266-1daa-5d7d-8ca5-771dec8b5b33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x}{\\sqrt{{x}^{2}+4}}" :db/id #edb/ref 17592186516185} {:answer/id #uuid "5cf03bd5-254e-5534-bc31-f8df36341221" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{{x}^{2}+4}}" :db/id #edb/ref 17592186516311} {:answer/id #uuid "a54621c5-4d43-5cff-83c2-5c5c66d64ab5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{\\sqrt{{x}^{2}+1}}" :db/id #edb/ref 17592186516456} {:answer/id #uuid "f6449119-7803-5c83-b8f8-f21cb84631f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{\\sqrt{{x}^{2}+2}}" :db/id #edb/ref 17592186516627}] :answer-field/correct {:answer/id #uuid "16d48108-d2d6-587b-bfe3-2ffd1073736d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{\\sqrt{{x}^{2}+4}}" :db/id #edb/ref 17592186516156} :answer-field/id #uuid "71b3a12d-2d4a-5204-9a4e-bc2880e6dedc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186516704}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ca24054b-57db-5111-abb2-9a1c0e62e7da" :question/math-academy-id "q-95428" :question/problem "$$\n\nIf $y=6\\operatorname{arsinh}⁡(\\frac{x}{2}),$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic sine function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡x)=\\frac{1}{\\sqrt{{x}^{2}+1}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(6\\operatorname{arsinh}⁡(\\frac{x}{2})) \\\\  & =6\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡(\\frac{x}{2})) \\\\  & =6\\cdot \\frac{1}{\\sqrt{{(\\frac{x}{2})}^{2}+1}}\\cdot {(\\frac{x}{2})}^{′} \\\\  & =6\\cdot \\frac{1}{\\sqrt{\\frac{{x}^{2}}{4}+1}}\\cdot \\frac{1}{2} \\\\  & =\\frac{6}{\\sqrt{{x}^{2}+4}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186516856 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2796cfc5-c5b4-5036-9f76-eece180c2cc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{x}^{5}}{5}+C" :db/id #edb/ref 17592186516194} {:answer/id #uuid "33ec99ac-f5a9-54c6-98e8-d72f51562c10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3{x}^{5}}{5}+C" :db/id #edb/ref 17592186516221} {:answer/id #uuid "4374fd25-2d74-5431-80a5-28f72721f792" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{5}+C" :db/id #edb/ref 17592186516248} {:answer/id #uuid "901f86ad-20b1-5cdb-a778-0edeead6c1fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{x}^{5}+C" :db/id #edb/ref 17592186516415} {:answer/id #uuid "b43f7a5c-b51d-5889-ab8d-1480bbb2e7bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5{x}^{4}}{3}+C" :db/id #edb/ref 17592186516486}] :answer-field/correct {:answer/id #uuid "33ec99ac-f5a9-54c6-98e8-d72f51562c10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3{x}^{5}}{5}+C" :db/id #edb/ref 17592186516221} :answer-field/id #uuid "ed5d147f-c842-54bd-aa6e-2a8c2bb0981a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186516758}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d1b18b73-e150-5d64-9819-aec4cb39257d" :question/math-academy-id "q-71161" :question/problem "Calculate $\\int (-3{x}^{4})\\,\\text{d}x.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\int (-3{x}^{4})\\,\\text{d}x & =-3\\int {x}^{4}\\,\\text{d}x \\\\  & =-3(\\frac{{x}^{4+1}}{4+1})+C \\\\  & =-3\\cdot \\frac{{x}^{5}}{5}+C \\\\  & =-\\frac{3{x}^{5}}{5}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186516864 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02150670-428b-56e2-9985-6194ff4b8ee1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "600" :db/id #edb/ref 17592186516116} {:answer/id #uuid "0c56636a-f906-5735-8c37-7b2138e8f77d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,000" :db/id #edb/ref 17592186516136} {:answer/id #uuid "4562e56f-79a7-5953-82dc-cdefccb01ccd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "800" :db/id #edb/ref 17592186516253} {:answer/id #uuid "bf315d70-83f5-5ea5-abd9-3ae3cfc47fdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "320" :db/id #edb/ref 17592186516517} {:answer/id #uuid "f7d2bf34-d828-5bcd-970b-c54ad54643d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "860" :db/id #edb/ref 17592186516628}] :answer-field/correct {:answer/id #uuid "4562e56f-79a7-5953-82dc-cdefccb01ccd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "800" :db/id #edb/ref 17592186516253} :answer-field/id #uuid "701ad097-1360-59f4-8891-d19c7b1ca762" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186516702}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f4a129bc-20d0-5e0c-8e4d-26304c226b31" :question/math-academy-id "q-118558" :question/problem "The population $y(t)$ of beavers in a river follows the logistic growth model\n\n$$\n{y}^{′}=0.2y(8-\\frac{y}{100}),\\,y(0)=200,\n$$\n\nwhere $t$ is the time, in years, since the observations began. According to this model, what is the maximum possible beaver population?" :question/worked-solution "A logistic growth equation has the form\n\n$$\n{y}^{′}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity. \n\nThe carrying capacity $a$ represents the maximum possible population. A diagram showing a typical logistic growth curve is shown below.\n\n![](images/57/57f4b604c546daed4f1cb3895191fae0ccac33b5c17aac705f203f0a837c7e69.png)\n\nFirst, let's rewrite the right-hand side of the given equation so that it matches the form above:\n\n$$\n\\begin{aligned}{y}^{′} & =0.2y(8-\\frac{y}{100}) \\\\  & =0.2y(\\frac{800-y}{100}) \\\\  & =\\frac{0.2y}{100}(800-y) \\\\  & =0.002y(800-y)\\end{aligned}\n$$\n\nFrom here, we see that $a=800.$ Hence, the carrying capacity is $800,$ and we conclude that the number of beavers cannot exceed $800.$"} {:db/id #edb/ref 17592186517140 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11b3afc9-f9cc-5c8a-b6ab-4390c55f86f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(8,- \\frac{27}{4})" :db/id #edb/ref 17592186517120} {:answer/id #uuid "97d37dda-73f6-5def-b61e-7b30f2c18eb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-8,- \\frac{27}{4})" :db/id #edb/ref 17592186517129} {:answer/id #uuid "98fc6441-004a-50b8-be13-2c8d2fa211bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-8,- \\frac{27}{8})" :db/id #edb/ref 17592186517130} {:answer/id #uuid "b05f20f9-ffc8-5085-b0e1-8fa22e17eee0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(8,- \\frac{27}{2})" :db/id #edb/ref 17592186517131} {:answer/id #uuid "e6f14205-061b-58e6-8ec2-15a66df7a546" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-8,\\frac{27}{2})" :db/id #edb/ref 17592186517138}] :answer-field/correct {:answer/id #uuid "97d37dda-73f6-5def-b61e-7b30f2c18eb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-8,- \\frac{27}{4})" :db/id #edb/ref 17592186517129} :answer-field/id #uuid "95633b9d-4569-53c0-963e-77e08465b5f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186517128}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f8cb0f82-4ced-5ad3-8499-c17a38448a7a" :question/problem "The point $(-8,7)$ lies on the curve $y=4f(x).$ Which of the following points **must** lie on $y=-f(x)-5?$" :question/worked-solution "**Method 1**\n\nWe first find a point corresponding to $(-8,7)$ on $y=f(x).$ Then, we find a corresponding point on $y=-f(x)-5:$\n\n- First, take the graph $y=4f(x).$\n\n- Then, we stretch the graph by a scale factor of $\\frac{1}{4}$ parallel to the $y$-axis and get the graph of $y=f(x).$ After this transformation, the point $(-8,7)$ will be mapped to the point\n\n$$\n(-8,\\frac{1}{4}\\cdot (7))=(-8,\\frac{7}{4}).\n$$\n\n- Next, we reflect the result across the $x$-axis and get the graph of $y=-f(x).$ After this transformation, the point $(-8,\\frac{7}{4})$ will be mapped to the point\n\n$$\n(-8,-(\\frac{7}{4}))=(-8,- \\frac{7}{4}).\n$$\n\n- Next, we shift the result vertically by $5$ units down and obtain the graph of $y=-f(x)-5.$ After this transformation, the point $(-8,- \\frac{7}{4})$ will be mapped to the point\n\n$$\n(-8,- \\frac{7}{4}-5)=(-8,- \\frac{27}{4}).\n$$\n\n**Method 2**\n\nSince the point $(-8,7)$ lies on the graph of $y=4f(x),$ we have that\n\n$$\n4f(-8)=7\\quad\\Longrightarrow\\quad f(-8)=\\frac{7}{4}.\n$$\n\nNow consider the graph of $y=-f(x)-5.$ Substituting $x=-8,$ we get\n\n$$\n\\begin{aligned}y&=-f(-8)-5\\\\&=-(\\frac{7}{4})-5\\\\&=- \\frac{27}{4}.\\end{aligned}\n$$\n\nTherefore, the point $(-8,- \\frac{27}{4})$ must lie on $y=-f(x)-5.$"} {:db/id #edb/ref 17592186517344 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26ada36c-1091-5f42-8c63-eccc8b641f55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$255$ cars per hour" :db/id #edb/ref 17592186517327} {:answer/id #uuid "b937214f-6d30-5777-98d4-63d7c6dc1a65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-105$ cars per hour" :db/id #edb/ref 17592186517358} {:answer/id #uuid "ba2e00ae-4e6a-5d71-aef7-bdb151691a73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-75$ cars per hour" :db/id #edb/ref 17592186517359} {:answer/id #uuid "cc796484-ad70-51d7-bb01-5b8342bff754" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$180$ cars per hour" :db/id #edb/ref 17592186517363} {:answer/id #uuid "d16bf7d6-ca47-5047-90d1-e323cc45a658" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$105$ cars per hour" :db/id #edb/ref 17592186517367}] :answer-field/correct {:answer/id #uuid "d16bf7d6-ca47-5047-90d1-e323cc45a658" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$105$ cars per hour" :db/id #edb/ref 17592186517367} :answer-field/id #uuid "60454d3c-fec5-59e1-9526-d25e77d4da41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186517339}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7f4724c3-2921-55f4-a281-340d20927d04" :question/problem "A factory begins work at $8\\text{:}00$ am. Its order rate is $O(t)=140t e^{-0.2t}$ cars per hour and its completion rate is $C(t)=90+15\\sin(2\\pi t/14)$ cars per hour, where $t$ is hours after work begins. What is the rate of change in the number of cars under construction at the 24-hour time $18\\text{:}30$? Orders enter construction immediately. Round your answer to the nearest integer." :question/worked-solution "The rate of change is the order rate minus the completion rate. The elapsed time is $t=(1110-480)/60=10.5$ hours.\n\n$$\n\\begin{aligned}O(10.5)-C(10.5) & =140(10.5){e}^{-0.2(10.5)}-(90+15\\sin(\\frac{2\\pi }{14}(10.5))) \\\\  & =140(10.5){e}^{-2.1}-90-15\\sin(\\frac{3 \\pi}{2}) \\\\  & =140(10.5){e}^{-2.1}-75 \\\\  & \\approx 105.\\end{aligned}\n$$\n\nTherefore, the rate of change is $105$ cars per hour."} {:db/id #edb/ref 17592186517347 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b221c18-6d59-5ed7-9a36-5ef2cdd6198b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$228$ cars per hour" :db/id #edb/ref 17592186517325} {:answer/id #uuid "1ea5bf78-0a77-58d1-9e2a-bacef9819834" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-228$ cars per hour" :db/id #edb/ref 17592186517326} {:answer/id #uuid "5baff62d-cf1c-57ec-b9d7-d7a353611316" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$288$ cars per hour" :db/id #edb/ref 17592186517336} {:answer/id #uuid "9b301213-2943-5d08-a28e-082e30a5e73f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$348$ cars per hour" :db/id #edb/ref 17592186517351} {:answer/id #uuid "b7d8817e-e114-506e-a9b2-a1055123a32f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-60$ cars per hour" :db/id #edb/ref 17592186517357}] :answer-field/correct {:answer/id #uuid "1b221c18-6d59-5ed7-9a36-5ef2cdd6198b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$228$ cars per hour" :db/id #edb/ref 17592186517325} :answer-field/id #uuid "cf15e5a0-9fea-5686-9f0a-1969e5135c52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186517364}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8e5ec36a-ecef-5d7c-8e17-1882b5fa8983" :question/problem "A factory begins work at $8\\text{:}00$ am. Its order rate is $O(t)=190t e^{-0.2t}$ cars per hour and its completion rate is $C(t)=50+10\\sin(2\\pi t/10)$ cars per hour, where $t$ is hours after work begins. What is the rate of change in the number of cars under construction at the 24-hour time $10\\text{:}30$? Orders enter construction immediately. Round your answer to the nearest integer." :question/worked-solution "The rate of change is the order rate minus the completion rate. The elapsed time is $t=(630-480)/60=2.5$ hours.\n\n$$\n\\begin{aligned}O(2.5)-C(2.5) & =190(2.5){e}^{-0.2(2.5)}-(50+10\\sin(\\frac{2\\pi }{10}(2.5))) \\\\  & =190(2.5){e}^{-0.5}-50-10\\sin(\\frac{\\pi}{2}) \\\\  & =190(2.5){e}^{-0.5}-60 \\\\  & \\approx 228.\\end{aligned}\n$$\n\nTherefore, the rate of change is $228$ cars per hour."} {:db/id #edb/ref 17592186517360 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b6c992b-a9bf-50ec-a63b-953cb1055324" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-121$ cars per hour" :db/id #edb/ref 17592186517328} {:answer/id #uuid "48c1409d-fc69-54ea-b9a0-2713986d307a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-35$ cars per hour" :db/id #edb/ref 17592186517333} {:answer/id #uuid "5bb55a74-3f47-50c3-a675-afc6dec9b4f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$121$ cars per hour" :db/id #edb/ref 17592186517337} {:answer/id #uuid "b03e3130-ebeb-56a0-a735-21aa477c71ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$156$ cars per hour" :db/id #edb/ref 17592186517354} {:answer/id #uuid "de1c0611-7856-5339-b7b2-d83aedf32026" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$191$ cars per hour" :db/id #edb/ref 17592186517371}] :answer-field/correct {:answer/id #uuid "5bb55a74-3f47-50c3-a675-afc6dec9b4f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$121$ cars per hour" :db/id #edb/ref 17592186517337} :answer-field/id #uuid "9a42ed69-259b-5d9d-b5a0-92f539029c30" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186517350}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bd6eb95d-7375-5343-986b-68f30ad5b2d2" :question/problem "A factory begins work at $8\\text{:}00$ am. Its order rate is $O(t)=90t e^{-0.2t}$ cars per hour and its completion rate is $C(t)=20+15\\sin(2\\pi t/14)$ cars per hour, where $t$ is hours after work begins. What is the rate of change in the number of cars under construction at the 24-hour time $11\\text{:}30$? Orders enter construction immediately. Round your answer to the nearest integer." :question/worked-solution "The rate of change is the order rate minus the completion rate. The elapsed time is $t=(690-480)/60=3.5$ hours.\n\n$$\n\\begin{aligned}O(3.5)-C(3.5) & =90(3.5){e}^{-0.2(3.5)}-(20+15\\sin(\\frac{2\\pi }{14}(3.5))) \\\\  & =90(3.5){e}^{-0.7}-20-15\\sin(\\frac{\\pi}{2}) \\\\  & =90(3.5){e}^{-0.7}-35 \\\\  & \\approx 121.\\end{aligned}\n$$\n\nTherefore, the rate of change is $121$ cars per hour."} {:db/id #edb/ref 17592186517369 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08f23811-b1ee-5151-b6b6-f608a52a57d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$76$ cars per hour" :db/id #edb/ref 17592186517323} {:answer/id #uuid "87ffd388-fbdd-5be1-b220-e00d63314682" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-100$ cars per hour" :db/id #edb/ref 17592186517345} {:answer/id #uuid "90fa38bd-a1a3-5389-bd58-781b51e91810" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-76$ cars per hour" :db/id #edb/ref 17592186517348} {:answer/id #uuid "cf7e8946-b8bd-5c22-9ef3-b4fcc20d9ffb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$24$ cars per hour" :db/id #edb/ref 17592186517365} {:answer/id #uuid "fa9bf1a9-9ed3-510e-8652-4bea14db43c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$124$ cars per hour" :db/id #edb/ref 17592186517379}] :answer-field/correct {:answer/id #uuid "90fa38bd-a1a3-5389-bd58-781b51e91810" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-76$ cars per hour" :db/id #edb/ref 17592186517348} :answer-field/id #uuid "d104f5d3-66ed-5d0f-978b-7632a7a40047" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186517366}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d1c8cfbb-47f4-5fb3-a9b0-9087d81918f8" :question/problem "A factory begins work at $8\\text{:}00$ am. Its order rate is $O(t)=50t e^{-0.1t}$ cars per hour and its completion rate is $C(t)=80+20\\sin(2\\pi t/2)$ cars per hour, where $t$ is hours after work begins. What is the rate of change in the number of cars under construction at the 24-hour time $8\\text{:}30$? Orders enter construction immediately. Round your answer to the nearest integer." :question/worked-solution "The rate of change is the order rate minus the completion rate. The elapsed time is $t=(510-480)/60=0.5$ hours.\n\n$$\n\\begin{aligned}O(0.5)-C(0.5) & =50(0.5){e}^{-0.1(0.5)}-(80+20\\sin(\\frac{2\\pi }{2}(0.5))) \\\\  & =50(0.5){e}^{-0.05}-80-20\\sin(\\frac{\\pi}{2}) \\\\  & =50(0.5){e}^{-0.05}-100 \\\\  & \\approx -76.\\end{aligned}\n$$\n\nTherefore, the rate of change is $-76$ cars per hour."} {:db/id #edb/ref 17592186517376 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "088dec50-c3c6-50e5-9b69-0e7ce15be0f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-60$ cars per hour" :db/id #edb/ref 17592186517322} {:answer/id #uuid "6de37857-a139-5858-9e56-fc09b996a51d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$129$ cars per hour" :db/id #edb/ref 17592186517341} {:answer/id #uuid "b20f23c0-8c87-5d2b-ba53-496addf07a38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$69$ cars per hour" :db/id #edb/ref 17592186517356} {:answer/id #uuid "e224aaed-7ace-5ee6-9efa-77876f3b74e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-69$ cars per hour" :db/id #edb/ref 17592186517373} {:answer/id #uuid "e2822869-04a9-5b0d-8a9d-94e5390e105e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$189$ cars per hour" :db/id #edb/ref 17592186517374}] :answer-field/correct {:answer/id #uuid "b20f23c0-8c87-5d2b-ba53-496addf07a38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$69$ cars per hour" :db/id #edb/ref 17592186517356} :answer-field/id #uuid "5c87e9ae-3f6c-51f1-aa5d-040dc2bf3415" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186517338}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f2e135c6-4cc0-5a93-bc48-e0df9714cad2" :question/problem "A factory begins work at $8\\text{:}00$ am. Its order rate is $O(t)=100t e^{-0.1t}$ cars per hour and its completion rate is $C(t)=40+20\\sin(2\\pi t/6)$ cars per hour, where $t$ is hours after work begins. What is the rate of change in the number of cars under construction at the 24-hour time $9\\text{:}30$? Orders enter construction immediately. Round your answer to the nearest integer." :question/worked-solution "The rate of change is the order rate minus the completion rate. The elapsed time is $t=(570-480)/60=1.5$ hours.\n\n$$\n\\begin{aligned}O(1.5)-C(1.5) & =100(1.5){e}^{-0.1(1.5)}-(40+20\\sin(\\frac{2\\pi }{6}(1.5))) \\\\  & =100(1.5){e}^{-0.15}-40-20\\sin(\\frac{\\pi}{2}) \\\\  & =100(1.5){e}^{-0.15}-60 \\\\  & \\approx 69.\\end{aligned}\n$$\n\nTherefore, the rate of change is $69$ cars per hour."} {:db/id #edb/ref 17592186517462 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e70ed93-a43b-58be-acd0-b799d63f0714" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{16}{5}" :db/id #edb/ref 17592186517440} {:answer/id #uuid "2730308e-a102-5e79-9890-158fe5357d99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{16}" :db/id #edb/ref 17592186517445} {:answer/id #uuid "7bc5a94e-64d2-5920-9e6e-801ecc022047" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186517452} {:answer/id #uuid "7e9c8aac-4ed9-5a1d-a493-07685c55908e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186517454} {:answer/id #uuid "bec4e340-c617-539e-9b6c-ae63e9be0b5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{16}" :db/id #edb/ref 17592186517463}] :answer-field/correct {:answer/id #uuid "bec4e340-c617-539e-9b6c-ae63e9be0b5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{16}" :db/id #edb/ref 17592186517463} :answer-field/id #uuid "c876fc73-3f9f-5f8e-8196-67a81ce85909" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186517465}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bb34b724-2aa2-5cfd-b397-58da6b93e908" :question/problem "What is the product of solutions of the equation $17{x}^{2}\\cdot {9}^{x+5}+x\\cdot {9}^{x+5}-5\\cdot {9}^{x+5}={x}^{2}\\cdot {9}^{x+5}+17x\\cdot {9}^{x+5}?$" :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}17{x}^{2}\\cdot {9}^{x+5}+x\\cdot {9}^{x+5}-5\\cdot {9}^{x+5} & ={x}^{2}\\cdot {9}^{x+5}+17x\\cdot {9}^{x+5} \\\\ 17{x}^{2}\\cdot {9}^{x+5}+x\\cdot {9}^{x+5}-5\\cdot {9}^{x+5}-{x}^{2}\\cdot {9}^{x+5}-17x\\cdot {9}^{x+5} & =0 \\\\ 16{x}^{2}\\cdot {9}^{x+5}-16x\\cdot {9}^{x+5}-5\\cdot {9}^{x+5} & =0 \\\\ (16{x}^{2}-16x-5)\\cdot {9}^{x+5} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n16{x}^{2}-16x-5=0\\,\\text{and}\\,{9}^{x+5}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation $16{x}^{2}-16x-5=0$ can be factored as\n\n$$\n(4x+1)(4x-5)=0,\n$$\n\nwhich leads to the solutions $x=-\\frac{1}{4},\\frac{5}{4}.$\n\n- The equation ${9}^{x+5}=0$ has no solutions because ${9}^{x+5}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-\\frac{1}{4},\\frac{5}{4},$ and their product is $(-\\frac{1}{4})\\cdot \\frac{5}{4}=-\\frac{5}{16}.$"} {:db/id #edb/ref 17592186517472 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b65a1c5-546b-5668-a246-b5cf2bd6e270" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{20}{9}" :db/id #edb/ref 17592186517446} {:answer/id #uuid "81b4b536-fbdb-53dd-8e6a-9d4a3925eefd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{20}{9}" :db/id #edb/ref 17592186517456} {:answer/id #uuid "a12e4883-f707-540d-b4c7-2fb734b36759" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186517458} {:answer/id #uuid "ad14f9ed-6cbb-5e67-a4e0-3d156b81cca7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{20}" :db/id #edb/ref 17592186517459} {:answer/id #uuid "e93d6931-7713-5b15-908e-6692f578076c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186517471}] :answer-field/correct {:answer/id #uuid "2b65a1c5-546b-5668-a246-b5cf2bd6e270" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{20}{9}" :db/id #edb/ref 17592186517446} :answer-field/id #uuid "fa637b75-77f9-5f93-b563-a26ea0acef86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186517473}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f48c65d0-2285-5cf5-998e-b08d76dc5881" :question/problem "What is the product of solutions of the equation $13{x}^{2}\\cdot {2}^{-x-4}+2x\\cdot {2}^{-x-4}-20\\cdot {2}^{-x-4}=4{x}^{2}\\cdot {2}^{-x-4}+5x\\cdot {2}^{-x-4}?$" :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}13{x}^{2}\\cdot {2}^{-x-4}+2x\\cdot {2}^{-x-4}-20\\cdot {2}^{-x-4} & =4{x}^{2}\\cdot {2}^{-x-4}+5x\\cdot {2}^{-x-4} \\\\ 13{x}^{2}\\cdot {2}^{-x-4}+2x\\cdot {2}^{-x-4}-20\\cdot {2}^{-x-4}-4{x}^{2}\\cdot {2}^{-x-4}-5x\\cdot {2}^{-x-4} & =0 \\\\ 9{x}^{2}\\cdot {2}^{-x-4}-3x\\cdot {2}^{-x-4}-20\\cdot {2}^{-x-4} & =0 \\\\ (9{x}^{2}-3x-20)\\cdot {2}^{-x-4} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n9{x}^{2}-3x-20=0\\,\\text{and}\\,{2}^{-x-4}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation $9{x}^{2}-3x-20=0$ can be factored as\n\n$$\n(3x-5)(3x+4)=0,\n$$\n\nwhich leads to the solutions $x=-\\frac{4}{3},\\frac{5}{3}.$\n\n- The equation ${2}^{-x-4}=0$ has no solutions because ${2}^{-x-4}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-\\frac{4}{3},\\frac{5}{3},$ and their product is $(-\\frac{4}{3})\\cdot \\frac{5}{3}=-\\frac{20}{9}.$"} {:db/id #edb/ref 17592186518113 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1e2c107-9d5e-504f-af80-17ffca1d2a08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186517858}] :answer-field/correct {:answer/id #uuid "c1e2c107-9d5e-504f-af80-17ffca1d2a08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186517858} :answer-field/id #uuid "d7f79e97-d630-5908-a05a-ee3b6a7eb854" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186518075}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1c37fb77-7c99-58f3-b32e-45223dbee74b" :question/math-academy-id "q-217248" :question/problem "Suppose that $y$ varies inversely with $x$ and that $y=\\frac{3}{4}$ when $x=12.$ Then, if $x=\\frac{1}{3},$ $y=${{field-1}}." :question/worked-solution "Since $y$ varies inversely with $x,$ we use the equation\n\n$$\ny=\\frac{k}{x}.\n$$\n\nWe are told that $y=\\frac{3}{4}$ when $x=12.$ We substitute this data into the equation to find $k:$\n\n$$\n\\begin{aligned}\\frac{3}{4} & =\\frac{k}{12} \\\\ \\frac{3}{4}\\cdot 12 & =k \\\\ 9 & =k\\end{aligned}\n$$\n\nSo, the inverse variation is given by \n\n$$\ny=\\frac{9}{x}.\n$$\n\nFinally, substituting the value of $x=\\frac{1}{3}$ into this equation gives\n\n$$\n\\begin{aligned}y & =\\frac{9}{(\\frac{1}{3})} \\\\  & =9÷(\\frac{1}{3}) \\\\  & =9\\cdot (\\frac{3}{1}) \\\\  & =27.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186518123 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1fab290-16e7-5979-bd17-fff2703816f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi-6" :db/id #edb/ref 17592186517822}] :answer-field/correct {:answer/id #uuid "b1fab290-16e7-5979-bd17-fff2703816f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi-6" :db/id #edb/ref 17592186517822} :answer-field/id #uuid "b7e79ac7-4b47-5738-a30f-3fb1606b45fc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186518056}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "35ae1f33-1dce-5ef7-af9a-1cf242b3dd81" :question/math-academy-id "q-131248" :question/problem "$f(6)\\,=\\,${{field-1}}" :question/worked-solution "From the fundamental theorem of calculus, we find that\n\n$$\n\\begin{aligned}{\\int }_{-3}^{6}{f}^{′}(x)\\,\\text{d}x & =f(6)-f(-3) \\\\ {\\int }_{-3}^{6}{f}^{′}(x)\\,\\text{d}x & =f(6)-(-\\frac{5\\pi }{2}) \\\\ f(6) & =-\\frac{5\\pi }{2}+{\\int }_{-3}^{6}{f}^{′}(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nNotice that the graph of $y={f}^{′}(x)$ on $[-3,6]$ consists of two parts: \n\n* an arc of a quarter circle for $x\\in [-3,3],$ which lies above the $x$-axis, and \n\n* a line segment for $x\\in [3,6],$ which lies below the $x$-axis. \n\nTherefore, we can write the integral as follows:\n\n$$\n{\\int }_{-3}^{6}{f}^{′}(x)\\,\\text{d}x=\\underbrace{{\\int }_{-3}^{3}{f}^{′}(x)\\,\\text{d}x}_{{A}_{1}}+\\underbrace{{\\int }_{3}^{6}{f}^{′}(x)\\,\\text{d}x}_{-{A}_{2}}.\n$$\n\nThe first integral represents the signed area between the curve and the $x$-axis, where $x\\in [-3,3].$ Earlier, we found that\n\n$$\n{A}_{1}=\\frac{9\\pi }{2}.\n$$\n\nThe second integral represents the signed area between the curve and the $x$-axis, where $x\\in [3,6].$ The corresponding region is a triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}ab \\\\  & =\\frac{1}{2}\\cdot 3\\cdot 4 \\\\  & =6.\\end{aligned}\n$$\n\nHowever, since the region lies below the $x$-axis, we have\n\n$$\n{\\int }_{3}^{6}{f}^{′}(x)\\,\\text{d}x=-{A}_{2}=-6.\n$$\n\nTherefore, the value of the original integral is\n\n$$\n\\begin{aligned}{\\int }_{-3}^{6}{f}^{′}(x)\\,\\text{d}x & ={A}_{1}-{A}_{2} \\\\  & =\\frac{9\\pi }{2}-6.\\end{aligned}\n$$\n\nFinally, we can find $f(6):$\n\n$$\n\\begin{aligned}f(6) & =-\\frac{5\\pi }{2}+{\\int }_{-3}^{6}{f}^{′}(x)\\,\\text{d}x \\\\  & =-\\frac{5\\pi }{2}+(\\frac{9\\pi }{2}-6) \\\\  & =2\\pi -6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186518134 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "830e9698-d539-5352-8d7d-febdec432ecb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi" :db/id #edb/ref 17592186517737}] :answer-field/correct {:answer/id #uuid "830e9698-d539-5352-8d7d-febdec432ecb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi" :db/id #edb/ref 17592186517737} :answer-field/id #uuid "27491965-a7e7-5720-b84e-bc2ff10d5755" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186517989}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4f9b4143-02aa-5852-84a2-99409167bad1" :question/math-academy-id "q-131247" :question/problem "Find the value of $f(3).$\n\n$f(3)\\,=\\,$ {{field-1}}" :question/worked-solution "From the fundamental theorem of calculus, we find that\n\n$$\n\\begin{aligned}{\\int }_{-3}^{3}{f}^{′}(x)\\,\\text{d}x & =f(3)-f(-3) \\\\ {\\int }_{-3}^{3}{f}^{′}(x)\\,\\text{d}x & =f(3)-(-\\frac{5\\pi }{2}) \\\\ f(3) & =-\\frac{5\\pi }{2}+{\\int }_{-3}^{3}{f}^{′}(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nThe definite integral of $y={f}^{′}(x)$ over $[-3,3]$ is the signed area between the curve and the $x$-axis. The corresponding region is a semicircle, so we find the area using the formula \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\pi {r}^{2} \\\\  & =\\frac{1}{2}\\pi \\cdot {3}^{2} \\\\  & =\\frac{9\\pi }{2}.\\end{aligned}\n$$\n\nTherefore, ${\\int }_{-3}^{3}{f}^{′}(x)\\,\\text{d}x=A=\\frac{9\\pi }{2}.$ \n\nFinally, we obtain\n\n$$\n\\begin{aligned}f(3) & =-\\frac{5\\pi }{2}+{\\int }_{-3}^{3}{f}^{′}(x)\\,\\text{d}x \\\\  & =-\\frac{5\\pi }{2}+\\frac{9\\pi }{2} \\\\  & =2\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186518141 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ca5ecce-5260-5c1e-8f33-b8f542d178e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186517517} {:answer/id #uuid "3072f94c-01b5-54a9-b170-a51dc79492ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186517581} {:answer/id #uuid "5eaedd3e-5549-5a47-bec3-16e990341664" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186517661} {:answer/id #uuid "b151edaa-d755-5566-a03a-6ad23995bfa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186517821} {:answer/id #uuid "d55eae46-1605-5397-8e51-d16aa7ce1714" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186517892}] :answer-field/correct {:answer/id #uuid "0ca5ecce-5260-5c1e-8f33-b8f542d178e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186517517} :answer-field/id #uuid "5bd3a5dd-dd4c-547c-b5d1-8d0a45894fb2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186518016}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5810c34a-c4d1-5c91-ad48-b47e68d3d961" :question/math-academy-id "q-163495" :question/problem "![](images/85/8524ffd2ff653703bd6fcfa2b44d36821aeb34877d58bbc6df388497cac8e07d.png)\n\nA plate occupies the region $D$ enclosed by the $x$-axis and the lines $y=2x$ and $y=4-2x$, as shown above. The mass density function of the plate is $\\lambda (x,y)=\\frac{x}{2}.$ Find the moment of inertia of the plate about the line $y=2.$" :question/worked-solution "The moment of inertia of a plane lamina in the shape of a region $D$ about an axis of rotation $l$ is given by\n\n$$\n{I}_{l}={∬}_{D}\\lambda (x,y)[r(x,y)]^{2}\\,\\text{d}A,\n$$\n\nwhere $\\lambda (x,y)$ is the mass density function of the lamina, and $r(x,y)$ is the distance from the line $l$ to the point $(x,y)$ on $D.$\n\nFirst, notice that $D$ is a type II region with representation\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 2,\\,\\,\\frac{y}{2}\\le x\\le 2-\\frac{y}{2}\\},\n$$\n\nas shown below.\n\n![](images/29/293f8454cdda5897de111d6444baa4674eccf28a36e2053f3f2cb71f948e07fe.png)\n\n  \n\nThe distance between a point on $D$ and the line $y=2$ is given by\n\n$$\nr(x,y)=|y-2|.\n$$\n\nTherefore, the moment of inertia about the line $y=2$ is\n\n$$\n\\begin{aligned}I & ={∬}_{D}\\lambda (x,y)[r(x,y)]^{2}\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{y/2}^{2-y/2}\\frac{x}{2}|y-2{|}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}{\\int }_{y/2}^{2-y/2}x(y-2)^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}({y}^{2}-4y+4)[{\\int }_{y/2}^{2-y/2}x\\,\\text{d}x]\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}({y}^{2}-4y+4){[\\frac{{x}^{2}}{2}]}_{x=y/2}^{x=2-y/2}\\,\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}({y}^{2}-4y+4)\\cdot \\frac{1}{2}[{(2-\\frac{y}{2})}^{2}-{(\\frac{y}{2})}^{2}]\\text{d}y \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}({y}^{2}-4y+4)(4-2y)\\,\\text{d}y \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}-2{y}^{3}+12{y}^{2}-24y+16\\,\\text{d}y \\\\  & =\\frac{1}{4}{[-\\frac{{y}^{4}}{2}+4{y}^{3}-12{y}^{2}+16y]}_{0}^{2} \\\\  & =\\frac{1}{4}(-8+32-48+32) \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186518150 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a61f89c-26da-50ae-8ae5-3418c4b833b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186517537} {:answer/id #uuid "721d61dd-96f8-5406-a3f6-fcb23bf6f475" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186517707} {:answer/id #uuid "9aec64e1-f74d-5064-8109-55570118f286" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186517784} {:answer/id #uuid "a20c2896-a265-53fe-b858-9d8a4b872073" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186517793} {:answer/id #uuid "eeb701d8-fd21-54d5-abf7-f1c31f1d67ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "-$\\frac{1}{3}$" :db/id #edb/ref 17592186517943}] :answer-field/correct {:answer/id #uuid "1a61f89c-26da-50ae-8ae5-3418c4b833b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186517537} :answer-field/id #uuid "495b0eea-23f2-5d2e-91e8-fcc19023131f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186518007}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "64f9b7ab-1e87-57f9-b089-cc6f9c501397" :question/math-academy-id "q-2974" :question/problem "${log}_{3}⁡(\\frac{1}{27})=$" :question/worked-solution "First, we rewrite $\\frac{1}{27}$ as a power of $3$ (the base of the logarithm) as follows:\n\n$$\n\\frac{1}{27}=\\frac{1}{{3}^{3}}={3}^{-3}\n$$\n\nTherefore, we have:\n\n$$\n{log}_{3}⁡(\\frac{1}{27})={log}_{3}⁡({3}^{-3})\n$$\n\nThe logarithm reverses the action of the exponent. The principle is:\n\n$$\n{log}_{b}⁡({b}^{x})=x\n$$\n\nIn our case, we have $b=3$ and $x=-3.$ Therefore:\n\n$$\n{log}_{3}⁡({3}^{-3})=-3\n$$"} {:db/id #edb/ref 17592186518154 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04b9b4a1-9068-553a-ae2e-30dbf20be4fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186517499} {:answer/id #uuid "814f1f82-22dc-5c8d-891c-3328494b799e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186517733} {:answer/id #uuid "81bd13e4-d7a2-5838-845b-af517aaee57d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186517734} {:answer/id #uuid "81e5843d-2f47-5715-a318-45d7445db611" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186517735} {:answer/id #uuid "e4b24d2b-5e6b-5a01-8823-5b502061c87a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186517921}] :answer-field/correct {:answer/id #uuid "814f1f82-22dc-5c8d-891c-3328494b799e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186517733} :answer-field/id #uuid "2084aa97-e12f-5fe8-a10d-790d4754b710" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186517982}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6c887066-3c08-5cb4-b40e-433eb14c4b31" :question/math-academy-id "q-26042" :question/problem "${log}_{3}⁡(\\frac{1}{81})=$" :question/worked-solution "First, we rewrite $\\frac{1}{81}$ as a power of $3$ (the base of the logarithm) as follows:\n\n$$\n\\frac{1}{81}=\\frac{1}{{3}^{4}}={3}^{-4}\n$$\n\nTherefore, we have:\n\n$$\n{log}_{3}⁡(\\frac{1}{81})={log}_{3}⁡({3}^{-4})\n$$\n\nThe logarithm reverses the action of the exponent. The principle is:\n\n$$\n{log}_{b}⁡({b}^{x})=x\n$$\n\nIn our case, we have $b=3$ and $x=-4.$ Therefore:\n\n$$\n{log}_{3}⁡({3}^{-4})=-4\n$$"} {:db/id #edb/ref 17592186518183 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40e4fb97-951d-5b68-859b-21f442ae9424" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186517614}] :answer-field/correct {:answer/id #uuid "40e4fb97-951d-5b68-859b-21f442ae9424" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186517614} :answer-field/id #uuid "ee82855a-a9a9-5945-b471-65f010904c24" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186518086}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a98d2b92-1f79-5299-a15c-071e314b9a2c" :question/math-academy-id "q-171153" :question/problem "$0÷(\\frac{2}{3})=${{field-1}}" :question/worked-solution "Zero divided by any number (other than zero) equals zero. Therefore, $0÷(\\frac{2}{3})=0.$"} {:db/id #edb/ref 17592186518200 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08ff8e18-e1e0-569c-b239-ea2d323c2f96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186517506} {:answer/id #uuid "2c3f1cdb-62a7-5446-bfc0-9c5b8ecff4dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186517570} {:answer/id #uuid "37c06ed4-4dac-5a25-bb1d-90e1da0780f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186517598} {:answer/id #uuid "3d5ad2d6-7a2b-58fa-9b9e-b5cfbe4b0f29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186517610} {:answer/id #uuid "72cc3a7f-05b3-50d0-8c4f-4aedc32143ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186517708}] :answer-field/correct {:answer/id #uuid "72cc3a7f-05b3-50d0-8c4f-4aedc32143ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186517708} :answer-field/id #uuid "d155659c-c17e-5eca-b3d0-23cecfde70bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186518069}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cf708341-904e-56d2-b929-e74c203d19a7" :question/math-academy-id "q-115589" :question/problem "![](images/96/9674072fe2d9f831635dfd2994b97ea6e9603dd576586f80e4b1b2e6a2373564.png)\n\nThe graph above shows the relationship between $x$ and $y.$ Given that $y$ is inversely proportional to $x,$ find the value of $a.$" :question/worked-solution "Since $y$ varies inversely with $x,$ we use the equation\n\n$$\ny=\\frac{k}{x}.\n$$\n\nIn the graph, we notice a point with $y=\\frac{1}{2}$ and $x=5.$ We substitute this data into the equation to find $k:$\n\n$$\n\\begin{aligned}\\frac{1}{2} & =\\frac{k}{5} \\\\ \\frac{1}{2}\\cdot 5 & =k \\\\ \\frac{5}{2} & =k\\end{aligned}\n$$\n\nTherefore, the inverse variation equation that relates $y$ and $x$ is\n\n$$\ny=\\frac{(\\frac{5}{2})}{x}=\\frac{5}{2x}.\n$$\n\nFrom the graph, we also have that $y=\\frac{5}{2}$ when $x=a.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{5}{2} & =\\frac{5}{2a} \\\\ 10a & =10 \\\\ a & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186518221 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2eacb6ae-6056-590f-819d-a963272134e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186517579} {:answer/id #uuid "35a9c1f4-2e16-576e-924a-d4b678c80437" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186517594} {:answer/id #uuid "772eaf55-132c-5352-905f-c57fafed7229" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12M}{7}" :db/id #edb/ref 17592186517713} {:answer/id #uuid "91698260-fd1f-560e-af4f-3325f33e5dab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8M}{7}" :db/id #edb/ref 17592186517761} {:answer/id #uuid "c8bb2c02-211c-5a2e-a640-026cbe50166a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10M}{7}" :db/id #edb/ref 17592186517869}] :answer-field/correct {:answer/id #uuid "c8bb2c02-211c-5a2e-a640-026cbe50166a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10M}{7}" :db/id #edb/ref 17592186517869} :answer-field/id #uuid "35069258-2167-5032-8d01-4365ee34fd5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186517996}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f58ffe9b-0496-58b1-afb0-490bd07410f5" :question/math-academy-id "q-163644" :question/problem "![](images/16/1664a86a1fee25cccbb710ad4335e4d69b36c24d64c95ae7bff9e54d2ac3a6b6.png)\n\nA plate with mass $M$ and uniform mass density occupies the region $D$ enclosed between the curves $x=\\sqrt{2y}$ and $x=\\frac{{y}^{2}}{2}$, as shown above. Given that the region has an area of $\\frac{4}{3},$ find the moment of inertia of the plate about the line $y=2.$" :question/worked-solution "The moment of inertia of a plane lamina in the shape of a region $D$ about an axis of rotation $l$ is given by\n\n$$\n{I}_{l}={∬}_{D}\\lambda (x,y)[r(x,y)]^{2}\\,\\text{d}A,\n$$\n\nwhere $\\lambda (x,y)$ is the mass density function of the lamina, and $r(x,y)$ is the distance from the line $l$ to the point $(x,y)$ on $D.$\n\nFirst, notice that $D$ is a type II region with representation\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 2,\\,\\,\\frac{{y}^{2}}{2}\\le x\\le \\sqrt{2y}\\},\n$$\n\nas shown below.\n\n![](images/d9/d9c529fe2d238a3d6ac4e20cfcd571f980c28a4eb2c13497fab3ccb0d15ac6eb.png)\n\nThe distance between a point on $D$ and the line $y=2$ is given by\n\n$$\nr(x,y)=|y-2|.\n$$\n\nSince the plate has uniform density, the mass density function is given by\n\n$$\n\\lambda (x,y)=\\frac{M}{A}=\\frac{3M}{4}.\n$$\n\nTherefore, the moment of inertia about the line $y=2$ is\n\n$$\n\\begin{aligned}I & ={∬}_{D}\\lambda (x,y)[r(x,y)]^{2}\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{{y}^{2}/2}^{\\sqrt{2y}}\\frac{3M}{4}|y-2{|}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{3M}{4}{\\int }_{0}^{2}{\\int }_{{y}^{2}/2}^{\\sqrt{2y}}(y-2)^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{3M}{4}{\\int }_{0}^{2}(y-2)^{2}[x]_{x={y}^{2}/2}^{x=\\sqrt{2y}}\\,\\text{d}y \\\\  & =\\frac{3M}{4}{\\int }_{0}^{2}(y-2)^{2}(\\sqrt{2y}-\\frac{{y}^{2}}{2})\\,\\text{d}y \\\\  & =\\frac{3M}{4}{\\int }_{0}^{2}(\\sqrt{2}{y}^{5/2}-\\frac{{y}^{4}}{2}-4\\sqrt{2}{y}^{3/2}+2{y}^{3}+4\\sqrt{2}{y}^{1/2}-2{y}^{2})\\text{d}y \\\\  & =\\frac{3M}{4}{[\\frac{2\\sqrt{2}{y}^{7/2}}{7}-\\frac{{y}^{5}}{10}-\\frac{8\\sqrt{2}{y}^{5/2}}{5}+\\frac{{y}^{4}}{2}+\\frac{8\\sqrt{2}{y}^{3/2}}{3}-\\frac{2{y}^{3}}{3}]}_{0}^{2} \\\\  & =\\frac{3M}{4}(\\frac{32}{7}-\\frac{32}{10}-\\frac{64}{5}+8+\\frac{32}{3}-\\frac{16}{3}) \\\\  & =\\frac{3M}{4}(\\frac{40}{21}) \\\\  & =\\frac{10M}{7}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186518763 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cd0dcd1-823c-5bfe-a3b4-87f697bc1cc5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/88/88d6157b6d961bfcfe66f9d0635c7c75e754fa33d182971f3e8722821995a7bf.png" :db/id #edb/ref 17592186518772} {:answer/id #uuid "3522f0ef-1ff6-5054-b459-1bc1a99959f3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e2/e23ab97241e392652578b744558f27abf17a6f10887b4532bfd9198a0168d6de.png" :db/id #edb/ref 17592186518778} {:answer/id #uuid "6a0ad3fe-aab5-5c80-a718-10250bc0a44b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0f/0f22b1314960b7ddc22461df115e3cc8b883f463e39e0717f494486c9145c461.png" :db/id #edb/ref 17592186518791} {:answer/id #uuid "7500cd0d-e37b-5f4b-928d-4f02799db350" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8b/8bdff7dd1b78b495112bb64fcf8c7f88eaa5434924c248654afb645f9146db17.png" :db/id #edb/ref 17592186518794} {:answer/id #uuid "935a7585-1072-568f-8a0c-50849d049cac" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/00/00fae4ff8c65eb9be03ec51e68ddf89e03122c366feefa1cc2f370d2fea8b789.png" :db/id #edb/ref 17592186518808}] :answer-field/correct {:answer/id #uuid "7500cd0d-e37b-5f4b-928d-4f02799db350" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8b/8bdff7dd1b78b495112bb64fcf8c7f88eaa5434924c248654afb645f9146db17.png" :db/id #edb/ref 17592186518794} :answer-field/id #uuid "07507bc4-4f53-51a3-a550-08f3dc917fb9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186518765}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "014ab122-2134-517b-b9a9-d71b60e66dee" :question/problem "Which of the following diagrams represents the vector field $F(x,y)=-2 x y\\,i-x^{2}\\,j$ at the indicated points?" :question/worked-solution "We have to sketch the vector field at the points $(-1,\\frac{3}{2}),(-2,- \\frac{3}{2}),$ and $(-2,\\frac{1}{2}).$\n\nTo sketch the vector field at the given points, we substitute their coordinates into the function $F(x,y)=-2 x y\\,i-x^{2}\\,j\\,:$\n\n$$\n\\begin{aligned}F(-1,\\frac{3}{2}) & =\\left((-2)(-1)(\\frac{3}{2})\\right)\\,i+\\left((-1)(-1)^{2}\\right)\\,j=3\\,i-j \\\\ F(-2,- \\frac{3}{2}) & =\\left((-2)(-2)(- \\frac{3}{2})\\right)\\,i+\\left((-1)(-2)^{2}\\right)\\,j=-6\\,i-4\\,j \\\\ F(-2,\\frac{1}{2}) & =\\left((-2)(-2)(\\frac{1}{2})\\right)\\,i+\\left((-1)(-2)^{2}\\right)\\,j=2\\,i-4\\,j\\end{aligned}\n$$\n\nWe now draw our vectors. At each point, we draw the vector associated with that point, placing the tail end of the vector on the point itself. This gives the following diagram.\n\n![](images/8b/8bdff7dd1b78b495112bb64fcf8c7f88eaa5434924c248654afb645f9146db17.png)"} {:db/id #edb/ref 17592186518771 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a304352-c54f-51ef-8906-32ee9cdc8b79" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6c/6c75e8fe5ad41fd863eca4152c172bbba3084eba38b6e54c96f9e084669279ca.png" :db/id #edb/ref 17592186518783} {:answer/id #uuid "67f43eb9-dbc2-5820-b523-2f926f10b9fa" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e8/e829b1ebe911b3c3ae1a6e871d10a36931fef7f950933abda5ea226fd4c9ae66.png" :db/id #edb/ref 17592186518790} {:answer/id #uuid "6f17cf54-8843-57c9-a3d9-0c5e55c95936" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/09/09fee256ed52affac40d46982cdb3b2e3957677e81ec0aa3266d9885be9e1add.png" :db/id #edb/ref 17592186518792} {:answer/id #uuid "773a8b98-66de-5e5e-b398-a5e44ac67b13" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5d/5decd9cc7f7088571cf3eecf9f50c7ec87e2f6182df1fbc4b55caaf8bc3e73d4.png" :db/id #edb/ref 17592186518795} {:answer/id #uuid "d2fa96a1-5147-5de1-b5da-a48e24f11b60" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/26/267f2a39c365664697da7256d49767c2018b3f63d94a6f55e90b566cc554a27e.png" :db/id #edb/ref 17592186518822}] :answer-field/correct {:answer/id #uuid "67f43eb9-dbc2-5820-b523-2f926f10b9fa" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e8/e829b1ebe911b3c3ae1a6e871d10a36931fef7f950933abda5ea226fd4c9ae66.png" :db/id #edb/ref 17592186518790} :answer-field/id #uuid "d55fcac1-f13e-5aca-8efd-d6b03f32a8f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186518823}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1b8d00f8-3412-52c9-9322-b2ebe7eaa245" :question/problem "Which of the following diagrams represents the vector field $F(x,y)=2 x y\\,i-2 x^{2}\\,j$ at the indicated points?" :question/worked-solution "We have to sketch the vector field at the points $(2,\\frac{1}{2}),(-2,- \\frac{3}{2}),$ and $(2,- \\frac{3}{2}).$\n\nTo sketch the vector field at the given points, we substitute their coordinates into the function $F(x,y)=2 x y\\,i-2 x^{2}\\,j\\,:$\n\n$$\n\\begin{aligned}F(2,\\frac{1}{2}) & =\\left((2)(2)(\\frac{1}{2})\\right)\\,i+\\left((-2)(2)^{2}\\right)\\,j=2\\,i-8\\,j \\\\ F(-2,- \\frac{3}{2}) & =\\left((2)(-2)(- \\frac{3}{2})\\right)\\,i+\\left((-2)(-2)^{2}\\right)\\,j=6\\,i-8\\,j \\\\ F(2,- \\frac{3}{2}) & =\\left((2)(2)(- \\frac{3}{2})\\right)\\,i+\\left((-2)(2)^{2}\\right)\\,j=-6\\,i-8\\,j\\end{aligned}\n$$\n\nWe now draw our vectors. At each point, we draw the vector associated with that point, placing the tail end of the vector on the point itself. This gives the following diagram.\n\n![](images/e8/e829b1ebe911b3c3ae1a6e871d10a36931fef7f950933abda5ea226fd4c9ae66.png)"} {:db/id #edb/ref 17592186518775 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0deeee54-5137-5ac3-b9b4-0f091bb47502" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/07/07235837dbd839f3603359295ecae29383f96956b0d5724fab8fcfb053dbfd46.png" :db/id #edb/ref 17592186518768} {:answer/id #uuid "8e1efae7-38d6-5363-b86d-fd79f952e5d3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8e/8e3a8f6c8b863dd68bc426baf82151476a347d231f87a763199288b93cdf585c.png" :db/id #edb/ref 17592186518801} {:answer/id #uuid "923fd78a-1c49-58e4-81a3-5a3d262a0a0d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/61/61fff51ff54e097ae5a320948e16d1f93f1bbc1c5a170206b016dbcca1cb4fa5.png" :db/id #edb/ref 17592186518807} {:answer/id #uuid "b66cc1d0-bd1d-535d-be46-13f0c13305cc" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8f/8f967f2dccd9a990c7781f25d8d362a1ac26ad1af9bd0f0600a81f0d868fe377.png" :db/id #edb/ref 17592186518819} {:answer/id #uuid "dce8d86e-80d6-5bd9-ba07-826f7939c84b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7e/7ec5f0301acbff4f08a5390a9c62504ac91ad78fbf02e55db293e1cd5d05af36.png" :db/id #edb/ref 17592186518825}] :answer-field/correct {:answer/id #uuid "8e1efae7-38d6-5363-b86d-fd79f952e5d3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8e/8e3a8f6c8b863dd68bc426baf82151476a347d231f87a763199288b93cdf585c.png" :db/id #edb/ref 17592186518801} :answer-field/id #uuid "7f41bc97-1a45-5ac6-b387-80f11d2c9da4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186518797}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "25249ebb-67f9-5eb6-a85d-bb04853f2c73" :question/problem "Which of the following diagrams represents the vector field $F(x,y)=-x y\\,i-2 x^{2}\\,j$ at the indicated points?" :question/worked-solution "We have to sketch the vector field at the points $(-2,- \\frac{5}{4}),(1,- \\frac{3}{4}),$ and $(1,\\frac{1}{4}).$\n\nTo sketch the vector field at the given points, we substitute their coordinates into the function $F(x,y)=-x y\\,i-2 x^{2}\\,j\\,:$\n\n$$\n\\begin{aligned}F(-2,- \\frac{5}{4}) & =\\left((-1)(-2)(- \\frac{5}{4})\\right)\\,i+\\left((-2)(-2)^{2}\\right)\\,j=-\\frac{5}{2}\\,i-8\\,j \\\\ F(1,- \\frac{3}{4}) & =\\left((-1)(1)(- \\frac{3}{4})\\right)\\,i+\\left((-2)(1)^{2}\\right)\\,j=\\frac{3}{4}\\,i-2\\,j \\\\ F(1,\\frac{1}{4}) & =\\left((-1)(1)(\\frac{1}{4})\\right)\\,i+\\left((-2)(1)^{2}\\right)\\,j=-\\frac{1}{4}\\,i-2\\,j\\end{aligned}\n$$\n\nWe now draw our vectors. At each point, we draw the vector associated with that point, placing the tail end of the vector on the point itself. This gives the following diagram.\n\n![](images/8e/8e3a8f6c8b863dd68bc426baf82151476a347d231f87a763199288b93cdf585c.png)"} {:db/id #edb/ref 17592186518781 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20376de9-73cc-5220-b1b5-d05e47b251ad" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/34/34fe0d8361633cbf6a7242584878f75edce90dbf4a353e74c4f3ecb5ff3540b3.png" :db/id #edb/ref 17592186518773} {:answer/id #uuid "2325b410-0c6c-5f57-bcd5-530841a89169" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0d/0d2feddba8eb9c880f7a0dfd88b2b1f936f8bfa1de33f205c408fd776a33a579.png" :db/id #edb/ref 17592186518774} {:answer/id #uuid "530c6a59-3daa-5170-80e7-2ad2212a0376" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3f/3f6994b60e754eea32fa80912a8f97d52489cf40afeb1ed8302c735114c435fa.png" :db/id #edb/ref 17592186518785} {:answer/id #uuid "8f54eaf6-17e9-532e-9a19-52e471db13d6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/06/06e549a074498c1965de40b8e169788d1f17b345eb4d0b6ac0f3448f5ea0d836.png" :db/id #edb/ref 17592186518802} {:answer/id #uuid "922d439f-5c84-51e8-8470-495005da2288" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/00/0078b7d156dd5970e03f8397336ec07658f1b314a6d7da856c20dfba0dcebd8c.png" :db/id #edb/ref 17592186518805}] :answer-field/correct {:answer/id #uuid "2325b410-0c6c-5f57-bcd5-530841a89169" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0d/0d2feddba8eb9c880f7a0dfd88b2b1f936f8bfa1de33f205c408fd776a33a579.png" :db/id #edb/ref 17592186518774} :answer-field/id #uuid "ba38c6cb-2e18-5cec-833d-5f3d7771d213" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186518820}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4806298d-deed-5b7f-9dfb-a11102a6c5d3" :question/problem "Which of the following diagrams represents the vector field $F(x,y)=2 x y\\,i-x^{2}\\,j$ at the indicated points?" :question/worked-solution "We have to sketch the vector field at the points $(-2,\\frac{3}{2}),(1,- \\frac{1}{2}),$ and $(-1,\\frac{3}{2}).$\n\nTo sketch the vector field at the given points, we substitute their coordinates into the function $F(x,y)=2 x y\\,i-x^{2}\\,j\\,:$\n\n$$\n\\begin{aligned}F(-2,\\frac{3}{2}) & =\\left((2)(-2)(\\frac{3}{2})\\right)\\,i+\\left((-1)(-2)^{2}\\right)\\,j=-6\\,i-4\\,j \\\\ F(1,- \\frac{1}{2}) & =\\left((2)(1)(- \\frac{1}{2})\\right)\\,i+\\left((-1)(1)^{2}\\right)\\,j=-i-j \\\\ F(-1,\\frac{3}{2}) & =\\left((2)(-1)(\\frac{3}{2})\\right)\\,i+\\left((-1)(-1)^{2}\\right)\\,j=-3\\,i-j\\end{aligned}\n$$\n\nWe now draw our vectors. At each point, we draw the vector associated with that point, placing the tail end of the vector on the point itself. This gives the following diagram.\n\n![](images/0d/0d2feddba8eb9c880f7a0dfd88b2b1f936f8bfa1de33f205c408fd776a33a579.png)"} {:db/id #edb/ref 17592186518789 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f24afde-307e-5a68-9ef6-d776f89a190a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cc/ccaa50fb2c18d3f4f320dfebfaa34522a32a50b8fa0c4bea641f158367716437.png" :db/id #edb/ref 17592186518769} {:answer/id #uuid "279db652-c9e6-5660-a30a-c3664e796959" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f1/f1825366a93acf5c83c83973d9689d919e5e4a27a3db7fe31bca95afe0dfef78.png" :db/id #edb/ref 17592186518776} {:answer/id #uuid "4792412b-7e7a-5172-9926-7e53c39b704f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2c/2cdf71a7faea6652cca5c0b87916f6a6ce2f622dfb5a668b386a5c1bf2567d23.png" :db/id #edb/ref 17592186518780} {:answer/id #uuid "5cb11845-5440-5f8e-ab38-09080147e291" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/86/866186b6f6f18cca7832b0da458fbd08f01a6cb7d618f2a904f50885eb2e3f0f.png" :db/id #edb/ref 17592186518788} {:answer/id #uuid "a099f06e-ecd1-50f5-8536-1f98184ff8e2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f6/f686e6a5920875ee373ced37fa6fcac941dc3fbd54489f16d4f27c3ff996b2e8.png" :db/id #edb/ref 17592186518813}] :answer-field/correct {:answer/id #uuid "5cb11845-5440-5f8e-ab38-09080147e291" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/86/866186b6f6f18cca7832b0da458fbd08f01a6cb7d618f2a904f50885eb2e3f0f.png" :db/id #edb/ref 17592186518788} :answer-field/id #uuid "f8b11a11-c4c5-5c9c-a8c5-b16ef6212efd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186518830}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "664de91a-fae2-5c4e-bcb3-71dd355525c5" :question/problem "Which of the following diagrams represents the vector field $F(x,y)=-2 x y\\,i-x^{2}\\,j$ at the indicated points?" :question/worked-solution "We have to sketch the vector field at the points $(-1,\\frac{5}{4}),(-2,- \\frac{5}{4}),$ and $(-2,\\frac{3}{4}).$\n\nTo sketch the vector field at the given points, we substitute their coordinates into the function $F(x,y)=-2 x y\\,i-x^{2}\\,j\\,:$\n\n$$\n\\begin{aligned}F(-1,\\frac{5}{4}) & =\\left((-2)(-1)(\\frac{5}{4})\\right)\\,i+\\left((-1)(-1)^{2}\\right)\\,j=\\frac{5}{2}\\,i-j \\\\ F(-2,- \\frac{5}{4}) & =\\left((-2)(-2)(- \\frac{5}{4})\\right)\\,i+\\left((-1)(-2)^{2}\\right)\\,j=-5\\,i-4\\,j \\\\ F(-2,\\frac{3}{4}) & =\\left((-2)(-2)(\\frac{3}{4})\\right)\\,i+\\left((-1)(-2)^{2}\\right)\\,j=3\\,i-4\\,j\\end{aligned}\n$$\n\nWe now draw our vectors. At each point, we draw the vector associated with that point, placing the tail end of the vector on the point itself. This gives the following diagram.\n\n![](images/86/866186b6f6f18cca7832b0da458fbd08f01a6cb7d618f2a904f50885eb2e3f0f.png)"} {:db/id #edb/ref 17592186518796 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73c47d7b-b24d-5cf2-b0c2-6d7f0849e04d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/72/72166eb3343bf0855703e987cae9bc13f3f086b9c5ed12b0d122fc895625dbb0.png" :db/id #edb/ref 17592186518793} {:answer/id #uuid "ac2d5692-6775-5b7d-ab4e-b438291a6bbd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/22/22f6819ea214f9f4e28ecf9dcc15a809aeb8e518a2f9c819fcb3c55f92372b77.png" :db/id #edb/ref 17592186518816} {:answer/id #uuid "dc0b44c4-099e-5594-a966-9e9a34f749ee" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/07/07355ad0b1ad48f062e97eeab30d1d9fbc708c418e232782710d2a69610585aa.png" :db/id #edb/ref 17592186518824} {:answer/id #uuid "dd179ccb-32c0-5484-a19d-839444ebf6a7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cb/cbc69fd8f2bb28a37354e093bdd060dcedfe53c05d137b42636ce0f58f94c39f.png" :db/id #edb/ref 17592186518826} {:answer/id #uuid "e3545f29-5add-536f-b92d-21489fef7b5b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/37/37f3a9ac37226466e1283970c046c9355a2b0d04b4e4da0d1a4bf76281089a5b.png" :db/id #edb/ref 17592186518827}] :answer-field/correct {:answer/id #uuid "dd179ccb-32c0-5484-a19d-839444ebf6a7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cb/cbc69fd8f2bb28a37354e093bdd060dcedfe53c05d137b42636ce0f58f94c39f.png" :d