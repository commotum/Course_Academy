e-50b0-91cb-0e4d41ad7733" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{35}{64}" :db/id #edb/ref 17592186313319} {:answer/id #uuid "c17c819e-ef43-5e57-9e8b-53e5bb36a223" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186313488}] :answer-field/correct {:answer/id #uuid "ab9ea726-76de-50b0-91cb-0e4d41ad7733" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{35}{64}" :db/id #edb/ref 17592186313319} :answer-field/id #uuid "d5a6160d-037b-5e12-ae36-da0d71a09ff4" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314600} {:answer-field/choices [{:answer/id #uuid "6ca4599d-1dfa-53b2-bec2-90ddf6f24dbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186312829} {:answer/id #uuid "795fb8de-c70c-52e5-8ee0-845921cef5f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186312946} {:answer/id #uuid "df688ce6-1f6f-5ae3-a414-2ad4cc611733" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186313731}] :answer-field/correct {:answer/id #uuid "df688ce6-1f6f-5ae3-a414-2ad4cc611733" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186313731} :answer-field/id #uuid "e02c917a-64cb-5a54-90e4-73fff1ff24db" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314630} {:answer-field/choices [{:answer/id #uuid "0788652a-89f3-5f09-a516-3cfa8af5b116" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186312026} {:answer/id #uuid "29af6379-2fe6-5939-8abf-8a045a704eee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186312292} {:answer/id #uuid "30c0bee0-d031-5a79-ac25-9e30521add82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186312367}] :answer-field/correct {:answer/id #uuid "29af6379-2fe6-5939-8abf-8a045a704eee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186312292} :answer-field/id #uuid "ec1cb9e2-eded-545a-841d-91ad33a699b2" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314657}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3c5215ee-45be-5ff4-a543-c5e30d8bedc6" :question/math-academy-id "q-339820" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=2x-4y,\\,y(1)=\\frac{1}{2}\n$$\n\nWe wish to approximate the solution using the Runge-Kutta (RK4) method. Complete the table below, given that the step size is $Δx=\\frac{1}{4}.$\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $\\frac{1}{2}$ | {{field-1}} | {{field-2}} | {{field-3}} | {{field-4}} | {{field-5}} |\n| $\\frac{5}{4}$ | {{field-6}} |  |  |  |  |  |" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe increment in $y$ using the Runge-Kutta Method with step size $Δx$ is computed as the weighted average of four sample slopes:\n\n$$\nΔy=\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx,\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the slope at the initial point $(x,y),$\n\n- ${y}_{1}^{′}=f({x}_{1},{y}_{1})$ is the slope at $({x}_{1},{y}_{1})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx),$\n\n- ${y}_{2}^{′}=f({x}_{2},{y}_{2})$ is the slope at $({x}_{2},{y}_{2})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx),$\n\n- ${y}_{3}^{′}=f({x}_{3},{y}_{3})$ is the slope at $({x}_{3},{y}_{3})=(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx).$\n\nNow let's find the required values.\n\n- First, we compute the value of ${y}^{′}$ according to the given rule:\n\n$$\n\\begin{aligned}{y}^{′} & =2x-4y \\\\  & =2\\cdot 1-4\\cdot \\frac{1}{2} \\\\  & =2-2 \\\\  & =0.\\end{aligned}\n$$\n\nSo, we add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $\\frac{1}{2}$ | $0$ |  |  |  |  |\n\n- The first intermediate point is\n\n$$\n\\begin{aligned}\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,({x}_{1},{y}_{1}) & =(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx) \\\\  & =(1+\\frac{1}{2}\\cdot \\frac{1}{4},\\,\\frac{1}{2}+\\frac{1}{2}\\cdot 0\\cdot \\frac{1}{4}) \\\\  & =(\\frac{9}{8},\\frac{1}{2}).\\end{aligned}\n$$\n\nSo, the first intermediate slope is\n\n$$\n\\begin{aligned}{y}_{1}^{′} & =2{x}_{1}-4{y}_{1} \\\\  & =2\\cdot \\frac{9}{8}-4\\cdot \\frac{1}{2} \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$\n\nWe can add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $\\frac{1}{2}$ | $0$ | $\\frac{1}{4}$ |  |  |  |\n\n- The second intermediate point is\n\n$$\n\\begin{aligned}\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,({x}_{2},{y}_{2}) & =(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx) \\\\  & =(1+\\frac{1}{2}\\cdot \\frac{1}{4},\\,\\frac{1}{2}+\\frac{1}{2}\\cdot \\frac{1}{4}\\cdot \\frac{1}{4}) \\\\  & =(\\frac{9}{8},\\frac{17}{32}).\\end{aligned}\n$$\n\nSo, the second intermediate slope is\n\n$$\n\\begin{aligned}{y}_{2}^{′} & =2{x}_{2}-4{y}_{2} \\\\  & =2\\cdot \\frac{9}{8}-4\\cdot \\frac{17}{32} \\\\  & =\\frac{1}{8}.\\end{aligned}\n$$\n\nWe add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $\\frac{1}{2}$ | $0$ | $\\frac{1}{4}$ | $\\frac{1}{8}$ |  |  |\n\n- The third intermediate point is\n\n$$\n\\begin{aligned}({x}_{3},{y}_{3}) & =(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx) \\\\  & =(1+\\frac{1}{4},\\,\\frac{1}{2}+\\frac{1}{8}\\cdot \\frac{1}{4}) \\\\  & =(\\frac{5}{4},\\frac{17}{32}).\\end{aligned}\n$$\n\nSo, the third intermediate slope is\n\n$$\n\\begin{aligned}{y}_{3}^{′} & =2{x}_{3}-4{y}_{3} \\\\  & =2\\cdot \\frac{5}{4}-4\\cdot \\frac{17}{32} \\\\  & =\\frac{3}{8}.\\end{aligned}\n$$\n\nWe can add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $\\frac{1}{2}$ | $0$ | $\\frac{1}{4}$ | $\\frac{1}{8}$ | $\\frac{3}{8}$ |  |\n\nFinally, we compute $Δy$ using the Runge-Kutta Method:\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx \\\\  & =\\frac{1}{6}(0+2\\cdot \\frac{1}{4}+2\\cdot \\frac{1}{8}+\\frac{3}{8})\\cdot \\frac{1}{4} \\\\  & =\\frac{1}{24}\\cdot \\frac{9}{8} \\\\  & =\\frac{3}{64}.\\end{aligned}\n$$\n\nTherefore, the completed first row is as given below.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $\\frac{1}{2}$ | $0$ | $\\frac{1}{4}$ | $\\frac{1}{8}$ | $\\frac{3}{8}$ | $\\frac{3}{64}$ |\n\nTo get the values of $x$ and $y$ in the *next* row, we add $Δx$ to $x$ and $Δy$ to $y,$ as follows:\n\n$$\n\\begin{aligned}{x}_{\\text{new}} & =x+Δx \\\\  & =1+\\frac{1}{4} \\\\  & =\\frac{5}{4} \\\\ {y}_{\\text{new}} & =y+Δy \\\\  & =\\frac{1}{2}+\\frac{3}{64} \\\\  & =\\frac{35}{64}\\end{aligned}\n$$\n\nAdding these rows to our table gives the following:\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $\\frac{1}{2}$ | $0$ | $\\frac{1}{4}$ | $\\frac{1}{8}$ | $\\frac{3}{8}$ | $\\frac{3}{64}$ |\n| $\\frac{5}{4}$ | $\\frac{35}{64}$ |  |  |  |  |  |\n\nFinally, we have\n\n$$\n\\begin{aligned}y\\,(\\frac{5}{4})≈\\frac{35}{64}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314863 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c48eda1-18ee-5343-a5e1-365df9674dae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186312593} {:answer/id #uuid "a6c3d5b1-1cb2-528a-beac-3061bf4ea0be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{6}" :db/id #edb/ref 17592186313282} {:answer/id #uuid "e764477a-cf8a-5d69-8ced-b4a06a53c1da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186313810}] :answer-field/correct {:answer/id #uuid "e764477a-cf8a-5d69-8ced-b4a06a53c1da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186313810} :answer-field/id #uuid "07c31019-1383-56d9-bda6-ae58b81e16ec" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314035} {:answer-field/choices [{:answer/id #uuid "3bd5fe08-4db6-5b54-862b-64ef40b8042e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186312460} {:answer/id #uuid "44fb3759-a39f-51cd-9db0-3d7936061fa5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answe