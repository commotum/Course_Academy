{cos}x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233852 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ffe742bc-c810-5bfc-ae08-cf12baee8500" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{6}+\\sqrt{2}}{4}" :db/id #edb/ref 17592186232713}] :answer-field/correct {:answer/id #uuid "ffe742bc-c810-5bfc-ae08-cf12baee8500" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{6}+\\sqrt{2}}{4}" :db/id #edb/ref 17592186232713} :answer-field/id #uuid "fa940d42-97be-559a-9a9e-a71e2702f78f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232712}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b67c309d-f1ce-5ff4-97dc-3605a30b0439" :question/math-academy-id "q-332487" :question/problem "Using the fact that $\\frac{11\\pi }{12}=\\frac{3\\pi }{4}+\\frac{\\pi }{6},$\ncalculate the **exact** value of $\\operatorname{cos}(\\frac{11\\pi }{12}).$\n\n$\\operatorname{cos}(\\frac{11\\pi }{12})=$\n{{field-1}}" :question/worked-solution "Recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}(x+y)=\\operatorname{cos}x\\operatorname{cos}y-\\operatorname{sin}x\\operatorname{sin}y\n$$\n\nApplying the sum formula for cosine with $x=\\frac{3\\pi }{4}$ and $y=\\frac{\\pi }{6}$, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}(\\frac{11\\pi }{12}) & =\\operatorname{cos}(\\frac{3\\pi }{4}+\\frac{\\pi }{6}) \\\\  & =\\operatorname{cos}(\\frac{3\\pi }{4})\\operatorname{cos}(\\frac{\\pi }{6})-\\operatorname{sin}(\\frac{3\\pi }{4})\\operatorname{sin}(\\frac{\\pi }{6}) \\\\  & =(-\\frac{\\sqrt{2}}{2})\\cdot \\frac{\\sqrt{3}}{2}-\\frac{\\sqrt{2}}{2}\\cdot \\frac{1}{2} \\\\  & =-\\frac{\\sqrt{6}}{4}-\\frac{\\sqrt{2}}{4} \\\\  & =-\\frac{\\sqrt{6}+\\sqrt{2}}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233853 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c2081ac-016b-5596-b46b-59171b11fa5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}-\\sqrt{6}}{4}" :db/id #edb/ref 17592186232715}] :answer-field/correct {:answer/id #uuid "9c2081ac-016b-5596-b46b-59171b11fa5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}-\\sqrt{6}}{4}" :db/id #edb/ref 17592186232715} :answer-field/id #uuid "3fe15bf4-bc0c-5ade-a990-0bea34e15590" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232714}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e4605c71-e2bc-5367-b6ca-7ac14bd5654c" :question/math-academy-id "q-332488" :question/problem "Using the fact that $\\frac{17\\pi }{12}=\\frac{3\\pi }{4}+\\frac{2\\pi }{3},$\ncalculate the **exact** value of $\\operatorname{cos}(\\frac{17\\pi }{12}).$\n\n$\\operatorname{cos}(\\frac{17\\pi }{12})=$\n{{field-1}}" :question/worked-solution "Recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}(x+y)=\\operatorname{cos}x\\operatorname{cos}y-\\operatorname{sin}x\\operatorname{sin}y\n$$\n\nApplying the sum formula for cosine with $x=\\frac{3\\pi }{4}$ and $y=\\frac{2\\pi }{3}$, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}(\\frac{17\\pi }{12}) & =\\operatorname{cos}(\\frac{3\\pi }{4}+\\frac{2\\pi }{3}) \\\\  & =\\operatorname{cos}(\\frac{3\\pi }{4})\\operatorname{cos}(\\frac{2\\pi }{3})-\\operatorname{sin}(\\frac{3\\pi }{4})\\operatorname{sin}(\\frac{2\\pi }{3}) \\\\  & =(-\\frac{\\sqrt{2}}{2})\\cdot (-\\frac{1}{2})-\\frac{\\sqrt{2}}{2}\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\frac{\\sqrt{2}}{4}-\\frac{\\sqrt{6}}{4} \\\\  & =\\frac{\\sqrt{2}-\\sqrt{6}}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a351893f-dedd-55b4-841a-6e74145b4c7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}+\\sqrt{6}}{4}" :db/id #edb/ref 17592186232719}] :answer-field/correct {:answer/id #uuid "a351893f-dedd-55b4-841a-6e74145b4c7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}+\\sqrt{6}}{4}" :db/id #edb/ref 17592186232719} :answer-field/id #uuid "71c44759-a2b9-551e-8f99-999c6e888bee" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232718}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ee2206e0-9825-56e9-b775-43a2d0447c20" :question/math-academy-id "q-332497" :question/problem "Using the fact that $-{165}^{∘}={60}^{∘}-{225}^{∘},$\ncalculate the **exact** value of $\\operatorname{cos}(-{165}^{∘}).$\n\n$\\operatorname{cos}(-{165}^{∘})=$\n{{field-1}}" :question/worked-solution "Recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}(x-y)=\\operatorname{cos}x\\operatorname{cos}y+\\operatorname{sin}x\\operatorname{sin}y\n$$\n\nApplying the sum formula for cosine with $x={60}^{∘}$ and $y={225}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}(-{165}^{∘}) & =\\operatorname{cos}({60}^{∘}-{225}^{∘}) \\\\  & =\\operatorname{cos}({60}^{∘})\\operatorname{cos}({225}^{∘})+\\operatorname{sin}({60}^{∘})\\operatorname{sin}({225}^{∘}) \\\\  & =\\frac{1}{2}\\cdot (-\\frac{\\sqrt{2}}{2})+\\frac{\\sqrt{3}}{2}\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =-\\frac{\\sqrt{2}}{4}-\\frac{\\sqrt{6}}{4} \\\\  & =-\\frac{\\sqrt{2}+\\sqrt{6}}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233856 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ecb0ced-6f35-5743-b44e-663b8ffbfe91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186232721}] :answer-field/correct {:answer/id #uuid "8ecb0ced-6f35-5743-b44e-663b8ffbfe91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186232721} :answer-field/id #uuid "75bfaeb4-219b-516c-a58d-558034596152" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232720}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cb9a138e-76d2-528f-b913-b0fc66fe6f14" :question/math-academy-id "q-332500" :question/problem "Using the fact that ${120}^{∘}={150}^{∘}-{30}^{∘},$\ncalculate the **exact** value of $\\operatorname{cos}({120}^{∘}).$\n\n$\\operatorname{cos}({120}^{∘})=$\n{{field-1}}" :question/worked-solution "Recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}(x-y)=\\operatorname{cos}x\\operatorname{cos}y+\\operatorname{sin}x\\operatorname{sin}y\n$$\n\nApplying the sum formula for cosine with $x={150}^{∘}$ and $y={30}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}({120}^{∘}) & =\\operatorname{cos}({150}^{∘}-{30}^{∘}) \\\\  & =\\operatorname{cos}({150}^{∘})\\operatorname{cos}({30}^{∘})+\\operatorname{sin}({150}^{∘})\\operatorname{sin}({30}^{∘}) \\\\  & =(-\\frac{\\sqrt{3}}{2})\\cdot \\frac{\\sqrt{3}}{2}+\\frac{1}{2}\\cdot \\frac{1}{2} \\\\  & =-\\frac{3}{4}+\\frac{1}{4} \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d25d1aa-ddb2-5107-bb2e-2ef65504b40b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186232723}] :answer-field/correct {:answer/id #uuid "4d25d1aa-ddb2-5107-bb2e-2ef65504b40b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186232723} :answer-field/id #uuid "4879e173-bfc8-586c-8c8b-403827a2f75d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232722} {:answer-field/choices [{:answer/id #uuid "e57bf926-20b3-5ec5-b557-4831facb1579" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186232725}] :answer-field/correct {:answer/id #uuid "e57bf926-20b3-5ec5-b557-4831facb1579" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186232725} :answer-field/id #uuid "9075faf7-f74b-53b2-85c5-a0828cd1af19" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232724}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b96d0ab4-a946-5671-9ea7-267fbf9c78cc" :question/math-academy-id "q-332509" :question/problem "Express $\\operatorname{cos}(x+{330}^{∘})$ in terms of $\\operatorname{sin}x$ and $\\operatorname{cos}x.$\n\n$\\operatorname{cos}(x+{330}^{∘})=$\n{{field-1}}$\\operatorname{sin}x\\,+$\n{{field-2}}$\\operatorname{cos}x$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}(u+v)=\\operatorname{cos}u\\operatorname{cos}v-\\operatorname{sin}u\\operatorname{sin}v\n$$\n\nApplying the sum formula for cosine with $u=x$ and $v={330}^{∘}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}(x+{330}^{∘}) & =\\operatorname{cos}x\\operatorname{cos}{330}^{∘}-\\operatorname{sin}x\\operatorname{sin}{330}^{∘} \\\\  & =\\operatorname{cos}x\\cdot \\frac{\\sqrt{3}}{2}-\\operatorname{sin}x\\cdot (-\\frac{1}{2}) \\\\  & =\\frac{1}{2}\\,\\operatorname{sin}x+\\frac{\\sqrt{3}}{2}\\,\\operatorname{cos}x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233858 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81856fae-d2a2-5b76-923c-9cff5499f01f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186232727}] :answer-field/correct {:answer/id #uuid "81856fae-d2a2-5b76-923c-9cff5499f01f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186232727} :answer-field/id #uuid "18848047-e617-5a30-bbe9-9b4a5da33670" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232726}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "edac21ab-2ee5-5110-9930-cdd63de0f955" :question/math-academy-id "q-334171" :question/problem "Given that $p(x)=\\frac{-6}{{x}^{5}}$ and $q(x)=\\frac{3}{{x}^{2}},$ evaluate the following limit:\n\n${lim}_{x\\to -\\infty }\\frac{p(x)}{q(x)}=$\n{{field-1}}" :question/worked-solution "First, we divide the two functions, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\frac{p(x)}{q(x)} & ={lim}_{x\\to -\\infty }\\frac{(\\frac{-6}{{x}^{5}})}{(\\frac{3}{{x}^{2}})} \\\\  & ={lim}_{x\\to -\\infty }(-\\frac{2}{{x}^{3}})\\end{aligned}\n$$\n\nNow, we use the algebra of limits to pull out the constant factor of $-2:$\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }(-\\frac{2}{{x}^{3}}) & ={lim}_{x\\to -\\infty }(-2\\cdot \\frac{1}{{x}^{3}}) \\\\  & =-2\\cdot {lim}_{x\\to -\\infty }(\\frac{1}{{x}^{3}})\\end{aligned}\n$$\n\nNow, using the fact that\n\n$$\n{lim}_{x\\to -\\infty }(\\frac{1}{{x}^{3}})=0,\n$$\n\nwe can evaluate our limit as follows:\n\n$$\n-2\\cdot {lim}_{x\\to -\\infty }(\\frac{1}{{x}^{3}})=-2\\cdot 0=0\n$$"} {:db/id #edb/ref 17592186233859 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f5094f0-6f74-515a-8b40-9c2caed9f137" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186232729}] :answer-field/correct {:answer/id #uuid "1f5094f0-6f74-515a-8b40-9c2caed9f137" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186232729} :answer-field/id #uuid "933f67e0-0d0f-545e-8cd0-397aeb81d26f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232728}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "06019a1d-03ad-524f-ada7-d159c6acdd5d" :question/math-academy-id "q-334189" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to -\\infty }\\frac{\\sqrt{3}}{6({x}^{5}-4)}=$\n{{field-1}}" :question/worked-solution "First, we rewrite our limit using the algebra of limits, as follows:\n\n$$\n{lim}_{x\\to -\\infty }\\frac{\\sqrt{3}}{6({x}^{5}-4)}=\\frac{\\sqrt{3}}{6}\\cdot {lim}_{x\\to -\\infty }\\frac{1}{{x}^{5}-4}\n$$\n\nFor any non-constant polynomial $P(x),$ we have\n\n$$\n{lim}_{x\\to \\pm \\infty }(\\frac{1}{P(x)})=0.\n$$\n\nTherefore, since ${x}^{5}-4$ is a non-constant polynomial, we have\n\n$$\n{lim}_{x\\to -\\infty }\\frac{1}{{x}^{5}-4}=0.\n$$\n\nFinally, we can evaluate the original limit as follows:\n\n$$\n\\frac{\\sqrt{3}}{6}\\cdot {lim}_{x\\to -\\infty }\\frac{1}{{x}^{5}-4}=\\frac{\\sqrt{3}}{6}\\cdot 0=0\n$$"} {:db/id #edb/ref 17592186233860 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c521f271-c83d-5697-bd4f-741c31a5a5b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186232731}] :answer-field/correct {:answer/id #uuid "c521f271-c83d-5697-bd4f-741c31a5a5b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186232731} :answer-field/id #uuid "6e86f0bc-0c89-5e8b-9e4e-1c33dd73f7a2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232730}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "72a91134-e160-5ea6-a2e1-d4894fe09a2c" :question/math-academy-id "q-334208" :question/problem "![](images/26/26e2e4a51d40e9ed8e6a8fab342935e944e750587534c7cedc1855cbfddfbfc5.png)\n\nIf the figure above shows the graph of $f(x),$ then\n\n${lim}_{x\\to \\infty }\\frac{f(x)}{{x}^{3}+5x-6}=$\n{{field-1}}." :question/worked-solution "From the diagram, ${lim}_{x\\to \\infty }f(x)=2.$\n\nNow, rewrite the target limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{f(x)}{{x}^{3}+5x-6} & ={lim}_{x\\to \\infty }f(x)\\cdot {lim}_{x\\to \\infty }\\frac{1}{{x}^{3}+5x-6}\\end{aligned}\n$$\n\nFor any non-constant polynomial $P(x),$ we have\n\n$$\n{lim}_{x\\to \\pm \\infty }(\\frac{1}{P(x)})=0.\n$$\n\nTherefore, since ${x}^{3}+5x-6$ is a non-constant polynomial, we have\n\n$$\n{lim}_{x\\to \\infty }\\frac{1}{{x}^{3}+5x-6}=0.\n$$\n\nFinally, we can evaluate the original limit as follows:\n\n$$\n{lim}_{x\\to \\infty }f(x)\\cdot {lim}_{x\\to \\infty }\\frac{1}{{x}^{3}+5x-6}=2\\cdot 0=0\n$$"} {:db/id #edb/ref 17592186233864 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9202ea40-a6c2-5baf-a75b-2bedde450e5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186232739}] :answer-field/correct {:answer/id #uuid "9202ea40-a6c2-5baf-a75b-2bedde450e5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186232739} :answer-field/id #uuid "fcbb45e6-f336-5e6c-be95-d9f295d2bc59" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232738}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f3be778a-b776-5409-b744-d5fc85d920dc" :question/math-academy-id "q-336160" :question/problem "The position $s(t)$ of a particle at time $t$ is given by \n\n$$\ns(t)=-\\sqrt{2}\\operatorname{csc}t,\\,0<t<\\pi .\n$$\n\nCalculate the velocity at time $t=\\frac{\\pi }{4}.$\n\n$v(\\frac{\\pi }{4})=$\n{{field-1}}" :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(-\\sqrt{2}\\operatorname{csc}t) \\\\  & =\\sqrt{2}\\operatorname{csc}t\\operatorname{cot}t\\end{aligned}\n$$\n\n \n\nTo calculate the velocity at $t=\\frac{\\pi }{4},$ we substitute $t=\\frac{\\pi }{4}$ into the velocity function above:\n\n$$\n\\begin{aligned}v(\\frac{\\pi }{4}) & =\\sqrt{2}\\operatorname{csc}(\\frac{\\pi }{4})\\operatorname{cot}(\\frac{\\pi }{4}) \\\\  & =\\sqrt{2}\\cdot \\sqrt{2}\\cdot 1 \\\\  & =2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233865 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "714f9f51-c13b-5340-8347-a9ab38536810" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186232741}] :answer-field/correct {:answer/id #uuid "714f9f51-c13b-5340-8347-a9ab38536810" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186232741} :answer-field/id #uuid "9e47dbc1-3b70-5e8b-8e93-908173c2d06f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232740}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bef0eb8a-49c8-5716-a787-93d4b0d67791" :question/math-academy-id "q-336189" :question/problem "The position $s(t)$ of a particle (in meters) at time $t$ seconds is given by \n\n$$\ns(t)=6\\operatorname{sin}t-8\\operatorname{cos}t,\\,t>0.\n$$\n\nCalculate the speed of the particle when $t=\\frac{3\\pi }{2}\\,\\text{s}.$\n\nThe speed of the particle is \n{{field-1}}$\\text{m/s}.$" :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(6\\operatorname{sin}t-8\\operatorname{cos}t) \\\\  & =6\\operatorname{cos}t+8\\operatorname{sin}t\\end{aligned}\n$$\n\nWhen $t=\\frac{3\\pi }{2},$ the velocity is\n\n$$\n\\begin{aligned}v(\\frac{3\\pi }{2}) & =6\\operatorname{cos}(\\frac{3\\pi }{2})+8\\operatorname{sin}(\\frac{3\\pi }{2}) \\\\  & =6(0)+8(-1) \\\\  & =-8.\\end{aligned}\n$$\n\nTherefore, the speed is $|-8|=8\\,\\text{m/s}.$"} {:db/id #edb/ref 17592186233866 :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8c366f3c-26d4-5a78-b6c8-77d9d1b20627" :question/math-academy-id "q-3362" :question/problem "If ${27}^{2n+2}={(\\frac{1}{81})}^{-2n+8},$ then $n=$" :question/worked-solution "To solve this equation, we need both exponential terms to have a common base. To do this, we rewrite the equation using $27={3}^{3}$ and $81={3}^{4},$ as follows:\n\n$$\n{({3}^{3})}^{2n+2}={(\\frac{1}{{3}^{4}})}^{-2n+8}\n$$\n\nThen, we apply the power rule and the power of quotient rule of exponents. This gives:\n\n$$\n\\begin{aligned}{3}^{3(2n+2)}=\\frac{1}{{3}^{4(-2n+8)}}\\end{aligned}\n$$\n\nNext, we rewrite the right-hand side using a negative exponent:\n\n$$\n\\begin{aligned}{3}^{3(2n+2)}={3}^{-4(-2n+8)}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(3)$, we equate the exponents and solve for $n:$\n\n$$\n\\begin{aligned}3(2n+2) & =-4(-2n+8) \\\\ 6n+6 & =8n-32 \\\\ 2n & =38 \\\\ n & =19\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233867 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e446a46c-61d6-5678-95f1-80a97b31da5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186232743}] :answer-field/correct {:answer/id #uuid "e446a46c-61d6-5678-95f1-80a97b31da5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186232743} :answer-field/id #uuid "925ca0c0-df9b-5162-aba2-e7fb64c302f1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232742}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3526dbdc-ebe7-5a62-a173-cc72c5d288a5" :question/math-academy-id "q-336433" :question/problem "The velocity $v$ (in $\\text{m/s}$) of a particle at time $t$ (in seconds) is given by\n$v(t)=\\frac{t+3}{t+1}.$\nCalculate the velocity of the particle when the acceleration $a$ is equal to $-\\frac{1}{2}\\,{\\text{m/s}}^{2}.$\n\nWhen $a=-\\frac{1}{2}\\,{\\text{m/s}}^{2},$ the velocity is $v=$\n{{field-1}}\n$\\text{m/s}.$" :question/worked-solution "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{t+3}{t+1}) \\\\  & =\\frac{(1)\\cdot (t+1)-(t+3)\\cdot (1)}{(t+1)^{2}} \\\\  & =\\frac{t+1-t-3}{(t+1)^{2}} \\\\  & =-\\frac{2}{(t+1)^{2}}\\end{aligned}\n$$\n\nTo calculate the time when the acceleration is $a=-\\frac{1}{2},$ we substitute this into the above:\n\n$$\n\\begin{aligned}-\\frac{1}{2} & =-\\frac{2}{(t+1)^{2}} \\\\ \\frac{1}{2} & =\\frac{2}{(t+1)^{2}} \\\\ (t+1)^{2} & =4 \\\\ t+1 & =\\pm 2 \\\\ t & =-3,1\\end{aligned}\n$$\n\nThus, $t=1$ since $t\\ge 0.$\n\nThen, to calculate the velocity at time $t=1,$ we substitute this into the equation for the velocity:\n\n$$\n\\begin{aligned}v(1) & =\\frac{1+3}{1+1} \\\\  & =\\frac{4}{2} \\\\  & =2\\text{ m/s}\\end{aligned}\n$$\n\nTherefore, the velocity when $a=-\\frac{1}{2}\\,{\\text{m/s}}^{2}$ is $v=2\\,\\text{m/s}.$"} {:db/id #edb/ref 17592186233868 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff54d4c5-df6b-56f6-991d-1952c17ef113" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186232745}] :answer-field/correct {:answer/id #uuid "ff54d4c5-df6b-56f6-991d-1952c17ef113" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186232745} :answer-field/id #uuid "45e7cdd4-0b1d-566e-8ef1-e039a6e4ac24" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232744}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d22e9e43-18db-5918-8eaf-f62f07f8c206" :question/math-academy-id "q-336896" :question/problem "${lim}_{x\\to -\\infty }(\\frac{-5{x}^{9}}{2})=${{field-1}}" :question/worked-solution "First, we note that\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }(\\frac{-5{x}^{9}}{2}) & ={lim}_{x\\to -\\infty }(\\frac{-5}{2}\\cdot {x}^{9}) \\\\  & =\\frac{-5}{2}\\cdot {lim}_{x\\to -\\infty }{x}^{9}.\\end{aligned}\n$$\n\nThe graph $y={x}^{9}$ is a power function with an odd positive power and therefore has the property that\n\n$$\n{lim}_{x\\to -\\infty }{x}^{9}=-\\infty .\n$$\n\nMultiplication by the negative constant $\\frac{-5}{2}$ changes the sign of the limit. So, we have\n\n$$\n\\begin{aligned}\\frac{-5}{2}\\cdot {lim}_{x\\to -\\infty }{x}^{9} & =-{lim}_{x\\to -\\infty }{x}^{9}=\\infty . & \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{lim}_{x\\to -\\infty }(\\frac{-5{x}^{9}}{2})=\\infty .\n$$"} {:db/id #edb/ref 17592186233872 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e46edded-4d40-56ba-b292-c5f0a8d33251" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\operatorname{tan}(x)-2" :db/id #edb/ref 17592186232752}] :answer-field/correct {:answer/id #uuid "e46edded-4d40-56ba-b292-c5f0a8d33251" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\operatorname{tan}(x)-2" :db/id #edb/ref 17592186232752} :answer-field/id #uuid "b5778e06-97ac-5ef8-8d10-7ce0085036ef" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232751}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9734f0a3-cd50-5274-b82b-f9e29252c158" :question/math-academy-id "q-337182" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ if $y=\\frac{3\\operatorname{sec}(x)}{5{x}^{2}}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=\\frac{3\\operatorname{sec}(x)}{5{x}^{3}}($\n{{field-1}}$)$" :question/worked-solution "We calculate the derivative using the quotient rule:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,(\\frac{3\\operatorname{sec}(x)}{5{x}^{2}}) \\\\  & =\\frac{(3\\operatorname{sec}(x)\\operatorname{tan}(x))(5{x}^{2})-(3\\operatorname{sec}(x))(10x)}{(5{x}^{2})^{2}} \\\\  & =\\frac{15{x}^{2}\\operatorname{sec}(x)\\operatorname{tan}(x)-30x\\operatorname{sec}(x)}{25{x}^{4}} \\\\  & =\\frac{5x\\operatorname{sec}(x)(3x\\operatorname{tan}(x)-6)}{25{x}^{4}} \\\\  & =\\frac{\\operatorname{sec}(x)(3x\\operatorname{tan}(x)-6)}{5{x}^{3}} \\\\  & =\\frac{3\\operatorname{sec}(x)}{5{x}^{3}}(x\\operatorname{tan}(x)-2)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233881 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6bdc4f7-0580-544e-8b7c-202837c2674b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+\\pi " :db/id #edb/ref 17592186232769}] :answer-field/correct {:answer/id #uuid "b6bdc4f7-0580-544e-8b7c-202837c2674b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+\\pi " :db/id #edb/ref 17592186232769} :answer-field/id #uuid "6ce6cc64-5b3e-5e02-93aa-ade9fbb24f47" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232768}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2a0871e1-3be7-52c1-98fa-6a3a407fc1da" :question/math-academy-id "q-338440" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\pi /6}(\\operatorname{csc}(3x)+6x)=$\n{{field-1}}" :question/worked-solution "Substituting $x=\\frac{\\pi }{6}$ directly into the limit, we get\n\n$$\n\\begin{aligned}{lim}_{x\\to \\pi /6}(\\operatorname{csc}(3x)+6x) & =\\operatorname{csc}(3\\cdot \\frac{\\pi }{6})+6\\cdot \\frac{\\pi }{6} \\\\  & =\\operatorname{csc}(\\frac{\\pi }{2})+\\pi  \\\\  & =\\frac{1}{\\operatorname{sin}(\\frac{\\pi }{2})}+\\pi  \\\\  & =\\frac{1}{1}+\\pi  \\\\  & =1+\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233882 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7302f26f-ebc6-523f-92e8-b936a249ad82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186232771}] :answer-field/correct {:answer/id #uuid "7302f26f-ebc6-523f-92e8-b936a249ad82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186232771} :answer-field/id #uuid "5db918a0-0670-54b6-adae-fd1988d94e7d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232770}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3fb378b5-e05e-5063-a284-de8062325055" :question/math-academy-id "q-338444" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\pi /3}csc\\,(\\frac{3x}{2}-\\frac{\\pi }{4})=$\n{{field-1}}" :question/worked-solution "Substituting $x=\\frac{\\pi }{3}$ directly into the limit, we get\n\n$$\n\\begin{aligned}{lim}_{x\\to \\pi /3}csc\\,(\\frac{3x}{2}-\\frac{\\pi }{4}) & =\\operatorname{csc}(\\frac{3}{2}\\cdot \\frac{\\pi }{3}-\\frac{\\pi }{4}) \\\\  & =\\operatorname{csc}(\\frac{\\pi }{4}) \\\\  & =\\frac{1}{\\operatorname{sin}(\\frac{\\pi }{4})} \\\\  & =\\frac{1}{(\\frac{1}{\\sqrt{2}})} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233890 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f93ea01-4f48-56ff-a13c-6a3c8c156126" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186232786}] :answer-field/correct {:answer/id #uuid "7f93ea01-4f48-56ff-a13c-6a3c8c156126" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186232786} :answer-field/id #uuid "13ee4315-31c4-5844-a1dc-5d4fcee89075" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232785}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4c0b8eef-88c3-57dc-94b8-d8a75244e0de" :question/math-academy-id "q-339377" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\,-\\infty }\\frac{8}{\\pi }(\\operatorname{arctan}(5-x))=$\n{{field-1}}" :question/worked-solution "First, let's sketch the graph of $y=\\operatorname{arctan}(5-x):$ \n\n![](images/ce/ce2078de99b2c037b0ab6d5c5dcd4dab1e8aa7005417d87ca83176bf197fd5dc.png)\n\nThe domain of $\\operatorname{arctan}(5-x)$ is $(-\\infty ,\\infty ).$ Moreover, from the graph, we see that\n\n$$\n{lim}_{x\\to -\\infty }\\operatorname{arctan}(5-x)=\\frac{\\pi }{2}.\n$$\n\nTherefore,\n\n$$\n{lim}_{x\\to \\,-\\infty }\\frac{8}{\\pi }(\\operatorname{arctan}(5-x))=\\frac{8}{\\pi }\\cdot (\\frac{\\pi }{2})=4.\n$$"} {:db/id #edb/ref 17592186233891 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eedf3e8c-2408-50ac-b785-7336da7faa2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{x}^{7/3}}" :db/id #edb/ref 17592186232788} {:answer/id #uuid "63a26fe1-c8b3-49b0-8cec-555224db4ba1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186569177} {:answer/id #uuid "fff34ec0-610d-4a48-8de6-2377fa2858cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186569178} {:answer/id #uuid "e488d859-37b2-47b7-af25-3333076d5f9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x^{-}" :db/id #edb/ref 17592186569179} {:answer/id #uuid "7b141f32-3a27-42d2-999c-3f4b9584d94a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x^{-7}" :db/id #edb/ref 17592186569180} {:answer/id #uuid "a41991dc-7312-4a2d-b13a-575855ef6082" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x^{-\\frac{7}{\\placeholder{}}}" :db/id #edb/ref 17592186569181} {:answer/id #uuid "38527d17-e1c4-4fe2-bb71-6dbc786d991c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x^{-\\frac73}" :db/id #edb/ref 17592186569182}] :answer-field/correct {:answer/id #uuid "eedf3e8c-2408-50ac-b785-7336da7faa2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{x}^{7/3}}" :db/id #edb/ref 17592186232788} :answer-field/id #uuid "8fa89f31-a3e5-54ba-b90e-b1d2e4863cb2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232787}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b0a992ca-a10f-58d1-80e2-a329cbdc81ea" :question/math-academy-id "q-339446" :question/problem "If $y=-\\frac{3}{2\\sqrt[3]{{x}^{4}}},$ find $\\frac{dy}{dx}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "We first rewrite the function as\n\n$$\ny=-\\frac{3}{2\\sqrt[3]{{x}^{4}}}=-\\frac{3}{2}{x}^{-4/3}.\n$$\n\nThen, we apply the constant multiple and power rules:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-\\frac{3}{2}{x}^{-4/3}) \\\\  & =-\\frac{3}{2}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{-4/3}) \\\\  & =-\\frac{3}{2}\\cdot (-\\frac{4}{3}){x}^{(-\\frac{4}{3}-1)} \\\\  & =2{x}^{-7/3} \\\\  & =\\frac{2}{\\sqrt[3]{{x}^{7}}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233892 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "641d0678-b1c1-501e-a5f8-9c02ad64c16e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186232790}] :answer-field/correct {:answer/id #uuid "641d0678-b1c1-501e-a5f8-9c02ad64c16e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186232790} :answer-field/id #uuid "a6c93bd5-bde9-54f0-8b44-22ceceb7471b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232789}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "21051a8d-2827-54c0-93e4-0d23c3a26dd3" :question/math-academy-id "q-339489" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\,1}sin\\,(\\operatorname{arctan}(x))=$\n{{field-1}}" :question/worked-solution "![](images/68/68f1ebd0457e0c127f8ed6c979feba58196aa6bb43d97d211efa9b39bc33f637.png)\n\nThe domain of $\\operatorname{arctan}(x)$ is $(-\\infty ,\\infty ).$\n\nNow, substituting $x=1$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,1}sin\\,(\\operatorname{arctan}(x)) & =sin\\,(\\operatorname{arctan}(1)) \\\\  & =sin\\,(\\frac{\\pi }{4}) \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233899 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74933759-75c5-532d-af31-afd3380ef04d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{x}+\\pi {x}^{\\pi -1}" :db/id #edb/ref 17592186232808} {:answer/id #uuid "ed05b95c-c019-487b-ac1a-51a2dc383ab9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{x}+\\pi x^{\\left(\\pi-1\\right)}" :db/id #edb/ref 17592186569281}] :answer-field/correct {:answer/id #uuid "74933759-75c5-532d-af31-afd3380ef04d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{x}+\\pi {x}^{\\pi -1}" :db/id #edb/ref 17592186232808} :answer-field/id #uuid "68d840e4-5315-5b1c-ac1b-5463bf99806d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232807}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ef040da7-239c-5fb0-8704-10d30763e312" :question/math-academy-id "q-339973" :question/problem "Given that $y=2\\operatorname{ln}x+{x}^{\\pi }+1$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2\\operatorname{ln}x+{x}^{\\pi }+1) \\\\  & =2(\\frac{1}{x})+\\pi {x}^{\\pi -1} \\\\  & =\\frac{2}{x}+\\pi {x}^{\\pi -1}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4dcaf086-29eb-58e3-9792-842c7a25fb05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{x\\operatorname{ln}(7)}-\\frac{3}{x}" :db/id #edb/ref 17592186232812}] :answer-field/correct {:answer/id #uuid "4dcaf086-29eb-58e3-9792-842c7a25fb05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{x\\operatorname{ln}(7)}-\\frac{3}{x}" :db/id #edb/ref 17592186232812} :answer-field/id #uuid "b4aa8b73-2643-5d54-9ecf-8c68f6f1aaca" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232811}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c0ddc214-9263-5104-9473-b379b6f7ec26" :question/math-academy-id "q-339997" :question/problem "Given that $f(x)={log}_{7}x-3\\operatorname{ln}x$, find ${f}^{'}(x).$\n\n${f}^{'}(x)=$\n{{field-1}}" :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}x)=\\frac{1}{x\\operatorname{ln}a}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}({log}_{7}x-3\\operatorname{ln}x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({log}_{7}x)-3\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}x) \\\\  & =\\frac{1}{x\\operatorname{ln}(7)}-3(\\frac{1}{x}) \\\\  & =\\frac{1}{x\\operatorname{ln}(7)}-\\frac{3}{x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233911 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03e9d963-612a-5223-a2bb-a0380a286d94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186232832}] :answer-field/correct {:answer/id #uuid "03e9d963-612a-5223-a2bb-a0380a286d94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186232832} :answer-field/id #uuid "56422a4a-1f7d-5745-b018-ef376ed6e05f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232831}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6e21b5cf-a720-5e69-8578-f6d79190e60d" :question/math-academy-id "q-340642" :question/problem "Find the slope $m$ of $y=g(x)$ at $x=\\frac{\\pi }{2}$ if $g(x)=\\operatorname{csc}x\\operatorname{cot}x.$\n\n$m=$\n{{field-1}}" :question/worked-solution "First, we calculate the derivative using the product rule and sum rule:\n\n$$\n\\begin{aligned}{g}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{csc}x\\operatorname{cot}x) \\\\  & =(-\\operatorname{csc}x\\operatorname{cot}x)(\\operatorname{cot}x)+(\\operatorname{csc}x)(-{csc}^{2}x) \\\\  & =-\\operatorname{csc}x({cot}^{2}x+{csc}^{2}x)\\end{aligned}\n$$\n\nNow, we substitute $x=\\frac{\\pi }{2}$ and evaluate the slope $m:$\n\n$$\n\\begin{aligned}m={g}^{'}(\\frac{\\pi }{2}) & =-\\operatorname{csc}(\\frac{\\pi }{2})[{cot}^{2}(\\frac{\\pi }{2})+{csc}^{2}(\\frac{\\pi }{2})] \\\\  & =-1\\cdot ({0}^{2}+{1}^{2}) \\\\  & =-1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233915 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18cbf544-da6e-594e-afde-61e58b7a0c32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y" :db/id #edb/ref 17592186232842}] :answer-field/correct {:answer/id #uuid "18cbf544-da6e-594e-afde-61e58b7a0c32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y" :db/id #edb/ref 17592186232842} :answer-field/id #uuid "f87b4831-167f-5261-9548-eabab639f861" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232841} {:answer-field/choices [{:answer/id #uuid "3b74550d-4f2a-53a5-9859-638903e9e0ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15{y}^{5}" :db/id #edb/ref 17592186232844}] :answer-field/correct {:answer/id #uuid "3b74550d-4f2a-53a5-9859-638903e9e0ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15{y}^{5}" :db/id #edb/ref 17592186232844} :answer-field/id #uuid "f2050ee9-aabb-5a35-8caf-bf27987581b6" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232843}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e92e83a8-1c00-5738-9fc2-4ba6c65f2b58" :question/math-academy-id "q-341626" :question/problem "Given that $x=4\\sqrt{y}+3{y}^{5},$ express $\\frac{\\text{d}y}{\\text{d}x}$ as a function of $y.$\n\n| $\\text{d}y$ | $=$ | {{field-1}} |\n| --- | --- | --- |\n| $\\text{d}x$ |  | $2\\sqrt{y}\\,+${{field-2}} |" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(4\\sqrt{y}+3{y}^{5}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(4{y}^{1/2}+3{y}^{5}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(4{y}^{1/2})+\\frac{\\text{d}}{\\text{d}y}(3{y}^{5}) \\\\  & =2{y}^{-1/2}+15{y}^{4} \\\\  & =\\frac{2}{\\sqrt{y}}+15{y}^{4} \\\\  & =\\frac{2\\sqrt{y}}{y}+15{y}^{4} \\\\  & =\\frac{2\\sqrt{y}+15{y}^{5}}{y}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{y}{2\\sqrt{y}+15{y}^{5}}.\n$$"} {:db/id #edb/ref 17592186233919 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c846c3e-5084-53dd-bd31-2f1d8fa9e6b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186232851}] :answer-field/correct {:answer/id #uuid "6c846c3e-5084-53dd-bd31-2f1d8fa9e6b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186232851} :answer-field/id #uuid "9b54b588-f925-528e-91a9-dd7c061190ba" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232850}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "478ab1f4-b374-56e9-8da5-80a17776e189" :question/math-academy-id "q-341747" :question/problem "If $x=6\\sqrt[3]{y}+1,$ find $\\frac{\\text{d}y}{\\text{d}x}$ at the point $(13,8).$\n\n$\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(13,8)}=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(6\\sqrt[3]{y}+1) \\\\  & =6\\frac{\\text{d}}{\\text{d}y}(\\sqrt[3]{y})+\\frac{\\text{d}}{\\text{d}y}(1) \\\\  & =6\\frac{\\text{d}}{\\text{d}y}({y}^{1/3})+0 \\\\  & =6\\cdot \\frac{1}{3}{y}^{-2/3} \\\\  & =\\frac{2}{{(\\sqrt[3]{y})}^{2}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{{(\\sqrt[3]{y})}^{2}}{2}.\n$$\n\nFinally, substituting the point $(13,8),$ we find\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(13,8)} & =\\frac{{(\\sqrt[3]{8})}^{2}}{2} \\\\  & =\\frac{4}{2} \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233920 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7452b504-26e3-597e-abfe-757af2492083" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186232853}] :answer-field/correct {:answer/id #uuid "7452b504-26e3-597e-abfe-757af2492083" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186232853} :answer-field/id #uuid "bad98a1e-d9ad-53cc-aff5-9732df7a5c5c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232852}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e593c2e1-263c-5294-9a7c-b566ea68ae19" :question/math-academy-id "q-341919" :question/problem "Find the slope $m$ of the tangent at the point $(2,\\,7)$ for the curve $\\sqrt{x+7}+\\sqrt{y+2}=6.$\n\n$m=$\n{{field-1}}" :question/worked-solution "To find the slope at a point, we use implicit differentiation to calculate the derivative of the curve, assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x+7}+\\sqrt{y+2}) & =\\frac{\\text{d}}{\\text{d}x}(6) \\\\ \\frac{\\text{d}}{\\text{d}x}((x+7)^{1/2}+(y+2)^{1/2}) & =\\frac{\\text{d}}{\\text{d}x}(6) \\\\ \\frac{1}{2}(x+7)^{-1/2}+\\frac{1}{2}(y+2)^{-1/2}(\\frac{\\text{d}y}{\\text{d}x}) & =0 \\\\ \\frac{1}{2}(y+2)^{-1/2}(\\frac{\\text{d}y}{\\text{d}x}) & =-\\frac{1}{2}(x+7)^{-1/2} \\\\ \\frac{1}{2\\sqrt{y+2}}(\\frac{\\text{d}y}{\\text{d}x}) & =-\\frac{1}{2\\sqrt{x+7}} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{\\sqrt{y+2}}{\\sqrt{x+7}}\\end{aligned}\n$$\n\nThe slope of the tangent at the point $(2,\\,7)$ is then given by\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{(2,\\,7)} \\\\  & ={(-\\frac{\\sqrt{y+2}}{\\sqrt{x+7}})|}_{(2,\\,7)} \\\\  & =-\\frac{\\sqrt{7+2}}{\\sqrt{2+7}} \\\\  & =-\\frac{\\sqrt{9}}{\\sqrt{9}} \\\\  & =-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233921 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bcc75f9-63cb-52ca-bb8c-372d2be966bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186232855}] :answer-field/correct {:answer/id #uuid "0bcc75f9-63cb-52ca-bb8c-372d2be966bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186232855} :answer-field/id #uuid "35502148-dde5-5c8b-8e2d-a2a692207452" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232854}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a60708d4-334c-5573-85a8-fee34ba1a832" :question/math-academy-id "q-341926" :question/problem "Find the slope $m$ of the tangent at the point $(1,4)$ for the curve ${x}^{3}y=4x.$\n\n$m=$\n{{field-1}}" :question/worked-solution "To find the slope at a point, we use implicit differentiation to calculate the derivative of the curve, assuming that $y=y(x).$\n\nNote that to differentiate the ${x}^{3}y$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}{x}^{3}y & =4x \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{3}y) & =\\frac{\\text{d}}{\\text{d}x}(4x) \\\\ 3{x}^{2}y+{x}^{3}\\frac{\\text{d}y}{\\text{d}x} & =4 \\\\ {x}^{3}\\frac{\\text{d}y}{\\text{d}x} & =4-3{x}^{2}y \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{4-3{x}^{2}y}{{x}^{3}}\\end{aligned}\n$$\n\nThe slope of the tangent at the point $(1,4)$ is then given by\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{(1,4)} \\\\  & ={(\\frac{4-3{x}^{2}y}{{x}^{3}})|}_{(1,4)} \\\\  & =\\frac{4-3(1)^{2}(4)}{(1)^{3}} \\\\  & =\\frac{(-8)}{1} \\\\  & =-8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233922 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c156430-b610-5668-8439-825eec4d1577" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}x+4" :db/id #edb/ref 17592186232857}] :answer-field/correct {:answer/id #uuid "3c156430-b610-5668-8439-825eec4d1577" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}x+4" :db/id #edb/ref 17592186232857} :answer-field/id #uuid "df46a02e-6253-57ba-830d-793de97c2fa4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232856}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2696ff34-02c9-509b-8c55-939fb2e23341" :question/math-academy-id "q-342066" :question/problem "Given a curve $x={y}^{2}-2y\\sqrt{y},$ what is the equation of the tangent to the curve at the point $(0,4)?$\n\n$y=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}({y}^{2}-2y\\sqrt{y}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}({y}^{2})-2\\frac{\\text{d}}{\\text{d}y}(y\\sqrt{y}) \\\\  & =2y-2\\frac{\\text{d}}{\\text{d}y}(y\\cdot {y}^{1/2})-0 \\\\  & =2y-2\\frac{\\text{d}}{\\text{d}y}({y}^{3/2}) \\\\  & =2y-2\\cdot \\frac{3}{2}{y}^{1/2} \\\\  & =2y-3{y}^{1/2} \\\\  & =2y-3\\sqrt{y}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{1}{2y-3\\sqrt{y}}.\n$$\n\nThe slope of the tangent to the curve at the point $(0,4)$ is\n\n$$\n\\begin{aligned}m & =\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(0,4)} \\\\  & =\\frac{1}{2(4)-3\\sqrt{4}} \\\\  & =\\frac{1}{8-6} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nUsing the point-slope formula for a tangent line, we get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-4 & =\\frac{1}{2}(x-0) \\\\ y & =\\frac{1}{2}x+4.\\end{aligned}\n$$"}]
