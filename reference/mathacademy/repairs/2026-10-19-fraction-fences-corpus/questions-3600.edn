pi }{4}+\\operatorname{cos}⁡x\\operatorname{sin}⁡\\frac{7\\pi }{4} \\\\  & =\\operatorname{sin}⁡x\\cdot (\\frac{\\sqrt{2}}{2})+\\operatorname{cos}⁡x\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{\\sqrt{2}}{2}\\,\\operatorname{sin}⁡x-\\frac{\\sqrt{2}}{2}\\,\\operatorname{cos}⁡x \\\\  & =\\frac{\\sqrt{2}}{2}\\,\\operatorname{sin}⁡x-\\frac{\\sqrt{2}}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186304998 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f822acb5-ecac-5f49-b866-51e4b3f931d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186304010}] :answer-field/correct {:answer/id #uuid "f822acb5-ecac-5f49-b866-51e4b3f931d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186304010} :answer-field/id #uuid "1ed13432-5e59-56ca-8d4b-ec53c607d7c9" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304151} {:answer-field/choices [{:answer/id #uuid "95222c59-a1bc-52c3-a480-7a68d8df4df8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186303381}] :answer-field/correct {:answer/id #uuid "95222c59-a1bc-52c3-a480-7a68d8df4df8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186303381} :answer-field/id #uuid "51b53ffe-e010-5741-9c93-865cbe86ea58" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304300}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "78623ec6-7143-54b5-8ec3-a1bf17721f5e" :question/math-academy-id "q-332191" :question/problem "Express $\\operatorname{sin}⁡(x-\\frac{7\\pi }{6})$ in terms of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x.$\n\n$\\operatorname{sin}⁡(x-\\frac{7\\pi }{6})=$\n{{field-1}}$\\operatorname{sin}⁡x\\,+$\n{{field-2}}$\\operatorname{cos}⁡x$" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v=\\frac{7\\pi }{6},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x-\\frac{7\\pi }{6}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡(\\frac{7\\pi }{6})-\\operatorname{cos}⁡x\\operatorname{sin}⁡(\\frac{7\\pi }{6}) \\\\  & =\\operatorname{sin}⁡x\\cdot (-\\frac{\\sqrt{3}}{2})-\\operatorname{cos}⁡x\\cdot (-\\frac{1}{2}) \\\\  & =-\\frac{\\sqrt{3}\\operatorname{sin}⁡x}{2}+\\frac{\\operatorname{cos}⁡x}{2} \\\\  & =-\\frac{\\sqrt{3}}{2}\\,\\operatorname{sin}⁡x+\\frac{1}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186304999 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "162361a3-dbb8-55f1-8044-208f8dd3353a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186302599}] :answer-field/correct {:answer/id #uuid "162361a3-dbb8-55f1-8044-208f8dd3353a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186302599} :answer-field/id #uuid "0dd25f35-a51b-5083-921b-43c9ceede301" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304099} {:answer-field/choices [{:answer/id #uuid "4f2b7c23-5b66-5dce-ab8d-359a56f7bc9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186302952}] :answer-field/correct {:answer/id #uuid "4f2b7c23-5b66-5dce-ab8d-359a56f7bc9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186302952} :answer-field/id #uuid "48d7149c-fafc-5466-a016-dc86da34b333" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304277}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f6d9223e-755f-520e-aa29-e860e8e723c3" :question/math-academy-id "q-332195" :question/problem "Express $\\operatorname{sin}⁡(x-\\frac{5\\pi }{3})$ in terms of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x.$\n\n$\\operatorname{sin}⁡(x-\\frac{5\\pi }{3})=$\n{{field-1}}$\\operatorname{sin}⁡x\\,+$\n{{field-2}}$\\operatorname{cos}⁡x$" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v=\\frac{5\\pi }{3},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x-\\frac{5\\pi }{3}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡(\\frac{5\\pi }{3})-\\operatorname{cos}⁡x\\operatorname{sin}⁡(\\frac{5\\pi }{3}) \\\\  & =\\operatorname{sin}⁡x\\cdot \\frac{1}{2}-\\operatorname{cos}⁡x\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =\\frac{\\operatorname{sin}⁡x}{2}+\\frac{\\sqrt{3}\\operatorname{cos}⁡x}{2} \\\\  & =\\frac{1}{2}\\,\\operatorname{sin}⁡x+\\frac{\\sqrt{3}}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186305020 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13a27733-ae3e-5d29-837c-05dccc75e005" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.066" :db/id #edb/ref 17592186302586}] :answer-field/correct {:answer/id #uuid "13a27733-ae3e-5d29-837c-05dccc75e005" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.066" :db/id #edb/ref 17592186302586} :answer-field/id #uuid "cf5f7311-ab17-54e7-8e5f-438c11ddcd2a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304639}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "720d9b9e-459a-5820-84a2-68055ba82c56" :question/math-academy-id "q-332319" :question/problem "A bag contains $10$ balls numbered $1$ through $10.$ One ball is randomly selected, its number is recorded, and then it is placed back in the bag before the next selection. The process is repeated until the ball numbered $10$ is selected. Rounded to $3$ decimal places, the probability that it will take exactly $5$ selections is{{field-1}}." :question/worked-solution "A geometric random variable $X$ with probability of success $p$ has the following probability mass function:\n\n$$\nf(x)=(1-p)^{x-1}p\n$$\n\nLet $X$ be the number of selections until the ball numbered $10$ came on. The probability of getting a ball numbered $10$ on any single selection is\n\n$$\np=\\frac{1}{10}.\n$$\n\nSo, the number of selections until the ball numbered $10$ came up can be modeled as a geometric random variable with a probability of success $p=\\frac{1}{10}.$\n\nSo, $X∼\\text{Geom}(\\frac{1}{10}).$ In this case, $X$ has the following probability mass function:\n\n$$\n\\begin{aligned}f(x) & ={(1-\\frac{1}{10})}^{x-1}(\\frac{1}{10}) \\\\  & ={(\\frac{9}{10})}^{x-1}(\\frac{1}{10})\\end{aligned}\n$$\n\nTherefore, the probability of getting a ball numbered $10$ on the $5$th selection is\n\n$$\n\\begin{aligned}P(X=5) & =f(5) \\\\  & ={(\\frac{9}{10})}^{5-1}(\\frac{1}{10}) \\\\  & ={(\\frac{9}{10})}^{4}(\\frac{1}{10}) \\\\  & ≈0.066,\\end{aligned}\n$$\n\n \nrounded to $3$ decimal places."} {:db/id #edb/ref 17592186305025 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa099851-646a-5448-a9f4-7669c29075bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.216" :db/id #edb/ref 17592186303505}] :answer-field/correct {:answer/id #uuid "aa099851-646a-5448-a9f4-7669c29075bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.216" :db/id #edb/ref 17592186303505} :answer-field/id #uuid "b0b55fa5-5e9d-53c5-a21f-9799cd92636c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304555}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ac860a6a-b0e9-53ea-a402-4f5d52f1de41" :question/math-academy-id "q-332354" :question/problem "A board game uses a special deck of $10$ cards: $4$ cards show a star and $6$ cards show a circle. A player randomly draws a card, records the symbol, and then puts the card back into the deck before drawing again. The player keeps drawing until they get a star card. Rounded to $3$ decimal places, the probability of getting a star card after the third draw is{{field-1}}." :question/worked-solution "A geometric random variable $X$ with probability of success $p$ has the following probability mass function:\n\n$$\nf(x)=(1-p)^{x-1}p\n$$\n\nLet $X$ be the number of cards drawn until a star card is obtained. The chance of selecting a star card from the deck is \n\n$$\np=\\frac{4}{10}=\\frac{2}{5}=0.4.\n$$\n\nSo, the number of selections before obtaining a star card can be modeled as a geometric random variable with a probability of success $p=\\frac{2}{5}.$\n\nSo, $X∼\\text{Geom}(\\frac{2}{5}).$ In this case, $X$ has the following probability mass function:\n\n$$\n\\begin{aligned}f(x) & ={(1-\\frac{2}{5})}^{x-1}(\\frac{2}{5}) \\\\  & ={(\\frac{3}{5})}^{x-1}(\\frac{2}{5})\\end{aligned}\n$$\n\nTo compute $P(X>3),$ we will use the complement:\n\n$$\nP(X>3)=1-P(X\\le 3)\n$$\n\nComputing the probability of the complement, we get\n\n$$\n\\begin{aligned}P(X\\le 3) & =P(X\\in {1,2,3}) \\\\  & =f(1)+f(2)+f(3) \\\\  & ={(\\frac{3}{5})}^{1-1}(\\frac{2}{5})+{(\\frac{3}{5})}^{2-1}(\\frac{2}{5})+{(\\frac{3}{5})}^{3-1}(\\frac{2}{5}) \\\\  & =(\\frac{2}{5})+(\\frac{3}{5})(\\frac{2}{5})+{(\\frac{3}{5})}^{2}(\\frac{2}{5}) \\\\  & =[1+(\\frac{3}{5})+{(\\frac{3}{5})}^{2}](\\frac{2}{5}) \\\\  & =[1+\\frac{3}{5}+\\frac{9}{25}](\\frac{2}{5}) \\\\  & =0.784.\\end{aligned}\n$$\n\nTherefore, the probability of getting a star card after the third draw is\n\n$$\n\\begin{aligned}P(X>3) & =1-P(X\\le 3) \\\\  & =1-0.784 \\\\  & =0.216.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186305029 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0672ee69-6e30-57e0-9c8f-0ab639085b4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1041" :db/id #edb/ref 17592186302496}] :answer-field/correct {:answer/id #uuid "0672ee69-6e30-57e0-9c8f-0ab639085b4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1041" :db/id #edb/ref 17592186302496} :answer-field/id #uuid "a7d219c1-62ed-53c0-9796-7586f5404b9e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304536}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4fab6883-0393-5f3c-90fe-c90066e575a7" :question/math-academy-id "q-332367" :question/problem "Given $X∼\\text{Geom}(\\frac{2}{7}),$ compute $P(X=4).$  Round your final answer to $4$ decimal places.\n\n$P(X=4)≈$\n{{field-1}}" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)={\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(\\frac{2}{7}),$ so the distribution of $X$ in this case is\n\n$$\nf(x)={\\begin{aligned}{(\\frac{5}{7})}^{x-1}(\\frac{2}{7}), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X=4) & =f(4) \\\\  & ={(\\frac{5}{7})}^{3}(\\frac{2}{7}) \\\\  & ≈0.1041.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186305031 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f052b0fe-687d-52fa-a1a6-da56a6fd2c11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-150" :db/id #edb/ref 17592186303959}] :answer-field/correct {:answer/id #uuid "f052b0fe-687d-52fa-a1a6-da56a6fd2c11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-150" :db/id #edb/ref 17592186303959} :answer-field/id #uuid "2d295907-f684-59db-8996-710fa573f8d3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304185} {:answer-field/choices [{:answer/id #uuid "ee87cf2a-7198-5f6f-8882-95e403985d1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186303952}] :answer-field/correct {:answer/id #uuid "ee87cf2a-7198-5f6f-8882-95e403985d1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186303952} :answer-field/id #uuid "713e4f8e-8e3e-5b89-ac1b-c3be6ab66f8c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304386}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8b86135d-d2a6-5d52-b069-fcc60a9a34a2" :question/math-academy-id "q-332377" :question/problem "Expressed in **ascending order** in degrees, the exact solutions to the equation $\\operatorname{sin}⁡x=-\\frac{1}{2},$ for $-{180}^{∘}<x\\le {180}^{∘},$ are\n\n$x=$\n{{field-1}}${}^{∘},\\,x=$\n{{field-2}}${}^{∘}.$" :question/worked-solution "First, we find the principal value:\n\n$$\nx=\\operatorname{arcsin}⁡(-\\frac{1}{2})=-{30}^{∘}\n$$\n\nSince $-{30}^{∘}$ lies inside the domain, our first solution is ${x}_{1}=-{30}^{∘}.$\n\nOur first solution lies in the fourth quadrant and has a reference angle of ${\\theta }_{R}={30}^{∘}.$ Since $\\operatorname{sin}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}={30}^{∘}.$\n\n![](images/1b/1b1a3d9a84ba0d6da8d5c2c21a91a6027b1b57e520be7c886ecf5da1a9de1ee0.png)\n\nA second solution $X$ lies in the $3$rd quadrant, and we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}X & ={180}^{∘}+{\\theta }_{R} \\\\  & ={180}^{∘}+{30}^{∘} \\\\  & ={210}^{∘}\\end{aligned}\n$$\n\nHowever, this value is not in the required domain. To get the second solution ${x}_{2}$ that's within the given domain, we simply subtract ${360}^{∘}:$\n\n$$\n\\begin{aligned}{x}_{2} & =X-{360}^{∘} \\\\  & ={210}^{∘}-{360}^{∘} \\\\  & =-{150}^{∘}\\end{aligned}\n$$\n\nSo, in ascending order, the solutions are:\n\n$$\nx=-{150}^{∘},\\,x=-{30}^{∘}.\n$$"} {:db/id #edb/ref 17592186305032 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a78e1f08-81dc-56d7-a04f-3c51ab550543" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186303484}] :answer-field/correct {:answer/id #uuid "a78e1f08-81dc-56d7-a04f-3c51ab550543" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186303484} :answer-field/id #uuid "01d91f89-603f-57d9-9f66-d33804486102" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304073} {:answer-field/choices [{:answer/id #uuid "5e67b214-f7e3-50af-a7d3-6280e697be4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.6" :db/id #edb/ref 17592186303032}] :answer-field/correct {:answer/id #uuid "5e67b214-f7e3-50af-a7d3-6280e697be4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.6" :db/id #edb/ref 17592186303032} :answer-field/id #uuid "39ce1c72-3e68-589d-9284-0e0b0b24e494" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304230}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8d80151d-28be-554f-8db1-04fcba7015ea" :question/math-academy-id "q-332380" :question/problem "Expressed in **ascending order** in radians, rounded to one decimal place, the solutions to the equation $\\operatorname{sin}⁡x=\\frac{3}{5},$ for $-\\pi <x\\le \\pi ,$  are\n\n$x≈$\n{{field-1}}$,\\,x≈$\n{{field-2}}." :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arcsin}⁡(\\frac{3}{5})=0.643\\,501…≈0.6435\\end{aligned}\n$$\n\nSince $0.6435$ lies inside the given domain, our first solution is ${x}_{1}=0.6435.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}=0.6435.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has a reference angle ${\\theta }_{R}=0.6435.$\n\n![](images/96/962545fd6fa64e121a99eb8bf684484e4b457dbd4defedd7c07ae88fd47cac6e.png)\n\nSince the second solution ${x}_{2}$ lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi -{\\theta }_{R} \\\\  & =\\pi -0.6435 \\\\  & ≈2.4981.\\end{aligned}\n$$\n\nSo, in ascending order, rounded to one decimal place, the solutions are \n\n$$\nx≈0.6,\\,x≈2.5.\n$$"} {:db/id #edb/ref 17592186305039 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f4e419df-6c04-5fb6-983e-5a12894b3f2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186303994}] :answer-field/correct {:answer/id #uuid "f4e419df-6c04-5fb6-983e-5a12894b3f2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186303994} :answer-field/id #uuid "c0bc25a8-5b64-525f-8ec1-18bacb29b0aa" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304603}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "688375ae-4d98-550a-942a-dba16a7b32d6" :question/math-academy-id "q-332499" :question/problem "Using the fact that $-{210}^{∘}={30}^{∘}-{240}^{∘},$\ncalculate the **exact** value of $\\operatorname{cos}⁡(-{210}^{∘}).$\n\n$\\operatorname{cos}⁡(-{210}^{∘})=$\n{{field-1}}" :question/worked-solution "Recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(x-y)=\\operatorname{cos}⁡x\\operatorname{cos}⁡y+\\operatorname{sin}⁡x\\operatorname{sin}⁡y\n$$\n\nApplying the sum formula for cosine with $x={30}^{∘}$ and $y={240}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(-{210}^{∘}) & =\\operatorname{cos}⁡({30}^{∘}-{240}^{∘}) \\\\  & =\\operatorname{cos}⁡({30}^{∘})\\operatorname{cos}⁡({240}^{∘})+\\operatorname{sin}⁡({30}^{∘})\\operatorname{sin}⁡({240}^{∘}) \\\\  & =\\frac{\\sqrt{3}}{2}\\cdot (-\\frac{1}{2})+\\frac{1}{2}\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{\\sqrt{3}}{4}-\\frac{\\sqrt{3}}{4} \\\\  & =-\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186305040 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "78d68719-808d-5c96-8823-ede601d60c3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186303201}] :answer-field/correct {:answer/id #uuid "78d68719-808d-5c96-8823-ede601d60c3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186303201} :answer-field/id #uuid "5b7a6a54-a207-5c6f-a167-5212208b730e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304323} {:answer-field/choices [{:answer/id #uuid "e265154d-2846-5c73-9b2c-3032dccaebda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186303867}] :answer-field/correct {:answer/id #uuid "e265154d-2846-5c73-9b2c-3032dccaebda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186303867} :answer-field/id #uuid "e9c27aa3-de65-5df1-a326-e77c56fbd9e9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304709}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "57caa789-b53a-5a9a-be02-c0fc7c2fa0f5" :question/math-academy-id "q-332505" :question/problem "Express $\\operatorname{cos}⁡(x+{225}^{∘})$ in terms of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x.$\n\n$\\operatorname{cos}⁡(x+{225}^{∘})=$\n{{field-1}}$\\operatorname{sin}⁡x\\,-$\n{{field-2}}$\\operatorname{cos}⁡x$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for cosine with $u=x$ and $v={225}^{∘}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x+{225}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{225}^{∘}-\\operatorname{sin}⁡x\\operatorname{sin}⁡{225}^{∘} \\\\  & =\\operatorname{cos}⁡x(-\\frac{\\sqrt{2}}{2})-\\operatorname{sin}⁡x(-\\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{\\sqrt{2}}{2}\\,\\operatorname{sin}⁡x-\\frac{\\sqrt{2}}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186305041 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21588051-09e7-52bc-922a-4c601338e896" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186302665}] :answer-field/correct {:answer/id #uuid "21588051-09e7-52bc-922a-4c601338e896" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186302665} :answer-field/id #uuid "43a68a7a-f0fd-55ce-bd28-8fe668c6fefc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304261} {:answer-field/choices [{:answer/id #uuid "c67796f1-25f8-53dc-9438-27b25765a327" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186303675}] :answer-field/correct {:answer/id #uuid "c67796f1-25f8-53dc-9438-27b25765a327" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186303675} :answer-field/id #uuid "a1af87bc-f28e-5ecd-b7fd-a2b71c80774c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304514}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2b649318-6a87-59c0-9956-57644ebbbe75" :question/math-academy-id "q-332508" :question/problem "Express $\\operatorname{cos}⁡(x+{315}^{∘})$ in terms of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x.$\n\n$\\operatorname{cos}⁡(x+{315}^{∘})=$\n{{field-1}}$\\operatorname{sin}⁡x\\,+$\n{{field-2}}$\\operatorname{cos}⁡x$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for cosine with $u=x$ and $v={315}^{∘}$, we get\n\n$$\n\\begin{aligned}\\opera