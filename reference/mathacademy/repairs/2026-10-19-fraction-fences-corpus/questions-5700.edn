[{:db/id #edb/ref 17592186396641 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a78c53fe-7a34-5039-b641-d5a142a89c47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471179} {:answer/id #uuid "4f461872-36ec-5c59-87fb-2d8f9a29da63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471180}] :answer-field/correct {:answer/id #uuid "4f461872-36ec-5c59-87fb-2d8f9a29da63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471180} :answer-field/id #uuid "d5d1b6ec-1e62-53fb-96e6-65d382550c1f" :answer-field/key "$A={n\\in Z\\,:\\,\\operatorname{cos}⁡(\\frac{n\\pi }{2})=1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472095} {:answer-field/choices [{:answer/id #uuid "be2134e8-6687-593d-b8a2-0e747258ee25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471181} {:answer/id #uuid "f8579e8a-8d00-5f47-a7ea-c0a769301cf3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471182}] :answer-field/correct {:answer/id #uuid "f8579e8a-8d00-5f47-a7ea-c0a769301cf3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471182} :answer-field/id #uuid "2a66bd15-3e80-5812-b65d-815d34cb91e2" :answer-field/key "$B={q\\in Q\\,:\\,\\operatorname{cos}⁡(\\frac{q\\pi }{2})=1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472096} {:answer-field/choices [{:answer/id #uuid "3d156001-448a-51d4-9757-160b74ad2880" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471183} {:answer/id #uuid "24a53af9-2edd-5906-9b83-441ea090b440" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471184}] :answer-field/correct {:answer/id #uuid "24a53af9-2edd-5906-9b83-441ea090b440" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471184} :answer-field/id #uuid "a892cbac-9499-5bf9-b0f7-031f81a43c5c" :answer-field/key "$C={x\\in R\\,:\\,\\operatorname{cos}⁡(\\frac{x\\pi }{2})=1}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472097}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0e72e5e7-5d89-539b-aadc-437975100b51" :question/math-academy-id "q-181670" :question/problem "Which of the following sets are infinite?\n\nSelect all that apply." :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements.\n\nWe start by finding the solutions to the equation $\\operatorname{cos}⁡(\\frac{x\\pi }{2})=1$ for $x\\in R:$\n\n$$\n\\begin{aligned}\\frac{x\\pi }{2} & =2m\\pi  \\\\ x & =4m,\\,m\\in Z\\end{aligned}\n$$\n\nWith that in mind, let's examine our sets:\n\n- The set $A$ is infinite. Listing the elements of $B$ for different values of $m,$ we have\n\n$$\nA={…,-4,0,4,8,…}.\n$$\n\n- The set $B$ is infinite. Since $A$ is infinite, and $A⊆B,$ it follows that $B$ is infinite.\n\n- The set $C$ is infinite. Since $B$ is infinite, and $B⊆C,$ it follows that $C$ is infinite.\n\nTherefore, the correct answer is \"$A,$ $B,$ and $C.$\""} {:db/id #edb/ref 17592186396792 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e527463f-8290-5ced-ad81-399453d89115" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "the absorption property" :db/id #edb/ref 1759218