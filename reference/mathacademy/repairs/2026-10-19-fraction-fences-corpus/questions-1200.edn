ac{x-1}{\\sqrt{5}})+C" :db/id #edb/ref 17592186538234} {:answer/id #uuid "0b113bca-9912-5f35-96fa-95493e21f318" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{arsech}⁡(\\frac{x-1}{\\sqrt{5}})+C" :db/id #edb/ref 17592186538260} {:answer/id #uuid "3609cd87-57e2-52fc-984f-43d3f16611ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{5}}\\operatorname{arcsch}⁡(\\frac{x-1}{\\sqrt{5}})+C" :db/id #edb/ref 17592186538341} {:answer/id #uuid "682ec881-b5df-5663-8b1e-5632a85fd8d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arcsch}⁡(\\frac{x-1}{\\sqrt{5}})+C" :db/id #edb/ref 17592186538466} {:answer/id #uuid "6d80edc0-9454-51f1-b687-a8321c5ca78a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{5}}\\operatorname{arsech}⁡(\\frac{x-1}{\\sqrt{5}})+C" :db/id #edb/ref 17592186538478}] :answer-field/correct {:answer/id #uuid "0b113bca-9912-5f35-96fa-95493e21f318" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{arsech}⁡(\\frac{x-1}{\\sqrt{5}})+C" :db/id #edb/ref 17592186538260} :answer-field/id #uuid "8e78c2b7-cba3-5a4d-950c-d6f7840d0864" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186166316}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7347b447-f057-5855-9436-49c47183f8c6" :question/math-academy-id "q-97776" :question/problem "$\\int \\frac{\\sqrt{5}}{(x-1)\\sqrt{4+2x-{x}^{2}}}\\text{d}x=$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-{x}^{2}+2x+4 & =-({x}^{2}-2x-4) \\\\  & =-({x}^{2}-2\\cdot x+{1}^{2}-{1}^{2}-4) \\\\  & =-((x-1)^{2}-5) \\\\  & =5-(x-1)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\sqrt{5}}{(x-1)\\sqrt{4+2x-{x}^{2}}} & =\\int \\frac{\\sqrt{5}}{(x-1)\\sqrt{5-{(x-1)}^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{(\\frac{x-1}{\\sqrt{5}})\\sqrt{5-5{(\\frac{x-1}{\\sqrt{5}})}^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{\\sqrt{5}}\\int \\frac{1}{(\\frac{x-1}{\\sqrt{5}})\\sqrt{1-{(\\frac{x-1}{\\sqrt{5}})}^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nLet $u=\\frac{x-1}{\\sqrt{5}}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{\\sqrt{5}}\\,⟹\\,\\text{d}x=\\sqrt{5}\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{\\sqrt{5}}{(x-1)\\sqrt{4+2x-{x}^{2}}}\\text{d}x & =\\frac{1}{\\sqrt{5}}\\int \\frac{1}{(\\frac{x-1}{\\sqrt{5}})\\sqrt{1-{(\\frac{x-1}{\\sqrt{5}})}^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{\\sqrt{5}}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\cdot \\sqrt{5}\\,\\text{d}u \\\\  & =\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =-\\operatorname{arsech}⁡u+C \\\\  & =-\\operatorname{arsech}⁡(\\frac{x-1}{\\sqrt{5}})+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186167519 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a53a977-08c6-5df9-a860-2371d7ca93a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{arcsch}⁡(x+\\frac{1}{2})+C" :db/id #edb/ref 17592186538428} {:answer/id #uuid "a541d1ea-9725-5c0d-81a6-8717209ba023" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arsech}⁡(x+\\frac{1}{2})+C" :db/id #edb/ref 17592186538627} {:answer/id #uuid "ac30b210-151b-52ec-9f43-9946b5b6bd5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{arcsch}⁡(x+\\frac{1}{2})+C" :db/id #edb/ref 17592186538637} {:answer/id #uuid "e5e11cb3-9047-5ff4-947e-2cd0cb49d427" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}\\operatorname{arcsch}⁡(x+\\frac{1}{2})+C" :db/id #edb/ref 17592186538755} {:answer/id #uuid "f5fa1e27-e6e7-5ee2-8cfd-06752c595b70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{arsech}⁡(x+\\frac{1}{2})+C" :db/id #edb/ref 17592186538790}] :answer-field/correct {:answer/id #uuid "ac30b210-151b-52ec-9f43-9946b5b6bd5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{arcsch}⁡(x+\\frac{1}{2})+C" :db/id #edb/ref 17592186538637} :answer-field/id #uuid "cffcc18d-04b4-520c-afc2-9502fc33eeb7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186166322}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d0b115b9-4f73-5fd8-99ef-72eedb4e4a17" :question/math-academy-id "q-97903" :question/problem "$\\int \\frac{2}{|2x+1|\\sqrt{4{x}^{2}+4x+5}}\\text{d}x=$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}4{x}^{2}+4x+5 & =4({x}^{2}+x+\\frac{5}{4}) \\\\  & =4({x}^{2}+2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2}-{(\\frac{1}{2})}^{2}+\\frac{5}{4}) \\\\  & =4[{(x+\\frac{1}{2})}^{2}+1]\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{2}{|2x+1|\\sqrt{4{x}^{2}+4x+5}}\\,\\text{d}x=\\int \\frac{1}{|x+\\frac{1}{2}|\\sqrt{4[1+{(x+\\frac{1}{2})}^{2}]}}\\,\\text{d}x=\\frac{1}{2}\\int \\frac{1}{|x+\\frac{1}{2}|\\sqrt{1+{(x+\\frac{1}{2})}^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nLet $u=x+\\frac{1}{2}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{1}{2}\\int \\frac{1}{|x+\\frac{1}{2}|\\sqrt{1+{(x+\\frac{1}{2})}^{2}}}\\,\\text{d}x & =\\frac{1}{2}\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\operatorname{arcsch}⁡u+C \\\\  & =-\\frac{1}{2}\\operatorname{arcsch}⁡(x+\\frac{1}{2})+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186167544 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "655616af-26c7-5045-9c00-22ddde224244" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}⟨1,1,0⟩" :db/id #edb/ref 17592186361294} {:answer/id #uuid "7d4f75ae-d6ad-5a3c-91cb-30e81c920d26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{{t}^{2}+1}}⟨0,1,t⟩" :db/id #edb/ref 17592186361390} {:answer/id #uuid "991991bb-1478-585f-92cd-d50366a4e536" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{{t}^{2}+4}}⟨-2,t,0⟩" :db/id #edb/ref 17592186361520} {:answer/id #uuid "b70d3730-f7e4-550d-8e7c-aaa70734dfad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,0,0⟩" :db/id #edb/ref 17592186361653} {:answer/id #uuid "db90d517-2caf-5377-83c7-89e38b72b976" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,0,-1⟩" :db/id #edb/ref 17592186361814}] :answer-field/correct {:answer/id #uuid "db90d517-2caf-5377-83c7-89e38b72b976" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,0,-1⟩" :db/id #edb/ref 17592186361814} :answer-field/id #uuid "4efaf2f0-5db1-5f94-9975-e72a5434ef99" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362053}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "38a9961c-14c0-5e12-92b6-0fd05f67f8cd" :question/math-academy-id "q-99504" :question/problem "Find the binormal vector to the curve $r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{\\sqrt{{t}^{2}+4}}⟨t,2,0⟩.\\end{aligned}\n$$\n\nNote that $T$ denotes the unit tangent vector." :question/worked-solution "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t),\n$$\n\nwhere the principal normal vector $N(t)$ is given by\n\n$$\nN(t)=\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}.\n$$\n\nFirst, we find the principal normal $N(t).$ To do this, we calculate ${T}^{′}(t)$ and its magnitude as follows:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\frac{t}{\\sqrt{{t}^{2}+4}}),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{2}{\\sqrt{{t}^{2}+4}}),\\,\\frac{\\text{d}}{\\text{d}t}(0)⟩ \\\\  & =⟨\\frac{4}{({t}^{2}+4)^{3/2}},\\,-\\frac{2t}{({t}^{2}+4)^{3/2}},\\,0⟩ \\\\ ‖{T}^{′}(t)‖ & =\\frac{1}{({t}^{2}+4)^{3/2}}\\sqrt{(4)^{2}+{(-2t)}^{2}+{(0)}^{2}} \\\\  & =\\frac{1}{({t}^{2}+4)^{3/2}}\\sqrt{16+4{t}^{2}} \\\\  & =\\frac{2}{({t}^{2}+4)^{3/2}}\\sqrt{{t}^{2}+4} \\\\  & =\\frac{2}{{t}^{2}+4}\\end{aligned}\n$$\n\nNow, we normalize ${T}^{′}(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}=\\frac{\\frac{1}{({t}^{2}+4)^{3/2}}⟨4,\\,-2t,\\,0⟩}{(\\frac{2}{{t}^{2}+4})}=\\frac{1}{\\sqrt{{t}^{2}+4}}⟨2,\\,-t,\\,0⟩\\end{aligned}\n$$\n\nFinally, we calculate the binormal vector, as follows:\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{\\sqrt{{t}^{2}+4}}⟨t,2,0⟩\\times \\frac{1}{\\sqrt{{t}^{2}+4}}⟨2,\\,-t,\\,0⟩ \\\\  & =\\frac{1}{{t}^{2}+4}\\,\\left|\\begin{aligned}i & j & k \\\\ t & 2 & 0 \\\\ 2 & -t & 0\\end{aligned}\\right| \\\\  & =\\frac{1}{{t}^{2}+4}[\\text{ }\\left|\\begin{aligned}2 & 0 \\\\ -t & 0\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}t & 0 \\\\ 2 & 0\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}t & 2 \\\\ 2 & -t\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{{t}^{2}+4}⟨0+0,-(0-0),-{t}^{2}-4⟩ \\\\  & =\\frac{1}{{t}^{2}+4}⟨0,\\,0,\\,-({t}^{2}+4)⟩ \\\\  & =⟨0,0,-1⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186171690 :question/id #uuid "b48b1e81-1bfa-5236-b43d-edf2c44503d2" :question/math-academy-id "e-11000" :question/problem "If $\\sin x = \\dfrac{1}2$, then what is $-2\\sin(x+6\\pi)-3$?" :question/worked-solution "The period of $y = \\sin x$ is $2\\pi$. Therefore, for any integer $n$ we have\n\n$$\n\\sin{x} = \\sin{(x+2n\\pi)}\n$$\n\nSubstituting $n=3$ into the above gives\n\n$$\n\\begin{aligned}\n\\sin x &= \\sin (x + 2 \\cdot 3 \\cdot π) \\\\\n&= \\sin (x + 6π)\n\\end{aligned}\n$$\n\nTherefore, if\n\n$$\n\\sin{x} = \\dfrac{1}{2}\n$$\n\nthen\n\n$$\n\\sin{(x+6\\pi)} = \\dfrac{1}{2}\n$$\n\nFinally, then:\n\n$$\n\\begin{aligned}\n-2\\sin (x + 6π) - 3 &= -2(\\frac{1}{2}) - 3 \\\\\n&=-1 - 3 \\\\\n&=-4\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186171691 :question/id #uuid "5aeb80cf-cd16-5823-977f-60dbadbdab73" :question/math-academy-id "e-11001" :question/problem "If $\\sin{x} = -\\dfrac{4}{7}$, then what is the value of $\\sin(-x + 16 \\pi)$?" :question/worked-solution "First, let's recall the graph of\n\n$$\ny = \\sin{x}\n$$\n\n![](images/08/08d442eff9febe44bd39e6c15c998d76d56d17bbb7a676d2d511771479bb2f29.png)\n\nFrom the graph, we note the following:\n\n- The period of $\\sin{x}$ is $2\\pi$.\n- Our graph has rotational symmetry of order $2$ about the origin. This means that $\\sin{x}$ is an *odd* function, and we have\n$\\sin(-x) = -\\sin{x}$.\n\nLet's now evaluate our expression:\n\n- Firstly, using the periodicity of $\\sin{x}$, we have\n$\\sin (-x + 16π)|= \\sin (-x + 2π \\cdot 8); = \\sin (-x)$.\n- Secondly, using the oddness of $\\sin{x}$, we have\n$\\sin (-x)|=-\\sin x; = - (-\\frac{4}{7}); = \\frac{4}{7}$.\n\nTherefore,\n\n$$\n\\sin(-x + 16\\pi) = \\dfrac{4}{7}\n$$"} {:db/id #edb/ref 17592186171744 :question/id #uuid "5f47fd84-fda1-5eba-b32e-53b07a391b3d" :question/math-academy-id "e-14748" :question/problem "Do the following sets have the same cardinality? If so, why?\n\n$$\nA = \\mathbb{N}, \\qquad B = \\left\\{1,\\, \\dfrac12,\\,  \\dfrac14,\\,  \\dfrac18,\\,  \\ldots \\right \\}\n$$" :question/worked-solution "Two sets $A$ and $B$ have the *same cardinality* if there exists a bijection between $A$ and $B.$\n\nNotice that the elements of $B$ form an (infinite) geometric sequence with a common ratio $r=\\dfrac12{:}$\n\n$$\n\\begin{aligned}r & =\\frac{1}{2} \\\\  & =\\frac{(\\frac{1}{2})}{1} \\\\  & =\\frac{(\\frac{1}{4})}{(\\frac{1}{2})} \\\\  & =⋯\\end{aligned}\n$$\n\nThe $n$th term of our geometric sequence, denoted $a_n,$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & =1\\cdot {(\\frac{1}{2})}^{n-1} \\\\  & ={(\\frac{1}{2})}^{n-1}.\\end{aligned}\n$$\n\nTherefore, we can express $B$ in set-builder notation as \n\n$$\nB = \\left\\{  \\left(\\dfrac12\\right)^{n-1} \\,  \\Bigg |\\:  n \\in \\mathbb{N}  \\right\\}.\n$$\n\nNow, consider the function $f: A \\to B$ that maps the underlying sets as follows: \n\n| $A$ | $1$ | $2$ | $3$ | $4$ | $\\cdots$ | $n$ | $\\cdots$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $B$ | $1$ | $\\dfrac12$ | $\\dfrac14$ | $\\dfrac18$ | $\\cdots$ | $\\left(\\dfrac12\\right)^{n-1}$ | $\\cdots$ |\n\nIn general, for each $n \\in A,$ we have $f(n) =   \\left(\\dfrac12\\right)^{n-1} \\in B.$\n\nNotice that $f$ is described in such a way that it is bijective. Indeed, it's\n\n- injective since $f(n) \\neq f(m)$ whenever $n \\neq m,$ and\n\n- surjective since each element in $B$ (the second row) has a pre-image in $A$ (the first row).\n\nTherefore, $|A| = |B|,$ i.e., the sets have the same cardinality."} {:db/id #edb/ref 17592186171767 :question/id #uuid "008dea21-d434-524e-ba21-aefa78b7d5f9" :question/math-academy-id "e-15122" :question/problem "Consider a normal population with unknown mean and standard deviation. Let $I_1$ be a $95\\%$ confidence interval for the population mean $\\mu$ obtained from a sample of size $n_1$ using as an estimate for the standard deviation $s_1=5$, calculated from a previous study.\n\nSuppose we require a second $98\\%$ confidence interval $I_2$ to have the same length as $I_1$, obtained using a different estimate $s_2=3$. Find the relative size of the second sample $n_2$ we should use to construct $I_2$.\n\n*Hint: Given a random variable $Z \\sim N(0,1)$, the table below shows the $z$-scores $z_p$ such that $P(Z > z_p) = p$ for some particular values of $p$.*\n\n| $p$ | $0.100$ | $0.050$ | $0.025$ | $0.010$ | $0.005$ |\n| --- | ---: | ---: | ---: | ---: | ---: |\n| $z_p$ | $1.282$ | $1.645$ | $1.960$ | $2.326$ | $2.576$ |" :question/worked-solution "Given a value $\\alpha$ between $0$ and $1$, the corresponding $[100(1-\\alpha)]\\%$ confidence interval for the population mean $\\mu$ can be written as\n\n$$\n\\overline{x} \\pm \\overbrace{z_{\\alpha/2} \\cdot \\dfrac{\\sigma}{\\sqrt n}}^{\\large \\textrm{margin of error}}\n$$\n\nwhere\n\n- $\\!\\overline{\\,x}$ is the sample mean,\n- $n$ is the sample size,\n- $\\sigma$ is the population standard deviation, and\n- $P(Z > z_{\\alpha/2}) = \\dfrac{\\alpha}{2}$ and $Z \\sim N(0,1)$.\n\nLet $\\varepsilon_1$ and $\\varepsilon_2$ be the margins of error of $I_1$ and $I_2$, respectively. Since we want $I_2$ to be equal to $I_1$, we must have\n\n$$\n\\varepsilon_1 = \\varepsilon_2\n$$\n\nThen, we have\n\n$$\nz_{0.025} \\cdot \\dfrac{s_1}{\\sqrt{n_1}} = z_{0.01} \\cdot \\dfrac{s_2}{\\sqrt{n_2}}\n$$\n\nSolving for\n\n$$\n\\dfrac{n_2}{n_1}\n$$\n\nwe get\n\n$$\n\\begin{aligned}\n\\frac{\\sqrt{n_{2}}}{\\sqrt{n_{1}}} &= \\frac{z_{0.01} \\cdot s_{2}}{z_{0.025} \\cdot s_{1}} \\\\\n(\\frac{\\sqrt{n_{2}}}{\\sqrt{n_{1}}})^{2} &= (\\frac{z_{0.01} \\cdot s_{2}}{z_{0.025} \\cdot s_{1}})^{2} \\\\\n\\frac{n_{2}}{n_{1}} &= \\frac{z_{0.01}^{2} \\cdot s_{2}^{2}}{z_{0.025}^{2} \\cdot s_{1}^{2}}\n\\end{aligned}\n$$\n\nNow, using the fact that\n\n$$\ns_1 = 5, s_2 = 3, z_{0.01} = 2.326, z_{0.25} = 1.960\n$$\n\nwe have\n\n$$\n\\begin{aligned}\n\\frac{n_{2}}{n_{1}} &= \\frac{2.326^{2} \\cdot 3^{2}}{1.960^{2} \\cdot 5^{2}} \\approx 0.507\n\\end{aligned}\n$$\n\nwhich gives\n\n$$\nn_1\\approx 1.97 n_2\n$$\n\nTherefore, $n_2$ must be $\\bbox[3pt,Gainsboro]{\\color{blue}\\text{smaller}}$ than $n_1$ by a factor of approximately $\\bbox[3pt,Gainsboro]{\\color{blue}1.97}$."} {:db/id #edb/ref 17592186171809 :question/id #uuid "587f0594-4911-5ad7-9f1a-bd33cfbad3fc" :question/math-academy-id "e-5109" :question/problem "Which expression is missing in the following equation?\n\n$$\n\\displaystyle{4 \\choose 3} = \\displaystyle{3 \\choose 2} + \\displaystyle{\\left[ \\phantom{3 \\choose 3}\\right]}\n$$" :question/worked-solution "To find $\\displaystyle{\\color{red}{4} \\choose {\\color{blue}3}},$ we need to find the number that is located in row $\\color{red}4$ and position $\\color{blue}3$ of Pascal's triangle. \n\n**Important:** Remember that when counting the rows and positions in Pascal's triangle, we always start counting from zero!\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe location of $\\displaystyle{4 \\choose 3}$ in Pascal's triangle is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  &  & (\\frac{0}{0}) \\\\  &  &  &  &  &  & (\\frac{1}{0}) &  & (\\frac{1}{1}) \\\\  &  &  &  &  & (\\frac{2}{0}) &  & (\\frac{2}{1}) &  & (\\frac{2}{2}) \\\\  &  &  &  & (\\frac{3}{0}) &  & (\\frac{3}{1}) &  & (\\frac{3}{2}) &  & (\\frac{3}{3}) \\\\  &  &  & (\\frac{4}{0}) &  & (\\frac{4}{1}) &  & (\\frac{4}{2}) &  & (\\frac{4}{3}) &  & (\\frac{4}{4}) \\\\  &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nNow, $\\displaystyle{4 \\choose 3}$ is the sum of the two closest numbers located in the previous row. So\n\n$$\n\\displaystyle{4 \\choose 3} = \\displaystyle{3 \\choose 2} + \\displaystyle{3 \\choose 3}.\n$$\n\nTherefore, the missing expression is $\\displaystyle{3 \\choose 3}.$"} {:db/id #edb/ref 17592186171810 :question/id #uuid "9f9efb07-33a0-5a28-8eef-656a3c00a200" :question/math-academy-id "e-5231" :question/problem "Determine the value of $\\displaystyle{5 \\choose 4}.$" :question/worked-solution "The binomial coefficient $\\displaystyle{n \\choose r}$ is given by the formula\n\n$$\n\\displaystyle{n \\choose r} = \\dfrac{n!}{(n-r)!\\,  r!}.\n$$\n\nIn this case, we have $n = 5$ and $r = 4.$ Therefore,\n\n$$\n\\begin{aligned}(\\frac{5}{4}) & =\\frac{5!}{(5-4)!\\cdot 4!} \\\\  & =\\frac{5\\cdot 4!}{1!\\cdot 4!} \\\\  & =\\frac{5\\cdot \\cancel{4!}}{1\\cdot \\cancel{4!}} \\\\  & =5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186171824 :question/id #uuid "a7f9f74b-e213-5f38-8cb2-b9352ee515ad" :question/math-academy-id "e-7471" :question/problem "Calculate the coordinates of the vertex of the parabola $5x^2 -10x - 4y - 7 = 0.$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^2 = 4p(y-k),\n$$\n\nwhere $p$ is a constant.\n\nTo write the given equation in this form, we need to group the $x$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}5{x}^{2}-10x-4y-7 & =0 \\\\ 5{x}^{2}-10x & =4y+7 \\\\ 5[{x}^{2}-2x] & =4y+7 \\\\ 5[(x-1)^{2}-1] & =4y+7 \\\\ 5(x-1)^{2}-5 & =4y+7 \\\\ 5(x-1)^{2} & =4y+7+5 \\\\ 5(x-1)^{2} & =4y+12 \\\\ 5(x-1)^{2} & =4(y+3) \\\\ (x-1)^{2} & =\\frac{4}{5}(y+3) \\\\ (x-1)^{2} & =4(\\frac{1}{5})(y+3)\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are $(h,k) = (1,-3).$"} {:db/id #edb/ref 17592186171836 :question/id #uuid "58f6a3e7-e867-576a-ad84-0debbbc38d90" :question/math-academy-id "e-8381" :question/problem "What type of quadratic curve is defined by the following equation?\n\n$$\n3x_1^2 + 2x_1 - x_2 =\\dfrac{5}{3}\n$$" :question/worked-solution "First, we complete the square for the variable $x_1\\mathbin{:}$  \n\n$$\n\\begin{aligned}3{x}_{1}^{2}+2{x}_{1}-{x}_{2} & =\\frac{5}{3} \\\\ 3({x}_{1}^{2}+\\frac{2}{3}{x}_{1})-{x}_{2} & =\\frac{5}{3} \\\\ 3({x}_{1}^{2}+\\frac{2}{3}{x}_{1}+{(\\frac{1}{3})}^{2}-{(\\frac{1}{3})}^{2})-{x}_{2} & =\\frac{5}{3} \\\\ 3{({x}_{1}+\\frac{1}{3})}^{2}-3{(\\frac{1}{3})}^{2}-{x}_{2} & =\\frac{5}{3} \\\\ 3{({x}_{1}+\\frac{1}{3})}^{2}-\\frac{1}{3}-{x}_{2} & =\\frac{5}{3} \\\\ 3{({x}_{1}+\\frac{1}{3})}^{2} & ={x}_{2}+2\\end{aligned}\n$$\n\nNow, performing the change of variables\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &={x}_{1}+\\frac{1}{3}, \\\\ {y}_{2} &={x}_{2}+2,\\end{aligned}\\right.\n$$\n\nwe get the following:\n\n$$\n\\begin{aligned}3{y}_{1}^{2} & ={y}_{2} \\\\ {y}_{1}^{2} & =\\frac{1}{3}{y}_{2}\\end{aligned}\n$$\n\n \n\nThis represents a parabola that opens in the direction of the positive $y_2$-axis."} {:db/id #edb/ref 17592186171871 :question/id #uuid "5d084f86-9874-5bdd-a416-dba742d7e4e5" :question/math-academy-id "e-8952" :question/problem "Calculate $\\Gamma \\left( \\dfrac{5}{2} \\right).$" :question/worked-solution "To evaluate the gamma function at multiples of one-half, we use the following recursive formula:\n\n$$\n\\Gamma(z+1) = z \\Gamma(z), \\qquad \\Gamma \\left( \\dfrac{1}{2} \\right) = \\sqrt{\\pi}\n$$\n\nSo, we have the following:\n\n$$\n\\begin{aligned}Γ(\\frac{5}{2}) & =\\frac{3}{2}Γ(\\frac{3}{2}) \\\\  & =\\frac{3}{2}\\cdot \\frac{1}{2}Γ(\\frac{1}{2}) \\\\  & =\\frac{3}{2}\\cdot \\frac{1}{2}\\sqrt{\\pi } \\\\  & =\\frac{3}{4}\\sqrt{\\pi }\\end{aligned}\n$$"} {:db/id #edb/ref 17592186171895 :question/id #uuid "f6f11512-c37f-5922-b642-5290003b1d91" :question/math-academy-id "e-9492" :question/problem "![](images/cd/cd1ba2536264e122c84377a1892c3ca86dd8f273b2eab9ba0e2c53eeb504ef65.png)\n\n  \n\nFind a definite integral with respect to $\\theta$ that's equivalent to $\\displaystyle\\int_C\\,\\textrm d s,$ where $C$ is the path along the polar curve $r=1-\\sin{\\theta}\\,$ for $0 \\leq \\theta \\leq  \\pi,$ shown above." :question/worked-solution "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n\\int_C \\,\\textrm d s = L.\n$$\n\nIn polar coordinates, the arc length element $\\textrm d s$ is given by\n\n$$\n\\textrm ds = \\sqrt{r^2 +\\left(\\frac{\\textrm{d}r}{\\textrm{d}\\theta}\\right)^2 }\\,\\textrm{d}\\theta.\n$$\n\nSo, for a polar curve defined as $r = r(\\theta)$ for $\\theta_1 \\leq \\theta \\leq \\theta_2,$ we have\n\n$$\nL=\t\\int_C \\,\\textrm d s =  \\int_{\\theta_1}^{\\theta_2} \\sqrt{r^2 +\\left(\\frac{\\textrm{d}r}{\\textrm{d}\\theta}\\right)^2 }\\,\\textrm{d}\\theta.\n$$\n\nSince $r=1-\\sin{\\theta},$ we have\n\n$$\n\\dfrac{\\textrm{d}r}{\\textrm{d}\\theta} = -\\cos{\\theta}.\n$$\n\nTherefore, the expression for our line integral is\n\n$$\n\\begin{aligned}{\\int }_{C}\\,\\text{d}s & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{(1-\\operatorname{sin}⁡\\theta )}^{2}+{(-\\operatorname{cos}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{1-2\\operatorname{sin}⁡\\theta +{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{2-2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =\\sqrt{2}{\\int }_{0}^{\\pi }\\sqrt{1-\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta \\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186171896 :question/id #uuid "6753365e-9915-5be9-9a6d-d4c40b2caea0" :question/math-academy-id "e-9493" :question/problem "![](images/a5/a55339eae9b193813ab696538c85696ad5f4267e2e31513bdb2c8998cd711311.png)\n\n  \n\nCalculate $\\displaystyle\\int_C\\,\\textrm d s,$ where $C$ is the path along the polar curve $r=2(1+\\sin\\theta)$ for $0 \\leq \\theta \\leq {\\pi},$ shown above." :question/worked-solution "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n\\int_C \\,\\textrm d s = L.\n$$\n\nIn polar coordinates, the arc length element $\\textrm d s$ is given by\n\n$$\n\\textrm ds = \\sqrt{r^2 +\\left(\\frac{\\textrm{d}r}{\\textrm{d}\\theta}\\right)^2 }\\,\\textrm{d}\\theta.\n$$\n\nSo, for a polar curve defined as $r = r(\\theta)$ for $\\theta_1 \\leq \\theta \\leq \\theta_2,$ we have\n\n$$\nL=\t\\int_C \\,\\textrm d s =  \\int_{\\theta_1}^{\\theta_2} \\sqrt{r^2 +\\left(\\frac{\\textrm{d}r}{\\textrm{d}\\theta}\\right)^2 }\\,\\textrm{d}\\theta.\n$$\n\nSince $r=2(1+\\sin\\theta),$ we have\n\n$$\n\\dfrac{\\textrm{d}r}{\\textrm{d}\\theta} = 2\\cos{\\theta}.\n$$\n\nTherefore, we evaluate our line integral as follows:\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{4(1+\\operatorname{sin}⁡\\theta )^{2}+4{(\\operatorname{cos}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{\\pi }\\sqrt{1+2\\operatorname{sin}⁡\\theta +{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{\\pi }\\sqrt{1+2\\operatorname{sin}⁡\\theta +1}\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{\\pi }\\sqrt{2+2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =2\\sqrt{2}{\\int }_{0}^{\\pi }\\sqrt{1+\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta \\end{aligned}\n$$\n\nNext, we recall the following identities:\n\n$$\n\\begin{aligned}{sin}^{2}⁡(\\frac{\\theta }{2})+{cos}^{2}⁡(\\frac{\\theta }{2})=1,\\,\\operatorname{sin}⁡\\theta =2\\operatorname{sin}⁡(\\frac{\\theta }{2})\\operatorname{cos}⁡(\\frac{\\theta }{2})\\end{aligned}\n$$\n\nRewriting our integral using the above identities, we can evaluate it as follows:\n\n$$\n\\begin{aligned}L & =2\\sqrt{2}{\\int }_{0}^{\\pi }\\sqrt{1+\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =2\\sqrt{2}{\\int }_{0}^{\\pi }\\sqrt{{sin}^{2}⁡(\\frac{\\theta }{2})+{cos}^{2}⁡(\\frac{\\theta }{2})+2\\operatorname{sin}⁡(\\frac{\\theta }{2})\\operatorname{cos}⁡(\\frac{\\theta }{2})}\\,\\text{d}\\theta  \\\\  & =2\\sqrt{2}{\\int }_{0}^{\\pi }\\sqrt{{(\\operatorname{sin}⁡(\\frac{\\theta }{2})+\\operatorname{cos}⁡(\\frac{\\theta }{2}))}^{2}}\\,\\text{d}\\theta  \\\\  & =2\\sqrt{2}{\\int }_{0}^{\\pi }|\\operatorname{sin}⁡(\\frac{\\theta }{2})+\\operatorname{cos}⁡(\\frac{\\theta }{2})|\\,\\text{d}\\theta  \\\\  & =4\\sqrt{2}{[-\\operatorname{cos}⁡(\\frac{\\theta }{2})+\\operatorname{sin}⁡(\\frac{\\theta }{2})]}_{0}^{\\pi } \\\\  & =4\\sqrt{2}(-\\operatorname{cos}⁡(\\frac{\\pi }{2})+\\operatorname{sin}⁡(\\frac{\\pi }{2}))-(-\\operatorname{cos}⁡(0)+\\operatorname{sin}⁡(0)) \\\\  & =4\\sqrt{2}((0+1)-(-1+0)) \\\\  & =8\\sqrt{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186171909 :question/id #uuid "3912c570-ae90-5d82-b7ee-3adc26f7f4af" :question/math-academy-id "e-9885" :question/problem "The displacement $\\mathbf r,$ in meters, of a particle $P$ of mass $3\\,\\textrm{kg}$ is given by\n\n$$\n\\mathbf r =  \\langle 3\\cos{t}-\\sin{t},\\: 2\\cos{t}\\rangle,\n$$\n\nwhere $t\\gt 0$ is the time in seconds. Calculate the resultant force acting on the particle when $t=\\dfrac{3\\pi}{4}\\,\\textrm s.$" :question/worked-solution "Newton’s second law states that\n\n$$\n\\mathbf F = m \\mathbf a,\n$$\n\n \nwhere $\\mathbf F$ is the *resultant* force, $m$ is the mass, and $\\mathbf a$ is the acceleration.\n\nTo compute the acceleration vector, we first differentiate $\\mathbf r$ to get the velocity vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t-\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)⟩ \\\\  & =⟨-3\\operatorname{sin}⁡t-\\operatorname{cos}⁡t,\\,-2\\operatorname{sin}⁡t⟩\\end{aligned}\n$$\n\nNext, we differentiate the velocity vector to get the acceleration vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(-3\\operatorname{sin}⁡t-\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(-2\\operatorname{sin}⁡t)⟩ \\\\  & =⟨-3\\operatorname{cos}⁡t+\\operatorname{sin}⁡t,\\,-2\\operatorname{cos}⁡t⟩\\end{aligned}\n$$\n\nTherefore, the resultant force $\\mathbf F$ at time $t$ equals\n\n$$\n\\begin{aligned}F & =ma \\\\  & =3\\cdot ⟨-3\\operatorname{cos}⁡t+\\operatorname{sin}⁡t,\\,-2\\operatorname{cos}⁡t⟩ \\\\  & =⟨3\\operatorname{sin}⁡t-9\\operatorname{cos}⁡t,\\,-6\\operatorname{cos}⁡t⟩.\\end{aligned}\n$$\n\nFinally, when $t = \\dfrac{3\\pi}{4}\\,\\textrm s,$ we have\n\n$$\n\\begin{aligned}F(\\frac{3\\pi }{4}) & =⟨3\\operatorname{sin}⁡(\\frac{3\\pi }{4})-9\\operatorname{cos}⁡(\\frac{3\\pi }{4}),\\,-6\\operatorname{cos}⁡(\\frac{3\\pi }{4})⟩ \\\\  & =⟨\\frac{3\\sqrt{2}}{2}+\\frac{9\\sqrt{2}}{2},\\,\\frac{6\\sqrt{2}}{2}⟩ \\\\  & =⟨6\\sqrt{2},\\,3\\sqrt{2}⟩.\\end{aligned}\n$$\n\nTherefore, we conclude that the resultant force acting on $P$ when $t=\\dfrac{3\\pi}{4}\\,\\textrm s$ equals $\\left\\langle 6\\sqrt{2},\\: 3\\sqrt{2}\\right\\rangle\\,\\textrm N.$"} {:db/id #edb/ref 17592186172231 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57f6601b-563c-5b31-a64c-7ec8c55ad32b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{8}\\sqrt{\\pi }" :db/id #edb/ref 17592186432618} {:answer/id #uuid "680dd59f-269a-5239-be6c-db7639bc6aff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{8}\\sqrt{\\pi }" :db/id #edb/ref 17592186432625} {:answer/id #uuid "6c60091c-6a50-58f6-8506-d0161e3cbf8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{4}\\sqrt{\\pi }" :db/id #edb/ref 17592186432626} {:answer/id #uuid "afc4fe46-ebb9-53be-a4db-c19fc81cfcc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{7}\\sqrt{\\pi }" :db/id #edb/ref 17592186432644} {:answer/id #uuid "e8402d97-f15b-5b34-be19-f1b09c6f80c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{6}\\sqrt{\\pi }" :db/id #edb/ref 17592186432664}] :answer-field/correct {:answer/id #uuid "680dd59f-269a-5239-be6c-db7639bc6aff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{8}\\sqrt{\\pi }" :db/id #edb/ref 17592186432625} :answer-field/id #uuid "15d1edb6-5522-5f3e-9a34-d393c62a2da0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186168249}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "985175a0-3817-5f02-8236-9b18519858f8" :question/math-academy-id "q-105737" :question/problem "Evaluate $Γ(\\frac{7}{2}).$" :question/worked-solution "To evaluate the gamma function at multiples of one-half, we use the following recursive formula:\n\n$$\nΓ(z+1)=zΓ(z),\\,Γ(\\frac{1}{2})=\\sqrt{\\pi }\n$$\n\nSo, we have the following:\n\n$$\n\\begin{aligned}Γ(\\frac{7}{2}) & =\\frac{5}{2}Γ(\\frac{5}{2}) \\\\  & =\\frac{5}{2}\\cdot \\frac{3}{2}Γ(\\frac{3}{2}) \\\\  & =\\frac{5}{2}\\cdot \\frac{3}{2}\\cdot \\frac{1}{2}Γ(\\frac{1}{2}) \\\\  & =\\frac{5}{2}\\cdot \\frac{3}{2}\\cdot \\frac{1}{2}\\sqrt{\\pi } \\\\  & =\\frac{15}{8}\\sqrt{\\pi }\\end{aligned}\n$$"} {:db/id #edb/ref 17592186172235 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b367d3ad-bb24-5bad-ab86-f66b9d3043d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\sqrt{π}" :db/id #edb/ref 17592186168274} {:answer/id #uuid "c5539f4c-97cb-552d-b15f-a690555d4c23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{π}" :db/id #edb/ref 17592186168275} {:answer/id #uuid "0a160ea2-163a-54a0-bce8-410058de71ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{π}" :db/id #edb/ref 17592186168276} {:answer/id #uuid "56d47025-c197-5474-8213-65096f747ac7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt{π}" :db/id #edb/ref 17592186168277} {:answer/id #uuid "73bb7a3d-3df6-530c-910a-432596a099e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}\\sqrt{π}" :db/id #edb/ref 17592186168278}] :answer-field/id #uuid "d6769a1d-3919-5d01-a653-0366af50c7b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186168273}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4e482d16-749d-58c9-8ef6-b26f04eebbb7" :question/math-academy-id "q-107764" :question/problem "What is $Γ(\\frac{1}{2}) + Γ(\\frac{3}{2})$?"} {:db/id #edb/ref 17592186172274 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b37f815-69e9-5f1e-9c62-4a6ed82da6a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-1)" :db/id #edb/ref 17592186250924} {:answer/id #uuid "4a368124-0d01-5818-a452-6cd091e09815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,3)" :db/id #edb/ref 17592186251170} {:answer/id #uuid "6a26be98-0aef-5a51-bca6-58adc676c0e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,3)" :db/id #edb/ref 17592186251425} {:answer/id #uuid "6ee6b668-ccb3-53dc-86e1-9666b077a249" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-1)" :db/id #edb/ref 17592186251457} {:answer/id #uuid "a8408a74-d250-5b83-97a6-711d103381bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-3)" :db/id #edb/ref 17592186252007}] :answer-field/correct {:answer/id #uuid "a8408a74-d250-5b83-97a6-711d103381bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-3)" :db/id #edb/ref 17592186252007} :answer-field/id #uuid "ef0e9e67-bf6e-5236-8fc8-d1ae8a6d7a36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253223}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "330d0d52-2b13-5441-8452-b279bf17bf67" :question/math-academy-id "q-11883" :question/problem "Calculate the coordinates of the vertex of the parabola $3{x}^{2}+6x+4y+15=0.$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nwhere $p$ is constant.\n\nTo write the given equation in this form, we need to group the $x$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}3{x}^{2}+6x+4y+15 & =0 \\\\ 3{x}^{2}+6x & =-4y-15 \\\\ 3[{x}^{2}+2x] & =-4y-15 \\\\ 3[(x+1)^{2}-1] & =-4y-15 \\\\ 3(x+1)^{2}-3 & =-4y-15 \\\\ 3(x+1)^{2} & =-4y-15+3 \\\\ 3(x+1)^{2} & =-4y-12 \\\\ 3(x+1)^{2} & =-4(y+3) \\\\ (x+1)^{2} & =-\\frac{4}{3}(y+3) \\\\ (x+1)^{2} & =4(-\\frac{1}{3})(y+3)\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are $(h,k)=(-1,-3).$"} {:db/id #edb/ref 17592186172286 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d0a4588a-a70a-5752-b2c8-01cc42d39edf" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/27/271bcaebb02bc573b2d6c3b00758387ff1a49787270c137f7e69ed3223e7de2b.png" :db/id #edb/ref 17592186168580} {:answer/id #uuid "3eb7e952-7f56-56d6-875d-d7fd08e13aac" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/33/33c6c3680f3cab38ffd1508fad160948f3bc1159c01dc287b3fe113c0cf89875.png" :db/id #edb/ref 17592186168581} {:answer/id #uuid "5f0e3626-c59b-53de-817d-5c6c8128a918" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/21/21fc0f3e9a2d5100421953ef2270de9d8a99fb395d761b4eb9a3f9f0e1889ac3.png" :db/id #edb/ref 17592186168582} {:answer/id #uuid "7951f9ae-9706-5dfa-82a5-3cfe79b73cef" :answer/type 