17592186045498 :db/ident :answer.type/math} :answer/value "36\\,000" :db/id #edb/ref 17592186387017} {:answer/id #uuid "606b60d6-6925-52a7-9990-45232a53c94a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "69\\,300" :db/id #edb/ref 17592186387018} {:answer/id #uuid "a7eef4c8-eeed-522e-a869-4cc328c34fe0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49\\,500" :db/id #edb/ref 17592186387019} {:answer/id #uuid "b67293a3-a05b-5dd0-b551-121096a709c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "79\\,200" :db/id #edb/ref 17592186387020} {:answer/id #uuid "d14149ef-09e5-57ac-afbe-9dbe9e2ee161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "63\\,000" :db/id #edb/ref 17592186387021}] :answer-field/correct {:answer/id #uuid "606b60d6-6925-52a7-9990-45232a53c94a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "69\\,300" :db/id #edb/ref 17592186387018} :answer-field/id #uuid "96f86185-7829-51c3-a1ea-36683535a8d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387016}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "398ff4f2-a514-55ba-ad0a-235934ea5e85" :question/math-academy-id "q-120532" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{csc}⁡x+3=-1-\\operatorname{csc}⁡x$ for ${0}^{∘}\\le x<{360}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "First, we rearrange the equation, isolating $\\operatorname{csc}⁡x:$\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡x+3 & =-1-\\operatorname{csc}⁡x \\\\ 2\\operatorname{csc}⁡x & =-4 \\\\ \\operatorname{csc}⁡x & =-2\\end{aligned}\n$$\n\nRecall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=-\\frac{1}{2}.\n$$\n\nNow, we find the principal value: \n\n$$\nx=\\text{arcsin}(-\\frac{1}{2})=-{30}^{∘}\n$$\n\nThis value is outside the required domain. To get a value inside the range, we add ${360}^{∘}.$ \n\n$$\n{x}_{1}=x+{360}^{∘}=-{30}^{∘}+{360}^{∘}={330}^{∘}.\n$$\n\nSo,  our first solution is ${x}_{1}={330}^{∘}.$\n\nOur first solution lies in the fourth quadrant and has a reference angle of ${\\theta }_{R}={30}^{∘}.$ Since $\\operatorname{sin}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}={30}^{∘}.$\n\n![](images/b3/b3c523e882baf0b3a105e10131091e40de686b4c1483f46e7bdc235e30743a6d.png)\n\nSince the second solution ${x}_{2}$ lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}+{\\theta }_{R} \\\\  & ={180}^{∘}+{30}^{∘} \\\\  & ={210}^{∘}\\end{aligned}\n$$\n\nSo, the solutions are $x={210}^{∘},{330}^{∘}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=210\\cdot 330=69\\,300.\n$$"} {:db/id #edb/ref 17592186387112 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8036d2c2-8a2e-5c67-acd1-ce0e9d47e6fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(\\frac{\\pi }{2})=⟨1,-1⟩" :db/id #edb/ref 17592186387114} {:answer/id #uuid "582500e4-c596-5232-81dc-6bc6fbee7997" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(\\frac{\\pi }{2})=⟨-1,1⟩" :db/id #edb/ref 17592186387115} {:answer/id #uuid "bcd5aa7c-be5e-513f-828f-f8fb25908e12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(\\frac{\\pi }{2})=⟨1,0⟩" :db/id #edb/ref 17592186387116} {:answer/id #uuid "fadb5133-1e74-501b-977e-8689bedac6f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(\\frac{\\pi }{2})=⟨-1,0⟩" :db/id #edb/ref 17592186387117} {:answer/id #uuid "362aaed2-f0c6-53a7-88e5-52f5c57042ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(\\frac{\\pi }{2})=⟨0,1⟩" :db/id #edb/ref 17592186387118}] :answer-field/correct {:answer/id #uuid "bcd5aa7c-be5e-513f-828f-f8fb25908e12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(\\frac{\\pi }{2})=⟨1,0⟩" :db/id #edb/ref 17592186387116} :answer-field/id #uuid "8f4aa5c5-7aa5-5947-9569-21ed1cfb107b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387113}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "741539b0-f482-543c-8cda-1da90dd97aaf" :question/math-academy-id "q-121720" :question/problem "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨-\\operatorname{cos}⁡t,\\operatorname{sin}⁡t⟩,\\,t>0.\n$$\n\nCalculate the velocity vector $v$ at time $t=\\frac{\\pi }{2}.$" :question/worked-solution "The particle's velocity vector is given by the derivative of its position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(-\\operatorname{cos}⁡t),\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)⟩ \\\\  & =⟨\\operatorname{sin}⁡t,\\operatorname{cos}⁡t⟩\\end{aligned}\n$$\n\nTo find the velocity when $t=\\frac{\\pi }{2},$ we substitute into the above:\n\n$$\n\\begin{aligned}v(\\frac{\\pi }{2}) & =⟨\\operatorname{sin}⁡(\\frac{\\pi }{2}),\\operatorname{cos}⁡(\\frac{\\pi }{2})⟩ \\\\  & =⟨1,0⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186387126 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cdbf7fc9-f5ad-56e7-bc07-5c375f28c1e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186387128} {:answer/id #uuid "cde1e1d2-30cc-5d8f-a36d-b2478fabf989" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186387129} {:answer/id #uuid "fe24b444-bd1d-59b6-9483-48d4cfc27308" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186387130} {:answer/id #uuid "114f469d-69f7-56f7-af0f-17247ed2f5eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{5}\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186387131} {:answer/id #uuid "b6822baa-7945-54b5-ae74-9fae4b5bacf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt{2}\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186387132}] :answer-field/correct {:answer/id #uuid "114f469d-69f7-56f7-af0f-17247ed2f5eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{5}\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186387131} :answer-field/id #uuid "fe313015-93be-5870-b93a-eda3958c82aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387127}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "accdf36e-4deb-5652-9073-b1834a2b81f8" :question/math-academy-id "q-121917" :question/problem "The velocity vector $v=⟨u,v⟩,$ measured in $\\text{m}/\\text{s},$ of a particle $P$ at time $t$ seconds is given by\n\n$$\nv=⟨-2\\sqrt{2}\\operatorname{cos}⁡2t,\\sqrt{2}\\operatorname{sin}⁡2t⟩.\n$$\n\nFind the magnitude of the acceleration of $P$ at time $t=\\frac{\\pi }{8}.$" :question/worked-solution "To compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(-2\\sqrt{2}\\operatorname{cos}⁡2t),\\frac{\\text{d}}{\\text{d}t}(\\sqrt{2}\\operatorname{sin}⁡2t)⟩ \\\\  & =⟨4\\sqrt{2}\\operatorname{sin}⁡2t,2\\sqrt{2}\\operatorname{cos}⁡2t⟩\\end{aligned}\n$$\n\nTo find the acceleration at time $t=\\frac{\\pi }{8},$ we substitute $t=\\frac{\\pi }{8}$ into the above:\n\n$$\n\\begin{aligned}a(\\frac{\\pi }{8}) & =⟨4\\sqrt{2}\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{8}),2\\sqrt{2}\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{8})⟩ \\\\  & =⟨4\\sqrt{2}\\operatorname{sin}⁡(\\frac{\\pi }{4}),2\\sqrt{2}\\operatorname{cos}⁡(\\frac{\\pi }{4})⟩ \\\\  & =⟨4\\sqrt{2}\\cdot \\frac{\\sqrt{2}}{2},2\\sqrt{2}\\cdot \\frac{\\sqrt{2}}{2}⟩ \\\\  & =⟨4,2⟩\\end{aligned}\n$$\n\nFinally, to find the magnitude of the acceleration, we compute $|a(\\frac{\\pi }{8})|:$ \n\n$$\n\\begin{aligned}|a(\\frac{\\pi }{8})| & =|⟨4,2⟩| \\\\  & =\\sqrt{{4}^{2}+{2}^{2}} \\\\  & =\\sqrt{16+4} \\\\  & =\\sqrt{20} \\\\  & =2\\sqrt{5}\\,{\\text{m/s}}^{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186387133 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27c5cc12-791b-582c-8800-d09d9e5897f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2{ln}^{2}⁡2+1}}{4}\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186387135} {:answer/id #uuid "9be7db96-b0e3-5250-88bf-48d61a4a5e74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{4{ln}^{2}⁡2+1}}{2}\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186387136} {:answer/id #uuid "9d84db7f-e242-5a70-9af3-9ff09623f1f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{4\\operatorname{ln}⁡2+1}}{4}\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186387137} {:answer/id #uuid "cfbe2b31-7baa-5eb2-bdb4-0ffb641710c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{ln}^{2}⁡2+1}}{2}\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186387138} {:answer/id #uuid "659484fc-53c0-5be7-b82b-841304443bed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2\\operatorname{ln}⁡2+1}}{2}\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186387139}] :answer-field/correct {:answer/id #uuid "9be7db96-b0e3-5250-88bf-48d61a4a5e74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{4{ln}^{2}⁡2+1}}{2}\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186387136} :answer-field/id #uuid "8f2a8aab-97b6-54d8-b857-404581a4b724" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387134}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2b79ce39-e3a6-5781-a9e4-71c93eee0b44" :question/math-academy-id "q-121920" :question/problem "The velocity vector $v=⟨u,v⟩,$ measured in $\\text{m}/\\text{s},$ of a particle $P$ at time $t$ seconds is given by\n\n$$\nv=⟨{2}^{t-1},\\frac{1}{{t}^{2}+1}⟩.\n$$\n\nFind the magnitude of the acceleration of $P$ at time $t=1.$" :question/worked-solution "To compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}({2}^{t-1}),\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{{t}^{2}+1})⟩ \\\\  & =⟨{2}^{t-1}\\operatorname{ln}⁡2,-\\frac{2t}{({t}^{2}+1)^{2}}⟩\\end{aligned}\n$$\n\nTo find the acceleration at time $t=1,$ we substitute $t=1$ into the above:\n\n$$\n\\begin{aligned}a(1) & =⟨{2}^{1-1}\\operatorname{ln}⁡2,-\\frac{2(1)}{({1}^{2}+1)^{2}}⟩ \\\\  & =⟨{2}^{0}\\operatorname{ln}⁡2,-\\frac{2}{4}⟩ \\\\  & =⟨\\operatorname{ln}⁡2,-\\frac{1}{2}⟩\\end{aligned}\n$$\n\nFinally, to find the magnitude of the acceleration, we compute $|a(1)|:$ \n\n$$\n\\begin{aligned}|a(1)| & =|⟨\\operatorname{ln}⁡2,-\\frac{1}{2}⟩| \\\\  & =\\sqrt{(\\operatorname{ln}⁡2)^{2}+{(-\\frac{1}{2})}^{2}} \\\\  & =\\sqrt{{ln}^{2}⁡2+\\frac{1}{4}} \\\\  & =\\sqrt{\\frac{4{ln}^{2}⁡2+1}{4}} \\\\  & =\\frac{\\sqrt{4{ln}^{2}⁡2+1}}{2}\\,{\\text{m/s}}^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186387161 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e82d2cb6-1575-5905-9fba-e43762d5c85a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a(1)=⟨\\frac{1}{2},16⟩" :db/id #edb/ref 17592186387163} {:answer/id #uuid "d009dbe1-bfc5-5925-96e6-d5179636b515" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a(1)=⟨-\\frac{1}{4},12⟩" :db/id #edb/ref 17592186387164} {:answer/id #uuid "8da048ba-d720-5e3b-a6d5-25d0ac604a20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a(1)=⟨-\\frac{1}{2},24⟩" :db/id #edb/ref 17592186387165} {:answer/id #uuid "eb4ca4f6-98b5-5a6e-ba81-d4fb6c5420bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a(1)=⟨-\\frac{1}{4},24⟩" :db/id #edb/ref 17592186387166} {:answer/id #uuid "35940c79-f66a-5ec8-864b-f082d00f5c33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a(1)=⟨\\frac{1}{2},12⟩" :db/id #edb/ref 17592186387167}] :answer-field/correct {:answer/id #uuid "eb4ca4f6-98b5-5a6e-ba81-d4fb6c5420bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a(1)=⟨-\\frac{1}{4},24⟩" :db/id #edb/ref 17592186387166} :answer-field/id #uuid "30e79d04-f822-521e-8366-34b8cce431a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387162}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "84c7731a-fdb1-5923-b13d-b64da6ea7881" :question/math-academy-id "q-121936" :question/problem "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨\\operatorname{ln}⁡(t+1),2{t}^{4}+3⟩,\\,t>0.\n$$\n\nCalculate the acceleration vector $a$ at time $t=1.$" :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do this by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡(t+1)),\\frac{\\text{d}}{\\text{d}t}(2{t}^{4}+3)⟩ \\\\  & =⟨\\frac{1}{t+1},8{t}^{3}⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t+1}),\\frac{\\text{d}}{\\text{d}t}(8{t}^{3})⟩ \\\\  & =⟨-\\frac{1}{(t+1)^{2}},24{t}^{2}⟩\\end{aligned}\n$$\n\nFinally, to find the acceleration at time $t=1,$ we substitute $t=1$ into the above:\n\n$$\n\\begin{aligned}a(1) & =⟨-\\frac{1}{(1+1)^{2}},24({1}^{2})⟩ \\\\  & =⟨-\\frac{1}{4},24⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186387194 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef9fabf9-c18c-50a1-963a-7448f08bf2a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t)=⟨2+3\\operatorname{ln}⁡t,3t⟩" :db/id #edb/ref 17592186387196} {:answer/id #uuid "846cf632-7b3a-5114-8f92-b6680d7ea90d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t)=⟨2-\\operatorname{ln}⁡t,5t-2⟩" :db/id #edb/ref 17592186387197} {:answer/id #uuid "4a4d7265-d9e7-543f-b5ac-4cb4a42855c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t)=⟨2+\\operatorname{ln}⁡t,4-t⟩" :db/id #edb/ref 17592186387198} {:answer/id #uuid "169de5da-2a43-5074-932b-ff3949f05195" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t)=⟨2-\\operatorname{ln}⁡t,4-t⟩" :db/id #edb/ref 17592186387199} {:answer/id #uuid "10fab286-e298-5bb7-b569-1f7e5bfc15e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t)=⟨2+\\operatorname{ln}⁡t,5t-2⟩" :db/id #edb/ref 17592186387200}] :answer-field/correct {:answer/id #uuid "4a4d7265-d9e7-543f-b5ac-4cb4a42855c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t)=⟨2+\\operatorname{ln}⁡t,4-t⟩" :db/id #edb/ref 17592186387198} :answer-field/id #uuid "62463180-a575-5094-bd92-23503f886ae4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387195}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "daf2173d-c92c-5783-9142-5642bf903eb2" :question/math-academy-id "q-122471" :question/problem "The acceleration $a$ at time $t$ of a particle $P$ moving in the $xy$-plane is given by\n\n$$\na(t)=⟨-\\frac{1}{{t}^{2}},0⟩\\,,\\,t\\in (0,\\infty ).\n$$\n\nGiven that the particle is at the position $(2,3)$ and has velocity $⟨1,-1⟩$ when $t=1,$ calculate the position vector of $P$ at time $t.$" :question/worked-solution "To compute the position vector, we need to integrate the velocity vector. To find the velocity vector, we first need to integrate the acceleration vector. \n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int ⟨-\\frac{1}{{t}^{2}},0⟩\\text{d}t \\\\  & =⟨\\int (-\\frac{1}{{t}^{2}})\\text{d}t,\\int 0\\,\\text{d}t⟩ \\\\  & =⟨\\frac{1}{t}+{C}_{1},{C}_{2}⟩\\end{aligned}\n$$\n\nWe can solve for the constants of integration using the fact that $v(1)=⟨1,-1⟩.$ Substituting $t=1,$ we get\n\n$$\n\\begin{aligned}v(1) & =⟨\\frac{1}{1}+{C}_{1},{C}_{2}⟩ \\\\ ⟨1,-1⟩ & =⟨1+{C}_{1},{C}_{2}⟩,\\end{aligned}\n$$\n\nso we must have ${C}_{1}=0$ and ${C}_{2}=-1.$ Therefore, the velocity vector is\n\n$$\n\\begin{aligned}v(t) & =⟨\\frac{1}{t},-1⟩.\\end{aligned}\n$$\n\nWe can compute the position vector by integrating the velocity vector.\n\n$$\n\\begin{aligned}r(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int ⟨\\frac{1}{t},-1⟩\\text{d}t \\\\  & =⟨\\int \\frac{1}{t}\\,\\text{d}t,\\int (-1)\\,\\text{d}t⟩ \\\\  & =⟨\\operatorname{ln}⁡t+{C}_{3},-t+{C}_{4}⟩\\end{aligned}\n$$\n\nNow, we can solve for the constants of integration using the fact that $r(1)=⟨2,3⟩.$ Substituting $t=1,$ we get\n\n$$\n\\begin{aligned}r(1) & =⟨\\operatorname{ln}⁡1+{C}_{3},-1+{C}_{4}⟩ \\\\ ⟨2,3⟩ & =⟨{C}_{3},-1+{C}_{4}⟩,\\end{aligned}\n$$\n\nso we must have ${C}_{3}=2$ and ${C}_{4}=4.$ Therefore, the position of $P$ at time $t$ is\n\n$$\n\\begin{aligned}r(t) & =⟨2+\\operatorname{ln}⁡t,4-t⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186387208 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "abd8e10c-acce-5a96-8043-a1ff8e04be8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{(\\operatorname{sin}⁡t-3)}^{2}\\,\\text{d}t" :db/id #edb/ref 17592186387210} {:answer/id #uuid "a4067404-39d0-5695-bef0-39b4a803751d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{cos}^{2}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186387211} {:answer/id #uuid "654cf8dd-b5e7-5cb5-b3d2-53296e067a56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{2\\pi }{(1-\\operatorname{sin}⁡t)}^{2}\\,\\text{d}t" :db/id #edb/ref 17592186387212} {:answer/id #uuid "8dba4b05-44bf-5ce0-9bbc-0896224934cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{sin}^{2}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186387213} {:answer/id #uuid "9ee24693-a37d-53cd-9c9c-68982eeb7210" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{2\\pi }{(\\operatorname{cos}⁡t-3)}^{2}\\,\\text{d}t" :db/id #edb/ref 17592186387214}] :answer-field/correct {:answer/id #uuid "a4067404-39d0-5695-bef0-39b4a803751d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{cos}^{2}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186387211} :answer-field/id #uuid "62bd1f76-c0c6-5efb-a8ef-61be55142b02" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387209}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0c026636-3333-5149-910a-9646132297e7" :question/math-academy-id "q-122540" :question/problem "Which of the following gives the line integral of the function $f(x,y)=1-{y}^{2},$ traversed once along the circle $C$ with equation $(x+3)^{2}+{y}^{2}=1?$" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nThe curve $C$ is a circle of radius $1$ centered at $(-3,0).$ It can be parametrized as \n\n$$\nr(t)=⟨\\operatorname{cos}⁡t-3,\\,\\operatorname{sin}⁡t⟩,\\,0\\le t<2\\pi .\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t-3)i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)j \\\\  & =-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{{sin}^{2}⁡t+{cos}^{2}⁡t} \\\\  & =1\\end{aligned}\n$$\n\nNow, since $f(x,y)=1-{y}^{2},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =1-(\\operatorname{sin}⁡t)^{2} \\\\  & =1-{sin}^{2}⁡t \\\\  & ={cos}^{2}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }({cos}^{2}⁡t)\\cdot 1\\cdot \\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }{cos}^{2}⁡t\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186387215 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c793c767-8ecf-564e-af97-7c0e5166064b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{1/3}^{2}\\frac{\\sqrt{{t}^{4}+8}}{t}\\,\\text{d}t" :db/id #edb/ref 17592186387217} {:answer/id #uuid "71c2e31f-1ce7-5e4f-bb9e-8d3e5faf7e68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{\\int }_{1}^{6}\\frac{\\sqrt{{t}^{4}+1}}{t}\\,\\text{d}t" :db/id #edb/ref 17592186387218} {:answer/id #uuid "b13d0e88-37bf-5316-8237-40c1c7c1a505" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{\\int }_{1/3}^{2}\\frac{\\sqrt{{t}^{4}+4}}{t}\\,\\text{d}t" :db/id #edb/ref 17592186387219} {:answer/id #uuid "ae35c1a8-9ade-537f-b9ff-8d9b8d021811" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{\\int }_{1}^{6}\\frac{\\sqrt{{t}^{4}+4}}{t}\\,\\text{d}t" :db/id #edb/ref 17592186387220} {:answer/id #uuid "e2a101a7-ad66-5ad3-8847-9c8591f60fb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{1}^{6}\\frac{\\sqrt{{t}^{4}+8}}{t}\\,\\text{d}t" :db/id #edb/ref 17592186387221}] :answer-field/correct {:answer/id #uuid "ae35c1a8-9ade-537f-b9ff-8d9b8d021811" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{\\int }_{1}^{6}\\frac{\\sqrt{{t}^{4}+4}}{t}\\,\\text{d}t" :db/id #edb/ref 17592186387220} :answer-field/id #uuid "f4412e87-ff23-50d1-8bf7-efc4e936bf02" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387216}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3bf8f8b4-ea1a-5394-a193-4b55a8b9d41a" :question/math-academy-id "q-122542" :question/problem "![](images/62/62f33dab4305a41a0bc180231fef7015361dec4aac63f14c31fd48a39b8fcd68.png)\n\nWhich of the following is equivalent to the integral ${\\int }_{C}4x{y}^{2}\\,\\text{d}s,$ where $C$ is the section of the curve $x=\\frac{2}{y}$ traversed between the points $(2,1)$ and $(\\frac{1}{3},6),$ as shown above?\n\n*Hint: Use the parameter $y=t.$*" :question/worked-solution "Notice that the given curve is of the form $x=x(y).$ Therefore, by setting $y=t,$ we have \n\n$$\nx=x(t)=\\frac{2}{t}.\n$$\n\n \n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=⟨\\frac{2}{t},\\,t⟩,\\,1\\le t\\le 6\n$$\n\nNote that the domain $1\\le t\\le 6$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{2}{t})i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =-\\frac{2}{{t}^{2}}\\,i+j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{(-\\frac{2}{{t}^{2}})}^{2}+{1}^{2}} \\\\  & =\\sqrt{\\frac{4}{{t}^{4}}+1} \\\\  & =\\sqrt{\\frac{4+{t}^{4}}{{t}^{4}}} \\\\  & =\\frac{\\sqrt{{t}^{4}+4}}{{t}^{2}}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=4x{y}^{2},$ then we obtain \n\n$$\n\\begin{aligned}f(r(t)) & =4(\\frac{2}{t})(t)^{2} \\\\  & =8t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}4x{y}^{2}\\,\\text{d}s & ={\\int }_{1}^{6}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{1}^{6}8t\\cdot \\frac{\\sqrt{{t}^{4}+4}}{{t}^{2}}\\,\\text{d}t \\\\  & =8{\\int }_{1}^{6}\\frac{\\sqrt{{t}^{4}+4}}{t}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186387235 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f90d0fcc-df3f-54ef-aac5-4852b0a9e794" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡t\\,{e}^{1-6{sin}^{2}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186387237} {:answer/id #uuid "fe6acbd4-d635-575c-943b-644683f18c20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{\\int }_{\\pi /2}^{\\pi }\\operatorname{cos}⁡t\\,{e}^{1-36{sin}^{2}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186387238} {:answer/id #uuid "e5bd4d7e-4781-5218-931d-c97cde2ff693" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36{\\int }_{\\pi /2}^{\\pi }\\operatorname{cos}⁡t\\,{e}^{1-36{sin}^{2}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186387239} {:answer/id #uuid "cddcdbf9-66b3-51d5-90ba-30cc5ce21442" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡t\\,{e}^{1-{sin}^{2}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186387240} {:answer/id #uuid "fcfcb486-31a0-5c12-b0ed-93d029be6c47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡t\\,{e}^{1-36{sin}^{2}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186387241}] :answer-field/correct {:answer/id #uuid "fcfcb486-31a0-5c12-b0ed-93d029be6c47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡t\\,{e}^{1-36{sin}^{2}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186387241} :answer-field/id #uuid "ac816d5f-c719-59f3-837c-14f7205ae0a4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387236}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6b50e6e3-88d1-56d2-a993-e2318e36e7bc" :question/math-academy-id "q-122582" :question/problem "Which of the following gives the line integral of the function $f(x,y)=x\\,{e}^{1-{y}^{2}}$ along the quarter-circle ${x}^{2}+{y}^{2}=36,$ traversed from the point $(6,0)$ to the point $(0,6)$ in the first quadrant?" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nThe curve $C$ is a part-circle of radius $6$ centered at $O,$ shown below. \n\n![](images/c1/c1e3332017b795ed6733a0547e6e449fdba3874f1d1e755118a0687ccaf7448c.png)\n\nThe curve $C$ can be parametrized as \n\n$$\nr(t)=⟨6\\operatorname{cos}⁡t,\\,6\\operatorname{sin}⁡t⟩,\\,0\\le t\\le \\frac{\\pi }{2}.\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(6\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(6\\operatorname{sin}⁡t)j \\\\  & =-6\\operatorname{sin}⁡t\\,i+6\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-6\\operatorname{sin}⁡t)^{2}+(6\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{36{sin}^{2}⁡t+36{cos}^{2}⁡t} \\\\  & =\\sqrt{36({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =6\\end{aligned}\n$$\n\nNow, since $f(x,y)=x\\,{e}^{1-{y}^{2}},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =6\\operatorname{cos}⁡t\\,{e}^{1-(6\\operatorname{sin}⁡t)^{2}} \\\\  & =6\\operatorname{cos}⁡t\\,{e}^{1-36{sin}^{2}⁡t}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}{e}^{x+y}\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}6\\operatorname{cos}⁡t\\,{e}^{1-36{sin}^{2}⁡t}\\cdot 6\\cdot \\text{d}t \\\\  & =36{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡t\\,{e}^{1-36{sin}^{2}⁡t}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186387242 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12cdf423-e581-53c9-b943-12d52221b2a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27{\\int }_{\\pi }^{3\\pi /2}{cos}^{2}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186387244} {:answer/id #uuid "b9522f90-63cc-5efe-a46b-2246bf7d7b2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27{\\int }_{3\\pi /2}^{2\\pi }{cos}^{2}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186387245} {:answer/id #uuid "eb39fe71-c1b3-593f-b630-c516e6f8448a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9{\\int }_{3\\pi /2}^{2\\pi }{sin}^{2}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186387246} {:answer/id #uuid "5aa89b78-e5fc-5030-ac4f-50357fc840b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27{\\int }_{\\pi }^{3\\pi /2}{sin}^{2}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186387247} {:answer/id #uuid "47e4606a-831f-5f42-a986-6462e2d1edbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9{\\int }_{3\\pi /2}^{2\\pi }{cos}^{2}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186387248}] :answer-field/correct {:answer/id #uuid "b9522f90-63cc-5efe-a46b-2246bf7d7b2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27{\\int }_{3\\pi /2}^{2\\pi }{cos}^{2}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186387245} :answer-field/id #uuid "87e951f7-7453-52d8-b44c-a2ad3dc52dee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387243}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b42e9373-4893-5f93-a4eb-1c63f18b5e00" :question/math-academy-id "q-122588" :question/problem "Which of the following gives the line integral of the function $f(x,y)=x\\,\\sqrt{9-{y}^{2}}$ along the quarter-circle ${x}^{2}+{y}^{2}=9,$ traversed from the point $(0,-3)$ to the point $(3,0)$ in the fourth quadrant?" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nThe curve $C$ is a part-circle of radius $3$ centered at $O,$ shown below. \n\n![](images/b7/b7c2c6f9e50988629007a06213cb3acf0a48f9951f026fb70d5a986b760abdfe.png)\n\nThe curve $C$ can be parametrized as \n\n$$\nr(t)=⟨3\\operatorname{cos}⁡t,\\,3\\operatorname{sin}⁡t⟩,\\,\\frac{3\\pi }{2}\\le t\\le 2\\pi .\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t)j \\\\  & =-3\\operatorname{sin}⁡t\\,i+3\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-3\\operatorname{sin}⁡t)^{2}+(3\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{9{sin}^{2}⁡t+9{cos}^{2}⁡t} \\\\  & =\\sqrt{9({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =3\\end{aligned}\n$$\n\nNow, since $f(x,y)=x\\,\\sqrt{9-{y}^{2}},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =3\\operatorname{cos}⁡t\\,\\sqrt{9-(3\\operatorname{sin}⁡t)^{2}} \\\\  & =3\\operatorname{cos}⁡t\\,\\sqrt{9-9{sin}^{2}⁡t} \\\\  & =3\\operatorname{cos}⁡t\\,\\sqrt{9{cos}^{2}⁡t} \\\\  & =9{cos}^{2}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}x\\,\\sqrt{9-{y}^{2}}\\,\\text{d}s & ={\\int }_{3\\pi /2}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{3\\pi /2}^{2\\pi }9{cos}^{2}⁡t\\cdot 3\\cdot \\text{d}t \\\\  & =27{\\int }_{3\\pi /2}^{2\\pi }{cos}^{2}⁡t\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186387249 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fa67403-3c4c-5d88-b227-4c700c3a7dd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{\\int }_{\\pi }^{3\\pi /2}{sin}^{2}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186387251} {:answer/id #uuid "3091951d-4759-5af3-94ce-b0eebddefa0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{\\int }_{3\\pi /2}^{2\\pi }{cos}^{2}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186387252} {:answer/id #uuid "2c830dfe-8d7e-5efc-b4c4-c776aeed527f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{\\int }_{3\\pi /2}^{2\\pi }{cos}^{2}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186387253} {:answer/id #uuid "ba8dfc76-d958-59a5-990c-23331e92b469" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{\\int }_{\\pi }^{3\\pi /2}{sin}^{2}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186387254} {:answer/id #uuid "d9e5108e-fb63-5987-9568-84f090a3978a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{\\int }_{\\pi }^{3\\pi /2}{cos}^{2}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186387255}] :answer-field/correct {:answer/id #uuid "d9e5108e-fb63-5987-9568-84f090a3978a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{\\int }_{\\pi }^{3\\pi /2}{cos}^{2}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186387255} :answer-field/id #uuid "78075364-c535-58e8-b896-df95c6542768" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387250}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7a882cfb-b3f3-519e-9b6e-6e0eebe95df2" :question/math-academy-id "q-122591" :question/problem "Which of the following gives the line integral of the function $f(x,y)=2{x}^{2}$ along the quarter-circle ${x}^{2}+{y}^{2}=4,$ traversed from the point $(-2,0)$ to the point $(0,-2)$ in the third quadrant?" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nThe curve $C$ is a part-circle of radius $2$ centered at $O,$ shown below. \n\n![](images/1f/1fd6c2df8b8467a46ed36b515842b88656883733376ee732839bab4085ca019c.png)\n\nThe curve $C$ can be parametrized as \n\n$$\nr(t)=⟨2\\operatorname{cos}⁡t,\\,2\\operatorname{sin}⁡t⟩,\\,\\pi \\le t\\le \\frac{3\\pi }{2}.\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)j \\\\  & =-2\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-2\\operatorname{sin}⁡t)^{2}+(2\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{4{sin}^{2}⁡t+4{cos}^{2}⁡t} \\\\  & =\\sqrt{4({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =2\\end{aligned}\n$$\n\nNow, since $f(x,y)=2{x}^{2},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =2(2\\operatorname{cos}⁡t)^{2} \\\\  & =8{cos}^{2}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}2{x}^{2}\\,\\text{d}s & ={\\int }_{\\pi }^{3\\pi /2}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{\\pi }^{3\\pi /2}8{cos}^{2}⁡t\\cdot 2\\cdot \\text{d}t \\\\  & =16{\\int }_{\\pi }^{3\\pi /2}{cos}^{2}⁡t\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186387325 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c501b668-1a8b-52b8-bfbc-0865e77b89ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7{\\int }_{0}^{2\\pi }\\operatorname{cot}⁡t\\sqrt{4{sin}^{2}⁡t+45}\\,\\text{d}t" :db/id #edb/ref 17592186387327} {:answer/id #uuid "8f8e09de-8241-5d41-a528-d43d0b83321f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7{\\int }_{0}^{2\\pi }\\operatorname{tan}⁡t\\sqrt{45{sin}^{2}⁡t+4}\\,\\text{d}t" :db/id #edb/ref 17592186387328} {:answer/id #uuid "5284dbe0-5be2-5274-935e-78522341abb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14{\\int }_{0}^{2\\pi }\\operatorname{cot}⁡t\\sqrt{45{sin}^{2}⁡t+4}\\,\\text{d}t" :db/id #edb/ref 17592186387329} {:answer/id #uuid "6ce5154b-bdf7-5036-86b6-48af2c151a19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7{\\int }_{0}^{2\\pi }\\operatorname{cot}⁡t\\sqrt{45{sin}^{2}⁡t+4}\\,\\text{d}t" :db/id #edb/ref 17592186387330} {:answer/id #uuid "8e19472f-2116-55fd-ae86-a1dc8bf1dbe2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14{\\int }_{0}^{2\\pi }\\operatorname{tan}⁡t\\sqrt{4{sin}^{2}⁡t+45}\\,\\text{d}t" :db/id #edb/ref 17592186387331}] :answer-field/correct {:answer/id #uuid "6ce5154b-bdf7-5036-86b6-48af2c151a19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7{\\int }_{0}^{2\\pi }\\operatorname{cot}⁡t\\sqrt{45{sin}^{2}⁡t+4}\\,\\text{d}t" :db/id #edb/ref 17592186387330} :answer-field/id #uuid "e4e06052-07fc-5a61-a1f2-4c109fa7c59b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387326}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7fb44864-edbc-5a3d-bf6d-c1269d74e67b" :question/math-academy-id "q-123143" :question/problem "Which of the following is equivalent to ${\\int }_{C}\\frac{2x}{y}\\,\\text{d}s,$ where $C$ is the ellipse $4{x}^{2}+49{y}^{2}=196,$ traversed once in the counterclockwise direction?" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nNote that we can write the equation of our ellipse in the form\n\n$$\n\\frac{{x}^{2}}{{7}^{2}}+\\frac{{y}^{2}}{{2}^{2}}=1.\n$$\n\nSo, the curve $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $7$ and $2,$ respectively. Therefore, it can be parametrized as \n\n$$\nr(t)=⟨7\\operatorname{cos}⁡t,\\,2\\operatorname{sin}⁡t⟩,\\,0\\le t<2\\pi .\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(7\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)j \\\\  & =-7\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-7\\operatorname{sin}⁡t)^{2}+(2\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{49{sin}^{2}⁡t+4{cos}^{2}⁡t} \\\\  & =\\sqrt{45{sin}^{2}⁡t+4({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\sqrt{45{sin}^{2}⁡t+4}\\end{aligned}\n$$\n\nNow, since $f(x,y)=\\frac{2x}{y},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{2(7\\operatorname{cos}⁡t)}{2\\operatorname{sin}⁡t}=7\\operatorname{cot}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{2x}{y}\\,\\text{d}s & ={\\int }_{0}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }7\\operatorname{cot}⁡t\\sqrt{45{sin}^{2}⁡t+4}\\,\\text{d}t \\\\  & =7{\\int }_{0}^{2\\pi }\\operatorname{cot}⁡t\\sqrt{45{sin}^{2}⁡t+4}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186387332 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed86b67b-d5cb-57b5-a24d-29a4d73c30c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡t\\sqrt{3{sin}^{2}⁡t+1}\\,\\text{d}t" :db/id #edb/ref 17592186387334} {:answer/id #uuid "efa48bfc-8b2b-5a22-b35e-60ccac71d522" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{\\int }_{0}^{2\\pi }\\operatorname{sin}⁡t\\sqrt{{sin}^{2}⁡t+3}\\,\\text{d}t" :db/id #edb/ref 17592186387335} {:answer/id #uuid "7a3ea36b-e9a3-5562-a6ed-053fcefda30c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{\\int }_{0}^{2\\pi }\\operatorname{sin}⁡t\\sqrt{3{sin}^{2}⁡t+1}\\,\\text{d}t" :db/id #edb/ref 17592186387336} {:answer/id #uuid "083f15a4-94ea-5c6f-aefc-cee09c65a61f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡t\\sqrt{3{sin}^{2}⁡t+1}\\,\\text{d}t" :db/id #edb/ref 17592186387337} {:answer/id #uuid "12515b53-de19-592f-88a4-ab9e66663875" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡t\\sqrt{{sin}^{2}⁡t+3}\\,\\text{d}t" :db/id #edb/ref 17592186387338}] :answer-field/correct {:answer/id #uuid "ed86b67b-d5cb-57b5-a24d-29a4d73c30c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡t\\sqrt{3{sin}^{2}⁡t+1}\\,\\text{d}t" :db/id #edb/ref 17592186387334} :answer-field/id #uuid "5fa2a43b-c17a-52ce-9fb0-1b82291a1d31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387333}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ae604189-87b2-5cc4-80d1-9a191fe6507f" :question/math-academy-id "q-123146" :question/problem "Which of the following is equivalent to ${\\int }_{C}2x\\,\\text{d}s,$ where $C$ is the ellipse $4{x}^{2}+16{y}^{2}=64,$ traversed once in the counterclockwise direction?" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nNote that we can write the equation of our ellipse in the form\n\n$$\n\\frac{{x}^{2}}{{4}^{2}}+\\frac{{y}^{2}}{{2}^{2}}=1.\n$$\n\nSo, the curve $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $4$ and $2,$ respectively. Therefore, it can be parametrized as \n\n$$\nr(t)=⟨4\\operatorname{cos}⁡t,\\,2\\operatorname{sin}⁡t⟩,\\,0\\le t<2\\pi .\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)j \\\\  & =-4\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-4\\operatorname{sin}⁡t)^{2}+(2\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{16{sin}^{2}⁡t+4{cos}^{2}⁡t} \\\\  & =\\sqrt{12{sin}^{2}⁡t+4({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\sqrt{12{sin}^{2}⁡t+4} \\\\  & =2\\sqrt{3{sin}^{2}⁡t+1}\\end{aligned}\n$$\n\nNow, since $f(x,y)=2x,$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =2(4\\operatorname{cos}⁡t)=8\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}2x\\,\\text{d}s & ={\\int }_{0}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }8\\operatorname{cos}⁡t\\cdot 2\\sqrt{3{sin}^{2}⁡t+1}\\,\\text{d}t \\\\  & =16{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡t\\sqrt{3{sin}^{2}⁡t+1}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186387339 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cd2be39-2852-5a3b-b0b5-50515fa9399a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{\\int }_{0}^{2\\pi }{sin}^{2}⁡t\\sqrt{6{cos}^{2}⁡t+4}\\,\\text{d}t" :db/id #edb/ref 17592186387341} {:answer/id #uuid "18298c3e-ac12-5ad3-8b8d-c7251a53b2da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{sin}^{2}⁡t\\sqrt{6{cos}^{2}⁡t+4}\\,\\text{d}t" :db/id #edb/ref 17592186387342} {:answer/id #uuid "33e46136-ccb1-5344-bca2-73c7389b9c07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{\\int }_{0}^{2\\pi }{sin}^{2}⁡t\\sqrt{9{cos}^{2}⁡t+3}\\,\\text{d}t" :db/id #edb/ref 17592186387343} {:answer/id #uuid "32ae8c65-c6e7-5a6d-9e54-0fc3c2b9d30b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{cos}^{2}⁡t\\sqrt{3{cos}^{2}⁡t+9}\\,\\text{d}t" :db/id #edb/ref 17592186387344} {:answer/id #uuid "cb50e43b-2bff-5fbb-acde-eb728a7c598f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{\\int }_{0}^{2\\pi }{cos}^{2}⁡t\\sqrt{9{cos}^{2}⁡t+3}\\,\\text{d}t" :db/id #edb/ref 17592186387345}] :answer-field/correct {:answer/id #uuid "33e46136-ccb1-5344-bca2-73c7389b9c07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{\\int }_{0}^{2\\pi }{sin}^{2}⁡t\\sqrt{9{cos}^{2}⁡t+3}\\,\\text{d}t" :db/id #edb/ref 17592186387343} :answer-field/id #uuid "169b9432-e996-59fd-8a2c-3051df7da254" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387340}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "56d45ff5-8d46-5d91-ada0-7afe1d0328af" :question/math-academy-id "q-123153" :question/problem "Which of the following is equivalent to ${\\int }_{C}(3-{x}^{2})\\,\\text{d}s,$ where $C$ is the ellipse $12{x}^{2}+3{y}^{2}=36,$ traversed once in the counterclockwise direction?" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nNote that we can write the equation of our ellipse in the form\n\n$$\n\\frac{{x}^{2}}{(\\sqrt{3})^{2}}+\\frac{{y}^{2}}{(2\\sqrt{3})^{2}}=1.\n$$\n\nSo, the curve $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $\\sqrt{3}$ and $2\\sqrt{3},$ respectively. Therefore, it can be parametrized as \n\n$$\nr(t)=⟨\\sqrt{3}\\operatorname{cos}⁡t,\\,2\\sqrt{3}\\operatorname{sin}⁡t⟩,\\,0\\le t<2\\pi .\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\sqrt{3}\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(2\\sqrt{3}\\operatorname{sin}⁡t)j \\\\  & =-\\sqrt{3}\\operatorname{sin}⁡t\\,i+2\\sqrt{3}\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-\\sqrt{3}\\operatorname{sin}⁡t)^{2}+(2\\sqrt{3}\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{3{sin}^{2}⁡t+12{cos}^{2}⁡t} \\\\  & =\\sqrt{9{cos}^{2}⁡t+3({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\sqrt{9{cos}^{2}⁡t+3}\\end{aligned}\n$$\n\nNow, since $f(x,y)=3-{x}^{2},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =3-(\\sqrt{3}\\operatorname{cos}⁡t)^{2} \\\\  & =3-3{cos}^{2}⁡t \\\\  & =3(1-{cos}^{2}⁡t) \\\\  & =3{sin}^{2}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}(3-{x}^{2})\\,\\text{d}s & ={\\int }_{0}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }3{sin}^{2}⁡t\\sqrt{9{cos}^{2}⁡t+3}\\,\\text{d}t \\\\  & =3{\\int }_{0}^{2\\pi }{sin}^{2}⁡t\\sqrt{9{cos}^{2}⁡t+3}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186387353 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b97203e9-8d87-5cac-b645-904ef91cae7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨6,\\,\\frac{3}{2}⟩" :db/id #edb/ref 17592186387355} {:answer/id #uuid "4f63b47e-4384-5932-bde6-b16ca9aebd87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,\\,\\frac{3}{4}⟩" :db/id #edb/ref 17592186387356} {:answer/id #uuid "5941fefb-b666-5264-9ff1-ea630cf1bd88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨12,\\,\\frac{1}{4}⟩" :db/id #edb/ref 17592186387357} {:answer/id #uuid "cd8b17a6-4cbf-54f9-99c3-f7a62dd1829d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨6,\\,\\frac{4}{3}⟩" :db/id #edb/ref 17592186387358} {:answer/id #uuid "53d7fc04-e503-5637-99f3-3e1a31b96eda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{1}{3},\\,\\frac{3}{4}⟩" :db/id #edb/ref 17592186387359}] :answer-field/correct {:answer/id #uuid "4f63b47e-4384-5932-bde6-b16ca9aebd87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,\\,\\frac{3}{4}⟩" :db/id #edb/ref 17592186387356} :answer-field/id #uuid "e7722d9c-8a8e-51c2-9846-c98ae9635908" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387354}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "12003e8d-c48c-5642-87cc-c7c437d424fc" :question/math-academy-id "q-123203" :question/problem "Given that $r(t)=⟨6\\operatorname{cos}⁡(5t),\\,{sin}^{2}⁡(5t)⟩,$ calculate $r(\\frac{\\pi }{3}).$" :question/worked-solution "We substitute $t=\\frac{\\pi }{3}$ into our function, and we get\n\n$$\n\\begin{aligned}r(\\frac{\\pi }{3}) & =⟨6\\operatorname{cos}⁡(5\\cdot \\frac{\\pi }{3}),\\,{sin}^{2}⁡(5\\cdot \\frac{\\pi }{3})⟩ \\\\  & =⟨(6\\cdot \\frac{1}{2}),\\,{(-\\frac{\\sqrt{3}}{2})}^{2}⟩ \\\\  & =⟨3,\\,\\frac{3}{4}⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186387360 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a93738ab-9081-5c6f-8511-86ef418346d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{\\int }_{\\pi /2}^{\\pi }\\operatorname{sin}⁡t{cos}^{2}⁡t\\sqrt{3{cos}^{2}⁡t+1}\\,\\text{d}t" :db/id #edb/ref 17592186387362} {:answer/id #uuid "16d6b119-3bc3-5a27-9e7b-17462013838f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}{\\int }_{\\pi /2}^{\\pi }{sin}^{2}⁡t\\sqrt{3{cos}^{2}⁡t+1}\\,\\text{d}t" :db/id #edb/ref 17592186387363} {:answer/id #uuid "61985336-57b3-5c35-af3b-a7c51ff9e8e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}{\\int }_{0}^{\\pi }{sin}^{2}⁡t\\sqrt{{cos}^{2}⁡t+3}\\,\\text{d}t" :db/id #edb/ref 17592186387364} {:answer/id #uuid "52078fb4-b647-50ef-98c9-e3fb6359dbe2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{\\int }_{0}^{\\pi }\\operatorname{sin}⁡t{cos}^{2}⁡t\\sqrt{{cos}^{2}⁡t+3}\\,\\text{d}t" :db/id #edb/ref 17592186387365} {:answer/id #uuid "11b75cb3-33d2-5ac2-98e1-7e293e54d2e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{\\int }_{\\pi /2}^{\\pi }\\operatorname{sin}⁡t{cos}^{2}⁡t\\sqrt{{cos}^{2}⁡t+3}\\,\\text{d}t" :db/id #edb/ref 17592186387366}] :answer-field/correct {:answer/id #uuid "11b75cb3-33d2-5ac2-98e1-7e293e54d2e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{\\int }_{\\pi /2}^{\\pi }\\operatorname{sin}⁡t{cos}^{2}⁡t\\sqrt{{cos}^{2}⁡t+3}\\,\\text{d}t" :db/id #edb/ref 17592186387366} :answer-field/id #uuid "77cf4060-1d63-5c4b-b8af-00a20dc038f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387361}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "093d0403-9b58-520d-b909-bbab14fea8b6" :question/math-academy-id "q-123207" :question/problem "![](images/7f/7fc64a261de4941b5ad35b8308b82b0f51c6b6bfbde177aafd793a0a0ac99da6.png)\n\nWhich of the following gives the line integral ${\\int }_{C}{x}^{2}y\\,\\text{d}s,$ where the curve $C$ is the quarter of the ellipse $4{x}^{2}+3{y}^{2}=12,$ located in the second quadrant, shown above?" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nNote that we can write the equation of our ellipse in the form\n\n$$\n\\frac{{x}^{2}}{(\\sqrt{3})^{2}}+\\frac{{y}^{2}}{{2}^{2}}=1.\n$$\n\nSo, the curve $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $\\sqrt{3}$ and $2,$ respectively. Therefore, it can be parametrized as \n\n$$\nr(t)=⟨\\sqrt{3}\\operatorname{cos}⁡t,\\,2\\operatorname{sin}⁡t⟩,\\,\\frac{\\pi }{2}\\le t\\le \\pi .\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\sqrt{3}\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)j \\\\  & =-\\sqrt{3}\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-\\sqrt{3}\\operatorname{sin}⁡t)^{2}+(2\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{3{sin}^{2}⁡t+4{cos}^{2}⁡t} \\\\  & =\\sqrt{{cos}^{2}⁡t+3({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\sqrt{{cos}^{2}⁡t+3}\\end{aligned}\n$$\n\nNow, since $f(x,y)={x}^{2}y,$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(\\sqrt{3}\\operatorname{cos}⁡t)^{2}(2\\operatorname{sin}⁡t) \\\\  & =3{cos}^{2}⁡t\\cdot 2\\operatorname{sin}⁡t \\\\  & =6\\operatorname{sin}⁡t{cos}^{2}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}{x}^{2}y\\,\\text{d}s & ={\\int }_{\\pi /2}^{\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{\\pi }6\\operatorname{sin}⁡t{cos}^{2}⁡t\\sqrt{{cos}^{2}⁡t+3}\\,\\text{d}t \\\\  & =6{\\int }_{\\pi /2}^{\\pi }\\operatorname{sin}⁡t{cos}^{2}⁡t\\sqrt{{cos}^{2}⁡t+3}\\,\\text{d}t.\\end{aligned}\n$$"}]
