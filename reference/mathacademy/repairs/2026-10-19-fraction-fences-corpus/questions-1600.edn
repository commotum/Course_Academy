17592186316349}] :answer-field/correct {:answer/id #uuid "dd5c5ed6-2f1c-5cc7-963a-f5413e330111" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186316349} :answer-field/id #uuid "be37d6d8-1eb7-53b0-a960-fe7553382b46" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316993}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d0f6d5f3-5213-5096-b128-e5b4d23a6bdc" :question/math-academy-id "q-342229" :question/problem "Select the missing parts in a particular solution of the differential equation ${y}^{′}-y=f(x),$ where the Fourier series of the $4$-periodic forcing function is given by\n\n$$\nf(x)∼-1+{\\sum }_{n=1}^{\\infty }\\frac{4}{{n}^{2}\\pi }\\operatorname{cos}⁡(\\frac{n\\pi x}{2}).\n$$\n\nThe Fourier series of a particular solution is\n\n$$\n\\begin{aligned}{y}_{p}∼{{field-1}} & +{\\sum }_{n=1}^{\\infty }\\,{{field-2}}\\cdot \\operatorname{cos}⁡(\\frac{n\\pi x}{2}) \\\\  & +{\\sum }_{n=1}^{\\infty }\\,{{field-3}}\\cdot \\operatorname{sin}⁡(\\frac{n\\pi x}{2})\\end{aligned}\n$$" :question/worked-solution "We assume that a solution of our equation has the following Fourier series:\n\n$$\n{y}_{p}∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{2})+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$\n\nNow, we compute the derivative:\n\n$$\n\\begin{aligned}{y}_{p}^{′} & ∼\\frac{\\text{d}}{\\text{d}x}(\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{2})+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{2})) \\\\  & ∼0+{\\sum }_{n=1}^{\\infty }{a}_{n}\\cdot (-\\frac{n\\pi }{2}\\operatorname{sin}⁡(\\frac{n\\pi x}{2}))+{b}_{n}\\cdot \\frac{n\\pi }{2}\\operatorname{cos}⁡(\\frac{n\\pi x}{2}) \\\\  & ∼{\\sum }_{n=1}^{\\infty }-\\frac{{a}_{n}n\\pi }{2}\\operatorname{sin}⁡(\\frac{n\\pi x}{2})+\\frac{{b}_{n}n\\pi }{2}\\operatorname{cos}⁡(\\frac{n\\pi x}{2})\\end{aligned}\n$$\n\nNext, we substitute the expressions for ${y}_{p}^{′}$ and ${y}_{p}$ into the equation:\n\n$$\n\\begin{aligned} & ({\\sum }_{n=1}^{\\infty }-\\frac{{a}_{n}n\\pi }{2}\\operatorname{sin}⁡(\\frac{n\\pi x}{2})+\\frac{{b}_{n}n\\pi }{2}\\operatorname{cos}⁡(\\frac{n\\pi x}{2})) \\\\  & \\,-(\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{2})+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{2})) \\\\  & \\,\\,=-1+{\\sum }_{n=1}^{\\infty }\\frac{4}{{n}^{2}\\pi }\\operatorname{cos}⁡(\\frac{n\\pi x}{2})\\end{aligned}\n$$\n\nRearranging the terms, we get \n\n$$\n\\begin{aligned} & -\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }(\\frac{{b}_{n}n\\pi }{2}-{a}_{n})\\operatorname{cos}⁡(\\frac{n\\pi x}{2}) \\\\  & \\,\\,+{\\sum }_{n=1}^{\\infty }(-\\frac{{a}_{n}n\\pi }{2}-{b}_{n})\\operatorname{sin}⁡(\\frac{n\\pi x}{2}) \\\\  & \\,\\,\\,\\,=-1+{\\sum }_{n=1}^{\\infty }\\frac{4}{{n}^{2}\\pi }\\operatorname{cos}⁡(\\frac{n\\pi x}{2}).\\end{aligned}\n$$\n\nNow, equating the free terms and the coefficients next to sines and cosines, we obtain the following system:\n\n$$\n\\left\\{\\begin{aligned}-\\frac{{a}_{0}}{2} &=-1 \\\\ \\frac{{b}_{n}n\\pi }{2}-{a}_{n} &=\\frac{4}{{n}^{2}\\pi } \\\\ -\\frac{{a}_{n}n\\pi }{2}-{b}_{n} &=0\\end{aligned}\\right.\n$$\n\nFrom the first equation, ${a}_{0}=2,$ which means the constant term is given by\n\n$$\n\\frac{{a}_{0}}{2}=1.\n$$\n\nNext, from the third equation, ${b}_{n}=-\\frac{{a}_{n}n\\pi }{2}.$ Substituting this into the third equation, gives\n\n$$\n(-\\frac{{a}_{n}n\\pi }{2})\\frac{n\\pi }{2}-{a}_{n}=\\frac{4}{{n}^{2}\\pi }\\,⇒\\,{a}_{n}=-\\frac{16}{{n}^{2}\\pi ({n}^{2}{\\pi }^{2}+4)}.\n$$\n\nTherefore, for ${a}_{n}$ with $n\\ge 1,$ we have\n\n$$\n\\begin{aligned}{b}_{n} & =-\\frac{{a}_{n}n\\pi }{2} \\\\  & =-\\frac{n\\pi }{2}\\cdot (-\\frac{16}{{n}^{2}\\pi ({n}^{2}{\\pi }^{2}+4)}) \\\\  & =\\frac{8}{n({n}^{2}{\\pi }^{2}+4)}.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{y}_{p}∼1 & +{\\sum }_{n=1}^{\\infty }\\,-\\frac{16}{{n}^{2}\\pi ({n}^{2}{\\pi }^{2}+4)}\\cdot \\operatorname{cos}⁡(\\frac{n\\pi x}{2}) \\\\  & +{\\sum }_{n=1}^{\\infty }\\,\\frac{8}{n({n}^{2}{\\pi }^{2}+4)}\\cdot \\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186222036 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ee7e427-46c3-5aed-9b19-381c6b43ae67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{nx}{\\pi })" :db/id #edb/ref 17592186447524} {:answer/id #uuid "84d02c9f-09db-5f84-8395-ecb31c424496" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(nx)" :db/id #edb/ref 17592186447546} {:answer/id #uuid "d0cf8966-1bef-51d6-8f2d-fa9d3c63371e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{nx}{\\pi })" :db/id #edb/ref 17592186447577} {:answer/id #uuid "d80d207a-d991-5083-a552-3b5c5c3785d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(nx)" :db/id #edb/ref 17592186447582}] :answer-field/correct {:answer/id #uuid "d80d207a-d991-5083-a552-3b5c5c3785d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(nx)" :db/id #edb/ref 17592186447582} :answer-field/id #uuid "831873f5-dc3b-537b-bd1b-71e87ec289b4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186220905} {:answer-field/choices [{:answer/id #uuid "333c0e0a-3cd4-59b2-92d6-93fd825879e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "periodic" :db/id #edb/ref 17592186447500} {:answer/id #uuid "8dfe4bcc-fec4-5ff7-a0df-23a90cd726d4" :answer/