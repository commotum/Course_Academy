[{:db/id #edb/ref 17592186548000 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a066f3a-c9ff-5381-9be1-463aeaf34b51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186547479} {:answer/id #uuid "5a2bfd91-8772-51d9-bdc2-da46a676b608" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186547516} {:answer/id #uuid "718f587f-9400-5ff2-8042-b2bbeeac6f6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186547569} {:answer/id #uuid "8782a4d4-81e3-5eb0-85bd-15bc8474d851" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186547608} {:answer/id #uuid "8a6fa4fc-9ef6-5b97-80a9-85f5119427ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186547617}] :answer-field/correct {:answer/id #uuid "8782a4d4-81e3-5eb0-85bd-15bc8474d851" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186547608} :answer-field/id #uuid "76f810c9-6c36-550e-ba2c-f211b1f812da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547902}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4bc6d1d2-09ee-5cec-a2ab-850e837a407d" :question/math-academy-id "q-149608" :question/problem "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}2y\\operatorname{cos}⁡x, & \\,0\\le x\\le \\frac{\\pi }{2},\\,0\\le y\\le 1, \\\\ 0, & \\,\\text{otherwise}.\\end{aligned}\n$$\n\nFind the expected value of $Y.$" :question/worked-solution "The marginal density function for $Y$ when $0\\le y\\le 1$ is \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /2}2y\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =2y[\\operatorname{sin}⁡x]_{0}^{\\pi /2} \\\\  & =2y(\\operatorname{sin}⁡(\\frac{\\pi }{2})-\\operatorname{sin}⁡0) \\\\  & =2y(1-0) \\\\  & =2y.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{X}(x)$ is given by\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}2y, & 0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFinally, the  expected value of $Y$ is \n\n$$\n\\begin{aligned}\\text{E}[Y] & ={\\int }_{-\\infty }^{\\infty }y\\cdot {f}_{Y}(y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}y\\cdot 2y\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}2{y}^{2}\\,\\text{d}y \\\\  & ={[\\frac{2}{3}{y}^{3}]}_{0}^{1} \\\\  & =(\\frac{2}{3}-0) \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186548001 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "108be319-2cac-5831-9175-1aabb3c72448" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{32}" :db/id #edb/ref 17592186547351}] :answer-field/correct {:answer/id #uuid "108be319-2cac-5831-9175-1aabb3c72448" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{32}" :db/id #edb/ref 17592186547351} :answer-field/id #uuid "b1a4447f-3bfa-5239-8811-1f6dff980305" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186547927}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4c0fb001-b215-5979-89f5-05a01ae52266" :question/math-academy-id "q-350641" :question/problem "Evaluate the geometric series ${\\sum }_{n=1}^{\\infty }\\frac{9}{4}{(-\\frac{1}{3})}^{2n}.$ Do not round the answer.\n\n${\\sum }_{n=1}^{\\infty }\\frac{9}{4}{(-\\frac{1}{3})}^{2n}=$\n{{field-1}}" :question/worked-solution "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1.\n$$\n\nThe first term is \n\n$$\n{a}_{1}=\\frac{9}{4}{(-\\frac{1}{3})}^{2(1)}=\\frac{9}{4}{(-\\frac{1}{3})}^{2}\n$$\n\n \n\nand the second term is \n\n$$\n{a}_{2}=\\frac{9}{4}{(-\\frac{1}{3})}^{2(2)}=\\frac{9}{4}{(-\\frac{1}{3})}^{4}.\n$$\n\nTherefore, the common ratio is \n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{\\frac{9}{4}{(-\\frac{1}{3})}^{4}}{\\frac{9}{4}{(-\\frac{1}{3})}^{2}}={(-\\frac{1}{3})}^{2}=\\frac{1}{9}.\n$$\n\n \n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{9}{4}{(-\\frac{1}{3})}^{2n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{\\frac{9}{4}(\\frac{1}{9})}{(1-\\frac{1}{9})} \\\\  & =\\frac{(\\frac{1}{4})}{(\\frac{8}{9})} \\\\  & =\\frac{1}{4}\\cdot \\frac{9}{8} \\\\  & =\\frac{9}{32}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186548003 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66021cb4-d4dc-5536-b740-cb112f549955" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{25} & \\frac{1}{4} \\\\ \\frac{1}{4} & \\frac{1}{80}\\end{aligned}]" :db/id #edb/ref 17592186547542} {:answer/id #uuid "8ab77c8f-f65f-5385-b65d-d3ff9200abe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{2}{75} & \\frac{1}{120} \\\\ \\frac{1}{120} & \\frac{1}{80}\\end{aligned}]" :db/id #edb/ref 17592186547618} {:answer/id #uuid "8bea8944-aeb8-56ab-bc44-a9115f9d6b4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{2}{75} & 0 \\\\ 0 & \\frac{1}{10}\\end{aligned}]" :db/id #edb/ref 17592186547621} {:answer/id #uuid "c0675adb-146f-509c-9662-380def9fc9b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{3}{50} & \\frac{1}{120} \\\\ \\frac{1}{120} & \\frac{1}{20}\\end{aligned}]" :db/id #edb/ref 17592186547730} {:answer/id #uuid "fa4fcec9-3717-5441-ad16-3b9193cd5316" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{2}{75} & \\frac{1}{4} \\\\ \\frac{1}{4} & \\frac{3}{20}\\end{aligned}]" :db/id #edb/ref 17592186547829}] :answer-field/correct {:answer/id #uuid "8ab77c8f-f65f-5385-b65d-d3ff9200abe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{2}{75} & \\frac{1}{120} \\\\ \\frac{1}{120} & \\frac{1}{80}\\end{aligned}]" :db/id #edb/ref 17592186547618} :answer-field/id #uuid "bcc58af9-a17d-54ac-a6d0-c02b4698e66a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547935}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4f28747a-e241-5f89-b726-699a85c63f84" :question/math-academy-id "q-159419" :question/problem "The random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}48y(x-y),\\, & 0\\le x\\le 1,\\,\\,0\\le y\\le \\frac{x}{2}, \\\\ 0,\\, & \\text{otherwise}.\\end{aligned}\n$$\n\nGiven that $\\text{E}[X]=\\frac{4}{5},$ $\\text{E}[Y]=\\frac{1}{4},$ and $\\text{E}[{X}^{2}]=\\frac{2}{3},$ find the covariance matrix for $X$ and $Y.$" :question/worked-solution "For two random variables $X$ and $Y,$ the covariance matrix $Σ$ is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}].\n$$\n\nRecall that the variance of a random variable $X$ is determined by the formula\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2},\n$$\n\nand the covariance of two random variables $X$ and $Y$ is given by the formula\n\n$$\n\\text{Cov}[X,Y]=\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y].\n$$\n\nFirst, we find $\\text{Var}[X].$ Using the given results, we have\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{2}{3}-{(\\frac{4}{5})}^{2} \\\\  & =\\frac{2}{75}.\\end{aligned}\n$$\n\nSimilarly, we compute $\\text{E}[{Y}^{2}]$ using the rule of the lazy statistician:\n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}] & ={\\int }_{0}^{1}{\\int }_{0}^{x/2}{y}^{2}\\cdot f(x,y)\\,\\text{d}y\\text{d}x \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{x/2}48{y}^{3}(x-y)\\,\\text{d}y\\text{d}x \\\\  & =48{\\int }_{0}^{1}{\\int }_{0}^{x/2}(x{y}^{3}-{y}^{4})\\text{d}y\\text{d}x \\\\  & =48{\\int }_{0}^{1}{[\\frac{1}{4}x{y}^{4}-\\frac{1}{5}{y}^{5}]}_{y=0}^{y=x/2}\\,\\text{d}x \\\\  & =48{\\int }_{0}^{1}(\\frac{1}{64}{x}^{5}-\\frac{1}{160}{x}^{5})\\text{d}x \\\\  & =48\\cdot \\frac{3}{320}{\\int }_{0}^{1}{x}^{5}\\text{d}x \\\\  & =\\frac{9}{20}{[\\frac{1}{6}{x}^{6}]}_{0}^{1} \\\\  & =\\frac{3}{40}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =\\frac{3}{40}-{(\\frac{1}{4})}^{2} \\\\  & =\\frac{1}{80}.\\end{aligned}\n$$\n\nFinally, let's find $\\text{Cov}[X,Y].$ By the rule of the lazy statistician, we find $\\text{E}[XY]:$\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={\\int }_{0}^{1}{\\int }_{0}^{x/2}xy\\cdot f(x,y)\\,\\text{d}y\\text{d}x \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{x/2}48x{y}^{2}(x-y)\\,\\text{d}y\\text{d}x \\\\  & =48{\\int }_{0}^{1}{\\int }_{0}^{x/2}({x}^{2}{y}^{2}-x{y}^{3})\\text{d}y\\text{d}x \\\\  & =48{\\int }_{0}^{1}{[\\frac{1}{3}{x}^{2}{y}^{3}-\\frac{1}{4}x{y}^{4}]}_{y=0}^{y=x/2}\\,\\text{d}x \\\\  & =48{\\int }_{0}^{1}(\\frac{1}{24}{x}^{5}-\\frac{1}{64}{x}^{5})\\text{d}x \\\\  & =48\\cdot \\frac{5}{192}{\\int }_{0}^{1}{x}^{5}\\text{d}x \\\\  & =\\frac{5}{4}{[\\frac{1}{6}{x}^{6}]}_{0}^{1} \\\\  & =\\frac{5}{24}.\\end{aligned}\n$$\n\nThen, using the covariance formula, we have\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =\\frac{5}{24}-(\\frac{4}{5})\\cdot (\\frac{1}{4}) \\\\  & =\\frac{1}{120}.\\end{aligned}\n$$\n\nTherefore, the covariance matrix is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}]=[\\begin{aligned}\\frac{2}{75} & \\frac{1}{120} \\\\ \\frac{1}{120} & \\frac{1}{80}\\end{aligned}].\n$$"} {:db/id #edb/ref 17592186548004 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ec2f68f-3a5c-5320-80df-4677e1be6e00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-\\pi }-1}{10}" :db/id #edb/ref 17592186547347} {:answer/id #uuid "6081e439-1860-5222-91b9-aee228c648b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-\\pi }+2}{5}" :db/id #edb/ref 17592186547525} {:answer/id #uuid "842dae31-aac6-5e10-b497-9abe5c499c5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{e}^{-\\pi /2}-1}{10}" :db/id #edb/ref 17592186547599} {:answer/id #uuid "8bff236b-251c-5407-acdf-108c7f7dd322" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-\\pi /2}+1}{5}" :db/id #edb/ref 17592186547623} {:answer/id #uuid "c07201a8-c8e4-5b0a-831a-ee4bce670816" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{e}^{-\\pi /2}+1}{5}" :db/id #edb/ref 17592186547731}] :answer-field/correct {:answer/id #uuid "8bff236b-251c-5407-acdf-108c7f7dd322" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-\\pi /2}+1}{5}" :db/id #edb/ref 17592186547623} :answer-field/id #uuid "2392f4ba-bd38-5a07-8e70-90353132c90f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547859}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "509669b5-ef46-5eb1-8d54-7bbaca5f8fc9" :question/math-academy-id "q-115002" :question/problem "Evaluate ${\\int }_{0}^{\\pi /2}{e}^{-x}\\operatorname{cos}⁡(2x)\\,\\text{d}x.$" :question/worked-solution "Let's denote the indefinite integral by $I=\\int {e}^{-x}\\operatorname{cos}⁡(2x)\\,\\text{d}x.$\n\nTo use integration by parts, let's suppose that\n\n$$\n\\begin{aligned}u={e}^{-x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}=-{e}^{-x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡(2x)\\, & ⇒\\,v=\\int \\operatorname{cos}⁡(2x)\\,\\text{d}x=\\frac{\\operatorname{sin}⁡(2x)}{2}.\\end{aligned}\n$$\n\nThen, using the formula of integration by parts, we get\n\n$$\n\\begin{aligned}I & =\\int {e}^{-x}\\operatorname{cos}⁡(2x)\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{-x}(\\frac{\\operatorname{sin}⁡(2x)}{2})-\\int (\\frac{\\operatorname{sin}⁡(2x)}{2})(-{e}^{-x})\\text{d}x \\\\  & =\\frac{{e}^{-x}\\operatorname{sin}⁡(2x)}{2}+\\frac{1}{2}\\int {e}^{-x}\\operatorname{sin}⁡(2x)\\,\\text{d}x \\\\  & =\\frac{{e}^{-x}\\operatorname{sin}⁡(2x)}{2}+\\frac{1}{2}J.\\end{aligned}\n$$\n\nAgain, we can use integration by parts to evaluate\n\n$$\nJ=\\int {e}^{-x}\\operatorname{sin}⁡(2x)\\,\\text{d}x.\n$$\n\nTo do this, let's suppose that\n\n$$\n\\begin{aligned}u={e}^{-x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}=-{e}^{-x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(2x)\\, & ⇒\\,v=\\int \\operatorname{sin}⁡(2x)\\,\\text{d}x=-\\frac{\\operatorname{cos}⁡(2x)}{2}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}J & =\\int {e}^{-x}\\operatorname{sin}⁡(2x)\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{-x}(-\\frac{\\operatorname{cos}⁡(2x)}{2})-\\int (-\\frac{\\operatorname{cos}⁡(2x)}{2})(-{e}^{-x})\\text{d}x \\\\  & =-\\frac{{e}^{-x}\\operatorname{cos}⁡(2x)}{2}-\\frac{1}{2}\\int {e}^{-x}\\operatorname{cos}⁡(2x)\\,\\text{d}x \\\\  & =-\\frac{{e}^{-x}\\operatorname{cos}⁡(2x)}{2}-\\frac{1}{2}I.\\end{aligned}\n$$\n\nSo, substituting this into our equation for $I,$ we can subsequently solve for $I:$\n\n$$\n\\begin{aligned}I & =\\frac{{e}^{-x}\\operatorname{sin}⁡(2x)}{2}+\\frac{1}{2}J \\\\ I & =\\frac{{e}^{-x}\\operatorname{sin}⁡(2x)}{2}+\\frac{1}{2}(-\\frac{{e}^{-x}\\operatorname{cos}⁡(2x)}{2}-\\frac{1}{2}I) \\\\ I & =\\frac{{e}^{-x}\\operatorname{sin}⁡(2x)}{2}-\\frac{{e}^{-x}\\operatorname{cos}⁡(2x)}{4}-\\frac{1}{4}I \\\\ \\frac{5}{4}I & =\\frac{2{e}^{-x}\\operatorname{sin}⁡(2x)-{e}^{-x}\\operatorname{cos}⁡(2x)}{4} \\\\ I & =\\frac{1}{5}{e}^{-x}(2\\operatorname{sin}⁡(2x)-\\operatorname{cos}⁡(2x))\\end{aligned}\n$$\n\nFinally, we evaluate our definite integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}{e}^{-x}\\operatorname{cos}⁡(2x)\\,\\text{d}x & =(\\frac{1}{5}{e}^{-x}(2\\operatorname{sin}⁡(2x)-\\operatorname{cos}⁡(2x))){|}_{0}^{\\pi /2} \\\\  & =(\\frac{1}{5}{e}^{-\\pi /2}(2\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{2})-\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{2})))-(\\frac{1}{5}{e}^{-0}(2\\operatorname{sin}⁡(2(0))-\\operatorname{cos}⁡(2(0)))) \\\\  & =\\frac{{e}^{-\\pi /2}}{5}+\\frac{1}{5} \\\\  & =\\frac{{e}^{-\\pi /2}+1}{5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186548006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e77a6f5-b85a-52a5-a006-9b7d292f2cc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{401}{16}" :db/id #edb/ref 17592186547345} {:answer/id #uuid "13ad4530-88a4-53d4-8e25-b235bdfe115f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{209}{8}" :db/id #edb/ref 17592186547355} {:answer/id #uuid "16ac0b96-91a3-5dfc-b5ef-29cbc766835a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{417}{16}" :db/id #edb/ref 17592186547364} {:answer/id #uuid "80d7caca-10f2-5451-a96d-795017485bf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{449}{16}" :db/id #edb/ref 17592186547591} {:answer/id #uuid "92e2c5b9-18da-53a6-8dd8-6cb2c77bfba7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{401}{8}" :db/id #edb/ref 17592186547642}] :answer-field/correct {:answer/id #uuid "16ac0b96-91a3-5dfc-b5ef-29cbc766835a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{417}{16}" :db/id #edb/ref 17592186547364} :answer-field/id #uuid "69965209-526e-5658-899a-44e6dd8b07be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547892}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "510f41a7-5712-55db-b50d-5c80967bb9fb" :question/math-academy-id "q-12889" :question/problem "Given that\n\n$$\n{(\\frac{{x}^{2}}{2}+4)}^{4}=A{x}^{8}+B{x}^{6}+C{x}^{4}+128{x}^{2}+256\n$$\n\nwhere $A,B$ and $C$ are constants, find the value of $A+B+C.$" :question/worked-solution "First, let's compare our expression with the binomial\n\n$$\n(a+b)^{n}.\n$$\n\nHere we have that $n=4,$ $a=\\frac{{x}^{2}}{2},$ and $b=4.$ So, the exponents of the binomial expansion must follow the pattern\n\n$$\n{a}^{4}{b}^{0},\\,{a}^{3}{b}^{1},\\,{a}^{2}{b}^{2},\\,{a}^{1}{b}^{3},\\,{a}^{0}{b}^{4}.\n$$\n\nThe $4$th row in Pascal's Triangle is $(1,4,6,4,1).$ Therefore,\n\n$$\n\\begin{aligned}{(\\frac{{x}^{2}}{2}+4)}^{4} & =1{a}^{4}+4{a}^{3}b+6{a}^{2}{b}^{2}+4a{b}^{3}+1{b}^{4} \\\\  & =1{(\\frac{{x}^{2}}{2})}^{4}(4)^{0}+4{(\\frac{{x}^{2}}{2})}^{3}{(4)}^{1}+6{(\\frac{{x}^{2}}{2})}^{2}{(4)}^{2} \\\\  & \\,+4{(\\frac{{x}^{2}}{2})}^{1}{(4)}^{3}+1{(\\frac{{x}^{2}}{2})}^{0}{(4)}^{4} \\\\  & =1(\\frac{{x}^{8}}{16})(1)+4(\\frac{{x}^{6}}{8})(4)+6(\\frac{{x}^{4}}{4})(16) \\\\  & \\,+4(\\frac{{x}^{2}}{2})(64)+1(1)(256) \\\\  & =\\frac{{x}^{8}}{16}+\\frac{16{x}^{6}}{8}+\\frac{96{x}^{4}}{4}+\\frac{256{x}^{2}}{2}+256 \\\\  & =\\frac{{x}^{8}}{16}+2{x}^{6}+24{x}^{4}+128{x}^{2}+256.\\end{aligned}\n$$\n\nTherefore, we have $A=\\frac{1}{16},B=2$ and $C=24.$ So, finally\n\n$$\nA+B+C=\\frac{1}{16}+2+24=\\frac{417}{16}.\n$$"} {:db/id #edb/ref 17592186548007 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04876404-2581-5642-a614-ac8532d94ee0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{3}{5} & 0 \\\\ 0 & \\frac{51}{80}\\end{aligned}]" :db/id #edb/ref 17592186547326} {:answer/id #uuid "28e7f859-7126-5457-a4e0-c1a1e1d2204b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{3}{5} & -\\frac{2}{5} \\\\ -\\frac{2}{5} & \\frac{11}{40}\\end{aligned}]" :db/id #edb/ref 17592186547390} {:answer/id #uuid "32e2ee64-527c-5c83-b039-b6ea6f47e219" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{5} & 0 \\\\ 0 & \\frac{23}{40}\\end{aligned}]" :db/id #edb/ref 17592186547422} {:answer/id #uuid "f06f1240-944d-5a7e-801d-c1580106d19c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{5} & -\\frac{2}{5} \\\\ -\\frac{2}{5} & \\frac{23}{40}\\end{aligned}]" :db/id #edb/ref 17592186547811} {:answer/id #uuid "f530e59e-19da-56aa-a5f6-c0afac7fd1bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{3}{5} & 0 \\\\ 0 & \\frac{11}{40}\\end{aligned}]" :db/id #edb/ref 17592186547814}] :answer-field/correct {:answer/id #uuid "04876404-2581-5642-a614-ac8532d94ee0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{3}{5} & 0 \\\\ 0 & \\frac{51}{80}\\end{aligned}]" :db/id #edb/ref 17592186547326} :answer-field/id #uuid "3653cd9d-fe12-51a1-8be3-fd825c0586b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547870}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "53e9c56c-8467-523e-bd98-6ac7236cb57e" :question/math-academy-id "q-159402" :question/problem "The random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{1}{2}{x}^{2}{y}^{2},\\, & -1\\le x\\le 1,\\,\\,-1\\le y\\le 2, \\\\ 0,\\, & \\text{otherwise}.\\end{aligned}\n$$\n\nIf $\\text{E}[X]=0$ and $\\text{E}[Y]=\\frac{5}{4},$ find the covariance matrix for $X$ and $Y.$" :question/worked-solution "For two random variables $X$ and $Y,$ the covariance matrix $Σ$ is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}].\n$$\n\nRecall that the variance of a random variable $X$ is determined by the formula\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}.\n$$\n\nWe compute $\\text{E}[{X}^{2}]$ using the rule of the lazy statistician:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{-1}^{2}{\\int }_{-1}^{1}{x}^{2}\\cdot f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{-1}^{2}{\\int }_{-1}^{1}{x}^{2}(\\frac{1}{2}{x}^{2}{y}^{2})\\text{d}x\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{-1}^{2}{y}^{2}{\\int }_{-1}^{1}{x}^{4}\\text{d}x\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{-1}^{2}{y}^{2}\\cdot {[\\frac{1}{5}{x}^{5}]}_{-1}^{1}\\text{d}y \\\\  & =\\frac{1}{5}{\\int }_{-1}^{2}{y}^{2}\\,\\text{d}y \\\\  & =\\frac{1}{5}\\cdot {[\\frac{1}{3}{y}^{3}]}_{-1}^{2} \\\\  & =\\frac{3}{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{3}{5}-{(0)}^{2} \\\\  & =\\frac{3}{5}.\\end{aligned}\n$$\n\nSimilarly, we compute $\\text{E}[{Y}^{2}]$ using the rule of the lazy statistician:\n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}] & ={\\int }_{-1}^{2}{\\int }_{-1}^{1}{y}^{2}\\cdot f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{-1}^{2}{\\int }_{-1}^{1}{y}^{2}(\\frac{1}{2}{x}^{2}{y}^{2})\\text{d}x\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{-1}^{2}{y}^{4}{\\int }_{-1}^{1}{x}^{2}\\,\\text{d}x\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{-1}^{2}{y}^{4}{[\\frac{1}{3}{x}^{3}]}_{-1}^{1}\\,\\text{d}y \\\\  & =\\frac{1}{3}{\\int }_{-1}^{2}{y}^{4}\\,\\text{d}y \\\\  & =\\frac{1}{3}\\cdot {[\\frac{1}{5}{y}^{5}]}_{-1}^{2} \\\\  & =\\frac{1}{3}\\cdot \\frac{33}{5} \\\\  & =\\frac{11}{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =\\frac{11}{5}-{(\\frac{5}{4})}^{2} \\\\  & =\\frac{51}{80}.\\end{aligned}\n$$\n\nNow, we find the covariance of $X$ and $Y.$ The joint support of $X$ and $Y$ is given by the rectangle\n\n$$\nS=[-1,1]\\times [-1,2].\n$$\n\nMoreover, we can write\n\n$$\nf(x,y)=g(x)\\cdot h(y),\n$$\n\nwhere $g(x)=\\frac{3{x}^{2}}{2}$ and $h(y)=\\frac{{y}^{2}}{3}.$\n\nHence, $X$ and $Y$ are independent, and consequently $\\text{Cov}[X,Y]=0.$\n\nTherefore, the covariance matrix is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}]=[\\begin{aligned}\\frac{3}{5} & 0 \\\\ 0 & \\frac{51}{80}\\end{aligned}].\n$$"} {:db/id #edb/ref 17592186548016 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c09fbcf-e1dc-5950-9508-6766eb430f44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{2}{45} & \\frac{5}{63} \\\\ \\frac{5}{63} & \\frac{67}{548}\\end{aligned}]" :db/id #edb/ref 17592186547447} {:answer/id #uuid "8486b2b4-5627-54ae-9bfc-12a68a4ca561" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{5}{63} & \\frac{1}{21} \\\\ \\frac{1}{21} & \\frac{56}{843}\\end{aligned}]" :db/id #edb/ref 17592186547600} {:answer/id #uuid "cd3456dc-3ee8-5bd4-b669-70e0e8adddde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{4}{21} & 0 \\\\ 0 & \\frac{760}{1\\,323}\\end{aligned}]" :db/id #edb/ref 17592186547753} {:answer/id #uuid "ce082f30-4d9c-529e-8724-6a216a95f170" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{5}{63} & \\frac{5}{63} \\\\ \\frac{5}{63} & \\frac{760}{1\\,323}\\end{aligned}]" :db/id #edb/ref 17592186547758} {:answer/id #uuid "ff923f25-09d1-59df-bac6-3e88c64bc811" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{2}{45} & 0 \\\\ 0 & \\frac{56}{843}\\end{aligned}]" :db/id #edb/ref 17592186547843}] :answer-field/correct {:answer/id #uuid "ce082f30-4d9c-529e-8724-6a216a95f170" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{5}{63} & \\frac{5}{63} \\\\ \\frac{5}{63} & \\frac{760}{1\\,323}\\end{aligned}]" :db/id #edb/ref 17592186547758} :answer-field/id #uuid "3850f8d6-6285-5466-abaf-4c01feeefec9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547871}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7039fb00-3d4a-54d6-a4b0-1bcf58d49ef2" :question/math-academy-id "q-159422" :question/problem "The random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{5}{16}({x}^{2}-y),\\, & 0\\le x\\le 2,\\,\\,0\\le y\\le {x}^{2}, \\\\ 0,\\, & \\text{otherwise}.\\end{aligned}\n$$\n\nGiven that $\\text{E}[X]=\\frac{5}{3},$ $\\text{E}[Y]=\\frac{20}{21},$ and $\\text{E}[{Y}^{2}]=\\frac{40}{27},$ find the covariance matrix for $X$ and $Y.$" :question/worked-solution "For two random variables $X$ and $Y,$ the covariance matrix $Σ$ is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}].\n$$\n\nRecall that the variance of a random variable $X$ is determined by the formula\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2},\n$$\n\nand the covariance of two random variables $X$ and $Y$ is given by the formula\n\n$$\n\\text{Cov}[X,Y]=\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y].\n$$\n\nFirst, we find $\\text{Var}[X].$\nWe compute $\\text{E}[{X}^{2}]$ using the rule of the lazy statistician:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{2}{\\int }_{0}^{{x}^{2}}{x}^{2}\\cdot f(x,y)\\,\\text{d}y\\text{d}x \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{{x}^{2}}\\frac{5}{16}{x}^{2}({x}^{2}-y)\\,\\text{d}y\\text{d}x \\\\  & =\\frac{5}{16}{\\int }_{0}^{2}{\\int }_{0}^{{x}^{2}}({x}^{4}-y{x}^{2})\\text{d}y\\text{d}x \\\\  & =\\frac{5}{16}{\\int }_{0}^{2}{[y{x}^{4}-\\frac{1}{2}{y}^{2}{x}^{2}]}_{y=0}^{y={x}^{2}}\\,\\text{d}x \\\\  & =\\frac{5}{16}{\\int }_{0}^{2}(\\frac{1}{2}{x}^{6})\\text{d}x \\\\  & =\\frac{5}{32}{\\int }_{0}^{2}{x}^{6}\\text{d}x \\\\  & =\\frac{5}{32}{[\\frac{1}{7}{x}^{7}]}_{0}^{2} \\\\  & =\\frac{20}{7}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{20}{7}-{(\\frac{5}{3})}^{2} \\\\  & =\\frac{5}{63}.\\end{aligned}\n$$\n\nSimilarly, we compute $\\text{Var}[Y].$ Using the given results, we have\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =\\frac{40}{27}-{(\\frac{20}{21})}^{2} \\\\  & =\\frac{760}{1\\,323}.\\end{aligned}\n$$\n\nFinally, let's find $\\text{Cov}[X,Y].$ By the rule of the lazy statistician, we find $\\text{E}[XY]:$\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={\\int }_{0}^{2}{\\int }_{0}^{{x}^{2}}xy\\cdot f(x,y)\\,\\text{d}y\\text{d}x \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{{x}^{2}}\\frac{5}{16}xy({x}^{2}-y)\\,\\text{d}y\\text{d}x \\\\  & =\\frac{5}{16}{\\int }_{0}^{2}{\\int }_{0}^{{x}^{2}}({x}^{3}y-x{y}^{2})\\text{d}y\\text{d}x \\\\  & =\\frac{5}{16}{\\int }_{0}^{2}{[\\frac{1}{2}{y}^{2}{x}^{3}-\\frac{1}{3}{y}^{3}x]}_{y=0}^{y={x}^{2}}\\,\\text{d}y \\\\  & =\\frac{5}{16}{\\int }_{0}^{2}(\\frac{1}{6}{x}^{7})\\text{d}x \\\\  & =\\frac{5}{96}{\\int }_{0}^{2}{x}^{7}\\text{d}x \\\\  & =\\frac{5}{96}{[\\frac{1}{8}{x}^{8}]}_{0}^{2} \\\\  & =\\frac{5}{3}.\\end{aligned}\n$$\n\nThen, using the covariance formula, we have\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =\\frac{5}{3}-(\\frac{5}{3})\\cdot (\\frac{20}{21}) \\\\  & =\\frac{5}{63}.\\end{aligned}\n$$\n\nTherefore, the covariance matrix is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}]=[\\begin{aligned}\\frac{5}{63} & \\frac{5}{63} \\\\ \\frac{5}{63} & \\frac{760}{1\\,323}\\end{aligned}].\n$$"} {:db/id #edb/ref 17592186548019 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d5afcd8-4cf8-5778-a410-d996de8caa7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186547343} {:answer/id #uuid "3b943b2d-ea0b-5325-b2aa-3e8653e1e477" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{25}" :db/id #edb/ref 17592186547444} {:answer/id #uuid "6ef15147-7c05-56d2-a62e-10a55dfa362d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186547562} {:answer/id #uuid "a306fe67-74bc-5773-80ce-c1513aa6afc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186547673} {:answer/id #uuid "e32c4540-3e5c-5944-a86d-c76ecf3c6add" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186547789}] :answer-field/correct {:answer/id #uuid "a306fe67-74bc-5773-80ce-c1513aa6afc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186547673} :answer-field/id #uuid "be9f989d-d56a-54a6-a664-496350494e54" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547938}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7ac43aed-fdf1-5439-85aa-b688b91d01e4" :question/math-academy-id "q-124590" :question/problem "${\\sum }_{n=3}^{\\infty }\\frac{25}{27}{(\\frac{3}{5})}^{n}=$" :question/worked-solution "First, note that the index $n$ starts from $3.$ However, it is still a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nIn this case, the first term is ${a}_{3},$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{3}}{1-r},\\,|r|<1.\n$$\n\nFor the first few terms, we have:\n\n$$\n\\begin{aligned}{a}_{3} & =\\frac{25}{27}{(\\frac{3}{5})}^{3}=\\frac{25}{27}(\\frac{27}{125})=\\frac{1}{5} \\\\ {a}_{4} & =\\frac{25}{27}{(\\frac{3}{5})}^{4}=\\frac{25}{27}(\\frac{81}{625})=\\frac{3}{25}\\end{aligned}\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{4}}{{a}_{3}}=\\frac{(\\frac{3}{25})}{(\\frac{1}{5})}=\\frac{3}{5}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=3}^{\\infty }\\frac{25}{27}{(\\frac{3}{5})}^{n} & =\\frac{{a}_{3}}{1-r} \\\\  & =\\frac{(\\frac{1}{5})}{(1-\\frac{3}{5})} \\\\  & =\\frac{(\\frac{1}{5})}{(\\frac{2}{5})} \\\\  & =(\\frac{1}{5})\\cdot \\frac{5}{2} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186548021 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19a8a941-abee-5eec-a85d-2c36090c0c9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }\\sqrt{{\\theta }^{2}+2{e}^{\\theta }(\\theta +1)+{e}^{2\\theta }}\\,\\text{d}\\theta " :db/id #edb/ref 17592186547369} {:answer/id #uuid "829b49d5-b322-53c3-b0f4-1c6304fa46ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }\\sqrt{{\\theta }^{2}-2{e}^{\\theta }-2{e}^{2\\theta }}\\,\\text{d}\\theta " :db/id #edb/ref 17592186547594} {:answer/id #uuid "c107c606-2649-543d-89fe-4a7928489ec5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }\\sqrt{{\\theta }^{2}-2{e}^{\\theta }(1-\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186547735} {:answer/id #uuid "c4d84b89-ed7c-5866-bbe7-886aa45f00d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }\\sqrt{{\\theta }^{2}+2{e}^{\\theta }(\\theta +1)+2{e}^{2\\theta }+1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186547741} {:answer/id #uuid "fceb4866-634d-53f1-b923-46c9e70b07f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }\\sqrt{{\\theta }^{2}+2\\theta {e}^{\\theta }+2{e}^{2\\theta }}\\,\\text{d}\\theta " :db/id #edb/ref 17592186547834}] :answer-field/correct {:answer/id #uuid "c4d84b89-ed7c-5866-bbe7-886aa45f00d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }\\sqrt{{\\theta }^{2}+2{e}^{\\theta }(\\theta +1)+2{e}^{2\\theta }+1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186547741} :answer-field/id #uuid "17a97da4-f06a-512c-b0f2-d273f0e4876b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547850}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8023cebc-048b-5288-9c32-1da095db126f" :question/math-academy-id "q-103827" :question/problem "Which of the following gives the arc length of the polar curve $r=\\theta +{e}^{\\theta }$ for $-\\pi \\le \\theta \\le \\pi ?$" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=\\theta +{e}^{\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=1+{e}^{\\theta }.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi }^{\\pi }\\sqrt{(\\theta +{e}^{\\theta })^{2}+(1+{e}^{\\theta })^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi }^{\\pi }\\sqrt{{\\theta }^{2}+2\\theta {e}^{\\theta }+{e}^{2\\theta }+1+2{e}^{\\theta }+{e}^{2\\theta }}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi }^{\\pi }\\sqrt{{\\theta }^{2}+2{e}^{\\theta }(\\theta +1)+2{e}^{2\\theta }+1}\\,\\text{d}\\theta \\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186548022 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2185bcec-d33c-5b85-a90f-3baf6d8e3134" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186547385} {:answer/id #uuid "28fce1c0-fdae-52e2-b558-861fa662bf1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{3}" :db/id #edb/ref 17592186547391} {:answer/id #uuid "5abc1e52-5007-58cf-923d-9f9cdea5bf21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{20}{3}" :db/id #edb/ref 17592186547518} {:answer/id #uuid "5e40558d-2c08-52ce-bd22-49714e884a17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186547522} {:answer/id #uuid "69067c60-3e9e-5a7c-8919-986fa0b1106b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186547550}] :answer-field/correct {:answer/id #uuid "69067c60-3e9e-5a7c-8919-986fa0b1106b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186547550} :answer-field/id #uuid "da4c8753-aa62-5b12-846b-3fa944adeb01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547955}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "84522aa8-0251-51f3-8f96-c1848baee4b0" :question/math-academy-id "q-67300" :question/problem "${\\sum }_{n=1}^{\\infty }10{(\\frac{1}{2})}^{n}=$" :question/worked-solution "Notice that the given series is a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nThe first term is\n\n$$\n{a}_{1}=10{(\\frac{1}{2})}^{1}=5.\n$$\n\n \n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{10{(\\frac{1}{2})}^{2}}{10{(\\frac{1}{2})}^{1}}=\\frac{1}{2}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }10{(\\frac{1}{2})}^{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{5}{(1-\\frac{1}{2})} \\\\  & =\\frac{5}{(\\frac{1}{2})} \\\\  & =5\\cdot \\frac{2}{1} \\\\  & =10.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186548033 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34950a5f-0e45-502b-a869-e016971bd6d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{18} & 0 \\\\ 0 & \\frac{8}{75}\\end{aligned}]" :db/id #edb/ref 17592186547425} {:answer/id #uuid "4c028ae0-4e46-5185-bea4-b79e305dc544" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{9} & 0 \\\\ 0 & \\frac{8}{75}\\end{aligned}]" :db/id #edb/ref 17592186547489} {:answer/id #uuid "4dfa5556-a2dc-5232-9d7f-e3796a0407dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{9} & -1 \\\\ -1 & \\frac{8}{75}\\end{aligned}]" :db/id #edb/ref 17592186547494} {:answer/id #uuid "8675456c-15df-5d06-a100-2d7b178a0c1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{18} & 0 \\\\ 0 & \\frac{4}{25}\\end{aligned}]" :db/id #edb/ref 17592186547606} {:answer/id #uuid "ddc276fa-92de-5c9e-be25-aa6ec3df6cac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{18} & -1 \\\\ -1 & \\frac{4}{25}\\end{aligned}]" :db/id #edb/ref 17592186547779}] :answer-field/correct {:answer/id #uuid "34950a5f-0e45-502b-a869-e016971bd6d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{18} & 0 \\\\ 0 & \\frac{8}{75}\\end{aligned}]" :db/id #edb/ref 17592186547425} :answer-field/id #uuid "294a6c0d-e8c4-539b-87eb-6c2be022c57a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547862}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9895539f-08a9-52d3-aba6-0550c7a4d108" :question/math-academy-id "q-159407" :question/problem "The random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{1}{2}x{y}^{3},\\, & 0\\le x\\le 1,\\,\\,0\\le y\\le 2, \\\\ 0,\\, & \\text{otherwise}.\\end{aligned}\n$$\n\nIf $\\text{E}[X]=\\frac{2}{3}$ and $\\text{E}[Y]=\\frac{8}{5},$ find the covariance matrix for $X$ and $Y.$" :question/worked-solution "For two random variables $X$ and $Y,$ the covariance matrix $Σ$ is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}].\n$$\n\nRecall that the variance of a random variable $X$ is determined by the formula\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}.\n$$\n\nWe compute $\\text{E}[{X}^{2}]$ using the rule of the lazy statistician:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{2}{\\int }_{0}^{1}{x}^{2}\\cdot f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}{x}^{2}(\\frac{1}{2}x{y}^{3})\\text{d}x\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}{y}^{3}{\\int }_{0}^{1}{x}^{3}\\text{d}x\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}{y}^{3}\\cdot {[\\frac{1}{4}{x}^{4}]}_{0}^{1}\\text{d}y \\\\  & =\\frac{1}{8}{\\int }_{0}^{2}{y}^{3}\\,\\text{d}y \\\\  & =\\frac{1}{8}\\cdot {[\\frac{1}{4}{y}^{4}]}_{0}^{2} \\\\  & =\\frac{1}{8}\\cdot 4 \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{1}{2}-{(\\frac{2}{3})}^{2} \\\\  & =\\frac{1}{18}.\\end{aligned}\n$$\n\nSimilarly, we compute $\\text{E}[{Y}^{2}]$ using the rule of the lazy statistician:\n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}] & ={\\int }_{0}^{2}{\\int }_{0}^{1}{y}^{2}\\cdot f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}{y}^{2}(\\frac{1}{2}x{y}^{3})\\text{d}x\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}{y}^{5}{\\int }_{0}^{1}x\\,\\text{d}x\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}{y}^{5}{[\\frac{1}{2}{x}^{2}]}_{0}^{1}\\,\\text{d}y \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}{y}^{5}\\,\\text{d}y \\\\  & =\\frac{1}{4}\\cdot {[\\frac{1}{6}{y}^{6}]}_{0}^{2} \\\\  & =\\frac{1}{4}\\cdot \\frac{32}{3} \\\\  & =\\frac{8}{3}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =\\frac{8}{3}-{(\\frac{8}{5})}^{2} \\\\  & =\\frac{8}{75}.\\end{aligned}\n$$\n\nNow, we find the covariance of $X$ and $Y.$ The joint support of $X$ and $Y$ is given by the rectangle\n\n$$\nS=[0,1]\\times [0,2].\n$$\n\nMoreover, we can write\n\n$$\nf(x,y)=g(x)\\cdot h(y),\n$$\n\nwhere $g(x)=2x$ and $h(y)=\\frac{{y}^{3}}{4}.$\n\nHence, $X$ and $Y$ are independent, and consequently $\\text{Cov}[X,Y]=0.$\n\nTherefore, the covariance matrix is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}]=[\\begin{aligned}\\frac{1}{18} & 0 \\\\ 0 & \\frac{8}{75}\\end{aligned}].\n$$"} {:db/id #edb/ref 17592186548038 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a94de121-a4bc-5c49-b381-af42e7f0741f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186547689}] :answer-field/correct {:answer/id #uuid "a94de121-a4bc-5c49-b381-af42e7f0741f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186547689} :answer-field/id #uuid "72a14dfe-4aac-5b96-99e1-2adb2bdf2921" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186547896}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a4bf276d-b40b-5d47-b840-e4ace9d966fe" :question/math-academy-id "q-126763" :question/problem "Calculate ${f}^{″}(0).$\n\n${f}^{″}(0)\\,\\,=\\,\\,$\n{{field-1}}" :question/worked-solution "To find an expression for the second derivative, we differentiate the equation with respect to $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{\\text{d}y}{\\text{d}x}) & =\\frac{\\text{d}}{\\text{d}x}(2x\\sqrt{1-{y}^{2}}) \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =2x\\frac{\\text{d}}{\\text{d}x}\\sqrt{1-{y}^{2}}+\\sqrt{1-{y}^{2}}\\frac{\\text{d}}{\\text{d}x}(2x) \\\\  & =2x\\frac{\\text{d}}{\\text{d}y}\\sqrt{1-{y}^{2}}\\cdot \\frac{\\text{d}y}{\\text{d}x}+\\sqrt{1-{y}^{2}}\\cdot 2 \\\\  & =-\\frac{2xy}{\\sqrt{1-{y}^{2}}}\\frac{\\text{d}y}{\\text{d}x}+2\\sqrt{1-{y}^{2}}.\\end{aligned}\n$$\n\nNow, we substitute the given expression for $\\frac{\\text{d}y}{\\text{d}x}$ into the above and simplify the resulting expression:\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =-\\frac{2xy}{\\sqrt{1-{y}^{2}}}\\cdot 2x\\sqrt{1-{y}^{2}}+2\\sqrt{1-{y}^{2}} \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =-4{x}^{2}y+2\\sqrt{1-{y}^{2}}\\end{aligned}\n$$\n\nFinally, since the point $(0,0)$ lies on $f,$ we substitute the coordinates of our point into the above expression for the second derivative:\n\n$$\n\\begin{aligned}{\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(0,0)} & =-4\\cdot {0}^{2}\\cdot 0+2\\sqrt{1-{0}^{2}}=2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186548044 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3208f809-5202-519c-a4c1-b2c071b30e1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0.78$ grams" :db/id #edb/ref 17592186547420} {:answer/id #uuid "3633d1c4-a4bd-5d6c-9a1e-fe155268f04d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0.82$ grams" :db/id #edb/ref 17592186547428} {:answer/id #uuid "70486f57-d8c6-5d88-9e76-73287f23fb7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0.75$ grams" :db/id #edb/ref 17592186547567} {:answer/id #uuid "b360a2fc-6825-56f7-a4ae-202963cd606a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0.8$ grams" :db/id #edb/ref 17592186547706} {:answer/id #uuid "bf33ba30-f07a-5c5e-8673-051f5a7fed51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0.85$ grams" :db/id #edb/ref 17592186547724}] :answer-field/correct {:answer/id #uuid "3208f809-5202-519c-a4c1-b2c071b30e1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0.78$ grams" :db/id #edb/ref 17592186547420} :answer-field/id #uuid "c889ce98-c36c-5100-9ccc-2833887780d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547943}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b642f61b-90d3-52e8-a698-ed0e6fdd52ac" :question/math-academy-id "q-132849" :question/problem "In a factory, the average amount of sugar in a cookie is $15$ grams. However, $10%$ of cookies contain no more than $14$ grams of sugar. Assuming that the amount of sugar in each cookie is normally distributed, find the standard deviation of the amount of sugar in a cookie, rounded to $2$ decimal places.\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $p$ | $\\,0.01\\,$ | $\\,0.03\\,$ | $\\,0.05\\,$ | $\\,0.10\\,$ | $\\,0.15\\,$ | $\\,0.20\\,$ | $\\,0.25\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,-2.3263\\,$ | $\\,-1.8808\\,$ | $\\,-1.6449\\,$ | $\\,-1.2816\\,$ | $\\,-1.0364\\,$ | $\\,-0.8416\\,$ | $\\,-0.6745\\,$ |" :question/worked-solution "Let $X$ represent the amount (in grams) of sugar in a cookie. Then we have $X∼N(15,{\\sigma }^{2}),$ and we want to find the standard deviation $\\sigma .$ \n\nWe know that $P(X\\le 14)=0.10.$ Converting $X$ to a standard normal random variable by $z$-scoring, we get\n\n$$\n\\begin{aligned}P(X\\le 14) & =0.10 \\\\ P(Z\\le \\frac{14-15}{\\sigma }) & =0.10 \\\\ Φ(-\\frac{1}{\\sigma }) & =0.10 \\\\ -\\frac{1}{\\sigma } & ={Φ}^{-1}(0.10).\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.10)=-1.2816.\n$$\n\nFinally then, \n\n$$\n\\begin{aligned}-\\frac{1}{\\sigma } & =-1.2816 \\\\ \\frac{1}{\\sigma } & =1.2816 \\\\ \\sigma  & =\\frac{1}{1.2816} \\\\  & ≈0.78.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186548046 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c5745e4-3ad7-502f-bce7-234772762acf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{12}" :db/id #edb/ref 17592186547448} {:answer/id #uuid "5dbc9f32-3c2a-5c31-81b2-2d34ba3625e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186547521} {:answer/id #uuid "6771ee98-f25a-5cdc-91d7-e1d71d8eda3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{12}" :db/id #edb/ref 17592186547546} {:answer/id #uuid "83542680-0c0f-5bce-90df-2f3546c7a3e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186547596} {:answer/id #uuid "b01056a8-96d8-5259-85d4-db47041ed857" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{6}" :db/id #edb/ref 17592186547700}] :answer-field/correct {:answer/id #uuid "6771ee98-f25a-5cdc-91d7-e1d71d8eda3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{12}" :db/id #edb/ref 17592186547546} :answer-field/id #uuid "caa5996b-3602-50fb-816f-2fafeaae3fc0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547944}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b82a91db-40b3-51bf-b539-d94cf7913732" :question/math-academy-id "q-146284" :question/problem "| $f$ | $Y=2$ | $Y=4$ |\n| --- | --- | --- |\n| $X=1$ | $\\frac{1}{6}$ | $\\frac{1}{3}$ |\n| $X=2$ | $\\frac{1}{4}$ | $\\frac{1}{12}$ |\n| $X=3$ | $\\frac{1}{12}$ | $\\frac{1}{12}$ |\n\nSuppose $X$ and $Y$ are discrete random variables. Find $\\text{Var}[X\\,|\\,Y=4]$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above and the corresponding conditional expected value is ${\\mu }_{X|4}=\\frac{3}{2}.$" :question/worked-solution "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2} \\\\  & =[{\\sum }_{x}{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)]-{\\mu }_{X|y}^{2}.\\end{aligned}\n$$\n\nIn order to find ${f}_{X|Y}(x\\,|\\,y),$ let's first find the marginal distribution of $Y,$ corresponding to the column totals: \n\n| $f$ | $Y=2$ | $Y=4$ |\n| --- | --- | --- |\n| $X=1$ | $\\frac{1}{6}$ | $\\frac{1}{3}$ |\n| $X=2$ | $\\frac{1}{4}$ | $\\frac{1}{12}$ |\n| $X=3$ | $\\frac{1}{12}$ | $\\frac{1}{12}$ |\n| ${f}_{Y}(y)$ | $\\frac{1}{2}$ | $\\frac{1}{2}$ |\n\nThe conditional probability mass function of $X$ given that $Y=y$ is\n\n$$\n{f}_{X|Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)}.\n$$\n\nTherefore, dividing each joint probability by the corresponding column total, we obtain the conditional probability mass function of $X$ given that $Y=y:$\n\n| ${f}_{X|Y}(x\\,|\\,y)$ | $Y=2$ | $Y=4$ |\n| --- | --- | --- |\n| $X=1$ | $\\frac{1}{3}$ | $\\frac{2}{3}$ |\n| $X=2$ | $\\frac{1}{2}$ | $\\frac{1}{6}$ |\n| $X=3$ | $\\frac{1}{6}$ | $\\frac{1}{6}$ |\n|  | $1$ | $1$ |\n\nFinally, we obtain\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=4] & =[{\\sum }_{x}{x}^{2}\\,{f}_{X|Y}(x\\,|\\,4)]-{\\mu }_{X|4}^{2} \\\\  & =[{1}^{2}\\cdot \\frac{2}{3}+{2}^{2}\\cdot \\frac{1}{6}+{3}^{2}\\cdot \\frac{1}{6}]-{(\\frac{3}{2})}^{2} \\\\  & =\\frac{2}{3}+\\frac{2}{3}+\\frac{3}{2}-\\frac{9}{4} \\\\  & =\\frac{7}{12}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186548059 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a44699f-24c8-5a58-ba2d-76fbbc86ccec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{ln}^{7}⁡x}{3}+C" :db/id #edb/ref 17592186547517} {:answer/id #uuid "7b7a4366-3be3-5b98-9a3e-ba4a656574ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{ln}^{9}⁡x}{9}+C" :db/id #edb/ref 17592186547583} {:answer/id #uuid "8e73f739-d875-5435-8483-802c12bd03ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{ln}^{9}⁡x}{3}+C" :db/id #edb/ref 17592186547633} {:answer/id #uuid "f5af7b76-5c7d-52a9-8262-1e2bfb500412" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{ln}^{7}⁡x}{7}+C" :db/id #edb/ref 17592186547815} {:answer/id #uuid "fc69b155-6de6-5e6d-a369-6a5bbeeb4817" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{ln}^{9}⁡x}{6}+C" :db/id #edb/ref 17592186547832}] :answer-field/correct {:answer/id #uuid "7b7a4366-3be3-5b98-9a3e-ba4a656574ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{ln}^{9}⁡x}{9}+C" :db/id #edb/ref 17592186547583} :answer-field/id #uuid "4338b54c-776e-5c97-9d8a-821ddad0e1e9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547876}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d34958ec-5dd9-5a10-8bd6-7504a0d293c1" :question/math-academy-id "q-114951" :question/problem "Calculate $\\int \\frac{{ln}^{8}⁡x}{x}\\,\\text{d}x$ using integration by parts." :question/worked-solution "First, we let\n\n$$\nI=\\int \\frac{{ln}^{8}⁡x}{x}\\,\\text{d}x.\n$$\n\nTo use integration by parts, let's suppose that\n\n$$\n\\begin{aligned}u={ln}^{8}⁡x & \\,⇒\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{8{ln}^{7}⁡x}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x} & \\,⇒\\,v=\\int \\frac{1}{x}\\text{d}x=\\operatorname{ln}⁡x\\,.\\end{aligned}\n$$\n\nUsing the integration by parts formula, we get\n\n$$\n\\begin{aligned}I & =\\int \\frac{{ln}^{8}⁡x}{x}\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={ln}^{8}⁡x(\\operatorname{ln}⁡x)-\\int (\\operatorname{ln}⁡x)(\\frac{8{ln}^{7}⁡x}{x})\\,\\text{d}x \\\\  & ={ln}^{9}⁡x-8\\int \\frac{{ln}^{8}⁡x}{x}\\,\\text{d}x \\\\  & ={ln}^{9}⁡x-8I.\\end{aligned}\n$$\n\nFinally, we solve for $I,$ remembering to add a constant of integration $C$ at the very end:\n\n$$\n\\begin{aligned}I & ={ln}^{9}⁡x-8I \\\\ 9I & ={ln}^{9}⁡x \\\\ I & =\\frac{{ln}^{9}⁡x}{9}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186548076 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00674e18-ee02-59cd-b3dc-a6f698a1d859" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4\\operatorname{ln}⁡2}\\,\\text{m/s}" :db/id #edb/ref 17592186547317} {:answer/id #uuid "89c053ae-f87b-53b5-b9ff-dddaf3e41c2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2\\operatorname{ln}⁡2}\\,\\text{m/s}" :db/id #edb/ref 17592186547615} {:answer/id #uuid "8fea7db7-de80-5d17-aee5-ba303c413efc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{8\\operatorname{ln}⁡2}\\,\\text{m/s}" :db/id #edb/ref 17592186547636} {:answer/id #uuid "910d3bad-81e3-5314-864f-7990eaa9b236" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}\\,\\text{m/s}" :db/id #edb/ref 17592186547640} {:answer/id #uuid "a5081cba-4b6f-5bf9-b175-aba9c3e125ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{8}\\,\\text{m/s}" :db/id #edb/ref 17592186547678}] :answer-field/correct {:answer/id #uuid "00674e18-ee02-59cd-b3dc-a6f698a1d859" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4\\operatorname{ln}⁡2}\\,\\text{m/s}" :db/id #edb/ref 17592186547317} :answer-field/id #uuid "7d349dd1-b5a9-5935-ae21-26e3ea46f260" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547905}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f371caa1-75a3-5280-8f9d-dfa2d56f63d8" :question/math-academy-id "q-83246" :question/problem "A golden eagle is moving in a straight line with a velocity of $v(t)=\\frac{{2}^{t}}{12}\\,\\text{m/s},$ where $t$ is the time in seconds. Find the average velocity of the golden eagle on the interval $[2,6].$" :question/worked-solution "To calculate the average value of the velocity on $[{t}_{1},{t}_{2}],$ we use the average value formula\n\n$$\n{v}_{\\text{avg}}=\\frac{1}{{t}_{2}-{t}_{1}}{\\int }_{{t}_{1}}^{{t}_{2}}v(t)\\,\\text{d}t.\n$$\n\nSo, we get\n\n$$\n\\begin{aligned}{v}_{\\text{avg}} & =\\frac{1}{6-2}\\,{\\int }_{2}^{6}(\\frac{{2}^{t}}{12})\\text{d}t \\\\  & =\\frac{1}{4\\cdot 12\\cdot \\operatorname{ln}⁡2}({2}^{t}){|}_{2}^{6} \\\\  & =\\frac{1}{48\\operatorname{ln}⁡2}({2}^{6}-{2}^{2}) \\\\  & =\\frac{60}{48\\operatorname{ln}⁡2} \\\\  & =\\frac{5}{4\\operatorname{ln}⁡2}.\\end{aligned}\n$$\n\nTherefore, the average velocity is $\\frac{5}{4\\operatorname{ln}⁡2}\\,\\text{m/s}.$"} {:db/id #edb/ref 17592186548201 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b2745c4-1441-5995-aaf6-0adbc665aef0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+\\frac{9}{2})^{2}+(y+\\frac{1}{2})^{2}=\\frac{25}{2}" :db/id #edb/ref 17592186548213} {:answer/id #uuid "37d4082a-8911-5b7c-b50a-10c433cbf0c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+\\frac{9}{2})^{2}+(y-\\frac{1}{2})^{2}=\\frac{25}{2}" :db/id #edb/ref 17592186548215} {:answer/id #uuid "da3ff54f-5a25-50da-b204-8695bcb437f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-\\frac{9}{2})^{2}+(y+\\frac{1}{2})^{2}=\\frac{5\\sqrt{2}}{2}" :db/id #edb/ref 17592186548257} {:answer/id #uuid "ea42b5fa-8d2f-550e-9160-d2ffdc3c564b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-\\frac{9}{2})^{2}+(y+\\frac{1}{2})^{2}=\\frac{25}{2}" :db/id #edb/ref 17592186548262} {:answer/id #uuid "ec1aadba-47b2-5657-83f5-47a149777663" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+\\frac{9}{2})^{2}+(y-\\frac{1}{2})^{2}=\\frac{5\\sqrt{2}}{2}" :db/id #edb/ref 17592186548264}] :answer-field/correct {:answer/id #uuid "37d4082a-8911-5b7c-b50a-10c433cbf0c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+\\frac{9}{2})^{2}+(y-\\frac{1}{2})^{2}=\\frac{25}{2}" :db/id #edb/ref 17592186548215} :answer-field/id #uuid "16be170c-c7ff-5a97-93c7-1025786aea44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186548209}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0d76f3ef-fa61-505b-b0e2-335ce30237ba" :question/problem "![](images/07/0760173ffa9ede7dc926ff42ddc2a2474433408c2320bc6e37f7dc95ffde2dd1.png)\n\nThe circle above is centered at $C(- \\frac{9}{2},\\frac{1}{2})$ and the point $X(-7,3)$ lies on the circumference. Find the equation of the circle." :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is\n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nThe length of the radius is \n\n$$\n\\begin{aligned}CX & =\\sqrt{{(-7-(- \\frac{9}{2}))}^{2}+{(3-\\frac{1}{2})}^{2}} \\\\  & =\\sqrt{(- \\frac{5}{2})^{2}+{\\frac{5}{2}}^{2}} \\\\  & =\\sqrt{\\frac{25}{2}} \\\\  & =\\frac{5\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nSo, our circle is generated by the following equation:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x-(- \\frac{9}{2}))^{2}+(y-\\frac{1}{2})^{2} & =(\\frac{5\\sqrt{2}}{2})^{2} \\\\ (x+\\frac{9}{2})^{2}+(y-\\frac{1}{2})^{2} & =\\frac{25}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186548211 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "142cb5cf-eb17-5a66-bddf-259d1c11d2ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+\\frac{1}{2})^{2}+(y-\\frac{5}{2})^{2}=\\frac{49}{2}" :db/id #edb/ref 17592186548205} {:answer/id #uuid "598a7dfc-10dc-5ab3-9d18-c3cf3f01773e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-\\frac{1}{2})^{2}+(y+\\frac{5}{2})^{2}=\\frac{7\\sqrt{2}}{2}" :db/id #edb/ref 17592186548226} {:answer/id #uuid "679c2f50-d4ed-5457-be54-4c6140240698" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+\\frac{1}{2})^{2}+(y-\\frac{5}{2})^{2}=\\frac{7\\sqrt{2}}{2}" :db/id #edb/ref 17592186548231} {:answer/id #uuid "74cfed18-39c2-5554-8a0a-adc370f4e424" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-\\frac{1}{2})^{2}+(y+\\frac{5}{2})^{2}=\\frac{49}{2}" :db/id #edb/ref 17592186548235} {:answer/id #uuid "c334d9c2-5306-529f-bcff-4b35925d958a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+\\frac{1}{2})^{2}+(y+\\frac{5}{2})^{2}=\\frac{49}{2}" :db/id #edb/ref 17592186548253}] :answer-field/correct {:answer/id #uuid "142cb5cf-eb17-5a66-bddf-259d1c11d2ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+\\frac{1}{2})^{2}+(y-\\frac{5}{2})^{2}=\\frac{49}{2}" :db/id #edb/ref 17592186548205} :answer-field/id #uuid "60dba049-c375-5187-a142-54d6efdc2595" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186548230}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.diff