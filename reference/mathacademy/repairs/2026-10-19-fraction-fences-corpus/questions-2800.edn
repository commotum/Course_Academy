[{:db/id #edb/ref 17592186269099 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27242a80-102a-54fb-b4e8-9dd4359d2ba3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{91}{2}" :db/id #edb/ref 17592186266493} {:answer/id #uuid "6fbd0a72-843f-5ddf-a0b1-d6148f79222a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{91}{4}" :db/id #edb/ref 17592186267126} {:answer/id #uuid "88b53cc5-3255-567c-bee9-658e8260d0e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{91}{4}" :db/id #edb/ref 17592186267360} {:answer/id #uuid "97e05e7f-f7f7-591a-a987-e5c3463b5aa5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186267505} {:answer/id #uuid "fc3cbbff-aef8-5241-a45b-50106f1c074f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{91}{2}" :db/id #edb/ref 17592186268371}] :answer-field/correct {:answer/id #uuid "fc3cbbff-aef8-5241-a45b-50106f1c074f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{91}{2}" :db/id #edb/ref 17592186268371} :answer-field/id #uuid "ca8e6803-5f87-59fb-82a5-58502f9d93e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268770}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dd5426c2-f89c-51fb-b15d-1c1556603be5" :question/math-academy-id "q-136014" :question/problem "The coefficient of ${a}^{3}$ in the expansion of ${(1-\\frac{a}{2})}^{14}$ is" :question/worked-solution "The binomial expansion for $(1+x)^{n}$ is given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nIn particular, the ${x}^{3}$ term is given by\n\n$$\n\\frac{n(n-1)(n-2)}{3!}{x}^{3}.\n$$\n\nReplacing $x$ with $-\\frac{a}{2}$ and $n$ with $14$ in the above expression, we get\n\n$$\n\\begin{aligned}\\frac{14(14-1)(14-2)}{3!}\\cdot {(-\\frac{a}{2})}^{3} & =\\frac{14\\cdot 13\\cdot 12}{6}\\cdot (-\\frac{1}{{2}^{3}})\\cdot {a}^{3} \\\\  & =364\\cdot (-\\frac{1}{8}){a}^{3} \\\\  & =-\\frac{91}{2}{a}^{3}.\\end{aligned}\n$$\n\nTherefore, the coefficient of ${a}^{3}$ is $-\\frac{91}{2}.$"} {:db/id #edb/ref 17592186269101 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "166d92e1-f785-5381-a925-27911d4b10f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186266330} {:answer/id #uuid "19fdd8a1-df35-5179-aa91-2bd8199dde16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{28}{9}" :db/id #edb/ref 17592186266364} {:answer/id #uuid "20d60cb6-2d86-5021-aafe-7c0eb65aaeda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{9}" :db/id #edb/ref 17592186266438} {:answer/id #uuid "40569ff3-0a48-55eb-bc5c-4b4922537345" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{28}{9}" :db/id #edb/ref 17592186266725} {:answer/id #uuid "cbff721b-7322-568a-93a5-bd240b5e30f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{14}{9}" :db/id #edb/ref 17592186267971}] :answer-field/correct {:answer/id #uuid "20d60cb6-2d86-5021-aafe-7c0eb65aaeda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{9}" :db/id #edb/ref 17592186266438} :answer-field/id #uuid "409f6036-b6f3-56fa-be6d-b2d15afa8d77" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268515}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f4e7d779-c1af-5fa9-8575-868fa38eb63e" :question/math-academy-id "q-136018" :question/problem "The coefficient of ${b}^{4}$ in the expansion of ${(1-\\frac{b}{3})}^{9}$ is" :question/worked-solution "The binomial expansion for $(1+x)^{n}$ is given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nIn particular, the ${x}^{4}$ term is given by\n\n$$\n\\frac{n(n-1)(n-2)(n-3)}{4!}{x}^{4}.\n$$\n\nReplacing $x$ with $-\\frac{b}{3}$ and $n$ with $9$ in the above expression, we get\n\n$$\n\\begin{aligned}\\frac{9(9-1)(9-2)(9-3)}{4!}\\cdot {(-\\frac{b}{3})}^{4} & =\\frac{9\\cdot 8\\cdot 7\\cdot 6}{24}\\cdot {(-\\frac{1}{3})}^{4}\\cdot {b}^{4} \\\\  & =126\\cdot \\frac{1}{81}{b}^{4} \\\\  & =\\frac{14}{9}{b}^{4}.\\end{aligned}\n$$\n\nTherefore, the coefficient of ${b}^{4}$ is $\\frac{14}{9}.$"} {:db/id #edb/ref 17592186269124 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c2bb761-228f-5f80-bf79-35f3d1041925" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186266257} {:answer/id #uuid "481e6dde-7d1a-5d78-a456-ad0587ac7f59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186266787} {:answer/id #uuid "797076b8-a12f-58b4-b185-deebef2ea5ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186267217} {:answer/id #uuid "808abad3-8cfb-5cef-9ba9-9528bd396002" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186267275} {:answer/id #uuid "a07667fe-d0f2-58cc-9174-0cc9d29da7a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186267592}] :answer-field/correct {:answer/id #uuid "0c2bb761-228f-5f80-bf79-35f3d1041925" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186266257} :answer-field/id #uuid "d2b0f223-3ed8-5328-a462-a0050169775e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268786}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "25442a2f-79df-59e1-a659-8bc32badc551" :question/math-academy-id "q-136559" :question/problem "If $cot⁡x=\\frac{1}{4},$ then $4cot⁡(-x+4\\pi )+1=$" :question/worked-solution "First, let's recall the graph of $y=cot⁡x.$\n\n![](images/6e/6eb672fe024f024f20c7c3c80947d1b47bade8f998e705d6f411ae3f298ecde2.png)\n\nFrom the graph, we note the following:\n\n- The period of $cot⁡x$ is $\\pi .$\n\n- Our graph has rotational symmetry of order $2$ about the origin. This means that $cot⁡x$ is an *odd* function, and we have\n\n$$\ncot⁡(-x)=-cot⁡x.\n$$\n\nLet's now evaluate our expression:\n\n- Firstly, using the periodicity of $cot⁡x,$ we have\n\n$$\n\\begin{aligned}cot⁡(-x+4\\pi ) & =cot⁡(-x+\\pi \\cdot 4) \\\\  & =cot⁡(-x).\\end{aligned}\n$$\n\n- Secondly, using the oddness of $cot⁡x,$ we have\n\n$$\n\\begin{aligned}cot⁡(-x) & =-cot⁡x \\\\  & =-\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}4cot⁡(-x+4\\pi )+1 & =4\\cdot (-\\frac{1}{4})+1 \\\\  & =-1+1 \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "519b8fb0-5928-5ec9-8613-12c9d1306f72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186266873} {:answer/id #uuid "60890db1-c6f4-5143-9b9a-ae422da31c9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186266994} {:answer/id #uuid "87157abc-6212-562b-a343-90c57626ecf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2\\sqrt{3}}{3}" :db/id #edb/ref 17592186267338} {:answer/id #uuid "8b99c65a-2714-56e5-af5f-38d5a8ea0940" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{9}" :db/id #edb/ref 17592186267396} {:answer/id #uuid "919ec147-de01-530b-97cb-da754894b913" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186267439}] :answer-field/correct {:answer/id #uuid "8b99c65a-2714-56e5-af5f-38d5a8ea0940" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{9}" :db/id #edb/ref 17592186267396} :answer-field/id #uuid "8c52e3dd-dd13-5927-892c-f499bebd302f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268655}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "996adb7b-cb39-5733-9d5d-ec3bcfe1a670" :question/math-academy-id "q-13663" :question/problem "Evaluate the integral ${\\int }_{\\pi /9}^{\\pi /6}2{csc}^{2}⁡(3x)\\,\\text{d}x.$" :question/worked-solution "If we let $u=3x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $\\pi /9$ | $\\pi /6$ |\n| --- | --- | --- |\n| $u$ | $\\pi /3$ | $\\pi /2$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{\\pi /9}^{\\pi /6}2{csc}^{2}⁡(3x)\\,\\text{d}x & ={\\int }_{\\pi /3}^{\\pi /2}2{csc}^{2}⁡u\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{2}{3}{\\int }_{\\pi /3}^{\\pi /2}{csc}^{2}⁡u\\,\\text{d}u \\\\  & =-\\frac{2}{3}\\operatorname{cot}⁡u{|}_{\\pi /3}^{\\pi /2} \\\\  & =-\\frac{2}{3}(\\operatorname{cot}⁡(\\frac{\\pi }{2})-\\operatorname{cot}⁡(\\frac{\\pi }{3})) \\\\  & =-\\frac{2}{3}(0-\\frac{\\sqrt{3}}{3}) \\\\  & =\\frac{2\\sqrt{3}}{9}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269137 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a1c90f3-c1b6-573f-ab6c-07ec11bf9f28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266365} {:answer/id #uuid "4aab64f6-7242-5884-9cd4-b0a3a4a9143e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186266805} {:answer/id #uuid "5bba4d55-7c36-5233-8c45-c58d4705d39d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186266956} {:answer/id #uuid "90976ab1-62e5-54ff-a6c5-42bb9d3b1bf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186267431} {:answer/id #uuid "ba4dfd78-93dd-5e18-9a5e-04b304c3c8d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186267816}] :answer-field/correct {:answer/id #uuid "1a1c90f3-c1b6-573f-ab6c-07ec11bf9f28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266365} :answer-field/id #uuid "5364be24-88fb-5a2f-b7c6-4e394496b06e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268556}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "26d67fbf-4de7-566c-9152-9d1736d17888" :question/math-academy-id "q-137061" :question/problem "$$\n\\left\\{\\begin{aligned}2{x}_{1}-4{x}_{2} &=-3 \\\\ {x}_{1}-2{x}_{2} &=1 \\\\ -5{x}_{1}+10{x}_{2} &=2\\end{aligned}\\right.\n$$\n\nConsider the system of linear equations shown above. If the general least-squares solution of the system is given by\n\n$$\n\\begin{bmatrix}a \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}b \\\\ c\\end{bmatrix},\\,{x}_{2}\\in R\n$$\n\nwhat is the value of $2a+\\frac{b}{c}?$" :question/worked-solution "First, we write our system in matrix form as $Ax=b,$ where \n\n$$\nA=\\begin{bmatrix}2 & -4 \\\\ 1 & -2 \\\\ -5 & 10\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix},\\,b=\\begin{bmatrix}-3 \\\\ 1 \\\\ 2\\end{bmatrix}.\n$$\n\nThe least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}2 & 1 & -5 \\\\ -4 & -2 & 10\\end{bmatrix}\\begin{bmatrix}2 & -4 \\\\ 1 & -2 \\\\ -5 & 10\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}2 & 1 & -5 \\\\ -4 & -2 & 10\\end{bmatrix}\\begin{bmatrix}-3 \\\\ 1 \\\\ 2\\end{bmatrix} \\\\ \\begin{bmatrix}30 & -60 \\\\ -60 & 120\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-15 \\\\ 30\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the above matrix equation using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -2 & -\\frac{1}{2} \\\\ -2 & 4 & 1\\end{bmatrix} & {R}_{2}:={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & -\\frac{1}{2} \\\\ 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=-\\frac{1}{2}+2{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}-\\frac{1}{2}+2{x}_{2} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}-\\frac{1}{2} \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\n2a+\\frac{b}{c}=2\\cdot (-\\frac{1}{2})+\\frac{2}{1}=1.\n$$"} {:db/id #edb/ref 17592186269138 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71872f14-7cc4-5fb9-8cf7-9ffe96aefe19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186267142} {:answer/id #uuid "725897a0-9e77-57f9-b8a9-68f56715093b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186267146} {:answer/id #uuid "828574ad-8b28-58c3-ac93-daffbb878a55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186267291} {:answer/id #uuid "9d160852-1af1-56d1-8d23-a808bbfc6b00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186267556} {:answer/id #uuid "edbdca09-407a-5b44-b814-062fce5150c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186268256}] :answer-field/correct {:answer/id #uuid "828574ad-8b28-58c3-ac93-daffbb878a55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186267291} :answer-field/id #uuid "b1b80840-f020-56db-8303-eb251d19e950" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268722}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cb576d6c-dcbf-591c-a5dd-97e97349a8f0" :question/math-academy-id "q-137095" :question/problem "$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2} &=1 \\\\ 3{x}_{1}-3{x}_{2} &=4 \\\\ -2{x}_{1}+2{x}_{2} &=3\\end{aligned}\\right.\n$$\n\nConsider the system of linear equations shown above. If the general least-squares solution of the system is given by\n\n$$\n\\begin{bmatrix}a \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}b \\\\ c\\end{bmatrix},\\,{x}_{2}\\in R\n$$\n\nwhat is the value of $4a+\\frac{b}{c}?$" :question/worked-solution "First, we write our system in matrix form as $Ax=b,$ where \n\n$$\nA=\\begin{bmatrix}1 & -1 \\\\ 3 & -3 \\\\ -2 & 2\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix},\\,b=\\begin{bmatrix}1 \\\\ 4 \\\\ 3\\end{bmatrix}.\n$$\n\nThe least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & 3 & -2 \\\\ -1 & -3 & 2\\end{bmatrix}\\begin{bmatrix}1 & -1 \\\\ 3 & -3 \\\\ -2 & 2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & 3 & -2 \\\\ -1 & -3 & 2\\end{bmatrix}\\begin{bmatrix}1 \\\\ 4 \\\\ 3\\end{bmatrix} \\\\ \\begin{bmatrix}14 & -14 \\\\ -14 & 14\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}7 \\\\ -7\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the above matrix equation using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}14 & -14 & 7 \\\\ -14 & 14 & -7\\end{bmatrix} & {R}_{2}:={R}_{2}+{R}_{1} \\\\  & ∼\\begin{bmatrix}14 & -14 & 7 \\\\ 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=\\frac{1}{2}+{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}\\frac{1}{2}+{x}_{2} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}\\frac{1}{2} \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\n4a+\\frac{b}{c}=4\\cdot (\\frac{1}{2})+\\frac{1}{1}=3.\n$$"} {:db/id #edb/ref 17592186269140 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b66e8f9-798c-5fb5-9702-3848b450ff05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186266376} {:answer/id #uuid "1c88a6e9-e50e-5742-b36a-eb35a929b299" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186266387} {:answer/id #uuid "275bb128-5a9f-5d1f-abdd-0647ca8896e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266494} {:answer/id #uuid "5ed0a256-a969-57ba-a38b-d639f21e2e86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186266980} {:answer/id #uuid "7b3b665d-ddd7-5f8f-a302-3a3d75a9b19e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186267232}] :answer-field/correct {:answer/id #uuid "5ed0a256-a969-57ba-a38b-d639f21e2e86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186266980} :answer-field/id #uuid "343b4b87-3893-598e-8c73-4fe5b3ba88f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268495}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "93179ecb-11e4-5253-ab06-7702070386da" :question/math-academy-id "q-137097" :question/problem "$$\n\\left\\{\\begin{aligned}-{x}_{1}+{x}_{2} &=-4 \\\\ {x}_{1}-{x}_{2} &=2 \\\\ 5{x}_{1}-5{x}_{2} &=-3\\end{aligned}\\right.\n$$\n\nConsider the system of linear equations shown above. If the general least-squares solution of the system is given by\n\n$$\n\\begin{bmatrix}a \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}b \\\\ c\\end{bmatrix},\\,{x}_{2}\\in R\n$$\n\nwhat is the value of $-9a+\\frac{b}{c}?$" :question/worked-solution "First, we write our system in matrix form as $Ax=b,$ where \n\n$$\nA=\\begin{bmatrix}-1 & 1 \\\\ 1 & -1 \\\\ 5 & -5\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix},\\,b=\\begin{bmatrix}-4 \\\\ 2 \\\\ -3\\end{bmatrix}.\n$$\n\nThe least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}-1 & 1 & 5 \\\\ 1 & -1 & -5\\end{bmatrix}\\begin{bmatrix}-1 & 1 \\\\ 1 & -1 \\\\ 5 & -5\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-1 & 1 & 5 \\\\ 1 & -1 & -5\\end{bmatrix}\\begin{bmatrix}-4 \\\\ 2 \\\\ -3\\end{bmatrix} \\\\ \\begin{bmatrix}27 & -27 \\\\ -27 & 27\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-9 \\\\ 9\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the final matrix equation using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}27 & -27 & -9 \\\\ -27 & 27 & 9\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}27 & -27 & -9 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=-\\frac{1}{3}+{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}-\\frac{1}{3}+{x}_{2} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}-\\frac{1}{3} \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\n-9a+\\frac{b}{c}=-9\\cdot (-\\frac{1}{3})+\\frac{1}{1}=4.\n$$"} {:db/id #edb/ref 17592186269141 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47c10002-500f-5b1c-9ac3-3bccf7a34be4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186266786} {:answer/id #uuid "6a9f182d-98f4-54f1-b0c2-ab6dea49e81a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186267087} {:answer/id #uuid "6e9ed506-cab1-5977-a1b0-8323058b9941" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186267114} {:answer/id #uuid "7aae27b3-24bc-58a7-8eb4-69dda6ad9f1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267226} {:answer/id #uuid "b759c551-e5e4-5b83-9eba-bf5f0616ed57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186267788}] :answer-field/correct {:answer/id #uuid "7aae27b3-24bc-58a7-8eb4-69dda6ad9f1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267226} :answer-field/id #uuid "9274ef15-b4ba-50d9-b139-ab18e30c28bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268662}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "58ba77df-63a2-5a9b-ba59-e2f2dbd16055" :question/math-academy-id "q-137119" :question/problem "$$\n\\left\\{\\begin{aligned}-{x}_{1}+2{x}_{2} &=3 \\\\ 2{x}_{1}-4{x}_{2} &=-2 \\\\ 3{x}_{1}-6{x}_{2} &=1\\end{aligned}\\right.\n$$\n\nConsider the system of linear equations shown above. If the general least-squares solution of the system is given by\n\n$$\n\\begin{bmatrix}a \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}b \\\\ c\\end{bmatrix},\\,{x}_{2}\\in R\n$$\n\nwhat is the value of $7a+\\frac{b}{c}?$" :question/worked-solution "First, we write our system in matrix form as $Ax=b,$ where \n\n$$\nA=\\begin{bmatrix}-1 & 2 \\\\ 2 & -4 \\\\ 3 & -6\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix},\\,b=\\begin{bmatrix}3 \\\\ -2 \\\\ 1\\end{bmatrix}.\n$$\n\nThe least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}-1 & 2 & 3 \\\\ 2 & -4 & -6\\end{bmatrix}\\begin{bmatrix}-1 & 2 \\\\ 2 & -4 \\\\ 3 & -6\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-1 & 2 & 3 \\\\ 2 & -4 & -6\\end{bmatrix}\\begin{bmatrix}3 \\\\ -2 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}14 & -28 \\\\ -28 & 56\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-4 \\\\ 8\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the final matrix equation using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}14 & -28 & -4 \\\\ -28 & 56 & 8\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+2{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}14 & -28 & -4 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=-\\frac{2}{7}+2{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}-\\frac{2}{7}+2{x}_{2} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}-\\frac{2}{7} \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\n7a+\\frac{b}{c}=7\\cdot (-\\frac{2}{7})+\\frac{2}{1}=0.\n$$"} {:db/id #edb/ref 17592186269150 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fbe1e45-425c-5d24-9a2e-b0d2bc2b4422" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{100}{9}" :db/id #edb/ref 17592186266423} {:answer/id #uuid "222530ab-2dcc-5d51-9809-57c96320b41e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{100}{81}" :db/id #edb/ref 17592186266449} {:answer/id #uuid "5f41e2cc-d2de-56ef-80d2-9ac7568a671c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{27}" :db/id #edb/ref 17592186266986} {:answer/id #uuid "7daa41e8-6e90-5e70-8402-bd9770caa41f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{80}{9}" :db/id #edb/ref 17592186267255} {:answer/id #uuid "a3c299e5-a721-5088-944a-c9d0c0bc8ecf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{40}{81}" :db/id #edb/ref 17592186267617}] :answer-field/correct {:answer/id #uuid "222530ab-2dcc-5d51-9809-57c96320b41e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{100}{81}" :db/id #edb/ref 17592186266449} :answer-field/id #uuid "a01b2373-b791-524c-ae21-c98d1b57c90b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268689}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6e36897b-696c-54c5-85d9-3c04b5f56902" :question/math-academy-id "q-13786" :question/problem "${\\int }_{0}^{\\operatorname{ln}⁡3}5{e}^{-4x}\\,\\text{d}x=$" :question/worked-solution "If we let $u=-4x,$ then, \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-4\\,⟹\\,-\\frac{1}{4}\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $\\operatorname{ln}⁡3$ |\n| --- | --- | --- |\n| $u$ | $0$ | $-4\\operatorname{ln}⁡3$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡3}5{e}^{-4x}\\,\\text{d}x & =5{\\int }_{0}^{\\operatorname{ln}⁡3}{e}^{-4x}\\,\\text{d}x \\\\  & =5{\\int }_{0}^{-4\\operatorname{ln}⁡3}{e}^{u}(-\\frac{1}{4})\\text{d}u \\\\  & =-\\frac{5}{4}{\\int }_{0}^{\\operatorname{ln}⁡({3}^{-4})}{e}^{u}\\text{d}u \\\\  & =-\\frac{5}{4}({e}^{u}){|}_{0}^{\\operatorname{ln}⁡({3}^{-4})} \\\\  & =-\\frac{5}{4}({e}^{\\operatorname{ln}⁡({3}^{-4})}-{e}^{0}) \\\\  & =-\\frac{5}{4}({3}^{-4}-1) \\\\  & =-\\frac{5}{4}(\\frac{1}{{3}^{4}}-1) \\\\  & =-\\frac{5}{4}(\\frac{1}{81}-1) \\\\  & =-\\frac{5}{4}(-\\frac{80}{81}) \\\\  & =\\frac{100}{81}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269157 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50f20ae7-abd3-5f44-993f-508d38288225" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186266868} {:answer/id #uuid "72c6ad65-aa21-5871-bbdd-ae9be001132a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186267150} {:answer/id #uuid "7b668a07-a7f7-5301-a9ad-260bdef00bd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186267234} {:answer/id #uuid "b2a2dcef-70bc-513c-933f-5670bdbaeb08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186267743} {:answer/id #uuid "c5262c9a-0c15-5b79-95b3-1639a4ba997a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186267910}] :answer-field/correct {:answer/id #uuid "72c6ad65-aa21-5871-bbdd-ae9be001132a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186267150} :answer-field/id #uuid "97862143-c8cb-59a2-ad09-aef226dfbf0a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268672}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "80a60424-3ff9-5896-996b-077192e08a91" :question/math-academy-id "q-137920" :question/problem "$$\nA=\\begin{bmatrix}3 & 2 \\\\ 0 & 0 \\\\ -3 & -2\\end{bmatrix},\\,b=\\begin{bmatrix}16 \\\\ -3 \\\\ -1\\end{bmatrix},\\,W=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}.\n$$\n\nConsider the matrices $A$ and $W,$ and the vector $b$ shown above. If the general solution for the weighted least-squares problem $W\\,Ax=Wb$ is \n\n$$\n\\begin{bmatrix}a \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}b \\\\ c\\end{bmatrix},\\,{x}_{2}\\in R,\n$$\n\nwhat is the value of  $a+\\frac{b}{c}?$" :question/worked-solution "To get the normal equation corresponding to $W\\,Ax=Wb,$ we pre-multiply both sides of the equation by $(W\\,A)^{T}:$\n\n$$\n\\begin{aligned}(W\\,A)^{T}\\cdot W\\,Ax & =(W\\,A)^{T}\\cdot Wb \\\\ {A}^{T}({W}^{T}W)Ax & ={A}^{T}({W}^{T}W)b\\end{aligned}\n$$\n\nNow, since\n\n$$\n{W}^{T}W=\\begin{bmatrix}{1}^{2} & 0 & 0 \\\\ 0 & {2}^{2} & 0 \\\\ 0 & 0 & {2}^{2}\\end{bmatrix}=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 4\\end{bmatrix},\n$$\n\nour normal equation can be written as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}3 & 0 & -3 \\\\ 2 & 0 & -2\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 4\\end{bmatrix}\\begin{bmatrix}3 & 2 \\\\ 0 & 0 \\\\ -3 & -2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}3 & 0 & -3 \\\\ 2 & 0 & -2\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 4\\end{bmatrix}\\begin{bmatrix}16 \\\\ -3 \\\\ -1\\end{bmatrix} \\\\ \\begin{bmatrix}3 & 0 & -3 \\\\ 2 & 0 & -2\\end{bmatrix}\\begin{bmatrix}3 & 2 \\\\ 0 & 0 \\\\ -12 & -8\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}3 & 0 & -3 \\\\ 2 & 0 & -2\\end{bmatrix}\\begin{bmatrix}16 \\\\ -12 \\\\ -4\\end{bmatrix} \\\\ \\begin{bmatrix}45 & 30 \\\\ 30 & 20\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}60 \\\\ 40\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the above matrix equation using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}45 & 30 & 60 \\\\ 30 & 20 & 40\\end{bmatrix} & {R}_{2}:={R}_{2}-\\frac{2}{3}{R}_{1} \\\\  & ∼\\begin{bmatrix}45 & 30 & 60 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=\\frac{4}{3}-\\frac{2}{3}{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}\\frac{4}{3}-\\frac{2}{3}{x}_{2} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}\\frac{4}{3} \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-\\frac{2}{3} \\\\ 1\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\na+\\frac{b}{c}=\\frac{4}{3}+\\frac{(-\\frac{2}{3})}{1}=\\frac{2}{3}.\n$$"} {:db/id #edb/ref 17592186269178 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07d04d58-ea92-537e-8344-fad5afacac09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R=2" :db/id #edb/ref 17592186266211} {:answer/id #uuid "0c0fe4be-e4f4-5a08-aa12-60f9befa3eac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R=0" :db/id #edb/ref 17592186266256} {:answer/id #uuid "20bc8c07-d1fe-5e01-96dc-08e42deed0b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R=1" :db/id #edb/ref 17592186266436} {:answer/id #uuid "94684d27-848e-50d7-b1ed-7257727a2d5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R=\\frac{1}{2}" :db/id #edb/ref 17592186267470} {:answer/id #uuid "c9187334-39c0-5da8-bfda-b838a3766c0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R=\\infty " :db/id #edb/ref 17592186267946}] :answer-field/correct {:answer/id #uuid "c9187334-39c0-5da8-bfda-b838a3766c0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R=\\infty " :db/id #edb/ref 17592186267946} :answer-field/id #uuid "73fbe658-1bb1-5d38-8fe0-66ada0a915d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268623}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "15de46ea-5bb2-5f10-a945-05b14689fc18" :question/math-academy-id "q-13835" :question/problem "Find the radius of convergence $R$ for the series\n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{(x-1)^{3n}}{{n}^{n}}=(x-1)^{3}+\\frac{(x-1)^{6}}{{2}^{2}}+\\frac{(x-1)^{9}}{{3}^{3}}+⋯\\,.\n$$" :question/worked-solution "To apply the ratio test we define ${a}_{n}=\\frac{(x-1)^{3n}}{{n}^{n}}.$ Then, we calculate the ratio of two successive terms and take the limit as $n\\to \\infty :$\n\n$$\n\\begin{aligned}L & ={lim}_{n\\to \\infty }|\\frac{{a}_{n+1}}{{a}_{n}}| \\\\  & ={lim}_{n\\to \\infty }|\\frac{(x-1)^{3(n+1)}}{(n+1)^{n+1}}\\cdot \\frac{{n}^{n}}{(x-1)^{3n}}| \\\\  & ={lim}_{n\\to \\infty }|\\frac{(x-1)^{3}}{(n+1)}\\cdot {(\\frac{n}{n+1})}^{n}| \\\\  & =|x-1{|}^{3}{lim}_{n\\to \\infty }\\frac{1}{(n+1)}\\cdot {(\\frac{n}{n+1})}^{n} \\\\  & =|x-1{|}^{3}\\cdot 0\\cdot {e}^{-1} \\\\  & =0\\end{aligned}\n$$\n\nThe series converges if $L<1.$ In this case, the convergence condition is satisfied for all $-\\infty <x<\\infty .$ Therefore, we conclude that the radius of convergence is $R=\\infty .$"} {:db/id #edb/ref 17592186269189 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12d74a74-5f32-5de1-9436-d960386a0a33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{t\\sqrt{t}}" :db/id #edb/ref 17592186266306} {:answer/id #uuid "3f1909ad-6fd3-5528-a71d-22d59e6e17f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+\\frac{5}{t\\sqrt{t}}" :db/id #edb/ref 17592186266711} {:answer/id #uuid "527a6315-facf-516d-8ddf-af636b43706c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{t\\sqrt{t}}" :db/id #edb/ref 17592186266882} {:answer/id #uuid "77bbf92e-c9b0-57f6-b088-dfc199dda85e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5t\\sqrt{t}" :db/id #edb/ref 17592186267193} {:answer/id #uuid "d42c058a-5bd2-5ed5-ac22-cc2d9c4969b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+t\\sqrt{t}" :db/id #edb/ref 17592186268037}] :answer-field/correct {:answer/id #uuid "12d74a74-5f32-5de1-9436-d960386a0a33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{t\\sqrt{t}}" :db/id #edb/ref 17592186266306} :answer-field/id #uuid "622b6848-ee01-58c6-a1b5-cac192d8f419" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268586}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "82349ab0-48c7-53d1-acea-6398c2dc41bd" :question/math-academy-id "q-138902" :question/problem "A body of mass $5\\,\\text{kg}$ is moving in a straight line along the $x$-axis under the action of a single force $F,$ measured in Newtons.\nAt time $t$ seconds, the position of the body is given by $s(t)=t-4\\sqrt{t}$ meters.\nFind the expression for the force acting on the body at time $t.$" :question/worked-solution "According to Newton’s second law\n\n$$\nF=ma,\n$$\n\n \nwhere $F$ is the force, $m$ is the mass, and $a$ is the acceleration.\n\nTo find the velocity $v(t),$ we differentiate the displacement $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t-4\\sqrt{t}) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t-4{t}^{1/2}) \\\\  & =1-4\\cdot \\frac{1}{2}\\cdot {t}^{-1/2} \\\\  & =1-2{t}^{-1/2}\\end{aligned}\n$$\n\nTo find the acceleration $a(t),$ we differentiate the velocity $v(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(1-2{t}^{-1/2}) \\\\  & =0-2\\cdot (-\\frac{1}{2})\\cdot {t}^{-3/2} \\\\  & ={t}^{-3/2} \\\\  & =\\frac{1}{t\\sqrt{t}}\\end{aligned}\n$$\n\nTherefore, the force in Newtons is\n\n$$\n\\begin{aligned}F & =ma \\\\  & =5\\cdot (\\frac{1}{t\\sqrt{t}}) \\\\  & =\\frac{5}{t\\sqrt{t}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269195 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20f52907-376f-58e5-9f0f-da81901fc736" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi {\\int }_{0}^{2}{t}^{3}\\sqrt{3{t}^{3}+2t}\\,\\text{d}t" :db/id #edb/ref 17592186266440} {:answer/id #uuid "58cbd7b6-abea-576a-9211-9a29b5a57846" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{2}{t}^{3}\\sqrt{3{t}^{4}+2}\\,\\text{d}t" :db/id #edb/ref 17592186266937} {:answer/id #uuid "69ef40dd-ca0b-5fc8-92c8-b615b45f9c9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{2}({t}^{2}+1)\\sqrt{4{t}^{2}+9t}\\,\\text{d}t" :db/id #edb/ref 17592186267084} {:answer/id #uuid "80b104c5-78ea-5252-8a09-f663862d16d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{2}{t}^{4}\\sqrt{9{t}^{2}+4}\\,\\text{d}t" :db/id #edb/ref 17592186267278} {:answer/id #uuid "b5066764-a6d0-5069-8980-fa9bb72ab467" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi {\\int }_{0}^{2}{t}^{4}\\sqrt{{t}^{3}+{t}^{2}+1}\\,\\text{d}t" :db/id #edb/ref 17592186267763}] :answer-field/correct {:answer/id #uuid "80b104c5-78ea-5252-8a09-f663862d16d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{2}{t}^{4}\\sqrt{9{t}^{2}+4}\\,\\text{d}t" :db/id #edb/ref 17592186267278} :answer-field/id #uuid "7a60b592-7214-5cc5-a50b-3ca8b85d5135" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268630}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f61336c1-ae50-5d39-92f7-f30e180cdcc2" :question/math-academy-id "q-138968" :question/problem "Consider the curve defined parametrically as \n\n$$\nx={t}^{2}+1,\\,y={t}^{3},\\,t\\in [0,2].\n$$\n\nWhat integral gives the surface area generated when this curve is rotated $2\\pi $ radians about the $x$-axis?" :question/worked-solution "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $x$-axis using the formula\n\n$$\nS=\\int 2\\pi y\\,\\text{d}s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\text{d}s=\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}y\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nWe are told that the limits of integration are from ${t}_{1}=0$ to ${t}_{2}=2.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+1)=2t \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3})=3{t}^{2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}y\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{2}{t}^{3}\\sqrt{{(2t)}^{2}+{(3{t}^{2})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{2}{t}^{3}\\sqrt{4{t}^{2}+9{t}^{4}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{2}{t}^{3}\\sqrt{{t}^{2}(4+9{t}^{2})}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{2}{t}^{3}\\cdot \\sqrt{{t}^{2}}\\cdot \\sqrt{(4+9{t}^{2})}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{2}{t}^{3}\\cdot |t|\\cdot \\sqrt{9{t}^{2}+4}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{2}{t}^{3}\\cdot t\\cdot \\sqrt{9{t}^{2}+4}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{2}{t}^{4}\\sqrt{9{t}^{2}+4}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269196 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13839232-8d87-59a3-9b8d-bacadc004415" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2{e}^{2}-e+3)\\pi " :db/id #edb/ref 17592186266313} {:answer/id #uuid "17bb2493-06a6-5878-abac-cc29e4177f77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({e}^{2}+3e-1)\\pi " :db/id #edb/ref 17592186266340} {:answer/id #uuid "58fd1066-e0a0-5827-a09d-7636a3dc7b45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({e}^{2}-3)\\pi " :db/id #edb/ref 17592186266939} {:answer/id #uuid "9c9f8b56-950e-5fc0-acba-70213d8413ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({e}^{2}+2e-6)\\pi " :db/id #edb/ref 17592186267550} {:answer/id #uuid "f38e7423-e623-5d23-af2b-9075978a43f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({e}^{2}+6e)\\pi " :db/id #edb/ref 17592186268310}] :answer-field/correct {:answer/id #uuid "9c9f8b56-950e-5fc0-acba-70213d8413ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({e}^{2}+2e-6)\\pi " :db/id #edb/ref 17592186267550} :answer-field/id #uuid "66fe675b-1c4e-5167-8629-e46024eddc4f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268595}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "17c2517d-ea91-514b-ace4-ddd9a79ca203" :question/math-academy-id "q-138979" :question/problem "Consider the curve defined parametrically as \n\n$$\nx={e}^{t}-t,\\,y=4{e}^{t/2},\\,t\\in [0,1].\n$$\n\nCalculate the surface area generated when this curve is rotated $2\\pi $ radians about the $y$-axis." :question/worked-solution "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\text{d}s=\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nWe are told that the limits of integration are from ${t}_{1}=0$ to ${t}_{2}=1.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t}-t)={e}^{t}-1 \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4{e}^{t/2})=2{e}^{t/2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}({e}^{t}-t)\\sqrt{{({e}^{t}-1)}^{2}+{(2{e}^{t/2})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}({e}^{t}-t)\\sqrt{{e}^{2t}-2{e}^{t}+1+4{e}^{t}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}({e}^{t}-t)\\sqrt{{e}^{2t}+2{e}^{t}+1}\\,\\text{d}t\\end{aligned}\n$$\n\nNow, factoring the expression ${e}^{2t}+2{e}^{t}+1,$ we can rewrite our integral as follows:\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{0}^{1}({e}^{t}-t)\\sqrt{{e}^{2t}+2{e}^{t}+1}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}({e}^{t}-t)\\sqrt{({e}^{t}+1)^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}({e}^{t}-t)\\cdot |{e}^{t}+1|\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}({e}^{t}-t)\\cdot ({e}^{t}+1)\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}({e}^{2t}+{e}^{t}-t{e}^{t}-t)\\,\\text{d}t \\\\  & =2\\pi [{\\int }_{0}^{1}({e}^{2t}+{e}^{t}-t)\\,\\text{d}t-{\\int }_{0}^{1}t{e}^{t}\\,\\text{d}t]\\end{aligned}\n$$\n\nWe evaluate the integral ${\\int }_{0}^{1}t{e}^{t}\\,\\text{d}t$ using integration by parts. We set\n\n$$\n\\begin{aligned}u=t & ⇒ & {u}^{′}=1 \\\\ {v}^{′}={e}^{t} & ⇒ & v={e}^{t}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int t{e}^{t}\\,\\text{d}x & =t{e}^{t}-\\int {e}^{t}\\cdot 1\\,\\text{d}x \\\\  & =t{e}^{t}-{e}^{t}.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}S & =2\\pi [{\\int }_{0}^{1}({e}^{2t}+{e}^{t}-t)\\,\\text{d}t-{\\int }_{0}^{1}t{e}^{t}\\,\\text{d}t] \\\\  & =2\\pi [{(\\frac{1}{2}{e}^{2t}+{e}^{t}-\\frac{1}{2}{t}^{2})|}_{0}^{1}-{(t{e}^{t}-{e}^{t})|}_{0}^{1}] \\\\  & =2\\pi [(\\frac{1}{2}{e}^{2}+e-\\frac{1}{2})-(\\frac{1}{2}+1-0)-(e-e)+(0-1)] \\\\  & =2\\pi [\\frac{1}{2}{e}^{2}+e-3] \\\\  & =({e}^{2}+2e-6)\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269197 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a734ae6-ad53-5c8b-853f-11b5c90cc765" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9\\sqrt{10}\\pi }{3}" :db/id #edb/ref 17592186266803} {:answer/id #uuid "4dc6ba65-8711-5579-ac2d-e6cc71104f50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{696\\pi }{5}" :db/id #edb/ref 17592186266835} {:answer/id #uuid "6f8c7fb8-37eb-56c6-8899-ba5700238898" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{112\\sqrt{6}\\pi }{3}" :db/id #edb/ref 17592186267123} {:answer/id #uuid "98aa6145-1a2b-5511-9ffa-cb62e5222fe7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{142\\pi }{5}" :db/id #edb/ref 17592186267520} {:answer/id #uuid "af5d211f-c178-5441-b4e9-4240e0b8201a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{112\\pi }{5}" :db/id #edb/ref 17592186267722}] :answer-field/correct {:answer/id #uuid "4dc6ba65-8711-5579-ac2d-e6cc71104f50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{696\\pi }{5}" :db/id #edb/ref 17592186266835} :answer-field/id #uuid "3aba4f78-b682-5138-9a79-b93fe2ee5eeb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268500}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "47912027-a927-58fe-87e4-6e2c0ef1bce2" :question/math-academy-id "q-139013" :question/problem "Consider the curve defined parametrically as \n\n$$\nx=3{t}^{2},\\,y=2{t}^{3},\\,t\\in [0,\\sqrt{3}].\n$$\n\nCalculate the surface area generated when this curve is rotated $2\\pi $ radians about the $y$-axis." :question/worked-solution "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\text{d}s=\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nWe are told that the limits of integration are from ${t}_{1}=0$ to ${t}_{2}=\\sqrt{3}.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3{t}^{2})=6t \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{3})=6{t}^{2}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\sqrt{3}}3{t}^{2}\\sqrt{{(6t)}^{2}+{(6{t}^{2})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\sqrt{3}}3{t}^{2}\\sqrt{36{t}^{2}+36{t}^{4}}\\,\\text{d}t\\end{aligned}\n$$\n\nNow, factoring the expression $36{t}^{2}+36{t}^{4},$ we can rewrite our integral as follows:\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{0}^{\\sqrt{3}}3{t}^{2}\\sqrt{36{t}^{2}+36{t}^{4}}\\,\\text{d}t] \\\\  & =2\\pi {\\int }_{0}^{\\sqrt{3}}3{t}^{2}\\sqrt{36{t}^{2}(1+{t}^{2})}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\sqrt{3}}3{t}^{2}\\cdot |6t|\\sqrt{1+{t}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\sqrt{3}}3{t}^{2}\\cdot 6t\\sqrt{1+{t}^{2}}\\,\\text{d}t \\\\  & =18\\pi {\\int }_{0}^{\\sqrt{3}}2{t}^{3}\\sqrt{1+{t}^{2}}\\,\\text{d}t\\end{aligned}\n$$\n\nWe evaluate the last integral using the substitution $u=1+{t}^{2}$ Then, ${t}^{2}=u-1$ and $\\text{d}u=2t\\,\\text{d}t.$ We also need to compute new limits, given below.\n\n| **$t$** | $0$ | $\\sqrt{3}$ |\n| --- | --- | --- |\n| $u$ | $1$ | $4$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}S & =18\\pi {\\int }_{0}^{\\sqrt{3}}2{t}^{3}\\sqrt{1+{t}^{2}}\\,\\text{d}t \\\\  & =18\\pi {\\int }_{0}^{\\sqrt{3}}2t\\cdot {t}^{2}\\sqrt{1+{t}^{2}}\\,\\text{d}t \\\\  & =18\\pi {\\int }_{1}^{4}(u-1)\\sqrt{u}\\,\\text{d}u \\\\  & =18\\pi {\\int }_{1}^{4}(u-1){u}^{1/2}\\,\\text{d}u \\\\  & =18\\pi {\\int }_{1}^{4}({u}^{3/2}-{u}^{1/2})\\,\\text{d}u \\\\  & =18\\pi \\cdot {[\\frac{2{u}^{5/2}}{5}-\\frac{2{u}^{3/2}}{3}]}_{1}^{4} \\\\  & =18\\pi [(\\frac{2({4}^{5/2})}{5}-\\frac{2({4}^{3/2})}{3})-(\\frac{2}{5}-\\frac{2}{3})] \\\\  & =18\\pi \\cdot [(\\frac{64}{5}-\\frac{16}{3})-(\\frac{2}{5}-\\frac{2}{3})) \\\\  & =18\\pi \\cdot (\\frac{62}{5}-\\frac{14}{3}) \\\\  & =18\\pi \\cdot \\frac{116}{15} \\\\  & =\\frac{696\\pi }{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269198 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3eec1a88-5ac1-5655-b5b9-506affdea947" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{{e}^{4}+1}{{e}^{2}}+2)\\pi " :db/id #edb/ref 17592186266706} {:answer/id #uuid "42ac13b9-41e9-59cd-9363-e52d9d2df0b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{{e}^{4}-1}{{e}^{2}})\\pi " :db/id #edb/ref 17592186266740} {:answer/id #uuid "52c35db2-db3c-50b0-b7b7-ca2af455c51b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{{e}^{2}+1}{{e}^{2}}+1)\\pi " :db/id #edb/ref 17592186266883} {:answer/id #uuid "5caed885-d405-5b25-825a-3a90fdb7bbd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{{e}^{4}-1}{{e}^{2}}+4)\\pi " :db/id #edb/ref 17592186266961} {:answer/id #uuid "a6724166-5161-593e-985d-b003cd9ad331" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{{e}^{2}+2}{{e}^{2}})\\pi " :db/id #edb/ref 17592186267649}] :answer-field/correct {:answer/id #uuid "5caed885-d405-5b25-825a-3a90fdb7bbd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{{e}^{4}-1}{{e}^{2}}+4)\\pi " :db/id #edb/ref 17592186266961} :answer-field/id #uuid "94dfdeac-1a84-52d3-b8f5-431703753d0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268667}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "92033a8c-e070-5bf1-96cf-1791e3001bbe" :question/math-academy-id "q-139025" :question/problem "Consider the curve defined parametrically as \n\n$$\nx=2\\operatorname{ln}⁡t,\\,y=t+\\frac{1}{t},\\,t\\in [1,e].\n$$\n\nCalculate the surface area generated when this curve is rotated $2\\pi $ radians about the $x$-axis." :question/worked-solution "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $x$-axis using the formula\n\n$$\nS=\\int 2\\pi y\\,\\text{d}s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\text{d}s=\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}y\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nWe are told that the limits of integration are from ${t}_{1}=1$ to ${t}_{2}=e.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{ln}⁡t)=\\frac{2}{t} \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t+\\frac{1}{t})=1-\\frac{1}{{t}^{2}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}y\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{1}^{e}(t+\\frac{1}{t})\\sqrt{{(\\frac{2}{t})}^{2}+{(1-\\frac{1}{{t}^{2}})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{1}^{e}(t+\\frac{1}{t})\\sqrt{\\frac{4}{{t}^{2}}+1-\\frac{2}{{t}^{2}}+\\frac{1}{{t}^{4}}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{1}^{e}(t+\\frac{1}{t})\\sqrt{1+\\frac{2}{{t}^{2}}+\\frac{1}{{t}^{4}}}\\,\\text{d}t\\end{aligned}\n$$\n\nNow, factoring the expression $1+\\frac{2}{{t}^{2}}+\\frac{1}{{t}^{4}},$ we can rewrite our integral as follows:\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{1}^{e}(t+\\frac{1}{t})\\sqrt{1+\\frac{2}{{t}^{2}}+\\frac{1}{{t}^{4}}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{1}^{e}(t+\\frac{1}{t})\\sqrt{{(1+\\frac{1}{{t}^{2}})}^{2}} \\\\  & =2\\pi {\\int }_{1}^{e}(t+\\frac{1}{t})\\cdot |1+\\frac{1}{{t}^{2}}|\\,\\text{d}t \\\\  & =2\\pi {\\int }_{1}^{e}(t+\\frac{1}{t})\\cdot (1+\\frac{1}{{t}^{2}})\\,\\text{d}t \\\\  & =2\\pi {\\int }_{1}^{e}(\\frac{1}{{t}^{3}}+t+\\frac{2}{t})\\,\\text{d}t\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{1}^{e}(\\frac{1}{{t}^{3}}+t+\\frac{2}{t})\\,\\text{d}t \\\\  & =2\\pi \\cdot {[-\\frac{1}{2{t}^{2}}+\\frac{{t}^{2}}{2}+2\\operatorname{ln}⁡|t|]}_{1}^{e} \\\\  & =2\\pi [(-\\frac{1}{2{e}^{2}}+\\frac{{e}^{2}}{2}+2)-(-\\frac{1}{2}+\\frac{1}{2}+0)] \\\\  & =2\\pi [\\frac{{e}^{4}-1}{2{e}^{2}}+2] \\\\  & =(\\frac{{e}^{4}-1}{{e}^{2}}+4)\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269199 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c7ced12-adf7-50f3-8fa2-2ec760ae813e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\pi {\\int }_{0}^{2}\\operatorname{sinh}⁡t{cosh}^{2}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186266386} {:answer/id #uuid "3703b92c-5129-5033-ab98-50cdcbc36343" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\pi {\\int }_{0}^{2}\\operatorname{sinh}⁡t\\operatorname{cosh}⁡2t\\sqrt{1+4{cosh}^{2}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186266619} {:answer/id #uuid "6f246751-a997-50e1-bf3a-7397694c7bfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{2}\\operatorname{sinh}⁡t\\operatorname{cosh}⁡t\\sqrt{1+16{cosh}^{2}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186267119} {:answer/id #uuid "b4b60e5b-029c-5dc5-aa8c-ac5e6717b17d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi {\\int }_{0}^{2}{sinh}^{2}⁡t\\sqrt{1+8{cosh}^{2}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186267758} {:answer/id #uuid "b515549f-a4fa-5988-a574-c6ea0c940d9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi {\\int }_{0}^{2}\\operatorname{sinh}⁡2t\\,\\text{d}t" :db/id #edb/ref 17592186267765}] :answer-field/correct {:answer/id #uuid "6f246751-a997-50e1-bf3a-7397694c7bfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{2}\\operatorname{sinh}⁡t\\operatorname{cosh}⁡t\\sqrt{1+16{cosh}^{2}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186267119} :answer-field/id #uuid "ef12ad6f-e35f-52af-bb0c-cb7d265a65e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268825}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "46772b4c-c81a-56f5-89f5-3541c46cf9e9" :question/math-academy-id "q-139027" :question/problem "Consider the curve defined parametrically as \n\n$$\nx=\\operatorname{cosh}⁡t,\\,y=\\operatorname{cosh}⁡2t,\\,t\\in [0,2].\n$$\n\nWhat integral gives the surface area generated when this curve is rotated $2\\pi $ radians about the $y$-axis?" :question/worked-solution "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\text{d}s=\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nWe are told that the limits of integration are from ${t}_{1}=0$ to ${t}_{2}=2.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cosh}⁡t)=\\operatorname{sinh}⁡t \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cosh}⁡2t)=2\\operatorname{sinh}⁡2t.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{2}\\operatorname{cosh}⁡t\\sqrt{{(\\operatorname{sinh}⁡t)}^{2}+{(2\\operatorname{sinh}⁡2t)}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{2}\\operatorname{cosh}⁡t\\sqrt{{sinh}^{2}⁡t+4{sinh}^{2}⁡2t}\\,\\text{d}t.\\end{aligned}\n$$\n\nNow, using the identity $\\operatorname{sinh}⁡2t=2\\operatorname{sinh}⁡t\\operatorname{cosh}⁡t,$ we can rewrite our integral as follows:\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{0}^{2}\\operatorname{cosh}⁡t\\sqrt{{sinh}^{2}⁡t+4{sinh}^{2}⁡2t}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{2}\\operatorname{cosh}⁡t\\sqrt{{sinh}^{2}⁡t+4(2\\operatorname{sinh}⁡t\\operatorname{cosh}⁡t)^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{2}\\operatorname{cosh}⁡t\\sqrt{{sinh}^{2}⁡t+16{sinh}^{2}⁡t{cosh}^{2}⁡t}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{2}\\operatorname{cosh}⁡t\\sqrt{{sinh}^{2}⁡t(1+16{cosh}^{2}⁡t)}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{2}\\operatorname{cosh}⁡t\\cdot \\sqrt{{sinh}^{2}⁡t}\\cdot \\sqrt{1+16{cosh}^{2}⁡t}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{2}\\operatorname{cosh}⁡t\\cdot |\\operatorname{sinh}⁡t|\\cdot \\sqrt{1+16{cosh}^{2}⁡t}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{2}\\operatorname{sinh}⁡t\\operatorname{cosh}⁡t\\sqrt{1+16{cosh}^{2}⁡t}\\,\\text{d}t\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269200 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34815984-fefd-5798-bdd6-d8ac9e63495b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{2}{t}^{3}\\sqrt{9{t}^{4}+4}\\,\\text{d}t" :db/id #edb/ref 17592186266603} {:answer/id #uuid "5f3baba4-8572-53a6-81aa-d3e89b039d05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi {\\int }_{0}^{2}t\\sqrt{3{t}^{4}+2}\\,\\text{d}t" :db/id #edb/ref 17592186266984} {:answer/id #uuid "6f44b9c5-062e-5836-8fa5-9b241e49df01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\pi {\\int }_{0}^{2}{t}^{5}\\,\\text{d}t" :db/id #edb/ref 17592186267122} {:answer/id #uuid "9a5f9d3b-c7f5-5304-ad78-7cc3982df96e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{2}t\\sqrt{{t}^{4}+2}\\,\\text{d}t" :db/id #edb/ref 17592186267539} {:answer/id #uuid "b26a0858-4124-5ef1-b554-c41d2275431e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi {\\int }_{0}^{2}{t}^{3}\\sqrt{{t}^{2}+1}\\,\\text{d}t" :db/id #edb/ref 17592186267740}] :answer-field/correct {:answer/id #uuid "34815984-fefd-5798-bdd6-d8ac9e63495b" :answer/type {:db