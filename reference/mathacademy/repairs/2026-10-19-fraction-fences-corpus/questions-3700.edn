 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{2}{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}+{b}^{2}{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2}" :db/id #edb/ref 17592186309901} :answer-field/id #uuid "c09128e8-e1f3-5f9d-bce1-f0d8e0788eee" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186311347} {:answer-field/choices [{:answer/id #uuid "5acefa0e-75be-5722-b86f-46337e5caafe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}" :db/id #edb/ref 17592186309429} {:answer/id #uuid "aa1c23c9-63ec-537f-b466-5814158b88c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}-b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}" :db/id #edb/ref 17592186310124} {:answer/id #uuid "bbcbcdde-f0e2-5ef5-affd-1725802db5bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "nonlinear" :db/id #edb/ref 17592186310270}] :answer-field/correct {:answer/id #uuid "bbcbcdde-f0e2-5ef5-affd-1725802db5bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "nonlinear" :db/id #edb/ref 17592186310270} :answer-field/id #uuid "d1e0f51b-ff68-52f7-860e-60fabba672f4" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186311402} {:answer-field/choices [{:answer/id #uuid "5ab8c163-345d-5a90-bd2b-86e83c7b97c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D(a{y}_{1}+b{y}_{2})=aD({y}_{1})+bD({y}_{2})" :db/id #edb/ref 17592186309428} {:answer/id #uuid "5eff945b-a812-5204-a190-a6a1a60f493f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D(a{y}_{1}+b{y}_{2})\\ne aD({y}_{1})+bD({y}_{2})" :db/id #edb/ref 17592186309459}] :answer-field/correct {:answer/id #uuid "5eff945b-a812-5204-a190-a6a1a60f493f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D(a{y}_{1}+b{y}_{2})\\ne aD({y}_{1})+bD({y}_{2})" :db/id #edb/ref 17592186309459} :answer-field/id #uuid "f729c200-f282-504c-99fd-9d268dc75252" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186311513} {:answer-field/choices [{:answer/id #uuid "d3ac9026-19ae-5eaf-8ff6-93a84d074a6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{\\text{d}{y}_{2}}{\\text{d}x}+\\frac{\\text{d}{y}_{1}}{\\text{d}x})" :db/id #edb/ref 17592186310454} {:answer/id #uuid "f0e4b69d-588d-5019-b0be-bb3b68ae279c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{\\text{d}{y}_{1}}{\\text{d}x}\\cdot \\frac{\\text{d}{y}_{2}}{\\text{d}x})" :db/id #edb/ref 17592186310669}] :answer-field/correct {:answer/id #uuid "f0e4b69d-588d-5019-b0be-bb3b68ae279c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{\\text{d}{y}_{1}}{\\text{d}x}\\cdot \\frac{\\text{d}{y}_{2}}{\\text{d}x})" :db/id #edb/ref 17592186310669} :answer-field/id #uuid "ff9843f0-4669-56d8-8d49-34df0a324594" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186311541}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8be7f3a8-564a-541b-b0e3-87934741ee59" :question/math-academy-id "q-337728" :question/problem "Consider the following differential operator:\n\n$$\nD(y)=\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{(\\frac{\\text{d}y}{\\text{d}x})}^{2}\n$$\n\nFill in the steps in the reasoning below.\n\nFor any linear differential operator $L,$ we have the linearity condition\n\n$$\n{{field-1}}\n$$\n\nfor functions ${y}_{1}(x),{y}_{2}(x),$ and where $a$ and $b$ are constants. \n\nFor the given differential operator, we have\n\n$$\n\\begin{aligned}D(a{y}_{1}+b{y}_{2}) & ={{field-2}}+{{field-3}} \\\\  & +2ab\\cdot {{field-4}}.\\end{aligned}\n$$\n\nWe also have\n\n$$\n\\begin{aligned}aD({y}_{1})+bD({y}_{2}) & =a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+a{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}+b{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2}.\\end{aligned}\n$$\n\nNow, since {{field-5}} \nthe operator $D$ is {{field-6}}." :question/worked-solution "For any linear differential operator $L,$ we have the linearity condition\n\n$$\nL(a{y}_{1}+b{y}_{2})=aL({y}_{1})+bL({y}_{2})\n$$\n\nfor functions ${y}_{1}(x),{y}_{2}(x),$ and where $a$ and $b$ are constants. \n\nFor the given differential operator, we have\n\n$$\n\\begin{aligned}D(a{y}_{1}+b{y}_{2}) & =\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2})+{(\\frac{\\text{d}}{\\text{d}x}(a{y}_{1}+b{y}_{2}))}^{2} \\\\  & =a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+{(a\\frac{\\text{d}{y}_{1}}{\\text{d}x}+b\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2} \\\\  & =a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+{a}^{2}{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}+2ab\\frac{\\text{d}{y}_{1}}{\\text{d}x}\\frac{\\text{d}{y}_{2}}{\\text{d}x}+{b}^{2}{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2} \\\\  & =a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+{a}^{2}{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}+{b}^{2}{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2} \\\\  & +2ab\\cdot (\\frac{\\text{d}{y}_{1}}{\\text{d}x}\\cdot \\frac{\\text{d}{y}_{2}}{\\text{d}x}).\\end{aligned}\n$$\n\nThis is *not* the same as the right-hand side, because\n\n$$\n\\begin{aligned}aD({y}_{1})+bD({y}_{2}) & =a[\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}]+b[\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2}] \\\\  & =a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+a{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}+b{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2}.\\end{aligned}\n$$\n\nTherefore, since $D(a{y}_{1}+b{y}_{2})\\ne aD({y}_{1})+bD({y}_{2}),$ the operator $D$ is $\\text{nonlinear}.$"} {:db/id #edb/ref 17592186311880 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90f63096-9e44-5d1c-8dc8-5b733c7f2352" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D(a{y}_{1}+b{y}_{2})=aD({y}_{1})+bD({y}_{2})" :db/id #edb/ref 17592186309907} {:answer/id #uuid "fb38179b-17f5-5e87-aa65-841f87032430" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D(a{y}_{1}+b{y}_{2})\\ne aD({y}_{1})+bD({y}_{2})" :db/id #edb/ref 17592186310752}] :answer-field/correct {:answer/id #uuid "fb38179b-17f5-5e87-aa65-841f87032430" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D(a{y}_{1}+b{y}_{2})\\ne aD({y}_{1})+bD({y}_{2})" :db/id #edb/ref 17592186310752} :answer-field/id #uuid "15f8abd5-803c-516f-89fa-ade5aed73367" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186310851} {:answer-field/choices [{:answer/id #uuid "3fd63877-7c7a-5fe9-a732-bb2defd05825" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a{y}_{1}+b{y}_{2}" :db/id #edb/ref 17592186309234} {:answer/id #uuid "6fda90da-2656-5ef1-802f-ad5517074fea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{2}{y}_{1}+{b}^{2}{y}_{2}" :db/id #edb/ref 17592186309612}] :answer-field/co