7-539b-595c-956c-1eaa68321195" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186146456}] :question/id #uuid "bea837c5-f34f-5453-92e7-93e5d7067b62" :question/math-academy-id "q-64178" :question/problem "Find the degree of the homogeneous function $h(x, y) = \\frac{y^{2}}{x + 2y}\\sin (\\frac{x^{2}}{y^{2}})$."} {:db/id #edb/ref 17592186148123 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a1b58db-604d-5c39-ab7f-44d25d3d4776" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186330902} {:answer/id #uuid "bdf5c422-af51-5a1a-842e-d20054ef4d27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186331632} {:answer/id #uuid "da51eb00-9d9d-51a7-a3cd-23783a6387a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186331885} {:answer/id #uuid "e1377bdd-61e8-5f88-a695-1df0bfb0c733" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186331939} {:answer/id #uuid "f1d41a80-cf05-58a2-a65a-cd41c9e0aa25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186332076}] :answer-field/correct {:answer/id #uuid "da51eb00-9d9d-51a7-a3cd-23783a6387a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186331885} :answer-field/id #uuid "e2a93460-5c05-51b8-aa67-782b1b5929ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332601}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d8184c9d-59e3-5623-bc59-3b1dfdec057b" :question/math-academy-id "q-64204" :question/problem "Find the degree of the homogeneous function $h(x,y)=\\frac{5y}{2{x}^{2}+8xy}\\,\\operatorname{cos}⁡(\\frac{x}{y}).$" :question/worked-solution "A function $h(x,y)$ is homogeneous of degree $n$ if it satisfies the property\n\n$$\nh(tx,ty)={t}^{n}h(x,y).\n$$\n\nSo first, we compute $h(tx,ty),$ and then we simplify by writing it as ${t}^{n}h(x,y)$ for some $n$:\n\n$$\n\\begin{aligned}h(tx,ty) & =\\frac{5(ty)}{2(tx)^{2}+8(tx)(ty)}\\operatorname{cos}⁡(\\frac{tx}{ty}) \\\\  & =\\frac{5ty}{2{t}^{2}{x}^{2}+8{t}^{2}xy}\\operatorname{cos}⁡(\\frac{tx}{ty}) \\\\  & =\\frac{5ty}{{t}^{2}(2{x}^{2}+8xy)}\\operatorname{cos}⁡(\\frac{tx}{ty}) \\\\  & =\\frac{5y}{t(2{x}^{2}+8xy)}\\operatorname{cos}⁡(\\frac{x}{y}) \\\\  & =\\frac{1}{t}\\cdot \\frac{5y}{2{x}^{2}+8xy}\\operatorname{cos}⁡(\\frac{x}{y}) \\\\  & ={t}^{-1}\\cdot \\frac{5y}{2{x}^{2}+8xy}\\operatorname{cos}⁡(\\frac{x}{y}) \\\\  & ={t}^{-1}\\cdot h(x,y)\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nh(tx,ty)=\\frac{1}{t}\\cdot h(x,y)={t}^{-1}h(x,y)\n$$\n\nand so the degree of the homogeneous function $h(x,y)$ is $-1.$"} {:db/id #edb/ref 17592186148138 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d86affc-942e-5993-85cf-2d3e0c8a3dd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2-s}{s({s}^{2}+1)}" :db/id #edb/ref 17592186333985} {:answer/id #uuid "6e567ffa-3f65-587b-9efc-56a5323eed6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{s}{{s}^{2}+1}" :db/id #edb/ref 17592186333992} {:answer/id #uuid "6ed5a031-cd79-55b2-88c8-6c3b2e128096" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-s}{{s}^{2}+1}" :db/id #edb/ref 17592186333997} {:answer/id #uuid "7f4c6df6-e8c6-56c9-9720-c881fe8ec4cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{s({s}^{2}+1)}" :db/id #edb/ref 17592186334123} {:answer/id #uuid "f08f328e-6e15-5694-915e-2a751b775766" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{s+2}{{s}^{2}+1}" :db/id #edb/ref 17592186335097}] :answer-field/correct {:answer/id #uuid "6ed5a031-cd79-55b2-88c8-6c3b2e128096" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-s}{{s}^{2}+1}" :db/id #edb/ref 17592186333997} :answer-field/id #uuid "b451cd90-15ae-5c8a-ab24-a29d198938e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335573}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6ac1b8c2-0178-57d7-8d1a-553359e8071f" :question/math-academy-id "q-64288" :question/problem "Find the Laplace transform $L{{f}^{″}(t)}$ for $s>0,$ given that the function $f(t)$ is continuous on $[0,\\infty ),$ ${f}^{′}(0)=-1,$ $f(0)=1,$ and\n\n$$\nL{f(t)}=\\frac{s-1}{{s}^{2}+1},\\,s>0.\n$$\n\nAssume that ${f}^{′}$ is continuous and ${f}^{″}$ piecewise continuous on $[0,\\infty ).$" :question/worked-solution "Suppose $F(s)=L{f(t)}$ where $f(t)$ is a continuous function of exponential order $a$ on $[0,\\infty ).$ If ${f}^{′}(t)$ is continuous and ${f}^{″}(t)$ is piecewise continuous on $[0,\\infty ),$ then\n\n$$\n\\begin{aligned}L{{f}^{″}(t)} & ={s}^{2}L{f(t)}-sf(0)-{f}^{′}(0).\\end{aligned}\n$$\n\nTherefore, we can calculate the Laplace transform of ${f}^{″}(t)$ as follows:\n\n$$\n\\begin{aligned}L{{f}^{″}(t)} & ={s}^{2}\\cdot \\frac{s-1}{{s}^{2}+1}-s\\cdot 1-(-1) \\\\  & =\\frac{{s}^{2}(s-1)}{{s}^{2}+1}-s+1 \\\\  & =\\frac{{s}^{2}(s-1)}{{s}^{2}+1}-(s-1) \\\\  & =(s-1)(\\frac{{s}^{2}}{{s}^{2}+1}-1) \\\\  & =(s-1)(-\\frac{1}{{s}^{2}+1}) \\\\  & =\\frac{1-s}{{s}^{2}+1}\\end{aligned}\n$$\n\nvalid for $s>0.$"} {:db/id #edb/ref 17592186151851 :question/id #uuid "bc24cde3-b907-5bc0-9889-a7a54b10a2a7" :question/math-academy-id "e-14605" :question/problem "Consider the equivalence relation $\\sim$ on $\\mathbb{R},$ defined by $x \\sim y$ if $\\sin x = \\sin y.$ Which of the following equivalence classes contain the element $\\dfrac{\\pi}{2}?$\n\nI. $\\left[\\dfrac{3\\pi}{2}\\right]$\n\nII. $\\left[-\\dfrac{\\pi}{2}\\right]$\n\nIII. $\\left[-\\dfrac{3\\pi}{2}\\right]$" :question/worked-solution "We have $\\dfrac{\\pi}{2} \\in [x]$ if $\\dfrac{\\pi}{2} \\sim x.$ Using the definition of the given equivalence relation, we require\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\frac{\\pi }{2}) & =\\operatorname{sin}⁡x \\\\ 1 & =\\operatorname{sin}⁡x \\\\ \\operatorname{sin}⁡x & =1.\\end{aligned}\n$$\n\nLet's now consider each of the given equivalence classes.\n\n- $\\dfrac{\\pi}{2} \\not\\in \\left[\\dfrac{3\\pi}{2}\\right]$ because $\\sin\\left(\\dfrac{3\\pi}{2}\\right) =-1\\neq 1 \\quad \\color{red}\\times$\n\n- $\\dfrac{\\pi}{2} \\not\\in \\left[-\\dfrac{\\pi}{2}\\right]$ because $\\sin\\left(-\\dfrac{\\pi}{2}\\right) =-1\\neq 1 \\quad \\color{red}\\times$\n\n- $\\dfrac{\\pi}{2} \\in \\left[-\\dfrac{3\\pi}{2}\\right]$ because $\\sin \\left(-\\dfrac{3\\pi}{2}\\right) = 1  \\quad \\color{green}\\checkmark$\n\nTherefore, the correct answer is \"III only\"."} {:db/id #edb/ref 17592186151884 :question/id #uuid "8fecd87e-ffa7-5a97-af33-4468124bd39b" :question/math-academy-id "e-15007" :question/problem "The daily tide level in a coastal city, in feet, is modeled by the function\n$H(t)=6\\cos\\left(\\dfrac{\\pi t}{6}\\right)+ 8$,\nwhere $t$ is the time in hours. How long does it take for the tide to transition from its lowest to highest level, and what is the maximum height of the tide?" :question/worked-solution "Let's recall the general terminology for sinusoidal curves:\n\n![](images/f6/f693f83ce4198b52d8b6dbca791cdf2855c7879dcf230193e824c23c10ede995.png)\n\nIf\n\n$$\nF(t) = A \\cos\\left(B t \\right) + C\n$$\n\nthen\n\n- $\\mid A \\mid$ is the *amplitude*,\n- $\\dfrac{\\mid B \\mid}{2\\pi}$ is the *frequency,* $\\dfrac{2\\pi}{\\mid B \\mid}$ is the *period*, and\n- $C$ is the *midline* (vertical shift).\n\nWe'll answer each part of the question in turn.\n\n- For the first part, we are interested in the time difference between the highest and lowest tides (i.e., *half* the period of the function).Now, we have\n$B = \\frac{π}{6}$.\nSo, the period is\n$\\frac{2π}{B}|= (2π)/((\\frac{π}{6})); = 12hr$.\nThe time between the lowest and highest tides is *half* the period. Therefore, it takes $6$ hours for the tide to transition from its lowest to highest level.\n- For the second part, we're interested in the maximum value of the function. This is given by the amplitude plus the midline. Now, we have\n$\\mid A \\mid = 6\\,\\textrm{ft}, \\qquad C = 8\\,\\textrm{ft}$.\nTherefore,\n$H_{\\textrm{max}} = 6\\,\\textrm{ft} + 8\\,\\textrm{ft} = 14\\,\\textrm{ft}$.\nTherefore, the maximum height of the tide is $14\\,\\textrm{ft}$."} {:db/id #edb/ref 17592186151944 :question/id #uuid "302059c1-d807-54d2-badc-a4a19b2f9c05" :question/math-academy-id "e-6255" :question/problem "The matrix $A$ is given below. Let $\\mathbf{a}_1$, $\\mathbf{a}_2$, and $\\mathbf{a}_3$ be the respective columns of $A.$ Determine if ![](images/b2/b22e2ffa6f6d88665e120e8dad82961e72f8f4a99484e8f81de311a66ab25988.svg) is a basis of $\\textrm{Col}(A).$ \nIf that is the case, find $x_1 \\cdot x_2$, where $\\mathbf{a}_3=x_1\\mathbf{a}_1+x_2\\mathbf{a}_2.$\n\n![](images/28/28f79983a195fa0152832aebd334cd8e1aaaa977dd9016347a3152403fd390c7.svg)" :question/worked-solution "First, we reduce the matrix $A$ to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}1 & 2 & 9 \\\\ 3 & 1 & 17\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 9 \\\\ 0 & -5 & -10\\end{bmatrix} & {R}_{2} & :=(-\\frac{1}{5}){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 2 & 9 \\\\ 0 & 1 & 2\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 5 \\\\ 0 & 1 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nFrom the matrix above, we see that the pivot columns are the $1$st and $2$nd columns. So, a basis of $\\textrm{Col}(A)$ is $\\{\\mathbf{a}_1,\\mathbf{a}_2 \\},$ that is to say,\n\n![](images/45/4588c7d7ae4fd6cbc749373d83ab2d81e6a228f0cac03d5b959f4177f3f4cdf9.svg)\n\nNow, since the $3$rd column of the reduced matrix is a non-pivot column, then the entries in that column tell us the coefficients needed to express $\\mathbf{a}_3$ as a linear combination of all the other columns in the original matrix. So, we have\n\n![](images/fa/fa2ad666a6b80eac26bad12db322fa361578d94327e230d7c520c950add78923.svg)\n\nThis gives us $x_1 \\cdot x_2 = 5 \\cdot 2=10.$"} {:db/id #edb/ref 17592186151947 :question/id #uuid "a18b37e2-4ab1-5fd1-b985-3021172abc41" :question/math-academy-id "e-6306" :question/problem "Evaluate the integral $\\displaystyle \\int\\limits_{C} \\dfrac{y^3}{x^2} \\, \\text{d}s,$ where the curve $C$ is given by $y = x$ for $\\, 0 \\le x \\le 4.$" :question/worked-solution "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y = y(t) = t.$ This gives the following parametrization of the curve:\n\n$$\n\\mathbf{r}(t) = \\left\\langle t, \\: t \\right\\rangle, \\qquad 0 \\le t \\le 4\n$$\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =i+j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{1}^{2}+{1}^{2}} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nNow, since $f(x,y) = \\dfrac{y^3}{x^2}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{{t}^{3}}{{t}^{2}}=t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{{y}^{3}}{{x}^{2}}\\,\\text{d}s & ={\\int }_{0}^{4}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{4}t\\cdot \\sqrt{2}\\cdot \\text{d}t \\\\  & =\\sqrt{2}{\\int }_{0}^{4}t\\,\\text{d}t \\\\  & =\\frac{\\sqrt{2}}{2}{t}^{2}{|}_{0}^{4} \\\\  & =\\frac{\\sqrt{2}}{2}({4}^{2}-{0}^{2}) \\\\  & =8\\sqrt{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186151948 :question/id #uuid "b4f26e02-fb0f-5577-90f4-52e7eeabd857" :question/math-academy-id "e-6310" :question/problem "Consider the line integral \n\n$$\n\\displaystyle \\int \\limits_{C} \\dfrac{y^2}{x} \\,\\textrm ds,\n$$\n\n where $C$ is the section of the curve $y = \\dfrac{x^3}3$ between the points $(0,0)$ and $(3,9).$\nWrite the line integral in the form \n\n$$\n\\displaystyle\\int\\limits_a^b  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t.\n$$" :question/worked-solution "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y = y(t) = \\dfrac{t^3}{3}.$ This gives the following parametrization of the curve:\n\n$$\n\\mathbf{r}(t) = \\left\\langle t, \\dfrac{t^3}3 \\right\\rangle, \\qquad 0 \\le t \\le 3,\n$$\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}(\\frac{{t}^{3}}{3})j \\\\  & =i+{t}^{2}\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{1}^{2}+{({t}^{2})}^{2}} \\\\  & =\\sqrt{1+{t}^{4}}\\end{aligned}\n$$\n\nNow, since $f(x,y) = \\dfrac{y^2}{x},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{{(\\frac{{t}^{3}}{3})}^{2}}{t}=\\frac{1}{9}{t}^{5}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{3}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}\\frac{1}{9}{t}^{5}\\cdot \\sqrt{1+{t}^{4}}\\cdot \\text{d}t \\\\  & =\\frac{1}{9}{\\int }_{0}^{3}{t}^{5}\\sqrt{1+{t}^{4}}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186151949 :question/id #uuid "287a493f-e988-5cef-b0d0-4205d1eaf74e" :question/math-academy-id "e-6313" :question/problem "Find a definite integral with respect to $\\theta$ that is equivalent to $\\displaystyle \\int \\limits_{C} (y^2-x) \\, \\textrm ds,$ where $C$ is the section of the polar curve $r = \\cos{\\theta}\\:$ for $0 \\le \\theta \\le\\dfrac{ \\pi}4.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n\\int\\limits_C f(x,y) \\, \\textrm{d}s  = \\int_{\\theta_1}^{\\theta_2}  f(r\\cos\\theta,r\\sin\\theta) \\,\\sqrt{r^2 + \\left(\\dfrac{\\textrm d r}{\\textrm d \\theta}\\right)^2}\\,\\textrm d \\theta\\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & ={cos}^{2}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\cos^2\\theta$ and $y=\\cos\\theta \\sin{\\theta}$, where $0 \\leq \\theta \\leq \\dfrac{\\pi}4.$\n\nNow, if $f(x,y) =y^2-x$, we obtain  \n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & ={(\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta )}^{2}-{cos}^{2}⁡\\theta  \\\\  & ={cos}^{2}⁡\\theta \\text{ }{sin}^{2}⁡\\theta -{cos}^{2}⁡\\theta  \\\\  & ={cos}^{2}⁡\\theta ({sin}^{2}⁡\\theta -1) \\\\  & ={cos}^{2}⁡\\theta (-{cos}^{2}⁡\\theta ) \\\\  & =-{cos}^{4}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{cos}⁡\\theta )=-\\operatorname{sin}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{(\\operatorname{cos}⁡\\theta )}^{2}+{(-\\operatorname{sin}⁡\\theta )}^{2}} \\\\  & =\\sqrt{{cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta } \\\\  & =\\sqrt{1} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}({y}^{2}-x)\\,\\text{d}s & ={\\int }_{0}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}-{cos}^{4}⁡\\theta \\cdot 1\\cdot \\text{d}\\theta  \\\\  & =-{\\int }_{0}^{\\pi /4}{cos}^{4}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186151950 :question/id #uuid "63aa09fb-9839-5f73-9f98-2eb9784ead43" :question/math-academy-id "e-6314" :question/problem "Evaluate the integral of the function $f(x,y)=\\dfrac{x^2+y^2}{y^2}$ along the polar curve $r=1$ for $\\dfrac{\\pi}{6}\\leq \\theta \\leq \\dfrac\\pi 2.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n\\int\\limits_C f(x,y) \\, \\textrm{d}s  = \\int_{\\theta_1}^{\\theta_2}  f(r\\cos\\theta,r\\sin\\theta) \\,\\sqrt{r^2 + \\left(\\dfrac{\\textrm d r}{\\textrm d \\theta}\\right)^2}\\,\\textrm d \\theta\\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\cos\\theta$ and $y=\\sin\\theta$, where $\\dfrac{\\pi}{6} \\leq \\theta \\leq \\dfrac{\\pi}2.$\n\nNow, since $f(x,y) = \\dfrac{x^2+y^2}{y^2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\frac{{cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta }{{sin}^{2}⁡\\theta } \\\\  & =\\frac{1}{{sin}^{2}⁡\\theta } \\\\  & ={csc}^{2}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(1)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta =\\sqrt{{1}^{2}+{0}^{2}}=1.\\end{aligned}\n$$\n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{{x}^{2}+{y}^{2}}{{y}^{2}}\\,\\text{d}s & ={\\int }_{\\pi /6}^{\\pi /2}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /6}^{\\pi /2}{csc}^{2}⁡\\theta \\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{\\pi /6}^{\\pi /2}{csc}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =-\\operatorname{cot}⁡\\theta \\,{|}_{\\pi /6}^{\\pi /2} \\\\  & =-(0-\\sqrt{3}) \\\\  & =\\sqrt{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186151951 :question/id #uuid "00b29cf2-6a73-5fd6-b8bd-04ba8c5f1a46" :question/math-academy-id "e-6315" :question/problem "Evaluate the integral $\\displaystyle\\int_\\limits{C} xy(1-x^2) \\,\\textrm{d}s$, where $C$ is the polar curve $r=\\cos{\\theta}\\:$ for $0 \\leq \\theta \\leq \\dfrac{\\pi}{2}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n\\int\\limits_C f(x,y) \\, \\textrm{d}s  = \\int_{\\theta_1}^{\\theta_2}  f(r\\cos\\theta,r\\sin\\theta) \\,\\sqrt{r^2 + \\left(\\dfrac{\\textrm d r}{\\textrm d \\theta}\\right)^2}\\,\\textrm d \\theta\\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & ={cos}^{2}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\cos^2\\theta$ and $y=\\cos\\theta\\sin\\theta$, where $0 \\leq \\theta \\leq \\dfrac{\\pi}{2}.$\n\nNow, if $f(x,y) = xy(1-x^2)$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & ={cos}^{2}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta (1-({cos}^{2}⁡\\theta )^{2}) \\\\  & ={cos}^{3}⁡\\theta \\operatorname{sin}⁡\\theta (1-{cos}^{4}⁡\\theta ).\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta }=\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{cos}⁡\\theta )=-\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(\\operatorname{cos}⁡\\theta )^{2}+(-\\operatorname{sin}⁡\\theta )^{2}} \\\\  & =\\sqrt{{cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta } \\\\  & =1.\\end{aligned}\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}xy(1-{x}^{2})\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{cos}^{3}⁡\\theta \\operatorname{sin}⁡\\theta (1-{cos}^{4}⁡\\theta )\\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{cos}^{3}⁡\\theta \\operatorname{sin}⁡\\theta (1-{cos}^{4}⁡\\theta )\\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=\\cos\\theta,$ $\\textrm d u=-\\sin\\theta\\,\\textrm d \\theta$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}{cos}^{3}⁡\\theta \\operatorname{sin}⁡\\theta (1-{cos}^{4}⁡\\theta )\\,\\text{d}\\theta  & ={\\int }_{1}^{0}-{u}^{3}(1-{u}^{4})\\,\\text{d}u \\\\  & ={\\int }_{0}^{1}({u}^{3}-{u}^{7})\\,\\text{d}u \\\\  & ={[\\frac{{u}^{4}}{4}-\\frac{{u}^{8}}{8}]}_{0}^{1} \\\\  & =(\\frac{1}{4}-\\frac{1}{8})-0 \\\\  & =\\frac{1}{8}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186151971 :question/id #uuid "819a6bed-b738-5bda-b341-e3f5137aac4c" :question/math-academy-id "e-6635" :question/problem "Given that the differential equation\n\n$$\nt^2 y'' +2ty' = t^2 e ^ {t}, \\quad t>0\n$$\n\nhas the complementary solution $y_c(t) =  \\dfrac{A}{t} + B,$ find the particular solution $y_p(t)$ to this equation." :question/worked-solution "The right-hand side is not a polynomial, so we need to use another solution technique. Here, we are given the complementary solution $y_c(t) =  \\dfrac{A}{t} + B,$ which means that we have two fundamental solutions\n\n$$\ny_1(t) = \\dfrac{1}{t}  , \\qquad y_2(t) = 1.\n$$\n\nBecause we have two fundamental solutions, we can use variation of parameters.\n\nTo use variation of parameters, we must first reduce the differential equation to the form\n\n$$\ny'' + P(t) y' +Q(t) y = f(t).\n$$\n\nTo do this, we divide both sides of the given equation by $t^2,$ and get\n\n$$\ny'' + \\dfrac{2}{t}y'  =  e ^ {t}.\n$$\n\nSo, we have the following:\n\n$$\ny_1(t) = \\dfrac{1}{t}  , \\qquad y_2(t) = 1, \\qquad f(t) = e^t.\n$$\n\nFirst, let's compute the Wronskian:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}| \\\\  & ={y}_{1}{y}_{2}^{′}-{y}_{1}^{′}{y}_{2} \\\\  & =(\\frac{1}{t})(1)^{′}-{(\\frac{1}{t})}^{′}(1) \\\\  & =0+\\frac{1}{{t}^{2}} \\\\  & =\\frac{1}{{t}^{2}}\\end{aligned}\n$$\n\nSince the Wronskian is not equal to zero, this confirms that the functions  $y_1(t)$ and $y_2(t)$ are independent.\n\nAccording to the method of variation of parameters, a particular solution of the differential equation is\n\n$$\n\\begin{aligned}{y}_{p}(t) & ={y}_{1}(t)u(t)+{y}_{2}(t)v(t),\\end{aligned}\n$$\n\nwhere\n\n$$\n\\begin{aligned}u(t) & =-\\int \\frac{f(t){y}_{2}(t)}{W({y}_{1},{y}_{2})}\\,\\text{d}t=-\\int {t}^{2}{e}^{t}=-({t}^{2}-2t+2){e}^{t}, \\\\ v(t) & =\\int \\frac{f(t){y}_{1}(t)}{W({y}_{1},{y}_{2})}\\,\\text{d}t=\\int t{e}^{t}=(t-1){e}^{t}.\\end{aligned}\n$$\n\nTherefore, a particular solution is given by\n\n$$\n\\begin{aligned}{y}_{p}(t) & ={y}_{1}(t)u(t)+{y}_{2}(t)v(t) \\\\  & =-\\frac{({t}^{2}-2t+2){e}^{t}}{t}+(t-1){e}^{t} \\\\  & =(1-\\frac{2}{t}){e}^{t}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186151972 :question/id #uuid "e3463872-d79a-5c63-bd78-31e0e206306b" :question/math-academy-id "e-6636" :question/problem "Find the particular solution $y_p(x)$ of the equation \n\n$$\nx^2y''+xy'   + y =  \\ln x, \\quad x>0.\n$$" :question/worked-solution "This Cauchy-Euler equation has non-polynomial forcing, but we are not given two fundamental solutions, so we cannot use variation of parameters.\n\nHowever, if we make a substitution $x=e^t,$ we can transform the Cauchy-Euler equation into a linear ODE with constant coefficients.\n\nLetting $x=e^t,$ we note that\n\n$$\n\\dfrac{\\textrm dx}{\\textrm d t} = e^t = x\\quad\\Longrightarrow\\quad \\dfrac{\\textrm d t}{\\textrm d x} = \\dfrac1x.\n$$\n\nThen, we use the chain rule to compute the first and second derivatives. \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}t}\\frac{\\text{d}t}{\\text{d}x}=\\frac{1}{x}\\frac{\\text{d}y}{\\text{d}t}, \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{x}\\frac{\\text{d}y}{\\text{d}t}) \\\\  & =\\underbrace{\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{x})\\cdot \\frac{\\text{d}y}{\\text{d}t}+\\frac{1}{x}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\frac{\\text{d}y}{\\text{d}t})}_{\\text{product rule}} \\\\  & =-\\frac{1}{{x}^{2}}\\frac{\\text{d}y}{\\text{d}t}+\\frac{1}{x}\\cdot \\underbrace{\\frac{\\text{d}t}{\\text{d}x}\\frac{\\text{d}}{\\text{d}t}}_{\\text{chain rule}}(\\frac{\\text{d}y}{\\text{d}t}) \\\\  & =-\\frac{1}{{x}^{2}}\\frac{\\text{d}y}{\\text{d}t}+\\frac{1}{{x}^{2}}\\frac{{\\text{d}}^{2}y}{\\text{d}{t}^{2}} \\\\  & =\\frac{1}{{x}^{2}}\\frac{{\\text{d}}^{2}y}{\\text{d}{t}^{2}}-\\frac{1}{{x}^{2}}\\frac{\\text{d}y}{\\text{d}t}\\end{aligned}\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{t}^{2}}+y=t.\\end{aligned}\n$$\n\nThis equation is a second-order inhomogeneous ODE equation with constant coefficients and polynomial forcing.\n\nUsing the usual methods for solving second-order ODEs, we find that the complementary solution is \n\n$$\ny_c(x) = A\\cos t+B\\sin t.\n$$\n\nSince right-hand side of the inhomogeneous ODE is a polynomial of degree $1,$ we assume that the particular solution is also a polynomial of degree $1,$ i.e.\n\n$$\ny_p(t)=\\alpha t+ \\beta\n$$\n\nwhere $\\alpha$ and $\\beta$ are constants that are to be determined. \n\nCalculating the first and second derivatives of $y_p$ gives:\n\n$$\n\\frac{\\textrm{d}y_p}{\\textrm{d}t} = \\alpha\n,\\qquad \\frac{\\textrm{d}^2y_p}{\\textrm{d}t^2} = 0.\n$$\n\nTo find the values of $\\alpha$ and $\\beta,$ we substitute the derivatives into the differential equation for $y(t)\\mathbin{:}$\n\n$$\n0+(\\alpha t+\\beta)=t\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}\\alpha &=1\\, && (\\text{equating the coefficients of [math]t[/math]}) \\\\ \\beta &=0\\, && (\\text{equating the constants})\\end{aligned}\\right.\n$$\n\nThis system has the solution $\\alpha=1$ and $\\beta=0.$ \n\nTherefore, the particular solution is\n\n$$\ny_p(t) = t.\n$$\n\nNow, all that remains is to write the above solution in terms of the original variable $x.$ Since $x=e^t,$ we have $t = \\ln x,$ and therefore\n\n$$\ny_p(x) =\\ln x.\n$$"} {:db/id #edb/ref 17592186151985 :question/id #uuid "f41bad20-5a72-5d6d-82c4-cf36f7ac74cd" :question/math-academy-id "e-6794" :question/problem "Given that $y_1(x) = \\dfrac{1}{x}$ is a solution to the equation $x^2 y'' + 3xy' + y = 0$ for $x>0,$ use reduction of order to find a second solution $y_2(x)$ to the equation, and write down the general solution." :question/worked-solution "According to the reduction of order method, we let \n\n$$\n\\begin{aligned}{y}_{2}(x) & =u(x){y}_{1}(x) \\\\  & =u(x)\\cdot \\frac{1}{x} \\\\  & =\\frac{u(x)}{x}.\\end{aligned}\n$$\n\nDifferentiating $y_{2} = \\dfrac{u(x)}{x}$ with respect to $x$ gives\n\n$$\n\\begin{aligned}{y}_{2} & =\\frac{u}{x} \\\\ {y}_{2}^{′} & =\\frac{{u}^{′}x-u}{{x}^{2}} \\\\ {y}_{2}^{″} & =\\frac{{u}^{″}{x}^{2}-2{u}^{′}x+2u}{{x}^{3}}.\\end{aligned}\n$$\n\nSubstituting the above into the differential equation gives\n\n$$\n\\begin{aligned}{x}^{2}{y}^{″}+3x{y}^{′}+y & =0 \\\\ {x}^{2}(\\frac{{u}^{″}{x}^{2}-2{u}^{′}x+2u}{{x}^{3}})+3x(\\frac{{u}^{′}x-u}{{x}^{2}})+\\frac{u}{x} & =0 \\\\ \\frac{{u}^{″}{x}^{2}-2{u}^{′}x+2u+3{u}^{′}x-3u+u}{x} & =0 \\\\ \\frac{{u}^{″}{x}^{2}+{u}^{′}x}{x} & =0 \\\\ {u}^{″}x+{u}^{′} & =0.\\end{aligned}\n$$\n\nNow, let $w = u'.$ Then our equation becomes a first-order equation:\n\n$$\nw' x + w = 0\n$$\n\nThis is a separable equation that has the solution\n\n$$\nw = \\dfrac{c_1}{x}.\n$$\n\nSince $w = u',$ we have\n\n$$\nu' = \\dfrac{c_1}{x} \\quad\\Longrightarrow\\quad u = c_1\\ln{x} + c_2.\n$$\n\nTherefore, our expression for $y_2(x) = \\dfrac{u}{x}$ becomes\n\n$$\ny_2(x) = \\dfrac{c_1\\ln{x} + c_2}{x}.\n$$\n\nSetting $c_1 = 1$ and $c_2 = 0,$ we get\n\n$$\ny_2(x) = \\dfrac{\\ln{x}}{x}.\n$$\n\nFinally, because $W(y_1, y_2) = \\dfrac{1}{x^3} \\neq 0,$ we know that $y_1$ and $y_2$ are independent (you should verify this calculation yourself).\n\nTherefore, the general solution is\n\n$$\ny = \\dfrac{A}{x} + \\dfrac{B\\ln{x}}{x} = \\dfrac{A + B\\ln{x}}{x}.\n$$"} {:db/id #edb/ref 17592186152024 :question/id #uuid "b0090425-28a2-5752-8f5d-991e932e7e62" :question/math-academy-id "e-7546" :question/problem "The area under the curve $y={x+1}$ between $x=0$, $x=2$, and the $x$-axis is approximated by a midpoint Riemann sum using $m$ subintervals of equal length. What is the expression for the Riemann sum in sigma notation?" :question/worked-solution "The midpoint Riemann sum for $y=f(x)$ with a regular step size in sigma notation is\n\n$$\n\\sum_{i=1}^{m} f(x^*_i)\\Delta x\n$$\n\nwhere\n\n$$\nx^*_i = a + \\left(i - \\dfrac{1}{2} \\right) \\Delta{x}\n$$\n\n$$\n\\Delta x = \\dfrac{b-a}{m}\n$$\n\nand $m$ is the number of subintervals.\n\nThe endpoints indicate that $a=0$ and $b=2$, so the step size is\n\n$$\n\\Delta x = \\dfrac{2-0}{m} = \\dfrac2m\n$$\n\nTherefore, using sigma notation, we can express the midpoint Riemann sum as\n\n$$\n\\begin{aligned}\n∑_(i = 1)^(m)f(x_{i}^{∗})Δx &= ∑_(i = 1)^(m)f(0 + (i - \\frac{1}{2}) \\cdot \\frac{2}{m}) \\cdot \\frac{2}{m} \\\\\n&= ∑_(i = 1)^(m)\\frac{2}{m} \\cdot f(\\frac{2i - 1}{m}) \\\\\n&= ∑_(i = 1)^(m)\\frac{2}{m} \\cdot (\\frac{2i - 1}{m} + 1) \\\\\n&= ∑_(i = 1)^(m)\\frac{2}{m} \\cdot (\\frac{2i - 1 + m}{m}) \\\\\n&= ∑_(i = 1)^(m)\\frac{4i - 2 + 2m}{m^{2}}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186152025 :question/id #uuid "e9c715d0-1022-55ad-8fd7-86477e5f52af" :question/math-academy-id "e-7547" :question/problem "The area under the curve $y=x^3$ between $x=0$ and $x=1$ and the $x$-axis is approximated by the trapezoidal rule using $n$ subintervals of equal length. What is the expression for the trapezoidal rule in sigma notation?" :question/worked-solution "The area under the curve for $y=f(x)$ using the trapezoidal rule with a regular step size in sigma notation is\n\n$$\n\\dfrac{\\Delta x}{2}\\left[f(a)+2\\left(\\sum_{i=1}^{n-1} f(x_i) \\right)+f(b)\\right]\n$$\n\nwhere\n\n$$\nx_i = a + i \\cdot \\Delta x\n$$\n\n, with\n\n$$\n\\Delta x = \\dfrac{b-a}{n}\n$$\n\nThe endpoints indicate that $a=0$ and $b=1$. So, the step size is\n\n$$\n\\Delta x = \\dfrac{1-0}{n} = \\dfrac 1 n\n$$\n\nTherefore, using sigma notation, the trapezoidal rule sum can be expressed as\n\n$$\n\\begin{aligned}\n\\frac{Δx}{2}[f(a) + 2(∑_(i = 1)^(n - 1)f(x_{i})) + f(b)] &= \\frac{1}{2} \\cdot \\frac{1}{n}[f(0) + 2(∑_(i = 1)^(n - 1)f(0 + i \\cdot \\frac{1}{n})) + f(1)] \\\\\n&= \\frac{1}{2n}[0 + 2(∑_(i = 1)^(n - 1)f(\\frac{i}{n})) + 1] \\\\\n&= \\frac{1}{2n}[1 + 2∑_(i = 1)^(n - 1)(\\frac{i}{n})^{3}]\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186152421 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a85b59e2-31ae-5948-aff0-0354a0335ba6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ seconds" :db/id #edb/ref 17592186149058} {:answer/id #uuid "ba52b634-4929-5939-8dbe-9d86188c60e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$ seconds" :db/id #edb/ref 17592186149059} {:answer/id #uuid "1bcdd7a8-db6f-593f-886b-4416aa801582" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ seconds" :db/id #edb/ref 17592186149060} {:answer/id #uuid "4c99be94-7152-55cf-ac13-5c840ccb5206" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ seconds" :db/id #edb/ref 17592186149061} {:answer/id #uuid "6c2c8920-f3c7-50de-96a6-fd0ae0d6490b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ seconds" :db/id #edb/ref 17592186149062}] :answer-field/id #uuid "6cafc6ff-ae97-5b22-a902-808d10d077f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186149057}] :question/id #uuid "420df338-7878-5860-a44b-0e420a55f537" :question/math-academy-id "q-136146" :question/problem "A nut is mounted on a wheel of a car. The distance from the nut to the ground, in inches, is modeled by the function\n$H(t) = 3\\sin (\\frac{πt}{2}) + 5$,\nwhere $t$ is the time in seconds. How long does it take for the wheel to make one complete rotation?"} {:db/id #edb/ref 17592186152423 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1ec77a4-6da4-50c8-81fe-5d8c9624f667" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$ meters" :db/id #edb/ref 17592186149070} {:answer/id #uuid "c77dfb30-3982-598f-ba79-b96b2fb0a9e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ meters" :db/id #edb/ref 17592186149071} {:answer/id #uuid "d476820b-dbf2-5969-8806-2a403479f298" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ meters" :db/id #edb/ref 17592186149072} {:answer/id #uuid "46d19ded-133c-55b8-852a-9fbceaa970b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ meters" :db/id #edb/ref 17592186149073} {:answer/id #uuid "7437cb65-0fc5-5891-95e7-8213714e9c54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4π$ meters" :db/id #edb/ref 17592186149074}] :answer-field/id #uuid "62beb1a6-7499-5327-8923-e352cb1c8b32" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186149069}] :question/id #uuid "6ae2100e-4bcd-52e3-81b6-6610ad763573" :question/math-academy-id "q-136446" :question/problem "The height of a tide at a particular harbor, in meters, can be modeled by the function\n$H(t) = 3\\sin (\\frac{πt}{6}) + 4$,\nwhere $t$ is the time (in hours) after $12p.m$. What is the height difference between high tide and low tide?"} {:db/id #edb/ref 17592186152424 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8312b63b-30bd-5c8d-acfa-090cf93e6bb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{5π}{2}$ centimeters" :db/id #edb/ref 17592186149076} {:answer/id #uuid "c2da7a69-fc04-567f-a55f-79a19d5d2c45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ centimeters" :db/id #edb/ref 17592186149077} {:answer/id #uuid "3daf5339-3077-555b-9c2e-9f907b61d442" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ centimeters" :db/id #edb/ref 17592186149078} {:answer/id #uuid "713a3e81-b225-5c3f-ae51-32fbaff12957" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$20$ centimeters" :db/id #edb/ref 17592186149079} {:answer/id #uuid "77a28425-ef07-539e-8a96-2a054d5f8d8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2π$ centimeters" :db/id #edb/ref 17592186149080}] :answer-field/id #uuid "0dcab076-beba-5419-801d-5417933ba1d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186149075}] :question/id #uuid "3838ed26-34be-5911-9e6c-5c9a5f8be8bd" :question/math-academy-id "q-136502" :question/problem "A pendulum is swinging back and forth. The distance from the bob to the place it was released, in centimeters, is given by the function\n$P(t) =-5\\cos (\\frac{πt}{2}) + 5$,\nwhere $t$ is the time in seconds. What is the maximum distance from the bob to the place where it was released?"} {:db/id #edb/ref 17592186152517 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "844dc162-f418-51a5-adf1-0fba961c4fc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12hours" :db/id #edb/ref 17592186149602} {:answer/id #uuid "8fd5243c-261f-5bcb-9215-1300ad495c9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8hours" :db/id #edb/ref 17592186149603} {:answer/id #uuid "26bfa4be-586b-56d0-9c45-b73c937c3b5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10hours" :db/id #edb/ref 17592186149604} {:answer/id #uuid "3fd504ae-b9d9-59b8-a457-707a11b784db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18.5hours" :db/id #edb/ref 17592186149605} {:answer/id #uuid "621ba4f3-4e4f-518c-acd5-ac7c1b279683" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.5hours" :db/id #edb/ref 17592186149606}] :answer-field/id #uuid "87891245-72aa-5d1f-bad9-7a3f0d7861ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186149601}] :question/id #uuid "62e4f47f-aaca-5e91-a063-dc62c704f708" :question/math-academy-id "q-223545" :question/problem "The number of hours of daylight in Oslo, Norway, can be modeled by a function of the form\n$T(t) = 6.5\\cos (\\frac{πt}{182}) + 12$,\nwhere $t$ is the time (in days). How many hours of daylight was there in Oslo on March 20, when the hours of daylight is midway between its maximum and minimum value?"} {:db/id #edb/ref 17592186152599 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8728c7da-720f-5e61-97d6-b8a39df3c314" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186325123} {:answer/id #uuid "905f342b-d00a-53b3-af8d-38cbcb119916" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186325199} {:answer/id #uuid "9f8466cb-bf8d-5e2d-8d3b-c1cb24e50608" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{2}" :db/id #edb/ref 17592186325326} {:answer/id #uuid "b9dcdd31-8037-5ab6-8919-b83b9fff4507" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186325566} {:answer/id #uuid "c1007dfa-49fb-5a7e-92a1-3f8618ba8b3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186325630}] :answer-field/correct {:answer/id #uuid "905f342b-d00a-53b3-af8d-38cbcb119916" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186325199} :answer-field/id #uuid "98c8848c-c6e4-5d33-845e-aec52077a72c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326493}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e836460c-d649-52c9-8ad9-0a85310c1949" :question/math-academy-id "q-41188" :question/problem "Evaluate the integral ${\\int }_{C}(x+y)\\,\\text{d}s$, where the curve $C$ is given in polar form by $r=2\\sqrt{\\operatorname{cos}⁡2\\theta }\\,$ for $-\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{4}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =2\\sqrt{\\operatorname{cos}⁡2\\theta }\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =2\\operatorname{cos}⁡\\theta \\sqrt{\\operatorname{cos}⁡2\\theta }, \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =2\\sqrt{\\operatorname{cos}⁡2\\theta }\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{sin}⁡\\theta \\sqrt{\\operatorname{cos}⁡2\\theta }.\\end{aligned}\n$$\n\nSo, along our curve, we have $x=2\\operatorname{cos}⁡\\theta \\sqrt{\\operatorname{cos}⁡2\\theta }$ and $y=2\\operatorname{sin}⁡\\theta \\sqrt{\\operatorname{cos}⁡2\\theta }$, where $-\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{4}.$\n\nNow, if $f(x,y)=x+y$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =2\\operatorname{cos}⁡\\theta \\sqrt{\\operatorname{cos}⁡2\\theta }+2\\operatorname{sin}⁡\\theta \\sqrt{\\operatorname{cos}⁡2\\theta } \\\\  & =2\\sqrt{\\operatorname{cos}⁡2\\theta }(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta ).\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(2\\sqrt{\\operatorname{cos}⁡2\\theta }) \\\\  & =2\\cdot \\frac{1}{2\\sqrt{\\operatorname{cos}⁡2\\theta }}\\cdot (-\\operatorname{sin}⁡2\\theta )\\cdot 2 \\\\  & =-\\frac{2\\operatorname{sin}⁡2\\theta }{\\sqrt{\\operatorname{cos}⁡2\\theta }}\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{4\\operatorname{cos}⁡2\\theta +\\frac{4{sin}^{2}⁡2\\theta }{\\operatorname{cos}⁡2\\theta }} \\\\  & =\\sqrt{\\frac{4{cos}^{2}⁡2\\theta +4{sin}^{2}⁡2\\theta }{\\operatorname{cos}⁡2\\theta }} \\\\  & =\\sqrt{\\frac{4({cos}^{2}⁡2\\theta +{sin}^{2}⁡2\\theta )}{\\operatorname{cos}⁡2\\theta }} \\\\  & =\\frac{2}{\\sqrt{\\operatorname{cos}⁡2\\theta }}.\\end{aligned}\n$$\n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}(x+y)\\,\\text{d}s & ={\\int }_{-\\pi /4}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{\\pi /4}2\\sqrt{\\operatorname{cos}⁡2\\theta }\\,(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\cdot \\frac{2}{\\sqrt{\\operatorname{cos}⁡2\\theta }}\\cdot \\text{d}\\theta  \\\\  & =4{\\int }_{-\\pi /4}^{\\pi /4}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =4(\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta ){|}_{-\\pi /4}^{\\pi /4} \\\\  & =4([\\frac{\\sqrt{2}}{2}-\\frac{\\sqrt{2}}{2}]-[-\\frac{\\sqrt{2}}{2}-\\frac{\\sqrt{2}}{2}]) \\\\  & =4\\sqrt{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186152603 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "941c2c24-75ce-5b7f-8f62-e5ade2bd19b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∑_(i = 1)^(n - 1)\\frac{i^{2}}{n}" :db/id #edb/ref 17592186150126} {:answer/id #uuid "957a8109-6832-575d-be26-a9626de4a2c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{n}∑_(i = 1)^(n - 1)(\\frac{4i}{n})^{2}" :db/id #edb/ref 17592186150127} {:answer/id #uuid "a70bc4a1-9e03-5ea8-b4ce-f56cb9ea3521" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16 + 2∑_(i = 1)^(n)(\\frac{i + 1}{2})^{2}" :db/id #edb/ref 17592186150128} {:answer/id #uuid "d60fc344-1183-59b4-9c09-e40a69e37430" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{n}[8 + ∑_(i = 1)^(n - 1)(\\frac{4i}{n})^{2}]" :db/id #edb/ref 17592186150129} {:answer/id #uuid "4d17714e-d503-50c7-98b7-d564fd125981" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{n}[1 + 2∑_(i = 1)^(n)(\\frac{4i}{n})^{2}]" :db/id #edb/ref 17592186150130}] :answer-field/id #uuid "3e5f5eea-1960-514b-8d3a-83e57e4707bf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186150125}] :question/id #uuid "29bdcdc2-58c1-5d6d-bf0d-a247b7a8a711" :question/math-academy-id "q-49368" :question/problem "The area under the curve $y = x^{2}$ between $x = 0$ and $x = 4$ and the $x$-axis is approximated by the trapezoidal rule using $n$ subintervals of equal length. What is the expression for the trapezoidal rule in sigma notation?"} {:db/id #edb/ref 17592186152605 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c50cd363-e476-5825-ac71-37e596fa951d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{π}{2n}[1 + 2∑_(k = 1)^(n - 1)\\sin (\\frac{kπ}{2n})]" :db/id #edb/ref 17592186150138} {:answer/id #uuid "da839575-5201-5e0e-ad7b-7ffe1a61aa55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∑_(k = 1)^(n - 1)\\sin (\\frac{4k}{n})" :db/id #edb/ref 17592186150139} {:answer/id #uuid "0d633899-9888-540c-a731-8ec92b79549e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{π}{4n}[1 + 2∑_(k = 1)^(n - 1)\\sin (\\frac{kπ}{2n})]" :db/id #edb/ref 17592186150140} {:answer/id #uuid "10b3d8e0-487a-5268-817b-a677f7e454c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{π}{4n}[π + 2∑_(k = 1)^(n - 1)\\sin (\\frac{kπ}{2n})]" :db/id #edb/ref 17592186150141} {:answer/id #uuid "6f9549fa-5ce4-50d3-a5cd-7ffd3402f032" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{π}{2n}∑_(k = 1)^(n - 1)\\sin (\\frac{kπ}{4n})" :db/id #edb/ref 17592186150142}] :answer-field/id #uuid "56526add-2f33-595a-81de-ae473727f3ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186150137}] :question/id #uuid "11116895-a499-51d4-8fce-bf96110397fa" :question/math-academy-id "q-49385" :question/problem "The area under the curve $y = \\sin x$ between $x = 0$ and $x = \\frac{π}{2}$ and the $x$-axis is approximated by the trapezoidal rule using $n$ subintervals of equal length. What is the expression for the trapezoidal rule in sigma notation?"} {:db/id #edb/ref 17592186152621 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10951abd-9a0c-5e9a-a5ee-015bdf9f8858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}(x)=2\\operatorname{ln}⁡x" :db/id #edb/ref 17592186333139} {:answer/id #uuid "38b3b4de-6b15-5e29-886f-8966a63b08e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}(x)=2\\operatorname{ln}⁡x-3" :db/id #edb/ref 17592186333512} {:answer/id #uuid "3c5df819-6d99-5b43-97ad-85fcfa644b5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}(x)={x}^{2}\\operatorname{ln}⁡x" :db/id #edb/ref 17592186333557} {:answer/id #uuid "d705707e-3df2-582d-9928-0973ca83f0a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}(x)=x\\operatorname{ln}⁡x+2" :db/id #edb/ref 17592186334874} {:answer/id #uuid "de8257f2-d6dd-5dec-92ca-4a990536fc35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}(x)=\\operatorname{ln}⁡x+1" :db/id #edb/ref 17592186334928}] :answer-field/correct {:answer/id #uuid "de8257f2-d6dd-5dec-92ca-4a990536fc35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}(x)=\\operatorname{ln}⁡x+1" :db/id #edb/ref 17592186334928} :answer-field/id #uuid "2b8c1532-94a3-5ec8-87f1-afa4ad43b262" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335320}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2eddeffd-354f-5e9b-a7ba-50ad11a83d60" :question/math-academy-id "q-64878" :question/problem "Find the particular solution ${y}_{p}(x)$ of the equation \n\n$$\n{x}^{2}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-3x\\frac{\\text{d}y}{\\text{d}x}+4y=4\\operatorname{ln}⁡x,\\,x>0.\n$$\n\n*Hint: Consider using the substitution $x={e}^{t}.$*" :question/worked-solution "This Cauchy-Euler equation has non-polynomial forcing, but we are not given two fundamental solutions, so we cannot use variation of parameters.\n\nHowever, if we make a substitution $x={e}^{t},$ we can transform the Cauchy-Euler equation into a linear ODE with constant coefficients.\n\nLetting $x={e}^{t},$ we note that\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}={e}^{t}=x\\,⟹\\,\\frac{\\text{d}t}{\\text{d}x}=\\frac{1}{x}.\n$$\n\nThen, we use the chain rule to compute the first and second derivatives. \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}t}\\frac{\\text{d}t}{\\text{d}x}=\\frac{1}{x}\\frac{\\text{d}y}{\\text{d}t}, \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{x}\\frac{\\text{d}y}{\\text{d}t}) \\\\  & =\\underbrace{\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{x})\\cdot \\frac{\\text{d}y}{\\text{d}t}+\\frac{1}{x}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\frac{\\text{d}y}{\\text{d}t})}_{\\text{product rule}} \\\\  & =-\\frac{1}{{x}^{2}}\\frac{\\text{d}y}{\\text{d}t}+\\frac{1}{x}\\cdot \\underbrace{\\frac{\\text{d}t}{\\text{d}x}\\frac{\\text{d}}{\\text{d}t}}_{\\text{chain rule}}(\\frac{\\text{d}y}{\\text{d}t}) \\\\  & =-\\frac{1}{{x}^{2}}\\frac{\\text{d}y}{\\text{d}t}+\\frac{1}{{x}^{2}}\\frac{{\\text{d}}^{2}y}{\\text{d}{t}^{2}} \\\\  & =\\frac{1}{{x}^{2}}\\frac{{\\text{d}}^{2}y}{\\text{d}{t}^{2}}-\\frac{1}{{x}^{2}}\\frac{\\text{d}y}{\\text{d}t}\\end{aligned}\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{t}^{2}}-4\\frac{\\text{d}y}{\\text{d}t}+4y=4t.\\end{aligned}\n$$\n\nThis equation is a second-order inhomogeneous differential equation with constant coefficients and polynomial forcing. \n\nUsing the usual methods for solving second-order ODEs, we find that the complementary solution is\n\n$$\n{y}_{c}(t)=A{e}^{2t}+Bt{e}^{2t}.\n$$\n\nThe right-hand side of the inhomogeneous equation is a polynomial of degree $1.$ Therefore, we assume that the particular solution is also a polynomial of degree $1,$ i.e.,\n\n$$\n{y}_{p}(t)=\\alpha t+\\beta \n$$\n\nwhere $\\alpha $ and $\\beta $ are constants that are to be determined. \n\nCalculating the first and second derivatives of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}t}=\\alpha ,\\,\\frac{{\\text{d}}^{2}{y}_{p}}{\\text{d}{t}^{2}}=0.\n$$\n\nTo find the values of $\\alpha $ and $\\beta ,$ we substitute the derivatives into the differential equation for $y(t):$\n\n$$\n0-4\\alpha +4(\\alpha t+\\beta )=4t\n$$\n\nGrouping the terms on the left-hand side gives\n\n$$\n4\\alpha t+4(\\beta -\\alpha )=4t.\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}4\\alpha &=4\\, && (\\text{equating the coefficients of }t) \\\\ \\beta -\\alpha &=0\\, && (\\text{equating the constants}).\\end{aligned}\\right.\n$$\n\nHence, $\\alpha =1$ and $\\beta =1,$ and so the particular integral ${y}_{p}(t)$ is\n\n$$\n{y}_{p}(t)=t+1.\n$$\n\nNow, returning to the variable $x,$ we get\n\n$$\n{y}_{p}(x)=\\operatorname{ln}⁡x+1.\n$$"} {:db/id #edb/ref 17592186152622 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d17b94b-c426-5d20-a78d-4a8d9a6c3e42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}(t)=(4t+\\frac{1}{t}){e}^{t}" :db/id #edb/ref 17592186333103} {:answer/id #uuid "22a38b9a-9150-541a-b40d-ddd67c5624f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}(t)=({t}^{2}-1){e}^{t}" :db/id #edb/ref 17592186333305} {:answer/id #uuid "5a3820c6-eda9-5f03-85ce-726711f9d7b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}(t)=({t}^{2}+t+3){e}^{t}" :db/id #edb/ref 17592186333816} {:answer/id #uuid "72ee1f8e-5f90-574f-afd6-a6f334f28f4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}(t)=(t-2+\\frac{2}{t}){e}^{t}" :db/id #edb/ref 17592186334028} {:answer/id #uuid "f8213cff-3e9e-5599-b5bc-ae3a497efb44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}(t)=(3t+1){e}^{t}" :db/id #edb/ref 17592186335162}] :answer-field/correct {:answer/id #uuid "72ee1f8e-5f90-574f-afd6-a6f334f28f4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}(t)=(t-2+\\frac{2}{t}){e}^{t}" :db/id #edb/ref 17592186334028} :answer-field/id #uuid "5f705bb5-42ab-51dc-a50c-dc6ab69ca29c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335427}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a5e3f62b-233d-54f3-a008-6926f1db20f2" :question/math-academy-id "q-64891" :question/problem "Given that the differential equation \n\n$$\n{t}^{2}{y}^{″}-2y={t}^{3}{e}^{t},\\,t>0\n$$\n\nhas the complimentary function ${y}_{c}(t)=\\frac{A}{t}+B{t}^{2}$, find the particular solution ${y}_{p}(t)$ to this equation. \n\n*Hint: You may wish to make use of the following result:* \n\n$$\n\\int {t}^{3}{e}^{t}\\text{d}t=({t}^{3}-3{t}^{2}+6t-6){e}^{t}+C\n$$" :question/worked-solution "First, we reduce the differential equation to the form\n\n$$\n{y}^{″}+P(t){y}^{′}+Q(t)y=f(t).\n$$\n\nSo, we divide both sides of the given equation by ${t}^{2}.$ We get\n\n$$\n{y}^{″}-\\frac{2}{{t}^{2}}y=t{e}^{t}.\n$$\n\nWe notice that the forcing term $f(t)=t{e}^{t}.$ Additionally, we're given the fundamental solutions:\n\n$$\n{y}_{1}(t)=\\frac{1}{t},\\,{y}_{2}(t)={t}^{2}\n$$\n\nFirst, let's compute the Wronskian:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}| \\\\  & ={y}_{1}{y}_{2}^{′}-{y}_{1}^{′}{y}_{2} \\\\  & =\\frac{1}{t}({t}^{2})^{′}-{(\\frac{1}{t})}^{′}{t}^{2} \\\\  & =2t(\\frac{1}{t})-(-\\frac{1}{{t}^{2}}){t}^{2} \\\\  & =2+1 \\\\  & =3\\ne 0\\end{aligned}\n$$\n\nSince the Wronskian is not equal to zero, this confirms that the functions  ${y}_{1}(x)$ and ${y}_{2}(x)$ are independent. \n\nAccording to the method of variation of parameters, the particular solution of the differential equation is\n\n$$\n\\begin{aligned}{y}_{p}(t) & ={y}_{1}(t)u(t)+{y}_{2}(t)v(t),\\end{aligned}\n$$\n\nwhere\n\n$$\n\\begin{aligned}u(t) & =-\\int \\frac{f(t){y}_{2}(t)}{W({y}_{1},{y}_{2})}\\,\\text{d}t=-\\frac{1}{3}\\int {t}^{3}{e}^{t}\\text{d}t=-\\frac{1}{3}({t}^{3}-3{t}^{2}+6t-6){e}^{t}, \\\\ v(t) & =\\int \\frac{f(t){y}_{1}(t)}{W({y}_{1},{y}_{2})}\\,\\text{d}t=\\frac{1}{3}\\int {e}^{t}\\text{d}t=\\frac{1}{3}{e}^{t}.\\end{aligned}\n$$\n\nThus,\n\n$$\n\\begin{aligned}{y}_{p}(t) & ={y}_{1}(t)u(t)+{y}_{2}(t)v(t) \\\\  & =-\\frac{1}{3t}({t}^{3}-3{t}^{2}+6t-6){e}^{t}+\\frac{{t}^{2}}{3}{e}^{t} \\\\  & =(-\\frac{{t}^{2}}{3}+t-2+\\frac{2}{t}+\\frac{{t}^{2}}{3}){e}^{t} \\\\  & =(t-2+\\frac{2}{t}){e}^{t}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186152626 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ee0587a-3420-5250-afba-449b63fd9c57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y_{p}(x) = 3\\sin (\\ln x)" :db/id #edb/ref 17592186150264} {:answer/id #uuid "a5a86e47-0bdf-5d72-bd52-4a6e21003e63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y_{p}(x) =-\\cos (\\ln x) - 3\\sin (\\ln x)" :db/id #edb/ref 17592186150265} {:answer/id #uuid "d76db01c-139a-5747-8d3b-c06f7d759a02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y_{p}(x) =-6\\cos (\\ln x)" :db/id #edb/ref 17592186150266} {:answer/id #uuid "de11df8b-11a6-59e8-b374-00390f09c7f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y_{p}(x) = 3x\\sin (\\ln x)" :db/id #edb/ref 17592186150267} {:answer/id #uuid "5113d187-3884-539f-ad82-44d175f6395b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y_{p}(x) = 2\\cos (\\ln x) + \\sin (\\ln x)" :db/id #edb/ref 17592186150268}] :answer-field/id #uuid "ecff85d8-a89f-585d-97c7-dc0bb279a740" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186150263} {:answer-field/choices [{:answer/id #uuid "c6e7d330-b4e5-50ba-98ad-c39c5052f3fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}(x)=-6\\operatorname{cos}⁡(\\operatorname{ln}⁡x)" :db/id #edb/ref 17592186385949} {:answer/id #uuid "8c95ef4e-e1ef-554e-bc2c-af616039402a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}(x)=2\\operatorname{cos}⁡(\\operatorname{ln}⁡x)+\\operatorname{sin}⁡(\\operatorname{ln}⁡x)" :db/id #edb/ref 17592186385950} {:answer/id #uuid "a85ddf79-c8d5-551d-abce-4b9bfd2f9654" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}(x)=3\\operatorname{sin}⁡(\\operatorname{ln}⁡x)" :db/id #edb/ref 17592186385951} {:answer/id #uuid "a18b482b-eb0e-5df9-acc2-a5d11855bda5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}(x)=3x\\operatorname{sin}⁡(\\operatorname{ln}⁡x)" :db/id #edb/ref 17592186385952} {:answer/id #uuid "228e50c3-f66f-57d9-98cb-e7d7dfb16e26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}(x)=-\\operatorname{cos}⁡(\\operatorname{ln}⁡x)-3\\operatorname{sin}⁡(\\operatorname{ln}⁡x)" :db/id #edb/ref 17592186385953}] :answer-field/correct {:answer/id #uuid "8c95ef4e-e1ef-554e-bc2c-af616039402a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}(x)=2\\operatorname{cos}⁡(\\operatorname{ln}⁡x)+\\operatorname{sin}⁡(\\operatorname{ln}⁡x)" :db/id #edb/ref 17592186385950} :answer-field/id #uuid "0dd89aaf-bfda-5ac7-9e58-fcb44ccf51f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385948}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f0b8b449-1831-56eb-8edd-15d89120953d" :question/math-academy-id "q-64952" :question/problem "Find the particular solution ${y}_{p}(x)$ of the equation \n\n$$\n{x}^{2}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-3x\\frac{\\text{d}y}{\\text{d}x}+3y=10\\operatorname{sin}⁡(\\operatorname{ln}⁡x),\\,x>0.\n$$" :question/worked-solution "This Cauchy-Euler equation has non-polynomial forcing, but we are not given two fundamental solutions, so we cannot use variation of parameters.\n\nHowever, if we make a substitution $x={e}^{t},$ we can transform the Cauchy-Euler equation into a linear ODE with constant coefficients.\n\nLetting $x={e}^{t},$ we note that\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}={e}^{t}=x\\,⟹\\,\\frac{\\text{d}t}{\\text{d}x}=\\frac{1}{x}.\n$$\n\nThen, we use the chain rule to compute the first and second derivatives. \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}t}\\frac{\\text{d}t}{\\text{d}x}=\\frac{1}{x}\\frac{\\text{d}y}{\\text{d}t}, \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{x}\\frac{\\text{d}y}{\\text{d}t}) \\\\  & =\\underbrace{\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{x})\\cdot \\frac{\\text{d}y}{\\text{d}t}+\\frac{1}{x}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\frac{\\text{d}y}{\\text{d}t})}_{\\text{product rule}} \\\\  & =-\\frac{1}{{x}^{2}}\\frac{\\text{d}y}{\\text{d}t}+\\frac{1}{x}\\cdot \\underbrace{\\frac{\\text{d}t}{\\text{d}x}\\frac{\\text{d}}{\\text{d}t}}_{\\text{chain rule}}(\\frac{\\text{d}y}{\\text{d}t}) \\\\  & =-\\frac{1}{{x}^{2}}\\frac{\\text{d}y}{\\text{d}t}+\\frac{1}{{x}^{2}}\\frac{{\\text{d}}^{2}y}{\\text{d}{t}^{2}} \\\\  & =\\frac{1}{{x}^{2}}\\frac{{\\text{d}}^{2}y}{\\text{d}{t}^{2}}-\\frac{1}{{x}^{2}}\\frac{\\text{d}y}{\\text{d}t}\\end{aligned}\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{t}^{2}}-4\\frac{\\text{d}y}{\\text{d}t}+3y=10\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nThis equation is a second-order inhomogeneous differential equation with constant coefficients and sinusoidal forcing. \n\nUsing the usual methods for solving second-order ODEs, we find that the complementary solution is\n\n$$\n{y}_{c}(t)=A{e}^{t}+B{e}^{3t}.\n$$\n\nThe right-hand side of the inhomogeneous equation is $10\\operatorname{sin}⁡t.$ Therefore, we assume that the particular integral is\n\n$$\n{y}_{p}(t)=\\alpha \\operatorname{cos}⁡t+\\beta \\operatorname{sin}⁡t,\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants that are to be determined.\n\nCalculating the first and second derivatives of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}t}=-\\alpha \\operatorname{sin}⁡t+\\beta \\operatorname{cos}⁡t,\\,\\frac{{\\text{d}}^{2}{y}_{p}}{\\text{d}{t}^{2}}=-\\alpha \\operatorname{cos}⁡t-\\beta \\operatorname{sin}⁡t.\n$$\n\nTo find the value of $\\alpha $ and $\\beta ,$ we substitute the derivatives into the differential equation for $y(t):$\n\n$$\n\\begin{aligned}(-\\alpha \\operatorname{cos}⁡t-\\beta \\operatorname{sin}⁡t)-4(-\\alpha \\operatorname{sin}⁡t+\\beta \\operatorname{cos}⁡t)+3(\\alpha \\operatorname{cos}⁡t+\\beta \\operatorname{sin}⁡t) & =10\\operatorname{sin}⁡t \\\\ (-\\alpha -4\\beta +3\\alpha )\\operatorname{cos}⁡t+(-\\beta +4\\alpha +3\\beta )\\operatorname{sin}⁡t & =10\\operatorname{sin}⁡t \\\\ (2\\alpha -4\\beta )\\operatorname{cos}⁡t+(4\\alpha +2\\beta )\\operatorname{sin}⁡t & =10\\operatorname{sin}⁡t\\end{aligned}\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}2\\alpha -4\\beta &=0\\, && (\\text{equating the coefficients of }\\operatorname{cos}⁡t) \\\\ 4\\alpha +2\\beta &=10\\, && (\\text{equating the coefficients of }\\operatorname{sin}⁡t)\\end{aligned}\\right.\n$$\n\nHence, $\\alpha =2$ and $\\beta =1,$ and so the particular integral ${y}_{p}(t)$ is\n\n$$\n{y}_{p}(t)=2\\operatorname{cos}⁡t+\\operatorname{sin}⁡t.\n$$\n\nNow, returning to the variable $x,$ we get\n\n$$\n{y}_{p}(x)=2\\operatorname{cos}⁡(\\operatorname{ln}⁡x)+\\operatorname{sin}⁡(\\operatorname{ln}⁡x).\n$$"} {:db/id #edb/ref 17592186152728 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10b69fbe-6862-5988-9187-0cfdeadb5248" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{\\int }_{0}^{e}{e}^{t}\\sqrt{1+{e}^{2t}}\\,\\text{d}t" :db/id #edb/ref 17592186342385} {:answer/id #uuid "96eb1843-e485-5232-b8f1-b3464dbf007b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{\\int }_{0}^{e}\\sqrt{1+{e}^{2t}}\\,\\text{d}t" :db/id #edb/ref 17592186343559} {:answer/id #uuid "b6e3275a-4203-5060-8151-e07c74483034" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{e}{e}^{t}\\sqrt{1+{e}^{2t}}\\,\\text{d}t" :db/id #edb/ref 17592186343840} {:answer/id #uuid "ce400b51-078a-5d17-a117-a5b67c6be11b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{\\int }_{0}^{e}{e}^{t}\\sqrt{t+{e}^{t}}\\,\\text{d}t" :db/id #edb/ref 17592186344055} {:answer/id #uuid "fb6e87ee-47c0-5abb-b9bf-b56fbbc45a5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{e}t{e}^{2t}\\,\\text{d}t" :db/id #edb/ref 17592186344450}] :answer-field/correct {:answer/id #uuid "96eb1843-e485-5232-b8f1-b3464dbf007b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{\\int }_{0}^{e}\\sqrt{1+{e}^{2t}}\\,\\text{d}t" :db/id #edb/ref 17592186343559} :answer-field/id #uuid "a8730e8b-8a1d-5469-b535-2eaa510779c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344788}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "38412a6f-7fd7-5b03-94a1-fc852b38a0b2" :question/math-academy-id "q-76189" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}5y{e}^{-x}\\text{d}s,$ where $C$ is the section of the curve $y={e}^{x}$ for $\\,0\\le x\\le e?$" :question/worked-solution "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y=y(t)={e}^{t}.$ This gives the following parametrization of the curve:\n\n$$\nr(t)=⟨t,{e}^{t}⟩,\\,0\\le t\\le e\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}({e}^{t})j \\\\  & =i+{e}^{t}\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{1}^{2}+({e}^{t})^{2}} \\\\  & =\\sqrt{1+{e}^{2t}}\\end{aligned}\n$$\n\nNow, since $f(x,y)=5y{e}^{-x}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =5{e}^{t}\\cdot {e}^{-t}=5.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{e}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{e}5\\cdot \\sqrt{1+{e}^{2t}}\\cdot \\text{d}t \\\\  & =5{\\int }_{0}^{e}\\sqrt{1+{e}^{2t}}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186152736 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "685ac942-8b8e-5612-a051-b4401b2b86f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477425} {:answer/id #uuid "d45fba76-4b8a-55c3-b76b-46d97a1971aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477426}] :answer-field/correct {:answer/id #uuid "685ac942-8b8e-5612-a051-b4401b2b86f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477425} :answer-field/id #uuid "de3496e2-fb30-52e3-8c03-68e6aa524658" :answer-field/key "$f:R\\to R$ defined by $f(x)=\\operatorname{cos}⁡x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477682} {:answer-field/choices [{:answer/id #uuid "0951c26f-04d3-5a60-9632-f376e2b06817" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477427} {:answer/id #uuid "96421230-be9f-5dfb-9225-a1c449a6cb42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477428}] :answer-field/correct {:answer/id #uuid "0951c26f-04d3-5a60-9632-f376e2b06817" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477427} :answer-field/id #uuid "95cda1d1-a0f1-5091-acb2-e5f07ffc5b16" :answer-field/key "$g:Q\\to Q$ defined by $g(x)={x}^{2}-2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477683} {:answer-field/choices [{:answer/id #uuid "3bd240d9-24ff-5735-b1d1-6ae3d7e5603f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477429} {:answer/id #uuid "4b0030ea-cc6c-5c40-ae03-08ed65178645" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477430}] :answer-field/correct {:answer/id #uuid "4b0030ea-cc6c-5c40-ae03-08ed65178645" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477430} :answer-field/id #uuid "5b838ec4-e617-53b2-8781-b7f56025c343" :answer-field/key "$h:Q\\to Q$ defined by $h(x)=8x-3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477684}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6f83b131-cba7-5925-800d-f4bed8f0ae07" :question/math-academy-id "q-76250" :question/problem "Which of the following functions are bijections?\n\nSelect all that apply." :question/worked-solution "Recall that a function $f:X\\to Y$ is a bijection if it is both a surjection and an injection.\n\n- “$f:R\\to R$ defined by $f(x)=\\operatorname{cos}⁡x$” is *not* a bijection because it is not surjective. Remember that the range of $\\operatorname{cos}⁡x$ is $[-1,1].$ This means that \n\n$$\n-1\\le \\operatorname{cos}⁡x\\le 1.\n$$\n\nSo,  for example, there is no value $x\\in R$ such that $f(x)=2.$\n\n- “$g:Q\\to Q$ defined by $g(x)={x}^{2}-2$” is *not* a bijection because it is not injective. For example, $1$ and $-1$ are distinct elements of $Q$, but $g(1)=-1=g(-1)$.\n\n- “$h:Q\\to Q$ defined by $h(x)=8x-3$” is a bijection. First of all, it is a surjection because $∀\\,y\\in Q,$ we can choose an $x\\in Q$ such that $h(x)=y:$\n\n$$\n\\begin{aligned}h(x) & =y \\\\ 8x-3 & =y \\\\ x & =\\frac{y+3}{8}\\in Q\\end{aligned}\n$$\n\nWe verify that, \n\n$$\nh(x)=h(\\frac{y+3}{8})=8(\\frac{y+3}{8})-3=y.\n$$\n\nSecond, it is an injection: \n\n$$\n\\begin{aligned}h({x}_{1}) & =h({x}_{2}) \\\\ 8{x}_{1}-3 & =8{x}_{2}-3 \\\\ {x}_{1} & ={x}_{2}\\end{aligned}\n$$\n\nBecause $h$ is both surjective and injective, $h$ is bijective.\n\nTherefore, the correct answer is “$h:Q\\to Q$ defined by $h(x)=8x-3$” only."} {:db/id #edb/ref 17592186152739 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90da3ca8-37af-554f-8d91-e57306848905" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{25}{2}" :db/id #edb/ref 17592186150942} {:answer/id #uuid "de4056d5-7ff6-55aa-af85-aaa30b96ed06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186150943} {:answer/id #uuid "ee13be1c-1128-5cce-998b-e98cd7d59b86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186150944} {:answer/id #uuid "f52ea6ad-1753-56f5-98f8-95a2393d4afb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186150945} {:answer/id #uuid "78cdb22c-fa67-56b1-8f35-50e08de970e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{125}{4}" :db/id #edb/ref 17592186150946}] :answer-field/correct {:answer/id #uuid "78cdb22c-fa67-56b1-8f35-50e08de970e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{125}{4}" :db/id #edb/ref 17592186150946} :answer-field/id #uuid "61d6f4e9-3b02-5c82-a9e2-09f0904ced68" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186150941}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "64562ab0-7f9a-5e97-a09e-6e014afb5d25" :question/math-academy-id "q-76339" :question/problem "Evaluate the integral ${\\int }_{C}xy\\,\\text{d}s$, where the curve $C$ is given in polar form by $r=5\\operatorname{sin}⁡\\theta \\,$ for $0\\le \\theta \\le \\frac{\\pi }{2}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =5\\operatorname{sin}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =5\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =5\\operatorname{sin}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =5{sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=5\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta $ and $y=5{sin}^{2}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{2}.$\n\nNow, if $f(x,y)=xy$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =5\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta \\cdot 5{sin}^{2}⁡\\theta  \\\\  & =25{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(5\\operatorname{sin}⁡\\theta ) \\\\  & =5\\operatorname{cos}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(5\\operatorname{sin}⁡\\theta )^{2}+(5\\operatorname{cos}⁡\\theta )^{2}} \\\\  & =\\sqrt{25({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )} \\\\  & =5.\\end{aligned}\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}xy\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}25{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta \\cdot 5\\cdot \\text{d}\\theta  \\\\  & =125{\\int }_{0}^{\\pi /2}{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=\\operatorname{sin}⁡\\theta ,$ $\\text{d}u=\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta $ as follows:\n\n$$\n\\begin{aligned}125{\\int }_{0}^{\\pi /2}{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta  & =125{\\int }_{0}^{1}{u}^{3}\\,\\text{d}u \\\\  & =125\\cdot \\frac{1}{4}{u}^{4}{|}_{0}^{1} \\\\  & =\\frac{125}{4}({1}^{4}-{0}^{4}) \\\\  & =\\frac{125}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186152740 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02d386b2-29ca-55a0-a4f9-2285709e1710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{\\int }_{0}^{\\pi }{cos}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186342276} {:answer/id #uuid "0724c421-8073-517d-93f3-1620e786e609" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{\\int }_{0}^{\\pi }{sin}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186342301} {:answer/id #uuid "39b44baa-ac93-5399-be44-580cc1caf867" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{\\pi }\\operatorname{sin}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186342714} {:answer/id #uuid "5e406d1b-7ff9-563d-ad72-bf188c813dbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{\\pi }{sin}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186343029} {:answer/id #uuid "e4798884-9668-5922-995d-443c2be3e374" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{\\int }_{0}^{\\pi }\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186344244}] :answer-field/correct {:answer/id #uuid "0724c421-8073-517d-93f3-1620e786e609" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{\\int }_{0}^{\\pi }{sin}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186342301} :answer-field/id #uuid "27ab5eb9-1fc8-5190-8bd2-5881ace73b08" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344564}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "aefe264e-7dab-56be-82be-12f2dc01af9b" :question/math-academy-id "q-76345" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}({x}^{2}+{y}^{2})\\,\\text{d}s,$ where $C$ is the section of the polar curve $r=2\\operatorname{sin}⁡\\theta \\,$ for $0\\le \\theta \\le \\pi ?$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =2\\operatorname{sin}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{sin}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =2{sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta $ and $y=2{sin}^{2}⁡\\theta $, where $0\\le \\theta \\le \\pi .$\n\nNow, if $f(x,y)={x}^{2}+{y}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & ={(2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta )}^{2}+{(2{sin}^{2}⁡\\theta )}^{2} \\\\  & =4{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +4{sin}^{4}⁡\\theta  \\\\  & =4{sin}^{2}⁡\\theta ({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta ) \\\\  & =4{sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(2\\operatorname{sin}⁡\\theta )=2\\operatorname{cos}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{(2\\operatorname{sin}⁡\\theta )}^{2}+{(2\\operatorname{cos}⁡\\theta )}^{2}} \\\\  & =\\sqrt{4{sin}^{2}⁡\\theta +4{cos}^{2}⁡\\theta } \\\\  & =\\sqrt{4({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )} \\\\  & =2.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}({x}^{2}+{y}^{2})\\,\\text{d}s & ={\\int }_{0}^{\\pi }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }4{sin}^{2}⁡\\theta \\cdot 2\\cdot \\text{d}\\theta  \\\\  & =8{\\int }_{0}^{\\pi }{sin}^{2}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186152741 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88df318e-7cef-5a1b-beb4-ebd43d0a2b69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9(e-1)" :db/id #edb/ref 17592186343422} {:answer/id #uuid "9018c26a-96ea-5a45-9910-5c15a84e4b04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3({e}^{\\pi /2}-1)" :db/id #edb/ref 17592186343496} {:answer/id #uuid "a12e6b2b-2c46-5a38-94d1-fac97bd2c7fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9({e}^{2}-1)" :db/id #edb/ref 17592186343659} {:answer/id #uuid "c1f6766e-d792-5a01-b94e-c00eb881526d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3({e}^{3}-1)" :db/id #edb/ref 17592186343943} {:answer/id #uuid "edcaf3b2-c406-5e3f-b708-5782842800a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{e}^{\\pi /2}" :db/id #edb/ref 17592186344328}] :answer-field/correct {:answer/id #uuid "c1f6766e-d792-5a01-b94e-c00eb881526d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3({e}^{3}-1)" :db/id #edb/ref 17592186343943} :answer-field/id #uuid "b1ba1fde-9f77-5ff0-a0e1-ed2ea5ee8d8b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344804}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "55dd4f9a-c59d-565d-9412-8e04ab857f89" :question/math-academy-id "q-76347" :question/problem "Evaluate the integral of the function $f(x,y)=x{e}^{y}$ along the polar curve $r=3$ for $0\\le \\theta \\le \\frac{\\pi }{2}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =3\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =3\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=3\\operatorname{cos}⁡\\theta $ and $y=3\\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{2}.$\n\nNow, since $f(x,y)=x{e}^{y}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =3\\operatorname{cos}⁡\\theta \\,{e}^{3\\operatorname{sin}⁡\\theta }.\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(3)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{3}^{2}+{0}^{2}} \\\\  & =3.\\end{aligned}\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}x{e}^{y}\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}3\\operatorname{cos}⁡\\theta \\,{e}^{3\\operatorname{sin}⁡\\theta }\\cdot 3\\cdot \\text{d}\\theta  \\\\  & =3{\\int }_{0}^{\\pi /2}3\\operatorname{cos}⁡\\theta \\,{e}^{3\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=3\\operatorname{sin}⁡\\theta ,$ $\\text{d}u=3\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta $ as follows:\n\n$$\n\\begin{aligned}3{\\int }_{0}^{\\pi /2}3\\operatorname{cos}⁡\\theta \\,{e}^{3\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta  & =3{\\int }_{0}^{3}{e}^{u}\\,\\text{d}u \\\\  & =3{e}^{u}{|}_{0}^{3} \\\\  & =3({e}^{3}-{e}^{0}) \\\\  & =3({e}^{3}-1)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186152742 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1958b138-6b04-5333-b9d2-5760b56a84ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186150962} {:answer/id #uuid "3a8f81c6-87c9-58bf-8223-925f3a6025dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186150963} {:answer/id #uuid "1fc5a202-2d3d-51b8-8cc9-baf13d81b387" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}+1" :db/id #edb/ref 17592186454954} {:answer/id #uuid "23b1763b-1b62-51fc-8c26-6f829107e1d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}-1" :db/id #edb/ref 17592186454957} {:answer/id #uuid "35a3d662-0004-5272-8d96-ac26eddf6b34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4(\\sqrt{2}-1)" :db/id #edb/ref 17592186454987}] :answer-field/correct {:answer/id #uuid "35a3d662-0004-5272-8d96-ac26eddf6b34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4(\\sqrt{2}-1)" :db/id #edb/ref 17592186454987} :answer-field/id #uuid "bccab8a0-46e0-5cbd-b014-7b53de12212d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186150959}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e2100053-2a05-53a9-93f0-e3b2f1998524" :question/math-academy-id "q-76353" :question/problem "Evaluate the integral of the function $f(x,y)=x+y$ along the polar curve $r=2$ for $-\\frac{\\pi }{4}\\le \\theta \\le 0.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =2\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =2\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=2\\operatorname{cos}⁡\\theta $ and $y=2\\operatorname{sin}⁡\\theta $, where $-\\frac{\\pi }{4}\\le \\theta \\le 0.$\n\nNow, since $f(x,y)=x+y$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =2\\operatorname{cos}⁡\\theta +2\\operatorname{sin}⁡\\theta  \\\\  & =2(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta ).\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(2)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{2}^{2}+{0}^{2}} \\\\  & =2.\\end{aligned}\n$$\n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}(x+y)\\,\\text{d}s & ={\\int }_{-\\pi /4}^{0}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{0}2(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\cdot 2\\cdot \\text{d}\\theta  \\\\  & =4{\\int }_{-\\pi /4}^{0}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =4(\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta ){|}_{-\\pi /4}^{0} \\\\  & =4([0-1]-[-\\frac{\\sqrt{2}}{2}-\\frac{\\sqrt{2}}{2}]) \\\\  & =4(\\sqrt{2}-1)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186152743 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c31779c1-61a9-5ddf-9ce4-388acac151e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}{\\int }_{-\\pi /4}^{\\pi /4}\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186393613} {:answer/id #uuid "b35b8c73-b6e1-55f6-a3a8-1f84f618409d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{\\int }_{-\\pi /4}^{\\pi /4}\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186393614} {:answer/id #uuid "d14288db-cd96-5f69-9f29-fa682d61a4a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\int }_{-\\pi /4}^{\\pi /4}{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186393615} {:answer/id #uuid "f83c51d2-6855-5059-8910-c179f8d7f6c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{\\int }_{-\\pi /4}^{\\pi /4}\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186393616} {:answer/id #uuid "865a2778-efa4-5860-8c94-4fab14e1e597" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}{\\int }_{-\\pi /4}^{\\pi /4}\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186393617}] :answer-field/correct {:answer/id #uuid "b35b8c73-b6e1-55f6-a3a8-1f84f618409d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{\\int }_{-\\pi /4}^{\\pi /4}\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186393614} :answer-field/id #uuid "8116cea9-3c1b-5e81-a58c-b2147c4e208d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393612}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fda4f6af-c917-5961-9062-323f1cdf3aeb" :question/math-academy-id "q-76355" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}{x}^{2}y\\,\\text{d}s,$ where $C$ is the section of the polar curve $r=\\sqrt{2}$ for $-\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{4}?$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =\\sqrt{2}\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =\\sqrt{2}\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\sqrt{2}\\operatorname{cos}⁡\\theta $ and $y=\\sqrt{2}\\operatorname{sin}⁡\\theta $, where $-\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{4}.$\n\nNow, if $f(x,y)={x}^{2}y$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =(\\sqrt{2}\\operatorname{cos}⁡\\theta )^{2}\\cdot \\sqrt{2}\\operatorname{sin}⁡\\theta  \\\\  & =2\\sqrt{2}\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\sqrt{2})=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(\\sqrt{2})^{2}+{0}^{2}} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}{x}^{2}y\\,\\text{d}s & ={\\int }_{-\\pi /4}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{\\pi /4}2\\sqrt{2}\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta \\cdot \\sqrt{2}\\cdot \\text{d}\\theta  \\\\  & =4{\\int }_{-\\pi /4}^{\\pi /4}\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186152745 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f6daa38-7471-5f48-a645-2a58b0ccbb8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}(5\\sqrt{10}-\\sqrt{2})" :db/id #edb/ref 17592186342894} {:answer/id #uuid "4f78e0c3-9035-5dc2-8ab5-f198ada876f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(5\\sqrt{10}-\\sqrt{2})" :db/id #edb/ref 17592186342898} {:answer/id #uuid "57ea0380-1042-5b37-9a3a-4b0d0e5dc158" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt{2}" :db/id #edb/ref 17592186342971} {:answer/id #uuid "b1d08ff9-8579-514b-818e-d1904f4ed1b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt{10}" :db/id #edb/ref 17592186343798} {:answer/id #uuid "e5c6af53-8fe9-5d44-852a-2dfdb428e5cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}(5\\sqrt{10}-\\sqrt{2})" :db/id #edb/ref 17592186344257}] :answer-field/correct {:answer/id #uuid "e5c6af53-8fe9-5d44-852a-2dfdb428e5cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}(5\\sqrt{10}-\\sqrt{2})" :db/id #edb/ref 17592186344257} :answer-field/id #uuid "59a857e8-a364-5f7f-9a5f-59f962b7904c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344645}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "78a90830-8528-5d8e-9b99-56c7720a064a" :question/math-academy-id "q-76483" :question/problem "Evaluate the integral of the function $f(x,y)=2{y}^{2}$ along the curve $y={e}^{x},$ $\\,0\\le x\\le \\operatorname{ln}⁡3.$" :question/worked-solution "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y=y(t)={e}^{t}.$ This gives the following parametrization of the curve:\n\n$$\nr(t)=⟨t,\\,{e}^{t}⟩,\\,0\\le t\\le \\operatorname{ln}⁡3\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(u) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}({e}^{t})j \\\\  & =i+{e}^{t}j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{1}^{2}+{({e}^{t})}^{2}} \\\\  & =\\sqrt{1+{e}^{2t}}\\end{aligned}\n$$\n\nNow, since $f(x,y)=2{y}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =2({e}^{t})^{2}=2{e}^{2t}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{\\operatorname{ln}⁡3}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\operatorname{ln}⁡3}2{e}^{2t}\\cdot \\sqrt{1+{e}^{2t}}\\cdot \\text{d}t \\\\  & ={\\int }_{0}^{\\operatorname{ln}⁡3}2{e}^{2t}\\,\\sqrt{1+{e}^{2t}}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=1+{e}^{2t}$, $\\text{d}u=2{e}^{2t}\\,\\text{d}t$ as follows:  \n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡3}2{e}^{2t}\\,\\sqrt{1+{e}^{2t}}\\,\\text{d}t & ={\\int }_{2}^{10}{u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{2}{3}{u}^{3/2}{|}_{2}^{10} \\\\  & =\\frac{2}{3}({10}^{3/2}-{2}^{3/2}) \\\\  & =\\frac{2}{3}(10\\sqrt{10}-2\\sqrt{2}) \\\\  & =\\frac{4}{3}(5\\sqrt{10}-\\sqrt{2})\\end{aligned}\n$$"} {:db/id #edb/ref 17592186152834 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a667fb48-d6d0-56b4-9a2f-51f1d545fda6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186151512} {:answer/id #uuid "d50b4ae6-baac-5495-9a60-d9aa7fdb0e16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186151513} {:answer/id #uuid "1ecd72f4-14c0-5335-ad42-d1b607e4c870" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186151514} {:answer/id #uuid "57ccdb1f-57c7-5e2f-9092-44bf6b3326ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186151515} {:answer/id #uuid "698797ad-dfb3-5b13-9a18-924ed5ae8901" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186151516}] :answer-field/id #uuid "3213c95e-0144-5aba-9b89-a4768cb43c97" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186151511}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "beb8164e-f310-5ed6-a1c8-e74c29bb4c2c" :question/math-academy-id "q-81662" :question/problem "Consider the equivalence relation $∼$ on the set $A = {0, 1, 2, …, 9}$, defined by $a∼b$ if $\\cos (\\frac{πa}{2}) = \\cos (\\frac{πb}{2})$. How many distinct equivalence classes does $∼$ partition $A$ into?"} {:db/id #edb/ref 17592186157001 :question/id #uuid "53ca572c-798a-5529-9702-df3291a2b500" :question/math-academy-id "e-12523" :question/problem "Given that \n![](images/43/43ec08d3ac9a00921335912f8e2cf8770397f141b4eebbb4f857fd0be69f7441.svg) \n evaluate the Hessian determinant of $f(x,y)$ at the point $(0,1).$" :question/worked-solution "For a function $f: \\mathbb R^n \\to \\mathbb R,$ given by\n![](images/39/398ea92d21b959026a702db0f606915acb31906451a9039925518ca79fa89717.svg)\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n![](images/5e/5ea286680d2cec429fe920628617d083f47dd53519c2d40f30115dee45a18bc3.svg)\n\nThe Hessian determinant $H(x,y)$ is the determinant of the second derivative:\n\n$$\nH(\\mathbf x) = \\det \\left( \\boldsymbol{f}''(\\mathbf x) \\right)\n$$\n\nIn our case, we have\n\n![](images/14/1488754e319066706880b21fd4642c7b6a75a458770cab254b974b13d35425a2.svg)\n\nFirst, notice that since ![](images/c9/c92e0f35c58187af3fe961947e6e96f0cd82cf32bb00cfd4f51ca3c742339e0c.svg) we must have\n\n$$\n\\dfrac{\\partial f}{\\partial x} = \\ln y, \n\\qquad \n\\dfrac{\\partial f}{\\partial y} = \\dfrac xy.\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(\\operatorname{ln}⁡y)=0\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(\\frac{x}{y})=\\frac{1}{y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(\\operatorname{ln}⁡y)=\\frac{1}{y}\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(\\frac{x}{y})=-\\frac{x}{{y}^{2}}\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =\\begin{bmatrix}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{bmatrix}=\\begin{bmatrix}0 & \\frac{1}{y} \\\\ \\frac{1}{y} & -\\frac{x}{{y}^{2}}\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nEvaluating the second derivative at $(0,1),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(0,1)=\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, we have\n\n$$\nH(0,1) = 0 \\cdot 0 - 1\\cdot 1 = -1.\n$$"} {:db/id #edb/ref 17592186157053 :question/id #uuid "bafa3bf1-a867-5259-a6da-226195b45541" :question/math-academy-id "e-21777" :question/problem "Consider the first-order linear ODE\n\n$$\n\\dfrac{\\textrm d y}{\\textrm d x} - 3y = 12\\sinh 3x.\n$$\n\nWe wish to solve this equation using the method of variation of parameters (VOP).\n\nSelect the correct options below.\n\n$\\qquad$ According to VOP, we assume a particular solution of the form  ![](images/51/51f35485ec1b324b13c8d0a6e80b3c09f655f985a56ba9c5583cedb9fd4d2168.svg).\n\n$\\qquad$ Solving for $u,$ we have $u(x) =$  ![](images/18/1885f67835b63059d8212b9d96f4a4b916c01205d0be9043722e1e16aeb06e64.svg).\n\n$\\qquad$ Therefore, the particular solution is $y_p(x) =$  ![](images/c3/c3d19c5c31140ed5bb678da9defeab18bbaf712453735d147b3d5063f9137363.svg)." :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution $y_c,$ we solve the corresponding homogeneous equation, given by\n\n$$\ny_c' - 3y_c = 0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\ny_c  = Ae^{3x}\n$$\n\nwhere $A$ is an arbitrary constant.\n\nThe method of variation of parameters constructs a particular solution by varying the constant in the homogeneous solution. So, to find a suitable $y_p,$ we set $A = u(x)$ in the complementary solution, as given by the following ansatz:\n\n$$\ny_p(x) = u(x)e^{3x}\n$$\n\nIntuitively, this form of $y_p$ tracks the homogeneous solution but with a varying amplitude.\n\nTo find $u,$ we substitute our ansatz into the equation, apply the product rule to the derivative term, and simplify to isolate $u'{:}$\n\n$$\n\\begin{aligned}{(u{e}^{3x})}^{′}-3(u{e}^{3x}) & =12\\operatorname{sinh}⁡3x \\\\ {u}^{′}{e}^{3x}+3u{e}^{3x}-3u{e}^{3x} & =12\\operatorname{sinh}⁡3x \\\\ {u}^{′}{e}^{3x}+\\cancel{3u{e}^{3x}}-\\cancel{3u{e}^{3x}} & =12\\operatorname{sinh}⁡3x \\\\ {u}^{′}{e}^{3x} & =12\\operatorname{sinh}⁡3x \\\\ {u}^{′} & =12{e}^{-3x}\\operatorname{sinh}⁡3x\\end{aligned}\n$$\n\nUsing the fact that \n\n$$\n\\sinh 3x = \\dfrac{e^{3x} - e^{-3x}}{2}\n$$\n\nour equation for $u$ becomes\n\n$$\n\\begin{aligned}{u}^{′} & =12{e}^{-3x}\\operatorname{sinh}⁡3x \\\\  & =12{e}^{-3x}(\\frac{{e}^{3x}-{e}^{-3x}}{2}) \\\\  & =6{e}^{-3x}({e}^{3x}-{e}^{-3x}) \\\\  & =6-6{e}^{-6x}.\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$ (omitting the arbitrary constant), we have\n\n$$\n\\begin{aligned}{u}^{′} & =6-6{e}^{-6x} \\\\ \\int {u}^{′}\\,\\text{d}x & =\\int 6-6{e}^{-6x}\\,\\text{d}x \\\\ u & =6x+{e}^{-6x}.\\end{aligned}\n$$\n\nFinally, since $y_p = u(x)e^{3x},$ we have\n\n$$\n\\begin{aligned}{y}_{p} & =u(x){e}^{3x} \\\\  & =6x{e}^{3x}+{e}^{-3x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186157103 :question/id #uuid "859e1d71-21cb-5e30-9d60-a4b21358fe1b" :question/math-academy-id "e-7410" :question/problem "![](images/aa/aa730804a15decac8450255e714ca1e0697f4f2326eb615d4d035a2870a49dce.png)\n\nEvaluate the double integral $\\displaystyle \\iint\\limits_D \\dfrac{2y}{x^2+y^2} \\: \\textrm{d}A,$ where the region $D$ is shown above." :question/worked-solution "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n\\iint\\limits_{D} f(x,y) \\ \\mathrm d A = \\iint\\limits_{\\Delta} \\ f(r\\cos\\theta, r\\sin\\theta) \\:  r \\ \\mathrm d r \\mathrm d \\theta.\n$$\n\nNotice that the region $D$ represents a portion of the disk of radius $\\dfrac{1}{2}$ centered at $\\left(0,\\dfrac{1}{2}\\right)\\!.$ \n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n\\left\\{\\begin{aligned}x &=r\\operatorname{cos}⁡\\theta \\\\ y &=r\\operatorname{sin}⁡\\theta\\end{aligned}\\right.\n$$\n\nWith that in mind, let's write our curves in polar coordinates.\n\n- For $x^2+\\left( y-\\dfrac{1}{2} \\right)^2=\\dfrac14,$ we obtain\n\n$$\n\\begin{aligned}{x}^{2}+{(y-\\frac{1}{2})}^{2} & =\\frac{1}{4} \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+{(r\\operatorname{sin}⁡\\theta -\\frac{1}{2})}^{2} & =\\frac{1}{4} \\\\ {r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta -r\\operatorname{sin}⁡\\theta +\\frac{1}{4} & =\\frac{1}{4} \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-r\\operatorname{sin}⁡\\theta  & =0 \\\\ {r}^{2}-r\\operatorname{sin}⁡\\theta  & =0 \\\\ r(r-\\operatorname{sin}⁡\\theta ) & =0.\\end{aligned}\n$$\n\n \nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r = \\sin\\theta.$\n\n- For $y=\\dfrac{1}{2},$ we get\n\n$$\n\\begin{aligned}y & =\\frac{1}{2} \\\\ r\\operatorname{sin}⁡\\theta  & =\\frac{1}{2} \\\\ r & =\\frac{1}{2\\operatorname{sin}⁡\\theta } \\\\ r & =\\frac{1}{2}\\operatorname{csc}⁡\\theta .\\end{aligned}\n$$\n\nNow, let's find the limits for the parameter $\\theta.$ Our curves intersect at the point $\\left(\\dfrac{1}{2},\\dfrac{1}{2}\\right).$ So, the entire region lies between the radial lines $\\theta=\\dfrac{\\pi}{4}$ and $\\theta=\\dfrac{\\pi}{2},$ as depicted below.  \n\n![](images/12/1284a8b4b3f1634b4f7586d40ab8adf9cf93c69484b7ed069f138c8055e88892.png)\n\nAs a result, the region can be expressed in polar coordinates $(r, \\theta)$ as \n\n$$\n\\Delta = \\Big\\{ (r,\\theta) \\: : \\: \\dfrac{1}{2}\\csc\\theta \\leq r \\leq \\sin\\theta, \\: \\dfrac{\\pi}{4} \\leq \\theta \\leq \\dfrac{\\pi}{2} \\Big\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{2y}{{x}^{2}+{y}^{2}}\\,\\text{d}A & ={∬}_{Δ}\\frac{2r\\operatorname{sin}⁡\\theta }{{r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta }\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}{\\int }_{1/2\\operatorname{csc}⁡\\theta }^{\\operatorname{sin}⁡\\theta }2\\operatorname{sin}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}2\\operatorname{sin}⁡\\theta {\\int }_{1/2\\operatorname{csc}⁡\\theta }^{\\operatorname{sin}⁡\\theta }\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}2\\operatorname{sin}⁡\\theta [r]_{1/2\\operatorname{csc}⁡\\theta }^{\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}2\\operatorname{sin}⁡\\theta (\\operatorname{sin}⁡\\theta -\\frac{1}{2}\\operatorname{csc}⁡\\theta )\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}(2{sin}^{2}⁡\\theta -1)\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}-\\operatorname{cos}⁡(2\\theta )\\,\\text{d}\\theta  \\\\  & =-\\frac{1}{2}[\\operatorname{sin}⁡(2\\theta )]_{\\pi /4}^{\\pi /2} \\\\  & =-\\frac{1}{2}(0-\\operatorname{sin}⁡(\\frac{\\pi }{2})) \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186157107 :question/id #uuid "1abed37b-99f8-5298-bc7b-f80259c78398" :question/math-academy-id "e-7446" :question/problem "What set of parametric equations, defined for $t\\in(-\\infty, \\infty),$ generates the parabola shown below?\n\n![](images/1a/1a75a5242f3636efac8def7fc62458e1c1c6972ca79a1ab6fd73af47be622a7a.png)" :question/worked-solution "The diagram shows that the parabola is vertical, has its vertex at $(-4,5),$ and passes through the point $(-2,3).$\n\nThe parametric equations of a vertical parabola that has its vertex at $(h,k)$ are\n\n$$\nx - h = 2pt, \\qquad y - k = pt^2,\n$$\n\nwhere $p$ is constant.\n\nIn our case, $(h,k) = (-4,5),$ and so we have\n\n$$\nx + 4 = 2pt, \\qquad y - 5 = pt^2.\n$$\n\nSince the parabola passes through $(-2, 3),$ we can substitute $x=-2$ and $y=3$ into the parametric equations to obtain a system of equations. This gives\n\n$$\n\\left\\{\\begin{aligned}2 &=2pt \\\\ -2 &=p{t}^{2}.\\end{aligned}\\right.\n$$\n\nSolving the first equation for $t,$ we have\n\n$$\n\\begin{aligned}2 & =2pt \\\\ 1 & =pt \\\\ t & =\\frac{1}{p}.\\end{aligned}\n$$\n\nSubstituting this into the second equation and solving for $p,$ we get\n\n$$\n\\begin{aligned}-2 & =p{(\\frac{1}{p})}^{2} \\\\ -2 & =\\frac{1}{p} \\\\ p & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx + 4 = 2\\left(-\\dfrac12\\right)t, \\qquad y - 5 = \\left(-\\dfrac12\\right)t^2 ,\n$$\n\nwhich simplify to\n\n$$\nx + 4 = -t, \\qquad y - 5 = -\\dfrac12t^2 .\n$$"} {:db/id #edb/ref 17592186157108 :question/id #uuid "af2757f8-0392-54c8-b681-162ee13b1804" :question/math-academy-id "e-7447" :question/problem "What set of parametric equations, defined for $t\\in(-\\infty,\\infty),$ generates the parabola shown below?\n\n![](images/83/8355891fbc605593a32dd100ee8c1c2e4324da0630755984158ec23f6d419ab9.png)" :question/worked-solution "The diagram shows that the parabola is horizontal, has its vertex at $(-3,2),$ and passes through the point $(1,0).$\n\nThe parametric equations of a horizontal parabola that has its vertex at $(h,k)$ are\n\n$$\nx - h = pt^2, \\qquad y - k = 2pt,\n$$\n\nwhere $p$ is constant.\n\nIn our case, $(h,k) = (-3,2),$ and so we have\n\n$$\nx+3 = pt^2, \\qquad y-2 = 2pt.\n$$\n\nSince the parabola passes through $(1,0),$ we can substitute $x=1$ and $y=0$ into the parametric equations to obtain a system of equations. This gives\n\n$$\n\\left\\{\\begin{aligned}4 &=p{t}^{2} \\\\ -2 &=2pt.\\end{aligned}\\right.\n$$\n\nSolving the second equation for $t,$ we have\n\n$$\n\\begin{aligned}-2 & =2pt \\\\ t & =-\\frac{1}{p}.\\end{aligned}\n$$\n\nSubstituting this into the first equation and solving for $p,$ we get\n\n$$\n\\begin{aligned}4 & =p{(-\\frac{1}{p})}^{2} \\\\ 4 & =p\\cdot \\frac{1}{{p}^{2}} \\\\ 4 & =\\frac{1}{p} \\\\ p & =\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx+3 = \\left(\\dfrac{1}{4}\\right)t^2, \\qquad y -2 = 2\\left(\\dfrac{1}{4}\\right)t ,\n$$\n\nwhich simplify to\n\n$$\nx+3 = \\dfrac{1}{4}t^2, \\qquad y -2= \\dfrac{1}{2}t .\n$$"} {:db/id #edb/ref 17592186157109 :question/id #uuid "780170af-a92e-5a87-b08d-d9d940d6906b" :question/math-academy-id "e-7448" :question/problem "Find the Cartesian equation of the parabola defined by the parametric equations\n\n$$\nx-1 = -2t^2, \\qquad y+1 = -4t, \\qquad t\\in(-\\infty, \\infty).\n$$" :question/worked-solution "First, let's make $t$ the subject of the parametric equations. This gives\n\n$$\n\\begin{aligned}{t}^{2} & =-\\frac{x-1}{2},\\,t=-\\frac{y+1}{4}.\\end{aligned}\n$$\n\nSquaring both sides of the second equation, we have\n\n$$\n\\begin{aligned}{t}^{2} & ={(-\\frac{y+1}{4})}^{2} \\\\  & =\\frac{(y+1)^{2}}{16}.\\end{aligned}\n$$\n\nWe can now eliminate the parameter $t$ by substituting the above into the equation $t^2 = -\\dfrac{x-1}{2}$ and rearranging to find the Cartesian equation of the parabola, as follows:\n\n$$\n\\begin{aligned}\\frac{(y+1)^{2}}{16} & =-\\frac{x-1}{2} \\\\ (y+1)^{2} & =16\\cdot (-\\frac{x-1}{2}) \\\\ (y+1)^{2} & =-8(x-1)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186157125 :question/id #uuid "b50a6de3-e5f2-5e0f-86eb-94d62b933a2d" :question/math-academy-id "e-7594" :question/problem "How many solutions does the equation $x + y + z = 16$ have in the non-negative integers with $x > 9$ **or** $y \\geq 7$?" :question/worked-solution "Let $A$ be the set of solutions in the non-negative integers with $x > 9$ and let $B$ be the set of solutions in the non-negative integers with\n\n$$\ny \\geq 7\n$$\n\nThen the number of solutions where $x > 9$ or\n\n$$\ny \\geq 7\n$$\n\ncorresponds to $\\mid A \\cup B \\mid$, and we can compute this using the inclusion-exclusion principle:\n\n$$\n\\begin{vmatrix}A\\cup B & = & A & + & B & - & A\\cap B\\end{vmatrix}\n$$\n\n- To compute $\\mid A \\mid$, we need to count the number of solutions in the non-negative integers such that $x > 9$, or equivalently, $x \\geq 10$. To do this, we can replace $x=10+x'$, where $x'$ is a non-negative integer, which gives\n$x + y + z|= 16; (10 + x^{′}) + y + z|= 16; x^{′} + y + z|= 6$.\nSo, the number of solutions in $A$ is equal to the number of non-negative integer solutions of the equation above, which is given by\n$\\mid A \\mid |= (\\frac{6 + 3 - 1}{6}) = \\frac{8!}{6!2!} = 28$.\n- To compute $\\mid B \\mid$, we apply the same procedure. We replace $y=7+y'$ to get the equation\n$x + y + z|= 16; x + (7 + y^{′}) + z|= 16; x + y^{′} + z|= 9$,\nand the number of solutions of this equation is given by\n$\\mid B \\mid |= (\\frac{9 + 3 - 1}{9}) = \\frac{11!}{9!2!} = 55$.\n- To compute $\\mid A\\cap B \\mid$, we need to find the number of solutions in the non-negative integers such that both $x > 9$ and $y \\geq 7$. So, we replace both $x=10+x'$ and $y=7+y'$ and get\n$x + y + z|= 16; (10 + x^{′}) + (7 + y^{′}) + z|= 16; x^{′} + y^{′} + z|=-1$,\nwhich permits no non-negative integer solutions. This tells us that $\\mid A \\cap B \\mid = 0$.\n\nFinally, according to the inclusion-exclusion principle, we have\n\n$$\n\\begin{aligned}\n\\begin{vmatrix}A∪B & &= & A & + & B & - & A∩B\\end{vmatrix} \\\\\n&= 28 + 55 - 0 \\\\\n&= 83\n\\end{aligned}\n$$\n\nTherefore, there are $83$ solutions in the non-negative integers with $x > 9$ or\n\n$$\ny \\geq 7\n$$"} {:db/id #edb/ref 17592186157126 :question/id #uuid "37fec9ac-aaa0-513e-8b75-a16931c59d51" :question/math-academy-id "e-7595" :question/problem "How many solutions does the equation $x + y + z = 17$ have in the non-negative integers with $x \\leq 10$ **and** $y \\leq 12$?" :question/worked-solution "Let $X$ be the set of solutions of\n\n$$\nx + y + z = 17\n$$\n\nin the non-negative integers (without restriction). The number of solutions is given by\n\n$$\n{\\begin{array}{rl}\\displaystyle | X | & \\displaystyle  = \\left( \\genfrac{}{}{0pt}{}{17 + 3 - 1}{17} \\right) = {\\displaystyle \\frac{19 !}{17 ! 2 !}} = 171.\\end{array}}\n$$\n\nHowever, we only want to count the solutions in the non-negative integers with\n\n$$\nx \\leq 10\n$$\n\nand\n\n$$\ny \\leq 12\n$$\n\nSo, we need to subtract the number of solutions where $x > 10$ or $y > 12$.\n\nLet $A$ be the set of solutions in the non-negative integers with $x > 10$ and let $B$ be the set of solutions in the non-negative integers with $y > 12$. Then the number of solutions where $x > 10$ or $y > 12$ corresponds to $\\mid A \\cup B \\mid$, and we can compute this using the inclusion-exclusion principle:\n\n$$\n\\begin{vmatrix}A\\cup B & = & A & + & B & - & A\\cap B\\end{vmatrix}\n$$\n\n- To compute $\\mid A \\mid$, we need to count the number of solutions in the non-negative integers such that $x > 10$, or equivalently, $x \\geq 11$. To do this, we can replace $x=11+x'$, where $x'$ is a non-negative integer, which gives\n$x + y + z|= 17; (11 + x^{′}) + y + z|= 17; x^{′} + y + z|= 6$.\nSo, the number of solutions in $A$ is equal to the number of non-negative integer solutions of the equation above, which is given by\n$\\mid A \\mid |= (\\frac{6 + 3 - 1}{6}) = \\frac{8!}{6!2!} = 28$.\n- To compute $\\mid B \\mid$, we apply the same procedure. We replace $y=13+y'$ to get the equation\n$x + y + z|= 17; x + (13 + y^{′}) + z|= 17; x + y^{′} + z|= 4$,\nand the number of solutions of this equation is given by\n$\\mid B \\mid |= (\\frac{4 + 3 - 1}{4}) = \\frac{6!}{4!2!} = 15$.\n- To compute $\\mid A\\cap B \\mid$, we need to find the number of solutions in the non-negative integers such that both $x > 10$ and $y > 12$. So, we replace both $x=11+x'$ and $y=13+y'$ and get\n$x + y + z|= 17; (11 + x^{′}) + (13 + y^{′}) + z|= 17; x^{′} + y^{′} + z|=-7$,\nwhich permits no non-negative integer solutions. This tells us that $\\mid A \\cap B \\mid = 0$.\n\nFinally, according to the inclusion-exclusion principle, we have\n\n$$\n\\begin{aligned}\n\\begin{vmatrix}A∪B & &= & A & + & B & - & A∩B\\end{vmatrix} \\\\\n&= 28 + 15 - 0 \\\\\n&= 43\n\\end{aligned}\n$$\n\nand the number of solutions in the non-negative integers with\n\n$$\nx \\leq 10\n$$\n\nand\n\n$$\ny \\leq 12\n$$\n\nis given by\n\n$$\n\\begin{aligned}\n\\begin{vmatrix}X & -\\end{vmatrix}A\\cup B &= 171 - 43 =128\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186157135 :question/id #uuid "e5b64c26-300d-530d-b22f-ff061f4e3296" :question/math-academy-id "e-7657" :question/problem "Solve the inequality $4e^x - 5 >  0.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}4{e}^{x}-5 & >0 \\\\ 4{e}^{x} & >5 \\\\ {e}^{x} & >\\frac{5}{4}.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({e}^{x}) & >\\operatorname{ln}⁡(\\frac{5}{4}) \\\\ x & >\\operatorname{ln}⁡5-\\operatorname{ln}⁡4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186157142 :question/id #uuid "1c336514-aac7-5f9c-8118-8a16188f2d42" :question/math-academy-id "e-7703" :question/problem "Solve the inequality $5 \\cdot \\left( \\dfrac{3}{4} \\right)^x + 2 \\geq 12.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}5\\cdot {(\\frac{3}{4})}^{x}+2 & \\ge 12 \\\\ 5\\cdot {(\\frac{3}{4})}^{x} & \\ge 10 \\\\ {(\\frac{3}{4})}^{x} & \\ge 2.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡[{(\\frac{3}{4})}^{x}] & \\ge \\operatorname{ln}⁡2 \\\\ x\\operatorname{ln}⁡(\\frac{3}{4}) & \\ge \\operatorname{ln}⁡2 \\\\ x(\\operatorname{ln}⁡3-\\operatorname{ln}⁡4) & \\ge \\operatorname{ln}⁡2.\\end{aligned}\n$$\n\nLastly, note that $\\ln 3 - \\ln 4$ is a negative quantity, so when we divide both sides by it, we need to flip the inequality:\n\n$$\n\\begin{aligned}x & \\le \\frac{\\operatorname{ln}⁡2}{\\operatorname{ln}⁡3-\\operatorname{ln}⁡4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186157184 :question/id #uuid "2e9d5626-bb05-5382-91f4-efa0235b09be" :question/math-academy-id "e-7923" :question/problem "The function $y=f(x)$ satisfies the differential equation \n\n$$\n\\dfrac{\\textrm{d}y}{\\textrm{d}x} = 4y - e^{3x}.\n$$\n\n \n\nGiven that the point $P(0,1)$ lies on the graph of the function, evaluate $\\dfrac{\\textrm{d}^2y}{\\textrm{d}x^2}$ at $P.$" :question/worked-solution "To find an expression for the second derivative, we differentiate the equation with respect to $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{\\text{d}y}{\\text{d}x}) & =\\frac{\\text{d}}{\\text{d}x}(4y-{e}^{3x}) \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(4y)-\\frac{\\text{d}}{\\text{d}x}({e}^{3x}) \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =4\\frac{\\text{d}y}{\\text{d}x}-\\frac{\\text{d}}{\\text{d}x}({e}^{3x}) \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =4\\frac{\\text{d}y}{\\text{d}x}-3{e}^{3x}\\end{aligned}\n$$\n\nNow, we substitute the given expression for $\\dfrac{\\textrm d y}{\\textrm d x}$ into the above and simplify the resulting expression:\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =4(4y-{e}^{3x})-3{e}^{3x} \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =16y-7{e}^{3x}\\end{aligned}\n$$\n\nFinally, we substitute the coordinates of our point into the above expression for the second derivative:\n\n$$\n\\begin{aligned}{\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(0,1)} & ={(16y-7{e}^{3x})|}_{(0,1)} \\\\  & =16(1)-7{e}^{3(0)} \\\\  & =9\\end{aligned}\n$$"} {:db/id #edb/ref 17592186157185 :question/id #uuid "ce6ca955-28f1-5912-bd36-dc6ef7be1241" :question/math-academy-id "e-7924" :question/problem "The function $y=f(x)$ satisfies the differential equation \n\n$$\n\\dfrac{\\textrm{d}y}{\\textrm{d}x} = x^2 - 4 - y.\n$$\n\nGiven that the point $(2,0)$ lies on the graph of $y=f(x),$ which of the following statements are true?\n\n- $(2,0)$ is a stationary point of the function $f$\n\n- $(2,0)$ is a local minimum point of the function $f$\n\n- $(2,0)$ is an inflection point of the function $f$" :question/worked-solution "First, we find the value of the first and second derivatives of the function at the given point.\n\nTo find the first derivative of $f$ at $(2,0),$ we substitute the coordinates of our point into the differential equation:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{(2,0)} & ={({x}^{2}-4-y)|}_{(2,0)} \\\\  & ={2}^{2}-4-(0) \\\\  & =0\\end{aligned}\n$$\n\nTo find the second derivative, we first need to differentiate the equation and then substitute the coordinates of the point:\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\text{d}y}{\\text{d}x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}-4-y) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2})-\\frac{\\text{d}}{\\text{d}x}(4)-\\frac{\\text{d}}{\\text{d}x}(y) \\\\  & =2x-\\frac{\\text{d}y}{\\text{d}x} \\\\  & =2x-({x}^{2}-4-y) \\\\  & =-{x}^{2}+2x+4+y \\\\ {\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(2,0)} & ={(-{x}^{2}+2x+4+y)|}_{(2,0)} \\\\  & =-(2)^{2}+2(2)+4+(0) \\\\  & =4 \\\\  & >0\\end{aligned}\n$$\n\nWith that in mind, let's examine the statements in turn.\n\n- Statement I is true. Indeed, since\n\n$$\n\\left.\\dfrac{\\textrm d y}{\\textrm d x} \\right|_{(2,0)} = 0,\n$$\n\nwe obtain that $(2,0)$ is a stationary point of the function $f.$\n\n- Statement II is true. There is a critical point at $(2,0).$ So, according to the second derivative test, since\n\n$$\n\\left. \\dfrac{\\textrm{d}^2y}{\\textrm{d}x^2}  \\right|_{(2,0)}  > 0,\n$$\n\nwe have a local minimum at that point.\n\n- Statement III is false. Since the second derivative is not zero, there is no inflection point at $(2,0).$\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186157189 :question/id #uuid "0a870e80-5a73-59d2-997f-bec2d9a947e2" :question/math-academy-id "e-7988" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\textrm E[X] = \\dfrac {10}{3},$ compute $\\textrm{Var}[X].$\n![](images/50/50e7428db936f89942d4c775d2dfe7691b853a9ca729e30c1958cb25b6c1e8d2.svg)" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\textrm{Var}[X] = \\textrm E [X^2] - \\textrm E[X]^2\n$$\n\n \n\nWe compute $\\textrm E[X^2],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{3}^{4}{x}^{2}\\cdot (8-2x)\\,\\text{d}x \\\\  & ={\\int }_{3}^{4}(8{x}^{2}-2{x}^{3})\\,\\text{d}x \\\\  & ={(\\frac{8{x}^{3}}{3}-\\frac{{x}^{4}}{2})|}_{3}^{4} \\\\  & =\\frac{67}{6}\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{67}{6}-{(\\frac{10}{3})}^{2} \\\\  & =\\frac{1}{18}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186157204 :question/id #uuid "a92e44a1-5eaf-5dab-b1aa-83ba4e58cf3a" :question/math-academy-id "e-9130" :question/problem "Compute $\\textrm E[1-4X]$ if $\\textrm E[X]=\\dfrac{1}{2}.$" :question/worked-solution "For any constants $a$ and $b$ and any random variable $X,$ we have\n\n$$\n\\textrm E[aX+b] = a \\textrm E[X]+b.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{E}[1-4X] & =\\text{E}[-4X+1] \\\\  & =-4\\text{E}[X]+1 \\\\  & =-4(\\frac{1}{2})+1 \\\\  & =-2+1 \\\\  & =-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186157209 :question/id #uuid "c33d30ae-8d1d-59a8-bce5-9e046c5a7db1" :question/math-academy-id "e-9240" :question/problem "Given that $X\\sim \\textrm{Geom}\\left(\\dfrac{1}{3}\\right)$, what is $\\textrm{SD}[X]$?" :question/worked-solution "If $X \\sim \\textrm{Geom}(p)$ is a geometric random variable, then\n\n$$\n\\textrm{SD}[X] = \\sqrt{\\textrm{Var}[X]} = \\dfrac{\\sqrt{1-p}}{p}\n$$\n\nTherefore, for our random variable\n\n$$\nX \\sim \\textrm{Geom}\\left(\\dfrac{1}{3}\\right)\n$$\n\nwe have the following standard deviation:\n\n$$\n\\begin{aligned}\nSD[X] &= (\\sqrt{1 - \\frac{1}{3}})/((\\frac{1}{3})) \\\\\n&= (\\sqrt{\\frac{2}{3}})/((\\frac{1}{3})) \\\\\n&= \\sqrt{6}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186157210 :question/id #uuid "85fe7118-b8ef-5b80-85ea-3f838a668c1d" :question/math-academy-id "e-9241" :question/problem "A fair $8$-sided die is rolled until it shows a score of $2$. What is the variance in the number of rolls that are required?" :question/worked-solution "We interpret a \"success\" as the event that a $2$ is shown and a \"failure\" when some other number is displayed. So, the success probability is\n\n$$\np=\\dfrac{1}{8}\n$$\n\nLet $X$ represent the number of rolls we must do until a 2 is obtained. So, we can model $X$ using a geometric distribution:\n\n$$\nX \\sim \\textrm{Geom}\\left(\\dfrac{1}{8}\\right)\n$$\n\nRecall that, if\n\n$$\nX \\sim\\textrm{Geom}\\left(p\\right)\n$$\n\nthen\n\n$$\n\\textrm{Var}[X] = \\dfrac{1-p}{p^2}\n$$\n\nTherefore, for our random variable\n\n$$\nX \\sim \\textrm{Geom}\\left(\\dfrac{1}{8}\\right)\n$$\n\nwe have the following variance:\n\n$$\n\\begin{aligned}\nVar[X] &= (1 - \\frac{1}{8})/((\\frac{1}{8})^{2}) \\\\\n&= ((\\frac{7}{8}))/((\\frac{1}{64})) \\\\\n&= 56\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186157552 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97aaba0a-f1ff-53b8-88d3-02f9ea5b8d02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186153557} {:answer/id #uuid "cdb0a7c0-f3af-5b90-b673-9145719b2694" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.3" :db/id #edb/ref 17592186153558} {:answer/id #uuid "e871067c-7b77-5323-80a4-7fbf3a87e655" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186153559} {:answer/id #uuid "3bf84a3e-489a-5f70-9b0e-0d9f3fec17f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186153560} {:answer/id #uuid "5d2e17c2-fa8f-5557-9d61-59ded8ba456a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186153561}] :answer-field/id #uuid "d461e0e6-c2e8-5019-b996-c774cff64831" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186153556}] :question/id #uuid "ad5dabbf-57b8-5c38-a1e0-82405c2e90c3" :question/math-academy-id "q-112744" :question/problem "Given that $X∼Geom(\\frac{1}{3})$, what is $E[X]$?"} {:db/id #edb/ref 17592186157556 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc49c3e2-6bc9-5